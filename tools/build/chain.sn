استورد std.process.child;
استورد std.text.search;
استورد std.text.number;
استورد std.text.transform;
استورد "support.sn";
استورد "steps.sn";

// The release check of the frozen C Stage0 (docs/en/internals/bootstrap.md,
// "The frozen C Stage0"): a diverse double-compile. POSIX hosts; Windows runs
// bootstrap/chain.ps1.
//
// 1. The C Stage0 (bootstrap/src, C11) is built against the LLVM SDK.
// 2. It compiles the compiler of the commit bootstrap/FROZEN pins (stage0),
//    linked with libLLVM: the first compiler of the chain.
// 3. Each `step` commit there is built by the compiler of the line before.
// 4. The chain's last compiler builds the current sources (A, LLVM-enabled),
//    and A builds them again, Native-only, for the comparison target (D).
// 5. Stage1 from the seed builds the same compiler (W); D must equal W.
// The comparison target is the host when it has a Native backend, else
// x86_64-linux: the seed's Stage1 builds a compiler for a Native target on
// any host.

عرف دليل_السلسلة(): نص { أرجع «build/chain»; }

// The C compiler command: $CC (its words) or cc.
عرف أمر_سي(): متجه نص {
    ليكن الاسم: نص = «CC»;
    ليكن الافتراضي: نص = «cc»;
    ليكن القيمة: نص = بيئة_أو(&الاسم, &الافتراضي);
    أرجع كلمات_أمر(&القيمة);
}

// program and arguments of a C compiler command, then الإضافية.
عرف وسائط_سي(الأمر_سي: &متجه نص, الإضافية: &متجه نص): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < (الطول(*الأمر_سي) مثل طبيعي)) { ألحق(الناتج, استنسخ(&(*الأمر_سي)[ف])); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(*الإضافية) مثل طبيعي)) { ألحق(الناتج, استنسخ(&(*الإضافية)[ف])); ف := ف + 1; }
    أرجع الناتج;
}

// Waits for every child in الأطفال; false when one failed.
عرف انتظر_الجميع(الأطفال: &متجه عملية_طفلة): منطقي {
    ليكن الكل_نجح: متغير منطقي = صواب;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأطفال) مثل طبيعي)) {
        طابق انتظر_عملية(&(*الأطفال)[ف]) مع
        | نتيجة.نجح(حالة_إنهاء.خرج(0)) -> { }
        | _ -> { الكل_نجح := خطأ; };
        ف := ف + 1;
    }
    أرجع الكل_نجح;
}

// 1. The C Stage0: one object per source (named by its path: two sources
// share a file name), compiled المهام at a time, with warnings as errors
// (SULTANC_STAGE0_WERROR=0 lets a newer C compiler's new warning pass).
عرف ابن_المرحلة0(الخيارات: &خيارات_البناء, التضمين: &نص, المكتبة: &نص): منطقي {
    ليكن الكائنات: نص = صل(&[دليل_السلسلة(), «/stage0-objects»]);
    إذا (!أنشئ_المسار(&الكائنات)) { أرجع خطأ; };
    ليكن المصادر: متغير متجه نص = [];
    ليكن الجذر: نص = «bootstrap/src»;
    ليكن لاحقة_سي: نص = «.c»;
    ملفات_تحت(&الجذر, &لاحقة_سي, &متغير المصادر);
    ليكن cc: متجه نص = أمر_سي();
    إذا ((الطول(cc) مثل طبيعي) == 0) { أرجع أبلغ(«CC names no C compiler»); };
    ليكن اسم_werror: نص = «SULTANC_STAGE0_WERROR»;
    ليكن واحد: نص = «1»;
    ليكن صفر: نص = «0»;
    ليكن werror: نص = بيئة_أو(&اسم_werror, &واحد);
    ليكن العلم: متجه نص = [«-std=c11», «-O1», «-Wall», «-Wextra»];
    ليكن الكائنات_كلها: متغير متجه نص = [];
    ليكن الأطفال: متغير متجه عملية_طفلة = [];
    ليكن الرسالة: نص = صل(&[«building the C Stage0 (», طبيعي_إلى_نص(الطول(المصادر) مثل طبيعي), « sources)»]);
    قل(&الرسالة);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصادر) مثل طبيعي)) {
        ليكن الشرطة: نص = «/»;
        ليكن الخط: نص = «_»;
        ليكن الكائن: نص = صل(&[استنسخ(&الكائنات), «/», استبدل_في_النص(&المصادر[ف], &الشرطة, &الخط), «.o»]);
        ليكن الإضافية: متغير متجه نص = استنسخ(&العلم);
        إذا (!متساويان(&werror, &صفر)) { ألحق(الإضافية, «-Werror»); };
        ألحق(الإضافية, «-Ibootstrap/include/private»);
        ألحق(الإضافية, «-Ibootstrap/include/public»);
        ألحق(الإضافية, صل(&[«-I», استنسخ(التضمين)]));
        ألحق(الإضافية, «-c»);
        ألحق(الإضافية, استنسخ(&المصادر[ف]));
        ألحق(الإضافية, «-o»);
        ألحق(الإضافية, استنسخ(&الكائن));
        ليكن الوسائط: متجه نص = وسائط_سي(&cc, &الإضافية);
        طابق شغل_عملية(&cc[0], &الوسائط) مع
        | نتيجة.نجح(الطفل) -> { ألحق(الأطفال, الطفل); }
        | نتيجة.خطأ(_) -> { أرجع أبلغ(صل(&[«cannot start the C compiler for », استنسخ(&المصادر[ف])])); };
        ألحق(الكائنات_كلها, الكائن);
        ف := ف + 1;
        إذا ((الطول(الأطفال) مثل طبيعي) >= (*الخيارات).المهام || ف == (الطول(المصادر) مثل طبيعي)) {
            إذا (!انتظر_الجميع(&الأطفال)) { أرجع أبلغ(«a C compilation of the Stage0 failed (see above)»); };
            ليكن لا_أطفال: متجه عملية_طفلة = [];
            الأطفال := لا_أطفال;
        };
    }
    ليكن المرحلة0: نص = صل(&[دليل_السلسلة(), «/sultanc-stage0»]);
    ليكن الربط: متغير متجه نص = [«-o», استنسخ(&المرحلة0)];
    ف := 0;
    طالما (ف < (الطول(الكائنات_كلها) مثل طبيعي)) { ألحق(الربط, استنسخ(&الكائنات_كلها[ف])); ف := ف + 1; }
    ألحق(الربط, استنسخ(المكتبة));
    ألحق(الربط, صل(&[«-Wl,-rpath,», دليل_المسار(المكتبة)]));
    ليكن وسائط_الربط: متجه نص = وسائط_سي(&cc, &الربط);
    إذا (!نفذ(&cc[0], &وسائط_الربط)) { أرجع خطأ; };
    قل(&صل(&[«Stage0: », المرحلة0]));
    أرجع صواب;
}

// A directory holding the compiler/ and library/ of الالتزام (git archive).
عرف شجرة_الالتزام(الالتزام: &نص): اختياري نص {
    ليكن الشجرة: نص = صل(&[دليل_السلسلة(), «/tree-», جزء_من(الالتزام, 0, 12)]);
    ليكن الرئيسي: نص = صل(&[استنسخ(&الشجرة), «/compiler/main.sn»]);
    إذا (يوجد(&الرئيسي)) { أرجع اختياري.موجود(الشجرة); };
    ليكن git: نص = «git»;
    ليكن و_وجود: متجه نص = [«cat-file», «-e», صل(&[استنسخ(الالتزام), «^{commit}»])];
    طابق خرج_أمر(&git, &و_وجود) مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        قل_خطأ(&صل(&[«commit », استنسخ(الالتزام), « is not in this checkout (git fetch origin », استنسخ(الالتزام), «, or a full clone)»]));
        أرجع اختياري.لا_شيء();
    };
    أزل_الشجرة(&الشجرة);
    إذا (!أنشئ_المسار(&الشجرة)) { أرجع اختياري.لا_شيء(); };
    ليكن sh: نص = «/bin/sh»;
    ليكن و: متجه نص = [
        «-c», «git archive "$1" compiler library | tar -x -C "$2"», «sh», استنسخ(الالتزام), استنسخ(&الشجرة)
    ];
    إذا (!نفذ(&sh, &و)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الشجرة);
}

// The lines of bootstrap/FROZEN, each (kind, commit); comments and empty
// lines skipped; لا_شيء when a line is malformed.
نوع سطر_مجمد = { النوع: نص, الالتزام: نص };

عرف أسطر_المجمد(): اختياري متجه سطر_مجمد {
    ليكن المسار: نص = «bootstrap/FROZEN»;
    ليكن النص: نص = اقرأ_أو_فارغ(&المسار);
    ليكن الأسطر: متجه نص = أسطر_النص(&النص);
    ليكن الناتج: متغير متجه سطر_مجمد = [];
    ليكن التعليق: نص = «#»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        ليكن الكلمات: متجه نص = قسم_بالفراغات(&الأسطر[ف]);
        إذا ((الطول(الكلمات) مثل طبيعي) > 0 && !يبدأ_بـ(&الكلمات[0], &التعليق)) {
            إذا ((الطول(الكلمات) مثل طبيعي) != 2) {
                قل_خطأ(&صل(&[«bootstrap/FROZEN: unexpected line: », استنسخ(&الأسطر[ف])]));
                أرجع اختياري.لا_شيء();
            };
            ليكن السطر: سطر_مجمد = { النوع: استنسخ(&الكلمات[0]), الالتزام: استنسخ(&الكلمات[1]) };
            ألحق(الناتج, السطر);
        };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// The stubs the C route's Stage1 always had: Stage0 has neither threads nor
// closures, nor `استنسخ`, nor casts between integers and pointers.
عرف بدائل_المرحلة0(): متجه نص {
    ليكن الناتج: متجه نص = [
        «--module-source=compiler.interpreter.machine.host_threads=compiler/interpreter/machine/host_threads_unavailable.sn»,
        «--module-source=compiler.frontend.later_phase_facts_copy=compiler/frontend/later_phase_facts_copy_unavailable.sn»,
        «--module-source=compiler.interpreter.machine.raw_memory_access=compiler/interpreter/machine/raw_memory_access_unavailable.sn»
    ];
    أرجع الناتج;
}

عام عرف السلسلة(الخيارات: &خيارات_البناء): منطقي {
    ليكن المضيف: نص = استنسخ(&(*الخيارات).المضيف);
    إذا (فارغ_النص(&المضيف)) { أرجع أبلغ(«the chain needs a SultanC host target (uname)»); };
    ليكن أصلي: منطقي = هدف_أصلي(&المضيف);
    ليكن الخلفية: متغير نص = خلفية_أصلية();
    ليكن هدف_المقارنة: متغير نص = استنسخ(&المضيف);
    إذا (!أصلي) { الخلفية := خلفية_إل_إل_في_إم(); هدف_المقارنة := «x86_64-linux»; };
    ليكن الدليل: نص = دليل_السلسلة();
    إذا (!أنشئ_المسار(&الدليل)) { أرجع خطأ; };

    // LLVM: the include directory for Stage0, the library for every
    // LLVM-enabled compiler of the chain.
    ليكن الإعداد: نص;
    طابق إعداد_إل_إل_في_إم() مع
    | اختياري.موجود(م) -> { الإعداد := م; }
    | اختياري.لا_شيء -> { أرجع أبلغ(«the C Stage0 needs LLVM 19 to 23: set LLVM_CONFIG=/path/to/llvm-config»); };
    ليكن س_التضمين: نص = «--includedir»;
    ليكن التضمين: نص = سؤال_إل_إل_في_إم(&الإعداد, &س_التضمين);
    ليكن المكتبة: نص;
    طابق مكتبة_إل_إل_في_إم() مع
    | اختياري.موجود(م) -> { المكتبة := م; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    قل(&صل(&[«LLVM: », استنسخ(&المكتبة)]));

    // 1.
    إذا (!ابن_المرحلة0(الخيارات, &التضمين, &المكتبة)) { أرجع خطأ; };
    ليكن المطلق: نص = مسار_مطلق(&الدليل);
    ليكن المرحلة0: نص = صل(&[استنسخ(&المطلق), «/sultanc-stage0»]);

    // 2 and 3.
    ليكن الأسطر: متجه سطر_مجمد;
    طابق أسطر_المجمد() مع
    | اختياري.موجود(أ) -> { الأسطر := أ; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن السابق: متغير نص = «»;
    ليكن stage0: نص = «stage0»;
    ليكن step: نص = «step»;
    ليكن cc: متجه نص = أمر_سي();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        ليكن الشجرة: نص;
        طابق شجرة_الالتزام(&الأسطر[ف].الالتزام) مع
        | اختياري.موجود(ش) -> { الشجرة := ش; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ليكن الناتج: نص = صل(&[استنسخ(&المطلق), «/chain-», طبيعي_إلى_نص(ف)]);
        إذا (متساويان(&الأسطر[ف].النوع, &stage0)) {
            إذا (!فارغ_النص(&السابق)) { أرجع أبلغ(«bootstrap/FROZEN: stage0 must be the first line»); };
            قل(&صل(&[«Stage0 compiles the compiler of », استنسخ(&الأسطر[ف].الالتزام)]));
            ليكن الوسائط: متغير متجه نص = [«compiler/main.sn», صل(&[«--target=», استنسخ(&المضيف)])];
            ليكن البدائل: متجه نص = بدائل_المرحلة0();
            ليكن ب: متغير طبيعي = 0;
            طالما (ب < (الطول(البدائل) مثل طبيعي)) { ألحق(الوسائط, استنسخ(&البدائل[ب])); ب := ب + 1; }
            ألحق(الوسائط, «-o»);
            ألحق(الوسائط, صل(&[استنسخ(&الناتج), «.o»]));
            إذا (!نفذ_في(&الشجرة, &المرحلة0, &الوسائط)) { أرجع خطأ; };
            ليكن الربط: متجه نص = [
                «-o», استنسخ(&الناتج), صل(&[استنسخ(&الناتج), «.o»]), استنسخ(&المكتبة),
                صل(&[«-Wl,-rpath,», دليل_المسار(&المكتبة)])
            ];
            ليكن وسائط_الربط: متجه نص = وسائط_سي(&cc, &الربط);
            إذا (!نفذ(&cc[0], &وسائط_الربط)) { أرجع خطأ; };
        } وإلا إذا (متساويان(&الأسطر[ف].النوع, &step)) {
            إذا (فارغ_النص(&السابق)) { أرجع أبلغ(«bootstrap/FROZEN: a step needs the stage0 line before it»); };
            قل(&صل(&[«the compiler of the line before builds the compiler of », استنسخ(&الأسطر[ف].الالتزام)]));
            ليكن الوسائط: متجه نص = [
                «compiler/main.sn», «-O2», صل(&[«--backend=», استنسخ(&الخلفية)]), صل(&[«--target=», استنسخ(&المضيف)]),
                «-o», استنسخ(&الناتج), استنسخ(&المكتبة)
            ];
            إذا (!نفذ_في(&الشجرة, &السابق, &الوسائط)) { أرجع خطأ; };
        } وإلا {
            أرجع أبلغ(صل(&[«bootstrap/FROZEN: unknown line kind », استنسخ(&الأسطر[ف].النوع), « (stage0 or step)»]));
        };
        اجعله_تنفيذيا(&الناتج);
        السابق := الناتج;
        ف := ف + 1;
    }
    إذا (فارغ_النص(&السابق)) { أرجع أبلغ(«bootstrap/FROZEN names no stage0 commit»); };

    // 4.
    ليكن بإل: قدرة_المترجم = { بإل_إل_في_إم: صواب, المكتبة: استنسخ(&المكتبة), الإصدار: «» };
    ليكن بلا: قدرة_المترجم = قدرة_البذرة();
    ليكن native: نص = خلفية_أصلية();
    ليكن a: نص = صل(&[استنسخ(&الدليل), «/sultanc-a»]);
    ليكن d: نص = صل(&[استنسخ(&الدليل), «/sultanc-d»]);
    ليكن w: نص = صل(&[استنسخ(&الدليل), «/sultanc-w»]);
    قل(&صل(&[«the chain's last compiler builds the current sources (A, LLVM-enabled)»]));
    إذا (!ترجم_المترجم(الخيارات, &السابق, &a, &الخلفية, &المضيف, &بإل)) { أرجع خطأ; };
    قل(&صل(&[«A builds them again, Native-only, for », استنسخ(&هدف_المقارنة), « (D)»]));
    إذا (!ترجم_المترجم(الخيارات, &a, &d, &native, &هدف_المقارنة, &بلا)) { أرجع خطأ; };

    // 5.
    ليكن الرسالة: نص = «Stage1 from the seed builds the same compiler (W)»;
    قل(&الرسالة);
    إذا (!جهز_المرحلة1(الخيارات)) { أرجع خطأ; };
    ليكن المرحلة1: نص = مسار_المرحلة1();
    إذا (!ترجم_المترجم(الخيارات, &المرحلة1, &w, &native, &هدف_المقارنة, &بلا)) { أرجع خطأ; };
    إذا (!ملفان_متساويان(&d, &w)) {
        أرجع أبلغ(صل(&[
            «the C Stage0 chain and the seed give different compilers: », استنسخ(&d), « and », استنسخ(&w),
            « differ (with a current seed this is a compiler bug, or a step bootstrap/FROZEN lacks)»
        ]));
    };
    قل(&صل(&[«the C Stage0 chain and the seed give one compiler (», استنسخ(&هدف_المقارنة), «): », استنسخ(&d), « == », استنسخ(&w)]));
    قل(&صل(&[«the chain's LLVM-enabled compiler for », استنسخ(&المضيف), «: », استنسخ(&a)]));
    أرجع صواب;
}

// `chain --stage0-only`: the C Stage0 alone (CodeQL).
عام عرف المرحلة0_وحدها(الخيارات: &خيارات_البناء): منطقي {
    ليكن الإعداد: نص;
    طابق إعداد_إل_إل_في_إم() مع
    | اختياري.موجود(م) -> { الإعداد := م; }
    | اختياري.لا_شيء -> { أرجع أبلغ(«the C Stage0 needs LLVM 19 to 23: set LLVM_CONFIG=/path/to/llvm-config»); };
    ليكن س_التضمين: نص = «--includedir»;
    ليكن التضمين: نص = سؤال_إل_إل_في_إم(&الإعداد, &س_التضمين);
    ليكن المكتبة: نص;
    طابق مكتبة_إل_إل_في_إم() مع
    | اختياري.موجود(م) -> { المكتبة := م; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن الدليل: نص = دليل_السلسلة();
    إذا (!أنشئ_المسار(&الدليل)) { أرجع خطأ; };
    أرجع ابن_المرحلة0(الخيارات, &التضمين, &المكتبة);
}
