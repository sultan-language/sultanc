استورد std.text.search;
استورد std.text.number;
استورد std.text.transform;
استورد "support.sn";

// The build of the compiler (docs/en/internals/bootstrap.md): one compile of
// compiler/main.sn at -O2 by a previous compiler per step, Stage1 from the
// committed seed when there is no previous compiler, the developer loop's
// stamp, the fixpoint, the seed check and the seed bump.

عام نوع خيارات_البناء = {
    // build, verify, bootstrap, seed-check, seed-update, chain
    الأمر: نص,
    // The target of the built compiler (the host by default).
    الهدف: نص,
    // This host's SultanC target ("" when SultanC has none).
    المضيف: نص,
    // A path the built compiler is also copied to ("" for none).
    الإخراج: نص,
    // --enable-llvm, and the libLLVM it links (resolved once).
    بإل_إل_في_إم: منطقي,
    مكتبة_إل_إل_في_إم: نص,
    // --release-version
    الإصدار: نص,
    // --backend: the backend that generates the compiler.
    الخلفية: نص,
    // --with: the previous compiler ("" for build/sultanc, else the seed).
    السابق: نص,
    // --bootstrap: auto, wasm or existing.
    الطريق: نص,
    // --rebuild
    أعد_البناء: منطقي,
    // SULTANC_COMPILE_TIMEOUT (seconds; 0 for no limit).
    المهلة: عدد,
    // Parallel C compilations.
    المهام: طبيعي
};

// Where things are.
عام عرف دليل_الإقلاع(): نص { أرجع «build/bootstrap»; }
عام عرف دليل_البذرة(): نص { أرجع «build/bootstrap/seed»; }
عام عرف مسار_المرحلة1(): نص { أرجع «build/bootstrap/seed/sultanc-stage1»; }
عام عرف مسار_المترجم(): نص { أرجع «build/sultanc»; }
عام عرف مسار_الختم(): نص { أرجع «build/sultanc.stamp»; }
عام عرف ربط_بلا_إل_إل_في_إم(): نص {
    أرجع «--module-source=compiler.backend.provider.llvm.llvm_codegen=compiler/backend/provider/llvm/unavailable.sn»;
}

// --- LLVM -----------------------------------------------------------------------

// The llvm-config to ask: LLVM_CONFIG, else the first that runs of
// llvm-config, its versioned names (23 to 19) and Homebrew's.
عام عرف إعداد_إل_إل_في_إم(): اختياري نص {
    ليكن الاسم: نص = «LLVM_CONFIG»;
    ليكن فارغ: نص = «»;
    ليكن المحدد: نص = بيئة_أو(&الاسم, &فارغ);
    إذا (!فارغ_النص(&المحدد)) { أرجع اختياري.موجود(المحدد); };
    ليكن المرشحون: متجه نص = [
        «llvm-config», «llvm-config-23», «llvm-config-22», «llvm-config-21», «llvm-config-20», «llvm-config-19»,
        «/opt/homebrew/opt/llvm/bin/llvm-config», «/usr/local/opt/llvm/bin/llvm-config»
    ];
    ليكن و: متجه نص = [«--version»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المرشحون) مثل طبيعي)) {
        طابق خرج_أمر(&المرشحون[ف], &و) مع
        | اختياري.موجود(_) -> { أرجع اختياري.موجود(استنسخ(&المرشحون[ف])); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// One answer of llvm-config (--libdir, --includedir, --version).
عام عرف سؤال_إل_إل_في_إم(الإعداد: &نص, السؤال: &نص): نص {
    ليكن و: متجه نص = [استنسخ(السؤال)];
    طابق خرج_أمر(الإعداد, &و) مع
    | اختياري.موجود(الجواب) -> { أرجع الجواب; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

// The shared libLLVM an LLVM-enabled compiler links, by its resolved path:
// SULTANC_LLVM_LIBRARY, else the one in llvm-config's libdir.
عام عرف مكتبة_إل_إل_في_إم(): اختياري نص {
    ليكن الاسم: نص = «SULTANC_LLVM_LIBRARY»;
    ليكن فارغ: نص = «»;
    ليكن المحددة: نص = بيئة_أو(&الاسم, &فارغ);
    إذا (!فارغ_النص(&المحددة)) {
        إذا (!يوجد(&المحددة)) {
            قل_خطأ(&صل(&[«SULTANC_LLVM_LIBRARY=», المحددة, « does not exist»]));
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(مسار_حقيقي(&المحددة));
    };
    ليكن الإعداد: نص;
    طابق إعداد_إل_إل_في_إم() مع
    | اختياري.موجود(م) -> { الإعداد := م; }
    | اختياري.لا_شيء -> {
        ليكن الرسالة: نص = «LLVM 19 to 23 is needed: set LLVM_CONFIG=/path/to/llvm-config or SULTANC_LLVM_LIBRARY»;
        قل_خطأ(&الرسالة);
        أرجع اختياري.لا_شيء();
    };
    ليكن س_الدليل: نص = «--libdir»;
    ليكن س_الإصدار: نص = «--version»;
    ليكن الدليل: نص = سؤال_إل_إل_في_إم(&الإعداد, &س_الدليل);
    ليكن الإصدار: نص = سؤال_إل_إل_في_إم(&الإعداد, &س_الإصدار);
    ليكن النقطة: نص = «.»;
    ليكن الرئيسي: متغير نص = استنسخ(&الإصدار);
    طابق ابحث_نصا(&الإصدار, &النقطة) مع
    | اختياري.موجود(الموضع) -> { الرئيسي := جزء_من(&الإصدار, 0, الموضع); }
    | اختياري.لا_شيء -> { };
    ليكن الأسماء: متجه نص = [
        صل(&[«libLLVM-», استنسخ(&الرئيسي), «.so»]), صل(&[«libLLVM.so.», استنسخ(&الرئيسي), «.1»]),
        صل(&[«libLLVM.so.», استنسخ(&الرئيسي)]), «libLLVM.so»,
        صل(&[«libLLVM-», استنسخ(&الرئيسي), «.dylib»]), «libLLVM.dylib»
    ];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
        ليكن المرشح: نص = صل(&[استنسخ(&الدليل), «/», استنسخ(&الأسماء[ف])]);
        إذا (يوجد(&المرشح)) { أرجع اختياري.موجود(مسار_حقيقي(&المرشح)); };
        ف := ف + 1;
    }
    قل_خطأ(&صل(&[«no shared libLLVM in », الدليل, « (from », الإعداد, «)»]));
    أرجع اختياري.لا_شيء();
}

// --- the seed -------------------------------------------------------------------

// Stage1 from the committed seed (bootstrap.c: the seed translated to C and
// compiled with the C compiler, $CC or cc), translated again only when the
// seed or bootstrap.c changed. bootstrap.c writes the same seed.stamp, so the
// Stage1 a run of ./build-bootstrap left here is reused.
عام عرف جهز_المرحلة1(الخيارات: &خيارات_البناء): منطقي {
    ليكن الدليل: نص = دليل_البذرة();
    إذا (!أنشئ_المسار(&الدليل)) { أرجع خطأ; };
    ليكن المدخلات: متجه نص = [«bootstrap-wasm/seed/sultanc.wasm.zst», «bootstrap-wasm/bootstrap.c»];
    ليكن البصمة: نص = بصمة_ملفات(&المدخلات);
    ليكن الختم: نص = صل(&[استنسخ(&الدليل), «/seed.stamp»]);
    ليكن المرحلة1: نص = مسار_المرحلة1();
    ليكن القديم: نص = اقرأ_أو_فارغ(&الختم);
    إذا (يوجد(&المرحلة1) && متساويان(&القديم, &البصمة)) { أرجع صواب; };
    ليكن اسم_cc: نص = «CC»;
    ليكن cc_افتراضي: نص = «cc»;
    ليكن cc: نص = بيئة_أو(&اسم_cc, &cc_افتراضي);
    ليكن كلمات_cc: متجه نص = كلمات_أمر(&cc);
    إذا ((الطول(كلمات_cc) مثل طبيعي) == 0) { أرجع أبلغ(«CC names no C compiler»); };
    ليكن السائق: نص = صل(&[استنسخ(&الدليل), «/build-bootstrap»]);
    ليكن و_السائق: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < (الطول(كلمات_cc) مثل طبيعي)) { ألحق(و_السائق, استنسخ(&كلمات_cc[ف])); ف := ف + 1; }
    ألحق(و_السائق, «-O2»);
    ألحق(و_السائق, «-o»);
    ألحق(و_السائق, استنسخ(&السائق));
    ألحق(و_السائق, «bootstrap-wasm/bootstrap.c»);
    إذا (!نفذ(&كلمات_cc[0], &و_السائق)) { أرجع خطأ; };
    ليكن و_المرحلة1: متغير متجه نص = [
        صل(&[«--out=», استنسخ(&الدليل)]), صل(&[«--jobs=», طبيعي_إلى_نص((*الخيارات).المهام)]), «--stage1-only»
    ];
    إذا (وضع_مفصل()) { ألحق(و_المرحلة1, «--verbose»); };
    إذا (!نفذ(&السائق, &و_المرحلة1)) { أرجع خطأ; };
    أرجع اكتب_نصا(&الختم, &البصمة);
}

// --- one compile of the compiler ------------------------------------------------

// The capability of a compile: whether the compiler includes LLVM (and the
// libLLVM it links) and the release version it reports.
عام نوع قدرة_المترجم = {
    بإل_إل_في_إم: منطقي,
    المكتبة: نص,
    الإصدار: نص
};

عام عرف قدرة_الخيارات(الخيارات: &خيارات_البناء): قدرة_المترجم {
    ليكن القدرة: قدرة_المترجم = {
        بإل_إل_في_إم: (*الخيارات).بإل_إل_في_إم,
        المكتبة: استنسخ(&(*الخيارات).مكتبة_إل_إل_في_إم),
        الإصدار: استنسخ(&(*الخيارات).الإصدار)
    };
    أرجع القدرة;
}

عام عرف قدرة_البذرة(): قدرة_المترجم {
    ليكن القدرة: قدرة_المترجم = { بإل_إل_في_إم: خطأ, المكتبة: «», الإصدار: «» };
    أرجع القدرة;
}

// The module compiler.version of --release-version (generated beside the
// build products; compiler/version.sn is the development build's).
عرف مصدر_الإصدار(الإصدار: &نص): اختياري نص {
    ليكن الدليل: نص = صل(&[دليل_الإقلاع(), «/generated»]);
    إذا (!أنشئ_المسار(&الدليل)) { أرجع اختياري.لا_شيء(); };
    ليكن المسار: نص = صل(&[استنسخ(&الدليل), «/compiler_version.sn»]);
    ليكن المصدر: نص = صل(&[
        "// Generated by the build driver (tools/build) from --release-version; bound\n",
        "// to the module compiler.version in place of compiler/version.sn.\n",
        "عام عرف إصدار_السلطان(): اختياري نص {\n",
        "    أرجع اختياري.موجود(«", استنسخ(الإصدار), "»);\n}\n"
    ]);
    إذا (!اكتب_نصا(&المسار, &المصدر)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(المسار);
}

// One compile of compiler/main.sn at -O2: المنتج builds الناتج with الخلفية
// for الهدف, with القدرة.
عام عرف ترجم_المترجم(
    الخيارات: &خيارات_البناء,
    المنتج: &نص,
    الناتج: &نص,
    الخلفية: &نص,
    الهدف: &نص,
    القدرة: &قدرة_المترجم
): منطقي {
    ليكن الدليل: نص = دليل_المسار(الناتج);
    إذا (!أنشئ_المسار(&الدليل)) { أرجع خطأ; };
    ليكن الوسائط: متغير متجه نص = [
        «compiler/main.sn», «-O2», صل(&[«--backend=», استنسخ(الخلفية)]), صل(&[«--target=», استنسخ(الهدف)]),
        «-o», استنسخ(الناتج)
    ];
    إذا (!(*القدرة).بإل_إل_في_إم) { ألحق(الوسائط, ربط_بلا_إل_إل_في_إم()); };
    إذا (!فارغ_النص(&(*القدرة).الإصدار)) {
        طابق مصدر_الإصدار(&(*القدرة).الإصدار) مع
        | اختياري.موجود(المسار) -> { ألحق(الوسائط, صل(&[«--module-source=compiler.version=», المسار])); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    };
    إذا ((*القدرة).بإل_إل_في_إم) { ألحق(الوسائط, استنسخ(&(*القدرة).المكتبة)); };
    إذا (!نفذ_بمهلة(المنتج, &الوسائط, (*الخيارات).المهلة)) { أرجع خطأ; };
    اجعله_تنفيذيا(الناتج);
    أرجع صواب;
}

// --- the previous compiler ------------------------------------------------------

// The compiler a step starts from: --with, else build/sultanc (unless
// --bootstrap=wasm), else Stage1 from the seed. A compiler other than Stage1
// is copied first, so the step never overwrites the compiler that runs it.
عام عرف المترجم_السابق(الخيارات: &خيارات_البناء): اختياري نص {
    ليكن المترجم: نص = مسار_المترجم();
    ليكن موجود_مبني: منطقي = يوجد(&المترجم);
    ليكن الأصل: متغير نص = «»;
    ليكن wasm: نص = «wasm»;
    ليكن existing: نص = «existing»;
    إذا (!فارغ_النص(&(*الخيارات).السابق)) {
        إذا (!يوجد(&(*الخيارات).السابق)) {
            قل_خطأ(&صل(&[«--with=», استنسخ(&(*الخيارات).السابق), « does not exist»]));
            أرجع اختياري.لا_شيء();
        };
        الأصل := استنسخ(&(*الخيارات).السابق);
    } وإلا إذا (!متساويان(&(*الخيارات).الطريق, &wasm) && موجود_مبني) {
        الأصل := مسار_المترجم();
    } وإلا إذا (متساويان(&(*الخيارات).الطريق, &existing)) {
        ليكن الرسالة: نص = «--bootstrap=existing needs build/sultanc or --with=PATH»;
        قل_خطأ(&الرسالة);
        أرجع اختياري.لا_شيء();
    };
    إذا (فارغ_النص(&الأصل)) {
        إذا (!جهز_المرحلة1(الخيارات)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(مسار_المرحلة1());
    };
    ليكن النسخة: نص = صل(&[دليل_الإقلاع(), «/previous/sultanc»]);
    إذا (!انسخ_إلى(&الأصل, &النسخة)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(النسخة);
}

عام عرف هو_المرحلة1(المسار: &نص): منطقي {
    ليكن المرحلة1: نص = مسار_المرحلة1();
    أرجع متساويان(المسار, &المرحلة1);
}

// --- the stamp ------------------------------------------------------------------

// The hash of the compiler's own sources (every .sn file under compiler/).
// library/, tests/, docs/ and examples/ are not part of it.
عام عرف بصمة_مصادر_المترجم(): نص {
    ليكن الملفات: متغير متجه نص = [];
    ليكن الجذر: نص = «compiler»;
    ليكن اللاحقة: نص = «.sn»;
    ملفات_تحت(&الجذر, &اللاحقة, &متغير الملفات);
    أرجع بصمة_ملفات(&الملفات);
}

// What build/sultanc was built from: the compiler sources and the options.
عام عرف نص_الختم(الخيارات: &خيارات_البناء, بصمة_المصادر: &نص): نص {
    ليكن llvm: نص = «no»;
    ليكن llvm_نعم: نص = «yes»;
    ليكن الأجزاء: متجه نص = [
        «compiler », استنسخ(بصمة_المصادر), "\n",
        «llvm », استنسخ(&llvm), "\n",
        «backend », استنسخ(&(*الخيارات).الخلفية), "\n",
        «target », استنسخ(&(*الخيارات).الهدف), "\n",
        «version », استنسخ(&(*الخيارات).الإصدار), "\n"
    ];
    إذا ((*الخيارات).بإل_إل_في_إم) {
        ليكن بإل: متجه نص = [
            «compiler », استنسخ(بصمة_المصادر), "\n",
            «llvm », استنسخ(&llvm_نعم), « », استنسخ(&(*الخيارات).مكتبة_إل_إل_في_إم), "\n",
            «backend », استنسخ(&(*الخيارات).الخلفية), "\n",
            «target », استنسخ(&(*الخيارات).الهدف), "\n",
            «version », استنسخ(&(*الخيارات).الإصدار), "\n"
        ];
        أرجع صل(&بإل);
    };
    أرجع صل(&الأجزاء);
}

// The first line of the stamp: the sources build/sultanc was built from.
عام عرف سطر_مصادر_الختم(بصمة_المصادر: &نص): نص {
    أرجع صل(&[«compiler », استنسخ(بصمة_المصادر), "\n"]);
}

// --- exporting -------------------------------------------------------------------

// The built compiler goes to build/sultanc (a compiler for the host, with
// its stamp) or to build/cross/<target>/ (sultanc, sultanc.exe for Windows,
// sultanc.wasm for wasm32-wasi), and to --output.
عام عرف صدّر_المترجم(الخيارات: &خيارات_البناء, المبني: &نص, بصمة_المصادر: &نص): منطقي {
    ليكن للمضيف: منطقي = متساويان(&(*الخيارات).الهدف, &(*الخيارات).المضيف);
    ليكن الوجهة: متغير نص = مسار_المترجم();
    إذا (!للمضيف) {
        ليكن الاسم: متغير نص = «sultanc»;
        ليكن ويندوز: نص = «windows»;
        ليكن wasi: نص = «wasi»;
        إذا (يحتوي_نصا(&(*الخيارات).الهدف, &ويندوز)) { الاسم := «sultanc.exe»; };
        إذا (يحتوي_نصا(&(*الخيارات).الهدف, &wasi)) { الاسم := «sultanc.wasm»; };
        الوجهة := صل(&[«build/cross/», استنسخ(&(*الخيارات).الهدف), «/», الاسم]);
    };
    إذا (!انسخ_إلى(المبني, &الوجهة)) { أرجع خطأ; };
    إذا (للمضيف) {
        ليكن الختم: نص = نص_الختم(الخيارات, بصمة_المصادر);
        ليكن مسار: نص = مسار_الختم();
        إذا (!اكتب_نصا(&مسار, &الختم)) { أرجع خطأ; };
    };
    إذا (!فارغ_النص(&(*الخيارات).الإخراج)) {
        إذا (!انسخ_إلى(&الوجهة, &(*الخيارات).الإخراج)) { أرجع خطأ; };
    };
    قل(&صل(&[«compiler: », الوجهة]));
    أرجع صواب;
}

// --- the commands ------------------------------------------------------------------

عام عرف خلفية_أصلية(): نص { أرجع «native»; }
عام عرف خلفية_إل_إل_في_إم(): نص { أرجع «llvm»; }

// Why a step cannot run with this producer, backend and target ("" when it can).
عرف عائق_الخطوة(الخيارات: &خيارات_البناء, المنتج: &نص): نص {
    ليكن llvm: نص = خلفية_إل_إل_في_إم();
    ليكن native: نص = خلفية_أصلية();
    إذا (هو_المرحلة1(المنتج) && متساويان(&(*الخيارات).الخلفية, &llvm)) {
        أرجع «Stage1 from the seed has no LLVM backend: --backend=llvm needs --with=PATH (a compiler built --enable-llvm)»;
    };
    إذا (متساويان(&(*الخيارات).الهدف, &(*الخيارات).المضيف) && !هدف_أصلي(&(*الخيارات).المضيف)
        && متساويان(&(*الخيارات).الخلفية, &native)) {
        أرجع صل(&[
            «the Native backend cannot build a compiler for », استنسخ(&(*الخيارات).المضيف),
            «: use --backend=llvm with --with=PATH, or build it on a Native host (--target)»
        ]);
    };
    أرجع «»;
}

// The developer loop: one step from the previous compiler, nothing when
// compiler/ and the options did not change since build/sultanc was built.
عام عرف ابن(الخيارات: &خيارات_البناء): منطقي {
    ليكن البصمة: نص = بصمة_مصادر_المترجم();
    ليكن للمضيف: منطقي = متساويان(&(*الخيارات).الهدف, &(*الخيارات).المضيف);
    ليكن wasm: نص = «wasm»;
    ليكن المترجم: نص = مسار_المترجم();
    ليكن مسار_ختم: نص = مسار_الختم();
    إذا (للمضيف && !(*الخيارات).أعد_البناء && فارغ_النص(&(*الخيارات).السابق)
        && !متساويان(&(*الخيارات).الطريق, &wasm) && يوجد(&المترجم)) {
        ليكن الختم: نص = نص_الختم(الخيارات, &البصمة);
        ليكن القديم: نص = اقرأ_أو_فارغ(&مسار_ختم);
        إذا (متساويان(&الختم, &القديم)) {
            ليكن الرسالة: نص = «build/sultanc is up to date (compiler/ and the options did not change; --rebuild builds anyway)»;
            قل(&الرسالة);
            إذا (!فارغ_النص(&(*الخيارات).الإخراج)) {
                إذا (!انسخ_إلى(&المترجم, &(*الخيارات).الإخراج)) { أرجع خطأ; };
            };
            قل(&صل(&[«compiler: », مسار_المترجم()]));
            أرجع صواب;
        };
    };
    ليكن المنتج: نص;
    طابق المترجم_السابق(الخيارات) مع
    | اختياري.موجود(م) -> { المنتج := م; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن العائق: نص = عائق_الخطوة(الخيارات, &المنتج);
    إذا (!فارغ_النص(&العائق)) { أرجع أبلغ(العائق); };
    ليكن التالي: نص = صل(&[دليل_الإقلاع(), «/next/sultanc»]);
    ليكن القدرة: قدرة_المترجم = قدرة_الخيارات(الخيارات);
    إذا (هو_المرحلة1(&المنتج)) {
        ليكن الرسالة: نص = «building the compiler from compiler/ with the seed compiler»;
        قل(&الرسالة);
    } وإلا {
        ليكن الرسالة: نص = «building the compiler from compiler/ with the previous compiler»;
        قل(&الرسالة);
    };
    إذا (!ترجم_المترجم(الخيارات, &المنتج, &التالي, &(*الخيارات).الخلفية, &(*الخيارات).الهدف, &القدرة)) {
        أرجع خطأ;
    };
    أرجع صدّر_المترجم(الخيارات, &التالي, &البصمة);
}

// The fixpoint: Stage1 (or --with) builds S2, S2 builds S3, S2 == S3. With
// --enable-llvm on a Native host: S3 builds llvm-a with LLVM, llvm-a builds
// llvm-b (the LLVM fixpoint, llvm-a == llvm-b), and llvm-a builds a native
// compiler equal to S3 (cross-backend equality).
عام عرف تحقق(الخيارات: &خيارات_البناء): منطقي {
    إذا (!متساويان(&(*الخيارات).الهدف, &(*الخيارات).المضيف)) {
        أرجع أبلغ(صل(&[«verify runs the compilers it builds: it needs the host target (», استنسخ(&(*الخيارات).المضيف), «)»]));
    };
    ليكن الدليل: نص = صل(&[دليل_الإقلاع(), «/verify»]);
    أزل_الشجرة(&الدليل);
    إذا (!أنشئ_المسار(&الدليل)) { أرجع خطأ; };
    ليكن المنتج: متغير نص = مسار_المرحلة1();
    إذا (!فارغ_النص(&(*الخيارات).السابق)) {
        طابق المترجم_السابق(الخيارات) مع
        | اختياري.موجود(م) -> { المنتج := م; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    } وإلا {
        إذا (!جهز_المرحلة1(الخيارات)) { أرجع خطأ; };
    };
    ليكن العائق: نص = عائق_الخطوة(الخيارات, &المنتج);
    إذا (!فارغ_النص(&العائق)) { أرجع أبلغ(العائق); };
    ليكن البصمة: نص = بصمة_مصادر_المترجم();
    ليكن القدرة: قدرة_المترجم = قدرة_الخيارات(الخيارات);
    ليكن s2: نص = صل(&[استنسخ(&الدليل), «/sultanc-s2»]);
    ليكن s3: نص = صل(&[استنسخ(&الدليل), «/sultanc-s3»]);
    ليكن رسالة_التحقق: نص = «verifying: building the compiler, then building it again with itself; the two must be identical»;
    قل(&رسالة_التحقق);
    إذا (!ترجم_المترجم(الخيارات, &المنتج, &s2, &(*الخيارات).الخلفية, &(*الخيارات).المضيف, &القدرة)) { أرجع خطأ; };
    إذا (!ترجم_المترجم(الخيارات, &s2, &s3, &(*الخيارات).الخلفية, &(*الخيارات).المضيف, &القدرة)) { أرجع خطأ; };
    إذا (!ملفان_متساويان(&s2, &s3)) {
        أرجع أبلغ(صل(&[«fixpoint failed: », استنسخ(&s2), « and », استنسخ(&s3), « differ (a seed older than the sources: ./build.sh seed-update)»]));
    };
    قل(&صل(&[«fixpoint: », استنسخ(&s2), « == », استنسخ(&s3)]));
    ليكن native: نص = خلفية_أصلية();
    ليكن llvm: نص = خلفية_إل_إل_في_إم();
    إذا ((*الخيارات).بإل_إل_في_إم && هدف_أصلي(&(*الخيارات).المضيف) && متساويان(&(*الخيارات).الخلفية, &native)) {
        ليكن أ: نص = صل(&[استنسخ(&الدليل), «/sultanc-llvm-a»]);
        ليكن ب: نص = صل(&[استنسخ(&الدليل), «/sultanc-llvm-b»]);
        ليكن ن: نص = صل(&[استنسخ(&الدليل), «/sultanc-native-by-llvm»]);
        إذا (!ترجم_المترجم(الخيارات, &s3, &أ, &llvm, &(*الخيارات).المضيف, &القدرة)) { أرجع خطأ; };
        إذا (!ترجم_المترجم(الخيارات, &أ, &ب, &llvm, &(*الخيارات).المضيف, &القدرة)) { أرجع خطأ; };
        إذا (!ملفان_متساويان(&أ, &ب)) { أرجع أبلغ(صل(&[«LLVM fixpoint failed: », استنسخ(&أ), « and », استنسخ(&ب), « differ»])); };
        قل(&صل(&[«LLVM fixpoint: », استنسخ(&أ), « == », استنسخ(&ب)]));
        إذا (!ترجم_المترجم(الخيارات, &أ, &ن, &native, &(*الخيارات).المضيف, &القدرة)) { أرجع خطأ; };
        إذا (!ملفان_متساويان(&s3, &ن)) { أرجع أبلغ(صل(&[«cross-backend failed: », استنسخ(&s3), « and », استنسخ(&ن), « differ»])); };
        قل(&صل(&[«cross-backend: », استنسخ(&s3), « == », استنسخ(&ن)]));
    };
    أرجع صدّر_المترجم(الخيارات, &s2, &البصمة);
}

// Stage1 from the seed only.
عام عرف أقلع(الخيارات: &خيارات_البناء): منطقي {
    إذا (!جهز_المرحلة1(الخيارات)) { أرجع خطأ; };
    ليكن المرحلة1: نص = مسار_المرحلة1();
    ليكن النسخة: نص = صل(&[دليل_الإقلاع(), «/sultanc-stage1»]);
    إذا (!انسخ_إلى(&المرحلة1, &النسخة)) { أرجع خطأ; };
    إذا (!فارغ_النص(&(*الخيارات).الإخراج)) {
        إذا (!انسخ_إلى(&المرحلة1, &(*الخيارات).الإخراج)) { أرجع خطأ; };
    };
    قل(&صل(&[«Stage1: », النسخة]));
    أرجع صواب;
}

// The committed seed equals what the sources build (Native-only, wasm32-wasi,
// -O2): rebuilt by build/sultanc when it was built from these sources, else
// by an S2 built from the seed (Stage1 itself on a host without a Native
// backend). 3 when it differs.
عام عرف افحص_البذرة(الخيارات: &خيارات_البناء): عدد {
    إذا (!جهز_المرحلة1(الخيارات)) { أرجع 1; };
    ليكن الدليل: نص = دليل_البذرة();
    ليكن البصمة: نص = بصمة_مصادر_المترجم();
    ليكن مسار_ختم: نص = مسار_الختم();
    ليكن الختم: نص = اقرأ_أو_فارغ(&مسار_ختم);
    ليكن السطر: نص = سطر_مصادر_الختم(&البصمة);
    ليكن المترجم: نص = مسار_المترجم();
    ليكن البذرة_قدرة: قدرة_المترجم = قدرة_البذرة();
    ليكن native: نص = خلفية_أصلية();
    ليكن المنتج: متغير نص = مسار_المرحلة1();
    إذا (يوجد(&المترجم) && يبدأ_بـ(&الختم, &السطر)) {
        المنتج := مسار_المترجم();
    } وإلا إذا (هدف_أصلي(&(*الخيارات).المضيف)) {
        ليكن s2: نص = صل(&[استنسخ(&الدليل), «/sultanc-s2»]);
        ليكن المرحلة1: نص = مسار_المرحلة1();
        إذا (!ترجم_المترجم(الخيارات, &المرحلة1, &s2, &native, &(*الخيارات).المضيف, &البذرة_قدرة)) { أرجع 1; };
        المنتج := s2;
    };
    ليكن المعاد: نص = صل(&[استنسخ(&الدليل), «/sultanc.wasm»]);
    ليكن الملتزمة: نص = صل(&[استنسخ(&الدليل), «/sultanc.committed.wasm»]);
    ليكن wasi: نص = «wasm32-wasi»;
    ليكن رسالة_الفحص: نص = «seed check: rebuilding the seed from compiler/»;
    قل(&رسالة_الفحص);
    إذا (!ترجم_المترجم(الخيارات, &المنتج, &المعاد, &native, &wasi, &البذرة_قدرة)) { أرجع 1; };
    ليكن المترجم_سي: نص = صل(&[استنسخ(&الدليل), «/sultanc-wasm2c»]);
    ليكن و_الفك: متجه نص = [«--decompress», «bootstrap-wasm/seed/sultanc.wasm.zst», استنسخ(&الملتزمة)];
    إذا (!نفذ(&المترجم_سي, &و_الفك)) { أرجع 1; };
    إذا (ملفان_متساويان(&المعاد, &الملتزمة)) {
        قل(&صل(&[«seed check: the committed seed is reproduced exactly (by », المنتج, «)»]));
        أرجع 0;
    };
    قل_خطأ(&صل(&[
        "seed check: the current sources give a different seed\n",
        "  committed bootstrap-wasm/seed/sultanc.wasm.zst\n  rebuilt   ", المعاد,
        "\n  a seed bump replaces it: ./build.sh seed-update"
    ]));
    أرجع 3;
}

// The seed bump: bootstrap.c --update-seed rebuilds the seed module,
// compresses it (zstd -19), checks that the in-tree decoder gives it back and
// replaces the committed seed.
عام عرف حدّث_البذرة(الخيارات: &خيارات_البناء): منطقي {
    إذا (!جهز_المرحلة1(الخيارات)) { أرجع خطأ; };
    ليكن السائق: نص = صل(&[دليل_البذرة(), «/build-bootstrap»]);
    // --output keeps build/sultanc as it is: its compiler stays in the scratch
    // directory.
    ليكن و: متغير متجه نص = [
        صل(&[«--out=», دليل_الإقلاع(), «/seed-update»]), صل(&[«--output=», دليل_الإقلاع(), «/seed-update/sultanc»]),
        صل(&[«--jobs=», طبيعي_إلى_نص((*الخيارات).المهام)]), «--update-seed»
    ];
    إذا (وضع_مفصل()) { ألحق(و, «--verbose»); };
    إذا (!نفذ(&السائق, &و)) { أرجع خطأ; };
    ليكن الرسالة: نص = «then check it from a clean tree: ./build.sh verify && ./build.sh seed-check»;
    قل(&الرسالة);
    أرجع صواب;
}
