استورد std.process.child;
استورد std.process.command;
استورد std.env.environment;
استورد std.fs.directory;
استورد std.fs.metadata;
استورد std.fs.mutation;
استورد std.fs.permissions;
استورد std.fs.read_file;
استورد std.fs.write_file;
استورد std.text.compare;
استورد std.text.search;
استورد std.text.from_bytes;
استورد std.text.number;
استورد std.text.transform;
استورد std.io.println;
استورد std.time.duration;
استورد std.collections.sort;
استورد std.crypto.sha256;
استورد std.encoding.hex;

// What the build driver (tools/build/main.sn) needs of the host: texts,
// messages, files and directories, hashes and commands. POSIX hosts (the
// driver runs from build.sh); Windows builds with bootstrap/chain.ps1 and
// .github/ci/windows.ps1.

// --- texts -------------------------------------------------------------------

عام عرف صل(الأجزاء: &متجه نص): نص {
    ليكن فارغ: نص = «»;
    أرجع صل_النصوص(الأجزاء, &فارغ);
}

عام عرف متساويان(أ: &نص, ب: &نص): منطقي { أرجع نصان_متساويان(أ, ب); }

عام عرف فارغ_النص(النص: &نص): منطقي { أرجع (الطول(*النص) مثل طبيعي) == 0; }

// The bytes of النص from البداية up to النهاية (exclusive).
عام عرف جزء_من(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < النهاية && ف < (الطول(*النص) مثل طبيعي)) { ألحق(البايتات, (*النص)[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

// The directory part of a path ("." for a bare name).
عام عرف دليل_المسار(المسار: &نص): نص {
    ليكن الفاصل: نص = «/»;
    طابق ابحث_نصا_عكسيا(المسار, &الفاصل) مع
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع == 0) { أرجع «/»; };
        أرجع جزء_من(المسار, 0, الموضع);
    }
    | اختياري.لا_شيء -> { أرجع «.»; };
}

عام عرف اسم_المسار(المسار: &نص): نص {
    ليكن الفاصل: نص = «/»;
    طابق ابحث_نصا_عكسيا(المسار, &الفاصل) مع
    | اختياري.موجود(الموضع) -> {
        أرجع جزء_من(المسار, الموضع + 1, الطول(*المسار) مثل طبيعي);
    }
    | اختياري.لا_شيء -> { أرجع استنسخ(المسار); };
}

// المسار as an absolute path: under the working directory when relative.
عام عرف مسار_مطلق(المسار: &نص): نص {
    ليكن الجذر: نص = «/»;
    إذا (يبدأ_بـ(المسار, &الجذر)) { أرجع استنسخ(المسار); };
    طابق دليل_العمل() مع
    | نتيجة.نجح(الدليل) -> { أرجع صل(&[الدليل, «/», استنسخ(المسار)]); }
    | نتيجة.خطأ(_) -> { أرجع استنسخ(المسار); };
}

// --- messages ----------------------------------------------------------------

عام عرف قل(النص: &نص): فراغ {
    طابق اطبع_سطر(صل(&[«build: », استنسخ(النص)])) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
}

عام عرف قل_خطأ(النص: &نص): فراغ {
    طابق اطبع_سطر_خطأ(صل(&[«build: error: », استنسخ(النص)])) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
}

// Reports النص as the error and answers false: `أرجع أبلغ(...)`.
عام عرف أبلغ(النص: نص): منطقي {
    قل_خطأ(&النص);
    أرجع خطأ;
}

// --- the environment ------------------------------------------------------------

عام عرف بيئة_أو(الاسم: &نص, الافتراضي: &نص): نص {
    طابق متغير_بيئة(الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        إذا (!فارغ_النص(&القيمة)) { أرجع القيمة; };
        أرجع استنسخ(الافتراضي);
    }
    | _ -> { أرجع استنسخ(الافتراضي); };
}

// --verbose: main.sn sets SULTANC_BUILD_VERBOSE=1, and each command is shown
// before it runs. Otherwise a command shows only its own output, and a failed
// one its command line.
عام عرف وضع_مفصل(): منطقي {
    ليكن الاسم: نص = «SULTANC_BUILD_VERBOSE»;
    ليكن فارغ: نص = «»;
    ليكن القيمة: نص = بيئة_أو(&الاسم, &فارغ);
    أرجع !فارغ_النص(&القيمة);
}

// --- files ----------------------------------------------------------------------

عام عرف يوجد(المسار: &نص): منطقي {
    طابق موجود(المسار) مع
    | نتيجة.نجح(الحالة) -> { أرجع الحالة; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// Creates المسار and every directory above it that is missing.
عام عرف أنشئ_المسار(المسار: &نص): منطقي {
    إذا (يوجد(المسار)) { أرجع صواب; };
    ليكن البايتات: متجه ط8 = بايتات_من_نص(استنسخ(المسار));
    ليكن العدد: طبيعي = الطول(البايتات) مثل طبيعي;
    ليكن الجزء: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف <= العدد) {
        ليكن عند_فاصل: منطقي = ف == العدد || البايتات[ف] == 0x2F;
        إذا (عند_فاصل && (الطول(الجزء) مثل طبيعي) > 0) {
            ليكن المقطع: نص = من_بايتات(&الجزء);
            إذا (!يوجد(&المقطع)) {
                طابق أنشئ_دليلا(&المقطع) مع
                | نتيجة.نجح(_) -> { }
                | نتيجة.خطأ(_) -> {
                    // Another process may have made it meanwhile.
                    إذا (!يوجد(&المقطع)) { أرجع أبلغ(صل(&[«cannot create the directory », المقطع])); };
                };
            };
        };
        إذا (ف < العدد) { ألحق(الجزء, البايتات[ف]); };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Removes المسار: a file, or a directory and everything under it (a link is
// removed, never followed). Nothing to remove is not an error.
عام عرف أزل_الشجرة(المسار: &نص): فراغ {
    إذا (!يوجد(المسار)) {
        طابق أزل_ملفا(المسار) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
        أرجع;
    };
    طابق اقرأ_مدخلات_الدليل(المسار) مع
    | نتيجة.خطأ(_) -> {
        طابق أزل_ملفا(المسار) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
    }
    | نتيجة.نجح(المداخل) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            ليكن الابن: نص = صل(&[استنسخ(المسار), «/», استنسخ(&المداخل[ف].الاسم)]);
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> { أزل_الشجرة(&الابن); }
            | _ -> {
                طابق أزل_ملفا(&الابن) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
            };
            ف := ف + 1;
        }
        طابق أزل_دليلا(المسار) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
    };
}

عام عرف اقرأ_أو_فارغ(المسار: &نص): نص {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.نجح(النص) -> { أرجع النص; }
    | نتيجة.خطأ(_) -> { أرجع «»; };
}

عام عرف اكتب_نصا(المسار: &نص, النص: &نص): منطقي {
    طابق اكتب_الملف(المسار, النص) مع
    | نتيجة.نجح(_) -> { أرجع صواب; }
    | نتيجة.خطأ(_) -> { أرجع أبلغ(صل(&[«cannot write », استنسخ(المسار)])); };
}

// Marks المسار executable (0755): a compiler a WASI-hosted Stage1 wrote has no
// mode bits.
عام عرف اجعله_تنفيذيا(المسار: &نص): فراغ {
    طابق اضبط_أذونات(المسار, 493) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
}

// Copies المصدر to الوجهة through a temporary beside it, then renames it
// into place, so الوجهة is never half written; the copy is executable.
عام عرف انسخ_إلى(المصدر: &نص, الوجهة: &نص): منطقي {
    ليكن الدليل: نص = دليل_المسار(الوجهة);
    إذا (!أنشئ_المسار(&الدليل)) { أرجع خطأ; };
    ليكن المؤقت: نص = صل(&[استنسخ(الوجهة), «.new»]);
    طابق انسخ_الملف(المصدر, &المؤقت) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع أبلغ(صل(&[«cannot copy », استنسخ(المصدر), « to », استنسخ(الوجهة)])); };
    اجعله_تنفيذيا(&المؤقت);
    طابق أعد_تسمية(&المؤقت, الوجهة) مع
    | نتيجة.نجح(_) -> { أرجع صواب; }
    | نتيجة.خطأ(_) -> { أرجع أبلغ(صل(&[«cannot replace », استنسخ(الوجهة)])); };
}

عام عرف ملفان_متساويان(أ: &نص, ب: &نص): منطقي {
    طابق اقرأ_بايتات_ملف(أ) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(بايتات_أ) -> {
        طابق اقرأ_بايتات_ملف(ب) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(بايتات_ب) -> {
            إذا (الطول(بايتات_أ) != الطول(بايتات_ب)) { أرجع خطأ; };
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(بايتات_أ) مثل طبيعي)) {
                إذا (بايتات_أ[ف] != بايتات_ب[ف]) { أرجع خطأ; };
                ف := ف + 1;
            }
            أرجع صواب;
        };
    };
}

// The files under الدليل whose name ends in اللاحقة, recursively, each
// directory's entries in byte order (the same list on every host and file
// system).
عام عرف ملفات_تحت(الدليل: &نص, اللاحقة: &نص, الناتج: &متغير متجه نص): فراغ {
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(المداخل) -> {
        ليكن الأسماء: متغير متجه نص = [];
        ليكن الأدلة: متغير متجه نص = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> { ألحق(الأدلة, استنسخ(&المداخل[ف].الاسم)); }
            | نوع_مدخل_دليل.ملف -> {
                إذا (ينتهي_بـ(&المداخل[ف].الاسم, اللاحقة)) { ألحق(الأسماء, استنسخ(&المداخل[ف].الاسم)); };
            }
            | _ -> { };
            ف := ف + 1;
        }
        رتب_نصوص(&متغير الأسماء);
        رتب_نصوص(&متغير الأدلة);
        ف := 0;
        طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
            ألحق(*الناتج, صل(&[استنسخ(الدليل), «/», استنسخ(&الأسماء[ف])]));
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول(الأدلة) مثل طبيعي)) {
            ليكن الابن: نص = صل(&[استنسخ(الدليل), «/», استنسخ(&الأدلة[ف])]);
            ملفات_تحت(&الابن, اللاحقة, الناتج);
            ف := ف + 1;
        }
    };
}

// --- hashes ---------------------------------------------------------------------

عام عرف بصمة_بايتات(البايتات: &متجه ط8): نص {
    ليكن الملخص: متجه ط8 = شا256(البايتات);
    أرجع رمز_سداسي(&الملخص);
}

عام عرف بصمة_نص(النص: &نص): نص {
    ليكن البايتات: متجه ط8 = بايتات_من_نص(استنسخ(النص));
    أرجع بصمة_بايتات(&البايتات);
}

// One hash of the files, by name and content: the hash of the lines
// "<hash of the file>  <path>".
عام عرف بصمة_ملفات(الملفات: &متجه نص): نص {
    ليكن الأسطر: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الملفات) مثل طبيعي)) {
        ليكن البصمة: متغير نص = «missing»;
        طابق اقرأ_بايتات_ملف(&(*الملفات)[ف]) مع
        | نتيجة.نجح(البايتات) -> { البصمة := بصمة_بايتات(&البايتات); }
        | نتيجة.خطأ(_) -> { };
        ألحق(الأسطر, صل(&[البصمة, «  », استنسخ(&(*الملفات)[ف]), "\n"]));
        ف := ف + 1;
    }
    ليكن الكل: نص = صل(&الأسطر);
    أرجع بصمة_نص(&الكل);
}

// --- commands -------------------------------------------------------------------

عام عرف نص_الأمر(البرنامج: &نص, الوسائط: &متجه نص): نص {
    ليكن الأجزاء: متغير متجه نص = [استنسخ(البرنامج)];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوسائط) مثل طبيعي)) {
        ألحق(الأجزاء, « »);
        ألحق(الأجزاء, استنسخ(&(*الوسائط)[ف]));
        ف := ف + 1;
    }
    أرجع صل(&الأجزاء);
}

عرف نهاية_ناجحة(النهاية: &حالة_إنهاء, الأمر: &نص): منطقي {
    طابق *النهاية مع
    | حالة_إنهاء.خرج(الرمز) -> {
        إذا (الرمز == 0) { أرجع صواب; };
        أرجع أبلغ(صل(&[«exit status », عدد_إلى_نص(الرمز), «: », استنسخ(الأمر)]));
    }
    | حالة_إنهاء.إشارة(الإشارة) -> {
        أرجع أبلغ(صل(&[«signal », عدد_إلى_نص(الإشارة), «: », استنسخ(الأمر)]));
    };
}

// Runs البرنامج (a bare name is searched in PATH) with الوسائط in الدليل
// ("" for this directory), on this process's standard streams; true when it
// exits with status 0. The command line is shown with --verbose, and always
// when it fails.
عام عرف نفذ_في(الدليل: &نص, البرنامج: &نص, الوسائط: &متجه نص): منطقي {
    ليكن الوصف: نص = نص_الأمر(البرنامج, الوسائط);
    إذا (وضع_مفصل()) { قل(&الوصف); };
    ليكن الأمر: متغير أمر = أنشئ_أمرا(البرنامج);
    أضف_وسائط_للأمر(&متغير الأمر, الوسائط);
    إذا (!فارغ_النص(الدليل)) { اضبط_دليل_الأمر(&متغير الأمر, الدليل); };
    طابق شغل_الأمر(&الأمر) مع
    | نتيجة.نجح(النهاية) -> { أرجع نهاية_ناجحة(&النهاية, &الوصف); }
    | نتيجة.خطأ(_) -> { أرجع أبلغ(صل(&[«cannot start: », الوصف])); };
}

عام عرف نفذ(البرنامج: &نص, الوسائط: &متجه نص): منطقي {
    ليكن هنا: نص = «»;
    أرجع نفذ_في(&هنا, البرنامج, الوسائط);
}

// The same, killed when it runs longer than المهلة seconds (0: no limit): a
// hung build of the compiler fails with its command line instead of running
// into a CI job's time limit.
عام عرف نفذ_بمهلة(البرنامج: &نص, الوسائط: &متجه نص, المهلة: عدد): منطقي {
    إذا (المهلة <= 0) { أرجع نفذ(البرنامج, الوسائط); };
    ليكن الوصف: نص = نص_الأمر(البرنامج, الوسائط);
    إذا (وضع_مفصل()) { قل(&الوصف); };
    ليكن المدة: مدة;
    طابق مدة_من_ثواني(المهلة) مع
    | اختياري.لا_شيء -> { أرجع نفذ(البرنامج, الوسائط); }
    | اختياري.موجود(م) -> { المدة := م; };
    ليكن الطفل: متغير عملية_طفلة;
    طابق شغل_عملية(البرنامج, الوسائط) مع
    | نتيجة.خطأ(_) -> { أرجع أبلغ(صل(&[«cannot start: », الوصف])); }
    | نتيجة.نجح(ط) -> { الطفل := ط; };
    طابق انتظر_عملية_بمهلة(&متغير الطفل, &المدة) مع
    | نتيجة.خطأ(_) -> { أرجع أبلغ(صل(&[«cannot wait for: », الوصف])); }
    | نتيجة.نجح(اختياري.موجود(النهاية)) -> { أرجع نهاية_ناجحة(&النهاية, &الوصف); }
    | نتيجة.نجح(اختياري.لا_شيء) -> {
        ليكن تجاهل: نتيجة اختياري حالة_إنهاء, عدد = اقتل_عملية(&متغير الطفل);
        أرجع أبلغ(صل(&[«did not finish within », عدد_إلى_نص(المهلة), «s (SULTANC_COMPILE_TIMEOUT): », الوصف]));
    };
}

// The standard output of البرنامج, its surrounding white space removed, when
// it exits with status 0.
عام عرف خرج_أمر(البرنامج: &نص, الوسائط: &متجه نص): اختياري نص {
    ليكن الأمر: متغير أمر = أنشئ_أمرا(البرنامج);
    أضف_وسائط_للأمر(&متغير الأمر, الوسائط);
    طابق اجمع_خرج_الأمر(&الأمر) مع
    | نتيجة.نجح(الناتج) -> {
        إذا (!هل_نجح_الأمر(&الناتج.الحالة)) { أرجع اختياري.لا_شيء(); };
        ليكن الخرج: نص = من_بايتات(&الناتج.الخرج);
        أرجع اختياري.موجود(قص_النص(&الخرج));
    }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// A command given as one text (CC="clang -m64"): its program and arguments.
عام عرف كلمات_أمر(الأمر: &نص): متجه نص { أرجع قسم_بالفراغات(الأمر); }

// --- the host -------------------------------------------------------------------

// The SultanC target of this host ("" when SultanC has none), from uname.
عام عرف هدف_المضيف(): نص {
    ليكن uname: نص = «uname»;
    ليكن و_النظام: متجه نص = [«-s»];
    ليكن و_الآلة: متجه نص = [«-m»];
    ليكن النظام: متغير نص = «»;
    ليكن الآلة: متغير نص = «»;
    طابق خرج_أمر(&uname, &و_النظام) مع | اختياري.موجود(ق) -> { النظام := ق; } | اختياري.لا_شيء -> { };
    طابق خرج_أمر(&uname, &و_الآلة) مع | اختياري.موجود(ق) -> { الآلة := ق; } | اختياري.لا_شيء -> { };
    ليكن لينكس: نص = «Linux»;
    ليكن داروين: نص = «Darwin»;
    ليكن x64: نص = «x86_64»;
    ليكن amd64: نص = «amd64»;
    ليكن aarch64: نص = «aarch64»;
    ليكن arm64: نص = «arm64»;
    ليكن إكس: منطقي = متساويان(&الآلة, &x64) || متساويان(&الآلة, &amd64);
    ليكن ذراع: منطقي = متساويان(&الآلة, &aarch64) || متساويان(&الآلة, &arm64);
    إذا (متساويان(&النظام, &لينكس) && إكس) { أرجع «x86_64-linux»; };
    إذا (متساويان(&النظام, &لينكس) && ذراع) { أرجع «aarch64-linux-gnu»; };
    إذا (متساويان(&النظام, &داروين) && ذراع) { أرجع «arm64-darwin»; };
    إذا (متساويان(&النظام, &داروين) && إكس) { أرجع «x86_64-darwin»; };
    أرجع «»;
}

// Whether SultanC's Native backend can build a compiler for الهدف.
عام عرف هدف_أصلي(الهدف: &نص): منطقي {
    ليكن لينكس: نص = «x86_64-linux»;
    ليكن ماك: نص = «arm64-darwin»;
    أرجع متساويان(الهدف, &لينكس) || متساويان(الهدف, &ماك);
}

// The number of processors (for parallel C compilations).
عام عرف عدد_المعالجات(): طبيعي {
    ليكن getconf: نص = «getconf»;
    ليكن و: متجه نص = [«_NPROCESSORS_ONLN»];
    طابق خرج_أمر(&getconf, &و) مع
    | اختياري.موجود(النص) -> {
        طابق حلل_عدد(&النص) مع
        | نتيجة.نجح(العدد) -> { إذا (العدد > 0) { أرجع العدد مثل طبيعي; }; }
        | نتيجة.خطأ(_) -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع 2;
}

// The file a chain of symbolic links ends at, as an absolute path without
// links: two builds that link the same library name it the same way.
عام عرف مسار_حقيقي(المسار: &نص): نص {
    ليكن sh: نص = «/bin/sh»;
    ليكن السكربت: نص = «p=$1; while [ -L "$p" ]; do l=$(readlink "$p"); case "$l" in /*) p=$l ;; *) p=$(dirname "$p")/$l ;; esac; done; printf '%s/%s' "$(cd "$(dirname "$p")" && pwd -P)" "$(basename "$p")"»;
    ليكن و: متجه نص = [«-c», السكربت, «sh», استنسخ(المسار)];
    طابق خرج_أمر(&sh, &و) مع
    | اختياري.موجود(الحقيقي) -> { أرجع الحقيقي; }
    | اختياري.لا_شيء -> { أرجع مسار_مطلق(المسار); };
}
