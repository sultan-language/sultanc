/*
 * SultanC canonical frontend identifier-policy registry.
 *
 * This declarative file is the single owner of:
 *   - scalars ignored by semantic identifier identity;
 *   - scalars normalized to one canonical semantic identity;
 *   - scalars accepted at the start of an identifier;
 *   - additional scalars accepted after the first scalar.
 *
 * Stage 0 and Stage 1 mirrors are generated by
 * tools/generate/generate_identifier_policy.py. Identifier-rest classification
 * includes every identifier-start scalar automatically.
 */

SULTANC__IDENTIFIER_IGNORED_SCALAR__(0x0640)

/* Arabic Alef variants share one semantic identifier identity. */
SULTANC__IDENTIFIER_NORMALIZED_SCALAR__(0x0622, 0x0627)
SULTANC__IDENTIFIER_NORMALIZED_SCALAR__(0x0623, 0x0627)
SULTANC__IDENTIFIER_NORMALIZED_SCALAR__(0x0625, 0x0627)

