SULTANC__IDENTIFIER_START_SCALAR__(0x005F)
SULTANC__IDENTIFIER_START_RANGE__(0x0621, 0x063A)
SULTANC__IDENTIFIER_START_RANGE__(0x0641, 0x064A)
SULTANC__IDENTIFIER_START_RANGE__(0x066E, 0x066F)
SULTANC__IDENTIFIER_START_RANGE__(0x0671, 0x06D3)
SULTANC__IDENTIFIER_START_SCALAR__(0x06D5)
SULTANC__IDENTIFIER_START_RANGE__(0x06E5, 0x06E6)
SULTANC__IDENTIFIER_START_RANGE__(0x06EE, 0x06EF)
SULTANC__IDENTIFIER_START_RANGE__(0x06FA, 0x06FC)
SULTANC__IDENTIFIER_START_SCALAR__(0x06FF)
SULTANC__IDENTIFIER_START_RANGE__(0x0750, 0x077F)
SULTANC__IDENTIFIER_START_RANGE__(0x08A0, 0x08C9)

SULTANC__IDENTIFIER_REST_RANGE__(0x0030, 0x0039)
