استورد compiler.backend.abi.abi_model;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.layout.layout_resolution;
استورد compiler.backend.target.target_model;

// Architecture-neutral facts that foreign C ABI classifiers read from a value:
// its flattened scalar leaves (offset, size, floating or not) in layout order.
// This module owns no ABI policy; each architecture's classifier decides what
// the leaves mean. A tagged enum (and every type whose layout is a tagged
// union) has no C equivalent, so it yields no leaves and the classifier
// rejects it explicitly.

عام نوع ورقة_تجميع_واجهة = {
    الإزاحة: غير_موقع,
    الحجم: غير_موقع,
    عائم: منطقي
};

عرف بدائي_عائم_أوراق_واجهة(البدائي: نوع_بدائي_مقنن): منطقي {
    أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري();
}

// Scalar kinds a C ABI can carry: integers, booleans, characters, floats and
// address-like values (pointers, references, boxes, function values).
عرف شكل_سلمي_أوراق_واجهة(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق صنف_النوع_البدائي(البدائي) مع
            | صنف_نوع_بدائي.منطقي -> { أرجع صواب; }
            | صنف_نوع_بدائي.حرف -> { أرجع صواب; }
            | صنف_نوع_بدائي.عدد_موقع -> { أرجع صواب; }
            | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> { أرجع صواب; }
            | صنف_نوع_بدائي.عشري -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | صنف_شكل_نوع_دلالي.مؤشر -> { أرجع صواب; }
        | صنف_شكل_نوع_دلالي.مرجع -> { أرجع صواب; }
        | صنف_شكل_نوع_دلالي.صندوق -> { أرجع صواب; }
        | صنف_شكل_نوع_دلالي.دالة -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عام عرف نوع_عائم_أوراق_واجهة(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع بدائي_عائم_أوراق_واجهة(البدائي); }
        | _ -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

// Appends the scalar leaves of النوع placed at byte offset الإزاحة. Returns
// false for a type that has no C representation. Zero-size members add no
// leaf, as in the C ABIs, which ignore empty members of C structures.
عام عرف اجمع_أوراق_تجميع_واجهة(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    الإزاحة: غير_موقع,
    الأوراق: &متغير متجه ورقة_تجميع_واجهة
): منطقي {
    دع التخطيط: واصف_تخطيط;
    طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(القيمة) -> { التخطيط := القيمة; }
    | _ -> { أرجع خطأ; };
    لو (التخطيط.الحجم == 0) { أرجع صواب; };
    طابق التخطيط.التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأجزاء) مثل غير_موقع)) {
            طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, الأجزاء[ف].الفهرس) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(العضو) -> {
                لو (!اجمع_أوراق_تجميع_واجهة(
                    الأنواع, الهدف, سجل_التخطيط, العضو,
                    الإزاحة + الأجزاء[ف].الإزاحة, الأوراق
                )) { أرجع خطأ; };
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأجزاء) مثل غير_موقع)) {
            طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, الأجزاء[ف].الفهرس) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(العضو) -> {
                لو (!اجمع_أوراق_تجميع_واجهة(
                    الأنواع, الهدف, سجل_التخطيط, العضو,
                    الإزاحة + الأجزاء[ف].الإزاحة, الأوراق
                )) { أرجع خطأ; };
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | تفاصيل_تخطيط.تعداد(_) -> { أرجع خطأ; }
    | _ -> { };
    لو (!شكل_سلمي_أوراق_واجهة(الأنواع, النوع)) { أرجع خطأ; };
    دع الورقة: ورقة_تجميع_واجهة = {
        الإزاحة: الإزاحة,
        الحجم: التخطيط.الحجم,
        عائم: نوع_عائم_أوراق_واجهة(الأنواع, النوع)
    };
    ألحق(*الأوراق, الورقة);
    أرجع صواب;
}

// True for a record or tuple (a C structure). Scalars and enums are not.
عام عرف تجميع_بنية_واجهة(الأنواع: &سجل_أنواع, التخطيط: &واصف_تخطيط): منطقي {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.صف(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.سجل(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// True for a tagged-union layout (SultanC enum, option, result).
عام عرف تجميع_موسوم_واجهة(التخطيط: &واصف_تخطيط): منطقي {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.تعداد(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Homogeneous floating aggregate (AAPCS64 HFA, ELFv2 homogeneous aggregate):
// every leaf is a float of one size, laid out without gaps from offset zero,
// and the leaf count does not exceed الحد. Returns the element size.
عام عرف حجم_عنصر_متجانس_عائم_واجهة(
    الأوراق: &متجه ورقة_تجميع_واجهة,
    حجم_الكل: غير_موقع,
    الحد: غير_موقع
): اختيار غير_موقع {
    دع العدد: غير_موقع = الطول(*الأوراق) مثل غير_موقع;
    لو (العدد == 0 || العدد > الحد) { أرجع اختيار.لا_شيء(); };
    دع حجم_العنصر: غير_موقع = (*الأوراق)[0].الحجم;
    لو (حجم_العنصر != 4 && حجم_العنصر != 8) { أرجع اختيار.لا_شيء(); };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (!(*الأوراق)[ف].عائم || (*الأوراق)[ف].الحجم != حجم_العنصر
            || (*الأوراق)[ف].الإزاحة != ف * حجم_العنصر) {
            أرجع اختيار.لا_شيء();
        };
        ف := ف + 1;
    }
    لو (حجم_الكل != العدد * حجم_العنصر) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(حجم_العنصر);
}

// Uniform register parts: العدد parts of حجم_الجزء bytes of one class from
// offset zero; the last integer part covers only the remaining bytes.
عام عرف أشكال_أجزاء_منتظمة_واجهة(
    حجم_الكل: غير_موقع,
    حجم_الجزء: غير_موقع,
    العدد: غير_موقع,
    الفئة: فئة_سجل_واجهة
): متجه شكل_جزء_واجهة {
    دع الأشكال: متغير متجه شكل_جزء_واجهة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع البداية: غير_موقع = ف * حجم_الجزء;
        دع الحجم: متغير غير_موقع = حجم_الجزء;
        لو (الفئة == فئة_سجل_واجهة.عدد_صحيح() && حجم_الكل > البداية
            && حجم_الكل - البداية < حجم_الجزء) {
            الحجم := حجم_الكل - البداية;
        };
        ألحق(الأشكال, شكل_جزء_واجهة_جديد(البداية, الحجم, الفئة));
        ف := ف + 1;
    }
    أرجع الأشكال;
}

// Eightbyte (or other word-size) parts classified from the leaves: a word is
// floating when every leaf overlapping it is a float, and then its shape is
// the float type covering it (4 bytes for one float, 8 for a double or two
// floats); otherwise it is an integer part. This is the SysV AMD64 rule
// (INTEGER dominates SSE within an eightbyte, §3.2.3) and matches SPARC64.
// Returns none when a word holds no leaf in the middle of the value.
عام عرف أشكال_كلمات_مصنفة_واجهة(
    الأوراق: &متجه ورقة_تجميع_واجهة,
    حجم_الكل: غير_موقع,
    حجم_الكلمة: غير_موقع
): اختيار متجه شكل_جزء_واجهة {
    دع الأشكال: متغير متجه شكل_جزء_واجهة = [];
    دع عدد_الكلمات: غير_موقع = (حجم_الكل + حجم_الكلمة - 1) / حجم_الكلمة;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < عدد_الكلمات) {
        دع البداية: غير_موقع = ك * حجم_الكلمة;
        دع النهاية: غير_موقع = البداية + حجم_الكلمة;
        دع فيها_ورقة: متغير منطقي = خطأ;
        دع كلها_عائمة: متغير منطقي = صواب;
        دع أقصى_نهاية: متغير غير_موقع = البداية;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(*الأوراق) مثل غير_موقع)) {
            دع الورقة: ورقة_تجميع_واجهة = (*الأوراق)[ف];
            دع نهاية_الورقة: غير_موقع = الورقة.الإزاحة + الورقة.الحجم;
            لو (الورقة.الإزاحة < النهاية && نهاية_الورقة > البداية) {
                فيها_ورقة := صواب;
                لو (!الورقة.عائم) { كلها_عائمة := خطأ; };
                لو (نهاية_الورقة > أقصى_نهاية) { أقصى_نهاية := نهاية_الورقة; };
            };
            ف := ف + 1;
        }
        لو (!فيها_ورقة) {
            // Trailing padding words carry nothing; an interior empty word
            // cannot be represented as a contiguous register sequence.
            لو (ك + 1 < عدد_الكلمات) { أرجع اختيار.لا_شيء(); };
        } وإلا لو (كلها_عائمة) {
            دع المستخدم: غير_موقع = أقصى_نهاية - البداية;
            دع حجم_العائم: متغير غير_موقع = 8;
            لو (المستخدم <= 4) { حجم_العائم := 4; };
            ألحق(الأشكال, شكل_جزء_واجهة_جديد(
                البداية, حجم_العائم, فئة_سجل_واجهة.عائم_متجه()
            ));
        } وإلا {
            دع الحجم: متغير غير_موقع = حجم_الكلمة;
            لو (حجم_الكل - البداية < حجم_الكلمة) { الحجم := حجم_الكل - البداية; };
            ألحق(الأشكال, شكل_جزء_واجهة_جديد(
                البداية, الحجم, فئة_سجل_واجهة.عدد_صحيح()
            ));
        };
        ك := ك + 1;
    }
    أرجع اختيار.بعض(الأشكال);
}

// Extension a C ABI applies to an integer scalar narrower than حد_البتات:
// signed integers sign-extend; unsigned integers, booleans and characters
// zero-extend. When إشاري_للعرض is nonzero, an unsigned integer of exactly
// that width sign-extends instead (RV64, LoongArch64 and MIPS64 keep 32-bit
// values sign-extended in 64-bit registers whatever their signedness).
عام عرف توسيع_عدد_ضيق_واجهة(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    حد_البتات: غير_موقع,
    إشاري_للعرض: غير_موقع
): توسيع_عدد_واجهة {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع توسيع_عدد_واجهة.بلا_توسيع(); }
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            دع البتات: غير_موقع = بتات_نوع_بدائي(البدائي);
            طابق صنف_النوع_البدائي(البدائي) مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                لو (البتات < حد_البتات) { أرجع توسيع_عدد_واجهة.توسيع_إشاري(); };
            }
            | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
                لو (إشاري_للعرض != 0 && البتات == إشاري_للعرض) {
                    أرجع توسيع_عدد_واجهة.توسيع_إشاري();
                };
                لو (البتات < حد_البتات) { أرجع توسيع_عدد_واجهة.توسيع_صفري(); };
            }
            | صنف_نوع_بدائي.منطقي -> { أرجع توسيع_عدد_واجهة.توسيع_صفري(); }
            | صنف_نوع_بدائي.حرف -> {
                لو (البتات < حد_البتات) { أرجع توسيع_عدد_واجهة.توسيع_صفري(); };
            }
            | _ -> { };
        }
        | _ -> { };
    };
    أرجع توسيع_عدد_واجهة.بلا_توسيع();
}
