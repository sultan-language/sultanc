استورد compiler.backend.abi.abi_model;
استورد compiler.backend.abi.aggregate_leaves;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.layout.layout_resolution;
استورد compiler.backend.target.target_model;

// Architecture-neutral vocabulary for the foreign (C) ABI classifiers of
// delegated targets (architectures/*/systems/*/abi_rules.sn). Each classifier
// decides how every parameter and result travels; this module only describes
// values from Type/Layout facts and assembles the canonical plan. Physical
// register assignment on delegated targets belongs to the LLVM code generator,
// so register references here are logical, in assignment order per class.

// What a classifier needs to know about one value.
عام نوع وصف_قيمة_خارجية = {
    فارغة: منطقي,
    الحجم: غير_موقع,
    المحاذاة: غير_موقع,
    // A record or tuple: a C structure.
    بنية: منطقي,
    // A floating scalar (f32/f64).
    عائم: منطقي,
    // Scalar leaves of a structure, in layout order (empty for scalars).
    الأوراق: متجه ورقة_تجميع_واجهة
};

// One classified value and the register shapes its plan entry carries.
عام نوع قيمة_مصنفة_واجهة = {
    التصنيف: تصنيف_قيمة_واجهة,
    الأشكال: متجه شكل_جزء_واجهة,
    // A structure copied onto the stack by value (LLVM byval).
    في_الذاكرة: منطقي
};

// Describes النوع, or rejects a type no C ABI can carry (tagged enums,
// options, results, deferred layouts, unsupported scalar sizes).
عام عرف صف_قيمة_خارجية(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة وصف_قيمة_خارجية, خطأ_واجهة {
    دع لا_أوراق: متجه ورقة_تجميع_واجهة = [];
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_واجهة.معرف_نوع_غير_صالح(النوع)); }
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            لو (البدائي == نوع_بدائي_مقنن.فراغ()) {
                دع الفراغ: وصف_قيمة_خارجية = {
                    فارغة: صواب, الحجم: 0, المحاذاة: 1, بنية: خطأ, عائم: خطأ,
                    الأوراق: لا_أوراق
                };
                أرجع نتيجة.نجح(الفراغ);
            };
        }
        | _ -> { };
    };
    دع التخطيط: واصف_تخطيط;
    طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مؤجل(السبب) -> { أرجع نتيجة.خطأ(خطأ_واجهة.تخطيط_نوع_مؤجل(النوع, السبب)); }
    | نتيجة_تخطيط.مرفوض(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واجهة.تخطيط_نوع_مرفوض(النوع, الخطأ)); }
    | نتيجة_تخطيط.مكتمل(القيمة) -> { التخطيط := القيمة; };
    لو (تجميع_موسوم_واجهة(&التخطيط)) { أرجع نتيجة.خطأ(خطأ_واجهة.نوع_غير_مدعوم(النوع)); };
    لو (تجميع_بنية_واجهة(الأنواع, &التخطيط)) {
        دع الأوراق: متغير متجه ورقة_تجميع_واجهة = [];
        لو (!اجمع_أوراق_تجميع_واجهة(الأنواع, الهدف, سجل_التخطيط, النوع, 0, &متغير الأوراق)) {
            أرجع نتيجة.خطأ(خطأ_واجهة.نوع_غير_مدعوم(النوع));
        };
        دع البنية: وصف_قيمة_خارجية = {
            فارغة: التخطيط.الحجم == 0, الحجم: التخطيط.الحجم, المحاذاة: التخطيط.المحاذاة,
            بنية: صواب, عائم: خطأ, الأوراق: الأوراق
        };
        أرجع نتيجة.نجح(البنية);
    };
    لو (التخطيط.الحجم != 1 && التخطيط.الحجم != 2 && التخطيط.الحجم != 4 && التخطيط.الحجم != 8) {
        أرجع نتيجة.خطأ(خطأ_واجهة.حجم_نوع_غير_مدعوم(النوع, التخطيط.الحجم));
    };
    دع السلمي: وصف_قيمة_خارجية = {
        فارغة: خطأ, الحجم: التخطيط.الحجم, المحاذاة: التخطيط.المحاذاة, بنية: خطأ,
        عائم: نوع_عائم_أوراق_واجهة(الأنواع, النوع), الأوراق: لا_أوراق
    };
    أرجع نتيجة.نجح(السلمي);
}

عرف قيمة_مصنفة_بلا_أشكال(التصنيف: تصنيف_قيمة_واجهة, في_الذاكرة: منطقي): قيمة_مصنفة_واجهة {
    دع لا_أشكال: متجه شكل_جزء_واجهة = [];
    دع القيمة: قيمة_مصنفة_واجهة = {
        التصنيف: التصنيف, الأشكال: لا_أشكال, في_الذاكرة: في_الذاكرة
    };
    أرجع القيمة;
}

عام عرف قيمة_متجاهلة_خارجية(): قيمة_مصنفة_واجهة {
    دع التصنيف: تصنيف_قيمة_واجهة = تصنيف_قيمة_واجهة_أساسي(
        طريقة_تمرير_واجهة.متجاهل(), 0, 1, 0, اختيار.لا_شيء(), خطأ
    );
    أرجع قيمة_مصنفة_بلا_أشكال(التصنيف, خطأ);
}

// A scalar in one register of its class, extended as the ABI requires.
عام عرف قيمة_سلمية_خارجية(
    الوصف: &وصف_قيمة_خارجية,
    التوسيع: توسيع_عدد_واجهة
): قيمة_مصنفة_واجهة {
    دع الفئة: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
    لو ((*الوصف).عائم) { الفئة := فئة_سجل_واجهة.عائم_متجه(); };
    دع التصنيف: متغير تصنيف_قيمة_واجهة = تصنيف_قيمة_واجهة_أساسي(
        طريقة_تمرير_واجهة.مباشر(), (*الوصف).الحجم, (*الوصف).المحاذاة, 1,
        اختيار.بعض(الفئة), خطأ
    );
    التصنيف.التوسيع := التوسيع;
    أرجع قيمة_مصنفة_بلا_أشكال(التصنيف, خطأ);
}

// A structure passed by address: for arguments, of a copy owned by the
// caller for this call; for results, of caller memory the callee fills.
عام عرف قيمة_غير_مباشرة_خارجية(الوصف: &وصف_قيمة_خارجية): قيمة_مصنفة_واجهة {
    دع التصنيف: متغير تصنيف_قيمة_واجهة = تصنيف_قيمة_واجهة_أساسي(
        طريقة_تمرير_واجهة.غير_مباشر(), (*الوصف).الحجم, (*الوصف).المحاذاة, 1,
        اختيار.بعض(فئة_سجل_واجهة.عدد_صحيح()), صواب
    );
    التصنيف.نسخة_للمستدعى := صواب;
    أرجع قيمة_مصنفة_بلا_أشكال(التصنيف, خطأ);
}

// A structure copied by value into the outgoing argument area.
عام عرف قيمة_في_الذاكرة_خارجية(الوصف: &وصف_قيمة_خارجية): قيمة_مصنفة_واجهة {
    دع التصنيف: تصنيف_قيمة_واجهة = تصنيف_قيمة_واجهة_أساسي(
        طريقة_تمرير_واجهة.مباشر(), (*الوصف).الحجم, (*الوصف).المحاذاة, 1,
        اختيار.بعض(فئة_سجل_واجهة.عدد_صحيح()), صواب
    );
    أرجع قيمة_مصنفة_بلا_أشكال(التصنيف, صواب);
}

// A structure in registers, one per shape.
عام عرف قيمة_أجزاء_خارجية(
    الوصف: &وصف_قيمة_خارجية,
    الأشكال: متجه شكل_جزء_واجهة,
    كتلة_متصلة: منطقي
): قيمة_مصنفة_واجهة {
    دع العدد: غير_موقع = الطول(الأشكال) مثل غير_موقع;
    دع الطريقة: متغير طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.مباشر();
    لو (العدد > 1) { الطريقة := طريقة_تمرير_واجهة.مجزأ(); };
    دع الفئة: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
    لو (العدد > 0) { الفئة := الأشكال[0].الفئة; };
    دع التصنيف: متغير تصنيف_قيمة_واجهة = تصنيف_قيمة_واجهة_أساسي(
        الطريقة, (*الوصف).الحجم, (*الوصف).المحاذاة, العدد, اختيار.بعض(الفئة), صواب
    );
    التصنيف.كتلة_متصلة := كتلة_متصلة;
    دع القيمة: قيمة_مصنفة_واجهة = {
        التصنيف: التصنيف, الأشكال: الأشكال, في_الذاكرة: خطأ
    };
    أرجع القيمة;
}

// One integer register part holding the whole structure (a structure of a
// size the ABI coerces to an integer register).
عام عرف قيمة_صحيحة_واحدة_خارجية(الوصف: &وصف_قيمة_خارجية): قيمة_مصنفة_واجهة {
    دع الأشكال: متغير متجه شكل_جزء_واجهة = [];
    ألحق(الأشكال, شكل_جزء_واجهة_جديد(0, (*الوصف).الحجم, فئة_سجل_واجهة.عدد_صحيح()));
    أرجع قيمة_أجزاء_خارجية(الوصف, الأشكال, خطأ);
}

// Logical register references in assignment order per class.
نوع عدادات_خطة_خارجية = {
    الصحيحة: غير_موقع,
    العائمة: غير_موقع,
    المكدس: غير_موقع
};

عرف مرجع_خارجي(الفئة: فئة_سجل_واجهة, الفهرس: غير_موقع, الدور: دور_سجل_واجهة): مرجع_سجل_واجهة {
    دع المرجع: مرجع_سجل_واجهة = {
        الفئة: الفئة, الفهرس: الفهرس, الدور: الدور,
        الحفظ: حفظ_سجل_واجهة.متطاير_عبر_النداء()
    };
    أرجع المرجع;
}

عرف محاذاة_لأعلى_خارجية(القيمة: غير_موقع, المحاذاة: غير_موقع): غير_موقع {
    لو (المحاذاة <= 1) { أرجع القيمة; };
    أرجع ((القيمة + المحاذاة - 1) / المحاذاة) * المحاذاة;
}

عرف موقع_قيمة_خارجية(
    القيمة: &قيمة_مصنفة_واجهة,
    العدادات: &متغير عدادات_خطة_خارجية,
    الدور: دور_سجل_واجهة,
    حجم_الكلمة: غير_موقع
): موقع_تمرير_واجهة {
    دع التصنيف: تصنيف_قيمة_واجهة = (*القيمة).التصنيف;
    طابق التصنيف.الطريقة مع
    | طريقة_تمرير_واجهة.متجاهل -> { أرجع موقع_تمرير_واجهة.متجاهل(); }
    | طريقة_تمرير_واجهة.غير_مباشر -> {
        دع الفئة: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
        دع الدور_الفعلي: متغير دور_سجل_واجهة = الدور;
        لو (الدور == دور_سجل_واجهة.ناتج()) {
            الفئة := فئة_سجل_واجهة.نتيجة_غير_مباشرة();
            الدور_الفعلي := دور_سجل_واجهة.عنوان_نتيجة_غير_مباشرة();
        };
        دع الفهرس: غير_موقع = (*العدادات).الصحيحة;
        لو (الدور == دور_سجل_واجهة.معامل()) { (*العدادات).الصحيحة := (*العدادات).الصحيحة + 1; };
        أرجع موقع_تمرير_واجهة.غير_مباشر(موضع_جزء_واجهة.سجل(
            مرجع_خارجي(الفئة, الفهرس, الدور_الفعلي)
        ));
    }
    | _ -> { };
    لو ((*القيمة).في_الذاكرة) {
        دع المحاذاة: متغير غير_موقع = التصنيف.المحاذاة;
        لو (المحاذاة < حجم_الكلمة) { المحاذاة := حجم_الكلمة; };
        دع الإزاحة: غير_موقع = محاذاة_لأعلى_خارجية((*العدادات).المكدس, المحاذاة);
        (*العدادات).المكدس := الإزاحة + محاذاة_لأعلى_خارجية(التصنيف.الحجم, حجم_الكلمة);
        دع موضع_المكدس: موضع_مكدس_واجهة = {
            الإزاحة: الإزاحة, الحجم: التصنيف.الحجم, المحاذاة: المحاذاة
        };
        أرجع موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.مكدس(موضع_المكدس));
    };
    دع المواضع: متغير متجه موضع_جزء_واجهة = [];
    دع العدد: غير_موقع = التصنيف.عدد_الأجزاء;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع الفئة: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
        لو ((الطول((*القيمة).الأشكال) مثل غير_موقع) == العدد) {
            الفئة := (*القيمة).الأشكال[ف].الفئة;
        } وإلا {
            طابق التصنيف.فئة_السجل مع
            | اختيار.بعض(ق) -> { الفئة := ق; }
            | اختيار.لا_شيء -> { };
        };
        دع الفهرس: متغير غير_موقع = 0;
        لو (الفئة == فئة_سجل_واجهة.عائم_متجه()) {
            الفهرس := (*العدادات).العائمة;
            (*العدادات).العائمة := (*العدادات).العائمة + 1;
        } وإلا {
            الفهرس := (*العدادات).الصحيحة;
            (*العدادات).الصحيحة := (*العدادات).الصحيحة + 1;
        };
        ألحق(المواضع, موضع_جزء_واجهة.سجل(مرجع_خارجي(الفئة, الفهرس, الدور)));
        ف := ف + 1;
    }
    لو (العدد == 1) { أرجع موقع_تمرير_واجهة.مباشر(المواضع[0]); };
    أرجع موقع_تمرير_واجهة.مجزأ(المواضع);
}

// Assembles the canonical plan from classified values. A result passed
// indirectly takes the first logical integer argument slot.
عام عرف ابن_خطة_واجهة_خارجية(
    المعاملات: &متجه معرف_نوع,
    القيم: &متجه قيمة_مصنفة_واجهة,
    الناتج: معرف_نوع,
    قيمة_الناتج: &قيمة_مصنفة_واجهة,
    حجم_الكلمة: غير_موقع,
    محاذاة_المكدس: غير_موقع
): خطة_دالة_واجهة {
    دع العدادات: متغير عدادات_خطة_خارجية = { الصحيحة: 0, العائمة: 0, المكدس: 0 };
    دع عدادات_الناتج: متغير عدادات_خطة_خارجية = { الصحيحة: 0, العائمة: 0, المكدس: 0 };
    لو ((*قيمة_الناتج).التصنيف.الطريقة == طريقة_تمرير_واجهة.غير_مباشر()) {
        العدادات.الصحيحة := 1;
    };
    دع موقع_الناتج: موقع_تمرير_واجهة = موقع_قيمة_خارجية(
        قيمة_الناتج, &متغير عدادات_الناتج, دور_سجل_واجهة.ناتج(), حجم_الكلمة
    );
    دع الخطط: متغير متجه خطة_معامل_واجهة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيم) مثل غير_موقع)) {
        دع القيمة: &قيمة_مصنفة_واجهة = &(*القيم)[ف];
        دع الموقع: موقع_تمرير_واجهة = موقع_قيمة_خارجية(
            القيمة, &متغير العدادات, دور_سجل_واجهة.معامل(), حجم_الكلمة
        );
        دع مرجع_الأشكال: &متجه شكل_جزء_واجهة = &(*القيمة).الأشكال;
        دع الأشكال: متجه شكل_جزء_واجهة = *مرجع_الأشكال;
        دع الخطة: خطة_معامل_واجهة = {
            الفهرس: ف,
            النوع: (*المعاملات)[ف],
            التصنيف: (*القيمة).التصنيف,
            الموقع: الموقع,
            أشكال_الأجزاء: الأشكال
        };
        ألحق(الخطط, الخطة);
        ف := ف + 1;
    }
    دع مرجع_أشكال_الناتج: &متجه شكل_جزء_واجهة = &(*قيمة_الناتج).الأشكال;
    دع أشكال_الناتج: متجه شكل_جزء_واجهة = *مرجع_أشكال_الناتج;
    دع خطة_الناتج: خطة_ناتج_واجهة = {
        النوع: الناتج,
        التصنيف: (*قيمة_الناتج).التصنيف,
        الموقع: موقع_الناتج,
        أشكال_الأجزاء: أشكال_الناتج
    };
    دع الخطة: خطة_دالة_واجهة = {
        المعاملات: الخطط,
        الناتج: خطة_الناتج,
        حجم_مكدس_النداء: محاذاة_لأعلى_خارجية(العدادات.المكدس, محاذاة_المكدس),
        محاذاة_مكدس_النداء: محاذاة_المكدس
    };
    أرجع الخطة;
}
