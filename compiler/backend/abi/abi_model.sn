استورد compiler.frontend.types.type_identity;
استورد compiler.backend.layout.layout_model;

// هذا المجال يملك مفردات الواجهة الثنائية المجردة وخطة النداء فقط.
// لا يملك اختيار نظام تشغيل ولا سياسة معمارية ولا سجل تنفيذات خلفية.
عام نوع طريقة_تمرير_واجهة =
    | متجاهل
    | مباشر
    | مجزأ
    | غير_مباشر
;

عام نوع فئة_سجل_واجهة =
    | عدد_صحيح
    | عائم_متجه
    | نتيجة_غير_مباشرة
;

عام نوع دور_سجل_واجهة =
    | معامل
    | ناتج
    | عنوان_نتيجة_غير_مباشرة
;

عام نوع حفظ_سجل_واجهة =
    | متطاير_عبر_النداء
    | محفوظ_عبر_النداء
;

// هذا مرجع منطقي داخل خطة الواجهة الثنائية، وليس رقما لسجل آلة فعلي.
عام نوع مرجع_سجل_واجهة = {
    الفئة: فئة_سجل_واجهة,
    الفهرس: طبيعي,
    الدور: دور_سجل_واجهة,
    الحفظ: حفظ_سجل_واجهة
};

عام نوع موضع_مكدس_واجهة = {
    الإزاحة: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي
};

عام نوع موضع_جزء_واجهة =
    | سجل بنوع مرجع_سجل_واجهة
    | مكدس بنوع موضع_مكدس_واجهة
;

// نسخ مواضع ABI يظل هنا لأن هذه الوحدة تملك تمثيل الموضع المجرد.
// المستهلكون لا ينقلون حقلا متجها من قيمة ABI مستعارة ثم يتركونها جزئية.
عام عرف انسخ_موضع_جزء_واجهة(الموضع: &موضع_جزء_واجهة): موضع_جزء_واجهة {
    دع النسخة: موضع_جزء_واجهة = *الموضع;
    طابق النسخة مع
    | موضع_جزء_واجهة.سجل(المرجع) -> {
        أرجع موضع_جزء_واجهة.سجل(المرجع);
    }
    | موضع_جزء_واجهة.مكدس(موضع_المكدس) -> {
        أرجع موضع_جزء_واجهة.مكدس(موضع_المكدس);
    };
}

عام عرف انسخ_مواضع_أجزاء_واجهة(
    المواضع: &متجه موضع_جزء_واجهة
): متجه موضع_جزء_واجهة {
    دع الأصل: متجه موضع_جزء_واجهة = *المواضع;
    دع الناتج: متغير متجه موضع_جزء_واجهة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصل) مثل طبيعي)) {
        دع مرجع_الموضع: &موضع_جزء_واجهة = &الأصل[ف];
        ألحق(الناتج, انسخ_موضع_جزء_واجهة(مرجع_الموضع));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام نوع موقع_تمرير_واجهة =
    | متجاهل
    | مباشر بنوع موضع_جزء_واجهة
    | مجزأ بنوع متجه موضع_جزء_واجهة
    | غير_مباشر بنوع موضع_جزء_واجهة
;

// Physical shape of one register part of a value passed or returned in
// registers: the bytes [الإزاحة, الإزاحة + الحجم) of the value travel in one
// register of class الفئة. Floating parts are 4 or 8 bytes; integer parts
// are 1 to 16 bytes (16 only for a part the ABI places in an aligned register
// pair). The shapes live in the plan entry (خطة_معامل_واجهة/خطة_ناتج_واجهة),
// which already owns vectors; a classifier that uses only 8-byte integer
// chunks leaves them empty and consumers derive those chunks from الحجم.
عام نوع شكل_جزء_واجهة = {
    الإزاحة: طبيعي,
    الحجم: طبيعي,
    الفئة: فئة_سجل_واجهة
};

// Extension of an integer narrower than its argument register, required of
// the caller (arguments) or the callee (results) by the platform ABI.
عام نوع توسيع_عدد_واجهة =
    | بلا_توسيع
    | توسيع_صفري
    | توسيع_إشاري
;

// True when a direct or split location lives in registers (not the stack).
عام عرف موقع_في_سجلات_واجهة(الموقع: &موقع_تمرير_واجهة): منطقي {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الموضع) -> {
        طابق الموضع مع
        | موضع_جزء_واجهة.سجل(_) -> { أرجع صواب; }
        | موضع_جزء_واجهة.مكدس(_) -> { أرجع خطأ; };
    }
    | موقع_تمرير_واجهة.مجزأ(المواضع) -> {
        إذا ((الطول(المواضع) مثل طبيعي) == 0) { أرجع خطأ; };
        طابق المواضع[0] مع
        | موضع_جزء_واجهة.سجل(_) -> { أرجع صواب; }
        | موضع_جزء_واجهة.مكدس(_) -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عام نوع تصنيف_قيمة_واجهة = {
    الطريقة: طريقة_تمرير_واجهة,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    عدد_الأجزاء: طبيعي,
    فئة_السجل: اختياري فئة_سجل_واجهة,
    تجميعي: منطقي,
    التوسيع: توسيع_عدد_واجهة,
    // The parts form one consecutive register block that the ABI never
    // splits between registers and the stack (AAPCS64 composites and HFAs,
    // ELFv2 aggregates): the code generator passes them as one array value.
    كتلة_متصلة: منطقي,
    // For an indirect argument: whether the callee may write the storage it
    // points to. True at the foreign boundary (C ABIs: the callee owns the
    // pointed-to object), so the caller always passes a private copy made
    // for the call. False for SultanC's internal convention: the callee only
    // reads its parameter there, and the caller may point at the argument's
    // own storage instead of copying it when that storage cannot change
    // during the call (حجج_بلا_نسخ_مسير, compiler/msir/msir_copies.sn), and
    // passes a copy made for the call otherwise.
    نسخة_للمستدعى: منطقي,
    // The register parts share doubleword argument slots: a 32-bit part
    // occupies the half of its slot its offset selects (SPARC V9 structures
    // with single-precision float members; LLVM `inreg`). Elsewhere every
    // part occupies a whole register.
    أجزاء_مرصوصة: منطقي
};

// A classification with no extension and no special lowering.
عام عرف تصنيف_قيمة_واجهة_أساسي(
    الطريقة: طريقة_تمرير_واجهة,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    عدد_الأجزاء: طبيعي,
    فئة_السجل: اختياري فئة_سجل_واجهة,
    تجميعي: منطقي
): تصنيف_قيمة_واجهة {
    دع التصنيف: تصنيف_قيمة_واجهة = {
        الطريقة: الطريقة,
        الحجم: الحجم,
        المحاذاة: المحاذاة,
        عدد_الأجزاء: عدد_الأجزاء,
        فئة_السجل: فئة_السجل,
        تجميعي: تجميعي,
        التوسيع: توسيع_عدد_واجهة.بلا_توسيع(),
        كتلة_متصلة: خطأ,
        نسخة_للمستدعى: خطأ,
        أجزاء_مرصوصة: خطأ
    };
    أرجع التصنيف;
}

عام عرف شكل_جزء_واجهة_جديد(
    الإزاحة: طبيعي,
    الحجم: طبيعي,
    الفئة: فئة_سجل_واجهة
): شكل_جزء_واجهة {
    دع الشكل: شكل_جزء_واجهة = { الإزاحة: الإزاحة, الحجم: الحجم, الفئة: الفئة };
    أرجع الشكل;
}

عام نوع خطة_معامل_واجهة = {
    الفهرس: طبيعي,
    النوع: معرف_نوع,
    التصنيف: تصنيف_قيمة_واجهة,
    الموقع: موقع_تمرير_واجهة,
    أشكال_الأجزاء: متجه شكل_جزء_واجهة
};

عام نوع خطة_ناتج_واجهة = {
    النوع: معرف_نوع,
    التصنيف: تصنيف_قيمة_واجهة,
    الموقع: موقع_تمرير_واجهة,
    أشكال_الأجزاء: متجه شكل_جزء_واجهة
};

// The calling convention of a call boundary, decided per call target in one
// place (اتفاقية_هدف_نداء_مسير and اتفاقية_دالة_مسير_للواجهة in
// compiler/backend/target/selection_query_context.sn) for every backend:
// - داخلية: a call between SultanC functions, direct or through a function
//   value. The target's register convention, with SultanC's own rule for
//   aggregate arguments: one larger than the target's hidden-reference
//   threshold (عتبة_مرجع_خفي_للهدف) is passed as the address of storage the
//   caller keeps unchanged for the call (a hidden reference); the callee
//   reads it in place and never writes it.
// - منصة: the target's registered register convention unchanged (runtime
//   primitives, kernel calls, and functions compiled from imported C, whose
//   calls keep the C placement of their records).
// - خارجية: the platform C ABI of an external function (foreign boundary).
عام نوع اتفاقية_نداء_واجهة =
    | داخلية
    | منصة
    | خارجية
;

عام نوع خطة_دالة_واجهة = {
    المعاملات: متجه خطة_معامل_واجهة,
    الناتج: خطة_ناتج_واجهة,
    حجم_مكدس_النداء: طبيعي,
    محاذاة_مكدس_النداء: طبيعي
};

// أخطاء توفر قدرة ABI أو اختيار الهدف ليست أخطاء ABI مشتركة؛ يملكها حل ABI للهدف.
عام نوع خطأ_واجهة =
    | معرف_نوع_غير_صالح بنوع معرف_نوع
    | تخطيط_نوع_مؤجل بنوع (معرف_نوع, سبب_تأجيل_تخطيط)
    | تخطيط_نوع_مرفوض بنوع (معرف_نوع, خطأ_تخطيط)
    | نوع_غير_مدعوم بنوع معرف_نوع
    | حجم_نوع_غير_مدعوم بنوع (معرف_نوع, طبيعي)
;

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_شكل_جزء_واجهة(القيمة: &متجه شكل_جزء_واجهة): متجه شكل_جزء_واجهة {
    دع الناتج: متغير متجه شكل_جزء_واجهة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_خطة_ناتج_واجهة(القيمة: &خطة_ناتج_واجهة): خطة_ناتج_واجهة {
    دع الناتج: خطة_ناتج_واجهة = {
        النوع: (*القيمة).النوع,
        التصنيف: (*القيمة).التصنيف,
        الموقع: انسخ_مملوكا_موقع_تمرير_واجهة(&(*القيمة).الموقع),
        أشكال_الأجزاء: انسخ_مملوكا_متجه_شكل_جزء_واجهة(&(*القيمة).أشكال_الأجزاء)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_موقع_تمرير_واجهة(القيمة: &موقع_تمرير_واجهة): موقع_تمرير_واجهة {
    طابق *القيمة مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع موقع_تمرير_واجهة.متجاهل(); }
    | موقع_تمرير_واجهة.مباشر(ح0) -> { أرجع موقع_تمرير_واجهة.مباشر(ح0); }
    | موقع_تمرير_واجهة.مجزأ(ح0) -> { أرجع موقع_تمرير_واجهة.مجزأ(انسخ_مملوكا_متجه_موضع_جزء_واجهة(&ح0)); }
    | موقع_تمرير_واجهة.غير_مباشر(ح0) -> { أرجع موقع_تمرير_واجهة.غير_مباشر(ح0); };
}

عام عرف انسخ_مملوكا_متجه_موضع_جزء_واجهة(القيمة: &متجه موضع_جزء_واجهة): متجه موضع_جزء_واجهة {
    دع الناتج: متغير متجه موضع_جزء_واجهة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
