// ABI سلطان المحمولة هي عقد IR مقنن للأهداف التي يفوض Target خفضها الآلي للمزود.
// القيم السلمية تمر مباشرة، والتجميعات تمر بعنوان ثابت الدلالة. لا تصف سجلات ISA فعلية.

عرف نوع_فراغ_واجهة_محمولة(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع البدائي == نوع_بدائي_مقنن.فراغ();
        }
        | _ -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف تفاصيل_تجميعية_واجهة_محمولة(التفاصيل: &تفاصيل_تخطيط): منطقي {
    طابق *التفاصيل مع
    | تفاصيل_تخطيط.صف(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.سجل(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.تعداد(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف فئة_سجل_واجهة_محمولة(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): فئة_سجل_واجهة {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            لو (صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري()) {
                أرجع فئة_سجل_واجهة.عائم_متجه();
            };
        }
        | _ -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع فئة_سجل_واجهة.عدد_صحيح();
}

عرف تصنيف_واجهة_محمولة_متجاهل(): تصنيف_قيمة_واجهة {
    دع الناتج: تصنيف_قيمة_واجهة = {
        الطريقة: طريقة_تمرير_واجهة.متجاهل(),
        الحجم: 0,
        المحاذاة: 1,
        عدد_الأجزاء: 0,
        فئة_السجل: اختيار.لا_شيء(),
        تجميعي: خطأ
    };
    أرجع الناتج;
}

عرف صنف_قيمة_واجهة_محمولة(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة تصنيف_قيمة_واجهة, خطأ_واجهة {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_واجهة.معرف_نوع_غير_صالح(النوع)); }
    | اختيار.بعض(_) -> { };

    لو (نوع_فراغ_واجهة_محمولة(الأنواع, النوع)) {
        أرجع نتيجة.نجح(تصنيف_واجهة_محمولة_متجاهل());
    };

    طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مؤجل(السبب) -> {
        أرجع نتيجة.خطأ(خطأ_واجهة.تخطيط_نوع_مؤجل(النوع, السبب));
    }
    | نتيجة_تخطيط.مرفوض(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_واجهة.تخطيط_نوع_مرفوض(النوع, الخطأ));
    }
    | نتيجة_تخطيط.مكتمل(التخطيط) -> {
        لو (التخطيط.الحجم == 0) {
            أرجع نتيجة.نجح(تصنيف_واجهة_محمولة_متجاهل());
        };
        دع تجميعي: منطقي = تفاصيل_تجميعية_واجهة_محمولة(&التخطيط.التفاصيل);
        دع الطريقة: متغير طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.مباشر();
        لو (تجميعي) { الطريقة := طريقة_تمرير_واجهة.غير_مباشر(); };
        دع الفئة: فئة_سجل_واجهة = فئة_سجل_واجهة_محمولة(الأنواع, النوع);
        دع الناتج: تصنيف_قيمة_واجهة = {
            الطريقة: الطريقة,
            الحجم: التخطيط.الحجم,
            المحاذاة: التخطيط.المحاذاة,
            عدد_الأجزاء: 1,
            فئة_السجل: اختيار.بعض(الفئة),
            تجميعي: تجميعي
        };
        أرجع نتيجة.نجح(الناتج);
    };
}

عرف مرجع_منطقي_واجهة_محمولة(
    الفئة: فئة_سجل_واجهة,
    الفهرس: غير_موقع,
    الدور: دور_سجل_واجهة
): مرجع_سجل_واجهة {
    دع المرجع: مرجع_سجل_واجهة = {
        الفئة: الفئة,
        الفهرس: الفهرس,
        الدور: الدور,
        الحفظ: حفظ_سجل_واجهة.متطاير_عبر_النداء()
    };
    أرجع المرجع;
}

عام عرف صنف_واجهة_سلطان_محمولة_دالة(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع الخطط: متغير متجه خطة_معامل_واجهة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المعاملات) مثل غير_موقع)) {
        دع النوع: معرف_نوع = (*المعاملات)[ف];
        دع التصنيف: تصنيف_قيمة_واجهة;
        طابق صنف_قيمة_واجهة_محمولة(الأنواع, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { التصنيف := القيمة; };
        دع الموقع: موقع_تمرير_واجهة;
        لو (التصنيف.الطريقة == طريقة_تمرير_واجهة.متجاهل()) {
            الموقع := موقع_تمرير_واجهة.متجاهل();
        } وإلا {
            دع الفئة: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
            طابق التصنيف.فئة_السجل مع
            | اختيار.بعض(قيمة) -> { الفئة := قيمة; }
            | اختيار.لا_شيء -> { };
            دع المرجع: مرجع_سجل_واجهة = مرجع_منطقي_واجهة_محمولة(
                الفئة, ف, دور_سجل_واجهة.معامل()
            );
            دع الموضع: موضع_جزء_واجهة = موضع_جزء_واجهة.سجل(المرجع);
            لو (التصنيف.الطريقة == طريقة_تمرير_واجهة.غير_مباشر()) {
                الموقع := موقع_تمرير_واجهة.غير_مباشر(الموضع);
            } وإلا {
                الموقع := موقع_تمرير_واجهة.مباشر(الموضع);
            };
        };
        دع خطة_المعامل: خطة_معامل_واجهة = {
            الفهرس: ف,
            النوع: النوع,
            التصنيف: التصنيف,
            الموقع: الموقع
        };
        ألحق(الخطط, خطة_المعامل);
        ف := ف + 1;
    }

    دع تصنيف_الناتج: تصنيف_قيمة_واجهة;
    طابق صنف_قيمة_واجهة_محمولة(الأنواع, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { تصنيف_الناتج := القيمة; };

    دع موقع_الناتج: موقع_تمرير_واجهة;
    لو (تصنيف_الناتج.الطريقة == طريقة_تمرير_واجهة.متجاهل()) {
        موقع_الناتج := موقع_تمرير_واجهة.متجاهل();
    } وإلا {
        دع الفئة: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
        طابق تصنيف_الناتج.فئة_السجل مع
        | اختيار.بعض(قيمة) -> { الفئة := قيمة; }
        | اختيار.لا_شيء -> { };
        دع الدور: متغير دور_سجل_واجهة = دور_سجل_واجهة.ناتج();
        لو (تصنيف_الناتج.الطريقة == طريقة_تمرير_واجهة.غير_مباشر()) {
            الدور := دور_سجل_واجهة.عنوان_نتيجة_غير_مباشرة();
        };
        دع المرجع: مرجع_سجل_واجهة = مرجع_منطقي_واجهة_محمولة(الفئة, 0, الدور);
        دع الموضع: موضع_جزء_واجهة = موضع_جزء_واجهة.سجل(المرجع);
        لو (تصنيف_الناتج.الطريقة == طريقة_تمرير_واجهة.غير_مباشر()) {
            موقع_الناتج := موقع_تمرير_واجهة.غير_مباشر(الموضع);
        } وإلا {
            موقع_الناتج := موقع_تمرير_واجهة.مباشر(الموضع);
        };
    };

    دع خطة_الناتج: خطة_ناتج_واجهة = {
        النوع: الناتج,
        التصنيف: تصنيف_الناتج,
        الموقع: موقع_الناتج
    };
    دع محاذاة_المكدس: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
    دع الخطة: خطة_دالة_واجهة = {
        المعاملات: الخطط,
        الناتج: خطة_الناتج,
        حجم_مكدس_النداء: 0,
        محاذاة_مكدس_النداء: محاذاة_المكدس
    };
    أرجع نتيجة.نجح(الخطة);
}
