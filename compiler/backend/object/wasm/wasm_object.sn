// WebAssembly relocatable object writer for the native wasm32 path: the
// format wasm-ld consumes, as specified by the WebAssembly tool conventions
// (Linking.md) and produced by LLVM for the same target. One module holds
// the type, import, function, code and data sections, the DWARF `.debug_*`
// custom sections, then the custom `linking` (symbol table, segment info,
// init functions), `reloc.CODE`, `reloc.DATA`, one `reloc..debug_*` per
// relocated debug section and `target_features`. Every function, data
// object, the shadow-stack pointer, the indirect function table,
// __heap_base and every debug section are symbols; the linker assigns all
// final indices and addresses.
//
// Position-independent objects (موضع_مستقل, for shared modules,
// DynamicLinking.md) also import env.__memory_base and env.__table_base and
// one mutable `GOT.mem` global per data symbol reached through the GOT, and
// carry R_WASM_MEMORY_ADDR_REL_SLEB, R_WASM_TABLE_INDEX_REL_SLEB and
// R_WASM_GLOBAL_INDEX_LEB (GOT) code relocations instead of absolute
// addresses and table indices, as LLVM writes -fPIC objects.
//
// DWARF on wasm (WebAssembly DWARF convention, as LLVM emits it): a code
// address is a byte offset in the CODE section payload; a data address is
// a linear-memory address. The shared DWARF producer works in one
// text-relative coordinate space, whose origin here is the first function
// body; every text address field becomes an R_WASM_FUNCTION_OFFSET_I32
// against the function whose body contains it (addend relative to the body
// start, after the size LEB), every data address an R_WASM_MEMORY_ADDR_I32
// against the containing data symbol, and every cross-section offset an
// R_WASM_SECTION_OFFSET_I32 against the target section's symbol. Frame
// information (.debug_frame) is not produced: wasm has no machine stack for
// it to describe. Previously the native wasm32 path emitted no DWARF.

عام نوع دالة_مستوردة_ويب_أسمبلي = {
    المعرف: معرف_دالة_خارجية_منتقاة,
    الوحدة: متجه ط8,
    الاسم: متجه ط8,
    التوقيع: طبيعي,
    // A host import named by the target (WASI) carries its import name
    // explicitly; otherwise the symbol name is the import field name.
    اسم_صريح: منطقي
};

عام نوع وحدة_ويب_أسمبلي_للكتابة = {
    التواقيع: سجل_تواقيع_ويب_أسمبلي,
    المستوردة: متجه دالة_مستوردة_ويب_أسمبلي,
    الدوال: متجه دالة_ويب_أسمبلي_مشفرة,
    المرفقات: مرفقات_كائن_مشفرة,
    // The language entry exported under the process-start name when the
    // object has no separate `_start` wrapper.
    الدخول_المصدر: اختياري معرف_دالة_منتقاة,
    // The functions are position-independent code for a shared module
    // (encoded_code.sn قاعدة_موضعية): the object then imports
    // env.__memory_base and env.__table_base and one GOT.mem global per data
    // symbol another module may define, as LLVM writes -fPIC objects.
    موضع_مستقل: منطقي
};

عام نوع خطأ_كائن_ويب_أسمبلي =
    | رمز_غير_محلول بنوع مرجع_رمز_كائن
    | إضافة_غير_صالحة بنوع مرجع_رمز_كائن
    | إزاحة_بيانات_غير_صالحة بنوع معرف_عام_مسير
    | توقيع_غير_صالح بنوع طبيعي
    // A DWARF address or offset field the wasm relocations cannot express
    // (not 4 bytes wide, or outside every function body / data segment).
    | إزاحة_تصحيح_غير_ممثلة
    // A position-independent address no base or GOT entry reaches.
    | عنوان_موضعي_غير_ممثل
;

// ------------------------------------------------------------- encoding --

عرف ألحق_قسم_ويب_أسمبلي(الملف: &متغير متجه ط8, الرمز: طبيعي, المحتوى: &متجه ط8): فراغ {
    ألحق_بايت_ويب_أسمبلي(الملف, الرمز);
    ألحق_ليب_ويب_أسمبلي(الملف, الطول(*المحتوى) مثل طبيعي);
    ألحق_بايتات_ويب_أسمبلي(الملف, المحتوى);
}

عرف ألحق_قسم_مخصص_ويب_أسمبلي(الملف: &متغير متجه ط8, الاسم: &متجه ط8, المحتوى: &متجه ط8): فراغ {
    دع الحمولة: متغير متجه ط8 = [];
    ألحق_اسم_ويب_أسمبلي(&متغير الحمولة, الاسم);
    ألحق_بايتات_ويب_أسمبلي(&متغير الحمولة, المحتوى);
    ألحق_قسم_ويب_أسمبلي(الملف, 0, &الحمولة);
}

عرف ألحق_قسم_فرعي_ويب_أسمبلي(الملف: &متغير متجه ط8, الرمز: طبيعي, المحتوى: &متجه ط8): فراغ {
    ألحق_قسم_ويب_أسمبلي(الملف, الرمز, المحتوى);
}

عرف بايتات_نص_ويب_أسمبلي(النص: نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        ألحق(الناتج, النص[ف] مثل ط8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ألحق_ست_عشري_ويب_أسمبلي(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع الأرقام: متجه ط8 = بايتات_من_نص(«0123456789abcdef»);
    دع ف: متغير طبيعي = 16;
    طالما (ف > 0) {
        ف := ف - 1;
        دع الباقي: متغير طبيعي = القيمة;
        دع س: متغير طبيعي = 0;
        طالما (س < ف) { الباقي := الباقي / 16; س := س + 1; }
        ألحق(*الناتج, الأرقام[الباقي % 16]);
    }
}

// Symbol names mirror the LLVM provider's spelling for the same entities.
عرف اسم_دالة_ويب_أسمبلي(المعرف: طبيعي): متجه ط8 {
    دع الاسم: متغير متجه ط8 = بايتات_نص_ويب_أسمبلي(«sultanc_fn_»);
    ألحق_ست_عشري_ويب_أسمبلي(&متغير الاسم, المعرف);
    أرجع الاسم;
}

عرف اسم_بيانات_ثابتة_ويب_أسمبلي(الدالة: طبيعي, القيمة: طبيعي): متجه ط8 {
    دع الاسم: متغير متجه ط8 = بايتات_نص_ويب_أسمبلي(«sultanc_data_»);
    ألحق_ست_عشري_ويب_أسمبلي(&متغير الاسم, الدالة);
    ألحق(الاسم, 0x5F);
    ألحق_ست_عشري_ويب_أسمبلي(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عرف اسم_عام_ويب_أسمبلي(المعرف: طبيعي): متجه ط8 {
    دع الاسم: متغير متجه ط8 = بايتات_نص_ويب_أسمبلي(«sultanc_global_»);
    ألحق_ست_عشري_ويب_أسمبلي(&متغير الاسم, المعرف);
    أرجع الاسم;
}

عرف لوغ_محاذاة_ويب_أسمبلي(المحاذاة: طبيعي): طبيعي {
    دع اللوغ: متغير طبيعي = 0;
    دع القيمة: متغير طبيعي = 1;
    طالما (القيمة < المحاذاة && اللوغ < 31) { القيمة := القيمة * 2; اللوغ := اللوغ + 1; }
    أرجع اللوغ;
}

عرف حاذ_ويب_أسمبلي(القيمة: طبيعي, المحاذاة: طبيعي): طبيعي {
    لو (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: طبيعي = القيمة % المحاذاة;
    لو (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + المحاذاة - الباقي;
}

// --------------------------------------------------------------- tables --

نوع رمز_بيانات_ويب_أسمبلي = {
    الاسم: متجه ط8,
    القطعة: طبيعي,
    الحجم: طبيعي
};

نوع قطعة_بيانات_ويب_أسمبلي = {
    الاسم: متجه ط8,
    المحاذاة: طبيعي,
    البايتات: متجه ط8,
    // Relocations inside this segment: (offset in segment, symbol, type, addend).
    الإزاحات: متجه طلب_إزاحة_بيانات_كائن
};

عرف ضع_في_خريطة_ويب_أسمبلي(الخريطة: &متغير متجه اختياري طبيعي, المفتاح: طبيعي, القيمة: طبيعي): فراغ {
    طالما ((الطول(*الخريطة) مثل طبيعي) <= المفتاح) { ألحق(*الخريطة, اختياري.لا_شيء()); }
    (*الخريطة)[المفتاح] := اختياري.موجود(القيمة);
}

عرف من_خريطة_ويب_أسمبلي(الخريطة: &متجه اختياري طبيعي, المفتاح: طبيعي): اختياري طبيعي {
    لو (المفتاح >= (الطول(*الخريطة) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*الخريطة)[المفتاح];
}

// ----------------------------------------------------------------- write --

عام عرف اكتب_كائن_ويب_أسمبلي(
    الوحدة: &وحدة_ويب_أسمبلي_للكتابة,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة متجه ط8, خطأ_كائن_ويب_أسمبلي {
    دع عدد_الدوال: طبيعي = الطول((*الوحدة).الدوال) مثل طبيعي;
    دع عدد_التواقيع: طبيعي = الطول((*الوحدة).التواقيع.التواقيع) مثل طبيعي;

    // Defined functions and the imports actually referenced.
    دع مواضع_الدوال: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الدوال) {
        طابق (*الوحدة).الدوال[ف].الهوية مع
        | هوية_دالة_ويب_أسمبلي.مسير(المعرف) -> { ضع_في_خريطة_ويب_أسمبلي(&متغير مواضع_الدوال, المعرف.القيمة, ف); }
        | _ -> { };
        لو ((*الوحدة).الدوال[ف].التوقيع >= عدد_التواقيع) {
            أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.توقيع_غير_صالح((*الوحدة).الدوال[ف].التوقيع));
        };
        ف := ف + 1;
    }
    // External function id -> its declaration position (direct lookup).
    دع مستخدمة: متغير متجه منطقي = [];
    دع مواضع_الإعلانات: متغير متجه اختياري طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*الوحدة).المستوردة) مثل طبيعي)) {
        ألحق(مستخدمة, خطأ);
        ضع_في_خريطة_ويب_أسمبلي(&متغير مواضع_الإعلانات, (*الوحدة).المستوردة[ف].المعرف.القيمة, ف);
        ف := ف + 1;
    }
    دع يحتاج_المكدس: متغير منطقي = خطأ;
    دع يحتاج_الجدول: متغير منطقي = خطأ;
    دع يحتاج_قاعدة_الكومة: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < عدد_الدوال) {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*الوحدة).الدوال[ف].الإزاحات) مثل طبيعي)) {
            طابق (*الوحدة).الدوال[ف].الإزاحات[ر].الهدف مع
            | هدف_إزاحة_ويب_أسمبلي.مؤشر_المكدس -> { يحتاج_المكدس := صواب; }
            | هدف_إزاحة_ويب_أسمبلي.جدول_الدوال -> { يحتاج_الجدول := صواب; }
            | هدف_إزاحة_ويب_أسمبلي.قاعدة_الكومة -> { يحتاج_قاعدة_الكومة := صواب; }
            | هدف_إزاحة_ويب_أسمبلي.رمز(مرجع_رمز_كائن.رمز_خارجي(المعرف)) -> {
                طابق من_خريطة_ويب_أسمبلي(&مواضع_الإعلانات, المعرف.القيمة) مع
                | اختياري.موجود(م) -> { مستخدمة[م] := صواب; }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(مرجع_رمز_كائن.رمز_خارجي(المعرف)));
                };
            }
            | _ -> { };
            ر := ر + 1;
        }
        ف := ف + 1;
    }
    دع المستوردة_المستخدمة: متغير متجه طبيعي = [];
    دع مواضع_المستوردة: متغير متجه اختياري طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*الوحدة).المستوردة) مثل طبيعي)) {
        لو (مستخدمة[ف]) {
            لو ((*الوحدة).المستوردة[ف].التوقيع >= عدد_التواقيع) {
                أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.توقيع_غير_صالح((*الوحدة).المستوردة[ف].التوقيع));
            };
            // Declarations of one host function (same module and name) share
            // one import, as the linker requires; their signatures must agree.
            دع الموضع: متغير طبيعي = الطول(المستوردة_المستخدمة) مثل طبيعي;
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(المستوردة_المستخدمة) مثل طبيعي)) {
                دع السابقة: &دالة_مستوردة_ويب_أسمبلي = &(*الوحدة).المستوردة[المستوردة_المستخدمة[م]];
                لو (اسما_رمز_خارجي_كائن_متساويان(&(*السابقة).الاسم, &(*الوحدة).المستوردة[ف].الاسم)
                    && اسما_رمز_خارجي_كائن_متساويان(&(*السابقة).الوحدة, &(*الوحدة).المستوردة[ف].الوحدة)) {
                    لو ((*السابقة).التوقيع != (*الوحدة).المستوردة[ف].التوقيع) {
                        أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.توقيع_غير_صالح((*الوحدة).المستوردة[ف].التوقيع));
                    };
                    الموضع := م;
                };
                م := م + 1;
            }
            ضع_في_خريطة_ويب_أسمبلي(&متغير مواضع_المستوردة, (*الوحدة).المستوردة[ف].المعرف.القيمة, الموضع);
            لو (الموضع == (الطول(المستوردة_المستخدمة) مثل طبيعي)) {
                ألحق(المستوردة_المستخدمة, ف);
            };
        };
        ف := ف + 1;
    }
    دع عدد_المستوردة: طبيعي = الطول(المستوردة_المستخدمة) مثل طبيعي;

    // Data symbols: per-function static data, then globals, then external
    // data names; each defined datum is its own segment.
    دع القطع: متغير متجه قطعة_بيانات_ويب_أسمبلي = [];
    دع رموز_البيانات: متغير متجه رمز_بيانات_ويب_أسمبلي = [];
    دع بداية_البيانات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الدوال) {
        ألحق(بداية_البيانات, الطول(رموز_البيانات) مثل طبيعي);
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول((*الوحدة).الدوال[ف].البيانات_الثابتة) مثل طبيعي)) {
            دع البيان: &بيانات_ثابتة_كائن = &(*الوحدة).الدوال[ف].البيانات_الثابتة[م];
            لو ((*البيان).المعرف.القيمة != م) {
                أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(
                    مرجع_رمز_كائن.بيانات_ثابتة(انسخ_معرف_بيانات_ثابتة_كائن(&(*البيان).المعرف))));
            };
            دع الاسم: متجه ط8 = اسم_بيانات_ثابتة_ويب_أسمبلي((*البيان).المعرف.الدالة.القيمة, م);
            دع اسم_القطعة: متغير متجه ط8 = بايتات_نص_ويب_أسمبلي(«.rodata.»);
            ألحق_بايتات_ويب_أسمبلي(&متغير اسم_القطعة, &الاسم);
            دع بلا_إزاحات: متجه طلب_إزاحة_بيانات_كائن = [];
            دع البايتات: متغير متجه ط8 = [];
            ألحق_بايتات_ويب_أسمبلي(&متغير البايتات, &(*البيان).البيانات);
            دع القطعة: قطعة_بيانات_ويب_أسمبلي = {
                الاسم: اسم_القطعة, المحاذاة: (*البيان).المحاذاة,
                البايتات: البايتات, الإزاحات: بلا_إزاحات
            };
            دع الرمز: رمز_بيانات_ويب_أسمبلي = {
                الاسم: الاسم, القطعة: الطول(القطع) مثل طبيعي,
                الحجم: الطول((*البيان).البيانات) مثل طبيعي
            };
            ألحق(القطع, القطعة);
            ألحق(رموز_البيانات, الرمز);
            م := م + 1;
        }
        ف := ف + 1;
    }
    دع رموز_العوام: متغير متجه اختياري طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*الوحدة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع العام: &بيانات_عام_كائن = &(*الوحدة).المرفقات.البيانات_العامة[ف];
        دع الاسم: متجه ط8 = اسم_عام_ويب_أسمبلي((*العام).المعرف.القيمة);
        دع اسم_القطعة: متغير متجه ط8 = [];
        لو ((*العام).قابل_للكتابة) { اسم_القطعة := بايتات_نص_ويب_أسمبلي(«.data.»); }
        وإلا { اسم_القطعة := بايتات_نص_ويب_أسمبلي(«.rodata.»); };
        ألحق_بايتات_ويب_أسمبلي(&متغير اسم_القطعة, &الاسم);
        دع البايتات: متغير متجه ط8 = [];
        ألحق_بايتات_ويب_أسمبلي(&متغير البايتات, &(*العام).البيانات);
        دع الطلبات: متغير متجه طلب_إزاحة_بيانات_كائن = [];
        دع ط: متغير طبيعي = 0;
        طالما (ط < (الطول((*العام).الإزاحات) مثل طبيعي)) {
            دع الأصل: &طلب_إزاحة_بيانات_كائن = &(*العام).الإزاحات[ط];
            دع الطلب: طلب_إزاحة_بيانات_كائن = {
                الموضع: (*الأصل).الموضع,
                الرمز: انسخ_مرجع_رمز_كائن(&(*الأصل).الرمز),
                الإضافة: (*الأصل).الإضافة
            };
            ألحق(الطلبات, الطلب);
            ط := ط + 1;
        }
        دع القطعة: قطعة_بيانات_ويب_أسمبلي = {
            الاسم: اسم_القطعة, المحاذاة: (*العام).المحاذاة,
            البايتات: البايتات, الإزاحات: الطلبات
        };
        دع الرمز: رمز_بيانات_ويب_أسمبلي = {
            الاسم: الاسم, القطعة: الطول(القطع) مثل طبيعي,
            الحجم: الطول((*العام).البيانات) مثل طبيعي
        };
        ضع_في_خريطة_ويب_أسمبلي(&متغير رموز_العوام, (*العام).المعرف.القيمة, الطول(رموز_البيانات) مثل طبيعي);
        ألحق(القطع, القطعة);
        ألحق(رموز_البيانات, الرمز);
        ف := ف + 1;
    }
    دع عدد_البيانات_المعرفة: طبيعي = الطول(رموز_البيانات) مثل طبيعي;
    دع رموز_بيانات_خارجية: متغير متجه متجه ط8 = [];
    ف := 0;
    طالما (ف < (الطول((*الوحدة).المرفقات.البيانات_الخارجية) مثل طبيعي)) {
        دع البيان: &بيانات_خارجية_كائن = &(*الوحدة).المرفقات.البيانات_الخارجية[ف];
        ضع_في_خريطة_ويب_أسمبلي(&متغير رموز_العوام, (*البيان).المعرف.القيمة,
            عدد_البيانات_المعرفة + (الطول(رموز_بيانات_خارجية) مثل طبيعي));
        ألحق(رموز_بيانات_خارجية, انسخ_اسم_رمز_خارجي_كائن(&(*البيان).الاسم));
        ف := ف + 1;
    }

    // Symbol index layout: defined functions, imported functions, defined
    // data, external data, then __heap_base, __stack_pointer, the table,
    // __memory_base and __table_base, then the debug sections.
    دع أساس_المستوردة: طبيعي = عدد_الدوال;
    دع أساس_البيانات: طبيعي = أساس_المستوردة + عدد_المستوردة;
    دع التالي: متغير طبيعي = أساس_البيانات + عدد_البيانات_المعرفة + (الطول(رموز_بيانات_خارجية) مثل طبيعي);
    دع رمز_قاعدة_الكومة: طبيعي = التالي;
    لو (يحتاج_قاعدة_الكومة) { التالي := التالي + 1; };
    دع رمز_المكدس: طبيعي = التالي;
    لو (يحتاج_المكدس) { التالي := التالي + 1; };
    دع رمز_الجدول: طبيعي = التالي;
    لو (يحتاج_الجدول) { التالي := التالي + 1; };

    // ---- position-independent code (DynamicLinking.md): which bases the
    // code adds to, and the data symbols it reaches through GOT entries.
    دع يحتاج_قاعدة_الذاكرة: متغير منطقي = خطأ;
    دع يحتاج_قاعدة_الجدول: متغير منطقي = خطأ;
    دع رموز_المؤشرات: متغير متجه طبيعي = [];
    دع مواضع_المؤشرات: متغير متجه اختياري طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الدوال) {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*الوحدة).الدوال[ف].الإزاحات) مثل طبيعي)) {
            دع الإزاحة: &إزاحة_شفرة_ويب_أسمبلي = &(*الوحدة).الدوال[ف].الإزاحات[ر];
            دع قاعدة: منطقي = (*الإزاحة).النوع == نوع_إزاحة_ويب_أسمبلي.قاعدة_موضعية();
            // The selector's code model must match the object's: absolute
            // addresses and table indices only in ordinary objects, PIC
            // pairs only in position-independent ones.
            دع مطلق: منطقي = (*الإزاحة).النوع == نوع_إزاحة_ويب_أسمبلي.عنوان_ذاكرة_موقع()
                || (*الإزاحة).النوع == نوع_إزاحة_ويب_أسمبلي.فهرس_جدول_موقع();
            دع نسبي: منطقي = قاعدة
                || (*الإزاحة).النوع == نوع_إزاحة_ويب_أسمبلي.عنوان_ذاكرة_نسبي()
                || (*الإزاحة).النوع == نوع_إزاحة_ويب_أسمبلي.فهرس_جدول_نسبي();
            لو ((مطلق && (*الوحدة).موضع_مستقل) || (نسبي && !(*الوحدة).موضع_مستقل)) {
                أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.عنوان_موضعي_غير_ممثل());
            };
            لو (قاعدة) {
                طابق صنف_قاعدة_موضعية_ويب_أسمبلي(
                    &(*الإزاحة).الهدف, &مواضع_الدوال, &مواضع_المستوردة, أساس_المستوردة,
                    &بداية_البيانات, أساس_البيانات, &رموز_العوام, عدد_البيانات_المعرفة, رمز_قاعدة_الكومة
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(القاعدة) -> {
                    طابق القاعدة مع
                    | قاعدة_موضعية_ويب_أسمبلي.الذاكرة -> { يحتاج_قاعدة_الذاكرة := صواب; }
                    | قاعدة_موضعية_ويب_أسمبلي.الجدول -> { يحتاج_قاعدة_الجدول := صواب; }
                    | قاعدة_موضعية_ويب_أسمبلي.مؤشر(الرمز_المؤشر) -> {
                        طابق من_خريطة_ويب_أسمبلي(&مواضع_المؤشرات, الرمز_المؤشر) مع
                        | اختياري.موجود(_) -> { }
                        | اختياري.لا_شيء -> {
                            ضع_في_خريطة_ويب_أسمبلي(
                                &متغير مواضع_المؤشرات, الرمز_المؤشر, الطول(رموز_المؤشرات) مثل طبيعي
                            );
                            ألحق(رموز_المؤشرات, الرمز_المؤشر);
                        };
                    };
                };
            };
            ر := ر + 1;
        }
        ف := ف + 1;
    }
    // Global import order: __stack_pointer, __memory_base, __table_base, then
    // the GOT entries.
    دع العام_التالي: متغير طبيعي = 0;
    لو (يحتاج_المكدس) { العام_التالي := 1; };
    دع عام_قاعدة_الذاكرة: طبيعي = العام_التالي;
    لو (يحتاج_قاعدة_الذاكرة) { العام_التالي := العام_التالي + 1; };
    دع عام_قاعدة_الجدول: طبيعي = العام_التالي;
    لو (يحتاج_قاعدة_الجدول) { العام_التالي := العام_التالي + 1; };
    دع أساس_عوام_المؤشرات: طبيعي = العام_التالي;
    دع رمز_قاعدة_الذاكرة: طبيعي = التالي;
    لو (يحتاج_قاعدة_الذاكرة) { التالي := التالي + 1; };
    دع رمز_قاعدة_الجدول: طبيعي = التالي;
    لو (يحتاج_قاعدة_الجدول) { التالي := التالي + 1; };
    دع عدد_الرموز: طبيعي = التالي;

    // ---- type section
    دع قسم_الأنواع: متغير متجه ط8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الأنواع, عدد_التواقيع);
    ف := 0;
    طالما (ف < عدد_التواقيع) {
        دع التوقيع: &توقيع_ويب_أسمبلي = &(*الوحدة).التواقيع.التواقيع[ف];
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الأنواع, 0x60);
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الأنواع, الطول((*التوقيع).المعاملات) مثل طبيعي);
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول((*التوقيع).المعاملات) مثل طبيعي)) {
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_الأنواع, رمز_نوع_قيمة_ويب_أسمبلي((*التوقيع).المعاملات[م]));
            م := م + 1;
        }
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الأنواع, الطول((*التوقيع).النواتج) مثل طبيعي);
        م := 0;
        طالما (م < (الطول((*التوقيع).النواتج) مثل طبيعي)) {
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_الأنواع, رمز_نوع_قيمة_ويب_أسمبلي((*التوقيع).النواتج[م]));
            م := م + 1;
        }
        ف := ف + 1;
    }

    // ---- data layout (segment offsets are provisional; the linker places them)
    دع إزاحات_القطع: متغير متجه طبيعي = [];
    دع حجم_البيانات: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول(القطع) مثل طبيعي)) {
        حجم_البيانات := حاذ_ويب_أسمبلي(حجم_البيانات, القطع[ف].المحاذاة);
        ألحق(إزاحات_القطع, حجم_البيانات);
        حجم_البيانات := حجم_البيانات + (الطول(القطع[ف].البايتات) مثل طبيعي);
        ف := ف + 1;
    }

    // ---- import section
    دع الوحدة_البيئية: متجه ط8 = بايتات_نص_ويب_أسمبلي(«env»);
    دع قسم_الاستيراد: متغير متجه ط8 = [];
    دع عدد_الاستيرادات: متغير طبيعي = 1 + عدد_المستوردة + (الطول(رموز_المؤشرات) مثل طبيعي);
    لو (يحتاج_المكدس) { عدد_الاستيرادات := عدد_الاستيرادات + 1; };
    لو (يحتاج_الجدول) { عدد_الاستيرادات := عدد_الاستيرادات + 1; };
    لو (يحتاج_قاعدة_الذاكرة) { عدد_الاستيرادات := عدد_الاستيرادات + 1; };
    لو (يحتاج_قاعدة_الجدول) { عدد_الاستيرادات := عدد_الاستيرادات + 1; };
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, عدد_الاستيرادات);
    دع اسم_الذاكرة: متجه ط8 = بايتات_نص_ويب_أسمبلي(«__linear_memory»);
    ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الوحدة_البيئية);
    ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_الذاكرة);
    ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x02); // memory
    ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x00); // limits: min only
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, (حجم_البيانات + 65535) / 65536);
    لو (يحتاج_المكدس) {
        دع اسم_المكدس: متجه ط8 = بايتات_نص_ويب_أسمبلي(«__stack_pointer»);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الوحدة_البيئية);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_المكدس);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x03); // global
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x7F); // i32
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x01); // mutable
    };
    لو (يحتاج_قاعدة_الذاكرة) {
        دع اسم_القاعدة: متجه ط8 = بايتات_نص_ويب_أسمبلي(«__memory_base»);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الوحدة_البيئية);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_القاعدة);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x03); // global
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x7F); // i32
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x00); // immutable
    };
    لو (يحتاج_قاعدة_الجدول) {
        دع اسم_القاعدة: متجه ط8 = بايتات_نص_ويب_أسمبلي(«__table_base»);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الوحدة_البيئية);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_القاعدة);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x03); // global
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x7F); // i32
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x00); // immutable
    };
    // GOT.mem entries: mutable i32 globals the dynamic loader fills with the
    // symbol's final address.
    دع وحدة_المؤشرات: متجه ط8 = بايتات_نص_ويب_أسمبلي(«GOT.mem»);
    ف := 0;
    طالما (ف < (الطول(رموز_المؤشرات) مثل طبيعي)) {
        دع الرمز_المؤشر: طبيعي = رموز_المؤشرات[ف];
        دع اسم_المؤشر: متغير متجه ط8 = [];
        لو (الرمز_المؤشر == رمز_قاعدة_الكومة) {
            اسم_المؤشر := بايتات_نص_ويب_أسمبلي(«__heap_base»);
        } وإلا {
            ألحق_بايتات_ويب_أسمبلي(
                &متغير اسم_المؤشر,
                &رموز_بيانات_خارجية[الرمز_المؤشر - أساس_البيانات - عدد_البيانات_المعرفة]
            );
        };
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &وحدة_المؤشرات);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_المؤشر);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x03); // global
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x7F); // i32
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x01); // mutable
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < عدد_المستوردة) {
        دع المستوردة: &دالة_مستوردة_ويب_أسمبلي = &(*الوحدة).المستوردة[المستوردة_المستخدمة[ف]];
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &(*المستوردة).الوحدة);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &(*المستوردة).الاسم);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x00); // function
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, (*المستوردة).التوقيع);
        ف := ف + 1;
    }
    لو (يحتاج_الجدول) {
        دع اسم_الجدول: متجه ط8 = بايتات_نص_ويب_أسمبلي(«__indirect_function_table»);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الوحدة_البيئية);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_الجدول);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x01); // table
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x70); // funcref
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x00); // limits: min only
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, 0);
    };

    // ---- function section
    دع قسم_الدوال: متغير متجه ط8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الدوال, عدد_الدوال);
    ف := 0;
    طالما (ف < عدد_الدوال) {
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الدوال, (*الوحدة).الدوال[ف].التوقيع);
        ف := ف + 1;
    }

    // ---- code section, with its relocations resolved to symbol indices
    دع قسم_الشفرة: متغير متجه ط8 = [];
    دع إزاحات_الشفرة: متغير متجه ط8 = [];
    دع عدد_إزاحات_الشفرة: متغير طبيعي = 0;
    // Per function: body start (after the size LEB), instruction start and
    // end, as offsets in the CODE payload (the DWARF code address space).
    دع بدايات_الأجسام: متغير متجه طبيعي = [];
    دع بدايات_التعليمات: متغير متجه طبيعي = [];
    دع نهايات_الأجسام: متغير متجه طبيعي = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الشفرة, عدد_الدوال);
    ف := 0;
    طالما (ف < عدد_الدوال) {
        دع الدالة: &دالة_ويب_أسمبلي_مشفرة = &(*الوحدة).الدوال[ف];
        دع المحليات: متغير متجه ط8 = [];
        دع المجموعات: متغير طبيعي = 0;
        دع ترميز_المجموعات: متغير متجه ط8 = [];
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول((*الدالة).المحليات) مثل طبيعي)) {
            دع النوع: نوع_قيمة_ويب_أسمبلي = (*الدالة).المحليات[م];
            دع العدد: متغير طبيعي = 1;
            طالما (م + العدد < (الطول((*الدالة).المحليات) مثل طبيعي)
                && نوعا_قيمة_ويب_أسمبلي_متساويان((*الدالة).المحليات[م + العدد], النوع)) {
                العدد := العدد + 1;
            }
            ألحق_ليب_ويب_أسمبلي(&متغير ترميز_المجموعات, العدد);
            ألحق_بايت_ويب_أسمبلي(&متغير ترميز_المجموعات, رمز_نوع_قيمة_ويب_أسمبلي(النوع));
            المجموعات := المجموعات + 1;
            م := م + العدد;
        }
        ألحق_ليب_ويب_أسمبلي(&متغير المحليات, المجموعات);
        ألحق_بايتات_ويب_أسمبلي(&متغير المحليات, &ترميز_المجموعات);
        دع الحجم: طبيعي = (الطول(المحليات) مثل طبيعي) + (الطول((*الدالة).الشفرة) مثل طبيعي);
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الشفرة, الحجم);
        ألحق(بدايات_الأجسام, الطول(قسم_الشفرة) مثل طبيعي);
        ألحق_بايتات_ويب_أسمبلي(&متغير قسم_الشفرة, &المحليات);
        دع الأساس: طبيعي = الطول(قسم_الشفرة) مثل طبيعي;
        ألحق(بدايات_التعليمات, الأساس);
        ألحق_بايتات_ويب_أسمبلي(&متغير قسم_الشفرة, &(*الدالة).الشفرة);
        ألحق(نهايات_الأجسام, الطول(قسم_الشفرة) مثل طبيعي);
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*الدالة).الإزاحات) مثل طبيعي)) {
            دع الإزاحة: &إزاحة_شفرة_ويب_أسمبلي = &(*الدالة).الإزاحات[ر];
            دع رمز_النوع: متغير طبيعي = 0;
            // 0: absolute; 1: PIC base slot; 2: PIC memory offset; 3: PIC
            // table offset.
            دع صنف_موضعي: متغير طبيعي = 0;
            طابق (*الإزاحة).النوع مع
            | نوع_إزاحة_ويب_أسمبلي.فهرس_دالة -> { رمز_النوع := 0; }
            | نوع_إزاحة_ويب_أسمبلي.فهرس_جدول_موقع -> { رمز_النوع := 1; }
            | نوع_إزاحة_ويب_أسمبلي.عنوان_ذاكرة_موقع -> { رمز_النوع := 4; }
            | نوع_إزاحة_ويب_أسمبلي.فهرس_نوع -> { رمز_النوع := 6; }
            | نوع_إزاحة_ويب_أسمبلي.فهرس_عام -> { رمز_النوع := 7; }
            | نوع_إزاحة_ويب_أسمبلي.رقم_جدول -> { رمز_النوع := 20; }
            | نوع_إزاحة_ويب_أسمبلي.قاعدة_موضعية -> { رمز_النوع := 7; صنف_موضعي := 1; }
            | نوع_إزاحة_ويب_أسمبلي.عنوان_ذاكرة_نسبي -> { رمز_النوع := 11; صنف_موضعي := 2; }
            | نوع_إزاحة_ويب_أسمبلي.فهرس_جدول_نسبي -> { رمز_النوع := 12; صنف_موضعي := 3; };
            دع الفهرس: متغير طبيعي = 0;
            طابق (*الإزاحة).الهدف مع
            | هدف_إزاحة_ويب_أسمبلي.مؤشر_المكدس -> { الفهرس := رمز_المكدس; }
            | هدف_إزاحة_ويب_أسمبلي.جدول_الدوال -> { الفهرس := رمز_الجدول; }
            | هدف_إزاحة_ويب_أسمبلي.قاعدة_الكومة -> { الفهرس := رمز_قاعدة_الكومة; }
            | هدف_إزاحة_ويب_أسمبلي.توقيع(التوقيع) -> {
                لو (التوقيع >= عدد_التواقيع) { أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.توقيع_غير_صالح(التوقيع)); };
                الفهرس := التوقيع;
            }
            | هدف_إزاحة_ويب_أسمبلي.رمز(الرمز) -> {
                طابق فهرس_رمز_مرجع_ويب_أسمبلي(&الرمز, &مواضع_الدوال, &مواضع_المستوردة, أساس_المستوردة,
                    &بداية_البيانات, أساس_البيانات, &رموز_العوام) مع
                | اختياري.موجود(ق) -> { الفهرس := ق; }
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(الرمز)); };
            };
            // The slot also holds the provisional value (as LLVM writes it),
            // so the object is a valid module before linking.
            دع المؤقت: متغير عدد = قيمة_مؤقتة_رمز_ويب_أسمبلي(
                رمز_النوع, الفهرس, عدد_الدوال, عدد_المستوردة, أساس_البيانات,
                &رموز_البيانات, &إزاحات_القطع
            ) + (*الإزاحة).الإضافة;
            // A position-independent pair: the base slot names __memory_base,
            // __table_base or the GOT entry's data symbol; after a GOT load
            // the offset slot is the plain addend, with no relocation.
            دع بلا_إزاحة: متغير منطقي = خطأ;
            لو (صنف_موضعي == 1 || صنف_موضعي == 2) {
                طابق صنف_قاعدة_موضعية_ويب_أسمبلي(
                    &(*الإزاحة).الهدف, &مواضع_الدوال, &مواضع_المستوردة, أساس_المستوردة,
                    &بداية_البيانات, أساس_البيانات, &رموز_العوام, عدد_البيانات_المعرفة, رمز_قاعدة_الكومة
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(القاعدة) -> {
                    طابق القاعدة مع
                    | قاعدة_موضعية_ويب_أسمبلي.الذاكرة -> {
                        لو (صنف_موضعي == 1) {
                            الفهرس := رمز_قاعدة_الذاكرة;
                            المؤقت := عام_قاعدة_الذاكرة مثل عدد;
                        };
                    }
                    | قاعدة_موضعية_ويب_أسمبلي.الجدول -> {
                        لو (صنف_موضعي == 1) {
                            الفهرس := رمز_قاعدة_الجدول;
                            المؤقت := عام_قاعدة_الجدول مثل عدد;
                        } وإلا {
                            أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.عنوان_موضعي_غير_ممثل());
                        };
                    }
                    | قاعدة_موضعية_ويب_أسمبلي.مؤشر(الرمز_المؤشر) -> {
                        لو (صنف_موضعي == 1) {
                            الفهرس := الرمز_المؤشر;
                            طابق من_خريطة_ويب_أسمبلي(&مواضع_المؤشرات, الرمز_المؤشر) مع
                            | اختياري.موجود(الموضع_المؤشر) -> {
                                المؤقت := (أساس_عوام_المؤشرات + الموضع_المؤشر) مثل عدد;
                            }
                            | اختياري.لا_شيء -> {
                                أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.عنوان_موضعي_غير_ممثل());
                            };
                        } وإلا {
                            بلا_إزاحة := صواب;
                            المؤقت := (*الإزاحة).الإضافة;
                        };
                    };
                };
            };
            لو (صنف_موضعي == 3) { المؤقت := 0; };
            لو (رمز_النوع == 4 || رمز_النوع == 1 || رمز_النوع == 11 || رمز_النوع == 12) {
                اكتب_سليب_مبطن_ويب_أسمبلي_عند(&متغير قسم_الشفرة, الأساس + (*الإزاحة).الموضع, المؤقت);
            } وإلا {
                اكتب_ليب_مبطن_ويب_أسمبلي_عند(&متغير قسم_الشفرة, الأساس + (*الإزاحة).الموضع, المؤقت مثل طبيعي);
            };
            لو (!بلا_إزاحة) {
                ألحق_بايت_ويب_أسمبلي(&متغير إزاحات_الشفرة, رمز_النوع);
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_الشفرة, الأساس + (*الإزاحة).الموضع);
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_الشفرة, الفهرس);
                لو (رمز_النوع == 4 || رمز_النوع == 11) {
                    ألحق_سليب_ويب_أسمبلي(&متغير إزاحات_الشفرة, (*الإزاحة).الإضافة);
                };
                عدد_إزاحات_الشفرة := عدد_إزاحات_الشفرة + 1;
            };
            ر := ر + 1;
        }
        ف := ف + 1;
    }

    // ---- data section and its relocations
    دع قسم_البيانات: متغير متجه ط8 = [];
    دع إزاحات_البيانات: متغير متجه ط8 = [];
    دع عدد_إزاحات_البيانات: متغير طبيعي = 0;
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, الطول(القطع) مثل طبيعي);
    ف := 0;
    طالما (ف < (الطول(القطع) مثل طبيعي)) {
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, 0); // active, memory 0
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_البيانات, 0x41);
        ألحق_سليب_ويب_أسمبلي(&متغير قسم_البيانات, إزاحات_القطع[ف] مثل عدد);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_البيانات, 0x0B);
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, الطول(القطع[ف].البايتات) مثل طبيعي);
        دع الأساس: طبيعي = الطول(قسم_البيانات) مثل طبيعي;
        ألحق_بايتات_ويب_أسمبلي(&متغير قسم_البيانات, &القطع[ف].البايتات);
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(القطع[ف].الإزاحات) مثل طبيعي)) {
            دع الطلب: &طلب_إزاحة_بيانات_كائن = &القطع[ف].الإزاحات[ر];
            لو ((*الطلب).الموضع + 4 > (الطول(القطع[ف].البايتات) مثل طبيعي)) {
                أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(انسخ_مرجع_رمز_كائن(&(*الطلب).الرمز)));
            };
            دع الفهرس: طبيعي;
            طابق فهرس_رمز_مرجع_ويب_أسمبلي(&(*الطلب).الرمز, &مواضع_الدوال, &مواضع_المستوردة, أساس_المستوردة,
                &بداية_البيانات, أساس_البيانات, &رموز_العوام) مع
            | اختياري.موجود(ق) -> { الفهرس := ق; }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(انسخ_مرجع_رمز_كائن(&(*الطلب).الرمز))); };
            طابق (*الطلب).الرمز مع
            | مرجع_رمز_كائن.دالة(_) -> {
                // Function addresses in data are table indices.
                لو ((*الطلب).الإضافة != 0) {
                    أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.إضافة_غير_صالحة(انسخ_مرجع_رمز_كائن(&(*الطلب).الرمز)));
                };
                ألحق_بايت_ويب_أسمبلي(&متغير إزاحات_البيانات, 2); // R_WASM_TABLE_INDEX_I32
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_البيانات, الأساس + (*الطلب).الموضع);
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_البيانات, الفهرس);
            }
            | _ -> {
                لو ((*الطلب).الإضافة > 2147483647) {
                    أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.إضافة_غير_صالحة(انسخ_مرجع_رمز_كائن(&(*الطلب).الرمز)));
                };
                دع المؤقت: عدد = قيمة_مؤقتة_رمز_ويب_أسمبلي(
                    5, الفهرس, عدد_الدوال, عدد_المستوردة, أساس_البيانات, &رموز_البيانات, &إزاحات_القطع
                ) + ((*الطلب).الإضافة مثل عدد);
                دع ب: متغير طبيعي = 0;
                دع الباقي: متغير طبيعي = (المؤقت مثل طبيعي) % 4294967296;
                طالما (ب < 4) {
                    قسم_البيانات[الأساس + (*الطلب).الموضع + ب] := (الباقي % 256) مثل ط8;
                    الباقي := الباقي / 256;
                    ب := ب + 1;
                }
                ألحق_بايت_ويب_أسمبلي(&متغير إزاحات_البيانات, 5); // R_WASM_MEMORY_ADDR_I32
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_البيانات, الأساس + (*الطلب).الموضع);
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_البيانات, الفهرس);
                ألحق_سليب_ويب_أسمبلي(&متغير إزاحات_البيانات, (*الطلب).الإضافة مثل عدد);
            };
            عدد_إزاحات_البيانات := عدد_إزاحات_البيانات + 1;
            ر := ر + 1;
        }
        ف := ف + 1;
    }

    // ---- function symbol names (symbol table and DWARF linkage names)
    دع أسماء_الدوال: متغير متجه متجه ط8 = [];
    دع أعلام_الدوال: متغير متجه طبيعي = [];
    دع دوال_البدء: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الدوال) {
        دع الدالة: &دالة_ويب_أسمبلي_مشفرة = &(*الوحدة).الدوال[ف];
        دع الاسم: متغير متجه ط8 = [];
        دع الأعلام: متغير طبيعي = 0;
        طابق (*الدالة).الهوية مع
        | هوية_دالة_ويب_أسمبلي.مسير(المعرف) -> {
            الاسم := اسم_دالة_ويب_أسمبلي(المعرف.القيمة);
            طابق (*الوحدة).الدخول_المصدر مع
            | اختياري.موجود(الدخول) -> {
                لو (الدخول.القيمة == المعرف.القيمة) { الاسم := بايتات_نص_ويب_أسمبلي(«_start»); };
            }
            | اختياري.لا_شيء -> { };
        }
        | هوية_دالة_ويب_أسمبلي.بدء_العملية -> { الاسم := بايتات_نص_ويب_أسمبلي(«_start»); }
        | هوية_دالة_ويب_أسمبلي.منشئ_الوحدة -> {
            الاسم := بايتات_نص_ويب_أسمبلي(«sultanc_module_ctor»);
            الأعلام := 2; // BINDING_LOCAL
            ألحق(دوال_البدء, ف);
        };
        ألحق(أسماء_الدوال, الاسم);
        ألحق(أعلام_الدوال, الأعلام);
        ف := ف + 1;
    }

    // ---- DWARF: one text-relative space whose origin is the first body.
    دع أساس_النص: متغير طبيعي = 0;
    دع نهاية_النص: متغير طبيعي = 0;
    لو (عدد_الدوال > 0) {
        أساس_النص := بدايات_الأجسام[0];
        نهاية_النص := نهايات_الأجسام[عدد_الدوال - 1];
    };
    دع مواضع_دوارف: متغير متجه موضع_دالة_دوارف = [];
    دع أصول_دوارف: متغير متجه مدى_شفرة_آلة_بأصل = [];
    ف := 0;
    طالما (ف < عدد_الدوال) {
        دع الدالة: &دالة_ويب_أسمبلي_مشفرة = &(*الوحدة).الدوال[ف];
        طابق (*الدالة).الهوية مع
        | هوية_دالة_ويب_أسمبلي.مسير(المعرف) -> {
            دع اسم_الربط: متغير متجه ط8 = [];
            ألحق_بايتات_ويب_أسمبلي(&متغير اسم_الربط, &أسماء_الدوال[ف]);
            دع الموضع: موضع_دالة_دوارف = {
                الدالة: معرف_دالة_منتقاة_من_مسير(المعرف),
                إزاحة_بايت: بدايات_التعليمات[ف] - أساس_النص,
                حجم_بايت: الطول((*الدالة).الشفرة) مثل طبيعي,
                اسم_الربط: اسم_الربط
            };
            ألحق(مواضع_دوارف, الموضع);
        }
        | _ -> { };
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول((*الدالة).الأصول) مثل طبيعي)) {
            ألحق(أصول_دوارف, (*الدالة).الأصول[م]);
            م := م + 1;
        }
        ف := ف + 1;
    }
    // Globals at their provisional segment offsets (the data address space).
    دع مواضع_العوام_دوارف: متغير متجه موضع_عام_دوارف = [];
    ف := 0;
    طالما (ف < (الطول((*الوحدة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع العام: &بيانات_عام_كائن = &(*الوحدة).المرفقات.البيانات_العامة[ف];
        طابق من_خريطة_ويب_أسمبلي(&رموز_العوام, (*العام).المعرف.القيمة) مع
        | اختياري.موجود(ر) -> {
            دع معرف_العام: معرف_عام_مسير = (*العام).المعرف;
            دع الموضع: موضع_عام_دوارف = {
                العام: معرف_العام,
                إزاحة_بايت: إزاحات_القطع[رموز_البيانات[ر].القطعة],
                اسم_الربط: اسم_عام_ويب_أسمبلي(معرف_العام.القيمة)
            };
            ألحق(مواضع_العوام_دوارف, الموضع);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع نهايات_القطع: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(القطع) مثل طبيعي)) {
        ألحق(نهايات_القطع, إزاحات_القطع[ف] + (الطول(القطع[ف].البايتات) مثل طبيعي));
        ف := ف + 1;
    }
    دع خيارات_التصحيح: متغير خيارات_دوارف = خيارات_دوارف_افتراضية();
    خيارات_التصحيح.توليد_إطار := خطأ;
    دع سياق_الفك: سياق_معلومات_إطار_النداء = سياق_معلومات_إطار_النداء_جديد();
    دع الحزمة: حزمة_دوارف = ابن_حزمة_دوارف_من_سياقات_بخيارات(
        خريطة_المصادر, أصول_المصدر, &مواضع_دوارف, &مواضع_العوام_دوارف, التصحيح, تصحيح_الآلة,
