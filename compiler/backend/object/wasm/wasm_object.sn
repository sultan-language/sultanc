    // for the same baseline so wasm-ld accepts mixing with LLVM objects.
    دع قسم_الميزات: متغير متجه ط8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الميزات, 8);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «bulk-memory»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «bulk-memory-opt»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «call-indirect-overlong»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «multivalue»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «mutable-globals»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «nontrapping-fptoint»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «reference-types»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «sign-ext»);
    دع اسم_الميزات: متجه ط8 = بايتات_نص_ويب_أسمبلي(«target_features»);
    ألحق_قسم_مخصص_ويب_أسمبلي(&متغير الملف, &اسم_الميزات, &قسم_الميزات);
    أرجع نتيجة.نجح(الملف);
}

عرف ألحق_ميزة_ويب_أسمبلي(القسم: &متغير متجه ط8, الاسم: نص): فراغ {
    ألحق_بايت_ويب_أسمبلي(القسم, 0x2B); // '+': used
    دع البايتات: متجه ط8 = بايتات_نص_ويب_أسمبلي(الاسم);
    ألحق_اسم_ويب_أسمبلي(القسم, &البايتات);
}

// What a position-independent address adds to: __memory_base (data this
// object defines), __table_base (a function's table slot), or the GOT entry
// of a data symbol another module may define (external data, __heap_base,
// which the program's main module provides). LLVM makes the same choice
// for -fPIC code (DSO-local symbols relative to the bases, others through
// GOT.mem/GOT.func).
نوع قاعدة_موضعية_ويب_أسمبلي =
    | الذاكرة
    | الجدول
    | مؤشر بنوع طبيعي
;

عرف صنف_قاعدة_موضعية_ويب_أسمبلي(
    الهدف: &هدف_إزاحة_ويب_أسمبلي,
    مواضع_الدوال: &متجه اختياري طبيعي,
    مواضع_المستوردة: &متجه اختياري طبيعي,
    أساس_المستوردة: طبيعي,
    بداية_البيانات: &متجه طبيعي,
    أساس_البيانات: طبيعي,
    رموز_العوام: &متجه اختياري طبيعي,
    عدد_البيانات_المعرفة: طبيعي,
    رمز_قاعدة_الكومة: طبيعي
): نتيجة قاعدة_موضعية_ويب_أسمبلي, خطأ_كائن_ويب_أسمبلي {
    طابق *الهدف مع
    | هدف_إزاحة_ويب_أسمبلي.قاعدة_الكومة -> {
        أرجع نتيجة.نجح(قاعدة_موضعية_ويب_أسمبلي.مؤشر(رمز_قاعدة_الكومة));
    }
    | هدف_إزاحة_ويب_أسمبلي.رمز(الرمز) -> {
        دع مرجع_الرمز: &مرجع_رمز_كائن = &الرمز;
        طابق *مرجع_الرمز مع
        | مرجع_رمز_كائن.دالة(_) -> { أرجع نتيجة.نجح(قاعدة_موضعية_ويب_أسمبلي.الجدول()); }
        | _ -> { };
        طابق فهرس_رمز_مرجع_ويب_أسمبلي(&الرمز, مواضع_الدوال, مواضع_المستوردة, أساس_المستوردة,
            بداية_البيانات, أساس_البيانات, رموز_العوام) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(انسخ_مرجع_رمز_كائن(&الرمز)));
        }
        | اختياري.موجود(الفهرس) -> {
            لو (الفهرس < أساس_البيانات) {
                // An external function's address: not produced by the
                // native selector (it takes table slots of its own functions).
                أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.عنوان_موضعي_غير_ممثل());
            };
            لو (الفهرس - أساس_البيانات < عدد_البيانات_المعرفة) {
                أرجع نتيجة.نجح(قاعدة_موضعية_ويب_أسمبلي.الذاكرة());
            };
            أرجع نتيجة.نجح(قاعدة_موضعية_ويب_أسمبلي.مؤشر(الفهرس));
        };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.عنوان_موضعي_غير_ممثل()); };
}

// The provisional value of a relocated field: the module index of a function,
// global (0), table (0) or type, or the provisional address of defined data.
عرف قيمة_مؤقتة_رمز_ويب_أسمبلي(
    النوع: طبيعي,
    الفهرس: طبيعي,
    عدد_الدوال: طبيعي,
    عدد_المستوردة: طبيعي,
    أساس_البيانات: طبيعي,
    رموز_البيانات: &متجه رمز_بيانات_ويب_أسمبلي,
    إزاحات_القطع: &متجه طبيعي
): عدد {
    لو (النوع == 6) { أرجع الفهرس مثل عدد; };
    لو (النوع == 7 || النوع == 20 || النوع == 1 || النوع == 2) { أرجع 0; };
    لو (النوع == 0) {
        لو (الفهرس < عدد_الدوال) { أرجع (عدد_المستوردة + الفهرس) مثل عدد; };
        أرجع (الفهرس - عدد_الدوال) مثل عدد;
    };
    لو (الفهرس >= أساس_البيانات && الفهرس - أساس_البيانات < (الطول(*رموز_البيانات) مثل طبيعي)) {
        دع القطعة: طبيعي = (*رموز_البيانات)[الفهرس - أساس_البيانات].القطعة;
        أرجع (*إزاحات_القطع)[القطعة] مثل عدد;
    };
    أرجع 0;
}

عرف فهرس_رمز_مرجع_ويب_أسمبلي(
    الرمز: &مرجع_رمز_كائن,
    مواضع_الدوال: &متجه اختياري طبيعي,
    مواضع_المستوردة: &متجه اختياري طبيعي,
    أساس_المستوردة: طبيعي,
    بداية_البيانات: &متجه طبيعي,
    أساس_البيانات: طبيعي,
    رموز_العوام: &متجه اختياري طبيعي
): اختياري طبيعي {
    طابق *الرمز مع
    | مرجع_رمز_كائن.دالة(المعرف) -> { أرجع من_خريطة_ويب_أسمبلي(مواضع_الدوال, المعرف.القيمة); }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> {
        طابق من_خريطة_ويب_أسمبلي(مواضع_المستوردة, المعرف.القيمة) مع
        | اختياري.موجود(م) -> { أرجع اختياري.موجود(أساس_المستوردة + م); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(المعرف) -> {
        طابق من_خريطة_ويب_أسمبلي(مواضع_الدوال, المعرف.الدالة.القيمة) مع
        | اختياري.موجود(م) -> {
            لو (م >= (الطول(*بداية_البيانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(أساس_البيانات + (*بداية_البيانات)[م] + المعرف.القيمة);
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | مرجع_رمز_كائن.عام(المعرف) -> {
        طابق من_خريطة_ويب_أسمبلي(رموز_العوام, المعرف.القيمة) مع
        | اختياري.موجود(م) -> { أرجع اختياري.موجود(أساس_البيانات + م); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// ---------------------------------------------------------------- DWARF --

// One debug-section relocation before encoding (Linking.md reloc entry).
نوع إزاحة_تصحيح_ويب_أسمبلي = {
    الموضع: طبيعي,
    النوع: طبيعي,
    الفهرس: طبيعي,
    الإضافة: عدد
};

// DWARF sections in a fixed order; the code is the position in this order.
عرف عدد_أقسام_دوارف_ويب_أسمبلي(): طبيعي {
    أرجع 13;
}

عرف رمز_قسم_دوارف_ويب_أسمبلي(القسم: قسم_بيانات_دوارف): طبيعي {
    طابق القسم مع
    | قسم_بيانات_دوارف.معلومات -> { أرجع 0; }
    | قسم_بيانات_دوارف.اختصارات -> { أرجع 1; }
    | قسم_بيانات_دوارف.سطور -> { أرجع 2; }
    | قسم_بيانات_دوارف.سلاسل_سطور -> { أرجع 3; }
    | قسم_بيانات_دوارف.سلاسل -> { أرجع 4; }
    | قسم_بيانات_دوارف.عناوين -> { أرجع 5; }
    | قسم_بيانات_دوارف.مواقع -> { أرجع 6; }
    | قسم_بيانات_دوارف.قوائم_مواقع -> { أرجع 7; }
    | قسم_بيانات_دوارف.إطار -> { أرجع 8; }
    | قسم_بيانات_دوارف.نطاقات_عناوين -> { أرجع 9; }
    | قسم_بيانات_دوارف.قوائم_نطاقات -> { أرجع 10; }
    | قسم_بيانات_دوارف.أسماء_عامة -> { أرجع 11; }
    | قسم_بيانات_دوارف.فهرس_أسماء -> { أرجع 12; };
}

عرف رمز_قسم_عنوان_دوارف_ويب_أسمبلي(القسم: قسم_عنوان_دوارف): طبيعي {
    طابق القسم مع
    | قسم_عنوان_دوارف.معلومات -> { أرجع 0; }
    | قسم_عنوان_دوارف.سطور -> { أرجع 2; }
    | قسم_عنوان_دوارف.عناوين -> { أرجع 5; }
    | قسم_عنوان_دوارف.مواقع -> { أرجع 6; }
    | قسم_عنوان_دوارف.قوائم_مواقع -> { أرجع 7; }
    | قسم_عنوان_دوارف.إطار -> { أرجع 8; }
    | قسم_عنوان_دوارف.نطاقات_عناوين -> { أرجع 9; }
    | قسم_عنوان_دوارف.قوائم_نطاقات -> { أرجع 10; };
}

عرف اسم_قسم_دوارف_ويب_أسمبلي(الرمز: طبيعي): نص {
    لو (الرمز == 0) { أرجع «.debug_info»; };
    لو (الرمز == 1) { أرجع «.debug_abbrev»; };
    لو (الرمز == 2) { أرجع «.debug_line»; };
    لو (الرمز == 3) { أرجع «.debug_line_str»; };
    لو (الرمز == 4) { أرجع «.debug_str»; };
    لو (الرمز == 5) { أرجع «.debug_addr»; };
    لو (الرمز == 6) { أرجع «.debug_loc»; };
    لو (الرمز == 7) { أرجع «.debug_loclists»; };
    لو (الرمز == 8) { أرجع «.debug_frame»; };
    لو (الرمز == 9) { أرجع «.debug_aranges»; };
    لو (الرمز == 10) { أرجع «.debug_rnglists»; };
    لو (الرمز == 11) { أرجع «.debug_pubnames»; };
    أرجع «.debug_names»;
}

عرف طول_قسم_دوارف_ويب_أسمبلي(الحزمة: &حزمة_دوارف, الرمز: طبيعي): طبيعي {
    لو (الرمز == 0) { أرجع الطول((*الحزمة).معلومات) مثل طبيعي; };
    لو (الرمز == 1) { أرجع الطول((*الحزمة).اختصارات) مثل طبيعي; };
    لو (الرمز == 2) { أرجع الطول((*الحزمة).سطور) مثل طبيعي; };
    لو (الرمز == 3) { أرجع الطول((*الحزمة).سلاسل_سطور) مثل طبيعي; };
    لو (الرمز == 4) { أرجع الطول((*الحزمة).سلاسل) مثل طبيعي; };
    لو (الرمز == 5) { أرجع الطول((*الحزمة).عناوين) مثل طبيعي; };
    لو (الرمز == 6) { أرجع الطول((*الحزمة).مواقع) مثل طبيعي; };
    لو (الرمز == 7) { أرجع الطول((*الحزمة).قوائم_مواقع) مثل طبيعي; };
    لو (الرمز == 8) { أرجع الطول((*الحزمة).إطار) مثل طبيعي; };
    لو (الرمز == 9) { أرجع الطول((*الحزمة).نطاقات_عناوين) مثل طبيعي; };
    لو (الرمز == 10) { أرجع الطول((*الحزمة).قوائم_نطاقات) مثل طبيعي; };
    لو (الرمز == 11) { أرجع الطول((*الحزمة).أسماء_عامة) مثل طبيعي; };
    أرجع الطول((*الحزمة).فهرس_أسماء) مثل طبيعي;
}

عرف بايتات_قسم_دوارف_ويب_أسمبلي(الحزمة: &حزمة_دوارف, الرمز: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    لو (الرمز == 0) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).معلومات); }
    وإلا لو (الرمز == 1) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).اختصارات); }
    وإلا لو (الرمز == 2) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).سطور); }
    وإلا لو (الرمز == 3) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).سلاسل_سطور); }
    وإلا لو (الرمز == 4) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).سلاسل); }
    وإلا لو (الرمز == 5) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).عناوين); }
    وإلا لو (الرمز == 6) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).مواقع); }
    وإلا لو (الرمز == 7) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).قوائم_مواقع); }
    وإلا لو (الرمز == 8) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).إطار); }
    وإلا لو (الرمز == 9) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).نطاقات_عناوين); }
    وإلا لو (الرمز == 10) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).قوائم_نطاقات); }
    وإلا لو (الرمز == 11) { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).أسماء_عامة); }
    وإلا { ألحق_بايتات_ويب_أسمبلي(&متغير الناتج, &(*الحزمة).فهرس_أسماء); };
    أرجع الناتج;
}

// The range [start, end] (inclusive end: a DWARF end address) containing
// the address, by binary search over ascending starts.
عرف مدى_يحوي_ويب_أسمبلي(
    البدايات: &متجه طبيعي,
    النهايات: &متجه طبيعي,
    العنوان: طبيعي
): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*البدايات) مثل طبيعي;
    لو (العدد == 0) { أرجع اختياري.لا_شيء(); };
    لو ((*البدايات)[0] > العنوان) { أرجع اختياري.لا_شيء(); };
    // Largest index whose start is <= the address.
    دع الأدنى: متغير طبيعي = 0;
    دع الأعلى: متغير طبيعي = العدد - 1;
    طالما (الأدنى < الأعلى) {
        دع الوسط: طبيعي = الأدنى + (الأعلى - الأدنى + 1) / 2;
        لو ((*البدايات)[الوسط] <= العنوان) { الأدنى := الوسط; } وإلا { الأعلى := الوسط - 1; };
    }
    لو (العنوان > (*النهايات)[الأدنى]) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الأدنى);
}

عرف اكتب_كلمة_تصحيح_ويب_أسمبلي(البايتات: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = القيمة % 4294967296;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        (*البايتات)[الموضع + ف] := (الباقي % 256) مثل ط8;
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

// Relocations of one section must be in offset order (wasm-ld rejects
// others). The DWARF producer records address and section fields in two
// lists, so the merged list is sorted here (stable bottom-up merge sort).
عرف رتب_إزاحات_تصحيح_ويب_أسمبلي(الإزاحات: &متجه إزاحة_تصحيح_ويب_أسمبلي): متجه إزاحة_تصحيح_ويب_أسمبلي {
    دع العدد: طبيعي = الطول(*الإزاحات) مثل طبيعي;
    دع الحالية: متغير متجه إزاحة_تصحيح_ويب_أسمبلي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الحالية, (*الإزاحات)[ف]); ف := ف + 1; }
    دع العرض: متغير طبيعي = 1;
    طالما (العرض < العدد) {
        دع الناتج: متغير متجه إزاحة_تصحيح_ويب_أسمبلي = [];
        دع البداية: متغير طبيعي = 0;
        طالما (البداية < العدد) {
            دع الوسط: متغير طبيعي = البداية + العرض;
            لو (الوسط > العدد) { الوسط := العدد; };
            دع النهاية: متغير طبيعي = البداية + 2 * العرض;
            لو (النهاية > العدد) { النهاية := العدد; };
            دع أ: متغير طبيعي = البداية;
            دع ب: متغير طبيعي = الوسط;
            طالما (أ < الوسط || ب < النهاية) {
                دع من_الأول: متغير منطقي = خطأ;
                لو (ب >= النهاية) { من_الأول := صواب; }
                وإلا لو (أ < الوسط) {
                    لو (الحالية[أ].الموضع <= الحالية[ب].الموضع) { من_الأول := صواب; };
                };
                لو (من_الأول) { ألحق(الناتج, الحالية[أ]); أ := أ + 1; }
                وإلا { ألحق(الناتج, الحالية[ب]); ب := ب + 1; };
            }
            البداية := النهاية;
        }
        الحالية := الناتج;
        العرض := العرض * 2;
    }
    أرجع الحالية;
}
