استورد compiler.backend.architectures.wasm32.encoder;
استورد compiler.backend.architectures.wasm32.encoded_code;
استورد compiler.backend.object.object_reference_model;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.msir.identifiers;
استورد std.text.from_bytes;

// WebAssembly relocatable object writer for the native wasm32 path: the
// format wasm-ld consumes, as specified by the WebAssembly tool conventions
// (Linking.md) and produced by LLVM for the same target. One module holds
// the type, import, function, code and data sections, then the custom
// `linking` (symbol table, segment info, init functions), `reloc.CODE`,
// `reloc.DATA` and `target_features` sections. Every function, data object,
// the shadow-stack pointer, the indirect function table and __heap_base are
// symbols; the linker assigns all final indices and addresses.

عام نوع دالة_مستوردة_ويب_أسمبلي = {
    المعرف: معرف_دالة_خارجية_منتقاة,
    الوحدة: متجه غ8,
    الاسم: متجه غ8,
    التوقيع: غير_موقع,
    // A host import named by the target (WASI) carries its import name
    // explicitly; otherwise the symbol name is the import field name.
    اسم_صريح: منطقي
};

عام نوع وحدة_ويب_أسمبلي_للكتابة = {
    التواقيع: سجل_تواقيع_ويب_أسمبلي,
    المستوردة: متجه دالة_مستوردة_ويب_أسمبلي,
    الدوال: متجه دالة_ويب_أسمبلي_مشفرة,
    المرفقات: مرفقات_كائن_مشفرة,
    // The language entry exported under the process-start name when the
    // object has no separate `_start` wrapper.
    الدخول_المصدر: اختيار معرف_دالة_منتقاة
};

عام نوع خطأ_كائن_ويب_أسمبلي =
    | رمز_غير_محلول بنوع مرجع_رمز_كائن
    | إضافة_غير_صالحة بنوع مرجع_رمز_كائن
    | إزاحة_بيانات_غير_صالحة بنوع معرف_عام_مسير
    | توقيع_غير_صالح بنوع غير_موقع
;

// ------------------------------------------------------------- encoding --

عرف ألحق_قسم_ويب_أسمبلي(الملف: &متغير متجه غ8, الرمز: غير_موقع, المحتوى: &متجه غ8): فراغ {
    ألحق_بايت_ويب_أسمبلي(الملف, الرمز);
    ألحق_ليب_ويب_أسمبلي(الملف, الطول(*المحتوى) مثل غير_موقع);
    ألحق_بايتات_ويب_أسمبلي(الملف, المحتوى);
}

عرف ألحق_قسم_مخصص_ويب_أسمبلي(الملف: &متغير متجه غ8, الاسم: &متجه غ8, المحتوى: &متجه غ8): فراغ {
    دع الحمولة: متغير متجه غ8 = [];
    ألحق_اسم_ويب_أسمبلي(&متغير الحمولة, الاسم);
    ألحق_بايتات_ويب_أسمبلي(&متغير الحمولة, المحتوى);
    ألحق_قسم_ويب_أسمبلي(الملف, 0, &الحمولة);
}

عرف ألحق_قسم_فرعي_ويب_أسمبلي(الملف: &متغير متجه غ8, الرمز: غير_موقع, المحتوى: &متجه غ8): فراغ {
    ألحق_قسم_ويب_أسمبلي(الملف, الرمز, المحتوى);
}

عرف بايتات_نص_ويب_أسمبلي(النص: نص): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        ألحق(الناتج, النص[ف] مثل غ8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ألحق_ست_عشري_ويب_أسمبلي(الناتج: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الأرقام: متجه غ8 = بايتات_من_نص(«0123456789abcdef»);
    دع ف: متغير غير_موقع = 16;
    بينما (ف > 0) {
        ف := ف - 1;
        دع الباقي: متغير غير_موقع = القيمة;
        دع س: متغير غير_موقع = 0;
        بينما (س < ف) { الباقي := الباقي / 16; س := س + 1; }
        ألحق(*الناتج, الأرقام[الباقي % 16]);
    }
}

// Symbol names mirror the LLVM provider's spelling for the same entities.
عرف اسم_دالة_ويب_أسمبلي(المعرف: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بايتات_نص_ويب_أسمبلي(«sultanc_fn_»);
    ألحق_ست_عشري_ويب_أسمبلي(&متغير الاسم, المعرف);
    أرجع الاسم;
}

عرف اسم_بيانات_ثابتة_ويب_أسمبلي(الدالة: غير_موقع, القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بايتات_نص_ويب_أسمبلي(«sultanc_data_»);
    ألحق_ست_عشري_ويب_أسمبلي(&متغير الاسم, الدالة);
    ألحق(الاسم, 0x5F);
    ألحق_ست_عشري_ويب_أسمبلي(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عرف اسم_عام_ويب_أسمبلي(المعرف: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بايتات_نص_ويب_أسمبلي(«sultanc_global_»);
    ألحق_ست_عشري_ويب_أسمبلي(&متغير الاسم, المعرف);
    أرجع الاسم;
}

عرف لوغ_محاذاة_ويب_أسمبلي(المحاذاة: غير_موقع): غير_موقع {
    دع اللوغ: متغير غير_موقع = 0;
    دع القيمة: متغير غير_موقع = 1;
    بينما (القيمة < المحاذاة && اللوغ < 31) { القيمة := القيمة * 2; اللوغ := اللوغ + 1; }
    أرجع اللوغ;
}

عرف حاذ_ويب_أسمبلي(القيمة: غير_موقع, المحاذاة: غير_موقع): غير_موقع {
    لو (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + المحاذاة - الباقي;
}

// --------------------------------------------------------------- tables --

نوع رمز_بيانات_ويب_أسمبلي = {
    الاسم: متجه غ8,
    القطعة: غير_موقع,
    الحجم: غير_موقع
};

نوع قطعة_بيانات_ويب_أسمبلي = {
    الاسم: متجه غ8,
    المحاذاة: غير_موقع,
    البايتات: متجه غ8,
    // Relocations inside this segment: (offset in segment, symbol, type, addend).
    الإزاحات: متجه طلب_إزاحة_بيانات_كائن
};

عرف ضع_في_خريطة_ويب_أسمبلي(الخريطة: &متغير متجه اختيار غير_موقع, المفتاح: غير_موقع, القيمة: غير_موقع): فراغ {
    بينما ((الطول(*الخريطة) مثل غير_موقع) <= المفتاح) { ألحق(*الخريطة, اختيار.لا_شيء()); }
    (*الخريطة)[المفتاح] := اختيار.بعض(القيمة);
}

عرف من_خريطة_ويب_أسمبلي(الخريطة: &متجه اختيار غير_موقع, المفتاح: غير_موقع): اختيار غير_موقع {
    لو (المفتاح >= (الطول(*الخريطة) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*الخريطة)[المفتاح];
}

// ----------------------------------------------------------------- write --

عام عرف اكتب_كائن_ويب_أسمبلي(
    الوحدة: &وحدة_ويب_أسمبلي_للكتابة
): نتيجة متجه غ8, خطأ_كائن_ويب_أسمبلي {
    دع عدد_الدوال: غير_موقع = الطول((*الوحدة).الدوال) مثل غير_موقع;
    دع عدد_التواقيع: غير_موقع = الطول((*الوحدة).التواقيع.التواقيع) مثل غير_موقع;

    // Defined functions and the imports actually referenced.
    دع مواضع_الدوال: متغير متجه اختيار غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الدوال) {
        طابق (*الوحدة).الدوال[ف].الهوية مع
        | هوية_دالة_ويب_أسمبلي.مسير(المعرف) -> { ضع_في_خريطة_ويب_أسمبلي(&متغير مواضع_الدوال, المعرف.القيمة, ف); }
        | _ -> { };
        لو ((*الوحدة).الدوال[ف].التوقيع >= عدد_التواقيع) {
            أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.توقيع_غير_صالح((*الوحدة).الدوال[ف].التوقيع));
        };
        ف := ف + 1;
    }
    // External function id -> its declaration position (direct lookup).
    دع مستخدمة: متغير متجه منطقي = [];
    دع مواضع_الإعلانات: متغير متجه اختيار غير_موقع = [];
    ف := 0;
    بينما (ف < (الطول((*الوحدة).المستوردة) مثل غير_موقع)) {
        ألحق(مستخدمة, خطأ);
        ضع_في_خريطة_ويب_أسمبلي(&متغير مواضع_الإعلانات, (*الوحدة).المستوردة[ف].المعرف.القيمة, ف);
        ف := ف + 1;
    }
    دع يحتاج_المكدس: متغير منطقي = خطأ;
    دع يحتاج_الجدول: متغير منطقي = خطأ;
    دع يحتاج_قاعدة_الكومة: متغير منطقي = خطأ;
    ف := 0;
    بينما (ف < عدد_الدوال) {
        دع ر: متغير غير_موقع = 0;
        بينما (ر < (الطول((*الوحدة).الدوال[ف].الإزاحات) مثل غير_موقع)) {
            طابق (*الوحدة).الدوال[ف].الإزاحات[ر].الهدف مع
            | هدف_إزاحة_ويب_أسمبلي.مؤشر_المكدس -> { يحتاج_المكدس := صواب; }
            | هدف_إزاحة_ويب_أسمبلي.جدول_الدوال -> { يحتاج_الجدول := صواب; }
            | هدف_إزاحة_ويب_أسمبلي.قاعدة_الكومة -> { يحتاج_قاعدة_الكومة := صواب; }
            | هدف_إزاحة_ويب_أسمبلي.رمز(مرجع_رمز_كائن.رمز_خارجي(المعرف)) -> {
                طابق من_خريطة_ويب_أسمبلي(&مواضع_الإعلانات, المعرف.القيمة) مع
                | اختيار.بعض(م) -> { مستخدمة[م] := صواب; }
                | اختيار.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(مرجع_رمز_كائن.رمز_خارجي(المعرف)));
                };
            }
            | _ -> { };
            ر := ر + 1;
        }
        ف := ف + 1;
    }
    دع المستوردة_المستخدمة: متغير متجه غير_موقع = [];
    دع مواضع_المستوردة: متغير متجه اختيار غير_موقع = [];
    ف := 0;
    بينما (ف < (الطول((*الوحدة).المستوردة) مثل غير_موقع)) {
        لو (مستخدمة[ف]) {
            لو ((*الوحدة).المستوردة[ف].التوقيع >= عدد_التواقيع) {
                أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.توقيع_غير_صالح((*الوحدة).المستوردة[ف].التوقيع));
            };
            // Declarations of one host function (same module and name) share
            // one import, as the linker requires; their signatures must agree.
            دع الموضع: متغير غير_موقع = الطول(المستوردة_المستخدمة) مثل غير_موقع;
            دع م: متغير غير_موقع = 0;
            بينما (م < (الطول(المستوردة_المستخدمة) مثل غير_موقع)) {
                دع السابقة: &دالة_مستوردة_ويب_أسمبلي = &(*الوحدة).المستوردة[المستوردة_المستخدمة[م]];
                لو (اسما_رمز_خارجي_كائن_متساويان(&(*السابقة).الاسم, &(*الوحدة).المستوردة[ف].الاسم)
                    && اسما_رمز_خارجي_كائن_متساويان(&(*السابقة).الوحدة, &(*الوحدة).المستوردة[ف].الوحدة)) {
                    لو ((*السابقة).التوقيع != (*الوحدة).المستوردة[ف].التوقيع) {
                        أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.توقيع_غير_صالح((*الوحدة).المستوردة[ف].التوقيع));
                    };
                    الموضع := م;
                };
                م := م + 1;
            }
            ضع_في_خريطة_ويب_أسمبلي(&متغير مواضع_المستوردة, (*الوحدة).المستوردة[ف].المعرف.القيمة, الموضع);
            لو (الموضع == (الطول(المستوردة_المستخدمة) مثل غير_موقع)) {
                ألحق(المستوردة_المستخدمة, ف);
            };
        };
        ف := ف + 1;
    }
    دع عدد_المستوردة: غير_موقع = الطول(المستوردة_المستخدمة) مثل غير_موقع;

    // Data symbols: per-function static data, then globals, then external
    // data names; each defined datum is its own segment.
    دع القطع: متغير متجه قطعة_بيانات_ويب_أسمبلي = [];
    دع رموز_البيانات: متغير متجه رمز_بيانات_ويب_أسمبلي = [];
    دع بداية_البيانات: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف < عدد_الدوال) {
        ألحق(بداية_البيانات, الطول(رموز_البيانات) مثل غير_موقع);
        دع م: متغير غير_موقع = 0;
        بينما (م < (الطول((*الوحدة).الدوال[ف].البيانات_الثابتة) مثل غير_موقع)) {
            دع البيان: &بيانات_ثابتة_كائن = &(*الوحدة).الدوال[ف].البيانات_الثابتة[م];
            لو ((*البيان).المعرف.القيمة != م) {
                أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(
                    مرجع_رمز_كائن.بيانات_ثابتة(انسخ_معرف_بيانات_ثابتة_كائن(&(*البيان).المعرف))));
            };
            دع الاسم: متجه غ8 = اسم_بيانات_ثابتة_ويب_أسمبلي((*البيان).المعرف.الدالة.القيمة, م);
            دع اسم_القطعة: متغير متجه غ8 = بايتات_نص_ويب_أسمبلي(«.rodata.»);
            ألحق_بايتات_ويب_أسمبلي(&متغير اسم_القطعة, &الاسم);
            دع بلا_إزاحات: متجه طلب_إزاحة_بيانات_كائن = [];
            دع البايتات: متغير متجه غ8 = [];
            ألحق_بايتات_ويب_أسمبلي(&متغير البايتات, &(*البيان).البيانات);
            دع القطعة: قطعة_بيانات_ويب_أسمبلي = {
                الاسم: اسم_القطعة, المحاذاة: (*البيان).المحاذاة,
                البايتات: البايتات, الإزاحات: بلا_إزاحات
            };
            دع الرمز: رمز_بيانات_ويب_أسمبلي = {
                الاسم: الاسم, القطعة: الطول(القطع) مثل غير_موقع,
                الحجم: الطول((*البيان).البيانات) مثل غير_موقع
            };
            ألحق(القطع, القطعة);
            ألحق(رموز_البيانات, الرمز);
            م := م + 1;
        }
        ف := ف + 1;
    }
    دع رموز_العوام: متغير متجه اختيار غير_موقع = [];
    ف := 0;
    بينما (ف < (الطول((*الوحدة).المرفقات.البيانات_العامة) مثل غير_موقع)) {
        دع العام: &بيانات_عام_كائن = &(*الوحدة).المرفقات.البيانات_العامة[ف];
        دع الاسم: متجه غ8 = اسم_عام_ويب_أسمبلي((*العام).المعرف.القيمة);
        دع اسم_القطعة: متغير متجه غ8 = [];
        لو ((*العام).قابل_للكتابة) { اسم_القطعة := بايتات_نص_ويب_أسمبلي(«.data.»); }
        وإلا { اسم_القطعة := بايتات_نص_ويب_أسمبلي(«.rodata.»); };
        ألحق_بايتات_ويب_أسمبلي(&متغير اسم_القطعة, &الاسم);
        دع البايتات: متغير متجه غ8 = [];
        ألحق_بايتات_ويب_أسمبلي(&متغير البايتات, &(*العام).البيانات);
        دع الطلبات: متغير متجه طلب_إزاحة_بيانات_كائن = [];
        دع ط: متغير غير_موقع = 0;
        بينما (ط < (الطول((*العام).الإزاحات) مثل غير_موقع)) {
            دع الأصل: &طلب_إزاحة_بيانات_كائن = &(*العام).الإزاحات[ط];
            دع الطلب: طلب_إزاحة_بيانات_كائن = {
                الموضع: (*الأصل).الموضع,
                الرمز: انسخ_مرجع_رمز_كائن(&(*الأصل).الرمز),
                الإضافة: (*الأصل).الإضافة
            };
            ألحق(الطلبات, الطلب);
            ط := ط + 1;
        }
        دع القطعة: قطعة_بيانات_ويب_أسمبلي = {
            الاسم: اسم_القطعة, المحاذاة: (*العام).المحاذاة,
            البايتات: البايتات, الإزاحات: الطلبات
        };
        دع الرمز: رمز_بيانات_ويب_أسمبلي = {
            الاسم: الاسم, القطعة: الطول(القطع) مثل غير_موقع,
            الحجم: الطول((*العام).البيانات) مثل غير_موقع
        };
        ضع_في_خريطة_ويب_أسمبلي(&متغير رموز_العوام, (*العام).المعرف.القيمة, الطول(رموز_البيانات) مثل غير_موقع);
        ألحق(القطع, القطعة);
        ألحق(رموز_البيانات, الرمز);
        ف := ف + 1;
    }
    دع عدد_البيانات_المعرفة: غير_موقع = الطول(رموز_البيانات) مثل غير_موقع;
    دع رموز_بيانات_خارجية: متغير متجه متجه غ8 = [];
    ف := 0;
    بينما (ف < (الطول((*الوحدة).المرفقات.البيانات_الخارجية) مثل غير_موقع)) {
        دع البيان: &بيانات_خارجية_كائن = &(*الوحدة).المرفقات.البيانات_الخارجية[ف];
        ضع_في_خريطة_ويب_أسمبلي(&متغير رموز_العوام, (*البيان).المعرف.القيمة,
            عدد_البيانات_المعرفة + (الطول(رموز_بيانات_خارجية) مثل غير_موقع));
        ألحق(رموز_بيانات_خارجية, انسخ_اسم_رمز_خارجي_كائن(&(*البيان).الاسم));
        ف := ف + 1;
    }

    // Symbol index layout: defined functions, imported functions, defined
    // data, external data, then __heap_base, __stack_pointer and the table.
    دع أساس_المستوردة: غير_موقع = عدد_الدوال;
    دع أساس_البيانات: غير_موقع = أساس_المستوردة + عدد_المستوردة;
    دع التالي: متغير غير_موقع = أساس_البيانات + عدد_البيانات_المعرفة + (الطول(رموز_بيانات_خارجية) مثل غير_موقع);
    دع رمز_قاعدة_الكومة: غير_موقع = التالي;
    لو (يحتاج_قاعدة_الكومة) { التالي := التالي + 1; };
    دع رمز_المكدس: غير_موقع = التالي;
    لو (يحتاج_المكدس) { التالي := التالي + 1; };
    دع رمز_الجدول: غير_موقع = التالي;
    لو (يحتاج_الجدول) { التالي := التالي + 1; };
    دع عدد_الرموز: غير_موقع = التالي;

    // ---- type section
    دع قسم_الأنواع: متغير متجه غ8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الأنواع, عدد_التواقيع);
    ف := 0;
    بينما (ف < عدد_التواقيع) {
        دع التوقيع: &توقيع_ويب_أسمبلي = &(*الوحدة).التواقيع.التواقيع[ف];
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الأنواع, 0x60);
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الأنواع, الطول((*التوقيع).المعاملات) مثل غير_موقع);
        دع م: متغير غير_موقع = 0;
        بينما (م < (الطول((*التوقيع).المعاملات) مثل غير_موقع)) {
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_الأنواع, رمز_نوع_قيمة_ويب_أسمبلي((*التوقيع).المعاملات[م]));
            م := م + 1;
        }
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الأنواع, الطول((*التوقيع).النواتج) مثل غير_موقع);
        م := 0;
        بينما (م < (الطول((*التوقيع).النواتج) مثل غير_موقع)) {
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_الأنواع, رمز_نوع_قيمة_ويب_أسمبلي((*التوقيع).النواتج[م]));
            م := م + 1;
        }
        ف := ف + 1;
    }

    // ---- data layout (segment offsets are provisional; the linker places them)
    دع إزاحات_القطع: متغير متجه غير_موقع = [];
    دع حجم_البيانات: متغير غير_موقع = 0;
    ف := 0;
    بينما (ف < (الطول(القطع) مثل غير_موقع)) {
        حجم_البيانات := حاذ_ويب_أسمبلي(حجم_البيانات, القطع[ف].المحاذاة);
        ألحق(إزاحات_القطع, حجم_البيانات);
        حجم_البيانات := حجم_البيانات + (الطول(القطع[ف].البايتات) مثل غير_موقع);
        ف := ف + 1;
    }

    // ---- import section
    دع الوحدة_البيئية: متجه غ8 = بايتات_نص_ويب_أسمبلي(«env»);
    دع قسم_الاستيراد: متغير متجه غ8 = [];
    دع عدد_الاستيرادات: متغير غير_موقع = 1 + عدد_المستوردة;
    لو (يحتاج_المكدس) { عدد_الاستيرادات := عدد_الاستيرادات + 1; };
    لو (يحتاج_الجدول) { عدد_الاستيرادات := عدد_الاستيرادات + 1; };
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, عدد_الاستيرادات);
    دع اسم_الذاكرة: متجه غ8 = بايتات_نص_ويب_أسمبلي(«__linear_memory»);
    ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الوحدة_البيئية);
    ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_الذاكرة);
    ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x02); // memory
    ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x00); // limits: min only
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, (حجم_البيانات + 65535) / 65536);
    لو (يحتاج_المكدس) {
        دع اسم_المكدس: متجه غ8 = بايتات_نص_ويب_أسمبلي(«__stack_pointer»);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الوحدة_البيئية);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_المكدس);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x03); // global
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x7F); // i32
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x01); // mutable
    };
    ف := 0;
    بينما (ف < عدد_المستوردة) {
        دع المستوردة: &دالة_مستوردة_ويب_أسمبلي = &(*الوحدة).المستوردة[المستوردة_المستخدمة[ف]];
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &(*المستوردة).الوحدة);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &(*المستوردة).الاسم);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x00); // function
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, (*المستوردة).التوقيع);
        ف := ف + 1;
    }
    لو (يحتاج_الجدول) {
        دع اسم_الجدول: متجه غ8 = بايتات_نص_ويب_أسمبلي(«__indirect_function_table»);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الوحدة_البيئية);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_الجدول);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x01); // table
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x70); // funcref
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x00); // limits: min only
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, 0);
    };

    // ---- function section
    دع قسم_الدوال: متغير متجه غ8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الدوال, عدد_الدوال);
    ف := 0;
    بينما (ف < عدد_الدوال) {
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الدوال, (*الوحدة).الدوال[ف].التوقيع);
        ف := ف + 1;
    }

    // ---- code section, with its relocations resolved to symbol indices
    دع قسم_الشفرة: متغير متجه غ8 = [];
    دع إزاحات_الشفرة: متغير متجه غ8 = [];
    دع عدد_إزاحات_الشفرة: متغير غير_موقع = 0;
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الشفرة, عدد_الدوال);
    ف := 0;
    بينما (ف < عدد_الدوال) {
        دع الدالة: &دالة_ويب_أسمبلي_مشفرة = &(*الوحدة).الدوال[ف];
        دع المحليات: متغير متجه غ8 = [];
        دع المجموعات: متغير غير_موقع = 0;
        دع ترميز_المجموعات: متغير متجه غ8 = [];
        دع م: متغير غير_موقع = 0;
        بينما (م < (الطول((*الدالة).المحليات) مثل غير_موقع)) {
            دع النوع: نوع_قيمة_ويب_أسمبلي = (*الدالة).المحليات[م];
            دع العدد: متغير غير_موقع = 1;
            بينما (م + العدد < (الطول((*الدالة).المحليات) مثل غير_موقع)
                && نوعا_قيمة_ويب_أسمبلي_متساويان((*الدالة).المحليات[م + العدد], النوع)) {
                العدد := العدد + 1;
            }
            ألحق_ليب_ويب_أسمبلي(&متغير ترميز_المجموعات, العدد);
            ألحق_بايت_ويب_أسمبلي(&متغير ترميز_المجموعات, رمز_نوع_قيمة_ويب_أسمبلي(النوع));
            المجموعات := المجموعات + 1;
            م := م + العدد;
        }
        ألحق_ليب_ويب_أسمبلي(&متغير المحليات, المجموعات);
        ألحق_بايتات_ويب_أسمبلي(&متغير المحليات, &ترميز_المجموعات);
        دع الحجم: غير_موقع = (الطول(المحليات) مثل غير_موقع) + (الطول((*الدالة).الشفرة) مثل غير_موقع);
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الشفرة, الحجم);
        ألحق_بايتات_ويب_أسمبلي(&متغير قسم_الشفرة, &المحليات);
        دع الأساس: غير_موقع = الطول(قسم_الشفرة) مثل غير_موقع;
        ألحق_بايتات_ويب_أسمبلي(&متغير قسم_الشفرة, &(*الدالة).الشفرة);
        دع ر: متغير غير_موقع = 0;
        بينما (ر < (الطول((*الدالة).الإزاحات) مثل غير_موقع)) {
            دع الإزاحة: &إزاحة_شفرة_ويب_أسمبلي = &(*الدالة).الإزاحات[ر];
            دع رمز_النوع: غير_موقع;
            طابق (*الإزاحة).النوع مع
            | نوع_إزاحة_ويب_أسمبلي.فهرس_دالة -> { رمز_النوع := 0; }
            | نوع_إزاحة_ويب_أسمبلي.فهرس_جدول_موقع -> { رمز_النوع := 1; }
            | نوع_إزاحة_ويب_أسمبلي.عنوان_ذاكرة_موقع -> { رمز_النوع := 4; }
            | نوع_إزاحة_ويب_أسمبلي.فهرس_نوع -> { رمز_النوع := 6; }
            | نوع_إزاحة_ويب_أسمبلي.فهرس_عام -> { رمز_النوع := 7; }
            | نوع_إزاحة_ويب_أسمبلي.رقم_جدول -> { رمز_النوع := 20; };
            دع الفهرس: غير_موقع;
            طابق (*الإزاحة).الهدف مع
            | هدف_إزاحة_ويب_أسمبلي.مؤشر_المكدس -> { الفهرس := رمز_المكدس; }
            | هدف_إزاحة_ويب_أسمبلي.جدول_الدوال -> { الفهرس := رمز_الجدول; }
            | هدف_إزاحة_ويب_أسمبلي.قاعدة_الكومة -> { الفهرس := رمز_قاعدة_الكومة; }
            | هدف_إزاحة_ويب_أسمبلي.توقيع(التوقيع) -> {
                لو (التوقيع >= عدد_التواقيع) { أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.توقيع_غير_صالح(التوقيع)); };
                الفهرس := التوقيع;
            }
            | هدف_إزاحة_ويب_أسمبلي.رمز(الرمز) -> {
                طابق فهرس_رمز_مرجع_ويب_أسمبلي(&الرمز, &مواضع_الدوال, &مواضع_المستوردة, أساس_المستوردة,
                    &بداية_البيانات, أساس_البيانات, &رموز_العوام) مع
                | اختيار.بعض(ق) -> { الفهرس := ق; }
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(الرمز)); };
            };
            // The slot also holds the provisional value (as LLVM writes it),
            // so the object is a valid module before linking.
            دع المؤقت: عدد = قيمة_مؤقتة_رمز_ويب_أسمبلي(
                رمز_النوع, الفهرس, عدد_الدوال, عدد_المستوردة, أساس_البيانات,
                &رموز_البيانات, &إزاحات_القطع
            ) + (*الإزاحة).الإضافة;
            لو (رمز_النوع == 4 || رمز_النوع == 1) {
                اكتب_سليب_مبطن_ويب_أسمبلي_عند(&متغير قسم_الشفرة, الأساس + (*الإزاحة).الموضع, المؤقت);
            } وإلا {
                اكتب_ليب_مبطن_ويب_أسمبلي_عند(&متغير قسم_الشفرة, الأساس + (*الإزاحة).الموضع, المؤقت مثل غير_موقع);
            };
            ألحق_بايت_ويب_أسمبلي(&متغير إزاحات_الشفرة, رمز_النوع);
            ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_الشفرة, الأساس + (*الإزاحة).الموضع);
            ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_الشفرة, الفهرس);
            لو (رمز_النوع == 4) { ألحق_سليب_ويب_أسمبلي(&متغير إزاحات_الشفرة, (*الإزاحة).الإضافة); };
            عدد_إزاحات_الشفرة := عدد_إزاحات_الشفرة + 1;
            ر := ر + 1;
        }
        ف := ف + 1;
    }

    // ---- data section and its relocations
    دع قسم_البيانات: متغير متجه غ8 = [];
    دع إزاحات_البيانات: متغير متجه غ8 = [];
    دع عدد_إزاحات_البيانات: متغير غير_موقع = 0;
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, الطول(القطع) مثل غير_موقع);
    ف := 0;
    بينما (ف < (الطول(القطع) مثل غير_موقع)) {
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, 0); // active, memory 0
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_البيانات, 0x41);
        ألحق_سليب_ويب_أسمبلي(&متغير قسم_البيانات, إزاحات_القطع[ف] مثل عدد);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_البيانات, 0x0B);
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, الطول(القطع[ف].البايتات) مثل غير_موقع);
        دع الأساس: غير_موقع = الطول(قسم_البيانات) مثل غير_موقع;
        ألحق_بايتات_ويب_أسمبلي(&متغير قسم_البيانات, &القطع[ف].البايتات);
        دع ر: متغير غير_موقع = 0;
        بينما (ر < (الطول(القطع[ف].الإزاحات) مثل غير_موقع)) {
            دع الطلب: &طلب_إزاحة_بيانات_كائن = &القطع[ف].الإزاحات[ر];
            لو ((*الطلب).الموضع + 4 > (الطول(القطع[ف].البايتات) مثل غير_موقع)) {
                أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(انسخ_مرجع_رمز_كائن(&(*الطلب).الرمز)));
            };
            دع الفهرس: غير_موقع;
            طابق فهرس_رمز_مرجع_ويب_أسمبلي(&(*الطلب).الرمز, &مواضع_الدوال, &مواضع_المستوردة, أساس_المستوردة,
                &بداية_البيانات, أساس_البيانات, &رموز_العوام) مع
            | اختيار.بعض(ق) -> { الفهرس := ق; }
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(انسخ_مرجع_رمز_كائن(&(*الطلب).الرمز))); };
            طابق (*الطلب).الرمز مع
            | مرجع_رمز_كائن.دالة(_) -> {
                // Function addresses in data are table indices.
                لو ((*الطلب).الإضافة != 0) {
                    أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.إضافة_غير_صالحة(انسخ_مرجع_رمز_كائن(&(*الطلب).الرمز)));
                };
                ألحق_بايت_ويب_أسمبلي(&متغير إزاحات_البيانات, 2); // R_WASM_TABLE_INDEX_I32
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_البيانات, الأساس + (*الطلب).الموضع);
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_البيانات, الفهرس);
            }
            | _ -> {
                لو ((*الطلب).الإضافة > 2147483647) {
                    أرجع نتيجة.خطأ(خطأ_كائن_ويب_أسمبلي.إضافة_غير_صالحة(انسخ_مرجع_رمز_كائن(&(*الطلب).الرمز)));
                };
                دع المؤقت: عدد = قيمة_مؤقتة_رمز_ويب_أسمبلي(
                    5, الفهرس, عدد_الدوال, عدد_المستوردة, أساس_البيانات, &رموز_البيانات, &إزاحات_القطع
                ) + ((*الطلب).الإضافة مثل عدد);
                دع ب: متغير غير_موقع = 0;
                دع الباقي: متغير غير_موقع = (المؤقت مثل غير_موقع) % 4294967296;
                بينما (ب < 4) {
                    قسم_البيانات[الأساس + (*الطلب).الموضع + ب] := (الباقي % 256) مثل غ8;
                    الباقي := الباقي / 256;
                    ب := ب + 1;
                }
                ألحق_بايت_ويب_أسمبلي(&متغير إزاحات_البيانات, 5); // R_WASM_MEMORY_ADDR_I32
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_البيانات, الأساس + (*الطلب).الموضع);
                ألحق_ليب_ويب_أسمبلي(&متغير إزاحات_البيانات, الفهرس);
                ألحق_سليب_ويب_أسمبلي(&متغير إزاحات_البيانات, (*الطلب).الإضافة مثل عدد);
            };
            عدد_إزاحات_البيانات := عدد_إزاحات_البيانات + 1;
            ر := ر + 1;
        }
        ف := ف + 1;
    }

    // ---- linking: symbol table
    دع جدول_الرموز: متغير متجه غ8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, عدد_الرموز);
    دع دوال_البدء: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف < عدد_الدوال) {
        دع الدالة: &دالة_ويب_أسمبلي_مشفرة = &(*الوحدة).الدوال[ف];
        دع الاسم: متغير متجه غ8 = [];
        دع الأعلام: متغير غير_موقع = 0;
        طابق (*الدالة).الهوية مع
        | هوية_دالة_ويب_أسمبلي.مسير(المعرف) -> {
            الاسم := اسم_دالة_ويب_أسمبلي(المعرف.القيمة);
            طابق (*الوحدة).الدخول_المصدر مع
            | اختيار.بعض(الدخول) -> {
                لو (الدخول.القيمة == المعرف.القيمة) { الاسم := بايتات_نص_ويب_أسمبلي(«_start»); };
            }
            | اختيار.لا_شيء -> { };
        }
        | هوية_دالة_ويب_أسمبلي.بدء_العملية -> { الاسم := بايتات_نص_ويب_أسمبلي(«_start»); }
        | هوية_دالة_ويب_أسمبلي.منشئ_الوحدة -> {
            الاسم := بايتات_نص_ويب_أسمبلي(«sultanc_module_ctor»);
            الأعلام := 2; // BINDING_LOCAL
            ألحق(دوال_البدء, ف);
        };
        ألحق_بايت_ويب_أسمبلي(&متغير جدول_الرموز, 0); // SYMTAB_FUNCTION
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, الأعلام);
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, عدد_المستوردة + ف);
        ألحق_اسم_ويب_أسمبلي(&متغير جدول_الرموز, &الاسم);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < عدد_المستوردة) {
        دع المستوردة: &دالة_مستوردة_ويب_أسمبلي = &(*الوحدة).المستوردة[المستوردة_المستخدمة[ف]];
        ألحق_بايت_ويب_أسمبلي(&متغير جدول_الرموز, 0);
        لو ((*المستوردة).اسم_صريح) {
            ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0x50); // UNDEFINED | EXPLICIT_NAME
            ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, ف);
            ألحق_اسم_ويب_أسمبلي(&متغير جدول_الرموز, &(*المستوردة).الاسم);
        } وإلا {
            ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0x10);
            ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, ف);
        };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < عدد_البيانات_المعرفة) {
        ألحق_بايت_ويب_أسمبلي(&متغير جدول_الرموز, 1); // SYMTAB_DATA
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0);
        ألحق_اسم_ويب_أسمبلي(&متغير جدول_الرموز, &رموز_البيانات[ف].الاسم);
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, رموز_البيانات[ف].القطعة);
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0);
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, رموز_البيانات[ف].الحجم);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(رموز_بيانات_خارجية) مثل غير_موقع)) {
        ألحق_بايت_ويب_أسمبلي(&متغير جدول_الرموز, 1);
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0x10);
        ألحق_اسم_ويب_أسمبلي(&متغير جدول_الرموز, &رموز_بيانات_خارجية[ف]);
        ف := ف + 1;
    }
    لو (يحتاج_قاعدة_الكومة) {
        دع الاسم: متجه غ8 = بايتات_نص_ويب_أسمبلي(«__heap_base»);
        ألحق_بايت_ويب_أسمبلي(&متغير جدول_الرموز, 1);
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0x10);
        ألحق_اسم_ويب_أسمبلي(&متغير جدول_الرموز, &الاسم);
    };
    لو (يحتاج_المكدس) {
        ألحق_بايت_ويب_أسمبلي(&متغير جدول_الرموز, 2); // SYMTAB_GLOBAL
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0x10);
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0);
    };
    لو (يحتاج_الجدول) {
        ألحق_بايت_ويب_أسمبلي(&متغير جدول_الرموز, 5); // SYMTAB_TABLE
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0x90); // UNDEFINED | NO_STRIP
        ألحق_ليب_ويب_أسمبلي(&متغير جدول_الرموز, 0);
    };

    دع قسم_الربط: متغير متجه غ8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الربط, 2); // linking metadata version
    ألحق_قسم_فرعي_ويب_أسمبلي(&متغير قسم_الربط, 8, &جدول_الرموز);
    لو ((الطول(القطع) مثل غير_موقع) > 0) {
        دع معلومات_القطع: متغير متجه غ8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير معلومات_القطع, الطول(القطع) مثل غير_موقع);
        ف := 0;
        بينما (ف < (الطول(القطع) مثل غير_موقع)) {
            ألحق_اسم_ويب_أسمبلي(&متغير معلومات_القطع, &القطع[ف].الاسم);
            ألحق_ليب_ويب_أسمبلي(&متغير معلومات_القطع, لوغ_محاذاة_ويب_أسمبلي(القطع[ف].المحاذاة));
            ألحق_ليب_ويب_أسمبلي(&متغير معلومات_القطع, 0);
            ف := ف + 1;
        }
        ألحق_قسم_فرعي_ويب_أسمبلي(&متغير قسم_الربط, 5, &معلومات_القطع);
    };
    لو ((الطول(دوال_البدء) مثل غير_موقع) > 0) {
        دع البدء: متغير متجه غ8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير البدء, الطول(دوال_البدء) مثل غير_موقع);
        ف := 0;
        بينما (ف < (الطول(دوال_البدء) مثل غير_موقع)) {
            ألحق_ليب_ويب_أسمبلي(&متغير البدء, 65535);
            ألحق_ليب_ويب_أسمبلي(&متغير البدء, دوال_البدء[ف]);
            ف := ف + 1;
        }
        ألحق_قسم_فرعي_ويب_أسمبلي(&متغير قسم_الربط, 6, &البدء);
    };

    // ---- assemble: section indices are file order (code = 3, data = 4).
    دع الملف: متغير متجه غ8 = [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00];
    ألحق_قسم_ويب_أسمبلي(&متغير الملف, 1, &قسم_الأنواع);
    ألحق_قسم_ويب_أسمبلي(&متغير الملف, 2, &قسم_الاستيراد);
    ألحق_قسم_ويب_أسمبلي(&متغير الملف, 3, &قسم_الدوال);
    ألحق_قسم_ويب_أسمبلي(&متغير الملف, 10, &قسم_الشفرة);
    دع له_بيانات: منطقي = (الطول(القطع) مثل غير_موقع) > 0;
    لو (له_بيانات) { ألحق_قسم_ويب_أسمبلي(&متغير الملف, 11, &قسم_البيانات); };
    دع اسم_الربط: متجه غ8 = بايتات_نص_ويب_أسمبلي(«linking»);
    ألحق_قسم_مخصص_ويب_أسمبلي(&متغير الملف, &اسم_الربط, &قسم_الربط);
    لو (عدد_إزاحات_الشفرة > 0) {
        دع المحتوى: متغير متجه غ8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, 3);
        ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, عدد_إزاحات_الشفرة);
        ألحق_بايتات_ويب_أسمبلي(&متغير المحتوى, &إزاحات_الشفرة);
        دع الاسم: متجه غ8 = بايتات_نص_ويب_أسمبلي(«reloc.CODE»);
        ألحق_قسم_مخصص_ويب_أسمبلي(&متغير الملف, &الاسم, &المحتوى);
    };
    لو (له_بيانات && عدد_إزاحات_البيانات > 0) {
        دع المحتوى: متغير متجه غ8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, 4);
        ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, عدد_إزاحات_البيانات);
        ألحق_بايتات_ويب_أسمبلي(&متغير المحتوى, &إزاحات_البيانات);
        دع الاسم: متجه غ8 = بايتات_نص_ويب_أسمبلي(«reloc.DATA»);
        ألحق_قسم_مخصص_ويب_أسمبلي(&متغير الملف, &الاسم, &المحتوى);
    };
    // The features the generated code uses (sign-ext, bulk memory copy,
    // reference-types table numbers, mutable globals), as LLVM declares them
    // for the same baseline so wasm-ld accepts mixing with LLVM objects.
    دع قسم_الميزات: متغير متجه غ8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الميزات, 8);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «bulk-memory»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «bulk-memory-opt»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «call-indirect-overlong»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «multivalue»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «mutable-globals»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «nontrapping-fptoint»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «reference-types»);
    ألحق_ميزة_ويب_أسمبلي(&متغير قسم_الميزات, «sign-ext»);
    دع اسم_الميزات: متجه غ8 = بايتات_نص_ويب_أسمبلي(«target_features»);
    ألحق_قسم_مخصص_ويب_أسمبلي(&متغير الملف, &اسم_الميزات, &قسم_الميزات);
    أرجع نتيجة.نجح(الملف);
}

عرف ألحق_ميزة_ويب_أسمبلي(القسم: &متغير متجه غ8, الاسم: نص): فراغ {
    ألحق_بايت_ويب_أسمبلي(القسم, 0x2B); // '+': used
    دع البايتات: متجه غ8 = بايتات_نص_ويب_أسمبلي(الاسم);
    ألحق_اسم_ويب_أسمبلي(القسم, &البايتات);
}

// The provisional value of a relocated field: the module index of a function,
// global (0), table (0) or type, or the provisional address of defined data.
عرف قيمة_مؤقتة_رمز_ويب_أسمبلي(
    النوع: غير_موقع,
    الفهرس: غير_موقع,
    عدد_الدوال: غير_موقع,
    عدد_المستوردة: غير_موقع,
    أساس_البيانات: غير_موقع,
    رموز_البيانات: &متجه رمز_بيانات_ويب_أسمبلي,
    إزاحات_القطع: &متجه غير_موقع
): عدد {
    لو (النوع == 6) { أرجع الفهرس مثل عدد; };
    لو (النوع == 7 || النوع == 20 || النوع == 1 || النوع == 2) { أرجع 0; };
    لو (النوع == 0) {
        لو (الفهرس < عدد_الدوال) { أرجع (عدد_المستوردة + الفهرس) مثل عدد; };
        أرجع (الفهرس - عدد_الدوال) مثل عدد;
    };
    لو (الفهرس >= أساس_البيانات && الفهرس - أساس_البيانات < (الطول(*رموز_البيانات) مثل غير_موقع)) {
        دع القطعة: غير_موقع = (*رموز_البيانات)[الفهرس - أساس_البيانات].القطعة;
        أرجع (*إزاحات_القطع)[القطعة] مثل عدد;
    };
    أرجع 0;
}

عرف فهرس_رمز_مرجع_ويب_أسمبلي(
    الرمز: &مرجع_رمز_كائن,
    مواضع_الدوال: &متجه اختيار غير_موقع,
    مواضع_المستوردة: &متجه اختيار غير_موقع,
    أساس_المستوردة: غير_موقع,
    بداية_البيانات: &متجه غير_موقع,
    أساس_البيانات: غير_موقع,
    رموز_العوام: &متجه اختيار غير_موقع
): اختيار غير_موقع {
    طابق *الرمز مع
    | مرجع_رمز_كائن.دالة(المعرف) -> { أرجع من_خريطة_ويب_أسمبلي(مواضع_الدوال, المعرف.القيمة); }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> {
        طابق من_خريطة_ويب_أسمبلي(مواضع_المستوردة, المعرف.القيمة) مع
        | اختيار.بعض(م) -> { أرجع اختيار.بعض(أساس_المستوردة + م); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(المعرف) -> {
        طابق من_خريطة_ويب_أسمبلي(مواضع_الدوال, المعرف.الدالة.القيمة) مع
        | اختيار.بعض(م) -> {
            لو (م >= (الطول(*بداية_البيانات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
            أرجع اختيار.بعض(أساس_البيانات + (*بداية_البيانات)[م] + المعرف.القيمة);
        }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | مرجع_رمز_كائن.عام(المعرف) -> {
        طابق من_خريطة_ويب_أسمبلي(رموز_العوام, المعرف.القيمة) مع
        | اختيار.بعض(م) -> { أرجع اختيار.بعض(أساس_البيانات + م); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}
