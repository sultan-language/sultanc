استورد compiler.backend.target.executable_symbol_query_context;
استورد compiler.backend.target.dynamic_link_query_context;
استورد compiler.backend.target.runtime_primitive_symbol_query_context;
استورد compiler.backend.target.host_facility_query_context;
استورد compiler.backend.target.runtime_symbol_query_context;
استورد compiler.backend.object.object_reference_model;
استورد compiler.backend.object.elf.elf_model;
استورد compiler.backend.architectures.x86_64.encoded_code;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.target.target_model;

عام نوع خطأ_إلف =
    | هدف_غير_متوافق بنوع معرف_هدف
    | معمارية_غير_مدعومة بنوع معرف_هدف
    | صيغة_كائن_غير_مدعومة بنوع معرف_هدف
    | نموذج_بيانات_غير_مدعوم بنوع معرف_هدف
    | رمز_مكرر
    | إزاحة_نداء_خارج_النص
    | إضافة_إزاحة_غير_مدعومة
    | رمز_إزاحة_مفقود
    | رمز_دخول_مفقود بنوع معرف_دالة_منتقاة
    | حدود_صيغة_متجاوزة
;

عام نوع نتيجة_بناء_إلف =
    | نجح بنوع كائن_إلف
    | خطأ بنوع خطأ_إلف
;

عام نوع نتيجة_تسلسل_إلف =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_إلف
;

عرف ألحق_غ8_إلف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ب: متغير متجه غ8 = *البايتات;
    ألحق(ب, (القيمة % 256) مثل غ8);
    *البايتات := ب;
}

عرف ألحق_غ16_إلف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 2) {
        ألحق_غ8_إلف(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_غ32_إلف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        ألحق_غ8_إلف(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_غ64_إلف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        ألحق_غ8_إلف(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_أصفارا_إلف(البايتات: &متغير متجه غ8, العدد: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق_غ8_إلف(البايتات, 0);
        ف := ف + 1;
    }
}

عرف أكمل_إلف_إلى(البايتات: &متغير متجه غ8, الموضع: غير_موقع): منطقي {
    دع الحالي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الحالي > الموضع) {
        أرجع خطأ;
    };
    ألحق_أصفارا_إلف(البايتات, الموضع - الحالي);
    أرجع صواب;
}

عرف حاذ_إلف(القيمة: غير_موقع, المحاذاة: غير_موقع): غير_موقع {
    لو (المحاذاة == 0) {
        أرجع القيمة;
    };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) {
        أرجع القيمة;
    };
    أرجع القيمة + (المحاذاة - الباقي);
}

عرف بايت_سداسي_إلف(القيمة: غير_موقع): غ8 {
    لو (القيمة < 10) {
        أرجع (0x30 + القيمة) مثل غ8;
    };
    أرجع (0x61 + (القيمة - 10)) مثل غ8;
}

عرف اسم_رمز_دالة_إلف(المعرف: معرف_دالة_منتقاة): متجه غ8 {
    دع البايتات: متغير متجه غ8 = [];
    // sultanc_fn_
    دع المقدمة: متجه غ8 = [
        0x73, 0x75, 0x6C, 0x74, 0x61, 0x6E, 0x63, 0x5F, 0x66, 0x6E, 0x5F
    ];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المقدمة) مثل غير_موقع)) {
        ألحق(البايتات, المقدمة[ف]);
        ف := ف + 1;
    }
    دع القاسم: متغير غير_موقع = 0x1000000000000000;
    دع ر: متغير غير_موقع = 0;
    بينما (ر < 16) {
        دع المقسوم: غير_موقع = المعرف.القيمة / القاسم;
        دع الرقم: غير_موقع = المقسوم % 16;
        ألحق(البايتات, بايت_سداسي_إلف(الرقم));
        لو (القاسم > 1) {
            القاسم := القاسم / 16;
        };
        ر := ر + 1;
    }
    أرجع البايتات;
}

عرف اسم_مرجع_رمز_إلف(
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه غ8
): اختيار متجه غ8 {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> { أرجع اختيار.بعض(اسم_رمز_دالة_إلف(الدالة)); }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> { أرجع اسم_رمز_خارجي_كائن_من_جدول(المعرف, الرموز_الخارجية); }
    | مرجع_رمز_كائن.خدمة_تشغيل(الخدمة) -> { أرجع اسم_رمز_خدمة_تشغيل_للهدف(الهدف, الخدمة); }
    | مرجع_رمز_كائن.مرفق_مضيف(المرفق) -> { أرجع اسم_رمز_مرفق_مضيف_للهدف(الهدف, المرفق); }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> { أرجع اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي); }
    | مرجع_رمز_كائن.بيانات_ثابتة(_) -> { أرجع اختيار.لا_شيء(); };
}

عرف ابحث_رمز_إلف(
    الرموز: &متجه رمز_إلف,
    المرجع: &مرجع_رمز_كائن
): اختيار غير_موقع {
    دع ر: متجه رمز_إلف = *الرموز;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ر) مثل غير_موقع)) {
        لو (مرجعا_رمز_كائن_متساويان(&ر[ف].المرجع, المرجع)) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أضف_رمز_إلف(
    الرموز: &متغير متجه رمز_إلف,
    المرجع: مرجع_رمز_كائن,
    الموضع: موضع_رمز_إلف,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه غ8
): اختيار خطأ_إلف {
    طابق ابحث_رمز_إلف(الرموز, &المرجع) مع
    | اختيار.بعض(_) -> { أرجع اختيار.بعض(خطأ_إلف.رمز_مكرر()); }
    | اختيار.لا_شيء -> { };
    طابق اسم_مرجع_رمز_إلف(&المرجع, الهدف, الرموز_الخارجية) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_إلف.رمز_إزاحة_مفقود()); }
    | اختيار.بعض(الاسم) -> {
        دع الحالة: متغير متجه رمز_إلف = *الرموز;
        دع الرمز: رمز_إلف = { المرجع: المرجع, الاسم: الاسم, الموضع: الموضع };
        ألحق(الحالة, الرمز);
        *الرموز := الحالة;
        أرجع اختيار.لا_شيء();
    };
}

عرف اسم_دخول_إلف(): متجه غ8 {
    // main
    دع الاسم: متجه غ8 = [0x6D, 0x61, 0x69, 0x6E];
    أرجع الاسم;
}

عرف طبق_اسم_دخول_إلف(
    الرموز: &متغير متجه رمز_إلف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة
): اختيار خطأ_إلف {
    طابق دالة_الدخول مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الدخول) -> {
        دع مرجع_الدخول: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدخول);
        طابق ابحث_رمز_إلف(الرموز, &مرجع_الدخول) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_إلف.رمز_دخول_مفقود(الدخول)); }
        | اختيار.بعض(ف) -> {
            دع الحالة: متغير متجه رمز_إلف = *الرموز;
            طابق الحالة[ف].الموضع مع
            | موضع_رمز_إلف.غير_معرف -> { أرجع اختيار.بعض(خطأ_إلف.رمز_دخول_مفقود(الدخول)); }
            | موضع_رمز_إلف.معرف_في_النص(الإزاحة, الحجم) -> {
                دع الاسم: متجه غ8 = اسم_دخول_إلف();
                دع موضع_الدخول: موضع_رمز_إلف = موضع_رمز_إلف.معرف_في_النص(الإزاحة, الحجم);
                دع الرمز: رمز_إلف = { المرجع: مرجع_الدخول, الاسم: الاسم, الموضع: موضع_الدخول };
                الحالة[ف] := الرمز; *الرموز := الحالة; أرجع اختيار.لا_شيء();
            };
        };
    };
}

عام عرف ابن_كائن_إلف_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8
): نتيجة_بناء_إلف {
    دع ش: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = *الشفرة;
    دع و: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(ش.الهدف, و.المعرف)) {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.هدف_غير_متوافق(ش.الهدف));
    };
    // هذا الكاتب يستهلك شفرة x86_64 مشفرة أصلا؛ Object يتحقق من صيغة الحاوية ونموذج البيانات فقط.
    طابق و.صيغة_الكائن مع
    | صيغة_كائن_هدف.إلف -> { }
    | _ -> {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.صيغة_كائن_غير_مدعومة(و.المعرف));
    };
    لو (و.نموذج_البيانات.عرض_المؤشر != 64) {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.نموذج_بيانات_غير_مدعوم(و.المعرف));
    };
    طابق و.نموذج_البيانات.ترتيب_البايت مع
    | ترتيب_بايت.صغير -> { }
    | _ -> {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.نموذج_بيانات_غير_مدعوم(و.المعرف));
    };

    دع الرموز: متغير متجه رمز_إلف = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ش.الدوال) مثل غير_موقع)) {
        دع الدالة: موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = ش.الدوال[ف];
        لو (الدالة.إزاحة_بايت + الدالة.حجم_بايت > (الطول(ش.البيانات) مثل غير_موقع)) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
        };
        دع الموضع: موضع_رمز_إلف =
            موضع_رمز_إلف.معرف_في_النص(الدالة.إزاحة_بايت, الدالة.حجم_بايت);
        دع مرجع_الدالة: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدالة.الدالة);
        طابق أضف_رمز_إلف(&متغير الرموز, مرجع_الدالة, الموضع, الهدف, الرموز_الخارجية) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    دع الإزاحات: متغير متجه إزاحة_إلف = [];
    دع ر: متغير غير_موقع = 0;
    بينما (ر < (الطول(ش.إزاحات_النداء) مثل غير_موقع)) {
        دع نداء: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = ش.إزاحات_النداء[ر];
        لو (نداء.إزاحة_بايت + 4 > (الطول(ش.البيانات) مثل غير_موقع)) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إزاحة_نداء_خارج_النص());
        };
        لو (نداء.الإضافة != -4) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إضافة_إزاحة_غير_مدعومة());
        };
        طابق ابحث_رمز_إلف(&الرموز, &نداء.الرمز) مع
        | اختيار.لا_شيء -> {
            دع موضع_غير_معرف: موضع_رمز_إلف = موضع_رمز_إلف.غير_معرف();
            دع مرجع_النداء: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&نداء.الرمز);
            طابق أضف_رمز_إلف(&متغير الرموز, مرجع_النداء, موضع_غير_معرف, الهدف, الرموز_الخارجية) مع
            | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.بعض(_) -> { };
        دع مرجع_الإزاحة: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&نداء.الرمز);
        دع الإزاحة: إزاحة_إلف = {
            إزاحة_بايت: نداء.إزاحة_بايت,
            الرمز: مرجع_الإزاحة,
            الإضافة: نداء.الإضافة
        };
        ألحق(الإزاحات, الإزاحة);
        ر := ر + 1;
    }

    طابق طبق_اسم_دخول_إلف(&متغير الرموز, دالة_الدخول) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { };

    دع مرجع_النص: &متجه غ8 = &ش.البيانات;
    دع النص: متجه غ8 = *مرجع_النص;
    دع دخول_العملية: اختيار موضع_دخول_عملية_إلف;
    طابق ش.دخول_عملية_لينكس مع
    | اختيار.لا_شيء -> {
        دخول_العملية := اختيار.لا_شيء();
    }
    | اختيار.بعض(الدخول) -> {
        دع نهاية_الدخول: غير_موقع = الدخول.إزاحة_بايت + الدخول.حجم_بايت;
        دع حجم_النص_المشفر: غير_موقع = الطول(ش.البيانات) مثل غير_موقع;
        لو (نهاية_الدخول > حجم_النص_المشفر) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
        };
        دع الموضع: موضع_دخول_عملية_إلف = {
            إزاحة_بايت: الدخول.إزاحة_بايت,
            حجم_بايت: الدخول.حجم_بايت
        };
        دخول_العملية := اختيار.بعض(الموضع);
    };
    دع الناتج: كائن_إلف = {
        الهدف: و.المعرف,
        النص: النص,
        الرموز: الرموز,
        الإزاحات: الإزاحات,
        دخول_العملية: دخول_العملية
    };
    أرجع نتيجة_بناء_إلف.نجح(الناتج);
}

عرف ابن_جدول_نصوص_رموز_إلف(
    الرموز: &متجه رمز_إلف,
    الإزاحات: &متغير متجه غير_موقع
): متجه غ8 {
    دع ر: متجه رمز_إلف = *الرموز;
    دع النصوص: متغير متجه غ8 = [0];
    دع المواقع: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ر) مثل غير_موقع)) {
        ألحق(المواقع, الطول(النصوص) مثل غير_موقع);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(ر[ف].الاسم) مثل غير_موقع)) {
            ألحق(النصوص, ر[ف].الاسم[ك]);
            ك := ك + 1;
        }
        ألحق(النصوص, 0 مثل غ8);
        ف := ف + 1;
    }
    *الإزاحات := المواقع;
    أرجع النصوص;
}

عرف ابن_جدول_أسماء_أقسام_إلف(): متجه غ8 {
    // \0.text\0.rela.text\0.symtab\0.strtab\0.shstrtab\0
    دع الناتج: متجه غ8 = [
        0,
        0x2E, 0x74, 0x65, 0x78, 0x74, 0,
        0x2E, 0x72, 0x65, 0x6C, 0x61, 0x2E, 0x74, 0x65, 0x78, 0x74, 0,
        0x2E, 0x73, 0x79, 0x6D, 0x74, 0x61, 0x62, 0,
        0x2E, 0x73, 0x74, 0x72, 0x74, 0x61, 0x62, 0,
        0x2E, 0x73, 0x68, 0x73, 0x74, 0x72, 0x74, 0x61, 0x62, 0
    ];
    أرجع الناتج;
}

عرف اسم_دخول_عملية_إلف(): متجه غ8 {
    // _start
    دع الاسم: متجه غ8 = [0x5F, 0x73, 0x74, 0x61, 0x72, 0x74];
    أرجع الاسم;
}

عرف ألحق_رمز_إلف64(
    البايتات: &متغير متجه غ8,
    اسم: غير_موقع,
    المعلومة: غير_موقع,
    فهرس_القسم: غير_موقع,
    القيمة: غير_موقع,
    الحجم: غير_موقع
): فراغ {
    ألحق_غ32_إلف(البايتات, اسم);
    ألحق_غ8_إلف(البايتات, المعلومة);
    ألحق_غ8_إلف(البايتات, 0);
    ألحق_غ16_إلف(البايتات, فهرس_القسم);
    ألحق_غ64_إلف(البايتات, القيمة);
    ألحق_غ64_إلف(البايتات, الحجم);
}

عرف ألحق_رأس_قسم_إلف64(
    البايتات: &متغير متجه غ8,
    الاسم: غير_موقع,
    النوع: غير_موقع,
    الأعلام: غير_موقع,
    الإزاحة: غير_موقع,
    الحجم: غير_موقع,
    الرابط: غير_موقع,
    المعلومة: غير_موقع,
    المحاذاة: غير_موقع,
    حجم_المدخل: غير_موقع
): فراغ {
    ألحق_غ32_إلف(البايتات, الاسم);
    ألحق_غ32_إلف(البايتات, النوع);
    ألحق_غ64_إلف(البايتات, الأعلام);
    ألحق_غ64_إلف(البايتات, 0);
    ألحق_غ64_إلف(البايتات, الإزاحة);
    ألحق_غ64_إلف(البايتات, الحجم);
    ألحق_غ32_إلف(البايتات, الرابط);
    ألحق_غ32_إلف(البايتات, المعلومة);
    ألحق_غ64_إلف(البايتات, المحاذاة);
    ألحق_غ64_إلف(البايتات, حجم_المدخل);
}

عرف اكتب_كائن_إلف64(الكائن: &كائن_إلف): نتيجة_تسلسل_إلف {
    دع ك: كائن_إلف = *الكائن;
    دع إزاحات_الأسماء: متغير متجه غير_موقع = [];
    دع جدول_النصوص: متغير متجه غ8 = ابن_جدول_نصوص_رموز_إلف(&ك.الرموز, &متغير إزاحات_الأسماء);
    دع إزاحة_اسم_دخول_العملية: متغير غير_موقع = 0;
    طابق ك.دخول_العملية مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(_) -> {
        إزاحة_اسم_دخول_العملية := الطول(جدول_النصوص) مثل غير_موقع;
        دع اسم_الدخول: متجه غ8 = اسم_دخول_عملية_إلف();
        دع عدد_بايتات_الاسم: غير_موقع = الطول(اسم_الدخول) مثل غير_موقع;
        دع فهرس_بايت_الاسم: متغير غير_موقع = 0;
        بينما (فهرس_بايت_الاسم < عدد_بايتات_الاسم) {
            دع بايت_الاسم: غ8 = اسم_الدخول[فهرس_بايت_الاسم];
            ألحق(جدول_النصوص, بايت_الاسم);
            فهرس_بايت_الاسم := فهرس_بايت_الاسم + 1;
        }
        دع صفر_الاسم: غ8 = 0 مثل غ8;
        ألحق(جدول_النصوص, صفر_الاسم);
    };
    دع جدول_أسماء_الأقسام: متجه غ8 = ابن_جدول_أسماء_أقسام_إلف();

    دع حجم_الرأس: غير_موقع = 64;
    دع إزاحة_النص: غير_موقع = حاذ_إلف(حجم_الرأس, 16);
    دع حجم_النص: غير_موقع = الطول(ك.النص) مثل غير_موقع;
    دع إزاحة_الإزاحات: غير_موقع = حاذ_إلف(إزاحة_النص + حجم_النص, 8);
    دع عدد_الإزاحات: غير_موقع = الطول(ك.الإزاحات) مثل غير_موقع;
    دع حجم_الإزاحات: غير_موقع = عدد_الإزاحات * 24;
    دع إزاحة_الرموز: غير_موقع = حاذ_إلف(إزاحة_الإزاحات + حجم_الإزاحات, 8);
    // رمز صفر + رمز قسم .text + الرموز العامة المعرفة/غير المعرفة.
    دع عدد_رموز_الكائن: غير_موقع = الطول(ك.الرموز) مثل غير_موقع;
    دع عدد_رموز_الدخول: متغير غير_موقع = 0;
    طابق ك.دخول_العملية مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(_) -> { عدد_رموز_الدخول := 1; };
    دع عدد_الرموز: غير_موقع = عدد_رموز_الكائن + 2 + عدد_رموز_الدخول;
    دع حجم_الرموز: غير_موقع = عدد_الرموز * 24;
    دع إزاحة_النصوص: غير_موقع = إزاحة_الرموز + حجم_الرموز;
    دع حجم_النصوص: غير_موقع = الطول(جدول_النصوص) مثل غير_موقع;
    دع إزاحة_أسماء_الأقسام: غير_موقع = إزاحة_النصوص + حجم_النصوص;
    دع حجم_أسماء_الأقسام: غير_موقع = الطول(جدول_أسماء_الأقسام) مثل غير_موقع;
    دع إزاحة_رؤوس_الأقسام: غير_موقع = حاذ_إلف(
        إزاحة_أسماء_الأقسام + حجم_أسماء_الأقسام,
        8
    );

    دع البايتات: متغير متجه غ8 = [];
    // e_ident
    ألحق_غ8_إلف(&متغير البايتات, 0x7F);
    ألحق_غ8_إلف(&متغير البايتات, 0x45);
    ألحق_غ8_إلف(&متغير البايتات, 0x4C);
    ألحق_غ8_إلف(&متغير البايتات, 0x46);
    ألحق_غ8_إلف(&متغير البايتات, 2); // ELFCLASS64
    ألحق_غ8_إلف(&متغير البايتات, 1); // ELFDATA2LSB
    ألحق_غ8_إلف(&متغير البايتات, 1); // EV_CURRENT
    ألحق_غ8_إلف(&متغير البايتات, 0); // ELFOSABI_NONE
    ألحق_أصفارا_إلف(&متغير البايتات, 8);
    ألحق_غ16_إلف(&متغير البايتات, 1);  // ET_REL
    ألحق_غ16_إلف(&متغير البايتات, 62); // EM_X86_64
    ألحق_غ32_إلف(&متغير البايتات, 1);
    ألحق_غ64_إلف(&متغير البايتات, 0); // e_entry
    ألحق_غ64_إلف(&متغير البايتات, 0); // e_phoff
    ألحق_غ64_إلف(&متغير البايتات, إزاحة_رؤوس_الأقسام);
    ألحق_غ32_إلف(&متغير البايتات, 0); // e_flags
    ألحق_غ16_إلف(&متغير البايتات, 64);
    ألحق_غ16_إلف(&متغير البايتات, 0);
    ألحق_غ16_إلف(&متغير البايتات, 0);
    ألحق_غ16_إلف(&متغير البايتات, 64);
    ألحق_غ16_إلف(&متغير البايتات, 6);
    ألحق_غ16_إلف(&متغير البايتات, 5);

    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_النص)) {
        أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
    };
    دع ن: متغير غير_موقع = 0;
    بينما (ن < (الطول(ك.النص) مثل غير_موقع)) {
        ألحق(البايتات, ك.النص[ن]);
        ن := ن + 1;
    }

    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_الإزاحات)) {
        أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
    };
    دع ر: متغير غير_موقع = 0;
    بينما (ر < (الطول(ك.الإزاحات) مثل غير_موقع)) {
        دع الإزاحة: إزاحة_إلف = ك.الإزاحات[ر];
        طابق ابحث_رمز_إلف(&ك.الرموز, &الإزاحة.الرمز) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود());
        }
        | اختيار.بعض(فهرس_الرمز) -> {
            // فهرسا 0 و1 محجوزان للرمز الصفري ورمز قسم .text.
            دع فهرس_إلف: غير_موقع = فهرس_الرمز + 2;
            دع أساس_معلومة_الإزاحة: غير_موقع = فهرس_إلف * 4294967296;
            دع معلومة_الإزاحة: غير_موقع = أساس_معلومة_الإزاحة + 4;
            ألحق_غ64_إلف(&متغير البايتات, الإزاحة.إزاحة_بايت);
            ألحق_غ64_إلف(&متغير البايتات, معلومة_الإزاحة);
            // R_X86_64_PLT32 على حقل rel32 الخاص بـ CALL، A = -4.
            ألحق_غ32_إلف(&متغير البايتات, 0xFFFFFFFC);
            ألحق_غ32_إلف(&متغير البايتات, 0xFFFFFFFF);
        };
        ر := ر + 1;
    }

    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_الرموز)) {
        أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
    };
    ألحق_أصفارا_إلف(&متغير البايتات, 24);
    // STT_SECTION محلي لقسم .text.
    ألحق_رمز_إلف64(&متغير البايتات, 0, 3, 1, 0, 0);
    دع س: متغير غير_موقع = 0;
    بينما (س < (الطول(ك.الرموز) مثل غير_موقع)) {
        دع مرجع_الرمز: &رمز_إلف = &ك.الرموز[س];
        دع الرمز: رمز_إلف = *مرجع_الرمز;
        دع القسم: متغير غير_موقع = 0;
        دع القيمة: متغير غير_موقع = 0;
        دع الحجم: متغير غير_موقع = 0;
        طابق الرمز.الموضع مع
        | موضع_رمز_إلف.معرف_في_النص(الإزاحة, حجم_الدالة) -> {
            القسم := 1;
            القيمة := الإزاحة;
            الحجم := حجم_الدالة;
        }
        | موضع_رمز_إلف.غير_معرف -> { };
        ألحق_رمز_إلف64(
            &متغير البايتات,
            إزاحات_الأسماء[س],
            0x12,
            القسم,
            القيمة,
            الحجم
        );
        س := س + 1;
    }
    طابق ك.دخول_العملية مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الدخول) -> {
        ألحق_رمز_إلف64(
            &متغير البايتات,
            إزاحة_اسم_دخول_العملية,
            0x12,
            1,
            الدخول.إزاحة_بايت,
            الدخول.حجم_بايت
        );
    };

    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_النصوص)) {
        أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
    };
    دع ت: متغير غير_موقع = 0;
    بينما (ت < (الطول(جدول_النصوص) مثل غير_موقع)) {
        ألحق(البايتات, جدول_النصوص[ت]);
        ت := ت + 1;
    }

    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_أسماء_الأقسام)) {
        أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
    };
    دع أ: متغير غير_موقع = 0;
    بينما (أ < (الطول(جدول_أسماء_الأقسام) مثل غير_موقع)) {
        ألحق(البايتات, جدول_أسماء_الأقسام[أ]);
        أ := أ + 1;
    }

    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_رؤوس_الأقسام)) {
        أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
    };
    ألحق_أصفارا_إلف(&متغير البايتات, 64);
    // .text
    ألحق_رأس_قسم_إلف64(
        &متغير البايتات, 1, 1, 6,
        إزاحة_النص, حجم_النص,
        0, 0, 16, 0
    );
    // .rela.text: sh_link=.symtab(3), sh_info=.text(1), Elf64_Rela=24.
    ألحق_رأس_قسم_إلف64(
        &متغير البايتات, 7, 4, 0,
        إزاحة_الإزاحات, حجم_الإزاحات,
        3, 1, 8, 24
    );
    // .symtab: sh_link=.strtab(4), sh_info=2 لأن أول رمز عالمي فهرسه 2.
    ألحق_رأس_قسم_إلف64(
        &متغير البايتات, 18, 2, 0,
        إزاحة_الرموز, حجم_الرموز,
        4, 2, 8, 24
    );
    // .strtab
    ألحق_رأس_قسم_إلف64(
        &متغير البايتات, 26, 3, 0,
        إزاحة_النصوص, حجم_النصوص,
        0, 0, 1, 0
    );
    // .shstrtab
    ألحق_رأس_قسم_إلف64(
        &متغير البايتات, 34, 3, 0,
        إزاحة_أسماء_الأقسام, حجم_أسماء_الأقسام,
        0, 0, 1, 0
    );

    أرجع نتيجة_تسلسل_إلف.نجح(البايتات);
}

عام عرف اكتب_إلف_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8
): نتيجة_تسلسل_إلف {
    طابق ابن_كائن_إلف_إكس_ستة_وثمانون_أربعة_وستون(الشفرة, الهدف, دالة_الدخول, الرموز_الخارجية) مع
    | نتيجة_بناء_إلف.خطأ(الخطأ) -> {
        أرجع نتيجة_تسلسل_إلف.خطأ(الخطأ);
    }
    | نتيجة_بناء_إلف.نجح(الكائن) -> {
        أرجع اكتب_كائن_إلف64(&الكائن);
    };
}

// ===== canonical Linux ELF executable-finalization boundary =====
// The current x86_64 object writer emits ET_REL. This owner validates and consumes
// that format and reports only genuine upstream contracts that prevent ET_EXEC.
عام نوع خطأ_إنهاء_تنفيذي_إلف =
    | كائن_إلف_تنفيذي_غير_صالح
    | رمز_دخول_إلف_مفقود
    | بدائي_تشغيل_إلف_غير_مخفض
    | رمز_خارجي_إلف_غير_معروف
;

عام نوع نتيجة_إنهاء_تنفيذي_إلف =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_إنهاء_تنفيذي_إلف
;

عرف ضمن_حدود_إلف(البايتات: &متجه غ8, الموضع: غير_موقع, الحجم: غير_موقع): منطقي {
    دع الكل: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > الكل) { أرجع خطأ; };
    أرجع الحجم <= (الكل - الموضع);
}

عرف اقرأ_غ16_إلف(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع ب: متجه غ8 = *البايتات;
    دع الموضع1: غير_موقع = الموضع + 1;
    دع الأدنى: غير_موقع = ب[الموضع] مثل غير_موقع;
    دع الأعلى: غير_موقع = ب[الموضع1] مثل غير_موقع;
    دع الأعلى_مزاحا: غير_موقع = الأعلى * 256;
    أرجع الأدنى + الأعلى_مزاحا;
}

عرف اقرأ_غ32_إلف(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع ب: متجه غ8 = *البايتات;
    دع الموضع1: غير_موقع = الموضع + 1;
    دع الموضع2: غير_موقع = الموضع + 2;
    دع الموضع3: غير_موقع = الموضع + 3;
    دع ب0: غير_موقع = ب[الموضع] مثل غير_موقع;
    دع ب1: غير_موقع = ب[الموضع1] مثل غير_موقع;
    دع ب2: غير_موقع = ب[الموضع2] مثل غير_موقع;
    دع ب3: غير_موقع = ب[الموضع3] مثل غير_موقع;
    دع ج1: غير_موقع = ب1 * 256;
    دع ج2: غير_موقع = ب2 * 65536;
    دع ج3: غير_موقع = ب3 * 16777216;
    دع ج01: غير_موقع = ب0 + ج1;
    دع ج012: غير_موقع = ج01 + ج2;
    أرجع ج012 + ج3;
}

عرف اقرأ_غ64_إلف(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع الأدنى: غير_موقع = اقرأ_غ32_إلف(البايتات, الموضع);
    دع موضع_الأعلى: غير_موقع = الموضع + 4;
    دع الأعلى: غير_موقع = اقرأ_غ32_إلف(البايتات, موضع_الأعلى);
    دع الأعلى_مزاحا: غير_موقع = الأعلى * 4294967296;
    أرجع الأدنى + الأعلى_مزاحا;
}

عرف اقرأ_اسم_صفري_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار متجه غ8 {
    دع ب: متجه غ8 = *البايتات;
    دع الكل: غير_موقع = الطول(ب) مثل غير_موقع;
    لو (الموضع >= النهاية || النهاية > الكل) { أرجع اختيار.لا_شيء(); };
    دع الاسم: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = الموضع;
    بينما (ف < النهاية) {
        لو (ب[ف] == 0) { أرجع اختيار.بعض(الاسم); };
        ألحق(الاسم, ب[ف]);
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اسما_إلف_متساويان(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    دع س: متجه غ8 = *أ;
    دع ص: متجه غ8 = *ب;
    دع طول_س: غير_موقع = الطول(س) مثل غير_موقع;
    دع طول_ص: غير_موقع = الطول(ص) مثل غير_موقع;
    لو (طول_س != طول_ص) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < طول_س) {
        لو (س[ف] != ص[ف]) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اكتب_غ32_إلف_في(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    دع ب: متغير متجه غ8 = *البايتات;
    دع الكل: غير_موقع = الطول(ب) مثل غير_موقع;
    دع النهاية: غير_موقع = الموضع + 4;
    لو (النهاية > الكل) {
        أرجع خطأ;
    };
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        دع موضع_البايت: غير_موقع = الموضع + ف;
        دع باقي_البايت: غير_موقع = الباقي % 256;
        دع قيمة_البايت: غ8 = باقي_البايت مثل غ8;
        ب[موضع_البايت] := قيمة_البايت;
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
    *البايتات := ب;
    أرجع صواب;
}

عرف ألحق_رأس_برنامج_إلف64_خام(
    البايتات: &متغير متجه غ8,
    النوع: غير_موقع,
    الأعلام: غير_موقع,
    إزاحة_الملف: غير_موقع,
    العنوان: غير_موقع,
    حجم_الملف: غير_موقع,
    حجم_الذاكرة: غير_موقع,
    المحاذاة: غير_موقع
): فراغ {
    ألحق_غ32_إلف(البايتات, النوع);
    ألحق_غ32_إلف(البايتات, الأعلام);
    ألحق_غ64_إلف(البايتات, إزاحة_الملف);
    ألحق_غ64_إلف(البايتات, العنوان);
    ألحق_غ64_إلف(البايتات, العنوان);
    ألحق_غ64_إلف(البايتات, حجم_الملف);
    ألحق_غ64_إلف(البايتات, حجم_الذاكرة);
    ألحق_غ64_إلف(البايتات, المحاذاة);
}

عرف ألحق_رأس_برنامج_إلف64_تنفيذي(
    البايتات: &متغير متجه غ8,
    إزاحة_الملف: غير_موقع,
    العنوان: غير_موقع,
    حجم_الملف: غير_موقع,
    حجم_الذاكرة: غير_موقع,
    الأعلام: غير_موقع,
    المحاذاة: غير_موقع
): فراغ {
    ألحق_رأس_برنامج_إلف64_خام(
        البايتات, 1, الأعلام, إزاحة_الملف, العنوان,
        حجم_الملف, حجم_الذاكرة, المحاذاة
    );
}

عرف ألحق_رأس_قسم_إلف64_تنفيذي(
    البايتات: &متغير متجه غ8,
    الاسم: غير_موقع,
    النوع: غير_موقع,
    الأعلام: غير_موقع,
    العنوان: غير_موقع,
    الإزاحة: غير_موقع,
    الحجم: غير_موقع,
    المحاذاة: غير_موقع
): فراغ {
    ألحق_غ32_إلف(البايتات, الاسم);
    ألحق_غ32_إلف(البايتات, النوع);
    ألحق_غ64_إلف(البايتات, الأعلام);
    ألحق_غ64_إلف(البايتات, العنوان);
    ألحق_غ64_إلف(البايتات, الإزاحة);
    ألحق_غ64_إلف(البايتات, الحجم);
    ألحق_غ32_إلف(البايتات, 0);
    ألحق_غ32_إلف(البايتات, 0);
    ألحق_غ64_إلف(البايتات, المحاذاة);
    ألحق_غ64_إلف(البايتات, 0);
}

عرف اسم_خارجي_معلن_إلف(
    الاسم: &متجه غ8,
    المعلنة: &متجه متجه غ8
): منطقي {
    دع الأسماء: متجه متجه غ8 = *المعلنة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأسماء) مثل غير_موقع)) {
        لو (اسما_رمز_خارجي_كائن_متساويان(الاسم, &الأسماء[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف ابحث_ترتيب_رمز_خارجي_إلف(
    الفهارس: &متجه غير_موقع,
    فهرس_الرمز: غير_موقع
): اختيار غير_موقع {
    دع القيم: متجه غير_موقع = *الفهارس;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (القيم[ف] == فهرس_الرمز) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف فرق_نسبي32_إلف(بعد_التعليمة: غير_موقع, الهدف: غير_موقع): اختيار غير_موقع {
    لو (الهدف >= بعد_التعليمة) {
        دع الفرق: غير_موقع = الهدف - بعد_التعليمة;
        لو (الفرق > 2147483647) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الفرق);
    };
    دع الفرق: غير_موقع = بعد_التعليمة - الهدف;
    لو (الفرق > 2147483648) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(4294967296 - الفرق);
}

عرف ألحق_بايتات_إلف(الوجهة: &متغير متجه غ8, المصدر: &متجه غ8): فراغ {
    دع القيم: متجه غ8 = *المصدر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع الحالة: متغير متجه غ8 = *الوجهة;
        ألحق(الحالة, القيم[ف]);
        *الوجهة := الحالة;
        ف := ف + 1;
    }
}

عرف ألحق_رمز_ديناميكي_إلف64(
    البايتات: &متغير متجه غ8,
    إزاحة_الاسم: غير_موقع
): فراغ {
    ألحق_غ32_إلف(البايتات, إزاحة_الاسم);
    ألحق_غ8_إلف(البايتات, 0x12); // STB_GLOBAL | STT_FUNC
    ألحق_غ8_إلف(البايتات, 0);
    ألحق_غ16_إلف(البايتات, 0); // SHN_UNDEF
    ألحق_غ64_إلف(البايتات, 0);
    ألحق_غ64_إلف(البايتات, 0);
}

عرف ألحق_مدخل_ديناميكي_إلف64(
    البايتات: &متغير متجه غ8,
    الوسم: غير_موقع,
    القيمة: غير_موقع
): فراغ {
    ألحق_غ64_إلف(البايتات, الوسم);
    ألحق_غ64_إلف(البايتات, القيمة);
}

عرف ابن_تنفيذي_إلف_ديناميكي(
    النص_الأصلي: &متجه غ8,
    إزاحة_دخول_العملية: غير_موقع,
    بايتات_الكائن: &متجه غ8,
    موضع_الرموز: غير_موقع,
    موضع_إزاحات_النص: غير_موقع,
    عدد_الإزاحات: غير_موقع,
    فهارس_الخارجية: &متجه غير_موقع,
    أسماء_الخارجية: &متجه متجه غ8,
    الهدف: &واصف_هدف
): نتيجة_إنهاء_تنفيذي_إلف {
    دع عدد_الخارجية: غير_موقع = الطول(*فهارس_الخارجية) مثل غير_موقع;
    لو (عدد_الخارجية == 0 || عدد_الخارجية != (الطول(*أسماء_الخارجية) مثل غير_موقع)) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    دع إعداد_الربط: إعداد_ربط_ديناميكي_هدف;
    طابق إعداد_ربط_ديناميكي_للهدف(الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.رمز_خارجي_إلف_غير_معروف());
    }
    | اختيار.بعض(الإعداد) -> { إعداد_الربط := الإعداد; };

    دع أساس_التحميل: غير_موقع = 0x400000;
    دع حجم_الصفحة: غير_موقع = 0x1000;
    دع موضع_المفسر: غير_موقع = 0x200;
    دع حجم_المفسر: غير_موقع = الطول(إعداد_الربط.مفسر_إلف) مثل غير_موقع;
    دع موضع_النص: غير_موقع = حجم_الصفحة;
    دع حجم_النص: غير_موقع = الطول(*النص_الأصلي) مثل غير_موقع;
    دع عنوان_النص: غير_موقع = أساس_التحميل + موضع_النص;
    دع موضع_بلت: غير_موقع = حاذ_إلف(موضع_النص + حجم_النص, 16);
    دع عدد_مداخل_بلت: غير_موقع = عدد_الخارجية + 1;
    دع حجم_بلت: غير_موقع = عدد_مداخل_بلت * 16;
    دع عنوان_بلت: غير_موقع = أساس_التحميل + موضع_بلت;

    دع جدول_النصوص_الديناميكي: متغير متجه غ8 = [0];
    دع إزاحة_اسم_مكتبة: غير_موقع = 1;
    ألحق_بايتات_إلف(&متغير جدول_النصوص_الديناميكي, &إعداد_الربط.مكتبة_نظام_افتراضية);
    ألحق(جدول_النصوص_الديناميكي, 0);
    دع إزاحات_أسماء_ديناميكية: متغير متجه غير_موقع = [];
    دع الأسماء: متجه متجه غ8 = *أسماء_الخارجية;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الخارجية) {
        دع إزاحة_الاسم: غير_موقع = الطول(جدول_النصوص_الديناميكي) مثل غير_موقع;
        ألحق(إزاحات_أسماء_ديناميكية, إزاحة_الاسم);
        ألحق_بايتات_إلف(&متغير جدول_النصوص_الديناميكي, &الأسماء[ف]);
        ألحق(جدول_النصوص_الديناميكي, 0);
        ف := ف + 1;
    }

    دع موضع_النصوص_الديناميكية: غير_موقع = حاذ_إلف(موضع_بلت + حجم_بلت, 8);
    دع حجم_النصوص_الديناميكية: غير_موقع = الطول(جدول_النصوص_الديناميكي) مثل غير_موقع;
    دع موضع_الرموز_الديناميكية: غير_موقع = حاذ_إلف(موضع_النصوص_الديناميكية + حجم_النصوص_الديناميكية, 8);
    دع عدد_الرموز_الديناميكية: غير_موقع = عدد_الخارجية + 1;
    دع حجم_الرموز_الديناميكية: غير_موقع = عدد_الرموز_الديناميكية * 24;
    دع موضع_هاش: غير_موقع = حاذ_إلف(موضع_الرموز_الديناميكية + حجم_الرموز_الديناميكية, 8);
    دع عدد_كلمات_هاش: غير_موقع = عدد_الخارجية + 4;
    دع حجم_هاش: غير_موقع = عدد_كلمات_هاش * 4;
    دع موضع_إزاحات_بلت: غير_موقع = حاذ_إلف(موضع_هاش + حجم_هاش, 8);
    دع حجم_إزاحات_بلت: غير_موقع = عدد_الخارجية * 24;
    دع نهاية_القراءة: غير_موقع = موضع_إزاحات_بلت + حجم_إزاحات_بلت;
    دع موضع_الكتابة: غير_موقع = حاذ_إلف(نهاية_القراءة, حجم_الصفحة);
    دع موضع_جوت: غير_موقع = موضع_الكتابة;
    دع عدد_مداخل_جوت: غير_موقع = عدد_الخارجية + 3;
    دع حجم_جوت: غير_موقع = عدد_مداخل_جوت * 8;
    دع موضع_الديناميكي: غير_موقع = حاذ_إلف(موضع_جوت + حجم_جوت, 8);
    دع عدد_مداخل_ديناميكية: غير_موقع = 12;
    دع حجم_الديناميكي: غير_موقع = عدد_مداخل_ديناميكية * 16;
    دع نهاية_الملف: غير_موقع = موضع_الديناميكي + حجم_الديناميكي;
    دع عنوان_جوت: غير_موقع = أساس_التحميل + موضع_جوت;
    دع عنوان_الديناميكي: غير_موقع = أساس_التحميل + موضع_الديناميكي;

    دع النص: متغير متجه غ8 = *النص_الأصلي;
    ف := 0;
    بينما (ف < عدد_الإزاحات) {
        دع موضع_مدخل: غير_موقع = موضع_إزاحات_النص + ف * 24;
        دع موضع_الرقعة: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_مدخل);
        دع معلومات_الرقعة: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_مدخل + 8);
        دع فهرس_رمز: غير_موقع = معلومات_الرقعة / 4294967296;
        دع موضع_رمز: غير_موقع = موضع_الرموز + فهرس_رمز * 24;
        دع قسم_رمز: غير_موقع = اقرأ_غ16_إلف(بايتات_الكائن, موضع_رمز + 6);
        دع عنوان_الهدف: متغير غير_موقع = 0;
        لو (قسم_رمز == 0) {
            طابق ابحث_ترتيب_رمز_خارجي_إلف(فهارس_الخارجية, فهرس_رمز) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.رمز_خارجي_إلف_غير_معروف());
            }
            | اختيار.بعض(الترتيب) -> {
                دع ترتيب_المدخل: غير_موقع = الترتيب + 1;
                عنوان_الهدف := عنوان_بلت + ترتيب_المدخل * 16;
            };
        } وإلا {
            دع قيمة_رمز: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_رمز + 8);
            لو (قيمة_رمز >= حجم_النص) {
                أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
            };
            عنوان_الهدف := عنوان_النص + قيمة_رمز;
        };
        دع بعد_الرقعة: غير_موقع = عنوان_النص + موضع_الرقعة + 4;
        طابق فرق_نسبي32_إلف(بعد_الرقعة, عنوان_الهدف) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
        }
        | اختيار.بعض(القيمة) -> {
            لو (!اكتب_غ32_إلف_في(&متغير النص, موضع_الرقعة, القيمة)) {
                أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
            };
        };
        ف := ف + 1;
    }

    دع بلت: متغير متجه غ8 = [];
    ألحق_غ8_إلف(&متغير بلت, 0xFF); ألحق_غ8_إلف(&متغير بلت, 0x35);
    دع فرق_دفع: غير_موقع;
    طابق فرق_نسبي32_إلف(عنوان_بلت + 6, عنوان_جوت + 8) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); }
    | اختيار.بعض(قيمة) -> { فرق_دفع := قيمة; };
    ألحق_غ32_إلف(&متغير بلت, فرق_دفع);
    ألحق_غ8_إلف(&متغير بلت, 0xFF); ألحق_غ8_إلف(&متغير بلت, 0x25);
    دع فرق_قفز: غير_موقع;
    طابق فرق_نسبي32_إلف(عنوان_بلت + 12, عنوان_جوت + 16) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); }
    | اختيار.بعض(قيمة) -> { فرق_قفز := قيمة; };
    ألحق_غ32_إلف(&متغير بلت, فرق_قفز);
    دع حشو_بلت: متجه غ8 = [0x0F,0x1F,0x40,0x00];
    ألحق_بايتات_إلف(&متغير بلت, &حشو_بلت);
    ف := 0;
    بينما (ف < عدد_الخارجية) {
        دع ترتيب_مدخل_بلت: غير_موقع = ف + 1;
        دع عنوان_مدخل: غير_موقع = عنوان_بلت + ترتيب_مدخل_بلت * 16;
        ألحق_غ8_إلف(&متغير بلت, 0xFF); ألحق_غ8_إلف(&متغير بلت, 0x25);
        دع فرق_جوت: غير_موقع;
        دع ترتيب_مدخل_جوت: غير_موقع = ف + 3;
        دع عنوان_مدخل_جوت: غير_موقع = عنوان_جوت + ترتيب_مدخل_جوت * 8;
        طابق فرق_نسبي32_إلف(عنوان_مدخل + 6, عنوان_مدخل_جوت) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); }
        | اختيار.بعض(قيمة) -> { فرق_جوت := قيمة; };
        ألحق_غ32_إلف(&متغير بلت, فرق_جوت);
        ألحق_غ8_إلف(&متغير بلت, 0x68); ألحق_غ32_إلف(&متغير بلت, ف);
        ألحق_غ8_إلف(&متغير بلت, 0xE9);
        دع فرق_بلت0: غير_موقع;
        طابق فرق_نسبي32_إلف(عنوان_مدخل + 16, عنوان_بلت) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); }
        | اختيار.بعض(قيمة) -> { فرق_بلت0 := قيمة; };
        ألحق_غ32_إلف(&متغير بلت, فرق_بلت0);
        ف := ف + 1;
    }

    دع رموز_ديناميكية: متغير متجه غ8 = [];
    ألحق_أصفارا_إلف(&متغير رموز_ديناميكية, 24);
    ف := 0;
    بينما (ف < عدد_الخارجية) {
        ألحق_رمز_ديناميكي_إلف64(&متغير رموز_ديناميكية, إزاحات_أسماء_ديناميكية[ف]);
        ف := ف + 1;
    }
    دع هاش: متغير متجه غ8 = [];
    ألحق_غ32_إلف(&متغير هاش, 1);
    ألحق_غ32_إلف(&متغير هاش, عدد_الخارجية + 1);
    ألحق_غ32_إلف(&متغير هاش, 1);
    ألحق_غ32_إلف(&متغير هاش, 0);
    ف := 1;
    بينما (ف <= عدد_الخارجية) {
        لو (ف < عدد_الخارجية) { ألحق_غ32_إلف(&متغير هاش, ف + 1); }
        وإلا { ألحق_غ32_إلف(&متغير هاش, 0); };
        ف := ف + 1;
    }

    دع إزاحات_بلت: متغير متجه غ8 = [];
    ف := 0;
    بينما (ف < عدد_الخارجية) {
        دع ترتيب_إزاحة_جوت: غير_موقع = ف + 3;
        دع عنوان_إزاحة_جوت: غير_موقع = عنوان_جوت + ترتيب_إزاحة_جوت * 8;
        دع فهرس_رمز_ديناميكي: غير_موقع = ف + 1;
        دع معلومات_إزاحة_بلت: غير_موقع = فهرس_رمز_ديناميكي * 4294967296 + 7;
        ألحق_غ64_إلف(&متغير إزاحات_بلت, عنوان_إزاحة_جوت);
        ألحق_غ64_إلف(&متغير إزاحات_بلت, معلومات_إزاحة_بلت);
        ألحق_غ64_إلف(&متغير إزاحات_بلت, 0);
        ف := ف + 1;
    }
    دع جوت: متغير متجه غ8 = [];
    ألحق_غ64_إلف(&متغير جوت, عنوان_الديناميكي);
    ألحق_غ64_إلف(&متغير جوت, 0);
    ألحق_غ64_إلف(&متغير جوت, 0);
    ف := 0;
    بينما (ف < عدد_الخارجية) {
        دع ترتيب_جوت_بلت: غير_موقع = ف + 1;
        دع عنوان_جوت_بلت: غير_موقع = عنوان_بلت + ترتيب_جوت_بلت * 16 + 6;
        ألحق_غ64_إلف(&متغير جوت, عنوان_جوت_بلت);
        ف := ف + 1;
    }
    دع ديناميكي: متغير متجه غ8 = [];
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 1, إزاحة_اسم_مكتبة); // DT_NEEDED
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 4, أساس_التحميل + موضع_هاش); // DT_HASH
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 5, أساس_التحميل + موضع_النصوص_الديناميكية); // DT_STRTAB
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 6, أساس_التحميل + موضع_الرموز_الديناميكية); // DT_SYMTAB
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 10, حجم_النصوص_الديناميكية); // DT_STRSZ
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 11, 24); // DT_SYMENT
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 3, عنوان_جوت); // DT_PLTGOT
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 2, حجم_إزاحات_بلت); // DT_PLTRELSZ
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 20, 7); // DT_PLTREL=DT_RELA
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 23, أساس_التحميل + موضع_إزاحات_بلت); // DT_JMPREL
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 9, 24); // DT_RELAENT
    ألحق_مدخل_ديناميكي_إلف64(&متغير ديناميكي, 0, 0);

    دع التنفيذي: متغير متجه غ8 = [];
    ألحق_غ8_إلف(&متغير التنفيذي, 0x7F); ألحق_غ8_إلف(&متغير التنفيذي, 0x45);
    ألحق_غ8_إلف(&متغير التنفيذي, 0x4C); ألحق_غ8_إلف(&متغير التنفيذي, 0x46);
    ألحق_غ8_إلف(&متغير التنفيذي, 2); ألحق_غ8_إلف(&متغير التنفيذي, 1);
    ألحق_غ8_إلف(&متغير التنفيذي, 1); ألحق_غ8_إلف(&متغير التنفيذي, 0);
    ألحق_أصفارا_إلف(&متغير التنفيذي, 8);
    ألحق_غ16_إلف(&متغير التنفيذي, 2); ألحق_غ16_إلف(&متغير التنفيذي, 62); ألحق_غ32_إلف(&متغير التنفيذي, 1);
    ألحق_غ64_إلف(&متغير التنفيذي, عنوان_النص + إزاحة_دخول_العملية);
    ألحق_غ64_إلف(&متغير التنفيذي, 64); ألحق_غ64_إلف(&متغير التنفيذي, 0); ألحق_غ32_إلف(&متغير التنفيذي, 0);
    ألحق_غ16_إلف(&متغير التنفيذي, 64); ألحق_غ16_إلف(&متغير التنفيذي, 56); ألحق_غ16_إلف(&متغير التنفيذي, 4);
    ألحق_غ16_إلف(&متغير التنفيذي, 0); ألحق_غ16_إلف(&متغير التنفيذي, 0); ألحق_غ16_إلف(&متغير التنفيذي, 0);

    ألحق_رأس_برنامج_إلف64_خام(&متغير التنفيذي, 1, 5, 0, أساس_التحميل, نهاية_القراءة, نهاية_القراءة, حجم_الصفحة);
    ألحق_رأس_برنامج_إلف64_خام(&متغير التنفيذي, 1, 6, موضع_الكتابة, أساس_التحميل + موضع_الكتابة, نهاية_الملف - موضع_الكتابة, نهاية_الملف - موضع_الكتابة, حجم_الصفحة);
    ألحق_رأس_برنامج_إلف64_خام(&متغير التنفيذي, 3, 4, موضع_المفسر, أساس_التحميل + موضع_المفسر, حجم_المفسر, حجم_المفسر, 1);
    ألحق_رأس_برنامج_إلف64_خام(&متغير التنفيذي, 2, 6, موضع_الديناميكي, عنوان_الديناميكي, حجم_الديناميكي, حجم_الديناميكي, 8);

    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_المفسر)) { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };
    ألحق_بايتات_إلف(&متغير التنفيذي, &إعداد_الربط.مفسر_إلف);
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_النص)) { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };
    ألحق_بايتات_إلف(&متغير التنفيذي, &النص);
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_بلت)) { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };
    ألحق_بايتات_إلف(&متغير التنفيذي, &بلت);
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_النصوص_الديناميكية)) { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };
    ألحق_بايتات_إلف(&متغير التنفيذي, &جدول_النصوص_الديناميكي);
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_الرموز_الديناميكية)) { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };
    ألحق_بايتات_إلف(&متغير التنفيذي, &رموز_ديناميكية);
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_هاش)) { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };
    ألحق_بايتات_إلف(&متغير التنفيذي, &هاش);
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_إزاحات_بلت)) { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };
    ألحق_بايتات_إلف(&متغير التنفيذي, &إزاحات_بلت);
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_جوت)) { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };
    ألحق_بايتات_إلف(&متغير التنفيذي, &جوت);
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_الديناميكي)) { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };
    ألحق_بايتات_إلف(&متغير التنفيذي, &ديناميكي);
    لو ((الطول(التنفيذي) مثل غير_موقع) != نهاية_الملف) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    أرجع نتيجة_إنهاء_تنفيذي_إلف.نجح(التنفيذي);
}

عام عرف أنه_كائن_إلف_لينكس_إلى_تنفيذي(
    بايتات_الكائن: &متجه غ8,
    الهدف: &واصف_هدف,
    الرموز_الخارجية_المعلنة: &متجه متجه غ8
): نتيجة_إنهاء_تنفيذي_إلف {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { }
    | _ -> { أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح()); };

    لو (!ضمن_حدود_إلف(بايتات_الكائن, 0, 64)) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    دع ب: متجه غ8 = *بايتات_الكائن;
    لو (ب[0] != 0x7F || ب[1] != 0x45 || ب[2] != 0x4C || ب[3] != 0x46
        || ب[4] != 2 || ب[5] != 1 || ب[6] != 1) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    لو (اقرأ_غ16_إلف(بايتات_الكائن, 16) != 1
        || اقرأ_غ16_إلف(بايتات_الكائن, 18) != 62
        || اقرأ_غ32_إلف(بايتات_الكائن, 20) != 1
        || اقرأ_غ16_إلف(بايتات_الكائن, 52) != 64
        || اقرأ_غ16_إلف(بايتات_الكائن, 58) != 64) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };

    دع موضع_رؤوس_الأقسام: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, 40);
    دع عدد_الأقسام: غير_موقع = اقرأ_غ16_إلف(بايتات_الكائن, 60);
    لو (عدد_الأقسام < 5 || !ضمن_حدود_إلف(بايتات_الكائن, موضع_رؤوس_الأقسام, عدد_الأقسام * 64)) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };

    دع فهرس_نص: متغير غير_موقع = عدد_الأقسام;
    دع فهرس_رموز: متغير غير_موقع = عدد_الأقسام;
    دع ف: متغير غير_موقع = 1;
    بينما (ف < عدد_الأقسام) {
        دع م: غير_موقع = موضع_رؤوس_الأقسام + ف * 64;
        دع النوع: غير_موقع = اقرأ_غ32_إلف(بايتات_الكائن, م + 4);
        دع الأعلام: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, م + 8);
        دع الإزاحة: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, م + 24);
        دع الحجم: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, م + 32);
        لو (!ضمن_حدود_إلف(بايتات_الكائن, الإزاحة, الحجم)) {
            أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
        };
        لو (النوع == 1 && (الأعلام & 4) != 0) { فهرس_نص := ف; };
        لو (النوع == 2) { فهرس_رموز := ف; };
        ف := ف + 1;
    }
    لو (فهرس_نص == عدد_الأقسام || فهرس_رموز == عدد_الأقسام) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };

    دع رأس_الرموز: غير_موقع = موضع_رؤوس_الأقسام + فهرس_رموز * 64;
    دع موضع_حقل_موضع_الرموز: غير_موقع = رأس_الرموز + 24;
    دع موضع_حقل_حجم_الرموز: غير_موقع = رأس_الرموز + 32;
    دع موضع_حقل_فهرس_النصوص: غير_موقع = رأس_الرموز + 40;
    دع موضع_حقل_حجم_مدخل_الرمز: غير_موقع = رأس_الرموز + 56;
    دع موضع_الرموز: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_موضع_الرموز);
    دع حجم_الرموز: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_حجم_الرموز);
    دع فهرس_جدول_النصوص: غير_موقع = اقرأ_غ32_إلف(بايتات_الكائن, موضع_حقل_فهرس_النصوص);
    دع حجم_مدخل_الرمز: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_حجم_مدخل_الرمز);
    لو (حجم_مدخل_الرمز != 24 || (حجم_الرموز % 24) != 0 || فهرس_جدول_النصوص >= عدد_الأقسام) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    دع رأس_النصوص: غير_موقع = موضع_رؤوس_الأقسام + فهرس_جدول_النصوص * 64;
    دع موضع_نوع_النصوص: غير_موقع = رأس_النصوص + 4;
    دع نوع_النصوص: غير_موقع = اقرأ_غ32_إلف(بايتات_الكائن, موضع_نوع_النصوص);
    لو (نوع_النصوص != 3) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    دع موضع_حقل_موضع_النصوص: غير_موقع = رأس_النصوص + 24;
    دع موضع_حقل_حجم_النصوص: غير_موقع = رأس_النصوص + 32;
    دع موضع_النصوص: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_موضع_النصوص);
    دع حجم_النصوص: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_حجم_النصوص);
    لو (!ضمن_حدود_إلف(بايتات_الكائن, موضع_الرموز, حجم_الرموز)
        || !ضمن_حدود_إلف(بايتات_الكائن, موضع_النصوص, حجم_النصوص)) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };

    دع عدد_الرموز: غير_موقع = حجم_الرموز / 24;
    دع فهرس_إزاحات_النص: متغير غير_موقع = عدد_الأقسام;
    ف := 1;
    بينما (ف < عدد_الأقسام) {
        دع م: غير_موقع = موضع_رؤوس_الأقسام + ف * 64;
        لو (اقرأ_غ32_إلف(بايتات_الكائن, م + 4) == 4
            && اقرأ_غ32_إلف(بايتات_الكائن, م + 44) == فهرس_نص) {
            لو (فهرس_إزاحات_النص != عدد_الأقسام) {
                أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
            };
            فهرس_إزاحات_النص := ف;
        };
        ف := ف + 1;
    }
    لو (فهرس_إزاحات_النص == عدد_الأقسام) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    دع رأس_إزاحات_النص: غير_موقع = موضع_رؤوس_الأقسام + فهرس_إزاحات_النص * 64;
    دع موضع_حقل_موضع_الإزاحات: غير_موقع = رأس_إزاحات_النص + 24;
    دع موضع_حقل_حجم_الإزاحات: غير_موقع = رأس_إزاحات_النص + 32;
    دع موضع_حقل_رابط_الإزاحات: غير_موقع = رأس_إزاحات_النص + 40;
    دع موضع_حقل_حجم_مدخل_الإزاحة: غير_موقع = رأس_إزاحات_النص + 56;
    دع موضع_إزاحات_النص: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_موضع_الإزاحات);
    دع حجم_إزاحات_النص: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_حجم_الإزاحات);
    دع رابط_الإزاحات: غير_موقع = اقرأ_غ32_إلف(بايتات_الكائن, موضع_حقل_رابط_الإزاحات);
    دع حجم_مدخل_الإزاحة: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_حجم_مدخل_الإزاحة);
    لو (رابط_الإزاحات != فهرس_رموز
        || حجم_مدخل_الإزاحة != 24
        || (حجم_إزاحات_النص % 24) != 0
        || !ضمن_حدود_إلف(بايتات_الكائن, موضع_إزاحات_النص, حجم_إزاحات_النص)) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    دع رأس_النص: غير_موقع = موضع_رؤوس_الأقسام + فهرس_نص * 64;
    دع موضع_حقل_موضع_النص: غير_موقع = رأس_النص + 24;
    دع موضع_النص_في_الكائن: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_موضع_النص);
    دع موضع_حقل_حجم_النص: غير_موقع = رأس_النص + 32;
    دع حجم_النص: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_حقل_حجم_النص);
    دع عدد_الإزاحات: غير_موقع = حجم_إزاحات_النص / 24;
    ف := 0;
    بينما (ف < عدد_الإزاحات) {
        دع م: غير_موقع = موضع_إزاحات_النص + ف * 24;
        دع موضع_الرقعة: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, م);
        دع موضع_معلومات_الرقعة: غير_موقع = م + 8;
        دع معلومات_الرقعة: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_معلومات_الرقعة);
        دع فهرس_رمز_الرقعة: غير_موقع = معلومات_الرقعة / 4294967296;
        دع نوع_الرقعة: غير_موقع = معلومات_الرقعة % 4294967296;
        دع موضع_الإضافة_المنخفضة: غير_موقع = م + 16;
        دع موضع_الإضافة_العليا: غير_موقع = م + 20;
        دع إضافة_منخفضة: غير_موقع = اقرأ_غ32_إلف(بايتات_الكائن, موضع_الإضافة_المنخفضة);
        دع إضافة_عليا: غير_موقع = اقرأ_غ32_إلف(بايتات_الكائن, موضع_الإضافة_العليا);
        دع نهاية_الرقعة: غير_موقع = موضع_الرقعة + 4;
        لو (نهاية_الرقعة > حجم_النص
            || فهرس_رمز_الرقعة >= عدد_الرموز
            || نوع_الرقعة != 4
            || إضافة_منخفضة != 0xFFFFFFFC
            || إضافة_عليا != 0xFFFFFFFF) {
            أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
        };
        ف := ف + 1;
    }

    دع اسم_الدخول: متجه غ8 = [0x5F,0x73,0x74,0x61,0x72,0x74];
    دع وجد_الدخول: متغير منطقي = خطأ;
    دع إزاحة_دخول_العملية: متغير غير_موقع = 0;
    دع فهارس_الخارجية: متغير متجه غير_موقع = [];
    دع أسماء_الخارجية: متغير متجه متجه غ8 = [];
    ف := 1;
    بينما (ف < عدد_الرموز) {
        دع م: غير_موقع = موضع_الرموز + ف * 24;
        دع إزاحة_الاسم: غير_موقع = اقرأ_غ32_إلف(بايتات_الكائن, م);
        دع موضع_فهرس_القسم: غير_موقع = م + 6;
        دع موضع_قيمة_الرمز: غير_موقع = م + 8;
        دع فهرس_القسم: غير_موقع = اقرأ_غ16_إلف(بايتات_الكائن, موضع_فهرس_القسم);
        دع قيمة_الرمز: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_قيمة_الرمز);
        لو (إزاحة_الاسم >= حجم_النصوص) {
            أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
        };
        دع الاسم: متجه غ8;
        دع بداية_اسم_الرمز: غير_موقع = موضع_النصوص + إزاحة_الاسم;
        دع نهاية_جدول_النصوص: غير_موقع = موضع_النصوص + حجم_النصوص;
        طابق اقرأ_اسم_صفري_إلف(بايتات_الكائن, بداية_اسم_الرمز, نهاية_جدول_النصوص) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
        }
        | اختيار.بعض(ن) -> {
            الاسم := ن;
        };
        لو (فهرس_القسم == 0) {
            طابق صنف_رمز_خارجي_تنفيذي_للهدف(&الاسم, الهدف) مع
            | صنف_رمز_خارجي_تنفيذي_هدف.بدائي_تشغيل_غير_مضمن -> {
                أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.بدائي_تشغيل_إلف_غير_مخفض());
            }
            | صنف_رمز_خارجي_تنفيذي_هدف.مكتبة_نظام -> { }
            | صنف_رمز_خارجي_تنفيذي_هدف.غير_معروف -> {
                لو (!اسم_خارجي_معلن_إلف(&الاسم, الرموز_الخارجية_المعلنة)) {
                    أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.رمز_خارجي_إلف_غير_معروف());
                };
            };
            ألحق(فهارس_الخارجية, ف);
            دع نسخة_اسم_خارجي: متجه غ8 = انسخ_اسم_رمز_خارجي_كائن(&الاسم);
            ألحق(أسماء_الخارجية, نسخة_اسم_خارجي);
        } وإلا لو (فهرس_القسم == فهرس_نص) {
            لو (اسما_إلف_متساويان(&الاسم, &اسم_الدخول)) {
                لو (وجد_الدخول || قيمة_الرمز >= حجم_النص) {
                    أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
                };
                وجد_الدخول := صواب;
                إزاحة_دخول_العملية := قيمة_الرمز;
            };
        };
        ف := ف + 1;
    }
    لو (!وجد_الدخول) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.رمز_دخول_إلف_مفقود());
    };

    دع النص_المنقول: متغير متجه غ8 = [];
    ف := 0;
    بينما (ف < حجم_النص) {
        دع موضع_بايت_الكائن: غير_موقع = موضع_النص_في_الكائن + ف;
        دع بايت_النص: غ8 = ب[موضع_بايت_الكائن];
        ألحق(النص_المنقول, بايت_النص);
        ف := ف + 1;
    }

    لو ((الطول(فهارس_الخارجية) مثل غير_موقع) > 0) {
        أرجع ابن_تنفيذي_إلف_ديناميكي(
            &النص_المنقول,
            إزاحة_دخول_العملية,
            بايتات_الكائن,
            موضع_الرموز,
            موضع_إزاحات_النص,
            عدد_الإزاحات,
            &فهارس_الخارجية,
            &أسماء_الخارجية,
            الهدف
        );
    };

    دع أساس_التحميل: غير_موقع = 0x400000;
    دع حجم_الصفحة: غير_موقع = 0x1000;
    دع موضع_النص_التنفيذي: غير_موقع = حجم_الصفحة;
    دع عنوان_النص: غير_موقع = أساس_التحميل + موضع_النص_التنفيذي;

    ف := 0;
    بينما (ف < عدد_الإزاحات) {
        دع موضع_مدخل_الإزاحة: غير_موقع = موضع_إزاحات_النص + ف * 24;
        دع موضع_الرقعة: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_مدخل_الإزاحة);
        دع موضع_معلومة_الإزاحة: غير_موقع = موضع_مدخل_الإزاحة + 8;
        دع معلومات_الرقعة: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_معلومة_الإزاحة);
        دع فهرس_رمز_الرقعة: غير_موقع = معلومات_الرقعة / 4294967296;
        دع موضع_رمز_الرقعة: غير_موقع = موضع_الرموز + فهرس_رمز_الرقعة * 24;
        دع موضع_قسم_رمز_الرقعة: غير_موقع = موضع_رمز_الرقعة + 6;
        دع قسم_رمز_الرقعة: غير_موقع = اقرأ_غ16_إلف(بايتات_الكائن, موضع_قسم_رمز_الرقعة);
        لو (قسم_رمز_الرقعة != فهرس_نص) {
            أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.رمز_خارجي_إلف_غير_معروف());
        };
        دع موضع_قيمة_رمز_الرقعة: غير_موقع = موضع_رمز_الرقعة + 8;
        دع قيمة_رمز_الرقعة: غير_موقع = اقرأ_غ64_إلف(بايتات_الكائن, موضع_قيمة_رمز_الرقعة);
        لو (قيمة_رمز_الرقعة >= حجم_النص) {
            أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
        };
        دع عنوان_الرمز: غير_موقع = عنوان_النص + قيمة_رمز_الرقعة;
        دع عنوان_الرقعة: غير_موقع = عنوان_النص + موضع_الرقعة;
        دع بعد_الحقل: غير_موقع = عنوان_الرقعة + 4;
        دع الفرق_الموقع: متغير عدد = 0;
        لو (عنوان_الرمز >= بعد_الحقل) {
            دع الفرق: غير_موقع = عنوان_الرمز - بعد_الحقل;
            لو (الفرق > 2147483647) {
                أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
            };
            الفرق_الموقع := الفرق مثل عدد;
        } وإلا {
            دع الفرق: غير_موقع = بعد_الحقل - عنوان_الرمز;
            لو (الفرق > 2147483648) {
                أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
            };
            الفرق_الموقع := -((الفرق) مثل عدد);
        };
        دع قيمة_نسبية: متغير غير_موقع = 0;
        لو (الفرق_الموقع < 0) {
            دع ملفوف: عدد = 4294967296 + الفرق_الموقع;
            قيمة_نسبية := ملفوف مثل غير_موقع;
        } وإلا {
            قيمة_نسبية := الفرق_الموقع مثل غير_موقع;
        };
        لو (!اكتب_غ32_إلف_في(&متغير النص_المنقول, موضع_الرقعة, قيمة_نسبية)) {
            أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
        };
        ف := ف + 1;
    }

    دع جدول_أسماء_الأقسام: متجه غ8 = [
        0,
        0x2E,0x74,0x65,0x78,0x74,0,
        0x2E,0x73,0x68,0x73,0x74,0x72,0x74,0x61,0x62,0
    ];
    دع حجم_جدول_أسماء_الأقسام: غير_موقع = الطول(جدول_أسماء_الأقسام) مثل غير_موقع;
    دع موضع_جدول_أسماء_الأقسام: غير_موقع = موضع_النص_التنفيذي + حجم_النص;
    دع نهاية_جدول_أسماء_الأقسام: غير_موقع = موضع_جدول_أسماء_الأقسام + حجم_جدول_أسماء_الأقسام;
    دع موضع_رؤوس_أقسام_التنفيذي: غير_موقع = حاذ_إلف(نهاية_جدول_أسماء_الأقسام, 8);
    دع حجم_رؤوس_أقسام_التنفيذي: غير_موقع = 192;
    دع نهاية_الملف: غير_موقع = موضع_رؤوس_أقسام_التنفيذي + حجم_رؤوس_أقسام_التنفيذي;
    دع نهاية_الجزء_المحمول: غير_موقع = موضع_النص_التنفيذي + حجم_النص;
    دع عنوان_الدخول: غير_موقع = عنوان_النص + إزاحة_دخول_العملية;

    دع التنفيذي: متغير متجه غ8 = [];
    ألحق_غ8_إلف(&متغير التنفيذي, 0x7F);
    ألحق_غ8_إلف(&متغير التنفيذي, 0x45);
    ألحق_غ8_إلف(&متغير التنفيذي, 0x4C);
    ألحق_غ8_إلف(&متغير التنفيذي, 0x46);
    ألحق_غ8_إلف(&متغير التنفيذي, 2);
    ألحق_غ8_إلف(&متغير التنفيذي, 1);
    ألحق_غ8_إلف(&متغير التنفيذي, 1);
    ألحق_غ8_إلف(&متغير التنفيذي, 0);
    ألحق_أصفارا_إلف(&متغير التنفيذي, 8);
    ألحق_غ16_إلف(&متغير التنفيذي, 2); // ET_EXEC
    ألحق_غ16_إلف(&متغير التنفيذي, 62); // EM_X86_64
    ألحق_غ32_إلف(&متغير التنفيذي, 1);
    ألحق_غ64_إلف(&متغير التنفيذي, عنوان_الدخول);
    ألحق_غ64_إلف(&متغير التنفيذي, 64);
    ألحق_غ64_إلف(&متغير التنفيذي, موضع_رؤوس_أقسام_التنفيذي);
    ألحق_غ32_إلف(&متغير التنفيذي, 0);
    ألحق_غ16_إلف(&متغير التنفيذي, 64);
    ألحق_غ16_إلف(&متغير التنفيذي, 56);
    ألحق_غ16_إلف(&متغير التنفيذي, 1);
    ألحق_غ16_إلف(&متغير التنفيذي, 64);
    ألحق_غ16_إلف(&متغير التنفيذي, 3);
    ألحق_غ16_إلف(&متغير التنفيذي, 2);

    ألحق_رأس_برنامج_إلف64_تنفيذي(
        &متغير التنفيذي,
        0,
        أساس_التحميل,
        نهاية_الجزء_المحمول,
        نهاية_الجزء_المحمول,
        5,
        حجم_الصفحة
    );
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_النص_التنفيذي)) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    ف := 0;
    بينما (ف < حجم_النص) {
        دع بايت_التنفيذي: غ8 = النص_المنقول[ف];
        ألحق(التنفيذي, بايت_التنفيذي);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < حجم_جدول_أسماء_الأقسام) {
        دع بايت_اسم_قسم: غ8 = جدول_أسماء_الأقسام[ف];
        ألحق(التنفيذي, بايت_اسم_قسم);
        ف := ف + 1;
    }
    لو (!أكمل_إلف_إلى(&متغير التنفيذي, موضع_رؤوس_أقسام_التنفيذي)) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    ألحق_أصفارا_إلف(&متغير التنفيذي, 64);
    ألحق_رأس_قسم_إلف64_تنفيذي(
        &متغير التنفيذي,
        1,
        1,
        6,
        عنوان_النص,
        موضع_النص_التنفيذي,
        حجم_النص,
        16
    );
    ألحق_رأس_قسم_إلف64_تنفيذي(
        &متغير التنفيذي,
        7,
        3,
        0,
        0,
        موضع_جدول_أسماء_الأقسام,
        حجم_جدول_أسماء_الأقسام,
        1
    );
    دع الحجم_الفعلي: غير_موقع = الطول(التنفيذي) مثل غير_موقع;
    لو (الحجم_الفعلي != نهاية_الملف) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    أرجع نتيجة_إنهاء_تنفيذي_إلف.نجح(التنفيذي);
}
