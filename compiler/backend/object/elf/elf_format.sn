عرف عدد_إزاحات_دوارف_إلف(دوارف: &حزمة_دوارف, النوع: نوع_قسم_دوارف_إلف): طبيعي {
    ليكن العدد: متغير طبيعي = 0; ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*دوارف).رقع_العناوين) مثل طبيعي)) {
        إذا (رقعة_دوارف_لقسم_إلف(&(*دوارف).رقع_العناوين[ف], النوع)) { العدد := العدد + 1; }; ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*دوارف).رقع_الأقسام) مثل طبيعي)) {
        إذا (رقعة_قسم_دوارف_لقسم_إلف(&(*دوارف).رقع_الأقسام[ف], النوع)) { العدد := العدد + 1; }; ف := ف + 1; }
    أرجع العدد;
}

// R_X86_64_32 / R_X86_64_64, or R_AARCH64_ABS32 / R_AARCH64_ABS64.
عرف نوع_إزاحة_دوارف_إلف_للعرض(العرض: طبيعي, الآلة: طبيعي): اختياري طبيعي {
    إذا (الآلة == 183) {
        إذا (العرض == 4) { أرجع اختياري.موجود(258); };
        إذا (العرض == 8) { أرجع اختياري.موجود(257); };
        أرجع اختياري.لا_شيء();
    };
    إذا (العرض == 4) { أرجع اختياري.موجود(10); };
    إذا (العرض == 8) { أرجع اختياري.موجود(1); };
    أرجع اختياري.لا_شيء();
}

// The absolute 64-bit relocation of the object's machine.
عرف نوع_إزاحة_مطلقة_إلف(الآلة: طبيعي): طبيعي {
    إذا (الآلة == 183) { أرجع 257; };
    أرجع 1;
}

عرف ألحق_إزاحات_دوارف_إلف(
    ب: &متغير متجه ط8,
    دوارف: &حزمة_دوارف,
    النوع: نوع_قسم_دوارف_إلف,
    الأقسام_الفعالة: &متجه نوع_قسم_دوارف_إلف,
    الآلة: طبيعي
): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*دوارف).رقع_العناوين) مثل طبيعي)) {
        ليكن الرقعة: رقعة_عنوان_دوارف = (*دوارف).رقع_العناوين[ف];
        إذا (رقعة_دوارف_لقسم_إلف(&الرقعة, النوع)) {
            ليكن فهرس_رمز_القسم: متغير طبيعي = 1;
            طابق الرقعة.المرجع.القاعدة مع | قاعدة_عنوان_دوارف.نص -> { فهرس_رمز_القسم := 1;
            } | قاعدة_عنوان_دوارف.بيانات -> { فهرس_رمز_القسم := 2; };
            طابق نوع_إزاحة_دوارف_إلف_للعرض(الرقعة.العرض, الآلة) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(نوع_إلف) -> {
                ألحق_ط64_إلف(ب, الرقعة.الموضع);
                ألحق_ط64_إلف(ب, فهرس_رمز_القسم * 4294967296 + نوع_إلف);
                ألحق_ط64_إلف(ب, الرقعة.المرجع.إزاحة_بايت);
            };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*دوارف).رقع_الأقسام) مثل طبيعي)) {
        ليكن الرقعة: رقعة_قسم_دوارف = (*دوارف).رقع_الأقسام[ف];
        إذا (رقعة_قسم_دوارف_لقسم_إلف(&الرقعة, النوع)) {
            طابق فهرس_رمز_قسم_دوارف_إلف(الأقسام_الفعالة, الرقعة.الهدف) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(فهرس_رمز_القسم) -> {
                طابق نوع_إزاحة_دوارف_إلف_للعرض(الرقعة.العرض, الآلة) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(نوع_إلف) -> {
                    ألحق_ط64_إلف(ب, الرقعة.الموضع);
                    ألحق_ط64_إلف(ب, فهرس_رمز_القسم * 4294967296 + نوع_إلف);
                    ألحق_ط64_إلف(ب, الرقعة.الإزاحة);
                };
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أضف_اسم_قسم_إلف(الجدول: &متغير متجه ط8, الاسم: &متجه ط8): طبيعي {
    ليكن الإزاحة: طبيعي = الطول(*الجدول) مثل طبيعي; ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) { ألحق(*الجدول, (*الاسم)[ف]); ف := ف + 1; }
    ألحق(*الجدول, 0 مثل ط8); أرجع الإزاحة;
}

عرف اسم_دخول_عملية_إلف(): متجه ط8 {
    ليكن الاسم: متجه ط8 = بايتات_من_نص(«_start»);
    أرجع الاسم;
}

عرف ألحق_رمز_إلف64(
    البايتات: &متغير متجه ط8,
    اسم: طبيعي,
    المعلومة: طبيعي,
    فهرس_القسم: طبيعي,
    القيمة: طبيعي,
    الحجم: طبيعي
): فراغ {
    ألحق_ط32_إلف(البايتات, اسم);
    ألحق_ط8_إلف(البايتات, المعلومة);
    ألحق_ط8_إلف(البايتات, 0);
    ألحق_ط16_إلف(البايتات, فهرس_القسم);
    ألحق_ط64_إلف(البايتات, القيمة);
    ألحق_ط64_إلف(البايتات, الحجم);
}

عرف ألحق_رأس_قسم_إلف64(
    البايتات: &متغير متجه ط8,
    الاسم: طبيعي,
    النوع: طبيعي,
    الأعلام: طبيعي,
    الإزاحة: طبيعي,
    الحجم: طبيعي,
    الرابط: طبيعي,
    المعلومة: طبيعي,
    المحاذاة: طبيعي,
    حجم_المدخل: طبيعي
): فراغ {
    ألحق_ط32_إلف(البايتات, الاسم);
    ألحق_ط32_إلف(البايتات, النوع);
    ألحق_ط64_إلف(البايتات, الأعلام);
    ألحق_ط64_إلف(البايتات, 0);
    ألحق_ط64_إلف(البايتات, الإزاحة);
    ألحق_ط64_إلف(البايتات, الحجم);
    ألحق_ط32_إلف(البايتات, الرابط);
    ألحق_ط32_إلف(البايتات, المعلومة);
    ألحق_ط64_إلف(البايتات, المحاذاة);
    ألحق_ط64_إلف(البايتات, حجم_المدخل);
}

عام عرف اكتب_كائن_إلف64(الكائن: &كائن_إلف): نتيجة_تسلسل_إلف {
    // Rebuild only the temporary identity index for relocation encoding.
    // The symbol vector is authoritative; its positions never change.
    ليكن فهرس_الهوية: متغير الخريطة<مرجع_رمز_كائن, طبيعي> = أنشئ_فهرس_هوية_رمز_إلف();
    ليكن فهرس_بناء: متغير طبيعي = 0;
    طالما (فهرس_بناء < (الطول((*الكائن).الرموز) مثل طبيعي)) {
        ليكن المفتاح: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&(*الكائن).الرموز[فهرس_بناء].المرجع);
        ليكن فهرس_رمز_ثابت: طبيعي = فهرس_بناء;
        طابق أدرج_في_الخريطة(&متغير فهرس_الهوية, المفتاح, فهرس_رمز_ثابت) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); }
        | نتيجة.نجح(السابق) -> {
            طابق السابق مع
            | اختياري.موجود(_) -> { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.رمز_مكرر()); }
            | اختياري.لا_شيء -> { };
        };
        فهرس_بناء := فهرس_بناء + 1;
    }
    ليكن إزاحات_الأسماء: متغير متجه طبيعي = [];
    ليكن حجم_النصوص: متغير طبيعي = احسب_إزاحات_نصوص_رموز_إلف(
        &(*الكائن).الرموز, &متغير إزاحات_الأسماء
    );
    ليكن إزاحة_اسم_دخول_العملية: متغير طبيعي = 0;
    طابق (*الكائن).دخول_العملية مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(_) -> {
        إزاحة_اسم_دخول_العملية := حجم_النصوص;
        // "_start" has six ASCII bytes including its NUL terminator.
        حجم_النصوص := حجم_النصوص + 7;
    };

    ليكن أقسام_دوارف: متجه نوع_قسم_دوارف_إلف = أقسام_دوارف_إلف_الفعالة(&(*الكائن).دوارف);
    ليكن أنواع_إزاحات_دوارف: متغير متجه نوع_قسم_دوارف_إلف = [];
    ليكن فهارس_هدف_إزاحات_دوارف: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(أقسام_دوارف) مثل طبيعي)) {
        إذا (عدد_إزاحات_دوارف_إلف(&(*الكائن).دوارف, أقسام_دوارف[ف]) > 0) {
            ألحق(أنواع_إزاحات_دوارف, أقسام_دوارف[ف]);
            ألحق(فهارس_هدف_إزاحات_دوارف, 7 + ف);
        };
        ف := ف + 1;
    }

    ليكن جدول_أسماء_الأقسام: متغير متجه ط8 = [0];
    ليكن اسم_نص: متجه ط8 = بايتات_من_نص(«.text»);
    ليكن اسم_بيانات: متجه ط8 = بايتات_من_نص(«.data»);
    ليكن اسم_إزاحات_نص: متجه ط8 = بايتات_من_نص(«.rela.text»);
    ليكن اسم_إزاحات_بيانات: متجه ط8 = بايتات_من_نص(«.rela.data»);
    ليكن اسم_رموز: متجه ط8 = بايتات_من_نص(«.symtab»);
    ليكن اسم_نصوص: متجه ط8 = بايتات_من_نص(«.strtab»);
    ليكن اسم_أسماء_الأقسام: متجه ط8 = بايتات_من_نص(«.shstrtab»);
    ليكن إزاحة_اسم_النص: طبيعي = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_نص);
    ليكن إزاحة_اسم_البيانات: طبيعي = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_بيانات);
    ليكن إزاحة_اسم_إزاحات_النص: طبيعي = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_إزاحات_نص);
    ليكن إزاحة_اسم_إزاحات_بيانات: طبيعي = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_إزاحات_بيانات);
    ليكن إزاحة_اسم_الرموز: طبيعي = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_رموز);
    ليكن إزاحة_اسم_النصوص: طبيعي = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_نصوص);
    ليكن إزاحات_أسماء_دوارف: متغير متجه طبيعي = [];
    ف := 0; طالما (ف < (الطول(أقسام_دوارف) مثل طبيعي)) {
        ليكن اسم: متجه ط8 = اسم_قسم_دوارف_إلف(أقسام_دوارف[ف]);
        ألحق(إزاحات_أسماء_دوارف, أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم)); ف := ف + 1; }
    ليكن إزاحات_أسماء_إزاحات_دوارف: متغير متجه طبيعي = [];
    ف := 0; طالما (ف < (الطول(أنواع_إزاحات_دوارف) مثل طبيعي)) {
        ليكن اسم: متجه ط8 = اسم_إزاحات_قسم_دوارف_إلف(أنواع_إزاحات_دوارف[ف]);
        ألحق(إزاحات_أسماء_إزاحات_دوارف, أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم)); ف := ف + 1; }
    ليكن إزاحة_اسم_منشئات: متغير طبيعي = 0;
    ليكن إزاحة_اسم_إزاحات_منشئات: متغير طبيعي = 0;
    ليكن يوجد_منشئ: منطقي;
    طابق (*الكائن).منشئ_الوحدة مع
    | اختياري.موجود(_) -> { يوجد_منشئ := صواب; }
    | اختياري.لا_شيء -> { يوجد_منشئ := خطأ; };
    إذا (يوجد_منشئ) {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.init_array»);
        ليكن اسم_الإزاحات: متجه ط8 = بايتات_من_نص(«.rela.init_array»);
        إزاحة_اسم_منشئات := أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &الاسم);
        إزاحة_اسم_إزاحات_منشئات := أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_الإزاحات);
    };
    ليكن يوجد_وسم: منطقي = الطول((*الكائن).ملاحظة_الوسم) > 0;
    ليكن إزاحة_اسم_الوسم: متغير طبيعي = 0;
    إذا (يوجد_وسم) {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.note.tag»);
        إزاحة_اسم_الوسم := أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &الاسم);
    };
    ليكن إزاحة_اسم_جدول_الأقسام: طبيعي = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_أسماء_الأقسام);

    ليكن حجم_الرأس: طبيعي = 64;
    ليكن إزاحة_النص: طبيعي = حاذ_إلف(حجم_الرأس, 16);
    ليكن حجم_النص: طبيعي = الطول((*الكائن).النص) مثل طبيعي;
    ليكن محاذاة_البيانات: متغير طبيعي = (*الكائن).محاذاة_البيانات;
    إذا (محاذاة_البيانات == 0) { محاذاة_البيانات := 1; };
    ليكن إزاحة_البيانات: طبيعي = حاذ_إلف(إزاحة_النص + حجم_النص, محاذاة_البيانات);
    ليكن حجم_البيانات: طبيعي = الطول((*الكائن).البيانات) مثل طبيعي;
    ليكن إزاحة_الإزاحات: طبيعي = حاذ_إلف(إزاحة_البيانات + حجم_البيانات, 8);
    ليكن عدد_الإزاحات: طبيعي = الطول((*الكائن).الإزاحات) مثل طبيعي;
    ليكن عدد_إزاحات_النص: متغير طبيعي = 0;
    ليكن عدد_إزاحات_البيانات: متغير طبيعي = 0;
    ليكن فهرس_الطلب: متغير طبيعي = 0;
    طالما (فهرس_الطلب < عدد_الإزاحات) {
        إذا ((*الكائن).الإزاحات[فهرس_الطلب].في_البيانات) {
            عدد_إزاحات_البيانات := عدد_إزاحات_البيانات + 1;
        } وإلا { عدد_إزاحات_النص := عدد_إزاحات_النص + 1; };
        فهرس_الطلب := فهرس_الطلب + 1;
    }
    ليكن إزاحة_إزاحات_البيانات: طبيعي = إزاحة_الإزاحات + عدد_إزاحات_النص * 24;
    ليكن إزاحة_الرموز: طبيعي = حاذ_إلف(
        إزاحة_إزاحات_البيانات + عدد_إزاحات_البيانات * 24, 8
    );
    ليكن عدد_رموز_الكائن: طبيعي = الطول((*الكائن).الرموز) مثل طبيعي; ليكن عدد_رموز_الدخول: متغير طبيعي = 0;
    // Index GOT data references while emitting relocations rather than
    // rescanning all relocations for each undefined symbol.
    ليكن رموز_بيانات_جوت: متغير متجه منطقي = [];
    ليكن فهرس_رمز_جوت: متغير طبيعي = 0;
    طالما (فهرس_رمز_جوت < عدد_رموز_الكائن) {
        ألحق(رموز_بيانات_جوت, خطأ);
        فهرس_رمز_جوت := فهرس_رمز_جوت + 1;
    }
    طابق (*الكائن).دخول_العملية مع | اختياري.لا_شيء -> { } | اختياري.موجود(_) -> { عدد_رموز_الدخول := 1; };
    ليكن عدد_رموز_أقسام_دوارف: طبيعي = الطول(أقسام_دوارف) مثل طبيعي;
    ليكن أول_رمز_عام: طبيعي = 3 + عدد_رموز_أقسام_دوارف;
    ليكن عدد_الرموز: طبيعي = عدد_رموز_الكائن + أول_رمز_عام + عدد_رموز_الدخول;
    ليكن حجم_الرموز: طبيعي = عدد_الرموز * 24;
    ليكن إزاحة_النصوص: طبيعي = إزاحة_الرموز + حجم_الرموز;

    ليكن إزاحات_أقسام_دوارف: متغير متجه طبيعي = []; ليكن موضع: متغير طبيعي = إزاحة_النصوص + حجم_النصوص;
    ف := 0; طالما (ف < (الطول(أقسام_دوارف) مثل طبيعي)) { موضع := حاذ_إلف(موضع,
        محاذاة_قسم_دوارف_إلف(أقسام_دوارف[ف])); ألحق(إزاحات_أقسام_دوارف, موضع);
        موضع := موضع + حجم_قسم_دوارف_إلف(&(*الكائن).دوارف, أقسام_دوارف[ف]); ف := ف + 1; }
    ليكن إزاحات_أقسام_إزاحات_دوارف: متغير متجه طبيعي = [];
    ف := 0; طالما (ف < (الطول(أنواع_إزاحات_دوارف) مثل طبيعي)) { موضع := حاذ_إلف(موضع, 8);
        ألحق(إزاحات_أقسام_إزاحات_دوارف, موضع);
        موضع := موضع + عدد_إزاحات_دوارف_إلف(&(*الكائن).دوارف, أنواع_إزاحات_دوارف[ف]) * 24; ف := ف + 1; }
    ليكن إزاحة_منشئات: متغير طبيعي = 0;
    ليكن إزاحة_إزاحات_منشئات: متغير طبيعي = 0;
    إذا (يوجد_منشئ) {
        إزاحة_منشئات := حاذ_إلف(موضع, 8);
        إزاحة_إزاحات_منشئات := إزاحة_منشئات + 8;
        موضع := إزاحة_إزاحات_منشئات + 24;
    };
    ليكن إزاحة_الوسم: متغير طبيعي = 0;
    إذا (يوجد_وسم) {
        إزاحة_الوسم := حاذ_إلف(موضع, 4);
        موضع := إزاحة_الوسم + (الطول((*الكائن).ملاحظة_الوسم) مثل طبيعي);
    };
    ليكن إزاحة_أسماء_الأقسام: طبيعي = موضع;
    ليكن حجم_أسماء_الأقسام: طبيعي = الطول(جدول_أسماء_الأقسام) مثل طبيعي;
    ليكن إزاحة_رؤوس_الأقسام: طبيعي = حاذ_إلف(إزاحة_أسماء_الأقسام + حجم_أسماء_الأقسام, 8);
    ليكن عدد_أقسام_دوارف_للفهرس: طبيعي = الطول(أقسام_دوارف) مثل طبيعي;
    ليكن عدد_أقسام_إزاحات_دوارف_للفهرس: طبيعي = الطول(أنواع_إزاحات_دوارف) مثل طبيعي;
    ليكن فهرس_منشئات: طبيعي = 7 + عدد_أقسام_دوارف_للفهرس + عدد_أقسام_إزاحات_دوارف_للفهرس;
    ليكن عدد_أقسام_المنشئات: متغير طبيعي = 0;
    إذا (يوجد_منشئ) { عدد_أقسام_المنشئات := 2; };
    ليكن عدد_أقسام_الوسم: متغير طبيعي = 0;
    إذا (يوجد_وسم) { عدد_أقسام_الوسم := 1; };
    ليكن فهرس_جدول_أسماء_الأقسام: طبيعي = فهرس_منشئات + عدد_أقسام_المنشئات + عدد_أقسام_الوسم;
    ليكن عدد_الأقسام: طبيعي = فهرس_جدول_أسماء_الأقسام + 1;
    // SHN_LORESERVE requires extended section numbering, not emitted here.
    إذا (عدد_الأقسام >= 0xFF00) {
        أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
    };

    ليكن البايتات: متغير متجه ط8 = [];
    ألحق_ط8_إلف(&متغير البايتات, 0x7F); ألحق_ط8_إلف(&متغير البايتات, 0x45); ألحق_ط8_إلف(&متغير البايتات, 0x4C);
    ألحق_ط8_إلف(&متغير البايتات, 0x46);
    ألحق_ط8_إلف(&متغير البايتات, 2); ألحق_ط8_إلف(&متغير البايتات, 1); ألحق_ط8_إلف(&متغير البايتات, 1);
    ألحق_ط8_إلف(&متغير البايتات, (*الكائن).هوية_النظام); ألحق_أصفارا_إلف(&متغير البايتات, 8);
    ألحق_ط16_إلف(&متغير البايتات, 1); ألحق_ط16_إلف(&متغير البايتات, (*الكائن).الآلة);
    ألحق_ط32_إلف(&متغير البايتات, 1);
    ألحق_ط64_إلف(&متغير البايتات, 0); ألحق_ط64_إلف(&متغير البايتات, 0);
    ألحق_ط64_إلف(&متغير البايتات, إزاحة_رؤوس_الأقسام);
    ألحق_ط32_إلف(&متغير البايتات, 0); ألحق_ط16_إلف(&متغير البايتات, 64); ألحق_ط16_إلف(&متغير البايتات, 0);
    ألحق_ط16_إلف(&متغير البايتات, 0); ألحق_ط16_إلف(&متغير البايتات, 64);
    ألحق_ط16_إلف(&متغير البايتات, عدد_الأقسام); ألحق_ط16_إلف(&متغير البايتات, فهرس_جدول_أسماء_الأقسام);

    إذا (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_النص)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };
    ألحق_بايتات_إلف(&متغير البايتات, &(*الكائن).النص);
    إذا (!أكمل_إلف_إلى(&متغير البايتات,
        إزاحة_البيانات)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };
    ألحق_بايتات_إلف(&متغير البايتات, &(*الكائن).البيانات);
    إذا (!أكمل_إلف_إلى(&متغير البايتات,
        إزاحة_الإزاحات)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };
    ليكن قسم_المصدر: متغير طبيعي = 0;
    طالما (قسم_المصدر < 2) {
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < عدد_الإزاحات) {
            ليكن الإزاحة: إزاحة_إلف = (*الكائن).الإزاحات[ر];
            إذا ((قسم_المصدر == 0 && !الإزاحة.في_البيانات)
                || (قسم_المصدر == 1 && الإزاحة.في_البيانات)) {
                طابق ابحث_في_الخريطة(&فهرس_الهوية, &الإزاحة.الرمز) مع
                | اختياري.لا_شيء -> { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود()); }
                | اختياري.موجود(فهرس_الرمز) -> {
                    ليكن فهرس_إلف: طبيعي = فهرس_الرمز + أول_رمز_عام; ليكن نوع_إلف: متغير طبيعي = 4;
                    ليكن طول_القسم_المصدر: طبيعي;
                    إذا (الإزاحة.في_البيانات) {
                        طول_القسم_المصدر := الطول((*الكائن).البيانات) مثل طبيعي;
                    } وإلا {
                        طول_القسم_المصدر := الطول((*الكائن).النص) مثل طبيعي;
                    };
                    ليكن عرض_الرقعة: طبيعي;
                    طابق الإزاحة.النوع مع
                    | نوع_إزاحة_إلف.عنوان_مطلق_أربعة_وستون -> { عرض_الرقعة := 8; }
                    | _ -> { عرض_الرقعة := 4; };
                    إذا (فهرس_إلف > 0xFFFFFFFF
                        || الإزاحة.إزاحة_بايت > طول_القسم_المصدر
                        || عرض_الرقعة > طول_القسم_المصدر - الإزاحة.إزاحة_بايت) {
                        أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
                    };
                    طابق الإزاحة.النوع مع
                    | نوع_إزاحة_إلف.نداء_نسبي_اثنان_وثلاثون -> { نوع_إلف := 4; }
                    | نوع_إزاحة_إلف.عنوان_نسبي_اثنان_وثلاثون -> { نوع_إلف := 2; }
                    | نوع_إزاحة_إلف.تحميل_جوت_ريكس_نسبي_اثنان_وثلاثون -> {
                        نوع_إلف := 42;
                        رموز_بيانات_جوت[فهرس_الرمز] := صواب;
                    }
                    | نوع_إزاحة_إلف.عنوان_مطلق_أربعة_وستون -> { نوع_إلف := نوع_إزاحة_مطلقة_إلف((*الكائن).الآلة); }
                    | نوع_إزاحة_إلف.تعليمة_ذراع_أربعة_وستون(رقم_النوع) -> {
                        نوع_إلف := رقم_النوع;
                        // R_AARCH64_ADR_GOT_PAGE / LD64_GOT_LO12_NC load imported data.
                        إذا (رقم_النوع == 311 || رقم_النوع == 312) { رموز_بيانات_جوت[فهرس_الرمز] := صواب; };
                    };
                    ألحق_ط64_إلف(&متغير البايتات, الإزاحة.إزاحة_بايت);
                    ألحق_ط64_إلف(&متغير البايتات, فهرس_إلف * 4294967296 + نوع_إلف);
                    ألحق_ط64_إلف(&متغير البايتات, الإزاحة.الإضافة مثل طبيعي);
                };
            };
            ر := ر + 1;
        }
        قسم_المصدر := قسم_المصدر + 1;
    }

    إذا (!أكمل_إلف_إلى(&متغير البايتات,
        إزاحة_الرموز)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };
    ألحق_أصفارا_إلف(&متغير البايتات, 24); ألحق_رمز_إلف64(&متغير البايتات, 0, 3, 1, 0, 0);
    ألحق_رمز_إلف64(&متغير البايتات, 0, 3, 2, 0, 0);
    ف := 0;
    طالما (ف < عدد_رموز_أقسام_دوارف) { ألحق_رمز_إلف64(&متغير البايتات, 0, 3, 7 + ف, 0, 0); ف := ف + 1; }
    ليكن س: متغير طبيعي = 0;
    طالما (س < عدد_رموز_الكائن) {
        ليكن مرجع_الرمز: &رمز_إلف = &(*الكائن).الرموز[س];
        ليكن موضع_الرمز: موضع_رمز_إلف = (*مرجع_الرمز).الموضع;
        ليكن القسم: متغير طبيعي = 0; ليكن القيمة: متغير طبيعي = 0; ليكن الحجم: متغير طبيعي = 0;
        ليكن المعلومات: متغير طبيعي = 0x12;
        طابق موضع_الرمز مع
        | موضع_رمز_إلف.معرف_في_النص(الإزاحة, حجم_الرمز) -> { القسم := 1; القيمة := الإزاحة; الحجم := حجم_الرمز;
            المعلومات := 0x12; }
        | موضع_رمز_إلف.معرف_في_البيانات(الإزاحة, حجم_الرمز) -> { القسم := 2; القيمة := الإزاحة;
            الحجم := حجم_الرمز; المعلومات := 0x11; }
        | موضع_رمز_إلف.غير_معرف -> {
            // A GOT-load references imported data (STT_OBJECT), not a function.
            // The symbol index is the same one resolved during RELA emission.
            إذا (رموز_بيانات_جوت[س]) { المعلومات := 0x11; };
        };
        ألحق_رمز_إلف64(&متغير البايتات, إزاحات_الأسماء[س], المعلومات, القسم, القيمة, الحجم); س := س + 1;
    }
    طابق (*الكائن).دخول_العملية مع | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> { ألحق_رمز_إلف64(&متغير البايتات, إزاحة_اسم_دخول_العملية, 0x12, 1,
        الدخول.إزاحة_بايت, الدخول.حجم_بايت); };
    إذا (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_النصوص)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
    }; ألحق_نصوص_رموز_إلف(&متغير البايتات, &(*الكائن).الرموز, عدد_رموز_الدخول > 0);

    ف := 0; طالما (ف < (الطول(أقسام_دوارف) مثل طبيعي)) { إذا (!أكمل_إلف_إلى(&متغير البايتات,
        إزاحات_أقسام_دوارف[ف])) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };
        ألحق_قسم_دوارف_إلف(&متغير البايتات, &(*الكائن).دوارف, أقسام_دوارف[ف]); ف := ف + 1; }
    ف := 0; طالما (ف < (الطول(أنواع_إزاحات_دوارف) مثل طبيعي)) { إذا (!أكمل_إلف_إلى(&متغير البايتات,
        إزاحات_أقسام_إزاحات_دوارف[ف]) || !ألحق_إزاحات_دوارف_إلف(&متغير البايتات, &(*الكائن).دوارف,
            أنواع_إزاحات_دوارف[ف], &أقسام_دوارف, (*الكائن).الآلة)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };
        ف := ف + 1; }
    إذا (يوجد_منشئ) {
        إذا (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_منشئات)) {
            أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
        };
        ألحق_ط64_إلف(&متغير البايتات, 0);
        إذا (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_إزاحات_منشئات)) {
            أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
        };
        طابق (*الكائن).منشئ_الوحدة مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود());
        }
        | اختياري.موجود(المعرف) -> {
            ليكن المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(المعرف);
            طابق ابحث_في_الخريطة(&فهرس_الهوية, &المرجع) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود());
            }
            | اختياري.موجود(الفهرس) -> {
                // R_X86_64_64 / R_AARCH64_ABS64 to the initializer, addend zero.
                ألحق_ط64_إلف(&متغير البايتات, 0);
                ألحق_ط64_إلف(&متغير البايتات, (الفهرس + أول_رمز_عام) * 4294967296
                    + نوع_إزاحة_مطلقة_إلف((*الكائن).الآلة));
                ألحق_ط64_إلف(&متغير البايتات, 0);
            };
        };
    };
    إذا (يوجد_وسم) {
        إذا (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_الوسم)) {
            أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
        };
        ألحق_بايتات_إلف(&متغير البايتات, &(*الكائن).ملاحظة_الوسم);
    };
    إذا (!أكمل_إلف_إلى(&متغير البايتات,
        إزاحة_أسماء_الأقسام)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };
    ألحق_بايتات_إلف(&متغير البايتات, &جدول_أسماء_الأقسام);
    إذا (!أكمل_إلف_إلى(&متغير البايتات,
        إزاحة_رؤوس_الأقسام)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };

    ألحق_أصفارا_إلف(&متغير البايتات, 64);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_النص, 1, 6, إزاحة_النص, حجم_النص, 0, 0, 16, 0);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_البيانات, 1, 3, إزاحة_البيانات, حجم_البيانات, 0, 0,
        محاذاة_البيانات, 0);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_إزاحات_النص, 4, 0, إزاحة_الإزاحات,
        عدد_إزاحات_النص * 24, 5, 1, 8, 24);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_إزاحات_بيانات, 4, 0, إزاحة_إزاحات_البيانات,
        عدد_إزاحات_البيانات * 24, 5, 2, 8, 24);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_الرموز, 2, 0, إزاحة_الرموز, حجم_الرموز, 6,
        أول_رمز_عام, 8, 24);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_النصوص, 3, 0, إزاحة_النصوص, حجم_النصوص, 0, 0, 1, 0);
    ف := 0; طالما (ف < (الطول(أقسام_دوارف) مثل طبيعي)) { ألحق_رأس_قسم_إلف64(&متغير البايتات,
        إزاحات_أسماء_دوارف[ف], 1, 0, إزاحات_أقسام_دوارف[ف], حجم_قسم_دوارف_إلف(&(*الكائن).دوارف,
            أقسام_دوارف[ف]), 0, 0, محاذاة_قسم_دوارف_إلف(أقسام_دوارف[ف]), 0); ف := ف + 1; }
    ف := 0; طالما (ف < (الطول(أنواع_إزاحات_دوارف) مثل طبيعي)) { ألحق_رأس_قسم_إلف64(&متغير البايتات,
        إزاحات_أسماء_إزاحات_دوارف[ف], 4, 0, إزاحات_أقسام_إزاحات_دوارف[ف],
        عدد_إزاحات_دوارف_إلف(&(*الكائن).دوارف, أنواع_إزاحات_دوارف[ف]) * 24, 5, فهارس_هدف_إزاحات_دوارف[ف], 8,
        24); ف := ف + 1; }
    إذا (يوجد_منشئ) {
        ألحق_رأس_قسم_إلف64(
            &متغير البايتات, إزاحة_اسم_منشئات, 14, 3,
            إزاحة_منشئات, 8, 0, 0, 8, 8
        );
        ألحق_رأس_قسم_إلف64(
            &متغير البايتات, إزاحة_اسم_إزاحات_منشئات, 4, 0,
            إزاحة_إزاحات_منشئات, 24, 5, فهرس_منشئات, 8, 24
        );
    };
    إذا (يوجد_وسم) {
        // SHT_NOTE, SHF_ALLOC, 4-byte aligned.
        ألحق_رأس_قسم_إلف64(
            &متغير البايتات, إزاحة_اسم_الوسم, 7, 2, إزاحة_الوسم,
            الطول((*الكائن).ملاحظة_الوسم) مثل طبيعي, 0, 0, 4, 0
        );
    };
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_جدول_الأقسام, 3, 0, إزاحة_أسماء_الأقسام, حجم_أسماء_الأقسام,
        0, 0, 1, 0);
    أرجع نتيجة_تسلسل_إلف.نجح(البايتات);
}

عام عرف اكتب_إلف_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه ط8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_تسلسل_إلف {
    طابق ابن_كائن_إلف_إكس_ستة_وثمانون_أربعة_وستون(الشفرة, الهدف, دالة_الدخول, الرموز_الخارجية, خريطة_المصادر,
        أصول_المصدر, التصحيح, تصحيح_الآلة, سياق_الفك, الأنواع, سجل_التخطيط) مع
    | نتيجة_بناء_إلف.خطأ(الخطأ) -> {
        أرجع نتيجة_تسلسل_إلف.خطأ(الخطأ);
    }
    | نتيجة_بناء_إلف.نجح(الكائن) -> {
        أرجع اكتب_كائن_إلف64(&الكائن);
    };
}

// ---- AArch64 ELF relocatable object ----------------------------------------
//
// The arm64 encoder produces per-function instruction words; its call fixups
// and symbolic references are already object attachments (اصدر_كائن_ذراع_أربعة_وستون).
// This builder lays the functions, the Linux _start and the read-only
// literals out in .text, the globals in .data, and expresses every reference
// as an R_AARCH64_* RELA record. A PAGEOFF12 reference is classified by the
// instruction it patches (ADD, or a scaled load/store of 1-16 bytes).

عرف ألحق_كلمة_ذراع_إلف(النص: &متغير متجه ط8, القيمة: طبيعي): منطقي {
    إذا (القيمة > 0xFFFFFFFF) { أرجع خطأ; };
    ألحق_ط32_إلف(النص, القيمة);
    أرجع صواب;
}

عرف اقرأ_كلمة_ذراع_إلف(النص: &متجه ط8, الموضع: طبيعي): طبيعي {
    ليكن ق: متغير طبيعي = 0;
    ليكن ب: متغير طبيعي = 4;
    طالما (ب > 0) {
        ب := ب - 1;
        ق := ق * 256 + ((*النص)[الموضع + ب] مثل طبيعي);
    }
    أرجع ق;
}

// The R_AARCH64_* type of a symbolic reference at one instruction word.
عرف نوع_إزاحة_ذراع_إلف(النوع: نوع_إزاحة_رمزية_كائن, التعليمة: طبيعي): اختياري طبيعي {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت -> {
        // R_AARCH64_CALL26 for BL, R_AARCH64_JUMP26 for B.
        إذا ((التعليمة & 0xFC000000) == 0x94000000) { أرجع اختياري.موجود(283); };
        إذا ((التعليمة & 0xFC000000) == 0x14000000) { أرجع اختياري.موجود(282); };
        أرجع اختياري.لا_شيء();
    }
    | نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت -> {
        إذا ((التعليمة & 0x9F000000) != 0x90000000) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(275); // R_AARCH64_ADR_PREL_PG_HI21
    }
    | نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> {
        إذا ((التعليمة & 0x7F800000) == 0x11000000) {
            أرجع اختياري.موجود(277); // R_AARCH64_ADD_ABS_LO12_NC
        };
        إذا ((التعليمة & 0x3B000000) == 0x39000000) {
            ليكن الحجم: طبيعي = (التعليمة / 0x40000000) % 4;
            ليكن متجهي: منطقي = ((التعليمة / 0x4000000) % 2) == 1;
            ليكن الشفرة_الفرعية: طبيعي = (التعليمة / 0x400000) % 4;
            إذا (متجهي && الحجم == 0 && الشفرة_الفرعية >= 2) {
                أرجع اختياري.موجود(299); // R_AARCH64_LDST128_ABS_LO12_NC
            };
            إذا (الحجم == 0) { أرجع اختياري.موجود(278); };
            إذا (الحجم == 1) { أرجع اختياري.موجود(284); };
            إذا (الحجم == 2) { أرجع اختياري.موجود(285); };
            أرجع اختياري.موجود(286);
        };
        أرجع اختياري.لا_شيء();
    }
    | نوع_إزاحة_رمزية_كائن.صفحة_تحميل_جوت_ذراع_واحد_وعشرون_بت -> {
        إذا ((التعليمة & 0x9F000000) != 0x90000000) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(311); // R_AARCH64_ADR_GOT_PAGE
    }
    | نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_تحميل_جوت_ذراع_اثنا_عشر_بت -> {
        إذا ((التعليمة & 0xFFC00000) != 0xF9400000) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(312); // R_AARCH64_LD64_GOT_LO12_NC
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Adds an undefined symbol for a referenced identity not defined here.
عرف تأكد_رمز_مرجع_إلف(
    الرموز: &متغير متجه رمز_إلف,
    فهرس_الهوية: &متغير الخريطة<مرجع_رمز_كائن, طبيعي>,
    فهرس_الأسماء: &متغير الخريطة<متجه ط8, طبيعي>,
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): اختياري خطأ_إلف {
    طابق ابحث_في_الخريطة(فهرس_الهوية, المرجع) مع
    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
    | اختياري.لا_شيء -> { };
    إذا (مرجع_رمز_كائن_هو_بيانات_محلية(المرجع)) {
        أرجع اختياري.موجود(خطأ_إلف.رمز_إزاحة_مفقود());
    };
    أرجع أضف_رمز_إلف(
        الرموز, فهرس_الهوية, فهرس_الأسماء, انسخ_مرجع_رمز_كائن(المرجع),
        موضع_رمز_إلف.غير_معرف(), الهدف, الرموز_الخارجية
    );
}

عرف أضف_إزاحة_تعليمة_ذراع_إلف(
    الإزاحات: &متغير متجه إزاحة_إلف,
    النص: &متجه ط8,
    الموضع: طبيعي,
    النوع: نوع_إزاحة_رمزية_كائن,
    الرمز: مرجع_رمز_كائن,
    الإضافة: عدد
): اختياري خطأ_إلف {
    إذا (الموضع % 4 != 0 || الموضع > (الطول(*النص) مثل طبيعي)
        || 4 > (الطول(*النص) مثل طبيعي) - الموضع) {
        أرجع اختياري.موجود(خطأ_إلف.إزاحة_نداء_خارج_النص());
    };
    ليكن التعليمة: طبيعي = اقرأ_كلمة_ذراع_إلف(النص, الموضع);
    طابق نوع_إزاحة_ذراع_إلف(النوع, التعليمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_إلف.إضافة_إزاحة_غير_مدعومة()); }
    | اختياري.موجود(رقم_النوع) -> {
        ليكن الإزاحة: إزاحة_إلف = {
            في_البيانات: خطأ,
            إزاحة_بايت: الموضع,
            النوع: نوع_إزاحة_إلف.تعليمة_ذراع_أربعة_وستون(رقم_النوع),
            الرمز: الرمز,
            الإضافة: الإضافة
        };
        ألحق(*الإزاحات, الإزاحة);
        أرجع اختياري.لا_شيء();
    };
}

عام عرف ابن_كائن_إلف_ذراع_أربعة_وستون(
    الشفرة: &شفرة_ذراع_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه ط8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_بناء_إلف {
    ليكن معرف_الهدف: معرف_هدف = (*الهدف).المعرف;
    إذا (!معرفا_هدف_متساويان((*الشفرة).الهدف, معرف_الهدف)) {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.هدف_غير_متوافق((*الشفرة).الهدف));
    };
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | _ -> { أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.معمارية_غير_مدعومة(معرف_الهدف)); };
    طابق (*الهدف).صيغة_الكائن مع
    | صيغة_كائن_هدف.إلف -> { }
    | _ -> { أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.صيغة_كائن_غير_مدعومة(معرف_الهدف)); };
    إذا ((*الهدف).نموذج_البيانات.عرض_المؤشر != 64
        || (*الهدف).نموذج_البيانات.ترتيب_البايت != ترتيب_بايت.صغير()) {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.نموذج_بيانات_غير_مدعوم(معرف_الهدف));
    };

    ليكن الرموز: متغير متجه رمز_إلف = [];
    ليكن فهرس_الهوية: متغير الخريطة<مرجع_رمز_كائن, طبيعي> = أنشئ_فهرس_هوية_رمز_إلف();
    ليكن فهرس_الأسماء: متغير الخريطة<متجه ط8, طبيعي> = أنشئ_فهرس_أسماء_إلف();
    ليكن النص: متغير متجه ط8 = [];
    ليكن مواضع_دوارف: متغير متجه موضع_دالة_دوارف = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الشفرة).الدوال) مثل طبيعي)) {
        ليكن مرجع_الدالة: &دالة_ذراع_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[ف];
        ليكن بداية_الدالة: طبيعي = الطول(النص) مثل طبيعي;
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*مرجع_الدالة).الكلمات) مثل طبيعي)) {
            إذا (!ألحق_كلمة_ذراع_إلف(&متغير النص, (*مرجع_الدالة).الكلمات[ك].القيمة)) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
            };
            ك := ك + 1;
        }
        ليكن حجم_الدالة: طبيعي = (الطول(النص) مثل طبيعي) - بداية_الدالة;
        ليكن معرف_الدالة: معرف_دالة_منتقاة = (*مرجع_الدالة).المعرف;
        طابق أضف_رمز_إلف(
            &متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء,
            مرجع_رمز_كائن.دالة(معرف_الدالة),
            موضع_رمز_إلف.معرف_في_النص(بداية_الدالة, حجم_الدالة), الهدف, الرموز_الخارجية
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ليكن موضع_دوارف: موضع_دالة_دوارف = {
            الدالة: معرف_الدالة,
            إزاحة_بايت: بداية_الدالة,
            حجم_بايت: حجم_الدالة,
            اسم_الربط: اسم_رمز_دالة_إلف(معرف_الدالة)
        };
        ألحق(مواضع_دوارف, موضع_دوارف);
        ف := ف + 1;
    }
    ليكن حجم_شفرة_الدوال: طبيعي = الطول(النص) مثل طبيعي;

    // _start follows the functions; its relocations are added below.
    ليكن دخول_العملية: متغير اختياري موضع_دخول_عملية_إلف = اختياري.لا_شيء();
    ليكن بداية_الدخول: متغير طبيعي = 0;
    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        بداية_الدخول := الطول(النص) مثل طبيعي;
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول(الدخول.الكلمات) مثل طبيعي)) {
            إذا (!ألحق_كلمة_ذراع_إلف(&متغير النص, الدخول.الكلمات[ك].القيمة)) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
            };
            ك := ك + 1;
        }
        ليكن الموضع: موضع_دخول_عملية_إلف = {
            إزاحة_بايت: بداية_الدخول,
            حجم_بايت: (الطول(النص) مثل طبيعي) - بداية_الدخول
        };
        دخول_العملية := اختياري.موجود(الموضع);
    };

    // Read-only literals share .text, after all code.
    ليكن ث: متغير طبيعي = 0;
    طالما (ث < (الطول((*الشفرة).المرفقات.البيانات_الثابتة) مثل طبيعي)) {
        ليكن الثابت: &بيانات_ثابتة_كائن = &(*الشفرة).المرفقات.البيانات_الثابتة[ث];
        ليكن محاذاة: متغير طبيعي = (*الثابت).المحاذاة;
        إذا (محاذاة == 0) { محاذاة := 1; };
        ليكن موضع: طبيعي = حاذ_إلف(الطول(النص) مثل طبيعي, محاذاة);
        ألحق_أصفارا_إلف(&متغير النص, موضع - (الطول(النص) مثل طبيعي));
        طابق أضف_رمز_إلف(
            &متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء,
            مرجع_رمز_كائن.بيانات_ثابتة((*الثابت).المعرف),
            موضع_رمز_إلف.معرف_في_النص(موضع, الطول((*الثابت).البيانات) مثل طبيعي),
            الهدف, الرموز_الخارجية
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ألحق_بايتات_إلف(&متغير النص, &(*الثابت).البيانات);
        ث := ث + 1;
    }

    ليكن البيانات: متغير متجه ط8 = [];
    ليكن مواضع_العوام_دوارف: متغير متجه موضع_عام_دوارف = [];
    ليكن إزاحات_بيانات: متغير متجه إزاحة_إلف = [];
    ليكن محاذاة_البيانات: متغير طبيعي = 1;
    ليكن غ: متغير طبيعي = 0;
    طالما (غ < (الطول((*الشفرة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        ليكن مرجع_العام: &بيانات_عام_كائن = &(*الشفرة).المرفقات.البيانات_العامة[غ];
        ليكن محاذاة_العام: متغير طبيعي = (*مرجع_العام).المحاذاة;
        إذا (محاذاة_العام == 0) { محاذاة_العام := 1; };
        إذا (محاذاة_العام > محاذاة_البيانات) { محاذاة_البيانات := محاذاة_العام; };
        ليكن الحجم_الحالي: طبيعي = الطول(البيانات) مثل طبيعي;
        ليكن موضع_العام: طبيعي = حاذ_إلف(الحجم_الحالي, محاذاة_العام);
        ألحق_أصفارا_إلف(&متغير البيانات, موضع_العام - الحجم_الحالي);
        ليكن معرف_العام: معرف_عام_مسير = (*مرجع_العام).المعرف;
        ليكن موضع_دوارف_للعام: موضع_عام_دوارف = {
            العام: معرف_العام, إزاحة_بايت: موضع_العام, اسم_الربط: اسم_رمز_عام_إلف(معرف_العام)
        };
        ألحق(مواضع_العوام_دوارف, موضع_دوارف_للعام);
        طابق أضف_رمز_إلف(
            &متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء,
            مرجع_رمز_كائن.عام(معرف_العام),
            موضع_رمز_إلف.معرف_في_البيانات(موضع_العام, الطول((*مرجع_العام).البيانات) مثل طبيعي),
            الهدف, الرموز_الخارجية
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ألحق_بايتات_إلف(&متغير البيانات, &(*مرجع_العام).البيانات);
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*مرجع_العام).الإزاحات) مثل طبيعي)) {
            ليكن طلب: &طلب_إزاحة_بيانات_كائن = &(*مرجع_العام).الإزاحات[ر];
            إذا ((*طلب).الموضع > (الطول((*مرجع_العام).البيانات) مثل طبيعي)
                || 8 > (الطول((*مرجع_العام).البيانات) مثل طبيعي) - (*طلب).الموضع) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
            };
            ليكن الإزاحة: إزاحة_إلف = {
                في_البيانات: صواب,
                إزاحة_بايت: موضع_العام + (*طلب).الموضع,
                النوع: نوع_إزاحة_إلف.عنوان_مطلق_أربعة_وستون(),
                الرمز: حل_مرجع_بيانات_خارجية_كائن(
                    &(*طلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
                ),
                الإضافة: (*طلب).الإضافة مثل عدد
            };
            ألحق(إزاحات_بيانات, الإزاحة);
            ر := ر + 1;
        }
        غ := غ + 1;
    }

    // An executable's _start owns the process startup data (argc, argv, envp).
    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(_) -> {
        ليكن الأسماء: متجه متجه ط8 = [
            اسم_عدد_وسائط_إقلاع_أساسي(), اسم_مؤشر_وسائط_إقلاع_أساسي(), اسم_مؤشر_بيئة_إقلاع_أساسي()
        ];
        ليكن فهرس_الاسم: متغير طبيعي = 0;
        طالما (فهرس_الاسم < (الطول(الأسماء) مثل طبيعي)) {
            ليكن وجد: متغير منطقي = خطأ;
            ليكن فهرس_الخارجي: متغير طبيعي = 0;
            طالما (فهرس_الخارجي < (الطول(*الرموز_الخارجية) مثل طبيعي) && !وجد) {
                إذا (اسما_رمز_خارجي_كائن_متساويان(
                    &(*الرموز_الخارجية)[فهرس_الخارجي], &الأسماء[فهرس_الاسم]
                )) {
                    وجد := صواب;
                    ليكن الحجم_الحالي: طبيعي = الطول(البيانات) مثل طبيعي;
                    ليكن موضع_البيانات: طبيعي = حاذ_إلف(الحجم_الحالي, 8);
                    ألحق_أصفارا_إلف(&متغير البيانات, موضع_البيانات - الحجم_الحالي + 8);
                    إذا (محاذاة_البيانات < 8) { محاذاة_البيانات := 8; };
                    ليكن المعرف: معرف_دالة_خارجية_منتقاة = { القيمة: فهرس_الخارجي };
                    طابق أضف_رمز_إلف(
                        &متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء,
                        مرجع_رمز_كائن.رمز_خارجي(المعرف),
                        موضع_رمز_إلف.معرف_في_البيانات(موضع_البيانات, 8), الهدف, الرموز_الخارجية
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
                فهرس_الخارجي := فهرس_الخارجي + 1;
            }
            إذا (!وجد) { أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود()); };
            فهرس_الاسم := فهرس_الاسم + 1;
        }
    };

    ليكن الإزاحات: متغير متجه إزاحة_إلف = [];
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*الشفرة).المرفقات.إزاحات_النص) مثل طبيعي)) {
        ليكن الطلب: &طلب_إزاحة_نص_كائن = &(*الشفرة).المرفقات.إزاحات_النص[ر];
        ليكن بداية_الدالة: متغير طبيعي = 0;
        ليكن حجم_الدالة: متغير طبيعي = 0;
        ليكن وجد_الدالة: متغير منطقي = خطأ;
        ليكن م: متغير طبيعي = 0;
        طالما (م < (الطول(مواضع_دوارف) مثل طبيعي) && !وجد_الدالة) {
            إذا (معرفا_دالة_منتقاة_متساويان(مواضع_دوارف[م].الدالة, (*الطلب).الموضع.الدالة)) {
                بداية_الدالة := مواضع_دوارف[م].إزاحة_بايت;
                حجم_الدالة := مواضع_دوارف[م].حجم_بايت;
                وجد_الدالة := صواب;
            };
            م := م + 1;
        }
        إذا (!وجد_الدالة || (*الطلب).الموضع.إزاحة_بايت > حجم_الدالة
            || 4 > حجم_الدالة - (*الطلب).الموضع.إزاحة_بايت) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إزاحة_نداء_خارج_النص());
        };
        ليكن مرجع_الطلب: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
            &(*الطلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
        );
        طابق تأكد_رمز_مرجع_إلف(
            &متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, &مرجع_الطلب,
            الهدف, الرموز_الخارجية
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        طابق (*الطلب).النوع مع
        | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> {
            إذا ((*الطلب).الموضع.إزاحة_بايت > حجم_الدالة
                || 8 > حجم_الدالة - (*الطلب).الموضع.إزاحة_بايت) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إزاحة_نداء_خارج_النص());
            };
            ليكن الإزاحة: إزاحة_إلف = {
                في_البيانات: خطأ,
                إزاحة_بايت: بداية_الدالة + (*الطلب).الموضع.إزاحة_بايت,
                النوع: نوع_إزاحة_إلف.عنوان_مطلق_أربعة_وستون(),
                الرمز: مرجع_الطلب,
                الإضافة: (*الطلب).الإضافة
            };
            ألحق(الإزاحات, الإزاحة);
        }
        | _ -> {
            طابق أضف_إزاحة_تعليمة_ذراع_إلف(
                &متغير الإزاحات, &النص, بداية_الدالة + (*الطلب).الموضع.إزاحة_بايت,
                (*الطلب).النوع, مرجع_الطلب, (*الطلب).الإضافة
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        ر := ر + 1;
    }

    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        ليكن ر_دخول: متغير طبيعي = 0;
        طالما (ر_دخول < (الطول(الدخول.الإزاحات) مثل طبيعي)) {
            ليكن الطلب: &إزاحة_دخول_لينكس_ذراع = &الدخول.الإزاحات[ر_دخول];
            طابق تأكد_رمز_مرجع_إلف(
                &متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, &(*الطلب).الرمز,
                الهدف, الرموز_الخارجية
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق أضف_إزاحة_تعليمة_ذراع_إلف(
                &متغير الإزاحات, &النص, بداية_الدخول + (*الطلب).إزاحة_بايت,
                (*الطلب).النوع, انسخ_مرجع_رمز_كائن(&(*الطلب).الرمز), 0
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            ر_دخول := ر_دخول + 1;
        }
    };

    ليكن ب: متغير طبيعي = 0;
    طالما (ب < (الطول(إزاحات_بيانات) مثل طبيعي)) {
        ليكن الطلب: إزاحة_إلف = إزاحات_بيانات[ب];
        طابق تأكد_رمز_مرجع_إلف(
            &متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, &الطلب.الرمز,
            الهدف, الرموز_الخارجية
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ألحق(الإزاحات, الطلب);
        ب := ب + 1;
    }

    طابق طبق_اسم_دخول_إلف(&متغير الرموز, &فهرس_الهوية, دالة_الدخول) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };

    ليكن أصول_فارغة: متجه مدى_شفرة_آلة_بأصل = [];
    ليكن حزمة_دوارف_إلف: حزمة_دوارف = ابن_حزمة_دوارف_من_سياقات(
        خريطة_المصادر, أصول_المصدر, &مواضع_دوارف, &مواضع_العوام_دوارف, التصحيح, تصحيح_الآلة, سياق_الفك,
        الأنواع, الهدف, سجل_التخطيط, &أصول_فارغة, حجم_شفرة_الدوال
    );
    ليكن ملاحظة_الوسم_المحسوبة: متجه ط8 = ملاحظة_وسم_إلف(الهدف, &دخول_العملية);
    ليكن الناتج: كائن_إلف = {
        الهدف: معرف_الهدف,
        الآلة: 183,
        النص: النص,
        البيانات: البيانات,
        محاذاة_البيانات: محاذاة_البيانات,
        الرموز: الرموز,
        الإزاحات: الإزاحات,
        دخول_العملية: دخول_العملية,
        منشئ_الوحدة: (*الشفرة).المرفقات.منشئ_الوحدة,
        ملاحظة_الوسم: ملاحظة_الوسم_المحسوبة,
        هوية_النظام: هوية_نظام_إلف(الهدف),
        دوارف: حزمة_دوارف_إلف
    };
    أرجع نتيجة_بناء_إلف.نجح(الناتج);
}
