    ف := 0; بينما (ف < (الطول(أقسام_دوارف) مثل غير_موقع)) { ألحق_رأس_قسم_إلف64(&متغير البايتات,
        إزاحات_أسماء_دوارف[ف], 1, 0, إزاحات_أقسام_دوارف[ف], حجم_قسم_دوارف_إلف(&(*الكائن).دوارف,
        أقسام_دوارف[ف]), 0, 0, محاذاة_قسم_دوارف_إلف(أقسام_دوارف[ف]), 0); ف := ف + 1; }
    ف := 0; بينما (ف < (الطول(أنواع_إزاحات_دوارف) مثل غير_موقع)) { ألحق_رأس_قسم_إلف64(&متغير البايتات,
        إزاحات_أسماء_إزاحات_دوارف[ف], 4, 0, إزاحات_أقسام_إزاحات_دوارف[ف],
        عدد_إزاحات_دوارف_إلف(&(*الكائن).دوارف, أنواع_إزاحات_دوارف[ف]) * 24, 5, فهارس_هدف_إزاحات_دوارف[ف], 8,
        24); ف := ف + 1; }
    لو (يوجد_منشئ) {
        ألحق_رأس_قسم_إلف64(
            &متغير البايتات, إزاحة_اسم_منشئات, 14, 3,
            إزاحة_منشئات, 8, 0, 0, 8, 8
        );
        ألحق_رأس_قسم_إلف64(
            &متغير البايتات, إزاحة_اسم_إزاحات_منشئات, 4, 0,
            إزاحة_إزاحات_منشئات, 24, 5, فهرس_منشئات, 8, 24
        );
    };
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_جدول_الأقسام, 3, 0, إزاحة_أسماء_الأقسام, حجم_أسماء_الأقسام,
        0, 0, 1, 0);
    أرجع نتيجة_تسلسل_إلف.نجح(البايتات);
}

عام عرف اكتب_إلف_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_تسلسل_إلف {
    طابق ابن_كائن_إلف_إكس_ستة_وثمانون_أربعة_وستون(الشفرة, الهدف, دالة_الدخول, الرموز_الخارجية, خريطة_المصادر,
        أصول_المصدر, التصحيح, تصحيح_الآلة, سياق_الفك, الأنواع, سجل_التخطيط) مع
    | نتيجة_بناء_إلف.خطأ(الخطأ) -> {
        أرجع نتيجة_تسلسل_إلف.خطأ(الخطأ);
    }
    | نتيجة_بناء_إلف.نجح(الكائن) -> {
        أرجع اكتب_كائن_إلف64(&الكائن);
    };
}
