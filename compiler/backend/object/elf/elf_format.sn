عام نوع خطأ_إلف =
    | هدف_غير_متوافق بنوع معرف_هدف
    | معمارية_غير_مدعومة بنوع معرف_هدف
    | صيغة_كائن_غير_مدعومة بنوع معرف_هدف
    | نموذج_بيانات_غير_مدعوم بنوع معرف_هدف
    | رمز_مكرر
    | إزاحة_نداء_خارج_النص
    | إضافة_إزاحة_غير_مدعومة
    | رمز_إزاحة_مفقود
    | رمز_دخول_مفقود بنوع معرف_دالة_منتقاة
    | حدود_صيغة_متجاوزة
;

عام نوع نتيجة_بناء_إلف =
    | نجح بنوع كائن_إلف
    | خطأ بنوع خطأ_إلف
;

عام نوع نتيجة_تسلسل_إلف =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_إلف
;

عرف ألحق_ط8_إلف(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق(*البايتات, (القيمة % 256) مثل ط8);
}

عرف ألحق_ط16_إلف(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ليكن الباقي: متغير طبيعي = القيمة;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ألحق_ط8_إلف(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_ط32_إلف(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ليكن الباقي: متغير طبيعي = القيمة;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        ألحق_ط8_إلف(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_ط64_إلف(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ليكن الباقي: متغير طبيعي = القيمة;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        ألحق_ط8_إلف(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_أصفارا_إلف(البايتات: &متغير متجه ط8, العدد: طبيعي): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق_ط8_إلف(البايتات, 0);
        ف := ف + 1;
    }
}

عرف ألحق_بايتات_إلف(الوجهة: &متغير متجه ط8, المصدر: &متجه ط8): فراغ {
    ليكن فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(*الوجهة, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
}

عرف أكمل_إلف_إلى(البايتات: &متغير متجه ط8, الموضع: طبيعي): منطقي {
    ليكن الحالي: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الحالي > الموضع) {
        أرجع خطأ;
    };
    ألحق_أصفارا_إلف(البايتات, الموضع - الحالي);
    أرجع صواب;
}

عرف حاذ_إلف(القيمة: طبيعي, المحاذاة: طبيعي): طبيعي {
    إذا (المحاذاة == 0) {
        أرجع القيمة;
    };
    ليكن الباقي: طبيعي = القيمة % المحاذاة;
    إذا (الباقي == 0) {
        أرجع القيمة;
    };
    أرجع القيمة + (المحاذاة - الباقي);
}

عرف بايت_سداسي_إلف(القيمة: طبيعي): ط8 {
    إذا (القيمة < 10) {
        أرجع (0x30 + القيمة) مثل ط8;
    };
    أرجع (0x61 + (القيمة - 10)) مثل ط8;
}

عرف اسم_رمز_دالة_إلف(المعرف: معرف_دالة_منتقاة): متجه ط8 {
    ليكن البايتات: متغير متجه ط8 = [];
    // sultanc_fn_
    ليكن المقدمة: متجه ط8 = بايتات_من_نص(«sultanc_fn_»);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المقدمة) مثل طبيعي)) {
        ألحق(البايتات, المقدمة[ف]);
        ف := ف + 1;
    }
    ليكن القاسم: متغير طبيعي = 0x1000000000000000;
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < 16) {
        ليكن المقسوم: طبيعي = المعرف.القيمة / القاسم;
        ليكن الرقم: طبيعي = المقسوم % 16;
        ألحق(البايتات, بايت_سداسي_إلف(الرقم));
        إذا (القاسم > 1) {
            القاسم := القاسم / 16;
        };
        ر := ر + 1;
    }
    أرجع البايتات;
}

عرف اسم_رمز_عام_إلف(المعرف: معرف_عام_مسير): متجه ط8 {
    ليكن البايتات: متغير متجه ط8 = بايتات_من_نص(«sultanc_global_»);
    ليكن القاسم: متغير طبيعي = 0x1000000000000000;
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < 16) {
        ليكن المقسوم: طبيعي = (المعرف.القيمة مثل طبيعي) / القاسم;
        ليكن الرقم: طبيعي = المقسوم % 16;
        ألحق(البايتات, بايت_سداسي_إلف(الرقم));
        إذا (القاسم > 1) { القاسم := القاسم / 16; };
        ر := ر + 1;
    }
    أرجع البايتات;
}

// Stable per-function literal symbol names; identity remains owned by the
// shared object-reference model, not by a second string registry.
عرف اسم_رمز_ثابت_إلف(المعرف: معرف_بيانات_ثابتة_كائن): متجه ط8 {
    ليكن البايتات: متغير متجه ط8 = بايتات_من_نص(«sultanc_const_»);
    ليكن الجزءان: متجه طبيعي = [المعرف.الدالة.القيمة, المعرف.القيمة];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن القاسم: متغير طبيعي = 0x1000000000000000;
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < 16) {
            ألحق(البايتات, بايت_سداسي_إلف((الجزءان[ف] / القاسم) % 16));
            إذا (القاسم > 1) { القاسم := القاسم / 16; };
            ر := ر + 1;
        }
        إذا (ف == 0) { ألحق(البايتات, 0x5F مثل ط8); };
        ف := ف + 1;
    }
    أرجع البايتات;
}

عرف اسم_مرجع_رمز_إلف(
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): اختياري متجه ط8 {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> { أرجع اختياري.موجود(اسم_رمز_دالة_إلف(الدالة)); }
    | مرجع_رمز_كائن.عام(العام) -> { أرجع اختياري.موجود(اسم_رمز_عام_إلف(العام)); }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> { أرجع اسم_رمز_خارجي_كائن_من_جدول(المعرف, الرموز_الخارجية); }
    // Storage-service references are bound to std provider functions before
    // emission (اربط_خدمات_تخزين_مرفقات); one left here has no symbol.
    | مرجع_رمز_كائن.خدمة_تشغيل(_) -> { أرجع اختياري.لا_شيء(); }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> { أرجع اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي); }
    | مرجع_رمز_كائن.بيانات_ثابتة(المعرف) -> { أرجع اختياري.موجود(اسم_رمز_ثابت_إلف(المعرف)); };
}

// Temporary lookup indices only. The ordered vector of رمز_إلف remains
// the sole symbol owner and defines every emitted ELF symbol index.
عرف هاش_هوية_رمز_إلف(المرجع: &مرجع_رمز_كائن): طبيعي {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(المعرف) -> {
        أرجع ((المعرف.القيمة % 4294967291) * 33 + 1) % 4294967291;
    }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> {
        أرجع ((المعرف.القيمة % 4294967291) * 33 + 2) % 4294967291;
    }
    | مرجع_رمز_كائن.عام(المعرف) -> {
        أرجع ((المعرف.القيمة % 4294967291) * 33 + 3) % 4294967291;
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(المعرف) -> {
        ليكن جزء_الدالة: طبيعي = المعرف.الدالة.القيمة % 4294967291;
        ليكن جزء_الثابت: طبيعي = المعرف.القيمة % 4294967291;
        أرجع ((جزء_الدالة * 33 + جزء_الثابت) % 4294967291 * 33 + 4) % 4294967291;
    }
    // Fixed-size enum families: equality resolves their bounded hash collisions.
    | مرجع_رمز_كائن.خدمة_تشغيل(_) -> { أرجع 100; }
    | مرجع_رمز_كائن.بدائي_تشغيل(_) -> { أرجع 200; };
}

عرف أنشئ_فهرس_هوية_رمز_إلف(): الخريطة<مرجع_رمز_كائن, طبيعي> {
    أرجع أنشئ_الخريطة(هاش_هوية_رمز_إلف, مرجعا_رمز_كائن_متساويان);
}

عرف أنشئ_فهرس_أسماء_إلف(): الخريطة<متجه ط8, طبيعي> {
    أرجع أنشئ_الخريطة(
        هاش_فنڤ1أ_طبيعي_للبايتات, اسما_رمز_خارجي_كائن_متساويان
    );
}

عرف موضع_رمز_إلف_معرف(الموضع: موضع_رمز_إلف): منطقي {
    طابق الموضع مع
    | موضع_رمز_إلف.غير_معرف -> { أرجع خطأ; }
    | _ -> { أرجع صواب; };
}

عرف أضف_رمز_إلف(
    الرموز: &متغير متجه رمز_إلف,
    فهرس_الهوية: &متغير الخريطة<مرجع_رمز_كائن, طبيعي>,
    فهرس_الأسماء: &متغير الخريطة<متجه ط8, طبيعي>,
    المرجع: مرجع_رمز_كائن,
    الموضع: موضع_رمز_إلف,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): اختياري خطأ_إلف {
    طابق ابحث_في_الخريطة(فهرس_الهوية, &المرجع) مع
    | اختياري.موجود(_) -> { أرجع اختياري.موجود(خطأ_إلف.رمز_مكرر()); }
    | اختياري.لا_شيء -> { };
    طابق اسم_مرجع_رمز_إلف(&المرجع, الهدف, الرموز_الخارجية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_إلف.رمز_إزاحة_مفقود()); }
    | اختياري.موجود(الاسم) -> {
        // Only definitions reserve a link name, as in the prior writer.
        إذا (موضع_رمز_إلف_معرف(الموضع)) {
            طابق ابحث_في_الخريطة(فهرس_الأسماء, &الاسم) مع
            | اختياري.موجود(_) -> { أرجع اختياري.موجود(خطأ_إلف.رمز_مكرر()); }
            | اختياري.لا_شيء -> { };
        };
        ليكن الفهرس: طبيعي = الطول(*الرموز) مثل طبيعي;
        ليكن مفتاح_الهوية: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&المرجع);
        طابق أدرج_في_الخريطة(فهرس_الهوية, مفتاح_الهوية, الفهرس) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(خطأ_إلف.حدود_صيغة_متجاوزة()); }
        | نتيجة.نجح(_) -> { };
        إذا (موضع_رمز_إلف_معرف(الموضع)) {
            ليكن مفتاح_الاسم: متجه ط8 = انسخ_اسم_رمز_خارجي_كائن(&الاسم);
            طابق أدرج_في_الخريطة(فهرس_الأسماء, مفتاح_الاسم, الفهرس) مع
            | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(خطأ_إلف.حدود_صيغة_متجاوزة()); }
            | نتيجة.نجح(_) -> { };
        };
        ليكن الرمز: رمز_إلف = { المرجع: المرجع, الاسم: الاسم, الموضع: الموضع };
        ألحق(*الرموز, الرمز);
        أرجع اختياري.لا_شيء();
    };
}

عرف اسم_دخول_إلف(): متجه ط8 {
    // main
    ليكن الاسم: متجه ط8 = بايتات_من_نص(«main»);
    أرجع الاسم;
}

عرف طبق_اسم_دخول_إلف(
    الرموز: &متغير متجه رمز_إلف,
    فهرس_الهوية: &الخريطة<مرجع_رمز_كائن, طبيعي>,
    دالة_الدخول: اختياري معرف_دالة_منتقاة
): اختياري خطأ_إلف {
    طابق دالة_الدخول مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الدخول) -> {
        ليكن مرجع_الدخول: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدخول);
        طابق ابحث_في_الخريطة(فهرس_الهوية, &مرجع_الدخول) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_إلف.رمز_دخول_مفقود(الدخول)); }
        | اختياري.موجود(ف) -> {
            طابق (*الرموز)[ف].الموضع مع
            | موضع_رمز_إلف.غير_معرف -> { أرجع اختياري.موجود(خطأ_إلف.رمز_دخول_مفقود(الدخول)); }
            | موضع_رمز_إلف.معرف_في_النص(الإزاحة, الحجم) -> {
                ليكن الاسم: متجه ط8 = اسم_دخول_إلف();
                ليكن موضع_الدخول: موضع_رمز_إلف = موضع_رمز_إلف.معرف_في_النص(الإزاحة, الحجم);
                ليكن الرمز: رمز_إلف = { المرجع: مرجع_الدخول, الاسم: الاسم, الموضع: موضع_الدخول };
                (*الرموز)[ف] := الرمز; أرجع اختياري.لا_شيء();
            }
            | موضع_رمز_إلف.معرف_في_البيانات(_, _) -> {
                أرجع اختياري.موجود(خطأ_إلف.رمز_دخول_مفقود(الدخول));
            };
        };
    };
}

عام عرف ابن_كائن_إلف_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه ط8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_بناء_إلف {
    ليكن معرف_الشفرة: معرف_هدف = (*الشفرة).الهدف;
    ليكن معرف_الهدف: معرف_هدف = (*الهدف).المعرف;
    إذا (!معرفا_هدف_متساويان(معرف_الشفرة, معرف_الهدف)) {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.هدف_غير_متوافق(معرف_الشفرة));
    };
    // An x86-64 object must not be tagged as another ELF machine.
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.معمارية_غير_مدعومة(معرف_الهدف));
    };
    طابق (*الهدف).صيغة_الكائن مع
    | صيغة_كائن_هدف.إلف -> { }
    | _ -> {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.صيغة_كائن_غير_مدعومة(معرف_الهدف));
    };
    إذا ((*الهدف).نموذج_البيانات.عرض_المؤشر != 64) {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.نموذج_بيانات_غير_مدعوم(معرف_الهدف));
    };
    طابق (*الهدف).نموذج_البيانات.ترتيب_البايت مع
    | ترتيب_بايت.صغير -> { }
    | _ -> {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.نموذج_بيانات_غير_مدعوم(معرف_الهدف));
    };

    ليكن الرموز: متغير متجه رمز_إلف = [];
    ليكن فهرس_الهوية: متغير الخريطة<مرجع_رمز_كائن, طبيعي> = أنشئ_فهرس_هوية_رمز_إلف();
    ليكن فهرس_الأسماء: متغير الخريطة<متجه ط8, طبيعي> = أنشئ_فهرس_أسماء_إلف();
    // ELF's existing .text section is read-only at runtime and can hold a
    // function-local literal pool. No extra section or runtime allocation.
    ليكن مرجع_النص: &متجه ط8 = &(*الشفرة).البيانات;
    ليكن النص: متغير متجه ط8 = انسخ_بايتات(مرجع_النص);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الشفرة).الدوال) مثل طبيعي)) {
        ليكن مرجع_الموضع_المشفر: &موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[ف];
        ليكن إزاحة_الدالة: طبيعي = (*مرجع_الموضع_المشفر).إزاحة_بايت;
        ليكن حجم_الدالة: طبيعي = (*مرجع_الموضع_المشفر).حجم_بايت;
        ليكن معرف_الدالة: معرف_دالة_منتقاة = (*مرجع_الموضع_المشفر).الدالة;
        إذا (إزاحة_الدالة > (الطول((*الشفرة).البيانات) مثل طبيعي)
            || حجم_الدالة > (الطول((*الشفرة).البيانات) مثل طبيعي) - إزاحة_الدالة) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
        };
        ليكن الموضع: موضع_رمز_إلف =
            موضع_رمز_إلف.معرف_في_النص(إزاحة_الدالة, حجم_الدالة);
        ليكن مرجع_الدالة: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_الدالة);
        طابق أضف_رمز_إلف(&متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, مرجع_الدالة, الموضع, الهدف, الرموز_الخارجية) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Attach immutable string bytes after all encoded function ranges so
    // existing function offsets, relocations, and DWARF ranges stay stable.
    ليكن ث: متغير طبيعي = 0;
    طالما (ث < (الطول((*الشفرة).المرفقات.البيانات_الثابتة) مثل طبيعي)) {
        ليكن الثابت: &بيانات_ثابتة_كائن = &(*الشفرة).المرفقات.البيانات_الثابتة[ث];
        ليكن محاذاة: متغير طبيعي = (*الثابت).المحاذاة;
        إذا (محاذاة == 0) { محاذاة := 1; };
        ليكن موضع: طبيعي = حاذ_إلف(الطول(النص) مثل طبيعي, محاذاة);
        ألحق_أصفارا_إلف(&متغير النص, موضع - (الطول(النص) مثل طبيعي));
        ليكن مرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.بيانات_ثابتة((*الثابت).المعرف);
        ليكن الموضع: موضع_رمز_إلف = موضع_رمز_إلف.معرف_في_النص(
            موضع, الطول((*الثابت).البيانات) مثل طبيعي
        );
        طابق أضف_رمز_إلف(&متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, مرجع, الموضع, الهدف, الرموز_الخارجية) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ألحق_بايتات_إلف(&متغير النص, &(*الثابت).البيانات);
        ث := ث + 1;
    }

    ليكن البيانات: متغير متجه ط8 = [];
    ليكن مواضع_العوام_دوارف: متغير متجه موضع_عام_دوارف = [];
    ليكن إزاحات_بيانات: متغير متجه إزاحة_إلف = [];
    ليكن محاذاة_البيانات: متغير طبيعي = 1;
    ليكن غ: متغير طبيعي = 0;
    طالما (غ < (الطول((*الشفرة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        ليكن مرجع_العام: &بيانات_عام_كائن = &(*الشفرة).المرفقات.البيانات_العامة[غ];
        ليكن محاذاة_العام: متغير طبيعي = (*مرجع_العام).المحاذاة;
        إذا (محاذاة_العام == 0) { محاذاة_العام := 1; };
        إذا (محاذاة_العام > محاذاة_البيانات) { محاذاة_البيانات := محاذاة_العام; };
        ليكن الحجم_الحالي: طبيعي = الطول(البيانات) مثل طبيعي;
        ليكن موضع_العام: طبيعي = حاذ_إلف(الحجم_الحالي, محاذاة_العام);
        إذا (موضع_العام > الحجم_الحالي) { ألحق_أصفارا_إلف(&متغير البيانات, موضع_العام - الحجم_الحالي); };
        ليكن معرف_العام: معرف_عام_مسير = (*مرجع_العام).المعرف;
        ليكن اسم_ربط_العام_دوارف: متجه ط8 = اسم_رمز_عام_إلف(معرف_العام);
        ليكن موضع_دوارف_للعام: موضع_عام_دوارف = {
            العام: معرف_العام, إزاحة_بايت: موضع_العام, اسم_الربط: اسم_ربط_العام_دوارف
        };
        ألحق(مواضع_العوام_دوارف, موضع_دوارف_للعام);
        ليكن المرجع_العام: مرجع_رمز_كائن = مرجع_رمز_كائن.عام((*مرجع_العام).المعرف);
        ليكن موضع_الرمز: موضع_رمز_إلف = موضع_رمز_إلف.معرف_في_البيانات(موضع_العام,
            الطول((*مرجع_العام).البيانات) مثل طبيعي);
        طابق أضف_رمز_إلف(&متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, المرجع_العام, موضع_الرمز, الهدف, الرموز_الخارجية) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ألحق_بايتات_إلف(&متغير البيانات, &(*مرجع_العام).البيانات);
        ليكن فهرس_إزاحة_البيانات: متغير طبيعي = 0;
        طالما (فهرس_إزاحة_البيانات < (الطول((*مرجع_العام).الإزاحات) مثل طبيعي)) {
            ليكن طلب: &طلب_إزاحة_بيانات_كائن = &(*مرجع_العام).الإزاحات[فهرس_إزاحة_البيانات];
            إذا ((*طلب).الموضع > (الطول((*مرجع_العام).البيانات) مثل طبيعي)
                || 8 > (الطول((*مرجع_العام).البيانات) مثل طبيعي) - (*طلب).الموضع) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
            };
            ليكن الإزاحة: إزاحة_إلف = {
                في_البيانات: صواب,
                إزاحة_بايت: موضع_العام + (*طلب).الموضع,
                النوع: نوع_إزاحة_إلف.عنوان_مطلق_أربعة_وستون(),
                الرمز: حل_مرجع_بيانات_خارجية_كائن(
                    &(*طلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
                ),
                الإضافة: (*طلب).الإضافة مثل عدد
            };
            ألحق(إزاحات_بيانات, الإزاحة);
            فهرس_إزاحة_البيانات := فهرس_إزاحة_البيانات + 1;
        }
        غ := غ + 1;
    }

    // Only a direct ELF executable _start owns initial-process data. Do not
    // introduce startup definitions into relocatable library modules.
    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(_) -> {
        ليكن اسم_عدد_الوسائط: متجه ط8 = اسم_عدد_وسائط_إقلاع_أساسي();
        ليكن اسم_مؤشر_الوسائط: متجه ط8 = اسم_مؤشر_وسائط_إقلاع_أساسي();
        ليكن اسم_مؤشر_البيئة: متجه ط8 = اسم_مؤشر_بيئة_إقلاع_أساسي();
        ليكن الأسماء: متجه متجه ط8 = [اسم_عدد_الوسائط, اسم_مؤشر_الوسائط, اسم_مؤشر_البيئة];
        ليكن فهرس_الاسم: متغير طبيعي = 0;
        طالما (فهرس_الاسم < (الطول(الأسماء) مثل طبيعي)) {
            ليكن فهرس_الخارجي: متغير طبيعي = 0;
            ليكن وجد: متغير منطقي = خطأ;
            طالما (فهرس_الخارجي < (الطول(*الرموز_الخارجية) مثل طبيعي)) {
                إذا (اسما_رمز_خارجي_كائن_متساويان(
                    &(*الرموز_الخارجية)[فهرس_الخارجي], &الأسماء[فهرس_الاسم]
                )) {
                    وجد := صواب;
                    ليكن الحجم_الحالي: طبيعي = الطول(البيانات) مثل طبيعي;
                    ليكن موضع_البيانات: طبيعي = حاذ_إلف(الحجم_الحالي, 8);
                    إذا (موضع_البيانات > الحجم_الحالي) {
                        ألحق_أصفارا_إلف(&متغير البيانات, موضع_البيانات - الحجم_الحالي);
                    };
                    ألحق_أصفارا_إلف(&متغير البيانات, 8);
                    إذا (محاذاة_البيانات < 8) { محاذاة_البيانات := 8; };
                    ليكن المعرف: معرف_دالة_خارجية_منتقاة = { القيمة: فهرس_الخارجي };
                    ليكن المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.رمز_خارجي(المعرف);
                    ليكن الموضع: موضع_رمز_إلف = موضع_رمز_إلف.معرف_في_البيانات(موضع_البيانات, 8);
                    طابق أضف_رمز_إلف(&متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, المرجع, الموضع, الهدف, الرموز_الخارجية) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
                فهرس_الخارجي := فهرس_الخارجي + 1;
            }
            إذا (!وجد) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود());
            };
            فهرس_الاسم := فهرس_الاسم + 1;
        }
    };

    ليكن الإزاحات: متغير متجه إزاحة_إلف = [];
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*الشفرة).إزاحات_النداء) مثل طبيعي)) {
        ليكن نداء: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = (*الشفرة).إزاحات_النداء[ر];
        ليكن حجم_النص: طبيعي = الطول((*الشفرة).البيانات) مثل طبيعي;
        إذا (نداء.إزاحة_بايت > حجم_النص || 4 > حجم_النص - نداء.إزاحة_بايت) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إزاحة_نداء_خارج_النص());
        };
        إذا (نداء.الإضافة != -4) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إضافة_إزاحة_غير_مدعومة());
        };
        ليكن رمز_النداء: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
            &نداء.الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
        );
        طابق ابحث_في_الخريطة(&فهرس_الهوية, &رمز_النداء) مع
        | اختياري.لا_شيء -> {
            إذا (مرجع_رمز_كائن_هو_بيانات_محلية(&رمز_النداء)) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود());
            };
            ليكن موضع_غير_معرف: موضع_رمز_إلف = موضع_رمز_إلف.غير_معرف();
            ليكن مرجع_النداء: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&رمز_النداء);
            طابق أضف_رمز_إلف(&متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, مرجع_النداء, موضع_غير_معرف, الهدف, الرموز_الخارجية) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.موجود(_) -> { };
        ليكن مرجع_الإزاحة: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&رمز_النداء);
        ليكن نوع_الإزاحة: نوع_إزاحة_إلف;
        طابق نداء.النوع مع
        | نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء -> {
            نوع_الإزاحة := نوع_إزاحة_إلف.نداء_نسبي_اثنان_وثلاثون(); }
        | نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان -> {
            نوع_الإزاحة := نوع_إزاحة_إلف.عنوان_نسبي_اثنان_وثلاثون(); };
        ليكن الإزاحة: إزاحة_إلف = {
            في_البيانات: خطأ,
            إزاحة_بايت: نداء.إزاحة_بايت,
            النوع: نوع_الإزاحة,
            الرمز: مرجع_الإزاحة,
            الإضافة: نداء.الإضافة
        };
        ألحق(الإزاحات, الإزاحة);
        ر := ر + 1;
    }

    // The shared object-attachment interface accepts absolute addresses
    // and REX.W GOT loads. x86-64 ELF encodes these as R_X86_64_64 and
    // R_X86_64_REX_GOTPCRELX in .rela.text, respectively. ARM instruction
    // relocations are not valid x86-64 relocation types.
    ليكن فهرس_طلب_النص: متغير طبيعي = 0;
    طالما (فهرس_طلب_النص < (الطول((*الشفرة).المرفقات.إزاحات_النص) مثل طبيعي)) {
        ليكن الطلب: &طلب_إزاحة_نص_كائن = &(*الشفرة).المرفقات.إزاحات_النص[فهرس_طلب_النص];
        طابق (*الطلب).النوع مع
        | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { }
        | نوع_إزاحة_رمزية_كائن.تحميل_جوت_إكس_نسبي_اثنان_وثلاثون -> { }
        | _ -> {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إضافة_إزاحة_غير_مدعومة());
        };
        ليكن بداية_الدالة: متغير طبيعي = 0;
        ليكن حجم_الدالة: متغير طبيعي = 0;
        ليكن وجد_الدالة: متغير منطقي = خطأ;
        ليكن فهرس_الدالة: متغير طبيعي = 0;
        طالما (فهرس_الدالة < (الطول((*الشفرة).الدوال) مثل طبيعي) && !وجد_الدالة) {
            ليكن الدالة: &موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[فهرس_الدالة];
            إذا (معرفا_دالة_منتقاة_متساويان((*الدالة).الدالة, (*الطلب).الموضع.الدالة)) {
                بداية_الدالة := (*الدالة).إزاحة_بايت;
                حجم_الدالة := (*الدالة).حجم_بايت;
                وجد_الدالة := صواب;
            };
            فهرس_الدالة := فهرس_الدالة + 1;
        }
        ليكن حجم_الرقعة: متغير طبيعي = 8;
        طابق (*الطلب).النوع مع
        | نوع_إزاحة_رمزية_كائن.تحميل_جوت_إكس_نسبي_اثنان_وثلاثون -> {
            حجم_الرقعة := 4;
        }
        | _ -> { };
        إذا (!وجد_الدالة
            || (*الطلب).الموضع.إزاحة_بايت > حجم_الدالة
            || حجم_الرقعة > حجم_الدالة - (*الطلب).الموضع.إزاحة_بايت
            || بداية_الدالة > (الطول((*الشفرة).البيانات) مثل طبيعي)
            || (*الطلب).الموضع.إزاحة_بايت >
            (الطول((*الشفرة).البيانات) مثل طبيعي) - بداية_الدالة
            || حجم_الرقعة > (الطول((*الشفرة).البيانات) مثل طبيعي)
            - بداية_الدالة - (*الطلب).الموضع.إزاحة_بايت) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إزاحة_نداء_خارج_النص());
        };
        ليكن مرجع_الطلب: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
            &(*الطلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
        );
        طابق ابحث_في_الخريطة(&فهرس_الهوية, &مرجع_الطلب) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            إذا (مرجع_رمز_كائن_هو_بيانات_محلية(&مرجع_الطلب)) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود());
            };
            طابق أضف_رمز_إلف(
                &متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, انسخ_مرجع_رمز_كائن(&مرجع_الطلب),
                موضع_رمز_إلف.غير_معرف(), الهدف, الرموز_الخارجية
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        ليكن نوع_الإزاحة: متغير نوع_إزاحة_إلف =
            نوع_إزاحة_إلف.عنوان_مطلق_أربعة_وستون();
        طابق (*الطلب).النوع مع
        | نوع_إزاحة_رمزية_كائن.تحميل_جوت_إكس_نسبي_اثنان_وثلاثون -> {
            // R_X86_64_REX_GOTPCRELX is permitted only for REX.W MOV r64,
            // [RIP+disp32]. The final linker relaxes this to LEA for locals.
            ليكن موضع_الرقعة: طبيعي =
                بداية_الدالة + (*الطلب).الموضع.إزاحة_بايت;
            إذا ((*الطلب).الإضافة != -4
                || (*الطلب).الموضع.إزاحة_بايت < 3
                || ((*الشفرة).البيانات[موضع_الرقعة - 3] & 0xF8) != 0x48
                || (*الشفرة).البيانات[موضع_الرقعة - 2] != 0x8B
                || ((*الشفرة).البيانات[موضع_الرقعة - 1] & 0xC7) != 0x05) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إضافة_إزاحة_غير_مدعومة());
            };
            نوع_الإزاحة := نوع_إزاحة_إلف.تحميل_جوت_ريكس_نسبي_اثنان_وثلاثون();
        }
        | _ -> { };
        ليكن الإزاحة: إزاحة_إلف = {
            في_البيانات: خطأ,
            إزاحة_بايت: بداية_الدالة + (*الطلب).الموضع.إزاحة_بايت,
            النوع: نوع_الإزاحة,
            الرمز: مرجع_الطلب,
            الإضافة: (*الطلب).الإضافة
        };
        ألحق(الإزاحات, الإزاحة);
        فهرس_طلب_النص := فهرس_طلب_النص + 1;
    }

    ليكن فهرس_بيانات: متغير طبيعي = 0;
    طالما (فهرس_بيانات < (الطول(إزاحات_بيانات) مثل طبيعي)) {
        ليكن الطلب: إزاحة_إلف = إزاحات_بيانات[فهرس_بيانات];
        طابق ابحث_في_الخريطة(&فهرس_الهوية, &الطلب.الرمز) مع
        | اختياري.لا_شيء -> {
            إذا (مرجع_رمز_كائن_هو_بيانات_محلية(&الطلب.الرمز)) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود());
            };
            ليكن موضع_غير_معرف: موضع_رمز_إلف = موضع_رمز_إلف.غير_معرف();
            طابق أضف_رمز_إلف(
                &متغير الرموز, &متغير فهرس_الهوية, &متغير فهرس_الأسماء, انسخ_مرجع_رمز_كائن(&الطلب.الرمز),
                موضع_غير_معرف, الهدف, الرموز_الخارجية
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.موجود(_) -> { };
        ألحق(الإزاحات, الطلب);
        فهرس_بيانات := فهرس_بيانات + 1;
    }

    طابق طبق_اسم_دخول_إلف(&متغير الرموز, &فهرس_الهوية, دالة_الدخول) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };

    ليكن دخول_العملية: اختياري موضع_دخول_عملية_إلف;
    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختياري.لا_شيء -> {
        دخول_العملية := اختياري.لا_شيء();
    }
    | اختياري.موجود(الدخول) -> {
        ليكن نهاية_الدخول: طبيعي = الدخول.إزاحة_بايت + الدخول.حجم_بايت;
        ليكن حجم_النص_المشفر: طبيعي = الطول((*الشفرة).البيانات) مثل طبيعي;
        إذا (نهاية_الدخول > حجم_النص_المشفر) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
        };
        ليكن الموضع: موضع_دخول_عملية_إلف = {
            إزاحة_بايت: الدخول.إزاحة_بايت,
            حجم_بايت: الدخول.حجم_بايت
        };
        دخول_العملية := اختياري.موجود(الموضع);
    };
    ليكن مواضع_دوارف: متغير متجه موضع_دالة_دوارف = [];
    ليكن موضع_ف: متغير طبيعي = 0;
    طالما (موضع_ف < (الطول((*الشفرة).الدوال) مثل طبيعي)) {
        ليكن مرجع_الدالة_المشفرة: &موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[موضع_ف];
        ليكن معرف_الدالة_دوارف: معرف_دالة_منتقاة = (*مرجع_الدالة_المشفرة).الدالة;
        ليكن إزاحة_الدالة_دوارف: طبيعي = (*مرجع_الدالة_المشفرة).إزاحة_بايت;
        ليكن حجم_الدالة_دوارف: طبيعي = (*مرجع_الدالة_المشفرة).حجم_بايت;
        ليكن اسم_ربط_الدالة_دوارف: متجه ط8 = اسم_رمز_دالة_إلف(معرف_الدالة_دوارف);
        ليكن موضع_دوارف: موضع_دالة_دوارف = {
            الدالة: معرف_الدالة_دوارف,
            إزاحة_بايت: إزاحة_الدالة_دوارف,
            حجم_بايت: حجم_الدالة_دوارف,
            اسم_الربط: اسم_ربط_الدالة_دوارف
        };
        ألحق(مواضع_دوارف, موضع_دوارف);
        موضع_ف := موضع_ف + 1;
    }
    ليكن حزمة_دوارف_إلف: حزمة_دوارف = ابن_حزمة_دوارف_من_سياقات(
        خريطة_المصادر, أصول_المصدر, &مواضع_دوارف, &مواضع_العوام_دوارف, التصحيح, تصحيح_الآلة, سياق_الفك,
        الأنواع, الهدف, سجل_التخطيط, &(*الشفرة).أصول_الآلة, الطول((*الشفرة).البيانات) مثل طبيعي
    );
    ليكن ملاحظة_الوسم_المحسوبة: متجه ط8 = ملاحظة_وسم_إلف(الهدف, &دخول_العملية);
    ليكن الناتج: كائن_إلف = {
        الهدف: معرف_الهدف,
        الآلة: 62,
        النص: النص,
        البيانات: البيانات,
        محاذاة_البيانات: محاذاة_البيانات,
        الرموز: الرموز,
        الإزاحات: الإزاحات,
        دخول_العملية: دخول_العملية,
        منشئ_الوحدة: (*الشفرة).المرفقات.منشئ_الوحدة,
        ملاحظة_الوسم: ملاحظة_الوسم_المحسوبة,
        هوية_النظام: هوية_نظام_إلف(الهدف),
        دوارف: حزمة_دوارف_إلف
    };
    أرجع نتيجة_بناء_إلف.نجح(الناتج);
}

عرف هوية_نظام_إلف(الهدف: &واصف_هدف): طبيعي {
    إذا ((*الهدف).المنصة.المنصة == هوية_منصة.فري_بي_إس_دي()) { أرجع 9; };
    أرجع 0;
}

// The FreeBSD ABI note (NT_FREEBSD_ABI_TAG, as lib/csu/common/crtbrand.S
// emits it) of the object that defines `_start`: name "FreeBSD", the
// __FreeBSD_version of releng/14.2, from which the kernel derives p_osrel.
// The LLVM provider writes the same note (provider/llvm/entry.sn).
عرف ملاحظة_وسم_إلف(الهدف: &واصف_هدف, الدخول: &اختياري موضع_دخول_عملية_إلف): متجه ط8 {
    ليكن الملاحظة: متغير متجه ط8 = [];
    إذا (!هدف_نواة_فري_بي_إس_دي_مباشر(الهدف)) { أرجع الملاحظة; };
    طابق *الدخول مع
    | اختياري.لا_شيء -> { أرجع الملاحظة; }
    | اختياري.موجود(_) -> { };
    ألحق_ط32_إلف(&متغير الملاحظة, 8);
    ألحق_ط32_إلف(&متغير الملاحظة, 4);
    ألحق_ط32_إلف(&متغير الملاحظة, 1);
    ليكن الاسم: متجه ط8 = بايتات_من_نص(«FreeBSD»);
    ألحق_بايتات_إلف(&متغير الملاحظة, &الاسم);
    ألحق_ط8_إلف(&متغير الملاحظة, 0);
    ألحق_ط32_إلف(&متغير الملاحظة, 1402000);
    أرجع الملاحظة;
}

عرف ابن_حزمة_دوارف_فارغة_إلف(): حزمة_دوارف {
    ليكن معلومات: متجه ط8 = [];
    ليكن اختصارات: متجه ط8 = [];
    ليكن سطور: متجه ط8 = [];
    ليكن سلاسل_سطور: متجه ط8 = [];
    ليكن سلاسل: متجه ط8 = [];
    ليكن عناوين: متجه ط8 = [];
    ليكن مواقع: متجه ط8 = [];
    ليكن قوائم_مواقع: متجه ط8 = [];
    ليكن إطار: متجه ط8 = [];
    ليكن نطاقات_عناوين: متجه ط8 = [];
    ليكن قوائم_نطاقات: متجه ط8 = [];
    ليكن أسماء_عامة: متجه ط8 = [];
    ليكن فهرس_أسماء: متجه ط8 = [];
    ليكن رقع_العناوين: متجه رقعة_عنوان_دوارف = [];
    ليكن رقع_الأقسام: متجه رقعة_قسم_دوارف = [];
    ليكن الحزمة: حزمة_دوارف = {
        الإصدار: إصدار_دوارف.خمسة(),
        صيغة_الإزاحة: صيغة_إزاحة_دوارف.دوارف32(),
        حجم_العنوان: 8,
        معلومات: معلومات,
        اختصارات: اختصارات,
        سطور: سطور,
        سلاسل_سطور: سلاسل_سطور,
        سلاسل: سلاسل,
        عناوين: عناوين,
        مواقع: مواقع,
        قوائم_مواقع: قوائم_مواقع,
        إطار: إطار,
        نطاقات_عناوين: نطاقات_عناوين,
        قوائم_نطاقات: قوائم_نطاقات,
        أسماء_عامة: أسماء_عامة,
        فهرس_أسماء: فهرس_أسماء,
        رقع_العناوين: رقع_العناوين,
        رقع_الأقسام: رقع_الأقسام
    };
    أرجع الحزمة;
}

// Compute .strtab positions from canonical symbol-name lengths without
// materializing a second copy of their bytes before ELF output exists.
عرف احسب_إزاحات_نصوص_رموز_إلف(
    الرموز: &متجه رمز_إلف,
    الإزاحات: &متغير متجه طبيعي
): طبيعي {
    ليكن الموضع: متغير طبيعي = 1;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        ألحق(*الإزاحات, الموضع);
        الموضع := الموضع + (الطول((*الرموز)[ف].الاسم) مثل طبيعي) + 1;
        ف := ف + 1;
    }
    أرجع الموضع;
}

// The final ELF buffer must own .strtab bytes. Append names there once,
// keeping the same leading NUL, symbol order and trailing NULs.
عرف ألحق_نصوص_رموز_إلف(
    البايتات: &متغير متجه ط8,
    الرموز: &متجه رمز_إلف,
    يوجد_دخول: منطقي
): فراغ {
    ألحق(*البايتات, 0 مثل ط8);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        ألحق_بايتات_إلف(البايتات, &(*الرموز)[ف].الاسم);
        ألحق(*البايتات, 0 مثل ط8);
        ف := ف + 1;
    }
    إذا (يوجد_دخول) {
        ليكن اسم_الدخول: متجه ط8 = اسم_دخول_عملية_إلف();
        ألحق_بايتات_إلف(البايتات, &اسم_الدخول);
        ألحق(*البايتات, 0 مثل ط8);
    };
}

عام نوع نوع_قسم_دوارف_إلف =
    | معلومات | اختصارات | سطور | سلاسل_سطور | سلاسل | عناوين
    | مواقع | قوائم_مواقع | إطار | نطاقات_عناوين | قوائم_نطاقات
    | أسماء_عامة | فهرس_أسماء
;

عرف أقسام_دوارف_إلف_الفعالة(دوارف: &حزمة_دوارف): متجه نوع_قسم_دوارف_إلف {
    ليكن الناتج: متغير متجه نوع_قسم_دوارف_إلف = [];
    ألحق(الناتج, نوع_قسم_دوارف_إلف.معلومات());
    ألحق(الناتج, نوع_قسم_دوارف_إلف.اختصارات());
    ألحق(الناتج, نوع_قسم_دوارف_إلف.سطور());
    // DWARF policy owns version selection. The object layer only materializes
    // sections that the selected serializer actually produced.
    إذا (الطول((*دوارف).سلاسل_سطور) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.سلاسل_سطور()); };
    إذا (الطول((*دوارف).سلاسل) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.سلاسل()); };
    إذا (الطول((*دوارف).عناوين) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.عناوين()); };
    إذا (الطول((*دوارف).مواقع) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.مواقع()); };
    إذا (الطول((*دوارف).قوائم_مواقع) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.قوائم_مواقع()); };
    إذا (الطول((*دوارف).إطار) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.إطار()); };
    إذا (الطول((*دوارف).نطاقات_عناوين) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.نطاقات_عناوين()); };
    إذا (الطول((*دوارف).قوائم_نطاقات) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.قوائم_نطاقات()); };
    إذا (الطول((*دوارف).أسماء_عامة) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.أسماء_عامة()); };
    إذا (الطول((*دوارف).فهرس_أسماء) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.فهرس_أسماء()); };
    أرجع الناتج;
}

عرف اسم_قسم_دوارف_إلف(النوع: نوع_قسم_دوارف_إلف): متجه ط8 {
    طابق النوع مع
    | نوع_قسم_دوارف_إلف.معلومات -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_info»); أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.اختصارات -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_abbrev»); أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.سطور -> { ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_line»);
        أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.سلاسل_سطور -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_line_str»);
        أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.سلاسل -> { ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_str»);
        أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.عناوين -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_addr»); أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.مواقع -> { ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_loc»);
        أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.قوائم_مواقع -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_loclists»);
        أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.إطار -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_frame»); أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.نطاقات_عناوين -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_aranges»);
        أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.قوائم_نطاقات -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_rnglists»);
        أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.أسماء_عامة -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_pubnames»);
        أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.فهرس_أسماء -> {
        ليكن الاسم: متجه ط8 = بايتات_من_نص(«.debug_names»); أرجع الاسم; };
}

