    دع عنوان_بيانات_قسم: متغير غير_موقع = 0;
    لو (حجم_البيانات > 0) { موضع_بيانات_قسم := موضع_البيانات_التنفيذي; عنوان_بيانات_قسم := عنوان_البيانات; };
    لو (!ألحق_ملحق_دوارف_إلف(&متغير التنفيذي, بداية_ملحق_دوارف, دوارف, موضع_النص_التنفيذي, عنوان_النص, حجم_النص, موضع_بيانات_قسم, عنوان_بيانات_قسم, حجم_البيانات)) {
        أرجع نتيجة_إنهاء_تنفيذي_إلف.خطأ(خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح());
    };
    أرجع نتيجة_إنهاء_تنفيذي_إلف.نجح(التنفيذي);
}
