): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المعلنة) مثل غير_موقع)) {
        لو (اسما_رمز_خارجي_كائن_متساويان(الاسم, &(*المعلنة)[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف ابحث_ترتيب_رمز_خارجي_إلف(
    الفهارس: &متجه غير_موقع,
    فهرس_الرمز: غير_موقع
): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الفهارس) مثل غير_موقع)) {
        لو ((*الفهارس)[ف] == فهرس_الرمز) { أرجع اختيار.بعض(ف); };
