عام نوع خطأ_إلف =
    | هدف_غير_متوافق بنوع معرف_هدف
    | معمارية_غير_مدعومة بنوع معرف_هدف
    | صيغة_كائن_غير_مدعومة بنوع معرف_هدف
    | نموذج_بيانات_غير_مدعوم بنوع معرف_هدف
    | رمز_مكرر
    | إزاحة_نداء_خارج_النص
    | إضافة_إزاحة_غير_مدعومة
    | رمز_إزاحة_مفقود
    | رمز_دخول_مفقود بنوع معرف_دالة_منتقاة
    | حدود_صيغة_متجاوزة
;

عام نوع نتيجة_بناء_إلف =
    | نجح بنوع كائن_إلف
    | خطأ بنوع خطأ_إلف
;

عام نوع نتيجة_تسلسل_إلف =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_إلف
;

عرف ألحق_غ8_إلف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق(*البايتات, (القيمة % 256) مثل غ8);
}

عرف ألحق_غ16_إلف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 2) {
        ألحق_غ8_إلف(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_غ32_إلف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        ألحق_غ8_إلف(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_غ64_إلف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        ألحق_غ8_إلف(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_أصفارا_إلف(البايتات: &متغير متجه غ8, العدد: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق_غ8_إلف(البايتات, 0);
        ف := ف + 1;
    }
}

عرف أكمل_إلف_إلى(البايتات: &متغير متجه غ8, الموضع: غير_موقع): منطقي {
    دع الحالي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الحالي > الموضع) {
        أرجع خطأ;
    };
    ألحق_أصفارا_إلف(البايتات, الموضع - الحالي);
    أرجع صواب;
}

عرف حاذ_إلف(القيمة: غير_موقع, المحاذاة: غير_موقع): غير_موقع {
    لو (المحاذاة == 0) {
        أرجع القيمة;
    };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) {
        أرجع القيمة;
    };
    أرجع القيمة + (المحاذاة - الباقي);
}

عرف بايت_سداسي_إلف(القيمة: غير_موقع): غ8 {
    لو (القيمة < 10) {
        أرجع (0x30 + القيمة) مثل غ8;
    };
    أرجع (0x61 + (القيمة - 10)) مثل غ8;
}

عرف اسم_رمز_دالة_إلف(المعرف: معرف_دالة_منتقاة): متجه غ8 {
    دع البايتات: متغير متجه غ8 = [];
    // sultanc_fn_
    دع المقدمة: متجه غ8 = [
        0x73, 0x75, 0x6C, 0x74, 0x61, 0x6E, 0x63, 0x5F, 0x66, 0x6E, 0x5F
    ];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المقدمة) مثل غير_موقع)) {
        ألحق(البايتات, المقدمة[ف]);
        ف := ف + 1;
    }
    دع القاسم: متغير غير_موقع = 0x1000000000000000;
    دع ر: متغير غير_موقع = 0;
    بينما (ر < 16) {
        دع المقسوم: غير_موقع = المعرف.القيمة / القاسم;
        دع الرقم: غير_موقع = المقسوم % 16;
        ألحق(البايتات, بايت_سداسي_إلف(الرقم));
        لو (القاسم > 1) {
            القاسم := القاسم / 16;
        };
        ر := ر + 1;
    }
    أرجع البايتات;
}

عرف اسم_رمز_عام_إلف(المعرف: معرف_عام_مسير): متجه غ8 {
    دع البايتات: متغير متجه غ8 = [
        0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x67,0x6C,0x6F,0x62,0x61,0x6C,0x5F
    ];
    دع القاسم: متغير غير_موقع = 0x1000000000000000;
    دع ر: متغير غير_موقع = 0;
    بينما (ر < 16) {
        دع المقسوم: غير_موقع = المعرف.القيمة / القاسم;
        دع الرقم: غير_موقع = المقسوم % 16;
        ألحق(البايتات, بايت_سداسي_إلف(الرقم));
        لو (القاسم > 1) { القاسم := القاسم / 16; };
        ر := ر + 1;
    }
    أرجع البايتات;
}

عرف اسم_مرجع_رمز_إلف(
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه غ8
): اختيار متجه غ8 {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> { أرجع اختيار.بعض(اسم_رمز_دالة_إلف(الدالة)); }
    | مرجع_رمز_كائن.عام(العام) -> { أرجع اختيار.بعض(اسم_رمز_عام_إلف(العام)); }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> { أرجع اسم_رمز_خارجي_كائن_من_جدول(المعرف, الرموز_الخارجية); }
    | مرجع_رمز_كائن.خدمة_تشغيل(الخدمة) -> { أرجع اسم_رمز_خدمة_تشغيل_للهدف(الهدف, الخدمة); }
    | مرجع_رمز_كائن.مرفق_مضيف(المرفق) -> { أرجع اسم_رمز_مرفق_مضيف_للهدف(الهدف, المرفق); }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> { أرجع اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي); }
    | مرجع_رمز_كائن.بيانات_ثابتة(_) -> { أرجع اختيار.لا_شيء(); };
}

عرف ابحث_رمز_إلف(
    الرموز: &متجه رمز_إلف,
    المرجع: &مرجع_رمز_كائن
): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرموز) مثل غير_موقع)) {
        لو (مرجعا_رمز_كائن_متساويان(&(*الرموز)[ف].المرجع, المرجع)) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أضف_رمز_إلف(
    الرموز: &متغير متجه رمز_إلف,
    المرجع: مرجع_رمز_كائن,
    الموضع: موضع_رمز_إلف,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه غ8
): اختيار خطأ_إلف {
    طابق ابحث_رمز_إلف(الرموز, &المرجع) مع
    | اختيار.بعض(_) -> { أرجع اختيار.بعض(خطأ_إلف.رمز_مكرر()); }
    | اختيار.لا_شيء -> { };
    طابق اسم_مرجع_رمز_إلف(&المرجع, الهدف, الرموز_الخارجية) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_إلف.رمز_إزاحة_مفقود()); }
    | اختيار.بعض(الاسم) -> {
        دع الرمز: رمز_إلف = { المرجع: المرجع, الاسم: الاسم, الموضع: الموضع };
        ألحق(*الرموز, الرمز);
        أرجع اختيار.لا_شيء();
    };
}

عرف اسم_دخول_إلف(): متجه غ8 {
    // main
    دع الاسم: متجه غ8 = [0x6D, 0x61, 0x69, 0x6E];
    أرجع الاسم;
}

عرف طبق_اسم_دخول_إلف(
    الرموز: &متغير متجه رمز_إلف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة
): اختيار خطأ_إلف {
    طابق دالة_الدخول مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الدخول) -> {
        دع مرجع_الدخول: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدخول);
        طابق ابحث_رمز_إلف(الرموز, &مرجع_الدخول) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_إلف.رمز_دخول_مفقود(الدخول)); }
        | اختيار.بعض(ف) -> {
            طابق (*الرموز)[ف].الموضع مع
            | موضع_رمز_إلف.غير_معرف -> { أرجع اختيار.بعض(خطأ_إلف.رمز_دخول_مفقود(الدخول)); }
            | موضع_رمز_إلف.معرف_في_النص(الإزاحة, الحجم) -> {
                دع الاسم: متجه غ8 = اسم_دخول_إلف();
                دع موضع_الدخول: موضع_رمز_إلف = موضع_رمز_إلف.معرف_في_النص(الإزاحة, الحجم);
                دع الرمز: رمز_إلف = { المرجع: مرجع_الدخول, الاسم: الاسم, الموضع: موضع_الدخول };
                (*الرموز)[ف] := الرمز; أرجع اختيار.لا_شيء();
            }
            | موضع_رمز_إلف.معرف_في_البيانات(_, _) -> {
                أرجع اختيار.بعض(خطأ_إلف.رمز_دخول_مفقود(الدخول));
            };
        };
    };
}

عام عرف ابن_كائن_إلف_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_CFI,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_بناء_إلف {
    دع معرف_الشفرة: معرف_هدف = (*الشفرة).الهدف;
    دع معرف_الهدف: معرف_هدف = (*الهدف).المعرف;
    لو (!معرفا_هدف_متساويان(معرف_الشفرة, معرف_الهدف)) {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.هدف_غير_متوافق(معرف_الشفرة));
    };
    // هذا الكاتب يستهلك شفرة x86_64 مشفرة أصلا؛ Object يتحقق من صيغة الحاوية ونموذج البيانات فقط.
    طابق (*الهدف).صيغة_الكائن مع
    | صيغة_كائن_هدف.إلف -> { }
    | _ -> {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.صيغة_كائن_غير_مدعومة(معرف_الهدف));
    };
    لو ((*الهدف).نموذج_البيانات.عرض_المؤشر != 64) {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.نموذج_بيانات_غير_مدعوم(معرف_الهدف));
    };
    طابق (*الهدف).نموذج_البيانات.ترتيب_البايت مع
    | ترتيب_بايت.صغير -> { }
    | _ -> {
        أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.نموذج_بيانات_غير_مدعوم(معرف_الهدف));
    };

    دع الرموز: متغير متجه رمز_إلف = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الشفرة).الدوال) مثل غير_موقع)) {
        دع مرجع_الموضع_المشفر: &موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[ف];
        دع إزاحة_الدالة: غير_موقع = (*مرجع_الموضع_المشفر).إزاحة_بايت;
        دع حجم_الدالة: غير_موقع = (*مرجع_الموضع_المشفر).حجم_بايت;
        دع معرف_الدالة: معرف_دالة_منتقاة = (*مرجع_الموضع_المشفر).الدالة;
        لو (إزاحة_الدالة + حجم_الدالة > (الطول((*الشفرة).البيانات) مثل غير_موقع)) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
        };
        دع الموضع: موضع_رمز_إلف =
            موضع_رمز_إلف.معرف_في_النص(إزاحة_الدالة, حجم_الدالة);
        دع مرجع_الدالة: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_الدالة);
        طابق أضف_رمز_إلف(&متغير الرموز, مرجع_الدالة, الموضع, الهدف, الرموز_الخارجية) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    دع البيانات: متغير متجه غ8 = [];
    دع مواضع_العوام_دوارف: متغير متجه موضع_عام_دوارف = [];
    دع محاذاة_البيانات: متغير غير_موقع = 1;
    دع غ: متغير غير_موقع = 0;
    بينما (غ < (الطول((*الشفرة).المرفقات.البيانات_العامة) مثل غير_موقع)) {
        دع مرجع_العام: &بيانات_عام_كائن = &(*الشفرة).المرفقات.البيانات_العامة[غ];
        دع محاذاة_العام: متغير غير_موقع = (*مرجع_العام).المحاذاة;
        لو (محاذاة_العام == 0) { محاذاة_العام := 1; };
        لو (محاذاة_العام > محاذاة_البيانات) { محاذاة_البيانات := محاذاة_العام; };
        دع الحجم_الحالي: غير_موقع = الطول(البيانات) مثل غير_موقع;
        دع موضع_العام: غير_موقع = حاذ_إلف(الحجم_الحالي, محاذاة_العام);
        لو (موضع_العام > الحجم_الحالي) { ألحق_أصفارا_إلف(&متغير البيانات, موضع_العام - الحجم_الحالي); };
        دع معرف_العام: معرف_عام_مسير = (*مرجع_العام).المعرف;
        دع اسم_ربط_العام_دوارف: متجه غ8 = اسم_رمز_عام_إلف(معرف_العام);
        دع موضع_دوارف_للعام: موضع_عام_دوارف = {
            العام: معرف_العام, إزاحة_بايت: موضع_العام, اسم_الربط: اسم_ربط_العام_دوارف
        };
        ألحق(مواضع_العوام_دوارف, موضع_دوارف_للعام);
        دع المرجع_العام: مرجع_رمز_كائن = مرجع_رمز_كائن.عام((*مرجع_العام).المعرف);
        دع موضع_الرمز: موضع_رمز_إلف = موضع_رمز_إلف.معرف_في_البيانات(موضع_العام, الطول((*مرجع_العام).البيانات) مثل غير_موقع);
        طابق أضف_رمز_إلف(&متغير الرموز, المرجع_العام, موضع_الرمز, الهدف, الرموز_الخارجية) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
        | اختيار.لا_شيء -> { };
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول((*مرجع_العام).البيانات) مثل غير_موقع)) { ألحق(البيانات, (*مرجع_العام).البيانات[ج]); ج := ج + 1; }
        غ := غ + 1;
    }

    دع الإزاحات: متغير متجه إزاحة_إلف = [];
    دع ر: متغير غير_موقع = 0;
    بينما (ر < (الطول((*الشفرة).إزاحات_النداء) مثل غير_موقع)) {
        دع نداء: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = (*الشفرة).إزاحات_النداء[ر];
        لو (نداء.إزاحة_بايت + 4 > (الطول((*الشفرة).البيانات) مثل غير_موقع)) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إزاحة_نداء_خارج_النص());
        };
        لو (نداء.الإضافة != -4) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.إضافة_إزاحة_غير_مدعومة());
        };
        طابق ابحث_رمز_إلف(&الرموز, &نداء.الرمز) مع
        | اختيار.لا_شيء -> {
            لو (مرجع_رمز_كائن_هو_بيانات_محلية(&نداء.الرمز)) {
                أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود());
            };
            دع موضع_غير_معرف: موضع_رمز_إلف = موضع_رمز_إلف.غير_معرف();
            دع مرجع_النداء: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&نداء.الرمز);
            طابق أضف_رمز_إلف(&متغير الرموز, مرجع_النداء, موضع_غير_معرف, الهدف, الرموز_الخارجية) مع
            | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.بعض(_) -> { };
        دع مرجع_الإزاحة: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&نداء.الرمز);
        دع نوع_الإزاحة: نوع_إزاحة_إلف;
        طابق نداء.النوع مع
        | نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء -> { نوع_الإزاحة := نوع_إزاحة_إلف.نداء_نسبي_اثنان_وثلاثون(); }
        | نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان -> { نوع_الإزاحة := نوع_إزاحة_إلف.عنوان_نسبي_اثنان_وثلاثون(); };
        دع الإزاحة: إزاحة_إلف = {
            إزاحة_بايت: نداء.إزاحة_بايت,
            النوع: نوع_الإزاحة,
            الرمز: مرجع_الإزاحة,
            الإضافة: نداء.الإضافة
        };
        ألحق(الإزاحات, الإزاحة);
        ر := ر + 1;
    }

    طابق طبق_اسم_دخول_إلف(&متغير الرموز, دالة_الدخول) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_إلف.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { };

    دع مرجع_النص: &متجه غ8 = &(*الشفرة).البيانات;
    دع النص: متجه غ8 = *مرجع_النص;
    دع دخول_العملية: اختيار موضع_دخول_عملية_إلف;
    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختيار.لا_شيء -> {
        دخول_العملية := اختيار.لا_شيء();
    }
    | اختيار.بعض(الدخول) -> {
        دع نهاية_الدخول: غير_موقع = الدخول.إزاحة_بايت + الدخول.حجم_بايت;
        دع حجم_النص_المشفر: غير_موقع = الطول((*الشفرة).البيانات) مثل غير_موقع;
        لو (نهاية_الدخول > حجم_النص_المشفر) {
            أرجع نتيجة_بناء_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة());
        };
        دع الموضع: موضع_دخول_عملية_إلف = {
            إزاحة_بايت: الدخول.إزاحة_بايت,
            حجم_بايت: الدخول.حجم_بايت
        };
        دخول_العملية := اختيار.بعض(الموضع);
    };
    دع مواضع_دوارف: متغير متجه موضع_دالة_دوارف = [];
    دع موضع_ف: متغير غير_موقع = 0;
    بينما (موضع_ف < (الطول((*الشفرة).الدوال) مثل غير_موقع)) {
        دع مرجع_الدالة_المشفرة: &موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[موضع_ف];
        دع معرف_الدالة_دوارف: معرف_دالة_منتقاة = (*مرجع_الدالة_المشفرة).الدالة;
        دع إزاحة_الدالة_دوارف: غير_موقع = (*مرجع_الدالة_المشفرة).إزاحة_بايت;
        دع حجم_الدالة_دوارف: غير_موقع = (*مرجع_الدالة_المشفرة).حجم_بايت;
        دع اسم_ربط_الدالة_دوارف: متجه غ8 = اسم_رمز_دالة_إلف(معرف_الدالة_دوارف);
        دع موضع_دوارف: موضع_دالة_دوارف = {
            الدالة: معرف_الدالة_دوارف,
            إزاحة_بايت: إزاحة_الدالة_دوارف,
            حجم_بايت: حجم_الدالة_دوارف,
            اسم_الربط: اسم_ربط_الدالة_دوارف
        };
        ألحق(مواضع_دوارف, موضع_دوارف);
        موضع_ف := موضع_ف + 1;
    }
    دع حزمة_دوارف_إلف: حزمة_دوارف = ابن_حزمة_دوارف_من_سياقات(
        خريطة_المصادر, أصول_المصدر, &مواضع_دوارف, &مواضع_العوام_دوارف, التصحيح, تصحيح_الآلة, سياق_الفك,
        الأنواع, الهدف, سجل_التخطيط, &(*الشفرة).أصول_الآلة, الطول(النص) مثل غير_موقع
    );
    دع الناتج: كائن_إلف = {
        الهدف: معرف_الهدف,
        النص: النص,
        البيانات: البيانات,
        محاذاة_البيانات: محاذاة_البيانات,
        الرموز: الرموز,
        الإزاحات: الإزاحات,
        دخول_العملية: دخول_العملية,
        دوارف: حزمة_دوارف_إلف
    };
    أرجع نتيجة_بناء_إلف.نجح(الناتج);
}

عرف ابن_جدول_نصوص_رموز_إلف(
    الرموز: &متجه رمز_إلف,
    الإزاحات: &متغير متجه غير_موقع
): متجه غ8 {
    دع النصوص: متغير متجه غ8 = [0];
    دع المواقع: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرموز) مثل غير_موقع)) {
        ألحق(المواقع, الطول(النصوص) مثل غير_موقع);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول((*الرموز)[ف].الاسم) مثل غير_موقع)) {
            ألحق(النصوص, (*الرموز)[ف].الاسم[ك]);
            ك := ك + 1;
        }
        ألحق(النصوص, 0 مثل غ8);
        ف := ف + 1;
    }
    *الإزاحات := المواقع;
    أرجع النصوص;
}

عام نوع نوع_قسم_دوارف_إلف =
    | معلومات | اختصارات | سطور | سلاسل_سطور | سلاسل | عناوين
    | مواقع | قوائم_مواقع | إطار | نطاقات_عناوين | قوائم_نطاقات
    | أسماء_عامة | فهرس_أسماء
;

عرف أقسام_دوارف_إلف_الفعالة(دوارف: &حزمة_دوارف): متجه نوع_قسم_دوارف_إلف {
    دع الناتج: متغير متجه نوع_قسم_دوارف_إلف = [];
    ألحق(الناتج, نوع_قسم_دوارف_إلف.معلومات());
    ألحق(الناتج, نوع_قسم_دوارف_إلف.اختصارات());
    ألحق(الناتج, نوع_قسم_دوارف_إلف.سطور());
    // DWARF policy owns version selection. The object layer only materializes
    // sections that the selected serializer actually produced.
    لو (الطول((*دوارف).سلاسل_سطور) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.سلاسل_سطور()); };
    لو (الطول((*دوارف).سلاسل) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.سلاسل()); };
    لو (الطول((*دوارف).عناوين) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.عناوين()); };
    لو (الطول((*دوارف).مواقع) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.مواقع()); };
    لو (الطول((*دوارف).قوائم_مواقع) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.قوائم_مواقع()); };
    لو (الطول((*دوارف).إطار) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.إطار()); };
    لو (الطول((*دوارف).نطاقات_عناوين) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.نطاقات_عناوين()); };
    لو (الطول((*دوارف).قوائم_نطاقات) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.قوائم_نطاقات()); };
    لو (الطول((*دوارف).أسماء_عامة) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.أسماء_عامة()); };
    لو (الطول((*دوارف).فهرس_أسماء) > 0) { ألحق(الناتج, نوع_قسم_دوارف_إلف.فهرس_أسماء()); };
    أرجع الناتج;
}

عرف اسم_قسم_دوارف_إلف(النوع: نوع_قسم_دوارف_إلف): متجه غ8 {
    طابق النوع مع
    | نوع_قسم_دوارف_إلف.معلومات -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x69,0x6E,0x66,0x6F]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.اختصارات -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x61,0x62,0x62,0x72,0x65,0x76]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.سطور -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x6C,0x69,0x6E,0x65]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.سلاسل_سطور -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x6C,0x69,0x6E,0x65,0x5F,0x73,0x74,0x72]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.سلاسل -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x73,0x74,0x72]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.عناوين -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x61,0x64,0x64,0x72]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.مواقع -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x6C,0x6F,0x63]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.قوائم_مواقع -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x6C,0x6F,0x63,0x6C,0x69,0x73,0x74,0x73]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.إطار -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x66,0x72,0x61,0x6D,0x65]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.نطاقات_عناوين -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x61,0x72,0x61,0x6E,0x67,0x65,0x73]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.قوائم_نطاقات -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x72,0x6E,0x67,0x6C,0x69,0x73,0x74,0x73]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.أسماء_عامة -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x70,0x75,0x62,0x6E,0x61,0x6D,0x65,0x73]; أرجع الاسم; }
    | نوع_قسم_دوارف_إلف.فهرس_أسماء -> { دع الاسم: متجه غ8 = [0x2E,0x64,0x65,0x62,0x75,0x67,0x5F,0x6E,0x61,0x6D,0x65,0x73]; أرجع الاسم; };
}

عرف اسم_إزاحات_قسم_دوارف_إلف(النوع: نوع_قسم_دوارف_إلف): متجه غ8 {
    دع البداية: متغير متجه غ8 = [0x2E,0x72,0x65,0x6C,0x61];
    دع الاسم: متجه غ8 = اسم_قسم_دوارف_إلف(النوع);
    دع ف: متغير غير_موقع = 0; بينما (ف < (الطول(الاسم) مثل غير_موقع)) { ألحق(البداية, الاسم[ف]); ف := ف + 1; }
    أرجع البداية;
}

عرف حجم_قسم_دوارف_إلف(دوارف: &حزمة_دوارف, النوع: نوع_قسم_دوارف_إلف): غير_موقع {
    طابق النوع مع
    | نوع_قسم_دوارف_إلف.معلومات -> { أرجع الطول((*دوارف).معلومات) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.اختصارات -> { أرجع الطول((*دوارف).اختصارات) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.سطور -> { أرجع الطول((*دوارف).سطور) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.سلاسل_سطور -> { أرجع الطول((*دوارف).سلاسل_سطور) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.سلاسل -> { أرجع الطول((*دوارف).سلاسل) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.عناوين -> { أرجع الطول((*دوارف).عناوين) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.مواقع -> { أرجع الطول((*دوارف).مواقع) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.قوائم_مواقع -> { أرجع الطول((*دوارف).قوائم_مواقع) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.إطار -> { أرجع الطول((*دوارف).إطار) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.نطاقات_عناوين -> { أرجع الطول((*دوارف).نطاقات_عناوين) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.قوائم_نطاقات -> { أرجع الطول((*دوارف).قوائم_نطاقات) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.أسماء_عامة -> { أرجع الطول((*دوارف).أسماء_عامة) مثل غير_موقع; }
    | نوع_قسم_دوارف_إلف.فهرس_أسماء -> { أرجع الطول((*دوارف).فهرس_أسماء) مثل غير_موقع; };
}

عرف محاذاة_قسم_دوارف_إلف(النوع: نوع_قسم_دوارف_إلف): غير_موقع {
    طابق النوع مع
    | نوع_قسم_دوارف_إلف.إطار -> { أرجع 8; }
    | نوع_قسم_دوارف_إلف.نطاقات_عناوين -> { أرجع 8; }
    | نوع_قسم_دوارف_إلف.عناوين -> { أرجع 8; }
    | _ -> { أرجع 1; };
}

عرف ألحق_قسم_دوارف_إلف(ب: &متغير متجه غ8, دوارف: &حزمة_دوارف, النوع: نوع_قسم_دوارف_إلف): فراغ {
    طابق النوع مع
    | نوع_قسم_دوارف_إلف.معلومات -> { ألحق_بايتات_إلف(ب, &(*دوارف).معلومات); }
    | نوع_قسم_دوارف_إلف.اختصارات -> { ألحق_بايتات_إلف(ب, &(*دوارف).اختصارات); }
    | نوع_قسم_دوارف_إلف.سطور -> { ألحق_بايتات_إلف(ب, &(*دوارف).سطور); }
    | نوع_قسم_دوارف_إلف.سلاسل_سطور -> { ألحق_بايتات_إلف(ب, &(*دوارف).سلاسل_سطور); }
    | نوع_قسم_دوارف_إلف.سلاسل -> { ألحق_بايتات_إلف(ب, &(*دوارف).سلاسل); }
    | نوع_قسم_دوارف_إلف.عناوين -> { ألحق_بايتات_إلف(ب, &(*دوارف).عناوين); }
    | نوع_قسم_دوارف_إلف.مواقع -> { ألحق_بايتات_إلف(ب, &(*دوارف).مواقع); }
    | نوع_قسم_دوارف_إلف.قوائم_مواقع -> { ألحق_بايتات_إلف(ب, &(*دوارف).قوائم_مواقع); }
    | نوع_قسم_دوارف_إلف.إطار -> { ألحق_بايتات_إلف(ب, &(*دوارف).إطار); }
    | نوع_قسم_دوارف_إلف.نطاقات_عناوين -> { ألحق_بايتات_إلف(ب, &(*دوارف).نطاقات_عناوين); }
    | نوع_قسم_دوارف_إلف.قوائم_نطاقات -> { ألحق_بايتات_إلف(ب, &(*دوارف).قوائم_نطاقات); }
    | نوع_قسم_دوارف_إلف.أسماء_عامة -> { ألحق_بايتات_إلف(ب, &(*دوارف).أسماء_عامة); }
    | نوع_قسم_دوارف_إلف.فهرس_أسماء -> { ألحق_بايتات_إلف(ب, &(*دوارف).فهرس_أسماء); };
}

عرف نوع_قسم_دوارف_إلف_إلى_بيانات(النوع: نوع_قسم_دوارف_إلف): قسم_بيانات_دوارف {
    طابق النوع مع
    | نوع_قسم_دوارف_إلف.معلومات -> { أرجع قسم_بيانات_دوارف.معلومات(); }
    | نوع_قسم_دوارف_إلف.اختصارات -> { أرجع قسم_بيانات_دوارف.اختصارات(); }
    | نوع_قسم_دوارف_إلف.سطور -> { أرجع قسم_بيانات_دوارف.سطور(); }
    | نوع_قسم_دوارف_إلف.سلاسل_سطور -> { أرجع قسم_بيانات_دوارف.سلاسل_سطور(); }
    | نوع_قسم_دوارف_إلف.سلاسل -> { أرجع قسم_بيانات_دوارف.سلاسل(); }
    | نوع_قسم_دوارف_إلف.عناوين -> { أرجع قسم_بيانات_دوارف.عناوين(); }
    | نوع_قسم_دوارف_إلف.مواقع -> { أرجع قسم_بيانات_دوارف.مواقع(); }
    | نوع_قسم_دوارف_إلف.قوائم_مواقع -> { أرجع قسم_بيانات_دوارف.قوائم_مواقع(); }
    | نوع_قسم_دوارف_إلف.إطار -> { أرجع قسم_بيانات_دوارف.إطار(); }
    | نوع_قسم_دوارف_إلف.نطاقات_عناوين -> { أرجع قسم_بيانات_دوارف.نطاقات_عناوين(); }
    | نوع_قسم_دوارف_إلف.قوائم_نطاقات -> { أرجع قسم_بيانات_دوارف.قوائم_نطاقات(); }
    | نوع_قسم_دوارف_إلف.أسماء_عامة -> { أرجع قسم_بيانات_دوارف.أسماء_عامة(); }
    | نوع_قسم_دوارف_إلف.فهرس_أسماء -> { أرجع قسم_بيانات_دوارف.فهرس_أسماء(); };
}

عرف قسما_بيانات_دوارف_متساويان_إلف(أ: قسم_بيانات_دوارف, ب: قسم_بيانات_دوارف): منطقي {
    طابق أ مع
    | قسم_بيانات_دوارف.معلومات -> { طابق ب مع | قسم_بيانات_دوارف.معلومات -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.اختصارات -> { طابق ب مع | قسم_بيانات_دوارف.اختصارات -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.سطور -> { طابق ب مع | قسم_بيانات_دوارف.سطور -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.سلاسل_سطور -> { طابق ب مع | قسم_بيانات_دوارف.سلاسل_سطور -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.سلاسل -> { طابق ب مع | قسم_بيانات_دوارف.سلاسل -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.عناوين -> { طابق ب مع | قسم_بيانات_دوارف.عناوين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.مواقع -> { طابق ب مع | قسم_بيانات_دوارف.مواقع -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.قوائم_مواقع -> { طابق ب مع | قسم_بيانات_دوارف.قوائم_مواقع -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.إطار -> { طابق ب مع | قسم_بيانات_دوارف.إطار -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.نطاقات_عناوين -> { طابق ب مع | قسم_بيانات_دوارف.نطاقات_عناوين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.قوائم_نطاقات -> { طابق ب مع | قسم_بيانات_دوارف.قوائم_نطاقات -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.أسماء_عامة -> { طابق ب مع | قسم_بيانات_دوارف.أسماء_عامة -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.فهرس_أسماء -> { طابق ب مع | قسم_بيانات_دوارف.فهرس_أسماء -> { أرجع صواب; } | _ -> { أرجع خطأ; }; };
}

عرف رقعة_قسم_دوارف_لقسم_إلف(الرقعة: &رقعة_قسم_دوارف, النوع: نوع_قسم_دوارف_إلف): منطقي {
    دع المصدر: قسم_بيانات_دوارف = نوع_قسم_دوارف_إلف_إلى_بيانات(النوع);
    أرجع قسما_بيانات_دوارف_متساويان_إلف((*الرقعة).القسم, المصدر);
}

عرف فهرس_رمز_قسم_دوارف_إلف(الأقسام: &متجه نوع_قسم_دوارف_إلف, الهدف: قسم_بيانات_دوارف): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأقسام) مثل غير_موقع)) {
        دع الحالي: قسم_بيانات_دوارف = نوع_قسم_دوارف_إلف_إلى_بيانات((*الأقسام)[ف]);
        لو (قسما_بيانات_دوارف_متساويان_إلف(الحالي, الهدف)) { أرجع اختيار.بعض(3 + ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف رقعة_دوارف_لقسم_إلف(الرقعة: &رقعة_عنوان_دوارف, النوع: نوع_قسم_دوارف_إلف): منطقي {
    طابق النوع مع
    | نوع_قسم_دوارف_إلف.معلومات -> { طابق (*الرقعة).القسم مع | قسم_عنوان_دوارف.معلومات -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | نوع_قسم_دوارف_إلف.سطور -> { طابق (*الرقعة).القسم مع | قسم_عنوان_دوارف.سطور -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | نوع_قسم_دوارف_إلف.مواقع -> { طابق (*الرقعة).القسم مع | قسم_عنوان_دوارف.مواقع -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | نوع_قسم_دوارف_إلف.قوائم_مواقع -> { طابق (*الرقعة).القسم مع | قسم_عنوان_دوارف.قوائم_مواقع -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | نوع_قسم_دوارف_إلف.إطار -> { طابق (*الرقعة).القسم مع | قسم_عنوان_دوارف.إطار -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | نوع_قسم_دوارف_إلف.نطاقات_عناوين -> { طابق (*الرقعة).القسم مع | قسم_عنوان_دوارف.نطاقات_عناوين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | نوع_قسم_دوارف_إلف.عناوين -> { طابق (*الرقعة).القسم مع | قسم_عنوان_دوارف.عناوين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | نوع_قسم_دوارف_إلف.قوائم_نطاقات -> { طابق (*الرقعة).القسم مع | قسم_عنوان_دوارف.قوائم_نطاقات -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | _ -> { أرجع خطأ; };
}

عرف عدد_إزاحات_دوارف_إلف(دوارف: &حزمة_دوارف, النوع: نوع_قسم_دوارف_إلف): غير_موقع {
    دع العدد: متغير غير_موقع = 0; دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*دوارف).رقع_العناوين) مثل غير_موقع)) { لو (رقعة_دوارف_لقسم_إلف(&(*دوارف).رقع_العناوين[ف], النوع)) { العدد := العدد + 1; }; ف := ف + 1; }
    ف := 0;
    بينما (ف < (الطول((*دوارف).رقع_الأقسام) مثل غير_موقع)) { لو (رقعة_قسم_دوارف_لقسم_إلف(&(*دوارف).رقع_الأقسام[ف], النوع)) { العدد := العدد + 1; }; ف := ف + 1; }
    أرجع العدد;
}

عرف نوع_إزاحة_دوارف_إلف_للعرض(العرض: غير_موقع): اختيار غير_موقع {
    لو (العرض == 4) { أرجع اختيار.بعض(10); };
    لو (العرض == 8) { أرجع اختيار.بعض(1); };
    أرجع اختيار.لا_شيء();
}

عرف ألحق_إزاحات_دوارف_إلف(
    ب: &متغير متجه غ8,
    دوارف: &حزمة_دوارف,
    النوع: نوع_قسم_دوارف_إلف,
    الأقسام_الفعالة: &متجه نوع_قسم_دوارف_إلف
): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*دوارف).رقع_العناوين) مثل غير_موقع)) {
        دع الرقعة: رقعة_عنوان_دوارف = (*دوارف).رقع_العناوين[ف];
        لو (رقعة_دوارف_لقسم_إلف(&الرقعة, النوع)) {
            دع فهرس_رمز_القسم: متغير غير_موقع = 1;
            طابق الرقعة.المرجع.القاعدة مع | قاعدة_عنوان_دوارف.نص -> { فهرس_رمز_القسم := 1; } | قاعدة_عنوان_دوارف.بيانات -> { فهرس_رمز_القسم := 2; };
            طابق نوع_إزاحة_دوارف_إلف_للعرض(الرقعة.العرض) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(نوع_إلف) -> {
                ألحق_غ64_إلف(ب, الرقعة.الموضع);
                ألحق_غ64_إلف(ب, فهرس_رمز_القسم * 4294967296 + نوع_إلف);
                ألحق_غ64_إلف(ب, الرقعة.المرجع.إزاحة_بايت);
            };
        };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول((*دوارف).رقع_الأقسام) مثل غير_موقع)) {
        دع الرقعة: رقعة_قسم_دوارف = (*دوارف).رقع_الأقسام[ف];
        لو (رقعة_قسم_دوارف_لقسم_إلف(&الرقعة, النوع)) {
            طابق فهرس_رمز_قسم_دوارف_إلف(الأقسام_الفعالة, الرقعة.الهدف) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(فهرس_رمز_القسم) -> {
                طابق نوع_إزاحة_دوارف_إلف_للعرض(الرقعة.العرض) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(نوع_إلف) -> {
                    ألحق_غ64_إلف(ب, الرقعة.الموضع);
                    ألحق_غ64_إلف(ب, فهرس_رمز_القسم * 4294967296 + نوع_إلف);
                    ألحق_غ64_إلف(ب, الرقعة.الإزاحة);
                };
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أضف_اسم_قسم_إلف(الجدول: &متغير متجه غ8, الاسم: &متجه غ8): غير_موقع {
    دع الإزاحة: غير_موقع = الطول(*الجدول) مثل غير_موقع; دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الاسم) مثل غير_موقع)) { ألحق(*الجدول, (*الاسم)[ف]); ف := ف + 1; }
    ألحق(*الجدول, 0 مثل غ8); أرجع الإزاحة;
}


عرف اسم_دخول_عملية_إلف(): متجه غ8 {
    دع الاسم: متجه غ8 = [0x5F, 0x73, 0x74, 0x61, 0x72, 0x74];
    أرجع الاسم;
}

عرف ألحق_رمز_إلف64(
    البايتات: &متغير متجه غ8,
    اسم: غير_موقع,
    المعلومة: غير_موقع,
    فهرس_القسم: غير_موقع,
    القيمة: غير_موقع,
    الحجم: غير_موقع
): فراغ {
    ألحق_غ32_إلف(البايتات, اسم);
    ألحق_غ8_إلف(البايتات, المعلومة);
    ألحق_غ8_إلف(البايتات, 0);
    ألحق_غ16_إلف(البايتات, فهرس_القسم);
    ألحق_غ64_إلف(البايتات, القيمة);
    ألحق_غ64_إلف(البايتات, الحجم);
}

عرف ألحق_رأس_قسم_إلف64(
    البايتات: &متغير متجه غ8,
    الاسم: غير_موقع,
    النوع: غير_موقع,
    الأعلام: غير_موقع,
    الإزاحة: غير_موقع,
    الحجم: غير_موقع,
    الرابط: غير_موقع,
    المعلومة: غير_موقع,
    المحاذاة: غير_موقع,
    حجم_المدخل: غير_موقع
): فراغ {
    ألحق_غ32_إلف(البايتات, الاسم);
    ألحق_غ32_إلف(البايتات, النوع);
    ألحق_غ64_إلف(البايتات, الأعلام);
    ألحق_غ64_إلف(البايتات, 0);
    ألحق_غ64_إلف(البايتات, الإزاحة);
    ألحق_غ64_إلف(البايتات, الحجم);
    ألحق_غ32_إلف(البايتات, الرابط);
    ألحق_غ32_إلف(البايتات, المعلومة);
    ألحق_غ64_إلف(البايتات, المحاذاة);
    ألحق_غ64_إلف(البايتات, حجم_المدخل);
}

عام عرف اكتب_كائن_إلف64(الكائن: &كائن_إلف): نتيجة_تسلسل_إلف {
    دع إزاحات_الأسماء: متغير متجه غير_موقع = [];
    دع جدول_النصوص: متغير متجه غ8 = ابن_جدول_نصوص_رموز_إلف(&(*الكائن).الرموز, &متغير إزاحات_الأسماء);
    دع إزاحة_اسم_دخول_العملية: متغير غير_موقع = 0;
    طابق (*الكائن).دخول_العملية مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(_) -> {
        إزاحة_اسم_دخول_العملية := الطول(جدول_النصوص) مثل غير_موقع;
        دع اسم_الدخول: متجه غ8 = اسم_دخول_عملية_إلف();
        دع عدد_بايتات_الاسم: غير_موقع = الطول(اسم_الدخول) مثل غير_موقع;
        دع فهرس_بايت_الاسم: متغير غير_موقع = 0;
        بينما (فهرس_بايت_الاسم < عدد_بايتات_الاسم) {
            ألحق(جدول_النصوص, اسم_الدخول[فهرس_بايت_الاسم]);
            فهرس_بايت_الاسم := فهرس_بايت_الاسم + 1;
        }
        ألحق(جدول_النصوص, 0 مثل غ8);
    };

    دع أقسام_دوارف: متجه نوع_قسم_دوارف_إلف = أقسام_دوارف_إلف_الفعالة(&(*الكائن).دوارف);
    دع أنواع_إزاحات_دوارف: متغير متجه نوع_قسم_دوارف_إلف = [];
    دع فهارس_هدف_إزاحات_دوارف: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أقسام_دوارف) مثل غير_موقع)) {
        لو (عدد_إزاحات_دوارف_إلف(&(*الكائن).دوارف, أقسام_دوارف[ف]) > 0) {
            ألحق(أنواع_إزاحات_دوارف, أقسام_دوارف[ف]);
            ألحق(فهارس_هدف_إزاحات_دوارف, 6 + ف);
        };
        ف := ف + 1;
    }

    دع جدول_أسماء_الأقسام: متغير متجه غ8 = [0];
    دع اسم_نص: متجه غ8 = [0x2E,0x74,0x65,0x78,0x74];
    دع اسم_بيانات: متجه غ8 = [0x2E,0x64,0x61,0x74,0x61];
    دع اسم_إزاحات_نص: متجه غ8 = [0x2E,0x72,0x65,0x6C,0x61,0x2E,0x74,0x65,0x78,0x74];
    دع اسم_رموز: متجه غ8 = [0x2E,0x73,0x79,0x6D,0x74,0x61,0x62];
    دع اسم_نصوص: متجه غ8 = [0x2E,0x73,0x74,0x72,0x74,0x61,0x62];
    دع اسم_أسماء_الأقسام: متجه غ8 = [0x2E,0x73,0x68,0x73,0x74,0x72,0x74,0x61,0x62];
    دع إزاحة_اسم_النص: غير_موقع = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_نص);
    دع إزاحة_اسم_البيانات: غير_موقع = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_بيانات);
    دع إزاحة_اسم_إزاحات_النص: غير_موقع = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_إزاحات_نص);
    دع إزاحة_اسم_الرموز: غير_موقع = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_رموز);
    دع إزاحة_اسم_النصوص: غير_موقع = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_نصوص);
    دع إزاحات_أسماء_دوارف: متغير متجه غير_موقع = [];
    ف := 0; بينما (ف < (الطول(أقسام_دوارف) مثل غير_موقع)) { دع اسم: متجه غ8 = اسم_قسم_دوارف_إلف(أقسام_دوارف[ف]); ألحق(إزاحات_أسماء_دوارف, أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم)); ف := ف + 1; }
    دع إزاحات_أسماء_إزاحات_دوارف: متغير متجه غير_موقع = [];
    ف := 0; بينما (ف < (الطول(أنواع_إزاحات_دوارف) مثل غير_موقع)) { دع اسم: متجه غ8 = اسم_إزاحات_قسم_دوارف_إلف(أنواع_إزاحات_دوارف[ف]); ألحق(إزاحات_أسماء_إزاحات_دوارف, أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم)); ف := ف + 1; }
    دع إزاحة_اسم_جدول_الأقسام: غير_موقع = أضف_اسم_قسم_إلف(&متغير جدول_أسماء_الأقسام, &اسم_أسماء_الأقسام);

    دع حجم_الرأس: غير_موقع = 64;
    دع إزاحة_النص: غير_موقع = حاذ_إلف(حجم_الرأس, 16); دع حجم_النص: غير_موقع = الطول((*الكائن).النص) مثل غير_موقع;
    دع محاذاة_البيانات: متغير غير_موقع = (*الكائن).محاذاة_البيانات; لو (محاذاة_البيانات == 0) { محاذاة_البيانات := 1; };
    دع إزاحة_البيانات: غير_موقع = حاذ_إلف(إزاحة_النص + حجم_النص, محاذاة_البيانات); دع حجم_البيانات: غير_موقع = الطول((*الكائن).البيانات) مثل غير_موقع;
    دع إزاحة_الإزاحات: غير_موقع = حاذ_إلف(إزاحة_البيانات + حجم_البيانات, 8); دع عدد_الإزاحات: غير_موقع = الطول((*الكائن).الإزاحات) مثل غير_موقع; دع حجم_الإزاحات: غير_موقع = عدد_الإزاحات * 24;
    دع إزاحة_الرموز: غير_موقع = حاذ_إلف(إزاحة_الإزاحات + حجم_الإزاحات, 8);
    دع عدد_رموز_الكائن: غير_موقع = الطول((*الكائن).الرموز) مثل غير_موقع; دع عدد_رموز_الدخول: متغير غير_موقع = 0;
    طابق (*الكائن).دخول_العملية مع | اختيار.لا_شيء -> { } | اختيار.بعض(_) -> { عدد_رموز_الدخول := 1; };
    دع عدد_رموز_أقسام_دوارف: غير_موقع = الطول(أقسام_دوارف) مثل غير_موقع;
    دع أول_رمز_عام: غير_موقع = 3 + عدد_رموز_أقسام_دوارف;
    دع عدد_الرموز: غير_موقع = عدد_رموز_الكائن + أول_رمز_عام + عدد_رموز_الدخول; دع حجم_الرموز: غير_موقع = عدد_الرموز * 24;
    دع إزاحة_النصوص: غير_موقع = إزاحة_الرموز + حجم_الرموز; دع حجم_النصوص: غير_موقع = الطول(جدول_النصوص) مثل غير_موقع;

    دع إزاحات_أقسام_دوارف: متغير متجه غير_موقع = []; دع موضع: متغير غير_موقع = إزاحة_النصوص + حجم_النصوص;
    ف := 0; بينما (ف < (الطول(أقسام_دوارف) مثل غير_موقع)) { موضع := حاذ_إلف(موضع, محاذاة_قسم_دوارف_إلف(أقسام_دوارف[ف])); ألحق(إزاحات_أقسام_دوارف, موضع); موضع := موضع + حجم_قسم_دوارف_إلف(&(*الكائن).دوارف, أقسام_دوارف[ف]); ف := ف + 1; }
    دع إزاحات_أقسام_إزاحات_دوارف: متغير متجه غير_موقع = [];
    ف := 0; بينما (ف < (الطول(أنواع_إزاحات_دوارف) مثل غير_موقع)) { موضع := حاذ_إلف(موضع, 8); ألحق(إزاحات_أقسام_إزاحات_دوارف, موضع); موضع := موضع + عدد_إزاحات_دوارف_إلف(&(*الكائن).دوارف, أنواع_إزاحات_دوارف[ف]) * 24; ف := ف + 1; }
    دع إزاحة_أسماء_الأقسام: غير_موقع = موضع; دع حجم_أسماء_الأقسام: غير_موقع = الطول(جدول_أسماء_الأقسام) مثل غير_موقع;
    دع إزاحة_رؤوس_الأقسام: غير_موقع = حاذ_إلف(إزاحة_أسماء_الأقسام + حجم_أسماء_الأقسام, 8);
    دع فهرس_جدول_أسماء_الأقسام: غير_موقع = 6 + (الطول(أقسام_دوارف) مثل غير_موقع) + (الطول(أنواع_إزاحات_دوارف) مثل غير_موقع);
    دع عدد_الأقسام: غير_موقع = فهرس_جدول_أسماء_الأقسام + 1;

    دع البايتات: متغير متجه غ8 = [];
    ألحق_غ8_إلف(&متغير البايتات, 0x7F); ألحق_غ8_إلف(&متغير البايتات, 0x45); ألحق_غ8_إلف(&متغير البايتات, 0x4C); ألحق_غ8_إلف(&متغير البايتات, 0x46);
    ألحق_غ8_إلف(&متغير البايتات, 2); ألحق_غ8_إلف(&متغير البايتات, 1); ألحق_غ8_إلف(&متغير البايتات, 1); ألحق_غ8_إلف(&متغير البايتات, 0); ألحق_أصفارا_إلف(&متغير البايتات, 8);
    ألحق_غ16_إلف(&متغير البايتات, 1); ألحق_غ16_إلف(&متغير البايتات, 62); ألحق_غ32_إلف(&متغير البايتات, 1); ألحق_غ64_إلف(&متغير البايتات, 0); ألحق_غ64_إلف(&متغير البايتات, 0); ألحق_غ64_إلف(&متغير البايتات, إزاحة_رؤوس_الأقسام);
    ألحق_غ32_إلف(&متغير البايتات, 0); ألحق_غ16_إلف(&متغير البايتات, 64); ألحق_غ16_إلف(&متغير البايتات, 0); ألحق_غ16_إلف(&متغير البايتات, 0); ألحق_غ16_إلف(&متغير البايتات, 64); ألحق_غ16_إلف(&متغير البايتات, عدد_الأقسام); ألحق_غ16_إلف(&متغير البايتات, فهرس_جدول_أسماء_الأقسام);

    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_النص)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); }; ألحق_بايتات_إلف(&متغير البايتات, &(*الكائن).النص);
    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_البيانات)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); }; ألحق_بايتات_إلف(&متغير البايتات, &(*الكائن).البيانات);
    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_الإزاحات)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };
    دع ر: متغير غير_موقع = 0;
    بينما (ر < عدد_الإزاحات) {
        دع الإزاحة: إزاحة_إلف = (*الكائن).الإزاحات[ر];
        طابق ابحث_رمز_إلف(&(*الكائن).الرموز, &الإزاحة.الرمز) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.رمز_إزاحة_مفقود()); }
        | اختيار.بعض(فهرس_الرمز) -> {
            دع فهرس_إلف: غير_موقع = فهرس_الرمز + أول_رمز_عام; دع نوع_إلف: متغير غير_موقع = 4;
            طابق الإزاحة.النوع مع | نوع_إزاحة_إلف.نداء_نسبي_اثنان_وثلاثون -> { نوع_إلف := 4; } | نوع_إزاحة_إلف.عنوان_نسبي_اثنان_وثلاثون -> { نوع_إلف := 2; };
            ألحق_غ64_إلف(&متغير البايتات, الإزاحة.إزاحة_بايت); ألحق_غ64_إلف(&متغير البايتات, فهرس_إلف * 4294967296 + نوع_إلف); ألحق_غ32_إلف(&متغير البايتات, 0xFFFFFFFC); ألحق_غ32_إلف(&متغير البايتات, 0xFFFFFFFF);
        }; ر := ر + 1;
    }

    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_الرموز)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };
    ألحق_أصفارا_إلف(&متغير البايتات, 24); ألحق_رمز_إلف64(&متغير البايتات, 0, 3, 1, 0, 0); ألحق_رمز_إلف64(&متغير البايتات, 0, 3, 2, 0, 0);
    ف := 0;
    بينما (ف < عدد_رموز_أقسام_دوارف) { ألحق_رمز_إلف64(&متغير البايتات, 0, 3, 6 + ف, 0, 0); ف := ف + 1; }
    دع س: متغير غير_موقع = 0;
    بينما (س < عدد_رموز_الكائن) {
        دع مرجع_الرمز: &رمز_إلف = &(*الكائن).الرموز[س];
        دع موضع_الرمز: موضع_رمز_إلف = (*مرجع_الرمز).الموضع;
        دع القسم: متغير غير_موقع = 0; دع القيمة: متغير غير_موقع = 0; دع الحجم: متغير غير_موقع = 0; دع المعلومات: متغير غير_موقع = 0x12;
        طابق موضع_الرمز مع
        | موضع_رمز_إلف.معرف_في_النص(الإزاحة, حجم_الرمز) -> { القسم := 1; القيمة := الإزاحة; الحجم := حجم_الرمز; المعلومات := 0x12; }
        | موضع_رمز_إلف.معرف_في_البيانات(الإزاحة, حجم_الرمز) -> { القسم := 2; القيمة := الإزاحة; الحجم := حجم_الرمز; المعلومات := 0x11; }
        | موضع_رمز_إلف.غير_معرف -> { };
        ألحق_رمز_إلف64(&متغير البايتات, إزاحات_الأسماء[س], المعلومات, القسم, القيمة, الحجم); س := س + 1;
    }
    طابق (*الكائن).دخول_العملية مع | اختيار.لا_شيء -> { } | اختيار.بعض(الدخول) -> { ألحق_رمز_إلف64(&متغير البايتات, إزاحة_اسم_دخول_العملية, 0x12, 1, الدخول.إزاحة_بايت, الدخول.حجم_بايت); };
    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_النصوص)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); }; ألحق_بايتات_إلف(&متغير البايتات, &جدول_النصوص);

    ف := 0; بينما (ف < (الطول(أقسام_دوارف) مثل غير_موقع)) { لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحات_أقسام_دوارف[ف])) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); }; ألحق_قسم_دوارف_إلف(&متغير البايتات, &(*الكائن).دوارف, أقسام_دوارف[ف]); ف := ف + 1; }
    ف := 0; بينما (ف < (الطول(أنواع_إزاحات_دوارف) مثل غير_موقع)) { لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحات_أقسام_إزاحات_دوارف[ف]) || !ألحق_إزاحات_دوارف_إلف(&متغير البايتات, &(*الكائن).دوارف, أنواع_إزاحات_دوارف[ف], &أقسام_دوارف)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); }; ف := ف + 1; }
    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_أسماء_الأقسام)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); }; ألحق_بايتات_إلف(&متغير البايتات, &جدول_أسماء_الأقسام);
    لو (!أكمل_إلف_إلى(&متغير البايتات, إزاحة_رؤوس_الأقسام)) { أرجع نتيجة_تسلسل_إلف.خطأ(خطأ_إلف.حدود_صيغة_متجاوزة()); };

    ألحق_أصفارا_إلف(&متغير البايتات, 64);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_النص, 1, 6, إزاحة_النص, حجم_النص, 0, 0, 16, 0);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_البيانات, 1, 3, إزاحة_البيانات, حجم_البيانات, 0, 0, محاذاة_البيانات, 0);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_إزاحات_النص, 4, 0, إزاحة_الإزاحات, حجم_الإزاحات, 4, 1, 8, 24);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_الرموز, 2, 0, إزاحة_الرموز, حجم_الرموز, 5, أول_رمز_عام, 8, 24);
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_النصوص, 3, 0, إزاحة_النصوص, حجم_النصوص, 0, 0, 1, 0);
    ف := 0; بينما (ف < (الطول(أقسام_دوارف) مثل غير_موقع)) { ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحات_أسماء_دوارف[ف], 1, 0, إزاحات_أقسام_دوارف[ف], حجم_قسم_دوارف_إلف(&(*الكائن).دوارف, أقسام_دوارف[ف]), 0, 0, محاذاة_قسم_دوارف_إلف(أقسام_دوارف[ف]), 0); ف := ف + 1; }
    ف := 0; بينما (ف < (الطول(أنواع_إزاحات_دوارف) مثل غير_موقع)) { ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحات_أسماء_إزاحات_دوارف[ف], 4, 0, إزاحات_أقسام_إزاحات_دوارف[ف], عدد_إزاحات_دوارف_إلف(&(*الكائن).دوارف, أنواع_إزاحات_دوارف[ف]) * 24, 4, فهارس_هدف_إزاحات_دوارف[ف], 8, 24); ف := ف + 1; }
    ألحق_رأس_قسم_إلف64(&متغير البايتات, إزاحة_اسم_جدول_الأقسام, 3, 0, إزاحة_أسماء_الأقسام, حجم_أسماء_الأقسام, 0, 0, 1, 0);
    أرجع نتيجة_تسلسل_إلف.نجح(البايتات);
}

عام عرف اكتب_إلف_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_CFI,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_تسلسل_إلف {
    طابق ابن_كائن_إلف_إكس_ستة_وثمانون_أربعة_وستون(الشفرة, الهدف, دالة_الدخول, الرموز_الخارجية, خريطة_المصادر, أصول_المصدر, التصحيح, تصحيح_الآلة, سياق_الفك, الأنواع, سجل_التخطيط) مع
    | نتيجة_بناء_إلف.خطأ(الخطأ) -> {
        أرجع نتيجة_تسلسل_إلف.خطأ(الخطأ);
    }
    | نتيجة_بناء_إلف.نجح(الكائن) -> {
        أرجع اكتب_كائن_إلف64(&الكائن);
    };
}

// ===== canonical Linux ELF executable-finalization boundary =====
// The current x86_64 object writer emits ET_REL. This owner validates and consumes
// that format and reports only genuine upstream contracts that prevent ET_EXEC.
عام نوع خطأ_إنهاء_تنفيذي_إلف =
    | كائن_إلف_تنفيذي_غير_صالح
    | رمز_دخول_إلف_مفقود
    | بدائي_تشغيل_إلف_غير_مخفض
    | رمز_خارجي_إلف_غير_معروف
;

عام نوع نتيجة_إنهاء_تنفيذي_إلف =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_إنهاء_تنفيذي_إلف
;

عرف ضمن_حدود_إلف(البايتات: &متجه غ8, الموضع: غير_موقع, الحجم: غير_موقع): منطقي {
    دع الكل: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > الكل) { أرجع خطأ; };
    أرجع الحجم <= (الكل - الموضع);
}

عرف اقرأ_غ16_إلف(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع الموضع1: غير_موقع = الموضع + 1;
    دع الأدنى: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع الأعلى: غير_موقع = (*البايتات)[الموضع1] مثل غير_موقع;
    دع الأعلى_مزاحا: غير_موقع = الأعلى * 256;
    أرجع الأدنى + الأعلى_مزاحا;
}

عرف اقرأ_غ32_إلف(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع الموضع1: غير_موقع = الموضع + 1;
    دع الموضع2: غير_موقع = الموضع + 2;
    دع الموضع3: غير_موقع = الموضع + 3;
    دع ب0: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع ب1: غير_موقع = (*البايتات)[الموضع1] مثل غير_موقع;
    دع ب2: غير_موقع = (*البايتات)[الموضع2] مثل غير_موقع;
    دع ب3: غير_موقع = (*البايتات)[الموضع3] مثل غير_موقع;
    دع ج1: غير_موقع = ب1 * 256;
    دع ج2: غير_موقع = ب2 * 65536;
    دع ج3: غير_موقع = ب3 * 16777216;
    دع ج01: غير_موقع = ب0 + ج1;
    دع ج012: غير_موقع = ج01 + ج2;
    أرجع ج012 + ج3;
}

عرف اقرأ_غ64_إلف(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع الأدنى: غير_موقع = اقرأ_غ32_إلف(البايتات, الموضع);
    دع موضع_الأعلى: غير_موقع = الموضع + 4;
    دع الأعلى: غير_موقع = اقرأ_غ32_إلف(البايتات, موضع_الأعلى);
    دع الأعلى_مزاحا: غير_موقع = الأعلى * 4294967296;
    أرجع الأدنى + الأعلى_مزاحا;
}

عرف اقرأ_اسم_صفري_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار متجه غ8 {
    دع الكل: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع >= النهاية || النهاية > الكل) { أرجع اختيار.لا_شيء(); };
    دع الاسم: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = الموضع;
    بينما (ف < النهاية) {
        لو ((*البايتات)[ف] == 0) { أرجع اختيار.بعض(الاسم); };
        ألحق(الاسم, (*البايتات)[ف]);
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اسما_إلف_متساويان(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    دع طول_س: غير_موقع = الطول(*أ) مثل غير_موقع;
    دع طول_ص: غير_موقع = الطول(*ب) مثل غير_موقع;
    لو (طول_س != طول_ص) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < طول_س) {
        لو ((*أ)[ف] != (*ب)[ف]) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اكتب_غ32_إلف_في(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    دع الكل: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع النهاية: غير_موقع = الموضع + 4;
    لو (النهاية > الكل) {
        أرجع خطأ;
    };
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        دع موضع_البايت: غير_موقع = الموضع + ف;
        دع باقي_البايت: غير_موقع = الباقي % 256;
        دع قيمة_البايت: غ8 = باقي_البايت مثل غ8;
        (*البايتات)[موضع_البايت] := قيمة_البايت;
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اكتب_غ16_إلف_في(البايتات: &متغير متجه غ8, الموضع: غير_موقع, القيمة: غير_موقع): منطقي {
    لو (الموضع + 2 > (الطول(*البايتات) مثل غير_موقع)) { أرجع خطأ; };
    (*البايتات)[الموضع] := (القيمة % 256) مثل غ8;
    دع الموضع_الثاني: غير_موقع = الموضع + 1;
    دع الجزء_العالي: غير_موقع = القيمة / 256;
    دع البايت_العالي: غير_موقع = الجزء_العالي % 256;
    (*البايتات)[الموضع_الثاني] := البايت_العالي مثل غ8;
    أرجع صواب;
}

عرف اكتب_غ64_إلف_في(البايتات: &متغير متجه غ8, الموضع: غير_موقع, القيمة: غير_موقع): منطقي {
    لو (الموضع + 8 > (الطول(*البايتات) مثل غير_موقع)) { أرجع خطأ; };
    دع ح: متغير غير_موقع = القيمة; دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        دع موضع_البايت: غير_موقع = الموضع + ف;
        (*البايتات)[موضع_البايت] := (ح % 256) مثل غ8;
        ح := ح / 256;
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ألحق_رأس_برنامج_إلف64_خام(
    البايتات: &متغير متجه غ8,
    النوع: غير_موقع,
    الأعلام: غير_موقع,
    إزاحة_الملف: غير_موقع,
