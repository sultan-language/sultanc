استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.target.target_model;
استورد compiler.backend.object.object_reference_model;
استورد compiler.backend.object.dwarf.dwarf_model;

// حقائق ELF مستقلة عن Mach-O وعن تمثيل ISA. الكاتب يحول encoded x86 إلى هذه الحقائق ثم يسلسلها.
عام نوع موضع_رمز_إلف =
    | معرف_في_النص بنوع (غير_موقع, غير_موقع)
    | معرف_في_البيانات بنوع (غير_موقع, غير_موقع)
    | غير_معرف
;

عام نوع رمز_إلف = {
    المرجع: مرجع_رمز_كائن,
    الاسم: متجه غ8,
    الموضع: موضع_رمز_إلف
};

عام نوع نوع_إزاحة_إلف =
    | نداء_نسبي_اثنان_وثلاثون
    | عنوان_نسبي_اثنان_وثلاثون
;

عام نوع إزاحة_إلف = {
    إزاحة_بايت: غير_موقع,
    النوع: نوع_إزاحة_إلف,
    الرمز: مرجع_رمز_كائن,
    الإضافة: عدد
};

// موضع دخول العملية داخل .text. المعمارية/طبقة النظام تنتج البايتات؛
// Object يحمل الموضع فقط عبر ET_REL ثم يحوله إلى e_entry عند الإنهاء.
عام نوع موضع_دخول_عملية_إلف = {
    إزاحة_بايت: غير_موقع,
    حجم_بايت: غير_موقع
};

عام نوع كائن_إلف = {
    الهدف: معرف_هدف,
    النص: متجه غ8,
    البيانات: متجه غ8,
    محاذاة_البيانات: غير_موقع,
    الرموز: متجه رمز_إلف,
    الإزاحات: متجه إزاحة_إلف,
    دخول_العملية: اختيار موضع_دخول_عملية_إلف,
    دوارف: حزمة_دوارف
};
