استورد compiler.frontend.types.type_context;
استورد compiler.backend.layout.layout_model;

عام نوع ناتج_كائن_أصلي_مفصل = {
    البايتات: متجه غ8
};

عام نوع نتيجة_إصدار_كائن_ذراع =
    | نجح بنوع ناتج_كائن_أصلي_مفصل
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | خطأ_ماتشو بنوع خطأ_ماتشو
;

عام نوع نتيجة_إصدار_كائن_إكس =
    | نجح بنوع ناتج_كائن_أصلي_مفصل
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | فشل_إلف بنوع خطأ_إلف
;

// حد object المشترك يحول ما تعرضه المعمارية من مراجع رمزية إلى مرفقات
// مستقلة عن صيغة الكائن. Mach-O/ELF وحدهما يقرران ترميز section/relocation.
عام عرف اصدر_كائن_ذراع_أربعة_وستون(
    الشفرة: شفرة_ذراع_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_إصدار_كائن_ذراع {
    دع الشفرة_المشفرة: متغير شفرة_ذراع_أربعة_وستون_مشفرة = الشفرة;
    دع واصف_الهدف: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(الشفرة_المشفرة.الهدف, واصف_الهدف.المعرف)) {
        أرجع نتيجة_إصدار_كائن_ذراع.هدف_غير_متطابق(الشفرة_المشفرة.الهدف);
    };

    // Object emission consumes encoded ARM64 code. Add architecture fixups directly
    // to its canonical attachment set instead of cloning the whole encoded program.
    دع عدد_الدوال: غير_موقع = الطول(الشفرة_المشفرة.الدوال) مثل غير_موقع;
    دع فهرس_الدالة: متغير غير_موقع = 0;
    بينما (فهرس_الدالة < عدد_الدوال) {
        دع عدد_التثبيتات: غير_موقع = الطول(الشفرة_المشفرة.الدوال[فهرس_الدالة].التثبيتات) مثل غير_موقع;
        دع فهرس_التثبيت: متغير غير_موقع = 0;
        بينما (فهرس_التثبيت < عدد_التثبيتات) {
            دع التثبيت: تثبيت_ذراع_أربعة_وستون = الشفرة_المشفرة.الدوال[فهرس_الدالة].التثبيتات[فهرس_التثبيت];
            دع نوع_الإزاحة: نوع_إزاحة_رمزية_كائن;
            طابق التثبيت.النوع مع
            | نوع_تثبيت_ذراع_أربعة_وستون.فرع_برابط_ستة_وعشرون_بت -> {
                نوع_الإزاحة := نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت();
            };
            دع الموضع: موضع_إزاحة_نص_كائن = {
                الدالة: الشفرة_المشفرة.الدوال[فهرس_الدالة].المعرف,
                إزاحة_بايت: التثبيت.إزاحة_بايت
            };
            دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(التثبيت.الدالة);
            دع الطلب: طلب_إزاحة_نص_كائن = {
                الموضع: الموضع,
                النوع: نوع_الإزاحة,
                الرمز: الرمز,
                الإضافة: التثبيت.الإضافة
            };
            ألحق(الشفرة_المشفرة.المرفقات.إزاحات_النص, الطلب);
            فهرس_التثبيت := فهرس_التثبيت + 1;
        }
        فهرس_الدالة := فهرس_الدالة + 1;
    }

    طابق واصف_الهدف.صيغة_الكائن مع
    | صيغة_كائن_هدف.ماتشو -> {
        طابق ابن_كائن_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(
            &الشفرة_المشفرة,
            &الشفرة_المشفرة.المرفقات,
            الهدف,
            دالة_الدخول,
            الرموز_الخارجية,
            خريطة_المصادر,
            أصول_المصدر,
            التصحيح,
            تصحيح_الآلة,
            سياق_الفك,
            الأنواع,
            سجل_التخطيط
        ) مع
        | نتيجة_بناء_ماتشو.خطأ(الخطأ) -> { أرجع نتيجة_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ); }
        | نتيجة_بناء_ماتشو.نجح(الكائن) -> {
            طابق سلسل_كائن_ماتشو_ذراع_أربعة_وستون(&الكائن, الهدف) مع
            | نتيجة_تسلسل_ماتشو.خطأ(الخطأ) -> { أرجع نتيجة_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ); }
            | نتيجة_تسلسل_ماتشو.نجح(البايتات) -> {
                دع الناتج: ناتج_كائن_أصلي_مفصل = { البايتات: البايتات };
                أرجع نتيجة_إصدار_كائن_ذراع.نجح(الناتج);
            };
        };
    }
    | _ -> {
        أرجع نتيجة_إصدار_كائن_ذراع.قدرة_مخرج_غير_متاحة(واصف_الهدف.المعرف);
    };
}

// إصدار ELF لـ x86_64 يبقى خلف قرار Target. المسار الحالي لا يغير نموذج ELF المقبول.
عام عرف اصدر_كائن_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_إصدار_كائن_إكس {
    دع الشفرة_المشفرة: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = *الشفرة;
    دع واصف_الهدف: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(الشفرة_المشفرة.الهدف, واصف_الهدف.المعرف)) {
        أرجع نتيجة_إصدار_كائن_إكس.هدف_غير_متطابق(الشفرة_المشفرة.الهدف);
    };
    طابق واصف_الهدف.صيغة_الكائن مع
    | صيغة_كائن_هدف.إلف -> {
        طابق ابن_كائن_إلف_إكس_ستة_وثمانون_أربعة_وستون(
            الشفرة,
            الهدف,
            دالة_الدخول,
            الرموز_الخارجية,
            خريطة_المصادر,
            أصول_المصدر,
            التصحيح,
            تصحيح_الآلة,
            سياق_الفك,
            الأنواع,
            سجل_التخطيط
        ) مع
        | نتيجة_بناء_إلف.خطأ(الخطأ) -> { أرجع نتيجة_إصدار_كائن_إكس.فشل_إلف(الخطأ); }
        | نتيجة_بناء_إلف.نجح(الكائن) -> {
            طابق اكتب_كائن_إلف64(&الكائن) مع
            | نتيجة_تسلسل_إلف.خطأ(الخطأ) -> { أرجع نتيجة_إصدار_كائن_إكس.فشل_إلف(الخطأ); }
            | نتيجة_تسلسل_إلف.نجح(البايتات) -> {
                دع الناتج: ناتج_كائن_أصلي_مفصل = { البايتات: البايتات };
                أرجع نتيجة_إصدار_كائن_إكس.نجح(الناتج);
            };
        };
    }
    | _ -> { أرجع نتيجة_إصدار_كائن_إكس.قدرة_مخرج_غير_متاحة(واصف_الهدف.المعرف); };
}
