عام نوع ناتج_كائن_أصلي_مفصل = {
    البايتات: متجه غ8,
    دوارف: حزمة_دوارف
};

عام نوع نتيجة_إصدار_كائن_ذراع =
    | نجح بنوع ناتج_كائن_أصلي_مفصل
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | خطأ_ماتشو بنوع خطأ_ماتشو
;

عام نوع نتيجة_إصدار_كائن_إكس =
    | نجح بنوع ناتج_كائن_أصلي_مفصل
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | فشل_إلف بنوع خطأ_إلف
;

// حدود Object/Target المقننة لمرحلة ما بعد بايتات الكائن. لا تستدعي cc/ld؛
// تحمل فقط هوية مزود الإنهاء التي حسمها Target مرة واحدة.
عام نوع طلب_إنهاء_تنفيذي_أصلي = {
    الهدف: معرف_هدف,
    المزود: هوية_مزود_إنهاء_تنفيذي_هدف,
    بايتات_الكائن: متجه غ8,
    دوارف: حزمة_دوارف,
    الرموز_الخارجية_المعلنة: متجه متجه غ8
};

عام عرف جهز_طلب_إنهاء_تنفيذي_أصلي(
    البايتات: متجه غ8,
    دوارف: حزمة_دوارف,
    الهدف: &واصف_هدف,
    الرموز_الخارجية_المعلنة: متجه متجه غ8
): طلب_إنهاء_تنفيذي_أصلي {
    دع و: واصف_هدف = *الهدف;
    دع مزود: هوية_مزود_إنهاء_تنفيذي_هدف = مزود_إنهاء_تنفيذي_الهدف(الهدف);
    دع الطلب: طلب_إنهاء_تنفيذي_أصلي = {
        الهدف: و.المعرف,
        المزود: مزود,
        بايتات_الكائن: البايتات,
        دوارف: دوارف,
        الرموز_الخارجية_المعلنة: الرموز_الخارجية_المعلنة
    };
    أرجع الطلب;
}

// حد object المشترك يحول ما تعرضه المعمارية من مراجع رمزية إلى مرفقات
// مستقلة عن صيغة الكائن. Mach-O/ELF وحدهما يقرران ترميز section/relocation.
عام عرف اصدر_كائن_ذراع_أربعة_وستون(
    الشفرة: شفرة_ذراع_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_CFI,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_إصدار_كائن_ذراع {
    دع ش: متغير شفرة_ذراع_أربعة_وستون_مشفرة = الشفرة;
    دع و: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(ش.الهدف, و.المعرف)) {
        أرجع نتيجة_إصدار_كائن_ذراع.هدف_غير_متطابق(ش.الهدف);
    };

    // Object emission consumes encoded ARM64 code. Add architecture fixups directly
    // to its canonical attachment set instead of cloning the whole encoded program.
    دع عدد_الدوال: غير_موقع = الطول(ش.الدوال) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الدوال) {
        دع عدد_التثبيتات: غير_موقع = الطول(ش.الدوال[ف].التثبيتات) مثل غير_موقع;
        دع ت: متغير غير_موقع = 0;
        بينما (ت < عدد_التثبيتات) {
            دع التثبيت: تثبيت_ذراع_أربعة_وستون = ش.الدوال[ف].التثبيتات[ت];
            دع نوع_الإزاحة: نوع_إزاحة_رمزية_كائن;
            طابق التثبيت.النوع مع
            | نوع_تثبيت_ذراع_أربعة_وستون.فرع_برابط_ستة_وعشرون_بت -> {
                نوع_الإزاحة := نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت();
            };
            دع الموضع: موضع_إزاحة_نص_كائن = {
                الدالة: ش.الدوال[ف].المعرف,
                إزاحة_بايت: التثبيت.إزاحة_بايت
            };
            دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(التثبيت.الدالة);
            دع الطلب: طلب_إزاحة_نص_كائن = {
                الموضع: الموضع,
                النوع: نوع_الإزاحة,
                الرمز: الرمز,
                الإضافة: التثبيت.الإضافة
            };
            ألحق(ش.المرفقات.إزاحات_النص, الطلب);
            ت := ت + 1;
        }
        ف := ف + 1;
    }

    طابق و.صيغة_الكائن مع
    | صيغة_كائن_هدف.ماتشو -> {
        طابق ابن_كائن_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(&ش, &ش.المرفقات, الهدف, دالة_الدخول, الرموز_الخارجية, خريطة_المصادر, أصول_المصدر, التصحيح, تصحيح_الآلة, سياق_الفك, الأنواع, سجل_التخطيط) مع
        | نتيجة_بناء_ماتشو.خطأ(الخطأ) -> { أرجع نتيجة_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ); }
        | نتيجة_بناء_ماتشو.نجح(الكائن) -> {
            طابق سلسل_كائن_ماتشو_ذراع_أربعة_وستون(&الكائن, الهدف) مع
            | نتيجة_تسلسل_ماتشو.خطأ(الخطأ) -> { أرجع نتيجة_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ); }
            | نتيجة_تسلسل_ماتشو.نجح(البايتات) -> {
                دع مرجع_دوارف: &حزمة_دوارف = &الكائن.دوارف;
                دع دوارف: حزمة_دوارف = *مرجع_دوارف;
                دع الناتج: ناتج_كائن_أصلي_مفصل = { البايتات: البايتات, دوارف: دوارف };
                أرجع نتيجة_إصدار_كائن_ذراع.نجح(الناتج);
            };
        };
    }
    | صيغة_كائن_هدف.إلف -> {
        أرجع نتيجة_إصدار_كائن_ذراع.قدرة_مخرج_غير_متاحة(و.المعرف);
    };
}

// إصدار ELF لـ x86_64 يبقى خلف قرار Target. المسار الحالي لا يغير نموذج ELF المقبول.
عام عرف اصدر_كائن_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_CFI,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_إصدار_كائن_إكس {
    دع ش: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = *الشفرة;
    دع و: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(ش.الهدف, و.المعرف)) {
        أرجع نتيجة_إصدار_كائن_إكس.هدف_غير_متطابق(ش.الهدف);
    };
    طابق و.صيغة_الكائن مع
    | صيغة_كائن_هدف.إلف -> {
        طابق ابن_كائن_إلف_إكس_ستة_وثمانون_أربعة_وستون(الشفرة, الهدف, دالة_الدخول, الرموز_الخارجية, خريطة_المصادر, أصول_المصدر, التصحيح, تصحيح_الآلة, سياق_الفك, الأنواع, سجل_التخطيط) مع
        | نتيجة_بناء_إلف.خطأ(الخطأ) -> { أرجع نتيجة_إصدار_كائن_إكس.فشل_إلف(الخطأ); }
        | نتيجة_بناء_إلف.نجح(الكائن) -> {
            طابق اكتب_كائن_إلف64(&الكائن) مع
            | نتيجة_تسلسل_إلف.خطأ(الخطأ) -> { أرجع نتيجة_إصدار_كائن_إكس.فشل_إلف(الخطأ); }
            | نتيجة_تسلسل_إلف.نجح(البايتات) -> {
                دع مرجع_دوارف: &حزمة_دوارف = &الكائن.دوارف;
                دع دوارف: حزمة_دوارف = *مرجع_دوارف;
                دع الناتج: ناتج_كائن_أصلي_مفصل = { البايتات: البايتات, دوارف: دوارف };
                أرجع نتيجة_إصدار_كائن_إكس.نجح(الناتج);
            };
        };
    }
    | صيغة_كائن_هدف.ماتشو -> { أرجع نتيجة_إصدار_كائن_إكس.قدرة_مخرج_غير_متاحة(و.المعرف); };
}


// Canonical request consumer. Driver/native_output constructs the request once,
// then this boundary resolves only TargetID and dispatches to the provider selected
// by that registered Target. It returns executable bytes or a terminal failure.
عام نوع خطأ_إنهاء_تنفيذي_أصلي =
    | هدف_إنهاء_غير_مسجل بنوع معرف_هدف
    | مزود_إنهاء_غير_متطابق بنوع معرف_هدف
    | ماتشو_كائن_تنفيذي_غير_صالح
    | ماتشو_رمز_دخول_مفقود
    | ماتشو_رمز_خارجي_غير_مدعوم
    | ماتشو_إزاحة_غير_مدعومة
    | ماتشو_إزاحة_خارج_النطاق
    | ماتشو_توقيع_فشل
    | إلف_كائن_تنفيذي_غير_صالح
    | إلف_رمز_دخول_مفقود
    | إلف_بدائي_تشغيل_غير_مخفض
    | إلف_رمز_خارجي_غير_معروف
;

عام نوع نتيجة_إنهاء_تنفيذي_أصلي =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_إنهاء_تنفيذي_أصلي
;

عام عرف نفذ_إنهاء_تنفيذي_أصلي(
    الطلب: &متغير طلب_إنهاء_تنفيذي_أصلي
): نتيجة_إنهاء_تنفيذي_أصلي {
    دع ط: متغير طلب_إنهاء_تنفيذي_أصلي = *الطلب;
    دع الهدف: واصف_هدف;
    طابق حل_بمعرف_هدف(ط.الهدف) مع
    | نتيجة_حل_هدف.غير_مسجل -> {
        أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(
            خطأ_إنهاء_تنفيذي_أصلي.هدف_إنهاء_غير_مسجل(ط.الهدف)
        );
    }
    | نتيجة_حل_هدف.محلول(وصف) -> { الهدف := وصف; };

    لو (مزود_إنهاء_تنفيذي_الهدف(&الهدف) != ط.المزود) {
        أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(
            خطأ_إنهاء_تنفيذي_أصلي.مزود_إنهاء_غير_متطابق(ط.الهدف)
        );
    };

    طابق ط.المزود مع
    | هوية_مزود_إنهاء_تنفيذي_هدف.ماتشو_داروين -> {
        طابق أنه_كائن_ماتشو_داروين_إلى_تنفيذي(
            &ط.بايتات_الكائن, &متغير ط.دوارف, &الهدف, &ط.الرموز_الخارجية_المعلنة
        ) مع
        | نتيجة_إنهاء_تنفيذي_ماتشو.نجح(البايتات) -> {
            أرجع نتيجة_إنهاء_تنفيذي_أصلي.نجح(البايتات);
        }
        | نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.ماتشو_كائن_تنفيذي_غير_صالح()); }
            | خطأ_إنهاء_تنفيذي_ماتشو.رمز_دخول_تنفيذي_ماتشو_مفقود -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.ماتشو_رمز_دخول_مفقود()); }
            | خطأ_إنهاء_تنفيذي_ماتشو.رمز_خارجي_تنفيذي_ماتشو_غير_مدعوم -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.ماتشو_رمز_خارجي_غير_مدعوم()); }
            | خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_غير_مدعومة -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.ماتشو_إزاحة_غير_مدعومة()); }
            | خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_خارج_النطاق -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.ماتشو_إزاحة_خارج_النطاق()); }
            | خطأ_إنهاء_تنفيذي_ماتشو.توقيع_تنفيذي_ماتشو_فشل -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.ماتشو_توقيع_فشل()); };
        };
    }
    | هوية_مزود_إنهاء_تنفيذي_هدف.إلف_لينكس -> {
        طابق أنه_كائن_إلف_لينكس_إلى_تنفيذي(
            &ط.بايتات_الكائن, &متغير ط.دوارف, &الهدف, &ط.الرموز_الخارجية_المعلنة
        ) مع
        | نتيجة_إنهاء_تنفيذي_إلف.نجح(البايتات) -> {
            أرجع نتيجة_إنهاء_تنفيذي_أصلي.نجح(البايتات);
        }
        | نتيجة_إنهاء_تنفيذي_إلف.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_إنهاء_تنفيذي_إلف.كائن_إلف_تنفيذي_غير_صالح -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.إلف_كائن_تنفيذي_غير_صالح()); }
            | خطأ_إنهاء_تنفيذي_إلف.رمز_دخول_إلف_مفقود -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.إلف_رمز_دخول_مفقود()); }
            | خطأ_إنهاء_تنفيذي_إلف.بدائي_تشغيل_إلف_غير_مخفض -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.إلف_بدائي_تشغيل_غير_مخفض()); }
            | خطأ_إنهاء_تنفيذي_إلف.رمز_خارجي_إلف_غير_معروف -> { أرجع نتيجة_إنهاء_تنفيذي_أصلي.خطأ(خطأ_إنهاء_تنفيذي_أصلي.إلف_رمز_خارجي_غير_معروف()); };
        };
    };
}
