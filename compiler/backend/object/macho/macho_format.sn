    دع اسم_دوارف_مواقع: متجه غ8 = [0x5F,0x5F,0x64,0x65,0x62,0x75,0x67,0x5F,0x6C,0x6F,0x63];
    دع اسم_قوائم_مواقع: متجه غ8 = [0x5F,0x5F,0x64,0x65,0x62,0x75,0x67,0x5F,0x6C,0x6F,0x63,0x6C,0x69,0x73,0x74,0x73];
    دع اسم_دوارف_إطار: متجه غ8 = [0x5F,0x5F,0x64,0x65,0x62,0x75,0x67,0x5F,0x66,0x72,0x61,0x6D,0x65];
    دع اسم_دوارف_نطاقات: متجه غ8 = [0x5F,0x5F,0x64,0x65,0x62,0x75,0x67,0x5F,0x61,0x72,0x61,0x6E,0x67,0x65,0x73];
    دع اسم_قوائم_نطاقات: متجه غ8 = [0x5F,0x5F,0x64,0x65,0x62,0x75,0x67,0x5F,0x72,0x6E,0x67,0x6C,0x69,0x73,0x74,0x73];
    دع اسم_دوارف_أسماء: متجه غ8 = [0x5F,0x5F,0x64,0x65,0x62,0x75,0x67,0x5F,0x70,0x75,0x62,0x6E,0x61,0x6D,0x65,0x73];
    دع اسم_فهرس_أسماء: متجه غ8 = [0x5F,0x5F,0x64,0x65,0x62,0x75,0x67,0x5F,0x6E,0x61,0x6D,0x65,0x73];

    لو ((الطول(حزمة_دوارف_الماتشو.سلاسل_سطور) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
