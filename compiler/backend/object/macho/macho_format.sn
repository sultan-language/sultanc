عام نوع نتيجة_بناء_ماتشو =
    | نجح بنوع كائن_ماتشو
    | خطأ بنوع خطأ_ماتشو
;

عام نوع نتيجة_تسلسل_ماتشو =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_ماتشو
;

عرف ألحق_غ8(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: غير_موقع = القيمة % 256;
    دع البايت: غ8 = الباقي مثل غ8;
    ألحق(*البايتات, البايت);
}

عرف ألحق_غ32_صغير(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        ألحق_غ8(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_غ64_صغير(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        ألحق_غ8(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_أصفارا(البايتات: &متغير متجه غ8, العدد: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق_غ8(البايتات, 0);
        ف := ف + 1;
    }
}

عرف حاذ_لأعلى(القيمة: غير_موقع, المحاذاة: غير_موقع): غير_موقع {
    لو (المحاذاة == 0) { أرجع القيمة; };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + (المحاذاة - الباقي);
}

عرف قوة_اثنين_ماتشو(الأس: غير_موقع): اختيار غير_موقع {
    لو (الأس > 20) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير غير_موقع = 1;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الأس) { الناتج := الناتج * 2; ف := ف + 1; }
    أرجع اختيار.بعض(الناتج);
}

عرف ألحق_اسم_نص(البايتات: &متغير متجه غ8): فراغ {
    ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x74);
    ألحق_غ8(البايتات, 0x65); ألحق_غ8(البايتات, 0x78); ألحق_غ8(البايتات, 0x74);
}

عرف ألحق_اسم_ثوابت(البايتات: &متغير متجه غ8): فراغ {
    ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x63);
    ألحق_غ8(البايتات, 0x6F); ألحق_غ8(البايتات, 0x6E); ألحق_غ8(البايتات, 0x73); ألحق_غ8(البايتات, 0x74);
}

عرف ألحق_اسم_مقطع_نص(البايتات: &متغير متجه غ8): فراغ {
    ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x54);
    ألحق_غ8(البايتات, 0x45); ألحق_غ8(البايتات, 0x58); ألحق_غ8(البايتات, 0x54);
}

عرف اسم_قسم_نص(): متجه غ8 { دع ب: متغير متجه غ8 = []; ألحق_اسم_نص(&متغير ب); أرجع ب; }
عرف اسم_قسم_ثوابت(): متجه غ8 { دع ب: متغير متجه غ8 = []; ألحق_اسم_ثوابت(&متغير ب); أرجع ب; }
عرف اسم_مقطع_نص(): متجه غ8 { دع ب: متغير متجه غ8 = []; ألحق_اسم_مقطع_نص(&متغير ب); أرجع ب; }

عرف بايت_سداسي(القيمة: غير_موقع): غ8 {
    لو (القيمة < 10) { دع الخام: غير_موقع = 0x30 + القيمة; أرجع الخام مثل غ8; };
    دع الخام: غير_موقع = 0x61 + (القيمة - 10);
    أرجع الخام مثل غ8;
}

عرف ألحق_معرف_سداسي_ماتشو(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع القاسم: متغير غير_موقع = 0x1000000000000000;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 16) {
        دع المقسوم: غير_موقع = القيمة / القاسم;
        دع الرقم: غير_موقع = المقسوم % 16;
        دع البايت: غ8 = بايت_سداسي(الرقم);
        ألحق(*البايتات, البايت);
        لو (القاسم > 1) { القاسم := القاسم / 16; };
        ف := ف + 1;
    }
}

عرف اسم_رمز_دالة(المعرف: معرف_دالة_منتقاة): متجه غ8 {
    دع البايتات: متغير متجه غ8 = [0x5F,0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x66,0x6E,0x5F];
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.القيمة);
    أرجع البايتات;
}

عرف اسم_رمز_بيانات(المعرف: معرف_بيانات_ثابتة_كائن): متجه غ8 {
    دع البايتات: متغير متجه غ8 = [0x5F,0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x64,0x61,0x74,0x61,0x5F];
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.الدالة.القيمة);
    ألحق_غ8(&متغير البايتات, 0x5F);
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.القيمة);
    أرجع البايتات;
}

عرف اسم_رمز_عام_ماتشو(المعرف: معرف_عام_مسير): متجه غ8 {
    دع البايتات: متغير متجه غ8 = [0x5F,0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x67,0x6C,0x6F,0x62,0x61,0x6C,0x5F];
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.القيمة);
    أرجع البايتات;
}

عرف اسم_رمز_خارجي_ماتشو(الاسم: &متجه غ8): متجه غ8 {
    // Mach-O C ABI prefixes external C symbol names with an underscore.
    دع الناتج: متغير متجه غ8 = [0x5F];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الاسم) مثل غير_موقع)) {
        ألحق(الناتج, (*الاسم)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اسم_مرجع_رمز_ماتشو(
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه غ8
): اختيار متجه غ8 {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> { أرجع اختيار.بعض(اسم_رمز_دالة(الدالة)); }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> {
        طابق اسم_رمز_خارجي_كائن_من_جدول(المعرف, الرموز_الخارجية) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> { أرجع اختيار.بعض(اسم_رمز_خارجي_ماتشو(&الاسم)); };
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(البيانات) -> { أرجع اختيار.بعض(اسم_رمز_بيانات(البيانات)); }
    | مرجع_رمز_كائن.عام(العام) -> { أرجع اختيار.بعض(اسم_رمز_عام_ماتشو(العام)); }
    | مرجع_رمز_كائن.خدمة_تشغيل(الخدمة) -> { أرجع اسم_رمز_خدمة_تشغيل_للهدف(الهدف, الخدمة); }
    | مرجع_رمز_كائن.مرفق_مضيف(المرفق) -> { أرجع اسم_رمز_مرفق_مضيف_للهدف(الهدف, المرفق); }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> { أرجع اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي); };
}

عرف معرف_دالة_مشفرة_أصغر_أو_يساوي(
    الدوال: &متجه دالة_ذراع_أربعة_وستون_مشفرة,
    أ: غير_موقع,
    ب: غير_موقع
): منطقي {
    أرجع (*الدوال)[أ].المعرف.القيمة <= (*الدوال)[ب].المعرف.القيمة;
}

عرف رتب_مؤشرات_دوال_مشفرة(الدوال: &متجه دالة_ذراع_أربعة_وستون_مشفرة): متجه غير_موقع {
    دع الحالية: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الدوال) مثل غير_موقع)) { ألحق(الحالية, ف); ف := ف + 1; }
    دع العدد: غير_موقع = الطول(الحالية) مثل غير_موقع;
    لو (العدد < 2) { أرجع الحالية; };
    دع العرض: متغير غير_موقع = 1;
    بينما (العرض < العدد) {
        دع التالية: متغير متجه غير_موقع = [];
        دع البداية: متغير غير_موقع = 0;
        بينما (البداية < العدد) {
            دع الوسط: متغير غير_موقع = البداية + العرض;
            لو (الوسط > العدد) { الوسط := العدد; };
            دع النهاية: متغير غير_موقع = الوسط + العرض;
            لو (النهاية > العدد) { النهاية := العدد; };
            دع يسار: متغير غير_موقع = البداية;
            دع يمين: متغير غير_موقع = الوسط;
            بينما ((يسار < الوسط) || (يمين < النهاية)) {
                لو (يمين >= النهاية) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا لو (يسار >= الوسط) {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                } وإلا لو (معرف_دالة_مشفرة_أصغر_أو_يساوي(الدوال, الحالية[يسار], الحالية[يمين])) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                };
            }
            البداية := النهاية;
        }
        الحالية := التالية;
        لو (العرض > (العدد / 2)) { العرض := العدد; } وإلا { العرض := العرض * 2; };
    }
    أرجع الحالية;
}

عرف معرف_بيانات_ثابتة_أصغر_أو_يساوي(
    البيانات: &متجه بيانات_ثابتة_كائن,
    أ: غير_موقع,
    ب: غير_موقع
): منطقي {
    دع معرف_أ: معرف_بيانات_ثابتة_كائن = (*البيانات)[أ].المعرف;
    دع معرف_ب: معرف_بيانات_ثابتة_كائن = (*البيانات)[ب].المعرف;
    لو (معرف_أ.الدالة.القيمة < معرف_ب.الدالة.القيمة) { أرجع صواب; };
    لو (معرف_أ.الدالة.القيمة > معرف_ب.الدالة.القيمة) { أرجع خطأ; };
    أرجع معرف_أ.القيمة <= معرف_ب.القيمة;
}

عرف رتب_مؤشرات_بيانات_ثابتة_ماتشو(البيانات: &متجه بيانات_ثابتة_كائن): متجه غير_موقع {
    دع الحالية: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*البيانات) مثل غير_موقع)) { ألحق(الحالية, ف); ف := ف + 1; }
    دع العدد: غير_موقع = الطول(الحالية) مثل غير_موقع;
    لو (العدد < 2) { أرجع الحالية; };
    دع العرض: متغير غير_موقع = 1;
    بينما (العرض < العدد) {
        دع التالية: متغير متجه غير_موقع = [];
        دع البداية: متغير غير_موقع = 0;
        بينما (البداية < العدد) {
            دع الوسط: متغير غير_موقع = البداية + العرض;
            لو (الوسط > العدد) { الوسط := العدد; };
            دع النهاية: متغير غير_موقع = الوسط + العرض;
            لو (النهاية > العدد) { النهاية := العدد; };
            دع يسار: متغير غير_موقع = البداية;
            دع يمين: متغير غير_موقع = الوسط;
            بينما ((يسار < الوسط) || (يمين < النهاية)) {
                لو (يمين >= النهاية) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا لو (يسار >= الوسط) {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                } وإلا لو (معرف_بيانات_ثابتة_أصغر_أو_يساوي(البيانات, الحالية[يسار], الحالية[يمين])) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                };
            }
            البداية := النهاية;
        }
        الحالية := التالية;
        لو (العرض > (العدد / 2)) { العرض := العدد; } وإلا { العرض := العرض * 2; };
    }
    أرجع الحالية;
}

عرف اسم_ماتشو_أصغر(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    دع طول_س: غير_موقع = الطول(*أ) مثل غير_موقع;
    دع طول_ص: غير_موقع = الطول(*ب) مثل غير_موقع;
    دع الحد: متغير غير_موقع = طول_س;
    لو (طول_ص < الحد) { الحد := طول_ص; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحد) {
        لو ((*أ)[ف] < (*ب)[ف]) { أرجع صواب; };
        لو ((*أ)[ف] > (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع طول_س < طول_ص;
}

عرف ابحث_رمز_ماتشو(الرموز: &متجه رمز_ماتشو, المرجع: &مرجع_رمز_كائن): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرموز) مثل غير_موقع)) {
        دع مرجع_الحالي: &مرجع_رمز_كائن = &(*الرموز)[ف].المرجع;
        لو (مرجعا_رمز_كائن_متساويان(مرجع_الحالي, المرجع)) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف هل_موضع_رمز_ماتشو_معرف(الموضع: موضع_رمز_ماتشو): منطقي {
    طابق الموضع مع
    | موضع_رمز_ماتشو.معرف_في_قسم(_, _) -> { أرجع صواب; }
    | موضع_رمز_ماتشو.غير_معرف -> { أرجع خطأ; };
}

عرف أضف_رمز_ماتشو_إن_غاب(
    الرموز: &متغير متجه رمز_ماتشو,
    المرجع: مرجع_رمز_كائن,
    الموضع: موضع_رمز_ماتشو,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه غ8
): نتيجة منطقي, خطأ_ماتشو {
    طابق ابحث_رمز_ماتشو(الرموز, &المرجع) مع
    | اختيار.بعض(الفهرس) -> {
        دع القديم_معرف: منطقي = هل_موضع_رمز_ماتشو_معرف((*الرموز)[الفهرس].الموضع);
        دع الجديد_معرف: منطقي = هل_موضع_رمز_ماتشو_معرف(الموضع);
        لو (القديم_معرف && الجديد_معرف) {
            أرجع نتيجة.نجح(خطأ);
        };
        لو ((!القديم_معرف) && الجديد_معرف) {
            (*الرموز)[الفهرس].الموضع := الموضع;
        };
        أرجع نتيجة.نجح(صواب);
    }
    | اختيار.لا_شيء -> { };
    طابق اسم_مرجع_رمز_ماتشو(&المرجع, الهدف, الرموز_الخارجية) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ماتشو.رمز_تشغيل_غير_متاح()); }
    | اختيار.بعض(الاسم) -> {
        دع الرمز: رمز_ماتشو = {
            المرجع: المرجع,
            الاسم: الاسم,
            الموضع: الموضع
        };
        ألحق(*الرموز, الرمز);
        أرجع نتيجة.نجح(صواب);
    };
}

عرف انسخ_موضع_رمز_ماتشو(الموضع: &موضع_رمز_ماتشو): موضع_رمز_ماتشو {
    طابق *الموضع مع
    | موضع_رمز_ماتشو.معرف_في_قسم(القسم, الإزاحة) -> {
        أرجع موضع_رمز_ماتشو.معرف_في_قسم(القسم, الإزاحة);
    }
    | موضع_رمز_ماتشو.غير_معرف -> { أرجع موضع_رمز_ماتشو.غير_معرف(); };
}

عرف انسخ_اسم_رمز_ماتشو(الاسم: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الاسم) مثل غير_موقع)) {
        ألحق(الناتج, (*الاسم)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف انسخ_رمز_ماتشو(الرمز: &رمز_ماتشو): رمز_ماتشو {
    دع المرجع: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&(*الرمز).المرجع);
    دع الاسم: متجه غ8 = انسخ_اسم_رمز_ماتشو(&(*الرمز).الاسم);
    دع الموضع: موضع_رمز_ماتشو = انسخ_موضع_رمز_ماتشو(&(*الرمز).الموضع);
    دع الناتج: رمز_ماتشو = { المرجع: المرجع, الاسم: الاسم, الموضع: الموضع };
    أرجع الناتج;
}

عرف رتب_مؤشرات_رموز_ماتشو_بالاسم(
    الرموز: &متجه رمز_ماتشو,
    المؤشرات: &متجه غير_موقع
): متجه غير_موقع {
    دع الحالية: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المؤشرات) مثل غير_موقع)) {
        ألحق(الحالية, (*المؤشرات)[ف]);
        ف := ف + 1;
    }
    دع العدد: غير_موقع = الطول(الحالية) مثل غير_موقع;
    لو (العدد < 2) { أرجع الحالية; };
    دع العرض: متغير غير_موقع = 1;
    بينما (العرض < العدد) {
        دع التالية: متغير متجه غير_موقع = [];
        دع البداية: متغير غير_موقع = 0;
        بينما (البداية < العدد) {
            دع الوسط: متغير غير_موقع = البداية + العرض;
            لو (الوسط > العدد) { الوسط := العدد; };
            دع النهاية: متغير غير_موقع = الوسط + العرض;
            لو (النهاية > العدد) { النهاية := العدد; };
            دع يسار: متغير غير_موقع = البداية;
            دع يمين: متغير غير_موقع = الوسط;
            بينما ((يسار < الوسط) || (يمين < النهاية)) {
                لو (يمين >= النهاية) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا لو (يسار >= الوسط) {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                } وإلا لو (!اسم_ماتشو_أصغر(
                    &(*الرموز)[الحالية[يمين]].الاسم,
                    &(*الرموز)[الحالية[يسار]].الاسم
                )) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                };
            }
            البداية := النهاية;
        }
        الحالية := التالية;
        لو (العرض > (العدد / 2)) { العرض := العدد; } وإلا { العرض := العرض * 2; };
    }
    أرجع الحالية;
}

عرف رتب_رموز_ماتشو_المعرفة_أولا(الرموز: &متجه رمز_ماتشو): متجه رمز_ماتشو {
    دع المعرفة: متغير متجه غير_موقع = [];
    دع غير_المعرفة: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرموز) مثل غير_موقع)) {
        لو (هل_موضع_رمز_ماتشو_معرف((*الرموز)[ف].الموضع)) {
            ألحق(المعرفة, ف);
        } وإلا {
            ألحق(غير_المعرفة, ف);
        };
        ف := ف + 1;
    }

    // Mach-O keeps defined and undefined groups separate and requires the
    // external/undefined name order to be lexicographic. Sort lightweight
    // indices in O(n log n), then copy each owned symbol exactly once.
    دع المعرفة_المرتبة: متجه غير_موقع = رتب_مؤشرات_رموز_ماتشو_بالاسم(الرموز, &المعرفة);
    دع غير_المعرفة_المرتبة: متجه غير_موقع = رتب_مؤشرات_رموز_ماتشو_بالاسم(الرموز, &غير_المعرفة);

    دع الناتج: متغير متجه رمز_ماتشو = [];
    ف := 0;
    بينما (ف < (الطول(المعرفة_المرتبة) مثل غير_موقع)) {
        دع الرمز: رمز_ماتشو = انسخ_رمز_ماتشو(&(*الرموز)[المعرفة_المرتبة[ف]]);
        ألحق(الناتج, الرمز);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(غير_المعرفة_المرتبة) مثل غير_موقع)) {
        دع الرمز: رمز_ماتشو = انسخ_رمز_ماتشو(&(*الرموز)[غير_المعرفة_المرتبة[ف]]);
        ألحق(الناتج, الرمز);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أس_محاذاة_ماتشو(المحاذاة: غير_موقع): اختيار غير_موقع {
    لو (المحاذاة == 0) { أرجع اختيار.لا_شيء(); };
    دع القوة: متغير غير_موقع = 1;
    دع الأس: متغير غير_موقع = 0;
    بينما ((القوة < المحاذاة) && (الأس < 20)) {
        القوة := القوة * 2;
        الأس := الأس + 1;
    }
    لو (القوة != المحاذاة) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الأس);
}

عرف محاذاة_حقل_إزاحة_مشترك(النوع: نوع_إزاحة_رمزية_كائن): غير_موقع {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { أرجع 8; }
    | _ -> { أرجع 4; };
}

عرف ألحق_كلمة_نص(البيانات: &متغير متجه غ8, الكلمة: كلمة_ذراع_أربعة_وستون_مشفرة): منطقي {
    لو (الكلمة.القيمة > 0xFFFFFFFF) { أرجع خطأ; };
    ألحق_غ32_صغير(البيانات, الكلمة.القيمة);
    أرجع صواب;
}

عرف رتب_إزاحات_ماتشو(الإزاحات: &متجه إزاحة_ماتشو): متجه إزاحة_ماتشو {
    دع الحالية: متغير متجه إزاحة_ماتشو = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الإزاحات) مثل غير_موقع)) {
        ألحق(الحالية, (*الإزاحات)[ف]);
        ف := ف + 1;
    }
    دع العدد: غير_موقع = الطول(الحالية) مثل غير_موقع;
    لو (العدد < 2) { أرجع الحالية; };
    دع العرض: متغير غير_موقع = 1;
    بينما (العرض < العدد) {
        دع التالية: متغير متجه إزاحة_ماتشو = [];
        دع البداية: متغير غير_موقع = 0;
        بينما (البداية < العدد) {
            دع الوسط: متغير غير_موقع = البداية + العرض;
            لو (الوسط > العدد) { الوسط := العدد; };
            دع النهاية: متغير غير_موقع = الوسط + العرض;
            لو (النهاية > العدد) { النهاية := العدد; };
            دع يسار: متغير غير_موقع = البداية;
            دع يمين: متغير غير_موقع = الوسط;
            بينما ((يسار < الوسط) || (يمين < النهاية)) {
                لو (يمين >= النهاية) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا لو (يسار >= الوسط) {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                } وإلا لو (الحالية[يسار].إزاحة_بايت >= الحالية[يمين].إزاحة_بايت) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                };
            }
            البداية := النهاية;
        }
        الحالية := التالية;
        لو (العرض > (العدد / 2)) { العرض := العدد; } وإلا { العرض := العرض * 2; };
    }
    أرجع الحالية;
}

عرف نوع_إزاحة_ماتشو_من_مشترك(النوع: نوع_إزاحة_رمزية_كائن): نوع_إزاحة_ماتشو {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت -> { أرجع نوع_إزاحة_ماتشو.فرع_ذراع_ستة_وعشرون_بت(); }
    | نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت -> { أرجع نوع_إزاحة_ماتشو.صفحة_ذراع_واحد_وعشرون_بت(); }
    | نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> {
        أرجع نوع_إزاحة_ماتشو.إزاحة_صفحة_ذراع_اثنا_عشر_بت(); }
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { أرجع نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت(); };
}

عرف حجم_حقل_إزاحة_مشترك(النوع: نوع_إزاحة_رمزية_كائن): غير_موقع {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { أرجع 8; }
    | _ -> { أرجع 4; };
}

عرف ابحث_موضع_دالة_ماتشو(
    المواضع: &متجه موضع_دالة_دوارف,
    الدالة: معرف_دالة_منتقاة
): اختيار غير_موقع {
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(*المواضع) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع الموجود: غير_موقع = (*المواضع)[الوسط].الدالة.القيمة;
        لو (الموجود == الدالة.القيمة) { أرجع اختيار.بعض(الوسط); };
        لو (الموجود < الدالة.القيمة) { البداية := الوسط + 1; }
        وإلا { النهاية := الوسط; };
    }
    أرجع اختيار.لا_شيء();
}

عرف اسم_دخول_ماتشو(): متجه غ8 {
    // _main
    دع الاسم: متجه غ8 = [0x5F, 0x6D, 0x61, 0x69, 0x6E];
    أرجع الاسم;
}

عرف طبق_اسم_دخول_ماتشو(
    الرموز: &متغير متجه رمز_ماتشو,
    دالة_الدخول: اختيار معرف_دالة_منتقاة
): اختيار خطأ_ماتشو {
    طابق دالة_الدخول مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الدخول) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(*الرموز) مثل غير_موقع)) {
            دع المرجع_الحالي: مرجع_رمز_كائن = (*الرموز)[ف].المرجع;
            طابق المرجع_الحالي مع
            | مرجع_رمز_كائن.دالة(الدالة) -> {
                لو (معرفا_دالة_منتقاة_متساويان(الدالة, الدخول)) {
                    دع الموضع_الحالي: موضع_رمز_ماتشو = (*الرموز)[ف].الموضع;
                    طابق الموضع_الحالي مع
                    | موضع_رمز_ماتشو.غير_معرف -> {
                        أرجع اختيار.بعض(خطأ_ماتشو.رمز_دخول_مفقود(الدخول));
                    }
                    | موضع_رمز_ماتشو.معرف_في_قسم(القسم, الموضع_داخل_القسم) -> {
                        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدخول);
                        دع الموضع: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(القسم, الموضع_داخل_القسم);
                        دع الاسم: متجه غ8 = اسم_دخول_ماتشو();
                        دع الجديد: رمز_ماتشو = {
                            المرجع: المرجع,
                            الاسم: الاسم,
                            الموضع: الموضع
                        };
                        (*الرموز)[ف] := الجديد;
                        أرجع اختيار.لا_شيء();
                    };
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع اختيار.بعض(خطأ_ماتشو.رمز_دخول_مفقود(الدخول));
    };
}

عرف قسم_رقعة_دوارف_يساوي(أ: قسم_عنوان_دوارف, ب: قسم_عنوان_دوارف): منطقي {
    طابق أ مع
    | قسم_عنوان_دوارف.معلومات -> { طابق ب مع | قسم_عنوان_دوارف.معلومات -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.سطور -> { طابق ب مع | قسم_عنوان_دوارف.سطور -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.مواقع -> { طابق ب مع | قسم_عنوان_دوارف.مواقع -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.إطار -> { طابق ب مع | قسم_عنوان_دوارف.إطار -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.نطاقات_عناوين -> { طابق ب مع | قسم_عنوان_دوارف.نطاقات_عناوين -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.عناوين -> { طابق ب مع | قسم_عنوان_دوارف.عناوين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.قوائم_مواقع -> { طابق ب مع | قسم_عنوان_دوارف.قوائم_مواقع -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.قوائم_نطاقات -> { طابق ب مع | قسم_عنوان_دوارف.قوائم_نطاقات -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; };
}

عرف قسم_بيانات_دوارف_يساوي_ماتشو(أ: قسم_بيانات_دوارف, ب: قسم_بيانات_دوارف): منطقي {
    طابق أ مع
    | قسم_بيانات_دوارف.معلومات -> { طابق ب مع | قسم_بيانات_دوارف.معلومات -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.اختصارات -> { طابق ب مع | قسم_بيانات_دوارف.اختصارات -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.سطور -> { طابق ب مع | قسم_بيانات_دوارف.سطور -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.سلاسل_سطور -> { طابق ب مع | قسم_بيانات_دوارف.سلاسل_سطور -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.سلاسل -> { طابق ب مع | قسم_بيانات_دوارف.سلاسل -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.عناوين -> { طابق ب مع | قسم_بيانات_دوارف.عناوين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.مواقع -> { طابق ب مع | قسم_بيانات_دوارف.مواقع -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.قوائم_مواقع -> { طابق ب مع | قسم_بيانات_دوارف.قوائم_مواقع -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.إطار -> { طابق ب مع | قسم_بيانات_دوارف.إطار -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.نطاقات_عناوين -> { طابق ب مع | قسم_بيانات_دوارف.نطاقات_عناوين -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.قوائم_نطاقات -> { طابق ب مع | قسم_بيانات_دوارف.قوائم_نطاقات -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.أسماء_عامة -> { طابق ب مع | قسم_بيانات_دوارف.أسماء_عامة -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.فهرس_أسماء -> { طابق ب مع | قسم_بيانات_دوارف.فهرس_أسماء -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; };
}

عرف أقسام_بيانات_دوارف_ماتشو_الفعالة(الحزمة: &حزمة_دوارف): متجه قسم_بيانات_دوارف {
    دع الأقسام: متغير متجه قسم_بيانات_دوارف = [];
    ألحق(الأقسام, قسم_بيانات_دوارف.معلومات());
    ألحق(الأقسام, قسم_بيانات_دوارف.اختصارات());
    ألحق(الأقسام, قسم_بيانات_دوارف.سطور());
    // DWARF policy owns version selection. Mach-O only maps sections that the
    // selected DWARF serializer actually materialized.
    لو (الطول((*الحزمة).سلاسل_سطور) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.سلاسل_سطور()); };
    لو (الطول((*الحزمة).سلاسل) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.سلاسل()); };
    لو (الطول((*الحزمة).عناوين) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.عناوين()); };
    لو (الطول((*الحزمة).مواقع) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.مواقع()); };
    لو (الطول((*الحزمة).قوائم_مواقع) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.قوائم_مواقع()); };
    لو (الطول((*الحزمة).إطار) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.إطار()); };
    لو (الطول((*الحزمة).نطاقات_عناوين) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.نطاقات_عناوين()); };
    لو (الطول((*الحزمة).قوائم_نطاقات) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.قوائم_نطاقات()); };
    لو (الطول((*الحزمة).أسماء_عامة) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.أسماء_عامة()); };
    لو (الطول((*الحزمة).فهرس_أسماء) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.فهرس_أسماء()); };
    أرجع الأقسام;
}

عرف ترتيب_هدف_قسم_دوارف_ماتشو(
    الأقسام_الفعالة: &متجه قسم_بيانات_دوارف,
    بداية_ترتيب_دوارف: غير_موقع,
    الهدف: قسم_بيانات_دوارف
): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأقسام_الفعالة) مثل غير_موقع)) {
        لو (قسم_بيانات_دوارف_يساوي_ماتشو((*الأقسام_الفعالة)[ف],
            الهدف)) { أرجع اختيار.بعض(بداية_ترتيب_دوارف + ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف نوع_إزاحة_دوارف_ماتشو_للعرض(العرض: غير_موقع): اختيار نوع_إزاحة_ماتشو {
    لو (العرض == 4) { أرجع اختيار.بعض(نوع_إزاحة_ماتشو.مطلق_اثنان_وثلاثون_بت()); };
    لو (العرض == 8) { أرجع اختيار.بعض(نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت()); };
    أرجع اختيار.لا_شيء();
}

عرف اكتب_إضافة_دوارف_ماتشو(البيانات: &متغير متجه غ8, الموضع: غير_موقع, العرض: غير_موقع,
    القيمة: غير_موقع): منطقي {
    لو ((العرض != 4 && العرض != 8) || الموضع + العرض > (الطول(*البيانات) مثل غير_موقع)) { أرجع خطأ; };
    دع ح: متغير غير_موقع = القيمة; دع ف: متغير غير_موقع = 0;
    بينما (ف < العرض) {
        دع موضع_الكتابة: غير_موقع = الموضع + ف;
        (*البيانات)[موضع_الكتابة] := (ح % 256) مثل غ8;
        ح := ح / 256;
        ف := ف + 1;
    }
    أرجع صواب;
}

// Mach-O owns MH_OBJECT relocation encoding. DWARF contributes only a
// symbolic text/data section reference and the field position.
عرف أضف_قسم_دوارف_ماتشو(
    الأقسام: &متغير متجه قسم_ماتشو,
    الاسم: متجه غ8,
    البيانات: &متغير متجه غ8,
    المحاذاة_الأسية: غير_موقع,
    نوع_قسم_العنوان: اختيار قسم_عنوان_دوارف,
    نوع_قسم_البيانات: قسم_بيانات_دوارف,
    رقع_العناوين: &متجه رقعة_عنوان_دوارف,
    رقع_الأقسام: &متجه رقعة_قسم_دوارف,
    ترتيب_قسم_النص: غير_موقع,
    ترتيب_قسم_البيانات: غير_موقع,
    بداية_ترتيب_دوارف: غير_موقع,
    الأقسام_الفعالة: &متجه قسم_بيانات_دوارف
): منطقي {
    دع اسم_المقطع: متجه غ8 = [0x5F,0x5F,0x44,0x57,0x41,0x52,0x46];
    دع الإزاحات: متغير متجه إزاحة_ماتشو = [];
    دع ف: متغير غير_موقع = 0;
    طابق نوع_قسم_العنوان مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(قسم_العنوان) -> {
        بينما (ف < (الطول(*رقع_العناوين) مثل غير_موقع)) {
            دع الرقعة: رقعة_عنوان_دوارف = (*رقع_العناوين)[ف];
            لو (قسم_رقعة_دوارف_يساوي(الرقعة.القسم, قسم_العنوان)) {
                دع ترتيب_الهدف: متغير غير_موقع = ترتيب_قسم_النص;
                طابق الرقعة.المرجع.القاعدة مع
                | قاعدة_عنوان_دوارف.نص -> { ترتيب_الهدف := ترتيب_قسم_النص; }
                | قاعدة_عنوان_دوارف.بيانات -> { ترتيب_الهدف := ترتيب_قسم_البيانات; };
                لو (ترتيب_الهدف == 0 || !اكتب_إضافة_دوارف_ماتشو(البيانات, الرقعة.الموضع, الرقعة.العرض,
                    الرقعة.المرجع.إزاحة_بايت)) { أرجع خطأ; };
                طابق نوع_إزاحة_دوارف_ماتشو_للعرض(الرقعة.العرض) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(نوع_الإزاحة) -> {
                    دع هدف_القسم: هدف_إزاحة_ماتشو = هدف_إزاحة_ماتشو.قسم_محلي(ترتيب_الهدف);
                    دع الإزاحة: إزاحة_ماتشو = { إزاحة_بايت: الرقعة.الموضع, النوع: نوع_الإزاحة,
                        الهدف: هدف_القسم };
                    ألحق(الإزاحات, الإزاحة);
                };
            };
            ف := ف + 1;
        }
    };
    ف := 0;
    بينما (ف < (الطول(*رقع_الأقسام) مثل غير_موقع)) {
        دع الرقعة: رقعة_قسم_دوارف = (*رقع_الأقسام)[ف];
        لو (قسم_بيانات_دوارف_يساوي_ماتشو(الرقعة.القسم, نوع_قسم_البيانات)) {
            طابق ترتيب_هدف_قسم_دوارف_ماتشو(الأقسام_الفعالة, بداية_ترتيب_دوارف, الرقعة.الهدف) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(ترتيب_الهدف) -> {
                لو (!اكتب_إضافة_دوارف_ماتشو(البيانات, الرقعة.الموضع, الرقعة.العرض,
                    الرقعة.الإزاحة)) { أرجع خطأ; };
                طابق نوع_إزاحة_دوارف_ماتشو_للعرض(الرقعة.العرض) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(نوع_الإزاحة) -> {
                    دع هدف_القسم: هدف_إزاحة_ماتشو = هدف_إزاحة_ماتشو.قسم_محلي(ترتيب_الهدف);
                    دع الإزاحة: إزاحة_ماتشو = { إزاحة_بايت: الرقعة.الموضع, النوع: نوع_الإزاحة,
                        الهدف: هدف_القسم };
                    ألحق(الإزاحات, الإزاحة);
                };
            };
        };
        ف := ف + 1;
    }
    دع بيانات_القسم: متجه غ8 = *البيانات;
    دع الإزاحات_المرتبة: متجه إزاحة_ماتشو = رتب_إزاحات_ماتشو(&الإزاحات);
    دع القسم: قسم_ماتشو = {
        الاسم: الاسم, اسم_المقطع: اسم_المقطع, البيانات: بيانات_القسم,
        المحاذاة_الأسية: المحاذاة_الأسية, الأعلام: 0x02000000,
        الإزاحات: الإزاحات_المرتبة
    };
    ألحق(*الأقسام, القسم);
    أرجع صواب;
}


عام عرف ابن_كائن_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(
    الشفرة: &شفرة_ذراع_أربعة_وستون_مشفرة,
    المرفقات: &مرفقات_كائن_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_بناء_ماتشو {
    دع معرف_الشفرة: معرف_هدف = (*الشفرة).الهدف;
    دع معرف_الهدف: معرف_هدف = (*الهدف).المعرف;
    لو (!معرفا_هدف_متساويان(معرف_الشفرة,
        معرف_الهدف)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق(معرف_الشفرة)); };
    طابق (*الهدف).صيغة_الكائن مع
    | صيغة_كائن_هدف.ماتشو -> { }
    | _ -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق(معرف_الهدف)); };

    دع مؤشرات_الدوال: متجه غير_موقع = رتب_مؤشرات_دوال_مشفرة(&(*الشفرة).الدوال);
    دع النص: متغير متجه غ8 = [];
    دع مواضع_دوارف: متغير متجه موضع_دالة_دوارف = [];
    دع أصول_آلة_دوارف: متغير متجه مدى_شفرة_آلة_بأصل = [];
    دع الرموز: متغير متجه رمز_ماتشو = [];
    دع الإزاحات: متغير متجه إزاحة_ماتشو = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(مؤشرات_الدوال) مثل غير_موقع)) {
        دع فهرس_الدالة: غير_موقع = مؤشرات_الدوال[ف];
        دع مرجع_الدالة: &دالة_ذراع_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[فهرس_الدالة];
        دع بداية_الدالة: غير_موقع = الطول(النص) مثل غير_موقع;
        دع معرف_الدالة: معرف_دالة_منتقاة = (*مرجع_الدالة).المعرف;
        لو (ف > 0) {
            دع موضع_السابق: غير_موقع = ف - 1;
            دع فهرس_السابق: غير_موقع = مؤشرات_الدوال[موضع_السابق];
            دع معرف_السابق: معرف_دالة_منتقاة = (*الشفرة).الدوال[فهرس_السابق].المعرف;
            لو (معرفا_دالة_منتقاة_متساويان(معرف_السابق, معرف_الدالة)) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.دالة_مكررة(معرف_الدالة));
            };
        };
        دع مرجع_الدالة_الرمزي: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_الدالة);
        دع موضع_الدالة: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(0, بداية_الدالة);
        دع اسم_الدالة: متجه غ8 = اسم_رمز_دالة(معرف_الدالة);
        دع رمز_الدالة: رمز_ماتشو = {
            المرجع: مرجع_الدالة_الرمزي,
            الاسم: اسم_الدالة,
            الموضع: موضع_الدالة
        };
        ألحق(الرموز, رمز_الدالة);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول((*مرجع_الدالة).الكلمات) مثل غير_موقع)) {
            لو (!ألحق_كلمة_نص(&متغير النص,
                (*مرجع_الدالة).الكلمات[ك])) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.كلمة_تعليمة_خارج_نطاق_غ32(معرف_الدالة)); };
            ك := ك + 1;
        }
        دع نهاية_الدالة: غير_موقع = الطول(النص) مثل غير_موقع;
        دع حجم_دالة_دوارف: غير_موقع = نهاية_الدالة - بداية_الدالة;
        دع اسم_ربط_الدالة_دوارف: متجه غ8 = اسم_رمز_دالة(معرف_الدالة);
        دع موضع_دوارف: موضع_دالة_دوارف = {
            الدالة: معرف_الدالة,
            إزاحة_بايت: بداية_الدالة,
            حجم_بايت: حجم_دالة_دوارف,
            اسم_الربط: اسم_ربط_الدالة_دوارف
        };
        ألحق(مواضع_دوارف, موضع_دوارف);
        دع أصل_ف: متغير غير_موقع = 0;
        بينما (أصل_ف < (الطول((*مرجع_الدالة).أصول_الآلة) مثل غير_موقع)) {
            ألحق(أصول_آلة_دوارف, (*مرجع_الدالة).أصول_الآلة[أصل_ف]);
            أصل_ف := أصل_ف + 1;
        }
        ف := ف + 1;
    }

    دع الثوابت: متغير متجه غ8 = [];
    دع أقوى_محاذاة_ثوابت: متغير غير_موقع = 1;
    دع مؤشرات_البيانات_الثابتة: متجه غير_موقع = رتب_مؤشرات_بيانات_ثابتة_ماتشو(&(*المرفقات).البيانات_الثابتة);
    دع ب: متغير غير_موقع = 0;
    بينما (ب < (الطول(مؤشرات_البيانات_الثابتة) مثل غير_موقع)) {
        دع فهرس_البيانات: غير_موقع = مؤشرات_البيانات_الثابتة[ب];
        دع مرجع_البيانات: &بيانات_ثابتة_كائن = &(*المرفقات).البيانات_الثابتة[فهرس_البيانات];
        لو (!(*مرجع_البيانات).للقراءة_فقط) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.نوع_إزاحة_غير_مدعوم()); };
        دع محاذاة: متغير غير_موقع = (*مرجع_البيانات).المحاذاة;
        لو (محاذاة == 0) { محاذاة := 1; };
        طابق أس_محاذاة_ماتشو(محاذاة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
        | اختيار.بعض(_) -> { };
        لو (محاذاة > أقوى_محاذاة_ثوابت) { أقوى_محاذاة_ثوابت := محاذاة; };
        دع حجم_الثوابت_الحالي: غير_موقع = الطول(الثوابت) مثل غير_موقع;
        دع موضع_البيانات: غير_موقع = حاذ_لأعلى(حجم_الثوابت_الحالي, محاذاة);
        دع الحالي: غير_موقع = حجم_الثوابت_الحالي;
        لو (موضع_البيانات > الحالي) { ألحق_أصفارا(&متغير الثوابت, موضع_البيانات - الحالي); };
        دع معرف_البيانات: معرف_بيانات_ثابتة_كائن = (*مرجع_البيانات).المعرف;
        لو (ب > 0) {
            دع موضع_السابق: غير_موقع = ب - 1;
            دع فهرس_السابق: غير_موقع = مؤشرات_البيانات_الثابتة[موضع_السابق];
            دع معرف_السابق: معرف_بيانات_ثابتة_كائن = (*المرفقات).البيانات_الثابتة[فهرس_السابق].المعرف;
            لو (معرفا_بيانات_ثابتة_كائن_متساويان(&معرف_السابق, &معرف_البيانات)) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.بيانات_ثابتة_مكررة(معرف_البيانات.القيمة));
            };
        };
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.بيانات_ثابتة(معرف_البيانات);
        دع الموضع: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(1, موضع_البيانات);
        دع اسم_البيانات: متجه غ8 = اسم_رمز_بيانات(معرف_البيانات);
        دع رمز_البيانات: رمز_ماتشو = {
            المرجع: المرجع,
            الاسم: اسم_البيانات,
            الموضع: الموضع
        };
        ألحق(الرموز, رمز_البيانات);
        دع د: متغير غير_موقع = 0;
        بينما (د < (الطول((*مرجع_البيانات).البيانات) مثل غير_موقع)) { ألحق(الثوابت,
            (*مرجع_البيانات).البيانات[د]); د := د + 1; }
        ب := ب + 1;
    }

    دع البيانات_العامة: متغير متجه غ8 = [];
    دع مواضع_العوام_دوارف: متغير متجه موضع_عام_دوارف = [];
    دع أقوى_محاذاة_عوام: متغير غير_موقع = 1;
    دع عدد_بايتات_الثوابت: غير_موقع = الطول(الثوابت) مثل غير_موقع;
    دع لديه_ثوابت: منطقي = عدد_بايتات_الثوابت != 0;
    دع فهرس_قسم_العوام: متغير غير_موقع = 1;
    لو (لديه_ثوابت) { فهرس_قسم_العوام := 2; };
    دع ع: متغير غير_موقع = 0;
    بينما (ع < (الطول((*المرفقات).البيانات_العامة) مثل غير_موقع)) {
        دع مرجع_العام: &بيانات_عام_كائن = &(*المرفقات).البيانات_العامة[ع];
        لو (!(*مرجع_العام).قابل_للكتابة) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.نوع_إزاحة_غير_مدعوم()); };
        دع محاذاة_العام: متغير غير_موقع = (*مرجع_العام).المحاذاة;
        لو (محاذاة_العام == 0) { محاذاة_العام := 1; };
        طابق أس_محاذاة_ماتشو(محاذاة_العام) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
        | اختيار.بعض(_) -> { };
        لو (محاذاة_العام > أقوى_محاذاة_عوام) { أقوى_محاذاة_عوام := محاذاة_العام; };
        دع حجم_البيانات_الحالي: غير_موقع = الطول(البيانات_العامة) مثل غير_موقع;
        دع موضع_العام: غير_موقع = حاذ_لأعلى(حجم_البيانات_الحالي, محاذاة_العام);
        لو (موضع_العام > حجم_البيانات_الحالي) { ألحق_أصفارا(&متغير البيانات_العامة,
            موضع_العام - حجم_البيانات_الحالي); };
        دع معرف_العام: معرف_عام_مسير = (*مرجع_العام).المعرف;
        دع اسم_ربط_العام_دوارف: متجه غ8 = اسم_رمز_عام_ماتشو(معرف_العام);
        دع موضع_دوارف_للعام: موضع_عام_دوارف = {
            العام: معرف_العام, إزاحة_بايت: موضع_العام, اسم_الربط: اسم_ربط_العام_دوارف
        };
        ألحق(مواضع_العوام_دوارف, موضع_دوارف_للعام);
        دع المرجع_العام: مرجع_رمز_كائن = مرجع_رمز_كائن.عام((*مرجع_العام).المعرف);
        دع موضع_الرمز_العام: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(فهرس_قسم_العوام, موضع_العام);
        طابق أضف_رمز_ماتشو_إن_غاب(&متغير الرموز, المرجع_العام, موضع_الرمز_العام, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
        | نتيجة.نجح(أضيف) -> { لو (!أضيف) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.رمز_إزاحة_مفقود()); }; };
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول((*مرجع_العام).البيانات) مثل غير_موقع)) { ألحق(البيانات_العامة,
            (*مرجع_العام).البيانات[ج]); ج := ج + 1; }
        ع := ع + 1;
    }

    دع ر: متغير غير_موقع = 0;
    بينما (ر < (الطول((*المرفقات).إزاحات_النص) مثل غير_موقع)) {
        دع مرجع_الطلب: &طلب_إزاحة_نص_كائن = &(*المرفقات).إزاحات_النص[ر];
        لو ((*مرجع_الطلب).الإضافة != 0) {
            أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.إضافة_تثبيت_غير_مدعومة((*مرجع_الطلب).الموضع.الدالة)); };
        دع بداية: متغير غير_موقع = 0;
        دع حجم_الدالة: متغير غير_موقع = 0;
        طابق ابحث_موضع_دالة_ماتشو(&مواضع_دوارف, (*مرجع_الطلب).الموضع.الدالة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة)); }
        | اختيار.بعض(فهرس_الموضع) -> {
            دع مرجع_الموضع: &موضع_دالة_دوارف = &مواضع_دوارف[فهرس_الموضع];
            بداية := (*مرجع_الموضع).إزاحة_بايت;
            حجم_الدالة := (*مرجع_الموضع).حجم_بايت;
        };
        دع حجم_الحقل: غير_موقع = حجم_حقل_إزاحة_مشترك((*مرجع_الطلب).النوع);
        دع محاذاة_الحقل: غير_موقع = محاذاة_حقل_إزاحة_مشترك((*مرجع_الطلب).النوع);
        لو (((*مرجع_الطلب).الموضع.إزاحة_بايت % محاذاة_الحقل) != 0) {
            أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة));
        };
        لو ((*مرجع_الطلب).الموضع.إزاحة_بايت + حجم_الحقل > حجم_الدالة) {
            أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة)); };
        دع نوع_ماتشو: نوع_إزاحة_ماتشو = نوع_إزاحة_ماتشو_من_مشترك((*مرجع_الطلب).النوع);
        دع موضع_مطلق: غير_موقع = بداية + (*مرجع_الطلب).الموضع.إزاحة_بايت;
        دع مرجع_الإزاحة: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&(*مرجع_الطلب).الرمز);
        دع الهدف_الرمزي: هدف_إزاحة_ماتشو = هدف_إزاحة_ماتشو.رمز(مرجع_الإزاحة);
        دع الإزاحة: إزاحة_ماتشو = { إزاحة_بايت: موضع_مطلق, النوع: نوع_ماتشو, الهدف: الهدف_الرمزي };
        ألحق(الإزاحات, الإزاحة);
        طابق ابحث_رمز_ماتشو(&الرموز, &(*مرجع_الطلب).الرمز) مع
        | اختيار.بعض(_) -> { }
        | اختيار.لا_شيء -> {
            لو (مرجع_رمز_كائن_هو_بيانات_محلية(&(*مرجع_الطلب).الرمز)) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.رمز_إزاحة_مفقود()); };
            دع موضع_رمز_غير_معرف: موضع_رمز_ماتشو = موضع_رمز_ماتشو.غير_معرف();
            دع مرجع_الرمز_الجديد: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&(*مرجع_الطلب).الرمز);
            طابق أضف_رمز_ماتشو_إن_غاب(&متغير الرموز, مرجع_الرمز_الجديد, موضع_رمز_غير_معرف, الهدف,
                الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        };
        ر := ر + 1;
    }

    دع حجم_نص_دوارف: غير_موقع = الطول(النص) مثل غير_موقع;
    دع اسم_النص: متجه غ8 = اسم_قسم_نص();
    دع اسم_المقطع: متجه غ8 = اسم_مقطع_نص();
    دع الإزاحات_المرتبة: متجه إزاحة_ماتشو = رتب_إزاحات_ماتشو(&الإزاحات);
    دع قسم_النص: قسم_ماتشو = { الاسم: اسم_النص, اسم_المقطع: اسم_المقطع, البيانات: النص, المحاذاة_الأسية: 2,
        الأعلام: 0x80000400, الإزاحات: الإزاحات_المرتبة };
