    دع اسم_سلاسل_سطور: متجه غ8 = [0x5F,0x5F,0x64,0x65,0x62,0x75,0x67,0x5F,0x6C,0x69,0x6E,0x65,0x5F,0x73,0x74,0x72];
    دع اسم_سلاسل: متجه غ8 = [0x5F,0x5F,0x64,0x65,0x62,0x75,0x67,0x5F,0x73,0x74,0x72];
