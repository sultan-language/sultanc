    لو (!أضف_قسم_دوارف_ماتشو(&متغير الأقسام, اسم_دوارف_سطور, &متغير حزمة_دوارف_الماتشو.سطور, 0,
        اختيار.بعض(قسم_عنوان_دوارف.سطور()), قسم_بيانات_دوارف.سطور(), &حزمة_دوارف_الماتشو.رقع_العناوين,
