عرف ابحث_اسم_رمز_ماتشو_مرتب(
    الرموز: &متجه رمز_ماتشو,
    الاسم: &متجه غ8,
    بداية_النطاق: غير_موقع,
    نهاية_النطاق: غير_موقع
): اختيار غير_موقع {
    دع البداية: متغير غير_موقع = بداية_النطاق;
    دع النهاية: متغير غير_موقع = نهاية_النطاق;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع الاسم_الحالي: &متجه غ8 = &(*الرموز)[الوسط].الاسم;
        لو (اسم_ماتشو_أصغر(الاسم_الحالي, الاسم)) {
            البداية := الوسط + 1;
        } وإلا لو (اسم_ماتشو_أصغر(الاسم, الاسم_الحالي)) {
            النهاية := الوسط;
        } وإلا {
            أرجع اختيار.بعض(الوسط);
        };
    }
    أرجع اختيار.لا_شيء();
}

عرف ابحث_رمز_إزاحة_ماتشو(
    الكائن: &كائن_ماتشو,
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف
): اختيار غير_موقع {
    دع عدد_الرموز: غير_موقع = الطول((*الكائن).الرموز) مثل غير_موقع;
    دع عدد_المعرفة: غير_موقع = (*الكائن).عدد_الرموز_المعرفة;
