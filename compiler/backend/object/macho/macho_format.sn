        ألحق_غ64_صغير(&متغير البايتات, عناوين_الأقسام[ف]); ألحق_غ64_صغير(&متغير البايتات, حجم_القسم); ألحق_غ32_صغير(&متغير البايتات, إزاحات_الأقسام[ف]); ألحق_غ32_صغير(&متغير البايتات, القسم.المحاذاة_الأسية);
