        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> {
            أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, عدد_المعرفة, عدد_الرموز);
        };
    }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> {
        طابق اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> {
