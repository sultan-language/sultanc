            لو ((*مرجع_ر).القيمة < السلاسل.العنوان || (*مرجع_ر).القيمة >= السلاسل.العنوان + السلاسل.الحجم) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_خارج_النطاق()); };
            الهدف_الرمزي := قاعدة + بداية_السلاسل + ((*مرجع_ر).القيمة - السلاسل.العنوان);
        } وإلا لو (البيانات_الأصلية.موجود && (*مرجع_ر).القسم == البيانات_الأصلية.الفهرس) {
            لو ((*مرجع_ر).القيمة < البيانات_الأصلية.العنوان || (*مرجع_ر).القيمة >= البيانات_الأصلية.العنوان + البيانات_الأصلية.الحجم) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_خارج_النطاق()); };
            الهدف_الرمزي := قاعدة + بداية_بيانات_أصلية + ((*مرجع_ر).القيمة - البيانات_الأصلية.العنوان);
        } وإلا لو (المشترك.موجود && (*مرجع_ر).القسم == المشترك.الفهرس) {
            لو ((*مرجع_ر).القيمة < المشترك.العنوان || (*مرجع_ر).القيمة >= المشترك.العنوان + المشترك.الحجم) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_خارج_النطاق()); };
            الهدف_الرمزي := قاعدة + بداية_مشترك + ((*مرجع_ر).القيمة - المشترك.العنوان);
        } وإلا لو (بي_اس_اس.موجود && (*مرجع_ر).القسم == بي_اس_اس.الفهرس) {
            لو ((*مرجع_ر).القيمة < بي_اس_اس.العنوان || (*مرجع_ر).القيمة >= بي_اس_اس.العنوان + بي_اس_اس.الحجم) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_خارج_النطاق()); };
            الهدف_الرمزي := قاعدة + بداية_بي_اس_اس + ((*مرجع_ر).القيمة - بي_اس_اس.العنوان);
        } وإلا لو ((*مرجع_ر).القسم == 0) {
            طابق ابحث_رمز_خارجي_ماتشو_تنفيذي(&الخارجية, فهرس_الرمز) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.رمز_خارجي_تنفيذي_ماتشو_غير_مدعوم()); }
            | اختيار.بعض(خ) -> { الهدف_الرمزي := قاعدة + بداية_الستب + خ * 12; };
        } وإلا { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_غير_مدعومة()); };
        دع موضع_الرقعة: غير_موقع = بداية_النص + إزاحة;
        دع عنوان_الرقعة: غير_موقع = قاعدة + موضع_الرقعة;
        لو (نوع_الإزاحة == 2) {
            لو (!رقع_فرع26_ماتشو(&متغير الصورة, موضع_الرقعة, عنوان_الرقعة, الهدف_الرمزي)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_خارج_النطاق()); };
        } وإلا لو (نوع_الإزاحة == 3) {
            لو ((*مرجع_ر).القسم == 0) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_غير_مدعومة()); };
            لو (!رقع_صفحة21_ماتشو(&متغير الصورة, موضع_الرقعة, عنوان_الرقعة, الهدف_الرمزي)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_خارج_النطاق()); };
        } وإلا لو (نوع_الإزاحة == 4) {
            لو ((*مرجع_ر).القسم == 0 || !رقع_صفحة12_ماتشو(&متغير الصورة, موضع_الرقعة, الهدف_الرمزي)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_غير_مدعومة()); };
        } وإلا لو (نوع_الإزاحة == 0) {
            لو ((*مرجع_ر).القسم == 0 || !ضع_غ64_صغير_ماتشو(&متغير الصورة, موضع_الرقعة, الهدف_الرمزي)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_غير_مدعومة()); };
        } وإلا { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.إزاحة_تنفيذية_ماتشو_غير_مدعومة()); };
        ف := ف + 1;
    }

    لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_بيانات_أصلية)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    لو (البيانات_الأصلية.موجود) {
        ف := 0;
        بينما (ف < البيانات_الأصلية.الحجم) {
            دع موضع_مصدر_البيانات: غير_موقع = البيانات_الأصلية.إزاحة_الملف + ف;
            ألحق(الصورة, (*بايتات_الكائن)[موضع_مصدر_البيانات]);
            ف := ف + 1;
        }
    };
    لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_مشترك)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    ألحق_أصفارا(&متغير الصورة, حجم_مشترك);
    لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_بي_اس_اس)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    ألحق_أصفارا(&متغير الصورة, حجم_بي_اس_اس);
    لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_جوت)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    ألحق_أصفارا(&متغير الصورة, حجم_جوت);
    لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_الملاحظة)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    دع ملاحظة: متجه غ8 = [0x53,0x55,0x4C,0x54,0x41,0x4E,0x43,0];
    ف := 0; بينما (ف < 8) { ألحق(الصورة, ملاحظة[ف]); ف := ف + 1; }
    مؤشر_قسم_دوارف := 0;
    بينما (مؤشر_قسم_دوارف < عدد_أقسام_دوارف_تنفيذية) {
        دع بداية_قسم_دوارف: غير_موقع = بدايات_أقسام_دوارف[مؤشر_قسم_دوارف];
        لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_قسم_دوارف)) {
            أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح());
        };
        ألحق_قسم_دوارف_ماتشو_تنفيذي(&متغير الصورة, دوارف, أقسام_دوارف_تنفيذية[مؤشر_قسم_دوارف]);
        مؤشر_قسم_دوارف := مؤشر_قسم_دوارف + 1;
    }
    لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_الربط)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    ف := 0; بينما (ف < (الطول(ربط) مثل غير_موقع)) { ألحق(الصورة, ربط[ف]); ف := ف + 1; }
    لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_رموز_خارجي)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    ف := 0;
    بينما (ف < عدد_الخارجية) {
        ألحق_غ32_صغير(&متغير الصورة, إزاحات_أسماء_خارجي[ف]); ألحق_غ8(&متغير الصورة, 1); ألحق_غ8(&متغير الصورة, 0);
        ألحق_غ8(&متغير الصورة, 0); ألحق_غ8(&متغير الصورة, 1); ألحق_غ64_صغير(&متغير الصورة, 0);
        ف := ف + 1;
    }
    لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_نصوص_خارجي)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    ف := 0; بينما (ف < (الطول(نصوص_خارجي) مثل غير_موقع)) { ألحق(الصورة, نصوص_خارجي[ف]); ف := ف + 1; }
    لو (!أكمل_ماتشو_إلى(&متغير الصورة, بداية_التوقيع)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };

    // UUID ثابت دلاليا من SHA-256 للكائن قبل التوقيع.
    دع حجم_كائن_مصدر: غير_موقع = الطول(*بايتات_الكائن) مثل غير_موقع;
    طابق هاش_شا256_جزء_ماتشو(بايتات_الكائن, 0, حجم_كائن_مصدر) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.توقيع_تنفيذي_ماتشو_فشل()); }
    | اختيار.بعض(الهاش) -> {
        ف := 0;
        بينما (ف < 16) {
            دع موضع_يويد_الحالي: غير_موقع = موضع_يويد + ف;
            الصورة[موضع_يويد_الحالي] := الهاش[ف];
            ف := ف + 1;
        }
    };
    // حجم التوقيع حتمي من codeLimit. نستخدم بناء أوليا لحساب الحجم، ثم نثبت
    // LC_CODE_SIGNATURE و __LINKEDIT قبل حساب هاشات التوقيع النهائية.
    دع توقيع_تمهيدي: متجه غ8;
    طابق ابن_توقيع_أدهوك_ماتشو(&الصورة) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.توقيع_تنفيذي_ماتشو_فشل()); }
    | اختيار.بعض(ت) -> { توقيع_تمهيدي := ت; };
    دع حجم_التوقيع: غير_موقع = الطول(توقيع_تمهيدي) مثل غير_موقع;
    لو (!ضع_غ32_صغير_ماتشو(&متغير الصورة, موضع_حجم_التوقيع, حجم_التوقيع)) {
        أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.توقيع_تنفيذي_ماتشو_فشل());
    };
    دع نهاية_لينك: غير_موقع = بداية_التوقيع + حجم_التوقيع;
    دع حجم_لينك: غير_موقع = نهاية_لينك - بداية_لينك;
    دع حجم_لينك_افتراضي: غير_موقع = حاذ_لأعلى(حجم_لينك, 0x4000);
    لو (!ضع_غ64_صغير_ماتشو(&متغير الصورة, موضع_أمر_لينك + 32, حجم_لينك_افتراضي)
        || !ضع_غ64_صغير_ماتشو(&متغير الصورة, موضع_أمر_لينك + 48, حجم_لينك)) {
        أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح());
    };
    دع التوقيع: متجه غ8;
    طابق ابن_توقيع_أدهوك_ماتشو(&الصورة) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.توقيع_تنفيذي_ماتشو_فشل()); }
    | اختيار.بعض(ت) -> { التوقيع := ت; };
    دع حجم_التوقيع_النهائي: غير_موقع = الطول(التوقيع) مثل غير_موقع;
    لو (حجم_التوقيع_النهائي != حجم_التوقيع) {
        أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.توقيع_تنفيذي_ماتشو_فشل());
    };
    ف := 0;
    بينما (ف < حجم_التوقيع) { ألحق(الصورة, التوقيع[ف]); ف := ف + 1; }
    دع حجم_الصورة_النهائي: غير_موقع = الطول(الصورة) مثل غير_موقع;
    لو (حجم_الصورة_النهائي != نهاية_لينك) {
        أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح());
    };
    أرجع نتيجة_إنهاء_تنفيذي_ماتشو.نجح(الصورة);
}
