عرف معلومات_إزاحة_ماتشو(الإزاحة: &إزاحة_ماتشو, فهرس_الرمز: غير_موقع, خارجي_الرمز: منطقي): اختيار غير_موقع {
    لو (فهرس_الرمز > 0xFFFFFF) { أرجع اختيار.لا_شيء(); };
    دع النوع: متغير غير_موقع = 0; دع متجه_نسبي: متغير منطقي = خطأ; دع طول_الحقل: متغير غير_موقع = 2;
    دع إ: إزاحة_ماتشو = *الإزاحة;
    طابق إ.النوع مع
    | نوع_إزاحة_ماتشو.فرع_ذراع_ستة_وعشرون_بت -> { النوع := 2; متجه_نسبي := صواب; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.صفحة_ذراع_واحد_وعشرون_بت -> { النوع := 3; متجه_نسبي := صواب; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> { النوع := 4; متجه_نسبي := خطأ; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.مطلق_اثنان_وثلاثون_بت -> { النوع := 0; متجه_نسبي := خطأ; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت -> { النوع := 0; متجه_نسبي := خطأ; طول_الحقل := 3; };
    دع المعلومات: متغير غير_موقع = فهرس_الرمز;
