        | اختيار.لا_شيء -> { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); }
        | اختيار.بعض(ن) -> { الاسم := ن; };
