    ألحق_غ32_صغير(&متغير البايتات, 0xB); ألحق_غ32_صغير(&متغير البايتات, 80); ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, ك.عدد_الرموز_المعرفة); ألحق_غ32_صغير(&متغير البايتات, ك.عدد_الرموز_المعرفة); ألحق_غ32_صغير(&متغير البايتات, عدد_الرموز - ك.عدد_الرموز_المعرفة); ألحق_أصفارا(&متغير البايتات, 48);

