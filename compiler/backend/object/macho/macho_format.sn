عام عرف اكتب_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(
    الشفرة: &شفرة_ذراع_أربعة_وستون_مشفرة,
    المرفقات: &مرفقات_كائن_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه ط8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_تسلسل_ماتشو {
    طابق ابن_كائن_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(الشفرة, المرفقات, الهدف, دالة_الدخول, الرموز_الخارجية,
        خريطة_المصادر, أصول_المصدر, التصحيح, تصحيح_الآلة, سياق_الفك, الأنواع, سجل_التخطيط) مع
    | نتيجة_بناء_ماتشو.خطأ(الخطأ) -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(الخطأ); }
    | نتيجة_بناء_ماتشو.نجح(الكائن) -> { أرجع سلسل_كائن_ماتشو_ذراع_أربعة_وستون(&الكائن, الهدف); };
}


عرف ابن_حزمة_دوارف_فارغة_ماتشو(): حزمة_دوارف {
    دع معلومات: متجه ط8 = [];
    دع اختصارات: متجه ط8 = [];
    دع سطور: متجه ط8 = [];
    دع سلاسل_سطور: متجه ط8 = [];
    دع سلاسل: متجه ط8 = [];
    دع عناوين: متجه ط8 = [];
    دع مواقع: متجه ط8 = [];
    دع قوائم_مواقع: متجه ط8 = [];
