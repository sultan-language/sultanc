    لو (!أضف_قسم_دوارف_ماتشو(&متغير الأقسام, اسم_دوارف_معلومات, &متغير حزمة_دوارف_الماتشو.معلومات, 0,
        اختيار.بعض(قسم_عنوان_دوارف.معلومات()), قسم_بيانات_دوارف.معلومات(), &حزمة_دوارف_الماتشو.رقع_العناوين,
