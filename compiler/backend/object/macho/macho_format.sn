عام نوع نتيجة_بناء_ماتشو =
    | نجح بنوع كائن_ماتشو
    | خطأ بنوع خطأ_ماتشو
;

عام نوع نتيجة_تسلسل_ماتشو =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_ماتشو
;

عرف ألحق_ط8(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع الباقي: طبيعي = القيمة % 256;
    دع البايت: ط8 = الباقي مثل ط8;
    ألحق(*البايتات, البايت);
}

عرف ألحق_ط32_صغير(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        ألحق_ط8(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_ط64_صغير(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        ألحق_ط8(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_أصفارا(البايتات: &متغير متجه ط8, العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق_ط8(البايتات, 0);
        ف := ف + 1;
    }
}

عرف حاذ_لأعلى(القيمة: طبيعي, المحاذاة: طبيعي): طبيعي {
    إذا (المحاذاة == 0) { أرجع القيمة; };
    دع الباقي: طبيعي = القيمة % المحاذاة;
    إذا (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + (المحاذاة - الباقي);
}

عرف قوة_اثنين_ماتشو(الأس: طبيعي): اختياري طبيعي {
    إذا (الأس > 20) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الأس) { الناتج := الناتج * 2; ف := ف + 1; }
    أرجع اختياري.موجود(الناتج);
}

عرف ألحق_نص_ماتشو(البايتات: &متغير متجه ط8, النص: نص): فراغ {
    دع الاسم: متجه ط8 = بايتات_من_نص(النص);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الاسم) مثل طبيعي)) { ألحق_ط8(البايتات, الاسم[ف]); ف := ف + 1; }
}

عرف ألحق_اسم_نص(البايتات: &متغير متجه ط8): فراغ { ألحق_نص_ماتشو(البايتات, «__text»); }

عرف ألحق_اسم_ثوابت(البايتات: &متغير متجه ط8): فراغ { ألحق_نص_ماتشو(البايتات, «__const»); }

عرف ألحق_اسم_مقطع_نص(البايتات: &متغير متجه ط8): فراغ { ألحق_نص_ماتشو(البايتات, «__TEXT»); }

عرف اسم_قسم_نص(): متجه ط8 { دع ب: متغير متجه ط8 = []; ألحق_اسم_نص(&متغير ب); أرجع ب; }
عرف اسم_قسم_ثوابت(): متجه ط8 { دع ب: متغير متجه ط8 = []; ألحق_اسم_ثوابت(&متغير ب); أرجع ب; }
عرف اسم_مقطع_نص(): متجه ط8 { دع ب: متغير متجه ط8 = []; ألحق_اسم_مقطع_نص(&متغير ب); أرجع ب; }

عرف بايت_سداسي(القيمة: طبيعي): ط8 {
    إذا (القيمة < 10) { دع الخام: طبيعي = 0x30 + القيمة; أرجع الخام مثل ط8; };
    دع الخام: طبيعي = 0x61 + (القيمة - 10);
    أرجع الخام مثل ط8;
}

عرف ألحق_معرف_سداسي_ماتشو(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع القاسم: متغير طبيعي = 0x1000000000000000;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 16) {
        دع المقسوم: طبيعي = القيمة / القاسم;
        دع الرقم: طبيعي = المقسوم % 16;
        دع البايت: ط8 = بايت_سداسي(الرقم);
        ألحق(*البايتات, البايت);
        إذا (القاسم > 1) { القاسم := القاسم / 16; };
        ف := ف + 1;
    }
}

عرف اسم_رمز_دالة(المعرف: معرف_دالة_منتقاة): متجه ط8 {
    دع البايتات: متغير متجه ط8 = بايتات_من_نص(«_sultanc_fn_»);
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.القيمة);
    أرجع البايتات;
}

عرف اسم_رمز_بيانات(المعرف: معرف_بيانات_ثابتة_كائن): متجه ط8 {
    دع البايتات: متغير متجه ط8 = بايتات_من_نص(«_sultanc_data_»);
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.الدالة.القيمة);
    ألحق_ط8(&متغير البايتات, 0x5F);
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.القيمة);
    أرجع البايتات;
}

عرف اسم_رمز_عام_ماتشو(المعرف: معرف_عام_مسير): متجه ط8 {
    دع البايتات: متغير متجه ط8 = بايتات_من_نص(«_sultanc_global_»);
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.القيمة);
    أرجع البايتات;
}

عرف اسم_رمز_خارجي_ماتشو(الاسم: &متجه ط8): متجه ط8 {
    // Mach-O C ABI prefixes external C symbol names with an underscore.
    دع الناتج: متغير متجه ط8 = [0x5F];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
        ألحق(الناتج, (*الاسم)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اسم_مرجع_رمز_ماتشو(
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): اختياري متجه ط8 {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> { أرجع اختياري.موجود(اسم_رمز_دالة(الدالة)); }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> {
        طابق اسم_رمز_خارجي_كائن_من_جدول(المعرف, الرموز_الخارجية) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الاسم) -> { أرجع اختياري.موجود(اسم_رمز_خارجي_ماتشو(&الاسم)); };
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(البيانات) -> { أرجع اختياري.موجود(اسم_رمز_بيانات(البيانات)); }
    | مرجع_رمز_كائن.عام(العام) -> { أرجع اختياري.موجود(اسم_رمز_عام_ماتشو(العام)); }
    // Bound to std provider functions before emission; never a symbol.
    | مرجع_رمز_كائن.خدمة_تشغيل(_) -> { أرجع اختياري.لا_شيء(); }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> { أرجع اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي); };
}

عرف معرف_دالة_مشفرة_أصغر_أو_يساوي(
    الدوال: &متجه دالة_ذراع_أربعة_وستون_مشفرة,
    أ: طبيعي,
    ب: طبيعي
): منطقي {
    أرجع (*الدوال)[أ].المعرف.القيمة <= (*الدوال)[ب].المعرف.القيمة;
}

عرف رتب_مؤشرات_دوال_مشفرة(الدوال: &متجه دالة_ذراع_أربعة_وستون_مشفرة): متجه طبيعي {
    دع الحالية: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الدوال) مثل طبيعي)) { ألحق(الحالية, ف); ف := ف + 1; }
    دع العدد: طبيعي = الطول(الحالية) مثل طبيعي;
    إذا (العدد < 2) { أرجع الحالية; };
    دع العرض: متغير طبيعي = 1;
    طالما (العرض < العدد) {
        دع التالية: متغير متجه طبيعي = [];
        دع البداية: متغير طبيعي = 0;
        طالما (البداية < العدد) {
            دع الوسط: متغير طبيعي = البداية + العرض;
            إذا (الوسط > العدد) { الوسط := العدد; };
            دع النهاية: متغير طبيعي = الوسط + العرض;
            إذا (النهاية > العدد) { النهاية := العدد; };
            دع يسار: متغير طبيعي = البداية;
            دع يمين: متغير طبيعي = الوسط;
            طالما ((يسار < الوسط) || (يمين < النهاية)) {
                إذا (يمين >= النهاية) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا إذا (يسار >= الوسط) {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                } وإلا إذا (معرف_دالة_مشفرة_أصغر_أو_يساوي(الدوال, الحالية[يسار], الحالية[يمين])) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                };
            }
            البداية := النهاية;
        }
        الحالية := التالية;
        إذا (العرض > (العدد / 2)) { العرض := العدد; } وإلا { العرض := العرض * 2; };
    }
    أرجع الحالية;
}

عرف معرف_بيانات_ثابتة_أصغر_أو_يساوي(
    البيانات: &متجه بيانات_ثابتة_كائن,
    أ: طبيعي,
    ب: طبيعي
): منطقي {
    دع معرف_أ: معرف_بيانات_ثابتة_كائن = (*البيانات)[أ].المعرف;
    دع معرف_ب: معرف_بيانات_ثابتة_كائن = (*البيانات)[ب].المعرف;
    إذا (معرف_أ.الدالة.القيمة < معرف_ب.الدالة.القيمة) { أرجع صواب; };
    إذا (معرف_أ.الدالة.القيمة > معرف_ب.الدالة.القيمة) { أرجع خطأ; };
    أرجع معرف_أ.القيمة <= معرف_ب.القيمة;
}

عرف رتب_مؤشرات_بيانات_ثابتة_ماتشو(البيانات: &متجه بيانات_ثابتة_كائن): متجه طبيعي {
    دع الحالية: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البيانات) مثل طبيعي)) { ألحق(الحالية, ف); ف := ف + 1; }
    دع العدد: طبيعي = الطول(الحالية) مثل طبيعي;
    إذا (العدد < 2) { أرجع الحالية; };
    دع العرض: متغير طبيعي = 1;
    طالما (العرض < العدد) {
        دع التالية: متغير متجه طبيعي = [];
        دع البداية: متغير طبيعي = 0;
        طالما (البداية < العدد) {
            دع الوسط: متغير طبيعي = البداية + العرض;
            إذا (الوسط > العدد) { الوسط := العدد; };
            دع النهاية: متغير طبيعي = الوسط + العرض;
            إذا (النهاية > العدد) { النهاية := العدد; };
            دع يسار: متغير طبيعي = البداية;
            دع يمين: متغير طبيعي = الوسط;
            طالما ((يسار < الوسط) || (يمين < النهاية)) {
                إذا (يمين >= النهاية) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا إذا (يسار >= الوسط) {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                } وإلا إذا (معرف_بيانات_ثابتة_أصغر_أو_يساوي(البيانات, الحالية[يسار], الحالية[يمين])) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                };
            }
            البداية := النهاية;
        }
        الحالية := التالية;
        إذا (العرض > (العدد / 2)) { العرض := العدد; } وإلا { العرض := العرض * 2; };
    }
    أرجع الحالية;
}

عرف اسم_ماتشو_أصغر(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    دع طول_س: طبيعي = الطول(*أ) مثل طبيعي;
    دع طول_ص: طبيعي = الطول(*ب) مثل طبيعي;
    دع الحد: متغير طبيعي = طول_س;
    إذا (طول_ص < الحد) { الحد := طول_ص; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحد) {
        إذا ((*أ)[ف] < (*ب)[ف]) { أرجع صواب; };
        إذا ((*أ)[ف] > (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع طول_س < طول_ص;
}

عرف ابحث_رمز_ماتشو(الرموز: &متجه رمز_ماتشو, المرجع: &مرجع_رمز_كائن): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        دع مرجع_الحالي: &مرجع_رمز_كائن = &(*الرموز)[ف].المرجع;
        إذا (مرجعا_رمز_كائن_متساويان(مرجع_الحالي, المرجع)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف هل_موضع_رمز_ماتشو_معرف(الموضع: موضع_رمز_ماتشو): منطقي {
    طابق الموضع مع
    | موضع_رمز_ماتشو.معرف_في_قسم(_, _) -> { أرجع صواب; }
    | موضع_رمز_ماتشو.غير_معرف -> { أرجع خطأ; };
}

عرف أضف_رمز_ماتشو_إن_غاب(
    الرموز: &متغير متجه رمز_ماتشو,
    المرجع: مرجع_رمز_كائن,
    الموضع: موضع_رمز_ماتشو,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): نتيجة منطقي, خطأ_ماتشو {
    طابق ابحث_رمز_ماتشو(الرموز, &المرجع) مع
    | اختياري.موجود(الفهرس) -> {
        دع القديم_معرف: منطقي = هل_موضع_رمز_ماتشو_معرف((*الرموز)[الفهرس].الموضع);
        دع الجديد_معرف: منطقي = هل_موضع_رمز_ماتشو_معرف(الموضع);
        إذا (القديم_معرف && الجديد_معرف) {
            أرجع نتيجة.نجح(خطأ);
        };
        إذا ((!القديم_معرف) && الجديد_معرف) {
            (*الرموز)[الفهرس].الموضع := الموضع;
        };
        أرجع نتيجة.نجح(صواب);
    }
    | اختياري.لا_شيء -> { };
    طابق اسم_مرجع_رمز_ماتشو(&المرجع, الهدف, الرموز_الخارجية) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ماتشو.رمز_تشغيل_غير_متاح()); }
    | اختياري.موجود(الاسم) -> {
        إذا (هل_موضع_رمز_ماتشو_معرف(الموضع)) {
            دع الفهرس: متغير طبيعي = 0;
            طالما (الفهرس < (الطول(*الرموز) مثل طبيعي)) {
                إذا (هل_موضع_رمز_ماتشو_معرف((*الرموز)[الفهرس].الموضع)
                    && اسما_رمز_خارجي_كائن_متساويان(&(*الرموز)[الفهرس].الاسم, &الاسم)) {
                    أرجع نتيجة.خطأ(خطأ_ماتشو.رمز_مكرر());
                };
                الفهرس := الفهرس + 1;
            }
        };
        دع الرمز: رمز_ماتشو = {
            المرجع: المرجع,
            الاسم: الاسم,
            الموضع: الموضع
        };
        ألحق(*الرموز, الرمز);
        أرجع نتيجة.نجح(صواب);
    };
}

عرف انسخ_موضع_رمز_ماتشو(الموضع: &موضع_رمز_ماتشو): موضع_رمز_ماتشو {
    طابق *الموضع مع
    | موضع_رمز_ماتشو.معرف_في_قسم(القسم, الإزاحة) -> {
        أرجع موضع_رمز_ماتشو.معرف_في_قسم(القسم, الإزاحة);
    }
    | موضع_رمز_ماتشو.غير_معرف -> { أرجع موضع_رمز_ماتشو.غير_معرف(); };
}

عرف انسخ_اسم_رمز_ماتشو(الاسم: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
        ألحق(الناتج, (*الاسم)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف انسخ_رمز_ماتشو(الرمز: &رمز_ماتشو): رمز_ماتشو {
    دع المرجع: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&(*الرمز).المرجع);
    دع الاسم: متجه ط8 = انسخ_اسم_رمز_ماتشو(&(*الرمز).الاسم);
    دع الموضع: موضع_رمز_ماتشو = انسخ_موضع_رمز_ماتشو(&(*الرمز).الموضع);
    دع الناتج: رمز_ماتشو = { المرجع: المرجع, الاسم: الاسم, الموضع: الموضع };
    أرجع الناتج;
}

عرف رتب_مؤشرات_رموز_ماتشو_بالاسم(
    الرموز: &متجه رمز_ماتشو,
    المؤشرات: &متجه طبيعي
): متجه طبيعي {
    دع الحالية: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المؤشرات) مثل طبيعي)) {
        ألحق(الحالية, (*المؤشرات)[ف]);
        ف := ف + 1;
    }
    دع العدد: طبيعي = الطول(الحالية) مثل طبيعي;
    إذا (العدد < 2) { أرجع الحالية; };
    دع العرض: متغير طبيعي = 1;
    طالما (العرض < العدد) {
        دع التالية: متغير متجه طبيعي = [];
        دع البداية: متغير طبيعي = 0;
        طالما (البداية < العدد) {
            دع الوسط: متغير طبيعي = البداية + العرض;
            إذا (الوسط > العدد) { الوسط := العدد; };
            دع النهاية: متغير طبيعي = الوسط + العرض;
            إذا (النهاية > العدد) { النهاية := العدد; };
            دع يسار: متغير طبيعي = البداية;
            دع يمين: متغير طبيعي = الوسط;
            طالما ((يسار < الوسط) || (يمين < النهاية)) {
                إذا (يمين >= النهاية) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا إذا (يسار >= الوسط) {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                } وإلا إذا (!اسم_ماتشو_أصغر(
                    &(*الرموز)[الحالية[يمين]].الاسم,
                    &(*الرموز)[الحالية[يسار]].الاسم
                )) {
                    ألحق(التالية, الحالية[يسار]); يسار := يسار + 1;
                } وإلا {
                    ألحق(التالية, الحالية[يمين]); يمين := يمين + 1;
                };
            }
            البداية := النهاية;
        }
        الحالية := التالية;
        إذا (العرض > (العدد / 2)) { العرض := العدد; } وإلا { العرض := العرض * 2; };
    }
    أرجع الحالية;
}

عرف رتب_رموز_ماتشو_المعرفة_أولا(الرموز: &متجه رمز_ماتشو): متجه رمز_ماتشو {
    دع المعرفة: متغير متجه طبيعي = [];
    دع غير_المعرفة: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        إذا (هل_موضع_رمز_ماتشو_معرف((*الرموز)[ف].الموضع)) {
            ألحق(المعرفة, ف);
        } وإلا {
            ألحق(غير_المعرفة, ف);
        };
        ف := ف + 1;
    }

    // Mach-O keeps defined and undefined groups separate and requires the
    // external/undefined name order to be lexicographic. Sort lightweight
    // indices in O(n log n), then copy each owned symbol exactly once.
    دع المعرفة_المرتبة: متجه طبيعي = رتب_مؤشرات_رموز_ماتشو_بالاسم(الرموز, &المعرفة);
    دع غير_المعرفة_المرتبة: متجه طبيعي = رتب_مؤشرات_رموز_ماتشو_بالاسم(الرموز, &غير_المعرفة);

    دع الناتج: متغير متجه رمز_ماتشو = [];
    ف := 0;
    طالما (ف < (الطول(المعرفة_المرتبة) مثل طبيعي)) {
        دع الرمز: رمز_ماتشو = انسخ_رمز_ماتشو(&(*الرموز)[المعرفة_المرتبة[ف]]);
        ألحق(الناتج, الرمز);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(غير_المعرفة_المرتبة) مثل طبيعي)) {
        دع الرمز: رمز_ماتشو = انسخ_رمز_ماتشو(&(*الرموز)[غير_المعرفة_المرتبة[ف]]);
        ألحق(الناتج, الرمز);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أس_محاذاة_ماتشو(المحاذاة: طبيعي): اختياري طبيعي {
    إذا (المحاذاة == 0) { أرجع اختياري.لا_شيء(); };
    دع القوة: متغير طبيعي = 1;
    دع الأس: متغير طبيعي = 0;
    طالما ((القوة < المحاذاة) && (الأس < 20)) {
        القوة := القوة * 2;
        الأس := الأس + 1;
    }
    إذا (القوة != المحاذاة) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الأس);
}

عرف محاذاة_حقل_إزاحة_مشترك(النوع: نوع_إزاحة_رمزية_كائن): طبيعي {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { أرجع 8; }
    | _ -> { أرجع 4; };
}

عرف ألحق_كلمة_نص(البيانات: &متغير متجه ط8, الكلمة: كلمة_ذراع_أربعة_وستون_مشفرة): منطقي {
    إذا (الكلمة.القيمة > 0xFFFFFFFF) { أرجع خطأ; };
    ألحق_ط32_صغير(البيانات, الكلمة.القيمة);
    أرجع صواب;
}

عرف رتب_إزاحات_ماتشو(الإزاحات: &متجه إزاحة_ماتشو): متجه إزاحة_ماتشو {
    دع الحالية: متغير متجه إزاحة_ماتشو = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الإزاحات) مثل طبيعي)) {
        ألحق(الحالية, (*الإزاحات)[ف]);
        ف := ف + 1;
    }
    دع العدد: طبيعي = الطول(الحالية) مثل طبيعي;
    إذا (العدد < 2) { أرجع الحالية; };
    // Bottom-up merge sort between two buffers allocated once; every pass
    // overwrites the whole destination, so no pass allocates.
    دع التالية: متغير متجه إزاحة_ماتشو = [];
    ف := 0;
    طالما (ف < العدد) {
        ألحق(التالية, الحالية[ف]);
        ف := ف + 1;
    }
    دع العرض: متغير طبيعي = 1;
    طالما (العرض < العدد) {
        دع المكتوب: متغير طبيعي = 0;
        دع البداية: متغير طبيعي = 0;
        طالما (البداية < العدد) {
            دع الوسط: متغير طبيعي = البداية + العرض;
            إذا (الوسط > العدد) { الوسط := العدد; };
            دع النهاية: متغير طبيعي = الوسط + العرض;
            إذا (النهاية > العدد) { النهاية := العدد; };
            دع يسار: متغير طبيعي = البداية;
            دع يمين: متغير طبيعي = الوسط;
            طالما ((يسار < الوسط) || (يمين < النهاية)) {
                إذا (يمين >= النهاية) {
                    التالية[المكتوب] := الحالية[يسار]; يسار := يسار + 1;
                } وإلا إذا (يسار >= الوسط) {
                    التالية[المكتوب] := الحالية[يمين]; يمين := يمين + 1;
                } وإلا إذا (الحالية[يسار].إزاحة_بايت >= الحالية[يمين].إزاحة_بايت) {
                    التالية[المكتوب] := الحالية[يسار]; يسار := يسار + 1;
                } وإلا {
                    التالية[المكتوب] := الحالية[يمين]; يمين := يمين + 1;
                };
                المكتوب := المكتوب + 1;
            }
            البداية := النهاية;
        }
        دع المؤقت: متجه إزاحة_ماتشو = الحالية;
        الحالية := التالية;
        التالية := المؤقت;
        إذا (العرض > (العدد / 2)) { العرض := العدد; } وإلا { العرض := العرض * 2; };
    }
    أرجع الحالية;
}

عرف نوع_إزاحة_ماتشو_من_مشترك(النوع: نوع_إزاحة_رمزية_كائن): اختياري نوع_إزاحة_ماتشو {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت -> { أرجع اختياري.موجود(نوع_إزاحة_ماتشو.فرع_ذراع_ستة_وعشرون_بت()); }
    | نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت -> { أرجع اختياري.موجود(نوع_إزاحة_ماتشو.صفحة_ذراع_واحد_وعشرون_بت()); }
    | نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> {
        أرجع اختياري.موجود(نوع_إزاحة_ماتشو.إزاحة_صفحة_ذراع_اثنا_عشر_بت()); }
    | نوع_إزاحة_رمزية_كائن.صفحة_تحميل_جوت_ذراع_واحد_وعشرون_بت -> {
        أرجع اختياري.موجود(نوع_إزاحة_ماتشو.صفحة_تحميل_جوت_ذراع_واحد_وعشرون_بت()); }
    | نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_تحميل_جوت_ذراع_اثنا_عشر_بت -> {
        أرجع اختياري.موجود(نوع_إزاحة_ماتشو.إزاحة_صفحة_تحميل_جوت_ذراع_اثنا_عشر_بت()); }
    | نوع_إزاحة_رمزية_كائن.تحميل_جوت_إكس_نسبي_اثنان_وثلاثون -> {
        أرجع اختياري.لا_شيء();
    }
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { أرجع اختياري.موجود(نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت()); };
}

عرف حجم_حقل_إزاحة_مشترك(النوع: نوع_إزاحة_رمزية_كائن): طبيعي {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { أرجع 8; }
    | _ -> { أرجع 4; };
}

عرف ابحث_موضع_دالة_ماتشو(
    المواضع: &متجه موضع_دالة_دوارف,
    الدالة: معرف_دالة_منتقاة
): اختياري طبيعي {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*المواضع) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        دع الموجود: طبيعي = (*المواضع)[الوسط].الدالة.القيمة;
        إذا (الموجود == الدالة.القيمة) { أرجع اختياري.موجود(الوسط); };
        إذا (الموجود < الدالة.القيمة) { البداية := الوسط + 1; }
        وإلا { النهاية := الوسط; };
    }
    أرجع اختياري.لا_شيء();
}

عرف اسم_دخول_ماتشو(): متجه ط8 {
    // _main
    دع الاسم: متجه ط8 = بايتات_من_نص(«_main»);
    أرجع الاسم;
}

عرف طبق_اسم_دخول_ماتشو(
    الرموز: &متغير متجه رمز_ماتشو,
    دالة_الدخول: اختياري معرف_دالة_منتقاة
): اختياري خطأ_ماتشو {
    طابق دالة_الدخول مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الدخول) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
            دع المرجع_الحالي: مرجع_رمز_كائن = (*الرموز)[ف].المرجع;
            طابق المرجع_الحالي مع
            | مرجع_رمز_كائن.دالة(الدالة) -> {
                إذا (معرفا_دالة_منتقاة_متساويان(الدالة, الدخول)) {
                    دع الموضع_الحالي: موضع_رمز_ماتشو = (*الرموز)[ف].الموضع;
                    طابق الموضع_الحالي مع
                    | موضع_رمز_ماتشو.غير_معرف -> {
                        أرجع اختياري.موجود(خطأ_ماتشو.رمز_دخول_مفقود(الدخول));
                    }
                    | موضع_رمز_ماتشو.معرف_في_قسم(القسم, الموضع_داخل_القسم) -> {
                        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدخول);
                        دع الموضع: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(القسم, الموضع_داخل_القسم);
                        دع الاسم: متجه ط8 = اسم_دخول_ماتشو();
                        دع الجديد: رمز_ماتشو = {
                            المرجع: المرجع,
                            الاسم: الاسم,
                            الموضع: الموضع
                        };
                        (*الرموز)[ف] := الجديد;
                        أرجع اختياري.لا_شيء();
                    };
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع اختياري.موجود(خطأ_ماتشو.رمز_دخول_مفقود(الدخول));
    };
}

عرف قسم_رقعة_دوارف_يساوي(أ: قسم_عنوان_دوارف, ب: قسم_عنوان_دوارف): منطقي {
    طابق أ مع
    | قسم_عنوان_دوارف.معلومات -> { طابق ب مع | قسم_عنوان_دوارف.معلومات -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.سطور -> { طابق ب مع | قسم_عنوان_دوارف.سطور -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.مواقع -> { طابق ب مع | قسم_عنوان_دوارف.مواقع -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.إطار -> { طابق ب مع | قسم_عنوان_دوارف.إطار -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.نطاقات_عناوين -> { طابق ب مع | قسم_عنوان_دوارف.نطاقات_عناوين -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.عناوين -> { طابق ب مع | قسم_عنوان_دوارف.عناوين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.قوائم_مواقع -> { طابق ب مع | قسم_عنوان_دوارف.قوائم_مواقع -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_عنوان_دوارف.قوائم_نطاقات -> { طابق ب مع | قسم_عنوان_دوارف.قوائم_نطاقات -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; };
}

عرف قسم_بيانات_دوارف_يساوي_ماتشو(أ: قسم_بيانات_دوارف, ب: قسم_بيانات_دوارف): منطقي {
    طابق أ مع
    | قسم_بيانات_دوارف.معلومات -> { طابق ب مع | قسم_بيانات_دوارف.معلومات -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.اختصارات -> { طابق ب مع | قسم_بيانات_دوارف.اختصارات -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.سطور -> { طابق ب مع | قسم_بيانات_دوارف.سطور -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.سلاسل_سطور -> { طابق ب مع | قسم_بيانات_دوارف.سلاسل_سطور -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.سلاسل -> { طابق ب مع | قسم_بيانات_دوارف.سلاسل -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.عناوين -> { طابق ب مع | قسم_بيانات_دوارف.عناوين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.مواقع -> { طابق ب مع | قسم_بيانات_دوارف.مواقع -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.قوائم_مواقع -> { طابق ب مع | قسم_بيانات_دوارف.قوائم_مواقع -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.إطار -> { طابق ب مع | قسم_بيانات_دوارف.إطار -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.نطاقات_عناوين -> { طابق ب مع | قسم_بيانات_دوارف.نطاقات_عناوين -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.قوائم_نطاقات -> { طابق ب مع | قسم_بيانات_دوارف.قوائم_نطاقات -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.أسماء_عامة -> { طابق ب مع | قسم_بيانات_دوارف.أسماء_عامة -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; }
    | قسم_بيانات_دوارف.فهرس_أسماء -> { طابق ب مع | قسم_بيانات_دوارف.فهرس_أسماء -> { أرجع صواب;
        } | _ -> { أرجع خطأ; }; };
}

عرف أقسام_بيانات_دوارف_ماتشو_الفعالة(الحزمة: &حزمة_دوارف): متجه قسم_بيانات_دوارف {
    دع الأقسام: متغير متجه قسم_بيانات_دوارف = [];
    ألحق(الأقسام, قسم_بيانات_دوارف.معلومات());
    ألحق(الأقسام, قسم_بيانات_دوارف.اختصارات());
    ألحق(الأقسام, قسم_بيانات_دوارف.سطور());
    // DWARF policy owns version selection. Mach-O only maps sections that the
    // selected DWARF serializer actually materialized.
    إذا (الطول((*الحزمة).سلاسل_سطور) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.سلاسل_سطور()); };
    إذا (الطول((*الحزمة).سلاسل) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.سلاسل()); };
    إذا (الطول((*الحزمة).عناوين) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.عناوين()); };
    إذا (الطول((*الحزمة).مواقع) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.مواقع()); };
    إذا (الطول((*الحزمة).قوائم_مواقع) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.قوائم_مواقع()); };
    إذا (الطول((*الحزمة).إطار) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.إطار()); };
    إذا (الطول((*الحزمة).نطاقات_عناوين) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.نطاقات_عناوين()); };
    إذا (الطول((*الحزمة).قوائم_نطاقات) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.قوائم_نطاقات()); };
    إذا (الطول((*الحزمة).أسماء_عامة) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.أسماء_عامة()); };
    إذا (الطول((*الحزمة).فهرس_أسماء) > 0) { ألحق(الأقسام, قسم_بيانات_دوارف.فهرس_أسماء()); };
    أرجع الأقسام;
}

عرف ترتيب_هدف_قسم_دوارف_ماتشو(
    الأقسام_الفعالة: &متجه قسم_بيانات_دوارف,
    بداية_ترتيب_دوارف: طبيعي,
    الهدف: قسم_بيانات_دوارف
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأقسام_الفعالة) مثل طبيعي)) {
        إذا (قسم_بيانات_دوارف_يساوي_ماتشو((*الأقسام_الفعالة)[ف],
            الهدف)) { أرجع اختياري.موجود(بداية_ترتيب_دوارف + ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف نوع_إزاحة_دوارف_ماتشو_للعرض(العرض: طبيعي): اختياري نوع_إزاحة_ماتشو {
    إذا (العرض == 4) { أرجع اختياري.موجود(نوع_إزاحة_ماتشو.مطلق_اثنان_وثلاثون_بت()); };
    إذا (العرض == 8) { أرجع اختياري.موجود(نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت()); };
    أرجع اختياري.لا_شيء();
}

عرف اكتب_إضافة_دوارف_ماتشو(البيانات: &متغير متجه ط8, الموضع: طبيعي, العرض: طبيعي,
    القيمة: طبيعي): منطقي {
    إذا ((العرض != 4 && العرض != 8) || الموضع + العرض > (الطول(*البيانات) مثل طبيعي)) { أرجع خطأ; };
    دع ح: متغير طبيعي = القيمة; دع ف: متغير طبيعي = 0;
    طالما (ف < العرض) {
        دع موضع_الكتابة: طبيعي = الموضع + ف;
        (*البيانات)[موضع_الكتابة] := (ح % 256) مثل ط8;
        ح := ح / 256;
        ف := ف + 1;
    }
    أرجع صواب;
}

// Mach-O owns MH_OBJECT relocation encoding. DWARF contributes only a
// symbolic text/data section reference and the field position.
عرف أضف_قسم_دوارف_ماتشو(
    الأقسام: &متغير متجه قسم_ماتشو,
    الاسم: متجه ط8,
    البيانات: &متغير متجه ط8,
    المحاذاة_الأسية: طبيعي,
    نوع_قسم_العنوان: اختياري قسم_عنوان_دوارف,
    نوع_قسم_البيانات: قسم_بيانات_دوارف,
    رقع_العناوين: &متجه رقعة_عنوان_دوارف,
    رقع_الأقسام: &متجه رقعة_قسم_دوارف,
    ترتيب_قسم_النص: طبيعي,
    ترتيب_قسم_البيانات: طبيعي,
    بداية_ترتيب_دوارف: طبيعي,
    الأقسام_الفعالة: &متجه قسم_بيانات_دوارف
): منطقي {
    دع اسم_المقطع: متجه ط8 = بايتات_من_نص(«__DWARF»);
    دع الإزاحات: متغير متجه إزاحة_ماتشو = [];
    دع ف: متغير طبيعي = 0;
    طابق نوع_قسم_العنوان مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(قسم_العنوان) -> {
        طالما (ف < (الطول(*رقع_العناوين) مثل طبيعي)) {
            دع الرقعة: رقعة_عنوان_دوارف = (*رقع_العناوين)[ف];
            إذا (قسم_رقعة_دوارف_يساوي(الرقعة.القسم, قسم_العنوان)) {
                دع ترتيب_الهدف: متغير طبيعي = ترتيب_قسم_النص;
                طابق الرقعة.المرجع.القاعدة مع
                | قاعدة_عنوان_دوارف.نص -> { ترتيب_الهدف := ترتيب_قسم_النص; }
                | قاعدة_عنوان_دوارف.بيانات -> { ترتيب_الهدف := ترتيب_قسم_البيانات; };
                إذا (ترتيب_الهدف == 0 || !اكتب_إضافة_دوارف_ماتشو(البيانات, الرقعة.الموضع, الرقعة.العرض,
                    الرقعة.المرجع.إزاحة_بايت)) { أرجع خطأ; };
                طابق نوع_إزاحة_دوارف_ماتشو_للعرض(الرقعة.العرض) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(نوع_الإزاحة) -> {
                    دع هدف_القسم: هدف_إزاحة_ماتشو = هدف_إزاحة_ماتشو.قسم_محلي(ترتيب_الهدف);
                    دع الإزاحة: إزاحة_ماتشو = { إزاحة_بايت: الرقعة.الموضع, النوع: نوع_الإزاحة,
                        الهدف: هدف_القسم, الإضافة: 0 };
                    ألحق(الإزاحات, الإزاحة);
                };
            };
            ف := ف + 1;
        }
    };
    ف := 0;
    طالما (ف < (الطول(*رقع_الأقسام) مثل طبيعي)) {
        دع الرقعة: رقعة_قسم_دوارف = (*رقع_الأقسام)[ف];
        إذا (قسم_بيانات_دوارف_يساوي_ماتشو(الرقعة.القسم, نوع_قسم_البيانات)) {
            // DW_FORM_sec_offset and the other DWARF section references are
            // offsets from the beginning of their target DWARF section. Mach-O
            // does not need an ARM64_RELOC_UNSIGNED edge for these fields: adding
            // the final VM address would turn a DWARF32 section offset into an
            // absolute address above 4 GiB and make the executable link overflow.
            // Keep relocations only for true text/data address fields above.
            طابق ترتيب_هدف_قسم_دوارف_ماتشو(
                الأقسام_الفعالة,
                بداية_ترتيب_دوارف,
                الرقعة.الهدف
            ) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(_) -> {
                إذا (!اكتب_إضافة_دوارف_ماتشو(
                    البيانات,
                    الرقعة.الموضع,
                    الرقعة.العرض,
                    الرقعة.الإزاحة
                )) {
                    أرجع خطأ;
                };
            };
        };
        ف := ف + 1;
    }
    دع بيانات_القسم: متجه ط8 = انسخ_بايتات(البيانات);
    دع الإزاحات_المرتبة: متجه إزاحة_ماتشو = رتب_إزاحات_ماتشو(&الإزاحات);
    دع القسم: قسم_ماتشو = {
        الاسم: الاسم, اسم_المقطع: اسم_المقطع, البيانات: بيانات_القسم,
        المحاذاة_الأسية: المحاذاة_الأسية, الأعلام: 0x02000000,
        الإزاحات: الإزاحات_المرتبة
    };
    ألحق(*الأقسام, القسم);
    أرجع صواب;
}


عام عرف ابن_كائن_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(
    الشفرة: &شفرة_ذراع_أربعة_وستون_مشفرة,
    المرفقات: &مرفقات_كائن_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه ط8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_بناء_ماتشو {
    دع معرف_الشفرة: معرف_هدف = (*الشفرة).الهدف;
    دع معرف_الهدف: معرف_هدف = (*الهدف).المعرف;
    إذا (!معرفا_هدف_متساويان(معرف_الشفرة,
        معرف_الهدف)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق(معرف_الشفرة)); };
    // This writer serializes only ARM64 instructions and relocations.
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | _ -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق(معرف_الهدف)); };
    طابق (*الهدف).صيغة_الكائن مع
    | صيغة_كائن_هدف.ماتشو -> { }
    | _ -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق(معرف_الهدف)); };

    دع مؤشرات_الدوال: متجه طبيعي = رتب_مؤشرات_دوال_مشفرة(&(*الشفرة).الدوال);
    دع النص: متغير متجه ط8 = [];
    دع مواضع_دوارف: متغير متجه موضع_دالة_دوارف = [];
    دع أصول_آلة_دوارف: متغير متجه مدى_شفرة_آلة_بأصل = [];
    دع الرموز: متغير متجه رمز_ماتشو = [];
    دع الإزاحات: متغير متجه إزاحة_ماتشو = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(مؤشرات_الدوال) مثل طبيعي)) {
        دع فهرس_الدالة: طبيعي = مؤشرات_الدوال[ف];
        دع مرجع_الدالة: &دالة_ذراع_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[فهرس_الدالة];
        دع بداية_الدالة: طبيعي = الطول(النص) مثل طبيعي;
        دع معرف_الدالة: معرف_دالة_منتقاة = (*مرجع_الدالة).المعرف;
        إذا (ف > 0) {
            دع موضع_السابق: طبيعي = ف - 1;
            دع فهرس_السابق: طبيعي = مؤشرات_الدوال[موضع_السابق];
            دع معرف_السابق: معرف_دالة_منتقاة = (*الشفرة).الدوال[فهرس_السابق].المعرف;
            إذا (معرفا_دالة_منتقاة_متساويان(معرف_السابق, معرف_الدالة)) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.دالة_مكررة(معرف_الدالة));
            };
        };
        دع مرجع_الدالة_الرمزي: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_الدالة);
        دع موضع_الدالة: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(0, بداية_الدالة);
        دع اسم_الدالة: متجه ط8 = اسم_رمز_دالة(معرف_الدالة);
        دع رمز_الدالة: رمز_ماتشو = {
            المرجع: مرجع_الدالة_الرمزي,
            الاسم: اسم_الدالة,
            الموضع: موضع_الدالة
        };
        ألحق(الرموز, رمز_الدالة);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*مرجع_الدالة).الكلمات) مثل طبيعي)) {
            إذا (!ألحق_كلمة_نص(&متغير النص,
                (*مرجع_الدالة).الكلمات[ك])) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.كلمة_تعليمة_خارج_نطاق_ط32(معرف_الدالة)); };
            ك := ك + 1;
        }
        دع نهاية_الدالة: طبيعي = الطول(النص) مثل طبيعي;
        دع حجم_دالة_دوارف: طبيعي = نهاية_الدالة - بداية_الدالة;
        دع اسم_ربط_الدالة_دوارف: متجه ط8 = اسم_رمز_دالة(معرف_الدالة);
        دع موضع_دوارف: موضع_دالة_دوارف = {
            الدالة: معرف_الدالة,
            إزاحة_بايت: بداية_الدالة,
            حجم_بايت: حجم_دالة_دوارف,
            اسم_الربط: اسم_ربط_الدالة_دوارف
        };
        ألحق(مواضع_دوارف, موضع_دوارف);
        دع أصل_ف: متغير طبيعي = 0;
        طالما (أصل_ف < (الطول((*مرجع_الدالة).أصول_الآلة) مثل طبيعي)) {
            ألحق(أصول_آلة_دوارف, (*مرجع_الدالة).أصول_الآلة[أصل_ف]);
            أصل_ف := أصل_ف + 1;
        }
        ف := ف + 1;
    }

    // Mach-O LC_MAIN starts at _main after dyld has invoked all module
    // initializers. Keep the source entry's separate symbol and code so calls
    // and pointers to the original function still address the language entry.
    طابق (*الشفرة).دخول_عملية_داروين مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        دع بداية_البدء: طبيعي = الطول(النص) مثل طبيعي;
        دع معرف_الرئيسي: مرجع_رمز_كائن = مرجع_رمز_كائن.رمز_خارجي(الدخول.رمز_الدخول);
        دع موضع_الرئيسي: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(0, بداية_البدء);
        طابق أضف_رمز_ماتشو_إن_غاب(
            &متغير الرموز, معرف_الرئيسي, موضع_الرئيسي, الهدف, الرموز_الخارجية
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
        | نتيجة.نجح(أضيف) -> {
            إذا (!أضيف) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
        };
        دع فهرس_الكلمة: متغير طبيعي = 0;
        طالما (فهرس_الكلمة < (الطول(الدخول.الكلمات) مثل طبيعي)) {
            إذا (!ألحق_كلمة_نص(&متغير النص, الدخول.الكلمات[فهرس_الكلمة])) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة());
            };
            فهرس_الكلمة := فهرس_الكلمة + 1;
        }
        دع حجم_البدء: طبيعي = (الطول(الدخول.الكلمات) مثل طبيعي) * 4;
        دع فهرس_الإزاحة: متغير طبيعي = 0;
        طالما (فهرس_الإزاحة < (الطول(الدخول.الإزاحات) مثل طبيعي)) {
            دع التصحيح: &إزاحة_دخول_داروين_ذراع = &الدخول.الإزاحات[فهرس_الإزاحة];
            إذا (((*التصحيح).إزاحة_بايت % 4) != 0
                || (*التصحيح).إزاحة_بايت > حجم_البدء
                || 4 > حجم_البدء - (*التصحيح).إزاحة_بايت) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة());
            };
            دع نوع_الرقعة: نوع_إزاحة_ماتشو;
            طابق نوع_إزاحة_ماتشو_من_مشترك((*التصحيح).النوع) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.نوع_إزاحة_غير_مدعوم());
            }
            | اختياري.موجود(النوع) -> { نوع_الرقعة := النوع; };
            دع التصحيح_الموضع: إزاحة_ماتشو = {
                إزاحة_بايت: بداية_البدء + (*التصحيح).إزاحة_بايت,
                النوع: نوع_الرقعة,
                الهدف: هدف_إزاحة_ماتشو.رمز(انسخ_مرجع_رمز_كائن(&(*التصحيح).الرمز)),
                الإضافة: 0
            };
            ألحق(الإزاحات, التصحيح_الموضع);
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
    };

    دع الثوابت: متغير متجه ط8 = [];
    دع أقوى_محاذاة_ثوابت: متغير طبيعي = 1;
    دع مؤشرات_البيانات_الثابتة: متجه طبيعي = رتب_مؤشرات_بيانات_ثابتة_ماتشو(&(*المرفقات).البيانات_الثابتة);
    دع ب: متغير طبيعي = 0;
    طالما (ب < (الطول(مؤشرات_البيانات_الثابتة) مثل طبيعي)) {
        دع فهرس_البيانات: طبيعي = مؤشرات_البيانات_الثابتة[ب];
        دع مرجع_البيانات: &بيانات_ثابتة_كائن = &(*المرفقات).البيانات_الثابتة[فهرس_البيانات];
        إذا (!(*مرجع_البيانات).للقراءة_فقط) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.نوع_إزاحة_غير_مدعوم()); };
        دع محاذاة: متغير طبيعي = (*مرجع_البيانات).المحاذاة;
        إذا (محاذاة == 0) { محاذاة := 1; };
        طابق أس_محاذاة_ماتشو(محاذاة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
        | اختياري.موجود(_) -> { };
        إذا (محاذاة > أقوى_محاذاة_ثوابت) { أقوى_محاذاة_ثوابت := محاذاة; };
        دع حجم_الثوابت_الحالي: طبيعي = الطول(الثوابت) مثل طبيعي;
        دع موضع_البيانات: طبيعي = حاذ_لأعلى(حجم_الثوابت_الحالي, محاذاة);
        دع الحالي: طبيعي = حجم_الثوابت_الحالي;
        إذا (موضع_البيانات > الحالي) { ألحق_أصفارا(&متغير الثوابت, موضع_البيانات - الحالي); };
        دع معرف_البيانات: معرف_بيانات_ثابتة_كائن = (*مرجع_البيانات).المعرف;
        إذا (ب > 0) {
            دع موضع_السابق: طبيعي = ب - 1;
            دع فهرس_السابق: طبيعي = مؤشرات_البيانات_الثابتة[موضع_السابق];
            دع معرف_السابق: معرف_بيانات_ثابتة_كائن = (*المرفقات).البيانات_الثابتة[فهرس_السابق].المعرف;
            إذا (معرفا_بيانات_ثابتة_كائن_متساويان(&معرف_السابق, &معرف_البيانات)) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.بيانات_ثابتة_مكررة(معرف_البيانات.القيمة));
            };
        };
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.بيانات_ثابتة(معرف_البيانات);
        دع الموضع: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(1, موضع_البيانات);
        دع اسم_البيانات: متجه ط8 = اسم_رمز_بيانات(معرف_البيانات);
        دع رمز_البيانات: رمز_ماتشو = {
            المرجع: المرجع,
            الاسم: اسم_البيانات,
            الموضع: الموضع
        };
        ألحق(الرموز, رمز_البيانات);
        دع د: متغير طبيعي = 0;
        طالما (د < (الطول((*مرجع_البيانات).البيانات) مثل طبيعي)) { ألحق(الثوابت,
            (*مرجع_البيانات).البيانات[د]); د := د + 1; }
        ب := ب + 1;
    }

    دع البيانات_العامة: متغير متجه ط8 = [];
    دع إزاحات_العوام: متغير متجه إزاحة_ماتشو = [];
    دع مواضع_العوام_دوارف: متغير متجه موضع_عام_دوارف = [];
    دع أقوى_محاذاة_عوام: متغير طبيعي = 1;
    دع عدد_بايتات_الثوابت: طبيعي = الطول(الثوابت) مثل طبيعي;
    دع لديه_ثوابت: منطقي = عدد_بايتات_الثوابت != 0;
    دع فهرس_قسم_العوام: متغير طبيعي = 1;
    إذا (لديه_ثوابت) { فهرس_قسم_العوام := 2; };
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*المرفقات).البيانات_العامة) مثل طبيعي)) {
        دع مرجع_العام: &بيانات_عام_كائن = &(*المرفقات).البيانات_العامة[ع];
        // Immutability is enforced by MSIR; data requiring relocations is
        // temporarily stored in the existing data section, not code bytes.
        دع محاذاة_العام: متغير طبيعي = (*مرجع_العام).المحاذاة;
        إذا (محاذاة_العام == 0) { محاذاة_العام := 1; };
        طابق أس_محاذاة_ماتشو(محاذاة_العام) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
        | اختياري.موجود(_) -> { };
        إذا (محاذاة_العام > أقوى_محاذاة_عوام) { أقوى_محاذاة_عوام := محاذاة_العام; };
        دع حجم_البيانات_الحالي: طبيعي = الطول(البيانات_العامة) مثل طبيعي;
        دع موضع_العام: طبيعي = حاذ_لأعلى(حجم_البيانات_الحالي, محاذاة_العام);
        إذا (موضع_العام > حجم_البيانات_الحالي) { ألحق_أصفارا(&متغير البيانات_العامة,
            موضع_العام - حجم_البيانات_الحالي); };
        دع معرف_العام: معرف_عام_مسير = (*مرجع_العام).المعرف;
        دع اسم_ربط_العام_دوارف: متجه ط8 = اسم_رمز_عام_ماتشو(معرف_العام);
        دع موضع_دوارف_للعام: موضع_عام_دوارف = {
            العام: معرف_العام, إزاحة_بايت: موضع_العام, اسم_الربط: اسم_ربط_العام_دوارف
        };
        ألحق(مواضع_العوام_دوارف, موضع_دوارف_للعام);
        دع المرجع_العام: مرجع_رمز_كائن = مرجع_رمز_كائن.عام((*مرجع_العام).المعرف);
        دع موضع_الرمز_العام: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(فهرس_قسم_العوام, موضع_العام);
        طابق أضف_رمز_ماتشو_إن_غاب(&متغير الرموز, المرجع_العام, موضع_الرمز_العام, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
        | نتيجة.نجح(أضيف) -> { إذا (!أضيف) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.رمز_إزاحة_مفقود()); }; };
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول((*مرجع_العام).البيانات) مثل طبيعي)) { ألحق(البيانات_العامة,
            (*مرجع_العام).البيانات[ج]); ج := ج + 1; }
        دع فهرس_إزاحة: متغير طبيعي = 0;
        طالما (فهرس_إزاحة < (الطول((*مرجع_العام).الإزاحات) مثل طبيعي)) {
            دع طلب: &طلب_إزاحة_بيانات_كائن = &(*مرجع_العام).الإزاحات[فهرس_إزاحة];
            دع حجم_العام: طبيعي = الطول((*مرجع_العام).البيانات) مثل طبيعي;
            إذا ((*طلب).الموضع > حجم_العام || 8 > حجم_العام - (*طلب).الموضع) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة());
            };
            دع موضع_الرقعة: طبيعي = موضع_العام + (*طلب).الموضع;
            // ARM64_RELOC_UNSIGNED uses the existing pointer-sized field as
            // the addend. The external symbol table supplies its base address.
            دع المتبقي: متغير طبيعي = (*طلب).الإضافة;
            دع ب: متغير طبيعي = 0;
            طالما (ب < 8) {
                البيانات_العامة[موضع_الرقعة + ب] := (المتبقي % 256) مثل ط8;
                المتبقي := المتبقي / 256;
                ب := ب + 1;
            }
            دع الإزاحة: إزاحة_ماتشو = {
                إزاحة_بايت: موضع_الرقعة,
                النوع: نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت(),
                الهدف: هدف_إزاحة_ماتشو.رمز(حل_مرجع_بيانات_خارجية_كائن(
                    &(*طلب).الرمز, المرفقات, الرموز_الخارجية
                )),
                الإضافة: 0
            };
            ألحق(إزاحات_العوام, الإزاحة);
            // A data-to-data relocation can reference a symbol defined by a
            // later global or another object. Keep one canonical symbol-table
            // entry and upgrade it when its definition is encountered.
            دع رمز_الطلب: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
                &(*طلب).الرمز, المرفقات, الرموز_الخارجية
            );
            طابق ابحث_رمز_ماتشو(&الرموز, &رمز_الطلب) مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> {
                دع المرجع: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&رمز_الطلب);
                دع موضع_غير_معرف: موضع_رمز_ماتشو = موضع_رمز_ماتشو.غير_معرف();
                طابق أضف_رمز_ماتشو_إن_غاب(
                    &متغير الرموز, المرجع, موضع_غير_معرف, الهدف, الرموز_الخارجية
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            };
            فهرس_إزاحة := فهرس_إزاحة + 1;
        }
        ع := ع + 1;
    }

    // The native executable defines process-lifetime startup data itself.
    // Relocatable modules without an entry never define these globals.
    طابق (*الشفرة).دخول_عملية_داروين مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        دع فهرس_البدء: متغير طبيعي = 0;
        طالما (فهرس_البدء < (الطول(الدخول.رموز_الإقلاع) مثل طبيعي)) {
            دع المعرف: معرف_دالة_خارجية_منتقاة = الدخول.رموز_الإقلاع[فهرس_البدء];
            دع الطول_الحالي: طبيعي = الطول(البيانات_العامة) مثل طبيعي;
            دع الموضع: طبيعي = حاذ_لأعلى(الطول_الحالي, 8);
            إذا (الموضع < الطول_الحالي) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة());
            };
            ألحق_أصفارا(&متغير البيانات_العامة, الموضع - الطول_الحالي);
            ألحق_أصفارا(&متغير البيانات_العامة, 8);
            إذا (أقوى_محاذاة_عوام < 8) { أقوى_محاذاة_عوام := 8; };
            دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.رمز_خارجي(المعرف);
            دع موضع_الرمز: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(فهرس_قسم_العوام, الموضع);
            طابق أضف_رمز_ماتشو_إن_غاب(
                &متغير الرموز, المرجع, موضع_الرمز, الهدف, الرموز_الخارجية
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
            | نتيجة.نجح(أضيف) -> {
                إذا (!أضيف) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
            };
            فهرس_البدء := فهرس_البدء + 1;
        }
    };

    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*المرفقات).إزاحات_النص) مثل طبيعي)) {
        دع مرجع_الطلب: &طلب_إزاحة_نص_كائن = &(*المرفقات).إزاحات_النص[ر];
        // BRANCH26, PAGE21 and PAGEOFF12 all use signed 24-bit
        // ARM64_RELOC_ADDEND records, not instruction-embedded addends.
        طابق (*مرجع_الطلب).النوع مع
        | نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت -> {
            إذا ((*مرجع_الطلب).الإضافة < -8388608
                || (*مرجع_الطلب).الإضافة > 8388607) {
                أرجع نتيجة_بناء_ماتشو.خطأ(
                    خطأ_ماتشو.إضافة_تثبيت_غير_مدعومة((*مرجع_الطلب).الموضع.الدالة)
                );
            };
        }
        | نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> {
            إذا ((*مرجع_الطلب).الإضافة < -8388608
                || (*مرجع_الطلب).الإضافة > 8388607) {
                أرجع نتيجة_بناء_ماتشو.خطأ(
                    خطأ_ماتشو.إضافة_تثبيت_غير_مدعومة((*مرجع_الطلب).الموضع.الدالة)
                );
            };
        }
        | نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت -> {
            إذا ((*مرجع_الطلب).الإضافة < -8388608
                || (*مرجع_الطلب).الإضافة > 8388607) {
                أرجع نتيجة_بناء_ماتشو.خطأ(
                    خطأ_ماتشو.إضافة_تثبيت_غير_مدعومة((*مرجع_الطلب).الموضع.الدالة)
                );
            };
        }
        | _ -> {
            إذا ((*مرجع_الطلب).الإضافة != 0) {
                أرجع نتيجة_بناء_ماتشو.خطأ(
                    خطأ_ماتشو.إضافة_تثبيت_غير_مدعومة((*مرجع_الطلب).الموضع.الدالة)
                );
            };
        };
        دع بداية: متغير طبيعي = 0;
        دع حجم_الدالة: متغير طبيعي = 0;
        طابق ابحث_موضع_دالة_ماتشو(&مواضع_دوارف, (*مرجع_الطلب).الموضع.الدالة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة)); }
        | اختياري.موجود(فهرس_الموضع) -> {
            دع مرجع_الموضع: &موضع_دالة_دوارف = &مواضع_دوارف[فهرس_الموضع];
            بداية := (*مرجع_الموضع).إزاحة_بايت;
            حجم_الدالة := (*مرجع_الموضع).حجم_بايت;
        };
        دع حجم_الحقل: طبيعي = حجم_حقل_إزاحة_مشترك((*مرجع_الطلب).النوع);
        دع محاذاة_الحقل: طبيعي = محاذاة_حقل_إزاحة_مشترك((*مرجع_الطلب).النوع);
        إذا (((*مرجع_الطلب).الموضع.إزاحة_بايت % محاذاة_الحقل) != 0) {
            أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة));
        };
        إذا ((*مرجع_الطلب).الموضع.إزاحة_بايت > حجم_الدالة
            || حجم_الحقل > حجم_الدالة - (*مرجع_الطلب).الموضع.إزاحة_بايت) {
            أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة)); };
        دع نوع_ماتشو: نوع_إزاحة_ماتشو;
        طابق نوع_إزاحة_ماتشو_من_مشترك((*مرجع_الطلب).النوع) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_بناء_ماتشو.خطأ(
                خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة)
            );
        }
        | اختياري.موجود(النوع) -> { نوع_ماتشو := النوع; };
        دع موضع_مطلق: طبيعي = بداية + (*مرجع_الطلب).الموضع.إزاحة_بايت;
        دع مرجع_الإزاحة: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
            &(*مرجع_الطلب).الرمز, المرفقات, الرموز_الخارجية
        );
        طابق نوع_ماتشو مع
        | نوع_إزاحة_ماتشو.صفحة_تحميل_جوت_ذراع_واحد_وعشرون_بت -> {
            طابق مرجع_الإزاحة مع
            | مرجع_رمز_كائن.رمز_خارجي(_) -> { }
            | _ -> {
                أرجع نتيجة_بناء_ماتشو.خطأ(
                    خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة)
                );
            };
        }
        | نوع_إزاحة_ماتشو.إزاحة_صفحة_تحميل_جوت_ذراع_اثنا_عشر_بت -> {
            طابق مرجع_الإزاحة مع
            | مرجع_رمز_كائن.رمز_خارجي(_) -> { }
            | _ -> {
                أرجع نتيجة_بناء_ماتشو.خطأ(
                    خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة)
                );
            };
        }
        | _ -> { };
        دع الهدف_الرمزي: هدف_إزاحة_ماتشو = هدف_إزاحة_ماتشو.رمز(مرجع_الإزاحة);
        دع الإزاحة: إزاحة_ماتشو = {
            إزاحة_بايت: موضع_مطلق,
            النوع: نوع_ماتشو,
            الهدف: الهدف_الرمزي,
            الإضافة: (*مرجع_الطلب).الإضافة
        };
        ألحق(الإزاحات, الإزاحة);
        طابق ابحث_رمز_ماتشو(&الرموز, &مرجع_الإزاحة) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            إذا (مرجع_رمز_كائن_هو_بيانات_محلية(&مرجع_الإزاحة)) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.رمز_إزاحة_مفقود()); };
            دع موضع_رمز_غير_معرف: موضع_رمز_ماتشو = موضع_رمز_ماتشو.غير_معرف();
            دع مرجع_الرمز_الجديد: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&مرجع_الإزاحة);
            طابق أضف_رمز_ماتشو_إن_غاب(&متغير الرموز, مرجع_الرمز_الجديد, موضع_رمز_غير_معرف, الهدف,
                الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        };
        ر := ر + 1;
    }

    // The entry relocations use the same Mach-O symbols and relocation
    // records as ordinary code. Symbols must exist before serializing them.
    طابق (*الشفرة).دخول_عملية_داروين مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        دع فهرس_الطلب: متغير طبيعي = 0;
        طالما (فهرس_الطلب < (الطول(الدخول.الإزاحات) مثل طبيعي)) {
            دع المرجع: &مرجع_رمز_كائن = &الدخول.الإزاحات[فهرس_الطلب].الرمز;
            طابق ابحث_رمز_ماتشو(&الرموز, المرجع) مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.رمز_إزاحة_مفقود());
            };
            فهرس_الطلب := فهرس_الطلب + 1;
        }
    };

    دع حجم_نص_دوارف: طبيعي = الطول(النص) مثل طبيعي;
    دع اسم_النص: متجه ط8 = اسم_قسم_نص();
    دع اسم_المقطع: متجه ط8 = اسم_مقطع_نص();
    دع الإزاحات_المرتبة: متجه إزاحة_ماتشو = رتب_إزاحات_ماتشو(&الإزاحات);
    دع قسم_النص: قسم_ماتشو = { الاسم: اسم_النص, اسم_المقطع: اسم_المقطع, البيانات: النص, المحاذاة_الأسية: 2,
        الأعلام: 0x80000400, الإزاحات: الإزاحات_المرتبة };
    دع الأقسام: متغير متجه قسم_ماتشو = [قسم_النص];
    إذا ((الطول(الثوابت) مثل طبيعي) != 0) {
        دع اسم_الثوابت: متجه ط8 = اسم_قسم_ثوابت();
        دع اسم_مقطع_الثوابت: متجه ط8 = اسم_مقطع_نص();
        دع لا_إزاحات: متجه إزاحة_ماتشو = [];
        دع أس_الثوابت: متغير طبيعي = 0;
        طابق أس_محاذاة_ماتشو(أقوى_محاذاة_ثوابت) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
        | اختياري.موجود(القيمة) -> { أس_الثوابت := القيمة; };
        دع قسم_الثوابت: قسم_ماتشو = {
            الاسم: اسم_الثوابت,
            اسم_المقطع: اسم_مقطع_الثوابت,
            البيانات: الثوابت,
            المحاذاة_الأسية: أس_الثوابت,
            الأعلام: 0,
            الإزاحات: لا_إزاحات
        };
        ألحق(الأقسام, قسم_الثوابت);
    };
    إذا ((الطول(البيانات_العامة) مثل طبيعي) != 0) {
        دع اسم_البيانات: متجه ط8 = بايتات_من_نص(«__data»);
        دع اسم_مقطع_البيانات: متجه ط8 = بايتات_من_نص(«__DATA»);
        دع الإزاحات_المرتبة_بيانات: متجه إزاحة_ماتشو = رتب_إزاحات_ماتشو(&إزاحات_العوام);
        دع أس_العوام: متغير طبيعي = 0;
        طابق أس_محاذاة_ماتشو(أقوى_محاذاة_عوام) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
        | اختياري.موجود(القيمة) -> { أس_العوام := القيمة; };
        دع قسم_البيانات: قسم_ماتشو = {
            الاسم: اسم_البيانات,
            اسم_المقطع: اسم_مقطع_البيانات,
            البيانات: البيانات_العامة,
            المحاذاة_الأسية: أس_العوام,
            الأعلام: 0,
            الإزاحات: الإزاحات_المرتبة_بيانات
        };
        ألحق(الأقسام, قسم_البيانات);
    };
    // The platform loader invokes __mod_init_func entries in object/library
    // output. The function reference is a normal unsigned Mach-O relocation.
    طابق (*المرفقات).منشئ_الوحدة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المعرف) -> {
        دع مرجع_الدالة: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(المعرف);
        طابق ابحث_رمز_ماتشو(&الرموز, &مرجع_الدالة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.رمز_إزاحة_مفقود());
        }
        | اختياري.موجود(_) -> { };
        دع اسم_القسم: متجه ط8 = بايتات_من_نص(«__mod_init_func»);
        دع اسم_الحاوية: متجه ط8 = بايتات_من_نص(«__DATA»);
        دع البايتات: متجه ط8 = [0,0,0,0,0,0,0,0];
        دع الإزاحة: إزاحة_ماتشو = {
            إزاحة_بايت: 0,
            النوع: نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت(),
            الهدف: هدف_إزاحة_ماتشو.رمز(مرجع_الدالة),
            الإضافة: 0
        };
        دع الإزاحات: متجه إزاحة_ماتشو = [الإزاحة];
        دع القسم: قسم_ماتشو = {
            الاسم: اسم_القسم,
            اسم_المقطع: اسم_الحاوية,
            البيانات: البايتات,
            المحاذاة_الأسية: 3,
            الأعلام: 0x9,
            الإزاحات: الإزاحات
        };
        ألحق(الأقسام, القسم);
    };
    دع حزمة_دوارف_الماتشو: متغير حزمة_دوارف = ابن_حزمة_دوارف_من_سياقات(
        خريطة_المصادر, أصول_المصدر, &مواضع_دوارف, &مواضع_العوام_دوارف, التصحيح, تصحيح_الآلة, سياق_الفك,
        الأنواع, الهدف, سجل_التخطيط, &أصول_آلة_دوارف, حجم_نص_دوارف
    );
    دع ترتيب_قسم_النص_دوارف: طبيعي = 1;
    دع ترتيب_قسم_البيانات_دوارف: طبيعي = فهرس_قسم_العوام + 1;
    دع أقسام_دوارف_الفعالة: متجه قسم_بيانات_دوارف = أقسام_بيانات_دوارف_ماتشو_الفعالة(&حزمة_دوارف_الماتشو);
    دع عدد_الأقسام: طبيعي = الطول(الأقسام) مثل طبيعي;
    دع بداية_ترتيب_دوارف: طبيعي = عدد_الأقسام + 1;
    دع اسم_دوارف_معلومات: متجه ط8 = بايتات_من_نص(«__debug_info»);
    إذا (!أضف_قسم_دوارف_ماتشو(&متغير الأقسام, اسم_دوارف_معلومات, &متغير حزمة_دوارف_الماتشو.معلومات, 0,
        اختياري.موجود(قسم_عنوان_دوارف.معلومات()), قسم_بيانات_دوارف.معلومات(), &حزمة_دوارف_الماتشو.رقع_العناوين,
        &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    دع اسم_دوارف_اختصارات: متجه ط8 = بايتات_من_نص(«__debug_abbrev»);
    إذا (!أضف_قسم_دوارف_ماتشو(&متغير الأقسام, اسم_دوارف_اختصارات, &متغير حزمة_دوارف_الماتشو.اختصارات, 0,
        اختياري.لا_شيء(), قسم_بيانات_دوارف.اختصارات(), &حزمة_دوارف_الماتشو.رقع_العناوين,
        &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    دع اسم_دوارف_سطور: متجه ط8 = بايتات_من_نص(«__debug_line»);
    إذا (!أضف_قسم_دوارف_ماتشو(&متغير الأقسام, اسم_دوارف_سطور, &متغير حزمة_دوارف_الماتشو.سطور, 0,
        اختياري.موجود(قسم_عنوان_دوارف.سطور()), قسم_بيانات_دوارف.سطور(), &حزمة_دوارف_الماتشو.رقع_العناوين,
        &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };

    // The DWARF writer decides the versioned section set. Mach-O only emits
    // materialized sections, in the same deterministic order used by the
    // relocation section-index map above.
    دع اسم_سلاسل_سطور: متجه ط8 = بايتات_من_نص(«__debug_line_str»);
    دع اسم_سلاسل: متجه ط8 = بايتات_من_نص(«__debug_str»);
    دع اسم_عناوين: متجه ط8 = بايتات_من_نص(«__debug_addr»);
    دع اسم_دوارف_مواقع: متجه ط8 = بايتات_من_نص(«__debug_loc»);
    دع اسم_قوائم_مواقع: متجه ط8 = بايتات_من_نص(«__debug_loclists»);
    دع اسم_دوارف_إطار: متجه ط8 = بايتات_من_نص(«__debug_frame»);
    دع اسم_دوارف_نطاقات: متجه ط8 = بايتات_من_نص(«__debug_aranges»);
    دع اسم_قوائم_نطاقات: متجه ط8 = بايتات_من_نص(«__debug_rnglists»);
    دع اسم_دوارف_أسماء: متجه ط8 = بايتات_من_نص(«__debug_pubnames»);
    دع اسم_فهرس_أسماء: متجه ط8 = بايتات_من_نص(«__debug_names»);

    إذا ((الطول(حزمة_دوارف_الماتشو.سلاسل_سطور) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_سلاسل_سطور, &متغير حزمة_دوارف_الماتشو.سلاسل_سطور, 0, اختياري.لا_شيء(),
        قسم_بيانات_دوارف.سلاسل_سطور(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    إذا ((الطول(حزمة_دوارف_الماتشو.سلاسل) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام, اسم_سلاسل,
        &متغير حزمة_دوارف_الماتشو.سلاسل, 0, اختياري.لا_شيء(), قسم_بيانات_دوارف.سلاسل(),
        &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف,
        ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    إذا ((الطول(حزمة_دوارف_الماتشو.عناوين) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام, اسم_عناوين,
        &متغير حزمة_دوارف_الماتشو.عناوين, 3, اختياري.موجود(قسم_عنوان_دوارف.عناوين()), قسم_بيانات_دوارف.عناوين(),
        &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف,
        ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    إذا ((الطول(حزمة_دوارف_الماتشو.مواقع) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_دوارف_مواقع, &متغير حزمة_دوارف_الماتشو.مواقع, 0, اختياري.موجود(قسم_عنوان_دوارف.مواقع()),
        قسم_بيانات_دوارف.مواقع(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    إذا ((الطول(حزمة_دوارف_الماتشو.قوائم_مواقع) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_قوائم_مواقع, &متغير حزمة_دوارف_الماتشو.قوائم_مواقع, 0, اختياري.موجود(قسم_عنوان_دوارف.قوائم_مواقع()),
        قسم_بيانات_دوارف.قوائم_مواقع(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    إذا ((الطول(حزمة_دوارف_الماتشو.إطار) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_دوارف_إطار, &متغير حزمة_دوارف_الماتشو.إطار, 3, اختياري.موجود(قسم_عنوان_دوارف.إطار()),
        قسم_بيانات_دوارف.إطار(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    إذا ((الطول(حزمة_دوارف_الماتشو.نطاقات_عناوين) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_دوارف_نطاقات, &متغير حزمة_دوارف_الماتشو.نطاقات_عناوين, 3,
        اختياري.موجود(قسم_عنوان_دوارف.نطاقات_عناوين()), قسم_بيانات_دوارف.نطاقات_عناوين(),
        &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف,
        ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    إذا ((الطول(حزمة_دوارف_الماتشو.قوائم_نطاقات) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_قوائم_نطاقات, &متغير حزمة_دوارف_الماتشو.قوائم_نطاقات, 0,
        اختياري.موجود(قسم_عنوان_دوارف.قوائم_نطاقات()), قسم_بيانات_دوارف.قوائم_نطاقات(),
        &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف,
        ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    إذا ((الطول(حزمة_دوارف_الماتشو.أسماء_عامة) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_دوارف_أسماء, &متغير حزمة_دوارف_الماتشو.أسماء_عامة, 0, اختياري.لا_شيء(),
        قسم_بيانات_دوارف.أسماء_عامة(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    إذا ((الطول(حزمة_دوارف_الماتشو.فهرس_أسماء) مثل طبيعي) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_فهرس_أسماء, &متغير حزمة_دوارف_الماتشو.فهرس_أسماء, 0, اختياري.لا_شيء(),
        قسم_بيانات_دوارف.فهرس_أسماء(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };


    طابق (*الشفرة).دخول_عملية_داروين مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        طابق طبق_اسم_دخول_ماتشو(&متغير الرموز, دالة_الدخول) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
    };

    دع الرموز_المرتبة: متجه رمز_ماتشو = رتب_رموز_ماتشو_المعرفة_أولا(&الرموز);
    الرموز := الرموز_المرتبة;
    دع عدد_الرموز_المعرفة: متغير طبيعي = 0;
    دع س: متغير طبيعي = 0;
    طالما (س < (الطول(الرموز) مثل طبيعي)) {
        دع مرجع_الرمز: &رمز_ماتشو = &الرموز[س];
        طابق (*مرجع_الرمز).الموضع مع | موضع_رمز_ماتشو.معرف_في_قسم(_,
            _) -> { عدد_الرموز_المعرفة := عدد_الرموز_المعرفة + 1; } | موضع_رمز_ماتشو.غير_معرف -> { };
        س := س + 1;
    }
    دع الكائن: كائن_ماتشو = { الهدف: معرف_الهدف, الأقسام: الأقسام, الرموز: الرموز,
        عدد_الرموز_المعرفة: عدد_الرموز_المعرفة, دوارف: حزمة_دوارف_الماتشو };
    أرجع نتيجة_بناء_ماتشو.نجح(الكائن);
}


عرف ألحق_حقل_اسم_ستة_عشر(البايتات: &متغير متجه ط8, الاسم: &متجه ط8): منطقي {
    دع الحجم: طبيعي = الطول(*الاسم) مثل طبيعي;
    إذا (الحجم > 16) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) { ألحق_ط8(البايتات, (*الاسم)[ف] مثل طبيعي); ف := ف + 1; }
    ألحق_أصفارا(البايتات, 16 - الحجم);
    أرجع صواب;
}

عرف ابن_جدول_نصوص_ماتشو(الرموز: &متجه رمز_ماتشو): جدول_نصوص_ماتشو {
    دع النصوص: متغير متجه ط8 = [0];
    دع المواقع: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        دع الموقع: طبيعي = الطول(النصوص) مثل طبيعي; ألحق(المواقع, الموقع);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الرموز)[ف].الاسم) مثل طبيعي)) { ألحق(النصوص, (*الرموز)[ف].الاسم[ك]);
            ك := ك + 1; }
        ألحق(النصوص, 0); ف := ف + 1;
    }
    دع الجدول: جدول_نصوص_ماتشو = { البيانات: النصوص, إزاحات_الرموز: المواقع };
    أرجع الجدول;
}

عرف معلومات_إزاحة_ماتشو(الإزاحة: &إزاحة_ماتشو, فهرس_الرمز: طبيعي, خارجي_الرمز: منطقي): اختياري طبيعي {
    إذا (فهرس_الرمز > 0xFFFFFF) { أرجع اختياري.لا_شيء(); };
    دع النوع: متغير طبيعي = 0; دع متجه_نسبي: متغير منطقي = خطأ; دع طول_الحقل: متغير طبيعي = 2;
    دع إ: إزاحة_ماتشو = *الإزاحة;
    طابق إ.النوع مع
    | نوع_إزاحة_ماتشو.فرع_ذراع_ستة_وعشرون_بت -> { النوع := 2; متجه_نسبي := صواب; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.صفحة_ذراع_واحد_وعشرون_بت -> { النوع := 3; متجه_نسبي := صواب; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> { النوع := 4; متجه_نسبي := خطأ; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.صفحة_تحميل_جوت_ذراع_واحد_وعشرون_بت -> {
        النوع := 5; متجه_نسبي := صواب; طول_الحقل := 2;
    }
    | نوع_إزاحة_ماتشو.إزاحة_صفحة_تحميل_جوت_ذراع_اثنا_عشر_بت -> {
        النوع := 6; متجه_نسبي := خطأ; طول_الحقل := 2;
    }
    | نوع_إزاحة_ماتشو.مطلق_اثنان_وثلاثون_بت -> { النوع := 0; متجه_نسبي := خطأ; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت -> { النوع := 0; متجه_نسبي := خطأ; طول_الحقل := 3; };
    دع المعلومات: متغير طبيعي = فهرس_الرمز;
    إذا (متجه_نسبي) { المعلومات := المعلومات + 16777216; };
    المعلومات := المعلومات + (طول_الحقل * 33554432);
    إذا (خارجي_الرمز) { المعلومات := المعلومات + 134217728; };
    المعلومات := المعلومات + (النوع * 268435456);
    أرجع اختياري.موجود(المعلومات);
}

عرف ابحث_اسم_رمز_ماتشو_مرتب(
    الرموز: &متجه رمز_ماتشو,
    الاسم: &متجه ط8,
    بداية_النطاق: طبيعي,
    نهاية_النطاق: طبيعي
): اختياري طبيعي {
    دع البداية: متغير طبيعي = بداية_النطاق;
    دع النهاية: متغير طبيعي = نهاية_النطاق;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        دع الاسم_الحالي: &متجه ط8 = &(*الرموز)[الوسط].الاسم;
        إذا (اسم_ماتشو_أصغر(الاسم_الحالي, الاسم)) {
            البداية := الوسط + 1;
        } وإلا إذا (اسم_ماتشو_أصغر(الاسم, الاسم_الحالي)) {
            النهاية := الوسط;
        } وإلا {
            أرجع اختياري.موجود(الوسط);
        };
    }
    أرجع اختياري.لا_شيء();
}

عرف ابحث_رمز_إزاحة_ماتشو(
    الكائن: &كائن_ماتشو,
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف
): اختياري طبيعي {
    دع عدد_الرموز: طبيعي = الطول((*الكائن).الرموز) مثل طبيعي;
    دع عدد_المعرفة: طبيعي = (*الكائن).عدد_الرموز_المعرفة;
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> {
        دع الاسم: متجه ط8 = اسم_رمز_دالة(الدالة);
        أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, 0, عدد_المعرفة);
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(البيانات) -> {
        دع الاسم: متجه ط8 = اسم_رمز_بيانات(البيانات);
        أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, 0, عدد_المعرفة);
    }
    | مرجع_رمز_كائن.عام(العام) -> {
        دع الاسم: متجه ط8 = اسم_رمز_عام_ماتشو(العام);
        أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, 0, عدد_المعرفة);
    }
    | مرجع_رمز_كائن.خدمة_تشغيل(_) -> { أرجع اختياري.لا_شيء(); }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> {
        طابق اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الاسم) -> {
            أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, عدد_المعرفة, عدد_الرموز);
        };
    }

    | مرجع_رمز_كائن.رمز_خارجي(_) -> {
        // Raw external IDs need the declaration-name table that is intentionally
        // not retained by the serialized object. Keep the rare fallback linear.
        أرجع ابحث_رمز_ماتشو(&(*الكائن).الرموز, المرجع);
    };
}

// Relocation counts include the extra ARM64_RELOC_ADDEND record, which is
// serialized immediately before its primary instruction relocation.
عرف عدد_سجلات_إزاحة_قسم_ماتشو(القسم: &قسم_ماتشو): طبيعي {
    دع العدد: متغير طبيعي = الطول((*القسم).الإزاحات) مثل طبيعي;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*القسم).الإزاحات) مثل طبيعي)) {
        إذا ((*القسم).الإزاحات[الفهرس].الإضافة != 0) {
            العدد := العدد + 1;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع العدد;
}

عام عرف سلسل_كائن_ماتشو_ذراع_أربعة_وستون(الكائن: &كائن_ماتشو, الهدف: &واصف_هدف): نتيجة_تسلسل_ماتشو {
    إذا (!معرفا_هدف_متساويان((*الكائن).الهدف,
        (*الهدف).المعرف)) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق((*الكائن).الهدف)); };
    طابق (*الهدف).صيغة_الكائن مع | صيغة_كائن_هدف.ماتشو -> { }
        | _ -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق((*الهدف).المعرف)); };
    دع عدد_الأقسام: طبيعي = الطول((*الكائن).الأقسام) مثل طبيعي;
    إذا (عدد_الأقسام == 0 || عدد_الأقسام > 16) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.قسم_نص_مفقود()); };
    دع عدد_الرموز: طبيعي = الطول((*الكائن).الرموز) مثل طبيعي;
    إذا (عدد_الرموز > 0xFFFFFFFF || (*الكائن).عدد_الرموز_المعرفة > عدد_الرموز) {
        أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    دع جدول_النصوص: جدول_نصوص_ماتشو = ابن_جدول_نصوص_ماتشو(&(*الكائن).الرموز);
    دع حجم_جدول_النصوص: طبيعي = الطول(جدول_النصوص.البيانات) مثل طبيعي;
    دع حجم_أمر_المقطع: طبيعي = 72 + (عدد_الأقسام * 80);
    // MH_OBJECT carries LC_BUILD_VERSION so external Apple linkers know this is a macOS object.
    دع حجم_أمر_بناء_المنصة: طبيعي = 24;
    دع حجم_أوامر_التحميل: طبيعي = حجم_أمر_المقطع + 24 + 80 + حجم_أمر_بناء_المنصة;
    دع بداية_بيانات_الأقسام: طبيعي = 32 + حجم_أوامر_التحميل;
    دع إزاحات_الأقسام: متغير متجه طبيعي = [];
    دع عناوين_الأقسام: متغير متجه طبيعي = [];
    دع مواضع_الإزاحات: متغير متجه طبيعي = [];
    دع موضع_الملف: متغير طبيعي = بداية_بيانات_الأقسام; دع عنوان_افتراضي: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع المحاذاة: متغير طبيعي = 1;
        طابق قوة_اثنين_ماتشو((*مرجع_القسم).المحاذاة_الأسية) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة());
            } | اختياري.موجود(قيمة) -> { المحاذاة := قيمة; };
        موضع_الملف := حاذ_لأعلى(موضع_الملف, المحاذاة); عنوان_افتراضي := حاذ_لأعلى(عنوان_افتراضي, المحاذاة);
        ألحق(إزاحات_الأقسام, موضع_الملف); ألحق(عناوين_الأقسام, عنوان_افتراضي);
        دع حجم_القسم: طبيعي = الطول((*مرجع_القسم).البيانات) مثل طبيعي;
        موضع_الملف := موضع_الملف + حجم_القسم; عنوان_افتراضي := عنوان_افتراضي + حجم_القسم;
        ف := ف + 1;
    }
    دع نهاية_بيانات_الأقسام: طبيعي = موضع_الملف;
    دع موضع_الإزاحة: متغير طبيعي = نهاية_بيانات_الأقسام; ف := 0;
    طالما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع العدد: طبيعي = عدد_سجلات_إزاحة_قسم_ماتشو(مرجع_القسم);
        إذا (العدد > 0xFFFFFFFF) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
        إذا (العدد == 0) {
            ألحق(مواضع_الإزاحات, 0);
        } وإلا {
            ألحق(مواضع_الإزاحات, موضع_الإزاحة);
            موضع_الإزاحة := موضع_الإزاحة + (العدد * 8);
        };
        ف := ف + 1;
    }
    دع إزاحة_الرموز: طبيعي = حاذ_لأعلى(موضع_الإزاحة, 8);
    دع إزاحة_النصوص: طبيعي = إزاحة_الرموز + (عدد_الرموز * 16);
    إذا (إزاحة_الرموز > 0xFFFFFFFF || إزاحة_النصوص > 0xFFFFFFFF || حجم_جدول_النصوص > 0xFFFFFFFF) {
        أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };

    دع البايتات: متغير متجه ط8 = [];
    ألحق_ط32_صغير(&متغير البايتات, 0xFEEDFACF); ألحق_ط32_صغير(&متغير البايتات, 0x0100000C);
        ألحق_ط32_صغير(&متغير البايتات, 0);
    ألحق_ط32_صغير(&متغير البايتات, 1); ألحق_ط32_صغير(&متغير البايتات, 4);
        ألحق_ط32_صغير(&متغير البايتات, حجم_أوامر_التحميل); ألحق_ط32_صغير(&متغير البايتات, 0);
        ألحق_ط32_صغير(&متغير البايتات, 0);
    ألحق_ط32_صغير(&متغير البايتات, 0x19); ألحق_ط32_صغير(&متغير البايتات, حجم_أمر_المقطع);
        ألحق_أصفارا(&متغير البايتات, 16);
    ألحق_ط64_صغير(&متغير البايتات, 0); ألحق_ط64_صغير(&متغير البايتات, عنوان_افتراضي);
        ألحق_ط64_صغير(&متغير البايتات, بداية_بيانات_الأقسام);
        ألحق_ط64_صغير(&متغير البايتات, نهاية_بيانات_الأقسام - بداية_بيانات_الأقسام);
    ألحق_ط32_صغير(&متغير البايتات, 7); ألحق_ط32_صغير(&متغير البايتات, 7);
        ألحق_ط32_صغير(&متغير البايتات, عدد_الأقسام); ألحق_ط32_صغير(&متغير البايتات, 0);
    ف := 0;
    طالما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        إذا (!ألحق_حقل_اسم_ستة_عشر(&متغير البايتات,
            &(*مرجع_القسم).الاسم) || !ألحق_حقل_اسم_ستة_عشر(&متغير البايتات,
            &(*مرجع_القسم).اسم_المقطع)) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
        دع حجم_القسم: طبيعي = الطول((*مرجع_القسم).البيانات) مثل طبيعي;
        دع عدد_إزاحات_القسم: طبيعي = عدد_سجلات_إزاحة_قسم_ماتشو(مرجع_القسم);
        ألحق_ط64_صغير(&متغير البايتات, عناوين_الأقسام[ف]); ألحق_ط64_صغير(&متغير البايتات, حجم_القسم);
            ألحق_ط32_صغير(&متغير البايتات, إزاحات_الأقسام[ف]);
            ألحق_ط32_صغير(&متغير البايتات, (*مرجع_القسم).المحاذاة_الأسية);
        ألحق_ط32_صغير(&متغير البايتات, مواضع_الإزاحات[ف]); ألحق_ط32_صغير(&متغير البايتات, عدد_إزاحات_القسم);
            ألحق_ط32_صغير(&متغير البايتات, (*مرجع_القسم).الأعلام); ألحق_ط32_صغير(&متغير البايتات, 0);
