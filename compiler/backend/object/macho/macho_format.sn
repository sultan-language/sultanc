    دع بداية_بيانات_الأقسام: غير_موقع = 32 + حجم_أوامر_التحميل;
    دع إزاحات_الأقسام: متغير متجه غير_موقع = [];
    دع عناوين_الأقسام: متغير متجه غير_موقع = [];
    دع مواضع_الإزاحات: متغير متجه غير_موقع = [];
    دع موضع_الملف: متغير غير_موقع = بداية_بيانات_الأقسام; دع عنوان_افتراضي: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع المحاذاة: متغير غير_موقع = 1;
        طابق قوة_اثنين_ماتشو((*مرجع_القسم).المحاذاة_الأسية) مع | اختيار.لا_شيء -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); } | اختيار.بعض(قيمة) -> { المحاذاة := قيمة; };
        موضع_الملف := حاذ_لأعلى(موضع_الملف, المحاذاة); عنوان_افتراضي := حاذ_لأعلى(عنوان_افتراضي, المحاذاة);
        ألحق(إزاحات_الأقسام, موضع_الملف); ألحق(عناوين_الأقسام, عنوان_افتراضي);
        دع حجم_القسم: غير_موقع = الطول((*مرجع_القسم).البيانات) مثل غير_موقع;
        موضع_الملف := موضع_الملف + حجم_القسم; عنوان_افتراضي := عنوان_افتراضي + حجم_القسم;
        ف := ف + 1;
    }
    دع نهاية_بيانات_الأقسام: غير_موقع = موضع_الملف;
    دع موضع_الإزاحة: متغير غير_موقع = نهاية_بيانات_الأقسام; ف := 0;
    بينما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع العدد: غير_موقع = الطول((*مرجع_القسم).الإزاحات) مثل غير_موقع;
        لو (العدد > 0xFFFFFFFF) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
        لو (العدد == 0) {
            ألحق(مواضع_الإزاحات, 0);
        } وإلا {
            ألحق(مواضع_الإزاحات, موضع_الإزاحة);
            موضع_الإزاحة := موضع_الإزاحة + (العدد * 8);
        };
        ف := ف + 1;
    }
    دع إزاحة_الرموز: غير_موقع = حاذ_لأعلى(موضع_الإزاحة, 8);
    دع إزاحة_النصوص: غير_موقع = إزاحة_الرموز + (عدد_الرموز * 16);
    لو (إزاحة_الرموز > 0xFFFFFFFF || إزاحة_النصوص > 0xFFFFFFFF || حجم_جدول_النصوص > 0xFFFFFFFF) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };

    دع البايتات: متغير متجه غ8 = [];
    ألحق_غ32_صغير(&متغير البايتات, 0xFEEDFACF); ألحق_غ32_صغير(&متغير البايتات, 0x0100000C); ألحق_غ32_صغير(&متغير البايتات, 0);
    ألحق_غ32_صغير(&متغير البايتات, 1); ألحق_غ32_صغير(&متغير البايتات, 4); ألحق_غ32_صغير(&متغير البايتات, حجم_أوامر_التحميل); ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0);
    ألحق_غ32_صغير(&متغير البايتات, 0x19); ألحق_غ32_صغير(&متغير البايتات, حجم_أمر_المقطع); ألحق_أصفارا(&متغير البايتات, 16);
    ألحق_غ64_صغير(&متغير البايتات, 0); ألحق_غ64_صغير(&متغير البايتات, عنوان_افتراضي); ألحق_غ64_صغير(&متغير البايتات, بداية_بيانات_الأقسام); ألحق_غ64_صغير(&متغير البايتات, نهاية_بيانات_الأقسام - بداية_بيانات_الأقسام);
    ألحق_غ32_صغير(&متغير البايتات, 7); ألحق_غ32_صغير(&متغير البايتات, 7); ألحق_غ32_صغير(&متغير البايتات, عدد_الأقسام); ألحق_غ32_صغير(&متغير البايتات, 0);
    ف := 0;
    بينما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        لو (!ألحق_حقل_اسم_ستة_عشر(&متغير البايتات, &(*مرجع_القسم).الاسم) || !ألحق_حقل_اسم_ستة_عشر(&متغير البايتات, &(*مرجع_القسم).اسم_المقطع)) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
        دع حجم_القسم: غير_موقع = الطول((*مرجع_القسم).البيانات) مثل غير_موقع;
        دع عدد_إزاحات_القسم: غير_موقع = الطول((*مرجع_القسم).الإزاحات) مثل غير_موقع;
        ألحق_غ64_صغير(&متغير البايتات, عناوين_الأقسام[ف]); ألحق_غ64_صغير(&متغير البايتات, حجم_القسم); ألحق_غ32_صغير(&متغير البايتات, إزاحات_الأقسام[ف]); ألحق_غ32_صغير(&متغير البايتات, (*مرجع_القسم).المحاذاة_الأسية);
        ألحق_غ32_صغير(&متغير البايتات, مواضع_الإزاحات[ف]); ألحق_غ32_صغير(&متغير البايتات, عدد_إزاحات_القسم); ألحق_غ32_صغير(&متغير البايتات, (*مرجع_القسم).الأعلام); ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0);
        ف := ف + 1;
    }
    ألحق_غ32_صغير(&متغير البايتات, 2); ألحق_غ32_صغير(&متغير البايتات, 24); ألحق_غ32_صغير(&متغير البايتات, إزاحة_الرموز); ألحق_غ32_صغير(&متغير البايتات, عدد_الرموز); ألحق_غ32_صغير(&متغير البايتات, إزاحة_النصوص); ألحق_غ32_صغير(&متغير البايتات, حجم_جدول_النصوص);
    ألحق_غ32_صغير(&متغير البايتات, 0xB); ألحق_غ32_صغير(&متغير البايتات, 80); ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, (*الكائن).عدد_الرموز_المعرفة); ألحق_غ32_صغير(&متغير البايتات, (*الكائن).عدد_الرموز_المعرفة); ألحق_غ32_صغير(&متغير البايتات, عدد_الرموز - (*الكائن).عدد_الرموز_المعرفة); ألحق_أصفارا(&متغير البايتات, 48);
    // LC_BUILD_VERSION: platform macOS, minimum macOS 11.0, SDK unspecified.
    ألحق_غ32_صغير(&متغير البايتات, 0x32); ألحق_غ32_صغير(&متغير البايتات, حجم_أمر_بناء_المنصة);
    ألحق_غ32_صغير(&متغير البايتات, 1); ألحق_غ32_صغير(&متغير البايتات, 0x000B0000);
    ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0);

    ف := 0;
    بينما (ف < عدد_الأقسام) {
        دع الحالي: غير_موقع = الطول(البايتات) مثل غير_موقع; لو (إزاحات_الأقسام[ف] > الحالي) { ألحق_أصفارا(&متغير البايتات, إزاحات_الأقسام[ف] - الحالي); };
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع ب: متغير غير_موقع = 0; بينما (ب < (الطول((*مرجع_القسم).البيانات) مثل غير_موقع)) { ألحق_غ8(&متغير البايتات, (*مرجع_القسم).البيانات[ب] مثل غير_موقع); ب := ب + 1; }
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع ه: متغير غير_موقع = 0;
        بينما (ه < (الطول((*مرجع_القسم).الإزاحات) مثل غير_موقع)) {
            دع الإزاحة: إزاحة_ماتشو = (*مرجع_القسم).الإزاحات[ه]; لو (الإزاحة.إزاحة_بايت > 0x7FFFFFFF) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
            طابق الإزاحة.الهدف مع
            | هدف_إزاحة_ماتشو.رمز(المرجع) -> {
                طابق ابحث_رمز_إزاحة_ماتشو(الكائن, &المرجع, الهدف) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.رمز_إزاحة_مفقود()); }
                | اختيار.بعض(فهرس_الرمز) -> {
                    طابق معلومات_إزاحة_ماتشو(&الإزاحة, فهرس_الرمز, صواب) مع
                    | اختيار.لا_شيء -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
                    | اختيار.بعض(المعلومات) -> { ألحق_غ32_صغير(&متغير البايتات, الإزاحة.إزاحة_بايت); ألحق_غ32_صغير(&متغير البايتات, المعلومات); };
                };
            }
            | هدف_إزاحة_ماتشو.قسم_محلي(ترتيب_القسم) -> {
                لو (ترتيب_القسم == 0 || ترتيب_القسم > عدد_الأقسام) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
                طابق معلومات_إزاحة_ماتشو(&الإزاحة, ترتيب_القسم, خطأ) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
                | اختيار.بعض(المعلومات) -> { ألحق_غ32_صغير(&متغير البايتات, الإزاحة.إزاحة_بايت); ألحق_غ32_صغير(&متغير البايتات, المعلومات); };
            };
            ه := ه + 1;
        }
        ف := ف + 1;
    }
    دع الحالي_قبل_الرموز: غير_موقع = الطول(البايتات) مثل غير_موقع; لو (إزاحة_الرموز > الحالي_قبل_الرموز) { ألحق_أصفارا(&متغير البايتات, إزاحة_الرموز - الحالي_قبل_الرموز); };
    دع س: متغير غير_موقع = 0;
    بينما (س < عدد_الرموز) {
        دع مرجع_الرمز: &رمز_ماتشو = &(*الكائن).الرموز[س];
        ألحق_غ32_صغير(&متغير البايتات, جدول_النصوص.إزاحات_الرموز[س]);
        طابق (*مرجع_الرمز).الموضع مع
        | موضع_رمز_ماتشو.معرف_في_قسم(فهرس_القسم, القيمة) -> {
            لو (فهرس_القسم >= عدد_الأقسام) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
            دع قيمة_الرمز: غير_موقع = عناوين_الأقسام[فهرس_القسم] + القيمة;
            ألحق_غ8(&متغير البايتات, 0x0F); ألحق_غ8(&متغير البايتات, فهرس_القسم + 1); ألحق_غ8(&متغير البايتات, 0); ألحق_غ8(&متغير البايتات, 0); ألحق_غ64_صغير(&متغير البايتات, قيمة_الرمز);
        }
        | موضع_رمز_ماتشو.غير_معرف -> { ألحق_غ8(&متغير البايتات, 0x01); ألحق_غ8(&متغير البايتات, 0); ألحق_غ8(&متغير البايتات, 0); ألحق_غ8(&متغير البايتات, 0); ألحق_غ64_صغير(&متغير البايتات, 0); };
        س := س + 1;
    }
    دع ن: متغير غير_موقع = 0; بينما (ن < حجم_جدول_النصوص) { ألحق_غ8(&متغير البايتات, جدول_النصوص.البيانات[ن] مثل غير_موقع); ن := ن + 1; }
    أرجع نتيجة_تسلسل_ماتشو.نجح(البايتات);
}

عام عرف اكتب_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(
    الشفرة: &شفرة_ذراع_أربعة_وستون_مشفرة,
    المرفقات: &مرفقات_كائن_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_CFI,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_تسلسل_ماتشو {
    طابق ابن_كائن_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(الشفرة, المرفقات, الهدف, دالة_الدخول, الرموز_الخارجية, خريطة_المصادر, أصول_المصدر, التصحيح, تصحيح_الآلة, سياق_الفك, الأنواع, سجل_التخطيط) مع
    | نتيجة_بناء_ماتشو.خطأ(الخطأ) -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(الخطأ); }
    | نتيجة_بناء_ماتشو.نجح(الكائن) -> { أرجع سلسل_كائن_ماتشو_ذراع_أربعة_وستون(&الكائن, الهدف); };
}

// ===== الإنهاء التنفيذي المقنن لـ Mach-O =====
// هذه الدالة تربط كائن Mach-O الذي كتبه هذا الملف نفسه إلى صورة MH_EXECUTE.
// لا تستدعي linker خارجي ولا تعيد طلبا وسيطا.
عام نوع خطأ_إنهاء_تنفيذي_ماتشو =
    | كائن_ماتشو_تنفيذي_غير_صالح
    | رمز_دخول_تنفيذي_ماتشو_مفقود
    | رمز_خارجي_تنفيذي_ماتشو_غير_مدعوم
    | إزاحة_تنفيذية_ماتشو_غير_مدعومة
    | إزاحة_تنفيذية_ماتشو_خارج_النطاق
    | توقيع_تنفيذي_ماتشو_فشل
;

عام نوع نتيجة_إنهاء_تنفيذي_ماتشو =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_إنهاء_تنفيذي_ماتشو
;

نوع قسم_كائن_ماتشو_تنفيذي = {
    موجود: منطقي,
    الفهرس: غير_موقع,
    العنوان: غير_موقع,
    الحجم: غير_موقع,
    إزاحة_الملف: غير_موقع,
    أس_المحاذاة: غير_موقع,
    إزاحة_الإزاحات: غير_موقع,
    عدد_الإزاحات: غير_موقع
};

نوع رمز_كائن_ماتشو_تنفيذي = {
    الاسم: متجه غ8,
    القسم: غير_موقع,
    القيمة: غير_موقع
};

عرف ضمن_حدود_ماتشو(البايتات: &متجه غ8, الموضع: غير_موقع, الحجم: غير_موقع): منطقي {
    دع الكل: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > الكل) { أرجع خطأ; };
    أرجع الحجم <= (الكل - الموضع);
}

عرف اقرأ_غ16_صغير_ماتشو(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع الموضع1: غير_موقع = الموضع + 1;
    دع ب0: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع ب1: غير_موقع = (*البايتات)[الموضع1] مثل غير_موقع;
    أرجع ب0 + ب1 * 256;
}

عرف اقرأ_غ32_صغير_ماتشو(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع الموضع1: غير_موقع = الموضع + 1;
    دع الموضع2: غير_موقع = الموضع + 2;
    دع الموضع3: غير_موقع = الموضع + 3;
    دع ب0: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع ب1: غير_موقع = (*البايتات)[الموضع1] مثل غير_موقع;
    دع ب2: غير_موقع = (*البايتات)[الموضع2] مثل غير_موقع;
    دع ب3: غير_موقع = (*البايتات)[الموضع3] مثل غير_موقع;
    أرجع ب0 + ب1 * 256 + ب2 * 65536 + ب3 * 16777216;
}

عرف اقرأ_غ64_صغير_ماتشو(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع الأدنى: غير_موقع = اقرأ_غ32_صغير_ماتشو(البايتات, الموضع);
    دع الأعلى: غير_موقع = اقرأ_غ32_صغير_ماتشو(البايتات, الموضع + 4);
    أرجع الأدنى + (الأعلى * 4294967296);
}

عرف ضع_غ32_صغير_ماتشو(البايتات: &متغير متجه غ8, الموضع: غير_موقع, القيمة: غير_موقع): منطقي {
    لو (!ضمن_حدود_ماتشو(البايتات, الموضع, 4)) { أرجع خطأ; };
    دع ق: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        دع موضع_الحالة: غير_موقع = الموضع + ف;
        (*البايتات)[موضع_الحالة] := (ق % 256) مثل غ8;
        ق := ق / 256;
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ضع_غ64_صغير_ماتشو(البايتات: &متغير متجه غ8, الموضع: غير_موقع, القيمة: غير_موقع): منطقي {
    لو (!ضمن_حدود_ماتشو(البايتات, الموضع, 8)) { أرجع خطأ; };
    دع ق: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        دع موضع_الحالة: غير_موقع = الموضع + ف;
        (*البايتات)[موضع_الحالة] := (ق % 256) مثل غ8;
        ق := ق / 256;
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اقرأ_اسم_صفري_ماتشو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار متجه غ8 {
    دع الكل: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع >= النهاية || النهاية > الكل) { أرجع اختيار.لا_شيء(); };
    دع الاسم: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = الموضع;
    بينما (ف < النهاية) {
        لو ((*البايتات)[ف] == 0) { أرجع اختيار.بعض(الاسم); };
        ألحق(الاسم, (*البايتات)[ف]);
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اسما_ماتشو_متساويان(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    لو ((الطول(*أ) مثل غير_موقع) != (الطول(*ب) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*أ) مثل غير_موقع)) {
        لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اسم_ثابت_ماتشو_يساوي(البايتات: &متجه غ8, الموضع: غير_موقع, الاسم: &متجه غ8): منطقي {
    لو (!ضمن_حدود_ماتشو(البايتات, الموضع, 16)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الاسم) مثل غير_موقع)) {
        دع موضع_الحالة: غير_موقع = الموضع + ف;
        لو (ف >= 16 || (*البايتات)[موضع_الحالة] != (*الاسم)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    لو (ف < 16) {
        دع موضع_النهاية: غير_موقع = الموضع + ف;
        لو ((*البايتات)[موضع_النهاية] != 0) { أرجع خطأ; };
    };
    أرجع صواب;
}

عرف ابحث_رمز_خارجي_ماتشو_تنفيذي(الخارجية: &متجه غير_موقع, فهرس_الرمز: غير_موقع): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الخارجية) مثل غير_موقع)) {
        لو ((*الخارجية)[ف] == فهرس_الرمز) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ألحق_غ32_كبير_ماتشو(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق_غ8(البايتات, (القيمة / 16777216) % 256);
    ألحق_غ8(البايتات, (القيمة / 65536) % 256);
    ألحق_غ8(البايتات, (القيمة / 256) % 256);
    ألحق_غ8(البايتات, القيمة % 256);
}

عرف ألحق_غ64_كبير_ماتشو(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ع: غير_موقع = القيمة / 4294967296;
    دع د: غير_موقع = القيمة % 4294967296;
    ألحق_غ32_كبير_ماتشو(البايتات, ع);
    ألحق_غ32_كبير_ماتشو(البايتات, د);
}

عرف دوران_يمين_غ32_ماتشو(القيمة: غير_موقع, المقدار: غير_موقع): غير_موقع {
    دع ق: غير_موقع = القيمة % 4294967296;
    دع م: غير_موقع = المقدار % 32;
    لو (م == 0) { أرجع ق; };
    دع يمين: غير_موقع = ق >> م;
    دع إزاحة_يسار: غير_موقع = 32 - م;
    دع المزاح_يسارا: غير_موقع = ق << إزاحة_يسار;
    دع يسار: غير_موقع = المزاح_يسارا % 4294967296;
    أرجع (يمين | يسار) % 4294967296;
}

عرف جمع_غ32_ماتشو(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    أرجع (أ + ب) % 4294967296;
}

عرف هاش_شا256_جزء_ماتشو(
    المصدر: &متجه غ8,
    البداية: غير_موقع,
    الحجم: غير_موقع
): اختيار متجه غ8 {
    لو (!ضمن_حدود_ماتشو(المصدر, البداية, الحجم)) { أرجع اختيار.لا_شيء(); };
    دع م: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        دع موضع_المصدر: غير_موقع = البداية + ف;
        ألحق(م, (*المصدر)[موضع_المصدر]);
        ف := ف + 1;
    }
    ألحق(م, 0x80 مثل غ8);
    بينما (((الطول(م) مثل غير_موقع) % 64) != 56) { ألحق(م, 0 مثل غ8); }
    دع طول_البتات: غير_موقع = الحجم * 8;
    دع ع: متغير غير_موقع = 0;
    بينما (ع < 8) {
        دع إزاحة: غير_موقع = 7 - ع;
        دع قاسم: متغير غير_موقع = 1;
        دع ك: متغير غير_موقع = 0;
        بينما (ك < إزاحة) { قاسم := قاسم * 256; ك := ك + 1; }
        ألحق(م, ((طول_البتات / قاسم) % 256) مثل غ8);
        ع := ع + 1;
    }

    دع الثوابت: متجه غير_موقع = [
        0x428A2F98,0x71374491,0xB5C0FBCF,0xE9B5DBA5,0x3956C25B,0x59F111F1,0x923F82A4,0xAB1C5ED5,
        0xD807AA98,0x12835B01,0x243185BE,0x550C7DC3,0x72BE5D74,0x80DEB1FE,0x9BDC06A7,0xC19BF174,
        0xE49B69C1,0xEFBE4786,0x0FC19DC6,0x240CA1CC,0x2DE92C6F,0x4A7484AA,0x5CB0A9DC,0x76F988DA,
        0x983E5152,0xA831C66D,0xB00327C8,0xBF597FC7,0xC6E00BF3,0xD5A79147,0x06CA6351,0x14292967,
        0x27B70A85,0x2E1B2138,0x4D2C6DFC,0x53380D13,0x650A7354,0x766A0ABB,0x81C2C92E,0x92722C85,
        0xA2BFE8A1,0xA81A664B,0xC24B8B70,0xC76C51A3,0xD192E819,0xD6990624,0xF40E3585,0x106AA070,
        0x19A4C116,0x1E376C08,0x2748774C,0x34B0BCB5,0x391C0CB3,0x4ED8AA4A,0x5B9CCA4F,0x682E6FF3,
        0x748F82EE,0x78A5636F,0x84C87814,0x8CC70208,0x90BEFFFA,0xA4506CEB,0xBEF9A3F7,0xC67178F2
    ];
    دع ه0: متغير غير_موقع = 0x6A09E667;
    دع ه1: متغير غير_موقع = 0xBB67AE85;
    دع ه2: متغير غير_موقع = 0x3C6EF372;
    دع ه3: متغير غير_موقع = 0xA54FF53A;
    دع ه4: متغير غير_موقع = 0x510E527F;
    دع ه5: متغير غير_موقع = 0x9B05688C;
    دع ه6: متغير غير_موقع = 0x1F83D9AB;
    دع ه7: متغير غير_موقع = 0x5BE0CD19;

    دع كتلة: متغير غير_موقع = 0;
    بينما (كتلة < (الطول(م) مثل غير_موقع)) {
        دع و: متغير متجه غير_موقع = [];
        ف := 0;
        بينما (ف < 64) { ألحق(و, 0); ف := ف + 1; }
        ف := 0;
        بينما (ف < 16) {
            دع موضع_الكلمة: غير_موقع = كتلة + ف * 4;
            دع موضع1: غير_موقع = موضع_الكلمة + 1;
            دع موضع2: غير_موقع = موضع_الكلمة + 2;
            دع موضع3: غير_موقع = موضع_الكلمة + 3;
            دع ب0: غير_موقع = م[موضع_الكلمة] مثل غير_موقع;
            دع ب1: غير_موقع = م[موضع1] مثل غير_موقع;
            دع ب2: غير_موقع = م[موضع2] مثل غير_موقع;
            دع ب3: غير_موقع = م[موضع3] مثل غير_موقع;
            و[ف] := (ب0 * 16777216) + (ب1 * 65536) + (ب2 * 256) + ب3;
            ف := ف + 1;
        }
        بينما (ف < 64) {
            دع ف_15: غير_موقع = ف - 15;
            دع ف_2: غير_موقع = ف - 2;
            دع ف_16: غير_موقع = ف - 16;
            دع ف_7: غير_موقع = ف - 7;
            دع س0: غير_موقع = دوران_يمين_غ32_ماتشو(و[ف_15], 7)
                ^ دوران_يمين_غ32_ماتشو(و[ف_15], 18)
                ^ (و[ف_15] >> 3);
            دع س1: غير_موقع = دوران_يمين_غ32_ماتشو(و[ف_2], 17)
                ^ دوران_يمين_غ32_ماتشو(و[ف_2], 19)
                ^ (و[ف_2] >> 10);
            و[ف] := جمع_غ32_ماتشو(جمع_غ32_ماتشو(جمع_غ32_ماتشو(و[ف_16], س0), و[ف_7]), س1);
            ف := ف + 1;
        }
        دع أ: متغير غير_موقع = ه0; دع ب: متغير غير_موقع = ه1;
        دع ج: متغير غير_موقع = ه2; دع د: متغير غير_موقع = ه3;
        دع هـ: متغير غير_موقع = ه4; دع و5: متغير غير_موقع = ه5;
        دع ز: متغير غير_موقع = ه6; دع ح: متغير غير_موقع = ه7;
        ف := 0;
        بينما (ف < 64) {
            دع س1أ: غير_موقع = دوران_يمين_غ32_ماتشو(هـ, 6) ^ دوران_يمين_غ32_ماتشو(هـ, 11) ^ دوران_يمين_غ32_ماتشو(هـ, 25);
            دع هـ_و5: غير_موقع = هـ & و5;
            دع مقلوب_هـ: غير_موقع = هـ ^ 0xFFFFFFFF;
            دع مقلوب_هـ_ز: غير_موقع = مقلوب_هـ & ز;
            دع اختيار_هـ: غير_موقع = هـ_و5 ^ مقلوب_هـ_ز;
            دع مؤقت1: غير_موقع = جمع_غ32_ماتشو(جمع_غ32_ماتشو(جمع_غ32_ماتشو(جمع_غ32_ماتشو(ح, س1أ), اختيار_هـ), الثوابت[ف]), و[ف]);
            دع س0أ: غير_موقع = دوران_يمين_غ32_ماتشو(أ, 2) ^ دوران_يمين_غ32_ماتشو(أ, 13) ^ دوران_يمين_غ32_ماتشو(أ, 22);
            دع أ_ب: غير_موقع = أ & ب;
            دع أ_ج: غير_موقع = أ & ج;
            دع ب_ج: غير_موقع = ب & ج;
            دع غالبية: غير_موقع = أ_ب ^ أ_ج ^ ب_ج;
            دع مؤقت2: غير_موقع = جمع_غ32_ماتشو(س0أ, غالبية);
            ح := ز; ز := و5; و5 := هـ; هـ := جمع_غ32_ماتشو(د, مؤقت1);
            د := ج; ج := ب; ب := أ; أ := جمع_غ32_ماتشو(مؤقت1, مؤقت2);
            ف := ف + 1;
        }
        ه0 := جمع_غ32_ماتشو(ه0, أ); ه1 := جمع_غ32_ماتشو(ه1, ب);
        ه2 := جمع_غ32_ماتشو(ه2, ج); ه3 := جمع_غ32_ماتشو(ه3, د);
        ه4 := جمع_غ32_ماتشو(ه4, هـ); ه5 := جمع_غ32_ماتشو(ه5, و5);
        ه6 := جمع_غ32_ماتشو(ه6, ز); ه7 := جمع_غ32_ماتشو(ه7, ح);
        كتلة := كتلة + 64;
    }

    دع الخرج: متغير متجه غ8 = [];
    دع الحالات: متجه غير_موقع = [ه0,ه1,ه2,ه3,ه4,ه5,ه6,ه7];
    ف := 0;
    بينما (ف < 8) {
        ألحق_غ8(&متغير الخرج, (الحالات[ف] / 16777216) % 256);
        ألحق_غ8(&متغير الخرج, (الحالات[ف] / 65536) % 256);
        ألحق_غ8(&متغير الخرج, (الحالات[ف] / 256) % 256);
        ألحق_غ8(&متغير الخرج, الحالات[ف] % 256);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الخرج);
}

عرف ألحق_يو_ليب_ماتشو(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ق: متغير غير_موقع = القيمة;
    بينما (صواب) {
        دع بايت: متغير غير_موقع = ق % 128;
        ق := ق / 128;
        لو (ق != 0) { بايت := بايت + 128; };
        ألحق_غ8(البايتات, بايت);
        لو (ق == 0) { أرجع; };
    }
}

عرف ألحق_مسار_ماتشو(البايتات: &متغير متجه غ8, المسار: &متجه غ8): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المسار) مثل غير_موقع)) { ألحق(*البايتات, (*المسار)[ف]); ف := ف + 1; }
    ألحق_غ8(البايتات, 0);
}

عرف أكمل_ماتشو_إلى(البايتات: &متغير متجه غ8, الموضع: غير_موقع): منطقي {
    دع الحالي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الحالي > الموضع) { أرجع خطأ; };
    ألحق_أصفارا(البايتات, الموضع - الحالي);
    أرجع صواب;
}

عرف ألحق_مقطع_ماتشو_تنفيذي(
    البايتات: &متغير متجه غ8,
    الاسم: &متجه غ8,
    العنوان: غير_موقع,
    حجم_افتراضي: غير_موقع,
    إزاحة_الملف: غير_موقع,
    حجم_الملف: غير_موقع,
    الحماية_القصوى: غير_موقع,
    الحماية_الأولية: غير_موقع,
    عدد_الأقسام: غير_موقع
): منطقي {
    ألحق_غ32_صغير(البايتات, 0x19);
    ألحق_غ32_صغير(البايتات, 72 + عدد_الأقسام * 80);
    لو (!ألحق_حقل_اسم_ستة_عشر(البايتات, الاسم)) { أرجع خطأ; };
    ألحق_غ64_صغير(البايتات, العنوان); ألحق_غ64_صغير(البايتات, حجم_افتراضي);
    ألحق_غ64_صغير(البايتات, إزاحة_الملف); ألحق_غ64_صغير(البايتات, حجم_الملف);
    ألحق_غ32_صغير(البايتات, الحماية_القصوى); ألحق_غ32_صغير(البايتات, الحماية_الأولية);
    ألحق_غ32_صغير(البايتات, عدد_الأقسام); ألحق_غ32_صغير(البايتات, 0);
    أرجع صواب;
}

عرف ألحق_قسم_ماتشو_تنفيذي(
    البايتات: &متغير متجه غ8,
    الاسم: &متجه غ8,
    المقطع: &متجه غ8,
    العنوان: غير_موقع,
    الحجم: غير_موقع,
    الإزاحة: غير_موقع,
    أس_المحاذاة: غير_موقع,
    الأعلام: غير_موقع
): منطقي {
    لو (!ألحق_حقل_اسم_ستة_عشر(البايتات, الاسم) || !ألحق_حقل_اسم_ستة_عشر(البايتات, المقطع)) { أرجع خطأ; };
    ألحق_غ64_صغير(البايتات, العنوان); ألحق_غ64_صغير(البايتات, الحجم);
    ألحق_غ32_صغير(البايتات, الإزاحة); ألحق_غ32_صغير(البايتات, أس_المحاذاة);
    ألحق_غ32_صغير(البايتات, 0); ألحق_غ32_صغير(البايتات, 0);
    ألحق_غ32_صغير(البايتات, الأعلام); ألحق_غ32_صغير(البايتات, 0);
    ألحق_غ32_صغير(البايتات, 0); ألحق_غ32_صغير(البايتات, 0);
    أرجع صواب;
}

عرف كود_إزاحة_صفحة_ذراع_ماتشو(المصدر: غير_موقع, الوجهة: غير_موقع): اختيار غير_موقع {
    دع صفحة_من: غير_موقع = المصدر / 4096;
    دع صفحة_إلى: غير_موقع = الوجهة / 4096;
    لو (صفحة_إلى >= صفحة_من) {
        دع الفرق: غير_موقع = صفحة_إلى - صفحة_من;
        لو (الفرق > 0xFFFFF) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الفرق);
    };
    دع المقدار: غير_موقع = صفحة_من - صفحة_إلى;
    لو (المقدار > 0x100000) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(0x200000 - المقدار);
}

عرف رقع_فرع26_ماتشو(البايتات: &متغير متجه غ8, الموضع: غير_موقع, المصدر: غير_موقع, الوجهة: غير_موقع): منطقي {
    لو (!ضمن_حدود_ماتشو(البايتات, الموضع, 4)) { أرجع خطأ; };
    دع قيمة: متغير غير_موقع = 0;
    لو (الوجهة >= المصدر) {
        دع فرق: غير_موقع = الوجهة - المصدر;
        لو ((فرق % 4) != 0 || (فرق / 4) > 0x1FFFFFF) { أرجع خطأ; };
        قيمة := فرق / 4;
    } وإلا {
        دع فرق: غير_موقع = المصدر - الوجهة;
        لو ((فرق % 4) != 0 || (فرق / 4) > 0x2000000) { أرجع خطأ; };
        قيمة := (0x4000000 - (فرق / 4)) % 0x4000000;
    };
    دع الأصل: غير_موقع = اقرأ_غ32_صغير_ماتشو(البايتات, الموضع);
    دع جزء_الأصل: غير_موقع = الأصل & 0xFC000000;
    دع جزء_القيمة: غير_موقع = قيمة & 0x03FFFFFF;
    دع الجديد: غير_موقع = جزء_الأصل | جزء_القيمة;
    أرجع ضع_غ32_صغير_ماتشو(البايتات, الموضع, الجديد);
}

عرف رقع_صفحة21_ماتشو(البايتات: &متغير متجه غ8, الموضع: غير_موقع, المصدر: غير_موقع, الوجهة: غير_موقع): منطقي {
    طابق كود_إزاحة_صفحة_ذراع_ماتشو(المصدر, الوجهة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> {
        دع الأصل: غير_موقع = اقرأ_غ32_صغير_ماتشو(البايتات, الموضع);
        دع جزء_الأصل: غير_موقع = الأصل & 0x9F00001F;
        دع قيمة_منخفضة: غير_موقع = القيمة & 3;
        دع جزء_منخفض: غير_موقع = قيمة_منخفضة << 29;
        دع قيمة_مزاحة: غير_موقع = القيمة >> 2;
        دع قيمة_عليا: غير_موقع = قيمة_مزاحة & 0x7FFFF;
        دع جزء_علوي: غير_موقع = قيمة_عليا << 5;
        دع مؤقت: غير_موقع = جزء_الأصل | جزء_منخفض;
        دع الجديد: غير_موقع = مؤقت | جزء_علوي;
        أرجع ضع_غ32_صغير_ماتشو(البايتات, الموضع, الجديد);
    };
}

عرف رقع_صفحة12_ماتشو(البايتات: &متغير متجه غ8, الموضع: غير_موقع, الوجهة: غير_موقع): منطقي {
    دع الأصل: غير_موقع = اقرأ_غ32_صغير_ماتشو(البايتات, الموضع);
    دع المنخفض: غير_موقع = الوجهة % 4096;
    دع جزء_الأصل: غير_موقع = الأصل & 0xFFC003FF;
    دع فئة_تحميل_تخزين: غير_موقع = الأصل & 0x3B000000;
    دع قيمة_فورية: متغير غير_موقع = المنخفض;
    لو (فئة_تحميل_تخزين == 0x39000000) {
        دع الأصل_مزاح: غير_موقع = الأصل >> 30;
        دع أس_المقياس: غير_موقع = الأصل_مزاح & 3;
        دع المقياس: غير_موقع = 1 << أس_المقياس;
        لو ((المنخفض % المقياس) != 0) { أرجع خطأ; };
        قيمة_فورية := المنخفض / المقياس;
    };
    دع منخفض_مقنع: غير_موقع = قيمة_فورية & 0xFFF;
    دع جزء_المنخفض: غير_موقع = منخفض_مقنع << 10;
    دع الجديد: غير_موقع = جزء_الأصل | جزء_المنخفض;
    أرجع ضع_غ32_صغير_ماتشو(البايتات, الموضع, الجديد);
}

عرف ابن_توقيع_أدهوك_ماتشو(الصورة: &متجه غ8): اختيار متجه غ8 {
    دع حد_الكود: غير_موقع = الطول(*الصورة) مثل غير_موقع;
    دع حجم_الصفحة: غير_موقع = 4096;
    دع حد_مع_صفحة: غير_موقع = حد_الكود + حجم_الصفحة;
    دع حد_مدور: غير_موقع = حد_مع_صفحة - 1;
    دع عدد_الصفحات: غير_موقع = حد_مدور / حجم_الصفحة;
    دع المعرف: متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0];
    دع طول_المعرف: غير_موقع = الطول(المعرف) مثل غير_موقع;
    دع موضع_المعرف: غير_موقع = 44;
    دع موضع_الهاش: غير_موقع = موضع_المعرف + طول_المعرف;
    دع حجم_دليل_الكود: غير_موقع = موضع_الهاش + عدد_الصفحات * 32;
    دع الحجم_الكلي: غير_موقع = 20 + حجم_دليل_الكود;
    لو (حد_الكود > 0xFFFFFFFF || الحجم_الكلي > 0xFFFFFFFF) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8 = [];
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, 0xFADE0CC0);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, الحجم_الكلي);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, 1);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, 0);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, 20);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, 0xFADE0C02);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, حجم_دليل_الكود);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, 0x00020001);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, 0x00000002);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, موضع_الهاش);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, موضع_المعرف);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, 0);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, عدد_الصفحات);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, حد_الكود);
    ألحق_غ8(&متغير الناتج, 32); ألحق_غ8(&متغير الناتج, 2);
    ألحق_غ8(&متغير الناتج, 0); ألحق_غ8(&متغير الناتج, 12);
    ألحق_غ32_كبير_ماتشو(&متغير الناتج, 0);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المعرف) مثل غير_موقع)) { ألحق(الناتج, المعرف[ف]); ف := ف + 1; }
    دع صفحة: متغير غير_موقع = 0;
    بينما (صفحة < عدد_الصفحات) {
        دع البداية: غير_موقع = صفحة * حجم_الصفحة;
        دع باقي: غير_موقع = حد_الكود - البداية;
        دع الحجم: متغير غير_موقع = حجم_الصفحة;
        لو (باقي < الحجم) { الحجم := باقي; };
        طابق هاش_شا256_جزء_ماتشو(الصورة, البداية, الحجم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الهاش) -> {
            ف := 0;
            بينما (ف < (الطول(الهاش) مثل غير_موقع)) { ألحق(الناتج, الهاش[ف]); ف := ف + 1; }
        };
        صفحة := صفحة + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف اسم_خارجي_معلن_ماتشو(
    الاسم: &متجه غ8,
    المعلنة: &متجه متجه غ8
): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المعلنة) مثل غير_موقع)) {
        دع اسم_ماتشو: متجه غ8 = اسم_رمز_خارجي_ماتشو(&(*المعلنة)[ف]);
        لو (اسما_ماتشو_متساويان(الاسم, &اسم_ماتشو)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف أنه_كائن_ماتشو_داروين_إلى_تنفيذي(
    بايتات_الكائن: &متجه غ8,
    دوارف: &متغير حزمة_دوارف,
    الهدف: &واصف_هدف,
    الرموز_الخارجية_المعلنة: &متجه متجه غ8
): نتيجة_إنهاء_تنفيذي_ماتشو {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> { }
    | _ -> { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    لو (!ضمن_حدود_ماتشو(بايتات_الكائن, 0, 32)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
    لو (اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, 0) != 0xFEEDFACF
        || اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, 4) != 0x0100000C
        || اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, 12) != 1) {
        أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح());
    };
    دع عدد_الأوامر: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, 16);
    دع حجم_الأوامر: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, 20);
    لو (!ضمن_حدود_ماتشو(بايتات_الكائن, 32, حجم_الأوامر)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };

    دع فارغ_قسم: قسم_كائن_ماتشو_تنفيذي = { موجود: خطأ, الفهرس: 0, العنوان: 0, الحجم: 0, إزاحة_الملف: 0, أس_المحاذاة: 0, إزاحة_الإزاحات: 0, عدد_الإزاحات: 0 };
    دع النص: متغير قسم_كائن_ماتشو_تنفيذي = فارغ_قسم;
    دع الثوابت: متغير قسم_كائن_ماتشو_تنفيذي = فارغ_قسم;
    دع السلاسل: متغير قسم_كائن_ماتشو_تنفيذي = فارغ_قسم;
    دع البيانات_الأصلية: متغير قسم_كائن_ماتشو_تنفيذي = فارغ_قسم;
    دع المشترك: متغير قسم_كائن_ماتشو_تنفيذي = فارغ_قسم;
    دع بي_اس_اس: متغير قسم_كائن_ماتشو_تنفيذي = فارغ_قسم;
    دع موضع_الرموز: متغير غير_موقع = 0; دع عدد_الرموز: متغير غير_موقع = 0;
    دع موضع_النصوص: متغير غير_موقع = 0; دع حجم_النصوص: متغير غير_موقع = 0;
    دع وجد_جدول_رموز: متغير منطقي = خطأ;
    دع ترتيب_قسم: متغير غير_موقع = 0;
    دع موضع: متغير غير_موقع = 32;
    دع أمر: متغير غير_موقع = 0;
    دع اسم_نص_ثابت: متجه غ8 = [0x5F,0x5F,0x74,0x65,0x78,0x74];
    دع اسم_ثوابت_ثابت: متجه غ8 = [0x5F,0x5F,0x63,0x6F,0x6E,0x73,0x74];
    دع اسم_سلاسل_ثابت: متجه غ8 = [0x5F,0x5F,0x63,0x73,0x74,0x72,0x69,0x6E,0x67];
    دع اسم_بيانات_ثابت: متجه غ8 = [0x5F,0x5F,0x64,0x61,0x74,0x61];
    دع اسم_مشترك_ثابت: متجه غ8 = [0x5F,0x5F,0x63,0x6F,0x6D,0x6D,0x6F,0x6E];
    دع اسم_بي_اس_اس_ثابت: متجه غ8 = [0x5F,0x5F,0x62,0x73,0x73];
    بينما (أمر < عدد_الأوامر) {
        لو (!ضمن_حدود_ماتشو(بايتات_الكائن, موضع, 8)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
        دع النوع: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع);
        دع الحجم: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع + 4);
        لو (الحجم < 8 || !ضمن_حدود_ماتشو(بايتات_الكائن, موضع, الحجم)) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
        لو (النوع == 0x19) {
            لو (الحجم < 72) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
            دع عدد_الأقسام: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع + 64);
            لو (72 + عدد_الأقسام * 80 != الحجم) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
            دع ق: متغير غير_موقع = 0;
            بينما (ق < عدد_الأقسام) {
                دع م: غير_موقع = موضع + 72 + ق * 80;
                ترتيب_قسم := ترتيب_قسم + 1;
                دع موضع_عنوان_القسم: غير_موقع = م + 32;
                دع موضع_حجم_القسم: غير_موقع = م + 40;
                دع موضع_إزاحة_ملف_القسم: غير_موقع = م + 48;
                دع موضع_محاذاة_القسم: غير_موقع = م + 52;
                دع موضع_إزاحات_القسم: غير_موقع = م + 56;
                دع موضع_عدد_إزاحات_القسم: غير_موقع = م + 60;
                دع موضع_أعلام_القسم: غير_موقع = م + 64;
                دع عنوان_القسم: غير_موقع = اقرأ_غ64_صغير_ماتشو(بايتات_الكائن, موضع_عنوان_القسم);
                دع حجم_القسم: غير_موقع = اقرأ_غ64_صغير_ماتشو(بايتات_الكائن, موضع_حجم_القسم);
                دع إزاحة_ملف_القسم: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع_إزاحة_ملف_القسم);
                دع محاذاة_القسم: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع_محاذاة_القسم);
                لو (محاذاة_القسم > 20) {
                    أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح());
                };
                دع إزاحات_القسم: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع_إزاحات_القسم);
                دع عدد_إزاحات_القسم: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع_عدد_إزاحات_القسم);
                دع أعلام_القسم: غير_موقع = اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع_أعلام_القسم);
                دع نوع_القسم: غير_موقع = أعلام_القسم & 0xFF;
                دع قسم_صفري: منطقي = نوع_القسم == 1 || نوع_القسم == 0xC || نوع_القسم == 0x12;
                دع وصف: قسم_كائن_ماتشو_تنفيذي = {
                    موجود: صواب, الفهرس: ترتيب_قسم,
                    العنوان: عنوان_القسم,
                    الحجم: حجم_القسم,
                    إزاحة_الملف: إزاحة_ملف_القسم,
                    أس_المحاذاة: محاذاة_القسم,
                    إزاحة_الإزاحات: إزاحات_القسم,
                    عدد_الإزاحات: عدد_إزاحات_القسم
                };
                لو ((!قسم_صفري && !ضمن_حدود_ماتشو(بايتات_الكائن, وصف.إزاحة_الملف, وصف.الحجم))
                    || !ضمن_حدود_ماتشو(بايتات_الكائن, وصف.إزاحة_الإزاحات, وصف.عدد_الإزاحات * 8)) {
                    أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح());
                };
                لو (اسم_ثابت_ماتشو_يساوي(بايتات_الكائن, م, &اسم_نص_ثابت)) {
                    لو (النص.موجود) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
                    النص := وصف;
                };
                لو (اسم_ثابت_ماتشو_يساوي(بايتات_الكائن, م, &اسم_ثوابت_ثابت)) {
                    لو (الثوابت.موجود) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
                    الثوابت := وصف;
                };
                لو (اسم_ثابت_ماتشو_يساوي(بايتات_الكائن, م, &اسم_سلاسل_ثابت)) {
                    لو (السلاسل.موجود) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
                    السلاسل := وصف;
                };
                لو (اسم_ثابت_ماتشو_يساوي(بايتات_الكائن, م, &اسم_بيانات_ثابت)) {
                    لو (البيانات_الأصلية.موجود) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
                    البيانات_الأصلية := وصف;
                };
                لو (اسم_ثابت_ماتشو_يساوي(بايتات_الكائن, م, &اسم_مشترك_ثابت)) {
                    لو (المشترك.موجود) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
                    المشترك := وصف;
                };
                لو (اسم_ثابت_ماتشو_يساوي(بايتات_الكائن, م, &اسم_بي_اس_اس_ثابت)) {
                    لو (بي_اس_اس.موجود) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
                    بي_اس_اس := وصف;
                };
                ق := ق + 1;
            }
        } وإلا لو (النوع == 2) {
            لو (الحجم != 24 || وجد_جدول_رموز) { أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح()); };
            وجد_جدول_رموز := صواب;
            موضع_الرموز := اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع + 8);
            عدد_الرموز := اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع + 12);
            موضع_النصوص := اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع + 16);
            حجم_النصوص := اقرأ_غ32_صغير_ماتشو(بايتات_الكائن, موضع + 20);
        };
        موضع := موضع + الحجم; أمر := أمر + 1;
    }
    لو (موضع != 32 + حجم_الأوامر) {
        أرجع نتيجة_إنهاء_تنفيذي_ماتشو.خطأ(خطأ_إنهاء_تنفيذي_ماتشو.كائن_ماتشو_تنفيذي_غير_صالح());
    };
    لو (!النص.موجود || !وجد_جدول_رموز
        || !ضمن_حدود_ماتشو(بايتات_الكائن, موضع_الرموز, عدد_الرموز * 16)
