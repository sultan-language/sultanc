    | اختيار.لا_شيء -> { };

    دع الرموز_المرتبة: متجه رمز_ماتشو = رتب_رموز_ماتشو_المعرفة_أولا(&الرموز);
    الرموز := الرموز_المرتبة;
    دع عدد_الرموز_المعرفة: متغير غير_موقع = 0;
