        };
        لو ((*مرجع_الطلب).الموضع.إزاحة_بايت + حجم_الحقل > حجم_الدالة) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح((*مرجع_الطلب).الموضع.الدالة)); };
        دع نوع_ماتشو: نوع_إزاحة_ماتشو = نوع_إزاحة_ماتشو_من_مشترك((*مرجع_الطلب).النوع);
