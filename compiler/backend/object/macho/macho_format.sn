        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    لو ((الطول(حزمة_دوارف_الماتشو.سلاسل) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام, اسم_سلاسل,
        &متغير حزمة_دوارف_الماتشو.سلاسل, 0, اختيار.لا_شيء(), قسم_بيانات_دوارف.سلاسل(),
        &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف,
        ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    لو ((الطول(حزمة_دوارف_الماتشو.عناوين) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام, اسم_عناوين,
        &متغير حزمة_دوارف_الماتشو.عناوين, 3, اختيار.بعض(قسم_عنوان_دوارف.عناوين()), قسم_بيانات_دوارف.عناوين(),
        &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف,
        ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    لو ((الطول(حزمة_دوارف_الماتشو.مواقع) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_دوارف_مواقع, &متغير حزمة_دوارف_الماتشو.مواقع, 0, اختيار.بعض(قسم_عنوان_دوارف.مواقع()),
        قسم_بيانات_دوارف.مواقع(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    لو ((الطول(حزمة_دوارف_الماتشو.قوائم_مواقع) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_قوائم_مواقع, &متغير حزمة_دوارف_الماتشو.قوائم_مواقع, 0, اختيار.بعض(قسم_عنوان_دوارف.قوائم_مواقع()),
        قسم_بيانات_دوارف.قوائم_مواقع(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    لو ((الطول(حزمة_دوارف_الماتشو.إطار) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_دوارف_إطار, &متغير حزمة_دوارف_الماتشو.إطار, 3, اختيار.بعض(قسم_عنوان_دوارف.إطار()),
        قسم_بيانات_دوارف.إطار(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    لو ((الطول(حزمة_دوارف_الماتشو.نطاقات_عناوين) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_دوارف_نطاقات, &متغير حزمة_دوارف_الماتشو.نطاقات_عناوين, 3,
        اختيار.بعض(قسم_عنوان_دوارف.نطاقات_عناوين()), قسم_بيانات_دوارف.نطاقات_عناوين(),
        &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف,
