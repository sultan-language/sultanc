عام عرف سلسل_كائن_ماتشو_ذراع_أربعة_وستون(الكائن: &كائن_ماتشو, الهدف: &واصف_هدف): نتيجة_تسلسل_ماتشو {
    لو (!معرفا_هدف_متساويان((*الكائن).الهدف, (*الهدف).المعرف)) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق((*الكائن).الهدف)); };
    طابق (*الهدف).صيغة_الكائن مع | صيغة_كائن_هدف.ماتشو -> { } | صيغة_كائن_هدف.إلف -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق((*الهدف).المعرف)); };
    دع عدد_الأقسام: غير_موقع = الطول((*الكائن).الأقسام) مثل غير_موقع;
    لو (عدد_الأقسام == 0 || عدد_الأقسام > 16) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.قسم_نص_مفقود()); };
    دع عدد_الرموز: غير_موقع = الطول((*الكائن).الرموز) مثل غير_موقع;
    لو (عدد_الرموز > 0xFFFFFFFF || (*الكائن).عدد_الرموز_المعرفة > عدد_الرموز) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    دع جدول_النصوص: جدول_نصوص_ماتشو = ابن_جدول_نصوص_ماتشو(&(*الكائن).الرموز);
    دع حجم_جدول_النصوص: غير_موقع = الطول(جدول_النصوص.البيانات) مثل غير_موقع;
    دع حجم_أمر_المقطع: غير_موقع = 72 + (عدد_الأقسام * 80);
