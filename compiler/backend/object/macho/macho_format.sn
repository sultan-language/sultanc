استورد compiler.backend.target.executable_symbol_query_context;
استورد compiler.backend.target.runtime_primitive_symbol_query_context;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_symbol_query_context;
استورد compiler.backend.target.host_facility_query_context;
استورد compiler.backend.architectures.arm64.encoded_code;
استورد compiler.backend.object.object_reference_model;
استورد compiler.backend.object.macho.macho_model;
استورد compiler.backend.object.macho.macho_writer;

عام نوع نتيجة_بناء_ماتشو =
    | نجح بنوع كائن_ماتشو
    | خطأ بنوع خطأ_ماتشو
;

عام نوع نتيجة_تسلسل_ماتشو =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_ماتشو
;

عرف ألحق_غ8(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: غير_موقع = القيمة % 256;
    دع البايت: غ8 = الباقي مثل غ8;
    دع ب: متغير متجه غ8 = *البايتات;
    ألحق(ب, البايت);
    *البايتات := ب;
}

عرف ألحق_غ32_صغير(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        ألحق_غ8(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_غ64_صغير(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        ألحق_غ8(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_أصفارا(البايتات: &متغير متجه غ8, العدد: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق_غ8(البايتات, 0);
        ف := ف + 1;
    }
}

عرف حاذ_لأعلى(القيمة: غير_موقع, المحاذاة: غير_موقع): غير_موقع {
    لو (المحاذاة == 0) { أرجع القيمة; };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + (المحاذاة - الباقي);
}

عرف قوة_اثنين_ماتشو(الأس: غير_موقع): اختيار غير_موقع {
    لو (الأس > 20) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير غير_موقع = 1;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الأس) { الناتج := الناتج * 2; ف := ف + 1; }
    أرجع اختيار.بعض(الناتج);
}

عرف ألحق_اسم_نص(البايتات: &متغير متجه غ8): فراغ {
    ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x74);
    ألحق_غ8(البايتات, 0x65); ألحق_غ8(البايتات, 0x78); ألحق_غ8(البايتات, 0x74);
}

عرف ألحق_اسم_ثوابت(البايتات: &متغير متجه غ8): فراغ {
    ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x63);
    ألحق_غ8(البايتات, 0x6F); ألحق_غ8(البايتات, 0x6E); ألحق_غ8(البايتات, 0x73); ألحق_غ8(البايتات, 0x74);
}

عرف ألحق_اسم_مقطع_نص(البايتات: &متغير متجه غ8): فراغ {
    ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x5F); ألحق_غ8(البايتات, 0x54);
    ألحق_غ8(البايتات, 0x45); ألحق_غ8(البايتات, 0x58); ألحق_غ8(البايتات, 0x54);
}

عرف اسم_قسم_نص(): متجه غ8 { دع ب: متغير متجه غ8 = []; ألحق_اسم_نص(&متغير ب); أرجع ب; }
عرف اسم_قسم_ثوابت(): متجه غ8 { دع ب: متغير متجه غ8 = []; ألحق_اسم_ثوابت(&متغير ب); أرجع ب; }
عرف اسم_مقطع_نص(): متجه غ8 { دع ب: متغير متجه غ8 = []; ألحق_اسم_مقطع_نص(&متغير ب); أرجع ب; }

عرف بايت_سداسي(القيمة: غير_موقع): غ8 {
    لو (القيمة < 10) { دع الخام: غير_موقع = 0x30 + القيمة; أرجع الخام مثل غ8; };
    دع الخام: غير_موقع = 0x61 + (القيمة - 10);
    أرجع الخام مثل غ8;
}

عرف ألحق_معرف_سداسي_ماتشو(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع القاسم: متغير غير_موقع = 0x1000000000000000;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 16) {
        دع المقسوم: غير_موقع = القيمة / القاسم;
        دع الرقم: غير_موقع = المقسوم % 16;
        دع البايت: غ8 = بايت_سداسي(الرقم);
        دع الحالة: متغير متجه غ8 = *البايتات;
        ألحق(الحالة, البايت);
        *البايتات := الحالة;
        لو (القاسم > 1) { القاسم := القاسم / 16; };
        ف := ف + 1;
    }
}

عرف اسم_رمز_دالة(المعرف: معرف_دالة_منتقاة): متجه غ8 {
    دع البايتات: متغير متجه غ8 = [0x5F,0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x66,0x6E,0x5F];
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.القيمة);
    أرجع البايتات;
}

عرف اسم_رمز_بيانات(المعرف: معرف_بيانات_ثابتة_كائن): متجه غ8 {
    دع البايتات: متغير متجه غ8 = [0x5F,0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x64,0x61,0x74,0x61,0x5F];
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.الدالة.القيمة);
    ألحق_غ8(&متغير البايتات, 0x5F);
    ألحق_معرف_سداسي_ماتشو(&متغير البايتات, المعرف.القيمة);
    أرجع البايتات;
}

عرف اسم_رمز_خارجي_ماتشو(الاسم: &متجه غ8): متجه غ8 {
    // Mach-O C ABI prefixes external C symbol names with an underscore.
    دع المصدر: متجه غ8 = *الاسم;
    دع الناتج: متغير متجه غ8 = [0x5F];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        ألحق(الناتج, المصدر[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اسم_مرجع_رمز_ماتشو(
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه غ8
): اختيار متجه غ8 {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> { أرجع اختيار.بعض(اسم_رمز_دالة(الدالة)); }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> {
        طابق اسم_رمز_خارجي_كائن_من_جدول(المعرف, الرموز_الخارجية) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> { أرجع اختيار.بعض(اسم_رمز_خارجي_ماتشو(&الاسم)); };
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(البيانات) -> { أرجع اختيار.بعض(اسم_رمز_بيانات(البيانات)); }
    | مرجع_رمز_كائن.خدمة_تشغيل(الخدمة) -> { أرجع اسم_رمز_خدمة_تشغيل_للهدف(الهدف, الخدمة); }
    | مرجع_رمز_كائن.مرفق_مضيف(المرفق) -> { أرجع اسم_رمز_مرفق_مضيف_للهدف(الهدف, المرفق); }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> { أرجع اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي); };
}

عرف رتب_مؤشرات_دوال_مشفرة(الدوال: &متجه دالة_ذراع_أربعة_وستون_مشفرة): متجه غير_موقع {
    دع د: متجه دالة_ذراع_أربعة_وستون_مشفرة = *الدوال;
    دع المؤشرات: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(د) مثل غير_موقع)) { ألحق(المؤشرات, ف); ف := ف + 1; }
    دع أ: متغير غير_موقع = 0;
    بينما (أ < (الطول(المؤشرات) مثل غير_موقع)) {
        دع ب: متغير غير_موقع = أ + 1;
        بينما (ب < (الطول(المؤشرات) مثل غير_موقع)) {
            دع فهرس_أ: غير_موقع = المؤشرات[أ]; دع فهرس_ب: غير_موقع = المؤشرات[ب];
            لو (د[فهرس_ب].المعرف.القيمة < د[فهرس_أ].المعرف.القيمة) {
                دع مؤقت: غير_موقع = المؤشرات[أ]; المؤشرات[أ] := المؤشرات[ب]; المؤشرات[ب] := مؤقت;
            };
            ب := ب + 1;
        }
        أ := أ + 1;
    }
    أرجع المؤشرات;
}

عرف رتب_مؤشرات_بيانات_ثابتة_ماتشو(البيانات: &متجه بيانات_ثابتة_كائن): متجه غير_موقع {
    دع د: متجه بيانات_ثابتة_كائن = *البيانات;
    دع المؤشرات: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(د) مثل غير_موقع)) { ألحق(المؤشرات, ف); ف := ف + 1; }
    دع أ: متغير غير_موقع = 0;
    بينما (أ < (الطول(المؤشرات) مثل غير_موقع)) {
        دع ب: متغير غير_موقع = أ + 1;
        بينما (ب < (الطول(المؤشرات) مثل غير_موقع)) {
            دع فهرس_أ: غير_موقع = المؤشرات[أ]; دع فهرس_ب: غير_موقع = المؤشرات[ب];
            دع معرف_أ: معرف_بيانات_ثابتة_كائن = د[فهرس_أ].المعرف;
            دع معرف_ب: معرف_بيانات_ثابتة_كائن = د[فهرس_ب].المعرف;
            دع ب_أصغر: منطقي = معرف_ب.الدالة.القيمة < معرف_أ.الدالة.القيمة
                || (معرف_ب.الدالة.القيمة == معرف_أ.الدالة.القيمة && معرف_ب.القيمة < معرف_أ.القيمة);
            لو (ب_أصغر) {
                دع مؤقت: غير_موقع = المؤشرات[أ]; المؤشرات[أ] := المؤشرات[ب]; المؤشرات[ب] := مؤقت;
            };
            ب := ب + 1;
        }
        أ := أ + 1;
    }
    أرجع المؤشرات;
}

عرف اسم_ماتشو_أصغر(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    دع س: متجه غ8 = *أ;
    دع ص: متجه غ8 = *ب;
    دع طول_س: غير_موقع = الطول(س) مثل غير_موقع;
    دع طول_ص: غير_موقع = الطول(ص) مثل غير_موقع;
    دع الحد: متغير غير_موقع = طول_س;
    لو (طول_ص < الحد) { الحد := طول_ص; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحد) {
        لو (س[ف] < ص[ف]) { أرجع صواب; };
        لو (س[ف] > ص[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع طول_س < طول_ص;
}

عرف ابحث_رمز_ماتشو(الرموز: &متجه رمز_ماتشو, المرجع: &مرجع_رمز_كائن): اختيار غير_موقع {
    دع ر: متجه رمز_ماتشو = *الرموز;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ر) مثل غير_موقع)) {
        دع مرجع_الحالي: &مرجع_رمز_كائن = &ر[ف].المرجع;
        لو (مرجعا_رمز_كائن_متساويان(مرجع_الحالي, المرجع)) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف هل_موضع_رمز_ماتشو_معرف(الموضع: موضع_رمز_ماتشو): منطقي {
    طابق الموضع مع
    | موضع_رمز_ماتشو.معرف_في_قسم(_, _) -> { أرجع صواب; }
    | موضع_رمز_ماتشو.غير_معرف -> { أرجع خطأ; };
}

عرف أضف_رمز_ماتشو_إن_غاب(
    الرموز: &متغير متجه رمز_ماتشو,
    المرجع: مرجع_رمز_كائن,
    الموضع: موضع_رمز_ماتشو,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه غ8
): نتيجة منطقي, خطأ_ماتشو {
    طابق ابحث_رمز_ماتشو(الرموز, &المرجع) مع
    | اختيار.بعض(الفهرس) -> {
        دع الحالة: متغير متجه رمز_ماتشو = *الرموز;
        دع القديم_معرف: منطقي = هل_موضع_رمز_ماتشو_معرف(الحالة[الفهرس].الموضع);
        دع الجديد_معرف: منطقي = هل_موضع_رمز_ماتشو_معرف(الموضع);
        لو (القديم_معرف && الجديد_معرف) {
            أرجع نتيجة.نجح(خطأ);
        };
        لو ((!القديم_معرف) && الجديد_معرف) {
            الحالة[الفهرس].الموضع := الموضع;
            *الرموز := الحالة;
        };
        أرجع نتيجة.نجح(صواب);
    }
    | اختيار.لا_شيء -> { };
    طابق اسم_مرجع_رمز_ماتشو(&المرجع, الهدف, الرموز_الخارجية) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ماتشو.رمز_تشغيل_غير_متاح()); }
    | اختيار.بعض(الاسم) -> {
        دع الرمز: رمز_ماتشو = {
            المرجع: المرجع,
            الاسم: الاسم,
            الموضع: الموضع
        };
        دع الحالة: متغير متجه رمز_ماتشو = *الرموز;
        ألحق(الحالة, الرمز);
        *الرموز := الحالة;
        أرجع نتيجة.نجح(صواب);
    };
}

عرف انسخ_موضع_رمز_ماتشو(الموضع: &موضع_رمز_ماتشو): موضع_رمز_ماتشو {
    طابق *الموضع مع
    | موضع_رمز_ماتشو.معرف_في_قسم(القسم, الإزاحة) -> {
        أرجع موضع_رمز_ماتشو.معرف_في_قسم(القسم, الإزاحة);
    }
    | موضع_رمز_ماتشو.غير_معرف -> { أرجع موضع_رمز_ماتشو.غير_معرف(); };
}

عرف انسخ_اسم_رمز_ماتشو(الاسم: &متجه غ8): متجه غ8 {
    دع المصدر: متجه غ8 = *الاسم;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        ألحق(الناتج, المصدر[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف انسخ_رمز_ماتشو(الرمز: &رمز_ماتشو): رمز_ماتشو {
    دع القيمة: رمز_ماتشو = *الرمز;
    دع المرجع: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&القيمة.المرجع);
    دع الاسم: متجه غ8 = انسخ_اسم_رمز_ماتشو(&القيمة.الاسم);
    دع الموضع: موضع_رمز_ماتشو = انسخ_موضع_رمز_ماتشو(&القيمة.الموضع);
    دع الناتج: رمز_ماتشو = { المرجع: المرجع, الاسم: الاسم, الموضع: الموضع };
    أرجع الناتج;
}

عرف رتب_رموز_ماتشو_المعرفة_أولا(الرموز: &متجه رمز_ماتشو): متجه رمز_ماتشو {
    دع المصدر: متجه رمز_ماتشو = *الرموز;
    دع المعرفة: متغير متجه غير_موقع = [];
    دع غير_المعرفة: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        لو (هل_موضع_رمز_ماتشو_معرف(المصدر[ف].الموضع)) {
            ألحق(المعرفة, ف);
        } وإلا {
            ألحق(غير_المعرفة, ف);
        };
        ف := ف + 1;
    }

    // ثبّت ترتيب nlist/string table بترتيب مؤشرات خفيفة بدلا من نقل رمز_ماتشو
    // المملوك جزئيا خارج عنصر المتجه.
    دع أ: متغير غير_موقع = 0;
    بينما (أ < (الطول(المعرفة) مثل غير_موقع)) {
        دع ب: متغير غير_موقع = أ + 1;
        بينما (ب < (الطول(المعرفة) مثل غير_موقع)) {
            لو (اسم_ماتشو_أصغر(&المصدر[المعرفة[ب]].الاسم, &المصدر[المعرفة[أ]].الاسم)) {
                دع مؤقت: غير_موقع = المعرفة[أ];
                المعرفة[أ] := المعرفة[ب];
                المعرفة[ب] := مؤقت;
            };
            ب := ب + 1;
        }
        أ := أ + 1;
    }
    أ := 0;
    بينما (أ < (الطول(غير_المعرفة) مثل غير_موقع)) {
        دع ب: متغير غير_موقع = أ + 1;
        بينما (ب < (الطول(غير_المعرفة) مثل غير_موقع)) {
            لو (اسم_ماتشو_أصغر(&المصدر[غير_المعرفة[ب]].الاسم, &المصدر[غير_المعرفة[أ]].الاسم)) {
                دع مؤقت: غير_موقع = غير_المعرفة[أ];
                غير_المعرفة[أ] := غير_المعرفة[ب];
                غير_المعرفة[ب] := مؤقت;
            };
            ب := ب + 1;
        }
        أ := أ + 1;
    }

    دع الناتج: متغير متجه رمز_ماتشو = [];
    ف := 0;
    بينما (ف < (الطول(المعرفة) مثل غير_موقع)) {
        دع الرمز: رمز_ماتشو = انسخ_رمز_ماتشو(&المصدر[المعرفة[ف]]);
        ألحق(الناتج, الرمز);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(غير_المعرفة) مثل غير_موقع)) {
        دع الرمز: رمز_ماتشو = انسخ_رمز_ماتشو(&المصدر[غير_المعرفة[ف]]);
        ألحق(الناتج, الرمز);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أس_محاذاة_ماتشو(المحاذاة: غير_موقع): اختيار غير_موقع {
    لو (المحاذاة == 0) { أرجع اختيار.لا_شيء(); };
    دع القوة: متغير غير_موقع = 1;
    دع الأس: متغير غير_موقع = 0;
    بينما ((القوة < المحاذاة) && (الأس < 20)) {
        القوة := القوة * 2;
        الأس := الأس + 1;
    }
    لو (القوة != المحاذاة) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الأس);
}

عرف محاذاة_حقل_إزاحة_مشترك(النوع: نوع_إزاحة_رمزية_كائن): غير_موقع {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { أرجع 8; }
    | _ -> { أرجع 4; };
}

عرف ألحق_كلمة_نص(البيانات: &متغير متجه غ8, الكلمة: كلمة_ذراع_أربعة_وستون_مشفرة): منطقي {
    لو (الكلمة.القيمة > 0xFFFFFFFF) { أرجع خطأ; };
    ألحق_غ32_صغير(البيانات, الكلمة.القيمة);
    أرجع صواب;
}

عرف رتب_إزاحات_ماتشو(الإزاحات: &متجه إزاحة_ماتشو): متجه إزاحة_ماتشو {
    دع الناتج: متغير متجه إزاحة_ماتشو = *الإزاحات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الناتج) مثل غير_موقع)) {
        دع ك: متغير غير_موقع = ف + 1;
        بينما (ك < (الطول(الناتج) مثل غير_موقع)) {
            لو (الناتج[ك].إزاحة_بايت > الناتج[ف].إزاحة_بايت) {
                دع مؤقت: إزاحة_ماتشو = الناتج[ف]; الناتج[ف] := الناتج[ك]; الناتج[ك] := مؤقت;
            };
            ك := ك + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف نوع_إزاحة_ماتشو_من_مشترك(النوع: نوع_إزاحة_رمزية_كائن): نوع_إزاحة_ماتشو {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت -> { أرجع نوع_إزاحة_ماتشو.فرع_ذراع_ستة_وعشرون_بت(); }
    | نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت -> { أرجع نوع_إزاحة_ماتشو.صفحة_ذراع_واحد_وعشرون_بت(); }
    | نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> { أرجع نوع_إزاحة_ماتشو.إزاحة_صفحة_ذراع_اثنا_عشر_بت(); }
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { أرجع نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت(); };
}

عرف حجم_حقل_إزاحة_مشترك(النوع: نوع_إزاحة_رمزية_كائن): غير_موقع {
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> { أرجع 8; }
    | _ -> { أرجع 4; };
}

عرف ابحث_دالة_ذراع_مشفرة(
    الدوال: &متجه دالة_ذراع_أربعة_وستون_مشفرة,
    المعرف: معرف_دالة_منتقاة
): اختيار دالة_ذراع_أربعة_وستون_مشفرة {
    دع د: متجه دالة_ذراع_أربعة_وستون_مشفرة = *الدوال;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(د) مثل غير_موقع)) {
        لو (معرفا_دالة_منتقاة_متساويان(د[ف].المعرف, المعرف)) {
            دع مرجع_الدالة: &دالة_ذراع_أربعة_وستون_مشفرة = &د[ف];
            أرجع اختيار.بعض(*مرجع_الدالة);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف بداية_دالة_في_نص_ماتشو(الرموز: &متجه رمز_ماتشو, الدالة: معرف_دالة_منتقاة): اختيار غير_موقع {
    دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدالة);
    طابق ابحث_رمز_ماتشو(الرموز, &المرجع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الفهرس) -> {
        دع قائمة_الرموز: متجه رمز_ماتشو = *الرموز;
        دع مرجع_الرمز: &رمز_ماتشو = &قائمة_الرموز[الفهرس];
        دع الرمز: رمز_ماتشو = *مرجع_الرمز;
        طابق الرمز.الموضع مع
        | موضع_رمز_ماتشو.معرف_في_قسم(القسم, الموضع) -> { لو (القسم == 0) { أرجع اختيار.بعض(الموضع); }; أرجع اختيار.لا_شيء(); }
        | موضع_رمز_ماتشو.غير_معرف -> { أرجع اختيار.لا_شيء(); };
    };
}

عرف اسم_دخول_ماتشو(): متجه غ8 {
    // _main
    دع الاسم: متجه غ8 = [0x5F, 0x6D, 0x61, 0x69, 0x6E];
    أرجع الاسم;
}

عرف طبق_اسم_دخول_ماتشو(
    الرموز: &متغير متجه رمز_ماتشو,
    دالة_الدخول: اختيار معرف_دالة_منتقاة
): اختيار خطأ_ماتشو {
    طابق دالة_الدخول مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الدخول) -> {
        دع الحالة: متغير متجه رمز_ماتشو = *الرموز;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
            دع المرجع_الحالي: مرجع_رمز_كائن = الحالة[ف].المرجع;
            طابق المرجع_الحالي مع
            | مرجع_رمز_كائن.دالة(الدالة) -> {
                لو (معرفا_دالة_منتقاة_متساويان(الدالة, الدخول)) {
                    دع الموضع_الحالي: موضع_رمز_ماتشو = الحالة[ف].الموضع;
                    طابق الموضع_الحالي مع
                    | موضع_رمز_ماتشو.غير_معرف -> {
                        أرجع اختيار.بعض(خطأ_ماتشو.رمز_دخول_مفقود(الدخول));
                    }
                    | موضع_رمز_ماتشو.معرف_في_قسم(القسم, الموضع_داخل_القسم) -> {
                        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدخول);
                        دع الموضع: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(القسم, الموضع_داخل_القسم);
                        دع الاسم: متجه غ8 = اسم_دخول_ماتشو();
                        دع الجديد: رمز_ماتشو = {
                            المرجع: المرجع,
                            الاسم: الاسم,
                            الموضع: الموضع
                        };
                        الحالة[ف] := الجديد;
                        *الرموز := الحالة;
                        أرجع اختيار.لا_شيء();
                    };
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع اختيار.بعض(خطأ_ماتشو.رمز_دخول_مفقود(الدخول));
    };
}

عام عرف ابن_كائن_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(
    الشفرة: &شفرة_ذراع_أربعة_وستون_مشفرة,
    المرفقات: &مرفقات_كائن_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8
): نتيجة_بناء_ماتشو {
    دع ش: شفرة_ذراع_أربعة_وستون_مشفرة = *الشفرة;
    دع مرفق: مرفقات_كائن_مشفرة = *المرفقات;
    دع و: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(ش.الهدف, و.المعرف)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق(ش.الهدف)); };
    طابق و.صيغة_الكائن مع
    | صيغة_كائن_هدف.ماتشو -> { }
    | صيغة_كائن_هدف.إلف -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق(و.المعرف)); };

    دع مؤشرات_الدوال: متجه غير_موقع = رتب_مؤشرات_دوال_مشفرة(&ش.الدوال);
    دع النص: متغير متجه غ8 = [];
    دع الرموز: متغير متجه رمز_ماتشو = [];
    دع الإزاحات: متغير متجه إزاحة_ماتشو = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(مؤشرات_الدوال) مثل غير_موقع)) {
        دع فهرس_الدالة: غير_موقع = مؤشرات_الدوال[ف];
        دع مرجع_الدالة: &دالة_ذراع_أربعة_وستون_مشفرة = &ش.الدوال[فهرس_الدالة];
        دع الدالة: دالة_ذراع_أربعة_وستون_مشفرة = *مرجع_الدالة;
        دع بداية_الدالة: غير_موقع = الطول(النص) مثل غير_موقع;
        دع مرجع_الدالة_الرمزي: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدالة.المعرف);
        دع موضع_الدالة: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(0, بداية_الدالة);
        طابق أضف_رمز_ماتشو_إن_غاب(&متغير الرموز, مرجع_الدالة_الرمزي, موضع_الدالة, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.دالة_مكررة(الدالة.المعرف)); }
        | نتيجة.نجح(أضيف) -> { لو (!أضيف) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.دالة_مكررة(الدالة.المعرف)); }; };
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(الدالة.الكلمات) مثل غير_موقع)) {
            لو (!ألحق_كلمة_نص(&متغير النص, الدالة.الكلمات[ك])) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.كلمة_تعليمة_خارج_نطاق_غ32(الدالة.المعرف)); };
            ك := ك + 1;
        }
        ف := ف + 1;
    }

    دع الثوابت: متغير متجه غ8 = [];
    دع أقوى_محاذاة_ثوابت: متغير غير_موقع = 1;
    دع مؤشرات_البيانات_الثابتة: متجه غير_موقع = رتب_مؤشرات_بيانات_ثابتة_ماتشو(&مرفق.البيانات_الثابتة);
    دع ب: متغير غير_موقع = 0;
    بينما (ب < (الطول(مؤشرات_البيانات_الثابتة) مثل غير_موقع)) {
        دع فهرس_البيانات: غير_موقع = مؤشرات_البيانات_الثابتة[ب];
        دع مرجع_البيانات: &بيانات_ثابتة_كائن = &مرفق.البيانات_الثابتة[فهرس_البيانات];
        دع البيانات: بيانات_ثابتة_كائن = *مرجع_البيانات;
        لو (!البيانات.للقراءة_فقط) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.نوع_إزاحة_غير_مدعوم()); };
        دع محاذاة: متغير غير_موقع = البيانات.المحاذاة;
        لو (محاذاة == 0) { محاذاة := 1; };
        طابق أس_محاذاة_ماتشو(محاذاة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
        | اختيار.بعض(_) -> { };
        لو (محاذاة > أقوى_محاذاة_ثوابت) { أقوى_محاذاة_ثوابت := محاذاة; };
        دع حجم_الثوابت_الحالي: غير_موقع = الطول(الثوابت) مثل غير_موقع;
        دع موضع_البيانات: غير_موقع = حاذ_لأعلى(حجم_الثوابت_الحالي, محاذاة);
        دع الحالي: غير_موقع = حجم_الثوابت_الحالي;
        لو (موضع_البيانات > الحالي) { ألحق_أصفارا(&متغير الثوابت, موضع_البيانات - الحالي); };
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.بيانات_ثابتة(البيانات.المعرف);
        طابق ابحث_رمز_ماتشو(&الرموز, &المرجع) مع
        | اختيار.بعض(_) -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.بيانات_ثابتة_مكررة(البيانات.المعرف.القيمة)); }
        | اختيار.لا_شيء -> { };
        دع الموضع: موضع_رمز_ماتشو = موضع_رمز_ماتشو.معرف_في_قسم(1, موضع_البيانات);
        طابق أضف_رمز_ماتشو_إن_غاب(&متغير الرموز, المرجع, الموضع, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع د: متغير غير_موقع = 0;
        بينما (د < (الطول(البيانات.البيانات) مثل غير_موقع)) { ألحق(الثوابت, البيانات.البيانات[د]); د := د + 1; }
        ب := ب + 1;
    }

    دع ر: متغير غير_موقع = 0;
    بينما (ر < (الطول(مرفق.إزاحات_النص) مثل غير_موقع)) {
        دع مرجع_الطلب: &طلب_إزاحة_نص_كائن = &مرفق.إزاحات_النص[ر];
        دع الطلب: طلب_إزاحة_نص_كائن = *مرجع_الطلب;
        لو (الطلب.الإضافة != 0) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.إضافة_تثبيت_غير_مدعومة(الطلب.الموضع.الدالة)); };
        طابق ابحث_دالة_ذراع_مشفرة(&ش.الدوال, الطلب.الموضع.الدالة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح(الطلب.الموضع.الدالة)); }
        | اختيار.بعض(دالة_المصدر) -> {
            دع عدد_كلمات_المصدر: غير_موقع = الطول(دالة_المصدر.الكلمات) مثل غير_موقع;
            دع حجم_الدالة: غير_موقع = عدد_كلمات_المصدر * 4;
            دع حجم_الحقل: غير_موقع = حجم_حقل_إزاحة_مشترك(الطلب.النوع);
            دع محاذاة_الحقل: غير_موقع = محاذاة_حقل_إزاحة_مشترك(الطلب.النوع);
            لو ((الطلب.الموضع.إزاحة_بايت % محاذاة_الحقل) != 0) {
                أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح(الطلب.الموضع.الدالة));
            };
            لو (الطلب.الموضع.إزاحة_بايت + حجم_الحقل > حجم_الدالة) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح(الطلب.الموضع.الدالة)); };
        };
        دع بداية: متغير غير_موقع = 0;
        طابق بداية_دالة_في_نص_ماتشو(&الرموز, الطلب.الموضع.الدالة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.طلب_إزاحة_غير_صالح(الطلب.الموضع.الدالة)); }
        | اختيار.بعض(القيمة) -> { بداية := القيمة; };
        دع نوع_ماتشو: نوع_إزاحة_ماتشو = نوع_إزاحة_ماتشو_من_مشترك(الطلب.النوع);
        دع موضع_مطلق: غير_موقع = بداية + الطلب.الموضع.إزاحة_بايت;
        دع مرجع_الإزاحة: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&الطلب.الرمز);
        دع الإزاحة: إزاحة_ماتشو = { إزاحة_بايت: موضع_مطلق, النوع: نوع_ماتشو, الرمز: مرجع_الإزاحة };
        ألحق(الإزاحات, الإزاحة);
        طابق ابحث_رمز_ماتشو(&الرموز, &الطلب.الرمز) مع
        | اختيار.بعض(_) -> { }
        | اختيار.لا_شيء -> {
            لو (مرجع_رمز_كائن_هو_بيانات_ثابتة(&الطلب.الرمز)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.رمز_إزاحة_مفقود()); };
            دع موضع_رمز_غير_معرف: موضع_رمز_ماتشو = موضع_رمز_ماتشو.غير_معرف();
            دع مرجع_الرمز_الجديد: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&الطلب.الرمز);
            طابق أضف_رمز_ماتشو_إن_غاب(&متغير الرموز, مرجع_الرمز_الجديد, موضع_رمز_غير_معرف, الهدف, الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        };
        ر := ر + 1;
    }

    دع اسم_النص: متجه غ8 = اسم_قسم_نص();
    دع اسم_المقطع: متجه غ8 = اسم_مقطع_نص();
    دع الإزاحات_المرتبة: متجه إزاحة_ماتشو = رتب_إزاحات_ماتشو(&الإزاحات);
    دع قسم_النص: قسم_ماتشو = { الاسم: اسم_النص, اسم_المقطع: اسم_المقطع, البيانات: النص, المحاذاة_الأسية: 2, الأعلام: 0x80000400, الإزاحات: الإزاحات_المرتبة };
    دع الأقسام: متغير متجه قسم_ماتشو = [قسم_النص];
    لو ((الطول(الثوابت) مثل غير_موقع) != 0) {
        دع اسم_الثوابت: متجه غ8 = اسم_قسم_ثوابت();
        دع اسم_مقطع_الثوابت: متجه غ8 = اسم_مقطع_نص();
        دع لا_إزاحات: متجه إزاحة_ماتشو = [];
        دع أس_الثوابت: متغير غير_موقع = 0;
        طابق أس_محاذاة_ماتشو(أقوى_محاذاة_ثوابت) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
        | اختيار.بعض(القيمة) -> { أس_الثوابت := القيمة; };
        دع قسم_الثوابت: قسم_ماتشو = {
            الاسم: اسم_الثوابت,
            اسم_المقطع: اسم_مقطع_الثوابت,
            البيانات: الثوابت,
            المحاذاة_الأسية: أس_الثوابت,
            الأعلام: 0,
            الإزاحات: لا_إزاحات
        };
        ألحق(الأقسام, قسم_الثوابت);
    };
    طابق طبق_اسم_دخول_ماتشو(&متغير الرموز, دالة_الدخول) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { };

    دع الرموز_المرتبة: متجه رمز_ماتشو = رتب_رموز_ماتشو_المعرفة_أولا(&الرموز);
    الرموز := الرموز_المرتبة;
    دع عدد_الرموز_المعرفة: متغير غير_موقع = 0;
    دع س: متغير غير_موقع = 0;
    بينما (س < (الطول(الرموز) مثل غير_موقع)) {
        دع مرجع_الرمز: &رمز_ماتشو = &الرموز[س]; دع الرمز: رمز_ماتشو = *مرجع_الرمز;
        طابق الرمز.الموضع مع | موضع_رمز_ماتشو.معرف_في_قسم(_, _) -> { عدد_الرموز_المعرفة := عدد_الرموز_المعرفة + 1; } | موضع_رمز_ماتشو.غير_معرف -> { };
        س := س + 1;
    }
    دع الكائن: كائن_ماتشو = { الهدف: و.المعرف, الأقسام: الأقسام, الرموز: الرموز, عدد_الرموز_المعرفة: عدد_الرموز_المعرفة };
    أرجع نتيجة_بناء_ماتشو.نجح(الكائن);
}


عرف ألحق_حقل_اسم_ستة_عشر(البايتات: &متغير متجه غ8, الاسم: &متجه غ8): منطقي {
    دع ن: متجه غ8 = *الاسم;
    دع الحجم: غير_موقع = الطول(ن) مثل غير_موقع;
    لو (الحجم > 16) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) { ألحق_غ8(البايتات, ن[ف] مثل غير_موقع); ف := ف + 1; }
    ألحق_أصفارا(البايتات, 16 - الحجم);
    أرجع صواب;
}

عرف ابن_جدول_نصوص_ماتشو(الرموز: &متجه رمز_ماتشو): جدول_نصوص_ماتشو {
    دع النصوص: متغير متجه غ8 = [0];
    دع المواقع: متغير متجه غير_موقع = [];
    دع ر: متجه رمز_ماتشو = *الرموز;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ر) مثل غير_موقع)) {
        دع الموقع: غير_موقع = الطول(النصوص) مثل غير_موقع; ألحق(المواقع, الموقع);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(ر[ف].الاسم) مثل غير_موقع)) { ألحق(النصوص, ر[ف].الاسم[ك]); ك := ك + 1; }
        ألحق(النصوص, 0); ف := ف + 1;
    }
    دع الجدول: جدول_نصوص_ماتشو = { البيانات: النصوص, إزاحات_الرموز: المواقع };
    أرجع الجدول;
}

عرف معلومات_إزاحة_ماتشو(الإزاحة: &إزاحة_ماتشو, فهرس_الرمز: غير_موقع): اختيار غير_موقع {
    لو (فهرس_الرمز > 0xFFFFFF) { أرجع اختيار.لا_شيء(); };
    دع النوع: متغير غير_موقع = 0; دع متجه_نسبي: متغير منطقي = خطأ; دع طول_الحقل: متغير غير_موقع = 2;
    دع إ: إزاحة_ماتشو = *الإزاحة;
    طابق إ.النوع مع
    | نوع_إزاحة_ماتشو.فرع_ذراع_ستة_وعشرون_بت -> { النوع := 2; متجه_نسبي := صواب; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.صفحة_ذراع_واحد_وعشرون_بت -> { النوع := 3; متجه_نسبي := صواب; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> { النوع := 4; متجه_نسبي := خطأ; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت -> { النوع := 0; متجه_نسبي := خطأ; طول_الحقل := 3; };
    دع المعلومات: متغير غير_موقع = فهرس_الرمز;
    لو (متجه_نسبي) { المعلومات := المعلومات + 16777216; };
    المعلومات := المعلومات + (طول_الحقل * 33554432);
    المعلومات := المعلومات + 134217728;
    المعلومات := المعلومات + (النوع * 268435456);
    أرجع اختيار.بعض(المعلومات);
}

عام عرف سلسل_كائن_ماتشو_ذراع_أربعة_وستون(الكائن: &كائن_ماتشو, الهدف: &واصف_هدف): نتيجة_تسلسل_ماتشو {
