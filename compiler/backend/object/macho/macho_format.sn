        دع أس_العوام: متغير غير_موقع = 0;
        طابق أس_محاذاة_ماتشو(أقوى_محاذاة_عوام) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
        | اختيار.بعض(القيمة) -> { أس_العوام := القيمة; };
        دع قسم_البيانات: قسم_ماتشو = {
            الاسم: اسم_البيانات,
            اسم_المقطع: اسم_مقطع_البيانات,
            البيانات: البيانات_العامة,
            المحاذاة_الأسية: أس_العوام,
            الأعلام: 0,
            الإزاحات: لا_إزاحات_بيانات
        };
        ألحق(الأقسام, قسم_البيانات);
    };
    دع حزمة_دوارف_الماتشو: متغير حزمة_دوارف = ابن_حزمة_دوارف_من_سياقات(
        خريطة_المصادر, أصول_المصدر, &مواضع_دوارف, &مواضع_العوام_دوارف, التصحيح, تصحيح_الآلة, سياق_الفك,
        الأنواع, الهدف, سجل_التخطيط, &أصول_آلة_دوارف, حجم_نص_دوارف
    );
