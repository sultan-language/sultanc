        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    لو ((الطول(حزمة_دوارف_الماتشو.قوائم_نطاقات) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_قوائم_نطاقات, &متغير حزمة_دوارف_الماتشو.قوائم_نطاقات, 0,
        اختيار.بعض(قسم_عنوان_دوارف.قوائم_نطاقات()), قسم_بيانات_دوارف.قوائم_نطاقات(),
        &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام, ترتيب_قسم_النص_دوارف,
        ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    لو ((الطول(حزمة_دوارف_الماتشو.أسماء_عامة) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_دوارف_أسماء, &متغير حزمة_دوارف_الماتشو.أسماء_عامة, 0, اختيار.لا_شيء(),
        قسم_بيانات_دوارف.أسماء_عامة(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    لو ((الطول(حزمة_دوارف_الماتشو.فهرس_أسماء) مثل غير_موقع) > 0 && !أضف_قسم_دوارف_ماتشو(&متغير الأقسام,
        اسم_فهرس_أسماء, &متغير حزمة_دوارف_الماتشو.فهرس_أسماء, 0, اختيار.لا_شيء(),
        قسم_بيانات_دوارف.فهرس_أسماء(), &حزمة_دوارف_الماتشو.رقع_العناوين, &حزمة_دوارف_الماتشو.رقع_الأقسام,
        ترتيب_قسم_النص_دوارف, ترتيب_قسم_البيانات_دوارف, بداية_ترتيب_دوارف,
        &أقسام_دوارف_الفعالة)) { أرجع نتيجة_بناء_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };


    طابق طبق_اسم_دخول_ماتشو(&متغير الرموز, دالة_الدخول) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_ماتشو.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { };

    دع الرموز_المرتبة: متجه رمز_ماتشو = رتب_رموز_ماتشو_المعرفة_أولا(&الرموز);
    الرموز := الرموز_المرتبة;
    دع عدد_الرموز_المعرفة: متغير غير_موقع = 0;
    دع س: متغير غير_موقع = 0;
    بينما (س < (الطول(الرموز) مثل غير_موقع)) {
        دع مرجع_الرمز: &رمز_ماتشو = &الرموز[س];
        طابق (*مرجع_الرمز).الموضع مع | موضع_رمز_ماتشو.معرف_في_قسم(_,
            _) -> { عدد_الرموز_المعرفة := عدد_الرموز_المعرفة + 1; } | موضع_رمز_ماتشو.غير_معرف -> { };
        س := س + 1;
    }
    دع الكائن: كائن_ماتشو = { الهدف: معرف_الهدف, الأقسام: الأقسام, الرموز: الرموز,
        عدد_الرموز_المعرفة: عدد_الرموز_المعرفة, دوارف: حزمة_دوارف_الماتشو };
    أرجع نتيجة_بناء_ماتشو.نجح(الكائن);
}


عرف ألحق_حقل_اسم_ستة_عشر(البايتات: &متغير متجه غ8, الاسم: &متجه غ8): منطقي {
    دع الحجم: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    لو (الحجم > 16) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) { ألحق_غ8(البايتات, (*الاسم)[ف] مثل غير_موقع); ف := ف + 1; }
    ألحق_أصفارا(البايتات, 16 - الحجم);
    أرجع صواب;
}

عرف ابن_جدول_نصوص_ماتشو(الرموز: &متجه رمز_ماتشو): جدول_نصوص_ماتشو {
    دع النصوص: متغير متجه غ8 = [0];
    دع المواقع: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرموز) مثل غير_موقع)) {
        دع الموقع: غير_موقع = الطول(النصوص) مثل غير_موقع; ألحق(المواقع, الموقع);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول((*الرموز)[ف].الاسم) مثل غير_موقع)) { ألحق(النصوص, (*الرموز)[ف].الاسم[ك]);
            ك := ك + 1; }
        ألحق(النصوص, 0); ف := ف + 1;
    }
    دع الجدول: جدول_نصوص_ماتشو = { البيانات: النصوص, إزاحات_الرموز: المواقع };
    أرجع الجدول;
}

عرف معلومات_إزاحة_ماتشو(الإزاحة: &إزاحة_ماتشو, فهرس_الرمز: غير_موقع, خارجي_الرمز: منطقي): اختيار غير_موقع {
    لو (فهرس_الرمز > 0xFFFFFF) { أرجع اختيار.لا_شيء(); };
    دع النوع: متغير غير_موقع = 0; دع متجه_نسبي: متغير منطقي = خطأ; دع طول_الحقل: متغير غير_موقع = 2;
    دع إ: إزاحة_ماتشو = *الإزاحة;
    طابق إ.النوع مع
    | نوع_إزاحة_ماتشو.فرع_ذراع_ستة_وعشرون_بت -> { النوع := 2; متجه_نسبي := صواب; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.صفحة_ذراع_واحد_وعشرون_بت -> { النوع := 3; متجه_نسبي := صواب; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> { النوع := 4; متجه_نسبي := خطأ; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.مطلق_اثنان_وثلاثون_بت -> { النوع := 0; متجه_نسبي := خطأ; طول_الحقل := 2; }
    | نوع_إزاحة_ماتشو.مطلق_أربعة_وستون_بت -> { النوع := 0; متجه_نسبي := خطأ; طول_الحقل := 3; };
    دع المعلومات: متغير غير_موقع = فهرس_الرمز;
    لو (متجه_نسبي) { المعلومات := المعلومات + 16777216; };
    المعلومات := المعلومات + (طول_الحقل * 33554432);
    لو (خارجي_الرمز) { المعلومات := المعلومات + 134217728; };
    المعلومات := المعلومات + (النوع * 268435456);
    أرجع اختيار.بعض(المعلومات);
}

عرف ابحث_اسم_رمز_ماتشو_مرتب(
    الرموز: &متجه رمز_ماتشو,
    الاسم: &متجه غ8,
    بداية_النطاق: غير_موقع,
    نهاية_النطاق: غير_موقع
): اختيار غير_موقع {
    دع البداية: متغير غير_موقع = بداية_النطاق;
    دع النهاية: متغير غير_موقع = نهاية_النطاق;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع الاسم_الحالي: &متجه غ8 = &(*الرموز)[الوسط].الاسم;
        لو (اسم_ماتشو_أصغر(الاسم_الحالي, الاسم)) {
            البداية := الوسط + 1;
        } وإلا لو (اسم_ماتشو_أصغر(الاسم, الاسم_الحالي)) {
            النهاية := الوسط;
        } وإلا {
            أرجع اختيار.بعض(الوسط);
        };
    }
    أرجع اختيار.لا_شيء();
}

عرف ابحث_رمز_إزاحة_ماتشو(
    الكائن: &كائن_ماتشو,
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف
): اختيار غير_موقع {
    دع عدد_الرموز: غير_موقع = الطول((*الكائن).الرموز) مثل غير_موقع;
    دع عدد_المعرفة: غير_موقع = (*الكائن).عدد_الرموز_المعرفة;
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> {
        دع الاسم: متجه غ8 = اسم_رمز_دالة(الدالة);
        أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, 0, عدد_المعرفة);
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(البيانات) -> {
        دع الاسم: متجه غ8 = اسم_رمز_بيانات(البيانات);
        أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, 0, عدد_المعرفة);
    }
    | مرجع_رمز_كائن.عام(العام) -> {
        دع الاسم: متجه غ8 = اسم_رمز_عام_ماتشو(العام);
        أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, 0, عدد_المعرفة);
    }
    | مرجع_رمز_كائن.خدمة_تشغيل(الخدمة) -> {
        طابق اسم_رمز_خدمة_تشغيل_للهدف(الهدف, الخدمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> {
            أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, عدد_المعرفة, عدد_الرموز);
        };
    }
    | مرجع_رمز_كائن.مرفق_مضيف(المرفق) -> {
        طابق اسم_رمز_مرفق_مضيف_للهدف(الهدف, المرفق) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> {
            أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, عدد_المعرفة, عدد_الرموز);
        };
    }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> {
        طابق اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> {
            أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, عدد_المعرفة, عدد_الرموز);
        };
    }
    | مرجع_رمز_كائن.رمز_خارجي(_) -> {
        // Raw external IDs need the declaration-name table that is intentionally
        // not retained by the serialized object. Keep the rare fallback linear.
        أرجع ابحث_رمز_ماتشو(&(*الكائن).الرموز, المرجع);
    };
}

عام عرف سلسل_كائن_ماتشو_ذراع_أربعة_وستون(الكائن: &كائن_ماتشو, الهدف: &واصف_هدف): نتيجة_تسلسل_ماتشو {
    لو (!معرفا_هدف_متساويان((*الكائن).الهدف,
        (*الهدف).المعرف)) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق((*الكائن).الهدف)); };
    طابق (*الهدف).صيغة_الكائن مع | صيغة_كائن_هدف.ماتشو -> { }
        | _ -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.هدف_غير_متوافق((*الهدف).المعرف)); };
    دع عدد_الأقسام: غير_موقع = الطول((*الكائن).الأقسام) مثل غير_موقع;
    لو (عدد_الأقسام == 0 || عدد_الأقسام > 16) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.قسم_نص_مفقود()); };
    دع عدد_الرموز: غير_موقع = الطول((*الكائن).الرموز) مثل غير_موقع;
    لو (عدد_الرموز > 0xFFFFFFFF || (*الكائن).عدد_الرموز_المعرفة > عدد_الرموز) {
        أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
    دع جدول_النصوص: جدول_نصوص_ماتشو = ابن_جدول_نصوص_ماتشو(&(*الكائن).الرموز);
    دع حجم_جدول_النصوص: غير_موقع = الطول(جدول_النصوص.البيانات) مثل غير_موقع;
    دع حجم_أمر_المقطع: غير_موقع = 72 + (عدد_الأقسام * 80);
    // MH_OBJECT carries LC_BUILD_VERSION so external Apple linkers know this is a macOS object.
    دع حجم_أمر_بناء_المنصة: غير_موقع = 24;
    دع حجم_أوامر_التحميل: غير_موقع = حجم_أمر_المقطع + 24 + 80 + حجم_أمر_بناء_المنصة;
    دع بداية_بيانات_الأقسام: غير_موقع = 32 + حجم_أوامر_التحميل;
    دع إزاحات_الأقسام: متغير متجه غير_موقع = [];
    دع عناوين_الأقسام: متغير متجه غير_موقع = [];
    دع مواضع_الإزاحات: متغير متجه غير_موقع = [];
    دع موضع_الملف: متغير غير_موقع = بداية_بيانات_الأقسام; دع عنوان_افتراضي: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع المحاذاة: متغير غير_موقع = 1;
        طابق قوة_اثنين_ماتشو((*مرجع_القسم).المحاذاة_الأسية) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة());
            } | اختيار.بعض(قيمة) -> { المحاذاة := قيمة; };
        موضع_الملف := حاذ_لأعلى(موضع_الملف, المحاذاة); عنوان_افتراضي := حاذ_لأعلى(عنوان_افتراضي, المحاذاة);
        ألحق(إزاحات_الأقسام, موضع_الملف); ألحق(عناوين_الأقسام, عنوان_افتراضي);
        دع حجم_القسم: غير_موقع = الطول((*مرجع_القسم).البيانات) مثل غير_موقع;
        موضع_الملف := موضع_الملف + حجم_القسم; عنوان_افتراضي := عنوان_افتراضي + حجم_القسم;
        ف := ف + 1;
    }
    دع نهاية_بيانات_الأقسام: غير_موقع = موضع_الملف;
    دع موضع_الإزاحة: متغير غير_موقع = نهاية_بيانات_الأقسام; ف := 0;
    بينما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع العدد: غير_موقع = الطول((*مرجع_القسم).الإزاحات) مثل غير_موقع;
        لو (العدد > 0xFFFFFFFF) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
        لو (العدد == 0) {
            ألحق(مواضع_الإزاحات, 0);
        } وإلا {
            ألحق(مواضع_الإزاحات, موضع_الإزاحة);
            موضع_الإزاحة := موضع_الإزاحة + (العدد * 8);
        };
        ف := ف + 1;
    }
    دع إزاحة_الرموز: غير_موقع = حاذ_لأعلى(موضع_الإزاحة, 8);
    دع إزاحة_النصوص: غير_موقع = إزاحة_الرموز + (عدد_الرموز * 16);
    لو (إزاحة_الرموز > 0xFFFFFFFF || إزاحة_النصوص > 0xFFFFFFFF || حجم_جدول_النصوص > 0xFFFFFFFF) {
        أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };

    دع البايتات: متغير متجه غ8 = [];
    ألحق_غ32_صغير(&متغير البايتات, 0xFEEDFACF); ألحق_غ32_صغير(&متغير البايتات, 0x0100000C);
        ألحق_غ32_صغير(&متغير البايتات, 0);
    ألحق_غ32_صغير(&متغير البايتات, 1); ألحق_غ32_صغير(&متغير البايتات, 4);
        ألحق_غ32_صغير(&متغير البايتات, حجم_أوامر_التحميل); ألحق_غ32_صغير(&متغير البايتات, 0);
        ألحق_غ32_صغير(&متغير البايتات, 0);
    ألحق_غ32_صغير(&متغير البايتات, 0x19); ألحق_غ32_صغير(&متغير البايتات, حجم_أمر_المقطع);
        ألحق_أصفارا(&متغير البايتات, 16);
    ألحق_غ64_صغير(&متغير البايتات, 0); ألحق_غ64_صغير(&متغير البايتات, عنوان_افتراضي);
        ألحق_غ64_صغير(&متغير البايتات, بداية_بيانات_الأقسام);
        ألحق_غ64_صغير(&متغير البايتات, نهاية_بيانات_الأقسام - بداية_بيانات_الأقسام);
    ألحق_غ32_صغير(&متغير البايتات, 7); ألحق_غ32_صغير(&متغير البايتات, 7);
        ألحق_غ32_صغير(&متغير البايتات, عدد_الأقسام); ألحق_غ32_صغير(&متغير البايتات, 0);
    ف := 0;
    بينما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        لو (!ألحق_حقل_اسم_ستة_عشر(&متغير البايتات,
            &(*مرجع_القسم).الاسم) || !ألحق_حقل_اسم_ستة_عشر(&متغير البايتات,
            &(*مرجع_القسم).اسم_المقطع)) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
        دع حجم_القسم: غير_موقع = الطول((*مرجع_القسم).البيانات) مثل غير_موقع;
        دع عدد_إزاحات_القسم: غير_موقع = الطول((*مرجع_القسم).الإزاحات) مثل غير_موقع;
        ألحق_غ64_صغير(&متغير البايتات, عناوين_الأقسام[ف]); ألحق_غ64_صغير(&متغير البايتات, حجم_القسم);
            ألحق_غ32_صغير(&متغير البايتات, إزاحات_الأقسام[ف]);
            ألحق_غ32_صغير(&متغير البايتات, (*مرجع_القسم).المحاذاة_الأسية);
        ألحق_غ32_صغير(&متغير البايتات, مواضع_الإزاحات[ف]); ألحق_غ32_صغير(&متغير البايتات, عدد_إزاحات_القسم);
            ألحق_غ32_صغير(&متغير البايتات, (*مرجع_القسم).الأعلام); ألحق_غ32_صغير(&متغير البايتات, 0);
            ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0);
        ف := ف + 1;
    }
    ألحق_غ32_صغير(&متغير البايتات, 2); ألحق_غ32_صغير(&متغير البايتات, 24);
        ألحق_غ32_صغير(&متغير البايتات, إزاحة_الرموز); ألحق_غ32_صغير(&متغير البايتات, عدد_الرموز);
        ألحق_غ32_صغير(&متغير البايتات, إزاحة_النصوص); ألحق_غ32_صغير(&متغير البايتات, حجم_جدول_النصوص);
    ألحق_غ32_صغير(&متغير البايتات, 0xB); ألحق_غ32_صغير(&متغير البايتات, 80); ألحق_غ32_صغير(&متغير البايتات, 0);
        ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0);
        ألحق_غ32_صغير(&متغير البايتات, (*الكائن).عدد_الرموز_المعرفة);
        ألحق_غ32_صغير(&متغير البايتات, (*الكائن).عدد_الرموز_المعرفة);
        ألحق_غ32_صغير(&متغير البايتات, عدد_الرموز - (*الكائن).عدد_الرموز_المعرفة);
        ألحق_أصفارا(&متغير البايتات, 48);
    // LC_BUILD_VERSION: platform macOS, minimum macOS 11.0, SDK unspecified.
    ألحق_غ32_صغير(&متغير البايتات, 0x32); ألحق_غ32_صغير(&متغير البايتات, حجم_أمر_بناء_المنصة);
    ألحق_غ32_صغير(&متغير البايتات, 1); ألحق_غ32_صغير(&متغير البايتات, 0x000B0000);
    ألحق_غ32_صغير(&متغير البايتات, 0); ألحق_غ32_صغير(&متغير البايتات, 0);

    ف := 0;
    بينما (ف < عدد_الأقسام) {
        دع الحالي: غير_موقع = الطول(البايتات) مثل غير_موقع;
            لو (إزاحات_الأقسام[ف] > الحالي) { ألحق_أصفارا(&متغير البايتات, إزاحات_الأقسام[ف] - الحالي); };
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع ب: متغير غير_موقع = 0;
            بينما (ب < (الطول((*مرجع_القسم).البيانات) مثل غير_موقع)) { ألحق_غ8(&متغير البايتات,
            (*مرجع_القسم).البيانات[ب] مثل غير_موقع); ب := ب + 1; }
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < عدد_الأقسام) {
        دع مرجع_القسم: &قسم_ماتشو = &(*الكائن).الأقسام[ف];
        دع ه: متغير غير_موقع = 0;
        بينما (ه < (الطول((*مرجع_القسم).الإزاحات) مثل غير_موقع)) {
            دع الإزاحة: إزاحة_ماتشو = (*مرجع_القسم).الإزاحات[ه];
                لو (الإزاحة.إزاحة_بايت > 0x7FFFFFFF) {
                أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
            طابق الإزاحة.الهدف مع
            | هدف_إزاحة_ماتشو.رمز(المرجع) -> {
                طابق ابحث_رمز_إزاحة_ماتشو(الكائن, &المرجع, الهدف) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.رمز_إزاحة_مفقود()); }
                | اختيار.بعض(فهرس_الرمز) -> {
                    طابق معلومات_إزاحة_ماتشو(&الإزاحة, فهرس_الرمز, صواب) مع
                    | اختيار.لا_شيء -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
                    | اختيار.بعض(المعلومات) -> { ألحق_غ32_صغير(&متغير البايتات, الإزاحة.إزاحة_بايت);
                        ألحق_غ32_صغير(&متغير البايتات, المعلومات); };
                };
            }
            | هدف_إزاحة_ماتشو.قسم_محلي(ترتيب_القسم) -> {
                لو (ترتيب_القسم == 0 || ترتيب_القسم > عدد_الأقسام) {
                    أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
                طابق معلومات_إزاحة_ماتشو(&الإزاحة, ترتيب_القسم, خطأ) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); }
                | اختيار.بعض(المعلومات) -> { ألحق_غ32_صغير(&متغير البايتات, الإزاحة.إزاحة_بايت);
                    ألحق_غ32_صغير(&متغير البايتات, المعلومات); };
            };
            ه := ه + 1;
        }
        ف := ف + 1;
    }
    دع الحالي_قبل_الرموز: غير_موقع = الطول(البايتات) مثل غير_موقع;
        لو (إزاحة_الرموز > الحالي_قبل_الرموز) { ألحق_أصفارا(&متغير البايتات,
        إزاحة_الرموز - الحالي_قبل_الرموز); };
    دع س: متغير غير_موقع = 0;
    بينما (س < عدد_الرموز) {
        دع مرجع_الرمز: &رمز_ماتشو = &(*الكائن).الرموز[س];
        ألحق_غ32_صغير(&متغير البايتات, جدول_النصوص.إزاحات_الرموز[س]);
        طابق (*مرجع_الرمز).الموضع مع
        | موضع_رمز_ماتشو.معرف_في_قسم(فهرس_القسم, القيمة) -> {
            لو (فهرس_القسم >= عدد_الأقسام) { أرجع نتيجة_تسلسل_ماتشو.خطأ(خطأ_ماتشو.حدود_صيغة_متجاوزة()); };
            دع قيمة_الرمز: غير_موقع = عناوين_الأقسام[فهرس_القسم] + القيمة;
            ألحق_غ8(&متغير البايتات, 0x0F); ألحق_غ8(&متغير البايتات, فهرس_القسم + 1);
                ألحق_غ8(&متغير البايتات, 0); ألحق_غ8(&متغير البايتات, 0);
                ألحق_غ64_صغير(&متغير البايتات, قيمة_الرمز);
        }
        | موضع_رمز_ماتشو.غير_معرف -> { ألحق_غ8(&متغير البايتات, 0x01); ألحق_غ8(&متغير البايتات, 0);
            ألحق_غ8(&متغير البايتات, 0); ألحق_غ8(&متغير البايتات, 0); ألحق_غ64_صغير(&متغير البايتات, 0); };
        س := س + 1;
    }
    دع ن: متغير غير_موقع = 0;
        بينما (ن < حجم_جدول_النصوص) { ألحق_غ8(&متغير البايتات, جدول_النصوص.البيانات[ن] مثل غير_موقع);
        ن := ن + 1; }
    أرجع نتيجة_تسلسل_ماتشو.نجح(البايتات);
}

عام عرف اكتب_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(
    الشفرة: &شفرة_ذراع_أربعة_وستون_مشفرة,
    المرفقات: &مرفقات_كائن_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه غ8,
    خريطة_المصادر: &متغير خريطة_مصادر,
    أصول_المصدر: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_تسلسل_ماتشو {
    طابق ابن_كائن_ماتشو_ذراع_أربعة_وستون_مع_مرفقات(الشفرة, المرفقات, الهدف, دالة_الدخول, الرموز_الخارجية,
        خريطة_المصادر, أصول_المصدر, التصحيح, تصحيح_الآلة, سياق_الفك, الأنواع, سجل_التخطيط) مع
    | نتيجة_بناء_ماتشو.خطأ(الخطأ) -> { أرجع نتيجة_تسلسل_ماتشو.خطأ(الخطأ); }
    | نتيجة_بناء_ماتشو.نجح(الكائن) -> { أرجع سلسل_كائن_ماتشو_ذراع_أربعة_وستون(&الكائن, الهدف); };
}
