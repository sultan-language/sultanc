    دع ترتيب_قسم_البيانات_دوارف: غير_موقع = فهرس_قسم_العوام + 1;
    دع أقسام_دوارف_الفعالة: متجه قسم_بيانات_دوارف = أقسام_بيانات_دوارف_ماتشو_الفعالة(&حزمة_دوارف_الماتشو);
    دع عدد_الأقسام: غير_موقع = الطول(الأقسام) مثل غير_موقع;
