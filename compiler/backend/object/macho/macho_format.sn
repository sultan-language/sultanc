        أرجع ابحث_اسم_رمز_ماتشو_مرتب(&(*الكائن).الرموز, &الاسم, 0, عدد_المعرفة);
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(البيانات) -> {
        دع الاسم: متجه غ8 = اسم_رمز_بيانات(البيانات);
