استورد compiler.backend.architectures.x86_64.encoded_code;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.object.object_reference_model;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_primitive_symbol_query_context;
استورد compiler.msir.identifiers;
استورد compiler.runtime.primitive_runtime_abi;
استورد std.text.from_bytes;
استورد std.collections.map;
استورد std.hash.fnv;

// x86-64 Mach-O relocatable object (MH_OBJECT; <mach-o/x86_64/reloc.h>).
// Sections of the one unnamed segment:
//   1 __TEXT,__text           code, then the read-only literals
//   2 __DATA,__data           the globals and, with a process entry, the
//                             startup data (argc, argv, envp)
//   3 __DATA,__mod_init_func  the module initializer (dyld runs it)
// Symbols are the ELF writer's names with Mach-O's leading underscore;
// defined symbols come first (LC_DYSYMTAB). x86-64 relocations keep their
// addend in the patched field: a PC-relative field holds the ELF addend + 4
// (X86_64_RELOC_BRANCH for calls, SIGNED for addresses, GOT_LOAD for an
// imported datum), an absolute field (UNSIGNED) the addend itself. The
// process entry is dyld's `_main` (process_entry.sn).

عام نوع خطأ_ماتشو_إكس =
    | معمارية_غير_مدعومة بنوع معرف_هدف
    | رمز_مكرر
    | رمز_إزاحة_مفقود
    | إزاحة_غير_مدعومة
    | حدود_صيغة_متجاوزة
;

عام نوع نتيجة_ماتشو_إكس =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_ماتشو_إكس
;

نوع رمز_ماتشو_إكس = {
    الاسم: متجه ط8,
    // 0: undefined, else the 1-based section number.
    القسم: طبيعي,
    القيمة: طبيعي
};

نوع إزاحة_ماتشو_إكس = {
    الموضع: طبيعي,
    // Index into the writer's symbol vector (renumbered when serialized).
    الرمز: طبيعي,
    النوع: طبيعي,
    نسبي: منطقي,
    // log2 of the field size.
    الطول: طبيعي
};

نوع سجل_رموز_ماتشو_إكس = {
    الرموز: متجه رمز_ماتشو_إكس,
    الهوية: الخريطة<مرجع_رمز_كائن, طبيعي>,
    الأسماء: الخريطة<متجه ط8, طبيعي>
};

عرف ألحق_ط8_ماتشو_إكس(ب: &متغير متجه ط8, ق: طبيعي): فراغ { ألحق(*ب, (ق % 256) مثل ط8); }

عرف ألحق_ط32_ماتشو_إكس(ب: &متغير متجه ط8, ق: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = ق;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) { ألحق_ط8_ماتشو_إكس(ب, الباقي % 256); الباقي := الباقي / 256; ف := ف + 1; }
}

عرف ألحق_ط64_ماتشو_إكس(ب: &متغير متجه ط8, ق: طبيعي): فراغ {
    ألحق_ط32_ماتشو_إكس(ب, ق % 4294967296);
    ألحق_ط32_ماتشو_إكس(ب, ق / 4294967296);
}

عرف ألحق_أصفار_ماتشو_إكس(ب: &متغير متجه ط8, العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(*ب, 0 مثل ط8); ف := ف + 1; }
}

عرف ألحق_اسم_ستة_عشر_ماتشو_إكس(ب: &متغير متجه ط8, الاسم: &نص): فراغ {
    دع البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(الاسم));
    دع ف: متغير طبيعي = 0;
    طالما (ف < 16) {
        إذا (ف < (الطول(البايتات) مثل طبيعي)) { ألحق(*ب, البايتات[ف]); } وإلا { ألحق(*ب, 0 مثل ط8); };
        ف := ف + 1;
    }
}

عرف حاذ_ماتشو_إكس(القيمة: طبيعي, المحاذاة: طبيعي): طبيعي {
    إذا (المحاذاة <= 1) { أرجع القيمة; };
    أرجع ((القيمة + المحاذاة - 1) / المحاذاة) * المحاذاة;
}

عرف أس_محاذاة_ماتشو_إكس(المحاذاة: طبيعي): طبيعي {
    دع الأس: متغير طبيعي = 0;
    دع ق: متغير طبيعي = 1;
    طالما (ق < المحاذاة && الأس < 15) { ق := ق * 2; الأس := الأس + 1; }
    أرجع الأس;
}

عرف اكتب_عدد_ماتشو_إكس(ب: &متغير متجه ط8, الموضع: طبيعي, القيمة: عدد, الحجم: طبيعي): منطقي {
    إذا (الموضع > (الطول(*ب) مثل طبيعي) || الحجم > (الطول(*ب) مثل طبيعي) - الموضع) { أرجع خطأ; };
    دع الخام: متغير طبيعي = القيمة مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        (*ب)[الموضع + ف] := (الخام % 256) مثل ط8;
        الخام := الخام / 256;
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ألحق_سداسي_ماتشو_إكس(ب: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع القاسم: متغير طبيعي = 0x1000000000000000;
    دع ر: متغير طبيعي = 0;
    طالما (ر < 16) {
        دع الرقم: طبيعي = (القيمة / القاسم) % 16;
        إذا (الرقم < 10) { ألحق(*ب, (0x30 + الرقم) مثل ط8); } وإلا { ألحق(*ب, (0x61 + الرقم - 10) مثل ط8); };
        إذا (القاسم > 1) { القاسم := القاسم / 16; };
        ر := ر + 1;
    }
}

عرف بشرطة_ماتشو_إكس(الاسم: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [0x5F];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) { ألحق(الناتج, (*الاسم)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف اسم_مرجع_رمز_ماتشو_إكس(
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): اختياري متجه ط8 {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> {
        دع ب: متغير متجه ط8 = بايتات_من_نص(«_sultanc_fn_»);
        ألحق_سداسي_ماتشو_إكس(&متغير ب, الدالة.القيمة);
        أرجع اختياري.موجود(ب);
    }
    | مرجع_رمز_كائن.عام(العام) -> {
        دع ب: متغير متجه ط8 = بايتات_من_نص(«_sultanc_global_»);
        ألحق_سداسي_ماتشو_إكس(&متغير ب, العام.القيمة);
        أرجع اختياري.موجود(ب);
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(المعرف) -> {
        دع ب: متغير متجه ط8 = بايتات_من_نص(«_sultanc_data_»);
        ألحق_سداسي_ماتشو_إكس(&متغير ب, المعرف.الدالة.القيمة);
        ألحق(ب, 0x5F مثل ط8);
        ألحق_سداسي_ماتشو_إكس(&متغير ب, المعرف.القيمة);
        أرجع اختياري.موجود(ب);
    }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> {
        طابق اسم_رمز_خارجي_كائن_من_جدول(المعرف, الرموز_الخارجية) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الاسم) -> { أرجع اختياري.موجود(بشرطة_ماتشو_إكس(&الاسم)); };
    }
    | مرجع_رمز_كائن.خدمة_تشغيل(_) -> { أرجع اختياري.لا_شيء(); }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> { أرجع اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي); };
}

عرف هاش_هوية_رمز_ماتشو_إكس(المرجع: &مرجع_رمز_كائن): طبيعي {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(المعرف) -> { أرجع ((المعرف.القيمة % 4294967291) * 33 + 1) % 4294967291; }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> { أرجع ((المعرف.القيمة % 4294967291) * 33 + 2) % 4294967291; }
    | مرجع_رمز_كائن.عام(المعرف) -> { أرجع ((المعرف.القيمة % 4294967291) * 33 + 3) % 4294967291; }
    | مرجع_رمز_كائن.بيانات_ثابتة(المعرف) -> {
        أرجع (((المعرف.الدالة.القيمة % 4294967291) * 33 + (المعرف.القيمة % 4294967291)) % 4294967291 * 33 + 4) % 4294967291;
    }
    | مرجع_رمز_كائن.خدمة_تشغيل(_) -> { أرجع 100; }
    | مرجع_رمز_كائن.بدائي_تشغيل(_) -> { أرجع 200; };
}

عرف رمز_بالاسم_ماتشو_إكس(
    السجل: &متغير سجل_رموز_ماتشو_إكس,
    الاسم: متجه ط8,
    القسم: طبيعي,
    القيمة: طبيعي
): نتيجة طبيعي, خطأ_ماتشو_إكس {
    طابق ابحث_في_الخريطة(&(*السجل).الأسماء, &الاسم) مع
    | اختياري.موجود(الفهرس) -> {
        إذا (القسم != 0) {
            إذا ((*السجل).الرموز[الفهرس].القسم != 0) { أرجع نتيجة.خطأ(خطأ_ماتشو_إكس.رمز_مكرر()); };
            (*السجل).الرموز[الفهرس].القسم := القسم;
            (*السجل).الرموز[الفهرس].القيمة := القيمة;
        };
        أرجع نتيجة.نجح(الفهرس);
    }
    | اختياري.لا_شيء -> { };
    دع الفهرس: طبيعي = الطول((*السجل).الرموز) مثل طبيعي;
    طابق أدرج_في_الخريطة(&متغير (*السجل).الأسماء, انسخ_اسم_رمز_خارجي_كائن(&الاسم), الفهرس) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_ماتشو_إكس.حدود_صيغة_متجاوزة()); }
    | نتيجة.نجح(_) -> { };
    دع الرمز: رمز_ماتشو_إكس = { الاسم: الاسم, القسم: القسم, القيمة: القيمة };
    ألحق((*السجل).الرموز, الرمز);
    أرجع نتيجة.نجح(الفهرس);
}

عرف رمز_بالمرجع_ماتشو_إكس(
    السجل: &متغير سجل_رموز_ماتشو_إكس,
    المرجع: &مرجع_رمز_كائن,
    القسم: طبيعي,
    القيمة: طبيعي,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): نتيجة طبيعي, خطأ_ماتشو_إكس {
    طابق ابحث_في_الخريطة(&(*السجل).الهوية, المرجع) مع
    | اختياري.موجود(الفهرس) -> { إذا (القسم == 0) { أرجع نتيجة.نجح(الفهرس); }; }
    | اختياري.لا_شيء -> { };
    إذا (القسم == 0 && مرجع_رمز_كائن_هو_بيانات_محلية(المرجع)) {
        أرجع نتيجة.خطأ(خطأ_ماتشو_إكس.رمز_إزاحة_مفقود());
    };
    دع الاسم: متجه ط8;
    طابق اسم_مرجع_رمز_ماتشو_إكس(المرجع, الهدف, الرموز_الخارجية) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ماتشو_إكس.رمز_إزاحة_مفقود()); }
    | اختياري.موجود(القيمة_الاسمية) -> { الاسم := القيمة_الاسمية; };
    طابق رمز_بالاسم_ماتشو_إكس(السجل, الاسم, القسم, القيمة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الفهرس) -> {
        طابق أدرج_في_الخريطة(&متغير (*السجل).الهوية, انسخ_مرجع_رمز_كائن(المرجع), الفهرس) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_ماتشو_إكس.حدود_صيغة_متجاوزة()); }
        | نتيجة.نجح(_) -> { };
        أرجع نتيجة.نجح(الفهرس);
    };
}

عرف ألحق_إزاحة_ماتشو_إكس(
    الإزاحات: &متغير متجه إزاحة_ماتشو_إكس,
    الموضع: طبيعي, الرمز: طبيعي, النوع: طبيعي, نسبي: منطقي, الطول: طبيعي
): فراغ {
    دع الإزاحة: إزاحة_ماتشو_إكس = { الموضع: الموضع, الرمز: الرمز, النوع: النوع, نسبي: نسبي, الطول: الطول };
    ألحق(*الإزاحات, الإزاحة);
}

عام عرف اكتب_كائن_ماتشو_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دخول_العملية: اختياري دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون,
    الرموز_الخارجية: &متجه متجه ط8
): نتيجة_ماتشو_إكس {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> { أرجع نتيجة_ماتشو_إكس.خطأ(خطأ_ماتشو_إكس.معمارية_غير_مدعومة((*الهدف).المعرف)); };
    دع السجل: متغير سجل_رموز_ماتشو_إكس = {
        الرموز: [],
        الهوية: أنشئ_الخريطة(هاش_هوية_رمز_ماتشو_إكس, مرجعا_رمز_كائن_متساويان),
        الأسماء: أنشئ_الخريطة(هاش_فنڤ1أ_طبيعي_للبايتات, اسما_رمز_خارجي_كائن_متساويان)
    };
    دع النص: متغير متجه ط8 = انسخ_بايتات(&(*الشفرة).البيانات);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الشفرة).الدوال) مثل طبيعي)) {
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة((*الشفرة).الدوال[ف].الدالة);
        طابق رمز_بالمرجع_ماتشو_إكس(&متغير السجل, &المرجع, 1, (*الشفرة).الدوال[ف].إزاحة_بايت, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ماتشو_إكس.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    طابق دخول_العملية مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        طابق رمز_بالاسم_ماتشو_إكس(&متغير السجل, بايتات_من_نص(«_main»), 1, الدخول.إزاحة_بايت) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ماتشو_إكس.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
    };
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.البيانات_الثابتة) مثل طبيعي)) {
        دع الثابت: &بيانات_ثابتة_كائن = &(*الشفرة).المرفقات.البيانات_الثابتة[ف];
        دع الموضع: طبيعي = حاذ_ماتشو_إكس(الطول(النص) مثل طبيعي, (*الثابت).المحاذاة);
        ألحق_أصفار_ماتشو_إكس(&متغير النص, الموضع - (الطول(النص) مثل طبيعي));
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.بيانات_ثابتة((*الثابت).المعرف);
        طابق رمز_بالمرجع_ماتشو_إكس(&متغير السجل, &المرجع, 1, الموضع, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ماتشو_إكس.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول((*الثابت).البيانات) مثل طبيعي)) { ألحق(النص, (*الثابت).البيانات[ب]); ب := ب + 1; }
        ف := ف + 1;
    }

    دع البيانات: متغير متجه ط8 = [];
    دع محاذاة_البيانات: متغير طبيعي = 8;
    دع مواضع_العوام: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع العام: &بيانات_عام_كائن = &(*الشفرة).المرفقات.البيانات_العامة[ف];
        إذا ((*العام).المحاذاة > محاذاة_البيانات) { محاذاة_البيانات := (*العام).المحاذاة; };
        دع الموضع: طبيعي = حاذ_ماتشو_إكس(الطول(البيانات) مثل طبيعي, (*العام).المحاذاة);
        ألحق_أصفار_ماتشو_إكس(&متغير البيانات, الموضع - (الطول(البيانات) مثل طبيعي));
        ألحق(مواضع_العوام, الموضع);
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.عام((*العام).المعرف);
        طابق رمز_بالمرجع_ماتشو_إكس(&متغير السجل, &المرجع, 2, الموضع, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ماتشو_إكس.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول((*العام).البيانات) مثل طبيعي)) { ألحق(البيانات, (*العام).البيانات[ب]); ب := ب + 1; }
        ف := ف + 1;
    }
    // An executable's `_main` owns the startup data it stores.
    طابق دخول_العملية مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(_) -> {
        دع الأسماء: متجه متجه ط8 = [
            اسم_عدد_وسائط_إقلاع_أساسي(), اسم_مؤشر_وسائط_إقلاع_أساسي(), اسم_مؤشر_بيئة_إقلاع_أساسي()
        ];
        ف := 0;
        طالما (ف < 3) {
            دع الموضع: طبيعي = حاذ_ماتشو_إكس(الطول(البيانات) مثل طبيعي, 8);
            ألحق_أصفار_ماتشو_إكس(&متغير البيانات, الموضع - (الطول(البيانات) مثل طبيعي) + 8);
            طابق رمز_بالاسم_ماتشو_إكس(&متغير السجل, بشرطة_ماتشو_إكس(&الأسماء[ف]), 2, الموضع) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ماتشو_إكس.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            ف := ف + 1;
        }
    };

    // Data relocations: X86_64_RELOC_UNSIGNED, length 3, addend in the field.
    دع إزاحات_البيانات: متغير متجه إزاحة_ماتشو_إكس = [];
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع العام: &بيانات_عام_كائن = &(*الشفرة).المرفقات.البيانات_العامة[ف];
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*العام).الإزاحات) مثل طبيعي)) {
            دع الطلب: &طلب_إزاحة_بيانات_كائن = &(*العام).الإزاحات[ر];
            دع الرمز_المحلول: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
                &(*الطلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
            );
            طابق رمز_بالمرجع_ماتشو_إكس(&متغير السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ماتشو_إكس.خطأ(الخطأ); }
            | نتيجة.نجح(الفهرس) -> {
                دع الموضع: طبيعي = مواضع_العوام[ف] + (*الطلب).الموضع;
                إذا (!اكتب_عدد_ماتشو_إكس(&متغير البيانات, الموضع, (*الطلب).الإضافة مثل عدد, 8)) {
                    أرجع نتيجة_ماتشو_إكس.خطأ(خطأ_ماتشو_إكس.حدود_صيغة_متجاوزة());
                };
                ألحق_إزاحة_ماتشو_إكس(&متغير إزاحات_البيانات, الموضع, الفهرس, 0, خطأ, 3);
            };
            ر := ر + 1;
        }
        ف := ف + 1;
    }

    دع إزاحات_النص: متغير متجه إزاحة_ماتشو_إكس = [];
    ف := 0;
    طالما (ف < (الطول((*الشفرة).إزاحات_النداء) مثل طبيعي)) {
        دع الطلب: &إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = &(*الشفرة).إزاحات_النداء[ف];
        دع الرمز_المحلول: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
            &(*الطلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
        );
        طابق رمز_بالمرجع_ماتشو_إكس(&متغير السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ماتشو_إكس.خطأ(الخطأ); }
        | نتيجة.نجح(الفهرس) -> {
            إذا (!اكتب_عدد_ماتشو_إكس(&متغير النص, (*الطلب).إزاحة_بايت, (*الطلب).الإضافة + 4, 4)) {
                أرجع نتيجة_ماتشو_إكس.خطأ(خطأ_ماتشو_إكس.حدود_صيغة_متجاوزة());
            };
            // X86_64_RELOC_BRANCH (2) for a call, X86_64_RELOC_SIGNED (1) otherwise.
            دع النوع: متغير طبيعي = 1;
            طابق (*الطلب).النوع مع
            | نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء -> { النوع := 2; }
            | نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان -> { };
            ألحق_إزاحة_ماتشو_إكس(&متغير إزاحات_النص, (*الطلب).إزاحة_بايت, الفهرس, النوع, صواب, 2);
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.إزاحات_النص) مثل طبيعي)) {
        دع الطلب: &طلب_إزاحة_نص_كائن = &(*الشفرة).المرفقات.إزاحات_النص[ف];
        دع بداية: متغير طبيعي = 0;
        دع وجدت: متغير منطقي = خطأ;
        دع د: متغير طبيعي = 0;
        طالما (د < (الطول((*الشفرة).الدوال) مثل طبيعي) && !وجدت) {
            إذا (معرفا_دالة_منتقاة_متساويان((*الشفرة).الدوال[د].الدالة, (*الطلب).الموضع.الدالة)) {
                بداية := (*الشفرة).الدوال[د].إزاحة_بايت;
                وجدت := صواب;
            };
            د := د + 1;
        }
        إذا (!وجدت) { أرجع نتيجة_ماتشو_إكس.خطأ(خطأ_ماتشو_إكس.حدود_صيغة_متجاوزة()); };
        دع الموضع: طبيعي = بداية + (*الطلب).الموضع.إزاحة_بايت;
        دع الرمز_المحلول: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
            &(*الطلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
        );
        طابق رمز_بالمرجع_ماتشو_إكس(&متغير السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ماتشو_إكس.خطأ(الخطأ); }
        | نتيجة.نجح(الفهرس) -> {
            طابق (*الطلب).النوع مع
            | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> {
                إذا (!اكتب_عدد_ماتشو_إكس(&متغير النص, الموضع, (*الطلب).الإضافة, 8)) {
                    أرجع نتيجة_ماتشو_إكس.خطأ(خطأ_ماتشو_إكس.حدود_صيغة_متجاوزة());
                };
                ألحق_إزاحة_ماتشو_إكس(&متغير إزاحات_النص, الموضع, الفهرس, 0, خطأ, 3);
            }
            | نوع_إزاحة_رمزية_كائن.تحميل_جوت_إكس_نسبي_اثنان_وثلاثون -> {
                إذا (!اكتب_عدد_ماتشو_إكس(&متغير النص, الموضع, (*الطلب).الإضافة + 4, 4)
                    || الموضع < 2 || النص[الموضع - 2] != 0x8B) {
                    أرجع نتيجة_ماتشو_إكس.خطأ(خطأ_ماتشو_إكس.حدود_صيغة_متجاوزة());
                };
                إذا (السجل.الرموز[الفهرس].القسم != 0) {
                    // A datum this object defines (the startup data): the MOV
                    // from its GOT slot becomes LEA of the datum, as linkers
                    // relax a GOT load of a local symbol.
                    النص[الموضع - 2] := 0x8D مثل ط8;
                    ألحق_إزاحة_ماتشو_إكس(&متغير إزاحات_النص, الموضع, الفهرس, 1, صواب, 2);
                } وإلا {
                    // X86_64_RELOC_GOT_LOAD on a MOV from the symbol's GOT slot.
                    ألحق_إزاحة_ماتشو_إكس(&متغير إزاحات_النص, الموضع, الفهرس, 3, صواب, 2);
                };
            }
            | _ -> { أرجع نتيجة_ماتشو_إكس.خطأ(خطأ_ماتشو_إكس.إزاحة_غير_مدعومة()); };
        };
        ف := ف + 1;
    }

    دع المنشئات: متغير متجه ط8 = [];
    دع إزاحات_المنشئات: متغير متجه إزاحة_ماتشو_إكس = [];
    طابق (*الشفرة).المرفقات.منشئ_الوحدة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المعرف) -> {
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(المعرف);
        طابق رمز_بالمرجع_ماتشو_إكس(&متغير السجل, &المرجع, 0, 0, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ماتشو_إكس.خطأ(الخطأ); }
        | نتيجة.نجح(الفهرس) -> {
            ألحق_أصفار_ماتشو_إكس(&متغير المنشئات, 8);
            ألحق_إزاحة_ماتشو_إكس(&متغير إزاحات_المنشئات, 0, الفهرس, 0, خطأ, 3);
        };
    };

    // Symbol order: defined (by section) first, then undefined.
    دع العدد_الكلي: طبيعي = الطول(السجل.الرموز) مثل طبيعي;
    دع الترتيب: متغير متجه طبيعي = [];
    دع الفهرس_الجديد: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد_الكلي) { ألحق(الفهرس_الجديد, 0); ف := ف + 1; }
    دع المعرفة: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < العدد_الكلي) {
        إذا (السجل.الرموز[ف].القسم != 0) {
            الفهرس_الجديد[ف] := الطول(الترتيب) مثل طبيعي;
            ألحق(الترتيب, ف);
            المعرفة := المعرفة + 1;
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < العدد_الكلي) {
        إذا (السجل.الرموز[ف].القسم == 0) {
            الفهرس_الجديد[ف] := الطول(الترتيب) مثل طبيعي;
            ألحق(الترتيب, ف);
        };
        ف := ف + 1;
    }

    دع عدد_الأقسام: متغير طبيعي = 2;
    إذا ((الطول(المنشئات) مثل طبيعي) > 0) { عدد_الأقسام := 3; };
    دع حجم_الأوامر: طبيعي = 72 + 80 * عدد_الأقسام + 24 + 80 + 24;
    دع بداية: طبيعي = 32 + حجم_الأوامر;
    // Section file offsets equal their addresses plus `بداية`.
    دع عنوان_النص: طبيعي = 0;
    دع عنوان_البيانات: طبيعي = حاذ_ماتشو_إكس(الطول(النص) مثل طبيعي, محاذاة_البيانات);
    دع عنوان_المنشئات: طبيعي = حاذ_ماتشو_إكس(عنوان_البيانات + (الطول(البيانات) مثل طبيعي), 8);
    دع نهاية_العناوين: متغير طبيعي = عنوان_البيانات + (الطول(البيانات) مثل طبيعي);
    إذا (عدد_الأقسام == 3) { نهاية_العناوين := عنوان_المنشئات + 8; };
    دع موضع_الإزاحات: طبيعي = حاذ_ماتشو_إكس(بداية + نهاية_العناوين, 4);
    دع موضع_إزاحات_البيانات: طبيعي = موضع_الإزاحات + 8 * (الطول(إزاحات_النص) مثل طبيعي);
    دع موضع_إزاحات_المنشئات: طبيعي = موضع_إزاحات_البيانات + 8 * (الطول(إزاحات_البيانات) مثل طبيعي);
    دع موضع_الرموز: طبيعي = حاذ_ماتشو_إكس(موضع_إزاحات_المنشئات + 8 * (الطول(إزاحات_المنشئات) مثل طبيعي), 8);
    دع عناوين: متجه طبيعي = [عنوان_النص, عنوان_البيانات, عنوان_المنشئات];

    // String table: a leading NUL, then each name.
    دع النصوص: متغير متجه ط8 = [0x20, 0];
    دع مواضع_الأسماء: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد_الكلي) {
        دع الرمز: &رمز_ماتشو_إكس = &السجل.الرموز[الترتيب[ف]];
        ألحق(مواضع_الأسماء, الطول(النصوص) مثل طبيعي);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الرمز).الاسم) مثل طبيعي)) { ألحق(النصوص, (*الرمز).الاسم[ك]); ك := ك + 1; }
        ألحق(النصوص, 0 مثل ط8);
        ف := ف + 1;
    }
    دع موضع_النصوص: طبيعي = موضع_الرموز + 16 * العدد_الكلي;

    دع ب: متغير متجه ط8 = [];
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0xFEEDFACF);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0x01000007);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 3);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 1);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 4);
    ألحق_ط32_ماتشو_إكس(&متغير ب, حجم_الأوامر);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0);
    // LC_SEGMENT_64 with every section.
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0x19);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 72 + 80 * عدد_الأقسام);
    ألحق_أصفار_ماتشو_إكس(&متغير ب, 16);
    ألحق_ط64_ماتشو_إكس(&متغير ب, 0);
    ألحق_ط64_ماتشو_إكس(&متغير ب, نهاية_العناوين);
    ألحق_ط64_ماتشو_إكس(&متغير ب, بداية);
    ألحق_ط64_ماتشو_إكس(&متغير ب, نهاية_العناوين);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 7);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 7);
    ألحق_ط32_ماتشو_إكس(&متغير ب, عدد_الأقسام);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0);
    دع أسماء_الأقسام: متجه نص = [«__text», «__data», «__mod_init_func»];
    دع أسماء_المقاطع: متجه نص = [«__TEXT», «__DATA», «__DATA»];
    دع الأحجام: متجه طبيعي = [الطول(النص) مثل طبيعي, الطول(البيانات) مثل طبيعي, 8];
    دع المحاذيات: متجه طبيعي = [4, أس_محاذاة_ماتشو_إكس(محاذاة_البيانات), 3];
    دع مواضع_الإزاحات_للأقسام: متجه طبيعي = [موضع_الإزاحات, موضع_إزاحات_البيانات, موضع_إزاحات_المنشئات];
    دع أعداد_الإزاحات: متجه طبيعي = [
        الطول(إزاحات_النص) مثل طبيعي, الطول(إزاحات_البيانات) مثل طبيعي, الطول(إزاحات_المنشئات) مثل طبيعي
    ];
    // S_ATTR_PURE_INSTRUCTIONS|S_ATTR_SOME_INSTRUCTIONS; S_REGULAR;
    // S_MOD_INIT_FUNC_POINTERS.
    دع الأعلام: متجه طبيعي = [0x80000400, 0, 0x9];
    ف := 0;
    طالما (ف < عدد_الأقسام) {
        ألحق_اسم_ستة_عشر_ماتشو_إكس(&متغير ب, &أسماء_الأقسام[ف]);
        ألحق_اسم_ستة_عشر_ماتشو_إكس(&متغير ب, &أسماء_المقاطع[ف]);
        ألحق_ط64_ماتشو_إكس(&متغير ب, عناوين[ف]);
        ألحق_ط64_ماتشو_إكس(&متغير ب, الأحجام[ف]);
        ألحق_ط32_ماتشو_إكس(&متغير ب, بداية + عناوين[ف]);
        ألحق_ط32_ماتشو_إكس(&متغير ب, المحاذيات[ف]);
        إذا (أعداد_الإزاحات[ف] > 0) { ألحق_ط32_ماتشو_إكس(&متغير ب, مواضع_الإزاحات_للأقسام[ف]); }
        وإلا { ألحق_ط32_ماتشو_إكس(&متغير ب, 0); };
        ألحق_ط32_ماتشو_إكس(&متغير ب, أعداد_الإزاحات[ف]);
        ألحق_ط32_ماتشو_إكس(&متغير ب, الأعلام[ف]);
        ألحق_أصفار_ماتشو_إكس(&متغير ب, 12);
        ف := ف + 1;
    }
    // LC_SYMTAB.
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0x2);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 24);
    ألحق_ط32_ماتشو_إكس(&متغير ب, موضع_الرموز);
    ألحق_ط32_ماتشو_إكس(&متغير ب, العدد_الكلي);
    ألحق_ط32_ماتشو_إكس(&متغير ب, موضع_النصوص);
    ألحق_ط32_ماتشو_إكس(&متغير ب, الطول(النصوص) مثل طبيعي);
    // LC_DYSYMTAB: no locals, the defined externals, then the undefined.
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0xB);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 80);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0);
    ألحق_ط32_ماتشو_إكس(&متغير ب, المعرفة);
    ألحق_ط32_ماتشو_إكس(&متغير ب, المعرفة);
    ألحق_ط32_ماتشو_إكس(&متغير ب, العدد_الكلي - المعرفة);
    ألحق_أصفار_ماتشو_إكس(&متغير ب, 48);
    // LC_BUILD_VERSION: macOS, minimum 10.15, no SDK, no tools.
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0x32);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 24);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 1);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0x000A0F00);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0);
    ألحق_ط32_ماتشو_إكس(&متغير ب, 0);
    // Section contents at their addresses.
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(النص) مثل طبيعي)) { ألحق(ب, النص[ك]); ك := ك + 1; }
    ألحق_أصفار_ماتشو_إكس(&متغير ب, بداية + عنوان_البيانات - (الطول(ب) مثل طبيعي));
    ك := 0;
    طالما (ك < (الطول(البيانات) مثل طبيعي)) { ألحق(ب, البيانات[ك]); ك := ك + 1; }
    إذا (عدد_الأقسام == 3) {
        ألحق_أصفار_ماتشو_إكس(&متغير ب, بداية + عنوان_المنشئات - (الطول(ب) مثل طبيعي));
        ألحق_أصفار_ماتشو_إكس(&متغير ب, 8);
    };
    ألحق_أصفار_ماتشو_إكس(&متغير ب, موضع_الإزاحات - (الطول(ب) مثل طبيعي));
    دع جميع_الإزاحات: متجه متجه إزاحة_ماتشو_إكس = [إزاحات_النص, إزاحات_البيانات, إزاحات_المنشئات];
    ف := 0;
    طالما (ف < 3) {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(جميع_الإزاحات[ف]) مثل طبيعي)) {
            دع الإزاحة: &إزاحة_ماتشو_إكس = &جميع_الإزاحات[ف][ر];
            ألحق_ط32_ماتشو_إكس(&متغير ب, (*الإزاحة).الموضع);
            دع المعلومات: متغير طبيعي = الفهرس_الجديد[(*الإزاحة).الرمز];
            إذا ((*الإزاحة).نسبي) { المعلومات := المعلومات + 0x1000000; };
            المعلومات := المعلومات + (*الإزاحة).الطول * 0x2000000 + 0x8000000 + (*الإزاحة).النوع * 0x10000000;
            ألحق_ط32_ماتشو_إكس(&متغير ب, المعلومات);
            ر := ر + 1;
        }
        ف := ف + 1;
    }
    ألحق_أصفار_ماتشو_إكس(&متغير ب, موضع_الرموز - (الطول(ب) مثل طبيعي));
    ف := 0;
    طالما (ف < العدد_الكلي) {
        دع الرمز: &رمز_ماتشو_إكس = &السجل.الرموز[الترتيب[ف]];
        ألحق_ط32_ماتشو_إكس(&متغير ب, مواضع_الأسماء[ف]);
        إذا ((*الرمز).القسم == 0) {
            ألحق_ط8_ماتشو_إكس(&متغير ب, 0x01);
            ألحق_ط8_ماتشو_إكس(&متغير ب, 0);
            ألحق_ط8_ماتشو_إكس(&متغير ب, 0);
            ألحق_ط8_ماتشو_إكس(&متغير ب, 0);
            ألحق_ط64_ماتشو_إكس(&متغير ب, 0);
        } وإلا {
            ألحق_ط8_ماتشو_إكس(&متغير ب, 0x0F);
            ألحق_ط8_ماتشو_إكس(&متغير ب, (*الرمز).القسم);
            ألحق_ط8_ماتشو_إكس(&متغير ب, 0);
            ألحق_ط8_ماتشو_إكس(&متغير ب, 0);
            ألحق_ط64_ماتشو_إكس(&متغير ب, عناوين[(*الرمز).القسم - 1] + (*الرمز).القيمة);
        };
        ف := ف + 1;
    }
    ك := 0;
    طالما (ك < (الطول(النصوص) مثل طبيعي)) { ألحق(ب, النصوص[ك]); ك := ك + 1; }
    أرجع نتيجة_ماتشو_إكس.نجح(ب);
}
