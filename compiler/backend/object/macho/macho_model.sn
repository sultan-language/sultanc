استورد compiler.backend.target.target_model;
استورد compiler.backend.object.object_reference_model;

// نموذج Mach-O مملوك لصيغة الكائن. الطلبات الرمزية تأتي من النموذج المشترك ولا تعرف ترميز Mach-O.
عام نوع نوع_إزاحة_ماتشو =
    | فرع_ذراع_ستة_وعشرون_بت
    | صفحة_ذراع_واحد_وعشرون_بت
    | إزاحة_صفحة_ذراع_اثنا_عشر_بت
    | مطلق_أربعة_وستون_بت
;

عام نوع إزاحة_ماتشو = {
    إزاحة_بايت: غير_موقع,
    النوع: نوع_إزاحة_ماتشو,
    الرمز: مرجع_رمز_كائن
};

عام نوع قسم_ماتشو = {
    الاسم: متجه غ8,
    اسم_المقطع: متجه غ8,
    البيانات: متجه غ8,
    المحاذاة_الأسية: غير_موقع,
    الأعلام: غير_موقع,
    الإزاحات: متجه إزاحة_ماتشو
};

عام نوع موضع_رمز_ماتشو =
    | معرف_في_قسم بنوع (غير_موقع, غير_موقع)
    | غير_معرف
;

عام نوع رمز_ماتشو = {
    المرجع: مرجع_رمز_كائن,
    الاسم: متجه غ8,
    الموضع: موضع_رمز_ماتشو
};

عام نوع جدول_نصوص_ماتشو = {
    البيانات: متجه غ8,
    إزاحات_الرموز: متجه غير_موقع
};

عام نوع كائن_ماتشو = {
    الهدف: معرف_هدف,
    الأقسام: متجه قسم_ماتشو,
    الرموز: متجه رمز_ماتشو,
    عدد_الرموز_المعرفة: غير_موقع
};
