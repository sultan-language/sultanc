// واجهة تعريفية لأخطاء Mach-O. إصدار الكائن الفعلي مملوك لحد object/object_emission.sn.
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.target.target_model;
استورد compiler.backend.object.object_reference_model;

عام نوع خطأ_ماتشو =
    | هدف_غير_متوافق بنوع معرف_هدف
    | دالة_مكررة بنوع معرف_دالة_منتقاة
    | كلمة_تعليمة_خارج_نطاق_غ32 بنوع معرف_دالة_منتقاة
    | تثبيت_غير_صالح بنوع معرف_دالة_منتقاة
    | إضافة_تثبيت_غير_مدعومة بنوع معرف_دالة_منتقاة
    | طلب_إزاحة_غير_صالح بنوع معرف_دالة_منتقاة
    | نوع_إزاحة_غير_مدعوم
    | رمز_تشغيل_غير_متاح
    | بيانات_ثابتة_مكررة بنوع غير_موقع
    | حدود_صيغة_متجاوزة
    | قسم_نص_مفقود
    | رمز_إزاحة_مفقود
    | رمز_دخول_مفقود بنوع معرف_دالة_منتقاة
;
