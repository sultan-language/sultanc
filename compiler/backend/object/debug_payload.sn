// Writer-facing debug-section data. This is not a DWARF semantic model and
// never carries producer-side fixup tables. The linker builds it from parsed
// object sections and relocations after canonical symbol resolution.
عام نوع هوية_قسم_تصحيح_تسلسل = {
    اسم_القسم: متجه غ8,
    اسم_الحاوية: اختيار متجه غ8
};

عام نوع هدف_إزاحة_تصحيح_تسلسل =
    | قسم بنوع (هوية_قسم_تصحيح_تسلسل, غير_موقع)
    | مطلق بنوع غير_موقع
;

عام نوع إزاحة_قسم_تصحيح_تسلسل = {
    الموضع: غير_موقع,
    الإضافة: عدد,
    رمز_صيغة: غير_موقع,
    الهدف: هدف_إزاحة_تصحيح_تسلسل
};

عام نوع قسم_تصحيح_تسلسل = {
    الهوية: هوية_قسم_تصحيح_تسلسل,
    المحاذاة: غير_موقع,
    المحتوى: متجه غ8,
    الإزاحات: متجه إزاحة_قسم_تصحيح_تسلسل
};

عام نوع حمولة_أقسام_تصحيح_تسلسل = {
    الأقسام: متجه قسم_تصحيح_تسلسل
};

عام عرف أنشئ_حمولة_أقسام_تصحيح_فارغة(
): حمولة_أقسام_تصحيح_تسلسل {
    دع الأقسام: متجه قسم_تصحيح_تسلسل = [];
    دع الحمولة: حمولة_أقسام_تصحيح_تسلسل = { الأقسام: الأقسام };
    أرجع الحمولة;
}
