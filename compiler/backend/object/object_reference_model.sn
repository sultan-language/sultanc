استورد std.text.from_bytes;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.msir.identifiers;

// هوية ثابتة داخل مخرج كائني واحد. نطاق FunctionID يمنع تصادم
// المعرفات المحلية للثوابت بين دوال المترجم المختلفة.
عام نوع معرف_بيانات_ثابتة_كائن = {
    الدالة: معرف_دالة_منتقاة,
    القيمة: طبيعي
};

عام عرف معرف_بيانات_ثابتة_كائن_من(
    الدالة: معرف_دالة_منتقاة,
    القيمة: طبيعي
): معرف_بيانات_ثابتة_كائن {
    دع المعرف: معرف_بيانات_ثابتة_كائن = {
        الدالة: الدالة,
        القيمة: القيمة
    };
    أرجع المعرف;
}

عام نوع مرجع_رمز_كائن =
    | دالة بنوع معرف_دالة_منتقاة
    | رمز_خارجي بنوع معرف_دالة_خارجية_منتقاة
    | خدمة_تشغيل بنوع خدمة_تشغيل_هدف
    | بدائي_تشغيل بنوع هوية_بدائي_مترجم
    | بيانات_ثابتة بنوع معرف_بيانات_ثابتة_كائن
    | عام بنوع معرف_عام_مسير
;

// أنواع التثبيت هي طلبات machine/object فقط؛ صيغة Mach-O/ELF تقرر ترميزها الفعلي.
عام نوع نوع_إزاحة_رمزية_كائن =
    | فرع_ذراع_ستة_وعشرون_بت
    | صفحة_ذراع_واحد_وعشرون_بت
    | إزاحة_صفحة_ذراع_اثنا_عشر_بت
    // x86-64: REX.W MOV from a GOT slot (R_X86_64_REX_GOTPCRELX).
    // The backend emits the instruction and a signed -4 PC-relative addend.
    | تحميل_جوت_إكس_نسبي_اثنان_وثلاثون
    // ARM64 Mach-O: ADRP page of GOT slot followed by LDR of that slot.
    // Both operands name the same imported global, with zero addends.
    // Agent D producer contract: use direct RIP-relative LEA or ADRP/ADD
    // for defined locals. For imports use x86 REX.W MOV [RIP+disp32]
    // (offset points at disp32, addend -4), or ARM64 ADRP xN; LDR xD,
    // [xN, #imm12] (offsets point at their 4-byte instructions, addends 0).
    // GOT page and GOT offset must refer to the same imported symbol.
    | صفحة_تحميل_جوت_ذراع_واحد_وعشرون_بت
    | إزاحة_صفحة_تحميل_جوت_ذراع_اثنا_عشر_بت
    | مطلق_أربعة_وستون_بت
;

// الموضع نسبي إلى دالة مشفرة، كي لا تحتاج المعمارية إلى معرفة ترتيب قسم النص.
عام نوع موضع_إزاحة_نص_كائن = {
    الدالة: معرف_دالة_منتقاة,
    إزاحة_بايت: طبيعي
};

عام نوع طلب_إزاحة_نص_كائن = {
    الموضع: موضع_إزاحة_نص_كائن,
    النوع: نوع_إزاحة_رمزية_كائن,
    الرمز: مرجع_رمز_كائن,
    الإضافة: عدد
};

عام نوع بيانات_ثابتة_كائن = {
    المعرف: معرف_بيانات_ثابتة_كائن,
    البيانات: متجه ط8,
    المحاذاة: طبيعي,
    للقراءة_فقط: منطقي
};

// التخزين العام يظل مرتبطا مباشرة بهوية MSIR؛ object يملك فقط الصورة المادية.
عام نوع طلب_إزاحة_بيانات_كائن = {
    الموضع: طبيعي,
    الرمز: مرجع_رمز_كائن,
    الإضافة: طبيعي
};

عام نوع بيانات_عام_كائن = {
    المعرف: معرف_عام_مسير,
    البيانات: متجه ط8,
    المحاذاة: طبيعي,
    قابل_للكتابة: منطقي,
    الإزاحات: متجه طلب_إزاحة_بيانات_كائن
};

// Imported data belongs to the linker; it has no bytes or local definition.
عام نوع بيانات_خارجية_كائن = {
    المعرف: معرف_عام_مسير,
    الاسم: متجه ط8
};

// مرفقات مشتركة للناتج المشفر. المعمارية تنتج الطلب، object owner يترجمه.
عام نوع مرفقات_كائن_مشفرة = {
    البيانات_الثابتة: متجه بيانات_ثابتة_كائن,
    البيانات_العامة: متجه بيانات_عام_كائن,
    البيانات_الخارجية: متجه بيانات_خارجية_كائن,
    إزاحات_النص: متجه طلب_إزاحة_نص_كائن,
    منشئ_الوحدة: اختياري معرف_دالة_منتقاة
};

عام عرف مرفقات_كائن_مشفرة_فارغة(): مرفقات_كائن_مشفرة {
    دع البيانات_الثابتة: متجه بيانات_ثابتة_كائن = [];
    دع البيانات_العامة: متجه بيانات_عام_كائن = [];
    دع البيانات_الخارجية: متجه بيانات_خارجية_كائن = [];
    دع إزاحات_النص: متجه طلب_إزاحة_نص_كائن = [];
    دع المرفقات: مرفقات_كائن_مشفرة = {
        البيانات_الثابتة: البيانات_الثابتة,
        البيانات_العامة: البيانات_العامة,
        البيانات_الخارجية: البيانات_الخارجية,
        إزاحات_النص: إزاحات_النص,
        منشئ_الوحدة: اختياري.لا_شيء()
    };
    أرجع المرفقات;
}

عام عرف انسخ_معرف_بيانات_ثابتة_كائن(
    المعرف: &معرف_بيانات_ثابتة_كائن
): معرف_بيانات_ثابتة_كائن {
    دع القيمة: معرف_بيانات_ثابتة_كائن = *المعرف;
    أرجع معرف_بيانات_ثابتة_كائن_من(القيمة.الدالة, القيمة.القيمة);
}

عام عرف معرفا_بيانات_ثابتة_كائن_متساويان(
    أ: &معرف_بيانات_ثابتة_كائن,
    ب: &معرف_بيانات_ثابتة_كائن
): منطقي {
    دع اليسار: معرف_بيانات_ثابتة_كائن = *أ;
    دع اليمين: معرف_بيانات_ثابتة_كائن = *ب;
    أرجع معرفا_دالة_منتقاة_متساويان(اليسار.الدالة, اليمين.الدالة)
        && اليسار.القيمة == اليمين.القيمة;
}

عام عرف انسخ_اسم_رمز_خارجي_كائن(الاسم: &متجه ط8): متجه ط8 {
    دع المصدر: متجه ط8 = *الاسم;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        ألحق(الناتج, المصدر[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف اسما_رمز_خارجي_كائن_متساويان(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    دع س: متجه ط8 = *أ;
    دع ص: متجه ط8 = *ب;
    إذا ((الطول(س) مثل طبيعي) != (الطول(ص) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(س) مثل طبيعي)) {
        إذا (س[ف] != ص[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف اسم_رمز_خارجي_كائن_من_جدول(
    المعرف: معرف_دالة_خارجية_منتقاة,
    الأسماء: &متجه متجه ط8
): اختياري متجه ط8 {
    دع جدول: متجه متجه ط8 = *الأسماء;
    إذا (المعرف.القيمة >= (الطول(جدول) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: &متجه ط8 = &جدول[المعرف.القيمة];
    أرجع اختياري.موجود(انسخ_اسم_رمز_خارجي_كائن(الاسم));
}

// The same reference is used by machine code regardless of who owns the
// storage. Object lowering resolves imported globals to the canonical external
// symbol ID, including a startup symbol defined later in this same object.
عام عرف حل_مرجع_بيانات_خارجية_كائن(
    المرجع: &مرجع_رمز_كائن,
    المرفقات: &مرفقات_كائن_مشفرة,
    الأسماء: &متجه متجه ط8
): مرجع_رمز_كائن {
    طابق *المرجع مع
    | مرجع_رمز_كائن.عام(المعرف) -> {
        دع فهرس: متغير طبيعي = 0;
        طالما (فهرس < (الطول((*المرفقات).البيانات_الخارجية) مثل طبيعي)) {
            دع الخارجي: &بيانات_خارجية_كائن = &(*المرفقات).البيانات_الخارجية[فهرس];
            إذا ((*الخارجي).المعرف.القيمة == المعرف.القيمة) {
                دع اسم: &متجه ط8 = &(*الخارجي).الاسم;
                دع فهرس_الاسم: متغير طبيعي = 0;
                طالما (فهرس_الاسم < (الطول(*الأسماء) مثل طبيعي)) {
                    إذا (اسما_رمز_خارجي_كائن_متساويان(اسم, &(*الأسماء)[فهرس_الاسم])) {
                        دع معرف_خارجي: معرف_دالة_خارجية_منتقاة = { القيمة: فهرس_الاسم };
                        أرجع مرجع_رمز_كائن.رمز_خارجي(معرف_خارجي);
                    };
                    فهرس_الاسم := فهرس_الاسم + 1;
                }
            };
            فهرس := فهرس + 1;
        }
    }
    | _ -> { };
    أرجع انسخ_مرجع_رمز_كائن(المرجع);
}

// The program's std storage providers (std os/allocation.sn, bound in MSIR).
// No target has a C allocator: machine code requests the storage services
// symbolically (خدمة_تشغيل) and every such reference is bound here, before
// object emission, to the provider function itself.
عام نوع مزودات_خدمات_تخزين_كائن = {
    التخصيص: معرف_دالة_منتقاة,
    إعادة_التخصيص: معرف_دالة_منتقاة,
    التحرير: معرف_دالة_منتقاة
};

عام عرف مرجع_مزود_خدمة_تخزين(
    المرجع: &مرجع_رمز_كائن,
    المزودات: &مزودات_خدمات_تخزين_كائن
): مرجع_رمز_كائن {
    طابق *المرجع مع
    | مرجع_رمز_كائن.خدمة_تشغيل(الخدمة) -> {
        طابق الخدمة مع
        | خدمة_تشغيل_هدف.تخصيص_ذاكرة -> { أرجع مرجع_رمز_كائن.دالة((*المزودات).التخصيص); }
        | خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة -> { أرجع مرجع_رمز_كائن.دالة((*المزودات).إعادة_التخصيص); }
        | خدمة_تشغيل_هدف.تحرير_ذاكرة -> { أرجع مرجع_رمز_كائن.دالة((*المزودات).التحرير); }
        | _ -> { };
    }
    | _ -> { };
    أرجع انسخ_مرجع_رمز_كائن(المرجع);
}

عام عرف اربط_خدمات_تخزين_مرفقات(
    المرفقات: &متغير مرفقات_كائن_مشفرة,
    المزودات: &مزودات_خدمات_تخزين_كائن
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المرفقات).إزاحات_النص) مثل طبيعي)) {
        دع المربوط: مرجع_رمز_كائن = مرجع_مزود_خدمة_تخزين(&(*المرفقات).إزاحات_النص[ف].الرمز, المزودات);
        (*المرفقات).إزاحات_النص[ف].الرمز := المربوط;
        ف := ف + 1;
    }
}

عام عرف انسخ_مرجع_رمز_كائن(المرجع: &مرجع_رمز_كائن): مرجع_رمز_كائن {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> {
        أرجع مرجع_رمز_كائن.دالة(الدالة);
    }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> {
        أرجع مرجع_رمز_كائن.رمز_خارجي(المعرف);
    }
    | مرجع_رمز_كائن.خدمة_تشغيل(الخدمة) -> {
        دع المنسوخة: خدمة_تشغيل_هدف = انسخ_خدمة_تشغيل_هدف(الخدمة);
        أرجع مرجع_رمز_كائن.خدمة_تشغيل(المنسوخة);
    }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> {
        أرجع مرجع_رمز_كائن.بدائي_تشغيل(انسخ_هوية_بدائي_مترجم(البدائي));
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(البيانات) -> {
        دع المعرف: معرف_بيانات_ثابتة_كائن = انسخ_معرف_بيانات_ثابتة_كائن(&البيانات);
        أرجع مرجع_رمز_كائن.بيانات_ثابتة(المعرف);
    }
    | مرجع_رمز_كائن.عام(المعرف) -> {
        أرجع مرجع_رمز_كائن.عام(معرف_عام_مسير_من(المعرف.القيمة));
    };
}

عام عرف مرجع_رمز_كائن_هو_بيانات_ثابتة(المرجع: &مرجع_رمز_كائن): منطقي {
    طابق *المرجع مع
    | مرجع_رمز_كائن.بيانات_ثابتة(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف مرجع_رمز_كائن_هو_عاما(المرجع: &مرجع_رمز_كائن): منطقي {
    طابق *المرجع مع
    | مرجع_رمز_كائن.عام(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف مرجع_رمز_كائن_هو_بيانات_محلية(المرجع: &مرجع_رمز_كائن): منطقي {
    أرجع مرجع_رمز_كائن_هو_بيانات_ثابتة(المرجع) || مرجع_رمز_كائن_هو_عاما(المرجع);
}

عام عرف مرجعا_رمز_كائن_متساويان(أ: &مرجع_رمز_كائن, ب: &مرجع_رمز_كائن): منطقي {
    طابق *أ مع
    | مرجع_رمز_كائن.دالة(دالة_أ) -> {
        طابق *ب مع
        | مرجع_رمز_كائن.دالة(دالة_ب) -> {
            أرجع معرفا_دالة_منتقاة_متساويان(دالة_أ, دالة_ب);
        }
        | _ -> { أرجع خطأ; };
    }
    | مرجع_رمز_كائن.رمز_خارجي(معرف_أ) -> {
        طابق *ب مع
        | مرجع_رمز_كائن.رمز_خارجي(معرف_ب) -> {
            أرجع معرفا_دالة_خارجية_منتقاة_متساويان(معرف_أ, معرف_ب);
        }
        | _ -> { أرجع خطأ; };
    }
    | مرجع_رمز_كائن.خدمة_تشغيل(خدمة_أ) -> {
        طابق *ب مع
        | مرجع_رمز_كائن.خدمة_تشغيل(خدمة_ب) -> {
            أرجع خدمتا_تشغيل_هدف_متساويتان(خدمة_أ, خدمة_ب);
        }
        | _ -> { أرجع خطأ; };
    }
    | مرجع_رمز_كائن.بدائي_تشغيل(بدائي_أ) -> {
        طابق *ب مع
        | مرجع_رمز_كائن.بدائي_تشغيل(بدائي_ب) -> {
            أرجع هويتا_بدائي_مترجم_متساويتان(بدائي_أ, بدائي_ب);
        }
        | _ -> { أرجع خطأ; };
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(بيانات_أ) -> {
        طابق *ب مع
        | مرجع_رمز_كائن.بيانات_ثابتة(بيانات_ب) -> {
            أرجع معرفا_بيانات_ثابتة_كائن_متساويان(&بيانات_أ, &بيانات_ب);
        }
        | _ -> { أرجع خطأ; };
    }
    | مرجع_رمز_كائن.عام(عام_أ) -> {
        طابق *ب مع
        | مرجع_رمز_كائن.عام(عام_ب) -> { أرجع عاما_مسير_متساويان(عام_أ, عام_ب); }
        | _ -> { أرجع خطأ; };
    };
}

عام عرف انسخ_طلب_إزاحة_نص_كائن(المدخل: &طلب_إزاحة_نص_كائن): طلب_إزاحة_نص_كائن {
    دع القيمة: طلب_إزاحة_نص_كائن = *المدخل;
    دع الموضع: موضع_إزاحة_نص_كائن = {
        الدالة: القيمة.الموضع.الدالة,
        إزاحة_بايت: القيمة.الموضع.إزاحة_بايت
    };
    دع الرمز: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&القيمة.الرمز);
    دع الناتج: طلب_إزاحة_نص_كائن = {
        الموضع: الموضع,
        النوع: القيمة.النوع,
        الرمز: الرمز,
        الإضافة: القيمة.الإضافة
    };
    أرجع الناتج;
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_طلب_إزاحة_نص_كائن(القيمة: &متجه طلب_إزاحة_نص_كائن): متجه طلب_إزاحة_نص_كائن {
    دع الناتج: متغير متجه طلب_إزاحة_نص_كائن = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_بيانات_ثابتة_كائن(القيمة: &متجه بيانات_ثابتة_كائن): متجه بيانات_ثابتة_كائن {
    دع الناتج: متغير متجه بيانات_ثابتة_كائن = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_بيانات_ثابتة_كائن(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_بيانات_ثابتة_كائن(القيمة: &بيانات_ثابتة_كائن): بيانات_ثابتة_كائن {
    دع الناتج: بيانات_ثابتة_كائن = {
        المعرف: (*القيمة).المعرف,
        البيانات: انسخ_بايتات(&(*القيمة).البيانات),
        المحاذاة: (*القيمة).المحاذاة,
        للقراءة_فقط: (*القيمة).للقراءة_فقط
    };
    أرجع الناتج;
}
