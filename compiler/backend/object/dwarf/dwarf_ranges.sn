استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.backend.object.dwarf.dwarf_addresses;
استورد compiler.backend.codegen.debug.model;
استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;

عام نوع جدول_قوائم_نطاقات_دوارف = { القوائم: متجه متجه ط8 };

عام عرف جدول_قوائم_نطاقات_دوارف_فارغ(): جدول_قوائم_نطاقات_دوارف {
    دع القوائم: متجه متجه ط8 = []; دع الناتج: جدول_قوائم_نطاقات_دوارف = { القوائم: القوائم }; أرجع الناتج;
}

// Exact machine ranges for a lexical scope. No collapsing occurs here.
عام عرف مديات_نطاق_دوارف_من_آلة(
    آلة: &سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة,
    النطاق: معرف_نطاق_تصحيح,
    موضع_الدالة: &موضع_دالة_دوارف
): متجه مدى_نص_دوارف {
    دع الناتج: متغير متجه مدى_نص_دوارف = [];
    دع موضع_آلة: طبيعي;
    طابق موضع_دالة_تصحيح_آلة(آلة, الدالة) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الموضع) -> { موضع_آلة := الموضع; };
    دع وصف_الآلة: &تصحيح_دالة_آلة = &(*آلة).الدوال[موضع_آلة];
    دع موضع_فهرس_النطاق: طبيعي;
    طابق موضع_فهرس_نطاق_تصحيح_آلة(وصف_الآلة, النطاق) مع
    | اختياري.موجود(الموضع) -> { موضع_فهرس_النطاق := الموضع; }
    | اختياري.لا_شيء -> { أرجع الناتج; };
    دع الفهارس: &متجه طبيعي = &(*وصف_الآلة).مديات_النطاقات_بالمعرف[موضع_فهرس_النطاق].الفهارس;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الفهارس) مثل طبيعي)) {
        دع موضع_المدى: طبيعي = (*الفهارس)[ف];
        إذا (موضع_المدى < (الطول((*وصف_الآلة).مديات_النطاقات) مثل طبيعي)) {
            دع المدى: &مدى_نطاق_آلة_تصحيح = &(*وصف_الآلة).مديات_النطاقات[موضع_المدى];
            إذا ((*المدى).نهاية_بايت > (*المدى).بداية_بايت) {
                دع البداية: طبيعي = (*موضع_الدالة).إزاحة_بايت + (*المدى).بداية_بايت;
                دع الحجم: طبيعي = (*المدى).نهاية_بايت - (*المدى).بداية_بايت;
                دع الخارج: مدى_نص_دوارف = { إزاحة_بايت: البداية, حجم_بايت: الحجم };
                ألحق(الناتج, الخارج);
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف مدى_نطاق_دوارف_من_آلة(
    آلة: &سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة,
    النطاق: معرف_نطاق_تصحيح,
    موضع_الدالة: &موضع_دالة_دوارف
): اختياري مدى_نص_دوارف {
    دع المديات: متجه مدى_نص_دوارف = مديات_نطاق_دوارف_من_آلة(آلة, الدالة, النطاق, موضع_الدالة);
    إذا ((الطول(المديات) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع الأدنى: متغير طبيعي = المديات[0].إزاحة_بايت;
    دع الأعلى: متغير طبيعي = المديات[0].إزاحة_بايت + المديات[0].حجم_بايت;
    دع ف: متغير طبيعي = 1;
    طالما (ف < (الطول(المديات) مثل طبيعي)) {
        إذا (المديات[ف].إزاحة_بايت < الأدنى) { الأدنى := المديات[ف].إزاحة_بايت; };
        دع النهاية: طبيعي = المديات[ف].إزاحة_بايت + المديات[ف].حجم_بايت;
        إذا (النهاية > الأعلى) { الأعلى := النهاية; };
        ف := ف + 1;
    }
    دع الحجم: طبيعي = الأعلى - الأدنى;
    دع الخارج: مدى_نص_دوارف = { إزاحة_بايت: الأدنى, حجم_بايت: الحجم };
    أرجع اختياري.موجود(الخارج);
}

عام عرف أدرج_قائمة_نطاقات_دوارف(
    الجدول: &متغير جدول_قوائم_نطاقات_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف,
    المديات: &متجه مدى_نص_دوارف
): طبيعي {
    دع القائمة: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المديات) مثل طبيعي)) {
        دع فهرس_العنوان: طبيعي = أدرج_عنوان_نص_دوارف(العناوين, (*المديات)[ف].إزاحة_بايت);
        ألحق_ط8_دوارف(&متغير القائمة, رمز_مدخل_نطاق_دوارف(نوع_مدخل_نطاق_دوارف.عنوان_مفهرس_وطول()));
        ألحق_ليب128_دوارف(&متغير القائمة, فهرس_العنوان);
        ألحق_ليب128_دوارف(&متغير القائمة, (*المديات)[ف].حجم_بايت);
        ف := ف + 1;
    }
    ألحق_ط8_دوارف(&متغير القائمة, رمز_مدخل_نطاق_دوارف(نوع_مدخل_نطاق_دوارف.نهاية()));
    دع الفهرس: طبيعي = الطول((*الجدول).القوائم) مثل طبيعي;
    ألحق((*الجدول).القوائم, القائمة);
    أرجع الفهرس;
}

عام عرف ابن_قوائم_نطاقات_دوارف(السياسة: &سياسة_دوارف, الجدول: &جدول_قوائم_نطاقات_دوارف): متجه ط8 {
    دع ب: متغير متجه ط8 = [];
    إذا (!(*السياسة).حديث) { أرجع ب; };
    دع بداية: طبيعي = ابدأ_وحدة_دوارف(&متغير ب, السياسة);
    ألحق_ط16_دوارف(&متغير ب, رمز_إصدار_دوارف((*السياسة).الإصدار)); ألحق_ط8_دوارف(&متغير ب, (*السياسة).حجم_العنوان); ألحق_ط8_دوارف(&متغير ب, 0);
    ألحق_ط32_دوارف(&متغير ب, الطول((*الجدول).القوائم) مثل طبيعي);
    دع مواضع: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الجدول).القوائم) مثل طبيعي)) { ألحق(مواضع, الطول(ب) مثل طبيعي); ألحق_إزاحة_دوارف(&متغير ب, السياسة, 0); ف := ف + 1; }
    دع القاعدة: طبيعي = قاعدة_جدول_قوائم_دوارف(السياسة);
    ف := 0;
    طالما (ف < (الطول((*الجدول).القوائم) مثل طبيعي)) {
        دع بداية_القائمة: طبيعي = الطول(ب) مثل طبيعي;
        اكتب_إزاحة_دوارف(&متغير ب, السياسة, مواضع[ف], بداية_القائمة - القاعدة);
        ألحق_بايتات_دوارف(&متغير ب, &(*الجدول).القوائم[ف]);
        ف := ف + 1;
    }
    اختم_وحدة_دوارف(&متغير ب, السياسة, بداية);
    أرجع ب;
}

عام عرف ابن_نطاقات_عناوين_دوارف(
    حجم_النص: طبيعي,
    السياسة: &سياسة_دوارف,
    البيانات: &متغير متجه ط8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    دع بداية: طبيعي = ابدأ_وحدة_دوارف(البيانات, السياسة);
    ألحق_ط16_دوارف(البيانات, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.إصدار_نطاقات_عناوين()));
    ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.نطاقات_عناوين(), قسم_بيانات_دوارف.معلومات(), 0);
    ألحق_ط8_دوارف(البيانات, (*السياسة).حجم_العنوان);
    ألحق_ط8_دوارف(البيانات, 0);
    دع محاذاة: طبيعي = (*السياسة).حجم_العنوان * 2;
    دع طول_البيانات: متغير طبيعي = الطول(*البيانات) مثل طبيعي;
    طالما ((طول_البيانات % محاذاة) != 0) { ألحق_ط8_دوارف(البيانات, 0); طول_البيانات := طول_البيانات + 1; }
    إذا (حجم_النص > 0) {
        ألحق_مرجع_عنوان_دوارف(البيانات, الرقع, قسم_عنوان_دوارف.نطاقات_عناوين(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), 0);
        إذا ((*السياسة).حجم_العنوان == 8) { ألحق_ط64_دوارف(البيانات, حجم_النص); } وإلا { ألحق_ط32_دوارف(البيانات, حجم_النص); };
    };
    دع ف: متغير طبيعي = 0; طالما (ف < (*السياسة).حجم_العنوان * 2) { ألحق_ط8_دوارف(البيانات, 0); ف := ف + 1; }
    اختم_وحدة_دوارف(البيانات, السياسة, بداية);
}
