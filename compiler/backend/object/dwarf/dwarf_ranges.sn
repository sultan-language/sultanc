استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.backend.object.dwarf.dwarf_addresses;
استورد compiler.backend.codegen.debug.model;
استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;

عام نوع جدول_قوائم_نطاقات_دوارف = { القوائم: متجه متجه غ8 };

عام عرف جدول_قوائم_نطاقات_دوارف_فارغ(): جدول_قوائم_نطاقات_دوارف {
    دع القوائم: متجه متجه غ8 = []; دع الناتج: جدول_قوائم_نطاقات_دوارف = { القوائم: القوائم }; أرجع الناتج;
}

// Exact machine ranges for a lexical scope. No collapsing occurs here.
عام عرف مديات_نطاق_دوارف_من_آلة(
    آلة: &سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة,
    النطاق: معرف_نطاق_تصحيح,
    موضع_الدالة: &موضع_دالة_دوارف
): متجه مدى_نص_دوارف {
    دع الناتج: متغير متجه مدى_نص_دوارف = [];
    دع موضع_آلة: غير_موقع;
    طابق موضع_دالة_تصحيح_آلة(آلة, الدالة) مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الموضع) -> { موضع_آلة := الموضع; };
    دع وصف_الآلة: &تصحيح_دالة_آلة = &(*آلة).الدوال[موضع_آلة];
    دع موضع_فهرس_النطاق: غير_موقع;
    طابق موضع_فهرس_نطاق_تصحيح_آلة(وصف_الآلة, النطاق) مع
    | اختيار.بعض(الموضع) -> { موضع_فهرس_النطاق := الموضع; }
    | اختيار.لا_شيء -> { أرجع الناتج; };
    دع الفهارس: &متجه غير_موقع = &(*وصف_الآلة).مديات_النطاقات_بالمعرف[موضع_فهرس_النطاق].الفهارس;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الفهارس) مثل غير_موقع)) {
        دع موضع_المدى: غير_موقع = (*الفهارس)[ف];
        لو (موضع_المدى < (الطول((*وصف_الآلة).مديات_النطاقات) مثل غير_موقع)) {
            دع المدى: &مدى_نطاق_آلة_تصحيح = &(*وصف_الآلة).مديات_النطاقات[موضع_المدى];
            لو ((*المدى).نهاية_بايت > (*المدى).بداية_بايت) {
                دع البداية: غير_موقع = (*موضع_الدالة).إزاحة_بايت + (*المدى).بداية_بايت;
                دع الحجم: غير_موقع = (*المدى).نهاية_بايت - (*المدى).بداية_بايت;
                دع الخارج: مدى_نص_دوارف = { إزاحة_بايت: البداية, حجم_بايت: الحجم };
                ألحق(الناتج, الخارج);
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف مدى_نطاق_دوارف_من_آلة(
    آلة: &سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة,
    النطاق: معرف_نطاق_تصحيح,
    موضع_الدالة: &موضع_دالة_دوارف
): اختيار مدى_نص_دوارف {
    دع المديات: متجه مدى_نص_دوارف = مديات_نطاق_دوارف_من_آلة(آلة, الدالة, النطاق, موضع_الدالة);
    لو ((الطول(المديات) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع الأدنى: متغير غير_موقع = المديات[0].إزاحة_بايت;
    دع الأعلى: متغير غير_موقع = المديات[0].إزاحة_بايت + المديات[0].حجم_بايت;
    دع ف: متغير غير_موقع = 1;
    بينما (ف < (الطول(المديات) مثل غير_موقع)) {
        لو (المديات[ف].إزاحة_بايت < الأدنى) { الأدنى := المديات[ف].إزاحة_بايت; };
        دع النهاية: غير_موقع = المديات[ف].إزاحة_بايت + المديات[ف].حجم_بايت;
        لو (النهاية > الأعلى) { الأعلى := النهاية; };
        ف := ف + 1;
    }
    دع الحجم: غير_موقع = الأعلى - الأدنى;
    دع الخارج: مدى_نص_دوارف = { إزاحة_بايت: الأدنى, حجم_بايت: الحجم };
    أرجع اختيار.بعض(الخارج);
}

عام عرف أدرج_قائمة_نطاقات_دوارف(
    الجدول: &متغير جدول_قوائم_نطاقات_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف,
    المديات: &متجه مدى_نص_دوارف
): غير_موقع {
    دع القائمة: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المديات) مثل غير_موقع)) {
        دع فهرس_العنوان: غير_موقع = أدرج_عنوان_نص_دوارف(العناوين, (*المديات)[ف].إزاحة_بايت);
        ألحق_غ8_دوارف(&متغير القائمة, رمز_مدخل_نطاق_دوارف(نوع_مدخل_نطاق_دوارف.عنوان_مفهرس_وطول()));
        ألحق_ليب128_دوارف(&متغير القائمة, فهرس_العنوان);
        ألحق_ليب128_دوارف(&متغير القائمة, (*المديات)[ف].حجم_بايت);
        ف := ف + 1;
    }
    ألحق_غ8_دوارف(&متغير القائمة, رمز_مدخل_نطاق_دوارف(نوع_مدخل_نطاق_دوارف.نهاية()));
    دع الفهرس: غير_موقع = الطول((*الجدول).القوائم) مثل غير_موقع;
    ألحق((*الجدول).القوائم, القائمة);
    أرجع الفهرس;
}

عام عرف ابن_قوائم_نطاقات_دوارف(السياسة: &سياسة_دوارف, الجدول: &جدول_قوائم_نطاقات_دوارف): متجه غ8 {
    دع ب: متغير متجه غ8 = [];
    لو (!(*السياسة).حديث) { أرجع ب; };
    دع بداية: غير_موقع = ابدأ_وحدة_دوارف(&متغير ب, السياسة);
    ألحق_غ16_دوارف(&متغير ب, رمز_إصدار_دوارف((*السياسة).الإصدار)); ألحق_غ8_دوارف(&متغير ب, (*السياسة).حجم_العنوان); ألحق_غ8_دوارف(&متغير ب, 0);
    ألحق_غ32_دوارف(&متغير ب, الطول((*الجدول).القوائم) مثل غير_موقع);
    دع مواضع: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الجدول).القوائم) مثل غير_موقع)) { ألحق(مواضع, الطول(ب) مثل غير_موقع); ألحق_إزاحة_دوارف(&متغير ب, السياسة, 0); ف := ف + 1; }
    دع القاعدة: غير_موقع = قاعدة_جدول_قوائم_دوارف(السياسة);
    ف := 0;
    بينما (ف < (الطول((*الجدول).القوائم) مثل غير_موقع)) {
        دع بداية_القائمة: غير_موقع = الطول(ب) مثل غير_موقع;
        اكتب_إزاحة_دوارف(&متغير ب, السياسة, مواضع[ف], بداية_القائمة - القاعدة);
        ألحق_بايتات_دوارف(&متغير ب, &(*الجدول).القوائم[ف]);
        ف := ف + 1;
    }
    اختم_وحدة_دوارف(&متغير ب, السياسة, بداية);
    أرجع ب;
}

عام عرف ابن_نطاقات_عناوين_دوارف(
    حجم_النص: غير_موقع,
    السياسة: &سياسة_دوارف,
    البيانات: &متغير متجه غ8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    دع بداية: غير_موقع = ابدأ_وحدة_دوارف(البيانات, السياسة);
    ألحق_غ16_دوارف(البيانات, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.إصدار_نطاقات_عناوين()));
    ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.نطاقات_عناوين(), قسم_بيانات_دوارف.معلومات(), 0);
    ألحق_غ8_دوارف(البيانات, (*السياسة).حجم_العنوان);
    ألحق_غ8_دوارف(البيانات, 0);
    دع محاذاة: غير_موقع = (*السياسة).حجم_العنوان * 2;
    بينما (((الطول(*البيانات) مثل غير_موقع) % محاذاة) != 0) { ألحق_غ8_دوارف(البيانات, 0); }
    لو (حجم_النص > 0) {
        ألحق_مرجع_عنوان_دوارف(البيانات, الرقع, قسم_عنوان_دوارف.نطاقات_عناوين(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), 0);
        لو ((*السياسة).حجم_العنوان == 8) { ألحق_غ64_دوارف(البيانات, حجم_النص); } وإلا { ألحق_غ32_دوارف(البيانات, حجم_النص); };
    };
    دع ف: متغير غير_موقع = 0; بينما (ف < (*السياسة).حجم_العنوان * 2) { ألحق_غ8_دوارف(البيانات, 0); ف := ف + 1; }
    اختم_وحدة_دوارف(البيانات, السياسة, بداية);
}
