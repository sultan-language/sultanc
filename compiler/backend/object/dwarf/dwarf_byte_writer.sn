استورد std.encoding.binary;
استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_constants;

// Canonical byte/LEB writer for every DWARF section. No semantic or object-layout facts live here.
عام عرف ألحق_ط8_دوارف(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق(*البايتات, (القيمة % 256) مثل ط8);
}

عام عرف ألحق_ط16_دوارف(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    اكتب_ط16_بالبايت_الأقل_أهمية_أولا(البايتات, (القيمة & 0xFFFF) مثل ط16);
}

عام عرف ألحق_ط32_دوارف(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    اكتب_ط32_بالبايت_الأقل_أهمية_أولا(البايتات, (القيمة & 0xFFFFFFFF) مثل ط32);
}

عام عرف ألحق_ط64_دوارف(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    اكتب_ط64_بالبايت_الأقل_أهمية_أولا(البايتات, القيمة مثل ط64);
}

عام عرف اكتب_ط32_دوارف(البايتات: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي): فراغ {
    دع ح: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        دع الحالي: طبيعي = الموضع + ف;
        (*البايتات)[الحالي] := (ح % 256) مثل ط8;
        ح := ح / 256;
        ف := ف + 1;
    }
}

عام عرف اكتب_ط64_دوارف(البايتات: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي): فراغ {
    دع ح: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        دع الحالي: طبيعي = الموضع + ف;
        (*البايتات)[الحالي] := (ح % 256) مثل ط8;
        ح := ح / 256;
        ف := ف + 1;
    }
}

عام عرف ألحق_إزاحة_دوارف(البايتات: &متغير متجه ط8, السياسة: &سياسة_دوارف, القيمة: طبيعي): فراغ {
    لو ((*السياسة).حجم_الإزاحة == 8) { ألحق_ط64_دوارف(البايتات, القيمة); }
    وإلا { ألحق_ط32_دوارف(البايتات, القيمة); };
}

عام عرف اكتب_إزاحة_دوارف(البايتات: &متغير متجه ط8, السياسة: &سياسة_دوارف, الموضع: طبيعي, القيمة: طبيعي): فراغ {
    لو ((*السياسة).حجم_الإزاحة == 8) { اكتب_ط64_دوارف(البايتات, الموضع, القيمة); }
    وإلا { اكتب_ط32_دوارف(البايتات, الموضع, القيمة); };
}

// Returns the position of the initial-length field. DWARF32 uses a 4-byte
// initial length; DWARF64 uses 0xffffffff followed by an 8-byte length.
عام عرف ابدأ_وحدة_دوارف(البايتات: &متغير متجه ط8, السياسة: &سياسة_دوارف): طبيعي {
    دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
    لو ((*السياسة).حجم_الإزاحة == 8) {
        ألحق_ط32_دوارف(البايتات, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.علامة_طول_دوارف64()));
        ألحق_ط64_دوارف(البايتات, 0);
    } وإلا {
        ألحق_ط32_دوارف(البايتات, 0);
    };
    أرجع الموضع;
}

عام عرف اختم_وحدة_دوارف(البايتات: &متغير متجه ط8, السياسة: &سياسة_دوارف, الموضع: طبيعي): فراغ {
    دع النهاية: طبيعي = الطول(*البايتات) مثل طبيعي;
    لو ((*السياسة).حجم_الإزاحة == 8) {
        اكتب_ط64_دوارف(البايتات, الموضع + 4, النهاية - الموضع - 12);
    } وإلا {
        اكتب_ط32_دوارف(البايتات, الموضع, النهاية - الموضع - 4);
    };
}

عام عرف سجل_رقعة_قسم_دوارف(
    الرقع: &متغير متجه رقعة_قسم_دوارف,
    القسم: قسم_بيانات_دوارف,
    الموضع: طبيعي,
    العرض: طبيعي,
    الهدف: قسم_بيانات_دوارف,
    الإزاحة: طبيعي
): فراغ {
    دع الرقعة: رقعة_قسم_دوارف = {
        القسم: القسم,
        الموضع: الموضع,
        العرض: العرض,
        الهدف: الهدف,
        الإزاحة: الإزاحة
    };
    ألحق(*الرقع, الرقعة);
}

عام عرف ألحق_مرجع_قسم_دوارف(
    البايتات: &متغير متجه ط8,
    السياسة: &سياسة_دوارف,
    الرقع: &متغير متجه رقعة_قسم_دوارف,
    القسم: قسم_بيانات_دوارف,
    الهدف: قسم_بيانات_دوارف,
    الإزاحة: طبيعي
): فراغ {
    دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
    سجل_رقعة_قسم_دوارف(الرقع, القسم, الموضع, (*السياسة).حجم_الإزاحة, الهدف, الإزاحة);
    ألحق_إزاحة_دوارف(البايتات, السياسة, الإزاحة);
}

عام عرف سجل_رقعة_عنوان_دوارف(
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    القسم: قسم_عنوان_دوارف,
    الموضع: طبيعي,
    العرض: طبيعي,
    القاعدة: قاعدة_عنوان_دوارف,
    الإزاحة: طبيعي
): فراغ {
    دع المرجع: مرجع_عنوان_دوارف = { القاعدة: القاعدة, إزاحة_بايت: الإزاحة };
    دع الرقعة: رقعة_عنوان_دوارف = { القسم: القسم, الموضع: الموضع, العرض: العرض, المرجع: المرجع };
    ألحق(*الرقع, الرقعة);
}

عام عرف ألحق_مرجع_عنوان_دوارف(
    البايتات: &متغير متجه ط8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    القسم: قسم_عنوان_دوارف,
    العرض: طبيعي,
    القاعدة: قاعدة_عنوان_دوارف,
    الإزاحة: طبيعي
): فراغ {
    دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
    سجل_رقعة_عنوان_دوارف(الرقع, القسم, الموضع, العرض, القاعدة, الإزاحة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض) { ألحق_ط8_دوارف(البايتات, 0); ف := ف + 1; }
}

عام عرف ألحق_ليب128_دوارف(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع ح: متغير طبيعي = القيمة;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع الجزء: طبيعي = ح % 128;
        ح := ح / 128;
        لو (ح == 0) { ألحق_ط8_دوارف(البايتات, الجزء); مستمر := خطأ; }
        وإلا { ألحق_ط8_دوارف(البايتات, الجزء + 128); };
    }
}

عام عرف ألحق_سليب128_دوارف(البايتات: &متغير متجه ط8, القيمة: عدد): فراغ {
    دع ح: متغير عدد = القيمة;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع الجزء_الموقع: متغير عدد = ح % 128;
        لو (الجزء_الموقع < 0) { الجزء_الموقع := الجزء_الموقع + 128; };
        دع الجزء: طبيعي = الجزء_الموقع مثل طبيعي;
        ح := (ح - الجزء_الموقع) / 128;
        دع بت_الإشارة: منطقي = الجزء >= 64;
        دع انتهى_موجب: منطقي = ح == 0 && !بت_الإشارة;
        دع انتهى_سالب: منطقي = ح == -1 && بت_الإشارة;
        دع انتهى: منطقي = انتهى_موجب || انتهى_سالب;
        لو (انتهى) { ألحق_ط8_دوارف(البايتات, الجزء); مستمر := خطأ; }
        وإلا { ألحق_ط8_دوارف(البايتات, الجزء + 128); };
    }
}

عام عرف ألحق_نص_صفري_دوارف(البايتات: &متغير متجه ط8, النص: &نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق_ط8_دوارف(البايتات, (*النص)[ف] مثل طبيعي); ف := ف + 1; }
    ألحق_ط8_دوارف(البايتات, 0);
}

عام عرف ألحق_بايتات_دوارف(البايتات: &متغير متجه ط8, المصدر: &متجه ط8): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) { ألحق_ط8_دوارف(البايتات, (*المصدر)[ف] مثل طبيعي); ف := ف + 1; }
}

عام عرف ألحق_بايتات_صفرية_دوارف(البايتات: &متغير متجه ط8, المصدر: &متجه ط8): فراغ {
    ألحق_بايتات_دوارف(البايتات, المصدر);
    ألحق_ط8_دوارف(البايتات, 0);
}

عام عرف انسخ_بايتات_دوارف(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_دوارف(&متغير الناتج, المصدر);
    أرجع الناتج;
}
