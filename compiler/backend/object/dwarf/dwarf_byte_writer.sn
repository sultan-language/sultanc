استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_constants;

// Canonical byte/LEB writer for every DWARF section. No semantic or object-layout facts live here.
عام عرف ألحق_غ8_دوارف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق(*البايتات, (القيمة % 256) مثل غ8);
}

عام عرف ألحق_غ16_دوارف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق_غ8_دوارف(البايتات, القيمة);
    ألحق_غ8_دوارف(البايتات, القيمة / 256);
}

عام عرف ألحق_غ32_دوارف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    دع ح: متغير غير_موقع = القيمة;
    بينما (ف < 4) { ألحق_غ8_دوارف(البايتات, ح); ح := ح / 256; ف := ف + 1; }
}

عام عرف ألحق_غ64_دوارف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    دع ح: متغير غير_موقع = القيمة;
    بينما (ف < 8) { ألحق_غ8_دوارف(البايتات, ح); ح := ح / 256; ف := ف + 1; }
}

عام عرف اكتب_غ32_دوارف(البايتات: &متغير متجه غ8, الموضع: غير_موقع, القيمة: غير_موقع): فراغ {
    دع ح: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        دع الحالي: غير_موقع = الموضع + ف;
        (*البايتات)[الحالي] := (ح % 256) مثل غ8;
        ح := ح / 256;
        ف := ف + 1;
    }
}

عام عرف اكتب_غ64_دوارف(البايتات: &متغير متجه غ8, الموضع: غير_موقع, القيمة: غير_موقع): فراغ {
    دع ح: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        دع الحالي: غير_موقع = الموضع + ف;
        (*البايتات)[الحالي] := (ح % 256) مثل غ8;
        ح := ح / 256;
        ف := ف + 1;
    }
}

عام عرف ألحق_إزاحة_دوارف(البايتات: &متغير متجه غ8, السياسة: &سياسة_دوارف, القيمة: غير_موقع): فراغ {
    لو ((*السياسة).حجم_الإزاحة == 8) { ألحق_غ64_دوارف(البايتات, القيمة); }
    وإلا { ألحق_غ32_دوارف(البايتات, القيمة); };
}

عام عرف اكتب_إزاحة_دوارف(البايتات: &متغير متجه غ8, السياسة: &سياسة_دوارف, الموضع: غير_موقع, القيمة: غير_موقع): فراغ {
    لو ((*السياسة).حجم_الإزاحة == 8) { اكتب_غ64_دوارف(البايتات, الموضع, القيمة); }
    وإلا { اكتب_غ32_دوارف(البايتات, الموضع, القيمة); };
}

// Returns the position of the initial-length field. DWARF32 uses a 4-byte
// initial length; DWARF64 uses 0xffffffff followed by an 8-byte length.
عام عرف ابدأ_وحدة_دوارف(البايتات: &متغير متجه غ8, السياسة: &سياسة_دوارف): غير_موقع {
    دع الموضع: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو ((*السياسة).حجم_الإزاحة == 8) {
        ألحق_غ32_دوارف(البايتات, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.علامة_طول_دوارف64()));
        ألحق_غ64_دوارف(البايتات, 0);
    } وإلا {
        ألحق_غ32_دوارف(البايتات, 0);
    };
    أرجع الموضع;
}

عام عرف اختم_وحدة_دوارف(البايتات: &متغير متجه غ8, السياسة: &سياسة_دوارف, الموضع: غير_موقع): فراغ {
    دع النهاية: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو ((*السياسة).حجم_الإزاحة == 8) {
        اكتب_غ64_دوارف(البايتات, الموضع + 4, النهاية - الموضع - 12);
    } وإلا {
        اكتب_غ32_دوارف(البايتات, الموضع, النهاية - الموضع - 4);
    };
}

عام عرف سجل_رقعة_قسم_دوارف(
    الرقع: &متغير متجه رقعة_قسم_دوارف,
    القسم: قسم_بيانات_دوارف,
    الموضع: غير_موقع,
    العرض: غير_موقع,
    الهدف: قسم_بيانات_دوارف,
    الإزاحة: غير_موقع
): فراغ {
    دع الرقعة: رقعة_قسم_دوارف = {
        القسم: القسم,
        الموضع: الموضع,
        العرض: العرض,
        الهدف: الهدف,
        الإزاحة: الإزاحة
    };
    ألحق(*الرقع, الرقعة);
}

عام عرف ألحق_مرجع_قسم_دوارف(
    البايتات: &متغير متجه غ8,
    السياسة: &سياسة_دوارف,
    الرقع: &متغير متجه رقعة_قسم_دوارف,
    القسم: قسم_بيانات_دوارف,
    الهدف: قسم_بيانات_دوارف,
    الإزاحة: غير_موقع
): فراغ {
    دع الموضع: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    سجل_رقعة_قسم_دوارف(الرقع, القسم, الموضع, (*السياسة).حجم_الإزاحة, الهدف, الإزاحة);
    ألحق_إزاحة_دوارف(البايتات, السياسة, الإزاحة);
}

عام عرف سجل_رقعة_عنوان_دوارف(
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    القسم: قسم_عنوان_دوارف,
    الموضع: غير_موقع,
    العرض: غير_موقع,
    القاعدة: قاعدة_عنوان_دوارف,
    الإزاحة: غير_موقع
): فراغ {
    دع المرجع: مرجع_عنوان_دوارف = { القاعدة: القاعدة, إزاحة_بايت: الإزاحة };
    دع الرقعة: رقعة_عنوان_دوارف = { القسم: القسم, الموضع: الموضع, العرض: العرض, المرجع: المرجع };
    ألحق(*الرقع, الرقعة);
}

عام عرف ألحق_مرجع_عنوان_دوارف(
    البايتات: &متغير متجه غ8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    القسم: قسم_عنوان_دوارف,
    العرض: غير_موقع,
    القاعدة: قاعدة_عنوان_دوارف,
    الإزاحة: غير_موقع
): فراغ {
    دع الموضع: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    سجل_رقعة_عنوان_دوارف(الرقع, القسم, الموضع, العرض, القاعدة, الإزاحة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العرض) { ألحق_غ8_دوارف(البايتات, 0); ف := ف + 1; }
}

عام عرف ألحق_ليب128_دوارف(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ح: متغير غير_موقع = القيمة;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع الجزء: غير_موقع = ح % 128;
        ح := ح / 128;
        لو (ح == 0) { ألحق_غ8_دوارف(البايتات, الجزء); مستمر := خطأ; }
        وإلا { ألحق_غ8_دوارف(البايتات, الجزء + 128); };
    }
}

عام عرف ألحق_سليب128_دوارف(البايتات: &متغير متجه غ8, القيمة: عدد): فراغ {
    دع ح: متغير عدد = القيمة;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع الجزء_الموقع: متغير عدد = ح % 128;
        لو (الجزء_الموقع < 0) { الجزء_الموقع := الجزء_الموقع + 128; };
        دع الجزء: غير_موقع = الجزء_الموقع مثل غير_موقع;
        ح := (ح - الجزء_الموقع) / 128;
        دع بت_الإشارة: منطقي = الجزء >= 64;
        دع انتهى_موجب: منطقي = ح == 0 && !بت_الإشارة;
        دع انتهى_سالب: منطقي = ح == -1 && بت_الإشارة;
        دع انتهى: منطقي = انتهى_موجب || انتهى_سالب;
        لو (انتهى) { ألحق_غ8_دوارف(البايتات, الجزء); مستمر := خطأ; }
        وإلا { ألحق_غ8_دوارف(البايتات, الجزء + 128); };
    }
}

عام عرف ألحق_نص_صفري_دوارف(البايتات: &متغير متجه غ8, النص: &نص): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*النص) مثل غير_موقع)) { ألحق_غ8_دوارف(البايتات, (*النص)[ف] مثل غير_موقع); ف := ف + 1; }
    ألحق_غ8_دوارف(البايتات, 0);
}

عام عرف ألحق_بايتات_دوارف(البايتات: &متغير متجه غ8, المصدر: &متجه غ8): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المصدر) مثل غير_موقع)) { ألحق_غ8_دوارف(البايتات, (*المصدر)[ف] مثل غير_موقع); ف := ف + 1; }
}

عام عرف ألحق_بايتات_صفرية_دوارف(البايتات: &متغير متجه غ8, المصدر: &متجه غ8): فراغ {
    ألحق_بايتات_دوارف(البايتات, المصدر);
    ألحق_غ8_دوارف(البايتات, 0);
}

عام عرف انسخ_بايتات_دوارف(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    ألحق_بايتات_دوارف(&متغير الناتج, المصدر);
    أرجع الناتج;
}
