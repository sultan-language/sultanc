// DWARF orchestration only. Version behavior comes from dwarf_policy.sn;
// semantic debug facts and final object-address ownership remain outside here.
عام عرف ابن_حزمة_دوارف_من_سياقات_بخيارات(
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    المواضع: &متجه موضع_دالة_دوارف,
    مواضع_العوام: &متجه موضع_عام_دوارف,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الأصول_المشفرة: &متجه مدى_شفرة_آلة_بأصل,
    حجم_النص: غير_موقع,
    الخيارات: &خيارات_دوارف
): حزمة_دوارف {
    دع السياسة: سياسة_دوارف = ابن_سياسة_دوارف(الخيارات, حجم_عنوان_تصحيح_للهدف(الهدف));
    دع أوصاف_الدوال: متجه وصف_دالة_دوارف = أوصاف_دوال_دوارف_من_سياقات_تصحيح(التصحيح);
    دع أوصاف_الأنواع: متجه وصف_نوع_دوارف = أوصاف_أنواع_دوارف_من_السياق(الأنواع, &(*التصحيح).الدلالي, الهدف, سجل_التخطيط);

    دع معلومات: متجه غ8 = [];
    دع سطور: متجه غ8 = [];
    دع سلاسل_سطور: متغير متجه غ8 = [];
    دع سلاسل: متغير متجه غ8 = [];
    لو (السياسة.حديث) { ألحق(سلاسل_سطور, 0); ألحق(سلاسل, 0); };
    دع عناوين: متجه غ8 = [];
    دع مواقع: متجه غ8 = [];
    دع قوائم_مواقع: متجه غ8 = [];
    دع إطار: متجه غ8 = [];
    دع نطاقات_عناوين: متجه غ8 = [];
    دع قوائم_نطاقات: متجه غ8 = [];
    دع أسماء_عامة: متجه غ8 = [];
    دع فهرس_أسماء: متجه غ8 = [];
    دع الرقع: متجه رقعة_عنوان_دوارف = [];
    دع رقع_الأقسام: متجه رقعة_قسم_دوارف = [];
    دع الاختصارات: متجه غ8 = ابن_اختصارات_دوارف(&السياسة);
    دع البناء: متغير حزمة_دوارف = {
        الإصدار: السياسة.الإصدار, صيغة_الإزاحة: السياسة.صيغة_الإزاحة, حجم_العنوان: السياسة.حجم_العنوان,
        معلومات: معلومات, اختصارات: الاختصارات, سطور: سطور,
        سلاسل_سطور: سلاسل_سطور, سلاسل: سلاسل, عناوين: عناوين,
        مواقع: مواقع, قوائم_مواقع: قوائم_مواقع, إطار: إطار,
        نطاقات_عناوين: نطاقات_عناوين, قوائم_نطاقات: قوائم_نطاقات,
        أسماء_عامة: أسماء_عامة, فهرس_أسماء: فهرس_أسماء, رقع_العناوين: الرقع, رقع_الأقسام: رقع_الأقسام
    };
    دع جدول_السلاسل: متغير جدول_سلاسل_دوارف = جدول_سلاسل_دوارف_فارغ();
    دع جدول_سلاسل_السطور: متغير جدول_سلاسل_سطور_دوارف = جدول_سلاسل_سطور_دوارف_فارغ();
    دع جدول_العناوين: متغير جدول_عناوين_دوارف = جدول_عناوين_دوارف_فارغ();
    دع جدول_النطاقات: متغير جدول_قوائم_نطاقات_دوارف = جدول_قوائم_نطاقات_دوارف_فارغ();

    دع فهرس_الدوال: فهرس_دوال_دوارف = ابن_فهرس_دوال_دوارف(المواضع, &أوصاف_الدوال, الأصول_المشفرة);
    دع ناتج_المواقع: ناتج_مواقع_دوارف = ابن_مواقع_دوارف_من_آلة(
        المواضع, تصحيح_الآلة, الطول((*التصحيح).الدلالي.المتغيرات) مثل غير_موقع,
        &السياسة, &متغير جدول_العناوين, &متغير البناء.مواقع, &متغير البناء.قوائم_مواقع,
        &متغير البناء.رقع_العناوين
    );
    دع ناتج_المعلومات: ناتج_معلومات_دوارف = ابن_معلومات_دوارف(
        الخريطة, سجل_الأصول, المواضع, مواضع_العوام, التصحيح, &أوصاف_الدوال, &أوصاف_الأنواع,
        &ناتج_المواقع, تصحيح_الآلة, &فهرس_الدوال, حجم_النص, &السياسة,
        &متغير البناء.سلاسل, &متغير جدول_السلاسل, &متغير جدول_العناوين, &متغير جدول_النطاقات,
        &متغير البناء.معلومات, &متغير البناء.رقع_العناوين, &متغير البناء.رقع_الأقسام
    );
    ابن_سطور_دوارف_من_آلة(
        الخريطة, سجل_الأصول, المواضع, &(*التصحيح).الدلالي, تصحيح_الآلة,
        &السياسة, &متغير البناء.سلاسل_سطور, &متغير جدول_سلاسل_السطور, &متغير البناء.سطور, &متغير البناء.رقع_العناوين, &متغير البناء.رقع_الأقسام
    );
    لو ((*الخيارات).توليد_إطار) {
        ابن_إطار_دوارف_من_معلومات_إطار_النداء(المواضع, سياق_الفك, الهدف, &السياسة, &متغير البناء.إطار, &متغير البناء.رقع_العناوين, &متغير البناء.رقع_الأقسام);
    };
    ابن_نطاقات_عناوين_دوارف(حجم_النص, &السياسة, &متغير البناء.نطاقات_عناوين, &متغير البناء.رقع_العناوين, &متغير البناء.رقع_الأقسام);

    لو (السياسة.حديث) {
        البناء.قوائم_نطاقات := ابن_قوائم_نطاقات_دوارف(&السياسة, &جدول_النطاقات);
        البناء.عناوين := ابن_قسم_عناوين_دوارف(&السياسة, &جدول_العناوين, &متغير البناء.رقع_العناوين);
        لو ((*الخيارات).توليد_أسماء) { البناء.فهرس_أسماء := ابن_فهرس_أسماء_دوارف(&ناتج_المعلومات.فهرس_الأسماء, &السياسة, &متغير البناء.سلاسل, &متغير جدول_السلاسل, &متغير البناء.رقع_الأقسام); };
    } وإلا {
        لو ((*الخيارات).توليد_أسماء) {
            البناء.أسماء_عامة := ابن_أسماء_عامة_دوارف(الطول(البناء.معلومات) مثل غير_موقع, &ناتج_المعلومات.الأسماء_العامة, &السياسة, &متغير البناء.رقع_الأقسام);
        };
    };
    أرجع البناء;
}

عام عرف ابن_حزمة_دوارف_من_سياقات(
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    المواضع: &متجه موضع_دالة_دوارف,
    مواضع_العوام: &متجه موضع_عام_دوارف,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الأصول_المشفرة: &متجه مدى_شفرة_آلة_بأصل,
    حجم_النص: غير_موقع
): حزمة_دوارف {
    دع الخيارات: خيارات_دوارف = خيارات_دوارف_افتراضية();
    أرجع ابن_حزمة_دوارف_من_سياقات_بخيارات(
        الخريطة, سجل_الأصول, المواضع, مواضع_العوام, التصحيح, تصحيح_الآلة, سياق_الفك,
        الأنواع, الهدف, سجل_التخطيط, الأصول_المشفرة, حجم_النص, &الخيارات
    );
}
