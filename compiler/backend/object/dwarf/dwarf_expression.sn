استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_constants;

// Callers describe value-location semantics. This module alone selects the
// concrete DW_OP encoding (compact register opcodes versus extended forms).
عام نوع عملية_تعبير_دوارف =
    | سجل بنوع طبيعي
    | سجل_بإزاحة بنوع (طبيعي, عدد)
    | عنوان_مفهرس بنوع طبيعي
    | عنوان_رمزي بنوع (قاعدة_عنوان_دوارف, طبيعي)
    // A WebAssembly local: its value is the variable's value (false) or the
    // address of the variable's storage (true).
    | محلي_ويب_أسمبلي بنوع (طبيعي, منطقي)
;

عام عرف ألحق_عملية_تعبير_دوارف(
    ب: &متغير متجه ط8,
    العملية: &عملية_تعبير_دوارف,
    القسم: قسم_عنوان_دوارف,
    حجم_العنوان: طبيعي,
    الرقع: &متغير متجه رقعة_عنوان_دوارف
): فراغ {
    طابق *العملية مع
    | عملية_تعبير_دوارف.سجل(السجل) -> {
        إذا (السجل <= 31) {
            ألحق_ط8_دوارف(ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.سجل0()) + السجل);
        } وإلا {
            ألحق_ط8_دوارف(ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.سجل_ممتد()));
            ألحق_ليب128_دوارف(ب, السجل);
        };
    }
    | عملية_تعبير_دوارف.سجل_بإزاحة(السجل, الإزاحة) -> {
        إذا (السجل <= 31) {
            ألحق_ط8_دوارف(ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.قاعدة_سجل0()) + السجل);
        } وإلا {
            ألحق_ط8_دوارف(ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.قاعدة_سجل_ممتدة()));
            ألحق_ليب128_دوارف(ب, السجل);
        };
        ألحق_سليب128_دوارف(ب, الإزاحة);
    }
    | عملية_تعبير_دوارف.عنوان_مفهرس(الفهرس) -> {
        ألحق_ط8_دوارف(ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.عنوان_مفهرس()));
        ألحق_ليب128_دوارف(ب, الفهرس);
    }
    | عملية_تعبير_دوارف.عنوان_رمزي(القاعدة, الإزاحة) -> {
        ألحق_ط8_دوارف(ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.عنوان()));
        ألحق_مرجع_عنوان_دوارف(ب, الرقع, القسم, حجم_العنوان, القاعدة, الإزاحة);
    }
    | عملية_تعبير_دوارف.محلي_ويب_أسمبلي(المحلي, عنوان) -> {
        // DW_OP_WASM_location 0 (local) <index> pushes the local's value;
        // DW_OP_stack_value makes that the variable's value, otherwise it
        // is the variable's memory address (as LLVM describes wasm locals).
        ألحق_ط8_دوارف(ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.موقع_ويب_أسمبلي()));
        ألحق_ليب128_دوارف(ب, 0);
        ألحق_ليب128_دوارف(ب, المحلي);
        إذا (!عنوان) {
            ألحق_ط8_دوارف(ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.قيمة_مكدس()));
        };
    };
}

عام عرف ابن_تعبير_موقع_دوارف(الموقع: &موقع_قيمة_دوارف): اختياري متجه ط8 {
    دع ب: متغير متجه ط8 = [];
    دع رقع_فارغة: متغير متجه رقعة_عنوان_دوارف = [];
    دع العملية: عملية_تعبير_دوارف;
    طابق *الموقع مع
    | موقع_قيمة_دوارف.غير_متاح -> { أرجع اختياري.لا_شيء(); }
    | موقع_قيمة_دوارف.سجل(السجل) -> { العملية := عملية_تعبير_دوارف.سجل(السجل); }
    | موقع_قيمة_دوارف.مكدس(السجل, الإزاحة) -> { العملية := عملية_تعبير_دوارف.سجل_بإزاحة(السجل, الإزاحة مثل عدد); }
    | موقع_قيمة_دوارف.مكدس_غير_مباشر(السجل, الإزاحة) -> {
        // DW_OP_breg<n> offset; DW_OP_deref: the slot holds the address.
        دع القاعدة: عملية_تعبير_دوارف = عملية_تعبير_دوارف.سجل_بإزاحة(السجل, الإزاحة مثل عدد);
        ألحق_عملية_تعبير_دوارف(&متغير ب, &القاعدة, قسم_عنوان_دوارف.معلومات(), 0, &متغير رقع_فارغة);
        ألحق_ط8_دوارف(&متغير ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.اتبع_العنوان()));
        أرجع اختياري.موجود(ب);
    }
    | موقع_قيمة_دوارف.إطار(الإزاحة) -> {
        // DW_OP_fbreg offset.
        ألحق_ط8_دوارف(&متغير ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.قاعدة_الإطار()));
        ألحق_سليب128_دوارف(&متغير ب, الإزاحة);
        أرجع اختياري.موجود(ب);
    }
    | موقع_قيمة_دوارف.إطار_غير_مباشر(الإزاحة) -> {
        // DW_OP_fbreg offset; DW_OP_deref.
        ألحق_ط8_دوارف(&متغير ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.قاعدة_الإطار()));
        ألحق_سليب128_دوارف(&متغير ب, الإزاحة);
        ألحق_ط8_دوارف(&متغير ب, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.اتبع_العنوان()));
        أرجع اختياري.موجود(ب);
    }
    | موقع_قيمة_دوارف.محلي_ويب_أسمبلي(المحلي, عنوان) -> { العملية := عملية_تعبير_دوارف.محلي_ويب_أسمبلي(المحلي, عنوان); };
    ألحق_عملية_تعبير_دوارف(&متغير ب, &العملية, قسم_عنوان_دوارف.معلومات(), 0, &متغير رقع_فارغة);
    أرجع اختياري.موجود(ب);
}
