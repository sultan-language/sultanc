استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_strings;
استورد compiler.backend.object.dwarf.dwarf_types;
استورد compiler.backend.object.dwarf.dwarf_locations;
استورد compiler.backend.object.dwarf.dwarf_ranges;
استورد compiler.backend.object.dwarf.dwarf_names;
استورد compiler.backend.object.dwarf.dwarf_addresses;
استورد compiler.backend.object.dwarf.dwarf_expression;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.backend.object.dwarf.dwarf_unit;
