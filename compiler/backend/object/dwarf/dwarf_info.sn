استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_strings;
استورد compiler.backend.object.dwarf.dwarf_types;
استورد compiler.backend.object.dwarf.dwarf_locations;
استورد compiler.backend.object.dwarf.dwarf_ranges;
استورد compiler.backend.object.dwarf.dwarf_names;
استورد compiler.backend.object.dwarf.dwarf_addresses;
استورد compiler.backend.object.dwarf.dwarf_expression;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.backend.object.dwarf.dwarf_unit;
استورد compiler.backend.codegen.debug.model;
استورد compiler.source.source_map;
استورد compiler.source.provenance;
استورد compiler.msir.debug_contract;
استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;
استورد std.text.from_bytes;

// DIE emission consumes canonical source/type facts plus precomputed machine
// ranges. It owns no semantic analysis, register allocation, or target policy.
عام نوع ناتج_معلومات_دوارف = {
    الأسماء_العامة: متجه اسم_عام_دوارف,
    فهرس_الأسماء: متجه مدخل_فهرس_اسم_دوارف
};

عرف ألحق_إحداثي_تصريح_دوارف(
    ب: &متغير متجه ط8,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر,
    السياسة: &سياسة_دوارف
): منطقي {
    طابق أصل_مصدر_بالمعرف(سجل_الأصول, الأصل) مع
    | اختياري.لا_شيء -> { ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0); أرجع خطأ; }
    | اختياري.موجود(وصف_الأصل) -> {
        دع الملف: طبيعي = فهرس_ملف_دوارف(السياسة, وصف_الأصل.النطاق.البداية.المصدر);
        طابق إحداثي_من_الخريطة(الخريطة, وصف_الأصل.النطاق.البداية) مع
        | اختياري.لا_شيء -> { ألحق_ليب128_دوارف(ب, الملف); ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0); أرجع خطأ; }
        | اختياري.موجود(الإحداثي) -> {
            ألحق_ليب128_دوارف(ب, الملف);
            ألحق_ليب128_دوارف(ب, الإحداثي.السطر مثل طبيعي);
            دع العمود: طبيعي = الإحداثي.العمود مثل طبيعي;
            ألحق_ليب128_دوارف(ب, العمود + 1);
            أرجع صواب;
        };
    };
}

عرف ألحق_مرجع_موقع_دوارف(
    ب: &متغير متجه ط8,
    السياسة: &سياسة_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    القيمة: طبيعي
): فراغ {
    إذا ((*السياسة).حديث) { ألحق_ليب128_دوارف(ب, القيمة); }
    وإلا { ألحق_مرجع_قسم_دوارف(ب, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.مواقع(), القيمة); };
}

عرف ألحق_محليا_دوارف(
    ب: &متغير متجه ط8,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    مواقع_الأنواع: &متجه طبيعي,
    المحلي: &وصف_متغير_دوارف,
    المواقع: &ناتج_مواقع_دوارف,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه ط8, السلاسل: &متغير جدول_سلاسل_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    طابق موقع_متغير_دوارف(المواقع, (*المحلي).المتغير) مع
    | اختياري.لا_شيء -> {
        إذا ((*المحلي).معامل) { ألحق_ليب128_دوارف(ب, 4); } وإلا { ألحق_ليب128_دوارف(ب, 12); }; ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*المحلي).الاسم);
        ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*المحلي).الأصل, السياسة);
        ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*المحلي).هوية_النوع);
        إذا ((*المحلي).اصطناعي) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); };
    }
    | اختياري.موجود(الإزاحة) -> {
        إذا ((*المحلي).معامل) { ألحق_ليب128_دوارف(ب, 5); } وإلا { ألحق_ليب128_دوارف(ب, 13); }; ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*المحلي).الاسم);
        ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*المحلي).الأصل, السياسة);
        ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*المحلي).هوية_النوع);
        ألحق_مرجع_موقع_دوارف(ب, السياسة, رقع_الأقسام, الإزاحة);
        إذا ((*المحلي).اصطناعي) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); };
    };
}

نوع فهرس_نطاقات_دالة_دوارف = {
    الأطفال: متجه متجه طبيعي,
    المحليات: متجه متجه طبيعي,
    الجذور: متجه طبيعي
};

// Scope identities are global, but this index belongs to one function.
// Scope descriptors are ordered by their canonical ascending identity in
// dwarf_unit.sn. Binary search avoids allocating up to the global maximum
// scope identity separately for every function.
عرف ابحث_موضع_نطاق_دالة_دوارف(
    النطاقات: &متجه وصف_نطاق_دوارف,
    المعرف: طبيعي
): اختياري طبيعي {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*النطاقات) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + (النهاية - البداية) / 2;
        دع المعرف_الحالي: طبيعي = (*النطاقات)[الوسط].المعرف;
        إذا (المعرف_الحالي < المعرف) {
            البداية := الوسط + 1;
        } وإلا إذا (المعرف_الحالي > المعرف) {
            النهاية := الوسط;
        } وإلا {
            أرجع اختياري.موجود(الوسط);
        };
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_فهرس_نطاقات_دالة_دوارف(الدالة: &وصف_دالة_دوارف): فهرس_نطاقات_دالة_دوارف {
    دع العدد: طبيعي = الطول((*الدالة).النطاقات) مثل طبيعي;
    دع الأطفال: متغير متجه متجه طبيعي = [];
    دع المحليات: متغير متجه متجه طبيعي = [];
    دع الجذور: متغير متجه طبيعي = [];
    دع فهرس_النطاق: متغير طبيعي = 0;
    طالما (فهرس_النطاق < العدد) {
        دع فارغ_أطفال: متجه طبيعي = [];
        دع فارغ_محليات: متجه طبيعي = [];
        ألحق(الأطفال, فارغ_أطفال);
        ألحق(المحليات, فارغ_محليات);
        فهرس_النطاق := فهرس_النطاق + 1;
    }
    فهرس_النطاق := 0;
    طالما (فهرس_النطاق < العدد) {
        طابق (*الدالة).النطاقات[فهرس_النطاق].الأب مع
        | اختياري.موجود(معرف_الأب) -> {
            طابق ابحث_موضع_نطاق_دالة_دوارف(&(*الدالة).النطاقات, معرف_الأب) مع
            | اختياري.موجود(موضع_الأب) -> { ألحق(الأطفال[موضع_الأب], فهرس_النطاق); }
            | اختياري.لا_شيء -> { ألحق(الجذور, فهرس_النطاق); };
        }
        | اختياري.لا_شيء -> { ألحق(الجذور, فهرس_النطاق); };
        فهرس_النطاق := فهرس_النطاق + 1;
    }
    دع فهرس_المحلي: متغير طبيعي = 0;
    طالما (فهرس_المحلي < (الطول((*الدالة).المحليات) مثل طبيعي)) {
        دع معرف_النطاق: طبيعي = (*الدالة).المحليات[فهرس_المحلي].نطاق_الإحاطة;
        طابق ابحث_موضع_نطاق_دالة_دوارف(&(*الدالة).النطاقات, معرف_النطاق) مع
        | اختياري.موجود(موضع_النطاق) -> { ألحق(المحليات[موضع_النطاق], فهرس_المحلي); }
        | اختياري.لا_شيء -> { };
        فهرس_المحلي := فهرس_المحلي + 1;
    }
    دع الناتج: فهرس_نطاقات_دالة_دوارف = {
        الأطفال: الأطفال,
        المحليات: المحليات,
        الجذور: الجذور
    };
    أرجع الناتج;
}

عرف ألحق_عنوان_معلومات_دوارف(
    ب: &متغير متجه ط8,
    السياسة: &سياسة_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    الإزاحة: طبيعي
): فراغ {
    إذا ((*السياسة).حديث) { ألحق_ليب128_دوارف(ب, أدرج_عنوان_نص_دوارف(العناوين, الإزاحة)); }
    وإلا { ألحق_مرجع_عنوان_دوارف(ب, الرقع, قسم_عنوان_دوارف.معلومات(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), الإزاحة); };
}

// Sorts text ranges by start (bottom-up merge sort) and joins those that
// touch or overlap.
عرف رتب_وادمج_مديات_دوارف(المديات: &متجه مدى_نص_دوارف): متجه مدى_نص_دوارف {
    دع العدد: طبيعي = الطول(*المديات) مثل طبيعي;
    دع الحالية: متغير متجه مدى_نص_دوارف = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الحالية, (*المديات)[ف]); ف := ف + 1; }
    إذا (العدد > 1) {
        دع التالية: متغير متجه مدى_نص_دوارف = [];
        ف := 0;
        طالما (ف < العدد) { ألحق(التالية, (*المديات)[ف]); ف := ف + 1; }
        دع العرض: متغير طبيعي = 1;
        طالما (العرض < العدد) {
            دع الكتابة: متغير طبيعي = 0;
            دع البداية: متغير طبيعي = 0;
            طالما (البداية < العدد) {
                دع الوسط: متغير طبيعي = البداية + العرض;
                إذا (الوسط > العدد) { الوسط := العدد; };
                دع النهاية: متغير طبيعي = الوسط + العرض;
                إذا (النهاية > العدد) { النهاية := العدد; };
                دع ي: متغير طبيعي = البداية;
                دع م: متغير طبيعي = الوسط;
                طالما ((ي < الوسط) || (م < النهاية)) {
                    إذا ((م >= النهاية) || ((ي < الوسط) && (الحالية[ي].إزاحة_بايت <= الحالية[م].إزاحة_بايت))) {
                        التالية[الكتابة] := الحالية[ي]; ي := ي + 1;
                    } وإلا {
                        التالية[الكتابة] := الحالية[م]; م := م + 1;
                    };
                    الكتابة := الكتابة + 1;
                }
                البداية := النهاية;
            }
            دع التبادل: متجه مدى_نص_دوارف = الحالية;
            الحالية := التالية;
            التالية := التبادل;
            العرض := العرض * 2;
        }
    };
    دع الناتج: متغير متجه مدى_نص_دوارف = [];
    ف := 0;
    طالما (ف < العدد) {
        دع المدى: مدى_نص_دوارف = الحالية[ف];
        دع ن: طبيعي = الطول(الناتج) مثل طبيعي;
        إذا (المدى.حجم_بايت > 0) {
            إذا ((ن > 0) && (المدى.إزاحة_بايت <= الناتج[ن - 1].إزاحة_بايت + الناتج[ن - 1].حجم_بايت)) {
                دع نهاية_المدى: طبيعي = المدى.إزاحة_بايت + المدى.حجم_بايت;
                إذا (نهاية_المدى > الناتج[ن - 1].إزاحة_بايت + الناتج[ن - 1].حجم_بايت) {
                    الناتج[ن - 1].حجم_بايت := نهاية_المدى - الناتج[ن - 1].إزاحة_بايت;
                };
            } وإلا {
                ألحق(الناتج, المدى);
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// A lexical scope covers its own instructions and those of every scope nested
// in it: a block whose statements are all inside nested blocks (a function
// body, a loop body holding one `if`) has no instruction of its own.
عرف اجمع_مديات_نطاق_شجري_دوارف(
    آلة: &سياق_تصحيح_آلة,
    موضع_الدالة: &موضع_دالة_دوارف,
    الدالة: &وصف_دالة_دوارف,
    موضع_النطاق: طبيعي,
    الفهرس: &فهرس_نطاقات_دالة_دوارف,
    الناتج: &متغير متجه مدى_نص_دوارف
): فراغ {
    إذا (موضع_النطاق >= (الطول((*الدالة).النطاقات) مثل طبيعي)) { أرجع; };
    دع معرف_النطاق: معرف_نطاق_تصحيح = معرف_نطاق_تصحيح_من((*الدالة).النطاقات[موضع_النطاق].المعرف);
    دع الخاصة: متجه مدى_نص_دوارف = مديات_نطاق_دوارف_من_آلة(آلة, (*الدالة).الدالة, معرف_النطاق, موضع_الدالة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الخاصة) مثل طبيعي)) { ألحق(*الناتج, الخاصة[ف]); ف := ف + 1; }
    دع ط: متغير طبيعي = 0;
    طالما (ط < (الطول((*الفهرس).الأطفال[موضع_النطاق]) مثل طبيعي)) {
        اجمع_مديات_نطاق_شجري_دوارف(آلة, موضع_الدالة, الدالة, (*الفهرس).الأطفال[موضع_النطاق][ط], الفهرس, الناتج);
        ط := ط + 1;
    }
}

// Emits one scope. A root scope (the function's own, which has no parent) is
// the subprogram itself: its locals and nested scopes go directly in the
// subprogram DIE, as a C compiler emits a function body's.
عرف ألحق_نطاق_دوارف_تكراريا(
    ب: &متغير متجه ط8,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    موضع_الدالة: &موضع_دالة_دوارف,
    الدالة: &وصف_دالة_دوارف,
    موضع_النطاق: طبيعي,
    الفهرس: &فهرس_نطاقات_دالة_دوارف,
    مواقع_الأنواع: &متجه طبيعي,
    المواقع: &ناتج_مواقع_دوارف,
    آلة: &سياق_تصحيح_آلة,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه ط8, السلاسل: &متغير جدول_سلاسل_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف,
    قوائم_النطاقات: &متغير جدول_قوائم_نطاقات_دوارف,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    جذر: منطقي,
    الدلالي: &سياق_تصحيح,
    رقع_الأصول: &متغير متجه طبيعي
): فراغ {
    إذا (موضع_النطاق >= (الطول((*الدالة).النطاقات) مثل طبيعي)) { أرجع; };
    دع المجمعة: متغير متجه مدى_نص_دوارف = [];
    اجمع_مديات_نطاق_شجري_دوارف(آلة, موضع_الدالة, الدالة, موضع_النطاق, الفهرس, &متغير المجمعة);
    دع المديات: متجه مدى_نص_دوارف = رتب_وادمج_مديات_دوارف(&المجمعة);
    إذا ((الطول(المديات) مثل طبيعي) == 0) { أرجع; };
    دع المضمنة: اختياري طبيعي = (*الدالة).النطاقات[موضع_النطاق].المضمنة;
    // An inlined call's scope is never folded into the subprogram.
    دع مطوي: متغير منطقي = جذر;
    طابق المضمنة مع | اختياري.موجود(_) -> { مطوي := خطأ; } | اختياري.لا_شيء -> { };
    إذا (!مطوي) {
      طابق المضمنة مع
      | اختياري.موجود(معرف_المضمنة) -> {
        // DW_TAG_inlined_subroutine: the inlined function's subprogram (its
        // reference patched once every subprogram is placed), the code
        // ranges and the call's source position.
        إذا ((*السياسة).حديث && (الطول(المديات) مثل طبيعي) > 1) { ألحق_ليب128_دوارف(ب, 32); } وإلا { ألحق_ليب128_دوارف(ب, 31); };
        ألحق(*رقع_الأصول, الطول(*ب) مثل طبيعي);
        ألحق(*رقع_الأصول, معرف_المضمنة);
        ألحق_إزاحة_دوارف(ب, السياسة, 0);
        إذا ((*السياسة).حديث && (الطول(المديات) مثل طبيعي) > 1) {
            ألحق_ليب128_دوارف(ب, أدرج_قائمة_نطاقات_دوارف(قوائم_النطاقات, العناوين, &المديات));
        } وإلا {
            دع الأول_م: طبيعي = المديات[0].إزاحة_بايت;
            دع الأخير_م: طبيعي = (الطول(المديات) مثل طبيعي) - 1;
            دع النهاية_م: طبيعي = المديات[الأخير_م].إزاحة_بايت + المديات[الأخير_م].حجم_بايت;
            ألحق_عنوان_معلومات_دوارف(ب, السياسة, العناوين, الرقع, الأول_م); ألحق_ط64_دوارف(ب, النهاية_م - الأول_م);
        };
        دع أصل_الاستدعاء: متغير معرف_أصل_مصدر = { القيمة: 0 };
        دع له_استدعاء: متغير منطقي = خطأ;
        طابق (*الدالة).النطاقات[موضع_النطاق].موقع_الاستدعاء مع
        | اختياري.موجود(معرف_الموقع) -> {
            إذا (معرف_الموقع < (الطول((*الدلالي).المواقع) مثل طبيعي)) {
                أصل_الاستدعاء := (*الدلالي).المواقع[معرف_الموقع].الأصل; له_استدعاء := صواب;
            };
        }
        | اختياري.لا_شيء -> { };
        إذا (له_استدعاء) {
            دع وجد: منطقي = ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, أصل_الاستدعاء, السياسة);
        } وإلا {
            ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0);
        };
      }
      | اختياري.لا_شيء -> {
        إذا ((*السياسة).حديث && (الطول(المديات) مثل طبيعي) > 1) {
            ألحق_ليب128_دوارف(ب, 30); ألحق_ليب128_دوارف(ب, أدرج_قائمة_نطاقات_دوارف(قوائم_النطاقات, العناوين, &المديات));
        } وإلا {
            دع الأول: طبيعي = المديات[0].إزاحة_بايت;
            دع الأخير: طبيعي = (الطول(المديات) مثل طبيعي) - 1;
            دع النهاية: طبيعي = المديات[الأخير].إزاحة_بايت + المديات[الأخير].حجم_بايت;
            ألحق_ليب128_دوارف(ب, 11); ألحق_عنوان_معلومات_دوارف(ب, السياسة, العناوين, الرقع, الأول); ألحق_ط64_دوارف(ب, النهاية - الأول);
        };
      };
    };
    دع ل: متغير طبيعي = 0;
    طالما (ل < (الطول((*الفهرس).المحليات[موضع_النطاق]) مثل طبيعي)) {
        دع موضع_المحلي: طبيعي = (*الفهرس).المحليات[موضع_النطاق][ل];
        ألحق_محليا_دوارف(ب, الخريطة, سجل_الأصول, مواقع_الأنواع, &(*الدالة).المحليات[موضع_المحلي], المواقع, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام); ل := ل + 1;
    }
    دع ط: متغير طبيعي = 0;
    طالما (ط < (الطول((*الفهرس).الأطفال[موضع_النطاق]) مثل طبيعي)) {
        ألحق_نطاق_دوارف_تكراريا(ب, الخريطة, سجل_الأصول, موضع_الدالة, الدالة, (*الفهرس).الأطفال[موضع_النطاق][ط], الفهرس, مواقع_الأنواع, المواقع, آلة, السياسة, بيانات_السلاسل, السلاسل, العناوين, قوائم_النطاقات, الرقع, رقع_الأقسام, خطأ, الدلالي, رقع_الأصول); ط := ط + 1;
    }
    إذا (!مطوي) { ألحق_ط8_دوارف(ب, 0); };
}

عرف ابن_فهرس_مواضع_عوام_دوارف(المواضع: &متجه موضع_عام_دوارف, التصحيح: &بيانات_تصحيح_مسير): متجه اختياري طبيعي {
    دع أعلى_عام: متغير طبيعي = 0; دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) { إذا (((*المواضع)[ف].العام.القيمة مثل طبيعي) > أعلى_عام) { أعلى_عام := (*المواضع)[ف].العام.القيمة; }; ف := ف + 1; }
    دع موضع_مسير: متغير متجه اختياري طبيعي = []; ف := 0; طالما (ف <= أعلى_عام) { ألحق(موضع_مسير, اختياري.لا_شيء()); ف := ف + 1; }
    ف := 0; طالما (ف < (الطول(*المواضع) مثل طبيعي)) { دع المعرف: طبيعي = (*المواضع)[ف].العام.القيمة; طالما ((الطول(موضع_مسير) مثل طبيعي) <= المعرف) { ألحق(موضع_مسير, اختياري.لا_شيء()); } موضع_مسير[المعرف] := اختياري.موجود(ف); ف := ف + 1; }
    دع الناتج: متغير متجه اختياري طبيعي = []; ف := 0; طالما (ف < (الطول((*التصحيح).الدلالي.العوام) مثل طبيعي)) { ألحق(الناتج, اختياري.لا_شيء()); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*التصحيح).العقد.العوام) مثل طبيعي)) {
        طابق (*التصحيح).العقد.العوام[ف] مع
        | اختياري.موجود(معرف_التصحيح) -> { إذا (معرف_التصحيح.القيمة < (الطول(الناتج) مثل طبيعي) && ف < (الطول(موضع_مسير) مثل طبيعي)) { الناتج[معرف_التصحيح.القيمة] := موضع_مسير[ف]; }; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أضف_مدخل_فهرس_دوارف(الفهرس: &متغير متجه مدخل_فهرس_اسم_دوارف, الإزاحة: طبيعي, الاسم: &متجه ط8, النوع: نوع_مدخل_فهرس_اسم_دوارف): فراغ {
    إذا ((الطول(*الاسم) مثل طبيعي) == 0) { أرجع; };
    دع نسخة_الاسم: متجه ط8 = انسخ_بايتات_دوارف(الاسم);
    دع المدخل: مدخل_فهرس_اسم_دوارف = { إزاحة_معلومة: الإزاحة, الاسم: نسخة_الاسم, النوع: النوع };
    ألحق(*الفهرس, المدخل);
}

عرف نوع_فهرس_وصف_نوع_دوارف(الوصف: &وصف_نوع_دوارف): نوع_مدخل_فهرس_اسم_دوارف {
    طابق (*الوصف).الصنف مع
    | صنف_نوع_دوارف.أساسي_موقع -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.أساسي_طبيعي -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.أساسي_منطقي -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.أساسي_عشري -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.أساسي_محرف -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.مؤشر(_) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_مؤشر(); }
    | صنف_نوع_دوارف.صندوق(_) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_مؤشر(); }
    | صنف_نوع_دوارف.مرجع(_) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_مرجع(); }
    | صنف_نوع_دوارف.اسم_مستعار(_) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.اسم_مستعار(); }
    | صنف_نوع_دوارف.دالة(_, _) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_دالة(); }
    | صنف_نوع_دوارف.مركب(_, _, _) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_بنية(); }
    | صنف_نوع_دوارف.غير_محدد -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_غير_محدد(); }
    | صنف_نوع_دوارف.تعداد_وسم(_, _) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_تعداد(); };
}

عرف ألحق_وحدات_دوارف(
    ب: &متغير متجه ط8, السياق: &سياق_تصحيح, السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه ط8, السلاسل: &متغير جدول_سلاسل_دوارف, رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    الفهرس: &متغير متجه مدخل_فهرس_اسم_دوارف
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الوحدات) مثل طبيعي)) {
        دع الوحدة: &وحدة_تصحيح = &(*السياق).الوحدات[ف]; دع الإزاحة: طبيعي = الطول(*ب) مثل طبيعي;
        ألحق_ليب128_دوارف(ب, 23); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*الوحدة).الاسم); ألحق_ليب128_دوارف(ب, فهرس_ملف_دوارف(السياسة, (*الوحدة).معرف_المصدر)); إذا ((*الوحدة).اصطناعي) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); };
        إذا ((*السياسة).حديث) { أضف_مدخل_فهرس_دوارف(الفهرس, الإزاحة, &(*الوحدة).الاسم, نوع_مدخل_فهرس_اسم_دوارف.وحدة_تصريح()); };
        ف := ف + 1;
    }
}

عرف ألحق_عاما_دوارف(
    ب: &متغير متجه ط8, الخريطة: &متغير خريطة_مصادر, سجل_الأصول: &سجل_أصول_مصدر,
    مواقع_الأنواع: &متجه طبيعي, العام: &عام_تصحيح, مواضع_العوام: &متجه موضع_عام_دوارف, موضع_البيانات: اختياري طبيعي,
    السياسة: &سياسة_دوارف, بيانات_السلاسل: &متغير متجه ط8, السلاسل: &متغير جدول_سلاسل_دوارف, رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف, الرقع: &متغير متجه رقعة_عنوان_دوارف,
    الأسماء_العامة: &متغير متجه اسم_عام_دوارف, الفهرس: &متغير متجه مدخل_فهرس_اسم_دوارف
): فراغ {
    دع له_موقع: متغير منطقي = خطأ; دع الإزاحة: متغير طبيعي = 0; دع اسم_الربط_الفعلي: متغير متجه ط8 = انسخ_بايتات_دوارف(&(*العام).اسم_الربط);
    طابق موضع_البيانات مع | اختياري.موجود(موضع_الفهرس) -> { إذا (موضع_الفهرس < (الطول(*مواضع_العوام) مثل طبيعي)) { دع الموضع: &موضع_عام_دوارف = &(*مواضع_العوام)[موضع_الفهرس]; له_موقع := !(*العام).إعلان_فقط; الإزاحة := (*الموضع).إزاحة_بايت; اسم_الربط_الفعلي := انسخ_بايتات_دوارف(&(*الموضع).اسم_الربط); }; } | اختياري.لا_شيء -> { };
    دع الاختصار: متغير طبيعي = 25; إذا (له_موقع) { الاختصار := 24; };
    دع إزاحة_المعلومة: طبيعي = الطول(*ب) مثل طبيعي;
    ألحق_ليب128_دوارف(ب, الاختصار); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*العام).الاسم); إذا (الاختصار == 25) { ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &اسم_الربط_الفعلي); };
    ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*العام).الأصل, السياسة); ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*العام).النوع.القيمة);
    إذا ((*العام).علني) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); }; إذا ((*العام).إعلان_فقط) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); }; إذا ((*العام).اصطناعي) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); };
    إذا (له_موقع) {
        إذا ((*السياسة).حديث) {
            دع تعبير: متغير متجه ط8 = [];
            دع عملية: عملية_تعبير_دوارف = عملية_تعبير_دوارف.عنوان_مفهرس(أدرج_عنوان_بيانات_دوارف(العناوين, الإزاحة));
            ألحق_عملية_تعبير_دوارف(&متغير تعبير, &عملية, قسم_عنوان_دوارف.معلومات(), (*السياسة).حجم_العنوان, الرقع);
            ألحق_ليب128_دوارف(ب, الطول(تعبير) مثل طبيعي); ألحق_بايتات_دوارف(ب, &تعبير);
        } وإلا {
            ألحق_ليب128_دوارف(ب, 1 + (*السياسة).حجم_العنوان);
            دع عملية: عملية_تعبير_دوارف = عملية_تعبير_دوارف.عنوان_رمزي(قاعدة_عنوان_دوارف.بيانات(), الإزاحة);
            ألحق_عملية_تعبير_دوارف(ب, &عملية, قسم_عنوان_دوارف.معلومات(), (*السياسة).حجم_العنوان, الرقع);
        };
    };
    إذا ((*السياسة).حديث) {
        أضف_مدخل_فهرس_دوارف(الفهرس, إزاحة_المعلومة, &(*العام).الاسم, نوع_مدخل_فهرس_اسم_دوارف.متغير());
    } وإلا {
        دع الاسم: متجه ط8 = انسخ_بايتات_دوارف(&(*العام).الاسم);
        دع المدخل: اسم_عام_دوارف = { إزاحة_معلومة: إزاحة_المعلومة, الاسم: الاسم };
        ألحق(*الأسماء_العامة, المدخل);
    };
}

عرف ألحق_ثابتا_دوارف(
    ب: &متغير متجه ط8, الخريطة: &متغير خريطة_مصادر, سجل_الأصول: &سجل_أصول_مصدر, مواقع_الأنواع: &متجه طبيعي,
    الثابت: &ثابت_تصحيح, السياسة: &سياسة_دوارف, بيانات_السلاسل: &متغير متجه ط8, السلاسل: &متغير جدول_سلاسل_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف, الفهرس: &متغير متجه مدخل_فهرس_اسم_دوارف
): فراغ {
    طابق (*الثابت).القيمة مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(القيمة) -> {
        دع الإزاحة: طبيعي = الطول(*ب) مثل طبيعي; ألحق_ليب128_دوارف(ب, 26); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*الثابت).الاسم);
        ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*الثابت).الأصل, السياسة); ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*الثابت).النوع.القيمة);
        إذا ((*الثابت).علني) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); }; إذا ((*الثابت).اصطناعي) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); };
        طابق القيمة مع | قيمة_ثابت_تصحيح.منطق(ق) -> { إذا (ق) { ألحق_ط64_دوارف(ب, 1); } وإلا { ألحق_ط64_دوارف(ب, 0); }; } | قيمة_ثابت_تصحيح.صحيح_موقع(ق) -> { ألحق_ط64_دوارف(ب, ق مثل طبيعي); } | قيمة_ثابت_تصحيح.صحيح_طبيعي(ق) -> { ألحق_ط64_دوارف(ب, ق); };
        إذا ((*السياسة).حديث) { أضف_مدخل_فهرس_دوارف(الفهرس, الإزاحة, &(*الثابت).الاسم, نوع_مدخل_فهرس_اسم_دوارف.ثابت()); };
    };
}

عرف ألحق_معاملات_دالة_دوارف(
    ب: &متغير متجه ط8, الخريطة: &متغير خريطة_مصادر, سجل_الأصول: &سجل_أصول_مصدر, الدالة: &وصف_دالة_دوارف,
    مواقع_الأنواع: &متجه طبيعي, المواقع: &ناتج_مواقع_دوارف, مع_مواقع: منطقي, السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه ط8, السلاسل: &متغير جدول_سلاسل_دوارف, رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        دع المعامل: &وصف_معامل_دوارف = &(*الدالة).المعاملات[ع]; دع إزاحة_الموقع: متغير اختياري طبيعي = اختياري.لا_شيء(); إذا (مع_مواقع) { إزاحة_الموقع := موقع_متغير_دوارف(المواقع, (*المعامل).المتغير); };
        طابق إزاحة_الموقع مع
        | اختياري.لا_شيء -> { ألحق_ليب128_دوارف(ب, 4); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*المعامل).الاسم); ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*المعامل).الأصل, السياسة); ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*المعامل).هوية_النوع); إذا ((*المعامل).اصطناعي) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); }; }
        | اختياري.موجود(الإزاحة) -> { ألحق_ليب128_دوارف(ب, 5); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*المعامل).الاسم); ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*المعامل).الأصل, السياسة); ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*المعامل).هوية_النوع); ألحق_مرجع_موقع_دوارف(ب, السياسة, رقع_الأقسام, الإزاحة); إذا ((*المعامل).اصطناعي) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); }; };
        ع := ع + 1;
    }
}

عام عرف ابن_معلومات_دوارف(
    الخريطة: &متغير خريطة_مصادر, سجل_الأصول: &سجل_أصول_مصدر, المواضع: &متجه موضع_دالة_دوارف, مواضع_العوام: &متجه موضع_عام_دوارف,
    التصحيح: &بيانات_تصحيح_مسير, الأوصاف: &متجه وصف_دالة_دوارف, الأنواع: &متجه وصف_نوع_دوارف, المواقع: &ناتج_مواقع_دوارف,
    آلة: &سياق_تصحيح_آلة, فهرس_الدوال: &فهرس_دوال_دوارف, حجم_النص: طبيعي, السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه ط8, السلاسل: &متغير جدول_سلاسل_دوارف, العناوين: &متغير جدول_عناوين_دوارف, قوائم_النطاقات: &متغير جدول_قوائم_نطاقات_دوارف,
    البيانات: &متغير متجه ط8, الرقع: &متغير متجه رقعة_عنوان_دوارف, رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): ناتج_معلومات_دوارف {
    دع الأسماء_العامة: متغير متجه اسم_عام_دوارف = []; دع فهرس_الأسماء: متغير متجه مدخل_فهرس_اسم_دوارف = [];
    دع بداية_الوحدة: طبيعي = ابدأ_وحدة_دوارف(البيانات, السياسة);
    ألحق_ط16_دوارف(البيانات, رمز_إصدار_دوارف((*السياسة).الإصدار));
    إذا ((*السياسة).حديث) {
        ألحق_ط8_دوارف(البيانات, رمز_نوع_وحدة_دوارف(نوع_وحدة_دوارف.ترجمة())); ألحق_ط8_دوارف(البيانات, (*السياسة).حجم_العنوان);
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.اختصارات(), 0);
    } وإلا {
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.اختصارات(), 0);
        ألحق_ط8_دوارف(البيانات, (*السياسة).حجم_العنوان);
    };
    ألحق_ليب128_دوارف(البيانات, 1);
    دع المنتج: متجه ط8 = بايتات_من_نص(«SultanC»); ألحق_اسم_دوارف(البيانات, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &المنتج);
    ألحق_ط16_دوارف(البيانات, رمز_لغة_دوارف(لغة_دوارف.سلطان())); دع اسم_الوحدة: نص = اسم_وحدة_دوارف(الخريطة); ألحق_اسم_نصي_دوارف(البيانات, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &اسم_الوحدة);
    ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.سطور(), 0);
    إذا ((*السياسة).حديث) {
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.عناوين(), قاعدة_جدول_عناوين_دوارف(السياسة));
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.قوائم_مواقع(), قاعدة_جدول_قوائم_دوارف(السياسة));
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.قوائم_نطاقات(), قاعدة_جدول_قوائم_دوارف(السياسة));
    } وإلا {
        ألحق_مرجع_عنوان_دوارف(البيانات, الرقع, قسم_عنوان_دوارف.معلومات(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), 0); ألحق_ط64_دوارف(البيانات, حجم_النص);
    };

    دع مواضع_الأنواع: متغير متجه طبيعي = []; دع رقع_الأنواع: متغير متجه رقعة_نوع_دوارف = [];

    ابن_أنواع_معلومات_دوارف(البيانات, الأنواع, الخريطة, سجل_الأصول, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &متغير مواضع_الأنواع, &متغير رقع_الأنواع);

    طبق_رقع_أنواع_دوارف(البيانات, السياسة, &مواضع_الأنواع, &رقع_الأنواع);
    دع ت: متغير طبيعي = 0;
    إذا ((*السياسة).حديث) {
        طالما (ت < (الطول(*الأنواع) مثل طبيعي)) {
            دع وصف_النوع: &وصف_نوع_دوارف = &(*الأنواع)[ت];
            دع هوية_النوع: طبيعي = (*وصف_النوع).الهوية;
            إذا (هوية_النوع < (الطول(مواضع_الأنواع) مثل طبيعي)) {
                دع موضع_النوع: طبيعي = مواضع_الأنواع[هوية_النوع];
                دع نوع_الفهرس: نوع_مدخل_فهرس_اسم_دوارف = نوع_فهرس_وصف_نوع_دوارف(وصف_النوع);
                أضف_مدخل_فهرس_دوارف(&متغير فهرس_الأسماء, موضع_النوع, &(*وصف_النوع).الاسم, نوع_الفهرس);
            };
            ت := ت + 1;
        }
    };

    ألحق_وحدات_دوارف(البيانات, &(*التصحيح).الدلالي, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &متغير فهرس_الأسماء);

    دع فهرس_عوام: متجه اختياري طبيعي = ابن_فهرس_مواضع_عوام_دوارف(مواضع_العوام, التصحيح);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التصحيح).الدلالي.العوام) مثل طبيعي)) { دع الموضع: متغير اختياري طبيعي = اختياري.لا_شيء(); إذا (ف < (الطول(فهرس_عوام) مثل طبيعي)) { الموضع := فهرس_عوام[ف]; }; ألحق_عاما_دوارف(البيانات, الخريطة, سجل_الأصول, &مواضع_الأنواع, &(*التصحيح).الدلالي.العوام[ف], مواضع_العوام, الموضع, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, العناوين, الرقع, &متغير الأسماء_العامة, &متغير فهرس_الأسماء); ف := ف + 1; }

    ف := 0;
    طالما (ف < (الطول((*التصحيح).الدلالي.الثوابت) مثل طبيعي)) { إذا (!(*التصحيح).الدلالي.الثوابت[ف].اصطناعي) { ألحق_ثابتا_دوارف(البيانات, الخريطة, سجل_الأصول, &مواضع_الأنواع, &(*التصحيح).الدلالي.الثوابت[ف], السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &متغير فهرس_الأسماء); }; ف := ف + 1; }

    // Subprogram DIE offset of each debug function (0: none yet), and the
    // abstract_origin references of inlined calls (position, function).
    دع مواضع_دوال_التصحيح: متغير متجه طبيعي = [];
    دع م_د: متغير طبيعي = 0;
    طالما (م_د < (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) { ألحق(مواضع_دوال_التصحيح, 0); م_د := م_د + 1; }
    دع رقع_الأصول: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(*الأوصاف) مثل طبيعي)) {
        دع الدالة: &وصف_دالة_دوارف = &(*الأوصاف)[ف];
        طابق أصل_مصدر_بالمعرف(سجل_الأصول, (*الدالة).الأصل) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(_) -> {
            دع فهرس_الموضع: اختياري طبيعي = فهرس_موضع_دالة_دوارف(فهرس_الدوال, (*الدالة).الدالة);
            دع له_تعريف_آلة: متغير منطقي = خطأ;
            طابق فهرس_الموضع مع | اختياري.موجود(_) -> { إذا (!(*الدالة).إعلان_فقط) { له_تعريف_آلة := صواب; }; } | اختياري.لا_شيء -> { };
            إذا (له_تعريف_آلة || (*الدالة).إعلان_فقط) {
                دع الاختصار: متغير طبيعي = 2; إذا (!له_تعريف_آلة) { الاختصار := 28; }; طابق (*الدالة).نوع_الناتج مع | اختياري.موجود(_) -> { إذا (له_تعريف_آلة) { الاختصار := 3; } وإلا { الاختصار := 29; }; } | اختياري.لا_شيء -> { };
                دع إزاحة_المعلومة: طبيعي = الطول(*البيانات) مثل طبيعي;
                إذا ((*الدالة).معرف_التصحيح < (الطول(مواضع_دوال_التصحيح) مثل طبيعي) && مواضع_دوال_التصحيح[(*الدالة).معرف_التصحيح] == 0) {
                    مواضع_دوال_التصحيح[(*الدالة).معرف_التصحيح] := إزاحة_المعلومة;
                };
                ألحق_ليب128_دوارف(البيانات, الاختصار); ألحق_اسم_دوارف(البيانات, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*الدالة).الاسم);
                إذا (!له_تعريف_آلة) { ألحق_اسم_دوارف(البيانات, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*الدالة).اسم_الربط); };
                ألحق_إحداثي_تصريح_دوارف(البيانات, الخريطة, سجل_الأصول, (*الدالة).الأصل, السياسة);
                طابق (*الدالة).نوع_الناتج مع | اختياري.موجود(نوع_الناتج) -> { ألحق_مرجع_نوع_دوارف(البيانات, السياسة, &مواضع_الأنواع, نوع_الناتج); } | اختياري.لا_شيء -> { };
                إذا (له_تعريف_آلة) {
                    طابق فهرس_الموضع مع
                    | اختياري.موجود(موضع_الفهرس) -> { دع موضع_الدالة: &موضع_دالة_دوارف = &(*المواضع)[موضع_الفهرس]; ألحق_عنوان_معلومات_دوارف(البيانات, السياسة, العناوين, الرقع, (*موضع_الدالة).إزاحة_بايت); ألحق_ط64_دوارف(البيانات, (*موضع_الدالة).حجم_بايت); ألحق_ليب128_دوارف(البيانات, 1); ألحق_ط8_دوارف(البيانات, رمز_ترميز_عملية_تعبير_دوارف(ترميز_عملية_تعبير_دوارف.عنوان_إطار_النداء())); }
                    | اختياري.لا_شيء -> { };
                };
                إذا ((*الدالة).علني) { ألحق_ط8_دوارف(البيانات, 1); } وإلا { ألحق_ط8_دوارف(البيانات, 0); }; إذا ((*الدالة).إعلان_فقط) { ألحق_ط8_دوارف(البيانات, 1); } وإلا { ألحق_ط8_دوارف(البيانات, 0); }; إذا ((*الدالة).اصطناعي) { ألحق_ط8_دوارف(البيانات, 1); } وإلا { ألحق_ط8_دوارف(البيانات, 0); };
                إذا ((*السياسة).حديث) {
                    أضف_مدخل_فهرس_دوارف(&متغير فهرس_الأسماء, إزاحة_المعلومة, &(*الدالة).الاسم, نوع_مدخل_فهرس_اسم_دوارف.دالة());
                } وإلا {
                    دع اسم_الدالة: متجه ط8 = انسخ_بايتات_دوارف(&(*الدالة).الاسم);
                    دع الاسم_العام: اسم_عام_دوارف = { إزاحة_معلومة: إزاحة_المعلومة, الاسم: اسم_الدالة };
                    ألحق(الأسماء_العامة, الاسم_العام);
                };
                ألحق_معاملات_دالة_دوارف(البيانات, الخريطة, سجل_الأصول, الدالة, &مواضع_الأنواع, المواقع, له_تعريف_آلة, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام);
                إذا (له_تعريف_آلة) {
                    طابق فهرس_الموضع مع
                    | اختياري.موجود(موضع_الفهرس) -> {
                        دع موضع_الدالة: &موضع_دالة_دوارف = &(*المواضع)[موضع_الفهرس];
                        دع فهرس_النطاقات: فهرس_نطاقات_دالة_دوارف = ابن_فهرس_نطاقات_دالة_دوارف(الدالة);
                        دع ج: متغير طبيعي = 0;
                        طالما (ج < (الطول(فهرس_النطاقات.الجذور) مثل طبيعي)) { ألحق_نطاق_دوارف_تكراريا(البيانات, الخريطة, سجل_الأصول, موضع_الدالة, الدالة, فهرس_النطاقات.الجذور[ج], &فهرس_النطاقات, &مواضع_الأنواع, المواقع, آلة, السياسة, بيانات_السلاسل, السلاسل, العناوين, قوائم_النطاقات, الرقع, رقع_الأقسام, صواب, &(*التصحيح).الدلالي, &متغير رقع_الأصول); ج := ج + 1; }
                    }
                    | اختياري.لا_شيء -> { };
                };
                ألحق_ط8_دوارف(البيانات, 0);
            };
        };
        ف := ف + 1;
    }

    // A function that exists only inlined gets an abstract subprogram
    // (DW_AT_inline), the origin of its inlined calls; then every
    // abstract_origin is patched.
    دع ر_أ: متغير طبيعي = 0;
    طالما (ر_أ + 1 < (الطول(رقع_الأصول) مثل طبيعي)) {
        دع المضمنة: طبيعي = رقع_الأصول[ر_أ + 1];
        إذا (المضمنة < (الطول(مواضع_دوال_التصحيح) مثل طبيعي) && مواضع_دوال_التصحيح[المضمنة] == 0) {
            مواضع_دوال_التصحيح[المضمنة] := الطول(*البيانات) مثل طبيعي;
            دع الدالة_الدلالية: &دالة_تصحيح = &(*التصحيح).الدلالي.الدوال[المضمنة];
            ألحق_ليب128_دوارف(البيانات, 33);
            ألحق_اسم_دوارف(البيانات, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*الدالة_الدلالية).الاسم);
            دع وجد: منطقي = ألحق_إحداثي_تصريح_دوارف(البيانات, الخريطة, سجل_الأصول, (*الدالة_الدلالية).الأصل, السياسة);
            // DW_INL_inlined.
            ألحق_ط8_دوارف(البيانات, 1);
        };
        ر_أ := ر_أ + 2;
    }
    ر_أ := 0;
    طالما (ر_أ + 1 < (الطول(رقع_الأصول) مثل طبيعي)) {
        دع المضمنة: طبيعي = رقع_الأصول[ر_أ + 1];
        إذا (المضمنة < (الطول(مواضع_دوال_التصحيح) مثل طبيعي)) {
            اكتب_إزاحة_دوارف(البيانات, السياسة, رقع_الأصول[ر_أ], مواضع_دوال_التصحيح[المضمنة]);
        };
        ر_أ := ر_أ + 2;
    }

    ألحق_ط8_دوارف(البيانات, 0); اختم_وحدة_دوارف(البيانات, السياسة, بداية_الوحدة);
    دع الناتج: ناتج_معلومات_دوارف = { الأسماء_العامة: الأسماء_العامة, فهرس_الأسماء: فهرس_الأسماء }; أرجع الناتج;
}
