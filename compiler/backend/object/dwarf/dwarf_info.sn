استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;

// DIE emission consumes canonical source/type facts plus precomputed machine
// ranges. It owns no semantic analysis, register allocation, or target policy.
عام نوع ناتج_معلومات_دوارف = {
    الأسماء_العامة: متجه اسم_عام_دوارف,
    فهرس_الأسماء: متجه مدخل_فهرس_اسم_دوارف
};

عرف ألحق_إحداثي_تصريح_دوارف(
    ب: &متغير متجه غ8,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر,
    السياسة: &سياسة_دوارف
): منطقي {
    طابق أصل_مصدر_بالمعرف(سجل_الأصول, الأصل) مع
    | اختيار.لا_شيء -> { ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0); أرجع خطأ; }
    | اختيار.بعض(وصف_الأصل) -> {
        دع الملف: غير_موقع = فهرس_ملف_دوارف(السياسة, وصف_الأصل.النطاق.البداية.المصدر);
        طابق إحداثي_من_الخريطة(الخريطة, وصف_الأصل.النطاق.البداية) مع
        | اختيار.لا_شيء -> { ألحق_ليب128_دوارف(ب, الملف); ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0); أرجع خطأ; }
        | اختيار.بعض(الإحداثي) -> {
            ألحق_ليب128_دوارف(ب, الملف);
            ألحق_ليب128_دوارف(ب, الإحداثي.السطر مثل غير_موقع);
            ألحق_ليب128_دوارف(ب, (الإحداثي.العمود مثل غير_موقع) + 1);
            أرجع صواب;
        };
    };
}

عرف ألحق_مرجع_موقع_دوارف(
    ب: &متغير متجه غ8,
    السياسة: &سياسة_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    القيمة: غير_موقع
): فراغ {
    لو ((*السياسة).حديث) { ألحق_ليب128_دوارف(ب, القيمة); }
    وإلا { ألحق_مرجع_قسم_دوارف(ب, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.مواقع(), القيمة); };
}

عرف ألحق_محليا_دوارف(
    ب: &متغير متجه غ8,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    مواقع_الأنواع: &متجه غير_موقع,
    المحلي: &وصف_متغير_دوارف,
    المواقع: &ناتج_مواقع_دوارف,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه غ8, السلاسل: &متغير جدول_سلاسل_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    طابق موقع_متغير_دوارف(المواقع, (*المحلي).المتغير) مع
    | اختيار.لا_شيء -> {
        ألحق_ليب128_دوارف(ب, 12); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*المحلي).الاسم);
        ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*المحلي).الأصل, السياسة);
        ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*المحلي).هوية_النوع);
        لو ((*المحلي).اصطناعي) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); };
    }
    | اختيار.بعض(الإزاحة) -> {
        ألحق_ليب128_دوارف(ب, 13); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*المحلي).الاسم);
        ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*المحلي).الأصل, السياسة);
        ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*المحلي).هوية_النوع);
        ألحق_مرجع_موقع_دوارف(ب, السياسة, رقع_الأقسام, الإزاحة);
        لو ((*المحلي).اصطناعي) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); };
    };
}

نوع فهرس_نطاقات_دالة_دوارف = {
    موضع_بالمعرف: متجه اختيار غير_موقع,
    الأطفال: متجه متجه غير_موقع,
    المحليات: متجه متجه غير_موقع,
    الجذور: متجه غير_موقع
};

عرف ابن_فهرس_نطاقات_دالة_دوارف(الدالة: &وصف_دالة_دوارف): فهرس_نطاقات_دالة_دوارف {
    دع العدد: غير_موقع = الطول((*الدالة).النطاقات) مثل غير_موقع;
    دع أعلى: متغير غير_موقع = 0; دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) { لو ((*الدالة).النطاقات[ف].المعرف > أعلى) { أعلى := (*الدالة).النطاقات[ف].المعرف; }; ف := ف + 1; }
    دع موضع_بالمعرف: متغير متجه اختيار غير_موقع = [];
    ف := 0; بينما (ف <= أعلى) { ألحق(موضع_بالمعرف, اختيار.لا_شيء()); ف := ف + 1; }
    دع الأطفال: متغير متجه متجه غير_موقع = []; دع المحليات: متغير متجه متجه غير_موقع = []; دع الجذور: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف < العدد) {
        دع فارغ_أطفال: متجه غير_موقع = [];
        دع فارغ_محليات: متجه غير_موقع = [];
        ألحق(الأطفال, فارغ_أطفال);
        ألحق(المحليات, فارغ_محليات);
        دع معرف_النطاق: غير_موقع = (*الدالة).النطاقات[ف].المعرف;
        موضع_بالمعرف[معرف_النطاق] := اختيار.بعض(ف);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < العدد) {
        طابق (*الدالة).النطاقات[ف].الأب مع
        | اختيار.بعض(معرف_الأب) -> {
            لو (معرف_الأب < (الطول(موضع_بالمعرف) مثل غير_موقع)) { طابق موضع_بالمعرف[معرف_الأب] مع | اختيار.بعض(موضع_الأب) -> { ألحق(الأطفال[موضع_الأب], ف); } | اختيار.لا_شيء -> { ألحق(الجذور, ف); }; }
            وإلا { ألحق(الجذور, ف); };
        }
        | اختيار.لا_شيء -> { ألحق(الجذور, ف); };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول((*الدالة).المحليات) مثل غير_موقع)) {
        دع معرف_النطاق: غير_موقع = (*الدالة).المحليات[ف].نطاق_الإحاطة;
        لو (معرف_النطاق < (الطول(موضع_بالمعرف) مثل غير_موقع)) { طابق موضع_بالمعرف[معرف_النطاق] مع | اختيار.بعض(موضع_النطاق) -> { ألحق(المحليات[موضع_النطاق], ف); } | اختيار.لا_شيء -> { }; };
        ف := ف + 1;
    }
    دع الناتج: فهرس_نطاقات_دالة_دوارف = { موضع_بالمعرف: موضع_بالمعرف, الأطفال: الأطفال, المحليات: المحليات, الجذور: الجذور }; أرجع الناتج;
}

عرف مدى_نطاق_متصل_دوارف(المديات: &متجه مدى_نص_دوارف): اختيار مدى_نص_دوارف {
    لو ((الطول(*المديات) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع البداية: غير_موقع = (*المديات)[0].إزاحة_بايت;
    دع النهاية: متغير غير_موقع = البداية + (*المديات)[0].حجم_بايت;
    دع ف: متغير غير_موقع = 1;
    بينما (ف < (الطول(*المديات) مثل غير_موقع)) {
        لو ((*المديات)[ف].إزاحة_بايت > النهاية) { أرجع اختيار.لا_شيء(); };
        دع نهاية_المدى: غير_موقع = (*المديات)[ف].إزاحة_بايت + (*المديات)[ف].حجم_بايت;
        لو (نهاية_المدى > النهاية) { النهاية := نهاية_المدى; };
        ف := ف + 1;
    }
    دع الحجم: غير_موقع = النهاية - البداية;
    دع المدى: مدى_نص_دوارف = { إزاحة_بايت: البداية, حجم_بايت: الحجم };
    أرجع اختيار.بعض(المدى);
}

عرف ألحق_عنوان_معلومات_دوارف(
    ب: &متغير متجه غ8,
    السياسة: &سياسة_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    الإزاحة: غير_موقع
): فراغ {
    لو ((*السياسة).حديث) { ألحق_ليب128_دوارف(ب, أدرج_عنوان_نص_دوارف(العناوين, الإزاحة)); }
    وإلا { ألحق_مرجع_عنوان_دوارف(ب, الرقع, قسم_عنوان_دوارف.معلومات(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), الإزاحة); };
}

عرف ألحق_نطاق_دوارف_تكراريا(
    ب: &متغير متجه غ8,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    موضع_الدالة: &موضع_دالة_دوارف,
    الدالة: &وصف_دالة_دوارف,
    موضع_النطاق: غير_موقع,
    الفهرس: &فهرس_نطاقات_دالة_دوارف,
    مواقع_الأنواع: &متجه غير_موقع,
    المواقع: &ناتج_مواقع_دوارف,
    آلة: &سياق_تصحيح_آلة,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه غ8, السلاسل: &متغير جدول_سلاسل_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف,
    قوائم_النطاقات: &متغير جدول_قوائم_نطاقات_دوارف,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    لو (موضع_النطاق >= (الطول((*الدالة).النطاقات) مثل غير_موقع)) { أرجع; };
    دع وصف_النطاق: &وصف_نطاق_دوارف = &(*الدالة).النطاقات[موضع_النطاق];
    دع معرف_النطاق: معرف_نطاق_تصحيح = معرف_نطاق_تصحيح_من((*وصف_النطاق).المعرف);
    دع المديات: متجه مدى_نص_دوارف = مديات_نطاق_دوارف_من_آلة(آلة, (*الدالة).الدالة, معرف_النطاق, موضع_الدالة);
    لو ((الطول(المديات) مثل غير_موقع) == 0) { أرجع; };
    لو ((*السياسة).حديث) {
        طابق مدى_نطاق_متصل_دوارف(&المديات) مع
        | اختيار.بعض(المدى) -> { ألحق_ليب128_دوارف(ب, 11); ألحق_عنوان_معلومات_دوارف(ب, السياسة, العناوين, الرقع, المدى.إزاحة_بايت); ألحق_غ64_دوارف(ب, المدى.حجم_بايت); }
        | اختيار.لا_شيء -> { ألحق_ليب128_دوارف(ب, 30); ألحق_ليب128_دوارف(ب, أدرج_قائمة_نطاقات_دوارف(قوائم_النطاقات, العناوين, &المديات)); };
    } وإلا {
        طابق مدى_نطاق_دوارف_من_آلة(آلة, (*الدالة).الدالة, معرف_النطاق, موضع_الدالة) مع
        | اختيار.لا_شيء -> { أرجع; }
        | اختيار.بعض(المدى) -> { ألحق_ليب128_دوارف(ب, 11); ألحق_عنوان_معلومات_دوارف(ب, السياسة, العناوين, الرقع, المدى.إزاحة_بايت); ألحق_غ64_دوارف(ب, المدى.حجم_بايت); };
    };
    دع ل: متغير غير_موقع = 0;
    بينما (ل < (الطول((*الفهرس).المحليات[موضع_النطاق]) مثل غير_موقع)) {
        دع موضع_المحلي: غير_موقع = (*الفهرس).المحليات[موضع_النطاق][ل];
        ألحق_محليا_دوارف(ب, الخريطة, سجل_الأصول, مواقع_الأنواع, &(*الدالة).المحليات[موضع_المحلي], المواقع, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام); ل := ل + 1;
    }
    دع ط: متغير غير_موقع = 0;
    بينما (ط < (الطول((*الفهرس).الأطفال[موضع_النطاق]) مثل غير_موقع)) {
        ألحق_نطاق_دوارف_تكراريا(ب, الخريطة, سجل_الأصول, موضع_الدالة, الدالة, (*الفهرس).الأطفال[موضع_النطاق][ط], الفهرس, مواقع_الأنواع, المواقع, آلة, السياسة, بيانات_السلاسل, السلاسل, العناوين, قوائم_النطاقات, الرقع, رقع_الأقسام); ط := ط + 1;
    }
    ألحق_غ8_دوارف(ب, 0);
}

عرف ابن_فهرس_مواضع_عوام_دوارف(المواضع: &متجه موضع_عام_دوارف, التصحيح: &بيانات_تصحيح_مسير): متجه اختيار غير_موقع {
    دع أعلى_عام: متغير غير_موقع = 0; دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المواضع) مثل غير_موقع)) { لو ((*المواضع)[ف].العام.القيمة > أعلى_عام) { أعلى_عام := (*المواضع)[ف].العام.القيمة; }; ف := ف + 1; }
    دع موضع_مسير: متغير متجه اختيار غير_موقع = []; ف := 0; بينما (ف <= أعلى_عام) { ألحق(موضع_مسير, اختيار.لا_شيء()); ف := ف + 1; }
    ف := 0; بينما (ف < (الطول(*المواضع) مثل غير_موقع)) { دع المعرف: غير_موقع = (*المواضع)[ف].العام.القيمة; بينما ((الطول(موضع_مسير) مثل غير_موقع) <= المعرف) { ألحق(موضع_مسير, اختيار.لا_شيء()); } موضع_مسير[المعرف] := اختيار.بعض(ف); ف := ف + 1; }
    دع الناتج: متغير متجه اختيار غير_موقع = []; ف := 0; بينما (ف < (الطول((*التصحيح).الدلالي.العوام) مثل غير_موقع)) { ألحق(الناتج, اختيار.لا_شيء()); ف := ف + 1; }
    ف := 0;
    بينما (ف < (الطول((*التصحيح).العقد.العوام) مثل غير_موقع)) {
        طابق (*التصحيح).العقد.العوام[ف] مع
        | اختيار.بعض(معرف_التصحيح) -> { لو (معرف_التصحيح.القيمة < (الطول(الناتج) مثل غير_موقع) && ف < (الطول(موضع_مسير) مثل غير_موقع)) { الناتج[معرف_التصحيح.القيمة] := موضع_مسير[ف]; }; }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أضف_مدخل_فهرس_دوارف(الفهرس: &متغير متجه مدخل_فهرس_اسم_دوارف, الإزاحة: غير_موقع, الاسم: &متجه غ8, النوع: نوع_مدخل_فهرس_اسم_دوارف): فراغ {
    لو ((الطول(*الاسم) مثل غير_موقع) == 0) { أرجع; };
    دع نسخة_الاسم: متجه غ8 = انسخ_بايتات_دوارف(الاسم);
    دع المدخل: مدخل_فهرس_اسم_دوارف = { إزاحة_معلومة: الإزاحة, الاسم: نسخة_الاسم, النوع: النوع };
    ألحق(*الفهرس, المدخل);
}

عرف نوع_فهرس_وصف_نوع_دوارف(الوصف: &وصف_نوع_دوارف): نوع_مدخل_فهرس_اسم_دوارف {
    طابق (*الوصف).الصنف مع
    | صنف_نوع_دوارف.أساسي_موقع -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.أساسي_غير_موقع -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.أساسي_منطقي -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.أساسي_عشري -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.أساسي_محرف -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي(); }
    | صنف_نوع_دوارف.مؤشر(_) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_مؤشر(); }
    | صنف_نوع_دوارف.صندوق(_) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_مؤشر(); }
    | صنف_نوع_دوارف.مرجع(_) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_مرجع(); }
    | صنف_نوع_دوارف.اسم_مستعار(_) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.اسم_مستعار(); }
    | صنف_نوع_دوارف.دالة(_, _) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_دالة(); }
    | صنف_نوع_دوارف.مركب(_, _, _) -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_بنية(); }
    | صنف_نوع_دوارف.غير_محدد -> { أرجع نوع_مدخل_فهرس_اسم_دوارف.نوع_غير_محدد(); };
}

عرف ألحق_وحدات_دوارف(
    ب: &متغير متجه غ8, السياق: &سياق_تصحيح, السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه غ8, السلاسل: &متغير جدول_سلاسل_دوارف, رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    الفهرس: &متغير متجه مدخل_فهرس_اسم_دوارف
): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*السياق).الوحدات) مثل غير_موقع)) {
        دع الوحدة: &وحدة_تصحيح = &(*السياق).الوحدات[ف]; دع الإزاحة: غير_موقع = الطول(*ب) مثل غير_موقع;
        ألحق_ليب128_دوارف(ب, 23); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*الوحدة).الاسم); ألحق_ليب128_دوارف(ب, فهرس_ملف_دوارف(السياسة, (*الوحدة).معرف_المصدر)); لو ((*الوحدة).اصطناعي) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); };
        لو ((*السياسة).حديث) { أضف_مدخل_فهرس_دوارف(الفهرس, الإزاحة, &(*الوحدة).الاسم, نوع_مدخل_فهرس_اسم_دوارف.وحدة()); };
        ف := ف + 1;
    }
}

عرف ألحق_عاما_دوارف(
    ب: &متغير متجه غ8, الخريطة: &متغير خريطة_مصادر, سجل_الأصول: &سجل_أصول_مصدر,
    مواقع_الأنواع: &متجه غير_موقع, العام: &عام_تصحيح, مواضع_العوام: &متجه موضع_عام_دوارف, موضع_البيانات: اختيار غير_موقع,
    السياسة: &سياسة_دوارف, بيانات_السلاسل: &متغير متجه غ8, السلاسل: &متغير جدول_سلاسل_دوارف, رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف, الرقع: &متغير متجه رقعة_عنوان_دوارف,
    الأسماء_العامة: &متغير متجه اسم_عام_دوارف, الفهرس: &متغير متجه مدخل_فهرس_اسم_دوارف
): فراغ {
    دع له_موقع: متغير منطقي = خطأ; دع الإزاحة: متغير غير_موقع = 0; دع اسم_الربط_الفعلي: متغير متجه غ8 = انسخ_بايتات_دوارف(&(*العام).اسم_الربط);
    طابق موضع_البيانات مع | اختيار.بعض(موضع_الفهرس) -> { لو (موضع_الفهرس < (الطول(*مواضع_العوام) مثل غير_موقع)) { دع الموضع: &موضع_عام_دوارف = &(*مواضع_العوام)[موضع_الفهرس]; له_موقع := !(*العام).إعلان_فقط; الإزاحة := (*الموضع).إزاحة_بايت; اسم_الربط_الفعلي := انسخ_بايتات_دوارف(&(*الموضع).اسم_الربط); }; } | اختيار.لا_شيء -> { };
    دع الاختصار: متغير غير_موقع = 25; لو (له_موقع) { الاختصار := 24; };
    دع إزاحة_المعلومة: غير_موقع = الطول(*ب) مثل غير_موقع;
    ألحق_ليب128_دوارف(ب, الاختصار); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*العام).الاسم); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &اسم_الربط_الفعلي);
    ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*العام).الأصل, السياسة); ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*العام).النوع.القيمة);
    لو ((*العام).علني) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); }; لو ((*العام).إعلان_فقط) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); }; لو ((*العام).اصطناعي) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); };
    لو (له_موقع) {
        لو ((*السياسة).حديث) {
            دع تعبير: متغير متجه غ8 = [];
            دع عملية: عملية_تعبير_دوارف = عملية_تعبير_دوارف.عنوان_مفهرس(أدرج_عنوان_بيانات_دوارف(العناوين, الإزاحة));
            ألحق_عملية_تعبير_دوارف(&متغير تعبير, &عملية, قسم_عنوان_دوارف.معلومات(), (*السياسة).حجم_العنوان, الرقع);
            ألحق_ليب128_دوارف(ب, الطول(تعبير) مثل غير_موقع); ألحق_بايتات_دوارف(ب, &تعبير);
        } وإلا {
            ألحق_ليب128_دوارف(ب, 1 + (*السياسة).حجم_العنوان);
            دع عملية: عملية_تعبير_دوارف = عملية_تعبير_دوارف.عنوان_رمزي(قاعدة_عنوان_دوارف.بيانات(), الإزاحة);
            ألحق_عملية_تعبير_دوارف(ب, &عملية, قسم_عنوان_دوارف.معلومات(), (*السياسة).حجم_العنوان, الرقع);
        };
    };
    لو ((*السياسة).حديث) {
        أضف_مدخل_فهرس_دوارف(الفهرس, إزاحة_المعلومة, &(*العام).الاسم, نوع_مدخل_فهرس_اسم_دوارف.متغير());
    } وإلا {
        دع الاسم: متجه غ8 = انسخ_بايتات_دوارف(&(*العام).الاسم);
        دع المدخل: اسم_عام_دوارف = { إزاحة_معلومة: إزاحة_المعلومة, الاسم: الاسم };
        ألحق(*الأسماء_العامة, المدخل);
    };
}

عرف ألحق_ثابتا_دوارف(
    ب: &متغير متجه غ8, الخريطة: &متغير خريطة_مصادر, سجل_الأصول: &سجل_أصول_مصدر, مواقع_الأنواع: &متجه غير_موقع,
    الثابت: &ثابت_تصحيح, السياسة: &سياسة_دوارف, بيانات_السلاسل: &متغير متجه غ8, السلاسل: &متغير جدول_سلاسل_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف, الفهرس: &متغير متجه مدخل_فهرس_اسم_دوارف
): فراغ {
    طابق (*الثابت).القيمة مع
    | اختيار.لا_شيء -> { أرجع; }
    | اختيار.بعض(القيمة) -> {
        دع الإزاحة: غير_موقع = الطول(*ب) مثل غير_موقع; ألحق_ليب128_دوارف(ب, 26); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*الثابت).الاسم);
        ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*الثابت).الأصل, السياسة); ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*الثابت).النوع.القيمة);
        لو ((*الثابت).علني) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); }; لو ((*الثابت).اصطناعي) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); };
        طابق القيمة مع | قيمة_ثابت_تصحيح.منطق(ق) -> { لو (ق) { ألحق_غ64_دوارف(ب, 1); } وإلا { ألحق_غ64_دوارف(ب, 0); }; } | قيمة_ثابت_تصحيح.صحيح_موقع(ق) -> { ألحق_غ64_دوارف(ب, ق مثل غير_موقع); } | قيمة_ثابت_تصحيح.صحيح_غير_موقع(ق) -> { ألحق_غ64_دوارف(ب, ق); };
        لو ((*السياسة).حديث) { أضف_مدخل_فهرس_دوارف(الفهرس, الإزاحة, &(*الثابت).الاسم, نوع_مدخل_فهرس_اسم_دوارف.ثابت()); };
    };
}

عرف ألحق_معاملات_دالة_دوارف(
    ب: &متغير متجه غ8, الخريطة: &متغير خريطة_مصادر, سجل_الأصول: &سجل_أصول_مصدر, الدالة: &وصف_دالة_دوارف,
    مواقع_الأنواع: &متجه غير_موقع, المواقع: &ناتج_مواقع_دوارف, مع_مواقع: منطقي, السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه غ8, السلاسل: &متغير جدول_سلاسل_دوارف, رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    دع ع: متغير غير_موقع = 0;
    بينما (ع < (الطول((*الدالة).المعاملات) مثل غير_موقع)) {
        دع المعامل: &وصف_معامل_دوارف = &(*الدالة).المعاملات[ع]; دع إزاحة_الموقع: متغير اختيار غير_موقع = اختيار.لا_شيء(); لو (مع_مواقع) { إزاحة_الموقع := موقع_متغير_دوارف(المواقع, (*المعامل).المتغير); };
        طابق إزاحة_الموقع مع
        | اختيار.لا_شيء -> { ألحق_ليب128_دوارف(ب, 4); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*المعامل).الاسم); ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*المعامل).الأصل, السياسة); ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*المعامل).هوية_النوع); لو ((*المعامل).اصطناعي) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); }; }
        | اختيار.بعض(الإزاحة) -> { ألحق_ليب128_دوارف(ب, 5); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*المعامل).الاسم); ألحق_إحداثي_تصريح_دوارف(ب, الخريطة, سجل_الأصول, (*المعامل).الأصل, السياسة); ألحق_مرجع_نوع_دوارف(ب, السياسة, مواقع_الأنواع, (*المعامل).هوية_النوع); ألحق_مرجع_موقع_دوارف(ب, السياسة, رقع_الأقسام, الإزاحة); لو ((*المعامل).اصطناعي) { ألحق_غ8_دوارف(ب, 1); } وإلا { ألحق_غ8_دوارف(ب, 0); }; };
        ع := ع + 1;
    }
}

عام عرف ابن_معلومات_دوارف(
    الخريطة: &متغير خريطة_مصادر, سجل_الأصول: &سجل_أصول_مصدر, المواضع: &متجه موضع_دالة_دوارف, مواضع_العوام: &متجه موضع_عام_دوارف,
    التصحيح: &بيانات_تصحيح_مسير, الأوصاف: &متجه وصف_دالة_دوارف, الأنواع: &متجه وصف_نوع_دوارف, المواقع: &ناتج_مواقع_دوارف,
    آلة: &سياق_تصحيح_آلة, فهرس_الدوال: &فهرس_دوال_دوارف, حجم_النص: غير_موقع, السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه غ8, السلاسل: &متغير جدول_سلاسل_دوارف, العناوين: &متغير جدول_عناوين_دوارف, قوائم_النطاقات: &متغير جدول_قوائم_نطاقات_دوارف,
    البيانات: &متغير متجه غ8, الرقع: &متغير متجه رقعة_عنوان_دوارف, رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): ناتج_معلومات_دوارف {
    دع الأسماء_العامة: متغير متجه اسم_عام_دوارف = []; دع فهرس_الأسماء: متغير متجه مدخل_فهرس_اسم_دوارف = [];
    دع بداية_الوحدة: غير_موقع = ابدأ_وحدة_دوارف(البيانات, السياسة);
    ألحق_غ16_دوارف(البيانات, رمز_إصدار_دوارف((*السياسة).الإصدار));
    لو ((*السياسة).حديث) {
        ألحق_غ8_دوارف(البيانات, رمز_نوع_وحدة_دوارف(نوع_وحدة_دوارف.ترجمة())); ألحق_غ8_دوارف(البيانات, (*السياسة).حجم_العنوان);
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.اختصارات(), 0);
    } وإلا {
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.اختصارات(), 0);
        ألحق_غ8_دوارف(البيانات, (*السياسة).حجم_العنوان);
    };
    ألحق_ليب128_دوارف(البيانات, 1);
    دع المنتج: متجه غ8 = [0x53,0x75,0x6C,0x74,0x61,0x6E,0x43]; ألحق_اسم_دوارف(البيانات, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &المنتج);
    ألحق_غ16_دوارف(البيانات, رمز_لغة_دوارف(لغة_دوارف.سلطان())); دع اسم_الوحدة: نص = اسم_وحدة_دوارف(الخريطة); ألحق_اسم_نصي_دوارف(البيانات, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &اسم_الوحدة);
    ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.سطور(), 0);
    لو ((*السياسة).حديث) {
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.عناوين(), قاعدة_جدول_عناوين_دوارف(السياسة));
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.قوائم_مواقع(), قاعدة_جدول_قوائم_دوارف(السياسة));
        ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.قوائم_نطاقات(), قاعدة_جدول_قوائم_دوارف(السياسة));
    } وإلا {
        ألحق_مرجع_عنوان_دوارف(البيانات, الرقع, قسم_عنوان_دوارف.معلومات(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), 0); ألحق_غ64_دوارف(البيانات, حجم_النص);
    };

    دع مواضع_الأنواع: متغير متجه غير_موقع = []; دع رقع_الأنواع: متغير متجه رقعة_نوع_دوارف = [];
    ابن_أنواع_معلومات_دوارف(البيانات, الأنواع, الخريطة, سجل_الأصول, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &متغير مواضع_الأنواع, &متغير رقع_الأنواع);
    طبق_رقع_أنواع_دوارف(البيانات, السياسة, &مواضع_الأنواع, &رقع_الأنواع);
    دع ت: متغير غير_موقع = 0;
    لو ((*السياسة).حديث) {
        بينما (ت < (الطول(*الأنواع) مثل غير_موقع)) {
            دع وصف_النوع: &وصف_نوع_دوارف = &(*الأنواع)[ت];
            دع هوية_النوع: غير_موقع = (*وصف_النوع).الهوية;
            لو (هوية_النوع < (الطول(مواضع_الأنواع) مثل غير_موقع)) {
                دع موضع_النوع: غير_موقع = مواضع_الأنواع[هوية_النوع];
                دع نوع_الفهرس: نوع_مدخل_فهرس_اسم_دوارف = نوع_فهرس_وصف_نوع_دوارف(وصف_النوع);
                أضف_مدخل_فهرس_دوارف(&متغير فهرس_الأسماء, موضع_النوع, &(*وصف_النوع).الاسم, نوع_الفهرس);
            };
            ت := ت + 1;
        }
    };

    ألحق_وحدات_دوارف(البيانات, &(*التصحيح).الدلالي, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &متغير فهرس_الأسماء);
    دع فهرس_عوام: متجه اختيار غير_موقع = ابن_فهرس_مواضع_عوام_دوارف(مواضع_العوام, التصحيح);
    دع ف: متغير غير_موقع = 0;
