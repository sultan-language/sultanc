استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_constants;

نوع مدخل_عنوان_دوارف = {
    المرجع: مرجع_عنوان_دوارف,
    التالي: اختياري طبيعي
};

// Indexed, append-only address table. Entries are symbolic until the object
// writer translates their fixups into Mach-O/ELF relocation semantics.
عام نوع جدول_عناوين_دوارف = {
    المداخل: متجه مدخل_عنوان_دوارف,
    الدلاء: متجه اختياري طبيعي
};

عرف دلاء_عناوين_دوارف(السعة: طبيعي): متجه اختياري طبيعي {
    دع الدلاء: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الدلاء, اختياري.لا_شيء()); ف := ف + 1; }
    أرجع الدلاء;
}

عام عرف جدول_عناوين_دوارف_فارغ(): جدول_عناوين_دوارف {
    دع الدلاء: متجه اختياري طبيعي = دلاء_عناوين_دوارف(16);
    دع المداخل: متجه مدخل_عنوان_دوارف = [];
    دع الناتج: جدول_عناوين_دوارف = { المداخل: المداخل, الدلاء: الدلاء };
    أرجع الناتج;
}

عرف هاش_مرجع_عنوان_دوارف(المرجع: &مرجع_عنوان_دوارف): طبيعي {
    دع قاعدة: متغير طبيعي = 1;
    طابق (*المرجع).القاعدة مع
    | قاعدة_عنوان_دوارف.نص -> { قاعدة := 1; }
    | قاعدة_عنوان_دوارف.بيانات -> { قاعدة := 2; };
    أرجع (((*المرجع).إزاحة_بايت % 4294967291) * 33 + قاعدة) % 4294967291;
}

عرف مرجعا_عنوان_دوارف_متساويان(أ: &مرجع_عنوان_دوارف, ب: &مرجع_عنوان_دوارف): منطقي {
    لو ((*أ).إزاحة_بايت != (*ب).إزاحة_بايت) { أرجع خطأ; };
    طابق (*أ).القاعدة مع
    | قاعدة_عنوان_دوارف.نص -> {
        طابق (*ب).القاعدة مع | قاعدة_عنوان_دوارف.نص -> { أرجع صواب; } | _ -> { أرجع خطأ; };
    }
    | قاعدة_عنوان_دوارف.بيانات -> {
        طابق (*ب).القاعدة مع | قاعدة_عنوان_دوارف.بيانات -> { أرجع صواب; } | _ -> { أرجع خطأ; };
    };
}


عرف أعد_فهرسة_عناوين_دوارف(الجدول: &متغير جدول_عناوين_دوارف, السعة: طبيعي): فراغ {
    دع الجديدة: متغير متجه اختياري طبيعي = دلاء_عناوين_دوارف(السعة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الجدول).المداخل) مثل طبيعي)) {
        دع الدلو: طبيعي = هاش_مرجع_عنوان_دوارف(&(*الجدول).المداخل[ف].المرجع) % السعة;
        (*الجدول).المداخل[ف].التالي := الجديدة[الدلو];
        الجديدة[الدلو] := اختياري.موجود(ف);
        ف := ف + 1;
    }
    (*الجدول).الدلاء := الجديدة;
}

عرف تأكد_سعة_عناوين_دوارف(الجدول: &متغير جدول_عناوين_دوارف): فراغ {
    دع السعة: طبيعي = الطول((*الجدول).الدلاء) مثل طبيعي;
    دع عدد_المداخل: طبيعي = الطول((*الجدول).المداخل) مثل طبيعي;
    لو ((عدد_المداخل + 1) * 3 >= السعة * 2) {
        أعد_فهرسة_عناوين_دوارف(الجدول, السعة * 2);
    };
}

عام عرف أدرج_عنوان_دوارف(الجدول: &متغير جدول_عناوين_دوارف, المرجع: مرجع_عنوان_دوارف): طبيعي {
    دع الدلو: طبيعي = هاش_مرجع_عنوان_دوارف(&المرجع) % (الطول((*الجدول).الدلاء) مثل طبيعي);
    دع الحالي: متغير اختياري طبيعي = (*الجدول).الدلاء[الدلو];
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق الحالي مع
        | اختياري.لا_شيء -> { مستمر := خطأ; }
        | اختياري.موجود(ف) -> {
            لو (مرجعا_عنوان_دوارف_متساويان(&(*الجدول).المداخل[ف].المرجع, &المرجع)) { أرجع ف; };
            الحالي := (*الجدول).المداخل[ف].التالي;
        };
    }
    تأكد_سعة_عناوين_دوارف(الجدول);
    دع دلو_الإدراج: طبيعي = هاش_مرجع_عنوان_دوارف(&المرجع) % (الطول((*الجدول).الدلاء) مثل طبيعي);
    دع الفهرس: طبيعي = الطول((*الجدول).المداخل) مثل طبيعي;
    دع التالي: اختياري طبيعي = (*الجدول).الدلاء[دلو_الإدراج];
    دع المدخل: مدخل_عنوان_دوارف = { المرجع: المرجع, التالي: التالي };
    ألحق((*الجدول).المداخل, المدخل);
    (*الجدول).الدلاء[دلو_الإدراج] := اختياري.موجود(الفهرس);
    أرجع الفهرس;
}

عام عرف أدرج_عنوان_نص_دوارف(الجدول: &متغير جدول_عناوين_دوارف, الإزاحة: طبيعي): طبيعي {
    دع القاعدة: قاعدة_عنوان_دوارف = قاعدة_عنوان_دوارف.نص();
    دع المرجع: مرجع_عنوان_دوارف = { القاعدة: القاعدة, إزاحة_بايت: الإزاحة };
    أرجع أدرج_عنوان_دوارف(الجدول, المرجع);
}

عام عرف أدرج_عنوان_بيانات_دوارف(الجدول: &متغير جدول_عناوين_دوارف, الإزاحة: طبيعي): طبيعي {
    دع القاعدة: قاعدة_عنوان_دوارف = قاعدة_عنوان_دوارف.بيانات();
    دع المرجع: مرجع_عنوان_دوارف = { القاعدة: القاعدة, إزاحة_بايت: الإزاحة };
    أرجع أدرج_عنوان_دوارف(الجدول, المرجع);
}

عام عرف ابن_قسم_عناوين_دوارف(
    السياسة: &سياسة_دوارف,
    الجدول: &جدول_عناوين_دوارف,
    الرقع: &متغير متجه رقعة_عنوان_دوارف
): متجه ط8 {
    دع ب: متغير متجه ط8 = [];
    لو (!(*السياسة).حديث) { أرجع ب; };
    دع بداية: طبيعي = ابدأ_وحدة_دوارف(&متغير ب, السياسة);
    ألحق_ط16_دوارف(&متغير ب, رمز_إصدار_دوارف((*السياسة).الإصدار));
    ألحق_ط8_دوارف(&متغير ب, (*السياسة).حجم_العنوان);
    ألحق_ط8_دوارف(&متغير ب, 0);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الجدول).المداخل) مثل طبيعي)) {
        دع المرجع: مرجع_عنوان_دوارف = (*الجدول).المداخل[ف].المرجع;
        دع الموضع: طبيعي = الطول(ب) مثل طبيعي;
        سجل_رقعة_عنوان_دوارف(الرقع, قسم_عنوان_دوارف.عناوين(), الموضع, (*السياسة).حجم_العنوان, المرجع.القاعدة, المرجع.إزاحة_بايت);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (*السياسة).حجم_العنوان) { ألحق_ط8_دوارف(&متغير ب, 0); ك := ك + 1; }
        ف := ف + 1;
    }
    اختم_وحدة_دوارف(&متغير ب, السياسة, بداية);
    أرجع ب;
}
