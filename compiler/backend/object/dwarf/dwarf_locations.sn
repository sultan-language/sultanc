استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_expression;
استورد compiler.backend.object.dwarf.dwarf_unit;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.backend.object.dwarf.dwarf_addresses;
استورد compiler.backend.codegen.debug.model;
استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;

// Variable identity and machine storage are separate. This serializer consumes
// already-materialized PC ranges from compiler/backend/codegen/debug and never rescans
// provenance, allocator assignments, or spill state.
عام نوع ناتج_مواقع_دوارف = {
    المتغيرات: متجه اختيار غير_موقع
};

نوع مدى_موقع_مطلق_دوارف = {
    البداية: غير_موقع,
    النهاية: غير_موقع,
    الموقع: موقع_قيمة_دوارف
};

عرف اجمع_مواقع_دوارف(
    المواضع: &متجه موضع_دالة_دوارف,
    آلة: &سياق_تصحيح_آلة,
    عدد_المتغيرات: غير_موقع
): متجه متجه مدى_موقع_مطلق_دوارف {
    دع مجمعة: متغير متجه متجه مدى_موقع_مطلق_دوارف = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_المتغيرات) { دع فارغ: متجه مدى_موقع_مطلق_دوارف = []; ألحق(مجمعة, فارغ); ف := ف + 1; }
    دع أوصاف_فارغة: متجه وصف_دالة_دوارف = [];
    دع مديات_فارغة: متجه مدى_شفرة_آلة_بأصل = [];
    دع فهرس_الدوال: فهرس_دوال_دوارف = ابن_فهرس_دوال_دوارف(المواضع, &أوصاف_فارغة, &مديات_فارغة);
    ف := 0;
    بينما (ف < (الطول((*آلة).الدوال) مثل غير_موقع)) {
        دع دالة_الآلة: &تصحيح_دالة_آلة = &(*آلة).الدوال[ف];
        طابق فهرس_موضع_دالة_دوارف(&فهرس_الدوال, (*دالة_الآلة).الدالة) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(فهرس_الموضع) -> {
            دع موضع_الدالة: &موضع_دالة_دوارف = &(*المواضع)[فهرس_الموضع];
            دع م: متغير غير_موقع = 0;
            بينما (م < (الطول((*دالة_الآلة).مديات_المواقع) مثل غير_موقع)) {
                دع المدى: &مدى_موقع_آلة_تصحيح = &(*دالة_الآلة).مديات_المواقع[م];
                دع معرف_المتغير: غير_موقع = (*المدى).المتغير.القيمة;
                لو (معرف_المتغير < عدد_المتغيرات) {
                    دع الموقع: موقع_قيمة_دوارف = موقع_دوارف_من_موقع_آلة(&(*المدى).الموقع);
                    دع البداية: غير_موقع = (*موضع_الدالة).إزاحة_بايت + (*المدى).بداية_بايت;
                    دع النهاية: غير_موقع = (*موضع_الدالة).إزاحة_بايت + (*المدى).نهاية_بايت;
                    دع المطلق: مدى_موقع_مطلق_دوارف = {
                        البداية: البداية,
                        النهاية: النهاية,
                        الموقع: الموقع
                    };
                    ألحق(مجمعة[معرف_المتغير], المطلق);
                };
                م := م + 1;
            }
        };
        ف := ف + 1;
    }
    أرجع مجمعة;
}

عرف ألحق_مدخل_موقع_قديم_دوارف(
    ب: &متغير متجه غ8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    السياسة: &سياسة_دوارف,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    الموقع: &موقع_قيمة_دوارف
): منطقي {
    لو (النهاية <= البداية) { أرجع خطأ; };
    طابق ابن_تعبير_موقع_دوارف(الموقع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(التعبير) -> {
        ألحق_مرجع_عنوان_دوارف(ب, الرقع, قسم_عنوان_دوارف.مواقع(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), البداية);
        ألحق_مرجع_عنوان_دوارف(ب, الرقع, قسم_عنوان_دوارف.مواقع(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), النهاية);
        ألحق_غ16_دوارف(ب, الطول(التعبير) مثل غير_موقع);
        ألحق_بايتات_دوارف(ب, &التعبير);
        أرجع صواب;
    };
}

عرف ألحق_مدخل_موقع_حديث_دوارف(
    ب: &متغير متجه غ8,
    العناوين: &متغير جدول_عناوين_دوارف,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    الموقع: &موقع_قيمة_دوارف
): منطقي {
    لو (النهاية <= البداية) { أرجع خطأ; };
    طابق ابن_تعبير_موقع_دوارف(الموقع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(التعبير) -> {
        دع فهرس_العنوان: غير_موقع = أدرج_عنوان_نص_دوارف(العناوين, البداية);
        ألحق_غ8_دوارف(ب, رمز_مدخل_موقع_دوارف(نوع_مدخل_موقع_دوارف.عنوان_مفهرس_وطول()));
        ألحق_ليب128_دوارف(ب, فهرس_العنوان);
        ألحق_ليب128_دوارف(ب, النهاية - البداية);
        ألحق_ليب128_دوارف(ب, الطول(التعبير) مثل غير_موقع);
        ألحق_بايتات_دوارف(ب, &التعبير);
        أرجع صواب;
    };
}

عام عرف ابن_مواقع_دوارف_من_آلة(
    المواضع: &متجه موضع_دالة_دوارف,
    آلة: &سياق_تصحيح_آلة,
    عدد_المتغيرات: غير_موقع,
    السياسة: &سياسة_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف,
    المواقع_القديمة: &متغير متجه غ8,
    قوائم_المواقع: &متغير متجه غ8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف
): ناتج_مواقع_دوارف {
    دع مجمعة: متجه متجه مدى_موقع_مطلق_دوارف = اجمع_مواقع_دوارف(المواضع, آلة, عدد_المتغيرات);
    دع الناتج: متغير متجه اختيار غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_المتغيرات) { ألحق(الناتج, اختيار.لا_شيء()); ف := ف + 1; }

    لو (!(*السياسة).حديث) {
        ف := 0;
        بينما (ف < عدد_المتغيرات) {
            دع البداية: غير_موقع = الطول(*المواقع_القديمة) مثل غير_موقع;
            دع صدر: متغير منطقي = خطأ;
            دع م: متغير غير_موقع = 0;
            بينما (م < (الطول(مجمعة[ف]) مثل غير_موقع)) {
                لو (ألحق_مدخل_موقع_قديم_دوارف(المواقع_القديمة, الرقع, السياسة, مجمعة[ف][م].البداية, مجمعة[ف][م].النهاية, &مجمعة[ف][م].الموقع)) { صدر := صواب; };
                م := م + 1;
            }
            لو (صدر) {
                دع ك: متغير غير_موقع = 0;
                بينما (ك < (*السياسة).حجم_العنوان * 2) { ألحق_غ8_دوارف(المواقع_القديمة, 0); ك := ك + 1; }
                الناتج[ف] := اختيار.بعض(البداية);
            };
            ف := ف + 1;
        }
        دع الخرج: ناتج_مواقع_دوارف = { المتغيرات: الناتج }; أرجع الخرج;
    };

    دع القوائم: متغير متجه متجه غ8 = [];
    ف := 0;
    بينما (ف < عدد_المتغيرات) {
        دع القائمة: متغير متجه غ8 = [];
        دع صدر: متغير منطقي = خطأ;
        دع م: متغير غير_موقع = 0;
        بينما (م < (الطول(مجمعة[ف]) مثل غير_موقع)) {
            لو (ألحق_مدخل_موقع_حديث_دوارف(&متغير القائمة, العناوين, مجمعة[ف][م].البداية, مجمعة[ف][م].النهاية, &مجمعة[ف][م].الموقع)) { صدر := صواب; };
            م := م + 1;
        }
        لو (صدر) {
            ألحق_غ8_دوارف(&متغير القائمة, رمز_مدخل_موقع_دوارف(نوع_مدخل_موقع_دوارف.نهاية()));
            دع الفهرس: غير_موقع = الطول(القوائم) مثل غير_موقع;
            ألحق(القوائم, القائمة);
            الناتج[ف] := اختيار.بعض(الفهرس);
        };
        ف := ف + 1;
    }

    دع بداية_الوحدة: غير_موقع = ابدأ_وحدة_دوارف(قوائم_المواقع, السياسة);
    ألحق_غ16_دوارف(قوائم_المواقع, رمز_إصدار_دوارف((*السياسة).الإصدار));
    ألحق_غ8_دوارف(قوائم_المواقع, (*السياسة).حجم_العنوان);
    ألحق_غ8_دوارف(قوائم_المواقع, 0);
    ألحق_غ32_دوارف(قوائم_المواقع, الطول(القوائم) مثل غير_موقع);
    دع مواضع_الإزاحات: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف < (الطول(القوائم) مثل غير_موقع)) { ألحق(مواضع_الإزاحات, الطول(*قوائم_المواقع) مثل غير_موقع); ألحق_إزاحة_دوارف(قوائم_المواقع, السياسة, 0); ف := ف + 1; }
    دع قاعدة_الإزاحات: غير_موقع = قاعدة_جدول_قوائم_دوارف(السياسة);
    ف := 0;
    بينما (ف < (الطول(القوائم) مثل غير_موقع)) {
        دع بداية_القائمة: غير_موقع = الطول(*قوائم_المواقع) مثل غير_موقع;
        اكتب_إزاحة_دوارف(قوائم_المواقع, السياسة, مواضع_الإزاحات[ف], بداية_القائمة - قاعدة_الإزاحات);
        ألحق_بايتات_دوارف(قوائم_المواقع, &القوائم[ف]);
        ف := ف + 1;
    }
    اختم_وحدة_دوارف(قوائم_المواقع, السياسة, بداية_الوحدة);
    دع الخرج: ناتج_مواقع_دوارف = { المتغيرات: الناتج };
    أرجع الخرج;
}

عام عرف موقع_متغير_دوارف(المواقع: &ناتج_مواقع_دوارف, المتغير: معرف_متغير_تصحيح): اختيار غير_موقع {
    لو (المتغير.القيمة >= (الطول((*المواقع).المتغيرات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*المواقع).المتغيرات[المتغير.القيمة];
}
