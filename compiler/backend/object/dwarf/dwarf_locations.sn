استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_expression;
استورد compiler.backend.object.dwarf.dwarf_unit;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.backend.object.dwarf.dwarf_addresses;
استورد compiler.backend.codegen.debug.model;
استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;

// Variable identity and machine storage are separate. This serializer consumes
// already-materialized PC ranges from compiler/backend/codegen/debug and never rescans
// provenance, allocator assignments, or spill state.
عام نوع ناتج_مواقع_دوارف = {
    المتغيرات: متجه اختياري طبيعي
};

// Only stable references are grouped by variable. Absolute ranges and DWARF
// location expressions are materialized at emission, not retained alongside
// the complete machine-debug ranges for all variables.
نوع مرجع_مدى_موقع_دوارف = {
    دالة_الآلة: طبيعي,
    موضع_الدالة: طبيعي,
    المدى: طبيعي
};

نوع مدى_موقع_مطلق_دوارف = {
    البداية: طبيعي,
    النهاية: طبيعي,
    الموقع: موقع_قيمة_دوارف
};

عرف اجمع_مواقع_دوارف(
    المواضع: &متجه موضع_دالة_دوارف,
    آلة: &سياق_تصحيح_آلة,
    عدد_المتغيرات: طبيعي
): متجه متجه مرجع_مدى_موقع_دوارف {
    دع مجمعة: متغير متجه متجه مرجع_مدى_موقع_دوارف = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_المتغيرات) { دع فارغ: متجه مرجع_مدى_موقع_دوارف = []; ألحق(مجمعة, فارغ); ف := ف + 1; }
    دع أوصاف_فارغة: متجه وصف_دالة_دوارف = [];
    دع مديات_فارغة: متجه مدى_شفرة_آلة_بأصل = [];
    دع فهرس_الدوال: فهرس_دوال_دوارف = ابن_فهرس_دوال_دوارف(المواضع, &أوصاف_فارغة, &مديات_فارغة);
    ف := 0;
    طالما (ف < (الطول((*آلة).الدوال) مثل طبيعي)) {
        دع دالة_الآلة: &تصحيح_دالة_آلة = &(*آلة).الدوال[ف];
        طابق فهرس_موضع_دالة_دوارف(&فهرس_الدوال, (*دالة_الآلة).الدالة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(فهرس_الموضع) -> {
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول((*دالة_الآلة).مديات_المواقع) مثل طبيعي)) {
                دع المدى: &مدى_موقع_آلة_تصحيح = &(*دالة_الآلة).مديات_المواقع[م];
                دع معرف_المتغير: طبيعي = (*المدى).المتغير.القيمة;
                إذا (معرف_المتغير < عدد_المتغيرات) {
                    دع المرجع: مرجع_مدى_موقع_دوارف = {
                        دالة_الآلة: ف, موضع_الدالة: فهرس_الموضع, المدى: م
                    };
                    ألحق(مجمعة[معرف_المتغير], المرجع);
                };
                م := م + 1;
            }
        };
        ف := ف + 1;
    }
    أرجع مجمعة;
}

// Resolve one range at the last possible moment. The only preserved
// grouping is stable positions into the canonical machine-debug owner.
عرف مادة_مدى_موقع_دوارف(
    المواضع: &متجه موضع_دالة_دوارف,
    آلة: &سياق_تصحيح_آلة,
    المرجع: &مرجع_مدى_موقع_دوارف
): مدى_موقع_مطلق_دوارف {
    دع الدالة: &تصحيح_دالة_آلة = &(*آلة).الدوال[(*المرجع).دالة_الآلة];
    دع الموضع: &موضع_دالة_دوارف = &(*المواضع)[(*المرجع).موضع_الدالة];
    دع المدى: &مدى_موقع_آلة_تصحيح = &(*الدالة).مديات_المواقع[(*المرجع).المدى];
    دع الموقع: موقع_قيمة_دوارف = موقع_دوارف_من_موقع_آلة(&(*المدى).الموقع);
    دع الناتج: مدى_موقع_مطلق_دوارف = {
        البداية: (*الموضع).إزاحة_بايت + (*المدى).بداية_بايت,
        النهاية: (*الموضع).إزاحة_بايت + (*المدى).نهاية_بايت,
        الموقع: الموقع
    };
    أرجع الناتج;
}

عرف ألحق_مدخل_موقع_قديم_دوارف(
    ب: &متغير متجه ط8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    السياسة: &سياسة_دوارف,
    البداية: طبيعي,
    النهاية: طبيعي,
    الموقع: &موقع_قيمة_دوارف
): منطقي {
    إذا (النهاية <= البداية) { أرجع خطأ; };
    طابق ابن_تعبير_موقع_دوارف(الموقع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(التعبير) -> {
        ألحق_مرجع_عنوان_دوارف(ب, الرقع, قسم_عنوان_دوارف.مواقع(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), البداية);
        ألحق_مرجع_عنوان_دوارف(ب, الرقع, قسم_عنوان_دوارف.مواقع(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), النهاية);
        ألحق_ط16_دوارف(ب, الطول(التعبير) مثل طبيعي);
        ألحق_بايتات_دوارف(ب, &التعبير);
        أرجع صواب;
    };
}

عرف ألحق_مدخل_موقع_حديث_دوارف(
    ب: &متغير متجه ط8,
    العناوين: &متغير جدول_عناوين_دوارف,
    البداية: طبيعي,
    النهاية: طبيعي,
    الموقع: &موقع_قيمة_دوارف
): منطقي {
    إذا (النهاية <= البداية) { أرجع خطأ; };
    طابق ابن_تعبير_موقع_دوارف(الموقع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(التعبير) -> {
        دع فهرس_العنوان: طبيعي = أدرج_عنوان_نص_دوارف(العناوين, البداية);
        ألحق_ط8_دوارف(ب, رمز_مدخل_موقع_دوارف(نوع_مدخل_موقع_دوارف.عنوان_مفهرس_وطول()));
        ألحق_ليب128_دوارف(ب, فهرس_العنوان);
        ألحق_ليب128_دوارف(ب, النهاية - البداية);
        ألحق_ليب128_دوارف(ب, الطول(التعبير) مثل طبيعي);
        ألحق_بايتات_دوارف(ب, &التعبير);
        أرجع صواب;
    };
}

عام عرف ابن_مواقع_دوارف_من_آلة(
    المواضع: &متجه موضع_دالة_دوارف,
    آلة: &سياق_تصحيح_آلة,
    عدد_المتغيرات: طبيعي,
    السياسة: &سياسة_دوارف,
    العناوين: &متغير جدول_عناوين_دوارف,
    المواقع_القديمة: &متغير متجه ط8,
    قوائم_المواقع: &متغير متجه ط8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف
): ناتج_مواقع_دوارف {
    دع مجمعة: متجه متجه مرجع_مدى_موقع_دوارف = اجمع_مواقع_دوارف(المواضع, آلة, عدد_المتغيرات);
    دع الناتج: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_المتغيرات) { ألحق(الناتج, اختياري.لا_شيء()); ف := ف + 1; }

    إذا (!(*السياسة).حديث) {
        ف := 0;
        طالما (ف < عدد_المتغيرات) {
            دع البداية: طبيعي = الطول(*المواقع_القديمة) مثل طبيعي;
            دع صدر: متغير منطقي = خطأ;
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(مجمعة[ف]) مثل طبيعي)) {
                دع المدى: مدى_موقع_مطلق_دوارف = مادة_مدى_موقع_دوارف(المواضع, آلة, &مجمعة[ف][م]);
                إذا (ألحق_مدخل_موقع_قديم_دوارف(المواقع_القديمة, الرقع, السياسة, المدى.البداية, المدى.النهاية, &المدى.الموقع)) { صدر := صواب; };
                م := م + 1;
            }
            إذا (صدر) {
                دع ك: متغير طبيعي = 0;
                طالما (ك < (*السياسة).حجم_العنوان * 2) { ألحق_ط8_دوارف(المواقع_القديمة, 0); ك := ك + 1; }
                الناتج[ف] := اختياري.موجود(البداية);
            };
            ف := ف + 1;
        }
        دع الخرج: ناتج_مواقع_دوارف = { المتغيرات: الناتج }; أرجع الخرج;
    };

    دع القوائم: متغير متجه متجه ط8 = [];
    ف := 0;
    طالما (ف < عدد_المتغيرات) {
        دع القائمة: متغير متجه ط8 = [];
        دع صدر: متغير منطقي = خطأ;
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(مجمعة[ف]) مثل طبيعي)) {
            دع المدى: مدى_موقع_مطلق_دوارف = مادة_مدى_موقع_دوارف(المواضع, آلة, &مجمعة[ف][م]);
            إذا (ألحق_مدخل_موقع_حديث_دوارف(&متغير القائمة, العناوين, المدى.البداية, المدى.النهاية, &المدى.الموقع)) { صدر := صواب; };
            م := م + 1;
        }
        إذا (صدر) {
            ألحق_ط8_دوارف(&متغير القائمة, رمز_مدخل_موقع_دوارف(نوع_مدخل_موقع_دوارف.نهاية()));
            دع الفهرس: طبيعي = الطول(القوائم) مثل طبيعي;
            ألحق(القوائم, القائمة);
            الناتج[ف] := اختياري.موجود(الفهرس);
        };
        ف := ف + 1;
    }

    دع بداية_الوحدة: طبيعي = ابدأ_وحدة_دوارف(قوائم_المواقع, السياسة);
    ألحق_ط16_دوارف(قوائم_المواقع, رمز_إصدار_دوارف((*السياسة).الإصدار));
    ألحق_ط8_دوارف(قوائم_المواقع, (*السياسة).حجم_العنوان);
    ألحق_ط8_دوارف(قوائم_المواقع, 0);
    ألحق_ط32_دوارف(قوائم_المواقع, الطول(القوائم) مثل طبيعي);
    دع مواضع_الإزاحات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(القوائم) مثل طبيعي)) { ألحق(مواضع_الإزاحات, الطول(*قوائم_المواقع) مثل طبيعي); ألحق_إزاحة_دوارف(قوائم_المواقع, السياسة, 0); ف := ف + 1; }
    دع قاعدة_الإزاحات: طبيعي = قاعدة_جدول_قوائم_دوارف(السياسة);
    ف := 0;
    طالما (ف < (الطول(القوائم) مثل طبيعي)) {
        دع بداية_القائمة: طبيعي = الطول(*قوائم_المواقع) مثل طبيعي;
        اكتب_إزاحة_دوارف(قوائم_المواقع, السياسة, مواضع_الإزاحات[ف], بداية_القائمة - قاعدة_الإزاحات);
        ألحق_بايتات_دوارف(قوائم_المواقع, &القوائم[ف]);
        ف := ف + 1;
    }
    اختم_وحدة_دوارف(قوائم_المواقع, السياسة, بداية_الوحدة);
    دع الخرج: ناتج_مواقع_دوارف = { المتغيرات: الناتج };
    أرجع الخرج;
}

عام عرف موقع_متغير_دوارف(المواقع: &ناتج_مواقع_دوارف, المتغير: معرف_متغير_تصحيح): اختياري طبيعي {
    إذا (المتغير.القيمة >= (الطول((*المواقع).المتغيرات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*المواقع).المتغيرات[المتغير.القيمة];
}
