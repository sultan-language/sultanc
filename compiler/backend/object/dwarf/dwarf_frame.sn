استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_unit;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.backend.target.register_query_context;
استورد compiler.backend.target.target_model;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.call_frame_information;

// .debug_frame consumes ordered call-frame-information events from backend/codegen/call_frame_information. It never
// reverse-engineers prologues, frame sizes, or saved-register placement.
عرف ألحق_تقدم_فك_المكدس_دوارف(
    ب: &متغير متجه ط8,
    الفرق: طبيعي,
    محاذاة_الشفرة: طبيعي
): فراغ {
    لو (الفرق == 0 || محاذاة_الشفرة == 0) { أرجع; };
    دع الوحدات: طبيعي = الفرق / محاذاة_الشفرة;
    لو (الوحدات < 64) { ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.تقدم_موقع_أساس()) | الوحدات); }
    وإلا {
        ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.تقدم_موقع4()));
        ألحق_ط32_دوارف(ب, الوحدات);
    };
}

عرف ألحق_حدث_فك_المكدس_دوارف(
    ب: &متغير متجه ط8,
    الحدث: &حدث_فك_المكدس,
    مقدار_محاذاة_البيانات: طبيعي
): فراغ {
    طابق (*الحدث).الحدث مع
    | نوع_حدث_فك_المكدس.قاعدة_الإطار_حددت(السجل, الإزاحة) -> {
        ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.حدد_قاعدة_الإطار()));
        ألحق_ليب128_دوارف(ب, السجل);
        ألحق_ليب128_دوارف(ب, الإزاحة);
    }
    | نوع_حدث_فك_المكدس.إزاحة_قاعدة_الإطار_تغيرت(الإزاحة) -> {
        ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.إزاحة_قاعدة_الإطار()));
        ألحق_ليب128_دوارف(ب, الإزاحة);
    }
    | نوع_حدث_فك_المكدس.سجل_حفظ(السجل, البعد) -> {
        لو (مقدار_محاذاة_البيانات == 0) { أرجع; };
        دع العامل: طبيعي = البعد / مقدار_محاذاة_البيانات;
        لو (السجل < 64) {
            ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.إزاحة_أساس()) | السجل);
            ألحق_ليب128_دوارف(ب, العامل);
        } وإلا {
            ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.إزاحة_ممتدة()));
            ألحق_ليب128_دوارف(ب, السجل);
            ألحق_ليب128_دوارف(ب, العامل);
        };
    }
    | نوع_حدث_فك_المكدس.سجل_استعيد(السجل) -> {
        لو (السجل < 64) { ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.استعادة_أساس()) | السجل); }
        وإلا { ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.استعادة_ممتدة())); ألحق_ليب128_دوارف(ب, السجل); };
    }
    | نوع_حدث_فك_المكدس.سجل_غير_معرف(السجل) -> {
        ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.غير_معرف()));
        ألحق_ليب128_دوارف(ب, السجل);
    }
    | نوع_حدث_فك_المكدس.سجل_نفس_القيمة(السجل) -> {
        ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.نفس_القيمة()));
        ألحق_ليب128_دوارف(ب, السجل);
    }
    | نوع_حدث_فك_المكدس.احفظ_الحالة -> { ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.احفظ_الحالة())); }
    | نوع_حدث_فك_المكدس.استعد_الحالة -> { ألحق_ط8_دوارف(ب, رمز_تعليمة_معلومات_إطار_النداء_دوارف(تعليمة_معلومات_إطار_النداء_دوارف.استعد_الحالة())); };
}

عام عرف ابن_إطار_دوارف_من_معلومات_إطار_النداء(
    المواضع: &متجه موضع_دالة_دوارف,
    سياق_الفك: &سياق_معلومات_إطار_النداء,
    الهدف: &واصف_هدف,
    السياسة: &سياسة_دوارف,
    البيانات: &متغير متجه ط8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    دع رقم_العودة: طبيعي;
    دع محاذاة_الشفرة: طبيعي;
    دع مقدار_محاذاة_البيانات: طبيعي;
    طابق رقم_سجل_عودة_دوارف_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(القيمة) -> { رقم_العودة := القيمة; };
    طابق محاذاة_شفرة_إطار_دوارف_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(القيمة) -> { محاذاة_الشفرة := القيمة; };
    طابق مقدار_محاذاة_بيانات_إطار_دوارف_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(القيمة) -> { مقدار_محاذاة_البيانات := القيمة; };
    لو (مقدار_محاذاة_البيانات == 0 || مقدار_محاذاة_البيانات > 64) { أرجع; };

    // .debug_frame follows the selected DWARF32/64 offset format, while its
    // encoded code addresses follow the independent Target address width.
    دع بداية_مدخل_المعلومات_المشتركة: طبيعي = الطول(*البيانات) مثل طبيعي;
    دع بداية_طول_المعلومات_المشتركة: طبيعي = ابدأ_وحدة_دوارف(البيانات, السياسة);
    لو ((*السياسة).حجم_الإزاحة == 8) { ألحق_ط64_دوارف(البيانات, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.معرف_مدخل_المعلومات_المشترك64())); }
    وإلا { ألحق_ط32_دوارف(البيانات, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.معرف_مدخل_المعلومات_المشترك32())); };
    ألحق_ط8_دوارف(البيانات, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.إصدار_إطار()));
    ألحق_ط8_دوارف(البيانات, 0);
    ألحق_ط8_دوارف(البيانات, (*السياسة).حجم_العنوان);
    ألحق_ط8_دوارف(البيانات, 0);
    ألحق_ليب128_دوارف(البيانات, محاذاة_الشفرة);
    ألحق_ط8_دوارف(البيانات, 128 - مقدار_محاذاة_البيانات);
    ألحق_ليب128_دوارف(البيانات, رقم_العودة);
    اختم_وحدة_دوارف(البيانات, السياسة, بداية_طول_المعلومات_المشتركة);

    دع أوصاف_فارغة: متجه وصف_دالة_دوارف = [];
    دع مديات_فارغة: متجه مدى_شفرة_آلة_بأصل = [];
    دع فهرس_الدوال: فهرس_دوال_دوارف = ابن_فهرس_دوال_دوارف(المواضع, &أوصاف_فارغة, &مديات_فارغة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*سياق_الفك).الدوال) مثل طبيعي)) {
        دع معلومات_إطار_نداء_الدالة: &بيانات_معلومات_إطار_النداء_لدالة = &(*سياق_الفك).الدوال[ف];
        طابق فهرس_موضع_دالة_دوارف(&فهرس_الدوال, (*معلومات_إطار_نداء_الدالة).الدالة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(فهرس_الموضع) -> {
            دع موضع_الدالة: &موضع_دالة_دوارف = &(*المواضع)[فهرس_الموضع];
            دع بداية_مدخل_إطار_الدالة: طبيعي = ابدأ_وحدة_دوارف(البيانات, السياسة);
            ألحق_مرجع_قسم_دوارف(البيانات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.إطار(), قسم_بيانات_دوارف.إطار(), بداية_مدخل_المعلومات_المشتركة);
            ألحق_مرجع_عنوان_دوارف(
                البيانات, الرقع, قسم_عنوان_دوارف.إطار(), (*السياسة).حجم_العنوان,
                قاعدة_عنوان_دوارف.نص(), (*موضع_الدالة).إزاحة_بايت
            );
            لو ((*السياسة).حجم_العنوان == 8) { ألحق_ط64_دوارف(البيانات, (*موضع_الدالة).حجم_بايت); }
            وإلا { ألحق_ط32_دوارف(البيانات, (*موضع_الدالة).حجم_بايت); };
            دع إزاحة_حالية: متغير طبيعي = 0;
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول((*معلومات_إطار_نداء_الدالة).الأحداث) مثل طبيعي)) {
                دع الحدث: &حدث_فك_المكدس = &(*معلومات_إطار_نداء_الدالة).الأحداث[ح];
                لو ((*الحدث).إزاحة_بايت > إزاحة_حالية) {
                    ألحق_تقدم_فك_المكدس_دوارف(البيانات, (*الحدث).إزاحة_بايت - إزاحة_حالية, محاذاة_الشفرة);
                    إزاحة_حالية := (*الحدث).إزاحة_بايت;
                };
                ألحق_حدث_فك_المكدس_دوارف(البيانات, الحدث, مقدار_محاذاة_البيانات);
                ح := ح + 1;
            }
            اختم_وحدة_دوارف(البيانات, السياسة, بداية_مدخل_إطار_الدالة);
        };
        ف := ف + 1;
    }
}
