استورد compiler.backend.object.dwarf.dwarf_constants;

// DWARF-specific output options belong to the DWARF producer, not to the
// target-neutral source debuginfo model.
عام نوع خيارات_دوارف = {
    الإصدار: إصدار_دوارف,
    صيغة_الإزاحة: صيغة_إزاحة_دوارف,
    توليد_أسماء: منطقي,
    توليد_إطار: منطقي
};

عام عرف خيارات_دوارف_افتراضية(): خيارات_دوارف {
    دع الإصدار: إصدار_دوارف = إصدار_دوارف.خمسة();
    دع صيغة_الإزاحة: صيغة_إزاحة_دوارف = صيغة_إزاحة_دوارف.دوارف32();
    دع الخيارات: خيارات_دوارف = {
        الإصدار: الإصدار,
        صيغة_الإزاحة: صيغة_الإزاحة,
        توليد_أسماء: صواب,
        توليد_إطار: صواب
    };
    أرجع الخيارات;
}

// Version-specific behavior is centralized here. Serializers consume typed
// protocol choices and convert them to wire integers only when writing bytes.
عام نوع سياسة_دوارف = {
    الإصدار: إصدار_دوارف,
    صيغة_الإزاحة: صيغة_إزاحة_دوارف,
    حجم_الإزاحة: غير_موقع,
    حجم_العنوان: غير_موقع,
    حديث: منطقي,
    صيغة_الاسم: صيغة_دوارف,
    صيغة_العنوان: صيغة_دوارف,
    صيغة_الموقع: صيغة_دوارف,
    صيغة_النطاق: صيغة_دوارف,
    صيغة_مرجع_النوع: صيغة_دوارف
};

عام عرف ابن_سياسة_دوارف(الخيارات: &خيارات_دوارف, حجم_العنوان: غير_موقع): سياسة_دوارف {
    دع حديث: متغير منطقي = خطأ;
    دع صيغة_الاسم: متغير صيغة_دوارف = صيغة_دوارف.سلسلة_ضمنية();
    دع صيغة_العنوان: متغير صيغة_دوارف = صيغة_دوارف.عنوان();
    دع صيغة_الموقع: متغير صيغة_دوارف = صيغة_دوارف.إزاحة_قسم();
    دع صيغة_النطاق: متغير صيغة_دوارف = صيغة_دوارف.إزاحة_قسم();
    طابق (*الخيارات).الإصدار مع
    | إصدار_دوارف.أربعة -> { }
    | إصدار_دوارف.خمسة -> {
        حديث := صواب;
        صيغة_الاسم := صيغة_دوارف.مرجع_سلسلة();
        صيغة_العنوان := صيغة_دوارف.عنوان_مفهرس();
        صيغة_الموقع := صيغة_دوارف.قائمة_موقع_مفهرسة();
        صيغة_النطاق := صيغة_دوارف.قائمة_نطاق_مفهرسة();
    };

    دع حجم_الإزاحة: متغير غير_موقع = 4;
    دع صيغة_مرجع_النوع: متغير صيغة_دوارف = صيغة_دوارف.مرجع4();
    طابق (*الخيارات).صيغة_الإزاحة مع
    | صيغة_إزاحة_دوارف.دوارف32 -> { }
    | صيغة_إزاحة_دوارف.دوارف64 -> {
        حجم_الإزاحة := 8;
        صيغة_مرجع_النوع := صيغة_دوارف.مرجع8();
    };

    دع الإصدار: إصدار_دوارف = (*الخيارات).الإصدار;
    دع صيغة_الإزاحة: صيغة_إزاحة_دوارف = (*الخيارات).صيغة_الإزاحة;
    دع السياسة: سياسة_دوارف = {
        الإصدار: الإصدار,
        صيغة_الإزاحة: صيغة_الإزاحة,
        حجم_الإزاحة: حجم_الإزاحة,
        حجم_العنوان: حجم_العنوان,
        حديث: حديث,
        صيغة_الاسم: صيغة_الاسم,
        صيغة_العنوان: صيغة_العنوان,
        صيغة_الموقع: صيغة_الموقع,
        صيغة_النطاق: صيغة_النطاق,
        صيغة_مرجع_النوع: صيغة_مرجع_النوع
    };
    أرجع السياسة;
}

// DWARF4 line/file references are 1-origin. DWARF5 file-table entries are
// indexed from zero; keep that version difference out of semantic producers.
عام عرف فهرس_ملف_دوارف(السياسة: &سياسة_دوارف, معرف_المصدر: غير_موقع): غير_موقع {
    لو ((*السياسة).حديث) { أرجع معرف_المصدر; };
    أرجع معرف_المصدر + 1;
}

عام عرف قاعدة_جدول_عناوين_دوارف(السياسة: &سياسة_دوارف): غير_موقع {
    لو ((*السياسة).حجم_الإزاحة == 8) { أرجع 16; };
    أرجع 8;
}

عام عرف قاعدة_جدول_قوائم_دوارف(السياسة: &سياسة_دوارف): غير_موقع {
    لو ((*السياسة).حجم_الإزاحة == 8) { أرجع 20; };
    أرجع 12;
}
