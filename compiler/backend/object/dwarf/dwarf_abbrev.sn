استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.backend.object.dwarf.dwarf_policy;

// Abbreviations remain typed until their single serialization boundary.
عام نوع زوج_اختصار_دوارف = {
    السمة: سمة_دوارف,
    الصيغة: صيغة_دوارف
};

عام نوع وصف_اختصار_دوارف = {
    الرمز: طبيعي,
    الوسم: وسم_دوارف,
    الأطفال: أطفال_دوارف,
    الأزواج: متجه زوج_اختصار_دوارف
};

نوع باني_اختصارات_دوارف = {
    الحالي: وصف_اختصار_دوارف
};

عرف باني_اختصارات_دوارف_جديد(): باني_اختصارات_دوارف {
    دع الأزواج: متجه زوج_اختصار_دوارف = [];
    دع وسم_الوحدة: وسم_دوارف = وسم_دوارف.وحدة_ترجمة();
    دع بلا_أطفال: أطفال_دوارف = أطفال_دوارف.لا();
    دع الحالي: وصف_اختصار_دوارف = {
        الرمز: 0,
        الوسم: وسم_الوحدة,
        الأطفال: بلا_أطفال,
        الأزواج: الأزواج
    };
    دع الباني: باني_اختصارات_دوارف = { الحالي: الحالي };
    أرجع الباني;
}

عرف ابدأ_اختصارا_دوارف(
    ب: &متغير باني_اختصارات_دوارف,
    الرمز: طبيعي,
    الوسم: وسم_دوارف,
    الأطفال: أطفال_دوارف
): فراغ {
    دع الأزواج: متجه زوج_اختصار_دوارف = [];
    دع الوصف: وصف_اختصار_دوارف = {
        الرمز: الرمز, الوسم: الوسم, الأطفال: الأطفال, الأزواج: الأزواج
    };
    (*ب).الحالي := الوصف;
}

عرف ألحق_زوج_اختصار_دوارف(
    ب: &متغير باني_اختصارات_دوارف,
    السمة: سمة_دوارف,
    الصيغة: صيغة_دوارف
): فراغ {
    دع الزوج: زوج_اختصار_دوارف = { السمة: السمة, الصيغة: الصيغة };
    ألحق((*ب).الحالي.الأزواج, الزوج);
}

عرف اختم_اختصارا_دوارف(
    ب: &متغير باني_اختصارات_دوارف,
    البيانات: &متغير متجه ط8
): فراغ {
    دع الرمز: طبيعي = (*ب).الحالي.الرمز;
    دع الوسم: وسم_دوارف = (*ب).الحالي.الوسم;
    دع الأطفال: أطفال_دوارف = (*ب).الحالي.الأطفال;
    ألحق_ليب128_دوارف(البيانات, الرمز);
    ألحق_ليب128_دوارف(البيانات, رمز_وسم_دوارف(الوسم));
    ألحق_ط8_دوارف(البيانات, رمز_أطفال_دوارف(الأطفال));
    دع عدد_الأزواج: طبيعي = الطول((*ب).الحالي.الأزواج) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأزواج) {
        دع السمة: سمة_دوارف = (*ب).الحالي.الأزواج[ف].السمة;
        دع الصيغة: صيغة_دوارف = (*ب).الحالي.الأزواج[ف].الصيغة;
        ألحق_ليب128_دوارف(البيانات, رمز_سمة_دوارف(السمة));
        ألحق_ليب128_دوارف(البيانات, رمز_صيغة_دوارف(الصيغة));
        ف := ف + 1;
    }
    ألحق_ط8_دوارف(البيانات, 0);
    ألحق_ط8_دوارف(البيانات, 0);
}

عام عرف ابن_اختصارات_دوارف(السياسة: &سياسة_دوارف): متجه ط8 {
    دع ب: متغير باني_اختصارات_دوارف = باني_اختصارات_دوارف_جديد();
    دع البيانات: متغير متجه ط8 = [];
    دع صيغة_اسم: صيغة_دوارف = (*السياسة).صيغة_الاسم;
    دع صيغة_نوع: صيغة_دوارف = (*السياسة).صيغة_مرجع_النوع;

    // 1: compile unit. DWARF5 owns indexed table bases; v4 owns low/high PC directly.
    ابدأ_اختصارا_دوارف(&متغير ب, 1, وسم_دوارف.وحدة_ترجمة(), أطفال_دوارف.نعم());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.المنتج(), صيغة_اسم);
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.اللغة(), صيغة_دوارف.بيانات2());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم);
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.قائمة_السطور(), صيغة_دوارف.إزاحة_قسم());
    إذا ((*السياسة).حديث) {
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.قاعدة_العناوين(), صيغة_دوارف.إزاحة_قسم());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.قاعدة_قوائم_المواقع(), صيغة_دوارف.إزاحة_قسم());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.قاعدة_قوائم_النطاقات(), صيغة_دوارف.إزاحة_قسم());
    } وإلا {
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.بداية_العنوان(), صيغة_دوارف.عنوان());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.نهاية_العنوان(), صيغة_دوارف.بيانات8());
    };
    اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);

    // 2/3: subprogram without/with result type.
    دع ك: متغير طبيعي = 2;
    طالما (ك <= 3) {
        // No DW_AT_linkage_name: a defined function's symbol is a synthesized
        // sultanc_fn_* name, and gdb and lldb name a function by its linkage
        // name when it has one, so breakpoints by source name would not resolve.
        ابدأ_اختصارا_دوارف(&متغير ب, ك, وسم_دوارف.دالة(), أطفال_دوارف.نعم());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم);
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.ملف_التصريح(), صيغة_دوارف.بيانات_ليب());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.سطر_التصريح(), صيغة_دوارف.بيانات_ليب());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.عمود_التصريح(), صيغة_دوارف.بيانات_ليب());
        إذا (ك == 3) { ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.النوع(), صيغة_نوع); };
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.بداية_العنوان(), (*السياسة).صيغة_العنوان);
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.نهاية_العنوان(), صيغة_دوارف.بيانات8());
        // The frame base is the CFA (DW_OP_call_frame_cfa): frame-slot
        // locations are DW_OP_fbreg offsets from it.
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.قاعدة_الإطار(), صيغة_دوارف.تعبير_موقع());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.خارجي(), صيغة_دوارف.علم());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.إعلان(), صيغة_دوارف.علم());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.اصطناعي(), صيغة_دوارف.علم());
        اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات); ك := ك + 1;
    }

    // 4/5: formal parameter without/with location list.
    ك := 4;
    طالما (ك <= 5) {
        ابدأ_اختصارا_دوارف(&متغير ب, ك, وسم_دوارف.معامل(), أطفال_دوارف.لا());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم);
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.ملف_التصريح(), صيغة_دوارف.بيانات_ليب());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.سطر_التصريح(), صيغة_دوارف.بيانات_ليب());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.عمود_التصريح(), صيغة_دوارف.بيانات_ليب());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.النوع(), صيغة_نوع);
        إذا (ك == 5) { ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الموقع(), (*السياسة).صيغة_الموقع); };
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.اصطناعي(), صيغة_دوارف.علم());
        اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات); ك := ك + 1;
    }

    ابدأ_اختصارا_دوارف(&متغير ب, 6, وسم_دوارف.نوع_أساسي(), أطفال_دوارف.لا());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم);
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الترميز(), صيغة_دوارف.بيانات1());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الحجم_بايت(), صيغة_دوارف.بيانات_ليب()); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);

    ك := 7;
    طالما (ك <= 8) {
        دع الوسم: متغير وسم_دوارف = وسم_دوارف.نوع_مؤشر(); إذا (ك == 8) { الوسم := وسم_دوارف.نوع_مرجع(); };
        ابدأ_اختصارا_دوارف(&متغير ب, ك, الوسم, أطفال_دوارف.لا());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم);
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الحجم_بايت(), صيغة_دوارف.بيانات_ليب());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.النوع(), صيغة_نوع); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات); ك := ك + 1;
    }

    ابدأ_اختصارا_دوارف(&متغير ب, 9, وسم_دوارف.نوع_بنية(), أطفال_دوارف.نعم());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الحجم_بايت(), صيغة_دوارف.بيانات_ليب()); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);
    ابدأ_اختصارا_دوارف(&متغير ب, 10, وسم_دوارف.نوع_غير_محدد(), أطفال_دوارف.لا()); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);

    // 11: contiguous lexical block; 30: DWARF5 disjoint lexical block.
    ابدأ_اختصارا_دوارف(&متغير ب, 11, وسم_دوارف.نطاق_معجمي(), أطفال_دوارف.نعم());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.بداية_العنوان(), (*السياسة).صيغة_العنوان); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.نهاية_العنوان(), صيغة_دوارف.بيانات8()); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);
    إذا ((*السياسة).حديث) {
        ابدأ_اختصارا_دوارف(&متغير ب, 30, وسم_دوارف.نطاق_معجمي(), أطفال_دوارف.نعم());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.النطاقات(), (*السياسة).صيغة_النطاق); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);
    };

    // 31: an inlined call over one contiguous range; 32 (DWARF 5): over
    // several. abstract_origin is the inlined function's subprogram DIE.
    ابدأ_اختصارا_دوارف(&متغير ب, 31, وسم_دوارف.دالة_مضمنة(), أطفال_دوارف.نعم());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.أصل_مجرد(), صيغة_نوع);
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.بداية_العنوان(), (*السياسة).صيغة_العنوان);
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.نهاية_العنوان(), صيغة_دوارف.بيانات8());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.ملف_الاستدعاء(), صيغة_دوارف.بيانات_ليب());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.سطر_الاستدعاء(), صيغة_دوارف.بيانات_ليب());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.عمود_الاستدعاء(), صيغة_دوارف.بيانات_ليب());
    اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);
    إذا ((*السياسة).حديث) {
        ابدأ_اختصارا_دوارف(&متغير ب, 32, وسم_دوارف.دالة_مضمنة(), أطفال_دوارف.نعم());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.أصل_مجرد(), صيغة_نوع);
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.النطاقات(), (*السياسة).صيغة_النطاق);
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.ملف_الاستدعاء(), صيغة_دوارف.بيانات_ليب());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.سطر_الاستدعاء(), صيغة_دوارف.بيانات_ليب());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.عمود_الاستدعاء(), صيغة_دوارف.بيانات_ليب());
        اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);
    };
    // 33: the abstract instance of a function that exists only inlined.
    ابدأ_اختصارا_دوارف(&متغير ب, 33, وسم_دوارف.دالة(), أطفال_دوارف.لا());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم);
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.ملف_التصريح(), صيغة_دوارف.بيانات_ليب());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.سطر_التصريح(), صيغة_دوارف.بيانات_ليب());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.عمود_التصريح(), صيغة_دوارف.بيانات_ليب());
    ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.مضمن(), صيغة_دوارف.بيانات1());
    اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);

    ك := 12;
    طالما (ك <= 13) {
        ابدأ_اختصارا_دوارف(&متغير ب, ك, وسم_دوارف.متغير(), أطفال_دوارف.لا());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم);
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.ملف_التصريح(), صيغة_دوارف.بيانات_ليب()); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.سطر_التصريح(), صيغة_دوارف.بيانات_ليب()); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.عمود_التصريح(), صيغة_دوارف.بيانات_ليب());
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.النوع(), صيغة_نوع);
        إذا (ك == 13) { ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الموقع(), (*السياسة).صيغة_الموقع); };
        ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.اصطناعي(), صيغة_دوارف.علم()); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات); ك := ك + 1;
    }

    ابدأ_اختصارا_دوارف(&متغير ب, 14, وسم_دوارف.عضو(), أطفال_دوارف.لا()); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.الاسم(), صيغة_اسم); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.النوع(), صيغة_نوع); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.إزاحة_عضو(), صيغة_دوارف.بيانات_ليب()); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);
    ابدأ_اختصارا_دوارف(&متغير ب, 15, وسم_دوارف.جزء_بدائل(), أطفال_دوارف.نعم()); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.المميز(), صيغة_نوع); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);
    // 16/37: a variant with payload members and one without; unnamed, as
    // DWARF has variants (the members carry the constructor's name).
    ابدأ_اختصارا_دوارف(&متغير ب, 16, وسم_دوارف.بديل(), أطفال_دوارف.نعم()); ألحق_زوج_اختصار_دوارف(&متغير ب, سمة_دوارف.قيمة_المميز(), صيغة_دوارف.بيانات_ليب()); اختم_اختصارا_دوارف(&متغير ب, &متغير البيانات);
