عرف ابحث_نوع_تصحيح_دلالي_لدوارف(السياق: &سياق_تصحيح, النوع: معرف_نوع): اختياري معرف_نوع_تصحيح {
    طابق معرف_نوع_تصحيح_لنوع(السياق, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> {
        لو (المعرف.القيمة >= (الطول((*السياق).الأنواع) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(المعرف);
    };
}

عرف ابحث_نوع_تصحيح_برمز_لدوارف(السياق: &سياق_تصحيح, الرمز: معرف_رمز): اختياري معرف_نوع_تصحيح {
    طابق معرف_نوع_تصحيح_لرمز(السياق, الرمز) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> {
        لو (المعرف.القيمة >= (الطول((*السياق).الأنواع) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(المعرف);
    };
}

عرف ألحق_إحداثي_نوع_دوارف(
    ب: &متغير متجه ط8,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر,
    السياسة: &سياسة_دوارف
): فراغ {
    طابق أصل_مصدر_بالمعرف(سجل_الأصول, الأصل) مع
    | اختياري.لا_شيء -> {
        ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0);
    }
    | اختياري.موجود(وصف_الأصل) -> {
        دع الملف: طبيعي = فهرس_ملف_دوارف(السياسة, وصف_الأصل.النطاق.البداية.المصدر);
        طابق إحداثي_من_الخريطة(الخريطة, وصف_الأصل.النطاق.البداية) مع
        | اختياري.لا_شيء -> {
            ألحق_ليب128_دوارف(ب, الملف); ألحق_ليب128_دوارف(ب, 0); ألحق_ليب128_دوارف(ب, 0);
        }
        | اختياري.موجود(الإحداثي) -> {
            ألحق_ليب128_دوارف(ب, الملف);
            ألحق_ليب128_دوارف(ب, الإحداثي.السطر مثل طبيعي);
            دع العمود: طبيعي = الإحداثي.العمود مثل طبيعي;
            ألحق_ليب128_دوارف(ب, العمود + 1);
        };
    };
}

عرف بايتات_نص_دوارف_أصلي(النص: &نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        ألحق(الناتج, (*النص)[ف] مثل ط8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف رقم_سداسي_دوارف_أصلي(القيمة: طبيعي): ط8 {
    لو (القيمة < 10) { أرجع (0x30 + القيمة) مثل ط8; };
    أرجع (0x61 + (القيمة - 10)) مثل ط8;
}

عرف اسم_نوع_دوارف_مولد(المعرف: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = بايتات_من_نص(«type#»);
    دع القاسم: متغير طبيعي = 0x1000000000000000;
    دع بدأ: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 16) {
        دع المقسوم: طبيعي = المعرف / القاسم;
        دع الرقم: طبيعي = المقسوم % 16;
        لو (الرقم != 0 || بدأ || ف == 15) {
            ألحق(الناتج, رقم_سداسي_دوارف_أصلي(الرقم));
            بدأ := صواب;
        };
        لو (القاسم > 1) { القاسم := القاسم / 16; };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ألحق_فهرس_سداسي_دوارف_أصلي(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع القاسم: متغير طبيعي = 0x1000000000000000;
    دع بدأ: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 16) {
        دع المقسوم: طبيعي = القيمة / القاسم;
        دع الرقم: طبيعي = المقسوم % 16;
        لو (الرقم != 0 || بدأ || ف == 15) {
            ألحق(*الناتج, رقم_سداسي_دوارف_أصلي(الرقم));
            بدأ := صواب;
        };
        لو (القاسم > 1) { القاسم := القاسم / 16; };
        ف := ف + 1;
    }
}

عرف اسم_عضو_دوارف_مولد(الفهرس: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = بايتات_من_نص(«field#»);
    ألحق_فهرس_سداسي_دوارف_أصلي(&متغير الناتج, الفهرس);
    أرجع الناتج;
}

عرف اسم_بديل_دوارف_مولد(الفهرس: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = بايتات_من_نص(«variant#»);
    ألحق_فهرس_سداسي_دوارف_أصلي(&متغير الناتج, الفهرس);
    أرجع الناتج;
}

عرف اسم_عضو_دوارف_من_تصحيح(
    السياق: &سياق_تصحيح,
    معرف_التصحيح: &اختياري معرف_نوع_تصحيح,
    الفهرس: طبيعي
): متجه ط8 {
    طابق *معرف_التصحيح مع
    | اختياري.موجود(المعرف) -> {
        دع الوصف: &نوع_تصحيح = &(*السياق).الأنواع[المعرف.القيمة];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الوصف).الأعضاء) مثل طبيعي)) {
            دع العضو: &اسم_عضو_تصحيح_نوع = &(*الوصف).الأعضاء[ف];
            لو ((*العضو).الفهرس == الفهرس) { أرجع انسخ_اسم_تصحيح(&(*العضو).الاسم); };
            ف := ف + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    أرجع اسم_عضو_دوارف_مولد(الفهرس);
}

عرف اسم_بديل_دوارف_من_تصحيح(
    السياق: &سياق_تصحيح,
    معرف_التصحيح: &اختياري معرف_نوع_تصحيح,
    الفهرس: طبيعي
): متجه ط8 {
    طابق *معرف_التصحيح مع
    | اختياري.موجود(المعرف) -> {
        دع الوصف: &نوع_تصحيح = &(*السياق).الأنواع[المعرف.القيمة];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الوصف).البدائل) مثل طبيعي)) {
            دع البديل: &اسم_بديل_تصحيح_نوع = &(*الوصف).البدائل[ف];
            لو ((*البديل).الفهرس == الفهرس) { أرجع انسخ_اسم_تصحيح(&(*البديل).الاسم); };
            ف := ف + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    أرجع اسم_بديل_دوارف_مولد(الفهرس);
}

عرف اسم_حمولة_دوارف_من_بديل(اسم_البديل: &متجه ط8, الحمولة: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = انسخ_اسم_تصحيح(اسم_البديل);
    دع الوسط: متجه ط8 = بايتات_من_نص(«.payload#»);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الوسط) مثل طبيعي)) { ألحق(الناتج, الوسط[ف]); ف := ف + 1; }
    ألحق_فهرس_سداسي_دوارف_أصلي(&متغير الناتج, الحمولة);
    أرجع الناتج;
}

عرف هوية_نوع_وسم_دوارف(الحجم: طبيعي): طبيعي {
    لو (الحجم == 1) { أرجع رقم_نوع_بدائي(نوع_بدائي_مقنن.ط8()); };
    لو (الحجم == 2) { أرجع رقم_نوع_بدائي(نوع_بدائي_مقنن.ط16()); };
    لو (الحجم == 4) { أرجع رقم_نوع_بدائي(نوع_بدائي_مقنن.ط32()); };
    أرجع رقم_نوع_بدائي(نوع_بدائي_مقنن.ط64());
}

عرف ابن_تفاصيل_مركب_دوارف(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    التخطيط: &واصف_تخطيط,
    سياق_التصحيح: &سياق_تصحيح,
    معرف_التصحيح: &اختياري معرف_نوع_تصحيح
): صنف_نوع_دوارف {
    دع الأعضاء: متغير متجه وصف_عضو_دوارف = [];
    دع البدائل: متغير متجه وصف_بديل_دوارف = [];
    دع المميز: متغير اختياري وصف_مميز_بدائل_دوارف = اختياري.لا_شيء();
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.صف(المواضع) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المواضع) مثل طبيعي)) {
            طابق عنصر_صف_عند(الأنواع, المعرف, المواضع[ف].الفهرس) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(نوع_العضو) -> {
                دع اسم_العضو: متجه ط8 = اسم_عضو_دوارف_من_تصحيح(سياق_التصحيح, معرف_التصحيح, المواضع[ف].الفهرس);
                دع العضو: وصف_عضو_دوارف = {
                    الاسم: اسم_العضو,
                    هوية_النوع: نوع_العضو.القيمة,
                    إزاحة_بايت: المواضع[ف].الإزاحة
                };
                ألحق(الأعضاء, العضو);
            };
            ف := ف + 1;
        }
    }
    | تفاصيل_تخطيط.سجل(المواضع) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المواضع) مثل طبيعي)) {
            طابق حقل_سجل_عند(الأنواع, المعرف, المواضع[ف].الفهرس) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الحقل) -> {
                دع نوع_الحقل: معرف_نوع = نوع_حقل_سجل(&الحقل);
                دع اسم_العضو: متجه ط8 = اسم_عضو_دوارف_من_تصحيح(سياق_التصحيح, معرف_التصحيح, المواضع[ف].الفهرس);
                دع العضو: وصف_عضو_دوارف = {
                    الاسم: اسم_العضو,
                    هوية_النوع: نوع_الحقل.القيمة,
                    إزاحة_بايت: المواضع[ف].الإزاحة
                };
                ألحق(الأعضاء, العضو);
            };
            ف := ف + 1;
        }
    }
    | تفاصيل_تخطيط.تعداد(تفاصيل_التعداد) -> {
        دع اسم_عضو_المميز: متجه ط8 = بايتات_من_نص(«$tag»);
        دع هوية_الوسم: طبيعي = هوية_نوع_وسم_دوارف(تفاصيل_التعداد.الوسم.الحجم);
        دع عضو_المميز: وصف_عضو_دوارف = {
            الاسم: اسم_عضو_المميز,
            هوية_النوع: هوية_الوسم,
            إزاحة_بايت: تفاصيل_التعداد.الوسم.الإزاحة
        };
        ألحق(الأعضاء, عضو_المميز);
        دع اسم_وصف_المميز: متجه ط8 = بايتات_من_نص(«$tag»);
        دع وصف_المميز: وصف_مميز_بدائل_دوارف = {
            الاسم: اسم_وصف_المميز,
            هوية_النوع: هوية_الوسم,
            إزاحة_بايت: تفاصيل_التعداد.الوسم.الإزاحة
        };
        المميز := اختياري.موجود(وصف_المميز);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(تفاصيل_التعداد.المنشئات) مثل طبيعي)) {
            دع اسم_البديل: متجه ط8 = اسم_بديل_دوارف_من_تصحيح(سياق_التصحيح, معرف_التصحيح, ف);
            دع أعضاء_البديل: متغير متجه وصف_عضو_دوارف = [];
            طابق منشئ_نوع_عند(الأنواع, المعرف, ف) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المنشئ) -> {
                دع ح: متغير طبيعي = 0;
                طالما (ح < (الطول(تفاصيل_التعداد.المنشئات[ف].الحمولات) مثل طبيعي)) {
                    طابق حمولة_منشئ_عند(&المنشئ, ح) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(نوع_الحمولة) -> {
                        دع اسم_الحمولة: متجه ط8 = اسم_حمولة_دوارف_من_بديل(&اسم_البديل, ح);
                        دع إزاحة_الحمولة: طبيعي = تفاصيل_التعداد.مخزن_الحمولة.الإزاحة + تفاصيل_التعداد.المنشئات[ف].الحمولات[ح].الإزاحة;
                        دع العضو: وصف_عضو_دوارف = {
                            الاسم: اسم_الحمولة,
                            هوية_النوع: نوع_الحمولة.القيمة,
                            إزاحة_بايت: إزاحة_الحمولة
                        };
                        ألحق(أعضاء_البديل, العضو);
                    };
                    ح := ح + 1;
                }
            };
            دع البديل: وصف_بديل_دوارف = {
                الاسم: اسم_البديل,
                القيمة: تفاصيل_التعداد.المنشئات[ف].قيمة_الوسم,
                الأعضاء: أعضاء_البديل
            };
            ألحق(البدائل, البديل);
            ف := ف + 1;
        }
    }
    | _ -> { };
    أرجع صنف_نوع_دوارف.مركب(الأعضاء, المميز, البدائل);
}

عرف ابن_تفاصيل_متجه_دوارف(
    التخطيط: &واصف_تخطيط,
    هوية_مؤشر_البيانات: طبيعي
): صنف_نوع_دوارف {
    دع الأعضاء: متغير متجه وصف_عضو_دوارف = [];
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.سجل(المواضع) -> {
        لو ((الطول(المواضع) مثل طبيعي) >= 3) {
            دع اسم_البيانات: متجه ط8 = بايتات_من_نص(«data»);
            دع اسم_الطول: متجه ط8 = بايتات_من_نص(«length»);
            دع اسم_السعة: متجه ط8 = بايتات_من_نص(«capacity»);
            دع هوية_الحجم: طبيعي = رقم_نوع_بدائي(نوع_بدائي_مقنن.طبيعي());
            دع عضو_البيانات: وصف_عضو_دوارف = { الاسم: اسم_البيانات, هوية_النوع: هوية_مؤشر_البيانات, إزاحة_بايت: المواضع[0].الإزاحة };
            دع عضو_الطول: وصف_عضو_دوارف = { الاسم: اسم_الطول, هوية_النوع: هوية_الحجم, إزاحة_بايت: المواضع[1].الإزاحة };
            دع عضو_السعة: وصف_عضو_دوارف = { الاسم: اسم_السعة, هوية_النوع: هوية_الحجم, إزاحة_بايت: المواضع[2].الإزاحة };
            ألحق(الأعضاء, عضو_البيانات);
            ألحق(الأعضاء, عضو_الطول);
            ألحق(الأعضاء, عضو_السعة);
        };
    }
    | _ -> { };
    دع بلا_مميز: اختياري وصف_مميز_بدائل_دوارف = اختياري.لا_شيء();
    دع بلا_بدائل: متجه وصف_بديل_دوارف = [];
    أرجع صنف_نوع_دوارف.مركب(الأعضاء, بلا_مميز, بلا_بدائل);
}

عرف صنف_بدائي_لدوارف(البدائي: نوع_بدائي_مقنن): صنف_نوع_دوارف {
    طابق صنف_النوع_البدائي(البدائي) مع
    | صنف_نوع_بدائي.عدد_موقع -> { أرجع صنف_نوع_دوارف.أساسي_موقع(); }
    | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> { أرجع صنف_نوع_دوارف.أساسي_طبيعي(); }
    | صنف_نوع_بدائي.منطقي -> { أرجع صنف_نوع_دوارف.أساسي_منطقي(); }
    | صنف_نوع_بدائي.عشري -> { أرجع صنف_نوع_دوارف.أساسي_عشري(); }
    | صنف_نوع_بدائي.حرف -> { أرجع صنف_نوع_دوارف.أساسي_محرف(); }
    | _ -> { أرجع صنف_نوع_دوارف.غير_محدد(); };
}

عرف ألحق_هوية_نوع_دوارف_إن_جديدة(
    العمل: &متغير متجه طبيعي,
    المرئية: &متغير متجه منطقي,
    الهوية: طبيعي
): فراغ {
    لو (الهوية >= (الطول(*المرئية) مثل طبيعي)) { أرجع; };
    لو ((*المرئية)[الهوية]) { أرجع; };
    (*المرئية)[الهوية] := صواب;
    ألحق(*العمل, الهوية);
}

عرف ألحق_اعتمادات_نوع_دوارف(
    العمل: &متغير متجه طبيعي,
    المرئية: &متغير متجه منطقي,
    الصنف: &صنف_نوع_دوارف
): فراغ {
    طابق *الصنف مع
    | صنف_نوع_دوارف.مؤشر(الداخل) -> { ألحق_هوية_نوع_دوارف_إن_جديدة(العمل, المرئية, الداخل); }
    | صنف_نوع_دوارف.مرجع(الداخل) -> { ألحق_هوية_نوع_دوارف_إن_جديدة(العمل, المرئية, الداخل); }
    | صنف_نوع_دوارف.صندوق(الداخل) -> { ألحق_هوية_نوع_دوارف_إن_جديدة(العمل, المرئية, الداخل); }
    | صنف_نوع_دوارف.اسم_مستعار(الداخل) -> { ألحق_هوية_نوع_دوارف_إن_جديدة(العمل, المرئية, الداخل); }
    | صنف_نوع_دوارف.دالة(المعاملات, الناتج) -> {
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(المعاملات) مثل طبيعي)) { ألحق_هوية_نوع_دوارف_إن_جديدة(العمل, المرئية, المعاملات[م]); م := م + 1; }
        طابق الناتج مع | اختياري.موجود(الداخل) -> { ألحق_هوية_نوع_دوارف_إن_جديدة(العمل, المرئية, الداخل); } | اختياري.لا_شيء -> { };
    }
    | صنف_نوع_دوارف.مركب(الأعضاء, المميز, البدائل) -> {
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول(الأعضاء) مثل طبيعي)) { ألحق_هوية_نوع_دوارف_إن_جديدة(العمل, المرئية, الأعضاء[ع].هوية_النوع); ع := ع + 1; }
        طابق المميز مع
        | اختياري.موجود(الوصف) -> { ألحق_هوية_نوع_دوارف_إن_جديدة(العمل, المرئية, الوصف.هوية_النوع); }
        | اختياري.لا_شيء -> { };
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(البدائل) مثل طبيعي)) {
            ع := 0;
            طالما (ع < (الطول(البدائل[ب].الأعضاء) مثل طبيعي)) {
                ألحق_هوية_نوع_دوارف_إن_جديدة(العمل, المرئية, البدائل[ب].الأعضاء[ع].هوية_النوع);
                ع := ع + 1;
            }
            ب := ب + 1;
        }
    }
    | _ -> { };
}

عام عرف أوصاف_أنواع_دوارف_من_السياق(
    الأنواع: &سجل_أنواع,
    التصحيح: &سياق_تصحيح,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط
): متجه وصف_نوع_دوارف {
    دع عدد_الأنواع: طبيعي = الطول((*الأنواع).الأنواع) مثل طبيعي;
    دع المرئية: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأنواع) { ألحق(المرئية, خطأ); ف := ف + 1; }
    دع العمل: متغير متجه طبيعي = [];
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*التصحيح).الدوال) مثل طبيعي)) {
        طابق (*التصحيح).الدوال[د].الناتج مع
        | اختياري.موجود(النوع) -> { ألحق_هوية_نوع_دوارف_إن_جديدة(&متغير العمل, &متغير المرئية, النوع.القيمة); }
        | اختياري.لا_شيء -> { };
        د := د + 1;
    }
    د := 0;
    طالما (د < (الطول((*التصحيح).المتغيرات) مثل طبيعي)) {
        ألحق_هوية_نوع_دوارف_إن_جديدة(&متغير العمل, &متغير المرئية, (*التصحيح).المتغيرات[د].النوع.القيمة);
        د := د + 1;
    }
    د := 0;
    طالما (د < (الطول((*التصحيح).العوام) مثل طبيعي)) {
        ألحق_هوية_نوع_دوارف_إن_جديدة(&متغير العمل, &متغير المرئية, (*التصحيح).العوام[د].النوع.القيمة);
        د := د + 1;
    }
    د := 0;
    طالما (د < (الطول((*التصحيح).الثوابت) مثل طبيعي)) {
        ألحق_هوية_نوع_دوارف_إن_جديدة(&متغير العمل, &متغير المرئية, (*التصحيح).الثوابت[د].النوع.القيمة);
        د := د + 1;
    }
    // Source aliases are separate DebugTypeIDs but depend on one canonical TypeID.
    د := 0;
    طالما (د < (الطول((*التصحيح).الأنواع) مثل طبيعي)) {
        طابق (*التصحيح).الأنواع[د].اسم_مستعار_لـ مع
        | اختياري.موجود(الهدف_المستعار) -> {
            ألحق_هوية_نوع_دوارف_إن_جديدة(&متغير العمل, &متغير المرئية, الهدف_المستعار.القيمة);
        }
        | اختياري.لا_شيء -> { };
        د := د + 1;
    }
    دع الناتج: متغير متجه وصف_نوع_دوارف = [];
    ف := 0;
    طالما (ف < (الطول(العمل) مثل طبيعي)) {
        دع هوية: طبيعي = العمل[ف];
        دع المعرف: معرف_نوع = معرف_نوع_من(هوية);
        دع الاسم: متغير متجه ط8 = اسم_نوع_دوارف_مولد(هوية);
        دع الصنف: متغير صنف_نوع_دوارف = صنف_نوع_دوارف.غير_محدد();
        دع الحجم: متغير طبيعي = 0;
        دع التخطيط_المكتمل: متغير اختياري واصف_تخطيط = اختياري.لا_شيء();
        دع تصحيح_النوع: اختياري معرف_نوع_تصحيح = ابحث_نوع_تصحيح_دلالي_لدوارف(التصحيح, المعرف);
        دع أصل_النوع: متغير اختياري معرف_أصل_مصدر = اختياري.لا_شيء();
        دع معاملات_النوع: متغير متجه طبيعي = [];
        دع أسماء_معاملات_النوع: متغير متجه متجه ط8 = [];
        دع اصطناعي: متغير منطقي = خطأ;
        طابق تصحيح_النوع مع
        | اختياري.موجود(معرف_التصحيح) -> {
            دع الوصف: &نوع_تصحيح = &(*التصحيح).الأنواع[معرف_التصحيح.القيمة];
            الاسم := انسخ_اسم_تصحيح(&(*الوصف).الاسم);
            أصل_النوع := (*الوصف).الأصل;
            دع ن: متغير طبيعي = 0;
            طالما (ن < (الطول((*الوصف).أسماء_معاملات_النوع) مثل طبيعي)) {
                ألحق(أسماء_معاملات_النوع, انسخ_اسم_تصحيح(&(*الوصف).أسماء_معاملات_النوع[ن]));
                ن := ن + 1;
            }
            اصطناعي := (*الوصف).اصطناعي;
        }
        | اختياري.لا_شيء -> { };
        طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, المعرف) مع
        | نتيجة_تخطيط.مكتمل(التخطيط) -> { الحجم := التخطيط.الحجم; التخطيط_المكتمل := اختياري.موجود(التخطيط); }
        | _ -> { };
        طابق معرف_نوع_موجود_عند(الأنواع, المعرف) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(النوع) -> {
            طابق (*الأنواع).الأنواع[النوع.القيمة] مع
            | نوع_مقنن.بدائي(البدائي) -> {
                دع تهجئة: نص = تهجئة_عرض_نوع_بدائي(البدائي);
                الاسم := بايتات_نص_دوارف_أصلي(&تهجئة);
                الصنف := صنف_بدائي_لدوارف(البدائي);
            }
            | نوع_مقنن.مؤشر(الداخل) -> { الصنف := صنف_نوع_دوارف.مؤشر(الداخل.القيمة); }
            | نوع_مقنن.صندوق(الداخل) -> { الصنف := صنف_نوع_دوارف.صندوق(الداخل.القيمة); }
            | نوع_مقنن.مرجع(الداخل, _) -> { الصنف := صنف_نوع_دوارف.مرجع(الداخل.القيمة); }
            | نوع_مقنن.دالة(المعاملات, الناتج) -> {
                دع أنواع_المعاملات: متغير متجه طبيعي = [];
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(المعاملات) مثل طبيعي)) { ألحق(أنواع_المعاملات, المعاملات[م].القيمة); م := م + 1; }
                دع نوع_الناتج: اختياري طبيعي = اختياري.موجود(الناتج.القيمة);
                الصنف := صنف_نوع_دوارف.دالة(أنواع_المعاملات, نوع_الناتج);
            }
            | نوع_مقنن.صف(_) -> {
                طابق التخطيط_المكتمل مع
                | اختياري.موجود(التخطيط) -> { الصنف := ابن_تفاصيل_مركب_دوارف(الأنواع, المعرف, &التخطيط, التصحيح, &تصحيح_النوع); }
                | اختياري.لا_شيء -> { الصنف := صنف_نوع_دوارف.غير_محدد(); };
            }
            | نوع_مقنن.اختيار(_) -> {
                طابق التخطيط_المكتمل مع
                | اختياري.موجود(التخطيط) -> { الصنف := ابن_تفاصيل_مركب_دوارف(الأنواع, المعرف, &التخطيط, التصحيح, &تصحيح_النوع); }
                | اختياري.لا_شيء -> { الصنف := صنف_نوع_دوارف.غير_محدد(); };
            }
            | نوع_مقنن.نتيجة(_, _) -> {
                طابق التخطيط_المكتمل مع
                | اختياري.موجود(التخطيط) -> { الصنف := ابن_تفاصيل_مركب_دوارف(الأنواع, المعرف, &التخطيط, التصحيح, &تصحيح_النوع); }
                | اختياري.لا_شيء -> { الصنف := صنف_نوع_دوارف.غير_محدد(); };
            }
            | نوع_مقنن.مسمى(رمز_النوع, _, الحجج) -> {
                طابق ابحث_نوع_تصحيح_برمز_لدوارف(التصحيح, رمز_النوع) مع
                | اختياري.موجود(معرف_التصريح) -> {
                    دع وصف_التصريح: &نوع_تصحيح = &(*التصحيح).الأنواع[معرف_التصريح.القيمة];
                    الاسم := انسخ_اسم_تصحيح(&(*وصف_التصريح).الاسم);
                    أصل_النوع := (*وصف_التصريح).الأصل;
                    لو ((الطول(أسماء_معاملات_النوع) مثل طبيعي) == 0) {
                        دع ن: متغير طبيعي = 0;
                        طالما (ن < (الطول((*وصف_التصريح).أسماء_معاملات_النوع) مثل طبيعي)) {
                            ألحق(أسماء_معاملات_النوع, انسخ_اسم_تصحيح(&(*وصف_التصريح).أسماء_معاملات_النوع[ن]));
                            ن := ن + 1;
                        }
                    };
                }
                | اختياري.لا_شيء -> { };
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(الحجج) مثل طبيعي)) {
                    ألحق(معاملات_النوع, الحجج[م].القيمة);
                    م := م + 1;
                }
                طابق التخطيط_المكتمل مع
                | اختياري.موجود(التخطيط) -> { الصنف := ابن_تفاصيل_مركب_دوارف(الأنواع, المعرف, &التخطيط, التصحيح, &تصحيح_النوع); }
                | اختياري.لا_شيء -> { الصنف := صنف_نوع_دوارف.غير_محدد(); };
            }
            | نوع_مقنن.شريحة(_) -> {
                // Canonical Layout explicitly marks slice representation as unfrozen.
                الصنف := صنف_نوع_دوارف.غير_محدد();
            }
            | نوع_مقنن.متجه(الداخل) -> {
                طابق التخطيط_المكتمل مع
                | اختياري.موجود(التخطيط) -> {
                    دع أساس_هوية_مؤشر_البيانات: طبيعي = عدد_الأنواع * 2;
                    دع عدد_أنواع_التصحيح: طبيعي = الطول((*التصحيح).الأنواع) مثل طبيعي;
                    دع هوية_مؤشر_البيانات: طبيعي =
                        أساس_هوية_مؤشر_البيانات + عدد_أنواع_التصحيح + هوية + 1;
                    دع اسم_مؤشر_البيانات: متجه ط8 = اسم_نوع_دوارف_مولد(هوية_مؤشر_البيانات);
                    دع بلا_أصل_مؤشر: اختياري معرف_أصل_مصدر = اختياري.لا_شيء();
                    دع بلا_معاملات_مؤشر: متجه طبيعي = [];
                    دع بلا_أسماء_معاملات_مؤشر: متجه متجه ط8 = [];
                    دع صنف_المؤشر: صنف_نوع_دوارف = صنف_نوع_دوارف.مؤشر(الداخل.القيمة);
                    دع وصف_المؤشر: وصف_نوع_دوارف = {
                        الهوية: هوية_مؤشر_البيانات,
                        الاسم: اسم_مؤشر_البيانات,
                        الحجم: التخطيط.المحاذاة,
                        الصنف: صنف_المؤشر,
                        الأصل: بلا_أصل_مؤشر,
                        معاملات_النوع: بلا_معاملات_مؤشر,
                        أسماء_معاملات_النوع: بلا_أسماء_معاملات_مؤشر,
                        اصطناعي: صواب
                    };
                    ألحق(الناتج, وصف_المؤشر);
                    // The synthetic data pointer refers to the element type,
                    // which must itself be emitted. Previously it was not part
                    // of the closure, so the pointer's DW_AT_type was patched
                    // to offset 0 (an invalid DIE reference that gdb rejects).
                    ألحق_هوية_نوع_دوارف_إن_جديدة(&متغير العمل, &متغير المرئية, الداخل.القيمة);
                    الصنف := ابن_تفاصيل_متجه_دوارف(&التخطيط, هوية_مؤشر_البيانات);
                }
                | اختياري.لا_شيء -> { الصنف := صنف_نوع_دوارف.غير_محدد(); };
            }
            | نوع_مقنن.متغير(الداخل) -> { الصنف := صنف_نوع_دوارف.اسم_مستعار(الداخل.القيمة); }
            | _ -> { الصنف := صنف_نوع_دوارف.غير_محدد(); };
        };
        طابق تصحيح_النوع مع
        | اختياري.موجود(معرف_التصحيح) -> {
            دع وصف_التصحيح: &نوع_تصحيح = &(*التصحيح).الأنواع[معرف_التصحيح.القيمة];
            طابق (*وصف_التصحيح).اسم_مستعار_لـ مع
            | اختياري.موجود(الداخل) -> { الصنف := صنف_نوع_دوارف.اسم_مستعار(الداخل.القيمة); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        دع الوصف: وصف_نوع_دوارف = {
            الهوية: هوية,
            الاسم: الاسم,
            الحجم: الحجم,
            الصنف: الصنف,
            الأصل: أصل_النوع,
            معاملات_النوع: معاملات_النوع,
            أسماء_معاملات_النوع: أسماء_معاملات_النوع,
            اصطناعي: اصطناعي
        };
        ألحق_اعتمادات_نوع_دوارف(&متغير العمل, &متغير المرئية, &الوصف.الصنف);
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(الوصف.معاملات_النوع) مثل طبيعي)) {
            ألحق_هوية_نوع_دوارف_إن_جديدة(&متغير العمل, &متغير المرئية, الوصف.معاملات_النوع[م]);
            م := م + 1;
        }
        ألحق(الناتج, الوصف);
        ف := ف + 1;
    }
    // Emit source aliases after canonical types. Their synthetic DWARF identities live
    // outside canonical TypeID space and reference the canonical target DIE.
    د := 0;
    طالما (د < (الطول((*التصحيح).الأنواع) مثل طبيعي)) {
        دع سجل_التصحيح: &نوع_تصحيح = &(*التصحيح).الأنواع[د];
        طابق (*سجل_التصحيح).اسم_مستعار_لـ مع
        | اختياري.موجود(الهدف_المستعار) -> {
            دع هوية_المستعار: طبيعي = عدد_الأنواع + (*سجل_التصحيح).المعرف.القيمة;
            دع اسم_المستعار: متجه ط8 = انسخ_اسم_تصحيح(&(*سجل_التصحيح).الاسم);
            دع صنف_المستعار: صنف_نوع_دوارف = صنف_نوع_دوارف.اسم_مستعار(الهدف_المستعار.القيمة);
            دع معاملات_فارغة: متجه طبيعي = [];
            دع أسماء_معاملات_فارغة: متجه متجه ط8 = [];
            دع أصل_المستعار: اختياري معرف_أصل_مصدر = (*سجل_التصحيح).الأصل;
            دع اصطناعي_المستعار: منطقي = (*سجل_التصحيح).اصطناعي;
            دع وصف_المستعار: وصف_نوع_دوارف = {
                الهوية: هوية_المستعار,
                الاسم: اسم_المستعار,
                الحجم: 0,
                الصنف: صنف_المستعار,
                الأصل: أصل_المستعار,
                معاملات_النوع: معاملات_فارغة,
                أسماء_معاملات_النوع: أسماء_معاملات_فارغة,
                اصطناعي: اصطناعي_المستعار
            };
            ألحق(الناتج, وصف_المستعار);
        }
        | اختياري.لا_شيء -> { };
        د := د + 1;
    }
    أرجع الناتج;
}

// المسار المتدرج يحتفظ فقط بالناتج المشفر والملخصات المطلوبة للكائن عبر الدوال.
// selected/allocated machine IR يبقيان محليين للدالة الحالية فقط.

// Type DIE serialization consumes the reachable descriptions above.
عام نوع رقعة_نوع_دوارف = { الموضع: طبيعي, الهوية: طبيعي };

عرف ألحق_رقعة_نوع_دوارف(الرقع: &متغير متجه رقعة_نوع_دوارف, الرقعة: رقعة_نوع_دوارف): فراغ { ألحق(*الرقع, الرقعة); }

عرف ألحق_مرجع_نوع_مؤجل_دوارف(
    ب: &متغير متجه ط8,
    السياسة: &سياسة_دوارف,
    الرقع: &متغير متجه رقعة_نوع_دوارف,
    الهوية: طبيعي
): فراغ {
    دع الموضع: طبيعي = الطول(*ب) مثل طبيعي;
    ألحق_إزاحة_دوارف(ب, السياسة, 0);
    دع الرقعة: رقعة_نوع_دوارف = { الموضع: الموضع, الهوية: الهوية };
    ألحق_رقعة_نوع_دوارف(الرقع, الرقعة);
}

عام عرف ابن_أنواع_معلومات_دوارف(
    ب: &متغير متجه ط8,
    الأنواع: &متجه وصف_نوع_دوارف,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه ط8,
    السلاسل: &متغير جدول_سلاسل_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    المواقع: &متغير متجه طبيعي,
    الرقع: &متغير متجه رقعة_نوع_دوارف
): فراغ {
    دع أعلى_هوية: متغير طبيعي = 0;
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(*الأنواع) مثل طبيعي)) { لو ((*الأنواع)[ي].الهوية > أعلى_هوية) { أعلى_هوية := (*الأنواع)[ي].الهوية; }; ي := ي + 1; }
    دع خارج: متغير متجه طبيعي = [];
    ي := 0; طالما (ي <= أعلى_هوية) { ألحق(خارج, 0); ي := ي + 1; }
    ي := 0;
    طالما (ي < (الطول(*الأنواع) مثل طبيعي)) {
        دع وصف_النوع: &وصف_نوع_دوارف = &(*الأنواع)[ي];
        دع هوية_النوع: طبيعي = (*وصف_النوع).الهوية;
        دع اسم_النوع: &متجه ط8 = &(*وصف_النوع).الاسم;
        خارج[هوية_النوع] := الطول(*ب) مثل طبيعي;
        طابق (*وصف_النوع).الصنف مع
        | صنف_نوع_دوارف.أساسي_موقع -> { ألحق_ليب128_دوارف(ب, 6); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); دع ترميز_موقع: ترميز_نوع_دوارف = ترميز_نوع_دوارف.موقع(); ألحق_ط8_دوارف(ب, رمز_ترميز_نوع_دوارف(ترميز_موقع)); ألحق_ليب128_دوارف(ب, (*وصف_النوع).الحجم); }
        | صنف_نوع_دوارف.أساسي_طبيعي -> { ألحق_ليب128_دوارف(ب, 6); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); دع ترميز_طبيعي: ترميز_نوع_دوارف = ترميز_نوع_دوارف.طبيعي(); ألحق_ط8_دوارف(ب, رمز_ترميز_نوع_دوارف(ترميز_طبيعي)); ألحق_ليب128_دوارف(ب, (*وصف_النوع).الحجم); }
        | صنف_نوع_دوارف.أساسي_منطقي -> { ألحق_ليب128_دوارف(ب, 6); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); دع ترميز_منطقي: ترميز_نوع_دوارف = ترميز_نوع_دوارف.منطقي(); ألحق_ط8_دوارف(ب, رمز_ترميز_نوع_دوارف(ترميز_منطقي)); ألحق_ليب128_دوارف(ب, (*وصف_النوع).الحجم); }
        | صنف_نوع_دوارف.أساسي_عشري -> { ألحق_ليب128_دوارف(ب, 6); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); دع ترميز_عشري: ترميز_نوع_دوارف = ترميز_نوع_دوارف.عشري(); ألحق_ط8_دوارف(ب, رمز_ترميز_نوع_دوارف(ترميز_عشري)); ألحق_ليب128_دوارف(ب, (*وصف_النوع).الحجم); }
        | صنف_نوع_دوارف.أساسي_محرف -> { ألحق_ليب128_دوارف(ب, 6); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); دع ترميز_محرف: ترميز_نوع_دوارف = ترميز_نوع_دوارف.محرف(); ألحق_ط8_دوارف(ب, رمز_ترميز_نوع_دوارف(ترميز_محرف)); ألحق_ليب128_دوارف(ب, (*وصف_النوع).الحجم); }
        | صنف_نوع_دوارف.مؤشر(الداخل) -> { ألحق_ليب128_دوارف(ب, 7); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); ألحق_ليب128_دوارف(ب, (*وصف_النوع).الحجم); ألحق_مرجع_نوع_مؤجل_دوارف(ب, السياسة, الرقع, الداخل); }
        | صنف_نوع_دوارف.مرجع(الداخل) -> { ألحق_ليب128_دوارف(ب, 8); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); ألحق_ليب128_دوارف(ب, (*وصف_النوع).الحجم); ألحق_مرجع_نوع_مؤجل_دوارف(ب, السياسة, الرقع, الداخل); }
        | صنف_نوع_دوارف.صندوق(الداخل) -> { ألحق_ليب128_دوارف(ب, 7); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); ألحق_ليب128_دوارف(ب, (*وصف_النوع).الحجم); ألحق_مرجع_نوع_مؤجل_دوارف(ب, السياسة, الرقع, الداخل); }
        | صنف_نوع_دوارف.اسم_مستعار(الداخل) -> {
            دع له_تصريح: متغير منطقي = خطأ; طابق (*وصف_النوع).الأصل مع | اختياري.موجود(_) -> { له_تصريح := صواب; } | اختياري.لا_شيء -> { };
            لو (له_تصريح) { ألحق_ليب128_دوارف(ب, 22); } وإلا { ألحق_ليب128_دوارف(ب, 20); };
            ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع);
            ألحق_مرجع_نوع_مؤجل_دوارف(ب, السياسة, الرقع, الداخل);
            لو (له_تصريح) { طابق (*وصف_النوع).الأصل مع | اختياري.موجود(الأصل) -> { ألحق_إحداثي_نوع_دوارف(ب, الخريطة, سجل_الأصول, الأصل, السياسة); } | اختياري.لا_شيء -> { }; };
            لو ((*وصف_النوع).اصطناعي) { ألحق_ط8_دوارف(ب, 1); } وإلا { ألحق_ط8_دوارف(ب, 0); };
        }
        | صنف_نوع_دوارف.دالة(المعاملات, الناتج) -> {
            دع الاختصار: متغير طبيعي = 17; طابق الناتج مع | اختياري.موجود(_) -> { الاختصار := 18; } | اختياري.لا_شيء -> { };
            ألحق_ليب128_دوارف(ب, الاختصار); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع);
            طابق الناتج مع | اختياري.موجود(نوع_الناتج) -> { ألحق_مرجع_نوع_مؤجل_دوارف(ب, السياسة, الرقع, نوع_الناتج); } | اختياري.لا_شيء -> { };
            دع م: متغير طبيعي = 0; طالما (م < (الطول(المعاملات) مثل طبيعي)) { ألحق_ليب128_دوارف(ب, 19); ألحق_مرجع_نوع_مؤجل_دوارف(ب, السياسة, الرقع, المعاملات[م]); م := م + 1; }
            ألحق_ط8_دوارف(ب, 0);
        }
        | صنف_نوع_دوارف.مركب(الأعضاء, المميز, البدائل) -> {
            ألحق_ليب128_دوارف(ب, 9); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); ألحق_ليب128_دوارف(ب, (*وصف_النوع).الحجم);
            دع موضع_عضو_المميز: متغير اختياري طبيعي = اختياري.لا_شيء();
            دع ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الأعضاء) مثل طبيعي)) {
                دع موضع_العضو: طبيعي = الطول(*ب) مثل طبيعي;
                ألحق_ليب128_دوارف(ب, 14); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &الأعضاء[ع].الاسم); ألحق_مرجع_نوع_مؤجل_دوارف(ب, السياسة, الرقع, الأعضاء[ع].هوية_النوع); ألحق_ليب128_دوارف(ب, الأعضاء[ع].إزاحة_بايت);
                طابق المميز مع | اختياري.موجود(وصف_المميز) -> { لو (الأعضاء[ع].إزاحة_بايت == وصف_المميز.إزاحة_بايت && الأعضاء[ع].هوية_النوع == وصف_المميز.هوية_النوع) { موضع_عضو_المميز := اختياري.موجود(موضع_العضو); }; } | اختياري.لا_شيء -> { };
                ع := ع + 1;
            }
            طابق المميز مع
            | اختياري.موجود(_) -> {
                لو ((الطول(البدائل) مثل طبيعي) > 0) {
                    ألحق_ليب128_دوارف(ب, 15);
                    طابق موضع_عضو_المميز مع | اختياري.موجود(الموضع) -> { ألحق_إزاحة_دوارف(ب, السياسة, الموضع); } | اختياري.لا_شيء -> { ألحق_إزاحة_دوارف(ب, السياسة, 0); };
                    دع د: متغير طبيعي = 0;
                    طالما (د < (الطول(البدائل) مثل طبيعي)) {
                        ألحق_ليب128_دوارف(ب, 16); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &البدائل[د].الاسم); ألحق_ليب128_دوارف(ب, البدائل[د].القيمة);
                        ع := 0; طالما (ع < (الطول(البدائل[د].الأعضاء) مثل طبيعي)) { ألحق_ليب128_دوارف(ب, 14); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &البدائل[د].الأعضاء[ع].الاسم); ألحق_مرجع_نوع_مؤجل_دوارف(ب, السياسة, الرقع, البدائل[د].الأعضاء[ع].هوية_النوع); ألحق_ليب128_دوارف(ب, البدائل[د].الأعضاء[ع].إزاحة_بايت); ع := ع + 1; }
                        ألحق_ط8_دوارف(ب, 0); د := د + 1;
                    }
                    ألحق_ط8_دوارف(ب, 0);
                };
            }
            | اختياري.لا_شيء -> { };
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول((*وصف_النوع).معاملات_النوع) مثل طبيعي)) {
                ألحق_ليب128_دوارف(ب, 21);
                لو (م < (الطول((*وصف_النوع).أسماء_معاملات_النوع) مثل طبيعي)) { ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &(*وصف_النوع).أسماء_معاملات_النوع[م]); }
                وإلا { دع اسم_معامل_فارغ: متجه ط8 = []; ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, &اسم_معامل_فارغ); };
                ألحق_مرجع_نوع_مؤجل_دوارف(ب, السياسة, الرقع, (*وصف_النوع).معاملات_النوع[م]); م := م + 1;
            }
            ألحق_ط8_دوارف(ب, 0);
        }
        | صنف_نوع_دوارف.غير_محدد -> { ألحق_ليب128_دوارف(ب, 10); ألحق_اسم_دوارف(ب, السياسة, بيانات_السلاسل, السلاسل, رقع_الأقسام, اسم_النوع); };
        ي := ي + 1;
    }
    *المواقع := خارج;
}

عام عرف طبق_رقع_أنواع_دوارف(
    ب: &متغير متجه ط8,
    السياسة: &سياسة_دوارف,
    المواقع: &متجه طبيعي,
    الرقع: &متجه رقعة_نوع_دوارف
): فراغ {
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(*الرقع) مثل طبيعي)) {
        دع الهوية: طبيعي = (*الرقع)[ي].الهوية;
        لو (الهوية < (الطول(*المواقع) مثل طبيعي)) { اكتب_إزاحة_دوارف(ب, السياسة, (*الرقع)[ي].الموضع, (*المواقع)[الهوية]); };
        ي := ي + 1;
    }
}

عام عرف ألحق_مرجع_نوع_دوارف(
    ب: &متغير متجه ط8,
    السياسة: &سياسة_دوارف,
    المواقع: &متجه طبيعي,
    الهوية: طبيعي
): فراغ {
    لو (الهوية < (الطول(*المواقع) مثل طبيعي)) { ألحق_إزاحة_دوارف(ب, السياسة, (*المواقع)[الهوية]); }
    وإلا { ألحق_إزاحة_دوارف(ب, السياسة, 0); };
}
