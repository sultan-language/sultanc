استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_strings;
استورد compiler.backend.object.dwarf.dwarf_model;

// Name indexes are separate from DIE emission. DWARF4 pubnames remains compatibility-only.
عام نوع اسم_عام_دوارف = {
    إزاحة_معلومة: طبيعي,
    الاسم: متجه ط8
};

عام نوع نوع_مدخل_فهرس_اسم_دوارف =
    | دالة
    | متغير
    | وحدة
    | اسم_مستعار
    | نوع_أساسي
    | نوع_مؤشر
    | نوع_مرجع
    | نوع_بنية
    | نوع_دالة
    | ثابت
    | نوع_غير_محدد
;

عام نوع مدخل_فهرس_اسم_دوارف = {
    إزاحة_معلومة: طبيعي,
    الاسم: متجه ط8,
    النوع: نوع_مدخل_فهرس_اسم_دوارف
};

عام عرف ابن_أسماء_عامة_دوارف(
    حجم_المعلومات: طبيعي,
    الأسماء: &متجه اسم_عام_دوارف,
    السياسة: &سياسة_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): متجه ط8 {
    دع ب: متغير متجه ط8 = [];
    لو ((*السياسة).حديث) { أرجع ب; };
    دع البداية: طبيعي = ابدأ_وحدة_دوارف(&متغير ب, السياسة);
    ألحق_ط16_دوارف(&متغير ب, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.إصدار_أسماء_عامة()));
    ألحق_مرجع_قسم_دوارف(&متغير ب, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.أسماء_عامة(), قسم_بيانات_دوارف.معلومات(), 0);
    ألحق_إزاحة_دوارف(&متغير ب, السياسة, حجم_المعلومات);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
        ألحق_إزاحة_دوارف(&متغير ب, السياسة, (*الأسماء)[ف].إزاحة_معلومة);
        ألحق_بايتات_صفرية_دوارف(&متغير ب, &(*الأسماء)[ف].الاسم);
        ف := ف + 1;
    }
    ألحق_إزاحة_دوارف(&متغير ب, السياسة, 0);
    اختم_وحدة_دوارف(&متغير ب, السياسة, البداية);
    أرجع ب;
}

عرف هاش_اسم_دوارف(الاسم: &متجه ط8): طبيعي {
    دع هاش: متغير طبيعي = 5381;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) { هاش := (هاش * 33 + ((*الاسم)[ف] مثل طبيعي)) % 4294967296; ف := ف + 1; }
    أرجع هاش;
}

عرف رمز_اختصار_فهرس_دوارف(النوع: نوع_مدخل_فهرس_اسم_دوارف): طبيعي {
    طابق النوع مع
    | نوع_مدخل_فهرس_اسم_دوارف.دالة -> { أرجع 1; }
    | نوع_مدخل_فهرس_اسم_دوارف.متغير -> { أرجع 2; }
    | نوع_مدخل_فهرس_اسم_دوارف.وحدة -> { أرجع 3; }
    | نوع_مدخل_فهرس_اسم_دوارف.اسم_مستعار -> { أرجع 4; }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي -> { أرجع 5; }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_مؤشر -> { أرجع 6; }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_مرجع -> { أرجع 7; }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_بنية -> { أرجع 8; }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_دالة -> { أرجع 9; }
    | نوع_مدخل_فهرس_اسم_دوارف.ثابت -> { أرجع 10; }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_غير_محدد -> { أرجع 11; };
}

عرف وسم_مدخل_فهرس_دوارف(النوع: نوع_مدخل_فهرس_اسم_دوارف): وسم_دوارف {
    طابق النوع مع
    | نوع_مدخل_فهرس_اسم_دوارف.دالة -> { أرجع وسم_دوارف.دالة(); }
    | نوع_مدخل_فهرس_اسم_دوارف.متغير -> { أرجع وسم_دوارف.متغير(); }
    | نوع_مدخل_فهرس_اسم_دوارف.وحدة -> { أرجع وسم_دوارف.وحدة(); }
    | نوع_مدخل_فهرس_اسم_دوارف.اسم_مستعار -> { أرجع وسم_دوارف.اسم_مستعار(); }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي -> { أرجع وسم_دوارف.نوع_أساسي(); }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_مؤشر -> { أرجع وسم_دوارف.نوع_مؤشر(); }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_مرجع -> { أرجع وسم_دوارف.نوع_مرجع(); }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_بنية -> { أرجع وسم_دوارف.نوع_بنية(); }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_دالة -> { أرجع وسم_دوارف.نوع_دالة(); }
    | نوع_مدخل_فهرس_اسم_دوارف.ثابت -> { أرجع وسم_دوارف.ثابت(); }
    | نوع_مدخل_فهرس_اسم_دوارف.نوع_غير_محدد -> { أرجع وسم_دوارف.نوع_غير_محدد(); };
}

عرف أنواع_اختصارات_فهرس_دوارف(): متجه نوع_مدخل_فهرس_اسم_دوارف {
    دع الأنواع: متغير متجه نوع_مدخل_فهرس_اسم_دوارف = [];
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.دالة());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.متغير());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.وحدة());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.اسم_مستعار());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.نوع_أساسي());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.نوع_مؤشر());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.نوع_مرجع());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.نوع_بنية());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.نوع_دالة());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.ثابت());
    ألحق(الأنواع, نوع_مدخل_فهرس_اسم_دوارف.نوع_غير_محدد());
    أرجع الأنواع;
}

// A per-CU name index needs only DW_IDX_die_offset: the sole CU is implicit.
نوع مجموعة_اسم_فهرس_دوارف = {
    الاسم: متجه ط8,
    الهاش: طبيعي,
    المداخل: متجه طبيعي,
    التالي: اختياري طبيعي
};

عرف اسما_فهرس_دوارف_متساويان(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    لو ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اجمع_أسماء_فهرس_دوارف(الأسماء: &متجه مدخل_فهرس_اسم_دوارف): متجه مجموعة_اسم_فهرس_دوارف {
    دع المجموعات: متغير متجه مجموعة_اسم_فهرس_دوارف = [];
    دع سعة_البحث: متغير طبيعي = 16;
    دع عدد_الأسماء: طبيعي = الطول(*الأسماء) مثل طبيعي;
    طالما (عدد_الأسماء * 3 >= سعة_البحث * 2) { سعة_البحث := سعة_البحث * 2; }
    دع دلاء_البحث: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < سعة_البحث) { ألحق(دلاء_البحث, اختياري.لا_شيء()); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
        دع الهاش: طبيعي = هاش_اسم_دوارف(&(*الأسماء)[ف].الاسم);
        دع الدلو: طبيعي = الهاش % سعة_البحث;
        دع الحالي: متغير اختياري طبيعي = دلاء_البحث[الدلو];
        دع الموجود: متغير اختياري طبيعي = اختياري.لا_شيء();
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            طابق الحالي مع
            | اختياري.لا_شيء -> { مستمر := خطأ; }
            | اختياري.موجود(م) -> {
                لو (المجموعات[م].الهاش == الهاش && اسما_فهرس_دوارف_متساويان(&المجموعات[م].الاسم, &(*الأسماء)[ف].الاسم)) {
                    الموجود := اختياري.موجود(م);
                    مستمر := خطأ;
                } وإلا {
                    الحالي := المجموعات[م].التالي;
                };
            };
        }
        طابق الموجود مع
        | اختياري.موجود(م) -> { ألحق(المجموعات[م].المداخل, ف); }
        | اختياري.لا_شيء -> {
            دع نسخة_الاسم: متجه ط8 = انسخ_بايتات_دوارف(&(*الأسماء)[ف].الاسم);
            دع مداخل: متغير متجه طبيعي = []; ألحق(مداخل, ف);
            دع المجموعة: مجموعة_اسم_فهرس_دوارف = { الاسم: نسخة_الاسم, الهاش: الهاش, المداخل: مداخل, التالي: دلاء_البحث[الدلو] };
            دع الفهرس: طبيعي = الطول(المجموعات) مثل طبيعي;
            ألحق(المجموعات, المجموعة);
            دلاء_البحث[الدلو] := اختياري.موجود(الفهرس);
        };
        ف := ف + 1;
    }
    أرجع المجموعات;
}

عام عرف ابن_فهرس_أسماء_دوارف(
    الأسماء: &متجه مدخل_فهرس_اسم_دوارف,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه ط8,
    السلاسل: &متغير جدول_سلاسل_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): متجه ط8 {
    دع ب: متغير متجه ط8 = [];
    لو (!(*السياسة).حديث) { أرجع ب; };

    // DWARF5 name_count is the number of unique names. Equal spellings share
    // one name slot whose entry list may reference multiple DIEs. The optional
    // hash subtable is omitted because conforming DWARF5 hashes require Unicode
    // simple case folding; no canonical folding service exists in this layer.
    دع المجموعات: متجه مجموعة_اسم_فهرس_دوارف = اجمع_أسماء_فهرس_دوارف(الأسماء);
    دع عدد_الأسماء: طبيعي = الطول(المجموعات) مثل طبيعي;
    دع عدد_الدلاء: طبيعي = 0;
    دع الترتيب: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأسماء) { ألحق(الترتيب, ف); ف := ف + 1; }

    دع جدول_الاختصارات: متغير متجه ط8 = [];
    دع أنواع_الاختصارات: متجه نوع_مدخل_فهرس_اسم_دوارف = أنواع_اختصارات_فهرس_دوارف();
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول(أنواع_الاختصارات) مثل طبيعي)) {
        دع النوع: نوع_مدخل_فهرس_اسم_دوارف = أنواع_الاختصارات[ع];
        ألحق_ليب128_دوارف(&متغير جدول_الاختصارات, رمز_اختصار_فهرس_دوارف(النوع));
        ألحق_ليب128_دوارف(&متغير جدول_الاختصارات, رمز_وسم_دوارف(وسم_مدخل_فهرس_دوارف(النوع)));
        ألحق_ليب128_دوارف(&متغير جدول_الاختصارات, رمز_سمة_فهرس_اسم_دوارف(سمة_فهرس_اسم_دوارف.إزاحة_مدخل()));
        ألحق_ليب128_دوارف(&متغير جدول_الاختصارات, رمز_صيغة_دوارف((*السياسة).صيغة_مرجع_النوع));
        ألحق_ط8_دوارف(&متغير جدول_الاختصارات, 0); ألحق_ط8_دوارف(&متغير جدول_الاختصارات, 0);
        ع := ع + 1;
    }
    ألحق_ط8_دوارف(&متغير جدول_الاختصارات, 0);

    دع مجمع_المداخل: متغير متجه ط8 = [];
    دع إزاحات_المداخل: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الأسماء) {
        دع موضع_المجموعة: طبيعي = الترتيب[ف];
        ألحق(إزاحات_المداخل, الطول(مجمع_المداخل) مثل طبيعي);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(المجموعات[موضع_المجموعة].المداخل) مثل طبيعي)) {
            دع موضع_الاسم: طبيعي = المجموعات[موضع_المجموعة].المداخل[ك];
            ألحق_ليب128_دوارف(&متغير مجمع_المداخل, رمز_اختصار_فهرس_دوارف((*الأسماء)[موضع_الاسم].النوع));
            ألحق_إزاحة_دوارف(&متغير مجمع_المداخل, السياسة, (*الأسماء)[موضع_الاسم].إزاحة_معلومة);
            ك := ك + 1;
        }
        ألحق_ط8_دوارف(&متغير مجمع_المداخل, 0);
        ف := ف + 1;
    }

    دع البداية: طبيعي = ابدأ_وحدة_دوارف(&متغير ب, السياسة);
    ألحق_ط16_دوارف(&متغير ب, رمز_إصدار_دوارف((*السياسة).الإصدار)); ألحق_ط16_دوارف(&متغير ب, 0);
    ألحق_ط32_دوارف(&متغير ب, 1); ألحق_ط32_دوارف(&متغير ب, 0); ألحق_ط32_دوارف(&متغير ب, 0);
    ألحق_ط32_دوارف(&متغير ب, عدد_الدلاء); ألحق_ط32_دوارف(&متغير ب, عدد_الأسماء);
    ألحق_ط32_دوارف(&متغير ب, الطول(جدول_الاختصارات) مثل طبيعي); ألحق_ط32_دوارف(&متغير ب, 0);
    ألحق_مرجع_قسم_دوارف(&متغير ب, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.فهرس_أسماء(), قسم_بيانات_دوارف.معلومات(), 0); // sole CU offset
    ف := 0;
    طالما (ف < عدد_الأسماء) {
        دع المجموعة: طبيعي = الترتيب[ف];
        دع إزاحة_السلسلة: طبيعي = أدرج_في_سلاسل_دوارف(بيانات_السلاسل, السلاسل, &المجموعات[المجموعة].الاسم);
        ألحق_مرجع_قسم_دوارف(&متغير ب, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.فهرس_أسماء(), قسم_بيانات_دوارف.سلاسل(), إزاحة_السلسلة);
        ف := ف + 1;
    }
    ف := 0; طالما (ف < عدد_الأسماء) { ألحق_إزاحة_دوارف(&متغير ب, السياسة, إزاحات_المداخل[ف]); ف := ف + 1; }
    ألحق_بايتات_دوارف(&متغير ب, &جدول_الاختصارات);
    ألحق_بايتات_دوارف(&متغير ب, &مجمع_المداخل);
    اختم_وحدة_دوارف(&متغير ب, السياسة, البداية);
    أرجع ب;
}
