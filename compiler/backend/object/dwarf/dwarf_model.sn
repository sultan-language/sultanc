استورد compiler.backend.codegen.selected_code_core;
استورد compiler.source.provenance;
استورد compiler.debuginfo.model;
استورد compiler.backend.object.dwarf.dwarf_constants;
استورد compiler.msir.identifiers;

// Target-independent placement facts consumed by DWARF. Object-format writers
// decide how these section-relative addresses are embedded in Mach-O or ELF.
عام نوع موضع_دالة_دوارف = {
    الدالة: معرف_دالة_منتقاة,
    إزاحة_بايت: غير_موقع,
    حجم_بايت: غير_موقع,
    اسم_الربط: متجه غ8
};

عام نوع مدى_نص_دوارف = {
    إزاحة_بايت: غير_موقع,
    حجم_بايت: غير_موقع
};

// Object-format owners compute these offsets while laying out the data section.
// DWARF consumes the fact but never owns global placement.
عام نوع موضع_عام_دوارف = {
    العام: معرف_عام_مسير,
    إزاحة_بايت: غير_موقع,
    اسم_الربط: متجه غ8
};

// A source value can live in a register or in a Target-described stack slot.
// The DWARF writer consumes only this target-independent location fact.
عام نوع موقع_قيمة_دوارف =
    | غير_متاح
    | سجل بنوع غير_موقع
    | مكدس بنوع (غير_موقع, غير_موقع)
;

عام نوع وصف_معامل_دوارف = {
    المتغير: معرف_متغير_تصحيح,
    الاسم: متجه غ8,
    الأصل: معرف_أصل_مصدر,
    هوية_النوع: غير_موقع,
    اصطناعي: منطقي
};

عام نوع وصف_نطاق_دوارف = {
    المعرف: غير_موقع,
    الأصل: معرف_أصل_مصدر,
    الأب: اختيار غير_موقع
};

عام نوع وصف_متغير_دوارف = {
    المتغير: معرف_متغير_تصحيح,
    الاسم: متجه غ8,
    الأصل: معرف_أصل_مصدر,
    نطاق_الإحاطة: غير_موقع,
    هوية_النوع: غير_موقع,
    اصطناعي: منطقي
};

عام نوع وصف_عضو_دوارف = {
    الاسم: متجه غ8,
    هوية_النوع: غير_موقع,
    إزاحة_بايت: غير_موقع
};

عام نوع وصف_بديل_دوارف = {
    الاسم: متجه غ8,
    القيمة: غير_موقع,
    الأعضاء: متجه وصف_عضو_دوارف
};

عام نوع وصف_مميز_بدائل_دوارف = {
    الاسم: متجه غ8,
    هوية_النوع: غير_موقع,
    إزاحة_بايت: غير_موقع
};

// Type classes are deliberately target-independent. Size/member offsets come
// from canonical Target layout, while DWARF encoding policy remains in the writer.
عام نوع صنف_نوع_دوارف =
    | أساسي_موقع
    | أساسي_غير_موقع
    | أساسي_منطقي
    | أساسي_عشري
    | أساسي_محرف
    | مؤشر بنوع غير_موقع
    | مرجع بنوع غير_موقع
    | صندوق بنوع غير_موقع
    | اسم_مستعار بنوع غير_موقع
    | دالة بنوع (متجه غير_موقع, اختيار غير_موقع)
    | مركب بنوع (متجه وصف_عضو_دوارف, اختيار وصف_مميز_بدائل_دوارف, متجه وصف_بديل_دوارف)
    | غير_محدد
;

عام نوع وصف_نوع_دوارف = {
    الهوية: غير_موقع,
    الاسم: متجه غ8,
    الحجم: غير_موقع,
    الصنف: صنف_نوع_دوارف,
    الأصل: اختيار معرف_أصل_مصدر,
    معاملات_النوع: متجه غير_موقع,
    أسماء_معاملات_النوع: متجه متجه غ8,
    اصطناعي: منطقي
};

عام نوع وصف_دالة_دوارف = {
    الدالة: معرف_دالة_منتقاة,
    الاسم: متجه غ8,
    اسم_الربط: متجه غ8,
    الأصل: معرف_أصل_مصدر,
    المعاملات: متجه وصف_معامل_دوارف,
    نوع_الناتج: اختيار غير_موقع,
    النطاقات: متجه وصف_نطاق_دوارف,
    المحليات: متجه وصف_متغير_دوارف,
    علني: منطقي,
    إعلان_فقط: منطقي,
    اصطناعي: منطقي
};


عام نوع قسم_عنوان_دوارف =
    | معلومات
    | سطور
    | مواقع
    | إطار
    | نطاقات_عناوين
    | عناوين
    | قوائم_مواقع
    | قوائم_نطاقات
;

عام نوع قاعدة_عنوان_دوارف =
    | نص
    | بيانات
;

// Internal DWARF section references are distinct from program-address fixups.
// Relocatable object writers translate these into object-format relocations;
// final executable writers keep them as section-relative values.
عام نوع قسم_بيانات_دوارف =
    | معلومات
    | اختصارات
    | سطور
    | سلاسل_سطور
    | سلاسل
    | عناوين
    | مواقع
    | قوائم_مواقع
    | إطار
    | نطاقات_عناوين
    | قوائم_نطاقات
    | أسماء_عامة
    | فهرس_أسماء
;

عام نوع رقعة_قسم_دوارف = {
    القسم: قسم_بيانات_دوارف,
    الموضع: غير_موقع,
    العرض: غير_موقع,
    الهدف: قسم_بيانات_دوارف,
    الإزاحة: غير_موقع
};

عام نوع مرجع_عنوان_دوارف = {
    القاعدة: قاعدة_عنوان_دوارف,
    إزاحة_بايت: غير_موقع
};

// DWARF owns only the location of an address field plus a symbolic
// section-relative reference. Mach-O/ELF own relocation and final resolution.
عام نوع رقعة_عنوان_دوارف = {
    القسم: قسم_عنوان_دوارف,
    الموضع: غير_موقع,
    العرض: غير_موقع,
    المرجع: مرجع_عنوان_دوارف
};

عام نوع حزمة_دوارف = {
    الإصدار: إصدار_دوارف,
    صيغة_الإزاحة: صيغة_إزاحة_دوارف,
    حجم_العنوان: غير_موقع,
    معلومات: متجه غ8,
    اختصارات: متجه غ8,
    سطور: متجه غ8,
    سلاسل_سطور: متجه غ8,
    سلاسل: متجه غ8,
    عناوين: متجه غ8,
    مواقع: متجه غ8,
    قوائم_مواقع: متجه غ8,
    إطار: متجه غ8,
    نطاقات_عناوين: متجه غ8,
    قوائم_نطاقات: متجه غ8,
    أسماء_عامة: متجه غ8,
    فهرس_أسماء: متجه غ8,
    رقع_العناوين: متجه رقعة_عنوان_دوارف,
    رقع_الأقسام: متجه رقعة_قسم_دوارف
};
