استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.codegen.debug.model;
استورد compiler.msir.debug_contract;
استورد compiler.debuginfo.model;
استورد compiler.debuginfo.builder;
استورد compiler.source.provenance;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.msir.identifiers;

// Serialization adapter only. Rich function/scope/variable facts remain owned by
// compiler/debuginfo; machine locations remain owned by compiler/backend/codegen/debug.
عام عرف موقع_دوارف_من_موقع_آلة(الموقع: &موقع_آلة_تصحيح): موقع_قيمة_دوارف {
    طابق *الموقع مع
    | موقع_آلة_تصحيح.غير_متاح -> { أرجع موقع_قيمة_دوارف.غير_متاح(); }
    | موقع_آلة_تصحيح.سجل(السجل) -> { أرجع موقع_قيمة_دوارف.سجل(السجل); }
    | موقع_آلة_تصحيح.مكدس(السجل, الإزاحة) -> { أرجع موقع_قيمة_دوارف.مكدس(السجل, الإزاحة); }
    | موقع_آلة_تصحيح.مكدس_غير_مباشر(السجل, الإزاحة) -> { أرجع موقع_قيمة_دوارف.مكدس_غير_مباشر(السجل, الإزاحة); }
    | موقع_آلة_تصحيح.إطار(الإزاحة) -> { أرجع موقع_قيمة_دوارف.إطار(الإزاحة); }
    | موقع_آلة_تصحيح.إطار_غير_مباشر(الإزاحة) -> { أرجع موقع_قيمة_دوارف.إطار_غير_مباشر(الإزاحة); }
    | موقع_آلة_تصحيح.محلي_ويب_أسمبلي(المحلي, عنوان) -> { أرجع موقع_قيمة_دوارف.محلي_ويب_أسمبلي(المحلي, عنوان); };
}

عرف ابن_فهرس_مسير_لدوال_تصحيح(
    العقد: &عقد_تصحيح_مسير,
    عدد_الدوال: طبيعي
): متجه اختياري معرف_دالة_مسير {
    دع الفهرس: متغير متجه اختياري معرف_دالة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الدوال) { ألحق(الفهرس, اختياري.لا_شيء()); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*العقد).دوال) مثل طبيعي)) {
        طابق (*العقد).دوال[ف] مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المعرف) -> {
            إذا (المعرف.القيمة < عدد_الدوال) { الفهرس[المعرف.القيمة] := اختياري.موجود(معرف_دالة_مسير_من(ف)); };
        };
        ف := ف + 1;
    }
    أرجع الفهرس;
}

عرف اجمع_نطاقات_تصحيح_بدالة(السياق: &سياق_تصحيح): متجه متجه طبيعي {
    دع الناتج: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الدوال) مثل طبيعي)) { دع فارغ: متجه طبيعي = []; ألحق(الناتج, فارغ); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*السياق).النطاقات) مثل طبيعي)) {
        دع د: طبيعي = (*السياق).النطاقات[ف].الدالة.القيمة;
        إذا (د < (الطول(الناتج) مثل طبيعي)) { ألحق(الناتج[د], ف); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اجمع_متغيرات_تصحيح_بدالة(السياق: &سياق_تصحيح): متجه متجه طبيعي {
    دع الناتج: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الدوال) مثل طبيعي)) { دع فارغ: متجه طبيعي = []; ألحق(الناتج, فارغ); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*السياق).المتغيرات) مثل طبيعي)) {
        دع المتغير: &متغير_تصحيح = &(*السياق).المتغيرات[ف];
        دع معرف_النطاق: طبيعي = (*المتغير).النطاق.القيمة;
        إذا (معرف_النطاق < (الطول((*السياق).النطاقات) مثل طبيعي)) {
            دع د: طبيعي = (*السياق).النطاقات[معرف_النطاق].الدالة.القيمة;
            إذا (د < (الطول(الناتج) مثل طبيعي)) { ألحق(الناتج[د], ف); };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أوصاف_دوال_دوارف_من_سياقات_تصحيح(
    التصحيح: &بيانات_تصحيح_مسير
): متجه وصف_دالة_دوارف {
    دع الناتج: متغير متجه وصف_دالة_دوارف = [];
    دع عدد_الدوال: طبيعي = الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي;
    دع فهرس_مسير: متجه اختياري معرف_دالة_مسير = ابن_فهرس_مسير_لدوال_تصحيح(&(*التصحيح).العقد, عدد_الدوال);
    دع نطاقات_بدالة: متجه متجه طبيعي = اجمع_نطاقات_تصحيح_بدالة(&(*التصحيح).الدلالي);
    دع متغيرات_بدالة: متجه متجه طبيعي = اجمع_متغيرات_تصحيح_بدالة(&(*التصحيح).الدلالي);
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الدوال) {
        دع الدالة_الدلالية: &دالة_تصحيح = &(*التصحيح).الدلالي.الدوال[ف];
        دع معرف_التصحيح: طبيعي = (*الدالة_الدلالية).المعرف.القيمة;
        إذا (معرف_التصحيح < (الطول(فهرس_مسير) مثل طبيعي)) {
        طابق فهرس_مسير[معرف_التصحيح] مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(معرف_مسير) -> {
        دع الدالة: معرف_دالة_منتقاة = معرف_دالة_منتقاة_من_مسير(معرف_مسير);
        دع المعاملات: متغير متجه وصف_معامل_دوارف = [];
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول((*الدالة_الدلالية).المعاملات) مثل طبيعي)) {
            دع معرف_المتغير: معرف_متغير_تصحيح = (*الدالة_الدلالية).المعاملات[م];
            إذا (معرف_المتغير.القيمة < (الطول((*التصحيح).الدلالي.المتغيرات) مثل طبيعي)) {
                دع المتغير: &متغير_تصحيح = &(*التصحيح).الدلالي.المتغيرات[معرف_المتغير.القيمة];
                دع الاسم: متجه ط8 = انسخ_اسم_تصحيح(&(*المتغير).الاسم);
                دع أصل_المتغير: معرف_أصل_مصدر = (*المتغير).الأصل;
                دع هوية_النوع: طبيعي = (*المتغير).النوع.القيمة;
                دع اصطناعي: منطقي = (*المتغير).اصطناعي;
                دع الوصف: وصف_معامل_دوارف = {
                    المتغير: معرف_المتغير,
                    الاسم: الاسم, الأصل: أصل_المتغير, هوية_النوع: هوية_النوع,
                    اصطناعي: اصطناعي
                };
                ألحق(المعاملات, الوصف);
            };
            م := م + 1;
        }
        دع النطاقات: متغير متجه وصف_نطاق_دوارف = [];
        إذا (معرف_التصحيح < (الطول(نطاقات_بدالة) مثل طبيعي)) {
            م := 0;
            طالما (م < (الطول(نطاقات_بدالة[معرف_التصحيح]) مثل طبيعي)) {
                دع موضع_النطاق: طبيعي = نطاقات_بدالة[معرف_التصحيح][م];
                دع النطاق: &نطاق_تصحيح = &(*التصحيح).الدلالي.النطاقات[موضع_النطاق];
                دع الأب: متغير اختياري طبيعي = اختياري.لا_شيء();
                طابق (*النطاق).الأب مع
                | اختياري.موجود(القيمة) -> { الأب := اختياري.موجود(القيمة.القيمة); }
                | اختياري.لا_شيء -> { };
                دع معرف_النطاق_الرقمي: طبيعي = (*النطاق).المعرف.القيمة;
                دع أصل_النطاق: معرف_أصل_مصدر = (*النطاق).الأصل;
                دع المضمنة: متغير اختياري طبيعي = اختياري.لا_شيء();
                طابق (*النطاق).الدالة_المضمنة مع
                | اختياري.موجود(القيمة) -> { المضمنة := اختياري.موجود(القيمة.القيمة); }
                | اختياري.لا_شيء -> { };
                دع موقع_الاستدعاء: متغير اختياري طبيعي = اختياري.لا_شيء();
                طابق (*النطاق).مضمن_عند مع
                | اختياري.موجود(القيمة) -> { موقع_الاستدعاء := اختياري.موجود(القيمة.القيمة); }
                | اختياري.لا_شيء -> { };
                دع الوصف: وصف_نطاق_دوارف = {
                    المعرف: معرف_النطاق_الرقمي, الأصل: أصل_النطاق, الأب: الأب,
                    المضمنة: المضمنة, موقع_الاستدعاء: موقع_الاستدعاء
                };
                ألحق(النطاقات, الوصف);
                م := م + 1;
            }
        };
        دع المحليات: متغير متجه وصف_متغير_دوارف = [];
        إذا (معرف_التصحيح < (الطول(متغيرات_بدالة) مثل طبيعي)) {
            م := 0;
            طالما (م < (الطول(متغيرات_بدالة[معرف_التصحيح]) مثل طبيعي)) {
                دع موضع_المتغير: طبيعي = متغيرات_بدالة[معرف_التصحيح][م];
                دع المتغير: &متغير_تصحيح = &(*التصحيح).الدلالي.المتغيرات[موضع_المتغير];
                دع معامل: منطقي = (*المتغير).الصنف == صنف_متغير_تصحيح.معامل();
                دع معامل_مضمن: متغير منطقي = خطأ;
                إذا (معامل) {
                    طابق (*الدالة_الدلالية).النطاق_الجذري مع
                    | اختياري.موجود(الجذر) -> { معامل_مضمن := الجذر.القيمة != (*المتغير).النطاق.القيمة; }
                    | اختياري.لا_شيء -> { };
                };
                إذا (!معامل || معامل_مضمن) {
                    دع الاسم: متجه ط8 = انسخ_اسم_تصحيح(&(*المتغير).الاسم);
                    دع معرف_المتغير_المحلي: معرف_متغير_تصحيح = (*المتغير).المعرف;
                    دع أصل_المتغير: معرف_أصل_مصدر = (*المتغير).الأصل;
                    دع نطاق_الإحاطة: طبيعي = (*المتغير).النطاق.القيمة;
                    دع هوية_النوع: طبيعي = (*المتغير).النوع.القيمة;
                    دع اصطناعي: منطقي = (*المتغير).اصطناعي;
                    دع الوصف: وصف_متغير_دوارف = {
                        المتغير: معرف_المتغير_المحلي,
                        معامل: معامل,
                        الاسم: الاسم, الأصل: أصل_المتغير,
                        نطاق_الإحاطة: نطاق_الإحاطة,
                        هوية_النوع: هوية_النوع, اصطناعي: اصطناعي
                    };
                    ألحق(المحليات, الوصف);
                };
                م := م + 1;
            }
        };
        دع اسم_الدالة: متجه ط8 = انسخ_اسم_تصحيح(&(*الدالة_الدلالية).الاسم);
        دع اسم_الربط: متجه ط8 = انسخ_اسم_تصحيح(&(*الدالة_الدلالية).اسم_الربط);
        دع نوع_الناتج: متغير اختياري طبيعي = اختياري.لا_شيء();
        طابق (*الدالة_الدلالية).الناتج مع
        | اختياري.موجود(النوع) -> { نوع_الناتج := اختياري.موجود(النوع.القيمة); }
        | اختياري.لا_شيء -> { };
        دع أصل_الدالة: معرف_أصل_مصدر = (*الدالة_الدلالية).الأصل;
        دع علني: منطقي = (*الدالة_الدلالية).علني;
        دع إعلان_فقط: منطقي = (*الدالة_الدلالية).إعلان_فقط;
        دع اصطناعي: منطقي = (*الدالة_الدلالية).اصطناعي;
        دع الوصف: وصف_دالة_دوارف = {
            الدالة: الدالة, معرف_التصحيح: معرف_التصحيح, الاسم: اسم_الدالة, اسم_الربط: اسم_الربط, الأصل: أصل_الدالة,
            المعاملات: المعاملات, نوع_الناتج: نوع_الناتج,
            النطاقات: النطاقات, المحليات: المحليات,
            علني: علني, إعلان_فقط: إعلان_فقط,
            اصطناعي: اصطناعي
        };
        ألحق(الناتج, الوصف);
        };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// DWARF consumers only query the location of each encoded function. Line,
// lexical-scope and variable ranges are already owned by machine debug; the
// encoded-origin vector must not be re-indexed or retained a second time.
عام نوع فهرس_دوال_دوارف = {
    المواضع: متجه اختياري طبيعي
};

عام عرف ابن_فهرس_دوال_دوارف(
    المواضع: &متجه موضع_دالة_دوارف,
    الأوصاف: &متجه وصف_دالة_دوارف,
    المديات: &متجه مدى_شفرة_آلة_بأصل
): فهرس_دوال_دوارف {
    دع الأعلى: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        إذا ((*المواضع)[ف].الدالة.القيمة > الأعلى) { الأعلى := (*المواضع)[ف].الدالة.القيمة; };
        ف := ف + 1;
    }
    دع الفهرس: متغير متجه اختياري طبيعي = [];
    ف := 0;
    طالما (ف <= الأعلى) { ألحق(الفهرس, اختياري.لا_شيء()); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        الفهرس[(*المواضع)[ف].الدالة.القيمة] := اختياري.موجود(ف);
        ف := ف + 1;
    }
    دع الناتج: فهرس_دوال_دوارف = { المواضع: الفهرس };
    أرجع الناتج;
}

عام عرف فهرس_موضع_دالة_دوارف(الفهرس: &فهرس_دوال_دوارف, الدالة: معرف_دالة_منتقاة): اختياري طبيعي {
    إذا (الدالة.القيمة >= (الطول((*الفهرس).المواضع) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*الفهرس).المواضع[الدالة.القيمة];
}


