استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.codegen.debug.model;
استورد compiler.msir.debug_contract;
استورد compiler.debuginfo.model;
استورد compiler.debuginfo.builder;
استورد compiler.source.provenance;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.msir.identifiers;

// Serialization adapter only. Rich function/scope/variable facts remain owned by
// compiler/debuginfo; machine locations remain owned by compiler/backend/codegen/debug.
عام عرف موقع_دوارف_من_موقع_آلة(الموقع: &موقع_آلة_تصحيح): موقع_قيمة_دوارف {
    طابق *الموقع مع
    | موقع_آلة_تصحيح.غير_متاح -> { أرجع موقع_قيمة_دوارف.غير_متاح(); }
    | موقع_آلة_تصحيح.سجل(السجل) -> { أرجع موقع_قيمة_دوارف.سجل(السجل); }
    | موقع_آلة_تصحيح.مكدس(السجل, الإزاحة) -> { أرجع موقع_قيمة_دوارف.مكدس(السجل, الإزاحة); };
}

عرف ابن_فهرس_مسير_لدوال_تصحيح(
    العقد: &عقد_تصحيح_مسير,
    عدد_الدوال: غير_موقع
): متجه اختيار معرف_دالة_مسير {
    دع الفهرس: متغير متجه اختيار معرف_دالة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الدوال) { ألحق(الفهرس, اختيار.لا_شيء()); ف := ف + 1; }
    ف := 0;
    بينما (ف < (الطول((*العقد).دوال) مثل غير_موقع)) {
        طابق (*العقد).دوال[ف] مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المعرف) -> {
            لو (المعرف.القيمة < عدد_الدوال) { الفهرس[المعرف.القيمة] := اختيار.بعض(معرف_دالة_مسير_من(ف)); };
        };
        ف := ف + 1;
    }
    أرجع الفهرس;
}

عرف اجمع_نطاقات_تصحيح_بدالة(السياق: &سياق_تصحيح): متجه متجه غير_موقع {
    دع الناتج: متغير متجه متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*السياق).الدوال) مثل غير_موقع)) { دع فارغ: متجه غير_موقع = []; ألحق(الناتج, فارغ); ف := ف + 1; }
    ف := 0;
    بينما (ف < (الطول((*السياق).النطاقات) مثل غير_موقع)) {
        دع د: غير_موقع = (*السياق).النطاقات[ف].الدالة.القيمة;
        لو (د < (الطول(الناتج) مثل غير_موقع)) { ألحق(الناتج[د], ف); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اجمع_متغيرات_تصحيح_بدالة(السياق: &سياق_تصحيح): متجه متجه غير_موقع {
    دع الناتج: متغير متجه متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*السياق).الدوال) مثل غير_موقع)) { دع فارغ: متجه غير_موقع = []; ألحق(الناتج, فارغ); ف := ف + 1; }
    ف := 0;
    بينما (ف < (الطول((*السياق).المتغيرات) مثل غير_موقع)) {
        دع المتغير: &متغير_تصحيح = &(*السياق).المتغيرات[ف];
        دع معرف_النطاق: غير_موقع = (*المتغير).النطاق.القيمة;
        لو (معرف_النطاق < (الطول((*السياق).النطاقات) مثل غير_موقع)) {
            دع د: غير_موقع = (*السياق).النطاقات[معرف_النطاق].الدالة.القيمة;
            لو (د < (الطول(الناتج) مثل غير_موقع)) { ألحق(الناتج[د], ف); };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أوصاف_دوال_دوارف_من_سياقات_تصحيح(
    التصحيح: &بيانات_تصحيح_مسير
): متجه وصف_دالة_دوارف {
    دع الناتج: متغير متجه وصف_دالة_دوارف = [];
    دع عدد_الدوال: غير_موقع = الطول((*التصحيح).الدلالي.الدوال) مثل غير_موقع;
    دع فهرس_مسير: متجه اختيار معرف_دالة_مسير = ابن_فهرس_مسير_لدوال_تصحيح(&(*التصحيح).العقد, عدد_الدوال);
    دع نطاقات_بدالة: متجه متجه غير_موقع = اجمع_نطاقات_تصحيح_بدالة(&(*التصحيح).الدلالي);
    دع متغيرات_بدالة: متجه متجه غير_موقع = اجمع_متغيرات_تصحيح_بدالة(&(*التصحيح).الدلالي);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الدوال) {
        دع الدالة_الدلالية: &دالة_تصحيح = &(*التصحيح).الدلالي.الدوال[ف];
        دع معرف_التصحيح: غير_موقع = (*الدالة_الدلالية).المعرف.القيمة;
        لو (معرف_التصحيح < (الطول(فهرس_مسير) مثل غير_موقع)) {
        طابق فهرس_مسير[معرف_التصحيح] مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(معرف_مسير) -> {
        دع الدالة: معرف_دالة_منتقاة = معرف_دالة_منتقاة_من_مسير(معرف_مسير);
        دع المعاملات: متغير متجه وصف_معامل_دوارف = [];
        دع م: متغير غير_موقع = 0;
        بينما (م < (الطول((*الدالة_الدلالية).المعاملات) مثل غير_موقع)) {
            دع معرف_المتغير: معرف_متغير_تصحيح = (*الدالة_الدلالية).المعاملات[م];
            لو (معرف_المتغير.القيمة < (الطول((*التصحيح).الدلالي.المتغيرات) مثل غير_موقع)) {
                دع المتغير: &متغير_تصحيح = &(*التصحيح).الدلالي.المتغيرات[معرف_المتغير.القيمة];
                دع الاسم: متجه غ8 = انسخ_اسم_تصحيح(&(*المتغير).الاسم);
                دع أصل_المتغير: معرف_أصل_مصدر = (*المتغير).الأصل;
                دع هوية_النوع: غير_موقع = (*المتغير).النوع.القيمة;
                دع اصطناعي: منطقي = (*المتغير).اصطناعي;
                دع الوصف: وصف_معامل_دوارف = {
                    المتغير: معرف_المتغير,
                    الاسم: الاسم, الأصل: أصل_المتغير, هوية_النوع: هوية_النوع,
                    اصطناعي: اصطناعي
                };
                ألحق(المعاملات, الوصف);
            };
            م := م + 1;
        }
        دع النطاقات: متغير متجه وصف_نطاق_دوارف = [];
        لو (معرف_التصحيح < (الطول(نطاقات_بدالة) مثل غير_موقع)) {
            م := 0;
            بينما (م < (الطول(نطاقات_بدالة[معرف_التصحيح]) مثل غير_موقع)) {
                دع موضع_النطاق: غير_موقع = نطاقات_بدالة[معرف_التصحيح][م];
                دع النطاق: &نطاق_تصحيح = &(*التصحيح).الدلالي.النطاقات[موضع_النطاق];
                دع الأب: متغير اختيار غير_موقع = اختيار.لا_شيء();
                طابق (*النطاق).الأب مع
                | اختيار.بعض(القيمة) -> { الأب := اختيار.بعض(القيمة.القيمة); }
                | اختيار.لا_شيء -> { };
                دع معرف_النطاق_الرقمي: غير_موقع = (*النطاق).المعرف.القيمة;
                دع أصل_النطاق: معرف_أصل_مصدر = (*النطاق).الأصل;
                دع الوصف: وصف_نطاق_دوارف = { المعرف: معرف_النطاق_الرقمي, الأصل: أصل_النطاق, الأب: الأب };
                ألحق(النطاقات, الوصف);
                م := م + 1;
            }
        };
        دع المحليات: متغير متجه وصف_متغير_دوارف = [];
        لو (معرف_التصحيح < (الطول(متغيرات_بدالة) مثل غير_موقع)) {
            م := 0;
            بينما (م < (الطول(متغيرات_بدالة[معرف_التصحيح]) مثل غير_موقع)) {
                دع موضع_المتغير: غير_موقع = متغيرات_بدالة[معرف_التصحيح][م];
                دع المتغير: &متغير_تصحيح = &(*التصحيح).الدلالي.المتغيرات[موضع_المتغير];
                لو ((*المتغير).الصنف != صنف_متغير_تصحيح.معامل()) {
                    دع الاسم: متجه غ8 = انسخ_اسم_تصحيح(&(*المتغير).الاسم);
                    دع معرف_المتغير_المحلي: معرف_متغير_تصحيح = (*المتغير).المعرف;
                    دع أصل_المتغير: معرف_أصل_مصدر = (*المتغير).الأصل;
                    دع نطاق_الإحاطة: غير_موقع = (*المتغير).النطاق.القيمة;
                    دع هوية_النوع: غير_موقع = (*المتغير).النوع.القيمة;
                    دع اصطناعي: منطقي = (*المتغير).اصطناعي;
                    دع الوصف: وصف_متغير_دوارف = {
                        المتغير: معرف_المتغير_المحلي,
                        الاسم: الاسم, الأصل: أصل_المتغير,
                        نطاق_الإحاطة: نطاق_الإحاطة,
                        هوية_النوع: هوية_النوع, اصطناعي: اصطناعي
                    };
                    ألحق(المحليات, الوصف);
                };
                م := م + 1;
            }
        };
        دع اسم_الدالة: متجه غ8 = انسخ_اسم_تصحيح(&(*الدالة_الدلالية).الاسم);
        دع اسم_الربط: متجه غ8 = انسخ_اسم_تصحيح(&(*الدالة_الدلالية).اسم_الربط);
        دع نوع_الناتج: متغير اختيار غير_موقع = اختيار.لا_شيء();
        طابق (*الدالة_الدلالية).الناتج مع
        | اختيار.بعض(النوع) -> { نوع_الناتج := اختيار.بعض(النوع.القيمة); }
        | اختيار.لا_شيء -> { };
        دع أصل_الدالة: معرف_أصل_مصدر = (*الدالة_الدلالية).الأصل;
        دع علني: منطقي = (*الدالة_الدلالية).علني;
        دع إعلان_فقط: منطقي = (*الدالة_الدلالية).إعلان_فقط;
        دع اصطناعي: منطقي = (*الدالة_الدلالية).اصطناعي;
        دع الوصف: وصف_دالة_دوارف = {
            الدالة: الدالة, الاسم: اسم_الدالة, اسم_الربط: اسم_الربط, الأصل: أصل_الدالة,
            المعاملات: المعاملات, نوع_الناتج: نوع_الناتج,
            النطاقات: النطاقات, المحليات: المحليات,
            علني: علني, إعلان_فقط: إعلان_فقط,
            اصطناعي: اصطناعي
        };
        ألحق(الناتج, الوصف);
        };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Dense serialization indexes shared by DWARF section writers.
عام نوع فهرس_دوال_دوارف = {
    المواضع: متجه اختيار غير_موقع,
    أوصاف: متجه اختيار غير_موقع,
    المديات: متجه متجه غير_موقع,
    بداية_تعليمات_مصدر: متجه غير_موقع
};

عام عرف أكبر_معرف_دالة_دوارف(
    المواضع: &متجه موضع_دالة_دوارف,
    الأوصاف: &متجه وصف_دالة_دوارف,
    المديات: &متجه مدى_شفرة_آلة_بأصل
): غير_موقع {
    دع الأعلى: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المواضع) مثل غير_موقع)) {
        لو ((*المواضع)[ف].الدالة.القيمة > الأعلى) { الأعلى := (*المواضع)[ف].الدالة.القيمة; };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(*الأوصاف) مثل غير_موقع)) {
        لو ((*الأوصاف)[ف].الدالة.القيمة > الأعلى) { الأعلى := (*الأوصاف)[ف].الدالة.القيمة; };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(*المديات) مثل غير_موقع)) {
        لو ((*المديات)[ف].الدالة.القيمة > الأعلى) { الأعلى := (*المديات)[ف].الدالة.القيمة; };
        ف := ف + 1;
    }
    أرجع الأعلى;
}

عام عرف ابن_فهرس_دوال_دوارف(
    المواضع: &متجه موضع_دالة_دوارف,
    الأوصاف: &متجه وصف_دالة_دوارف,
    المديات: &متجه مدى_شفرة_آلة_بأصل
): فهرس_دوال_دوارف {
    دع العدد: غير_موقع = أكبر_معرف_دالة_دوارف(المواضع, الأوصاف, المديات) + 1;
    دع فهرس_المواضع: متغير متجه اختيار غير_موقع = [];
    دع فهرس_الأوصاف: متغير متجه اختيار غير_موقع = [];
    دع فهرس_المديات: متغير متجه متجه غير_موقع = [];
    دع بدايات_المصدر: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع مديات_فارغة: متجه غير_موقع = [];
        ألحق(فهرس_المواضع, اختيار.لا_شيء());
        ألحق(فهرس_الأوصاف, اختيار.لا_شيء());
        ألحق(فهرس_المديات, مديات_فارغة);
        ألحق(بدايات_المصدر, 0);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(*المواضع) مثل غير_موقع)) {
        دع د: غير_موقع = (*المواضع)[ف].الدالة.القيمة;
        فهرس_المواضع[د] := اختيار.بعض(ف);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(*الأوصاف) مثل غير_موقع)) {
        دع د: غير_موقع = (*الأوصاف)[ف].الدالة.القيمة;
        فهرس_الأوصاف[د] := اختيار.بعض(ف);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(*المديات) مثل غير_موقع)) {
        دع د: غير_موقع = (*المديات)[ف].الدالة.القيمة;
        لو ((الطول(فهرس_المديات[د]) مثل غير_موقع) == 0 || (*المديات)[ف].إزاحة_بايت < بدايات_المصدر[د]) {
            بدايات_المصدر[د] := (*المديات)[ف].إزاحة_بايت;
        };
        ألحق(فهرس_المديات[د], ف);
        ف := ف + 1;
    }
    دع الناتج: فهرس_دوال_دوارف = {
        المواضع: فهرس_المواضع,
        أوصاف: فهرس_الأوصاف,
        المديات: فهرس_المديات,
        بداية_تعليمات_مصدر: بدايات_المصدر
    };
    أرجع الناتج;
}

عام عرف فهرس_موضع_دالة_دوارف(الفهرس: &فهرس_دوال_دوارف, الدالة: معرف_دالة_منتقاة): اختيار غير_موقع {
    لو (الدالة.القيمة >= (الطول((*الفهرس).المواضع) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*الفهرس).المواضع[الدالة.القيمة];
}


