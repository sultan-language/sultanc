استورد compiler.source.provenance;
استورد compiler.backend.codegen.selected_code_core;

عرف ألحق_ثوابت_رأس_سطور_دوارف(البايتات: &متغير متجه غ8): فراغ {
    ألحق_غ8_دوارف(البايتات, رمز_ثابت_رأس_سطر_دوارف(ثابت_رأس_سطر_دوارف.طول_تعليمة_أدنى()));
    ألحق_غ8_دوارف(البايتات, رمز_ثابت_رأس_سطر_دوارف(ثابت_رأس_سطر_دوارف.عمليات_تعليمة_قصوى()));
    ألحق_غ8_دوارف(البايتات, رمز_ثابت_رأس_سطر_دوارف(ثابت_رأس_سطر_دوارف.عبارة_افتراضية()));
    ألحق_غ8_دوارف(البايتات, رمز_ثابت_رأس_سطر_دوارف(ثابت_رأس_سطر_دوارف.قاعدة_سطر_مشفرة()));
    ألحق_غ8_دوارف(البايتات, رمز_ثابت_رأس_سطر_دوارف(ثابت_رأس_سطر_دوارف.نطاق_سطر()));
    ألحق_غ8_دوارف(البايتات, رمز_ثابت_رأس_سطر_دوارف(ثابت_رأس_سطر_دوارف.قاعدة_تعليمة()));
    دع أطوال: متجه غ8 = أطوال_تعليمات_سطر_قياسية_دوارف();
    ألحق_بايتات_دوارف(البايتات, &أطوال);
}

عرف ألحق_رأس_سطور_قديم_دوارف(البايتات: &متغير متجه غ8, السياسة: &سياسة_دوارف, الخريطة: &متغير خريطة_مصادر): فراغ {
    دع موضع_حجم_الرأس: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    ألحق_إزاحة_دوارف(البايتات, السياسة, 0);
    دع بداية_الرأس: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    ألحق_ثوابت_رأس_سطور_دوارف(البايتات);
    ألحق_غ8_دوارف(البايتات, 0); // empty include directories
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الخريطة).المصادر) مثل غير_موقع)) {
        ألحق_نص_صفري_دوارف(البايتات, &(*الخريطة).المصادر[ف].الاسم);
        ألحق_ليب128_دوارف(البايتات, 0); ألحق_ليب128_دوارف(البايتات, 0); ألحق_ليب128_دوارف(البايتات, 0);
        ف := ف + 1;
    }
    ألحق_غ8_دوارف(البايتات, 0);
    اكتب_إزاحة_دوارف(البايتات, السياسة, موضع_حجم_الرأس, (الطول(*البايتات) مثل غير_موقع) - بداية_الرأس);
}

عرف ألحق_رأس_سطور_حديث_دوارف(
    البايتات: &متغير متجه غ8,
    السياسة: &سياسة_دوارف,
    الخريطة: &متغير خريطة_مصادر,
    بيانات_سلاسل_السطور: &متغير متجه غ8,
    سلاسل_السطور: &متغير جدول_سلاسل_سطور_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    دع موضع_حجم_الرأس: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    ألحق_إزاحة_دوارف(البايتات, السياسة, 0);
    دع بداية_الرأس: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    ألحق_ثوابت_رأس_سطور_دوارف(البايتات);

    ألحق_غ8_دوارف(البايتات, 1); // directory entry format count
    ألحق_ليب128_دوارف(البايتات, رمز_نوع_محتوى_سطر_دوارف(نوع_محتوى_سطر_دوارف.مسار()));
    ألحق_ليب128_دوارف(البايتات, رمز_صيغة_دوارف(صيغة_دوارف.مرجع_سلسلة_سطور()));
    ألحق_ليب128_دوارف(البايتات, 1); // one canonical current directory
    ألحق_مرجع_قسم_دوارف(البايتات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.سطور(), قسم_بيانات_دوارف.سلاسل_سطور(), 0); // empty directory path

    ألحق_غ8_دوارف(البايتات, 2); // file entry format count
    ألحق_ليب128_دوارف(البايتات, رمز_نوع_محتوى_سطر_دوارف(نوع_محتوى_سطر_دوارف.مسار()));
    ألحق_ليب128_دوارف(البايتات, رمز_صيغة_دوارف(صيغة_دوارف.مرجع_سلسلة_سطور()));
    ألحق_ليب128_دوارف(البايتات, رمز_نوع_محتوى_سطر_دوارف(نوع_محتوى_سطر_دوارف.فهرس_دليل()));
    ألحق_ليب128_دوارف(البايتات, رمز_صيغة_دوارف(صيغة_دوارف.بيانات_ليب()));
    ألحق_ليب128_دوارف(البايتات, الطول((*الخريطة).المصادر) مثل غير_موقع);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الخريطة).المصادر) مثل غير_موقع)) {
        دع الاسم: متجه غ8 = بايتات_نص_سلسلة_دوارف(&(*الخريطة).المصادر[ف].الاسم);
        دع الإزاحة: غير_موقع = أدرج_في_سلاسل_سطور_دوارف(بيانات_سلاسل_السطور, سلاسل_السطور, &الاسم);
        ألحق_مرجع_قسم_دوارف(البايتات, السياسة, رقع_الأقسام, قسم_بيانات_دوارف.سطور(), قسم_بيانات_دوارف.سلاسل_سطور(), الإزاحة);
        ألحق_ليب128_دوارف(البايتات, 0);
        ف := ف + 1;
    }
    اكتب_إزاحة_دوارف(البايتات, السياسة, موضع_حجم_الرأس, (الطول(*البايتات) مثل غير_موقع) - بداية_الرأس);
}

عرف ألحق_عنوان_بداية_سلسلة_دوارف(
    ب: &متغير متجه غ8,
    السياسة: &سياسة_دوارف,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    العنوان: غير_موقع
): فراغ {
    ألحق_غ8_دوارف(ب, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.بادئة_تعليمة_سطر_ممتدة()));
    ألحق_ليب128_دوارف(ب, 1 + (*السياسة).حجم_العنوان);
    ألحق_غ8_دوارف(ب, رمز_تعليمة_سطر_ممتدة_دوارف(تعليمة_سطر_ممتدة_دوارف.حدد_عنوان()));
    ألحق_مرجع_عنوان_دوارف(ب, الرقع, قسم_عنوان_دوارف.سطور(), (*السياسة).حجم_العنوان, قاعدة_عنوان_دوارف.نص(), العنوان);
}

عرف ألحق_مميز_سطر_دوارف(ب: &متغير متجه غ8, المميز: غير_موقع): فراغ {
    لو (المميز == 0) { أرجع; };
    دع الحمولة: متغير متجه غ8 = [];
    ألحق_غ8_دوارف(&متغير الحمولة, رمز_تعليمة_سطر_ممتدة_دوارف(تعليمة_سطر_ممتدة_دوارف.حدد_مميز()));
    ألحق_ليب128_دوارف(&متغير الحمولة, المميز);
    ألحق_غ8_دوارف(ب, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.بادئة_تعليمة_سطر_ممتدة())); ألحق_ليب128_دوارف(ب, الطول(الحمولة) مثل غير_موقع); ألحق_بايتات_دوارف(ب, &الحمولة);
}

عرف اختم_سلسلة_سطور_دوارف(ب: &متغير متجه غ8): فراغ {
    ألحق_غ8_دوارف(ب, رمز_ثابت_بروتوكول_دوارف(ثابت_بروتوكول_دوارف.بادئة_تعليمة_سطر_ممتدة())); ألحق_ليب128_دوارف(ب, 1); ألحق_غ8_دوارف(ب, رمز_تعليمة_سطر_ممتدة_دوارف(تعليمة_سطر_ممتدة_دوارف.نهاية_تسلسل()));
}

عام عرف ابن_سطور_دوارف_من_آلة(
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    المواضع: &متجه موضع_دالة_دوارف,
    الدلالي: &سياق_تصحيح,
    آلة: &سياق_تصحيح_آلة,
    السياسة: &سياسة_دوارف,
    بيانات_سلاسل_السطور: &متغير متجه غ8,
    سلاسل_السطور: &متغير جدول_سلاسل_سطور_دوارف,
    البيانات: &متغير متجه غ8,
    الرقع: &متغير متجه رقعة_عنوان_دوارف,
    رقع_الأقسام: &متغير متجه رقعة_قسم_دوارف
): فراغ {
    دع بداية_الوحدة: غير_موقع = ابدأ_وحدة_دوارف(البيانات, السياسة);
    ألحق_غ16_دوارف(البيانات, رمز_إصدار_دوارف((*السياسة).الإصدار));
    لو ((*السياسة).حديث) {
        ألحق_غ8_دوارف(البيانات, (*السياسة).حجم_العنوان); ألحق_غ8_دوارف(البيانات, 0);
        ألحق_رأس_سطور_حديث_دوارف(البيانات, السياسة, الخريطة, بيانات_سلاسل_السطور, سلاسل_السطور, رقع_الأقسام);
    } وإلا {
        ألحق_رأس_سطور_قديم_دوارف(البيانات, السياسة, الخريطة);
    };

    دع أوصاف_فارغة: متجه وصف_دالة_دوارف = [];
    دع مديات_فارغة: متجه مدى_شفرة_آلة_بأصل = [];
    دع فهرس_الدوال: فهرس_دوال_دوارف = ابن_فهرس_دوال_دوارف(المواضع, &أوصاف_فارغة, &مديات_فارغة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*آلة).الدوال) مثل غير_موقع)) {
        دع دالة_الآلة: &تصحيح_دالة_آلة = &(*آلة).الدوال[ف];
        طابق فهرس_موضع_دالة_دوارف(&فهرس_الدوال, (*دالة_الآلة).الدالة) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(فهرس_الموضع) -> {
            دع موضع_الدالة: &موضع_دالة_دوارف = &(*المواضع)[فهرس_الموضع];
            لو ((الطول((*دالة_الآلة).مديات_السطور) مثل غير_موقع) > 0) {
                ألحق_عنوان_بداية_سلسلة_دوارف(البيانات, السياسة, الرقع, (*موضع_الدالة).إزاحة_بايت);
                دع العنوان_الحالي: متغير غير_موقع = (*موضع_الدالة).إزاحة_بايت;
                دع الملف_الحالي: متغير غير_موقع = رمز_ثابت_رأس_سطر_دوارف(ثابت_رأس_سطر_دوارف.ملف_ابتدائي());
                دع السطر_الحالي: متغير غير_موقع = 1;
                دع العمود_الحالي: متغير غير_موقع = 0;
                دع عبارة_حالية: متغير منطقي = صواب;
                دع م: متغير غير_موقع = 0;
                بينما (م < (الطول((*دالة_الآلة).مديات_السطور) مثل غير_موقع)) {
                    دع المدى: &مدى_سطر_آلة_تصحيح = &(*دالة_الآلة).مديات_السطور[م];
                    دع معرف_الموقع: غير_موقع = (*المدى).الموقع.القيمة;
                    لو (معرف_الموقع < (الطول((*الدلالي).المواقع) مثل غير_موقع)) {
                        دع موقع_التصحيح: &موقع_تصحيح = &(*الدلالي).المواقع[معرف_الموقع];
                        طابق أصل_مصدر_بالمعرف(سجل_الأصول, (*موقع_التصحيح).الأصل) مع
                        | اختيار.لا_شيء -> { }
                        | اختيار.بعض(وصف_الأصل) -> {
                            طابق إحداثي_من_الخريطة(الخريطة, وصف_الأصل.النطاق.البداية) مع
                            | اختيار.لا_شيء -> { }
                            | اختيار.بعض(الإحداثي) -> {
                                دع العنوان: غير_موقع = (*موضع_الدالة).إزاحة_بايت + (*المدى).بداية_بايت;
                                دع الملف: غير_موقع = فهرس_ملف_دوارف(السياسة, وصف_الأصل.النطاق.البداية.المصدر);
                                دع السطر: غير_موقع = الإحداثي.السطر مثل غير_موقع;
                                دع العمود_الصفري: غير_موقع = الإحداثي.العمود مثل غير_موقع;
                                دع العمود: غير_موقع = العمود_الصفري + 1;
                                لو (العنوان > العنوان_الحالي) { ألحق_غ8_دوارف(البيانات, رمز_تعليمة_سطر_دوارف(تعليمة_سطر_دوارف.تقدم_عنوان())); ألحق_ليب128_دوارف(البيانات, العنوان - العنوان_الحالي); العنوان_الحالي := العنوان; };
                                لو (الملف != الملف_الحالي) { ألحق_غ8_دوارف(البيانات, رمز_تعليمة_سطر_دوارف(تعليمة_سطر_دوارف.حدد_ملف())); ألحق_ليب128_دوارف(البيانات, الملف); الملف_الحالي := الملف; };
                                لو (السطر != السطر_الحالي) { ألحق_غ8_دوارف(البيانات, رمز_تعليمة_سطر_دوارف(تعليمة_سطر_دوارف.تقدم_سطر())); دع السطر_كعدد: عدد = السطر مثل عدد; دع السطر_الحالي_كعدد: عدد = السطر_الحالي مثل عدد; دع فرق_السطر: عدد = السطر_كعدد - السطر_الحالي_كعدد; ألحق_سليب128_دوارف(البيانات, فرق_السطر); السطر_الحالي := السطر; };
                                لو (العمود != العمود_الحالي) { ألحق_غ8_دوارف(البيانات, رمز_تعليمة_سطر_دوارف(تعليمة_سطر_دوارف.حدد_عمود())); ألحق_ليب128_دوارف(البيانات, العمود); العمود_الحالي := العمود; };
                                لو ((*موقع_التصحيح).هو_عبارة != عبارة_حالية) { ألحق_غ8_دوارف(البيانات, رمز_تعليمة_سطر_دوارف(تعليمة_سطر_دوارف.اعكس_عبارة())); عبارة_حالية := (*موقع_التصحيح).هو_عبارة; };
                                لو ((*موقع_التصحيح).نهاية_مقدمة) { ألحق_غ8_دوارف(البيانات, رمز_تعليمة_سطر_دوارف(تعليمة_سطر_دوارف.نهاية_مقدمة())); };
                                لو ((*موقع_التصحيح).بداية_خاتمة) { ألحق_غ8_دوارف(البيانات, رمز_تعليمة_سطر_دوارف(تعليمة_سطر_دوارف.بداية_خاتمة())); };
                                ألحق_مميز_سطر_دوارف(البيانات, (*موقع_التصحيح).المميز);
                                ألحق_غ8_دوارف(البيانات, رمز_تعليمة_سطر_دوارف(تعليمة_سطر_دوارف.نسخ()));
                            };
                        };
                    };
                    م := م + 1;
                }
                دع نهاية_الدالة: غير_موقع = (*موضع_الدالة).إزاحة_بايت + (*موضع_الدالة).حجم_بايت;
                لو (نهاية_الدالة > العنوان_الحالي) { ألحق_غ8_دوارف(البيانات, رمز_تعليمة_سطر_دوارف(تعليمة_سطر_دوارف.تقدم_عنوان())); ألحق_ليب128_دوارف(البيانات, نهاية_الدالة - العنوان_الحالي); };
                اختم_سلسلة_سطور_دوارف(البيانات);
            };
        };
        ف := ف + 1;
    }
    اختم_وحدة_دوارف(البيانات, السياسة, بداية_الوحدة);
}
