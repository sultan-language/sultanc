استورد compiler.source.source_map;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_model;

عرف انسخ_نص_دوارف(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عام عرف اسم_وحدة_دوارف(الخريطة: &متغير خريطة_مصادر): نص {
    لو ((الطول((*الخريطة).المصادر) مثل غير_موقع) > 0) {
        أرجع انسخ_نص_دوارف(&(*الخريطة).المصادر[0].الاسم);
    };
    أرجع "sultanc";
}

نوع مدخل_سلسلة_دوارف = {
    القيمة: متجه غ8,
    الإزاحة: غير_موقع,
    التالي: اختيار غير_موقع
};

// Append-only intern table. Bucket chains give indexed lookup without scanning
// the emitted byte section; insertion order determines stable offsets.
عام نوع جدول_سلاسل_دوارف = {
    المداخل: متجه مدخل_سلسلة_دوارف,
    الدلاء: متجه اختيار غير_موقع
};

عام نوع جدول_سلاسل_سطور_دوارف = {
    المداخل: متجه مدخل_سلسلة_دوارف,
    الدلاء: متجه اختيار غير_موقع
};

عرف دلاء_سلاسل_دوارف(السعة: غير_موقع): متجه اختيار غير_موقع {
    دع الدلاء: متغير متجه اختيار غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) { ألحق(الدلاء, اختيار.لا_شيء()); ف := ف + 1; }
    أرجع الدلاء;
}

عام عرف جدول_سلاسل_دوارف_فارغ(): جدول_سلاسل_دوارف {
    دع المداخل: متجه مدخل_سلسلة_دوارف = [];
    دع الدلاء: متجه اختيار غير_موقع = دلاء_سلاسل_دوارف(16);
    دع الناتج: جدول_سلاسل_دوارف = { المداخل: المداخل, الدلاء: الدلاء };
    أرجع الناتج;
}

عام عرف جدول_سلاسل_سطور_دوارف_فارغ(): جدول_سلاسل_سطور_دوارف {
    دع المداخل: متجه مدخل_سلسلة_دوارف = [];
    دع الدلاء: متجه اختيار غير_موقع = دلاء_سلاسل_دوارف(16);
    دع الناتج: جدول_سلاسل_سطور_دوارف = { المداخل: المداخل, الدلاء: الدلاء };
    أرجع الناتج;
}

عرف هاش_سلسلة_دوارف(القيمة: &متجه غ8): غير_موقع {
    دع هاش: متغير غير_موقع = 5381;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيمة) مثل غير_موقع)) {
        هاش := (هاش * 33 + ((*القيمة)[ف] مثل غير_موقع)) % 4294967291;
        ف := ف + 1;
    }
    أرجع هاش;
}

عرف سلسلتا_دوارف_متساويتان(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    لو ((الطول(*أ) مثل غير_موقع) != (الطول(*ب) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*أ) مثل غير_موقع)) {
        لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ابحث_سلسلة_دوارف(المداخل: &متجه مدخل_سلسلة_دوارف, الدلاء: &متجه اختيار غير_موقع, القيمة: &متجه غ8): اختيار غير_موقع {
    دع الدلو: غير_موقع = هاش_سلسلة_دوارف(القيمة) % (الطول(*الدلاء) مثل غير_موقع);
    دع الحالي: متغير اختيار غير_موقع = (*الدلاء)[الدلو];
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        طابق الحالي مع
        | اختيار.لا_شيء -> { مستمر := خطأ; }
        | اختيار.بعض(ف) -> {
            لو (سلسلتا_دوارف_متساويتان(&(*المداخل)[ف].القيمة, القيمة)) { أرجع اختيار.بعض(ف); };
            الحالي := (*المداخل)[ف].التالي;
        };
    }
    أرجع اختيار.لا_شيء();
}


عرف أعد_فهرسة_سلاسل_دوارف(
    المداخل: &متغير متجه مدخل_سلسلة_دوارف,
    الدلاء: &متغير متجه اختيار غير_موقع,
    السعة: غير_موقع
): فراغ {
    دع الجديدة: متغير متجه اختيار غير_موقع = دلاء_سلاسل_دوارف(السعة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المداخل) مثل غير_موقع)) {
        دع الدلو: غير_موقع = هاش_سلسلة_دوارف(&(*المداخل)[ف].القيمة) % السعة;
        (*المداخل)[ف].التالي := الجديدة[الدلو];
        الجديدة[الدلو] := اختيار.بعض(ف);
        ف := ف + 1;
    }
    *الدلاء := الجديدة;
}

عرف تأكد_سعة_سلاسل_دوارف(
    المداخل: &متغير متجه مدخل_سلسلة_دوارف,
    الدلاء: &متغير متجه اختيار غير_موقع
): فراغ {
    دع السعة: غير_موقع = الطول(*الدلاء) مثل غير_موقع;
    دع عدد_المداخل: غير_موقع = الطول(*المداخل) مثل غير_موقع;
    لو ((عدد_المداخل + 1) * 3 >= السعة * 2) {
        أعد_فهرسة_سلاسل_دوارف(المداخل, الدلاء, السعة * 2);
    };
}

عرف أدرج_سلسلة_دوارف(
    البايتات: &متغير متجه غ8,
    المداخل: &متغير متجه مدخل_سلسلة_دوارف,
    الدلاء: &متغير متجه اختيار غير_موقع,
    القيمة: &متجه غ8
): غير_موقع {
    طابق ابحث_سلسلة_دوارف(المداخل, الدلاء, القيمة) مع
    | اختيار.بعض(ف) -> { أرجع (*المداخل)[ف].الإزاحة; }
    | اختيار.لا_شيء -> { };
    تأكد_سعة_سلاسل_دوارف(المداخل, الدلاء);
    دع الإزاحة: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    ألحق_بايتات_صفرية_دوارف(البايتات, القيمة);
    دع الدلو: غير_موقع = هاش_سلسلة_دوارف(القيمة) % (الطول(*الدلاء) مثل غير_موقع);
    دع النسخة: متجه غ8 = انسخ_بايتات_دوارف(القيمة);
    دع التالي: اختيار غير_موقع = (*الدلاء)[الدلو];
    دع المدخل: مدخل_سلسلة_دوارف = { القيمة: النسخة, الإزاحة: الإزاحة, التالي: التالي };
    دع الفهرس: غير_موقع = الطول(*المداخل) مثل غير_موقع;
    ألحق(*المداخل, المدخل);
    (*الدلاء)[الدلو] := اختيار.بعض(الفهرس);
    أرجع الإزاحة;
}

عام عرف أدرج_في_سلاسل_دوارف(
    البايتات: &متغير متجه غ8,
    الجدول: &متغير جدول_سلاسل_دوارف,
    القيمة: &متجه غ8
): غير_موقع {
    دع الجدول_المتغير: متغير &متغير جدول_سلاسل_دوارف = الجدول;
    أرجع أدرج_سلسلة_دوارف(البايتات, &متغير (*الجدول_المتغير).المداخل, &متغير (*الجدول_المتغير).الدلاء, القيمة);
}

عام عرف أدرج_في_سلاسل_سطور_دوارف(
    البايتات: &متغير متجه غ8,
    الجدول: &متغير جدول_سلاسل_سطور_دوارف,
    القيمة: &متجه غ8
): غير_موقع {
    دع الجدول_المتغير: متغير &متغير جدول_سلاسل_سطور_دوارف = الجدول;
    أرجع أدرج_سلسلة_دوارف(البايتات, &متغير (*الجدول_المتغير).المداخل, &متغير (*الجدول_المتغير).الدلاء, القيمة);
}

عام عرف بايتات_نص_سلسلة_دوارف(النص: &نص): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*النص) مثل غير_موقع)) { ألحق(الناتج, (*النص)[ف] مثل غ8); ف := ف + 1; }
    أرجع الناتج;
}

عام عرف ألحق_اسم_دوارف(
    ب: &متغير متجه غ8,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه غ8,
    الجدول: &متغير جدول_سلاسل_دوارف,
    الرقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    القيمة: &متجه غ8
): فراغ {
    لو ((*السياسة).حديث) {
        دع الإزاحة: غير_موقع = أدرج_في_سلاسل_دوارف(بيانات_السلاسل, الجدول, القيمة);
        ألحق_مرجع_قسم_دوارف(ب, السياسة, الرقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.سلاسل(), الإزاحة);
    } وإلا {
        ألحق_بايتات_صفرية_دوارف(ب, القيمة);
    };
}

عام عرف ألحق_اسم_نصي_دوارف(
    ب: &متغير متجه غ8,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه غ8,
    الجدول: &متغير جدول_سلاسل_دوارف,
    الرقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    القيمة: &نص
): فراغ {
    لو ((*السياسة).حديث) {
        دع البايتات: متجه غ8 = بايتات_نص_سلسلة_دوارف(القيمة);
        دع الإزاحة: غير_موقع = أدرج_في_سلاسل_دوارف(بيانات_السلاسل, الجدول, &البايتات);
        ألحق_مرجع_قسم_دوارف(ب, السياسة, الرقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.سلاسل(), الإزاحة);
    } وإلا {
        ألحق_نص_صفري_دوارف(ب, القيمة);
    };
}
