استورد std.text.from_bytes;
استورد compiler.source.source_map;
استورد compiler.backend.object.dwarf.dwarf_byte_writer;
استورد compiler.backend.object.dwarf.dwarf_policy;
استورد compiler.backend.object.dwarf.dwarf_model;

عرف انسخ_نص_دوارف(القيمة: &نص): نص {
    دع النسخة: نص = انسخ_نص(القيمة);
    أرجع النسخة;
}

عام عرف اسم_وحدة_دوارف(الخريطة: &متغير خريطة_مصادر): نص {
    إذا ((الطول((*الخريطة).المصادر) مثل طبيعي) > 0) {
        أرجع انسخ_نص_دوارف(&(*الخريطة).المصادر[0].الاسم);
    };
    أرجع "sultanc";
}

نوع مدخل_سلسلة_دوارف = {
    القيمة: متجه ط8,
    الإزاحة: طبيعي,
    التالي: اختياري طبيعي
};

// Append-only intern table. Bucket chains give indexed lookup without scanning
// the emitted byte section; insertion order determines stable offsets.
عام نوع جدول_سلاسل_دوارف = {
    المداخل: متجه مدخل_سلسلة_دوارف,
    الدلاء: متجه اختياري طبيعي
};

عام نوع جدول_سلاسل_سطور_دوارف = {
    المداخل: متجه مدخل_سلسلة_دوارف,
    الدلاء: متجه اختياري طبيعي
};

عرف دلاء_سلاسل_دوارف(السعة: طبيعي): متجه اختياري طبيعي {
    دع الدلاء: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الدلاء, اختياري.لا_شيء()); ف := ف + 1; }
    أرجع الدلاء;
}

عام عرف جدول_سلاسل_دوارف_فارغ(): جدول_سلاسل_دوارف {
    دع المداخل: متجه مدخل_سلسلة_دوارف = [];
    دع الدلاء: متجه اختياري طبيعي = دلاء_سلاسل_دوارف(16);
    دع الناتج: جدول_سلاسل_دوارف = { المداخل: المداخل, الدلاء: الدلاء };
    أرجع الناتج;
}

عام عرف جدول_سلاسل_سطور_دوارف_فارغ(): جدول_سلاسل_سطور_دوارف {
    دع المداخل: متجه مدخل_سلسلة_دوارف = [];
    دع الدلاء: متجه اختياري طبيعي = دلاء_سلاسل_دوارف(16);
    دع الناتج: جدول_سلاسل_سطور_دوارف = { المداخل: المداخل, الدلاء: الدلاء };
    أرجع الناتج;
}

عرف هاش_سلسلة_دوارف(القيمة: &متجه ط8): طبيعي {
    دع هاش: متغير طبيعي = 5381;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        هاش := (هاش * 33 + ((*القيمة)[ف] مثل طبيعي)) % 4294967291;
        ف := ف + 1;
    }
    أرجع هاش;
}

عرف سلسلتا_دوارف_متساويتان(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ابحث_سلسلة_دوارف(المداخل: &متجه مدخل_سلسلة_دوارف, الدلاء: &متجه اختياري طبيعي, القيمة: &متجه ط8): اختياري طبيعي {
    دع الدلو: طبيعي = هاش_سلسلة_دوارف(القيمة) % (الطول(*الدلاء) مثل طبيعي);
    دع الحالي: متغير اختياري طبيعي = (*الدلاء)[الدلو];
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق الحالي مع
        | اختياري.لا_شيء -> { مستمر := خطأ; }
        | اختياري.موجود(ف) -> {
            إذا (سلسلتا_دوارف_متساويتان(&(*المداخل)[ف].القيمة, القيمة)) { أرجع اختياري.موجود(ف); };
            الحالي := (*المداخل)[ف].التالي;
        };
    }
    أرجع اختياري.لا_شيء();
}


عرف أعد_فهرسة_سلاسل_دوارف(
    المداخل: &متغير متجه مدخل_سلسلة_دوارف,
    الدلاء: &متغير متجه اختياري طبيعي,
    السعة: طبيعي
): فراغ {
    دع الجديدة: متغير متجه اختياري طبيعي = دلاء_سلاسل_دوارف(السعة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المداخل) مثل طبيعي)) {
        دع الدلو: طبيعي = هاش_سلسلة_دوارف(&(*المداخل)[ف].القيمة) % السعة;
        (*المداخل)[ف].التالي := الجديدة[الدلو];
        الجديدة[الدلو] := اختياري.موجود(ف);
        ف := ف + 1;
    }
    *الدلاء := الجديدة;
}

عرف تأكد_سعة_سلاسل_دوارف(
    المداخل: &متغير متجه مدخل_سلسلة_دوارف,
    الدلاء: &متغير متجه اختياري طبيعي
): فراغ {
    دع السعة: طبيعي = الطول(*الدلاء) مثل طبيعي;
    دع عدد_المداخل: طبيعي = الطول(*المداخل) مثل طبيعي;
    إذا ((عدد_المداخل + 1) * 3 >= السعة * 2) {
        أعد_فهرسة_سلاسل_دوارف(المداخل, الدلاء, السعة * 2);
    };
}

عرف أدرج_سلسلة_دوارف(
    البايتات: &متغير متجه ط8,
    المداخل: &متغير متجه مدخل_سلسلة_دوارف,
    الدلاء: &متغير متجه اختياري طبيعي,
    القيمة: &متجه ط8
): طبيعي {
    طابق ابحث_سلسلة_دوارف(المداخل, الدلاء, القيمة) مع
    | اختياري.موجود(ف) -> { أرجع (*المداخل)[ف].الإزاحة; }
    | اختياري.لا_شيء -> { };
    تأكد_سعة_سلاسل_دوارف(المداخل, الدلاء);
    دع الإزاحة: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_بايتات_صفرية_دوارف(البايتات, القيمة);
    دع الدلو: طبيعي = هاش_سلسلة_دوارف(القيمة) % (الطول(*الدلاء) مثل طبيعي);
    دع النسخة: متجه ط8 = انسخ_بايتات_دوارف(القيمة);
    دع التالي: اختياري طبيعي = (*الدلاء)[الدلو];
    دع المدخل: مدخل_سلسلة_دوارف = { القيمة: النسخة, الإزاحة: الإزاحة, التالي: التالي };
    دع الفهرس: طبيعي = الطول(*المداخل) مثل طبيعي;
    ألحق(*المداخل, المدخل);
    (*الدلاء)[الدلو] := اختياري.موجود(الفهرس);
    أرجع الإزاحة;
}

عام عرف أدرج_في_سلاسل_دوارف(
    البايتات: &متغير متجه ط8,
    الجدول: &متغير جدول_سلاسل_دوارف,
    القيمة: &متجه ط8
): طبيعي {
    دع الجدول_المتغير: متغير &متغير جدول_سلاسل_دوارف = الجدول;
    أرجع أدرج_سلسلة_دوارف(البايتات, &متغير (*الجدول_المتغير).المداخل, &متغير (*الجدول_المتغير).الدلاء, القيمة);
}

عام عرف أدرج_في_سلاسل_سطور_دوارف(
    البايتات: &متغير متجه ط8,
    الجدول: &متغير جدول_سلاسل_سطور_دوارف,
    القيمة: &متجه ط8
): طبيعي {
    دع الجدول_المتغير: متغير &متغير جدول_سلاسل_سطور_دوارف = الجدول;
    أرجع أدرج_سلسلة_دوارف(البايتات, &متغير (*الجدول_المتغير).المداخل, &متغير (*الجدول_المتغير).الدلاء, القيمة);
}

عام عرف بايتات_نص_سلسلة_دوارف(النص: &نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق(الناتج, (*النص)[ف] مثل ط8); ف := ف + 1; }
    أرجع الناتج;
}

عام عرف ألحق_اسم_دوارف(
    ب: &متغير متجه ط8,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه ط8,
    الجدول: &متغير جدول_سلاسل_دوارف,
    الرقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    القيمة: &متجه ط8
): فراغ {
    إذا ((*السياسة).حديث) {
        دع الإزاحة: طبيعي = أدرج_في_سلاسل_دوارف(بيانات_السلاسل, الجدول, القيمة);
        ألحق_مرجع_قسم_دوارف(ب, السياسة, الرقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.سلاسل(), الإزاحة);
    } وإلا {
        ألحق_بايتات_صفرية_دوارف(ب, القيمة);
    };
}

عام عرف ألحق_اسم_نصي_دوارف(
    ب: &متغير متجه ط8,
    السياسة: &سياسة_دوارف,
    بيانات_السلاسل: &متغير متجه ط8,
    الجدول: &متغير جدول_سلاسل_دوارف,
    الرقع_الأقسام: &متغير متجه رقعة_قسم_دوارف,
    القيمة: &نص
): فراغ {
    إذا ((*السياسة).حديث) {
        دع البايتات: متجه ط8 = بايتات_نص_سلسلة_دوارف(القيمة);
        دع الإزاحة: طبيعي = أدرج_في_سلاسل_دوارف(بيانات_السلاسل, الجدول, &البايتات);
        ألحق_مرجع_قسم_دوارف(ب, السياسة, الرقع_الأقسام, قسم_بيانات_دوارف.معلومات(), قسم_بيانات_دوارف.سلاسل(), الإزاحة);
    } وإلا {
        ألحق_نص_صفري_دوارف(ب, القيمة);
    };
}
