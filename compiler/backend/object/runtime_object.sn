استورد compiler.backend.object.macho.macho_writer;
استورد compiler.backend.object.macho.macho_format;
استورد compiler.backend.architectures.arm64.systems.macos.runtime_rules;
استورد compiler.backend.architectures.x86_64.encoded_code;
استورد compiler.backend.architectures.x86_64.systems.linux.runtime_rules;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.object.object_reference_model;
استورد compiler.backend.object.elf.elf_format;
استورد compiler.backend.target.native_output_capability;
استورد compiler.backend.target.target_model;
استورد compiler.runtime.primitive_runtime_abi;

عام نوع نتيجة_كائن_تشغيل_هدف =
    | نجح بنوع متجه غ8
    | هدف_غير_مدعوم
    | إكمال_تشغيل_فشل بنوع خطأ_إكمال_ترميز_تشغيل_إكس
    | تسلسل_كائن_فشل بنوع خطأ_إلف
    | تسلسل_كائن_ماتشو_فشل بنوع خطأ_ماتشو
;

// Runtime code is emitted by the target runtime owner and serialized as an
// ordinary relocatable object. The linker never depends on the codegen backend.
عام عرف ابن_كائن_تشغيل_للهدف(
    الهدف: &واصف_هدف,
    التصديرات: &متجه هوية_تصدير_تشغيل,
    أضف_دخول_عملية: منطقي
): نتيجة_كائن_تشغيل_هدف {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        طابق اكتب_كائن_تشغيل_ماتشو_ذراع_أربعة_وستون(الهدف, التصديرات) مع
        | نتيجة_تسلسل_ماتشو.نجح(البايتات) -> {
            أرجع نتيجة_كائن_تشغيل_هدف.نجح(البايتات);
        }
        | نتيجة_تسلسل_ماتشو.خطأ(الخطأ) -> {
            أرجع نتيجة_كائن_تشغيل_هدف.تسلسل_كائن_ماتشو_فشل(الخطأ);
        };
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { }
    | _ -> { أرجع نتيجة_كائن_تشغيل_هدف.هدف_غير_مدعوم(); };

    دع البيانات: متجه غ8 = [];
    دع الدوال: متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = [];
    دع الفروع: متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع النداءات: متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع الأصول: متجه مدى_شفرة_آلة_بأصل = [];
    دع مواضع_التصدير: متجه موضع_تصدير_تشغيل_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع المرفقات: مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    دع بلا_دخول: اختيار دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = اختيار.لا_شيء();
    دع معرف_الهدف: معرف_هدف = (*الهدف).المعرف;
    دع الأولية: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
        الهدف: معرف_الهدف,
        البيانات: البيانات,
        الدوال: الدوال,
        تثبيتات_الفروع: الفروع,
        إزاحات_النداء: النداءات,
        أصول_الآلة: الأصول,
        تصديرات_التشغيل: مواضع_التصدير,
        المرفقات: المرفقات,
        دخول_عملية_لينكس: بلا_دخول
    };
    دع الشفرة: متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = الأولية;
    دع الرموز_الخارجية: متغير متجه متجه غ8 = [];
    لو (أضف_دخول_عملية) {
        دع اسم_الرئيسي: متجه غ8 = [0x6d, 0x61, 0x69, 0x6e];
        ألحق(الرموز_الخارجية, اسم_الرئيسي);
    };
    دع بلا_دالة_دخول: اختيار معرف_دالة_منتقاة = اختيار.لا_شيء();

    طابق أكمل_ترميز_تشغيل_إكس_للهدف(
        &متغير الشفرة,
        الهدف,
        بلا_دالة_دخول,
        &متغير الرموز_الخارجية,
        التصديرات
    ) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_كائن_تشغيل_هدف.إكمال_تشغيل_فشل(الخطأ);
    }
    | اختيار.لا_شيء -> { };

    لو (أضف_دخول_عملية) {
        دع بيانات_الشفرة: متغير متجه غ8 = [];
        دع فهرس_بايت_الشفرة: متغير غير_موقع = 0;
        بينما (فهرس_بايت_الشفرة < (الطول(الشفرة.البيانات) مثل غير_موقع)) {
            ألحق(بيانات_الشفرة, الشفرة.البيانات[فهرس_بايت_الشفرة]);
            فهرس_بايت_الشفرة := فهرس_بايت_الشفرة + 1;
        }
        دع بداية_الدخول: غير_موقع = الطول(بيانات_الشفرة) مثل غير_موقع;
        دع موضع_الحقل: غير_موقع =
            ألحق_دخول_عملية_لينكس_إكس(&متغير بيانات_الشفرة);
        دع نهاية_الدخول: غير_موقع = الطول(بيانات_الشفرة) مثل غير_موقع;
        الشفرة.البيانات := بيانات_الشفرة;
        دع معرف_الرئيسي: معرف_دالة_خارجية_منتقاة = { القيمة: 0 };
        دع مرجع_الرئيسي: مرجع_رمز_كائن =
            مرجع_رمز_كائن.رمز_خارجي(معرف_الرئيسي);
        دع إزاحة_الدخول: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: موضع_الحقل,
            النوع: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء(),
            الرمز: مرجع_الرئيسي,
            الإضافة: -4
        };
        ألحق(الشفرة.إزاحات_النداء, إزاحة_الدخول);
        دع فهرس_عدد_الوسائط: معرف_دالة_خارجية_منتقاة = {
            القيمة: (الطول(الرموز_الخارجية) مثل غير_موقع) - 3
        };
        دع فهرس_مؤشر_الوسائط: معرف_دالة_خارجية_منتقاة = {
            القيمة: (الطول(الرموز_الخارجية) مثل غير_موقع) - 2
        };
        ألحق_إزاحة_حالة_العملية_لينكس_إكس(&متغير الشفرة.إزاحات_النداء,
            بداية_الدخول + 46, فهرس_عدد_الوسائط);
        ألحق_إزاحة_حالة_العملية_لينكس_إكس(&متغير الشفرة.إزاحات_النداء,
            بداية_الدخول + 53, فهرس_مؤشر_الوسائط);
        دع فهرس_حالة_المخصص: معرف_دالة_خارجية_منتقاة = {
            القيمة: (الطول(الرموز_الخارجية) مثل غير_موقع) - 1
        };
        ألحق_إزاحة_حالة_العملية_لينكس_إكس(&متغير الشفرة.إزاحات_النداء,
            بداية_الدخول + 60, فهرس_حالة_المخصص);
        دع دخول_العملية: دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: بداية_الدخول,
            حجم_بايت: نهاية_الدخول - بداية_الدخول
        };
        الشفرة.دخول_عملية_لينكس := اختيار.بعض(دخول_العملية);
    };

    طابق اكتب_كائن_تشغيل_إلف_إكس_ستة_وثمانون_أربعة_وستون(&الشفرة, الهدف, &الرموز_الخارجية) مع
    | نتيجة_تسلسل_إلف.نجح(البايتات) -> {
        أرجع نتيجة_كائن_تشغيل_هدف.نجح(البايتات);
    }
    | نتيجة_تسلسل_إلف.خطأ(الخطأ) -> {
        أرجع نتيجة_كائن_تشغيل_هدف.تسلسل_كائن_فشل(الخطأ);
    };
}
