استورد compiler.backend.object.dwarf.dwarf_model;
استورد compiler.backend.object.dwarf.dwarf_types;
استورد compiler.backend.codegen.debug.model;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.debuginfo.model;
استورد compiler.msir.debug_contract;
استورد compiler.msir.identifiers;
استورد compiler.source.source_map;
استورد compiler.source.provenance;
استورد compiler.frontend.types.type_context;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.target.target_model;
استورد المكتبة.نصوص.من_بايتات;

// CodeView debug information of an x86-64 COFF object, as MSVC and clang-cl
// emit it ("C13"; LLVM's CodeViewDebug, the Microsoft PDB's cvinfo.h):
//
//   .debug$S  CV_SIGNATURE_C13, then, per function, a symbol subsection
//             (S_GPROC32, S_FRAMEPROC, each local's S_LOCAL with its
//             S_DEFRANGE_* records, S_END) and its line subsection; then the
//             globals (S_GDATA32/S_LDATA32) and named types (S_UDT); then the
//             file checksums (no checksum, only the name) and the string
//             table they name the files in.
//   .debug$T  CV_SIGNATURE_C13, then the type records, from index 0x1000.
//
// An address in .debug$S is a pair of relocations against the function's
// (or global's) symbol: IMAGE_REL_AMD64_SECREL on the 32-bit offset (the
// field holds the offset from the symbol) and IMAGE_REL_AMD64_SECTION on the
// 16-bit section index. The linker builds the PDB from these sections.
//
// The types come from the same layout-backed descriptions the DWARF writer
// serializes (dwarf_types.sn): scalars are CodeView's built-in types; a
// pointer, reference or box is LF_POINTER; a record (or a tagged Type's
// payload) LF_STRUCTURE, first declared forward so a pointer can refer to it
// before its fields; a tag LF_ENUM of its constructors; an alias its target
// (and an S_UDT with its name). A tagged Type lists its tag and, for each
// constructor with a payload, a member of that constructor's name whose type
// holds the payload's fields at their offsets in the whole value.

عام نوع إزاحة_كود_فيو = {
    // Byte offset in the .debug$S section.
    الموضع: طبيعي,
    // COFF symbol table index of the target.
    الرمز: طبيعي,
    // IMAGE_REL_AMD64_SECREL (0x0B) or IMAGE_REL_AMD64_SECTION (0x0A).
    النوع: طبيعي
};

عام نوع دالة_كود_فيو = {
    الدالة: معرف_دالة_منتقاة,
    حجم_بايت: طبيعي,
    // COFF symbol table index of the function's symbol.
    الرمز: طبيعي,
    // CFA minus RSP once the prologue has run: the stack allocation plus
    // the return address. A frame offset from the CFA becomes an offset from
    // that RSP, CodeView's frame pointer for x64 code without one.
    بعد_الإطار: طبيعي
};

عام نوع عام_كود_فيو = {
    العام: معرف_عام_مسير,
    الرمز: طبيعي
};

عام نوع ناتج_كود_فيو = {
    الرموز: متجه ط8,
    إزاحات_الرموز: متجه إزاحة_كود_فيو,
    الأنواع: متجه ط8
};

عرف ط8_كف(ب: &متغير متجه ط8, ق: طبيعي): فراغ { ألحق(*ب, (ق % 256) مثل ط8); }

عرف ط16_كف(ب: &متغير متجه ط8, ق: طبيعي): فراغ {
    ط8_كف(ب, ق % 256);
    ط8_كف(ب, (ق / 256) % 256);
}

عرف ط32_كف(ب: &متغير متجه ط8, ق: طبيعي): فراغ {
    ط16_كف(ب, ق % 65536);
    ط16_كف(ب, (ق / 65536) % 65536);
}

عرف ط64_كف(ب: &متغير متجه ط8, ق: طبيعي): فراغ {
    ط32_كف(ب, ق % 4294967296);
    ط32_كف(ب, ق / 4294967296);
}

// A signed 32-bit field, two's complement.
عرف ص32_كف(ب: &متغير متجه ط8, ق: عدد): فراغ {
    إذا (ق < 0) {
        دع الموجب: طبيعي = (0 - ق) مثل طبيعي;
        ط32_كف(ب, 4294967296 - (الموجب % 4294967296));
    } وإلا {
        ط32_كف(ب, ق مثل طبيعي);
    };
}

عرف اكتب_ط16_كف(ب: &متغير متجه ط8, الموضع: طبيعي, ق: طبيعي): فراغ {
    (*ب)[الموضع] := (ق % 256) مثل ط8;
    دع الموضع_التالي: طبيعي = الموضع + 1;
    (*ب)[الموضع_التالي] := ((ق / 256) % 256) مثل ط8;
}

عرف اكتب_ط32_كف(ب: &متغير متجه ط8, الموضع: طبيعي, ق: طبيعي): فراغ {
    اكتب_ط16_كف(ب, الموضع, ق % 65536);
    اكتب_ط16_كف(ب, الموضع + 2, (ق / 65536) % 65536);
}

// A NUL-terminated UTF-8 name.
عرف اسم_كف(ب: &متغير متجه ط8, الاسم: &متجه ط8): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
        إذا ((*الاسم)[ف] != 0) { ألحق(*ب, (*الاسم)[ف]); };
        ف := ف + 1;
    }
    ألحق(*ب, 0 مثل ط8);
}

// A numeric leaf: the value itself below 0x8000, else LF_ULONG/LF_UQUADWORD.
عرف عددي_كف(ب: &متغير متجه ط8, ق: طبيعي): فراغ {
    إذا (ق < 0x8000) { ط16_كف(ب, ق); أرجع; };
    إذا (ق <= 0xFFFFFFFF) { ط16_كف(ب, 0x8004); ط32_كف(ب, ق); أرجع; };
    ط16_كف(ب, 0x800A);
    ط64_كف(ب, ق);
}

// ---- Type records (.debug$T) ------------------------------------------------

نوع حالة_أنواع_كف = {
    البيانات: متجه ط8,
    التالي: طبيعي,
    // DWARF type identity -> CodeView type index (0: not made yet).
    الفهارس: متجه طبيعي,
    // Composite identity -> its forward-declared LF_STRUCTURE.
    الأمامية: متجه طبيعي,
    // Identity -> 1 + its position in the descriptions (0: none).
    المواضع: متجه طبيعي
};

// A type record: the length (patched by اختم_سجل_نوع_كف) and the kind.
عرف ابدأ_سجل_نوع_كف(ب: &متغير متجه ط8, النوع: طبيعي): طبيعي {
    دع الموضع: طبيعي = الطول(*ب) مثل طبيعي;
    ط16_كف(ب, 0);
    ط16_كف(ب, النوع);
    أرجع الموضع;
}

// Pads with LF_PADn bytes to a 4-byte boundary from the record's start.
عرف حاذ_سجل_نوع_كف(ب: &متغير متجه ط8, البداية: طبيعي): فراغ {
    طالما (((الطول(*ب) مثل طبيعي) - البداية) % 4 != 0) {
        دع الباقي: طبيعي = 4 - (((الطول(*ب) مثل طبيعي) - البداية) % 4);
        ط8_كف(ب, 0xF0 + الباقي);
    }
}

عرف اختم_سجل_نوع_كف(ب: &متغير متجه ط8, البداية: طبيعي): فراغ {
    حاذ_سجل_نوع_كف(ب, البداية);
    اكتب_ط16_كف(ب, البداية, (الطول(*ب) مثل طبيعي) - البداية - 2);
}

// The next type index for a record just closed.
عرف خذ_فهرسا_كف(الحالة: &متغير حالة_أنواع_كف): طبيعي {
    دع الفهرس: طبيعي = (*الحالة).التالي;
    (*الحالة).التالي := الفهرس + 1;
    أرجع الفهرس;
}

// CodeView's built-in type (cvinfo.h CV_PRIMITIVE_TYPE) of a scalar.
عرف نوع_مدمج_كف(الصنف: &صنف_نوع_دوارف, الحجم: طبيعي): طبيعي {
    طابق *الصنف مع
    | صنف_نوع_دوارف.أساسي_موقع -> {
        إذا (الحجم == 1) { أرجع 0x68; }; إذا (الحجم == 2) { أرجع 0x72; };
        إذا (الحجم == 4) { أرجع 0x74; }; إذا (الحجم == 16) { أرجع 0x78; };
        أرجع 0x76;
    }
    | صنف_نوع_دوارف.أساسي_طبيعي -> {
        إذا (الحجم == 1) { أرجع 0x69; }; إذا (الحجم == 2) { أرجع 0x73; };
        إذا (الحجم == 4) { أرجع 0x75; }; إذا (الحجم == 16) { أرجع 0x79; };
        أرجع 0x77;
    }
    | صنف_نوع_دوارف.أساسي_منطقي -> {
        إذا (الحجم == 2) { أرجع 0x31; }; إذا (الحجم == 4) { أرجع 0x32; };
        إذا (الحجم == 8) { أرجع 0x33; };
        أرجع 0x30;
    }
    | صنف_نوع_دوارف.أساسي_عشري -> {
        إذا (الحجم == 4) { أرجع 0x40; }; إذا (الحجم == 2) { أرجع 0x46; };
        إذا (الحجم == 16) { أرجع 0x43; };
        أرجع 0x41;
    }
    | صنف_نوع_دوارف.أساسي_محرف -> {
        إذا (الحجم == 2) { أرجع 0x7A; }; إذا (الحجم == 4) { أرجع 0x7B; };
        أرجع 0x70;
    }
    | _ -> { أرجع 0; };
}

// A unique name shared by a structure's forward declaration and definition.
عرف اسم_فريد_كف(الهوية: طبيعي, اللاحقة: طبيعي): متجه ط8 {
    دع الاسم: متغير متجه ط8 = بايتات_من_نص(«sultanc$»);
    دع الأرقام: متغير متجه ط8 = [];
    دع ق: متغير طبيعي = الهوية;
    إذا (ق == 0) { ألحق(الأرقام, 0x30 مثل ط8); };
    طالما (ق > 0) { ألحق(الأرقام, (0x30 + ق % 10) مثل ط8); ق := ق / 10; }
    دع ف: متغير طبيعي = الطول(الأرقام) مثل طبيعي;
    طالما (ف > 0) { ف := ف - 1; ألحق(الاسم, الأرقام[ف]); }
    إذا (اللاحقة > 0) {
        ألحق(الاسم, 0x24 مثل ط8);
        دع ل: متغير طبيعي = اللاحقة;
        دع أرقام_اللاحقة: متغير متجه ط8 = [];
        طالما (ل > 0) { ألحق(أرقام_اللاحقة, (0x30 + ل % 10) مثل ط8); ل := ل / 10; }
        ف := الطول(أرقام_اللاحقة) مثل طبيعي;
        طالما (ف > 0) { ف := ف - 1; ألحق(الاسم, أرقام_اللاحقة[ف]); }
    };
    أرجع الاسم;
}

// LF_STRUCTURE: a forward declaration (no fields) or a definition.
عرف ألحق_بنية_كف(
    الحالة: &متغير حالة_أنواع_كف,
    العدد: طبيعي,
    القائمة: طبيعي,
    الحجم: طبيعي,
    الاسم: &متجه ط8,
    الاسم_الفريد: &متجه ط8,
    أمامي: منطقي
): طبيعي {
    دع البداية: طبيعي = ابدأ_سجل_نوع_كف(&متغير (*الحالة).البيانات, 0x1505);
    ط16_كف(&متغير (*الحالة).البيانات, العدد);
    // HasUniqueName, and ForwardRef for a declaration.
    إذا (أمامي) { ط16_كف(&متغير (*الحالة).البيانات, 0x0280); } وإلا { ط16_كف(&متغير (*الحالة).البيانات, 0x0200); };
    ط32_كف(&متغير (*الحالة).البيانات, القائمة);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    عددي_كف(&متغير (*الحالة).البيانات, الحجم);
    اسم_كف(&متغير (*الحالة).البيانات, الاسم);
    اسم_كف(&متغير (*الحالة).البيانات, الاسم_الفريد);
    اختم_سجل_نوع_كف(&متغير (*الحالة).البيانات, البداية);
    أرجع خذ_فهرسا_كف(الحالة);
}

// LF_POINTER: a 64-bit near pointer (CV_PTR_64, CV_PTR_MODE_PTR, size 8).
عرف ألحق_مؤشر_كف(الحالة: &متغير حالة_أنواع_كف, الداخل: طبيعي): طبيعي {
    دع البداية: طبيعي = ابدأ_سجل_نوع_كف(&متغير (*الحالة).البيانات, 0x1002);
    ط32_كف(&متغير (*الحالة).البيانات, الداخل);
    ط32_كف(&متغير (*الحالة).البيانات, 0x0C + 8 * 8192);
    اختم_سجل_نوع_كف(&متغير (*الحالة).البيانات, البداية);
    أرجع خذ_فهرسا_كف(الحالة);
}

// LF_ARGLIST then LF_PROCEDURE (near C call).
عرف ألحق_إجراء_كف(الحالة: &متغير حالة_أنواع_كف, المعاملات: &متجه طبيعي, الناتج: طبيعي): طبيعي {
    دع البداية: طبيعي = ابدأ_سجل_نوع_كف(&متغير (*الحالة).البيانات, 0x1201);
    ط32_كف(&متغير (*الحالة).البيانات, الطول(*المعاملات) مثل طبيعي);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعاملات) مثل طبيعي)) { ط32_كف(&متغير (*الحالة).البيانات, (*المعاملات)[ف]); ف := ف + 1; }
    اختم_سجل_نوع_كف(&متغير (*الحالة).البيانات, البداية);
    دع القائمة: طبيعي = خذ_فهرسا_كف(الحالة);
    دع بداية_الإجراء: طبيعي = ابدأ_سجل_نوع_كف(&متغير (*الحالة).البيانات, 0x1008);
    ط32_كف(&متغير (*الحالة).البيانات, الناتج);
    ط8_كف(&متغير (*الحالة).البيانات, 0);
    ط8_كف(&متغير (*الحالة).البيانات, 0);
    ط16_كف(&متغير (*الحالة).البيانات, الطول(*المعاملات) مثل طبيعي);
    ط32_كف(&متغير (*الحالة).البيانات, القائمة);
    اختم_سجل_نوع_كف(&متغير (*الحالة).البيانات, بداية_الإجراء);
    أرجع خذ_فهرسا_كف(الحالة);
}

// LF_FIELDLIST of LF_MEMBERs (public), each padded to 4 bytes.
عرف ألحق_قائمة_أعضاء_كف(
    الحالة: &متغير حالة_أنواع_كف,
    الأسماء: &متجه متجه ط8,
    الأنواع: &متجه طبيعي,
    الإزاحات: &متجه طبيعي
): طبيعي {
    دع البداية: طبيعي = ابدأ_سجل_نوع_كف(&متغير (*الحالة).البيانات, 0x1203);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
        ط16_كف(&متغير (*الحالة).البيانات, 0x150D);
        ط16_كف(&متغير (*الحالة).البيانات, 3);
        ط32_كف(&متغير (*الحالة).البيانات, (*الأنواع)[ف]);
        عددي_كف(&متغير (*الحالة).البيانات, (*الإزاحات)[ف]);
        اسم_كف(&متغير (*الحالة).البيانات, &(*الأسماء)[ف]);
        حاذ_سجل_نوع_كف(&متغير (*الحالة).البيانات, البداية);
        ف := ف + 1;
    }
    اختم_سجل_نوع_كف(&متغير (*الحالة).البيانات, البداية);
    أرجع خذ_فهرسا_كف(الحالة);
}

// A tag: LF_FIELDLIST of LF_ENUMERATEs, then LF_ENUM over its integer type.
عرف ألحق_تعداد_كف(
    الحالة: &متغير حالة_أنواع_كف,
    الأساس: طبيعي,
    المعدودات: &متجه وصف_بديل_دوارف,
    الاسم: &متجه ط8,
    الاسم_الفريد: &متجه ط8
): طبيعي {
    دع البداية: طبيعي = ابدأ_سجل_نوع_كف(&متغير (*الحالة).البيانات, 0x1203);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعدودات) مثل طبيعي)) {
        ط16_كف(&متغير (*الحالة).البيانات, 0x1502);
        ط16_كف(&متغير (*الحالة).البيانات, 3);
        عددي_كف(&متغير (*الحالة).البيانات, (*المعدودات)[ف].القيمة);
        اسم_كف(&متغير (*الحالة).البيانات, &(*المعدودات)[ف].الاسم);
        حاذ_سجل_نوع_كف(&متغير (*الحالة).البيانات, البداية);
        ف := ف + 1;
    }
    اختم_سجل_نوع_كف(&متغير (*الحالة).البيانات, البداية);
    دع القائمة: طبيعي = خذ_فهرسا_كف(الحالة);
    دع بداية_التعداد: طبيعي = ابدأ_سجل_نوع_كف(&متغير (*الحالة).البيانات, 0x1507);
    ط16_كف(&متغير (*الحالة).البيانات, الطول(*المعدودات) مثل طبيعي);
    ط16_كف(&متغير (*الحالة).البيانات, 0x0200);
    ط32_كف(&متغير (*الحالة).البيانات, الأساس);
    ط32_كف(&متغير (*الحالة).البيانات, القائمة);
    اسم_كف(&متغير (*الحالة).البيانات, الاسم);
    اسم_كف(&متغير (*الحالة).البيانات, الاسم_الفريد);
    اختم_سجل_نوع_كف(&متغير (*الحالة).البيانات, بداية_التعداد);
    أرجع خذ_فهرسا_كف(الحالة);
}

عرف هو_مركب_كف(الصنف: &صنف_نوع_دوارف): منطقي {
    طابق *الصنف مع
    | صنف_نوع_دوارف.مركب(_, _, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The CodeView index of a DWARF type identity, making its records first.
// A composite answers its forward declaration; its definition is written
// by حدد_المركبات_كف once every type it needs has an index.
عرف فهرس_نوع_كف(
    الحالة: &متغير حالة_أنواع_كف,
    الأوصاف: &متجه وصف_نوع_دوارف,
    الهوية: طبيعي
): طبيعي {
    إذا (الهوية >= (الطول((*الحالة).الفهارس) مثل طبيعي)) { أرجع 0; };
    إذا ((*الحالة).الفهارس[الهوية] != 0) { أرجع (*الحالة).الفهارس[الهوية]; };
    إذا ((*الحالة).الأمامية[الهوية] != 0) { أرجع (*الحالة).الأمامية[الهوية]; };
    إذا ((*الحالة).المواضع[الهوية] == 0) { أرجع 0; };
    دع الموضع: طبيعي = (*الحالة).المواضع[الهوية] - 1;
    دع الوصف: &وصف_نوع_دوارف = &(*الأوصاف)[الموضع];
    دع الفهرس: متغير طبيعي = 0;
    طابق (*الوصف).الصنف مع
    | صنف_نوع_دوارف.مؤشر(الداخل) -> {
        دع الداخل_كف: طبيعي = فهرس_نوع_كف(الحالة, الأوصاف, الداخل);
        الفهرس := ألحق_مؤشر_كف(الحالة, الداخل_كف);
    }
    | صنف_نوع_دوارف.مرجع(الداخل) -> {
        دع الداخل_كف: طبيعي = فهرس_نوع_كف(الحالة, الأوصاف, الداخل);
        الفهرس := ألحق_مؤشر_كف(الحالة, الداخل_كف);
    }
    | صنف_نوع_دوارف.صندوق(الداخل) -> {
        دع الداخل_كف: طبيعي = فهرس_نوع_كف(الحالة, الأوصاف, الداخل);
        الفهرس := ألحق_مؤشر_كف(الحالة, الداخل_كف);
    }
    | صنف_نوع_دوارف.اسم_مستعار(الهدف) -> {
        // Guards an alias of itself.
        (*الحالة).الفهارس[الهوية] := 0x0003;
        الفهرس := فهرس_نوع_كف(الحالة, الأوصاف, الهدف);
    }
    | صنف_نوع_دوارف.دالة(المعاملات, الناتج) -> {
        دع فهارس_المعاملات: متغير متجه طبيعي = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
            ألحق(فهارس_المعاملات, فهرس_نوع_كف(الحالة, الأوصاف, المعاملات[ف]));
            ف := ف + 1;
        }
        دع الناتج_كف: متغير طبيعي = 0x0003;
        طابق الناتج مع
        | اختياري.موجود(النوع) -> { الناتج_كف := فهرس_نوع_كف(الحالة, الأوصاف, النوع); }
        | اختياري.لا_شيء -> { };
        الفهرس := ألحق_إجراء_كف(الحالة, &فهارس_المعاملات, الناتج_كف);
    }
    | صنف_نوع_دوارف.تعداد_وسم(الأساس, المعدودات) -> {
        دع الأساس_كف: متغير طبيعي = فهرس_نوع_كف(الحالة, الأوصاف, الأساس);
        إذا (الأساس_كف == 0) { الأساس_كف := 0x69; };
        دع الاسم_الفريد: متجه ط8 = اسم_فريد_كف(الهوية, 0);
        الفهرس := ألحق_تعداد_كف(الحالة, الأساس_كف, &المعدودات, &(*الوصف).الاسم, &الاسم_الفريد);
    }
    | صنف_نوع_دوارف.مركب(_, _, _) -> { الفهرس := 0; }
    | صنف_نوع_دوارف.غير_محدد -> { الفهرس := 0; }
    | _ -> { الفهرس := نوع_مدمج_كف(&(*الوصف).الصنف, (*الوصف).الحجم); };
    (*الحالة).الفهارس[الهوية] := الفهرس;
    أرجع الفهرس;
}

// The definitions of the composites, after their forward declarations.
عرف حدد_المركبات_كف(
    الحالة: &متغير حالة_أنواع_كف,
    الأوصاف: &متجه وصف_نوع_دوارف
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأوصاف) مثل طبيعي)) {
        دع الوصف: &وصف_نوع_دوارف = &(*الأوصاف)[ف];
        طابق (*الوصف).الصنف مع
        | صنف_نوع_دوارف.مركب(الأعضاء, _, البدائل) -> {
            دع الأسماء: متغير متجه متجه ط8 = [];
            دع الأنواع: متغير متجه طبيعي = [];
            دع الإزاحات: متغير متجه طبيعي = [];
            دع ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الأعضاء) مثل طبيعي)) {
                ألحق(الأسماء, انسخ_بايتات_كف(&الأعضاء[ع].الاسم));
                ألحق(الأنواع, فهرس_نوع_كف(الحالة, الأوصاف, الأعضاء[ع].هوية_النوع));
                ألحق(الإزاحات, الأعضاء[ع].إزاحة_بايت);
                ع := ع + 1;
            }
            // Each constructor with a payload: a structure of its fields at
            // their offsets in the whole value, as a member at offset 0.
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(البدائل) مثل طبيعي)) {
                إذا ((الطول(البدائل[ب].الأعضاء) مثل طبيعي) > 0) {
                    دع أسماء_البديل: متغير متجه متجه ط8 = [];
                    دع أنواع_البديل: متغير متجه طبيعي = [];
                    دع إزاحات_البديل: متغير متجه طبيعي = [];
                    دع م: متغير طبيعي = 0;
                    طالما (م < (الطول(البدائل[ب].الأعضاء) مثل طبيعي)) {
                        ألحق(أسماء_البديل, انسخ_بايتات_كف(&البدائل[ب].الأعضاء[م].الاسم));
                        ألحق(أنواع_البديل, فهرس_نوع_كف(الحالة, الأوصاف, البدائل[ب].الأعضاء[م].هوية_النوع));
                        ألحق(إزاحات_البديل, البدائل[ب].الأعضاء[م].إزاحة_بايت);
                        م := م + 1;
                    }
                    دع قائمة_البديل: طبيعي = ألحق_قائمة_أعضاء_كف(الحالة, &أسماء_البديل, &أنواع_البديل, &إزاحات_البديل);
                    دع اسم_البديل: متغير متجه ط8 = انسخ_بايتات_كف(&(*الوصف).الاسم);
                    ألحق(اسم_البديل, 0x2E مثل ط8);
                    دع ك: متغير طبيعي = 0;
                    طالما (ك < (الطول(البدائل[ب].الاسم) مثل طبيعي)) { ألحق(اسم_البديل, البدائل[ب].الاسم[ك]); ك := ك + 1; }
                    دع فريد_البديل: متجه ط8 = اسم_فريد_كف((*الوصف).الهوية, ب + 1);
                    دع نوع_البديل: طبيعي = ألحق_بنية_كف(الحالة, الطول(أسماء_البديل) مثل طبيعي, قائمة_البديل,
                        (*الوصف).الحجم, &اسم_البديل, &فريد_البديل, خطأ);
                    ألحق(الأسماء, انسخ_بايتات_كف(&البدائل[ب].الاسم));
                    ألحق(الأنواع, نوع_البديل);
                    ألحق(الإزاحات, 0);
                };
                ب := ب + 1;
            }
            دع القائمة: طبيعي = ألحق_قائمة_أعضاء_كف(الحالة, &الأسماء, &الأنواع, &الإزاحات);
            دع الاسم_الفريد: متجه ط8 = اسم_فريد_كف((*الوصف).الهوية, 0);
            دع المعرف: طبيعي = ألحق_بنية_كف(الحالة, الطول(الأسماء) مثل طبيعي, القائمة, (*الوصف).الحجم,
                &(*الوصف).الاسم, &الاسم_الفريد, خطأ);
            إذا ((*الوصف).الهوية < (الطول((*الحالة).الفهارس) مثل طبيعي)) {
                (*الحالة).الفهارس[(*الوصف).الهوية] := المعرف;
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
}

عرف انسخ_بايتات_كف(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) { ألحق(الناتج, (*المصدر)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف حالة_أنواع_كف_جديدة(الأوصاف: &متجه وصف_نوع_دوارف): حالة_أنواع_كف {
    دع أعلى: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأوصاف) مثل طبيعي)) {
        إذا ((*الأوصاف)[ف].الهوية + 1 > أعلى) { أعلى := (*الأوصاف)[ف].الهوية + 1; };
        ف := ف + 1;
    }
    دع الفهارس: متغير متجه طبيعي = [];
    دع الأمامية: متغير متجه طبيعي = [];
    دع المواضع: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < أعلى) { ألحق(الفهارس, 0); ألحق(الأمامية, 0); ألحق(المواضع, 0); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(*الأوصاف) مثل طبيعي)) {
        المواضع[(*الأوصاف)[ف].الهوية] := ف + 1;
        ف := ف + 1;
    }
    دع البيانات: متجه ط8 = [];
    دع الحالة: حالة_أنواع_كف = {
        البيانات: البيانات, التالي: 0x1000, الفهارس: الفهارس, الأمامية: الأمامية, المواضع: المواضع
    };
    أرجع الحالة;
}

// Forward declarations of every composite, so any record can refer to one.
عرف صرح_بالمركبات_كف(الحالة: &متغير حالة_أنواع_كف, الأوصاف: &متجه وصف_نوع_دوارف): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأوصاف) مثل طبيعي)) {
        دع الوصف: &وصف_نوع_دوارف = &(*الأوصاف)[ف];
        إذا (هو_مركب_كف(&(*الوصف).الصنف)) {
            دع الاسم_الفريد: متجه ط8 = اسم_فريد_كف((*الوصف).الهوية, 0);
            دع الفهرس: طبيعي = ألحق_بنية_كف(الحالة, 0, 0, 0, &(*الوصف).الاسم, &الاسم_الفريد, صواب);
            (*الحالة).الأمامية[(*الوصف).الهوية] := الفهرس;
        };
        ف := ف + 1;
    }
}

// ---- Symbols and lines (.debug$S) -------------------------------------------

نوع حالة_رموز_كف = {
    البيانات: متجه ط8,
    الإزاحات: متجه إزاحة_كود_فيو,
    // File checksum entries: source identity -> offset (+1; 0 none).
    الملفات: متجه طبيعي,
    المجاميع: متجه ط8,
    السلاسل: متجه ط8
};

عرف ابدأ_قسم_فرعي_كف(ب: &متغير متجه ط8, النوع: طبيعي): طبيعي {
    ط32_كف(ب, النوع);
    دع الموضع: طبيعي = الطول(*ب) مثل طبيعي;
    ط32_كف(ب, 0);
    أرجع الموضع;
}

// The subsection's length (without padding), then zero padding to 4 bytes.
عرف اختم_قسم_فرعي_كف(ب: &متغير متجه ط8, موضع_الطول: طبيعي): فراغ {
    اكتب_ط32_كف(ب, موضع_الطول, (الطول(*ب) مثل طبيعي) - موضع_الطول - 4);
    طالما ((الطول(*ب) مثل طبيعي) % 4 != 0) { ط8_كف(ب, 0); }
}

عرف ابدأ_سجل_رمز_كف(ب: &متغير متجه ط8, النوع: طبيعي): طبيعي {
    دع الموضع: طبيعي = الطول(*ب) مثل طبيعي;
    ط16_كف(ب, 0);
    ط16_كف(ب, النوع);
    أرجع الموضع;
}

// Symbol records are padded with zeros to 4 bytes, the padding counted in
// the record's length.
عرف اختم_سجل_رمز_كف(ب: &متغير متجه ط8, البداية: طبيعي): فراغ {
    طالما (((الطول(*ب) مثل طبيعي) - البداية) % 4 != 0) { ط8_كف(ب, 0); }
    اكتب_ط16_كف(ب, البداية, (الطول(*ب) مثل طبيعي) - البداية - 2);
}

// A section-relative address of a symbol: SECREL on the offset (holding
// الإضافة), SECTION on the 16-bit section index.
عرف ألحق_عنوان_كف(الحالة: &متغير حالة_رموز_كف, الرمز: طبيعي, الإضافة: طبيعي): فراغ {
    دع موضع_الإزاحة: طبيعي = الطول((*الحالة).البيانات) مثل طبيعي;
    ط32_كف(&متغير (*الحالة).البيانات, الإضافة);
    دع موضع_القسم: طبيعي = الطول((*الحالة).البيانات) مثل طبيعي;
    ط16_كف(&متغير (*الحالة).البيانات, 0);
    دع أ: إزاحة_كود_فيو = { الموضع: موضع_الإزاحة, الرمز: الرمز, النوع: 0x0B };
    ألحق((*الحالة).الإزاحات, أ);
    دع ب: إزاحة_كود_فيو = { الموضع: موضع_القسم, الرمز: الرمز, النوع: 0x0A };
    ألحق((*الحالة).الإزاحات, ب);
}

// The file's entry in the checksum subsection (its byte offset there).
عرف ملف_كف(الحالة: &متغير حالة_رموز_كف, الخريطة: &متغير خريطة_مصادر, المصدر: طبيعي): طبيعي {
    طالما ((الطول((*الحالة).الملفات) مثل طبيعي) <= المصدر) { ألحق((*الحالة).الملفات, 0); }
    إذا ((*الحالة).الملفات[المصدر] != 0) { أرجع (*الحالة).الملفات[المصدر] - 1; };
    دع إزاحة_الاسم: طبيعي = الطول((*الحالة).السلاسل) مثل طبيعي;
    دع الاسم: متغير متجه ط8 = [];
    إذا (المصدر < (الطول((*الخريطة).المصادر) مثل طبيعي)) {
        الاسم := بايتات_من_نص(انسخ_نص(&(*الخريطة).المصادر[المصدر].الاسم));
    };
    اسم_كف(&متغير (*الحالة).السلاسل, &الاسم);
    دع الموضع: طبيعي = الطول((*الحالة).المجاميع) مثل طبيعي;
    ط32_كف(&متغير (*الحالة).المجاميع, إزاحة_الاسم);
    // No checksum (CHKSUM_TYPE_NONE).
    ط8_كف(&متغير (*الحالة).المجاميع, 0);
    ط8_كف(&متغير (*الحالة).المجاميع, 0);
    ط16_كف(&متغير (*الحالة).المجاميع, 0);
    (*الحالة).الملفات[المصدر] := الموضع + 1;
    أرجع الموضع;
}

// CodeView's AMD64 register (cvconst.h CV_AMD64_*) of a DWARF register.
عرف سجل_كف(الرقم: طبيعي): اختياري طبيعي {
    إذا (الرقم == 0) { أرجع اختياري.موجود(328); };
    إذا (الرقم == 1) { أرجع اختياري.موجود(331); };
    إذا (الرقم == 2) { أرجع اختياري.موجود(330); };
    إذا (الرقم == 3) { أرجع اختياري.موجود(329); };
    إذا (الرقم == 4) { أرجع اختياري.موجود(332); };
    إذا (الرقم == 5) { أرجع اختياري.موجود(333); };
    إذا (الرقم == 6) { أرجع اختياري.موجود(334); };
    إذا (الرقم == 7) { أرجع اختياري.موجود(335); };
    إذا (الرقم >= 8 && الرقم <= 15) { أرجع اختياري.موجود(336 + الرقم - 8); };
    إذا (الرقم >= 17 && الرقم <= 32) { أرجع اختياري.موجود(154 + الرقم - 17); };
    أرجع اختياري.لا_شيء();
}

// The range part of an S_DEFRANGE record: start (relocated), length, no gaps.
عرف ألحق_مدى_كف(الحالة: &متغير حالة_رموز_كف, الرمز: طبيعي, البداية: طبيعي, الطول: طبيعي): فراغ {
    ألحق_عنوان_كف(الحالة, الرمز, البداية);
    ط16_كف(&متغير (*الحالة).البيانات, الطول);
}

// The S_DEFRANGE records of one machine location range, split to the
// 16-bit range length.
عرف ألحق_مديات_موقع_كف(
    الحالة: &متغير حالة_رموز_كف,
    الدالة: &دالة_كود_فيو,
    المدى: &مدى_موقع_آلة_تصحيح
): فراغ {
    دع البداية: متغير طبيعي = (*المدى).بداية_بايت;
    طالما (البداية < (*المدى).نهاية_بايت) {
        دع الطول: متغير طبيعي = (*المدى).نهاية_بايت - البداية;
        إذا (الطول > 0xFFFF) { الطول := 0xFFFF; };
        طابق (*المدى).الموقع مع
        | موقع_آلة_تصحيح.سجل(الرقم) -> {
            طابق سجل_كف(الرقم) مع
            | اختياري.موجود(السجل) -> {
                // S_DEFRANGE_REGISTER.
                دع س: طبيعي = ابدأ_سجل_رمز_كف(&متغير (*الحالة).البيانات, 0x1141);
                ط16_كف(&متغير (*الحالة).البيانات, السجل);
                ط16_كف(&متغير (*الحالة).البيانات, 0);
                ألحق_مدى_كف(الحالة, (*الدالة).الرمز, البداية, الطول);
                اختم_سجل_رمز_كف(&متغير (*الحالة).البيانات, س);
            }
            | اختياري.لا_شيء -> { };
        }
        | موقع_آلة_تصحيح.مكدس(الرقم, الإزاحة) -> {
            طابق سجل_كف(الرقم) مع
            | اختياري.موجود(السجل) -> {
                // S_DEFRANGE_REGISTER_REL.
                دع س: طبيعي = ابدأ_سجل_رمز_كف(&متغير (*الحالة).البيانات, 0x1145);
                ط16_كف(&متغير (*الحالة).البيانات, السجل);
                ط16_كف(&متغير (*الحالة).البيانات, 0);
                ص32_كف(&متغير (*الحالة).البيانات, الإزاحة مثل عدد);
                ألحق_مدى_كف(الحالة, (*الدالة).الرمز, البداية, الطول);
                اختم_سجل_رمز_كف(&متغير (*الحالة).البيانات, س);
            }
            | اختياري.لا_شيء -> { };
        }
        | موقع_آلة_تصحيح.إطار(الإزاحة) -> {
            // S_DEFRANGE_FRAMEPOINTER_REL, from RSP after the prologue.
            دع س: طبيعي = ابدأ_سجل_رمز_كف(&متغير (*الحالة).البيانات, 0x1142);
            ص32_كف(&متغير (*الحالة).البيانات, الإزاحة + ((*الدالة).بعد_الإطار مثل عدد));
            ألحق_مدى_كف(الحالة, (*الدالة).الرمز, البداية, الطول);
            اختم_سجل_رمز_كف(&متغير (*الحالة).البيانات, س);
        }
        | _ -> { };
        البداية := البداية + الطول;
    }
}

// The source variables of a debug function: its parameters, then the locals
// of its scopes, not those of the calls inlined into it.
عرف متغيرات_دالة_كف(الدلالي: &سياق_تصحيح, الدالة: طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    إذا (الدالة >= (الطول((*الدلالي).الدوال) مثل طبيعي)) { أرجع الناتج; };
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*الدلالي).الدوال[الدالة].المعاملات) مثل طبيعي)) {
        ألحق(الناتج, (*الدلالي).الدوال[الدالة].المعاملات[م].القيمة);
        م := م + 1;
    }
    دع العمل: متغير متجه طبيعي = [];
    طابق (*الدلالي).الدوال[الدالة].النطاق_الجذري مع
    | اختياري.موجود(الجذر) -> { ألحق(العمل, الجذر.القيمة); }
    | اختياري.لا_شيء -> { };
    دع التالي: متغير طبيعي = 0;
    طالما (التالي < (الطول(العمل) مثل طبيعي)) {
        دع النطاق: طبيعي = العمل[التالي];
        التالي := التالي + 1;
        إذا (النطاق < (الطول((*الدلالي).النطاقات) مثل طبيعي)) {
            دع مضمن: متغير منطقي = خطأ;
            طابق (*الدلالي).النطاقات[النطاق].الدالة_المضمنة مع
            | اختياري.موجود(_) -> { مضمن := صواب; }
            | اختياري.لا_شيء -> { };
            إذا (!مضمن) {
                دع ل: متغير طبيعي = 0;
                طالما (ل < (الطول((*الدلالي).النطاقات[النطاق].المحليات) مثل طبيعي)) {
                    دع المتغير: طبيعي = (*الدلالي).النطاقات[النطاق].المحليات[ل].القيمة;
                    إذا (!يحوي_كف(&الناتج, المتغير)) { ألحق(الناتج, المتغير); };
                    ل := ل + 1;
                }
                دع ب: متغير طبيعي = 0;
                طالما (ب < (الطول((*الدلالي).النطاقات[النطاق].الأبناء) مثل طبيعي)) {
                    ألحق(العمل, (*الدلالي).النطاقات[النطاق].الأبناء[ب].القيمة);
                    ب := ب + 1;
                }
            };
        };
    }
    أرجع الناتج;
}

عرف يحوي_كف(المتجه: &متجه طبيعي, القيمة: طبيعي): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المتجه) مثل طبيعي)) {
        إذا ((*المتجه)[ف] == القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// A line of the line subsection.
نوع سطر_كف = {
    الإزاحة: طبيعي,
    الملف: طبيعي,
    السطر: طبيعي,
    عبارة: منطقي
};

// The source line of a debug location: (file entry, line, statement).
عرف موقع_سطر_كف(
    الحالة: &متغير حالة_رموز_كف,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر
): اختياري سطر_كف {
    طابق أصل_مصدر_بالمعرف(سجل_الأصول, الأصل) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(وصف_الأصل) -> {
        طابق إحداثي_من_الخريطة(الخريطة, وصف_الأصل.النطاق.البداية) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الإحداثي) -> {
            دع السطر: طبيعي = الإحداثي.السطر مثل طبيعي;
            إذا (السطر == 0) { أرجع اختياري.لا_شيء(); };
            دع الملف: طبيعي = ملف_كف(الحالة, الخريطة, وصف_الأصل.النطاق.البداية.المصدر مثل طبيعي);
            دع الناتج: سطر_كف = { الإزاحة: 0, الملف: الملف, السطر: السطر, عبارة: صواب };
            أرجع اختياري.موجود(الناتج);
        };
    };
}

// The line subsection of one function: its rows, grouped by file.
عرف ألحق_سطور_دالة_كف(
    الحالة: &متغير حالة_رموز_كف,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    الدلالي: &سياق_تصحيح,
    الدالة: &دالة_كود_فيو,
    دالة_الآلة: &تصحيح_دالة_آلة
): فراغ {
    دع السطور: متغير متجه سطر_كف = [];
    // The prologue belongs to the function's declaration line, as in the
    // DWARF line table.
    إذا ((الطول((*دالة_الآلة).مديات_السطور) مثل طبيعي) > 0 && (*دالة_الآلة).مديات_السطور[0].بداية_بايت > 0) {
        طابق (*دالة_الآلة).دالة_التصحيح مع
        | اختياري.موجود(المعرف) -> {
            إذا (المعرف.القيمة < (الطول((*الدلالي).الدوال) مثل طبيعي)) {
                طابق موقع_سطر_كف(الحالة, الخريطة, سجل_الأصول, (*الدلالي).الدوال[المعرف.القيمة].الأصل) مع
                | اختياري.موجود(س) -> { ألحق(السطور, س); }
                | اختياري.لا_شيء -> { };
            };
        }
        | اختياري.لا_شيء -> { };
    };
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*دالة_الآلة).مديات_السطور) مثل طبيعي)) {
        دع المدى: &مدى_سطر_آلة_تصحيح = &(*دالة_الآلة).مديات_السطور[م];
        دع معرف_الموقع: طبيعي = (*المدى).الموقع.القيمة;
        إذا (معرف_الموقع < (الطول((*الدلالي).المواقع) مثل طبيعي) && (*المدى).بداية_بايت < (*الدالة).حجم_بايت) {
            طابق موقع_سطر_كف(الحالة, الخريطة, سجل_الأصول, (*الدلالي).المواقع[معرف_الموقع].الأصل) مع
            | اختياري.موجود(الموقع) -> {
                دع س: سطر_كف = {
                    الإزاحة: (*المدى).بداية_بايت, الملف: الموقع.الملف, السطر: الموقع.السطر,
                    عبارة: (*الدلالي).المواقع[معرف_الموقع].هو_عبارة
                };
                ألحق(السطور, س);
            }
            | اختياري.لا_شيء -> { };
        };
        م := م + 1;
    }
    إذا ((الطول(السطور) مثل طبيعي) == 0) { أرجع; };
    دع موضع_الطول: طبيعي = ابدأ_قسم_فرعي_كف(&متغير (*الحالة).البيانات, 0xF2);
    ألحق_عنوان_كف(الحالة, (*الدالة).الرمز, 0);
    ط16_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, (*الدالة).حجم_بايت);
    دع ف: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول(السطور) مثل طبيعي;
    طالما (ف < العدد) {
        دع النهاية: متغير طبيعي = ف;
        طالما (النهاية < العدد && السطور[النهاية].الملف == السطور[ف].الملف) { النهاية := النهاية + 1; }
        ط32_كف(&متغير (*الحالة).البيانات, السطور[ف].الملف);
        ط32_كف(&متغير (*الحالة).البيانات, النهاية - ف);
        ط32_كف(&متغير (*الحالة).البيانات, 12 + 8 * (النهاية - ف));
        دع س: متغير طبيعي = ف;
        طالما (س < النهاية) {
            ط32_كف(&متغير (*الحالة).البيانات, السطور[س].الإزاحة);
            دع الحقل: متغير طبيعي = السطور[س].السطر % 16777216;
            إذا (السطور[س].عبارة) { الحقل := الحقل + 2147483648; };
            ط32_كف(&متغير (*الحالة).البيانات, الحقل);
            س := س + 1;
        }
        ف := النهاية;
    }
    اختم_قسم_فرعي_كف(&متغير (*الحالة).البيانات, موضع_الطول);
}

// The procedure type of a debug function: its parameters' types and result.
عرف نوع_إجراء_دالة_كف(
    الأنواع: &متغير حالة_أنواع_كف,
    الأوصاف: &متجه وصف_نوع_دوارف,
    الدلالي: &سياق_تصحيح,
    الدالة: طبيعي
): طبيعي {
    دع المعاملات: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*الدلالي).الدوال[الدالة].المعاملات) مثل طبيعي)) {
        دع المتغير: طبيعي = (*الدلالي).الدوال[الدالة].المعاملات[م].القيمة;
        إذا (المتغير < (الطول((*الدلالي).المتغيرات) مثل طبيعي)) {
            ألحق(المعاملات, فهرس_نوع_كف(الأنواع, الأوصاف, (*الدلالي).المتغيرات[المتغير].النوع.القيمة));
        };
        م := م + 1;
    }
    دع الناتج: متغير طبيعي = 0x0003;
    طابق (*الدلالي).الدوال[الدالة].الناتج مع
    | اختياري.موجود(النوع) -> { الناتج := فهرس_نوع_كف(الأنواع, الأوصاف, النوع.القيمة); }
    | اختياري.لا_شيء -> { };
    أرجع ألحق_إجراء_كف(الأنواع, &المعاملات, الناتج);
}

// The symbol subsection of one function: S_GPROC32 .. S_END.
عرف ألحق_رموز_دالة_كف(
    الحالة: &متغير حالة_رموز_كف,
    الأنواع: &متغير حالة_أنواع_كف,
    الأوصاف: &متجه وصف_نوع_دوارف,
    الدلالي: &سياق_تصحيح,
    الدالة: &دالة_كود_فيو,
    دالة_الآلة: &تصحيح_دالة_آلة,
    دالة_التصحيح: طبيعي
): فراغ {
    دع نوع_الإجراء: طبيعي = نوع_إجراء_دالة_كف(الأنواع, الأوصاف, الدلالي, دالة_التصحيح);
    دع موضع_الطول: طبيعي = ابدأ_قسم_فرعي_كف(&متغير (*الحالة).البيانات, 0xF1);
    // S_GPROC32 (S_LPROC32 for a function the module does not export).
    دع نوع_الإجراء_رمز: متغير طبيعي = 0x1110;
    إذا (!(*الدلالي).الدوال[دالة_التصحيح].علني) { نوع_الإجراء_رمز := 0x110F; };
    دع س: طبيعي = ابدأ_سجل_رمز_كف(&متغير (*الحالة).البيانات, نوع_الإجراء_رمز);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, (*الدالة).حجم_بايت);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, (*الدالة).حجم_بايت);
    ط32_كف(&متغير (*الحالة).البيانات, نوع_الإجراء);
    ألحق_عنوان_كف(الحالة, (*الدالة).الرمز, 0);
    ط8_كف(&متغير (*الحالة).البيانات, 0);
    اسم_كف(&متغير (*الحالة).البيانات, &(*الدلالي).الدوال[دالة_التصحيح].الاسم);
    اختم_سجل_رمز_كف(&متغير (*الحالة).البيانات, س);
    // S_FRAMEPROC: locals and parameters are addressed from RSP
    // (encoded local and parameter base pointer 1).
    دع إ: طبيعي = ابدأ_سجل_رمز_كف(&متغير (*الحالة).البيانات, 0x1012);
    دع الإطار: متغير طبيعي = 0;
    إذا ((*الدالة).بعد_الإطار > 8) { الإطار := (*الدالة).بعد_الإطار - 8; };
    ط32_كف(&متغير (*الحالة).البيانات, الإطار);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, 0);
    ط16_كف(&متغير (*الحالة).البيانات, 0);
    ط32_كف(&متغير (*الحالة).البيانات, 0x14000);
    اختم_سجل_رمز_كف(&متغير (*الحالة).البيانات, إ);
    // The locals with their location ranges.
    دع المتغيرات: متجه طبيعي = متغيرات_دالة_كف(الدلالي, دالة_التصحيح);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المتغيرات) مثل طبيعي)) {
        دع المتغير: طبيعي = المتغيرات[ف];
        إذا (المتغير < (الطول((*الدلالي).المتغيرات) مثل طبيعي)) {
            دع له_مدى: متغير منطقي = خطأ;
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول((*دالة_الآلة).مديات_المواقع) مثل طبيعي)) {
                إذا ((*دالة_الآلة).مديات_المواقع[م].المتغير.القيمة == المتغير) { له_مدى := صواب; };
                م := م + 1;
            }
            دع نوع_المتغير: طبيعي = فهرس_نوع_كف(الأنواع, الأوصاف, (*الدلالي).المتغيرات[المتغير].النوع.القيمة);
            دع ل: طبيعي = ابدأ_سجل_رمز_كف(&متغير (*الحالة).البيانات, 0x113E);
            ط32_كف(&متغير (*الحالة).البيانات, نوع_المتغير);
            دع الأعلام: متغير طبيعي = 0;
            طابق (*الدلالي).المتغيرات[المتغير].الصنف مع
            | صنف_متغير_تصحيح.معامل -> { الأعلام := 1; }
            | _ -> { };
            // IsOptimizedOut without a location.
            إذا (!له_مدى) { الأعلام := الأعلام + 0x100; };
            ط16_كف(&متغير (*الحالة).البيانات, الأعلام);
            اسم_كف(&متغير (*الحالة).البيانات, &(*الدلالي).المتغيرات[المتغير].الاسم);
            اختم_سجل_رمز_كف(&متغير (*الحالة).البيانات, ل);
            م := 0;
            طالما (م < (الطول((*دالة_الآلة).مديات_المواقع) مثل طبيعي)) {
                إذا ((*دالة_الآلة).مديات_المواقع[م].المتغير.القيمة == المتغير) {
                    ألحق_مديات_موقع_كف(الحالة, الدالة, &(*دالة_الآلة).مديات_المواقع[م]);
                };
                م := م + 1;
            }
        };
        ف := ف + 1;
    }
    // S_END.
    دع ن: طبيعي = ابدأ_سجل_رمز_كف(&متغير (*الحالة).البيانات, 0x0006);
    اختم_سجل_رمز_كف(&متغير (*الحالة).البيانات, ن);
    اختم_قسم_فرعي_كف(&متغير (*الحالة).البيانات, موضع_الطول);
}

// The CodeView sections of an x86-64 COFF object.
عام عرف ابن_كود_فيو(
    الدوال: &متجه دالة_كود_فيو,
    العوام: &متجه عام_كود_فيو,
    الخريطة: &متغير خريطة_مصادر,
    سجل_الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    تصحيح_الآلة: &سياق_تصحيح_آلة,
    سجل_الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط
): ناتج_كود_فيو {
    دع الدلالي: &سياق_تصحيح = &(*التصحيح).الدلالي;
    دع الأوصاف: متجه وصف_نوع_دوارف = أوصاف_أنواع_دوارف_من_السياق(سجل_الأنواع, الدلالي, الهدف, سجل_التخطيط);
    دع الأنواع: متغير حالة_أنواع_كف = حالة_أنواع_كف_جديدة(&الأوصاف);
    صرح_بالمركبات_كف(&متغير الأنواع, &الأوصاف);
    دع بيانات_فارغة: متجه ط8 = [];
    دع إزاحات_فارغة: متجه إزاحة_كود_فيو = [];
    دع ملفات_فارغة: متجه طبيعي = [];
    دع مجاميع_فارغة: متجه ط8 = [];
    دع سلاسل_أولى: متجه ط8 = [0];
    دع الحالة: متغير حالة_رموز_كف = {
        البيانات: بيانات_فارغة, الإزاحات: إزاحات_فارغة, الملفات: ملفات_فارغة,
        المجاميع: مجاميع_فارغة, السلاسل: سلاسل_أولى
    };
    // CV_SIGNATURE_C13.
    ط32_كف(&متغير الحالة.البيانات, 4);
    // S_OBJNAME and S_COMPILE3 (language C, machine x64).
    دع موضع_الرأس: طبيعي = ابدأ_قسم_فرعي_كف(&متغير الحالة.البيانات, 0xF1);
    دع أ: طبيعي = ابدأ_سجل_رمز_كف(&متغير الحالة.البيانات, 0x1101);
    ط32_كف(&متغير الحالة.البيانات, 0);
    دع اسم_الكائن: متجه ط8 = بايتات_من_نص(«sultanc.obj»);
    اسم_كف(&متغير الحالة.البيانات, &اسم_الكائن);
    اختم_سجل_رمز_كف(&متغير الحالة.البيانات, أ);
    دع ج: طبيعي = ابدأ_سجل_رمز_كف(&متغير الحالة.البيانات, 0x113C);
    ط32_كف(&متغير الحالة.البيانات, 0);
    ط16_كف(&متغير الحالة.البيانات, 0xD0);
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) { ط16_كف(&متغير الحالة.البيانات, 0); ف := ف + 1; }
    دع اسم_المترجم: متجه ط8 = بايتات_من_نص(«SultanC»);
    اسم_كف(&متغير الحالة.البيانات, &اسم_المترجم);
    اختم_سجل_رمز_كف(&متغير الحالة.البيانات, ج);
    اختم_قسم_فرعي_كف(&متغير الحالة.البيانات, موضع_الرأس);

    // Each function with debug facts: its symbols, then its lines.
    ف := 0;
    طالما (ف < (الطول(*الدوال) مثل طبيعي)) {
        دع الدالة: &دالة_كود_فيو = &(*الدوال)[ف];
        طابق موضع_دالة_تصحيح_آلة(تصحيح_الآلة, (*الدالة).الدالة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(موضع_الآلة) -> {
            دع دالة_الآلة: &تصحيح_دالة_آلة = &(*تصحيح_الآلة).الدوال[موضع_الآلة];
            طابق (*دالة_الآلة).دالة_التصحيح مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(معرف_التصحيح) -> {
                إذا (معرف_التصحيح.القيمة < (الطول((*الدلالي).الدوال) مثل طبيعي)) {
                    ألحق_رموز_دالة_كف(&متغير الحالة, &متغير الأنواع, &الأوصاف, الدلالي, الدالة, دالة_الآلة,
                        معرف_التصحيح.القيمة);
                    ألحق_سطور_دالة_كف(&متغير الحالة, الخريطة, سجل_الأصول, الدلالي, الدالة, دالة_الآلة);
                };
            };
        };
        ف := ف + 1;
    }

    // The definitions of the composites every symbol so far refers to.
    حدد_المركبات_كف(&متغير الأنواع, &الأوصاف);

    // Globals (S_GDATA32 / S_LDATA32) and named types (S_UDT).
    دع موضع_العوام: طبيعي = ابدأ_قسم_فرعي_كف(&متغير الحالة.البيانات, 0xF1);
    ف := 0;
    طالما (ف < (الطول(*العوام) مثل طبيعي)) {
        دع العام: &عام_كود_فيو = &(*العوام)[ف];
        طابق عام_تصحيح_لمسير(&(*التصحيح).العقد, (*العام).العام) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(معرف_العام) -> {
            إذا (معرف_العام.القيمة < (الطول((*الدلالي).العوام) مثل طبيعي)) {
                دع وصف_العام: &عام_تصحيح = &(*الدلالي).العوام[معرف_العام.القيمة];
                دع نوع_العام: طبيعي = فهرس_نوع_كف(&متغير الأنواع, &الأوصاف, (*وصف_العام).النوع.القيمة);
                دع نوع_السجل: متغير طبيعي = 0x110D;
                إذا (!(*وصف_العام).علني) { نوع_السجل := 0x110C; };
                دع ع: طبيعي = ابدأ_سجل_رمز_كف(&متغير الحالة.البيانات, نوع_السجل);
                ط32_كف(&متغير الحالة.البيانات, نوع_العام);
                ألحق_عنوان_كف(&متغير الحالة, (*العام).الرمز, 0);
                اسم_كف(&متغير الحالة.البيانات, &(*وصف_العام).الاسم);
                اختم_سجل_رمز_كف(&متغير الحالة.البيانات, ع);
            };
        };
        ف := ف + 1;
    }
    // A composite or tag referred to above, under its source name.
    ف := 0;
    طالما (ف < (الطول(الأوصاف) مثل طبيعي)) {
        دع الوصف: &وصف_نوع_دوارف = &الأوصاف[ف];
        إذا ((الطول((*الوصف).الاسم) مثل طبيعي) > 0 && (*الوصف).الهوية < (الطول(الأنواع.الفهارس) مثل طبيعي)) {
            دع الفهرس: طبيعي = الأنواع.الفهارس[(*الوصف).الهوية];
            دع مسمى: متغير منطقي = هو_مركب_كف(&(*الوصف).الصنف);
            طابق (*الوصف).الصنف مع
            | صنف_نوع_دوارف.تعداد_وسم(_, _) -> { مسمى := صواب; }
            | _ -> { };
            إذا (مسمى && الفهرس >= 0x1000) {
                دع ت: طبيعي = ابدأ_سجل_رمز_كف(&متغير الحالة.البيانات, 0x1108);
                ط32_كف(&متغير الحالة.البيانات, الفهرس);
                اسم_كف(&متغير الحالة.البيانات, &(*الوصف).الاسم);
                اختم_سجل_رمز_كف(&متغير الحالة.البيانات, ت);
            };
        };
        ف := ف + 1;
    }
    اختم_قسم_فرعي_كف(&متغير الحالة.البيانات, موضع_العوام);

    // File checksums (DEBUG_S_FILECHKSMS) and the string table.
    دع موضع_المجاميع: طبيعي = ابدأ_قسم_فرعي_كف(&متغير الحالة.البيانات, 0xF4);
    ف := 0;
    طالما (ف < (الطول(الحالة.المجاميع) مثل طبيعي)) { ألحق(الحالة.البيانات, الحالة.المجاميع[ف]); ف := ف + 1; }
    اختم_قسم_فرعي_كف(&متغير الحالة.البيانات, موضع_المجاميع);
    دع موضع_السلاسل: طبيعي = ابدأ_قسم_فرعي_كف(&متغير الحالة.البيانات, 0xF3);
    ف := 0;
    طالما (ف < (الطول(الحالة.السلاسل) مثل طبيعي)) { ألحق(الحالة.البيانات, الحالة.السلاسل[ف]); ف := ف + 1; }
    اختم_قسم_فرعي_كف(&متغير الحالة.البيانات, موضع_السلاسل);

    دع الأنواع_المسلسلة: متغير متجه ط8 = [];
    ط32_كف(&متغير الأنواع_المسلسلة, 4);
    ف := 0;
    طالما (ف < (الطول(الأنواع.البيانات) مثل طبيعي)) { ألحق(الأنواع_المسلسلة, الأنواع.البيانات[ف]); ف := ف + 1; }
    دع الإزاحات: متغير متجه إزاحة_كود_فيو = [];
    ف := 0;
    طالما (ف < (الطول(الحالة.الإزاحات) مثل طبيعي)) {
        دع الإزاحة: إزاحة_كود_فيو = {
            الموضع: الحالة.الإزاحات[ف].الموضع, الرمز: الحالة.الإزاحات[ف].الرمز, النوع: الحالة.الإزاحات[ف].النوع
        };
        ألحق(الإزاحات, الإزاحة);
        ف := ف + 1;
    }
    دع الناتج: ناتج_كود_فيو = {
        الرموز: انسخ_بايتات_كف(&الحالة.البيانات), إزاحات_الرموز: الإزاحات, الأنواع: الأنواع_المسلسلة
    };
    أرجع الناتج;
}
