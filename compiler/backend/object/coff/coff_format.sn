استورد compiler.backend.architectures.x86_64.encoded_code;
استورد compiler.backend.architectures.arm64.encoded_code;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.call_frame_information;
استورد compiler.backend.object.object_reference_model;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_primitive_symbol_query_context;
استورد compiler.msir.identifiers;
استورد std.text.from_bytes;
استورد std.collections.map;
استورد std.hash.fnv;

// x86-64 COFF relocatable object (Microsoft PE/COFF specification, "COFF
// File Header", "Section Table", "COFF Relocations", "COFF Symbol Table";
// "x64 exception handling" for .pdata/.xdata). Sections, in order:
//   1 .text    code, then the read-only literals
//   2 .data    the globals
//   3 .pdata   one RUNTIME_FUNCTION per function
//   4 .xdata   one UNWIND_INFO per function: the prologue's stack allocation
//              and callee-saved register saves
//   5 .CRT$XCU the module initializer of an object without a process entry
// Every section has a static section symbol (with its auxiliary record);
// functions, globals, literals and imports follow. Relocations keep their
// addend in the patched field, as COFF requires: a rel32 field holds the
// ELF-style addend + 4, an absolute field the addend itself. An imported
// datum read through a GOT load in ELF is read here through its import
// address table slot `__imp_<name>`. The AArch64 object (below) has the
// same layout with ARM64 relocations.

عام نوع خطأ_كوف =
    | معمارية_غير_مدعومة بنوع معرف_هدف
    | رمز_مكرر
    | رمز_إزاحة_مفقود
    | إزاحة_غير_مدعومة
    | حدود_صيغة_متجاوزة
;

عام نوع نتيجة_كوف =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_كوف
;

نوع رمز_كوف = {
    الاسم: متجه ط8,
    // 0: undefined, else the 1-based section number.
    القسم: طبيعي,
    القيمة: طبيعي,
    هي_دالة: منطقي
};

نوع إزاحة_كوف = {
    الموضع: طبيعي,
    // The COFF symbol table index of the target.
    الرمز: طبيعي,
    النوع: طبيعي
};

نوع سجل_رموز_كوف = {
    الرموز: متجه رمز_كوف,
    الهوية: الخريطة<مرجع_رمز_كائن, طبيعي>,
    الأسماء: الخريطة<متجه ط8, طبيعي>
};

// Section symbols occupy the first two table slots of each section.
عرف عدد_أقسام_كوف_ثابت(): طبيعي { أرجع 5; }

عرف أول_رمز_عادي_كوف(): طبيعي { أرجع عدد_أقسام_كوف_ثابت() * 2; }

عرف ألحق_ط8_كوف(ب: &متغير متجه ط8, ق: طبيعي): فراغ { ألحق(*ب, (ق % 256) مثل ط8); }

عرف ألحق_ط16_كوف(ب: &متغير متجه ط8, ق: طبيعي): فراغ {
    ألحق_ط8_كوف(ب, ق % 256);
    ألحق_ط8_كوف(ب, (ق / 256) % 256);
}

عرف ألحق_ط32_كوف(ب: &متغير متجه ط8, ق: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = ق;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) { ألحق_ط8_كوف(ب, الباقي % 256); الباقي := الباقي / 256; ف := ف + 1; }
}

عرف اكتب_عدد_في_كوف(ب: &متغير متجه ط8, الموضع: طبيعي, القيمة: عدد, الحجم: طبيعي): منطقي {
    إذا (الموضع > (الطول(*ب) مثل طبيعي) || الحجم > (الطول(*ب) مثل طبيعي) - الموضع) { أرجع خطأ; };
    دع الخام: متغير طبيعي = القيمة مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        (*ب)[الموضع + ف] := (الخام % 256) مثل ط8;
        الخام := الخام / 256;
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ألحق_أصفار_كوف(ب: &متغير متجه ط8, العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(*ب, 0 مثل ط8); ف := ف + 1; }
}

عرف حاذ_كوف(القيمة: طبيعي, المحاذاة: طبيعي): طبيعي {
    إذا (المحاذاة <= 1) { أرجع القيمة; };
    أرجع ((القيمة + المحاذاة - 1) / المحاذاة) * المحاذاة;
}

عرف بايت_سداسي_كوف(القيمة: طبيعي): ط8 {
    إذا (القيمة < 10) { أرجع (0x30 + القيمة) مثل ط8; };
    أرجع (0x61 + القيمة - 10) مثل ط8;
}

عرف ألحق_سداسي_كوف(ب: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع القاسم: متغير طبيعي = 0x1000000000000000;
    دع ر: متغير طبيعي = 0;
    طالما (ر < 16) {
        ألحق(*ب, بايت_سداسي_كوف((القيمة / القاسم) % 16));
        إذا (القاسم > 1) { القاسم := القاسم / 16; };
        ر := ر + 1;
    }
}

// The same link names as the ELF writer: one program's symbols are spelled
// alike in every native object format.
عرف اسم_مرجع_رمز_كوف(
    المرجع: &مرجع_رمز_كائن,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): اختياري متجه ط8 {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(الدالة) -> {
        دع ب: متغير متجه ط8 = بايتات_من_نص(«sultanc_fn_»);
        ألحق_سداسي_كوف(&متغير ب, الدالة.القيمة);
        أرجع اختياري.موجود(ب);
    }
    | مرجع_رمز_كائن.عام(العام) -> {
        دع ب: متغير متجه ط8 = بايتات_من_نص(«sultanc_global_»);
        ألحق_سداسي_كوف(&متغير ب, العام.القيمة);
        أرجع اختياري.موجود(ب);
    }
    | مرجع_رمز_كائن.بيانات_ثابتة(المعرف) -> {
        دع ب: متغير متجه ط8 = بايتات_من_نص(«sultanc_const_»);
        ألحق_سداسي_كوف(&متغير ب, المعرف.الدالة.القيمة);
        ألحق(ب, 0x5F مثل ط8);
        ألحق_سداسي_كوف(&متغير ب, المعرف.القيمة);
        أرجع اختياري.موجود(ب);
    }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> { أرجع اسم_رمز_خارجي_كائن_من_جدول(المعرف, الرموز_الخارجية); }
    | مرجع_رمز_كائن.خدمة_تشغيل(_) -> { أرجع اختياري.لا_شيء(); }
    | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> { أرجع اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي); };
}

عرف هاش_هوية_رمز_كوف(المرجع: &مرجع_رمز_كائن): طبيعي {
    طابق *المرجع مع
    | مرجع_رمز_كائن.دالة(المعرف) -> { أرجع ((المعرف.القيمة % 4294967291) * 33 + 1) % 4294967291; }
    | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> { أرجع ((المعرف.القيمة % 4294967291) * 33 + 2) % 4294967291; }
    | مرجع_رمز_كائن.عام(المعرف) -> { أرجع ((المعرف.القيمة % 4294967291) * 33 + 3) % 4294967291; }
    | مرجع_رمز_كائن.بيانات_ثابتة(المعرف) -> {
        أرجع (((المعرف.الدالة.القيمة % 4294967291) * 33 + (المعرف.القيمة % 4294967291)) % 4294967291 * 33 + 4) % 4294967291;
    }
    | مرجع_رمز_كائن.خدمة_تشغيل(_) -> { أرجع 100; }
    | مرجع_رمز_كائن.بدائي_تشغيل(_) -> { أرجع 200; };
}

عرف سجل_رموز_كوف_جديد(): سجل_رموز_كوف {
    دع الرموز: متجه رمز_كوف = [];
    دع السجل: سجل_رموز_كوف = {
        الرموز: الرموز,
        الهوية: أنشئ_الخريطة(هاش_هوية_رمز_كوف, مرجعا_رمز_كائن_متساويان),
        الأسماء: أنشئ_الخريطة(هاش_فنڤ1أ_طبيعي_للبايتات, اسما_رمز_خارجي_كائن_متساويان)
    };
    أرجع السجل;
}

// Adds or defines the symbol named الاسم; answers its symbol table index.
عرف رمز_كوف_بالاسم(
    السجل: &متغير سجل_رموز_كوف,
    الاسم: متجه ط8,
    القسم: طبيعي,
    القيمة: طبيعي,
    هي_دالة: منطقي
): نتيجة طبيعي, خطأ_كوف {
    طابق ابحث_في_الخريطة(&(*السجل).الأسماء, &الاسم) مع
    | اختياري.موجود(الفهرس) -> {
        إذا (القسم != 0) {
            إذا ((*السجل).الرموز[الفهرس].القسم != 0) { أرجع نتيجة.خطأ(خطأ_كوف.رمز_مكرر()); };
            (*السجل).الرموز[الفهرس].القسم := القسم;
            (*السجل).الرموز[الفهرس].القيمة := القيمة;
            (*السجل).الرموز[الفهرس].هي_دالة := هي_دالة;
        };
        أرجع نتيجة.نجح(الفهرس + أول_رمز_عادي_كوف());
    }
    | اختياري.لا_شيء -> { };
    دع الفهرس: طبيعي = الطول((*السجل).الرموز) مثل طبيعي;
    طابق أدرج_في_الخريطة(&متغير (*السجل).الأسماء, انسخ_اسم_رمز_خارجي_كائن(&الاسم), الفهرس) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة()); }
    | نتيجة.نجح(_) -> { };
    دع الرمز: رمز_كوف = { الاسم: الاسم, القسم: القسم, القيمة: القيمة, هي_دالة: هي_دالة };
    ألحق((*السجل).الرموز, الرمز);
    أرجع نتيجة.نجح(الفهرس + أول_رمز_عادي_كوف());
}

عرف رمز_كوف_بالمرجع(
    السجل: &متغير سجل_رموز_كوف,
    المرجع: &مرجع_رمز_كائن,
    القسم: طبيعي,
    القيمة: طبيعي,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): نتيجة طبيعي, خطأ_كوف {
    طابق ابحث_في_الخريطة(&(*السجل).الهوية, المرجع) مع
    | اختياري.موجود(الفهرس) -> {
        إذا (القسم == 0) { أرجع نتيجة.نجح(الفهرس + أول_رمز_عادي_كوف()); };
    }
    | اختياري.لا_شيء -> { };
    إذا (القسم == 0 && مرجع_رمز_كائن_هو_بيانات_محلية(المرجع)) {
        أرجع نتيجة.خطأ(خطأ_كوف.رمز_إزاحة_مفقود());
    };
    دع الاسم: متجه ط8;
    طابق اسم_مرجع_رمز_كوف(المرجع, الهدف, الرموز_الخارجية) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_كوف.رمز_إزاحة_مفقود()); }
    | اختياري.موجود(القيمة_الاسمية) -> { الاسم := القيمة_الاسمية; };
    دع دالي: منطقي = !مرجع_رمز_كائن_هو_بيانات_محلية(المرجع);
    طابق رمز_كوف_بالاسم(السجل, الاسم, القسم, القيمة, دالي && القسم != 2) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الفهرس_الكامل) -> {
        طابق أدرج_في_الخريطة(&متغير (*السجل).الهوية, انسخ_مرجع_رمز_كائن(المرجع), الفهرس_الكامل - أول_رمز_عادي_كوف()) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة()); }
        | نتيجة.نجح(_) -> { };
        أرجع نتيجة.نجح(الفهرس_الكامل);
    };
}

// Windows register number (RAX 0, RCX 1, RDX 2, RBX 3, RSP 4, RBP 5,
// RSI 6, RDI 7, R8-R15) of a System V DWARF register number.
عرف سجل_ويندوز_من_دوارف_كوف(الرقم: طبيعي): طبيعي {
    إذا (الرقم == 1) { أرجع 2; };
    إذا (الرقم == 2) { أرجع 1; };
    إذا (الرقم == 4) { أرجع 6; };
    إذا (الرقم == 5) { أرجع 7; };
    إذا (الرقم == 6) { أرجع 5; };
    إذا (الرقم == 7) { أرجع 4; };
    أرجع الرقم;
}

// UNWIND_INFO of a function whose prologue is one stack allocation (the
// first frame-offset event of its unwind facts: the CFA moves from RSP+8)
// followed by the saves of the callee-saved registers it allocates, each a
// MOV to [RSP+n] (UWOP_SAVE_NONVOL). The codes are listed last operation
// first; the prologue ends after the last save.
عرف ألحق_معلومات_فك_كوف(
    ب: &متغير متجه ط8,
    الأحداث: &متجه حدث_فك_المكدس
): فراغ {
    دع حجم_المقدمة: متغير طبيعي = 0;
    دع الإطار: متغير طبيعي = 0;
    // The entry state (CFA = RSP+8, the return address at CFA-8) is the
    // events at offset 0; Windows implies it.
    دع الأول: متغير طبيعي = 0;
    دع العدد_الكلي: طبيعي = الطول(*الأحداث) مثل طبيعي;
    طالما (الأول < العدد_الكلي && (*الأحداث)[الأول].إزاحة_بايت == 0) {
        الأول := الأول + 1;
    }
    إذا (الأول < العدد_الكلي) {
        طابق (*الأحداث)[الأول].الحدث مع
        | نوع_حدث_فك_المكدس.إزاحة_قاعدة_الإطار_تغيرت(الإزاحة) -> {
            إذا (الإزاحة > 8 && (*الأحداث)[الأول].إزاحة_بايت <= 255) {
                الإطار := الإزاحة - 8;
                حجم_المقدمة := (*الأحداث)[الأول].إزاحة_بايت;
            };
        }
        | _ -> { };
    };
    إذا (الإطار % 8 != 0) { الإطار := 0; حجم_المقدمة := 0; };
    // Slots of the allocation code, in order.
    دع التخصيص: متغير متجه طبيعي = [];
    إذا (الإطار > 0 && الإطار <= 128) {
        ألحق(التخصيص, حجم_المقدمة + (2 + (الإطار / 8 - 1) * 16) * 256);
    } وإلا إذا (الإطار > 0 && الإطار <= 524280) {
        ألحق(التخصيص, حجم_المقدمة + 1 * 256);
        ألحق(التخصيص, الإطار / 8);
    } وإلا إذا (الإطار > 0) {
        ألحق(التخصيص, حجم_المقدمة + (1 + 16) * 256);
        ألحق(التخصيص, الإطار % 65536);
        ألحق(التخصيص, الإطار / 65536);
    };
    // The register saves right after the allocation, each two slots.
    دع الحفظ: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = الأول + 1;
    دع مستمر: متغير منطقي = الإطار > 0;
    طالما (مستمر && ف < (الطول(*الأحداث) مثل طبيعي)) {
        طابق (*الأحداث)[ف].الحدث مع
        | نوع_حدث_فك_المكدس.سجل_حفظ(الرقم, البعد) -> {
            دع الموضع: طبيعي = (*الأحداث)[ف].إزاحة_بايت;
            إذا (الموضع <= 255 && البعد <= الإطار + 8 && (الإطار + 8 - البعد) % 8 == 0
                && (الإطار + 8 - البعد) / 8 <= 65535) {
                دع الرمز: متجه طبيعي = [
                    الموضع + (4 + سجل_ويندوز_من_دوارف_كوف(الرقم) * 16) * 256,
                    (الإطار + 8 - البعد) / 8
                ];
                ألحق(الحفظ, الرمز);
                حجم_المقدمة := الموضع;
            } وإلا { مستمر := خطأ; };
        }
        | _ -> { مستمر := خطأ; };
        ف := ف + 1;
    }
    دع الخانات: متغير متجه طبيعي = [];
    دع ح: متغير طبيعي = الطول(الحفظ) مثل طبيعي;
    طالما (ح > 0) {
        ح := ح - 1;
        ألحق(الخانات, الحفظ[ح][0]);
        ألحق(الخانات, الحفظ[ح][1]);
    }
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول(التخصيص) مثل طبيعي)) { ألحق(الخانات, التخصيص[ت]); ت := ت + 1; }
    دع العدد: طبيعي = الطول(الخانات) مثل طبيعي;
    ألحق_ط8_كوف(ب, 1);
    ألحق_ط8_كوف(ب, حجم_المقدمة);
    ألحق_ط8_كوف(ب, العدد);
    ألحق_ط8_كوف(ب, 0);
    ت := 0;
    طالما (ت < العدد) { ألحق_ط16_كوف(ب, الخانات[ت]); ت := ت + 1; }
    // The code array is padded to an even number of slots.
    إذا (العدد % 2 == 1) { ألحق_ط16_كوف(ب, 0); };
}

عرف ألحق_إزاحة_كوف(الإزاحات: &متغير متجه إزاحة_كوف, الموضع: طبيعي, الرمز: طبيعي, النوع: طبيعي): فراغ {
    دع الإزاحة: إزاحة_كوف = { الموضع: الموضع, الرمز: الرمز, النوع: النوع };
    ألحق(*الإزاحات, الإزاحة);
}

عرف أس_محاذاة_كوف(المحاذاة: طبيعي): طبيعي {
    دع الأس: متغير طبيعي = 0;
    دع ق: متغير طبيعي = 1;
    طالما (ق < المحاذاة && الأس < 13) { ق := ق * 2; الأس := الأس + 1; }
    أرجع الأس + 1;
}

عرف ألحق_اسم_ثمانية_كوف(ب: &متغير متجه ط8, الاسم: &نص): فراغ {
    دع البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(الاسم));
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        إذا (ف < (الطول(البايتات) مثل طبيعي)) { ألحق(*ب, البايتات[ف]); } وإلا { ألحق(*ب, 0 مثل ط8); };
        ف := ف + 1;
    }
}

عرف ألحق_إزاحات_قسم_كوف(ب: &متغير متجه ط8, الإزاحات: &متجه إزاحة_كوف): فراغ {
    دع العدد: طبيعي = الطول(*الإزاحات) مثل طبيعي;
    إذا (العدد >= 0xFFFF) {
        // IMAGE_SCN_LNK_NRELOC_OVFL: the first record holds the real count.
        ألحق_ط32_كوف(ب, العدد + 1); ألحق_ط32_كوف(ب, 0); ألحق_ط16_كوف(ب, 0);
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق_ط32_كوف(ب, (*الإزاحات)[ف].الموضع);
        ألحق_ط32_كوف(ب, (*الإزاحات)[ف].الرمز);
        ألحق_ط16_كوف(ب, (*الإزاحات)[ف].النوع);
        ف := ف + 1;
    }
}

عرف حجم_إزاحات_قسم_كوف(الإزاحات: &متجه إزاحة_كوف): طبيعي {
    دع العدد: طبيعي = الطول(*الإزاحات) مثل طبيعي;
    إذا (العدد >= 0xFFFF) { أرجع (العدد + 1) * 10; };
    أرجع العدد * 10;
}

عام عرف اكتب_كائن_كوف_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دخول_العملية: اختياري دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون,
    الرموز_الخارجية: &متجه متجه ط8
): نتيجة_كوف {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> { أرجع نتيجة_كوف.خطأ(خطأ_كوف.معمارية_غير_مدعومة((*الهدف).المعرف)); };
    دع السجل: متغير سجل_رموز_كوف = سجل_رموز_كوف_جديد();
    دع النص: متغير متجه ط8 = انسخ_بايتات(&(*الشفرة).البيانات);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الشفرة).الدوال) مثل طبيعي)) {
        دع الموضع: &موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[ف];
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة((*الموضع).الدالة);
        طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 1, (*الموضع).إزاحة_بايت, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    طابق دخول_العملية مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        طابق رمز_كوف_بالاسم(&متغير السجل, بايتات_من_نص(«_start»), 1, الدخول.إزاحة_بايت, صواب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
    };
    // Read-only literals follow the code in .text, as in the ELF writer.
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.البيانات_الثابتة) مثل طبيعي)) {
        دع الثابت: &بيانات_ثابتة_كائن = &(*الشفرة).المرفقات.البيانات_الثابتة[ف];
        دع الموضع: طبيعي = حاذ_كوف(الطول(النص) مثل طبيعي, (*الثابت).المحاذاة);
        ألحق_أصفار_كوف(&متغير النص, الموضع - (الطول(النص) مثل طبيعي));
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.بيانات_ثابتة((*الثابت).المعرف);
        طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 1, الموضع, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول((*الثابت).البيانات) مثل طبيعي)) { ألحق(النص, (*الثابت).البيانات[ب]); ب := ب + 1; }
        ف := ف + 1;
    }

    // Globals.
    دع البيانات: متغير متجه ط8 = [];
    دع محاذاة_البيانات: متغير طبيعي = 8;
    دع إزاحات_البيانات: متغير متجه إزاحة_كوف = [];
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع العام: &بيانات_عام_كائن = &(*الشفرة).المرفقات.البيانات_العامة[ف];
        إذا ((*العام).المحاذاة > محاذاة_البيانات) { محاذاة_البيانات := (*العام).المحاذاة; };
        دع الموضع: طبيعي = حاذ_كوف(الطول(البيانات) مثل طبيعي, (*العام).المحاذاة);
        ألحق_أصفار_كوف(&متغير البيانات, الموضع - (الطول(البيانات) مثل طبيعي));
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.عام((*العام).المعرف);
        طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 2, الموضع, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول((*العام).البيانات) مثل طبيعي)) { ألحق(البيانات, (*العام).البيانات[ب]); ب := ب + 1; }
        ف := ف + 1;
    }
    // Data relocations after every global is defined.
    ف := 0;
    دع موضع_العام: متغير طبيعي = 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع العام: &بيانات_عام_كائن = &(*الشفرة).المرفقات.البيانات_العامة[ف];
        موضع_العام := حاذ_كوف(موضع_العام, (*العام).المحاذاة);
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*العام).الإزاحات) مثل طبيعي)) {
            دع الطلب: &طلب_إزاحة_بيانات_كائن = &(*العام).الإزاحات[ر];
            دع الرمز_المحلول: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
                &(*الطلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
            );
            طابق رمز_كوف_بالمرجع(&متغير السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
            | نتيجة.نجح(الفهرس) -> {
                // IMAGE_REL_AMD64_ADDR64 with the addend in the field.
                إذا (!اكتب_عدد_في_كوف(&متغير البيانات, موضع_العام + (*الطلب).الموضع,
                    (*الطلب).الإضافة مثل عدد, 8)) {
                    أرجع نتيجة_كوف.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة());
                };
                ألحق_إزاحة_كوف(&متغير إزاحات_البيانات, موضع_العام + (*الطلب).الموضع, الفهرس, 1);
            };
            ر := ر + 1;
        }
        موضع_العام := موضع_العام + (الطول((*العام).البيانات) مثل طبيعي);
        ف := ف + 1;
    }

    // Code relocations: rel32 calls and addresses (REL32, field = addend + 4).
    دع إزاحات_النص: متغير متجه إزاحة_كوف = [];
    ف := 0;
    طالما (ف < (الطول((*الشفرة).إزاحات_النداء) مثل طبيعي)) {
        دع الطلب: &إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = &(*الشفرة).إزاحات_النداء[ف];
        دع الرمز_المحلول: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
            &(*الطلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
        );
        طابق رمز_كوف_بالمرجع(&متغير السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(الفهرس) -> {
            إذا (!اكتب_عدد_في_كوف(&متغير النص, (*الطلب).إزاحة_بايت, (*الطلب).الإضافة + 4, 4)) {
                أرجع نتيجة_كوف.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة());
            };
            ألحق_إزاحة_كوف(&متغير إزاحات_النص, (*الطلب).إزاحة_بايت, الفهرس, 4);
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.إزاحات_النص) مثل طبيعي)) {
        دع الطلب: &طلب_إزاحة_نص_كائن = &(*الشفرة).المرفقات.إزاحات_النص[ف];
        دع بداية: متغير طبيعي = 0;
        دع وجدت: متغير منطقي = خطأ;
        دع د: متغير طبيعي = 0;
        طالما (د < (الطول((*الشفرة).الدوال) مثل طبيعي) && !وجدت) {
            إذا (معرفا_دالة_منتقاة_متساويان((*الشفرة).الدوال[د].الدالة, (*الطلب).الموضع.الدالة)) {
                بداية := (*الشفرة).الدوال[د].إزاحة_بايت;
                وجدت := صواب;
            };
            د := د + 1;
        }
        إذا (!وجدت) { أرجع نتيجة_كوف.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة()); };
        دع الموضع: طبيعي = بداية + (*الطلب).الموضع.إزاحة_بايت;
        دع الرمز_المحلول: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
            &(*الطلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
        );
        طابق (*الطلب).النوع مع
        | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> {
            طابق رمز_كوف_بالمرجع(&متغير السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
            | نتيجة.نجح(الفهرس) -> {
                إذا (!اكتب_عدد_في_كوف(&متغير النص, الموضع, (*الطلب).الإضافة, 8)) {
                    أرجع نتيجة_كوف.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة());
                };
                ألحق_إزاحة_كوف(&متغير إزاحات_النص, الموضع, الفهرس, 1);
            };
        }
        | نوع_إزاحة_رمزية_كائن.تحميل_جوت_إكس_نسبي_اثنان_وثلاثون -> {
            إذا (الموضع < 2 || النص[الموضع - 2] != 0x8B) {
                أرجع نتيجة_كوف.خطأ(خطأ_كوف.إزاحة_غير_مدعومة());
            };
            // A datum this object defines: the MOV from its slot becomes LEA.
            دع محلي: متغير منطقي = خطأ;
            طابق ابحث_في_الخريطة(&السجل.الهوية, &الرمز_المحلول) مع
            | اختياري.موجود(الفهرس_المحلي) -> { محلي := السجل.الرموز[الفهرس_المحلي].القسم != 0; }
            | اختياري.لا_شيء -> { };
            إذا (محلي) {
                طابق رمز_كوف_بالمرجع(&متغير السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
                | نتيجة.نجح(الفهرس) -> {
                    النص[الموضع - 2] := 0x8D مثل ط8;
                    إذا (!اكتب_عدد_في_كوف(&متغير النص, الموضع, (*الطلب).الإضافة + 4, 4)) {
                        أرجع نتيجة_كوف.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة());
                    };
                    ألحق_إزاحة_كوف(&متغير إزاحات_النص, الموضع, الفهرس, 4);
                };
            } وإلا {
                // The import address table slot `__imp_<name>` holds the
                // address the ELF GOT slot would.
                دع اسم_الاستيراد: متغير متجه ط8 = بايتات_من_نص(«__imp_»);
                طابق اسم_مرجع_رمز_كوف(&الرمز_المحلول, الهدف, الرموز_الخارجية) مع
                | اختياري.لا_شيء -> { أرجع نتيجة_كوف.خطأ(خطأ_كوف.رمز_إزاحة_مفقود()); }
                | اختياري.موجود(الاسم) -> {
                    دع ب: متغير طبيعي = 0;
                    طالما (ب < (الطول(الاسم) مثل طبيعي)) { ألحق(اسم_الاستيراد, الاسم[ب]); ب := ب + 1; }
                };
                طابق رمز_كوف_بالاسم(&متغير السجل, اسم_الاستيراد, 0, 0, خطأ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
                | نتيجة.نجح(الفهرس) -> {
                    إذا (!اكتب_عدد_في_كوف(&متغير النص, الموضع, (*الطلب).الإضافة + 4, 4)) {
                        أرجع نتيجة_كوف.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة());
                    };
                    ألحق_إزاحة_كوف(&متغير إزاحات_النص, الموضع, الفهرس, 4);
                };
            };
        }
        | _ -> { أرجع نتيجة_كوف.خطأ(خطأ_كوف.إزاحة_غير_مدعومة()); };
        ف := ف + 1;
    }

    // .pdata/.xdata: one RUNTIME_FUNCTION and UNWIND_INFO per function.
    دع البيانات_الاستثنائية: متغير متجه ط8 = [];
    دع معلومات_الفك: متغير متجه ط8 = [];
    دع إزاحات_الاستثناء: متغير متجه إزاحة_كوف = [];
    ف := 0;
    طالما (ف < (الطول((*الشفرة).الدوال) مثل طبيعي)) {
        دع الموضع: &موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[ف];
        إذا ((*الموضع).حجم_بايت > 0) {
            دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة((*الموضع).الدالة);
            طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 0, 0, الهدف, الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
            | نتيجة.نجح(الفهرس) -> {
                دع أساس: طبيعي = الطول(البيانات_الاستثنائية) مثل طبيعي;
                ألحق_ط32_كوف(&متغير البيانات_الاستثنائية, 0);
                ألحق_ط32_كوف(&متغير البيانات_الاستثنائية, (*الموضع).حجم_بايت);
                ألحق_ط32_كوف(&متغير البيانات_الاستثنائية, الطول(معلومات_الفك) مثل طبيعي);
                // IMAGE_REL_AMD64_ADDR32NB: the function, its end, its UNWIND_INFO.
                ألحق_إزاحة_كوف(&متغير إزاحات_الاستثناء, أساس, الفهرس, 3);
                ألحق_إزاحة_كوف(&متغير إزاحات_الاستثناء, أساس + 4, الفهرس, 3);
                ألحق_إزاحة_كوف(&متغير إزاحات_الاستثناء, أساس + 8, 6, 3);
                ألحق_معلومات_فك_كوف(&متغير معلومات_الفك, &(*الموضع).أحداث_فك_المكدس);
            };
        };
        ف := ف + 1;
    }

    // An object's module initializer runs from the C runtime initializer table.
    دع المنشئات: متغير متجه ط8 = [];
    دع إزاحات_المنشئات: متغير متجه إزاحة_كوف = [];
    طابق دخول_العملية مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        طابق (*الشفرة).المرفقات.منشئ_الوحدة مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المعرف) -> {
            دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(المعرف);
            طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 0, 0, الهدف, الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
            | نتيجة.نجح(الفهرس) -> {
                ألحق_أصفار_كوف(&متغير المنشئات, 8);
                ألحق_إزاحة_كوف(&متغير إزاحات_المنشئات, 0, الفهرس, 1);
            };
        };
    };

    دع محتويات: متجه متجه ط8 = [النص, البيانات, البيانات_الاستثنائية, معلومات_الفك, المنشئات];
    دع إزاحات_الفك: متجه إزاحة_كوف = [];
    دع إزاحات: متجه متجه إزاحة_كوف = [إزاحات_النص, إزاحات_البيانات, إزاحات_الاستثناء, إزاحات_الفك, إزاحات_المنشئات];
    أرجع نتيجة_كوف.نجح(سلسل_كائن_كوف(0x8664, &السجل, &محتويات, &إزاحات, محاذاة_البيانات));
}

// Serializes the five sections (contents and relocations, in the order of
// the file comment), their section symbols and the symbol table.
عرف سلسل_كائن_كوف(
    الآلة: طبيعي,
    السجل: &سجل_رموز_كوف,
    محتويات: &متجه متجه ط8,
    إزاحات: &متجه متجه إزاحة_كوف,
    محاذاة_البيانات: طبيعي
): متجه ط8 {
    دع ف: متغير طبيعي = 0;
    دع عدد_الأقسام: طبيعي = عدد_أقسام_كوف_ثابت();
    دع موضع: متغير طبيعي = 20 + 40 * عدد_الأقسام;
    دع مواضع_البيانات: متغير متجه طبيعي = [];
    دع مواضع_الإزاحات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الأقسام) {
        موضع := حاذ_كوف(موضع, 16);
        ألحق(مواضع_البيانات, موضع);
        موضع := موضع + (الطول((*محتويات)[ف]) مثل طبيعي);
        موضع := حاذ_كوف(موضع, 4);
        ألحق(مواضع_الإزاحات, موضع);
        موضع := موضع + حجم_إزاحات_قسم_كوف(&(*إزاحات)[ف]);
        ف := ف + 1;
    }
    دع موضع_الرموز: طبيعي = حاذ_كوف(موضع, 4);
    دع عدد_الرموز: طبيعي = أول_رمز_عادي_كوف() + (الطول((*السجل).الرموز) مثل طبيعي);
    // Long names go to the string table (after its 4-byte size).
    دع جدول_النصوص: متغير متجه ط8 = [0, 0, 0, 0];

    دع ب: متغير متجه ط8 = [];
    ألحق_ط16_كوف(&متغير ب, الآلة);
    ألحق_ط16_كوف(&متغير ب, عدد_الأقسام);
    ألحق_ط32_كوف(&متغير ب, 0);
    ألحق_ط32_كوف(&متغير ب, موضع_الرموز);
    ألحق_ط32_كوف(&متغير ب, عدد_الرموز);
    ألحق_ط16_كوف(&متغير ب, 0);
    ألحق_ط16_كوف(&متغير ب, 0);
    دع أسماء_الأقسام: متجه نص = [«.text», «.data», «.pdata», «.xdata», «.CRT$XCU»];
    // CODE|ALIGN_16|EXECUTE|READ; INITIALIZED_DATA|READ|WRITE (alignment
    // added below); INITIALIZED_DATA|ALIGN_4|READ for .pdata/.xdata;
    // INITIALIZED_DATA|ALIGN_8|READ for .CRT$XCU.
    دع خصائص_البيانات: طبيعي = 0xC0000040 + أس_محاذاة_كوف(محاذاة_البيانات) * 0x100000;
    دع الخصائص: متجه طبيعي = [0x60500020, خصائص_البيانات, 0x40300040, 0x40300040, 0x40400040];
    ف := 0;
    طالما (ف < عدد_الأقسام) {
        ألحق_اسم_ثمانية_كوف(&متغير ب, &أسماء_الأقسام[ف]);
        ألحق_ط32_كوف(&متغير ب, 0);
        ألحق_ط32_كوف(&متغير ب, 0);
        دع الحجم: طبيعي = الطول((*محتويات)[ف]) مثل طبيعي;
        ألحق_ط32_كوف(&متغير ب, الحجم);
        إذا (الحجم > 0) { ألحق_ط32_كوف(&متغير ب, مواضع_البيانات[ف]); } وإلا { ألحق_ط32_كوف(&متغير ب, 0); };
        دع عدد_الإزاحات: طبيعي = الطول((*إزاحات)[ف]) مثل طبيعي;
        إذا (عدد_الإزاحات > 0) { ألحق_ط32_كوف(&متغير ب, مواضع_الإزاحات[ف]); } وإلا { ألحق_ط32_كوف(&متغير ب, 0); };
        ألحق_ط32_كوف(&متغير ب, 0);
        دع الخاصية: متغير طبيعي = الخصائص[ف];
        إذا (عدد_الإزاحات >= 0xFFFF) {
            ألحق_ط16_كوف(&متغير ب, 0xFFFF);
            الخاصية := الخاصية + 0x01000000;
        } وإلا {
            ألحق_ط16_كوف(&متغير ب, عدد_الإزاحات);
        };
        ألحق_ط16_كوف(&متغير ب, 0);
        ألحق_ط32_كوف(&متغير ب, الخاصية);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < عدد_الأقسام) {
        إذا ((الطول((*محتويات)[ف]) مثل طبيعي) > 0) {
            ألحق_أصفار_كوف(&متغير ب, مواضع_البيانات[ف] - (الطول(ب) مثل طبيعي));
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول((*محتويات)[ف]) مثل طبيعي)) { ألحق(ب, (*محتويات)[ف][ك]); ك := ك + 1; }
        };
        إذا ((الطول((*إزاحات)[ف]) مثل طبيعي) > 0) {
            ألحق_أصفار_كوف(&متغير ب, مواضع_الإزاحات[ف] - (الطول(ب) مثل طبيعي));
            ألحق_إزاحات_قسم_كوف(&متغير ب, &(*إزاحات)[ف]);
        };
        ف := ف + 1;
    }
    ألحق_أصفار_كوف(&متغير ب, موضع_الرموز - (الطول(ب) مثل طبيعي));
    // Section symbols with their auxiliary section-definition records.
    ف := 0;
    طالما (ف < عدد_الأقسام) {
        ألحق_اسم_ثمانية_كوف(&متغير ب, &أسماء_الأقسام[ف]);
        ألحق_ط32_كوف(&متغير ب, 0);
        ألحق_ط16_كوف(&متغير ب, ف + 1);
        ألحق_ط16_كوف(&متغير ب, 0);
        ألحق_ط8_كوف(&متغير ب, 3);
        ألحق_ط8_كوف(&متغير ب, 1);
        ألحق_ط32_كوف(&متغير ب, الطول((*محتويات)[ف]) مثل طبيعي);
        دع عدد_الإزاحات: طبيعي = الطول((*إزاحات)[ف]) مثل طبيعي;
        إذا (عدد_الإزاحات >= 0xFFFF) { ألحق_ط16_كوف(&متغير ب, 0xFFFF); } وإلا { ألحق_ط16_كوف(&متغير ب, عدد_الإزاحات); };
        ألحق_ط16_كوف(&متغير ب, 0);
        ألحق_ط32_كوف(&متغير ب, 0);
        ألحق_ط16_كوف(&متغير ب, 0);
        ألحق_ط8_كوف(&متغير ب, 0);
        ألحق_أصفار_كوف(&متغير ب, 3);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*السجل).الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_كوف = &(*السجل).الرموز[ف];
        دع طول_الاسم: طبيعي = الطول((*الرمز).الاسم) مثل طبيعي;
        إذا (طول_الاسم <= 8) {
            دع ك: متغير طبيعي = 0;
            طالما (ك < 8) {
                إذا (ك < طول_الاسم) { ألحق(ب, (*الرمز).الاسم[ك]); } وإلا { ألحق(ب, 0 مثل ط8); };
                ك := ك + 1;
            }
        } وإلا {
            ألحق_ط32_كوف(&متغير ب, 0);
            ألحق_ط32_كوف(&متغير ب, الطول(جدول_النصوص) مثل طبيعي);
            دع ك: متغير طبيعي = 0;
            طالما (ك < طول_الاسم) { ألحق(جدول_النصوص, (*الرمز).الاسم[ك]); ك := ك + 1; }
            ألحق(جدول_النصوص, 0 مثل ط8);
        };
        ألحق_ط32_كوف(&متغير ب, (*الرمز).القيمة);
        ألحق_ط16_كوف(&متغير ب, (*الرمز).القسم);
        إذا ((*الرمز).هي_دالة) { ألحق_ط16_كوف(&متغير ب, 0x20); } وإلا { ألحق_ط16_كوف(&متغير ب, 0); };
        ألحق_ط8_كوف(&متغير ب, 2);
        ألحق_ط8_كوف(&متغير ب, 0);
        ف := ف + 1;
    }
    دع حجم_الجدول: طبيعي = الطول(جدول_النصوص) مثل طبيعي;
    جدول_النصوص[0] := (حجم_الجدول % 256) مثل ط8;
    جدول_النصوص[1] := ((حجم_الجدول / 256) % 256) مثل ط8;
    جدول_النصوص[2] := ((حجم_الجدول / 65536) % 256) مثل ط8;
    جدول_النصوص[3] := ((حجم_الجدول / 16777216) % 256) مثل ط8;
    ف := 0;
    طالما (ف < حجم_الجدول) { ألحق(ب, جدول_النصوص[ف]); ف := ف + 1; }
    أرجع ب;
}

// ---- AArch64 COFF relocatable object ---------------------------------------
//
// The same sections and symbols as the x86-64 object. ARM64 relocations keep
// their addend in the instruction immediate (LLD applyArm64Addr/Imm/Ldr):
// BRANCH26 (3), PAGEBASE_REL21 (4) on ADRP, PAGEOFFSET_12A (6) on ADD,
// PAGEOFFSET_12L (7) on a scaled load/store, ADDR64 (0xE). An imported
// datum's ADRP/LDR pair addresses its import address table slot
// `__imp_<name>`; a datum this object defines is addressed directly, the
// LDR becoming ADD. Its .pdata/.xdata are described below.

عرف اقرأ_كلمة_كوف(ب: &متجه ط8, الموضع: طبيعي): طبيعي {
    دع ق: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 4;
    طالما (ف > 0) { ف := ف - 1; ق := ق * 256 + ((*ب)[الموضع + ف] مثل طبيعي); }
    أرجع ق;
}

عرف اكتب_كلمة_كوف(ب: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) { (*ب)[الموضع + ف] := (الباقي % 256) مثل ط8; الباقي := الباقي / 256; ف := ف + 1; }
}

// Places a relocation's addend in the patched instruction and answers the
// IMAGE_REL_ARM64 type, or nothing when it cannot be expressed.
عرف رقعة_إضافة_كوف_ذراع(
    ب: &متغير متجه ط8,
    الموضع: طبيعي,
    النوع: نوع_إزاحة_رمزية_كائن,
    الإضافة: عدد
): اختياري طبيعي {
    دع التعليمة: طبيعي = اقرأ_كلمة_كوف(ب, الموضع);
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت -> {
        إذا (الإضافة != 0 || (التعليمة & 0x7C000000) != 0x14000000) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(3);
    }
    | نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت -> {
        إذا ((التعليمة & 0x9F000000) != 0x90000000 || الإضافة < 0 || الإضافة >= 1048576) {
            أرجع اختياري.لا_شيء();
        };
        دع الخام: طبيعي = الإضافة مثل طبيعي;
        اكتب_كلمة_كوف(ب, الموضع, (التعليمة & 0x9F00001F) + (الخام % 4) * 0x20000000 + (الخام / 4) * 32);
        أرجع اختياري.موجود(4);
    }
    | نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت -> {
        إذا (الإضافة < 0 || الإضافة >= 4096) { أرجع اختياري.لا_شيء(); };
        دع الخام: طبيعي = الإضافة مثل طبيعي;
        إذا ((التعليمة & 0x7F800000) == 0x11000000) {
            اكتب_كلمة_كوف(ب, الموضع, (التعليمة & 0xFFC003FF) + الخام * 1024);
            أرجع اختياري.موجود(6);
        };
        إذا ((التعليمة & 0x3B000000) == 0x39000000) {
            دع الأس: متغير طبيعي = (التعليمة / 0x40000000) % 4;
            إذا ((التعليمة & 0x04800000) == 0x04800000) { الأس := الأس + 4; };
            دع المقياس: طبيعي = 1 << الأس;
            إذا (الخام % المقياس != 0) { أرجع اختياري.لا_شيء(); };
            اكتب_كلمة_كوف(ب, الموضع, (التعليمة & 0xFFC003FF) + (الخام / المقياس) * 1024);
            أرجع اختياري.موجود(7);
        };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// ---- AArch64 exception data ------------------------------------------------
//
// ARM64 exception handling (Microsoft "ARM64 exception handling"): one
// 8-byte .pdata entry per function, its start and the RVA of its .xdata
// record, both IMAGE_REL_ARM64_ADDR32NB (2). The record is written from the
// function's own words: the prologue is decoded instruction by instruction,
// one unwind code per instruction, up to the instruction that points X29 at
// the frame record (from there the codes restore SP from X29, so the stack
// allocation below the saves and the body's SP moves need no code), and every
// epilogue (an unwind-state save event of the encoder marks its first word)
// is decoded likewise up to its RET. An epilogue whose codes are a run of the
// prologue's shares them (the encoder's Windows epilogue is the prologue
// reversed); another gets its own codes after them. A function whose first
// word is no prologue instruction (a leaf such as the task switch) gets no
// entry: Windows unwinds a function without one as a leaf (PC = LR).
//
// Packed unwind data (a .pdata entry without .xdata) describes only the
// canonical frame (stp x19,x20,[sp,#-n]! first, the {X29, X30} record at
// the bottom of the frame) with a single epilogue at the end of the
// function; the encoder's frame (the saves at the top, X29 set after them,
// an epilogue at every return) never has that shape, so every entry here
// names an .xdata record.

عرف ألحق_رموز_تخصيص_فك_ذراع(الرمز: &متغير متجه طبيعي, الحجم: طبيعي): فراغ {
    دع س: طبيعي = الحجم / 16;
    إذا (س < 32) {
        // alloc_s
        ألحق(*الرمز, س);
    } وإلا إذا (س < 2048) {
        // alloc_m
        ألحق(*الرمز, 0xC0 + س / 256);
        ألحق(*الرمز, س % 256);
    } وإلا {
        // alloc_l
        ألحق(*الرمز, 0xE0);
        ألحق(*الرمز, (س / 65536) % 256);
        ألحق(*الرمز, (س / 256) % 256);
        ألحق(*الرمز, س % 256);
    };
}

// save_reg: x(19 + X) at [sp, #Z * 8].
عرف ألحق_رمز_حفظ_سجل_فك_ذراع(الرمز: &متغير متجه طبيعي, السجل: طبيعي, الإزاحة: طبيعي): فراغ {
    دع س: طبيعي = السجل - 19;
    ألحق(*الرمز, 0xD0 + س / 4);
    ألحق(*الرمز, (س % 4) * 64 + الإزاحة / 8);
}

// set_fp or add_fp: SP restored from X29 less the offset.
عرف ألحق_رمز_مؤشر_إطار_فك_ذراع(الرمز: &متغير متجه طبيعي, الإزاحة: طبيعي): منطقي {
    إذا (الإزاحة == 0) { ألحق(*الرمز, 0xE1); أرجع صواب; };
    إذا (الإزاحة % 8 != 0 || الإزاحة / 8 > 255) { أرجع خطأ; };
    ألحق(*الرمز, 0xE2);
    ألحق(*الرمز, الإزاحة / 8);
    أرجع صواب;
}

// The unwind code of one prologue word, or nothing when it is none of:
// sub sp,sp,#n; str xN,[sp,#n] (N = 19..30); stp x29,x30,[sp,#n];
// stp x29,x30,[sp,#-n]!; add x29,sp,#n (mov x29,sp).
عرف رمز_فك_مقدمة_ذراع(التعليمة: طبيعي): اختياري متجه طبيعي {
    دع الرمز: متغير متجه طبيعي = [];
    دع الفوري: طبيعي = (التعليمة / 1024) % 4096;
    دع الزوجي: طبيعي = (التعليمة / 32768) % 128;
    إذا ((التعليمة & 0xFFC003FF) == 0xD10003FF) {
        إذا (الفوري % 16 != 0 || الفوري == 0) { أرجع اختياري.لا_شيء(); };
        ألحق_رموز_تخصيص_فك_ذراع(&متغير الرمز, الفوري);
        أرجع اختياري.موجود(الرمز);
    };
    إذا ((التعليمة & 0xFFC003E0) == 0xF90003E0) {
        دع السجل: طبيعي = التعليمة % 32;
        إذا (السجل < 19 || السجل > 30 || الفوري > 63) { أرجع اختياري.لا_شيء(); };
        ألحق_رمز_حفظ_سجل_فك_ذراع(&متغير الرمز, السجل, الفوري * 8);
        أرجع اختياري.موجود(الرمز);
    };
    إذا ((التعليمة & 0xFFC07FFF) == 0xA9007BFD) {
        // save_fplr
        إذا (الزوجي > 63) { أرجع اختياري.لا_شيء(); };
        ألحق(الرمز, 0x40 + الزوجي);
        أرجع اختياري.موجود(الرمز);
    };
    إذا ((التعليمة & 0xFFC07FFF) == 0xA9807BFD) {
        // save_fplr_x: the pre-index offset is -(Z + 1) * 8, Z = 0..63.
        إذا (الزوجي < 64) { أرجع اختياري.لا_شيء(); };
        ألحق(الرمز, 0x80 + (128 - الزوجي) - 1);
        أرجع اختياري.موجود(الرمز);
    };
    إذا ((التعليمة & 0xFFC003FF) == 0x910003FD) {
        إذا (!ألحق_رمز_مؤشر_إطار_فك_ذراع(&متغير الرمز, الفوري)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الرمز);
    };
    أرجع اختياري.لا_شيء();
}

// The unwind code of one epilogue word (the reverse of a prologue word):
// sub sp,x29,#n (mov sp,x29); ldp x29,x30,[sp,#n]; ldp x29,x30,[sp],#n;
// ldr xN,[sp,#n]; add sp,sp,#n; ret (end).
عرف رمز_فك_خاتمة_ذراع(التعليمة: طبيعي): اختياري متجه طبيعي {
    دع الرمز: متغير متجه طبيعي = [];
    دع الفوري: طبيعي = (التعليمة / 1024) % 4096;
    دع الزوجي: طبيعي = (التعليمة / 32768) % 128;
    إذا (التعليمة == 0xD65F03C0) {
        ألحق(الرمز, 0xE4);
        أرجع اختياري.موجود(الرمز);
    };
    إذا ((التعليمة & 0xFFC003FF) == 0xD10003BF || التعليمة == 0x910003BF) {
        إذا (!ألحق_رمز_مؤشر_إطار_فك_ذراع(&متغير الرمز, الفوري)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الرمز);
    };
    إذا ((التعليمة & 0xFFC07FFF) == 0xA9407BFD) {
        إذا (الزوجي > 63) { أرجع اختياري.لا_شيء(); };
        ألحق(الرمز, 0x40 + الزوجي);
        أرجع اختياري.موجود(الرمز);
    };
    إذا ((التعليمة & 0xFFC07FFF) == 0xA8C07BFD) {
        إذا (الزوجي == 0 || الزوجي > 64) { أرجع اختياري.لا_شيء(); };
        ألحق(الرمز, 0x80 + الزوجي - 1);
        أرجع اختياري.موجود(الرمز);
    };
    إذا ((التعليمة & 0xFFC003E0) == 0xF94003E0) {
        دع السجل: طبيعي = التعليمة % 32;
        إذا (السجل < 19 || السجل > 30 || الفوري > 63) { أرجع اختياري.لا_شيء(); };
        ألحق_رمز_حفظ_سجل_فك_ذراع(&متغير الرمز, السجل, الفوري * 8);
        أرجع اختياري.موجود(الرمز);
    };
    إذا ((التعليمة & 0xFFC003FF) == 0x910003FF) {
        إذا (الفوري % 16 != 0 || الفوري == 0) { أرجع اختياري.لا_شيء(); };
        ألحق_رموز_تخصيص_فك_ذراع(&متغير الرمز, الفوري);
        أرجع اختياري.موجود(الرمز);
    };
    أرجع اختياري.لا_شيء();
}

عرف انسخ_رمز_فك_ذراع(الرمز: &متجه طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرمز) مثل طبيعي)) { ألحق(الناتج, (*الرمز)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف رمزا_فك_ذراع_متساويان(أ: &متجه طبيعي, ب: &متجه طبيعي): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The index of the first code of a run of الرموز equal to الخاتمة, or
// nothing.
عرف ابحث_رموز_خاتمة_فك_ذراع(الرموز: &متجه متجه طبيعي, الخاتمة: &متجه متجه طبيعي): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*الرموز) مثل طبيعي;
    دع المطلوب: طبيعي = الطول(*الخاتمة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف + المطلوب <= العدد) {
        دع مطابق: متغير منطقي = صواب;
        دع ك: متغير طبيعي = 0;
        طالما (مطابق && ك < المطلوب) {
            مطابق := رمزا_فك_ذراع_متساويان(&(*الرموز)[ف + ك], &(*الخاتمة)[ك]);
            ك := ك + 1;
        }
        إذا (مطابق) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// One .pdata entry and its .xdata record: the fragment of the function
// (its symbol فهرس_الرمز) from word البداية, عدد_الكلمات long. الرموز are
// the fragment's codes (the prologue's, then end); مواضع_الخواتيم and
// خواتيم its epilogues' word offsets in the function and codes.
عرف ألحق_مقطع_فك_كوف_ذراع(
    البيانات_الاستثنائية: &متغير متجه ط8,
    معلومات_الفك: &متغير متجه ط8,
    الإزاحات: &متغير متجه إزاحة_كوف,
    فهرس_الرمز: طبيعي,
    البداية: طبيعي,
    عدد_الكلمات: طبيعي,
    الرموز_الأولى: &متجه متجه طبيعي,
    مواضع_الخواتيم: &متجه طبيعي,
    الخواتيم: &متجه متجه متجه طبيعي
): اختياري خطأ_كوف {
    دع الرموز: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز_الأولى) مثل طبيعي)) {
        ألحق(الرموز, انسخ_رمز_فك_ذراع(&(*الرموز_الأولى)[ف]));
        ف := ف + 1;
    }
    // Epilogue scopes: the word offset in the fragment and the byte index of
    // the first code.
    دع المواضع: متغير متجه طبيعي = [];
    دع الفهارس: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(*مواضع_الخواتيم) مثل طبيعي)) {
        دع الموضع: طبيعي = (*مواضع_الخواتيم)[ف];
        إذا (الموضع >= البداية && الموضع < البداية + عدد_الكلمات) {
            دع الخاتمة: &متجه متجه طبيعي = &(*الخواتيم)[ف];
            دع الأول: متغير طبيعي = الطول(الرموز) مثل طبيعي;
            طابق ابحث_رموز_خاتمة_فك_ذراع(&الرموز, الخاتمة) مع
            | اختياري.موجود(الفهرس) -> { الأول := الفهرس; }
            | اختياري.لا_شيء -> {
                دع ر: متغير طبيعي = 0;
                طالما (ر < (الطول(*الخاتمة) مثل طبيعي)) {
                    ألحق(الرموز, انسخ_رمز_فك_ذراع(&(*الخاتمة)[ر]));
                    ر := ر + 1;
                }
            };
            دع فهرس_البايت: متغير طبيعي = 0;
            دع ر: متغير طبيعي = 0;
            طالما (ر < الأول) { فهرس_البايت := فهرس_البايت + (الطول(الرموز[ر]) مثل طبيعي); ر := ر + 1; }
            ألحق(المواضع, الموضع - البداية);
            ألحق(الفهارس, فهرس_البايت);
        };
        ف := ف + 1;
    }
    دع البايتات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(الرموز) مثل طبيعي)) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(الرموز[ف]) مثل طبيعي)) { ألحق(البايتات, الرموز[ف][ك]); ك := ك + 1; }
        ف := ف + 1;
    }
    دع كلمات_الرموز: طبيعي = ((الطول(البايتات) مثل طبيعي) + 3) / 4;
    دع عدد_الخواتيم: طبيعي = الطول(المواضع) مثل طبيعي;
    إذا (كلمات_الرموز > 255 || عدد_الخواتيم > 65535) {
        أرجع اختياري.موجود(خطأ_كوف.حدود_صيغة_متجاوزة());
    };
    // .pdata: the fragment's start (the function symbol plus the offset held
    // in the field), its .xdata record (through the .xdata section symbol).
    دع أساس: طبيعي = الطول(*البيانات_الاستثنائية) مثل طبيعي;
    ألحق_ط32_كوف(البيانات_الاستثنائية, البداية * 4);
    ألحق_ط32_كوف(البيانات_الاستثنائية, الطول(*معلومات_الفك) مثل طبيعي);
    ألحق_إزاحة_كوف(الإزاحات, أساس, فهرس_الرمز, 2);
    ألحق_إزاحة_كوف(الإزاحات, أساس + 4, 6, 2);
    // .xdata: the length in words, version 0, no handler, E 0, the epilogue
    // count and code words (in an extension word when either does not fit
    // its 5 bits), the epilogue scopes, the codes padded with nop.
    إذا (عدد_الخواتيم <= 31 && كلمات_الرموز <= 31) {
        ألحق_ط32_كوف(معلومات_الفك, عدد_الكلمات + عدد_الخواتيم * 4194304 + كلمات_الرموز * 134217728);
    } وإلا {
        ألحق_ط32_كوف(معلومات_الفك, عدد_الكلمات);
        ألحق_ط32_كوف(معلومات_الفك, عدد_الخواتيم + كلمات_الرموز * 65536);
    };
    ف := 0;
    طالما (ف < عدد_الخواتيم) {
        ألحق_ط32_كوف(معلومات_الفك, المواضع[ف] + الفهارس[ف] * 4194304);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < كلمات_الرموز * 4) {
        إذا (ف < (الطول(البايتات) مثل طبيعي)) { ألحق_ط8_كوف(معلومات_الفك, البايتات[ف]); }
        وإلا { ألحق_ط8_كوف(معلومات_الفك, 0xE3); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Appends the .pdata entries and .xdata records of one function (its
// symbol فهرس_الرمز, its words الكلمات); بدايات_الخواتيم are its
// epilogues' byte offsets in the function. The 18-bit length field limits
// a record to 262143 words: a longer function is cut into fragments that
// split no epilogue; a fragment after the first has no prologue, its codes
// starting with end_c (a prologue of no instruction) before the prologue's.
عرف ألحق_فك_دالة_كوف_ذراع(
    البيانات_الاستثنائية: &متغير متجه ط8,
    معلومات_الفك: &متغير متجه ط8,
    الإزاحات: &متغير متجه إزاحة_كوف,
    فهرس_الرمز: طبيعي,
    الكلمات: &متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    بدايات_الخواتيم: &متجه طبيعي
): اختياري خطأ_كوف {
    دع عدد_الكلمات: طبيعي = الطول(*الكلمات) مثل طبيعي;
    دع المقدمة: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر && ف < عدد_الكلمات) {
        طابق رمز_فك_مقدمة_ذراع((*الكلمات)[ف].القيمة) مع
        | اختياري.لا_شيء -> { مستمر := خطأ; }
        | اختياري.موجود(الرمز) -> {
            // The prologue ends where X29 is set.
            إذا (الرمز[0] == 0xE1 || الرمز[0] == 0xE2) { مستمر := خطأ; };
            ألحق(المقدمة, الرمز);
            ف := ف + 1;
        };
    }
    إذا ((الطول(المقدمة) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    // The codes run from the last prologue word to the first, then end.
    دع رموز_المقدمة: متغير متجه متجه طبيعي = [];
    دع رموز_بلا_مقدمة: متغير متجه متجه طبيعي = [];
    دع نهاية_مقدمة: متجه طبيعي = [0xE5];
    ألحق(رموز_بلا_مقدمة, نهاية_مقدمة);
    ف := الطول(المقدمة) مثل طبيعي;
    طالما (ف > 0) {
        ف := ف - 1;
        ألحق(رموز_المقدمة, انسخ_رمز_فك_ذراع(&المقدمة[ف]));
        ألحق(رموز_بلا_مقدمة, انسخ_رمز_فك_ذراع(&المقدمة[ف]));
    }
    دع النهاية: متجه طبيعي = [0xE4];
    دع النهاية_الثانية: متجه طبيعي = [0xE4];
    ألحق(رموز_المقدمة, النهاية);
    ألحق(رموز_بلا_مقدمة, النهاية_الثانية);
    // Each epilogue decoded up to its RET.
    دع المواضع: متغير متجه طبيعي = [];
    دع النهايات: متغير متجه طبيعي = [];
    دع الخواتيم: متغير متجه متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(*بدايات_الخواتيم) مثل طبيعي)) {
        دع الموضع: طبيعي = (*بدايات_الخواتيم)[ف] / 4;
        دع الخاتمة: متغير متجه متجه طبيعي = [];
        دع ك: متغير طبيعي = الموضع;
        دع انتهت: متغير منطقي = خطأ;
        طالما (!انتهت) {
            إذا (ك >= عدد_الكلمات) { أرجع اختياري.موجود(خطأ_كوف.حدود_صيغة_متجاوزة()); };
            طابق رمز_فك_خاتمة_ذراع((*الكلمات)[ك].القيمة) مع
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_كوف.حدود_صيغة_متجاوزة()); }
            | اختياري.موجود(الرمز) -> {
                انتهت := الرمز[0] == 0xE4;
                ألحق(الخاتمة, الرمز);
            };
            ك := ك + 1;
        }
        ألحق(المواضع, الموضع);
        ألحق(النهايات, ك);
        ألحق(الخواتيم, الخاتمة);
        ف := ف + 1;
    }
    دع البداية: متغير طبيعي = 0;
    طالما (البداية < عدد_الكلمات) {
        دع النهاية_المقطع: متغير طبيعي = البداية + 262143;
        إذا (النهاية_المقطع > عدد_الكلمات) { النهاية_المقطع := عدد_الكلمات; };
        // A fragment ends before an epilogue it would split.
        ف := 0;
        طالما (ف < (الطول(المواضع) مثل طبيعي)) {
            إذا (المواضع[ف] > البداية && المواضع[ف] < النهاية_المقطع && النهايات[ف] > النهاية_المقطع) {
                النهاية_المقطع := المواضع[ف];
            };
            ف := ف + 1;
        }
        دع النتيجة: متغير اختياري خطأ_كوف = اختياري.لا_شيء();
        إذا (البداية == 0) {
            النتيجة := ألحق_مقطع_فك_كوف_ذراع(
                البيانات_الاستثنائية, معلومات_الفك, الإزاحات, فهرس_الرمز, البداية,
                النهاية_المقطع - البداية, &رموز_المقدمة, &المواضع, &الخواتيم
            );
        } وإلا {
            النتيجة := ألحق_مقطع_فك_كوف_ذراع(
                البيانات_الاستثنائية, معلومات_الفك, الإزاحات, فهرس_الرمز, البداية,
                النهاية_المقطع - البداية, &رموز_بلا_مقدمة, &المواضع, &الخواتيم
            );
        };
        طابق النتيجة مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        البداية := النهاية_المقطع;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف اكتب_كائن_كوف_ذراع_أربعة_وستون(
    الشفرة: &شفرة_ذراع_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): نتيجة_كوف {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | _ -> { أرجع نتيجة_كوف.خطأ(خطأ_كوف.معمارية_غير_مدعومة((*الهدف).المعرف)); };
    دع السجل: متغير سجل_رموز_كوف = سجل_رموز_كوف_جديد();
    دع النص: متغير متجه ط8 = [];
    دع البدايات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الشفرة).الدوال) مثل طبيعي)) {
        دع الدالة: &دالة_ذراع_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[ف];
        ألحق(البدايات, الطول(النص) مثل طبيعي);
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة((*الدالة).المعرف);
        طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 1, الطول(النص) مثل طبيعي, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الدالة).الكلمات) مثل طبيعي)) {
            ألحق_ط32_كوف(&متغير النص, (*الدالة).الكلمات[ك].القيمة);
            ك := ك + 1;
        }
        ف := ف + 1;
    }
    دع إزاحات_النص: متغير متجه إزاحة_كوف = [];
    // The process entry `_start`.
    دع بداية_الدخول: متغير طبيعي = 0;
    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        بداية_الدخول := الطول(النص) مثل طبيعي;
        طابق رمز_كوف_بالاسم(&متغير السجل, بايتات_من_نص(«_start»), 1, بداية_الدخول, صواب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(الدخول.الكلمات) مثل طبيعي)) {
            ألحق_ط32_كوف(&متغير النص, الدخول.الكلمات[ك].القيمة);
            ك := ك + 1;
        }
    };
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.البيانات_الثابتة) مثل طبيعي)) {
        دع الثابت: &بيانات_ثابتة_كائن = &(*الشفرة).المرفقات.البيانات_الثابتة[ف];
        دع الموضع: طبيعي = حاذ_كوف(الطول(النص) مثل طبيعي, (*الثابت).المحاذاة);
        ألحق_أصفار_كوف(&متغير النص, الموضع - (الطول(النص) مثل طبيعي));
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.بيانات_ثابتة((*الثابت).المعرف);
        طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 1, الموضع, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول((*الثابت).البيانات) مثل طبيعي)) { ألحق(النص, (*الثابت).البيانات[ب]); ب := ب + 1; }
        ف := ف + 1;
    }

    دع البيانات: متغير متجه ط8 = [];
    دع محاذاة_البيانات: متغير طبيعي = 8;
    دع مواضع_العوام: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع العام: &بيانات_عام_كائن = &(*الشفرة).المرفقات.البيانات_العامة[ف];
        إذا ((*العام).المحاذاة > محاذاة_البيانات) { محاذاة_البيانات := (*العام).المحاذاة; };
        دع الموضع: طبيعي = حاذ_كوف(الطول(البيانات) مثل طبيعي, (*العام).المحاذاة);
        ألحق_أصفار_كوف(&متغير البيانات, الموضع - (الطول(البيانات) مثل طبيعي));
        ألحق(مواضع_العوام, الموضع);
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.عام((*العام).المعرف);
        طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 2, الموضع, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول((*العام).البيانات) مثل طبيعي)) { ألحق(البيانات, (*العام).البيانات[ب]); ب := ب + 1; }
        ف := ف + 1;
    }
    دع إزاحات_البيانات: متغير متجه إزاحة_كوف = [];
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع العام: &بيانات_عام_كائن = &(*الشفرة).المرفقات.البيانات_العامة[ف];
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*العام).الإزاحات) مثل طبيعي)) {
            دع الطلب: &طلب_إزاحة_بيانات_كائن = &(*العام).الإزاحات[ر];
            دع الرمز_المحلول: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(
                &(*الطلب).الرمز, &(*الشفرة).المرفقات, الرموز_الخارجية
            );
            طابق رمز_كوف_بالمرجع(&متغير السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
            | نتيجة.نجح(الفهرس) -> {
                دع الموضع: طبيعي = مواضع_العوام[ف] + (*الطلب).الموضع;
                إذا (!اكتب_عدد_في_كوف(&متغير البيانات, الموضع, (*الطلب).الإضافة مثل عدد, 8)) {
                    أرجع نتيجة_كوف.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة());
                };
                ألحق_إزاحة_كوف(&متغير إزاحات_البيانات, الموضع, الفهرس, 0xE);
            };
            ر := ر + 1;
        }
        ف := ف + 1;
    }

    // Code relocations, functions first, then the entry's.
    ف := 0;
    طالما (ف < (الطول((*الشفرة).المرفقات.إزاحات_النص) مثل طبيعي)) {
        دع الطلب: &طلب_إزاحة_نص_كائن = &(*الشفرة).المرفقات.إزاحات_النص[ف];
        دع بداية: متغير طبيعي = 0;
        دع وجدت: متغير منطقي = خطأ;
        دع د: متغير طبيعي = 0;
        طالما (د < (الطول((*الشفرة).الدوال) مثل طبيعي) && !وجدت) {
            إذا (معرفا_دالة_منتقاة_متساويان((*الشفرة).الدوال[د].المعرف, (*الطلب).الموضع.الدالة)) {
                بداية := البدايات[د];
                وجدت := صواب;
            };
            د := د + 1;
        }
        إذا (!وجدت) { أرجع نتيجة_كوف.خطأ(خطأ_كوف.حدود_صيغة_متجاوزة()); };
        طابق أضف_إزاحة_تعليمة_كوف_ذراع(
            &متغير النص, &متغير إزاحات_النص, &متغير السجل, بداية + (*الطلب).الموضع.إزاحة_بايت,
            (*الطلب).النوع, &(*الطلب).الرمز, (*الطلب).الإضافة, &(*الشفرة).المرفقات, الهدف, الرموز_الخارجية
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        ف := 0;
        طالما (ف < (الطول(الدخول.الإزاحات) مثل طبيعي)) {
            طابق أضف_إزاحة_تعليمة_كوف_ذراع(
                &متغير النص, &متغير إزاحات_النص, &متغير السجل, بداية_الدخول + الدخول.الإزاحات[ف].إزاحة_بايت,
                الدخول.الإزاحات[ف].النوع, &الدخول.الإزاحات[ف].الرمز, 0, &(*الشفرة).المرفقات, الهدف, الرموز_الخارجية
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
    };

    // .pdata/.xdata: the functions, then the entry.
    دع البيانات_الاستثنائية: متغير متجه ط8 = [];
    دع معلومات_الفك: متغير متجه ط8 = [];
    دع إزاحات_الاستثناء: متغير متجه إزاحة_كوف = [];
    ف := 0;
    طالما (ف < (الطول((*الشفرة).الدوال) مثل طبيعي)) {
        دع الدالة: &دالة_ذراع_أربعة_وستون_مشفرة = &(*الشفرة).الدوال[ف];
        دع الخواتيم: متغير متجه طبيعي = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*الدالة).أحداث_فك_المكدس) مثل طبيعي)) {
            طابق (*الدالة).أحداث_فك_المكدس[ح].الحدث مع
            | نوع_حدث_فك_المكدس.احفظ_الحالة -> { ألحق(الخواتيم, (*الدالة).أحداث_فك_المكدس[ح].إزاحة_بايت); }
            | _ -> { };
            ح := ح + 1;
        }
        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة((*الدالة).المعرف);
        طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 0, 0, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(الفهرس) -> {
            طابق ألحق_فك_دالة_كوف_ذراع(
                &متغير البيانات_الاستثنائية, &متغير معلومات_الفك, &متغير إزاحات_الاستثناء,
                الفهرس, &(*الدالة).الكلمات, &الخواتيم
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        طابق رمز_كوف_بالاسم(&متغير السجل, بايتات_من_نص(«_start»), 0, 0, صواب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
        | نتيجة.نجح(الفهرس) -> {
            دع بلا_خواتيم: متجه طبيعي = [];
            طابق ألحق_فك_دالة_كوف_ذراع(
                &متغير البيانات_الاستثنائية, &متغير معلومات_الفك, &متغير إزاحات_الاستثناء,
                الفهرس, &الدخول.الكلمات, &بلا_خواتيم
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    };

    دع المنشئات: متغير متجه ط8 = [];
    دع إزاحات_المنشئات: متغير متجه إزاحة_كوف = [];
    طابق (*الشفرة).دخول_عملية_لينكس مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        طابق (*الشفرة).المرفقات.منشئ_الوحدة مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المعرف) -> {
            دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(المعرف);
            طابق رمز_كوف_بالمرجع(&متغير السجل, &المرجع, 0, 0, الهدف, الرموز_الخارجية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_كوف.خطأ(الخطأ); }
            | نتيجة.نجح(الفهرس) -> {
                ألحق_أصفار_كوف(&متغير المنشئات, 8);
                ألحق_إزاحة_كوف(&متغير إزاحات_المنشئات, 0, الفهرس, 0xE);
            };
        };
    };
    دع محتويات: متجه متجه ط8 = [النص, البيانات, البيانات_الاستثنائية, معلومات_الفك, المنشئات];
    دع إزاحات_الفك: متجه إزاحة_كوف = [];
    دع إزاحات: متجه متجه إزاحة_كوف = [إزاحات_النص, إزاحات_البيانات, إزاحات_الاستثناء, إزاحات_الفك, إزاحات_المنشئات];
    أرجع نتيجة_كوف.نجح(سلسل_كائن_كوف(0xAA64, &السجل, &محتويات, &إزاحات, محاذاة_البيانات));
}

عرف أضف_إزاحة_تعليمة_كوف_ذراع(
    النص: &متغير متجه ط8,
    الإزاحات: &متغير متجه إزاحة_كوف,
    السجل: &متغير سجل_رموز_كوف,
    الموضع: طبيعي,
    النوع: نوع_إزاحة_رمزية_كائن,
    الرمز: &مرجع_رمز_كائن,
    الإضافة: عدد,
    المرفقات: &مرفقات_كائن_مشفرة,
    الهدف: &واصف_هدف,
    الرموز_الخارجية: &متجه متجه ط8
): اختياري خطأ_كوف {
    إذا (الموضع % 4 != 0 || الموضع + 4 > (الطول(*النص) مثل طبيعي)) {
        أرجع اختياري.موجود(خطأ_كوف.حدود_صيغة_متجاوزة());
    };
    دع الرمز_المحلول: مرجع_رمز_كائن = حل_مرجع_بيانات_خارجية_كائن(الرمز, المرفقات, الرموز_الخارجية);
    دع النوع_الفعلي: متغير نوع_إزاحة_رمزية_كائن = النوع;
    دع فهرس_الرمز: متغير طبيعي = 0;
    طابق النوع مع
    | نوع_إزاحة_رمزية_كائن.مطلق_أربعة_وستون_بت -> {
        طابق رمز_كوف_بالمرجع(السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(الفهرس) -> {
            إذا (!اكتب_عدد_في_كوف(النص, الموضع, الإضافة, 8)) {
                أرجع اختياري.موجود(خطأ_كوف.حدود_صيغة_متجاوزة());
            };
            ألحق_إزاحة_كوف(الإزاحات, الموضع, الفهرس, 0xE);
            أرجع اختياري.لا_شيء();
        };
    }
    | نوع_إزاحة_رمزية_كائن.صفحة_تحميل_جوت_ذراع_واحد_وعشرون_بت -> {
        النوع_الفعلي := نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت();
    }
    | نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_تحميل_جوت_ذراع_اثنا_عشر_بت -> {
        النوع_الفعلي := نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت();
    }
    | _ -> { };
    دع جوت: منطقي = النوع != النوع_الفعلي;
    دع محلي: متغير منطقي = خطأ;
    إذا (جوت) {
        طابق ابحث_في_الخريطة(&(*السجل).الهوية, &الرمز_المحلول) مع
        | اختياري.موجود(الفهرس_المحلي) -> { محلي := (*السجل).الرموز[الفهرس_المحلي].القسم != 0; }
        | اختياري.لا_شيء -> { };
    };
    إذا (جوت && !محلي) {
        // The import address table slot holds the datum's address.
        دع اسم_الاستيراد: متغير متجه ط8 = بايتات_من_نص(«__imp_»);
        طابق اسم_مرجع_رمز_كوف(&الرمز_المحلول, الهدف, الرموز_الخارجية) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_كوف.رمز_إزاحة_مفقود()); }
        | اختياري.موجود(الاسم) -> {
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(الاسم) مثل طبيعي)) { ألحق(اسم_الاستيراد, الاسم[ب]); ب := ب + 1; }
        };
        طابق رمز_كوف_بالاسم(السجل, اسم_الاستيراد, 0, 0, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(الفهرس) -> { فهرس_الرمز := الفهرس; };
    } وإلا {
        إذا (جوت && النوع_الفعلي == نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت()) {
            // ldr xD, [xN, #lo12] becomes add xD, xN, #lo12 of the datum.
            دع التعليمة: طبيعي = اقرأ_كلمة_كوف(النص, الموضع);
            اكتب_كلمة_كوف(النص, الموضع, 0x91000000 + (التعليمة & 0x3FF));
        };
        طابق رمز_كوف_بالمرجع(السجل, &الرمز_المحلول, 0, 0, الهدف, الرموز_الخارجية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(الفهرس) -> { فهرس_الرمز := الفهرس; };
    };
    طابق رقعة_إضافة_كوف_ذراع(النص, الموضع, النوع_الفعلي, الإضافة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_كوف.إزاحة_غير_مدعومة()); }
    | اختياري.موجود(رقم_النوع) -> {
        ألحق_إزاحة_كوف(الإزاحات, الموضع, فهرس_الرمز, رقم_النوع);
        أرجع اختياري.لا_شيء();
    };
}
