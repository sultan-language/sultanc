// B8 هو حد تركيب فقط: Target يقرر اكتمال القدرة، وكل مرحلة لاحقة تبقى عند مالكها.
// كل طبقة تضيف سياقها ولا تحذف خطأ المالك الأدنى.
عام نوع فشل_تخصيص_ذراع_أربعة_وستون =
    | يحتاج_انسكاب بنوع سبب_حاجة_انسكاب
    | فشل_قيود بنوع معرف_سجل_افتراضي
    | حالة_انسكاب_غير_مدعومة بنوع معرف_سجل_افتراضي
    | سياسة_إطار_غير_متاحة بنوع معرف_هدف
    | هدف_غير_صالح بنوع معرف_هدف
;

عام نوع فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون =
    | يحتاج_انسكاب بنوع سبب_حاجة_انسكاب
    | فشل_قيود بنوع معرف_سجل_افتراضي
    | حالة_انسكاب_غير_مدعومة بنوع معرف_سجل_افتراضي
    | سياسة_إطار_غير_متاحة بنوع معرف_هدف
    | هدف_غير_صالح بنوع معرف_هدف
;

عام نوع فشل_إصدار_كائن_ذراع =
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | خطأ_ماتشو بنوع خطأ_ماتشو
;

عام نوع فشل_إصدار_كائن_إكس =
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | خطأ_إلف بنوع خطأ_إلف
;

عام نوع فشل_حل_دخول_أصلي =
    | دالة_مسير_مفقودة بنوع معرف_دالة_مسير
    | واجهة_دخول_غير_متاحة بنوع (معرف_دالة_مسير, خطأ_حل_واجهة_اختيار)
    | هدف_دخول_غير_متاح بنوع معرف_هدف
    | مهايئ_دخول_مطلوب بنوع معرف_دالة_مسير
;

عام نوع فشل_مخرج_أصلي =
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | دخول_تنفيذي بنوع فشل_حل_دخول_أصلي
    | اختيار بنوع فشل_شفرة_منتقاة_أصلية
    | اختيار_غير_متطابق بنوع معرف_هدف
    | تخصيص_ذراع بنوع فشل_تخصيص_ذراع_أربعة_وستون
    | ترميز_ذراع بنوع خطأ_ترميز_ذراع_أربعة_وستون
    | كائن_ذراع بنوع فشل_إصدار_كائن_ذراع
    | تخصيص_إكس بنوع فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون
    | ترميز_إكس بنوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
    | كائن_إكس بنوع فشل_إصدار_كائن_إكس
    | اختيار_ويب_أسمبلي بنوع خطأ_اختيار_ويب_أسمبلي
    | كائن_ويب_أسمبلي بنوع خطأ_كائن_ويب_أسمبلي
    | تخطيط_عام_غير_مكتمل بنوع معرف_عام_مسير
    | تهيئة_عام_غير_مدعومة بنوع معرف_عام_مسير
;

عام نوع نتيجة_مخرج_أصلي =
    | نجح بنوع متجه غ8
    | أخفق بنوع فشل_مخرج_أصلي
;

عام نوع نتيجة_مخرج_أصلي_مفصل =
    | نجح بنوع ناتج_كائن_أصلي_مفصل
    | أخفق بنوع فشل_مخرج_أصلي
;

نوع نتيجة_حل_دخول_أصلي =
    | بلا_دخول
    | تصدير_مباشر بنوع معرف_دالة_منتقاة
    | أخفق بنوع فشل_حل_دخول_أصلي
;

نوع نتيجة_مادة_عوام_أصلية =
    | نجحت
    | أخفقت بنوع فشل_مخرج_أصلي
;

عرف ألحق_قيمة_عددية_عامة(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع,
    الحجم: غير_موقع,
    الترتيب: ترتيب_بايت
): منطقي {
    لو (الحجم == 0 || الحجم > 8) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        دع إزاحة_البايت: غير_موقع;
        طابق الترتيب مع
        | ترتيب_بايت.صغير -> { إزاحة_البايت := ف; }
        | ترتيب_بايت.كبير -> { إزاحة_البايت := الحجم - 1 - ف; };
        دع القاسم: متغير غير_موقع = 1;
        دع ب: متغير غير_موقع = 0;
        بينما (ب < إزاحة_البايت) { القاسم := القاسم * 256; ب := ب + 1; }
        دع المقسوم: غير_موقع = القيمة / القاسم;
        دع قيمة_البايت: غير_موقع = المقسوم % 256;
        دع البايت: غ8 = قيمة_البايت مثل غ8;
        ألحق(*البايتات, البايت);
        ف := ف + 1;
    }
    أرجع صواب;
}


// A vector header and all nested backing arrays belong to one global symbol.
// Every pointer field is a symbolic relocation into that same object's data.
// No embedded runtime and no independent backing-symbol identity is needed.
عرف اكتب_قيمة_عامة_في(
    البايتات: &متغير متجه غ8, الموضع: غير_موقع, القيمة: غير_موقع,
    الحجم: غير_موقع, الترتيب: ترتيب_بايت
): منطقي {
    لو (الحجم == 0 || الحجم > 8 || الموضع > (الطول(*البايتات) مثل غير_موقع)
        || الحجم > (الطول(*البايتات) مثل غير_موقع) - الموضع) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        دع إزاحة_البايت: غير_موقع;
        طابق الترتيب مع
        | ترتيب_بايت.صغير -> { إزاحة_البايت := ف; }
        | ترتيب_بايت.كبير -> { إزاحة_البايت := الحجم - 1 - ف; };
        دع المقسوم: متغير غير_موقع = القيمة;
        دع ب: متغير غير_موقع = 0;
        بينما (ب < إزاحة_البايت) { المقسوم := المقسوم / 256; ب := ب + 1; }
        (*البايتات)[الموضع + ف] := (المقسوم % 256) مثل غ8;
        ف := ف + 1;
    }
    أرجع صواب;
}

// Pointer-sized static data (vector headers, function addresses) is
// materialized for the 64-bit native targets and for wasm32.
عرف عرض_مؤشر_عام_مدعوم(العرض: غير_موقع): منطقي {
    أرجع العرض == 64 || العرض == 32;
}

عرف حاذ_بيانات_عامة(القيمة: غير_موقع, المحاذاة: غير_موقع): غير_موقع {
    لو (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + المحاذاة - الباقي;
}

عرف اكتب_متجه_عام_أصلي(
    العناصر: &متجه ثابت_مسير, نوع_المتجه: معرف_نوع,
    موضع_الرأس: غير_موقع, معرف_العام: معرف_عام_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية, الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البايتات: &متغير متجه غ8, الإزاحات: &متغير متجه طلب_إزاحة_بيانات_كائن,
    المحاذاة_القصوى: &متغير غير_موقع
): منطقي {
    دع عرض_المؤشر: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر;
    لو (!عرض_مؤشر_عام_مدعوم(عرض_المؤشر)) { أرجع خطأ; };
    دع حجم_المؤشر: غير_موقع = عرض_المؤشر / 8;
    دع العدد: غير_موقع = الطول(*العناصر) مثل غير_موقع;
    لو (موضع_الرأس > (الطول(*البايتات) مثل غير_موقع)
        || 3 * حجم_المؤشر > (الطول(*البايتات) مثل غير_موقع) - موضع_الرأس) {
        أرجع خطأ;
    };
    دع نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_متجه_دلالي(&(*الحقائق).الأنواع, نوع_المتجه) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { نوع_العنصر := القيمة; };
    دع تخطيط_العنصر: واصف_تخطيط;
    طابق حل_تخطيط_نوع(&(*الحقائق).الأنواع, الهدف, سجل_التخطيط, نوع_العنصر) مع
    | نتيجة_تخطيط.مكتمل(القيمة) -> { تخطيط_العنصر := القيمة; }
    | _ -> { أرجع خطأ; };
    لو (تخطيط_العنصر.الحجم == 0 || تخطيط_العنصر.المحاذاة == 0) { أرجع خطأ; };
    لو (تخطيط_العنصر.المحاذاة > *المحاذاة_القصوى) {
        *المحاذاة_القصوى := تخطيط_العنصر.المحاذاة;
    };
    لو (!اكتب_قيمة_عامة_في(البايتات, موضع_الرأس + حجم_المؤشر,
        العدد, حجم_المؤشر, (*الهدف).نموذج_البيانات.ترتيب_البايت)
        || !اكتب_قيمة_عامة_في(البايتات, موضع_الرأس + 2 * حجم_المؤشر,
        العدد, حجم_المؤشر, (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
    لو (العدد == 0) { أرجع صواب; };
    دع الحجم_الحالي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع موضع_العناصر: غير_موقع = حاذ_بيانات_عامة(الحجم_الحالي, تخطيط_العنصر.المحاذاة);
    لو (موضع_العناصر < الحجم_الحالي) { أرجع خطأ; };
    // Reject an overflowing array range before extending the object buffer.
    دع أقصى_موضع: غير_موقع = 0xFFFFFFFFFFFFFFFF;
    لو (العدد > (أقصى_موضع - موضع_العناصر) / تخطيط_العنصر.الحجم) { أرجع خطأ; };
    دع موضع_الحشو: متغير غير_موقع = الحجم_الحالي;
    بينما (موضع_الحشو < موضع_العناصر) { ألحق(*البايتات, 0 مثل غ8); موضع_الحشو := موضع_الحشو + 1; };
    // Reserve all array elements before recursing: nested backing arrays must
    // not interrupt the contiguous storage of the enclosing vector.
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع ب: متغير غير_موقع = 0;
        بينما (ب < تخطيط_العنصر.الحجم) { ألحق(*البايتات, 0 مثل غ8); ب := ب + 1; };
        ف := ف + 1;
    }
    دع مرجع_العام: مرجع_رمز_كائن = مرجع_رمز_كائن.عام(معرف_العام);
    دع طلب: طلب_إزاحة_بيانات_كائن = {
        الموضع: موضع_الرأس, الرمز: مرجع_العام, الإضافة: موضع_العناصر
    };
    ألحق(*الإزاحات, طلب);
    ف := 0;
    بينما (ف < العدد) {
        دع موضع_العنصر: غير_موقع = موضع_العناصر + ف * تخطيط_العنصر.الحجم;
        طابق (*العناصر)[ف] مع
        | ثابت_مسير.متجه(المضمنة) -> {
            لو (!اكتب_متجه_عام_أصلي(&المضمنة, نوع_العنصر, موضع_العنصر,
                معرف_العام, الحقائق, الهدف, سجل_التخطيط, البايتات, الإزاحات,
                المحاذاة_القصوى)) {
                أرجع خطأ;
            };
        }
        | ثابت_مسير.صحيح_موقع(العدد_الموقع) -> {
            لو (!اكتب_قيمة_عامة_في(البايتات, موضع_العنصر,
                العدد_الموقع مثل غير_موقع, تخطيط_العنصر.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
        }
        | ثابت_مسير.صحيح_غير_موقع(العدد_الصحيح) -> {
            لو (!اكتب_قيمة_عامة_في(البايتات, موضع_العنصر,
                العدد_الصحيح, تخطيط_العنصر.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
        }
        | ثابت_مسير.مؤشر_فارغ -> {
            // MSIR verifies the raw-pointer Type. Keep its target width
            // instead of treating null as an integer constant of host size.
            طابق نوع_أساس_عند(&(*الحقائق).الأنواع, نوع_العنصر) مع
            | اختيار.بعض(نوع_مقنن.مؤشر(_)) -> { }
            | _ -> { أرجع خطأ; };
            لو (تخطيط_العنصر.الحجم != حجم_المؤشر) { أرجع خطأ; };
            // Elements are reserved as zeroed storage above. No relocation:
            // a null pointer must never acquire backing-object provenance.
        }
        | ثابت_مسير.منطق(القيمة) -> {
            دع الخام: غير_موقع;
            لو (القيمة) { الخام := 1; } وإلا { الخام := 0; };
            لو (!اكتب_قيمة_عامة_في(البايتات, موضع_العنصر,
                الخام, تخطيط_العنصر.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
        }
        | ثابت_مسير.دالة(المعرف) -> {
            لو (تخطيط_العنصر.الحجم != حجم_المؤشر) { أرجع خطأ; };
            دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المعرف));
            دع الطلب: طلب_إزاحة_بيانات_كائن = {
                الموضع: موضع_العنصر, الرمز: الرمز, الإضافة: 0
            };
            ألحق(*الإزاحات, الطلب);
        }
        | ثابت_مسير.عشري(البايتات_العشرية) -> {
            دع العرض: غير_موقع;
            طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, نوع_العنصر) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(البتات) -> { العرض := البتات; };
            لو (تخطيط_العنصر.الحجم != العرض / 8) { أرجع خطأ; };
            دع الخام: غير_موقع;
            طابق بتات_عائم_من_عشري(&البايتات_العشرية, العرض) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(البتات) -> { الخام := البتات; };
            لو (!اكتب_قيمة_عامة_في(البايتات, موضع_العنصر,
                الخام, تخطيط_العنصر.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف مادة_عوام_مسير_للكائن(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المرفقات: &متغير مرفقات_كائن_مشفرة
): نتيجة_مادة_عوام_أصلية {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*المسير).المسير.العوام) مثل غير_موقع)) {
        دع العام: &عام_مسير = &(*المسير).المسير.العوام[ف];
        دع مستورد: متغير منطقي = خطأ;
        طابق (*العام).الاسم_الخارجي مع
        | اختيار.بعض(الاسم) -> {
            دع البيان: بيانات_خارجية_كائن = {
                المعرف: (*العام).المعرف,
                الاسم: انسخ_اسم_رمز_خارجي_كائن(&الاسم)
            };
            ألحق((*المرفقات).البيانات_الخارجية, البيان);
            مستورد := صواب;
        }
        | اختيار.لا_شيء -> { };
        لو (!مستورد) {
        دع التخطيط: واصف_تخطيط;
        طابق حل_تخطيط_نوع(&(*حقائق_الخلفية).الأنواع, الهدف, سجل_التخطيط, (*العام).النوع) مع
        | نتيجة_تخطيط.مكتمل(الوصف) -> { التخطيط := الوصف; }
        | نتيجة_تخطيط.مؤجل(_) -> {
            أرجع نتيجة_مادة_عوام_أصلية.أخفقت(
                فشل_مخرج_أصلي.تخطيط_عام_غير_مكتمل((*العام).المعرف)
            );
        }
        | نتيجة_تخطيط.مرفوض(_) -> {
            أرجع نتيجة_مادة_عوام_أصلية.أخفقت(
                فشل_مخرج_أصلي.تخطيط_عام_غير_مكتمل((*العام).المعرف)
            );
        };
        دع البيانات: متغير متجه غ8 = [];
        دع محاذاة_البيانات: متغير غير_موقع = التخطيط.المحاذاة;
        دع إزاحات_البيانات: متغير متجه طلب_إزاحة_بيانات_كائن = [];
        دع الخام: متغير غير_موقع = 0;
        دع مدعوم: متغير منطقي = صواب;
        طابق (*العام).التهيئة مع
        | ثابت_مسير.منطق(القيمة) -> { لو (القيمة) { الخام := 1; } وإلا { الخام := 0; }; }
        | ثابت_مسير.صحيح_موقع(القيمة) -> { الخام := القيمة مثل غير_موقع; }
        | ثابت_مسير.صحيح_غير_موقع(القيمة) -> { الخام := القيمة; }
        | ثابت_مسير.مؤشر_فارغ -> {
            دع عرض_المؤشر: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر;
            دع حجم_المؤشر: غير_موقع = عرض_المؤشر / 8;
            طابق نوع_أساس_عند(&(*حقائق_الخلفية).الأنواع, (*العام).النوع) مع
            | اختيار.بعض(نوع_مقنن.مؤشر(_)) -> { }
            | _ -> { مدعوم := خطأ; };
            لو (عرض_المؤشر == 0 || عرض_المؤشر % 8 != 0
                || حجم_المؤشر > 8 || التخطيط.الحجم != حجم_المؤشر) {
                مدعوم := خطأ;
            };
            // The scalar writer below serializes exactly pointer-width zero
            // bytes without a relocation or integer-to-pointer coercion.
        }
        | ثابت_مسير.دالة(المعرف) -> {
            دع حجم_المؤشر: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
            لو (!عرض_مؤشر_عام_مدعوم((*الهدف).نموذج_البيانات.عرض_المؤشر)
                || التخطيط.الحجم != حجم_المؤشر) {
                مدعوم := خطأ;
            } وإلا {
                دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المعرف));
                دع الطلب: طلب_إزاحة_بيانات_كائن = {
                    الموضع: 0, الرمز: الرمز, الإضافة: 0
                };
                ألحق(إزاحات_البيانات, الطلب);
                دع ب: متغير غير_موقع = 0;
                بينما (ب < حجم_المؤشر) { ألحق(البيانات, 0 مثل غ8); ب := ب + 1; };
            };
        }
        | ثابت_مسير.عشري(البايتات_العشرية) -> {
            دع العرض: متغير غير_موقع = 0;
            طابق بتات_عائم_للاختيار(&(*حقائق_الخلفية).الأنواع, (*العام).النوع) مع
            | اختيار.لا_شيء -> { مدعوم := خطأ; }
            | اختيار.بعض(البتات) -> { العرض := البتات; };
            لو (مدعوم) {
                لو (التخطيط.الحجم != العرض / 8) {
                    مدعوم := خطأ;
                } وإلا {
                    طابق بتات_عائم_من_عشري(&البايتات_العشرية, العرض) مع
                    | اختيار.لا_شيء -> { مدعوم := خطأ; }
                    | اختيار.بعض(البتات) -> { الخام := البتات; };
                };
            };
        }
        | ثابت_مسير.متجه(العناصر) -> {
            // A nonempty mutable vector cannot own statically allocated backing:
            // growth/release must never free object storage.
            لو ((*العام).قابل_للكتابة && (الطول(العناصر) مثل غير_موقع) != 0) {
                مدعوم := خطأ;
            } وإلا {
                دع حجم_المؤشر: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
                لو (!عرض_مؤشر_عام_مدعوم((*الهدف).نموذج_البيانات.عرض_المؤشر)
                    || التخطيط.الحجم != حجم_المؤشر * 3
                    || التخطيط.المحاذاة != حجم_المؤشر) {
                    مدعوم := خطأ;
                } وإلا {
                    دع ب: متغير غير_موقع = 0;
                    بينما (ب < التخطيط.الحجم) { ألحق(البيانات, 0 مثل غ8); ب := ب + 1; };
                    مدعوم := اكتب_متجه_عام_أصلي(
                        &العناصر, (*العام).النوع, 0, (*العام).المعرف,
                        حقائق_الخلفية, الهدف, سجل_التخطيط,
                        &متغير البيانات, &متغير إزاحات_البيانات,
                        &متغير محاذاة_البيانات
                    );
                };
            };
        }
        | ثابت_مسير.نص(بايتات_النص) -> {
            // Static text and byte vectors share the target sequence layout;
            // storage remains attached to the owning global symbol.
            دع عدد_البايتات: غير_موقع = الطول(بايتات_النص) مثل غير_موقع;
            لو ((*العام).قابل_للكتابة && عدد_البايتات != 0) {
                مدعوم := خطأ;
            } وإلا {
                دع حجم_المؤشر: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
                لو (!عرض_مؤشر_عام_مدعوم((*الهدف).نموذج_البيانات.عرض_المؤشر)
                    || التخطيط.الحجم != حجم_المؤشر * 3
                    || التخطيط.المحاذاة != حجم_المؤشر) {
                    مدعوم := خطأ;
                } وإلا {
                    دع ب: متغير غير_موقع = 0;
                    بينما (ب < التخطيط.الحجم) { ألحق(البيانات, 0 مثل غ8); ب := ب + 1; };
                    مدعوم := اكتب_قيمة_عامة_في(&متغير البيانات, حجم_المؤشر,
                        عدد_البايتات, حجم_المؤشر, (*الهدف).نموذج_البيانات.ترتيب_البايت)
                        && اكتب_قيمة_عامة_في(&متغير البيانات, 2 * حجم_المؤشر,
                        عدد_البايتات, حجم_المؤشر, (*الهدف).نموذج_البيانات.ترتيب_البايت);
                    لو (مدعوم && عدد_البايتات != 0) {
                        دع الموضع: غير_موقع = الطول(البيانات) مثل غير_موقع;
                        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.عام((*العام).المعرف);
                        دع الطلب: طلب_إزاحة_بيانات_كائن = {
                            الموضع: 0, الرمز: المرجع, الإضافة: الموضع
                        };
                        ألحق(إزاحات_البيانات, الطلب);
                        دع فهرس_بايت: متغير غير_موقع = 0;
                        بينما (فهرس_بايت < عدد_البايتات) {
                            ألحق(البيانات, بايتات_النص[فهرس_بايت]);
                            فهرس_بايت := فهرس_بايت + 1;
                        }
                    };
                };
            };
        }
        | _ -> { مدعوم := خطأ; };
        // Scalar constants are encoded at the declared width. Aggregate
        // constants already produced their complete layout-sized byte image.
        لو (مدعوم && (الطول(البيانات) مثل غير_موقع) == 0) {
            مدعوم := ألحق_قيمة_عددية_عامة(
                &متغير البيانات, الخام, التخطيط.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت
            );
        };
        لو (!مدعوم) {
            أرجع نتيجة_مادة_عوام_أصلية.أخفقت(
                فشل_مخرج_أصلي.تهيئة_عام_غير_مدعومة((*العام).المعرف)
            );
        };
        دع معرف_العام: معرف_عام_مسير = (*العام).المعرف;
        دع قابل_للكتابة: منطقي = (*العام).قابل_للكتابة;
        دع مادة: بيانات_عام_كائن = {
            المعرف: معرف_العام,
            البيانات: البيانات,
            المحاذاة: محاذاة_البيانات,
            قابل_للكتابة: قابل_للكتابة,
            الإزاحات: إزاحات_البيانات
        };
        ألحق((*المرفقات).البيانات_العامة, مادة);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_مادة_عوام_أصلية.نجحت();
}

// Add linker-owned data names to the same target symbol table as imported
// functions and startup symbols. Each name has exactly one canonical ID.
عرف سجل_أسماء_بيانات_خارجية_أصلية(
    المرفقات: &مرفقات_كائن_مشفرة,
    الرموز_الخارجية: &متغير متجه متجه غ8
): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*المرفقات).البيانات_الخارجية) مثل غير_موقع)) {
        دع الاسم: &متجه غ8 = &(*المرفقات).البيانات_الخارجية[ف].الاسم;
        دع موجود: متغير منطقي = خطأ;
        دع س: متغير غير_موقع = 0;
        بينما (س < (الطول(*الرموز_الخارجية) مثل غير_موقع)) {
            لو (اسما_رمز_خارجي_كائن_متساويان(الاسم, &(*الرموز_الخارجية)[س])) {
                موجود := صواب;
            };
            س := س + 1;
        }
        لو (!موجود) { ألحق(*الرموز_الخارجية, انسخ_اسم_رمز_خارجي_كائن(الاسم)); };
        ف := ف + 1;
    }
}

عرف حل_دخول_أصلي(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير
): نتيجة_حل_دخول_أصلي {
    طابق دالة_بدء_البرنامج مع
    | اختيار.لا_شيء -> { أرجع نتيجة_حل_دخول_أصلي.بلا_دخول(); }
    | اختيار.بعض(المعرف) -> {
        طابق ابحث_دالة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
            دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.دالة_مسير_مفقودة(المفقود);
            أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
        }
        | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
            طابق حل_واجهة_عرض_دالة_مسير_للهدف(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &العرض
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.واجهة_دخول_غير_متاحة(المعرف, الخطأ);
                أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
            }
            | نتيجة.نجح(خطة_الواجهة) -> {
                طابق حل_دخول_تنفيذي_للهدف(الهدف, &خطة_الواجهة) مع
                | نتيجة_حل_دخول_تنفيذي_هدف.غير_متاح(معرف_الهدف) -> {
                    دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.هدف_دخول_غير_متاح(معرف_الهدف);
                    أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
                }
                | نتيجة_حل_دخول_تنفيذي_هدف.متاح(الخطة) -> {
                    طابق الخطة.الأسلوب مع
                    | أسلوب_دخول_تنفيذي_هدف.تصدير_مباشر -> {
                        دع المنتقاة: معرف_دالة_منتقاة = معرف_دالة_منتقاة_من_مسير(المعرف);
                        أرجع نتيجة_حل_دخول_أصلي.تصدير_مباشر(المنتقاة);
                    }
                    | أسلوب_دخول_تنفيذي_هدف.يحتاج_مهايئ -> {
                        دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.مهايئ_دخول_مطلوب(المعرف);
                        أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
                    };
                };
            };
        };
    };
}

// المسار المتدرج يحتفظ فقط بالناتج المشفر والملخصات المطلوبة للكائن عبر الدوال.
// selected/allocated machine IR يبقيان محليين للدالة الحالية فقط.
عرف ابن_مخرج_ذراع_متدرج(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الدوال_المطلوبة: &متجه منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع تصحيح_الآلة: متغير سياق_تصحيح_آلة = هيئ_سياق_تصحيح_آلة();
    دع سياق_الفك: متغير سياق_معلومات_إطار_النداء = سياق_معلومات_إطار_النداء_جديد();
    دع الرموز_الخارجية: متغير متجه متجه غ8 = أسماء_الدوال_الخارجية_مسير(المسير);
    دع الدوال_المشفرة: متغير متجه دالة_ذراع_أربعة_وستون_مشفرة = [];
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
    | اختيار.بعض(المعرف) -> {
        المرفقات.منشئ_الوحدة := اختيار.بعض(معرف_دالة_منتقاة_من_مسير(المعرف));
    }
    | اختيار.لا_شيء -> { };
    طابق مادة_عوام_مسير_للكائن(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير المرفقات) مع
    | نتيجة_مادة_عوام_أصلية.نجحت -> { }
    | نتيجة_مادة_عوام_أصلية.أخفقت(الفشل) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل); };
    سجل_أسماء_بيانات_خارجية_أصلية(&المرفقات, &متغير الرموز_الخارجية);
    دع العدد: غير_موقع = عدد_دوال_مسير(المسير);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (ف < (الطول(*الدوال_المطلوبة) مثل غير_موقع) && (*الدوال_المطلوبة)[ف]) {
        دع المعرف: معرف_دالة_مسير = معرف_دالة_مسير_من(ف);
        طابق هيئ_دالة_منتقاة(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
        | نتيجة_دالة_منتقاة_أصلية.بدائي_مسير_غير_مخفض(البدائي) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي));
        }
        | نتيجة_دالة_منتقاة_أصلية.خطأ(الخطأ) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار(الخطأ));
        }
        | نتيجة_دالة_منتقاة_أصلية.إكس_ستة_وثمانون_أربعة_وستون(_) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_غير_متطابق((*الهدف).المعرف));
        }
        | نتيجة_دالة_منتقاة_أصلية.ذراع_أربعة_وستون(المنتقاة) -> {
            طابق خصص_دالة_ذراع_أربعة_وستون(&المنتقاة, الهدف) مع
            | نتيجة_تخصيص_دالة_ذراع.فشل_قيود(السجل) -> {
                دع خ: فشل_تخصيص_ذراع_أربعة_وستون = فشل_تخصيص_ذراع_أربعة_وستون.فشل_قيود(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_ذراع(خ));
            }
            | نتيجة_تخصيص_دالة_ذراع.حالة_انسكاب_غير_مدعومة(السجل) -> {
                دع خ: فشل_تخصيص_ذراع_أربعة_وستون = فشل_تخصيص_ذراع_أربعة_وستون.حالة_انسكاب_غير_مدعومة(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_ذراع(خ));
            }
            | نتيجة_تخصيص_دالة_ذراع.سياسة_إطار_غير_متاحة(م) -> {
                دع خ: فشل_تخصيص_ذراع_أربعة_وستون = فشل_تخصيص_ذراع_أربعة_وستون.سياسة_إطار_غير_متاحة(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_ذراع(خ));
            }
            | نتيجة_تخصيص_دالة_ذراع.هدف_غير_صالح(م) -> {
                دع خ: فشل_تخصيص_ذراع_أربعة_وستون = فشل_تخصيص_ذراع_أربعة_وستون.هدف_غير_صالح(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_ذراع(خ));
            }
            | نتيجة_تخصيص_دالة_ذراع.نجحت(المخصصة) -> {
                دع قيمة_المخصصة: دالة_ذراع_أربعة_وستون_مخصصة = المخصصة;
                سجل_تعيينات_تصحيح_آلة(
                    &متغير تصحيح_الآلة, &(*التصحيح).العقد, &(*التصحيح).الدلالي,
                    قيمة_المخصصة.الرأس.المعرف, الهدف, &قيمة_المخصصة.التعيينات
                );
                سجل_انسكابات_ذراع_في_تصحيح_آلة(
                    &متغير تصحيح_الآلة, التصحيح, قيمة_المخصصة.الرأس.المعرف, الهدف, &قيمة_المخصصة.إطار_الانسكاب
                );
                طابق شفّر_دالة_ذراع(&قيمة_المخصصة, الهدف, &متغير المرفقات) مع
                | نتيجة_دالة_ترميز_ذراع.خطأ(الخطأ) -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_ذراع(الخطأ));
                }
                | نتيجة_دالة_ترميز_ذراع.نجحت(المشفرة) -> {
                    سجل_سطور_تصحيح_آلة(
                        &متغير تصحيح_الآلة, التصحيح, قيمة_المخصصة.الرأس.المعرف, &المشفرة.أصول_الآلة
                    );
                    سجل_أحداث_معلومات_إطار_النداء(
                        &متغير سياق_الفك, قيمة_المخصصة.الرأس.المعرف, &المشفرة.أحداث_فك_المكدس
                    );
                    ألحق(الدوال_المشفرة, المشفرة);
                };
            };
        };
        };
        ف := ف + 1;
    }
    دع معرف_الهدف_المشفر: معرف_هدف = (*الهدف).المعرف;
    دع الشفرة_الأولية: شفرة_ذراع_أربعة_وستون_مشفرة = {
        الهدف: معرف_الهدف_المشفر,
        الدوال: الدوال_المشفرة,
        المرفقات: المرفقات,
        دخول_عملية_داروين: اختيار.لا_شيء()
    };
    دع الشفرة: متغير شفرة_ذراع_أربعة_وستون_مشفرة = الشفرة_الأولية;
    طابق مزودات_تخزين_كائن_من_مسير(المسير) مع
    | اختيار.بعض(المزودات) -> { اربط_خدمات_تخزين_مرفقات(&متغير الشفرة.المرفقات, &المزودات); }
    | اختيار.لا_شيء -> { };
    أضف_دخول_عملية_داروين_ذراع(&متغير الشفرة, دالة_الدخول, &متغير الرموز_الخارجية);
    دع حقائق_الخلفية_المحلية: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
    دع مرجع_أنواع_الخلفية: &سجل_أنواع = &حقائق_الخلفية_المحلية.الأنواع;
    طابق اصدر_كائن_ذراع_أربعة_وستون(
        الشفرة, الهدف, دالة_الدخول, &الرموز_الخارجية, خريطة_المصادر, الأصول,
        التصحيح, &تصحيح_الآلة, &سياق_الفك, مرجع_أنواع_الخلفية, سجل_التخطيط
    ) مع
    | نتيجة_إصدار_كائن_ذراع.نجح(البايتات) -> { أرجع نتيجة_مخرج_أصلي_مفصل.نجح(البايتات); }
    | نتيجة_إصدار_كائن_ذراع.قدرة_مخرج_غير_متاحة(م) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.قدرة_مخرج_غير_متاحة(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    }
    | نتيجة_إصدار_كائن_ذراع.هدف_غير_متطابق(م) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.هدف_غير_متطابق(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    }
    | نتيجة_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    };
}

عرف ابن_مخرج_إكس_متدرج(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الدوال_المطلوبة: &متجه منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع تصحيح_الآلة: متغير سياق_تصحيح_آلة = هيئ_سياق_تصحيح_آلة();
    دع سياق_الفك: متغير سياق_معلومات_إطار_النداء = سياق_معلومات_إطار_النداء_جديد();
    دع الرموز_الخارجية: متغير متجه متجه غ8 = أسماء_الدوال_الخارجية_مسير(المسير);
    دع البايتات: متغير متجه غ8 = [];
    دع الدوال: متغير متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = [];
    دع الفروع: متغير متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع النداءات: متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع أصول_الآلة: متغير متجه مدى_شفرة_آلة_بأصل = [];
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
    | اختيار.بعض(المعرف) -> {
        المرفقات.منشئ_الوحدة := اختيار.بعض(معرف_دالة_منتقاة_من_مسير(المعرف));
    }
    | اختيار.لا_شيء -> { };
    طابق مادة_عوام_مسير_للكائن(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير المرفقات) مع
    | نتيجة_مادة_عوام_أصلية.نجحت -> { }
    | نتيجة_مادة_عوام_أصلية.أخفقت(الفشل) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل); };
    سجل_أسماء_بيانات_خارجية_أصلية(&المرفقات, &متغير الرموز_الخارجية);
    دع العدد: غير_موقع = عدد_دوال_مسير(المسير);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (ف < (الطول(*الدوال_المطلوبة) مثل غير_موقع) && (*الدوال_المطلوبة)[ف]) {
        دع المعرف: معرف_دالة_مسير = معرف_دالة_مسير_من(ف);
        طابق هيئ_دالة_منتقاة(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
        | نتيجة_دالة_منتقاة_أصلية.بدائي_مسير_غير_مخفض(البدائي) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي));
        }
        | نتيجة_دالة_منتقاة_أصلية.خطأ(الخطأ) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار(الخطأ));
        }
        | نتيجة_دالة_منتقاة_أصلية.ذراع_أربعة_وستون(_) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_غير_متطابق((*الهدف).المعرف));
        }
        | نتيجة_دالة_منتقاة_أصلية.إكس_ستة_وثمانون_أربعة_وستون(المنتقاة) -> {
            طابق خصص_دالة_إكس_ستة_وثمانون_أربعة_وستون(&المنتقاة, الهدف) مع
            | نتيجة_تخصيص_دالة_إكس.فشل_قيود(السجل) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.فشل_قيود(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.حالة_انسكاب_غير_مدعومة(السجل) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.حالة_انسكاب_غير_مدعومة(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.سياسة_إطار_غير_متاحة(م) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.سياسة_إطار_غير_متاحة(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.هدف_غير_صالح(م) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.هدف_غير_صالح(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.نجحت(المخصصة) -> {
                دع قيمة_المخصصة: دالة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = المخصصة;
                دع بداية_أصول_الدالة: غير_موقع = الطول(أصول_الآلة) مثل غير_موقع;
                سجل_تعيينات_تصحيح_آلة(
                    &متغير تصحيح_الآلة, &(*التصحيح).العقد, &(*التصحيح).الدلالي,
                    قيمة_المخصصة.الرأس.المعرف, الهدف, &قيمة_المخصصة.التعيينات
                );
                سجل_انسكابات_إكس_في_تصحيح_آلة(
                    &متغير تصحيح_الآلة, التصحيح, قيمة_المخصصة.الرأس.المعرف, الهدف, &قيمة_المخصصة.إطار_الانسكاب
                );
                طابق شفّر_دالة_إكس_ستة_وثمانون_أربعة_وستون(
                    &قيمة_المخصصة, الهدف, &متغير البايتات, &متغير الدوال, &متغير الفروع, &متغير النداءات,
                    &متغير أصول_الآلة, &متغير المرفقات
                ) مع
                | نتيجة_ترميز_دالة_إكس.خطأ(الخطأ) -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_إكس(الخطأ));
                }
                | نتيجة_ترميز_دالة_إكس.نجحت -> {
                    دع أصول_الدالة: متغير متجه مدى_شفرة_آلة_بأصل = [];
                    دع أصل_ف: متغير غير_موقع = بداية_أصول_الدالة;
                    بينما (أصل_ف < (الطول(أصول_الآلة) مثل غير_موقع)) {
                        ألحق(أصول_الدالة, أصول_الآلة[أصل_ف]);
                        أصل_ف := أصل_ف + 1;
                    }
                    سجل_سطور_تصحيح_آلة(
                        &متغير تصحيح_الآلة, التصحيح, قيمة_المخصصة.الرأس.المعرف, &أصول_الدالة
                    );
                    دع عدد_الدوال_المشفرة: غير_موقع = الطول(الدوال) مثل غير_موقع;
                    لو (عدد_الدوال_المشفرة > 0) {
                        دع موضع_المشفرة: غير_موقع = عدد_الدوال_المشفرة - 1;
                        سجل_أحداث_معلومات_إطار_النداء(
                            &متغير سياق_الفك, قيمة_المخصصة.الرأس.المعرف,
                            &الدوال[موضع_المشفرة].أحداث_فك_المكدس
                        );
                    };
                };
            };
        };
        };
        ف := ف + 1;
    }
    دع بلا_دخول: اختيار دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = اختيار.لا_شيء();
    دع معرف_الهدف_المشفر: معرف_هدف = (*الهدف).المعرف;
    دع الأولية: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
        الهدف: معرف_الهدف_المشفر,
        البيانات: البايتات,
        الدوال: الدوال,
        تثبيتات_الفروع: الفروع,
        إزاحات_النداء: النداءات,
        أصول_الآلة: أصول_الآلة,
        المرفقات: المرفقات,
        دخول_عملية_لينكس: بلا_دخول
    };
    دع الشفرة: متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = الأولية;
    طابق مزودات_تخزين_كائن_من_مسير(المسير) مع
    | اختيار.بعض(المزودات) -> {
        اربط_خدمات_تخزين_مرفقات(&متغير الشفرة.المرفقات, &المزودات);
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول(الشفرة.إزاحات_النداء) مثل غير_موقع)) {
            دع المربوط: مرجع_رمز_كائن = مرجع_مزود_خدمة_تخزين(&الشفرة.إزاحات_النداء[ن].الرمز, &المزودات);
            الشفرة.إزاحات_النداء[ن].الرمز := المربوط;
            ن := ن + 1;
        }
    }
    | اختيار.لا_شيء -> { };
    // Linux process entry is encoded from instructions, not linked from an image.
    دع دالة_الخروج: متغير اختيار معرف_دالة_منتقاة = اختيار.لا_شيء();
    طابق (*المسير).المسير.دالة_خروج_العملية مع
    | اختيار.بعض(المعرف) -> { دالة_الخروج := اختيار.بعض(معرف_دالة_منتقاة_من_مسير(المعرف)); }
    | اختيار.لا_شيء -> { };
    طابق أضف_دخول_عملية_لينكس_إكس_للمشفر(
        &متغير الشفرة, دالة_الدخول, دالة_الخروج, &متغير الرموز_الخارجية
    ) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> {
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_إكس(الخطأ));
    }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق اصدر_كائن_إكس_ستة_وثمانون_أربعة_وستون(
        &الشفرة, الهدف, دالة_الدخول, &الرموز_الخارجية, خريطة_المصادر, الأصول,
        التصحيح, &تصحيح_الآلة, &سياق_الفك, &(*حقائق_الخلفية).الأنواع, سجل_التخطيط
    ) مع
    | نتيجة_إصدار_كائن_إكس.نجح(الناتج) -> { أرجع نتيجة_مخرج_أصلي_مفصل.نجح(الناتج); }
    | نتيجة_إصدار_كائن_إكس.قدرة_مخرج_غير_متاحة(م) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.قدرة_مخرج_غير_متاحة(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    }
    | نتيجة_إصدار_كائن_إكس.هدف_غير_متطابق(م) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.هدف_غير_متطابق(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    }
    | نتيجة_إصدار_كائن_إكس.فشل_إلف(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.خطأ_إلف(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    };
}

// wasm32: each required MSIR function is lowered by the wasm32 selector to a
// final WebAssembly body, and the WebAssembly object writer links them with
// the static data, globals and the host imports into one relocatable module.
// A program entry gets the WASI process start (`_start` calling the entry and
// then the std process-exit provider) when that provider is present;
// otherwise the entry itself is exported as `_start`. A standalone object's
// module initializer runs as a linker init function. No C runtime is used:
// storage comes from the std allocation providers bound in MSIR.
// The std storage providers as object references, when MSIR bound them.
عرف مزودات_تخزين_كائن_من_مسير(المسير: &سياق_مستهلك_مسير): اختيار مزودات_خدمات_تخزين_كائن {
    طابق (*المسير).المسير.مزودات_تخصيص_الذاكرة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(م) -> {
        دع المزودات: مزودات_خدمات_تخزين_كائن = {
            التخصيص: معرف_دالة_منتقاة_من_مسير(م.التخصيص),
            إعادة_التخصيص: معرف_دالة_منتقاة_من_مسير(م.إعادة_التخصيص),
            التحرير: معرف_دالة_منتقاة_من_مسير(م.التحرير)
        };
        أرجع اختيار.بعض(المزودات);
    };
}

عرف ابن_مخرج_ويب_أسمبلي_متدرج(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير,
    الدوال_المطلوبة: &متجه منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    طابق مادة_عوام_مسير_للكائن(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير المرفقات) مع
    | نتيجة_مادة_عوام_أصلية.نجحت -> { }
    | نتيجة_مادة_عوام_أصلية.أخفقت(الفشل) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل); };
    دع المزودات: متغير اختيار مزودات_تخصيص_ذاكرة_مسير = اختيار.لا_شيء();
    طابق (*المسير).المسير.مزودات_تخصيص_الذاكرة مع
    | اختيار.بعض(م) -> { المزودات := اختيار.بعض(م); }
    | اختيار.لا_شيء -> { };
    دع السياق: متغير سياق_وحدة_ويب_أسمبلي = {
        التواقيع: سجل_تواقيع_ويب_أسمبلي_فارغ(),
        مزودات_الذاكرة: المزودات,
        دالة_الدخول: دالة_بدء_البرنامج
    };
    دع الدوال: متغير متجه دالة_ويب_أسمبلي_مشفرة = [];
    دع العدد: غير_موقع = عدد_دوال_مسير(المسير);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (ف < (الطول(*الدوال_المطلوبة) مثل غير_موقع) && (*الدوال_المطلوبة)[ف]) {
            طابق انتق_دالة_ويب_أسمبلي(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير السياق, معرف_دالة_مسير_من(ف)
            ) مع
            | نتيجة.نجح(الدالة) -> { ألحق(الدوال, الدالة); }
            | نتيجة.خطأ(الخطأ) -> {
                طابق الخطأ مع
                | خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي) -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي));
                }
                | _ -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_ويب_أسمبلي(الخطأ));
                };
            };
        };
        ف := ف + 1;
    }
    دع الدخول_المصدر: متغير اختيار معرف_دالة_منتقاة = اختيار.لا_شيء();
    طابق دالة_بدء_البرنامج مع
    | اختيار.بعض(الدخول) -> {
        دع بدء_واسي: منطقي = (*الهدف).مزود_التشغيل == مزود_تشغيل_هدف.واسي();
        طابق (*المسير).المسير.دالة_خروج_العملية مع
        | اختيار.بعض(الخروج) -> {
            لو (بدء_واسي) {
                طابق ابن_بدء_عملية_ويب_أسمبلي(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير السياق, الدخول, الخروج
                ) مع
                | نتيجة.نجح(البدء) -> { ألحق(الدوال, البدء); }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_ويب_أسمبلي(الخطأ));
                };
            } وإلا {
                الدخول_المصدر := اختيار.بعض(معرف_دالة_منتقاة_من_مسير(الدخول));
            };
        }
        | اختيار.لا_شيء -> {
            الدخول_المصدر := اختيار.بعض(معرف_دالة_منتقاة_من_مسير(الدخول));
        };
    }
    | اختيار.لا_شيء -> {
        طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
        | اختيار.بعض(المهيئ) -> { ألحق(الدوال, ابن_منشئ_وحدة_ويب_أسمبلي(&متغير السياق, المهيئ)); }
        | اختيار.لا_شيء -> { };
    };
    // Host imports: every declared external function under the target ABI
    // (no closure environment); the writer keeps the ones referenced.
    دع المستوردة: متغير متجه دالة_مستوردة_ويب_أسمبلي = [];
    دع وحدة_البيئة: متجه غ8 = بايتات_من_نص(«env»);
    ف := 0;
    بينما (ف < (الطول((*المسير).المسير.الدوال_الخارجية) مثل غير_موقع)) {
        دع الخارجية: &دالة_خارجية_مسير = &(*المسير).المسير.الدوال_الخارجية[ف];
        دع الخطة: خطة_دالة_واجهة;
        طابق حل_خطة_واجهة_دالة_خارجية_للهدف(
            &(*حقائق_الخلفية).الأنواع, الهدف, سجل_التخطيط, &(*الخارجية).المعاملات, (*الخارجية).الناتج
        ) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_ويب_أسمبلي(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()));
        }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع التوقيع: توقيع_ويب_أسمبلي;
        طابق توقيع_خطة_ويب_أسمبلي(حقائق_الخلفية, &الخطة, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_ويب_أسمبلي(الخطأ)); }
        | نتيجة.نجح(ت) -> { التوقيع := ت; };
        دع الوحدة: متغير متجه غ8 = وحدة_البيئة;
        دع صريح: متغير منطقي = خطأ;
        طابق وحدة_استيراد_نظام_للهدف(الهدف) مع
        | اختيار.بعض(الاسم) -> {
            دع البايتات: متغير متجه غ8 = [];
            دع ب: متغير غير_موقع = 0;
            بينما (ب < (الطول(الاسم) مثل غير_موقع)) { ألحق(البايتات, الاسم[ب] مثل غ8); ب := ب + 1; }
            الوحدة := البايتات;
            صريح := صواب;
        }
        | اختيار.لا_شيء -> { };
        دع المستوردة_الواحدة: دالة_مستوردة_ويب_أسمبلي = {
            المعرف: معرف_دالة_خارجية_منتقاة_من_مسير((*الخارجية).المعرف),
            الوحدة: الوحدة,
            الاسم: انسخ_اسم_رمز_خارجي_كائن(&(*الخارجية).الاسم),
            التوقيع: ضمن_توقيع_ويب_أسمبلي(&متغير السياق.التواقيع, &التوقيع),
            اسم_صريح: صريح
        };
        ألحق(المستوردة, المستوردة_الواحدة);
        ف := ف + 1;
    }
    دع التواقيع: سجل_تواقيع_ويب_أسمبلي;
    طابق السياق مع
    | { التواقيع: ت, مزودات_الذاكرة: _, دالة_الدخول: _ } -> { التواقيع := ت; };
    دع الوحدة_للكتابة: وحدة_ويب_أسمبلي_للكتابة = {
        التواقيع: التواقيع,
        المستوردة: المستوردة,
        الدوال: الدوال,
        المرفقات: المرفقات,
        الدخول_المصدر: الدخول_المصدر
    };
    طابق اكتب_كائن_ويب_أسمبلي(&الوحدة_للكتابة) مع
    | نتيجة.نجح(البايتات) -> {
        دع الناتج: ناتج_كائن_أصلي_مفصل = { البايتات: البايتات };
        أرجع نتيجة_مخرج_أصلي_مفصل.نجح(الناتج);
    }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ويب_أسمبلي(الخطأ)); };
}

// المدخل المقنن الوحيد للمخرج الأصلي الكامل: يستهلك MSIR متحققا وينتهي عند بايتات الكائن.
عرف ابن_مخرج_أصلي_مفصل(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير,
    مخرج_تنفيذي: منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع و: واصف_هدف = *الهدف;
    دع دالة_الدخول: متغير اختيار معرف_دالة_منتقاة = اختيار.لا_شيء();
    طابق حل_دخول_أصلي(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_بدء_البرنامج) مع
    | نتيجة_حل_دخول_أصلي.بلا_دخول -> { }
    | نتيجة_حل_دخول_أصلي.تصدير_مباشر(الدالة) -> { دالة_الدخول := اختيار.بعض(الدالة); }
    | نتيجة_حل_دخول_أصلي.أخفق(فشل_الدخول) -> {
        دع الفشل: فشل_مخرج_أصلي = فشل_مخرج_أصلي.دخول_تنفيذي(فشل_الدخول);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل);
    };

    دع الدوال_المطلوبة: متجه منطقي = دوال_مسير_مطلوبة_لمخرج(
        المسير, مخرج_تنفيذي, دالة_بدء_البرنامج
    );

    طابق حل_قدرة_مخرج_أصلي(الهدف) مع
    | قدرة_مخرج_أصلي.غير_متاحة -> {
        دع الفشل: فشل_مخرج_أصلي = فشل_مخرج_أصلي.قدرة_مخرج_غير_متاحة(و.المعرف);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل);
    }
    | قدرة_مخرج_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع ابن_مخرج_ذراع_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    }
    | قدرة_مخرج_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع ابن_مخرج_إكس_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    }
    | قدرة_مخرج_أصلي.ويب_أسمبلي_اثنان_وثلاثون_وحدة -> {
        أرجع ابن_مخرج_ويب_أسمبلي_متدرج(
            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_بدء_البرنامج, &الدوال_المطلوبة
        );
    };
}

// Executable orchestration asks the native provider for a relocatable object only.
// Linking is owned by compiler/link and is shared with the LLVM provider.
عام عرف ابن_كائن_أصلي_للربط(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير,
    مخرج_تنفيذي: منطقي
): نتيجة_مخرج_أصلي_مفصل {
    أرجع ابن_مخرج_أصلي_مفصل(
        المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف,
        سجل_التخطيط, دالة_بدء_البرنامج, مخرج_تنفيذي
    );
}

// Public object output discards the in-memory DWARF rebase metadata only after
// the canonical object bytes have been produced. Executable output keeps it.
عام عرف ابن_مخرج_أصلي(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير
): نتيجة_مخرج_أصلي {
    طابق ابن_مخرج_أصلي_مفصل(
        المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط,
        دالة_بدء_البرنامج, خطأ
    ) مع
    | نتيجة_مخرج_أصلي_مفصل.نجح(الناتج) -> {
        دع مرجع_البايتات: &متجه غ8 = &الناتج.البايتات;
        دع البايتات: متجه غ8 = *مرجع_البايتات;
        أرجع نتيجة_مخرج_أصلي.نجح(البايتات);
    }
    | نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل) -> { أرجع نتيجة_مخرج_أصلي.أخفق(الفشل); };
}
