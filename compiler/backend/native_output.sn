            };
        };
        };
        ف := ف + 1;
    }
    دع معرف_الهدف_المشفر: معرف_هدف = (*الهدف).المعرف;
    دع الشفرة_الأولية: شفرة_ذراع_أربعة_وستون_مشفرة = {
        الهدف: معرف_الهدف_المشفر,
        الدوال: الدوال_المشفرة,
        المرفقات: المرفقات,
        دخول_عملية_داروين: اختياري.لا_شيء(),
        دخول_عملية_لينكس: اختياري.لا_شيء()
    };
    دع الشفرة: متغير شفرة_ذراع_أربعة_وستون_مشفرة = الشفرة_الأولية;
    طابق مزودات_تخزين_كائن_من_مسير(المسير) مع
    | اختياري.موجود(المزودات) -> { اربط_خدمات_تخزين_مرفقات(&متغير الشفرة.المرفقات, &المزودات); }
    | اختياري.لا_شيء -> { };
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_لينكس_إلف -> {
        // Linux process entry: _start is encoded here, not linked from a C runtime.
        دع دالة_الخروج: متغير اختياري معرف_دالة_منتقاة = اختياري.لا_شيء();
        طابق (*المسير).المسير.دالة_خروج_العملية مع
        | اختياري.موجود(المعرف) -> { دالة_الخروج := اختياري.موجود(معرف_دالة_منتقاة_من_مسير(المعرف)); }
        | اختياري.لا_شيء -> { };
        // FreeBSD shares the composition; its `_start` finds the argument
        // block through x0 instead of SP.
        دع خطأ_الدخول: اختياري خطأ_ترميز_ذراع_أربعة_وستون;
        إذا (هدف_نواة_فري_بي_إس_دي_مباشر(الهدف)) {
            خطأ_الدخول := أضف_دخول_عملية_فري_بي_إس_دي_ذراع(
                &متغير الشفرة, دالة_الدخول, دالة_الخروج, &متغير الرموز_الخارجية
            );
        } وإلا {
            خطأ_الدخول := أضف_دخول_عملية_لينكس_ذراع(
                &متغير الشفرة, دالة_الدخول, دالة_الخروج, &متغير الرموز_الخارجية
            );
        };
        طابق خطأ_الدخول مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_ذراع(الخطأ)); }
        | اختياري.لا_شيء -> { };
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_ويندوز_كوف -> {
        // The PE entry `_start`, encoded here; the closure C entry is the
        // arm64 instruction (its C caller passes the environment in x0).
        طابق دالة_الدخول مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الدخول) -> {
            طابق (*المسير).المسير.دالة_خروج_العملية مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_ذراع(
                    خطأ_ترميز_ذراع_أربعة_وستون.مزود_خروج_عملية_مفقود()
                ));
            }
            | اختياري.موجود(المعرف) -> {
                الشفرة.دخول_عملية_لينكس := اختياري.موجود(دخول_عملية_ويندوز_ذراع(
                    الدخول, معرف_دالة_منتقاة_من_مسير(المعرف), الشفرة.المرفقات.منشئ_الوحدة
                ));
            };
        };
    }
    | _ -> { أضف_دخول_عملية_داروين_ذراع(&متغير الشفرة, دالة_الدخول, &متغير الرموز_الخارجية); };
    دع حقائق_الخلفية_المحلية: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
    دع مرجع_أنواع_الخلفية: &سجل_أنواع = &حقائق_الخلفية_المحلية.الأنواع;
    طابق اصدر_كائن_ذراع_أربعة_وستون(
        الشفرة, الهدف, دالة_الدخول, &الرموز_الخارجية, خريطة_المصادر, الأصول,
        التصحيح, &تصحيح_الآلة, &سياق_الفك, مرجع_أنواع_الخلفية, سجل_التخطيط
    ) مع
    | نتيجة_إصدار_كائن_ذراع.نجح(البايتات) -> { أرجع نتيجة_مخرج_أصلي_مفصل.نجح(البايتات); }
    | نتيجة_إصدار_كائن_ذراع.قدرة_مخرج_غير_متاحة(م) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.قدرة_مخرج_غير_متاحة(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    }
    | نتيجة_إصدار_كائن_ذراع.هدف_غير_متطابق(م) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.هدف_غير_متطابق(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    }
    | نتيجة_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    }
    | نتيجة_إصدار_كائن_ذراع.فشل_إلف(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.خطأ_إلف(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    }
    | نتيجة_إصدار_كائن_ذراع.فشل_كوف(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.خطأ_كوف(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    };
}

عرف انسخ_عناوين_إطار_تصحيح(القيمة: &متجه طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) { ألحق(الناتج, (*القيمة)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

// Machine facts of one encoded function for its source-variable locations
// (codegen/debug/value_ranges.sn), from the allocation and the encoding.
عرف سجل_مديات_قيم_أصلية_في_تصحيح_آلة(
    تصحيح_الآلة: &متغير سياق_تصحيح_آلة,
    التصحيح: &بيانات_تصحيح_مسير,
    المعرف: معرف_دالة_منتقاة,
    بدايات_الكتل: &متجه طبيعي,
    بدايات_المنتقاة: &متجه متجه طبيعي,
    مواضع_التعليمات: &متجه متجه طبيعي,
    مقاطع_الحياة: &متجه متجه طبيعي,
    التعيينات: &متجه تعيين_سجل,
    المسكوبة: &متجه طبيعي,
    إزاحات_المسكوبة: &متجه طبيعي,
    قيم_المواضع: متجه طبيعي,
    إزاحات_المواضع: متجه طبيعي,
    عناوين_الإطار: &متجه طبيعي,
    إزاحة_الإطار: طبيعي,
    حجم_الدالة: طبيعي,
    الهدف: &واصف_هدف,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): فراغ {
    دع بدايات_المواضع: متغير متجه طبيعي = [];
    دع نهايات_المواضع: متغير متجه طبيعي = [];
    مواضع_بايتات_من_كتل_تصحيح(
        بدايات_الكتل, بدايات_المنتقاة, مواضع_التعليمات,
        &متغير بدايات_المواضع, &متغير نهايات_المواضع
    );
    دع التخزين: متغير متجه تخزين_قيمة_آلة_تصحيح = [];
    دع المقاطع: متغير متجه متجه طبيعي = [];
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول(*مقاطع_الحياة) مثل طبيعي)) {
        ألحق(التخزين, تخزين_قيمة_آلة_تصحيح.بلا());
        دع المقطع: متغير متجه طبيعي = [];
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول((*مقاطع_الحياة)[ع]) مثل طبيعي)) { ألحق(المقطع, (*مقاطع_الحياة)[ع][ن]); ن := ن + 1; }
        ألحق(المقاطع, المقطع);
        ع := ع + 1;
    }
    ع := 0;
    طالما (ع < (الطول(*التعيينات) مثل طبيعي)) {
        دع الافتراضي: طبيعي = (*التعيينات)[ع].الافتراضي.القيمة;
        إذا (الافتراضي < (الطول(التخزين) مثل طبيعي)) {
            طابق رقم_سجل_دوارف_للهدف(الهدف, (*التعيينات)[ع].الفعلي) مع
            | اختياري.موجود(الرقم) -> { التخزين[الافتراضي] := تخزين_قيمة_آلة_تصحيح.سجل(الرقم); }
            | اختياري.لا_شيء -> { };
        };
        ع := ع + 1;
    }
    // Spill storage supersedes the register assignment for this value.
    ع := 0;
    طالما (ع < (الطول(*المسكوبة) مثل طبيعي) && ع < (الطول(*إزاحات_المسكوبة) مثل طبيعي)) {
        دع الافتراضي: طبيعي = (*المسكوبة)[ع];
        إذا (الافتراضي < (الطول(التخزين) مثل طبيعي)) {
            التخزين[الافتراضي] := تخزين_قيمة_آلة_تصحيح.مكدس((*إزاحات_المسكوبة)[ع]);
        };
        ع := ع + 1;
    }
    دع الحقائق: حقائق_قيم_دالة_آلة_تصحيح = {
        بدايات_المواضع: بدايات_المواضع, نهايات_المواضع: نهايات_المواضع,
        مقاطع_الحياة: المقاطع, التخزين: التخزين,
        قيم_المواضع_المحلية: قيم_المواضع, إزاحات_المواضع_المحلية: إزاحات_المواضع,
        عناوين_الإطار: انسخ_عناوين_إطار_تصحيح(عناوين_الإطار), إزاحة_الإطار: إزاحة_الإطار,
        نهاية_الدالة: حجم_الدالة
    };
    سجل_مديات_قيم_تصحيح_آلة(
        تصحيح_الآلة, التصحيح, المعرف, &الحقائق, الأنواع, الهدف, سجل_التخطيط
    );
}

عرف سجل_مديات_قيم_إكس_في_تصحيح_آلة(
    تصحيح_الآلة: &متغير سياق_تصحيح_آلة,
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    مواضع_التعليمات: &متجه متجه طبيعي,
    حجم_الدالة: طبيعي,
    الهدف: &واصف_هدف,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): فراغ {
    دع بدايات_المنتقاة: متغير متجه متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع البدايات: متغير متجه طبيعي = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].بدايات_المنتقاة) مثل طبيعي)) {
            ألحق(البدايات, (*الدالة).الكتل[ك].بدايات_المنتقاة[ف]);
            ف := ف + 1;
        }
        ألحق(بدايات_المنتقاة, البدايات);
        ك := ك + 1;
    }
    دع المسكوبة: متغير متجه طبيعي = [];
    دع إزاحات_المسكوبة: متغير متجه طبيعي = [];
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الدالة).إطار_الانسكاب.المواقع) مثل طبيعي)) {
        ألحق(المسكوبة, (*الدالة).إطار_الانسكاب.المواقع[ع].السجل.القيمة);
        ألحق(إزاحات_المسكوبة, (*الدالة).إطار_الانسكاب.المواقع[ع].إزاحة_بايت);
        ع := ع + 1;
    }
    دع قيم_المواضع: متغير متجه طبيعي = [];
    دع إزاحات_المواضع: متغير متجه طبيعي = [];
    ع := 0;
    طالما (ع < (الطول((*الدالة).إطار_الانسكاب.المواضع_المحلية) مثل طبيعي)) {
        ألحق(قيم_المواضع, (*الدالة).إطار_الانسكاب.المواضع_المحلية[ع].المعرف);
        ألحق(إزاحات_المواضع, (*الدالة).إطار_الانسكاب.المواضع_المحلية[ع].إزاحة_بايت);
        ع := ع + 1;
    }
    سجل_مديات_قيم_أصلية_في_تصحيح_آلة(
        تصحيح_الآلة, التصحيح, (*الدالة).الرأس.المعرف, &(*الدالة).بدايات_الكتل, &بدايات_المنتقاة,
        مواضع_التعليمات, &(*الدالة).مقاطع_الحياة, &(*الدالة).التعيينات, &المسكوبة, &إزاحات_المسكوبة,
        قيم_المواضع, إزاحات_المواضع, &(*الدالة).عناوين_الإطار,
        // The CFA is above the frame and the return address.
        (*الدالة).إطار_الانسكاب.الحجم_بايت + 8,
        حجم_الدالة, الهدف, الأنواع, سجل_التخطيط
    );
}

عرف سجل_مديات_قيم_ذراع_في_تصحيح_آلة(
    تصحيح_الآلة: &متغير سياق_تصحيح_آلة,
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: &دالة_ذراع_أربعة_وستون_مخصصة,
    مواضع_التعليمات: &متجه متجه طبيعي,
    حجم_الدالة: طبيعي,
    الهدف: &واصف_هدف,
    الأنواع: &سجل_أنواع,
    سجل_التخطيط: &متغير سجل_تخطيط
): فراغ {
    دع بدايات_المنتقاة: متغير متجه متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع البدايات: متغير متجه طبيعي = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].بدايات_المنتقاة) مثل طبيعي)) {
            ألحق(البدايات, (*الدالة).الكتل[ك].بدايات_المنتقاة[ف]);
            ف := ف + 1;
        }
        ألحق(بدايات_المنتقاة, البدايات);
        ك := ك + 1;
    }
    دع المسكوبة: متغير متجه طبيعي = [];
    دع إزاحات_المسكوبة: متغير متجه طبيعي = [];
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الدالة).إطار_الانسكاب.المواقع) مثل طبيعي)) {
        ألحق(المسكوبة, (*الدالة).إطار_الانسكاب.المواقع[ع].السجل.القيمة);
        ألحق(إزاحات_المسكوبة, (*الدالة).إطار_الانسكاب.المواقع[ع].إزاحة_بايت);
        ع := ع + 1;
    }
    دع قيم_المواضع: متغير متجه طبيعي = [];
    دع إزاحات_المواضع: متغير متجه طبيعي = [];
    ع := 0;
    طالما (ع < (الطول((*الدالة).إطار_الانسكاب.المحليات) مثل طبيعي)) {
        ألحق(قيم_المواضع, (*الدالة).إطار_الانسكاب.المحليات[ع].الهوية);
        ألحق(إزاحات_المواضع, (*الدالة).إطار_الانسكاب.المحليات[ع].إزاحة_بايت);
        ع := ع + 1;
    }
    سجل_مديات_قيم_أصلية_في_تصحيح_آلة(
        تصحيح_الآلة, التصحيح, (*الدالة).الرأس.المعرف, &(*الدالة).بدايات_الكتل, &بدايات_المنتقاة,
        مواضع_التعليمات, &(*الدالة).مقاطع_الحياة, &(*الدالة).التعيينات, &المسكوبة, &إزاحات_المسكوبة,
        قيم_المواضع, إزاحات_المواضع, &(*الدالة).عناوين_الإطار,
        // The CFA is the stack pointer before the frame was allocated.
        (*الدالة).إطار_الانسكاب.الحجم_بايت,
        حجم_الدالة, الهدف, الأنواع, سجل_التخطيط
    );
}

عرف ابن_مخرج_إكس_متدرج(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    الدوال_المطلوبة: &متجه منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع تصحيح_الآلة: متغير سياق_تصحيح_آلة = هيئ_سياق_تصحيح_آلة();
    دع سياق_الفك: متغير سياق_معلومات_إطار_النداء = سياق_معلومات_إطار_النداء_جديد();
    دع الرموز_الخارجية: متغير متجه متجه ط8 = أسماء_الدوال_الخارجية_مسير(المسير);
    دع البايتات: متغير متجه ط8 = [];
    دع الدوال: متغير متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = [];
    دع الفروع: متغير متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع النداءات: متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع أصول_الآلة: متغير متجه مدى_شفرة_آلة_بأصل = [];
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
    | اختياري.موجود(المعرف) -> {
        المرفقات.منشئ_الوحدة := اختياري.موجود(معرف_دالة_منتقاة_من_مسير(المعرف));
    }
    | اختياري.لا_شيء -> { };
    طابق مادة_عوام_مسير_للكائن(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير المرفقات) مع
    | نتيجة_مادة_عوام_أصلية.نجحت -> { }
    | نتيجة_مادة_عوام_أصلية.أخفقت(الفشل) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل); };
    سجل_أسماء_بيانات_خارجية_أصلية(&المرفقات, &متغير الرموز_الخارجية);
    دع العدد: طبيعي = عدد_دوال_مسير(المسير);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع مطلوبة_هنا: منطقي = ف < (الطول(*الدوال_المطلوبة) مثل طبيعي) && (*الدوال_المطلوبة)[ف];
        دع تبديل_سياق_هنا: منطقي = مطلوبة_هنا && هي_دالة_تبديل_سياق_مسير(المسير, معرف_دالة_مسير_من(ف));
        إذا (تبديل_سياق_هنا) {
            دع بداية_الروتين: طبيعي = الطول(البايتات) مثل طبيعي;
            دع بايتات_الروتين: متجه ط8 = بايتات_تبديل_سياق_المهام_إكس();
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول(بايتات_الروتين) مثل طبيعي)) {
                ألحق(البايتات, بايتات_الروتين[ك]);
                ك := ك + 1;
            }
            دع بلا_أحداث: متجه حدث_فك_المكدس = [];
            دع الموضع: موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
                الدالة: معرف_دالة_منتقاة_من_مسير(معرف_دالة_مسير_من(ف)),
                إزاحة_بايت: بداية_الروتين,
                حجم_بايت: الطول(بايتات_الروتين) مثل طبيعي,
                أحداث_فك_المكدس: بلا_أحداث
            };
            ألحق(الدوال, الموضع);
        };
        إذا (مطلوبة_هنا && !تبديل_سياق_هنا) {
        دع المعرف: معرف_دالة_مسير = معرف_دالة_مسير_من(ف);
        طابق هيئ_دالة_منتقاة(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
        | نتيجة_دالة_منتقاة_أصلية.بدائي_مسير_غير_مخفض(البدائي) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي));
        }
        | نتيجة_دالة_منتقاة_أصلية.خطأ(الخطأ) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار(الخطأ));
        }
        | نتيجة_دالة_منتقاة_أصلية.ذراع_أربعة_وستون(_) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_غير_متطابق((*الهدف).المعرف));
        }
        | نتيجة_دالة_منتقاة_أصلية.إكس_ستة_وثمانون_أربعة_وستون(المنتقاة_الأصلية) -> {
            دع المنتقاة: متغير دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = المنتقاة_الأصلية;
            بسط_دالة_إكس_منتقاة(&متغير المنتقاة, الهدف);
            طابق خصص_دالة_إكس_ستة_وثمانون_أربعة_وستون(&المنتقاة, الهدف) مع
            | نتيجة_تخصيص_دالة_إكس.فشل_قيود(السجل) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.فشل_قيود(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.حالة_انسكاب_غير_مدعومة(السجل) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.حالة_انسكاب_غير_مدعومة(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.سياسة_إطار_غير_متاحة(م) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.سياسة_إطار_غير_متاحة(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.هدف_غير_صالح(م) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.هدف_غير_صالح(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.نجحت(المخصصة) -> {
                // Borrow the completed allocation until machine encoding finishes;
                // do not materialize another whole allocated-function value.
                دع قيمة_المخصصة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &المخصصة;
                دع بداية_أصول_الدالة: طبيعي = الطول(أصول_الآلة) مثل طبيعي;
                سجل_إطار_تصحيح_آلة(
                    &متغير تصحيح_الآلة, &(*التصحيح).العقد, (*قيمة_المخصصة).الرأس.المعرف,
                    (*قيمة_المخصصة).إطار_الانسكاب.الحجم_بايت
                );
                دع مواضع_التعليمات: متغير متجه متجه طبيعي = [];
                طابق شفّر_دالة_إكس_ستة_وثمانون_أربعة_وستون(
                    قيمة_المخصصة, الهدف, &متغير البايتات, &متغير الدوال, &متغير الفروع, &متغير النداءات,
                    &متغير أصول_الآلة, &متغير المرفقات, &متغير مواضع_التعليمات
                ) مع
                | نتيجة_ترميز_دالة_إكس.خطأ(الخطأ) -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_إكس(الخطأ));
                }
                | نتيجة_ترميز_دالة_إكس.نجحت -> {
                    سجل_سطور_تصحيح_آلة_من_مدى(
                        &متغير تصحيح_الآلة, التصحيح, (*قيمة_المخصصة).الرأس.المعرف,
                        &أصول_الآلة, بداية_أصول_الدالة, الطول(أصول_الآلة) مثل طبيعي
                    );
                    دع حجم_المشفرة: متغير طبيعي = 0;
                    إذا ((الطول(الدوال) مثل طبيعي) > 0) { حجم_المشفرة := الدوال[(الطول(الدوال) مثل طبيعي) - 1].حجم_بايت; };
                    سجل_مديات_قيم_إكس_في_تصحيح_آلة(
                        &متغير تصحيح_الآلة, التصحيح, قيمة_المخصصة, &مواضع_التعليمات, حجم_المشفرة,
                        الهدف, &(*حقائق_الخلفية).الأنواع, سجل_التخطيط
                    );
                    // ELF's DWARF writer consumes the derived machine debug
                    // ranges, not these per-instruction encoded origins. Clear
                    // after each function, before encoding the next function.
                    دع أصول_فارغة: متجه مدى_شفرة_آلة_بأصل = [];
                    أصول_الآلة := أصول_فارغة;
                    دع عدد_الدوال_المشفرة: طبيعي = الطول(الدوال) مثل طبيعي;
                    إذا (عدد_الدوال_المشفرة > 0) {
                        دع موضع_المشفرة: طبيعي = عدد_الدوال_المشفرة - 1;
                        سجل_أحداث_معلومات_إطار_النداء(
                            &متغير سياق_الفك, (*قيمة_المخصصة).الرأس.المعرف,
                            &الدوال[موضع_المشفرة].أحداث_فك_المكدس
                        );
                    };
                };
            };
        };
        };
        ف := ف + 1;
    }
    دع بلا_دخول: اختياري دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
    دع معرف_الهدف_المشفر: معرف_هدف = (*الهدف).المعرف;
    دع الأولية: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
        الهدف: معرف_الهدف_المشفر,
        البيانات: البايتات,
        الدوال: الدوال,
        تثبيتات_الفروع: الفروع,
        إزاحات_النداء: النداءات,
        أصول_الآلة: أصول_الآلة,
        المرفقات: المرفقات,
        دخول_عملية_لينكس: بلا_دخول
    };
    دع الشفرة: متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = الأولية;
    طابق مزودات_تخزين_كائن_من_مسير(المسير) مع
    | اختياري.موجود(المزودات) -> {
        اربط_خدمات_تخزين_مرفقات(&متغير الشفرة.المرفقات, &المزودات);
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول(الشفرة.إزاحات_النداء) مثل طبيعي)) {
            دع المربوط: مرجع_رمز_كائن = مرجع_مزود_خدمة_تخزين(&الشفرة.إزاحات_النداء[ن].الرمز, &المزودات);
            الشفرة.إزاحات_النداء[ن].الرمز := المربوط;
            ن := ن + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    // Linux process entry is encoded from instructions, not linked from an image.
    دع دالة_الخروج: متغير اختياري معرف_دالة_منتقاة = اختياري.لا_شيء();
    طابق (*المسير).المسير.دالة_خروج_العملية مع
    | اختياري.موجود(المعرف) -> { دالة_الخروج := اختياري.موجود(معرف_دالة_منتقاة_من_مسير(المعرف)); }
    | اختياري.لا_شيء -> { };
    إذا (تركيب_الهدف_الأصلي(الهدف) == هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف()) {
        أرجع اصدر_كائن_ويندوز_إكس(المسير, &متغير الشفرة, الهدف, دالة_الدخول, دالة_الخروج, &الرموز_الخارجية);
    };
    إذا (تركيب_الهدف_الأصلي(الهدف) == هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_داروين_ماتشو()) {
        أرجع اصدر_كائن_داروين_إكس(المسير, &متغير الشفرة, الهدف, دالة_الدخول, &متغير الرموز_الخارجية);
    };
    // FreeBSD shares the Linux ELF composition: its `_start` finds the
    // argument block through RDI, and its threads start at the System V C
    // entry of a closure (thr_new's start_func).
    دع نتيجة_الدخول: نتيجة_دفعة_ترميز_إكس;
    إذا (هدف_نواة_فري_بي_إس_دي_مباشر(الهدف)) {
        نتيجة_الدخول := أضف_دخول_عملية_فري_بي_إس_دي_إكس_للمشفر(
            &متغير الشفرة, دالة_الدخول, دالة_الخروج, &متغير الرموز_الخارجية
        );
        أضف_مدخل_سي_داروين_إكس(&متغير الشفرة, معرف_مدخل_سي_ويندوز_إكس(المسير));
    } وإلا {
        نتيجة_الدخول := أضف_دخول_عملية_لينكس_إكس_للمشفر(
            &متغير الشفرة, دالة_الدخول, دالة_الخروج, &متغير الرموز_الخارجية
        );
    };
    طابق نتيجة_الدخول مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> {
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_إكس(الخطأ));
    }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق اصدر_كائن_إكس_ستة_وثمانون_أربعة_وستون(
        &الشفرة, الهدف, دالة_الدخول, &الرموز_الخارجية, خريطة_المصادر, الأصول,
        التصحيح, &تصحيح_الآلة, &سياق_الفك, &(*حقائق_الخلفية).الأنواع, سجل_التخطيط
    ) مع
    | نتيجة_إصدار_كائن_إكس.نجح(الناتج) -> { أرجع نتيجة_مخرج_أصلي_مفصل.نجح(الناتج); }
    | نتيجة_إصدار_كائن_إكس.قدرة_مخرج_غير_متاحة(م) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.قدرة_مخرج_غير_متاحة(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    }
    | نتيجة_إصدار_كائن_إكس.هدف_غير_متطابق(م) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.هدف_غير_متطابق(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    }
    | نتيجة_إصدار_كائن_إكس.فشل_إلف(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.خطأ_إلف(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    };
}

// Native x86-64 macOS: dyld's `_main` and the closure C entry are appended
// to the encoded program, which the x86-64 Mach-O writer serializes. dyld
// runs the module initializer from __mod_init_func before `_main`.
عرف اصدر_كائن_داروين_إكس(
    المسير: &سياق_مستهلك_مسير,
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متغير متجه متجه ط8
): نتيجة_مخرج_أصلي_مفصل {
    دع الدخول_الرئيسي: متغير اختياري دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
    طابق دالة_الدخول مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        الدخول_الرئيسي := اختياري.موجود(أضف_دخول_عملية_داروين_إكس(الشفرة, الدخول, الرموز_الخارجية));
    };
    أضف_مدخل_سي_داروين_إكس(الشفرة, معرف_مدخل_سي_ويندوز_إكس(المسير));
    طابق اكتب_كائن_ماتشو_إكس_ستة_وثمانون_أربعة_وستون(الشفرة, الهدف, الدخول_الرئيسي, الرموز_الخارجية) مع
    | نتيجة_ماتشو_إكس.خطأ(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.خطأ_ماتشو(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    }
    | نتيجة_ماتشو_إكس.نجح(البايتات) -> {
        دع الناتج: ناتج_كائن_أصلي_مفصل = { البايتات: البايتات };
        أرجع نتيجة_مخرج_أصلي_مفصل.نجح(الناتج);
    };
}

// Native x86-64 Windows: the PE entry `_start` and the closure C entry are
// appended to the encoded program, which the COFF writer serializes.
عرف اصدر_كائن_ويندوز_إكس(
    المسير: &سياق_مستهلك_مسير,
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    دالة_الخروج: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متجه متجه ط8
): نتيجة_مخرج_أصلي_مفصل {
    دع دخول_ويندوز: متغير اختياري دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
    طابق دالة_الدخول مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الدخول) -> {
        طابق دالة_الخروج مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_إكس(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.مزود_خروج_عملية_مفقود()
            ));
        }
        | اختياري.موجود(الخروج) -> {
            دخول_ويندوز := اختياري.موجود(أضف_دخول_عملية_ويندوز_إكس(
                الشفرة, الدخول, الخروج, (*الشفرة).المرفقات.منشئ_الوحدة
            ));
        };
    };
    أضف_مدخل_سي_ويندوز_إكس(الشفرة, معرف_مدخل_سي_ويندوز_إكس(المسير));
    طابق اكتب_كائن_كوف_إكس_ستة_وثمانون_أربعة_وستون(الشفرة, الهدف, دخول_ويندوز, الرموز_الخارجية) مع
    | نتيجة_كوف.خطأ(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.خطأ_كوف(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    }
    | نتيجة_كوف.نجح(البايتات) -> {
        دع الناتج: ناتج_كائن_أصلي_مفصل = { البايتات: البايتات };
        أرجع نتيجة_مخرج_أصلي_مفصل.نجح(الناتج);
    };
}

// wasm32: each required MSIR function is lowered by the wasm32 selector to a
// final WebAssembly body, and the WebAssembly object writer links them with
// the static data, globals and the host imports into one relocatable module.
// A program entry gets the WASI process start (`_start` calling the entry and
// then the std process-exit provider) when that provider is present;
// otherwise the entry itself is exported as `_start`. A standalone object's
// module initializer runs as a linker init function. No C runtime is used:
// storage comes from the std allocation providers bound in MSIR. The
// selector records each instruction's source origin; those ranges become the
// machine debug context's line ranges and the writer emits DWARF from them,
// as for the ELF and Mach-O paths.
// The std storage providers as object references, when MSIR bound them.
عرف مزودات_تخزين_كائن_من_مسير(المسير: &سياق_مستهلك_مسير): اختياري مزودات_خدمات_تخزين_كائن {
    طابق (*المسير).المسير.مزودات_تخصيص_الذاكرة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(م) -> {
        دع المزودات: مزودات_خدمات_تخزين_كائن = {
            التخصيص: معرف_دالة_منتقاة_من_مسير(م.التخصيص),
            إعادة_التخصيص: معرف_دالة_منتقاة_من_مسير(م.إعادة_التخصيص),
            التحرير: معرف_دالة_منتقاة_من_مسير(م.التحرير)
        };
        أرجع اختياري.موجود(المزودات);
    };
}

عرف ابن_مخرج_ويب_أسمبلي_متدرج(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج_المطلوبة: اختياري معرف_دالة_مسير,
    الدوال_المطلوبة: &متجه منطقي,
    موضع_مستقل: منطقي
): نتيجة_مخرج_أصلي_مفصل {
    // A shared module (position-independent code) has no process entry:
    // its functions are exports and the loader runs its initializers.
    دع دالة_بدء_البرنامج: متغير اختياري معرف_دالة_مسير = دالة_بدء_البرنامج_المطلوبة;
    إذا (موضع_مستقل) { دالة_بدء_البرنامج := اختياري.لا_شيء(); };
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    طابق مادة_عوام_مسير_للكائن(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير المرفقات) مع
    | نتيجة_مادة_عوام_أصلية.نجحت -> { }
    | نتيجة_مادة_عوام_أصلية.أخفقت(الفشل) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل); };
    دع المزودات: متغير اختياري مزودات_تخصيص_ذاكرة_مسير = اختياري.لا_شيء();
    طابق (*المسير).المسير.مزودات_تخصيص_الذاكرة مع
    | اختياري.موجود(م) -> { المزودات := اختياري.موجود(م); }
    | اختياري.لا_شيء -> { };
    دع السياق: متغير سياق_وحدة_ويب_أسمبلي = {
        التواقيع: سجل_تواقيع_ويب_أسمبلي_فارغ(),
        مزودات_الذاكرة: المزودات,
        دالة_الدخول: دالة_بدء_البرنامج,
        موضع_مستقل: موضع_مستقل
    };
    دع الدوال: متغير متجه دالة_ويب_أسمبلي_مشفرة = [];
    دع تصحيح_الآلة: متغير سياق_تصحيح_آلة = هيئ_سياق_تصحيح_آلة();
    دع العدد: طبيعي = عدد_دوال_مسير(المسير);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (ف < (الطول(*الدوال_المطلوبة) مثل طبيعي) && (*الدوال_المطلوبة)[ف]) {
            طابق انتق_دالة_ويب_أسمبلي(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير السياق, معرف_دالة_مسير_من(ف)
            ) مع
            | نتيجة.نجح(الدالة) -> {
                // Source lines of the body (function-relative byte ranges);
                // the object writer places them in the CODE address space.
                دع المنتقاة: معرف_دالة_منتقاة = معرف_دالة_منتقاة_من_مسير(معرف_دالة_مسير_من(ف));
                سجل_إطار_تصحيح_آلة(&متغير تصحيح_الآلة, &(*التصحيح).العقد, المنتقاة, 0);
                // Source variables live where the selector put their MSIR
                // values: one wasm local per value for the whole body.
                دع ق: متغير طبيعي = 0;
                طالما (ق < (الطول(الدالة.مواقع_القيم) مثل طبيعي)) {
                    دع موقع_القيمة: موقع_قيمة_مشفرة_ويب_أسمبلي = الدالة.مواقع_القيم[ق];
                    دع السجل: معرف_سجل_افتراضي = { القيمة: موقع_القيمة.القيمة };
                    سجل_تعيين_موقع_افتراضي_تصحيح_آلة(
                        &متغير تصحيح_الآلة, التصحيح, المنتقاة, السجل,
                        موقع_آلة_تصحيح.محلي_ويب_أسمبلي(موقع_القيمة.المحلي, موقع_القيمة.عنوان)
                    );
                    ق := ق + 1;
                }
                سجل_سطور_تصحيح_آلة(&متغير تصحيح_الآلة, التصحيح, المنتقاة, &الدالة.الأصول);
                ألحق(الدوال, الدالة);
            }
            | نتيجة.خطأ(الخطأ) -> {
                طابق الخطأ مع
                | خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي) -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي));
                }
                | _ -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_ويب_أسمبلي(الخطأ));
                };
            };
        };
        ف := ف + 1;
    }
    دع الدخول_المصدر: متغير اختياري معرف_دالة_منتقاة = اختياري.لا_شيء();
    طابق دالة_بدء_البرنامج مع
    | اختياري.موجود(الدخول) -> {
        دع بدء_واسي: منطقي = (*الهدف).مزود_التشغيل == مزود_تشغيل_هدف.واسي();
        طابق (*المسير).المسير.دالة_خروج_العملية مع
        | اختياري.موجود(الخروج) -> {
            إذا (بدء_واسي) {
                طابق ابن_بدء_عملية_ويب_أسمبلي(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير السياق, الدخول, الخروج
                ) مع
                | نتيجة.نجح(البدء) -> { ألحق(الدوال, البدء); }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_ويب_أسمبلي(الخطأ));
                };
            } وإلا {
                الدخول_المصدر := اختياري.موجود(معرف_دالة_منتقاة_من_مسير(الدخول));
            };
        }
        | اختياري.لا_شيء -> {
            الدخول_المصدر := اختياري.موجود(معرف_دالة_منتقاة_من_مسير(الدخول));
        };
    }
    | اختياري.لا_شيء -> {
        طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
        | اختياري.موجود(المهيئ) -> { ألحق(الدوال, ابن_منشئ_وحدة_ويب_أسمبلي(&متغير السياق, المهيئ)); }
        | اختياري.لا_شيء -> { };
    };
    // Host imports: every declared external function under the target ABI
    // (no closure environment); the writer keeps the ones referenced.
    دع المستوردة: متغير متجه دالة_مستوردة_ويب_أسمبلي = [];
    دع وحدة_البيئة: متجه ط8 = بايتات_من_نص(«env»);
    ف := 0;
    طالما (ف < (الطول((*المسير).المسير.الدوال_الخارجية) مثل طبيعي)) {
        دع الخارجية: &دالة_خارجية_مسير = &(*المسير).المسير.الدوال_الخارجية[ف];
        دع الخطة: خطة_دالة_واجهة;
        طابق حل_خطة_واجهة_دالة_خارجية_للهدف(
            &(*حقائق_الخلفية).الأنواع, الهدف, سجل_التخطيط, &(*الخارجية).المعاملات, (*الخارجية).الناتج
        ) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_ويب_أسمبلي(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()));
        }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع التوقيع: توقيع_ويب_أسمبلي;
        طابق توقيع_خطة_ويب_أسمبلي(حقائق_الخلفية, &الخطة, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_ويب_أسمبلي(الخطأ)); }
        | نتيجة.نجح(ت) -> { التوقيع := ت; };
        // The import module is the library the declaration names
        // (`خارجي «wasi_snapshot_preview1» عرف ...`), with an explicit
        // import name; otherwise `env`, the default of wasm-ld, clang and
        // rustc for an import with no declared module.
        دع الوحدة: متغير متجه ط8 = انسخ_بايتات(&وحدة_البيئة);
        دع صريح: متغير منطقي = خطأ;
        طابق (*الخارجية).المكتبة مع
        | اختياري.موجود(الاسم) -> {
            الوحدة := انسخ_بايتات(&الاسم);
            صريح := صواب;
        }
        | اختياري.لا_شيء -> { };
        دع المستوردة_الواحدة: دالة_مستوردة_ويب_أسمبلي = {
            المعرف: معرف_دالة_خارجية_منتقاة_من_مسير((*الخارجية).المعرف),
            الوحدة: الوحدة,
            الاسم: انسخ_اسم_رمز_خارجي_كائن(&(*الخارجية).الاسم),
            التوقيع: ضمن_توقيع_ويب_أسمبلي(&متغير السياق.التواقيع, &التوقيع),
            اسم_صريح: صريح
        };
        ألحق(المستوردة, المستوردة_الواحدة);
        ف := ف + 1;
    }
    دع التواقيع: سجل_تواقيع_ويب_أسمبلي;
    طابق السياق مع
    | { التواقيع: ت, مزودات_الذاكرة: _, دالة_الدخول: _, موضع_مستقل: _ } -> { التواقيع := ت; };
    دع الوحدة_للكتابة: وحدة_ويب_أسمبلي_للكتابة = {
        التواقيع: التواقيع,
        المستوردة: المستوردة,
        الدوال: الدوال,
        المرفقات: المرفقات,
        الدخول_المصدر: الدخول_المصدر,
        موضع_مستقل: موضع_مستقل
    };
    طابق اكتب_كائن_ويب_أسمبلي(
        &الوحدة_للكتابة, خريطة_المصادر, الأصول, التصحيح, &تصحيح_الآلة,
        &(*حقائق_الخلفية).الأنواع, الهدف, سجل_التخطيط
    ) مع
    | نتيجة.نجح(البايتات) -> {
        دع الناتج: ناتج_كائن_أصلي_مفصل = { البايتات: البايتات };
        أرجع نتيجة_مخرج_أصلي_مفصل.نجح(الناتج);
    }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ويب_أسمبلي(الخطأ)); };
}

// The target as the native code generator sees it. A target the registry
// delegates (portable SultanC ABI for LLVM) and that also has a native machine
// path uses the platform's register ABI for every call in native code:
// AAPCS64 on non-Darwin AArch64. Every other fact is the registry's.
عرف واصف_هدف_للشفرة_الأصلية(الهدف: &واصف_هدف): واصف_هدف {
    دع النسخة: متغير واصف_هدف = انسخ_مملوكا_واصف_هدف(الهدف);
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_لينكس_إلف -> {
        النسخة.الواجهة_الثنائية := هوية_واجهة_ثنائية_هدف.إيه_إيه_بي_سي_إس_أربعة_وستون();
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_ويندوز_كوف -> {
        النسخة.الواجهة_الثنائية := هوية_واجهة_ثنائية_هدف.إيه_إيه_بي_سي_إس_أربعة_وستون();
    }
    // x86-64 Windows: SultanC's internal convention is System V's; foreign
    // calls take the Microsoft x64 plan (target_abi_resolution.sn).
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف -> {
        النسخة.الواجهة_الثنائية := هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون();
    }
    // x86-64 Linux, Android and FreeBSD: System V (x86_64-android keeps the portable
    // ABI in the registry).
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        النسخة.الواجهة_الثنائية := هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون();
    }
    // x86-64 macOS: System V is the platform convention for every call.
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_داروين_ماتشو -> {
        النسخة.الواجهة_الثنائية := هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون();
    }
    | _ -> { };
    أرجع النسخة;
}

// المدخل المقنن الوحيد للمخرج الأصلي الكامل: يستهلك MSIR متحققا وينتهي عند بايتات الكائن.
عرف ابن_مخرج_أصلي_مفصل(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف_المسجل: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختياري معرف_دالة_مسير,
    مخرج_تنفيذي: منطقي,
    موضع_مستقل: منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع هدف_الشفرة: واصف_هدف = واصف_هدف_للشفرة_الأصلية(الهدف_المسجل);
    دع الهدف: &واصف_هدف = &هدف_الشفرة;
    دع و: واصف_هدف = *الهدف;
    دع دالة_الدخول: متغير اختياري معرف_دالة_منتقاة = اختياري.لا_شيء();
    طابق حل_دخول_أصلي(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_بدء_البرنامج) مع
    | نتيجة_حل_دخول_أصلي.بلا_دخول -> { }
    | نتيجة_حل_دخول_أصلي.تصدير_مباشر(الدالة) -> { دالة_الدخول := اختياري.موجود(الدالة); }
    | نتيجة_حل_دخول_أصلي.أخفق(فشل_الدخول) -> {
        دع الفشل: فشل_مخرج_أصلي = فشل_مخرج_أصلي.دخول_تنفيذي(فشل_الدخول);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل);
    };

    دع الدوال_المطلوبة: متجه منطقي = دوال_مسير_مطلوبة_لمخرج(
        المسير, مخرج_تنفيذي, دالة_بدء_البرنامج
    );

    طابق حل_قدرة_مخرج_أصلي(الهدف) مع
    | قدرة_مخرج_أصلي.غير_متاحة -> {
        دع الفشل: فشل_مخرج_أصلي = فشل_مخرج_أصلي.قدرة_مخرج_غير_متاحة(و.المعرف);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل);
    }
    | قدرة_مخرج_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع ابن_مخرج_ذراع_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    }
    | قدرة_مخرج_أصلي.ذراع_أربعة_وستون_ويندوز_كوف -> {
        أرجع ابن_مخرج_ذراع_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    }
    | قدرة_مخرج_أصلي.ذراع_أربعة_وستون_لينكس_إلف -> {
        أرجع ابن_مخرج_ذراع_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    }
    | قدرة_مخرج_أصلي.إكس_ستة_وثمانون_أربعة_وستون_داروين_ماتشو -> {
        أرجع ابن_مخرج_إكس_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    }
    | قدرة_مخرج_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف -> {
        أرجع ابن_مخرج_إكس_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    }
    | قدرة_مخرج_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع ابن_مخرج_إكس_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    }
    | قدرة_مخرج_أصلي.ويب_أسمبلي_اثنان_وثلاثون_وحدة -> {
        أرجع ابن_مخرج_ويب_أسمبلي_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط,
            دالة_بدء_البرنامج, &الدوال_المطلوبة, موضع_مستقل
        );
    };
}

// Executable orchestration asks the native provider for a relocatable object only.
// Linking is owned by compiler/link and is shared with the LLVM provider.
عام عرف ابن_كائن_أصلي_للربط(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختياري معرف_دالة_مسير,
    مخرج_تنفيذي: منطقي,
    // Position-independent code for a shared library output. Only the wasm32
    // path consults it (WebAssembly DynamicLinking.md); the other native
    // paths keep their existing code model.
    موضع_مستقل: منطقي
): نتيجة_مخرج_أصلي_مفصل {
    أرجع ابن_مخرج_أصلي_مفصل(
        المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف,
        سجل_التخطيط, دالة_بدء_البرنامج, مخرج_تنفيذي, موضع_مستقل
    );
}

// Public object output discards the in-memory DWARF rebase metadata only after
// the canonical object bytes have been produced. Executable output keeps it.
عام عرف ابن_مخرج_أصلي(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختياري معرف_دالة_مسير
): نتيجة_مخرج_أصلي {
    طابق ابن_مخرج_أصلي_مفصل(
        المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط,
        دالة_بدء_البرنامج, خطأ, خطأ
    ) مع
    | نتيجة_مخرج_أصلي_مفصل.نجح(الناتج) -> {
        دع مرجع_البايتات: &متجه ط8 = &الناتج.البايتات;
        دع البايتات: متجه ط8 = انسخ_بايتات(مرجع_البايتات);
        أرجع نتيجة_مخرج_أصلي.نجح(البايتات);
    }
    | نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل) -> { أرجع نتيجة_مخرج_أصلي.أخفق(الفشل); };
}

// std.async's task context switch (اسم_تبديل_سياق_المهام_أساسي) as fixed
// machine code. Both layouts are the contract std.async builds a new task's
// first frame from.
عرف هي_دالة_تبديل_سياق_مسير(المسير: &سياق_مستهلك_مسير, المعرف: معرف_دالة_مسير): منطقي {
    طابق (*المسير).المسير.دالة_تبديل_سياق_المهام مع
    | اختياري.موجود(د) -> { أرجع د.القيمة == المعرف.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Native x86_64 (System V; the closure environment in r15, the arguments in
// rdi = save address, rsi = new stack):
//   test rsi,rsi; jnz 1f; lea rax,[rip+2f]; ret
//   1: push rbp, rbx, r12, r13, r14, r15; mov [rdi],rsp; mov rsp,rsi
//      pop r15, r14, r13, r12, rbx, rbp; xor eax,eax; ret
//   2: (task trampoline; r12 = the task closure environment)
//      mov rdi,r12; mov r15,r12; call [r12]; ud2
// A saved frame, from the stack pointer up: r15 r14 r13 r12 rbx rbp ret.
عرف بايتات_تبديل_سياق_المهام_إكس(): متجه ط8 {
    دع ب: متجه ط8 = [
        0x48, 0x85, 0xF6,
        0x75, 0x08,
        0x48, 0x8D, 0x05, 0x1E, 0x00, 0x00, 0x00,
        0xC3,
        0x55, 0x53, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57,
        0x48, 0x89, 0x27,
        0x48, 0x89, 0xF4,
        0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x5B, 0x5D,
        0x31, 0xC0,
        0xC3,
        0x4C, 0x89, 0xE7,
        0x4D, 0x89, 0xE7,
        0x41, 0xFF, 0x14, 0x24,
        0x0F, 0x0B
    ];
    أرجع ب;
}

// Native arm64 (AAPCS64 on Darwin; the closure environment in x14, the
// arguments in x0 = save address, x1 = new stack). A saved frame is 176
// bytes: x19..x28 at 0..72, x29 x30 at 80, d8..d15 at 96..152.
//   cbnz x1,1f; adr x0,2f; ret
//   1: sub sp,sp,#176; stp ...; mov x9,sp; str x9,[x0]; mov sp,x1
//      ldp ...; add sp,sp,#176; mov x0,#0; ret
//   2: mov x0,x19; mov x14,x19; ldr x16,[x19]; blr x16; brk #0
عرف كلمات_تبديل_سياق_المهام_ذراع(): متجه طبيعي {
    دع ك: متجه طبيعي = [
        0xB5000061, 0x100003A0, 0xD65F03C0,
        0xD102C3FF,
        0xA90053F3, 0xA9015BF5, 0xA90263F7, 0xA9036BF9, 0xA90473FB, 0xA9057BFD,
        0x6D0627E8, 0x6D072FEA, 0x6D0837EC, 0x6D093FEE,
        0x910003E9, 0xF9000009, 0x9100003F,
        0xA94053F3, 0xA9415BF5, 0xA94263F7, 0xA9436BF9, 0xA94473FB, 0xA9457BFD,
        0x6D4627E8, 0x6D472FEA, 0x6D4837EC, 0x6D493FEE,
        0x9102C3FF, 0xD2800000, 0xD65F03C0,
        0xAA1303E0, 0xAA1303EE, 0xF9400270, 0xD63F0200, 0xD4200000
    ];
    أرجع ك;
}
