// B8 هو حد تركيب فقط: Target يقرر اكتمال القدرة، وكل مرحلة لاحقة تبقى عند مالكها.
// كل طبقة تضيف سياقها ولا تحذف خطأ المالك الأدنى.
عام نوع فشل_تخصيص_ذراع_أربعة_وستون =
    | يحتاج_انسكاب بنوع سبب_حاجة_انسكاب
    | فشل_قيود بنوع معرف_سجل_افتراضي
    | حالة_انسكاب_غير_مدعومة بنوع معرف_سجل_افتراضي
    | سياسة_إطار_غير_متاحة بنوع معرف_هدف
    | هدف_غير_صالح بنوع معرف_هدف
;

عام نوع فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون =
    | يحتاج_انسكاب بنوع سبب_حاجة_انسكاب
    | فشل_قيود بنوع معرف_سجل_افتراضي
    | حالة_انسكاب_غير_مدعومة بنوع معرف_سجل_افتراضي
    | سياسة_إطار_غير_متاحة بنوع معرف_هدف
    | هدف_غير_صالح بنوع معرف_هدف
;

عام نوع فشل_إصدار_كائن_ذراع =
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | خطأ_ماتشو بنوع خطأ_ماتشو
;

عام نوع فشل_إصدار_كائن_إكس =
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | خطأ_إلف بنوع خطأ_إلف
;

عام نوع فشل_حل_دخول_أصلي =
    | دالة_مسير_مفقودة بنوع معرف_دالة_مسير
    | واجهة_دخول_غير_متاحة بنوع (معرف_دالة_مسير, خطأ_حل_واجهة_اختيار)
    | هدف_دخول_غير_متاح بنوع معرف_هدف
    | مهايئ_دخول_مطلوب بنوع معرف_دالة_مسير
;

عام نوع فشل_مخرج_أصلي =
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | دخول_تنفيذي بنوع فشل_حل_دخول_أصلي
    | اختيار بنوع فشل_شفرة_منتقاة_أصلية
    | اختيار_غير_متطابق بنوع معرف_هدف
    | تخصيص_ذراع بنوع فشل_تخصيص_ذراع_أربعة_وستون
    | ترميز_ذراع بنوع خطأ_ترميز_ذراع_أربعة_وستون
    | إكمال_تشغيل_ذراع بنوع خطأ_إكمال_ترميز_تشغيل_ذراع
    | كائن_ذراع بنوع فشل_إصدار_كائن_ذراع
    | تخصيص_إكس بنوع فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون
    | ترميز_إكس بنوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
    | إكمال_تشغيل_إكس بنوع خطأ_إكمال_ترميز_تشغيل_إكس
    | كائن_إكس بنوع فشل_إصدار_كائن_إكس
    | تخطيط_عام_غير_مكتمل بنوع معرف_عام_مسير
    | تهيئة_عام_غير_مدعومة بنوع معرف_عام_مسير
;

عام نوع نتيجة_مخرج_أصلي =
    | نجح بنوع متجه غ8
    | أخفق بنوع فشل_مخرج_أصلي
;

عام نوع نتيجة_مخرج_أصلي_مفصل =
    | نجح بنوع ناتج_كائن_أصلي_مفصل
    | أخفق بنوع فشل_مخرج_أصلي
;

نوع نتيجة_حل_دخول_أصلي =
    | بلا_دخول
    | تصدير_مباشر بنوع معرف_دالة_منتقاة
    | أخفق بنوع فشل_حل_دخول_أصلي
;

نوع نتيجة_مادة_عوام_أصلية =
    | نجحت
    | أخفقت بنوع فشل_مخرج_أصلي
;

عرف ألحق_قيمة_عددية_عامة(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع,
    الحجم: غير_موقع,
    الترتيب: ترتيب_بايت
): منطقي {
    لو (الحجم == 0 || الحجم > 8) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        دع إزاحة_البايت: غير_موقع;
        طابق الترتيب مع
        | ترتيب_بايت.صغير -> { إزاحة_البايت := ف; }
        | ترتيب_بايت.كبير -> { إزاحة_البايت := الحجم - 1 - ف; };
        دع القاسم: متغير غير_موقع = 1;
        دع ب: متغير غير_موقع = 0;
        بينما (ب < إزاحة_البايت) { القاسم := القاسم * 256; ب := ب + 1; }
        دع المقسوم: غير_موقع = القيمة / القاسم;
        دع قيمة_البايت: غير_موقع = المقسوم % 256;
        دع البايت: غ8 = قيمة_البايت مثل غ8;
        ألحق(*البايتات, البايت);
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف مادة_عوام_مسير_للكائن(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المرفقات: &متغير مرفقات_كائن_مشفرة
): نتيجة_مادة_عوام_أصلية {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*المسير).المسير.العوام) مثل غير_موقع)) {
        دع العام: &عام_مسير = &(*المسير).المسير.العوام[ف];
        دع التخطيط: واصف_تخطيط;
        طابق حل_تخطيط_نوع(&(*حقائق_الخلفية).الأنواع, الهدف, سجل_التخطيط, (*العام).النوع) مع
        | نتيجة_تخطيط.مكتمل(الوصف) -> { التخطيط := الوصف; }
        | نتيجة_تخطيط.مؤجل(_) -> {
            أرجع نتيجة_مادة_عوام_أصلية.أخفقت(
                فشل_مخرج_أصلي.تخطيط_عام_غير_مكتمل((*العام).المعرف)
            );
        }
        | نتيجة_تخطيط.مرفوض(_) -> {
            أرجع نتيجة_مادة_عوام_أصلية.أخفقت(
                فشل_مخرج_أصلي.تخطيط_عام_غير_مكتمل((*العام).المعرف)
            );
        };
        دع البيانات: متغير متجه غ8 = [];
        دع الخام: متغير غير_موقع = 0;
        دع مدعوم: متغير منطقي = صواب;
        طابق (*العام).التهيئة مع
        | ثابت_مسير.منطق(القيمة) -> { لو (القيمة) { الخام := 1; } وإلا { الخام := 0; }; }
        | ثابت_مسير.صحيح_موقع(القيمة) -> { الخام := القيمة مثل غير_موقع; }
        | ثابت_مسير.صحيح_غير_موقع(القيمة) -> { الخام := القيمة; }
        | _ -> { مدعوم := خطأ; };
        لو (!مدعوم || !ألحق_قيمة_عددية_عامة(
            &متغير البيانات, الخام, التخطيط.الحجم, (*الهدف).نموذج_البيانات.ترتيب_البايت
        )) {
            أرجع نتيجة_مادة_عوام_أصلية.أخفقت(
                فشل_مخرج_أصلي.تهيئة_عام_غير_مدعومة((*العام).المعرف)
            );
        };
        دع معرف_العام: معرف_عام_مسير = (*العام).المعرف;
        دع قابل_للكتابة: منطقي = (*العام).قابل_للكتابة;
        دع مادة: بيانات_عام_كائن = {
            المعرف: معرف_العام,
            البيانات: البيانات,
            المحاذاة: التخطيط.المحاذاة,
            قابل_للكتابة: قابل_للكتابة
        };
        ألحق((*المرفقات).البيانات_العامة, مادة);
        ف := ف + 1;
    }
    أرجع نتيجة_مادة_عوام_أصلية.نجحت();
}

عرف حل_دخول_أصلي(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير
): نتيجة_حل_دخول_أصلي {
    طابق دالة_بدء_البرنامج مع
    | اختيار.لا_شيء -> { أرجع نتيجة_حل_دخول_أصلي.بلا_دخول(); }
    | اختيار.بعض(المعرف) -> {
        طابق ابحث_دالة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
            دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.دالة_مسير_مفقودة(المفقود);
            أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
        }
        | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
            طابق حل_واجهة_عرض_دالة_مسير_للهدف(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &العرض
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.واجهة_دخول_غير_متاحة(المعرف, الخطأ);
                أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
            }
            | نتيجة.نجح(خطة_الواجهة) -> {
                طابق حل_دخول_تنفيذي_للهدف(الهدف, &خطة_الواجهة) مع
                | نتيجة_حل_دخول_تنفيذي_هدف.غير_متاح(معرف_الهدف) -> {
                    دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.هدف_دخول_غير_متاح(معرف_الهدف);
                    أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
                }
                | نتيجة_حل_دخول_تنفيذي_هدف.متاح(الخطة) -> {
                    طابق الخطة.الأسلوب مع
                    | أسلوب_دخول_تنفيذي_هدف.تصدير_مباشر -> {
                        دع المنتقاة: معرف_دالة_منتقاة = معرف_دالة_منتقاة_من_مسير(المعرف);
                        أرجع نتيجة_حل_دخول_أصلي.تصدير_مباشر(المنتقاة);
                    }
                    | أسلوب_دخول_تنفيذي_هدف.يحتاج_مهايئ -> {
                        دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.مهايئ_دخول_مطلوب(المعرف);
                        أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
                    };
                };
            };
        };
    };
}

// Executable output only needs functions reachable from the canonical program entry.
// Object output keeps every function because object files are reusable link inputs.
عرف علّم_دالة_تنفيذية_مطلوبة(
    المطلوبة: &متغير متجه منطقي,
    العمل: &متغير متجه معرف_دالة_مسير,
    المعرف: معرف_دالة_مسير
): فراغ {
    لو (المعرف.القيمة >= (الطول(*المطلوبة) مثل غير_موقع)) { أرجع; };
    لو ((*المطلوبة)[المعرف.القيمة]) { أرجع; };
    (*المطلوبة)[المعرف.القيمة] := صواب;
    ألحق(*العمل, المعرف);
}

عرف كل_دوال_مسير_مطلوبة(المسير: &سياق_مستهلك_مسير): متجه منطقي {
    دع المطلوبة: متغير متجه منطقي = [];
    دع ف: متغير غير_موقع = 0;
    دع العدد: غير_موقع = عدد_دوال_مسير(المسير);
    بينما (ف < العدد) { ألحق(المطلوبة, صواب); ف := ف + 1; }
    أرجع المطلوبة;
}

عرف دوال_مسير_تنفيذية_مطلوبة(
    المسير: &سياق_مستهلك_مسير,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير
): متجه منطقي {
    دع المطلوبة: متغير متجه منطقي = [];
    دع العمل: متغير متجه معرف_دالة_مسير = [];
    دع العدد: غير_موقع = عدد_دوال_مسير(المسير);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) { ألحق(المطلوبة, خطأ); ف := ف + 1; }

    طابق دالة_بدء_البرنامج مع
    | اختيار.بعض(المعرف) -> { علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, المعرف); }
    | اختيار.لا_شيء -> { أرجع كل_دوال_مسير_مطلوبة(المسير); };

    // Function-valued globals are roots even when reached through an indirect call later.
    ف := 0;
    بينما (ف < (الطول((*المسير).المسير.العوام) مثل غير_موقع)) {
        طابق (*المسير).المسير.العوام[ف].التهيئة مع
        | ثابت_مسير.دالة(المعرف) -> {
            علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, المعرف);
        }
        | _ -> { };
        ف := ف + 1;
    }

    دع موضع_العمل: متغير غير_موقع = 0;
    بينما (موضع_العمل < (الطول(العمل) مثل غير_موقع)) {
        دع المعرف: معرف_دالة_مسير = العمل[موضع_العمل];
        لو (المعرف.القيمة < (الطول((*المسير).المسير.الدوال) مثل غير_موقع)) {
            دع الدالة: &دالة_مسير = &(*المسير).المسير.الدوال[المعرف.القيمة];
            دع ك: متغير غير_موقع = 0;
            بينما (ك < (الطول((*الدالة).الكتل) مثل غير_موقع)) {
                دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[ك];
                دع ت: متغير غير_موقع = 0;
                بينما (ت < (الطول((*الكتلة).التعليمات) مثل غير_موقع)) {
                    طابق (*الكتلة).التعليمات[ت].العملية مع
                    | عملية_مسير.ثابت(الثابت) -> {
                        طابق الثابت مع
                        | ثابت_مسير.دالة(الهدف) -> {
                            علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, الهدف);
                        }
                        | _ -> { };
                    }
                    | عملية_مسير.بناء_إغلاق(الإغلاق) -> {
                        علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, الإغلاق.الدالة);
                    }
                    | عملية_مسير.نداء(النداء) -> {
                        طابق النداء.الهدف مع
                        | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
                            علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, الهدف);
                        }
                        | _ -> { };
                    }
                    | _ -> { };
                    ت := ت + 1;
                }
                ك := ك + 1;
            }
        };
        موضع_العمل := موضع_العمل + 1;
    }
    أرجع المطلوبة;
}

// المسار المتدرج يحتفظ فقط بالناتج المشفر والملخصات المطلوبة للكائن عبر الدوال.
// selected/allocated machine IR يبقيان محليين للدالة الحالية فقط.
عرف ابن_مخرج_ذراع_متدرج(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الدوال_المطلوبة: &متجه منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع تصحيح_الآلة: متغير سياق_تصحيح_آلة = هيئ_سياق_تصحيح_آلة();
    دع سياق_الفك: متغير سياق_معلومات_إطار_النداء = سياق_معلومات_إطار_النداء_جديد();
    دع الرموز_الخارجية: متغير متجه متجه غ8 = أسماء_الدوال_الخارجية_مسير(المسير);
    دع الدوال_المشفرة: متغير متجه دالة_ذراع_أربعة_وستون_مشفرة = [];
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    طابق مادة_عوام_مسير_للكائن(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير المرفقات) مع
    | نتيجة_مادة_عوام_أصلية.نجحت -> { }
    | نتيجة_مادة_عوام_أصلية.أخفقت(الفشل) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل); };
    دع العدد: غير_موقع = عدد_دوال_مسير(المسير);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (ف < (الطول(*الدوال_المطلوبة) مثل غير_موقع) && (*الدوال_المطلوبة)[ف]) {
        دع المعرف: معرف_دالة_مسير = معرف_دالة_مسير_من(ف);
        طابق هيئ_دالة_منتقاة(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
        | نتيجة_دالة_منتقاة_أصلية.بدائي_مسير_غير_مخفض(البدائي) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي));
        }
        | نتيجة_دالة_منتقاة_أصلية.خطأ(الخطأ) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار(الخطأ));
        }
        | نتيجة_دالة_منتقاة_أصلية.إكس_ستة_وثمانون_أربعة_وستون(_) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_غير_متطابق((*الهدف).المعرف));
        }
        | نتيجة_دالة_منتقاة_أصلية.ذراع_أربعة_وستون(المنتقاة) -> {
            طابق خصص_دالة_ذراع_أربعة_وستون(&المنتقاة, الهدف) مع
            | نتيجة_تخصيص_دالة_ذراع.فشل_قيود(السجل) -> {
                دع خ: فشل_تخصيص_ذراع_أربعة_وستون = فشل_تخصيص_ذراع_أربعة_وستون.فشل_قيود(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_ذراع(خ));
            }
            | نتيجة_تخصيص_دالة_ذراع.حالة_انسكاب_غير_مدعومة(السجل) -> {
                دع خ: فشل_تخصيص_ذراع_أربعة_وستون = فشل_تخصيص_ذراع_أربعة_وستون.حالة_انسكاب_غير_مدعومة(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_ذراع(خ));
            }
            | نتيجة_تخصيص_دالة_ذراع.سياسة_إطار_غير_متاحة(م) -> {
                دع خ: فشل_تخصيص_ذراع_أربعة_وستون = فشل_تخصيص_ذراع_أربعة_وستون.سياسة_إطار_غير_متاحة(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_ذراع(خ));
            }
            | نتيجة_تخصيص_دالة_ذراع.هدف_غير_صالح(م) -> {
                دع خ: فشل_تخصيص_ذراع_أربعة_وستون = فشل_تخصيص_ذراع_أربعة_وستون.هدف_غير_صالح(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_ذراع(خ));
            }
            | نتيجة_تخصيص_دالة_ذراع.نجحت(المخصصة) -> {
                دع قيمة_المخصصة: دالة_ذراع_أربعة_وستون_مخصصة = المخصصة;
                سجل_تعيينات_تصحيح_آلة(
                    &متغير تصحيح_الآلة, &(*التصحيح).العقد, &(*التصحيح).الدلالي,
                    قيمة_المخصصة.الرأس.المعرف, الهدف, &قيمة_المخصصة.التعيينات
                );
                سجل_انسكابات_ذراع_في_تصحيح_آلة(
                    &متغير تصحيح_الآلة, التصحيح, قيمة_المخصصة.الرأس.المعرف, الهدف, &قيمة_المخصصة.إطار_الانسكاب
                );
                طابق شفّر_دالة_ذراع(&قيمة_المخصصة, الهدف, &متغير المرفقات) مع
                | نتيجة_دالة_ترميز_ذراع.خطأ(الخطأ) -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_ذراع(الخطأ));
                }
                | نتيجة_دالة_ترميز_ذراع.نجحت(المشفرة) -> {
                    سجل_سطور_تصحيح_آلة(
                        &متغير تصحيح_الآلة, التصحيح, قيمة_المخصصة.الرأس.المعرف, &المشفرة.أصول_الآلة
                    );
                    سجل_أحداث_معلومات_إطار_النداء(
                        &متغير سياق_الفك, قيمة_المخصصة.الرأس.المعرف, &المشفرة.أحداث_فك_المكدس
                    );
                    ألحق(الدوال_المشفرة, المشفرة);
                };
            };
        };
        };
        ف := ف + 1;
    }
    دع معرف_الهدف_المشفر: معرف_هدف = (*الهدف).المعرف;
    دع الشفرة_الأولية: شفرة_ذراع_أربعة_وستون_مشفرة = {
        الهدف: معرف_الهدف_المشفر,
        الدوال: الدوال_المشفرة,
        المرفقات: المرفقات
    };
    دع الشفرة: متغير شفرة_ذراع_أربعة_وستون_مشفرة = الشفرة_الأولية;
    طابق أكمل_ترميز_تشغيل_ذراع_للهدف(&متغير الشفرة, الهدف, &الرموز_الخارجية) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.إكمال_تشغيل_ذراع(الخطأ));
    }
    | اختيار.لا_شيء -> { };
    دع حقائق_الخلفية_المحلية: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
    دع مرجع_أنواع_الخلفية: &سجل_أنواع = &حقائق_الخلفية_المحلية.الأنواع;
    طابق اصدر_كائن_ذراع_أربعة_وستون(
        الشفرة, الهدف, دالة_الدخول, &الرموز_الخارجية, خريطة_المصادر, الأصول,
        التصحيح, &تصحيح_الآلة, &سياق_الفك, مرجع_أنواع_الخلفية, سجل_التخطيط
    ) مع
    | نتيجة_إصدار_كائن_ذراع.نجح(البايتات) -> { أرجع نتيجة_مخرج_أصلي_مفصل.نجح(البايتات); }
    | نتيجة_إصدار_كائن_ذراع.قدرة_مخرج_غير_متاحة(م) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.قدرة_مخرج_غير_متاحة(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    }
    | نتيجة_إصدار_كائن_ذراع.هدف_غير_متطابق(م) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.هدف_غير_متطابق(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    }
    | نتيجة_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_ذراع = فشل_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_ذراع(خ));
    };
}

عرف ابن_مخرج_إكس_متدرج(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: اختيار معرف_دالة_منتقاة,
    الدوال_المطلوبة: &متجه منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع تصحيح_الآلة: متغير سياق_تصحيح_آلة = هيئ_سياق_تصحيح_آلة();
    دع سياق_الفك: متغير سياق_معلومات_إطار_النداء = سياق_معلومات_إطار_النداء_جديد();
    دع الرموز_الخارجية: متغير متجه متجه غ8 = أسماء_الدوال_الخارجية_مسير(المسير);
    دع البايتات: متغير متجه غ8 = [];
    دع الدوال: متغير متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = [];
    دع الفروع: متغير متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع النداءات: متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع أصول_الآلة: متغير متجه مدى_شفرة_آلة_بأصل = [];
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    طابق مادة_عوام_مسير_للكائن(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير المرفقات) مع
    | نتيجة_مادة_عوام_أصلية.نجحت -> { }
    | نتيجة_مادة_عوام_أصلية.أخفقت(الفشل) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل); };
    دع العدد: غير_موقع = عدد_دوال_مسير(المسير);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (ف < (الطول(*الدوال_المطلوبة) مثل غير_موقع) && (*الدوال_المطلوبة)[ف]) {
        دع المعرف: معرف_دالة_مسير = معرف_دالة_مسير_من(ف);
        طابق هيئ_دالة_منتقاة(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
        | نتيجة_دالة_منتقاة_أصلية.بدائي_مسير_غير_مخفض(البدائي) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي));
        }
        | نتيجة_دالة_منتقاة_أصلية.خطأ(الخطأ) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار(الخطأ));
        }
        | نتيجة_دالة_منتقاة_أصلية.ذراع_أربعة_وستون(_) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_غير_متطابق((*الهدف).المعرف));
        }
        | نتيجة_دالة_منتقاة_أصلية.إكس_ستة_وثمانون_أربعة_وستون(المنتقاة) -> {
            طابق خصص_دالة_إكس_ستة_وثمانون_أربعة_وستون(&المنتقاة, الهدف) مع
            | نتيجة_تخصيص_دالة_إكس.فشل_قيود(السجل) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.فشل_قيود(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.حالة_انسكاب_غير_مدعومة(السجل) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.حالة_انسكاب_غير_مدعومة(السجل);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.سياسة_إطار_غير_متاحة(م) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.سياسة_إطار_غير_متاحة(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.هدف_غير_صالح(م) -> {
                دع خ: فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون = فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.هدف_غير_صالح(م);
                أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.تخصيص_إكس(خ));
            }
            | نتيجة_تخصيص_دالة_إكس.نجحت(المخصصة) -> {
                دع قيمة_المخصصة: دالة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = المخصصة;
                دع بداية_أصول_الدالة: غير_موقع = الطول(أصول_الآلة) مثل غير_موقع;
                سجل_تعيينات_تصحيح_آلة(
                    &متغير تصحيح_الآلة, &(*التصحيح).العقد, &(*التصحيح).الدلالي,
                    قيمة_المخصصة.الرأس.المعرف, الهدف, &قيمة_المخصصة.التعيينات
                );
                سجل_انسكابات_إكس_في_تصحيح_آلة(
                    &متغير تصحيح_الآلة, التصحيح, قيمة_المخصصة.الرأس.المعرف, الهدف, &قيمة_المخصصة.إطار_الانسكاب
                );
                طابق شفّر_دالة_إكس_ستة_وثمانون_أربعة_وستون(
                    &قيمة_المخصصة, الهدف, &متغير البايتات, &متغير الدوال, &متغير الفروع, &متغير النداءات,
                    &متغير أصول_الآلة
                ) مع
                | نتيجة_ترميز_دالة_إكس.خطأ(الخطأ) -> {
                    أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.ترميز_إكس(الخطأ));
                }
                | نتيجة_ترميز_دالة_إكس.نجحت -> {
                    دع أصول_الدالة: متغير متجه مدى_شفرة_آلة_بأصل = [];
                    دع أصل_ف: متغير غير_موقع = بداية_أصول_الدالة;
                    بينما (أصل_ف < (الطول(أصول_الآلة) مثل غير_موقع)) {
                        ألحق(أصول_الدالة, أصول_الآلة[أصل_ف]);
                        أصل_ف := أصل_ف + 1;
                    }
                    سجل_سطور_تصحيح_آلة(
                        &متغير تصحيح_الآلة, التصحيح, قيمة_المخصصة.الرأس.المعرف, &أصول_الدالة
                    );
                    دع عدد_الدوال_المشفرة: غير_موقع = الطول(الدوال) مثل غير_موقع;
                    لو (عدد_الدوال_المشفرة > 0) {
                        دع موضع_المشفرة: غير_موقع = عدد_الدوال_المشفرة - 1;
                        سجل_أحداث_معلومات_إطار_النداء(
                            &متغير سياق_الفك, قيمة_المخصصة.الرأس.المعرف,
                            &الدوال[موضع_المشفرة].أحداث_فك_المكدس
                        );
                    };
                };
            };
        };
        };
        ف := ف + 1;
    }
    دع بلا_دخول: اختيار دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = اختيار.لا_شيء();
    دع تصديرات_التشغيل_الأولية: متجه موضع_تصدير_تشغيل_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع معرف_الهدف_المشفر: معرف_هدف = (*الهدف).المعرف;
    دع الأولية: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
        الهدف: معرف_الهدف_المشفر,
        البيانات: البايتات,
        الدوال: الدوال,
        تثبيتات_الفروع: الفروع,
        إزاحات_النداء: النداءات,
        أصول_الآلة: أصول_الآلة,
        تصديرات_التشغيل: تصديرات_التشغيل_الأولية,
        المرفقات: المرفقات,
        دخول_عملية_لينكس: بلا_دخول
    };
    دع الشفرة: متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = الأولية;
    دع تصديرات_تشغيل_فارغة: متجه هوية_تصدير_تشغيل = [];
    طابق أكمل_ترميز_تشغيل_إكس_للهدف(
        &متغير الشفرة,
        الهدف,
        دالة_الدخول,
        &متغير الرموز_الخارجية,
        &تصديرات_تشغيل_فارغة
    ) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.إكمال_تشغيل_إكس(الخطأ)); }
    | اختيار.لا_شيء -> { };
    طابق اصدر_كائن_إكس_ستة_وثمانون_أربعة_وستون(
        &الشفرة, الهدف, دالة_الدخول, &الرموز_الخارجية, خريطة_المصادر, الأصول,
        التصحيح, &تصحيح_الآلة, &سياق_الفك, &(*حقائق_الخلفية).الأنواع, سجل_التخطيط
    ) مع
    | نتيجة_إصدار_كائن_إكس.نجح(الناتج) -> { أرجع نتيجة_مخرج_أصلي_مفصل.نجح(الناتج); }
    | نتيجة_إصدار_كائن_إكس.قدرة_مخرج_غير_متاحة(م) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.قدرة_مخرج_غير_متاحة(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    }
    | نتيجة_إصدار_كائن_إكس.هدف_غير_متطابق(م) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.هدف_غير_متطابق(م);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    }
    | نتيجة_إصدار_كائن_إكس.فشل_إلف(الخطأ) -> {
        دع خ: فشل_إصدار_كائن_إكس = فشل_إصدار_كائن_إكس.خطأ_إلف(الخطأ);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.كائن_إكس(خ));
    };
}

// المدخل المقنن الوحيد للمخرج الأصلي الكامل: يستهلك MSIR متحققا وينتهي عند بايتات الكائن.
عرف ابن_مخرج_أصلي_مفصل(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير,
    اقتصر_على_التنفيذي: منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع و: واصف_هدف = *الهدف;
    دع دالة_الدخول: متغير اختيار معرف_دالة_منتقاة = اختيار.لا_شيء();
    طابق حل_دخول_أصلي(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_بدء_البرنامج) مع
    | نتيجة_حل_دخول_أصلي.بلا_دخول -> { }
    | نتيجة_حل_دخول_أصلي.تصدير_مباشر(الدالة) -> { دالة_الدخول := اختيار.بعض(الدالة); }
    | نتيجة_حل_دخول_أصلي.أخفق(فشل_الدخول) -> {
        دع الفشل: فشل_مخرج_أصلي = فشل_مخرج_أصلي.دخول_تنفيذي(فشل_الدخول);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل);
    };

    دع الدوال_المطلوبة: متجه منطقي;
    لو (اقتصر_على_التنفيذي) {
        الدوال_المطلوبة := دوال_مسير_تنفيذية_مطلوبة(المسير, دالة_بدء_البرنامج);
    } وإلا {
        الدوال_المطلوبة := كل_دوال_مسير_مطلوبة(المسير);
    };

    طابق حل_قدرة_مخرج_أصلي(الهدف) مع
    | قدرة_مخرج_أصلي.غير_متاحة -> {
        دع الفشل: فشل_مخرج_أصلي = فشل_مخرج_أصلي.قدرة_مخرج_غير_متاحة(و.المعرف);
        أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل);
    }
    | قدرة_مخرج_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع ابن_مخرج_ذراع_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    }
    | قدرة_مخرج_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع ابن_مخرج_إكس_متدرج(
            المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        );
    };
}

// Executable orchestration asks the native provider for a relocatable object only.
// Linking is owned by compiler/link and is shared with the LLVM provider.
عام عرف ابن_كائن_أصلي_للربط(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير
): نتيجة_مخرج_أصلي_مفصل {
    أرجع ابن_مخرج_أصلي_مفصل(
        المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف,
        سجل_التخطيط, دالة_بدء_البرنامج, صواب
    );
}

// Public object output discards the in-memory DWARF rebase metadata only after
// the canonical object bytes have been produced. Executable output keeps it.
عام عرف ابن_مخرج_أصلي(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير
): نتيجة_مخرج_أصلي {
    طابق ابن_مخرج_أصلي_مفصل(
        المسير, خريطة_المصادر, الأصول, التصحيح, حقائق_الخلفية, الهدف, سجل_التخطيط,
        دالة_بدء_البرنامج, خطأ
    ) مع
    | نتيجة_مخرج_أصلي_مفصل.نجح(الناتج) -> {
        دع مرجع_البايتات: &متجه غ8 = &الناتج.البايتات;
        دع البايتات: متجه غ8 = *مرجع_البايتات;
        أرجع نتيجة_مخرج_أصلي.نجح(البايتات);
    }
    | نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل) -> { أرجع نتيجة_مخرج_أصلي.أخفق(الفشل); };
}
