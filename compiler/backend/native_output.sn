                    // function-local line/scope/location conversion above.
                    // The Mach-O writer consumes the derived machine debug,
                    // not a second retained copy of the same provenance.
                    دع دالة_بدون_أصول: متغير دالة_ذراع_أربعة_وستون_مشفرة = المشفرة;
                    دع أصول_فارغة: متجه مدى_شفرة_آلة_بأصل = [];
                    دالة_بدون_أصول.أصول_الآلة := أصول_فارغة;
                    دع مواضع_فارغة: متجه متجه طبيعي = [];
                    دالة_بدون_أصول.مواضع_التعليمات := مواضع_فارغة;
                    ألحق(الدوال_المشفرة, دالة_بدون_أصول);
