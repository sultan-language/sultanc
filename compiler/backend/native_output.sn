// B8 هو حد تركيب فقط: Target يقرر اكتمال القدرة، وكل مرحلة لاحقة تبقى عند مالكها.
// كل طبقة تضيف سياقها ولا تحذف خطأ المالك الأدنى.
عام نوع فشل_تخصيص_ذراع_أربعة_وستون =
    | يحتاج_انسكاب بنوع سبب_حاجة_انسكاب
    | فشل_قيود بنوع معرف_سجل_افتراضي
    | حالة_انسكاب_غير_مدعومة بنوع معرف_سجل_افتراضي
    | سياسة_إطار_غير_متاحة بنوع معرف_هدف
    | هدف_غير_صالح بنوع معرف_هدف
;

عام نوع فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون =
    | يحتاج_انسكاب بنوع سبب_حاجة_انسكاب
    | فشل_قيود بنوع معرف_سجل_افتراضي
    | حالة_انسكاب_غير_مدعومة بنوع معرف_سجل_افتراضي
    | سياسة_إطار_غير_متاحة بنوع معرف_هدف
    | هدف_غير_صالح بنوع معرف_هدف
;

عام نوع فشل_إصدار_كائن_ذراع =
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | خطأ_ماتشو بنوع خطأ_ماتشو
    | خطأ_إلف بنوع خطأ_إلف
    | خطأ_كوف بنوع خطأ_كوف
;

عام نوع فشل_إصدار_كائن_إكس =
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | هدف_غير_متطابق بنوع معرف_هدف
    | خطأ_إلف بنوع خطأ_إلف
    | خطأ_كوف بنوع خطأ_كوف
    | خطأ_ماتشو بنوع خطأ_ماتشو_إكس
;

عام نوع فشل_حل_دخول_أصلي =
    | دالة_مسير_مفقودة بنوع معرف_دالة_مسير
    | واجهة_دخول_غير_متاحة بنوع (معرف_دالة_مسير, خطأ_حل_واجهة_اختيار)
    | هدف_دخول_غير_متاح بنوع معرف_هدف
    | مهايئ_دخول_مطلوب بنوع معرف_دالة_مسير
;

عام نوع فشل_مخرج_أصلي =
    | قدرة_مخرج_غير_متاحة بنوع معرف_هدف
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | دخول_تنفيذي بنوع فشل_حل_دخول_أصلي
    | اختيار بنوع فشل_شفرة_منتقاة_أصلية
    | اختيار_غير_متطابق بنوع معرف_هدف
    | تخصيص_ذراع بنوع فشل_تخصيص_ذراع_أربعة_وستون
    | ترميز_ذراع بنوع خطأ_ترميز_ذراع_أربعة_وستون
    | كائن_ذراع بنوع فشل_إصدار_كائن_ذراع
    | تخصيص_إكس بنوع فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون
    | ترميز_إكس بنوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
    | كائن_إكس بنوع فشل_إصدار_كائن_إكس
    | اختيار_ويب_أسمبلي بنوع خطأ_اختيار_ويب_أسمبلي
    | كائن_ويب_أسمبلي بنوع خطأ_كائن_ويب_أسمبلي
    | تخطيط_عام_غير_مكتمل بنوع معرف_عام_مسير
    | تهيئة_عام_غير_مدعومة بنوع معرف_عام_مسير
;

عام نوع نتيجة_مخرج_أصلي =
    | نجح بنوع متجه ط8
    | أخفق بنوع فشل_مخرج_أصلي
;

عام نوع نتيجة_مخرج_أصلي_مفصل =
    | نجح بنوع ناتج_كائن_أصلي_مفصل
    | أخفق بنوع فشل_مخرج_أصلي
;

نوع نتيجة_حل_دخول_أصلي =
    | بلا_دخول
    | تصدير_مباشر بنوع معرف_دالة_منتقاة
    | أخفق بنوع فشل_حل_دخول_أصلي
;

عام نوع نتيجة_مادة_عوام_أصلية =
    | نجحت
    | أخفقت بنوع فشل_مخرج_أصلي
;

عرف ألحق_قيمة_عددية_عامة(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي,
    الحجم: طبيعي,
    الترتيب: ترتيب_بايت
): منطقي {
    إذا (الحجم == 0 || الحجم > 8) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        دع إزاحة_البايت: طبيعي;
        طابق الترتيب مع
        | ترتيب_بايت.صغير -> { إزاحة_البايت := ف; }
        | ترتيب_بايت.كبير -> { إزاحة_البايت := الحجم - 1 - ف; };
        دع القاسم: متغير طبيعي = 1;
        دع ب: متغير طبيعي = 0;
        طالما (ب < إزاحة_البايت) { القاسم := القاسم * 256; ب := ب + 1; }
        دع المقسوم: طبيعي = القيمة / القاسم;
        دع قيمة_البايت: طبيعي = المقسوم % 256;
        دع البايت: ط8 = قيمة_البايت مثل ط8;
        ألحق(*البايتات, البايت);
        ف := ف + 1;
    }
    أرجع صواب;
}


// A vector header and all nested backing arrays belong to one global symbol.
// Every pointer field is a symbolic relocation into that same object's data.
// No embedded runtime and no independent backing-symbol identity is needed.
عرف اكتب_قيمة_عامة_في(
    البايتات: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي,
    الحجم: طبيعي, الترتيب: ترتيب_بايت
): منطقي {
    إذا (الحجم == 0 || الحجم > 8 || الموضع > (الطول(*البايتات) مثل طبيعي)
        || الحجم > (الطول(*البايتات) مثل طبيعي) - الموضع) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        دع إزاحة_البايت: طبيعي;
        طابق الترتيب مع
        | ترتيب_بايت.صغير -> { إزاحة_البايت := ف; }
        | ترتيب_بايت.كبير -> { إزاحة_البايت := الحجم - 1 - ف; };
        دع المقسوم: متغير طبيعي = القيمة;
        دع ب: متغير طبيعي = 0;
        طالما (ب < إزاحة_البايت) { المقسوم := المقسوم / 256; ب := ب + 1; }
        (*البايتات)[الموضع + ف] := (المقسوم % 256) مثل ط8;
        ف := ف + 1;
    }
    أرجع صواب;
}

// Pointer-sized static data (vector headers, function addresses) is
// materialized for the 64-bit native targets and for wasm32.
عرف عرض_مؤشر_عام_مدعوم(العرض: طبيعي): منطقي {
    أرجع العرض == 64 || العرض == 32;
}

عرف حاذ_بيانات_عامة(القيمة: طبيعي, المحاذاة: طبيعي): طبيعي {
    إذا (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: طبيعي = القيمة % المحاذاة;
    إذا (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + المحاذاة - الباقي;
}

عرف اكتب_متجه_عام_أصلي(
    العناصر: &متجه ثابت_مسير, نوع_المتجه: معرف_نوع,
    موضع_الرأس: طبيعي, معرف_العام: معرف_عام_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية, الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البايتات: &متغير متجه ط8, الإزاحات: &متغير متجه طلب_إزاحة_بيانات_كائن,
    المحاذاة_القصوى: &متغير طبيعي
): منطقي {
    دع عرض_المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر;
    إذا (!عرض_مؤشر_عام_مدعوم(عرض_المؤشر)) { أرجع خطأ; };
    دع حجم_المؤشر: طبيعي = عرض_المؤشر / 8;
    دع العدد: طبيعي = الطول(*العناصر) مثل طبيعي;
    إذا (موضع_الرأس > (الطول(*البايتات) مثل طبيعي)
        || 3 * حجم_المؤشر > (الطول(*البايتات) مثل طبيعي) - موضع_الرأس) {
        أرجع خطأ;
    };
    دع نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_تسلسل_دلالي(&(*الحقائق).الأنواع, نوع_المتجه) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { نوع_العنصر := القيمة; };
    دع تخطيط_العنصر: واصف_تخطيط;
    طابق حل_تخطيط_نوع(&(*الحقائق).الأنواع, الهدف, سجل_التخطيط, نوع_العنصر) مع
    | نتيجة_تخطيط.مكتمل(القيمة) -> { تخطيط_العنصر := القيمة; }
    | _ -> { أرجع خطأ; };
    إذا (تخطيط_العنصر.الحجم == 0 || تخطيط_العنصر.المحاذاة == 0) { أرجع خطأ; };
    إذا (تخطيط_العنصر.المحاذاة > *المحاذاة_القصوى) {
        *المحاذاة_القصوى := تخطيط_العنصر.المحاذاة;
    };
    إذا (!اكتب_قيمة_عامة_في(البايتات, موضع_الرأس + حجم_المؤشر,
        العدد, حجم_المؤشر, (*الهدف).نموذج_البيانات.ترتيب_البايت)
        || !اكتب_قيمة_عامة_في(البايتات, موضع_الرأس + 2 * حجم_المؤشر,
        العدد, حجم_المؤشر, (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
    إذا (العدد == 0) { أرجع صواب; };
    دع الحجم_الحالي: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع موضع_العناصر: طبيعي = حاذ_بيانات_عامة(الحجم_الحالي, تخطيط_العنصر.المحاذاة);
    إذا (موضع_العناصر < الحجم_الحالي) { أرجع خطأ; };
    // Reject an overflowing array range before extending the object buffer.
    دع أقصى_موضع: طبيعي = 0xFFFFFFFFFFFFFFFF;
    إذا (العدد > (أقصى_موضع - موضع_العناصر) / تخطيط_العنصر.الحجم) { أرجع خطأ; };
    دع موضع_الحشو: متغير طبيعي = الحجم_الحالي;
    طالما (موضع_الحشو < موضع_العناصر) { ألحق(*البايتات, 0 مثل ط8); موضع_الحشو := موضع_الحشو + 1; };
    // Reserve all array elements before recursing: nested backing arrays must
    // not interrupt the contiguous storage of the enclosing vector.
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع ب: متغير طبيعي = 0;
        طالما (ب < تخطيط_العنصر.الحجم) { ألحق(*البايتات, 0 مثل ط8); ب := ب + 1; };
        ف := ف + 1;
    }
    دع مرجع_العام: مرجع_رمز_كائن = مرجع_رمز_كائن.عام(معرف_العام);
    دع طلب: طلب_إزاحة_بيانات_كائن = {
        الموضع: موضع_الرأس, الرمز: مرجع_العام, الإضافة: موضع_العناصر
    };
    ألحق(*الإزاحات, طلب);
    ف := 0;
    طالما (ف < العدد) {
        دع موضع_العنصر: طبيعي = موضع_العناصر + ف * تخطيط_العنصر.الحجم;
        طابق (*العناصر)[ف] مع
        | ثابت_مسير.متجه(المضمنة) -> {
            إذا (!اكتب_متجه_عام_أصلي(&المضمنة, نوع_العنصر, موضع_العنصر,
                معرف_العام, الحقائق, الهدف, سجل_التخطيط, البايتات, الإزاحات,
                المحاذاة_القصوى)) {
                أرجع خطأ;
            };
        }
        | ثابت_مسير.صحيح_موقع(العدد_الموقع) -> {
            إذا (!اكتب_قيمة_عامة_في(البايتات, موضع_العنصر,
                العدد_الموقع مثل طبيعي, تخطيط_العنصر.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
        }
        | ثابت_مسير.صحيح_طبيعي(العدد_الصحيح) -> {
            إذا (!اكتب_قيمة_عامة_في(البايتات, موضع_العنصر,
                العدد_الصحيح, تخطيط_العنصر.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
        }
        | ثابت_مسير.مؤشر_فارغ -> {
            // MSIR verifies the raw-pointer Type. Keep its target width
            // instead of treating null as an integer constant of host size.
            طابق معرف_نوع_أساس_عند(&(*الحقائق).الأنواع, نوع_العنصر) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_27) -> {
                طابق (*الحقائق).الأنواع.الأنواع[مرجع_النوع_27.القيمة] مع
                | نوع_مقنن.مؤشر(_) -> { }
                | _ -> { أرجع خطأ; };
            };
            إذا (تخطيط_العنصر.الحجم != حجم_المؤشر) { أرجع خطأ; };
            // Elements are reserved as zeroed storage above. No relocation:
            // a null pointer must never acquire backing-object provenance.
        }
        | ثابت_مسير.منطق(القيمة) -> {
            دع الخام: طبيعي;
            إذا (القيمة) { الخام := 1; } وإلا { الخام := 0; };
            إذا (!اكتب_قيمة_عامة_في(البايتات, موضع_العنصر,
                الخام, تخطيط_العنصر.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
        }
        | ثابت_مسير.دالة(المعرف) -> {
            إذا (تخطيط_العنصر.الحجم != حجم_المؤشر) { أرجع خطأ; };
            دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المعرف));
            دع الطلب: طلب_إزاحة_بيانات_كائن = {
                الموضع: موضع_العنصر, الرمز: الرمز, الإضافة: 0
            };
            ألحق(*الإزاحات, الطلب);
        }
        | ثابت_مسير.عشري(البايتات_العشرية) -> {
            دع العرض: طبيعي;
            طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, نوع_العنصر) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(البتات) -> { العرض := البتات; };
            إذا (تخطيط_العنصر.الحجم != العرض / 8) { أرجع خطأ; };
            دع الخام: طبيعي;
            طابق بتات_عائم_من_عشري(&البايتات_العشرية, العرض) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(البتات) -> { الخام := البتات; };
            إذا (!اكتب_قيمة_عامة_في(البايتات, موضع_العنصر,
                الخام, تخطيط_العنصر.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت)) { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف مادة_عوام_مسير_للكائن(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المرفقات: &متغير مرفقات_كائن_مشفرة
): نتيجة_مادة_عوام_أصلية {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المسير).المسير.العوام) مثل طبيعي)) {
        دع العام: &عام_مسير = &(*المسير).المسير.العوام[ف];
        دع مستورد: متغير منطقي = خطأ;
        طابق (*العام).الاسم_الخارجي مع
        | اختياري.موجود(الاسم) -> {
            دع البيان: بيانات_خارجية_كائن = {
                المعرف: (*العام).المعرف,
                الاسم: انسخ_اسم_رمز_خارجي_كائن(&الاسم)
            };
            ألحق((*المرفقات).البيانات_الخارجية, البيان);
            مستورد := صواب;
        }
        | اختياري.لا_شيء -> { };
        إذا (!مستورد) {
        دع التخطيط: واصف_تخطيط;
        طابق حل_تخطيط_نوع(&(*حقائق_الخلفية).الأنواع, الهدف, سجل_التخطيط, (*العام).النوع) مع
        | نتيجة_تخطيط.مكتمل(الوصف) -> { التخطيط := الوصف; }
        | نتيجة_تخطيط.مؤجل(_) -> {
            أرجع نتيجة_مادة_عوام_أصلية.أخفقت(
                فشل_مخرج_أصلي.تخطيط_عام_غير_مكتمل((*العام).المعرف)
            );
        }
        | نتيجة_تخطيط.مرفوض(_) -> {
            أرجع نتيجة_مادة_عوام_أصلية.أخفقت(
                فشل_مخرج_أصلي.تخطيط_عام_غير_مكتمل((*العام).المعرف)
            );
        };
        دع البيانات: متغير متجه ط8 = [];
        دع محاذاة_البيانات: متغير طبيعي = التخطيط.المحاذاة;
        دع إزاحات_البيانات: متغير متجه طلب_إزاحة_بيانات_كائن = [];
        دع الخام: متغير طبيعي = 0;
        دع مدعوم: متغير منطقي = صواب;
        طابق (*العام).التهيئة مع
        | ثابت_مسير.منطق(القيمة) -> { إذا (القيمة) { الخام := 1; } وإلا { الخام := 0; }; }
        | ثابت_مسير.صحيح_موقع(القيمة) -> { الخام := القيمة مثل طبيعي; }
        | ثابت_مسير.صحيح_طبيعي(القيمة) -> { الخام := القيمة; }
        | ثابت_مسير.مؤشر_فارغ -> {
            دع عرض_المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر;
            دع حجم_المؤشر: طبيعي = عرض_المؤشر / 8;
            طابق معرف_نوع_أساس_عند(&(*حقائق_الخلفية).الأنواع, (*العام).النوع) مع
            | اختياري.لا_شيء -> { مدعوم := خطأ; }
            | اختياري.موجود(مرجع_النوع_28) -> {
                طابق (*حقائق_الخلفية).الأنواع.الأنواع[مرجع_النوع_28.القيمة] مع
                | نوع_مقنن.مؤشر(_) -> { }
                | _ -> { مدعوم := خطأ; };
            };
            إذا (عرض_المؤشر == 0 || عرض_المؤشر % 8 != 0
                || حجم_المؤشر > 8 || التخطيط.الحجم != حجم_المؤشر) {
                مدعوم := خطأ;
            };
            // The scalar writer below serializes exactly pointer-width zero
            // bytes without a relocation or integer-to-pointer coercion.
        }
        | ثابت_مسير.دالة(المعرف) -> {
            دع حجم_المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
            إذا (!عرض_مؤشر_عام_مدعوم((*الهدف).نموذج_البيانات.عرض_المؤشر)
                || التخطيط.الحجم != حجم_المؤشر) {
                مدعوم := خطأ;
            } وإلا {
                دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المعرف));
                دع الطلب: طلب_إزاحة_بيانات_كائن = {
                    الموضع: 0, الرمز: الرمز, الإضافة: 0
                };
                ألحق(إزاحات_البيانات, الطلب);
                دع ب: متغير طبيعي = 0;
                طالما (ب < حجم_المؤشر) { ألحق(البيانات, 0 مثل ط8); ب := ب + 1; };
            };
        }
        | ثابت_مسير.عشري(البايتات_العشرية) -> {
            دع العرض: متغير طبيعي = 0;
            طابق بتات_عائم_للاختيار(&(*حقائق_الخلفية).الأنواع, (*العام).النوع) مع
            | اختياري.لا_شيء -> { مدعوم := خطأ; }
            | اختياري.موجود(البتات) -> { العرض := البتات; };
            إذا (مدعوم) {
                إذا (التخطيط.الحجم != العرض / 8) {
                    مدعوم := خطأ;
                } وإلا {
                    طابق بتات_عائم_من_عشري(&البايتات_العشرية, العرض) مع
                    | اختياري.لا_شيء -> { مدعوم := خطأ; }
                    | اختياري.موجود(البتات) -> { الخام := البتات; };
                };
            };
        }
        | ثابت_مسير.متجه(العناصر) -> {
            // A nonempty mutable vector cannot own statically allocated backing:
            // growth/release must never free object storage.
            إذا ((*العام).قابل_للكتابة && (الطول(العناصر) مثل طبيعي) != 0) {
                مدعوم := خطأ;
            } وإلا {
                دع حجم_المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
                إذا (!عرض_مؤشر_عام_مدعوم((*الهدف).نموذج_البيانات.عرض_المؤشر)
                    || التخطيط.الحجم != حجم_المؤشر * 3
                    || التخطيط.المحاذاة != حجم_المؤشر) {
                    مدعوم := خطأ;
                } وإلا {
                    دع ب: متغير طبيعي = 0;
                    طالما (ب < التخطيط.الحجم) { ألحق(البيانات, 0 مثل ط8); ب := ب + 1; };
                    مدعوم := اكتب_متجه_عام_أصلي(
                        &العناصر, (*العام).النوع, 0, (*العام).المعرف,
                        حقائق_الخلفية, الهدف, سجل_التخطيط,
                        &متغير البيانات, &متغير إزاحات_البيانات,
                        &متغير محاذاة_البيانات
                    );
                };
            };
        }
        | ثابت_مسير.نص(بايتات_النص) -> {
            // Static text and byte vectors share the target sequence layout;
            // storage remains attached to the owning global symbol.
            دع عدد_البايتات: طبيعي = الطول(بايتات_النص) مثل طبيعي;
            إذا ((*العام).قابل_للكتابة && عدد_البايتات != 0) {
                مدعوم := خطأ;
            } وإلا {
                دع حجم_المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
                إذا (!عرض_مؤشر_عام_مدعوم((*الهدف).نموذج_البيانات.عرض_المؤشر)
                    || التخطيط.الحجم != حجم_المؤشر * 3
                    || التخطيط.المحاذاة != حجم_المؤشر) {
                    مدعوم := خطأ;
                } وإلا {
                    دع ب: متغير طبيعي = 0;
                    طالما (ب < التخطيط.الحجم) { ألحق(البيانات, 0 مثل ط8); ب := ب + 1; };
                    مدعوم := اكتب_قيمة_عامة_في(&متغير البيانات, حجم_المؤشر,
                        عدد_البايتات, حجم_المؤشر, (*الهدف).نموذج_البيانات.ترتيب_البايت)
                        && اكتب_قيمة_عامة_في(&متغير البيانات, 2 * حجم_المؤشر,
                        عدد_البايتات, حجم_المؤشر, (*الهدف).نموذج_البيانات.ترتيب_البايت);
                    إذا (مدعوم && عدد_البايتات != 0) {
                        دع الموضع: طبيعي = الطول(البيانات) مثل طبيعي;
                        دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.عام((*العام).المعرف);
                        دع الطلب: طلب_إزاحة_بيانات_كائن = {
                            الموضع: 0, الرمز: المرجع, الإضافة: الموضع
                        };
                        ألحق(إزاحات_البيانات, الطلب);
                        دع فهرس_بايت: متغير طبيعي = 0;
                        طالما (فهرس_بايت < عدد_البايتات) {
                            ألحق(البيانات, بايتات_النص[فهرس_بايت]);
                            فهرس_بايت := فهرس_بايت + 1;
                        }
                    };
                };
            };
        };
        // Scalar constants are encoded at the declared width. Aggregate
        // constants already produced their complete layout-sized byte image.
        إذا (مدعوم && (الطول(البيانات) مثل طبيعي) == 0) {
            مدعوم := ألحق_قيمة_عددية_عامة(
                &متغير البيانات, الخام, التخطيط.الحجم,
                (*الهدف).نموذج_البيانات.ترتيب_البايت
            );
        };
        إذا (!مدعوم) {
            أرجع نتيجة_مادة_عوام_أصلية.أخفقت(
                فشل_مخرج_أصلي.تهيئة_عام_غير_مدعومة((*العام).المعرف)
            );
        };
        دع معرف_العام: معرف_عام_مسير = (*العام).المعرف;
        دع قابل_للكتابة: منطقي = (*العام).قابل_للكتابة;
        دع مادة: بيانات_عام_كائن = {
            المعرف: معرف_العام,
            البيانات: البيانات,
            المحاذاة: محاذاة_البيانات,
            قابل_للكتابة: قابل_للكتابة,
            الإزاحات: إزاحات_البيانات
        };
        ألحق((*المرفقات).البيانات_العامة, مادة);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_مادة_عوام_أصلية.نجحت();
}

// Add linker-owned data names to the same target symbol table as imported
// functions and startup symbols. Each name has exactly one canonical ID.
عرف سجل_أسماء_بيانات_خارجية_أصلية(
    المرفقات: &مرفقات_كائن_مشفرة,
    الرموز_الخارجية: &متغير متجه متجه ط8
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المرفقات).البيانات_الخارجية) مثل طبيعي)) {
        دع الاسم: &متجه ط8 = &(*المرفقات).البيانات_الخارجية[ف].الاسم;
        دع موجود: متغير منطقي = خطأ;
        دع س: متغير طبيعي = 0;
        طالما (س < (الطول(*الرموز_الخارجية) مثل طبيعي)) {
            إذا (اسما_رمز_خارجي_كائن_متساويان(الاسم, &(*الرموز_الخارجية)[س])) {
                موجود := صواب;
            };
            س := س + 1;
        }
        إذا (!موجود) { ألحق(*الرموز_الخارجية, انسخ_اسم_رمز_خارجي_كائن(الاسم)); };
        ف := ف + 1;
    }
}

عرف حل_دخول_أصلي(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_بدء_البرنامج: اختياري معرف_دالة_مسير
): نتيجة_حل_دخول_أصلي {
    طابق دالة_بدء_البرنامج مع
    | اختياري.لا_شيء -> { أرجع نتيجة_حل_دخول_أصلي.بلا_دخول(); }
    | اختياري.موجود(المعرف) -> {
        طابق ابحث_دالة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
            دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.دالة_مسير_مفقودة(المفقود);
            أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
        }
        | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
            طابق حل_واجهة_عرض_دالة_مسير_للهدف(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &العرض
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.واجهة_دخول_غير_متاحة(المعرف, الخطأ);
                أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
            }
            | نتيجة.نجح(خطة_الواجهة) -> {
                طابق حل_دخول_تنفيذي_للهدف(الهدف, &خطة_الواجهة) مع
                | نتيجة_حل_دخول_تنفيذي_هدف.غير_متاح(معرف_الهدف) -> {
                    دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.هدف_دخول_غير_متاح(معرف_الهدف);
                    أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
                }
                | نتيجة_حل_دخول_تنفيذي_هدف.متاح(الخطة) -> {
                    طابق الخطة.الأسلوب مع
                    | أسلوب_دخول_تنفيذي_هدف.تصدير_مباشر -> {
                        دع المنتقاة: معرف_دالة_منتقاة = معرف_دالة_منتقاة_من_مسير(المعرف);
                        أرجع نتيجة_حل_دخول_أصلي.تصدير_مباشر(المنتقاة);
                    }
                    | أسلوب_دخول_تنفيذي_هدف.يحتاج_مهايئ -> {
                        دع الفشل: فشل_حل_دخول_أصلي = فشل_حل_دخول_أصلي.مهايئ_دخول_مطلوب(المعرف);
                        أرجع نتيجة_حل_دخول_أصلي.أخفق(الفشل);
                    };
                };
            };
        };
    };
}

// المسار المتدرج يحتفظ فقط بالناتج المشفر والملخصات المطلوبة للكائن عبر الدوال.
// selected/allocated machine IR يبقيان محليين للدالة الحالية فقط.
عرف ابن_مخرج_ذراع_متدرج(
    المسير: &سياق_مستهلك_مسير,
    خريطة_المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    الدوال_المطلوبة: &متجه منطقي
): نتيجة_مخرج_أصلي_مفصل {
    دع تصحيح_الآلة: متغير سياق_تصحيح_آلة = هيئ_سياق_تصحيح_آلة();
    دع سياق_الفك: متغير سياق_معلومات_إطار_النداء = سياق_معلومات_إطار_النداء_جديد();
    دع الرموز_الخارجية: متغير متجه متجه ط8 = أسماء_الدوال_الخارجية_مسير(المسير);
    دع الدوال_المشفرة: متغير متجه دالة_ذراع_أربعة_وستون_مشفرة = [];
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
    | اختياري.موجود(المعرف) -> {
        المرفقات.منشئ_الوحدة := اختياري.موجود(معرف_دالة_منتقاة_من_مسير(المعرف));
    }
    | اختياري.لا_شيء -> { };
    طابق مادة_عوام_مسير_للكائن(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير المرفقات) مع
    | نتيجة_مادة_عوام_أصلية.نجحت -> { }
    | نتيجة_مادة_عوام_أصلية.أخفقت(الفشل) -> { أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل); };
    سجل_أسماء_بيانات_خارجية_أصلية(&المرفقات, &متغير الرموز_الخارجية);
    دع العدد: طبيعي = عدد_دوال_مسير(المسير);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع مطلوبة_هنا: منطقي = ف < (الطول(*الدوال_المطلوبة) مثل طبيعي) && (*الدوال_المطلوبة)[ف];
        دع تبديل_سياق_هنا: منطقي = مطلوبة_هنا && هي_دالة_تبديل_سياق_مسير(المسير, معرف_دالة_مسير_من(ف));
        إذا (تبديل_سياق_هنا) {
            دع كلمات_الروتين: متجه طبيعي = كلمات_تبديل_سياق_المهام_ذراع();
            دع الكلمات: متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة = [];
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول(كلمات_الروتين) مثل طبيعي)) {
                دع الكلمة: كلمة_ذراع_أربعة_وستون_مشفرة = { القيمة: كلمات_الروتين[ك] };
                ألحق(الكلمات, الكلمة);
                ك := ك + 1;
            }
            دع بلا_تثبيتات: متجه تثبيت_ذراع_أربعة_وستون = [];
            دع بلا_أصول: متجه مدى_شفرة_آلة_بأصل = [];
            دع بلا_أحداث: متجه حدث_فك_المكدس = [];
            دع بلا_مواضع: متجه متجه طبيعي = [];
            دع الروتين: دالة_ذراع_أربعة_وستون_مشفرة = {
                المعرف: معرف_دالة_منتقاة_من_مسير(معرف_دالة_مسير_من(ف)),
                الكلمات: الكلمات,
                التثبيتات: بلا_تثبيتات,
                أصول_الآلة: بلا_أصول,
                أحداث_فك_المكدس: بلا_أحداث,
                مواضع_التعليمات: بلا_مواضع
            };
            ألحق(الدوال_المشفرة, الروتين);
        };
        إذا (مطلوبة_هنا && !تبديل_سياق_هنا) {
        دع المعرف: معرف_دالة_مسير = معرف_دالة_مسير_من(ف);
        طابق هيئ_دالة_منتقاة(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
        | نتيجة_دالة_منتقاة_أصلية.بدائي_مسير_غير_مخفض(البدائي) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي));
        }
        | نتيجة_دالة_منتقاة_أصلية.خطأ(الخطأ) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار(الخطأ));
        }
        | نتيجة_دالة_منتقاة_أصلية.إكس_ستة_وثمانون_أربعة_وستون(_) -> {
            أرجع نتيجة_مخرج_أصلي_مفصل.أخفق(فشل_مخرج_أصلي.اختيار_غير_متطابق((*الهدف).المعرف));
