// نموذج الهدف الدلالي يملك هوية الهدف وتركيبه وحقائق نموذج البيانات فقط.
// تنفيذات الخلفية والواجهة الثنائية والكائن والتشغيل يملكها مجال الخلفية؛ الربط يملكه compiler/link بعد إنتاج الكائن.

عام نوع معرف_هدف = {
    القيمة: غير_موقع
};

عام عرف معرف_هدف_من(القيمة: غير_موقع): معرف_هدف {
    دع المعرف: معرف_هدف = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرفا_هدف_متساويان(أ: معرف_هدف, ب: معرف_هدف): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

// هذه هويات داخلية مقننة. التهجئات الخارجية العربية والإنجليزية تحل إليها
// عند حدود اختيار الهدف ولا تنتشر داخل بقية المترجم.
عام نوع هوية_معمارية =
    | ذراع_أربعة_وستون
    | إكس_ستة_وثمانون_أربعة_وستون
    | إكس_ستة_وثمانون_اثنان_وثلاثون
    | ذراع_سبعة
    | ويب_أسمبلي_اثنان_وثلاثون
    | ويب_أسمبلي_أربعة_وستون
    | رايسك_في_اثنان_وثلاثون
    | رايسك_في_أربعة_وستون
    | إيه_إم_دي_جي_بي_يو
    | إيه_في_آر
    | بي_بي_إف
    | هيكساغون
    | لاناي
    | لونغ_آرتش_أربعة_وستون
    | ميبس_أربعة_وستون
    | إم_إس_بي_أربعمئة_وثلاثون
    | إن_في_بي_تي_إكس_أربعة_وستون
    | باور_بي_سي_أربعة_وستون
    | سبارك_أربعة_وستون
    | سبير_في_أربعة_وستون
    | سيستم_زد
    | في_إي
    | إكس_كور
;

عام نوع هوية_منصة =
    | غير_محددة
    | ماك_أو_إس
    | آي_أو_إس
    | لينكس
    | ويندوز
    | أندرويد
    | فري_بي_إس_دي
    | واسي
    | متصفح
    | عتاد_مباشر
;

عام نوع هوية_بيئة =
    | غير_محددة
    | جنو
    | مسل
    | إم_إس_في_سي
    | إي_إيه_بي_آي
    | إي_إيه_بي_آي_إتش_إف
;

عام نوع ترتيب_بايت =
    | صغير
    | كبير
;

// نموذج بيانات الهدف يصف حقائق الآلة الأساسية فقط، ولا يملك تخطيط الأنواع
// ولا سياسة الواجهة الثنائية ولا تنفيذ الخلفية.
عام نوع نموذج_بيانات_هدف = {
    عرض_المؤشر: غير_موقع,
    ترتيب_البايت: ترتيب_بايت
};

عام نوع معرف_نموذج_بيانات_هدف = {
    القيمة: غير_موقع
};

عام عرف معرفا_نموذج_بيانات_هدف_متساويان(أ: معرف_نموذج_بيانات_هدف, ب: معرف_نموذج_بيانات_هدف): منطقي {
    دع قيمة_أ: غير_موقع = أ.القيمة;
    دع قيمة_ب: غير_موقع = ب.القيمة;
    أرجع قيمة_أ == قيمة_ب;
}

عام نوع معرف_معالج = {
    القيمة: غير_موقع
};

عام نوع معرف_ميزة_معمارية = {
    القيمة: غير_موقع
};

عام نوع اختيار_معمارية = {
    الهوية: هوية_معمارية,
    المعالج: اختيار معرف_معالج,
    الميزات: متجه معرف_ميزة_معمارية
};

عام نوع اختيار_منصة = {
    المنصة: هوية_منصة,
    البيئة: هوية_بيئة
};

عام نوع مستوى_دعم_هدف =
    | مضيف_ذاتي
    | مخرج_متحقق_كليا
    | ترجمة_متقاطعة
    | تجريبي
;

عام نوع هوية_واجهة_ثنائية_هدف =
    | داروين_ذراع_أربعة_وستون
    | سيستم_في_إيه_إيه_إم_دي_أربعة_وستون
    | سلطان_محمولة
;

عام نوع صيغة_كائن_هدف =
    | ماتشو
    | إلف
    | كوف
    | ويب_أسمبلي
    | سبير_في
    | بلا_كائن
;

عام نوع مزود_تشغيل_هدف =
    | داروين
    | لينكس
    | غير_متاح
;

عام نوع هوية_قواعد_سجلات_هدف =
    | داروين_ذراع_أربعة_وستون
    | سيستم_في_إيه_إيه_إم_دي_أربعة_وستون
    | مفوضة_للمزود
;

// هوية واحدة للتركيب الأصلي الذي تحقق سجل Target من اتساقه عند التسجيل.
// المستهلكون يطابقون هذه الهوية بدلا من إعادة إثبات architecture/OS/ABI/object/runtime/register tuple.
عام نوع هوية_تركيب_هدف_أصلي =
    | ذراع_أربعة_وستون_داروين_ماتشو
    | إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف
    | ترجمة_متقاطعة_مفوضة
;

// Backend provider identity is independent from linker-format routing.
// Target keeps only canonical target facts; compiler/link derives linker family from object format.
عام نوع هوية_مزود_خلفية =
    | أصلي
    | إل_إل_في_إم
;

عام نوع نوع_مخرج_آلة_هدف =
    | كائن
    | تجميع
;

عام نوع واصف_هدف = {
    المعرف: معرف_هدف,
    التهجئة: نص,
    الثلاثي_المقنن: نص,
    المعمارية: اختيار_معمارية,
    المنصة: اختيار_منصة,
    نموذج_البيانات: نموذج_بيانات_هدف,
    الواجهة_الثنائية: هوية_واجهة_ثنائية_هدف,
    صيغة_الكائن: صيغة_كائن_هدف,
    مزود_التشغيل: مزود_تشغيل_هدف,
    قواعد_السجلات: هوية_قواعد_سجلات_هدف,
    التركيب_الأصلي: هوية_تركيب_هدف_أصلي,
    نوع_مخرج_الآلة: نوع_مخرج_آلة_هدف,
    الدعم: مستوى_دعم_هدف
};

عام عرف تركيب_الهدف_الأصلي(الهدف: &واصف_هدف): هوية_تركيب_هدف_أصلي {
    دع الوصف: واصف_هدف = *الهدف;
    أرجع الوصف.التركيب_الأصلي;
}

عام عرف معرف_نموذج_بيانات_الهدف(الهدف: &واصف_هدف): معرف_نموذج_بيانات_هدف {
    دع الوصف: واصف_هدف = *الهدف;
    دع المعرف: معرف_نموذج_بيانات_هدف = { القيمة: الوصف.المعرف.القيمة };
    أرجع المعرف;
}

عام نوع نتيجة_حل_هدف =
    | محلول بنوع واصف_هدف
    | غير_مسجل
;
