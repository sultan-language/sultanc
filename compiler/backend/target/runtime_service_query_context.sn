استورد compiler.backend.target.target_model;
استورد compiler.backend.target.native_call_model;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.backend.target.runtime_symbol_query_context;

عرف توقيع_خدمة_بمعاملات(
    المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف,
    الناتج: صنف_قيمة_نداء_أصلي_هدف
): توقيع_نداء_أصلي_هدف {
    ليكن التوقيع: توقيع_نداء_أصلي_هدف = {
        المعاملات: المعاملات,
        الناتج: الناتج,
        متغير_المعاملات: خطأ
    };
    أرجع التوقيع;
}

// التوقيع هو عقد C/Runtime المحايد عن السجلات. ABI الفعلي يحله Target لاحقا.
عام عرف توقيع_خدمة_تشغيل_للهدف(
    الهدف: &واصف_هدف,
    الخدمة: خدمة_تشغيل_هدف
): اختياري توقيع_نداء_أصلي_هدف {
    ليكن و: واصف_هدف = *الهدف;
    طابق و.مزود_التشغيل مع
    | مزود_تشغيل_هدف.داروين -> { }
    | مزود_تشغيل_هدف.لينكس -> { }
    | مزود_تشغيل_هدف.واسي -> { }
    | _ -> {
        // Std implements the storage services on any wasm32 target.
        إذا (!خدمات_الذاكرة_متاحة(الهدف)) { أرجع اختياري.لا_شيء(); };
    };

    طابق الخدمة مع
    | خدمة_تشغيل_هدف.تخصيص_ذاكرة -> {
        ليكن الحجم: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.صحيح_طبيعي_بحجم_المؤشر();
        ليكن المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف = [الحجم];
        ليكن الناتج: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.مؤشر();
        ليكن التوقيع: توقيع_نداء_أصلي_هدف = توقيع_خدمة_بمعاملات(المعاملات, الناتج);
        أرجع اختياري.موجود(التوقيع);
    }
    | خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة -> {
        ليكن المؤشر: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.مؤشر();
        ليكن الحجم: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.صحيح_طبيعي_بحجم_المؤشر();
        ليكن المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف = [المؤشر, الحجم];
        ليكن الناتج: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.مؤشر();
        ليكن التوقيع: توقيع_نداء_أصلي_هدف = توقيع_خدمة_بمعاملات(المعاملات, الناتج);
        أرجع اختياري.موجود(التوقيع);
    }
    | خدمة_تشغيل_هدف.تحرير_ذاكرة -> {
        ليكن المؤشر: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.مؤشر();
        ليكن المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف = [المؤشر];
        ليكن الناتج: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.فراغ();
        ليكن التوقيع: توقيع_نداء_أصلي_هدف = توقيع_خدمة_بمعاملات(المعاملات, الناتج);
        أرجع اختياري.موجود(التوقيع);
    }
    | خدمة_تشغيل_هدف.خروج_العملية -> {
        ليكن الحالة: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.ص32();
        ليكن المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف = [الحالة];
        ليكن الناتج: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.فراغ();
        ليكن التوقيع: توقيع_نداء_أصلي_هدف = توقيع_خدمة_بمعاملات(المعاملات, الناتج);
        أرجع اختياري.موجود(التوقيع);
    };
}
