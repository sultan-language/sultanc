استورد compiler.backend.target.target_model;
استورد compiler.backend.target.native_call_model;
استورد compiler.backend.target.runtime_service_model;

عرف توقيع_خدمة_بمعاملات(
    المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف,
    الناتج: صنف_قيمة_نداء_أصلي_هدف
): توقيع_نداء_أصلي_هدف {
    دع التوقيع: توقيع_نداء_أصلي_هدف = {
        المعاملات: المعاملات,
        الناتج: الناتج,
        متغير_المعاملات: خطأ
    };
    أرجع التوقيع;
}

// التوقيع هو عقد C/Runtime المحايد عن السجلات. ABI الفعلي يحله Target لاحقا.
عام عرف توقيع_خدمة_تشغيل_للهدف(
    الهدف: &واصف_هدف,
    الخدمة: خدمة_تشغيل_هدف
): اختيار توقيع_نداء_أصلي_هدف {
    دع و: واصف_هدف = *الهدف;
    طابق و.مزود_التشغيل مع
    | مزود_تشغيل_هدف.داروين -> { }
    | مزود_تشغيل_هدف.لينكس -> { }
    | _ -> { أرجع اختيار.لا_شيء(); };

    طابق الخدمة مع
    | خدمة_تشغيل_هدف.تخصيص_ذاكرة -> {
        دع الحجم: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.صحيح_غير_موقع_بحجم_المؤشر();
        دع المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف = [الحجم];
        دع الناتج: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.مؤشر();
        دع التوقيع: توقيع_نداء_أصلي_هدف = توقيع_خدمة_بمعاملات(المعاملات, الناتج);
        أرجع اختيار.بعض(التوقيع);
    }
    | خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة -> {
        دع المؤشر: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.مؤشر();
        دع الحجم: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.صحيح_غير_موقع_بحجم_المؤشر();
        دع المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف = [المؤشر, الحجم];
        دع الناتج: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.مؤشر();
        دع التوقيع: توقيع_نداء_أصلي_هدف = توقيع_خدمة_بمعاملات(المعاملات, الناتج);
        أرجع اختيار.بعض(التوقيع);
    }
    | خدمة_تشغيل_هدف.تحرير_ذاكرة -> {
        دع المؤشر: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.مؤشر();
        دع المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف = [المؤشر];
        دع الناتج: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.فراغ();
        دع التوقيع: توقيع_نداء_أصلي_هدف = توقيع_خدمة_بمعاملات(المعاملات, الناتج);
        أرجع اختيار.بعض(التوقيع);
    }
    | خدمة_تشغيل_هدف.خروج_العملية -> {
        دع الحالة: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.ص32();
        دع المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف = [الحالة];
        دع الناتج: صنف_قيمة_نداء_أصلي_هدف = صنف_قيمة_نداء_أصلي_هدف.فراغ();
        دع التوقيع: توقيع_نداء_أصلي_هدف = توقيع_خدمة_بمعاملات(المعاملات, الناتج);
        أرجع اختيار.بعض(التوقيع);
    };
}
