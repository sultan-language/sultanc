استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_primitive_symbol_query_context;
استورد compiler.runtime.primitive_identity;

// تصنيف Target للرموز الخارجية التي قد تظهر عند إنهاء ملف تنفيذي.
// Object يستهلك هذا التصنيف ولا يخمن سياسة Runtime أو المكتبة المضيفة.
عام نوع صنف_رمز_خارجي_تنفيذي_هدف =
    | مكتبة_نظام
    | مكتبة_إل_إل_في_إم
    | بدائي_تشغيل_غير_مضمن
    | غير_معروف
;

عرف متجها_اسم_هدف_متساويان(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    دع س: متجه ط8 = *أ;
    دع ص: متجه ط8 = *ب;
    لو ((الطول(س) مثل طبيعي) != (الطول(ص) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(س) مثل طبيعي)) {
        لو (س[ف] != ص[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف يطابق_اسم_بدائي_تشغيل_تنفيذي(
    الاسم: &متجه ط8,
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): منطقي {
    طابق اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المرشح) -> { أرجع متجها_اسم_هدف_متساويان(الاسم, &المرشح); };
}


عرف يبدأ_اسم_هدف_ب(الاسم: &متجه ط8, البادئة: نص): منطقي {
    دع طول_البادئة: طبيعي = الطول(البادئة) مثل طبيعي;
    لو ((الطول(*الاسم) مثل طبيعي) < طول_البادئة) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_البادئة) {
        لو ((*الاسم)[ف] != البادئة[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// LLVM C API symbols: LLVM* (ELF) or _LLVM* (Mach-O).
عرف اسم_رمز_إل_إل_في_إم_تنفيذي(الاسم: &متجه ط8): منطقي {
    أرجع يبدأ_اسم_هدف_ب(الاسم, «_LLVM») || يبدأ_اسم_هدف_ب(الاسم, «LLVM»);
}

عام عرف صنف_رمز_خارجي_تنفيذي_للهدف(
    الاسم: &متجه ط8,
    الهدف: &واصف_هدف
): صنف_رمز_خارجي_تنفيذي_هدف {
    لو (اسم_رمز_إل_إل_في_إم_تنفيذي(الاسم)) { أرجع صنف_رمز_خارجي_تنفيذي_هدف.مكتبة_إل_إل_في_إم(); };
    لو (يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.طول())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.إلحاق())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.تحرير())) {
        أرجع صنف_رمز_خارجي_تنفيذي_هدف.بدائي_تشغيل_غير_مضمن();
    };
    أرجع صنف_رمز_خارجي_تنفيذي_هدف.مكتبة_نظام();
}
