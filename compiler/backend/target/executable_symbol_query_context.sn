استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.backend.target.host_facility_model;
استورد compiler.backend.target.runtime_symbol_query_context;
استورد compiler.backend.target.host_facility_query_context;
استورد compiler.backend.target.runtime_primitive_symbol_query_context;
استورد compiler.runtime.primitive_identity;

// تصنيف Target للرموز الخارجية التي قد تظهر عند إنهاء ملف تنفيذي.
// Object يستهلك هذا التصنيف ولا يخمن سياسة Runtime أو المكتبة المضيفة.
عام نوع صنف_رمز_خارجي_تنفيذي_هدف =
    | مكتبة_نظام
    | بدائي_تشغيل_غير_مضمن
    | غير_معروف
;

عرف متجها_اسم_هدف_متساويان(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    دع س: متجه غ8 = *أ;
    دع ص: متجه غ8 = *ب;
    لو ((الطول(س) مثل غير_موقع) != (الطول(ص) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(س) مثل غير_موقع)) {
        لو (س[ف] != ص[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف يطابق_اسم_خدمة_تشغيل_تنفيذية(
    الاسم: &متجه غ8,
    الهدف: &واصف_هدف,
    الخدمة: خدمة_تشغيل_هدف
): منطقي {
    طابق اسم_رمز_خدمة_تشغيل_للهدف(الهدف, الخدمة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المرشح) -> { أرجع متجها_اسم_هدف_متساويان(الاسم, &المرشح); };
}

عرف يطابق_اسم_مرفق_مضيف_تنفيذي(
    الاسم: &متجه غ8,
    الهدف: &واصف_هدف,
    المرفق: مرفق_مضيف_هدف
): منطقي {
    طابق اسم_رمز_مرفق_مضيف_للهدف(الهدف, المرفق) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المرشح) -> { أرجع متجها_اسم_هدف_متساويان(الاسم, &المرشح); };
}

عرف يطابق_اسم_بدائي_تشغيل_تنفيذي(
    الاسم: &متجه غ8,
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): منطقي {
    طابق اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المرشح) -> { أرجع متجها_اسم_هدف_متساويان(الاسم, &المرشح); };
}

عام عرف صنف_رمز_خارجي_تنفيذي_للهدف(
    الاسم: &متجه غ8,
    الهدف: &واصف_هدف
): صنف_رمز_خارجي_تنفيذي_هدف {
    لو (يطابق_اسم_خدمة_تشغيل_تنفيذية(الاسم, الهدف, خدمة_تشغيل_هدف.تخصيص_ذاكرة())
        || يطابق_اسم_خدمة_تشغيل_تنفيذية(الاسم, الهدف, خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة())
        || يطابق_اسم_خدمة_تشغيل_تنفيذية(الاسم, الهدف, خدمة_تشغيل_هدف.تحرير_ذاكرة())
        || يطابق_اسم_خدمة_تشغيل_تنفيذية(الاسم, الهدف, خدمة_تشغيل_هدف.خروج_العملية())) {
        أرجع صنف_رمز_خارجي_تنفيذي_هدف.مكتبة_نظام();
    };

    لو (يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.فتح_ملف_بوزكس())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.قراءة_بوزكس())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.كتابة_بوزكس())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.إغلاق_بوزكس())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.فتح_دليل_بوزكس())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.قراءة_دليل_بوزكس())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.إغلاق_دليل_بوزكس())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.إزالة_مسار_بوزكس())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.طول_سلسلة_صفرية())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.نسخ_ذاكرة())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.مقارنة_ذاكرة())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.فتح_تيار_سي())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.تحريك_تيار_سي())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.موضع_تيار_سي())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.قراءة_تيار_سي())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.كتابة_تيار_سي())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.إغلاق_تيار_سي())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.مؤشر_خطأ_النظام())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.مؤشر_عدد_وسائط_العملية())
        || يطابق_اسم_مرفق_مضيف_تنفيذي(الاسم, الهدف, مرفق_مضيف_هدف.مؤشر_وسائط_العملية())) {
        أرجع صنف_رمز_خارجي_تنفيذي_هدف.مكتبة_نظام();
    };

    لو (يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.طول())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.إلحاق())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.تحرير())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.فتح_ملف_للقراءة())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.قراءة_بايت_ملف())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.قراءة_مقطع_ملف())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.إنشاء_ملف_للكتابة())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.كتابة_مقطع_ملف())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.إغلاق_ملف())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.فتح_دليل())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.قراءة_مدخل_دليل())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.إغلاق_دليل())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.قراءة_بايت_الدخل_القياسي())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.كتابة_بايتات_تنفيذية())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.كتابة_الخرج_القياسي())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.كتابة_الخطأ_القياسي())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.معمارية_المضيف())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.منصة_المضيف())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.بيئة_المضيف())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.عدد_الوسائط())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.الوصول_إلى_وسيط())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.خروج_العملية())
        || يطابق_اسم_بدائي_تشغيل_تنفيذي(الاسم, الهدف, هوية_بدائي_مترجم.نص_من_بايتات())) {
        أرجع صنف_رمز_خارجي_تنفيذي_هدف.بدائي_تشغيل_غير_مضمن();
    };
    أرجع صنف_رمز_خارجي_تنفيذي_هدف.مكتبة_نظام();
}
