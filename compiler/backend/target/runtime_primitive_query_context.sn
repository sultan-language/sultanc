استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_runtime_mapping;
استورد compiler.runtime.service_identity;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.backend.target.runtime_service_query_context;
استورد compiler.backend.target.runtime_symbol_query_context;
استورد compiler.backend.target.host_facility_model;
استورد compiler.backend.target.host_facility_query_context;

// Runtime يملك علاقة البدائي بالخدمة الدلالية. هذا الملف يملك فقط إسقاط تلك
// الخدمة على اعتمادات مزود Target المختار، ولا يعيد بناء خريطة البدائيات.
عام نوع اعتماد_ربط_بدائي_هدف =
    | خدمة_تشغيل بنوع خدمة_تشغيل_هدف
    | مرفق_مضيف بنوع مرفق_مضيف_هدف
;

عام نوع خطة_ربط_بدائي_هدف = {
    البدائي: هوية_بدائي_مترجم,
    الاعتمادات: متجه اعتماد_ربط_بدائي_هدف
};

عرف أضف_خدمة_بدائي(
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    الخدمة: خدمة_تشغيل_هدف
): فراغ {
    دع الاعتماد: اعتماد_ربط_بدائي_هدف = اعتماد_ربط_بدائي_هدف.خدمة_تشغيل(الخدمة);
    دع الحالة: متغير متجه اعتماد_ربط_بدائي_هدف = *الاعتمادات;
    ألحق(الحالة, الاعتماد);
    *الاعتمادات := الحالة;
}

عرف أضف_مرفق_بدائي(
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    المرفق: مرفق_مضيف_هدف
): فراغ {
    دع الاعتماد: اعتماد_ربط_بدائي_هدف = اعتماد_ربط_بدائي_هدف.مرفق_مضيف(المرفق);
    دع الحالة: متغير متجه اعتماد_ربط_بدائي_هدف = *الاعتمادات;
    ألحق(الحالة, الاعتماد);
    *الاعتمادات := الحالة;
}

عرف خدمة_بدائي_متاحة(الهدف: &واصف_هدف, الخدمة: خدمة_تشغيل_هدف): منطقي {
    طابق توقيع_خدمة_تشغيل_للهدف(الهدف, الخدمة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(_) -> { };
    طابق اسم_رمز_خدمة_تشغيل_للهدف(الهدف, الخدمة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(_) -> { أرجع صواب; };
}

عرف مرفق_بدائي_متاح(الهدف: &واصف_هدف, المرفق: مرفق_مضيف_هدف): منطقي {
    طابق توقيع_مرفق_مضيف_للهدف(الهدف, المرفق) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(_) -> { };
    طابق اسم_رمز_مرفق_مضيف_للهدف(الهدف, المرفق) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(_) -> { أرجع صواب; };
}

عرف اعتمادات_بدائي_متاحة(
    الهدف: &واصف_هدف,
    الاعتمادات: &متجه اعتماد_ربط_بدائي_هدف
): منطقي {
    دع القائمة: متجه اعتماد_ربط_بدائي_هدف = *الاعتمادات;
    دع عدد_الاعتمادات: غير_موقع = الطول(القائمة) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الاعتمادات) {
        دع مرجع_الاعتماد: &اعتماد_ربط_بدائي_هدف = &القائمة[ف];
        طابق *مرجع_الاعتماد مع
        | اعتماد_ربط_بدائي_هدف.خدمة_تشغيل(الخدمة) -> {
            لو (!خدمة_بدائي_متاحة(الهدف, الخدمة)) { أرجع خطأ; };
        }
        | اعتماد_ربط_بدائي_هدف.مرفق_مضيف(المرفق) -> {
            لو (!مرفق_بدائي_متاح(الهدف, المرفق)) { أرجع خطأ; };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Darwin/ARM64 Runtime image delegates these semantic services to libc/POSIX.
// This is provider policy: the primitive-to-service decision has already happened in Runtime.
عرف أضف_اعتمادات_خدمة_داروين(
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    الخدمة: هوية_خدمة_تشغيل
): منطقي {
    طابق الخدمة مع
    | هوية_خدمة_تشغيل.تخصيص -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة());
    }
    | هوية_خدمة_تشغيل.إعادة_تخصيص -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة());
    }
    | هوية_خدمة_تشغيل.تحرير -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
    }
    | هوية_خدمة_تشغيل.فتح_ملف -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة());
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.فتح_ملف_بوزكس());
    }
    | هوية_خدمة_تشغيل.قراءة_ملف -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.قراءة_بوزكس());
    }
    | هوية_خدمة_تشغيل.كتابة_ملف -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.كتابة_بوزكس());
    }
    | هوية_خدمة_تشغيل.إنشاء_ملف -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة());
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.فتح_ملف_بوزكس());
    }
    | هوية_خدمة_تشغيل.إغلاق_ملف -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إغلاق_بوزكس());
    }
    | هوية_خدمة_تشغيل.فتح_دليل -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة());
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.فتح_دليل_بوزكس());
    }
    | هوية_خدمة_تشغيل.قراءة_مدخل_دليل -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.قراءة_دليل_بوزكس());
    }
    | هوية_خدمة_تشغيل.إغلاق_دليل -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إغلاق_دليل_بوزكس());
    }
    | هوية_خدمة_تشغيل.قراءة_الدخل_القياسي -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.قراءة_بوزكس());
    }
    | هوية_خدمة_تشغيل.كتابة_الخرج_القياسي -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.كتابة_بوزكس());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.كتابة_الخطأ_القياسي -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.كتابة_بوزكس());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.عدد_الوسائط -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_عدد_وسائط_العملية());
    }
    | هوية_خدمة_تشغيل.الوصول_إلى_وسيط -> {
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_عدد_وسائط_العملية());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_وسائط_العملية());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.طول_سلسلة_صفرية());
    }
    | هوية_خدمة_تشغيل.خروج_العملية -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.خروج_العملية());
    }
    | هوية_خدمة_تشغيل.تصنيف_خطأ_نظام -> { }
    | هوية_خدمة_تشغيل.إنشاء_دليل -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة());
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إنشاء_دليل_بوزكس());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.إزالة_ملف -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إزالة_مسار_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.إزالة_دليل -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إزالة_دليل_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.إعادة_تسمية -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إعادة_تسمية_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.نوع_مسار -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.بيانات_مسار_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.حجم_مسار -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.بيانات_مسار_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.وقت_تعديل_مسار -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.بيانات_مسار_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.فتح_مقبض_ملف_للقراءة -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.فتح_ملف_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.إنشاء_مقبض_ملف_للكتابة -> {
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.فتح_ملف_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
    }
    | هوية_خدمة_تشغيل.قراءة_مقطع_مقبض_ملف -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.قراءة_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.كتابة_مقطع_مقبض_ملف -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.كتابة_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.إغلاق_مقبض_ملف -> { أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إغلاق_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.تحريك_مقبض_ملف -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.تحريك_موضع_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.موضع_مقبض_ملف -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.تحريك_موضع_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.مزامنة_مقبض_ملف -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مزامنة_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.وقت_رتيب_نانو -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.ساعة_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.وقت_نظام_نانو -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.ساعة_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.نوم_نانو -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نوم_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.طول_متغير_بيئة -> { أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.متغير_بيئة_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.طول_سلسلة_صفرية()); }
    | هوية_خدمة_تشغيل.قراءة_متغير_بيئة -> { أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.متغير_بيئة_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.طول_سلسلة_صفرية()); }
    | هوية_خدمة_تشغيل.دليل_العمل -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.دليل_العمل_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.طول_سلسلة_صفرية()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.الدليل_المؤقت -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.متغير_بيئة_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.طول_سلسلة_صفرية()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); }
    | هوية_خدمة_تشغيل.تشغيل_عملية -> { أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة()); أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.تشغيل_عملية_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_بيئة_العملية()); }
    | هوية_خدمة_تشغيل.انتظار_عملية -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.انتظار_عملية_بوزكس()); أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام()); }
    | هوية_خدمة_تشغيل.حجم_صفحة_النظام -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.حجم_صفحة_بوزكس()); }
    | هوية_خدمة_تشغيل.خريطة_ذاكرة_النظام -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.خريطة_ذاكرة_بوزكس()); }
    | هوية_خدمة_تشغيل.إلغاء_خريطة_ذاكرة_النظام -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إلغاء_خريطة_ذاكرة_بوزكس()); }
    | هوية_خدمة_تشغيل.حماية_ذاكرة_النظام -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.حماية_ذاكرة_بوزكس()); }
    | هوية_خدمة_تشغيل.قفل_ذاكرة_النظام -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.قفل_ذاكرة_بوزكس()); }
    | هوية_خدمة_تشغيل.إلغاء_قفل_ذاكرة_النظام -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إلغاء_قفل_ذاكرة_بوزكس()); }
    | هوية_خدمة_تشغيل.نصيحة_ذاكرة_النظام -> { أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نصيحة_ذاكرة_بوزكس()); }
    | هوية_خدمة_تشغيل.كتابة_تشخيص -> { أرجع خطأ; }
    | هوية_خدمة_تشغيل.فشل_وقت_تشغيل -> { أرجع خطأ; };
    أرجع صواب;
}

// Linux/x86_64 native Runtime helpers are emitted into the target image and use
// Linux syscalls/process-entry state directly. They therefore require no host
// symbol dependency merely because another provider realizes the same service via libc.
عرف خدمة_مقننة_محلية_في_تشغيل_لينكس(الخدمة: هوية_خدمة_تشغيل): منطقي {
    طابق الخدمة مع
    | هوية_خدمة_تشغيل.تخصيص -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إعادة_تخصيص -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.تحرير -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.فتح_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.قراءة_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.كتابة_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إنشاء_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إغلاق_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.فتح_دليل -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.قراءة_مدخل_دليل -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إغلاق_دليل -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.قراءة_الدخل_القياسي -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.كتابة_الخرج_القياسي -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.كتابة_الخطأ_القياسي -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.عدد_الوسائط -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.الوصول_إلى_وسيط -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.خروج_العملية -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.تصنيف_خطأ_نظام -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إنشاء_دليل -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إزالة_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إزالة_دليل -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إعادة_تسمية -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.نوع_مسار -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.حجم_مسار -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.وقت_تعديل_مسار -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.فتح_مقبض_ملف_للقراءة -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إنشاء_مقبض_ملف_للكتابة -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.قراءة_مقطع_مقبض_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.كتابة_مقطع_مقبض_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إغلاق_مقبض_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.تحريك_مقبض_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.موضع_مقبض_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.مزامنة_مقبض_ملف -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.وقت_رتيب_نانو -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.وقت_نظام_نانو -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.نوم_نانو -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.طول_متغير_بيئة -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.قراءة_متغير_بيئة -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.دليل_العمل -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.الدليل_المؤقت -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.تشغيل_عملية -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.انتظار_عملية -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.حجم_صفحة_النظام -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.خريطة_ذاكرة_النظام -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إلغاء_خريطة_ذاكرة_النظام -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.حماية_ذاكرة_النظام -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.قفل_ذاكرة_النظام -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.إلغاء_قفل_ذاكرة_النظام -> { أرجع صواب; }
    | هوية_خدمة_تشغيل.نصيحة_ذاكرة_النظام -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف أضف_اعتمادات_خدمة_مقننة_للهدف(
    الهدف: &واصف_هدف,
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    الخدمة: هوية_خدمة_تشغيل
): منطقي {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع أضف_اعتمادات_خدمة_داروين(الاعتمادات, الخدمة);
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع خدمة_مقننة_محلية_في_تشغيل_لينكس(الخدمة);
    };
}

عرف أضف_اعتمادات_بدائي_جوهري(
    الهدف: &واصف_هدف,
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    البدائي: هوية_بدائي_مترجم
): منطقي {
    طابق البدائي مع
    | هوية_بدائي_مترجم.طول -> { أرجع صواب; }
    | هوية_بدائي_مترجم.معمارية_المضيف -> { أرجع صواب; }
    | هوية_بدائي_مترجم.منصة_المضيف -> { أرجع صواب; }
    | هوية_بدائي_مترجم.بيئة_المضيف -> { أرجع صواب; }
    | هوية_بدائي_مترجم.نص_من_بايتات -> {
        طابق تركيب_الهدف_الأصلي(الهدف) مع
        | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
            أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة());
            أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.نسخ_ذاكرة());
        }
        | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { };
        أرجع صواب;
    }
    | _ -> { أرجع خطأ; };
}

عرف أضف_اعتمادات_بدائي_مركب(
    الهدف: &واصف_هدف,
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    البدائي: هوية_بدائي_مترجم
): منطقي {
    طابق البدائي مع
    | هوية_بدائي_مترجم.إلحاق -> {
        طابق تركيب_الهدف_الأصلي(الهدف) مع
        | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
            أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة());
        }
        | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { };
        أرجع صواب;
    }
    | هوية_بدائي_مترجم.كتابة_بايتات_تنفيذية -> {
        طابق تركيب_الهدف_الأصلي(الهدف) مع
        | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
            أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تخصيص_ذاكرة());
            أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
            أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.فتح_ملف_بوزكس());
            أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.كتابة_بوزكس());
            أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إغلاق_بوزكس());
            أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.مؤشر_خطأ_النظام());
            أضف_مرفق_بدائي(الاعتمادات, مرفق_مضيف_هدف.إزالة_مسار_بوزكس());
        }
        | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { };
        أرجع صواب;
    }
    | _ -> { أرجع خطأ; };
}

عام عرف خطة_ربط_بدائي_للهدف(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): اختيار خطة_ربط_بدائي_هدف {
    دع الاعتمادات_الأولية: متجه اعتماد_ربط_بدائي_هدف = [];
    دع الاعتمادات: متغير متجه اعتماد_ربط_بدائي_هدف = الاعتمادات_الأولية;
    دع مدعوم: متغير منطقي = خطأ;

    // هذه هي نقطة التوجيه الوحيدة: Runtime يقرر علاقة البدائي، ثم Target
    // يقرر آلية مزود الهدف دون إعادة جدول primitive -> service.
    طابق علاقة_تشغيل_للبدائي(البدائي) مع
    | علاقة_بدائي_بالتشغيل.جوهري -> {
        مدعوم := أضف_اعتمادات_بدائي_جوهري(الهدف, &متغير الاعتمادات, البدائي);
    }
    | علاقة_بدائي_بالتشغيل.خدمة_مطابقة(الخدمة) -> {
        مدعوم := أضف_اعتمادات_خدمة_مقننة_للهدف(الهدف, &متغير الاعتمادات, الخدمة);
    }
    | علاقة_بدائي_بالتشغيل.خدمة_مكيفة(الخدمة) -> {
        مدعوم := أضف_اعتمادات_خدمة_مقننة_للهدف(الهدف, &متغير الاعتمادات, الخدمة);
    }
    | علاقة_بدائي_بالتشغيل.تركيب_خدمات -> {
        مدعوم := أضف_اعتمادات_بدائي_مركب(الهدف, &متغير الاعتمادات, البدائي);
    };

    لو (!مدعوم || !اعتمادات_بدائي_متاحة(الهدف, &الاعتمادات)) {
        أرجع اختيار.لا_شيء();
    };
    دع الخطة: خطة_ربط_بدائي_هدف = {
        البدائي: البدائي,
        الاعتمادات: الاعتمادات
    };
    أرجع اختيار.بعض(الخطة);
}
