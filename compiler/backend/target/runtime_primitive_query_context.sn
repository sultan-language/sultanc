استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_runtime_mapping;
استورد compiler.runtime.service_identity;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.backend.target.runtime_service_query_context;
استورد compiler.backend.target.runtime_symbol_query_context;
استورد compiler.backend.target.runtime_primitive_symbol_query_context;
استورد compiler.backend.target.selection_query_context;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;

// Runtime owns the semantic primitive relation. This file only projects the
// dependencies still required by genuine compiler primitives onto a Target.
عام نوع اعتماد_ربط_بدائي_هدف =
    | خدمة_تشغيل بنوع خدمة_تشغيل_هدف
;

عام نوع خطة_ربط_بدائي_هدف = {
    البدائي: هوية_بدائي_مترجم,
    الاعتمادات: متجه اعتماد_ربط_بدائي_هدف
};

عرف أضف_خدمة_بدائي(
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    الخدمة: خدمة_تشغيل_هدف
): فراغ {
    دع الاعتماد: اعتماد_ربط_بدائي_هدف = اعتماد_ربط_بدائي_هدف.خدمة_تشغيل(الخدمة);
    ألحق(*الاعتمادات, الاعتماد);
}

عرف خدمة_بدائي_متاحة(الهدف: &واصف_هدف, الخدمة: خدمة_تشغيل_هدف): منطقي {
    طابق توقيع_خدمة_تشغيل_للهدف(الهدف, الخدمة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { };
    // Storage services are std functions bound by MSIR (never symbols); a
    // backend fails closed if the providers are not bound. Process exit is
    // std's exit provider, never a runtime service.
    لو (!خدمات_الذاكرة_من_المكتبة_القياسية(الهدف)) { أرجع خطأ; };
    طابق الخدمة مع
    | خدمة_تشغيل_هدف.خروج_العملية -> { أرجع خطأ; }
    | _ -> { أرجع صواب; };
}

عرف اعتمادات_بدائي_متاحة(
    الهدف: &واصف_هدف,
    الاعتمادات: &متجه اعتماد_ربط_بدائي_هدف
): منطقي {
    دع القائمة: متجه اعتماد_ربط_بدائي_هدف = *الاعتمادات;
    دع عدد_الاعتمادات: طبيعي = الطول(القائمة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الاعتمادات) {
        دع مرجع_الاعتماد: &اعتماد_ربط_بدائي_هدف = &القائمة[ف];
        طابق *مرجع_الاعتماد مع
        | اعتماد_ربط_بدائي_هدف.خدمة_تشغيل(الخدمة) -> {
            لو (!خدمة_بدائي_متاحة(الهدف, الخدمة)) { أرجع خطأ; };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Storage-backed primitives (append, release) exist where their storage
// services can be supplied: on WebAssembly only for WASI command modules, on
// every other target exactly where std implements the storage services
// (خدمات_الذاكرة_من_المكتبة_القياسية). Previously this was a list of native
// compositions (arm64 Darwin, x86-64 Linux, wasm32 WASI), so Windows, AArch64
// Linux and x86-64 macOS rejected append and release although std supplies
// their allocator.
عرف خدمات_تخزين_بدائي_متاحة_للهدف(الهدف: &واصف_هدف): منطقي {
    لو ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.ويب_أسمبلي()) {
        لو ((*الهدف).مزود_التشغيل != مزود_تشغيل_هدف.واسي()) { أرجع خطأ; };
    };
    أرجع خدمات_الذاكرة_من_المكتبة_القياسية(الهدف);
}

// Release is the only retained primitive whose lowering still adapts one
// canonical Runtime service. Ordinary runtime exports never enter this path.
عرف أضف_اعتمادات_خدمة_مقننة_للهدف(
    الهدف: &واصف_هدف,
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    الخدمة: هوية_خدمة_تشغيل
): منطقي {
    طابق الخدمة مع
    | هوية_خدمة_تشغيل.تحرير -> {
        لو (!خدمات_تخزين_بدائي_متاحة_للهدف(الهدف)) { أرجع خطأ; };
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.تحرير_ذاكرة());
        أرجع صواب;
    }
    | _ -> { أرجع خطأ; };
}

عرف أضف_اعتمادات_بدائي_جوهري(
    الهدف: &واصف_هدف,
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    البدائي: هوية_بدائي_مترجم
): منطقي {
    طابق البدائي مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> {
        // Direct kernel entry (llvm/lowering.sn; native: x86_64, aarch64 Linux).
        أرجع هدف_نواة_مباشر(الهدف);
    }
    | هوية_بدائي_مترجم.طول -> { أرجع صواب; }
    | هوية_بدائي_مترجم.تبديل_موضعين -> { أرجع صواب; }
    | هوية_بدائي_مترجم.استنساخ -> { أرجع صواب; }
    | هوية_بدائي_مترجم.معمارية_المضيف -> { أرجع صواب; }
    | هوية_بدائي_مترجم.منصة_المضيف -> { أرجع صواب; }
    | هوية_بدائي_مترجم.بيئة_المضيف -> { أرجع صواب; }
    | هوية_بدائي_مترجم.بتات_ع64 -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { أرجع صواب; }
    | هوية_بدائي_مترجم.بتات_ع32 -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { أرجع صواب; }
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> { أرجع يدعم_ذاكرة_خطية_للهدف(الهدف); }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> { أرجع يدعم_ذاكرة_خطية_للهدف(الهدف); }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> { أرجع يدعم_ذاكرة_خطية_للهدف(الهدف); }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> { أرجع يدعم_ذاكرة_خطية_للهدف(الهدف); }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> { أرجع يدعم_ذاكرة_خطية_للهدف(الهدف); }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> { أرجع يدعم_ذاكرة_آلة_للهدف(الهدف); }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> { أرجع يدعم_ذاكرة_آلة_للهدف(الهدف); }
    // Compile-time only: folded or removed by the driver for every target.
    | هوية_بدائي_مترجم.حجم_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.محاذاة_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.فشل_وقت_الترجمة -> { أرجع صواب; }
    // Closure-environment reference counting: every backend lowers these
    // directly on the environment layout (selection_query_context.sn).
    | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> { أرجع صواب; }
    | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> { أرجع صواب; }
    | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> { أرجع صواب; }
    // A vector length store (pop and truncate glue): a header write.
    | هوية_بدائي_مترجم.ضبط_طول_متجه -> { أرجع صواب; }
    // A vector capacity read: a header read.
    | هوية_بدائي_مترجم.سعة_متجه -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عملية_عائمة(العملية) -> { أرجع يدعم_عملية_عائمة_للهدف(الهدف, العملية); }
    // Thread support: every backend lowers the atomics and the closure
    // address conversions; the thread entries exist where std starts
    // threads through them (the Linux clone on direct-kernel targets, a C
    // entry for pthread_create, thr_new and CreateThread elsewhere).
    | هوية_بدائي_مترجم.ذري_حمل -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ذري_خزن -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ذري_تبديل -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ذري_جلب_و -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { أرجع صواب; }
    | هوية_بدائي_مترجم.سياج_ذاكرة -> { أرجع صواب; }
    | هوية_بدائي_مترجم.سرب_قيمة -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عنوان_دالة -> { أرجع صواب; }
    | هوية_بدائي_مترجم.دالة_من_عنوان -> { أرجع صواب; }
    | هوية_بدائي_مترجم.مدخل_سي_لدالة -> { أرجع (*الهدف).صيغة_الكائن != صيغة_كائن_هدف.ويب_أسمبلي(); }
    | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> { أرجع هدف_نواة_لينكس_مباشر(الهدف); }
    // A C call at an address: native code with a C calling convention
    // (64-bit pointers); wasm has no callable addresses.
    | هوية_بدائي_مترجم.نداء_عنوان_سي -> {
        أرجع (*الهدف).صيغة_الكائن != صيغة_كائن_هدف.ويب_أسمبلي() && (*الهدف).نموذج_البيانات.عرض_المؤشر == 64;
    }
    | _ -> { أرجع خطأ; };
}

// Where a float operation lowers to the target's own instructions. sqrt, abs,
// copysign, minimum and maximum do on every target. Integral rounding needs
// the baseline instruction set to have it: AArch64 (FRINTM/FRINTP/FRINTZ/
// FRINTN) and WebAssembly (floor/ceil/trunc/nearest); baseline x86-64 has no
// ROUNDSD (SSE4.1). Fused multiply-add: AArch64 (FMADD), RISC-V with D
// (FMADD.D), POWER (FMADD), z/Architecture (MADBR) and LoongArch (FMADD.D).
// Elsewhere LLVM would call libm's floor or fma, which SultanC executables do
// not link, so std.math selects its exact software forms on those
// architectures (library/std/math/float.sn), as Rust's libm does.
عام عرف يدعم_عملية_عائمة_للهدف(الهدف: &واصف_هدف, العملية: عملية_عائمة_بدائية): منطقي {
    دع المعمارية: هوية_معمارية = (*الهدف).المعمارية.الهوية;
    لو (عملية_عائمة_تقريب_صحيح(العملية)) {
        أرجع المعمارية == هوية_معمارية.ذراع_أربعة_وستون()
            || المعمارية == هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون();
    };
    لو (العملية == عملية_عائمة_بدائية.ضرب_جمع_مدمج()) {
        أرجع المعمارية == هوية_معمارية.ذراع_أربعة_وستون()
            || المعمارية == هوية_معمارية.رايسك_في_أربعة_وستون()
            || المعمارية == هوية_معمارية.باور_بي_سي_أربعة_وستون()
            || المعمارية == هوية_معمارية.سيستم_زد()
            || المعمارية == هوية_معمارية.لونغ_آرتش_أربعة_وستون();
    };
    أرجع صواب;
}

// The linear-memory primitives exist only where the target's machine model is
// one u32-addressed WebAssembly linear memory (wasm32). Backends lower them
// only when this holds; everywhere else they are rejected, never emulated.
عام عرف يدعم_ذاكرة_خطية_للهدف(الهدف: &واصف_هدف): منطقي {
    أرجع (*الهدف).صيغة_الكائن == صيغة_كائن_هدف.ويب_أسمبلي()
        && (*الهدف).نموذج_البيانات.عرض_المؤشر == 32;
}

// Flat machine-memory primitives exist where the target's machine model is a
// flat address space: every non-WebAssembly target with 64- or 32-bit
// pointers. The address operand is a u64; on 32-bit targets its high half is
// zero and the conversion to a pointer drops it.
عام عرف يدعم_ذاكرة_آلة_للهدف(الهدف: &واصف_هدف): منطقي {
    أرجع (*الهدف).صيغة_الكائن != صيغة_كائن_هدف.ويب_أسمبلي()
        && ((*الهدف).نموذج_البيانات.عرض_المؤشر == 64
            || (*الهدف).نموذج_البيانات.عرض_المؤشر == 32);
}

عرف أضف_اعتمادات_بدائي_مركب(
    الهدف: &واصف_هدف,
    الاعتمادات: &متغير متجه اعتماد_ربط_بدائي_هدف,
    البدائي: هوية_بدائي_مترجم
): منطقي {
    طابق البدائي مع
    | هوية_بدائي_مترجم.إلحاق -> {
        لو (!خدمات_تخزين_بدائي_متاحة_للهدف(الهدف)) { أرجع خطأ; };
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة());
        أرجع صواب;
    }
    | هوية_بدائي_مترجم.حجز_سعة_متجه -> {
        لو (!خدمات_تخزين_بدائي_متاحة_للهدف(الهدف)) { أرجع خطأ; };
        أضف_خدمة_بدائي(الاعتمادات, خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة());
        أرجع صواب;
    }
    | _ -> { أرجع خطأ; };
}

عام عرف خطة_ربط_بدائي_للهدف(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): اختياري خطة_ربط_بدائي_هدف {
    طابق اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(_) -> { };
    دع الاعتمادات_الأولية: متجه اعتماد_ربط_بدائي_هدف = [];
    دع الاعتمادات: متغير متجه اعتماد_ربط_بدائي_هدف = الاعتمادات_الأولية;
    دع مدعوم: متغير منطقي = خطأ;

    طابق علاقة_تشغيل_للبدائي(البدائي) مع
    | علاقة_بدائي_بالتشغيل.جوهري -> {
        مدعوم := أضف_اعتمادات_بدائي_جوهري(الهدف, &متغير الاعتمادات, البدائي);
    }
    | علاقة_بدائي_بالتشغيل.خدمة_مكيفة(الخدمة) -> {
        مدعوم := أضف_اعتمادات_خدمة_مقننة_للهدف(الهدف, &متغير الاعتمادات, الخدمة);
    }
    | علاقة_بدائي_بالتشغيل.تركيب_خدمات -> {
        مدعوم := أضف_اعتمادات_بدائي_مركب(الهدف, &متغير الاعتمادات, البدائي);
    };

    لو (!مدعوم || !اعتمادات_بدائي_متاحة(الهدف, &الاعتمادات)) {
        أرجع اختياري.لا_شيء();
    };
    دع الخطة: خطة_ربط_بدائي_هدف = {
        البدائي: البدائي,
        الاعتمادات: الاعتمادات
    };
    أرجع اختياري.موجود(الخطة);
}

// Release (`حرر`) of an affine box adapts the canonical release service: every
// backend lowers it as an ordinary SultanC call to the std release provider
// that MSIR binds as a program fact (`مزودات_تخصيص_الذاكرة.التحرير`, std
// os/allocation.sn), passing the box pointer. The provider ignores addresses
// that are not live heap blocks. Previously both backends emitted a call to
// the retired runtime helper `تشغيل_تحرير`, which nothing defines, so every
// program closing a file, socket or TLS stream failed to link.
// The argument is a storage address: a box, a closure environment, or a
// reference to the first element of a sequence buffer. Releases of owned values reach the backends
// only in this form: the ownership-glue pass rewrites every release of an
// owning value into its drop glue (msir/lowering/ownership_glue.sn), whose
// storage releases are these. Any other argument fails closed.
عام عرف نداء_تحرير_مكيف_للهدف(
    الهدف: &واصف_هدف,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    النداء: &نداء_مسير
): اختياري نداء_مسير {
    طابق خطة_ربط_بدائي_للهدف(الهدف, هوية_بدائي_مترجم.تحرير()) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(_) -> { };
    لو ((الطول((*النداء).الحجج) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
    دع الحجة: معرف_قيمة_مسير = (*النداء).الحجج[0];
    طابق نوع_قيمة_مسير(المسير, الحجة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        دع عنوان_تخزين: متغير منطقي = خطأ;
        طابق نوع_حمولة_صندوق_دلالي(&(*الحقائق).الأنواع, النوع) مع
        | اختياري.موجود(_) -> { عنوان_تخزين := صواب; }
        | اختياري.لا_شيء -> { };
        طابق نوع_داخل_مرجع_دلالي(&(*الحقائق).الأنواع, النوع) مع
        | اختياري.موجود(_) -> { عنوان_تخزين := صواب; }
        | اختياري.لا_شيء -> { };
        // A closure value is the address of its heap environment; the drop
        // glue of function Types releases it once no reference is left.
        طابق عدد_معاملات_دالة_دلالية(&(*الحقائق).الأنواع, النوع) مع
        | اختياري.موجود(_) -> { عنوان_تخزين := صواب; }
        | اختياري.لا_شيء -> { };
        لو (!عنوان_تخزين) { أرجع اختياري.لا_شيء(); };
    };
    طابق (*المسير).المسير.مزودات_تخصيص_الذاكرة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المزودات) -> {
        دع الحجج: متجه معرف_قيمة_مسير = [الحجة];
        دع النطاقات: متجه نطاق_ذاكرة_نداء_مسير = [];
        دع النداء_المكيف: نداء_مسير = {
            الهدف: هدف_نداء_مسير.دالة_سلطان(المزودات.التحرير),
            الحجج: الحجج,
            مكان_التعديل: اختياري.لا_شيء(),
            نطاقات_الذاكرة: النطاقات,
            عقد_النواة: اختياري.لا_شيء()
        };
        أرجع اختياري.موجود(النداء_المكيف);
    };
}

// The same instruction view with its operation replaced by an adapted call;
// result, source origin and debug location are unchanged.
عام عرف عرض_تعليمة_بنداء_مسير(
    التعليمة: &عرض_تعليمة_مسير,
    النداء: نداء_مسير
): عرض_تعليمة_مسير {
    دع العرض: عرض_تعليمة_مسير = {
        الناتج: (*التعليمة).الناتج,
        العملية: عملية_مسير.نداء(النداء),
        الأصل: (*التعليمة).الأصل,
        موقع_التصحيح: (*التعليمة).موقع_التصحيح,
        نطاق_التصحيح: (*التعليمة).نطاق_التصحيح
    };
    أرجع العرض;
}
