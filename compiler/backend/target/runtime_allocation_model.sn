استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.target.runtime_service_model;

// خدمة نظام مباشرة. هذا النموذج يحمل فقط الحقائق التي يحتاجها encoder
// عندما يكون مزود Runtime المختار خدمة نظام ذات سجلات صريحة.
عام نوع خطة_خدمة_نظام_تخصيص_ذاكرة_هدف = {
    سجل_الخدمة: معرف_سجل_فعلي,
    سجل_الناتج: معرف_سجل_فعلي,
    سجل_العنوان: معرف_سجل_فعلي,
    سجل_الحجم: معرف_سجل_فعلي,
    سجل_الحماية: معرف_سجل_فعلي,
    سجل_الأعلام: معرف_سجل_فعلي,
    سجل_الواصف: معرف_سجل_فعلي,
    سجل_الإزاحة: معرف_سجل_فعلي,
    رقم_الخدمة: غير_موقع,
    قيمة_العنوان: غير_موقع,
    قيمة_الحماية: غير_موقع,
    قيمة_الأعلام: غير_موقع,
    قيمة_الواصف: غير_موقع,
    قيمة_الإزاحة: غير_موقع
};

// نداء Runtime رمزي: المعمارية تخفضه كنداء ABI عادي إلى هوية الخدمة،
// بينما Target/Object وحدهما يحلان اسم الرمز الخارجي لصيغة الكائن المختارة.
عام نوع خطة_نداء_رمزي_تخصيص_ذاكرة_هدف = {
    الخدمة: خدمة_تشغيل_هدف
};

// حد تخصيص الذاكرة المشترك بين جميع الأهداف. لا يفرض syscall ولا malloc
// على ISA عامة، ولا يحمل عنوان Runtime داخل MSIR.
عام نوع خطة_تخصيص_ذاكرة_هدف =
    | خدمة_نظام بنوع خطة_خدمة_نظام_تخصيص_ذاكرة_هدف
    | نداء_رمزي بنوع خطة_نداء_رمزي_تخصيص_ذاكرة_هدف
;
