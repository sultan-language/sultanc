استورد compiler.backend.target.target_model;

// Target registry resolves the full native target composition once. Selector consumers
// map that canonical composition identity to the narrow ISA selector capability only.
عام نوع قدرة_منتق_أصلي =
    | ذراع_أربعة_وستون
    | إكس_ستة_وثمانون_أربعة_وستون
    | غير_متاحة
;

عام عرف حل_قدرة_منتق_أصلي(الهدف: &واصف_هدف): قدرة_منتق_أصلي {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع قدرة_منتق_أصلي.ذراع_أربعة_وستون();
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع قدرة_منتق_أصلي.إكس_ستة_وثمانون_أربعة_وستون();
    };
}
