// Target owns the single composition boundary that resolves an implemented ABI
// capability for a registered target. ABI policy remains in the architecture/system owner.
عام نوع خطأ_حل_واجهة_هدف =
    | واجهة_ثنائية_غير_متاحة بنوع معرف_هدف
    | خطأ_واجهة_ثنائية بنوع خطأ_واجهة
;

عام عرف حل_خطة_واجهة_دالة_للهدف(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_هدف {
    دع القيمة: واصف_هدف = *الهدف;
    طابق القيمة.الواجهة_الثنائية مع
    | هوية_واجهة_ثنائية_هدف.داروين_ذراع_أربعة_وستون -> {
        طابق صنف_واجهة_ماك_ذراع_أربعة_وستون_دالة(
            الأنواع,
            الهدف,
            سجل_التخطيط,
            المعاملات,
            الناتج
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.خطأ_واجهة_ثنائية(الخطأ));
        }
        | نتيجة.نجح(الخطة) -> {
            أرجع نتيجة.نجح(الخطة);
        };
    }
    | هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون -> {
        طابق صنف_واجهة_سيستم_في_إيه_إيه_إم_دي_أربعة_وستون_دالة(
            الأنواع,
            الهدف,
            سجل_التخطيط,
            المعاملات,
            الناتج
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.خطأ_واجهة_ثنائية(الخطأ));
        }
        | نتيجة.نجح(الخطة) -> {
            أرجع نتيجة.نجح(الخطة);
        };
    }
    | هوية_واجهة_ثنائية_هدف.إيه_إيه_بي_سي_إس_أربعة_وستون -> {
        طابق صنف_واجهة_إيه_إيه_بي_سي_إس_أربعة_وستون_دالة(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.خطأ_واجهة_ثنائية(الخطأ));
        }
        | نتيجة.نجح(الخطة) -> { أرجع نتيجة.نجح(الخطة); };
    }
    | هوية_واجهة_ثنائية_هدف.سلطان_محمولة -> {
        طابق صنف_واجهة_سلطان_محمولة_دالة(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.خطأ_واجهة_ثنائية(الخطأ));
        }
        | نتيجة.نجح(الخطة) -> { أرجع نتيجة.نجح(الخطة); };
    };
}


// SultanC's internal convention (اتفاقية_نداء_واجهة.داخلية) on SysV AMD64:
// an aggregate argument larger than this many bytes, one pointer, is passed
// as a hidden reference (as Rust's ABI passes large aggregates indirectly,
// PassMode::Indirect). Measured with callgrind on the self-built compiler
// (Ir of run empty/fib/loop/map and check of a 30k-line program): 8 bytes
// beat 16 (two eightbytes, the largest aggregate SysV passes in registers)
// by 0.6-1.6%, and 16 beat 32. The native code keeps aggregates in memory,
// so passing their address saves the loads into two registers and the
// callee's store back into a slot. AAPCS64 keeps its registered plan, which
// already passes a composite larger than 16 bytes by reference.
عام عرف عتبة_مرجع_خفي_للهدف(الهدف: &واصف_هدف): طبيعي {
    أرجع (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
}

// The plan of a call of the given convention: the one entry every backend
// uses for SultanC functions, function values, runtime primitives and
// external functions alike.
// - داخلية: on SysV AMD64 the SysV placement with aggregate arguments larger
//   than عتبة_مرجع_خفي_للهدف as hidden references; on AAPCS64 (Darwin and
//   the delegated targets) the registered plan, which already passes a
//   composite larger than 16 bytes by reference, and on portable targets the
//   portable plan, which passes every aggregate by reference. In all of them
//   an indirect argument is one the callee never writes (نسخة_للمستدعى
//   false).
// - منصة: the registered plan (حل_خطة_واجهة_دالة_للهدف) as before hidden
//   references existed.
// - خارجية: the foreign C plan (حل_خطة_واجهة_دالة_خارجية_للهدف).
عام عرف حل_خطة_واجهة_دالة_باتفاقية_للهدف(
    الاتفاقية: اتفاقية_نداء_واجهة,
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: اختياري معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_هدف {
    طابق الاتفاقية مع
    | اتفاقية_نداء_واجهة.خارجية -> {
        أرجع حل_خطة_واجهة_دالة_خارجية_للهدف(الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج);
    }
    | اتفاقية_نداء_واجهة.منصة -> {
        أرجع حل_خطة_واجهة_دالة_اختيارية_للهدف(الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج);
    }
    | اتفاقية_نداء_واجهة.داخلية -> { };
    دع القيمة: واصف_هدف = *الهدف;
    إذا (القيمة.الواجهة_الثنائية != هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون()) {
        دع الخطة: متغير خطة_دالة_واجهة;
        طابق حل_خطة_واجهة_دالة_اختيارية_للهدف(الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الموجودة) -> { الخطة := الموجودة; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الخطة.المعاملات) مثل طبيعي)) {
            الخطة.المعاملات[ف].التصنيف.نسخة_للمستدعى := خطأ;
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(الخطة);
    };
    دع نوع_الناتج: معرف_نوع;
    طابق الناتج مع
    | اختياري.موجود(النوع) -> { نوع_الناتج := النوع; }
    | اختياري.لا_شيء -> {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.فراغ()) مع
        | اختياري.موجود(نوع_الفراغ) -> { نوع_الناتج := نوع_الفراغ; }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.واجهة_ثنائية_غير_متاحة(القيمة.المعرف));
        };
    };
    طابق صنف_واجهة_سيستم_في_إيه_إيه_إم_دي_أربعة_وستون_داخلية(
        الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج, عتبة_مرجع_خفي_للهدف(الهدف)
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.خطأ_واجهة_ثنائية(الخطأ)); }
    | نتيجة.نجح(الخطة) -> { أرجع نتيجة.نجح(الخطة); };
}

// Target query for ABI-mandated return of an indirect-result address.
// SysV AMD64 returns the hidden sret pointer in the first INTEGER result register;
// Darwin ARM64 has no equivalent returned-pointer requirement here.
عام عرف مرجع_إرجاع_عنوان_ناتج_غير_مباشر_للهدف(
    الهدف: &واصف_هدف
): اختياري مرجع_سجل_واجهة {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع اختياري.لا_شيء();
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_لينكس_إلف -> {
        أرجع اختياري.لا_شيء();
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_ويندوز_كوف -> {
        أرجع اختياري.لا_شيء();
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        دع المرجع: مرجع_سجل_واجهة = مرجع_إرجاع_عنوان_ناتج_غير_مباشر_سيستم_في_إكس();
        أرجع اختياري.موجود(المرجع);
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_داروين_ماتشو -> {
        دع المرجع: مرجع_سجل_واجهة = مرجع_إرجاع_عنوان_ناتج_غير_مباشر_سيستم_في_إكس();
        أرجع اختياري.موجود(المرجع);
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف -> {
        دع المرجع: مرجع_سجل_واجهة = مرجع_إرجاع_عنوان_ناتج_غير_مباشر_سيستم_في_إكس();
        أرجع اختياري.موجود(المرجع);
    }
    | هوية_تركيب_هدف_أصلي.ويب_أسمبلي_اثنان_وثلاثون_وحدة -> { أرجع اختياري.لا_شيء(); }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختياري.لا_شيء(); };
}

// استعلام Backend مقنن لصفة العدد التي يحتاجها اختيار شرط المقارنة؛ المستهلك لا يقرأ نموذج Type مباشرة.
عام نوع صنف_إشارة_عدد_خلفية =
    | موقع
    | طبيعي
;

عام عرف صنف_إشارة_عدد_للاختيار(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري صنف_إشارة_عدد_خلفية {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.عدد -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع());
            }
            | نوع_بدائي_مقنن.ص8 -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع());
            }
            | نوع_بدائي_مقنن.ص16 -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع());
            }
            | نوع_بدائي_مقنن.ص32 -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع());
            }
            | نوع_بدائي_مقنن.ص64 -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع());
            }
            | نوع_بدائي_مقنن.طبيعي -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.طبيعي());
            }
            | نوع_بدائي_مقنن.ط8 -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.طبيعي());
            }
            | نوع_بدائي_مقنن.ط16 -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.طبيعي());
            }
            | نوع_بدائي_مقنن.ط32 -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.طبيعي());
            }
            | نوع_بدائي_مقنن.ط64 -> {
                أرجع اختياري.موجود(صنف_إشارة_عدد_خلفية.طبيعي());
            }
            | _ -> {
                أرجع اختياري.لا_شيء();
            };
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// استعلام Backend مقنن لعرض العدد الدلالي؛ منتقي ISA لا يقرأ نموذج Type مباشرة.
عام عرف بتات_عدد_للاختيار(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري طبيعي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق صنف_النوع_البدائي(البدائي) مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                أرجع اختياري.موجود(بتات_نوع_بدائي(البدائي));
            }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
                أرجع اختياري.موجود(بتات_نوع_بدائي(البدائي));
            }
            | _ -> {
                أرجع اختياري.لا_شيء();
            };
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// عرض القيمة العائمة الدلالي يبقى حقيقة Type/Target query؛ selector لا يقرأ نموذج Type مباشرة.
عام عرف بتات_عائم_للاختيار(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري طبيعي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (صنف_النوع_البدائي(البدائي) != صنف_نوع_بدائي.عشري()) {
                أرجع اختياري.لا_شيء();
            };
            دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
            إذا (البتات == 32 || البتات == 64) { أرجع اختياري.موجود(البتات); };
            أرجع اختياري.لا_شيء();
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// وصف scalar الخاص بتحويلات integer في Backend.
// يختلف عمدا عن وصف الحساب: `حرف` قيمة unsigned بعرض 32 بت ويمكن أن تكون مصدرا
// لـ MSIR `تحويل_صحيح`، لكنها لا تصبح نوعا عدديا للحساب أو المقارنة.
عام نوع وصف_تحويل_صحيح_خلفية = {
    البتات: طبيعي,
    موقع: منطقي
};

عام عرف وصف_نوع_لتحويل_صحيح_للاختيار(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري وصف_تحويل_صحيح_خلفية {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (البدائي == نوع_بدائي_مقنن.حرف()) {
                دع بتات_الحرف: طبيعي = بتات_نوع_بدائي(البدائي);
                دع وصف_الحرف: وصف_تحويل_صحيح_خلفية = {
                    البتات: بتات_الحرف,
                    موقع: خطأ
                };
                أرجع اختياري.موجود(وصف_الحرف);
            };
            طابق بتات_عدد_للاختيار(الأنواع, النوع) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(البتات) -> {
                طابق صنف_إشارة_عدد_للاختيار(الأنواع, النوع) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(الإشارة) -> {
                    دع هل_موقع: متغير منطقي = خطأ;
                    طابق الإشارة مع
                    | صنف_إشارة_عدد_خلفية.موقع -> { هل_موقع := صواب; }
                    | صنف_إشارة_عدد_خلفية.طبيعي -> { };
                    دع وصف_العدد: وصف_تحويل_صحيح_خلفية = {
                        البتات: البتات,
                        موقع: هل_موقع
                    };
                    أرجع اختياري.موجود(وصف_العدد);
                };
            };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// ناتج MSIR الاختياري يتحول هنا إلى هوية الفراغ المقننة عند سؤال ABI؛ selector لا يستورد builtins.
عام عرف حل_خطة_واجهة_دالة_اختيارية_للهدف(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: اختياري معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_هدف {
    طابق الناتج مع
    | اختياري.موجود(النوع) -> {
        أرجع حل_خطة_واجهة_دالة_للهدف(الأنواع, الهدف, سجل_التخطيط, المعاملات, النوع);
    }
    | اختياري.لا_شيء -> {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.فراغ()) مع
        | اختياري.موجود(نوع_الفراغ) -> {
            أرجع حل_خطة_واجهة_دالة_للهدف(الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الفراغ);
        }
        | اختياري.لا_شيء -> {
            دع وصف_الهدف: واصف_هدف = *الهدف;
            أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.واجهة_ثنائية_غير_متاحة(وصف_الهدف.المعرف));
        };
    };
}


// ---- Foreign (external) call boundary ------------------------------------
//
// SultanC keeps its own internal ABI: calls between SultanC functions, std and
// runtime functions resolve through حل_خطة_واجهة_دالة_للهدف (the target's
// registered ABI identity; on delegated targets the portable SultanC ABI).
// Only declared external functions (MSIR الدوال_الخارجية: C libraries, the
// OS interface, WASI imports) cross a foreign boundary, and they resolve here.
// Native and LLVM both use this one entry for external declarations and calls.
//
// Contract per target (each classifier documents its specification and the
// mature implementation it was checked against):
// - Darwin AArch64 and SysV AMD64 targets: their registered ABI already is the
//   platform C ABI (Apple ARM64 / AAPCS64-Darwin, SysV AMD64).
// - Delegated x86-64: SysV AMD64 except on Windows, which uses the Microsoft
//   x64 convention (x86_64/systems/windows).
// - Delegated AArch64 (Linux, Android, FreeBSD, Windows): AAPCS64
//   (arm64/systems/aapcs64).
// - RISC-V (lp64d / ilp32) and LoongArch64 (lp64d): the RISC-V psABI rules
//   (riscv/systems/elf, loongarch/systems/linux).
// - PowerPC64 ELFv2, s390x, MIPS64 n64, SPARC V9 and VE: their ELF ABIs
//   (powerpc64, systemz, mips64, sparc64, ve under architectures/).
// - Every other registered target (32-bit x86 and Arm, WebAssembly, GPUs and
//   microcontrollers) has no implemented C classifier: scalars and pointers
//   pass directly and structures are rejected explicitly instead of being
//   passed by the portable SultanC rule.
// A foreign indirect argument always points to a copy the caller makes for
// that call (the C callee may write through it).
// Previously only the SysV and Darwin targets classified foreign structures;
// every other target rejected structures (and, on RISC-V, PowerPC64, s390x,
// MIPS64, LoongArch64, SPARC64 and VE, integers narrower than 64 bits) because
// the plan could express neither register part types nor extension.

عرف تصنيف_خارجي_محمول_مقبول(التصنيف: &تصنيف_قيمة_واجهة): منطقي {
    إذا ((*التصنيف).الطريقة == طريقة_تمرير_واجهة.متجاهل()) { أرجع صواب; };
    أرجع !(*التصنيف).تجميعي;
}

عرف خطة_خارجية_محمولة_للهدف(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    نوع_الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_هدف {
    دع القيمة: واصف_هدف = *الهدف;
    دع الخطة: خطة_دالة_واجهة;
    طابق صنف_واجهة_سلطان_محمولة_دالة(الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.خطأ_واجهة_ثنائية(الخطأ)); }
    | نتيجة.نجح(القيمة_المصنفة) -> { الخطة := القيمة_المصنفة; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الخطة.المعاملات) مثل طبيعي)) {
        إذا (!تصنيف_خارجي_محمول_مقبول(&الخطة.المعاملات[ف].التصنيف)) {
            أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.واجهة_ثنائية_غير_متاحة(القيمة.المعرف));
        };
        ف := ف + 1;
    }
    إذا (!تصنيف_خارجي_محمول_مقبول(&الخطة.الناتج.التصنيف)) {
        أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.واجهة_ثنائية_غير_متاحة(القيمة.المعرف));
    };
    أرجع نتيجة.نجح(الخطة);
}

عرف خطة_مصنف_خارجي(
    الناتج: نتيجة خطة_دالة_واجهة, خطأ_واجهة
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_هدف {
    طابق الناتج مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.خطأ_واجهة_ثنائية(الخطأ)); }
    | نتيجة.نجح(الخطة) -> { أرجع نتيجة.نجح(الخطة); };
}

عرف صنف_خطة_خارجية_للهدف(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: اختياري معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_هدف {
    دع القيمة: واصف_هدف = *الهدف;
    طابق القيمة.الواجهة_الثنائية مع
    | هوية_واجهة_ثنائية_هدف.سلطان_محمولة -> { }
    | _ -> {
        // Native x86-64 Windows: SultanC calls use the internal System V
        // convention, foreign calls the Microsoft x64 one, placed physically.
        إذا (تركيب_الهدف_الأصلي(الهدف) == هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف()) {
            دع نوع_ناتج_ويندوز: معرف_نوع;
            طابق الناتج مع
            | اختياري.موجود(النوع) -> { نوع_ناتج_ويندوز := النوع; }
            | اختياري.لا_شيء -> {
                طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.فراغ()) مع
                | اختياري.موجود(نوع_الفراغ) -> { نوع_ناتج_ويندوز := نوع_الفراغ; }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.واجهة_ثنائية_غير_متاحة(القيمة.المعرف));
                };
            };
            أرجع خطة_مصنف_خارجي(صنف_واجهة_مايكروسوفت_إكس_أربعة_وستون_أصلية(
                الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_ناتج_ويندوز
            ));
        };
        أرجع حل_خطة_واجهة_دالة_اختيارية_للهدف(الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج);
    };
    دع نوع_الناتج: معرف_نوع;
    طابق الناتج مع
    | اختياري.موجود(النوع) -> { نوع_الناتج := النوع; }
    | اختياري.لا_شيء -> {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.فراغ()) مع
        | اختياري.موجود(نوع_الفراغ) -> { نوع_الناتج := نوع_الفراغ; }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_حل_واجهة_هدف.واجهة_ثنائية_غير_متاحة(القيمة.المعرف));
        };
    };
    طابق القيمة.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        إذا (القيمة.المنصة.المنصة == هوية_منصة.ويندوز()) {
            أرجع خطة_مصنف_خارجي(صنف_واجهة_مايكروسوفت_إكس_أربعة_وستون_خارجية(
                الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
            ));
        };
        أرجع خطة_مصنف_خارجي(صنف_واجهة_سيستم_في_إيه_إيه_إم_دي_أربعة_وستون_دالة(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع خطة_مصنف_خارجي(صنف_واجهة_إيه_إيه_بي_سي_إس_أربعة_وستون_خارجية(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> {
        أرجع خطة_مصنف_خارجي(صنف_واجهة_رايسك_في_خارجية(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | هوية_معمارية.رايسك_في_اثنان_وثلاثون -> {
        أرجع خطة_مصنف_خارجي(صنف_واجهة_رايسك_في_خارجية(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> {
        أرجع خطة_مصنف_خارجي(صنف_واجهة_لونغ_آرتش_أربعة_وستون_خارجية(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> {
        أرجع خطة_مصنف_خارجي(صنف_واجهة_إلف_الثانية_باور_خارجية(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | هوية_معمارية.سيستم_زد -> {
        أرجع خطة_مصنف_خارجي(صنف_واجهة_سيستم_زد_خارجية(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | هوية_معمارية.ميبس_أربعة_وستون -> {
        أرجع خطة_مصنف_خارجي(صنف_واجهة_ميبس_أربعة_وستون_خارجية(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | هوية_معمارية.سبارك_أربعة_وستون -> {
        أرجع خطة_مصنف_خارجي(صنف_واجهة_سبارك_أربعة_وستون_خارجية(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | هوية_معمارية.في_إي -> {
        أرجع خطة_مصنف_خارجي(صنف_واجهة_في_إي_خارجية(
            الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج
        ));
    }
    | _ -> {
        أرجع خطة_خارجية_محمولة_للهدف(الأنواع, الهدف, سجل_التخطيط, المعاملات, نوع_الناتج);
    };
}

عام عرف حل_خطة_واجهة_دالة_خارجية_للهدف(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: اختياري معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_هدف {
    دع الخطة: متغير خطة_دالة_واجهة;
    طابق صنف_خطة_خارجية_للهدف(الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الخطة := القيمة; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الخطة.المعاملات) مثل طبيعي)) {
        إذا (الخطة.المعاملات[ف].التصنيف.الطريقة == طريقة_تمرير_واجهة.غير_مباشر()) {
            الخطة.المعاملات[ف].التصنيف.نسخة_للمستدعى := صواب;
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الخطة);
}

عام عرف تعديل_مكدس_نداء_مع_حجج_للهدف(
    الهدف: &واصف_هدف,
    حجم_الإطار: طبيعي,
    حجم_حجج_المكدس: طبيعي
): اختياري طبيعي {
    دع و: واصف_هدف = *الهدف;
    طابق و.الواجهة_الثنائية مع
    | هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون -> {
        أرجع اختياري.موجود(تعديل_مكدس_نداء_سيستم_في_إكس_مع_حجج(حجم_الإطار, حجم_حجج_المكدس));
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف إزاحة_معامل_مكدس_بعد_إطار_للهدف(
    الهدف: &واصف_هدف,
    حجم_الإطار: طبيعي,
    الموضع: &موضع_مكدس_واجهة
): اختياري طبيعي {
    دع و: واصف_هدف = *الهدف;
    طابق و.الواجهة_الثنائية مع
    | هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون -> {
        أرجع اختياري.موجود(إزاحة_معامل_مكدس_سيستم_في_إكس_بعد_إطار(حجم_الإطار, الموضع));
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف تعديل_مكدس_نداء_لحجم_إطار_للهدف(
    الهدف: &واصف_هدف,
    حجم_الإطار: طبيعي
): اختياري طبيعي {
    دع و: واصف_هدف = *الهدف;
    طابق و.الواجهة_الثنائية مع
    | هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون -> {
        أرجع اختياري.موجود(تعديل_مكدس_نداء_سيستم_في_إكس(حجم_الإطار));
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف تعديل_مكدس_نداء_بدون_إطار_للهدف(الهدف: &واصف_هدف): اختياري طبيعي {
    أرجع تعديل_مكدس_نداء_لحجم_إطار_للهدف(الهدف, 0);
}

// The bytes a caller reserves at the bottom of its outgoing argument area
// for a call to a foreign function: the Microsoft x64 home area of the four
// register arguments on native x86-64 Windows, none elsewhere.
عام عرف منطقة_حجج_نداء_أجنبي_للهدف(الهدف: &واصف_هدف): طبيعي {
    إذا (تركيب_الهدف_الأصلي(الهدف) == هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف()) {
        أرجع منطقة_حجج_نداء_مايكروسوفت_إكس();
    };
    أرجع 0;
}
