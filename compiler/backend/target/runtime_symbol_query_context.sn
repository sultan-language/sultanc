استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_service_model;

// Who implements the compiler's storage services (allocate, reallocate,
// free) on a target. SultanC links no C allocator anywhere: std's allocator
// (std os/allocation.sn) is the only implementation. It needs a page source,
// which std provides for wasm32 (linear memory), Linux x86-64/AArch64 (raw
// kernel calls) and macOS (libSystem, the Darwin kernel interface). The
// guards in os/allocation.sn must name exactly these targets. Elsewhere the
// services do not exist and a program that allocates fails closed at backend
// selection. MSIR binds the std functions as program facts and backends call
// them directly; there are no storage-service symbols. Previously Linux
// x86-64 and Darwin AArch64 called the C runtime's malloc/realloc/free.
عام نوع مزود_خدمات_ذاكرة_هدف =
    | مكتبة_قياسية
    | غير_متاح
;

عام عرف مزود_خدمات_ذاكرة_للهدف(الهدف: &واصف_هدف): مزود_خدمات_ذاكرة_هدف {
    لو ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.ويب_أسمبلي()
        && (*الهدف).نموذج_البيانات.عرض_المؤشر == 32) {
        أرجع مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية();
    };
    لو ((*الهدف).نموذج_البيانات.عرض_المؤشر != 64) {
        أرجع مزود_خدمات_ذاكرة_هدف.غير_متاح();
    };
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.لينكس -> {
        طابق (*الهدف).المعمارية.الهوية مع
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية(); }
        | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية(); }
        | _ -> { أرجع مزود_خدمات_ذاكرة_هدف.غير_متاح(); };
    }
    | هوية_منصة.ماك_أو_إس -> { أرجع مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية(); }
    | _ -> { أرجع مزود_خدمات_ذاكرة_هدف.غير_متاح(); };
}

عام عرف خدمات_الذاكرة_من_المكتبة_القياسية(الهدف: &واصف_هدف): منطقي {
    طابق مزود_خدمات_ذاكرة_للهدف(الهدف) مع
    | مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية -> { أرجع صواب; }
    | مزود_خدمات_ذاكرة_هدف.غير_متاح -> { أرجع خطأ; };
}

// WebAssembly host functions are imported by (module, name). On a WASI target
// the system interface is WASI preview 1, module `wasi_snapshot_preview1`, so
// source-declared external functions are imports from that module (as the
// WASI std provider's `proc_exit`). No other target names an import module.
// SultanC external declarations carry no import-module identity, so on a WASI
// target every external left undefined after linking is a WASI preview 1
// import; definitions from other linked objects still resolve by name. Host
// functions from a non-WASI import module are outside the current language
// contract (no declaration form names one).
عام عرف وحدة_استيراد_نظام_للهدف(الهدف: &واصف_هدف): اختيار نص {
    لو ((*الهدف).مزود_التشغيل == مزود_تشغيل_هدف.واسي()) {
        أرجع اختيار.بعض(«wasi_snapshot_preview1»);
    };
    أرجع اختيار.لا_شيء();
}
