استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_service_model;
استورد std.text.compare;

// Who implements the compiler's storage services (allocate, reallocate,
// free) on a target. SultanC links no C allocator anywhere: std's allocator
// (std os/allocation.sn) is the only implementation. It needs a page source,
// which std provides for wasm32 (linear memory), Linux x86-64/AArch64 (raw
// kernel calls), macOS (libSystem, the Darwin kernel interface) and Windows
// (kernel32 VirtualAlloc). The
// guards in os/allocation.sn must name exactly these targets. Elsewhere the
// services do not exist and a program that allocates fails closed at backend
// selection. MSIR binds the std functions as program facts and backends call
// them directly; there are no storage-service symbols. Previously Linux
// x86-64 and Darwin AArch64 called the C runtime's malloc/realloc/free.
عام نوع مزود_خدمات_ذاكرة_هدف =
    | مكتبة_قياسية
    | غير_متاح
;

عام عرف مزود_خدمات_ذاكرة_للهدف(الهدف: &واصف_هدف): مزود_خدمات_ذاكرة_هدف {
    لو ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.ويب_أسمبلي()
        && (*الهدف).نموذج_البيانات.عرض_المؤشر == 32) {
        أرجع مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية();
    };
    لو ((*الهدف).نموذج_البيانات.عرض_المؤشر != 64) {
        أرجع مزود_خدمات_ذاكرة_هدف.غير_متاح();
    };
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.لينكس -> {
        طابق (*الهدف).المعمارية.الهوية مع
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية(); }
        | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية(); }
        | _ -> { أرجع مزود_خدمات_ذاكرة_هدف.غير_متاح(); };
    }
    | هوية_منصة.ماك_أو_إس -> { أرجع مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية(); }
    | هوية_منصة.ويندوز -> { أرجع مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية(); }
    | _ -> { أرجع مزود_خدمات_ذاكرة_هدف.غير_متاح(); };
}

عام عرف خدمات_الذاكرة_من_المكتبة_القياسية(الهدف: &واصف_هدف): منطقي {
    طابق مزود_خدمات_ذاكرة_للهدف(الهدف) مع
    | مزود_خدمات_ذاكرة_هدف.مكتبة_قياسية -> { أرجع صواب; }
    | مزود_خدمات_ذاكرة_هدف.غير_متاح -> { أرجع خطأ; };
}

// WebAssembly host functions are imported by (module, name). On a WASI target
// the system interface is WASI preview 1, module `wasi_snapshot_preview1`, so
// source-declared external functions are imports from that module (as the
// WASI std provider's `proc_exit`). No other target names an import module.
// SultanC external declarations carry no import-module identity, so on a WASI
// target every external left undefined after linking is a WASI preview 1
// import; definitions from other linked objects still resolve by name. Host
// functions from a non-WASI import module are outside the current language
// contract (no declaration form names one).
عام عرف وحدة_استيراد_نظام_للهدف(الهدف: &واصف_هدف): اختيار نص {
    لو ((*الهدف).مزود_التشغيل == مزود_تشغيل_هدف.واسي()) {
        أرجع اختيار.بعض(«wasi_snapshot_preview1»);
    };
    أرجع اختيار.لا_شيء();
}

// Windows system DLLs. SultanC links no C runtime and no import library: a PE
// image imports the Windows functions std calls (std os/platform/windows/**)
// by name from the system DLL that exports them, as a Mach-O image names
// libSystem directly and a WASI module imports wasi_snapshot_preview1. The
// lists below must name exactly the external functions those std modules
// declare; a symbol no input defines and no list names stays an unresolved
// external. Only Windows has such a table. Previously these symbols resolved
// only through import libraries from the Windows SDK (kernel32.lib and the
// others) that /DEFAULTLIB directives or the command line supplied.
عرف رمز_في_قائمة_نظام(الاسم: &نص, القائمة: &متجه نص): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القائمة) مثل غير_موقع)) {
        لو (نصان_متساويان(الاسم, &(*القائمة)[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف مكتبة_نظام_للرمز(الهدف: &واصف_هدف, الاسم: &نص): اختيار نص {
    لو ((*الهدف).صيغة_الكائن != صيغة_كائن_هدف.كوف()
        || (*الهدف).المنصة.المنصة != هوية_منصة.ويندوز()) {
        أرجع اختيار.لا_شيء();
    };
    دع كيرنل: متجه نص = [
        «CloseHandle», «CreateDirectoryW», «CreateFileW», «CreateProcessW»,
        «CreateWaitableTimerW», «DeleteFileW», «ExitProcess», «FindClose»,
        «FindFirstFileW», «FindNextFileW», «FlushFileBuffers»,
        «GetCommandLineW», «GetCurrentDirectoryW», «GetCurrentProcess»,
        «GetEnvironmentVariableW», «GetExitCodeProcess», «GetFileAttributesExW»,
        «GetFileAttributesW», «GetFileSizeEx», «GetFileTime», «GetLastError»,
        «GetStdHandle», «GetSystemInfo», «GetSystemTimePreciseAsFileTime»,
        «GetTempPathW», «GetTickCount64», «LocalFree», «MoveFileExW»,
        «PrefetchVirtualMemory», «QueryPerformanceCounter»,
        «QueryPerformanceFrequency», «ReadFile», «RemoveDirectoryW»,
        «SetCurrentDirectoryW», «SetEnvironmentVariableW», «SetFilePointerEx»,
        «SetLastError», «SetWaitableTimer», «Sleep», «TerminateProcess»,
        «VirtualAlloc», «VirtualFree», «VirtualLock», «VirtualProtect»,
        «VirtualUnlock», «WaitForSingleObject», «WriteFile»
    ];
    لو (رمز_في_قائمة_نظام(الاسم, &كيرنل)) { أرجع اختيار.بعض(«kernel32.dll»); };
    دع وينسوك: متجه نص = [
        «FreeAddrInfoW», «GetAddrInfoW», «WSACleanup», «WSAGetLastError»,
        «WSAStartup», «accept», «bind», «closesocket», «connect»,
        «getpeername», «getsockname», «getsockopt», «ioctlsocket», «listen»,
        «recv», «recvfrom», «send», «sendto», «setsockopt», «shutdown»,
        «socket»
    ];
    لو (رمز_في_قائمة_نظام(الاسم, &وينسوك)) { أرجع اختيار.بعض(«ws2_32.dll»); };
    دع الصدفة: متجه نص = [«CommandLineToArgvW»];
    لو (رمز_في_قائمة_نظام(الاسم, &الصدفة)) { أرجع اختيار.بعض(«shell32.dll»); };
    دع العشوائية: متجه نص = [«ProcessPrng»];
    لو (رمز_في_قائمة_نظام(الاسم, &العشوائية)) {
        أرجع اختيار.بعض(«bcryptprimitives.dll»);
    };
    أرجع اختيار.لا_شيء();
}

// The libLLVM a target imports by name. A PE image imports a DLL's functions
// by (DLL name, function name) and needs neither the DLL nor an import
// library while it is linked, exactly as for the system DLLs above. LLVM's C
// API library on Windows is `LLVM-C.dll` (built by LLVM_BUILD_LLVM_C_DYLIB and
// shipped in LLVM's Windows releases), so a Windows output that calls the
// LLVM C API imports it from that DLL, which must be found by the Windows
// loader when the program runs. ELF and Mach-O record a shared library by the
// identity written in the library itself (DT_SONAME, LC_ID_DYLIB), which has
// no fixed name, so there the library file stays a link input
// (compiler/link/dependency/llvm.sn).
عام عرف مكتبة_إل_إل_في_إم_باسم_للهدف(الهدف: &واصف_هدف): اختيار نص {
    لو ((*الهدف).صيغة_الكائن != صيغة_كائن_هدف.كوف()
        || (*الهدف).المنصة.المنصة != هوية_منصة.ويندوز()) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(«LLVM-C.dll»);
}
