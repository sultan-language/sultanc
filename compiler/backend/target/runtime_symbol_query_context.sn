استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_service_model;

عرف اسم_خدمة_داروين(الخدمة: خدمة_تشغيل_هدف): متجه غ8 {
    طابق الخدمة مع
    | خدمة_تشغيل_هدف.تخصيص_ذاكرة -> { دع الاسم: متجه غ8 = [0x5F,0x6D,0x61,0x6C,0x6C,0x6F,0x63]; أرجع الاسم; }
    | خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة -> { دع الاسم: متجه غ8 = [0x5F,0x72,0x65,0x61,0x6C,0x6C,0x6F,0x63]; أرجع الاسم; }
    | خدمة_تشغيل_هدف.تحرير_ذاكرة -> { دع الاسم: متجه غ8 = [0x5F,0x66,0x72,0x65,0x65]; أرجع الاسم; }
    | خدمة_تشغيل_هدف.خروج_العملية -> { دع الاسم: متجه غ8 = [0x5F,0x65,0x78,0x69,0x74]; أرجع الاسم; };
}

عرف اسم_خدمة_لينكس(الخدمة: خدمة_تشغيل_هدف): متجه غ8 {
    طابق الخدمة مع
    | خدمة_تشغيل_هدف.تخصيص_ذاكرة -> { دع الاسم: متجه غ8 = [0x6D,0x61,0x6C,0x6C,0x6F,0x63]; أرجع الاسم; }
    | خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة -> { دع الاسم: متجه غ8 = [0x72,0x65,0x61,0x6C,0x6C,0x6F,0x63]; أرجع الاسم; }
    | خدمة_تشغيل_هدف.تحرير_ذاكرة -> { دع الاسم: متجه غ8 = [0x66,0x72,0x65,0x65]; أرجع الاسم; }
    | خدمة_تشغيل_هدف.خروج_العملية -> { دع الاسم: متجه غ8 = [0x65,0x78,0x69,0x74]; أرجع الاسم; };
}

// Target يملك spelling الرموز الخارجية لخدمات Runtime. المعمارية لا ترى الاسم.
عام عرف اسم_رمز_خدمة_تشغيل_للهدف(
    الهدف: &واصف_هدف,
    الخدمة: خدمة_تشغيل_هدف
): اختيار متجه غ8 {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> { أرجع اختيار.بعض(اسم_خدمة_داروين(الخدمة)); }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { أرجع اختيار.بعض(اسم_خدمة_لينكس(الخدمة)); };
}
