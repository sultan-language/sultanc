استورد compiler.backend.target.target_model;
استورد compiler.backend.target.native_output_capability;
استورد compiler.backend.abi.abi_model;

// Target owns the host executable-entry ABI facts. This query does not discover
// the SultanC entry function; it only classifies an already-canonical entry ABI.
عام نوع رمز_دخول_تنفيذي_هدف =
    | رئيسي
;

عام نوع أسلوب_دخول_تنفيذي_هدف =
    | تصدير_مباشر
    | يحتاج_مهايئ
;

عام نوع خطة_دخول_تنفيذي_هدف = {
    الرمز: رمز_دخول_تنفيذي_هدف,
    الأسلوب: أسلوب_دخول_تنفيذي_هدف,
    بتات_نتيجة_العملية: طبيعي
};

عام نوع نتيجة_حل_دخول_تنفيذي_هدف =
    | متاح بنوع خطة_دخول_تنفيذي_هدف
    | غير_متاح بنوع معرف_هدف
;

عرف ناتج_دخول_صحيح_مباشر_في_السجل_صفر(
    الخطة: &خطة_دالة_واجهة
): منطقي {
    دع الحالة: خطة_دالة_واجهة = *الخطة;
    // The executable process result consumes the low 32 bits of the canonical
    // integer return register. i32 and the language-sized integer/i64 ABI
    // results are therefore directly usable on SysV x86_64 and Darwin AArch64
    // (EAX/RAX and W0/X0 respectively); no machine-code adapter is required.
    // An 8- or 16-bit integer result (C allows any integer exit status) is
    // in the low bits of the same register; the bits above it are unspecified
    // by both ABIs, and the process status keeps only the low 8 bits, which
    // the result defines.
    لو ((الطول(الحالة.المعاملات) مثل طبيعي) != 0) {
        أرجع خطأ;
    };
    دع الحجم: طبيعي = الحالة.الناتج.التصنيف.الحجم;
    لو ((الحجم != 1) && (الحجم != 2) && (الحجم != 4) && (الحجم != 8)) {
        أرجع خطأ;
    };
    طابق الحالة.الناتج.الموقع مع
    | موقع_تمرير_واجهة.مباشر(الموضع) -> {
        طابق الموضع مع
        | موضع_جزء_واجهة.سجل(المرجع) -> {
            لو (المرجع.الفئة != فئة_سجل_واجهة.عدد_صحيح()) {
                أرجع خطأ;
            };
            لو (المرجع.الفهرس != 0) {
                أرجع خطأ;
            };
            لو (المرجع.الدور != دور_سجل_واجهة.ناتج()) {
                أرجع خطأ;
            };
            أرجع صواب;
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عام عرف حل_دخول_تنفيذي_للهدف(
    الهدف: &واصف_هدف,
    خطة_الواجهة: &خطة_دالة_واجهة
): نتيجة_حل_دخول_تنفيذي_هدف {
    طابق حل_قدرة_مخرج_أصلي(الهدف) مع
    | قدرة_مخرج_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        دع الأسلوب: متغير أسلوب_دخول_تنفيذي_هدف = أسلوب_دخول_تنفيذي_هدف.يحتاج_مهايئ();
        لو (ناتج_دخول_صحيح_مباشر_في_السجل_صفر(خطة_الواجهة)) {
            الأسلوب := أسلوب_دخول_تنفيذي_هدف.تصدير_مباشر();
        };
        دع الرمز_الرئيسي: رمز_دخول_تنفيذي_هدف = رمز_دخول_تنفيذي_هدف.رئيسي();
        دع الخطة: خطة_دخول_تنفيذي_هدف = {
            الرمز: الرمز_الرئيسي,
            الأسلوب: الأسلوب,
            بتات_نتيجة_العملية: 32
        };
        أرجع نتيجة_حل_دخول_تنفيذي_هدف.متاح(الخطة);
    }
    | قدرة_مخرج_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        دع الأسلوب: متغير أسلوب_دخول_تنفيذي_هدف = أسلوب_دخول_تنفيذي_هدف.يحتاج_مهايئ();
        لو (ناتج_دخول_صحيح_مباشر_في_السجل_صفر(خطة_الواجهة)) {
            الأسلوب := أسلوب_دخول_تنفيذي_هدف.تصدير_مباشر();
        };
        دع الرمز_الرئيسي: رمز_دخول_تنفيذي_هدف = رمز_دخول_تنفيذي_هدف.رئيسي();
        دع الخطة: خطة_دخول_تنفيذي_هدف = {
            الرمز: الرمز_الرئيسي,
            الأسلوب: الأسلوب,
            بتات_نتيجة_العملية: 32
        };
        أرجع نتيجة_حل_دخول_تنفيذي_هدف.متاح(الخطة);
    }
    | قدرة_مخرج_أصلي.ويب_أسمبلي_اثنان_وثلاثون_وحدة -> {
        // The WebAssembly process start is generated beside the entry by the
        // native wasm32 path; it accepts no parameters and an ignored or
        // direct integer result, whose low 32 bits are the process status.
        دع الحالة: خطة_دالة_واجهة = *خطة_الواجهة;
        دع الأسلوب: متغير أسلوب_دخول_تنفيذي_هدف = أسلوب_دخول_تنفيذي_هدف.يحتاج_مهايئ();
        لو ((الطول(الحالة.المعاملات) مثل طبيعي) == 0) {
            طابق الحالة.الناتج.الموقع مع
            | موقع_تمرير_واجهة.متجاهل -> { الأسلوب := أسلوب_دخول_تنفيذي_هدف.تصدير_مباشر(); }
            | موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.سجل(المرجع)) -> {
                لو (المرجع.الفئة == فئة_سجل_واجهة.عدد_صحيح()) {
                    الأسلوب := أسلوب_دخول_تنفيذي_هدف.تصدير_مباشر();
                };
            }
            | _ -> { };
        };
        دع الرمز_الرئيسي: رمز_دخول_تنفيذي_هدف = رمز_دخول_تنفيذي_هدف.رئيسي();
        دع الخطة: خطة_دخول_تنفيذي_هدف = {
            الرمز: الرمز_الرئيسي,
            الأسلوب: الأسلوب,
            بتات_نتيجة_العملية: 32
        };
        أرجع نتيجة_حل_دخول_تنفيذي_هدف.متاح(الخطة);
    }
    | قدرة_مخرج_أصلي.غير_متاحة -> {
        دع و: واصف_هدف = *الهدف;
        أرجع نتيجة_حل_دخول_تنفيذي_هدف.غير_متاح(و.المعرف);
    };
}
