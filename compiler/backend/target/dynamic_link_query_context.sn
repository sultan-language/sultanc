استورد compiler.backend.target.target_model;

// Dynamic-link facts are Target-owned. Object writers consume these values and
// never infer operating-system loader or system-library policy themselves.
عام نوع إعداد_ربط_ديناميكي_هدف = {
    مفسر_إلف: متجه غ8,
    مكتبة_نظام_افتراضية: متجه غ8
};

عام عرف إعداد_ربط_ديناميكي_للهدف(
    الهدف: &واصف_هدف
): اختيار إعداد_ربط_ديناميكي_هدف {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        دع المفسر: متجه غ8 = [
            0x2F,0x6C,0x69,0x62,0x36,0x34,0x2F,0x6C,0x64,0x2D,0x6C,0x69,0x6E,0x75,0x78,0x2D,
            0x78,0x38,0x36,0x2D,0x36,0x34,0x2E,0x73,0x6F,0x2E,0x32,0
        ];
        دع المكتبة: متجه غ8 = [0x6C,0x69,0x62,0x63,0x2E,0x73,0x6F,0x2E,0x36];
        دع الإعداد: إعداد_ربط_ديناميكي_هدف = {
            مفسر_إلف: المفسر,
            مكتبة_نظام_افتراضية: المكتبة
        };
        أرجع اختيار.بعض(الإعداد);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}
