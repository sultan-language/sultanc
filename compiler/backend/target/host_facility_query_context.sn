عام عرف اسم_رمز_مرفق_مضيف_للهدف(
    الهدف: &واصف_هدف,
    المرفق: مرفق_مضيف_هدف
): اختيار متجه غ8 {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> { أرجع اسم_مرفق_داروين(المرفق); }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { أرجع اسم_مرفق_لينكس(المرفق); };
}
