استورد compiler.backend.target.target_model;
استورد compiler.runtime.host_environment_model;

عرف معمارية_مقننة(الهوية: هوية_معمارية): اختيار_معمارية {
    دع المعالج: اختياري معرف_معالج = اختياري.لا_شيء();
    دع الميزات: متجه معرف_ميزة_معمارية = [];
    دع الاختيار: اختيار_معمارية = {
        الهوية: الهوية,
        المعالج: المعالج,
        الميزات: الميزات
    };
    أرجع الاختيار;
}

عرف نموذج_بيانات_مقنن(عرض_المؤشر: طبيعي, ترتيب: ترتيب_بايت): نموذج_بيانات_هدف {
    دع النموذج: نموذج_بيانات_هدف = {
        عرض_المؤشر: عرض_المؤشر,
        ترتيب_البايت: ترتيب
    };
    أرجع النموذج;
}

عرف هدف_ترجمة_متقاطعة_مفوض(
    رقم_المعرف: طبيعي,
    التهجئة: نص,
    الثلاثي: نص,
    هوية_المعمارية: هوية_معمارية,
    هوية_المنصة: هوية_منصة,
    هوية_البيئة: هوية_بيئة,
    عرض_المؤشر: طبيعي,
    ترتيب: ترتيب_بايت,
    صيغة_الكائن: صيغة_كائن_هدف,
    نوع_المخرج: نوع_مخرج_آلة_هدف
): واصف_هدف {
    دع المنصة: اختيار_منصة = {
        المنصة: هوية_المنصة,
        البيئة: هوية_البيئة
    };
    دع مزود_التشغيل: متغير مزود_تشغيل_هدف = مزود_تشغيل_هدف.غير_متاح();
    // WASI command targets reach the host only through WASI imports; the
    // compiler storage services come from std (library/std/os/allocation.sn),
    // never from a C library.
    إذا (هوية_المنصة == هوية_منصة.واسي() && صيغة_الكائن == صيغة_كائن_هدف.ويب_أسمبلي()) {
        مزود_التشغيل := مزود_تشغيل_هدف.واسي();
    };
    // wasm32 WebAssembly modules also have a native machine path; every
    // runtime fact other than that composition stays as for delegated targets.
    دع التركيب: متغير هوية_تركيب_هدف_أصلي = هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة();
    إذا (هوية_المعمارية == هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون()
        && صيغة_الكائن == صيغة_كائن_هدف.ويب_أسمبلي() && عرض_المؤشر == 32) {
        التركيب := هوية_تركيب_هدف_أصلي.ويب_أسمبلي_اثنان_وثلاثون_وحدة();
    };
    دع الهدف: واصف_هدف = {
        المعرف: معرف_هدف_من(رقم_المعرف),
        التهجئة: التهجئة,
        الثلاثي_المقنن: الثلاثي,
        المعمارية: معمارية_مقننة(هوية_المعمارية),
        المنصة: المنصة,
        نموذج_البيانات: نموذج_بيانات_مقنن(عرض_المؤشر, ترتيب),
        الواجهة_الثنائية: هوية_واجهة_ثنائية_هدف.سلطان_محمولة(),
        صيغة_الكائن: صيغة_الكائن,
        مزود_التشغيل: مزود_التشغيل,
        قواعد_السجلات: هوية_قواعد_سجلات_هدف.مفوضة_للمزود(),
        التركيب_الأصلي: التركيب,
        نوع_مخرج_الآلة: نوع_المخرج,
        الدعم: مستوى_دعم_هدف.ترجمة_متقاطعة()
    };
    أرجع الهدف;
}

عرف هدف_ذراع_أربعة_وستون_ماك(): واصف_هدف {
    دع المنصة: اختيار_منصة = {
        المنصة: هوية_منصة.ماك_أو_إس(),
        البيئة: هوية_بيئة.غير_محددة()
    };
    دع الهدف: واصف_هدف = {
        المعرف: معرف_هدف_من(0),
        التهجئة: «arm64-darwin»,
        الثلاثي_المقنن: «aarch64-apple-darwin»,
        المعمارية: معمارية_مقننة(هوية_معمارية.ذراع_أربعة_وستون()),
        المنصة: المنصة,
        نموذج_البيانات: نموذج_بيانات_مقنن(64, ترتيب_بايت.صغير()),
        الواجهة_الثنائية: هوية_واجهة_ثنائية_هدف.داروين_ذراع_أربعة_وستون(),
        صيغة_الكائن: صيغة_كائن_هدف.ماتشو(),
        مزود_التشغيل: مزود_تشغيل_هدف.داروين(),
        قواعد_السجلات: هوية_قواعد_سجلات_هدف.داروين_ذراع_أربعة_وستون(),
        التركيب_الأصلي: هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو(),
        نوع_مخرج_الآلة: نوع_مخرج_آلة_هدف.كائن(),
        الدعم: مستوى_دعم_هدف.مضيف_ذاتي()
    };
    أرجع الهدف;
}

عرف هدف_إكس_ستة_وثمانون_أربعة_وستون_لينكس(): واصف_هدف {
    دع المنصة: اختيار_منصة = {
        المنصة: هوية_منصة.لينكس(),
        البيئة: هوية_بيئة.جنو()
    };
    دع الهدف: واصف_هدف = {
        المعرف: معرف_هدف_من(1),
        التهجئة: «x86_64-linux»,
        الثلاثي_المقنن: «x86_64-unknown-linux-gnu»,
        المعمارية: معمارية_مقننة(هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون()),
        المنصة: المنصة,
        نموذج_البيانات: نموذج_بيانات_مقنن(64, ترتيب_بايت.صغير()),
        الواجهة_الثنائية: هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون(),
        صيغة_الكائن: صيغة_كائن_هدف.إلف(),
        مزود_التشغيل: مزود_تشغيل_هدف.لينكس(),
        قواعد_السجلات: هوية_قواعد_سجلات_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون(),
        التركيب_الأصلي: هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف(),
        نوع_مخرج_الآلة: نوع_مخرج_آلة_هدف.كائن(),
        // Self-hosted: Stage3 == Stage4 on x86_64 Linux in every release.
        الدعم: مستوى_دعم_هدف.مضيف_ذاتي()
    };
    أرجع الهدف;
}

// AArch64 Linux: delegated facts (portable SultanC ABI, no runtime provider)
// plus the native machine path: the arm64 selector with AAPCS64 register
// rules, direct kernel entry and the ELF writer.
عرف هدف_ذراع_أربعة_وستون_لينكس(): واصف_هدف {
    دع الهدف: متغير واصف_هدف = هدف_ترجمة_متقاطعة_مفوض(2, «aarch64-linux-gnu», «aarch64-unknown-linux-gnu», هوية_معمارية.ذراع_أربعة_وستون(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن());
    الهدف.قواعد_السجلات := هوية_قواعد_سجلات_هدف.إيه_إيه_بي_سي_إس_أربعة_وستون();
    الهدف.التركيب_الأصلي := هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_لينكس_إلف();
    أرجع الهدف;
}

// x86-64 Windows (MSVC environment): delegated facts plus the native machine
// path, the x86-64 selector with a PE/COFF writer and kernel32 imports.
عرف هدف_إكس_ستة_وثمانون_أربعة_وستون_ويندوز(): واصف_هدف {
    دع الهدف: متغير واصف_هدف = هدف_ترجمة_متقاطعة_مفوض(7, «x86_64-windows-msvc», «x86_64-pc-windows-msvc», هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون(), هوية_منصة.ويندوز(), هوية_بيئة.إم_إس_في_سي(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.كوف(), نوع_مخرج_آلة_هدف.كائن());
    الهدف.التركيب_الأصلي := هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف();
    أرجع الهدف;
}

// x86-64 macOS: delegated facts plus the native machine path, the x86-64
// selector with an x86-64 Mach-O writer and libSystem imports.
عرف هدف_إكس_ستة_وثمانون_أربعة_وستون_ماك(): واصف_هدف {
    دع الهدف: متغير واصف_هدف = هدف_ترجمة_متقاطعة_مفوض(6, «x86_64-darwin», «x86_64-apple-darwin», هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون(), هوية_منصة.ماك_أو_إس(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.ماتشو(), نوع_مخرج_آلة_هدف.كائن());
    الهدف.التركيب_الأصلي := هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_داروين_ماتشو();
    أرجع الهدف;
}

// AArch64 Windows (MSVC environment): delegated facts plus the native machine
// path, the arm64 selector with AAPCS64 register rules and the COFF writer.
عرف هدف_ذراع_أربعة_وستون_ويندوز(): واصف_هدف {
    دع الهدف: متغير واصف_هدف = هدف_ترجمة_متقاطعة_مفوض(3, «aarch64-windows-msvc», «aarch64-pc-windows-msvc», هوية_معمارية.ذراع_أربعة_وستون(), هوية_منصة.ويندوز(), هوية_بيئة.إم_إس_في_سي(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.كوف(), نوع_مخرج_آلة_هدف.كائن());
    الهدف.قواعد_السجلات := هوية_قواعد_سجلات_هدف.إيه_إيه_بي_سي_إس_أربعة_وستون();
    الهدف.التركيب_الأصلي := هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_ويندوز_كوف();
    أرجع الهدف;
}

// Android runs the Linux kernel ABI without a C library, and FreeBSD
// executables enter their kernel directly too: both are static ELF images
// like Linux ones, so the native machine path is the Linux ELF composition
// of the architecture (AAPCS64 register rules on AArch64); the kernel entry,
// `_start` and the ABI note follow the platform inside it.
عرف هدف_نواة_إلف_أصلي(الأساس: واصف_هدف): واصف_هدف {
    دع الهدف: متغير واصف_هدف = الأساس;
    طابق الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        الهدف.قواعد_السجلات := هوية_قواعد_سجلات_هدف.إيه_إيه_بي_سي_إس_أربعة_وستون();
        الهدف.التركيب_الأصلي := هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_لينكس_إلف();
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        الهدف.التركيب_الأصلي := هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف();
    }
    | _ -> { };
    أرجع الهدف;
}

// Cortex-M bare-metal targets (thumbv6m, thumbv7m, thumbv7em): 32-bit Arm
// with the M-profile class as processor (target_model.sn صنف_ذراع_إم),
// AAPCS (eabi: soft-float calls; eabihf: AAPCS-VFP), ELF relocatable
// objects, no runtime provider. LLVM-backend only: the native code
// generators have no 32-bit Arm selector.
عرف هدف_ذراع_إم(رقم_المعرف: طبيعي, التهجئة: نص, الثلاثي: نص, الصنف: صنف_ذراع_إم, البيئة: هوية_بيئة): واصف_هدف {
    دع الهدف: متغير واصف_هدف = هدف_ترجمة_متقاطعة_مفوض(رقم_المعرف, التهجئة, الثلاثي, هوية_معمارية.ذراع_سبعة(), هوية_منصة.عتاد_مباشر(), البيئة, 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن());
    الهدف.المعمارية.المعالج := اختياري.موجود(معرف_معالج_ذراع_إم(الصنف));
    أرجع الهدف;
}

عام عرف الأهداف_المسجلة(): متجه واصف_هدف {
    دع الأهداف: متغير متجه واصف_هدف = [];
    ألحق(الأهداف, هدف_ذراع_أربعة_وستون_ماك());
    ألحق(الأهداف, هدف_إكس_ستة_وثمانون_أربعة_وستون_لينكس());
    ألحق(الأهداف, هدف_ذراع_أربعة_وستون_لينكس());
    ألحق(الأهداف, هدف_ذراع_أربعة_وستون_ويندوز());
    ألحق(الأهداف, هدف_نواة_إلف_أصلي(هدف_ترجمة_متقاطعة_مفوض(4, «aarch64-android», «aarch64-linux-android», هوية_معمارية.ذراع_أربعة_وستون(), هوية_منصة.أندرويد(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن())));
    ألحق(الأهداف, هدف_نواة_إلف_أصلي(هدف_ترجمة_متقاطعة_مفوض(5, «aarch64-freebsd», «aarch64-unknown-freebsd», هوية_معمارية.ذراع_أربعة_وستون(), هوية_منصة.فري_بي_إس_دي(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن())));
    ألحق(الأهداف, هدف_إكس_ستة_وثمانون_أربعة_وستون_ماك());
    ألحق(الأهداف, هدف_إكس_ستة_وثمانون_أربعة_وستون_ويندوز());
    ألحق(الأهداف, هدف_نواة_إلف_أصلي(هدف_ترجمة_متقاطعة_مفوض(8, «x86_64-android», «x86_64-linux-android», هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون(), هوية_منصة.أندرويد(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن())));
    ألحق(الأهداف, هدف_نواة_إلف_أصلي(هدف_ترجمة_متقاطعة_مفوض(9, «x86_64-freebsd», «x86_64-unknown-freebsd», هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون(), هوية_منصة.فري_بي_إس_دي(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن())));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(10, «i686-linux-gnu», «i686-unknown-linux-gnu», هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(11, «armv7-linux-gnueabihf», «armv7-unknown-linux-gnueabihf», هوية_معمارية.ذراع_سبعة(), هوية_منصة.لينكس(), هوية_بيئة.إي_إيه_بي_آي_إتش_إف(), 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(12, «armv7-android», «armv7-linux-android», هوية_معمارية.ذراع_سبعة(), هوية_منصة.أندرويد(), هوية_بيئة.غير_محددة(), 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(13, «riscv64-linux-gnu», «riscv64-unknown-linux-gnu», هوية_معمارية.رايسك_في_أربعة_وستون(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(14, «riscv64-freebsd», «riscv64-unknown-freebsd», هوية_معمارية.رايسك_في_أربعة_وستون(), هوية_منصة.فري_بي_إس_دي(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(15, «riscv32-unknown-elf», «riscv32-unknown-elf», هوية_معمارية.رايسك_في_اثنان_وثلاثون(), هوية_منصة.عتاد_مباشر(), هوية_بيئة.غير_محددة(), 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(16, «wasm32-wasi», «wasm32-unknown-wasi», هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون(), هوية_منصة.واسي(), هوية_بيئة.غير_محددة(), 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.ويب_أسمبلي(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(17, «wasm32-browser», «wasm32-unknown-unknown», هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون(), هوية_منصة.متصفح(), هوية_بيئة.غير_محددة(), 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.ويب_أسمبلي(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(18, «wasm64-unknown-unknown», «wasm64-unknown-unknown», هوية_معمارية.ويب_أسمبلي_أربعة_وستون(), هوية_منصة.غير_محددة(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.ويب_أسمبلي(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(19, «amdgcn-amd-amdhsa», «amdgcn-amd-amdhsa», هوية_معمارية.إيه_إم_دي_جي_بي_يو(), هوية_منصة.غير_محددة(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(20, «avr-unknown-unknown», «avr-unknown-unknown», هوية_معمارية.إيه_في_آر(), هوية_منصة.عتاد_مباشر(), هوية_بيئة.غير_محددة(), 16, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(21, «bpfel-unknown-none», «bpfel-unknown-none», هوية_معمارية.بي_بي_إف(), هوية_منصة.غير_محددة(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(22, «hexagon-unknown-elf», «hexagon-unknown-elf», هوية_معمارية.هيكساغون(), هوية_منصة.عتاد_مباشر(), هوية_بيئة.غير_محددة(), 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(23, «lanai-unknown-unknown», «lanai-unknown-unknown», هوية_معمارية.لاناي(), هوية_منصة.عتاد_مباشر(), هوية_بيئة.غير_محددة(), 32, ترتيب_بايت.كبير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(24, «loongarch64-linux-gnu», «loongarch64-unknown-linux-gnu», هوية_معمارية.لونغ_آرتش_أربعة_وستون(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(25, «mips64el-linux-gnuabi64», «mips64el-unknown-linux-gnuabi64», هوية_معمارية.ميبس_أربعة_وستون(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(26, «msp430-unknown-elf», «msp430-unknown-elf», هوية_معمارية.إم_إس_بي_أربعمئة_وثلاثون(), هوية_منصة.عتاد_مباشر(), هوية_بيئة.غير_محددة(), 16, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(27, «nvptx64-nvidia-cuda», «nvptx64-nvidia-cuda», هوية_معمارية.إن_في_بي_تي_إكس_أربعة_وستون(), هوية_منصة.غير_محددة(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.بلا_كائن(), نوع_مخرج_آلة_هدف.تجميع()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(28, «powerpc64le-linux-gnu», «powerpc64le-unknown-linux-gnu», هوية_معمارية.باور_بي_سي_أربعة_وستون(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(29, «sparcv9-linux-gnu», «sparcv9-unknown-linux-gnu», هوية_معمارية.سبارك_أربعة_وستون(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.كبير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(30, «spirv64-unknown-unknown», «spirv64-unknown-unknown», هوية_معمارية.سبير_في_أربعة_وستون(), هوية_منصة.غير_محددة(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.سبير_في(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(31, «s390x-linux-gnu», «s390x-unknown-linux-gnu», هوية_معمارية.سيستم_زد(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.كبير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(32, «ve-linux-gnu», «ve-unknown-linux-gnu», هوية_معمارية.في_إي(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(33, «xcore-unknown-unknown», «xcore-unknown-unknown», هوية_معمارية.إكس_كور(), هوية_منصة.عتاد_مباشر(), هوية_بيئة.غير_محددة(), 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.بلا_كائن(), نوع_مخرج_آلة_هدف.تجميع()));
    ألحق(الأهداف, هدف_ذراع_إم(34, «thumbv6m-none-eabi», «thumbv6m-none-eabi», صنف_ذراع_إم.في_ستة_إم(), هوية_بيئة.إي_إيه_بي_آي()));
    ألحق(الأهداف, هدف_ذراع_إم(35, «thumbv7m-none-eabi», «thumbv7m-none-eabi», صنف_ذراع_إم.في_سبعة_إم(), هوية_بيئة.إي_إيه_بي_آي()));
    ألحق(الأهداف, هدف_ذراع_إم(36, «thumbv7em-none-eabi», «thumbv7em-none-eabi», صنف_ذراع_إم.في_سبعة_إي_إم(), هوية_بيئة.إي_إيه_بي_آي()));
    ألحق(الأهداف, هدف_ذراع_إم(37, «thumbv7em-none-eabihf», «thumbv7em-none-eabihf», صنف_ذراع_إم.في_سبعة_إي_إم(), هوية_بيئة.إي_إيه_بي_آي_إتش_إف()));
    أرجع الأهداف;
}

عرف يطابق_التكوين(
    الهدف: &واصف_هدف,
    المعمارية: هوية_معمارية,
    المنصة: هوية_منصة,
    البيئة: هوية_بيئة
): منطقي {
    دع القيمة: واصف_هدف = *الهدف;
    أرجع القيمة.المعمارية.الهوية == المعمارية
        && القيمة.المنصة.المنصة == المنصة
        && القيمة.المنصة.البيئة == البيئة;
}

عام عرف حل_بالتكوين(
    المعمارية: هوية_معمارية,
    المنصة: هوية_منصة,
    البيئة: هوية_بيئة
): نتيجة_حل_هدف {
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأهداف) مثل طبيعي)) {
        إذا (يطابق_التكوين(&الأهداف[ف], المعمارية, المنصة, البيئة)) {
            دع مرجع_الهدف: &واصف_هدف = &الأهداف[ف];
            دع الهدف: واصف_هدف = انسخ_مملوكا_واصف_هدف(مرجع_الهدف);
            أرجع نتيجة_حل_هدف.محلول(الهدف);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_حل_هدف.غير_مسجل();
}

عام عرف حل_بمعرف_هدف(المعرف: معرف_هدف): نتيجة_حل_هدف {
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأهداف) مثل طبيعي)) {
        إذا (معرفا_هدف_متساويان(الأهداف[ف].المعرف, المعرف)) {
            دع مرجع_الهدف: &واصف_هدف = &الأهداف[ف];
            دع الهدف: واصف_هدف = انسخ_مملوكا_واصف_هدف(مرجع_الهدف);
            أرجع نتيجة_حل_هدف.محلول(الهدف);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_حل_هدف.غير_مسجل();
}

عرف معمارية_هدف_من_مضيف(الهوية: هوية_معمارية_مضيف): هوية_معمارية {
    طابق الهوية مع
    | هوية_معمارية_مضيف.ذراع_أربعة_وستون -> { أرجع هوية_معمارية.ذراع_أربعة_وستون(); }
    | هوية_معمارية_مضيف.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون(); }
    | هوية_معمارية_مضيف.ويب_أسمبلي_اثنان_وثلاثون -> { أرجع هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون(); }
    | هوية_معمارية_مضيف.ويب_أسمبلي_أربعة_وستون -> { أرجع هوية_معمارية.ويب_أسمبلي_أربعة_وستون(); };
}

عرف منصة_هدف_من_مضيف(الهوية: هوية_منصة_مضيف): هوية_منصة {
    طابق الهوية مع
    | هوية_منصة_مضيف.داروين -> { أرجع هوية_منصة.ماك_أو_إس(); }
    | هوية_منصة_مضيف.لينكس -> { أرجع هوية_منصة.لينكس(); }
    | هوية_منصة_مضيف.واسي -> { أرجع هوية_منصة.واسي(); }
    | هوية_منصة_مضيف.متصفح -> { أرجع هوية_منصة.متصفح(); }
    | هوية_منصة_مضيف.ويندوز -> { أرجع هوية_منصة.ويندوز(); }
    | هوية_منصة_مضيف.أندرويد -> { أرجع هوية_منصة.أندرويد(); }
    | هوية_منصة_مضيف.فري_بي_إس_دي -> { أرجع هوية_منصة.فري_بي_إس_دي(); }
    | هوية_منصة_مضيف.غير_محددة -> { أرجع هوية_منصة.غير_محددة(); };
}

عرف بيئة_هدف_من_مضيف(الهوية: هوية_بيئة_مضيف): هوية_بيئة {
    طابق الهوية مع
    | هوية_بيئة_مضيف.غير_محددة -> { أرجع هوية_بيئة.غير_محددة(); }
    | هوية_بيئة_مضيف.جنو -> { أرجع هوية_بيئة.جنو(); }
    | هوية_بيئة_مضيف.مسل -> { أرجع هوية_بيئة.مسل(); }
    | هوية_بيئة_مضيف.إم_إس_في_سي -> { أرجع هوية_بيئة.إم_إس_في_سي(); };
}

عام عرف حل_هدف_المضيف_المسجل(): نتيجة_حل_هدف {
    طابق وصف_بيئة_المضيف_الحالية() مع
    | اختياري.لا_شيء -> { أرجع نتيجة_حل_هدف.غير_مسجل(); }
    | اختياري.موجود(المضيف) -> {
        أرجع حل_بالتكوين(
            معمارية_هدف_من_مضيف(المضيف.المعمارية),
            منصة_هدف_من_مضيف(المضيف.المنصة),
            بيئة_هدف_من_مضيف(المضيف.البيئة)
        );
    };
}

// Code-generation baseline of a delegated target where its platform C ABI
// depends on it: the processor features and ABI name a C compiler for that
// platform assumes by default. Empty texts leave the code generator's
// defaults, which already are the platform ABI for every other target.
// - riscv64 Linux/FreeBSD: RV64GC with the lp64d hardware floating-point ABI
//   (Clang/GCC default for riscv64-*-linux-gnu and FreeBSD).
// - riscv32 bare metal: RV32IMAC with the soft-float ilp32 ABI (Clang's
//   default for riscv32-unknown-elf).
// - loongarch64 Linux: double-precision FP with the lp64d ABI (the LoongArch
//   psABI's default for Linux).
// Previously no baseline was set, so LLVM used its generic RV64I/lp64
// soft-float defaults, which disagree with the C ABI of those platforms.
عام نوع أساس_توليد_هدف = {
    المعالج: نص,
    الميزات: نص,
    الواجهة: نص
};

عام عرف أساس_توليد_شفرة_للهدف(الهدف: &واصف_هدف): أساس_توليد_هدف {
    دع القيمة: واصف_هدف = *الهدف;
    دع الأساس: متغير أساس_توليد_هدف = { المعالج: «», الميزات: «», الواجهة: «» };
    طابق القيمة.المعمارية.الهوية مع
    | هوية_معمارية.رايسك_في_أربعة_وستون -> {
        الأساس.المعالج := «generic-rv64»;
        الأساس.الميزات := «+m,+a,+f,+d,+c»;
        الأساس.الواجهة := «lp64d»;
    }
    | هوية_معمارية.رايسك_في_اثنان_وثلاثون -> {
        الأساس.المعالج := «generic-rv32»;
        الأساس.الميزات := «+m,+a,+c»;
        الأساس.الواجهة := «ilp32»;
    }
    // i686 (Rust's i686 targets): CMPXCHG8B, so 64-bit atomics (the
    // allocator, std.sync) are inline instead of __atomic_* library calls,
    // which std does not link.
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> {
        الأساس.المعالج := «i686»;
    }
    // Cortex-M (thumbv*-none-eabi[hf]): أساس_توليد_ذراع_إم.
    | هوية_معمارية.ذراع_سبعة -> { أساس_توليد_ذراع_إم(الهدف, &متغير الأساس); }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> {
        الأساس.المعالج := «generic-la64»;
        الأساس.الميزات := «+64bit,+f,+d»;
        الأساس.الواجهة := «lp64d»;
    }
    // aarch64 macOS: Apple M1 (ARMv8.5 with LSE atomics), Clang's default
    // for arm64-apple-macos. Other aarch64 platforms keep LLVM's generic
    // ARMv8.0 (atomics as LDAXR/STLXR loops), since their cores include
    // ARMv8.0 ones without LSE (target_model.sn هدف_ذراع_بذريات_إل_إس_إي).
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        إذا (هدف_ذراع_بذريات_إل_إس_إي(الهدف)) {
            الأساس.المعالج := «apple-m1»;
        };
    }
    | _ -> { };
    أرجع الأساس;
}

// Code-generation baseline of the Cortex-M targets. The triple names the
// M-profile architecture (LLVM derives Thumb-2, the hardware divide and DSP
// from it); the processor is the class's reference core, as Clang selects
// it, which sets the scheduling model and the build attributes.
// - ARMv6-M (Cortex-M0): strict alignment, and 32-bit atomic loads and
//   stores as LDR/STR with DMB (+atomics-32) instead of __atomic_* library
//   calls; std has no read-modify-write atomics there (target_model.sn
//   عرض_الذريات_للهدف).
// - eabi is soft-float: no FPU instruction or register at all (-fpregs, as
//   Clang does for -mfloat-abi=soft); float operations would be calls to
//   __aeabi_f*/__aeabi_d* routines, which the LLVM provider rejects
//   (provider/llvm/freestanding_check.sn).
// - eabihf: the FPv4-SP-D16 FPU of the Cortex-M4 (single precision in
//   hardware) with the AAPCS-VFP calling convention, which LLVM selects from
//   the "eabihf" environment. A Cortex-M7 runs this code; its
//   double-precision FPv5-D16 (cortex-m7, +fp-armv8d16) is ABI-compatible
//   but needs a processor selection the registry does not offer yet.
عرف أساس_توليد_ذراع_إم(الهدف: &واصف_هدف, الأساس: &متغير أساس_توليد_هدف): فراغ {
    طابق صنف_ذراع_إم_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الصنف) -> {
        طابق الصنف مع
        | صنف_ذراع_إم.في_ستة_إم -> {
            (*الأساس).المعالج := «cortex-m0»;
            (*الأساس).الميزات := «+strict-align,+atomics-32»;
        }
        | صنف_ذراع_إم.في_سبعة_إم -> {
            (*الأساس).المعالج := «cortex-m3»;
        }
        | صنف_ذراع_إم.في_سبعة_إي_إم -> {
            (*الأساس).المعالج := «cortex-m4»;
            إذا ((*الهدف).المنصة.البيئة == هوية_بيئة.إي_إيه_بي_آي_إتش_إف()) {
                (*الأساس).الميزات := «+vfp4d16sp»;
            } وإلا {
                (*الأساس).الميزات := «-vfp2sp,-fpregs»;
            };
        };
    };
}
