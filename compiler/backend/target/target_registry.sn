استورد compiler.backend.target.target_model;
استورد compiler.runtime.host_environment_model;
استورد compiler.runtime.host_service_adapter;

عرف معمارية_ذراع_أربعة_وستون(): اختيار_معمارية {
    دع الهوية: هوية_معمارية = هوية_معمارية.ذراع_أربعة_وستون();
    دع المعالج: اختيار معرف_معالج = اختيار.لا_شيء();
    دع الميزات: متجه معرف_ميزة_معمارية = [];
    دع الاختيار: اختيار_معمارية = {
        الهوية: الهوية,
        المعالج: المعالج,
        الميزات: الميزات
    };
    أرجع الاختيار;
}

عرف نموذج_بيانات_ذراع_أربعة_وستون(): نموذج_بيانات_هدف {
    دع ترتيب_البايت: ترتيب_بايت = ترتيب_بايت.صغير();
    دع النموذج: نموذج_بيانات_هدف = {
        عرض_المؤشر: 64,
        ترتيب_البايت: ترتيب_البايت
    };
    أرجع النموذج;
}

عرف معمارية_إكس_ستة_وثمانون_أربعة_وستون(): اختيار_معمارية {
    دع الهوية: هوية_معمارية = هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون();
    دع المعالج: اختيار معرف_معالج = اختيار.لا_شيء();
    دع الميزات: متجه معرف_ميزة_معمارية = [];
    دع الاختيار: اختيار_معمارية = {
        الهوية: الهوية,
        المعالج: المعالج,
        الميزات: الميزات
    };
    أرجع الاختيار;
}

عرف نموذج_بيانات_إكس_ستة_وثمانون_أربعة_وستون(): نموذج_بيانات_هدف {
    دع ترتيب_البايت: ترتيب_بايت = ترتيب_بايت.صغير();
    دع النموذج: نموذج_بيانات_هدف = {
        عرض_المؤشر: 64,
        ترتيب_البايت: ترتيب_البايت
    };
    أرجع النموذج;
}

عرف هدف_ذراع_أربعة_وستون_ماك(): واصف_هدف {
    دع هوية_المنصة: هوية_منصة = هوية_منصة.ماك_أو_إس();
    دع البيئة: هوية_بيئة = هوية_بيئة.غير_محددة();
    دع المنصة: اختيار_منصة = {
        المنصة: هوية_المنصة,
        البيئة: البيئة
    };
    دع المعرف: معرف_هدف = معرف_هدف_من(0);
    دع المعمارية: اختيار_معمارية = معمارية_ذراع_أربعة_وستون();
    دع نموذج_البيانات: نموذج_بيانات_هدف = نموذج_بيانات_ذراع_أربعة_وستون();
    دع الواجهة_الثنائية: هوية_واجهة_ثنائية_هدف = هوية_واجهة_ثنائية_هدف.داروين_ذراع_أربعة_وستون();
    دع صيغة_الكائن: صيغة_كائن_هدف = صيغة_كائن_هدف.ماتشو();
    دع مزود_التشغيل: مزود_تشغيل_هدف = مزود_تشغيل_هدف.داروين();
    دع قواعد_السجلات: هوية_قواعد_سجلات_هدف = هوية_قواعد_سجلات_هدف.داروين_ذراع_أربعة_وستون();
    دع التركيب_الأصلي: هوية_تركيب_هدف_أصلي = هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو();
    دع مزود_الإنهاء_التنفيذي: هوية_مزود_إنهاء_تنفيذي_هدف = هوية_مزود_إنهاء_تنفيذي_هدف.ماتشو_داروين();
    دع الدعم: مستوى_دعم_هدف = مستوى_دعم_هدف.مضيف_ذاتي();
    دع الهدف: واصف_هدف = {
        المعرف: المعرف,
        المعمارية: المعمارية,
        المنصة: المنصة,
        نموذج_البيانات: نموذج_البيانات,
        الواجهة_الثنائية: الواجهة_الثنائية,
        صيغة_الكائن: صيغة_الكائن,
        مزود_التشغيل: مزود_التشغيل,
        قواعد_السجلات: قواعد_السجلات,
        التركيب_الأصلي: التركيب_الأصلي,
        مزود_الإنهاء_التنفيذي: مزود_الإنهاء_التنفيذي,
        الدعم: الدعم
    };
    أرجع الهدف;
}

عرف هدف_إكس_ستة_وثمانون_أربعة_وستون_لينكس(): واصف_هدف {
    دع هوية_المنصة: هوية_منصة = هوية_منصة.لينكس();
    دع البيئة: هوية_بيئة = هوية_بيئة.جنو();
    دع المنصة: اختيار_منصة = {
        المنصة: هوية_المنصة,
        البيئة: البيئة
    };
    دع المعرف: معرف_هدف = معرف_هدف_من(1);
    دع المعمارية: اختيار_معمارية = معمارية_إكس_ستة_وثمانون_أربعة_وستون();
    دع نموذج_البيانات: نموذج_بيانات_هدف = نموذج_بيانات_إكس_ستة_وثمانون_أربعة_وستون();
    دع الواجهة_الثنائية: هوية_واجهة_ثنائية_هدف = هوية_واجهة_ثنائية_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون();
    دع صيغة_الكائن: صيغة_كائن_هدف = صيغة_كائن_هدف.إلف();
    دع مزود_التشغيل: مزود_تشغيل_هدف = مزود_تشغيل_هدف.لينكس();
    دع قواعد_السجلات: هوية_قواعد_سجلات_هدف = هوية_قواعد_سجلات_هدف.سيستم_في_إيه_إيه_إم_دي_أربعة_وستون();
    دع التركيب_الأصلي: هوية_تركيب_هدف_أصلي = هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف();
    دع مزود_الإنهاء_التنفيذي: هوية_مزود_إنهاء_تنفيذي_هدف = هوية_مزود_إنهاء_تنفيذي_هدف.إلف_لينكس();
    دع الدعم: مستوى_دعم_هدف = مستوى_دعم_هدف.تجريبي();
    دع الهدف: واصف_هدف = {
        المعرف: المعرف,
        المعمارية: المعمارية,
        المنصة: المنصة,
        نموذج_البيانات: نموذج_البيانات,
        الواجهة_الثنائية: الواجهة_الثنائية,
        صيغة_الكائن: صيغة_الكائن,
        مزود_التشغيل: مزود_التشغيل,
        قواعد_السجلات: قواعد_السجلات,
        التركيب_الأصلي: التركيب_الأصلي,
        مزود_الإنهاء_التنفيذي: مزود_الإنهاء_التنفيذي,
        الدعم: الدعم
    };
    أرجع الهدف;
}

عام عرف الأهداف_المسجلة(): متجه واصف_هدف {
    دع هدف_ماك: واصف_هدف = هدف_ذراع_أربعة_وستون_ماك();
    دع هدف_لينكس_التجريبي: واصف_هدف = هدف_إكس_ستة_وثمانون_أربعة_وستون_لينكس();
    دع الأهداف: متجه واصف_هدف = [
        هدف_ماك,
        هدف_لينكس_التجريبي
    ];
    أرجع الأهداف;
}

عرف يطابق_التكوين(
    الهدف: &واصف_هدف,
    المعمارية: هوية_معمارية,
    المنصة: هوية_منصة,
    البيئة: هوية_بيئة
): منطقي {
    دع القيمة: واصف_هدف = *الهدف;
    أرجع القيمة.المعمارية.الهوية == المعمارية
        && القيمة.المنصة.المنصة == المنصة
        && القيمة.المنصة.البيئة == البيئة;
}

عام عرف حل_بالتكوين(
    المعمارية: هوية_معمارية,
    المنصة: هوية_منصة,
    البيئة: هوية_بيئة
): نتيجة_حل_هدف {
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأهداف) مثل غير_موقع)) {
        لو (يطابق_التكوين(&الأهداف[ف], المعمارية, المنصة, البيئة)) {
            دع مرجع_الهدف: &واصف_هدف = &الأهداف[ف];
            دع الهدف: واصف_هدف = *مرجع_الهدف;
            أرجع نتيجة_حل_هدف.محلول(الهدف);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_حل_هدف.غير_مسجل();
}


// lookup by canonical TargetID only; this does not re-prove the registered tuple.
عام عرف حل_بمعرف_هدف(المعرف: معرف_هدف): نتيجة_حل_هدف {
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأهداف) مثل غير_موقع)) {
        لو (معرفا_هدف_متساويان(الأهداف[ف].المعرف, المعرف)) {
            دع مرجع_الهدف: &واصف_هدف = &الأهداف[ف];
            دع الهدف: واصف_هدف = *مرجع_الهدف;
            أرجع نتيجة_حل_هدف.محلول(الهدف);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_حل_هدف.غير_مسجل();
}


// Automatic target selection is based on the actual environment identity embedded
// in the running compiler executable. Support level is maturity metadata only and
// never substitutes for host detection.
عرف معمارية_هدف_من_مضيف(الهوية: هوية_معمارية_مضيف): هوية_معمارية {
    طابق الهوية مع
    | هوية_معمارية_مضيف.ذراع_أربعة_وستون -> { أرجع هوية_معمارية.ذراع_أربعة_وستون(); }
    | هوية_معمارية_مضيف.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون(); };
}

عرف منصة_هدف_من_مضيف(الهوية: هوية_منصة_مضيف): هوية_منصة {
    طابق الهوية مع
    | هوية_منصة_مضيف.داروين -> { أرجع هوية_منصة.ماك_أو_إس(); }
    | هوية_منصة_مضيف.لينكس -> { أرجع هوية_منصة.لينكس(); };
}

عرف بيئة_هدف_من_مضيف(الهوية: هوية_بيئة_مضيف): هوية_بيئة {
    طابق الهوية مع
    | هوية_بيئة_مضيف.غير_محددة -> { أرجع هوية_بيئة.غير_محددة(); }
    | هوية_بيئة_مضيف.جنو -> { أرجع هوية_بيئة.جنو(); }
    | هوية_بيئة_مضيف.مسل -> { أرجع هوية_بيئة.مسل(); };
}

عام عرف حل_هدف_المضيف_المسجل(): نتيجة_حل_هدف {
    طابق وصف_بيئة_المضيف_الحالية() مع
    | اختيار.لا_شيء -> { أرجع نتيجة_حل_هدف.غير_مسجل(); }
    | اختيار.بعض(المضيف) -> {
        أرجع حل_بالتكوين(
            معمارية_هدف_من_مضيف(المضيف.المعمارية),
            منصة_هدف_من_مضيف(المضيف.المنصة),
            بيئة_هدف_من_مضيف(المضيف.البيئة)
        );
    };
}
