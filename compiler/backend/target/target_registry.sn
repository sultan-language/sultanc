    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(29, «sparcv9-linux-gnu», «sparcv9-unknown-linux-gnu», هوية_معمارية.سبارك_أربعة_وستون(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.كبير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(30, «spirv64-unknown-unknown», «spirv64-unknown-unknown», هوية_معمارية.سبير_في_أربعة_وستون(), هوية_منصة.غير_محددة(), هوية_بيئة.غير_محددة(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.سبير_في(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(31, «s390x-linux-gnu», «s390x-unknown-linux-gnu», هوية_معمارية.سيستم_زد(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.كبير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(32, «ve-linux-gnu», «ve-unknown-linux-gnu», هوية_معمارية.في_إي(), هوية_منصة.لينكس(), هوية_بيئة.جنو(), 64, ترتيب_بايت.صغير(), صيغة_كائن_هدف.إلف(), نوع_مخرج_آلة_هدف.كائن()));
    ألحق(الأهداف, هدف_ترجمة_متقاطعة_مفوض(33, «xcore-unknown-unknown», «xcore-unknown-unknown», هوية_معمارية.إكس_كور(), هوية_منصة.عتاد_مباشر(), هوية_بيئة.غير_محددة(), 32, ترتيب_بايت.صغير(), صيغة_كائن_هدف.بلا_كائن(), نوع_مخرج_آلة_هدف.تجميع()));
    أرجع الأهداف;
}

عرف يطابق_التكوين(
    الهدف: &واصف_هدف,
    المعمارية: هوية_معمارية,
    المنصة: هوية_منصة,
    البيئة: هوية_بيئة
): منطقي {
    دع القيمة: واصف_هدف = *الهدف;
    أرجع القيمة.المعمارية.الهوية == المعمارية
        && القيمة.المنصة.المنصة == المنصة
        && القيمة.المنصة.البيئة == البيئة;
}

عام عرف حل_بالتكوين(
    المعمارية: هوية_معمارية,
    المنصة: هوية_منصة,
    البيئة: هوية_بيئة
): نتيجة_حل_هدف {
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأهداف) مثل غير_موقع)) {
        لو (يطابق_التكوين(&الأهداف[ف], المعمارية, المنصة, البيئة)) {
            دع مرجع_الهدف: &واصف_هدف = &الأهداف[ف];
            دع الهدف: واصف_هدف = *مرجع_الهدف;
            أرجع نتيجة_حل_هدف.محلول(الهدف);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_حل_هدف.غير_مسجل();
}

عام عرف حل_بمعرف_هدف(المعرف: معرف_هدف): نتيجة_حل_هدف {
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأهداف) مثل غير_موقع)) {
        لو (معرفا_هدف_متساويان(الأهداف[ف].المعرف, المعرف)) {
            دع مرجع_الهدف: &واصف_هدف = &الأهداف[ف];
            دع الهدف: واصف_هدف = *مرجع_الهدف;
            أرجع نتيجة_حل_هدف.محلول(الهدف);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_حل_هدف.غير_مسجل();
}

عرف معمارية_هدف_من_مضيف(الهوية: هوية_معمارية_مضيف): هوية_معمارية {
    طابق الهوية مع
    | هوية_معمارية_مضيف.ذراع_أربعة_وستون -> { أرجع هوية_معمارية.ذراع_أربعة_وستون(); }
    | هوية_معمارية_مضيف.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون(); };
}

عرف منصة_هدف_من_مضيف(الهوية: هوية_منصة_مضيف): هوية_منصة {
    طابق الهوية مع
    | هوية_منصة_مضيف.داروين -> { أرجع هوية_منصة.ماك_أو_إس(); }
    | هوية_منصة_مضيف.لينكس -> { أرجع هوية_منصة.لينكس(); };
}

عرف بيئة_هدف_من_مضيف(الهوية: هوية_بيئة_مضيف): هوية_بيئة {
    طابق الهوية مع
    | هوية_بيئة_مضيف.غير_محددة -> { أرجع هوية_بيئة.غير_محددة(); }
    | هوية_بيئة_مضيف.جنو -> { أرجع هوية_بيئة.جنو(); }
    | هوية_بيئة_مضيف.مسل -> { أرجع هوية_بيئة.مسل(); };
}

عام عرف حل_هدف_المضيف_المسجل(): نتيجة_حل_هدف {
    طابق وصف_بيئة_المضيف_الحالية() مع
    | اختيار.لا_شيء -> { أرجع نتيجة_حل_هدف.غير_مسجل(); }
    | اختيار.بعض(المضيف) -> {
        أرجع حل_بالتكوين(
            معمارية_هدف_من_مضيف(المضيف.المعمارية),
            منصة_هدف_من_مضيف(المضيف.المنصة),
            بيئة_هدف_من_مضيف(المضيف.البيئة)
        );
    };
}
