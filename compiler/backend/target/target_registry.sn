استورد compiler.backend.target.target_model;
استورد compiler.runtime.host_environment_model;

عرف معمارية_مقننة(الهوية: هوية_معمارية): اختيار_معمارية {
    دع المعالج: اختيار معرف_معالج = اختيار.لا_شيء();
    دع الميزات: متجه معرف_ميزة_معمارية = [];
    دع الاختيار: اختيار_معمارية = {
        الهوية: الهوية,
        المعالج: المعالج,
        الميزات: الميزات
    };
    أرجع الاختيار;
}

عرف نموذج_بيانات_مقنن(عرض_المؤشر: غير_موقع, ترتيب: ترتيب_بايت): نموذج_بيانات_هدف {
    دع النموذج: نموذج_بيانات_هدف = {
        عرض_المؤشر: عرض_المؤشر,
        ترتيب_البايت: ترتيب
    };
    أرجع النموذج;
}

عرف هدف_ترجمة_متقاطعة_مفوض(
    رقم_المعرف: غير_موقع,
    التهجئة: نص,
    الثلاثي: نص,
    هوية_المعمارية: هوية_معمارية,
    هوية_المنصة: هوية_منصة,
    هوية_البيئة: هوية_بيئة,
    عرض_المؤشر: غير_موقع,
    ترتيب: ترتيب_بايت,
    صيغة_الكائن: صيغة_كائن_هدف,
    نوع_المخرج: نوع_مخرج_آلة_هدف
): واصف_هدف {
    دع المنصة: اختيار_منصة = {
        المنصة: هوية_المنصة,
        البيئة: هوية_البيئة
    };
    دع الهدف: واصف_هدف = {
        المعرف: معرف_هدف_من(رقم_المعرف),
        التهجئة: التهجئة,
        الثلاثي_المقنن: الثلاثي,
        المعمارية: معمارية_مقننة(هوية_المعمارية),
        المنصة: المنصة,
        نموذج_البيانات: نموذج_بيانات_مقنن(عرض_المؤشر, ترتيب),
        الواجهة_الثنائية: هوية_واجهة_ثنائية_هدف.سلطان_محمولة(),
        صيغة_الكائن: صيغة_الكائن,
        مزود_التشغيل: مزود_تشغيل_هدف.غير_متاح(),
        قواعد_السجلات: هوية_قواعد_سجلات_هدف.مفوضة_للمزود(),
        التركيب_الأصلي: هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة(),
        نوع_مخرج_الآلة: نوع_المخرج,
        الدعم: مستوى_دعم_هدف.ترجمة_متقاطعة()
    };
    أرجع الهدف;
}

