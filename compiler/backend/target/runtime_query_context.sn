استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_allocation_model;
استورد compiler.backend.target.runtime_service_model;

// Target هو حد التركيب الوحيد بين المعمارية وسياسة Runtime المختارة.
عام عرف خطة_تخصيص_ذاكرة_للهدف(الهدف: &واصف_هدف): اختيار خطة_تخصيص_ذاكرة_هدف {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        دع الخدمة: خدمة_تشغيل_هدف = خدمة_تشغيل_هدف.تخصيص_ذاكرة();
        دع النداء: خطة_نداء_رمزي_تخصيص_ذاكرة_هدف = { الخدمة: الخدمة };
        أرجع اختيار.بعض(خطة_تخصيص_ذاكرة_هدف.نداء_رمزي(النداء));
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        دع الخدمة: خدمة_تشغيل_هدف = خدمة_تشغيل_هدف.تخصيص_ذاكرة();
        دع الخطة_الرمزية: خطة_نداء_رمزي_تخصيص_ذاكرة_هدف = {
            الخدمة: الخدمة
        };
        دع الخطة: خطة_تخصيص_ذاكرة_هدف = خطة_تخصيص_ذاكرة_هدف.نداء_رمزي(الخطة_الرمزية);
        أرجع اختيار.بعض(الخطة);
    }
    | هوية_تركيب_هدف_أصلي.ويب_أسمبلي_اثنان_وثلاثون_وحدة -> { أرجع اختيار.لا_شيء(); }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); };
}
