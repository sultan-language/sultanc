// نموذج Target محايد لتواقيع النداءات الخارجية التي لا تملك Type دلاليا داخل MSIR.
// لا يحمل سجلات ISA ولا تهجئة رمز ولا سياسة ABI؛ تلك تحل عبر Target لاحقا.
عام نوع صنف_قيمة_نداء_أصلي_هدف =
    | فراغ
    | ص32
    | صحيح_موقع_بحجم_المؤشر
    | صحيح_غير_موقع_بحجم_المؤشر
    | مؤشر
;

عام نوع توقيع_نداء_أصلي_هدف = {
    المعاملات: متجه صنف_قيمة_نداء_أصلي_هدف,
    الناتج: صنف_قيمة_نداء_أصلي_هدف,
    متغير_المعاملات: منطقي
};
