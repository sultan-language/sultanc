استورد compiler.runtime.service_identity;

// هوية خدمة الربط الأصلية داخل Backend. تبقى منفصلة عن تهجئة الرمز الخارجية.
عام نوع خدمة_تشغيل_هدف =
    | تخصيص_ذاكرة
    | إعادة_تخصيص_ذاكرة
    | تحرير_ذاكرة
    | خروج_العملية
;

عام عرف خدمة_تشغيل_هدف_من_هوية_مقننة(
    الهوية: هوية_خدمة_تشغيل
): اختيار خدمة_تشغيل_هدف {
    طابق الهوية مع
    | هوية_خدمة_تشغيل.تخصيص -> { أرجع اختيار.بعض(خدمة_تشغيل_هدف.تخصيص_ذاكرة()); }
    | هوية_خدمة_تشغيل.إعادة_تخصيص -> { أرجع اختيار.بعض(خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة()); }
    | هوية_خدمة_تشغيل.تحرير -> { أرجع اختيار.بعض(خدمة_تشغيل_هدف.تحرير_ذاكرة()); }
    | هوية_خدمة_تشغيل.خروج_العملية -> { أرجع اختيار.بعض(خدمة_تشغيل_هدف.خروج_العملية()); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام عرف انسخ_خدمة_تشغيل_هدف(الخدمة: خدمة_تشغيل_هدف): خدمة_تشغيل_هدف {
    طابق الخدمة مع
    | خدمة_تشغيل_هدف.تخصيص_ذاكرة -> { أرجع خدمة_تشغيل_هدف.تخصيص_ذاكرة(); }
    | خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة -> { أرجع خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة(); }
    | خدمة_تشغيل_هدف.تحرير_ذاكرة -> { أرجع خدمة_تشغيل_هدف.تحرير_ذاكرة(); }
    | خدمة_تشغيل_هدف.خروج_العملية -> { أرجع خدمة_تشغيل_هدف.خروج_العملية(); };
}

عام عرف خدمتا_تشغيل_هدف_متساويتان(أ: خدمة_تشغيل_هدف, ب: خدمة_تشغيل_هدف): منطقي {
    طابق أ مع
    | خدمة_تشغيل_هدف.تخصيص_ذاكرة -> {
        طابق ب مع | خدمة_تشغيل_هدف.تخصيص_ذاكرة -> { أرجع صواب; } | _ -> { أرجع خطأ; };
    }
    | خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة -> {
        طابق ب مع | خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة -> { أرجع صواب; } | _ -> { أرجع خطأ; };
    }
    | خدمة_تشغيل_هدف.تحرير_ذاكرة -> {
        طابق ب مع | خدمة_تشغيل_هدف.تحرير_ذاكرة -> { أرجع صواب; } | _ -> { أرجع خطأ; };
    }
    | خدمة_تشغيل_هدف.خروج_العملية -> {
        طابق ب مع | خدمة_تشغيل_هدف.خروج_العملية -> { أرجع صواب; } | _ -> { أرجع خطأ; };
    };
}
