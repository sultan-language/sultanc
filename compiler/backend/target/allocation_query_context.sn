استورد compiler.backend.target.target_model;
استورد compiler.backend.architectures.arm64.systems.macos.abi_rules;
استورد compiler.backend.architectures.x86_64.systems.linux.abi_rules;

// Target يركب استعلام سياسة محاذاة الإطار من ABI المسجل. ميكانيكا الإطار تبقى في Backend/architecture.
عام عرف محاذاة_إطار_تخصيص_للهدف(الهدف: &واصف_هدف): اختياري طبيعي {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع اختياري.موجود(محاذاة_إطار_ماك_ذراع_أربعة_وستون());
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_لينكس_إلف -> {
        أرجع اختياري.موجود(محاذاة_إطار_ماك_ذراع_أربعة_وستون());
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_ويندوز_كوف -> {
        أرجع اختياري.موجود(محاذاة_إطار_ماك_ذراع_أربعة_وستون());
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع اختياري.موجود(محاذاة_إطار_سيستم_في_إكس());
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_داروين_ماتشو -> {
        أرجع اختياري.موجود(محاذاة_إطار_سيستم_في_إكس());
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف -> {
        أرجع اختياري.موجود(محاذاة_إطار_سيستم_في_إكس());
    }
    | هوية_تركيب_هدف_أصلي.ويب_أسمبلي_اثنان_وثلاثون_وحدة -> { أرجع اختياري.لا_شيء(); }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختياري.لا_شيء(); };
}
