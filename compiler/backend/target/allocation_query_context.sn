استورد compiler.backend.target.target_model;
استورد compiler.backend.architectures.arm64.systems.macos.abi_rules;
استورد compiler.backend.architectures.x86_64.systems.linux.abi_rules;

// Target يركب استعلام سياسة محاذاة الإطار من ABI المسجل. ميكانيكا الإطار تبقى في Backend/architecture.
عام عرف محاذاة_إطار_تخصيص_للهدف(الهدف: &واصف_هدف): اختيار غير_موقع {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع اختيار.بعض(محاذاة_إطار_ماك_ذراع_أربعة_وستون());
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع اختيار.بعض(محاذاة_إطار_سيستم_في_إكس());
    };
}
