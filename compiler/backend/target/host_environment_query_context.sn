استورد compiler.backend.target.target_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.host_environment_model;

// Target owns projection of a selected target descriptor into the neutral host
// identity embedded in the executable being generated. Backends consume this
// query rather than reconstructing platform tuples independently.
عام عرف رمز_بدائي_هوية_مضيف_للهدف(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): اختيار عدد {
    دع الوصف: واصف_هدف = *الهدف;
    طابق البدائي مع
    | هوية_بدائي_مترجم.معمارية_المضيف -> {
        طابق الوصف.المعمارية.الهوية مع
        | هوية_معمارية.ذراع_أربعة_وستون -> {
            أرجع اختيار.بعض(رمز_معمارية_مضيف(هوية_معمارية_مضيف.ذراع_أربعة_وستون()));
        }
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
            أرجع اختيار.بعض(رمز_معمارية_مضيف(هوية_معمارية_مضيف.إكس_ستة_وثمانون_أربعة_وستون()));
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    }
    | هوية_بدائي_مترجم.منصة_المضيف -> {
        طابق الوصف.المنصة.المنصة مع
        | هوية_منصة.ماك_أو_إس -> {
            أرجع اختيار.بعض(رمز_منصة_مضيف(هوية_منصة_مضيف.داروين()));
        }
        | هوية_منصة.لينكس -> {
            أرجع اختيار.بعض(رمز_منصة_مضيف(هوية_منصة_مضيف.لينكس()));
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    }
    | هوية_بدائي_مترجم.بيئة_المضيف -> {
        طابق الوصف.المنصة.البيئة مع
        | هوية_بيئة.غير_محددة -> {
            أرجع اختيار.بعض(رمز_بيئة_مضيف(هوية_بيئة_مضيف.غير_محددة()));
        }
        | هوية_بيئة.جنو -> {
            أرجع اختيار.بعض(رمز_بيئة_مضيف(هوية_بيئة_مضيف.جنو()));
        }
        | هوية_بيئة.مسل -> {
            أرجع اختيار.بعض(رمز_بيئة_مضيف(هوية_بيئة_مضيف.مسل()));
        };
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}
