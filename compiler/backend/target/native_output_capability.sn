    قراءة_مقطع_مقبض_ملف: غير_موقع,
    كتابة_مقطع_مقبض_ملف: غير_موقع,
    إغلاق_مقبض_ملف: غير_موقع,
    تحريك_مقبض_ملف: غير_موقع,
    موضع_مقبض_ملف: غير_موقع,
    مزامنة_مقبض_ملف: غير_موقع,
    وقت_رتيب_نانو: غير_موقع,
    وقت_نظام_نانو: غير_موقع,
    نوم_نانو: غير_موقع,
    طول_متغير_بيئة: غير_موقع,
    قراءة_متغير_بيئة: غير_موقع,
    دليل_العمل: غير_موقع,
    الدليل_المؤقت: غير_موقع,
    تشغيل_عملية: غير_موقع,
    انتظار_عملية: غير_موقع,
    حجم_صفحة_النظام: غير_موقع,
    خريطة_ذاكرة_النظام: غير_موقع,
    إلغاء_خريطة_ذاكرة_النظام: غير_موقع,
    حماية_ذاكرة_النظام: غير_موقع,
    قفل_ذاكرة_النظام: غير_موقع,
    إلغاء_قفل_ذاكرة_النظام: غير_موقع,
    نصيحة_ذاكرة_النظام: غير_موقع,
};

عرف موضع_بدائي_تشغيل_إضافي_لينكس_إكس(
    البدائي: هوية_بدائي_مترجم,
    المواضع: &مواضع_بدائيات_تشغيل_إضافية_لينكس_إكس
): اختيار غير_موقع {
    دع المواقع: مواضع_بدائيات_تشغيل_إضافية_لينكس_إكس = *المواضع;
    طابق البدائي مع
    | هوية_بدائي_مترجم.تصنيف_خطأ_نظام -> { أرجع اختيار.بعض(المواقع.تصنيف_خطأ_نظام); }
    | هوية_بدائي_مترجم.إنشاء_دليل -> { أرجع اختيار.بعض(المواقع.إنشاء_دليل); }
    | هوية_بدائي_مترجم.إزالة_ملف -> { أرجع اختيار.بعض(المواقع.إزالة_ملف); }
    | هوية_بدائي_مترجم.إزالة_دليل -> { أرجع اختيار.بعض(المواقع.إزالة_دليل); }
    | هوية_بدائي_مترجم.إعادة_تسمية -> { أرجع اختيار.بعض(المواقع.إعادة_تسمية); }
    | هوية_بدائي_مترجم.نوع_مسار -> { أرجع اختيار.بعض(المواقع.نوع_مسار); }
    | هوية_بدائي_مترجم.حجم_مسار -> { أرجع اختيار.بعض(المواقع.حجم_مسار); }
    | هوية_بدائي_مترجم.وقت_تعديل_مسار -> { أرجع اختيار.بعض(المواقع.وقت_تعديل_مسار); }
    | هوية_بدائي_مترجم.فتح_مقبض_ملف_للقراءة -> { أرجع اختيار.بعض(المواقع.فتح_مقبض_ملف_للقراءة); }
    | هوية_بدائي_مترجم.إنشاء_مقبض_ملف_للكتابة -> { أرجع اختيار.بعض(المواقع.إنشاء_مقبض_ملف_للكتابة); }
    | هوية_بدائي_مترجم.قراءة_مقطع_مقبض_ملف -> { أرجع اختيار.بعض(المواقع.قراءة_مقطع_مقبض_ملف); }
    | هوية_بدائي_مترجم.كتابة_مقطع_مقبض_ملف -> { أرجع اختيار.بعض(المواقع.كتابة_مقطع_مقبض_ملف); }
    | هوية_بدائي_مترجم.إغلاق_مقبض_ملف -> { أرجع اختيار.بعض(المواقع.إغلاق_مقبض_ملف); }
    | هوية_بدائي_مترجم.تحريك_مقبض_ملف -> { أرجع اختيار.بعض(المواقع.تحريك_مقبض_ملف); }
    | هوية_بدائي_مترجم.موضع_مقبض_ملف -> { أرجع اختيار.بعض(المواقع.موضع_مقبض_ملف); }
    | هوية_بدائي_مترجم.مزامنة_مقبض_ملف -> { أرجع اختيار.بعض(المواقع.مزامنة_مقبض_ملف); }
    | هوية_بدائي_مترجم.وقت_رتيب_نانو -> { أرجع اختيار.بعض(المواقع.وقت_رتيب_نانو); }
    | هوية_بدائي_مترجم.وقت_نظام_نانو -> { أرجع اختيار.بعض(المواقع.وقت_نظام_نانو); }
    | هوية_بدائي_مترجم.نوم_نانو -> { أرجع اختيار.بعض(المواقع.نوم_نانو); }
    | هوية_بدائي_مترجم.طول_متغير_بيئة -> { أرجع اختيار.بعض(المواقع.طول_متغير_بيئة); }
    | هوية_بدائي_مترجم.قراءة_متغير_بيئة -> { أرجع اختيار.بعض(المواقع.قراءة_متغير_بيئة); }
    | هوية_بدائي_مترجم.دليل_العمل -> { أرجع اختيار.بعض(المواقع.دليل_العمل); }
    | هوية_بدائي_مترجم.الدليل_المؤقت -> { أرجع اختيار.بعض(المواقع.الدليل_المؤقت); }
    | هوية_بدائي_مترجم.تشغيل_عملية -> { أرجع اختيار.بعض(المواقع.تشغيل_عملية); }
    | هوية_بدائي_مترجم.انتظار_عملية -> { أرجع اختيار.بعض(المواقع.انتظار_عملية); }
    | هوية_بدائي_مترجم.حجم_صفحة_النظام -> { أرجع اختيار.بعض(المواقع.حجم_صفحة_النظام); }
    | هوية_بدائي_مترجم.خريطة_ذاكرة_النظام -> { أرجع اختيار.بعض(المواقع.خريطة_ذاكرة_النظام); }
    | هوية_بدائي_مترجم.إلغاء_خريطة_ذاكرة_النظام -> { أرجع اختيار.بعض(المواقع.إلغاء_خريطة_ذاكرة_النظام); }
    | هوية_بدائي_مترجم.حماية_ذاكرة_النظام -> { أرجع اختيار.بعض(المواقع.حماية_ذاكرة_النظام); }
    | هوية_بدائي_مترجم.قفل_ذاكرة_النظام -> { أرجع اختيار.بعض(المواقع.قفل_ذاكرة_النظام); }
    | هوية_بدائي_مترجم.إلغاء_قفل_ذاكرة_النظام -> { أرجع اختيار.بعض(المواقع.إلغاء_قفل_ذاكرة_النظام); }
    | هوية_بدائي_مترجم.نصيحة_ذاكرة_النظام -> { أرجع اختيار.بعض(المواقع.نصيحة_ذاكرة_النظام); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف انسخ_إزاحات_نداء_إكس_للتشغيل(
    القيم: &متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون
): متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون {
    دع النسخة: متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = *القيم;
    أرجع النسخة;
}

عام عرف أكمل_ترميز_تشغيل_إكس_للهدف(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف,
    دالة_الدخول: اختيار معرف_دالة_منتقاة
): اختيار خطأ_إكمال_ترميز_تشغيل_إكس {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { }
    | _ -> {
        دع و: واصف_هدف = *الهدف;
        أرجع اختيار.بعض(خطأ_إكمال_ترميز_تشغيل_إكس.هدف_غير_متطابق(و.المعرف));
    };

    دع الناتج: متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = *الشفرة;
    دع تخصيص_ذاكرة: غير_موقع = ألحق_خدمة_تخصيص_ذاكرة_لينكس_إكس(&متغير الناتج.البيانات);
    دع تحرير_ذاكرة: غير_موقع = ألحق_خدمة_تحرير_ذاكرة_لينكس_إكس(&متغير الناتج.البيانات);
    دع إعادة_تخصيص_ذاكرة: غير_موقع = ألحق_خدمة_إعادة_تخصيص_ذاكرة_لينكس_إكس(
        &متغير الناتج.البيانات, تخصيص_ذاكرة, تحرير_ذاكرة
    );
    دع إلحاق: غير_موقع = ألحق_بدائي_إلحاق_لينكس_إكس(
        &متغير الناتج.البيانات, تخصيص_ذاكرة, تحرير_ذاكرة
    );
    دع فتح_ملف_للقراءة: غير_موقع = ألحق_بدائي_فتح_ملف_للقراءة_لينكس_إكس(&متغير الناتج.البيانات);
    دع قراءة_بايت_ملف: غير_موقع = ألحق_بدائي_قراءة_بايت_ملف_لينكس_إكس(&متغير الناتج.البيانات);
    دع قراءة_مقطع_ملف: غير_موقع = ألحق_بدائي_قراءة_مقطع_ملف_لينكس_إكس(&متغير الناتج.البيانات);
    دع إنشاء_ملف_للكتابة: غير_موقع = ألحق_بدائي_إنشاء_ملف_للكتابة_لينكس_إكس(&متغير الناتج.البيانات);
    دع كتابة_مقطع_ملف: غير_موقع = ألحق_بدائي_كتابة_مقطع_ملف_لينكس_إكس(&متغير الناتج.البيانات);
    دع إغلاق_ملف: غير_موقع = ألحق_بدائي_إغلاق_ملف_لينكس_إكس(&متغير الناتج.البيانات);
    دع فتح_دليل: غير_موقع = ألحق_بدائي_فتح_دليل_لينكس_إكس(&متغير الناتج.البيانات);
