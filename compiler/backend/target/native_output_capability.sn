    دع تحريك_مقبض_ملف: غير_موقع = ألحق_بدائي_تحريك_مقبض_ملف_لينكس_إكس(&متغير الناتج.البيانات);
    دع موضع_مقبض_ملف: غير_موقع = ألحق_بدائي_موضع_مقبض_ملف_لينكس_إكس(&متغير الناتج.البيانات);
    دع مزامنة_مقبض_ملف: غير_موقع = ألحق_بدائي_مزامنة_مقبض_ملف_لينكس_إكس(&متغير الناتج.البيانات);
    دع وقت_رتيب_نانو: غير_موقع = ألحق_بدائي_وقت_رتيب_نانو_لينكس_إكس(&متغير الناتج.البيانات);
    دع وقت_نظام_نانو: غير_موقع = ألحق_بدائي_وقت_نظام_نانو_لينكس_إكس(&متغير الناتج.البيانات);
    دع نوم_نانو: غير_موقع = ألحق_بدائي_نوم_نانو_لينكس_إكس(&متغير الناتج.البيانات);
    دع طول_متغير_بيئة: غير_موقع = ألحق_بدائي_طول_متغير_بيئة_لينكس_إكس(&متغير الناتج.البيانات);
