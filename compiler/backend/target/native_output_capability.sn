    دع تصنيف_خطأ_نظام: غير_موقع = ألحق_بدائي_تصنيف_خطأ_نظام_لينكس_إكس(&متغير الناتج.البيانات);
    دع إنشاء_دليل: غير_موقع = ألحق_بدائي_إنشاء_دليل_لينكس_إكس(&متغير الناتج.البيانات);
    دع إزالة_ملف: غير_موقع = ألحق_بدائي_إزالة_ملف_لينكس_إكس(&متغير الناتج.البيانات);
