عرف ألحق_إزاحة_مرفق_تشغيل_لينكس_إكس(
    الإزاحات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    الموضع: غير_موقع,
    المرفق: مرفق_مضيف_هدف
): فراغ {
    دع الحالة: متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = *الإزاحات;
    دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.مرفق_مضيف(المرفق);
    دع الإضافة: عدد = -4;
    دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
        نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
    دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
        إزاحة_بايت: الموضع,
        النوع: نوع_الإزاحة,
        الرمز: الرمز,
        الإضافة: الإضافة
    };
    ألحق(الحالة, الإزاحة);
    *الإزاحات := الحالة;
}

