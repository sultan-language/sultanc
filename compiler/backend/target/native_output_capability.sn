        إلغاء_خريطة_ذاكرة_النظام: إلغاء_خريطة_ذاكرة_النظام,
        حماية_ذاكرة_النظام: حماية_ذاكرة_النظام,
        قفل_ذاكرة_النظام: قفل_ذاكرة_النظام,
        إلغاء_قفل_ذاكرة_النظام: إلغاء_قفل_ذاكرة_النظام,
        نصيحة_ذاكرة_النظام: نصيحة_ذاكرة_النظام,
        عشوائية_آمنة: عشوائية_آمنة,
        إنشاء_مقبس: إنشاء_مقبس,
        اتصال_مقبس: اتصال_مقبس,
        ربط_مقبس: ربط_مقبس,
        استماع_مقبس: استماع_مقبس,
        قبول_مقبس: قبول_مقبس,
        إرسال_مقبس: إرسال_مقبس,
        استقبال_مقبس: استقبال_مقبس,
        إيقاف_مقبس: إيقاف_مقبس,
        إغلاق_مقبس: إغلاق_مقبس,
        ترميز_عنوان_مقبس: ترميز_عنوان_مقبس,
        ضبط_مقبس_غير_حاصر: ضبط_مقبس_غير_حاصر,
        ضبط_خيار_مقبس: ضبط_خيار_مقبس,
        إنشاء_جلسة_تي_إل_إس: إنشاء_جلسة_تي_إل_إس,
        ضبط_اسم_نظير_تي_إل_إس: ضبط_اسم_نظير_تي_إل_إس,
        ضبط_تحقق_تي_إل_إس: ضبط_تحقق_تي_إل_إس,
        ضبط_هوية_خادم_تي_إل_إس: ضبط_هوية_خادم_تي_إل_إس,
        ضبط_جذور_ثقة_تي_إل_إس: ضبط_جذور_ثقة_تي_إل_إس,
        مصافحة_تي_إل_إس: مصافحة_تي_إل_إس,
        قراءة_تي_إل_إس: قراءة_تي_إل_إس,
        كتابة_تي_إل_إس: كتابة_تي_إل_إس,
        إغلاق_جلسة_تي_إل_إس: إغلاق_جلسة_تي_إل_إس,
        إنشاء_حلقة_أحداث: إنشاء_حلقة_أحداث,
        تحكم_حلقة_أحداث: تحكم_حلقة_أحداث,
        انتظار_حلقة_أحداث: انتظار_حلقة_أحداث,
        إغلاق_حلقة_أحداث: إغلاق_حلقة_أحداث,
        حل_اسم_مضيف: حل_اسم_مضيف,
        إنشاء_خيط: إنشاء_خيط,
        انتظار_خيط: انتظار_خيط,
        إنشاء_قفل_تبادلي: إنشاء_قفل_تبادلي,
        تدمير_قفل_تبادلي: تدمير_قفل_تبادلي,
        قفل_تبادلي: قفل_تبادلي,
        فتح_قفل_تبادلي: فتح_قفل_تبادلي,
        إنشاء_شرط: إنشاء_شرط,
        تدمير_شرط: تدمير_شرط,
        انتظار_شرط: انتظار_شرط,
        إشارة_شرط: إشارة_شرط,
        بث_شرط: بث_شرط
    };

    دع الأصل: متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون =
        انسخ_إزاحات_نداء_إكس_للتشغيل(&الناتج.إزاحات_النداء);
    دع الباقية: متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأصل) مثل غير_موقع)) {
        دع مرجع_النداء: &إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = &الأصل[ف];
        دع النداء: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = *مرجع_النداء;
        دع موضع_محلي: متغير اختيار غير_موقع = اختيار.لا_شيء();
        طابق النداء.الرمز مع
        | مرجع_رمز_كائن.خدمة_تشغيل(الخدمة) -> {
            طابق الخدمة مع
            | خدمة_تشغيل_هدف.تخصيص_ذاكرة -> { موضع_محلي := اختيار.بعض(تخصيص_ذاكرة); }
            | خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة -> { موضع_محلي := اختيار.بعض(إعادة_تخصيص_ذاكرة); }
            | خدمة_تشغيل_هدف.تحرير_ذاكرة -> { موضع_محلي := اختيار.بعض(تحرير_ذاكرة); }
            | _ -> { };
        }
        | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> {
            موضع_محلي := موضع_بدائي_تشغيل_لينكس_إكس_للهدف(
                البدائي,
                إلحاق,
                تحرير_ذاكرة
            );
        }
        | مرجع_رمز_كائن.رمز_خارجي(المعرف) -> {
            طابق حل_تصدير_تشغيل_دالة_خارجية(الرموز_الخارجية, المعرف) مع
            | اختيار.بعض(التصدير) -> {
                موضع_محلي := موضع_تصدير_تشغيل_لينكس_إكس_للهدف(
                    التصدير,
                    إلحاق,
                    تحرير_ذاكرة,
                    فتح_ملف_للقراءة,
                    قراءة_بايت_ملف,
                    قراءة_مقطع_ملف,
                    إنشاء_ملف_للكتابة,
                    كتابة_مقطع_ملف,
                    إغلاق_ملف,
                    فتح_دليل,
                    قراءة_مدخل_دليل,
                    إغلاق_دليل,
                    قراءة_بايت_دخل,
                    قراءة_مقطع_دخل,
                    كتابة_بايتات_تنفيذية,
                    خرج,
                    خطأ_قياسي,
                    عدد_الوسائط,
                    وسيط,
                    خروج,
                    نص_من_بايتات
                );
                طابق موضع_محلي مع
                | اختيار.بعض(_) -> { }
                | اختيار.لا_شيء -> {
                    موضع_محلي :=
                        موضع_تصدير_تشغيل_إضافي_لينكس_إكس(التصدير, &مواضع_إضافية);
                };
            }
            | اختيار.لا_شيء -> { };
        }
        | _ -> { };
        طابق موضع_محلي مع
        | اختيار.بعض(الموضع) -> {
            لو (!اصلح_نداء_محلي_لينكس_إكس(&متغير الناتج.البيانات, النداء.إزاحة_بايت, الموضع)) {
                أرجع اختيار.بعض(خطأ_إكمال_ترميز_تشغيل_إكس.نداء_تشغيل_خارج_المدى());
            };
        }
        | اختيار.لا_شيء -> {
            دع الرمز: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&النداء.الرمز);
            دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون = النداء.النوع;
            دع المتبقي: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
                إزاحة_بايت: النداء.إزاحة_بايت,
                النوع: نوع_الإزاحة,
                الرمز: الرمز,
                الإضافة: النداء.الإضافة
            };
            ألحق(الباقية, المتبقي);
        };
        ف := ف + 1;
    }

    الناتج.دخول_عملية_لينكس := اختيار.لا_شيء();
    طابق دالة_الدخول مع
    | اختيار.بعض(الدالة) -> {
        دع بداية_الدخول: غير_موقع = الطول(الناتج.البيانات) مثل غير_موقع;
        دع موضع_الحقل: غير_موقع = ألحق_دخول_عملية_لينكس_إكس(&متغير الناتج.البيانات);
        دع نهاية_الدخول: غير_موقع = الطول(الناتج.البيانات) مثل غير_موقع;
        دع حجم_الدخول: غير_موقع = نهاية_الدخول - بداية_الدخول;
        دع رمز_الدخول: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدالة);
        دع إضافة_الدخول: عدد = -4;
        دع نوع_إزاحة_الدخول: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
            نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
        دع نداء_الدخول: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: موضع_الحقل,
            النوع: نوع_إزاحة_الدخول,
            الرمز: رمز_الدخول,
            الإضافة: إضافة_الدخول
        };
        ألحق(الباقية, نداء_الدخول);
        دع الدخول: دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: بداية_الدخول,
            حجم_بايت: حجم_الدخول
        };
        الناتج.دخول_عملية_لينكس := اختيار.بعض(الدخول);
    }
    | اختيار.لا_شيء -> { };
    الناتج.إزاحات_النداء := الباقية;
    *الشفرة := الناتج;
    أرجع اختيار.لا_شيء();
}
