استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.backend.target.host_facility_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.architectures.arm64.encoded_code;
استورد compiler.backend.architectures.arm64.systems.macos.runtime_rules;
استورد compiler.backend.architectures.x86_64.encoded_code;
استورد compiler.backend.architectures.x86_64.systems.linux.runtime_rules;
استورد compiler.backend.object.object_reference_model;

// هوية قدرة المخرج هي إسقاط من تركيب Target المحلول، وليست مدقق توافق ثان.
عام نوع قدرة_مخرج_أصلي =
    | ذراع_أربعة_وستون_داروين_ماتشو
    | إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف
    | غير_متاحة
;

عام عرف حل_قدرة_مخرج_أصلي(الهدف: &واصف_هدف): قدرة_مخرج_أصلي {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع قدرة_مخرج_أصلي.ذراع_أربعة_وستون_داروين_ماتشو();
    }
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع قدرة_مخرج_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف();
    };
}

عام نوع خطأ_إكمال_ترميز_تشغيل_ذراع =
    | هدف_غير_متطابق بنوع معرف_هدف
    | بدائي_غير_مدعوم بنوع هوية_بدائي_مترجم
    | نداء_تشغيل_خارج_المدى
;

عرف اصلح_نداء_مشترك_داروين_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    موضع_النداء_في_الدالة: غير_موقع,
    موضع_النداء_في_النص: غير_موقع,
    موضع_الهدف_في_النص: غير_موقع
): منطقي {
    لو ((موضع_النداء_في_الدالة % 4) != 0
        || (موضع_النداء_في_النص % 4) != 0
        || (موضع_الهدف_في_النص % 4) != 0) { أرجع خطأ; };
    لو (موضع_الهدف_في_النص < موضع_النداء_في_النص) { أرجع خطأ; };
    دع الفرق: غير_موقع = موضع_الهدف_في_النص - موضع_النداء_في_النص;
    لو ((الفرق % 4) != 0 || الفرق >= 134217728) { أرجع خطأ; };
    دع فهرس_الكلمة: غير_موقع = موضع_النداء_في_الدالة / 4;
    دع حالة: متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة = *الكلمات;
    لو (فهرس_الكلمة >= (الطول(حالة) مثل غير_موقع)) { أرجع خطأ; };
    دع قيمة_الكلمة: غير_موقع = 0x94000000 + (الفرق / 4);
    دع الكلمة: كلمة_ذراع_أربعة_وستون_مشفرة = { القيمة: قيمة_الكلمة };
    حالة[فهرس_الكلمة] := الكلمة;
    *الكلمات := حالة;
    أرجع صواب;
}

عرف مرجع_إزاحة_تشغيل_داروين_ذراع(
    الهدف: &هدف_إزاحة_تشغيل_داروين_ذراع
): مرجع_رمز_كائن {
    طابق *الهدف مع
    | هدف_إزاحة_تشغيل_داروين_ذراع.خدمة(الخدمة) -> {
        دع المنسوخة: خدمة_تشغيل_هدف = انسخ_خدمة_تشغيل_هدف(الخدمة);
        أرجع مرجع_رمز_كائن.خدمة_تشغيل(المنسوخة);
    }
    | هدف_إزاحة_تشغيل_داروين_ذراع.مرفق(المرفق) -> {
        دع المنسوخ: مرفق_مضيف_هدف = انسخ_مرفق_مضيف_هدف(المرفق);
        أرجع مرجع_رمز_كائن.مرفق_مضيف(المنسوخ);
    };
}

عام عرف أكمل_ترميز_تشغيل_ذراع_للهدف(
    الشفرة: &متغير شفرة_ذراع_أربعة_وستون_مشفرة,
    الهدف: &واصف_هدف
): اختيار خطأ_إكمال_ترميز_تشغيل_ذراع {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> { }
    | _ -> {
        دع و: واصف_هدف = *الهدف;
        دع معرف_الهدف: معرف_هدف = و.المعرف;
        دع الخطأ: خطأ_إكمال_ترميز_تشغيل_ذراع =
            خطأ_إكمال_ترميز_تشغيل_ذراع.هدف_غير_متطابق(معرف_الهدف);
        أرجع اختيار.بعض(الخطأ);
    };

    // Encoded functions are appended in dense MSIR FunctionID order by native_output.
    // Record each function's final text start once so runtime calls can be patched
    // against one shared runtime image instead of rescanning all relocations per function.
    دع الناتج: متغير شفرة_ذراع_أربعة_وستون_مشفرة = *الشفرة;
    دع عدد_الدوال: غير_موقع = الطول(الناتج.الدوال) مثل غير_موقع;
    دع بدايات_الدوال: متغير متجه غير_موقع = [];
    دع نهاية_النص: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الدوال) {
        دع معرف_الدالة: معرف_دالة_منتقاة = الناتج.الدوال[ف].المعرف;
        لو (معرف_الدالة.القيمة != ف) {
            أرجع اختيار.بعض(خطأ_إكمال_ترميز_تشغيل_ذراع.نداء_تشغيل_خارج_المدى());
        };
        ألحق(بدايات_الدوال, نهاية_النص);
        دع عدد_كلمات_الدالة: غير_موقع = الطول(الناتج.الدوال[ف].الكلمات) مثل غير_موقع;
        نهاية_النص := نهاية_النص + عدد_كلمات_الدالة * 4;
        ف := ف + 1;
    }

    دع الصورة: صورة_تشغيل_داروين_ذراع = ابن_صورة_تشغيل_داروين_ذراع();
    دع عدد_كلمات_الصورة: غير_موقع = الطول(الصورة.الكلمات) مثل غير_موقع;
    دع عدد_إزاحات_الصورة: غير_موقع = الطول(الصورة.الإزاحات) مثل غير_موقع;
    دع الإزاحات_الباقية: متغير متجه طلب_إزاحة_نص_كائن = [];
    دع عدد_الإزاحات: غير_موقع = الطول(الناتج.المرفقات.إزاحات_النص) مثل غير_موقع;
    دع أضيفت_صورة_التشغيل: متغير منطقي = خطأ;
    دع فهرس_مالك_التشغيل: متغير غير_موقع = 0;
    دع قاعدة_التشغيل_في_المالك: متغير غير_موقع = 0;

    دع ر: متغير غير_موقع = 0;
    بينما (ر < عدد_الإزاحات) {
        دع الطلب: طلب_إزاحة_نص_كائن =
            انسخ_طلب_إزاحة_نص_كائن(&الناتج.المرفقات.إزاحات_النص[ر]);
        طابق الطلب.الرمز مع
        | مرجع_رمز_كائن.بدائي_تشغيل(البدائي) -> {
            لو (عدد_الدوال == 0) {
                أرجع اختيار.بعض(خطأ_إكمال_ترميز_تشغيل_ذراع.نداء_تشغيل_خارج_المدى());
            };
            لو (!أضيفت_صورة_التشغيل) {
                فهرس_مالك_التشغيل := عدد_الدوال - 1;
                قاعدة_التشغيل_في_المالك :=
                    الطول(الناتج.الدوال[فهرس_مالك_التشغيل].الكلمات) مثل غير_موقع;
                قاعدة_التشغيل_في_المالك := قاعدة_التشغيل_في_المالك * 4;
                دع ك: متغير غير_موقع = 0;
                بينما (ك < عدد_كلمات_الصورة) {
                    دع كلمة: كلمة_ذراع_أربعة_وستون_مشفرة = { القيمة: الصورة.الكلمات[ك] };
                    ألحق(الناتج.الدوال[فهرس_مالك_التشغيل].الكلمات, كلمة);
                    ك := ك + 1;
                }
                ك := 0;
                بينما (ك < عدد_إزاحات_الصورة) {
                    دع إزاحة_التشغيل: إزاحة_تشغيل_داروين_ذراع = الصورة.الإزاحات[ك];
                    دع إزاحة_الموضع: غير_موقع =
                        قاعدة_التشغيل_في_المالك + إزاحة_التشغيل.إزاحة_بايت;
                    دع الموضع: موضع_إزاحة_نص_كائن = {
                        الدالة: الناتج.الدوال[فهرس_مالك_التشغيل].المعرف,
                        إزاحة_بايت: إزاحة_الموضع
                    };
                    دع هدف_الإزاحة: هدف_إزاحة_تشغيل_داروين_ذراع = إزاحة_التشغيل.الهدف;
                    دع الرمز: مرجع_رمز_كائن =
                        مرجع_إزاحة_تشغيل_داروين_ذراع(&هدف_الإزاحة);
                    دع نوع_الإزاحة: نوع_إزاحة_رمزية_كائن =
                        نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت();
                    دع الطلب_الجديد: طلب_إزاحة_نص_كائن = {
                        الموضع: الموضع,
                        النوع: نوع_الإزاحة,
                        الرمز: الرمز,
                        الإضافة: 0
                    };
                    ألحق(الإزاحات_الباقية, الطلب_الجديد);
                    ك := ك + 1;
                }
                أضيفت_صورة_التشغيل := صواب;
            };

            طابق موضع_بدائي_تشغيل_داروين_ذراع(البدائي) مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(خطأ_إكمال_ترميز_تشغيل_ذراع.بدائي_غير_مدعوم(البدائي));
            }
            | اختيار.بعض(موضع_البدائي) -> {
                دع موضع_الطلب: موضع_إزاحة_نص_كائن = الطلب.الموضع;
                دع فهرس_الدالة: غير_موقع = موضع_الطلب.الدالة.القيمة;
                لو (فهرس_الدالة >= عدد_الدوال
                    || الناتج.الدوال[فهرس_الدالة].المعرف.القيمة != فهرس_الدالة) {
                    أرجع اختيار.بعض(خطأ_إكمال_ترميز_تشغيل_ذراع.نداء_تشغيل_خارج_المدى());
                };
                دع موضع_النداء_في_النص: غير_موقع =
                    بدايات_الدوال[فهرس_الدالة] + موضع_الطلب.إزاحة_بايت;
                دع موضع_الهدف_في_النص: غير_موقع = نهاية_النص + موضع_البدائي;
                لو (!اصلح_نداء_مشترك_داروين_ذراع(
                    &متغير الناتج.الدوال[فهرس_الدالة].الكلمات,
                    موضع_الطلب.إزاحة_بايت,
                    موضع_النداء_في_النص,
                    موضع_الهدف_في_النص
                )) {
                    أرجع اختيار.بعض(خطأ_إكمال_ترميز_تشغيل_ذراع.نداء_تشغيل_خارج_المدى());
                };
            };
        }
        | _ -> { ألحق(الإزاحات_الباقية, الطلب); };
        ر := ر + 1;
    }

    الناتج.المرفقات.إزاحات_النص := الإزاحات_الباقية;
    *الشفرة := الناتج;
    أرجع اختيار.لا_شيء();
}

عام نوع خطأ_إكمال_ترميز_تشغيل_إكس =
    | هدف_غير_متطابق بنوع معرف_هدف
    | نداء_تشغيل_خارج_المدى
;

عرف موضع_بدائي_تشغيل_لينكس_إكس_للهدف(
    البدائي: هوية_بدائي_مترجم,
    إلحاق: غير_موقع,
    تحرير: غير_موقع,
    فتح_ملف_للقراءة: غير_موقع,
    قراءة_بايت_ملف: غير_موقع,
    قراءة_مقطع_ملف: غير_موقع,
    إنشاء_ملف_للكتابة: غير_موقع,
    كتابة_مقطع_ملف: غير_موقع,
    إغلاق_ملف: غير_موقع,
    فتح_دليل: غير_موقع,
    قراءة_مدخل_دليل: غير_موقع,
    إغلاق_دليل: غير_موقع,
    قراءة_بايت_دخل: غير_موقع,
    قراءة_مقطع_دخل: غير_موقع,
    كتابة_بايتات_تنفيذية: غير_موقع,
    خرج: غير_موقع,
    خطأ_قياسي: غير_موقع,
    عدد_الوسائط: غير_موقع,
    وسيط: غير_موقع,
    خروج: غير_موقع,
    نص_من_بايتات: غير_موقع
): اختيار غير_موقع {
    طابق البدائي مع
    | هوية_بدائي_مترجم.إلحاق -> { أرجع اختيار.بعض(إلحاق); }
    | هوية_بدائي_مترجم.تحرير -> { أرجع اختيار.بعض(تحرير); }
    | هوية_بدائي_مترجم.فتح_ملف_للقراءة -> { أرجع اختيار.بعض(فتح_ملف_للقراءة); }
    | هوية_بدائي_مترجم.قراءة_بايت_ملف -> { أرجع اختيار.بعض(قراءة_بايت_ملف); }
    | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> { أرجع اختيار.بعض(قراءة_مقطع_ملف); }
    | هوية_بدائي_مترجم.إنشاء_ملف_للكتابة -> { أرجع اختيار.بعض(إنشاء_ملف_للكتابة); }
    | هوية_بدائي_مترجم.كتابة_مقطع_ملف -> { أرجع اختيار.بعض(كتابة_مقطع_ملف); }
    | هوية_بدائي_مترجم.إغلاق_ملف -> { أرجع اختيار.بعض(إغلاق_ملف); }
    | هوية_بدائي_مترجم.فتح_دليل -> { أرجع اختيار.بعض(فتح_دليل); }
    | هوية_بدائي_مترجم.قراءة_مدخل_دليل -> { أرجع اختيار.بعض(قراءة_مدخل_دليل); }
    | هوية_بدائي_مترجم.إغلاق_دليل -> { أرجع اختيار.بعض(إغلاق_دليل); }
    | هوية_بدائي_مترجم.قراءة_بايت_الدخل_القياسي -> { أرجع اختيار.بعض(قراءة_بايت_دخل); }
    | هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي -> { أرجع اختيار.بعض(قراءة_مقطع_دخل); }
    | هوية_بدائي_مترجم.كتابة_بايتات_تنفيذية -> { أرجع اختيار.بعض(كتابة_بايتات_تنفيذية); }
    | هوية_بدائي_مترجم.كتابة_الخرج_القياسي -> { أرجع اختيار.بعض(خرج); }
    | هوية_بدائي_مترجم.كتابة_الخطأ_القياسي -> { أرجع اختيار.بعض(خطأ_قياسي); }
    | هوية_بدائي_مترجم.عدد_الوسائط -> { أرجع اختيار.بعض(عدد_الوسائط); }
    | هوية_بدائي_مترجم.الوصول_إلى_وسيط -> { أرجع اختيار.بعض(وسيط); }
    | هوية_بدائي_مترجم.خروج_العملية -> { أرجع اختيار.بعض(خروج); }
    | هوية_بدائي_مترجم.نص_من_بايتات -> { أرجع اختيار.بعض(نص_من_بايتات); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام نوع مواضع_بدائيات_تشغيل_إضافية_لينكس_إكس = {
    تصنيف_خطأ_نظام: غير_موقع,
    إنشاء_دليل: غير_موقع,
    إزالة_ملف: غير_موقع,
    إزالة_دليل: غير_موقع,
    إعادة_تسمية: غير_موقع,
