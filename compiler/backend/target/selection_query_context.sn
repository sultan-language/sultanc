استورد compiler.backend.target.target_abi_resolution;
استورد compiler.msir.identifiers;
استورد compiler.backend.abi.abi_model;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.layout.layout_resolution;
استورد compiler.backend.layout.alignment;
استورد compiler.backend.target.target_model;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.msir.msir_consumer;

// سياق Backend صريح يعزل طبقة الاختيار عن نموذج Type. لا يضيف دلالات؛ يحتفظ بسجل الحقائق المقنن فقط.
عام نوع سياق_استعلام_اختيار_خلفية = {
    الأنواع: سجل_أنواع
};

عام عرف أنشئ_سياق_استعلام_اختيار_خلفية(الأنواع: سجل_أنواع): سياق_استعلام_اختيار_خلفية {
    دع السياق: سياق_استعلام_اختيار_خلفية = { الأنواع: الأنواع };
    أرجع السياق;
}


عام نوع خطأ_حل_واجهة_اختيار =
    | فشل_واجهة_هدف بنوع خطأ_حل_واجهة_هدف
    | معامل_دالة_مفقود بنوع (معرف_دالة_مسير, طبيعي)
    | نوع_قيمة_مفقود بنوع معرف_قيمة_مسير
;

عام عرف صنف_إشارة_قيمة_مسير_للاختيار(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    القيمة: معرف_قيمة_مسير
): اختياري صنف_إشارة_عدد_خلفية {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *السياق;
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        أرجع صنف_إشارة_عدد_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عام عرف حل_واجهة_عرض_دالة_مسير_للهدف(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العرض: &عرض_دالة_مسير
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_اختيار {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *السياق;
    دع الدالة: عرض_دالة_مسير = *العرض;
    دع المعاملات: متغير متجه معرف_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الدالة.عدد_المعاملات) {
        طابق معامل_دالة_مسير_عند(المسير, الدالة.المعرف, ف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_حل_واجهة_اختيار.معامل_دالة_مفقود(الدالة.المعرف, ف));
        }
        | اختياري.موجود(القيمة) -> {
            ألحق(المعاملات, القيمة.النوع);
        };
        ف := ف + 1;
    }
    طابق حل_خطة_واجهة_دالة_اختيارية_للهدف(
        &حقائق.الأنواع, الهدف, سجل_التخطيط, &المعاملات, الدالة.الناتج
    ) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_حل_واجهة_اختيار.فشل_واجهة_هدف(الخطأ));
    }
    | نتيجة.نجح(الخطة) -> { أرجع نتيجة.نجح(الخطة); };
}


// Argument and result Types of an MSIR call, shared by both call boundaries.
عرف أنواع_نداء_قيم_مسير(
    المسير: &سياق_مستهلك_مسير,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    أنواع_الحجج: &متغير متجه معرف_نوع,
    نوع_الناتج: &متغير اختياري معرف_نوع
): اختياري خطأ_حل_واجهة_اختيار {
    دع قيم_الحجج: متجه معرف_قيمة_مسير = *الحجج;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(قيم_الحجج) مثل طبيعي)) {
        طابق نوع_قيمة_مسير(المسير, قيم_الحجج[ف]) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_حل_واجهة_اختيار.نوع_قيمة_مفقود(قيم_الحجج[ف]));
        }
        | اختياري.موجود(النوع) -> { ألحق(*أنواع_الحجج, النوع); };
        ف := ف + 1;
    }
    طابق الناتج مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق نوع_قيمة_مسير(المسير, القيمة) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_حل_واجهة_اختيار.نوع_قيمة_مفقود(القيمة));
        }
        | اختياري.موجود(النوع) -> { *نوع_الناتج := اختياري.موجود(النوع); };
    };
    أرجع اختياري.لا_شيء();
}

// A call between SultanC functions (internal SultanC ABI).
عام عرف حل_واجهة_نداء_قيم_مسير_للهدف(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_اختيار {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *السياق;
    دع أنواع_الحجج: متغير متجه معرف_نوع = [];
    دع نوع_الناتج: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق أنواع_نداء_قيم_مسير(المسير, الحجج, الناتج, &متغير أنواع_الحجج, &متغير نوع_الناتج) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };
    طابق حل_خطة_واجهة_دالة_اختيارية_للهدف(
        &حقائق.الأنواع, الهدف, سجل_التخطيط, &أنواع_الحجج, نوع_الناتج
    ) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_حل_واجهة_اختيار.فشل_واجهة_هدف(الخطأ));
    }
    | نتيجة.نجح(الخطة) -> { أرجع نتيجة.نجح(الخطة); };
}

// A call to a declared external function (the foreign boundary; see
// حل_خطة_واجهة_دالة_خارجية_للهدف).
عام عرف حل_واجهة_نداء_خارجي_قيم_مسير_للهدف(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): نتيجة خطة_دالة_واجهة, خطأ_حل_واجهة_اختيار {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *السياق;
    دع أنواع_الحجج: متغير متجه معرف_نوع = [];
    دع نوع_الناتج: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق أنواع_نداء_قيم_مسير(المسير, الحجج, الناتج, &متغير أنواع_الحجج, &متغير نوع_الناتج) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };
    طابق حل_خطة_واجهة_دالة_خارجية_للهدف(
        &حقائق.الأنواع, الهدف, سجل_التخطيط, &أنواع_الحجج, نوع_الناتج
    ) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_حل_واجهة_اختيار.فشل_واجهة_هدف(الخطأ));
    }
    | نتيجة.نجح(الخطة) -> { أرجع نتيجة.نجح(الخطة); };
}

عام عرف عدد_سجلات_افتراضية_لدالة_مسير(
    المسير: &سياق_مستهلك_مسير,
    العرض: &عرض_دالة_مسير
): طبيعي {
    دع الدالة: عرض_دالة_مسير = *العرض;
    طابق عدد_قيم_دالة_مسير(المسير, الدالة.المعرف) مع
    | اختياري.موجود(العدد) -> { أرجع العدد; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عام نوع خطة_سجلات_واجهة_اختيار = {
    المعاملات: متجه اختياري مرجع_سجل_واجهة,
    الناتج: اختياري مرجع_سجل_واجهة
};

عام نوع نتيجة_خطة_سجلات_واجهة_اختيار =
    | صالحة بنوع خطة_سجلات_واجهة_اختيار
    | غير_متاحة
;

عرف مرجع_سجل_من_موقع_واجهة(الموقع: &موقع_تمرير_واجهة): اختياري مرجع_سجل_واجهة {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الموضع) -> {
        طابق الموضع مع
        | موضع_جزء_واجهة.سجل(المرجع) -> { أرجع اختياري.موجود(المرجع); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف حل_سجلات_واجهة_عرض_دالة_مسير_للاختيار(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العرض: &عرض_دالة_مسير
): نتيجة_خطة_سجلات_واجهة_اختيار {
    طابق حل_واجهة_عرض_دالة_مسير_للهدف(السياق, المسير, الهدف, سجل_التخطيط, العرض) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة_خطة_سجلات_واجهة_اختيار.غير_متاحة();
    }
    | نتيجة.نجح(الخطة) -> {
        دع المعاملات: متغير متجه اختياري مرجع_سجل_واجهة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الخطة.المعاملات) مثل طبيعي)) {
            دع مرجع_المعامل: &خطة_معامل_واجهة = &الخطة.المعاملات[ف];
            دع المعامل: خطة_معامل_واجهة = *مرجع_المعامل;
            ألحق(المعاملات, مرجع_سجل_من_موقع_واجهة(&المعامل.الموقع));
            ف := ف + 1;
        }
        دع الناتج: اختياري مرجع_سجل_واجهة = مرجع_سجل_من_موقع_واجهة(&الخطة.الناتج.الموقع);
        دع خطة_السجلات: خطة_سجلات_واجهة_اختيار = { المعاملات: المعاملات, الناتج: الناتج };
        أرجع نتيجة_خطة_سجلات_واجهة_اختيار.صالحة(خطة_السجلات);
    };
}

عام نوع نتيجة_تحقق_واجهة_اختيار =
    | صالحة
    | غير_متاحة
;

عام عرف تحقق_واجهة_عرض_دالة_مسير_للاختيار(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العرض: &عرض_دالة_مسير
): نتيجة_تحقق_واجهة_اختيار {
    طابق حل_واجهة_عرض_دالة_مسير_للهدف(السياق, المسير, الهدف, سجل_التخطيط, العرض) مع
    | نتيجة.نجح(الخطة) -> {
        أرجع نتيجة_تحقق_واجهة_اختيار.صالحة();
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة_تحقق_واجهة_اختيار.غير_متاحة();
    };
}

عام عرف تحقق_واجهة_دالة_مسير_للاختيار(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_دالة_مسير
): نتيجة_تحقق_واجهة_اختيار {
    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
        أرجع نتيجة_تحقق_واجهة_اختيار.غير_متاحة();
    }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
        أرجع تحقق_واجهة_عرض_دالة_مسير_للاختيار(السياق, المسير, الهدف, سجل_التخطيط, &العرض);
    };
}

عام عرف عدد_كتل_دالة_مسير_للاختيار(
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_دالة_مسير
): اختياري طبيعي {
    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
        أرجع اختياري.موجود(العرض.عدد_الكتل);
    };
}

عام عرف عدد_سجلات_افتراضية_لمعرف_دالة_مسير(
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_دالة_مسير
): اختياري طبيعي {
    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
        أرجع اختياري.موجود(عدد_سجلات_افتراضية_لدالة_مسير(المسير, &العرض));
    };
}


// Target-neutral layout queries used by ISA selection for composite/place lowering.
عام عرف تخطيط_نوع_للاختيار(
    السياق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة_تخطيط {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *السياق;
    أرجع حل_تخطيط_نوع(&حقائق.الأنواع, الهدف, سجل_التخطيط, النوع);
}

// Selection must preserve the exact Layout owner result.  A missing MSIR type,
// a deferred layout, and a rejected layout are distinct compiler facts.
عام نوع فشل_تخطيط_قيمة_للاختيار =
    | نوع_قيمة_مفقود بنوع معرف_قيمة_مسير
    | مؤجل بنوع (معرف_قيمة_مسير, معرف_نوع, سبب_تأجيل_تخطيط)
    | مرفوض بنوع (معرف_قيمة_مسير, معرف_نوع, خطأ_تخطيط)
;

عام نوع نتيجة_تخطيط_قيمة_للاختيار =
    | مكتمل بنوع واصف_تخطيط
    | أخفق بنوع فشل_تخطيط_قيمة_للاختيار
;

عام عرف تخطيط_قيمة_مسير_للاختيار(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير
): نتيجة_تخطيط_قيمة_للاختيار {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تخطيط_قيمة_للاختيار.أخفق(
            فشل_تخطيط_قيمة_للاختيار.نوع_قيمة_مفقود(القيمة)
        );
    }
    | اختياري.موجود(النوع) -> {
        طابق تخطيط_نوع_للاختيار(السياق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_تخطيط.مكتمل(التخطيط) -> {
            أرجع نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط);
        }
        | نتيجة_تخطيط.مؤجل(السبب) -> {
            أرجع نتيجة_تخطيط_قيمة_للاختيار.أخفق(
                فشل_تخطيط_قيمة_للاختيار.مؤجل(القيمة, النوع, السبب)
            );
        }
        | نتيجة_تخطيط.مرفوض(الخطأ) -> {
            أرجع نتيجة_تخطيط_قيمة_للاختيار.أخفق(
                فشل_تخطيط_قيمة_للاختيار.مرفوض(القيمة, النوع, الخطأ)
            );
        };
    };
}

// استعلام مقنن يعيد تخطيط حمولة المنشئ كقيمة مملوكة من مالك Layout.
// يمنع نقل قيد منشئ جزئيا من تخطيط تجميعي مستعار.
عام عرف تخطيط_منشئ_قيمة_مسير_للاختيار(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير,
    فهرس_المنشئ: طبيعي
): نتيجة_تخطيط_منشئ {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تخطيط_منشئ.مرفوض(خطأ_تخطيط.بنية_نوع_ناقصة());
    }
    | اختياري.موجود(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *السياق;
        أرجع حل_تخطيط_حمولات_منشئ(
            &حقائق.الأنواع,
            الهدف,
            سجل_التخطيط,
            النوع,
            فهرس_المنشئ
        );
    };
}


// Backends may need canonical target layout for metadata-owned types (for
// example lexical-closure capture slots) that are not represented by an
// ordinary MSIR Value at the query point.
عام عرف حل_تخطيط_نوع_للاختيار(
    السياق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة_تخطيط {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *السياق;
    أرجع حل_تخطيط_نوع(&حقائق.الأنواع, الهدف, سجل_التخطيط, النوع);
}


عام نوع تخطيط_بيئة_إغلاق_اختيار = {
    إزاحات_الالتقاطات: متجه طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي
};

عام نوع نتيجة_تخطيط_بيئة_إغلاق_اختيار =
    | مكتمل بنوع تخطيط_بيئة_إغلاق_اختيار
    | مؤجل
    | مرفوض
;

// The closure environment layout is a Target fact shared by all native
// backends. A 24-byte header (three 8-byte slots, whatever the pointer
// width) holds the code pointer, the reference count and the destructor's
// code pointer; the aligned captured values follow. A construction sets the
// count to one; the reference-counting primitives (زيادة_مراجع_إغلاق,
// إنقاص_مراجع_إغلاق, مدمر_بيئة_إغلاق) read and write the header only. See
// docs/OWNERSHIP_AND_DESTRUCTION.md, "Closure environments".
عام عرف إزاحة_عداد_بيئة_إغلاق(): طبيعي { أرجع 8; }
عام عرف إزاحة_مدمر_بيئة_إغلاق(): طبيعي { أرجع 16; }
عام عرف حجم_رأس_بيئة_إغلاق(): طبيعي { أرجع 24; }

عام عرف خطط_بيئة_إغلاق_للاختيار(
    السياق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الدالة: معرف_دالة_مسير,
    عدد_الالتقاطات: طبيعي
): نتيجة_تخطيط_بيئة_إغلاق_اختيار {
    دع الإزاحات: متغير متجه طبيعي = [];
    دع الحجم: متغير طبيعي = حجم_رأس_بيئة_إغلاق();
    دع المحاذاة: متغير طبيعي = 8;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الالتقاطات) {
        دع نوع_الالتقاط: معرف_نوع;
        طابق نوع_التقاط_دالة_مسير_للاستهلاك(المسير, الدالة, ف) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض(); }
        | اختياري.موجود(النوع) -> { نوع_الالتقاط := النوع; };
        طابق حل_تخطيط_نوع_للاختيار(
            السياق, الهدف, سجل_التخطيط, نوع_الالتقاط
        ) مع
        | نتيجة_تخطيط.مؤجل(_) -> {
            أرجع نتيجة_تخطيط_بيئة_إغلاق_اختيار.مؤجل();
        }
        | نتيجة_تخطيط.مرفوض(_) -> {
            أرجع نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض();
        }
        | نتيجة_تخطيط.مكتمل(التخطيط) -> {
            دع محاذاة_الالتقاط: متغير طبيعي = التخطيط.المحاذاة;
            لو (محاذاة_الالتقاط == 0) { محاذاة_الالتقاط := 1; };
            الحجم := محاذاة_لأعلى(الحجم, محاذاة_الالتقاط);
            ألحق(الإزاحات, الحجم);
            الحجم := الحجم + التخطيط.الحجم;
            لو (محاذاة_الالتقاط > المحاذاة) { المحاذاة := محاذاة_الالتقاط; };
        };
        ف := ف + 1;
    }
    الحجم := محاذاة_لأعلى(الحجم, المحاذاة);
    دع الخطة: تخطيط_بيئة_إغلاق_اختيار = {
        إزاحات_الالتقاطات: الإزاحات,
        الحجم: الحجم,
        المحاذاة: المحاذاة
    };
    أرجع نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(الخطة);
}
