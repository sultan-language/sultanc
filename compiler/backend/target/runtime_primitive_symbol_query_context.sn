استورد compiler.backend.target.target_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_runtime_abi;

عام عرف اسم_رمز_بدائي_تشغيل_للهدف(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): اختيار متجه غ8 {
    دع الأساسي: متجه غ8 = اسم_بدائي_تشغيل_أساسي(البدائي);
    لو ((الطول(الأساسي) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { أرجع اختيار.بعض(الأساسي); }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        دع الناتج: متغير متجه غ8 = [0x5F];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأساسي) مثل غير_موقع)) { ألحق(الناتج, الأساسي[ف]); ف := ف + 1; }
        أرجع اختيار.بعض(الناتج);
    }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); };
}
