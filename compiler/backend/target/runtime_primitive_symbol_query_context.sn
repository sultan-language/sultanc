استورد compiler.backend.target.target_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_runtime_abi;
استورد compiler.backend.target.runtime_symbol_query_context;

// Object-symbol spelling of a primitive's runtime name. Mach-O prefixes C
// symbols with an underscore; ELF, COFF and WebAssembly use the base name.
// A spelling exists only where the primitive's storage dependencies can be
// supplied: WebAssembly modules through WASI, every other target through
// std's allocator (خدمات_الذاكرة_من_المكتبة_القياسية). Previously only the
// arm64 Darwin and x86-64 Linux compositions and WASI had a spelling, so every
// other target with std storage services (Windows, AArch64 Linux, x86-64
// macOS) rejected append and release in every backend.
عام عرف اسم_رمز_بدائي_تشغيل_للهدف(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): اختيار متجه غ8 {
    دع الأساسي: متجه غ8 = اسم_بدائي_تشغيل_أساسي(البدائي);
    لو ((الطول(الأساسي) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    لو ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.ويب_أسمبلي()) {
        لو ((*الهدف).مزود_التشغيل == مزود_تشغيل_هدف.واسي()) {
            أرجع اختيار.بعض(الأساسي);
        };
        أرجع اختيار.لا_شيء();
    };
    لو (!خدمات_الذاكرة_من_المكتبة_القياسية(الهدف)) { أرجع اختيار.لا_شيء(); };
    طابق (*الهدف).صيغة_الكائن مع
    | صيغة_كائن_هدف.ماتشو -> {
        دع الناتج: متغير متجه غ8 = [0x5F];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأساسي) مثل غير_موقع)) { ألحق(الناتج, الأساسي[ف]); ف := ف + 1; }
        أرجع اختيار.بعض(الناتج);
    }
    | صيغة_كائن_هدف.إلف -> { أرجع اختيار.بعض(الأساسي); }
    | صيغة_كائن_هدف.كوف -> { أرجع اختيار.بعض(الأساسي); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}
