    | هوية_بدائي_مترجم.حجم_صفحة_النظام -> { دع ن: متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x72,0x74,0x5F,0x73,0x79,0x73,0x74,0x65,0x6D,0x5F,0x70,0x61,0x67,0x65,0x5F,0x73,0x69,0x7A,0x65]; أرجع ن; }
    | هوية_بدائي_مترجم.خريطة_ذاكرة_النظام -> { دع ن: متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x72,0x74,0x5F,0x73,0x79,0x73,0x74,0x65,0x6D,0x5F,0x6D,0x65,0x6D,0x6F,0x72,0x79,0x5F,0x6D,0x61,0x70]; أرجع ن; }
    | هوية_بدائي_مترجم.إلغاء_خريطة_ذاكرة_النظام -> { دع ن: متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x72,0x74,0x5F,0x73,0x79,0x73,0x74,0x65,0x6D,0x5F,0x6D,0x65,0x6D,0x6F,0x72,0x79,0x5F,0x75,0x6E,0x6D,0x61,0x70]; أرجع ن; }
    | هوية_بدائي_مترجم.حماية_ذاكرة_النظام -> { دع ن: متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x72,0x74,0x5F,0x73,0x79,0x73,0x74,0x65,0x6D,0x5F,0x6D,0x65,0x6D,0x6F,0x72,0x79,0x5F,0x70,0x72,0x6F,0x74,0x65,0x63,0x74]; أرجع ن; }
    | هوية_بدائي_مترجم.قفل_ذاكرة_النظام -> { دع ن: متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x72,0x74,0x5F,0x73,0x79,0x73,0x74,0x65,0x6D,0x5F,0x6D,0x65,0x6D,0x6F,0x72,0x79,0x5F,0x6C,0x6F,0x63,0x6B]; أرجع ن; }
