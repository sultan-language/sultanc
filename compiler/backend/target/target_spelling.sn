استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد std.text.compare;
// هذه البوابة وحدها تقبل التهجئات الخارجية. الناتج دائما هوية داخلية عربية مقننة.
عام نوع نتيجة_تهجئة_معمارية =
    | معروفة بنوع هوية_معمارية
    | غير_معروفة
;

عام نوع نتيجة_تهجئة_منصة =
    | معروفة بنوع هوية_منصة
    | غير_معروفة
;

عام نوع نتيجة_تهجئة_بيئة =
    | معروفة بنوع هوية_بيئة
    | غير_معروفة
;

عام عرف حل_تهجئة_معمارية(التهجئة: &نص): نتيجة_تهجئة_معمارية {
    دع ذراع64_لاتيني: نص = «arm64»;
    دع آرتش64_لاتيني: نص = «aarch64»;
    دع ذراع64_عربي: نص = «ذراع64»;
    دع ذراع_أربعة_وستون_عربي: نص = «ذراع_أربعة_وستون»;
    دع إكس64_لاتيني: نص = «x86_64»;
    دع إكس64_عربي: نص = «إكس_ستة_وثمانون_أربعة_وستون»;
    دع ويب32_لاتيني: نص = «wasm32»;
    دع ويب32_عربي: نص = «ويب_أسمبلي_اثنان_وثلاثون»;
    دع رايسك64_لاتيني: نص = «riscv64»;
    دع رايسك64_عربي: نص = «رايسك_في_أربعة_وستون»;

    لو (نصان_متساويان(التهجئة, &ذراع64_لاتيني)
        || نصان_متساويان(التهجئة, &آرتش64_لاتيني)
        || نصان_متساويان(التهجئة, &ذراع64_عربي)
        || نصان_متساويان(التهجئة, &ذراع_أربعة_وستون_عربي)) {
        أرجع نتيجة_تهجئة_معمارية.معروفة(هوية_معمارية.ذراع_أربعة_وستون());
    };
    لو (نصان_متساويان(التهجئة, &إكس64_لاتيني)
        || نصان_متساويان(التهجئة, &إكس64_عربي)) {
        أرجع نتيجة_تهجئة_معمارية.معروفة(هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون());
    };
    لو (نصان_متساويان(التهجئة, &ويب32_لاتيني)
        || نصان_متساويان(التهجئة, &ويب32_عربي)) {
        أرجع نتيجة_تهجئة_معمارية.معروفة(هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون());
    };
    لو (نصان_متساويان(التهجئة, &رايسك64_لاتيني)
        || نصان_متساويان(التهجئة, &رايسك64_عربي)) {
        أرجع نتيجة_تهجئة_معمارية.معروفة(هوية_معمارية.رايسك_في_أربعة_وستون());
    };
    أرجع نتيجة_تهجئة_معمارية.غير_معروفة();
}

عام عرف حل_تهجئة_منصة(التهجئة: &نص): نتيجة_تهجئة_منصة {
    دع ماك_لاتيني: نص = «macos»;
    دع ماك_عربي: نص = «ماك_أو_إس»;
    دع آي_أو_إس_لاتيني: نص = «ios»;
    دع آي_أو_إس_عربي: نص = «آي_أو_إس»;
    دع لينكس_لاتيني: نص = «linux»;
    دع لينكس_عربي: نص = «لينكس»;
    دع ويندوز_لاتيني: نص = «windows»;
    دع ويندوز_عربي: نص = «ويندوز»;

    لو (نصان_متساويان(التهجئة, &ماك_لاتيني) || نصان_متساويان(التهجئة, &ماك_عربي)) {
        أرجع نتيجة_تهجئة_منصة.معروفة(هوية_منصة.ماك_أو_إس());
    };
    لو (نصان_متساويان(التهجئة, &آي_أو_إس_لاتيني) || نصان_متساويان(التهجئة, &آي_أو_إس_عربي)) {
        أرجع نتيجة_تهجئة_منصة.معروفة(هوية_منصة.آي_أو_إس());
    };
    لو (نصان_متساويان(التهجئة, &لينكس_لاتيني) || نصان_متساويان(التهجئة, &لينكس_عربي)) {
        أرجع نتيجة_تهجئة_منصة.معروفة(هوية_منصة.لينكس());
    };
    لو (نصان_متساويان(التهجئة, &ويندوز_لاتيني) || نصان_متساويان(التهجئة, &ويندوز_عربي)) {
        أرجع نتيجة_تهجئة_منصة.معروفة(هوية_منصة.ويندوز());
    };
    أرجع نتيجة_تهجئة_منصة.غير_معروفة();
}

عام عرف حل_تهجئة_بيئة(التهجئة: &نص): نتيجة_تهجئة_بيئة {
    دع جنو_لاتيني: نص = «gnu»;
    دع جنو_عربي: نص = «جنو»;
    دع مسل_لاتيني: نص = «musl»;
    دع مسل_عربي: نص = «مسل»;

    لو (نصان_متساويان(التهجئة, &جنو_لاتيني) || نصان_متساويان(التهجئة, &جنو_عربي)) {
        أرجع نتيجة_تهجئة_بيئة.معروفة(هوية_بيئة.جنو());
    };
    لو (نصان_متساويان(التهجئة, &مسل_لاتيني) || نصان_متساويان(التهجئة, &مسل_عربي)) {
        أرجع نتيجة_تهجئة_بيئة.معروفة(هوية_بيئة.مسل());
    };
    أرجع نتيجة_تهجئة_بيئة.غير_معروفة();
}


// Canonical external spelling of registered complete targets lives in Target,
// never in Driver/CLI. Registry remains the owner of which targets exist.
عام نوع نتيجة_تهجئة_هدف =
    | معروفة بنوع واصف_هدف
    | غير_معروفة
;

عام عرف تهجئة_هدف_مسجل(الهدف: &واصف_هدف): نص {
    دع القيمة: واصف_هدف = *الهدف;
    لو (
        القيمة.المعمارية.الهوية == هوية_معمارية.ذراع_أربعة_وستون()
        && القيمة.المنصة.المنصة == هوية_منصة.ماك_أو_إس()
        && القيمة.المنصة.البيئة == هوية_بيئة.غير_محددة()
    ) {
        أرجع «arm64-darwin»;
    };
    لو (
        القيمة.المعمارية.الهوية == هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون()
        && القيمة.المنصة.المنصة == هوية_منصة.لينكس()
        && القيمة.المنصة.البيئة == هوية_بيئة.جنو()
    ) {
        أرجع «x86_64-linux»;
    };
    أرجع «»;
}

عام عرف حل_تهجئة_هدف_مسجل(التهجئة: &نص): نتيجة_تهجئة_هدف {
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأهداف) مثل غير_موقع)) {
        دع التهجئة_المقننة: نص = تهجئة_هدف_مسجل(&الأهداف[ف]);
        لو (
            (الطول(التهجئة_المقننة) مثل غير_موقع) > 0
            && نصان_متساويان(التهجئة, &التهجئة_المقننة)
        ) {
            دع مرجع_الهدف: &واصف_هدف = &الأهداف[ف];
            دع الهدف: واصف_هدف = *مرجع_الهدف;
            أرجع نتيجة_تهجئة_هدف.معروفة(الهدف);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_تهجئة_هدف.غير_معروفة();
}

عام عرف تهجئة_معمارية_هدف(المعمارية: هوية_معمارية): نص {
    طابق المعمارية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع «arm64»; }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع «x86_64»; }
    | هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون -> { أرجع «wasm32»; }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> { أرجع «riscv64»; }
    | هوية_معمارية.ذراع_سبعة -> { أرجع «armv7»; };
}

عام عرف تهجئة_منصة_هدف(المنصة: هوية_منصة): نص {
    طابق المنصة مع
    | هوية_منصة.ماك_أو_إس -> { أرجع «Darwin»; }
    | هوية_منصة.آي_أو_إس -> { أرجع «iOS»; }
    | هوية_منصة.لينكس -> { أرجع «Linux»; }
    | هوية_منصة.ويندوز -> { أرجع «Windows»; }
    | هوية_منصة.أندرويد -> { أرجع «Android»; }
    | هوية_منصة.فري_بي_إس_دي -> { أرجع «FreeBSD»; }
    | هوية_منصة.واسي -> { أرجع «WASI»; }
    | هوية_منصة.متصفح -> { أرجع «Browser»; }
    | هوية_منصة.عتاد_مباشر -> { أرجع «BareMetal»; };
}

عام عرف تهجئة_صيغة_كائن_هدف(الصيغة: صيغة_كائن_هدف): نص {
    طابق الصيغة مع
    | صيغة_كائن_هدف.ماتشو -> { أرجع «Mach-O»; }
    | صيغة_كائن_هدف.إلف -> { أرجع «ELF»; };
}

عام عرف تهجئة_دعم_هدف(الدعم: مستوى_دعم_هدف): نص {
    طابق الدعم مع
    | مستوى_دعم_هدف.مضيف_ذاتي -> { أرجع «self-host»; }
    | مستوى_دعم_هدف.مخرج_متحقق_كليا -> { أرجع «verified-output»; }
    | مستوى_دعم_هدف.ترجمة_متقاطعة -> { أرجع «cross»; }
    | مستوى_دعم_هدف.تجريبي -> { أرجع «experimental»; };
}
