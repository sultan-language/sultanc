}

عام عرف سجل_عودة_فعلي_للهدف(
    الهدف: &واصف_هدف
): اختيار معرف_سجل_فعلي {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { أرجع اختيار.لا_شيء(); }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        دع السجل: معرف_سجل_فعلي = { القيمة: 30 };
        أرجع اختيار.بعض(السجل);
    }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

// call-frame-information alignment is part of the Target unwind contract. The DWARF writer only
// serializes these facts and does not infer architecture/ABI policy.
عام عرف محاذاة_شفرة_إطار_دوارف_للهدف(
    الهدف: &واصف_هدف
): اختيار غير_موقع {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { أرجع اختيار.بعض(1); }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> { أرجع اختيار.بعض(1); }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

عام عرف مقدار_محاذاة_بيانات_إطار_دوارف_للهدف(
