    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> { أرجع اختيار.بعض(8); }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

// Explicit debug contracts. These facts belong to Target/ABI, never to DWARF.
عام عرف رقم_مؤشر_الإطار_دوارف_للهدف(
    الهدف: &واصف_هدف
): اختيار غير_موقع {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { أرجع اختيار.بعض(6); }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> { أرجع اختيار.بعض(29); }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

عام عرف حجم_عنوان_تصحيح_للهدف(
    الهدف: &واصف_هدف
): غير_موقع {
    أرجع (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
}

عام نوع حقيقة_سجل_محفوظ_تصحيح = {
    السجل_الفعلي: معرف_سجل_فعلي,
    رقم_دوارف: غير_موقع
};

عام عرف حقيقة_سجل_محفوظ_لتصحيح_الهدف(
    الهدف: &واصف_هدف,
    السجل: معرف_سجل_فعلي
): اختيار حقيقة_سجل_محفوظ_تصحيح {
    طابق رقم_سجل_دوارف_للهدف(الهدف, السجل) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(رقم_دوارف) -> {
        دع الحقيقة: حقيقة_سجل_محفوظ_تصحيح = { السجل_الفعلي: السجل, رقم_دوارف: رقم_دوارف };
        أرجع اختيار.بعض(الحقيقة);
    };
}
