    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع اختيار.بعض(سجل_عمل_نقل_نداء_إكس());
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع اختيار.لا_شيء();
    }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

