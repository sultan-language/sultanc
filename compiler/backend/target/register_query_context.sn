استورد compiler.backend.target.target_model;
استورد compiler.backend.abi.abi_model;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.architectures.x86_64.systems.linux.register_rules;

// Target يركب قواعد السجلات الملموسة المختارة، ولا يسمح لملفات المعمارية العامة
// باستيراد تنفيذ نظام بعينه مباشرة.
عام عرف حل_سجل_واجهة_فعلي_للهدف(
    الهدف: &واصف_هدف,
    المرجع: &مرجع_سجل_واجهة
): اختيار معرف_سجل_فعلي {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع سجل_واجهة_سيستم_في_إلى_إكس(المرجع);
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع اختيار.لا_شيء();
    }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

عام عرف سجلات_عمل_قابلة_للتخصيص_للهدف(
    الهدف: &واصف_هدف
): متجه معرف_سجل_فعلي {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع سجلات_عمل_إكس_قابلة_للتخصيص();
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        دع فارغة: متجه معرف_سجل_فعلي = [];
        أرجع فارغة;
    }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { دع فارغة: متجه معرف_سجل_فعلي = []; أرجع فارغة; }
;
}

