// Internal SultanC calling convention: an indirect closure call carries the
// lexical environment in one Target-owned register. This is not part of the
// platform FFI ABI and is never exposed to extern calls.
عام عرف سجل_بيئة_إغلاق_للهدف(
    الهدف: &واصف_هدف
): اختيار معرف_سجل_فعلي {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        دع السجل: معرف_سجل_فعلي = { القيمة: 15 };
        أرجع اختيار.بعض(السجل);
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        دع السجل: معرف_سجل_فعلي = { القيمة: 14 };
        أرجع اختيار.بعض(السجل);
    }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

// Maps the backend's physical-register identity to the DWARF register namespace.
// The Target layer owns this translation so the DWARF writer never branches on OS/ABI.
عام عرف رقم_سجل_دوارف_للهدف(
    الهدف: &واصف_هدف,
    السجل: معرف_سجل_فعلي
): اختيار غير_موقع {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع رقم_سجل_دوارف_سيستم_في_إكس(السجل);
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        لو (السجل.القيمة <= 31) { أرجع اختيار.بعض(السجل.القيمة); };
        أرجع اختيار.لا_شيء();
    }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

// Target-owned DWARF stack-pointer identity used by stack location expressions.
// Object/debug encoding stays target-independent and consumes only this number.
عام عرف رقم_مؤشر_المكدس_دوارف_للهدف(
    الهدف: &واصف_هدف
): اختيار غير_موقع {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> {
        أرجع اختيار.بعض(7);
    }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        أرجع اختيار.بعض(31);
    }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

// Canonical unwind facts consumed by the target-independent DWARF writer.
عام عرف رقم_سجل_عودة_دوارف_للهدف(
    الهدف: &واصف_هدف
): اختيار غير_موقع {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { أرجع اختيار.بعض(16); }
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> { أرجع اختيار.بعض(30); }
    | هوية_تركيب_هدف_أصلي.ترجمة_متقاطعة_مفوضة -> { أرجع اختيار.لا_شيء(); }
;
}

عام عرف إزاحة_قاعدة_الإطار_عند_الدخول_للهدف(
    الهدف: &واصف_هدف
): اختيار غير_موقع {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
