استورد compiler.backend.target.target_model;

عام نوع حقائق_بوزكس_هدف = {
    واصف_الدخل_القياسي: غير_موقع,
    واصف_الخرج_القياسي: غير_موقع,
    واصف_الخطأ_القياسي: غير_موقع,
    علم_قراءة_فقط: غير_موقع,
    علم_كتابة_فقط: غير_موقع,
    علم_إنشاء: غير_موقع,
    علم_اقتطاع: غير_موقع,
    نمط_ملف_افتراضي: غير_موقع,
    رقم_خطأ_مقاطعة: غير_موقع
};

عام عرف حقائق_بوزكس_للهدف(الهدف: &واصف_هدف): اختيار حقائق_بوزكس_هدف {
    دع و: واصف_هدف = *الهدف;
    طابق و.المنصة.المنصة مع
    | هوية_منصة.ماك_أو_إس -> {
        دع الحقائق: حقائق_بوزكس_هدف = {
            واصف_الدخل_القياسي: 0,
            واصف_الخرج_القياسي: 1,
            واصف_الخطأ_القياسي: 2,
            علم_قراءة_فقط: 0,
            علم_كتابة_فقط: 1,
            علم_إنشاء: 512,
            علم_اقتطاع: 1024,
            نمط_ملف_افتراضي: 420,
            رقم_خطأ_مقاطعة: 4
        };
        أرجع اختيار.بعض(الحقائق);
    }
    | هوية_منصة.لينكس -> {
        دع الحقائق: حقائق_بوزكس_هدف = {
            واصف_الدخل_القياسي: 0,
            واصف_الخرج_القياسي: 1,
            واصف_الخطأ_القياسي: 2,
            علم_قراءة_فقط: 0,
            علم_كتابة_فقط: 1,
            علم_إنشاء: 64,
            علم_اقتطاع: 512,
            نمط_ملف_افتراضي: 420,
            رقم_خطأ_مقاطعة: 4
        };
        أرجع اختيار.بعض(الحقائق);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}
