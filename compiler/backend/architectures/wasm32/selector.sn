// The native wasm32 selector: verified MSIR functions to WebAssembly function
// bodies. It plays the role the register-machine selectors, allocators and
// encoders play for x86-64/ARM64, because WebAssembly has unlimited typed
// locals and structured control instead of registers and jumps.
//
// Representation (the same split the LLVM provider makes): every MSIR value
// owns one local holding either the scalar itself (i32/i64/f32/f64) or, for
// aggregates and places, the i32 address of its storage. Integers narrower
// than 32 bits live in i32 locals normalized to their type (sign- or
// zero-extended), so comparison and division need no fix-up. Aggregate
// temporaries and local places live in a per-function frame on the shadow
// stack (`__stack_pointer`), one slot per producing instruction, exactly as
// the LLVM provider hoists one alloca per instruction into the entry block.
// Integer arithmetic traps on every failure the canonical MSIR contract names
// (overflow, division by zero, MIN/-1, shift out of range), with the same
// checks the LLVM provider emits. Calls follow the target ABI plan (portable
// SultanC ABI: scalars direct, aggregates by address, an indirect result
// first, then the hidden closure environment of every non-entry function).
// Relocatable references (functions, data, types, the stack pointer, the
// function table) are 5-byte padded fields recorded for the object writer.

عام نوع خطأ_اختيار_ويب_أسمبلي =
    | دالة_مفقودة بنوع معرف_دالة_مسير
    | كتلة_مفقودة بنوع معرف_كتلة_مسير
    | قيمة_مفقودة بنوع معرف_قيمة_مسير
    | نوع_غير_مدعوم بنوع معرف_نوع
    | تخطيط_غير_مكتمل بنوع معرف_نوع
    | واجهة_غير_متاحة بنوع معرف_دالة_مسير
    | بدائي_غير_مخفض بنوع هوية_بدائي_مترجم
    | عملية_غير_مدعومة
    | تدفق_غير_قابل_للاختزال بنوع معرف_دالة_مسير
    | مزود_ذاكرة_مفقود
    | مزود_خروج_مفقود
    | حافة_غير_صالحة
;

// Module-wide facts every function body needs.
عام نوع سياق_وحدة_ويب_أسمبلي = {
    التواقيع: سجل_تواقيع_ويب_أسمبلي,
    مزودات_الذاكرة: اختيار مزودات_تخصيص_ذاكرة_مسير,
    دالة_الدخول: اختيار معرف_دالة_مسير
};

// ---------------------------------------------------- value descriptors --

نوع وصف_سلمي_ويب_أسمبلي = {
    النوع: نوع_قيمة_ويب_أسمبلي,
    البتات: غير_موقع,
    موقع: منطقي,
    عائم: منطقي
};

نوع صنف_قيمة_ويب_أسمبلي =
    | سلمي بنوع وصف_سلمي_ويب_أسمبلي
    | تجميعي
    | فراغ
    | غير_مدعوم
;

عرف سلمي_ويب_أسمبلي(النوع: نوع_قيمة_ويب_أسمبلي, البتات: غير_موقع, موقع: منطقي, عائم: منطقي): صنف_قيمة_ويب_أسمبلي {
    دع الوصف: وصف_سلمي_ويب_أسمبلي = { النوع: النوع, البتات: البتات, موقع: موقع, عائم: عائم };
    أرجع صنف_قيمة_ويب_أسمبلي.سلمي(الوصف);
}

عرف صنف_نوع_ويب_أسمبلي(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    النوع: معرف_نوع
): صنف_قيمة_ويب_أسمبلي {
    طابق وصف_شكل_نوع_دلالي_عند(&(*الحقائق).الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع صنف_قيمة_ويب_أسمبلي.غير_مدعوم(); }
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.فراغ -> { أرجع صنف_قيمة_ويب_أسمبلي.فراغ(); }
            | نوع_بدائي_مقنن.منطقي -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 1, خطأ, خطأ); }
            | نوع_بدائي_مقنن.ع32 -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.عائم32(), 32, خطأ, صواب); }
            | نوع_بدائي_مقنن.ع64 -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.عائم64(), 64, خطأ, صواب); }
            | نوع_بدائي_مقنن.نص -> { أرجع صنف_قيمة_ويب_أسمبلي.تجميعي(); }
            | نوع_بدائي_مقنن.أي -> { أرجع صنف_قيمة_ويب_أسمبلي.غير_مدعوم(); }
            | نوع_بدائي_مقنن.حرف -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
            | _ -> {
                دع البتات: غير_موقع = بتات_نوع_بدائي(البدائي);
                دع موقع: منطقي = صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عدد_موقع();
                لو (البتات == 8 || البتات == 16 || البتات == 32) {
                    أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), البتات, موقع, خطأ);
                };
                لو (البتات == 64) {
                    أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح64(), 64, موقع, خطأ);
                };
                أرجع صنف_قيمة_ويب_أسمبلي.غير_مدعوم();
            };
        }
        | صنف_شكل_نوع_دلالي.مؤشر -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
        | صنف_شكل_نوع_دلالي.مرجع -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
        | صنف_شكل_نوع_دلالي.صندوق -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
        | صنف_شكل_نوع_دلالي.دالة -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
        | صنف_شكل_نوع_دلالي.معامل_نوع -> { أرجع صنف_قيمة_ويب_أسمبلي.غير_مدعوم(); }
        | _ -> { أرجع صنف_قيمة_ويب_أسمبلي.تجميعي(); };
    };
}

// ---------------------------------------------------------------- state --

نوع تمثيل_قيمة_ويب_أسمبلي = {
    المحلي: غير_موقع,
    عنوان: منطقي
};

نوع إطار_بنية_ويب_أسمبلي =
    | حلقة بنوع غير_موقع
    | كتلة بنوع غير_موقع
    | شرط
;

نوع حالة_اختيار_ويب_أسمبلي = {
    المعرف: معرف_دالة_مسير,
    الشفرة: متجه غ8,
    الإزاحات: متجه إزاحة_شفرة_ويب_أسمبلي,
    عدد_المعاملات: غير_موقع,
    المحليات: متجه نوع_قيمة_ويب_أسمبلي,
    القيم: متجه اختيار تمثيل_قيمة_ويب_أسمبلي,
    حجم_الإطار: غير_موقع,
    محلي_الإطار: غير_موقع,
    رقع_الإطار: متجه غير_موقع,
    مؤقتات_ص32: متجه غير_موقع,
    عمق_ص32: غير_موقع,
    مؤقتات_ص64: متجه غير_موقع,
    عمق_ص64: غير_موقع,
    بيئة_الإغلاق: اختيار غير_موقع,
    عنوان_الناتج: اختيار غير_موقع,
    السياق: متجه إطار_بنية_ويب_أسمبلي,
    عمق_السياق: غير_موقع,
    البيانات_الثابتة: متجه بيانات_ثابتة_كائن
};

عرف حالة_اختيار_ويب_أسمبلي_جديدة(المعرف: معرف_دالة_مسير, عدد_المعاملات: غير_موقع): حالة_اختيار_ويب_أسمبلي {
    دع الشفرة: متجه غ8 = [];
    دع الإزاحات: متجه إزاحة_شفرة_ويب_أسمبلي = [];
    دع المحليات: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع القيم: متجه اختيار تمثيل_قيمة_ويب_أسمبلي = [];
    دع الرقع: متجه غير_موقع = [];
    دع م32: متجه غير_موقع = [];
    دع م64: متجه غير_موقع = [];
    دع السياق: متجه إطار_بنية_ويب_أسمبلي = [];
    دع الثابتة: متجه بيانات_ثابتة_كائن = [];
    دع الحالة: حالة_اختيار_ويب_أسمبلي = {
        المعرف: المعرف,
        الشفرة: الشفرة,
        الإزاحات: الإزاحات,
        عدد_المعاملات: عدد_المعاملات,
        المحليات: المحليات,
        القيم: القيم,
        حجم_الإطار: 0,
        محلي_الإطار: 0,
        رقع_الإطار: الرقع,
        مؤقتات_ص32: م32,
        عمق_ص32: 0,
        مؤقتات_ص64: م64,
        عمق_ص64: 0,
        بيئة_الإغلاق: اختيار.لا_شيء(),
        عنوان_الناتج: اختيار.لا_شيء(),
        السياق: السياق,
        عمق_السياق: 0,
        البيانات_الثابتة: الثابتة
    };
    أرجع الحالة;
}

// ------------------------------------------------------------- emitting --

عرف أصدر_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, البايت: غير_موقع): فراغ {
    ألحق_بايت_ويب_أسمبلي(&متغير (*ح).الشفرة, البايت);
}

عرف أصدر_ليب_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, القيمة: غير_موقع): فراغ {
    ألحق_ليب_ويب_أسمبلي(&متغير (*ح).الشفرة, القيمة);
}

عرف أصدر_محلي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الرمز: غير_موقع, المحلي: غير_موقع): فراغ {
    أصدر_ويب_أسمبلي(ح, الرمز);
    أصدر_ليب_ويب_أسمبلي(ح, المحلي);
}

عرف اقرأ_محلي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, المحلي: غير_موقع): فراغ {
    أصدر_محلي_ويب_أسمبلي(ح, 0x20, المحلي); // local.get
}

عرف اكتب_محلي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, المحلي: غير_موقع): فراغ {
    أصدر_محلي_ويب_أسمبلي(ح, 0x21, المحلي); // local.set
}

عرف أصدر_ثابت32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, القيمة: عدد): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x41); // i32.const
    ألحق_سليب_ويب_أسمبلي(&متغير (*ح).الشفرة, القيمة);
}

عرف أصدر_ثابت64_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, القيمة: عدد): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x42); // i64.const
    ألحق_سليب_ويب_أسمبلي(&متغير (*ح).الشفرة, القيمة);
}

عرف أصدر_ثابت_بتات32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, البتات: غير_موقع): فراغ {
    أصدر_ثابت32_ويب_أسمبلي(ح, قيمة_موقعة_32_من_بتات(البتات));
}

// A relocatable 5-byte field at the current position.
عرف أصدر_إزاحة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    النوع: نوع_إزاحة_ويب_أسمبلي,
    الهدف: هدف_إزاحة_ويب_أسمبلي,
    الإضافة: عدد
): فراغ {
    دع الإزاحة: إزاحة_شفرة_ويب_أسمبلي = {
        الموضع: الطول((*ح).الشفرة) مثل غير_موقع,
        النوع: النوع,
        الهدف: الهدف,
        الإضافة: الإضافة
    };
    ألحق((*ح).الإزاحات, الإزاحة);
    ألحق_ليب_مبطن_ويب_أسمبلي(&متغير (*ح).الشفرة, 0);
}

عرف أصدر_عنوان_رمز_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الهدف: هدف_إزاحة_ويب_أسمبلي,
    الإضافة: عدد
): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x41); // i32.const <memory address>
    أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.عنوان_ذاكرة_موقع(), الهدف, الإضافة);
}

عرف أصدر_فهرس_جدول_دالة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الدالة: معرف_دالة_مسير): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x41); // i32.const <table index>
    دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(الدالة));
    أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.فهرس_جدول_موقع(), هدف_إزاحة_ويب_أسمبلي.رمز(الرمز), 0);
}

عرف أصدر_نداء_دالة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الرمز: مرجع_رمز_كائن): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x10); // call
    أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.فهرس_دالة(), هدف_إزاحة_ويب_أسمبلي.رمز(الرمز), 0);
}

عرف أصدر_مؤشر_المكدس_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الرمز: غير_موقع): فراغ {
    أصدر_ويب_أسمبلي(ح, الرمز); // global.get / global.set __stack_pointer
    أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.فهرس_عام(), هدف_إزاحة_ويب_أسمبلي.مؤشر_المكدس(), 0);
}

// Frame size is known only after the whole body; record the field to patch.
عرف أصدر_حجم_الإطار_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x41); // i32.const <frame size>
    ألحق((*ح).رقع_الإطار, الطول((*ح).الشفرة) مثل غير_موقع);
    ألحق_سليب_مبطن_ويب_أسمبلي(&متغير (*ح).الشفرة, 0);
}

// The current condition (i32 on the stack) traps when nonzero.
عرف أصدر_فخ_إذا_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x04); // if
    أصدر_ويب_أسمبلي(ح, 0x40); //   (no result)
    أصدر_ويب_أسمبلي(ح, 0x00); //   unreachable
    أصدر_ويب_أسمبلي(ح, 0x0B); // end
}

عرف أصدر_نسخ_ذاكرة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    أصدر_ويب_أسمبلي(ح, 0xFC); // memory.copy 0 0
    أصدر_ليب_ويب_أسمبلي(ح, 10);
    أصدر_ويب_أسمبلي(ح, 0x00);
    أصدر_ويب_أسمبلي(ح, 0x00);
}

عرف محلي_جديد_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, النوع: نوع_قيمة_ويب_أسمبلي): غير_موقع {
    دع الفهرس: غير_موقع = (*ح).عدد_المعاملات + (الطول((*ح).المحليات) مثل غير_موقع);
    ألحق((*ح).المحليات, النوع);
    أرجع الفهرس;
}

// LIFO scratch locals for multi-step sequences (checked arithmetic, append).
عرف خذ_مؤقت32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): غير_موقع {
    لو ((*ح).عمق_ص32 >= (الطول((*ح).مؤقتات_ص32) مثل غير_موقع)) {
        دع الجديد: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
        ألحق((*ح).مؤقتات_ص32, الجديد);
    };
    دع المحلي: غير_موقع = (*ح).مؤقتات_ص32[(*ح).عمق_ص32];
    (*ح).عمق_ص32 := (*ح).عمق_ص32 + 1;
    أرجع المحلي;
}

عرف أعد_مؤقت32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    (*ح).عمق_ص32 := (*ح).عمق_ص32 - 1;
}

عرف خذ_مؤقت64_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): غير_موقع {
    لو ((*ح).عمق_ص64 >= (الطول((*ح).مؤقتات_ص64) مثل غير_موقع)) {
        دع الجديد: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح64());
        ألحق((*ح).مؤقتات_ص64, الجديد);
    };
    دع المحلي: غير_موقع = (*ح).مؤقتات_ص64[(*ح).عمق_ص64];
    (*ح).عمق_ص64 := (*ح).عمق_ص64 + 1;
    أرجع المحلي;
}

عرف أعد_مؤقت64_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    (*ح).عمق_ص64 := (*ح).عمق_ص64 - 1;
}

عرف ضع_قيمة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, المعرف: معرف_قيمة_مسير, التمثيل: تمثيل_قيمة_ويب_أسمبلي): فراغ {
    بينما ((الطول((*ح).القيم) مثل غير_موقع) <= المعرف.القيمة) { ألحق((*ح).القيم, اختيار.لا_شيء()); }
    (*ح).القيم[المعرف.القيمة] := اختيار.بعض(التمثيل);
}

عرف قيمة_ويب_أسمبلي(ح: &حالة_اختيار_ويب_أسمبلي, المعرف: معرف_قيمة_مسير): نتيجة تمثيل_قيمة_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    لو (المعرف.القيمة >= (الطول((*ح).القيم) مثل غير_موقع)) {
        أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.قيمة_مفقودة(المعرف));
    };
    طابق (*ح).القيم[المعرف.القيمة] مع
    | اختيار.بعض(التمثيل) -> { أرجع نتيجة.نجح(التمثيل); }
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.قيمة_مفقودة(المعرف)); };
}

عرف محلي_قيمة_ويب_أسمبلي(ح: &حالة_اختيار_ويب_أسمبلي, المعرف: معرف_قيمة_مسير): نتيجة غير_موقع, خطأ_اختيار_ويب_أسمبلي {
    طابق قيمة_ويب_أسمبلي(ح, المعرف) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(التمثيل) -> { أرجع نتيجة.نجح(التمثيل.المحلي); };
}

عرف نوع_قيمة_مسير_ويب_أسمبلي(المسير: &سياق_مستهلك_مسير, المعرف: معرف_قيمة_مسير): نتيجة معرف_نوع, خطأ_اختيار_ويب_أسمبلي {
    طابق نوع_قيمة_مسير(المسير, المعرف) مع
    | اختيار.بعض(النوع) -> { أرجع نتيجة.نجح(النوع); }
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.قيمة_مفقودة(المعرف)); };
}

عرف تخطيط_ويب_أسمبلي(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة واصف_تخطيط, خطأ_اختيار_ويب_أسمبلي {
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(التخطيط) -> { أرجع نتيجة.نجح(التخطيط); }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.تخطيط_غير_مكتمل(النوع)); };
}

عرف جزء_تخطيط_ويب_أسمبلي(التخطيط: &واصف_تخطيط, الفهرس: غير_موقع): اختيار موضع_جزء_تخطيط {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        لو (الفهرس < (الطول(الأجزاء) مثل غير_موقع)) { أرجع اختيار.بعض(الأجزاء[الفهرس]); };
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        لو (الفهرس < (الطول(الأجزاء) مثل غير_موقع)) { أرجع اختيار.بعض(الأجزاء[الفهرس]); };
    }
    | _ -> { };
    أرجع اختيار.لا_شيء();
}

عرف إزاحة_جزء_ويب_أسمبلي(
    التخطيط: &واصف_تخطيط, الفهرس: غير_موقع, النوع: معرف_نوع
): نتيجة غير_موقع, خطأ_اختيار_ويب_أسمبلي {
    طابق جزء_تخطيط_ويب_أسمبلي(التخطيط, الفهرس) مع
    | اختيار.بعض(الجزء) -> { أرجع نتيجة.نجح(الجزء.الإزاحة); }
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

عرف تعداد_ويب_أسمبلي(التخطيط: &واصف_تخطيط): اختيار تخطيط_تعداد {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.تعداد(ت) -> { أرجع اختيار.بعض(ت); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

// A new local for a value of this type: the scalar or the storage address.
عرف محلي_لنوع_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    النوع: معرف_نوع
): نتيجة تمثيل_قيمة_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: محلي_جديد_ويب_أسمبلي(ح, الوصف.النوع), عنوان: خطأ };
        أرجع نتيجة.نجح(التمثيل);
    }
    | صنف_قيمة_ويب_أسمبلي.تجميعي -> {
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = {
            المحلي: محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32()), عنوان: صواب
        };
        أرجع نتيجة.نجح(التمثيل);
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

// A fresh frame slot; its address goes into a new i32 local.
عرف عنوان_إطار_جديد_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحجم: غير_موقع,
    المحاذاة: غير_موقع
): غير_موقع {
    دع محاذاة: متغير غير_موقع = المحاذاة;
    لو (محاذاة == 0) { محاذاة := 1; };
    دع الإزاحة: غير_موقع = محاذاة_لأعلى((*ح).حجم_الإطار, محاذاة);
    دع حجم: متغير غير_موقع = الحجم;
    لو (حجم == 0) { حجم := 1; };
    (*ح).حجم_الإطار := الإزاحة + حجم;
    دع المحلي: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    اقرأ_محلي_ويب_أسمبلي(ح, (*ح).محلي_الإطار);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الإزاحة);
    أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
    اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    أرجع المحلي;
}

// Pushes base + offset (i32) on the stack.
عرف أصدر_عنوان_مزاح_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الأساس: غير_موقع, الإزاحة: غير_موقع): فراغ {
    اقرأ_محلي_ويب_أسمبلي(ح, الأساس);
    لو (الإزاحة != 0) {
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الإزاحة);
        أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
    };
}

// Scalar load at [address + offset] by its type (value left on the stack).
عرف أصدر_تحميل_سلمي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الوصف: &وصف_سلمي_ويب_أسمبلي, الإزاحة: غير_موقع): فراغ {
    دع الحجم: غير_موقع = (*الوصف).البتات / 8;
    لو ((*الوصف).عائم) {
        لو ((*الوصف).البتات == 32) { أصدر_ويب_أسمبلي(ح, 0x2A); } وإلا { أصدر_ويب_أسمبلي(ح, 0x2B); }; // f32.load / f64.load
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, الإزاحة);
        أرجع;
    };
    لو ((*الوصف).البتات == 1) {
        أصدر_ويب_أسمبلي(ح, 0x2D); // i32.load8_u
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 1, الإزاحة);
        أرجع;
    };
    لو ((*الوصف).البتات == 8) {
        لو ((*الوصف).موقع) { أصدر_ويب_أسمبلي(ح, 0x2C); } وإلا { أصدر_ويب_أسمبلي(ح, 0x2D); }; // load8_s / load8_u
    } وإلا لو ((*الوصف).البتات == 16) {
        لو ((*الوصف).موقع) { أصدر_ويب_أسمبلي(ح, 0x2E); } وإلا { أصدر_ويب_أسمبلي(ح, 0x2F); }; // load16_s / load16_u
    } وإلا لو ((*الوصف).البتات == 32) {
        أصدر_ويب_أسمبلي(ح, 0x28); // i32.load
    } وإلا {
        أصدر_ويب_أسمبلي(ح, 0x29); // i64.load
    };
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, الإزاحة);
}

// Scalar store at [address + offset]; address then value already pushed.
عرف أصدر_تخزين_سلمي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الوصف: &وصف_سلمي_ويب_أسمبلي, الإزاحة: غير_موقع): فراغ {
    دع الحجم: غير_موقع = (*الوصف).البتات / 8;
    لو ((*الوصف).عائم) {
        لو ((*الوصف).البتات == 32) { أصدر_ويب_أسمبلي(ح, 0x38); } وإلا { أصدر_ويب_أسمبلي(ح, 0x39); }; // f32.store / f64.store
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, الإزاحة);
        أرجع;
    };
    لو ((*الوصف).البتات == 1 || (*الوصف).البتات == 8) {
        أصدر_ويب_أسمبلي(ح, 0x3A); // i32.store8
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 1, الإزاحة);
        أرجع;
    };
    لو ((*الوصف).البتات == 16) {
        أصدر_ويب_أسمبلي(ح, 0x3B); // i32.store16
    } وإلا لو ((*الوصف).البتات == 32) {
        أصدر_ويب_أسمبلي(ح, 0x36); // i32.store
    } وإلا {
        أصدر_ويب_أسمبلي(ح, 0x37); // i64.store
    };
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, الإزاحة);
}

// Stores a value of type النوع at [address local + offset].
عرف خزن_قيمة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    العنوان: غير_موقع,
    الإزاحة: غير_موقع,
    القيمة: تمثيل_قيمة_ويب_أسمبلي
): اختيار خطأ_اختيار_ويب_أسمبلي {
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        لو (القيمة.عنوان) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
        اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
        اقرأ_محلي_ويب_أسمبلي(ح, القيمة.المحلي);
        أصدر_تخزين_سلمي_ويب_أسمبلي(ح, &الوصف, الإزاحة);
        أرجع اختيار.لا_شيء();
    }
    | صنف_قيمة_ويب_أسمبلي.تجميعي -> {
        لو (!القيمة.عنوان) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
        دع الحجم: غير_موقع;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(التخطيط) -> { الحجم := التخطيط.الحجم; };
        لو (الحجم == 0) { أرجع اختيار.لا_شيء(); };
        أصدر_عنوان_مزاح_ويب_أسمبلي(ح, العنوان, الإزاحة);
        اقرأ_محلي_ويب_أسمبلي(ح, القيمة.المحلي);
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الحجم);
        أصدر_نسخ_ذاكرة_ويب_أسمبلي(ح);
        أرجع اختيار.لا_شيء();
    }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

// Loads a value of type النوع from [address local + offset] into a new
// local; an aggregate is copied into a fresh frame slot (values are
// immutable while the place they came from may change).
عرف حمل_قيمة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    العنوان: غير_موقع,
    الإزاحة: غير_موقع
): نتيجة تمثيل_قيمة_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        دع المحلي: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, الوصف.النوع);
        اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
        أصدر_تحميل_سلمي_ويب_أسمبلي(ح, &الوصف, الإزاحة);
        اكتب_محلي_ويب_أسمبلي(ح, المحلي);
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المحلي, عنوان: خطأ };
        أرجع نتيجة.نجح(التمثيل);
    }
    | صنف_قيمة_ويب_أسمبلي.تجميعي -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { التخطيط := القيمة; };
        دع المكان: غير_موقع = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        لو (التخطيط.الحجم > 0) {
            اقرأ_محلي_ويب_أسمبلي(ح, المكان);
            أصدر_عنوان_مزاح_ويب_أسمبلي(ح, العنوان, الإزاحة);
            أصدر_ثابت_بتات32_ويب_أسمبلي(ح, التخطيط.الحجم);
            أصدر_نسخ_ذاكرة_ويب_أسمبلي(ح);
        };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المكان, عنوان: صواب };
        أرجع نتيجة.نجح(التمثيل);
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

// ------------------------------------------------------- integer support --

// Normalizes the i32 on the stack to an N-bit integer of the given sign.
عرف أصدر_تطبيع32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, البتات: غير_موقع, موقع: منطقي): فراغ {
    لو (البتات >= 32) { أرجع; };
    لو (البتات == 1) {
        أصدر_ثابت32_ويب_أسمبلي(ح, 1);
        أصدر_ويب_أسمبلي(ح, 0x71); // i32.and
        أرجع;
    };
    لو (موقع) {
        لو (البتات == 8) { أصدر_ويب_أسمبلي(ح, 0xC0); } وإلا { أصدر_ويب_أسمبلي(ح, 0xC1); }; // i32.extend8_s / extend16_s
        أرجع;
    };
    لو (البتات == 8) { أصدر_ثابت32_ويب_أسمبلي(ح, 255); } وإلا { أصدر_ثابت32_ويب_أسمبلي(ح, 65535); };
    أصدر_ويب_أسمبلي(ح, 0x71); // i32.and
}

// The low N bits of a constant, as the normalized pattern of its local.
عرف نمط_ثابت_ويب_أسمبلي(الخام: غير_موقع, الوصف: &وصف_سلمي_ويب_أسمبلي): غير_موقع {
    لو ((*الوصف).البتات >= 64) { أرجع الخام; };
    لو ((*الوصف).البتات == 32) { أرجع الخام % 4294967296; };
    دع المدى: متغير غير_موقع = 1;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*الوصف).البتات) { المدى := المدى * 2; ف := ف + 1; }
    دع المنخفض: غير_موقع = الخام % المدى;
    لو ((*الوصف).موقع && المنخفض >= المدى / 2) {
        أرجع المنخفض + (4294967296 - المدى);
    };
    أرجع المنخفض;
}

عرف أصدر_ثابت_عدد_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الوصف: &وصف_سلمي_ويب_أسمبلي, الخام: غير_موقع): فراغ {
    دع النمط: غير_موقع = نمط_ثابت_ويب_أسمبلي(الخام, الوصف);
    لو ((*الوصف).البتات == 64) {
        أصدر_ثابت64_ويب_أسمبلي(ح, النمط مثل عدد);
    } وإلا {
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, النمط);
    };
}

عرف أصدر_ثابت_بعرض_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, واسع: منطقي, القيمة: عدد): فراغ {
    لو (واسع) { أصدر_ثابت64_ويب_أسمبلي(ح, القيمة); } وإلا { أصدر_ثابت32_ويب_أسمبلي(ح, القيمة); };
}

عرف أصدر_عملية_بعرض_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, واسع: منطقي, رمز32: غير_موقع, رمز64: غير_موقع): فراغ {
    لو (واسع) { أصدر_ويب_أسمبلي(ح, رمز64); } وإلا { أصدر_ويب_أسمبلي(ح, رمز32); };
}

// Narrow (8/16-bit) result range check on local الناتج.
عرف أصدر_فحص_نطاق_ضيق_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الناتج: غير_موقع, البتات: غير_موقع, موقع: منطقي): فراغ {
    اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
    لو (موقع) {
        اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
        أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, صواب);
        أصدر_ويب_أسمبلي(ح, 0x47); // i32.ne
    } وإلا {
        لو (البتات == 8) { أصدر_ثابت32_ويب_أسمبلي(ح, 255); } وإلا { أصدر_ثابت32_ويب_أسمبلي(ح, 65535); };
        أصدر_ويب_أسمبلي(ح, 0x4B); // i32.gt_u
    };
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
}

عرف أدنى_موقع_ويب_أسمبلي(البتات: غير_موقع): عدد {
    لو (البتات == 64) { أرجع -9223372036854775807 - 1; };
    دع القيمة: متغير عدد = 1;
    دع ف: متغير غير_موقع = 1;
    بينما (ف < البتات) { القيمة := القيمة * 2; ف := ف + 1; }
    أرجع 0 - القيمة;
}

عرف أصدر_حساب_صحيح_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الحساب: &حساب_صحيح_مسير,
    الناتج: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع أ: غير_موقع; دع ب: غير_موقع;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { أ := م; };
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحساب).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { ب := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    دع الوصف: وصف_سلمي_ويب_أسمبلي;
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> { الوصف := و; }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    لو (الوصف.عائم) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    دع واسع: منطقي = الوصف.البتات == 64;
    دع ضيق: منطقي = الوصف.البتات < 32;
    دع البتات: غير_موقع = الوصف.البتات;
    دع موقع: منطقي = الوصف.موقع;
    طابق (*الحساب).العملية مع
    | عملية_حساب_صحيح.جمع -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6A, 0x7C); // add
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        لو (ضيق) { أصدر_فحص_نطاق_ضيق_ويب_أسمبلي(ح, الناتج, البتات, موقع); أرجع اختيار.لا_شيء(); };
        لو (موقع) {
            // ((a ^ r) & (b ^ r)) < 0
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85); // xor
            اقرأ_محلي_ويب_أسمبلي(ح, ب); اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x71, 0x83); // and
            أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, 0);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x48, 0x53); // lt_s
        } وإلا {
            اقرأ_محلي_ويب_أسمبلي(ح, الناتج); اقرأ_محلي_ويب_أسمبلي(ح, أ);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x49, 0x54); // lt_u
        };
        أصدر_فخ_إذا_ويب_أسمبلي(ح);
    }
    | عملية_حساب_صحيح.طرح -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6B, 0x7D); // sub
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        لو (ضيق) { أصدر_فحص_نطاق_ضيق_ويب_أسمبلي(ح, الناتج, البتات, موقع); أرجع اختيار.لا_شيء(); };
        لو (موقع) {
            // ((a ^ b) & (a ^ r)) < 0
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85);
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x71, 0x83);
            أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, 0);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x48, 0x53);
        } وإلا {
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x49, 0x54);
        };
        أصدر_فخ_إذا_ويب_أسمبلي(ح);
    }
    | عملية_حساب_صحيح.ضرب -> {
        لو (ضيق) {
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
            أصدر_ويب_أسمبلي(ح, 0x6C); // i32.mul
            اكتب_محلي_ويب_أسمبلي(ح, الناتج);
            أصدر_فحص_نطاق_ضيق_ويب_أسمبلي(ح, الناتج, البتات, موقع);
            أرجع اختيار.لا_شيء();
        };
        لو (!واسع) {
            // 32-bit: the exact product in i64, then a range check.
            دع ت: غير_موقع = خذ_مؤقت64_ويب_أسمبلي(ح);
            اقرأ_محلي_ويب_أسمبلي(ح, أ);
            لو (موقع) { أصدر_ويب_أسمبلي(ح, 0xAC); } وإلا { أصدر_ويب_أسمبلي(ح, 0xAD); }; // i64.extend_i32_s/u
            اقرأ_محلي_ويب_أسمبلي(ح, ب);
            لو (موقع) { أصدر_ويب_أسمبلي(ح, 0xAC); } وإلا { أصدر_ويب_أسمبلي(ح, 0xAD); };
            أصدر_ويب_أسمبلي(ح, 0x7E); // i64.mul
            أصدر_محلي_ويب_أسمبلي(ح, 0x22, ت); // local.tee
            أصدر_ويب_أسمبلي(ح, 0xA7); // i32.wrap_i64
            اكتب_محلي_ويب_أسمبلي(ح, الناتج);
            اقرأ_محلي_ويب_أسمبلي(ح, ت);
            لو (موقع) {
                اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
                أصدر_ويب_أسمبلي(ح, 0xAC);
                أصدر_ويب_أسمبلي(ح, 0x52); // i64.ne
            } وإلا {
                أصدر_ثابت64_ويب_أسمبلي(ح, 4294967295);
                أصدر_ويب_أسمبلي(ح, 0x56); // i64.gt_u
            };
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            أعد_مؤقت64_ويب_أسمبلي(ح);
            أرجع اختيار.لا_شيء();
        };
        // 64-bit: no double-width multiply. The wrapped product r is exact iff
        // a == 0 or r / a == b, with a == -1 handled separately when signed
        // (MIN / -1 traps); the same expansion the LLVM provider uses.
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_ويب_أسمبلي(ح, 0x7E); // i64.mul
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        لو (موقع) {
            اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ثابت64_ويب_أسمبلي(ح, -1); أصدر_ويب_أسمبلي(ح, 0x51); // i64.eq
            أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if
            اقرأ_محلي_ويب_أسمبلي(ح, ب); أصدر_ثابت64_ويب_أسمبلي(ح, أدنى_موقع_ويب_أسمبلي(64)); أصدر_ويب_أسمبلي(ح, 0x51);
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x05); // else
            اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ويب_أسمبلي(ح, 0x50); أصدر_ويب_أسمبلي(ح, 0x45); // i64.eqz; i32.eqz
            أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if (a != 0)
            اقرأ_محلي_ويب_أسمبلي(ح, الناتج); اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ويب_أسمبلي(ح, 0x7F); // i64.div_s
            اقرأ_محلي_ويب_أسمبلي(ح, ب); أصدر_ويب_أسمبلي(ح, 0x52); // i64.ne
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x0B); // end
            أصدر_ويب_أسمبلي(ح, 0x0B); // end
        } وإلا {
            اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ويب_أسمبلي(ح, 0x50); أصدر_ويب_أسمبلي(ح, 0x45);
            أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if (a != 0)
            اقرأ_محلي_ويب_أسمبلي(ح, الناتج); اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ويب_أسمبلي(ح, 0x80); // i64.div_u
            اقرأ_محلي_ويب_أسمبلي(ح, ب); أصدر_ويب_أسمبلي(ح, 0x52);
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x0B);
        };
    }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع أصدر_قسمة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, صواب, خطأ); }
    | عملية_حساب_صحيح.قسمة_غير_موقعة -> { أرجع أصدر_قسمة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, خطأ, خطأ); }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع أصدر_قسمة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, صواب, صواب); }
    | عملية_حساب_صحيح.باقي_غير_موقع -> { أرجع أصدر_قسمة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, خطأ, صواب); }
    | عملية_حساب_صحيح.أو_بتي -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x72, 0x84); // or
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    }
    | عملية_حساب_صحيح.أو_حصري -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85); // xor
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    }
    | عملية_حساب_صحيح.و_بتي -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x71, 0x83); // and
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع أصدر_إزاحة_صحيحة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, 0); }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع أصدر_إزاحة_صحيحة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, 1); }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع أصدر_إزاحة_صحيحة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, 2); };
    أرجع اختيار.لا_شيء();
}

عرف أصدر_قسمة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    أ: غير_موقع, ب: غير_موقع, الناتج: غير_موقع,
    الوصف: &وصف_سلمي_ويب_أسمبلي,
    موقع: منطقي, باقي: منطقي
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع واسع: منطقي = (*الوصف).البتات == 64;
    اقرأ_محلي_ويب_أسمبلي(ح, ب);
    أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x45, 0x50); // eqz
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    لو (موقع) {
        اقرأ_محلي_ويب_أسمبلي(ح, أ);
        أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, أدنى_موقع_ويب_أسمبلي((*الوصف).البتات));
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x46, 0x51); // eq
        اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, -1);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x46, 0x51);
        أصدر_ويب_أسمبلي(ح, 0x71); // i32.and
        أصدر_فخ_إذا_ويب_أسمبلي(ح);
    };
    اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
    لو (باقي) {
        لو (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6F, 0x81); } // rem_s
        وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x70, 0x82); }; // rem_u
    } وإلا {
        لو (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6D, 0x7F); } // div_s
        وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6E, 0x80); }; // div_u
    };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختيار.لا_شيء();
}

// العملية: 0 left (lossless), 1 logical right, 2 arithmetic right.
عرف أصدر_إزاحة_صحيحة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    أ: غير_موقع, ب: غير_موقع, الناتج: غير_موقع,
    الوصف: &وصف_سلمي_ويب_أسمبلي,
    العملية: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع واسع: منطقي = (*الوصف).البتات == 64;
    دع البتات: غير_موقع = (*الوصف).البتات;
    دع موقع: منطقي = (*الوصف).موقع;
    دع ضيق: منطقي = البتات < 32;
    // The shift count must be below the operand width (unsigned compare).
    اقرأ_محلي_ويب_أسمبلي(ح, ب);
    أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, البتات مثل عدد);
    أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4F, 0x5A); // ge_u
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    لو (العملية == 0) {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x74, 0x86); // shl
        لو (ضيق) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, موقع); };
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        // Shifting back must recover the operand, or bits were lost.
        اقرأ_محلي_ويب_أسمبلي(ح, الناتج); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        لو (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x75, 0x87); } // shr_s
        وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x76, 0x88); }; // shr_u
        اقرأ_محلي_ويب_أسمبلي(ح, أ);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x47, 0x52); // ne
        أصدر_فخ_إذا_ويب_أسمبلي(ح);
        أرجع اختيار.لا_شيء();
    };
    لو (العملية == 1) {
        اقرأ_محلي_ويب_أسمبلي(ح, أ);
        لو (ضيق && موقع) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, خطأ); };
        اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x76, 0x88); // shr_u
        لو (ضيق && موقع) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, صواب); };
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        أرجع اختيار.لا_شيء();
    };
    اقرأ_محلي_ويب_أسمبلي(ح, أ);
    لو (ضيق && !موقع) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, صواب); };
    اقرأ_محلي_ويب_أسمبلي(ح, ب);
    أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x75, 0x87); // shr_s
    لو (ضيق && !موقع) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, خطأ); };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختيار.لا_شيء();
}

عرف أصدر_مقارنة_صحيحة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    المقارنة: &مقارنة_صحيح_مسير,
    الناتج: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع أ: غير_موقع; دع ب: غير_موقع;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*المقارنة).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { أ := م; };
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*المقارنة).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { ب := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*المقارنة).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    دع الوصف: وصف_سلمي_ويب_أسمبلي;
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> { الوصف := و; }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    دع واسع: منطقي = الوصف.البتات == 64;
    دع موقع: منطقي = الوصف.موقع;
    اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
    طابق (*المقارنة).العملية مع
    | عملية_مقارنة_صحيح.يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x46, 0x51); }
    | عملية_مقارنة_صحيح.لا_يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x47, 0x52); }
    | عملية_مقارنة_صحيح.أصغر -> {
        لو (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x48, 0x53); } وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x49, 0x54); };
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        لو (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4A, 0x55); } وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4B, 0x56); };
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        لو (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4C, 0x57); } وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4D, 0x58); };
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        لو (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4E, 0x59); } وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4F, 0x5A); };
    };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختيار.لا_شيء();
}

عرف أصدر_حساب_عشري_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الحساب: &حساب_عشري_مسير,
    الناتج: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع أ: غير_موقع; دع ب: غير_موقع;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { أ := م; };
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحساب).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { ب := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    دع واسع: متغير منطقي = خطأ;
    طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, النوع) مع
    | اختيار.بعض(البتات) -> { واسع := البتات == 64; }
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
    طابق (*الحساب).العملية مع
    | عملية_حساب_عشري.جمع -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x92, 0xA0); }
    | عملية_حساب_عشري.طرح -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x93, 0xA1); }
    | عملية_حساب_عشري.ضرب -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x94, 0xA2); }
    | عملية_حساب_عشري.قسمة -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x95, 0xA3); };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختيار.لا_شيء();
}

عرف أصدر_مقارنة_عشرية_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    المقارنة: &مقارنة_عشري_مسير,
    الناتج: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع أ: غير_موقع; دع ب: غير_موقع;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*المقارنة).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { أ := م; };
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*المقارنة).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { ب := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*المقارنة).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    دع واسع: متغير منطقي = خطأ;
    طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, النوع) مع
    | اختيار.بعض(البتات) -> { واسع := البتات == 64; }
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
    طابق (*المقارنة).العملية مع
    | عملية_مقارنة_عشري.يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5B, 0x61); }
    | عملية_مقارنة_عشري.لا_يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5C, 0x62); }
    | عملية_مقارنة_عشري.أصغر -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5D, 0x63); }
    | عملية_مقارنة_عشري.أكبر -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5E, 0x64); }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5F, 0x65); }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x60, 0x66); };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختيار.لا_شيء();
}

// Integer conversion with LLVM's sext/zext/trunc/bitcast meaning on the
// N-bit values, re-normalized for the destination type.
عرف أصدر_تحويل_صحيح_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    التحويل: &تحويل_صحيح_مسير,
    نوع_الناتج: معرف_نوع,
    الناتج: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع المصدر: غير_موقع;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*التحويل).المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { المصدر := م; };
    دع نوع_المصدر: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*التحويل).المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
    دع م: وصف_تحويل_صحيح_خلفية;
    طابق وصف_نوع_لتحويل_صحيح_للاختيار(&(*الحقائق).الأنواع, نوع_المصدر) مع
    | اختيار.بعض(و) -> { م := و; }
    | اختيار.لا_شيء -> {
        // Pointer-shaped operands are 32-bit unsigned words.
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_المصدر) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(ووصف) -> {
            لو (ووصف.عائم) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر)); };
            دع بديل: وصف_تحويل_صحيح_خلفية = { البتات: ووصف.البتات, موقع: ووصف.موقع };
            م := بديل;
        }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر)); };
    };
    دع و: وصف_تحويل_صحيح_خلفية;
    طابق وصف_نوع_لتحويل_صحيح_للاختيار(&(*الحقائق).الأنواع, نوع_الناتج) مع
    | اختيار.بعض(د) -> { و := د; }
    | اختيار.لا_شيء -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_الناتج) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(ووصف) -> {
            لو (ووصف.عائم) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
            دع بديل: وصف_تحويل_صحيح_خلفية = { البتات: ووصف.البتات, موقع: ووصف.موقع };
            و := بديل;
        }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
    };
    دع مصدر_واسع: منطقي = م.البتات == 64;
    دع وجهة_واسعة: منطقي = و.البتات == 64;
    اقرأ_محلي_ويب_أسمبلي(ح, المصدر);
    طابق (*التحويل).العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> {
        لو (!مصدر_واسع && !م.موقع && م.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(ح, م.البتات, صواب); };
        لو (!مصدر_واسع && وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xAC); }; // i64.extend_i32_s
        لو (مصدر_واسع && !وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xA7); }; // i32.wrap_i64
    }
    | عملية_تحويل_صحيح.توسيع_صفري -> {
        لو (!مصدر_واسع && م.موقع && م.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(ح, م.البتات, خطأ); };
        لو (!مصدر_واسع && وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xAD); }; // i64.extend_i32_u
        لو (مصدر_واسع && !وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xA7); };
    }
    | عملية_تحويل_صحيح.اقتطاع -> {
        لو (مصدر_واسع && !وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xA7); };
        لو (!مصدر_واسع && وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xAD); };
    }
    | عملية_تحويل_صحيح.إعادة_تفسير -> {
        لو (مصدر_واسع != وجهة_واسعة) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
    };
    لو (!وجهة_واسعة) { أصدر_تطبيع32_ويب_أسمبلي(ح, و.البتات, و.موقع); };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختيار.لا_شيء();
}

// --------------------------------------------------------- ABI support --

عرف نوع_معامل_خطة_ويب_أسمبلي(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الخطة: &خطة_معامل_واجهة
): نتيجة اختيار نوع_قيمة_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع نتيجة.نجح(اختيار.لا_شيء()); }
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { أرجع نتيجة.نجح(اختيار.بعض(نوع_قيمة_ويب_أسمبلي.صحيح32())); }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, (*الخطة).النوع) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> { أرجع نتيجة.نجح(اختيار.بعض(الوصف.النوع)); }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).النوع)); };
    }
    | موقع_تمرير_واجهة.مجزأ(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).النوع)); };
}

// The wasm signature of a call/function under its ABI plan.
عام عرف توقيع_خطة_ويب_أسمبلي(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الخطة: &خطة_دالة_واجهة,
    له_بيئة: منطقي
): نتيجة توقيع_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    دع المعاملات: متغير متجه نوع_قيمة_ويب_أسمبلي = [];
    دع النواتج: متغير متجه نوع_قيمة_ويب_أسمبلي = [];
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { ألحق(المعاملات, نوع_قيمة_ويب_أسمبلي.صحيح32()); }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, (*الخطة).الناتج.النوع) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> { ألحق(النواتج, الوصف.النوع); }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).الناتج.النوع)); };
    }
    | موقع_تمرير_واجهة.متجاهل -> { }
    | موقع_تمرير_واجهة.مجزأ(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).الناتج.النوع)); };
    لو (له_بيئة) { ألحق(المعاملات, نوع_قيمة_ويب_أسمبلي.صحيح32()); };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الخطة).المعاملات) مثل غير_موقع)) {
        طابق نوع_معامل_خطة_ويب_أسمبلي(الحقائق, &(*الخطة).المعاملات[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النوع_الاختياري) -> {
            طابق النوع_الاختياري مع
            | اختيار.بعض(النوع) -> { ألحق(المعاملات, النوع); }
            | اختيار.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    دع التوقيع: توقيع_ويب_أسمبلي = { المعاملات: المعاملات, النواتج: النواتج };
    أرجع نتيجة.نجح(التوقيع);
}

// The canonical ABI plan of an MSIR function definition.
عام عرف خطة_دالة_مسير_ويب_أسمبلي(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_دالة_مسير
): نتيجة خطة_دالة_واجهة, خطأ_اختيار_ويب_أسمبلي {
    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(المعرف)); }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(المعرف)); }
        | نتيجة.نجح(الخطة) -> { أرجع نتيجة.نجح(الخطة); };
    };
}

عام عرف دالة_دخول_ويب_أسمبلي(السياق: &سياق_وحدة_ويب_أسمبلي, المعرف: معرف_دالة_مسير): منطقي {
    طابق (*السياق).دالة_الدخول مع
    | اختيار.بعض(الدخول) -> { أرجع الدخول.القيمة == المعرف.القيمة; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

// The type-table index of an MSIR function definition's own signature.
عام عرف توقيع_دالة_مسير_ويب_أسمبلي(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المعرف: معرف_دالة_مسير
): نتيجة غير_موقع, خطأ_اختيار_ويب_أسمبلي {
    دع الخطة: خطة_دالة_واجهة;
    طابق خطة_دالة_مسير_ويب_أسمبلي(المسير, الحقائق, الهدف, سجل_التخطيط, المعرف) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(خ) -> { الخطة := خ; };
    دع له_بيئة: منطقي = !دالة_دخول_ويب_أسمبلي(السياق, المعرف);
    طابق توقيع_خطة_ويب_أسمبلي(الحقائق, &الخطة, له_بيئة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(التوقيع) -> { أرجع نتيجة.نجح(ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع)); };
}

// Pushes one call argument under its parameter plan.
عرف ادفع_حجة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_معامل_واجهة,
    المعرف: معرف_قيمة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع اختيار.لا_شيء(); }
    | _ -> { };
    دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
    طابق قيمة_ويب_أسمبلي(ح, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        لو (التمثيل.عنوان) {
            اقرأ_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
            أرجع اختيار.لا_شيء();
        };
        // A scalar passed by address is spilled to a frame slot first.
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: غير_موقع = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, المكان, 0, التمثيل) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        اقرأ_محلي_ويب_أسمبلي(ح, المكان);
    }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        لو (التمثيل.عنوان) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).النوع)); };
        اقرأ_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
    }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).النوع)); };
    أرجع اختيار.لا_شيء();
}

// The callee shapes of one MSIR call.
نوع مستدعى_ويب_أسمبلي =
    | مباشر بنوع مرجع_رمز_كائن
    | غير_مباشر بنوع (غير_موقع, غير_موقع)
;

// One call under its ABI plan: [indirect result] [environment] arguments.
عرف أصدر_نداء_بخطة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    الخطة: &خطة_دالة_واجهة,
    البيئة: اختيار غير_موقع,
    المستدعى: مستدعى_ويب_أسمبلي,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختيار معرف_قيمة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    لو ((الطول(*الحجج) مثل غير_موقع) != (الطول((*الخطة).المعاملات) مثل غير_موقع)) {
        أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة());
    };
    دع مكان_الناتج: متغير اختيار غير_موقع = اختيار.لا_شيء();
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: غير_موقع = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        مكان_الناتج := اختيار.بعض(المكان);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان);
    }
    | _ -> { };
    طابق البيئة مع
    | اختيار.بعض(المحلي) -> { اقرأ_محلي_ويب_أسمبلي(ح, المحلي); }
    | اختيار.لا_شيء -> { };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الحجج) مثل غير_موقع)) {
        طابق ادفع_حجة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, &(*الخطة).المعاملات[ف], (*الحجج)[ف]) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق المستدعى مع
    | مستدعى_ويب_أسمبلي.مباشر(الرمز) -> { أصدر_نداء_دالة_ويب_أسمبلي(ح, الرمز); }
    | مستدعى_ويب_أسمبلي.غير_مباشر(الإغلاق, التوقيع) -> {
        // Word zero of a closure environment is the function-table index.
        اقرأ_محلي_ويب_أسمبلي(ح, الإغلاق);
        أصدر_ويب_أسمبلي(ح, 0x28); // i32.load
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0);
        أصدر_ويب_أسمبلي(ح, 0x11); // call_indirect type table
        أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.فهرس_نوع(), هدف_إزاحة_ويب_أسمبلي.توقيع(التوقيع), 0);
        أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.رقم_جدول(), هدف_إزاحة_ويب_أسمبلي.جدول_الدوال(), 0);
    };
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.مباشر(_) -> { أصدر_ويب_أسمبلي(ح, 0x1A); } // drop
        | _ -> { };
    }
    | اختيار.بعض(المعرف) -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | موقع_تمرير_واجهة.غير_مباشر(_) -> {
            طابق مكان_الناتج مع
            | اختيار.بعض(المكان) -> {
                دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المكان, عنوان: صواب };
                ضع_قيمة_ويب_أسمبلي(ح, المعرف, التمثيل);
            }
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        }
        | موقع_تمرير_واجهة.مباشر(_) -> {
            دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
            طابق محلي_لنوع_ويب_أسمبلي(ح, الحقائق, (*الخطة).الناتج.النوع) مع
            | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة.نجح(ت) -> { التمثيل := ت; };
            اكتب_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
            ضع_قيمة_ويب_أسمبلي(ح, المعرف, التمثيل);
        }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
    };
    أرجع اختيار.لا_شيء();
}

// Calls a std allocation provider: (environment 0, operands...) -> address.
// A null allocation traps before any store through it.
عرف أصدر_نداء_مزود_ذاكرة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المزود: معرف_دالة_مسير,
    له_ناتج: منطقي
): اختيار غير_موقع {
    أصدر_نداء_دالة_ويب_أسمبلي(ح, مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المزود)));
    لو (!له_ناتج) { أرجع اختيار.لا_شيء(); };
    دع المحلي: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    أصدر_محلي_ويب_أسمبلي(ح, 0x22, المحلي); // local.tee
    أصدر_ويب_أسمبلي(ح, 0x45); // i32.eqz
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    أرجع اختيار.بعض(المحلي);
}

عرف أصدر_تخصيص_ثابت_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    السياق: &سياق_وحدة_ويب_أسمبلي,
    الحجم: غير_موقع
): نتيجة غير_موقع, خطأ_اختيار_ويب_أسمبلي {
    طابق (*السياق).مزودات_الذاكرة مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); }
    | اختيار.بعض(المزودات) -> {
        أصدر_ثابت32_ويب_أسمبلي(ح, 0);
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الحجم);
        طابق أصدر_نداء_مزود_ذاكرة_ويب_أسمبلي(ح, المزودات.التخصيص, صواب) مع
        | اختيار.بعض(المحلي) -> { أرجع نتيجة.نجح(المحلي); }
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); };
    };
}

// ------------------------------------------------------ instructions --

نوع حقول_تسلسل_ويب_أسمبلي = { البيانات: غير_موقع, الطول: غير_موقع, السعة: غير_موقع };

عرف حقول_تسلسل_ويب_أسمبلي_من(التخطيط: &واصف_تخطيط, النوع: معرف_نوع): نتيجة حقول_تسلسل_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    دع البيانات: غير_موقع; دع طول_: غير_موقع; دع السعة: غير_موقع;
    طابق إزاحة_جزء_ويب_أسمبلي(التخطيط, 0, النوع) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { البيانات := ق; };
    طابق إزاحة_جزء_ويب_أسمبلي(التخطيط, 1, النوع) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { طول_ := ق; };
    طابق إزاحة_جزء_ويب_أسمبلي(التخطيط, 2, النوع) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { السعة := ق; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي = { البيانات: البيانات, الطول: طول_, السعة: السعة };
    أرجع نتيجة.نجح(الحقول);
}

عرف نوع_عنصر_تسلسل_ويب_أسمبلي(الحقائق: &سياق_استعلام_اختيار_خلفية, النوع: معرف_نوع): اختيار معرف_نوع {
    طابق نوع_عنصر_متجه_دلالي(&(*الحقائق).الأنواع, النوع) مع
    | اختيار.بعض(ن) -> { أرجع اختيار.بعض(ن); }
    | اختيار.لا_شيء -> { };
    أرجع نوع_عنصر_شريحة_دلالي(&(*الحقائق).الأنواع, النوع);
}

// Pushes the i32 index (a 64-bit index wraps: bounds were checked in MSIR).
عرف ادفع_فهرس32_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الفهرس: معرف_قيمة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع المحلي: غير_موقع;
    طابق محلي_قيمة_ويب_أسمبلي(ح, الفهرس) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { المحلي := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الفهرس) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    اقرأ_محلي_ويب_أسمبلي(ح, المحلي);
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        لو (الوصف.البتات == 64) { أصدر_ويب_أسمبلي(ح, 0xA7); }; // i32.wrap_i64
    }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    أرجع اختيار.لا_شيء();
}

// Element address of a sequence value: data[index] (stride = element size).
عرف عنوان_عنصر_تسلسل_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المصدر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير,
    نوع_العنصر: معرف_نوع
): نتيجة غير_موقع, خطأ_اختيار_ويب_أسمبلي {
    دع العنوان: غير_موقع;
    طابق محلي_قيمة_ويب_أسمبلي(ح, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(م) -> { العنوان := م; };
    دع نوع_المصدر: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
    دع تخطيط_المصدر: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_المصدر := ت; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي;
    طابق حقول_تسلسل_ويب_أسمبلي_من(&تخطيط_المصدر, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
    دع تخطيط_العنصر: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
    أصدر_ويب_أسمبلي(ح, 0x28); // i32.load data
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
    طابق ادفع_فهرس32_ويب_أسمبلي(ح, الحقائق, المسير, الفهرس) مع | اختيار.بعض(خ) -> { أرجع نتيجة.خطأ(خ); } | اختيار.لا_شيء -> { };
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, تخطيط_العنصر.الحجم);
    أصدر_ويب_أسمبلي(ح, 0x6C); // i32.mul
    أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
    دع الناتج: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع نتيجة.نجح(الناتج);
}

// Capacity is checked before multiplying by the stride or allocating.
عرف سعة_تهيئة_متجه_ويب_أسمبلي(العدد: غير_موقع, حجم_العنصر: غير_موقع): اختيار غير_موقع {
    لو (العدد == 0) { أرجع اختيار.بعض(0); };
    لو (حجم_العنصر == 0) { أرجع اختيار.لا_شيء(); };
    دع الحد: غير_موقع = 4294967295 / حجم_العنصر;
    لو (العدد > الحد) { أرجع اختيار.لا_شيء(); };
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه();
    لو (السياسة.السعة_الدنيا == 0 || السياسة.عامل_النمو <= 1) { أرجع اختيار.لا_شيء(); };
    دع السعة: متغير غير_موقع = السياسة.السعة_الدنيا;
    لو (السعة > الحد) { أرجع اختيار.لا_شيء(); };
    بينما (السعة < العدد) {
        لو (السعة > الحد / السياسة.عامل_النمو) { أرجع اختيار.بعض(العدد); };
        السعة := السعة * السياسة.عامل_النمو;
    }
    أرجع اختيار.بعض(السعة);
}

عرف أصدر_طول_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير,
    الناتج: معرف_قيمة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    لو ((الطول((*النداء).الحجج) مثل غير_موقع) != 1) {
        أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.طول()));
    };
    دع المصدر: معرف_قيمة_مسير = (*النداء).الحجج[0];
    دع العنوان: غير_موقع;
    طابق محلي_قيمة_ويب_أسمبلي(ح, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { العنوان := م; };
    دع نوع_المصدر: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
    دع التخطيط: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي;
    طابق حقول_تسلسل_ويب_أسمبلي_من(&التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
    دع نوع_الناتج: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_الناتج := ن; };
    دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
    طابق محلي_لنوع_ويب_أسمبلي(ح, الحقائق, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
    // The header length field is a pointer-width (u32) word.
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
    أصدر_ويب_أسمبلي(ح, 0x28); // i32.load
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_الناتج) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        لو (الوصف.البتات == 64) { أصدر_ويب_أسمبلي(ح, 0xAD); } // i64.extend_i32_u
        وإلا { أصدر_تطبيع32_ويب_أسمبلي(ح, الوصف.البتات, الوصف.موقع); };
    }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
    اكتب_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
    ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
    أرجع اختيار.لا_شيء();
}

// Vector append: the same guarded growth policy as the LLVM provider, with the
// std reallocation provider for the backing storage.
عرف أصدر_إلحاق_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &سياق_وحدة_ويب_أسمبلي,
    النداء: &نداء_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    لو ((الطول((*النداء).الحجج) مثل غير_موقع) != 2) {
        أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.إلحاق()));
    };
    دع المكان: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختيار.بعض(م) -> { المكان := م; }
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.إلحاق())); };
    دع المزود: معرف_دالة_مسير;
    طابق (*السياق).مزودات_الذاكرة مع
    | اختيار.بعض(المزودات) -> { المزود := المزودات.إعادة_التخصيص; }
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); };
    دع العنوان: غير_موقع;
    طابق محلي_قيمة_ويب_أسمبلي(ح, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { العنوان := م; };
    دع نوع_المتجه: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي;
    طابق حقول_تسلسل_ويب_أسمبلي_من(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
    دع العنصر: معرف_قيمة_مسير = (*النداء).الحجج[1];
    دع نوع_العنصر: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_العنصر := ن; };
    دع تخطيط_العنصر: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    لو (تخطيط_العنصر.الحجم == 0 || تخطيط_العنصر.الحجم > 4294967295) {
        أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_العنصر));
    };
    دع تمثيل_العنصر: تمثيل_قيمة_ويب_أسمبلي;
    طابق قيمة_ويب_أسمبلي(ح, العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { تمثيل_العنصر := ت; };
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه();
    دع طول_حالي: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    دع سعة_حالية: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    دع سعة_جديدة: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    اكتب_محلي_ويب_أسمبلي(ح, طول_حالي);
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
    اكتب_محلي_ويب_أسمبلي(ح, سعة_حالية);
    // A corrupted header never becomes an unchecked store; length cannot wrap.
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); اقرأ_محلي_ويب_أسمبلي(ح, سعة_حالية); أصدر_ويب_أسمبلي(ح, 0x4B); // i32.gt_u
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); أصدر_ثابت32_ويب_أسمبلي(ح, -1); أصدر_ويب_أسمبلي(ح, 0x46); // i32.eq
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); اقرأ_محلي_ويب_أسمبلي(ح, سعة_حالية); أصدر_ويب_أسمبلي(ح, 0x46);
    أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if full
    // Doubling a nonzero capacity must not overflow.
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_حالية);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, 4294967295 / السياسة.عامل_النمو);
    أصدر_ويب_أسمبلي(ح, 0x4B); // i32.gt_u
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السياسة.السعة_الدنيا);
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_حالية); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السياسة.عامل_النمو); أصدر_ويب_أسمبلي(ح, 0x6C); // i32.mul
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_حالية); أصدر_ويب_أسمبلي(ح, 0x45); // i32.eqz
    أصدر_ويب_أسمبلي(ح, 0x1B); // select (minimum when empty)
    اكتب_محلي_ويب_أسمبلي(ح, سعة_جديدة);
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_جديدة);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, 4294967295 / تخطيط_العنصر.الحجم);
    أصدر_ويب_أسمبلي(ح, 0x4B);
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    // data := realloc(data, new_capacity * stride)
    أصدر_ثابت32_ويب_أسمبلي(ح, 0);
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_جديدة); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, تخطيط_العنصر.الحجم); أصدر_ويب_أسمبلي(ح, 0x6C);
    دع البيانات_الجديدة: غير_موقع;
    طابق أصدر_نداء_مزود_ذاكرة_ويب_أسمبلي(ح, المزود, صواب) مع
    | اختيار.بعض(م) -> { البيانات_الجديدة := م; }
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); };
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); اقرأ_محلي_ويب_أسمبلي(ح, البيانات_الجديدة);
    أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات); // i32.store
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); اقرأ_محلي_ويب_أسمبلي(ح, سعة_جديدة);
    أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
    أصدر_ويب_أسمبلي(ح, 0x0B); // end
    // data[length] := element
    دع مكان_العنصر: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, تخطيط_العنصر.الحجم); أصدر_ويب_أسمبلي(ح, 0x6C);
    أصدر_ويب_أسمبلي(ح, 0x6A);
    اكتب_محلي_ويب_أسمبلي(ح, مكان_العنصر);
    طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر, مكان_العنصر, 0, تمثيل_العنصر) مع
    | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
    | اختيار.لا_شيء -> { };
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); أصدر_ثابت32_ويب_أسمبلي(ح, 1); أصدر_ويب_أسمبلي(ح, 0x6A);
    أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    أرجع اختيار.لا_شيء();
}

عرف أصدر_ثابت_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    الثابت: &ثابت_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    طابق *الثابت مع
    | ثابت_مسير.نص(البايتات) -> {
        // Text literal: a frame header pointing at read-only object data.
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع الحقول: حقول_تسلسل_ويب_أسمبلي;
        طابق حقول_تسلسل_ويب_أسمبلي_من(&التخطيط, النوع) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
        دع المكان: غير_موقع = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        دع العدد: غير_موقع = الطول(البايتات) مثل غير_موقع;
        اقرأ_محلي_ويب_أسمبلي(ح, المكان);
        لو (العدد == 0) {
            أصدر_ثابت32_ويب_أسمبلي(ح, 0);
        } وإلا {
            دع المعرف: معرف_بيانات_ثابتة_كائن = معرف_بيانات_ثابتة_كائن_من(
                معرف_دالة_منتقاة_من_مسير((*ح).المعرف), الطول((*ح).البيانات_الثابتة) مثل غير_موقع
            );
            دع النسخة: متجه غ8 = البايتات;
            دع البيان: بيانات_ثابتة_كائن = {
                المعرف: معرف_بيانات_ثابتة_كائن_من(المعرف.الدالة, المعرف.القيمة),
                البيانات: النسخة, المحاذاة: 1, للقراءة_فقط: صواب
            };
            ألحق((*ح).البيانات_الثابتة, البيان);
            أصدر_عنوان_رمز_ويب_أسمبلي(ح, هدف_إزاحة_ويب_أسمبلي.رمز(مرجع_رمز_كائن.بيانات_ثابتة(المعرف)), 0);
        };
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, العدد);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, العدد);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المكان, عنوان: صواب };
        ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
        أرجع اختيار.لا_شيء();
    }
    | ثابت_مسير.متجه(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); }
    | _ -> { };
    دع الوصف: وصف_سلمي_ويب_أسمبلي;
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> { الوصف := و; }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    دع المحلي: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, الوصف.النوع);
    طابق *الثابت مع
    | ثابت_مسير.منطق(القيمة) -> {
        لو (القيمة) { أصدر_ثابت32_ويب_أسمبلي(ح, 1); } وإلا { أصدر_ثابت32_ويب_أسمبلي(ح, 0); };
    }
    | ثابت_مسير.صحيح_موقع(القيمة) -> { أصدر_ثابت_عدد_ويب_أسمبلي(ح, &الوصف, القيمة مثل غير_موقع); }
    | ثابت_مسير.صحيح_غير_موقع(القيمة) -> { أصدر_ثابت_عدد_ويب_أسمبلي(ح, &الوصف, القيمة); }
    | ثابت_مسير.مؤشر_فارغ -> { أصدر_ثابت32_ويب_أسمبلي(ح, 0); }
    | ثابت_مسير.عشري(البايتات) -> {
        طابق بتات_عائم_من_عشري(&البايتات, الوصف.البتات) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); }
        | اختيار.بعض(البتات) -> {
            لو (الوصف.البتات == 32) {
                أصدر_ويب_أسمبلي(ح, 0x43); // f32.const
                ألحق_قيمة_صغيرة_الطرف_ويب_أسمبلي(&متغير (*ح).الشفرة, البتات, 4);
            } وإلا {
                أصدر_ويب_أسمبلي(ح, 0x44); // f64.const
                ألحق_قيمة_صغيرة_الطرف_ويب_أسمبلي(&متغير (*ح).الشفرة, البتات, 8);
            };
        };
    }
    | ثابت_مسير.دالة(المعرف) -> { أصدر_فهرس_جدول_دالة_ويب_أسمبلي(ح, المعرف); }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المحلي, عنوان: خطأ };
    ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
    أرجع اختيار.لا_شيء();
}

عرف ناتج_مطلوب_ويب_أسمبلي(الناتج: اختيار معرف_قيمة_مسير): نتيجة معرف_قيمة_مسير, خطأ_اختيار_ويب_أسمبلي {
    طابق الناتج مع
    | اختيار.بعض(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
}

// A new scalar local for an instruction result (its type must be scalar).
عرف محلي_ناتج_سلمي_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الناتج: معرف_قيمة_مسير
): نتيجة غير_موقع, خطأ_اختيار_ويب_أسمبلي {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        دع المحلي: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, الوصف.النوع);
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المحلي, عنوان: خطأ };
        ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
        أرجع نتيجة.نجح(المحلي);
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

// The result value aliases an existing local (address or scalar copy).
عرف اربط_ناتج_بمحلي_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الناتج: معرف_قيمة_مسير,
    المحلي: غير_موقع,
    عنوان: منطقي
): فراغ {
    دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المحلي, عنوان: عنوان };
    ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
}

عرف أصدر_بدائي_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    البدائي: هوية_بدائي_مترجم,
    النداء: &نداء_مسير,
    الناتج: اختيار معرف_قيمة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    طابق البدائي مع
    | هوية_بدائي_مترجم.طول -> {
        طابق ناتج_مطلوب_ويب_أسمبلي(الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ن) -> { أرجع أصدر_طول_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, النداء, ن); };
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        أرجع أصدر_إلحاق_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, النداء);
    }
    | هوية_بدائي_مترجم.معمارية_المضيف -> { }
    | هوية_بدائي_مترجم.منصة_المضيف -> { }
    | هوية_بدائي_مترجم.بيئة_المضيف -> { }
    | هوية_بدائي_مترجم.بتات_ع64 -> { }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { }
    | هوية_بدائي_مترجم.بتات_ع32 -> { }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { }
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> { }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> { }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> { }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> { }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> { }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    // Scalar primitives: operands are locals, the result a new local.
    دع الحجج: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*النداء).الحجج) مثل غير_موقع)) {
        طابق محلي_قيمة_ويب_أسمبلي(ح, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { ألحق(الحجج, م); };
        ف := ف + 1;
    }
    دع العدد: غير_موقع = الطول(الحجج) مثل غير_موقع;
    طابق البدائي مع
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
        لو (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 2) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); اقرأ_محلي_ويب_أسمبلي(ح, الحجج[1]);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0); // i32.store
        أرجع اختيار.لا_شيء();
    }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
        لو (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 3) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); اقرأ_محلي_ويب_أسمبلي(ح, الحجج[1]); اقرأ_محلي_ويب_أسمبلي(ح, الحجج[2]);
        أصدر_نسخ_ذاكرة_ويب_أسمبلي(ح);
        أرجع اختيار.لا_شيء();
    }
    | _ -> { };
    دع المعرف: معرف_قيمة_مسير;
    طابق ناتج_مطلوب_ويب_أسمبلي(الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { المعرف := ن; };
    دع المحلي: غير_موقع;
    طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { المحلي := م; };
    طابق البدائي مع
    | هوية_بدائي_مترجم.معمارية_المضيف -> { أرجع أصدر_هوية_مضيف_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, البدائي, المعرف, المحلي); }
    | هوية_بدائي_مترجم.منصة_المضيف -> { أرجع أصدر_هوية_مضيف_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, البدائي, المعرف, المحلي); }
    | هوية_بدائي_مترجم.بيئة_المضيف -> { أرجع أصدر_هوية_مضيف_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, البدائي, المعرف, المحلي); }
    | هوية_بدائي_مترجم.بتات_ع64 -> {
        لو (العدد != 1) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xBD); // i64.reinterpret_f64
    }
    | هوية_بدائي_مترجم.ع64_من_بتات -> {
        لو (العدد != 1) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xBF); // f64.reinterpret_i64
    }
    | هوية_بدائي_مترجم.بتات_ع32 -> {
        لو (العدد != 1) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xBC); // i32.reinterpret_f32
    }
    | هوية_بدائي_مترجم.ع32_من_بتات -> {
        لو (العدد != 1) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xBE); // f32.reinterpret_i32
    }
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
        لو (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 1) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]);
        أصدر_ويب_أسمبلي(ح, 0x40); أصدر_ويب_أسمبلي(ح, 0x00); // memory.grow 0
    }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
        لو (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 1) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]);
        أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0); // i32.load
    }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
        لو (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 0) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        أصدر_عنوان_رمز_ويب_أسمبلي(ح, هدف_إزاحة_ويب_أسمبلي.قاعدة_الكومة(), 0);
    }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    أرجع اختيار.لا_شيء();
}

عرف أصدر_هوية_مضيف_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم,
    المعرف: معرف_قيمة_مسير,
    المحلي: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع الرمز: عدد;
    طابق رمز_بدائي_هوية_مضيف_للهدف(الهدف, البدائي) مع
    | اختيار.بعض(ر) -> { الرمز := ر; }
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> { أصدر_ثابت_عدد_ويب_أسمبلي(ح, &الوصف, الرمز مثل غير_موقع); }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    أرجع اختيار.لا_شيء();
}

عرف أصدر_نداء_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    النداء: &نداء_مسير,
    الناتج: اختيار معرف_قيمة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(المعرف) -> {
        دع العرض: عرض_دالة_مسير;
        طابق ابحث_دالة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(المعرف)); }
        | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
        // A function with captures is reached only through its closure value.
        لو (العرض.عدد_الالتقاطات > 0) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع الخطة: خطة_دالة_واجهة;
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(المعرف)); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع البيئة: متغير اختيار غير_موقع = اختيار.لا_شيء();
        لو (!دالة_دخول_ويب_أسمبلي(السياق, المعرف)) {
            // A direct call passes a null closure environment.
            دع الفارغة: غير_موقع = خذ_مؤقت32_ويب_أسمبلي(ح);
            أصدر_ثابت32_ويب_أسمبلي(ح, 0);
            اكتب_محلي_ويب_أسمبلي(ح, الفارغة);
            أعد_مؤقت32_ويب_أسمبلي(ح);
            البيئة := اختيار.بعض(الفارغة);
        };
        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المعرف));
        أرجع أصدر_نداء_بخطة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, السياق, &الخطة, البيئة,
            مستدعى_ويب_أسمبلي.مباشر(الرمز), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.دالة_خارجية(المعرف) -> {
        دع الخطة: خطة_دالة_واجهة;
        طابق حل_واجهة_نداء_خارجي_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الحجج, الناتج) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.رمز_خارجي(معرف_دالة_خارجية_منتقاة_من_مسير(المعرف));
        أرجع أصدر_نداء_بخطة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, السياق, &الخطة, اختيار.لا_شيء(),
            مستدعى_ويب_أسمبلي.مباشر(الرمز), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.قيمة_دالة(معرف_القيمة) -> {
        دع الإغلاق: غير_موقع;
        طابق محلي_قيمة_ويب_أسمبلي(ح, معرف_القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { الإغلاق := م; };
        دع الخطة: خطة_دالة_واجهة;
        طابق حل_واجهة_نداء_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الحجج, الناتج) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع فهرس_التوقيع: غير_موقع;
        طابق توقيع_خطة_ويب_أسمبلي(الحقائق, &الخطة, صواب) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(التوقيع) -> { فهرس_التوقيع := ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع); };
        أرجع أصدر_نداء_بخطة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, السياق, &الخطة, اختيار.بعض(الإغلاق),
            مستدعى_ويب_أسمبلي.غير_مباشر(الإغلاق, فهرس_التوقيع), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        طابق البدائي مع
        | هوية_بدائي_مترجم.تحرير -> {
            // Release adapts the std release provider (runtime_primitive_query_context.sn).
            طابق نداء_تحرير_مكيف_للهدف(الهدف, الحقائق, المسير, النداء) مع
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); }
            | اختيار.بعض(المكيف) -> {
                أرجع أصدر_نداء_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, &المكيف, الناتج);
            };
        }
        | _ -> { };
        أرجع أصدر_بدائي_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, البدائي, النداء, الناتج);
    };
}

عرف اخفض_تعليمة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    التعليمة: &عرض_تعليمة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    طابق (*التعليمة).العملية مع
    | عملية_مسير.نداء(النداء) -> {
        أرجع أصدر_نداء_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, &النداء, (*التعليمة).الناتج);
    }
    | عملية_مسير.تخزين(العملية) -> {
        دع المكان: غير_موقع;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { المكان := م; };
        دع النوع: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
        طابق قيمة_ويب_أسمبلي(ح, العملية.القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
        أرجع خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, النوع, المكان, 0, التمثيل);
    }
    | _ -> { };
    دع الناتج: معرف_قيمة_مسير;
    طابق ناتج_مطلوب_ويب_أسمبلي((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { الناتج := ن; };
    دع نوع_الناتج: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_الناتج := ن; };
    طابق (*التعليمة).العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        أرجع أصدر_ثابت_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, الناتج, &الثابت);
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_حساب_صحيح_ويب_أسمبلي(ح, الحقائق, المسير, &الحساب, م); };
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_مقارنة_صحيحة_ويب_أسمبلي(ح, الحقائق, المسير, &المقارنة, م); };
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_حساب_عشري_ويب_أسمبلي(ح, الحقائق, المسير, &الحساب, م); };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_مقارنة_عشرية_ويب_أسمبلي(ح, الحقائق, المسير, &المقارنة, م); };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_تحويل_صحيح_ويب_أسمبلي(ح, الحقائق, المسير, &التحويل, نوع_الناتج, م); };
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, التحويل.المرجع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, خطأ); };
    }
    | عملية_مسير.نقل_تسلسل_مملوك(النقل) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, النقل.المصدر) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, صواب); };
    }
    | عملية_مسير.تجميع(التجميع) -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: غير_موقع = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(التجميع.الأعضاء) مثل غير_موقع)) {
            دع العضو: معرف_قيمة_مسير = التجميع.الأعضاء[ف];
            دع الإزاحة: غير_موقع;
            طابق إزاحة_جزء_ويب_أسمبلي(&التخطيط, ف, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { الإزاحة := ق; };
            دع نوع_العضو: معرف_نوع;
            طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العضو) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_العضو := ن; };
            دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
            طابق قيمة_ويب_أسمبلي(ح, العضو) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
            طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_العضو, المكان, الإزاحة, التمثيل) مع
            | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المكان, صواب);
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_تسلسل_ويب_أسمبلي(الحقائق, نوع_الناتج) مع
        | اختيار.بعض(ن) -> { نوع_العنصر := ن; }
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
        دع تخطيط_المتجه: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
        دع تخطيط_العنصر: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
        دع الحقول: حقول_تسلسل_ويب_أسمبلي;
        طابق حقول_تسلسل_ويب_أسمبلي_من(&تخطيط_المتجه, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
        دع العدد: غير_موقع = الطول(التهيئة.العناصر) مثل غير_موقع;
        دع السعة: غير_موقع;
        طابق سعة_تهيئة_متجه_ويب_أسمبلي(العدد, تخطيط_العنصر.الحجم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); }
        | اختيار.بعض(س) -> { السعة := س; };
        دع المكان: غير_موقع = عنوان_إطار_جديد_ويب_أسمبلي(ح, تخطيط_المتجه.الحجم, تخطيط_المتجه.المحاذاة);
        دع البيانات: متغير اختيار غير_موقع = اختيار.لا_شيء();
        لو (السعة > 0) {
            طابق أصدر_تخصيص_ثابت_ويب_أسمبلي(ح, السياق, السعة * تخطيط_العنصر.الحجم) مع
            | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة.نجح(م) -> { البيانات := اختيار.بعض(م); };
        };
        اقرأ_محلي_ويب_أسمبلي(ح, المكان);
        طابق البيانات مع
        | اختيار.بعض(م) -> { اقرأ_محلي_ويب_أسمبلي(ح, م); }
        | اختيار.لا_شيء -> { أصدر_ثابت32_ويب_أسمبلي(ح, 0); };
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, العدد);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السعة);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
        طابق البيانات مع
        | اختيار.بعض(م) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < العدد) {
                دع العنصر: معرف_قيمة_مسير = التهيئة.العناصر[ف];
                دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
                طابق قيمة_ويب_أسمبلي(ح, العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
                طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر, م, ف * تخطيط_العنصر.الحجم, التمثيل) مع
                | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }
        }
        | اختيار.لا_شيء -> { };
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المكان, صواب);
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
        دع الأساس: غير_موقع;
        طابق محلي_قيمة_ويب_أسمبلي(ح, الاستخراج.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { الأساس := م; };
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الاستخراج.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع الإزاحة: غير_موقع;
        طابق إزاحة_جزء_ويب_أسمبلي(&التخطيط, الاستخراج.الفهرس, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { الإزاحة := ق; };
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, الأساس, الإزاحة) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | عملية_مسير.استخراج_فهرس(الاستخراج) -> {
        دع العنوان: غير_موقع;
        طابق عنوان_عنصر_تسلسل_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, الاستخراج.المصدر, الاستخراج.الفهرس, نوع_الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { العنوان := م; };
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, العنوان, 0) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | عملية_مسير.مكان_محلي(_) -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: غير_موقع = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المكان, صواب);
    }
    | عملية_مسير.مكان_عام(العملية) -> {
        دع المحلي: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
        أصدر_عنوان_رمز_ويب_أسمبلي(ح, هدف_إزاحة_ويب_أسمبلي.رمز(مرجع_رمز_كائن.عام(العملية.العام)), 0);
        اكتب_محلي_ويب_أسمبلي(ح, المحلي);
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المحلي, صواب);
    }
    | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المرجع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, صواب); };
    }
    | عملية_مسير.صندوق_إلى_مكان(العملية) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.الصندوق) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, صواب); };
    }
    | عملية_مسير.مكان_حقل(العملية) -> {
        دع الأساس: غير_موقع;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.الأصل) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { الأساس := م; };
        دع نوع_الأصل: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.الأصل) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_الأصل := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الأصل) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع الإزاحة: غير_موقع;
        طابق إزاحة_جزء_ويب_أسمبلي(&التخطيط, العملية.الفهرس, نوع_الأصل) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { الإزاحة := ق; };
        لو (الإزاحة == 0) {
            اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, الأساس, صواب);
        } وإلا {
            دع المحلي: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
            أصدر_عنوان_مزاح_ويب_أسمبلي(ح, الأساس, الإزاحة);
            اكتب_محلي_ويب_أسمبلي(ح, المحلي);
            اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المحلي, صواب);
        };
    }
    | عملية_مسير.مكان_فهرس(العملية) -> {
        طابق عنوان_عنصر_تسلسل_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, العملية.الأصل, العملية.الفهرس, نوع_الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, صواب); };
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
        دع المؤشر: غير_موقع;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المؤشر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { المؤشر := م; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        اقرأ_محلي_ويب_أسمبلي(ح, المؤشر);
        طابق ادفع_فهرس32_ويب_أسمبلي(ح, الحقائق, المسير, العملية.الفهرس) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, التخطيط.الحجم);
        أصدر_ويب_أسمبلي(ح, 0x6C); // i32.mul
        أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
        دع المحلي: غير_موقع = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
        اكتب_محلي_ويب_أسمبلي(ح, المحلي);
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المحلي, صواب);
    }
    | عملية_مسير.تحميل(العملية) -> {
        دع المكان: غير_موقع;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { المكان := م; };
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, المكان, 0) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | عملية_مسير.مكان_إلى_مرجع(العملية) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المكان) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, خطأ); };
    }
    | عملية_مسير.بناء_موسوم(البناء) -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع التعداد: تخطيط_تعداد;
        طابق تعداد_ويب_أسمبلي(&التخطيط) مع
        | اختيار.بعض(ت) -> { التعداد := ت; }
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
        دع خطة_المنشئ: تخطيط_حمولات_منشئ;
        طابق تخطيط_منشئ_قيمة_مسير_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, الناتج, البناء.المنشئ) مع
        | نتيجة_تخطيط_منشئ.مكتمل(خ) -> { خطة_المنشئ := خ; }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.تخطيط_غير_مكتمل(نوع_الناتج)); };
        لو ((الطول(البناء.الحمولات) مثل غير_موقع) != (الطول(خطة_المنشئ.الحمولات) مثل غير_موقع)) {
            أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة());
        };
        دع المكان: غير_موقع = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        طابق أصدر_تخزين_وسم_ويب_أسمبلي(ح, المكان, &التعداد.الوسم, خطة_المنشئ.قيمة_الوسم) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(البناء.الحمولات) مثل غير_موقع)) {
            دع الحمولة: معرف_قيمة_مسير = البناء.الحمولات[ف];
            دع نوع_الحمولة: معرف_نوع;
            طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الحمولة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_الحمولة := ن; };
            دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
            طابق قيمة_ويب_أسمبلي(ح, الحمولة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
            دع الإزاحة: غير_موقع = التعداد.مخزن_الحمولة.الإزاحة + خطة_المنشئ.الحمولات[ف].الإزاحة;
            طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الحمولة, المكان, الإزاحة, التمثيل) مع
            | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المكان, صواب);
    }
    | عملية_مسير.استعلام_وسم(العملية) -> {
        دع المصدر: غير_موقع;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { المصدر := م; };
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع التعداد: تخطيط_تعداد;
        طابق تعداد_ويب_أسمبلي(&التخطيط) مع
        | اختيار.بعض(ت) -> { التعداد := ت; }
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر)); };
        دع المحلي: غير_موقع;
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { المحلي := م; };
        اقرأ_محلي_ويب_أسمبلي(ح, المصدر);
        دع حجم_الوسم: غير_موقع = التعداد.الوسم.الحجم;
        لو (حجم_الوسم == 1) {
            أصدر_ويب_أسمبلي(ح, 0x2D); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 1, التعداد.الوسم.الإزاحة); // load8_u
        } وإلا لو (حجم_الوسم == 2) {
            أصدر_ويب_أسمبلي(ح, 0x2F); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 2, التعداد.الوسم.الإزاحة); // load16_u
        } وإلا لو (حجم_الوسم == 4) {
            أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, التعداد.الوسم.الإزاحة); // i32.load
        } وإلا لو (حجم_الوسم == 8) {
            أصدر_ويب_أسمبلي(ح, 0x29); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, التعداد.الوسم.الإزاحة); // i64.load
        } وإلا {
            أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر));
        };
        // The tag value is zero-extended (or truncated) to the result type.
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_الناتج) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
            لو (الوصف.البتات == 64 && حجم_الوسم != 8) { أصدر_ويب_أسمبلي(ح, 0xAD); }; // i64.extend_i32_u
            لو (الوصف.البتات != 64 && حجم_الوسم == 8) { أصدر_ويب_أسمبلي(ح, 0xA7); }; // i32.wrap_i64
            لو (الوصف.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(ح, الوصف.البتات, الوصف.موقع); };
        }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
        اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    }
    | عملية_مسير.استخراج_حمولة(العملية) -> {
        دع المصدر: غير_موقع;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(م) -> { المصدر := م; };
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع التعداد: تخطيط_تعداد;
        طابق تعداد_ويب_أسمبلي(&التخطيط) مع
        | اختيار.بعض(ت) -> { التعداد := ت; }
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر)); };
        دع الخطة: تخطيط_حمولات_منشئ;
        طابق تخطيط_منشئ_قيمة_مسير_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, العملية.المصدر, العملية.المنشئ) مع
        | نتيجة_تخطيط_منشئ.مكتمل(خ) -> { الخطة := خ; }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.تخطيط_غير_مكتمل(نوع_المصدر)); };
        لو (العملية.الحمولة >= (الطول(الخطة.الحمولات) مثل غير_موقع)) {
            أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة());
        };
        دع الإزاحة: غير_موقع = التعداد.مخزن_الحمولة.الإزاحة + الخطة.الحمولات[العملية.الحمولة].الإزاحة;
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, المصدر, الإزاحة) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | عملية_مسير.بناء_صندوق(العملية) -> {
        دع نوع_القيمة: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_القيمة := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع الصندوق: غير_موقع;
        طابق أصدر_تخصيص_ثابت_ويب_أسمبلي(ح, السياق, التخطيط.الحجم) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { الصندوق := م; };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
        طابق قيمة_ويب_أسمبلي(ح, العملية.القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
        طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_القيمة, الصندوق, 0, التمثيل) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, الصندوق, خطأ);
    }
    | عملية_مسير.بناء_إغلاق(البناء) -> {
        دع العرض: عرض_دالة_مسير;
        طابق ابحث_دالة_مسير(المسير, البناء.الدالة) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(البناء.الدالة)); }
        | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
        دع الخطة: تخطيط_بيئة_إغلاق_اختيار;
        طابق خطط_بيئة_إغلاق_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, البناء.الدالة, العرض.عدد_الالتقاطات) مع
        | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(خ) -> { الخطة := خ; }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع البيئة: غير_موقع;
        طابق أصدر_تخصيص_ثابت_ويب_أسمبلي(ح, السياق, الخطة.الحجم) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { البيئة := م; };
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        أصدر_فهرس_جدول_دالة_ويب_أسمبلي(ح, البناء.الدالة);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0); // i32.store
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(البناء.الالتقاطات) مثل غير_موقع)) {
            لو (ف >= (الطول(الخطة.إزاحات_الالتقاطات) مثل غير_موقع)) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
            دع الالتقاط: معرف_قيمة_مسير = البناء.الالتقاطات[ف];
            دع نوع_الالتقاط: معرف_نوع;
            طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الالتقاط) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ن) -> { نوع_الالتقاط := ن; };
            دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
            طابق قيمة_ويب_أسمبلي(ح, الالتقاط) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
            طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الالتقاط, البيئة, الخطة.إزاحات_الالتقاطات[ف], التمثيل) مع
            | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, البيئة, خطأ);
    }
    | عملية_مسير.استخراج_التقاط(العملية) -> {
        دع البيئة: غير_موقع;
        طابق (*ح).بيئة_الإغلاق مع
        | اختيار.بعض(م) -> { البيئة := م; }
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع العرض: عرض_دالة_مسير;
        طابق ابحث_دالة_مسير(المسير, (*ح).المعرف) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة((*ح).المعرف)); }
        | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
        دع الخطة: تخطيط_بيئة_إغلاق_اختيار;
        طابق خطط_بيئة_إغلاق_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, (*ح).المعرف, العرض.عدد_الالتقاطات) مع
        | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(خ) -> { الخطة := خ; }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        لو (العملية.الفهرس >= (الطول(الخطة.إزاحات_الالتقاطات) مثل غير_موقع)) {
            أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة());
        };
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, البيئة, الخطة.إزاحات_الالتقاطات[العملية.الفهرس]) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
    أرجع اختيار.لا_شيء();
}

عرف أصدر_تخزين_وسم_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المكان: غير_موقع,
    الوسم: &تمثيل_وسم_تعداد,
    القيمة: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    اقرأ_محلي_ويب_أسمبلي(ح, المكان);
    دع الحجم: غير_موقع = (*الوسم).الحجم;
    لو (الحجم == 8) {
        أصدر_ثابت64_ويب_أسمبلي(ح, القيمة مثل عدد);
        أصدر_ويب_أسمبلي(ح, 0x37); // i64.store
    } وإلا {
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, القيمة);
        لو (الحجم == 1) { أصدر_ويب_أسمبلي(ح, 0x3A); } // i32.store8
        وإلا لو (الحجم == 2) { أصدر_ويب_أسمبلي(ح, 0x3B); } // i32.store16
        وإلا لو (الحجم == 4) { أصدر_ويب_أسمبلي(ح, 0x36); } // i32.store
        وإلا { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
    };
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, (*الوسم).الإزاحة);
    أرجع اختيار.لا_شيء();
}

// ------------------------------------------------------ structured CFG --

عرف ادفع_بنية_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الإطار: إطار_بنية_ويب_أسمبلي): فراغ {
    لو ((*ح).عمق_السياق < (الطول((*ح).السياق) مثل غير_موقع)) {
        (*ح).السياق[(*ح).عمق_السياق] := الإطار;
    } وإلا {
        ألحق((*ح).السياق, الإطار);
    };
    (*ح).عمق_السياق := (*ح).عمق_السياق + 1;
}

عرف أزل_بنية_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    (*ح).عمق_السياق := (*ح).عمق_السياق - 1;
}

// Relative depth of the enclosing loop headed by (or block followed by) the
// block الكتلة, counted from the innermost construct.
عرف عمق_فرع_ويب_أسمبلي(ح: &حالة_اختيار_ويب_أسمبلي, الكتلة: غير_موقع, حلقة: منطقي): اختيار غير_موقع {
    دع ف: متغير غير_موقع = (*ح).عمق_السياق;
    بينما (ف > 0) {
        ف := ف - 1;
        دع مطابق: متغير منطقي = خطأ;
        طابق (*ح).السياق[ف] مع
        | إطار_بنية_ويب_أسمبلي.حلقة(الرأس) -> { مطابق := حلقة && الرأس == الكتلة; }
        | إطار_بنية_ويب_أسمبلي.كتلة(التالية) -> { مطابق := !حلقة && التالية == الكتلة; }
        | إطار_بنية_ويب_أسمبلي.شرط -> { };
        لو (مطابق) { أرجع اختيار.بعض((*ح).عمق_السياق - 1 - ف); };
    }
    أرجع اختيار.لا_شيء();
}

عرف أصدر_خاتمة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    اقرأ_محلي_ويب_أسمبلي(ح, (*ح).محلي_الإطار);
    أصدر_حجم_الإطار_ويب_أسمبلي(ح);
    أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
    أصدر_مؤشر_المكدس_ويب_أسمبلي(ح, 0x24); // global.set __stack_pointer
}

نوع خطة_دالة_جارية_ويب_أسمبلي = {
    الخطة: خطة_دالة_واجهة
};

عرف أصدر_إرجاع_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_دالة_واجهة,
    القيمة: اختيار معرف_قيمة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { }
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع المعرف: معرف_قيمة_مسير;
        طابق القيمة مع | اختيار.بعض(م) -> { المعرف := م; } | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع العنوان: غير_موقع;
        طابق (*ح).عنوان_الناتج مع | اختيار.بعض(م) -> { العنوان := م; } | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
        طابق قيمة_ويب_أسمبلي(ح, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
        طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع, العنوان, 0, التمثيل) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
    }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        دع المعرف: معرف_قيمة_مسير;
        طابق القيمة مع | اختيار.بعض(م) -> { المعرف := م; } | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
        طابق قيمة_ويب_أسمبلي(ح, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
        لو (التمثيل.عنوان) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).الناتج.النوع)); };
        اقرأ_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
    }
    | موقع_تمرير_واجهة.مجزأ(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).الناتج.النوع)); };
    أصدر_خاتمة_ويب_أسمبلي(ح);
    أصدر_ويب_أسمبلي(ح, 0x0F); // return
    أرجع اختيار.لا_شيء();
}

// Block arguments as one parallel copy: push every argument, then assign the
// target parameters in reverse.
عرف أصدر_حجج_حافة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    دع العرض: عرض_كتلة_مسير;
    طابق ابحث_كتلة_مسير(المسير, (*الحافة).الهدف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة((*الحافة).الهدف)); }
    | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> { العرض := ع; };
    دع العدد: غير_موقع = الطول((*الحافة).الحجج) مثل غير_موقع;
    لو (العدد != العرض.عدد_المعاملات) { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.حافة_غير_صالحة()); };
    لو (العدد == 0) { أرجع اختيار.لا_شيء(); };
    دع الوجهات: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحافة).الحجج[ف]) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { اقرأ_محلي_ويب_أسمبلي(ح, م); };
        طابق معامل_كتلة_مسير_عند(المسير, (*الحافة).الهدف, ف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.حافة_غير_صالحة()); }
        | اختيار.بعض(المعامل) -> {
            طابق محلي_قيمة_ويب_أسمبلي(ح, المعامل.المعرف) مع
            | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة.نجح(م) -> { ألحق(الوجهات, م); };
        };
        ف := ف + 1;
    }
    ف := العدد;
    بينما (ف > 0) {
        ف := ف - 1;
        اكتب_محلي_ويب_أسمبلي(ح, الوجهات[ف]);
    }
    أرجع اختيار.لا_شيء();
}

نوع مدخلات_بنية_ويب_أسمبلي = {
    البنية: بنية_تدفق_ويب_أسمبلي,
    الخطة: خطة_دالة_واجهة
};

عرف أصدر_فرع_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المدخلات: &مدخلات_بنية_ويب_أسمبلي,
    المصدر: غير_موقع,
    الحافة: &حافة_مسير
): اختيار خطأ_اختيار_ويب_أسمبلي {
    طابق أصدر_حجج_حافة_ويب_أسمبلي(ح, المسير, الحافة) مع
    | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
    | اختيار.لا_شيء -> { };
    دع الوجهة: غير_موقع = (*الحافة).الهدف.القيمة;
    دع البنية: &بنية_تدفق_ويب_أسمبلي = &(*المدخلات).البنية;
    لو ((*البنية).رقم_الترتيب[الوجهة] <= (*البنية).رقم_الترتيب[المصدر]) {
        طابق عمق_فرع_ويب_أسمبلي(ح, الوجهة, صواب) مع
        | اختيار.بعض(العمق) -> { أصدر_ويب_أسمبلي(ح, 0x0C); أصدر_ليب_ويب_أسمبلي(ح, العمق); أرجع اختيار.لا_شيء(); } // br
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.تدفق_غير_قابل_للاختزال((*ح).المعرف)); };
    };
    لو ((*البنية).عقدة_دمج[الوجهة]) {
        طابق عمق_فرع_ويب_أسمبلي(ح, الوجهة, خطأ) مع
        | اختيار.بعض(العمق) -> { أصدر_ويب_أسمبلي(ح, 0x0C); أصدر_ليب_ويب_أسمبلي(ح, العمق); أرجع اختيار.لا_شيء(); } // br
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.تدفق_غير_قابل_للاختزال((*ح).المعرف)); };
    };
    أرجع أصدر_شجرة_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الوجهة);
}

عرف أصدر_شجرة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المدخلات: &مدخلات_بنية_ويب_أسمبلي,
    الكتلة: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    لو ((*المدخلات).البنية.رأس_حلقة[الكتلة]) {
        أصدر_ويب_أسمبلي(ح, 0x03); أصدر_ويب_أسمبلي(ح, 0x40); // loop
        ادفع_بنية_ويب_أسمبلي(ح, إطار_بنية_ويب_أسمبلي.حلقة(الكتلة));
        طابق أصدر_ضمن_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, 0) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        أزل_بنية_ويب_أسمبلي(ح);
        أصدر_ويب_أسمبلي(ح, 0x0B); // end
        أرجع اختيار.لا_شيء();
    };
    أرجع أصدر_ضمن_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, 0);
}

// Code for block الكتلة wrapped in one `block` per merge child (highest RPO
// outermost); after each `block` ends, the merge child's own subtree.
عرف أصدر_ضمن_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المدخلات: &مدخلات_بنية_ويب_أسمبلي,
    الكتلة: غير_موقع,
    البداية: غير_موقع
): اختيار خطأ_اختيار_ويب_أسمبلي {
    لو (البداية < (الطول((*المدخلات).البنية.أطفال_الدمج[الكتلة]) مثل غير_موقع)) {
        دع الطفل: غير_موقع = (*المدخلات).البنية.أطفال_الدمج[الكتلة][البداية];
        أصدر_ويب_أسمبلي(ح, 0x02); أصدر_ويب_أسمبلي(ح, 0x40); // block
        ادفع_بنية_ويب_أسمبلي(ح, إطار_بنية_ويب_أسمبلي.كتلة(الطفل));
        طابق أصدر_ضمن_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, البداية + 1) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        أزل_بنية_ويب_أسمبلي(ح);
        أصدر_ويب_أسمبلي(ح, 0x0B); // end
        أرجع أصدر_شجرة_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الطفل);
    };
    دع المعرف: معرف_كتلة_مسير = معرف_كتلة_مسير_من((*ح).المعرف, الكتلة);
    دع العرض: عرض_كتلة_مسير;
    طابق ابحث_كتلة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(المعرف)); }
    | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> { العرض := ع; };
    دع ت: متغير غير_موقع = 0;
    بينما (ت < العرض.عدد_التعليمات) {
        طابق تعليمة_مسير_عند(المسير, المعرف, ت) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(المعرف)); }
        | اختيار.بعض(التعليمة) -> {
            طابق اخفض_تعليمة_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, &التعليمة) مع
            | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
            | اختيار.لا_شيء -> { };
        };
        ت := ت + 1;
    }
    دع المنهي: منهي_مسير;
    طابق منهي_كتلة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_منهي_مسير.موجود(م) -> { المنهي := م; }
    | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(المعرف)); };
    طابق المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        أرجع أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &الحافة);
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, الشرط) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(م) -> { اقرأ_محلي_ويب_أسمبلي(ح, م); };
        أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if
        ادفع_بنية_ويب_أسمبلي(ح, إطار_بنية_ويب_أسمبلي.شرط());
        طابق أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &عند_الصواب) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        أصدر_ويب_أسمبلي(ح, 0x05); // else
        طابق أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &عند_الخطأ) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        أزل_بنية_ويب_أسمبلي(ح);
        أصدر_ويب_أسمبلي(ح, 0x0B); // end
    }
    | منهي_مسير.فرع_متعدد(الفرع) -> {
        دع المحلي: غير_موقع;
        طابق محلي_قيمة_ويب_أسمبلي(ح, الفرع.المميز) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(المعرف) -> { المحلي := المعرف; };
        دع نوع_المميز: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الفرع.المميز) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(المعرف) -> { نوع_المميز := المعرف; };
        دع واسع: متغير منطقي = خطأ;
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_المميز) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> { واسع := الوصف.البتات == 64; }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المميز)); };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الفرع.الحالات) مثل غير_موقع)) {
            دع الحالة: &حالة_فرع_متعدد_مسير = &الفرع.الحالات[ف];
            اقرأ_محلي_ويب_أسمبلي(ح, المحلي);
            لو (واسع) {
                أصدر_ثابت64_ويب_أسمبلي(ح, (*الحالة).الوسم مثل عدد);
                أصدر_ويب_أسمبلي(ح, 0x51); // i64.eq
            } وإلا {
                أصدر_ثابت_بتات32_ويب_أسمبلي(ح, (*الحالة).الوسم);
                أصدر_ويب_أسمبلي(ح, 0x46); // i32.eq
            };
            أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if
            ادفع_بنية_ويب_أسمبلي(ح, إطار_بنية_ويب_أسمبلي.شرط());
            طابق أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &(*الحالة).الحافة) مع
            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | اختيار.لا_شيء -> { };
            أزل_بنية_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x0B); // end
            ف := ف + 1;
        }
        أرجع أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &الفرع.الافتراضي);
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        أرجع أصدر_إرجاع_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, &(*المدخلات).الخطة, القيمة);
    }
    | منهي_مسير.فخ -> { أصدر_ويب_أسمبلي(ح, 0x00); }; // unreachable
    أرجع اختيار.لا_شيء();
}

// ------------------------------------------------------------ functions --

عرف شفرة_دالة_ويب_أسمبلي(
    ح: حالة_اختيار_ويب_أسمبلي,
    الهوية: هوية_دالة_ويب_أسمبلي,
    التوقيع: غير_موقع
): دالة_ويب_أسمبلي_مشفرة {
    طابق ح مع
    | {
        المعرف: _, الشفرة: الشفرة_الأولية, الإزاحات: الإزاحات, عدد_المعاملات: _,
        المحليات: المحليات, القيم: _, حجم_الإطار: حجم_الإطار, محلي_الإطار: _,
        رقع_الإطار: رقع_الإطار, مؤقتات_ص32: _, عمق_ص32: _, مؤقتات_ص64: _, عمق_ص64: _,
        بيئة_الإغلاق: _, عنوان_الناتج: _, السياق: _, عمق_السياق: _,
        البيانات_الثابتة: البيانات_الثابتة
    } -> {
        // Patch every frame-size field with the 16-byte-aligned final size.
        دع الشفرة: متغير متجه غ8 = الشفرة_الأولية;
        دع الحجم: غير_موقع = محاذاة_لأعلى(حجم_الإطار, 16);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(رقع_الإطار) مثل غير_موقع)) {
            اكتب_سليب_مبطن_ويب_أسمبلي_عند(&متغير الشفرة, رقع_الإطار[ف], الحجم مثل عدد);
            ف := ف + 1;
        }
        دع الدالة: دالة_ويب_أسمبلي_مشفرة = {
            الهوية: الهوية,
            التوقيع: التوقيع,
            المحليات: المحليات,
            الشفرة: الشفرة,
            الإزاحات: الإزاحات,
            البيانات_الثابتة: البيانات_الثابتة
        };
        أرجع الدالة;
    };
}

عام عرف انتق_دالة_ويب_أسمبلي(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المعرف: معرف_دالة_مسير
): نتيجة دالة_ويب_أسمبلي_مشفرة, خطأ_اختيار_ويب_أسمبلي {
    دع العرض: عرض_دالة_مسير;
    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(المعرف)); }
    | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
    دع الخطة: خطة_دالة_واجهة;
    طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(المعرف)); }
    | نتيجة.نجح(خ) -> { الخطة := خ; };
    دع له_بيئة: منطقي = !دالة_دخول_ويب_أسمبلي(السياق, المعرف);
    دع التوقيع: توقيع_ويب_أسمبلي;
    طابق توقيع_خطة_ويب_أسمبلي(الحقائق, &الخطة, له_بيئة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ت) -> { التوقيع := ت; };
    دع فهرس_التوقيع: غير_موقع = ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع);
    دع البنية: بنية_تدفق_ويب_أسمبلي;
    طابق حلل_تدفق_ويب_أسمبلي(&(*المسير).المسير.الدوال[المعرف.القيمة]) مع
    | نتيجة_بنية_تدفق_ويب_أسمبلي.نجحت(ب) -> { البنية := ب; }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.تدفق_غير_قابل_للاختزال(المعرف)); };
    دع ح: متغير حالة_اختيار_ويب_أسمبلي = حالة_اختيار_ويب_أسمبلي_جديدة(
        المعرف, الطول(التوقيع.المعاملات) مثل غير_موقع
    );
    // Parameter locals: [indirect result] [environment] ABI parameters.
    دع المعامل_التالي: متغير غير_موقع = 0;
    طابق الخطة.الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        ح.عنوان_الناتج := اختيار.بعض(المعامل_التالي);
        المعامل_التالي := المعامل_التالي + 1;
    }
    | _ -> { };
    لو (له_بيئة) {
        ح.بيئة_الإغلاق := اختيار.بعض(المعامل_التالي);
        المعامل_التالي := المعامل_التالي + 1;
    };
    // Prologue: reserve the frame (size patched at the end).
    ح.محلي_الإطار := محلي_جديد_ويب_أسمبلي(&متغير ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    أصدر_مؤشر_المكدس_ويب_أسمبلي(&متغير ح, 0x23); // global.get __stack_pointer
    أصدر_حجم_الإطار_ويب_أسمبلي(&متغير ح);
    أصدر_ويب_أسمبلي(&متغير ح, 0x6B); // i32.sub
    أصدر_محلي_ويب_أسمبلي(&متغير ح, 0x22, ح.محلي_الإطار); // local.tee
    أصدر_مؤشر_المكدس_ويب_أسمبلي(&متغير ح, 0x24); // global.set __stack_pointer
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العرض.عدد_المعاملات) {
        دع القيمة: عرض_قيمة_مسير;
        طابق معامل_دالة_مسير_عند(المسير, المعرف, ف) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(المعرف)); }
        | اختيار.بعض(ق) -> { القيمة := ق; };
        دع خطة_المعامل: &خطة_معامل_واجهة = &الخطة.المعاملات[ف];
        طابق (*خطة_المعامل).الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> {
            // Zero-sized: a scalar local (zero) or an empty frame slot.
            طابق صنف_نوع_ويب_أسمبلي(الحقائق, القيمة.النوع) مع
            | صنف_قيمة_ويب_أسمبلي.تجميعي -> {
                دع المكان: غير_موقع = عنوان_إطار_جديد_ويب_أسمبلي(&متغير ح, 0, 1);
                اربط_ناتج_بمحلي_ويب_أسمبلي(&متغير ح, القيمة.المعرف, المكان, صواب);
            }
            | _ -> {
                طابق محلي_لنوع_ويب_أسمبلي(&متغير ح, الحقائق, القيمة.النوع) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(&متغير ح, القيمة.المعرف, ت); };
            };
        }
        | موقع_تمرير_واجهة.غير_مباشر(_) -> {
            طابق صنف_نوع_ويب_أسمبلي(الحقائق, القيمة.النوع) مع
            | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
                دع المحلي: غير_موقع = محلي_جديد_ويب_أسمبلي(&متغير ح, الوصف.النوع);
                اقرأ_محلي_ويب_أسمبلي(&متغير ح, المعامل_التالي);
                أصدر_تحميل_سلمي_ويب_أسمبلي(&متغير ح, &الوصف, 0);
                اكتب_محلي_ويب_أسمبلي(&متغير ح, المحلي);
                اربط_ناتج_بمحلي_ويب_أسمبلي(&متغير ح, القيمة.المعرف, المحلي, خطأ);
            }
            | _ -> { اربط_ناتج_بمحلي_ويب_أسمبلي(&متغير ح, القيمة.المعرف, المعامل_التالي, صواب); };
            المعامل_التالي := المعامل_التالي + 1;
        }
        | موقع_تمرير_واجهة.مباشر(_) -> {
            اربط_ناتج_بمحلي_ويب_أسمبلي(&متغير ح, القيمة.المعرف, المعامل_التالي, خطأ);
            المعامل_التالي := المعامل_التالي + 1;
        }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(القيمة.النوع)); };
        ف := ف + 1;
    }
    // Block parameters receive their values on incoming edges.
    ف := 0;
    بينما (ف < العرض.عدد_الكتل) {
        دع الكتلة: معرف_كتلة_مسير = معرف_كتلة_مسير_من(المعرف, ف);
        طابق ابحث_كتلة_مسير(المسير, الكتلة) مع
        | نتيجة_بحث_كتلة_مسير.موجودة(عرض_الكتلة) -> {
            دع م: متغير غير_موقع = 0;
            بينما (م < عرض_الكتلة.عدد_المعاملات) {
                طابق معامل_كتلة_مسير_عند(المسير, الكتلة, م) مع
                | اختيار.بعض(المعامل) -> {
                    طابق محلي_لنوع_ويب_أسمبلي(&متغير ح, الحقائق, المعامل.النوع) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(&متغير ح, المعامل.المعرف, ت); };
                }
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(الكتلة)); };
                م := م + 1;
            }
        }
        | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(الكتلة)); };
        ف := ف + 1;
    }
    دع المدخلات: مدخلات_بنية_ويب_أسمبلي = { البنية: البنية, الخطة: الخطة };
    دع المدخل: غير_موقع = المدخلات.البنية.المدخل;
    طابق أصدر_شجرة_ويب_أسمبلي(&متغير ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, &المدخلات, المدخل) مع
    | اختيار.بعض(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختيار.لا_شيء -> { };
    أصدر_ويب_أسمبلي(&متغير ح, 0x00); // unreachable (every path returned)
    أصدر_ويب_أسمبلي(&متغير ح, 0x0B); // end
    أرجع نتيجة.نجح(شفرة_دالة_ويب_أسمبلي(ح, هوية_دالة_ويب_أسمبلي.مسير(المعرف), فهرس_التوقيع));
}

// `_start` of a linked executable: run the language entry, then hand its
// status to the std process-exit provider (WASI proc_exit), as the LLVM
// provider's WASI start does: a wider status is truncated, a narrower one
// zero-extended, and the provider's integer operand sign-extends it.
عام عرف ابن_بدء_عملية_ويب_أسمبلي(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    الدخول: معرف_دالة_مسير,
    الخروج: معرف_دالة_مسير
): نتيجة دالة_ويب_أسمبلي_مشفرة, خطأ_اختيار_ويب_أسمبلي {
    دع خطة_الدخول: خطة_دالة_واجهة;
    طابق خطة_دالة_مسير_ويب_أسمبلي(المسير, الحقائق, الهدف, سجل_التخطيط, الدخول) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(خ) -> { خطة_الدخول := خ; };
    لو ((الطول(خطة_الدخول.المعاملات) مثل غير_موقع) != 0) { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(الدخول)); };
    دع خطة_الخروج: خطة_دالة_واجهة;
    طابق خطة_دالة_مسير_ويب_أسمبلي(المسير, الحقائق, الهدف, سجل_التخطيط, الخروج) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(خ) -> { خطة_الخروج := خ; };
    لو ((الطول(خطة_الخروج.المعاملات) مثل غير_موقع) != 1) { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_خروج_مفقود()); };
    دع وصف_الرمز: وصف_سلمي_ويب_أسمبلي;
    طابق خطة_الخروج.المعاملات[0].الموقع مع
    | موقع_تمرير_واجهة.مباشر(_) -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, خطة_الخروج.المعاملات[0].النوع) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> { وصف_الرمز := و; }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_خروج_مفقود()); };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_خروج_مفقود()); };
    لو (وصف_الرمز.عائم) { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_خروج_مفقود()); };
    دع المعاملات: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع النواتج: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع التوقيع: توقيع_ويب_أسمبلي = { المعاملات: المعاملات, النواتج: النواتج };
    دع فهرس_التوقيع: غير_موقع = ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع);
    دع ح: متغير حالة_اختيار_ويب_أسمبلي = حالة_اختيار_ويب_أسمبلي_جديدة(الدخول, 0);
    دع الحالة: غير_موقع = محلي_جديد_ويب_أسمبلي(&متغير ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    أصدر_نداء_دالة_ويب_أسمبلي(&متغير ح, مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(الدخول)));
    طابق خطة_الدخول.الناتج.الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أصدر_ثابت32_ويب_أسمبلي(&متغير ح, 0); }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, خطة_الدخول.الناتج.النوع) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> {
            لو (و.عائم) { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(الدخول)); };
            لو (و.البتات == 64) { أصدر_ويب_أسمبلي(&متغير ح, 0xA7); } // i32.wrap_i64
            وإلا لو (و.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(&متغير ح, و.البتات, خطأ); };
        }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(الدخول)); };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(الدخول)); };
    اكتب_محلي_ويب_أسمبلي(&متغير ح, الحالة);
    أصدر_ثابت32_ويب_أسمبلي(&متغير ح, 0); // the provider's closure environment
    اقرأ_محلي_ويب_أسمبلي(&متغير ح, الحالة);
    لو (وصف_الرمز.البتات == 64) { أصدر_ويب_أسمبلي(&متغير ح, 0xAC); } // i64.extend_i32_s
    وإلا لو (وصف_الرمز.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(&متغير ح, وصف_الرمز.البتات, وصف_الرمز.موقع); };
    أصدر_نداء_دالة_ويب_أسمبلي(&متغير ح, مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(الخروج)));
    أصدر_ويب_أسمبلي(&متغير ح, 0x00); // unreachable: proc_exit never returns
    أصدر_ويب_أسمبلي(&متغير ح, 0x0B); // end
    أرجع نتيجة.نجح(شفرة_دالة_ويب_أسمبلي(ح, هوية_دالة_ويب_أسمبلي.بدء_العملية(), فهرس_التوقيع));
}

// Loader initializer of a standalone object: void() calling the MSIR module
// initializer with a null closure environment.
عام عرف ابن_منشئ_وحدة_ويب_أسمبلي(
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المهيئ: معرف_دالة_مسير
): دالة_ويب_أسمبلي_مشفرة {
    دع المعاملات: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع النواتج: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع التوقيع: توقيع_ويب_أسمبلي = { المعاملات: المعاملات, النواتج: النواتج };
    دع فهرس_التوقيع: غير_موقع = ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع);
    دع ح: متغير حالة_اختيار_ويب_أسمبلي = حالة_اختيار_ويب_أسمبلي_جديدة(المهيئ, 0);
    أصدر_ثابت32_ويب_أسمبلي(&متغير ح, 0);
    أصدر_نداء_دالة_ويب_أسمبلي(&متغير ح, مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المهيئ)));
    أصدر_ويب_أسمبلي(&متغير ح, 0x0B); // end
    أرجع شفرة_دالة_ويب_أسمبلي(ح, هوية_دالة_ويب_أسمبلي.منشئ_الوحدة(), فهرس_التوقيع);
}
