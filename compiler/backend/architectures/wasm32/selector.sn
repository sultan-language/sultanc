// The native wasm32 selector: verified MSIR functions to WebAssembly function
// bodies. It plays the role the register-machine selectors, allocators and
// encoders play for x86-64/ARM64, because WebAssembly has unlimited typed
// locals and structured control instead of registers and jumps.
//
// Representation (the same split the LLVM provider makes): every MSIR value
// owns one local holding either the scalar itself (i32/i64/f32/f64) or, for
// aggregates and places, the i32 address of its storage. Integers narrower
// than 32 bits live in i32 locals normalized to their type (sign- or
// zero-extended), so comparison and division need no fix-up. Aggregate
// temporaries and local places live in a per-function frame on the shadow
// stack (`__stack_pointer`), one slot per producing instruction, exactly as
// the LLVM provider hoists one alloca per instruction into the entry block.
// Integer arithmetic traps on every failure the canonical MSIR contract names
// (overflow, division by zero, MIN/-1, shift out of range), with the same
// checks the LLVM provider emits. Calls follow the target ABI plan (portable
// SultanC ABI: scalars direct, aggregates by address, an indirect result
// first, then the hidden closure environment of every non-entry function).
// Relocatable references (functions, data, types, the stack pointer, the
// function table) are 5-byte padded fields recorded for the object writer.

عام نوع خطأ_اختيار_ويب_أسمبلي =
    | دالة_مفقودة بنوع معرف_دالة_مسير
    | كتلة_مفقودة بنوع معرف_كتلة_مسير
    | قيمة_مفقودة بنوع معرف_قيمة_مسير
    | نوع_غير_مدعوم بنوع معرف_نوع
    | تخطيط_غير_مكتمل بنوع معرف_نوع
    | واجهة_غير_متاحة بنوع معرف_دالة_مسير
    | بدائي_غير_مخفض بنوع هوية_بدائي_مترجم
    | عملية_غير_مدعومة
    | تدفق_غير_قابل_للاختزال بنوع معرف_دالة_مسير
    | مزود_ذاكرة_مفقود
    | مزود_خروج_مفقود
    | حافة_غير_صالحة
;

// Module-wide facts every function body needs.
عام نوع سياق_وحدة_ويب_أسمبلي = {
    التواقيع: سجل_تواقيع_ويب_أسمبلي,
    مزودات_الذاكرة: اختياري مزودات_تخصيص_ذاكرة_مسير,
    دالة_الدخول: اختياري معرف_دالة_مسير,
    // Position-independent code for a shared module (DynamicLinking.md):
    // data and function addresses are relative to __memory_base and
    // __table_base, or loaded from GOT entries (encoded_code.sn).
    موضع_مستقل: منطقي
};

// ---------------------------------------------------- value descriptors --

نوع وصف_سلمي_ويب_أسمبلي = {
    النوع: نوع_قيمة_ويب_أسمبلي,
    البتات: طبيعي,
    موقع: منطقي,
    عائم: منطقي
};

نوع صنف_قيمة_ويب_أسمبلي =
    | سلمي بنوع وصف_سلمي_ويب_أسمبلي
    | تجميعي
    | فراغ
    | غير_مدعوم
;

عرف سلمي_ويب_أسمبلي(النوع: نوع_قيمة_ويب_أسمبلي, البتات: طبيعي, موقع: منطقي, عائم: منطقي): صنف_قيمة_ويب_أسمبلي {
    دع الوصف: وصف_سلمي_ويب_أسمبلي = { النوع: النوع, البتات: البتات, موقع: موقع, عائم: عائم };
    أرجع صنف_قيمة_ويب_أسمبلي.سلمي(الوصف);
}

عرف صنف_نوع_ويب_أسمبلي(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    النوع: معرف_نوع
): صنف_قيمة_ويب_أسمبلي {
    طابق وصف_شكل_نوع_دلالي_عند(&(*الحقائق).الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع صنف_قيمة_ويب_أسمبلي.غير_مدعوم(); }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.فراغ -> { أرجع صنف_قيمة_ويب_أسمبلي.فراغ(); }
            | نوع_بدائي_مقنن.منطقي -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 1, خطأ, خطأ); }
            | نوع_بدائي_مقنن.ع32 -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.عائم32(), 32, خطأ, صواب); }
            | نوع_بدائي_مقنن.ع64 -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.عائم64(), 64, خطأ, صواب); }
            | نوع_بدائي_مقنن.نص -> { أرجع صنف_قيمة_ويب_أسمبلي.تجميعي(); }
            | نوع_بدائي_مقنن.أي -> { أرجع صنف_قيمة_ويب_أسمبلي.غير_مدعوم(); }
            | نوع_بدائي_مقنن.حرف -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
            | _ -> {
                دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                دع موقع: منطقي = صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عدد_موقع();
                إذا (البتات == 8 || البتات == 16 || البتات == 32) {
                    أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), البتات, موقع, خطأ);
                };
                إذا (البتات == 64) {
                    أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح64(), 64, موقع, خطأ);
                };
                أرجع صنف_قيمة_ويب_أسمبلي.غير_مدعوم();
            };
        }
        | صنف_شكل_نوع_دلالي.مؤشر -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
        | صنف_شكل_نوع_دلالي.مرجع -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
        | صنف_شكل_نوع_دلالي.صندوق -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
        | صنف_شكل_نوع_دلالي.دالة -> { أرجع سلمي_ويب_أسمبلي(نوع_قيمة_ويب_أسمبلي.صحيح32(), 32, خطأ, خطأ); }
        | صنف_شكل_نوع_دلالي.معامل_نوع -> { أرجع صنف_قيمة_ويب_أسمبلي.غير_مدعوم(); }
        | _ -> { أرجع صنف_قيمة_ويب_أسمبلي.تجميعي(); };
    };
}

// ---------------------------------------------------------------- state --

نوع تمثيل_قيمة_ويب_أسمبلي = {
    المحلي: طبيعي,
    عنوان: منطقي
};

نوع إطار_بنية_ويب_أسمبلي =
    | حلقة بنوع طبيعي
    | كتلة بنوع طبيعي
    | شرط
;

نوع حالة_اختيار_ويب_أسمبلي = {
    المعرف: معرف_دالة_مسير,
    الشفرة: متجه ط8,
    الإزاحات: متجه إزاحة_شفرة_ويب_أسمبلي,
    عدد_المعاملات: طبيعي,
    المحليات: متجه نوع_قيمة_ويب_أسمبلي,
    القيم: متجه اختياري تمثيل_قيمة_ويب_أسمبلي,
    حجم_الإطار: طبيعي,
    محلي_الإطار: طبيعي,
    رقع_الإطار: متجه طبيعي,
    مؤقتات_ص32: متجه طبيعي,
    عمق_ص32: طبيعي,
    مؤقتات_ص64: متجه طبيعي,
    عمق_ص64: طبيعي,
    بيئة_الإغلاق: اختياري طبيعي,
    عنوان_الناتج: اختياري طبيعي,
    السياق: متجه إطار_بنية_ويب_أسمبلي,
    عمق_السياق: طبيعي,
    البيانات_الثابتة: متجه بيانات_ثابتة_كائن,
    الأصول: متجه مدى_شفرة_آلة_بأصل,
    موضع_مستقل: منطقي
};

عرف حالة_اختيار_ويب_أسمبلي_جديدة(المعرف: معرف_دالة_مسير, عدد_المعاملات: طبيعي): حالة_اختيار_ويب_أسمبلي {
    دع الشفرة: متجه ط8 = [];
    دع الإزاحات: متجه إزاحة_شفرة_ويب_أسمبلي = [];
    دع المحليات: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع القيم: متجه اختياري تمثيل_قيمة_ويب_أسمبلي = [];
    دع الرقع: متجه طبيعي = [];
    دع م32: متجه طبيعي = [];
    دع م64: متجه طبيعي = [];
    دع السياق: متجه إطار_بنية_ويب_أسمبلي = [];
    دع الثابتة: متجه بيانات_ثابتة_كائن = [];
    دع الأصول: متجه مدى_شفرة_آلة_بأصل = [];
    دع الحالة: حالة_اختيار_ويب_أسمبلي = {
        المعرف: المعرف,
        الشفرة: الشفرة,
        الإزاحات: الإزاحات,
        عدد_المعاملات: عدد_المعاملات,
        المحليات: المحليات,
        القيم: القيم,
        حجم_الإطار: 0,
        محلي_الإطار: 0,
        رقع_الإطار: الرقع,
        مؤقتات_ص32: م32,
        عمق_ص32: 0,
        مؤقتات_ص64: م64,
        عمق_ص64: 0,
        بيئة_الإغلاق: اختياري.لا_شيء(),
        عنوان_الناتج: اختياري.لا_شيء(),
        السياق: السياق,
        عمق_السياق: 0,
        البيانات_الثابتة: الثابتة,
        الأصول: الأصول,
        موضع_مستقل: خطأ
    };
    أرجع الحالة;
}

// ------------------------------------------------------------- emitting --

عرف أصدر_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, البايت: طبيعي): فراغ {
    ألحق_بايت_ويب_أسمبلي(&متغير (*ح).الشفرة, البايت);
}

عرف أصدر_ليب_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, القيمة: طبيعي): فراغ {
    ألحق_ليب_ويب_أسمبلي(&متغير (*ح).الشفرة, القيمة);
}

عرف أصدر_محلي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الرمز: طبيعي, المحلي: طبيعي): فراغ {
    أصدر_ويب_أسمبلي(ح, الرمز);
    أصدر_ليب_ويب_أسمبلي(ح, المحلي);
}

عرف اقرأ_محلي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, المحلي: طبيعي): فراغ {
    أصدر_محلي_ويب_أسمبلي(ح, 0x20, المحلي); // local.get
}

عرف اكتب_محلي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, المحلي: طبيعي): فراغ {
    أصدر_محلي_ويب_أسمبلي(ح, 0x21, المحلي); // local.set
}

عرف أصدر_ثابت32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, القيمة: عدد): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x41); // i32.const
    ألحق_سليب_ويب_أسمبلي(&متغير (*ح).الشفرة, القيمة);
}

عرف أصدر_ثابت64_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, القيمة: عدد): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x42); // i64.const
    ألحق_سليب_ويب_أسمبلي(&متغير (*ح).الشفرة, القيمة);
}

عرف أصدر_ثابت_بتات32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, البتات: طبيعي): فراغ {
    أصدر_ثابت32_ويب_أسمبلي(ح, قيمة_موقعة_32_من_بتات(البتات));
}

// A relocatable 5-byte field at the current position.
عرف أصدر_إزاحة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    النوع: نوع_إزاحة_ويب_أسمبلي,
    الهدف: هدف_إزاحة_ويب_أسمبلي,
    الإضافة: عدد
): فراغ {
    دع الإزاحة: إزاحة_شفرة_ويب_أسمبلي = {
        الموضع: الطول((*ح).الشفرة) مثل طبيعي,
        النوع: النوع,
        الهدف: الهدف,
        الإضافة: الإضافة
    };
    ألحق((*ح).الإزاحات, الإزاحة);
    ألحق_ليب_مبطن_ويب_أسمبلي(&متغير (*ح).الشفرة, 0);
}

عرف انسخ_هدف_إزاحة_ويب_أسمبلي(الهدف: &هدف_إزاحة_ويب_أسمبلي): هدف_إزاحة_ويب_أسمبلي {
    طابق *الهدف مع
    | هدف_إزاحة_ويب_أسمبلي.رمز(الرمز) -> {
        أرجع هدف_إزاحة_ويب_أسمبلي.رمز(انسخ_مرجع_رمز_كائن(&الرمز));
    }
    | هدف_إزاحة_ويب_أسمبلي.مؤشر_المكدس -> { أرجع هدف_إزاحة_ويب_أسمبلي.مؤشر_المكدس(); }
    | هدف_إزاحة_ويب_أسمبلي.جدول_الدوال -> { أرجع هدف_إزاحة_ويب_أسمبلي.جدول_الدوال(); }
    | هدف_إزاحة_ويب_أسمبلي.قاعدة_الكومة -> { أرجع هدف_إزاحة_ويب_أسمبلي.قاعدة_الكومة(); }
    | هدف_إزاحة_ويب_أسمبلي.توقيع(التوقيع) -> { أرجع هدف_إزاحة_ويب_أسمبلي.توقيع(التوقيع); };
}

// Position-independent address: `global.get <base>; i32.const <offset>;
// i32.add` with both slots relocated (encoded_code.sn قاعدة_موضعية).
عرف أصدر_عنوان_موضعي_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الهدف: هدف_إزاحة_ويب_أسمبلي,
    نوع_الإزاحة: نوع_إزاحة_ويب_أسمبلي,
    الإضافة: عدد
): فراغ {
    دع هدف_القاعدة: هدف_إزاحة_ويب_أسمبلي = انسخ_هدف_إزاحة_ويب_أسمبلي(&الهدف);
    أصدر_ويب_أسمبلي(ح, 0x23); // global.get <base>
    أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.قاعدة_موضعية(), هدف_القاعدة, 0);
    أصدر_ويب_أسمبلي(ح, 0x41); // i32.const <offset>
    أصدر_إزاحة_ويب_أسمبلي(ح, نوع_الإزاحة, الهدف, الإضافة);
    أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
}

عرف أصدر_عنوان_رمز_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الهدف: هدف_إزاحة_ويب_أسمبلي,
    الإضافة: عدد
): فراغ {
    إذا ((*ح).موضع_مستقل) {
        أصدر_عنوان_موضعي_ويب_أسمبلي(ح, الهدف, نوع_إزاحة_ويب_أسمبلي.عنوان_ذاكرة_نسبي(), الإضافة);
    } وإلا {
        أصدر_ويب_أسمبلي(ح, 0x41); // i32.const <memory address>
        أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.عنوان_ذاكرة_موقع(), الهدف, الإضافة);
    };
}

عرف أصدر_فهرس_جدول_دالة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الدالة: معرف_دالة_مسير): فراغ {
    إذا ((*ح).موضع_مستقل) {
        دع رمز_الدالة: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(الدالة));
        أصدر_عنوان_موضعي_ويب_أسمبلي(
            ح, هدف_إزاحة_ويب_أسمبلي.رمز(رمز_الدالة), نوع_إزاحة_ويب_أسمبلي.فهرس_جدول_نسبي(), 0
        );
    } وإلا {
        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(الدالة));
        أصدر_ويب_أسمبلي(ح, 0x41); // i32.const <table index>
        أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.فهرس_جدول_موقع(), هدف_إزاحة_ويب_أسمبلي.رمز(الرمز), 0);
    };
}

عرف أصدر_نداء_دالة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الرمز: مرجع_رمز_كائن): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x10); // call
    أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.فهرس_دالة(), هدف_إزاحة_ويب_أسمبلي.رمز(الرمز), 0);
}

عرف أصدر_مؤشر_المكدس_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الرمز: طبيعي): فراغ {
    أصدر_ويب_أسمبلي(ح, الرمز); // global.get / global.set __stack_pointer
    أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.فهرس_عام(), هدف_إزاحة_ويب_أسمبلي.مؤشر_المكدس(), 0);
}

// Frame size is known only after the whole body; record the field to patch.
عرف أصدر_حجم_الإطار_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x41); // i32.const <frame size>
    ألحق((*ح).رقع_الإطار, الطول((*ح).الشفرة) مثل طبيعي);
    ألحق_سليب_مبطن_ويب_أسمبلي(&متغير (*ح).الشفرة, 0);
}

// The current condition (i32 on the stack) traps when nonzero.
عرف أصدر_فخ_إذا_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x04); // if
    أصدر_ويب_أسمبلي(ح, 0x40); //   (no result)
    أصدر_ويب_أسمبلي(ح, 0x00); //   unreachable
    أصدر_ويب_أسمبلي(ح, 0x0B); // end
}

عرف أصدر_نسخ_ذاكرة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    أصدر_ويب_أسمبلي(ح, 0xFC); // memory.copy 0 0
    أصدر_ليب_ويب_أسمبلي(ح, 10);
    أصدر_ويب_أسمبلي(ح, 0x00);
    أصدر_ويب_أسمبلي(ح, 0x00);
}

عرف محلي_جديد_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, النوع: نوع_قيمة_ويب_أسمبلي): طبيعي {
    دع الفهرس: طبيعي = (*ح).عدد_المعاملات + (الطول((*ح).المحليات) مثل طبيعي);
    ألحق((*ح).المحليات, النوع);
    أرجع الفهرس;
}

// LIFO scratch locals for multi-step sequences (checked arithmetic, append).
عرف خذ_مؤقت32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): طبيعي {
    إذا ((*ح).عمق_ص32 >= (الطول((*ح).مؤقتات_ص32) مثل طبيعي)) {
        دع الجديد: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
        ألحق((*ح).مؤقتات_ص32, الجديد);
    };
    دع المحلي: طبيعي = (*ح).مؤقتات_ص32[(*ح).عمق_ص32];
    (*ح).عمق_ص32 := (*ح).عمق_ص32 + 1;
    أرجع المحلي;
}

عرف أعد_مؤقت32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    (*ح).عمق_ص32 := (*ح).عمق_ص32 - 1;
}

عرف خذ_مؤقت64_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): طبيعي {
    إذا ((*ح).عمق_ص64 >= (الطول((*ح).مؤقتات_ص64) مثل طبيعي)) {
        دع الجديد: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح64());
        ألحق((*ح).مؤقتات_ص64, الجديد);
    };
    دع المحلي: طبيعي = (*ح).مؤقتات_ص64[(*ح).عمق_ص64];
    (*ح).عمق_ص64 := (*ح).عمق_ص64 + 1;
    أرجع المحلي;
}

عرف أعد_مؤقت64_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    (*ح).عمق_ص64 := (*ح).عمق_ص64 - 1;
}

عرف ضع_قيمة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, المعرف: معرف_قيمة_مسير, التمثيل: تمثيل_قيمة_ويب_أسمبلي): فراغ {
    طالما ((الطول((*ح).القيم) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) { ألحق((*ح).القيم, اختياري.لا_شيء()); }
    (*ح).القيم[المعرف.القيمة] := اختياري.موجود(التمثيل);
}

عرف قيمة_ويب_أسمبلي(ح: &حالة_اختيار_ويب_أسمبلي, المعرف: معرف_قيمة_مسير): نتيجة تمثيل_قيمة_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*ح).القيم) مثل طبيعي)) {
        أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.قيمة_مفقودة(المعرف));
    };
    طابق (*ح).القيم[المعرف.القيمة] مع
    | اختياري.موجود(التمثيل) -> { أرجع نتيجة.نجح(التمثيل); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.قيمة_مفقودة(المعرف)); };
}

عرف محلي_قيمة_ويب_أسمبلي(ح: &حالة_اختيار_ويب_أسمبلي, المعرف: معرف_قيمة_مسير): نتيجة طبيعي, خطأ_اختيار_ويب_أسمبلي {
    طابق قيمة_ويب_أسمبلي(ح, المعرف) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(التمثيل) -> { أرجع نتيجة.نجح(التمثيل.المحلي); };
}

عرف نوع_قيمة_مسير_ويب_أسمبلي(المسير: &سياق_مستهلك_مسير, المعرف: معرف_قيمة_مسير): نتيجة معرف_نوع, خطأ_اختيار_ويب_أسمبلي {
    طابق نوع_قيمة_مسير(المسير, المعرف) مع
    | اختياري.موجود(النوع) -> { أرجع نتيجة.نجح(النوع); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.قيمة_مفقودة(المعرف)); };
}

عرف تخطيط_ويب_أسمبلي(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة واصف_تخطيط, خطأ_اختيار_ويب_أسمبلي {
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(التخطيط) -> { أرجع نتيجة.نجح(التخطيط); }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.تخطيط_غير_مكتمل(النوع)); };
}

عرف جزء_تخطيط_ويب_أسمبلي(التخطيط: &واصف_تخطيط, الفهرس: طبيعي): اختياري موضع_جزء_تخطيط {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        إذا (الفهرس < (الطول(الأجزاء) مثل طبيعي)) { أرجع اختياري.موجود(الأجزاء[الفهرس]); };
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        إذا (الفهرس < (الطول(الأجزاء) مثل طبيعي)) { أرجع اختياري.موجود(الأجزاء[الفهرس]); };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

عرف إزاحة_جزء_ويب_أسمبلي(
    التخطيط: &واصف_تخطيط, الفهرس: طبيعي, النوع: معرف_نوع
): نتيجة طبيعي, خطأ_اختيار_ويب_أسمبلي {
    طابق جزء_تخطيط_ويب_أسمبلي(التخطيط, الفهرس) مع
    | اختياري.موجود(الجزء) -> { أرجع نتيجة.نجح(الجزء.الإزاحة); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

عرف تعداد_ويب_أسمبلي(التخطيط: &واصف_تخطيط): اختياري تخطيط_تعداد {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.تعداد(ت) -> { أرجع اختياري.موجود(انسخ_مملوكا_تخطيط_تعداد(&ت)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// A new local for a value of this type: the scalar or the storage address.
عرف محلي_لنوع_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    النوع: معرف_نوع
): نتيجة تمثيل_قيمة_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: محلي_جديد_ويب_أسمبلي(ح, الوصف.النوع), عنوان: خطأ };
        أرجع نتيجة.نجح(التمثيل);
    }
    | صنف_قيمة_ويب_أسمبلي.تجميعي -> {
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = {
            المحلي: محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32()), عنوان: صواب
        };
        أرجع نتيجة.نجح(التمثيل);
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

// A fresh frame slot; its address goes into a new i32 local.
عرف عنوان_إطار_جديد_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحجم: طبيعي,
    المحاذاة: طبيعي
): طبيعي {
    دع محاذاة: متغير طبيعي = المحاذاة;
    إذا (محاذاة == 0) { محاذاة := 1; };
    دع الإزاحة: طبيعي = محاذاة_لأعلى((*ح).حجم_الإطار, محاذاة);
    دع حجم: متغير طبيعي = الحجم;
    إذا (حجم == 0) { حجم := 1; };
    (*ح).حجم_الإطار := الإزاحة + حجم;
    دع المحلي: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    اقرأ_محلي_ويب_أسمبلي(ح, (*ح).محلي_الإطار);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الإزاحة);
    أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
    اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    أرجع المحلي;
}

// Pushes base + offset (i32) on the stack.
عرف أصدر_عنوان_مزاح_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الأساس: طبيعي, الإزاحة: طبيعي): فراغ {
    اقرأ_محلي_ويب_أسمبلي(ح, الأساس);
    إذا (الإزاحة != 0) {
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الإزاحة);
        أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
    };
}

// Scalar load at [address + offset] by its type (value left on the stack).
عرف أصدر_تحميل_سلمي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الوصف: &وصف_سلمي_ويب_أسمبلي, الإزاحة: طبيعي): فراغ {
    دع الحجم: طبيعي = (*الوصف).البتات / 8;
    إذا ((*الوصف).عائم) {
        إذا ((*الوصف).البتات == 32) { أصدر_ويب_أسمبلي(ح, 0x2A); } وإلا { أصدر_ويب_أسمبلي(ح, 0x2B); }; // f32.load / f64.load
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, الإزاحة);
        أرجع;
    };
    إذا ((*الوصف).البتات == 1) {
        أصدر_ويب_أسمبلي(ح, 0x2D); // i32.load8_u
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 1, الإزاحة);
        أرجع;
    };
    إذا ((*الوصف).البتات == 8) {
        إذا ((*الوصف).موقع) { أصدر_ويب_أسمبلي(ح, 0x2C); } وإلا { أصدر_ويب_أسمبلي(ح, 0x2D); }; // load8_s / load8_u
    } وإلا إذا ((*الوصف).البتات == 16) {
        إذا ((*الوصف).موقع) { أصدر_ويب_أسمبلي(ح, 0x2E); } وإلا { أصدر_ويب_أسمبلي(ح, 0x2F); }; // load16_s / load16_u
    } وإلا إذا ((*الوصف).البتات == 32) {
        أصدر_ويب_أسمبلي(ح, 0x28); // i32.load
    } وإلا {
        أصدر_ويب_أسمبلي(ح, 0x29); // i64.load
    };
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, الإزاحة);
}

// Scalar store at [address + offset]; address then value already pushed.
عرف أصدر_تخزين_سلمي_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الوصف: &وصف_سلمي_ويب_أسمبلي, الإزاحة: طبيعي): فراغ {
    دع الحجم: طبيعي = (*الوصف).البتات / 8;
    إذا ((*الوصف).عائم) {
        إذا ((*الوصف).البتات == 32) { أصدر_ويب_أسمبلي(ح, 0x38); } وإلا { أصدر_ويب_أسمبلي(ح, 0x39); }; // f32.store / f64.store
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, الإزاحة);
        أرجع;
    };
    إذا ((*الوصف).البتات == 1 || (*الوصف).البتات == 8) {
        أصدر_ويب_أسمبلي(ح, 0x3A); // i32.store8
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 1, الإزاحة);
        أرجع;
    };
    إذا ((*الوصف).البتات == 16) {
        أصدر_ويب_أسمبلي(ح, 0x3B); // i32.store16
    } وإلا إذا ((*الوصف).البتات == 32) {
        أصدر_ويب_أسمبلي(ح, 0x36); // i32.store
    } وإلا {
        أصدر_ويب_أسمبلي(ح, 0x37); // i64.store
    };
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, الإزاحة);
}

// Stores a value of type النوع at [address local + offset].
عرف خزن_قيمة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    العنوان: طبيعي,
    الإزاحة: طبيعي,
    القيمة: تمثيل_قيمة_ويب_أسمبلي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        إذا (القيمة.عنوان) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
        اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
        اقرأ_محلي_ويب_أسمبلي(ح, القيمة.المحلي);
        أصدر_تخزين_سلمي_ويب_أسمبلي(ح, &الوصف, الإزاحة);
        أرجع اختياري.لا_شيء();
    }
    | صنف_قيمة_ويب_أسمبلي.تجميعي -> {
        إذا (!القيمة.عنوان) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
        دع الحجم: طبيعي;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(التخطيط) -> { الحجم := التخطيط.الحجم; };
        إذا (الحجم == 0) { أرجع اختياري.لا_شيء(); };
        أصدر_عنوان_مزاح_ويب_أسمبلي(ح, العنوان, الإزاحة);
        اقرأ_محلي_ويب_أسمبلي(ح, القيمة.المحلي);
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الحجم);
        أصدر_نسخ_ذاكرة_ويب_أسمبلي(ح);
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

// Loads a value of type النوع from [address local + offset] into a new
// local; an aggregate is copied into a fresh frame slot (values are
// immutable while the place they came from may change).
عرف حمل_قيمة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    العنوان: طبيعي,
    الإزاحة: طبيعي
): نتيجة تمثيل_قيمة_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        دع المحلي: طبيعي = محلي_جديد_ويب_أسمبلي(ح, الوصف.النوع);
        اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
        أصدر_تحميل_سلمي_ويب_أسمبلي(ح, &الوصف, الإزاحة);
        اكتب_محلي_ويب_أسمبلي(ح, المحلي);
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المحلي, عنوان: خطأ };
        أرجع نتيجة.نجح(التمثيل);
    }
    | صنف_قيمة_ويب_أسمبلي.تجميعي -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { التخطيط := القيمة; };
        دع المكان: طبيعي = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        إذا (التخطيط.الحجم > 0) {
            اقرأ_محلي_ويب_أسمبلي(ح, المكان);
            أصدر_عنوان_مزاح_ويب_أسمبلي(ح, العنوان, الإزاحة);
            أصدر_ثابت_بتات32_ويب_أسمبلي(ح, التخطيط.الحجم);
            أصدر_نسخ_ذاكرة_ويب_أسمبلي(ح);
        };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المكان, عنوان: صواب };
        أرجع نتيجة.نجح(التمثيل);
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

// ------------------------------------------------------- integer support --

// Normalizes the i32 on the stack to an N-bit integer of the given sign.
عرف أصدر_تطبيع32_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, البتات: طبيعي, موقع: منطقي): فراغ {
    إذا (البتات >= 32) { أرجع; };
    إذا (البتات == 1) {
        أصدر_ثابت32_ويب_أسمبلي(ح, 1);
        أصدر_ويب_أسمبلي(ح, 0x71); // i32.and
        أرجع;
    };
    إذا (موقع) {
        إذا (البتات == 8) { أصدر_ويب_أسمبلي(ح, 0xC0); } وإلا { أصدر_ويب_أسمبلي(ح, 0xC1); }; // i32.extend8_s / extend16_s
        أرجع;
    };
    إذا (البتات == 8) { أصدر_ثابت32_ويب_أسمبلي(ح, 255); } وإلا { أصدر_ثابت32_ويب_أسمبلي(ح, 65535); };
    أصدر_ويب_أسمبلي(ح, 0x71); // i32.and
}

// The low N bits of a constant, as the normalized pattern of its local.
عرف نمط_ثابت_ويب_أسمبلي(الخام: طبيعي, الوصف: &وصف_سلمي_ويب_أسمبلي): طبيعي {
    إذا ((*الوصف).البتات >= 64) { أرجع الخام; };
    إذا ((*الوصف).البتات == 32) { أرجع الخام % 4294967296; };
    دع المدى: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الوصف).البتات) { المدى := المدى * 2; ف := ف + 1; }
    دع المنخفض: طبيعي = الخام % المدى;
    إذا ((*الوصف).موقع && المنخفض >= المدى / 2) {
        أرجع المنخفض + (4294967296 - المدى);
    };
    أرجع المنخفض;
}

عرف أصدر_ثابت_عدد_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الوصف: &وصف_سلمي_ويب_أسمبلي, الخام: طبيعي): فراغ {
    دع النمط: طبيعي = نمط_ثابت_ويب_أسمبلي(الخام, الوصف);
    إذا ((*الوصف).البتات == 64) {
        أصدر_ثابت64_ويب_أسمبلي(ح, النمط مثل عدد);
    } وإلا {
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, النمط);
    };
}

عرف أصدر_ثابت_بعرض_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, واسع: منطقي, القيمة: عدد): فراغ {
    إذا (واسع) { أصدر_ثابت64_ويب_أسمبلي(ح, القيمة); } وإلا { أصدر_ثابت32_ويب_أسمبلي(ح, القيمة); };
}

عرف أصدر_عملية_بعرض_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, واسع: منطقي, رمز32: طبيعي, رمز64: طبيعي): فراغ {
    إذا (واسع) { أصدر_ويب_أسمبلي(ح, رمز64); } وإلا { أصدر_ويب_أسمبلي(ح, رمز32); };
}

// Narrow (8/16-bit) result range check on local الناتج.
عرف أصدر_فحص_نطاق_ضيق_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الناتج: طبيعي, البتات: طبيعي, موقع: منطقي): فراغ {
    اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
    إذا (موقع) {
        اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
        أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, صواب);
        أصدر_ويب_أسمبلي(ح, 0x47); // i32.ne
    } وإلا {
        إذا (البتات == 8) { أصدر_ثابت32_ويب_أسمبلي(ح, 255); } وإلا { أصدر_ثابت32_ويب_أسمبلي(ح, 65535); };
        أصدر_ويب_أسمبلي(ح, 0x4B); // i32.gt_u
    };
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
}

عرف أدنى_موقع_ويب_أسمبلي(البتات: طبيعي): عدد {
    إذا (البتات == 64) { أرجع -9223372036854775807 - 1; };
    دع القيمة: متغير عدد = 1;
    دع ف: متغير طبيعي = 1;
    طالما (ف < البتات) { القيمة := القيمة * 2; ف := ف + 1; }
    أرجع 0 - القيمة;
}

عرف أصدر_حساب_صحيح_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الحساب: &حساب_صحيح_مسير,
    الناتج: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع أ: طبيعي; دع ب: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { أ := م; };
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحساب).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { ب := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    دع الوصف: وصف_سلمي_ويب_أسمبلي;
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> { الوصف := و; }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    إذا (الوصف.عائم) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    دع واسع: منطقي = الوصف.البتات == 64;
    دع ضيق: منطقي = الوصف.البتات < 32;
    دع البتات: طبيعي = الوصف.البتات;
    دع موقع: منطقي = الوصف.موقع;
    // Wrapping forms: WebAssembly's own modular instructions, then the
    // canonical extension of a narrow result.
    دع رمز_ملتف32: متغير طبيعي = 0;
    دع رمز_ملتف64: متغير طبيعي = 0;
    طابق (*الحساب).العملية مع
    | عملية_حساب_صحيح.جمع_ملتف -> { رمز_ملتف32 := 0x6A; رمز_ملتف64 := 0x7C; }
    | عملية_حساب_صحيح.طرح_ملتف -> { رمز_ملتف32 := 0x6B; رمز_ملتف64 := 0x7D; }
    | عملية_حساب_صحيح.ضرب_ملتف -> { رمز_ملتف32 := 0x6C; رمز_ملتف64 := 0x7E; }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { رمز_ملتف32 := 0x74; رمز_ملتف64 := 0x86; }
    | _ -> { };
    إذا (رمز_ملتف32 != 0) {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, رمز_ملتف32, رمز_ملتف64);
        إذا (ضيق) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, موقع); };
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        أرجع اختياري.لا_شيء();
    };
    طابق (*الحساب).العملية مع
    | عملية_حساب_صحيح.جمع -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6A, 0x7C); // add
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        إذا (ضيق) { أصدر_فحص_نطاق_ضيق_ويب_أسمبلي(ح, الناتج, البتات, موقع); أرجع اختياري.لا_شيء(); };
        إذا (موقع) {
            // ((a ^ r) & (b ^ r)) < 0
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85); // xor
            اقرأ_محلي_ويب_أسمبلي(ح, ب); اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x71, 0x83); // and
            أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, 0);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x48, 0x53); // lt_s
        } وإلا {
            اقرأ_محلي_ويب_أسمبلي(ح, الناتج); اقرأ_محلي_ويب_أسمبلي(ح, أ);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x49, 0x54); // lt_u
        };
        أصدر_فخ_إذا_ويب_أسمبلي(ح);
    }
    | عملية_حساب_صحيح.طرح -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6B, 0x7D); // sub
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        إذا (ضيق) { أصدر_فحص_نطاق_ضيق_ويب_أسمبلي(ح, الناتج, البتات, موقع); أرجع اختياري.لا_شيء(); };
        إذا (موقع) {
            // ((a ^ b) & (a ^ r)) < 0
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85);
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x71, 0x83);
            أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, 0);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x48, 0x53);
        } وإلا {
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x49, 0x54);
        };
        أصدر_فخ_إذا_ويب_أسمبلي(ح);
    }
    | عملية_حساب_صحيح.ضرب -> {
        إذا (ضيق) {
            اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
            أصدر_ويب_أسمبلي(ح, 0x6C); // i32.mul
            اكتب_محلي_ويب_أسمبلي(ح, الناتج);
            أصدر_فحص_نطاق_ضيق_ويب_أسمبلي(ح, الناتج, البتات, موقع);
            أرجع اختياري.لا_شيء();
        };
        إذا (!واسع) {
            // 32-bit: the exact product in i64, then a range check.
            دع ت: طبيعي = خذ_مؤقت64_ويب_أسمبلي(ح);
            اقرأ_محلي_ويب_أسمبلي(ح, أ);
            إذا (موقع) { أصدر_ويب_أسمبلي(ح, 0xAC); } وإلا { أصدر_ويب_أسمبلي(ح, 0xAD); }; // i64.extend_i32_s/u
            اقرأ_محلي_ويب_أسمبلي(ح, ب);
            إذا (موقع) { أصدر_ويب_أسمبلي(ح, 0xAC); } وإلا { أصدر_ويب_أسمبلي(ح, 0xAD); };
            أصدر_ويب_أسمبلي(ح, 0x7E); // i64.mul
            أصدر_محلي_ويب_أسمبلي(ح, 0x22, ت); // local.tee
            أصدر_ويب_أسمبلي(ح, 0xA7); // i32.wrap_i64
            اكتب_محلي_ويب_أسمبلي(ح, الناتج);
            اقرأ_محلي_ويب_أسمبلي(ح, ت);
            إذا (موقع) {
                اقرأ_محلي_ويب_أسمبلي(ح, الناتج);
                أصدر_ويب_أسمبلي(ح, 0xAC);
                أصدر_ويب_أسمبلي(ح, 0x52); // i64.ne
            } وإلا {
                أصدر_ثابت64_ويب_أسمبلي(ح, 4294967295);
                أصدر_ويب_أسمبلي(ح, 0x56); // i64.gt_u
            };
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            أعد_مؤقت64_ويب_أسمبلي(ح);
            أرجع اختياري.لا_شيء();
        };
        // 64-bit: no double-width multiply. The wrapped product r is exact iff
        // a == 0 or r / a == b, with a == -1 handled separately when signed
        // (MIN / -1 traps); the same expansion the LLVM provider uses.
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_ويب_أسمبلي(ح, 0x7E); // i64.mul
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        إذا (موقع) {
            اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ثابت64_ويب_أسمبلي(ح, -1); أصدر_ويب_أسمبلي(ح, 0x51); // i64.eq
            أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if
            اقرأ_محلي_ويب_أسمبلي(ح, ب); أصدر_ثابت64_ويب_أسمبلي(ح, أدنى_موقع_ويب_أسمبلي(64)); أصدر_ويب_أسمبلي(ح, 0x51);
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x05); // else
            اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ويب_أسمبلي(ح, 0x50); أصدر_ويب_أسمبلي(ح, 0x45); // i64.eqz; i32.eqz
            أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if (a != 0)
            اقرأ_محلي_ويب_أسمبلي(ح, الناتج); اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ويب_أسمبلي(ح, 0x7F); // i64.div_s
            اقرأ_محلي_ويب_أسمبلي(ح, ب); أصدر_ويب_أسمبلي(ح, 0x52); // i64.ne
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x0B); // end
            أصدر_ويب_أسمبلي(ح, 0x0B); // end
        } وإلا {
            اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ويب_أسمبلي(ح, 0x50); أصدر_ويب_أسمبلي(ح, 0x45);
            أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if (a != 0)
            اقرأ_محلي_ويب_أسمبلي(ح, الناتج); اقرأ_محلي_ويب_أسمبلي(ح, أ); أصدر_ويب_أسمبلي(ح, 0x80); // i64.div_u
            اقرأ_محلي_ويب_أسمبلي(ح, ب); أصدر_ويب_أسمبلي(ح, 0x52);
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x0B);
        };
    }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع أصدر_قسمة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, صواب, خطأ); }
    | عملية_حساب_صحيح.قسمة_طبيعية -> { أرجع أصدر_قسمة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, خطأ, خطأ); }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع أصدر_قسمة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, صواب, صواب); }
    | عملية_حساب_صحيح.باقي_طبيعي -> { أرجع أصدر_قسمة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, خطأ, صواب); }
    | عملية_حساب_صحيح.أو_بتي -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x72, 0x84); // or
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    }
    | عملية_حساب_صحيح.أو_حصري -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x73, 0x85); // xor
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    }
    | عملية_حساب_صحيح.و_بتي -> {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x71, 0x83); // and
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع أصدر_إزاحة_صحيحة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, 0); }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع أصدر_إزاحة_صحيحة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, 1); }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع أصدر_إزاحة_صحيحة_ويب_أسمبلي(ح, أ, ب, الناتج, &الوصف, 2); }
    // The wrapping forms returned above.
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

عرف أصدر_قسمة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    أ: طبيعي, ب: طبيعي, الناتج: طبيعي,
    الوصف: &وصف_سلمي_ويب_أسمبلي,
    موقع: منطقي, باقي: منطقي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع واسع: منطقي = (*الوصف).البتات == 64;
    اقرأ_محلي_ويب_أسمبلي(ح, ب);
    أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x45, 0x50); // eqz
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    إذا (موقع) {
        اقرأ_محلي_ويب_أسمبلي(ح, أ);
        أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, أدنى_موقع_ويب_أسمبلي((*الوصف).البتات));
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x46, 0x51); // eq
        اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, -1);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x46, 0x51);
        أصدر_ويب_أسمبلي(ح, 0x71); // i32.and
        أصدر_فخ_إذا_ويب_أسمبلي(ح);
    };
    اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
    إذا (باقي) {
        إذا (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6F, 0x81); } // rem_s
        وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x70, 0x82); }; // rem_u
    } وإلا {
        إذا (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6D, 0x7F); } // div_s
        وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x6E, 0x80); }; // div_u
    };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختياري.لا_شيء();
}

// العملية: 0 left (lossless), 1 logical right, 2 arithmetic right.
عرف أصدر_إزاحة_صحيحة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    أ: طبيعي, ب: طبيعي, الناتج: طبيعي,
    الوصف: &وصف_سلمي_ويب_أسمبلي,
    العملية: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع واسع: منطقي = (*الوصف).البتات == 64;
    دع البتات: طبيعي = (*الوصف).البتات;
    دع موقع: منطقي = (*الوصف).موقع;
    دع ضيق: منطقي = البتات < 32;
    // The shift count must be below the operand width (unsigned compare).
    اقرأ_محلي_ويب_أسمبلي(ح, ب);
    أصدر_ثابت_بعرض_ويب_أسمبلي(ح, واسع, البتات مثل عدد);
    أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4F, 0x5A); // ge_u
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    إذا (العملية == 0) {
        اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x74, 0x86); // shl
        إذا (ضيق) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, موقع); };
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        // Shifting back must recover the operand, or bits were lost.
        اقرأ_محلي_ويب_أسمبلي(ح, الناتج); اقرأ_محلي_ويب_أسمبلي(ح, ب);
        إذا (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x75, 0x87); } // shr_s
        وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x76, 0x88); }; // shr_u
        اقرأ_محلي_ويب_أسمبلي(ح, أ);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x47, 0x52); // ne
        أصدر_فخ_إذا_ويب_أسمبلي(ح);
        أرجع اختياري.لا_شيء();
    };
    إذا (العملية == 1) {
        اقرأ_محلي_ويب_أسمبلي(ح, أ);
        إذا (ضيق && موقع) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, خطأ); };
        اقرأ_محلي_ويب_أسمبلي(ح, ب);
        أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x76, 0x88); // shr_u
        إذا (ضيق && موقع) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, صواب); };
        اكتب_محلي_ويب_أسمبلي(ح, الناتج);
        أرجع اختياري.لا_شيء();
    };
    اقرأ_محلي_ويب_أسمبلي(ح, أ);
    إذا (ضيق && !موقع) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, صواب); };
    اقرأ_محلي_ويب_أسمبلي(ح, ب);
    أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x75, 0x87); // shr_s
    إذا (ضيق && !موقع) { أصدر_تطبيع32_ويب_أسمبلي(ح, البتات, خطأ); };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختياري.لا_شيء();
}

عرف أصدر_مقارنة_صحيحة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    المقارنة: &مقارنة_صحيح_مسير,
    الناتج: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع أ: طبيعي; دع ب: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*المقارنة).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { أ := م; };
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*المقارنة).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { ب := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*المقارنة).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    دع الوصف: وصف_سلمي_ويب_أسمبلي;
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> { الوصف := و; }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    دع واسع: منطقي = الوصف.البتات == 64;
    دع موقع: منطقي = الوصف.موقع;
    اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
    طابق (*المقارنة).العملية مع
    | عملية_مقارنة_صحيح.يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x46, 0x51); }
    | عملية_مقارنة_صحيح.لا_يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x47, 0x52); }
    | عملية_مقارنة_صحيح.أصغر -> {
        إذا (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x48, 0x53); } وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x49, 0x54); };
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        إذا (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4A, 0x55); } وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4B, 0x56); };
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        إذا (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4C, 0x57); } وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4D, 0x58); };
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        إذا (موقع) { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4E, 0x59); } وإلا { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x4F, 0x5A); };
    };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختياري.لا_شيء();
}

عرف أصدر_حساب_عشري_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الحساب: &حساب_عشري_مسير,
    الناتج: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع أ: طبيعي; دع ب: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { أ := م; };
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحساب).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { ب := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    دع واسع: متغير منطقي = خطأ;
    طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, النوع) مع
    | اختياري.موجود(البتات) -> { واسع := البتات == 64; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
    طابق (*الحساب).العملية مع
    | عملية_حساب_عشري.جمع -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x92, 0xA0); }
    | عملية_حساب_عشري.طرح -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x93, 0xA1); }
    | عملية_حساب_عشري.ضرب -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x94, 0xA2); }
    | عملية_حساب_عشري.قسمة -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x95, 0xA3); };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختياري.لا_شيء();
}

عرف أصدر_مقارنة_عشرية_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    المقارنة: &مقارنة_عشري_مسير,
    الناتج: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع أ: طبيعي; دع ب: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*المقارنة).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { أ := م; };
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*المقارنة).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { ب := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*المقارنة).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    دع واسع: متغير منطقي = خطأ;
    طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, النوع) مع
    | اختياري.موجود(البتات) -> { واسع := البتات == 64; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    اقرأ_محلي_ويب_أسمبلي(ح, أ); اقرأ_محلي_ويب_أسمبلي(ح, ب);
    طابق (*المقارنة).العملية مع
    | عملية_مقارنة_عشري.يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5B, 0x61); }
    | عملية_مقارنة_عشري.لا_يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5C, 0x62); }
    | عملية_مقارنة_عشري.أصغر -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5D, 0x63); }
    | عملية_مقارنة_عشري.أكبر -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5E, 0x64); }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x5F, 0x65); }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x60, 0x66); };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختياري.لا_شيء();
}

// Integer conversion with LLVM's sext/zext/trunc/bitcast meaning on the
// N-bit values, re-normalized for the destination type.
// The float bits of a small non-negative integer (|v| < 2^24, exact).
عرف بتات_عدد_صغير_عائم_ويب_أسمبلي(القيمة: طبيعي, سالب: منطقي, البتات: طبيعي): طبيعي {
    إذا (القيمة == 0) { أرجع 0; };
    دع الأس: متغير طبيعي = 0;
    طالما ((القيمة >> (الأس + 1)) != 0) { الأس := الأس + 1; }
    دع الكسر: طبيعي = القيمة - ((1 مثل طبيعي) << الأس);
    دع واحد: طبيعي = 1;
    إذا (البتات == 32) {
        دع الناتج: طبيعي = ((127 + الأس) << 23) | (الكسر << (23 - الأس));
        إذا (سالب) { أرجع الناتج | (واحد << 31); };
        أرجع الناتج;
    };
    دع الناتج: طبيعي = ((1023 + الأس) << 52) | (الكسر << (52 - الأس));
    إذا (سالب) { أرجع الناتج | (واحد << 63); };
    أرجع الناتج;
}

عرف أصدر_ثابت_عائم_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, البتات_الخام: طبيعي, البتات: طبيعي): فراغ {
    إذا (البتات == 32) {
        أصدر_ويب_أسمبلي(ح, 0x43); // f32.const
        ألحق_قيمة_صغيرة_الطرف_ويب_أسمبلي(&متغير (*ح).الشفرة, البتات_الخام, 4);
    } وإلا {
        أصدر_ويب_أسمبلي(ح, 0x44); // f64.const
        ألحق_قيمة_صغيرة_الطرف_ويب_أسمبلي(&متغير (*ح).الشفرة, البتات_الخام, 8);
    };
}

// Float conversions (docs/en/reference/type-system.md, "Numeric casts"): the non-trapping
// saturating truncations (iNN.trunc_sat_fMM_*, NaN -> 0) are Rust's `as`;
// 8- and 16-bit results are clamped with fMM.min/max first (a NaN stays one).
عرف أصدر_تحويل_عائم_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    التحويل: &تحويل_عائم_مسير,
    نوع_الناتج: معرف_نوع,
    الناتج: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع المصدر: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*التحويل).المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المصدر := م; };
    دع نوع_المصدر: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*التحويل).المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
    دع م: وصف_سلمي_ويب_أسمبلي;
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_المصدر) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> { م := و; }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر)); };
    دع و: وصف_سلمي_ويب_أسمبلي;
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_الناتج) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(د) -> { و := د; }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
    اقرأ_محلي_ويب_أسمبلي(ح, المصدر);
    طابق (*التحويل).العملية مع
    | عملية_تحويل_عائم.عائم_إلى_عائم -> {
        إذا (م.البتات == 32 && و.البتات == 64) { أصدر_ويب_أسمبلي(ح, 0xBB); }; // f64.promote_f32
        إذا (م.البتات == 64 && و.البتات == 32) { أصدر_ويب_أسمبلي(ح, 0xB6); }; // f32.demote_f64
    }
    | عملية_تحويل_عائم.موقع_إلى_عائم -> {
        // Narrow signed integers are kept sign-extended in their i32 local.
        دع الرمز: متغير طبيعي = 0xB2; // f32.convert_i32_s
        إذا (م.البتات == 64) { الرمز := الرمز + 2; };
        إذا (و.البتات == 64) { الرمز := الرمز + 5; };
        أصدر_ويب_أسمبلي(ح, الرمز);
    }
    | عملية_تحويل_عائم.طبيعي_إلى_عائم -> {
        دع الرمز: متغير طبيعي = 0xB3; // f32.convert_i32_u
        إذا (م.البتات == 64) { الرمز := الرمز + 2; };
        إذا (و.البتات == 64) { الرمز := الرمز + 5; };
        أصدر_ويب_أسمبلي(ح, الرمز);
    }
    | _ -> {
        دع موقع: متغير منطقي = خطأ;
        طابق (*التحويل).العملية مع | عملية_تحويل_عائم.عائم_إلى_موقع -> { موقع := صواب; } | _ -> { };
        دع واسع: منطقي = م.البتات == 64;
        إذا (و.البتات < 32) {
            دع الأقصى: متغير طبيعي = ((1 مثل طبيعي) << و.البتات) - 1;
            إذا (موقع) { الأقصى := ((1 مثل طبيعي) << (و.البتات - 1)) - 1; };
            أصدر_ثابت_عائم_ويب_أسمبلي(ح, بتات_عدد_صغير_عائم_ويب_أسمبلي(الأقصى, خطأ, م.البتات), م.البتات);
            أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x96, 0xA4); // fNN.min
            إذا (موقع) {
                أصدر_ثابت_عائم_ويب_أسمبلي(ح, بتات_عدد_صغير_عائم_ويب_أسمبلي(الأقصى + 1, صواب, م.البتات), م.البتات);
                أصدر_عملية_بعرض_ويب_أسمبلي(ح, واسع, 0x97, 0xA5); // fNN.max
            };
        };
        دع الرمز: متغير طبيعي = 0; // i32.trunc_sat_f32_s
        إذا (!موقع) { الرمز := الرمز + 1; };
        إذا (واسع) { الرمز := الرمز + 2; };
        إذا (و.البتات == 64) { الرمز := الرمز + 4; };
        أصدر_ويب_أسمبلي(ح, 0xFC); أصدر_ليب_ويب_أسمبلي(ح, الرمز);
        إذا (و.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(ح, و.البتات, و.موقع); };
    };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختياري.لا_شيء();
}

عرف أصدر_تحويل_صحيح_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    التحويل: &تحويل_صحيح_مسير,
    نوع_الناتج: معرف_نوع,
    الناتج: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع المصدر: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*التحويل).المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المصدر := م; };
    دع نوع_المصدر: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, (*التحويل).المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
    دع م: وصف_تحويل_صحيح_خلفية;
    طابق وصف_نوع_لتحويل_صحيح_للاختيار(&(*الحقائق).الأنواع, نوع_المصدر) مع
    | اختياري.موجود(و) -> { م := و; }
    | اختياري.لا_شيء -> {
        // Pointer-shaped operands are 32-bit unsigned words.
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_المصدر) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(ووصف) -> {
            إذا (ووصف.عائم) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر)); };
            دع بديل: وصف_تحويل_صحيح_خلفية = { البتات: ووصف.البتات, موقع: ووصف.موقع };
            م := بديل;
        }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر)); };
    };
    دع و: وصف_تحويل_صحيح_خلفية;
    طابق وصف_نوع_لتحويل_صحيح_للاختيار(&(*الحقائق).الأنواع, نوع_الناتج) مع
    | اختياري.موجود(د) -> { و := د; }
    | اختياري.لا_شيء -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_الناتج) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(ووصف) -> {
            إذا (ووصف.عائم) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
            دع بديل: وصف_تحويل_صحيح_خلفية = { البتات: ووصف.البتات, موقع: ووصف.موقع };
            و := بديل;
        }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
    };
    دع مصدر_واسع: منطقي = م.البتات == 64;
    دع وجهة_واسعة: منطقي = و.البتات == 64;
    اقرأ_محلي_ويب_أسمبلي(ح, المصدر);
    طابق (*التحويل).العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> {
        إذا (!مصدر_واسع && !م.موقع && م.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(ح, م.البتات, صواب); };
        إذا (!مصدر_واسع && وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xAC); }; // i64.extend_i32_s
        إذا (مصدر_واسع && !وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xA7); }; // i32.wrap_i64
    }
    | عملية_تحويل_صحيح.توسيع_صفري -> {
        إذا (!مصدر_واسع && م.موقع && م.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(ح, م.البتات, خطأ); };
        إذا (!مصدر_واسع && وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xAD); }; // i64.extend_i32_u
        إذا (مصدر_واسع && !وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xA7); };
    }
    | عملية_تحويل_صحيح.اقتطاع -> {
        إذا (مصدر_واسع && !وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xA7); };
        إذا (!مصدر_واسع && وجهة_واسعة) { أصدر_ويب_أسمبلي(ح, 0xAD); };
    }
    | عملية_تحويل_صحيح.إعادة_تفسير -> {
        إذا (مصدر_واسع != وجهة_واسعة) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
    };
    إذا (!وجهة_واسعة) { أصدر_تطبيع32_ويب_أسمبلي(ح, و.البتات, و.موقع); };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع اختياري.لا_شيء();
}

// --------------------------------------------------------- ABI support --

عرف نوع_معامل_خطة_ويب_أسمبلي(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الخطة: &خطة_معامل_واجهة
): نتيجة اختياري نوع_قيمة_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { أرجع نتيجة.نجح(اختياري.موجود(نوع_قيمة_ويب_أسمبلي.صحيح32())); }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, (*الخطة).النوع) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> { أرجع نتيجة.نجح(اختياري.موجود(الوصف.النوع)); }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).النوع)); };
    }
    | موقع_تمرير_واجهة.مجزأ(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).النوع)); };
}

// The wasm signature of a call/function under its ABI plan.
عام عرف توقيع_خطة_ويب_أسمبلي(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الخطة: &خطة_دالة_واجهة,
    له_بيئة: منطقي
): نتيجة توقيع_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    دع المعاملات: متغير متجه نوع_قيمة_ويب_أسمبلي = [];
    دع النواتج: متغير متجه نوع_قيمة_ويب_أسمبلي = [];
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { ألحق(المعاملات, نوع_قيمة_ويب_أسمبلي.صحيح32()); }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, (*الخطة).الناتج.النوع) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> { ألحق(النواتج, الوصف.النوع); }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).الناتج.النوع)); };
    }
    | موقع_تمرير_واجهة.متجاهل -> { }
    | موقع_تمرير_واجهة.مجزأ(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).الناتج.النوع)); };
    إذا (له_بيئة) { ألحق(المعاملات, نوع_قيمة_ويب_أسمبلي.صحيح32()); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الخطة).المعاملات) مثل طبيعي)) {
        طابق نوع_معامل_خطة_ويب_أسمبلي(الحقائق, &(*الخطة).المعاملات[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النوع_الاختياري) -> {
            طابق النوع_الاختياري مع
            | اختياري.موجود(النوع) -> { ألحق(المعاملات, النوع); }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    دع التوقيع: توقيع_ويب_أسمبلي = { المعاملات: المعاملات, النواتج: النواتج };
    أرجع نتيجة.نجح(التوقيع);
}

// The canonical ABI plan of an MSIR function definition.
عام عرف خطة_دالة_مسير_ويب_أسمبلي(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_دالة_مسير
): نتيجة خطة_دالة_واجهة, خطأ_اختيار_ويب_أسمبلي {
    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(المعرف)); }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(المعرف)); }
        | نتيجة.نجح(الخطة) -> { أرجع نتيجة.نجح(الخطة); };
    };
}

عام عرف دالة_دخول_ويب_أسمبلي(السياق: &سياق_وحدة_ويب_أسمبلي, المعرف: معرف_دالة_مسير): منطقي {
    طابق (*السياق).دالة_الدخول مع
    | اختياري.موجود(الدخول) -> { أرجع الدخول.القيمة == المعرف.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The type-table index of an MSIR function definition's own signature.
عام عرف توقيع_دالة_مسير_ويب_أسمبلي(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المعرف: معرف_دالة_مسير
): نتيجة طبيعي, خطأ_اختيار_ويب_أسمبلي {
    دع الخطة: خطة_دالة_واجهة;
    طابق خطة_دالة_مسير_ويب_أسمبلي(المسير, الحقائق, الهدف, سجل_التخطيط, المعرف) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(خ) -> { الخطة := خ; };
    دع له_بيئة: منطقي = !دالة_دخول_ويب_أسمبلي(السياق, المعرف);
    طابق توقيع_خطة_ويب_أسمبلي(الحقائق, &الخطة, له_بيئة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(التوقيع) -> { أرجع نتيجة.نجح(ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع)); };
}

// Pushes one call argument under its parameter plan.
عرف ادفع_حجة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_معامل_واجهة,
    المعرف: معرف_قيمة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع اختياري.لا_شيء(); }
    | _ -> { };
    دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
    طابق قيمة_ويب_أسمبلي(ح, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        إذا (التمثيل.عنوان) {
            اقرأ_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
            أرجع اختياري.لا_شيء();
        };
        // A scalar passed by address is spilled to a frame slot first.
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: طبيعي = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, المكان, 0, التمثيل) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        اقرأ_محلي_ويب_أسمبلي(ح, المكان);
    }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        إذا (التمثيل.عنوان) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).النوع)); };
        اقرأ_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).النوع)); };
    أرجع اختياري.لا_شيء();
}

// The callee shapes of one MSIR call.
نوع مستدعى_ويب_أسمبلي =
    | مباشر بنوع مرجع_رمز_كائن
    | غير_مباشر بنوع (طبيعي, طبيعي)
;

// One call under its ABI plan: [indirect result] [environment] arguments.
عرف أصدر_نداء_بخطة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    الخطة: &خطة_دالة_واجهة,
    البيئة: اختياري طبيعي,
    المستدعى: مستدعى_ويب_أسمبلي,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    إذا ((الطول(*الحجج) مثل طبيعي) != (الطول((*الخطة).المعاملات) مثل طبيعي)) {
        أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة());
    };
    دع مكان_الناتج: متغير اختياري طبيعي = اختياري.لا_شيء();
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: طبيعي = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        مكان_الناتج := اختياري.موجود(المكان);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان);
    }
    | _ -> { };
    طابق البيئة مع
    | اختياري.موجود(المحلي) -> { اقرأ_محلي_ويب_أسمبلي(ح, المحلي); }
    | اختياري.لا_شيء -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحجج) مثل طبيعي)) {
        طابق ادفع_حجة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, &(*الخطة).المعاملات[ف], (*الحجج)[ف]) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق المستدعى مع
    | مستدعى_ويب_أسمبلي.مباشر(الرمز) -> { أصدر_نداء_دالة_ويب_أسمبلي(ح, الرمز); }
    | مستدعى_ويب_أسمبلي.غير_مباشر(الإغلاق, التوقيع) -> {
        // Word zero of a closure environment is the function-table index.
        اقرأ_محلي_ويب_أسمبلي(ح, الإغلاق);
        أصدر_ويب_أسمبلي(ح, 0x28); // i32.load
        ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0);
        أصدر_ويب_أسمبلي(ح, 0x11); // call_indirect type table
        أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.فهرس_نوع(), هدف_إزاحة_ويب_أسمبلي.توقيع(التوقيع), 0);
        أصدر_إزاحة_ويب_أسمبلي(ح, نوع_إزاحة_ويب_أسمبلي.رقم_جدول(), هدف_إزاحة_ويب_أسمبلي.جدول_الدوال(), 0);
    };
    طابق الناتج مع
    | اختياري.لا_شيء -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.مباشر(_) -> { أصدر_ويب_أسمبلي(ح, 0x1A); } // drop
        | _ -> { };
    }
    | اختياري.موجود(المعرف) -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | موقع_تمرير_واجهة.غير_مباشر(_) -> {
            طابق مكان_الناتج مع
            | اختياري.موجود(المكان) -> {
                دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المكان, عنوان: صواب };
                ضع_قيمة_ويب_أسمبلي(ح, المعرف, التمثيل);
            }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        }
        | موقع_تمرير_واجهة.مباشر(_) -> {
            دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
            طابق محلي_لنوع_ويب_أسمبلي(ح, الحقائق, (*الخطة).الناتج.النوع) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(ت) -> { التمثيل := ت; };
            اكتب_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
            ضع_قيمة_ويب_أسمبلي(ح, المعرف, التمثيل);
        }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
    };
    أرجع اختياري.لا_شيء();
}

// Calls a std allocation provider: (environment 0, operands...) -> address.
// A null allocation traps before any store through it.
عرف أصدر_نداء_مزود_ذاكرة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المزود: معرف_دالة_مسير,
    له_ناتج: منطقي
): اختياري طبيعي {
    أصدر_نداء_دالة_ويب_أسمبلي(ح, مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المزود)));
    إذا (!له_ناتج) { أرجع اختياري.لا_شيء(); };
    دع المحلي: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    أصدر_محلي_ويب_أسمبلي(ح, 0x22, المحلي); // local.tee
    أصدر_ويب_أسمبلي(ح, 0x45); // i32.eqz
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    أرجع اختياري.موجود(المحلي);
}

عرف أصدر_تخصيص_ثابت_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    السياق: &سياق_وحدة_ويب_أسمبلي,
    الحجم: طبيعي
): نتيجة طبيعي, خطأ_اختيار_ويب_أسمبلي {
    طابق (*السياق).مزودات_الذاكرة مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); }
    | اختياري.موجود(المزودات) -> {
        أصدر_ثابت32_ويب_أسمبلي(ح, 0);
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الحجم);
        طابق أصدر_نداء_مزود_ذاكرة_ويب_أسمبلي(ح, المزودات.التخصيص, صواب) مع
        | اختياري.موجود(المحلي) -> { أرجع نتيجة.نجح(المحلي); }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); };
    };
}

// ------------------------------------------------------ instructions --

نوع حقول_تسلسل_ويب_أسمبلي = { البيانات: طبيعي, الطول: طبيعي, السعة: طبيعي };

عرف حقول_تسلسل_ويب_أسمبلي_من(التخطيط: &واصف_تخطيط, النوع: معرف_نوع): نتيجة حقول_تسلسل_ويب_أسمبلي, خطأ_اختيار_ويب_أسمبلي {
    دع البيانات: طبيعي; دع طول_: طبيعي; دع السعة: طبيعي;
    طابق إزاحة_جزء_ويب_أسمبلي(التخطيط, 0, النوع) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { البيانات := ق; };
    طابق إزاحة_جزء_ويب_أسمبلي(التخطيط, 1, النوع) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { طول_ := ق; };
    طابق إزاحة_جزء_ويب_أسمبلي(التخطيط, 2, النوع) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { السعة := ق; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي = { البيانات: البيانات, الطول: طول_, السعة: السعة };
    أرجع نتيجة.نجح(الحقول);
}

عرف نوع_عنصر_تسلسل_ويب_أسمبلي(الحقائق: &سياق_استعلام_اختيار_خلفية, النوع: معرف_نوع): اختياري معرف_نوع {
    طابق نوع_عنصر_تسلسل_دلالي(&(*الحقائق).الأنواع, النوع) مع
    | اختياري.موجود(ن) -> { أرجع اختياري.موجود(ن); }
    | اختياري.لا_شيء -> { };
    أرجع نوع_عنصر_شريحة_دلالي(&(*الحقائق).الأنواع, النوع);
}

// Pushes the i32 index (a 64-bit index wraps: bounds were checked in MSIR).
عرف ادفع_فهرس32_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الفهرس: معرف_قيمة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع المحلي: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, الفهرس) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المحلي := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الفهرس) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    اقرأ_محلي_ويب_أسمبلي(ح, المحلي);
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        إذا (الوصف.البتات == 64) { أصدر_ويب_أسمبلي(ح, 0xA7); }; // i32.wrap_i64
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    أرجع اختياري.لا_شيء();
}

// Element address of a sequence value: data[index] (stride = element size).
عرف عنوان_عنصر_تسلسل_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المصدر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير,
    نوع_العنصر: معرف_نوع
): نتيجة طبيعي, خطأ_اختيار_ويب_أسمبلي {
    دع العنوان: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(م) -> { العنوان := م; };
    دع نوع_المصدر: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
    دع تخطيط_المصدر: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_المصدر := ت; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي;
    طابق حقول_تسلسل_ويب_أسمبلي_من(&تخطيط_المصدر, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
    دع تخطيط_العنصر: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
    أصدر_ويب_أسمبلي(ح, 0x28); // i32.load data
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
    طابق ادفع_فهرس32_ويب_أسمبلي(ح, الحقائق, المسير, الفهرس) مع | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); } | اختياري.لا_شيء -> { };
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, تخطيط_العنصر.الحجم);
    أصدر_ويب_أسمبلي(ح, 0x6C); // i32.mul
    أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
    دع الناتج: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع نتيجة.نجح(الناتج);
}

// Capacity is checked before multiplying by the stride or allocating.
عرف سعة_تهيئة_متجه_ويب_أسمبلي(العدد: طبيعي, حجم_العنصر: طبيعي): اختياري طبيعي {
    إذا (العدد == 0) { أرجع اختياري.موجود(0); };
    إذا (حجم_العنصر == 0) { أرجع اختياري.لا_شيء(); };
    دع الحد: طبيعي = 4294967295 / حجم_العنصر;
    إذا (العدد > الحد) { أرجع اختياري.لا_شيء(); };
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(حجم_العنصر);
    إذا (السياسة.السعة_الدنيا == 0 || السياسة.عامل_النمو <= 1) { أرجع اختياري.لا_شيء(); };
    دع السعة: متغير طبيعي = السياسة.السعة_الدنيا;
    إذا (السعة > الحد) { أرجع اختياري.لا_شيء(); };
    طالما (السعة < العدد) {
        إذا (السعة > الحد / السياسة.عامل_النمو) { أرجع اختياري.موجود(العدد); };
        السعة := السعة * السياسة.عامل_النمو;
    }
    أرجع اختياري.موجود(السعة);
}

عرف أصدر_طول_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير,
    الناتج: معرف_قيمة_مسير,
    السعة_مطلوبة: منطقي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 1) {
        أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.طول()));
    };
    دع المصدر: معرف_قيمة_مسير = (*النداء).الحجج[0];
    دع العنوان: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { العنوان := م; };
    دع نوع_المصدر: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
    دع التخطيط: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي;
    طابق حقول_تسلسل_ويب_أسمبلي_من(&التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
    دع نوع_الناتج: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_الناتج := ن; };
    دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
    طابق محلي_لنوع_ويب_أسمبلي(ح, الحقائق, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
    // The header length and capacity fields are pointer-width (u32) words.
    دع إزاحة_الحقل: متغير طبيعي = الحقول.الطول;
    إذا (السعة_مطلوبة) { إزاحة_الحقل := الحقول.السعة; };
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
    أصدر_ويب_أسمبلي(ح, 0x28); // i32.load
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, إزاحة_الحقل);
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_الناتج) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        إذا (الوصف.البتات == 64) { أصدر_ويب_أسمبلي(ح, 0xAD); } // i64.extend_i32_u
        وإلا { أصدر_تطبيع32_ويب_أسمبلي(ح, الوصف.البتات, الوصف.موقع); };
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
    اكتب_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
    ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
    أرجع اختياري.لا_شيء();
}

// The new length of the vector at the mutated place (pop and truncate glue):
// a u32 store into the header's length word.
عرف أصدر_ضبط_طول_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 2) {
        أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.ضبط_طول_متجه()));
    };
    دع المكان: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختياري.موجود(م) -> { المكان := م; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.ضبط_طول_متجه())); };
    دع العنوان: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { العنوان := م; };
    دع نوع_المتجه: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي;
    طابق حقول_تسلسل_ويب_أسمبلي_من(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
    دع الطول: معرف_قيمة_مسير = (*النداء).الحجج[1];
    دع محلي_الطول: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, الطول) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { محلي_الطول := م; };
    دع نوع_الطول: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الطول) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_الطول := ن; };
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
    اقرأ_محلي_ويب_أسمبلي(ح, محلي_الطول);
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_الطول) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        إذا (الوصف.البتات == 64) { أصدر_ويب_أسمبلي(ح, 0xA7); }; // i32.wrap_i64
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الطول)); };
    أصدر_ويب_أسمبلي(ح, 0x36); // i32.store
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    أرجع اختياري.لا_شيء();
}

// Grows the vector at العنوان to hold length + إضافي32 elements (i32 locals;
// a wrap traps): to exactly that many as reserve_exact does, or, given the
// growth policy, to max(length + إضافي32, capacity * growth, minimum), its
// amortized rule (سعة_نمو_المتجه). المطلوب is scratch.
// Extend (إلحاق_نطاق_متجه): grow once by the amortized rule, check the
// source range, then one memory.copy of count * size bytes and length += count.
عرف أصدر_طبيعي32_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): نتيجة طبيعي, خطأ_اختيار_ويب_أسمبلي {
    دع المحلي: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, القيمة) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(م) -> { المحلي := م; };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, القيمة) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    دع الناتج: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        إذا (الوصف.البتات == 64) {
            اقرأ_محلي_ويب_أسمبلي(ح, المحلي); أصدر_ثابت64_بتات_حجز_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x56); // i64.gt_u
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            اقرأ_محلي_ويب_أسمبلي(ح, المحلي); أصدر_ويب_أسمبلي(ح, 0xA7); // i32.wrap_i64
        } وإلا {
            اقرأ_محلي_ويب_أسمبلي(ح, المحلي);
        };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    اكتب_محلي_ويب_أسمبلي(ح, الناتج);
    أرجع نتيجة.نجح(الناتج);
}

عرف أصدر_امتداد_متجه_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &سياق_وحدة_ويب_أسمبلي,
    النداء: &نداء_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع البدائي: هوية_بدائي_مترجم = هوية_بدائي_مترجم.إلحاق_نطاق_متجه();
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 4 || !يدعم_ذاكرة_خطية_للهدف(الهدف)) {
        أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي));
    };
    دع المكان: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختياري.موجود(م) -> { المكان := م; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    دع المزود: معرف_دالة_مسير;
    طابق (*السياق).مزودات_الذاكرة مع
    | اختياري.موجود(المزودات) -> { المزود := المزودات.إعادة_التخصيص; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); };
    دع العنوان: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { العنوان := م; };
    دع المصدر: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*النداء).الحجج[1]) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المصدر := م; };
    دع نوع_المتجه: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي;
    طابق حقول_تسلسل_ويب_أسمبلي_من(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
    دع نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_تسلسل_ويب_أسمبلي(الحقائق, نوع_المتجه) مع
    | اختياري.موجود(ن) -> { نوع_العنصر := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المتجه)); };
    دع تخطيط_العنصر: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    دع الحجم: طبيعي = تخطيط_العنصر.الحجم;
    إذا (!(الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)) {
        أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_العنصر));
    };
    دع البداية: طبيعي;
    طابق أصدر_طبيعي32_ويب_أسمبلي(ح, المسير, الحقائق, (*النداء).الحجج[2]) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { البداية := م; };
    دع العدد: طبيعي;
    طابق أصدر_طبيعي32_ويب_أسمبلي(ح, المسير, الحقائق, (*النداء).الحجج[3]) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { العدد := م; };
    // The source range: start + count (a wrap traps) <= source length.
    دع النهاية: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    اقرأ_محلي_ويب_أسمبلي(ح, البداية); اقرأ_محلي_ويب_أسمبلي(ح, العدد); أصدر_ويب_أسمبلي(ح, 0x6A);
    اكتب_محلي_ويب_أسمبلي(ح, النهاية);
    اقرأ_محلي_ويب_أسمبلي(ح, النهاية); اقرأ_محلي_ويب_أسمبلي(ح, العدد); أصدر_ويب_أسمبلي(ح, 0x49); // i32.lt_u
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    اقرأ_محلي_ويب_أسمبلي(ح, النهاية);
    اقرأ_محلي_ويب_أسمبلي(ح, المصدر); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    أصدر_ويب_أسمبلي(ح, 0x4B); // i32.gt_u
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    // Grow once, by the policy's amortized rule.
    دع المطلوب: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(الحجم);
    أصدر_حجز_بعدد_ويب_أسمبلي(ح, العنوان, العدد, المطلوب, &الحقول, الحجم, المزود, اختياري.موجود(السياسة));
    // memory.copy(data + length * size, source data + start * size, count * size)
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الحجم); أصدر_ويب_أسمبلي(ح, 0x6C); أصدر_ويب_أسمبلي(ح, 0x6A);
    اقرأ_محلي_ويب_أسمبلي(ح, المصدر); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
    اقرأ_محلي_ويب_أسمبلي(ح, البداية); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الحجم); أصدر_ويب_أسمبلي(ح, 0x6C); أصدر_ويب_أسمبلي(ح, 0x6A);
    اقرأ_محلي_ويب_أسمبلي(ح, العدد); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, الحجم); أصدر_ويب_أسمبلي(ح, 0x6C);
    أصدر_نسخ_ذاكرة_ويب_أسمبلي(ح);
    // length += count
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    اقرأ_محلي_ويب_أسمبلي(ح, العدد); أصدر_ويب_أسمبلي(ح, 0x6A);
    أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    أرجع اختياري.لا_شيء();
}

عرف أصدر_حجز_بعدد_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    العنوان: طبيعي,
    إضافي32: طبيعي,
    المطلوب: طبيعي,
    الحقول_م: &حقول_تسلسل_ويب_أسمبلي,
    حجم_العنصر: طبيعي,
    المزود: معرف_دالة_مسير,
    النمو: اختياري سياسة_نمو_متجه
): فراغ {
    دع الحقول: حقول_تسلسل_ويب_أسمبلي = *الحقول_م;
    // total = length + additional; a wrap traps.
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    اقرأ_محلي_ويب_أسمبلي(ح, إضافي32); أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
    اكتب_محلي_ويب_أسمبلي(ح, المطلوب);
    اقرأ_محلي_ويب_أسمبلي(ح, المطلوب); اقرأ_محلي_ويب_أسمبلي(ح, إضافي32); أصدر_ويب_أسمبلي(ح, 0x49); // i32.lt_u
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    // if total > capacity: data := realloc(data, total * stride); capacity := total
    اقرأ_محلي_ويب_أسمبلي(ح, المطلوب);
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
    أصدر_ويب_أسمبلي(ح, 0x4B); // i32.gt_u
    أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if
    طابق النمو مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(السياسة) -> {
        // step = capacity * growth (an overflow traps), at least the minimum;
        // total = max(total, step).
        دع الخطوة: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
        اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, 4294967295 / السياسة.عامل_النمو);
        أصدر_ويب_أسمبلي(ح, 0x4B); // i32.gt_u
        أصدر_فخ_إذا_ويب_أسمبلي(ح);
        اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السياسة.عامل_النمو); أصدر_ويب_أسمبلي(ح, 0x6C); // i32.mul
        اكتب_محلي_ويب_أسمبلي(ح, الخطوة);
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السياسة.السعة_الدنيا);
        اقرأ_محلي_ويب_أسمبلي(ح, الخطوة);
        اقرأ_محلي_ويب_أسمبلي(ح, الخطوة); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السياسة.السعة_الدنيا); أصدر_ويب_أسمبلي(ح, 0x49); // i32.lt_u
        أصدر_ويب_أسمبلي(ح, 0x1B); // select
        اكتب_محلي_ويب_أسمبلي(ح, الخطوة);
        اقرأ_محلي_ويب_أسمبلي(ح, المطلوب);
        اقرأ_محلي_ويب_أسمبلي(ح, الخطوة);
        اقرأ_محلي_ويب_أسمبلي(ح, الخطوة); اقرأ_محلي_ويب_أسمبلي(ح, المطلوب); أصدر_ويب_أسمبلي(ح, 0x49); // i32.lt_u
        أصدر_ويب_أسمبلي(ح, 0x1B); // select
        اكتب_محلي_ويب_أسمبلي(ح, المطلوب);
    };
    اقرأ_محلي_ويب_أسمبلي(ح, المطلوب);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, 4294967295 / حجم_العنصر);
    أصدر_ويب_أسمبلي(ح, 0x4B);
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    أصدر_ثابت32_ويب_أسمبلي(ح, 0);
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
    اقرأ_محلي_ويب_أسمبلي(ح, المطلوب); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, حجم_العنصر); أصدر_ويب_أسمبلي(ح, 0x6C);
    دع البيانات_الجديدة: طبيعي;
    طابق أصدر_نداء_مزود_ذاكرة_ويب_أسمبلي(ح, المزود, صواب) مع
    | اختياري.موجود(م) -> { البيانات_الجديدة := م; }
    | اختياري.لا_شيء -> { أصدر_ويب_أسمبلي(ح, 0x00); أصدر_ويب_أسمبلي(ح, 0x0B); أرجع; };
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); اقرأ_محلي_ويب_أسمبلي(ح, البيانات_الجديدة);
    أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات); // i32.store
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); اقرأ_محلي_ويب_أسمبلي(ح, المطلوب);
    أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
    أصدر_ويب_أسمبلي(ح, 0x0B); // end
}

// Reserve (Rust's Vec::reserve_exact): when length + additional exceeds the
// capacity, the buffer is reallocated to exactly that many elements with the
// std reallocation provider, as append grows it.
عرف أصدر_حجز_سعة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &سياق_وحدة_ويب_أسمبلي,
    النداء: &نداء_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 2) {
        أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.حجز_سعة_متجه()));
    };
    دع المكان: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختياري.موجود(م) -> { المكان := م; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.حجز_سعة_متجه())); };
    دع المزود: معرف_دالة_مسير;
    طابق (*السياق).مزودات_الذاكرة مع
    | اختياري.موجود(المزودات) -> { المزود := المزودات.إعادة_التخصيص; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); };
    دع العنوان: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { العنوان := م; };
    دع نوع_المتجه: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي;
    طابق حقول_تسلسل_ويب_أسمبلي_من(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
    دع نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_تسلسل_ويب_أسمبلي(الحقائق, نوع_المتجه) مع
    | اختياري.موجود(ن) -> { نوع_العنصر := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المتجه)); };
    دع تخطيط_العنصر: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    // Zero-sized elements own no storage: nothing to reserve.
    إذا (تخطيط_العنصر.الحجم == 0) { أرجع اختياري.لا_شيء(); };
    إذا (تخطيط_العنصر.الحجم > 4294967295) {
        أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_العنصر));
    };
    دع الإضافي: معرف_قيمة_مسير = (*النداء).الحجج[1];
    دع محلي_الإضافي: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, الإضافي) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { محلي_الإضافي := م; };
    دع نوع_الإضافي: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الإضافي) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_الإضافي := ن; };
    دع المطلوب: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    دع إضافي32: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_الإضافي) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        إذا (الوصف.البتات == 64) {
            // An additional count above the address space cannot be met.
            اقرأ_محلي_ويب_أسمبلي(ح, محلي_الإضافي); أصدر_ثابت64_بتات_حجز_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x56); // i64.gt_u
            أصدر_فخ_إذا_ويب_أسمبلي(ح);
            اقرأ_محلي_ويب_أسمبلي(ح, محلي_الإضافي); أصدر_ويب_أسمبلي(ح, 0xA7); // i32.wrap_i64
        } وإلا {
            اقرأ_محلي_ويب_أسمبلي(ح, محلي_الإضافي);
        };
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الإضافي)); };
    اكتب_محلي_ويب_أسمبلي(ح, إضافي32);
    أصدر_حجز_بعدد_ويب_أسمبلي(ح, العنوان, إضافي32, المطلوب, &الحقول, تخطيط_العنصر.الحجم, المزود, اختياري.لا_شيء());
    أرجع اختياري.لا_شيء();
}

// The i64 constant 0xFFFFFFFF (the largest wasm32 element count).
عرف أصدر_ثابت64_بتات_حجز_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    أصدر_ويب_أسمبلي(ح, 0x42); // i64.const
    ألحق_ليب128_موقع_حجز_ويب_أسمبلي(&متغير (*ح).الشفرة, 4294967295);
}

// Signed LEB128 of a non-negative value below 2^63.
عرف ألحق_ليب128_موقع_حجز_ويب_أسمبلي(الشفرة: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع البايت: طبيعي = الباقي % 128;
        الباقي := الباقي / 128;
        إذا (الباقي == 0 && البايت < 64) {
            ألحق(*الشفرة, البايت مثل ط8);
            مستمر := خطأ;
        } وإلا {
            ألحق(*الشفرة, (البايت + 128) مثل ط8);
        };
    }
}

// Vector append: the same guarded growth policy as the LLVM provider, with the
// std reallocation provider for the backing storage.
عرف أصدر_إلحاق_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &سياق_وحدة_ويب_أسمبلي,
    النداء: &نداء_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 2) {
        أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.إلحاق()));
    };
    دع المكان: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختياري.موجود(م) -> { المكان := م; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(هوية_بدائي_مترجم.إلحاق())); };
    دع المزود: معرف_دالة_مسير;
    طابق (*السياق).مزودات_الذاكرة مع
    | اختياري.موجود(المزودات) -> { المزود := المزودات.إعادة_التخصيص; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); };
    دع العنوان: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { العنوان := م; };
    دع نوع_المتجه: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع الحقول: حقول_تسلسل_ويب_أسمبلي;
    طابق حقول_تسلسل_ويب_أسمبلي_من(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
    دع العنصر: معرف_قيمة_مسير = (*النداء).الحجج[1];
    دع نوع_العنصر: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_العنصر := ن; };
    دع تخطيط_العنصر: واصف_تخطيط;
    طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    إذا (تخطيط_العنصر.الحجم == 0 || تخطيط_العنصر.الحجم > 4294967295) {
        أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_العنصر));
    };
    دع تمثيل_العنصر: تمثيل_قيمة_ويب_أسمبلي;
    طابق قيمة_ويب_أسمبلي(ح, العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تمثيل_العنصر := ت; };
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(تخطيط_العنصر.الحجم مثل طبيعي);
    دع طول_حالي: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    دع سعة_حالية: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    دع سعة_جديدة: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    اكتب_محلي_ويب_أسمبلي(ح, طول_حالي);
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
    اكتب_محلي_ويب_أسمبلي(ح, سعة_حالية);
    // A corrupted header never becomes an unchecked store; length cannot wrap.
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); اقرأ_محلي_ويب_أسمبلي(ح, سعة_حالية); أصدر_ويب_أسمبلي(ح, 0x4B); // i32.gt_u
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); أصدر_ثابت32_ويب_أسمبلي(ح, -1); أصدر_ويب_أسمبلي(ح, 0x46); // i32.eq
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); اقرأ_محلي_ويب_أسمبلي(ح, سعة_حالية); أصدر_ويب_أسمبلي(ح, 0x46);
    أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if full
    // Doubling a nonzero capacity must not overflow.
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_حالية);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, 4294967295 / السياسة.عامل_النمو);
    أصدر_ويب_أسمبلي(ح, 0x4B); // i32.gt_u
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    // new capacity = max(capacity * growth, minimum) (سعة_نمو_المتجه with
    // length + 1, which a full buffer's next step always covers).
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_حالية); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السياسة.عامل_النمو); أصدر_ويب_أسمبلي(ح, 0x6C); // i32.mul
    اكتب_محلي_ويب_أسمبلي(ح, سعة_جديدة);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السياسة.السعة_الدنيا);
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_جديدة);
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_جديدة); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السياسة.السعة_الدنيا); أصدر_ويب_أسمبلي(ح, 0x49); // i32.lt_u
    أصدر_ويب_أسمبلي(ح, 0x1B); // select (the minimum when below it)
    اكتب_محلي_ويب_أسمبلي(ح, سعة_جديدة);
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_جديدة);
    أصدر_ثابت_بتات32_ويب_أسمبلي(ح, 4294967295 / تخطيط_العنصر.الحجم);
    أصدر_ويب_أسمبلي(ح, 0x4B);
    أصدر_فخ_إذا_ويب_أسمبلي(ح);
    // data := realloc(data, new_capacity * stride)
    أصدر_ثابت32_ويب_أسمبلي(ح, 0);
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
    اقرأ_محلي_ويب_أسمبلي(ح, سعة_جديدة); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, تخطيط_العنصر.الحجم); أصدر_ويب_أسمبلي(ح, 0x6C);
    دع البيانات_الجديدة: طبيعي;
    طابق أصدر_نداء_مزود_ذاكرة_ويب_أسمبلي(ح, المزود, صواب) مع
    | اختياري.موجود(م) -> { البيانات_الجديدة := م; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود()); };
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); اقرأ_محلي_ويب_أسمبلي(ح, البيانات_الجديدة);
    أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات); // i32.store
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); اقرأ_محلي_ويب_أسمبلي(ح, سعة_جديدة);
    أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
    أصدر_ويب_أسمبلي(ح, 0x0B); // end
    // data[length] := element
    دع مكان_العنصر: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان); أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, تخطيط_العنصر.الحجم); أصدر_ويب_أسمبلي(ح, 0x6C);
    أصدر_ويب_أسمبلي(ح, 0x6A);
    اكتب_محلي_ويب_أسمبلي(ح, مكان_العنصر);
    طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر, مكان_العنصر, 0, تمثيل_العنصر) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    اقرأ_محلي_ويب_أسمبلي(ح, العنوان);
    اقرأ_محلي_ويب_أسمبلي(ح, طول_حالي); أصدر_ثابت32_ويب_أسمبلي(ح, 1); أصدر_ويب_أسمبلي(ح, 0x6A);
    أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
    أرجع اختياري.لا_شيء();
}

عرف أصدر_ثابت_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    الثابت: &ثابت_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    طابق *الثابت مع
    | ثابت_مسير.نص(البايتات) -> {
        // Text literal: a frame header pointing at read-only object data.
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع الحقول: حقول_تسلسل_ويب_أسمبلي;
        طابق حقول_تسلسل_ويب_أسمبلي_من(&التخطيط, النوع) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
        دع المكان: طبيعي = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        دع العدد: طبيعي = الطول(البايتات) مثل طبيعي;
        اقرأ_محلي_ويب_أسمبلي(ح, المكان);
        إذا (العدد == 0) {
            أصدر_ثابت32_ويب_أسمبلي(ح, 0);
        } وإلا {
            دع المعرف: معرف_بيانات_ثابتة_كائن = معرف_بيانات_ثابتة_كائن_من(
                معرف_دالة_منتقاة_من_مسير((*ح).المعرف), الطول((*ح).البيانات_الثابتة) مثل طبيعي
            );
            دع النسخة: متجه ط8 = انسخ_بايتات(&البايتات);
            دع البيان: بيانات_ثابتة_كائن = {
                المعرف: معرف_بيانات_ثابتة_كائن_من(المعرف.الدالة, المعرف.القيمة),
                البيانات: النسخة, المحاذاة: 1, للقراءة_فقط: صواب
            };
            ألحق((*ح).البيانات_الثابتة, البيان);
            أصدر_عنوان_رمز_ويب_أسمبلي(ح, هدف_إزاحة_ويب_أسمبلي.رمز(مرجع_رمز_كائن.بيانات_ثابتة(المعرف)), 0);
        };
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, العدد);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, العدد);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المكان, عنوان: صواب };
        ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
        أرجع اختياري.لا_شيء();
    }
    | ثابت_مسير.متجه(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); }
    | _ -> { };
    دع الوصف: وصف_سلمي_ويب_أسمبلي;
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> { الوصف := و; }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    دع المحلي: طبيعي = محلي_جديد_ويب_أسمبلي(ح, الوصف.النوع);
    طابق *الثابت مع
    | ثابت_مسير.منطق(القيمة) -> {
        إذا (القيمة) { أصدر_ثابت32_ويب_أسمبلي(ح, 1); } وإلا { أصدر_ثابت32_ويب_أسمبلي(ح, 0); };
    }
    | ثابت_مسير.صحيح_موقع(القيمة) -> { أصدر_ثابت_عدد_ويب_أسمبلي(ح, &الوصف, القيمة مثل طبيعي); }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> { أصدر_ثابت_عدد_ويب_أسمبلي(ح, &الوصف, القيمة); }
    | ثابت_مسير.مؤشر_فارغ -> { أصدر_ثابت32_ويب_أسمبلي(ح, 0); }
    | ثابت_مسير.عشري(البايتات) -> {
        طابق بتات_عائم_من_عشري(&البايتات, الوصف.البتات) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); }
        | اختياري.موجود(البتات) -> {
            إذا (الوصف.البتات == 32) {
                أصدر_ويب_أسمبلي(ح, 0x43); // f32.const
                ألحق_قيمة_صغيرة_الطرف_ويب_أسمبلي(&متغير (*ح).الشفرة, البتات, 4);
            } وإلا {
                أصدر_ويب_أسمبلي(ح, 0x44); // f64.const
                ألحق_قيمة_صغيرة_الطرف_ويب_أسمبلي(&متغير (*ح).الشفرة, البتات, 8);
            };
        };
    }
    | ثابت_مسير.دالة(المعرف) -> { أصدر_فهرس_جدول_دالة_ويب_أسمبلي(ح, المعرف); }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المحلي, عنوان: خطأ };
    ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
    أرجع اختياري.لا_شيء();
}

عرف ناتج_مطلوب_ويب_أسمبلي(الناتج: اختياري معرف_قيمة_مسير): نتيجة معرف_قيمة_مسير, خطأ_اختيار_ويب_أسمبلي {
    طابق الناتج مع
    | اختياري.موجود(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
}

// A new scalar local for an instruction result (its type must be scalar).
عرف محلي_ناتج_سلمي_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الناتج: معرف_قيمة_مسير
): نتيجة طبيعي, خطأ_اختيار_ويب_أسمبلي {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        دع المحلي: طبيعي = محلي_جديد_ويب_أسمبلي(ح, الوصف.النوع);
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المحلي, عنوان: خطأ };
        ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
        أرجع نتيجة.نجح(المحلي);
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

// The result value aliases an existing local (address or scalar copy).
عرف اربط_ناتج_بمحلي_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الناتج: معرف_قيمة_مسير,
    المحلي: طبيعي,
    عنوان: منطقي
): فراغ {
    دع التمثيل: تمثيل_قيمة_ويب_أسمبلي = { المحلي: المحلي, عنوان: عنوان };
    ضع_قيمة_ويب_أسمبلي(ح, الناتج, التمثيل);
}

// The closure-environment reference-counting primitives on the header laid
// out by خطط_بيئة_إغلاق_للاختيار (an i64 count, an i32 destructor table index).
عرف أصدر_بدائي_بيئة_إغلاق_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    البدائي: هوية_بدائي_مترجم,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    دع البيئة: طبيعي;
    طابق محلي_قيمة_ويب_أسمبلي(ح, (*النداء).الحجج[0]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(م) -> { البيئة := م; };
    دع العداد: طبيعي = إزاحة_عداد_بيئة_إغلاق();
    طابق البدائي مع
    | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> {
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        أصدر_ويب_أسمبلي(ح, 0x29); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, العداد); // i64.load
        أصدر_ثابت64_ويب_أسمبلي(ح, 1);
        أصدر_ويب_أسمبلي(ح, 0x7C); // i64.add
        أصدر_ويب_أسمبلي(ح, 0x37); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, العداد); // i64.store
    }
    | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> {
        دع المعرف: معرف_قيمة_مسير;
        طابق ناتج_مطلوب_ويب_أسمبلي(الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { المعرف := ن; };
        دع المحلي: طبيعي;
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المحلي := م; };
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        أصدر_ويب_أسمبلي(ح, 0x29); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, العداد); // i64.load
        أصدر_ثابت64_ويب_أسمبلي(ح, 1);
        أصدر_ويب_أسمبلي(ح, 0x7D); // i64.sub
        أصدر_ويب_أسمبلي(ح, 0x37); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, العداد); // i64.store
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        أصدر_ويب_أسمبلي(ح, 0x29); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, العداد); // i64.load
        أصدر_ويب_أسمبلي(ح, 0x50); // i64.eqz
        اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    }
    | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> {
        دع المعرف: معرف_قيمة_مسير;
        طابق ناتج_مطلوب_ويب_أسمبلي(الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { المعرف := ن; };
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, إزاحة_مدمر_بيئة_إغلاق()); // i32.load
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0); // i32.store
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, المعرف, البيئة, خطأ);
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    أرجع اختياري.لا_شيء();
}

عرف أصدر_بدائي_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    البدائي: هوية_بدائي_مترجم,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    طابق البدائي مع
    | هوية_بدائي_مترجم.طول -> {
        طابق ناتج_مطلوب_ويب_أسمبلي(الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ن) -> { أرجع أصدر_طول_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, النداء, ن, خطأ); };
    }
    | هوية_بدائي_مترجم.سعة_متجه -> {
        طابق ناتج_مطلوب_ويب_أسمبلي(الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ن) -> { أرجع أصدر_طول_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, النداء, ن, صواب); };
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        أرجع أصدر_إلحاق_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, النداء);
    }
    | هوية_بدائي_مترجم.حجز_سعة_متجه -> {
        أرجع أصدر_حجز_سعة_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, النداء);
    }
    | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> {
        أرجع أصدر_امتداد_متجه_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, النداء);
    }
    | هوية_بدائي_مترجم.ضبط_طول_متجه -> {
        أرجع أصدر_ضبط_طول_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, النداء);
    }
    | هوية_بدائي_مترجم.معمارية_المضيف -> { }
    | هوية_بدائي_مترجم.منصة_المضيف -> { }
    | هوية_بدائي_مترجم.بيئة_المضيف -> { }
    | هوية_بدائي_مترجم.بتات_ع64 -> { }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { }
    | هوية_بدائي_مترجم.بتات_ع32 -> { }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { }
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> { }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> { }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> { }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> { }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> { }
    | هوية_بدائي_مترجم.عملية_عائمة(_) -> { }
    // Thread support. A wasm32 program runs one thread (WASI threads are not
    // used), so the atomics are the plain loads and stores of linear memory.
    | هوية_بدائي_مترجم.ذري_حمل -> { }
    | هوية_بدائي_مترجم.ذري_خزن -> { }
    | هوية_بدائي_مترجم.ذري_تبديل -> { }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> { }
    | هوية_بدائي_مترجم.ذري_جلب_و -> { }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> { }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { }
    | هوية_بدائي_مترجم.سياج_ذاكرة -> { أرجع اختياري.لا_شيء(); }
    | هوية_بدائي_مترجم.سرب_قيمة -> { }
    | هوية_بدائي_مترجم.عنوان_دالة -> { }
    | هوية_بدائي_مترجم.دالة_من_عنوان -> { }
    // WebAssembly has no callable machine addresses (only table indices).
    | هوية_بدائي_مترجم.نداء_عنوان_سي -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    // Scalar primitives: operands are locals, the result a new local.
    دع الحجج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
        طابق محلي_قيمة_ويب_أسمبلي(ح, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { ألحق(الحجج, م); };
        ف := ف + 1;
    }
    دع العدد: طبيعي = الطول(الحجج) مثل طبيعي;
    طابق البدائي مع
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
        إذا (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 2) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); اقرأ_محلي_ويب_أسمبلي(ح, الحجج[1]);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0); // i32.store
        أرجع اختياري.لا_شيء();
    }
    | هوية_بدائي_مترجم.ذري_خزن -> {
        إذا (العدد != 3) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        دع بتات_الخزن: متغير طبيعي = 32;
        طابق بتات_ذرية_ويب_أسمبلي(ح, المسير, الحقائق, (*النداء).الحجج[1]) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ب) -> { بتات_الخزن := ب; };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); اقرأ_محلي_ويب_أسمبلي(ح, الحجج[1]);
        أصدر_خزن_ذري_ويب_أسمبلي(ح, بتات_الخزن);
        أرجع اختياري.لا_شيء();
    }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
        إذا (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 3) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); اقرأ_محلي_ويب_أسمبلي(ح, الحجج[1]); اقرأ_محلي_ويب_أسمبلي(ح, الحجج[2]);
        أصدر_نسخ_ذاكرة_ويب_أسمبلي(ح);
        أرجع اختياري.لا_شيء();
    }
    | _ -> { };
    دع المعرف: معرف_قيمة_مسير;
    طابق ناتج_مطلوب_ويب_أسمبلي(الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { المعرف := ن; };
    دع المحلي: طبيعي;
    طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المحلي := م; };
    طابق البدائي مع
    | هوية_بدائي_مترجم.معمارية_المضيف -> { أرجع أصدر_هوية_مضيف_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, البدائي, المعرف, المحلي); }
    | هوية_بدائي_مترجم.منصة_المضيف -> { أرجع أصدر_هوية_مضيف_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, البدائي, المعرف, المحلي); }
    | هوية_بدائي_مترجم.بيئة_المضيف -> { أرجع أصدر_هوية_مضيف_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, البدائي, المعرف, المحلي); }
    | هوية_بدائي_مترجم.بتات_ع64 -> {
        إذا (العدد != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xBD); // i64.reinterpret_f64
    }
    | هوية_بدائي_مترجم.ع64_من_بتات -> {
        إذا (العدد != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xBF); // f64.reinterpret_i64
    }
    | هوية_بدائي_مترجم.بتات_ع32 -> {
        إذا (العدد != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xBC); // i32.reinterpret_f32
    }
    | هوية_بدائي_مترجم.ع32_من_بتات -> {
        إذا (العدد != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xBE); // f32.reinterpret_i32
    }
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
        إذا (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]);
        أصدر_ويب_أسمبلي(ح, 0x40); أصدر_ويب_أسمبلي(ح, 0x00); // memory.grow 0
    }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
        إذا (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]);
        أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0); // i32.load
    }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
        إذا (!يدعم_ذاكرة_خطية_للهدف(الهدف) || العدد != 0) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        أصدر_عنوان_رمز_ويب_أسمبلي(ح, هدف_إزاحة_ويب_أسمبلي.قاعدة_الكومة(), 0);
    }
    // Float primitives: f32/f64 abs, ceil, floor, trunc, nearest, sqrt, min,
    // max, copysign (WebAssembly's min/max are IEEE 754-2019 minimum/maximum,
    // nearest rounds ties to even). The f64 opcode is the f32 one + 0x0E.
    // WebAssembly has no scalar fused multiply-add.
    | هوية_بدائي_مترجم.عملية_عائمة(العملية_العائمة) -> {
        إذا (العدد != عدد_معاملات_عملية_عائمة(العملية_العائمة)) {
            أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي));
        };
        دع البتات: طبيعي;
        طابق نوع_قيمة_مسير(المسير, المعرف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); }
        | اختياري.موجود(ن) -> {
            طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, ن) مع
            | اختياري.موجود(ب) -> { البتات := ب; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        };
        دع الرمز: متغير طبيعي = 0;
        طابق العملية_العائمة مع
        | عملية_عائمة_بدائية.قيمة_مطلقة -> { الرمز := 0x8B; }
        | عملية_عائمة_بدائية.سقف -> { الرمز := 0x8D; }
        | عملية_عائمة_بدائية.أرضية -> { الرمز := 0x8E; }
        | عملية_عائمة_بدائية.بتر -> { الرمز := 0x8F; }
        | عملية_عائمة_بدائية.تقريب_زوجي -> { الرمز := 0x90; }
        | عملية_عائمة_بدائية.جذر_تربيعي -> { الرمز := 0x91; }
        | عملية_عائمة_بدائية.أدنى -> { الرمز := 0x96; }
        | عملية_عائمة_بدائية.أقصى -> { الرمز := 0x97; }
        | عملية_عائمة_بدائية.نسخ_إشارة -> { الرمز := 0x98; }
        | عملية_عائمة_بدائية.ضرب_جمع_مدمج -> {
            أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي));
        };
        إذا (البتات == 64) { الرمز := الرمز + 0x0E; };
        دع ف_عائم: متغير طبيعي = 0;
        طالما (ف_عائم < العدد) { اقرأ_محلي_ويب_أسمبلي(ح, الحجج[ف_عائم]); ف_عائم := ف_عائم + 1; }
        أصدر_ويب_أسمبلي(ح, الرمز);
    }
    // A leaked box and its payload pointer are one i32 address.
    | هوية_بدائي_مترجم.سرب_قيمة -> {
        إذا (العدد != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]);
    }
    // A closure is an i32 environment address; its u64 form zero-extends it.
    | هوية_بدائي_مترجم.عنوان_دالة -> {
        إذا (العدد != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xAD); // i64.extend_i32_u
    }
    | هوية_بدائي_مترجم.دالة_من_عنوان -> {
        إذا (العدد != 1) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_ويب_أسمبلي(ح, 0xA7); // i32.wrap_i64
    }
    | هوية_بدائي_مترجم.ذري_حمل -> {
        إذا (العدد != 2) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
        دع بتات_الحمل: متغير طبيعي = 32;
        طابق بتات_ذرية_ويب_أسمبلي(ح, المسير, الحقائق, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ب) -> { بتات_الحمل := ب; };
        اقرأ_محلي_ويب_أسمبلي(ح, الحجج[0]); أصدر_حمل_ذري_ويب_أسمبلي(ح, بتات_الحمل);
    }
    | هوية_بدائي_مترجم.ذري_تبديل -> { أرجع أصدر_تعديل_ذري_ويب_أسمبلي(ح, المسير, الحقائق, البدائي, &الحجج, المعرف, المحلي); }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> { أرجع أصدر_تعديل_ذري_ويب_أسمبلي(ح, المسير, الحقائق, البدائي, &الحجج, المعرف, المحلي); }
    | هوية_بدائي_مترجم.ذري_جلب_و -> { أرجع أصدر_تعديل_ذري_ويب_أسمبلي(ح, المسير, الحقائق, البدائي, &الحجج, المعرف, المحلي); }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> { أرجع أصدر_تعديل_ذري_ويب_أسمبلي(ح, المسير, الحقائق, البدائي, &الحجج, المعرف, المحلي); }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { أرجع أصدر_تعديل_ذري_ويب_أسمبلي(ح, المسير, الحقائق, البدائي, &الحجج, المعرف, المحلي); }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { أرجع أصدر_تعديل_ذري_ويب_أسمبلي(ح, المسير, الحقائق, البدائي, &الحجج, المعرف, المحلي); }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    أرجع اختياري.لا_شيء();
}

// ---- Atomics on one-threaded wasm32 (thread support) ----
عرف بتات_ذرية_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المعرف: معرف_قيمة_مسير
): نتيجة طبيعي, خطأ_اختيار_ويب_أسمبلي {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
        إذا (الوصف.البتات > 32) { أرجع نتيجة.نجح(64); };
        أرجع نتيجة.نجح(32);
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
}

عرف أصدر_حمل_ذري_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, البتات: طبيعي): فراغ {
    إذا (البتات == 64) { أصدر_ويب_أسمبلي(ح, 0x29); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, 0); }
    وإلا { أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0); };
}

عرف أصدر_خزن_ذري_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, البتات: طبيعي): فراغ {
    إذا (البتات == 64) { أصدر_ويب_أسمبلي(ح, 0x37); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, 0); }
    وإلا { أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0); };
}

// old = *p; *p = f(old, operand); the result is old. Compare-exchange stores
// (old == expected ? new : old), which leaves memory unchanged on a mismatch.
عرف أصدر_تعديل_ذري_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه طبيعي,
    المعرف: معرف_قيمة_مسير,
    المحلي: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع البتات: متغير طبيعي = 32;
    طابق بتات_ذرية_ويب_أسمبلي(ح, المسير, الحقائق, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ب) -> { البتات := ب; };
    دع العدد: طبيعي = الطول(*الحجج) مثل طبيعي;
    دع ثلاث: منطقي = هويتا_بدائي_مترجم_متساويتان(البدائي, هوية_بدائي_مترجم.ذري_قارن_وبدل());
    إذا ((ثلاث && العدد != 5) || (!ثلاث && العدد != 3)) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    اقرأ_محلي_ويب_أسمبلي(ح, (*الحجج)[0]); أصدر_حمل_ذري_ويب_أسمبلي(ح, البتات);
    اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    اقرأ_محلي_ويب_أسمبلي(ح, (*الحجج)[0]);
    دع كبير: منطقي = البتات == 64;
    طابق البدائي مع
    | هوية_بدائي_مترجم.ذري_تبديل -> { اقرأ_محلي_ويب_أسمبلي(ح, (*الحجج)[1]); }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> {
        اقرأ_محلي_ويب_أسمبلي(ح, المحلي); اقرأ_محلي_ويب_أسمبلي(ح, (*الحجج)[1]);
        إذا (كبير) { أصدر_ويب_أسمبلي(ح, 0x7C); } وإلا { أصدر_ويب_أسمبلي(ح, 0x6A); };
    }
    | هوية_بدائي_مترجم.ذري_جلب_و -> {
        اقرأ_محلي_ويب_أسمبلي(ح, المحلي); اقرأ_محلي_ويب_أسمبلي(ح, (*الحجج)[1]);
        إذا (كبير) { أصدر_ويب_أسمبلي(ح, 0x83); } وإلا { أصدر_ويب_أسمبلي(ح, 0x71); };
    }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> {
        اقرأ_محلي_ويب_أسمبلي(ح, المحلي); اقرأ_محلي_ويب_أسمبلي(ح, (*الحجج)[1]);
        إذا (كبير) { أصدر_ويب_أسمبلي(ح, 0x84); } وإلا { أصدر_ويب_أسمبلي(ح, 0x72); };
    }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> {
        اقرأ_محلي_ويب_أسمبلي(ح, المحلي); اقرأ_محلي_ويب_أسمبلي(ح, (*الحجج)[1]);
        إذا (كبير) { أصدر_ويب_أسمبلي(ح, 0x85); } وإلا { أصدر_ويب_أسمبلي(ح, 0x73); };
    }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> {
        // select(new, old, old == expected)
        اقرأ_محلي_ويب_أسمبلي(ح, (*الحجج)[2]); اقرأ_محلي_ويب_أسمبلي(ح, المحلي);
        اقرأ_محلي_ويب_أسمبلي(ح, المحلي); اقرأ_محلي_ويب_أسمبلي(ح, (*الحجج)[1]);
        إذا (كبير) { أصدر_ويب_أسمبلي(ح, 0x51); } وإلا { أصدر_ويب_أسمبلي(ح, 0x46); };
        أصدر_ويب_أسمبلي(ح, 0x1B);
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    أصدر_خزن_ذري_ويب_أسمبلي(ح, البتات);
    أرجع اختياري.لا_شيء();
}

عرف أصدر_هوية_مضيف_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم,
    المعرف: معرف_قيمة_مسير,
    المحلي: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع الرمز: عدد;
    طابق رمز_بدائي_هوية_مضيف_للهدف(الهدف, البدائي) مع
    | اختياري.موجود(ر) -> { الرمز := ر; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); };
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
    طابق صنف_نوع_ويب_أسمبلي(الحقائق, النوع) مع
    | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> { أصدر_ثابت_عدد_ويب_أسمبلي(ح, &الوصف, الرمز مثل طبيعي); }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع)); };
    اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    أرجع اختياري.لا_شيء();
}

عرف أصدر_نداء_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(المعرف) -> {
        دع العرض: عرض_دالة_مسير;
        طابق ابحث_دالة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(المعرف)); }
        | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
        // A function with captures is reached only through its closure value.
        إذا (العرض.عدد_الالتقاطات > 0) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع الخطة: خطة_دالة_واجهة;
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(المعرف)); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع البيئة: متغير اختياري طبيعي = اختياري.لا_شيء();
        إذا (!دالة_دخول_ويب_أسمبلي(السياق, المعرف)) {
            // A direct call passes a null closure environment.
            دع الفارغة: طبيعي = خذ_مؤقت32_ويب_أسمبلي(ح);
            أصدر_ثابت32_ويب_أسمبلي(ح, 0);
            اكتب_محلي_ويب_أسمبلي(ح, الفارغة);
            أعد_مؤقت32_ويب_أسمبلي(ح);
            البيئة := اختياري.موجود(الفارغة);
        };
        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المعرف));
        أرجع أصدر_نداء_بخطة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, السياق, &الخطة, البيئة,
            مستدعى_ويب_أسمبلي.مباشر(الرمز), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.دالة_خارجية(المعرف) -> {
        // A C variadic function (MSIR المعاملات_الثابتة) takes its variadic
        // arguments through a memory buffer on wasm32; that call is not
        // generated here (the LLVM provider generates it).
        طابق ابحث_دالة_خارجية_مسير(المسير, المعرف) مع
        | اختياري.موجود(الخارجية) -> {
            طابق الخارجية.المعاملات_الثابتة مع
            | اختياري.موجود(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        دع الخطة: خطة_دالة_واجهة;
        طابق حل_واجهة_نداء_خارجي_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الحجج, الناتج) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.رمز_خارجي(معرف_دالة_خارجية_منتقاة_من_مسير(المعرف));
        أرجع أصدر_نداء_بخطة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, السياق, &الخطة, اختياري.لا_شيء(),
            مستدعى_ويب_أسمبلي.مباشر(الرمز), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.قيمة_دالة(معرف_القيمة) -> {
        دع الإغلاق: طبيعي;
        طابق محلي_قيمة_ويب_أسمبلي(ح, معرف_القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { الإغلاق := م; };
        دع الخطة: خطة_دالة_واجهة;
        طابق حل_واجهة_نداء_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الحجج, الناتج) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع فهرس_التوقيع: طبيعي;
        طابق توقيع_خطة_ويب_أسمبلي(الحقائق, &الخطة, صواب) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(التوقيع) -> { فهرس_التوقيع := ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع); };
        أرجع أصدر_نداء_بخطة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, السياق, &الخطة, اختياري.موجود(الإغلاق),
            مستدعى_ويب_أسمبلي.غير_مباشر(الإغلاق, فهرس_التوقيع), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        طابق البدائي مع
        | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> {
            أرجع أصدر_بدائي_بيئة_إغلاق_ويب_أسمبلي(ح, المسير, الحقائق, البدائي, النداء, الناتج);
        }
        | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> {
            أرجع أصدر_بدائي_بيئة_إغلاق_ويب_أسمبلي(ح, المسير, الحقائق, البدائي, النداء, الناتج);
        }
        | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> {
            أرجع أصدر_بدائي_بيئة_إغلاق_ويب_أسمبلي(ح, المسير, الحقائق, البدائي, النداء, الناتج);
        }
        | هوية_بدائي_مترجم.تحرير -> {
            // Release adapts the std release provider (runtime_primitive_query_context.sn).
            طابق نداء_تحرير_مكيف_للهدف(الهدف, الحقائق, المسير, النداء) مع
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي)); }
            | اختياري.موجود(المكيف) -> {
                أرجع أصدر_نداء_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, &المكيف, الناتج);
            };
        }
        | _ -> { };
        أرجع أصدر_بدائي_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, البدائي, النداء, الناتج);
    };
}

عرف اخفض_تعليمة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    التعليمة: &عرض_تعليمة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    طابق (*التعليمة).العملية مع
    | عملية_مسير.نداء(النداء) -> {
        أرجع أصدر_نداء_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, &النداء, (*التعليمة).الناتج);
    }
    | عملية_مسير.تخزين(العملية) -> {
        دع المكان: طبيعي;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المكان := م; };
        دع النوع: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { النوع := ن; };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
        طابق قيمة_ويب_أسمبلي(ح, العملية.القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
        أرجع خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, النوع, المكان, 0, التمثيل);
    }
    | _ -> { };
    دع الناتج: معرف_قيمة_مسير;
    طابق ناتج_مطلوب_ويب_أسمبلي((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { الناتج := ن; };
    دع نوع_الناتج: معرف_نوع;
    طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_الناتج := ن; };
    طابق (*التعليمة).العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        أرجع أصدر_ثابت_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, الناتج, &الثابت);
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_حساب_صحيح_ويب_أسمبلي(ح, الحقائق, المسير, &الحساب, م); };
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_مقارنة_صحيحة_ويب_أسمبلي(ح, الحقائق, المسير, &المقارنة, م); };
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_حساب_عشري_ويب_أسمبلي(ح, الحقائق, المسير, &الحساب, م); };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_مقارنة_عشرية_ويب_أسمبلي(ح, الحقائق, المسير, &المقارنة, م); };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_تحويل_صحيح_ويب_أسمبلي(ح, الحقائق, المسير, &التحويل, نوع_الناتج, م); };
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { أرجع أصدر_تحويل_عائم_ويب_أسمبلي(ح, الحقائق, المسير, &التحويل, نوع_الناتج, م); };
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        // A raw pointer read as a 64-bit address (`p as u64`): the 32-bit
        // word zero-extended.
        إذا (هل_نوع_عنوان_صحيح_لمسير(&(*الحقائق).الأنواع, نوع_الناتج)) {
            دع محلي_المصدر: طبيعي;
            طابق محلي_قيمة_ويب_أسمبلي(ح, التحويل.المرجع) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(م) -> { محلي_المصدر := م; };
            طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(محلي_الناتج) -> {
                اقرأ_محلي_ويب_أسمبلي(ح, محلي_المصدر);
                أصدر_ويب_أسمبلي(ح, 0xAD); // i64.extend_i32_u
                اكتب_محلي_ويب_أسمبلي(ح, محلي_الناتج);
                أرجع اختياري.لا_شيء();
            };
        };
        // An address (u64) taken as a 32-bit pointer.
        طابق نوع_قيمة_مسير(المسير, التحويل.المرجع) مع
        | اختياري.موجود(نوع_المصدر) -> {
            إذا (هل_نوع_عنوان_صحيح_لمسير(&(*الحقائق).الأنواع, نوع_المصدر)) {
                دع محلي_العنوان: طبيعي;
                طابق محلي_قيمة_ويب_أسمبلي(ح, التحويل.المرجع) مع
                | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                | نتيجة.نجح(م) -> { محلي_العنوان := م; };
                طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع
                | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                | نتيجة.نجح(محلي_المؤشر) -> {
                    اقرأ_محلي_ويب_أسمبلي(ح, محلي_العنوان);
                    أصدر_ويب_أسمبلي(ح, 0xA7); // i32.wrap_i64
                    اكتب_محلي_ويب_أسمبلي(ح, محلي_المؤشر);
                    أرجع اختياري.لا_شيء();
                };
            };
        }
        | اختياري.لا_شيء -> { };
        طابق محلي_قيمة_ويب_أسمبلي(ح, التحويل.المرجع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, خطأ); };
    }
    | عملية_مسير.نقل_تسلسل_مملوك(النقل) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, النقل.المصدر) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, صواب); };
    }
    | عملية_مسير.تجميع(التجميع) -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: طبيعي = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التجميع.الأعضاء) مثل طبيعي)) {
            دع العضو: معرف_قيمة_مسير = التجميع.الأعضاء[ف];
            دع الإزاحة: طبيعي;
            طابق إزاحة_جزء_ويب_أسمبلي(&التخطيط, ف, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الإزاحة := ق; };
            دع نوع_العضو: معرف_نوع;
            طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العضو) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_العضو := ن; };
            دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
            طابق قيمة_ويب_أسمبلي(ح, العضو) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
            طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_العضو, المكان, الإزاحة, التمثيل) مع
            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المكان, صواب);
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_تسلسل_ويب_أسمبلي(الحقائق, نوع_الناتج) مع
        | اختياري.موجود(ن) -> { نوع_العنصر := ن; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
        دع تخطيط_المتجه: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
        دع تخطيط_العنصر: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
        دع الحقول: حقول_تسلسل_ويب_أسمبلي;
        طابق حقول_تسلسل_ويب_أسمبلي_من(&تخطيط_المتجه, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الحقول := ق; };
        دع العدد: طبيعي = الطول(التهيئة.العناصر) مثل طبيعي;
        دع السعة: طبيعي;
        طابق سعة_تهيئة_متجه_ويب_أسمبلي(العدد, تخطيط_العنصر.الحجم) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); }
        | اختياري.موجود(س) -> { السعة := س; };
        دع المكان: طبيعي = عنوان_إطار_جديد_ويب_أسمبلي(ح, تخطيط_المتجه.الحجم, تخطيط_المتجه.المحاذاة);
        دع البيانات: متغير اختياري طبيعي = اختياري.لا_شيء();
        إذا (السعة > 0) {
            طابق أصدر_تخصيص_ثابت_ويب_أسمبلي(ح, السياق, السعة * تخطيط_العنصر.الحجم) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(م) -> { البيانات := اختياري.موجود(م); };
        };
        اقرأ_محلي_ويب_أسمبلي(ح, المكان);
        طابق البيانات مع
        | اختياري.موجود(م) -> { اقرأ_محلي_ويب_أسمبلي(ح, م); }
        | اختياري.لا_شيء -> { أصدر_ثابت32_ويب_أسمبلي(ح, 0); };
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.البيانات);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, العدد);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.الطول);
        اقرأ_محلي_ويب_أسمبلي(ح, المكان); أصدر_ثابت_بتات32_ويب_أسمبلي(ح, السعة);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, الحقول.السعة);
        طابق البيانات مع
        | اختياري.موجود(م) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                دع العنصر: معرف_قيمة_مسير = التهيئة.العناصر[ف];
                دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
                طابق قيمة_ويب_أسمبلي(ح, العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
                طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر, م, ف * تخطيط_العنصر.الحجم, التمثيل) مع
                | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
        }
        | اختياري.لا_شيء -> { };
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المكان, صواب);
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
        دع الأساس: طبيعي;
        طابق محلي_قيمة_ويب_أسمبلي(ح, الاستخراج.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { الأساس := م; };
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الاستخراج.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع الإزاحة: طبيعي;
        طابق إزاحة_جزء_ويب_أسمبلي(&التخطيط, الاستخراج.الفهرس, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الإزاحة := ق; };
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, الأساس, الإزاحة) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | عملية_مسير.استخراج_فهرس(الاستخراج) -> {
        دع العنوان: طبيعي;
        طابق عنوان_عنصر_تسلسل_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, الاستخراج.المصدر, الاستخراج.الفهرس, نوع_الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { العنوان := م; };
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, العنوان, 0) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | عملية_مسير.مكان_محلي(_) -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: طبيعي = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المكان, صواب);
    }
    | عملية_مسير.مكان_عام(العملية) -> {
        دع المحلي: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
        أصدر_عنوان_رمز_ويب_أسمبلي(ح, هدف_إزاحة_ويب_أسمبلي.رمز(مرجع_رمز_كائن.عام(العملية.العام)), 0);
        اكتب_محلي_ويب_أسمبلي(ح, المحلي);
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المحلي, صواب);
    }
    | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المرجع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, صواب); };
    }
    | عملية_مسير.صندوق_إلى_مكان(العملية) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.الصندوق) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, صواب); };
    }
    | عملية_مسير.مكان_حقل(العملية) -> {
        دع الأساس: طبيعي;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.الأصل) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { الأساس := م; };
        دع نوع_الأصل: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.الأصل) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_الأصل := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الأصل) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع الإزاحة: طبيعي;
        طابق إزاحة_جزء_ويب_أسمبلي(&التخطيط, العملية.الفهرس, نوع_الأصل) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { الإزاحة := ق; };
        إذا (الإزاحة == 0) {
            اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, الأساس, صواب);
        } وإلا {
            دع المحلي: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
            أصدر_عنوان_مزاح_ويب_أسمبلي(ح, الأساس, الإزاحة);
            اكتب_محلي_ويب_أسمبلي(ح, المحلي);
            اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المحلي, صواب);
        };
    }
    | عملية_مسير.مكان_فهرس(العملية) -> {
        طابق عنوان_عنصر_تسلسل_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, العملية.الأصل, العملية.الفهرس, نوع_الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, صواب); };
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
        دع المؤشر: طبيعي;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المؤشر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المؤشر := م; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        اقرأ_محلي_ويب_أسمبلي(ح, المؤشر);
        طابق ادفع_فهرس32_ويب_أسمبلي(ح, الحقائق, المسير, العملية.الفهرس) مع | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, التخطيط.الحجم);
        أصدر_ويب_أسمبلي(ح, 0x6C); // i32.mul
        أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
        دع المحلي: طبيعي = محلي_جديد_ويب_أسمبلي(ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
        اكتب_محلي_ويب_أسمبلي(ح, المحلي);
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المحلي, صواب);
    }
    | عملية_مسير.تحميل(العملية) -> {
        دع المكان: طبيعي;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المكان) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المكان := م; };
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, المكان, 0) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | عملية_مسير.مكان_إلى_مرجع(العملية) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المكان) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, م, خطأ); };
    }
    | عملية_مسير.بناء_موسوم(البناء) -> {
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع التعداد: تخطيط_تعداد;
        طابق تعداد_ويب_أسمبلي(&التخطيط) مع
        | اختياري.موجود(ت) -> { التعداد := ت; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
        دع خطة_المنشئ: تخطيط_حمولات_منشئ;
        طابق تخطيط_منشئ_قيمة_مسير_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, الناتج, البناء.المنشئ) مع
        | نتيجة_تخطيط_منشئ.مكتمل(خ) -> { خطة_المنشئ := خ; }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.تخطيط_غير_مكتمل(نوع_الناتج)); };
        إذا ((الطول(البناء.الحمولات) مثل طبيعي) != (الطول(خطة_المنشئ.الحمولات) مثل طبيعي)) {
            أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة());
        };
        دع المكان: طبيعي = عنوان_إطار_جديد_ويب_أسمبلي(ح, التخطيط.الحجم, التخطيط.المحاذاة);
        طابق أصدر_تخزين_وسم_ويب_أسمبلي(ح, المكان, &التعداد.الوسم, خطة_المنشئ.قيمة_الوسم) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البناء.الحمولات) مثل طبيعي)) {
            دع الحمولة: معرف_قيمة_مسير = البناء.الحمولات[ف];
            دع نوع_الحمولة: معرف_نوع;
            طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الحمولة) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_الحمولة := ن; };
            دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
            طابق قيمة_ويب_أسمبلي(ح, الحمولة) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
            دع الإزاحة: طبيعي = التعداد.مخزن_الحمولة.الإزاحة + خطة_المنشئ.الحمولات[ف].الإزاحة;
            طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الحمولة, المكان, الإزاحة, التمثيل) مع
            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, المكان, صواب);
    }
    | عملية_مسير.استعلام_وسم(العملية) -> {
        دع المصدر: طبيعي;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المصدر := م; };
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع التعداد: تخطيط_تعداد;
        طابق تعداد_ويب_أسمبلي(&التخطيط) مع
        | اختياري.موجود(ت) -> { التعداد := ت; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر)); };
        دع المحلي: طبيعي;
        طابق محلي_ناتج_سلمي_ويب_أسمبلي(ح, المسير, الحقائق, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المحلي := م; };
        اقرأ_محلي_ويب_أسمبلي(ح, المصدر);
        دع حجم_الوسم: طبيعي = التعداد.الوسم.الحجم;
        إذا (حجم_الوسم == 1) {
            أصدر_ويب_أسمبلي(ح, 0x2D); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 1, التعداد.الوسم.الإزاحة); // load8_u
        } وإلا إذا (حجم_الوسم == 2) {
            أصدر_ويب_أسمبلي(ح, 0x2F); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 2, التعداد.الوسم.الإزاحة); // load16_u
        } وإلا إذا (حجم_الوسم == 4) {
            أصدر_ويب_أسمبلي(ح, 0x28); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, التعداد.الوسم.الإزاحة); // i32.load
        } وإلا إذا (حجم_الوسم == 8) {
            أصدر_ويب_أسمبلي(ح, 0x29); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, التعداد.الوسم.الإزاحة); // i64.load
        } وإلا {
            أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر));
        };
        // The tag value is zero-extended (or truncated) to the result type.
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_الناتج) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
            إذا (الوصف.البتات == 64 && حجم_الوسم != 8) { أصدر_ويب_أسمبلي(ح, 0xAD); }; // i64.extend_i32_u
            إذا (الوصف.البتات != 64 && حجم_الوسم == 8) { أصدر_ويب_أسمبلي(ح, 0xA7); }; // i32.wrap_i64
            إذا (الوصف.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(ح, الوصف.البتات, الوصف.موقع); };
        }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_الناتج)); };
        اكتب_محلي_ويب_أسمبلي(ح, المحلي);
    }
    | عملية_مسير.استخراج_حمولة(العملية) -> {
        دع المصدر: طبيعي;
        طابق محلي_قيمة_ويب_أسمبلي(ح, العملية.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(م) -> { المصدر := م; };
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_المصدر := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع التعداد: تخطيط_تعداد;
        طابق تعداد_ويب_أسمبلي(&التخطيط) مع
        | اختياري.موجود(ت) -> { التعداد := ت; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المصدر)); };
        دع الخطة: تخطيط_حمولات_منشئ;
        طابق تخطيط_منشئ_قيمة_مسير_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, العملية.المصدر, العملية.المنشئ) مع
        | نتيجة_تخطيط_منشئ.مكتمل(خ) -> { الخطة := خ; }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.تخطيط_غير_مكتمل(نوع_المصدر)); };
        إذا (العملية.الحمولة >= (الطول(الخطة.الحمولات) مثل طبيعي)) {
            أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة());
        };
        دع الإزاحة: طبيعي = التعداد.مخزن_الحمولة.الإزاحة + الخطة.الحمولات[العملية.الحمولة].الإزاحة;
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, المصدر, الإزاحة) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | عملية_مسير.بناء_صندوق(العملية) -> {
        دع نوع_القيمة: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, العملية.القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_القيمة := ن; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_ويب_أسمبلي(الحقائق, الهدف, سجل_التخطيط, نوع_القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع الصندوق: طبيعي;
        طابق أصدر_تخصيص_ثابت_ويب_أسمبلي(ح, السياق, التخطيط.الحجم) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { الصندوق := م; };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
        طابق قيمة_ويب_أسمبلي(ح, العملية.القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
        طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_القيمة, الصندوق, 0, التمثيل) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, الصندوق, خطأ);
    }
    | عملية_مسير.بناء_إغلاق(البناء) -> {
        دع العرض: عرض_دالة_مسير;
        طابق ابحث_دالة_مسير(المسير, البناء.الدالة) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(البناء.الدالة)); }
        | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
        دع الخطة: تخطيط_بيئة_إغلاق_اختيار;
        طابق خطط_بيئة_إغلاق_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, البناء.الدالة, العرض.عدد_الالتقاطات) مع
        | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(خ) -> { الخطة := خ; }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع البيئة: طبيعي;
        طابق أصدر_تخصيص_ثابت_ويب_أسمبلي(ح, السياق, الخطة.الحجم) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { البيئة := م; };
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        أصدر_فهرس_جدول_دالة_ويب_أسمبلي(ح, البناء.الدالة);
        أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, 0); // i32.store
        // The environment header: one reference, and the destructor.
        اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
        أصدر_ثابت64_ويب_أسمبلي(ح, 1);
        أصدر_ويب_أسمبلي(ح, 0x37); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 8, إزاحة_عداد_بيئة_إغلاق()); // i64.store
        طابق البناء.المدمر مع
        | اختياري.موجود(المدمر) -> {
            اقرأ_محلي_ويب_أسمبلي(ح, البيئة);
            أصدر_فهرس_جدول_دالة_ويب_أسمبلي(ح, المدمر);
            أصدر_ويب_أسمبلي(ح, 0x36); ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, 4, إزاحة_مدمر_بيئة_إغلاق()); // i32.store
        }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البناء.الالتقاطات) مثل طبيعي)) {
            إذا (ف >= (الطول(الخطة.إزاحات_الالتقاطات) مثل طبيعي)) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
            دع الالتقاط: معرف_قيمة_مسير = البناء.الالتقاطات[ف];
            دع نوع_الالتقاط: معرف_نوع;
            طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الالتقاط) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ن) -> { نوع_الالتقاط := ن; };
            دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
            طابق قيمة_ويب_أسمبلي(ح, الالتقاط) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
            طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الالتقاط, البيئة, الخطة.إزاحات_الالتقاطات[ف], التمثيل) مع
            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        اربط_ناتج_بمحلي_ويب_أسمبلي(ح, الناتج, البيئة, خطأ);
    }
    | عملية_مسير.استخراج_التقاط(العملية) -> {
        دع البيئة: طبيعي;
        طابق (*ح).بيئة_الإغلاق مع
        | اختياري.موجود(م) -> { البيئة := م; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع العرض: عرض_دالة_مسير;
        طابق ابحث_دالة_مسير(المسير, (*ح).المعرف) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة((*ح).المعرف)); }
        | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
        دع الخطة: تخطيط_بيئة_إغلاق_اختيار;
        طابق خطط_بيئة_إغلاق_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, (*ح).المعرف, العرض.عدد_الالتقاطات) مع
        | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(خ) -> { الخطة := خ; }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        إذا (العملية.الفهرس >= (الطول(الخطة.إزاحات_الالتقاطات) مثل طبيعي)) {
            أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة());
        };
        طابق حمل_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج, البيئة, الخطة.إزاحات_الالتقاطات[العملية.الفهرس]) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(ح, الناتج, ت); };
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
    أرجع اختياري.لا_شيء();
}

عرف أصدر_تخزين_وسم_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المكان: طبيعي,
    الوسم: &تمثيل_وسم_تعداد,
    القيمة: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    اقرأ_محلي_ويب_أسمبلي(ح, المكان);
    دع الحجم: طبيعي = (*الوسم).الحجم;
    إذا (الحجم == 8) {
        أصدر_ثابت64_ويب_أسمبلي(ح, القيمة مثل عدد);
        أصدر_ويب_أسمبلي(ح, 0x37); // i64.store
    } وإلا {
        أصدر_ثابت_بتات32_ويب_أسمبلي(ح, القيمة);
        إذا (الحجم == 1) { أصدر_ويب_أسمبلي(ح, 0x3A); } // i32.store8
        وإلا إذا (الحجم == 2) { أصدر_ويب_أسمبلي(ح, 0x3B); } // i32.store16
        وإلا إذا (الحجم == 4) { أصدر_ويب_أسمبلي(ح, 0x36); } // i32.store
        وإلا { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
    };
    ألحق_معامل_ذاكرة_ويب_أسمبلي(&متغير (*ح).الشفرة, الحجم, (*الوسم).الإزاحة);
    أرجع اختياري.لا_شيء();
}

// ------------------------------------------------------ structured CFG --

عرف ادفع_بنية_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي, الإطار: إطار_بنية_ويب_أسمبلي): فراغ {
    إذا ((*ح).عمق_السياق < (الطول((*ح).السياق) مثل طبيعي)) {
        (*ح).السياق[(*ح).عمق_السياق] := الإطار;
    } وإلا {
        ألحق((*ح).السياق, الإطار);
    };
    (*ح).عمق_السياق := (*ح).عمق_السياق + 1;
}

عرف أزل_بنية_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    (*ح).عمق_السياق := (*ح).عمق_السياق - 1;
}

// Relative depth of the enclosing loop headed by (or block followed by) the
// block الكتلة, counted from the innermost construct.
عرف عمق_فرع_ويب_أسمبلي(ح: &حالة_اختيار_ويب_أسمبلي, الكتلة: طبيعي, حلقة: منطقي): اختياري طبيعي {
    دع ف: متغير طبيعي = (*ح).عمق_السياق;
    طالما (ف > 0) {
        ف := ف - 1;
        دع مطابق: متغير منطقي = خطأ;
        طابق (*ح).السياق[ف] مع
        | إطار_بنية_ويب_أسمبلي.حلقة(الرأس) -> { مطابق := حلقة && الرأس == الكتلة; }
        | إطار_بنية_ويب_أسمبلي.كتلة(التالية) -> { مطابق := !حلقة && التالية == الكتلة; }
        | إطار_بنية_ويب_أسمبلي.شرط -> { };
        إذا (مطابق) { أرجع اختياري.موجود((*ح).عمق_السياق - 1 - ف); };
    }
    أرجع اختياري.لا_شيء();
}

عرف أصدر_خاتمة_ويب_أسمبلي(ح: &متغير حالة_اختيار_ويب_أسمبلي): فراغ {
    اقرأ_محلي_ويب_أسمبلي(ح, (*ح).محلي_الإطار);
    أصدر_حجم_الإطار_ويب_أسمبلي(ح);
    أصدر_ويب_أسمبلي(ح, 0x6A); // i32.add
    أصدر_مؤشر_المكدس_ويب_أسمبلي(ح, 0x24); // global.set __stack_pointer
}

نوع خطة_دالة_جارية_ويب_أسمبلي = {
    الخطة: خطة_دالة_واجهة
};

عرف أصدر_إرجاع_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_دالة_واجهة,
    القيمة: اختياري معرف_قيمة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { }
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع المعرف: معرف_قيمة_مسير;
        طابق القيمة مع | اختياري.موجود(م) -> { المعرف := م; } | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع العنوان: طبيعي;
        طابق (*ح).عنوان_الناتج مع | اختياري.موجود(م) -> { العنوان := م; } | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
        طابق قيمة_ويب_أسمبلي(ح, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
        طابق خزن_قيمة_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع, العنوان, 0, التمثيل) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
    }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        دع المعرف: معرف_قيمة_مسير;
        طابق القيمة مع | اختياري.موجود(م) -> { المعرف := م; } | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة()); };
        دع التمثيل: تمثيل_قيمة_ويب_أسمبلي;
        طابق قيمة_ويب_أسمبلي(ح, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التمثيل := ت; };
        إذا (التمثيل.عنوان) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).الناتج.النوع)); };
        اقرأ_محلي_ويب_أسمبلي(ح, التمثيل.المحلي);
    }
    | موقع_تمرير_واجهة.مجزأ(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم((*الخطة).الناتج.النوع)); };
    أصدر_خاتمة_ويب_أسمبلي(ح);
    أصدر_ويب_أسمبلي(ح, 0x0F); // return
    أرجع اختياري.لا_شيء();
}

// Block arguments as one parallel copy: push every argument, then assign the
// target parameters in reverse.
عرف أصدر_حجج_حافة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    دع العرض: عرض_كتلة_مسير;
    طابق ابحث_كتلة_مسير(المسير, (*الحافة).الهدف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة((*الحافة).الهدف)); }
    | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> { العرض := ع; };
    دع العدد: طبيعي = الطول((*الحافة).الحجج) مثل طبيعي;
    إذا (العدد != العرض.عدد_المعاملات) { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.حافة_غير_صالحة()); };
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع الوجهات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق محلي_قيمة_ويب_أسمبلي(ح, (*الحافة).الحجج[ف]) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { اقرأ_محلي_ويب_أسمبلي(ح, م); };
        طابق معامل_كتلة_مسير_عند(المسير, (*الحافة).الهدف, ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.حافة_غير_صالحة()); }
        | اختياري.موجود(المعامل) -> {
            طابق محلي_قيمة_ويب_أسمبلي(ح, المعامل.المعرف) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(م) -> { ألحق(الوجهات, م); };
        };
        ف := ف + 1;
    }
    ف := العدد;
    طالما (ف > 0) {
        ف := ف - 1;
        اكتب_محلي_ويب_أسمبلي(ح, الوجهات[ف]);
    }
    أرجع اختياري.لا_شيء();
}

نوع مدخلات_بنية_ويب_أسمبلي = {
    البنية: بنية_تدفق_ويب_أسمبلي,
    الخطة: خطة_دالة_واجهة
};

عرف أصدر_فرع_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المدخلات: &مدخلات_بنية_ويب_أسمبلي,
    المصدر: طبيعي,
    الحافة: &حافة_مسير
): اختياري خطأ_اختيار_ويب_أسمبلي {
    طابق أصدر_حجج_حافة_ويب_أسمبلي(ح, المسير, الحافة) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    دع الوجهة: طبيعي = (*الحافة).الهدف.القيمة;
    دع البنية: &بنية_تدفق_ويب_أسمبلي = &(*المدخلات).البنية;
    إذا ((*البنية).رقم_الترتيب[الوجهة] <= (*البنية).رقم_الترتيب[المصدر]) {
        طابق عمق_فرع_ويب_أسمبلي(ح, الوجهة, صواب) مع
        | اختياري.موجود(العمق) -> { أصدر_ويب_أسمبلي(ح, 0x0C); أصدر_ليب_ويب_أسمبلي(ح, العمق); أرجع اختياري.لا_شيء(); } // br
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.تدفق_غير_قابل_للاختزال((*ح).المعرف)); };
    };
    إذا ((*البنية).عقدة_دمج[الوجهة]) {
        طابق عمق_فرع_ويب_أسمبلي(ح, الوجهة, خطأ) مع
        | اختياري.موجود(العمق) -> { أصدر_ويب_أسمبلي(ح, 0x0C); أصدر_ليب_ويب_أسمبلي(ح, العمق); أرجع اختياري.لا_شيء(); } // br
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.تدفق_غير_قابل_للاختزال((*ح).المعرف)); };
    };
    أرجع أصدر_شجرة_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الوجهة);
}

عرف أصدر_شجرة_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المدخلات: &مدخلات_بنية_ويب_أسمبلي,
    الكتلة: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    إذا ((*المدخلات).البنية.رأس_حلقة[الكتلة]) {
        أصدر_ويب_أسمبلي(ح, 0x03); أصدر_ويب_أسمبلي(ح, 0x40); // loop
        ادفع_بنية_ويب_أسمبلي(ح, إطار_بنية_ويب_أسمبلي.حلقة(الكتلة));
        طابق أصدر_ضمن_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, 0) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        أزل_بنية_ويب_أسمبلي(ح);
        أصدر_ويب_أسمبلي(ح, 0x0B); // end
        أرجع اختياري.لا_شيء();
    };
    أرجع أصدر_ضمن_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, 0);
}

// Code for block الكتلة wrapped in one `block` per merge child (highest RPO
// outermost); after each `block` ends, the merge child's own subtree.
عرف أصدر_ضمن_ويب_أسمبلي(
    ح: &متغير حالة_اختيار_ويب_أسمبلي,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المدخلات: &مدخلات_بنية_ويب_أسمبلي,
    الكتلة: طبيعي,
    البداية: طبيعي
): اختياري خطأ_اختيار_ويب_أسمبلي {
    إذا (البداية < (الطول((*المدخلات).البنية.أطفال_الدمج[الكتلة]) مثل طبيعي)) {
        دع الطفل: طبيعي = (*المدخلات).البنية.أطفال_الدمج[الكتلة][البداية];
        أصدر_ويب_أسمبلي(ح, 0x02); أصدر_ويب_أسمبلي(ح, 0x40); // block
        ادفع_بنية_ويب_أسمبلي(ح, إطار_بنية_ويب_أسمبلي.كتلة(الطفل));
        طابق أصدر_ضمن_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, البداية + 1) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        أزل_بنية_ويب_أسمبلي(ح);
        أصدر_ويب_أسمبلي(ح, 0x0B); // end
        أرجع أصدر_شجرة_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الطفل);
    };
    دع المعرف: معرف_كتلة_مسير = معرف_كتلة_مسير_من((*ح).المعرف, الكتلة);
    دع العرض: عرض_كتلة_مسير;
    طابق ابحث_كتلة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(المعرف)); }
    | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> { العرض := ع; };
    دع ت: متغير طبيعي = 0;
    طالما (ت < العرض.عدد_التعليمات) {
        طابق تعليمة_مسير_عند(المسير, المعرف, ت) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(المعرف)); }
        | اختياري.موجود(التعليمة) -> {
            دع بداية_الأصل: طبيعي = الطول((*ح).الشفرة) مثل طبيعي;
            طابق اخفض_تعليمة_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, &التعليمة) مع
            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
            | اختياري.لا_شيء -> { };
            دع نهاية_الأصل: طبيعي = الطول((*ح).الشفرة) مثل طبيعي;
            طابق التعليمة.الأصل مع
            | اختياري.موجود(الأصل) -> {
                إذا (نهاية_الأصل > بداية_الأصل) {
                    دع المدى: مدى_شفرة_آلة_بأصل = {
                        الدالة: معرف_دالة_منتقاة_من_مسير((*ح).المعرف),
                        إزاحة_بايت: بداية_الأصل,
                        حجم_بايت: نهاية_الأصل - بداية_الأصل,
                        الأصل: الأصل,
                        موقع_التصحيح: التعليمة.موقع_التصحيح,
                        نطاق_التصحيح: التعليمة.نطاق_التصحيح
                    };
                    ألحق((*ح).الأصول, المدى);
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ت := ت + 1;
    }
    دع المنهي: منهي_مسير;
    طابق منهي_كتلة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_منهي_مسير.موجود(م) -> { المنهي := م; }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(المعرف)); };
    طابق المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        أرجع أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &الحافة);
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        طابق محلي_قيمة_ويب_أسمبلي(ح, الشرط) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(م) -> { اقرأ_محلي_ويب_أسمبلي(ح, م); };
        أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if
        ادفع_بنية_ويب_أسمبلي(ح, إطار_بنية_ويب_أسمبلي.شرط());
        طابق أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &عند_الصواب) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        أصدر_ويب_أسمبلي(ح, 0x05); // else
        طابق أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &عند_الخطأ) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        أزل_بنية_ويب_أسمبلي(ح);
        أصدر_ويب_أسمبلي(ح, 0x0B); // end
    }
    | منهي_مسير.فرع_متعدد(الفرع) -> {
        دع المحلي: طبيعي;
        طابق محلي_قيمة_ويب_أسمبلي(ح, الفرع.المميز) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(المعرف) -> { المحلي := المعرف; };
        دع نوع_المميز: معرف_نوع;
        طابق نوع_قيمة_مسير_ويب_أسمبلي(المسير, الفرع.المميز) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(المعرف) -> { نوع_المميز := المعرف; };
        دع واسع: متغير منطقي = خطأ;
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, نوع_المميز) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> { واسع := الوصف.البتات == 64; }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(نوع_المميز)); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
            دع الحالة: &حالة_فرع_متعدد_مسير = &الفرع.الحالات[ف];
            اقرأ_محلي_ويب_أسمبلي(ح, المحلي);
            إذا (واسع) {
                أصدر_ثابت64_ويب_أسمبلي(ح, (*الحالة).الوسم مثل عدد);
                أصدر_ويب_أسمبلي(ح, 0x51); // i64.eq
            } وإلا {
                أصدر_ثابت_بتات32_ويب_أسمبلي(ح, (*الحالة).الوسم);
                أصدر_ويب_أسمبلي(ح, 0x46); // i32.eq
            };
            أصدر_ويب_أسمبلي(ح, 0x04); أصدر_ويب_أسمبلي(ح, 0x40); // if
            ادفع_بنية_ويب_أسمبلي(ح, إطار_بنية_ويب_أسمبلي.شرط());
            طابق أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &(*الحالة).الحافة) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            أزل_بنية_ويب_أسمبلي(ح);
            أصدر_ويب_أسمبلي(ح, 0x0B); // end
            ف := ف + 1;
        }
        أرجع أصدر_فرع_ويب_أسمبلي(ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, المدخلات, الكتلة, &الفرع.الافتراضي);
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        أرجع أصدر_إرجاع_ويب_أسمبلي(ح, الحقائق, الهدف, سجل_التخطيط, &(*المدخلات).الخطة, القيمة);
    }
    | منهي_مسير.فخ -> { أصدر_ويب_أسمبلي(ح, 0x00); }; // unreachable
    أرجع اختياري.لا_شيء();
}

// ------------------------------------------------------------ functions --

عرف شفرة_دالة_ويب_أسمبلي(
    ح: حالة_اختيار_ويب_أسمبلي,
    الهوية: هوية_دالة_ويب_أسمبلي,
    التوقيع: طبيعي
): دالة_ويب_أسمبلي_مشفرة {
    طابق ح مع
    | {
        المعرف: _, الشفرة: الشفرة_الأولية, الإزاحات: الإزاحات, عدد_المعاملات: _,
        المحليات: المحليات, القيم: القيم, حجم_الإطار: حجم_الإطار, محلي_الإطار: _,
        رقع_الإطار: رقع_الإطار, مؤقتات_ص32: _, عمق_ص32: _, مؤقتات_ص64: _, عمق_ص64: _,
        بيئة_الإغلاق: _, عنوان_الناتج: _, السياق: _, عمق_السياق: _,
        البيانات_الثابتة: البيانات_الثابتة, الأصول: الأصول, موضع_مستقل: _
    } -> {
        // Patch every frame-size field with the 16-byte-aligned final size.
        دع الشفرة: متغير متجه ط8 = الشفرة_الأولية;
        دع الحجم: طبيعي = محاذاة_لأعلى(حجم_الإطار, 16);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(رقع_الإطار) مثل طبيعي)) {
            اكتب_سليب_مبطن_ويب_أسمبلي_عند(&متغير الشفرة, رقع_الإطار[ف], الحجم مثل عدد);
            ف := ف + 1;
        }
        دع مواقع_القيم: متغير متجه موقع_قيمة_مشفرة_ويب_أسمبلي = [];
        ف := 0;
        طالما (ف < (الطول(القيم) مثل طبيعي)) {
            طابق القيم[ف] مع
            | اختياري.موجود(التمثيل) -> {
                دع الموقع: موقع_قيمة_مشفرة_ويب_أسمبلي = {
                    القيمة: ف, المحلي: التمثيل.المحلي, عنوان: التمثيل.عنوان
                };
                ألحق(مواقع_القيم, الموقع);
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        دع الدالة: دالة_ويب_أسمبلي_مشفرة = {
            الهوية: الهوية,
            التوقيع: التوقيع,
            المحليات: المحليات,
            الشفرة: الشفرة,
            الإزاحات: الإزاحات,
            البيانات_الثابتة: البيانات_الثابتة,
            الأصول: الأصول,
            مواقع_القيم: مواقع_القيم
        };
        أرجع الدالة;
    };
}

عام عرف انتق_دالة_ويب_أسمبلي(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المعرف: معرف_دالة_مسير
): نتيجة دالة_ويب_أسمبلي_مشفرة, خطأ_اختيار_ويب_أسمبلي {
    دع العرض: عرض_دالة_مسير;
    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(المعرف)); }
    | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
    دع الخطة: خطة_دالة_واجهة;
    طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(المعرف)); }
    | نتيجة.نجح(خ) -> { الخطة := خ; };
    دع له_بيئة: منطقي = !دالة_دخول_ويب_أسمبلي(السياق, المعرف);
    دع التوقيع: توقيع_ويب_أسمبلي;
    طابق توقيع_خطة_ويب_أسمبلي(الحقائق, &الخطة, له_بيئة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ت) -> { التوقيع := ت; };
    دع فهرس_التوقيع: طبيعي = ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع);
    دع البنية: بنية_تدفق_ويب_أسمبلي;
    طابق حلل_تدفق_ويب_أسمبلي(&(*المسير).المسير.الدوال[المعرف.القيمة]) مع
    | نتيجة_بنية_تدفق_ويب_أسمبلي.نجحت(ب) -> { البنية := ب; }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.تدفق_غير_قابل_للاختزال(المعرف)); };
    دع ح: متغير حالة_اختيار_ويب_أسمبلي = حالة_اختيار_ويب_أسمبلي_جديدة(
        المعرف, الطول(التوقيع.المعاملات) مثل طبيعي
    );
    ح.موضع_مستقل := (*السياق).موضع_مستقل;
    // Parameter locals: [indirect result] [environment] ABI parameters.
    دع المعامل_التالي: متغير طبيعي = 0;
    طابق الخطة.الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        ح.عنوان_الناتج := اختياري.موجود(المعامل_التالي);
        المعامل_التالي := المعامل_التالي + 1;
    }
    | _ -> { };
    إذا (له_بيئة) {
        ح.بيئة_الإغلاق := اختياري.موجود(المعامل_التالي);
        المعامل_التالي := المعامل_التالي + 1;
    };
    // Prologue: reserve the frame (size patched at the end).
    ح.محلي_الإطار := محلي_جديد_ويب_أسمبلي(&متغير ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    أصدر_مؤشر_المكدس_ويب_أسمبلي(&متغير ح, 0x23); // global.get __stack_pointer
    أصدر_حجم_الإطار_ويب_أسمبلي(&متغير ح);
    أصدر_ويب_أسمبلي(&متغير ح, 0x6B); // i32.sub
    أصدر_محلي_ويب_أسمبلي(&متغير ح, 0x22, ح.محلي_الإطار); // local.tee
    أصدر_مؤشر_المكدس_ويب_أسمبلي(&متغير ح, 0x24); // global.set __stack_pointer
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض.عدد_المعاملات) {
        دع القيمة: عرض_قيمة_مسير;
        طابق معامل_دالة_مسير_عند(المسير, المعرف, ف) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(المعرف)); }
        | اختياري.موجود(ق) -> { القيمة := ق; };
        دع خطة_المعامل: &خطة_معامل_واجهة = &الخطة.المعاملات[ف];
        طابق (*خطة_المعامل).الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> {
            // Zero-sized: a scalar local (zero) or an empty frame slot.
            طابق صنف_نوع_ويب_أسمبلي(الحقائق, القيمة.النوع) مع
            | صنف_قيمة_ويب_أسمبلي.تجميعي -> {
                دع المكان: طبيعي = عنوان_إطار_جديد_ويب_أسمبلي(&متغير ح, 0, 1);
                اربط_ناتج_بمحلي_ويب_أسمبلي(&متغير ح, القيمة.المعرف, المكان, صواب);
            }
            | _ -> {
                طابق محلي_لنوع_ويب_أسمبلي(&متغير ح, الحقائق, القيمة.النوع) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(&متغير ح, القيمة.المعرف, ت); };
            };
        }
        | موقع_تمرير_واجهة.غير_مباشر(_) -> {
            طابق صنف_نوع_ويب_أسمبلي(الحقائق, القيمة.النوع) مع
            | صنف_قيمة_ويب_أسمبلي.سلمي(الوصف) -> {
                دع المحلي: طبيعي = محلي_جديد_ويب_أسمبلي(&متغير ح, الوصف.النوع);
                اقرأ_محلي_ويب_أسمبلي(&متغير ح, المعامل_التالي);
                أصدر_تحميل_سلمي_ويب_أسمبلي(&متغير ح, &الوصف, 0);
                اكتب_محلي_ويب_أسمبلي(&متغير ح, المحلي);
                اربط_ناتج_بمحلي_ويب_أسمبلي(&متغير ح, القيمة.المعرف, المحلي, خطأ);
            }
            | _ -> { اربط_ناتج_بمحلي_ويب_أسمبلي(&متغير ح, القيمة.المعرف, المعامل_التالي, صواب); };
            المعامل_التالي := المعامل_التالي + 1;
        }
        | موقع_تمرير_واجهة.مباشر(_) -> {
            اربط_ناتج_بمحلي_ويب_أسمبلي(&متغير ح, القيمة.المعرف, المعامل_التالي, خطأ);
            المعامل_التالي := المعامل_التالي + 1;
        }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(القيمة.النوع)); };
        ف := ف + 1;
    }
    // Block parameters receive their values on incoming edges.
    ف := 0;
    طالما (ف < العرض.عدد_الكتل) {
        دع الكتلة: معرف_كتلة_مسير = معرف_كتلة_مسير_من(المعرف, ف);
        طابق ابحث_كتلة_مسير(المسير, الكتلة) مع
        | نتيجة_بحث_كتلة_مسير.موجودة(عرض_الكتلة) -> {
            دع م: متغير طبيعي = 0;
            طالما (م < عرض_الكتلة.عدد_المعاملات) {
                طابق معامل_كتلة_مسير_عند(المسير, الكتلة, م) مع
                | اختياري.موجود(المعامل) -> {
                    طابق محلي_لنوع_ويب_أسمبلي(&متغير ح, الحقائق, المعامل.النوع) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(ت) -> { ضع_قيمة_ويب_أسمبلي(&متغير ح, المعامل.المعرف, ت); };
                }
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(الكتلة)); };
                م := م + 1;
            }
        }
        | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(الكتلة)); };
        ف := ف + 1;
    }
    دع المدخلات: مدخلات_بنية_ويب_أسمبلي = { البنية: البنية, الخطة: الخطة };
    دع المدخل: طبيعي = المدخلات.البنية.المدخل;
    طابق أصدر_شجرة_ويب_أسمبلي(&متغير ح, المسير, الحقائق, الهدف, سجل_التخطيط, السياق, &المدخلات, المدخل) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أصدر_ويب_أسمبلي(&متغير ح, 0x00); // unreachable (every path returned)
    أصدر_ويب_أسمبلي(&متغير ح, 0x0B); // end
    أرجع نتيجة.نجح(شفرة_دالة_ويب_أسمبلي(ح, هوية_دالة_ويب_أسمبلي.مسير(المعرف), فهرس_التوقيع));
}

// `_start` of a linked executable: run the language entry, then hand its
// status to the std process-exit provider (WASI proc_exit), as the LLVM
// provider's WASI start does: a wider status is truncated, a narrower one
// zero-extended, and the provider's integer operand sign-extends it.
عام عرف ابن_بدء_عملية_ويب_أسمبلي(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    الدخول: معرف_دالة_مسير,
    الخروج: معرف_دالة_مسير
): نتيجة دالة_ويب_أسمبلي_مشفرة, خطأ_اختيار_ويب_أسمبلي {
    دع خطة_الدخول: خطة_دالة_واجهة;
    طابق خطة_دالة_مسير_ويب_أسمبلي(المسير, الحقائق, الهدف, سجل_التخطيط, الدخول) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(خ) -> { خطة_الدخول := خ; };
    إذا ((الطول(خطة_الدخول.المعاملات) مثل طبيعي) != 0) { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(الدخول)); };
    دع خطة_الخروج: خطة_دالة_واجهة;
    طابق خطة_دالة_مسير_ويب_أسمبلي(المسير, الحقائق, الهدف, سجل_التخطيط, الخروج) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(خ) -> { خطة_الخروج := خ; };
    إذا ((الطول(خطة_الخروج.المعاملات) مثل طبيعي) != 1) { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_خروج_مفقود()); };
    دع وصف_الرمز: وصف_سلمي_ويب_أسمبلي;
    طابق خطة_الخروج.المعاملات[0].الموقع مع
    | موقع_تمرير_واجهة.مباشر(_) -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, خطة_الخروج.المعاملات[0].النوع) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> { وصف_الرمز := و; }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_خروج_مفقود()); };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_خروج_مفقود()); };
    إذا (وصف_الرمز.عائم) { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.مزود_خروج_مفقود()); };
    دع المعاملات: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع النواتج: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع التوقيع: توقيع_ويب_أسمبلي = { المعاملات: المعاملات, النواتج: النواتج };
    دع فهرس_التوقيع: طبيعي = ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع);
    دع ح: متغير حالة_اختيار_ويب_أسمبلي = حالة_اختيار_ويب_أسمبلي_جديدة(الدخول, 0);
    دع الحالة: طبيعي = محلي_جديد_ويب_أسمبلي(&متغير ح, نوع_قيمة_ويب_أسمبلي.صحيح32());
    أصدر_نداء_دالة_ويب_أسمبلي(&متغير ح, مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(الدخول)));
    طابق خطة_الدخول.الناتج.الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أصدر_ثابت32_ويب_أسمبلي(&متغير ح, 0); }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        طابق صنف_نوع_ويب_أسمبلي(الحقائق, خطة_الدخول.الناتج.النوع) مع
        | صنف_قيمة_ويب_أسمبلي.سلمي(و) -> {
            إذا (و.عائم) { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(الدخول)); };
            إذا (و.البتات == 64) { أصدر_ويب_أسمبلي(&متغير ح, 0xA7); } // i32.wrap_i64
            وإلا إذا (و.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(&متغير ح, و.البتات, خطأ); };
        }
        | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(الدخول)); };
    }
    | _ -> { أرجع نتيجة.خطأ(خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(الدخول)); };
    اكتب_محلي_ويب_أسمبلي(&متغير ح, الحالة);
    أصدر_ثابت32_ويب_أسمبلي(&متغير ح, 0); // the provider's closure environment
    اقرأ_محلي_ويب_أسمبلي(&متغير ح, الحالة);
    إذا (وصف_الرمز.البتات == 64) { أصدر_ويب_أسمبلي(&متغير ح, 0xAC); } // i64.extend_i32_s
    وإلا إذا (وصف_الرمز.البتات < 32) { أصدر_تطبيع32_ويب_أسمبلي(&متغير ح, وصف_الرمز.البتات, وصف_الرمز.موقع); };
    أصدر_نداء_دالة_ويب_أسمبلي(&متغير ح, مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(الخروج)));
    أصدر_ويب_أسمبلي(&متغير ح, 0x00); // unreachable: proc_exit never returns
    أصدر_ويب_أسمبلي(&متغير ح, 0x0B); // end
    أرجع نتيجة.نجح(شفرة_دالة_ويب_أسمبلي(ح, هوية_دالة_ويب_أسمبلي.بدء_العملية(), فهرس_التوقيع));
}

// Loader initializer of a standalone object: void() calling the MSIR module
// initializer with a null closure environment.
عام عرف ابن_منشئ_وحدة_ويب_أسمبلي(
    السياق: &متغير سياق_وحدة_ويب_أسمبلي,
    المهيئ: معرف_دالة_مسير
): دالة_ويب_أسمبلي_مشفرة {
    دع المعاملات: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع النواتج: متجه نوع_قيمة_ويب_أسمبلي = [];
    دع التوقيع: توقيع_ويب_أسمبلي = { المعاملات: المعاملات, النواتج: النواتج };
    دع فهرس_التوقيع: طبيعي = ضمن_توقيع_ويب_أسمبلي(&متغير (*السياق).التواقيع, &التوقيع);
    دع ح: متغير حالة_اختيار_ويب_أسمبلي = حالة_اختيار_ويب_أسمبلي_جديدة(المهيئ, 0);
    أصدر_ثابت32_ويب_أسمبلي(&متغير ح, 0);
    أصدر_نداء_دالة_ويب_أسمبلي(&متغير ح, مرجع_رمز_كائن.دالة(معرف_دالة_منتقاة_من_مسير(المهيئ)));
    أصدر_ويب_أسمبلي(&متغير ح, 0x0B); // end
    أرجع شفرة_دالة_ويب_أسمبلي(ح, هوية_دالة_ويب_أسمبلي.منشئ_الوحدة(), فهرس_التوقيع);
}
