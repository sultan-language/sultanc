// WebAssembly binary encoding primitives for the native wasm32 path: value
// types, LEB128 integers (including the fixed 5-byte padded forms that the
// object-file relocations rewrite in place) and instruction memory operands.
// Opcode numbers are written by the selector with their mnemonic in a comment;
// this file owns only the byte-level encodings shared by selector and writer.

عام نوع نوع_قيمة_ويب_أسمبلي =
    | صحيح32
    | صحيح64
    | عائم32
    | عائم64
;

عام عرف رمز_نوع_قيمة_ويب_أسمبلي(النوع: نوع_قيمة_ويب_أسمبلي): غير_موقع {
    طابق النوع مع
    | نوع_قيمة_ويب_أسمبلي.صحيح32 -> { أرجع 0x7F; }
    | نوع_قيمة_ويب_أسمبلي.صحيح64 -> { أرجع 0x7E; }
    | نوع_قيمة_ويب_أسمبلي.عائم32 -> { أرجع 0x7D; }
    | نوع_قيمة_ويب_أسمبلي.عائم64 -> { أرجع 0x7C; };
}

عام عرف نوعا_قيمة_ويب_أسمبلي_متساويان(أ: نوع_قيمة_ويب_أسمبلي, ب: نوع_قيمة_ويب_أسمبلي): منطقي {
    أرجع رمز_نوع_قيمة_ويب_أسمبلي(أ) == رمز_نوع_قيمة_ويب_أسمبلي(ب);
}

عام عرف ألحق_بايت_ويب_أسمبلي(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق(*البايتات, (القيمة % 256) مثل غ8);
}

عام عرف ألحق_ليب_ويب_أسمبلي(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع الجزء: غير_موقع = الباقي % 128;
        الباقي := الباقي / 128;
        لو (الباقي == 0) {
            ألحق_بايت_ويب_أسمبلي(البايتات, الجزء);
            مستمر := خطأ;
        } وإلا {
            ألحق_بايت_ويب_أسمبلي(البايتات, الجزء + 128);
        };
    }
}

عام عرف ألحق_سليب_ويب_أسمبلي(البايتات: &متغير متجه غ8, القيمة: عدد): فراغ {
    دع الباقي: متغير عدد = القيمة;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع الجزء_الموقع: متغير عدد = الباقي % 128;
        لو (الجزء_الموقع < 0) { الجزء_الموقع := الجزء_الموقع + 128; };
        دع الجزء: غير_موقع = الجزء_الموقع مثل غير_موقع;
        الباقي := (الباقي - الجزء_الموقع) / 128;
        دع بت_الإشارة: منطقي = الجزء >= 64;
        لو ((الباقي == 0 && !بت_الإشارة) || (الباقي == -1 && بت_الإشارة)) {
            ألحق_بايت_ويب_أسمبلي(البايتات, الجزء);
            مستمر := خطأ;
        } وإلا {
            ألحق_بايت_ويب_أسمبلي(البايتات, الجزء + 128);
        };
    }
}

// The signed 32-bit value whose two's-complement bit pattern is البتات (the low
// 32 bits): the operand form of i32.const for a u32 pattern.
عام عرف قيمة_موقعة_32_من_بتات(البتات: غير_موقع): عدد {
    دع المنخفض: غير_موقع = البتات % 4294967296;
    لو (المنخفض >= 2147483648) {
        أرجع (المنخفض مثل عدد) - 4294967296;
    };
    أرجع المنخفض مثل عدد;
}

// Fixed-width (5-byte) LEB128 fields: relocations rewrite them in place, and a
// frame size not known until the function body is complete is patched later.
عام عرف ألحق_ليب_مبطن_ويب_أسمبلي(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 5) {
        دع الجزء: غير_موقع = الباقي % 128;
        الباقي := الباقي / 128;
        لو (ف < 4) { ألحق_بايت_ويب_أسمبلي(البايتات, الجزء + 128); }
        وإلا { ألحق_بايت_ويب_أسمبلي(البايتات, الجزء); };
        ف := ف + 1;
    }
}

عام عرف ألحق_سليب_مبطن_ويب_أسمبلي(البايتات: &متغير متجه غ8, القيمة: عدد): فراغ {
    // Two's complement of a 35-bit field holds every signed 32-bit value.
    دع البتات: متغير غير_موقع = 0;
    لو (القيمة < 0) {
        البتات := (34359738368 + القيمة) مثل غير_موقع;
    } وإلا {
        البتات := القيمة مثل غير_موقع;
    };
    ألحق_ليب_مبطن_ويب_أسمبلي(البايتات, البتات);
}

عام عرف اكتب_ليب_مبطن_ويب_أسمبلي_عند(
    البايتات: &متغير متجه غ8, الموضع: غير_موقع, القيمة: غير_موقع
): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 5) {
        دع الجزء: غير_موقع = الباقي % 128;
        الباقي := الباقي / 128;
        لو (ف < 4) { (*البايتات)[الموضع + ف] := (الجزء + 128) مثل غ8; }
        وإلا { (*البايتات)[الموضع + ف] := الجزء مثل غ8; };
        ف := ف + 1;
    }
}

عام عرف اكتب_سليب_مبطن_ويب_أسمبلي_عند(
    البايتات: &متغير متجه غ8, الموضع: غير_موقع, القيمة: عدد
): فراغ {
    دع البتات: متغير غير_موقع = 0;
    لو (القيمة < 0) {
        البتات := (34359738368 + القيمة) مثل غير_موقع;
    } وإلا {
        البتات := القيمة مثل غير_موقع;
    };
    اكتب_ليب_مبطن_ويب_أسمبلي_عند(البايتات, الموضع, البتات);
}

عام عرف ألحق_اسم_ويب_أسمبلي(البايتات: &متغير متجه غ8, الاسم: &متجه غ8): فراغ {
    ألحق_ليب_ويب_أسمبلي(البايتات, الطول(*الاسم) مثل غير_موقع);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الاسم) مثل غير_موقع)) {
        ألحق(*البايتات, (*الاسم)[ف]);
        ف := ف + 1;
    }
}

عام عرف ألحق_بايتات_ويب_أسمبلي(البايتات: &متغير متجه غ8, المصدر: &متجه غ8): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(*البايتات, (*المصدر)[ف]);
        ف := ف + 1;
    }
}

// Little-endian fixed-width value (f32.const / f64.const immediates, data).
عام عرف ألحق_قيمة_صغيرة_الطرف_ويب_أسمبلي(
    البايتات: &متغير متجه غ8, القيمة: غير_موقع, الحجم: غير_موقع
): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        ألحق_بايت_ويب_أسمبلي(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

// Memory operand of a load/store: log2 alignment hint, then byte offset.
عام عرف ألحق_معامل_ذاكرة_ويب_أسمبلي(
    البايتات: &متغير متجه غ8, الحجم: غير_موقع, الإزاحة: غير_موقع
): فراغ {
    دع لوغ: متغير غير_موقع = 0;
    لو (الحجم >= 8) { لوغ := 3; } وإلا لو (الحجم >= 4) { لوغ := 2; } وإلا لو (الحجم >= 2) { لوغ := 1; };
    ألحق_ليب_ويب_أسمبلي(البايتات, لوغ);
    ألحق_ليب_ويب_أسمبلي(البايتات, الإزاحة);
}
