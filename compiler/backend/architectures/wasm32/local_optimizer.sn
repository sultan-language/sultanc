استورد compiler.backend.architectures.wasm32.encoder;
استورد compiler.backend.architectures.wasm32.encoded_code;
استورد compiler.backend.codegen.selected_code_core;

// The local optimizer of the native wasm32 path. The selector gives every
// MSIR value a local of its own and moves values between them with
// local.get/local.set, which is simple and correct but leaves most of a
// function's code as local traffic. This pass rewrites one finished function
// body, the work Binaryen's coalesce-locals and simplify-locals passes and
// LLVM's WebAssembly register coloring and stackification do:
//
//   1. Constants. A local written once, by `const; local.set`, and not live
//      at entry holds that constant wherever it is read: each read becomes
//      the constant and the local goes away.
//   2. Coalescing. Liveness over the function's control-flow graph gives the
//      locals that hold a value at the same time (they interfere; a copy
//      `local.get a; local.set b` does not make a and b interfere, and every
//      local live at entry interferes with the others, since entry is where
//      parameters and the zero of every other local are defined). Locals of
//      one type that do not interfere share one local, a copy's two locals
//      first. A copy whose two sides now share a local is deleted.
//   3. Stack values. `local.set x; local.get x` keeps the value on the
//      operand stack (`local.tee x` if x is read again later), a
//      `local.tee x` whose x is never read again becomes nothing, and a
//      `local.set x` whose x is never read again becomes `drop`.
//
// Everything else in the body is kept byte for byte, so relocations, origin
// ranges (for DWARF line tables) and value locations (DWARF variables) are
// moved with the instruction they belong to. A body with an instruction the
// pass does not decode is returned unchanged.

// --------------------------------------------------------- decoded body --

نوع تعليمة_محسن_ويب_أسمبلي = {
    // The opcode; 0xFC prefixed instructions as 0xFC00 + sub-opcode.
    الرمز: طبيعي,
    // The local of local.get/local.set/local.tee, else 0.
    المحلي: طبيعي,
    // The decoded instruction whose bytes this one copies (its control
    // facts too); عدد_المفكوكة for local.get/set/tee and drop written anew.
    الأصل: طبيعي,
    // The decoded instruction whose place this one takes: where relocations
    // and origin ranges of that instruction now point.
    الموقع: طبيعي
};

نوع جسم_مفكوك_ويب_أسمبلي = {
    // Byte offset of each decoded instruction, then the body's length.
    البدايات: متجه طبيعي,
    الرموز: متجه طبيعي,
    المحليات: متجه طبيعي,
    // br/br_if: the relative depth; br_table: where its targets start in
    // الأهداف (the default last).
    الأعماق: متجه طبيعي,
    عدد_الأهداف: متجه طبيعي,
    الأهداف: متجه طبيعي,
    // An i32/i64 constant with no relocation in its bytes.
    ثابت_حر: متجه منطقي
};

عرف متجه_أصفار_محسن(العدد: طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    احجز_سعة(الناتج, العدد);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الناتج, 0); ف := ف + 1; }
    أرجع الناتج;
}

// An unsigned LEB128 at *الموضع, or none when it runs past the end.
عرف اقرأ_ليب_محسن(الشفرة: &متجه ط8, الموضع: &متغير طبيعي): اختياري طبيعي {
    دع القيمة: متغير طبيعي = 0;
    دع الإزاحة: متغير طبيعي = 0;
    دع طول_الشفرة: طبيعي = الطول(*الشفرة) مثل طبيعي;
    طالما (صواب) {
        إذا (*الموضع >= طول_الشفرة || الإزاحة > 63) { أرجع اختياري.لا_شيء(); };
        دع البايت: طبيعي = (*الشفرة)[*الموضع] مثل طبيعي;
        *الموضع := *الموضع + 1;
        // Only the bits that fit in 64 (a signed constant's last byte
        // carries sign bits past them).
        دع الجزء: متغير طبيعي = البايت & 0x7F;
        إذا (الإزاحة > 57) { الجزء := الجزء & (((1 مثل طبيعي) << (64 - الإزاحة)) - 1); };
        القيمة := القيمة | (الجزء << الإزاحة);
        الإزاحة := الإزاحة + 7;
        إذا (البايت < 0x80) { أرجع اختياري.موجود(القيمة); };
    }
    أرجع اختياري.لا_شيء();
}

// Skips an unsigned or signed LEB128; false when it runs past the end.
عرف تخط_ليب_محسن(الشفرة: &متجه ط8, الموضع: &متغير طبيعي): منطقي {
    طابق اقرأ_ليب_محسن(الشفرة, الموضع) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Decodes every instruction of the body. Only the instructions the wasm32
// selector emits are known; anything else makes the result none.
عرف فك_جسم_محسن_ويب_أسمبلي(الشفرة: &متجه ط8): اختياري جسم_مفكوك_ويب_أسمبلي {
    دع البدايات: متغير متجه طبيعي = [];
    دع الرموز: متغير متجه طبيعي = [];
    دع المحليات: متغير متجه طبيعي = [];
    دع الأعماق: متغير متجه طبيعي = [];
    دع عدد_الأهداف: متغير متجه طبيعي = [];
    دع الأهداف: متغير متجه طبيعي = [];
    دع ثابت_حر: متغير متجه منطقي = [];
    دع طول_الشفرة: طبيعي = الطول(*الشفرة) مثل طبيعي;
    // About one instruction per two bytes.
    دع التقدير: طبيعي = طول_الشفرة / 2 + 1;
    احجز_سعة(البدايات, التقدير + 1);
    احجز_سعة(الرموز, التقدير);
    احجز_سعة(المحليات, التقدير);
    احجز_سعة(الأعماق, التقدير);
    احجز_سعة(عدد_الأهداف, التقدير);
    احجز_سعة(ثابت_حر, التقدير);
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < طول_الشفرة) {
        ألحق(البدايات, الموضع);
        دع الرمز: متغير طبيعي = (*الشفرة)[الموضع] مثل طبيعي;
        الموضع := الموضع + 1;
        دع المحلي: متغير طبيعي = 0;
        دع العمق: متغير طبيعي = 0;
        دع العدد: متغير طبيعي = 0;
        دع ثابت: متغير منطقي = خطأ;
        دع سليم: متغير منطقي = صواب;
        إذا (الرمز == 0x02 || الرمز == 0x03 || الرمز == 0x04) {
            // Block type: empty (0x40), a value type, or a type index.
            إذا (الموضع >= طول_الشفرة) { أرجع اختياري.لا_شيء(); };
            دع البايت: طبيعي = (*الشفرة)[الموضع] مثل طبيعي;
            إذا (البايت == 0x40 || (البايت >= 0x7C && البايت <= 0x7F)) { الموضع := الموضع + 1; }
            وإلا { سليم := تخط_ليب_محسن(الشفرة, &متغير الموضع); };
        } وإلا إذا (الرمز == 0x0C || الرمز == 0x0D) {
            طابق اقرأ_ليب_محسن(الشفرة, &متغير الموضع) مع
            | اختياري.موجود(ع) -> { العمق := ع; }
            | اختياري.لا_شيء -> { سليم := خطأ; };
        } وإلا إذا (الرمز == 0x0E) {
            طابق اقرأ_ليب_محسن(الشفرة, &متغير الموضع) مع
            | اختياري.موجود(ن) -> { العدد := ن + 1; }
            | اختياري.لا_شيء -> { سليم := خطأ; };
            العمق := الطول(الأهداف) مثل طبيعي;
            دع ف: متغير طبيعي = 0;
            طالما (سليم && ف < العدد) {
                طابق اقرأ_ليب_محسن(الشفرة, &متغير الموضع) مع
                | اختياري.موجود(ع) -> { ألحق(الأهداف, ع); }
                | اختياري.لا_شيء -> { سليم := خطأ; };
                ف := ف + 1;
            }
        } وإلا إذا (الرمز == 0x20 || الرمز == 0x21 || الرمز == 0x22) {
            طابق اقرأ_ليب_محسن(الشفرة, &متغير الموضع) مع
            | اختياري.موجود(م) -> { المحلي := م; }
            | اختياري.لا_شيء -> { سليم := خطأ; };
        } وإلا إذا (الرمز == 0x10 || الرمز == 0x23 || الرمز == 0x24) {
            سليم := تخط_ليب_محسن(الشفرة, &متغير الموضع);
        } وإلا إذا (الرمز == 0x11 || (الرمز >= 0x28 && الرمز <= 0x3E)) {
            // call_indirect type table; a memory access align offset.
            سليم := تخط_ليب_محسن(الشفرة, &متغير الموضع) && تخط_ليب_محسن(الشفرة, &متغير الموضع);
        } وإلا إذا (الرمز == 0x3F || الرمز == 0x40) {
            الموضع := الموضع + 1;
        } وإلا إذا (الرمز == 0x41 || الرمز == 0x42) {
            سليم := تخط_ليب_محسن(الشفرة, &متغير الموضع);
            ثابت := صواب;
        } وإلا إذا (الرمز == 0x43) {
            الموضع := الموضع + 4;
        } وإلا إذا (الرمز == 0x44) {
            الموضع := الموضع + 8;
        } وإلا إذا (الرمز == 0xFC) {
            طابق اقرأ_ليب_محسن(الشفرة, &متغير الموضع) مع
            | اختياري.موجود(ف) -> {
                إذا (ف == 10) { الموضع := الموضع + 2; } // memory.copy
                وإلا إذا (ف == 11) { الموضع := الموضع + 1; } // memory.fill
                وإلا { سليم := خطأ; };
                الرمز := 0xFC00 + ف;
            }
            | اختياري.لا_شيء -> { سليم := خطأ; };
        } وإلا إذا (!(الرمز == 0x00 || الرمز == 0x01 || الرمز == 0x05 || الرمز == 0x0B || الرمز == 0x0F
                      || الرمز == 0x1A || الرمز == 0x1B || (الرمز >= 0x45 && الرمز <= 0xC4))) {
            سليم := خطأ;
        };
        إذا (!سليم || الموضع > طول_الشفرة) { أرجع اختياري.لا_شيء(); };
        ألحق(الرموز, الرمز);
        ألحق(المحليات, المحلي);
        ألحق(الأعماق, العمق);
        ألحق(عدد_الأهداف, العدد);
        ألحق(ثابت_حر, ثابت);
    }
    ألحق(البدايات, طول_الشفرة);
    دع المفكوك: جسم_مفكوك_ويب_أسمبلي = {
        البدايات: البدايات, الرموز: الرموز, المحليات: المحليات, الأعماق: الأعماق,
        عدد_الأهداف: عدد_الأهداف, الأهداف: الأهداف, ثابت_حر: ثابت_حر
    };
    أرجع اختياري.موجود(المفكوك);
}

// The decoded instruction whose bytes hold relocation position الموضع.
عرف تعليمة_عند_موضع_محسن(البدايات: &متجه طبيعي, الموضع: طبيعي): طبيعي {
    دع أ: متغير طبيعي = 0;
    دع ب: متغير طبيعي = (الطول(*البدايات) مثل طبيعي) - 1;
    // البدايات[أ] <= الموضع < البدايات[ب]
    طالما (ب - أ > 1) {
        دع م: طبيعي = (أ + ب) / 2;
        إذا ((*البدايات)[م] <= الموضع) { أ := م; } وإلا { ب := م; };
    }
    أرجع أ;
}

// ------------------------------------------------------- control flow --

// Basic blocks of a program (a list of instructions), with successors.
نوع كتل_محسن_ويب_أسمبلي = {
    البدايات: متجه طبيعي,
    النهايات: متجه طبيعي,
    التوالي: متجه متجه طبيعي
};

نوع إطار_تحكم_محسن = {
    // 0 the function, 1 block, 2 loop, 3 if.
    النوع: طبيعي,
    // loop: its header block.
    الرأس: طبيعي,
    // if: the block that ends with the condition, until `else` (none after).
    الشرط: اختياري طبيعي,
    // Blocks that jump to the end (block, if).
    القفزات: متجه طبيعي
};

عرف كتلة_جديدة_محسن(الكتل: &متغير كتل_محسن_ويب_أسمبلي, البداية: طبيعي): طبيعي {
    ألحق((*الكتل).البدايات, البداية);
    ألحق((*الكتل).النهايات, البداية);
    دع التوالي: متجه طبيعي = [];
    ألحق((*الكتل).التوالي, التوالي);
    أرجع (الطول((*الكتل).البدايات) مثل طبيعي) - 1;
}

عرف ادفع_إطار_محسن(الإطارات: &متغير متجه إطار_تحكم_محسن, النوع: طبيعي, الرأس: طبيعي, الشرط: اختياري طبيعي): فراغ {
    دع القفزات: متجه طبيعي = [];
    دع الإطار: إطار_تحكم_محسن = { النوع: النوع, الرأس: الرأس, الشرط: الشرط, القفزات: القفزات };
    ألحق(*الإطارات, الإطار);
}

// A branch from block القافزة to the target `العمق` frames out.
عرف اقفز_محسن(
    الكتل: &متغير كتل_محسن_ويب_أسمبلي,
    الإطارات: &متغير متجه إطار_تحكم_محسن,
    القافزة: طبيعي,
    العمق: طبيعي
): فراغ {
    دع العدد: طبيعي = الطول(*الإطارات) مثل طبيعي;
    إذا (العمق >= العدد) { أرجع; };
    دع ف: طبيعي = العدد - 1 - العمق;
    دع النوع: طبيعي = (*الإطارات)[ف].النوع;
    إذا (النوع == 2) { ألحق((*الكتل).التوالي[القافزة], (*الإطارات)[ف].الرأس); }
    وإلا إذا (النوع != 0) { ألحق((*الإطارات)[ف].القفزات, القافزة); };
}

عرف ابن_كتل_محسن(
    البرنامج: &متجه تعليمة_محسن_ويب_أسمبلي,
    المفكوك: &جسم_مفكوك_ويب_أسمبلي
): كتل_محسن_ويب_أسمبلي {
    دع البدايات: متجه طبيعي = [];
    دع النهايات: متجه طبيعي = [];
    دع التوالي: متجه متجه طبيعي = [];
    دع الكتل: متغير كتل_محسن_ويب_أسمبلي = { البدايات: البدايات, النهايات: النهايات, التوالي: التوالي };
    دع الإطارات: متغير متجه إطار_تحكم_محسن = [];
    ادفع_إطار_محسن(&متغير الإطارات, 0, 0, اختياري.لا_شيء());
    دع الحالية: متغير طبيعي = كتلة_جديدة_محسن(&متغير الكتل, 0);
    دع العدد: طبيعي = الطول(*البرنامج) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الرمز: طبيعي = (*البرنامج)[ف].الرمز;
        دع الأصل: طبيعي = (*البرنامج)[ف].الأصل;
        إذا (الرمز == 0x02) {
            ادفع_إطار_محسن(&متغير الإطارات, 1, 0, اختياري.لا_شيء());
        } وإلا إذا (الرمز == 0x03) {
            الكتل.النهايات[الحالية] := ف + 1;
            دع الرأس: طبيعي = كتلة_جديدة_محسن(&متغير الكتل, ف + 1);
            ألحق(الكتل.التوالي[الحالية], الرأس);
            الحالية := الرأس;
            ادفع_إطار_محسن(&متغير الإطارات, 2, الرأس, اختياري.لا_شيء());
        } وإلا إذا (الرمز == 0x04) {
            الكتل.النهايات[الحالية] := ف + 1;
            دع الشرط: طبيعي = الحالية;
            دع الأولى: طبيعي = كتلة_جديدة_محسن(&متغير الكتل, ف + 1);
            ألحق(الكتل.التوالي[الشرط], الأولى);
            الحالية := الأولى;
            ادفع_إطار_محسن(&متغير الإطارات, 3, 0, اختياري.موجود(الشرط));
        } وإلا إذا (الرمز == 0x05) {
            دع الأعلى: طبيعي = (الطول(الإطارات) مثل طبيعي) - 1;
            الكتل.النهايات[الحالية] := ف + 1;
            ألحق(الإطارات[الأعلى].القفزات, الحالية);
            دع الثانية: طبيعي = كتلة_جديدة_محسن(&متغير الكتل, ف + 1);
            طابق الإطارات[الأعلى].الشرط مع
            | اختياري.موجود(ش) -> { ألحق(الكتل.التوالي[ش], الثانية); }
            | اختياري.لا_شيء -> { };
            الإطارات[الأعلى].الشرط := اختياري.لا_شيء();
            الحالية := الثانية;
        } وإلا إذا (الرمز == 0x0B) {
            دع الأعلى: طبيعي = (الطول(الإطارات) مثل طبيعي) - 1;
            الكتل.النهايات[الحالية] := ف + 1;
            دع النوع: طبيعي = الإطارات[الأعلى].النوع;
            إذا (النوع == 0) {
                ف := العدد;
            } وإلا {
                دع التالية: طبيعي = كتلة_جديدة_محسن(&متغير الكتل, ف + 1);
                ألحق(الكتل.التوالي[الحالية], التالية);
                إذا (النوع != 2) {
                    دع م: متغير طبيعي = 0;
                    طالما (م < (الطول(الإطارات[الأعلى].القفزات) مثل طبيعي)) {
                        دع القافزة: طبيعي = الإطارات[الأعلى].القفزات[م];
                        ألحق(الكتل.التوالي[القافزة], التالية);
                        م := م + 1;
                    }
                    طابق الإطارات[الأعلى].الشرط مع
                    | اختياري.موجود(ش) -> { ألحق(الكتل.التوالي[ش], التالية); }
                    | اختياري.لا_شيء -> { };
                };
                دع تجاهل: اختياري إطار_تحكم_محسن = أزل_الأخير(الإطارات);
                الحالية := التالية;
            };
        } وإلا إذا (الرمز == 0x0C) {
            الكتل.النهايات[الحالية] := ف + 1;
            اقفز_محسن(&متغير الكتل, &متغير الإطارات, الحالية, (*المفكوك).الأعماق[الأصل]);
            الحالية := كتلة_جديدة_محسن(&متغير الكتل, ف + 1);
        } وإلا إذا (الرمز == 0x0D) {
            الكتل.النهايات[الحالية] := ف + 1;
            اقفز_محسن(&متغير الكتل, &متغير الإطارات, الحالية, (*المفكوك).الأعماق[الأصل]);
            دع التالية: طبيعي = كتلة_جديدة_محسن(&متغير الكتل, ف + 1);
            ألحق(الكتل.التوالي[الحالية], التالية);
            الحالية := التالية;
        } وإلا إذا (الرمز == 0x0E) {
            الكتل.النهايات[الحالية] := ف + 1;
            دع البداية: طبيعي = (*المفكوك).الأعماق[الأصل];
            دع م: متغير طبيعي = 0;
            طالما (م < (*المفكوك).عدد_الأهداف[الأصل]) {
                اقفز_محسن(&متغير الكتل, &متغير الإطارات, الحالية, (*المفكوك).الأهداف[البداية + م]);
                م := م + 1;
            }
            الحالية := كتلة_جديدة_محسن(&متغير الكتل, ف + 1);
        } وإلا إذا (الرمز == 0x0F || الرمز == 0x00) {
            // return, unreachable: no successor; what follows is unreachable.
            الكتل.النهايات[الحالية] := ف + 1;
            الحالية := كتلة_جديدة_محسن(&متغير الكتل, ف + 1);
        };
        ف := ف + 1;
    }
    أرجع الكتل;
}

// ----------------------------------------------------------- liveness --

// Dense bit sets: الكلمات words per set, sets stored one after another.

عرف بت_مضبوط_محسن(البتات: &متجه طبيعي, القاعدة: طبيعي, البت: طبيعي): منطقي {
    أرجع (((*البتات)[القاعدة + البت / 64] >> (البت % 64)) & 1) == 1;
}

عرف اضبط_بت_محسن(البتات: &متغير متجه طبيعي, القاعدة: طبيعي, البت: طبيعي): فراغ {
    دع ك: طبيعي = القاعدة + البت / 64;
    (*البتات)[ك] := (*البتات)[ك] | ((1 مثل طبيعي) << (البت % 64));
}

عرف امسح_بت_محسن(البتات: &متغير متجه طبيعي, القاعدة: طبيعي, البت: طبيعي): فراغ {
    دع ك: طبيعي = القاعدة + البت / 64;
    (*البتات)[ك] := (*البتات)[ك] & ~((1 مثل طبيعي) << (البت % 64));
}

// Liveness is computed only for the locals that can be live where one block
// meets another: those some block reads before it writes them. Every other
// local is defined before its uses within each block that uses it (most of
// the selector's locals are such temporaries), so it is never live at a
// block boundary and the walks inside the blocks see all of its life.
نوع حياة_محسن_ويب_أسمبلي = {
    // The locals that cross block boundaries, and each local's index among
    // them (عدد_المحليات when it does not cross).
    العابرة: متجه طبيعي,
    فهرس_العابرة: متجه طبيعي,
    الكلمات: طبيعي,
    // Per block, over the crossing locals: live at its start and at its end.
    الدخول: متجه طبيعي,
    الخروج: متجه طبيعي
};

عرف احسب_حياة_محسن(
    البرنامج: &متجه تعليمة_محسن_ويب_أسمبلي,
    الكتل: &كتل_محسن_ويب_أسمبلي,
    عدد_المحليات: طبيعي
): حياة_محسن_ويب_أسمبلي {
    دع عدد_الكتل: طبيعي = الطول((*الكتل).البدايات) مثل طبيعي;
    // The crossing locals: read in a block with no write before it there.
    دع آخر_كتابة: متغير متجه طبيعي = متجه_أصفار_محسن(عدد_المحليات); // block + 1
    دع فهرس_العابرة: متغير متجه طبيعي = [];
    احجز_سعة(فهرس_العابرة, عدد_المحليات);
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المحليات) { ألحق(فهرس_العابرة, عدد_المحليات); م := م + 1; }
    دع العابرة: متغير متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع ف: متغير طبيعي = (*الكتل).البدايات[ك];
        طالما (ف < (*الكتل).النهايات[ك]) {
            دع الرمز: طبيعي = (*البرنامج)[ف].الرمز;
            دع المحلي: طبيعي = (*البرنامج)[ف].المحلي;
            إذا (الرمز == 0x20 && آخر_كتابة[المحلي] != ك + 1 && فهرس_العابرة[المحلي] == عدد_المحليات) {
                فهرس_العابرة[المحلي] := الطول(العابرة) مثل طبيعي;
                ألحق(العابرة, المحلي);
            } وإلا إذا (الرمز == 0x21 || الرمز == 0x22) {
                آخر_كتابة[المحلي] := ك + 1;
            };
            ف := ف + 1;
        }
        ك := ك + 1;
    }
    دع الكلمات: طبيعي = ((الطول(العابرة) مثل طبيعي) + 63) / 64;
    دع الحجم: طبيعي = عدد_الكتل * الكلمات;
    // A block's uses before any definition (gen) and its definitions (kill).
    دع المولد: متغير متجه طبيعي = متجه_أصفار_محسن(الحجم);
    دع المقتول: متغير متجه طبيعي = متجه_أصفار_محسن(الحجم);
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع القاعدة: طبيعي = ك * الكلمات;
        دع ف: متغير طبيعي = (*الكتل).النهايات[ك];
        طالما (ف > (*الكتل).البدايات[ك]) {
            ف := ف - 1;
            دع الرمز: طبيعي = (*البرنامج)[ف].الرمز;
            إذا (الرمز == 0x20 || الرمز == 0x21 || الرمز == 0x22) {
                دع ع: طبيعي = فهرس_العابرة[(*البرنامج)[ف].المحلي];
                إذا (ع < عدد_المحليات) {
                    إذا (الرمز == 0x20) {
                        اضبط_بت_محسن(&متغير المولد, القاعدة, ع);
                    } وإلا {
                        امسح_بت_محسن(&متغير المولد, القاعدة, ع);
                        اضبط_بت_محسن(&متغير المقتول, القاعدة, ع);
                    };
                };
            };
        }
        ك := ك + 1;
    }
    دع الدخول: متغير متجه طبيعي = متجه_أصفار_محسن(الحجم);
    دع الخروج: متغير متجه طبيعي = متجه_أصفار_محسن(الحجم);
    دع تغير: متغير منطقي = الكلمات > 0;
    طالما (تغير) {
        تغير := خطأ;
        ك := عدد_الكتل;
        طالما (ك > 0) {
            ك := ك - 1;
            دع القاعدة: طبيعي = ك * الكلمات;
            دع ك2: متغير طبيعي = 0;
            طالما (ك2 < الكلمات) {
                دع خارج: متغير طبيعي = 0;
                دع ت: متغير طبيعي = 0;
                طالما (ت < (الطول((*الكتل).التوالي[ك]) مثل طبيعي)) {
                    خارج := خارج | الدخول[(*الكتل).التوالي[ك][ت] * الكلمات + ك2];
                    ت := ت + 1;
                }
                دع داخل: طبيعي = المولد[القاعدة + ك2] | (خارج & ~المقتول[القاعدة + ك2]);
                إذا (خارج != الخروج[القاعدة + ك2] || داخل != الدخول[القاعدة + ك2]) {
                    الخروج[القاعدة + ك2] := خارج;
                    الدخول[القاعدة + ك2] := داخل;
                    تغير := صواب;
                };
                ك2 := ك2 + 1;
            }
        }
    }
    دع الحياة: حياة_محسن_ويب_أسمبلي = {
        العابرة: العابرة, فهرس_العابرة: فهرس_العابرة, الكلمات: الكلمات, الدخول: الدخول, الخروج: الخروج
    };
    أرجع الحياة;
}

// Is the local live at function entry (block 0's start)?
عرف حي_عند_الدخول_محسن(الحياة: &حياة_محسن_ويب_أسمبلي, المحلي: طبيعي): منطقي {
    دع ع: طبيعي = (*الحياة).فهرس_العابرة[المحلي];
    إذا (ع >= (الطول((*الحياة).العابرة) مثل طبيعي)) { أرجع خطأ; };
    أرجع بت_مضبوط_محسن(&(*الحياة).الدخول, 0, ع);
}

// Sets, in a set over all locals, the locals live at the end of block الكتلة,
// and lists them in المضافة (so the walk can clear what it set).
عرف حمل_الخروج_محسن(
    الحياة: &حياة_محسن_ويب_أسمبلي,
    الكتلة: طبيعي,
    الحي: &متغير متجه طبيعي,
    المضافة: &متغير متجه طبيعي
): فراغ {
    دع الكلمات: طبيعي = (*الحياة).الكلمات;
    دع ك2: متغير طبيعي = 0;
    طالما (ك2 < الكلمات) {
        دع الكلمة: متغير طبيعي = (*الحياة).الخروج[الكتلة * الكلمات + ك2];
        طالما (الكلمة != 0) {
            دع البت: طبيعي = عدد_الأصفار_الدنيا_محسن(الكلمة);
            الكلمة := الكلمة & (الكلمة - 1);
            دع المحلي: طبيعي = (*الحياة).العابرة[ك2 * 64 + البت];
            اضبط_بت_محسن(الحي, 0, المحلي);
            ألحق(*المضافة, المحلي);
        }
        ك2 := ك2 + 1;
    }
}

// Clears what a block's walk set (its live-out and the locals it read).
عرف امسح_المضافة_محسن(الحي: &متغير متجه طبيعي, المضافة: &متغير متجه طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المضافة) مثل طبيعي)) {
        امسح_بت_محسن(الحي, 0, (*المضافة)[ف]);
        ف := ف + 1;
    }
    اقتطع(*المضافة, 0);
}

// --------------------------------------------------------------- passes --

// 1. Locals written once by `const; local.set` and not live at entry: each
// read becomes the constant.
عرف أعد_إنشاء_الثوابت_محسن(
    البرنامج: &متغير متجه تعليمة_محسن_ويب_أسمبلي,
    المفكوك: &جسم_مفكوك_ويب_أسمبلي,
    الحياة: &حياة_محسن_ويب_أسمبلي,
    عدد_المعاملات: طبيعي,
    عدد_المحليات: طبيعي
): فراغ {
    دع التعريفات: متغير متجه طبيعي = متجه_أصفار_محسن(عدد_المحليات);
    // The constant's position in البرنامج, plus one (0: none).
    دع الثابت: متغير متجه طبيعي = متجه_أصفار_محسن(عدد_المحليات);
    دع العدد: طبيعي = الطول(*البرنامج) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الرمز: طبيعي = (*البرنامج)[ف].الرمز;
        إذا (الرمز == 0x21 || الرمز == 0x22) {
            دع المحلي: طبيعي = (*البرنامج)[ف].المحلي;
            التعريفات[المحلي] := التعريفات[المحلي] + 1;
            إذا (الرمز == 0x21 && ف > 0) {
                دع السابق: طبيعي = (*البرنامج)[ف - 1].الأصل;
                إذا ((*البرنامج)[ف - 1].الرمز != 0x20 && السابق < (الطول((*المفكوك).ثابت_حر) مثل طبيعي)
                    && (*المفكوك).ثابت_حر[السابق]) {
                    الثابت[المحلي] := ف;
                };
            };
        };
        ف := ف + 1;
    }
    // A candidate: one definition, a constant, not live at entry.
    دع المرشح: متغير متجه منطقي = [];
    دع أي_مرشح: متغير منطقي = خطأ;
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المحليات) {
        دع مرشح: منطقي = م >= عدد_المعاملات && التعريفات[م] == 1 && الثابت[م] != 0
            && !حي_عند_الدخول_محسن(الحياة, م);
        ألحق(المرشح, مرشح);
        إذا (مرشح) { أي_مرشح := صواب; };
        م := م + 1;
    }
    إذا (!أي_مرشح) { أرجع; };
    دع الناتج: متغير متجه تعليمة_محسن_ويب_أسمبلي = [];
    احجز_سعة(الناتج, العدد);
    ف := 0;
    طالما (ف < العدد) {
        دع التعليمة: تعليمة_محسن_ويب_أسمبلي = (*البرنامج)[ف];
        دع المحلي: طبيعي = التعليمة.المحلي;
        دع محلي_مرشح: منطقي = (التعليمة.الرمز == 0x20 || التعليمة.الرمز == 0x21) && المرشح[المحلي];
        إذا (محلي_مرشح && التعليمة.الرمز == 0x20) {
            // The read becomes a copy of the constant instruction.
            دع الثابتة: تعليمة_محسن_ويب_أسمبلي = {
                الرمز: (*البرنامج)[الثابت[المحلي] - 1].الرمز, المحلي: 0,
                الأصل: (*البرنامج)[الثابت[المحلي] - 1].الأصل, الموقع: التعليمة.الموقع
            };
            ألحق(الناتج, الثابتة);
        } وإلا إذا (محلي_مرشح) {
            // The definition and its constant go.
            دع تجاهل: اختياري تعليمة_محسن_ويب_أسمبلي = أزل_الأخير(الناتج);
        } وإلا {
            ألحق(الناتج, التعليمة);
        };
        ف := ف + 1;
    }
    *البرنامج := الناتج;
}

// 2. Coalescing: the new local of each old one, and the types of the new
// locals (parameters first, as before).
نوع تلوين_محسن_ويب_أسمبلي = {
    اللون: متجه طبيعي,
    الأنواع: متجه طبيعي
};

عرف لون_المحليات_محسن(
    البرنامج: &متجه تعليمة_محسن_ويب_أسمبلي,
    المفكوك: &جسم_مفكوك_ويب_أسمبلي,
    الحياة: &حياة_محسن_ويب_أسمبلي,
    عدد_المعاملات: طبيعي,
    الأنواع: &متجه طبيعي
): تلوين_محسن_ويب_أسمبلي {
    دع عدد_المحليات: طبيعي = الطول(*الأنواع) مثل طبيعي;
    // The blocks of the program now; they are the blocks the liveness was
    // computed on, one for one (only local instructions went since).
    دع الكتل: كتل_محسن_ويب_أسمبلي = ابن_كتل_محسن(البرنامج, المفكوك);
    دع الكلمات: طبيعي = (عدد_المحليات + 63) / 64;
    // The interference matrix, one row of bits per local.
    دع التداخل: متغير متجه طبيعي = متجه_أصفار_محسن(عدد_المحليات * الكلمات);
    دع الحي: متغير متجه طبيعي = متجه_أصفار_محسن(الكلمات);
    دع المضافة: متغير متجه طبيعي = [];
    دع عدد_الكتل: طبيعي = الطول(الكتل.البدايات) مثل طبيعي;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع ك2: متغير طبيعي = 0;
        حمل_الخروج_محسن(الحياة, ك, &متغير الحي, &متغير المضافة);
        دع ف: متغير طبيعي = الكتل.النهايات[ك];
        طالما (ف > الكتل.البدايات[ك]) {
            ف := ف - 1;
            دع الرمز: طبيعي = (*البرنامج)[ف].الرمز;
            دع المحلي: طبيعي = (*البرنامج)[ف].المحلي;
            إذا (الرمز == 0x21 || الرمز == 0x22) {
                // A definition interferes with everything live after it,
                // except the source of a copy: the row of the defined local
                // takes the live set a word at a time (mirrored below).
                دع المصدر: متغير طبيعي = عدد_المحليات;
                إذا (الرمز == 0x21 && ف > الكتل.البدايات[ك] && (*البرنامج)[ف - 1].الرمز == 0x20) {
                    المصدر := (*البرنامج)[ف - 1].المحلي;
                };
                دع الصف: طبيعي = المحلي * الكلمات;
                دع كان_المصدر: منطقي = المصدر < عدد_المحليات && بت_مضبوط_محسن(&التداخل, الصف, المصدر);
                ك2 := 0;
                طالما (ك2 < الكلمات) {
                    التداخل[الصف + ك2] := التداخل[الصف + ك2] | الحي[ك2];
                    ك2 := ك2 + 1;
                }
                إذا (المصدر < عدد_المحليات && !كان_المصدر) { امسح_بت_محسن(&متغير التداخل, الصف, المصدر); };
                امسح_بت_محسن(&متغير الحي, 0, المحلي);
            } وإلا إذا (الرمز == 0x20) {
                اضبط_بت_محسن(&متغير الحي, 0, المحلي);
                ألحق(المضافة, المحلي);
            };
        }
        امسح_المضافة_محسن(&متغير الحي, &متغير المضافة);
        ك := ك + 1;
    }
    // Interference is symmetric: mirror every row.
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المحليات) {
        امسح_بت_محسن(&متغير التداخل, م * الكلمات, م);
        دع ك2: متغير طبيعي = 0;
        طالما (ك2 < الكلمات) {
            دع الكلمة: متغير طبيعي = التداخل[م * الكلمات + ك2];
            طالما (الكلمة != 0) {
                دع البت: طبيعي = عدد_الأصفار_الدنيا_محسن(الكلمة);
                الكلمة := الكلمة & (الكلمة - 1);
                اضبط_بت_محسن(&متغير التداخل, (ك2 * 64 + البت) * الكلمات, م);
            }
            ك2 := ك2 + 1;
        }
        م := م + 1;
    }
    // Entry defines every parameter and the zero of every other local.
    دع الداخلة: متغير متجه طبيعي = [];
    م := 0;
    طالما (م < (الطول((*الحياة).العابرة) مثل طبيعي)) {
        إذا (بت_مضبوط_محسن(&(*الحياة).الدخول, 0, م)) { ألحق(الداخلة, (*الحياة).العابرة[م]); };
        م := م + 1;
    }
    م := 0;
    طالما (م < (الطول(الداخلة) مثل طبيعي)) {
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول(الداخلة) مثل طبيعي)) {
            إذا (م != ن) { اضبط_بت_محسن(&متغير التداخل, الداخلة[م] * الكلمات, الداخلة[ن]); };
            ن := ن + 1;
        }
        م := م + 1;
    }
    // Copy partners: the two locals of `local.get a; local.set b`.
    دع الشركاء: متغير متجه متجه طبيعي = [];
    م := 0;
    طالما (م < عدد_المحليات) {
        دع فارغ: متجه طبيعي = [];
        ألحق(الشركاء, فارغ);
        م := م + 1;
    }
    دع العدد: طبيعي = الطول(*البرنامج) مثل طبيعي;
    دع ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        إذا ((*البرنامج)[ف].الرمز == 0x21 && (*البرنامج)[ف - 1].الرمز == 0x20) {
            دع أ: طبيعي = (*البرنامج)[ف - 1].المحلي;
            دع ب: طبيعي = (*البرنامج)[ف].المحلي;
            إذا (أ != ب && (*الأنواع)[أ] == (*الأنواع)[ب]) {
                ألحق(الشركاء[أ], ب);
                ألحق(الشركاء[ب], أ);
            };
        };
        ف := ف + 1;
    }
    // Greedy coloring in order of first appearance; parameters keep their
    // index. تعارض_اللون holds, per color, the locals that may not join it.
    دع اللون: متغير متجه طبيعي = [];
    م := 0;
    طالما (م < عدد_المحليات) { ألحق(اللون, عدد_المحليات); م := م + 1; }
    دع أنواع_الألوان: متغير متجه طبيعي = [];
    دع تعارض_اللون: متغير متجه طبيعي = [];
    م := 0;
    طالما (م < عدد_المعاملات) {
        اللون[م] := م;
        ألحق(أنواع_الألوان, (*الأنواع)[م]);
        دع ك2: متغير طبيعي = 0;
        طالما (ك2 < الكلمات) { ألحق(تعارض_اللون, التداخل[م * الكلمات + ك2]); ك2 := ك2 + 1; }
        اضبط_بت_محسن(&متغير تعارض_اللون, م * الكلمات, م);
        م := م + 1;
    }
    ف := 0;
    طالما (ف < العدد) {
        دع الرمز: طبيعي = (*البرنامج)[ف].الرمز;
        دع المحلي: طبيعي = (*البرنامج)[ف].المحلي;
        إذا ((الرمز == 0x20 || الرمز == 0x21 || الرمز == 0x22) && اللون[المحلي] == عدد_المحليات) {
            دع النوع: طبيعي = (*الأنواع)[المحلي];
            دع المختار: متغير طبيعي = الطول(أنواع_الألوان) مثل طبيعي;
            // A copy partner's color first.
            دع ش: متغير طبيعي = 0;
            طالما (ش < (الطول(الشركاء[المحلي]) مثل طبيعي) && المختار == (الطول(أنواع_الألوان) مثل طبيعي)) {
                دع لون_الشريك: طبيعي = اللون[الشركاء[المحلي][ش]];
                إذا (لون_الشريك < (الطول(أنواع_الألوان) مثل طبيعي) && أنواع_الألوان[لون_الشريك] == النوع
                    && !بت_مضبوط_محسن(&تعارض_اللون, لون_الشريك * الكلمات, المحلي)) {
                    المختار := لون_الشريك;
                };
                ش := ش + 1;
            }
            دع ل: متغير طبيعي = 0;
            طالما (ل < (الطول(أنواع_الألوان) مثل طبيعي) && المختار == (الطول(أنواع_الألوان) مثل طبيعي)) {
                إذا (أنواع_الألوان[ل] == النوع && !بت_مضبوط_محسن(&تعارض_اللون, ل * الكلمات, المحلي)) {
                    المختار := ل;
                };
                ل := ل + 1;
            }
            إذا (المختار == (الطول(أنواع_الألوان) مثل طبيعي)) {
                ألحق(أنواع_الألوان, النوع);
                دع ك2: متغير طبيعي = 0;
                طالما (ك2 < الكلمات) { ألحق(تعارض_اللون, 0); ك2 := ك2 + 1; }
            };
            اللون[المحلي] := المختار;
            دع ك2: متغير طبيعي = 0;
            طالما (ك2 < الكلمات) {
                دع ر: طبيعي = المختار * الكلمات + ك2;
                تعارض_اللون[ر] := تعارض_اللون[ر] | التداخل[المحلي * الكلمات + ك2];
                ك2 := ك2 + 1;
            }
            اضبط_بت_محسن(&متغير تعارض_اللون, المختار * الكلمات, المحلي);
        };
        ف := ف + 1;
    }
    دع التلوين: تلوين_محسن_ويب_أسمبلي = { اللون: اللون, الأنواع: أنواع_الألوان };
    أرجع التلوين;
}

// The number of trailing zero bits of a nonzero word.
عرف عدد_الأصفار_الدنيا_محسن(الكلمة: طبيعي): طبيعي {
    دع ك: متغير طبيعي = الكلمة;
    دع ن: متغير طبيعي = 0;
    إذا ((ك & 0xFFFFFFFF) == 0) { ن := ن + 32; ك := ك >> 32; };
    إذا ((ك & 0xFFFF) == 0) { ن := ن + 16; ك := ك >> 16; };
    إذا ((ك & 0xFF) == 0) { ن := ن + 8; ك := ك >> 8; };
    إذا ((ك & 0xF) == 0) { ن := ن + 4; ك := ك >> 4; };
    إذا ((ك & 0x3) == 0) { ن := ن + 2; ك := ك >> 2; };
    إذا ((ك & 0x1) == 0) { ن := ن + 1; };
    أرجع ن;
}

// 3. After coloring: copies within one local go, `local.set x; local.get x`
// keeps the value on the stack, and writes nothing reads become nothing or
// `drop`.
عرف بسط_المكدس_محسن(
    البرنامج: &متغير متجه تعليمة_محسن_ويب_أسمبلي,
    المفكوك: &جسم_مفكوك_ويب_أسمبلي,
    عدد_المحليات: طبيعي
): فراغ {
    دع بلا_نسخ: متغير متجه تعليمة_محسن_ويب_أسمبلي = [];
    دع العدد: طبيعي = الطول(*البرنامج) مثل طبيعي;
    احجز_سعة(بلا_نسخ, العدد);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع التعليمة: تعليمة_محسن_ويب_أسمبلي = (*البرنامج)[ف];
        إذا (التعليمة.الرمز == 0x20 && ف + 1 < العدد && (*البرنامج)[ف + 1].الرمز == 0x21
            && (*البرنامج)[ف + 1].المحلي == التعليمة.المحلي) {
            ف := ف + 2;
        } وإلا {
            ألحق(بلا_نسخ, التعليمة);
            ف := ف + 1;
        };
    }
    *البرنامج := بلا_نسخ;
    دع الكتل: كتل_محسن_ويب_أسمبلي = ابن_كتل_محسن(البرنامج, المفكوك);
    دع الحياة: حياة_محسن_ويب_أسمبلي = احسب_حياة_محسن(البرنامج, &الكتل, عدد_المحليات);
    دع الكلمات: طبيعي = (عدد_المحليات + 63) / 64;
    دع العدد2: طبيعي = الطول(*البرنامج) مثل طبيعي;
    // 0 keep, 1 delete, 2 local.tee, 3 drop.
    دع المصير: متغير متجه طبيعي = متجه_أصفار_محسن(العدد2);
    دع الحي: متغير متجه طبيعي = متجه_أصفار_محسن(الكلمات);
    دع المضافة: متغير متجه طبيعي = [];
    دع عدد_الكتل: طبيعي = الطول(الكتل.البدايات) مثل طبيعي;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        حمل_الخروج_محسن(&الحياة, ك, &متغير الحي, &متغير المضافة);
        دع البداية: طبيعي = الكتل.البدايات[ك];
        ف := الكتل.النهايات[ك];
        طالما (ف > البداية) {
            ف := ف - 1;
            دع الرمز: طبيعي = (*البرنامج)[ف].الرمز;
            دع المحلي: طبيعي = (*البرنامج)[ف].المحلي;
            دع حي: منطقي = (الرمز == 0x20 || الرمز == 0x21 || الرمز == 0x22) && بت_مضبوط_محسن(&الحي, 0, المحلي);
            إذا (الرمز == 0x20 && ف > البداية && (*البرنامج)[ف - 1].الرمز == 0x21
                && (*البرنامج)[ف - 1].المحلي == المحلي) {
                إذا (حي) {
                    المصير[ف] := 1;
                    المصير[ف - 1] := 2;
                    امسح_بت_محسن(&متغير الحي, 0, المحلي);
                } وإلا {
                    المصير[ف] := 1;
                    المصير[ف - 1] := 1;
                };
                ف := ف - 1;
            } وإلا إذا (الرمز == 0x20) {
                اضبط_بت_محسن(&متغير الحي, 0, المحلي);
                ألحق(المضافة, المحلي);
            } وإلا إذا (الرمز == 0x22) {
                إذا (!حي) { المصير[ف] := 1; };
                امسح_بت_محسن(&متغير الحي, 0, المحلي);
            } وإلا إذا (الرمز == 0x21) {
                إذا (!حي) { المصير[ف] := 3; };
                امسح_بت_محسن(&متغير الحي, 0, المحلي);
            };
        }
        امسح_المضافة_محسن(&متغير الحي, &متغير المضافة);
        ك := ك + 1;
    }
    دع الناتج: متغير متجه تعليمة_محسن_ويب_أسمبلي = [];
    احجز_سعة(الناتج, العدد2);
    دع الجديدة: طبيعي = (الطول((*المفكوك).الرموز) مثل طبيعي);
    ف := 0;
    طالما (ف < العدد2) {
        دع التعليمة: تعليمة_محسن_ويب_أسمبلي = (*البرنامج)[ف];
        إذا (المصير[ف] == 0) {
            ألحق(الناتج, التعليمة);
        } وإلا إذا (المصير[ف] == 2) {
            دع البديلة: تعليمة_محسن_ويب_أسمبلي = {
                الرمز: 0x22, المحلي: التعليمة.المحلي, الأصل: الجديدة, الموقع: التعليمة.الموقع
            };
            ألحق(الناتج, البديلة);
        } وإلا إذا (المصير[ف] == 3) {
            دع البديلة: تعليمة_محسن_ويب_أسمبلي = {
                الرمز: 0x1A, المحلي: 0, الأصل: الجديدة, الموقع: التعليمة.الموقع
            };
            ألحق(الناتج, البديلة);
        };
        ف := ف + 1;
    }
    *البرنامج := الناتج;
}

// ----------------------------------------------------------------- entry --

// Optimizes the locals of an encoded function. أنواع_المعاملات are the
// parameter types; the function's other locals are in (*الدالة).المحليات.
عام عرف حسن_محليات_ويب_أسمبلي(
    الدالة: &متغير دالة_ويب_أسمبلي_مشفرة,
    أنواع_المعاملات: &متجه نوع_قيمة_ويب_أسمبلي
): فراغ {
    دع المفكوك: متغير جسم_مفكوك_ويب_أسمبلي;
    طابق فك_جسم_محسن_ويب_أسمبلي(&(*الدالة).الشفرة) مع
    | اختياري.موجود(م) -> { المفكوك := م; }
    | اختياري.لا_شيء -> { أرجع; };
    دع عدد_المفكوكة: طبيعي = الطول(المفكوك.الرموز) مثل طبيعي;
    // A constant whose bytes hold a relocation is not free to copy.
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*الدالة).الإزاحات) مثل طبيعي)) {
        دع ت: طبيعي = تعليمة_عند_موضع_محسن(&المفكوك.البدايات, (*الدالة).الإزاحات[ر].الموضع);
        إذا (ت < عدد_المفكوكة) { المفكوك.ثابت_حر[ت] := خطأ; };
        ر := ر + 1;
    }
    دع عدد_المعاملات: طبيعي = الطول(*أنواع_المعاملات) مثل طبيعي;
    دع الأنواع: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المعاملات) { ألحق(الأنواع, رمز_نوع_قيمة_ويب_أسمبلي((*أنواع_المعاملات)[م])); م := م + 1; }
    م := 0;
    طالما (م < (الطول((*الدالة).المحليات) مثل طبيعي)) {
        ألحق(الأنواع, رمز_نوع_قيمة_ويب_أسمبلي((*الدالة).المحليات[م]));
        م := م + 1;
    }
    دع عدد_المحليات: طبيعي = الطول(الأنواع) مثل طبيعي;
    دع البرنامج: متغير متجه تعليمة_محسن_ويب_أسمبلي = [];
    احجز_سعة(البرنامج, عدد_المفكوكة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_المفكوكة) {
        إذا (المفكوك.الرموز[ف] >= 0x20 && المفكوك.الرموز[ف] <= 0x22 && المفكوك.المحليات[ف] >= عدد_المحليات) {
            أرجع; // a local the function does not declare
        };
        دع التعليمة: تعليمة_محسن_ويب_أسمبلي = {
            الرمز: المفكوك.الرموز[ف], المحلي: المفكوك.المحليات[ف], الأصل: ف, الموقع: ف
        };
        ألحق(البرنامج, التعليمة);
        ف := ف + 1;
    }

    // Liveness is per local, and the constants pass removes only local
    // instructions, so one liveness serves both passes.
    دع الكتل: كتل_محسن_ويب_أسمبلي = ابن_كتل_محسن(&البرنامج, &المفكوك);
    دع الحياة: حياة_محسن_ويب_أسمبلي = احسب_حياة_محسن(&البرنامج, &الكتل, عدد_المحليات);
    أعد_إنشاء_الثوابت_محسن(&متغير البرنامج, &المفكوك, &الحياة, عدد_المعاملات, عدد_المحليات);
    دع التلوين: تلوين_محسن_ويب_أسمبلي = لون_المحليات_محسن(&البرنامج, &المفكوك, &الحياة, عدد_المعاملات, &الأنواع);
    ف := 0;
    طالما (ف < (الطول(البرنامج) مثل طبيعي)) {
        دع الرمز: طبيعي = البرنامج[ف].الرمز;
        إذا (الرمز == 0x20 || الرمز == 0x21 || الرمز == 0x22) {
            البرنامج[ف].المحلي := التلوين.اللون[البرنامج[ف].المحلي];
        };
        ف := ف + 1;
    }
    دع عدد_الألوان: طبيعي = الطول(التلوين.الأنواع) مثل طبيعي;
    بسط_المكدس_محسن(&متغير البرنامج, &المفكوك, عدد_الألوان);

    // Encode. The new start of each decoded instruction (of the one taking
    // its place, or of the next one when it went) moves relocations and
    // origin ranges.
    دع الشفرة: متغير متجه ط8 = [];
    احجز_سعة(الشفرة, الطول((*الدالة).الشفرة) مثل طبيعي);
    دع البداية_الجديدة: متغير متجه طبيعي = [];
    احجز_سعة(البداية_الجديدة, عدد_المفكوكة + 1);
    ف := 0;
    طالما (ف <= عدد_المفكوكة) { ألحق(البداية_الجديدة, 0); ف := ف + 1; }
    دع التالية: متغير طبيعي = 0; // decoded instructions placed so far
    ف := 0;
    طالما (ف < (الطول(البرنامج) مثل طبيعي)) {
        دع التعليمة: تعليمة_محسن_ويب_أسمبلي = البرنامج[ف];
        إذا (التعليمة.الموقع < عدد_المفكوكة) {
            طالما (التالية <= التعليمة.الموقع) {
                البداية_الجديدة[التالية] := الطول(الشفرة) مثل طبيعي;
                التالية := التالية + 1;
            }
        };
        إذا (التعليمة.الرمز == 0x20 || التعليمة.الرمز == 0x21 || التعليمة.الرمز == 0x22) {
            ألحق_بايت_ويب_أسمبلي(&متغير الشفرة, التعليمة.الرمز);
            ألحق_ليب_ويب_أسمبلي(&متغير الشفرة, التعليمة.المحلي);
        } وإلا إذا (التعليمة.الأصل >= عدد_المفكوكة) {
            ألحق_بايت_ويب_أسمبلي(&متغير الشفرة, التعليمة.الرمز);
        } وإلا {
            دع ب: متغير طبيعي = المفكوك.البدايات[التعليمة.الأصل];
            طالما (ب < المفكوك.البدايات[التعليمة.الأصل + 1]) {
                ألحق(الشفرة, (*الدالة).الشفرة[ب]);
                ب := ب + 1;
            }
        };
        ف := ف + 1;
    }
    طالما (التالية <= عدد_المفكوكة) {
        البداية_الجديدة[التالية] := الطول(الشفرة) مثل طبيعي;
        التالية := التالية + 1;
    }
    // Relocations sit in kept instructions, at the same place within them.
    ر := 0;
    طالما (ر < (الطول((*الدالة).الإزاحات) مثل طبيعي)) {
        دع القديم: طبيعي = (*الدالة).الإزاحات[ر].الموضع;
        دع ت: طبيعي = تعليمة_عند_موضع_محسن(&المفكوك.البدايات, القديم);
        (*الدالة).الإزاحات[ر].الموضع := البداية_الجديدة[ت] + (القديم - المفكوك.البدايات[ت]);
        ر := ر + 1;
    }
    // Origin ranges start and end on instruction boundaries.
    دع الأصول: متغير متجه مدى_شفرة_آلة_بأصل = [];
    ر := 0;
    طالما (ر < (الطول((*الدالة).الأصول) مثل طبيعي)) {
        دع المدى: متغير مدى_شفرة_آلة_بأصل = (*الدالة).الأصول[ر];
        دع أول_جديد: طبيعي = البداية_الجديدة[تعليمة_عند_موضع_محسن(&المفكوك.البدايات, المدى.إزاحة_بايت)];
        دع آخر_جديد: متغير طبيعي = الطول(الشفرة) مثل طبيعي;
        دع النهاية_القديمة: طبيعي = المدى.إزاحة_بايت + المدى.حجم_بايت;
        إذا (النهاية_القديمة < المفكوك.البدايات[عدد_المفكوكة]) {
            آخر_جديد := البداية_الجديدة[تعليمة_عند_موضع_محسن(&المفكوك.البدايات, النهاية_القديمة)];
        };
        إذا (آخر_جديد > أول_جديد) {
            المدى.إزاحة_بايت := أول_جديد;
            المدى.حجم_بايت := آخر_جديد - أول_جديد;
            ألحق(الأصول, المدى);
        };
        ر := ر + 1;
    }
    // Value locations follow their local; a value whose local went (a
    // constant, or never read) has none.
    دع المواقع: متغير متجه موقع_قيمة_مشفرة_ويب_أسمبلي = [];
    ر := 0;
    طالما (ر < (الطول((*الدالة).مواقع_القيم) مثل طبيعي)) {
        دع الموقع: متغير موقع_قيمة_مشفرة_ويب_أسمبلي = (*الدالة).مواقع_القيم[ر];
        إذا (الموقع.المحلي < عدد_المحليات && التلوين.اللون[الموقع.المحلي] < عدد_الألوان) {
            الموقع.المحلي := التلوين.اللون[الموقع.المحلي];
            ألحق(المواقع, الموقع);
        };
        ر := ر + 1;
    }
    دع المحليات: متغير متجه نوع_قيمة_ويب_أسمبلي = [];
    ف := عدد_المعاملات;
    طالما (ف < عدد_الألوان) {
        دع الرمز: طبيعي = التلوين.الأنواع[ف];
        إذا (الرمز == 0x7F) { ألحق(المحليات, نوع_قيمة_ويب_أسمبلي.صحيح32()); }
        وإلا إذا (الرمز == 0x7E) { ألحق(المحليات, نوع_قيمة_ويب_أسمبلي.صحيح64()); }
        وإلا إذا (الرمز == 0x7D) { ألحق(المحليات, نوع_قيمة_ويب_أسمبلي.عائم32()); }
        وإلا { ألحق(المحليات, نوع_قيمة_ويب_أسمبلي.عائم64()); };
        ف := ف + 1;
    }
    (*الدالة).الشفرة := الشفرة;
    (*الدالة).الأصول := الأصول;
    (*الدالة).مواقع_القيم := المواقع;
    (*الدالة).المحليات := المحليات;
}
