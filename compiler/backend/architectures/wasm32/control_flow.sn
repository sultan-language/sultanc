استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;

// Control-flow facts the wasm32 selector needs to turn an MSIR CFG into
// WebAssembly's structured control (block/loop/if with relative branches).
// The structuring follows N. Ramsey, "Beyond Relooper" (ICFP 2022): over the
// dominator tree, a loop header becomes a `loop`, each dominator-tree child
// that is a merge node (two or more forward in-edges) becomes the code after a
// `block`, and any other forward edge is emitted inline at its source. That is
// exact for reducible CFGs; an irreducible one is rejected (it never arises
// from SultanC's structured sources). Unreachable blocks are not emitted.

عام نوع بنية_تدفق_ويب_أسمبلي = {
    عدد_الكتل: طبيعي,
    المدخل: طبيعي,
    // Reverse-postorder number of each block; عدد_الكتل marks unreachable.
    رقم_الترتيب: متجه طبيعي,
    // Immediate dominator of each reachable block (the entry is its own).
    المهيمن: متجه طبيعي,
    رأس_حلقة: متجه منطقي,
    عقدة_دمج: متجه منطقي,
    // Dominator-tree children that are merge nodes, highest RPO number first.
    أطفال_الدمج: متجه متجه طبيعي
};

عام نوع نتيجة_بنية_تدفق_ويب_أسمبلي =
    | نجحت بنوع بنية_تدفق_ويب_أسمبلي
    | غير_قابلة_للاختزال
    | غير_صالحة
;

// Every control edge of a block, with multiplicity (a conditional whose two
// edges reach one block contributes two edges).
عام عرف حواف_كتلة_ويب_أسمبلي(الكتلة: &كتلة_مسير): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    طابق (*الكتلة).المنهي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع(الحافة) -> { ألحق(الناتج, الحافة.الهدف.القيمة); }
        | منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ) -> {
            ألحق(الناتج, عند_الصواب.الهدف.القيمة);
            ألحق(الناتج, عند_الخطأ.الهدف.القيمة);
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            ألحق(الناتج, الفرع.الافتراضي.الهدف.القيمة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                ألحق(الناتج, الفرع.الحالات[ف].الحافة.الهدف.القيمة);
                ف := ف + 1;
            }
        }
        | منهي_مسير.إرجاع(_) -> { }
        | منهي_مسير.فخ -> { };
    };
    أرجع الناتج;
}

عرف تقاطع_مهيمنين_ويب_أسمبلي(
    المهيمن: &متجه طبيعي,
    رقم_الترتيب: &متجه طبيعي,
    الأول: طبيعي,
    الثاني: طبيعي
): طبيعي {
    دع أ: متغير طبيعي = الأول;
    دع ب: متغير طبيعي = الثاني;
    طالما (أ != ب) {
        طالما ((*رقم_الترتيب)[أ] > (*رقم_الترتيب)[ب]) { أ := (*المهيمن)[أ]; }
        طالما ((*رقم_الترتيب)[ب] > (*رقم_الترتيب)[أ]) { ب := (*المهيمن)[ب]; }
    }
    أرجع أ;
}

عرف يهيمن_في_شجرة_ويب_أسمبلي(
    المهيمن: &متجه طبيعي,
    المدخل: طبيعي,
    المهيمن_المرشح: طبيعي,
    الكتلة: طبيعي
): منطقي {
    دع الحالية: متغير طبيعي = الكتلة;
    طالما (صواب) {
        إذا (الحالية == المهيمن_المرشح) { أرجع صواب; };
        إذا (الحالية == المدخل) { أرجع خطأ; };
        الحالية := (*المهيمن)[الحالية];
    }
    أرجع خطأ;
}

عام عرف حلل_تدفق_ويب_أسمبلي(الدالة: &دالة_مسير): نتيجة_بنية_تدفق_ويب_أسمبلي {
    دع العدد: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع المدخل: طبيعي;
    طابق (*الدالة).المدخل مع
    | اختياري.لا_شيء -> { أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.غير_صالحة(); }
    | اختياري.موجود(المعرف) -> { المدخل := المعرف.القيمة; };
    إذا (المدخل >= العدد) { أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.غير_صالحة(); };

    دع الحواف: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع حواف_الكتلة: متجه طبيعي = حواف_كتلة_ويب_أسمبلي(&(*الدالة).الكتل[ف]);
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(حواف_الكتلة) مثل طبيعي)) {
            إذا (حواف_الكتلة[م] >= العدد) { أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.غير_صالحة(); };
            م := م + 1;
        }
        ألحق(الحواف, حواف_الكتلة);
        ف := ف + 1;
    }

    // Iterative depth-first search from the entry for the postorder.
    دع الحالة: متغير متجه طبيعي = [];
    دع رقم_الترتيب: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(الحالة, 0); ألحق(رقم_الترتيب, العدد); ف := ف + 1; }
    دع البعدي: متغير متجه طبيعي = [];
    // The explicit stack keeps its capacity; العمق is its live size.
    دع مكدس_العقد: متغير متجه طبيعي = [المدخل];
    دع مكدس_المواضع: متغير متجه طبيعي = [0];
    دع العمق: متغير طبيعي = 1;
    الحالة[المدخل] := 1;
    طالما (العمق > 0) {
        دع القمة: طبيعي = العمق - 1;
        دع العقدة: طبيعي = مكدس_العقد[القمة];
        دع الموضع: طبيعي = مكدس_المواضع[القمة];
        إذا (الموضع < (الطول(الحواف[العقدة]) مثل طبيعي)) {
            مكدس_المواضع[القمة] := الموضع + 1;
            دع التالية: طبيعي = الحواف[العقدة][الموضع];
            إذا (الحالة[التالية] == 0) {
                الحالة[التالية] := 1;
                إذا (العمق < (الطول(مكدس_العقد) مثل طبيعي)) {
                    مكدس_العقد[العمق] := التالية;
                    مكدس_المواضع[العمق] := 0;
                } وإلا {
                    ألحق(مكدس_العقد, التالية);
                    ألحق(مكدس_المواضع, 0);
                };
                العمق := العمق + 1;
            };
        } وإلا {
            الحالة[العقدة] := 2;
            ألحق(البعدي, العقدة);
            العمق := القمة;
        };
    }
    دع عدد_الوصول: طبيعي = الطول(البعدي) مثل طبيعي;
    دع الترتيب: متغير متجه طبيعي = [];
    دع ع: متغير طبيعي = عدد_الوصول;
    طالما (ع > 0) {
        ع := ع - 1;
        رقم_الترتيب[البعدي[ع]] := الطول(الترتيب) مثل طبيعي;
        ألحق(الترتيب, البعدي[ع]);
    }

    // Predecessors among reachable blocks.
    دع الأسلاف: متغير متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) { دع فارغ: متجه طبيعي = []; ألحق(الأسلاف, فارغ); ف := ف + 1; }
    ف := 0;
    طالما (ف < العدد) {
        إذا (رقم_الترتيب[ف] < العدد) {
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(الحواف[ف]) مثل طبيعي)) {
                ألحق(الأسلاف[الحواف[ف][م]], ف);
                م := م + 1;
            }
        };
        ف := ف + 1;
    }

    // Immediate dominators (Cooper, Harvey and Kennedy), iterated in RPO.
    دع المهيمن: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(المهيمن, العدد); ف := ف + 1; }
    المهيمن[المدخل] := المدخل;
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        دع ر: متغير طبيعي = 1;
        طالما (ر < عدد_الوصول) {
            دع الكتلة: طبيعي = الترتيب[ر];
            دع الجديد: متغير طبيعي = العدد;
            دع س: متغير طبيعي = 0;
            طالما (س < (الطول(الأسلاف[الكتلة]) مثل طبيعي)) {
                دع السلف: طبيعي = الأسلاف[الكتلة][س];
                إذا (المهيمن[السلف] != العدد) {
                    إذا (الجديد == العدد) { الجديد := السلف; }
                    وإلا {
                        الجديد := تقاطع_مهيمنين_ويب_أسمبلي(&المهيمن, &رقم_الترتيب, السلف, الجديد);
                    };
                };
                س := س + 1;
            }
            إذا (الجديد != العدد && المهيمن[الكتلة] != الجديد) {
                المهيمن[الكتلة] := الجديد;
                تغير := صواب;
            };
            ر := ر + 1;
        }
    }

    دع رأس_حلقة: متغير متجه منطقي = [];
    دع عدد_الأمامية: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(رأس_حلقة, خطأ); ألحق(عدد_الأمامية, 0); ف := ف + 1; }
    // A retreating edge (to an equal or earlier RPO number) must target a
    // dominator of its source; otherwise the CFG is irreducible.
    ف := 0;
    طالما (ف < العدد) {
        إذا (رقم_الترتيب[ف] < العدد) {
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(الحواف[ف]) مثل طبيعي)) {
                دع الهدف: طبيعي = الحواف[ف][م];
                إذا (رقم_الترتيب[الهدف] <= رقم_الترتيب[ف]) {
                    إذا (!يهيمن_في_شجرة_ويب_أسمبلي(&المهيمن, المدخل, الهدف, ف)) {
                        أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.غير_قابلة_للاختزال();
                    };
                    رأس_حلقة[الهدف] := صواب;
                } وإلا {
                    عدد_الأمامية[الهدف] := عدد_الأمامية[الهدف] + 1;
                };
                م := م + 1;
            }
        };
        ف := ف + 1;
    }
    دع عقدة_دمج: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(عقدة_دمج, عدد_الأمامية[ف] >= 2); ف := ف + 1; }

    // Merge children per dominator-tree parent, collected in descending RPO.
    دع أطفال_الدمج: متغير متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) { دع فارغ: متجه طبيعي = []; ألحق(أطفال_الدمج, فارغ); ف := ف + 1; }
    دع ر: متغير طبيعي = عدد_الوصول;
    طالما (ر > 1) {
        ر := ر - 1;
        دع الكتلة: طبيعي = الترتيب[ر];
        إذا (عقدة_دمج[الكتلة]) {
            ألحق(أطفال_الدمج[المهيمن[الكتلة]], الكتلة);
        };
    }
    دع البنية: بنية_تدفق_ويب_أسمبلي = {
        عدد_الكتل: العدد,
        المدخل: المدخل,
        رقم_الترتيب: رقم_الترتيب,
        المهيمن: المهيمن,
        رأس_حلقة: رأس_حلقة,
        عقدة_دمج: عقدة_دمج,
        أطفال_الدمج: أطفال_الدمج
    };
    أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.نجحت(البنية);
}
