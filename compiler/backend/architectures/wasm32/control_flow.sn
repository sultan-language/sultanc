استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;

// Control-flow facts the wasm32 selector needs to turn an MSIR CFG into
// WebAssembly's structured control (block/loop/if with relative branches).
// The structuring follows N. Ramsey, "Beyond Relooper" (ICFP 2022): over the
// dominator tree, a loop header becomes a `loop`, each dominator-tree child
// that is a merge node (two or more forward in-edges) becomes the code after a
// `block`, and any other forward edge is emitted inline at its source. That is
// exact for reducible CFGs; an irreducible one is rejected (it never arises
// from SultanC's structured sources). Unreachable blocks are not emitted.

عام نوع بنية_تدفق_ويب_أسمبلي = {
    عدد_الكتل: غير_موقع,
    المدخل: غير_موقع,
    // Reverse-postorder number of each block; عدد_الكتل marks unreachable.
    رقم_الترتيب: متجه غير_موقع,
    // Immediate dominator of each reachable block (the entry is its own).
    المهيمن: متجه غير_موقع,
    رأس_حلقة: متجه منطقي,
    عقدة_دمج: متجه منطقي,
    // Dominator-tree children that are merge nodes, highest RPO number first.
    أطفال_الدمج: متجه متجه غير_موقع
};

عام نوع نتيجة_بنية_تدفق_ويب_أسمبلي =
    | نجحت بنوع بنية_تدفق_ويب_أسمبلي
    | غير_قابلة_للاختزال
    | غير_صالحة
;

// Every control edge of a block, with multiplicity (a conditional whose two
// edges reach one block contributes two edges).
عام عرف حواف_كتلة_ويب_أسمبلي(الكتلة: &كتلة_مسير): متجه غير_موقع {
    دع الناتج: متغير متجه غير_موقع = [];
    طابق (*الكتلة).المنهي مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع(الحافة) -> { ألحق(الناتج, الحافة.الهدف.القيمة); }
        | منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ) -> {
            ألحق(الناتج, عند_الصواب.الهدف.القيمة);
            ألحق(الناتج, عند_الخطأ.الهدف.القيمة);
        }
        | منهي_مسير.إرجاع(_) -> { }
        | منهي_مسير.فخ -> { };
    };
    أرجع الناتج;
}

عرف تقاطع_مهيمنين_ويب_أسمبلي(
    المهيمن: &متجه غير_موقع,
    رقم_الترتيب: &متجه غير_موقع,
    الأول: غير_موقع,
    الثاني: غير_موقع
): غير_موقع {
    دع أ: متغير غير_موقع = الأول;
    دع ب: متغير غير_موقع = الثاني;
    بينما (أ != ب) {
        بينما ((*رقم_الترتيب)[أ] > (*رقم_الترتيب)[ب]) { أ := (*المهيمن)[أ]; }
        بينما ((*رقم_الترتيب)[ب] > (*رقم_الترتيب)[أ]) { ب := (*المهيمن)[ب]; }
    }
    أرجع أ;
}

عرف يهيمن_في_شجرة_ويب_أسمبلي(
    المهيمن: &متجه غير_موقع,
    المدخل: غير_موقع,
    المهيمن_المرشح: غير_موقع,
    الكتلة: غير_موقع
): منطقي {
    دع الحالية: متغير غير_موقع = الكتلة;
    بينما (صواب) {
        لو (الحالية == المهيمن_المرشح) { أرجع صواب; };
        لو (الحالية == المدخل) { أرجع خطأ; };
        الحالية := (*المهيمن)[الحالية];
    }
    أرجع خطأ;
}

عام عرف حلل_تدفق_ويب_أسمبلي(الدالة: &دالة_مسير): نتيجة_بنية_تدفق_ويب_أسمبلي {
    دع العدد: غير_موقع = الطول((*الدالة).الكتل) مثل غير_موقع;
    دع المدخل: غير_موقع;
    طابق (*الدالة).المدخل مع
    | اختيار.لا_شيء -> { أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.غير_صالحة(); }
    | اختيار.بعض(المعرف) -> { المدخل := المعرف.القيمة; };
    لو (المدخل >= العدد) { أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.غير_صالحة(); };

    دع الحواف: متغير متجه متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع حواف_الكتلة: متجه غير_موقع = حواف_كتلة_ويب_أسمبلي(&(*الدالة).الكتل[ف]);
        دع م: متغير غير_موقع = 0;
        بينما (م < (الطول(حواف_الكتلة) مثل غير_موقع)) {
            لو (حواف_الكتلة[م] >= العدد) { أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.غير_صالحة(); };
            م := م + 1;
        }
        ألحق(الحواف, حواف_الكتلة);
        ف := ف + 1;
    }

    // Iterative depth-first search from the entry for the postorder.
    دع الحالة: متغير متجه غير_موقع = [];
    دع رقم_الترتيب: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف < العدد) { ألحق(الحالة, 0); ألحق(رقم_الترتيب, العدد); ف := ف + 1; }
    دع البعدي: متغير متجه غير_موقع = [];
    // The explicit stack keeps its capacity; العمق is its live size.
    دع مكدس_العقد: متغير متجه غير_موقع = [المدخل];
    دع مكدس_المواضع: متغير متجه غير_موقع = [0];
    دع العمق: متغير غير_موقع = 1;
    الحالة[المدخل] := 1;
    بينما (العمق > 0) {
        دع القمة: غير_موقع = العمق - 1;
        دع العقدة: غير_موقع = مكدس_العقد[القمة];
        دع الموضع: غير_موقع = مكدس_المواضع[القمة];
        لو (الموضع < (الطول(الحواف[العقدة]) مثل غير_موقع)) {
            مكدس_المواضع[القمة] := الموضع + 1;
            دع التالية: غير_موقع = الحواف[العقدة][الموضع];
            لو (الحالة[التالية] == 0) {
                الحالة[التالية] := 1;
                لو (العمق < (الطول(مكدس_العقد) مثل غير_موقع)) {
                    مكدس_العقد[العمق] := التالية;
                    مكدس_المواضع[العمق] := 0;
                } وإلا {
                    ألحق(مكدس_العقد, التالية);
                    ألحق(مكدس_المواضع, 0);
                };
                العمق := العمق + 1;
            };
        } وإلا {
            الحالة[العقدة] := 2;
            ألحق(البعدي, العقدة);
            العمق := القمة;
        };
    }
    دع عدد_الوصول: غير_موقع = الطول(البعدي) مثل غير_موقع;
    دع الترتيب: متغير متجه غير_موقع = [];
    دع ع: متغير غير_موقع = عدد_الوصول;
    بينما (ع > 0) {
        ع := ع - 1;
        رقم_الترتيب[البعدي[ع]] := الطول(الترتيب) مثل غير_موقع;
        ألحق(الترتيب, البعدي[ع]);
    }

    // Predecessors among reachable blocks.
    دع الأسلاف: متغير متجه متجه غير_موقع = [];
    ف := 0;
    بينما (ف < العدد) { دع فارغ: متجه غير_موقع = []; ألحق(الأسلاف, فارغ); ف := ف + 1; }
    ف := 0;
    بينما (ف < العدد) {
        لو (رقم_الترتيب[ف] < العدد) {
            دع م: متغير غير_موقع = 0;
            بينما (م < (الطول(الحواف[ف]) مثل غير_موقع)) {
                ألحق(الأسلاف[الحواف[ف][م]], ف);
                م := م + 1;
            }
        };
        ف := ف + 1;
    }

    // Immediate dominators (Cooper, Harvey and Kennedy), iterated in RPO.
    دع المهيمن: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف < العدد) { ألحق(المهيمن, العدد); ف := ف + 1; }
    المهيمن[المدخل] := المدخل;
    دع تغير: متغير منطقي = صواب;
    بينما (تغير) {
        تغير := خطأ;
        دع ر: متغير غير_موقع = 1;
        بينما (ر < عدد_الوصول) {
            دع الكتلة: غير_موقع = الترتيب[ر];
            دع الجديد: متغير غير_موقع = العدد;
            دع س: متغير غير_موقع = 0;
            بينما (س < (الطول(الأسلاف[الكتلة]) مثل غير_موقع)) {
                دع السلف: غير_موقع = الأسلاف[الكتلة][س];
                لو (المهيمن[السلف] != العدد) {
                    لو (الجديد == العدد) { الجديد := السلف; }
                    وإلا {
                        الجديد := تقاطع_مهيمنين_ويب_أسمبلي(&المهيمن, &رقم_الترتيب, السلف, الجديد);
                    };
                };
                س := س + 1;
            }
            لو (الجديد != العدد && المهيمن[الكتلة] != الجديد) {
                المهيمن[الكتلة] := الجديد;
                تغير := صواب;
            };
            ر := ر + 1;
        }
    }

    دع رأس_حلقة: متغير متجه منطقي = [];
    دع عدد_الأمامية: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف < العدد) { ألحق(رأس_حلقة, خطأ); ألحق(عدد_الأمامية, 0); ف := ف + 1; }
    // A retreating edge (to an equal or earlier RPO number) must target a
    // dominator of its source; otherwise the CFG is irreducible.
    ف := 0;
    بينما (ف < العدد) {
        لو (رقم_الترتيب[ف] < العدد) {
            دع م: متغير غير_موقع = 0;
            بينما (م < (الطول(الحواف[ف]) مثل غير_موقع)) {
                دع الهدف: غير_موقع = الحواف[ف][م];
                لو (رقم_الترتيب[الهدف] <= رقم_الترتيب[ف]) {
                    لو (!يهيمن_في_شجرة_ويب_أسمبلي(&المهيمن, المدخل, الهدف, ف)) {
                        أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.غير_قابلة_للاختزال();
                    };
                    رأس_حلقة[الهدف] := صواب;
                } وإلا {
                    عدد_الأمامية[الهدف] := عدد_الأمامية[الهدف] + 1;
                };
                م := م + 1;
            }
        };
        ف := ف + 1;
    }
    دع عقدة_دمج: متغير متجه منطقي = [];
    ف := 0;
    بينما (ف < العدد) { ألحق(عقدة_دمج, عدد_الأمامية[ف] >= 2); ف := ف + 1; }

    // Merge children per dominator-tree parent, collected in descending RPO.
    دع أطفال_الدمج: متغير متجه متجه غير_موقع = [];
    ف := 0;
    بينما (ف < العدد) { دع فارغ: متجه غير_موقع = []; ألحق(أطفال_الدمج, فارغ); ف := ف + 1; }
    دع ر: متغير غير_موقع = عدد_الوصول;
    بينما (ر > 1) {
        ر := ر - 1;
        دع الكتلة: غير_موقع = الترتيب[ر];
        لو (عقدة_دمج[الكتلة]) {
            ألحق(أطفال_الدمج[المهيمن[الكتلة]], الكتلة);
        };
    }
    دع البنية: بنية_تدفق_ويب_أسمبلي = {
        عدد_الكتل: العدد,
        المدخل: المدخل,
        رقم_الترتيب: رقم_الترتيب,
        المهيمن: المهيمن,
        رأس_حلقة: رأس_حلقة,
        عقدة_دمج: عقدة_دمج,
        أطفال_الدمج: أطفال_الدمج
    };
    أرجع نتيجة_بنية_تدفق_ويب_أسمبلي.نجحت(البنية);
}
