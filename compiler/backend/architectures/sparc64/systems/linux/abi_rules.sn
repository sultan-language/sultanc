استورد compiler.backend.abi.abi_model;
استورد compiler.backend.abi.aggregate_leaves;
استورد compiler.backend.abi.foreign_plan;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.target.target_model;

// SPARC V9 (64-bit) ABI ("SPARC Compliance Definition 2.4.1", 64-bit
// parameter passing) for foreign (C) calls on sparcv9 Linux. Clang
// reference: SparcV9ABIInfo.
// - Integers narrower than 64 bits are extended by signedness; floats use
//   FP registers by argument position.
// - A structure of at most 16 bytes travels in up to two doubleword argument
//   slots, a larger one by address of a caller-made copy; results of at most
//   32 bytes return in registers, larger ones through memory whose address
//   the caller passes.
// - Structures made only of integers and pointers travel as doublewords
//   (big-endian, left-aligned in their slots exactly as an 8-byte load of the
//   value padded to a doubleword gives).
// - A structure with float members is split as Clang's CoerceBuilder does:
//   every naturally aligned float or double member becomes a floating part at
//   its offset (the code generator assigns it the FP register of its slot),
//   and the bytes around them become integer parts that first complete the
//   current doubleword, then whole doublewords, then the final remainder. When
//   a single-precision member is present the parts are packed
//   (`أجزاء_مرصوصة`, LLVM `inreg`), so a 32-bit part takes the half of its
//   slot its offset selects: a single float in an odd word sits in the odd
//   half of the double register. Misaligned floats travel as integer bytes.
//   Previously such signatures were rejected.

عرف بنية_صحيحة_فقط_سبارك(الوصف: &وصف_قيمة_خارجية): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الوصف).الأوراق) مثل غير_موقع)) {
        لو ((*الوصف).الأوراق[ف].عائم) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Integer parts covering [*الحجم_الحالي, الحد): the rest of the current
// doubleword, whole doublewords, then the final remainder (CoerceBuilder::pad).
عرف أكمل_أجزاء_صحيحة_سبارك(
    الأشكال: &متغير متجه شكل_جزء_واجهة,
    الحجم_الحالي: &متغير غير_موقع,
    الحد: غير_موقع
): فراغ {
    لو (*الحجم_الحالي >= الحد) { أرجع; };
    دع المحاذى: غير_موقع = ((*الحجم_الحالي + 7) / 8) * 8;
    لو (المحاذى > *الحجم_الحالي && المحاذى <= الحد) {
        ألحق(*الأشكال, شكل_جزء_واجهة_جديد(*الحجم_الحالي, المحاذى - *الحجم_الحالي, فئة_سجل_واجهة.عدد_صحيح()));
        *الحجم_الحالي := المحاذى;
    };
    بينما (*الحجم_الحالي + 8 <= الحد) {
        ألحق(*الأشكال, شكل_جزء_واجهة_جديد(*الحجم_الحالي, 8, فئة_سجل_واجهة.عدد_صحيح()));
        *الحجم_الحالي := *الحجم_الحالي + 8;
    }
    لو (*الحجم_الحالي < الحد) {
        ألحق(*الأشكال, شكل_جزء_واجهة_جديد(*الحجم_الحالي, الحد - *الحجم_الحالي, فئة_سجل_واجهة.عدد_صحيح()));
        *الحجم_الحالي := الحد;
    };
}

// The register parts of a structure with float members (CoerceBuilder).
عرف قيمة_بنية_عائمة_سبارك(الوصف: &وصف_قيمة_خارجية): قيمة_مصنفة_واجهة {
    دع الأشكال: متغير متجه شكل_جزء_واجهة = [];
    دع الحجم_الحالي: متغير غير_موقع = 0;
    دع مرصوصة: متغير منطقي = خطأ;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الوصف).الأوراق) مثل غير_موقع)) {
        دع الورقة: ورقة_تجميع_واجهة = (*الوصف).الأوراق[ف];
        لو (الورقة.عائم && (الورقة.الحجم == 4 || الورقة.الحجم == 8)
            && (الورقة.الإزاحة % الورقة.الحجم) == 0) {
            لو (الورقة.الحجم < 8) { مرصوصة := صواب; };
            أكمل_أجزاء_صحيحة_سبارك(&متغير الأشكال, &متغير الحجم_الحالي, الورقة.الإزاحة);
            ألحق(الأشكال, شكل_جزء_واجهة_جديد(الورقة.الإزاحة, الورقة.الحجم, فئة_سجل_واجهة.عائم_متجه()));
            الحجم_الحالي := الورقة.الإزاحة + الورقة.الحجم;
        };
        ف := ف + 1;
    }
    دع الحجم: متغير غير_موقع = (*الوصف).الحجم;
    لو (الحجم == 0) { الحجم := 1; };
    أكمل_أجزاء_صحيحة_سبارك(&متغير الأشكال, &متغير الحجم_الحالي, ((الحجم + 7) / 8) * 8);
    دع القيمة: متغير قيمة_مصنفة_واجهة = قيمة_أجزاء_خارجية(الوصف, الأشكال, خطأ);
    القيمة.التصنيف.أجزاء_مرصوصة := مرصوصة;
    أرجع القيمة;
}

عرف صنف_قيمة_سبارك_أربعة_وستون(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    ناتج: منطقي
): نتيجة قيمة_مصنفة_واجهة, خطأ_واجهة {
    دع الوصف: وصف_قيمة_خارجية;
    طابق صف_قيمة_خارجية(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الوصف := القيمة; };
    لو (الوصف.فارغة) { أرجع نتيجة.نجح(قيمة_متجاهلة_خارجية()); };
    لو (!الوصف.بنية) {
        أرجع نتيجة.نجح(قيمة_سلمية_خارجية(
            &الوصف, توسيع_عدد_ضيق_واجهة(الأنواع, النوع, 64, 0)
        ));
    };
    دع الحد: متغير غير_موقع = 16;
    لو (ناتج) { الحد := 32; };
    لو (الوصف.الحجم > الحد) { أرجع نتيجة.نجح(قيمة_غير_مباشرة_خارجية(&الوصف)); };
    لو (!بنية_صحيحة_فقط_سبارك(&الوصف)) { أرجع نتيجة.نجح(قيمة_بنية_عائمة_سبارك(&الوصف)); };
    دع العدد: غير_موقع = (الوصف.الحجم + 7) / 8;
    // Full doublewords, read from a padded copy (block lowering), so the
    // value occupies the high-order bytes of each slot.
    أرجع نتيجة.نجح(قيمة_أجزاء_خارجية(
        &الوصف,
        أشكال_أجزاء_منتظمة_واجهة(العدد * 8, 8, العدد, فئة_سجل_واجهة.عدد_صحيح()),
        العدد > 1
    ));
}

عام عرف صنف_واجهة_سبارك_أربعة_وستون_خارجية(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع القيم: متغير متجه قيمة_مصنفة_واجهة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المعاملات) مثل غير_موقع)) {
        طابق صنف_قيمة_سبارك_أربعة_وستون(الأنواع, الهدف, سجل_التخطيط, (*المعاملات)[ف], خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(القيم, القيمة); };
        ف := ف + 1;
    }
    دع قيمة_الناتج: قيمة_مصنفة_واجهة;
    طابق صنف_قيمة_سبارك_أربعة_وستون(الأنواع, الهدف, سجل_التخطيط, الناتج, صواب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { قيمة_الناتج := القيمة; };
    أرجع نتيجة.نجح(ابن_خطة_واجهة_خارجية(المعاملات, &القيم, الناتج, &قيمة_الناتج, 8, 16));
}
