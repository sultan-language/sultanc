// Darwin/ARM64 machine-runtime image. Target selects this provider; Mach-O only consumes relocations.
عام نوع هدف_إزاحة_تشغيل_داروين_ذراع =
    | خدمة بنوع خدمة_تشغيل_هدف
    | مرفق بنوع مرفق_مضيف_هدف
;

عام نوع إزاحة_تشغيل_داروين_ذراع = {
    إزاحة_بايت: غير_موقع,
    الهدف: هدف_إزاحة_تشغيل_داروين_ذراع
};

عام نوع صورة_تشغيل_داروين_ذراع = {
    الكلمات: متجه غير_موقع,
    الإزاحات: متجه إزاحة_تشغيل_داروين_ذراع
};

// ARM64 runtime words are encoded as hex text so compiler self-hosting does not
// create one AST/Type fact per machine word. Decoding is linear and preserves
// the exact Target-owned instruction image.
عرف قيمة_رقم_سداسي_تشغيل_داروين_ذراع(الحرف: غ8): غير_موقع {
    لو (الحرف >= 48 && الحرف <= 57) { أرجع (الحرف - 48) مثل غير_موقع; };
    لو (الحرف >= 65 && الحرف <= 70) { أرجع (الحرف - 55) مثل غير_موقع; };
    أرجع (الحرف - 87) مثل غير_موقع;
}

عرف فك_كلمات_تشغيل_داروين_ذراع(النص: &نص): متجه غير_موقع {
    دع المصدر: نص = *النص;
    دع الناتج: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع الكلمة: متغير غير_موقع = 0;
        دع ج: متغير غير_موقع = 0;
        بينما (ج < 8) {
            دع الموضع: غير_موقع = ف + ج;
            الكلمة := الكلمة * 16 + قيمة_رقم_سداسي_تشغيل_داروين_ذراع(المصدر[الموضع]);
            ج := ج + 1;
        }
        ألحق(الناتج, الكلمة);
        ف := ف + 8;
    }
    أرجع الناتج;
}

عرف ألحق_إزاحة_مرفق_تشغيل_داروين_ذراع(
