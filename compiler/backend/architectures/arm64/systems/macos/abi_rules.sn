استورد compiler.backend.abi.abi_model;
استورد compiler.backend.abi.aggregate_leaves;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.layout.alignment;
استورد compiler.backend.layout.layout_resolution;
استورد compiler.backend.target.target_model;

// هذا الملف يملك سياسة الواجهة الثنائية لنظام ماك على معمارية ذراع أربعة وستين،
// ومتغيرها القياسي AAPCS64 الذي تستعمله الشفرة الأصلية على AArch64 Linux.
// مفردات ABI المجردة تبقى في backend/abi ولا تعرف نظام التشغيل أو المعمارية.
// The two variants differ only where Apple deviates from AAPCS64: Apple
// extends narrow integer arguments and results to 32 bits in the caller and
// packs stack arguments at their natural alignment; AAPCS64 gives every
// stack argument its own 8-byte slot and leaves narrow integers unextended.
نوع خصائص_واجهة_ماك_ذراع_أربعة_وستون = {
    أبل: منطقي,
    حجم_كلمة_النداء: طبيعي,
    محاذاة_مكدس_النداء: طبيعي,
    عدد_سجلات_المعاملات_الصحيحة: طبيعي,
    عدد_سجلات_المعاملات_العائمة: طبيعي
};

عرف خصائص_واجهة_ماك_ذراع_أربعة_وستون_جديدة(): خصائص_واجهة_ماك_ذراع_أربعة_وستون {
    دع الخصائص: خصائص_واجهة_ماك_ذراع_أربعة_وستون = {
        أبل: صواب,
        حجم_كلمة_النداء: 8,
        محاذاة_مكدس_النداء: 16,
        عدد_سجلات_المعاملات_الصحيحة: 8,
        عدد_سجلات_المعاملات_العائمة: 8
    };
    أرجع الخصائص;
}

عرف خصائص_واجهة_إيه_إيه_بي_سي_إس_أربعة_وستون_جديدة(): خصائص_واجهة_ماك_ذراع_أربعة_وستون {
    دع الخصائص: متغير خصائص_واجهة_ماك_ذراع_أربعة_وستون = خصائص_واجهة_ماك_ذراع_أربعة_وستون_جديدة();
    الخصائص.أبل := خطأ;
    أرجع الخصائص;
}

عرف نوع_بدائي_عائم(النوع: نوع_بدائي_مقنن): منطقي {
    طابق النوع مع
    | نوع_بدائي_مقنن.ع32 -> {
        أرجع صواب;
    }
    | نوع_بدائي_مقنن.ع64 -> {
        أرجع صواب;
    }
    | _ -> {
        أرجع خطأ;
    };
}

عرف نوع_فراغ(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.فراغ -> {
                أرجع صواب;
            }
            | _ -> {
                أرجع خطأ;
            };
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف تفاصيل_تجميعية(التفاصيل: &تفاصيل_تخطيط): منطقي {
    طابق *التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        أرجع صواب;
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        أرجع صواب;
    }
    | تفاصيل_تخطيط.تعداد(التعداد) -> {
        أرجع صواب;
    }
    | _ -> {
        أرجع خطأ;
    };
}

عرف فئة_سجل_مباشر(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    تجميعي: منطقي
): فئة_سجل_واجهة {
    إذا (تجميعي) {
        أرجع فئة_سجل_واجهة.عدد_صحيح();
    };
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع فئة_سجل_واجهة.عدد_صحيح();
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (نوع_بدائي_عائم(البدائي)) {
                أرجع فئة_سجل_واجهة.عائم_متجه();
            };
            أرجع فئة_سجل_واجهة.عدد_صحيح();
        }
        | _ -> {
            أرجع فئة_سجل_واجهة.عدد_صحيح();
        };
    };
}

عرف تصنيف_متجاهل(): تصنيف_قيمة_واجهة {
    دع الطريقة: طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.متجاهل();
    دع فئة_السجل: اختياري فئة_سجل_واجهة = اختياري.لا_شيء();
    دع التصنيف: تصنيف_قيمة_واجهة = {
        الطريقة: الطريقة,
        الحجم: 0,
        المحاذاة: 1,
        عدد_الأجزاء: 0,
        فئة_السجل: فئة_السجل,
        تجميعي: خطأ,
        التوسيع: توسيع_عدد_واجهة.بلا_توسيع(),
        كتلة_متصلة: خطأ,
        نسخة_للمستدعى: خطأ,
        أجزاء_مرصوصة: خطأ
    };
    أرجع التصنيف;
}

// Darwin AArch64 HFA: one to four tightly laid out f32/f64 members of
// the same base type, including nested arrays and records. Only layout and
// Type facts determine membership; register assignment happens below.
عرف اجمع_عناصر_عائم_متجانس_ماك(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    الإزاحة: طبيعي,
    حجم_العنصر: &متغير طبيعي,
    عدد_العناصر: &متغير طبيعي
): منطقي {
    دع التخطيط: واصف_تخطيط;
    طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(القيمة) -> { التخطيط := القيمة; }
    | _ -> { أرجع خطأ; };
    طابق التخطيط.التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
            طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, الأجزاء[ف].الفهرس) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(العضو) -> {
                إذا (!اجمع_عناصر_عائم_متجانس_ماك(
                    الأنواع, الهدف, سجل_التخطيط, العضو,
                    الإزاحة + الأجزاء[ف].الإزاحة, حجم_العنصر, عدد_العناصر
                )) { أرجع خطأ; };
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
            طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, الأجزاء[ف].الفهرس) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(العضو) -> {
                إذا (!اجمع_عناصر_عائم_متجانس_ماك(
                    الأنواع, الهدف, سجل_التخطيط, العضو,
                    الإزاحة + الأجزاء[ف].الإزاحة, حجم_العنصر, عدد_العناصر
                )) { أرجع خطأ; };
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | تفاصيل_تخطيط.تعداد(_) -> { أرجع خطأ; }
    | _ -> { };
    دع حجم_عائم: متغير طبيعي = 0;
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(نوع_بدائي_مقنن.ع32) -> { حجم_عائم := 4; }
        | صنف_شكل_نوع_دلالي.بدائي(نوع_بدائي_مقنن.ع64) -> { حجم_عائم := 8; }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    إذا (*عدد_العناصر >= 4 ||
        (*حجم_العنصر != 0 && *حجم_العنصر != حجم_عائم) ||
        الإزاحة != *عدد_العناصر * حجم_عائم) { أرجع خطأ; };
    *حجم_العنصر := حجم_عائم;
    *عدد_العناصر := *عدد_العناصر + 1;
    أرجع صواب;
}

عرف صنف_عائم_متجانس_ماك(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    الحجم: طبيعي
): اختياري طبيعي {
    دع حجم_العنصر: متغير طبيعي = 0;
    دع العدد: متغير طبيعي = 0;
    إذا (!اجمع_عناصر_عائم_متجانس_ماك(
        الأنواع, الهدف, سجل_التخطيط, النوع, 0,
        &متغير حجم_العنصر, &متغير العدد
    )) { أرجع اختياري.لا_شيء(); };
    إذا (العدد == 0 || العدد > 4 || الحجم != العدد * حجم_العنصر) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(العدد);
}

عرف صنف_ماك_ذراع_أربعة_وستون_قيمة(
    الخصائص: &خصائص_واجهة_ماك_ذراع_أربعة_وستون,
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_نوع
): نتيجة تصنيف_قيمة_واجهة, خطأ_واجهة {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_واجهة.معرف_نوع_غير_صالح(المعرف));
    }
    | اختياري.موجود(الوصف) -> { };
    إذا (نوع_فراغ(الأنواع, المعرف)) {
        أرجع نتيجة.نجح(تصنيف_متجاهل());
    };

    طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, المعرف) مع
    | نتيجة_تخطيط.مؤجل(السبب) -> {
        أرجع نتيجة.خطأ(خطأ_واجهة.تخطيط_نوع_مؤجل(المعرف, السبب));
    }
    | نتيجة_تخطيط.مرفوض(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_واجهة.تخطيط_نوع_مرفوض(المعرف, الخطأ));
    }
    | نتيجة_تخطيط.مكتمل(التخطيط) -> {
        دع وصف_الخصائص: خصائص_واجهة_ماك_ذراع_أربعة_وستون = *الخصائص;
        إذا (التخطيط.الحجم == 0) {
            أرجع نتيجة.نجح(تصنيف_متجاهل());
        };
        دع تجميعي: منطقي = تفاصيل_تجميعية(&التخطيط.التفاصيل);
        دع الفئة: فئة_سجل_واجهة = فئة_سجل_مباشر(الأنواع, المعرف, تجميعي);
        إذا (تجميعي) {
            طابق صنف_عائم_متجانس_ماك(
                الأنواع, الهدف, سجل_التخطيط, المعرف, التخطيط.الحجم
            ) مع
            | اختياري.موجود(عدد_الأجزاء) -> {
                دع الطريقة: متغير طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.مباشر();
                إذا (عدد_الأجزاء > 1) { الطريقة := طريقة_تمرير_واجهة.مجزأ(); };
                دع التصنيف: تصنيف_قيمة_واجهة = {
                    الطريقة: الطريقة,
                    الحجم: التخطيط.الحجم,
                    المحاذاة: التخطيط.المحاذاة,
                    عدد_الأجزاء: عدد_الأجزاء,
                    فئة_السجل: اختياري.موجود(فئة_سجل_واجهة.عائم_متجه()),
                    تجميعي: صواب,
                    التوسيع: توسيع_عدد_واجهة.بلا_توسيع(),
                    // AAPCS64 C.2/C.3: an HFA occupies consecutive v registers
                    // or goes wholly to the stack.
                    كتلة_متصلة: صواب,
                    نسخة_للمستدعى: خطأ,
                    أجزاء_مرصوصة: خطأ
                };
                أرجع نتيجة.نجح(التصنيف);
            }
            | اختياري.لا_شيء -> { };
        };
        إذا (!تجميعي) {
            دع الطريقة: طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.مباشر();
            دع فئة_السجل: اختياري فئة_سجل_واجهة = اختياري.موجود(الفئة);
            // Apple ARM64: the caller extends char/short arguments to 32 bits
            // and results are extended likewise (Clang AArch64ABIInfo,
            // getExtend for promotable integers under DarwinPCS).
            دع توسيع_السلمي: متغير توسيع_عدد_واجهة = توسيع_عدد_واجهة.بلا_توسيع();
            إذا (وصف_الخصائص.أبل) {
                توسيع_السلمي := توسيع_عدد_ضيق_واجهة(الأنواع, المعرف, 32, 0);
            };
            دع التصنيف: تصنيف_قيمة_واجهة = {
                الطريقة: الطريقة,
                الحجم: التخطيط.الحجم,
                المحاذاة: التخطيط.المحاذاة,
                عدد_الأجزاء: 1,
                فئة_السجل: فئة_السجل,
                تجميعي: خطأ,
                التوسيع: توسيع_السلمي,
                كتلة_متصلة: خطأ,
                نسخة_للمستدعى: خطأ,
                أجزاء_مرصوصة: خطأ
            };
            أرجع نتيجة.نجح(التصنيف);
        };
        دع حجم_الكلمة: طبيعي = وصف_الخصائص.حجم_كلمة_النداء;
        إذا (التخطيط.الحجم <= حجم_الكلمة) {
            دع الطريقة: طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.مباشر();
            دع الفئة_الصحيحة: فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
            دع فئة_السجل: اختياري فئة_سجل_واجهة = اختياري.موجود(الفئة_الصحيحة);
            دع التصنيف: تصنيف_قيمة_واجهة = {
                الطريقة: الطريقة,
                الحجم: التخطيط.الحجم,
                المحاذاة: التخطيط.المحاذاة,
                عدد_الأجزاء: 1,
                فئة_السجل: فئة_السجل,
                تجميعي: صواب,
                التوسيع: توسيع_عدد_واجهة.بلا_توسيع(),
                كتلة_متصلة: خطأ,
                نسخة_للمستدعى: خطأ,
                أجزاء_مرصوصة: خطأ
            };
            أرجع نتيجة.نجح(التصنيف);
        };
        إذا (التخطيط.الحجم <= (حجم_الكلمة * 2)) {
            دع الطريقة: طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.مجزأ();
            دع الفئة_الصحيحة: فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
            دع فئة_السجل: اختياري فئة_سجل_واجهة = اختياري.موجود(الفئة_الصحيحة);
            دع الحجم_مع_الكلمة: طبيعي = التخطيط.الحجم + حجم_الكلمة;
            دع البسط: طبيعي = الحجم_مع_الكلمة - 1;
            دع عدد_الأجزاء: طبيعي = البسط / حجم_الكلمة;
            دع التصنيف: تصنيف_قيمة_واجهة = {
                الطريقة: الطريقة,
                الحجم: التخطيط.الحجم,
                المحاذاة: التخطيط.المحاذاة,
                عدد_الأجزاء: عدد_الأجزاء,
                فئة_السجل: فئة_السجل,
                تجميعي: صواب,
                التوسيع: توسيع_عدد_واجهة.بلا_توسيع(),
                كتلة_متصلة: صواب,
                نسخة_للمستدعى: خطأ,
                أجزاء_مرصوصة: خطأ
            };
            أرجع نتيجة.نجح(التصنيف);
        };
        دع الطريقة: طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.غير_مباشر();
        دع الفئة_الصحيحة: فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
        دع فئة_السجل: اختياري فئة_سجل_واجهة = اختياري.موجود(الفئة_الصحيحة);
        دع التصنيف: تصنيف_قيمة_واجهة = {
            الطريقة: الطريقة,
            الحجم: التخطيط.الحجم,
            المحاذاة: التخطيط.المحاذاة,
            عدد_الأجزاء: 1,
            فئة_السجل: فئة_السجل,
            تجميعي: صواب,
            التوسيع: توسيع_عدد_واجهة.بلا_توسيع(),
            كتلة_متصلة: خطأ,
            نسخة_للمستدعى: خطأ,
            أجزاء_مرصوصة: خطأ
        };
        أرجع نتيجة.نجح(التصنيف);
    };
}

نوع حالة_نداء_ماك_ذراع_أربعة_وستون = {
    سجل_صحيح_تال: طبيعي,
    سجل_عائم_تال: طبيعي,
    حجم_المكدس: طبيعي
};

عرف حالة_نداء_ماك_ذراع_أربعة_وستون_جديدة(): حالة_نداء_ماك_ذراع_أربعة_وستون {
    دع الحالة: حالة_نداء_ماك_ذراع_أربعة_وستون = {
        سجل_صحيح_تال: 0,
        سجل_عائم_تال: 0,
        حجم_المكدس: 0
    };
    أرجع الحالة;
}

عرف محاذاة_مكدس_قيمة_ماك_ذراع_أربعة_وستون(
    الخصائص: &خصائص_واجهة_ماك_ذراع_أربعة_وستون,
    التصنيف: &تصنيف_قيمة_واجهة
): طبيعي {
    دع وصف_الخصائص: خصائص_واجهة_ماك_ذراع_أربعة_وستون = *الخصائص;
    دع القيمة: تصنيف_قيمة_واجهة = *التصنيف;
    // An indirect aggregate is passed as an ordinary pointer. Its stack
    // slot uses pointer alignment, not the alignment of the pointee.
    إذا (القيمة.الطريقة == طريقة_تمرير_واجهة.غير_مباشر()) {
        أرجع وصف_الخصائص.حجم_كلمة_النداء;
    };
    إذا (القيمة.تجميعي) {
        // Direct aggregates retain their ABI stack alignment.
        دع محاذاة_التجميع: متغير طبيعي = القيمة.المحاذاة;
        إذا (محاذاة_التجميع < وصف_الخصائص.حجم_كلمة_النداء) {
            محاذاة_التجميع := وصف_الخصائص.حجم_كلمة_النداء;
        };
        إذا (محاذاة_التجميع > وصف_الخصائص.محاذاة_مكدس_النداء) {
            محاذاة_التجميع := وصف_الخصائص.محاذاة_مكدس_النداء;
        };
        أرجع محاذاة_التجميع;
    };
    // Darwin ARM64 لا يفرض خانة 8 بايت لكل scalar ثابت على المكدس؛
    // القيم الضيقة تتجاور وفق حجمها ومحاذاتها الطبيعية.
    // AAPCS64 C.16: every scalar stack argument takes an 8-byte slot.
    إذا (!وصف_الخصائص.أبل) {
        أرجع وصف_الخصائص.حجم_كلمة_النداء;
    };
    دع المحاذاة: متغير طبيعي = القيمة.المحاذاة;
    إذا (المحاذاة == 0) {
        المحاذاة := 1;
    };
    إذا (المحاذاة > وصف_الخصائص.محاذاة_مكدس_النداء) {
        المحاذاة := وصف_الخصائص.محاذاة_مكدس_النداء;
    };
    أرجع المحاذاة;
}

عرف مرجع_سجل_ماك_ذراع_أربعة_وستون(
    الفئة: فئة_سجل_واجهة,
    الفهرس: طبيعي,
    الدور: دور_سجل_واجهة
): مرجع_سجل_واجهة {
    دع الحفظ: حفظ_سجل_واجهة = حفظ_سجل_واجهة.متطاير_عبر_النداء();
    دع المرجع: مرجع_سجل_واجهة = {
        الفئة: الفئة,
        الفهرس: الفهرس,
        الدور: الدور,
        الحفظ: الحفظ
    };
    أرجع المرجع;
}

عرف ضع_على_المكدس_ماك_ذراع_أربعة_وستون(
    الخصائص: &خصائص_واجهة_ماك_ذراع_أربعة_وستون,
    التصنيف: &تصنيف_قيمة_واجهة,
    الحالة: &متغير حالة_نداء_ماك_ذراع_أربعة_وستون
): موقع_تمرير_واجهة {
    دع القيم: تصنيف_قيمة_واجهة = *التصنيف;
    دع وصف_الخصائص: خصائص_واجهة_ماك_ذراع_أربعة_وستون = *الخصائص;
    دع المحاذاة: طبيعي = محاذاة_مكدس_قيمة_ماك_ذراع_أربعة_وستون(الخصائص, &القيم);
    (*الحالة).حجم_المكدس := محاذاة_لأعلى(
        (*الحالة).حجم_المكدس,
        المحاذاة
    );
    دع الأجزاء: متجه موضع_جزء_واجهة = [];
    دع المواقع: متغير متجه موضع_جزء_واجهة = الأجزاء;
    دع حجم_وحدة_الجزء: متغير طبيعي = وصف_الخصائص.حجم_كلمة_النداء;
    إذا (القيم.تجميعي &&
        فئة_التصنيف_أو_صحيح(&القيم) == فئة_سجل_واجهة.عائم_متجه()) {
        حجم_وحدة_الجزء := القيم.الحجم / القيم.عدد_الأجزاء;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < القيم.عدد_الأجزاء) {
        دع الإزاحة_الجزئية: طبيعي = ف * حجم_وحدة_الجزء;
        دع الباقي: طبيعي = القيم.الحجم - الإزاحة_الجزئية;
        دع حجم_الجزء: متغير طبيعي = حجم_وحدة_الجزء;
        إذا (الباقي < حجم_وحدة_الجزء) {
            حجم_الجزء := الباقي;
        };
        دع الإزاحة: طبيعي = (*الحالة).حجم_المكدس + الإزاحة_الجزئية;
        دع موضع_المكدس: موضع_مكدس_واجهة = {
            الإزاحة: الإزاحة,
            الحجم: حجم_الجزء,
            المحاذاة: المحاذاة
        };
        ألحق(المواقع, موضع_جزء_واجهة.مكدس(موضع_المكدس));
        ف := ف + 1;
    }
    دع حجم_القيمة_على_المكدس: متغير طبيعي = القيم.الحجم;
    إذا (القيم.الطريقة == طريقة_تمرير_واجهة.غير_مباشر()) {
        حجم_القيمة_على_المكدس := وصف_الخصائص.حجم_كلمة_النداء;
    } وإلا إذا (القيم.تجميعي) {
        // التجميع المباشر/المجزأ يبقى في وحدات الكلمات التي تصف أجزاء ABI.
        حجم_القيمة_على_المكدس := القيم.عدد_الأجزاء * حجم_وحدة_الجزء;
    };
    إذا (القيم.تجميعي &&
        فئة_التصنيف_أو_صحيح(&القيم) == فئة_سجل_واجهة.عائم_متجه()) {
        // AAPCS64 C.3 rounds a spilled HFA to a complete eightbyte.
        حجم_القيمة_على_المكدس := محاذاة_لأعلى(حجم_القيمة_على_المكدس, 8);
    };
    إذا (!وصف_الخصائص.أبل) {
        حجم_القيمة_على_المكدس := محاذاة_لأعلى(حجم_القيمة_على_المكدس, وصف_الخصائص.حجم_كلمة_النداء);
    };
    (*الحالة).حجم_المكدس := (*الحالة).حجم_المكدس
        + حجم_القيمة_على_المكدس;

    طابق القيم.الطريقة مع
    | طريقة_تمرير_واجهة.غير_مباشر -> {
        أرجع موقع_تمرير_واجهة.غير_مباشر(المواقع[0]);
    }
    | طريقة_تمرير_واجهة.مباشر -> {
        أرجع موقع_تمرير_واجهة.مباشر(المواقع[0]);
    }
    | طريقة_تمرير_واجهة.مجزأ -> {
        أرجع موقع_تمرير_واجهة.مجزأ(المواقع);
    }
    | طريقة_تمرير_واجهة.متجاهل -> {
        أرجع موقع_تمرير_واجهة.متجاهل();
    };
}

عرف فئة_التصنيف_أو_صحيح(
    التصنيف: &تصنيف_قيمة_واجهة
): فئة_سجل_واجهة {
    دع القيمة: تصنيف_قيمة_واجهة = *التصنيف;
    طابق القيمة.فئة_السجل مع
    | اختياري.لا_شيء -> {
        أرجع فئة_سجل_واجهة.عدد_صحيح();
    }
    | اختياري.موجود(الفئة) -> {
        أرجع الفئة;
    };
}

عرف ضع_معامل_ماك_ذراع_أربعة_وستون(
    الخصائص: &خصائص_واجهة_ماك_ذراع_أربعة_وستون,
    التصنيف: &تصنيف_قيمة_واجهة,
    الحالة: &متغير حالة_نداء_ماك_ذراع_أربعة_وستون
): موقع_تمرير_واجهة {
    دع وصف_الخصائص: خصائص_واجهة_ماك_ذراع_أربعة_وستون = *الخصائص;
    دع القيم: تصنيف_قيمة_واجهة = *التصنيف;
    إذا (القيم.الطريقة == طريقة_تمرير_واجهة.متجاهل()) {
        أرجع موقع_تمرير_واجهة.متجاهل();
    };

    دع الفئة: فئة_سجل_واجهة = فئة_التصنيف_أو_صحيح(&القيم);

    دع الحالة_الحالية: متغير حالة_نداء_ماك_ذراع_أربعة_وستون = *الحالة;
    إذا (الفئة == فئة_سجل_واجهة.عائم_متجه()) {
        إذا (
            الحالة_الحالية.سجل_عائم_تال + القيم.عدد_الأجزاء
            <= وصف_الخصائص.عدد_سجلات_المعاملات_العائمة
        ) {
            دع المواضع: متغير متجه موضع_جزء_واجهة = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < القيم.عدد_الأجزاء) {
                دع المرجع: مرجع_سجل_واجهة = مرجع_سجل_ماك_ذراع_أربعة_وستون(
                    الفئة, الحالة_الحالية.سجل_عائم_تال + ف,
                    دور_سجل_واجهة.معامل()
                );
                ألحق(المواضع, موضع_جزء_واجهة.سجل(المرجع));
                ف := ف + 1;
            }
            الحالة_الحالية.سجل_عائم_تال := الحالة_الحالية.سجل_عائم_تال + القيم.عدد_الأجزاء;
            *الحالة := الحالة_الحالية;
            إذا (القيم.عدد_الأجزاء == 1) {
                أرجع موقع_تمرير_واجهة.مباشر(المواضع[0]);
            };
            أرجع موقع_تمرير_واجهة.مجزأ(المواضع);
        };
        // C.3: after a homogeneous aggregate cannot fit in v0-v7,
        // later floating arguments do not reuse the remaining v registers.
        الحالة_الحالية.سجل_عائم_تال := وصف_الخصائص.عدد_سجلات_المعاملات_العائمة;
        *الحالة := الحالة_الحالية;
        أرجع ضع_على_المكدس_ماك_ذراع_أربعة_وستون(الخصائص, &القيم, الحالة);
    };

    إذا (
        الحالة_الحالية.سجل_صحيح_تال + القيم.عدد_الأجزاء
        <= وصف_الخصائص.عدد_سجلات_المعاملات_الصحيحة
    ) {
        دع الأجزاء: متجه موضع_جزء_واجهة = [];
        دع المواقع: متغير متجه موضع_جزء_واجهة = الأجزاء;
        دع ف: متغير طبيعي = 0;
        طالما (ف < القيم.عدد_الأجزاء) {
            دع المرجع: مرجع_سجل_واجهة = مرجع_سجل_ماك_ذراع_أربعة_وستون(
                فئة_سجل_واجهة.عدد_صحيح(),
                الحالة_الحالية.سجل_صحيح_تال + ف,
                دور_سجل_واجهة.معامل()
            );
            ألحق(المواقع, موضع_جزء_واجهة.سجل(المرجع));
            ف := ف + 1;
        }
        الحالة_الحالية.سجل_صحيح_تال := الحالة_الحالية.سجل_صحيح_تال + القيم.عدد_الأجزاء;
        *الحالة := الحالة_الحالية;
        طابق القيم.الطريقة مع
        | طريقة_تمرير_واجهة.غير_مباشر -> {
            أرجع موقع_تمرير_واجهة.غير_مباشر(المواقع[0]);
        }
        | طريقة_تمرير_واجهة.مباشر -> {
            أرجع موقع_تمرير_واجهة.مباشر(المواقع[0]);
        }
        | طريقة_تمرير_واجهة.مجزأ -> {
            أرجع موقع_تمرير_واجهة.مجزأ(المواقع);
        }
        | طريقة_تمرير_واجهة.متجاهل -> {
            أرجع موقع_تمرير_واجهة.متجاهل();
        };
    };

    الحالة_الحالية.سجل_صحيح_تال := وصف_الخصائص.عدد_سجلات_المعاملات_الصحيحة;
    *الحالة := الحالة_الحالية;
    أرجع ضع_على_المكدس_ماك_ذراع_أربعة_وستون(الخصائص, &القيم, الحالة);
}

عرف موقع_ناتج_ماك_ذراع_أربعة_وستون(
    التصنيف: &تصنيف_قيمة_واجهة
): موقع_تمرير_واجهة {
    دع القيم: تصنيف_قيمة_واجهة = *التصنيف;
    طابق القيم.الطريقة مع
    | طريقة_تمرير_واجهة.متجاهل -> {
        أرجع موقع_تمرير_واجهة.متجاهل();
    }
    | طريقة_تمرير_واجهة.غير_مباشر -> {
        دع المرجع: مرجع_سجل_واجهة = مرجع_سجل_ماك_ذراع_أربعة_وستون(
            فئة_سجل_واجهة.نتيجة_غير_مباشرة(),
            0,
            دور_سجل_واجهة.عنوان_نتيجة_غير_مباشرة()
        );
        أرجع موقع_تمرير_واجهة.غير_مباشر(موضع_جزء_واجهة.سجل(المرجع));
    }
    | طريقة_تمرير_واجهة.مباشر -> {
        دع الفئة: فئة_سجل_واجهة = فئة_التصنيف_أو_صحيح(&القيم);
        دع المرجع: مرجع_سجل_واجهة = مرجع_سجل_ماك_ذراع_أربعة_وستون(
            الفئة,
            0,
            دور_سجل_واجهة.ناتج()
        );
        أرجع موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.سجل(المرجع));
    }
    | طريقة_تمرير_واجهة.مجزأ -> {
        دع الأجزاء: متجه موضع_جزء_واجهة = [];
        دع المواقع: متغير متجه موضع_جزء_واجهة = الأجزاء;
        دع الفئة: فئة_سجل_واجهة = فئة_التصنيف_أو_صحيح(&القيم);
        دع ف: متغير طبيعي = 0;
        طالما (ف < القيم.عدد_الأجزاء) {
            دع المرجع: مرجع_سجل_واجهة = مرجع_سجل_ماك_ذراع_أربعة_وستون(
                الفئة,
                ف,
                دور_سجل_واجهة.ناتج()
            );
            ألحق(المواقع, موضع_جزء_واجهة.سجل(المرجع));
            ف := ف + 1;
        }
        أرجع موقع_تمرير_واجهة.مجزأ(المواقع);
    };
}

// Register-part shapes for code generators that need the C types of the
// parts: an HFA travels as N floats of one size, other register composites
// as 8-byte integer words.
عرف أشكال_ماك_ذراع_أربعة_وستون(التصنيف: &تصنيف_قيمة_واجهة, الموقع: &موقع_تمرير_واجهة): متجه شكل_جزء_واجهة {
    دع فارغة: متجه شكل_جزء_واجهة = [];
    دع القيم: تصنيف_قيمة_واجهة = *التصنيف;
    إذا (!القيم.تجميعي || !موقع_في_سجلات_واجهة(الموقع) || القيم.عدد_الأجزاء == 0) { أرجع فارغة; };
    إذا (فئة_التصنيف_أو_صحيح(&القيم) == فئة_سجل_واجهة.عائم_متجه()) {
        أرجع أشكال_أجزاء_منتظمة_واجهة(
            القيم.الحجم, القيم.الحجم / القيم.عدد_الأجزاء, القيم.عدد_الأجزاء,
            فئة_سجل_واجهة.عائم_متجه()
        );
    };
    أرجع أشكال_أجزاء_منتظمة_واجهة(القيم.الحجم, 8, القيم.عدد_الأجزاء, فئة_سجل_واجهة.عدد_صحيح());
}

عام عرف صنف_واجهة_ماك_ذراع_أربعة_وستون_دالة(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع الخصائص: خصائص_واجهة_ماك_ذراع_أربعة_وستون = خصائص_واجهة_ماك_ذراع_أربعة_وستون_جديدة();
    أرجع صنف_واجهة_ذراع_أربعة_وستون_بخصائص(&الخصائص, الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج);
}

// AAPCS64 register ABI for every SultanC call in native AArch64 Linux code;
// for C-representable types it is the platform C ABI as well.
عام عرف صنف_واجهة_إيه_إيه_بي_سي_إس_أربعة_وستون_دالة(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع الخصائص: خصائص_واجهة_ماك_ذراع_أربعة_وستون = خصائص_واجهة_إيه_إيه_بي_سي_إس_أربعة_وستون_جديدة();
    أرجع صنف_واجهة_ذراع_أربعة_وستون_بخصائص(&الخصائص, الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج);
}

عرف صنف_واجهة_ذراع_أربعة_وستون_بخصائص(
    مرجع_الخصائص: &خصائص_واجهة_ماك_ذراع_أربعة_وستون,
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع الخصائص: خصائص_واجهة_ماك_ذراع_أربعة_وستون = *مرجع_الخصائص;
    دع أنواع_المعاملات: متجه معرف_نوع = *المعاملات;
    دع حالة_النداء: متغير حالة_نداء_ماك_ذراع_أربعة_وستون = حالة_نداء_ماك_ذراع_أربعة_وستون_جديدة();
    دع خطط_المعاملات: متجه خطة_معامل_واجهة = [];
    دع الخطط: متغير متجه خطة_معامل_واجهة = خطط_المعاملات;

    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(أنواع_المعاملات) مثل طبيعي)) {
        دع نوع_المعامل: معرف_نوع = أنواع_المعاملات[ف];
        دع نتيجة_التصنيف: نتيجة تصنيف_قيمة_واجهة, خطأ_واجهة =
            صنف_ماك_ذراع_أربعة_وستون_قيمة(&الخصائص, الأنواع, الهدف, سجل_التخطيط, نوع_المعامل);
        طابق نتيجة_التصنيف مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(التصنيف) -> {
            دع الموقع: موقع_تمرير_واجهة = ضع_معامل_ماك_ذراع_أربعة_وستون(
                &الخصائص,
                &التصنيف,
                &متغير حالة_النداء
            );
            دع الأشكال: متجه شكل_جزء_واجهة = أشكال_ماك_ذراع_أربعة_وستون(&التصنيف, &الموقع);
            دع الخطة: خطة_معامل_واجهة = {
                الفهرس: ف,
                النوع: نوع_المعامل,
                التصنيف: التصنيف,
                الموقع: الموقع,
                أشكال_الأجزاء: الأشكال
            };
            ألحق(الخطط, الخطة);
        };
        ف := ف + 1;
    }

    دع نتيجة_تصنيف_الناتج: نتيجة تصنيف_قيمة_واجهة, خطأ_واجهة =
        صنف_ماك_ذراع_أربعة_وستون_قيمة(&الخصائص, الأنواع, الهدف, سجل_التخطيط, الناتج);
    طابق نتيجة_تصنيف_الناتج مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(تصنيف_الناتج) -> {
        دع موقع_الناتج: موقع_تمرير_واجهة = موقع_ناتج_ماك_ذراع_أربعة_وستون(&تصنيف_الناتج);
        دع أشكال_الناتج: متجه شكل_جزء_واجهة = أشكال_ماك_ذراع_أربعة_وستون(&تصنيف_الناتج, &موقع_الناتج);
        دع خطة_الناتج: خطة_ناتج_واجهة = {
            النوع: الناتج,
            التصنيف: تصنيف_الناتج,
            الموقع: موقع_الناتج,
            أشكال_الأجزاء: أشكال_الناتج
        };
        دع حجم_مكدس_النداء: طبيعي = محاذاة_لأعلى(
            حالة_النداء.حجم_المكدس,
            الخصائص.محاذاة_مكدس_النداء
        );
        دع الخطة: خطة_دالة_واجهة = {
            المعاملات: الخطط,
            الناتج: خطة_الناتج,
            حجم_مكدس_النداء: حجم_مكدس_النداء,
            محاذاة_مكدس_النداء: الخصائص.محاذاة_مكدس_النداء
        };
        أرجع نتيجة.نجح(الخطة);
    };
}

// استعلام سياسة ABI للمحاذاة المطلوبة للإطار عند تخصيص تخزين الانسكاب.
عام عرف محاذاة_إطار_ماك_ذراع_أربعة_وستون(): طبيعي {
    دع الخصائص: خصائص_واجهة_ماك_ذراع_أربعة_وستون = خصائص_واجهة_ماك_ذراع_أربعة_وستون_جديدة();
    أرجع الخصائص.محاذاة_مكدس_النداء;
}
