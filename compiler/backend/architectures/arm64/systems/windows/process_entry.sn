استورد compiler.backend.architectures.arm64.encoded_code;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.object.object_reference_model;

// Native AArch64 Windows machine code that no MSIR function describes: the
// PE process entry and the stack probe of a large frame.

عرف ألحق_كلمة_ويندوز_ذراع(الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة, القيمة: طبيعي): فراغ {
    دع الكلمة: كلمة_ذراع_أربعة_وستون_مشفرة = { القيمة: القيمة };
    ألحق(*الكلمات, الكلمة);
}

عرف ألحق_نداء_ويندوز_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الإزاحات: &متغير متجه إزاحة_دخول_لينكس_ذراع,
    الدالة: معرف_دالة_منتقاة
): فراغ {
    دع الموضع: طبيعي = (الطول(*الكلمات) مثل طبيعي) * 4;
    ألحق_كلمة_ويندوز_ذراع(الكلمات, 0x94000000);
    دع الطلب: إزاحة_دخول_لينكس_ذراع = {
        إزاحة_بايت: الموضع,
        النوع: نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت(),
        الرمز: مرجع_رمز_كائن.دالة(الدالة)
    };
    ألحق(*الإزاحات, الطلب);
}

// The PE entry point `_start` (link/coff/names.sn): the loader calls it with
// no arguments. No C runtime runs the module initializer of an executable,
// so the entry calls it, then the language entry, whose W0 status is the
// std exit provider's argument (it ends the process through ExitProcess):
//   stp x29,x30,[sp,#-16]!; mov x29,sp; [bl init]; bl entry; bl exit; brk #0
عام عرف دخول_عملية_ويندوز_ذراع(
    دالة_الدخول: معرف_دالة_منتقاة,
    دالة_الخروج: معرف_دالة_منتقاة,
    المنشئ: اختياري معرف_دالة_منتقاة
): دخول_عملية_لينكس_ذراع {
    دع الكلمات: متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة = [];
    دع الإزاحات: متغير متجه إزاحة_دخول_لينكس_ذراع = [];
    ألحق_كلمة_ويندوز_ذراع(&متغير الكلمات, 0xA9BF7BFD);
    ألحق_كلمة_ويندوز_ذراع(&متغير الكلمات, 0x910003FD);
    طابق المنشئ مع
    | اختياري.موجود(المعرف) -> { ألحق_نداء_ويندوز_ذراع(&متغير الكلمات, &متغير الإزاحات, المعرف); }
    | اختياري.لا_شيء -> { };
    ألحق_نداء_ويندوز_ذراع(&متغير الكلمات, &متغير الإزاحات, دالة_الدخول);
    ألحق_نداء_ويندوز_ذراع(&متغير الكلمات, &متغير الإزاحات, دالة_الخروج);
    ألحق_كلمة_ويندوز_ذراع(&متغير الكلمات, 0xD4200000);
    دع الدخول: دخول_عملية_لينكس_ذراع = { الكلمات: الكلمات, الإزاحات: الإزاحات };
    أرجع الدخول;
}

// The prologue's stack allocation of a frame of a page or more on Windows,
// which commits the stack one guard page at a time: SP moves down by at most
// 4080 bytes per step and each step stores to the new SP, so every page is
// touched in order: sub sp,sp,#n; str xzr,[sp].
عام عرف كلمات_طرح_مكدس_بمسبار_ويندوز_ذراع(الحجم: طبيعي): متجه طبيعي {
    دع الكلمات: متغير متجه طبيعي = [];
    دع الباقي: متغير طبيعي = الحجم;
    طالما (الباقي > 0) {
        دع الجزء: متغير طبيعي = الباقي;
        إذا (الجزء > 4080) { الجزء := 4080; };
        ألحق(الكلمات, 0xD1000000 + الجزء * 1024 + 992 + 31);
        ألحق(الكلمات, 0xF90003FF);
        الباقي := الباقي - الجزء;
    }
    أرجع الكلمات;
}
