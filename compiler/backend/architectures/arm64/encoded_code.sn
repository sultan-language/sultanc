استورد compiler.backend.architectures.arm64.allocated_code;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.target.target_model;
استورد compiler.backend.object.object_reference_model;

// ناتج AArch64 المشفر يبقى ملك المعمارية. الكاتب الكائني اللاحق يترجم التثبيتات إلى تنسيق الكائن المختار.
عام نوع كلمة_ذراع_أربعة_وستون_مشفرة = {
    القيمة: غير_موقع
};

عام نوع نوع_تثبيت_ذراع_أربعة_وستون =
    | فرع_برابط_ستة_وعشرون_بت
;

عام نوع تثبيت_ذراع_أربعة_وستون = {
    إزاحة_بايت: غير_موقع,
    النوع: نوع_تثبيت_ذراع_أربعة_وستون,
    الدالة: معرف_دالة_منتقاة,
    الإضافة: عدد
};

عام نوع دالة_ذراع_أربعة_وستون_مشفرة = {
    المعرف: معرف_دالة_منتقاة,
    الكلمات: متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    التثبيتات: متجه تثبيت_ذراع_أربعة_وستون
};

عام نوع شفرة_ذراع_أربعة_وستون_مشفرة = {
    الهدف: معرف_هدف,
    الدوال: متجه دالة_ذراع_أربعة_وستون_مشفرة,
    المرفقات: مرفقات_كائن_مشفرة
};

عام عرف ابن_تثبيت_نداء_ذراع_مشفّر(
    الموضع: غير_موقع,
    الدالة: معرف_دالة_منتقاة
): تثبيت_ذراع_أربعة_وستون {
    دع النوع: نوع_تثبيت_ذراع_أربعة_وستون =
        نوع_تثبيت_ذراع_أربعة_وستون.فرع_برابط_ستة_وعشرون_بت();
    دع الناتج: تثبيت_ذراع_أربعة_وستون = {
        إزاحة_بايت: الموضع,
        النوع: النوع,
        الدالة: الدالة,
        الإضافة: 0
    };
    أرجع الناتج;
}


// نسخ صريح لحد Target/runtime completion. لا ننقل حقولاً مملوكة جزئياً من الشفرة المشفرة.
عام عرف انسخ_كلمات_ذراع_أربعة_وستون_مشفرة(
    المدخل: &متجه كلمة_ذراع_أربعة_وستون_مشفرة
): متجه كلمة_ذراع_أربعة_وستون_مشفرة {
    دع المصدر: متجه كلمة_ذراع_أربعة_وستون_مشفرة = *المدخل;
    دع الناتج: متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع الكلمة: كلمة_ذراع_أربعة_وستون_مشفرة = المصدر[ف];
        دع النسخة: كلمة_ذراع_أربعة_وستون_مشفرة = { القيمة: الكلمة.القيمة };
        ألحق(الناتج, النسخة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_تثبيتات_ذراع_أربعة_وستون_مشفرة(
    المدخل: &متجه تثبيت_ذراع_أربعة_وستون
): متجه تثبيت_ذراع_أربعة_وستون {
    دع المصدر: متجه تثبيت_ذراع_أربعة_وستون = *المدخل;
    دع الناتج: متغير متجه تثبيت_ذراع_أربعة_وستون = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع التثبيت: تثبيت_ذراع_أربعة_وستون = المصدر[ف];
        دع النسخة: تثبيت_ذراع_أربعة_وستون = {
            إزاحة_بايت: التثبيت.إزاحة_بايت,
            النوع: التثبيت.النوع,
            الدالة: التثبيت.الدالة,
            الإضافة: التثبيت.الإضافة
        };
        ألحق(الناتج, النسخة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_دالة_ذراع_أربعة_وستون_مشفرة(
    المدخل: &دالة_ذراع_أربعة_وستون_مشفرة
): دالة_ذراع_أربعة_وستون_مشفرة {
    دع القيمة: دالة_ذراع_أربعة_وستون_مشفرة = *المدخل;
    دع الكلمات: متجه كلمة_ذراع_أربعة_وستون_مشفرة =
        انسخ_كلمات_ذراع_أربعة_وستون_مشفرة(&القيمة.الكلمات);
    دع التثبيتات: متجه تثبيت_ذراع_أربعة_وستون =
        انسخ_تثبيتات_ذراع_أربعة_وستون_مشفرة(&القيمة.التثبيتات);
    دع الناتج: دالة_ذراع_أربعة_وستون_مشفرة = {
        المعرف: القيمة.المعرف,
        الكلمات: الكلمات,
        التثبيتات: التثبيتات
    };
    أرجع الناتج;
}
