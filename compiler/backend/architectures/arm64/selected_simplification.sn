استورد compiler.backend.architectures.arm64.instruction_model;
استورد compiler.backend.architectures.arm64.selected_code;
استورد compiler.backend.architectures.arm64.allocation_constraints;
استورد compiler.backend.architectures.arm64.encoder;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.target.target_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.checked_arithmetic;

// Simplifies a selected AArch64 function before register allocation (native
// object path only; the machine interpreter translates the selector's code
// as it is, as on x86-64, whose selected_simplification.sn this mirrors):
// - a checked add, subtract or multiply that reports its overflow
//   (msir/checked_arithmetic.sn) is one operation whose overflow test
//   branches to the report block (ادمج_حسابات_بمخرج_ذراع);
// - a compare against a constant 0..4095 takes it as an immediate (CMP #imm);
// - a compare whose truth value only feeds the block's two-way branch sets
//   the flags for it: CMP, B.cond instead of CMP, CSET, CMP #0, B.NE;
// - a branch on a value against 0 is CBZ or CBNZ, and on one bit of a value
//   (x & 2^k against 0) a bit test (TBZ/TBNZ or TST and B.cond, encoder.sn);
// - a wrapping add or subtract of a constant 0..4095 (or its negation), and
//   an AND, ORR or EOR with a logical immediate, take it as an immediate; so
//   does a checked add or subtract with an overflow exit (ADDS/SUBS #imm);
// - constant materializations nothing reads any more are dropped.
// Branch layout (fall-through, threading) is the encoder's
// (شفّر_فرع_مخطط_ذراع).

// ---- Checked arithmetic with an overflow exit --------------------------------------
//
// K, which ended in the overflow test, a compare of its truth value with 0
// and a two-way branch to the report block or C, ends instead in the checked
// operation itself, in the form whose overflow goes to the report block
// (حساب_صحيح_بمخرج_ذراع: ADDS and B.VS for a signed 64-bit add, B.CS or
// B.CC for an unsigned one, a narrow result's extension compare and B.NE,
// SMULH/UMULH's high-word compare and B.NE for a multiply), and a branch to
// C. C loses its first instruction, the checked operation, whose register
// the fused one now defines. The test's own instructions go, and the blocks
// only the test runs (a multiply's slow path or second bound) become a lone
// BRK nothing branches to. The report block and its call are untouched.

// The register an instruction of a test defines, when it is one a test owns:
// a constant, a move, a condition set, a conversion, wrapping or bitwise
// arithmetic.
عرف وجهة_تعليمة_اختبار_ذراع(التعليمة: &تعليمة_ذراع_أربعة_وستون): اختياري معرف_سجل_افتراضي {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_ذراع_أربعة_وستون.تحويل_صحيح_ذراع(التحويل) -> { أرجع اختياري.موجود(التحويل.الوجهة); }
    | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(الحساب) -> {
        طابق الحساب.العملية مع
        | عملية_حساب_ذراع_أربعة_وستون.جمع_ملتف -> { أرجع اختياري.موجود(الحساب.الوجهة); }
        | عملية_حساب_ذراع_أربعة_وستون.طرح_ملتف -> { أرجع اختياري.موجود(الحساب.الوجهة); }
        | عملية_حساب_ذراع_أربعة_وستون.ضرب_ملتف -> { أرجع اختياري.موجود(الحساب.الوجهة); }
        | عملية_حساب_ذراع_أربعة_وستون.و_بتي -> { أرجع اختياري.موجود(الحساب.الوجهة); }
        | عملية_حساب_ذراع_أربعة_وستون.أو_بتي -> { أرجع اختياري.موجود(الحساب.الوجهة); }
        | عملية_حساب_ذراع_أربعة_وستون.أو_حصري -> { أرجع اختياري.موجود(الحساب.الوجهة); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Whether the instruction only sets the flags (a compare).
عرف مقارنة_أعلام_ذراع(التعليمة: &تعليمة_ذراع_أربعة_وستون): منطقي {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(_, _) -> { أرجع صواب; }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(_, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether the instruction sets a condition into a register.
عرف ثبت_شرط_هي_ذراع(التعليمة: &تعليمة_ذراع_أربعة_وستون): منطقي {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(_, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether the register holds a value only an overflow test reads.
عرف قيمة_اختبار_ذراع(الحسابات: &حسابات_بمخرج_تجاوز_مسير, السجل: معرف_سجل_افتراضي): منطقي {
    أرجع السجل.القيمة < (الطول((*الحسابات).قيم_الاختبار) مثل طبيعي) && (*الحسابات).قيم_الاختبار[السجل.القيمة];
}

// Whether السجل is one of السجلات.
عرف سجل_من_ذراع(السجلات: &متجه معرف_سجل_افتراضي, السجل: معرف_سجل_افتراضي): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السجلات) مثل طبيعي)) {
        إذا ((*السجلات)[ف].القيمة == السجل.القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// A block's provenance ranges after its instructions moved: old index i now
// starts at الموقع_الجديد[i] (one entry per old index and one for the end).
// A range left empty goes.
عرف أعد_مديات_الأصول_ذراع(
    الأصول: &متجه مدى_أصل_تعليمات,
    الموقع_الجديد: &متجه طبيعي
): متجه مدى_أصل_تعليمات {
    ليكن العدد: طبيعي = (الطول(*الموقع_الجديد) مثل طبيعي) - 1;
    ليكن الناتج: متغير متجه مدى_أصل_تعليمات = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأصول) مثل طبيعي)) {
        ليكن المدى: متغير مدى_أصل_تعليمات = (*الأصول)[ف];
        إذا (المدى.البداية <= العدد && المدى.النهاية <= العدد) {
            ليكن البداية: طبيعي = (*الموقع_الجديد)[المدى.البداية];
            ليكن النهاية: طبيعي = (*الموقع_الجديد)[المدى.النهاية];
            المدى.البداية := البداية;
            المدى.النهاية := النهاية;
            إذا (النهاية > البداية) { ألحق(الناتج, المدى); };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Keeps the instructions of a block that المحذوفة does not mark, with
// their provenance.
عرف أبق_تعليمات_كتلة_ذراع(
    الكتلة: &متغير كتلة_ذراع_أربعة_وستون_منتقاة,
    المحذوفة: &متجه منطقي
): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    ليكن الباقية: متغير متجه تعليمة_ذراع_أربعة_وستون = [];
    ليكن الموقع_الجديد: متغير متجه طبيعي = [];
    ليكن حذف: متغير منطقي = خطأ;
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
        إذا (ت < (الطول(*المحذوفة) مثل طبيعي) && (*المحذوفة)[ت]) {
            حذف := صواب;
        } وإلا {
            ليكن المنقولة: متغير تعليمة_ذراع_أربعة_وستون = تعليمة_ذراع_أربعة_وستون.فخ_ذراع();
            بدّل((*الكتلة).التعليمات[ت], المنقولة);
            ألحق(الباقية, المنقولة);
        };
        ت := ت + 1;
    }
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    إذا (!حذف) {
        (*الكتلة).التعليمات := الباقية;
        أرجع;
    };
    ليكن الأصول: متجه مدى_أصل_تعليمات = أعد_مديات_الأصول_ذراع(&(*الكتلة).أصول_التعليمات, &الموقع_الجديد);
    (*الكتلة).التعليمات := الباقية;
    (*الكتلة).أصول_التعليمات := الأصول;
}

// Fuses one check; false (nothing changed) when its code is not the form
// the selector makes.
عرف ادمج_حسابا_بمخرج_ذراع(
    الدالة: &متغير دالة_ذراع_أربعة_وستون_منتقاة,
    الحسابات: &حسابات_بمخرج_تجاوز_مسير,
    السجل: &حساب_بمخرج_تجاوز_مسير,
    الهدف: &واصف_هدف
): منطقي {
    ليكن عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    ليكن ك: طبيعي = (*السجل).الكتلة;
    ليكن م: طبيعي = (*السجل).المتابعة;
    ليكن ب: طبيعي = (*السجل).البارد;
    إذا (ك >= عدد_الكتل || م >= عدد_الكتل || ب >= عدد_الكتل) { أرجع خطأ; };
    // Selected blocks are MSIR's, in its order.
    إذا ((*الدالة).الكتل[ك].الرأس.المعرف.القيمة != ك || (*الدالة).الكتل[م].الرأس.المعرف.القيمة != م
        || (*الدالة).الكتل[ب].الرأس.المعرف.القيمة != ب) { أرجع خطأ; };
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*السجل).المنطقة) مثل طبيعي)) {
        ليكن ه: طبيعي = (*السجل).المنطقة[ر];
        إذا (ه >= عدد_الكتل || ه == ك || ه == م || ه == ب) { أرجع خطأ; };
        إذا ((*الدالة).الكتل[ه].الرأس.المعرف.القيمة != ه) { أرجع خطأ; };
        ر := ر + 1;
    }
    // C's head: the checked operation.
    إذا ((الطول((*الدالة).الكتل[م].التعليمات) مثل طبيعي) == 0) { أرجع خطأ; };
    ليكن المدمجة: متغير اختياري تعليمة_ذراع_أربعة_وستون = اختياري.لا_شيء();
    ليكن معرف_البارد: معرف_كتلة_منتقاة = (*الدالة).الكتل[ب].الرأس.المعرف;
    ليكن معرف_المتابعة: معرف_كتلة_منتقاة = (*الدالة).الكتل[م].الرأس.المعرف;
    طابق (*الدالة).الكتل[م].التعليمات[0] مع
    | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(الحساب) -> {
        إذا (الحساب.الوجهة.القيمة == ((*السجل).الناتج.القيمة مثل طبيعي)
            && الحساب.اليسار.القيمة == ((*السجل).اليسار.القيمة مثل طبيعي)
            && الحساب.اليمين.القيمة == ((*السجل).اليمين.القيمة مثل طبيعي)
            && (!(*السجل).إشارة_معروفة || (*السجل).موقع == الحساب.الوصف.موقع)) {
            ليكن مفحوصة: متغير منطقي = خطأ;
            طابق الحساب.العملية مع
            | عملية_حساب_ذراع_أربعة_وستون.جمع -> { مفحوصة := صواب; }
            | عملية_حساب_ذراع_أربعة_وستون.طرح -> { مفحوصة := صواب; }
            | عملية_حساب_ذراع_أربعة_وستون.ضرب -> { مفحوصة := صواب; }
            | _ -> { };
            إذا (مفحوصة) {
                المدمجة := اختياري.موجود(تعليمة_ذراع_أربعة_وستون.حساب_صحيح_بمخرج_ذراع(الحساب, معرف_البارد));
            };
        };
    }
    | _ -> { };
    ليكن العملية_المدمجة: تعليمة_ذراع_أربعة_وستون;
    طابق المدمجة مع
    | اختياري.موجود(ت_) -> { العملية_المدمجة := ت_; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    // K ends in the selector's two-way branch: compare the truth value with
    // 0, B.NE to the true edge, B to the false edge.
    ليكن العدد: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
    إذا (العدد < 3) { أرجع خطأ; };
    طابق (*الدالة).الكتل[ك].التعليمات[العدد - 3] مع
    | تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(س, الفوري) -> {
        إذا (الفوري != 0 || س.القيمة != ((*السجل).الشرط.القيمة مثل طبيعي)) { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
    طابق (*الدالة).الكتل[ك].التعليمات[العدد - 2] مع
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(_, _) -> { }
    | _ -> { أرجع خطأ; };
    طابق (*الدالة).الكتل[ك].التعليمات[العدد - 1] مع
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(_) -> { }
    | _ -> { أرجع خطأ; };
    // The test's instructions go (a compare whose condition set goes with
    // it); nothing kept may read what they define.
    ليكن محذوفة: متغير متجه منطقي = [];
    ليكن المحذوفة_سجلات: متغير متجه معرف_سجل_افتراضي = [];
    ليكن ت: متغير طبيعي = 0;
    طالما (ت + 3 < العدد) {
        ليكن تحذف: متغير منطقي = خطأ;
        طابق وجهة_تعليمة_اختبار_ذراع(&(*الدالة).الكتل[ك].التعليمات[ت]) مع
        | اختياري.موجود(و) -> {
            إذا (قيمة_اختبار_ذراع(الحسابات, و)) { تحذف := صواب; ألحق(المحذوفة_سجلات, و); };
        }
        | اختياري.لا_شيء -> { };
        ألحق(محذوفة, تحذف);
        ت := ت + 1;
    }
    ت := 0;
    طالما (ت + 4 < العدد) {
        إذا (مقارنة_أعلام_ذراع(&(*الدالة).الكتل[ك].التعليمات[ت]) && محذوفة[ت + 1]
            && ثبت_شرط_هي_ذراع(&(*الدالة).الكتل[ك].التعليمات[ت + 1])) {
            محذوفة[ت] := صواب;
        };
        ت := ت + 1;
    }
    ت := 0;
    طالما (ت + 3 < العدد) {
        إذا (!محذوفة[ت]) {
            ليكن الحقيقة: حقيقة_تعليمة_تخصيص = حقيقة_تخصيص_تعليمة_ذراع(
                &(*الدالة).الكتل[ك].التعليمات[ت], الهدف, 0
            );
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الحقيقة.الاستخدامات) مثل طبيعي)) {
                إذا (سجل_من_ذراع(&المحذوفة_سجلات, الحقيقة.الاستخدامات[ع].السجل)) { أرجع خطأ; };
                ع := ع + 1;
            }
        };
        ت := ت + 1;
    }
    // K: the kept instructions, the fused operation and the branch to C.
    ليكن الموقع_الجديد: متغير متجه طبيعي = [];
    ليكن الباقية: متغير متجه تعليمة_ذراع_أربعة_وستون = [];
    ت := 0;
    طالما (ت + 3 < العدد) {
        ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
        إذا (!محذوفة[ت]) {
            ليكن المنقولة: متغير تعليمة_ذراع_أربعة_وستون = تعليمة_ذراع_أربعة_وستون.فخ_ذراع();
            بدّل((*الدالة).الكتل[ك].التعليمات[ت], المنقولة);
            ألحق(الباقية, المنقولة);
        };
        ت := ت + 1;
    }
    // The three branch instructions map onto the fused operation and the
    // branch.
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    ألحق(الباقية, العملية_المدمجة);
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    ليكن بلا_نقلات: متجه نقلة_حافة_منتقاة = [];
    ليكن حزمة_المتابعة: متطلبات_نقل_حافة_منتقاة = { الهدف: معرف_المتابعة, النقلات: بلا_نقلات };
    ألحق(الباقية, تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(حزمة_المتابعة));
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    ليكن الأصول: متجه مدى_أصل_تعليمات = أعد_مديات_الأصول_ذراع(&(*الدالة).الكتل[ك].أصول_التعليمات, &الموقع_الجديد);
    (*الدالة).الكتل[ك].التعليمات := الباقية;
    (*الدالة).الكتل[ك].أصول_التعليمات := الأصول;
    ليكن الخلفاء: متغير متجه معرف_كتلة_منتقاة = [];
    ألحق(الخلفاء, معرف_البارد);
    ألحق(الخلفاء, معرف_المتابعة);
    (*الدالة).الكتل[ك].الرأس.الخلفاء := الخلفاء;
    // C without its head.
    ليكن رأس_محذوف: متغير متجه منطقي = [];
    ألحق(رأس_محذوف, صواب);
    أبق_تعليمات_كتلة_ذراع(&متغير (*الدالة).الكتل[م], &رأس_محذوف);
    // The test's own blocks: nothing branches to them any more.
    ر := 0;
    طالما (ر < (الطول((*السجل).المنطقة) مثل طبيعي)) {
        ليكن ه: طبيعي = (*السجل).المنطقة[ر];
        ليكن الفخ: متجه تعليمة_ذراع_أربعة_وستون = [تعليمة_ذراع_أربعة_وستون.فخ_ذراع()];
        ليكن بلا_أصول: متجه مدى_أصل_تعليمات = [];
        ليكن بلا_خلفاء: متجه معرف_كتلة_منتقاة = [];
        (*الدالة).الكتل[ه].التعليمات := الفخ;
        (*الدالة).الكتل[ه].أصول_التعليمات := بلا_أصول;
        (*الدالة).الكتل[ه].الرأس.الخلفاء := بلا_خلفاء;
        ر := ر + 1;
    }
    أرجع صواب;
}

// Fuses every check of the function.
عرف ادمج_حسابات_بمخرج_ذراع(
    الدالة: &متغير دالة_ذراع_أربعة_وستون_منتقاة,
    الحسابات: &حسابات_بمخرج_تجاوز_مسير,
    الهدف: &واصف_هدف
): فراغ {
    إذا ((الطول((*الدالة).الكتل) مثل طبيعي) != (الطول((*الحسابات).اختبار_الكتلة) مثل طبيعي)) { أرجع; };
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*الحسابات).الحسابات) مثل طبيعي)) {
        ادمج_حسابا_بمخرج_ذراع(الدالة, الحسابات, &(*الحسابات).الحسابات[ر], الهدف);
        ر := ر + 1;
    }
}

// ---- Counts and constants ------------------------------------------------------------

نوع عدادات_سجلات_ذراع = {
    التعريفات: متجه طبيعي,
    الاستخدامات: متجه طبيعي
};

عرف زد_عداد_سجل_ذراع(العدادات: &متغير متجه طبيعي, السجل: معرف_سجل_افتراضي): فراغ {
    إذا (السجل.القيمة < (الطول(*العدادات) مثل طبيعي)) {
        (*العدادات)[السجل.القيمة] := (*العدادات)[السجل.القيمة] + 1;
    };
}

عرف عد_نقلات_حافة_ذراع(الحزمة: &متطلبات_نقل_حافة_منتقاة, العدادات: &متغير عدادات_سجلات_ذراع): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحزمة).النقلات) مثل طبيعي)) {
        زد_عداد_سجل_ذراع(&متغير (*العدادات).الاستخدامات, (*الحزمة).النقلات[ف].المصدر);
        زد_عداد_سجل_ذراع(&متغير (*العدادات).التعريفات, (*الحزمة).النقلات[ف].الوجهة);
        ف := ف + 1;
    }
}

// Definitions and uses of every virtual register, as the allocator sees them
// (its instruction facts, plus the edge moves).
عرف عد_سجلات_دالة_ذراع(
    الدالة: &دالة_ذراع_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): عدادات_سجلات_ذراع {
    ليكن العدد: طبيعي = (*الدالة).الرأس.عدد_السجلات_الافتراضية;
    ليكن التعريفات: متغير متجه طبيعي = [];
    ليكن الاستخدامات: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(التعريفات, 0); ألحق(الاستخدامات, 0); ف := ف + 1; }
    ليكن العدادات: متغير عدادات_سجلات_ذراع = { التعريفات: التعريفات, الاستخدامات: الاستخدامات };
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ليكن التعليمة: &تعليمة_ذراع_أربعة_وستون = &(*الدالة).الكتل[ك].التعليمات[ت];
            ليكن الحقيقة: حقيقة_تعليمة_تخصيص = حقيقة_تخصيص_تعليمة_ذراع(التعليمة, الهدف, 0);
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الحقيقة.الاستخدامات) مثل طبيعي)) {
                زد_عداد_سجل_ذراع(&متغير العدادات.الاستخدامات, الحقيقة.الاستخدامات[ع].السجل);
                ع := ع + 1;
            }
            ع := 0;
            طالما (ع < (الطول(الحقيقة.التعريفات) مثل طبيعي)) {
                زد_عداد_سجل_ذراع(&متغير العدادات.التعريفات, الحقيقة.التعريفات[ع].السجل);
                ع := ع + 1;
            }
            طابق *التعليمة مع
            | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(الحزمة) -> { عد_نقلات_حافة_ذراع(&الحزمة, &متغير العدادات); }
            | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(_, الحزمة) -> { عد_نقلات_حافة_ذراع(&الحزمة, &متغير العدادات); }
            | تعليمة_ذراع_أربعة_وستون.فرع_صفري_ذراع(_, _, الحزمة) -> { عد_نقلات_حافة_ذراع(&الحزمة, &متغير العدادات); }
            | تعليمة_ذراع_أربعة_وستون.فرع_بت_ذراع(_, _, _, الحزمة) -> { عد_نقلات_حافة_ذراع(&الحزمة, &متغير العدادات); }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع العدادات;
}

// The 64-bit pattern of each register defined once, by a constant
// materialization.
عرف ثوابت_سجلات_دالة_ذراع(
    الدالة: &دالة_ذراع_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_ذراع
): متجه اختياري طبيعي {
    ليكن الناتج: متغير متجه اختياري طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (*الدالة).الرأس.عدد_السجلات_الافتراضية) { ألحق(الناتج, اختياري.لا_شيء()); ف := ف + 1; }
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ليكن السجل: متغير اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
            ليكن القيمة: متغير طبيعي = 0;
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(الوجهة, العدد) -> {
                السجل := اختياري.موجود(الوجهة); القيمة := العدد مثل طبيعي;
            }
            | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(الوجهة, الخام) -> {
                السجل := اختياري.موجود(الوجهة); القيمة := الخام;
            }
            | _ -> { };
            طابق السجل مع
            | اختياري.موجود(س) -> {
                إذا (س.القيمة < (الطول(الناتج) مثل طبيعي) && (*العدادات).التعريفات[س.القيمة] == 1) {
                    الناتج[س.القيمة] := اختياري.موجود(القيمة);
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الناتج;
}

عرف ثابت_سجل_ذراع(الثوابت: &متجه اختياري طبيعي, السجل: معرف_سجل_افتراضي): اختياري طبيعي {
    إذا (السجل.القيمة >= (الطول(*الثوابت) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*الثوابت)[السجل.القيمة];
}

// A constant usable as an arithmetic immediate (0..4095).
عرف فوري_حسابي_ذراع(الثوابت: &متجه اختياري طبيعي, السجل: معرف_سجل_افتراضي): اختياري طبيعي {
    طابق ثابت_سجل_ذراع(الثوابت, السجل) مع
    | اختياري.موجود(ق) -> { إذا (ق <= 4095) { أرجع اختياري.موجود(ق); }; }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// The negation of a constant whose negation is an arithmetic immediate
// (-4095..-1 as a 64-bit pattern).
عرف فوري_سالب_ذراع(الثوابت: &متجه اختياري طبيعي, السجل: معرف_سجل_افتراضي): اختياري طبيعي {
    طابق ثابت_سجل_ذراع(الثوابت, السجل) مع
    | اختياري.موجود(ق) -> {
        إذا (ق != 0) {
            // -ق modulo 2^64.
            ليكن السالب: طبيعي = (~ق) + 1;
            إذا (السالب <= 4095) { أرجع اختياري.موجود(السالب); };
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// The condition with its operands swapped (a < b is b > a).
عرف شرط_معكوس_الطرفين_ذراع(الشرط: شرط_ذراع_أربعة_وستون): شرط_ذراع_أربعة_وستون {
    طابق الشرط مع
    | شرط_ذراع_أربعة_وستون.أقل_بإشارة -> { أرجع شرط_ذراع_أربعة_وستون.أكبر_بإشارة(); }
    | شرط_ذراع_أربعة_وستون.أقل_أو_يساوي_بإشارة -> { أرجع شرط_ذراع_أربعة_وستون.أكبر_أو_يساوي_بإشارة(); }
    | شرط_ذراع_أربعة_وستون.أكبر_بإشارة -> { أرجع شرط_ذراع_أربعة_وستون.أقل_بإشارة(); }
    | شرط_ذراع_أربعة_وستون.أكبر_أو_يساوي_بإشارة -> { أرجع شرط_ذراع_أربعة_وستون.أقل_أو_يساوي_بإشارة(); }
    | شرط_ذراع_أربعة_وستون.أدنى_طبيعي -> { أرجع شرط_ذراع_أربعة_وستون.أعلى_طبيعي(); }
    | شرط_ذراع_أربعة_وستون.أدنى_أو_يساوي_طبيعي -> { أرجع شرط_ذراع_أربعة_وستون.أعلى_أو_يساوي_طبيعي(); }
    | شرط_ذراع_أربعة_وستون.أعلى_طبيعي -> { أرجع شرط_ذراع_أربعة_وستون.أدنى_طبيعي(); }
    | شرط_ذراع_أربعة_وستون.أعلى_أو_يساوي_طبيعي -> { أرجع شرط_ذراع_أربعة_وستون.أدنى_أو_يساوي_طبيعي(); }
    | _ -> { أرجع الشرط; };
}

// Whether the condition is equality (false: inequality); none for others.
عرف شرط_مساواة_ذراع(الشرط: شرط_ذراع_أربعة_وستون): اختياري منطقي {
    طابق الشرط مع
    | شرط_ذراع_أربعة_وستون.تكافؤ -> { أرجع اختياري.موجود(صواب); }
    | شرط_ذراع_أربعة_وستون.لاتكافؤ -> { أرجع اختياري.موجود(خطأ); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// ---- Compares and branches -------------------------------------------------------

// Compares against a constant 0..4095 take it as an immediate; a constant
// on the left swaps the operands and the condition set from them.
عرف بسط_مقارنات_كتلة_ذراع(
    الكتلة: &متغير كتلة_ذراع_أربعة_وستون_منتقاة,
    الثوابت: &متجه اختياري طبيعي
): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        ليكن الجديدة: متغير اختياري تعليمة_ذراع_أربعة_وستون = اختياري.لا_شيء();
        ليكن الشرط_الجديد: متغير اختياري تعليمة_ذراع_أربعة_وستون = اختياري.لا_شيء();
        طابق (*الكتلة).التعليمات[ت] مع
        | تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(أ, ب) -> {
            طابق فوري_حسابي_ذراع(الثوابت, ب) مع
            | اختياري.موجود(الفوري) -> {
                الجديدة := اختياري.موجود(تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(أ, الفوري));
            }
            | اختياري.لا_شيء -> {
                طابق فوري_حسابي_ذراع(الثوابت, أ) مع
                | اختياري.موجود(الفوري) -> {
                    إذا (ت + 1 < العدد) {
                        طابق (*الكتلة).التعليمات[ت + 1] مع
                        | تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(الوجهة, الشرط) -> {
                            الجديدة := اختياري.موجود(تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(ب, الفوري));
                            الشرط_الجديد := اختياري.موجود(تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(
                                الوجهة, شرط_معكوس_الطرفين_ذراع(الشرط)
                            ));
                        }
                        | _ -> { };
                    };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | _ -> { };
        طابق الجديدة مع
        | اختياري.موجود(التعليمة) -> { (*الكتلة).التعليمات[ت] := التعليمة; }
        | اختياري.لا_شيء -> { };
        طابق الشرط_الجديد مع
        | اختياري.موجود(التعليمة) -> { (*الكتلة).التعليمات[ت + 1] := التعليمة; }
        | اختياري.لا_شيء -> { };
        ت := ت + 1;
    }
}

// Whether the instruction materializes a constant (which leaves the flags).
عرف ثابت_مادي_ذراع(التعليمة: &تعليمة_ذراع_أربعة_وستون): منطقي {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(_, _) -> { أرجع صواب; }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(_, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The block's two-way branch on a truth value, as the selector makes it:
// CMP value, #0; B.NE true; B false. The value, when the block ends so.
عرف قيمة_فرع_ثنائي_ذراع(الكتلة: &كتلة_ذراع_أربعة_وستون_منتقاة): اختياري معرف_سجل_افتراضي {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    إذا (العدد < 3) { أرجع اختياري.لا_شيء(); };
    طابق (*الكتلة).التعليمات[العدد - 1] مع
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(_) -> { }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق (*الكتلة).التعليمات[العدد - 2] مع
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(الشرط, _) -> {
        طابق شرط_مساواة_ذراع(الشرط) مع
        | اختياري.موجود(مساواة) -> { إذا (مساواة) { أرجع اختياري.لا_شيء(); }; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق (*الكتلة).التعليمات[العدد - 3] مع
    | تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(القيمة, الفوري) -> {
        إذا (الفوري == 0) { أرجع اختياري.موجود(القيمة); };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// A compare whose truth value only the block's two-way branch reads sets
// the flags for that branch: CMP, CSET c, (constants), CMP c, #0, B.NE T
// becomes (constants), CMP, B.cond T. The compare moves down over the
// constant materializations between (they leave the flags).
عرف ادمج_مقارنة_وفرع_كتلة_ذراع(
    الكتلة: &متغير كتلة_ذراع_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_ذراع,
    المحذوفة: &متغير متجه منطقي
): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    ليكن القيمة: معرف_سجل_افتراضي;
    طابق قيمة_فرع_ثنائي_ذراع(الكتلة) مع
    | اختياري.موجود(ق) -> { القيمة := ق; }
    | اختياري.لا_شيء -> { أرجع; };
    إذا (القيمة.القيمة >= (الطول((*العدادات).الاستخدامات) مثل طبيعي)) { أرجع; };
    إذا ((*العدادات).الاستخدامات[القيمة.القيمة] != 1 || (*العدادات).التعريفات[القيمة.القيمة] != 1) { أرجع; };
    // Walk up over constants to the condition set.
    ليكن ت: متغير طبيعي = العدد - 3;
    ليكن استمر: متغير منطقي = صواب;
    طالما (استمر && ت > 1) {
        إذا (ثابت_مادي_ذراع(&(*الكتلة).التعليمات[ت - 1]) && !(*المحذوفة)[ت - 1]) { ت := ت - 1; } وإلا { استمر := خطأ; };
    }
    // ت - 1: the condition set; ت - 2: the compare.
    إذا (ت < 2) { أرجع; };
    ليكن الشرط: شرط_ذراع_أربعة_وستون;
    طابق (*الكتلة).التعليمات[ت - 1] مع
    | تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(الوجهة, ش) -> {
        إذا (الوجهة.القيمة != القيمة.القيمة) { أرجع; };
        الشرط := ش;
    }
    | _ -> { أرجع; };
    طابق (*الكتلة).التعليمات[ت - 2] مع
    | تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(_, _) -> { }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(_, _) -> { }
    | _ -> { أرجع; };
    إذا ((*المحذوفة)[ت - 1] || (*المحذوفة)[ت - 2]) { أرجع; };
    ليكن المقارنة: متغير تعليمة_ذراع_أربعة_وستون = تعليمة_ذراع_أربعة_وستون.فخ_ذراع();
    بدّل((*الكتلة).التعليمات[ت - 2], المقارنة);
    (*المحذوفة)[ت - 2] := صواب;
    (*المحذوفة)[ت - 1] := صواب;
    (*الكتلة).التعليمات[العدد - 3] := المقارنة;
    ليكن الفرع: متغير تعليمة_ذراع_أربعة_وستون = تعليمة_ذراع_أربعة_وستون.فخ_ذراع();
    بدّل((*الكتلة).التعليمات[العدد - 2], الفرع);
    طابق الفرع مع
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(_, الحزمة) -> {
        (*الكتلة).التعليمات[العدد - 2] := تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(الشرط, الحزمة);
    }
    | _ -> { };
}

// A two-way branch on a value against 0 (CMP x, #0; B.EQ or B.NE) is CBZ or
// CBNZ; on x = a & 2^k, read only there, a bit test of a.
عرف ادمج_فرع_صفري_كتلة_ذراع(
    الكتلة: &متغير كتلة_ذراع_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_ذراع,
    الثوابت: &متجه اختياري طبيعي,
    الهدف: &واصف_هدف,
    المحذوفة: &متغير متجه منطقي
): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    إذا (العدد < 3) { أرجع; };
    ليكن المختبر: معرف_سجل_افتراضي;
    طابق (*الكتلة).التعليمات[العدد - 3] مع
    | تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(س, الفوري) -> {
        إذا (الفوري != 0) { أرجع; };
        المختبر := س;
    }
    | _ -> { أرجع; };
    إذا ((*المحذوفة)[العدد - 3]) { أرجع; };
    ليكن غير_صفري: متغير منطقي = خطأ;
    طابق (*الكتلة).التعليمات[العدد - 2] مع
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(الشرط, _) -> {
        طابق شرط_مساواة_ذراع(الشرط) مع
        | اختياري.موجود(مساواة) -> { غير_صفري := !مساواة; }
        | اختياري.لا_شيء -> { أرجع; };
    }
    | _ -> { أرجع; };
    // x = a & 2^k, read only here: test bit k of a.
    ليكن البت: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن المصدر: متغير معرف_سجل_افتراضي = المختبر;
    ليكن موضع_و: متغير طبيعي = 0;
    إذا (المختبر.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
        && (*العدادات).الاستخدامات[المختبر.القيمة] == 1 && (*العدادات).التعريفات[المختبر.القيمة] == 1) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت + 3 < العدد) {
            إذا (!(*المحذوفة)[ت]) {
                طابق (*الكتلة).التعليمات[ت] مع
                | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(الحساب) -> {
                    إذا (الحساب.الوجهة.القيمة == المختبر.القيمة) {
                        طابق الحساب.العملية مع
                        | عملية_حساب_ذراع_أربعة_وستون.و_بتي -> {
                            طابق قوة_اثنين_ذراع(ثابت_سجل_ذراع(الثوابت, الحساب.اليمين)) مع
                            | اختياري.موجود(ك) -> { البت := اختياري.موجود(ك); المصدر := الحساب.اليسار; موضع_و := ت; }
                            | اختياري.لا_شيء -> {
                                طابق قوة_اثنين_ذراع(ثابت_سجل_ذراع(الثوابت, الحساب.اليسار)) مع
                                | اختياري.موجود(ك) -> { البت := اختياري.موجود(ك); المصدر := الحساب.اليمين; موضع_و := ت; }
                                | اختياري.لا_شيء -> { };
                            };
                        }
                        | _ -> { };
                    };
                }
                | _ -> { };
            };
            ت := ت + 1;
        }
        // Nothing between the AND and the branch may redefine its source.
        طابق البت مع
        | اختياري.موجود(_) -> {
            ت := موضع_و + 1;
            طالما (ت + 3 < العدد) {
                ليكن الحقيقة: حقيقة_تعليمة_تخصيص = حقيقة_تخصيص_تعليمة_ذراع(&(*الكتلة).التعليمات[ت], الهدف, 0);
                ليكن ع: متغير طبيعي = 0;
                طالما (ع < (الطول(الحقيقة.التعريفات) مثل طبيعي)) {
                    إذا (الحقيقة.التعريفات[ع].السجل.القيمة == المصدر.القيمة) { البت := اختياري.لا_شيء(); };
                    ع := ع + 1;
                }
                ت := ت + 1;
            }
        }
        | اختياري.لا_شيء -> { };
    };
    ليكن الفرع: متغير تعليمة_ذراع_أربعة_وستون = تعليمة_ذراع_أربعة_وستون.فخ_ذراع();
    بدّل((*الكتلة).التعليمات[العدد - 2], الفرع);
    طابق الفرع مع
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(_, الحزمة) -> {
        طابق البت مع
        | اختياري.موجود(ك) -> {
            (*الكتلة).التعليمات[العدد - 2] := تعليمة_ذراع_أربعة_وستون.فرع_بت_ذراع(المصدر, ك, غير_صفري, الحزمة);
            (*المحذوفة)[موضع_و] := صواب;
        }
        | اختياري.لا_شيء -> {
            (*الكتلة).التعليمات[العدد - 2] := تعليمة_ذراع_أربعة_وستون.فرع_صفري_ذراع(المختبر, غير_صفري, الحزمة);
        };
        (*المحذوفة)[العدد - 3] := صواب;
    }
    | _ -> { (*الكتلة).التعليمات[العدد - 2] := الفرع; };
}

// k, when the constant is 2^k.
عرف قوة_اثنين_ذراع(الثابت: اختياري طبيعي): اختياري طبيعي {
    طابق الثابت مع
    | اختياري.موجود(ق) -> {
        إذا (ق == 0 || (ق & (ق - 1)) != 0) { أرجع اختياري.لا_شيء(); };
        ليكن ك: متغير طبيعي = 0;
        ليكن الباقي: متغير طبيعي = ق;
        طالما (الباقي > 1) { الباقي := الباقي >> 1; ك := ك + 1; }
        أرجع اختياري.موجود(ك);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// ---- Immediate operands ----------------------------------------------------------

// The other of add and subtract.
عرف عكس_جمع_ذراع(العملية: عملية_حساب_ذراع_أربعة_وستون): عملية_حساب_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_حساب_ذراع_أربعة_وستون.جمع -> { أرجع عملية_حساب_ذراع_أربعة_وستون.طرح(); }
    | عملية_حساب_ذراع_أربعة_وستون.طرح -> { أرجع عملية_حساب_ذراع_أربعة_وستون.جمع(); }
    | عملية_حساب_ذراع_أربعة_وستون.جمع_ملتف -> { أرجع عملية_حساب_ذراع_أربعة_وستون.طرح_ملتف(); }
    | عملية_حساب_ذراع_أربعة_وستون.طرح_ملتف -> { أرجع عملية_حساب_ذراع_أربعة_وستون.جمع_ملتف(); }
    | _ -> { أرجع العملية; };
}

// The immediate form of a wrapping add or subtract or a bitwise operation
// whose right (or, commuting, left) operand is a constant it can take.
عرف حساب_فوري_من_ذراع(
    الحساب: &حساب_صحيح_ذراع_أربعة_وستون,
    الثوابت: &متجه اختياري طبيعي
): اختياري تعليمة_ذراع_أربعة_وستون {
    ليكن ح: حساب_صحيح_ذراع_أربعة_وستون = *الحساب;
    ليكن جمعي: متغير منطقي = خطأ;
    ليكن تبديلي: متغير منطقي = خطأ;
    ليكن منطقي_: متغير منطقي = خطأ;
    طابق ح.العملية مع
    | عملية_حساب_ذراع_أربعة_وستون.جمع_ملتف -> { جمعي := صواب; تبديلي := صواب; }
    | عملية_حساب_ذراع_أربعة_وستون.طرح_ملتف -> { جمعي := صواب; }
    | عملية_حساب_ذراع_أربعة_وستون.و_بتي -> { منطقي_ := صواب; تبديلي := صواب; }
    | عملية_حساب_ذراع_أربعة_وستون.أو_بتي -> { منطقي_ := صواب; تبديلي := صواب; }
    | عملية_حساب_ذراع_أربعة_وستون.أو_حصري -> { منطقي_ := صواب; تبديلي := صواب; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    // (left, constant) pairs to try: the right operand, then the left.
    ليكن المحاولة: متغير طبيعي = 0;
    طالما (المحاولة < 2) {
        ليكن الأيسر: متغير معرف_سجل_افتراضي = ح.اليسار;
        ليكن الثابت_س: متغير معرف_سجل_افتراضي = ح.اليمين;
        إذا (المحاولة == 1) { الأيسر := ح.اليمين; الثابت_س := ح.اليسار; };
        إذا (المحاولة == 0 || تبديلي) {
            إذا (جمعي) {
                طابق فوري_حسابي_ذراع(الثوابت, الثابت_س) مع
                | اختياري.موجود(ق) -> {
                    أرجع اختياري.موجود(تعليمة_ذراع_أربعة_وستون.حساب_صحيح_فوري_ذراع(ح.العملية, ح.الوجهة, الأيسر, ق, ح.الوصف));
                }
                | اختياري.لا_شيء -> { };
                طابق فوري_سالب_ذراع(الثوابت, الثابت_س) مع
                | اختياري.موجود(ق) -> {
                    أرجع اختياري.موجود(تعليمة_ذراع_أربعة_وستون.حساب_صحيح_فوري_ذراع(
                        عكس_جمع_ذراع(ح.العملية), ح.الوجهة, الأيسر, ق, ح.الوصف
                    ));
                }
                | اختياري.لا_شيء -> { };
            };
            إذا (منطقي_) {
                طابق ثابت_سجل_ذراع(الثوابت, الثابت_س) مع
                | اختياري.موجود(ق) -> {
                    طابق فوري_منطقي_ذراع(ق) مع
                    | اختياري.موجود(_) -> {
                        أرجع اختياري.موجود(تعليمة_ذراع_أربعة_وستون.حساب_صحيح_فوري_ذراع(ح.العملية, ح.الوجهة, الأيسر, ق, ح.الوصف));
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            };
        };
        المحاولة := المحاولة + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The immediate form of a checked add or subtract with an overflow exit.
// A negative signed constant is the other operation's immediate: a + (-k)
// overflows exactly when a - k does.
عرف حساب_فوري_بمخرج_من_ذراع(
    الحساب: &حساب_صحيح_ذراع_أربعة_وستون,
    المخرج: معرف_كتلة_منتقاة,
    الثوابت: &متجه اختياري طبيعي
): اختياري تعليمة_ذراع_أربعة_وستون {
    ليكن ح: حساب_صحيح_ذراع_أربعة_وستون = *الحساب;
    ليكن تبديلي: متغير منطقي = خطأ;
    طابق ح.العملية مع
    | عملية_حساب_ذراع_أربعة_وستون.جمع -> { تبديلي := صواب; }
    | عملية_حساب_ذراع_أربعة_وستون.طرح -> { }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن المحاولة: متغير طبيعي = 0;
    طالما (المحاولة < 2) {
        ليكن الأيسر: متغير معرف_سجل_افتراضي = ح.اليسار;
        ليكن الثابت_س: متغير معرف_سجل_افتراضي = ح.اليمين;
        إذا (المحاولة == 1) { الأيسر := ح.اليمين; الثابت_س := ح.اليسار; };
        إذا (المحاولة == 0 || تبديلي) {
            طابق فوري_حسابي_ذراع(الثوابت, الثابت_س) مع
            | اختياري.موجود(ق) -> {
                أرجع اختياري.موجود(تعليمة_ذراع_أربعة_وستون.حساب_صحيح_فوري_بمخرج_ذراع(
                    ح.العملية, ح.الوجهة, الأيسر, ق, ح.الوصف, المخرج
                ));
            }
            | اختياري.لا_شيء -> { };
            إذا (ح.الوصف.موقع) {
                طابق فوري_سالب_ذراع(الثوابت, الثابت_س) مع
                | اختياري.موجود(ق) -> {
                    أرجع اختياري.موجود(تعليمة_ذراع_أربعة_وستون.حساب_صحيح_فوري_بمخرج_ذراع(
                        عكس_جمع_ذراع(ح.العملية), ح.الوجهة, الأيسر, ق, ح.الوصف, المخرج
                    ));
                }
                | اختياري.لا_شيء -> { };
            };
        };
        المحاولة := المحاولة + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف بسط_فوريات_كتلة_ذراع(
    الكتلة: &متغير كتلة_ذراع_أربعة_وستون_منتقاة,
    الثوابت: &متجه اختياري طبيعي
): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        ليكن الجديدة: متغير اختياري تعليمة_ذراع_أربعة_وستون = اختياري.لا_شيء();
        طابق (*الكتلة).التعليمات[ت] مع
        | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(الحساب) -> {
            الجديدة := حساب_فوري_من_ذراع(&الحساب, الثوابت);
        }
        | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_بمخرج_ذراع(الحساب, المخرج) -> {
            الجديدة := حساب_فوري_بمخرج_من_ذراع(&الحساب, المخرج, الثوابت);
        }
        | _ -> { };
        طابق الجديدة مع
        | اختياري.موجود(التعليمة) -> { (*الكتلة).التعليمات[ت] := التعليمة; }
        | اختياري.لا_شيء -> { };
        ت := ت + 1;
    }
}

// Drops constant materializations into registers nothing reads.
عرف احذف_ثوابت_ميتة_كتلة_ذراع(
    الكتلة: &متغير كتلة_ذراع_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_ذراع
): فراغ {
    ليكن المحذوفة: متغير متجه منطقي = [];
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
        ليكن ميتة: متغير منطقي = خطأ;
        ليكن الوجهة: متغير اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
        طابق (*الكتلة).التعليمات[ت] مع
        | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(و, _) -> { الوجهة := اختياري.موجود(و); }
        | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(و, _) -> { الوجهة := اختياري.موجود(و); }
        | _ -> { };
        طابق الوجهة مع
        | اختياري.موجود(و) -> {
            ميتة := و.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي) && (*العدادات).الاستخدامات[و.القيمة] == 0;
        }
        | اختياري.لا_شيء -> { };
        ألحق(المحذوفة, ميتة);
        ت := ت + 1;
    }
    أبق_تعليمات_كتلة_ذراع(الكتلة, &المحذوفة);
}

عام عرف بسط_دالة_ذراع_منتقاة(
    الدالة: &متغير دالة_ذراع_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف,
    الحسابات: &حسابات_بمخرج_تجاوز_مسير
): فراغ {
    ادمج_حسابات_بمخرج_ذراع(الدالة, الحسابات, الهدف);
    ليكن العدادات: عدادات_سجلات_ذراع = عد_سجلات_دالة_ذراع(الدالة, الهدف);
    ليكن الثوابت: متجه اختياري طبيعي = ثوابت_سجلات_دالة_ذراع(الدالة, &العدادات);
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        بسط_مقارنات_كتلة_ذراع(&متغير (*الدالة).الكتل[ك], &الثوابت);
        ليكن المحذوفة: متغير متجه منطقي = [];
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) { ألحق(المحذوفة, خطأ); ت := ت + 1; }
        ادمج_مقارنة_وفرع_كتلة_ذراع(&متغير (*الدالة).الكتل[ك], &العدادات, &متغير المحذوفة);
        ادمج_فرع_صفري_كتلة_ذراع(&متغير (*الدالة).الكتل[ك], &العدادات, &الثوابت, الهدف, &متغير المحذوفة);
        بسط_فوريات_كتلة_ذراع(&متغير (*الدالة).الكتل[ك], &الثوابت);
        أبق_تعليمات_كتلة_ذراع(&متغير (*الدالة).الكتل[ك], &المحذوفة);
        ك := ك + 1;
    }
    ليكن بعد_التبسيط: عدادات_سجلات_ذراع = عد_سجلات_دالة_ذراع(الدالة, الهدف);
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        احذف_ثوابت_ميتة_كتلة_ذراع(&متغير (*الدالة).الكتل[ك], &بعد_التبسيط);
        ك := ك + 1;
    }
}
