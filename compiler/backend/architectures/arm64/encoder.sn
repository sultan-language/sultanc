عرف ألحق_ثابت_نص_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الثابت: &ثابت_نص_ذراع_أربعة_وستون_مخصص,
    الدالة: معرف_دالة_منتقاة,
    المرفقات: &متغير مرفقات_كائن_مشفرة
): نتيجة_دفعة_ترميز_ذراع {
    دع ثابت_محلي: ثابت_نص_ذراع_أربعة_وستون_مخصص = *الثابت;
    دع الهوية: طبيعي = ثابت_محلي.الهوية;
    دع الوجهة: معرف_سجل_فعلي = ثابت_محلي.الوجهة;
    دع إزاحة_البيانات: طبيعي = ثابت_محلي.إزاحة_البيانات;
    دع إزاحة_الطول: طبيعي = ثابت_محلي.إزاحة_الطول;
    دع إزاحة_السعة: طبيعي = ثابت_محلي.إزاحة_السعة;
    دع بايتات_البيانات: متغير متجه ط8 = انسخ_بايتات_ثابت_نص_ذراع(&ثابت_محلي.البايتات);
    دع الطول_الدلالي: طبيعي = الطول(بايتات_البيانات) مثل طبيعي;
    دع المعرف: معرف_بيانات_ثابتة_كائن = معرف_بيانات_ثابتة_كائن_من(الدالة, الهوية);
    لو (الطول_الدلالي == 0) { ألحق(بايتات_البيانات, 0); };
    دع البيانات: بيانات_ثابتة_كائن = {
        المعرف: المعرف, البيانات: بايتات_البيانات, المحاذاة: 1, للقراءة_فقط: صواب
    };

    ألحق_بيانات_ثابتة_مرفق_ذراع(المرفقات, البيانات);


    // ADRP/ADD يحملان عنوان الثابت عبر طلبات relocation عامة؛ صيغة الكائن تترجمها لاحقا.
    دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
    دع عدد_الكلمات_قبل_الصفحة: طبيعي = الطول(*الكلمات) مثل طبيعي;
    دع موضع_الصفحة: طبيعي = عدد_الكلمات_قبل_الصفحة * 4;
    ألحق_كلمة_ذراع(الكلمات, 0x90000000 + العمل.القيمة);
    ألحق_طلب_إزاحة_بيانات_ثابتة_ذراع(
        المرفقات, الدالة, موضع_الصفحة,
        نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت(), المعرف
    );
    دع عدد_الكلمات_قبل_الإزاحة: طبيعي = الطول(*الكلمات) مثل طبيعي;
    دع موضع_الإزاحة: طبيعي = عدد_الكلمات_قبل_الإزاحة * 4;
    ألحق_كلمة_ذراع(
        الكلمات, 0x91000000 + (العمل.القيمة * 32) + العمل.القيمة
    );
    ألحق_طلب_إزاحة_بيانات_ثابتة_ذراع(
        المرفقات, الدالة, موضع_الإزاحة,
        نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت(), المعرف
    );
    طابق ألحق_نتيجة_كلمة(
        الكلمات, ترميز_ذاكرة_ذراع(خطأ, العمل, الوجهة, إزاحة_البيانات مثل عدد, 8, خطأ)
    ) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_مادي_فوري_ذراع(الكلمات, العمل, الطول_الدلالي) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نتيجة_كلمة(
        الكلمات, ترميز_ذاكرة_ذراع(خطأ, العمل, الوجهة, إزاحة_الطول مثل عدد, 8, خطأ)
    ) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_مادي_فوري_ذراع(الكلمات, العمل, 0) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    أرجع ألحق_نتيجة_كلمة(
        الكلمات, ترميز_ذاكرة_ذراع(خطأ, العمل, الوجهة, إزاحة_السعة مثل عدد, 8, خطأ)
    );
}

عرف ألحق_تخصيص_صندوق_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    الهدف: &واصف_هدف,
    الدالة: معرف_دالة_منتقاة,
    المرفقات: &متغير مرفقات_كائن_مشفرة,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_ذراع {
    طابق خطة_تخصيص_ذاكرة_للهدف(الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.تخصيص_ذاكرة_غير_متاح()
        );
    }
    | اختياري.موجود(الخطة) -> {
        طابق الخطة مع
        | خطة_تخصيص_ذاكرة_هدف.نداء_رمزي(النداء) -> {
            دع الحجم_الفعلي: متغير طبيعي = الحجم;
            لو (الحجم_الفعلي == 0) { الحجم_الفعلي := 1; };
            دع سجل_الحجم: معرف_سجل_فعلي = { القيمة: 0 };
            طابق ألحق_مادي_فوري_ذراع(الكلمات, سجل_الحجم, الحجم_الفعلي) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
                أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
            }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };

            دع عدد_الكلمات: طبيعي = الطول(*الكلمات) مثل طبيعي;
            دع موضع_النداء: طبيعي = عدد_الكلمات * 4;
            ألحق_كلمة_ذراع(الكلمات, 0x94000000);
            ألحق_إزاحة_خدمة_تشغيل_ذراع(
                المرفقات, الدالة, موضع_النداء, النداء.الخدمة
            );

            طابق ألحق_نتيجة_كلمة(
                الكلمات, ترميز_مقارنة_فوري_ذراع(سجل_الحجم, 0)
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
                أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
            }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            ألحق_فرع_شرط_قصير_ذراع(الكلمات, 1, 2);
            ألحق_فخ_ذراع(الكلمات);

            لو (!معرفا_سجل_فعلي_متساويان(الوجهة, سجل_الحجم)) {
                أرجع ألحق_نتيجة_كلمة(
                    الكلمات, ترميز_نقل_سجل_ذراع(الوجهة, سجل_الحجم)
                );
            };
            أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
        };
    };
}

عرف حجم_جزء_تجميع_واجهة_ذراع(الحجم: طبيعي, الفهرس: طبيعي): طبيعي {
    دع البداية: طبيعي = الفهرس * 8;
    لو (البداية >= الحجم) { أرجع 0; };
    دع الباقي: طبيعي = الحجم - البداية;
    لو (الباقي < 8) { أرجع الباقي; };
    أرجع 8;
}

// ABI locations identify homogeneous floating aggregates without another
// type model. A spilled f32 HFA retains four-byte per-element stack slots.
عرف عرض_جزء_تجميع_موقع_ذراع(
    المواضع: &متجه موضع_جزء_واجهة,
    الحجم: طبيعي,
    الفهرس: طبيعي
): طبيعي {
    دع العدد: طبيعي = الطول(*المواضع) مثل طبيعي;
    لو (العدد == 0) { أرجع 0; };
    دع عائم: متغير منطقي = خطأ;
    طابق (*المواضع)[0] مع
    | موضع_جزء_واجهة.سجل(المرجع) -> {
        عائم := المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه();
    }
    | موضع_جزء_واجهة.مكدس(الموضع) -> {
        عائم := الموضع.الحجم == 4 && الحجم == العدد * 4;
    };
    لو (عائم && (الحجم % العدد) == 0) {
        دع العرض: طبيعي = الحجم / العدد;
        لو (العرض == 4 || العرض == 8) { أرجع العرض; };
    };
    أرجع حجم_جزء_تجميع_واجهة_ذراع(الحجم, الفهرس);
}

عرف إزاحة_جزء_تجميع_موقع_ذراع(
    المواضع: &متجه موضع_جزء_واجهة,
    الحجم: طبيعي,
    الفهرس: طبيعي
): طبيعي {
    دع العدد: طبيعي = الطول(*المواضع) مثل طبيعي;
    لو (العدد > 0) {
        دع العرض: طبيعي = عرض_جزء_تجميع_موقع_ذراع(المواضع, الحجم, 0);
        لو (الحجم == العدد * العرض) { أرجع الفهرس * العرض; };
    };
    أرجع الفهرس * 8;
}

عرف حاذ_حجم_نداء_ذراع(الحجم: طبيعي): طبيعي {
    دع الباقي: طبيعي = الحجم % 16;
    لو (الباقي == 0) { أرجع الحجم; };
    أرجع الحجم + (16 - الباقي);
}

عرف ألحق_ذاكرة_بإزاحة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    تحميل: منطقي,
    السجل: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي,
    الإزاحة: طبيعي,
    الحجم: طبيعي,
    بإشارة: منطقي
): نتيجة_دفعة_ترميز_ذراع {
    لو ((الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)
        && ((الإزاحة % الحجم) == 0) && ((الإزاحة / الحجم) <= 4095)) {
        أرجع ألحق_نتيجة_كلمة(
            الكلمات, ترميز_ذاكرة_ذراع(تحميل, السجل, الأساس, الإزاحة مثل عدد, الحجم, بإشارة)
        );
    };
    دع عنوان: معرف_سجل_فعلي = { القيمة: 17 };
    لو (الأساس.القيمة == 31) {
        // ADD (immediate) هو الشكل الذي يفسر Rn=31 على أنه SP. لا تستخدم ADD-register هنا لأن 31 تعني XZR فيه.
        ألحق_كلمة_ذراع(الكلمات, 0x910003E0 + عنوان.القيمة);
        دع الباقي: متغير طبيعي = الإزاحة;
        طالما (الباقي > 0) {
            دع الجزء: متغير طبيعي = الباقي;
            لو (الجزء > 4095) { الجزء := 4095; };
            ألحق_كلمة_ذراع(
                الكلمات,
                0x91000000 + (الجزء * 1024) + (عنوان.القيمة * 32) + عنوان.القيمة
            );
            الباقي := الباقي - الجزء;
        }
    } وإلا {
        طابق ألحق_مادي_فوري_ذراع(الكلمات, عنوان, الإزاحة) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        طابق ألحق_نتيجة_كلمة(
            الكلمات, ترميز_حساب_سجل_ذراع(0x8B000000, عنوان, الأساس, عنوان)
        ) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    };
    أرجع ألحق_نتيجة_كلمة(
        الكلمات, ترميز_ذاكرة_ذراع(تحميل, السجل, عنوان, 0, الحجم, بإشارة)
    );
}

عرف ألحق_تحميل_جزء_تجميع_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي,
    الإزاحة: طبيعي,
    الحجم: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    لو (الحجم == 0 || الحجم > 8) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
    };
    طابق ألحق_مادي_فوري_ذراع(الكلمات, الوجهة, 0) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
    دع العد: معرف_سجل_فعلي = { القيمة: 17 };
    دع ب: متغير طبيعي = 0;
    طالما (ب < الحجم) {
        طابق ألحق_ذاكرة_بإزاحة_ذراع(الكلمات, صواب, العمل, الأساس, الإزاحة + ب, 1, خطأ) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        لو (ب > 0) {
            طابق ألحق_مادي_فوري_ذراع(الكلمات, العد, ب * 8) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9AC02000, العمل, العمل, العد)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        };
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0xAA000000, الوجهة, الوجهة, العمل)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ب := ب + 1;
    }
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف ألحق_تخزين_جزء_تجميع_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    المصدر: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي,
    الإزاحة: طبيعي,
    الحجم: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    لو (الحجم == 0 || الحجم > 8) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
    };
    دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
    دع العد: معرف_سجل_فعلي = { القيمة: 17 };
    دع ب: متغير طبيعي = 0;
    طالما (ب < الحجم) {
        دع سجل_البايت: متغير معرف_سجل_فعلي = المصدر;
        لو (ب > 0) {
            طابق ألحق_مادي_فوري_ذراع(الكلمات, العد, ب * 8) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9AC02400, العمل, المصدر, العد)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            سجل_البايت := العمل;
        };
        طابق ألحق_ذاكرة_بإزاحة_ذراع(الكلمات, خطأ, سجل_البايت, الأساس, الإزاحة + ب, 1, خطأ) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ب := ب + 1;
    }
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف تحقق_قيمة_واجهة_ذراع(
    القيمة: &قيمة_واجهة_ذراع_أربعة_وستون_مخصصة,
    يتطلب_مطابقة_سجل_الواجهة: منطقي
): اختياري خطأ_ترميز_ذراع_أربعة_وستون {
    دع ق: قيمة_واجهة_ذراع_أربعة_وستون_مخصصة = *القيمة;
    لو (!سجل_ذراع_قابل_للترميز(ق.السجل)) {
        أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(ق.السجل));
    };
    دع عدد_المواضع: طبيعي = الطول(ق.المواضع) مثل طبيعي;
    لو (عدد_المواضع == 0) { أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); };
    لو (ق.تجميعي == 0) {
        لو (عدد_المواضع != 1) { أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); };
        لو (!(ق.الحجم == 1 || ق.الحجم == 2 || ق.الحجم == 4 || ق.الحجم == 8)) {
            أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(ق.الحجم));
        };
        طابق ق.المواضع[0] مع
        | موضع_جزء_واجهة.سجل(المرجع) -> {
            لو (يتطلب_مطابقة_سجل_الواجهة && !سجل_واجهة_يطابق_ذراع(ق.السجل, &المرجع)) {
                أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.سجل_واجهة_غير_متطابق(ق.السجل));
            };
        }
        | موضع_جزء_واجهة.مكدس(_) -> { };
        أرجع اختياري.لا_شيء();
    };
    لو (ق.الحجم == 0) { أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); };
    لو ((ق.غير_مباشر != 0) && عدد_المواضع != 1) {
        أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_المواضع) {
        طابق ق.المواضع[ف] مع
        | موضع_جزء_واجهة.سجل(المرجع) -> {
            لو (المرجع.الفئة != فئة_سجل_واجهة.عائم_متجه()) {
                طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                | اختياري.موجود(_) -> { };
            };
        }
        | موضع_جزء_واجهة.مكدس(_) -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف تحقق_قيمة_نداء_واجهة_ذراع(
    القيمة: &قيمة_نداء_ذراع_أربعة_وستون_مخصصة
): اختياري خطأ_ترميز_ذراع_أربعة_وستون {
    دع ق: قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *القيمة;
    طابق سجل_موقع_قيمة_ذراع(&ق.الموقع) مع
    | اختياري.موجود(السجل) -> {
        لو (!سجل_ذراع_قابل_للترميز(السجل)) {
            أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(السجل));
        };
    }
    | اختياري.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_ذراع(&ق.الموقع) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
        };
    };
    دع عدد_المواضع: طبيعي = الطول(ق.المواضع) مثل طبيعي;
    لو (عدد_المواضع == 0) {
        أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
    };
    لو (ق.تجميعي == 0) {
        لو (عدد_المواضع != 1) {
            أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
        };
        لو (!(ق.الحجم == 1 || ق.الحجم == 2 || ق.الحجم == 4 || ق.الحجم == 8)) {
            أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(ق.الحجم));
        };
    } وإلا {
        لو (ق.الحجم == 0) {
            أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
        };
        لو ((ق.غير_مباشر != 0) && عدد_المواضع != 1) {
            أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
        };
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_المواضع) {
        طابق ق.المواضع[ف] مع
        | موضع_جزء_واجهة.سجل(المرجع) -> {
            لو (المرجع.الفئة != فئة_سجل_واجهة.عائم_متجه()) {
                طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
                };
            };
        }
        | موضع_جزء_واجهة.مكدس(_) -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف تحقق_نداء_واجهة_ذراع(
    النداء: &نداء_ذراع_أربعة_وستون_مخصص
): اختياري خطأ_ترميز_ذراع_أربعة_وستون {
    دع ن: نداء_ذراع_أربعة_وستون_مخصص = *النداء;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ن.الحجج) مثل طبيعي)) {
        طابق تحقق_قيمة_نداء_واجهة_ذراع(&ن.الحجج[ف]) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع مرجع_الناتج: &اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &ن.الناتج;
    دع نسخة_الناتج: اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_الناتج;
    طابق نسخة_الناتج مع
    | اختياري.موجود(الناتج) -> { أرجع تحقق_قيمة_نداء_واجهة_ذراع(&الناتج); }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عرف تحقق_عودة_واجهة_ذراع(
    الناتج: &ناتج_عودة_ذراع_أربعة_وستون_مخصص
): اختياري خطأ_ترميز_ذراع_أربعة_وستون {
    دع النسخة: ناتج_عودة_ذراع_أربعة_وستون_مخصص = *الناتج;
    أرجع تحقق_قيمة_واجهة_ذراع(&النسخة.القيمة, خطأ);
}

عرف ألحق_حفظ_إطار_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    استعادة: منطقي,
    الهدف: &واصف_هدف,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_ذراع {
    دع إ: إطار_انسكاب_ذراع_أربعة_وستون = *الإطار;
    دع العدد: طبيعي = الطول(إ.السجلات_المحفوظة) مثل طبيعي;
    دع حجم_الحفظ: طبيعي = العدد * 8;
    دع أساس_الحفظ: طبيعي = إ.الحجم_بايت - حجم_الحفظ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع السجل: معرف_سجل_فعلي = إ.السجلات_المحفوظة[ف];
        دع الإزاحة: طبيعي = أساس_الحفظ + (ف * 8);
        طابق ألحق_ذاكرة_بإزاحة_ذراع(
            الكلمات, استعادة, السجل, سجل_مكدس_ذراع(), الإزاحة, 8, خطأ
        ) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
        }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        دع عدد_الكلمات_بعد_الحركة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع إزاحة_بعد_الحركة: طبيعي = عدد_الكلمات_بعد_الحركة * 4;
        لو (استعادة) {
            سجل_استعادة_سجل_فك_المكدس(فك_المكدس, الهدف, السجل, إزاحة_بعد_الحركة);
        } وإلا {
            سجل_حفظ_سجل_فك_المكدس(فك_المكدس, الهدف, السجل, الإزاحة, إزاحة_بعد_الحركة);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}


// Vector append is a composite of the target realloc service (see
// runtime_primitive_query_context: إلحاق = تركيب_خدمات), expanded inline like
// the LLVM provider and the x86-64 encoder; the retired runtime helper symbol
// is no longer referenced. The instruction is allocated as an ABI call, so
// x0-x17 are free here. x15/x16 hold the vector address and element value
// (or element address for aggregates); they and the grown capacity are kept
// in a transient 32-byte stack area across realloc.
عرف ألحق_إلحاق_متجه_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الإلحاق: &إلحاق_متجه_ذراع_أربعة_وستون_مخصص,
    الدالة: معرف_دالة_منتقاة,
    المرفقات: &متغير مرفقات_كائن_مشفرة
): نتيجة_دفعة_ترميز_ذراع {
    دع م: إلحاق_متجه_ذراع_أربعة_وستون_مخصص = *الإلحاق;
    لو (!(م.حجم_الطول == 8 && م.حجم_السعة == 8)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(م.حجم_الطول)
        );
    };
    // LDR/STR Xt, [Xn, #imm] encode 8-byte-scaled unsigned offsets only.
    لو ((م.إزاحة_الطول % 8) != 0 || (م.إزاحة_السعة % 8) != 0 || (م.إزاحة_البيانات % 8) != 0
        || م.إزاحة_الطول >= 32768 || م.إزاحة_السعة >= 32768 || م.إزاحة_البيانات >= 32768) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(م.إزاحة_الطول)
        );
    };
    // Reserve stores no element: any element size is a stride.
    لو (!م.الحجز && !م.العنصر_تجميعي && !(م.حجم_العنصر == 0 || م.حجم_العنصر == 1 || م.حجم_العنصر == 2
        || م.حجم_العنصر == 4 || م.حجم_العنصر == 8)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(م.حجم_العنصر)
        );
    };
    دع حفظ_المتجه: معرف_سجل_فعلي = { القيمة: 15 };
    دع حفظ_العنصر: معرف_سجل_فعلي = { القيمة: 16 };
    // Parallel-safe: capture both sources before either save register is written.
    دع مؤقت: معرف_سجل_فعلي = { القيمة: 17 };
    طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(مؤقت, م.العنصر)) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(حفظ_المتجه, م.المتجه)) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(حفظ_العنصر, مؤقت)) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };

    دع ل: طبيعي = م.إزاحة_الطول / 8;
    دع س: طبيعي = م.إزاحة_السعة / 8;
    دع ب: طبيعي = م.إزاحة_البيانات / 8;
    // STP x15, x16, [sp, #-32]!
    ألحق_كلمة_ذراع(الكلمات, 0xA9BE43EF);
    لو (م.الحجز) {
        لو (م.حجم_العنصر > 0) {
            // Reserve: x9 = len + additional (ADDS; a carry traps).
            ألحق_كلمة_ذراع(الكلمات, 0xF9400000 + (ل * 1024) + 489);
            ألحق_كلمة_ذراع(الكلمات, 0xAB100129);
            ألحق_فرع_شرط_قصير_ذراع(الكلمات, 3, 2);
            ألحق_فخ_ذراع(الكلمات);
            // x10 = capacity; total <= capacity → done (B.LS).
            ألحق_كلمة_ذراع(الكلمات, 0xF9400000 + (س * 1024) + 490);
            ألحق_كلمة_ذراع(الكلمات, 0xEB0A013F);
            دع موضع_فرع_الكفاية: طبيعي = الطول(*الكلمات) مثل طبيعي;
            ألحق_كلمة_ذراع(الكلمات, 0x54000009);
            // [sp, #16] = total
            ألحق_كلمة_ذراع(الكلمات, 0xF9000BE9);
            // x1 = total * element_size (overflow-checked), x0 = data
            دع س11_ح: معرف_سجل_فعلي = { القيمة: 11 };
            طابق ألحق_مادي_فوري_ذراع(الكلمات, س11_ح, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            ألحق_كلمة_ذراع(الكلمات, 0x9B0B7D21);
            ألحق_كلمة_ذراع(الكلمات, 0x9BCB7D2D);
            ألحق_كلمة_ذراع(الكلمات, 0xB400004D);
            ألحق_فخ_ذراع(الكلمات);
            ألحق_كلمة_ذراع(الكلمات, 0xF9400000 + (ب * 1024) + 480);
            دع موضع_نداء_الحجز: طبيعي = (الطول(*الكلمات) مثل طبيعي) * 4;
            ألحق_كلمة_ذراع(الكلمات, 0x94000000);
            ألحق_إزاحة_خدمة_تشغيل_ذراع(
                المرفقات, الدالة, موضع_نداء_الحجز, خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة()
            );
            // A null result means allocation failure: trap, never continue.
            دع س0_ح: معرف_سجل_فعلي = { القيمة: 0 };
            طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_فوري_ذراع(س0_ح, 0)) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            ألحق_فرع_شرط_قصير_ذراع(الكلمات, 1, 2);
            ألحق_فخ_ذراع(الكلمات);
            // LDP x15, x16, [sp]; commit data then capacity.
            ألحق_كلمة_ذراع(الكلمات, 0xA94043EF);
            ألحق_كلمة_ذراع(الكلمات, 0xF9000000 + (ب * 1024) + 480);
            ألحق_كلمة_ذراع(الكلمات, 0xF9400BEC);
            ألحق_كلمة_ذراع(الكلمات, 0xF9000000 + (س * 1024) + 492);
            دع نهاية_الحجز: طبيعي = الطول(*الكلمات) مثل طبيعي;
            عين_كلمة_ذراع(
                الكلمات, موضع_فرع_الكفاية,
                كلمة_ذراع(0x54000009 + ((نهاية_الحجز - موضع_فرع_الكفاية) * 32))
            );
        };
    } وإلا لو (م.حجم_العنصر > 0) {
        // x9 = len, x10 = capacity; len < capacity → store.
        ألحق_كلمة_ذراع(الكلمات, 0xF9400000 + (ل * 1024) + 489);
        ألحق_كلمة_ذراع(الكلمات, 0xF9400000 + (س * 1024) + 490);
        ألحق_كلمة_ذراع(الكلمات, 0xEB0A013F);
        دع موضع_فرع_التخزين: طبيعي = الطول(*الكلمات) مثل طبيعي;
        ألحق_كلمة_ذراع(الكلمات, 0x54000003);

        // Grow: x12 = max(capacity * growth, minimum), trapping on overflow.
        دع عامل_النمو: متغير طبيعي = م.عامل_النمو;
        لو (عامل_النمو < 2) { عامل_النمو := 2; };
        دع السعة_الدنيا: متغير طبيعي = م.السعة_الدنيا;
        لو (السعة_الدنيا < 1) { السعة_الدنيا := 1; };
        دع س11: معرف_سجل_فعلي = { القيمة: 11 };
        طابق ألحق_مادي_فوري_ذراع(الكلمات, س11, عامل_النمو) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_كلمة_ذراع(الكلمات, 0x9B0B7D4C);
        ألحق_كلمة_ذراع(الكلمات, 0x9BCB7D4D);
        ألحق_كلمة_ذراع(الكلمات, 0xB400004D);
        ألحق_فخ_ذراع(الكلمات);
        طابق ألحق_مادي_فوري_ذراع(الكلمات, س11, السعة_الدنيا) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_كلمة_ذراع(الكلمات, 0xEB0B019F);
        ألحق_كلمة_ذراع(الكلمات, 0x9A8B218C);
        // [sp, #16] = grown capacity
        ألحق_كلمة_ذراع(الكلمات, 0xF9000BEC);
        // x1 = capacity * element_size (overflow-checked), x0 = data
        طابق ألحق_مادي_فوري_ذراع(الكلمات, س11, م.حجم_العنصر) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_كلمة_ذراع(الكلمات, 0x9B0B7D81);
        ألحق_كلمة_ذراع(الكلمات, 0x9BCB7D8D);
        ألحق_كلمة_ذراع(الكلمات, 0xB400004D);
        ألحق_فخ_ذراع(الكلمات);
        ألحق_كلمة_ذراع(الكلمات, 0xF9400000 + (ب * 1024) + 480);
        دع موضع_النداء: طبيعي = (الطول(*الكلمات) مثل طبيعي) * 4;
        ألحق_كلمة_ذراع(الكلمات, 0x94000000);
        ألحق_إزاحة_خدمة_تشغيل_ذراع(
            المرفقات, الدالة, موضع_النداء, خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة()
        );
        // A null result means allocation failure: trap, never continue.
        دع س0: معرف_سجل_فعلي = { القيمة: 0 };
        طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_فوري_ذراع(س0, 0)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_فرع_شرط_قصير_ذراع(الكلمات, 1, 2);
        ألحق_فخ_ذراع(الكلمات);
        // LDP x15, x16, [sp]; commit data then capacity.
        ألحق_كلمة_ذراع(الكلمات, 0xA94043EF);
        ألحق_كلمة_ذراع(الكلمات, 0xF9000000 + (ب * 1024) + 480);
        ألحق_كلمة_ذراع(الكلمات, 0xF9400BEC);
        ألحق_كلمة_ذراع(الكلمات, 0xF9000000 + (س * 1024) + 492);

        // store: x10 = data + len * element_size; len + 1 is committed first.
        دع موضع_التخزين: طبيعي = الطول(*الكلمات) مثل طبيعي;
        عين_كلمة_ذراع(
            الكلمات, موضع_فرع_التخزين,
            كلمة_ذراع(0x54000003 + ((موضع_التخزين - موضع_فرع_التخزين) * 32))
        );
        ألحق_كلمة_ذراع(الكلمات, 0xF9400000 + (ل * 1024) + 489);
        طابق ألحق_مادي_فوري_ذراع(الكلمات, س11, م.حجم_العنصر) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_كلمة_ذراع(الكلمات, 0x9B0B7D2A);
        ألحق_كلمة_ذراع(الكلمات, 0xF9400000 + (ب * 1024) + 492);
        ألحق_كلمة_ذراع(الكلمات, 0x8B0A018A);
        ألحق_كلمة_ذراع(الكلمات, 0x91000529);
        ألحق_كلمة_ذراع(الكلمات, 0xF9000000 + (ل * 1024) + 489);
        دع س10: معرف_سجل_فعلي = { القيمة: 10 };
        لو (م.العنصر_تجميعي) {
            // Copies through x15 (the vector address is no longer needed).
            طابق ألحق_نسخ_ذاكرة_ذراع(الكلمات, س10, حفظ_العنصر, م.حجم_العنصر, 0, 0) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        } وإلا {
            دع رمز_التخزين: متغير طبيعي = 0xF9000000;
            لو (م.حجم_العنصر == 1) { رمز_التخزين := 0x39000000; };
            لو (م.حجم_العنصر == 2) { رمز_التخزين := 0x79000000; };
            لو (م.حجم_العنصر == 4) { رمز_التخزين := 0xB9000000; };
            ألحق_كلمة_ذراع(الكلمات, رمز_التخزين + 336);
        };
    } وإلا {
        // Zero-sized elements own no storage; only the length changes.
        ألحق_كلمة_ذراع(الكلمات, 0xF9400000 + (ل * 1024) + 489);
        ألحق_كلمة_ذراع(الكلمات, 0x91000529);
        ألحق_كلمة_ذراع(الكلمات, 0xF9000000 + (ل * 1024) + 489);
    };
    // ADD sp, sp, #32
    ألحق_كلمة_ذراع(الكلمات, 0x910083FF);
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

// ---- Atomics (thread support, docs/CONCURRENCY.md) ----
// LSE instructions (ARMv8.1; every Apple Silicon core) with acquire-release
// semantics, so every memory ordering gets sequentially consistent strength.
// X16/X17 are the encoder's scratch registers; operands never live there.
عرف حقل_حجم_ذري_ذراع(البتات: طبيعي): طبيعي {
    لو (البتات == 64) { أرجع 0x40000000; };
    أرجع 0;
}

عرف ألحق_ذري_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    العملية: عملية_ذرية_ذراع,
    الوجهة: معرف_سجل_فعلي,
    العنوان: معرف_سجل_فعلي,
    القيمة: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    دع الحجم: طبيعي = حقل_حجم_ذري_ذراع(البتات);
    دع المصدر: متغير طبيعي = القيمة.القيمة;
    // size 111 0 00 A R 1 Rs o3 opc 00 Rn Rt with A=R=1 (32-bit base 0xB8E00000).
    دع الرمز: متغير طبيعي = 0xB8E00000;
    طابق العملية مع
    | عملية_ذرية_ذراع.تبديل -> { الرمز := 0xB8E08000; }
    | عملية_ذرية_ذراع.جلب_جمع -> { الرمز := 0xB8E00000; }
    | عملية_ذرية_ذراع.جلب_و -> {
        // AND is LDCLR of the complement: mvn x17, value (orn x17, xzr, value).
        ألحق_كلمة_ذراع(الكلمات, 0x2A2003F1 + الحجم * 2 + (القيمة.القيمة * 65536));
        المصدر := 17;
        الرمز := 0xB8E01000;
    }
    | عملية_ذرية_ذراع.جلب_أو -> { الرمز := 0xB8E03000; }
    | عملية_ذرية_ذراع.جلب_أو_حصري -> { الرمز := 0xB8E02000; };
    // LDxxxAL / SWPAL Rs, x16, [address]; mov destination, x16
    ألحق_كلمة_ذراع(الكلمات, الرمز + الحجم + (المصدر * 65536) + (العنوان.القيمة * 32) + 16);
    ألحق_كلمة_ذراع(الكلمات, 0x2A0003E0 + الحجم * 2 + 1048576 + الوجهة.القيمة);
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف شفّر_تعليمة_ذراع(
    التعليمة: &تعليمة_ذراع_أربعة_وستون_مخصصة,
    إطار_الانسكاب: &إطار_انسكاب_ذراع_أربعة_وستون,
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    فروع_داخلية: &متغير متجه تثبيت_فرع_داخلي_ذراع,
    تثبيتات_رمزية: &متغير متجه تثبيت_ذراع_أربعة_وستون,
    الهدف: &واصف_هدف,
    الدالة: معرف_دالة_منتقاة,
    المرفقات: &متغير مرفقات_كائن_مشفرة,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_ذراع {
    دع الإطار: إطار_انسكاب_ذراع_أربعة_وستون = *إطار_الانسكاب;
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون_مخصصة.نقل_سجل(الوجهة, المصدر) -> {
        أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(الوجهة, المصدر));
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.مادي_فوري(الوجهة, القيمة) -> {
        دع القيمة_غير_الموقعة: طبيعي = القيمة مثل طبيعي;
        أرجع ألحق_مادي_فوري_ذراع(الكلمات, الوجهة, القيمة_غير_الموقعة);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.مادي_فوري_طبيعي(الوجهة, القيمة) -> {
        أرجع ألحق_مادي_فوري_ذراع(الكلمات, الوجهة, القيمة);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.عنوان_دالة(الوجهة, الهدف_الدالة) -> {
        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الهدف_الدالة);
        دع عدد_قبل_الصفحة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع موضع_الصفحة: طبيعي = عدد_قبل_الصفحة * 4;
        ألحق_كلمة_ذراع(الكلمات, 0x90000000 + الوجهة.القيمة);
        دع رمز_الصفحة: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&الرمز);
        ألحق_طلب_إزاحة_رمزية_ذراع(
            المرفقات, الدالة, موضع_الصفحة,
            نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت(), رمز_الصفحة
        );
        دع عدد_قبل_الإزاحة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع موضع_الإزاحة: طبيعي = عدد_قبل_الإزاحة * 4;
        ألحق_كلمة_ذراع(
            الكلمات, 0x91000000 + (الوجهة.القيمة * 32) + الوجهة.القيمة
        );
        ألحق_طلب_إزاحة_رمزية_ذراع(
            المرفقات, الدالة, موضع_الإزاحة,
            نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت(), الرمز
        );
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.عنوان_عام(الوجهة, العام, مستورد) -> {
        // Imported data has no local storage: load its address from the GOT.
        // Both relocation requests retain the same canonical MSIR global ID;
        // the object writer resolves it to the external linker symbol.
        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.عام(العام);
        دع عدد_قبل_الصفحة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع موضع_الصفحة: طبيعي = عدد_قبل_الصفحة * 4;
        ألحق_كلمة_ذراع(الكلمات, 0x90000000 + الوجهة.القيمة);
        دع رمز_الصفحة: مرجع_رمز_كائن = انسخ_مرجع_رمز_كائن(&الرمز);
        دع نوع_الصفحة: نوع_إزاحة_رمزية_كائن;
        لو (مستورد) {
            نوع_الصفحة := نوع_إزاحة_رمزية_كائن.صفحة_تحميل_جوت_ذراع_واحد_وعشرون_بت();
        } وإلا {
            نوع_الصفحة := نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت();
        };
        ألحق_طلب_إزاحة_رمزية_ذراع(
            المرفقات, الدالة, موضع_الصفحة, نوع_الصفحة, رمز_الصفحة
        );
        دع عدد_قبل_الإزاحة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع موضع_الإزاحة: طبيعي = عدد_قبل_الإزاحة * 4;
        دع نوع_الإزاحة: نوع_إزاحة_رمزية_كائن;
        لو (مستورد) {
            // LDR Xd, [Xd, #0] reads the pointer from the GOT slot.
            ألحق_كلمة_ذراع(
                الكلمات, 0xF9400000 + (الوجهة.القيمة * 32) + الوجهة.القيمة
            );
            نوع_الإزاحة := نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_تحميل_جوت_ذراع_اثنا_عشر_بت();
        } وإلا {
            ألحق_كلمة_ذراع(
                الكلمات, 0x91000000 + (الوجهة.القيمة * 32) + الوجهة.القيمة
            );
            نوع_الإزاحة := نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت();
        };
        ألحق_طلب_إزاحة_رمزية_ذراع(
            المرفقات, الدالة, موضع_الإزاحة, نوع_الإزاحة, الرمز
        );
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.بيئة_إغلاق(الوجهة) -> {
        طابق سجل_بيئة_إغلاق_للهدف(الهدف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.سجل_واجهة_غير_متطابق(الوجهة));
        }
        | اختياري.موجود(البيئة) -> {
            أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(الوجهة, البيئة));
        };
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.استلام_معامل(الاستلام) -> {
        دع مرجع_القيمة: &قيمة_واجهة_ذراع_أربعة_وستون_مخصصة = &الاستلام.القيمة;
        دع ق: قيمة_واجهة_ذراع_أربعة_وستون_مخصصة = *مرجع_القيمة;
        // السجل المخصص للمعامل مستقل عن سجل ABI؛ الاستلام نفسه يحقق النقل عند الحد.
        طابق تحقق_قيمة_واجهة_ذراع(&ق, خطأ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        لو ((ق.تجميعي != 0) && (ق.غير_مباشر == 0)) {
            دع الأساس: معرف_سجل_فعلي = { القيمة: 16 };
            طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(الأساس, ق.السجل)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(ق.المواضع) مثل طبيعي)) {
                دع حجم_الجزء: طبيعي = عرض_جزء_تجميع_موقع_ذراع(&ق.المواضع, ق.الحجم, ف);
                دع إزاحة_الجزء: طبيعي = إزاحة_جزء_تجميع_موقع_ذراع(&ق.المواضع, ق.الحجم, ف);
                دع مرجع_الموضع: &موضع_جزء_واجهة = &ق.المواضع[ف];
                دع نسخة_الموضع: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_الموضع);
                طابق نسخة_الموضع مع
                | موضع_جزء_واجهة.سجل(المرجع) -> {
                    لو (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                        // X15 belongs to the encoder scratch bank (allocation_constraints);
                        // use direct f32/f64 memory access: the bytewise helper uses X15 itself.
                        دع حامل_العائم: معرف_سجل_فعلي = { القيمة: 15 };
                        طابق ألحق_نقل_بتات_عائم_إلى_عام_ذراع(الكلمات, حامل_العائم, المرجع.الفهرس, حجم_الجزء * 8) مع
                        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                        طابق ألحق_ذاكرة_بإزاحة_ذراع(الكلمات, خطأ, حامل_العائم, الأساس, إزاحة_الجزء, حجم_الجزء, خطأ) مع
                        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    } وإلا {
                        طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                        | اختياري.موجود(سجل_الحامل) -> {
                            طابق ألحق_تخزين_جزء_تجميع_ذراع(الكلمات, سجل_الحامل, الأساس, إزاحة_الجزء, حجم_الجزء) مع
                            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                        };
                    };
                }
                | موضع_جزء_واجهة.مكدس(الموضع) -> {
                    دع ب: متغير طبيعي = 0;
                    طالما (ب < حجم_الجزء) {
                        دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
                        طابق ألحق_ذاكرة_بإزاحة_ذراع(
                            الكلمات, صواب, العمل, سجل_مكدس_ذراع(),
                            الإطار.الحجم_بايت + الموضع.الإزاحة + ب, 1, خطأ
                        ) مع
                        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                        طابق ألحق_ذاكرة_بإزاحة_ذراع(الكلمات, خطأ, العمل, الأساس, إزاحة_الجزء + ب, 1, خطأ) مع
                        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                        ب := ب + 1;
                    }
                };
                ف := ف + 1;
            }
            أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
        };
        دع مرجع_الموضع: &موضع_جزء_واجهة = &ق.المواضع[0];
        دع الموضع: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_الموضع);
        طابق الموضع مع
        | موضع_جزء_واجهة.سجل(المرجع) -> {
            لو (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                أرجع ألحق_نقل_بتات_عائم_إلى_عام_ذراع(
                    الكلمات, ق.السجل, المرجع.الفهرس, ق.الحجم * 8
                );
            };
            طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                    خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()
                );
            }
            | اختياري.موجود(سجل_الحامل) -> {
                لو (!معرفا_سجل_فعلي_متساويان(ق.السجل, سجل_الحامل)) {
                    طابق ألحق_نتيجة_كلمة(
                        الكلمات,
                        ترميز_نقل_سجل_ذراع(ق.السجل, سجل_الحامل)
                    ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
                        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
                    }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                };
            };
            لو ((ق.غير_مباشر == 0) && ق.الحجم < 8) {
                أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ق.السجل, ق.السجل, ق.الحجم * 8, ق.بإشارة != 0);
            };
            أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
        }
        | موضع_جزء_واجهة.مكدس(م) -> {
            دع الحجم: متغير طبيعي = ق.الحجم;
            لو (ق.غير_مباشر != 0) { الحجم := 8; };
            أرجع ألحق_ذاكرة_بإزاحة_ذراع(
                الكلمات, صواب, ق.السجل, سجل_مكدس_ذراع(),
                الإطار.الحجم_بايت + م.الإزاحة, الحجم, (ق.بإشارة != 0) && (ق.غير_مباشر == 0)
            );
        };
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.حساب_صحيح(الحساب) -> {
        أرجع ألحق_حساب_صحيح_ذراع(الكلمات, &الحساب);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.تحويل_صحيح(التحويل) -> {
        أرجع ألحق_تحويل_صحيح_ذراع(الكلمات, &التحويل);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.عنوان_إطار(الحجز) -> {
        دع مرجع_الإزاحة: &اختياري طبيعي = &الحجز.إزاحة_بايت;
        دع الإزاحة: اختياري طبيعي = *مرجع_الإزاحة;
        طابق الإزاحة مع
        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موضع_إطار_مفقود(الحجز.الهوية)); }
        | اختياري.موجود(إزاحة_بايت) -> {
            // SP هو السجل 31 في هذا الشكل من ADD؛ هوية SP لا تدخل allocator.
            لو (إزاحة_بايت <= 4095) {
                دع كلمة: طبيعي = 0x910003E0 + (إزاحة_بايت * 1024) + الحجز.الوجهة.القيمة;
                ألحق_كلمة_ذراع(الكلمات, كلمة);
                أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
            };
            // ADD-register يفسر Rn=31 كـ XZR، لذلك ابن العنوان من SP حصرا بصيغة ADD-immediate.
            ألحق_كلمة_ذراع(الكلمات, 0x910003E0 + الحجز.الوجهة.القيمة);
            دع الباقي: متغير طبيعي = إزاحة_بايت;
            طالما (الباقي > 0) {
                دع الجزء: متغير طبيعي = الباقي;
                لو (الجزء > 4095) { الجزء := 4095; };
                ألحق_كلمة_ذراع(
                    الكلمات,
                    0x91000000
                        + (الجزء * 1024)
                        + (الحجز.الوجهة.القيمة * 32)
                        + الحجز.الوجهة.القيمة
                );
                الباقي := الباقي - الجزء;
            }
            أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
        };
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.عنوان_إزاحة(الوجهة, الأساس, الإزاحة) -> {
        أرجع ألحق_عنوان_إزاحة_ذراع(الكلمات, الوجهة, الأساس, الإزاحة);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.عنوان_عنصر(الوجهة, الأساس, الفهرس, الحجم) -> {
        أرجع ألحق_عنوان_عنصر_ذراع(الكلمات, الوجهة, الأساس, الفهرس, الحجم);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.نسخ_ذاكرة(الوجهة, المصدر, الحجم, إزاحة_الوجهة, إزاحة_المصدر) -> {
        أرجع ألحق_نسخ_ذاكرة_ذراع(
            الكلمات, الوجهة, المصدر, الحجم, إزاحة_الوجهة, إزاحة_المصدر
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.تخزين_فوري(التخزين) -> {
        دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
        طابق ألحق_مادي_فوري_ذراع(الكلمات, العمل, التخزين.القيمة) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_نتيجة_كلمة(
            الكلمات,
            ترميز_ذاكرة_ذراع(خطأ, العمل, التخزين.الأساس, التخزين.الإزاحة مثل عدد, التخزين.الحجم, خطأ)
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.إلحاق_متجه(الإلحاق) -> {
        أرجع ألحق_إلحاق_متجه_ذراع(الكلمات, &الإلحاق, الدالة, المرفقات);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.ثابت_نص(الثابت) -> {
        أرجع ألحق_ثابت_نص_ذراع(الكلمات, &الثابت, الدالة, المرفقات);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.تخصيص_صندوق(الوجهة, الحجم, المحاذاة) -> {
        أرجع ألحق_تخصيص_صندوق_ذراع(
            الكلمات, الوجهة, الحجم, المحاذاة, الهدف, الدالة, المرفقات, فك_المكدس
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.جمع_سجل(الوجهة, أ, ب) -> {
        أرجع ألحق_نتيجة_كلمة(
            الكلمات,
            ترميز_حساب_سجل_ذراع(0x8B000000, الوجهة, أ, ب)
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.جمع_سجل_مزاح(الوجهة, الأساس, الفهرس, الإزاحة) -> {
        أرجع ألحق_نتيجة_كلمة(
            الكلمات,
            ترميز_جمع_سجل_مزاح_ذراع(الوجهة, الأساس, الفهرس, الإزاحة)
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.جمع_فوري(الوجهة, المصدر, الفوري) -> {
        أرجع ألحق_نتيجة_كلمة(
            الكلمات,
            ترميز_حساب_فوري_ذراع(0x91000000, الوجهة, المصدر, الفوري)
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.طرح_سجل(الوجهة, أ, ب) -> {
        أرجع ألحق_نتيجة_كلمة(
            الكلمات,
            ترميز_حساب_سجل_ذراع(0xCB000000, الوجهة, أ, ب)
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.طرح_فوري(الوجهة, المصدر, الفوري) -> {
        أرجع ألحق_نتيجة_كلمة(
            الكلمات,
            ترميز_حساب_فوري_ذراع(0xD1000000, الوجهة, المصدر, الفوري)
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.حساب_عشري(العملية, الوجهة, اليسار, اليمين, البتات) -> {
        أرجع ألحق_حساب_عشري_ذراع(الكلمات, العملية, الوجهة, اليسار, اليمين, البتات);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.قسمة_على_ثابت(الوجهة, المصدر, القاسم, البتات, موقع, باقي) -> {
        أرجع ألحق_قسمة_على_ثابت_ذراع(الكلمات, الوجهة, المصدر, القاسم, البتات, موقع, باقي);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.ضرب_جمع_مدمج(الوجهة, أ, ب, ج, البتات) -> {
        أرجع ألحق_ضرب_جمع_مدمج_ذراع(الكلمات, الوجهة, أ, ب, ج, البتات);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.تحويل_عائم(العملية, الوجهة, المصدر, من_بتات, إلى_بتات) -> {
        أرجع ألحق_تحويل_عائم_ذراع(الكلمات, العملية, الوجهة, المصدر, من_بتات, إلى_بتات);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.مقارنة_عشرية_إلى_منطق(العملية, الوجهة, اليسار, اليمين, البتات) -> {
        أرجع ألحق_مقارنة_عشرية_إلى_منطق_ذراع(الكلمات, العملية, الوجهة, اليسار, اليمين, البتات);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.مقارنة_سجل(أ, ب) -> {
        أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_سجل_ذراع(أ, ب));
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.مقارنة_فوري(السجل, الفوري) -> {
        أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_فوري_ذراع(السجل, الفوري));
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.ثبت_شرط(السجل, الشرط) -> {
        أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_ثبت_شرط_ذراع(السجل, الشرط));
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.فخ -> {
        ألحق_فخ_ذراع(الكلمات);
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.سياج -> {
        // dmb ish
        ألحق_كلمة_ذراع(الكلمات, 0xD5033BBF);
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.ذري(العملية, الوجهة, العنوان, القيمة, البتات) -> {
        أرجع ألحق_ذري_ذراع(الكلمات, العملية, الوجهة, العنوان, القيمة, البتات);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.ذري_قارن_وبدل(الوجهة, العنوان, المتوقع, الجديد, البتات) -> {
        دع الحجم: طبيعي = حقل_حجم_ذري_ذراع(البتات);
        // mov x16, expected; casal x16, new, [address]; mov destination, x16
        ألحق_كلمة_ذراع(الكلمات, 0x2A0003E0 + الحجم * 2 + (المتوقع.القيمة * 65536) + 16);
        ألحق_كلمة_ذراع(الكلمات, 0x88E0FC00 + الحجم + 1048576 + (العنوان.القيمة * 32) + الجديد.القيمة);
        ألحق_كلمة_ذراع(الكلمات, 0x2A0003E0 + الحجم * 2 + 1048576 + الوجهة.القيمة);
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.ذري_حمل(الوجهة, العنوان, البتات) -> {
        // ldar destination, [address]
        ألحق_كلمة_ذراع(الكلمات, 0x88DFFC00 + حقل_حجم_ذري_ذراع(البتات) + (العنوان.القيمة * 32) + الوجهة.القيمة);
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.ذري_خزن(العنوان, القيمة, البتات) -> {
        // stlr value, [address]
        ألحق_كلمة_ذراع(الكلمات, 0x889FFC00 + حقل_حجم_ذري_ذراع(البتات) + (العنوان.القيمة * 32) + القيمة.القيمة);
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.مدخل_سي(الوجهة) -> {
        // adr destination, tramp; b over; tramp: mov x14, x0; ldr x16, [x0]; br x16; over:
        // A C caller passes the environment in x0; SultanC closures take it in x14.
        ألحق_كلمة_ذراع(الكلمات, 0x10000040 + الوجهة.القيمة);
        ألحق_كلمة_ذراع(الكلمات, 0x14000004);
        ألحق_كلمة_ذراع(الكلمات, 0xAA0003EE);
        ألحق_كلمة_ذراع(الكلمات, 0xF9400010);
        ألحق_كلمة_ذراع(الكلمات, 0xD61F0200);
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_جدولي(المميز, الأهداف, الافتراضي, الأدنى) -> {
        // W16/X16 وX17 سجلات scratch محجوزة في قواعد Darwin ARM64.
        لو (المميز.القيمة > 30) {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(المميز));
        };
        // mov w16,wSelector.
        ألحق_كلمة_ذراع(الكلمات, 0x2A0003F0 + (المميز.القيمة * 65536));
        // w16 -= lowest: a tag below it wraps above the range (unsigned).
        لو (الأدنى != 0) {
            لو (الأدنى <= 4095) {
                // sub w16, w16, #lowest
                ألحق_كلمة_ذراع(الكلمات, 0x51000210 + (الأدنى * 1024));
            } وإلا {
                ألحق_ثابت_ط32_في_و17_ذراع(الكلمات, الأدنى);
                // sub w16, w16, w17
                ألحق_كلمة_ذراع(الكلمات, 0x4B110210);
            };
        };
        // cmp w16, last; b.hi default. CMP's immediate holds 12 bits; a
        // larger last index is compared through w17.
        دع الأخير: طبيعي = (الطول(الأهداف) مثل طبيعي) - 1;
        لو (الأخير <= 4095) {
            ألحق_كلمة_ذراع(الكلمات, 0x7100021F + (الأخير * 1024));
        } وإلا {
            ألحق_ثابت_ط32_في_و17_ذراع(الكلمات, الأخير);
            // cmp w16, w17 (subs wzr, w16, w17)
            ألحق_كلمة_ذراع(الكلمات, 0x6B11021F);
        };
        ألحق_فرع_داخلي_مؤجل(الكلمات, فروع_داخلية, الافتراضي,
            نوع_فرع_داخلي_ذراع.شرطي(شرط_ذراع_أربعة_وستون.أعلى_طبيعي()));
        // adr x17, table (+16); ldrsw x16,[x17,w16,uxtw #2]; add x17,x17,x16; br x17.
        ألحق_كلمة_ذراع(الكلمات, 0x10000091);
        ألحق_كلمة_ذراع(الكلمات, 0xB8B05A30);
        ألحق_كلمة_ذراع(الكلمات, 0x8B100231);
        ألحق_كلمة_ذراع(الكلمات, 0xD61F0220);
        دع بداية_الجدول: طبيعي = (الطول(*الكلمات) مثل طبيعي) * 4;
        دع فهرس: متغير طبيعي = 0;
        طالما (فهرس < (الطول(الأهداف) مثل طبيعي)) {
            ألحق_فرع_داخلي_مؤجل(الكلمات, فروع_داخلية, الأهداف[فهرس],
                نوع_فرع_داخلي_ذراع.مدخل_جدول(بداية_الجدول));
            فهرس := فهرس + 1;
        }
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.فرع(الهدف) -> {
        ألحق_فرع_داخلي_مؤجل(
            الكلمات,
            فروع_داخلية,
            الهدف,
            نوع_فرع_داخلي_ذراع.غير_شرطي()
        );
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_مع_نقلات(النقلات) -> {
        طابق ألحق_نقلات_حافة_ذراع(الكلمات, &النقلات) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
        }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_فرع_داخلي_مؤجل(
            الكلمات,
            فروع_داخلية,
            النقلات.الهدف,
            نوع_فرع_داخلي_ذراع.غير_شرطي()
        );
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_شرطي(الشرط, الهدف) -> {
        ألحق_فرع_داخلي_مؤجل(
            الكلمات,
            فروع_داخلية,
            الهدف,
            نوع_فرع_داخلي_ذراع.شرطي(الشرط)
        );
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_شرطي_مع_نقلات(الشرط, النقلات) -> {
        دع فهرس_التخطي: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع موضع_التخطي: طبيعي = فهرس_التخطي * 4;
        ألحق_كلمة_ذراع(الكلمات, 0);
        طابق ألحق_نقلات_حافة_ذراع(الكلمات, &النقلات) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
        }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_فرع_داخلي_مؤجل(
            الكلمات,
            فروع_داخلية,
            النقلات.الهدف,
            نوع_فرع_داخلي_ذراع.غير_شرطي()
        );
        دع عدد_بعد_الحزمة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع بعد_الحزمة: طبيعي = عدد_بعد_الحزمة * 4;
        طابق ترميز_فرع_شرطي_برمز_ذراع(
            موضع_التخطي,
            بعد_الحزمة,
            النقلات.الهدف,
            رمز_شرط_معكوس_ذراع(الشرط)
        ) مع
        | نتيجة_كلمة_ذراع.خطأ(الخطأ) -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
        }
        | نتيجة_كلمة_ذراع.نجحت(الكلمة) -> {

            عين_كلمة_ذراع(الكلمات, فهرس_التخطي, الكلمة);

        };
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_برابط_مباشر(النداء) -> {
        طابق تحقق_نداء_واجهة_ذراع(&النداء) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
        }
        | اختياري.لا_شيء -> { };

        // احفظ كل مصدر حجة قبل الكتابة إلى سجلات ABI. بعد فك تثبيت الحجج
        // عن X0..X7 يجب أن تكون تهيئة حد النداء متوازية دلاليا.
        دع عدد_الحفظ: متغير طبيعي = 0;
        دع فح: متغير طبيعي = 0;
        طالما (فح < (الطول(النداء.الحجج) مثل طبيعي)) {
            عدد_الحفظ := عدد_الحفظ + 1;
            فح := فح + 1;
        }
        دع مرجع_ناتج_النداء_للعد: &اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &النداء.الناتج;
        دع ناتج_النداء_للعد: اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_ناتج_النداء_للعد;
        طابق ناتج_النداء_للعد مع
        | اختياري.موجود(الناتج) -> { لو (الناتج.تجميعي != 0) { عدد_الحفظ := عدد_الحفظ + 1; }; }
        | اختياري.لا_شيء -> { };
        // التجميعات الأكبر من 16 بايت تمرر ABI بصورة غير مباشرة، لكن دلالة
        // SultanC للمعامل التجميعي VALUE تتطلب نسخة منفصلة يملكها هذا النداء.
        // ضع تلك النسخ بعد منطقة حجج ABI ومصادرها المحفوظة، مع محاذاة 16 بايت.
        دع حجم_هدف_غير_مباشر: متغير طبيعي = 0;
        طابق النداء.الهدف مع
        | هدف_نداء_ذراع_أربعة_وستون_مخصص.قيمة_دالة(_) -> { حجم_هدف_غير_مباشر := 8; }
        | هدف_نداء_ذراع_أربعة_وستون_مخصص.عنوان_سي(_) -> { حجم_هدف_غير_مباشر := 8; }
        | _ -> { };
        دع موضع_حفظ_هدف_غير_مباشر: طبيعي =
            النداء.حجم_مكدس_النداء + عدد_الحفظ * 8;
        دع بداية_نسخ_التجميعات: طبيعي = موضع_حفظ_هدف_غير_مباشر + حجم_هدف_غير_مباشر;
        دع نهاية_نسخ_التجميعات: متغير طبيعي = بداية_نسخ_التجميعات;
        فح := 0;
        طالما (فح < (الطول(النداء.الحجج) مثل طبيعي)) {
            دع مرجع_حجة_النسخ: &قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &النداء.الحجج[فح];
            دع حجة_النسخ: قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_حجة_النسخ;
            لو ((حجة_النسخ.تجميعي != 0) && (حجة_النسخ.غير_مباشر != 0)) {
                نهاية_نسخ_التجميعات := حاذ_حجم_نداء_ذراع(نهاية_نسخ_التجميعات);
                نهاية_نسخ_التجميعات := نهاية_نسخ_التجميعات + حجة_النسخ.الحجم;
            };
            فح := فح + 1;
        }
        دع حجم_مكدس_فعلي: طبيعي = حاذ_حجم_نداء_ذراع(نهاية_نسخ_التجميعات);
        لو (حجم_مكدس_فعلي > 0) {
            ألحق_تعديل_مؤشر_المكدس_ذراع(الكلمات, حجم_مكدس_فعلي, صواب, فك_المكدس);
        };

        // احفظ هدف النداء غير المباشر قبل ترتيب حجج ABI؛ قد تتداخل قيمة الهدف مع سجلات الحجج.
        طابق النداء.الهدف مع
        | هدف_نداء_ذراع_أربعة_وستون_مخصص.قيمة_دالة(الموقع) -> {
            دع حامل_الهدف: معرف_سجل_فعلي = { القيمة: 16 };
            طابق ألحق_تحميل_موقع_نداء_إلى_سجل_ذراع(
                الكلمات, &الموقع, حامل_الهدف, حجم_مكدس_فعلي
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            طابق ألحق_ذاكرة_بإزاحة_ذراع(
                الكلمات, خطأ, حامل_الهدف, سجل_مكدس_ذراع(), موضع_حفظ_هدف_غير_مباشر, 8, خطأ
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        }
        | هدف_نداء_ذراع_أربعة_وستون_مخصص.عنوان_سي(الموقع) -> {
            دع حامل_الهدف: معرف_سجل_فعلي = { القيمة: 16 };
            طابق ألحق_تحميل_موقع_نداء_إلى_سجل_ذراع(
                الكلمات, &الموقع, حامل_الهدف, حجم_مكدس_فعلي
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            طابق ألحق_ذاكرة_بإزاحة_ذراع(
                الكلمات, خطأ, حامل_الهدف, سجل_مكدس_ذراع(), موضع_حفظ_هدف_غير_مباشر, 8, خطأ
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        }
        | _ -> { };

        فح := 0;
        طالما (فح < (الطول(النداء.الحجج) مثل طبيعي)) {
            دع مرجع_حجة_الحفظ: &قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &النداء.الحجج[فح];
            دع حجة_الحفظ: قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_حجة_الحفظ;
            دع حامل_القيمة: معرف_سجل_فعلي = { القيمة: 16 };
            طابق ألحق_تحميل_موقع_نداء_إلى_سجل_ذراع(
                الكلمات, &حجة_الحفظ.الموقع, حامل_القيمة, حجم_مكدس_فعلي
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            دع إزاحة_الحفظ: طبيعي = النداء.حجم_مكدس_النداء + فح * 8;
            طابق ألحق_ذاكرة_بإزاحة_ذراع(
                الكلمات, خطأ, حامل_القيمة, سجل_مكدس_ذراع(), إزاحة_الحفظ, 8, خطأ
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            فح := فح + 1;
        }
        دع موضع_حفظ_الناتج: متغير اختياري طبيعي = اختياري.لا_شيء();
        دع مرجع_ناتج_النداء_للحفظ: &اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &النداء.الناتج;
        دع ناتج_النداء_للحفظ: اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_ناتج_النداء_للحفظ;
        طابق ناتج_النداء_للحفظ مع
        | اختياري.موجود(الناتج) -> {
            لو (الناتج.تجميعي != 0) {
                دع عدد_حجج_النداء: طبيعي = الطول(النداء.الحجج) مثل طبيعي;
                دع الإزاحة: طبيعي = النداء.حجم_مكدس_النداء + عدد_حجج_النداء * 8;
                دع حامل_العنوان: معرف_سجل_فعلي = { القيمة: 16 };
                طابق ألحق_تحميل_موقع_نداء_إلى_سجل_ذراع(
                    الكلمات, &الناتج.الموقع, حامل_العنوان, حجم_مكدس_فعلي
                ) مع
                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                طابق ألحق_ذاكرة_بإزاحة_ذراع(
                    الكلمات, خطأ, حامل_العنوان, سجل_مكدس_ذراع(), الإزاحة, 8, خطأ
                ) مع
                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                موضع_حفظ_الناتج := اختياري.موجود(الإزاحة);
            };
        }
        | اختياري.لا_شيء -> { };

        // خزّن قيم scalar الممررة على المكدس أولا، قبل الكتابة إلى X0..X7. بهذا لا يمكن
        // لتهيئة حجة سجل أن تمحو مصدرا لا يزال مطلوبا لحجة مكدس لاحقة.
        فح := 0;
        طالما (فح < (الطول(النداء.الحجج) مثل طبيعي)) {
            دع مرجع_الحجة: &قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &النداء.الحجج[فح];
            دع الحجة: قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_الحجة;
            لو (الحجة.تجميعي == 0) {
                دع مرجع_موضع_الحجة: &موضع_جزء_واجهة = &الحجة.المواضع[0];
                دع موضع_الحجة: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_موضع_الحجة);
                طابق موضع_الحجة مع
                | موضع_جزء_واجهة.مكدس(موضع) -> {
                    دع حامل_القيمة: معرف_سجل_فعلي = { القيمة: 16 };
                    دع إزاحة_الحفظ: طبيعي = النداء.حجم_مكدس_النداء + فح * 8;
                    طابق ألحق_ذاكرة_بإزاحة_ذراع(
                        الكلمات, صواب, حامل_القيمة, سجل_مكدس_ذراع(), إزاحة_الحفظ, 8, خطأ
                    ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
                        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
                    }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    دع الحجم: متغير طبيعي = الحجة.الحجم;
                    لو (الحجة.غير_مباشر != 0) { الحجم := 8; };
                    طابق ألحق_ذاكرة_بإزاحة_ذراع(
                        الكلمات, خطأ, حامل_القيمة, سجل_مكدس_ذراع(), موضع.الإزاحة, الحجم, خطأ
                    ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
                        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
                    }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                }
                | موضع_جزء_واجهة.سجل(_) -> { };
            };
            فح := فح + 1;
        }

        // بعد استهلاك كل مصادر المكدس، رتّب scalar register arguments. الطلبات الثابتة
        // للمخصص تجعل المصدر غير المسكوب في حامل ABI نفسه؛ المصدر المسكوب يعاد تحميله هنا.
        فح := 0;
        طالما (فح < (الطول(النداء.الحجج) مثل طبيعي)) {
            دع مرجع_الحجة: &قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &النداء.الحجج[فح];
            دع الحجة: قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_الحجة;
            لو (الحجة.تجميعي == 0) {
                دع مرجع_موضع_الحجة: &موضع_جزء_واجهة = &الحجة.المواضع[0];
                دع موضع_الحجة: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_موضع_الحجة);
                طابق موضع_الحجة مع
                | موضع_جزء_واجهة.سجل(المرجع) -> {
                    دع إزاحة_الحفظ: طبيعي = النداء.حجم_مكدس_النداء + فح * 8;
                    دع حامل_القيمة: معرف_سجل_فعلي = { القيمة: 16 };
                    طابق ألحق_ذاكرة_بإزاحة_ذراع(
                        الكلمات, صواب, حامل_القيمة, سجل_مكدس_ذراع(), إزاحة_الحفظ, 8, خطأ
                    ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    لو (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                        طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(
                            الكلمات, حامل_القيمة, المرجع.الفهرس, الحجة.الحجم * 8
                        ) مع
                        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    } وإلا {
                        طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                        | اختياري.موجود(سجل_الحامل) -> {
                            لو (!معرفا_سجل_فعلي_متساويان(سجل_الحامل, حامل_القيمة)) {
                                طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(سجل_الحامل, حامل_القيمة)) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                            };
                            لو (الحجة.الحجم < 4) {
                                طابق ألحق_تطبيع_عدد_ذراع(الكلمات, سجل_الحامل, سجل_الحامل, الحجة.الحجم * 8, الحجة.بإشارة != 0) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                            };
                        };
                    };
                }
                | موضع_جزء_واجهة.مكدس(_) -> { };
            };
            فح := فح + 1;
        }

        // حمّل كل تجميع من عنوانه المحفوظ إلى مواضع ABI المقررة.
        // التجميع غير المباشر ينسخ أولا إلى تخزين call-local كي تبقى دلالة VALUE
        // مستقلة عن تخزين المستدعي، ثم يمرر عنوان النسخة إلى ABI.
        دع إزاحة_نسخة_التجميع_التالية: متغير طبيعي = بداية_نسخ_التجميعات;
        فح := 0;
        طالما (فح < (الطول(النداء.الحجج) مثل طبيعي)) {
            دع مرجع_الحجة: &قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &النداء.الحجج[فح];
            دع الحجة: قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_الحجة;
            لو (الحجة.تجميعي != 0) {
                دع قاعدة_التجميع: معرف_سجل_فعلي = { القيمة: 16 };
                طابق ألحق_ذاكرة_بإزاحة_ذراع(
                    الكلمات, صواب, قاعدة_التجميع, سجل_مكدس_ذراع(),
                    النداء.حجم_مكدس_النداء + فح * 8, 8, خطأ
                ) مع
                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                لو (الحجة.غير_مباشر != 0) {
                    إزاحة_نسخة_التجميع_التالية := حاذ_حجم_نداء_ذراع(إزاحة_نسخة_التجميع_التالية);
                    دع إزاحة_النسخة: طبيعي = إزاحة_نسخة_التجميع_التالية;
                    إزاحة_نسخة_التجميع_التالية := إزاحة_نسخة_التجميع_التالية + الحجة.الحجم;
                    طابق ألحق_نسخ_ذاكرة_ذراع(
                        الكلمات, سجل_مكدس_ذراع(), قاعدة_التجميع, الحجة.الحجم, إزاحة_النسخة, 0
                    ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };

                    // ابن عنوان SP+offset بصيغة ADD-immediate فقط؛ Rn=31 في
                    // ADD-register يعني XZR وليس SP.
                    ألحق_كلمة_ذراع(الكلمات, 0x910003E0 + قاعدة_التجميع.القيمة);
                    دع باقي_إزاحة_النسخة: متغير طبيعي = إزاحة_النسخة;
                    طالما (باقي_إزاحة_النسخة > 0) {
                        دع جزء_إزاحة_النسخة: متغير طبيعي = باقي_إزاحة_النسخة;
                        لو (جزء_إزاحة_النسخة > 4095) { جزء_إزاحة_النسخة := 4095; };
                        ألحق_كلمة_ذراع(
                            الكلمات,
                            0x91000000
                                + (جزء_إزاحة_النسخة * 1024)
                                + (قاعدة_التجميع.القيمة * 32)
                                + قاعدة_التجميع.القيمة
                        );
                        باقي_إزاحة_النسخة := باقي_إزاحة_النسخة - جزء_إزاحة_النسخة;
                    }

                    دع مرجع_موضع_الحجة: &موضع_جزء_واجهة = &الحجة.المواضع[0];
                    دع موضع_الحجة: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_موضع_الحجة);
                    طابق موضع_الحجة مع
                    | موضع_جزء_واجهة.سجل(المرجع) -> {
                        طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                        | اختياري.موجود(سجل_الحامل) -> {
                            طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(سجل_الحامل, قاعدة_التجميع)) مع
                            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                        };
                    }
                    | موضع_جزء_واجهة.مكدس(موضع) -> {
                        طابق ألحق_ذاكرة_بإزاحة_ذراع(
                            الكلمات, خطأ, قاعدة_التجميع, سجل_مكدس_ذراع(), موضع.الإزاحة, 8, خطأ
                        ) مع
                        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    };
                } وإلا {
                    دع فج: متغير طبيعي = 0;
                    طالما (فج < (الطول(الحجة.المواضع) مثل طبيعي)) {
                        دع حجم_الجزء: طبيعي = عرض_جزء_تجميع_موقع_ذراع(&الحجة.المواضع, الحجة.الحجم, فج);
                        دع إزاحة_الجزء: طبيعي = إزاحة_جزء_تجميع_موقع_ذراع(&الحجة.المواضع, الحجة.الحجم, فج);
                        دع مرجع_موضع_الحجة: &موضع_جزء_واجهة = &الحجة.المواضع[فج];
                        دع موضع_الحجة: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_موضع_الحجة);
                        طابق موضع_الحجة مع
                        | موضع_جزء_واجهة.سجل(المرجع) -> {
                            لو (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                                دع حامل_العائم: معرف_سجل_فعلي = { القيمة: 15 };
                                طابق ألحق_ذاكرة_بإزاحة_ذراع(الكلمات, صواب, حامل_العائم, قاعدة_التجميع, إزاحة_الجزء, حجم_الجزء, خطأ) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                                طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, حامل_العائم, المرجع.الفهرس, حجم_الجزء * 8) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                            } وإلا {
                                طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                            | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                            | اختياري.موجود(سجل_الحامل) -> {
                                طابق ألحق_تحميل_جزء_تجميع_ذراع(
                                    الكلمات, سجل_الحامل, قاعدة_التجميع, إزاحة_الجزء, حجم_الجزء
                                ) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                            };
                            };
                        }
                        | موضع_جزء_واجهة.مكدس(موضع) -> {
                            // Use the encoder's memory-copy scratch (X15) instead of
                            // the closure environment register X14. No ABI value is live in X15.
                            طابق ألحق_نسخ_ذاكرة_ذراع(
                                الكلمات, سجل_مكدس_ذراع(), قاعدة_التجميع,
                                حجم_الجزء, موضع.الإزاحة, إزاحة_الجزء
                            ) مع
                            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                        };
                        فج := فج + 1;
                    }
                };
            };
            فح := فح + 1;
        }

        // نتيجة تجميع غير مباشرة: مرّر عنوان التخزين المحفوظ عبر موضع النتيجة (X8 في Darwin).
        دع مرجع_ناتج_النداء_غير_المباشر: &اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &النداء.الناتج;
        دع ناتج_النداء_غير_المباشر: اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_ناتج_النداء_غير_المباشر;
        طابق ناتج_النداء_غير_المباشر مع
        | اختياري.موجود(الناتج) -> {
            لو ((الناتج.تجميعي != 0) && (الناتج.غير_مباشر != 0)) {
                طابق موضع_حفظ_الناتج مع
                | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                | اختياري.موجود(الإزاحة) -> {
                    دع قاعدة_الناتج: معرف_سجل_فعلي = { القيمة: 16 };
                    طابق ألحق_ذاكرة_بإزاحة_ذراع(الكلمات, صواب, قاعدة_الناتج, سجل_مكدس_ذراع(), الإزاحة, 8, خطأ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    دع مرجع_موضع_الناتج: &موضع_جزء_واجهة = &الناتج.المواضع[0];
                    دع موضع_الناتج: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_موضع_الناتج);
                    طابق موضع_الناتج مع
                    | موضع_جزء_واجهة.سجل(المرجع) -> {
                        طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                        | اختياري.موجود(سجل_الحامل) -> {
                            طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(سجل_الحامل, قاعدة_الناتج)) مع
                            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                        };
                    }
                    | موضع_جزء_واجهة.مكدس(موضع) -> {
                        طابق ألحق_ذاكرة_بإزاحة_ذراع(
                            الكلمات, خطأ, قاعدة_الناتج, سجل_مكدس_ذراع(), موضع.الإزاحة, 8, خطأ
                        ) مع
                        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    };
                };
            };
        }
        | اختياري.لا_شيء -> { };

        طابق النداء.الهدف مع
        | هدف_نداء_ذراع_أربعة_وستون_مخصص.دالة(هدف_الدالة) -> {
            دع عدد_قبل_النداء: طبيعي = الطول(*الكلمات) مثل طبيعي;
            دع الموضع: طبيعي = عدد_قبل_النداء * 4;
            ألحق_كلمة_ذراع(الكلمات, 0x94000000);
            ألحق_تثبيت_نداء_ذراع(تثبيتات_رمزية, الموضع, هدف_الدالة);
        }
        | هدف_نداء_ذراع_أربعة_وستون_مخصص.دالة_خارجية(المعرف) -> {
            دع عدد_قبل_النداء: طبيعي = الطول(*الكلمات) مثل طبيعي;
            دع الموضع: طبيعي = عدد_قبل_النداء * 4;
            ألحق_كلمة_ذراع(الكلمات, 0x94000000);
            ألحق_إزاحة_رمز_خارجي_ذراع(المرفقات, الدالة, الموضع, المعرف);
        }
        | هدف_نداء_ذراع_أربعة_وستون_مخصص.بدائي_تشغيل(البدائي) -> {
            دع عدد_قبل_النداء: طبيعي = الطول(*الكلمات) مثل طبيعي;
            دع الموضع: طبيعي = عدد_قبل_النداء * 4;
            ألحق_كلمة_ذراع(الكلمات, 0x94000000);
            ألحق_إزاحة_بدائي_تشغيل_ذراع(المرفقات, الدالة, الموضع, البدائي);
        }
        | هدف_نداء_ذراع_أربعة_وستون_مخصص.قيمة_دالة(_) -> {
            دع حامل_الهدف: معرف_سجل_فعلي = { القيمة: 16 };
            طابق ألحق_ذاكرة_بإزاحة_ذراع(
                الكلمات, صواب, حامل_الهدف, سجل_مكدس_ذراع(), موضع_حفظ_هدف_غير_مباشر, 8, خطأ
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            دع سجل_البيئة: معرف_سجل_فعلي;
            طابق سجل_بيئة_إغلاق_للهدف(الهدف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                    خطأ_ترميز_ذراع_أربعة_وستون.سجل_واجهة_غير_متطابق(حامل_الهدف)
                );
            }
            | اختياري.موجود(السجل) -> { سجل_البيئة := السجل; };
            طابق ألحق_نتيجة_كلمة(
                الكلمات, ترميز_نقل_سجل_ذراع(سجل_البيئة, حامل_الهدف)
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            طابق ألحق_ذاكرة_بإزاحة_ذراع(
                الكلمات, صواب, حامل_الهدف, سجل_البيئة, 0, 8, خطأ
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            // BLR code-pointer loaded from the closure environment.
            ألحق_كلمة_ذراع(الكلمات, 0xD63F0000 + حامل_الهدف.القيمة * 32);
        }
        | هدف_نداء_ذراع_أربعة_وستون_مخصص.عنوان_سي(_) -> {
            // BLR x16 to the saved C function address: the arguments are in
            // their AAPCS64 registers (x0-x7, d0-d7). No variadic argument is
            // passed, so Apple's rule (variadic arguments on the stack) does
            // not arise; a variadic callee receives only its fixed ones.
            دع حامل_الهدف: معرف_سجل_فعلي = { القيمة: 16 };
            طابق ألحق_ذاكرة_بإزاحة_ذراع(
                الكلمات, صواب, حامل_الهدف, سجل_مكدس_ذراع(), موضع_حفظ_هدف_غير_مباشر, 8, خطأ
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            ألحق_كلمة_ذراع(الكلمات, 0xD63F0000 + حامل_الهدف.القيمة * 32);
        };

        // خزّن نتيجة scalar في موقعها المخصص، أو أعد تركيب نتيجة التجميع المباشرة
        // في التخزين الخلفي قبل تحرير منطقة النداء.
        دع مرجع_ناتج_النداء_بعد_النداء: &اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = &النداء.الناتج;
        دع ناتج_النداء_بعد_النداء: اختياري قيمة_نداء_ذراع_أربعة_وستون_مخصصة = *مرجع_ناتج_النداء_بعد_النداء;
        طابق ناتج_النداء_بعد_النداء مع
        | اختياري.موجود(الناتج) -> {
            لو (الناتج.تجميعي == 0) {
                دع مرجع_موضع_الناتج: &موضع_جزء_واجهة = &الناتج.المواضع[0];
                دع موضع_الناتج: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_موضع_الناتج);
                طابق موضع_الناتج مع
                | موضع_جزء_واجهة.سجل(المرجع) -> {
                    دع حامل_الناتج: معرف_سجل_فعلي = { القيمة: 16 };
                    لو (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                        طابق ألحق_نقل_بتات_عائم_إلى_عام_ذراع(
                            الكلمات, حامل_الناتج, المرجع.الفهرس, الناتج.الحجم * 8
                        ) مع
                        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    } وإلا {
                        طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                        | اختياري.موجود(سجل_الحامل) -> {
                            لو (الناتج.الحجم < 8) {
                                طابق ألحق_تطبيع_عدد_ذراع(الكلمات, سجل_الحامل, سجل_الحامل, الناتج.الحجم * 8, الناتج.بإشارة != 0) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                            };
                            لو (!معرفا_سجل_فعلي_متساويان(حامل_الناتج, سجل_الحامل)) {
                                طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(حامل_الناتج, سجل_الحامل)) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                            };
                        };
                    };
                    طابق ألحق_تخزين_سجل_إلى_موقع_نداء_ذراع(الكلمات, حامل_الناتج, &الناتج.الموقع, حجم_مكدس_فعلي) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                }
                | موضع_جزء_واجهة.مكدس(_) -> {
                    أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                        خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()
                    );
                };
            } وإلا لو (الناتج.غير_مباشر == 0) {
                طابق موضع_حفظ_الناتج مع
                | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                | اختياري.موجود(الإزاحة) -> {
                    دع قاعدة_الناتج: معرف_سجل_فعلي = { القيمة: 16 };
                    طابق ألحق_ذاكرة_بإزاحة_ذراع(الكلمات, صواب, قاعدة_الناتج, سجل_مكدس_ذراع(), الإزاحة, 8, خطأ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    دع فج: متغير طبيعي = 0;
                    طالما (فج < (الطول(الناتج.المواضع) مثل طبيعي)) {
                        دع حجم_الجزء: طبيعي = عرض_جزء_تجميع_موقع_ذراع(&الناتج.المواضع, الناتج.الحجم, فج);
                        دع إزاحة_الجزء: طبيعي = إزاحة_جزء_تجميع_موقع_ذراع(&الناتج.المواضع, الناتج.الحجم, فج);
                        دع مرجع_موضع_الناتج: &موضع_جزء_واجهة = &الناتج.المواضع[فج];
                        دع موضع_الناتج: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_موضع_الناتج);
                        طابق موضع_الناتج مع
                        | موضع_جزء_واجهة.سجل(المرجع) -> {
                            لو (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                                دع حامل_العائم: معرف_سجل_فعلي = { القيمة: 15 };
                                طابق ألحق_نقل_بتات_عائم_إلى_عام_ذراع(الكلمات, حامل_العائم, المرجع.الفهرس, حجم_الجزء * 8) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                                طابق ألحق_ذاكرة_بإزاحة_ذراع(الكلمات, خطأ, حامل_العائم, قاعدة_الناتج, إزاحة_الجزء, حجم_الجزء, خطأ) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                            } وإلا {
                                طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                            | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                            | اختياري.موجود(سجل_الحامل) -> {
                                طابق ألحق_تخزين_جزء_تجميع_ذراع(
                                    الكلمات, سجل_الحامل, قاعدة_الناتج, إزاحة_الجزء, حجم_الجزء
                                ) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                            };
                            };
                        }
                        | موضع_جزء_واجهة.مكدس(_) -> {
                            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
                        };
                        فج := فج + 1;
                    }
                };
            };
        }
        | اختياري.لا_شيء -> { };

        لو (حجم_مكدس_فعلي > 0) {
            ألحق_تعديل_مؤشر_المكدس_ذراع(الكلمات, حجم_مكدس_فعلي, خطأ, فك_المكدس);
        };
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.عودة -> {
        دع عدد_كلمات_بداية_الخاتمة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع بداية_الخاتمة: طبيعي = عدد_كلمات_بداية_الخاتمة * 4;
        سجل_حفظ_حالة_فك_المكدس(فك_المكدس, بداية_الخاتمة);
        طابق ألحق_حفظ_إطار_ذراع(الكلمات, &الإطار, صواب, الهدف, فك_المكدس) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_تعديل_مؤشر_المكدس_ذراع(الكلمات, الإطار.الحجم_بايت, خطأ, فك_المكدس);
        ألحق_كلمة_ذراع(الكلمات, 0xD65F03C0);
        دع عدد_كلمات_نهاية_الخاتمة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع نهاية_الخاتمة: طبيعي = عدد_كلمات_نهاية_الخاتمة * 4;
        سجل_استعادة_حالة_فك_المكدس(فك_المكدس, نهاية_الخاتمة);
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.عودة_بقيمة(الناتج) -> {
        طابق تحقق_عودة_واجهة_ذراع(&الناتج) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        دع مرجع_قيمة_الناتج: &قيمة_واجهة_ذراع_أربعة_وستون_مخصصة = &الناتج.القيمة;
        دع ق: قيمة_واجهة_ذراع_أربعة_وستون_مخصصة = *مرجع_قيمة_الناتج;
        لو (ق.تجميعي != 0) {
            لو (ق.غير_مباشر != 0) {
                دع مرجع_عنوان_الناتج: &اختياري معرف_سجل_فعلي = &الناتج.عنوان_ناتج_غير_مباشر;
                دع نسخة_عنوان_الناتج: اختياري معرف_سجل_فعلي = *مرجع_عنوان_الناتج;
                طابق نسخة_عنوان_الناتج مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
                }
                | اختياري.موجود(عنوان_الناتج) -> {
                    طابق ألحق_نسخ_ذاكرة_ذراع(
                        الكلمات, عنوان_الناتج, ق.السجل, ق.الحجم, 0, 0
                    ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                };
            } وإلا {
                // ثبّت عنوان التخزين قبل الكتابة إلى X0/X1 فقد يخصص له أحد سجلات النتيجة نفسها.
                دع قاعدة_الناتج: معرف_سجل_فعلي = { القيمة: 16 };
                طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(قاعدة_الناتج, ق.السجل)) مع
                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                دع فج: متغير طبيعي = 0;
                طالما (فج < (الطول(ق.المواضع) مثل طبيعي)) {
                    دع حجم_الجزء: طبيعي = عرض_جزء_تجميع_موقع_ذراع(&ق.المواضع, ق.الحجم, فج);
                        دع إزاحة_الجزء: طبيعي = إزاحة_جزء_تجميع_موقع_ذراع(&ق.المواضع, ق.الحجم, فج);
                    دع مرجع_موضع_الناتج: &موضع_جزء_واجهة = &ق.المواضع[فج];
                    دع موضع_الناتج: موضع_جزء_واجهة = انسخ_موضع_جزء_واجهة(مرجع_موضع_الناتج);
                    طابق موضع_الناتج مع
                    | موضع_جزء_واجهة.سجل(المرجع) -> {
                        لو (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                                دع حامل_العائم: معرف_سجل_فعلي = { القيمة: 15 };
                                طابق ألحق_ذاكرة_بإزاحة_ذراع(الكلمات, صواب, حامل_العائم, قاعدة_الناتج, إزاحة_الجزء, حجم_الجزء, خطأ) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                                طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, حامل_العائم, المرجع.الفهرس, حجم_الجزء * 8) مع
                                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                            } وإلا {
                                طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                        | اختياري.موجود(سجل_الحامل) -> {
                            طابق ألحق_تحميل_جزء_تجميع_ذراع(
                                الكلمات, سجل_الحامل, قاعدة_الناتج, إزاحة_الجزء, حجم_الجزء
                            ) مع
                            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                        };
                            };
                    }
                    | موضع_جزء_واجهة.مكدس(_) -> {
                        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم());
                    };
                    فج := فج + 1;
                }
            };
        } وإلا {
            // القيمة القياسية تبقى في سجل allocator عادي طوال حياتها. انقلها
            // إلى سجل نتيجة ABI فقط عند حد الإرجاع كي لا تتحول X0/X1 إلى قيد
            // تخصيص طويل العمر يعارض caller-saved clobbers عبر النداءات.
            لو ((الطول(ق.المواضع) مثل طبيعي) != 1) {
                أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                    خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()
                );
            };
            دع مرجع_موضع_الناتج_المفرد: &موضع_جزء_واجهة = &ق.المواضع[0];
            دع موضع_الناتج_المفرد: موضع_جزء_واجهة =
                انسخ_موضع_جزء_واجهة(مرجع_موضع_الناتج_المفرد);
            طابق موضع_الناتج_المفرد مع
            | موضع_جزء_واجهة.سجل(المرجع) -> {
                لو (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                    طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(
                        الكلمات, ق.السجل, المرجع.الفهرس, ق.الحجم * 8
                    ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                } وإلا {
                    طابق سجل_فعلي_لمرجع_واجهة_ذراع(&المرجع) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()); }
                    | اختياري.موجود(سجل_الناتج) -> {
                        لو (!معرفا_سجل_فعلي_متساويان(سجل_الناتج, ق.السجل)) {
                            طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(سجل_الناتج, ق.السجل)) مع
                            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                        };
                    };
                };
            }
            | موضع_جزء_واجهة.مكدس(_) -> {
                أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                    خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()
                );
            };
        };
        دع عدد_كلمات_بداية_الخاتمة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع بداية_الخاتمة: طبيعي = عدد_كلمات_بداية_الخاتمة * 4;
        سجل_حفظ_حالة_فك_المكدس(فك_المكدس, بداية_الخاتمة);
        طابق ألحق_حفظ_إطار_ذراع(الكلمات, &الإطار, صواب, الهدف, فك_المكدس) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_تعديل_مؤشر_المكدس_ذراع(الكلمات, الإطار.الحجم_بايت, خطأ, فك_المكدس);
        ألحق_كلمة_ذراع(الكلمات, 0xD65F03C0);
        دع عدد_كلمات_نهاية_الخاتمة: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع نهاية_الخاتمة: طبيعي = عدد_كلمات_نهاية_الخاتمة * 4;
        سجل_استعادة_حالة_فك_المكدس(فك_المكدس, نهاية_الخاتمة);
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.تحميل_أساس_إزاحة(السجل, العنوان, الحجم, بإشارة) -> {
        لو (العنوان.إزاحة_بايت < 0) {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                خطأ_ترميز_ذراع_أربعة_وستون.إزاحة_ذاكرة_خارج_المدى(العنوان.إزاحة_بايت)
            );
        };
        أرجع ألحق_ذاكرة_بإزاحة_ذراع(
            الكلمات, صواب, السجل, العنوان.الأساس,
            العنوان.إزاحة_بايت مثل طبيعي, الحجم, بإشارة
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.تخزين_أساس_إزاحة(السجل, العنوان, الحجم) -> {
        لو (العنوان.إزاحة_بايت < 0) {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                خطأ_ترميز_ذراع_أربعة_وستون.إزاحة_ذاكرة_خارج_المدى(العنوان.إزاحة_بايت)
            );
        };
        دع الإزاحة: طبيعي = العنوان.إزاحة_بايت مثل طبيعي;
        لو (الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8) {
            أرجع ألحق_ذاكرة_بإزاحة_ذراع(
                الكلمات, خطأ, السجل, العنوان.الأساس, الإزاحة, الحجم, خطأ
            );
        };
        لو (الحجم > 0 && الحجم <= 8) {
            // ذيل تجميع ABI قد يكون 3/5/6/7 بايت. خزنه بايتيا من حامل
            // السجل بدلا من طلب تعليمة ذاكرة ARM64 بعرض غير موجود.
            أرجع ألحق_تخزين_جزء_تجميع_ذراع(
                الكلمات, السجل, العنوان.الأساس, الإزاحة, الحجم
            );
        };
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم)
        );
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(السجل, الموقع) -> {
        أرجع ألحق_انسكاب_بإزاحة_ذراع(الكلمات, صواب, السجل, &الموقع);
    }
    | تعليمة_ذراع_أربعة_وستون_مخصصة.تخزين_انسكاب(الموقع, السجل) -> {
        أرجع ألحق_انسكاب_بإزاحة_ذراع(الكلمات, خطأ, السجل, &الموقع);
    };
}

عرف ابحث_موضع_كتلة_ذراع(
    المواقع: &متجه موضع_كتلة_ذراع,
    الهدف: معرف_كتلة_منتقاة
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواقع) مثل طبيعي)) {
        لو (معرفا_كتلة_منتقاة_متساويان((*المواقع)[ف].المعرف, الهدف)) {
            أرجع اختياري.موجود((*المواقع)[ف].إزاحة_بايت);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف حل_فروع_داخلية_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    المواقع: &متجه موضع_كتلة_ذراع,
    التثبيتات: &متجه تثبيت_فرع_داخلي_ذراع
): اختياري خطأ_ترميز_ذراع_أربعة_وستون {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التثبيتات) مثل طبيعي)) {
        دع التثبيت: تثبيت_فرع_داخلي_ذراع = (*التثبيتات)[ف];
        طابق ابحث_موضع_كتلة_ذراع(المواقع, التثبيت.الهدف) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(
                خطأ_ترميز_ذراع_أربعة_وستون.هدف_كتلة_مفقود(التثبيت.الهدف)
            );
        }
        | اختياري.موجود(موضع_الهدف) -> {
            طابق التثبيت.النوع مع
            | نوع_فرع_داخلي_ذراع.مدخل_جدول(بداية_الجدول) -> {
                دع الإزاحة: عدد = (موضع_الهدف مثل عدد) - (بداية_الجدول مثل عدد);
                لو (الإزاحة < -2147483648 || الإزاحة > 2147483647) {
                    أرجع اختياري.موجود(خطأ_ترميز_ذراع_أربعة_وستون.فرع_خارج_المدى(التثبيت.الهدف));
                };
                عين_كلمة_ذراع(الكلمات, التثبيت.فهرس_الكلمة, كلمة_ذراع((الإزاحة مثل طبيعي) & 0xFFFFFFFF));
            }
            | نوع_فرع_داخلي_ذراع.غير_شرطي -> {
                طابق ترميز_فرع_نسبي_ذراع(
                    التثبيت.موضع_بايت,
                    موضع_الهدف,
                    التثبيت.الهدف
                ) مع
                | نتيجة_كلمة_ذراع.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة_كلمة_ذراع.نجحت(الكلمة) -> {
                    عين_كلمة_ذراع(الكلمات, التثبيت.فهرس_الكلمة, الكلمة);
                };
            }
            | نوع_فرع_داخلي_ذراع.شرطي(الشرط) -> {
                طابق ترميز_فرع_شرطي_نسبي_ذراع(
                    التثبيت.موضع_بايت,
                    موضع_الهدف,
                    التثبيت.الهدف,
                    الشرط
                ) مع
                | نتيجة_كلمة_ذراع.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة_كلمة_ذراع.نجحت(الكلمة) -> {
                    عين_كلمة_ذراع(الكلمات, التثبيت.فهرس_الكلمة, الكلمة);
                };
            };
        };
        ف := ف + 1;
    }

    أرجع اختياري.لا_شيء();
}

عام عرف شفّر_دالة_ذراع(
    الدالة: &دالة_ذراع_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف,
    المرفقات: &متغير مرفقات_كائن_مشفرة
): نتيجة_دالة_ترميز_ذراع {
    دع د: دالة_ذراع_أربعة_وستون_مخصصة = *الدالة;
    دع الكلمات: متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة = [];
    دع الفروع: متغير متجه تثبيت_فرع_داخلي_ذراع = [];
    دع التثبيتات: متغير متجه تثبيت_ذراع_أربعة_وستون = [];
    دع المواقع: متغير متجه موضع_كتلة_ذراع = [];
    دع أصول_الآلة: متغير متجه مدى_شفرة_آلة_بأصل = [];
    دع فك_المكدس: متغير متتبع_فك_المكدس = متتبع_فك_المكدس_جديد(الهدف);
    ألحق_تعديل_مؤشر_المكدس_ذراع(
        &متغير الكلمات,
        د.إطار_الانسكاب.الحجم_بايت,
        صواب,
        &متغير فك_المكدس
    );
    طابق ألحق_حفظ_إطار_ذراع(
        &متغير الكلمات, &د.إطار_الانسكاب, خطأ, الهدف, &متغير فك_المكدس
    ) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
        أرجع نتيجة_دالة_ترميز_ذراع.خطأ(الخطأ);
    }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(د.الكتل) مثل طبيعي)) {
        دع مرجع_الكتلة: &كتلة_ذراع_أربعة_وستون_مخصصة = &د.الكتل[ك];
        دع الكتلة: كتلة_ذراع_أربعة_وستون_مخصصة = *مرجع_الكتلة;
        دع عدد_الكلمات_للكتلة: طبيعي = الطول(الكلمات) مثل طبيعي;
        دع إزاحة_الكتلة: طبيعي = عدد_الكلمات_للكتلة * 4;
        دع الموقع: موضع_كتلة_ذراع = {
            المعرف: الكتلة.الرأس.المعرف,
            إزاحة_بايت: إزاحة_الكتلة
        };
        ألحق(المواقع, الموقع);
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(الكتلة.التعليمات) مثل طبيعي)) {
            دع عدد_كلمات_بداية_الأصل: طبيعي = الطول(الكلمات) مثل طبيعي;
            دع بداية_الأصل: طبيعي = عدد_كلمات_بداية_الأصل * 4;
            طابق شفّر_تعليمة_ذراع(
                &الكتلة.التعليمات[ت],
                &د.إطار_الانسكاب,
                &متغير الكلمات,
                &متغير الفروع,
                &متغير التثبيتات,
                الهدف,
                د.الرأس.المعرف,
                المرفقات,
                &متغير فك_المكدس
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
                أرجع نتيجة_دالة_ترميز_ذراع.خطأ(الخطأ);
            }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            دع عدد_كلمات_نهاية_الأصل: طبيعي = الطول(الكلمات) مثل طبيعي;
            دع نهاية_الأصل: طبيعي = عدد_كلمات_نهاية_الأصل * 4;
            طابق مرجع_تصحيح_تعليمة_آلة_عند(&الكتلة.أصول_التعليمات, ت) مع
            | اختياري.موجود(مرجع_التصحيح) -> {
                لو (نهاية_الأصل > بداية_الأصل) {
                    دع حجم_الأصل: طبيعي = نهاية_الأصل - بداية_الأصل;
                    دع المدى: مدى_شفرة_آلة_بأصل = {
                        الدالة: د.الرأس.المعرف,
                        إزاحة_بايت: بداية_الأصل,
                        حجم_بايت: حجم_الأصل,
                        الأصل: مرجع_التصحيح.الأصل,
                        موقع_التصحيح: مرجع_التصحيح.موقع_التصحيح,
                        نطاق_التصحيح: مرجع_التصحيح.نطاق_التصحيح
                    };
                    ألحق(أصول_الآلة, المدى);
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    طابق حل_فروع_داخلية_ذراع(&متغير الكلمات, &المواقع, &الفروع) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_دالة_ترميز_ذراع.خطأ(الخطأ);
    }
    | اختياري.لا_شيء -> { };
    دع أحداث_فك_المكدس: متجه حدث_فك_المكدس = انسخ_أحداث_فك_المكدس(&فك_المكدس.الأحداث);
    دع الناتج: دالة_ذراع_أربعة_وستون_مشفرة = {
        المعرف: د.الرأس.المعرف,
        الكلمات: الكلمات,
        التثبيتات: التثبيتات,
        أصول_الآلة: أصول_الآلة,
        أحداث_فك_المكدس: أحداث_فك_المكدس
    };
    أرجع نتيجة_دالة_ترميز_ذراع.نجحت(الناتج);
}

عام عرف شفّر_ذراع_أربعة_وستون(
    الشفرة: &شفرة_ذراع_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف
): نتيجة_ترميز_ذراع_أربعة_وستون {
    دع ش: شفرة_ذراع_أربعة_وستون_مخصصة = *الشفرة;
    دع و: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(ش.الرأس.الهدف, و.المعرف)) {
        أرجع نتيجة_ترميز_ذراع_أربعة_وستون.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.هدف_غير_صالح(ش.الرأس.الهدف)
        );
    };
    طابق و.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | _ -> {
        أرجع نتيجة_ترميز_ذراع_أربعة_وستون.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.هدف_غير_صالح(و.المعرف)
        );
    };
    دع الدوال: متغير متجه دالة_ذراع_أربعة_وستون_مشفرة = [];
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ش.الدوال) مثل طبيعي)) {
        دع مرجع_الدالة: &دالة_ذراع_أربعة_وستون_مخصصة = &ش.الدوال[ف];
        طابق شفّر_دالة_ذراع(مرجع_الدالة, &و, &متغير المرفقات) مع
        | نتيجة_دالة_ترميز_ذراع.خطأ(الخطأ) -> {
            أرجع نتيجة_ترميز_ذراع_أربعة_وستون.خطأ(الخطأ);
        }
        | نتيجة_دالة_ترميز_ذراع.نجحت(الدالة) -> {
            ألحق(الدوال, الدالة);
        };
        ف := ف + 1;
    }
    دع الناتج: شفرة_ذراع_أربعة_وستون_مشفرة = {
        الهدف: و.المعرف,
        الدوال: الدوال,
        المرفقات: المرفقات,
        دخول_عملية_داروين: اختياري.لا_شيء()
    };
    أرجع نتيجة_ترميز_ذراع_أربعة_وستون.نجح(الناتج);
}

// Darwin dyld calls main(int argc, char **argv, char **envp, char **apple).
// Linux ELF's kernel initial stack has a different contract and is never read
// here. The stub runs after dyld has invoked module initializers, immediately
// before the canonical parameterless SultanC language entry.
عرف معرف_رمز_إقلاع_داروين_ذراع(
    الرموز_الخارجية: &متغير متجه متجه ط8,
    الاسم: &متجه ط8
): معرف_دالة_خارجية_منتقاة {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الرموز_الخارجية) مثل طبيعي)) {
        لو (اسما_رمز_خارجي_كائن_متساويان(&(*الرموز_الخارجية)[الفهرس], الاسم)) {
            دع المعرف: معرف_دالة_خارجية_منتقاة = { القيمة: الفهرس };
            أرجع المعرف;
        };
        الفهرس := الفهرس + 1;
    }
    دع المعرف: معرف_دالة_خارجية_منتقاة = {
        القيمة: الطول(*الرموز_الخارجية) مثل طبيعي
    };
    ألحق(*الرموز_الخارجية, انسخ_اسم_رمز_خارجي_كائن(الاسم));
    أرجع المعرف;
}

عرف ألحق_إزاحة_دخول_داروين_ذراع(
    الإزاحات: &متغير متجه إزاحة_دخول_داروين_ذراع,
    الموضع: طبيعي,
    النوع: نوع_إزاحة_رمزية_كائن,
    الرمز: مرجع_رمز_كائن
): فراغ {
    دع الطلب: إزاحة_دخول_داروين_ذراع = {
        إزاحة_بايت: الموضع, النوع: النوع, الرمز: الرمز
    };
    ألحق(*الإزاحات, الطلب);
}

عام عرف أضف_دخول_عملية_داروين_ذراع(
    الشفرة: &متغير شفرة_ذراع_أربعة_وستون_مشفرة,
    الدالة: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متغير متجه متجه ط8
): فراغ {
    طابق الدالة مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(المدخل) -> {
        // The linker entry is _main. The source function retains its own
        // identity so internal calls and function-pointer relocations work.
        دع اسم_الرئيسي: متجه ط8 = بايتات_من_نص(«main»);
        دع رمز_الرئيسي: معرف_دالة_خارجية_منتقاة =
            معرف_رمز_إقلاع_داروين_ذراع(الرموز_الخارجية, &اسم_الرئيسي);
        دع اسم_عدد_الوسائط: متجه ط8 = اسم_عدد_وسائط_إقلاع_أساسي();
        دع اسم_مؤشر_الوسائط: متجه ط8 = اسم_مؤشر_وسائط_إقلاع_أساسي();
        دع اسم_مؤشر_البيئة: متجه ط8 = اسم_مؤشر_بيئة_إقلاع_أساسي();
        دع الأسماء: متجه متجه ط8 = [اسم_عدد_الوسائط, اسم_مؤشر_الوسائط, اسم_مؤشر_البيئة];
        دع الرموز: متغير متجه معرف_دالة_خارجية_منتقاة = [];
        دع الكلمات: متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة = [];
        دع الإزاحات: متغير متجه إزاحة_دخول_داروين_ذراع = [];
        // W0 is the 32-bit process argc. Zero the high half before storing u64.
        ألحق_كلمة_ذراع(&متغير الكلمات, 0x2A0003E0); // mov w0, w0
        ألحق_كلمة_ذراع(&متغير الكلمات, 0xA9BF7BFD); // stp x29,x30,[sp,#-16]!
        ألحق_كلمة_ذراع(&متغير الكلمات, 0x910003FD); // mov x29,sp
        دع فهرس: متغير طبيعي = 0;
        طالما (فهرس < (الطول(الأسماء) مثل طبيعي)) {
            دع المعرف: معرف_دالة_خارجية_منتقاة =
                معرف_رمز_إقلاع_داروين_ذراع(الرموز_الخارجية, &الأسماء[فهرس]);
            ألحق(الرموز, المعرف);
            دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.رمز_خارجي(المعرف);
            دع موضع_صفحة: طبيعي = (الطول(الكلمات) مثل طبيعي) * 4;
            ألحق_كلمة_ذراع(&متغير الكلمات, 0x90000009); // adrp x9, symbol@PAGE
            ألحق_إزاحة_دخول_داروين_ذراع(
                &متغير الإزاحات, موضع_صفحة,
                نوع_إزاحة_رمزية_كائن.صفحة_ذراع_واحد_وعشرون_بت(),
                انسخ_مرجع_رمز_كائن(&المرجع)
            );
            دع موضع_صفحة_سفلي: طبيعي = (الطول(الكلمات) مثل طبيعي) * 4;
            ألحق_كلمة_ذراع(&متغير الكلمات, 0x91000129); // add x9,x9,symbol@PAGEOFF
            ألحق_إزاحة_دخول_داروين_ذراع(
                &متغير الإزاحات, موضع_صفحة_سفلي,
                نوع_إزاحة_رمزية_كائن.إزاحة_صفحة_ذراع_اثنا_عشر_بت(),
                انسخ_مرجع_رمز_كائن(&المرجع)
            );
            ألحق_كلمة_ذراع(&متغير الكلمات, 0xF9000120 + فهرس); // str x0/x1/x2,[x9]
            فهرس := فهرس + 1;
        }
        دع موضع_نداء: طبيعي = (الطول(الكلمات) مثل طبيعي) * 4;
        ألحق_كلمة_ذراع(&متغير الكلمات, 0x94000000); // bl canonical language entry
        ألحق_إزاحة_دخول_داروين_ذراع(
            &متغير الإزاحات, موضع_نداء,
            نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت(),
            مرجع_رمز_كائن.دالة(المدخل)
        );
        ألحق_كلمة_ذراع(&متغير الكلمات, 0xA8C17BFD); // ldp x29,x30,[sp],#16
        ألحق_كلمة_ذراع(&متغير الكلمات, 0xD65F03C0); // ret, preserving W0 result
        دع الدخول: دخول_عملية_داروين_ذراع = {
            رمز_الدخول: رمز_الرئيسي,
            رموز_الإقلاع: الرموز,
            الكلمات: الكلمات,
            الإزاحات: الإزاحات
        };
        (*الشفرة).دخول_عملية_داروين := اختياري.موجود(الدخول);
    };
}
