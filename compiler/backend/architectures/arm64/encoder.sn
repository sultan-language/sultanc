    دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.بيانات_ثابتة(المعرف);
    دع الطلب: طلب_إزاحة_نص_كائن = {
        الموضع: موضع_النص, النوع: النوع, الرمز: الرمز, الإضافة: 0
    };
