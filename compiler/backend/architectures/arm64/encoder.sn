استورد compiler.backend.architectures.arm64.encoded_code;
استورد compiler.backend.architectures.arm64.allocated_code;
استورد compiler.backend.architectures.arm64.instruction_model;
استورد compiler.backend.abi.abi_model;
استورد compiler.backend.codegen.division_by_constant;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.codegen.call_frame_information;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.register_query_context;
استورد compiler.backend.target.runtime_query_context;
استورد compiler.backend.target.runtime_allocation_model;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.backend.object.object_reference_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_runtime_abi;
استورد std.text.from_bytes;

نوع نوع_فرع_داخلي_ذراع =
    | غير_شرطي
    | شرطي بنوع شرط_ذراع_أربعة_وستون
    | مدخل_جدول بنوع طبيعي
;

نوع تثبيت_فرع_داخلي_ذراع = {
    فهرس_الكلمة: طبيعي,
    موضع_بايت: طبيعي,
    الهدف: معرف_كتلة_منتقاة,
    النوع: نوع_فرع_داخلي_ذراع
};

نوع موضع_كتلة_ذراع = {
    المعرف: معرف_كتلة_منتقاة,
    إزاحة_بايت: طبيعي
};

عام نوع خطأ_ترميز_ذراع_أربعة_وستون =
    | هدف_غير_صالح بنوع معرف_هدف
    | سجل_فعلي_غير_صالح بنوع معرف_سجل_فعلي
    | سجل_واجهة_غير_متطابق بنوع معرف_سجل_فعلي
    | فوري_حساب_خارج_المدى بنوع طبيعي
    | إزاحة_ذاكرة_خارج_المدى بنوع عدد
    | عرض_ذاكرة_غير_مدعوم بنوع طبيعي
    | عرض_عدد_غير_مدعوم بنوع طبيعي
    | موقع_واجهة_غير_مدعوم
    | موضع_إطار_مفقود بنوع طبيعي
    | إزاحة_انسكاب_خارج_المدى بنوع طبيعي
    | هدف_كتلة_مفقود بنوع معرف_كتلة_منتقاة
    | فرع_غير_محاذى بنوع معرف_كتلة_منتقاة
    | فرع_خارج_المدى بنوع معرف_كتلة_منتقاة
    | نقل_حافة_غير_قابل_للترميز
    | تخصيص_ذاكرة_غير_متاح
;

عام نوع نتيجة_ترميز_ذراع_أربعة_وستون =
    | نجح بنوع شفرة_ذراع_أربعة_وستون_مشفرة
    | خطأ بنوع خطأ_ترميز_ذراع_أربعة_وستون
;

نوع نتيجة_كلمة_ذراع =
    | نجحت بنوع كلمة_ذراع_أربعة_وستون_مشفرة
    | خطأ بنوع خطأ_ترميز_ذراع_أربعة_وستون
;

نوع نتيجة_دفعة_ترميز_ذراع =
    | نجحت
    | خطأ بنوع خطأ_ترميز_ذراع_أربعة_وستون
;

عام نوع نتيجة_دالة_ترميز_ذراع =
    | نجحت بنوع دالة_ذراع_أربعة_وستون_مشفرة
    | خطأ بنوع خطأ_ترميز_ذراع_أربعة_وستون
;

عرف حد_طبيعي_أقصى_ذراع(): طبيعي {
    دع الصفر: طبيعي = 0;
    أرجع ~الصفر;
}

عرف كلمة_ذراع(القيمة: طبيعي): كلمة_ذراع_أربعة_وستون_مشفرة {
    دع الناتج: كلمة_ذراع_أربعة_وستون_مشفرة = { القيمة: القيمة };
    أرجع الناتج;
}

عرف سجل_ذراع_قابل_للترميز(السجل: معرف_سجل_فعلي): منطقي {
    أرجع السجل.القيمة <= 30;
}

عرف سجل_مكدس_ذراع(): معرف_سجل_فعلي {
    دع السجل: معرف_سجل_فعلي = { القيمة: 31 };
    أرجع السجل;
}

عرف سجل_أساس_ذاكرة_ذراع_قابل_للترميز(السجل: معرف_سجل_فعلي): منطقي {
    // X0-X30 or SP(31) are valid as load/store bases; SP is never allocatable as a value register.
    أرجع السجل.القيمة <= 31;
}

عرف ألحق_كلمة_مشفرة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الكلمة: كلمة_ذراع_أربعة_وستون_مشفرة
): فراغ {
    ألحق(*الكلمات, الكلمة);
}

عرف ألحق_كلمة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    القيمة: طبيعي
): فراغ {
    ألحق_كلمة_مشفرة_ذراع(الكلمات, كلمة_ذراع(القيمة));
}

عرف عين_كلمة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الفهرس: طبيعي,
    الكلمة: كلمة_ذراع_أربعة_وستون_مشفرة
): فراغ {
    (*الكلمات)[الفهرس] := الكلمة;
}

عرف رمز_شرط_ذراع(الشرط: شرط_ذراع_أربعة_وستون): طبيعي {
    طابق الشرط مع
    | شرط_ذراع_أربعة_وستون.تكافؤ -> {
        أرجع 0;
    }
    | شرط_ذراع_أربعة_وستون.لاتكافؤ -> {
        أرجع 1;
    }
    | شرط_ذراع_أربعة_وستون.أقل_بإشارة -> {
        أرجع 11;
    }
    | شرط_ذراع_أربعة_وستون.أقل_أو_يساوي_بإشارة -> {
        أرجع 13;
    }
    | شرط_ذراع_أربعة_وستون.أكبر_بإشارة -> {
        أرجع 12;
    }
    | شرط_ذراع_أربعة_وستون.أكبر_أو_يساوي_بإشارة -> {
        أرجع 10;
    }
    | شرط_ذراع_أربعة_وستون.أدنى_طبيعي -> {
        أرجع 3;
    }
    | شرط_ذراع_أربعة_وستون.أدنى_أو_يساوي_طبيعي -> {
        أرجع 9;
    }
    | شرط_ذراع_أربعة_وستون.أعلى_طبيعي -> {
        أرجع 8;
    }
    | شرط_ذراع_أربعة_وستون.أعلى_أو_يساوي_طبيعي -> {
        أرجع 2;
    };
}

عرف رمز_شرط_معكوس_ذراع(الشرط: شرط_ذراع_أربعة_وستون): طبيعي {
    دع الرمز: طبيعي = رمز_شرط_ذراع(الشرط);
    لو ((الرمز % 2) == 0) {
        أرجع الرمز + 1;
    };
    أرجع الرمز - 1;
}

عرف سجل_فعلي_لمرجع_واجهة_ذراع(المرجع: &مرجع_سجل_واجهة): اختياري معرف_سجل_فعلي {
    دع ر: مرجع_سجل_واجهة = *المرجع;
    لو (ر.الفئة == فئة_سجل_واجهة.عدد_صحيح()) {
        دع السجل: معرف_سجل_فعلي = { القيمة: ر.الفهرس };
        أرجع اختياري.موجود(السجل);
    };
    لو (ر.الفئة == فئة_سجل_واجهة.نتيجة_غير_مباشرة()) {
        دع السجل: معرف_سجل_فعلي = { القيمة: 8 };
        أرجع اختياري.موجود(السجل);
    };
    أرجع اختياري.لا_شيء();
}

عرف سجل_واجهة_يطابق_ذراع(
    السجل: معرف_سجل_فعلي,
    المرجع: &مرجع_سجل_واجهة
): منطقي {
    طابق سجل_فعلي_لمرجع_واجهة_ذراع(المرجع) مع
    | اختياري.موجود(المتوقع) -> { أرجع السجل.القيمة == المتوقع.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف مواقع_ذراع_متساوية(
    الأول: &موقع_قيمة_ذراع_أربعة_وستون_مخصص,
    الثاني: &موقع_قيمة_ذراع_أربعة_وستون_مخصص
): منطقي {
    أرجع موقعا_قيمة_ذراع_متساويان(الأول, الثاني);
}

عرف ترميز_نقل_سجل_ذراع(
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي
): نتيجة_كلمة_ذراع {
    لو (!سجل_ذراع_قابل_للترميز(الوجهة)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(المصدر)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر)
        );
    };
    دع القيمة: طبيعي = 0xAA0003E0 + (المصدر.القيمة * 65536) + الوجهة.القيمة;
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
}

عرف ترميز_حساب_سجل_ذراع(
    الأساس: طبيعي,
    الوجهة: معرف_سجل_فعلي,
    الأول: معرف_سجل_فعلي,
    الثاني: معرف_سجل_فعلي
): نتيجة_كلمة_ذراع {
    لو (!سجل_ذراع_قابل_للترميز(الوجهة)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(الأول)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الأول)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(الثاني)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الثاني)
        );
    };
    دع القيمة: طبيعي = الأساس
        + (الثاني.القيمة * 65536)
        + (الأول.القيمة * 32)
        + الوجهة.القيمة;
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
}

عرف ترميز_جمع_سجل_مزاح_ذراع(
    الوجهة: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي,
    الفهرس: معرف_سجل_فعلي,
    الإزاحة: طبيعي
): نتيجة_كلمة_ذراع {
    لو (الإزاحة > 4) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.فوري_حساب_خارج_المدى(الإزاحة)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(الوجهة)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(الأساس)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الأساس)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(الفهرس)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الفهرس)
        );
    };
    // ADD Xd, Xn, Xm, LSL #shift.
    دع القيمة: طبيعي = 0x8B000000
        + (الفهرس.القيمة * 65536)
        + (الإزاحة * 1024)
        + (الأساس.القيمة * 32)
        + الوجهة.القيمة;
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
}

عرف ترميز_حساب_فوري_ذراع(
    الأساس: طبيعي,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    الفوري: طبيعي
): نتيجة_كلمة_ذراع {
    لو (الفوري > 4095) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.فوري_حساب_خارج_المدى(الفوري)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(الوجهة)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(المصدر)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر)
        );
    };
    دع القيمة: طبيعي = الأساس
        + (الفوري * 1024)
        + (المصدر.القيمة * 32)
        + الوجهة.القيمة;
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
}

عرف ألحق_مادي_فوري_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    السجل: معرف_سجل_فعلي,
    القيمة: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    لو (!سجل_ذراع_قابل_للترميز(السجل)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(السجل)
        );
    };
    دع الباقي: متغير طبيعي = القيمة;
    دع الجزء0: طبيعي = الباقي % 65536;
    الباقي := الباقي / 65536;
    دع الجزء1: طبيعي = الباقي % 65536;
    الباقي := الباقي / 65536;
    دع الجزء2: طبيعي = الباقي % 65536;
    الباقي := الباقي / 65536;
    دع الجزء3: طبيعي = الباقي % 65536;
    دع أول: طبيعي = 0xD2800000 + (الجزء0 * 32) + السجل.القيمة;
    دع ثان: طبيعي = 0xF2A00000 + (الجزء1 * 32) + السجل.القيمة;
    دع ثالث: طبيعي = 0xF2C00000 + (الجزء2 * 32) + السجل.القيمة;
    دع رابع: طبيعي = 0xF2E00000 + (الجزء3 * 32) + السجل.القيمة;
    ألحق_كلمة_ذراع(الكلمات, أول);
    ألحق_كلمة_ذراع(الكلمات, ثان);
    ألحق_كلمة_ذراع(الكلمات, ثالث);
    ألحق_كلمة_ذراع(الكلمات, رابع);
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف ألحق_نقل_بتات_عام_إلى_عائم_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    المصدر: معرف_سجل_فعلي,
    سجل_عائم: طبيعي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    لو (!سجل_ذراع_قابل_للترميز(المصدر)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر));
    };
    لو (سجل_عائم > 31) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(البتات));
    };
    دع الأساس: متغير طبيعي = 0;
    لو (البتات == 32) { الأساس := 0x1E270000; }
    وإلا لو (البتات == 64) { الأساس := 0x9E670000; }
    وإلا { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(البتات)); };
    ألحق_كلمة_ذراع(الكلمات, الأساس + (المصدر.القيمة * 32) + سجل_عائم);
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف ألحق_نقل_بتات_عائم_إلى_عام_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    سجل_عائم: طبيعي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    لو (!سجل_ذراع_قابل_للترميز(الوجهة)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة));
    };
    لو (سجل_عائم > 31) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(البتات));
    };
    دع الأساس: متغير طبيعي = 0;
    لو (البتات == 32) { الأساس := 0x1E260000; }
    وإلا لو (البتات == 64) { الأساس := 0x9E660000; }
    وإلا { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(البتات)); };
    ألحق_كلمة_ذراع(الكلمات, الأساس + (سجل_عائم * 32) + الوجهة.القيمة);
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

// The float primitives on d0 = a and d1 = b (a again for the unary ones);
// d2 and the destination register are scratch once a and b are read (v2 is
// caller-saved in AAPCS64). Each instruction writes d0, except copysign.
عرف ألحق_عملية_عائمة_خاصة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    العملية: حساب_عشري_ذراع_أربعة_وستون,
    الوجهة: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    // FP data-processing (1 source): 0x1E204000 | type << 22 | opcode << 15.
    دع نوع_العرض: متغير طبيعي = 0;
    لو (البتات == 64) { نوع_العرض := 0x00400000; };
    طابق العملية مع
    | حساب_عشري_ذراع_أربعة_وستون.جذر_تربيعي -> { ألحق_كلمة_ذراع(الكلمات, 0x1E21C000 + نوع_العرض); }
    | حساب_عشري_ذراع_أربعة_وستون.قيمة_مطلقة -> { ألحق_كلمة_ذراع(الكلمات, 0x1E20C000 + نوع_العرض); }
    | حساب_عشري_ذراع_أربعة_وستون.تقريب_زوجي -> { ألحق_كلمة_ذراع(الكلمات, 0x1E244000 + نوع_العرض); }
    | حساب_عشري_ذراع_أربعة_وستون.سقف -> { ألحق_كلمة_ذراع(الكلمات, 0x1E24C000 + نوع_العرض); }
    | حساب_عشري_ذراع_أربعة_وستون.أرضية -> { ألحق_كلمة_ذراع(الكلمات, 0x1E254000 + نوع_العرض); }
    | حساب_عشري_ذراع_أربعة_وستون.بتر -> { ألحق_كلمة_ذراع(الكلمات, 0x1E25C000 + نوع_العرض); }
    // FMIN / FMAX d0, d0, d1: NaN-propagating, -0 below +0 (IEEE minimum).
    | حساب_عشري_ذراع_أربعة_وستون.أدنى -> { ألحق_كلمة_ذراع(الكلمات, 0x1E205800 + نوع_العرض + 65536); }
    | حساب_عشري_ذراع_أربعة_وستون.أقصى -> { ألحق_كلمة_ذراع(الكلمات, 0x1E204800 + نوع_العرض + 65536); }
    | حساب_عشري_ذراع_أربعة_وستون.نسخ_إشارة -> {
        // d2 := sign bit (through the destination); BIT v0.8B, v1.8B, v2.8B
        // inserts b's sign into a.
        دع واحد: طبيعي = 1;
        دع بت_الإشارة: متغير طبيعي = واحد << 63;
        لو (البتات == 32) { بت_الإشارة := واحد << 31; };
        طابق ألحق_مادي_فوري_ذراع(الكلمات, الوجهة, بت_الإشارة) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, الوجهة, 2, 64) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_كلمة_ذراع(الكلمات, 0x2EA01C00 + (2 * 65536) + (1 * 32));
    }
    | _ -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(البتات)); };
    أرجع ألحق_نقل_بتات_عائم_إلى_عام_ذراع(الكلمات, الوجهة, 0, البتات);
}

// UBFM (LSR #k) or SBFM (ASR #k) Xd, Xn: 0xD340FC00 / 0x9340FC00 | k << 16.
عرف ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة, الوجهة: طبيعي, المصدر: طبيعي, المقدار: طبيعي, حسابية: منطقي): فراغ {
    دع الأساس: متغير طبيعي = 0xD340FC00;
    لو (حسابية) { الأساس := 0x9340FC00; };
    ألحق_كلمة_ذراع(الكلمات, الأساس + (المقدار * 65536) + (المصدر * 32) + الوجهة);
}

// A three-register data-processing word: base | Rm << 16 | Rn << 5 | Rd.
عرف ألحق_ثلاثية_خام_ذراع(الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة, الأساس: طبيعي, الوجهة: طبيعي, الأول: طبيعي, الثاني: طبيعي): فراغ {
    ألحق_كلمة_ذراع(الكلمات, الأساس + (الثاني * 65536) + (الأول * 32) + الوجهة);
}

// Division or remainder by a constant (backend/codegen/division_by_constant.sn)
// on 64-bit registers that hold the operand normalized to its type. X15..X17
// are the encoder's scratch; the destination is written last.
عرف ألحق_قسمة_على_ثابت_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    القاسم: طبيعي,
    البتات: طبيعي,
    موقع: منطقي,
    باقي: منطقي
): نتيجة_دفعة_ترميز_ذراع {
    دع س: طبيعي = المصدر.القيمة;
    دع ع15: معرف_سجل_فعلي = { القيمة: 15 };
    دع ع16: معرف_سجل_فعلي = { القيمة: 16 };
    // The quotient goes to X15.
    دع تم: متغير منطقي = خطأ;
    طابق أس_قوة_اثنين_قسمة_ثابت(القاسم) مع
    | اختياري.موجود(الأس) -> {
        لو (!موقع) {
            لو (باقي) {
                طابق ألحق_مادي_فوري_ذراع(الكلمات, ع16, القاسم - 1) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                ألحق_ثلاثية_خام_ذراع(الكلمات, 0x8A000000, الوجهة.القيمة, س, 16); // AND
                أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, الوجهة, الوجهة, البتات, موقع);
            };
            ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات, 15, س, الأس, خطأ);
            تم := صواب;
        };
    }
    | اختياري.لا_شيء -> { };
    لو (!تم) {
        دع سالب: منطقي = موقع && (القاسم >> 63) != 0;
        دع المطلق: متغير طبيعي = القاسم;
        لو (سالب) { المطلق := (~القاسم) + 1; };
        لو (موقع) {
            طابق أس_قوة_اثنين_قسمة_ثابت(المطلق) مع
            | اختياري.موجود(الأس) -> {
                ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات, 15, س, 63, صواب);
                ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات, 15, 15, 64 - الأس, خطأ);
                ألحق_ثلاثية_خام_ذراع(الكلمات, 0x8B000000, 15, 15, س); // ADD
                ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات, 15, 15, الأس, صواب);
                لو (سالب) { ألحق_ثلاثية_خام_ذراع(الكلمات, 0xCB000000, 15, 31, 15); }; // NEG
            }
            | اختياري.لا_شيء -> {
                دع الخطة: خطة_قسمة_موقعة_على_ثابت = خطة_قسمة_موقعة_على_ثابت_من(القاسم);
                طابق ألحق_مادي_فوري_ذراع(الكلمات, ع16, الخطة.المضاعف) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                ألحق_ثلاثية_خام_ذراع(الكلمات, 0x9B407C00, 16, س, 16); // SMULH
                دع مضاعف_سالب: منطقي = (الخطة.المضاعف >> 63) != 0;
                لو (!سالب && مضاعف_سالب) { ألحق_ثلاثية_خام_ذراع(الكلمات, 0x8B000000, 16, 16, س); };
                لو (سالب && !مضاعف_سالب) { ألحق_ثلاثية_خام_ذراع(الكلمات, 0xCB000000, 16, 16, س); };
                ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات, 16, 16, الخطة.الإزاحة, صواب);
                // ADD X15, X16, X16, LSR #63.
                ألحق_كلمة_ذراع(الكلمات, 0x8B400000 + (16 * 65536) + (63 * 1024) + (16 * 32) + 15);
            };
        } وإلا {
            دع الخطة: خطة_قسمة_طبيعية_على_ثابت = خطة_قسمة_طبيعية_على_ثابت_من(القاسم);
            دع المقسوم: متغير طبيعي = س;
            لو (الخطة.إزاحة_قبلية > 0) {
                ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات, 15, س, الخطة.إزاحة_قبلية, خطأ);
                المقسوم := 15;
            };
            طابق ألحق_مادي_فوري_ذراع(الكلمات, ع16, الخطة.المضاعف) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            ألحق_ثلاثية_خام_ذراع(الكلمات, 0x9BC07C00, 16, المقسوم, 16); // UMULH
            لو (الخطة.جمع) {
                ألحق_ثلاثية_خام_ذراع(الكلمات, 0xCB000000, 15, س, 16); // SUB
                ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات, 15, 15, 1, خطأ);
                ألحق_ثلاثية_خام_ذراع(الكلمات, 0x8B000000, 15, 15, 16); // ADD
                ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات, 15, 15, الخطة.إزاحة_بعدية, خطأ);
            } وإلا {
                ألحق_إزاحة_يمنى_فورية_ذراع(الكلمات, 15, 16, الخطة.إزاحة_بعدية, خطأ);
            };
        };
    };
    لو (باقي) {
        // MSUB Xd, X15, X16, Xs: x - q * d.
        طابق ألحق_مادي_فوري_ذراع(الكلمات, ع16, القاسم) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_كلمة_ذراع(الكلمات, 0x9B008000 + (16 * 65536) + (س * 1024) + (15 * 32) + الوجهة.القيمة);
    } وإلا {
        // MOV Xd, X15 (ORR Xd, XZR, X15).
        ألحق_كلمة_ذراع(الكلمات, 0xAA000000 + (15 * 65536) + (31 * 32) + الوجهة.القيمة);
    };
    أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, الوجهة, الوجهة, البتات, موقع);
}

// FMADD d0, d0, d1, d2: a * b + c with one rounding.
عرف ألحق_ضرب_جمع_مدمج_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    ج: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, أ, 0, البتات) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, ب, 1, البتات) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, ج, 2, البتات) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    دع الأساس: متغير طبيعي = 0x1F000000;
    لو (البتات == 64) { الأساس := 0x1F400000; };
    ألحق_كلمة_ذراع(الكلمات, الأساس + 65536 + (2 * 1024));
    أرجع ألحق_نقل_بتات_عائم_إلى_عام_ذراع(الكلمات, الوجهة, 0, البتات);
}

عرف ألحق_حساب_عشري_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    العملية: حساب_عشري_ذراع_أربعة_وستون,
    الوجهة: معرف_سجل_فعلي,
    اليسار: معرف_سجل_فعلي,
    اليمين: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, اليسار, 0, البتات) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, اليمين, 1, البتات) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    دع الأساس_عرض: متغير طبيعي = 0;
    لو (البتات == 32) { الأساس_عرض := 0x1E200000; }
    وإلا لو (البتات == 64) { الأساس_عرض := 0x1E600000; }
    وإلا { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(البتات)); };
    دع قالب: متغير طبيعي = 0;
    طابق العملية مع
    | حساب_عشري_ذراع_أربعة_وستون.جمع -> { قالب := 0x00002800; }
    | حساب_عشري_ذراع_أربعة_وستون.طرح -> { قالب := 0x00003800; }
    | حساب_عشري_ذراع_أربعة_وستون.ضرب -> { قالب := 0x00000800; }
    | حساب_عشري_ذراع_أربعة_وستون.قسمة -> { قالب := 0x00001800; }
    | _ -> { أرجع ألحق_عملية_عائمة_خاصة_ذراع(الكلمات, العملية, الوجهة, البتات); };
    ألحق_كلمة_ذراع(الكلمات, الأساس_عرض + قالب + 65536);
    أرجع ألحق_نقل_بتات_عائم_إلى_عام_ذراع(الكلمات, الوجهة, 0, البتات);
}

// Float conversions (docs/TYPE_SYSTEM.md, "Numeric casts"). FCVTZS/FCVTZU
// already saturate and give 0 for NaN at 32 and 64 bits, which is Rust's
// `as`; 8- and 16-bit results are first clamped in the float domain with
// FMIN/FMAX (which keep a NaN a NaN). d0 and d1 are scratch; so is the
// destination, after the source has been read.

// The float bits of a small non-negative integer (|v| < 2^24, exact).
عرف بتات_عدد_صغير_عائم_ذراع(القيمة: طبيعي, سالب: منطقي, البتات: طبيعي): طبيعي {
    لو (القيمة == 0) { أرجع 0; };
    دع الأس: متغير طبيعي = 0;
    طالما ((القيمة >> (الأس + 1)) != 0) { الأس := الأس + 1; }
    دع الكسر: طبيعي = القيمة - ((1 مثل طبيعي) << الأس);
    دع واحد: طبيعي = 1;
    لو (البتات == 32) {
        دع الناتج: طبيعي = ((127 + الأس) << 23) | (الكسر << (23 - الأس));
        لو (سالب) { أرجع الناتج | (واحد << 31); };
        أرجع الناتج;
    };
    دع الناتج: طبيعي = ((1023 + الأس) << 52) | (الكسر << (52 - الأس));
    لو (سالب) { أرجع الناتج | (واحد << 63); };
    أرجع الناتج;
}

// d0 := min(d0, c) (FMIN) or max(d0, c) (FMAX), c loaded through الوجهة.
عرف ألحق_قيد_عائم_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    البتات_الخام: طبيعي,
    بتات_العائم: طبيعي,
    الأعلى: منطقي
): نتيجة_دفعة_ترميز_ذراع {
    طابق ألحق_مادي_فوري_ذراع(الكلمات, الوجهة, البتات_الخام) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, الوجهة, 1, بتات_العائم) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    دع الأساس: متغير طبيعي = 0x1E205800; // FMIN s0, s0, s1
    لو (!الأعلى) { الأساس := 0x1E204800; }; // FMAX
    لو (بتات_العائم == 64) { الأساس := الأساس + 0x00400000; };
    ألحق_كلمة_ذراع(الكلمات, الأساس + 65536);
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف ألحق_تحويل_عائم_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    العملية: تحويل_عائم_ذراع_أربعة_وستون,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    من_بتات: طبيعي,
    إلى_بتات: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    لو (!سجل_ذراع_قابل_للترميز(الوجهة) || !سجل_ذراع_قابل_للترميز(المصدر)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة));
    };
    دع نوع_عائم: متغير طبيعي = 0;
    دع موقع: متغير منطقي = خطأ;
    طابق العملية مع
    | تحويل_عائم_ذراع_أربعة_وستون.عائم_إلى_موقع -> { موقع := صواب; }
    | تحويل_عائم_ذراع_أربعة_وستون.موقع_إلى_عائم -> { موقع := صواب; }
    | _ -> { };
    طابق العملية مع
    | تحويل_عائم_ذراع_أربعة_وستون.عائم_إلى_عائم -> {
        طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, المصدر, 0, من_بتات) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        لو (من_بتات == 32 && إلى_بتات == 64) { ألحق_كلمة_ذراع(الكلمات, 0x1E22C000); }; // FCVT d0, s0
        لو (من_بتات == 64 && إلى_بتات == 32) { ألحق_كلمة_ذراع(الكلمات, 0x1E624000); }; // FCVT s0, d0
        أرجع ألحق_نقل_بتات_عائم_إلى_عام_ذراع(الكلمات, الوجهة, 0, إلى_بتات);
    }
    | تحويل_عائم_ذراع_أربعة_وستون.موقع_إلى_عائم -> { }
    | تحويل_عائم_ذراع_أربعة_وستون.طبيعي_إلى_عائم -> { }
    | _ -> {
        // float -> integer
        طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, المصدر, 0, من_بتات) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        لو (إلى_بتات < 32) {
            دع الأقصى: متغير طبيعي = ((1 مثل طبيعي) << إلى_بتات) - 1;
            لو (موقع) { الأقصى := ((1 مثل طبيعي) << (إلى_بتات - 1)) - 1; };
            طابق ألحق_قيد_عائم_ذراع(الكلمات, الوجهة, بتات_عدد_صغير_عائم_ذراع(الأقصى, خطأ, من_بتات), من_بتات, صواب) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            لو (موقع) {
                طابق ألحق_قيد_عائم_ذراع(الكلمات, الوجهة, بتات_عدد_صغير_عائم_ذراع(الأقصى + 1, صواب, من_بتات), من_بتات, خطأ) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            };
        };
        دع الأساس: متغير طبيعي = 0x1E380000; // FCVTZS Wd, Sn
        لو (!موقع) { الأساس := الأساس + 0x00010000; }; // FCVTZU
        لو (من_بتات == 64) { الأساس := الأساس + 0x00400000; };
        لو (إلى_بتات == 64) { الأساس := الأساس + 0x80000000; };
        ألحق_كلمة_ذراع(الكلمات, الأساس + الوجهة.القيمة);
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, الوجهة, الوجهة, إلى_بتات, موقع);
    };
    // integer -> float: the canonical 64-bit form of the integer, then
    // SCVTF/UCVTF Xn (round to nearest, ties to even: FPCR default).
    طابق ألحق_تطبيع_عدد_ذراع(الكلمات, الوجهة, المصدر, من_بتات, موقع) مع | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); } | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    دع الأساس: متغير طبيعي = 0x9E220000; // SCVTF Sd, Xn
    لو (!موقع) { الأساس := الأساس + 0x00010000; }; // UCVTF
    لو (إلى_بتات == 64) { الأساس := الأساس + 0x00400000; };
    ألحق_كلمة_ذراع(الكلمات, الأساس + (الوجهة.القيمة * 32));
    أرجع ألحق_نقل_بتات_عائم_إلى_عام_ذراع(الكلمات, الوجهة, 0, إلى_بتات);
}

عرف رمز_شرط_مقارنة_عشرية_ذراع(العملية: مقارنة_عشرية_ذراع_أربعة_وستون): طبيعي {
    طابق العملية مع
    | مقارنة_عشرية_ذراع_أربعة_وستون.يساوي -> { أرجع 0; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.لا_يساوي -> { أرجع 1; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.أصغر -> { أرجع 4; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.أصغر_أو_يساوي -> { أرجع 9; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.أكبر -> { أرجع 12; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.أكبر_أو_يساوي -> { أرجع 10; };
}

عرف ألحق_مقارنة_عشرية_إلى_منطق_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    العملية: مقارنة_عشرية_ذراع_أربعة_وستون,
    الوجهة: معرف_سجل_فعلي,
    اليسار: معرف_سجل_فعلي,
    اليمين: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, اليسار, 0, البتات) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نقل_بتات_عام_إلى_عائم_ذراع(الكلمات, اليمين, 1, البتات) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    دع أساس_المقارنة: متغير طبيعي = 0;
    لو (البتات == 32) { أساس_المقارنة := 0x1E202000; }
    وإلا لو (البتات == 64) { أساس_المقارنة := 0x1E602000; }
    وإلا { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(البتات)); };
    ألحق_كلمة_ذراع(الكلمات, أساس_المقارنة + 65536);
    لو (!سجل_ذراع_قابل_للترميز(الوجهة)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة));
    };
    دع الشرط: طبيعي = رمز_شرط_مقارنة_عشرية_ذراع(العملية);
    دع المعكوس: طبيعي = الشرط ^ 1;
    ألحق_كلمة_ذراع(الكلمات, 0x9A9F07E0 + (المعكوس * 4096) + الوجهة.القيمة);
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف ترميز_مقارنة_سجل_ذراع(
    الأول: معرف_سجل_فعلي,
    الثاني: معرف_سجل_فعلي
): نتيجة_كلمة_ذراع {
    لو (!سجل_ذراع_قابل_للترميز(الأول)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الأول)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(الثاني)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الثاني)
        );
    };
    دع القيمة: طبيعي = 0xEB00001F
        + (الثاني.القيمة * 65536)
        + (الأول.القيمة * 32);
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
}

عرف ترميز_مقارنة_فوري_ذراع(
    السجل: معرف_سجل_فعلي,
    الفوري: طبيعي
): نتيجة_كلمة_ذراع {
    لو (الفوري > 4095) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.فوري_حساب_خارج_المدى(الفوري)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(السجل)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(السجل)
        );
    };
    دع القيمة: طبيعي = 0xF100001F + (الفوري * 1024) + (السجل.القيمة * 32);
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
}

عرف ترميز_ثبت_شرط_ذراع(
    السجل: معرف_سجل_فعلي,
    الشرط: شرط_ذراع_أربعة_وستون
): نتيجة_كلمة_ذراع {
    لو (!سجل_ذراع_قابل_للترميز(السجل)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(السجل)
        );
    };
    دع المعكوس: طبيعي = رمز_شرط_معكوس_ذراع(الشرط);
    دع القيمة: طبيعي = 0x9A9F07E0 + (المعكوس * 4096) + السجل.القيمة;
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
}

عرف ترميز_ذاكرة_ذراع(
    تحميل: منطقي,
    السجل: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي,
    الإزاحة: عدد,
    الحجم: طبيعي,
    بإشارة: منطقي
): نتيجة_كلمة_ذراع {
    لو (!سجل_ذراع_قابل_للترميز(السجل)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(السجل)
        );
    };
    لو (!سجل_أساس_ذاكرة_ذراع_قابل_للترميز(الأساس)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(الأساس)
        );
    };
    لو (!(الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم)
        );
    };

    دع قاعدة_مقيسة: متغير طبيعي = 0;
    دع قاعدة_غير_مقيسة: متغير طبيعي = 0;
    لو (الحجم == 1) {
        لو (تحميل) {
            لو (بإشارة) { قاعدة_مقيسة := 0x39800000; قاعدة_غير_مقيسة := 0x38800000; }
            وإلا { قاعدة_مقيسة := 0x39400000; قاعدة_غير_مقيسة := 0x38400000; };
        } وإلا {
            قاعدة_مقيسة := 0x39000000; قاعدة_غير_مقيسة := 0x38000000;
        };
    } وإلا لو (الحجم == 2) {
        لو (تحميل) {
            لو (بإشارة) { قاعدة_مقيسة := 0x79800000; قاعدة_غير_مقيسة := 0x78800000; }
            وإلا { قاعدة_مقيسة := 0x79400000; قاعدة_غير_مقيسة := 0x78400000; };
        } وإلا {
            قاعدة_مقيسة := 0x79000000; قاعدة_غير_مقيسة := 0x78000000;
        };
    } وإلا لو (الحجم == 4) {
        لو (تحميل) {
            لو (بإشارة) { قاعدة_مقيسة := 0xB9800000; قاعدة_غير_مقيسة := 0xB8800000; }
            وإلا { قاعدة_مقيسة := 0xB9400000; قاعدة_غير_مقيسة := 0xB8400000; };
        } وإلا {
            قاعدة_مقيسة := 0xB9000000; قاعدة_غير_مقيسة := 0xB8000000;
        };
    } وإلا {
        // 64-bit loads/stores already carry the complete scalar value; sign extension is irrelevant.
        لو (تحميل) { قاعدة_مقيسة := 0xF9400000; قاعدة_غير_مقيسة := 0xF8400000; }
        وإلا { قاعدة_مقيسة := 0xF9000000; قاعدة_غير_مقيسة := 0xF8000000; };
    };

    لو ((الإزاحة >= 0) && ((الإزاحة % (الحجم مثل عدد)) == 0)) {
        دع قيمة_المضروب: عدد = الإزاحة / (الحجم مثل عدد);
        لو (قيمة_المضروب <= 4095) {
            دع المضروب: طبيعي = قيمة_المضروب مثل طبيعي;
            دع القيمة: طبيعي = قاعدة_مقيسة
                + (المضروب * 1024)
                + (الأساس.القيمة * 32)
                + السجل.القيمة;
            أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
        };
    };
    لو ((الإزاحة >= -256) && (الإزاحة <= 255)) {
        دع الحقل: متغير طبيعي = الإزاحة مثل طبيعي;
        لو (الإزاحة < 0) {
            دع قيمة_الحقل: عدد = 512 + الإزاحة;
            الحقل := قيمة_الحقل مثل طبيعي;
        };
        دع القيمة: طبيعي = قاعدة_غير_مقيسة
            + (الحقل * 4096)
            + (الأساس.القيمة * 32)
            + السجل.القيمة;
        أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
    };
    أرجع نتيجة_كلمة_ذراع.خطأ(
        خطأ_ترميز_ذراع_أربعة_وستون.إزاحة_ذاكرة_خارج_المدى(الإزاحة)
    );
}

عرف عرض_عدد_ذراع_صالح(البتات: طبيعي): منطقي {
    أرجع البتات == 8 || البتات == 16 || البتات == 32 || البتات == 64;
}

عرف كلمة_ثلاثية_سجلات_ذراع(
    الأساس: طبيعي,
    الوجهة: معرف_سجل_فعلي,
    الأول: معرف_سجل_فعلي,
    الثاني: معرف_سجل_فعلي
): نتيجة_كلمة_ذراع {
    أرجع ترميز_حساب_سجل_ذراع(الأساس, الوجهة, الأول, الثاني);
}

عرف ألحق_فرع_شرط_قصير_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    رمز_الشرط: طبيعي,
    عدد_الكلمات_للتخطي: طبيعي
): فراغ {
    // B.cond يحسب الإزاحة من موضع التعليمة نفسها؛ الهدف بعد عدد_الكلمات_للتخطي كلمات.
    دع الفوري: طبيعي = عدد_الكلمات_للتخطي;
    ألحق_كلمة_ذراع(الكلمات, 0x54000000 + (الفوري * 32) + رمز_الشرط);
}

// movz w17, #lo16; movk w17, #hi16, lsl #16 (when hi16 != 0): a 32-bit
// constant in the reserved scratch W17.
عرف ألحق_ثابت_ط32_في_و17_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    القيمة: طبيعي
): فراغ {
    دع المنخفض: طبيعي = القيمة % 65536;
    دع المرتفع: طبيعي = (القيمة / 65536) % 65536;
    ألحق_كلمة_ذراع(الكلمات, 0x52800011 + (المنخفض * 32));
    لو (المرتفع != 0) {
        ألحق_كلمة_ذراع(الكلمات, 0x72A00011 + (المرتفع * 32));
    };
}

عرف ألحق_فخ_ذراع(الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة): فراغ {
    ألحق_كلمة_ذراع(الكلمات, 0xD4200000);
}

عرف ألحق_تطبيع_عدد_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    البتات: طبيعي,
    موقع: منطقي
): نتيجة_دفعة_ترميز_ذراع {
    لو (!عرض_عدد_ذراع_صالح(البتات)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(البتات));
    };
    لو (البتات == 64) {
        لو (!معرفا_سجل_فعلي_متساويان(الوجهة, المصدر)) {
            أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(الوجهة, المصدر));
        };
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    };
    دع الأساس: متغير طبيعي = 0xD3400000;
    لو (موقع) { الأساس := 0x93400000; };
    دع القيمة: طبيعي = الأساس + ((البتات - 1) * 1024) + (المصدر.القيمة * 32) + الوجهة.القيمة;
    ألحق_كلمة_ذراع(الكلمات, القيمة);
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف ألحق_تحقق_نطاق_نتيجة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    السجل: معرف_سجل_فعلي,
    البتات: طبيعي,
    موقع: منطقي
): نتيجة_دفعة_ترميز_ذراع {
    لو (البتات == 64) { أرجع نتيجة_دفعة_ترميز_ذراع.نجحت(); };
    دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
    طابق ألحق_تطبيع_عدد_ذراع(الكلمات, العمل, السجل, البتات, موقع) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_سجل_ذراع(السجل, العمل)) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    ألحق_فرع_شرط_قصير_ذراع(الكلمات, 0, 2); // EQ -> تجاوز BRK
    ألحق_فخ_ذراع(الكلمات);
    أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, السجل, العمل, البتات, موقع);
}

عرف ألحق_تحقق_قسمة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    اليسار: معرف_سجل_فعلي,
    اليمين: معرف_سجل_فعلي,
    الوصف: &وصف_عدد_ذراع_أربعة_وستون
): نتيجة_دفعة_ترميز_ذراع {
    دع و: وصف_عدد_ذراع_أربعة_وستون = *الوصف;
    طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_فوري_ذراع(اليمين, 0)) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    ألحق_فرع_شرط_قصير_ذراع(الكلمات, 1, 2); // NE
    ألحق_فخ_ذراع(الكلمات);
    لو (!و.موقع) { أرجع نتيجة_دفعة_ترميز_ذراع.نجحت(); };
    دع سالب_واحد: معرف_سجل_فعلي = { القيمة: 15 };
    دع الأدنى: معرف_سجل_فعلي = { القيمة: 16 };
    طابق ألحق_مادي_فوري_ذراع(الكلمات, سالب_واحد, حد_طبيعي_أقصى_ذراع()) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_سجل_ذراع(اليمين, سالب_واحد)) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    // ابن جسم تحقق MIN/-1 أولا، لأن مادي الفوري قد يكون عددا متغيرا من الكلمات.
    // فرع B.NE يتجاوز الجسم بالحجم الفعلي بدلا من افتراض أربع تعليمات للمادي.
    دع تحقق_الأدنى: متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة = [];
    دع الواحد: طبيعي = 1;
    دع نصف_مدى: طبيعي = الواحد << (و.البتات - 1);
    دع قيمة_الأدنى: متغير طبيعي = نصف_مدى;
    لو (و.البتات < 64) { قيمة_الأدنى := حد_طبيعي_أقصى_ذراع() - (نصف_مدى - 1); };
    طابق ألحق_مادي_فوري_ذراع(&متغير تحقق_الأدنى, الأدنى, قيمة_الأدنى) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    طابق ألحق_نتيجة_كلمة(
        &متغير تحقق_الأدنى, ترميز_مقارنة_سجل_ذراع(اليسار, الأدنى)
    ) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    ألحق_فرع_شرط_قصير_ذراع(&متغير تحقق_الأدنى, 1, 2);
    ألحق_فخ_ذراع(&متغير تحقق_الأدنى);
    دع طول_تحقق_الأدنى: طبيعي = الطول(تحقق_الأدنى) مثل طبيعي;
    ألحق_فرع_شرط_قصير_ذراع(
        الكلمات, 1, طول_تحقق_الأدنى + 1
    );
    دع فحص: متغير طبيعي = 0;
    طالما (فحص < (الطول(تحقق_الأدنى) مثل طبيعي)) {
        دع كلمة_فحص: كلمة_ذراع_أربعة_وستون_مشفرة = تحقق_الأدنى[فحص];

        ألحق_كلمة_مشفرة_ذراع(الكلمات, كلمة_فحص);

        فحص := فحص + 1;
    }
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف ألحق_حساب_صحيح_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الحساب: &حساب_صحيح_ذراع_أربعة_وستون_مخصص
): نتيجة_دفعة_ترميز_ذراع {
    دع ح: حساب_صحيح_ذراع_أربعة_وستون_مخصص = *الحساب;
    لو (!عرض_عدد_ذراع_صالح(ح.الوصف.البتات)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(ح.الوصف.البتات));
    };
    طابق ح.العملية مع
    | عملية_حساب_ذراع_أربعة_وستون.جمع -> {
        دع الأساس: طبيعي = 0xAB000000; // ADDS
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(الأساس, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        لو (ح.الوصف.البتات == 64) {
            لو (ح.الوصف.موقع) { ألحق_فرع_شرط_قصير_ذراع(الكلمات, 7, 2); } // VC
            وإلا { ألحق_فرع_شرط_قصير_ذراع(الكلمات, 3, 2); }; // CC
            ألحق_فخ_ذراع(الكلمات);
            أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
        };
        أرجع ألحق_تحقق_نطاق_نتيجة_ذراع(الكلمات, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.طرح -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0xEB000000, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        لو (ح.الوصف.البتات == 64) {
            لو (ح.الوصف.موقع) { ألحق_فرع_شرط_قصير_ذراع(الكلمات, 7, 2); } // VC
            وإلا { ألحق_فرع_شرط_قصير_ذراع(الكلمات, 2, 2); }; // CS no borrow
            ألحق_فخ_ذراع(الكلمات);
            أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
        };
        أرجع ألحق_تحقق_نطاق_نتيجة_ذراع(الكلمات, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.ضرب -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9B007C00, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        لو (ح.الوصف.البتات != 64) {
            أرجع ألحق_تحقق_نطاق_نتيجة_ذراع(الكلمات, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
        };
        دع ع15: معرف_سجل_فعلي = { القيمة: 15 };
        لو (ح.الوصف.موقع) {
            دع ع16: معرف_سجل_فعلي = { القيمة: 16 };
            طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9B407C00, ع15, ح.اليسار, ح.اليمين)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            دع أساس_إزاحة_حسابية: طبيعي = 0x93400000;
            دع ثلاثة_وستون: طبيعي = 63;
            دع معامل_ستة_عشر: طبيعي = 65536;
            دع معامل_عشرة: طبيعي = 1024;
            دع معامل_السجل: طبيعي = 32;
            دع حقل_إم_إس_بي: طبيعي = ثلاثة_وستون * معامل_ستة_عشر;
            دع حقل_إل_إس_بي: طبيعي = ثلاثة_وستون * معامل_عشرة;
            دع حقل_الوجهة: طبيعي = ح.الوجهة.القيمة * معامل_السجل;
            دع إزاحة_حسابية_ثلاثة_وستون: طبيعي =
                أساس_إزاحة_حسابية + حقل_إم_إس_بي + حقل_إل_إس_بي + حقل_الوجهة + ع16.القيمة;
            ألحق_كلمة_ذراع(الكلمات, إزاحة_حسابية_ثلاثة_وستون);
            طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_سجل_ذراع(ع15, ع16)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        } وإلا {
            طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9BC07C00, ع15, ح.اليسار, ح.اليمين)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_فوري_ذراع(ع15, 0)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        };
        ألحق_فرع_شرط_قصير_ذراع(الكلمات, 0, 2);
        ألحق_فخ_ذراع(الكلمات);
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    }
    | عملية_حساب_ذراع_أربعة_وستون.قسمة -> {
        طابق ألحق_تحقق_قسمة_ذراع(الكلمات, ح.اليسار, ح.اليمين, &ح.الوصف) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        دع الأساس: متغير طبيعي = 0x9AC00800;
        لو (ح.الوصف.موقع) { الأساس := 0x9AC00C00; };
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(الأساس, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.باقي -> {
        طابق ألحق_تحقق_قسمة_ذراع(الكلمات, ح.اليسار, ح.اليمين, &ح.الوصف) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        دع ع15: معرف_سجل_فعلي = { القيمة: 15 };
        دع أساس_قسمة: متغير طبيعي = 0x9AC00800;
        لو (ح.الوصف.موقع) { أساس_قسمة := 0x9AC00C00; };
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(أساس_قسمة, ع15, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        دع أساس_ضرب_ثم_طرح: طبيعي = 0x9B008000;
        دع معامل_ستة_عشر: طبيعي = 65536;
        دع معامل_عشرة: طبيعي = 1024;
        دع معامل_السجل: طبيعي = 32;
        دع حقل_اليمين: طبيعي = ح.اليمين.القيمة * معامل_ستة_عشر;
        دع حقل_اليسار: طبيعي = ح.اليسار.القيمة * معامل_عشرة;
        دع حقل_العمل: طبيعي = ع15.القيمة * معامل_السجل;
        دع ضرب_ثم_طرح: طبيعي =
            أساس_ضرب_ثم_طرح + حقل_اليمين + حقل_اليسار + حقل_العمل + ح.الوجهة.القيمة;
        ألحق_كلمة_ذراع(الكلمات, ضرب_ثم_طرح);
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.جمع_ملتف -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x8B000000, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.طرح_ملتف -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0xCB000000, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.ضرب_ملتف -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9B007C00, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.إزاحة_يسرى_ملتفة -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9AC02000, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.و_بتي -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x8A000000, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.أو_بتي -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0xAA000000, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.أو_حصري -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0xCA000000, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع);
    }
    | عملية_حساب_ذراع_أربعة_وستون.إزاحة_يسرى -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_فوري_ذراع(ح.اليمين, ح.الوصف.البتات)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_فرع_شرط_قصير_ذراع(الكلمات, 3, 2); // LO
        ألحق_فخ_ذراع(الكلمات);
        لو (ح.الوصف.البتات == 64) {
            // احتفظ بالأصل لأن allocator قد يربط الوجهة بالمصدر عند انتهاء حياته هنا.
            دع الأصل: معرف_سجل_فعلي = { القيمة: 15 };
            دع المعكوس: معرف_سجل_فعلي = { القيمة: 16 };
            طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(الأصل, ح.اليسار)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9AC02000, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            دع أساس_العكس: متغير طبيعي = 0x9AC02400; // LSRV
            لو (ح.الوصف.موقع) { أساس_العكس := 0x9AC02800; }; // ASRV
            طابق ألحق_نتيجة_كلمة(
                الكلمات, كلمة_ثلاثية_سجلات_ذراع(أساس_العكس, المعكوس, ح.الوجهة, ح.اليمين)
            ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_سجل_ذراع(المعكوس, الأصل)) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            ألحق_فرع_شرط_قصير_ذراع(الكلمات, 0, 2); // EQ
            ألحق_فخ_ذراع(الكلمات);
            أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
        };
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9AC02000, ح.الوجهة, ح.اليسار, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تحقق_نطاق_نتيجة_ذراع(
            الكلمات, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع
        );
    }
    | عملية_حساب_ذراع_أربعة_وستون.إزاحة_يمنى_منطقية -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_فوري_ذراع(ح.اليمين, ح.الوصف.البتات)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_فرع_شرط_قصير_ذراع(الكلمات, 3, 2); ألحق_فخ_ذراع(الكلمات);
        دع مصدر_الإزاحة: متغير معرف_سجل_فعلي = ح.اليسار;
        لو (ح.الوصف.البتات < 64) {
            // دلالة MSIR منطقية داخل عرض النوع نفسه. القيمة الموقعة الضيقة تكون
            // موسعة بإشارة في حامل X، لذلك يجب إزالة البتات العليا قبل LSRV.
            دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
            طابق ألحق_تطبيع_عدد_ذراع(الكلمات, العمل, ح.اليسار, ح.الوصف.البتات, خطأ) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            مصدر_الإزاحة := العمل;
        };
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9AC02400, ح.الوجهة, مصدر_الإزاحة, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        // البتات الناتجة تُفسر حسب نوع MSIR، لا حسب نوع الإزاحة نفسها.
        أرجع ألحق_تطبيع_عدد_ذراع(
            الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع
        );
    }
    | عملية_حساب_ذراع_أربعة_وستون.إزاحة_يمنى_حسابية -> {
        طابق ألحق_نتيجة_كلمة(الكلمات, ترميز_مقارنة_فوري_ذراع(ح.اليمين, ح.الوصف.البتات)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        ألحق_فرع_شرط_قصير_ذراع(الكلمات, 3, 2); ألحق_فخ_ذراع(الكلمات);
        دع مصدر_الإزاحة: متغير معرف_سجل_فعلي = ح.اليسار;
        لو (ح.الوصف.البتات < 64) {
            // ASR في MSIR ينظر إلى بت إشارة عرض النوع حتى عندما يكون النوع غير موقع.
            // لذلك وسّع ذلك البت محليا قبل ASRV بدلا من الاعتماد على تمثيل الحامل X.
            دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
            طابق ألحق_تطبيع_عدد_ذراع(الكلمات, العمل, ح.اليسار, ح.الوصف.البتات, صواب) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            مصدر_الإزاحة := العمل;
        };
        طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9AC02800, ح.الوجهة, مصدر_الإزاحة, ح.اليمين)) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(
            الكلمات, ح.الوجهة, ح.الوجهة, ح.الوصف.البتات, ح.الوصف.موقع
        );
    };
}

عرف ألحق_تحويل_صحيح_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    التحويل: &تحويل_صحيح_ذراع_أربعة_وستون_مخصص
): نتيجة_دفعة_ترميز_ذراع {
    دع ت: تحويل_صحيح_ذراع_أربعة_وستون_مخصص = *التحويل;
    لو (!عرض_عدد_ذراع_صالح(ت.بتات_المصدر) || !عرض_عدد_ذراع_صالح(ت.بتات_الوجهة)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(ت.بتات_الوجهة));
    };
    طابق ت.العملية مع
    | عملية_تحويل_ذراع_أربعة_وستون.توسيع_بإشارة -> {
        طابق ألحق_تطبيع_عدد_ذراع(الكلمات, ت.الوجهة, ت.المصدر, ت.بتات_المصدر, صواب) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        // توسيع العرض يحفظ البتات أولا، ثم نوع الوجهة يملك تفسيرها المقنن.
        أرجع ألحق_تطبيع_عدد_ذراع(
            الكلمات, ت.الوجهة, ت.الوجهة, ت.بتات_الوجهة, ت.الوجهة_موقع
        );
    }
    | عملية_تحويل_ذراع_أربعة_وستون.توسيع_صفري -> {
        طابق ألحق_تطبيع_عدد_ذراع(الكلمات, ت.الوجهة, ت.المصدر, ت.بتات_المصدر, خطأ) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        أرجع ألحق_تطبيع_عدد_ذراع(
            الكلمات, ت.الوجهة, ت.الوجهة, ت.بتات_الوجهة, ت.الوجهة_موقع
        );
    }
    | عملية_تحويل_ذراع_أربعة_وستون.اقتطاع -> {
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ت.الوجهة, ت.المصدر, ت.بتات_الوجهة, ت.الوجهة_موقع);
    }
    | عملية_تحويل_ذراع_أربعة_وستون.إعادة_تفسير -> {
        أرجع ألحق_تطبيع_عدد_ذراع(الكلمات, ت.الوجهة, ت.المصدر, ت.بتات_الوجهة, ت.الوجهة_موقع);
    };
}

عرف ألحق_عنوان_إزاحة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي,
    الإزاحة: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    لو (الإزاحة <= 4095) {
        أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_حساب_فوري_ذراع(0x91000000, الوجهة, الأساس, الإزاحة));
    };
    دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
    طابق ألحق_مادي_فوري_ذراع(الكلمات, العمل, الإزاحة) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_حساب_سجل_ذراع(0x8B000000, الوجهة, الأساس, العمل));
}

عرف ألحق_عنوان_عنصر_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي,
    الفهرس: معرف_سجل_فعلي,
    الحجم: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    لو (الحجم == 1) { أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_جمع_سجل_مزاح_ذراع(الوجهة, الأساس, الفهرس, 0)); };
    لو (الحجم == 2) { أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_جمع_سجل_مزاح_ذراع(الوجهة, الأساس, الفهرس, 1)); };
    لو (الحجم == 4) { أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_جمع_سجل_مزاح_ذراع(الوجهة, الأساس, الفهرس, 2)); };
    لو (الحجم == 8) { أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_جمع_سجل_مزاح_ذراع(الوجهة, الأساس, الفهرس, 3)); };
    لو (الحجم == 16) { أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_جمع_سجل_مزاح_ذراع(الوجهة, الأساس, الفهرس, 4)); };
    دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
    طابق ألحق_مادي_فوري_ذراع(الكلمات, العمل, الحجم) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    // MUL X15, index, X15 ثم ADD destination, base, X15.
    طابق ألحق_نتيجة_كلمة(الكلمات, كلمة_ثلاثية_سجلات_ذراع(0x9B007C00, العمل, الفهرس, العمل)) مع
    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
    أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_حساب_سجل_ذراع(0x8B000000, الوجهة, الأساس, العمل));
}

عرف ألحق_نسخ_ذاكرة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    الحجم: طبيعي,
    إزاحة_الوجهة: طبيعي,
    إزاحة_المصدر: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    دع العمل: معرف_سجل_فعلي = { القيمة: 15 };
    دع المنجز: متغير طبيعي = 0;
    طالما (المنجز < الحجم) {
        دع الباقي: طبيعي = الحجم - المنجز;
        دع الجزء: متغير طبيعي = 1;
        لو (الباقي >= 8) { الجزء := 8; }
        وإلا لو (الباقي >= 4) { الجزء := 4; }
        وإلا لو (الباقي >= 2) { الجزء := 2; };
        طابق ألحق_ذاكرة_بإزاحة_ذراع(
            الكلمات, صواب, العمل, المصدر, إزاحة_المصدر + المنجز, الجزء, خطأ
        ) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        طابق ألحق_ذاكرة_بإزاحة_ذراع(
            الكلمات, خطأ, العمل, الوجهة, إزاحة_الوجهة + المنجز, الجزء, خطأ
        ) مع
        | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
        المنجز := المنجز + الجزء;
    }
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف ترميز_انسكاب_ذراع(
    تحميل: منطقي,
    السجل: معرف_سجل_فعلي,
    الموقع: &موضع_انسكاب_ذراع_أربعة_وستون
): نتيجة_كلمة_ذراع {
    دع م: موضع_انسكاب_ذراع_أربعة_وستون = *الموقع;
    لو ((م.إزاحة_بايت % 8) != 0 || م.إزاحة_بايت > 32760) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.إزاحة_انسكاب_خارج_المدى(م.إزاحة_بايت)
        );
    };
    لو (!سجل_ذراع_قابل_للترميز(السجل)) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(السجل)
        );
    };
    دع المضروب: طبيعي = م.إزاحة_بايت / 8;
    دع قاعدة: متغير طبيعي = 0xF9000000;
    لو (تحميل) {
        قاعدة := 0xF9400000;
    };
    دع القيمة: طبيعي = قاعدة + (المضروب * 1024) + 992 + السجل.القيمة;
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
}

عرف ألحق_نتيجة_كلمة(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    النتيجة: نتيجة_كلمة_ذراع
): نتيجة_دفعة_ترميز_ذراع {
    طابق النتيجة مع
    | نتيجة_كلمة_ذراع.خطأ(الخطأ) -> {
        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
    }
    | نتيجة_كلمة_ذراع.نجحت(الكلمة) -> {

        ألحق_كلمة_مشفرة_ذراع(الكلمات, الكلمة);

        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    };
}

عرف ألحق_تعديل_مؤشر_المكدس_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الحجم: طبيعي,
    طرح: منطقي,
    فك_المكدس: &متغير متتبع_فك_المكدس
): فراغ {
    دع الباقي: متغير طبيعي = الحجم;
    طالما (الباقي > 0) {
        دع الجزء: متغير طبيعي = الباقي;
        لو (الجزء > 4080) {
            الجزء := 4080;
        };
        دع الأساس: متغير طبيعي = 0x91000000;
        لو (طرح) {
            الأساس := 0xD1000000;
        };
        دع الكلمة: طبيعي = الأساس + (الجزء * 1024) + 992 + 31;
        ألحق_كلمة_ذراع(الكلمات, الكلمة);
        دع عدد_الكلمات_بعد_التعديل: طبيعي = الطول(*الكلمات) مثل طبيعي;
        دع إزاحة_بعد_التعديل: طبيعي = عدد_الكلمات_بعد_التعديل * 4;
        لو (طرح) { سجل_طرح_مكدس_فك_المكدس(فك_المكدس, إزاحة_بعد_التعديل, الجزء); }
        وإلا { سجل_إضافة_مكدس_فك_المكدس(فك_المكدس, إزاحة_بعد_التعديل, الجزء); };
        الباقي := الباقي - الجزء;
    }
}

عرف ألحق_انسكاب_بإزاحة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    تحميل: منطقي,
    السجل: معرف_سجل_فعلي,
    الموقع: &موضع_انسكاب_ذراع_أربعة_وستون
): نتيجة_دفعة_ترميز_ذراع {
    دع م: موضع_انسكاب_ذراع_أربعة_وستون = *الموقع;
    لو ((م.إزاحة_بايت % 8) == 0 && م.إزاحة_بايت <= 32760) {
        أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_انسكاب_ذراع(تحميل, السجل, &م));
    };
    دع عنوان: متغير معرف_سجل_فعلي = { القيمة: 17 };
    لو (السجل.القيمة == 17) { عنوان.القيمة := 16; };
    // كون عنوان الانسكاب من SP باستخدام ADD-immediate كي يبقى Rn=31 هو SP لا XZR.
    ألحق_كلمة_ذراع(الكلمات, 0x910003E0 + عنوان.القيمة);
    دع الباقي: متغير طبيعي = م.إزاحة_بايت;
    طالما (الباقي > 0) {
        دع الجزء: متغير طبيعي = الباقي;
        لو (الجزء > 4095) { الجزء := 4095; };
        ألحق_كلمة_ذراع(
            الكلمات,
            0x91000000 + (الجزء * 1024) + (عنوان.القيمة * 32) + عنوان.القيمة
        );
        الباقي := الباقي - الجزء;
    }
    أرجع ألحق_نتيجة_كلمة(
        الكلمات, ترميز_ذاكرة_ذراع(تحميل, السجل, عنوان, 0, 8, خطأ)
    );
}

عرف ألحق_تحميل_موقع_نداء_إلى_سجل_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    الموقع: &موقع_قيمة_ذراع_أربعة_وستون_مخصص,
    الوجهة: معرف_سجل_فعلي,
    انحياز_مكدس: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    طابق سجل_موقع_قيمة_ذراع(الموقع) مع
    | اختياري.موجود(المصدر) -> {
        لو (معرفا_سجل_فعلي_متساويان(المصدر, الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
        };
        أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(الوجهة, المصدر));
    }
    | اختياري.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_ذراع(الموقع) مع
        | اختياري.موجود(الموضع) -> {
            دع الإزاحة_الحالية: طبيعي = الموضع.إزاحة_بايت + انحياز_مكدس;
            دع الموضع_الحالي: موضع_انسكاب_ذراع_أربعة_وستون = {
                السجل: الموضع.السجل,
                الفهرس: الموضع.الفهرس,
                إزاحة_بايت: الإزاحة_الحالية,
                الحجم: الموضع.الحجم,
                المحاذاة: الموضع.المحاذاة
            };
            أرجع ألحق_انسكاب_بإزاحة_ذراع(الكلمات, صواب, الوجهة, &الموضع_الحالي);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()
            );
        };
    };
}

عرف ألحق_تخزين_سجل_إلى_موقع_نداء_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    المصدر: معرف_سجل_فعلي,
    الموقع: &موقع_قيمة_ذراع_أربعة_وستون_مخصص,
    انحياز_مكدس: طبيعي
): نتيجة_دفعة_ترميز_ذراع {
    طابق سجل_موقع_قيمة_ذراع(الموقع) مع
    | اختياري.موجود(الوجهة) -> {
        لو (معرفا_سجل_فعلي_متساويان(المصدر, الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
        };
        أرجع ألحق_نتيجة_كلمة(الكلمات, ترميز_نقل_سجل_ذراع(الوجهة, المصدر));
    }
    | اختياري.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_ذراع(الموقع) مع
        | اختياري.موجود(الموضع) -> {
            دع الإزاحة_الحالية: طبيعي = الموضع.إزاحة_بايت + انحياز_مكدس;
            دع الموضع_الحالي: موضع_انسكاب_ذراع_أربعة_وستون = {
                السجل: الموضع.السجل,
                الفهرس: الموضع.الفهرس,
                إزاحة_بايت: الإزاحة_الحالية,
                الحجم: الموضع.الحجم,
                المحاذاة: الموضع.المحاذاة
            };
            أرجع ألحق_انسكاب_بإزاحة_ذراع(الكلمات, خطأ, المصدر, &الموضع_الحالي);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم()
            );
        };
    };
}

عرف ألحق_نقل_موقع_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    المصدر: &موقع_قيمة_ذراع_أربعة_وستون_مخصص,
    الوجهة: &موقع_قيمة_ذراع_أربعة_وستون_مخصص,
    سجل_عمل: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_ذراع {
    لو (مواقع_ذراع_متساوية(المصدر, الوجهة)) {
        أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
    };
    طابق سجل_موقع_قيمة_ذراع(المصدر) مع
    | اختياري.موجود(سجل_المصدر) -> {
        طابق سجل_موقع_قيمة_ذراع(الوجهة) مع
        | اختياري.موجود(سجل_الوجهة) -> {
            أرجع ألحق_نتيجة_كلمة(
                الكلمات,
                ترميز_نقل_سجل_ذراع(سجل_الوجهة, سجل_المصدر)
            );
        }
        | اختياري.لا_شيء -> {
            طابق انسكاب_موقع_قيمة_ذراع(الوجهة) مع
            | اختياري.موجود(موضع_الوجهة) -> {
                أرجع ألحق_انسكاب_بإزاحة_ذراع(
                    الكلمات, خطأ, سجل_المصدر, &موضع_الوجهة
                );
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                    خطأ_ترميز_ذراع_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()
                );
            };
        };
    }
    | اختياري.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_ذراع(المصدر) مع
        | اختياري.موجود(موضع_المصدر) -> {
            طابق سجل_موقع_قيمة_ذراع(الوجهة) مع
            | اختياري.موجود(سجل_الوجهة) -> {
                أرجع ألحق_انسكاب_بإزاحة_ذراع(
                    الكلمات, صواب, سجل_الوجهة, &موضع_المصدر
                );
            }
            | اختياري.لا_شيء -> {
                طابق انسكاب_موقع_قيمة_ذراع(الوجهة) مع
                | اختياري.موجود(موضع_الوجهة) -> {
                    طابق ألحق_انسكاب_بإزاحة_ذراع(
                        الكلمات, صواب, سجل_عمل, &موضع_المصدر
                    ) مع
                    | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
                        أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
                    }
                    | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                    أرجع ألحق_انسكاب_بإزاحة_ذراع(
                        الكلمات, خطأ, سجل_عمل, &موضع_الوجهة
                    );
                }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                        خطأ_ترميز_ذراع_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()
                    );
                };
            };
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                خطأ_ترميز_ذراع_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()
            );
        };
    };
}

عرف وجهة_مستخدمة_كمصدر_ذراع(
    النقلات: &متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة,
    النشطة: &متجه منطقي,
    الفهرس: طبيعي
): منطقي {
    دع ن: متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة = *النقلات;
    دع ح: متجه منطقي = *النشطة;
    دع الوجهة: موقع_قيمة_ذراع_أربعة_وستون_مخصص = ن[الفهرس].الوجهة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ن) مثل طبيعي)) {
        لو (ح[ف] && ف != الفهرس) {
            لو (مواقع_ذراع_متساوية(&الوجهة, &ن[ف].المصدر)) {
                أرجع صواب;
            };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف استبدل_مصدر_موقع_ذراع(
    النقلات: &متغير متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة,
    النشطة: &متجه منطقي,
    القديم: &موقع_قيمة_ذراع_أربعة_وستون_مخصص,
    الجديد: موقع_قيمة_ذراع_أربعة_وستون_مخصص
): فراغ {
    دع ح: متجه منطقي = *النشطة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النقلات) مثل طبيعي)) {
        لو (ح[ف] && مواقع_ذراع_متساوية(&(*النقلات)[ف].المصدر, القديم)) {
            (*النقلات)[ف].المصدر := الجديد;
        };
        ف := ف + 1;
    }
}

عرف ألحق_نقلات_حافة_ذراع(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    المتطلبات: &متطلبات_نقل_حافة_ذراع_أربعة_وستون_مخصصة
): نتيجة_دفعة_ترميز_ذراع {
    دع م: متطلبات_نقل_حافة_ذراع_أربعة_وستون_مخصصة = *المتطلبات;
    دع مرجع_النقلات: &متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة = &م.النقلات;
    دع النقلات: متغير متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة = انسخ_مملوكا_متجه_نقلة_حافة_ذراع_أربعة_وستون_مخصصة(مرجع_النقلات);
    دع النشطة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النقلات) مثل طبيعي)) {
        ألحق(النشطة, صواب);
        ف := ف + 1;
    }
    دع الباقي: متغير طبيعي = الطول(النقلات) مثل طبيعي;
    دع سجل_الدورة: معرف_سجل_فعلي = { القيمة: 15 };
    دع سجل_النقل: معرف_سجل_فعلي = { القيمة: 16 };
    طالما (الباقي > 0) {
        دع تقدم: متغير منطقي = خطأ;
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول(النقلات) مثل طبيعي)) {
            لو (النشطة[ن] && !وجهة_مستخدمة_كمصدر_ذراع(&النقلات, &النشطة, ن)) {
                طابق ألحق_نقل_موقع_ذراع(
                    الكلمات,
                    &النقلات[ن].المصدر,
                    &النقلات[ن].الوجهة,
                    سجل_النقل
                ) مع
                | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
                    أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
                }
                | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
                النشطة[ن] := خطأ;
                الباقي := الباقي - 1;
                تقدم := صواب;
            };
            ن := ن + 1;
        }
        لو (!تقدم && الباقي > 0) {
            دع أول: متغير طبيعي = 0;
            طالما (أول < (الطول(النقلات) مثل طبيعي) && !النشطة[أول]) {
                أول := أول + 1;
            }
            لو (أول >= (الطول(النقلات) مثل طبيعي)) {
                أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(
                    خطأ_ترميز_ذراع_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()
                );
            };
            دع القديمة: موقع_قيمة_ذراع_أربعة_وستون_مخصص = النقلات[أول].الوجهة;
            دع المؤقت: موقع_قيمة_ذراع_أربعة_وستون_مخصص =
                ابن_موقع_سجل_ذراع_مخصص(سجل_الدورة);
            طابق ألحق_نقل_موقع_ذراع(الكلمات, &القديمة, &المؤقت, سجل_النقل) مع
            | نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ) -> {
                أرجع نتيجة_دفعة_ترميز_ذراع.خطأ(الخطأ);
            }
            | نتيجة_دفعة_ترميز_ذراع.نجحت -> { };
            استبدل_مصدر_موقع_ذراع(&متغير النقلات, &النشطة, &القديمة, المؤقت);
        };
    }
    أرجع نتيجة_دفعة_ترميز_ذراع.نجحت();
}

عرف ترميز_فرع_نسبي_ذراع(
    الموضع: طبيعي,
    الهدف_بايت: طبيعي,
    الهدف: معرف_كتلة_منتقاة
): نتيجة_كلمة_ذراع {
    دع موضع_موقع: عدد = الموضع مثل عدد;
    دع هدف_موقع: عدد = الهدف_بايت مثل عدد;
    دع الفرق: عدد = هدف_موقع - موضع_موقع;
    لو ((الفرق % 4) != 0) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.فرع_غير_محاذى(الهدف)
        );
    };
    دع الوحدات: عدد = الفرق / 4;
    لو (الوحدات < -33554432 || الوحدات > 33554431) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.فرع_خارج_المدى(الهدف)
        );
    };
    دع الحقل: متغير طبيعي = الوحدات مثل طبيعي;
    لو (الوحدات < 0) {
        دع قيمة_الحقل: عدد = 67108864 + الوحدات;
        الحقل := قيمة_الحقل مثل طبيعي;
    };
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(0x14000000 + الحقل));
}

عرف ترميز_فرع_شرطي_برمز_ذراع(
    الموضع: طبيعي,
    الهدف_بايت: طبيعي,
    الهدف: معرف_كتلة_منتقاة,
    رمز_الشرط: طبيعي
): نتيجة_كلمة_ذراع {
    دع موضع_موقع: عدد = الموضع مثل عدد;
    دع هدف_موقع: عدد = الهدف_بايت مثل عدد;
    دع الفرق: عدد = هدف_موقع - موضع_موقع;
    لو ((الفرق % 4) != 0) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.فرع_غير_محاذى(الهدف)
        );
    };
    دع الوحدات: عدد = الفرق / 4;
    لو (الوحدات < -262144 || الوحدات > 262143) {
        أرجع نتيجة_كلمة_ذراع.خطأ(
            خطأ_ترميز_ذراع_أربعة_وستون.فرع_خارج_المدى(الهدف)
        );
    };
    دع الحقل: متغير طبيعي = الوحدات مثل طبيعي;
    لو (الوحدات < 0) {
        دع قيمة_الحقل: عدد = 524288 + الوحدات;
        الحقل := قيمة_الحقل مثل طبيعي;
    };
    دع القيمة: طبيعي = 0x54000000 + (الحقل * 32) + رمز_الشرط;
    أرجع نتيجة_كلمة_ذراع.نجحت(كلمة_ذراع(القيمة));
}

عرف ترميز_فرع_شرطي_نسبي_ذراع(
    الموضع: طبيعي,
    الهدف_بايت: طبيعي,
    الهدف: معرف_كتلة_منتقاة,
    الشرط: شرط_ذراع_أربعة_وستون
): نتيجة_كلمة_ذراع {
    أرجع ترميز_فرع_شرطي_برمز_ذراع(
        الموضع,
        الهدف_بايت,
        الهدف,
        رمز_شرط_ذراع(الشرط)
    );
}

عرف ألحق_تثبيت_فرع_داخلي(
    التثبيتات: &متغير متجه تثبيت_فرع_داخلي_ذراع,
    فهرس_الكلمة: طبيعي,
    الموضع: طبيعي,
    الهدف: معرف_كتلة_منتقاة,
    النوع: نوع_فرع_داخلي_ذراع
): فراغ {

    دع التثبيت: تثبيت_فرع_داخلي_ذراع = {
        فهرس_الكلمة: فهرس_الكلمة,
        موضع_بايت: الموضع,
        الهدف: الهدف,
        النوع: النوع
    };
    ألحق(*التثبيتات, التثبيت);

}

عرف ألحق_فرع_داخلي_مؤجل(
    الكلمات: &متغير متجه كلمة_ذراع_أربعة_وستون_مشفرة,
    التثبيتات: &متغير متجه تثبيت_فرع_داخلي_ذراع,
    الهدف: معرف_كتلة_منتقاة,
    النوع: نوع_فرع_داخلي_ذراع
): فراغ {
    دع الفهرس: طبيعي = الطول(*الكلمات) مثل طبيعي;
    دع الموضع: طبيعي = الفهرس * 4;
    ألحق_كلمة_ذراع(الكلمات, 0);
    ألحق_تثبيت_فرع_داخلي(التثبيتات, الفهرس, الموضع, الهدف, النوع);
}

عرف ألحق_تثبيت_نداء_ذراع(
