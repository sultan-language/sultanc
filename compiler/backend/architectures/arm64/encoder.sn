        الدالة: الدالة,
        إزاحة_بايت: الموضع
    };
    دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.خدمة_تشغيل(الخدمة);
    دع النوع: نوع_إزاحة_رمزية_كائن =
        نوع_إزاحة_رمزية_كائن.فرع_ذراع_ستة_وعشرون_بت();
    دع الطلب: طلب_إزاحة_نص_كائن = {
        الموضع: موضع_النص,
        النوع: النوع,
        الرمز: الرمز,
        الإضافة: 0
    };
    ألحق_إزاحة_نص_مرفق_ذراع(المرفقات, الطلب);

}

عرف ألحق_إزاحة_رمز_خارجي_ذراع(
