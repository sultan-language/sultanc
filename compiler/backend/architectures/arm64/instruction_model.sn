استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.selection_contract;
استورد compiler.backend.abi.abi_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.msir.identifiers;

// شروط AArch64 الحقيقية الناتجة من NZCV. هذه هوية ISA وليست محمول المقارنة المشترك.
عام نوع شرط_ذراع_أربعة_وستون =
    | تكافؤ
    | لاتكافؤ
    | أقل_بإشارة
    | أقل_أو_يساوي_بإشارة
    | أكبر_بإشارة
    | أكبر_أو_يساوي_بإشارة
    | أدنى_طبيعي
    | أدنى_أو_يساوي_طبيعي
    | أعلى_طبيعي
    | أعلى_أو_يساوي_طبيعي
;

// أشكال المعاملات هنا خاصة بـ AArch64 وقابلة للتوسعة لاحقا للإزاحة/التمديد وفئات الفوري المشفرة.
عام نوع معامل_حساب_ذراع_أربعة_وستون =
    | سجل بنوع معرف_سجل_افتراضي
    | فوري_اثنا_عشر_بت بنوع طبيعي
;

عام نوع عنوان_ذاكرة_ذراع_أربعة_وستون = {
    الأساس: معرف_سجل_افتراضي,
    إزاحة_بايت: عدد
};


// عرض العدد الدلالي يبقى حقيقة Type/MSIR، بينما السجل العام حامل آلة فقط.
عام نوع وصف_عدد_ذراع_أربعة_وستون = {
    البتات: طبيعي,
    موقع: منطقي
};

// العملية الحسابية المنتقاة تحمل عقد MSIR كاملا كي لا يعتمد encoder على التفاف الآلة.
عام نوع عملية_حساب_ذراع_أربعة_وستون =
    | جمع
    | طرح
    | ضرب
    | قسمة
    | باقي
    | و_بتي
    | أو_بتي
    | أو_حصري
    | إزاحة_يسرى
    | إزاحة_يمنى_منطقية
    | إزاحة_يمنى_حسابية
    // Wrapping forms: the 64-bit instruction, then the operand type's
    // canonical extension of the low N bits; no overflow trap.
    | جمع_ملتف
    | طرح_ملتف
    | ضرب_ملتف
    | إزاحة_يسرى_ملتفة
;

عام نوع حساب_صحيح_ذراع_أربعة_وستون = {
    العملية: عملية_حساب_ذراع_أربعة_وستون,
    الوجهة: معرف_سجل_افتراضي,
    اليسار: معرف_سجل_افتراضي,
    اليمين: معرف_سجل_افتراضي,
    الوصف: وصف_عدد_ذراع_أربعة_وستون
};

عام نوع حساب_عشري_ذراع_أربعة_وستون =
    | جمع
    | طرح
    | ضرب
    | قسمة
    // The float primitives (عملية_عائمة_بدائية): FSQRT, FABS, FRINTM,
    // FRINTP, FRINTZ, FRINTN, FMIN, FMAX, and copysign with BIT. The unary
    // ones take their operand twice.
    | جذر_تربيعي
    | قيمة_مطلقة
    | أرضية
    | سقف
    | بتر
    | تقريب_زوجي
    | أدنى
    | أقصى
    | نسخ_إشارة
;

// Float conversions (MSIR تحويل_عائم): the integer side's signedness is in
// the operation, its width in the instruction.
عام نوع تحويل_عائم_ذراع_أربعة_وستون =
    | عائم_إلى_موقع
    | عائم_إلى_طبيعي
    | موقع_إلى_عائم
    | طبيعي_إلى_عائم
    | عائم_إلى_عائم
;

عام نوع مقارنة_عشرية_ذراع_أربعة_وستون =
    | يساوي
    | لا_يساوي
    | أصغر
    | أصغر_أو_يساوي
    | أكبر
    | أكبر_أو_يساوي
;

عام نوع عملية_تحويل_ذراع_أربعة_وستون =
    | توسيع_بإشارة
    | توسيع_صفري
    | اقتطاع
    | إعادة_تفسير
;

عام نوع تحويل_صحيح_ذراع_أربعة_وستون = {
    العملية: عملية_تحويل_ذراع_أربعة_وستون,
    الوجهة: معرف_سجل_افتراضي,
    المصدر: معرف_سجل_افتراضي,
    بتات_المصدر: طبيعي,
    بتات_الوجهة: طبيعي,
    المصدر_موقع: منطقي,
    الوجهة_موقع: منطقي
};

// موضع ABI يحتفظ بالسجل أو المكدس كما قرره مزود macOS؛ لا يُختزل إلى سجل فقط.
عام نوع قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = {
    السجل: معرف_سجل_افتراضي,
    المواضع: متجه موضع_جزء_واجهة,
    الحجم: طبيعي,
    تجميعي: طبيعي,
    غير_مباشر: طبيعي,
    بإشارة: طبيعي
};

// خطة ABI نتيجة استعلام Target/ABI فقط؛ لا تستنتج التعليمة سياسة نظام تشغيل.
عام نوع هدف_نداء_ذراع_أربعة_وستون =
    | دالة بنوع معرف_دالة_منتقاة
    | دالة_خارجية بنوع معرف_دالة_خارجية_منتقاة
    | بدائي_تشغيل بنوع هوية_بدائي_مترجم
    | قيمة_دالة بنوع معرف_سجل_افتراضي
    // The C function at the address the register holds (بدائي_نداء_عنوان_سي).
    | عنوان_سي بنوع معرف_سجل_افتراضي
;

عام عرف انسخ_هدف_نداء_ذراع(
    الهدف: &هدف_نداء_ذراع_أربعة_وستون
): هدف_نداء_ذراع_أربعة_وستون {
    طابق *الهدف مع
    | هدف_نداء_ذراع_أربعة_وستون.دالة(الدالة) -> {
        أرجع هدف_نداء_ذراع_أربعة_وستون.دالة(الدالة);
    }
    | هدف_نداء_ذراع_أربعة_وستون.دالة_خارجية(المعرف) -> {
        أرجع هدف_نداء_ذراع_أربعة_وستون.دالة_خارجية(المعرف);
    }
    | هدف_نداء_ذراع_أربعة_وستون.بدائي_تشغيل(البدائي) -> {
        أرجع هدف_نداء_ذراع_أربعة_وستون.بدائي_تشغيل(البدائي);
    }
    | هدف_نداء_ذراع_أربعة_وستون.قيمة_دالة(السجل) -> {
        أرجع هدف_نداء_ذراع_أربعة_وستون.قيمة_دالة(السجل);
    }
    | هدف_نداء_ذراع_أربعة_وستون.عنوان_سي(السجل) -> {
        أرجع هدف_نداء_ذراع_أربعة_وستون.عنوان_سي(السجل);
    };
}

عام نوع نداء_ذراع_أربعة_وستون_منتقى = {
    الهدف: هدف_نداء_ذراع_أربعة_وستون,
    الحجج: متجه قيمة_واجهة_ذراع_أربعة_وستون_منتقاة,
    الناتج: اختياري قيمة_واجهة_ذراع_أربعة_وستون_منتقاة,
    حجم_مكدس_النداء: طبيعي
};

عام نوع استلام_معامل_ذراع_أربعة_وستون_منتقى = {
    القيمة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة
};

عام نوع ناتج_عودة_ذراع_أربعة_وستون_منتقى = {
    القيمة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة,
    عنوان_ناتج_غير_مباشر: اختياري معرف_سجل_افتراضي
};

عام نوع حجز_إطار_ذراع_أربعة_وستون = {
    الوجهة: معرف_سجل_افتراضي,
    الهوية: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي
};

عام نوع تخزين_فوري_ذراع_أربعة_وستون = {
    الأساس: معرف_سجل_افتراضي,
    الإزاحة: طبيعي,
    الحجم: طبيعي,
    القيمة: طبيعي
};

// append يحتاج عنوان رأس المتجه نفسه، لذلك لا يمر عبر ABI كتجميع منسوخ.
// Layout يقرر الإزاحات/الحجم وRuntime يقرر سياسة النمو؛ ARM64 يملك خفض الآلة فقط.
عام نوع إلحاق_متجه_ذراع_أربعة_وستون = {
    المتجه: معرف_سجل_افتراضي,
    العنصر: معرف_سجل_افتراضي,
    إزاحة_البيانات: طبيعي,
    إزاحة_الطول: طبيعي,
    إزاحة_السعة: طبيعي,
    حجم_الطول: طبيعي,
    حجم_السعة: طبيعي,
    حجم_العنصر: طبيعي,
    العنصر_تجميعي: منطقي,
    السعة_الدنيا: طبيعي,
    عامل_النمو: طبيعي,
    // Reserve (حجز_سعة_متجه) instead of append: العنصر holds the additional
    // element count, and the buffer grows to exactly length + additional.
    الحجز: منطقي
};

// ثابت النص يملك مخزن قيمة النص المحلي، بينما بايتاته نفسها تذهب إلى بيانات كائنية ثابتة.
// إزاحات الحقول تأتي من Layout ولا يعيد ARM64 تعريف تمثيل النص.
عام نوع ثابت_نص_ذراع_أربعة_وستون = {
    الوجهة: معرف_سجل_افتراضي,
    الهوية: طبيعي,
    البايتات: متجه ط8,
    إزاحة_البيانات: طبيعي,
    إزاحة_الطول: طبيعي,
    إزاحة_السعة: طبيعي
};

عام عرف انسخ_بايتات_ثابت_نص_ذراع(المصدر: &متجه ط8): متجه ط8 {
    دع م: متجه ط8 = *المصدر;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(م) مثل طبيعي)) {
        ألحق(الناتج, م[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Atomic read-modify-write on a memory word (thread support), as the
// ARMv8.1 LSE instructions every Apple Silicon core has: SWPAL, LDADDAL,
// LDCLRAL (AND of the complement), LDSETAL (OR), LDEORAL (XOR).
عام نوع عملية_ذرية_ذراع =
    | تبديل
    | جلب_جمع
    | جلب_و
    | جلب_أو
    | جلب_أو_حصري
;

// الشفرة المنتقاة AArch64 تميز أشكال ISA المهمة قبل التخصيص، من دون ترميز كلمات الآلة.
عام نوع تعليمة_ذراع_أربعة_وستون =
    | نقل_سجل_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي)
    | مادي_فوري_ذراع بنوع (معرف_سجل_افتراضي, عدد)
    | مادي_فوري_ذراع_طبيعي بنوع (معرف_سجل_افتراضي, طبيعي)
    | عنوان_دالة_ذراع بنوع (معرف_سجل_افتراضي, معرف_دالة_منتقاة)
    | عنوان_عام_ذراع بنوع (معرف_سجل_افتراضي, معرف_عام_مسير, منطقي)
    | بيئة_إغلاق_ذراع بنوع معرف_سجل_افتراضي
    | استلام_معامل_ذراع بنوع استلام_معامل_ذراع_أربعة_وستون_منتقى
    | حساب_صحيح_ذراع بنوع حساب_صحيح_ذراع_أربعة_وستون
    | حساب_عشري_ذراع بنوع (حساب_عشري_ذراع_أربعة_وستون, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    // Division or remainder by a constant with UMULH/SMULH
    // (backend/codegen/division_by_constant.sn): (destination, dividend,
    // divisor as 64-bit pattern, bits, signed, remainder).
    | قسمة_على_ثابت_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي, طبيعي, منطقي, منطقي)
    // FMADD: (destination, a, b, c, bits) for a * b + c rounded once.
    | ضرب_جمع_مدمج_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | مقارنة_عشرية_إلى_منطق_ذراع بنوع (مقارنة_عشرية_ذراع_أربعة_وستون, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | تحويل_صحيح_ذراع بنوع تحويل_صحيح_ذراع_أربعة_وستون
    // (operation, destination, source, source bits, destination bits)
    | تحويل_عائم_ذراع بنوع (تحويل_عائم_ذراع_أربعة_وستون, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي, طبيعي)
    | عنوان_إطار_ذراع بنوع حجز_إطار_ذراع_أربعة_وستون
    | عنوان_إزاحة_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | عنوان_عنصر_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | نسخ_ذاكرة_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي, طبيعي, طبيعي)
    | تخزين_فوري_ذراع بنوع تخزين_فوري_ذراع_أربعة_وستون
    | إلحاق_متجه_ذراع بنوع إلحاق_متجه_ذراع_أربعة_وستون
    | ثابت_نص_ذراع بنوع ثابت_نص_ذراع_أربعة_وستون
    | تخصيص_صندوق_ذراع بنوع (معرف_سجل_افتراضي, طبيعي, طبيعي)
    | جمع_سجل_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي)
    | جمع_سجل_مزاح_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | جمع_فوري_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | طرح_سجل_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي)
    | طرح_فوري_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | مقارنة_سجل_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي)
    | مقارنة_فوري_ذراع بنوع (معرف_سجل_افتراضي, طبيعي)
    | ثبت_شرط_ذراع بنوع (معرف_سجل_افتراضي, شرط_ذراع_أربعة_وستون)
    | فخ_ذراع
    // (operation, destination, address, operand, bits): the old value.
    | ذري_ذراع بنوع (عملية_ذرية_ذراع, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    // (destination, address, expected, new, bits): CASAL, the old value.
    | ذري_قارن_وبدل_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    // (destination, address, bits): LDAR.
    | ذري_حمل_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    // (address, value, bits): STLR.
    | ذري_خزن_ذراع بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | سياج_ذراع
    // The address of a C-callable entry that runs the closure whose
    // environment is its argument (an inline trampoline).
    | مدخل_سي_ذراع بنوع معرف_سجل_افتراضي
    // (selector, targets for tags الأدنى..الأدنى+len-1, default, الأدنى)
    | فرع_جدولي_ذراع بنوع (معرف_سجل_افتراضي, متجه معرف_كتلة_منتقاة, معرف_كتلة_منتقاة, طبيعي)
    | فرع_ذراع بنوع معرف_كتلة_منتقاة
    | فرع_ذراع_مع_نقلات بنوع متطلبات_نقل_حافة_منتقاة
    | فرع_ذراع_شرطي بنوع (شرط_ذراع_أربعة_وستون, معرف_كتلة_منتقاة)
    | فرع_ذراع_شرطي_مع_نقلات بنوع (شرط_ذراع_أربعة_وستون, متطلبات_نقل_حافة_منتقاة)
    | فرع_برابط_ذراع_مباشر بنوع نداء_ذراع_أربعة_وستون_منتقى
    | عودة_ذراع
    | عودة_ذراع_بقيمة بنوع ناتج_عودة_ذراع_أربعة_وستون_منتقى
    | تحميل_ذراع_أساس_إزاحة بنوع (معرف_سجل_افتراضي, عنوان_ذاكرة_ذراع_أربعة_وستون, طبيعي, منطقي)
    | تخزين_ذراع_أساس_إزاحة بنوع (معرف_سجل_افتراضي, عنوان_ذاكرة_ذراع_أربعة_وستون, طبيعي)
;

عام عرف شرط_ذراع_من_محمول(المحمول: محمول_مقارنة_منتقى): شرط_ذراع_أربعة_وستون {
    طابق المحمول مع
    | محمول_مقارنة_منتقى.يساوي -> {
        أرجع شرط_ذراع_أربعة_وستون.تكافؤ();
    }
    | محمول_مقارنة_منتقى.لا_يساوي -> {
        أرجع شرط_ذراع_أربعة_وستون.لاتكافؤ();
    }
    | محمول_مقارنة_منتقى.أصغر_موقع -> {
        أرجع شرط_ذراع_أربعة_وستون.أقل_بإشارة();
    }
    | محمول_مقارنة_منتقى.أصغر_أو_يساوي_موقع -> {
        أرجع شرط_ذراع_أربعة_وستون.أقل_أو_يساوي_بإشارة();
    }
    | محمول_مقارنة_منتقى.أكبر_موقع -> {
        أرجع شرط_ذراع_أربعة_وستون.أكبر_بإشارة();
    }
    | محمول_مقارنة_منتقى.أكبر_أو_يساوي_موقع -> {
        أرجع شرط_ذراع_أربعة_وستون.أكبر_أو_يساوي_بإشارة();
    }
    | محمول_مقارنة_منتقى.أصغر_طبيعي -> {
        أرجع شرط_ذراع_أربعة_وستون.أدنى_طبيعي();
    }
    | محمول_مقارنة_منتقى.أصغر_أو_يساوي_طبيعي -> {
        أرجع شرط_ذراع_أربعة_وستون.أدنى_أو_يساوي_طبيعي();
    }
    | محمول_مقارنة_منتقى.أكبر_طبيعي -> {
        أرجع شرط_ذراع_أربعة_وستون.أعلى_طبيعي();
    }
    | محمول_مقارنة_منتقى.أكبر_أو_يساوي_طبيعي -> {
        أرجع شرط_ذراع_أربعة_وستون.أعلى_أو_يساوي_طبيعي();
    };
}
