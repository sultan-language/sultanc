عرف خصص_تعليمة_ذراع(
    التعليمة: &تعليمة_ذراع_أربعة_وستون,
    التعيينات: &متجه تعيين_سجل,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون
): نتيجة_تعليمة_ذراع_مخصصة {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(الوجهة, المصدر) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة);
        }
        | اختيار.بعض(وجهة_فعلية) -> {
            طابق ابحث_تعيين_سجل(التعيينات, المصدر) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(المصدر);
            }
            | اختيار.بعض(مصدر_فعلي) -> {
                دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة =
                    تعليمة_ذراع_أربعة_وستون_مخصصة.نقل_سجل(وجهة_فعلية, مصدر_فعلي);
                أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
            };
        };
    }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(الوجهة, القيمة) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة);
        }
        | اختيار.بعض(السجل) -> {
            دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة =
                تعليمة_ذراع_أربعة_وستون_مخصصة.مادي_فوري(السجل, القيمة);
            أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_غير_موقع(الوجهة, القيمة) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة);
        }
        | اختيار.بعض(السجل) -> {
            دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة =
                تعليمة_ذراع_أربعة_وستون_مخصصة.مادي_فوري_غير_موقع(السجل, القيمة);
            أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(الوجهة, الدالة) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة); }
        | اختيار.بعض(السجل) -> {
            أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(
                تعليمة_ذراع_أربعة_وستون_مخصصة.عنوان_دالة(السجل, الدالة)
            );
        };
    }
    | تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(الاستلام) -> {
        طابق خصص_قيمة_واجهة_ذراع(&الاستلام.القيمة, التعيينات) مع
        | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة.نجح(القيمة) -> {
            دع م: استلام_معامل_ذراع_أربعة_وستون_مخصص = { القيمة: القيمة };
            أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(تعليمة_ذراع_أربعة_وستون_مخصصة.استلام_معامل(م));
        };
    }
    | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(الحساب) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الحساب.الوجهة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الحساب.الوجهة); }
        | اختيار.بعض(و) -> {
            طابق ابحث_تعيين_سجل(التعيينات, الحساب.اليسار) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الحساب.اليسار); }
            | اختيار.بعض(أ) -> {
                طابق ابحث_تعيين_سجل(التعيينات, الحساب.اليمين) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الحساب.اليمين); }
                | اختيار.بعض(ب) -> {
                    دع م: حساب_صحيح_ذراع_أربعة_وستون_مخصص = {
                        العملية: الحساب.العملية, الوجهة: و, اليسار: أ, اليمين: ب, الوصف: الحساب.الوصف
                    };
                    أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(تعليمة_ذراع_أربعة_وستون_مخصصة.حساب_صحيح(م));
                };
            };
        };
    }
    | تعليمة_ذراع_أربعة_وستون.حساب_عشري_ذراع(العملية, الوجهة, اليسار, اليمين, البتات) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة); }
        | اختيار.بعض(و) -> {
            طابق ابحث_تعيين_سجل(التعيينات, اليسار) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(اليسار); }
            | اختيار.بعض(أ) -> {
                طابق ابحث_تعيين_سجل(التعيينات, اليمين) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(اليمين); }
                | اختيار.بعض(ب) -> {
                    أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(
                        تعليمة_ذراع_أربعة_وستون_مخصصة.حساب_عشري(العملية, و, أ, ب, البتات)
                    );
                };
            };
        };
    }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_عشرية_إلى_منطق_ذراع(العملية, الوجهة, اليسار, اليمين, البتات) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة); }
        | اختيار.بعض(و) -> {
            طابق ابحث_تعيين_سجل(التعيينات, اليسار) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(اليسار); }
            | اختيار.بعض(أ) -> {
                طابق ابحث_تعيين_سجل(التعيينات, اليمين) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(اليمين); }
                | اختيار.بعض(ب) -> {
                    أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(
                        تعليمة_ذراع_أربعة_وستون_مخصصة.مقارنة_عشرية_إلى_منطق(العملية, و, أ, ب, البتات)
                    );
                };
            };
        };
    }
    | تعليمة_ذراع_أربعة_وستون.تحويل_صحيح_ذراع(التحويل) -> {
        طابق ابحث_تعيين_سجل(التعيينات, التحويل.الوجهة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(التحويل.الوجهة); }
        | اختيار.بعض(و) -> {
            طابق ابحث_تعيين_سجل(التعيينات, التحويل.المصدر) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(التحويل.المصدر); }
            | اختيار.بعض(م) -> {
                دع خ: تحويل_صحيح_ذراع_أربعة_وستون_مخصص = {
                    العملية: التحويل.العملية, الوجهة: و, المصدر: م,
                    بتات_المصدر: التحويل.بتات_المصدر, بتات_الوجهة: التحويل.بتات_الوجهة,
                    المصدر_موقع: التحويل.المصدر_موقع,
                    الوجهة_موقع: التحويل.الوجهة_موقع
                };
                أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(تعليمة_ذراع_أربعة_وستون_مخصصة.تحويل_صحيح(خ));
            };
        };
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الحجز.الوجهة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الحجز.الوجهة); }
        | اختيار.بعض(و) -> {
            دع الإزاحة: متغير اختيار غير_موقع = اختيار.لا_شيء();
            طابق ابحث_موضع_محلي_ذراع(الإطار, الحجز.الهوية) مع
            | اختيار.بعض(الموضع) -> { الإزاحة := اختيار.بعض(الموضع.إزاحة_بايت); }
            | اختيار.لا_شيء -> { };
            دع م: حجز_إطار_ذراع_أربعة_وستون_مخصص = {
                الوجهة: و, الهوية: الحجز.الهوية, إزاحة_بايت: الإزاحة,
