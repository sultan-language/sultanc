                تعليمة_ذراع_أربعة_وستون_مخصصة.عنوان_دالة(السجل, الدالة)
            );
        };
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_عام_ذراع(الوجهة, العام, مستورد) -> {
