            | اختياري.موجود(الأساس) -> {
                دع عنوان_مخصص: عنوان_ذاكرة_ذراع_أربعة_وستون_مخصص = {
                    الأساس: الأساس,
                    إزاحة_بايت: العنوان.إزاحة_بايت
                };
                دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة =
                    تعليمة_ذراع_أربعة_وستون_مخصصة.تخزين_أساس_إزاحة(م, عنوان_مخصص, الحجم);
                أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
            };
        };
    };
}

عرف حقيقة_تخصيص_تحتاج_انسكاب_ذراع(
    الحقيقة: &حقيقة_تعليمة_تخصيص,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحقيقة).الاستخدامات) مثل طبيعي)) {
        طابق ابحث_موضع_انسكاب_ذراع(الإطار, (*الحقيقة).الاستخدامات[ف].السجل) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الحقيقة).التعريفات) مثل طبيعي)) {
        طابق ابحث_موضع_انسكاب_ذراع(الإطار, (*الحقيقة).التعريفات[ف].السجل) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف جهز_طلب_انسكاب_ذراع(
    الطلب: &طلب_سجل_تخصيص,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    سجلات_العمل: &متجه معرف_سجل_فعلي,
    التعيينات: &متغير متجه تعيين_سجل,
    قبل: &متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة,
    بعد: &متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة,
    التالي: &متغير طبيعي,
    استخدام: منطقي,
    تعريف: منطقي
): اختياري معرف_سجل_افتراضي {
    دع السجل_الافتراضي: معرف_سجل_افتراضي = (*الطلب).السجل;
    // The per-instruction table holds only this instruction's registers: the
    // planned ones are copied in, spilled ones receive scratch registers.
    طابق ابحث_تعيين_سجل(&(*الخطة).التعيينات, السجل_الافتراضي) مع
    | اختياري.موجود(الفعلي) -> {
        طابق ابحث_تعيين_سجل(التعيينات, السجل_الافتراضي) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            دع التعيين: تعيين_سجل = { الافتراضي: السجل_الافتراضي, الفعلي: الفعلي };
            أدخل_تعيين_سجل_مرتب(التعيينات, التعيين);
        };
        أرجع اختياري.لا_شيء();
    }
    | اختياري.لا_شيء -> { };
    طابق ابحث_موضع_انسكاب_ذراع(الإطار, السجل_الافتراضي) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(السجل_الافتراضي); }
    | اختياري.موجود(الموقع) -> {
        دع سجل_العمل: متغير اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
        طابق ابحث_تعيين_سجل(التعيينات, السجل_الافتراضي) مع
        | اختياري.موجود(السجل) -> { سجل_العمل := اختياري.موجود(السجل); }
        | اختياري.لا_شيء -> {
            طابق (*الطلب).ثابت مع
            | اختياري.موجود(الثابت) -> {
                دع تعيين: تعيين_سجل = { الافتراضي: السجل_الافتراضي, الفعلي: الثابت };
                أدخل_تعيين_سجل_مرتب(التعيينات, تعيين);
                سجل_العمل := اختياري.موجود(الثابت);
            }
            | اختياري.لا_شيء -> {
                دع مؤشر: طبيعي = *التالي;
                لو (مؤشر >= (الطول(*سجلات_العمل) مثل طبيعي)) {
                    أرجع اختياري.موجود(السجل_الافتراضي);
                };
                دع السجل: معرف_سجل_فعلي = (*سجلات_العمل)[مؤشر];
                دع تعيين: تعيين_سجل = { الافتراضي: السجل_الافتراضي, الفعلي: السجل };
                أدخل_تعيين_سجل_مرتب(التعيينات, تعيين);
                *التالي := مؤشر + 1;
                سجل_العمل := اختياري.موجود(السجل);
            };
        };
        طابق سجل_العمل مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(السجل_الافتراضي); }
        | اختياري.موجود(السجل) -> {
            لو (استخدام) {
                ألحق(*قبل, تعليمة_ذراع_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(السجل, الموقع));
            };
            لو (تعريف) {
                ألحق(*بعد, تعليمة_ذراع_أربعة_وستون_مخصصة.تخزين_انسكاب(الموقع, السجل));
            };
        };
        أرجع اختياري.لا_شيء();
    };
}

عرف خصص_تعليمة_ذراع_بخطة_انسكاب(
    التعليمة: &تعليمة_ذراع_أربعة_وستون,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    الهدف: &واصف_هدف,
    الناتج: &متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة
): نتيجة_دفعة_تعليمات_ذراع {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.فرع_جدولي_ذراع(المميز, الأهداف, الافتراضي, الأدنى) -> {
        طابق حدد_موقع_قيمة_ذراع(الخطة, الإطار, المميز) مع
        | نتيجة_موقع_قيمة_ذراع.مفقود(السجل) -> { أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل); }
        | نتيجة_موقع_قيمة_ذراع.نجح(الموقع) -> {
            طابق الموقع مع
            | موقع_قيمة_ذراع_أربعة_وستون_مخصص.سجل(السجل) -> {
                ألحق(*الناتج, تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_جدولي(السجل, انسخ_مملوكا_متجه_معرف_كتلة_منتقاة(&الأهداف), الافتراضي, الأدنى));
            }
            | موقع_قيمة_ذراع_أربعة_وستون_مخصص.انسكاب(الموضع) -> {
                دع العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_ذراع_للهدف(الهدف);
                لو ((الطول(العمل) مثل طبيعي) == 0) { أرجع نتيجة_دفعة_تعليمات_ذراع.حالة_انسكاب_غير_مدعومة(المميز); };
                دع السجل: معرف_سجل_فعلي = العمل[0];
                ألحق(*الناتج, تعليمة_ذراع_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(السجل, الموضع));
                ألحق(*الناتج, تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_جدولي(السجل, انسخ_مملوكا_متجه_معرف_كتلة_منتقاة(&الأهداف), الافتراضي, الأدنى));
            };
            أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت();
        };
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(النقلات) -> {
        طابق خصص_نقلات_حافة_ذراع_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل);
        }
        | نتيجة_نقلات_ذراع_مخصصة.نجحت(المخصصة) -> {
            ألحق(
                *الناتج,
                تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_مع_نقلات(المخصصة)
            );
            أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت();
        };
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(الشرط, النقلات) -> {
        طابق خصص_نقلات_حافة_ذراع_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل);
        }
        | نتيجة_نقلات_ذراع_مخصصة.نجحت(المخصصة) -> {
            ألحق(
                *الناتج,
                تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_شرطي_مع_نقلات(الشرط, المخصصة)
            );
            أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت();
        };
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_برابط_ذراع_مباشر(النداء) -> {
        طابق خصص_نداء_ذراع_بخطة(&النداء, الخطة, الإطار) مع
        | نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل);
        }
        | نتيجة_تعليمة_ذراع_مخصصة.نجحت(المخصصة) -> {
            ألحق(*الناتج, المخصصة);
            أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت();
        };
    }
    | _ -> { };
    دع الحقيقة: حقيقة_تعليمة_تخصيص = حقيقة_تخصيص_تعليمة_ذراع(التعليمة, الهدف, 0);
    // Without a spilled operand the canonical plan is used directly; copying the
    // whole function's assignments per instruction made memory quadratic.
    لو (!حقيقة_تخصيص_تحتاج_انسكاب_ذراع(&الحقيقة, الإطار)) {
        طابق خصص_تعليمة_ذراع(التعليمة, &(*الخطة).التعيينات, الإطار) مع
        | نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل);
        }
        | نتيجة_تعليمة_ذراع_مخصصة.نجحت(المخصصة) -> {
            ألحق(*الناتج, المخصصة);
            أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت();
        };
    };
    دع التعيينات: متغير متجه تعيين_سجل = [];
    دع قبل: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
    دع بعد: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
    دع سجلات_العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_ذراع_للهدف(الهدف);
    دع التالي: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحقيقة.الاستخدامات) مثل طبيعي)) {
        طابق جهز_طلب_انسكاب_ذراع(
            &الحقيقة.الاستخدامات[ف],
            الخطة,
            الإطار,
            &سجلات_العمل,
            &متغير التعيينات,
            &متغير قبل,
            &متغير بعد,
            &متغير التالي,
            صواب,
            خطأ
        ) مع
        | اختياري.موجود(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.حالة_انسكاب_غير_مدعومة(السجل);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول(الحقيقة.التعريفات) مثل طبيعي)) {
        طابق جهز_طلب_انسكاب_ذراع(
            &الحقيقة.التعريفات[ت],
            الخطة,
            الإطار,
            &سجلات_العمل,
            &متغير التعيينات,
            &متغير قبل,
            &متغير بعد,
            &متغير التالي,
            خطأ,
            صواب
        ) مع
        | اختياري.موجود(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.حالة_انسكاب_غير_مدعومة(السجل);
        }
        | اختياري.لا_شيء -> { };
        ت := ت + 1;
    }
    لو (التالي > 0 && !الحقيقة.قابل_للانسكاب) {
        دع السجل: معرف_سجل_افتراضي = { القيمة: 0 };
        أرجع نتيجة_دفعة_تعليمات_ذراع.حالة_انسكاب_غير_مدعومة(السجل);
    };
    طابق خصص_تعليمة_ذراع(التعليمة, &التعيينات, الإطار) مع
    | نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
        أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل);
    }
    | نتيجة_تعليمة_ذراع_مخصصة.نجحت(المخصصة) -> {
        دع ق: متغير طبيعي = 0;
        طالما (ق < (الطول(قبل) مثل طبيعي)) {
            دع مرجع_قبل: &تعليمة_ذراع_أربعة_وستون_مخصصة = &قبل[ق];
            دع تعليمة_قبل: تعليمة_ذراع_أربعة_وستون_مخصصة = انسخ_مملوكا_تعليمة_ذراع_أربعة_وستون_مخصصة(مرجع_قبل);
            ألحق(*الناتج, تعليمة_قبل);
            ق := ق + 1;
        }
        ألحق(*الناتج, المخصصة);
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(بعد) مثل طبيعي)) {
            دع مرجع_بعد: &تعليمة_ذراع_أربعة_وستون_مخصصة = &بعد[ب];
            دع تعليمة_بعد: تعليمة_ذراع_أربعة_وستون_مخصصة = انسخ_مملوكا_تعليمة_ذراع_أربعة_وستون_مخصصة(مرجع_بعد);
            ألحق(*الناتج, تعليمة_بعد);
            ب := ب + 1;
        }
        أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت();
    };
}

عرف خصص_كتلة_ذراع_بخطة_انسكاب(
    الكتلة: &كتلة_ذراع_أربعة_وستون_منتقاة,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    الهدف: &واصف_هدف
): نتيجة_كتلة_ذراع_مخصصة {
    دع ك: كتلة_ذراع_أربعة_وستون_منتقاة = *الكتلة;
    دع التعليمات: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
    دع أصول_التعليمات: متغير متجه مدى_أصل_تعليمات = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ك.التعليمات) مثل طبيعي)) {
        دع بداية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
        طابق خصص_تعليمة_ذراع_بخطة_انسكاب(&ك.التعليمات[ف], الخطة, الإطار, الهدف, &متغير التعليمات) مع
        | نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_كتلة_ذراع_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة_دفعة_تعليمات_ذراع.حالة_انسكاب_غير_مدعومة(السجل) -> {
            أرجع نتيجة_كتلة_ذراع_مخصصة.حالة_انسكاب_غير_مدعومة(السجل);
        }
        | نتيجة_دفعة_تعليمات_ذراع.نجحت -> { };
        دع نهاية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
        طابق مرجع_تصحيح_تعليمة_آلة_عند(&ك.أصول_التعليمات, ف) مع
        | اختياري.موجود(مرجع_التصحيح) -> {
            لو (نهاية_الأصل > بداية_الأصل) {
                دع المدى: مدى_أصل_تعليمات = {
                    البداية: بداية_الأصل,
                    النهاية: نهاية_الأصل,
                    الأصل: مرجع_التصحيح.الأصل,
                    موقع_التصحيح: مرجع_التصحيح.موقع_التصحيح,
                    نطاق_التصحيح: مرجع_التصحيح.نطاق_التصحيح
                };
                ألحق(أصول_التعليمات, المدى);
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع مرجع_الرأس: &رأس_كتلة_منتقاة = &ك.الرأس;
    دع الرأس: رأس_كتلة_منتقاة = انسخ_مملوكا_رأس_كتلة_منتقاة(مرجع_الرأس);
    دع الناتج: كتلة_ذراع_أربعة_وستون_مخصصة = {
        الرأس: الرأس,
        التعليمات: التعليمات,
        أصول_التعليمات: أصول_التعليمات
    };
    أرجع نتيجة_كتلة_ذراع_مخصصة.نجحت(الناتج);
}

عرف خصص_كتلة_ذراع(
    الكتلة: &كتلة_ذراع_أربعة_وستون_منتقاة,
    التعيينات: &متجه تعيين_سجل,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون
): نتيجة_كتلة_ذراع_مخصصة {
    دع ك: كتلة_ذراع_أربعة_وستون_منتقاة = *الكتلة;
    دع التعليمات: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
    دع أصول_التعليمات: متغير متجه مدى_أصل_تعليمات = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ك.التعليمات) مثل طبيعي)) {
        دع بداية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
        طابق خصص_تعليمة_ذراع(&ك.التعليمات[ف], التعيينات, الإطار) مع
        | نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_كتلة_ذراع_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة_تعليمة_ذراع_مخصصة.نجحت(التعليمة) -> {
            ألحق(التعليمات, التعليمة);
        };
        دع نهاية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
        طابق مرجع_تصحيح_تعليمة_آلة_عند(&ك.أصول_التعليمات, ف) مع
        | اختياري.موجود(مرجع_التصحيح) -> {
            لو (نهاية_الأصل > بداية_الأصل) {
                دع المدى: مدى_أصل_تعليمات = {
                    البداية: بداية_الأصل,
                    النهاية: نهاية_الأصل,
                    الأصل: مرجع_التصحيح.الأصل,
                    موقع_التصحيح: مرجع_التصحيح.موقع_التصحيح,
                    نطاق_التصحيح: مرجع_التصحيح.نطاق_التصحيح
                };
                ألحق(أصول_التعليمات, المدى);
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع مرجع_الرأس: &رأس_كتلة_منتقاة = &ك.الرأس;
    دع الرأس: رأس_كتلة_منتقاة = انسخ_مملوكا_رأس_كتلة_منتقاة(مرجع_الرأس);
    دع الناتج: كتلة_ذراع_أربعة_وستون_مخصصة = {
        الرأس: الرأس,
        التعليمات: التعليمات,
        أصول_التعليمات: أصول_التعليمات
    };
    أرجع نتيجة_كتلة_ذراع_مخصصة.نجحت(الناتج);
}

عام عرف خصص_دالة_ذراع_أربعة_وستون(
    الدالة_المنتقاة: &دالة_ذراع_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): نتيجة_تخصيص_دالة_ذراع {
    دع و: واصف_هدف = *الهدف;
    طابق و.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | _ -> { أرجع نتيجة_تخصيص_دالة_ذراع.هدف_غير_صالح(و.المعرف); };

    دع الدالة: دالة_ذراع_أربعة_وستون_منتقاة = *الدالة_المنتقاة;
    دع المسألة: مسألة_تخصيص = ابن_مسألة_تخصيص_دالة_ذراع(&الدالة, الهدف);
    طابق خصص_السجلات_مع_انسكاب(&المسألة) مع
    | نتيجة_تخصيص_مع_انسكاب.فشل_قيود(السجل) -> {
        أرجع نتيجة_تخصيص_دالة_ذراع.فشل_قيود(السجل);
    }
    | نتيجة_تخصيص_مع_انسكاب.مكتمل(الخطة) -> {
        طابق ابن_إطار_انسكاب_ذراع(
            &الخطة.السجلات_المسكوبة,
            &الخطة.التعيينات,
            &الدالة,
            الهدف
        ) مع
        | نتيجة_إطار_انسكاب_ذراع.سياسة_غير_متاحة -> {
            أرجع نتيجة_تخصيص_دالة_ذراع.سياسة_إطار_غير_متاحة(و.المعرف);
        }
        | نتيجة_إطار_انسكاب_ذراع.نجح(الإطار) -> {
            دع الكتل: متغير متجه كتلة_ذراع_أربعة_وستون_مخصصة = [];
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول(الدالة.الكتل) مثل طبيعي)) {
                طابق خصص_كتلة_ذراع_بخطة_انسكاب(
                    &الدالة.الكتل[ك],
                    &الخطة,
                    &الإطار,
                    الهدف
                ) مع
                | نتيجة_كتلة_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
                    أرجع نتيجة_تخصيص_دالة_ذراع.فشل_قيود(السجل);
                }
                | نتيجة_كتلة_ذراع_مخصصة.حالة_انسكاب_غير_مدعومة(السجل) -> {
                    أرجع نتيجة_تخصيص_دالة_ذراع.حالة_انسكاب_غير_مدعومة(السجل);
                }
                | نتيجة_كتلة_ذراع_مخصصة.نجحت(الكتلة) -> { ألحق(الكتل, الكتلة); };
                ك := ك + 1;
            }
            دع مرجع_رأس_الدالة: &رأس_دالة_منتقاة = &الدالة.الرأس;
            دع رأس_الدالة: رأس_دالة_منتقاة = *مرجع_رأس_الدالة;
            دع مرجع_التعيينات: &متجه تعيين_سجل = &الخطة.التعيينات;
            دع التعيينات: متجه تعيين_سجل = انسخ_مملوكا_متجه_تعيين_سجل(مرجع_التعيينات);
            دع الدالة_المخصصة: دالة_ذراع_أربعة_وستون_مخصصة = {
                الرأس: رأس_الدالة,
                الكتل: الكتل,
                التعيينات: التعيينات,
                إطار_الانسكاب: الإطار
            };
            أرجع نتيجة_تخصيص_دالة_ذراع.نجحت(الدالة_المخصصة);
        };
    };
}

عام عرف خصص_شفرة_ذراع_أربعة_وستون(
    الشفرة: &شفرة_ذراع_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): نتيجة_بناء_ذراع_مخصص {
    دع ش: شفرة_ذراع_أربعة_وستون_منتقاة = *الشفرة;
    دع و: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(ش.الرأس.الهدف, و.المعرف)) {
        أرجع نتيجة_بناء_ذراع_مخصص.هدف_غير_صالح(ش.الرأس.الهدف);
    };
    دع الدوال: متغير متجه دالة_ذراع_أربعة_وستون_مخصصة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ش.الدوال) مثل طبيعي)) {
        طابق خصص_دالة_ذراع_أربعة_وستون(&ش.الدوال[ف], الهدف) مع
        | نتيجة_تخصيص_دالة_ذراع.فشل_قيود(السجل) -> {
            أرجع نتيجة_بناء_ذراع_مخصص.فشل_قيود(السجل);
        }
        | نتيجة_تخصيص_دالة_ذراع.حالة_انسكاب_غير_مدعومة(السجل) -> {
            أرجع نتيجة_بناء_ذراع_مخصص.حالة_انسكاب_غير_مدعومة(السجل);
        }
        | نتيجة_تخصيص_دالة_ذراع.سياسة_إطار_غير_متاحة(معرف_الهدف) -> {
            أرجع نتيجة_بناء_ذراع_مخصص.سياسة_إطار_غير_متاحة(معرف_الهدف);
        }
        | نتيجة_تخصيص_دالة_ذراع.هدف_غير_صالح(معرف_الهدف) -> {
            أرجع نتيجة_بناء_ذراع_مخصص.هدف_غير_صالح(معرف_الهدف);
        }
        | نتيجة_تخصيص_دالة_ذراع.نجحت(الدالة) -> { ألحق(الدوال, الدالة); };
        ف := ف + 1;
    }
    دع مرجع_رأس_البرنامج: &رأس_برنامج_منتقى = &ش.الرأس;
    دع رأس_البرنامج: رأس_برنامج_منتقى = *مرجع_رأس_البرنامج;
    دع الناتج: شفرة_ذراع_أربعة_وستون_مخصصة = {
        الرأس: رأس_البرنامج,
        الدوال: الدوال
    };
    أرجع نتيجة_بناء_ذراع_مخصص.نجح(الناتج);
}
