        | نتيجة_نقلات_ذراع_مخصصة.نجحت(المخصصة) -> {
            دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة =
                تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_شرطي_مع_نقلات(الشرط, المخصصة);
            أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_برابط_ذراع_مباشر(النداء) -> {
        أرجع خصص_نداء_ذراع(&النداء, التعيينات);
    }
    | تعليمة_ذراع_أربعة_وستون.عودة_ذراع -> {
        دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة = تعليمة_ذراع_أربعة_وستون_مخصصة.عودة();
        أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
    }
    | تعليمة_ذراع_أربعة_وستون.عودة_ذراع_بقيمة(قيمة_العودة) -> {
        طابق خصص_قيمة_واجهة_ذراع(&قيمة_العودة.القيمة, التعيينات) مع
        | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة.نجح(القيمة) -> {
            دع عنوان_غير_مباشر: متغير اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
            طابق قيمة_العودة.عنوان_ناتج_غير_مباشر مع
            | اختيار.بعض(العنوان) -> {
                طابق ابحث_تعيين_سجل(التعيينات, العنوان) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(العنوان); }
                | اختيار.بعض(الفعلي) -> { عنوان_غير_مباشر := اختيار.بعض(الفعلي); };
            }
            | اختيار.لا_شيء -> { };
            دع م: ناتج_عودة_ذراع_أربعة_وستون_مخصص = {
                القيمة: القيمة, عنوان_ناتج_غير_مباشر: عنوان_غير_مباشر
            };
            أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(تعليمة_ذراع_أربعة_وستون_مخصصة.عودة_بقيمة(م));
        };
    }
    | تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(الوجهة, العنوان, الحجم, بإشارة) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة);
        }
        | اختيار.بعض(و) -> {
            طابق ابحث_تعيين_سجل(التعيينات, العنوان.الأساس) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(العنوان.الأساس);
            }
            | اختيار.بعض(الأساس) -> {
                دع عنوان_مخصص: عنوان_ذاكرة_ذراع_أربعة_وستون_مخصص = {
                    الأساس: الأساس,
                    إزاحة_بايت: العنوان.إزاحة_بايت
                };
                دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة =
                    تعليمة_ذراع_أربعة_وستون_مخصصة.تحميل_أساس_إزاحة(و, عنوان_مخصص, الحجم, بإشارة);
                أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
            };
        };
    }
    | تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(المصدر, العنوان, الحجم) -> {
        طابق ابحث_تعيين_سجل(التعيينات, المصدر) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(المصدر);
        }
        | اختيار.بعض(م) -> {
            طابق ابحث_تعيين_سجل(التعيينات, العنوان.الأساس) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(العنوان.الأساس);
            }
            | اختيار.بعض(الأساس) -> {
                دع عنوان_مخصص: عنوان_ذاكرة_ذراع_أربعة_وستون_مخصص = {
                    الأساس: الأساس,
                    إزاحة_بايت: العنوان.إزاحة_بايت
                };
                دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة =
                    تعليمة_ذراع_أربعة_وستون_مخصصة.تخزين_أساس_إزاحة(م, عنوان_مخصص, الحجم);
                أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
            };
        };
    };
}

عرف جهز_طلب_انسكاب_ذراع(
    الطلب: &طلب_سجل_تخصيص,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    سجلات_العمل: &متجه معرف_سجل_فعلي,
    التعيينات: &متغير متجه تعيين_سجل,
    قبل: &متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة,
    بعد: &متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة,
    التالي: &متغير غير_موقع,
    استخدام: منطقي,
    تعريف: منطقي
): اختيار معرف_سجل_افتراضي {
    دع ط: طلب_سجل_تخصيص = *الطلب;
    دع خ: خطة_تخصيص_مع_انسكاب = *الخطة;
    دع عمل: متجه معرف_سجل_فعلي = *سجلات_العمل;
    طابق ابحث_تعيين_سجل(&خ.التعيينات, ط.السجل) مع
    | اختيار.بعض(_) -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.لا_شيء -> { };
    طابق ابحث_موضع_انسكاب_ذراع(الإطار, ط.السجل) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(ط.السجل);
    }
    | اختيار.بعض(الموقع) -> {
        دع حالة_التعيينات: متغير متجه تعيين_سجل = *التعيينات;
        دع حالة_قبل: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = *قبل;
        دع حالة_بعد: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = *بعد;
        دع سجل_العمل: متغير اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
        طابق ابحث_تعيين_سجل(&حالة_التعيينات, ط.السجل) مع
        | اختيار.بعض(السجل) -> {
            سجل_العمل := اختيار.بعض(السجل);
        }
        | اختيار.لا_شيء -> {
            طابق ط.ثابت مع
            | اختيار.بعض(الثابت) -> {
                // الطلب الثابت (معامل/ناتج ABI) يجب أن يعاد تحميله أو تخزينه عبر سجل ABI نفسه.
                دع تعيين: تعيين_سجل = {
                    الافتراضي: ط.السجل,
                    الفعلي: الثابت
                };
                أدخل_تعيين_سجل_مرتب(&متغير حالة_التعيينات, تعيين);
                سجل_العمل := اختيار.بعض(الثابت);
            }
            | اختيار.لا_شيء -> {
                دع مؤشر: غير_موقع = *التالي;
                لو (مؤشر >= (الطول(عمل) مثل غير_موقع)) {
                    أرجع اختيار.بعض(ط.السجل);
                };
                دع السجل: معرف_سجل_فعلي = عمل[مؤشر];
                دع تعيين: تعيين_سجل = {
                    الافتراضي: ط.السجل,
                    الفعلي: السجل
                };
                أدخل_تعيين_سجل_مرتب(&متغير حالة_التعيينات, تعيين);
                *التالي := مؤشر + 1;
                سجل_العمل := اختيار.بعض(السجل);
            };
        };
        طابق سجل_العمل مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(ط.السجل);
        }
        | اختيار.بعض(السجل) -> {
            لو (استخدام) {
                ألحق(
                    حالة_قبل,
                    تعليمة_ذراع_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(السجل, الموقع)
                );
            };
            لو (تعريف) {
                ألحق(
                    حالة_بعد,
                    تعليمة_ذراع_أربعة_وستون_مخصصة.تخزين_انسكاب(الموقع, السجل)
                );
            };
        };
        *التعيينات := حالة_التعيينات;
        *قبل := حالة_قبل;
        *بعد := حالة_بعد;
        أرجع اختيار.لا_شيء();
    };
}

عرف خصص_تعليمة_ذراع_بخطة_انسكاب(
    التعليمة: &تعليمة_ذراع_أربعة_وستون,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    الهدف: &واصف_هدف
): نتيجة_دفعة_تعليمات_ذراع {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(النقلات) -> {
        طابق خصص_نقلات_حافة_ذراع_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل);
        }
        | نتيجة_نقلات_ذراع_مخصصة.نجحت(المخصصة) -> {
            دع الناتج: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
            ألحق(
                الناتج,
                تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_مع_نقلات(المخصصة)
            );
            أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت(الناتج);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(الشرط, النقلات) -> {
        طابق خصص_نقلات_حافة_ذراع_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل);
        }
        | نتيجة_نقلات_ذراع_مخصصة.نجحت(المخصصة) -> {
            دع الناتج: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
            ألحق(
                الناتج,
                تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_شرطي_مع_نقلات(الشرط, المخصصة)
            );
            أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت(الناتج);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_برابط_ذراع_مباشر(النداء) -> {
        طابق خصص_نداء_ذراع_بخطة(&النداء, الخطة, الإطار) مع
        | نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل);
        }
        | نتيجة_تعليمة_ذراع_مخصصة.نجحت(المخصصة) -> {
            دع الناتج: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
            ألحق(الناتج, المخصصة);
            أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت(الناتج);
        };
    }
    | _ -> { };
    دع خ: خطة_تخصيص_مع_انسكاب = *الخطة;
    دع مرجع_التعيينات: &متجه تعيين_سجل = &خ.التعيينات;
    دع التعيينات: متغير متجه تعيين_سجل = انسخ_تعيينات_سجلات(مرجع_التعيينات);
    دع قبل: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
    دع بعد: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
    دع سجلات_العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_ذراع_للهدف(الهدف);
    دع التالي: متغير غير_موقع = 0;
    دع الحقيقة: حقيقة_تعليمة_تخصيص = حقيقة_تخصيص_تعليمة_ذراع(التعليمة, الهدف, 0);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحقيقة.الاستخدامات) مثل غير_موقع)) {
        طابق جهز_طلب_انسكاب_ذراع(
            &الحقيقة.الاستخدامات[ف],
            الخطة,
            الإطار,
            &سجلات_العمل,
            &متغير التعيينات,
            &متغير قبل,
            &متغير بعد,
            &متغير التالي,
            صواب,
            خطأ
        ) مع
        | اختيار.بعض(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.حالة_انسكاب_غير_مدعومة(السجل);
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    دع ت: متغير غير_موقع = 0;
    بينما (ت < (الطول(الحقيقة.التعريفات) مثل غير_موقع)) {
        طابق جهز_طلب_انسكاب_ذراع(
            &الحقيقة.التعريفات[ت],
            الخطة,
            الإطار,
            &سجلات_العمل,
            &متغير التعيينات,
            &متغير قبل,
            &متغير بعد,
            &متغير التالي,
            خطأ,
            صواب
        ) مع
        | اختيار.بعض(السجل) -> {
            أرجع نتيجة_دفعة_تعليمات_ذراع.حالة_انسكاب_غير_مدعومة(السجل);
        }
        | اختيار.لا_شيء -> { };
        ت := ت + 1;
    }
    لو (التالي > 0 && !الحقيقة.قابل_للانسكاب) {
        دع السجل: معرف_سجل_افتراضي = { القيمة: 0 };
        أرجع نتيجة_دفعة_تعليمات_ذراع.حالة_انسكاب_غير_مدعومة(السجل);
    };
    طابق خصص_تعليمة_ذراع(التعليمة, &التعيينات, الإطار) مع
    | نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
        أرجع نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل);
    }
    | نتيجة_تعليمة_ذراع_مخصصة.نجحت(المخصصة) -> {
        دع الناتج: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = قبل;
        ألحق(الناتج, المخصصة);
        دع ب: متغير غير_موقع = 0;
        بينما (ب < (الطول(بعد) مثل غير_موقع)) {
            دع مرجع_بعد: &تعليمة_ذراع_أربعة_وستون_مخصصة = &بعد[ب];
            دع تعليمة_بعد: تعليمة_ذراع_أربعة_وستون_مخصصة = *مرجع_بعد;
            ألحق(الناتج, تعليمة_بعد);
            ب := ب + 1;
        }
        أرجع نتيجة_دفعة_تعليمات_ذراع.نجحت(الناتج);
    };
}

عرف خصص_كتلة_ذراع_بخطة_انسكاب(
    الكتلة: &كتلة_ذراع_أربعة_وستون_منتقاة,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    الهدف: &واصف_هدف
): نتيجة_كتلة_ذراع_مخصصة {
    دع ك: كتلة_ذراع_أربعة_وستون_منتقاة = *الكتلة;
    دع التعليمات: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ك.التعليمات) مثل غير_موقع)) {
        طابق خصص_تعليمة_ذراع_بخطة_انسكاب(&ك.التعليمات[ف], الخطة, الإطار, الهدف) مع
        | نتيجة_دفعة_تعليمات_ذراع.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_كتلة_ذراع_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة_دفعة_تعليمات_ذراع.حالة_انسكاب_غير_مدعومة(السجل) -> {
            أرجع نتيجة_كتلة_ذراع_مخصصة.حالة_انسكاب_غير_مدعومة(السجل);
        }
        | نتيجة_دفعة_تعليمات_ذراع.نجحت(الدفعة) -> {
            دع ت: متغير غير_موقع = 0;
            بينما (ت < (الطول(الدفعة) مثل غير_موقع)) {
                دع مرجع_الدفعة: &تعليمة_ذراع_أربعة_وستون_مخصصة = &الدفعة[ت];
                دع تعليمة_الدفعة: تعليمة_ذراع_أربعة_وستون_مخصصة = *مرجع_الدفعة;
                ألحق(التعليمات, تعليمة_الدفعة);
                ت := ت + 1;
            }
        };
        ف := ف + 1;
    }
    دع مرجع_الرأس: &رأس_كتلة_منتقاة = &ك.الرأس;
    دع الرأس: رأس_كتلة_منتقاة = *مرجع_الرأس;
    دع الناتج: كتلة_ذراع_أربعة_وستون_مخصصة = {
        الرأس: الرأس,
        التعليمات: التعليمات
    };
    أرجع نتيجة_كتلة_ذراع_مخصصة.نجحت(الناتج);
}

عرف خصص_كتلة_ذراع(
    الكتلة: &كتلة_ذراع_أربعة_وستون_منتقاة,
    التعيينات: &متجه تعيين_سجل,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون
): نتيجة_كتلة_ذراع_مخصصة {
    دع ك: كتلة_ذراع_أربعة_وستون_منتقاة = *الكتلة;
    دع التعليمات: متغير متجه تعليمة_ذراع_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ك.التعليمات) مثل غير_موقع)) {
        طابق خصص_تعليمة_ذراع(&ك.التعليمات[ف], التعيينات, الإطار) مع
        | نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_كتلة_ذراع_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة_تعليمة_ذراع_مخصصة.نجحت(التعليمة) -> {
            ألحق(التعليمات, التعليمة);
        };
        ف := ف + 1;
    }
    دع مرجع_الرأس: &رأس_كتلة_منتقاة = &ك.الرأس;
    دع الرأس: رأس_كتلة_منتقاة = *مرجع_الرأس;
    دع الناتج: كتلة_ذراع_أربعة_وستون_مخصصة = {
        الرأس: الرأس,
        التعليمات: التعليمات
    };
    أرجع نتيجة_كتلة_ذراع_مخصصة.نجحت(الناتج);
}

عام عرف خصص_دالة_ذراع_أربعة_وستون(
    الدالة_المنتقاة: &دالة_ذراع_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): نتيجة_تخصيص_دالة_ذراع {
    دع و: واصف_هدف = *الهدف;
    طابق و.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | _ -> { أرجع نتيجة_تخصيص_دالة_ذراع.هدف_غير_صالح(و.المعرف); };

    دع الدالة: دالة_ذراع_أربعة_وستون_منتقاة = *الدالة_المنتقاة;
    دع المسألة: مسألة_تخصيص = ابن_مسألة_تخصيص_دالة_ذراع(&الدالة, الهدف);
    طابق خصص_السجلات_مع_انسكاب(&المسألة) مع
    | نتيجة_تخصيص_مع_انسكاب.فشل_قيود(السجل) -> {
        أرجع نتيجة_تخصيص_دالة_ذراع.فشل_قيود(السجل);
    }
    | نتيجة_تخصيص_مع_انسكاب.مكتمل(الخطة) -> {
        طابق ابن_إطار_انسكاب_ذراع(
            &الخطة.السجلات_المسكوبة,
            &الخطة.التعيينات,
            &الدالة,
            الهدف
        ) مع
        | نتيجة_إطار_انسكاب_ذراع.سياسة_غير_متاحة -> {
            أرجع نتيجة_تخصيص_دالة_ذراع.سياسة_إطار_غير_متاحة(و.المعرف);
        }
        | نتيجة_إطار_انسكاب_ذراع.نجح(الإطار) -> {
            دع الكتل: متغير متجه كتلة_ذراع_أربعة_وستون_مخصصة = [];
            دع ك: متغير غير_موقع = 0;
            بينما (ك < (الطول(الدالة.الكتل) مثل غير_موقع)) {
                طابق خصص_كتلة_ذراع_بخطة_انسكاب(
                    &الدالة.الكتل[ك],
                    &الخطة,
                    &الإطار,
                    الهدف
                ) مع
                | نتيجة_كتلة_ذراع_مخصصة.سجل_غير_مخصص(السجل) -> {
                    أرجع نتيجة_تخصيص_دالة_ذراع.فشل_قيود(السجل);
                }
                | نتيجة_كتلة_ذراع_مخصصة.حالة_انسكاب_غير_مدعومة(السجل) -> {
                    أرجع نتيجة_تخصيص_دالة_ذراع.حالة_انسكاب_غير_مدعومة(السجل);
                }
                | نتيجة_كتلة_ذراع_مخصصة.نجحت(الكتلة) -> { ألحق(الكتل, الكتلة); };
                ك := ك + 1;
            }
            دع مرجع_رأس_الدالة: &رأس_دالة_منتقاة = &الدالة.الرأس;
            دع رأس_الدالة: رأس_دالة_منتقاة = *مرجع_رأس_الدالة;
            دع مرجع_التعيينات: &متجه تعيين_سجل = &الخطة.التعيينات;
            دع التعيينات: متجه تعيين_سجل = *مرجع_التعيينات;
            دع الدالة_المخصصة: دالة_ذراع_أربعة_وستون_مخصصة = {
                الرأس: رأس_الدالة,
                الكتل: الكتل,
                التعيينات: التعيينات,
                إطار_الانسكاب: الإطار
            };
            أرجع نتيجة_تخصيص_دالة_ذراع.نجحت(الدالة_المخصصة);
        };
    };
}

عام عرف خصص_شفرة_ذراع_أربعة_وستون(
    الشفرة: &شفرة_ذراع_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): نتيجة_بناء_ذراع_مخصص {
    دع ش: شفرة_ذراع_أربعة_وستون_منتقاة = *الشفرة;
    دع و: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(ش.الرأس.الهدف, و.المعرف)) {
        أرجع نتيجة_بناء_ذراع_مخصص.هدف_غير_صالح(ش.الرأس.الهدف);
    };
    دع الدوال: متغير متجه دالة_ذراع_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ش.الدوال) مثل غير_موقع)) {
        طابق خصص_دالة_ذراع_أربعة_وستون(&ش.الدوال[ف], الهدف) مع
        | نتيجة_تخصيص_دالة_ذراع.فشل_قيود(السجل) -> {
            أرجع نتيجة_بناء_ذراع_مخصص.فشل_قيود(السجل);
        }
        | نتيجة_تخصيص_دالة_ذراع.حالة_انسكاب_غير_مدعومة(السجل) -> {
            أرجع نتيجة_بناء_ذراع_مخصص.حالة_انسكاب_غير_مدعومة(السجل);
        }
        | نتيجة_تخصيص_دالة_ذراع.سياسة_إطار_غير_متاحة(معرف_الهدف) -> {
            أرجع نتيجة_بناء_ذراع_مخصص.سياسة_إطار_غير_متاحة(معرف_الهدف);
        }
        | نتيجة_تخصيص_دالة_ذراع.هدف_غير_صالح(معرف_الهدف) -> {
            أرجع نتيجة_بناء_ذراع_مخصص.هدف_غير_صالح(معرف_الهدف);
        }
        | نتيجة_تخصيص_دالة_ذراع.نجحت(الدالة) -> { ألحق(الدوال, الدالة); };
        ف := ف + 1;
    }
    دع مرجع_رأس_البرنامج: &رأس_برنامج_منتقى = &ش.الرأس;
    دع رأس_البرنامج: رأس_برنامج_منتقى = *مرجع_رأس_البرنامج;
    دع الناتج: شفرة_ذراع_أربعة_وستون_مخصصة = {
        الرأس: رأس_البرنامج,
        الدوال: الدوال
    };
    أرجع نتيجة_بناء_ذراع_مخصص.نجح(الناتج);
}
