                تعليمة_ذراع_أربعة_وستون_مخصصة.عنوان_عام(السجل, العام, مستورد)
            );
        };
    }
    | تعليمة_ذراع_أربعة_وستون.بيئة_إغلاق_ذراع(الوجهة) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة); }
        | اختياري.موجود(السجل) -> {
