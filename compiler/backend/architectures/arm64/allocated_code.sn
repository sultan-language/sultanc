عرف ابحث_موضع_انسكاب_ذراع(
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    السجل: معرف_سجل_افتراضي
): اختيار موضع_انسكاب_ذراع_أربعة_وستون {
    دع إ: إطار_انسكاب_ذراع_أربعة_وستون = *الإطار;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(إ.المواقع) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع الموجود: غير_موقع = إ.المواقع[الوسط].السجل.القيمة;
        لو (الموجود == السجل.القيمة) {
            أرجع اختيار.بعض(إ.المواقع[الوسط]);
        };
        لو (الموجود < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ابحث_موضع_محلي_ذراع(
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    الهوية: غير_موقع
): اختيار موضع_محلي_ذراع_أربعة_وستون {
    دع إ: إطار_انسكاب_ذراع_أربعة_وستون = *الإطار;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(إ.المحليات) مثل غير_موقع)) {
        لو (إ.المحليات[ف].الهوية == الهوية) { أرجع اختيار.بعض(إ.المحليات[ف]); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ابن_سجلات_حفظ_إطار_ذراع(
    التعيينات: &متجه تعيين_سجل,
    الهدف: &واصف_هدف
): متجه معرف_سجل_فعلي {
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    // X19..X21 مملوكة لعمل الانسكاب وقد يستخدمها الخفض عند الحاجة؛ تحفظ دائما.
    دع س19: معرف_سجل_فعلي = { القيمة: 19 };
    دع س20: معرف_سجل_فعلي = { القيمة: 20 };
    دع س21: معرف_سجل_فعلي = { القيمة: 21 };
    ألحق(الناتج, س19);
    ألحق(الناتج, س20);
    ألحق(الناتج, س21);

    دع المرشحة: متجه معرف_سجل_فعلي = سجلات_ذراع_محفوظة_قابلة_للتخصيص(الهدف);
    دع ع: متجه تعيين_سجل = *التعيينات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المرشحة) مثل غير_موقع)) {
        دع مستخدم: متغير منطقي = خطأ;
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(ع) مثل غير_موقع)) {
            لو (معرفا_سجل_فعلي_متساويان(ع[ت].الفعلي, المرشحة[ف])) {
                مستخدم := صواب;
                ت := الطول(ع) مثل غير_موقع;
            } وإلا {
                ت := ت + 1;
            };
        }
        لو (مستخدم) { ألحق(الناتج, المرشحة[ف]); };
        ف := ف + 1;
    }

    // BL يكتب LR؛ احتفظ بـ X30 في كل دالة كما في السياسة الحالية.
    دع س30: معرف_سجل_فعلي = { القيمة: 30 };
    ألحق(الناتج, س30);
    أرجع الناتج;
}

عرف ابن_إطار_انسكاب_ذراع(
    السجلات: &متجه معرف_سجل_افتراضي,
    التعيينات: &متجه تعيين_سجل,
    الدالة: &دالة_ذراع_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): نتيجة_إطار_انسكاب_ذراع {
    طابق محاذاة_إطار_تخصيص_للهدف(الهدف) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_إطار_انسكاب_ذراع.سياسة_غير_متاحة(); }
    | اختيار.بعض(محاذاة_الإطار) -> {
        دع س: متجه معرف_سجل_افتراضي = *السجلات;
        دع المواقع: متغير متجه موضع_انسكاب_ذراع_أربعة_وستون = [];
        دع المحليات: متغير متجه موضع_محلي_ذراع_أربعة_وستون = [];
        دع الإزاحة: متغير غير_موقع = 0;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(س) مثل غير_موقع)) {
            الإزاحة := محاذاة_لأعلى(الإزاحة, 8);
            دع الموقع: موضع_انسكاب_ذراع_أربعة_وستون = {
                السجل: س[ف], الفهرس: ف, إزاحة_بايت: الإزاحة, الحجم: 8, المحاذاة: 8
            };
            ألحق(المواقع, الموقع); الإزاحة := الإزاحة + 8; ف := ف + 1;
        }
        دع د: دالة_ذراع_أربعة_وستون_منتقاة = *الدالة;
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(د.الكتل) مثل غير_موقع)) {
            دع ت: متغير غير_موقع = 0;
            بينما (ت < (الطول(د.الكتل[ك].التعليمات) مثل غير_موقع)) {
                طابق د.الكتل[ك].التعليمات[ت] مع
                | تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز) -> {
                    دع موجود: متغير منطقي = خطأ;
                    دع م: متغير غير_موقع = 0;
                    بينما (م < (الطول(المحليات) مثل غير_موقع)) {
                        لو (المحليات[م].الهوية == الحجز.الهوية) { موجود := صواب; };
                        م := م + 1;
                    }
                    لو (!موجود) {
                        دع محاذاة: متغير غير_موقع = الحجز.المحاذاة;
                        لو (محاذاة == 0) { محاذاة := 1; };
                        الإزاحة := محاذاة_لأعلى(الإزاحة, محاذاة);
                        دع موضع: موضع_محلي_ذراع_أربعة_وستون = {
                            الهوية: الحجز.الهوية, إزاحة_بايت: الإزاحة,
                            الحجم: الحجز.الحجم, المحاذاة: محاذاة
                        };
                        ألحق(المحليات, موضع);
                        الإزاحة := الإزاحة + الحجز.الحجم;
                    };
                }
                | _ -> { };
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        // خانات حفظ السجلات الفعلية منفصلة عن مواقع انسكاب القيم الافتراضية.
        دع السجلات_المحفوظة: متجه معرف_سجل_فعلي = ابن_سجلات_حفظ_إطار_ذراع(التعيينات, الهدف);
        دع عدد_السجلات_المحفوظة: غير_موقع = الطول(السجلات_المحفوظة) مثل غير_موقع;
        دع حجم_الحفظ: غير_موقع = عدد_السجلات_المحفوظة * 8;
        دع الحجم: غير_موقع = محاذاة_لأعلى(الإزاحة + حجم_الحفظ, محاذاة_الإطار);
        دع الإطار: إطار_انسكاب_ذراع_أربعة_وستون = {
            المواقع: المواقع,
            المحليات: المحليات,
            السجلات_المحفوظة: السجلات_المحفوظة,
            الحجم_بايت: الحجم,
            المحاذاة: محاذاة_الإطار
        };
        أرجع نتيجة_إطار_انسكاب_ذراع.نجح(الإطار);
    };
}

عرف حدد_موقع_قيمة_ذراع(
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون,
    السجل: معرف_سجل_افتراضي
): نتيجة_موقع_قيمة_ذراع {
    دع خ: خطة_تخصيص_مع_انسكاب = *الخطة;
    طابق ابحث_تعيين_سجل(&خ.التعيينات, السجل) مع
    | اختيار.بعض(الفعلي) -> {
        أرجع نتيجة_موقع_قيمة_ذراع.نجح(
            موقع_قيمة_ذراع_أربعة_وستون_مخصص.سجل(الفعلي)
        );
    }
    | اختيار.لا_شيء -> {
        طابق ابحث_موضع_انسكاب_ذراع(الإطار, السجل) مع
        | اختيار.بعض(الموقع) -> {
            أرجع نتيجة_موقع_قيمة_ذراع.نجح(
                موقع_قيمة_ذراع_أربعة_وستون_مخصص.انسكاب(الموقع)
            );
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_موقع_قيمة_ذراع.مفقود(السجل);
        };
    };
}

عرف خصص_نقلات_حافة_ذراع(
    المتطلبات: &متطلبات_نقل_حافة_منتقاة,
    التعيينات: &متجه تعيين_سجل
): نتيجة_نقلات_ذراع_مخصصة {
    دع م: متطلبات_نقل_حافة_منتقاة = *المتطلبات;
    دع النقلات: متغير متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م.النقلات) مثل غير_موقع)) {
        دع مرجع_النقلة: &نقلة_حافة_منتقاة = &م.النقلات[ف];
        دع النقلة: نقلة_حافة_منتقاة = *مرجع_النقلة;
        طابق ابحث_تعيين_سجل(التعيينات, النقلة.المصدر) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_نقلات_ذراع_مخصصة.سجل_غير_مخصص(النقلة.المصدر);
        }
        | اختيار.بعض(المصدر) -> {
            طابق ابحث_تعيين_سجل(التعيينات, النقلة.الوجهة) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_نقلات_ذراع_مخصصة.سجل_غير_مخصص(النقلة.الوجهة);
            }
            | اختيار.بعض(الوجهة) -> {
                دع موقع_المصدر: موقع_قيمة_ذراع_أربعة_وستون_مخصص =
                    موقع_قيمة_ذراع_أربعة_وستون_مخصص.سجل(المصدر);
                دع موقع_الوجهة: موقع_قيمة_ذراع_أربعة_وستون_مخصص =
                    موقع_قيمة_ذراع_أربعة_وستون_مخصص.سجل(الوجهة);
                دع المخصصة: نقلة_حافة_ذراع_أربعة_وستون_مخصصة = {
                    المصدر: موقع_المصدر,
                    الوجهة: موقع_الوجهة
                };
                ألحق(النقلات, المخصصة);
            };
        };
        ف := ف + 1;
    }
    دع الناتج: متطلبات_نقل_حافة_ذراع_أربعة_وستون_مخصصة = {
        الهدف: م.الهدف,
        النقلات: النقلات
    };
    أرجع نتيجة_نقلات_ذراع_مخصصة.نجحت(الناتج);
}

عرف خصص_نقلات_حافة_ذراع_بخطة(
    المتطلبات: &متطلبات_نقل_حافة_منتقاة,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون
): نتيجة_نقلات_ذراع_مخصصة {
    دع م: متطلبات_نقل_حافة_منتقاة = *المتطلبات;
    دع النقلات: متغير متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م.النقلات) مثل غير_موقع)) {
        دع النقلة: نقلة_حافة_منتقاة = م.النقلات[ف];
        طابق حدد_موقع_قيمة_ذراع(الخطة, الإطار, النقلة.المصدر) مع
        | نتيجة_موقع_قيمة_ذراع.مفقود(السجل) -> {
            أرجع نتيجة_نقلات_ذراع_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة_موقع_قيمة_ذراع.نجح(المصدر) -> {
            طابق حدد_موقع_قيمة_ذراع(الخطة, الإطار, النقلة.الوجهة) مع
            | نتيجة_موقع_قيمة_ذراع.مفقود(السجل) -> {
                أرجع نتيجة_نقلات_ذراع_مخصصة.سجل_غير_مخصص(السجل);
            }
            | نتيجة_موقع_قيمة_ذراع.نجح(الوجهة) -> {
                دع المخصصة: نقلة_حافة_ذراع_أربعة_وستون_مخصصة = {
                    المصدر: المصدر,
                    الوجهة: الوجهة
                };
                ألحق(النقلات, المخصصة);
            };
        };
        ف := ف + 1;
    }
    دع الناتج: متطلبات_نقل_حافة_ذراع_أربعة_وستون_مخصصة = {
        الهدف: م.الهدف,
        النقلات: النقلات
    };
    أرجع نتيجة_نقلات_ذراع_مخصصة.نجحت(الناتج);
}

عرف خصص_قيمة_واجهة_ذراع(
    القيمة: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة,
    التعيينات: &متجه تعيين_سجل
): نتيجة قيمة_واجهة_ذراع_أربعة_وستون_مخصصة, معرف_سجل_افتراضي {
    دع ق: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = *القيمة;
    طابق ابحث_تعيين_سجل(التعيينات, ق.السجل) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(ق.السجل); }
    | اختيار.بعض(السجل) -> {
        دع المواضع: متجه موضع_جزء_واجهة = انسخ_مواضع_أجزاء_واجهة(&ق.المواضع);
        دع الناتج: قيمة_واجهة_ذراع_أربعة_وستون_مخصصة = {
            السجل: السجل, المواضع: المواضع, الحجم: ق.الحجم,
            تجميعي: ق.تجميعي, غير_مباشر: ق.غير_مباشر, بإشارة: ق.بإشارة
        };
        أرجع نتيجة.نجح(الناتج);
    };
}

عرف خصص_قيمة_نداء_ذراع(
    القيمة: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة,
    التعيينات: &متجه تعيين_سجل
): نتيجة قيمة_نداء_ذراع_أربعة_وستون_مخصصة, معرف_سجل_افتراضي {
    دع ق: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = *القيمة;
    طابق ابحث_تعيين_سجل(التعيينات, ق.السجل) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(ق.السجل); }
    | اختيار.بعض(السجل) -> {
        دع الموقع: موقع_قيمة_ذراع_أربعة_وستون_مخصص =
            موقع_قيمة_ذراع_أربعة_وستون_مخصص.سجل(السجل);
        دع المواضع: متجه موضع_جزء_واجهة = انسخ_مواضع_أجزاء_واجهة(&ق.المواضع);
        دع الناتج: قيمة_نداء_ذراع_أربعة_وستون_مخصصة = {
            الموقع: الموقع, المواضع: المواضع, الحجم: ق.الحجم,
            تجميعي: ق.تجميعي, غير_مباشر: ق.غير_مباشر, بإشارة: ق.بإشارة
        };
        أرجع نتيجة.نجح(الناتج);
    };
}

عرف خصص_قيمة_نداء_ذراع_بخطة(
    القيمة: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون
): نتيجة قيمة_نداء_ذراع_أربعة_وستون_مخصصة, معرف_سجل_افتراضي {
    دع ق: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = *القيمة;
    طابق حدد_موقع_قيمة_ذراع(الخطة, الإطار, ق.السجل) مع
    | نتيجة_موقع_قيمة_ذراع.مفقود(السجل) -> { أرجع نتيجة.خطأ(السجل); }
    | نتيجة_موقع_قيمة_ذراع.نجح(الموقع) -> {
        دع المواضع: متجه موضع_جزء_واجهة = انسخ_مواضع_أجزاء_واجهة(&ق.المواضع);
        دع الناتج: قيمة_نداء_ذراع_أربعة_وستون_مخصصة = {
            الموقع: الموقع, المواضع: المواضع, الحجم: ق.الحجم,
            تجميعي: ق.تجميعي, غير_مباشر: ق.غير_مباشر, بإشارة: ق.بإشارة
        };
        أرجع نتيجة.نجح(الناتج);
    };
}

عرف خصص_هدف_نداء_ذراع(
    الهدف: &هدف_نداء_ذراع_أربعة_وستون,
    التعيينات: &متجه تعيين_سجل
): نتيجة هدف_نداء_ذراع_أربعة_وستون_مخصص, معرف_سجل_افتراضي {
    طابق *الهدف مع
    | هدف_نداء_ذراع_أربعة_وستون.دالة(الدالة) -> {
        أرجع نتيجة.نجح(هدف_نداء_ذراع_أربعة_وستون_مخصص.دالة(الدالة));
    }
    | هدف_نداء_ذراع_أربعة_وستون.دالة_خارجية(المعرف) -> {
        أرجع نتيجة.نجح(هدف_نداء_ذراع_أربعة_وستون_مخصص.دالة_خارجية(المعرف));
    }
    | هدف_نداء_ذراع_أربعة_وستون.بدائي_تشغيل(البدائي) -> {
        أرجع نتيجة.نجح(هدف_نداء_ذراع_أربعة_وستون_مخصص.بدائي_تشغيل(البدائي));
    }
    | هدف_نداء_ذراع_أربعة_وستون.قيمة_دالة(السجل) -> {
        طابق ابحث_تعيين_سجل(التعيينات, السجل) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(السجل); }
        | اختيار.بعض(الفعلي) -> {
            دع الموقع: موقع_قيمة_ذراع_أربعة_وستون_مخصص =
                موقع_قيمة_ذراع_أربعة_وستون_مخصص.سجل(الفعلي);
            أرجع نتيجة.نجح(هدف_نداء_ذراع_أربعة_وستون_مخصص.قيمة_دالة(الموقع));
        };
    };
}

عرف خصص_هدف_نداء_ذراع_بخطة(
    الهدف: &هدف_نداء_ذراع_أربعة_وستون,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون
): نتيجة هدف_نداء_ذراع_أربعة_وستون_مخصص, معرف_سجل_افتراضي {
    طابق *الهدف مع
    | هدف_نداء_ذراع_أربعة_وستون.دالة(الدالة) -> {
        أرجع نتيجة.نجح(هدف_نداء_ذراع_أربعة_وستون_مخصص.دالة(الدالة));
    }
    | هدف_نداء_ذراع_أربعة_وستون.دالة_خارجية(المعرف) -> {
        أرجع نتيجة.نجح(هدف_نداء_ذراع_أربعة_وستون_مخصص.دالة_خارجية(المعرف));
    }
    | هدف_نداء_ذراع_أربعة_وستون.بدائي_تشغيل(البدائي) -> {
        أرجع نتيجة.نجح(هدف_نداء_ذراع_أربعة_وستون_مخصص.بدائي_تشغيل(البدائي));
    }
    | هدف_نداء_ذراع_أربعة_وستون.قيمة_دالة(السجل) -> {
        طابق حدد_موقع_قيمة_ذراع(الخطة, الإطار, السجل) مع
        | نتيجة_موقع_قيمة_ذراع.مفقود(المفقود) -> { أرجع نتيجة.خطأ(المفقود); }
        | نتيجة_موقع_قيمة_ذراع.نجح(الموقع) -> {
            أرجع نتيجة.نجح(هدف_نداء_ذراع_أربعة_وستون_مخصص.قيمة_دالة(الموقع));
        };
    };
}

عرف خصص_نداء_ذراع(
    النداء: &نداء_ذراع_أربعة_وستون_منتقى,
    التعيينات: &متجه تعيين_سجل
): نتيجة_تعليمة_ذراع_مخصصة {
    دع ن: نداء_ذراع_أربعة_وستون_منتقى = *النداء;
    دع الحجج: متغير متجه قيمة_نداء_ذراع_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ن.الحجج) مثل غير_موقع)) {
        دع مرجع_الحجة: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = &ن.الحجج[ف];
        طابق خصص_قيمة_نداء_ذراع(مرجع_الحجة, التعيينات) مع
        | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة.نجح(القيمة) -> { ألحق(الحجج, القيمة); };
        ف := ف + 1;
    }
    دع الناتج: متغير اختيار قيمة_نداء_ذراع_أربعة_وستون_مخصصة = اختيار.لا_شيء();
    دع مرجع_الناتج: &اختيار قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = &ن.الناتج;
    دع نسخة_الناتج: اختيار قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = *مرجع_الناتج;
    طابق نسخة_الناتج مع
    | اختيار.بعض(قيمة) -> {
        طابق خصص_قيمة_نداء_ذراع(&قيمة, التعيينات) مع
        | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة.نجح(المخصصة) -> { الناتج := اختيار.بعض(المخصصة); };
    }
    | اختيار.لا_شيء -> { };
    دع دالة_صفر: معرف_دالة_منتقاة = { القيمة: 0 };
    دع هدف_النداء: متغير هدف_نداء_ذراع_أربعة_وستون_مخصص =
        هدف_نداء_ذراع_أربعة_وستون_مخصص.دالة(دالة_صفر);
    طابق خصص_هدف_نداء_ذراع(&ن.الهدف, التعيينات) مع
    | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل); }
    | نتيجة.نجح(المخصص) -> { هدف_النداء := المخصص; };
    دع النداء_المخصص: نداء_ذراع_أربعة_وستون_مخصص = {
        الهدف: هدف_النداء, الحجج: الحجج, الناتج: الناتج, حجم_مكدس_النداء: ن.حجم_مكدس_النداء
    };
    أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(
        تعليمة_ذراع_أربعة_وستون_مخصصة.فرع_برابط_مباشر(النداء_المخصص)
    );
}

