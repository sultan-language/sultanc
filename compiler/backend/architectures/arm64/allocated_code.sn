    التعيينات: &متجه تعيين_سجل,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون
): نتيجة_تعليمة_ذراع_مخصصة {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(الوجهة, المصدر) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختياري.لا_شيء -> {
