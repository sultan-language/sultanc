    حجم_مكدس_النداء: طبيعي
};

عام عرف ابن_موقع_سجل_ذراع_مخصص(
    السجل: معرف_سجل_فعلي
): موقع_قيمة_ذراع_أربعة_وستون_مخصص {
    أرجع موقع_قيمة_ذراع_أربعة_وستون_مخصص.سجل(السجل);
}

عام عرف سجل_موقع_قيمة_ذراع(
    الموقع: &موقع_قيمة_ذراع_أربعة_وستون_مخصص
): اختياري معرف_سجل_فعلي {
    طابق *الموقع مع
    | موقع_قيمة_ذراع_أربعة_وستون_مخصص.سجل(السجل) -> {
        أرجع اختياري.موجود(السجل);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف انسكاب_موقع_قيمة_ذراع(
    الموقع: &موقع_قيمة_ذراع_أربعة_وستون_مخصص
): اختياري موضع_انسكاب_ذراع_أربعة_وستون {
    طابق *الموقع مع
    | موقع_قيمة_ذراع_أربعة_وستون_مخصص.انسكاب(الموضع) -> {
        أرجع اختياري.موجود(الموضع);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف موقعا_قيمة_ذراع_متساويان(
    الأول: &موقع_قيمة_ذراع_أربعة_وستون_مخصص,
    الثاني: &موقع_قيمة_ذراع_أربعة_وستون_مخصص
): منطقي {
    طابق سجل_موقع_قيمة_ذراع(الأول) مع
    | اختياري.موجود(أ) -> {
        طابق سجل_موقع_قيمة_ذراع(الثاني) مع
        | اختياري.موجود(ب) -> {
            أرجع معرفا_سجل_فعلي_متساويان(أ, ب);
        }
        | اختياري.لا_شيء -> {
            أرجع خطأ;
        };
    }
    | اختياري.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_ذراع(الأول) مع
        | اختياري.موجود(أ) -> {
            طابق انسكاب_موقع_قيمة_ذراع(الثاني) مع
            | اختياري.موجود(ب) -> {
                أرجع أ.الفهرس == ب.الفهرس;
            }
            | اختياري.لا_شيء -> {
                أرجع خطأ;
            };
        }
        | اختياري.لا_شيء -> {
            أرجع خطأ;
        };
    };
}

