            دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة =
                تعليمة_ذراع_أربعة_وستون_مخصصة.مادي_فوري(السجل, القيمة);
            أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(الوجهة, القيمة) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة);
        }
        | اختياري.موجود(السجل) -> {
            دع الناتج: تعليمة_ذراع_أربعة_وستون_مخصصة =
                تعليمة_ذراع_أربعة_وستون_مخصصة.مادي_فوري_طبيعي(السجل, القيمة);
            أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(الناتج);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(الوجهة, الدالة) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الوجهة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الوجهة); }
        | اختياري.موجود(السجل) -> {
