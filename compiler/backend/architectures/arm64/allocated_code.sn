        }
        | اختياري.موجود(وجهة_فعلية) -> {
            طابق ابحث_تعيين_سجل(التعيينات, المصدر) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(المصدر);
            }
            | اختياري.موجود(مصدر_فعلي) -> {
