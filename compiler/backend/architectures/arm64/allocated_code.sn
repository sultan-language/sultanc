                تعليمة_ذراع_أربعة_وستون_مخصصة.بيئة_إغلاق(السجل)
            );
        };
    }
    | تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(الاستلام) -> {
        طابق خصص_قيمة_واجهة_ذراع(&الاستلام.القيمة, التعيينات) مع
        | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة.نجح(القيمة) -> {
            دع م: استلام_معامل_ذراع_أربعة_وستون_مخصص = { القيمة: القيمة };
            أرجع نتيجة_تعليمة_ذراع_مخصصة.نجحت(تعليمة_ذراع_أربعة_وستون_مخصصة.استلام_معامل(م));
        };
    }
    | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(الحساب) -> {
        طابق ابحث_تعيين_سجل(التعيينات, الحساب.الوجهة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_ذراع_مخصصة.سجل_غير_مخصص(الحساب.الوجهة); }
        | اختياري.موجود(و) -> {
