عام عرف انسخ_مملوكا_متجه_نقلة_حافة_ذراع_أربعة_وستون_مخصصة(القيمة: &متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة): متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة {
    دع الناتج: متغير متجه نقلة_حافة_ذراع_أربعة_وستون_مخصصة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
