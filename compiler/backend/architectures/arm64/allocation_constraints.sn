استورد compiler.backend.architectures.arm64.instruction_model;
استورد compiler.backend.architectures.arm64.selected_code;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.target.target_model;
استورد compiler.backend.abi.abi_model;

// هوية السجل الفعلي رقم مجرد عند الحد المشترك؛ معنى X0..X30 يبقى هنا في ARM64.
عرف سجل_ذراع_فعلي(الفهرس: غير_موقع): معرف_سجل_فعلي {
    دع الناتج: معرف_سجل_فعلي = { القيمة: الفهرس };
    أرجع الناتج;
}
عرف فئة_ذراع_صحيح(): معرف_فئة_تخصيص {
    دع الناتج: معرف_فئة_تخصيص = { القيمة: 0 };
    أرجع الناتج;
}

عرف طلب_ذراع(السجل: معرف_سجل_افتراضي): طلب_سجل_تخصيص {
    دع الفئة: معرف_فئة_تخصيص = فئة_ذراع_صحيح();
    دع الثابت: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    دع الناتج: طلب_سجل_تخصيص = { السجل: السجل, الفئة: الفئة, ثابت: الثابت };
    أرجع الناتج;
}
عرف طلب_ذراع_ثابت(السجل: معرف_سجل_افتراضي, الفعلي: معرف_سجل_فعلي): طلب_سجل_تخصيص {
    دع الفئة: معرف_فئة_تخصيص = فئة_ذراع_صحيح();
    دع الثابت: اختيار معرف_سجل_فعلي = اختيار.بعض(الفعلي);
    دع الناتج: طلب_سجل_تخصيص = { السجل: السجل, الفئة: الفئة, ثابت: الثابت };
    أرجع الناتج;
}

عرف طلب_ذراع_من_مرجع_واجهة(السجل: معرف_سجل_افتراضي, المرجع: &مرجع_سجل_واجهة): طلب_سجل_تخصيص {
    دع ر: مرجع_سجل_واجهة = *المرجع;
    لو (ر.الفئة == فئة_سجل_واجهة.عدد_صحيح()) {
        أرجع طلب_ذراع_ثابت(السجل, سجل_ذراع_فعلي(ر.الفهرس));
    };
    أرجع طلب_ذراع(السجل);
}


عرف طلب_ذراع_من_موضع_واجهة(
    السجل: معرف_سجل_افتراضي,
    الموضع: &موضع_جزء_واجهة
): طلب_سجل_تخصيص {
    طابق *الموضع مع
    | موضع_جزء_واجهة.سجل(المرجع) -> {
        لو (المرجع.الفئة == فئة_سجل_واجهة.عدد_صحيح()) {
            أرجع طلب_ذراع_ثابت(السجل, سجل_ذراع_فعلي(المرجع.الفهرس));
        };
        لو (المرجع.الفئة == فئة_سجل_واجهة.نتيجة_غير_مباشرة()) {
            أرجع طلب_ذراع_ثابت(السجل, سجل_ذراع_فعلي(8));
        };
    }
    | موضع_جزء_واجهة.مكدس(_) -> { };
    أرجع طلب_ذراع(السجل);
}

عرف حوّل_نقلات_حافة_للتخصيص(
    المتطلبات: &متطلبات_نقل_حافة_منتقاة
): متجه نقلة_حافة_تخصيص {
    دع م: متطلبات_نقل_حافة_منتقاة = *المتطلبات;
    دع الناتج: متغير متجه نقلة_حافة_تخصيص = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م.النقلات) مثل غير_موقع)) {
        دع مرجع_النقلة: &نقلة_حافة_منتقاة = &م.النقلات[ف];
        دع النقلة: نقلة_حافة_منتقاة = *مرجع_النقلة;
        دع المصدر: طلب_سجل_تخصيص = طلب_ذراع(النقلة.المصدر);
        دع الوجهة: طلب_سجل_تخصيص = طلب_ذراع(النقلة.الوجهة);
        دع حقيقة_النقلة: نقلة_حافة_تخصيص = {
            المصدر: المصدر,
            الوجهة: الوجهة
        };
        ألحق(الناتج, حقيقة_النقلة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف سجلات_ذراع_محفوظة_قابلة_للتخصيص(الهدف: &واصف_هدف): متجه معرف_سجل_فعلي {
    دع و: واصف_هدف = *الهدف;
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    طابق و.قواعد_السجلات مع
    | هوية_قواعد_سجلات_هدف.داروين_ذراع_أربعة_وستون -> {
        // X19..X21 تبقى مملوكة لعمل الانسكاب. البنك العام المحفوظ يبدأ من X22.
        دع ف: متغير غير_موقع = 22;
        بينما (ف < 29) {
            دع السجل: معرف_سجل_فعلي = سجل_ذراع_فعلي(ف);
            ألحق(الناتج, السجل);
            ف := ف + 1;
        }
    }
    | _ -> { };
    أرجع الناتج;
}

عام عرف سجلات_ذراع_متاحة_للتخصيص(الهدف: &واصف_هدف): متجه سجل_فعلي_متاح {
    دع و: واصف_هدف = *الهدف;
    دع الناتج: متغير متجه سجل_فعلي_متاح = [];
    // المزود الحالي المسجل لذراع هو قواعد Darwin؛ لا نستنتج ذلك من هوية ARM64.
    طابق و.قواعد_السجلات مع
    | هوية_قواعد_سجلات_هدف.داروين_ذراع_أربعة_وستون -> {
        // X0..X14 caller-saved للقيم القصيرة. X15..X17 scratch للمرمز، X18 محجوز Apple،
        // X19..X21 scratch محفوظ للانسكاب، وX22..X28 callee-saved للتخصيص عبر النداءات.
        دع ف: متغير غير_موقع = 0;
        بينما (ف < 15) {
            دع المعرف: معرف_سجل_فعلي = سجل_ذراع_فعلي(ف);
            دع الفئة: معرف_فئة_تخصيص = فئة_ذراع_صحيح();
            دع المتاح: سجل_فعلي_متاح = { المعرف: المعرف, الفئة: الفئة };
            ألحق(الناتج, المتاح);
            ف := ف + 1;
        }
        دع المحفوظة: متجه معرف_سجل_فعلي = سجلات_ذراع_محفوظة_قابلة_للتخصيص(الهدف);
        ف := 0;
        بينما (ف < (الطول(المحفوظة) مثل غير_موقع)) {
            دع الفئة: معرف_فئة_تخصيص = فئة_ذراع_صحيح();
            دع المتاح: سجل_فعلي_متاح = { المعرف: المحفوظة[ف], الفئة: الفئة };
            ألحق(الناتج, المتاح);
            ف := ف + 1;
        }
    }
    | _ -> { };
    أرجع الناتج;
}

// هذه السجلات يختارها مزود قيود ARM64 بحسب قواعد السجلات المحلولة للهدف.
// لا تفترض الخوارزمية المشتركة معنى أرقامها ولا نظام التشغيل.
عام عرف سجلات_عمل_انسكاب_ذراع_للهدف(الهدف: &واصف_هدف): متجه معرف_سجل_فعلي {
    دع و: واصف_هدف = *الهدف;
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    طابق و.قواعد_السجلات مع
    | هوية_قواعد_سجلات_هدف.داروين_ذراع_أربعة_وستون -> {
        // افصل سجلات إعادة تحميل الانسكاب عن X15..X17 التي يستعملها encoder مؤقتا.
        // X19..X21 callee-preserved وتحفظها كل دالة ARM64 في إطارها.
        ألحق(الناتج, سجل_ذراع_فعلي(19));
        ألحق(الناتج, سجل_ذراع_فعلي(20));
        ألحق(الناتج, سجل_ذراع_فعلي(21));
    }
    | _ -> { };
    أرجع الناتج;
}

عرف موضع_واجهة_أول_ذراع(
    القيمة: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة
): اختيار موضع_جزء_واجهة {
    دع ق: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = *القيمة;
    لو ((الطول(ق.المواضع) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع مرجع_الموضع: &موضع_جزء_واجهة = &ق.المواضع[0];
    أرجع اختيار.بعض(انسخ_موضع_جزء_واجهة(مرجع_الموضع));
}

عرف أضف_طلبات_نداء(
    النداء: &نداء_ذراع_أربعة_وستون_منتقى,
    الهدف: &واصف_هدف,
    الاستخدامات: &متغير متجه طلب_سجل_تخصيص,
    التعريفات: &متغير متجه طلب_سجل_تخصيص,
    المفسدة: &متغير متجه معرف_سجل_فعلي
): فراغ {
    دع ن: نداء_ذراع_أربعة_وستون_منتقى = *النداء;
    دع حالة_الاستخدامات: متغير متجه طلب_سجل_تخصيص = *الاستخدامات;
    دع حالة_التعريفات: متغير متجه طلب_سجل_تخصيص = *التعريفات;
    دع حالة_المفسدة: متغير متجه معرف_سجل_فعلي = *المفسدة;
    طابق ن.الهدف مع
    | هدف_نداء_ذراع_أربعة_وستون.قيمة_دالة(السجل) -> { ألحق(حالة_الاستخدامات, طلب_ذراع(السجل)); }
    | _ -> { };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ن.الحجج) مثل غير_موقع)) {
        دع مرجع_الحجة: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = &ن.الحجج[ف];
        دع الحجة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = *مرجع_الحجة;
        لو (الحجة.تجميعي != 0) {
            // Aggregate virtual value is its backing-storage address; physical ABI chunks are marshalled by encoder.
            ألحق(حالة_الاستخدامات, طلب_ذراع(الحجة.السجل));
        } وإلا {
            // ABI placement is a call-boundary marshalling fact. Keep the value in
            // any allocatable register/spill location and let encoder move it into
            // the ABI register/stack slot immediately before BL.
            ألحق(حالة_الاستخدامات, طلب_ذراع(الحجة.السجل));
        };
        ف := ف + 1;
    }
    دع مرجع_الناتج: &اختيار قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = &ن.الناتج;
    دع نسخة_الناتج: اختيار قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = *مرجع_الناتج;
    طابق نسخة_الناتج مع
    | اختيار.بعض(الناتج) -> {
        لو (الناتج.تجميعي != 0) {
            // The result backing address was defined before the call and is used by direct-result stores or X8 indirect result.
            ألحق(حالة_الاستخدامات, طلب_ذراع(الناتج.السجل));
        } وإلا {
            // The call result is received from its ABI location by encoder after
            // BL, so its virtual register must not be pinned to that ABI register
            // for the rest of its live range.
            ألحق(حالة_التعريفات, طلب_ذراع(الناتج.السجل));
        };
    }
    | اختيار.لا_شيء -> { };
    دع وصف_الهدف: واصف_هدف = *الهدف;
    طابق وصف_الهدف.قواعد_السجلات مع
    | هوية_قواعد_سجلات_هدف.داروين_ذراع_أربعة_وستون -> {
        دع ر: متغير غير_موقع = 0;
        بينما (ر < 19) { ألحق(حالة_المفسدة, سجل_ذراع_فعلي(ر)); ر := ر + 1; }
    }
    | _ -> { };
    *الاستخدامات := حالة_الاستخدامات;
    *التعريفات := حالة_التعريفات;
    *المفسدة := حالة_المفسدة;
}

عام عرف حقيقة_تخصيص_تعليمة_ذراع(
    التعليمة: &تعليمة_ذراع_أربعة_وستون,
    الهدف: &واصف_هدف,
    الموضع: غير_موقع
): حقيقة_تعليمة_تخصيص {
    دع الاستخدامات: متغير متجه طلب_سجل_تخصيص = [];
    دع التعريفات: متغير متجه طلب_سجل_تخصيص = [];
    دع الربط: متغير متجه قيد_ربط_تخصيص = [];
    دع المفسدة: متغير متجه معرف_سجل_فعلي = [];
    دع نداء: متغير منطقي = خطأ;
    دع قابل: متغير منطقي = صواب;
    دع نقل: متغير اختيار قيد_ربط_تخصيص = اختيار.لا_شيء();
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(الوجهة, المصدر) -> {
        ألحق(الاستخدامات, طلب_ذراع(المصدر));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
        دع قيد_النقل: قيد_ربط_تخصيص = { الأول: المصدر, الثاني: الوجهة };
        نقل := اختيار.بعض(قيد_النقل);
    }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(الوجهة, القيمة) -> {
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_غير_موقع(الوجهة, القيمة) -> {
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(الوجهة, _) -> {
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(الاستلام) -> {
        دع مرجع_القيمة: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = &الاستلام.القيمة;
        دع القيمة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = *مرجع_القيمة;
        لو ((القيمة.تجميعي != 0) && (القيمة.غير_مباشر == 0)) {
            ألحق(الاستخدامات, طلب_ذراع(القيمة.السجل));
        } وإلا {
            // حامل الالتقاط يملك موضع ABI نفسه حتى تُلتقط كل المداخل. لو خُصص بحرية قد
            // يكتب مثلا التقاط X8 في X0 قبل قراءة معامل X0 التالي ويفسد قيمة الدخل.
            // السجل الدلالي يبقى حرا: selector ينقله من هذا الحامل بعد اكتمال الالتقاط.
            طابق موضع_واجهة_أول_ذراع(&القيمة) مع
            | اختيار.بعض(الموضع) -> {
                دع طلب_الدخل: طلب_سجل_تخصيص = طلب_ذراع_من_موضع_واجهة(
                    القيمة.السجل,
                    &الموضع
                );
                ألحق(التعريفات, طلب_الدخل);
            }
            | اختيار.لا_شيء -> { قابل := خطأ; };
        };
    }
    | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(الحساب) -> {
        ألحق(الاستخدامات, طلب_ذراع(الحساب.اليسار));
        ألحق(الاستخدامات, طلب_ذراع(الحساب.اليمين));
        ألحق(التعريفات, طلب_ذراع(الحساب.الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.حساب_عشري_ذراع(_, الوجهة, اليسار, اليمين, _) -> {
        ألحق(الاستخدامات, طلب_ذراع(اليسار));
        ألحق(الاستخدامات, طلب_ذراع(اليمين));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_عشرية_إلى_منطق_ذراع(_, الوجهة, اليسار, اليمين, _) -> {
        ألحق(الاستخدامات, طلب_ذراع(اليسار));
        ألحق(الاستخدامات, طلب_ذراع(اليمين));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.تحويل_صحيح_ذراع(التحويل) -> {
        ألحق(الاستخدامات, طلب_ذراع(التحويل.المصدر));
        ألحق(التعريفات, طلب_ذراع(التحويل.الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز) -> {
        ألحق(التعريفات, طلب_ذراع(الحجز.الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_إزاحة_ذراع(الوجهة, الأساس, _) -> {
        ألحق(الاستخدامات, طلب_ذراع(الأساس));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_عنصر_ذراع(الوجهة, الأساس, الفهرس, _) -> {
        ألحق(الاستخدامات, طلب_ذراع(الأساس));
        ألحق(الاستخدامات, طلب_ذراع(الفهرس));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(الوجهة, المصدر, _, _, _) -> {
        ألحق(الاستخدامات, طلب_ذراع(الوجهة));
        ألحق(الاستخدامات, طلب_ذراع(المصدر));
        ألحق(المفسدة, سجل_ذراع_فعلي(15));
    }
    | تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(التخزين) -> {
        ألحق(الاستخدامات, طلب_ذراع(التخزين.الأساس));
        ألحق(المفسدة, سجل_ذراع_فعلي(15));
    }
    | تعليمة_ذراع_أربعة_وستون.إلحاق_متجه_ذراع(الإلحاق) -> {
        ألحق(الاستخدامات, طلب_ذراع(الإلحاق.المتجه));
        ألحق(الاستخدامات, طلب_ذراع(الإلحاق.العنصر));
        نداء := صواب;
        دع وصف_الهدف: واصف_هدف = *الهدف;
        طابق وصف_الهدف.قواعد_السجلات مع
        | هوية_قواعد_سجلات_هدف.داروين_ذراع_أربعة_وستون -> {
            دع ر: متغير غير_موقع = 0;
            بينما (ر < 19) {
                ألحق(المفسدة, سجل_ذراع_فعلي(ر));
                ر := ر + 1;
            }
        }
        | _ -> { };
    }
    | تعليمة_ذراع_أربعة_وستون.ثابت_نص_ذراع(الثابت) -> {
        ألحق(الاستخدامات, طلب_ذراع(الثابت.الوجهة));
        // X15 محجوز أصلا لعمل encoder ولا يدخل مجموعة allocator.
        ألحق(المفسدة, سجل_ذراع_فعلي(15));
    }
    | تعليمة_ذراع_أربعة_وستون.تخصيص_صندوق_ذراع(الوجهة, _, _) -> {
        ألحق(التعريفات, طلب_ذراع(الوجهة));
        نداء := صواب;
        دع وصف_الهدف: واصف_هدف = *الهدف;
        طابق وصف_الهدف.قواعد_السجلات مع
        | هوية_قواعد_سجلات_هدف.داروين_ذراع_أربعة_وستون -> {
            دع ر: متغير غير_موقع = 0;
            بينما (ر < 19) {
                ألحق(المفسدة, سجل_ذراع_فعلي(ر));
                ر := ر + 1;
            }
        }
        | _ -> { };
    }
    | تعليمة_ذراع_أربعة_وستون.جمع_سجل_ذراع(الوجهة, أ, ب) -> {
        ألحق(الاستخدامات, طلب_ذراع(أ));
        ألحق(الاستخدامات, طلب_ذراع(ب));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.جمع_سجل_مزاح_ذراع(الوجهة, أ, ب, _) -> {
        ألحق(الاستخدامات, طلب_ذراع(أ));
        ألحق(الاستخدامات, طلب_ذراع(ب));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.جمع_فوري_ذراع(الوجهة, أ, ب) -> {
        ألحق(الاستخدامات, طلب_ذراع(أ));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.طرح_سجل_ذراع(الوجهة, أ, ب) -> {
        ألحق(الاستخدامات, طلب_ذراع(أ));
        ألحق(الاستخدامات, طلب_ذراع(ب));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.طرح_فوري_ذراع(الوجهة, أ, ب) -> {
        ألحق(الاستخدامات, طلب_ذراع(أ));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(أ, ب) -> {
        ألحق(الاستخدامات, طلب_ذراع(أ));
        ألحق(الاستخدامات, طلب_ذراع(ب));
    }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(أ, ب) -> {
        ألحق(الاستخدامات, طلب_ذراع(أ));
    }
    | تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(الوجهة, الشرط) -> {
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.فخ_ذراع -> { }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع(_) -> { }
    // الاستخدام/التعريف على الحافة ممثل في حقيقة_نقل_حافة_تخصيص، لا في حقيقة التعليمة.
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(_) -> { }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي(_, _) -> { }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(_, _) -> { }
    | تعليمة_ذراع_أربعة_وستون.عودة_ذراع -> { }
    | تعليمة_ذراع_أربعة_وستون.فرع_برابط_ذراع_مباشر(خطة) -> {
        نداء := صواب;
        أضف_طلبات_نداء(
            &خطة,
            الهدف,
            &متغير الاستخدامات,
            &متغير التعريفات,
            &متغير المفسدة
        );
    }
    | تعليمة_ذراع_أربعة_وستون.عودة_ذراع_بقيمة(الناتج) -> {
        دع مرجع_القيمة: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = &الناتج.القيمة;
        دع القيمة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = *مرجع_القيمة;
        لو (القيمة.تجميعي != 0) {
            ألحق(الاستخدامات, طلب_ذراع(القيمة.السجل));
            لو (القيمة.غير_مباشر != 0) {
                دع مرجع_العنوان: &اختيار معرف_سجل_افتراضي = &الناتج.عنوان_ناتج_غير_مباشر;
                دع نسخة_العنوان: اختيار معرف_سجل_افتراضي = *مرجع_العنوان;
                طابق نسخة_العنوان مع
                | اختيار.بعض(العنوان) -> { ألحق(الاستخدامات, طلب_ذراع(العنوان)); }
                | اختيار.لا_شيء -> { قابل := خطأ; };
            };
        } وإلا {
            // موضع سجل النتيجة في ABI حقيقة حد الإرجاع فقط. لا نثبت السجل
            // الافتراضي في X0/X1 طوال مجال حياته، لأن القيمة قد تعبر نداءات
            // تفسد تلك السجلات. encoder يمرحل القيمة إلى سجل ABI مباشرة قبل RET.
            طابق موضع_واجهة_أول_ذراع(&القيمة) مع
            | اختيار.بعض(_) -> { ألحق(الاستخدامات, طلب_ذراع(القيمة.السجل)); }
            | اختيار.لا_شيء -> { قابل := خطأ; };
        };
    }
    | تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(الوجهة, العنوان, _, _) -> {
        ألحق(الاستخدامات, طلب_ذراع(العنوان.الأساس));
        ألحق(التعريفات, طلب_ذراع(الوجهة));
    }
    | تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(المصدر, العنوان, _) -> {
        ألحق(الاستخدامات, طلب_ذراع(المصدر));
        ألحق(الاستخدامات, طلب_ذراع(العنوان.الأساس));
    }
    | _ -> {
        قابل := خطأ;
    };
    دع الناتج: حقيقة_تعليمة_تخصيص = {
        الموضع: الموضع,
        الاستخدامات: الاستخدامات,
        التعريفات: التعريفات,
        القيود_المربوطة: الربط,
        السجلات_المفسدة: المفسدة,
        حد_نداء: نداء,
        قابل_للانسكاب: قابل,
        نقل_مفضل: نقل
    };
    أرجع الناتج;
}

عرف حافة_تخصيص_ذراع_موجودة(
    الحواف: &متجه حقيقة_نقل_حافة_تخصيص,
    الكتلة_المصدر: معرف_كتلة_منتقاة,
    الكتلة_الهدف: معرف_كتلة_منتقاة
): منطقي {
    دع ح: متجه حقيقة_نقل_حافة_تخصيص = *الحواف;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ح) مثل غير_موقع)) {
        لو (
            معرفا_كتلة_منتقاة_متساويان(ح[ف].من_كتلة, الكتلة_المصدر)
            && معرفا_كتلة_منتقاة_متساويان(ح[ف].إلى_كتلة, الكتلة_الهدف)
        ) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف ابن_مسألة_تخصيص_دالة_ذراع(
    الدالة: &دالة_ذراع_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): مسألة_تخصيص {
    دع د: دالة_ذراع_أربعة_وستون_منتقاة = *الدالة;
    دع الحقائق: متغير متجه حقيقة_تعليمة_تخصيص = [];
    دع الحواف: متغير متجه حقيقة_نقل_حافة_تخصيص = [];
    دع حقائق_الكتل: متغير متجه حقيقة_كتلة_تخصيص = [];
    دع الموضع: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(د.الكتل) مثل غير_موقع)) {
        دع مرجع_الكتلة: &كتلة_ذراع_أربعة_وستون_منتقاة = &د.الكتل[ف];
        دع الكتلة: كتلة_ذراع_أربعة_وستون_منتقاة = *مرجع_الكتلة;
        دع بداية_الكتلة: غير_موقع = الموضع;
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الكتلة.التعليمات) مثل غير_موقع)) {
            دع مرجع_التعليمة: &تعليمة_ذراع_أربعة_وستون = &الكتلة.التعليمات[ت];
            دع التعليمة: تعليمة_ذراع_أربعة_وستون = *مرجع_التعليمة;
            ألحق(الحقائق, حقيقة_تخصيص_تعليمة_ذراع(&التعليمة, الهدف, الموضع));
            طابق التعليمة مع
            | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(النقلات) -> {
                دع نسخة_النقلات: متجه نقلة_حافة_تخصيص = حوّل_نقلات_حافة_للتخصيص(&النقلات);
                دع حافة: حقيقة_نقل_حافة_تخصيص = {
                    من_كتلة: الكتلة.الرأس.المعرف,
                    إلى_كتلة: النقلات.الهدف,
                    النقلات: نسخة_النقلات
                };
                ألحق(الحواف, حافة);
            }
            | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(الشرط, النقلات) -> {
                دع نسخة_النقلات: متجه نقلة_حافة_تخصيص = حوّل_نقلات_حافة_للتخصيص(&النقلات);
                دع حافة: حقيقة_نقل_حافة_تخصيص = {
                    من_كتلة: الكتلة.الرأس.المعرف,
                    إلى_كتلة: النقلات.الهدف,
                    النقلات: نسخة_النقلات
                };
                ألحق(الحواف, حافة);
            }
            | _ -> { };
            الموضع := الموضع + 1;
            ت := ت + 1;
        }
        // رأس الشفرة المنتقاة هو مالك CFG. كل لاحق يجب أن يظهر كحافة تخصيص حتى لو
        // لم توجد معاملات كتلة/نقلات متوازية على تلك الحافة.
        دع خ: متغير غير_موقع = 0;
        بينما (خ < (الطول(الكتلة.الرأس.الخلفاء) مثل غير_موقع)) {
            دع اللاحق: معرف_كتلة_منتقاة = الكتلة.الرأس.الخلفاء[خ];
            لو (!حافة_تخصيص_ذراع_موجودة(&الحواف, الكتلة.الرأس.المعرف, اللاحق)) {
                دع لا_نقلات: متجه نقلة_حافة_تخصيص = [];
                دع حافة: حقيقة_نقل_حافة_تخصيص = {
                    من_كتلة: الكتلة.الرأس.المعرف,
                    إلى_كتلة: اللاحق,
                    النقلات: لا_نقلات
                };
                ألحق(الحواف, حافة);
            };
            خ := خ + 1;
        }
        دع حقيقة_الكتلة: حقيقة_كتلة_تخصيص = {
            المعرف: الكتلة.الرأس.المعرف,
            البداية: بداية_الكتلة,
            النهاية: الموضع
        };
        ألحق(حقائق_الكتل, حقيقة_الكتلة);
        ف := ف + 1;
    }
    دع المتاحة: متجه سجل_فعلي_متاح = سجلات_ذراع_متاحة_للتخصيص(الهدف);
    دع الناتج: مسألة_تخصيص = {
        عدد_السجلات_الافتراضية: د.الرأس.عدد_السجلات_الافتراضية,
        التعليمات: الحقائق,
        نقلات_الحواف: الحواف,
        الكتل: حقائق_الكتل,
        السجلات_المتاحة: المتاحة
    };
    أرجع الناتج;
}
