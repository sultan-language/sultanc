                دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التخزين.القيمة);
                دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: سجل_المكان, إزاحة_بايت: 0 };
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(
                    سجل_القيمة, العنوان, التخطيط.الحجم
