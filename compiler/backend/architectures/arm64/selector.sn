                            }
                            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الناتج) -> {
                                إذا (!(تخطيط_الناتج.الحجم == 1
                                    || تخطيط_الناتج.الحجم == 2
                                    || تخطيط_الناتج.الحجم == 4
                                    || تخطيط_الناتج.الحجم == 8)) {
                                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                        سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, تخطيط_الناتج.الحجم)
                                    ));
                                };
                                دع سجل_الحجة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(قيمة_الحجة);
                                دع إزاحة_الطول: عدد = جزء_الطول.الإزاحة مثل عدد;
                                دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                                    الأساس: سجل_الحجة,
                                    إزاحة_بايت: إزاحة_الطول
                                };
                                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                                دع تعليمة_التحميل: تعليمة_ذراع_أربعة_وستون =
                                    تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
                                        سجل_الناتج, العنوان, تخطيط_الناتج.الحجم, خطأ
                                    );
                                ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                                    تعليمة_التحميل
                                );
                            };
                        };
                    };
                };
            }
            | هوية_بدائي_مترجم.سعة_متجه -> {
                // The header capacity word, read as length reads its word.
                دع عدد_حجج_النداء: طبيعي = الطول(النداء.الحجج) مثل طبيعي;
                إذا (عدد_حجج_النداء != 1) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
                }
                | اختياري.موجود(الناتج) -> {
                    دع قيمة_الحجة: معرف_قيمة_مسير = النداء.الحجج[0];
                    طابق تخطيط_قيمة_مسير_ذراع(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, قيمة_الحجة
                    ) مع
                    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
                    }
                    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الحجة) -> {
                        طابق جزء_تخطيط_عند_ذراع(&تخطيط_الحجة, 2) مع
                        | اختياري.لا_شيء -> {
                            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(قيمة_الحجة, 2)
                            ));
                        }
                        | اختياري.موجود(جزء_الطول) -> {
                            طابق تخطيط_قيمة_مسير_ذراع(
                                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج
                            ) مع
                            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                                أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
                            }
                            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الناتج) -> {
                                إذا (!(تخطيط_الناتج.الحجم == 1
                                    || تخطيط_الناتج.الحجم == 2
                                    || تخطيط_الناتج.الحجم == 4
                                    || تخطيط_الناتج.الحجم == 8)) {
                                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                        سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, تخطيط_الناتج.الحجم)
                                    ));
                                };
                                دع سجل_الحجة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(قيمة_الحجة);
                                دع إزاحة_الطول: عدد = جزء_الطول.الإزاحة مثل عدد;
                                دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                                    الأساس: سجل_الحجة,
                                    إزاحة_بايت: إزاحة_الطول
                                };
                                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                                دع تعليمة_التحميل: تعليمة_ذراع_أربعة_وستون =
                                    تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
                                        سجل_الناتج, العنوان, تخطيط_الناتج.الحجم, خطأ
                                    );
                                ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                                    تعليمة_التحميل
                                );
                            };
                        };
                    };
                };
            }
            | هوية_بدائي_مترجم.ضبط_طول_متجه -> {
                // The vector's place holds its header: store the new length
                // into the header's length word (pop and truncate glue).
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 2) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق النداء.مكان_التعديل مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.موجود(مكان_المتجه) -> {
                    طابق تخطيط_قيمة_مسير_ذراع(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, مكان_المتجه
                    ) مع
                    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
                    }
                    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المتجه) -> {
                        طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 1) مع
                        | اختياري.لا_شيء -> {
                            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(مكان_المتجه, 1)
                            ));
                        }
                        | اختياري.موجود(جزء_الطول) -> {
                            طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 2) مع
                            | اختياري.لا_شيء -> {
                                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                    سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(مكان_المتجه, 2)
                                ));
                            }
                            | اختياري.موجود(جزء_السعة) -> {
                                دع حجم_الطول: طبيعي = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
                                دع عنوان_الطول: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                                    الأساس: سجل_لقيمة_مسير(مكان_المتجه),
                                    إزاحة_بايت: جزء_الطول.الإزاحة مثل عدد
                                };
                                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(
                                    سجل_لقيمة_مسير(النداء.الحجج[1]), عنوان_الطول, حجم_الطول
                                ));
                            };
                        };
                    };
                };
            }
            | هوية_بدائي_مترجم.إلحاق -> {
                دع عدد_الحجج: طبيعي = الطول(النداء.الحجج) مثل طبيعي;
                إذا (عدد_الحجج != 2) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختياري.موجود(_) -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.لا_شيء -> {
                    طابق النداء.مكان_التعديل مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                    }
                    | اختياري.موجود(مكان_المتجه) -> {
                        طابق ألحق_إلحاق_متجه_ذراع(
                            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                            مكان_المتجه, النداء.الحجج[1], التعليمات, خطأ
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                };
            }
            | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 4) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق النداء.مكان_التعديل مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.موجود(مكان_المتجه) -> {
                    طابق ألحق_امتداد_متجه_ذراع(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, مكان_المتجه,
                        النداء.الحجج[1], النداء.الحجج[2], النداء.الحجج[3], التعليمات
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            }
            | هوية_بدائي_مترجم.حجز_سعة_متجه -> {
                // The append instruction in reserve form (encoder.sn).
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 2) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق النداء.مكان_التعديل مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.موجود(مكان_المتجه) -> {
                    طابق ألحق_إلحاق_متجه_ذراع(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                        مكان_المتجه, النداء.الحجج[1], التعليمات, صواب
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            }
            // Thread support: atomics, leaked boxes and closure addresses (the
            // same machine word), and the C entry pthread_create calls.
            | هوية_بدائي_مترجم.ذري_حمل -> { أرجع ألحق_بدائي_ذري_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_خزن -> { أرجع ألحق_بدائي_ذري_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_تبديل -> { أرجع ألحق_بدائي_ذري_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { أرجع ألحق_بدائي_ذري_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_جلب_جمع -> { أرجع ألحق_بدائي_ذري_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_جلب_و -> { أرجع ألحق_بدائي_ذري_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_جلب_أو -> { أرجع ألحق_بدائي_ذري_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { أرجع ألحق_بدائي_ذري_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.سياج_ذاكرة -> { أرجع ألحق_بدائي_ذري_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.سرب_قيمة -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
                طابق العرض.الناتج مع
                | اختياري.موجود(الناتج) -> { ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(النداء.الحجج[0]))); }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); };
            }
            | هوية_بدائي_مترجم.عنوان_دالة -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
                طابق العرض.الناتج مع
                | اختياري.موجود(الناتج) -> { ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(النداء.الحجج[0]))); }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); };
            }
            | هوية_بدائي_مترجم.دالة_من_عنوان -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
                طابق العرض.الناتج مع
                | اختياري.موجود(الناتج) -> { ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(النداء.الحجج[0]))); }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); };
            }
            | هوية_بدائي_مترجم.مدخل_سي_لدالة -> {
                طابق العرض.الناتج مع
                | اختياري.موجود(الناتج) -> { ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مدخل_سي_ذراع(سجل_لقيمة_مسير(الناتج))); }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); };
            }
            // A C call at an address: the arguments after the result witness
            // and the address take the AAPCS64 plan of an extern call of
            // (u64 x8, f64 x8) with the witness's result Type.
            | هوية_بدائي_مترجم.نداء_عنوان_سي -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 18) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
                | اختياري.موجود(_) -> { };
                دع حجج_سي: متغير متجه معرف_قيمة_مسير = [];
                دع فهرس_سي: متغير طبيعي = 2;
                طالما (فهرس_سي < 18) {
                    ألحق(حجج_سي, النداء.الحجج[فهرس_سي]);
                    فهرس_سي := فهرس_سي + 1;
                }
                طابق حل_واجهة_نداء_خارجي_قيم_مسير_للهدف(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &حجج_سي, العرض.الناتج
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
                }
                | نتيجة.نجح(خطة_سي) -> {
                    دع هدف_سي: هدف_نداء_ذراع_أربعة_وستون =
                        هدف_نداء_ذراع_أربعة_وستون.عنوان_سي(سجل_لقيمة_مسير(النداء.الحجج[1]));
                    طابق ألحق_نداء_ذراع_بخطة(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, عدد_السجلات, الثابتة,
                        التعليمات, هدف_سي, &حجج_سي, العرض.الناتج, &خطة_سي
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            }
            // Darwin starts threads with pthread_create; AArch64 Linux with the
            // kernel clone (ألحق_نداء_نواة_ذراع).
            | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> {
                أرجع ألحق_نداء_نواة_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, التعليمات,
                    البدائي, &النداء.الحجج, العرض.الناتج, صواب
                );
            }
            | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                أرجع ألحق_نداء_نواة_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, التعليمات,
                    البدائي, &النداء.الحجج, العرض.الناتج, خطأ
                );
            }
            | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> {
                أرجع ألحق_بدائي_بيئة_إغلاق_ذراع(التعليمات, عدد_السجلات, البدائي, &النداء.الحجج, العرض.الناتج);
            }
            | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> {
                أرجع ألحق_بدائي_بيئة_إغلاق_ذراع(التعليمات, عدد_السجلات, البدائي, &النداء.الحجج, العرض.الناتج);
            }
            | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> {
                أرجع ألحق_بدائي_بيئة_إغلاق_ذراع(التعليمات, عدد_السجلات, البدائي, &النداء.الحجج, العرض.الناتج);
            }
            | هوية_بدائي_مترجم.تحرير -> {
                // Release adapts the std release provider (runtime_primitive_query_context.sn).
                طابق نداء_تحرير_مكيف_للهدف(الهدف, حقائق_الخلفية, المسير, &النداء) مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.موجود(المكيف) -> {
                    دع عرض_المكيف: عرض_تعليمة_مسير = عرض_تعليمة_بنداء_مسير(التعليمة, المكيف);
                    أرجع انتق_تعليمة_ذراع_أربعة_وستون(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, عدد_السجلات, &عرض_المكيف, التعليمات, قراءات_الطول, الثابتة
                    );
                };
            }
            | _ -> {
                طابق خطة_ربط_بدائي_للهدف(الهدف, البدائي) مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.موجود(_) -> {
                    طابق حل_واجهة_نداء_قيم_مسير_للهدف(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                        &النداء.الحجج, العرض.الناتج
                    ) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
                    }
                    | نتيجة.نجح(خطة_البدائي) -> {
                        دع هدف_البدائي: هدف_نداء_ذراع_أربعة_وستون =
                            هدف_نداء_ذراع_أربعة_وستون.بدائي_تشغيل(البدائي);
                        طابق ألحق_نداء_ذراع_بخطة(
                            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, عدد_السجلات, الثابتة,
                            التعليمات, هدف_البدائي,
                            &النداء.الحجج, العرض.الناتج, &خطة_البدائي
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                };
            };
        }
        | هدف_نداء_مسير.قيمة_دالة(الدالة_القيمة) -> {
            طابق حل_واجهة_هدف_نداء_قيم_مسير_للهدف(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &النداء.الهدف,
                &النداء.الحجج, العرض.الناتج
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
            }
            | نتيجة.نجح(خطة_الدالة) -> {
                دع هدف_القيمة: هدف_نداء_ذراع_أربعة_وستون =
                    هدف_نداء_ذراع_أربعة_وستون.قيمة_دالة(سجل_لقيمة_مسير(الدالة_القيمة));
                طابق ألحق_نداء_ذراع_بخطة(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, عدد_السجلات, الثابتة,
                    التعليمات, هدف_القيمة,
                    &النداء.الحجج, العرض.الناتج, &خطة_الدالة
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
        }
        | هدف_نداء_مسير.دالة_خارجية(معرف_الدالة) -> {
            طابق ابحث_دالة_خارجية_مسير(المسير, معرف_الدالة) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
            }
            | اختياري.موجود(الدالة) -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != (الطول(الدالة.المعاملات) مثل طبيعي)) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
                };
                طابق حل_واجهة_نداء_خارجي_قيم_مسير_للهدف(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                    &النداء.الحجج, العرض.الناتج
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
                }
                | نتيجة.نجح(خطة_الواجهة) -> {
                    دع الخطة: متغير خطة_دالة_واجهة = خطة_الواجهة;
                    طابق الدالة.المعاملات_الثابتة مع
                    | اختياري.موجود(الثابتة) -> {
                        إذا ((*الهدف).المنصة.المنصة == هوية_منصة.ماك_أو_إس()
                            || (*الهدف).المنصة.المنصة == هوية_منصة.آي_أو_إس()) {
                            إذا (!ضع_حججا_متغيرة_على_المكدس_داروين_ذراع(&متغير الخطة, الثابتة)) {
                                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
                            };
                        };
                        إذا ((*الهدف).المنصة.المنصة == هوية_منصة.ويندوز()) {
                            إذا (!ضع_حججا_متغيرة_في_سجلات_ويندوز_ذراع(&متغير الخطة, الثابتة)) {
                                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
                            };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    دع المعرف_المنتقى: معرف_دالة_خارجية_منتقاة =
                        معرف_دالة_خارجية_منتقاة_من_مسير(معرف_الدالة);
                    دع هدف_الدالة: هدف_نداء_ذراع_أربعة_وستون =
                        هدف_نداء_ذراع_أربعة_وستون.دالة_خارجية(المعرف_المنتقى);
                    طابق ألحق_نداء_ذراع_بخطة(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, عدد_السجلات, الثابتة,
                        التعليمات, هدف_الدالة,
                        &النداء.الحجج, العرض.الناتج, &الخطة
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            };
        }
        | هدف_نداء_مسير.دالة_سلطان(معرف_الدالة) -> {
            طابق ابحث_دالة_مسير(المسير, معرف_الدالة) مع
            | نتيجة_بحث_دالة_مسير.مفقودة(المعرف) -> {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المعرف));
            }
            | نتيجة_بحث_دالة_مسير.موجودة(الدالة) -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != الدالة.عدد_المعاملات) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
                };
                طابق حل_واجهة_عرض_دالة_مسير_للهدف(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &الدالة
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
                }
                | نتيجة.نجح(الخطة) -> {
                    دع الدالة_المنتقاة: معرف_دالة_منتقاة = دالة_منتقاة_من_مسير(معرف_الدالة);
                    دع هدف_الدالة: هدف_نداء_ذراع_أربعة_وستون =
                        هدف_نداء_ذراع_أربعة_وستون.دالة(الدالة_المنتقاة);
                    طابق ألحق_نداء_ذراع_بخطة(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, عدد_السجلات, الثابتة,
                        التعليمات, هدف_الدالة,
                        &النداء.الحجج, العرض.الناتج, &الخطة
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
    }
    ;
    أرجع اختياري.لا_شيء();
}

عرف انتق_منهي_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    المنهي: &منهي_مسير,
    خطة_ناتج_واجهة: &اختياري خطة_ناتج_واجهة,
    عنوان_ناتج_غير_مباشر: اختياري معرف_سجل_افتراضي,
    عدد_السجلات: &متغير طبيعي,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    الخلفاء: &متغير متجه معرف_كتلة_منتقاة
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        طابق حزمة_نقل_حافة(المسير, &الحافة) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(الحزمة) -> {
            دع هدف_الحزمة: معرف_كتلة_منتقاة = الحزمة.الهدف;
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(الحزمة));
            ألحق_خلفا_ذراع_للاختيار(الخلفاء, هدف_الحزمة);
        };
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        طابق حزمة_نقل_حافة(المسير, &عند_الصواب) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(حزمة_الصواب) -> {
            طابق حزمة_نقل_حافة(المسير, &عند_الخطأ) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة.نجح(حزمة_الخطأ) -> {
                دع هدف_الصواب: معرف_كتلة_منتقاة = حزمة_الصواب.الهدف;
                دع هدف_الخطأ: معرف_كتلة_منتقاة = حزمة_الخطأ.الهدف;
                دع سجل_الشرط: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الشرط);
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(سجل_الشرط, 0));
                دع فرع_الصواب: تعليمة_ذراع_أربعة_وستون =
                    تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(
                        شرط_ذراع_أربعة_وستون.لاتكافؤ(),
                        حزمة_الصواب
                    );
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, فرع_الصواب);
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(حزمة_الخطأ));
                ألحق_خلفا_ذراع_للاختيار(الخلفاء, هدف_الصواب);
                ألحق_خلفا_ذراع_للاختيار(الخلفاء, هدف_الخطأ);
            };
        };
    }
    | منهي_مسير.فرع_متعدد(الفرع) -> {
        دع سجل_المميز: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الفرع.المميز);
        // Jump table when the shared policy accepts the switch
        // (selection_contract.sn, خطط_جدول_قفز_لفرع_متعدد).
        دع مميز_ط32_طبيعي: متغير منطقي = خطأ;
        طابق وصف_عدد_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الفرع.المميز) مع
        | اختياري.موجود(الوصف) -> { مميز_ط32_طبيعي := الوصف.البتات == 32 && !الوصف.موقع; }
        | اختياري.لا_شيء -> { };
        طابق خطط_جدول_قفز_لفرع_متعدد(&الفرع, مميز_ط32_طبيعي) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(خطة_الجدول) -> {
            دع الهدف_الافتراضي: معرف_كتلة_منتقاة = كتلة_منتقاة_من_مسير(الفرع.الافتراضي.الهدف);
            دع الأهداف: متغير متجه معرف_كتلة_منتقاة = [];
            دع موضع: متغير طبيعي = 0;
            طالما (موضع < (الطول(خطة_الجدول.الأهداف) مثل طبيعي)) {
                ألحق(الأهداف, كتلة_منتقاة_من_مسير(خطة_الجدول.الأهداف[موضع]));
                موضع := موضع + 1;
            }
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.فرع_جدولي_ذراع(
                    سجل_المميز, الأهداف, الهدف_الافتراضي, خطة_الجدول.الأدنى
                ));
            دع حالة_الخلفاء: متغير طبيعي = 0;
            طالما (حالة_الخلفاء < (الطول(الفرع.الحالات) مثل طبيعي)) {
                ألحق_خلفا_ذراع_للاختيار(الخلفاء, كتلة_منتقاة_من_مسير(الفرع.الحالات[حالة_الخلفاء].الحافة.الهدف));
                حالة_الخلفاء := حالة_الخلفاء + 1;
            }
            ألحق_خلفا_ذراع_للاختيار(الخلفاء, الهدف_الافتراضي);
            أرجع اختياري.لا_شيء();
        };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
            دع الحالة: &حالة_فرع_متعدد_مسير = &الفرع.الحالات[ف];
            دع سجل_الوسم: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
            *عدد_السجلات := *عدد_السجلات + 1;
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(سجل_الوسم, (*الحالة).الوسم));
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(سجل_المميز, سجل_الوسم));
            طابق حزمة_نقل_حافة(المسير, &(*الحالة).الحافة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة.نجح(الحزمة) -> {
                ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                    تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(
                        شرط_ذراع_أربعة_وستون.تكافؤ(), الحزمة));
                ألحق_خلفا_ذراع_للاختيار(الخلفاء, كتلة_منتقاة_من_مسير((*الحالة).الحافة.الهدف));
            };
            ف := ف + 1;
        }
        طابق حزمة_نقل_حافة(المسير, &الفرع.الافتراضي) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(الحزمة) -> {
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(الحزمة));
            ألحق_خلفا_ذراع_للاختيار(الخلفاء, كتلة_منتقاة_من_مسير(الفرع.الافتراضي.الهدف));
        };
    }
    | منهي_مسير.فخ -> {
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.فخ_ذراع());
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(المعرف) -> {
            طابق *خطة_ناتج_واجهة مع
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة()); }
            | اختياري.موجود(الخطة) -> {
                طابق الخطة.الموقع مع
                | موقع_تمرير_واجهة.متجاهل -> {
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عودة_ذراع());
                }
                | _ -> {
                    دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المعرف);
                    دع القيمة_موقعة: منطقي = ناتج_واجهة_عدد_موقع_ذراع(حقائق_الخلفية, &الخطة);
                    دع القيمة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_ذراع(
                        سجل_القيمة, &الخطة.التصنيف, &الخطة.الموقع, القيمة_موقعة
                    );
                    إذا ((القيمة.غير_مباشر != 0) && (القيمة.تجميعي == 0)) {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
                    };
                    إذا (القيمة.غير_مباشر != 0) {
                        طابق عنوان_ناتج_غير_مباشر مع
                        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة()); }
                        | اختياري.موجود(_) -> { };
                    };
                    دع الناتج: ناتج_عودة_ذراع_أربعة_وستون_منتقى = {
                        القيمة: القيمة, عنوان_ناتج_غير_مباشر: عنوان_ناتج_غير_مباشر
                    };
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عودة_ذراع_بقيمة(الناتج));
                };
            };
        }
        | اختياري.لا_شيء -> {
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عودة_ذراع());
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف انتق_كتلة_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    عدد_السجلات: &متغير طبيعي,
    خطة_ناتج_واجهة: &اختياري خطة_ناتج_واجهة,
    عنوان_ناتج_غير_مباشر: اختياري معرف_سجل_افتراضي,
    كتلة_الدخول: اختياري معرف_كتلة_مسير,
    مقدمة_الدخول: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    الدالة: معرف_دالة_مسير,
    المعرف: معرف_كتلة_مسير,
    قراءات_الطول: &متجه منطقي,
    الثابتة: &متجه منطقي
): نتيجة كتلة_ذراع_أربعة_وستون_منتقاة, فشل_اختيار_ذراع_أربعة_وستون {
    طابق ابحث_كتلة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(المفقود) -> {
        أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_كتلة(
            الدالة, المعرف, خطأ_اختيار_ذراع_أربعة_وستون.كتلة_مسير_مفقودة(المفقود)
        ));
    }
    | نتيجة_بحث_كتلة_مسير.موجودة(العرض) -> {
        دع التعليمات: متغير متجه تعليمة_ذراع_أربعة_وستون = [];
        دع أصول_التعليمات: متغير متجه مدى_أصل_تعليمات = [];
        طابق كتلة_الدخول مع
        | اختياري.موجود(المدخل) -> {
            إذا (كتلتان_مسير_متساويتان(المدخل, المعرف)) {
                // Only the entry block takes the prologue.
                بدّل((*مقدمة_الدخول), التعليمات);
            };
        }
        | اختياري.لا_شيء -> { };
        دع الخلفاء: متغير متجه معرف_كتلة_منتقاة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < العرض.عدد_التعليمات) {
            طابق تعليمة_مسير_عند(المسير, المعرف, ف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_كتلة(
                    الدالة, المعرف, خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()
                ));
            }
            | اختياري.موجود(التعليمة) -> {
                دع بداية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
                دع فئة_العملية: فئة_عملية_اختيار_ذراع = فئة_عملية_اختيار_ذراع_من(&التعليمة.العملية);
                طابق انتق_تعليمة_ذراع_أربعة_وستون(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, عدد_السجلات,
                    &التعليمة, &متغير التعليمات, قراءات_الطول, الثابتة
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_تعليمة(
                        الدالة, المعرف, ف, فئة_العملية, الخطأ
                    ));
                }
                | اختياري.لا_شيء -> { };
                دع نهاية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
                إذا (نهاية_الأصل > بداية_الأصل) {
                    طابق التعليمة.الأصل مع
                    | اختياري.موجود(الأصل) -> {
                        دع المدى: مدى_أصل_تعليمات = {
                            البداية: بداية_الأصل,
                            النهاية: نهاية_الأصل,
                            الأصل: الأصل,
                            موقع_التصحيح: التعليمة.موقع_التصحيح,
                            نطاق_التصحيح: التعليمة.نطاق_التصحيح
                        };
                        ألحق(أصول_التعليمات, المدى);
                    }
                    | اختياري.لا_شيء -> { };
                };
            };
            ف := ف + 1;
        }
        طابق منهي_كتلة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_منهي_مسير.موجود(المنهي) -> {
            طابق انتق_منهي_ذراع_أربعة_وستون(
                المسير,
                حقائق_الخلفية,
                &المنهي,
                خطة_ناتج_واجهة,
                عنوان_ناتج_غير_مباشر,
                عدد_السجلات,
                &متغير التعليمات,
                &متغير الخلفاء
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_كتلة(الدالة, المعرف, الخطأ));
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> {
            أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_كتلة(
                الدالة, المعرف, خطأ_اختيار_ذراع_أربعة_وستون.منهي_غير_مدعوم()
            ));
        };
        دع معرف_الكتلة_المنتقاة: معرف_كتلة_منتقاة = كتلة_منتقاة_من_مسير(المعرف);
        دع الرأس: رأس_كتلة_منتقاة = { المعرف: معرف_الكتلة_المنتقاة, الخلفاء: الخلفاء };
        دع الكتلة: كتلة_ذراع_أربعة_وستون_منتقاة = {
            الرأس: الرأس,
            التعليمات: التعليمات,
            أصول_التعليمات: أصول_التعليمات
        };
        أرجع نتيجة.نجح(الكتلة);
    };
}

عام عرف انتق_دالة_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_دالة_مسير
): نتيجة دالة_ذراع_أربعة_وستون_منتقاة, فشل_اختيار_ذراع_أربعة_وستون {
    دع عدد_السجلات_المسير: متغير طبيعي = 0;
    طابق عدد_سجلات_افتراضية_لمعرف_دالة_مسير(المسير, المعرف) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المعرف))); }
    | اختياري.موجود(العدد) -> { عدد_السجلات_المسير := العدد; };
    دع عدد_السجلات: متغير طبيعي = عدد_السجلات_المسير;

    دع خطة_ناتج_واجهة: متغير اختياري خطة_ناتج_واجهة = اختياري.لا_شيء();
    دع عنوان_ناتج_غير_مباشر: متغير اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
    دع كتلة_الدخول: متغير اختياري معرف_كتلة_مسير = اختياري.لا_شيء();
    دع مقدمة_الدخول: متغير متجه تعليمة_ذراع_أربعة_وستون = [];

    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
        أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المفقود)));
    }
    | نتيجة_بحث_دالة_مسير.موجودة(عرض_الدالة) -> {
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(
            حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &عرض_الدالة
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ))); }
        | نتيجة.نجح(الخطة) -> {
            دع مرجع_خطة_الناتج: &خطة_ناتج_واجهة = &الخطة.الناتج;
            خطة_ناتج_واجهة := اختياري.موجود(انسخ_مملوكا_خطة_ناتج_واجهة(مرجع_خطة_الناتج));
            كتلة_الدخول := عرض_الدالة.المدخل;

            // احجز حامل X8 الآن، لكن أجّل نقله حتى تُلتقط كل معاملات ABI.
            دع حامل_ناتج_غير_مباشر: متغير اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
            طابق الخطة.الناتج.الموقع مع
            | موقع_تمرير_واجهة.غير_مباشر(موضع_العنوان) -> {
                دع حامل: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                دع محفوظ: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات + 1);
                عدد_السجلات := عدد_السجلات + 2;
                دع المواضع: متغير متجه موضع_جزء_واجهة = [];
                ألحق(المواضع, موضع_العنوان);
                دع قيمة_الحامل: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = {
                    السجل: حامل, المواضع: المواضع, الحجم: 8,
                    تجميعي: 0, غير_مباشر: 0, بإشارة: 0
                };
                دع الاستلام: استلام_معامل_ذراع_أربعة_وستون_منتقى = { القيمة: قيمة_الحامل };
                ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(الاستلام));
                حامل_ناتج_غير_مباشر := اختياري.موجود(حامل);
                عنوان_ناتج_غير_مباشر := اختياري.موجود(محفوظ);
            }
            | _ -> { };

            // المرحلة الأولى: التقط كل حوامل ABI قبل أي تعليمة يمكن أن تمس سجلا واردا لاحقا.
            دع التجميعات_المؤجلة: متغير متجه تجهيز_معامل_تجميعي_ذراع = [];
            دع النقلات_المؤجلة: متغير متجه تجهيز_معامل_مفرد_ذراع = [];
            دع فم: متغير طبيعي = 0;
            طالما (فم < عرض_الدالة.عدد_المعاملات) {
                طابق معامل_دالة_مسير_عند(المسير, المعرف, فم) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة())); }
                | اختياري.موجود(المعامل) -> {
                    دع مرجع_خ: &خطة_معامل_واجهة = &الخطة.المعاملات[فم];
                    دع خ: خطة_معامل_واجهة = *مرجع_خ;
                    طابق خ.الموقع مع
                    | موقع_تمرير_واجهة.متجاهل -> { }
                    | _ -> {
                        دع سجل_المعامل: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المعامل.المعرف);
                        دع المعامل_موقع: منطقي = معامل_واجهة_عدد_موقع_ذراع(حقائق_الخلفية, &خ);
                        دع قيمة_الواجهة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_ذراع(
                            سجل_المعامل, &خ.التصنيف, &خ.الموقع, المعامل_موقع
                        );
                        إذا ((قيمة_الواجهة.تجميعي != 0) && (قيمة_الواجهة.غير_مباشر == 0)) {
                            دع الأجزاء: متغير متجه معرف_سجل_افتراضي = [];
                            دع أحجام_الأجزاء: متغير متجه طبيعي = [];
                            دع حجم_الوحدة_العائمة: متغير طبيعي = 8;
                            طابق خ.التصنيف.فئة_السجل مع
                            | اختياري.موجود(الفئة) -> {
                                إذا (الفئة == فئة_سجل_واجهة.عائم_متجه() &&
                                    خ.التصنيف.عدد_الأجزاء > 0) {
                                    حجم_الوحدة_العائمة := خ.التصنيف.الحجم / خ.التصنيف.عدد_الأجزاء;
                                };
                            }
                            | اختياري.لا_شيء -> { };
                            دع فج: متغير طبيعي = 0;
                            دع بداية_الجزء: متغير طبيعي = 0;
                            طالما (فج < (الطول(قيمة_الواجهة.المواضع) مثل طبيعي)) {
                                دع سجل_الجزء: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                                عدد_السجلات := عدد_السجلات + 1;
                                دع المتبقي: طبيعي = قيمة_الواجهة.الحجم - بداية_الجزء;
                                دع حجم_الجزء: متغير طبيعي = المتبقي;
                                إذا (حجم_الجزء > حجم_الوحدة_العائمة) { حجم_الجزء := حجم_الوحدة_العائمة; };
                                دع مواضع_الجزء: متغير متجه موضع_جزء_واجهة = [];
                                ألحق(مواضع_الجزء, قيمة_الواجهة.المواضع[فج]);
                                دع عرض_الحامل: طبيعي = عرض_حامل_جزء_تجميع_ذراع(حجم_الجزء);
                                دع قيمة_الجزء: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = {
                                    السجل: سجل_الجزء, المواضع: مواضع_الجزء, الحجم: عرض_الحامل,
                                    تجميعي: 0, غير_مباشر: 0, بإشارة: 0
                                };
                                دع استلام_الجزء: استلام_معامل_ذراع_أربعة_وستون_منتقى = { القيمة: قيمة_الجزء };
                                ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(استلام_الجزء));
                                ألحق(الأجزاء, سجل_الجزء);
                                ألحق(أحجام_الأجزاء, حجم_الجزء);
                                بداية_الجزء := بداية_الجزء + حجم_الجزء;
                                فج := فج + 1;
                            }
                            دع حجم_التجميع: طبيعي = خ.التصنيف.الحجم;
                            دع محاذاة_التجميع: طبيعي = خ.التصنيف.المحاذاة;
                            دع التجهيز: تجهيز_معامل_تجميعي_ذراع = {
                                المعرف: المعامل.المعرف,
                                الحجم: حجم_التجميع,
                                المحاذاة: محاذاة_التجميع,
                                الأجزاء: الأجزاء,
                                أحجام_الأجزاء: أحجام_الأجزاء
                            };
                            ألحق(التجميعات_المؤجلة, التجهيز);
                        } وإلا {
                            // التقط موضع ABI في حامل قصير العمر أولا. لا يجوز أن
                            // يظل سجل المعامل الدلالي مثبتا في X0..X7/X8 طوال حياته.
                            دع سجل_الحامل: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                            عدد_السجلات := عدد_السجلات + 1;
                            دع قيمة_الحامل: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_ذراع(
                                سجل_الحامل, &خ.التصنيف, &خ.الموقع, المعامل_موقع
                            );
                            دع الاستلام: استلام_معامل_ذراع_أربعة_وستون_منتقى = { القيمة: قيمة_الحامل };
                            ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(الاستلام));
                            دع النقل: تجهيز_معامل_مفرد_ذراع = {
                                الوجهة: سجل_المعامل,
                                الحامل: سجل_الحامل
                            };
                            ألحق(النقلات_المؤجلة, النقل);
                        };
                    };
                };
                فم := فم + 1;
            }

            // بعد اكتمال الالتقاط تصبح سجلات الدخل العادية قيما حية مرئية للمخصص.
            طابق حامل_ناتج_غير_مباشر مع
            | اختياري.موجود(الحامل) -> {
                طابق عنوان_ناتج_غير_مباشر مع
                | اختياري.موجود(المحفوظ) -> {
                    ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(المحفوظ, الحامل));
                }
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة())); };
            }
            | اختياري.لا_شيء -> { };

            // بعد التقاط جميع مواضع ABI يمكن نقل الحوامل المفردة إلى سجلات
            // المعاملات العادية بلا خطر الكتابة فوق سجل دخل لم يُلتقط بعد.
            دع فن: متغير طبيعي = 0;
            طالما (فن < (الطول(النقلات_المؤجلة) مثل طبيعي)) {
                دع مرجع_النقل: &تجهيز_معامل_مفرد_ذراع = &النقلات_المؤجلة[فن];
                دع النقل: تجهيز_معامل_مفرد_ذراع = *مرجع_النقل;
                ألحق(
                    مقدمة_الدخول,
                    تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(النقل.الوجهة, النقل.الحامل)
                );
                فن := فن + 1;
            }

            // المرحلة الثانية: ابن تخزين التجميعات المحلية من حقائق ABI التي
            // حُسمت بالفعل عند تصنيف المعامل. لا نعيد سؤال التخطيط عبر معرف MSIR.
            دع فت: متغير طبيعي = 0;
            طالما (فت < (الطول(التجميعات_المؤجلة) مثل طبيعي)) {
                دع مرجع_التجهيز: &تجهيز_معامل_تجميعي_ذراع = &التجميعات_المؤجلة[فت];
                دع التجهيز: تجهيز_معامل_تجميعي_ذراع = *مرجع_التجهيز;
                دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التجهيز.المعرف);
                دع حجم_التجميع: طبيعي = التجهيز.الحجم;
                دع محاذاة_التجميع: طبيعي = التجهيز.المحاذاة;
                دع هوية_التجميع: طبيعي = التجهيز.المعرف.القيمة;
                دع حجم_الحجز: طبيعي = حجم_حجز_تجميعي_ذراع(حجم_التجميع);
                دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                    الوجهة: سجل_القيمة,
                    الهوية: هوية_التجميع,
                    الحجم: حجم_الحجز,
                    المحاذاة: محاذاة_التجميع
                };
                ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                دع فج: متغير طبيعي = 0;
                دع إزاحة_الجزء_التالية: متغير طبيعي = 0;
                طالما (فج < (الطول(التجهيز.الأجزاء) مثل طبيعي)) {
                    دع إزاحة_الجزء_غير_الموقعة: طبيعي = إزاحة_الجزء_التالية;
                    دع إزاحة_الجزء: عدد = إزاحة_الجزء_غير_الموقعة مثل عدد;
                    دع عنوان_الجزء: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                        الأساس: سجل_القيمة, إزاحة_بايت: إزاحة_الجزء
                    };
                    ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(
                        التجهيز.الأجزاء[فج], عنوان_الجزء, التجهيز.أحجام_الأجزاء[فج]
                    ));
                    إزاحة_الجزء_التالية := إزاحة_الجزء_التالية + التجهيز.أحجام_الأجزاء[فج];
                    فج := فج + 1;
                }
                فت := فت + 1;
            }

        };
    };

    دع عدد_الكتل: متغير طبيعي = 0;
    طابق عدد_كتل_دالة_مسير_للاختيار(المسير, المعرف) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المعرف))); }
    | اختياري.موجود(العدد) -> { عدد_الكتل := العدد; };
    دع الكتل: متغير متجه كتلة_ذراع_أربعة_وستون_منتقاة = [];
    دع قراءات_الطول: متغير متجه منطقي = [];
    إذا ((المعرف.القيمة مثل طبيعي) < (الطول((*المسير).المسير.الدوال) مثل طبيعي)) {
        قراءات_الطول := تحميلات_للطول_فقط_مسير(&(*المسير).المسير.الدوال[المعرف.القيمة]);
    };
    // AArch64 has no aliased reads besides the length-only loads, which no
    // call receives: every load and read copies (empty copy facts).
    دع الثابتة: متغير متجه منطقي = [];
    إذا ((المعرف.القيمة مثل طبيعي) < (الطول((*المسير).المسير.الدوال) مثل طبيعي)) {
        دع دالة_النسخ: &دالة_مسير = &(*المسير).المسير.الدوال[المعرف.القيمة];
        دع بلا_نسخ: حقائق_نسخ_قيم_مسير = حقائق_نسخ_فارغة_مسير((*دالة_النسخ).القيمة_التالية);
        الثابتة := مخازن_ثابتة_للنداء_مسير(دالة_النسخ, &بلا_نسخ);
        دع فث: متغير طبيعي = 0;
        طالما (فث < (الطول(الثابتة) مثل طبيعي) && فث < (الطول(قراءات_الطول) مثل طبيعي)) {
            إذا (قراءات_الطول[فث]) { الثابتة[فث] := خطأ; };
            فث := فث + 1;
        }
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الكتل) {
        طابق معرف_كتلة_مسير_عند(المسير, المعرف, ف) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المعرف))); }
        | اختياري.موجود(معرف_الكتلة) -> {
            طابق انتق_كتلة_ذراع_أربعة_وستون(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير عدد_السجلات,
                &خطة_ناتج_واجهة, عنوان_ناتج_غير_مباشر,
                كتلة_الدخول, &متغير مقدمة_الدخول, المعرف, معرف_الكتلة, &قراءات_الطول, &الثابتة
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الكتلة) -> { ألحق(الكتل, الكتلة); };
        };
        ف := ف + 1;
    }
    دع معرف_الدالة_المنتقاة: معرف_دالة_منتقاة = دالة_منتقاة_من_مسير(المعرف);
    دع الرأس: رأس_دالة_منتقاة = {
        المعرف: معرف_الدالة_المنتقاة,
        عدد_السجلات_الافتراضية: عدد_السجلات
    };
    دع الدالة: دالة_ذراع_أربعة_وستون_منتقاة = { الرأس: الرأس, الكتل: الكتل };
    أرجع نتيجة.نجح(الدالة);
}

عام عرف انتق_مسير_إلى_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_اختيار_ذراع_أربعة_وستون {
    دع الوصف: واصف_هدف = *الهدف;
    طابق الوصف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | _ -> {
        أرجع نتيجة_اختيار_ذراع_أربعة_وستون.خطأ(فشل_اختيار_ذراع_عام(
            خطأ_اختيار_ذراع_أربعة_وستون.هدف_ليس_ذراع_أربعة_وستون(الوصف.المعرف)
        ));
    };

    دع الدوال: متغير متجه دالة_ذراع_أربعة_وستون_منتقاة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_اختيار_ذراع_أربعة_وستون.خطأ(فشل_اختيار_ذراع_عام(
                خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()
            ));
        }
        | اختياري.موجود(المعرف) -> {
            طابق انتق_دالة_ذراع_أربعة_وستون(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
            | نتيجة.خطأ(الخطأ) -> {
                طابق الخطأ.السبب مع
                | خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> {
                    أرجع نتيجة_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي);
                }
                | _ -> {
                    أرجع نتيجة_اختيار_ذراع_أربعة_وستون.خطأ(الخطأ);
                };
            }
            | نتيجة.نجح(الدالة) -> {
                ألحق(الدوال, الدالة);
            };
        };
        ف := ف + 1;
    }
    دع الرأس: رأس_برنامج_منتقى = { الهدف: الوصف.المعرف };
    دع الشفرة: شفرة_ذراع_أربعة_وستون_منتقاة = { الرأس: الرأس, الدوال: الدوال };
    أرجع نتيجة_اختيار_ذراع_أربعة_وستون.نجح(الشفرة);
}

// Windows on Arm64 (Microsoft's "Overview of ARM64 ABI conventions",
// "Variadic functions"): the variadic arguments of a C variadic call go in
// the integer registers after the named ones (x0-x7, floating-point ones by
// their bits as well), then in 8-byte stack slots after the named
// arguments' stack area; no variadic argument uses a v register. Each must
// be one scalar of at most 8 bytes (C promotes them so).
عرف ضع_حججا_متغيرة_في_سجلات_ويندوز_ذراع(الخطة: &متغير خطة_دالة_واجهة, الثابتة: طبيعي): منطقي {
    دع العدد: طبيعي = الطول((*الخطة).المعاملات) مثل طبيعي;
    إذا (الثابتة > العدد) { أرجع خطأ; };
    // The next integer register and the end of the named arguments' stack area.
    دع التالي: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الثابتة) {
        دع المواضع: متجه موضع_جزء_واجهة = مواضع_واجهة_ذراع(&(*الخطة).المعاملات[ف].الموقع);
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(المواضع) مثل طبيعي)) {
            طابق المواضع[ج] مع
            | موضع_جزء_واجهة.سجل(المرجع) -> {
                إذا (المرجع.الفئة == فئة_سجل_واجهة.عدد_صحيح() && المرجع.الفهرس + 1 > التالي) {
                    التالي := المرجع.الفهرس + 1;
                };
            }
            | موضع_جزء_واجهة.مكدس(الموضع) -> {
                إذا (الموضع.الإزاحة + الموضع.الحجم > النهاية) { النهاية := الموضع.الإزاحة + الموضع.الحجم; };
            };
            ج := ج + 1;
        }
        ف := ف + 1;
    }
    دع الإزاحة: متغير طبيعي = (النهاية + 7) / 8 * 8;
    ف := الثابتة;
    طالما (ف < العدد) {
        دع الحجم: طبيعي = (*الخطة).المعاملات[ف].التصنيف.الحجم;
        دع مباشر: متغير منطقي = خطأ;
        طابق (*الخطة).المعاملات[ف].الموقع مع
        | موقع_تمرير_واجهة.مباشر(_) -> { مباشر := صواب; }
        | _ -> { };
        إذا (!مباشر || (*الخطة).المعاملات[ف].التصنيف.تجميعي || الحجم == 0 || الحجم > 8) { أرجع خطأ; };
        (*الخطة).المعاملات[ف].التصنيف.فئة_السجل := اختياري.موجود(فئة_سجل_واجهة.عدد_صحيح());
        إذا (التالي < 8) {
            دع المرجع: مرجع_سجل_واجهة = {
                الفئة: فئة_سجل_واجهة.عدد_صحيح(), الفهرس: التالي,
                الدور: دور_سجل_واجهة.معامل(), الحفظ: حفظ_سجل_واجهة.متطاير_عبر_النداء()
            };
            (*الخطة).المعاملات[ف].الموقع := موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.سجل(المرجع));
            التالي := التالي + 1;
        } وإلا {
            دع الموضع: موضع_مكدس_واجهة = { الإزاحة: الإزاحة, الحجم: الحجم, المحاذاة: 8 };
            (*الخطة).المعاملات[ف].الموقع := موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.مكدس(الموضع));
            الإزاحة := الإزاحة + 8;
        };
        ف := ف + 1;
    }
    إذا (الإزاحة > (*الخطة).حجم_مكدس_النداء) { (*الخطة).حجم_مكدس_النداء := (الإزاحة + 15) / 16 * 16; };
    أرجع صواب;
}

// Apple arm64 (Apple's ARM64 Function Calling Conventions, "Variadic
// functions"): the variadic arguments of a C variadic call (MSIR
// المعاملات_الثابتة) all go on the stack, each in its own 8-byte slot, after
// the named arguments' stack area; the registers they were planned in stay
// unused. Each must be one scalar of at most 8 bytes (C promotes them so).
عرف ضع_حججا_متغيرة_على_المكدس_داروين_ذراع(الخطة: &متغير خطة_دالة_واجهة, الثابتة: طبيعي): منطقي {
    دع العدد: طبيعي = الطول((*الخطة).المعاملات) مثل طبيعي;
    إذا (الثابتة > العدد) { أرجع خطأ; };
    // The end of the named arguments' stack area.
    دع النهاية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الثابتة) {
        طابق (*الخطة).المعاملات[ف].الموقع مع
        | موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.مكدس(الموضع)) -> {
            إذا (الموضع.الإزاحة + الموضع.الحجم > النهاية) { النهاية := الموضع.الإزاحة + الموضع.الحجم; };
        }
        | موقع_تمرير_واجهة.مجزأ(المواضع) -> {
            دع ج: متغير طبيعي = 0;
            طالما (ج < (الطول(المواضع) مثل طبيعي)) {
                طابق المواضع[ج] مع
                | موضع_جزء_واجهة.مكدس(الموضع) -> {
                    إذا (الموضع.الإزاحة + الموضع.الحجم > النهاية) { النهاية := الموضع.الإزاحة + الموضع.الحجم; };
                }
                | موضع_جزء_واجهة.سجل(_) -> { };
                ج := ج + 1;
            }
        }
        | _ -> { };
        ف := ف + 1;
    }
    دع الإزاحة: متغير طبيعي = (النهاية + 7) / 8 * 8;
    ف := الثابتة;
    طالما (ف < العدد) {
        دع الحجم: طبيعي = (*الخطة).المعاملات[ف].التصنيف.الحجم;
        دع مباشر: متغير منطقي = خطأ;
        طابق (*الخطة).المعاملات[ف].الموقع مع
        | موقع_تمرير_واجهة.مباشر(_) -> { مباشر := صواب; }
        | _ -> { };
        إذا (!مباشر || (*الخطة).المعاملات[ف].التصنيف.تجميعي || الحجم == 0 || الحجم > 8) { أرجع خطأ; };
        دع الموضع: موضع_مكدس_واجهة = { الإزاحة: الإزاحة, الحجم: الحجم, المحاذاة: 8 };
        (*الخطة).المعاملات[ف].الموقع := موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.مكدس(الموضع));
        الإزاحة := الإزاحة + 8;
        ف := ف + 1;
    }
    إذا (الإزاحة > (*الخطة).حجم_مكدس_النداء) { (*الخطة).حجم_مكدس_النداء := (الإزاحة + 15) / 16 * 16; };
    أرجع صواب;
}
