عام نوع سبب_فشل_تخطيط_اختيار_ذراع =
    | استعلام_قيمة بنوع فشل_تخطيط_قيمة_للاختيار
    | بنية_تخطيط_غير_متوافقة بنوع معرف_قيمة_مسير
    | جزء_تخطيط_مفقود بنوع (معرف_قيمة_مسير, غير_موقع)
    | عرض_قيمة_غير_مدعوم بنوع (معرف_قيمة_مسير, غير_موقع)
    | حمولة_منشئ_مؤجلة بنوع (معرف_قيمة_مسير, سبب_تأجيل_تخطيط)
    | حمولة_منشئ_مرفوضة بنوع (معرف_قيمة_مسير, خطأ_تخطيط)
    | حمولة_منشئ_مفقودة بنوع (معرف_قيمة_مسير, غير_موقع)
;

عام نوع خطأ_اختيار_ذراع_أربعة_وستون =
    | هدف_ليس_ذراع_أربعة_وستون بنوع معرف_هدف
    | دالة_مسير_مفقودة بنوع معرف_دالة_مسير
    | كتلة_مسير_مفقودة بنوع معرف_كتلة_مسير
    | قيمة_مسير_مفقودة بنوع معرف_قيمة_مسير
    | ناتج_تعليمة_مفقود
    | نوع_قيمة_مفقود بنوع معرف_قيمة_مسير
    | نوع_غير_صحيح
    | عملية_غير_مدعومة
    | ثابت_غير_مدعوم
    | حساب_غير_مدعوم
    | منهي_غير_مدعوم
    | حافة_غير_صالحة بنوع معرف_كتلة_مسير
    | واجهة_دالة_غير_متاحة
    | فشل_حل_واجهة بنوع خطأ_حل_واجهة_اختيار
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | ثابت_نص_يحتاج_مقطع_بيانات
    | تخطيط_غير_متاح بنوع سبب_فشل_تخطيط_اختيار_ذراع
;

عام نوع فئة_عملية_اختيار_ذراع =
    | ثابت
    | حساب_صحيح
    | حساب_عشري
    | مقارنة_عشري
    | مقارنة_صحيح
    | تحويل_صحيح
    | مرجع_إلى_مؤشر
    | تجميع
    | تهيئة_متجه
    | استخراج_حقل
    | استخراج_فهرس
    | مكان_محلي
    | مرجع_إلى_مكان
    | صندوق_إلى_مكان
    | مكان_حقل
    | مكان_فهرس
    | موضع_تخزين_عنصر_مؤشر
    | تحميل
    | تخزين
    | مكان_إلى_مرجع
    | بناء_موسوم
    | استعلام_وسم
    | استخراج_حمولة
    | بناء_صندوق
    | نداء
;

عرف فئة_عملية_اختيار_ذراع_من(العملية: &عملية_مسير): فئة_عملية_اختيار_ذراع {
    دع الحالة: عملية_مسير = *العملية;
    طابق الحالة مع
    | عملية_مسير.ثابت(_) -> { أرجع فئة_عملية_اختيار_ذراع.ثابت(); }
    | عملية_مسير.حساب_صحيح(_) -> { أرجع فئة_عملية_اختيار_ذراع.حساب_صحيح(); }
    | عملية_مسير.حساب_عشري(_) -> { أرجع فئة_عملية_اختيار_ذراع.حساب_عشري(); }
    | عملية_مسير.مقارنة_عشري(_) -> { أرجع فئة_عملية_اختيار_ذراع.مقارنة_عشري(); }
    | عملية_مسير.مقارنة_صحيح(_) -> { أرجع فئة_عملية_اختيار_ذراع.مقارنة_صحيح(); }
    | عملية_مسير.تحويل_صحيح(_) -> { أرجع فئة_عملية_اختيار_ذراع.تحويل_صحيح(); }
    | عملية_مسير.مرجع_إلى_مؤشر(_) -> { أرجع فئة_عملية_اختيار_ذراع.مرجع_إلى_مؤشر(); }
    | عملية_مسير.تجميع(_) -> { أرجع فئة_عملية_اختيار_ذراع.تجميع(); }
    | عملية_مسير.تهيئة_متجه(_) -> { أرجع فئة_عملية_اختيار_ذراع.تهيئة_متجه(); }
    | عملية_مسير.استخراج_حقل(_) -> { أرجع فئة_عملية_اختيار_ذراع.استخراج_حقل(); }
    | عملية_مسير.استخراج_فهرس(_) -> { أرجع فئة_عملية_اختيار_ذراع.استخراج_فهرس(); }
    | عملية_مسير.مكان_محلي(_) -> { أرجع فئة_عملية_اختيار_ذراع.مكان_محلي(); }
    | عملية_مسير.مرجع_إلى_مكان(_) -> { أرجع فئة_عملية_اختيار_ذراع.مرجع_إلى_مكان(); }
    | عملية_مسير.صندوق_إلى_مكان(_) -> { أرجع فئة_عملية_اختيار_ذراع.صندوق_إلى_مكان(); }
    | عملية_مسير.مكان_حقل(_) -> { أرجع فئة_عملية_اختيار_ذراع.مكان_حقل(); }
    | عملية_مسير.مكان_فهرس(_) -> { أرجع فئة_عملية_اختيار_ذراع.مكان_فهرس(); }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(_) -> { أرجع فئة_عملية_اختيار_ذراع.موضع_تخزين_عنصر_مؤشر(); }
    | عملية_مسير.تحميل(_) -> { أرجع فئة_عملية_اختيار_ذراع.تحميل(); }
    | عملية_مسير.تخزين(_) -> { أرجع فئة_عملية_اختيار_ذراع.تخزين(); }
    | عملية_مسير.مكان_إلى_مرجع(_) -> { أرجع فئة_عملية_اختيار_ذراع.مكان_إلى_مرجع(); }
    | عملية_مسير.بناء_موسوم(_) -> { أرجع فئة_عملية_اختيار_ذراع.بناء_موسوم(); }
    | عملية_مسير.استعلام_وسم(_) -> { أرجع فئة_عملية_اختيار_ذراع.استعلام_وسم(); }
    | عملية_مسير.استخراج_حمولة(_) -> { أرجع فئة_عملية_اختيار_ذراع.استخراج_حمولة(); }
    | عملية_مسير.بناء_صندوق(_) -> { أرجع فئة_عملية_اختيار_ذراع.بناء_صندوق(); }
    | عملية_مسير.نداء(_) -> { أرجع فئة_عملية_اختيار_ذراع.نداء(); };
}

عام نوع فشل_اختيار_ذراع_أربعة_وستون = {
    الدالة: اختيار معرف_دالة_مسير,
    الكتلة: اختيار معرف_كتلة_مسير,
    فهرس_التعليمة: اختيار غير_موقع,
    العملية: اختيار فئة_عملية_اختيار_ذراع,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
};

عام نوع نتيجة_اختيار_ذراع_أربعة_وستون =
    | نجح بنوع شفرة_ذراع_أربعة_وستون_منتقاة
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | خطأ بنوع فشل_اختيار_ذراع_أربعة_وستون
;

عرف فشل_اختيار_ذراع_عام(السبب: خطأ_اختيار_ذراع_أربعة_وستون): فشل_اختيار_ذراع_أربعة_وستون {
    دع لا_دالة: اختيار معرف_دالة_مسير = اختيار.لا_شيء();
    دع لا_كتلة: اختيار معرف_كتلة_مسير = اختيار.لا_شيء();
    دع لا_فهرس: اختيار غير_موقع = اختيار.لا_شيء();
    دع لا_عملية: اختيار فئة_عملية_اختيار_ذراع = اختيار.لا_شيء();
    دع الفشل: فشل_اختيار_ذراع_أربعة_وستون = {
        الدالة: لا_دالة,
        الكتلة: لا_كتلة,
        فهرس_التعليمة: لا_فهرس,
        العملية: لا_عملية,
        السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_ذراع_في_دالة(
    الدالة: معرف_دالة_مسير,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
): فشل_اختيار_ذراع_أربعة_وستون {
    دع له_دالة: اختيار معرف_دالة_مسير = اختيار.بعض(الدالة);
    دع لا_كتلة: اختيار معرف_كتلة_مسير = اختيار.لا_شيء();
    دع لا_فهرس: اختيار غير_موقع = اختيار.لا_شيء();
    دع لا_عملية: اختيار فئة_عملية_اختيار_ذراع = اختيار.لا_شيء();
    دع الفشل: فشل_اختيار_ذراع_أربعة_وستون = {
        الدالة: له_دالة,
        الكتلة: لا_كتلة,
        فهرس_التعليمة: لا_فهرس,
        العملية: لا_عملية,
        السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_ذراع_في_كتلة(
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
): فشل_اختيار_ذراع_أربعة_وستون {
    دع له_دالة: اختيار معرف_دالة_مسير = اختيار.بعض(الدالة);
    دع له_كتلة: اختيار معرف_كتلة_مسير = اختيار.بعض(الكتلة);
    دع لا_فهرس: اختيار غير_موقع = اختيار.لا_شيء();
    دع لا_عملية: اختيار فئة_عملية_اختيار_ذراع = اختيار.لا_شيء();
    دع الفشل: فشل_اختيار_ذراع_أربعة_وستون = {
        الدالة: له_دالة,
        الكتلة: له_كتلة,
        فهرس_التعليمة: لا_فهرس,
        العملية: لا_عملية,
        السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_ذراع_في_تعليمة(
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الفهرس: غير_موقع,
    العملية: فئة_عملية_اختيار_ذراع,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
): فشل_اختيار_ذراع_أربعة_وستون {
    دع له_دالة: اختيار معرف_دالة_مسير = اختيار.بعض(الدالة);
    دع له_كتلة: اختيار معرف_كتلة_مسير = اختيار.بعض(الكتلة);
    دع له_فهرس: اختيار غير_موقع = اختيار.بعض(الفهرس);
    دع له_عملية: اختيار فئة_عملية_اختيار_ذراع = اختيار.بعض(العملية);
    دع الفشل: فشل_اختيار_ذراع_أربعة_وستون = {
        الدالة: له_دالة,
        الكتلة: له_كتلة,
        فهرس_التعليمة: له_فهرس,
        العملية: له_عملية,
        السبب: السبب
    };
    أرجع الفشل;
}

نوع تجهيز_معامل_تجميعي_ذراع = {
    المعرف: معرف_قيمة_مسير,
    الحجم: غير_موقع,
    المحاذاة: غير_موقع,
    الأجزاء: متجه معرف_سجل_افتراضي,
    أحجام_الأجزاء: متجه غير_موقع
};

نوع تجهيز_معامل_مفرد_ذراع = {
    الوجهة: معرف_سجل_افتراضي,
    الحامل: معرف_سجل_افتراضي
};

عرف سجل_لقيمة_مسير(المعرف: معرف_قيمة_مسير): معرف_سجل_افتراضي {
    أرجع معرف_سجل_افتراضي_من(المعرف.القيمة);
}

عرف إزاحة_مقياس_عنصر_ذراع(الحجم: غير_موقع): اختيار غير_موقع {
    لو (الحجم == 1) { أرجع اختيار.بعض(0); };
    لو (الحجم == 2) { أرجع اختيار.بعض(1); };
    لو (الحجم == 4) { أرجع اختيار.بعض(2); };
    لو (الحجم == 8) { أرجع اختيار.بعض(3); };
    أرجع اختيار.لا_شيء();
}

عرف دالة_منتقاة_من_مسير(المعرف: معرف_دالة_مسير): معرف_دالة_منتقاة {
    دع الناتج: معرف_دالة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عرف كتلة_منتقاة_من_مسير(المعرف: معرف_كتلة_مسير): معرف_كتلة_منتقاة {
    دع الناتج: معرف_كتلة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عرف بتات_قيمة_عائمة_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختيار غير_موقع {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع بتات_عائم_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف حساب_عشري_ذراع_من_مسير(العملية: عملية_حساب_عشري): حساب_عشري_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_حساب_عشري.جمع -> { أرجع حساب_عشري_ذراع_أربعة_وستون.جمع(); }
    | عملية_حساب_عشري.طرح -> { أرجع حساب_عشري_ذراع_أربعة_وستون.طرح(); }
    | عملية_حساب_عشري.ضرب -> { أرجع حساب_عشري_ذراع_أربعة_وستون.ضرب(); }
    | عملية_حساب_عشري.قسمة -> { أرجع حساب_عشري_ذراع_أربعة_وستون.قسمة(); };
}

عرف مقارنة_عشرية_ذراع_من_مسير(العملية: عملية_مقارنة_عشري): مقارنة_عشرية_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_مقارنة_عشري.يساوي -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.يساوي(); }
    | عملية_مقارنة_عشري.لا_يساوي -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.لا_يساوي(); }
    | عملية_مقارنة_عشري.أصغر -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.أصغر(); }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.أصغر_أو_يساوي(); }
    | عملية_مقارنة_عشري.أكبر -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.أكبر(); }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.أكبر_أو_يساوي(); };
}

عرف محمول_مقارنة_من_مسير(
    العملية: عملية_مقارنة_صحيح,
    الإشارة: صنف_إشارة_عدد_خلفية
): محمول_مقارنة_منتقى {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> {
        أرجع محمول_مقارنة_منتقى.يساوي();
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> {
        أرجع محمول_مقارنة_منتقى.لا_يساوي();
    }
    | عملية_مقارنة_صحيح.أصغر -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع محمول_مقارنة_منتقى.أصغر_موقع();
        }
        | صنف_إشارة_عدد_خلفية.غير_موقع -> {
            أرجع محمول_مقارنة_منتقى.أصغر_غير_موقع();
        };
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع محمول_مقارنة_منتقى.أصغر_أو_يساوي_موقع();
        }
        | صنف_إشارة_عدد_خلفية.غير_موقع -> {
            أرجع محمول_مقارنة_منتقى.أصغر_أو_يساوي_غير_موقع();
        };
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع محمول_مقارنة_منتقى.أكبر_موقع();
        }
        | صنف_إشارة_عدد_خلفية.غير_موقع -> {
            أرجع محمول_مقارنة_منتقى.أكبر_غير_موقع();
        };
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع محمول_مقارنة_منتقى.أكبر_أو_يساوي_موقع();
        }
        | صنف_إشارة_عدد_خلفية.غير_موقع -> {
            أرجع محمول_مقارنة_منتقى.أكبر_أو_يساوي_غير_موقع();
        };
    };
}

عرف وصف_عدد_لقيمة_مسير_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختيار وصف_عدد_ذراع_أربعة_وستون {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        طابق بتات_عدد_للاختيار(&حقائق.الأنواع, النوع) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(البتات) -> {
            طابق صنف_إشارة_عدد_للاختيار(&حقائق.الأنواع, النوع) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(الإشارة) -> {
                دع موقع: متغير منطقي = خطأ;
                طابق الإشارة مع
                | صنف_إشارة_عدد_خلفية.موقع -> { موقع := صواب; }
                | صنف_إشارة_عدد_خلفية.غير_موقع -> { };
                دع الوصف: وصف_عدد_ذراع_أربعة_وستون = { البتات: البتات, موقع: موقع };
                أرجع اختيار.بعض(الوصف);
            };
        };
    };
}

عرف وصف_تحويل_لقيمة_مسير_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختيار وصف_تحويل_صحيح_خلفية {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع وصف_نوع_لتحويل_صحيح_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف عملية_حساب_ذراع_من_مسير(العملية: عملية_حساب_صحيح): عملية_حساب_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع عملية_حساب_ذراع_أربعة_وستون.جمع(); }
    | عملية_حساب_صحيح.طرح -> { أرجع عملية_حساب_ذراع_أربعة_وستون.طرح(); }
    | عملية_حساب_صحيح.ضرب -> { أرجع عملية_حساب_ذراع_أربعة_وستون.ضرب(); }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع عملية_حساب_ذراع_أربعة_وستون.قسمة(); }
    | عملية_حساب_صحيح.قسمة_غير_موقعة -> { أرجع عملية_حساب_ذراع_أربعة_وستون.قسمة(); }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع عملية_حساب_ذراع_أربعة_وستون.باقي(); }
    | عملية_حساب_صحيح.باقي_غير_موقع -> { أرجع عملية_حساب_ذراع_أربعة_وستون.باقي(); }
    | عملية_حساب_صحيح.و_بتي -> { أرجع عملية_حساب_ذراع_أربعة_وستون.و_بتي(); }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع عملية_حساب_ذراع_أربعة_وستون.أو_بتي(); }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع عملية_حساب_ذراع_أربعة_وستون.أو_حصري(); }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع عملية_حساب_ذراع_أربعة_وستون.إزاحة_يسرى(); }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع عملية_حساب_ذراع_أربعة_وستون.إزاحة_يمنى_منطقية(); }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع عملية_حساب_ذراع_أربعة_وستون.إزاحة_يمنى_حسابية(); };
}

عرف عملية_تحويل_ذراع_من_مسير(العملية: عملية_تحويل_صحيح): عملية_تحويل_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع عملية_تحويل_ذراع_أربعة_وستون.توسيع_بإشارة(); }
    | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع عملية_تحويل_ذراع_أربعة_وستون.توسيع_صفري(); }
    | عملية_تحويل_صحيح.اقتطاع -> { أرجع عملية_تحويل_ذراع_أربعة_وستون.اقتطاع(); }
    | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع عملية_تحويل_ذراع_أربعة_وستون.إعادة_تفسير(); };
}

عرف مواضع_واجهة_ذراع(الموقع: &موقع_تمرير_واجهة): متجه موضع_جزء_واجهة {
    دع الناتج: متغير متجه موضع_جزء_واجهة = [];
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الموضع) -> { ألحق(الناتج, الموضع); }
    | موقع_تمرير_واجهة.مجزأ(المواضع) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المواضع) مثل غير_موقع)) { ألحق(الناتج, المواضع[ف]); ف := ف + 1; }
    }
    | موقع_تمرير_واجهة.غير_مباشر(الموضع) -> { ألحق(الناتج, الموضع); }
    | موقع_تمرير_واجهة.متجاهل -> { };
    أرجع الناتج;
}

عرف موقع_واجهة_غير_مباشر_ذراع(الموقع: &موقع_تمرير_واجهة): منطقي {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف معامل_واجهة_عدد_موقع_ذراع(
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الخطة: &خطة_معامل_واجهة
): منطقي {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
    دع خ: خطة_معامل_واجهة = *الخطة;
    طابق صنف_إشارة_عدد_للاختيار(&حقائق.الأنواع, خ.النوع) مع
    | اختيار.بعض(صنف_إشارة_عدد_خلفية.موقع) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف ناتج_واجهة_عدد_موقع_ذراع(
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الخطة: &خطة_ناتج_واجهة
): منطقي {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
    دع خ: خطة_ناتج_واجهة = *الخطة;
    طابق صنف_إشارة_عدد_للاختيار(&حقائق.الأنواع, خ.النوع) مع
    | اختيار.بعض(صنف_إشارة_عدد_خلفية.موقع) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف علم_واجهة_ذراع(القيمة: منطقي): غير_موقع {
    لو (القيمة) { أرجع 1; };
    أرجع 0;
}

عرف قيمة_واجهة_من_خطة_ذراع(
    السجل: معرف_سجل_افتراضي,
    التصنيف: &تصنيف_قيمة_واجهة,
    الموقع: &موقع_تمرير_واجهة,
    بإشارة: منطقي
): قيمة_واجهة_ذراع_أربعة_وستون_منتقاة {
    دع ت: تصنيف_قيمة_واجهة = *التصنيف;
    دع المواضع: متجه موضع_جزء_واجهة = مواضع_واجهة_ذراع(الموقع);
    دع غير_مباشر: منطقي = موقع_واجهة_غير_مباشر_ذراع(الموقع);
    دع علم_تجميعي: غير_موقع = علم_واجهة_ذراع(ت.تجميعي);
    دع علم_غير_مباشر: غير_موقع = علم_واجهة_ذراع(غير_مباشر);
    دع علم_بإشارة: غير_موقع = علم_واجهة_ذراع(بإشارة);
    دع الناتج: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = {
        السجل: السجل,
        المواضع: المواضع,
        الحجم: ت.الحجم,
        تجميعي: علم_تجميعي,
        غير_مباشر: علم_غير_مباشر,
        بإشارة: علم_بإشارة
    };
    أرجع الناتج;
}

عرف تخطيط_قيمة_مسير_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير
): نتيجة_تخطيط_قيمة_للاختيار {
    أرجع تخطيط_قيمة_مسير_للاختيار(
        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, القيمة
    );
}

عرف خطأ_استعلام_تخطيط_ذراع(
    الفشل: فشل_تخطيط_قيمة_للاختيار
): خطأ_اختيار_ذراع_أربعة_وستون {
    أرجع خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
        سبب_فشل_تخطيط_اختيار_ذراع.استعلام_قيمة(الفشل)
    );
}

عرف تخطيط_تجميعي_ذراع(التخطيط: &واصف_تخطيط): منطقي {
    دع الوصف: واصف_تخطيط = *التخطيط;
    طابق الوصف.التفاصيل مع
    | تفاصيل_تخطيط.صف(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.سجل(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.تعداد(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}
عرف حجم_حجز_إطار_ذراع(التخطيط: &واصف_تخطيط): غير_موقع {
    دع الوصف: واصف_تخطيط = *التخطيط;
    لو (!تخطيط_تجميعي_ذراع(التخطيط)) { أرجع الوصف.الحجم; };
    لو (الوصف.الحجم == 0) { أرجع 0; };
    أرجع ((الوصف.الحجم + 7) / 8) * 8;
}

عرف حجم_حجز_تجميعي_ذراع(الحجم: غير_موقع): غير_موقع {
    لو (الحجم == 0) { أرجع 0; };
    أرجع ((الحجم + 7) / 8) * 8;
}

// حامل جزء ABI قيمة سجلية، لذلك يجب أن يستخدم عرض تحميل/تخزين ARM64
// قابلا للترميز. الحجم الحقيقي للجزء يبقى مستقلا ويستخدم عند إعادة بناء التجميع.
عرف عرض_حامل_جزء_تجميع_ذراع(الحجم: غير_موقع): غير_موقع {
    لو (الحجم <= 1) { أرجع 1; };
    لو (الحجم <= 2) { أرجع 2; };
    لو (الحجم <= 4) { أرجع 4; };
    أرجع 8;
}


عرف جزء_تخطيط_عند_ذراع(
    التخطيط: &واصف_تخطيط,
    الفهرس: غير_موقع
): اختيار موضع_جزء_تخطيط {
    دع الوصف: واصف_تخطيط = *التخطيط;
    طابق الوصف.التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        لو (الفهرس < (الطول(الأجزاء) مثل غير_موقع)) { أرجع اختيار.بعض(الأجزاء[الفهرس]); };
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        لو (الفهرس < (الطول(الأجزاء) مثل غير_موقع)) { أرجع اختيار.بعض(الأجزاء[الفهرس]); };
    }
    | _ -> { };
    أرجع اختيار.لا_شيء();
}

عرف أضف_عنوان_عنصر_تسلسل_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المصدر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير,
    تخطيط_العنصر: &واصف_تخطيط,
    الوجهة: معرف_سجل_افتراضي,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختيار خطأ_اختيار_ذراع_أربعة_وستون {
    دع تخطيط_المصدر: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المصدر) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المصدر := التخطيط; };

    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المصدر, 0) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المصدر, 0)
        ));
    }
    | اختيار.بعض(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المصدر, 1) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المصدر, 1)
        ));
    }
    | اختيار.بعض(الجزء) -> { جزء_الطول := الجزء; };

    لو (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة) {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المصدر)
        ));
    };
    دع حجم_مؤشر_البيانات: غير_موقع = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
    لو (حجم_مؤشر_البيانات != 8) {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(المصدر, حجم_مؤشر_البيانات)
        ));
    };

    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المصدر);
    دع إزاحة_البيانات: عدد = جزء_البيانات.الإزاحة مثل عدد;
    دع عنوان_البيانات: عنوان_ذاكرة_ذراع_أربعة_وستون = {
        الأساس: سجل_المصدر, إزاحة_بايت: إزاحة_البيانات
    };
    دع الحالة: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
    ألحق(الحالة, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
        الوجهة, عنوان_البيانات, حجم_مؤشر_البيانات, خطأ
    ));
    دع وصف_العنصر: واصف_تخطيط = *تخطيط_العنصر;
    ألحق(الحالة, تعليمة_ذراع_أربعة_وستون.عنوان_عنصر_ذراع(
        الوجهة, الوجهة, سجل_لقيمة_مسير(الفهرس), وصف_العنصر.الحجم
    ));
    *التعليمات := الحالة;
    أرجع اختيار.لا_شيء();
}

عرف أضف_تخزين_قيمة_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الأساس: معرف_سجل_افتراضي,
    الإزاحة: غير_موقع,
    القيمة: معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختيار خطأ_اختيار_ذراع_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, القيمة) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        دع حالة: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
        دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(القيمة);
        لو (تخطيط_تجميعي_ذراع(&التخطيط)) {
            ألحق(
                حالة,
                تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(
                    الأساس, سجل_القيمة, التخطيط.الحجم, الإزاحة, 0
                )
            );
        } وإلا {
            لو (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
                أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                    سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(القيمة, التخطيط.الحجم)
                ));
            };
            دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
            دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: الأساس, إزاحة_بايت: الإزاحة_الموقعة };
            ألحق(حالة, تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(
                سجل_القيمة, العنوان, التخطيط.الحجم
            ));
        };
        *التعليمات := حالة;
        أرجع اختيار.لا_شيء();
    };
}

عرف أضف_استخراج_من_عنوان_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    الأساس: معرف_سجل_افتراضي,
    الإزاحة: غير_موقع,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختيار خطأ_اختيار_ذراع_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        دع حالة: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
        دع و: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
        لو (تخطيط_تجميعي_ذراع(&التخطيط)) {
            // استخراج الحمولة ينتج قيمة تجميعية مستقلة، لا اسما مستعارا داخل مخزن التعداد.
            // هذا يطابق دلالة استخراج الفهرس ويمنع فساد الحمولة عند عبور حدود النداء.
            دع حجم_الحجز: غير_موقع = حجم_حجز_إطار_ذراع(&التخطيط);
            دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                الوجهة: و,
                الهوية: الناتج.القيمة,
                الحجم: حجم_الحجز,
                المحاذاة: التخطيط.المحاذاة
            };
            ألحق(حالة, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
            ألحق(
                حالة,
                تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(
                    و, الأساس, التخطيط.الحجم, 0, الإزاحة
                )
            );
        } وإلا {
            لو (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
                أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                    سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, التخطيط.الحجم)
                ));
            };
            دع بإشارة: متغير منطقي = خطأ;
            طابق وصف_عدد_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الناتج) مع
            | اختيار.بعض(وصف) -> { بإشارة := وصف.موقع; }
            | اختيار.لا_شيء -> { };
            دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
            دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: الأساس, إزاحة_بايت: الإزاحة_الموقعة };
            ألحق(حالة, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(و, العنوان, التخطيط.الحجم, بإشارة));
        };
        *التعليمات := حالة;
        أرجع اختيار.لا_شيء();
    };
}

عرف ألحق_تهيئة_متجه_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    التهيئة: &تهيئة_متجه_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختيار خطأ_اختيار_ذراع_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        لو (!تخطيط_تجميعي_ذراع(&التخطيط)) {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج)
            ));
        };
        دع جزء_البيانات: موضع_جزء_تخطيط;
        دع جزء_الطول: موضع_جزء_تخطيط;
        دع جزء_السعة: موضع_جزء_تخطيط;
        طابق جزء_تخطيط_عند_ذراع(&التخطيط, 0) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 0)
            ));
        }
        | اختيار.بعض(الجزء) -> { جزء_البيانات := الجزء; };
        طابق جزء_تخطيط_عند_ذراع(&التخطيط, 1) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 1)
            ));
        }
        | اختيار.بعض(الجزء) -> { جزء_الطول := الجزء; };
        طابق جزء_تخطيط_عند_ذراع(&التخطيط, 2) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 2)
            ));
        }
        | اختيار.بعض(الجزء) -> { جزء_السعة := الجزء; };
        لو (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة
            || جزء_السعة.الإزاحة <= جزء_الطول.الإزاحة
            || التخطيط.الحجم <= جزء_السعة.الإزاحة) {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج)
            ));
        };
        دع حجم_البيانات: غير_موقع = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
        دع حجم_الطول: غير_موقع = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
        دع حجم_السعة: غير_موقع = التخطيط.الحجم - جزء_السعة.الإزاحة;
        لو (!(حجم_البيانات == 1 || حجم_البيانات == 2 || حجم_البيانات == 4 || حجم_البيانات == 8)) {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, حجم_البيانات)
            ));
        };
        لو (!(حجم_الطول == 1 || حجم_الطول == 2 || حجم_الطول == 4 || حجم_الطول == 8)) {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, حجم_الطول)
            ));
        };
        لو (!(حجم_السعة == 1 || حجم_السعة == 2 || حجم_السعة == 4 || حجم_السعة == 8)) {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, حجم_السعة)
            ));
        };
        دع حالة: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
        دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
        دع حجم_الحجز: غير_موقع = حجم_حجز_إطار_ذراع(&التخطيط);
        دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
            الوجهة: الوجهة,
            الهوية: الناتج.القيمة,
            الحجم: حجم_الحجز,
            المحاذاة: التخطيط.المحاذاة
        };
        ألحق(حالة, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
        دع صفر_البيانات: تخزين_فوري_ذراع_أربعة_وستون = {
            الأساس: الوجهة,
            الإزاحة: جزء_البيانات.الإزاحة,
            الحجم: حجم_البيانات,
            القيمة: 0
        };
        ألحق(حالة, تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(صفر_البيانات));
        دع صفر_الطول: تخزين_فوري_ذراع_أربعة_وستون = {
            الأساس: الوجهة,
            الإزاحة: جزء_الطول.الإزاحة,
            الحجم: حجم_الطول,
            القيمة: 0
        };
        ألحق(حالة, تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(صفر_الطول));
        دع صفر_السعة: تخزين_فوري_ذراع_أربعة_وستون = {
            الأساس: الوجهة,
            الإزاحة: جزء_السعة.الإزاحة,
            الحجم: حجم_السعة,
            القيمة: 0
        };
        ألحق(حالة, تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(صفر_السعة));
        // append ليس نداء Sultan عادي: يحتاج عنوان رأس المتجه مع حقائق Layout
        // وسياسة نمو Runtime. نحمله كتعليمة آلة مخصصة ثم encoder يمرر metadata المخفية.
        لو (!(حجم_البيانات == 8 && حجم_الطول == 8 && حجم_السعة == 8)) {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج)
            ));
        };
        دع سياسة_النمو: سياسة_نمو_متجه = سياسة_نمو_المتجه();
        دع وصف_التهيئة: تهيئة_متجه_مسير = *التهيئة;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(وصف_التهيئة.العناصر) مثل غير_موقع)) {
            دع العنصر: معرف_قيمة_مسير = وصف_التهيئة.العناصر[ف];
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العنصر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_العنصر) -> {
                أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_العنصر));
            }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_العنصر) -> {
                لو (تخطيط_العنصر.الحجم == 0) {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                        سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(العنصر, 0)
                    ));
                };
                لو (!تخطيط_تجميعي_ذراع(&تخطيط_العنصر)
                    && !(تخطيط_العنصر.الحجم == 1 || تخطيط_العنصر.الحجم == 2
                        || تخطيط_العنصر.الحجم == 4 || تخطيط_العنصر.الحجم == 8)) {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                        سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(العنصر, تخطيط_العنصر.الحجم)
                    ));
                };
                دع سجل_العنصر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(العنصر);
                دع العنصر_تجميعي: منطقي = تخطيط_تجميعي_ذراع(&تخطيط_العنصر);
                دع الإلحاق: إلحاق_متجه_ذراع_أربعة_وستون = {
                    المتجه: الوجهة,
                    العنصر: سجل_العنصر,
                    إزاحة_البيانات: جزء_البيانات.الإزاحة,
                    إزاحة_الطول: جزء_الطول.الإزاحة,
                    إزاحة_السعة: جزء_السعة.الإزاحة,
                    حجم_الطول: حجم_الطول,
                    حجم_السعة: حجم_السعة,
                    حجم_العنصر: تخطيط_العنصر.الحجم,
                    العنصر_تجميعي: العنصر_تجميعي,
                    السعة_الدنيا: سياسة_النمو.السعة_الدنيا,
                    عامل_النمو: سياسة_النمو.عامل_النمو
                };
                ألحق(حالة, تعليمة_ذراع_أربعة_وستون.إلحاق_متجه_ذراع(الإلحاق));
            };
            ف := ف + 1;
        }
        *التعليمات := حالة;
        أرجع اختيار.لا_شيء();
    };
}


عرف ألحق_إلحاق_متجه_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المتجه: معرف_قيمة_مسير,
    العنصر: معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختيار خطأ_اختيار_ذراع_أربعة_وستون {
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المتجه) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المتجه := التخطيط; };
    لو (!تخطيط_تجميعي_ذراع(&تخطيط_المتجه)) {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المتجه)
        ));
    };
    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    دع جزء_السعة: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 0) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المتجه, 0))); }
    | اختيار.بعض(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 1) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المتجه, 1))); }
    | اختيار.بعض(الجزء) -> { جزء_الطول := الجزء; };
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 2) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المتجه, 2))); }
    | اختيار.بعض(الجزء) -> { جزء_السعة := الجزء; };
    لو (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة
        || جزء_السعة.الإزاحة <= جزء_الطول.الإزاحة
        || تخطيط_المتجه.الحجم <= جزء_السعة.الإزاحة) {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المتجه)
        ));
    };
    دع حجم_البيانات: غير_موقع = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
    دع حجم_الطول: غير_موقع = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
    دع حجم_السعة: غير_موقع = تخطيط_المتجه.الحجم - جزء_السعة.الإزاحة;
    لو (!(حجم_البيانات == 8 && حجم_الطول == 8 && حجم_السعة == 8)) {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المتجه)
        ));
    };
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العنصر) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_العنصر) -> {
        لو (تخطيط_العنصر.الحجم == 0) {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(العنصر, 0)
            ));
        };
        لو (!تخطيط_تجميعي_ذراع(&تخطيط_العنصر)
            && !(تخطيط_العنصر.الحجم == 1 || تخطيط_العنصر.الحجم == 2
                || تخطيط_العنصر.الحجم == 4 || تخطيط_العنصر.الحجم == 8)) {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(العنصر, تخطيط_العنصر.الحجم)
            ));
        };
        دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه();
        دع سجل_المتجه: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المتجه);
        دع سجل_العنصر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(العنصر);
        دع العنصر_تجميعي: منطقي = تخطيط_تجميعي_ذراع(&تخطيط_العنصر);
        دع الإلحاق: إلحاق_متجه_ذراع_أربعة_وستون = {
            المتجه: سجل_المتجه, العنصر: سجل_العنصر,
            إزاحة_البيانات: جزء_البيانات.الإزاحة, إزاحة_الطول: جزء_الطول.الإزاحة,
            إزاحة_السعة: جزء_السعة.الإزاحة, حجم_الطول: حجم_الطول, حجم_السعة: حجم_السعة,
            حجم_العنصر: تخطيط_العنصر.الحجم, العنصر_تجميعي: العنصر_تجميعي,
            السعة_الدنيا: السياسة.السعة_الدنيا, عامل_النمو: السياسة.عامل_النمو
        };
        دع حالة: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
        ألحق(حالة, تعليمة_ذراع_أربعة_وستون.إلحاق_متجه_ذراع(الإلحاق));
        *التعليمات := حالة;
        أرجع اختيار.لا_شيء();
    };
}

عرف حزمة_نقل_حافة(
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير
): نتيجة متطلبات_نقل_حافة_منتقاة, خطأ_اختيار_ذراع_أربعة_وستون {
    دع القيمة: حافة_مسير = *الحافة;
    طابق ابحث_كتلة_مسير(المسير, القيمة.الهدف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(المعرف) -> {
        أرجع نتيجة.خطأ(خطأ_اختيار_ذراع_أربعة_وستون.كتلة_مسير_مفقودة(المعرف));
    }
    | نتيجة_بحث_كتلة_مسير.موجودة(الهدف) -> {
        لو ((الطول(القيمة.الحجج) مثل غير_موقع) != الهدف.عدد_المعاملات) {
            أرجع نتيجة.خطأ(خطأ_اختيار_ذراع_أربعة_وستون.حافة_غير_صالحة(القيمة.الهدف));
        };
        دع النقلات: متغير متجه نقلة_حافة_منتقاة = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الهدف.عدد_المعاملات) {
            طابق معامل_كتلة_مسير_عند(المسير, القيمة.الهدف, ف) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(
                    خطأ_اختيار_ذراع_أربعة_وستون.حافة_غير_صالحة(القيمة.الهدف)
                );
            }
            | اختيار.بعض(المعامل) -> {
                دع مصدر_النقلة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(القيمة.الحجج[ف]);
                دع وجهة_النقلة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المعامل.المعرف);
                دع النقلة: نقلة_حافة_منتقاة = {
                    المصدر: مصدر_النقلة,
                    الوجهة: وجهة_النقلة
                };
                ألحق(النقلات, النقلة);
            };
            ف := ف + 1;
        }
        دع هدف_الحزمة: معرف_كتلة_منتقاة = كتلة_منتقاة_من_مسير(القيمة.الهدف);
        دع الحزمة: متطلبات_نقل_حافة_منتقاة = {
            الهدف: هدف_الحزمة,
            النقلات: النقلات
        };
        أرجع نتيجة.نجح(الحزمة);
    };
}

عرف ألحق_نداء_ذراع_بخطة(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    هدف_النداء: هدف_نداء_ذراع_أربعة_وستون,
    حجج_المسير: &متجه معرف_قيمة_مسير,
    ناتج_المسير: اختيار معرف_قيمة_مسير,
    الخطة: &خطة_دالة_واجهة
): اختيار خطأ_اختيار_ذراع_أربعة_وستون {
    دع خ: خطة_دالة_واجهة = *الخطة;
    دع قيم_الحجج: متجه معرف_قيمة_مسير = *حجج_المسير;
    دع عدد_قيم_الحجج: غير_موقع = الطول(قيم_الحجج) مثل غير_موقع;
    دع عدد_المعاملات: غير_موقع = الطول(خ.المعاملات) مثل غير_موقع;
    لو (عدد_قيم_الحجج != عدد_المعاملات) {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
    };
    دع الحجج: متغير متجه قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_قيم_الحجج) {
        دع مرجع_خطة_المعامل: &خطة_معامل_واجهة = &خ.المعاملات[ف];
        دع خطة_المعامل: خطة_معامل_واجهة = *مرجع_خطة_المعامل;
        طابق خطة_المعامل.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> {
            دع قيمة_الحجة: معرف_قيمة_مسير = قيم_الحجج[ف];
            دع سجل_الحجة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(قيمة_الحجة);
            دع الحجة_موقعة: منطقي = معامل_واجهة_عدد_موقع_ذراع(حقائق_الخلفية, &خطة_المعامل);
            دع الحجة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_ذراع(
                سجل_الحجة, &خطة_المعامل.التصنيف, &خطة_المعامل.الموقع, الحجة_موقعة
            );
            ألحق(الحجج, الحجة);
        };
        ف := ف + 1;
    }

    دع الناتج: متغير اختيار قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = اختيار.لا_شيء();
    طابق ناتج_المسير مع
    | اختيار.لا_شيء -> {
        طابق خ.الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة()); };
    }
    | اختيار.بعض(المعرف) -> {
        طابق خ.الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> {
            دع سجل_الناتج: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المعرف);
            دع الناتج_موقع: منطقي = ناتج_واجهة_عدد_موقع_ذراع(حقائق_الخلفية, &خ.الناتج);
            دع الناتج_المختار: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_ذراع(
                سجل_الناتج, &خ.الناتج.التصنيف, &خ.الناتج.الموقع, الناتج_موقع
            );
            لو (الناتج_المختار.تجميعي != 0) {
                دع حجم_التجميع: غير_موقع = خ.الناتج.التصنيف.الحجم;
                دع محاذاة_التجميع: غير_موقع = خ.الناتج.التصنيف.المحاذاة;
                دع هوية_التجميع: غير_موقع = المعرف.القيمة;
                دع حجم_الحجز: غير_موقع = حجم_حجز_تجميعي_ذراع(حجم_التجميع);
                دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                    الوجهة: سجل_الناتج,
                    الهوية: هوية_التجميع,
                    الحجم: حجم_الحجز,
                    المحاذاة: محاذاة_التجميع
                };
                دع حالة_الحجز: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
                دع تعليمة_الحجز: تعليمة_ذراع_أربعة_وستون =
                    تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز);
                ألحق(حالة_الحجز, تعليمة_الحجز);
                *التعليمات := حالة_الحجز;
            };
            الناتج := اختيار.بعض(الناتج_المختار);
        };
    };

    دع النداء: نداء_ذراع_أربعة_وستون_منتقى = {
        الهدف: هدف_النداء,
        الحجج: الحجج,
        الناتج: الناتج,
        حجم_مكدس_النداء: خ.حجم_مكدس_النداء
    };
    دع حالة: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
    دع تعليمة_النداء: تعليمة_ذراع_أربعة_وستون =
        تعليمة_ذراع_أربعة_وستون.فرع_برابط_ذراع_مباشر(النداء);
    ألحق(حالة, تعليمة_النداء);
    *التعليمات := حالة;
    أرجع اختيار.لا_شيء();
}

عرف ألحق_بدائي_هوية_مضيف_ذراع(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختيار معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختيار خطأ_اختيار_ذراع_أربعة_وستون {
    لو ((الطول(*الحجج) مثل غير_موقع) != 0) {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    دع معرف_الناتج: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
    }
    | اختيار.بعض(المعرف) -> { معرف_الناتج := المعرف; };
    طابق رمز_بدائي_هوية_مضيف_للهدف(الهدف, البدائي) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    }
    | اختيار.بعض(الرمز) -> {
        دع الحالة: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
        ألحق(
            الحالة,
            تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_غير_موقع(
                سجل_لقيمة_مسير(معرف_الناتج), الرمز مثل غير_موقع
            )
        );
        *التعليمات := الحالة;
        أرجع اختيار.لا_شيء();
    };
}

عرف انتق_تعليمة_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    عدد_السجلات: &متغير غير_موقع,
    التعليمة: &عرض_تعليمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختيار خطأ_اختيار_ذراع_أربعة_وستون {
    دع حالة_التعليمات: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
    دع العرض: عرض_تعليمة_مسير = *التعليمة;
    طابق العرض.العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختيار.بعض(الناتج) -> {
            دع السجل: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
            طابق الثابت مع
            | ثابت_مسير.صحيح_موقع(القيمة) -> {
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(السجل, القيمة));
            }
            | ثابت_مسير.صحيح_غير_موقع(القيمة) -> {
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_غير_موقع(السجل, القيمة));
            }
            | ثابت_مسير.منطق(القيمة) -> {
                لو (القيمة) {
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(السجل, 1));
                }
                وإلا {
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(السجل, 0));
                };
            }
            | ثابت_مسير.عشري(البايتات) -> {
                دع العرض_عائم: متغير غير_موقع = 0;
                طابق بتات_قيمة_عائمة_ذراع(المسير, حقائق_الخلفية, الناتج) مع
                | اختيار.بعض(ب) -> { العرض_عائم := ب; }
                | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ثابت_غير_مدعوم()); };
                طابق بتات_عائم_من_عشري(&البايتات, العرض_عائم) مع
                | اختيار.بعض(الخام) -> {
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_غير_موقع(السجل, الخام));
                }
                | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ثابت_غير_مدعوم()); };
            }
            | ثابت_مسير.دالة(الدالة) -> {
                دع الهدف_المنتقى: معرف_دالة_منتقاة = دالة_منتقاة_من_مسير(الدالة);
                ألحق(
                    حالة_التعليمات,
                    تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(السجل, الهدف_المنتقى)
                );
            }
            | ثابت_مسير.نص(البايتات) -> {
                طابق تخطيط_قيمة_مسير_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج
                ) مع
                | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                    أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
                }
                | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                    لو (!تخطيط_تجميعي_ذراع(&التخطيط)) {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج)
                        ));
                    };
                    دع إزاحة_البيانات: متغير غير_موقع = 0;
                    دع إزاحة_الطول: متغير غير_موقع = 0;
                    دع إزاحة_السعة: متغير غير_موقع = 0;
                    طابق جزء_تخطيط_عند_ذراع(&التخطيط, 0) مع
                    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 0))); }
                    | اختيار.بعض(الجزء_الأول) -> { إزاحة_البيانات := الجزء_الأول.الإزاحة; };
                    طابق جزء_تخطيط_عند_ذراع(&التخطيط, 1) مع
                    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 1))); }
                    | اختيار.بعض(الجزء_الثاني) -> { إزاحة_الطول := الجزء_الثاني.الإزاحة; };
                    طابق جزء_تخطيط_عند_ذراع(&التخطيط, 2) مع
                    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 2))); }
                    | اختيار.بعض(الجزء_الثالث) -> { إزاحة_السعة := الجزء_الثالث.الإزاحة; };
                    دع حجم_الحجز: غير_موقع = حجم_حجز_إطار_ذراع(&التخطيط);
                    دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                        الوجهة: السجل,
                        الهوية: الناتج.القيمة,
                        الحجم: حجم_الحجز,
                        المحاذاة: التخطيط.المحاذاة
                    };
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                    دع الثابت_النصي: ثابت_نص_ذراع_أربعة_وستون = {
                        الوجهة: السجل,
                        الهوية: الناتج.القيمة,
                        البايتات: البايتات,
                        إزاحة_البيانات: إزاحة_البيانات,
                        إزاحة_الطول: إزاحة_الطول,
                        إزاحة_السعة: إزاحة_السعة
                    };
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.ثابت_نص_ذراع(الثابت_النصي));
                };
            };
        };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق وصف_تحويل_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, التحويل.المصدر) مع
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); }
            | اختيار.بعض(وصف_المصدر) -> {
                طابق وصف_تحويل_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الناتج) مع
                | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); }
                | اختيار.بعض(وصف_الناتج) -> {
                    دع العملية_المختارة: عملية_تحويل_ذراع_أربعة_وستون = عملية_تحويل_ذراع_من_مسير(التحويل.العملية);
                    دع سجل_الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التحويل.المصدر);
                    دع المختار: تحويل_صحيح_ذراع_أربعة_وستون = {
                        العملية: العملية_المختارة,
                        الوجهة: سجل_الوجهة,
                        المصدر: سجل_المصدر,
                        بتات_المصدر: وصف_المصدر.البتات,
                        بتات_الوجهة: وصف_الناتج.البتات,
                        المصدر_موقع: وصف_المصدر.موقع,
                        الوجهة_موقع: وصف_الناتج.موقع
                    };
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.تحويل_صحيح_ذراع(المختار));
                };
            };
        };
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختيار.بعض(الناتج) -> {
            ألحق(
                حالة_التعليمات,
                تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(
                    سجل_لقيمة_مسير(الناتج),
                    سجل_لقيمة_مسير(التحويل.المرجع)
                )
            );
        };
    }
    | عملية_مسير.تجميع(التجميع) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                دع حجم_الحجز: غير_موقع = حجم_حجز_إطار_ذراع(&التخطيط);
                دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                    الوجهة: الوجهة, الهوية: الناتج.القيمة,
                    الحجم: حجم_الحجز, المحاذاة: التخطيط.المحاذاة
                };
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(التجميع.الأعضاء) مثل غير_موقع)) {
                    طابق جزء_تخطيط_عند_ذراع(&التخطيط, ف) مع
                    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, ف))); }
                    | اختيار.بعض(الجزء) -> {
                        طابق أضف_تخزين_قيمة_ذراع(
                            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                            الوجهة, الجزء.الإزاحة, التجميع.الأعضاء[ف], &متغير حالة_التعليمات
                        ) مع
                        | اختيار.بعض(خطأ_التخطيط) -> { أرجع اختيار.بعض(خطأ_التخطيط); }
                        | اختيار.لا_شيء -> { };
                    };
                    ف := ف + 1;
                }
            };
        };
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختيار.بعض(الناتج) -> {
            *التعليمات := حالة_التعليمات;
            طابق ألحق_تهيئة_متجه_ذراع(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                الناتج, &التهيئة, التعليمات
            ) مع
            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | اختيار.لا_شيء -> { };
            حالة_التعليمات := *التعليمات;
        };
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الاستخراج.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المصدر) -> {
                طابق جزء_تخطيط_عند_ذراع(&تخطيط_المصدر, الاستخراج.الفهرس) مع
                | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الاستخراج.المصدر, الاستخراج.الفهرس))); }
                | اختيار.بعض(الجزء) -> {
                    طابق أضف_استخراج_من_عنوان_ذراع(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                        الناتج, سجل_لقيمة_مسير(الاستخراج.المصدر), الجزء.الإزاحة,
                        &متغير حالة_التعليمات
                    ) مع
                    | اختيار.بعض(خطأ_التخطيط) -> { أرجع اختيار.بعض(خطأ_التخطيط); }
                    | اختيار.لا_شيء -> { };
                };
            };
        };
    }
    | عملية_مسير.استخراج_فهرس(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الناتج) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                دع تجميعي: منطقي = تخطيط_تجميعي_ذراع(&تخطيط_الناتج);
                دع سجل_العنوان: متغير معرف_سجل_افتراضي = الوجهة;
                لو (تجميعي) {
                    دع التالي: غير_موقع = *عدد_السجلات;
                    سجل_العنوان := معرف_سجل_افتراضي_من(التالي);
                    *عدد_السجلات := التالي + 1;
                };
                *التعليمات := حالة_التعليمات;
                طابق أضف_عنوان_عنصر_تسلسل_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    الاستخراج.المصدر, الاستخراج.الفهرس, &تخطيط_الناتج,
                    سجل_العنوان, التعليمات
                ) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
                حالة_التعليمات := *التعليمات;
                لو (تجميعي) {
                    دع حجم_الحجز: غير_موقع = حجم_حجز_إطار_ذراع(&تخطيط_الناتج);
                    دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                        الوجهة: الوجهة,
                        الهوية: الناتج.القيمة,
                        الحجم: حجم_الحجز,
                        المحاذاة: تخطيط_الناتج.المحاذاة
                    };
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                    ألحق(
                        حالة_التعليمات,
                        تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(
                            الوجهة, سجل_العنوان, تخطيط_الناتج.الحجم, 0, 0
                        )
                    );
                } وإلا {
                    لو (!(تخطيط_الناتج.الحجم == 1 || تخطيط_الناتج.الحجم == 2 || تخطيط_الناتج.الحجم == 4 || تخطيط_الناتج.الحجم == 8)) {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, تخطيط_الناتج.الحجم)
                        ));
                    };
                    دع بإشارة: متغير منطقي = خطأ;
                    طابق وصف_عدد_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الناتج) مع
                    | اختيار.بعض(الوصف) -> { بإشارة := الوصف.موقع; }
                    | اختيار.لا_شيء -> { };
                    دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: الوجهة, إزاحة_بايت: 0 };
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
                        الوجهة, العنوان, تخطيط_الناتج.الحجم, بإشارة
                    ));
                };
            };
        };
    }
    | عملية_مسير.مكان_محلي(_) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                دع حجم_الحجز: غير_موقع = حجم_حجز_إطار_ذراع(&التخطيط);
                دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                    الوجهة: الوجهة, الهوية: الناتج.القيمة,
                    الحجم: حجم_الحجز, المحاذاة: التخطيط.المحاذاة
                };
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
            };
        };
    }
    | عملية_مسير.مرجع_إلى_مكان(التحويل) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> { ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(
            سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(التحويل.المرجع)
        )); };
    }
    | عملية_مسير.صندوق_إلى_مكان(التحويل) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> { ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(
            سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(التحويل.الصندوق)
        )); };
    }
    | عملية_مسير.مكان_حقل(المكان) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المكان.الأصل) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق جزء_تخطيط_عند_ذراع(&التخطيط, المكان.الفهرس) مع
                | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المكان.الأصل, المكان.الفهرس))); }
                | اختيار.بعض(الجزء) -> { ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إزاحة_ذراع(
                    سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(المكان.الأصل), الجزء.الإزاحة
                )); };
            };
        };
    }
    | عملية_مسير.مكان_فهرس(المكان) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                *التعليمات := حالة_التعليمات;
                طابق أضف_عنوان_عنصر_تسلسل_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    المكان.الأصل, المكان.الفهرس, &التخطيط, الوجهة, التعليمات
                ) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
                حالة_التعليمات := *التعليمات;
            };
        };
    }
    | عملية_مسير.مكان_إلى_مرجع(التحويل) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> { ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(
            سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(التحويل.المكان)
        )); };
    }
    | عملية_مسير.بناء_موسوم(البناء) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج, البناء.المنشئ
                    ) مع
                    | نتيجة_تخطيط_منشئ.مكتمل(المنشئ) -> {
                        دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                        دع حجم_الحجز: غير_موقع = حجم_حجز_إطار_ذراع(&التخطيط);
                        دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                            الوجهة: الوجهة, الهوية: الناتج.القيمة,
                            الحجم: حجم_الحجز, المحاذاة: التخطيط.المحاذاة
                        };
                        ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                        دع وسم: تخزين_فوري_ذراع_أربعة_وستون = {
                            الأساس: الوجهة, الإزاحة: التعداد.الوسم.الإزاحة,
                            الحجم: التعداد.الوسم.الحجم, القيمة: المنشئ.قيمة_الوسم
                        };
                        ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(وسم));
                        دع ف: متغير غير_موقع = 0;
                        بينما (ف < (الطول(البناء.الحمولات) مثل غير_موقع)) {
                            لو (ف >= (الطول(المنشئ.الحمولات) مثل غير_موقع)) {
                                أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                    سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مفقودة(الناتج, ف)
                                ));
                            };
                            دع الجزء: موضع_جزء_تخطيط = المنشئ.الحمولات[ف];
                            طابق أضف_تخزين_قيمة_ذراع(
                                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                                الوجهة, التعداد.مخزن_الحمولة.الإزاحة + الجزء.الإزاحة,
                                البناء.الحمولات[ف], &متغير حالة_التعليمات
                            ) مع
                            | اختيار.بعض(خطأ_التخطيط) -> { أرجع اختيار.بعض(خطأ_التخطيط); }
                            | اختيار.لا_شيء -> { };
                            ف := ف + 1;
                        }
                    }
                    | نتيجة_تخطيط_منشئ.مؤجل(السبب) -> {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مؤجلة(الناتج, السبب)
                        ));
                    }
                    | نتيجة_تخطيط_منشئ.مرفوض(الخطأ) -> {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مرفوضة(الناتج, الخطأ)
                        ));
                    };
                }
                | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج))); };
            };
        };
    }
    | عملية_مسير.استعلام_وسم(الاستعلام) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الاستعلام.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الاستعلام.المصدر);
                    دع إزاحة_الوسم: عدد = التعداد.الوسم.الإزاحة مثل عدد;
                    دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                        الأساس: سجل_المصدر, إزاحة_بايت: إزاحة_الوسم
                    };
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
                        سجل_لقيمة_مسير(الناتج), العنوان, التعداد.الوسم.الحجم, خطأ
                    ));
                }
                | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الاستعلام.المصدر))); };
            };
        };
    }
    | عملية_مسير.استخراج_حمولة(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الاستخراج.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                        الاستخراج.المصدر, الاستخراج.المنشئ
                    ) مع
                    | نتيجة_تخطيط_منشئ.مكتمل(المنشئ) -> {
                        لو (الاستخراج.الحمولة >= (الطول(المنشئ.الحمولات) مثل غير_موقع)) {
                            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مفقودة(الاستخراج.المصدر, الاستخراج.الحمولة)
                            ));
                        };
                        دع الجزء: موضع_جزء_تخطيط = المنشئ.الحمولات[الاستخراج.الحمولة];
                        طابق أضف_استخراج_من_عنوان_ذراع(
                            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج,
                            سجل_لقيمة_مسير(الاستخراج.المصدر),
                            التعداد.مخزن_الحمولة.الإزاحة + الجزء.الإزاحة,
                            &متغير حالة_التعليمات
                        ) مع
                        | اختيار.بعض(خطأ_التخطيط) -> { أرجع اختيار.بعض(خطأ_التخطيط); }
                        | اختيار.لا_شيء -> { };
                    }
                    | نتيجة_تخطيط_منشئ.مؤجل(السبب) -> {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مؤجلة(الاستخراج.المصدر, السبب)
                        ));
                    }
                    | نتيجة_تخطيط_منشئ.مرفوض(الخطأ) -> {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مرفوضة(الاستخراج.المصدر, الخطأ)
                        ));
                    };
                }
                | _ -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الاستخراج.المصدر))); };
            };
        };
    }
    | عملية_مسير.بناء_صندوق(البناء) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البناء.القيمة
            ) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
            }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                ألحق(
                    حالة_التعليمات,
                    تعليمة_ذراع_أربعة_وستون.تخصيص_صندوق_ذراع(
                        سجل_الناتج, التخطيط.الحجم, التخطيط.المحاذاة
                    )
                );
                *التعليمات := حالة_التعليمات;
                طابق أضف_تخزين_قيمة_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    سجل_الناتج, 0, البناء.القيمة, التعليمات
                ) مع
                | اختيار.بعض(خطأ_التخطيط) -> { أرجع اختيار.بعض(خطأ_التخطيط); }
                | اختيار.لا_شيء -> { };
                حالة_التعليمات := *التعليمات;
            };
        };
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق وصف_عدد_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الحساب.اليسار) مع
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); }
            | اختيار.بعض(الوصف) -> {
                دع العملية_المختارة: عملية_حساب_ذراع_أربعة_وستون = عملية_حساب_ذراع_من_مسير(الحساب.العملية);
                دع سجل_الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                دع سجل_اليسار: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الحساب.اليسار);
                دع سجل_اليمين: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الحساب.اليمين);
                دع المختار: حساب_صحيح_ذراع_أربعة_وستون = {
                    العملية: العملية_المختارة,
                    الوجهة: سجل_الوجهة,
                    اليسار: سجل_اليسار,
                    اليمين: سجل_اليمين,
                    الوصف: الوصف
                };
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(المختار));
            };
        };
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            دع البتات: متغير غير_موقع = 0;
            طابق بتات_قيمة_عائمة_ذراع(المسير, حقائق_الخلفية, الحساب.اليسار) مع
            | اختيار.بعض(ب) -> { البتات := ب; }
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.حساب_غير_مدعوم()); };
            ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.حساب_عشري_ذراع(
                حساب_عشري_ذراع_من_مسير(الحساب.العملية), سجل_لقيمة_مسير(الناتج),
                سجل_لقيمة_مسير(الحساب.اليسار), سجل_لقيمة_مسير(الحساب.اليمين), البتات
            ));
        };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            دع البتات: متغير غير_موقع = 0;
            طابق بتات_قيمة_عائمة_ذراع(المسير, حقائق_الخلفية, المقارنة.اليسار) مع
            | اختيار.بعض(ب) -> { البتات := ب; }
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()); };
            ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.مقارنة_عشرية_إلى_منطق_ذراع(
                مقارنة_عشرية_ذراع_من_مسير(المقارنة.العملية), سجل_لقيمة_مسير(الناتج),
                سجل_لقيمة_مسير(المقارنة.اليسار), سجل_لقيمة_مسير(المقارنة.اليمين), البتات
            ));
        };
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختيار.بعض(الناتج) -> {
            طابق صنف_إشارة_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, المقارنة.اليسار) مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح());
            }
            | اختيار.بعض(الإشارة) -> {
                دع المحمول: محمول_مقارنة_منتقى = محمول_مقارنة_من_مسير(المقارنة.العملية, الإشارة);
                دع الشرط: شرط_ذراع_أربعة_وستون = شرط_ذراع_من_محمول(المحمول);
                دع اليسار: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المقارنة.اليسار);
                دع سجل_اليمين: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المقارنة.اليمين);
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(اليسار, سجل_اليمين));
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(سجل_لقيمة_مسير(الناتج), الشرط));
            };
        };
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(الموضع) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_عنصر_ذراع(
                    سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(الموضع.المؤشر),
                    سجل_لقيمة_مسير(الموضع.الفهرس), التخطيط.الحجم
                ));
            };
        };
    }
    | عملية_مسير.تحميل(التحميل) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                لو (تخطيط_تجميعي_ذراع(&التخطيط)) {
                    دع حجم_الحجز: غير_موقع = حجم_حجز_إطار_ذراع(&التخطيط);
                    دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                        الوجهة: الوجهة, الهوية: الناتج.القيمة,
                        الحجم: حجم_الحجز, المحاذاة: التخطيط.المحاذاة
                    };
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                    دع سجل_المكان: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التحميل.المكان);
                    ألحق(
                        حالة_التعليمات,
                        تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(
                            الوجهة, سجل_المكان, التخطيط.الحجم, 0, 0
                        )
                    );
                } وإلا {
                    لو (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, التخطيط.الحجم)
                        ));
                    };
                    دع بإشارة: متغير منطقي = خطأ;
                    طابق وصف_عدد_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الناتج) مع
                    | اختيار.بعض(الوصف) -> { بإشارة := الوصف.موقع; }
                    | اختيار.لا_شيء -> { };
                    دع سجل_المكان: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التحميل.المكان);
                    دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: سجل_المكان, إزاحة_بايت: 0 };
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
                        الوجهة, العنوان, التخطيط.الحجم, بإشارة
                    ));
                };
            };
        };
    }
    | عملية_مسير.تخزين(التخزين) -> {
        طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, التخزين.القيمة) مع
        | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
        | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
            لو (تخطيط_تجميعي_ذراع(&التخطيط)) {
                دع سجل_المكان: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التخزين.المكان);
                دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التخزين.القيمة);
                ألحق(
                    حالة_التعليمات,
                    تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(
                        سجل_المكان, سجل_القيمة, التخطيط.الحجم, 0, 0
                    )
                );
            } وإلا {
                لو (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                        سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(التخزين.القيمة, التخطيط.الحجم)
                    ));
                };
                دع سجل_المكان: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التخزين.المكان);
                دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التخزين.القيمة);
                دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: سجل_المكان, إزاحة_بايت: 0 };
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(
                    سجل_القيمة, العنوان, التخطيط.الحجم
                ));
            };
        };
    }
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
            طابق البدائي مع
            | هوية_بدائي_مترجم.معمارية_المضيف -> {
                طابق ألحق_بدائي_هوية_مضيف_ذراع(الهدف, البدائي, &النداء.الحجج, العرض.الناتج, &متغير حالة_التعليمات) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
            }
            | هوية_بدائي_مترجم.منصة_المضيف -> {
                طابق ألحق_بدائي_هوية_مضيف_ذراع(الهدف, البدائي, &النداء.الحجج, العرض.الناتج, &متغير حالة_التعليمات) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
            }
            | هوية_بدائي_مترجم.بيئة_المضيف -> {
                طابق ألحق_بدائي_هوية_مضيف_ذراع(الهدف, البدائي, &النداء.الحجج, العرض.الناتج, &متغير حالة_التعليمات) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
            }
            | هوية_بدائي_مترجم.طول -> {
                دع عدد_حجج_النداء: غير_موقع = الطول(النداء.الحجج) مثل غير_موقع;
                لو (عدد_حجج_النداء != 1) {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
                }
                | اختيار.بعض(الناتج) -> {
                    دع قيمة_الحجة: معرف_قيمة_مسير = النداء.الحجج[0];
                    طابق تخطيط_قيمة_مسير_ذراع(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, قيمة_الحجة
                    ) مع
                    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                        أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
                    }
                    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الحجة) -> {
                        طابق جزء_تخطيط_عند_ذراع(&تخطيط_الحجة, 1) مع
                        | اختيار.لا_شيء -> {
                            أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(قيمة_الحجة, 1)
                            ));
                        }
                        | اختيار.بعض(جزء_الطول) -> {
                            طابق تخطيط_قيمة_مسير_ذراع(
                                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج
                            ) مع
                            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                                أرجع اختيار.بعض(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
                            }
                            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الناتج) -> {
                                لو (!(تخطيط_الناتج.الحجم == 1
                                    || تخطيط_الناتج.الحجم == 2
                                    || تخطيط_الناتج.الحجم == 4
                                    || تخطيط_الناتج.الحجم == 8)) {
                                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                        سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, تخطيط_الناتج.الحجم)
                                    ));
                                };
                                دع سجل_الحجة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(قيمة_الحجة);
                                دع إزاحة_الطول: عدد = جزء_الطول.الإزاحة مثل عدد;
                                دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                                    الأساس: سجل_الحجة,
                                    إزاحة_بايت: إزاحة_الطول
                                };
                                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                                دع تعليمة_التحميل: تعليمة_ذراع_أربعة_وستون =
                                    تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
                                        سجل_الناتج, العنوان, تخطيط_الناتج.الحجم, خطأ
                                    );
                                ألحق(
                                    حالة_التعليمات,
                                    تعليمة_التحميل
                                );
                            };
                        };
                    };
                };
            }
            | هوية_بدائي_مترجم.إلحاق -> {
                دع عدد_الحجج: غير_موقع = الطول(النداء.الحجج) مثل غير_موقع;
                لو (عدد_الحجج != 2) {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختيار.بعض(_) -> {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختيار.لا_شيء -> {
                    طابق النداء.مكان_التعديل مع
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                    }
                    | اختيار.بعض(مكان_المتجه) -> {
                        طابق ألحق_إلحاق_متجه_ذراع(
                            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                            مكان_المتجه, النداء.الحجج[1], &متغير حالة_التعليمات
                        ) مع
                        | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                        | اختيار.لا_شيء -> { };
                    };
                };
            }
            | _ -> {
                طابق خطة_ربط_بدائي_للهدف(الهدف, البدائي) مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختيار.بعض(_) -> {
                    طابق حل_واجهة_نداء_قيم_مسير_للهدف(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                        &النداء.الحجج, العرض.الناتج
                    ) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
                    }
                    | نتيجة.نجح(خطة_البدائي) -> {
                        دع هدف_البدائي: هدف_نداء_ذراع_أربعة_وستون =
                            هدف_نداء_ذراع_أربعة_وستون.بدائي_تشغيل(البدائي);
                        طابق ألحق_نداء_ذراع_بخطة(
                            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                            &متغير حالة_التعليمات, هدف_البدائي,
                            &النداء.الحجج, العرض.الناتج, &خطة_البدائي
                        ) مع
                        | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                        | اختيار.لا_شيء -> { };
                    };
                };
            };
        }
        | هدف_نداء_مسير.قيمة_دالة(الدالة_القيمة) -> {
            طابق حل_واجهة_نداء_قيم_مسير_للهدف(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                &النداء.الحجج, العرض.الناتج
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
            }
            | نتيجة.نجح(خطة_الدالة) -> {
                دع هدف_القيمة: هدف_نداء_ذراع_أربعة_وستون =
                    هدف_نداء_ذراع_أربعة_وستون.قيمة_دالة(سجل_لقيمة_مسير(الدالة_القيمة));
                طابق ألحق_نداء_ذراع_بخطة(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    &متغير حالة_التعليمات, هدف_القيمة,
                    &النداء.الحجج, العرض.الناتج, &خطة_الدالة
                ) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
            };
        }
        | هدف_نداء_مسير.دالة_خارجية(معرف_الدالة) -> {
            طابق ابحث_دالة_خارجية_مسير(المسير, معرف_الدالة) مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
            }
            | اختيار.بعض(الدالة) -> {
                لو ((الطول(النداء.الحجج) مثل غير_موقع) != (الطول(الدالة.المعاملات) مثل غير_موقع)) {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
                };
                طابق حل_واجهة_نداء_قيم_مسير_للهدف(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                    &النداء.الحجج, العرض.الناتج
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
                }
                | نتيجة.نجح(الخطة) -> {
                    دع المعرف_المنتقى: معرف_دالة_خارجية_منتقاة =
                        معرف_دالة_خارجية_منتقاة_من_مسير(معرف_الدالة);
                    دع هدف_الدالة: هدف_نداء_ذراع_أربعة_وستون =
                        هدف_نداء_ذراع_أربعة_وستون.دالة_خارجية(المعرف_المنتقى);
                    طابق ألحق_نداء_ذراع_بخطة(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                        &متغير حالة_التعليمات, هدف_الدالة,
                        &النداء.الحجج, العرض.الناتج, &الخطة
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                    | اختيار.لا_شيء -> { };
                };
            };
        }
        | هدف_نداء_مسير.دالة_سلطان(معرف_الدالة) -> {
            طابق ابحث_دالة_مسير(المسير, معرف_الدالة) مع
            | نتيجة_بحث_دالة_مسير.مفقودة(المعرف) -> {
                أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المعرف));
            }
            | نتيجة_بحث_دالة_مسير.موجودة(الدالة) -> {
                لو ((الطول(النداء.الحجج) مثل غير_موقع) != الدالة.عدد_المعاملات) {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
                };
                طابق حل_واجهة_عرض_دالة_مسير_للهدف(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &الدالة
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
                }
                | نتيجة.نجح(الخطة) -> {
                    دع الدالة_المنتقاة: معرف_دالة_منتقاة = دالة_منتقاة_من_مسير(معرف_الدالة);
                    دع هدف_الدالة: هدف_نداء_ذراع_أربعة_وستون =
                        هدف_نداء_ذراع_أربعة_وستون.دالة(الدالة_المنتقاة);
                    طابق ألحق_نداء_ذراع_بخطة(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                        &متغير حالة_التعليمات, هدف_الدالة,
                        &النداء.الحجج, العرض.الناتج, &الخطة
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                    | اختيار.لا_شيء -> { };
                };
            };
        };
    }
    ;
    *التعليمات := حالة_التعليمات;
    أرجع اختيار.لا_شيء();
}

عرف انتق_منهي_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    المنهي: &منهي_مسير,
    خطة_ناتج_واجهة: اختيار خطة_ناتج_واجهة,
    عنوان_ناتج_غير_مباشر: اختيار معرف_سجل_افتراضي,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    الخلفاء: &متغير متجه معرف_كتلة_منتقاة
): اختيار خطأ_اختيار_ذراع_أربعة_وستون {
    دع حالة_التعليمات: متغير متجه تعليمة_ذراع_أربعة_وستون = *التعليمات;
    دع حالة_الخلفاء: متغير متجه معرف_كتلة_منتقاة = *الخلفاء;
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        طابق حزمة_نقل_حافة(المسير, &الحافة) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة.نجح(الحزمة) -> {
            دع هدف_الحزمة: معرف_كتلة_منتقاة = الحزمة.الهدف;
            ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(الحزمة));
            ألحق(حالة_الخلفاء, هدف_الحزمة);
        };
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        طابق حزمة_نقل_حافة(المسير, &عند_الصواب) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة.نجح(حزمة_الصواب) -> {
            طابق حزمة_نقل_حافة(المسير, &عند_الخطأ) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة.نجح(حزمة_الخطأ) -> {
                دع هدف_الصواب: معرف_كتلة_منتقاة = حزمة_الصواب.الهدف;
                دع هدف_الخطأ: معرف_كتلة_منتقاة = حزمة_الخطأ.الهدف;
                دع سجل_الشرط: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الشرط);
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(سجل_الشرط, 0));
                دع فرع_الصواب: تعليمة_ذراع_أربعة_وستون =
                    تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(
                        شرط_ذراع_أربعة_وستون.لاتكافؤ(),
                        حزمة_الصواب
                    );
                ألحق(حالة_التعليمات, فرع_الصواب);
                ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(حزمة_الخطأ));
                ألحق(حالة_الخلفاء, هدف_الصواب);
                ألحق(حالة_الخلفاء, هدف_الخطأ);
            };
        };
    }
    | منهي_مسير.فخ -> {
        ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.فخ_ذراع());
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        طابق القيمة مع
        | اختيار.بعض(المعرف) -> {
            طابق خطة_ناتج_واجهة مع
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة()); }
            | اختيار.بعض(الخطة) -> {
                طابق الخطة.الموقع مع
                | موقع_تمرير_واجهة.متجاهل -> {
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عودة_ذراع());
                }
                | _ -> {
                    دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المعرف);
                    دع القيمة_موقعة: منطقي = ناتج_واجهة_عدد_موقع_ذراع(حقائق_الخلفية, &الخطة);
                    دع القيمة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_ذراع(
                        سجل_القيمة, &الخطة.التصنيف, &الخطة.الموقع, القيمة_موقعة
                    );
                    لو ((القيمة.غير_مباشر != 0) && (القيمة.تجميعي == 0)) {
                        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
                    };
                    لو (القيمة.غير_مباشر != 0) {
                        طابق عنوان_ناتج_غير_مباشر مع
                        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة()); }
                        | اختيار.بعض(_) -> { };
                    };
                    دع الناتج: ناتج_عودة_ذراع_أربعة_وستون_منتقى = {
                        القيمة: القيمة, عنوان_ناتج_غير_مباشر: عنوان_ناتج_غير_مباشر
                    };
                    ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عودة_ذراع_بقيمة(الناتج));
                };
            };
        }
        | اختيار.لا_شيء -> {
            ألحق(حالة_التعليمات, تعليمة_ذراع_أربعة_وستون.عودة_ذراع());
        };
    }
    | _ -> {
        أرجع اختيار.بعض(خطأ_اختيار_ذراع_أربعة_وستون.منهي_غير_مدعوم());
    };
    *التعليمات := حالة_التعليمات;
    *الخلفاء := حالة_الخلفاء;
    أرجع اختيار.لا_شيء();
}

عرف انتق_كتلة_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    عدد_السجلات: &متغير غير_موقع,
    خطة_ناتج_واجهة: اختيار خطة_ناتج_واجهة,
    عنوان_ناتج_غير_مباشر: اختيار معرف_سجل_افتراضي,
    كتلة_الدخول: اختيار معرف_كتلة_مسير,
    مقدمة_الدخول: &متجه تعليمة_ذراع_أربعة_وستون,
    الدالة: معرف_دالة_مسير,
    المعرف: معرف_كتلة_مسير
): نتيجة كتلة_ذراع_أربعة_وستون_منتقاة, فشل_اختيار_ذراع_أربعة_وستون {
    طابق ابحث_كتلة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(المفقود) -> {
        أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_كتلة(
            الدالة, المعرف, خطأ_اختيار_ذراع_أربعة_وستون.كتلة_مسير_مفقودة(المفقود)
        ));
    }
    | نتيجة_بحث_كتلة_مسير.موجودة(العرض) -> {
        دع التعليمات: متغير متجه تعليمة_ذراع_أربعة_وستون = [];
        طابق كتلة_الدخول مع
        | اختيار.بعض(المدخل) -> {
            لو (كتلتان_مسير_متساويتان(المدخل, المعرف)) {
                التعليمات := *مقدمة_الدخول;
            };
        }
        | اختيار.لا_شيء -> { };
        دع الخلفاء: متغير متجه معرف_كتلة_منتقاة = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العرض.عدد_التعليمات) {
            طابق تعليمة_مسير_عند(المسير, المعرف, ف) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_كتلة(
                    الدالة, المعرف, خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()
                ));
            }
            | اختيار.بعض(التعليمة) -> {
                دع فئة_العملية: فئة_عملية_اختيار_ذراع = فئة_عملية_اختيار_ذراع_من(&التعليمة.العملية);
                طابق انتق_تعليمة_ذراع_أربعة_وستون(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, عدد_السجلات,
                    &التعليمة, &متغير التعليمات
                ) مع
                | اختيار.بعض(الخطأ) -> {
                    أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_تعليمة(
                        الدالة, المعرف, ف, فئة_العملية, الخطأ
                    ));
                }
                | اختيار.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        طابق منهي_كتلة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_منهي_مسير.موجود(المنهي) -> {
            طابق انتق_منهي_ذراع_أربعة_وستون(
                المسير,
                حقائق_الخلفية,
                &المنهي,
                خطة_ناتج_واجهة,
                عنوان_ناتج_غير_مباشر,
                &متغير التعليمات,
                &متغير الخلفاء
            ) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_كتلة(الدالة, المعرف, الخطأ));
            }
            | اختيار.لا_شيء -> { };
        }
        | _ -> {
            أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_كتلة(
                الدالة, المعرف, خطأ_اختيار_ذراع_أربعة_وستون.منهي_غير_مدعوم()
            ));
        };
        دع معرف_الكتلة_المنتقاة: معرف_كتلة_منتقاة = كتلة_منتقاة_من_مسير(المعرف);
        دع الرأس: رأس_كتلة_منتقاة = { المعرف: معرف_الكتلة_المنتقاة, الخلفاء: الخلفاء };
        دع الكتلة: كتلة_ذراع_أربعة_وستون_منتقاة = { الرأس: الرأس, التعليمات: التعليمات };
        أرجع نتيجة.نجح(الكتلة);
    };
}

عام عرف انتق_دالة_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_دالة_مسير
): نتيجة دالة_ذراع_أربعة_وستون_منتقاة, فشل_اختيار_ذراع_أربعة_وستون {
    دع عدد_السجلات_المسير: متغير غير_موقع = 0;
    طابق عدد_سجلات_افتراضية_لمعرف_دالة_مسير(المسير, المعرف) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المعرف))); }
    | اختيار.بعض(العدد) -> { عدد_السجلات_المسير := العدد; };
    دع عدد_السجلات: متغير غير_موقع = عدد_السجلات_المسير;

    دع خطة_ناتج_واجهة: متغير اختيار خطة_ناتج_واجهة = اختيار.لا_شيء();
    دع عنوان_ناتج_غير_مباشر: متغير اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
    دع كتلة_الدخول: متغير اختيار معرف_كتلة_مسير = اختيار.لا_شيء();
    دع مقدمة_الدخول: متغير متجه تعليمة_ذراع_أربعة_وستون = [];

    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
        أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المفقود)));
    }
    | نتيجة_بحث_دالة_مسير.موجودة(عرض_الدالة) -> {
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(
            حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &عرض_الدالة
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ))); }
        | نتيجة.نجح(الخطة) -> {
            دع مرجع_خطة_الناتج: &خطة_ناتج_واجهة = &الخطة.الناتج;
            خطة_ناتج_واجهة := اختيار.بعض(*مرجع_خطة_الناتج);
            كتلة_الدخول := عرض_الدالة.المدخل;

            // احجز حامل X8 الآن، لكن أجّل نقله حتى تُلتقط كل معاملات ABI.
            دع حامل_ناتج_غير_مباشر: متغير اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
            طابق الخطة.الناتج.الموقع مع
            | موقع_تمرير_واجهة.غير_مباشر(موضع_العنوان) -> {
                دع حامل: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                دع محفوظ: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات + 1);
                عدد_السجلات := عدد_السجلات + 2;
                دع المواضع: متغير متجه موضع_جزء_واجهة = [];
                ألحق(المواضع, موضع_العنوان);
                دع قيمة_الحامل: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = {
                    السجل: حامل, المواضع: المواضع, الحجم: 8,
                    تجميعي: 0, غير_مباشر: 0, بإشارة: 0
                };
                دع الاستلام: استلام_معامل_ذراع_أربعة_وستون_منتقى = { القيمة: قيمة_الحامل };
                ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(الاستلام));
                حامل_ناتج_غير_مباشر := اختيار.بعض(حامل);
                عنوان_ناتج_غير_مباشر := اختيار.بعض(محفوظ);
            }
            | _ -> { };

            // المرحلة الأولى: التقط كل حوامل ABI قبل أي تعليمة يمكن أن تمس سجلا واردا لاحقا.
            دع التجميعات_المؤجلة: متغير متجه تجهيز_معامل_تجميعي_ذراع = [];
            دع النقلات_المؤجلة: متغير متجه تجهيز_معامل_مفرد_ذراع = [];
            دع فم: متغير غير_موقع = 0;
            بينما (فم < عرض_الدالة.عدد_المعاملات) {
                طابق معامل_دالة_مسير_عند(المسير, المعرف, فم) مع
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة())); }
                | اختيار.بعض(المعامل) -> {
                    دع مرجع_خ: &خطة_معامل_واجهة = &الخطة.المعاملات[فم];
                    دع خ: خطة_معامل_واجهة = *مرجع_خ;
                    طابق خ.الموقع مع
                    | موقع_تمرير_واجهة.متجاهل -> { }
                    | _ -> {
                        دع سجل_المعامل: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المعامل.المعرف);
                        دع المعامل_موقع: منطقي = معامل_واجهة_عدد_موقع_ذراع(حقائق_الخلفية, &خ);
                        دع قيمة_الواجهة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_ذراع(
                            سجل_المعامل, &خ.التصنيف, &خ.الموقع, المعامل_موقع
                        );
                        لو ((قيمة_الواجهة.تجميعي != 0) && (قيمة_الواجهة.غير_مباشر == 0)) {
                            دع الأجزاء: متغير متجه معرف_سجل_افتراضي = [];
                            دع أحجام_الأجزاء: متغير متجه غير_موقع = [];
                            دع فج: متغير غير_موقع = 0;
                            بينما (فج < (الطول(قيمة_الواجهة.المواضع) مثل غير_موقع)) {
                                دع سجل_الجزء: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                                عدد_السجلات := عدد_السجلات + 1;
                                دع بداية_الجزء: غير_موقع = فج * 8;
                                دع المتبقي: غير_موقع = قيمة_الواجهة.الحجم - بداية_الجزء;
                                دع حجم_الجزء: متغير غير_موقع = المتبقي;
                                لو (حجم_الجزء > 8) { حجم_الجزء := 8; };
                                دع مواضع_الجزء: متغير متجه موضع_جزء_واجهة = [];
                                ألحق(مواضع_الجزء, قيمة_الواجهة.المواضع[فج]);
                                دع عرض_الحامل: غير_موقع = عرض_حامل_جزء_تجميع_ذراع(حجم_الجزء);
                                دع قيمة_الجزء: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = {
                                    السجل: سجل_الجزء, المواضع: مواضع_الجزء, الحجم: عرض_الحامل,
                                    تجميعي: 0, غير_مباشر: 0, بإشارة: 0
                                };
                                دع استلام_الجزء: استلام_معامل_ذراع_أربعة_وستون_منتقى = { القيمة: قيمة_الجزء };
                                ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(استلام_الجزء));
                                ألحق(الأجزاء, سجل_الجزء);
                                ألحق(أحجام_الأجزاء, حجم_الجزء);
                                فج := فج + 1;
                            }
                            دع حجم_التجميع: غير_موقع = خ.التصنيف.الحجم;
                            دع محاذاة_التجميع: غير_موقع = خ.التصنيف.المحاذاة;
                            دع التجهيز: تجهيز_معامل_تجميعي_ذراع = {
                                المعرف: المعامل.المعرف,
                                الحجم: حجم_التجميع,
                                المحاذاة: محاذاة_التجميع,
                                الأجزاء: الأجزاء,
                                أحجام_الأجزاء: أحجام_الأجزاء
                            };
                            ألحق(التجميعات_المؤجلة, التجهيز);
                        } وإلا {
                            // التقط موضع ABI في حامل قصير العمر أولا. لا يجوز أن
                            // يظل سجل المعامل الدلالي مثبتا في X0..X7/X8 طوال حياته.
                            دع سجل_الحامل: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                            عدد_السجلات := عدد_السجلات + 1;
                            دع قيمة_الحامل: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_ذراع(
                                سجل_الحامل, &خ.التصنيف, &خ.الموقع, المعامل_موقع
                            );
                            دع الاستلام: استلام_معامل_ذراع_أربعة_وستون_منتقى = { القيمة: قيمة_الحامل };
                            ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(الاستلام));
                            دع النقل: تجهيز_معامل_مفرد_ذراع = {
                                الوجهة: سجل_المعامل,
                                الحامل: سجل_الحامل
                            };
                            ألحق(النقلات_المؤجلة, النقل);
                        };
                    };
                };
                فم := فم + 1;
            }

            // بعد اكتمال الالتقاط تصبح سجلات الدخل العادية قيما حية مرئية للمخصص.
            طابق حامل_ناتج_غير_مباشر مع
            | اختيار.بعض(الحامل) -> {
                طابق عنوان_ناتج_غير_مباشر مع
                | اختيار.بعض(المحفوظ) -> {
                    ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(المحفوظ, الحامل));
                }
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة())); };
            }
            | اختيار.لا_شيء -> { };

            // بعد التقاط جميع مواضع ABI يمكن نقل الحوامل المفردة إلى سجلات
            // المعاملات العادية بلا خطر الكتابة فوق سجل دخل لم يُلتقط بعد.
            دع فن: متغير غير_موقع = 0;
            بينما (فن < (الطول(النقلات_المؤجلة) مثل غير_موقع)) {
                دع مرجع_النقل: &تجهيز_معامل_مفرد_ذراع = &النقلات_المؤجلة[فن];
                دع النقل: تجهيز_معامل_مفرد_ذراع = *مرجع_النقل;
                ألحق(
                    مقدمة_الدخول,
                    تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(النقل.الوجهة, النقل.الحامل)
                );
                فن := فن + 1;
            }

            // المرحلة الثانية: ابن تخزين التجميعات المحلية من حقائق ABI التي
            // حُسمت بالفعل عند تصنيف المعامل. لا نعيد سؤال التخطيط عبر معرف MSIR.
            دع فت: متغير غير_موقع = 0;
            بينما (فت < (الطول(التجميعات_المؤجلة) مثل غير_موقع)) {
                دع مرجع_التجهيز: &تجهيز_معامل_تجميعي_ذراع = &التجميعات_المؤجلة[فت];
                دع التجهيز: تجهيز_معامل_تجميعي_ذراع = *مرجع_التجهيز;
                دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التجهيز.المعرف);
                دع حجم_التجميع: غير_موقع = التجهيز.الحجم;
                دع محاذاة_التجميع: غير_موقع = التجهيز.المحاذاة;
                دع هوية_التجميع: غير_موقع = التجهيز.المعرف.القيمة;
                دع حجم_الحجز: غير_موقع = حجم_حجز_تجميعي_ذراع(حجم_التجميع);
                دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                    الوجهة: سجل_القيمة,
                    الهوية: هوية_التجميع,
                    الحجم: حجم_الحجز,
                    المحاذاة: محاذاة_التجميع
                };
                ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                دع فج: متغير غير_موقع = 0;
                بينما (فج < (الطول(التجهيز.الأجزاء) مثل غير_موقع)) {
                    دع إزاحة_الجزء_غير_الموقعة: غير_موقع = فج * 8;
                    دع إزاحة_الجزء: عدد = إزاحة_الجزء_غير_الموقعة مثل عدد;
                    دع عنوان_الجزء: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                        الأساس: سجل_القيمة, إزاحة_بايت: إزاحة_الجزء
                    };
                    ألحق(مقدمة_الدخول, تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(
                        التجهيز.الأجزاء[فج], عنوان_الجزء, التجهيز.أحجام_الأجزاء[فج]
                    ));
                    فج := فج + 1;
                }
                فت := فت + 1;
            }

        };
    };

    دع عدد_الكتل: متغير غير_موقع = 0;
    طابق عدد_كتل_دالة_مسير_للاختيار(المسير, المعرف) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المعرف))); }
    | اختيار.بعض(العدد) -> { عدد_الكتل := العدد; };
    دع الكتل: متغير متجه كتلة_ذراع_أربعة_وستون_منتقاة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الكتل) {
        طابق معرف_كتلة_مسير_عند(المسير, المعرف, ف) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_اختيار_ذراع_في_دالة(المعرف, خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(المعرف))); }
        | اختيار.بعض(معرف_الكتلة) -> {
            طابق انتق_كتلة_ذراع_أربعة_وستون(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير عدد_السجلات,
                خطة_ناتج_واجهة, عنوان_ناتج_غير_مباشر,
                كتلة_الدخول, &مقدمة_الدخول, المعرف, معرف_الكتلة
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الكتلة) -> { ألحق(الكتل, الكتلة); };
        };
        ف := ف + 1;
    }
    دع معرف_الدالة_المنتقاة: معرف_دالة_منتقاة = دالة_منتقاة_من_مسير(المعرف);
    دع الرأس: رأس_دالة_منتقاة = {
        المعرف: معرف_الدالة_المنتقاة,
        عدد_السجلات_الافتراضية: عدد_السجلات
    };
    دع الدالة: دالة_ذراع_أربعة_وستون_منتقاة = { الرأس: الرأس, الكتل: الكتل };
    أرجع نتيجة.نجح(الدالة);
}

عام عرف انتق_مسير_إلى_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_اختيار_ذراع_أربعة_وستون {
    دع الوصف: واصف_هدف = *الهدف;
    طابق الوصف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | _ -> {
        أرجع نتيجة_اختيار_ذراع_أربعة_وستون.خطأ(فشل_اختيار_ذراع_عام(
            خطأ_اختيار_ذراع_أربعة_وستون.هدف_ليس_ذراع_أربعة_وستون(الوصف.المعرف)
        ));
    };

    دع الدوال: متغير متجه دالة_ذراع_أربعة_وستون_منتقاة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_اختيار_ذراع_أربعة_وستون.خطأ(فشل_اختيار_ذراع_عام(
                خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()
            ));
        }
        | اختيار.بعض(المعرف) -> {
            طابق انتق_دالة_ذراع_أربعة_وستون(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
            | نتيجة.خطأ(الخطأ) -> {
                طابق الخطأ.السبب مع
                | خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> {
                    أرجع نتيجة_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي);
                }
                | _ -> {
                    أرجع نتيجة_اختيار_ذراع_أربعة_وستون.خطأ(الخطأ);
                };
            }
            | نتيجة.نجح(الدالة) -> {
                ألحق(الدوال, الدالة);
            };
        };
        ف := ف + 1;
    }
    دع الرأس: رأس_برنامج_منتقى = { الهدف: الوصف.المعرف };
    دع الشفرة: شفرة_ذراع_أربعة_وستون_منتقاة = { الرأس: الرأس, الدوال: الدوال };
    أرجع نتيجة_اختيار_ذراع_أربعة_وستون.نجح(الشفرة);
}
