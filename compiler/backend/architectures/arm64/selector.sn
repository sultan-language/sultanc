عام نوع سبب_فشل_تخطيط_اختيار_ذراع =
    | استعلام_قيمة بنوع فشل_تخطيط_قيمة_للاختيار
    | بنية_تخطيط_غير_متوافقة بنوع معرف_قيمة_مسير
    | جزء_تخطيط_مفقود بنوع (معرف_قيمة_مسير, طبيعي)
    | عرض_قيمة_غير_مدعوم بنوع (معرف_قيمة_مسير, طبيعي)
    | حمولة_منشئ_مؤجلة بنوع (معرف_قيمة_مسير, سبب_تأجيل_تخطيط)
    | حمولة_منشئ_مرفوضة بنوع (معرف_قيمة_مسير, خطأ_تخطيط)
    | حمولة_منشئ_مفقودة بنوع (معرف_قيمة_مسير, طبيعي)
;

عام نوع خطأ_اختيار_ذراع_أربعة_وستون =
    | هدف_ليس_ذراع_أربعة_وستون بنوع معرف_هدف
    | دالة_مسير_مفقودة بنوع معرف_دالة_مسير
    | كتلة_مسير_مفقودة بنوع معرف_كتلة_مسير
    | قيمة_مسير_مفقودة بنوع معرف_قيمة_مسير
    | ناتج_تعليمة_مفقود
    | نوع_قيمة_مفقود بنوع معرف_قيمة_مسير
    | نوع_غير_صحيح
    | عملية_غير_مدعومة
    | ثابت_غير_مدعوم
    | حساب_غير_مدعوم
    | منهي_غير_مدعوم
    | حافة_غير_صالحة بنوع معرف_كتلة_مسير
    | واجهة_دالة_غير_متاحة
    | فشل_حل_واجهة بنوع خطأ_حل_واجهة_اختيار
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | ثابت_نص_يحتاج_مقطع_بيانات
    | تخطيط_غير_متاح بنوع سبب_فشل_تخطيط_اختيار_ذراع
;

عرف ألحق_تعليمة_ذراع_للاختيار(
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    التعليمة: تعليمة_ذراع_أربعة_وستون
): فراغ {
    ألحق(*التعليمات, التعليمة);
}

عرف ألحق_خلفا_ذراع_للاختيار(
    الخلفاء: &متغير متجه معرف_كتلة_منتقاة,
    الخلف: معرف_كتلة_منتقاة
): فراغ {
    ألحق(*الخلفاء, الخلف);
}

عام نوع فئة_عملية_اختيار_ذراع =
    | ثابت
    | حساب_صحيح
    | حساب_عشري
    | تحويل_عائم
    | مقارنة_عشري
    | مقارنة_صحيح
    | تحويل_صحيح
    | مرجع_إلى_مؤشر
    | نقل_تسلسل_مملوك
    | تجميع
    | تهيئة_متجه
    | استخراج_حقل
    | استخراج_فهرس
    | مكان_محلي
    | مكان_عام
    | مرجع_إلى_مكان
    | صندوق_إلى_مكان
    | مكان_حقل
    | مكان_فهرس
    | موضع_تخزين_عنصر_مؤشر
    | تحميل
    | تخزين
    | مكان_إلى_مرجع
    | بناء_موسوم
    | استعلام_وسم
    | استخراج_حمولة
    | بناء_صندوق
    | بناء_إغلاق
    | استخراج_التقاط
    | نداء
;

عرف فئة_عملية_اختيار_ذراع_من(العملية: &عملية_مسير): فئة_عملية_اختيار_ذراع {
    دع الحالة: عملية_مسير = *العملية;
    طابق الحالة مع
    | عملية_مسير.ثابت(_) -> { أرجع فئة_عملية_اختيار_ذراع.ثابت(); }
    | عملية_مسير.حساب_صحيح(_) -> { أرجع فئة_عملية_اختيار_ذراع.حساب_صحيح(); }
    | عملية_مسير.حساب_عشري(_) -> { أرجع فئة_عملية_اختيار_ذراع.حساب_عشري(); }
    | عملية_مسير.مقارنة_عشري(_) -> { أرجع فئة_عملية_اختيار_ذراع.مقارنة_عشري(); }
    | عملية_مسير.مقارنة_صحيح(_) -> { أرجع فئة_عملية_اختيار_ذراع.مقارنة_صحيح(); }
    | عملية_مسير.تحويل_صحيح(_) -> { أرجع فئة_عملية_اختيار_ذراع.تحويل_صحيح(); }
    | عملية_مسير.تحويل_عائم(_) -> { أرجع فئة_عملية_اختيار_ذراع.تحويل_عائم(); }
    | عملية_مسير.نقل_تسلسل_مملوك(_) -> { أرجع فئة_عملية_اختيار_ذراع.نقل_تسلسل_مملوك(); }
    | عملية_مسير.مرجع_إلى_مؤشر(_) -> { أرجع فئة_عملية_اختيار_ذراع.مرجع_إلى_مؤشر(); }
    | عملية_مسير.تجميع(_) -> { أرجع فئة_عملية_اختيار_ذراع.تجميع(); }
    | عملية_مسير.تهيئة_متجه(_) -> { أرجع فئة_عملية_اختيار_ذراع.تهيئة_متجه(); }
    | عملية_مسير.استخراج_حقل(_) -> { أرجع فئة_عملية_اختيار_ذراع.استخراج_حقل(); }
    | عملية_مسير.استخراج_فهرس(_) -> { أرجع فئة_عملية_اختيار_ذراع.استخراج_فهرس(); }
    | عملية_مسير.مكان_محلي(_) -> { أرجع فئة_عملية_اختيار_ذراع.مكان_محلي(); }
    | عملية_مسير.مكان_عام(_) -> { أرجع فئة_عملية_اختيار_ذراع.مكان_عام(); }
    | عملية_مسير.مرجع_إلى_مكان(_) -> { أرجع فئة_عملية_اختيار_ذراع.مرجع_إلى_مكان(); }
    | عملية_مسير.صندوق_إلى_مكان(_) -> { أرجع فئة_عملية_اختيار_ذراع.صندوق_إلى_مكان(); }
    | عملية_مسير.مكان_حقل(_) -> { أرجع فئة_عملية_اختيار_ذراع.مكان_حقل(); }
    | عملية_مسير.مكان_فهرس(_) -> { أرجع فئة_عملية_اختيار_ذراع.مكان_فهرس(); }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(_) -> { أرجع فئة_عملية_اختيار_ذراع.موضع_تخزين_عنصر_مؤشر(); }
    | عملية_مسير.تحميل(_) -> { أرجع فئة_عملية_اختيار_ذراع.تحميل(); }
    | عملية_مسير.تخزين(_) -> { أرجع فئة_عملية_اختيار_ذراع.تخزين(); }
    | عملية_مسير.مكان_إلى_مرجع(_) -> { أرجع فئة_عملية_اختيار_ذراع.مكان_إلى_مرجع(); }
    | عملية_مسير.بناء_موسوم(_) -> { أرجع فئة_عملية_اختيار_ذراع.بناء_موسوم(); }
    | عملية_مسير.استعلام_وسم(_) -> { أرجع فئة_عملية_اختيار_ذراع.استعلام_وسم(); }
    | عملية_مسير.استخراج_حمولة(_) -> { أرجع فئة_عملية_اختيار_ذراع.استخراج_حمولة(); }
    | عملية_مسير.بناء_صندوق(_) -> { أرجع فئة_عملية_اختيار_ذراع.بناء_صندوق(); }
    | عملية_مسير.بناء_إغلاق(_) -> { أرجع فئة_عملية_اختيار_ذراع.بناء_إغلاق(); }
    | عملية_مسير.استخراج_التقاط(_) -> { أرجع فئة_عملية_اختيار_ذراع.استخراج_التقاط(); }
    | عملية_مسير.نداء(_) -> { أرجع فئة_عملية_اختيار_ذراع.نداء(); };
}

عام نوع فشل_اختيار_ذراع_أربعة_وستون = {
    الدالة: اختياري معرف_دالة_مسير,
    الكتلة: اختياري معرف_كتلة_مسير,
    فهرس_التعليمة: اختياري طبيعي,
    العملية: اختياري فئة_عملية_اختيار_ذراع,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
};

عام نوع نتيجة_اختيار_ذراع_أربعة_وستون =
    | نجح بنوع شفرة_ذراع_أربعة_وستون_منتقاة
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | خطأ بنوع فشل_اختيار_ذراع_أربعة_وستون
;

عرف فشل_اختيار_ذراع_عام(السبب: خطأ_اختيار_ذراع_أربعة_وستون): فشل_اختيار_ذراع_أربعة_وستون {
    دع لا_دالة: اختياري معرف_دالة_مسير = اختياري.لا_شيء();
    دع لا_كتلة: اختياري معرف_كتلة_مسير = اختياري.لا_شيء();
    دع لا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
    دع لا_عملية: اختياري فئة_عملية_اختيار_ذراع = اختياري.لا_شيء();
    دع الفشل: فشل_اختيار_ذراع_أربعة_وستون = {
        الدالة: لا_دالة,
        الكتلة: لا_كتلة,
        فهرس_التعليمة: لا_فهرس,
        العملية: لا_عملية,
        السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_ذراع_في_دالة(
    الدالة: معرف_دالة_مسير,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
): فشل_اختيار_ذراع_أربعة_وستون {
    دع له_دالة: اختياري معرف_دالة_مسير = اختياري.موجود(الدالة);
    دع لا_كتلة: اختياري معرف_كتلة_مسير = اختياري.لا_شيء();
    دع لا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
    دع لا_عملية: اختياري فئة_عملية_اختيار_ذراع = اختياري.لا_شيء();
    دع الفشل: فشل_اختيار_ذراع_أربعة_وستون = {
        الدالة: له_دالة,
        الكتلة: لا_كتلة,
        فهرس_التعليمة: لا_فهرس,
        العملية: لا_عملية,
        السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_ذراع_في_كتلة(
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
): فشل_اختيار_ذراع_أربعة_وستون {
    دع له_دالة: اختياري معرف_دالة_مسير = اختياري.موجود(الدالة);
    دع له_كتلة: اختياري معرف_كتلة_مسير = اختياري.موجود(الكتلة);
    دع لا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
    دع لا_عملية: اختياري فئة_عملية_اختيار_ذراع = اختياري.لا_شيء();
    دع الفشل: فشل_اختيار_ذراع_أربعة_وستون = {
        الدالة: له_دالة,
        الكتلة: له_كتلة,
        فهرس_التعليمة: لا_فهرس,
        العملية: لا_عملية,
        السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_ذراع_في_تعليمة(
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الفهرس: طبيعي,
    العملية: فئة_عملية_اختيار_ذراع,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
): فشل_اختيار_ذراع_أربعة_وستون {
    دع له_دالة: اختياري معرف_دالة_مسير = اختياري.موجود(الدالة);
    دع له_كتلة: اختياري معرف_كتلة_مسير = اختياري.موجود(الكتلة);
    دع له_فهرس: اختياري طبيعي = اختياري.موجود(الفهرس);
    دع له_عملية: اختياري فئة_عملية_اختيار_ذراع = اختياري.موجود(العملية);
    دع الفشل: فشل_اختيار_ذراع_أربعة_وستون = {
        الدالة: له_دالة,
        الكتلة: له_كتلة,
        فهرس_التعليمة: له_فهرس,
        العملية: له_عملية,
        السبب: السبب
    };
    أرجع الفشل;
}

نوع تجهيز_معامل_تجميعي_ذراع = {
    المعرف: معرف_قيمة_مسير,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    الأجزاء: متجه معرف_سجل_افتراضي,
    أحجام_الأجزاء: متجه طبيعي
};

نوع تجهيز_معامل_مفرد_ذراع = {
    الوجهة: معرف_سجل_افتراضي,
    الحامل: معرف_سجل_افتراضي
};

عرف سجل_لقيمة_مسير(المعرف: معرف_قيمة_مسير): معرف_سجل_افتراضي {
    أرجع معرف_سجل_افتراضي_من(المعرف.القيمة);
}

عرف إزاحة_مقياس_عنصر_ذراع(الحجم: طبيعي): اختياري طبيعي {
    إذا (الحجم == 1) { أرجع اختياري.موجود(0); };
    إذا (الحجم == 2) { أرجع اختياري.موجود(1); };
    إذا (الحجم == 4) { أرجع اختياري.موجود(2); };
    إذا (الحجم == 8) { أرجع اختياري.موجود(3); };
    أرجع اختياري.لا_شيء();
}

عرف دالة_منتقاة_من_مسير(المعرف: معرف_دالة_مسير): معرف_دالة_منتقاة {
    دع الناتج: معرف_دالة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عرف كتلة_منتقاة_من_مسير(المعرف: معرف_كتلة_مسير): معرف_كتلة_منتقاة {
    دع الناتج: معرف_كتلة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عرف بتات_قيمة_عائمة_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختياري طبيعي {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع بتات_عائم_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف حساب_عشري_ذراع_من_مسير(العملية: عملية_حساب_عشري): حساب_عشري_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_حساب_عشري.جمع -> { أرجع حساب_عشري_ذراع_أربعة_وستون.جمع(); }
    | عملية_حساب_عشري.طرح -> { أرجع حساب_عشري_ذراع_أربعة_وستون.طرح(); }
    | عملية_حساب_عشري.ضرب -> { أرجع حساب_عشري_ذراع_أربعة_وستون.ضرب(); }
    | عملية_حساب_عشري.قسمة -> { أرجع حساب_عشري_ذراع_أربعة_وستون.قسمة(); };
}

عرف مقارنة_عشرية_ذراع_من_مسير(العملية: عملية_مقارنة_عشري): مقارنة_عشرية_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_مقارنة_عشري.يساوي -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.يساوي(); }
    | عملية_مقارنة_عشري.لا_يساوي -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.لا_يساوي(); }
    | عملية_مقارنة_عشري.أصغر -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.أصغر(); }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.أصغر_أو_يساوي(); }
    | عملية_مقارنة_عشري.أكبر -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.أكبر(); }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { أرجع مقارنة_عشرية_ذراع_أربعة_وستون.أكبر_أو_يساوي(); };
}

عرف محمول_مقارنة_من_مسير(
    العملية: عملية_مقارنة_صحيح,
    الإشارة: صنف_إشارة_عدد_خلفية
): محمول_مقارنة_منتقى {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> {
        أرجع محمول_مقارنة_منتقى.يساوي();
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> {
        أرجع محمول_مقارنة_منتقى.لا_يساوي();
    }
    | عملية_مقارنة_صحيح.أصغر -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع محمول_مقارنة_منتقى.أصغر_موقع();
        }
        | صنف_إشارة_عدد_خلفية.طبيعي -> {
            أرجع محمول_مقارنة_منتقى.أصغر_طبيعي();
        };
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع محمول_مقارنة_منتقى.أصغر_أو_يساوي_موقع();
        }
        | صنف_إشارة_عدد_خلفية.طبيعي -> {
            أرجع محمول_مقارنة_منتقى.أصغر_أو_يساوي_طبيعي();
        };
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع محمول_مقارنة_منتقى.أكبر_موقع();
        }
        | صنف_إشارة_عدد_خلفية.طبيعي -> {
            أرجع محمول_مقارنة_منتقى.أكبر_طبيعي();
        };
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع محمول_مقارنة_منتقى.أكبر_أو_يساوي_موقع();
        }
        | صنف_إشارة_عدد_خلفية.طبيعي -> {
            أرجع محمول_مقارنة_منتقى.أكبر_أو_يساوي_طبيعي();
        };
    };
}

عرف وصف_عدد_لقيمة_مسير_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختياري وصف_عدد_ذراع_أربعة_وستون {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        طابق بتات_عدد_للاختيار(&حقائق.الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(البتات) -> {
            طابق صنف_إشارة_عدد_للاختيار(&حقائق.الأنواع, النوع) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الإشارة) -> {
                دع موقع: متغير منطقي = خطأ;
                طابق الإشارة مع
                | صنف_إشارة_عدد_خلفية.موقع -> { موقع := صواب; }
                | صنف_إشارة_عدد_خلفية.طبيعي -> { };
                دع الوصف: وصف_عدد_ذراع_أربعة_وستون = { البتات: البتات, موقع: موقع };
                أرجع اختياري.موجود(الوصف);
            };
        };
    };
}

عرف وصف_تحويل_لقيمة_مسير_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختياري وصف_تحويل_صحيح_خلفية {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع وصف_نوع_لتحويل_صحيح_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف تحويل_عائم_ذراع_من_مسير(العملية: عملية_تحويل_عائم): تحويل_عائم_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_تحويل_عائم.عائم_إلى_موقع -> { أرجع تحويل_عائم_ذراع_أربعة_وستون.عائم_إلى_موقع(); }
    | عملية_تحويل_عائم.عائم_إلى_طبيعي -> { أرجع تحويل_عائم_ذراع_أربعة_وستون.عائم_إلى_طبيعي(); }
    | عملية_تحويل_عائم.موقع_إلى_عائم -> { أرجع تحويل_عائم_ذراع_أربعة_وستون.موقع_إلى_عائم(); }
    | عملية_تحويل_عائم.طبيعي_إلى_عائم -> { أرجع تحويل_عائم_ذراع_أربعة_وستون.طبيعي_إلى_عائم(); }
    | عملية_تحويل_عائم.عائم_إلى_عائم -> { أرجع تحويل_عائم_ذراع_أربعة_وستون.عائم_إلى_عائم(); };
}

// The width of a float conversion's side: a float's bits or an integer's.
عرف بتات_طرف_تحويل_عائم_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختياري طبيعي {
    طابق بتات_قيمة_عائمة_ذراع(المسير, حقائق_الخلفية, القيمة) مع
    | اختياري.موجود(ب) -> { أرجع اختياري.موجود(ب); }
    | اختياري.لا_شيء -> { };
    طابق وصف_تحويل_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, القيمة) مع
    | اختياري.موجود(الوصف) -> { أرجع اختياري.موجود(الوصف.البتات); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف عملية_حساب_ذراع_من_مسير(العملية: عملية_حساب_صحيح): عملية_حساب_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع عملية_حساب_ذراع_أربعة_وستون.جمع(); }
    | عملية_حساب_صحيح.طرح -> { أرجع عملية_حساب_ذراع_أربعة_وستون.طرح(); }
    | عملية_حساب_صحيح.ضرب -> { أرجع عملية_حساب_ذراع_أربعة_وستون.ضرب(); }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع عملية_حساب_ذراع_أربعة_وستون.قسمة(); }
    | عملية_حساب_صحيح.قسمة_طبيعية -> { أرجع عملية_حساب_ذراع_أربعة_وستون.قسمة(); }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع عملية_حساب_ذراع_أربعة_وستون.باقي(); }
    | عملية_حساب_صحيح.باقي_طبيعي -> { أرجع عملية_حساب_ذراع_أربعة_وستون.باقي(); }
    | عملية_حساب_صحيح.و_بتي -> { أرجع عملية_حساب_ذراع_أربعة_وستون.و_بتي(); }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع عملية_حساب_ذراع_أربعة_وستون.أو_بتي(); }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع عملية_حساب_ذراع_أربعة_وستون.أو_حصري(); }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع عملية_حساب_ذراع_أربعة_وستون.إزاحة_يسرى(); }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع عملية_حساب_ذراع_أربعة_وستون.إزاحة_يمنى_منطقية(); }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع عملية_حساب_ذراع_أربعة_وستون.إزاحة_يمنى_حسابية(); }
    | عملية_حساب_صحيح.جمع_ملتف -> { أرجع عملية_حساب_ذراع_أربعة_وستون.جمع_ملتف(); }
    | عملية_حساب_صحيح.طرح_ملتف -> { أرجع عملية_حساب_ذراع_أربعة_وستون.طرح_ملتف(); }
    | عملية_حساب_صحيح.ضرب_ملتف -> { أرجع عملية_حساب_ذراع_أربعة_وستون.ضرب_ملتف(); }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { أرجع عملية_حساب_ذراع_أربعة_وستون.إزاحة_يسرى_ملتفة(); };
}

عرف عملية_تحويل_ذراع_من_مسير(العملية: عملية_تحويل_صحيح): عملية_تحويل_ذراع_أربعة_وستون {
    طابق العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع عملية_تحويل_ذراع_أربعة_وستون.توسيع_بإشارة(); }
    | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع عملية_تحويل_ذراع_أربعة_وستون.توسيع_صفري(); }
    | عملية_تحويل_صحيح.اقتطاع -> { أرجع عملية_تحويل_ذراع_أربعة_وستون.اقتطاع(); }
    | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع عملية_تحويل_ذراع_أربعة_وستون.إعادة_تفسير(); };
}

عرف مواضع_واجهة_ذراع(الموقع: &موقع_تمرير_واجهة): متجه موضع_جزء_واجهة {
    دع الناتج: متغير متجه موضع_جزء_واجهة = [];
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الموضع) -> { ألحق(الناتج, الموضع); }
    | موقع_تمرير_واجهة.مجزأ(المواضع) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المواضع) مثل طبيعي)) { ألحق(الناتج, المواضع[ف]); ف := ف + 1; }
    }
    | موقع_تمرير_واجهة.غير_مباشر(الموضع) -> { ألحق(الناتج, الموضع); }
    | موقع_تمرير_واجهة.متجاهل -> { };
    أرجع الناتج;
}

عرف موقع_واجهة_غير_مباشر_ذراع(الموقع: &موقع_تمرير_واجهة): منطقي {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف معامل_واجهة_عدد_موقع_ذراع(
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الخطة: &خطة_معامل_واجهة
): منطقي {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
    دع خ: خطة_معامل_واجهة = *الخطة;
    طابق صنف_إشارة_عدد_للاختيار(&حقائق.الأنواع, خ.النوع) مع
    | اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف ناتج_واجهة_عدد_موقع_ذراع(
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الخطة: &خطة_ناتج_واجهة
): منطقي {
    دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
    دع خ: خطة_ناتج_واجهة = *الخطة;
    طابق صنف_إشارة_عدد_للاختيار(&حقائق.الأنواع, خ.النوع) مع
    | اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف علم_واجهة_ذراع(القيمة: منطقي): طبيعي {
    إذا (القيمة) { أرجع 1; };
    أرجع 0;
}

عرف قيمة_واجهة_من_خطة_ذراع(
    السجل: معرف_سجل_افتراضي,
    التصنيف: &تصنيف_قيمة_واجهة,
    الموقع: &موقع_تمرير_واجهة,
    بإشارة: منطقي
): قيمة_واجهة_ذراع_أربعة_وستون_منتقاة {
    دع ت: تصنيف_قيمة_واجهة = *التصنيف;
    دع المواضع: متجه موضع_جزء_واجهة = مواضع_واجهة_ذراع(الموقع);
    دع غير_مباشر: منطقي = موقع_واجهة_غير_مباشر_ذراع(الموقع);
    دع علم_تجميعي: طبيعي = علم_واجهة_ذراع(ت.تجميعي);
    دع علم_غير_مباشر: طبيعي = علم_واجهة_ذراع(غير_مباشر);
    دع علم_بإشارة: طبيعي = علم_واجهة_ذراع(بإشارة);
    دع الناتج: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = {
        السجل: السجل,
        المواضع: المواضع,
        الحجم: ت.الحجم,
        تجميعي: علم_تجميعي,
        غير_مباشر: علم_غير_مباشر,
        بإشارة: علم_بإشارة
    };
    أرجع الناتج;
}

عرف تخطيط_قيمة_مسير_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير
): نتيجة_تخطيط_قيمة_للاختيار {
    أرجع تخطيط_قيمة_مسير_للاختيار(
        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, القيمة
    );
}

عرف خطأ_استعلام_تخطيط_ذراع(
    الفشل: فشل_تخطيط_قيمة_للاختيار
): خطأ_اختيار_ذراع_أربعة_وستون {
    أرجع خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
        سبب_فشل_تخطيط_اختيار_ذراع.استعلام_قيمة(الفشل)
    );
}

عرف تخطيط_تجميعي_ذراع(التخطيط: &واصف_تخطيط): منطقي {
    دع الوصف: واصف_تخطيط = *التخطيط;
    طابق الوصف.التفاصيل مع
    | تفاصيل_تخطيط.صف(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.سجل(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.تعداد(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}
عرف حجم_حجز_إطار_ذراع(التخطيط: &واصف_تخطيط): طبيعي {
    دع الوصف: واصف_تخطيط = *التخطيط;
    إذا (!تخطيط_تجميعي_ذراع(التخطيط)) { أرجع الوصف.الحجم; };
    إذا (الوصف.الحجم == 0) { أرجع 0; };
    أرجع ((الوصف.الحجم + 7) / 8) * 8;
}

عرف حجم_حجز_تجميعي_ذراع(الحجم: طبيعي): طبيعي {
    إذا (الحجم == 0) { أرجع 0; };
    أرجع ((الحجم + 7) / 8) * 8;
}

// حامل جزء ABI قيمة سجلية، لذلك يجب أن يستخدم عرض تحميل/تخزين ARM64
// قابلا للترميز. الحجم الحقيقي للجزء يبقى مستقلا ويستخدم عند إعادة بناء التجميع.
عرف عرض_حامل_جزء_تجميع_ذراع(الحجم: طبيعي): طبيعي {
    إذا (الحجم <= 1) { أرجع 1; };
    إذا (الحجم <= 2) { أرجع 2; };
    إذا (الحجم <= 4) { أرجع 4; };
    أرجع 8;
}


عرف جزء_تخطيط_عند_ذراع(
    التخطيط: &واصف_تخطيط,
    الفهرس: طبيعي
): اختياري موضع_جزء_تخطيط {
    دع الوصف: واصف_تخطيط = *التخطيط;
    طابق الوصف.التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        إذا (الفهرس < (الطول(الأجزاء) مثل طبيعي)) { أرجع اختياري.موجود(الأجزاء[الفهرس]); };
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        إذا (الفهرس < (الطول(الأجزاء) مثل طبيعي)) { أرجع اختياري.موجود(الأجزاء[الفهرس]); };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

عرف أضف_عنوان_عنصر_تسلسل_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المصدر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير,
    تخطيط_العنصر: &واصف_تخطيط,
    الوجهة: معرف_سجل_افتراضي,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    دع تخطيط_المصدر: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المصدر) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المصدر := التخطيط; };

    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المصدر, 0) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المصدر, 0)
        ));
    }
    | اختياري.موجود(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المصدر, 1) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المصدر, 1)
        ));
    }
    | اختياري.موجود(الجزء) -> { جزء_الطول := الجزء; };

    إذا (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة) {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المصدر)
        ));
    };
    دع حجم_مؤشر_البيانات: طبيعي = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
    إذا (حجم_مؤشر_البيانات != 8) {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(المصدر, حجم_مؤشر_البيانات)
        ));
    };

    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المصدر);
    دع إزاحة_البيانات: عدد = جزء_البيانات.الإزاحة مثل عدد;
    دع عنوان_البيانات: عنوان_ذاكرة_ذراع_أربعة_وستون = {
        الأساس: سجل_المصدر, إزاحة_بايت: إزاحة_البيانات
    };
    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
        الوجهة, عنوان_البيانات, حجم_مؤشر_البيانات, خطأ
    ));
    دع وصف_العنصر: واصف_تخطيط = *تخطيط_العنصر;
    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_عنصر_ذراع(
        الوجهة, الوجهة, سجل_لقيمة_مسير(الفهرس), وصف_العنصر.الحجم
    ));
    أرجع اختياري.لا_شيء();
}

عرف أضف_تخزين_قيمة_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الأساس: معرف_سجل_افتراضي,
    الإزاحة: طبيعي,
    القيمة: معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, القيمة) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(القيمة);
        إذا (تخطيط_تجميعي_ذراع(&التخطيط)) {
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(
                    الأساس, سجل_القيمة, التخطيط.الحجم, الإزاحة, 0
                )
            );
        } وإلا {
            إذا (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                    سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(القيمة, التخطيط.الحجم)
                ));
            };
            دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
            دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: الأساس, إزاحة_بايت: الإزاحة_الموقعة };
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(
                سجل_القيمة, العنوان, التخطيط.الحجم
            ));
        };
        أرجع اختياري.لا_شيء();
    };
}

عرف أضف_استخراج_من_عنوان_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    الأساس: معرف_سجل_افتراضي,
    الإزاحة: طبيعي,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        دع و: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
        إذا (تخطيط_تجميعي_ذراع(&التخطيط)) {
            // استخراج الحمولة ينتج قيمة تجميعية مستقلة، لا اسما مستعارا داخل مخزن التعداد.
            // هذا يطابق دلالة استخراج الفهرس ويمنع فساد الحمولة عند عبور حدود النداء.
            دع حجم_الحجز: طبيعي = حجم_حجز_إطار_ذراع(&التخطيط);
            دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                الوجهة: و,
                الهوية: الناتج.القيمة,
                الحجم: حجم_الحجز,
                المحاذاة: التخطيط.المحاذاة
            };
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(
                    و, الأساس, التخطيط.الحجم, 0, الإزاحة
                )
            );
        } وإلا {
            إذا (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                    سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, التخطيط.الحجم)
                ));
            };
            دع بإشارة: متغير منطقي = خطأ;
            طابق وصف_عدد_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الناتج) مع
            | اختياري.موجود(وصف) -> { بإشارة := وصف.موقع; }
            | اختياري.لا_شيء -> { };
            دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
            دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: الأساس, إزاحة_بايت: الإزاحة_الموقعة };
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(و, العنوان, التخطيط.الحجم, بإشارة));
        };
        أرجع اختياري.لا_شيء();
    };
}

عرف ألحق_تهيئة_متجه_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    التهيئة: &تهيئة_متجه_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        إذا (!تخطيط_تجميعي_ذراع(&التخطيط)) {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج)
            ));
        };
        دع جزء_البيانات: موضع_جزء_تخطيط;
        دع جزء_الطول: موضع_جزء_تخطيط;
        دع جزء_السعة: موضع_جزء_تخطيط;
        طابق جزء_تخطيط_عند_ذراع(&التخطيط, 0) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 0)
            ));
        }
        | اختياري.موجود(الجزء) -> { جزء_البيانات := الجزء; };
        طابق جزء_تخطيط_عند_ذراع(&التخطيط, 1) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 1)
            ));
        }
        | اختياري.موجود(الجزء) -> { جزء_الطول := الجزء; };
        طابق جزء_تخطيط_عند_ذراع(&التخطيط, 2) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 2)
            ));
        }
        | اختياري.موجود(الجزء) -> { جزء_السعة := الجزء; };
        إذا (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة
            || جزء_السعة.الإزاحة <= جزء_الطول.الإزاحة
            || التخطيط.الحجم <= جزء_السعة.الإزاحة) {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج)
            ));
        };
        دع حجم_البيانات: طبيعي = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
        دع حجم_الطول: طبيعي = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
        دع حجم_السعة: طبيعي = التخطيط.الحجم - جزء_السعة.الإزاحة;
        إذا (!(حجم_البيانات == 1 || حجم_البيانات == 2 || حجم_البيانات == 4 || حجم_البيانات == 8)) {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, حجم_البيانات)
            ));
        };
        إذا (!(حجم_الطول == 1 || حجم_الطول == 2 || حجم_الطول == 4 || حجم_الطول == 8)) {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, حجم_الطول)
            ));
        };
        إذا (!(حجم_السعة == 1 || حجم_السعة == 2 || حجم_السعة == 4 || حجم_السعة == 8)) {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, حجم_السعة)
            ));
        };
        دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
        دع حجم_الحجز: طبيعي = حجم_حجز_إطار_ذراع(&التخطيط);
        دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
            الوجهة: الوجهة,
            الهوية: الناتج.القيمة,
            الحجم: حجم_الحجز,
            المحاذاة: التخطيط.المحاذاة
        };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
        دع صفر_البيانات: تخزين_فوري_ذراع_أربعة_وستون = {
            الأساس: الوجهة,
            الإزاحة: جزء_البيانات.الإزاحة,
            الحجم: حجم_البيانات,
            القيمة: 0
        };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(صفر_البيانات));
        دع صفر_الطول: تخزين_فوري_ذراع_أربعة_وستون = {
            الأساس: الوجهة,
            الإزاحة: جزء_الطول.الإزاحة,
            الحجم: حجم_الطول,
            القيمة: 0
        };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(صفر_الطول));
        دع صفر_السعة: تخزين_فوري_ذراع_أربعة_وستون = {
            الأساس: الوجهة,
            الإزاحة: جزء_السعة.الإزاحة,
            الحجم: حجم_السعة,
            القيمة: 0
        };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(صفر_السعة));
        // append ليس نداء Sultan عادي: يحتاج عنوان رأس المتجه مع حقائق Layout
        // وسياسة نمو Runtime. نحمله كتعليمة آلة مخصصة ثم encoder يمرر metadata المخفية.
        إذا (!(حجم_البيانات == 8 && حجم_الطول == 8 && حجم_السعة == 8)) {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج)
            ));
        };
        دع سياسة_النمو: سياسة_نمو_متجه = سياسة_نمو_المتجه();
        دع وصف_التهيئة: تهيئة_متجه_مسير = *التهيئة;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(وصف_التهيئة.العناصر) مثل طبيعي)) {
            دع العنصر: معرف_قيمة_مسير = وصف_التهيئة.العناصر[ف];
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العنصر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_العنصر) -> {
                أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_العنصر));
            }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_العنصر) -> {
                إذا (تخطيط_العنصر.الحجم == 0) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                        سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(العنصر, 0)
                    ));
                };
                إذا (!تخطيط_تجميعي_ذراع(&تخطيط_العنصر)
                    && !(تخطيط_العنصر.الحجم == 1 || تخطيط_العنصر.الحجم == 2
                        || تخطيط_العنصر.الحجم == 4 || تخطيط_العنصر.الحجم == 8)) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                        سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(العنصر, تخطيط_العنصر.الحجم)
                    ));
                };
                دع سجل_العنصر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(العنصر);
                دع العنصر_تجميعي: منطقي = تخطيط_تجميعي_ذراع(&تخطيط_العنصر);
                دع الإلحاق: إلحاق_متجه_ذراع_أربعة_وستون = {
                    المتجه: الوجهة,
                    العنصر: سجل_العنصر,
                    إزاحة_البيانات: جزء_البيانات.الإزاحة,
                    إزاحة_الطول: جزء_الطول.الإزاحة,
                    إزاحة_السعة: جزء_السعة.الإزاحة,
                    حجم_الطول: حجم_الطول,
                    حجم_السعة: حجم_السعة,
                    حجم_العنصر: تخطيط_العنصر.الحجم,
                    العنصر_تجميعي: العنصر_تجميعي,
                    السعة_الدنيا: سياسة_نمو_المتجه_لعنصر(تخطيط_العنصر.الحجم مثل طبيعي).السعة_الدنيا,
                    عامل_النمو: سياسة_النمو.عامل_النمو,
                    الحجز: خطأ
                };
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.إلحاق_متجه_ذراع(الإلحاق));
            };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}


// Extend (إلحاق_نطاق_متجه): the vector header layout and the integer
// element size, as append and reserve read them.
عرف ألحق_امتداد_متجه_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المتجه: معرف_قيمة_مسير,
    المصدر: معرف_قيمة_مسير,
    البداية: معرف_قيمة_مسير,
    العدد: معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    دع غير_متوافق: خطأ_اختيار_ذراع_أربعة_وستون = خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
        سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المتجه)
    );
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المتجه) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المتجه := التخطيط; };
    إذا (!تخطيط_تجميعي_ذراع(&تخطيط_المتجه)) { أرجع اختياري.موجود(غير_متوافق); };
    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    دع جزء_السعة: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 0) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(غير_متوافق); }
    | اختياري.موجود(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 1) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(غير_متوافق); }
    | اختياري.موجود(الجزء) -> { جزء_الطول := الجزء; };
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 2) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(غير_متوافق); }
    | اختياري.موجود(الجزء) -> { جزء_السعة := الجزء; };
    إذا (جزء_الطول.الإزاحة != جزء_البيانات.الإزاحة + 8 || جزء_السعة.الإزاحة != جزء_الطول.الإزاحة + 8
        || تخطيط_المتجه.الحجم != جزء_السعة.الإزاحة + 8) {
        أرجع اختياري.موجود(غير_متوافق);
    };
    دع حجم_العنصر: متغير طبيعي = 0;
    دع نوع_العنصر: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق نوع_قيمة_مسير(المسير, المتجه) مع
    | اختياري.موجود(نوع_المتجه) -> { نوع_العنصر := نوع_عنصر_تسلسل_دلالي(&(*حقائق_الخلفية).الأنواع, نوع_المتجه); }
    | اختياري.لا_شيء -> { };
    طابق نوع_العنصر مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(غير_متوافق); }
    | اختياري.موجود(النوع) -> {
        طابق تخطيط_نوع_للاختيار(حقائق_الخلفية, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_تخطيط.مكتمل(التخطيط) -> { حجم_العنصر := التخطيط.الحجم; }
        | _ -> { أرجع اختياري.موجود(غير_متوافق); };
    };
    إذا (!(حجم_العنصر == 1 || حجم_العنصر == 2 || حجم_العنصر == 4 || حجم_العنصر == 8)) {
        أرجع اختياري.موجود(غير_متوافق);
    };
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(حجم_العنصر);
    دع الامتداد: امتداد_متجه_ذراع_أربعة_وستون = {
        المتجه: سجل_لقيمة_مسير(المتجه),
        المصدر: سجل_لقيمة_مسير(المصدر),
        البداية: سجل_لقيمة_مسير(البداية),
        العدد: سجل_لقيمة_مسير(العدد),
        إزاحة_البيانات: جزء_البيانات.الإزاحة,
        إزاحة_الطول: جزء_الطول.الإزاحة,
        إزاحة_السعة: جزء_السعة.الإزاحة,
        حجم_العنصر: حجم_العنصر,
        السعة_الدنيا: السياسة.السعة_الدنيا,
        عامل_النمو: السياسة.عامل_النمو
    };
    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.امتداد_متجه_ذراع(الامتداد));
    أرجع اختياري.لا_شيء();
}

عرف ألحق_إلحاق_متجه_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المتجه: معرف_قيمة_مسير,
    العنصر: معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    الحجز: منطقي
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المتجه) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المتجه := التخطيط; };
    إذا (!تخطيط_تجميعي_ذراع(&تخطيط_المتجه)) {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المتجه)
        ));
    };
    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    دع جزء_السعة: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 0) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المتجه, 0))); }
    | اختياري.موجود(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 1) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المتجه, 1))); }
    | اختياري.موجود(الجزء) -> { جزء_الطول := الجزء; };
    طابق جزء_تخطيط_عند_ذراع(&تخطيط_المتجه, 2) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المتجه, 2))); }
    | اختياري.موجود(الجزء) -> { جزء_السعة := الجزء; };
    إذا (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة
        || جزء_السعة.الإزاحة <= جزء_الطول.الإزاحة
        || تخطيط_المتجه.الحجم <= جزء_السعة.الإزاحة) {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المتجه)
        ));
    };
    دع حجم_البيانات: طبيعي = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
    دع حجم_الطول: طبيعي = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
    دع حجم_السعة: طبيعي = تخطيط_المتجه.الحجم - جزء_السعة.الإزاحة;
    إذا (!(حجم_البيانات == 8 && حجم_الطول == 8 && حجم_السعة == 8)) {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المتجه)
        ));
    };
    // Reserve takes the element layout from the vector's Type; its second
    // argument is the additional count, not an element.
    دع تخطيط_المصدر: متغير نتيجة_تخطيط_قيمة_للاختيار = تخطيط_قيمة_مسير_ذراع(
        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العنصر
    );
    إذا (الحجز) {
        دع نوع_العنصر: متغير اختياري معرف_نوع = اختياري.لا_شيء();
        طابق نوع_قيمة_مسير(المسير, المتجه) مع
        | اختياري.موجود(نوع_المتجه) -> { نوع_العنصر := نوع_عنصر_تسلسل_دلالي(&(*حقائق_الخلفية).الأنواع, نوع_المتجه); }
        | اختياري.لا_شيء -> { };
        طابق نوع_العنصر مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المتجه)
            ));
        }
        | اختياري.موجود(النوع) -> {
            طابق تخطيط_نوع_للاختيار(حقائق_الخلفية, الهدف, سجل_التخطيط, النوع) مع
            | نتيجة_تخطيط.مكتمل(التخطيط) -> { تخطيط_المصدر := نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط); }
            | _ -> {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                    سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(المتجه)
                ));
            };
        };
    };
    طابق تخطيط_المصدر مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_العنصر) -> {
        إذا (تخطيط_العنصر.الحجم == 0) {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(العنصر, 0)
            ));
        };
        إذا (!تخطيط_تجميعي_ذراع(&تخطيط_العنصر)
            && !(تخطيط_العنصر.الحجم == 1 || تخطيط_العنصر.الحجم == 2
                || تخطيط_العنصر.الحجم == 4 || تخطيط_العنصر.الحجم == 8)) {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(العنصر, تخطيط_العنصر.الحجم)
            ));
        };
        دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(تخطيط_العنصر.الحجم مثل طبيعي);
        دع سجل_المتجه: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المتجه);
        دع سجل_العنصر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(العنصر);
        دع العنصر_تجميعي: منطقي = تخطيط_تجميعي_ذراع(&تخطيط_العنصر) && !الحجز;
        دع الإلحاق: إلحاق_متجه_ذراع_أربعة_وستون = {
            المتجه: سجل_المتجه, العنصر: سجل_العنصر,
            إزاحة_البيانات: جزء_البيانات.الإزاحة, إزاحة_الطول: جزء_الطول.الإزاحة,
            إزاحة_السعة: جزء_السعة.الإزاحة, حجم_الطول: حجم_الطول, حجم_السعة: حجم_السعة,
            حجم_العنصر: تخطيط_العنصر.الحجم, العنصر_تجميعي: العنصر_تجميعي,
            السعة_الدنيا: السياسة.السعة_الدنيا, عامل_النمو: السياسة.عامل_النمو,
            الحجز: الحجز
        };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.إلحاق_متجه_ذراع(الإلحاق));
        أرجع اختياري.لا_شيء();
    };
}

عرف حزمة_نقل_حافة(
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير
): نتيجة متطلبات_نقل_حافة_منتقاة, خطأ_اختيار_ذراع_أربعة_وستون {
    دع القيمة: حافة_مسير = *الحافة;
    طابق ابحث_كتلة_مسير(المسير, القيمة.الهدف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(المعرف) -> {
        أرجع نتيجة.خطأ(خطأ_اختيار_ذراع_أربعة_وستون.كتلة_مسير_مفقودة(المعرف));
    }
    | نتيجة_بحث_كتلة_مسير.موجودة(الهدف) -> {
        إذا ((الطول(القيمة.الحجج) مثل طبيعي) != الهدف.عدد_المعاملات) {
            أرجع نتيجة.خطأ(خطأ_اختيار_ذراع_أربعة_وستون.حافة_غير_صالحة(القيمة.الهدف));
        };
        دع النقلات: متغير متجه نقلة_حافة_منتقاة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < الهدف.عدد_المعاملات) {
            طابق معامل_كتلة_مسير_عند(المسير, القيمة.الهدف, ف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(
                    خطأ_اختيار_ذراع_أربعة_وستون.حافة_غير_صالحة(القيمة.الهدف)
                );
            }
            | اختياري.موجود(المعامل) -> {
                دع مصدر_النقلة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(القيمة.الحجج[ف]);
                دع وجهة_النقلة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المعامل.المعرف);
                دع النقلة: نقلة_حافة_منتقاة = {
                    المصدر: مصدر_النقلة,
                    الوجهة: وجهة_النقلة
                };
                ألحق(النقلات, النقلة);
            };
            ف := ف + 1;
        }
        دع هدف_الحزمة: معرف_كتلة_منتقاة = كتلة_منتقاة_من_مسير(القيمة.الهدف);
        دع الحزمة: متطلبات_نقل_حافة_منتقاة = {
            الهدف: هدف_الحزمة,
            النقلات: النقلات
        };
        أرجع نتيجة.نجح(الحزمة);
    };
}

// The selected argument of one call argument. An internal hidden reference
// (an aggregate passed indirectly that the callee never writes) travels as
// a pointer: the address of the value's own bytes when nothing can change
// them during the call (مخازن_ثابتة_للنداء_مسير, the copy-elision rule in
// compiler/msir/msir_copies.sn), else of a copy made in a frame slot of the
// call. A foreign indirect argument (نسخة_للمستدعى) stays an indirect
// aggregate, which the encoder copies for the C callee.
عرف حجة_نداء_ذراع(
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    عدد_السجلات: &متغير طبيعي,
    الثابتة: &متجه منطقي,
    القيمة: معرف_قيمة_مسير,
    المعامل: &خطة_معامل_واجهة,
    بإشارة: منطقي
): قيمة_واجهة_ذراع_أربعة_وستون_منتقاة {
    دع سجل_القيمة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(القيمة);
    إذا (!(*المعامل).التصنيف.تجميعي || (*المعامل).التصنيف.نسخة_للمستدعى
        || !موقع_واجهة_غير_مباشر_ذراع(&(*المعامل).الموقع)) {
        أرجع قيمة_واجهة_من_خطة_ذراع(سجل_القيمة, &(*المعامل).التصنيف, &(*المعامل).الموقع, بإشارة);
    };
    دع العنوان: متغير معرف_سجل_افتراضي = سجل_القيمة;
    دع ثابتة: منطقي = (القيمة.القيمة مثل طبيعي) < (الطول(*الثابتة) مثل طبيعي) && (*الثابتة)[القيمة.القيمة];
    إذا (!ثابتة) {
        دع النسخة: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
        *عدد_السجلات := *عدد_السجلات + 1;
        دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
            الوجهة: النسخة,
            الهوية: النسخة.القيمة,
            الحجم: حجم_حجز_تجميعي_ذراع((*المعامل).التصنيف.الحجم),
            المحاذاة: (*المعامل).التصنيف.المحاذاة
        };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات,
            تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(النسخة, سجل_القيمة, (*المعامل).التصنيف.الحجم, 0, 0));
        العنوان := النسخة;
    };
    دع الحجة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = {
        السجل: العنوان,
        المواضع: مواضع_واجهة_ذراع(&(*المعامل).الموقع),
        الحجم: 8,
        تجميعي: 0,
        غير_مباشر: 0,
        بإشارة: 0
    };
    أرجع الحجة;
}

عرف ألحق_نداء_ذراع_بخطة(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    عدد_السجلات: &متغير طبيعي,
    الثابتة: &متجه منطقي,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    هدف_النداء: هدف_نداء_ذراع_أربعة_وستون,
    حجج_المسير: &متجه معرف_قيمة_مسير,
    ناتج_المسير: اختياري معرف_قيمة_مسير,
    الخطة: &خطة_دالة_واجهة
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    دع خ: خطة_دالة_واجهة = *الخطة;
    دع قيم_الحجج: متجه معرف_قيمة_مسير = *حجج_المسير;
    دع عدد_قيم_الحجج: طبيعي = الطول(قيم_الحجج) مثل طبيعي;
    دع عدد_المعاملات: طبيعي = الطول(خ.المعاملات) مثل طبيعي;
    إذا (عدد_قيم_الحجج != عدد_المعاملات) {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة());
    };
    دع الحجج: متغير متجه قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_قيم_الحجج) {
        دع مرجع_خطة_المعامل: &خطة_معامل_واجهة = &خ.المعاملات[ف];
        دع خطة_المعامل: خطة_معامل_واجهة = *مرجع_خطة_المعامل;
        طابق خطة_المعامل.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> {
            دع قيمة_الحجة: معرف_قيمة_مسير = قيم_الحجج[ف];
            دع الحجة_موقعة: منطقي = معامل_واجهة_عدد_موقع_ذراع(حقائق_الخلفية, &خطة_المعامل);
            دع الحجة: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = حجة_نداء_ذراع(
                التعليمات, عدد_السجلات, الثابتة, قيمة_الحجة, مرجع_خطة_المعامل, الحجة_موقعة
            );
            ألحق(الحجج, الحجة);
        };
        ف := ف + 1;
    }

    دع الناتج: متغير اختياري قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = اختياري.لا_شيء();
    طابق ناتج_المسير مع
    | اختياري.لا_شيء -> {
        طابق خ.الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة()); };
    }
    | اختياري.موجود(المعرف) -> {
        طابق خ.الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> {
            دع سجل_الناتج: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المعرف);
            دع الناتج_موقع: منطقي = ناتج_واجهة_عدد_موقع_ذراع(حقائق_الخلفية, &خ.الناتج);
            دع الناتج_المختار: قيمة_واجهة_ذراع_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_ذراع(
                سجل_الناتج, &خ.الناتج.التصنيف, &خ.الناتج.الموقع, الناتج_موقع
            );
            إذا (الناتج_المختار.تجميعي != 0) {
                دع حجم_التجميع: طبيعي = خ.الناتج.التصنيف.الحجم;
                دع محاذاة_التجميع: طبيعي = خ.الناتج.التصنيف.المحاذاة;
                دع هوية_التجميع: طبيعي = المعرف.القيمة;
                دع حجم_الحجز: طبيعي = حجم_حجز_تجميعي_ذراع(حجم_التجميع);
                دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                    الوجهة: سجل_الناتج,
                    الهوية: هوية_التجميع,
                    الحجم: حجم_الحجز,
                    المحاذاة: محاذاة_التجميع
                };
                دع تعليمة_الحجز: تعليمة_ذراع_أربعة_وستون =
                    تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز);
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_الحجز);
            };
            الناتج := اختياري.موجود(الناتج_المختار);
        };
    };

    دع النداء: نداء_ذراع_أربعة_وستون_منتقى = {
        الهدف: هدف_النداء,
        الحجج: الحجج,
        الناتج: الناتج,
        حجم_مكدس_النداء: خ.حجم_مكدس_النداء
    };
    دع تعليمة_النداء: تعليمة_ذراع_أربعة_وستون =
        تعليمة_ذراع_أربعة_وستون.فرع_برابط_ذراع_مباشر(النداء);
    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_النداء);
    أرجع اختياري.لا_شيء();
}

// A Linux kernel call: the kernel number and six arguments (and for the
// thread clone the closure) travel as an ordinary seven-value call plan in
// x0..x6; the encoder moves them into x8 and x0..x5 for svc #0.
عرف ألحق_نداء_نواة_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    استنساخ: منطقي
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    دع نواة_مباشرة: منطقي = هدف_نواة_لينكس_مباشر(الهدف)
        || (!استنساخ && هدف_نواة_فري_بي_إس_دي_مباشر(الهدف));
    إذا (!نواة_مباشرة || (الطول(*الحجج) مثل طبيعي) != 7) {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
    | اختياري.موجود(_) -> { };
    طابق حل_واجهة_نداء_قيم_مسير_للهدف(
        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الحجج, الناتج
    ) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ));
    }
    | نتيجة.نجح(الخطة) -> {
        دع بلا_سجلات: متغير طبيعي = 0;
        دع بلا_ثابتة: متجه منطقي = [];
        أرجع ألحق_نداء_ذراع_بخطة(
            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير بلا_سجلات, &بلا_ثابتة, التعليمات,
            هدف_نداء_ذراع_أربعة_وستون.نداء_نواة(استنساخ), الحجج, الناتج, &الخطة
        );
    };
}

عرف ألحق_بدائي_هوية_مضيف_ذراع(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    إذا ((الطول(*الحجج) مثل طبيعي) != 0) {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    دع معرف_الناتج: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
    }
    | اختياري.موجود(المعرف) -> { معرف_الناتج := المعرف; };
    طابق رمز_بدائي_هوية_مضيف_للهدف(الهدف, البدائي) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    }
    | اختياري.موجود(الرمز) -> {
        ألحق_تعليمة_ذراع_للاختيار(التعليمات,
            تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(
                سجل_لقيمة_مسير(معرف_الناتج), الرمز مثل طبيعي
            )
        );
        أرجع اختياري.لا_شيء();
    };
}

// The closure-environment reference-counting primitives on the header laid
// out by خطط_بيئة_إغلاق_للاختيار: count one more reference; count one fewer
// and answer whether none is left; or point word zero at the destructor and
// answer the environment itself, now a `() -> ()` closure running it.
عرف ألحق_بدائي_بيئة_إغلاق_ذراع(
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    عدد_السجلات: &متغير طبيعي,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    إذا ((الطول(*الحجج) مثل طبيعي) != 1) {
        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    دع البيئة: معرف_سجل_افتراضي = سجل_لقيمة_مسير((*الحجج)[0]);
    دع الأول: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
    دع الثاني: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات + 1);
    دع الثالث: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات + 2);
    *عدد_السجلات := *عدد_السجلات + 3;
    طابق البدائي مع
    // An atomic fetch-add changes the count (closures and std.sync's
    // مشترك are copied and dropped on several threads; Swift's retain/release).
    | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> {
        دع الرابع: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
        *عدد_السجلات := *عدد_السجلات + 1;
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(الثاني, إزاحة_عداد_بيئة_إغلاق() مثل عدد));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.جمع_سجل_ذراع(الأول, البيئة, الثاني));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(الثالث, 1));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ذري_ذراع(
            عملية_ذرية_ذراع.جلب_جمع(), الرابع, الأول, الثالث, 64
        ));
    }
    | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> {
        دع سجل_الناتج: معرف_سجل_افتراضي;
        طابق الناتج مع
        | اختياري.موجود(القيمة) -> { سجل_الناتج := سجل_لقيمة_مسير(القيمة); }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); };
        دع الرابع: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
        دع الواحد: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات + 1);
        *عدد_السجلات := *عدد_السجلات + 2;
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(الثاني, إزاحة_عداد_بيئة_إغلاق() مثل عدد));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.جمع_سجل_ذراع(الأول, البيئة, الثاني));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(الثالث, -1));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ذري_ذراع(
            عملية_ذرية_ذراع.جلب_جمع(), الرابع, الأول, الثالث, 64
        ));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(الواحد, 1));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(الرابع, الواحد));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(
            سجل_الناتج, شرط_ذراع_أربعة_وستون.تكافؤ()
        ));
    }
    | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> {
        دع سجل_الناتج: معرف_سجل_افتراضي;
        طابق الناتج مع
        | اختياري.موجود(القيمة) -> { سجل_الناتج := سجل_لقيمة_مسير(القيمة); }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); };
        دع عنوان_المدمر: عنوان_ذاكرة_ذراع_أربعة_وستون = {
            الأساس: البيئة, إزاحة_بايت: إزاحة_مدمر_بيئة_إغلاق() مثل عدد
        };
        دع عنوان_الشفرة: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: البيئة, إزاحة_بايت: 0 };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(الأول, عنوان_المدمر, 8, خطأ));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(الأول, عنوان_الشفرة, 8));
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(سجل_الناتج, البيئة));
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
    أرجع اختياري.لا_شيء();
}

// The width in bits of an atomic operand (4 or 8 bytes).
عرف بتات_قيمة_ذرية_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير
): اختياري طبيعي {
    طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, القيمة) مع
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        إذا (التخطيط.الحجم == 4 || التخطيط.الحجم == 8) { أرجع اختياري.موجود(التخطيط.الحجم * 8); };
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(_) -> { أرجع اختياري.لا_شيء(); };
}

// Atomic primitives (encoder.sn): LDAR, STLR, and compare-and-swap and
// read-modify-writes (LSE CASAL/LDADDAL... on macOS, LDAXR/STLXR loops on
// ARMv8.0 platforms), all acquire-release; a fence is DMB ISH.
عرف ألحق_بدائي_ذري_ذراع(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    دع العدد: طبيعي = الطول(*الحجج) مثل طبيعي;
    طابق البدائي مع
    | هوية_بدائي_مترجم.سياج_ذاكرة -> {
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.سياج_ذراع());
        أرجع اختياري.لا_شيء();
    }
    | هوية_بدائي_مترجم.ذري_خزن -> {
        إذا (العدد != 3) { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        طابق بتات_قيمة_ذرية_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, (*الحجج)[1]) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); }
        | اختياري.موجود(البتات) -> {
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ذري_خزن_ذراع(
                سجل_لقيمة_مسير((*الحجج)[0]), سجل_لقيمة_مسير((*الحجج)[1]), البتات
            ));
        };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { };
    دع سجل_الناتج: معرف_سجل_افتراضي;
    دع البتات: طبيعي;
    طابق الناتج مع
    | اختياري.موجود(القيمة) -> {
        سجل_الناتج := سجل_لقيمة_مسير(القيمة);
        طابق بتات_قيمة_ذرية_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); }
        | اختياري.موجود(ب) -> { البتات := ب; };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); };
    طابق البدائي مع
    | هوية_بدائي_مترجم.ذري_حمل -> {
        إذا (العدد != 2) { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ذري_حمل_ذراع(سجل_الناتج, سجل_لقيمة_مسير((*الحجج)[0]), البتات));
    }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> {
        إذا (العدد != 5) { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ذري_قارن_وبدل_ذراع(
            سجل_الناتج, سجل_لقيمة_مسير((*الحجج)[0]), سجل_لقيمة_مسير((*الحجج)[1]),
            سجل_لقيمة_مسير((*الحجج)[2]), البتات
        ));
    }
    | _ -> {
        إذا (العدد != 3) { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        دع العملية: متغير عملية_ذرية_ذراع = عملية_ذرية_ذراع.تبديل();
        طابق البدائي مع
        | هوية_بدائي_مترجم.ذري_تبديل -> { العملية := عملية_ذرية_ذراع.تبديل(); }
        | هوية_بدائي_مترجم.ذري_جلب_جمع -> { العملية := عملية_ذرية_ذراع.جلب_جمع(); }
        | هوية_بدائي_مترجم.ذري_جلب_و -> { العملية := عملية_ذرية_ذراع.جلب_و(); }
        | هوية_بدائي_مترجم.ذري_جلب_أو -> { العملية := عملية_ذرية_ذراع.جلب_أو(); }
        | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { العملية := عملية_ذرية_ذراع.جلب_أو_حصري(); }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ذري_ذراع(
            العملية, سجل_الناتج, سجل_لقيمة_مسير((*الحجج)[0]), سجل_لقيمة_مسير((*الحجج)[1]), البتات
        ));
    };
    أرجع اختياري.لا_شيء();
}

عرف انتق_تعليمة_ذراع_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    عدد_السجلات: &متغير طبيعي,
    التعليمة: &عرض_تعليمة_مسير,
    التعليمات: &متغير متجه تعليمة_ذراع_أربعة_وستون,
    قراءات_الطول: &متجه منطقي,
    الثابتة: &متجه منطقي
): اختياري خطأ_اختيار_ذراع_أربعة_وستون {
    دع العرض: عرض_تعليمة_مسير = *التعليمة;
    طابق العرض.العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختياري.موجود(الناتج) -> {
            دع السجل: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
            طابق الثابت مع
            | ثابت_مسير.صحيح_موقع(القيمة) -> {
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(السجل, القيمة));
            }
            | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(السجل, القيمة));
            }
            | ثابت_مسير.مؤشر_فارغ -> {
                // Verified MSIR guarantees a raw-pointer Type. ARM64's
                // canonical pointer register is zeroed, never an address.
                إذا ((*الهدف).نموذج_البيانات.عرض_المؤشر != 64) {
                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ثابت_غير_مدعوم());
                };
                ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                    تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(السجل, 0));
            }
            | ثابت_مسير.منطق(القيمة) -> {
                إذا (القيمة) {
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(السجل, 1));
                }
                وإلا {
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(السجل, 0));
                };
            }
            | ثابت_مسير.عشري(البايتات) -> {
                دع العرض_عائم: متغير طبيعي = 0;
                طابق بتات_قيمة_عائمة_ذراع(المسير, حقائق_الخلفية, الناتج) مع
                | اختياري.موجود(ب) -> { العرض_عائم := ب; }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ثابت_غير_مدعوم()); };
                طابق بتات_عائم_من_عشري(&البايتات, العرض_عائم) مع
                | اختياري.موجود(الخام) -> {
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(السجل, الخام));
                }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ثابت_غير_مدعوم()); };
            }
            | ثابت_مسير.دالة(الدالة) -> {
                دع الهدف_المنتقى: معرف_دالة_منتقاة = دالة_منتقاة_من_مسير(الدالة);
                ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                    تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(السجل, الهدف_المنتقى)
                );
            }
            | ثابت_مسير.نص(البايتات) -> {
                طابق تخطيط_قيمة_مسير_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج
                ) مع
                | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                    أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
                }
                | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                    إذا (!تخطيط_تجميعي_ذراع(&التخطيط)) {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج)
                        ));
                    };
                    دع إزاحة_البيانات: متغير طبيعي = 0;
                    دع إزاحة_الطول: متغير طبيعي = 0;
                    دع إزاحة_السعة: متغير طبيعي = 0;
                    طابق جزء_تخطيط_عند_ذراع(&التخطيط, 0) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 0))); }
                    | اختياري.موجود(الجزء_الأول) -> { إزاحة_البيانات := الجزء_الأول.الإزاحة; };
                    طابق جزء_تخطيط_عند_ذراع(&التخطيط, 1) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 1))); }
                    | اختياري.موجود(الجزء_الثاني) -> { إزاحة_الطول := الجزء_الثاني.الإزاحة; };
                    طابق جزء_تخطيط_عند_ذراع(&التخطيط, 2) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, 2))); }
                    | اختياري.موجود(الجزء_الثالث) -> { إزاحة_السعة := الجزء_الثالث.الإزاحة; };
                    دع حجم_الحجز: طبيعي = حجم_حجز_إطار_ذراع(&التخطيط);
                    دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                        الوجهة: السجل,
                        الهوية: الناتج.القيمة,
                        الحجم: حجم_الحجز,
                        المحاذاة: التخطيط.المحاذاة
                    };
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                    دع الثابت_النصي: ثابت_نص_ذراع_أربعة_وستون = {
                        الوجهة: السجل,
                        الهوية: الناتج.القيمة,
                        البايتات: انسخ_بايتات(&البايتات),
                        إزاحة_البيانات: إزاحة_البيانات,
                        إزاحة_الطول: إزاحة_الطول,
                        إزاحة_السعة: إزاحة_السعة
                    };
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ثابت_نص_ذراع(الثابت_النصي));
                };
            }
            | ثابت_مسير.متجه(_) -> {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ثابت_غير_مدعوم());
            };
        };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق وصف_تحويل_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, التحويل.المصدر) مع
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); }
            | اختياري.موجود(وصف_المصدر) -> {
                طابق وصف_تحويل_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الناتج) مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); }
                | اختياري.موجود(وصف_الناتج) -> {
                    دع العملية_المختارة: عملية_تحويل_ذراع_أربعة_وستون = عملية_تحويل_ذراع_من_مسير(التحويل.العملية);
                    دع سجل_الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التحويل.المصدر);
                    دع المختار: تحويل_صحيح_ذراع_أربعة_وستون = {
                        العملية: العملية_المختارة,
                        الوجهة: سجل_الوجهة,
                        المصدر: سجل_المصدر,
                        بتات_المصدر: وصف_المصدر.البتات,
                        بتات_الوجهة: وصف_الناتج.البتات,
                        المصدر_موقع: وصف_المصدر.موقع,
                        الوجهة_موقع: وصف_الناتج.موقع
                    };
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تحويل_صحيح_ذراع(المختار));
                };
            };
        };
    }
    | عملية_مسير.نقل_تسلسل_مملوك(النقل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(
                    سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(النقل.المصدر)
                )
            );
        };
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختياري.موجود(الناتج) -> {
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(
                    سجل_لقيمة_مسير(الناتج),
                    سجل_لقيمة_مسير(التحويل.المرجع)
                )
            );
        };
    }
    | عملية_مسير.تجميع(التجميع) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                دع حجم_الحجز: طبيعي = حجم_حجز_إطار_ذراع(&التخطيط);
                دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                    الوجهة: الوجهة, الهوية: الناتج.القيمة,
                    الحجم: حجم_الحجز, المحاذاة: التخطيط.المحاذاة
                };
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(التجميع.الأعضاء) مثل طبيعي)) {
                    طابق جزء_تخطيط_عند_ذراع(&التخطيط, ف) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الناتج, ف))); }
                    | اختياري.موجود(الجزء) -> {
                        طابق أضف_تخزين_قيمة_ذراع(
                            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                            الوجهة, الجزء.الإزاحة, التجميع.الأعضاء[ف], التعليمات
                        ) مع
                        | اختياري.موجود(خطأ_التخطيط) -> { أرجع اختياري.موجود(خطأ_التخطيط); }
                        | اختياري.لا_شيء -> { };
                    };
                    ف := ف + 1;
                }
            };
        };
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختياري.موجود(الناتج) -> {
            طابق ألحق_تهيئة_متجه_ذراع(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                الناتج, &التهيئة, التعليمات
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الاستخراج.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المصدر) -> {
                طابق جزء_تخطيط_عند_ذراع(&تخطيط_المصدر, الاستخراج.الفهرس) مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(الاستخراج.المصدر, الاستخراج.الفهرس))); }
                | اختياري.موجود(الجزء) -> {
                    طابق أضف_استخراج_من_عنوان_ذراع(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                        الناتج, سجل_لقيمة_مسير(الاستخراج.المصدر), الجزء.الإزاحة,
                        التعليمات
                    ) مع
                    | اختياري.موجود(خطأ_التخطيط) -> { أرجع اختياري.موجود(خطأ_التخطيط); }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
    }
    | عملية_مسير.استخراج_فهرس(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الناتج) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                دع تجميعي: منطقي = تخطيط_تجميعي_ذراع(&تخطيط_الناتج);
                دع سجل_العنوان: متغير معرف_سجل_افتراضي = الوجهة;
                إذا (تجميعي) {
                    دع التالي: طبيعي = *عدد_السجلات;
                    سجل_العنوان := معرف_سجل_افتراضي_من(التالي);
                    *عدد_السجلات := التالي + 1;
                };
                طابق أضف_عنوان_عنصر_تسلسل_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    الاستخراج.المصدر, الاستخراج.الفهرس, &تخطيط_الناتج,
                    سجل_العنوان, التعليمات
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                إذا (تجميعي) {
                    دع حجم_الحجز: طبيعي = حجم_حجز_إطار_ذراع(&تخطيط_الناتج);
                    دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                        الوجهة: الوجهة,
                        الهوية: الناتج.القيمة,
                        الحجم: حجم_الحجز,
                        المحاذاة: تخطيط_الناتج.المحاذاة
                    };
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                        تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(
                            الوجهة, سجل_العنوان, تخطيط_الناتج.الحجم, 0, 0
                        )
                    );
                } وإلا {
                    إذا (!(تخطيط_الناتج.الحجم == 1 || تخطيط_الناتج.الحجم == 2 || تخطيط_الناتج.الحجم == 4 || تخطيط_الناتج.الحجم == 8)) {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, تخطيط_الناتج.الحجم)
                        ));
                    };
                    دع بإشارة: متغير منطقي = خطأ;
                    طابق وصف_عدد_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الناتج) مع
                    | اختياري.موجود(الوصف) -> { بإشارة := الوصف.موقع; }
                    | اختياري.لا_شيء -> { };
                    دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: الوجهة, إزاحة_بايت: 0 };
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
                        الوجهة, العنوان, تخطيط_الناتج.الحجم, بإشارة
                    ));
                };
            };
        };
    }
    | عملية_مسير.مكان_محلي(_) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                دع حجم_الحجز: طبيعي = حجم_حجز_إطار_ذراع(&التخطيط);
                دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                    الوجهة: الوجهة, الهوية: الناتج.القيمة,
                    الحجم: حجم_الحجز, المحاذاة: التخطيط.المحاذاة
                };
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
            };
        };
    }
    | عملية_مسير.مكان_عام(المكان) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            // MSIR global IDs directly index the verified global table.
            // Classify the storage once at selection; do not rescan imports
            // for each machine instruction in the encoder.
            إذا (!عام_مسير_موجود(&(*المسير).المسير, المكان.العام)) {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة());
            };
            دع مستورد: متغير منطقي = خطأ;
            طابق (*المسير).المسير.العوام[المكان.العام.القيمة].الاسم_الخارجي مع
            | اختياري.موجود(_) -> { مستورد := صواب; }
            | اختياري.لا_شيء -> { };
            دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
            ألحق_تعليمة_ذراع_للاختيار(
                التعليمات,
                تعليمة_ذراع_أربعة_وستون.عنوان_عام_ذراع(الوجهة, المكان.العام, مستورد)
            );
        };
    }
    | عملية_مسير.مرجع_إلى_مكان(التحويل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> { ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(
            سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(التحويل.المرجع)
        )); };
    }
    | عملية_مسير.صندوق_إلى_مكان(التحويل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> { ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(
            سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(التحويل.الصندوق)
        )); };
    }
    | عملية_مسير.مكان_حقل(المكان) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المكان.الأصل) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق جزء_تخطيط_عند_ذراع(&التخطيط, المكان.الفهرس) مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(المكان.الأصل, المكان.الفهرس))); }
                | اختياري.موجود(الجزء) -> { ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إزاحة_ذراع(
                    سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(المكان.الأصل), الجزء.الإزاحة
                )); };
            };
        };
    }
    | عملية_مسير.مكان_فهرس(المكان) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                طابق أضف_عنوان_عنصر_تسلسل_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    المكان.الأصل, المكان.الفهرس, &التخطيط, الوجهة, التعليمات
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
        };
    }
    | عملية_مسير.مكان_إلى_مرجع(التحويل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> { ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(
            سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(التحويل.المكان)
        )); };
    }
    | عملية_مسير.بناء_موسوم(البناء) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج, البناء.المنشئ
                    ) مع
                    | نتيجة_تخطيط_منشئ.مكتمل(المنشئ) -> {
                        دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                        دع حجم_الحجز: طبيعي = حجم_حجز_إطار_ذراع(&التخطيط);
                        دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                            الوجهة: الوجهة, الهوية: الناتج.القيمة,
                            الحجم: حجم_الحجز, المحاذاة: التخطيط.المحاذاة
                        };
                        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                        دع وسم: تخزين_فوري_ذراع_أربعة_وستون = {
                            الأساس: الوجهة, الإزاحة: التعداد.الوسم.الإزاحة,
                            الحجم: التعداد.الوسم.الحجم, القيمة: المنشئ.قيمة_الوسم
                        };
                        ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(وسم));
                        دع ف: متغير طبيعي = 0;
                        طالما (ف < (الطول(البناء.الحمولات) مثل طبيعي)) {
                            إذا (ف >= (الطول(المنشئ.الحمولات) مثل طبيعي)) {
                                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                    سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مفقودة(الناتج, ف)
                                ));
                            };
                            دع الجزء: موضع_جزء_تخطيط = المنشئ.الحمولات[ف];
                            طابق أضف_تخزين_قيمة_ذراع(
                                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                                الوجهة, التعداد.مخزن_الحمولة.الإزاحة + الجزء.الإزاحة,
                                البناء.الحمولات[ف], التعليمات
                            ) مع
                            | اختياري.موجود(خطأ_التخطيط) -> { أرجع اختياري.موجود(خطأ_التخطيط); }
                            | اختياري.لا_شيء -> { };
                            ف := ف + 1;
                        }
                    }
                    | نتيجة_تخطيط_منشئ.مؤجل(السبب) -> {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مؤجلة(الناتج, السبب)
                        ));
                    }
                    | نتيجة_تخطيط_منشئ.مرفوض(الخطأ) -> {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مرفوضة(الناتج, الخطأ)
                        ));
                    };
                }
                | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الناتج))); };
            };
        };
    }
    | عملية_مسير.استعلام_وسم(الاستعلام) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الاستعلام.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الاستعلام.المصدر);
                    دع إزاحة_الوسم: عدد = التعداد.الوسم.الإزاحة مثل عدد;
                    دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                        الأساس: سجل_المصدر, إزاحة_بايت: إزاحة_الوسم
                    };
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
                        سجل_لقيمة_مسير(الناتج), العنوان, التعداد.الوسم.الحجم, خطأ
                    ));
                }
                | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الاستعلام.المصدر))); };
            };
        };
    }
    | عملية_مسير.استخراج_حمولة(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الاستخراج.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                        الاستخراج.المصدر, الاستخراج.المنشئ
                    ) مع
                    | نتيجة_تخطيط_منشئ.مكتمل(المنشئ) -> {
                        إذا (الاستخراج.الحمولة >= (الطول(المنشئ.الحمولات) مثل طبيعي)) {
                            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                                سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مفقودة(الاستخراج.المصدر, الاستخراج.الحمولة)
                            ));
                        };
                        دع الجزء: موضع_جزء_تخطيط = المنشئ.الحمولات[الاستخراج.الحمولة];
                        طابق أضف_استخراج_من_عنوان_ذراع(
                            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج,
                            سجل_لقيمة_مسير(الاستخراج.المصدر),
                            التعداد.مخزن_الحمولة.الإزاحة + الجزء.الإزاحة,
                            التعليمات
                        ) مع
                        | اختياري.موجود(خطأ_التخطيط) -> { أرجع اختياري.موجود(خطأ_التخطيط); }
                        | اختياري.لا_شيء -> { };
                    }
                    | نتيجة_تخطيط_منشئ.مؤجل(السبب) -> {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مؤجلة(الاستخراج.المصدر, السبب)
                        ));
                    }
                    | نتيجة_تخطيط_منشئ.مرفوض(الخطأ) -> {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مرفوضة(الاستخراج.المصدر, الخطأ)
                        ));
                    };
                }
                | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(الاستخراج.المصدر))); };
            };
        };
    }
    | عملية_مسير.بناء_إغلاق(البناء) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع عرض_الهدف: عرض_دالة_مسير;
            طابق ابحث_دالة_مسير(المسير, البناء.الدالة) مع
            | نتيجة_بحث_دالة_مسير.مفقودة(_) -> {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(البناء.الدالة));
            }
            | نتيجة_بحث_دالة_مسير.موجودة(الدالة) -> { عرض_الهدف := الدالة; };
            دع خطة_البيئة: تخطيط_بيئة_إغلاق_اختيار;
            طابق خطط_بيئة_إغلاق_للاختيار(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                عرض_الهدف.المعرف, عرض_الهدف.عدد_الالتقاطات
            ) مع
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مؤجل -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(الخطة) -> { خطة_البيئة := الخطة; };
            دع سجل_الناتج: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.تخصيص_صندوق_ذراع(
                    سجل_الناتج, خطة_البيئة.الحجم, خطة_البيئة.المحاذاة
                )
            );
            دع التالي: طبيعي = *عدد_السجلات;
            دع سجل_الدالة: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(التالي);
            *عدد_السجلات := التالي + 1;
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(
                    سجل_الدالة, دالة_منتقاة_من_مسير(البناء.الدالة)
                )
            );
            دع عنوان_الدالة: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                الأساس: سجل_الناتج, إزاحة_بايت: 0
            };
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(
                    سجل_الدالة, عنوان_الدالة, 8
                )
            );
            // The environment header: one reference, and the destructor.
            دع سجل_العداد: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
            دع سجل_المدمر: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات + 1);
            *عدد_السجلات := *عدد_السجلات + 2;
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(سجل_العداد, 1));
            دع عنوان_العداد: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                الأساس: سجل_الناتج, إزاحة_بايت: إزاحة_عداد_بيئة_إغلاق() مثل عدد
            };
            ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(سجل_العداد, عنوان_العداد, 8)
            );
            طابق البناء.المدمر مع
            | اختياري.موجود(المدمر) -> {
                ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                    تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(سجل_المدمر, دالة_منتقاة_من_مسير(المدمر))
                );
                دع عنوان_المدمر: عنوان_ذاكرة_ذراع_أربعة_وستون = {
                    الأساس: سجل_الناتج, إزاحة_بايت: إزاحة_مدمر_بيئة_إغلاق() مثل عدد
                };
                ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                    تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(سجل_المدمر, عنوان_المدمر, 8)
                );
            }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()); };
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(البناء.الالتقاطات) مثل طبيعي)) {
                طابق أضف_تخزين_قيمة_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    سجل_الناتج, خطة_البيئة.إزاحات_الالتقاطات[ف],
                    البناء.الالتقاطات[ف], التعليمات
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
        };
    }
    | عملية_مسير.استخراج_التقاط(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع عرض_الحالية: عرض_دالة_مسير;
            طابق ابحث_دالة_مسير(المسير, الناتج.الدالة) مع
            | نتيجة_بحث_دالة_مسير.مفقودة(_) -> {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(الناتج.الدالة));
            }
            | نتيجة_بحث_دالة_مسير.موجودة(الدالة) -> { عرض_الحالية := الدالة; };
            دع خطة_البيئة: تخطيط_بيئة_إغلاق_اختيار;
            طابق خطط_بيئة_إغلاق_للاختيار(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                عرض_الحالية.المعرف, عرض_الحالية.عدد_الالتقاطات
            ) مع
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مؤجل -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(الخطة) -> { خطة_البيئة := الخطة; };
            إذا (الاستخراج.الفهرس >= (الطول(خطة_البيئة.إزاحات_الالتقاطات) مثل طبيعي)) {
                أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة());
            };
            دع التالي: طبيعي = *عدد_السجلات;
            دع سجل_البيئة: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(التالي);
            *عدد_السجلات := التالي + 1;
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.بيئة_إغلاق_ذراع(سجل_البيئة));
            طابق أضف_استخراج_من_عنوان_ذراع(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                الناتج, سجل_البيئة, خطة_البيئة.إزاحات_الالتقاطات[الاستخراج.الفهرس],
                التعليمات
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | عملية_مسير.بناء_صندوق(البناء) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, البناء.القيمة
            ) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط));
            }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                    تعليمة_ذراع_أربعة_وستون.تخصيص_صندوق_ذراع(
                        سجل_الناتج, التخطيط.الحجم, التخطيط.المحاذاة
                    )
                );
                طابق أضف_تخزين_قيمة_ذراع(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    سجل_الناتج, 0, البناء.القيمة, التعليمات
                ) مع
                | اختياري.موجود(خطأ_التخطيط) -> { أرجع اختياري.موجود(خطأ_التخطيط); }
                | اختياري.لا_شيء -> { };
            };
        };
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق وصف_عدد_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الحساب.اليسار) مع
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); }
            | اختياري.موجود(الوصف) -> {
                // Division and remainder by a constant: UMULH/SMULH, never
                // UDIV/SDIV (backend/codegen/division_by_constant.sn).
                دع قسمة_ثابتة: متغير منطقي = خطأ;
                دع باقي_القسمة: متغير منطقي = خطأ;
                طابق الحساب.العملية مع
                | عملية_حساب_صحيح.قسمة_طبيعية -> { قسمة_ثابتة := صواب; }
                | عملية_حساب_صحيح.قسمة_موقعة -> { قسمة_ثابتة := صواب; }
                | عملية_حساب_صحيح.باقي_طبيعي -> { قسمة_ثابتة := صواب; باقي_القسمة := صواب; }
                | عملية_حساب_صحيح.باقي_موقع -> { قسمة_ثابتة := صواب; باقي_القسمة := صواب; }
                | _ -> { };
                إذا (قسمة_ثابتة) {
                    طابق ثابت_صحيح_لقيمة_مسير(المسير, الحساب.اليمين) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(الثابت) -> {
                        دع واحد: طبيعي = 1;
                        دع القاسم: متغير طبيعي = الثابت;
                        إذا (الوصف.البتات < 64) {
                            دع القناع: طبيعي = (واحد << الوصف.البتات) - 1;
                            القاسم := الثابت & القناع;
                            إذا (الوصف.موقع && ((القاسم >> (الوصف.البتات - 1)) & 1) != 0) { القاسم := القاسم | ~القناع; };
                        };
                        إذا (قسمة_على_ثابت_مدعومة(القاسم, الوصف.موقع)) {
                            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.قسمة_على_ثابت_ذراع(
                                سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(الحساب.اليسار),
                                القاسم, الوصف.البتات, الوصف.موقع, باقي_القسمة
                            ));
                            أرجع اختياري.لا_شيء();
                        };
                    };
                };
                دع العملية_المختارة: عملية_حساب_ذراع_أربعة_وستون = عملية_حساب_ذراع_من_مسير(الحساب.العملية);
                دع سجل_الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                دع سجل_اليسار: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الحساب.اليسار);
                دع سجل_اليمين: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الحساب.اليمين);
                دع المختار: حساب_صحيح_ذراع_أربعة_وستون = {
                    العملية: العملية_المختارة,
                    الوجهة: سجل_الوجهة,
                    اليسار: سجل_اليسار,
                    اليمين: سجل_اليمين,
                    الوصف: الوصف
                };
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(المختار));
            };
        };
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع من_بتات: طبيعي;
            طابق بتات_طرف_تحويل_عائم_ذراع(المسير, حقائق_الخلفية, التحويل.المصدر) مع
            | اختياري.موجود(ب) -> { من_بتات := ب; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); };
            دع إلى_بتات: طبيعي;
            طابق بتات_طرف_تحويل_عائم_ذراع(المسير, حقائق_الخلفية, الناتج) مع
            | اختياري.موجود(ب) -> { إلى_بتات := ب; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); };
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تحويل_عائم_ذراع(
                تحويل_عائم_ذراع_من_مسير(التحويل.العملية), سجل_لقيمة_مسير(الناتج),
                سجل_لقيمة_مسير(التحويل.المصدر), من_بتات, إلى_بتات
            ));
        };
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع البتات: متغير طبيعي = 0;
            طابق بتات_قيمة_عائمة_ذراع(المسير, حقائق_الخلفية, الحساب.اليسار) مع
            | اختياري.موجود(ب) -> { البتات := ب; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.حساب_غير_مدعوم()); };
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.حساب_عشري_ذراع(
                حساب_عشري_ذراع_من_مسير(الحساب.العملية), سجل_لقيمة_مسير(الناتج),
                سجل_لقيمة_مسير(الحساب.اليسار), سجل_لقيمة_مسير(الحساب.اليمين), البتات
            ));
        };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع البتات: متغير طبيعي = 0;
            طابق بتات_قيمة_عائمة_ذراع(المسير, حقائق_الخلفية, المقارنة.اليسار) مع
            | اختياري.موجود(ب) -> { البتات := ب; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة()); };
            ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مقارنة_عشرية_إلى_منطق_ذراع(
                مقارنة_عشرية_ذراع_من_مسير(المقارنة.العملية), سجل_لقيمة_مسير(الناتج),
                سجل_لقيمة_مسير(المقارنة.اليسار), سجل_لقيمة_مسير(المقارنة.اليمين), البتات
            ));
        };
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختياري.موجود(الناتج) -> {
            طابق صنف_إشارة_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, المقارنة.اليسار) مع
            | اختياري.لا_شيء -> {
                // Pointer equality uses unsigned register identity; Type
                // and allowed predicates were checked by the MSIR verifier.
                دع النوع_المدخل: معرف_نوع;
                طابق نوع_قيمة_مسير(المسير, المقارنة.اليسار) مع
                | اختياري.موجود(ن) -> { النوع_المدخل := ن; }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); };
                طابق وصف_شكل_نوع_دلالي_عند(&(*حقائق_الخلفية).الأنواع, النوع_المدخل) مع
                | اختياري.موجود(الشكل) -> {
                    طابق الشكل.الصنف مع
                    | صنف_شكل_نوع_دلالي.مؤشر -> { }
                    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); };
                }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح()); };
                دع المحمول: محمول_مقارنة_منتقى = محمول_مقارنة_من_مسير(المقارنة.العملية, صنف_إشارة_عدد_خلفية.طبيعي());
                دع الشرط: شرط_ذراع_أربعة_وستون = شرط_ذراع_من_محمول(المحمول);
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(
                    سجل_لقيمة_مسير(المقارنة.اليسار), سجل_لقيمة_مسير(المقارنة.اليمين)));
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(
                    سجل_لقيمة_مسير(الناتج), الشرط));
            }
            | اختياري.موجود(الإشارة) -> {
                دع المحمول: محمول_مقارنة_منتقى = محمول_مقارنة_من_مسير(المقارنة.العملية, الإشارة);
                دع الشرط: شرط_ذراع_أربعة_وستون = شرط_ذراع_من_محمول(المحمول);
                دع اليسار: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المقارنة.اليسار);
                دع سجل_اليمين: معرف_سجل_افتراضي = سجل_لقيمة_مسير(المقارنة.اليمين);
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(اليسار, سجل_اليمين));
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(سجل_لقيمة_مسير(الناتج), الشرط));
            };
        };
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(الموضع) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_عنصر_ذراع(
                    سجل_لقيمة_مسير(الناتج), سجل_لقيمة_مسير(الموضع.المؤشر),
                    سجل_لقيمة_مسير(الموضع.الفهرس), التخطيط.الحجم
                ));
            };
        };
    }
    | عملية_مسير.تحميل(التحميل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_ذراع(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_ذراع(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع الوجهة: معرف_سجل_افتراضي = سجل_لقيمة_مسير(الناتج);
                // A load only read by the next length call (a bounds check)
                // stands for the place itself (msir_analysis.sn).
                دع للطول_فقط: منطقي = (الناتج.القيمة مثل طبيعي) < (الطول(*قراءات_الطول) مثل طبيعي) && (*قراءات_الطول)[الناتج.القيمة];
                إذا (تخطيط_تجميعي_ذراع(&التخطيط) && للطول_فقط) {
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(الوجهة, سجل_لقيمة_مسير(التحميل.المكان)));
                } وإلا إذا (تخطيط_تجميعي_ذراع(&التخطيط)) {
                    دع حجم_الحجز: طبيعي = حجم_حجز_إطار_ذراع(&التخطيط);
                    دع الحجز: حجز_إطار_ذراع_أربعة_وستون = {
                        الوجهة: الوجهة, الهوية: الناتج.القيمة,
                        الحجم: حجم_الحجز, المحاذاة: التخطيط.المحاذاة
                    };
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز));
                    دع سجل_المكان: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التحميل.المكان);
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات,
                        تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(
                            الوجهة, سجل_المكان, التخطيط.الحجم, 0, 0
                        )
                    );
                } وإلا {
                    إذا (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
                        أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                            سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(الناتج, التخطيط.الحجم)
                        ));
                    };
                    دع بإشارة: متغير منطقي = خطأ;
                    طابق وصف_عدد_لقيمة_مسير_ذراع(المسير, حقائق_الخلفية, الناتج) مع
                    | اختياري.موجود(الوصف) -> { بإشارة := الوصف.موقع; }
                    | اختياري.لا_شيء -> { };
                    دع سجل_المكان: معرف_سجل_افتراضي = سجل_لقيمة_مسير(التحميل.المكان);
                    دع العنوان: عنوان_ذاكرة_ذراع_أربعة_وستون = { الأساس: سجل_المكان, إزاحة_بايت: 0 };
                    ألحق_تعليمة_ذراع_للاختيار(التعليمات, تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(
                        الوجهة, العنوان, التخطيط.الحجم, بإشارة
                    ));
                };
            };
        };
    }
    | عملية_مسير.تخزين(التخزين) -> {
