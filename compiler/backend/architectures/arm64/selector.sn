                    أرجع اختياري.موجود(خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(
                        سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(التخزين.القيمة, التخطيط.الحجم)
                    ));
