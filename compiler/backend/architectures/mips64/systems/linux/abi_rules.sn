استورد compiler.backend.abi.abi_model;
استورد compiler.backend.abi.aggregate_leaves;
استورد compiler.backend.abi.foreign_plan;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.target.target_model;

// MIPS64 n64 ABI ("MIPSpro N32/N64 ABI Handbook"; GCC/Clang mips64 n64) for
// foreign (C) calls on mips64el Linux. Clang reference: MipsABIInfo for N64.
// - Integers narrower than 64 bits are extended by signedness, except that a
//   32-bit unsigned integer is sign-extended like every 32-bit value.
// - A structure is passed as a sequence of doublewords in successive argument
//   registers (continuing on the stack); a doubleword that is exactly one
//   double member at a doubleword boundary travels in the matching FPR,
//   every other doubleword (including floats) in a GPR.
// - A result structure of at most 16 bytes whose one or two members are all
//   floats returns in $f0/$f2; another of at most 16 bytes in $2/$3; a larger
//   one through memory whose address the caller passes.
// Unsupported: variadic calls (none declared).

// Doublewords of a structure: double-typed when one double fills it.
عرف أشكال_كلمات_ميبس_أربعة_وستون(الوصف: &وصف_قيمة_خارجية): متجه شكل_جزء_واجهة {
    دع الأشكال: متغير متجه شكل_جزء_واجهة = [];
    دع العدد: غير_موقع = ((*الوصف).الحجم + 7) / 8;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < العدد) {
        دع البداية: غير_موقع = ك * 8;
        دع مضاعف: متغير منطقي = خطأ;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول((*الوصف).الأوراق) مثل غير_موقع)) {
            دع الورقة: ورقة_تجميع_واجهة = (*الوصف).الأوراق[ف];
            لو (الورقة.عائم && الورقة.الحجم == 8 && الورقة.الإزاحة == البداية) { مضاعف := صواب; };
            ف := ف + 1;
        }
        لو (مضاعف) {
            ألحق(الأشكال, شكل_جزء_واجهة_جديد(البداية, 8, فئة_سجل_واجهة.عائم_متجه()));
        } وإلا {
            دع الحجم: متغير غير_موقع = 8;
            لو ((*الوصف).الحجم - البداية < 8) { الحجم := (*الوصف).الحجم - البداية; };
            ألحق(الأشكال, شكل_جزء_واجهة_جديد(البداية, الحجم, فئة_سجل_واجهة.عدد_صحيح()));
        };
        ك := ك + 1;
    }
    أرجع الأشكال;
}

عرف صنف_قيمة_ميبس_أربعة_وستون(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    ناتج: منطقي
): نتيجة قيمة_مصنفة_واجهة, خطأ_واجهة {
    دع الوصف: وصف_قيمة_خارجية;
    طابق صف_قيمة_خارجية(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الوصف := القيمة; };
    لو (الوصف.فارغة) { أرجع نتيجة.نجح(قيمة_متجاهلة_خارجية()); };
    لو (!الوصف.بنية) {
        أرجع نتيجة.نجح(قيمة_سلمية_خارجية(
            &الوصف, توسيع_عدد_ضيق_واجهة(الأنواع, النوع, 64, 32)
        ));
    };
    لو (!ناتج) {
        أرجع نتيجة.نجح(قيمة_أجزاء_خارجية(&الوصف, أشكال_كلمات_ميبس_أربعة_وستون(&الوصف), خطأ));
    };
    لو (الوصف.الحجم > 16) { أرجع نتيجة.نجح(قيمة_غير_مباشرة_خارجية(&الوصف)); };
    دع عدد_الأوراق: غير_موقع = الطول(الوصف.الأوراق) مثل غير_موقع;
    دع كلها_عائمة: متغير منطقي = عدد_الأوراق >= 1 && عدد_الأوراق <= 2;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الأوراق) {
        لو (!الوصف.الأوراق[ف].عائم) { كلها_عائمة := خطأ; };
        ف := ف + 1;
    }
    لو (كلها_عائمة) {
        دع الأشكال: متغير متجه شكل_جزء_واجهة = [];
        ف := 0;
        بينما (ف < عدد_الأوراق) {
            ألحق(الأشكال, شكل_جزء_واجهة_جديد(
                الوصف.الأوراق[ف].الإزاحة, الوصف.الأوراق[ف].الحجم, فئة_سجل_واجهة.عائم_متجه()
            ));
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(قيمة_أجزاء_خارجية(&الوصف, الأشكال, خطأ));
    };
    دع العدد: غير_موقع = (الوصف.الحجم + 7) / 8;
    أرجع نتيجة.نجح(قيمة_أجزاء_خارجية(
        &الوصف,
        أشكال_أجزاء_منتظمة_واجهة(الوصف.الحجم, 8, العدد, فئة_سجل_واجهة.عدد_صحيح()),
        خطأ
    ));
}

عام عرف صنف_واجهة_ميبس_أربعة_وستون_خارجية(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع القيم: متغير متجه قيمة_مصنفة_واجهة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المعاملات) مثل غير_موقع)) {
        طابق صنف_قيمة_ميبس_أربعة_وستون(الأنواع, الهدف, سجل_التخطيط, (*المعاملات)[ف], خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(القيم, القيمة); };
        ف := ف + 1;
    }
    دع قيمة_الناتج: قيمة_مصنفة_واجهة;
    طابق صنف_قيمة_ميبس_أربعة_وستون(الأنواع, الهدف, سجل_التخطيط, الناتج, صواب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { قيمة_الناتج := القيمة; };
    أرجع نتيجة.نجح(ابن_خطة_واجهة_خارجية(المعاملات, &القيم, الناتج, &قيمة_الناتج, 8, 16));
}
