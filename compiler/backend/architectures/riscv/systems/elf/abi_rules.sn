استورد compiler.backend.abi.abi_model;
استورد compiler.backend.abi.aggregate_leaves;
استورد compiler.backend.abi.foreign_plan;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.target.target_model;

// RISC-V ELF psABI integer and hardware floating-point calling conventions
// ("RISC-V ELF psABI", riscv-non-isa/riscv-elf-psabi-doc, Procedure Calling
// Convention) for calls to foreign (C) functions. Clang reference:
// RISCVABIInfo. The LoongArch ELF psABI defines its base calling convention
// by the same rules with GRLEN/FRLEN (Clang LoongArchABIInfo), so it uses
// this classifier with its own parameters (loongarch/systems/linux).
//
// Parameters: XLEN and FLEN in bytes (FLEN 0 for a soft-float ABI such as
// ilp32), eight argument registers of each class.
// - Integer scalars narrower than XLEN are extended by signedness; on 64-bit
//   ABIs a 32-bit unsigned integer is sign-extended.
// - A float scalar no wider than FLEN uses an FPR while one is free, else the
//   integer convention; the code generator applies that from the IR type.
// - A structure that flattens to one float, two floats, or one float and one
//   integer (each float ≤ FLEN, the integer ≤ XLEN) is passed as those fields
//   in FPRs/GPRs when enough remain for all of them (hardware FP convention).
// - Otherwise a structure of at most XLEN bytes uses one GPR, of at most
//   2×XLEN bytes two GPRs (a pair may straddle the last GPR and the stack),
//   and a larger one is passed by address of a caller-made copy.
// - Results use the same rules with two registers of each class; a larger
//   structure returns through memory whose address the caller passes in a0.
// Unsupported: variadic calls (none declared).

عام نوع معاملات_واجهة_رايسك_في = {
    // XLEN/GRLEN and FLEN/FRLEN in bytes.
    عرض_الصحيح: غير_موقع,
    عرض_العائم: غير_موقع
};

نوع حالة_سجلات_رايسك_في = {
    الصحيحة_المتبقية: غير_موقع,
    العائمة_المتبقية: غير_موقع
};

عرف توسيع_رايسك_في(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المعاملات: &معاملات_واجهة_رايسك_في
): توسيع_عدد_واجهة {
    دع حد_البتات: غير_موقع = (*المعاملات).عرض_الصحيح * 8;
    دع إشاري_للعرض: متغير غير_موقع = 0;
    لو ((*المعاملات).عرض_الصحيح == 8) { إشاري_للعرض := 32; };
    أرجع توسيع_عدد_ضيق_واجهة(الأنواع, النوع, حد_البتات, إشاري_للعرض);
}

// Flattened fields for the hardware FP convention, or none when the
// structure does not qualify. Counts the FPRs and GPRs it needs.
عرف أشكال_تسطيح_عائم_رايسك_في(
    الوصف: &وصف_قيمة_خارجية,
    المعاملات: &معاملات_واجهة_رايسك_في,
    عائمة_مطلوبة: &متغير غير_موقع,
    صحيحة_مطلوبة: &متغير غير_موقع
): اختيار متجه شكل_جزء_واجهة {
    دع الأوراق: &متجه ورقة_تجميع_واجهة = &(*الوصف).الأوراق;
    دع العدد: غير_موقع = الطول(*الأوراق) مثل غير_موقع;
    لو ((*المعاملات).عرض_العائم == 0 || العدد == 0 || العدد > 2) { أرجع اختيار.لا_شيء(); };
    دع الأشكال: متغير متجه شكل_جزء_واجهة = [];
    دع عائمة: متغير غير_موقع = 0;
    دع صحيحة: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع الورقة: ورقة_تجميع_واجهة = (*الأوراق)[ف];
        لو (الورقة.عائم) {
            لو (الورقة.الحجم > (*المعاملات).عرض_العائم) { أرجع اختيار.لا_شيء(); };
            عائمة := عائمة + 1;
            ألحق(الأشكال, شكل_جزء_واجهة_جديد(الورقة.الإزاحة, الورقة.الحجم, فئة_سجل_واجهة.عائم_متجه()));
        } وإلا {
            لو (الورقة.الحجم > (*المعاملات).عرض_الصحيح) { أرجع اختيار.لا_شيء(); };
            صحيحة := صحيحة + 1;
            ألحق(الأشكال, شكل_جزء_واجهة_جديد(الورقة.الإزاحة, الورقة.الحجم, فئة_سجل_واجهة.عدد_صحيح()));
        };
        ف := ف + 1;
    }
    // One float, two floats, or one float with one integer.
    لو (عائمة == 0 || صحيحة > 1) { أرجع اختيار.لا_شيء(); };
    *عائمة_مطلوبة := عائمة;
    *صحيحة_مطلوبة := صحيحة;
    أرجع اختيار.بعض(الأشكال);
}

عرف صنف_قيمة_رايسك_في(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    المعاملات: &معاملات_واجهة_رايسك_في,
    الحالة: &متغير حالة_سجلات_رايسك_في
): نتيجة قيمة_مصنفة_واجهة, خطأ_واجهة {
    دع الوصف: وصف_قيمة_خارجية;
    طابق صف_قيمة_خارجية(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الوصف := القيمة; };
    لو (الوصف.فارغة) { أرجع نتيجة.نجح(قيمة_متجاهلة_خارجية()); };
    دع ع: غير_موقع = (*المعاملات).عرض_الصحيح;
    لو (!الوصف.بنية) {
        لو (الوصف.عائم && الوصف.الحجم <= (*المعاملات).عرض_العائم
            && (*الحالة).العائمة_المتبقية > 0) {
            (*الحالة).العائمة_المتبقية := (*الحالة).العائمة_المتبقية - 1;
        } وإلا {
            دع مطلوبة: متغير غير_موقع = 1;
            لو (الوصف.الحجم > ع) { مطلوبة := 2; };
            لو (مطلوبة > (*الحالة).الصحيحة_المتبقية) { مطلوبة := (*الحالة).الصحيحة_المتبقية; };
            (*الحالة).الصحيحة_المتبقية := (*الحالة).الصحيحة_المتبقية - مطلوبة;
        };
        لو (الوصف.عائم) {
            أرجع نتيجة.نجح(قيمة_سلمية_خارجية(&الوصف, توسيع_عدد_واجهة.بلا_توسيع()));
        };
        أرجع نتيجة.نجح(قيمة_سلمية_خارجية(&الوصف, توسيع_رايسك_في(الأنواع, النوع, المعاملات)));
    };
    دع عائمة_مطلوبة: متغير غير_موقع = 0;
    دع صحيحة_مطلوبة: متغير غير_موقع = 0;
    طابق أشكال_تسطيح_عائم_رايسك_في(
        &الوصف, المعاملات, &متغير عائمة_مطلوبة, &متغير صحيحة_مطلوبة
    ) مع
    | اختيار.بعض(الأشكال) -> {
        لو (عائمة_مطلوبة <= (*الحالة).العائمة_المتبقية
            && صحيحة_مطلوبة <= (*الحالة).الصحيحة_المتبقية) {
            (*الحالة).العائمة_المتبقية := (*الحالة).العائمة_المتبقية - عائمة_مطلوبة;
            (*الحالة).الصحيحة_المتبقية := (*الحالة).الصحيحة_المتبقية - صحيحة_مطلوبة;
            أرجع نتيجة.نجح(قيمة_أجزاء_خارجية(&الوصف, الأشكال, خطأ));
        };
    }
    | اختيار.لا_شيء -> { };
    لو (الوصف.الحجم <= 2 * ع) {
        دع العدد: متغير غير_موقع = 1;
        لو (الوصف.الحجم > ع) { العدد := 2; };
        دع مستهلكة: متغير غير_موقع = العدد;
        لو (مستهلكة > (*الحالة).الصحيحة_المتبقية) { مستهلكة := (*الحالة).الصحيحة_المتبقية; };
        (*الحالة).الصحيحة_المتبقية := (*الحالة).الصحيحة_المتبقية - مستهلكة;
        أرجع نتيجة.نجح(قيمة_أجزاء_خارجية(
            &الوصف,
            أشكال_أجزاء_منتظمة_واجهة(الوصف.الحجم, ع, العدد, فئة_سجل_واجهة.عدد_صحيح()),
            خطأ
        ));
    };
    لو ((*الحالة).الصحيحة_المتبقية > 0) {
        (*الحالة).الصحيحة_المتبقية := (*الحالة).الصحيحة_المتبقية - 1;
    };
    أرجع نتيجة.نجح(قيمة_غير_مباشرة_خارجية(&الوصف));
}

عام عرف صنف_واجهة_رايسك_في_خارجية_بمعاملات(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع,
    معاملات_الواجهة: &معاملات_واجهة_رايسك_في
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    // The result is classified with two registers of each class.
    دع عائمة_الناتج: متغير غير_موقع = 0;
    لو ((*معاملات_الواجهة).عرض_العائم > 0) { عائمة_الناتج := 2; };
    دع حالة_الناتج: متغير حالة_سجلات_رايسك_في = {
        الصحيحة_المتبقية: 2, العائمة_المتبقية: عائمة_الناتج
    };
    دع قيمة_الناتج: قيمة_مصنفة_واجهة;
    طابق صنف_قيمة_رايسك_في(
        الأنواع, الهدف, سجل_التخطيط, الناتج, معاملات_الواجهة, &متغير حالة_الناتج
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { قيمة_الناتج := القيمة; };
    دع عائمة_المعاملات: متغير غير_موقع = 0;
    لو ((*معاملات_الواجهة).عرض_العائم > 0) { عائمة_المعاملات := 8; };
    دع الحالة: متغير حالة_سجلات_رايسك_في = {
        الصحيحة_المتبقية: 8, العائمة_المتبقية: عائمة_المعاملات
    };
    // The hidden result address occupies a0.
    لو (قيمة_الناتج.التصنيف.الطريقة == طريقة_تمرير_واجهة.غير_مباشر()) {
        الحالة.الصحيحة_المتبقية := 7;
    };
    دع القيم: متغير متجه قيمة_مصنفة_واجهة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المعاملات) مثل غير_موقع)) {
        طابق صنف_قيمة_رايسك_في(
            الأنواع, الهدف, سجل_التخطيط, (*المعاملات)[ف], معاملات_الواجهة, &متغير الحالة
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(القيم, القيمة); };
        ف := ف + 1;
    }
    دع محاذاة_المكدس: غير_موقع = 16;
    أرجع نتيجة.نجح(ابن_خطة_واجهة_خارجية(
        المعاملات, &القيم, الناتج, &قيمة_الناتج, (*معاملات_الواجهة).عرض_الصحيح, محاذاة_المكدس
    ));
}

// RISC-V targets: XLEN from the pointer width; FLEN from the target's
// registered floating-point ABI (lp64d on 64-bit Linux and FreeBSD; the
// soft-float ilp32 on the bare-metal 32-bit target).
عام عرف صنف_واجهة_رايسك_في_خارجية(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع عرض_الصحيح: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
    دع عرض_العائم: متغير غير_موقع = 0;
    لو (عرض_الصحيح == 8) { عرض_العائم := 8; };
    دع معاملات_الواجهة: معاملات_واجهة_رايسك_في = {
        عرض_الصحيح: عرض_الصحيح, عرض_العائم: عرض_العائم
    };
    أرجع صنف_واجهة_رايسك_في_خارجية_بمعاملات(
        الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج, &معاملات_الواجهة
    );
}
