استورد compiler.backend.abi.abi_model;
استورد compiler.backend.abi.aggregate_leaves;
استورد compiler.backend.abi.foreign_plan;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.target.target_model;

// s390x ELF ABI ("ELF Application Binary Interface s390x Supplement",
// parameter passing) for foreign (C) calls on SystemZ Linux. Clang
// reference: SystemZABIInfo.
// - Integers narrower than 64 bits are extended by signedness; floats use
//   FPRs.
// - A structure whose only member is a float or double is passed as that
//   float; a structure of 1, 2, 4 or 8 bytes as an integer of its size in a
//   GPR (big-endian: right-justified, as an integer load gives); any other
//   structure by address of a caller-made copy.
// - Every structure result returns through memory whose address the caller
//   passes in r2.
// Unsupported: variadic calls (none declared) and vector types (none).

عرف صنف_قيمة_سيستم_زد(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    ناتج: منطقي
): نتيجة قيمة_مصنفة_واجهة, خطأ_واجهة {
    دع الوصف: وصف_قيمة_خارجية;
    طابق صف_قيمة_خارجية(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الوصف := القيمة; };
    لو (الوصف.فارغة) { أرجع نتيجة.نجح(قيمة_متجاهلة_خارجية()); };
    لو (!الوصف.بنية) {
        أرجع نتيجة.نجح(قيمة_سلمية_خارجية(
            &الوصف, توسيع_عدد_ضيق_واجهة(الأنواع, النوع, 64, 0)
        ));
    };
    لو (ناتج) { أرجع نتيجة.نجح(قيمة_غير_مباشرة_خارجية(&الوصف)); };
    لو ((الطول(الوصف.الأوراق) مثل غير_موقع) == 1 && الوصف.الأوراق[0].عائم
        && الوصف.الأوراق[0].الإزاحة == 0 && الوصف.الأوراق[0].الحجم == الوصف.الحجم) {
        دع الأشكال: متغير متجه شكل_جزء_واجهة = [];
        ألحق(الأشكال, شكل_جزء_واجهة_جديد(0, الوصف.الحجم, فئة_سجل_واجهة.عائم_متجه()));
        أرجع نتيجة.نجح(قيمة_أجزاء_خارجية(&الوصف, الأشكال, خطأ));
    };
    لو (الوصف.الحجم == 1 || الوصف.الحجم == 2 || الوصف.الحجم == 4 || الوصف.الحجم == 8) {
        أرجع نتيجة.نجح(قيمة_صحيحة_واحدة_خارجية(&الوصف));
    };
    أرجع نتيجة.نجح(قيمة_غير_مباشرة_خارجية(&الوصف));
}

عام عرف صنف_واجهة_سيستم_زد_خارجية(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع القيم: متغير متجه قيمة_مصنفة_واجهة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المعاملات) مثل غير_موقع)) {
        طابق صنف_قيمة_سيستم_زد(الأنواع, الهدف, سجل_التخطيط, (*المعاملات)[ف], خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(القيم, القيمة); };
        ف := ف + 1;
    }
    دع قيمة_الناتج: قيمة_مصنفة_واجهة;
    طابق صنف_قيمة_سيستم_زد(الأنواع, الهدف, سجل_التخطيط, الناتج, صواب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { قيمة_الناتج := القيمة; };
    أرجع نتيجة.نجح(ابن_خطة_واجهة_خارجية(المعاملات, &القيم, الناتج, &قيمة_الناتج, 8, 8));
}
