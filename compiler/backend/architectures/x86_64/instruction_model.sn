استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.selection_contract;
استورد compiler.backend.abi.abi_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.msir.identifiers;

// أساس x86_64 يبقى ISA مستقلا. ستضاف قيود two-address وFLAGS وModRM/SIB عند تنفيذ منتقيه.
عام نوع شرط_إكس_ستة_وثمانون_أربعة_وستون =
    | تكافؤ
    | لاتكافؤ
    | أقل_بإشارة
    | أقل_بإشارة_أو_مساو
    | أكبر_بإشارة
    | أكبر_بإشارة_أو_مساو
    | أدنى_طبيعي
    | أدنى_طبيعي_أو_مساو
    | أعلى_طبيعي
    | أعلى_طبيعي_أو_مساو
;

عام نوع عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
    الأساس: اختياري معرف_سجل_افتراضي,
    الفهرس: اختياري معرف_سجل_افتراضي,
    المقياس: طبيعي,
    الإزاحة: عدد
};

عام نوع قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
    السجل: معرف_سجل_افتراضي,
    المواضع: متجه موضع_جزء_واجهة,
    الحجم: طبيعي,
    تجميعي: منطقي,
    غير_مباشر: منطقي
};

عام نوع ناتج_عودة_إكس_ستة_وثمانون_أربعة_وستون_منتقى = {
    القيمة: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    عنوان_ناتج_غير_مباشر: اختياري معرف_سجل_افتراضي
};


// جميع عمليات الحساب الصحيحة المقننة تحمل عرضها وإشارتها إلى طبقة الترميز.
عام نوع حساب_صحيح_إكس_كامل =
    | جمع
    | طرح
    | ضرب
    | قسمة_موقعة
    | قسمة_طبيعية
    | باقي_موقع
    | باقي_طبيعي
    | أو_بتي
    | أو_حصري
    | و_بتي
    | إزاحة_يسرى
    | إزاحة_يمنى
    | إزاحة_حسابية_يمنى
    // Wrapping forms: the same instruction without the overflow trap.
    | جمع_ملتف
    | طرح_ملتف
    | ضرب_ملتف
    | إزاحة_يسرى_ملتفة
;

عام نوع تحويل_صحيح_إكس_كامل =
    | توسيع_بإشارة
    | توسيع_صفري
    | اقتطاع
    | إعادة_تفسير
;

// Float conversions (MSIR تحويل_عائم): the integer side's signedness is in
// the operation, its width in the instruction.
عام نوع تحويل_عائم_إكس_كامل =
    | عائم_إلى_موقع
    | عائم_إلى_طبيعي
    | موقع_إلى_عائم
    | طبيعي_إلى_عائم
    | عائم_إلى_عائم
;

// Atomic read-modify-write on a memory word (thread support): XCHG and
// LOCK XADD directly, AND/OR/XOR as a LOCK CMPXCHG loop.
عام نوع عملية_ذرية_إكس =
    | تبديل
    | جلب_جمع
    | جلب_و
    | جلب_أو
    | جلب_أو_حصري
;

عام نوع حساب_عشري_إكس_كامل =
    | جمع
    | طرح
    | ضرب
    | قسمة
    // The float primitives (عملية_عائمة_بدائية) baseline x86-64 (SSE2) has:
    // SQRTSD/SQRTSS, and abs, copysign, IEEE minimum and maximum spelled with
    // SSE2 bit operations. The unary ones take their operand twice.
    | جذر_تربيعي
    | قيمة_مطلقة
    | نسخ_إشارة
    | أدنى
    | أقصى
;

عام نوع مقارنة_عشرية_إكس_كاملة =
    | يساوي
    | لا_يساوي
    | أصغر
    | أصغر_أو_يساوي
    | أكبر
    | أكبر_أو_يساوي
;

// التخزين المركب يظل تمثيلا ماديا خلفيا: السجل يحمل عنوان القيمة المخزنة.
عام نوع طلب_موضع_محلي_إكس = {
    المعرف: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي
};

// ثابت النص يهيئ مخزن النص المحلي من خلال مرفق التخصيص الذي يملكه Target.
// append يحتاج عنوان رأس المتجه نفسه وحقائق Layout المخفية، مثل ARM64.
// x86 يملك خفض الآلة فقط؛ سياسة النمو تأتي من Runtime والربط من Target.
عام نوع إلحاق_متجه_إكس_ستة_وثمانون_أربعة_وستون = {
    المتجه: معرف_سجل_افتراضي,
    العنصر: معرف_سجل_افتراضي,
    إزاحة_البيانات: طبيعي,
    إزاحة_الطول: طبيعي,
    إزاحة_السعة: طبيعي,
    حجم_الطول: طبيعي,
    حجم_السعة: طبيعي,
    حجم_العنصر: طبيعي,
    العنصر_تجميعي: منطقي,
    السعة_الدنيا: طبيعي,
    عامل_النمو: طبيعي,
    // Reserve (حجز_سعة_متجه) instead of append: العنصر holds the additional
    // element count, and the buffer grows to exactly length + additional.
    الحجز: منطقي
};

عام نوع ثابت_نص_إكس_ستة_وثمانون_أربعة_وستون = {
    الهوية: طبيعي,
    البايتات: متجه ط8,
    إزاحة_البيانات: طبيعي,
    إزاحة_الطول: طبيعي,
    إزاحة_السعة: طبيعي
};

عام عرف انسخ_بايتات_ثابت_نص_إكس(المصدر: &متجه ط8): متجه ط8 {
    دع م: متجه ط8 = *المصدر;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(م) مثل طبيعي)) {
        ألحق(الناتج, م[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام نوع هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون =
    | دالة بنوع معرف_دالة_منتقاة
    | دالة_خارجية بنوع معرف_دالة_خارجية_منتقاة
    | بدائي_تشغيل بنوع هوية_بدائي_مترجم
    | نداء_نواة
    | قيمة_دالة بنوع معرف_سجل_افتراضي
    // The C function at the address the register holds (بدائي_نداء_عنوان_سي).
    | عنوان_سي بنوع معرف_سجل_افتراضي
;

عام عرف انسخ_هدف_نداء_إكس(الهدف: &هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون): هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون {
    طابق *الهدف مع
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة(الدالة) -> { أرجع هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة(الدالة); }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة_خارجية(المعرف) -> { أرجع هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة_خارجية(المعرف); }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.نداء_نواة -> { أرجع هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.نداء_نواة(); }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.بدائي_تشغيل(البدائي) -> { أرجع هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.بدائي_تشغيل(البدائي); }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.قيمة_دالة(السجل) -> { أرجع هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.قيمة_دالة(السجل); }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.عنوان_سي(السجل) -> { أرجع هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.عنوان_سي(السجل); };
}

عام نوع نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = {
    الهدف: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    الحجج: متجه قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الناتج: اختياري قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة
};

// ADD/SUB الديناميكيان يجب أن يحافظا على عقد MSIR الذي يفخ عند تجاوز العرض.
عام نوع صنف_فخ_تجاوز_إكس_ستة_وثمانون_أربعة_وستون =
    | موقع
    | طبيعي
;

عام نوع تعليمة_إكس_ستة_وثمانون_أربعة_وستون =
    | استلام_معامل_إكس بنوع قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة
    | نقل_سجل_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي)
    | نقل_فوري_إكس بنوع (معرف_سجل_افتراضي, عدد)
    | نقل_فوري_بتات_إكس بنوع (معرف_سجل_افتراضي, طبيعي)
    | عنوان_دالة_إكس بنوع (معرف_سجل_افتراضي, معرف_دالة_منتقاة)
    | عنوان_عام_إكس بنوع (معرف_سجل_افتراضي, معرف_عام_مسير, منطقي)
    | بيئة_إغلاق_إكس بنوع معرف_سجل_افتراضي
    | حساب_صحيح_كامل_إكس بنوع (حساب_صحيح_إكس_كامل, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي, منطقي)
    | تحويل_صحيح_كامل_إكس بنوع (تحويل_صحيح_إكس_كامل, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي, طبيعي, منطقي)
    | حساب_عشري_إكس بنوع (حساب_عشري_إكس_كامل, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    // Division or remainder by a constant with a multiply
    // (backend/codegen/division_by_constant.sn): (destination, dividend,
    // divisor as 64-bit pattern, bits, signed, remainder).
    | قسمة_على_ثابت_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي, طبيعي, منطقي, منطقي)
    // (operation, destination, source, source bits, destination bits)
    | تحويل_عائم_إكس بنوع (تحويل_عائم_إكس_كامل, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي, طبيعي)
    | مقارنة_عشرية_إلى_منطق_إكس بنوع (مقارنة_عشرية_إكس_كاملة, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | مقارنة_إلى_منطق_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, شرط_إكس_ستة_وثمانون_أربعة_وستون, طبيعي)
    | جمع_ثنائي_العنوان_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي)
    | جمع_ثنائي_العنوان_إكس_مع_فخ_تجاوز بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, صنف_فخ_تجاوز_إكس_ستة_وثمانون_أربعة_وستون)
    | طرح_ثنائي_العنوان_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي)
    | طرح_ثنائي_العنوان_إكس_مع_فخ_تجاوز بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, صنف_فخ_تجاوز_إكس_ستة_وثمانون_أربعة_وستون)
    | تكوين_عنوان_إكس بنوع (معرف_سجل_افتراضي, عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون)
    | تكوين_عنوان_مقاس_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي, عدد)
    | عنوان_موضع_محلي_إكس بنوع (معرف_سجل_افتراضي, طبيعي)
    | نسخ_ذاكرة_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي, طبيعي, طبيعي)
    | تخزين_فوري_ذاكرة_إكس بنوع (معرف_سجل_افتراضي, طبيعي, طبيعي, طبيعي)
    | إلحاق_متجه_إكس بنوع إلحاق_متجه_إكس_ستة_وثمانون_أربعة_وستون
    | ثابت_نص_إكس بنوع ثابت_نص_إكس_ستة_وثمانون_أربعة_وستون
    | تخصيص_صندوق_إكس بنوع (معرف_سجل_افتراضي, طبيعي, طبيعي)
    | تحميل_إكس بنوع (معرف_سجل_افتراضي, عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون, طبيعي, منطقي)
    | تخزين_إكس بنوع (معرف_سجل_افتراضي, عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون, طبيعي)
    | مقارنة_سجل_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي)
    // جدول نقل نسبي داخل شفرة الدالة؛ جميع الحواف بلا معاملات كتل.
    // (selector, targets for tags الأدنى..الأدنى+len-1, default, الأدنى)
    | قفز_جدولي_إكس بنوع (معرف_سجل_افتراضي, متجه معرف_كتلة_منتقاة, معرف_كتلة_منتقاة, طبيعي)
    | قفز_إكس بنوع معرف_كتلة_منتقاة
    | قفز_إكس_مع_نقلات بنوع متطلبات_نقل_حافة_منتقاة
    | قفز_شرطي_إكس بنوع (شرط_إكس_ستة_وثمانون_أربعة_وستون, معرف_كتلة_منتقاة)
    | قفز_شرطي_إكس_مع_نقلات بنوع (شرط_إكس_ستة_وثمانون_أربعة_وستون, متطلبات_نقل_حافة_منتقاة)
    | قفز_شرطي_بقيمة_إكس بنوع (معرف_سجل_افتراضي, متطلبات_نقل_حافة_منتقاة)
    | فخ_إكس
    // (operation, destination, address, operand, bits): the old value.
    | ذري_إكس بنوع (عملية_ذرية_إكس, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    // (destination, address, expected, new, bits): the old value.
    | ذري_قارن_وبدل_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    // (address, value, bits): a sequentially consistent store (XCHG).
    | ذري_خزن_إكس بنوع (معرف_سجل_افتراضي, معرف_سجل_افتراضي, طبيعي)
    | سياج_إكس
    | نداء_إكس_مباشر بنوع نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى
    | عودة_إكس
    | عودة_إكس_بقيمة بنوع ناتج_عودة_إكس_ستة_وثمانون_أربعة_وستون_منتقى
;
