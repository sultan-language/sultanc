}

عام عرف ألحق_خدمة_إعادة_تخصيص_ذاكرة_لينكس_إكس(
    البايتات: &متغير متجه غ8,
    موضع_المخصص: غير_موقع,
    موضع_التحرير: غير_موقع
): غير_موقع {
    دع نص_الشفرة: نص = «4883EC084885FF750D4889F7E8000000004883C408C34885F6750CE80000000031C04883C408C3488B47F04883E8104839C6770C488977F84889F84883C408C35341544889FB4989F44889F7E8000000004885C0742D4889C2488B4BF84C39E176034C89E14889D74889DEF3A44989D44889DFE8000000004C89E0415C5B4883C408C3415C5B4883C408C3»;
