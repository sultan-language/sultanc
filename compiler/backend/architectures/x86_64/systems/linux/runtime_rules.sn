// Linux x86_64 uses one canonical in-image runtime allocator. The backend emits
// an ordinary SysV ABI call to the Target-owned runtime service instead of mmaping
// every language allocation independently.
عام عرف خطة_تخصيص_ذاكرة_لينكس_إكس(): خطة_تخصيص_ذاكرة_هدف {
    دع الخدمة: خدمة_تشغيل_هدف = خدمة_تشغيل_هدف.تخصيص_ذاكرة();
    دع النداء: خطة_نداء_رمزي_تخصيص_ذاكرة_هدف = { الخدمة: الخدمة };
    أرجع خطة_تخصيص_ذاكرة_هدف.نداء_رمزي(النداء);
}

// Linux/x86_64 machine runtime. Every emitted helper below is self-contained raw
// Linux code with no libc/POSIX symbol relocations and no external linker dependency.

// Machine-code blobs are encoded as hex text so compiler self-hosting does not
// create one AST/Type fact per emitted runtime byte. Decoding is linear and
// preserves the exact Target-owned byte image.
عرف قيمة_رقم_سداسي_تشغيل_لينكس_إكس(الحرف: غ8): غير_موقع {
    لو (الحرف >= 48 && الحرف <= 57) { أرجع (الحرف - 48) مثل غير_موقع; };
    لو (الحرف >= 65 && الحرف <= 70) { أرجع (الحرف - 55) مثل غير_موقع; };
    أرجع (الحرف - 87) مثل غير_موقع;
}

عرف فك_شفرة_تشغيل_لينكس_إكس(النص: &نص): متجه غ8 {
    دع المصدر: نص = *النص;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع ت: غير_موقع = ف + 1;
        دع العالي: غير_موقع = قيمة_رقم_سداسي_تشغيل_لينكس_إكس(المصدر[ف]);
        دع المنخفض: غير_موقع = قيمة_رقم_سداسي_تشغيل_لينكس_إكس(المصدر[ت]);
        ألحق(الناتج, ((العالي * 16 + المنخفض) مثل غ8));
        ف := ف + 2;
    }
    أرجع الناتج;
}
عرف ألحق_بايت_تشغيل_لينكس_إكس(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ب: متغير متجه غ8 = *البايتات;
    ألحق(ب, (القيمة % 256) مثل غ8);
    *البايتات := ب;
}

عرف ألحق_شفرة_تشغيل_لينكس_إكس(الوجهة: &متغير متجه غ8, الشفرة: &متجه غ8): غير_موقع {
    دع البداية: غير_موقع = الطول(*الوجهة) مثل غير_موقع;
    دع الناتج: متغير متجه غ8 = *الوجهة;
    دع م: متجه غ8 = *الشفرة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م) مثل غير_موقع)) {
        ألحق(الناتج, م[ف]);
        ف := ف + 1;
    }
    *الوجهة := الناتج;
    أرجع البداية;
}

عام عرف اصلح_نداء_محلي_لينكس_إكس(
    البايتات: &متغير متجه غ8,
    موضع_الحقل: غير_موقع,
    موضع_الهدف: غير_موقع
): منطقي {
    دع بعد_الحقل: غير_موقع = موضع_الحقل + 4;
    دع الفرق: متغير عدد = 0;
    لو (موضع_الهدف >= بعد_الحقل) {
        الفرق := (موضع_الهدف - بعد_الحقل) مثل عدد;
    } وإلا {
        الفرق := -((بعد_الحقل - موضع_الهدف) مثل عدد);
    };
    لو (الفرق < -2147483648 || الفرق > 2147483647) { أرجع خطأ; };
    دع الحقل: متغير غير_موقع = 0;
    لو (الفرق < 0) {
        دع ملفوف: عدد = 4294967296 + الفرق;
        الحقل := ملفوف مثل غير_موقع;
    } وإلا {
        الحقل := الفرق مثل غير_موقع;
    };
    دع ب: متغير متجه غ8 = *البايتات;
    دع الباقي: متغير غير_موقع = الحقل;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        دع الفهرس: غير_موقع = موضع_الحقل + ف;
        ب[الفهرس] := (الباقي % 256) مثل غ8;
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
    *البايتات := ب;
    أرجع صواب;
}

// Canonical Linux/x86_64 runtime allocator. `_start` owns {current,end} plus
// power-of-two free-list heads in reserved callee-saved r14. Small allocations
// are 16-byte aligned, suballocated from 1 MiB mmap slabs, and recycled by size
// class. Large requests use dedicated page-rounded mappings and are munmapped on
// release. Allocation headers retain block/request size for free/realloc.
عام عرف ألحق_خدمة_تخصيص_ذاكرة_لينكس_إكس(البايتات: &متغير متجه غ8): غير_موقع {
    دع نص_الشفرة: نص = «»;
    دع الشفرة: متجه غ8 = فك_شفرة_تشغيل_لينكس_إكس(&نص_الشفرة);
    دع الغلاف_الخام: نص = «41564C8B3500000000E800000000415EC3»;
    دع الغلاف: متجه غ8 = فك_شفرة_تشغيل_لينكس_إكس(&الغلاف_الخام);
    دع بداية_الغلاف: غير_موقع = ألحق_شفرة_تشغيل_لينكس_إكس(البايتات, &الغلاف);
    دع بداية_الجسم: غير_موقع = ألحق_شفرة_تشغيل_لينكس_إكس(البايتات, &الشفرة);
    اصلح_نداء_محلي_لينكس_إكس(البايتات, بداية_الغلاف + 10, بداية_الجسم);
    أرجع بداية_الغلاف;
}

عام عرف ألحق_خدمة_تحرير_ذاكرة_لينكس_إكس(البايتات: &متغير متجه غ8): غير_موقع {
    دع نص_الشفرة: نص = «4885FF7426488D47F0488B084881F9000008007717480FBDD183EA054D8D44D6104D8B084C894808498900C34889CE4889C7B80B0000000F05C3»;
    دع الشفرة: متجه غ8 = فك_شفرة_تشغيل_لينكس_إكس(&نص_الشفرة);
    دع الغلاف_الخام: نص = «41564C8B3500000000E800000000415EC3»;
