// Vector append: grow through the canonical runtime allocator, preserve elements,
// append scalar/aggregate data before releasing any aliased old storage, then recycle
// the obsolete backing block through the canonical Linux free service.
عام عرف ألحق_بدائي_إلحاق_لينكس_إكس(
    البايتات: &متغير متجه غ8,
    موضع_المخصص: غير_موقع,
    موضع_التحرير: غير_موقع
): غير_موقع {
    دع نص_الشفرة: نص = «»;
    دع الشفرة: متجه غ8 = فك_شفرة_تشغيل_لينكس_إكس(&نص_الشفرة);
    دع البداية: غير_موقع = ألحق_شفرة_تشغيل_لينكس_إكس(البايتات, &الشفرة);
