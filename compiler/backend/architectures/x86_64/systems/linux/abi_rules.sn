استورد compiler.backend.abi.abi_model;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.backend.layout.alignment;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.layout.layout_resolution;
استورد compiler.backend.target.target_model;

// هذا المالك يصف الجزء المنفذ حاليا من System V AMD64 ABI للقيم السلمية ذات فئة INTEGER:
// المنطق، الأعداد الصحيحة المدعومة، والمؤشر/المرجع/الصندوق ذوات التمثيل المؤشري.
// الستة الأولى تمر في السجلات والباقي في eightbyte stack slots؛ تحويل المرجع المنطقي
// إلى رقم سجل آلة يملكه register_rules.sn المجاور، وTarget يمرر نموذج البيانات والتخطيط.
عام عرف محاذاة_إطار_سيستم_في_إكس(): غير_موقع {
    أرجع 16;
}

عام عرف تعديل_مكدس_نداء_سيستم_في_إكس_مع_حجج(
    حجم_الإطار: غير_موقع,
    حجم_حجج_المكدس: غير_موقع
): غير_موقع {
    // عند مدخل الدالة RSP = 8 (mod 16). قبل CALL يجب أن يكون RSP = 0 (mod 16).
    // منطقة حجج المكدس تبدأ عند RSP قبل CALL؛ حشو المحاذاة يأتي بعدها ولا يغير إزاحات الحجج.
    دع المستخدم: غير_موقع = حجم_الإطار + حجم_حجج_المكدس;
    دع الباقي: غير_موقع = المستخدم % 16;
    دع ستة_عشر: غير_موقع = 16;
    دع ثمانية: غير_موقع = 8;
    دع قبل_الحشو: غير_موقع = ثمانية + ستة_عشر - الباقي;
    دع الحشو: غير_موقع = قبل_الحشو % ستة_عشر;
    أرجع حجم_حجج_المكدس + الحشو;
}

عام عرف تعديل_مكدس_نداء_سيستم_في_إكس(حجم_الإطار: غير_موقع): غير_موقع {
    أرجع تعديل_مكدس_نداء_سيستم_في_إكس_مع_حجج(حجم_الإطار, 0);
}

عام عرف إزاحة_معامل_مكدس_سيستم_في_إكس_بعد_إطار(
    حجم_الإطار: غير_موقع,
    موضع_المعامل: &موضع_مكدس_واجهة
): غير_موقع {
    دع الموضع: موضع_مكدس_واجهة = *موضع_المعامل;
    // CALL يدفع عنوان العودة (8 بايتات)، ثم يطرح callee إطار الانسكاب المحلي.
    أرجع حجم_الإطار + 8 + الموضع.الإزاحة;
}

عام عرف تعديل_مكدس_نداء_سيستم_في_إكس_بدون_إطار(): غير_موقع {
    أرجع تعديل_مكدس_نداء_سيستم_في_إكس(0);
}

عرف تصنيف_متجاهل_سيستم_في(): تصنيف_قيمة_واجهة {
    دع الطريقة: طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.متجاهل();
    دع الفئة: اختيار فئة_سجل_واجهة = اختيار.لا_شيء();
    دع الناتج: تصنيف_قيمة_واجهة = {
        الطريقة: الطريقة,
        الحجم: 0,
        المحاذاة: 1,
        عدد_الأجزاء: 0,
        فئة_السجل: الفئة,
        تجميعي: خطأ
    };
    أرجع الناتج;
}

عرف تصنيف_سلمي_سيستم_في(
    الحجم: غير_موقع,
    المحاذاة: غير_موقع,
    عائم: منطقي
): تصنيف_قيمة_واجهة {
    دع الطريقة: طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.مباشر();
    دع فئة_القيمة: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
    لو (عائم) { فئة_القيمة := فئة_سجل_واجهة.عائم_متجه(); };
    دع الفئة: اختيار فئة_سجل_واجهة = اختيار.بعض(فئة_القيمة);
    دع الناتج: تصنيف_قيمة_واجهة = {
        الطريقة: الطريقة,
        الحجم: الحجم,
        المحاذاة: المحاذاة,
        عدد_الأجزاء: 1,
        فئة_السجل: الفئة,
        تجميعي: خطأ
    };
    أرجع الناتج;
}

عرف نوع_فراغ_سيستم_في(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.فراغ -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف تفاصيل_تجميعية_سيستم_في(التفاصيل: &تفاصيل_تخطيط): منطقي {
    طابق *التفاصيل مع
    | تفاصيل_تخطيط.صف(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.سجل(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.تعداد(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف نوع_سلمي_واجهة_سيستم_في(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق صنف_النوع_البدائي(البدائي) مع
            | صنف_نوع_بدائي.منطقي -> { أرجع صواب; }
            | صنف_نوع_بدائي.عدد_موقع -> { أرجع صواب; }
            | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> { أرجع صواب; }
            | صنف_نوع_بدائي.عشري -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | صنف_شكل_نوع_دلالي.مؤشر -> { أرجع صواب; }
        | صنف_شكل_نوع_دلالي.مرجع -> { أرجع صواب; }
        | صنف_شكل_نوع_دلالي.صندوق -> { أرجع صواب; }
        | صنف_شكل_نوع_دلالي.دالة -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف نوع_عائم_واجهة_سيستم_في(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري();
        }
        | _ -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف تصنيف_تجميعي_سيستم_في(
    الحجم: غير_موقع,
    المحاذاة: غير_موقع
): تصنيف_قيمة_واجهة {
    دع الطريقة: متغير طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.مباشر();
    دع الأجزاء: متغير غير_موقع = 1;
    لو (الحجم > 8) {
        الطريقة := طريقة_تمرير_واجهة.مجزأ();
        الأجزاء := (الحجم + 7) / 8;
    };
    دع الفئة: اختيار فئة_سجل_واجهة = اختيار.بعض(فئة_سجل_واجهة.عدد_صحيح());
    دع الناتج: تصنيف_قيمة_واجهة = {
        الطريقة: الطريقة,
        الحجم: الحجم,
        المحاذاة: المحاذاة,
        عدد_الأجزاء: الأجزاء,
        فئة_السجل: الفئة,
        تجميعي: صواب
    };
    أرجع الناتج;
}

عرف صنف_قيمة_سيستم_في_إيه_إيه_إم_دي_أربعة_وستون(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة تصنيف_قيمة_واجهة, خطأ_واجهة {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_واجهة.معرف_نوع_غير_صالح(النوع)); }
    | اختيار.بعض(_) -> { };

    لو (نوع_فراغ_سيستم_في(الأنواع, النوع)) {
        أرجع نتيجة.نجح(تصنيف_متجاهل_سيستم_في());
    };

    طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مؤجل(السبب) -> {
        أرجع نتيجة.خطأ(خطأ_واجهة.تخطيط_نوع_مؤجل(النوع, السبب));
    }
    | نتيجة_تخطيط.مرفوض(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_واجهة.تخطيط_نوع_مرفوض(النوع, الخطأ));
    }
    | نتيجة_تخطيط.مكتمل(التخطيط) -> {
        لو (التخطيط.الحجم == 0) {
            أرجع نتيجة.نجح(تصنيف_متجاهل_سيستم_في());
        };
        لو (تفاصيل_تجميعية_سيستم_في(&التخطيط.التفاصيل)) {
            أرجع نتيجة.نجح(تصنيف_تجميعي_سيستم_في(التخطيط.الحجم, التخطيط.المحاذاة));
        };
        لو (!نوع_سلمي_واجهة_سيستم_في(الأنواع, النوع)) {
            أرجع نتيجة.خطأ(خطأ_واجهة.نوع_غير_مدعوم(النوع));
        };
        لو (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
            أرجع نتيجة.خطأ(خطأ_واجهة.حجم_نوع_غير_مدعوم(النوع, التخطيط.الحجم));
        };
        أرجع نتيجة.نجح(تصنيف_سلمي_سيستم_في(
            التخطيط.الحجم, التخطيط.المحاذاة, نوع_عائم_واجهة_سيستم_في(الأنواع, النوع)
        ));
    };
}

عرف مرجع_سجل_سيستم_في(
    الفئة: فئة_سجل_واجهة,
    الفهرس: غير_موقع,
    الدور: دور_سجل_واجهة
): مرجع_سجل_واجهة {
    دع الحفظ: حفظ_سجل_واجهة = حفظ_سجل_واجهة.متطاير_عبر_النداء();
    دع المرجع: مرجع_سجل_واجهة = {
        الفئة: الفئة,
        الفهرس: الفهرس,
        الدور: الدور,
        الحفظ: الحفظ
    };
    أرجع المرجع;
}

// SysV AMD64: عندما يعاد تجميع MEMORY-class عبر مؤشر sret مخفي،
// يجب أن يعيد callee نفس عنوان sret في أول سجل نتيجة INTEGER (RAX فعليا).
// هذه الدالة تملك سياسة ABI المنطقية فقط؛ Target يحل المرجع إلى سجل آلة.
عام عرف مرجع_إرجاع_عنوان_ناتج_غير_مباشر_سيستم_في_إكس(): مرجع_سجل_واجهة {
    أرجع مرجع_سجل_سيستم_في(فئة_سجل_واجهة.عدد_صحيح(), 0, دور_سجل_واجهة.ناتج());
}

عام عرف صنف_واجهة_سيستم_في_إيه_إيه_إم_دي_أربعة_وستون_دالة(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع أنواع_المعاملات: متجه معرف_نوع = *المعاملات;
    دع الخطط: متغير متجه خطة_معامل_واجهة = [];
    دع سجل_صحيح_تال: متغير غير_موقع = 0;
    دع سجل_عائم_تال: متغير غير_موقع = 0;
    دع حجم_المكدس: متغير غير_موقع = 0;

    // SysV AMD64 يعيد التجميع الأكبر من two eightbytes عبر مؤشر مخفي في RDI.
    دع تصنيف_الناتج: متغير تصنيف_قيمة_واجهة;
    طابق صنف_قيمة_سيستم_في_إيه_إيه_إم_دي_أربعة_وستون(الأنواع, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(التصنيف) -> { تصنيف_الناتج := التصنيف; };

    دع ناتج_غير_مباشر: منطقي = تصنيف_الناتج.تجميعي && تصنيف_الناتج.الحجم > 16;
    لو (ناتج_غير_مباشر) {
        سجل_صحيح_تال := 1;
    };

    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أنواع_المعاملات) مثل غير_موقع)) {
        طابق صنف_قيمة_سيستم_في_إيه_إيه_إم_دي_أربعة_وستون(الأنواع, الهدف, سجل_التخطيط, أنواع_المعاملات[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(التصنيف) -> {
            دع الموقع: متغير موقع_تمرير_واجهة = موقع_تمرير_واجهة.متجاهل();
            لو (التصنيف.الطريقة == طريقة_تمرير_واجهة.متجاهل()) {
                الموقع := موقع_تمرير_واجهة.متجاهل();
            } وإلا {
                دع الأجزاء: متغير متجه موضع_جزء_واجهة = [];
                دع عدد_الأجزاء: غير_موقع = التصنيف.عدد_الأجزاء;
                // SysV: INTEGER and SSE registers have independent banks; large aggregates are MEMORY-class.
                دع يجب_المكدس: منطقي = التصنيف.تجميعي && التصنيف.الحجم > 16;
                دع الفئة: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
                طابق التصنيف.فئة_السجل مع
                | اختيار.بعض(ف) -> { الفئة := ف; }
                | اختيار.لا_شيء -> { };
                دع عائم: منطقي = الفئة == فئة_سجل_واجهة.عائم_متجه();
                لو (!يجب_المكدس && عائم && سجل_عائم_تال + عدد_الأجزاء <= 8) {
                    دع ج: متغير غير_موقع = 0;
                    بينما (ج < عدد_الأجزاء) {
                        دع المرجع: مرجع_سجل_واجهة = مرجع_سجل_سيستم_في(
                            الفئة, سجل_عائم_تال + ج, دور_سجل_واجهة.معامل()
                        );
                        ألحق(الأجزاء, موضع_جزء_واجهة.سجل(المرجع));
                        ج := ج + 1;
                    }
                    سجل_عائم_تال := سجل_عائم_تال + عدد_الأجزاء;
                } وإلا لو (!يجب_المكدس && !عائم && سجل_صحيح_تال + عدد_الأجزاء <= 6) {
                    دع ج: متغير غير_موقع = 0;
                    بينما (ج < عدد_الأجزاء) {
                        دع المرجع: مرجع_سجل_واجهة = مرجع_سجل_سيستم_في(
                            الفئة, سجل_صحيح_تال + ج, دور_سجل_واجهة.معامل()
                        );
                        ألحق(الأجزاء, موضع_جزء_واجهة.سجل(المرجع));
                        ج := ج + 1;
                    }
                    سجل_صحيح_تال := سجل_صحيح_تال + عدد_الأجزاء;
                } وإلا {
                    حجم_المكدس := محاذاة_لأعلى(حجم_المكدس, 8);
                    دع ج: متغير غير_موقع = 0;
                    بينما (ج < عدد_الأجزاء) {
                        دع بداية: غير_موقع = ج * 8;
                        دع إزاحة_الجزء: غير_موقع = حجم_المكدس + بداية;
                        دع موضع_المكدس: موضع_مكدس_واجهة = {
                            الإزاحة: إزاحة_الجزء,
                            الحجم: 8,
                            المحاذاة: 8
                        };
                        ألحق(الأجزاء, موضع_جزء_واجهة.مكدس(موضع_المكدس));
                        ج := ج + 1;
                    }
                    حجم_المكدس := حجم_المكدس + محاذاة_لأعلى(التصنيف.الحجم, 8);
                };
                لو (عدد_الأجزاء == 1) {
                    الموقع := موقع_تمرير_واجهة.مباشر(الأجزاء[0]);
                } وإلا {
                    الموقع := موقع_تمرير_واجهة.مجزأ(الأجزاء);
                };
            };
            دع الخطة: خطة_معامل_واجهة = {
                الفهرس: ف,
                النوع: أنواع_المعاملات[ف],
                التصنيف: التصنيف,
                الموقع: الموقع
            };
            ألحق(الخطط, الخطة);
        };
        ف := ف + 1;
    }

    دع موقع_الناتج: متغير موقع_تمرير_واجهة = موقع_تمرير_واجهة.متجاهل();
    دع تصنيف_الناتج_النهائي: متغير تصنيف_قيمة_واجهة = تصنيف_الناتج;
    لو (تصنيف_الناتج.الطريقة == طريقة_تمرير_واجهة.متجاهل()) {
        موقع_الناتج := موقع_تمرير_واجهة.متجاهل();
    } وإلا لو (ناتج_غير_مباشر) {
        دع الطريقة: طريقة_تمرير_واجهة = طريقة_تمرير_واجهة.غير_مباشر();
        تصنيف_الناتج_النهائي.الطريقة := الطريقة;
        تصنيف_الناتج_النهائي.عدد_الأجزاء := 1;
        دع الفئة: فئة_سجل_واجهة = فئة_سجل_واجهة.نتيجة_غير_مباشرة();
        دع الدور: دور_سجل_واجهة = دور_سجل_واجهة.عنوان_نتيجة_غير_مباشرة();
        دع الحفظ: حفظ_سجل_واجهة = حفظ_سجل_واجهة.متطاير_عبر_النداء();
        دع المرجع: مرجع_سجل_واجهة = {
            الفئة: الفئة,
            الفهرس: 0,
            الدور: الدور,
            الحفظ: الحفظ
        };
        موقع_الناتج := موقع_تمرير_واجهة.غير_مباشر(موضع_جزء_واجهة.سجل(المرجع));
    } وإلا لو (تصنيف_الناتج.عدد_الأجزاء == 1) {
        دع الفئة_الناتج: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
        طابق تصنيف_الناتج.فئة_السجل مع
        | اختيار.بعض(ف) -> { الفئة_الناتج := ف; }
        | اختيار.لا_شيء -> { };
        دع المرجع: مرجع_سجل_واجهة = مرجع_سجل_سيستم_في(الفئة_الناتج, 0, دور_سجل_واجهة.ناتج());
        موقع_الناتج := موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.سجل(المرجع));
    } وإلا {
        دع المواضع: متغير متجه موضع_جزء_واجهة = [];
        دع ج: متغير غير_موقع = 0;
        بينما (ج < تصنيف_الناتج.عدد_الأجزاء) {
            دع المرجع: مرجع_سجل_واجهة = مرجع_سجل_سيستم_في(فئة_سجل_واجهة.عدد_صحيح(), ج, دور_سجل_واجهة.ناتج());
            ألحق(المواضع, موضع_جزء_واجهة.سجل(المرجع));
            ج := ج + 1;
        }
        موقع_الناتج := موقع_تمرير_واجهة.مجزأ(المواضع);
    };

    دع خطة_الناتج: خطة_ناتج_واجهة = {
        النوع: الناتج,
        التصنيف: تصنيف_الناتج_النهائي,
        الموقع: موقع_الناتج
    };
    دع حجم_المكدس_المحاذى: غير_موقع = محاذاة_لأعلى(حجم_المكدس, 16);
    دع الخطة: خطة_دالة_واجهة = {
        المعاملات: الخطط,
        الناتج: خطة_الناتج,
        حجم_مكدس_النداء: حجم_المكدس_المحاذى,
        محاذاة_مكدس_النداء: 16
    };
    أرجع نتيجة.نجح(الخطة);
}

