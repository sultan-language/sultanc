استورد compiler.backend.abi.abi_model;
استورد compiler.backend.codegen.allocation_contract;

// أرقام السجلات هنا هي ترقيم x86_64 الذي يستهلكه encoder الحالي:
// RAX=0, RCX=1, RDX=2, RSI=6, RDI=7, R8=8, R9=9, R10=10, R11=11.
عام عرف سجل_إكس_فعلي_من(الفهرس: طبيعي): معرف_سجل_فعلي {
    دع الناتج: معرف_سجل_فعلي = { القيمة: الفهرس };
    أرجع الناتج;
}

عام عرف سجل_واجهة_سيستم_في_إلى_إكس(
    المرجع: &مرجع_سجل_واجهة
): اختياري معرف_سجل_فعلي {
    دع ر: مرجع_سجل_واجهة = *المرجع;
    طابق ر.الدور مع
    | دور_سجل_واجهة.معامل -> {
        إذا (ر.الفئة != فئة_سجل_واجهة.عدد_صحيح()) { أرجع اختياري.لا_شيء(); };
        إذا (ر.الفهرس == 0) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(7)); };
        إذا (ر.الفهرس == 1) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(6)); };
        إذا (ر.الفهرس == 2) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(2)); };
        إذا (ر.الفهرس == 3) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(1)); };
        إذا (ر.الفهرس == 4) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(8)); };
        إذا (ر.الفهرس == 5) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(9)); };
        أرجع اختياري.لا_شيء();
    }
    | دور_سجل_واجهة.ناتج -> {
        إذا (ر.الفئة != فئة_سجل_واجهة.عدد_صحيح()) { أرجع اختياري.لا_شيء(); };
        إذا (ر.الفهرس == 0) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(0)); };
        إذا (ر.الفهرس == 1) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(2)); };
        أرجع اختياري.لا_شيء();
    }
    | دور_سجل_واجهة.عنوان_نتيجة_غير_مباشرة -> {
        إذا (ر.الفئة != فئة_سجل_واجهة.نتيجة_غير_مباشرة()) { أرجع اختياري.لا_شيء(); };
        إذا (ر.الفهرس == 0) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(7)); };
        أرجع اختياري.لا_شيء();
    };
}

عام عرف سجلات_متطايرة_سيستم_في_إكس(): متجه معرف_سجل_فعلي {
    // Appends the registers directly; no index vector is built per query.
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    ألحق(الناتج, سجل_إكس_فعلي_من(0));
    ألحق(الناتج, سجل_إكس_فعلي_من(1));
    ألحق(الناتج, سجل_إكس_فعلي_من(2));
    ألحق(الناتج, سجل_إكس_فعلي_من(6));
    ألحق(الناتج, سجل_إكس_فعلي_من(7));
    ألحق(الناتج, سجل_إكس_فعلي_من(8));
    ألحق(الناتج, سجل_إكس_فعلي_من(9));
    ألحق(الناتج, سجل_إكس_فعلي_من(10));
    ألحق(الناتج, سجل_إكس_فعلي_من(11));
    أرجع الناتج;
}

// R10/RAX/RCX/RDX محجوزة لخفض الانسكاب والعمل الثابت، وR11 لمساحة عمل النداء.
// R12/R13/R14 محجوزة لحالة تشغيل Linux: argc، argv، ومؤشر حالة المخصص على الترتيب.
// R14 callee-saved وفق SysV ويجب ألا يستخدم كسجل scratch عبر نداءات Runtime المتداخلة.
// تبقى RDI/RSI/R8/R9 متاحة للتخصيص العام؛ حقائق النداء/العمل الخاص تعلم المخصص
// أنها caller-saved فلا تعيش قيمة فيها عبر حد يفسدها.
عام عرف سجلات_عمل_إكس_قابلة_للتخصيص(): متجه معرف_سجل_فعلي {
    // Appends the registers directly; no index vector is built per query.
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    ألحق(الناتج, سجل_إكس_فعلي_من(7));
    ألحق(الناتج, سجل_إكس_فعلي_من(6));
    ألحق(الناتج, سجل_إكس_فعلي_من(8));
    ألحق(الناتج, سجل_إكس_فعلي_من(9));
    // Callee-saved (System V): a value live across calls stays in one of
    // these instead of a stack slot; a function saves the ones it uses.
    دع المحفوظة: متجه معرف_سجل_فعلي = سجلات_محفوظة_سيستم_في_إكس();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المحفوظة) مثل طبيعي)) { ألحق(الناتج, المحفوظة[ف]); ف := ف + 1; }
    أرجع الناتج;
}

// RBX, R12..R14 and RBP. R15 carries a closure's environment into its call
// (سجل_بيئة_إغلاق_للهدف), so it is never allocated. Frames are addressed
// from RSP and unwound from their call-frame information, so RBP is no frame
// pointer here (the process entry only clears it): it is one more register
// for values live across calls, last because each function that takes it
// saves it. The task switch saves it with the others.
عام عرف سجلات_محفوظة_سيستم_في_إكس(): متجه معرف_سجل_فعلي {
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    ألحق(الناتج, سجل_إكس_فعلي_من(3));
    ألحق(الناتج, سجل_إكس_فعلي_من(12));
    ألحق(الناتج, سجل_إكس_فعلي_من(13));
    ألحق(الناتج, سجل_إكس_فعلي_من(14));
    ألحق(الناتج, سجل_إكس_فعلي_من(5));
    أرجع الناتج;
}

عام عرف سجل_عمل_نقل_نداء_إكس(): معرف_سجل_فعلي {
    أرجع سجل_إكس_فعلي_من(11);
}

عام عرف سجلات_عمل_انسكاب_إكس(): متجه معرف_سجل_فعلي {
    // أول سجلين محجوزان لنقلات المواقع المتوازية: R10 للدورات وRAX للذاكرة.
    // RCX/RDX يكملان مجموعة العمل للعمليات ذات عدة معاملات؛ هذه السجلات الأربع
    // لا تدخل مجموعة التخصيص العام، لذلك لا تصطدم بقيم حية أثناء خفض الانسكاب.
    // Appends the registers directly; no index vector is built per query.
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    ألحق(الناتج, سجل_إكس_فعلي_من(10));
    ألحق(الناتج, سجل_إكس_فعلي_من(0));
    ألحق(الناتج, سجل_إكس_فعلي_من(1));
    ألحق(الناتج, سجل_إكس_فعلي_من(2));
    أرجع الناتج;
}

// DWARF register numbers are ABI/debug-format facts, not encoder register ids.
عام عرف رقم_سجل_دوارف_سيستم_في_إكس(
    السجل: معرف_سجل_فعلي
): اختياري طبيعي {
    إذا (السجل.القيمة == 0) { أرجع اختياري.موجود(0); };  // RAX
    إذا (السجل.القيمة == 1) { أرجع اختياري.موجود(2); };  // RCX
    إذا (السجل.القيمة == 2) { أرجع اختياري.موجود(1); };  // RDX
    إذا (السجل.القيمة == 3) { أرجع اختياري.موجود(3); };  // RBX
    إذا (السجل.القيمة == 4) { أرجع اختياري.موجود(7); };  // RSP
    إذا (السجل.القيمة == 5) { أرجع اختياري.موجود(6); };  // RBP
    إذا (السجل.القيمة == 6) { أرجع اختياري.موجود(4); };  // RSI
    إذا (السجل.القيمة == 7) { أرجع اختياري.موجود(5); };  // RDI
    إذا (السجل.القيمة >= 8 && السجل.القيمة <= 15) { أرجع اختياري.موجود(السجل.القيمة); };
    أرجع اختياري.لا_شيء();
}
