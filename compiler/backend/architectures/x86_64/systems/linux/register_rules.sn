استورد compiler.backend.abi.abi_model;
استورد compiler.backend.codegen.allocation_contract;

// أرقام السجلات هنا هي ترقيم x86_64 الذي يستهلكه encoder الحالي:
// RAX=0, RCX=1, RDX=2, RSI=6, RDI=7, R8=8, R9=9, R10=10, R11=11.
عام عرف سجل_إكس_فعلي_من(الفهرس: طبيعي): معرف_سجل_فعلي {
    دع الناتج: معرف_سجل_فعلي = { القيمة: الفهرس };
    أرجع الناتج;
}

عام عرف سجل_واجهة_سيستم_في_إلى_إكس(
    المرجع: &مرجع_سجل_واجهة
): اختياري معرف_سجل_فعلي {
    دع ر: مرجع_سجل_واجهة = *المرجع;
    طابق ر.الدور مع
    | دور_سجل_واجهة.معامل -> {
        لو (ر.الفئة != فئة_سجل_واجهة.عدد_صحيح()) { أرجع اختياري.لا_شيء(); };
        لو (ر.الفهرس == 0) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(7)); };
        لو (ر.الفهرس == 1) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(6)); };
        لو (ر.الفهرس == 2) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(2)); };
        لو (ر.الفهرس == 3) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(1)); };
        لو (ر.الفهرس == 4) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(8)); };
        لو (ر.الفهرس == 5) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(9)); };
        أرجع اختياري.لا_شيء();
    }
    | دور_سجل_واجهة.ناتج -> {
        لو (ر.الفئة != فئة_سجل_واجهة.عدد_صحيح()) { أرجع اختياري.لا_شيء(); };
        لو (ر.الفهرس == 0) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(0)); };
        لو (ر.الفهرس == 1) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(2)); };
        أرجع اختياري.لا_شيء();
    }
    | دور_سجل_واجهة.عنوان_نتيجة_غير_مباشرة -> {
        لو (ر.الفئة != فئة_سجل_واجهة.نتيجة_غير_مباشرة()) { أرجع اختياري.لا_شيء(); };
        لو (ر.الفهرس == 0) { أرجع اختياري.موجود(سجل_إكس_فعلي_من(7)); };
        أرجع اختياري.لا_شيء();
    };
}

عام عرف سجلات_متطايرة_سيستم_في_إكس(): متجه معرف_سجل_فعلي {
    // Appends the registers directly; no index vector is built per query.
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    ألحق(الناتج, سجل_إكس_فعلي_من(0));
    ألحق(الناتج, سجل_إكس_فعلي_من(1));
    ألحق(الناتج, سجل_إكس_فعلي_من(2));
    ألحق(الناتج, سجل_إكس_فعلي_من(6));
    ألحق(الناتج, سجل_إكس_فعلي_من(7));
    ألحق(الناتج, سجل_إكس_فعلي_من(8));
    ألحق(الناتج, سجل_إكس_فعلي_من(9));
    ألحق(الناتج, سجل_إكس_فعلي_من(10));
    ألحق(الناتج, سجل_إكس_فعلي_من(11));
    أرجع الناتج;
}

// R10/RAX/RCX/RDX محجوزة لخفض الانسكاب والعمل الثابت، وR11 لمساحة عمل النداء.
// R12/R13/R14 محجوزة لحالة تشغيل Linux: argc، argv، ومؤشر حالة المخصص على الترتيب.
// R14 callee-saved وفق SysV ويجب ألا يستخدم كسجل scratch عبر نداءات Runtime المتداخلة.
// تبقى RDI/RSI/R8/R9 متاحة للتخصيص العام؛ حقائق النداء/العمل الخاص تعلم المخصص
// أنها caller-saved فلا تعيش قيمة فيها عبر حد يفسدها.
عام عرف سجلات_عمل_إكس_قابلة_للتخصيص(): متجه معرف_سجل_فعلي {
    // Appends the registers directly; no index vector is built per query.
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    ألحق(الناتج, سجل_إكس_فعلي_من(7));
    ألحق(الناتج, سجل_إكس_فعلي_من(6));
    ألحق(الناتج, سجل_إكس_فعلي_من(8));
    ألحق(الناتج, سجل_إكس_فعلي_من(9));
    أرجع الناتج;
}

عام عرف سجل_عمل_نقل_نداء_إكس(): معرف_سجل_فعلي {
    أرجع سجل_إكس_فعلي_من(11);
}

عام عرف سجلات_عمل_انسكاب_إكس(): متجه معرف_سجل_فعلي {
    // أول سجلين محجوزان لنقلات المواقع المتوازية: R10 للدورات وRAX للذاكرة.
    // RCX/RDX يكملان مجموعة العمل للعمليات ذات عدة معاملات؛ هذه السجلات الأربع
    // لا تدخل مجموعة التخصيص العام، لذلك لا تصطدم بقيم حية أثناء خفض الانسكاب.
    // Appends the registers directly; no index vector is built per query.
    دع الناتج: متغير متجه معرف_سجل_فعلي = [];
    ألحق(الناتج, سجل_إكس_فعلي_من(10));
    ألحق(الناتج, سجل_إكس_فعلي_من(0));
    ألحق(الناتج, سجل_إكس_فعلي_من(1));
    ألحق(الناتج, سجل_إكس_فعلي_من(2));
    أرجع الناتج;
}

// DWARF register numbers are ABI/debug-format facts, not encoder register ids.
عام عرف رقم_سجل_دوارف_سيستم_في_إكس(
    السجل: معرف_سجل_فعلي
): اختياري طبيعي {
    لو (السجل.القيمة == 0) { أرجع اختياري.موجود(0); };  // RAX
    لو (السجل.القيمة == 1) { أرجع اختياري.موجود(2); };  // RCX
    لو (السجل.القيمة == 2) { أرجع اختياري.موجود(1); };  // RDX
    لو (السجل.القيمة == 3) { أرجع اختياري.موجود(3); };  // RBX
    لو (السجل.القيمة == 4) { أرجع اختياري.موجود(7); };  // RSP
    لو (السجل.القيمة == 5) { أرجع اختياري.موجود(6); };  // RBP
    لو (السجل.القيمة == 6) { أرجع اختياري.موجود(4); };  // RSI
    لو (السجل.القيمة == 7) { أرجع اختياري.موجود(5); };  // RDI
    لو (السجل.القيمة >= 8 && السجل.القيمة <= 15) { أرجع اختياري.موجود(السجل.القيمة); };
    أرجع اختياري.لا_شيء();
}
