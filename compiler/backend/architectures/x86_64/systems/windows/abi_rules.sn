استورد compiler.backend.abi.abi_model;
استورد compiler.backend.abi.aggregate_leaves;
استورد compiler.backend.abi.foreign_plan;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.target.target_model;
استورد compiler.backend.architectures.x86_64.systems.windows.register_rules;

// Microsoft x64 calling convention for calls to foreign (C) functions on
// x86_64 Windows targets ("x64 calling convention", Microsoft C++ docs;
// Clang WinX86_64ABIInfo::classify):
// - the first four arguments use RCX/RDX/R8/R9 or XMM0-XMM3 by position, the
//   rest the stack, with 32 bytes of home space: the code generator assigns
//   these from the IR types;
// - a structure of 1, 2, 4 or 8 bytes travels as an integer of its size in a
//   general register or stack slot, even when it holds floats;
// - any other structure is passed by address of a caller-made copy;
// - a result structure of 1, 2, 4 or 8 bytes returns in RAX as an integer;
//   any other returns through a hidden pointer the caller passes;
// - integers are not extended (the upper bits are undefined).
// A C variadic call has the plan of a prototyped call; a floating-point
// variadic argument in one of the four register slots also travels in that
// slot's integer register (the native selector duplicates it:
// ضاعف_عائمات_متغيرة_ويندوز_إكس in x86_64/selector.sn; LLVM does so from
// the variadic IR signature). Unsupported: vector types (SultanC has none).

عرف حجم_سجل_مايكروسوفت(الحجم: طبيعي): منطقي {
    أرجع الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8;
}

عرف صنف_قيمة_مايكروسوفت_إكس_أربعة_وستون(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة قيمة_مصنفة_واجهة, خطأ_واجهة {
    دع الوصف: وصف_قيمة_خارجية;
    طابق صف_قيمة_خارجية(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الوصف := القيمة; };
    إذا (الوصف.فارغة) { أرجع نتيجة.نجح(قيمة_متجاهلة_خارجية()); };
    إذا (!الوصف.بنية) {
        أرجع نتيجة.نجح(قيمة_سلمية_خارجية(&الوصف, توسيع_عدد_واجهة.بلا_توسيع()));
    };
    إذا (حجم_سجل_مايكروسوفت(الوصف.الحجم)) {
        أرجع نتيجة.نجح(قيمة_صحيحة_واحدة_خارجية(&الوصف));
    };
    أرجع نتيجة.نجح(قيمة_غير_مباشرة_خارجية(&الوصف));
}

عام عرف صنف_واجهة_مايكروسوفت_إكس_أربعة_وستون_خارجية(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع القيم: متغير متجه قيمة_مصنفة_واجهة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعاملات) مثل طبيعي)) {
        طابق صنف_قيمة_مايكروسوفت_إكس_أربعة_وستون(الأنواع, الهدف, سجل_التخطيط, (*المعاملات)[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(القيم, القيمة); };
        ف := ف + 1;
    }
    دع قيمة_الناتج: قيمة_مصنفة_واجهة;
    طابق صنف_قيمة_مايكروسوفت_إكس_أربعة_وستون(الأنواع, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { قيمة_الناتج := القيمة; };
    أرجع نتيجة.نجح(ابن_خطة_واجهة_خارجية(المعاملات, &القيم, الناتج, &قيمة_الناتج, 8, 16));
}

// The Microsoft x64 plan with physical, positional placement, for the native
// code generator (the plan above is logical, per register class, as the LLVM
// provider assigns registers itself). Argument p (counting the hidden result
// address as argument 0 when there is one) takes RCX/RDX/R8/R9 or XMMp for
// p < 4, else the stack slot at 32 + 8 (p - 4): the caller reserves the
// 32-byte home area of the four register arguments. Integer slots use the
// Windows register rules' indexes (register_rules.sn). A structure passed
// by address (any size but 1, 2, 4 or 8 bytes) is rejected: the native call
// lowering passes structures only in their parts.
عرف موضع_مايكروسوفت_أصلي(
    الفئة: فئة_سجل_واجهة,
    الموضع: طبيعي,
    الحجم: طبيعي
): موضع_جزء_واجهة {
    إذا (الموضع < 4) {
        دع الفهرس: متغير طبيعي = الموضع;
        إذا (الفئة == فئة_سجل_واجهة.عدد_صحيح()) {
            الفهرس := فهرس_سجل_معامل_مايكروسوفت_إكس(الموضع);
        };
        دع المرجع: مرجع_سجل_واجهة = {
            الفئة: الفئة, الفهرس: الفهرس, الدور: دور_سجل_واجهة.معامل(),
            الحفظ: حفظ_سجل_واجهة.متطاير_عبر_النداء()
        };
        أرجع موضع_جزء_واجهة.سجل(المرجع);
    };
    دع المكدس: موضع_مكدس_واجهة = {
        الإزاحة: 32 + 8 * (الموضع - 4), الحجم: الحجم, المحاذاة: 8
    };
    أرجع موضع_جزء_واجهة.مكدس(المكدس);
}

عام عرف صنف_واجهة_مايكروسوفت_إكس_أربعة_وستون_أصلية(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعاملات: &متجه معرف_نوع,
    الناتج: معرف_نوع
): نتيجة خطة_دالة_واجهة, خطأ_واجهة {
    دع الخطة: متغير خطة_دالة_واجهة;
    طابق صنف_واجهة_مايكروسوفت_إكس_أربعة_وستون_خارجية(
        الأنواع, الهدف, سجل_التخطيط, المعاملات, الناتج
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الخطة := القيمة; };
    دع الموضع: متغير طبيعي = 0;
    طابق الخطة.الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع المرجع: مرجع_سجل_واجهة = {
            الفئة: فئة_سجل_واجهة.نتيجة_غير_مباشرة(),
            الفهرس: فهرس_عنوان_ناتج_مايكروسوفت_إكس(),
            الدور: دور_سجل_واجهة.عنوان_نتيجة_غير_مباشرة(),
            الحفظ: حفظ_سجل_واجهة.متطاير_عبر_النداء()
        };
        الخطة.الناتج.الموقع := موقع_تمرير_واجهة.غير_مباشر(موضع_جزء_واجهة.سجل(المرجع));
        الموضع := 1;
    }
    | _ -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الخطة.المعاملات) مثل طبيعي)) {
        دع التصنيف: تصنيف_قيمة_واجهة = الخطة.المعاملات[ف].التصنيف;
        طابق التصنيف.الطريقة مع
        | طريقة_تمرير_واجهة.متجاهل -> { }
        | طريقة_تمرير_واجهة.غير_مباشر -> {
            أرجع نتيجة.خطأ(خطأ_واجهة.نوع_غير_مدعوم(الخطة.المعاملات[ف].النوع));
        }
        | _ -> {
            إذا (التصنيف.عدد_الأجزاء != 1) {
                أرجع نتيجة.خطأ(خطأ_واجهة.نوع_غير_مدعوم(الخطة.المعاملات[ف].النوع));
            };
            دع الفئة: متغير فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
            طابق التصنيف.فئة_السجل مع
            | اختياري.موجود(ق) -> { الفئة := ق; }
            | اختياري.لا_شيء -> { };
            إذا (التصنيف.تجميعي) { الفئة := فئة_سجل_واجهة.عدد_صحيح(); };
            دع الحجم: متغير طبيعي = التصنيف.الحجم;
            إذا (الحجم == 0 || الحجم > 8) { الحجم := 8; };
            الخطة.المعاملات[ف].الموقع := موقع_تمرير_واجهة.مباشر(
                موضع_مايكروسوفت_أصلي(الفئة, الموضع, الحجم)
            );
            الموضع := الموضع + 1;
        };
        ف := ف + 1;
    }
    دع حجم_المكدس: متغير طبيعي = 32;
    إذا (الموضع > 4) { حجم_المكدس := 32 + 8 * (الموضع - 4); };
    إذا (حجم_المكدس % 16 != 0) { حجم_المكدس := حجم_المكدس + 8; };
    الخطة.حجم_مكدس_النداء := حجم_المكدس;
    الخطة.محاذاة_مكدس_النداء := 16;
    أرجع نتيجة.نجح(الخطة);
}

// The home area a Microsoft x64 caller reserves below its outgoing stack
// arguments for every call to a foreign function.
عام عرف منطقة_حجج_نداء_مايكروسوفت_إكس(): طبيعي {
    أرجع 32;
}
