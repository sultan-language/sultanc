استورد compiler.backend.architectures.x86_64.encoded_code;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.call_frame_information;
استورد compiler.backend.object.object_reference_model;

// Native x86-64 Windows machine code that no MSIR function describes: the PE
// process entry, the C entry of a closure and the stack probe of a large
// frame. Each is fixed code appended to the encoded program; the calls it
// makes are rel32 call relocations like any other.

عرف ألحق_ط32_ويندوز_إكس(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        ألحق(*البايتات, (الباقي % 256) مثل ط8);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_بايتات_ويندوز_إكس(البايتات: &متغير متجه ط8, القيم: متجه طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        ألحق(*البايتات, القيم[ف] مثل ط8);
        ف := ف + 1;
    }
}

عرف ألحق_نداء_دالة_ويندوز_إكس(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الدالة: معرف_دالة_منتقاة
): فراغ {
    ألحق((*الشفرة).البيانات, 0xE8 مثل ط8);
    دع الموضع: طبيعي = الطول((*الشفرة).البيانات) مثل طبيعي;
    ألحق_ط32_ويندوز_إكس(&متغير (*الشفرة).البيانات, 0);
    دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
        إزاحة_بايت: الموضع,
        النوع: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء(),
        الرمز: مرجع_رمز_كائن.دالة(الدالة),
        الإضافة: -4
    };
    ألحق((*الشفرة).إزاحات_النداء, الإزاحة);
}

// The PE entry point `_start` (link/coff/names.sn). The loader calls it with
// no arguments and RSP = 8 (mod 16); it aligns the stack, calls the language
// entry (SultanC convention) and passes the entry's 32-bit status to the std
// exit provider in EDI, which ends the process through ExitProcess:
//   sub rsp,40; [call module initializer]; call entry; mov edi,eax; call exit; ud2
// No C runtime runs the module initializer of an executable, so the entry
// calls it first. Returns the entry's byte range in the encoded text.
عام عرف أضف_دخول_عملية_ويندوز_إكس(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    دالة_الدخول: معرف_دالة_منتقاة,
    دالة_الخروج: معرف_دالة_منتقاة,
    المنشئ: اختياري معرف_دالة_منتقاة
): دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون {
    دع البداية: طبيعي = الطول((*الشفرة).البيانات) مثل طبيعي;
    دع بايتات_1: متجه طبيعي = [0x48, 0x83, 0xEC, 0x28];
    ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_1);
    طابق المنشئ مع
    | اختياري.موجود(المعرف) -> { ألحق_نداء_دالة_ويندوز_إكس(الشفرة, المعرف); }
    | اختياري.لا_شيء -> { };
    ألحق_نداء_دالة_ويندوز_إكس(الشفرة, دالة_الدخول);
    دع بايتات_2: متجه طبيعي = [0x89, 0xC7];
    ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_2);
    ألحق_نداء_دالة_ويندوز_إكس(الشفرة, دالة_الخروج);
    دع بايتات_3: متجه طبيعي = [0x0F, 0x0B];
    ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_3);
    دع الموضع: دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = {
        إزاحة_بايت: البداية,
        حجم_بايت: (الطول((*الشفرة).البيانات) مثل طبيعي) - البداية
    };
    أرجع الموضع;
}

// The C entry of a closure (بدائي_مدخل_سي_لدالة), as one function with the
// given id: a Windows caller (CreateThread's start routine) passes the
// closure environment in RCX. It saves every register Windows preserves that
// SultanC code may change (RBX, RBP, RDI, RSI, R12-R15, XMM6-XMM15), calls
// the closure with its environment in R15 and its code at [env], restores
// them and returns the closure's EAX:
//   push rbx,rbp,rdi,rsi,r12,r13,r14,r15; sub rsp,168
//   movdqu [rsp+16k],xmm(6+k) k=0..9; mov r15,rcx; call [rcx]
//   movdqu xmm(6+k),[rsp+16k]; add rsp,168; pop ...; ret
عام عرف أضف_مدخل_سي_ويندوز_إكس(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    المعرف: معرف_دالة_منتقاة
): فراغ {
    دع البداية: طبيعي = الطول((*الشفرة).البيانات) مثل طبيعي;
    دع بايتات_4: متجه طبيعي = [0x53, 0x55, 0x57, 0x56, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57];
    ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_4);
    دع بايتات_5: متجه طبيعي = [0x48, 0x81, 0xEC, 0xA8, 0x00, 0x00, 0x00];
    ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_5);
    دع ك: متغير طبيعي = 0;
    طالما (ك < 10) {
        دع السجل: طبيعي = 6 + ك;
        // movdqu [rsp+disp32], xmmN: F3 [REX.R] 0F 7F /r with SIB rsp.
        ألحق((*الشفرة).البيانات, 0xF3 مثل ط8);
        إذا (السجل >= 8) { ألحق((*الشفرة).البيانات, 0x44 مثل ط8); };
        دع بايتات_6: متجه طبيعي = [0x0F, 0x7F, 0x84 + (السجل % 8) * 8, 0x24];
        ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_6);
        ألحق_ط32_ويندوز_إكس(&متغير (*الشفرة).البيانات, ك * 16);
        ك := ك + 1;
    }
    دع بايتات_7: متجه طبيعي = [0x49, 0x89, 0xCF];
    ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_7);
    دع بايتات_8: متجه طبيعي = [0xFF, 0x11];
    ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_8);
    ك := 0;
    طالما (ك < 10) {
        دع السجل: طبيعي = 6 + ك;
        // movdqu xmmN, [rsp+disp32]: F3 [REX.R] 0F 6F /r.
        ألحق((*الشفرة).البيانات, 0xF3 مثل ط8);
        إذا (السجل >= 8) { ألحق((*الشفرة).البيانات, 0x44 مثل ط8); };
        دع بايتات_9: متجه طبيعي = [0x0F, 0x6F, 0x84 + (السجل % 8) * 8, 0x24];
        ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_9);
        ألحق_ط32_ويندوز_إكس(&متغير (*الشفرة).البيانات, ك * 16);
        ك := ك + 1;
    }
    دع بايتات_10: متجه طبيعي = [0x48, 0x81, 0xC4, 0xA8, 0x00, 0x00, 0x00];
    ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_10);
    دع بايتات_11: متجه طبيعي = [0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x5E, 0x5F, 0x5D, 0x5B, 0xC3];
    ألحق_بايتات_ويندوز_إكس(&متغير (*الشفرة).البيانات, بايتات_11);
    دع بلا_أحداث: متجه حدث_فك_المكدس = [];
    دع الموضع: موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
        الدالة: المعرف,
        إزاحة_بايت: البداية,
        حجم_بايت: (الطول((*الشفرة).البيانات) مثل طبيعي) - البداية,
        أحداث_فك_المكدس: بلا_أحداث
    };
    ألحق((*الشفرة).الدوال, الموضع);
}

// Stack probe of a frame of at least one page, before the prologue moves
// RSP: Windows commits the stack one guard page at a time, so every page of
// the new frame is touched in order, highest first (as __chkstk does).
// R10 and R11 hold no SultanC argument at entry.
//   mov r11,rsp; mov r10d,pages; 1: sub r11,4096; test [r11],r11; dec r10; jnz 1b
عام عرف ألحق_مسبار_مكدس_ويندوز_إكس(البايتات: &متغير متجه ط8, الحجم: طبيعي): فراغ {
    إذا (الحجم < 4096) { أرجع; };
    دع الصفحات: طبيعي = (الحجم + 4095) / 4096;
    دع بايتات_12: متجه طبيعي = [0x49, 0x89, 0xE3, 0x41, 0xBA];
    ألحق_بايتات_ويندوز_إكس(البايتات, بايتات_12);
    ألحق_ط32_ويندوز_إكس(البايتات, الصفحات);
    دع بايتات_13: متجه طبيعي = [
        0x49, 0x81, 0xEB, 0x00, 0x10, 0x00, 0x00,
        0x4D, 0x85, 0x1B,
        0x49, 0xFF, 0xCA,
        0x75, 0xF1
    ];
    ألحق_بايتات_ويندوز_إكس(البايتات, بايتات_13);
}
