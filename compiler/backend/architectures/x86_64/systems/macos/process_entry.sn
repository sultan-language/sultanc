استورد compiler.backend.architectures.x86_64.encoded_code;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.call_frame_information;
استورد compiler.backend.object.object_reference_model;
استورد compiler.runtime.primitive_runtime_abi;

// Native x86-64 macOS machine code that no MSIR function describes: dyld's
// `_main` and the C entry of a closure. SultanC's internal convention is the
// System V one, which is also the macOS C convention.

عرف ألحق_بايتات_داروين_إكس(البايتات: &متغير متجه ط8, القيم: متجه طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        ألحق(*البايتات, القيم[ف] مثل ط8);
        ف := ف + 1;
    }
}

عرف معرف_رمز_خارجي_داروين_إكس(
    الرموز_الخارجية: &متغير متجه متجه ط8,
    الاسم: &متجه ط8
): معرف_دالة_خارجية_منتقاة {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز_الخارجية) مثل طبيعي)) {
        إذا (اسما_رمز_خارجي_كائن_متساويان(&(*الرموز_الخارجية)[ف], الاسم)) {
            دع المعرف: معرف_دالة_خارجية_منتقاة = { القيمة: ف };
            أرجع المعرف;
        };
        ف := ف + 1;
    }
    دع المعرف: معرف_دالة_خارجية_منتقاة = { القيمة: الطول(*الرموز_الخارجية) مثل طبيعي };
    ألحق(*الرموز_الخارجية, انسخ_اسم_رمز_خارجي_كائن(الاسم));
    أرجع المعرف;
}

عرف ألحق_حقل_نسبي_داروين_إكس(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    النوع: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون,
    الرمز: مرجع_رمز_كائن
): فراغ {
    دع الموضع: طبيعي = الطول((*الشفرة).البيانات) مثل طبيعي;
    دع بايتات_1: متجه طبيعي = [0, 0, 0, 0];
    ألحق_بايتات_داروين_إكس(&متغير (*الشفرة).البيانات, بايتات_1);
    دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
        إزاحة_بايت: الموضع, النوع: النوع, الرمز: الرمز, الإضافة: -4
    };
    ألحق((*الشفرة).إزاحات_النداء, الإزاحة);
}

// dyld calls main(int argc, char **argv, char **envp, char **apple) after
// the module initializers; libSystem passes its result to exit. The stub
// records argc, argv and envp in the compiler-owned startup symbols and
// calls the parameterless language entry:
//   push rbp; mov edi,edi; mov [rip+argc],rdi; mov [rip+argv],rsi
//   mov [rip+envp],rdx; call entry; pop rbp; ret
عام عرف أضف_دخول_عملية_داروين_إكس(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    دالة_الدخول: معرف_دالة_منتقاة,
    الرموز_الخارجية: &متغير متجه متجه ط8
): دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون {
    دع البداية: طبيعي = الطول((*الشفرة).البيانات) مثل طبيعي;
    دع بايتات_2: متجه طبيعي = [0x55, 0x89, 0xFF];
    ألحق_بايتات_داروين_إكس(&متغير (*الشفرة).البيانات, بايتات_2);
    دع الأسماء: متجه متجه ط8 = [
        اسم_عدد_وسائط_إقلاع_أساسي(), اسم_مؤشر_وسائط_إقلاع_أساسي(), اسم_مؤشر_بيئة_إقلاع_أساسي()
    ];
    // ModRM of mov [rip+disp32], rdi / rsi / rdx.
    دع حقول: متجه طبيعي = [0x3D, 0x35, 0x15];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        دع المعرف: معرف_دالة_خارجية_منتقاة = معرف_رمز_خارجي_داروين_إكس(الرموز_الخارجية, &الأسماء[ف]);
        دع بايتات_3: متجه طبيعي = [0x48, 0x89, حقول[ف]];
        ألحق_بايتات_داروين_إكس(&متغير (*الشفرة).البيانات, بايتات_3);
        ألحق_حقل_نسبي_داروين_إكس(
            الشفرة, نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان(), مرجع_رمز_كائن.رمز_خارجي(المعرف)
        );
        ف := ف + 1;
    }
    دع بايتات_4: متجه طبيعي = [0xE8];
    ألحق_بايتات_داروين_إكس(&متغير (*الشفرة).البيانات, بايتات_4);
    ألحق_حقل_نسبي_داروين_إكس(
        الشفرة, نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء(), مرجع_رمز_كائن.دالة(دالة_الدخول)
    );
    دع بايتات_5: متجه طبيعي = [0x5D, 0xC3];
    ألحق_بايتات_داروين_إكس(&متغير (*الشفرة).البيانات, بايتات_5);
    دع الموضع: دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = {
        إزاحة_بايت: البداية,
        حجم_بايت: (الطول((*الشفرة).البيانات) مثل طبيعي) - البداية
    };
    أرجع الموضع;
}

// The C entry of a closure (pthread_create's start routine): the C caller
// passes the closure environment in RDI. It saves the registers the System V
// convention preserves that SultanC code may change, calls the closure with
// its environment in R15 and its code at [env], and returns RAX:
//   push rbx,rbp,r12,r13,r14,r15; sub rsp,8; mov r15,rdi; call [rdi]
//   add rsp,8; pop r15,r14,r13,r12,rbp,rbx; ret
عام عرف أضف_مدخل_سي_داروين_إكس(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    المعرف: معرف_دالة_منتقاة
): فراغ {
    دع البداية: طبيعي = الطول((*الشفرة).البيانات) مثل طبيعي;
    دع بايتات_6: متجه طبيعي = [
        0x53, 0x55, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57,
        0x48, 0x83, 0xEC, 0x08,
        0x49, 0x89, 0xFF,
        0xFF, 0x17,
        0x48, 0x83, 0xC4, 0x08,
        0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x5D, 0x5B, 0xC3
    ];
    ألحق_بايتات_داروين_إكس(&متغير (*الشفرة).البيانات, بايتات_6);
    دع بلا_أحداث: متجه حدث_فك_المكدس = [];
    دع الموضع: موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
        الدالة: المعرف,
        إزاحة_بايت: البداية,
        حجم_بايت: (الطول((*الشفرة).البيانات) مثل طبيعي) - البداية,
        أحداث_فك_المكدس: بلا_أحداث
    };
    ألحق((*الشفرة).الدوال, الموضع);
}
