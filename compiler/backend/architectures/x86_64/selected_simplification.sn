استورد compiler.backend.architectures.x86_64.instruction_model;
استورد compiler.backend.architectures.x86_64.selected_code;
استورد compiler.backend.architectures.x86_64.allocation_constraints;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.register_query_context;
استورد compiler.msir.identifiers;

// Simplifies a selected x86-64 function before register allocation (native
// object path only; the machine interpreter translates the selector's code
// as it is):
// - a compare whose boolean only feeds the conditional branch right after it
//   sets the flags for that branch (CMP + Jcc instead of CMP, SETcc, MOVZX,
//   TEST, Jcc), so the boolean needs no register;
// - a compare against a constant, and an ADD/SUB/AND/OR/XOR with one,
//   takes it as an immediate;
// - a load or store whose only address part is a defined global's address
//   addresses the global from RIP, and one whose only address part is an
//   address a LEA computed takes that address whole;
// - constant and global-address materializations nothing reads any more
//   are dropped.

نوع عدادات_سجلات_إكس = {
    التعريفات: متجه طبيعي,
    الاستخدامات: متجه طبيعي
};

عرف زد_عداد_سجل_إكس(العدادات: &متغير متجه طبيعي, السجل: معرف_سجل_افتراضي): فراغ {
    إذا (السجل.القيمة < (الطول(*العدادات) مثل طبيعي)) {
        (*العدادات)[السجل.القيمة] := (*العدادات)[السجل.القيمة] + 1;
    };
}

عرف عد_نقلات_حافة_إكس(
    الحزمة: &متطلبات_نقل_حافة_منتقاة,
    العدادات: &متغير عدادات_سجلات_إكس
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحزمة).النقلات) مثل طبيعي)) {
        زد_عداد_سجل_إكس(&متغير (*العدادات).الاستخدامات, (*الحزمة).النقلات[ف].المصدر);
        زد_عداد_سجل_إكس(&متغير (*العدادات).التعريفات, (*الحزمة).النقلات[ف].الوجهة);
        ف := ف + 1;
    }
}

// Definitions and uses of every virtual register, as the allocator sees them
// (its instruction facts, plus the edge moves).
عرف عد_سجلات_دالة_إكس(
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف,
    المتطايرة: &متجه معرف_سجل_فعلي
): عدادات_سجلات_إكس {
    دع العدد: طبيعي = (*الدالة).الرأس.عدد_السجلات_الافتراضية;
    دع التعريفات: متغير متجه طبيعي = [];
    دع الاستخدامات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(التعريفات, 0); ألحق(الاستخدامات, 0); ف := ف + 1; }
    دع العدادات: متغير عدادات_سجلات_إكس = { التعريفات: التعريفات, الاستخدامات: الاستخدامات };
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون = &(*الدالة).الكتل[ك].التعليمات[ت];
            دع الحقيقة: حقيقة_تعليمة_تخصيص = حقيقة_تخصيص_تعليمة_إكس(التعليمة, الهدف, المتطايرة, 0);
            دع ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الحقيقة.الاستخدامات) مثل طبيعي)) {
                زد_عداد_سجل_إكس(&متغير العدادات.الاستخدامات, الحقيقة.الاستخدامات[ع].السجل);
                ع := ع + 1;
            }
            ع := 0;
            طالما (ع < (الطول(الحقيقة.التعريفات) مثل طبيعي)) {
                زد_عداد_سجل_إكس(&متغير العدادات.التعريفات, الحقيقة.التعريفات[ع].السجل);
                ع := ع + 1;
            }
            طابق *التعليمة مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(الحزمة) -> { عد_نقلات_حافة_إكس(&الحزمة, &متغير العدادات); }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(_, الحزمة) -> { عد_نقلات_حافة_إكس(&الحزمة, &متغير العدادات); }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(_, الحزمة) -> { عد_نقلات_حافة_إكس(&الحزمة, &متغير العدادات); }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع العدادات;
}

// The bit pattern of each register defined once, by an immediate move.
عرف ثوابت_سجلات_دالة_إكس(
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس
): متجه اختياري طبيعي {
    دع الناتج: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الدالة).الرأس.عدد_السجلات_الافتراضية) { ألحق(الناتج, اختياري.لا_شيء()); ف := ف + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع السجل: متغير اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
            دع القيمة: متغير طبيعي = 0;
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, البتات) -> {
                السجل := اختياري.موجود(الوجهة); القيمة := البتات;
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, العدد) -> {
                السجل := اختياري.موجود(الوجهة); القيمة := العدد مثل طبيعي;
            }
            | _ -> { };
            طابق السجل مع
            | اختياري.موجود(س) -> {
                إذا (س.القيمة < (الطول(الناتج) مثل طبيعي) && (*العدادات).التعريفات[س.القيمة] == 1) {
                    الناتج[س.القيمة] := اختياري.موجود(القيمة);
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الناتج;
}

// A constant usable as the immediate of a compare at البتات: its pattern at
// that width, when CMP's sign-extended immediate can spell it.
عرف فوري_مقارنة_إكس(
    الثوابت: &متجه اختياري طبيعي,
    السجل: معرف_سجل_افتراضي,
    البتات: طبيعي
): اختياري طبيعي {
    إذا (السجل.القيمة >= (الطول(*الثوابت) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الثوابت)[السجل.القيمة] مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        إذا (البتات == 64) {
            إذا (القيمة < 0x80000000 || القيمة >= 0xFFFFFFFF80000000) { أرجع اختياري.موجود(القيمة); };
            أرجع اختياري.لا_شيء();
        };
        إذا (البتات == 8 || البتات == 16 || البتات == 32) {
            أرجع اختياري.موجود(القيمة & ((1 << البتات) - 1));
        };
        أرجع اختياري.لا_شيء();
    };
}

// The condition with its operands swapped (a < b is b > a).
عرف شرط_معكوس_الطرفين_إكس(الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون): شرط_إكس_ستة_وثمانون_أربعة_وستون {
    طابق الشرط مع
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي_أو_مساو -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي_أو_مساو(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي_أو_مساو -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي_أو_مساو(); }
    | _ -> { أرجع الشرط; };
}

// A compare in the form the encoder takes: register or immediate right
// operand, and its condition (swapped when the constant was on the left).
نوع مقارنة_مبسطة_إكس = {
    الأيسر: معرف_سجل_افتراضي,
    الأيمن: معرف_سجل_افتراضي,
    الفوري: اختياري طبيعي,
    الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون
};

عرف بسط_مقارنة_إكس(
    الثوابت: &متجه اختياري طبيعي,
    أ: معرف_سجل_افتراضي,
    ب: معرف_سجل_افتراضي,
    الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون,
    البتات: طبيعي
): مقارنة_مبسطة_إكس {
    طابق فوري_مقارنة_إكس(الثوابت, ب, البتات) مع
    | اختياري.موجود(الفوري) -> {
        دع الناتج: مقارنة_مبسطة_إكس = { الأيسر: أ, الأيمن: ب, الفوري: اختياري.موجود(الفوري), الشرط: الشرط };
        أرجع الناتج;
    }
    | اختياري.لا_شيء -> { };
    طابق فوري_مقارنة_إكس(الثوابت, أ, البتات) مع
    | اختياري.موجود(الفوري) -> {
        دع الناتج: مقارنة_مبسطة_إكس = {
            الأيسر: ب, الأيمن: أ, الفوري: اختياري.موجود(الفوري), الشرط: شرط_معكوس_الطرفين_إكس(الشرط)
        };
        أرجع الناتج;
    }
    | اختياري.لا_شيء -> { };
    دع الناتج: مقارنة_مبسطة_إكس = { الأيسر: أ, الأيمن: ب, الفوري: اختياري.لا_شيء(), الشرط: الشرط };
    أرجع الناتج;
}

عرف تعليمة_مقارنة_أعلام_إكس(
    المقارنة: &مقارنة_مبسطة_إكس,
    البتات: طبيعي
): تعليمة_إكس_ستة_وثمانون_أربعة_وستون {
    طابق (*المقارنة).الفوري مع
    | اختياري.موجود(الفوري) -> {
        أرجع تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_فورية_إكس((*المقارنة).الأيسر, الفوري, البتات);
    }
    | اختياري.لا_شيء -> {
        أرجع تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_بعرض_إكس((*المقارنة).الأيسر, (*المقارنة).الأيمن, البتات);
    };
}

// The operations the encoder takes an immediate right operand for
// (encoder.sn ألحق_حساب_صحيح_فوري_إكس), and those of them whose operands
// commute.
عرف عملية_فورية_إكس(العملية: حساب_صحيح_إكس_كامل): منطقي {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.جمع_ملتف -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.طرح -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.طرح_ملتف -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.و_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف عملية_تبديلية_إكس(العملية: حساب_صحيح_إكس_كامل): منطقي {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.جمع_ملتف -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.و_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The register a value-tested conditional branch tests, if that is the
// instruction.
عرف سجل_قفز_بقيمة_إكس(التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون): اختياري معرف_سجل_افتراضي {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(السجل, _) -> { أرجع اختياري.موجود(السجل); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The destination of an immediate move, if that is the instruction.
عرف وجهة_نقل_فوري_إكس(التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون): اختياري معرف_سجل_افتراضي {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Moves a compare whose boolean the block's value-tested branch reads down
// to just before that branch, over the constant moves between them (the
// edge arguments the branch passes), so the compare can set its flags.
عرف أنزل_مقارنات_كتلة_إكس(الكتلة: &متغير كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة): فراغ {
    دع العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    دع الفرع: متغير طبيعي = 0;
    دع وجد: متغير منطقي = خطأ;
    دع المختبر: متغير طبيعي = 0;
    دع ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        طابق سجل_قفز_بقيمة_إكس(&(*الكتلة).التعليمات[ت]) مع
        | اختياري.موجود(س) -> { الفرع := ت; المختبر := س.القيمة; وجد := صواب; ت := العدد; }
        | اختياري.لا_شيء -> { ت := ت + 1; };
    }
    إذا (!وجد || الفرع < 2) { أرجع; };
    // Walk up over the constant moves to the compare.
    دع المقارنة: متغير طبيعي = الفرع;
    دع ك: متغير طبيعي = الفرع;
    دع استمر: متغير منطقي = صواب;
    طالما (استمر && ك > 0) {
        ك := ك - 1;
        طابق (*الكتلة).التعليمات[ك] مع
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(الوجهة, أ, ب, _, _) -> {
            استمر := خطأ;
            إذا (الوجهة.القيمة == المختبر) {
                // None of the moves passed may define its operands.
                دع سليم: متغير منطقي = صواب;
                دع م: متغير طبيعي = ك + 1;
                طالما (م < الفرع) {
                    طابق وجهة_نقل_فوري_إكس(&(*الكتلة).التعليمات[م]) مع
                    | اختياري.موجود(و) -> {
                        إذا (و.القيمة == أ.القيمة || و.القيمة == ب.القيمة || و.القيمة == الوجهة.القيمة) { سليم := خطأ; };
                    }
                    | اختياري.لا_شيء -> { سليم := خطأ; };
                    م := م + 1;
                }
                إذا (سليم) { المقارنة := ك; };
            };
        }
        | _ -> {
            طابق وجهة_نقل_فوري_إكس(&(*الكتلة).التعليمات[ك]) مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> { استمر := خطأ; };
        };
    }
    إذا (المقارنة + 1 >= الفرع) { أرجع; };
    دع المأخوذة: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
    بدّل((*الكتلة).التعليمات[المقارنة], المأخوذة);
    دع م: متغير طبيعي = المقارنة;
    طالما (م + 1 < الفرع) {
        دع التالية: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
        بدّل((*الكتلة).التعليمات[م + 1], التالية);
        (*الكتلة).التعليمات[م] := التالية;
        م := م + 1;
    }
    (*الكتلة).التعليمات[الفرع - 1] := المأخوذة;
}

// Rewrites the compares of one block in place (same instruction count, so
// the provenance ranges keep their indices).
عرف بسط_مقارنات_كتلة_إكس(
    الكتلة: &متغير كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس,
    الثوابت: &متجه اختياري طبيعي
): فراغ {
    دع العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    دع ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        دع التالي: متغير طبيعي = ت + 1;
        دع الجديدة: متغير اختياري تعليمة_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
        طابق (*الكتلة).التعليمات[ت] مع
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(الوجهة, أ, ب, الشرط, البتات) -> {
            دع المبسطة: مقارنة_مبسطة_إكس = بسط_مقارنة_إكس(الثوابت, أ, ب, الشرط, البتات);
            دع مدموجة: متغير منطقي = خطأ;
            إذا (ت + 1 < العدد
                && الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 1
                && (*العدادات).التعريفات[الوجهة.القيمة] == 1) {
                طابق سجل_قفز_بقيمة_إكس(&(*الكتلة).التعليمات[ت + 1]) مع
                | اختياري.موجود(المختبر) -> {
                    إذا (المختبر.القيمة == الوجهة.القيمة) {
                        // Take the branch out to reuse its edge moves.
                        دع الفرع: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
                        بدّل((*الكتلة).التعليمات[ت + 1], الفرع);
                        طابق الفرع مع
                        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(_, الحزمة) -> {
                            (*الكتلة).التعليمات[ت + 1] := تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(
                                المبسطة.الشرط, الحزمة
                            );
                        }
                        | _ -> { };
                        الجديدة := اختياري.موجود(تعليمة_مقارنة_أعلام_إكس(&المبسطة, البتات));
                        مدموجة := صواب;
                        التالي := ت + 2;
                    };
                }
                | اختياري.لا_شيء -> { };
            };
            إذا (!مدموجة) {
                طابق المبسطة.الفوري مع
                | اختياري.موجود(الفوري) -> {
                    الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_فورية_إلى_منطق_إكس(
                        الوجهة, المبسطة.الأيسر, الفوري, المبسطة.الشرط, البتات
                    ));
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(العملية, الوجهة, أ, ب, البتات, بإشارة) -> {
            إذا (عملية_فورية_إكس(العملية)) {
                طابق فوري_مقارنة_إكس(الثوابت, ب, البتات) مع
                | اختياري.موجود(الفوري) -> {
                    الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_فوري_إكس(
                        العملية, الوجهة, أ, الفوري, البتات, بإشارة
                    ));
                }
                | اختياري.لا_شيء -> {
                    إذا (عملية_تبديلية_إكس(العملية)) {
                        طابق فوري_مقارنة_إكس(الثوابت, أ, البتات) مع
                        | اختياري.موجود(الفوري) -> {
                            الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_فوري_إكس(
                                العملية, الوجهة, ب, الفوري, البتات, بإشارة
                            ));
                        }
                        | اختياري.لا_شيء -> { };
                    };
                };
            };
        }
        | _ -> { };
        طابق الجديدة مع
        | اختياري.موجود(التعليمة) -> { (*الكتلة).التعليمات[ت] := التعليمة; }
        | اختياري.لا_شيء -> { };
        ت := التالي;
    }
}

// Drops immediate moves into registers nothing reads, remapping the
// provenance ranges onto the remaining instructions.
عرف احذف_ثوابت_ميتة_كتلة_إكس(
    الكتلة: &متغير كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس
): فراغ {
    دع العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    // الموقع_الجديد[i]: the new index of the first kept instruction at or
    // after old index i (length + 1 entries).
    دع الموقع_الجديد: متغير متجه طبيعي = [];
    دع الباقية: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع حذف: متغير منطقي = خطأ;
    دع ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
        دع ميتة: متغير منطقي = خطأ;
        طابق (*الكتلة).التعليمات[ت] مع
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_عام_إكس(الوجهة, _, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_إكس(الوجهة, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(الوجهة, _, _, _, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | _ -> { };
        إذا (ميتة) {
            حذف := صواب;
        } وإلا {
            دع المنقولة: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
            بدّل((*الكتلة).التعليمات[ت], المنقولة);
            ألحق(الباقية, المنقولة);
        };
        ت := ت + 1;
    }
    إذا (!حذف) {
        // Nothing dropped: put the moved instructions back as they were.
        (*الكتلة).التعليمات := الباقية;
        أرجع;
    };
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    دع الأصول: متغير متجه مدى_أصل_تعليمات = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكتلة).أصول_التعليمات) مثل طبيعي)) {
        دع المدى: متغير مدى_أصل_تعليمات = (*الكتلة).أصول_التعليمات[ف];
        دع البداية: طبيعي = المدى.البداية;
        دع النهاية: طبيعي = المدى.النهاية;
        إذا (البداية <= العدد && النهاية <= العدد) {
            المدى.البداية := الموقع_الجديد[البداية];
            المدى.النهاية := الموقع_الجديد[النهاية];
            إذا (المدى.النهاية > المدى.البداية) { ألحق(الأصول, المدى); };
        };
        ف := ف + 1;
    }
    (*الكتلة).التعليمات := الباقية;
    (*الكتلة).أصول_التعليمات := الأصول;
}

// A defined global's address used only as the plain base of loads and
// stores of 1, 2, 4 or 8 bytes: each of them addresses the global from RIP
// itself, and the address (LEA) goes. Every word of std's allocator state
// and counters is such a global.
عرف اطو_عناوين_عوام_إكس(
    الدالة: &متغير دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس
): منطقي {
    دع العدد: طبيعي = (*الدالة).الرأس.عدد_السجلات_الافتراضية;
    // The global (+ 1) whose address each register holds, 0 for others,
    // and the uses of it that fold.
    دع العام: متغير متجه طبيعي = [];
    دع المطوية: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(العام, 0); ألحق(المطوية, 0); ف := ف + 1; }
    دع أي_عام: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_عام_إكس(الوجهة, العام_, مستورد) -> {
                إذا (!مستورد && الوجهة.القيمة < العدد && (*العدادات).التعريفات[الوجهة.القيمة] == 1) {
                    العام[الوجهة.القيمة] := العام_.القيمة + 1;
                    أي_عام := صواب;
                };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    إذا (!أي_عام) { أرجع خطأ; };
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(_, العنوان, الحجم, _) -> {
                طابق أساس_عام_قابل_للطي_إكس(&العنوان, الحجم, &العام) مع
                | اختياري.موجود(س) -> { المطوية[س] := المطوية[س] + 1; }
                | اختياري.لا_شيء -> { };
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, الحجم) -> {
                طابق أساس_عام_قابل_للطي_إكس(&العنوان, الحجم, &العام) مع
                | اختياري.موجود(س) -> {
                    إذا (المصدر.القيمة != س) { المطوية[س] := المطوية[س] + 1; };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    دع تغير: متغير منطقي = خطأ;
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع الجديدة: متغير اختياري تعليمة_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الوجهة, العنوان, الحجم, بإشارة) -> {
                طابق أساس_عام_قابل_للطي_إكس(&العنوان, الحجم, &العام) مع
                | اختياري.موجود(س) -> {
                    إذا (المطوية[س] == (*العدادات).الاستخدامات[س]) {
                        دع العام_: معرف_عام_مسير = معرف_عام_مسير_من(العام[س] - 1);
                        الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_عام_إكس(
                            الوجهة, العام_, العنوان.الإزاحة, الحجم, بإشارة
                        ));
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, الحجم) -> {
                طابق أساس_عام_قابل_للطي_إكس(&العنوان, الحجم, &العام) مع
                | اختياري.موجود(س) -> {
                    إذا (المطوية[س] == (*العدادات).الاستخدامات[س] && المصدر.القيمة != س) {
                        دع العام_: معرف_عام_مسير = معرف_عام_مسير_من(العام[س] - 1);
                        الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_عام_إكس(
                            المصدر, العام_, العنوان.الإزاحة, الحجم
                        ));
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            طابق الجديدة مع
            | اختياري.موجود(ج) -> { (*الدالة).الكتل[ك].التعليمات[ت] := ج; تغير := صواب; }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع تغير;
}

// The register a load or store of 1, 2, 4 or 8 bytes takes as its only
// address part, when it holds a defined global's address.
عرف أساس_عام_قابل_للطي_إكس(
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون,
    الحجم: طبيعي,
    العام: &متجه طبيعي
): اختياري طبيعي {
    إذا (!(الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)) { أرجع اختياري.لا_شيء(); };
    إذا ((*العنوان).الإزاحة < -1048576 || (*العنوان).الإزاحة > 1048576) { أرجع اختياري.لا_شيء(); };
    طابق (*العنوان).الفهرس مع
    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
    | اختياري.لا_شيء -> { };
    طابق (*العنوان).الأساس مع
    | اختياري.موجود(الأساس) -> {
        إذا (الأساس.القيمة < (الطول(*العام) مثل طبيعي) && (*العام)[الأساس.القيمة] != 0) {
            أرجع اختياري.موجود(الأساس.القيمة);
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// An address computed into a register (LEA base + index * scale + offset)
// and used only as the plain base of loads and stores: each of them takes
// the whole address itself, and the LEA goes. The base and index must be
// defined once in the function, so they hold the same values wherever the
// address was live.
عرف اطو_عناوين_محسوبة_إكس(
    الدالة: &متغير دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس
): منطقي {
    دع العدد: طبيعي = (*الدالة).الرأس.عدد_السجلات_الافتراضية;
    // The address each register holds (when it is such a LEA's), and the
    // uses of it that fold.
    دع العناوين: متغير متجه اختياري عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع المطوية: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(العناوين, اختياري.لا_شيء()); ألحق(المطوية, 0); ف := ف + 1; }
    دع أي_عنوان: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع الوجهة_: متغير طبيعي = العدد;
            دع المحسوب: متغير اختياري عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_إكس(الوجهة, العنوان) -> {
                الوجهة_ := الوجهة.القيمة;
                المحسوب := اختياري.موجود(العنوان);
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(الوجهة, الأساس, الفهرس, الحجم, الإزاحة) -> {
                إذا (الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8) {
                    الوجهة_ := الوجهة.القيمة;
                    دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                        الأساس: اختياري.موجود(الأساس),
                        الفهرس: اختياري.موجود(الفهرس),
                        المقياس: الحجم,
                        الإزاحة: الإزاحة
                    };
                    المحسوب := اختياري.موجود(العنوان);
                };
            }
            | _ -> { };
            طابق المحسوب مع
            | اختياري.موجود(العنوان) -> {
                إذا (الوجهة_ < العدد && (*العدادات).التعريفات[الوجهة_] == 1
                    && سجل_معرف_مرة_إكس(&العنوان.الأساس, العدادات)
                    && سجل_معرف_مرة_إكس(&العنوان.الفهرس, العدادات)
                    && العنوان.الإزاحة >= -1073741824 && العنوان.الإزاحة <= 1073741824) {
                    العناوين[الوجهة_] := اختياري.موجود(العنوان);
                    أي_عنوان := صواب;
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    إذا (!أي_عنوان) { أرجع خطأ; };
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(_, العنوان, _, _) -> {
                طابق أساس_محسوب_قابل_للطي_إكس(&العنوان, &العناوين) مع
                | اختياري.موجود(س) -> { المطوية[س] := المطوية[س] + 1; }
                | اختياري.لا_شيء -> { };
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, _) -> {
                طابق أساس_محسوب_قابل_للطي_إكس(&العنوان, &العناوين) مع
                | اختياري.موجود(س) -> { إذا (المصدر.القيمة != س) { المطوية[س] := المطوية[س] + 1; }; }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    دع تغير: متغير منطقي = خطأ;
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع الجديدة: متغير اختياري تعليمة_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الوجهة, العنوان, الحجم, بإشارة) -> {
                طابق أساس_محسوب_قابل_للطي_إكس(&العنوان, &العناوين) مع
                | اختياري.موجود(س) -> {
                    إذا (المطوية[س] == (*العدادات).الاستخدامات[س]) {
                        طابق العناوين[س] مع
                        | اختياري.موجود(المحسوب) -> {
                            دع الكامل: متغير عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = المحسوب;
                            الكامل.الإزاحة := المحسوب.الإزاحة + العنوان.الإزاحة;
                            الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الوجهة, الكامل, الحجم, بإشارة));
                        }
                        | اختياري.لا_شيء -> { };
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, الحجم) -> {
                طابق أساس_محسوب_قابل_للطي_إكس(&العنوان, &العناوين) مع
                | اختياري.موجود(س) -> {
                    إذا (المطوية[س] == (*العدادات).الاستخدامات[س] && المصدر.القيمة != س) {
                        طابق العناوين[س] مع
                        | اختياري.موجود(المحسوب) -> {
                            دع الكامل: متغير عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = المحسوب;
                            الكامل.الإزاحة := المحسوب.الإزاحة + العنوان.الإزاحة;
                            الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, الكامل, الحجم));
                        }
                        | اختياري.لا_شيء -> { };
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            طابق الجديدة مع
            | اختياري.موجود(ج) -> { (*الدالة).الكتل[ك].التعليمات[ت] := ج; تغير := صواب; }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع تغير;
}

// Whether an optional address register is absent or defined once.
عرف سجل_معرف_مرة_إكس(السجل: &اختياري معرف_سجل_افتراضي, العدادات: &عدادات_سجلات_إكس): منطقي {
    طابق *السجل مع
    | اختياري.موجود(س) -> {
        أرجع س.القيمة < (الطول((*العدادات).التعريفات) مثل طبيعي) && (*العدادات).التعريفات[س.القيمة] == 1;
    }
    | اختياري.لا_شيء -> { أرجع صواب; };
}

// The register a load or store takes as its only address part, besides an
// offset that keeps the sum in range, when it holds a computed address.
عرف أساس_محسوب_قابل_للطي_إكس(
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون,
    العناوين: &متجه اختياري عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون
): اختياري طبيعي {
    إذا ((*العنوان).الإزاحة < -1073741824 || (*العنوان).الإزاحة > 1073741824) { أرجع اختياري.لا_شيء(); };
    طابق (*العنوان).الفهرس مع
    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
    | اختياري.لا_شيء -> { };
    طابق (*العنوان).الأساس مع
    | اختياري.موجود(الأساس) -> {
        إذا (الأساس.القيمة < (الطول(*العناوين) مثل طبيعي)) {
            طابق (*العناوين)[الأساس.القيمة] مع
            | اختياري.موجود(_) -> { أرجع اختياري.موجود(الأساس.القيمة); }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عام عرف بسط_دالة_إكس_منتقاة(
    الدالة: &متغير دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): فراغ {
    دع المتطايرة: متجه معرف_سجل_فعلي = سجلات_متطايرة_للهدف(الهدف);
    دع العدادات: عدادات_سجلات_إكس = عد_سجلات_دالة_إكس(الدالة, الهدف, &المتطايرة);
    دع الثوابت: متجه اختياري طبيعي = ثوابت_سجلات_دالة_إكس(الدالة, &العدادات);
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        أنزل_مقارنات_كتلة_إكس(&متغير (*الدالة).الكتل[ك]);
        بسط_مقارنات_كتلة_إكس(&متغير (*الدالة).الكتل[ك], &العدادات, &الثوابت);
        ك := ك + 1;
    }
    اطو_عناوين_عوام_إكس(الدالة, &العدادات);
    اطو_عناوين_محسوبة_إكس(الدالة, &العدادات);
    دع بعد_التبسيط: عدادات_سجلات_إكس = عد_سجلات_دالة_إكس(الدالة, الهدف, &المتطايرة);
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        احذف_ثوابت_ميتة_كتلة_إكس(&متغير (*الدالة).الكتل[ك], &بعد_التبسيط);
        ك := ك + 1;
    }
}
