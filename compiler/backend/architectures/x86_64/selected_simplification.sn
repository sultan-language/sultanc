استورد compiler.backend.architectures.x86_64.instruction_model;
استورد compiler.backend.architectures.x86_64.selected_code;
استورد compiler.backend.architectures.x86_64.allocation_constraints;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.register_query_context;
استورد compiler.msir.identifiers;
استورد compiler.msir.checked_arithmetic;

// Simplifies a selected x86-64 function before register allocation (native
// object path only; the machine interpreter translates the selector's code
// as it is):
// - a compare whose boolean only feeds the conditional branch right after it
//   sets the flags for that branch (CMP + Jcc instead of CMP, SETcc, MOVZX,
//   TEST, Jcc), so the boolean needs no register;
// - a compare against a constant, and an ADD/SUB/AND/OR/XOR with one,
//   takes it as an immediate;
// - a load or store whose only address part is a defined global's address
//   addresses the global from RIP, and one whose only address part is an
//   address a LEA computed takes that address whole;
// - constant and global-address materializations nothing reads any more
//   are dropped;
// - a checked add, subtract or multiply that reports its overflow
//   (msir/checked_arithmetic.sn) is one flag-setting operation and a Jcc on
//   OF or CF to the report block (ادمج_حسابات_بمخرج_إكس); it runs first,
//   so the operation then takes an immediate as any other.

نوع عدادات_سجلات_إكس = {
    التعريفات: متجه طبيعي,
    الاستخدامات: متجه طبيعي
};

عرف زد_عداد_سجل_إكس(العدادات: &متغير متجه طبيعي, السجل: معرف_سجل_افتراضي): فراغ {
    إذا (السجل.القيمة < (الطول(*العدادات) مثل طبيعي)) {
        (*العدادات)[السجل.القيمة] := (*العدادات)[السجل.القيمة] + 1;
    };
}

عرف عد_نقلات_حافة_إكس(
    الحزمة: &متطلبات_نقل_حافة_منتقاة,
    العدادات: &متغير عدادات_سجلات_إكس
): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحزمة).النقلات) مثل طبيعي)) {
        زد_عداد_سجل_إكس(&متغير (*العدادات).الاستخدامات, (*الحزمة).النقلات[ف].المصدر);
        زد_عداد_سجل_إكس(&متغير (*العدادات).التعريفات, (*الحزمة).النقلات[ف].الوجهة);
        ف := ف + 1;
    }
}

// Definitions and uses of every virtual register, as the allocator sees them
// (its instruction facts, plus the edge moves).
عرف عد_سجلات_دالة_إكس(
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف,
    المتطايرة: &متجه معرف_سجل_فعلي
): عدادات_سجلات_إكس {
    ليكن العدد: طبيعي = (*الدالة).الرأس.عدد_السجلات_الافتراضية;
    ليكن التعريفات: متغير متجه طبيعي = [];
    ليكن الاستخدامات: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(التعريفات, 0); ألحق(الاستخدامات, 0); ف := ف + 1; }
    ليكن العدادات: متغير عدادات_سجلات_إكس = { التعريفات: التعريفات, الاستخدامات: الاستخدامات };
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ليكن التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون = &(*الدالة).الكتل[ك].التعليمات[ت];
            ليكن الحقيقة: حقيقة_تعليمة_تخصيص = حقيقة_تخصيص_تعليمة_إكس(التعليمة, الهدف, المتطايرة, 0);
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الحقيقة.الاستخدامات) مثل طبيعي)) {
                زد_عداد_سجل_إكس(&متغير العدادات.الاستخدامات, الحقيقة.الاستخدامات[ع].السجل);
                ع := ع + 1;
            }
            ع := 0;
            طالما (ع < (الطول(الحقيقة.التعريفات) مثل طبيعي)) {
                زد_عداد_سجل_إكس(&متغير العدادات.التعريفات, الحقيقة.التعريفات[ع].السجل);
                ع := ع + 1;
            }
            طابق *التعليمة مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(الحزمة) -> { عد_نقلات_حافة_إكس(&الحزمة, &متغير العدادات); }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(_, الحزمة) -> { عد_نقلات_حافة_إكس(&الحزمة, &متغير العدادات); }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(_, الحزمة) -> { عد_نقلات_حافة_إكس(&الحزمة, &متغير العدادات); }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع العدادات;
}

// The bit pattern of each register defined once, by an immediate move.
عرف ثوابت_سجلات_دالة_إكس(
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس
): متجه اختياري طبيعي {
    ليكن الناتج: متغير متجه اختياري طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (*الدالة).الرأس.عدد_السجلات_الافتراضية) { ألحق(الناتج, اختياري.لا_شيء()); ف := ف + 1; }
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ليكن السجل: متغير اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
            ليكن القيمة: متغير طبيعي = 0;
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, البتات) -> {
                السجل := اختياري.موجود(الوجهة); القيمة := البتات;
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, العدد) -> {
                السجل := اختياري.موجود(الوجهة); القيمة := العدد مثل طبيعي;
            }
            | _ -> { };
            طابق السجل مع
            | اختياري.موجود(س) -> {
                إذا (س.القيمة < (الطول(الناتج) مثل طبيعي) && (*العدادات).التعريفات[س.القيمة] == 1) {
                    الناتج[س.القيمة] := اختياري.موجود(القيمة);
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الناتج;
}

// A constant usable as the immediate of a compare at البتات: its pattern at
// that width, when CMP's sign-extended immediate can spell it.
عرف فوري_مقارنة_إكس(
    الثوابت: &متجه اختياري طبيعي,
    السجل: معرف_سجل_افتراضي,
    البتات: طبيعي
): اختياري طبيعي {
    إذا (السجل.القيمة >= (الطول(*الثوابت) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الثوابت)[السجل.القيمة] مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        إذا (البتات == 64) {
            إذا (القيمة < 0x80000000 || القيمة >= 0xFFFFFFFF80000000) { أرجع اختياري.موجود(القيمة); };
            أرجع اختياري.لا_شيء();
        };
        إذا (البتات == 8 || البتات == 16 || البتات == 32) {
            أرجع اختياري.موجود(القيمة & ((1 << البتات) - 1));
        };
        أرجع اختياري.لا_شيء();
    };
}

// The condition with its operands swapped (a < b is b > a).
عرف شرط_معكوس_الطرفين_إكس(الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون): شرط_إكس_ستة_وثمانون_أربعة_وستون {
    طابق الشرط مع
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي_أو_مساو -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي_أو_مساو(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي(); }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي_أو_مساو -> { أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي_أو_مساو(); }
    | _ -> { أرجع الشرط; };
}

// A compare in the form the encoder takes: register or immediate right
// operand, and its condition (swapped when the constant was on the left).
نوع مقارنة_مبسطة_إكس = {
    الأيسر: معرف_سجل_افتراضي,
    الأيمن: معرف_سجل_افتراضي,
    الفوري: اختياري طبيعي,
    الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون
};

عرف بسط_مقارنة_إكس(
    الثوابت: &متجه اختياري طبيعي,
    أ: معرف_سجل_افتراضي,
    ب: معرف_سجل_افتراضي,
    الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون,
    البتات: طبيعي
): مقارنة_مبسطة_إكس {
    طابق فوري_مقارنة_إكس(الثوابت, ب, البتات) مع
    | اختياري.موجود(الفوري) -> {
        ليكن الناتج: مقارنة_مبسطة_إكس = { الأيسر: أ, الأيمن: ب, الفوري: اختياري.موجود(الفوري), الشرط: الشرط };
        أرجع الناتج;
    }
    | اختياري.لا_شيء -> { };
    طابق فوري_مقارنة_إكس(الثوابت, أ, البتات) مع
    | اختياري.موجود(الفوري) -> {
        ليكن الناتج: مقارنة_مبسطة_إكس = {
            الأيسر: ب, الأيمن: أ, الفوري: اختياري.موجود(الفوري), الشرط: شرط_معكوس_الطرفين_إكس(الشرط)
        };
        أرجع الناتج;
    }
    | اختياري.لا_شيء -> { };
    ليكن الناتج: مقارنة_مبسطة_إكس = { الأيسر: أ, الأيمن: ب, الفوري: اختياري.لا_شيء(), الشرط: الشرط };
    أرجع الناتج;
}

عرف تعليمة_مقارنة_أعلام_إكس(
    المقارنة: &مقارنة_مبسطة_إكس,
    البتات: طبيعي
): تعليمة_إكس_ستة_وثمانون_أربعة_وستون {
    طابق (*المقارنة).الفوري مع
    | اختياري.موجود(الفوري) -> {
        أرجع تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_فورية_إكس((*المقارنة).الأيسر, الفوري, البتات);
    }
    | اختياري.لا_شيء -> {
        أرجع تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_بعرض_إكس((*المقارنة).الأيسر, (*المقارنة).الأيمن, البتات);
    };
}

// The operations the encoder takes an immediate right operand for
// (encoder.sn ألحق_حساب_صحيح_فوري_إكس), and those of them whose operands
// commute.
عرف عملية_فورية_إكس(العملية: حساب_صحيح_إكس_كامل): منطقي {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.جمع_ملتف -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.طرح -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.طرح_ملتف -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.و_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف عملية_تبديلية_إكس(العملية: حساب_صحيح_إكس_كامل): منطقي {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.جمع_ملتف -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.و_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف ضرب_ملتف_إكس(العملية: حساب_صحيح_إكس_كامل): منطقي {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.ضرب_ملتف -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The register a value-tested conditional branch tests, if that is the
// instruction.
عرف سجل_قفز_بقيمة_إكس(التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون): اختياري معرف_سجل_افتراضي {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(السجل, _) -> { أرجع اختياري.موجود(السجل); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The destination of an immediate move, if that is the instruction.
عرف وجهة_نقل_فوري_إكس(التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون): اختياري معرف_سجل_افتراضي {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Moves a compare whose boolean the block's value-tested branch reads down
// to just before that branch, over the constant moves between them (the
// edge arguments the branch passes), so the compare can set its flags.
عرف أنزل_مقارنات_كتلة_إكس(الكتلة: &متغير كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    ليكن الفرع: متغير طبيعي = 0;
    ليكن وجد: متغير منطقي = خطأ;
    ليكن المختبر: متغير طبيعي = 0;
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        طابق سجل_قفز_بقيمة_إكس(&(*الكتلة).التعليمات[ت]) مع
        | اختياري.موجود(س) -> { الفرع := ت; المختبر := س.القيمة; وجد := صواب; ت := العدد; }
        | اختياري.لا_شيء -> { ت := ت + 1; };
    }
    إذا (!وجد || الفرع < 2) { أرجع; };
    // Walk up over the constant moves to the compare.
    ليكن المقارنة: متغير طبيعي = الفرع;
    ليكن ك: متغير طبيعي = الفرع;
    ليكن استمر: متغير منطقي = صواب;
    طالما (استمر && ك > 0) {
        ك := ك - 1;
        طابق (*الكتلة).التعليمات[ك] مع
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(الوجهة, أ, ب, _, _) -> {
            استمر := خطأ;
            إذا (الوجهة.القيمة == المختبر) {
                // None of the moves passed may define its operands.
                ليكن سليم: متغير منطقي = صواب;
                ليكن م: متغير طبيعي = ك + 1;
                طالما (م < الفرع) {
                    طابق وجهة_نقل_فوري_إكس(&(*الكتلة).التعليمات[م]) مع
                    | اختياري.موجود(و) -> {
                        إذا (و.القيمة == أ.القيمة || و.القيمة == ب.القيمة || و.القيمة == الوجهة.القيمة) { سليم := خطأ; };
                    }
                    | اختياري.لا_شيء -> { سليم := خطأ; };
                    م := م + 1;
                }
                إذا (سليم) { المقارنة := ك; };
            };
        }
        | _ -> {
            طابق وجهة_نقل_فوري_إكس(&(*الكتلة).التعليمات[ك]) مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> { استمر := خطأ; };
        };
    }
    إذا (المقارنة + 1 >= الفرع) { أرجع; };
    ليكن المأخوذة: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
    بدّل((*الكتلة).التعليمات[المقارنة], المأخوذة);
    ليكن م: متغير طبيعي = المقارنة;
    طالما (م + 1 < الفرع) {
        ليكن التالية: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
        بدّل((*الكتلة).التعليمات[م + 1], التالية);
        (*الكتلة).التعليمات[م] := التالية;
        م := م + 1;
    }
    (*الكتلة).التعليمات[الفرع - 1] := المأخوذة;
}

// Rewrites the compares of one block in place (same instruction count, so
// the provenance ranges keep their indices).
عرف بسط_مقارنات_كتلة_إكس(
    الكتلة: &متغير كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس,
    الثوابت: &متجه اختياري طبيعي,
    تحسين: منطقي
): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        ليكن التالي: متغير طبيعي = ت + 1;
        ليكن الجديدة: متغير اختياري تعليمة_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
        طابق (*الكتلة).التعليمات[ت] مع
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(الوجهة, أ, ب, الشرط, البتات) -> {
            ليكن المبسطة: مقارنة_مبسطة_إكس = بسط_مقارنة_إكس(الثوابت, أ, ب, الشرط, البتات);
            ليكن مدموجة: متغير منطقي = خطأ;
            إذا (ت + 1 < العدد
                && الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 1
                && (*العدادات).التعريفات[الوجهة.القيمة] == 1) {
                طابق سجل_قفز_بقيمة_إكس(&(*الكتلة).التعليمات[ت + 1]) مع
                | اختياري.موجود(المختبر) -> {
                    إذا (المختبر.القيمة == الوجهة.القيمة) {
                        // Take the branch out to reuse its edge moves.
                        ليكن الفرع: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
                        بدّل((*الكتلة).التعليمات[ت + 1], الفرع);
                        طابق الفرع مع
                        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(_, الحزمة) -> {
                            (*الكتلة).التعليمات[ت + 1] := تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(
                                المبسطة.الشرط, الحزمة
                            );
                        }
                        | _ -> { };
                        الجديدة := اختياري.موجود(تعليمة_مقارنة_أعلام_إكس(&المبسطة, البتات));
                        مدموجة := صواب;
                        التالي := ت + 2;
                    };
                }
                | اختياري.لا_شيء -> { };
            };
            إذا (!مدموجة) {
                طابق المبسطة.الفوري مع
                | اختياري.موجود(الفوري) -> {
                    الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_فورية_إلى_منطق_إكس(
                        الوجهة, المبسطة.الأيسر, الفوري, المبسطة.الشرط, البتات
                    ));
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(العملية, الوجهة, أ, ب, البتات, بإشارة) -> {
            إذا (ضرب_ملتف_إكس(العملية) && البتات == 64) {
                // A 64-bit wrapping multiply by a constant: IMUL r, r/m,
                // imm (which sets OF, so a fused checked multiply keeps its
                // JO), or, not fused and above -O0, LEA for 2, 3, 5 and 9.
                ليكن الثابت: متغير اختياري طبيعي = فوري_مقارنة_إكس(الثوابت, ب, 64);
                ليكن المصدر: متغير معرف_سجل_افتراضي = أ;
                طابق الثابت مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> { الثابت := فوري_مقارنة_إكس(الثوابت, أ, 64); المصدر := ب; };
                ليكن مدموجة: متغير منطقي = خطأ;
                إذا (ت + 1 < العدد) {
                    طابق (*الكتلة).التعليمات[ت + 1] مع
                    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(_, _) -> { مدموجة := صواب; }
                    | _ -> { };
                };
                طابق الثابت مع
                | اختياري.موجود(ك) -> {
                    إذا (!مدموجة && تحسين && (ك == 2 || ك == 3 || ك == 5 || ك == 9)) {
                        ليكن المقياس: طبيعي = ك - 1;
                        ليكن المقياس_: متغير طبيعي = المقياس;
                        إذا (ك == 2) { المقياس_ := 1; };
                        الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(
                            الوجهة, المصدر, المصدر, المقياس_, 0
                        ));
                    } وإلا {
                        الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_فوري_إكس(
                            العملية, الوجهة, المصدر, ك, البتات, بإشارة
                        ));
                    };
                }
                | اختياري.لا_شيء -> { };
            };
            إذا (عملية_فورية_إكس(العملية)) {
                طابق فوري_مقارنة_إكس(الثوابت, ب, البتات) مع
                | اختياري.موجود(الفوري) -> {
                    الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_فوري_إكس(
                        العملية, الوجهة, أ, الفوري, البتات, بإشارة
                    ));
                }
                | اختياري.لا_شيء -> {
                    إذا (عملية_تبديلية_إكس(العملية)) {
                        طابق فوري_مقارنة_إكس(الثوابت, أ, البتات) مع
                        | اختياري.موجود(الفوري) -> {
                            الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_فوري_إكس(
                                العملية, الوجهة, ب, الفوري, البتات, بإشارة
                            ));
                        }
                        | اختياري.لا_شيء -> { };
                    };
                };
            };
        }
        | _ -> { };
        طابق الجديدة مع
        | اختياري.موجود(التعليمة) -> { (*الكتلة).التعليمات[ت] := التعليمة; }
        | اختياري.لا_شيء -> { };
        ت := التالي;
    }
}

// Drops immediate moves into registers nothing reads, remapping the
// provenance ranges onto the remaining instructions.
عرف احذف_ثوابت_ميتة_كتلة_إكس(
    الكتلة: &متغير كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس
): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    // الموقع_الجديد[i]: the new index of the first kept instruction at or
    // after old index i (length + 1 entries).
    ليكن الموقع_الجديد: متغير متجه طبيعي = [];
    ليكن الباقية: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [];
    ليكن حذف: متغير منطقي = خطأ;
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
        ليكن ميتة: متغير منطقي = خطأ;
        طابق (*الكتلة).التعليمات[ت] مع
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_عام_إكس(الوجهة, _, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_إكس(الوجهة, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(الوجهة, _, _, _, _) -> {
            ميتة := الوجهة.القيمة < (الطول((*العدادات).الاستخدامات) مثل طبيعي)
                && (*العدادات).الاستخدامات[الوجهة.القيمة] == 0;
        }
        | _ -> { };
        إذا (ميتة) {
            حذف := صواب;
        } وإلا {
            ليكن المنقولة: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
            بدّل((*الكتلة).التعليمات[ت], المنقولة);
            ألحق(الباقية, المنقولة);
        };
        ت := ت + 1;
    }
    إذا (!حذف) {
        // Nothing dropped: put the moved instructions back as they were.
        (*الكتلة).التعليمات := الباقية;
        أرجع;
    };
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    ليكن الأصول: متغير متجه مدى_أصل_تعليمات = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكتلة).أصول_التعليمات) مثل طبيعي)) {
        ليكن المدى: متغير مدى_أصل_تعليمات = (*الكتلة).أصول_التعليمات[ف];
        ليكن البداية: طبيعي = المدى.البداية;
        ليكن النهاية: طبيعي = المدى.النهاية;
        إذا (البداية <= العدد && النهاية <= العدد) {
            المدى.البداية := الموقع_الجديد[البداية];
            المدى.النهاية := الموقع_الجديد[النهاية];
            إذا (المدى.النهاية > المدى.البداية) { ألحق(الأصول, المدى); };
        };
        ف := ف + 1;
    }
    (*الكتلة).التعليمات := الباقية;
    (*الكتلة).أصول_التعليمات := الأصول;
}

// A defined global's address used only as the plain base of loads and
// stores of 1, 2, 4 or 8 bytes: each of them addresses the global from RIP
// itself, and the address (LEA) goes. Every word of std's allocator state
// and counters is such a global.
عرف اطو_عناوين_عوام_إكس(
    الدالة: &متغير دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس
): منطقي {
    ليكن العدد: طبيعي = (*الدالة).الرأس.عدد_السجلات_الافتراضية;
    // The global (+ 1) whose address each register holds, 0 for others,
    // and the uses of it that fold.
    ليكن العام: متغير متجه طبيعي = [];
    ليكن المطوية: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(العام, 0); ألحق(المطوية, 0); ف := ف + 1; }
    ليكن أي_عام: متغير منطقي = خطأ;
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_عام_إكس(الوجهة, العام_, مستورد) -> {
                إذا (!مستورد && الوجهة.القيمة < العدد && (*العدادات).التعريفات[الوجهة.القيمة] == 1) {
                    العام[الوجهة.القيمة] := العام_.القيمة + 1;
                    أي_عام := صواب;
                };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    إذا (!أي_عام) { أرجع خطأ; };
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(_, العنوان, الحجم, _) -> {
                طابق أساس_عام_قابل_للطي_إكس(&العنوان, الحجم, &العام) مع
                | اختياري.موجود(س) -> { المطوية[س] := المطوية[س] + 1; }
                | اختياري.لا_شيء -> { };
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, الحجم) -> {
                طابق أساس_عام_قابل_للطي_إكس(&العنوان, الحجم, &العام) مع
                | اختياري.موجود(س) -> {
                    إذا (المصدر.القيمة != س) { المطوية[س] := المطوية[س] + 1; };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    ليكن تغير: متغير منطقي = خطأ;
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ليكن الجديدة: متغير اختياري تعليمة_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الوجهة, العنوان, الحجم, بإشارة) -> {
                طابق أساس_عام_قابل_للطي_إكس(&العنوان, الحجم, &العام) مع
                | اختياري.موجود(س) -> {
                    إذا (المطوية[س] == (*العدادات).الاستخدامات[س]) {
                        ليكن العام_: معرف_عام_مسير = معرف_عام_مسير_من(العام[س] - 1);
                        الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_عام_إكس(
                            الوجهة, العام_, العنوان.الإزاحة, الحجم, بإشارة
                        ));
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, الحجم) -> {
                طابق أساس_عام_قابل_للطي_إكس(&العنوان, الحجم, &العام) مع
                | اختياري.موجود(س) -> {
                    إذا (المطوية[س] == (*العدادات).الاستخدامات[س] && المصدر.القيمة != س) {
                        ليكن العام_: معرف_عام_مسير = معرف_عام_مسير_من(العام[س] - 1);
                        الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_عام_إكس(
                            المصدر, العام_, العنوان.الإزاحة, الحجم
                        ));
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            طابق الجديدة مع
            | اختياري.موجود(ج) -> { (*الدالة).الكتل[ك].التعليمات[ت] := ج; تغير := صواب; }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع تغير;
}

// The register a load or store of 1, 2, 4 or 8 bytes takes as its only
// address part, when it holds a defined global's address.
عرف أساس_عام_قابل_للطي_إكس(
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون,
    الحجم: طبيعي,
    العام: &متجه طبيعي
): اختياري طبيعي {
    إذا (!(الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)) { أرجع اختياري.لا_شيء(); };
    إذا ((*العنوان).الإزاحة < -1048576 || (*العنوان).الإزاحة > 1048576) { أرجع اختياري.لا_شيء(); };
    طابق (*العنوان).الفهرس مع
    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
    | اختياري.لا_شيء -> { };
    طابق (*العنوان).الأساس مع
    | اختياري.موجود(الأساس) -> {
        إذا (الأساس.القيمة < (الطول(*العام) مثل طبيعي) && (*العام)[الأساس.القيمة] != 0) {
            أرجع اختياري.موجود(الأساس.القيمة);
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// An address computed into a register (LEA base + index * scale + offset)
// and used only as the plain base of loads and stores: each of them takes
// the whole address itself, and the LEA goes. The base and index must be
// defined once in the function, so they hold the same values wherever the
// address was live.
عرف اطو_عناوين_محسوبة_إكس(
    الدالة: &متغير دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدادات: &عدادات_سجلات_إكس
): منطقي {
    ليكن العدد: طبيعي = (*الدالة).الرأس.عدد_السجلات_الافتراضية;
    // The address each register holds (when it is such a LEA's), and the
    // uses of it that fold.
    ليكن العناوين: متغير متجه اختياري عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = [];
    ليكن المطوية: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(العناوين, اختياري.لا_شيء()); ألحق(المطوية, 0); ف := ف + 1; }
    ليكن أي_عنوان: متغير منطقي = خطأ;
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ليكن الوجهة_: متغير طبيعي = العدد;
            ليكن المحسوب: متغير اختياري عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_إكس(الوجهة, العنوان) -> {
                الوجهة_ := الوجهة.القيمة;
                المحسوب := اختياري.موجود(العنوان);
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(الوجهة, الأساس, الفهرس, الحجم, الإزاحة) -> {
                إذا (الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8) {
                    الوجهة_ := الوجهة.القيمة;
                    ليكن العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                        الأساس: اختياري.موجود(الأساس),
                        الفهرس: اختياري.موجود(الفهرس),
                        المقياس: الحجم,
                        الإزاحة: الإزاحة
                    };
                    المحسوب := اختياري.موجود(العنوان);
                };
            }
            | _ -> { };
            طابق المحسوب مع
            | اختياري.موجود(العنوان) -> {
                إذا (الوجهة_ < العدد && (*العدادات).التعريفات[الوجهة_] == 1
                    && سجل_معرف_مرة_إكس(&العنوان.الأساس, العدادات)
                    && سجل_معرف_مرة_إكس(&العنوان.الفهرس, العدادات)
                    && العنوان.الإزاحة >= -1073741824 && العنوان.الإزاحة <= 1073741824) {
                    العناوين[الوجهة_] := اختياري.موجود(العنوان);
                    أي_عنوان := صواب;
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    إذا (!أي_عنوان) { أرجع خطأ; };
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(_, العنوان, _, _) -> {
                طابق أساس_محسوب_قابل_للطي_إكس(&العنوان, &العناوين) مع
                | اختياري.موجود(س) -> { المطوية[س] := المطوية[س] + 1; }
                | اختياري.لا_شيء -> { };
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, _) -> {
                طابق أساس_محسوب_قابل_للطي_إكس(&العنوان, &العناوين) مع
                | اختياري.موجود(س) -> { إذا (المصدر.القيمة != س) { المطوية[س] := المطوية[س] + 1; }; }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    ليكن تغير: متغير منطقي = خطأ;
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ليكن الجديدة: متغير اختياري تعليمة_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الوجهة, العنوان, الحجم, بإشارة) -> {
                طابق أساس_محسوب_قابل_للطي_إكس(&العنوان, &العناوين) مع
                | اختياري.موجود(س) -> {
                    إذا (المطوية[س] == (*العدادات).الاستخدامات[س]) {
                        طابق العناوين[س] مع
                        | اختياري.موجود(المحسوب) -> {
                            ليكن الكامل: متغير عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = المحسوب;
                            الكامل.الإزاحة := المحسوب.الإزاحة + العنوان.الإزاحة;
                            الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الوجهة, الكامل, الحجم, بإشارة));
                        }
                        | اختياري.لا_شيء -> { };
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, الحجم) -> {
                طابق أساس_محسوب_قابل_للطي_إكس(&العنوان, &العناوين) مع
                | اختياري.موجود(س) -> {
                    إذا (المطوية[س] == (*العدادات).الاستخدامات[س] && المصدر.القيمة != س) {
                        طابق العناوين[س] مع
                        | اختياري.موجود(المحسوب) -> {
                            ليكن الكامل: متغير عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = المحسوب;
                            الكامل.الإزاحة := المحسوب.الإزاحة + العنوان.الإزاحة;
                            الجديدة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, الكامل, الحجم));
                        }
                        | اختياري.لا_شيء -> { };
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            طابق الجديدة مع
            | اختياري.موجود(ج) -> { (*الدالة).الكتل[ك].التعليمات[ت] := ج; تغير := صواب; }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع تغير;
}

// Whether an optional address register is absent or defined once.
عرف سجل_معرف_مرة_إكس(السجل: &اختياري معرف_سجل_افتراضي, العدادات: &عدادات_سجلات_إكس): منطقي {
    طابق *السجل مع
    | اختياري.موجود(س) -> {
        أرجع س.القيمة < (الطول((*العدادات).التعريفات) مثل طبيعي) && (*العدادات).التعريفات[س.القيمة] == 1;
    }
    | اختياري.لا_شيء -> { أرجع صواب; };
}

// The register a load or store takes as its only address part, besides an
// offset that keeps the sum in range, when it holds a computed address.
عرف أساس_محسوب_قابل_للطي_إكس(
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون,
    العناوين: &متجه اختياري عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون
): اختياري طبيعي {
    إذا ((*العنوان).الإزاحة < -1073741824 || (*العنوان).الإزاحة > 1073741824) { أرجع اختياري.لا_شيء(); };
    طابق (*العنوان).الفهرس مع
    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
    | اختياري.لا_شيء -> { };
    طابق (*العنوان).الأساس مع
    | اختياري.موجود(الأساس) -> {
        إذا (الأساس.القيمة < (الطول(*العناوين) مثل طبيعي)) {
            طابق (*العناوين)[الأساس.القيمة] مع
            | اختياري.موجود(_) -> { أرجع اختياري.موجود(الأساس.القيمة); }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// ---- Checked arithmetic with an overflow exit --------------------------------------
//
// A checked add, subtract or multiply that runtime_checks.sn made report its
// overflow (msir/checked_arithmetic.sn) becomes one flag-setting operation
// and one branch. K, which ended in the overflow test and a branch to the
// report block or C, ends instead in the operation's wrapping form (ADD, SUB
// or IMUL at the operation's width, which set OF and CF exactly as the
// checked form tests them; the width's canonical zero extension after them
// leaves the flags alone), a Jcc on OF (signed) or CF (unsigned add's carry,
// unsigned subtract's borrow) to the report block, and a jump to C. C loses
// its first instruction, the checked operation, whose register the fused
// operation now defines. The test's own instructions go, and the blocks only
// the test runs (a 64-bit multiply's slow path) become a lone UD2 nothing
// branches to. A multiply IMUL's flags do not decide (unsigned, or narrower
// than 64 bits: the selector multiplies those at 64 bits) keeps its test.
// The report block and its call are untouched, so the report is the same.

// The register an instruction of a test defines, when it is one a test owns:
// a constant, a move, a compare, a conversion, wrapping or bitwise
// arithmetic.
عرف وجهة_تعليمة_اختبار_إكس(التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون): اختياري معرف_سجل_افتراضي {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(الوجهة, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(الوجهة, _, _, _, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_صحيح_كامل_إكس(_, الوجهة, _, _, _, _) -> { أرجع اختياري.موجود(الوجهة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(العملية, الوجهة, _, _, _, _) -> {
        طابق العملية مع
        | حساب_صحيح_إكس_كامل.جمع_ملتف -> { أرجع اختياري.موجود(الوجهة); }
        | حساب_صحيح_إكس_كامل.طرح_ملتف -> { أرجع اختياري.موجود(الوجهة); }
        | حساب_صحيح_إكس_كامل.ضرب_ملتف -> { أرجع اختياري.موجود(الوجهة); }
        | حساب_صحيح_إكس_كامل.أو_بتي -> { أرجع اختياري.موجود(الوجهة); }
        | حساب_صحيح_إكس_كامل.أو_حصري -> { أرجع اختياري.موجود(الوجهة); }
        | حساب_صحيح_إكس_كامل.و_بتي -> { أرجع اختياري.موجود(الوجهة); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Whether the register holds a value only an overflow test reads.
عرف قيمة_اختبار_إكس(الحسابات: &حسابات_بمخرج_تجاوز_مسير, السجل: معرف_سجل_افتراضي): منطقي {
    أرجع السجل.القيمة < (الطول((*الحسابات).قيم_الاختبار) مثل طبيعي) && (*الحسابات).قيم_الاختبار[السجل.القيمة];
}

// Whether السجل is one of السجلات.
عرف سجل_من_إكس(السجلات: &متجه معرف_سجل_افتراضي, السجل: معرف_سجل_افتراضي): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السجلات) مثل طبيعي)) {
        إذا ((*السجلات)[ف].القيمة == السجل.القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// A block's provenance ranges after its instructions moved: old index i now
// starts at الموقع_الجديد[i] (one entry per old index and one for the end).
// A range left empty goes.
عرف أعد_مديات_الأصول_إكس(
    الأصول: &متجه مدى_أصل_تعليمات,
    الموقع_الجديد: &متجه طبيعي
): متجه مدى_أصل_تعليمات {
    ليكن العدد: طبيعي = (الطول(*الموقع_الجديد) مثل طبيعي) - 1;
    ليكن الناتج: متغير متجه مدى_أصل_تعليمات = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأصول) مثل طبيعي)) {
        ليكن المدى: متغير مدى_أصل_تعليمات = (*الأصول)[ف];
        إذا (المدى.البداية <= العدد && المدى.النهاية <= العدد) {
            ليكن البداية: طبيعي = (*الموقع_الجديد)[المدى.البداية];
            ليكن النهاية: طبيعي = (*الموقع_الجديد)[المدى.النهاية];
            المدى.البداية := البداية;
            المدى.النهاية := النهاية;
            إذا (النهاية > البداية) { ألحق(الناتج, المدى); };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Whether the operation is AND, OR or XOR (which set ZF from their result).
عرف عملية_منطقية_إكس(العملية: حساب_صحيح_إكس_كامل): منطقي {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.و_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The destination and width of an AND, OR or XOR, if that is the
// instruction.
عرف وجهة_منطقية_إكس(التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون): اختياري معرف_سجل_افتراضي {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(العملية, الوجهة, _, _, _, _) -> {
        إذا (عملية_منطقية_إكس(العملية)) { أرجع اختياري.موجود(الوجهة); };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_فوري_إكس(العملية, الوجهة, _, _, _, _) -> {
        إذا (عملية_منطقية_إكس(العملية)) { أرجع اختياري.موجود(الوجهة); };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

عرف بتات_منطقية_إكس(التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون): طبيعي {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(_, _, _, _, البتات, _) -> { أرجع البتات; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_فوري_إكس(_, _, _, _, البتات, _) -> { أرجع البتات; }
    | _ -> { أرجع 0; };
}

// Keeps the instructions of a block that المحذوفة does not mark, with
// their provenance.
عرف أبق_تعليمات_كتلة_إكس(
    الكتلة: &متغير كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    المحذوفة: &متجه منطقي
): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    ليكن الباقية: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [];
    ليكن الموقع_الجديد: متغير متجه طبيعي = [];
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < العدد) {
        ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
        إذا (!(ت < (الطول(*المحذوفة) مثل طبيعي) && (*المحذوفة)[ت])) {
            ليكن المنقولة: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
            بدّل((*الكتلة).التعليمات[ت], المنقولة);
            ألحق(الباقية, المنقولة);
        };
        ت := ت + 1;
    }
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    ليكن الأصول: متجه مدى_أصل_تعليمات = أعد_مديات_الأصول_إكس(&(*الكتلة).أصول_التعليمات, &الموقع_الجديد);
    (*الكتلة).التعليمات := الباقية;
    (*الكتلة).أصول_التعليمات := الأصول;
}

// AND, OR or XOR set ZF from their result at their width: a compare of
// that result with 0 right after, for a JE or JNE, goes (so `x & 1 == 0` is
// AND and JE).
عرف احذف_مقارنات_بعد_منطق_كتلة_إكس(الكتلة: &متغير كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    ليكن المحذوفة: متغير متجه منطقي = [];
    ليكن وجد_أي: متغير منطقي = خطأ;
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < العدد) { ألحق(المحذوفة, خطأ); ت := ت + 1; }
    ت := 0;
    طالما (ت + 2 < العدد) {
        طابق وجهة_منطقية_إكس(&(*الكتلة).التعليمات[ت]) مع
        | اختياري.موجود(و) -> {
            ليكن البتات: طبيعي = بتات_منطقية_إكس(&(*الكتلة).التعليمات[ت]);
            ليكن مقارنة_صفر: متغير منطقي = خطأ;
            طابق (*الكتلة).التعليمات[ت + 1] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_فورية_إكس(س, الفوري, ب) -> {
                مقارنة_صفر := س.القيمة == و.القيمة && الفوري == 0 && ب == البتات;
            }
            | _ -> { };
            إذا (مقارنة_صفر) {
                طابق (*الكتلة).التعليمات[ت + 2] مع
                | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(الشرط, _) -> {
                    طابق الشرط مع
                    | شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ -> { المحذوفة[ت + 1] := صواب; وجد_أي := صواب; }
                    | شرط_إكس_ستة_وثمانون_أربعة_وستون.لاتكافؤ -> { المحذوفة[ت + 1] := صواب; وجد_أي := صواب; }
                    | _ -> { };
                }
                | _ -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        ت := ت + 1;
    }
    إذا (وجد_أي) { أبق_تعليمات_كتلة_إكس(الكتلة, &المحذوفة); };
}

// Drops a block's first instruction.
عرف احذف_رأس_كتلة_إكس(الكتلة: &متغير كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة): فراغ {
    ليكن العدد: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    إذا (العدد == 0) { أرجع; };
    ليكن الباقية: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [];
    ليكن الموقع_الجديد: متغير متجه طبيعي = [];
    ألحق(الموقع_الجديد, 0);
    ليكن ت: متغير طبيعي = 1;
    طالما (ت < العدد) {
        ألحق(الموقع_الجديد, ت - 1);
        ليكن المنقولة: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
        بدّل((*الكتلة).التعليمات[ت], المنقولة);
        ألحق(الباقية, المنقولة);
        ت := ت + 1;
    }
    ألحق(الموقع_الجديد, العدد - 1);
    ليكن الأصول: متجه مدى_أصل_تعليمات = أعد_مديات_الأصول_إكس(&(*الكتلة).أصول_التعليمات, &الموقع_الجديد);
    (*الكتلة).التعليمات := الباقية;
    (*الكتلة).أصول_التعليمات := الأصول;
}

// Fuses one check; false (nothing changed) when its code is not the form
// the selector makes.
عرف ادمج_حسابا_بمخرج_إكس(
    الدالة: &متغير دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الحسابات: &حسابات_بمخرج_تجاوز_مسير,
    السجل: &حساب_بمخرج_تجاوز_مسير,
    الهدف: &واصف_هدف,
    المتطايرة: &متجه معرف_سجل_فعلي
): منطقي {
    ليكن عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    ليكن ك: طبيعي = (*السجل).الكتلة;
    ليكن م: طبيعي = (*السجل).المتابعة;
    ليكن ب: طبيعي = (*السجل).البارد;
    إذا (ك >= عدد_الكتل || م >= عدد_الكتل || ب >= عدد_الكتل) { أرجع خطأ; };
    // Selected blocks are MSIR's, in its order.
    إذا ((*الدالة).الكتل[ك].الرأس.المعرف.القيمة != ك || (*الدالة).الكتل[م].الرأس.المعرف.القيمة != م
        || (*الدالة).الكتل[ب].الرأس.المعرف.القيمة != ب) { أرجع خطأ; };
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*السجل).المنطقة) مثل طبيعي)) {
        ليكن ه: طبيعي = (*السجل).المنطقة[ر];
        إذا (ه >= عدد_الكتل || ه == ك || ه == م || ه == ب) { أرجع خطأ; };
        إذا ((*الدالة).الكتل[ه].الرأس.المعرف.القيمة != ه) { أرجع خطأ; };
        ر := ر + 1;
    }
    // C's head: the checked operation; its wrapping form sets the flags.
    إذا ((الطول((*الدالة).الكتل[م].التعليمات) مثل طبيعي) == 0) { أرجع خطأ; };
    ليكن المدمجة: متغير اختياري تعليمة_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
    ليكن الشرط: متغير شرط_إكس_ستة_وثمانون_أربعة_وستون = شرط_إكس_ستة_وثمانون_أربعة_وستون.تجاوز();
    طابق (*الدالة).الكتل[م].التعليمات[0] مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(العملية, الوجهة, أ, ب_, البتات, بإشارة) -> {
        إذا (الوجهة.القيمة == ((*السجل).الناتج.القيمة مثل طبيعي)
            && أ.القيمة == ((*السجل).اليسار.القيمة مثل طبيعي)
            && ب_.القيمة == ((*السجل).اليمين.القيمة مثل طبيعي)
            && (!(*السجل).إشارة_معروفة || (*السجل).موقع == بإشارة)) {
            إذا (!بإشارة) { الشرط := شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي(); };
            طابق العملية مع
            | حساب_صحيح_إكس_كامل.جمع -> {
                المدمجة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(
                    حساب_صحيح_إكس_كامل.جمع_ملتف(), الوجهة, أ, ب_, البتات, بإشارة
                ));
            }
            | حساب_صحيح_إكس_كامل.طرح -> {
                المدمجة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(
                    حساب_صحيح_إكس_كامل.طرح_ملتف(), الوجهة, أ, ب_, البتات, بإشارة
                ));
            }
            | حساب_صحيح_إكس_كامل.ضرب -> {
                // IMUL r64, r/m64 sets OF exactly when the signed 64-bit
                // product does not fit.
                إذا (بإشارة && البتات == 64) {
                    المدمجة := اختياري.موجود(تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(
                        حساب_صحيح_إكس_كامل.ضرب_ملتف(), الوجهة, أ, ب_, البتات, بإشارة
                    ));
                };
            }
            | _ -> { };
        };
    }
    | _ -> { };
    ليكن العملية_المدمجة: تعليمة_إكس_ستة_وثمانون_أربعة_وستون;
    طابق المدمجة مع
    | اختياري.موجود(ت_) -> { العملية_المدمجة := ت_; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    // K ends in the selector's two-way branch on the test's truth value.
    ليكن العدد: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
    إذا (العدد < 2) { أرجع خطأ; };
    طابق سجل_قفز_بقيمة_إكس(&(*الدالة).الكتل[ك].التعليمات[العدد - 2]) مع
    | اختياري.موجود(س) -> {
        إذا (س.القيمة != ((*السجل).الشرط.القيمة مثل طبيعي)) { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    طابق (*الدالة).الكتل[ك].التعليمات[العدد - 1] مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(_) -> { }
    | _ -> { أرجع خطأ; };
    // The test's instructions go; nothing kept may read what they define.
    ليكن محذوفة: متغير متجه منطقي = [];
    ليكن المحذوفة_سجلات: متغير متجه معرف_سجل_افتراضي = [];
    ليكن ت: متغير طبيعي = 0;
    طالما (ت + 2 < العدد) {
        ليكن تحذف: متغير منطقي = خطأ;
        طابق وجهة_تعليمة_اختبار_إكس(&(*الدالة).الكتل[ك].التعليمات[ت]) مع
        | اختياري.موجود(و) -> {
            إذا (قيمة_اختبار_إكس(الحسابات, و)) { تحذف := صواب; ألحق(المحذوفة_سجلات, و); };
        }
        | اختياري.لا_شيء -> { };
        ألحق(محذوفة, تحذف);
        ت := ت + 1;
    }
    ت := 0;
    طالما (ت + 2 < العدد) {
        إذا (!محذوفة[ت]) {
            ليكن الحقيقة: حقيقة_تعليمة_تخصيص = حقيقة_تخصيص_تعليمة_إكس(
                &(*الدالة).الكتل[ك].التعليمات[ت], الهدف, المتطايرة, 0
            );
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الحقيقة.الاستخدامات) مثل طبيعي)) {
                إذا (سجل_من_إكس(&المحذوفة_سجلات, الحقيقة.الاستخدامات[ع].السجل)) { أرجع خطأ; };
                ع := ع + 1;
            }
        };
        ت := ت + 1;
    }
    // K: the kept instructions, the fused operation, the Jcc and the jump.
    ليكن الموقع_الجديد: متغير متجه طبيعي = [];
    ليكن الباقية: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [];
    ت := 0;
    طالما (ت + 2 < العدد) {
        ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
        إذا (!محذوفة[ت]) {
            ليكن المنقولة: متغير تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس();
            بدّل((*الدالة).الكتل[ك].التعليمات[ت], المنقولة);
            ألحق(الباقية, المنقولة);
        };
        ت := ت + 1;
    }
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    ألحق(الباقية, العملية_المدمجة);
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    ليكن معرف_البارد: معرف_كتلة_منتقاة = (*الدالة).الكتل[ب].الرأس.المعرف;
    ليكن معرف_المتابعة: معرف_كتلة_منتقاة = (*الدالة).الكتل[م].الرأس.المعرف;
    ليكن بلا_نقلات_البارد: متجه نقلة_حافة_منتقاة = [];
    ليكن بلا_نقلات_المتابعة: متجه نقلة_حافة_منتقاة = [];
    ليكن حزمة_البارد: متطلبات_نقل_حافة_منتقاة = { الهدف: معرف_البارد, النقلات: بلا_نقلات_البارد };
    ليكن حزمة_المتابعة: متطلبات_نقل_حافة_منتقاة = { الهدف: معرف_المتابعة, النقلات: بلا_نقلات_المتابعة };
    ألحق(الباقية, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(الشرط, حزمة_البارد));
    ألحق(الباقية, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(حزمة_المتابعة));
    ألحق(الموقع_الجديد, الطول(الباقية) مثل طبيعي);
    ليكن الأصول: متجه مدى_أصل_تعليمات = أعد_مديات_الأصول_إكس(&(*الدالة).الكتل[ك].أصول_التعليمات, &الموقع_الجديد);
    (*الدالة).الكتل[ك].التعليمات := الباقية;
    (*الدالة).الكتل[ك].أصول_التعليمات := الأصول;
    ليكن الخلفاء: متغير متجه معرف_كتلة_منتقاة = [];
    ألحق(الخلفاء, معرف_البارد);
    ألحق(الخلفاء, معرف_المتابعة);
    (*الدالة).الكتل[ك].الرأس.الخلفاء := الخلفاء;
    احذف_رأس_كتلة_إكس(&متغير (*الدالة).الكتل[م]);
    // The test's own blocks: nothing branches to them any more.
    ر := 0;
    طالما (ر < (الطول((*السجل).المنطقة) مثل طبيعي)) {
        ليكن ه: طبيعي = (*السجل).المنطقة[ر];
        ليكن الفخ: متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس()];
        ليكن بلا_أصول: متجه مدى_أصل_تعليمات = [];
        ليكن بلا_خلفاء: متجه معرف_كتلة_منتقاة = [];
        (*الدالة).الكتل[ه].التعليمات := الفخ;
        (*الدالة).الكتل[ه].أصول_التعليمات := بلا_أصول;
        (*الدالة).الكتل[ه].الرأس.الخلفاء := بلا_خلفاء;
        ر := ر + 1;
    }
    أرجع صواب;
}

// Fuses every check of the function (selected_simplification.sn's first
// step, before the compares and immediates).
عرف ادمج_حسابات_بمخرج_إكس(
    الدالة: &متغير دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الحسابات: &حسابات_بمخرج_تجاوز_مسير,
    الهدف: &واصف_هدف,
    المتطايرة: &متجه معرف_سجل_فعلي
): فراغ {
    إذا ((الطول((*الدالة).الكتل) مثل طبيعي) != (الطول((*الحسابات).اختبار_الكتلة) مثل طبيعي)) { أرجع; };
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*الحسابات).الحسابات) مثل طبيعي)) {
        ادمج_حسابا_بمخرج_إكس(الدالة, الحسابات, &(*الحسابات).الحسابات[ر], الهدف, المتطايرة);
        ر := ر + 1;
    }
}

عام عرف بسط_دالة_إكس_منتقاة(
    الدالة: &متغير دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف,
    الحسابات: &حسابات_بمخرج_تجاوز_مسير,
    تحسين: منطقي
): فراغ {
    ليكن المتطايرة: متجه معرف_سجل_فعلي = سجلات_متطايرة_للهدف(الهدف);
    ادمج_حسابات_بمخرج_إكس(الدالة, الحسابات, الهدف, &المتطايرة);
    ليكن العدادات: عدادات_سجلات_إكس = عد_سجلات_دالة_إكس(الدالة, الهدف, &المتطايرة);
    ليكن الثوابت: متجه اختياري طبيعي = ثوابت_سجلات_دالة_إكس(الدالة, &العدادات);
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        أنزل_مقارنات_كتلة_إكس(&متغير (*الدالة).الكتل[ك]);
        بسط_مقارنات_كتلة_إكس(&متغير (*الدالة).الكتل[ك], &العدادات, &الثوابت, تحسين);
        ك := ك + 1;
    }
    اطو_عناوين_عوام_إكس(الدالة, &العدادات);
    اطو_عناوين_محسوبة_إكس(الدالة, &العدادات);
    ليكن بعد_التبسيط: عدادات_سجلات_إكس = عد_سجلات_دالة_إكس(الدالة, الهدف, &المتطايرة);
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        احذف_ثوابت_ميتة_كتلة_إكس(&متغير (*الدالة).الكتل[ك], &بعد_التبسيط);
        احذف_مقارنات_بعد_منطق_كتلة_إكس(&متغير (*الدالة).الكتل[ك]);
        ك := ك + 1;
    }
}
