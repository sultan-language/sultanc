        | اختياري.موجود(و) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تخصيص_صندوق(و, الحجم, المحاذاة)); };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الوجهة, العنوان, الحجم, بإشارة) -> {
        طابق حل_سجل_إكس(التعيينات, الوجهة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(الوجهة); }
        | اختياري.موجود(و) -> {
            طابق خصص_عنوان_إكس(&العنوان, التعيينات) مع
            | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل); }
            | نتيجة.نجح(المخصص) -> {
