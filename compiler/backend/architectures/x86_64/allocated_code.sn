        طابق حل_سجل_إكس(التعيينات, الشرط) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(الشرط); }
        | اختياري.موجود(ش) -> {
            طابق خصص_نقلات_حافة_إكس(&النقلات, التعيينات) مع
            | نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل); }
            | نتيجة_نقلات_إكس_مخصصة.نجحت(المخصصة) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_بقيمة(ش, المخصصة)); };
