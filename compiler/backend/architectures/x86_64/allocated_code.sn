            | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(العنوان); }
            | اختياري.موجود(ع) -> {
                طابق حل_سجل_إكس(التعيينات, القيمة) مع
                | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(القيمة); }
                | اختياري.موجود(ق) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.ذري(العملية, و, ع, ق, البتات)); };
            };
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_قارن_وبدل_إكس(الوجهة, العنوان, المتوقع, الجديد, البتات) -> {
        طابق حل_سجل_إكس(التعيينات, الوجهة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(الوجهة); }
        | اختياري.موجود(و) -> {
