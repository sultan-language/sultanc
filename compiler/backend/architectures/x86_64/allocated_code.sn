    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.سياج_إكس -> {
        أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.سياج());
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_إكس(العملية, الوجهة, العنوان, القيمة, البتات) -> {
