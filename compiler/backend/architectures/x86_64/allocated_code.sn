        طابق حل_سجل_إكس(التعيينات, المميز) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(المميز); }
        | اختياري.موجود(السجل) -> {
            أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_جدولي(السجل, انسخ_مملوكا_متجه_معرف_كتلة_منتقاة(&الأهداف), الافتراضي, الأدنى)
            );
        };
