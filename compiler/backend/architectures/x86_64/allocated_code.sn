    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس -> {
        أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(
            تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.عودة()
        );
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس_بقيمة(قيمة_العودة) -> {
        طابق خصص_قيمة_واجهة_إكس(&قيمة_العودة.القيمة, التعيينات) مع
        | نتيجة.خطأ(السجل) -> {
            أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة.نجح(المخصصة) -> {
            دع عنوان_غير_مباشر: متغير اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
            طابق قيمة_العودة.عنوان_ناتج_غير_مباشر مع
            | اختيار.بعض(العنوان) -> {
                طابق حل_سجل_إكس(التعيينات, العنوان) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(العنوان);
                }
                | اختيار.بعض(الفعلي) -> { عنوان_غير_مباشر := اختيار.بعض(الفعلي); };
            }
            | اختيار.لا_شيء -> { };
            دع الناتج: ناتج_عودة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
                القيمة: المخصصة,
                عنوان_ناتج_غير_مباشر: عنوان_غير_مباشر
            };
            أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.عودة_بقيمة(الناتج)
            );
        };
    };
}

عرف جهز_طلب_انسكاب_إكس(
    الطلب: &طلب_سجل_تخصيص,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    سجلات_العمل: &متجه معرف_سجل_فعلي,
    التعيينات: &متغير متجه تعيين_سجل,
    الناتج: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    بعد: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    التالي: &متغير غير_موقع,
    استخدام: منطقي,
    تعريف: منطقي
): اختيار معرف_سجل_افتراضي {
    دع ط: طلب_سجل_تخصيص = *الطلب;
    دع خ: خطة_تخصيص_مع_انسكاب = *الخطة;
    دع عمل: متجه معرف_سجل_فعلي = *سجلات_العمل;
    طابق ابحث_تعيين_سجل(&خ.التعيينات, ط.السجل) مع
    | اختيار.بعض(الفعلي) -> {
        دع حالة_التعيينات: متغير متجه تعيين_سجل = *التعيينات;
        دع التعيين: تعيين_سجل = { الافتراضي: ط.السجل, الفعلي: الفعلي };
        أدخل_تعيين_سجل_مرتب(&متغير حالة_التعيينات, التعيين);
        *التعيينات := حالة_التعيينات;
        أرجع اختيار.لا_شيء();
    }
    | اختيار.لا_شيء -> { };
    طابق ابحث_موضع_انسكاب_إكس(الإطار, ط.السجل) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(ط.السجل); }
    | اختيار.بعض(الموقع) -> {
        دع حالة_التعيينات: متغير متجه تعيين_سجل = *التعيينات;
        دع حالة_بعد: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *بعد;
        دع سجل_العمل: متغير اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
        طابق ابحث_تعيين_سجل(&حالة_التعيينات, ط.السجل) مع
        | اختيار.بعض(السجل) -> { سجل_العمل := اختيار.بعض(السجل); }
        | اختيار.لا_شيء -> {
            طابق ط.ثابت مع
            | اختيار.بعض(الثابت) -> {
                دع تعيين: تعيين_سجل = { الافتراضي: ط.السجل, الفعلي: الثابت };
                أدخل_تعيين_سجل_مرتب(&متغير حالة_التعيينات, تعيين);
                سجل_العمل := اختيار.بعض(الثابت);
            }
            | اختيار.لا_شيء -> {
                دع مؤشر: غير_موقع = *التالي;
                لو (مؤشر >= (الطول(عمل) مثل غير_موقع)) { أرجع اختيار.بعض(ط.السجل); };
                دع السجل: معرف_سجل_فعلي = عمل[مؤشر];
                دع تعيين: تعيين_سجل = { الافتراضي: ط.السجل, الفعلي: السجل };
                أدخل_تعيين_سجل_مرتب(&متغير حالة_التعيينات, تعيين);
                *التالي := مؤشر + 1;
                سجل_العمل := اختيار.بعض(السجل);
            };
        };
        طابق سجل_العمل مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(ط.السجل); }
        | اختيار.بعض(السجل) -> {
            لو (استخدام) {
                دع حالة_الناتج: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الناتج;
                ألحق(
                    حالة_الناتج,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(السجل, الموقع)
                );
                *الناتج := حالة_الناتج;
            };
            لو (تعريف) {
                ألحق(حالة_بعد, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تخزين_انسكاب(الموقع, السجل));
            };
        };
        *التعيينات := حالة_التعيينات;
        *بعد := حالة_بعد;
        أرجع اختيار.لا_شيء();
    };
}

عرف أضف_تعليمة_إكس_بخطة_انسكاب(
    التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    الهدف: &واصف_هدف,
    الناتج: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة
): نتيجة_إضافة_تعليمات_إكس {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(النقلات) -> {
        طابق خصص_نقلات_حافة_إكس_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_نقلات_إكس_مخصصة.نجحت(المخصصة) -> {
            دع حالة_الناتج: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الناتج;
            ألحق(حالة_الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_مع_نقلات(المخصصة));
            *الناتج := حالة_الناتج;
            أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(الشرط, النقلات) -> {
        طابق خصص_نقلات_حافة_إكس_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_نقلات_إكس_مخصصة.نجحت(المخصصة) -> {
            دع حالة_الناتج: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الناتج;
            ألحق(حالة_الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_مع_نقلات(الشرط, المخصصة));
            *الناتج := حالة_الناتج;
            أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(الشرط, النقلات) -> {
        طابق خصص_نقلات_حافة_إكس_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_نقلات_إكس_مخصصة.نجحت(المخصصة) -> {
            طابق حدد_موقع_قيمة_إكس(الخطة, الإطار, الشرط) مع
            | نتيجة_موقع_قيمة_إكس.مفقود(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
            | نتيجة_موقع_قيمة_إكس.نجح(الموقع) -> {
                طابق الموقع مع
                | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(السجل) -> {
                    دع حالة_الناتج: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الناتج;
                    ألحق(حالة_الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_بقيمة(السجل, المخصصة));
                    *الناتج := حالة_الناتج;
                }
                | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.انسكاب(موضع_الشرط) -> {
                    دع العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_للهدف(الهدف);
                    لو ((الطول(العمل) مثل غير_موقع) == 0) { أرجع نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(الشرط); };
                    دع سجل_الشرط: معرف_سجل_فعلي = العمل[0];
                    دع حالة_الناتج: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الناتج;
                    ألحق(حالة_الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(سجل_الشرط, موضع_الشرط));
                    ألحق(حالة_الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_بقيمة(سجل_الشرط, المخصصة));
                    *الناتج := حالة_الناتج;
                };
                أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
            };
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(النداء) -> {
        طابق خصص_نداء_إكس_بخطة(&النداء, الخطة, الإطار) مع
        | نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_تعليمة_إكس_مخصصة.نجحت(المخصصة) -> {
            دع حالة_الناتج: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الناتج;
            ألحق(حالة_الناتج, المخصصة);
            *الناتج := حالة_الناتج;
            أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
        };
    }
    | _ -> { };
    دع خ: خطة_تخصيص_مع_انسكاب = *الخطة;
    دع الحقيقة: حقيقة_تعليمة_تخصيص = حقيقة_تخصيص_تعليمة_إكس(التعليمة, الهدف, 0);
    لو (!حقيقة_تخصيص_تحتاج_انسكاب_إكس(&الحقيقة, الإطار)) {
        طابق خصص_تعليمة_إكس(التعليمة, &خ.التعيينات) مع
        | نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_تعليمة_إكس_مخصصة.نجحت(المخصصة) -> {
            دع حالة_الناتج: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الناتج;
            ألحق(حالة_الناتج, المخصصة);
            *الناتج := حالة_الناتج;
            أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
        };
    };
    دع التعيينات: متغير متجه تعيين_سجل = [];
    دع بعد: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع سجلات_العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_للهدف(الهدف);
    دع التالي: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحقيقة.الاستخدامات) مثل غير_موقع)) {
        طابق جهز_طلب_انسكاب_إكس(
            &الحقيقة.الاستخدامات[ف], الخطة, الإطار, &سجلات_العمل,
            &متغير التعيينات, الناتج, &متغير بعد, &متغير التالي, صواب, خطأ
        ) مع
        | اختيار.بعض(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(السجل); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    دع ت: متغير غير_موقع = 0;
    بينما (ت < (الطول(الحقيقة.التعريفات) مثل غير_موقع)) {
        طابق جهز_طلب_انسكاب_إكس(
            &الحقيقة.التعريفات[ت], الخطة, الإطار, &سجلات_العمل,
            &متغير التعيينات, الناتج, &متغير بعد, &متغير التالي, خطأ, صواب
        ) مع
        | اختيار.بعض(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(السجل); }
        | اختيار.لا_شيء -> { };
        ت := ت + 1;
    }
    لو (التالي > 0 && !الحقيقة.قابل_للانسكاب) {
        دع السجل: معرف_سجل_افتراضي = { القيمة: 0 };
        أرجع نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(السجل);
    };
    طابق خصص_تعليمة_إكس(التعليمة, &التعيينات) مع
    | نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
    | نتيجة_تعليمة_إكس_مخصصة.نجحت(المخصصة) -> {
        دع حالة_الناتج: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الناتج;
        ألحق(حالة_الناتج, المخصصة);
        دع ب: متغير غير_موقع = 0;
        بينما (ب < (الطول(بعد) مثل غير_موقع)) {
            دع مرجع_بعد: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &بعد[ب];
            دع تعليمة_بعد: تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *مرجع_بعد;
            ألحق(حالة_الناتج, تعليمة_بعد);
            ب := ب + 1;
        }
        *الناتج := حالة_الناتج;
        أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
    };
}

عرف خصص_كتلة_إكس_بخطة_انسكاب(
    الكتلة: &كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    الهدف: &واصف_هدف
): نتيجة_كتلة_إكس_مخصصة {
    دع ك: كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *الكتلة;
    دع التعليمات: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ك.التعليمات) مثل غير_موقع)) {
        طابق أضف_تعليمة_إكس_بخطة_انسكاب(
            &ك.التعليمات[ف], الخطة, الإطار, الهدف, &متغير التعليمات
        ) مع
        | نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_كتلة_إكس_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(السجل) -> { أرجع نتيجة_كتلة_إكس_مخصصة.حالة_انسكاب_غير_مدعومة(السجل); }
        | نتيجة_إضافة_تعليمات_إكس.نجحت -> { };
        ف := ف + 1;
    }
    دع مرجع_الرأس: &رأس_كتلة_منتقاة = &ك.الرأس;
    دع الرأس: رأس_كتلة_منتقاة = *مرجع_الرأس;
    دع الناتج: كتلة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = { الرأس: الرأس, التعليمات: التعليمات };
    أرجع نتيجة_كتلة_إكس_مخصصة.نجحت(الناتج);
}

عرف خصص_كتلة_إكس(
    الكتلة: &كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    التعيينات: &متجه تعيين_سجل
): نتيجة_كتلة_إكس_مخصصة {
    دع ك: كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *الكتلة;
    دع التعليمات: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ك.التعليمات) مثل غير_موقع)) {
        طابق خصص_تعليمة_إكس(&ك.التعليمات[ف], التعيينات) مع
        | نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_كتلة_إكس_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة_تعليمة_إكس_مخصصة.نجحت(التعليمة) -> {
            ألحق(التعليمات, التعليمة);
        };
        ف := ف + 1;
    }
    دع مرجع_الرأس: &رأس_كتلة_منتقاة = &ك.الرأس;
    دع الرأس: رأس_كتلة_منتقاة = *مرجع_الرأس;
    دع الناتج: كتلة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
        الرأس: الرأس,
        التعليمات: التعليمات
    };
    أرجع نتيجة_كتلة_إكس_مخصصة.نجحت(الناتج);
}

// Allocation facts are a transient per-function analysis product. Keep their
// lifetime inside this helper so the selected instruction stream is not retained
// alongside a second full use/def/constraint representation during spill lowering.
عرف خصص_خطة_دالة_إكس(
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): نتيجة_تخصيص_مع_انسكاب {
    دع المسألة: مسألة_تخصيص = ابن_مسألة_تخصيص_دالة_إكس(الدالة, الهدف);
    أرجع خصص_السجلات_مع_انسكاب(&المسألة);
}

عام عرف خصص_دالة_إكس_ستة_وثمانون_أربعة_وستون(
    الدالة_المنتقاة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): نتيجة_تخصيص_دالة_إكس {
    دع و: واصف_هدف = *الهدف;
    طابق و.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> { أرجع نتيجة_تخصيص_دالة_إكس.هدف_غير_صالح(و.المعرف); };

    دع الدالة: دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *الدالة_المنتقاة;
    طابق خصص_خطة_دالة_إكس(&الدالة, الهدف) مع
    | نتيجة_تخصيص_مع_انسكاب.فشل_قيود(السجل) -> {
        أرجع نتيجة_تخصيص_دالة_إكس.فشل_قيود(السجل);
    }
    | نتيجة_تخصيص_مع_انسكاب.مكتمل(الخطة) -> {
        طابق ابن_إطار_انسكاب_إكس(&الخطة.السجلات_المسكوبة, &الدالة.المواضع_المحلية, الهدف) مع
        | نتيجة_إطار_انسكاب_إكس.سياسة_غير_متاحة -> {
            أرجع نتيجة_تخصيص_دالة_إكس.سياسة_إطار_غير_متاحة(و.المعرف);
        }
        | نتيجة_إطار_انسكاب_إكس.نجح(الإطار) -> {
            دع الكتل: متغير متجه كتلة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
            دع ك: متغير غير_موقع = 0;
            بينما (ك < (الطول(الدالة.الكتل) مثل غير_موقع)) {
                طابق خصص_كتلة_إكس_بخطة_انسكاب(&الدالة.الكتل[ك], &الخطة, &الإطار, الهدف) مع
                | نتيجة_كتلة_إكس_مخصصة.سجل_غير_مخصص(السجل) -> {
                    أرجع نتيجة_تخصيص_دالة_إكس.فشل_قيود(السجل);
                }
                | نتيجة_كتلة_إكس_مخصصة.حالة_انسكاب_غير_مدعومة(السجل) -> {
                    أرجع نتيجة_تخصيص_دالة_إكس.حالة_انسكاب_غير_مدعومة(السجل);
                }
                | نتيجة_كتلة_إكس_مخصصة.نجحت(الكتلة) -> { ألحق(الكتل, الكتلة); };
                ك := ك + 1;
            }
            دع مرجع_رأس_الدالة: &رأس_دالة_منتقاة = &الدالة.الرأس;
            دع رأس_الدالة: رأس_دالة_منتقاة = *مرجع_رأس_الدالة;
            دع مرجع_التعيينات_النهائية: &متجه تعيين_سجل = &الخطة.التعيينات;
            دع التعيينات_النهائية: متجه تعيين_سجل = *مرجع_التعيينات_النهائية;
            دع المخصصة: دالة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
                الرأس: رأس_الدالة,
                الكتل: الكتل,
                التعيينات: التعيينات_النهائية,
                إطار_الانسكاب: الإطار
            };
            أرجع نتيجة_تخصيص_دالة_إكس.نجحت(المخصصة);
        };
    };
}

عام عرف خصص_شفرة_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): نتيجة_بناء_إكس_مخصص {
    دع ش: شفرة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *الشفرة;
    دع و: واصف_هدف = *الهدف;
    لو (!معرفا_هدف_متساويان(ش.الرأس.الهدف, و.المعرف)) {
        أرجع نتيجة_بناء_إكس_مخصص.هدف_غير_صالح(ش.الرأس.الهدف);
    };
    دع الدوال: متغير متجه دالة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ش.الدوال) مثل غير_موقع)) {
        طابق خصص_دالة_إكس_ستة_وثمانون_أربعة_وستون(&ش.الدوال[ف], الهدف) مع
        | نتيجة_تخصيص_دالة_إكس.فشل_قيود(السجل) -> {
            أرجع نتيجة_بناء_إكس_مخصص.فشل_قيود(السجل);
        }
        | نتيجة_تخصيص_دالة_إكس.حالة_انسكاب_غير_مدعومة(السجل) -> {
            أرجع نتيجة_بناء_إكس_مخصص.حالة_انسكاب_غير_مدعومة(السجل);
        }
        | نتيجة_تخصيص_دالة_إكس.سياسة_إطار_غير_متاحة(معرف_الهدف) -> {
            أرجع نتيجة_بناء_إكس_مخصص.سياسة_إطار_غير_متاحة(معرف_الهدف);
        }
        | نتيجة_تخصيص_دالة_إكس.هدف_غير_صالح(معرف_الهدف) -> {
            أرجع نتيجة_بناء_إكس_مخصص.هدف_غير_صالح(معرف_الهدف);
        }
        | نتيجة_تخصيص_دالة_إكس.نجحت(الدالة) -> { ألحق(الدوال, الدالة); };
        ف := ف + 1;
    }
    دع مرجع_رأس_البرنامج: &رأس_برنامج_منتقى = &ش.الرأس;
    دع رأس_البرنامج: رأس_برنامج_منتقى = *مرجع_رأس_البرنامج;
    دع الناتج: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = { الرأس: رأس_البرنامج, الدوال: الدوال };
    أرجع نتيجة_بناء_إكس_مخصص.نجح(الناتج);
}
