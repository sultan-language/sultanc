عام عرف سجل_موقع_قيمة_إكس(الموقع: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص): اختيار معرف_سجل_فعلي {
    طابق *الموقع مع
    | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(السجل) -> { أرجع اختيار.بعض(السجل); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام عرف انسكاب_موقع_قيمة_إكس(الموقع: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص): اختيار موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون {
    طابق *الموقع مع
    | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.انسكاب(الموضع) -> { أرجع اختيار.بعض(الموضع); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام عرف موقعا_قيمة_إكس_متساويان(
    الأول: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الثاني: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): منطقي {
    طابق سجل_موقع_قيمة_إكس(الأول) مع
    | اختيار.بعض(أ) -> {
        طابق سجل_موقع_قيمة_إكس(الثاني) مع
        | اختيار.بعض(ب) -> { أرجع معرفا_سجل_فعلي_متساويان(أ, ب); }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_إكس(الأول) مع
        | اختيار.بعض(أ) -> {
            طابق انسكاب_موقع_قيمة_إكس(الثاني) مع
            | اختيار.بعض(ب) -> { أرجع أ.الفهرس == ب.الفهرس; }
            | اختيار.لا_شيء -> { أرجع خطأ; };
        }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    };
}

عرف ابحث_موضع_انسكاب_إكس(
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    السجل: معرف_سجل_افتراضي
): اختيار موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون {
    دع إ: إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الإطار;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(إ.المواقع) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع الموجود: غير_موقع = إ.المواقع[الوسط].السجل.القيمة;
        لو (الموجود == السجل.القيمة) {
            أرجع اختيار.بعض(إ.المواقع[الوسط]);
        };
        لو (الموجود < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع اختيار.لا_شيء();
}

عرف حقيقة_تخصيص_تحتاج_انسكاب_إكس(
    الحقيقة: &حقيقة_تعليمة_تخصيص,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): منطقي {
    دع ح: حقيقة_تعليمة_تخصيص = *الحقيقة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ح.الاستخدامات) مثل غير_موقع)) {
        طابق ابحث_موضع_انسكاب_إكس(الإطار, ح.الاستخدامات[ف].السجل) مع
        | اختيار.بعض(_) -> { أرجع صواب; }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(ح.التعريفات) مثل غير_موقع)) {
        طابق ابحث_موضع_انسكاب_إكس(الإطار, ح.التعريفات[ف].السجل) مع
        | اختيار.بعض(_) -> { أرجع صواب; }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف ابحث_موضع_محلي_إكس(
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    المعرف: غير_موقع
): اختيار موضع_محلي_إكس_ستة_وثمانون_أربعة_وستون {
    دع إ: إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الإطار;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(إ.المواضع_المحلية) مثل غير_موقع)) {
        لو (إ.المواضع_المحلية[ف].المعرف == المعرف) {
            أرجع اختيار.بعض(إ.المواضع_المحلية[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ابن_إطار_انسكاب_إكس(
    السجلات: &متجه معرف_سجل_افتراضي,
    طلبات_المحليات: &متجه طلب_موضع_محلي_إكس,
    الهدف: &واصف_هدف
): نتيجة_إطار_انسكاب_إكس {
    طابق محاذاة_إطار_تخصيص_للهدف(الهدف) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_إطار_انسكاب_إكس.سياسة_غير_متاحة(); }
    | اختيار.بعض(محاذاة_الإطار) -> {
        دع س: متجه معرف_سجل_افتراضي = *السجلات;
        دع ط: متجه طلب_موضع_محلي_إكس = *طلبات_المحليات;
        دع المحليات: متغير متجه موضع_محلي_إكس_ستة_وثمانون_أربعة_وستون = [];
        دع المواقع: متغير متجه موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = [];
        دع الإزاحة: متغير غير_موقع = 0;
        دع م: متغير غير_موقع = 0;
        بينما (م < (الطول(ط) مثل غير_موقع)) {
            دع المحاذاة: متغير غير_موقع = ط[م].المحاذاة;
            لو (المحاذاة == 0) { المحاذاة := 1; };
            الإزاحة := محاذاة_لأعلى(الإزاحة, المحاذاة);
            دع الموضع: موضع_محلي_إكس_ستة_وثمانون_أربعة_وستون = {
                المعرف: ط[م].المعرف, إزاحة_بايت: الإزاحة, الحجم: ط[م].الحجم, المحاذاة: المحاذاة
            };
            ألحق(المحليات, الموضع);
            الإزاحة := الإزاحة + ط[م].الحجم;
            م := م + 1;
        }
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(س) مثل غير_موقع)) {
            الإزاحة := محاذاة_لأعلى(الإزاحة, 8);
            دع الموقع: موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = {
                السجل: س[ف], الفهرس: ف, إزاحة_بايت: الإزاحة, الحجم: 8, المحاذاة: 8
            };
            ألحق(المواقع, الموقع);
            الإزاحة := الإزاحة + 8;
            ف := ف + 1;
        }
        دع الحجم: متغير غير_موقع = الإزاحة;
        لو (الحجم != 0) {
            طابق تعديل_مكدس_نداء_لحجم_إطار_للهدف(الهدف, الحجم) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_إطار_انسكاب_إكس.سياسة_غير_متاحة(); }
            | اختيار.بعض(التعديل) -> { الحجم := الحجم + التعديل; };
        };
        دع الإطار: إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = {
            المواقع: المواقع, المواضع_المحلية: المحليات, الحجم_بايت: الحجم, المحاذاة: محاذاة_الإطار
        };
        أرجع نتيجة_إطار_انسكاب_إكس.نجح(الإطار);
    };
}

عرف حدد_موقع_قيمة_إكس(
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    السجل: معرف_سجل_افتراضي
): نتيجة_موقع_قيمة_إكس {
    دع خ: خطة_تخصيص_مع_انسكاب = *الخطة;
    طابق ابحث_تعيين_سجل(&خ.التعيينات, السجل) مع
    | اختيار.بعض(الفعلي) -> {
        أرجع نتيجة_موقع_قيمة_إكس.نجح(موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(الفعلي));
    }
    | اختيار.لا_شيء -> {
        طابق ابحث_موضع_انسكاب_إكس(الإطار, السجل) مع
        | اختيار.بعض(الموقع) -> {
            أرجع نتيجة_موقع_قيمة_إكس.نجح(موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.انسكاب(الموقع));
        }
        | اختيار.لا_شيء -> { أرجع نتيجة_موقع_قيمة_إكس.مفقود(السجل); };
    };
}

عرف خصص_نقلات_حافة_إكس(
    المتطلبات: &متطلبات_نقل_حافة_منتقاة,
    التعيينات: &متجه تعيين_سجل
): نتيجة_نقلات_إكس_مخصصة {
    دع م: متطلبات_نقل_حافة_منتقاة = *المتطلبات;
    دع النقلات: متغير متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م.النقلات) مثل غير_موقع)) {
        دع مرجع_النقلة: &نقلة_حافة_منتقاة = &م.النقلات[ف];
        دع النقلة: نقلة_حافة_منتقاة = *مرجع_النقلة;
        طابق ابحث_تعيين_سجل(التعيينات, النقلة.المصدر) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(النقلة.المصدر); }
        | اختيار.بعض(المصدر) -> {
            طابق ابحث_تعيين_سجل(التعيينات, النقلة.الوجهة) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(النقلة.الوجهة); }
            | اختيار.بعض(الوجهة) -> {
                دع موقع_المصدر: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                    موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(المصدر);
                دع موقع_الوجهة: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                    موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(الوجهة);
                دع المخصصة: نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
                    المصدر: موقع_المصدر,
                    الوجهة: موقع_الوجهة
                };
                ألحق(النقلات, المخصصة);
            };
        };
        ف := ف + 1;
    }
    دع الناتج: متطلبات_نقل_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
        الهدف: م.الهدف,
        النقلات: النقلات
    };
    أرجع نتيجة_نقلات_إكس_مخصصة.نجحت(الناتج);
}

عرف خصص_نقلات_حافة_إكس_بخطة(
    المتطلبات: &متطلبات_نقل_حافة_منتقاة,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): نتيجة_نقلات_إكس_مخصصة {
    دع م: متطلبات_نقل_حافة_منتقاة = *المتطلبات;
    دع النقلات: متغير متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م.النقلات) مثل غير_موقع)) {
        دع النقلة: نقلة_حافة_منتقاة = م.النقلات[ف];
        طابق حدد_موقع_قيمة_إكس(الخطة, الإطار, النقلة.المصدر) مع
        | نتيجة_موقع_قيمة_إكس.مفقود(السجل) -> { أرجع نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة_موقع_قيمة_إكس.نجح(المصدر) -> {
            طابق حدد_موقع_قيمة_إكس(الخطة, الإطار, النقلة.الوجهة) مع
            | نتيجة_موقع_قيمة_إكس.مفقود(السجل) -> { أرجع نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(السجل); }
            | نتيجة_موقع_قيمة_إكس.نجح(الوجهة) -> {
                دع المخصصة: نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = { المصدر: المصدر, الوجهة: الوجهة };
                ألحق(النقلات, المخصصة);
            };
        };
        ف := ف + 1;
    }
    دع الناتج: متطلبات_نقل_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = { الهدف: م.الهدف, النقلات: النقلات };
    أرجع نتيجة_نقلات_إكس_مخصصة.نجحت(الناتج);
}

عرف حل_سجل_إكس(
    التعيينات: &متجه تعيين_سجل,
    السجل: معرف_سجل_افتراضي
): اختيار معرف_سجل_فعلي {
    أرجع ابحث_تعيين_سجل(التعيينات, السجل);
}

عرف خصص_قيمة_واجهة_إكس(
    القيمة: &قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    التعيينات: &متجه تعيين_سجل
): نتيجة قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة, معرف_سجل_افتراضي {
    دع ق: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *القيمة;
    طابق حل_سجل_إكس(التعيينات, ق.السجل) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(ق.السجل);
    }
    | اختيار.بعض(السجل) -> {
        دع المواضع: متجه موضع_جزء_واجهة = انسخ_مواضع_أجزاء_واجهة(&ق.المواضع);
        دع الناتج: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
            السجل: السجل,
            المواضع: المواضع,
            الحجم: ق.الحجم,
            تجميعي: ق.تجميعي,
            غير_مباشر: ق.غير_مباشر
        };
        أرجع نتيجة.نجح(الناتج);
    };
}

عرف خصص_عنوان_إكس(
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون,
    التعيينات: &متجه تعيين_سجل
): نتيجة عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص, معرف_سجل_افتراضي {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = *العنوان;
    دع الأساس: متغير اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    دع الفهرس: متغير اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    طابق ع.الأساس مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(السجل) -> {
        طابق حل_سجل_إكس(التعيينات, السجل) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(السجل); }
        | اختيار.بعض(الفعلي) -> { الأساس := اختيار.بعض(الفعلي); };
    };
    طابق ع.الفهرس مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(السجل) -> {
        طابق حل_سجل_إكس(التعيينات, السجل) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(السجل); }
        | اختيار.بعض(الفعلي) -> { الفهرس := اختيار.بعض(الفعلي); };
    };
    دع الناتج: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: الأساس,
        الفهرس: الفهرس,
        المقياس: ع.المقياس,
        الإزاحة: ع.الإزاحة
    };
    أرجع نتيجة.نجح(الناتج);
}

عرف خصص_هدف_نداء_إكس(
    الهدف: &هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    التعيينات: &متجه تعيين_سجل
): نتيجة هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص, معرف_سجل_افتراضي {
    طابق *الهدف مع
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة(الدالة) -> {
        أرجع نتيجة.نجح(هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.دالة(الدالة));
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة_خارجية(المعرف) -> {
        أرجع نتيجة.نجح(هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.دالة_خارجية(المعرف));
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.بدائي_تشغيل(البدائي) -> {
        أرجع نتيجة.نجح(هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.بدائي_تشغيل(البدائي));
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.قيمة_دالة(السجل) -> {
        طابق حل_سجل_إكس(التعيينات, السجل) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(السجل); }
        | اختيار.بعض(الفعلي) -> {
            دع الموقع: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(الفعلي);
            أرجع نتيجة.نجح(هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.قيمة_دالة(الموقع));
        };
    };
}

عرف خصص_نداء_إكس(
    النداء: &نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى,
    التعيينات: &متجه تعيين_سجل
): نتيجة_تعليمة_إكس_مخصصة {
    دع ن: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = *النداء;
    دع الحجج: متغير متجه قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ن.الحجج) مثل غير_موقع)) {
        طابق خصص_قيمة_واجهة_إكس(&ن.الحجج[ف], التعيينات) مع
        | نتيجة.خطأ(السجل) -> {
            أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة.نجح(القيمة) -> {
            دع الموقع: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(القيمة.السجل);
            دع المواضع: متجه موضع_جزء_واجهة = انسخ_مواضع_أجزاء_واجهة(&القيمة.المواضع);
            دع حجة: قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
                الموقع: الموقع,
                المواضع: المواضع,
                الحجم: القيمة.الحجم,
                تجميعي: القيمة.تجميعي,
                غير_مباشر: القيمة.غير_مباشر
            };
            ألحق(الحجج, حجة);
        };
        ف := ف + 1;
    }
    دع الناتج: متغير اختيار قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = اختيار.لا_شيء();
    طابق ن.الناتج مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(قيمة_الناتج) -> {
        طابق خصص_قيمة_واجهة_إكس(&قيمة_الناتج, التعيينات) مع
        | نتيجة.خطأ(السجل) -> {
            أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة.نجح(القيمة) -> {
            دع الموقع: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(القيمة.السجل);
            دع المواضع: متجه موضع_جزء_واجهة = انسخ_مواضع_أجزاء_واجهة(&القيمة.المواضع);
            دع قيمة_النداء: قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
                الموقع: الموقع,
                المواضع: المواضع,
                الحجم: القيمة.الحجم,
                تجميعي: القيمة.تجميعي,
                غير_مباشر: القيمة.غير_مباشر
            };
            الناتج := اختيار.بعض(قيمة_النداء);
        };
    };
    دع دالة_صفر: معرف_دالة_منتقاة = { القيمة: 0 };
    دع هدف_النداء: متغير هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
        هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.دالة(دالة_صفر);
    طابق خصص_هدف_نداء_إكس(&ن.الهدف, التعيينات) مع
    | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل); }
    | نتيجة.نجح(الهدف_المخصص) -> { هدف_النداء := الهدف_المخصص; };
    دع الخطة: نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الهدف: هدف_النداء,
        الحجج: الحجج,
        الناتج: الناتج
    };
    أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(
        تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نداء_مباشر(الخطة)
    );
}

عرف خصص_قيمة_نداء_إكس_بخطة(
    القيمة: &قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): نتيجة قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة, معرف_سجل_افتراضي {
    دع ق: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *القيمة;
    طابق حدد_موقع_قيمة_إكس(الخطة, الإطار, ق.السجل) مع
    | نتيجة_موقع_قيمة_إكس.مفقود(السجل) -> { أرجع نتيجة.خطأ(السجل); }
    | نتيجة_موقع_قيمة_إكس.نجح(الموقع) -> {
        دع المواضع: متجه موضع_جزء_واجهة = انسخ_مواضع_أجزاء_واجهة(&ق.المواضع);
        دع الناتج: قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
            الموقع: الموقع,
            المواضع: المواضع,
            الحجم: ق.الحجم,
            تجميعي: ق.تجميعي,
            غير_مباشر: ق.غير_مباشر
        };
        أرجع نتيجة.نجح(الناتج);
    };
}

عرف خصص_هدف_نداء_إكس_بخطة(
    الهدف: &هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): نتيجة هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص, معرف_سجل_افتراضي {
    طابق *الهدف مع
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة(الدالة) -> {
        أرجع نتيجة.نجح(هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.دالة(الدالة));
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة_خارجية(المعرف) -> {
        أرجع نتيجة.نجح(هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.دالة_خارجية(المعرف));
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.بدائي_تشغيل(البدائي) -> {
        أرجع نتيجة.نجح(هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.بدائي_تشغيل(البدائي));
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.قيمة_دالة(السجل) -> {
        طابق حدد_موقع_قيمة_إكس(الخطة, الإطار, السجل) مع
        | نتيجة_موقع_قيمة_إكس.مفقود(المفقود) -> { أرجع نتيجة.خطأ(المفقود); }
        | نتيجة_موقع_قيمة_إكس.نجح(الموقع) -> {
            أرجع نتيجة.نجح(هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.قيمة_دالة(الموقع));
        };
    };
}

عرف خصص_نداء_إكس_بخطة(
    النداء: &نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): نتيجة_تعليمة_إكس_مخصصة {
    دع ن: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = *النداء;
    دع الحجج: متغير متجه قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ن.الحجج) مثل غير_موقع)) {
        طابق خصص_قيمة_نداء_إكس_بخطة(&ن.الحجج[ف], الخطة, الإطار) مع
        | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة.نجح(القيمة) -> { ألحق(الحجج, القيمة); };
        ف := ف + 1;
    }
    دع الناتج: متغير اختيار قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = اختيار.لا_شيء();
    طابق ن.الناتج مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(قيمة_الناتج) -> {
        طابق خصص_قيمة_نداء_إكس_بخطة(&قيمة_الناتج, الخطة, الإطار) مع
        | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة.نجح(القيمة) -> { الناتج := اختيار.بعض(القيمة); };
    };
    دع دالة_صفر: معرف_دالة_منتقاة = { القيمة: 0 };
    دع هدف_النداء: متغير هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
        هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.دالة(دالة_صفر);
    طابق خصص_هدف_نداء_إكس_بخطة(&ن.الهدف, الخطة, الإطار) مع
    | نتيجة.خطأ(السجل) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل); }
    | نتيجة.نجح(الهدف_المخصص) -> { هدف_النداء := الهدف_المخصص; };
    دع نداء_مخصص: نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الهدف: هدف_النداء,
        الحجج: الحجج,
        الناتج: الناتج
    };
    أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(
        تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نداء_مباشر(نداء_مخصص)
    );
}

