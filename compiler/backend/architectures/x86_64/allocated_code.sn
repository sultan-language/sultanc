            | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(العنوان); }
            | اختياري.موجود(ع) -> {
                طابق حل_سجل_إكس(التعيينات, المتوقع) مع
                | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(المتوقع); }
                | اختياري.موجود(م) -> {
                    طابق حل_سجل_إكس(التعيينات, الجديد) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(الجديد); }
                    | اختياري.موجود(ج) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.ذري_قارن_وبدل(و, ع, م, ج, البتات)); };
                };
            };
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_خزن_إكس(العنوان, القيمة, البتات) -> {
        طابق حل_سجل_إكس(التعيينات, العنوان) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(العنوان); }
        | اختياري.موجود(ع) -> {
            طابق حل_سجل_إكس(التعيينات, القيمة) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(القيمة); }
            | اختياري.موجود(ق) -> { أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.ذري_خزن(ع, ق, البتات)); };
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(النداء) -> {
        أرجع خصص_نداء_إكس(&النداء, التعيينات);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس -> {
        أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(
            تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.عودة()
        );
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس_بقيمة(قيمة_العودة) -> {
        طابق خصص_قيمة_واجهة_إكس(&قيمة_العودة.القيمة, التعيينات) مع
        | نتيجة.خطأ(السجل) -> {
            أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة.نجح(المخصصة) -> {
            دع عنوان_غير_مباشر: متغير اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
            طابق قيمة_العودة.عنوان_ناتج_غير_مباشر مع
            | اختياري.موجود(العنوان) -> {
                طابق حل_سجل_إكس(التعيينات, العنوان) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(العنوان);
                }
                | اختياري.موجود(الفعلي) -> { عنوان_غير_مباشر := اختياري.موجود(الفعلي); };
            }
            | اختياري.لا_شيء -> { };
            دع الناتج: ناتج_عودة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
                القيمة: المخصصة,
                عنوان_ناتج_غير_مباشر: عنوان_غير_مباشر
            };
            أرجع نتيجة_تعليمة_إكس_مخصصة.نجحت(
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.عودة_بقيمة(الناتج)
            );
        };
    };
}

عرف جهز_طلب_انسكاب_إكس(
    الطلب: &طلب_سجل_تخصيص,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    سجلات_العمل: &متجه معرف_سجل_فعلي,
    التعيينات: &متغير متجه تعيين_سجل,
    الناتج: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    بعد: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    التالي: &متغير طبيعي,
    استخدام: منطقي,
    تعريف: منطقي
): اختياري معرف_سجل_افتراضي {
    دع السجل_الافتراضي: معرف_سجل_افتراضي = (*الطلب).السجل;
    طابق ابحث_تعيين_سجل(&(*الخطة).التعيينات, السجل_الافتراضي) مع
    | اختياري.موجود(الفعلي) -> {
        دع التعيين: تعيين_سجل = { الافتراضي: السجل_الافتراضي, الفعلي: الفعلي };
        أدخل_تعيين_سجل_مرتب(التعيينات, التعيين);
        أرجع اختياري.لا_شيء();
    }
    | اختياري.لا_شيء -> { };
    طابق ابحث_موضع_انسكاب_إكس(الإطار, السجل_الافتراضي) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(السجل_الافتراضي); }
    | اختياري.موجود(الموقع) -> {
        دع سجل_العمل: متغير اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
        طابق ابحث_تعيين_سجل(التعيينات, السجل_الافتراضي) مع
        | اختياري.موجود(السجل) -> { سجل_العمل := اختياري.موجود(السجل); }
        | اختياري.لا_شيء -> {
            طابق (*الطلب).ثابت مع
            | اختياري.موجود(الثابت) -> {
                دع تعيين: تعيين_سجل = { الافتراضي: السجل_الافتراضي, الفعلي: الثابت };
                أدخل_تعيين_سجل_مرتب(التعيينات, تعيين);
                سجل_العمل := اختياري.موجود(الثابت);
            }
            | اختياري.لا_شيء -> {
                دع مؤشر: طبيعي = *التالي;
                لو (مؤشر >= (الطول(*سجلات_العمل) مثل طبيعي)) { أرجع اختياري.موجود(السجل_الافتراضي); };
                دع السجل: معرف_سجل_فعلي = (*سجلات_العمل)[مؤشر];
                دع تعيين: تعيين_سجل = { الافتراضي: السجل_الافتراضي, الفعلي: السجل };
                أدخل_تعيين_سجل_مرتب(التعيينات, تعيين);
                *التالي := مؤشر + 1;
                سجل_العمل := اختياري.موجود(السجل);
            };
        };
        طابق سجل_العمل مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(السجل_الافتراضي); }
        | اختياري.موجود(السجل) -> {
            لو (استخدام) {
                ألحق(*الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(السجل, الموقع));
            };
            لو (تعريف) {
                ألحق(*بعد, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تخزين_انسكاب(الموقع, السجل));
            };
        };
        أرجع اختياري.لا_شيء();
    };
}

عرف أضف_تعليمة_إكس_بخطة_انسكاب(
    التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    الحقيقة: &حقيقة_تعليمة_تخصيص,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    سجلات_العمل: &متجه معرف_سجل_فعلي,
    الناتج: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة
): نتيجة_إضافة_تعليمات_إكس {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_جدولي_إكس(المميز, الأهداف, الافتراضي, الأدنى) -> {
        طابق حدد_موقع_قيمة_إكس(الخطة, الإطار, المميز) مع
        | نتيجة_موقع_قيمة_إكس.مفقود(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_موقع_قيمة_إكس.نجح(الموقع) -> {
            طابق الموقع مع
            | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(السجل) -> {
                ألحق(*الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_جدولي(السجل, انسخ_مملوكا_متجه_معرف_كتلة_منتقاة(&الأهداف), الافتراضي, الأدنى));
            }
            | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.انسكاب(الموضع) -> {
                دع العمل: متجه معرف_سجل_فعلي = *سجلات_العمل;
                لو ((الطول(العمل) مثل طبيعي) == 0) { أرجع نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(المميز); };
                دع السجل: معرف_سجل_فعلي = العمل[0];
                ألحق(*الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(السجل, الموضع));
                ألحق(*الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_جدولي(السجل, انسخ_مملوكا_متجه_معرف_كتلة_منتقاة(&الأهداف), الافتراضي, الأدنى));
            };
            أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(النقلات) -> {
        طابق خصص_نقلات_حافة_إكس_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_نقلات_إكس_مخصصة.نجحت(المخصصة) -> {
            ألحق(*الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_مع_نقلات(المخصصة));
            أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(الشرط, النقلات) -> {
        طابق خصص_نقلات_حافة_إكس_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_نقلات_إكس_مخصصة.نجحت(المخصصة) -> {
            ألحق(*الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_مع_نقلات(الشرط, المخصصة));
            أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(الشرط, النقلات) -> {
        طابق خصص_نقلات_حافة_إكس_بخطة(&النقلات, الخطة, الإطار) مع
        | نتيجة_نقلات_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_نقلات_إكس_مخصصة.نجحت(المخصصة) -> {
            طابق حدد_موقع_قيمة_إكس(الخطة, الإطار, الشرط) مع
            | نتيجة_موقع_قيمة_إكس.مفقود(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
            | نتيجة_موقع_قيمة_إكس.نجح(الموقع) -> {
                طابق الموقع مع
                | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(السجل) -> {
                    ألحق(*الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_بقيمة(السجل, المخصصة));
                }
                | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.انسكاب(موضع_الشرط) -> {
                    دع العمل: متجه معرف_سجل_فعلي = *سجلات_العمل;
                    لو ((الطول(العمل) مثل طبيعي) == 0) { أرجع نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(الشرط); };
                    دع سجل_الشرط: معرف_سجل_فعلي = العمل[0];
                    ألحق(*الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(سجل_الشرط, موضع_الشرط));
                    ألحق(*الناتج, تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_بقيمة(سجل_الشرط, المخصصة));
                };
                أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
            };
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(النداء) -> {
        طابق خصص_نداء_إكس_بخطة(&النداء, الخطة, الإطار) مع
        | نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_تعليمة_إكس_مخصصة.نجحت(المخصصة) -> {
            ألحق(*الناتج, المخصصة);
            أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
        };
    }
    | _ -> { };
    لو (!حقيقة_تخصيص_تحتاج_انسكاب_إكس(الحقيقة, الإطار)) {
        طابق خصص_تعليمة_إكس(التعليمة, &(*الخطة).التعيينات) مع
        | نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
        | نتيجة_تعليمة_إكس_مخصصة.نجحت(المخصصة) -> {
            ألحق(*الناتج, المخصصة);
            أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
        };
    };
    دع التعيينات: متغير متجه تعيين_سجل = [];
    دع بعد: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع التالي: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحقيقة).الاستخدامات) مثل طبيعي)) {
        طابق جهز_طلب_انسكاب_إكس(
            &(*الحقيقة).الاستخدامات[ف], الخطة, الإطار, سجلات_العمل,
            &متغير التعيينات, الناتج, &متغير بعد, &متغير التالي, صواب, خطأ
        ) مع
        | اختياري.موجود(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(السجل); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الحقيقة).التعريفات) مثل طبيعي)) {
        طابق جهز_طلب_انسكاب_إكس(
            &(*الحقيقة).التعريفات[ت], الخطة, الإطار, سجلات_العمل,
            &متغير التعيينات, الناتج, &متغير بعد, &متغير التالي, خطأ, صواب
        ) مع
        | اختياري.موجود(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(السجل); }
        | اختياري.لا_شيء -> { };
        ت := ت + 1;
    }
    لو (التالي > 0 && !(*الحقيقة).قابل_للانسكاب) {
        دع السجل: معرف_سجل_افتراضي = { القيمة: 0 };
        أرجع نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(السجل);
    };
    طابق خصص_تعليمة_إكس(التعليمة, &التعيينات) مع
    | نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل); }
    | نتيجة_تعليمة_إكس_مخصصة.نجحت(المخصصة) -> {
        ألحق(*الناتج, المخصصة);
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(بعد) مثل طبيعي)) {
            دع مرجع_بعد: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &بعد[ب];
            دع تعليمة_بعد: تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = انسخ_مملوكا_تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة(مرجع_بعد);
            ألحق(*الناتج, تعليمة_بعد);
            ب := ب + 1;
        }
        أرجع نتيجة_إضافة_تعليمات_إكس.نجحت();
    };
}

عرف خصص_كتلة_إكس_بخطة_انسكاب(
    الكتلة: &كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الحقائق: &متجه حقيقة_تعليمة_تخصيص,
    بداية_الكتلة: طبيعي,
    الخطة: &خطة_تخصيص_مع_انسكاب,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    سجلات_العمل: &متجه معرف_سجل_فعلي
): نتيجة_كتلة_إكس_مخصصة {
    دع ك: كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *الكتلة;
    دع التعليمات: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع أصول_التعليمات: متغير متجه مدى_أصل_تعليمات = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ك.التعليمات) مثل طبيعي)) {
        دع بداية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
        طابق أضف_تعليمة_إكس_بخطة_انسكاب(
            &ك.التعليمات[ف], &(*الحقائق)[بداية_الكتلة + ف], الخطة, الإطار, سجلات_العمل, &متغير التعليمات
        ) مع
        | نتيجة_إضافة_تعليمات_إكس.سجل_غير_مخصص(السجل) -> { أرجع نتيجة_كتلة_إكس_مخصصة.سجل_غير_مخصص(السجل); }
        | نتيجة_إضافة_تعليمات_إكس.حالة_انسكاب_غير_مدعومة(السجل) -> { أرجع نتيجة_كتلة_إكس_مخصصة.حالة_انسكاب_غير_مدعومة(السجل); }
        | نتيجة_إضافة_تعليمات_إكس.نجحت -> { };
        دع نهاية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
        طابق مرجع_تصحيح_تعليمة_آلة_عند(&ك.أصول_التعليمات, ف) مع
        | اختياري.موجود(مرجع_التصحيح) -> {
            لو (نهاية_الأصل > بداية_الأصل) {
                دع المدى: مدى_أصل_تعليمات = {
                    البداية: بداية_الأصل,
                    النهاية: نهاية_الأصل,
                    الأصل: مرجع_التصحيح.الأصل,
                    موقع_التصحيح: مرجع_التصحيح.موقع_التصحيح,
                    نطاق_التصحيح: مرجع_التصحيح.نطاق_التصحيح
                };
                ألحق(أصول_التعليمات, المدى);
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع مرجع_الرأس: &رأس_كتلة_منتقاة = &ك.الرأس;
    دع الرأس: رأس_كتلة_منتقاة = انسخ_مملوكا_رأس_كتلة_منتقاة(مرجع_الرأس);
    دع الناتج: كتلة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
        الرأس: الرأس, التعليمات: التعليمات, أصول_التعليمات: أصول_التعليمات
    };
    أرجع نتيجة_كتلة_إكس_مخصصة.نجحت(الناتج);
}

عرف خصص_كتلة_إكس(
    الكتلة: &كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    التعيينات: &متجه تعيين_سجل
): نتيجة_كتلة_إكس_مخصصة {
    دع ك: كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *الكتلة;
    دع التعليمات: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
    دع أصول_التعليمات: متغير متجه مدى_أصل_تعليمات = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ك.التعليمات) مثل طبيعي)) {
        دع بداية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
        طابق خصص_تعليمة_إكس(&ك.التعليمات[ف], التعيينات) مع
        | نتيجة_تعليمة_إكس_مخصصة.سجل_غير_مخصص(السجل) -> {
            أرجع نتيجة_كتلة_إكس_مخصصة.سجل_غير_مخصص(السجل);
        }
        | نتيجة_تعليمة_إكس_مخصصة.نجحت(التعليمة) -> {
            ألحق(التعليمات, التعليمة);
        };
        دع نهاية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
        طابق مرجع_تصحيح_تعليمة_آلة_عند(&ك.أصول_التعليمات, ف) مع
        | اختياري.موجود(مرجع_التصحيح) -> {
            لو (نهاية_الأصل > بداية_الأصل) {
                دع المدى: مدى_أصل_تعليمات = {
                    البداية: بداية_الأصل,
                    النهاية: نهاية_الأصل,
                    الأصل: مرجع_التصحيح.الأصل,
                    موقع_التصحيح: مرجع_التصحيح.موقع_التصحيح,
                    نطاق_التصحيح: مرجع_التصحيح.نطاق_التصحيح
                };
                ألحق(أصول_التعليمات, المدى);
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع مرجع_الرأس: &رأس_كتلة_منتقاة = &ك.الرأس;
    دع الرأس: رأس_كتلة_منتقاة = انسخ_مملوكا_رأس_كتلة_منتقاة(مرجع_الرأس);
    دع الناتج: كتلة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
        الرأس: الرأس,
        التعليمات: التعليمات,
        أصول_التعليمات: أصول_التعليمات
    };
    أرجع نتيجة_كتلة_إكس_مخصصة.نجحت(الناتج);
}

عام عرف خصص_دالة_إكس_ستة_وثمانون_أربعة_وستون(
    الدالة_المنتقاة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): نتيجة_تخصيص_دالة_إكس {
    دع و: واصف_هدف = *الهدف;
    طابق و.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> { أرجع نتيجة_تخصيص_دالة_إكس.هدف_غير_صالح(و.المعرف); };

    دع الدالة: دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *الدالة_المنتقاة;
    دع المسألة: مسألة_تخصيص = ابن_مسألة_تخصيص_دالة_إكس(&الدالة, الهدف);
    طابق خصص_السجلات_مع_انسكاب(&المسألة) مع
    | نتيجة_تخصيص_مع_انسكاب.فشل_قيود(السجل) -> {
        أرجع نتيجة_تخصيص_دالة_إكس.فشل_قيود(السجل);
    }
    | نتيجة_تخصيص_مع_انسكاب.مكتمل(الخطة) -> {
        طابق ابن_إطار_انسكاب_إكس(&الخطة.السجلات_المسكوبة, &الدالة.المواضع_المحلية, الهدف) مع
        | نتيجة_إطار_انسكاب_إكس.سياسة_غير_متاحة -> {
            أرجع نتيجة_تخصيص_دالة_إكس.سياسة_إطار_غير_متاحة(و.المعرف);
        }
        | نتيجة_إطار_انسكاب_إكس.نجح(الإطار) -> {
            دع الكتل: متغير متجه كتلة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
            // The spill scratch registers are a target fact: built once per
            // function, read by every spilled instruction.
            دع سجلات_العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_للهدف(الهدف);
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول(الدالة.الكتل) مثل طبيعي)) {
