        أرجع ألحق_تكوين_عنوان_مقاس_إكس(البايتات, الوجهة, الأساس, الفهرس, الحجم, الإزاحة, الهدف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.عنوان_موضع_محلي(الوجهة, المعرف) -> {
        أرجع ألحق_عنوان_موضع_محلي_إكس(البايتات, الوجهة, المعرف, الإطار);
