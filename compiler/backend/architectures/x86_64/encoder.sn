        دع خانة_العنصر_: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(8);
        دع خانة_السعة_: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(16);
        دع عنوان_الطول_: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س0, م.إزاحة_الطول);
        دع عنوان_السعة_: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س0, م.إزاحة_السعة);
        دع عنوان_البيانات_: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س0, م.إزاحة_البيانات);
        // rax = length; length >= capacity → grow (JAE rel32).
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول_, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_ب, &عنوان_السعة_, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_مقارنة_بعرض_إكس(البايتات, ركس_أ, سجل_ب, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x83);
        دع موضع_فرع_النمو: طبيعي = الطول(*البايتات) مثل طبيعي;
        ألحق_ط32_إكس(البايتات, 0);
        // store: destination = data + length * element_size, length + 1
        // committed before the element copy, which may use a work register.
        دع موضع_التخزين_: طبيعي = الطول(*البايتات) مثل طبيعي;
        طابق ألحق_نقل_سجل_إكس(البايتات, سجل_ب, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_ضرب_فوري_إلحاق_إكس(البايتات, سجل_ب, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س2, &عنوان_البيانات_, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, سجل_ب, س2, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, ركس_أ, ركس_أ));
        ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, 0xC0 + (ركس_أ.القيمة % 8)); ألحق_بايت_إكس(البايتات, 1);
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول_, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        إذا (م.العنصر_تجميعي) {
            طابق ألحق_نسخ_ذاكرة_إكس(البايتات, سجل_ب, س1, م.حجم_العنصر, 0, 0, الهدف) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        } وإلا {
            دع عنوان_العنصر_: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(سجل_ب, 0);
            طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س1, &عنوان_العنصر_, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        };
