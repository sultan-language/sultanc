        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_ب, &خانة_السعة_, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
