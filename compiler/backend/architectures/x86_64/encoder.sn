            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س0, &خانة_المتجه, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_البيانات, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_ب, &خانة_السعة, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_ب, &عنوان_السعة, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            دع نهاية_الحجز: طبيعي = الطول(*البايتات) مثل طبيعي;
