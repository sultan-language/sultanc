    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(د) مثل طبيعي)) {
        إذا (معرفا_دالة_منتقاة_متساويان(د[ف].الدالة, المعرف)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف ألحق_فرع_إكس_مؤجل(
    البايتات: &متغير متجه ط8,
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    الهدف: معرف_كتلة_منتقاة,
    شرطي: اختياري شرط_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    طابق شرطي مع
    | اختياري.موجود(الشرط) -> {
        ألحق_بايت_إكس(البايتات, 0x0F);
        ألحق_بايت_إكس(البايتات, 0x80 + رمز_شرط_إكس(الشرط));
    }
    | اختياري.لا_شيء -> {
        ألحق_بايت_إكس(البايتات, 0xE9);
    };
    دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_ط32_إكس(البايتات, 0);
    دع بعد: طبيعي = الطول(*البايتات) مثل طبيعي;

    دع التثبيت: تثبيت_فرع_إكس_مؤجل = {
        إزاحة_الحقل: الموضع,
        بعد_التعليمة: بعد,
        الهدف: الهدف
    };
    ألحق_فرع_إكس_للمشفّر(الفروع, التثبيت);

}

عرف سجلان_فعليان_متساويان_إكس(أ: معرف_سجل_فعلي, ب: معرف_سجل_فعلي): منطقي {
    أرجع معرفا_سجل_فعلي_متساويان(أ, ب);
}

عرف اختر_سجل_عمل_إكس(
    الهدف: &واصف_هدف,
    ممنوع1: اختياري معرف_سجل_فعلي,
    ممنوع2: اختياري معرف_سجل_فعلي,
    ممنوع3: اختياري معرف_سجل_فعلي
): اختياري معرف_سجل_فعلي {
    دع العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_للهدف(الهدف);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العمل) مثل طبيعي)) {
        دع س: معرف_سجل_فعلي = العمل[ف];
        دع مرفوض: متغير منطقي = خطأ;
        طابق ممنوع1 مع | اختياري.موجود(م) -> { إذا (سجلان_فعليان_متساويان_إكس(س, م)) { مرفوض := صواب; }; } | اختياري.لا_شيء -> { };
        طابق ممنوع2 مع | اختياري.موجود(م) -> { إذا (سجلان_فعليان_متساويان_إكس(س, م)) { مرفوض := صواب; }; } | اختياري.لا_شيء -> { };
        طابق ممنوع3 مع | اختياري.موجود(م) -> { إذا (سجلان_فعليان_متساويان_إكس(س, م)) { مرفوض := صواب; }; } | اختياري.لا_شيء -> { };
        إذا (!مرفوض) { أرجع اختياري.موجود(س); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ألحق_إزاحة_فورية_64_إكس(
    البايتات: &متغير متجه ط8,
    السجل: معرف_سجل_فعلي,
    المقدار: طبيعي,
    لليسار: منطقي
): نتيجة_دفعة_ترميز_إكس {
    إذا (المقدار == 0) { أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); };
    إذا (!سجل_إكس_قابل_للترميز(السجل) || المقدار >= 64) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(السجل)
        );
    };
    ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.لا_شيء(), اختياري.موجود(السجل)));
    ألحق_بايت_إكس(البايتات, 0xC1);
    دع الحقل: متغير طبيعي = 5;
    إذا (لليسار) { الحقل := 4; };
    دع حقل_مود: معرف_سجل_فعلي = { القيمة: الحقل };
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(حقل_مود, السجل));
    ألحق_بايت_إكس(البايتات, المقدار);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تحميل_جزء_تجميع_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
