        أرجع ألحق_نسخ_ذاكرة_إكس(البايتات, الوجهة, المصدر, الحجم, إزاحة_الوجهة, إزاحة_المصدر, الهدف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تخزين_فوري_ذاكرة(الأساس, الإزاحة, القيمة, الحجم) -> {
        أرجع ألحق_تخزين_فوري_ذاكرة_إكس(البايتات, الأساس, الإزاحة, القيمة, الحجم, الهدف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.امتداد_متجه(الامتداد) -> {
        أرجع ألحق_امتداد_متجه_إكس(البايتات, &الامتداد, الهدف, الإطار, النداءات, بداية_الدالة, فك_المكدس);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.إلحاق_متجه(الإلحاق) -> {
        أرجع ألحق_إلحاق_متجه_إكس(البايتات, &الإلحاق, الهدف, الإطار, النداءات, بداية_الدالة, فك_المكدس);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.عنوان_دالة(الوجهة, الدالة) -> {
        إذا (!سجل_إكس_قابل_للترميز(الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
            );
        };
        دع حقل: اختياري معرف_سجل_فعلي = اختياري.موجود(الوجهة);
        دع لا_قاعدة: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
        ألحق_بايت_إكس(البايتات, ركس_إكس(حقل, لا_قاعدة));
        ألحق_بايت_إكس(البايتات, 0x8D);
        ألحق_بايت_إكس(البايتات, 0x05 + ((الوجهة.القيمة % 8) * 8));
        دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
        ألحق_ط32_إكس(البايتات, 0);

        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدالة);
        دع الإضافة: عدد = -4;
        دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
            نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان();
        دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: الموضع, النوع: نوع_الإزاحة, الرمز: الرمز, الإضافة: الإضافة
        };
        ألحق_نداء_إكس_للمشفّر(النداءات, الإزاحة);

    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.عنوان_عام(الوجهة, العام, مستورد) -> {
        إذا (!سجل_إكس_قابل_للترميز(الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
            );
        };
        دع حقل: اختياري معرف_سجل_فعلي = اختياري.موجود(الوجهة);
        دع لا_قاعدة: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
        ألحق_بايت_إكس(البايتات, ركس_إكس(حقل, لا_قاعدة));
        // MOV r64, [RIP+disp32] loads the address from an imported GOT slot.
        // A defined local still needs the direct RIP-relative LEA.
        إذا (مستورد) { ألحق_بايت_إكس(البايتات, 0x8B); }
        وإلا { ألحق_بايت_إكس(البايتات, 0x8D); };
        ألحق_بايت_إكس(البايتات, 0x05 + ((الوجهة.القيمة % 8) * 8));
        دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
        ألحق_ط32_إكس(البايتات, 0);

        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.عام(العام);
        دع الإضافة: عدد = -4;
        إذا (مستورد) {
            // Object requests use a function-relative disp32 position. The
            // writer resolves this MSIR ID to its exact imported symbol.
            دع مكان: موضع_إزاحة_نص_كائن = {
                الدالة: معرف_الدالة,
                إزاحة_بايت: الموضع - بداية_الدالة
            };
            دع الطلب: طلب_إزاحة_نص_كائن = {
                الموضع: مكان,
                النوع: نوع_إزاحة_رمزية_كائن.تحميل_جوت_إكس_نسبي_اثنان_وثلاثون(),
                الرمز: الرمز,
                الإضافة: الإضافة
            };
            ألحق((*المرفقات).إزاحات_النص, الطلب);
        } وإلا {
            دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
                نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان();
            دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
                إزاحة_بايت: الموضع,
                النوع: نوع_الإزاحة,
                الرمز: الرمز,
                الإضافة: الإضافة
            };
            ألحق_نداء_إكس_للمشفّر(النداءات, الإزاحة);
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.بيئة_إغلاق(الوجهة) -> {
        طابق سجل_بيئة_إغلاق_للهدف(الهدف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم());
        }
        | اختياري.موجود(البيئة) -> {
            أرجع ألحق_نقل_سجل_إكس(البايتات, الوجهة, البيئة);
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.ثابت_نص(الثابت) -> {
        أرجع ألحق_ثابت_نص_إكس(
            البايتات, &الثابت, الهدف, الإطار, النداءات,
            المرفقات, معرف_الدالة, بداية_الدالة, فك_المكدس
        );
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تخصيص_صندوق(الوجهة, الحجم, المحاذاة) -> {
        أرجع ألحق_تخصيص_صندوق_إكس(البايتات, الوجهة, الحجم, المحاذاة, الهدف, الإطار, النداءات, بداية_الدالة, فك_المكدس);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تحميل(الوجهة, العنوان, الحجم, بإشارة) -> {
        إذا (!بإشارة && الحجم > 0 && الحجم <= 8) {
            أرجع ألحق_تحميل_جزء_تجميع_إكس(البايتات, الوجهة, &العنوان, الحجم, الهدف);
        };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, &العنوان, الحجم, بإشارة) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تخزين(المصدر, العنوان, الحجم) -> {
        إذا (الحجم > 0 && الحجم <= 8) {
            أرجع ألحق_تخزين_جزء_تجميع_إكس(البايتات, المصدر, &العنوان, الحجم, الهدف);
        };
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, المصدر, &العنوان, الحجم) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تحميل_عام(الوجهة, العام, الإزاحة, الحجم, بإشارة) -> {
        // The load's opcode as for a base register numbered below 8 (no
        // REX.B), then ModRM [RIP + disp32] with the global's relocation.
        دع لا_فهرس: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
        دع لا_أساس: معرف_سجل_فعلي = { القيمة: 0 };
        إذا (!سجل_إكس_قابل_للترميز(الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة));
        };
        إذا (الحجم == 1 || الحجم == 2) {
            ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, لا_فهرس, لا_أساس));
            ألحق_بايت_إكس(البايتات, 0x0F);
            إذا (الحجم == 1) {
                إذا (بإشارة) { ألحق_بايت_إكس(البايتات, 0xBE); } وإلا { ألحق_بايت_إكس(البايتات, 0xB6); };
            } وإلا {
                إذا (بإشارة) { ألحق_بايت_إكس(البايتات, 0xBF); } وإلا { ألحق_بايت_إكس(البايتات, 0xB7); };
            };
        } وإلا إذا (الحجم == 4) {
            ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(بإشارة, الوجهة, لا_فهرس, لا_أساس));
            إذا (بإشارة) { ألحق_بايت_إكس(البايتات, 0x63); } وإلا { ألحق_بايت_إكس(البايتات, 0x8B); };
        } وإلا إذا (الحجم == 8) {
            ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, لا_فهرس, لا_أساس));
            ألحق_بايت_إكس(البايتات, 0x8B);
        } وإلا {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم));
        };
        ألحق_بايت_إكس(البايتات, 0x05 + ((الوجهة.القيمة % 8) * 8));
        دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
        ألحق_ط32_إكس(البايتات, 0);
        دع الطلب: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: الموضع,
            النوع: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان(),
            الرمز: مرجع_رمز_كائن.عام(العام),
            الإضافة: الإزاحة - 4
        };
        ألحق_نداء_إكس_للمشفّر(النداءات, الطلب);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تخزين_عام(المصدر, العام, الإزاحة, الحجم) -> {
        دع لا_فهرس: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
        دع لا_أساس: معرف_سجل_فعلي = { القيمة: 0 };
        إذا (!سجل_إكس_قابل_للترميز(المصدر)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر));
        };
        إذا (!(الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم));
        };
        إذا (الحجم == 2) { ألحق_بايت_إكس(البايتات, 0x66); };
        // A byte store from SIL/DIL (or R8B and up) needs a REX prefix even
        // without W, which ركس_ذاكرة_إكس always gives (0x40 at least).
        ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(الحجم == 8, المصدر, لا_فهرس, لا_أساس));
        إذا (الحجم == 1) { ألحق_بايت_إكس(البايتات, 0x88); } وإلا { ألحق_بايت_إكس(البايتات, 0x89); };
        ألحق_بايت_إكس(البايتات, 0x05 + ((المصدر.القيمة % 8) * 8));
        دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
        ألحق_ط32_إكس(البايتات, 0);
        دع الطلب: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: الموضع,
            النوع: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان(),
            الرمز: مرجع_رمز_كائن.عام(العام),
            الإضافة: الإزاحة - 4
        };
        ألحق_نداء_إكس_للمشفّر(النداءات, الطلب);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.مقارنة_بعرض(أ, ب, البتات) -> {
        أرجع ألحق_مقارنة_بعرض_إكس(البايتات, أ, ب, البتات);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.مقارنة_فورية(أ, الفوري, البتات) -> {
        أرجع ألحق_مقارنة_فورية_بعرض_إكس(البايتات, أ, الفوري, البتات);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.مقارنة_فورية_إلى_منطق(الوجهة, أ, الفوري, الشرط, البتات) -> {
        طابق ألحق_مقارنة_فورية_بعرض_إكس(البايتات, أ, الفوري, البتات) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_ثبت_شرط_إلى_منطق_إكس(البايتات, الوجهة, الشرط);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.مقارنة_سجل(أ, ب) -> {
        إذا (!سجل_إكس_قابل_للترميز(أ)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(أ)
            );
        };
        إذا (!سجل_إكس_قابل_للترميز(ب)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(ب)
            );
        };
        // CMP r/m64, r64: flags = أ - ب.
        ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.موجود(ب), اختياري.موجود(أ)));
        ألحق_بايت_إكس(البايتات, 0x39);
        ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(ب, أ));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_جدولي(المميز, الأهداف, الافتراضي, الأدنى) -> {
        // R10/R11 محجوزان في Target ولا يخصصهما allocator لقيم عابرة.
        // mov r10d, selector32 (صفر التمديد)، فلا تقارن وسوما عريضة مع ط32.
        ألحق_بايت_إكس(البايتات, 0x41 + ((المميز.القيمة / 8) * 4));
        ألحق_بايت_إكس(البايتات, 0x89);
        ألحق_بايت_إكس(البايتات, 0xC2 + ((المميز.القيمة % 8) * 8));
        // sub r10d, lowest: a tag below it wraps above the range (unsigned).
        إذا (الأدنى != 0) {
            ألحق_بايت_إكس(البايتات, 0x41);
            ألحق_بايت_إكس(البايتات, 0x81);
            ألحق_بايت_إكس(البايتات, 0xEA);
            ألحق_ط32_إكس(البايتات, الأدنى);
        };
        // cmp r10d, last ; ja default (unsigned).
        ألحق_بايت_إكس(البايتات, 0x41);
        ألحق_بايت_إكس(البايتات, 0x81);
        ألحق_بايت_إكس(البايتات, 0xFA);
        ألحق_ط32_إكس(البايتات, (الطول(الأهداف) مثل طبيعي) - 1);
        ألحق_بايت_إكس(البايتات, 0x0F);
        ألحق_بايت_إكس(البايتات, 0x87);
        دع موضع_الافتراضي: طبيعي = الطول(*البايتات) مثل طبيعي;
        ألحق_ط32_إكس(البايتات, 0);
        دع تثبيت_الافتراضي: تثبيت_فرع_إكس_مؤجل = {
            إزاحة_الحقل: موضع_الافتراضي,
            بعد_التعليمة: الطول(*البايتات) مثل طبيعي,
            الهدف: الافتراضي
        };
        ألحق_فرع_إكس_للمشفّر(الفروع, تثبيت_الافتراضي);
        // lea r11,[rip+10] => جدول rel32 يلي قفزة r11 مباشرة.
        ألحق_بايت_إكس(البايتات, 0x4C); ألحق_بايت_إكس(البايتات, 0x8D);
        ألحق_بايت_إكس(البايتات, 0x1D); ألحق_ط32_إكس(البايتات, 10);
        // movsxd r10, dword ptr [r11+r10*4]; add r11,r10; jmp r11
        ألحق_بايت_إكس(البايتات, 0x4F); ألحق_بايت_إكس(البايتات, 0x63);
        ألحق_بايت_إكس(البايتات, 0x14); ألحق_بايت_إكس(البايتات, 0x93);
        ألحق_بايت_إكس(البايتات, 0x4D); ألحق_بايت_إكس(البايتات, 0x01);
        ألحق_بايت_إكس(البايتات, 0xD3);
        ألحق_بايت_إكس(البايتات, 0x41); ألحق_بايت_إكس(البايتات, 0xFF);
        ألحق_بايت_إكس(البايتات, 0xE3);
        دع بداية_الجدول: طبيعي = الطول(*البايتات) مثل طبيعي;
        دع فهرس: متغير طبيعي = 0;
        طالما (فهرس < (الطول(الأهداف) مثل طبيعي)) {
            دع موضع_الحقل: طبيعي = الطول(*البايتات) مثل طبيعي;
            ألحق_ط32_إكس(البايتات, 0);
            // جميع entries نسبية إلى بداية الجدول، لا إلى نهاية entry.
            دع تثبيت: تثبيت_فرع_إكس_مؤجل = {
                إزاحة_الحقل: موضع_الحقل,
                بعد_التعليمة: بداية_الجدول,
                الهدف: الأهداف[فهرس]
            };
            ألحق_فرع_إكس_للمشفّر(الفروع, تثبيت);
            فهرس := فهرس + 1;
        }
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز(الهدف) -> {
        ألحق_فرع_إكس_مؤجل(البايتات, الفروع, الهدف, اختياري.لا_شيء());
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_مع_نقلات(النقلات) -> {
        طابق ألحق_نقلات_حافة_إكس(البايتات, &النقلات, الهدف) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_فرع_إكس_مؤجل(البايتات, الفروع, النقلات.الهدف, اختياري.لا_شيء());
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي(الشرط, هدف_الفرع) -> {
        ألحق_فرع_إكس_مؤجل(البايتات, الفروع, هدف_الفرع, اختياري.موجود(الشرط));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_مع_نقلات(الشرط, النقلات) -> {
        ألحق_بايت_إكس(البايتات, 0x0F);
        ألحق_بايت_إكس(البايتات, 0x80 + رمز_شرط_معكوس_إكس(الشرط));
        دع موضع_التخطي: طبيعي = الطول(*البايتات) مثل طبيعي;
        ألحق_ط32_إكس(البايتات, 0);
        دع بعد_التخطي: طبيعي = الطول(*البايتات) مثل طبيعي;
        طابق ألحق_نقلات_حافة_إكس(البايتات, &النقلات, الهدف) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_فرع_إكس_مؤجل(البايتات, الفروع, النقلات.الهدف, اختياري.لا_شيء());
        دع بعد_الحزمة: طبيعي = الطول(*البايتات) مثل طبيعي;
        طابق إزاحة_نسبية_32(بعد_التخطي, بعد_الحزمة) مع
        | نتيجة_إزاحة_نسبية_32.خارج_المدى -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.فرع_خارج_مدى_نسبي_32(النقلات.الهدف)); }
        | نتيجة_إزاحة_نسبية_32.نجحت(الحقل) -> { اكتب_ط32_إكس(البايتات, موضع_التخطي, الحقل); };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_بقيمة(الشرط, النقلات) -> {
        ألحق_اختبار_سجل_إكس(البايتات, الشرط);
        ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x84);
        دع موضع_التخطي: طبيعي = الطول(*البايتات) مثل طبيعي;
        ألحق_ط32_إكس(البايتات, 0);
        دع بعد_التخطي: طبيعي = الطول(*البايتات) مثل طبيعي;
        طابق ألحق_نقلات_حافة_إكس(البايتات, &النقلات, الهدف) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_فرع_إكس_مؤجل(البايتات, الفروع, النقلات.الهدف, اختياري.لا_شيء());
        دع بعد_الحزمة: طبيعي = الطول(*البايتات) مثل طبيعي;
        طابق إزاحة_نسبية_32(بعد_التخطي, بعد_الحزمة) مع
        | نتيجة_إزاحة_نسبية_32.خارج_المدى -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.فرع_خارج_مدى_نسبي_32(النقلات.الهدف)); }
        | نتيجة_إزاحة_نسبية_32.نجحت(الحقل) -> { اكتب_ط32_إكس(البايتات, موضع_التخطي, الحقل); };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.فخ -> {
        ألحق_فخ_إكس(البايتات);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.سياج -> {
        // mfence
        ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0xAE); ألحق_بايت_إكس(البايتات, 0xF0);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.ذري(العملية, الوجهة, العنوان, القيمة, البتات) -> {
        أرجع ألحق_ذري_إكس(البايتات, العملية, الوجهة, العنوان, القيمة, البتات, الهدف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.ذري_قارن_وبدل(الوجهة, العنوان, المتوقع, الجديد, البتات) -> {
        أرجع ألحق_ذري_قارن_وبدل_إكس(البايتات, الوجهة, العنوان, المتوقع, الجديد, البتات, الهدف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.ذري_خزن(العنوان, القيمة, البتات) -> {
        // mov r11, value; xchg [address], r11 (a sequentially consistent store)
        دع رقم_الخدش: معرف_سجل_فعلي = { القيمة: 11 };
        طابق ألحق_نقل_سجل_إكس(البايتات, رقم_الخدش, القيمة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_عملية_ذاكرة_ذرية_إكس(البايتات, خطأ, البتات, خطأ, 0x87, رقم_الخدش, العنوان);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نداء_مباشر(الخطة) -> {
        // The thread clone is a kernel call whose child continues in its own
        // tail (ألحق_ذيل_استنساخ_خيط_إكس).
        دع استنساخ_خيط: متغير منطقي = خطأ;
        دع نداء_نواة_فعلي: متغير منطقي = خطأ;
        طابق الخطة.الهدف مع
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.نداء_نواة -> { نداء_نواة_فعلي := صواب; }
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.بدائي_تشغيل(البدائي_الهدف) -> {
            إذا (هويتا_بدائي_مترجم_متساويتان(البدائي_الهدف, هوية_بدائي_مترجم.استنساخ_خيط_نواة())) {
                استنساخ_خيط := صواب;
                نداء_نواة_فعلي := صواب;
            };
        }
        | _ -> { };
        إذا (نداء_نواة_فعلي) {
            // Linux AMD64: rax=number; rdi,rsi,rdx,r10,r8,r9=arguments.
            // Stage all sources before overwriting any input registers. The
            // allocator treats this instruction as a clobbering call boundary.
            دع نواة_فري_بي_إس_دي: منطقي = هدف_نواة_فري_بي_إس_دي_مباشر(الهدف);
            إذا ((!هدف_نواة_لينكس_مباشر(الهدف) && !(نواة_فري_بي_إس_دي && !استنساخ_خيط))
                || (الطول(الخطة.الحجج) مثل طبيعي) != 7) {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            };
            دع سجل_الحفظ: معرف_سجل_فعلي = { القيمة: 11 };
            // 64 bytes maintains the entry-aligned stack and never collides
            // with the existing spills above the pre-call stack pointer.
            دع حجم_المكدس: طبيعي = 64;
            ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(
                البايتات, حجم_المكدس, صواب, بداية_الدالة, فك_المكدس
            );
            // Reserve r11 for spill transfers only after saving every register
            // argument. Otherwise a spill staged early could overwrite a later
            // live argument whose allocated location is r11.
            دع مرحلة_حفظ: متغير طبيعي = 0;
            طالما (مرحلة_حفظ < 2) {
                دع ف: متغير طبيعي = 0;
                طالما (ف < 7) {
                    إذا (الخطة.الحجج[ف].تجميعي || الخطة.الحجج[ف].الحجم != 8) {
                        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                        );
                    };
                    دع من_سجل: متغير منطقي = خطأ;
                    طابق سجل_موقع_قيمة_إكس(&الخطة.الحجج[ف].الموقع) مع
                    | اختياري.موجود(_) -> { من_سجل := صواب; }
                    | اختياري.لا_شيء -> { };
                    إذا ((مرحلة_حفظ == 0 && من_سجل)
                        || (مرحلة_حفظ == 1 && !من_سجل)) {
                        طابق ألحق_حفظ_موقع_في_مكدس_نداء_إكس(
                            البايتات, &الخطة.الحجج[ف].الموقع, ف * 8,
                            حجم_المكدس, سجل_الحفظ
                        ) مع
                        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    };
                    ف := ف + 1;
                }
                مرحلة_حفظ := مرحلة_حفظ + 1;
            }
            // rax, rdi, rsi, rdx, r10, r8, r9 in Linux syscall slot order.
            دع أرقام_سجلات_النواة: متجه طبيعي = [0, 7, 6, 2, 10, 8, 9];
            دع سجلات_النواة: متغير متجه معرف_سجل_فعلي = [];
            دع موضع_سجل_النواة: متغير طبيعي = 0;
            طالما (موضع_سجل_النواة < 7) {
                دع سجل_النواة: معرف_سجل_فعلي = { القيمة: أرقام_سجلات_النواة[موضع_سجل_النواة] };
                ألحق(سجلات_النواة, سجل_النواة);
                موضع_سجل_النواة := موضع_سجل_النواة + 1;
            }
            دع ف: متغير طبيعي = 0;
            طالما (ف < 7) {
                دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(ف * 8);
                طابق ألحق_تحميل_ذاكرة_إكس(
                    البايتات, سجلات_النواة[ف], &العنوان, 8, خطأ
                ) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                ف := ف + 1;
            }
            // Instruction encoding, not an embedded preassembled runtime.
            إذا (استنساخ_خيط) {
                ألحق_ذيل_استنساخ_خيط_إكس(البايتات);
            } وإلا {
                ألحق_بايت_إكس(البايتات, 0x0F);
                ألحق_بايت_إكس(البايتات, 0x05);
                // FreeBSD flags an error with the carry set and the positive
                // errno in rax: jnc +3; neg rax gives std the Linux -errno.
                // It precedes the stack adjustment, which changes the flags.
                إذا (نواة_فري_بي_إس_دي) {
                    ألحق_بايت_إكس(البايتات, 0x73);
                    ألحق_بايت_إكس(البايتات, 0x03);
                    ألحق_بايت_إكس(البايتات, 0x48);
                    ألحق_بايت_إكس(البايتات, 0xF7);
                    ألحق_بايت_إكس(البايتات, 0xD8);
                };
            };
            ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(
                البايتات, حجم_المكدس, خطأ, بداية_الدالة, فك_المكدس
            );
            طابق الخطة.الناتج مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختياري.موجود(قيمة_الناتج) -> {
                إذا (قيمة_الناتج.تجميعي || قيمة_الناتج.الحجم != 8) {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                        خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                    );
                };
                دع سجل_ناتج_النواة: معرف_سجل_فعلي = { القيمة: 0 };
                دع مصدر_الناتج: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                    موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(سجل_ناتج_النواة);
                طابق ألحق_نقل_موقع_إكس(
                    البايتات, &مصدر_الناتج, &قيمة_الناتج.الموقع, سجل_الحفظ
                ) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            };
            أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
        };
        دع حجم_حجج_المكدس: طبيعي = حجم_حجج_مكدس_نداء_أجنبي_إكس(&الخطة, الهدف);
        دع عدد_الحفظ: طبيعي = عدد_عناوين_تجميع_نداء_إكس(&الخطة);
        دع حجم_هدف_غير_مباشر: متغير طبيعي = 0;
        طابق الخطة.الهدف مع
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.قيمة_دالة(_) -> { حجم_هدف_غير_مباشر := 8; }
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.عنوان_سي(_) -> { حجم_هدف_غير_مباشر := 8; }
        | _ -> { };
        دع موضع_حفظ_هدف_غير_مباشر: طبيعي = حجم_حجج_المكدس + عدد_الحفظ * 8;
        دع حجم_منطقة_النداء: طبيعي = موضع_حفظ_هدف_غير_مباشر + حجم_هدف_غير_مباشر;
        دع تعديل_المكدس: متغير طبيعي = 0;
        طابق تعديل_مكدس_نداء_مع_حجج_للهدف(
            الهدف, إطار.الحجم_بايت, حجم_منطقة_النداء
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.هدف_غير_صالح(وصف_الهدف.المعرف)
            );
        }
        | اختياري.موجود(القيمة) -> { تعديل_المكدس := القيمة; };
        دع سجل_عمل_النداء: اختياري معرف_سجل_فعلي = سجل_عمل_نقل_نداء_للهدف(الهدف);
        دع سجل_العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
        طابق سجل_عمل_النداء مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
            );
        }
        | اختياري.موجود(السجل) -> { سجل_العمل := السجل; };
        دع سجل_الجزء: متغير معرف_سجل_فعلي = { القيمة: 0 };
        طابق اختر_سجل_عمل_إكس(
            الهدف, اختياري.موجود(سجل_العمل), اختياري.لا_شيء(), اختياري.لا_شيء()
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()
            );
        }
        | اختياري.موجود(السجل) -> { سجل_الجزء := السجل; };

        ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, صواب, بداية_الدالة, فك_المكدس);

        // احفظ هدف النداء غير المباشر قبل ترتيب حجج ABI؛ قد تتداخل قيمة الهدف مع سجل حجة.
        طابق الخطة.الهدف مع
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.قيمة_دالة(الموقع) -> {
            طابق ألحق_حفظ_موقع_في_مكدس_نداء_إكس(
                البايتات, &الموقع, موضع_حفظ_هدف_غير_مباشر, تعديل_المكدس, سجل_العمل
            ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        }
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.عنوان_سي(الموقع) -> {
            طابق ألحق_حفظ_موقع_في_مكدس_نداء_إكس(
                البايتات, &الموقع, موضع_حفظ_هدف_غير_مباشر, تعديل_المكدس, سجل_العمل
            ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        }
        | _ -> { };

        // احفظ عناوين كل قيم التجميع قبل أي نقل إلى سجلات ABI قد يكتب فوق مصادرها.
        دع فهرس_الحفظ: متغير طبيعي = 0;
        دع فح: متغير طبيعي = 0;
        طالما (فح < (الطول(الخطة.الحجج) مثل طبيعي)) {
            إذا (الخطة.الحجج[فح].تجميعي) {
                دع إزاحة_الحفظ: طبيعي = حجم_حجج_المكدس + فهرس_الحفظ * 8;
                طابق ألحق_حفظ_موقع_في_مكدس_نداء_إكس(
                    البايتات, &الخطة.الحجج[فح].الموقع, إزاحة_الحفظ, تعديل_المكدس, سجل_العمل
                ) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                فهرس_الحفظ := فهرس_الحفظ + 1;
            };
            فح := فح + 1;
        }
        دع موضع_حفظ_الناتج: متغير اختياري طبيعي = اختياري.لا_شيء();
        طابق الخطة.الناتج مع
        | اختياري.موجود(الناتج) -> {
            إذا (الناتج.تجميعي) {
                دع إزاحة_الحفظ: طبيعي = حجم_حجج_المكدس + فهرس_الحفظ * 8;
                طابق ألحق_حفظ_موقع_في_مكدس_نداء_إكس(
                    البايتات, &الناتج.الموقع, إزاحة_الحفظ, تعديل_المكدس, سجل_العمل
                ) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                موضع_حفظ_الناتج := اختياري.موجود(إزاحة_الحفظ);
            };
        }
        | اختياري.لا_شيء -> { };

        // القيم غير التجميعية التي تمر على المكدس.
        دع ف_مكدس: متغير طبيعي = 0;
        طالما (ف_مكدس < (الطول(الخطة.الحجج) مثل طبيعي)) {
            دع مرجع_الحجة: &قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &الخطة.الحجج[ف_مكدس];
            دع الحجة: قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *مرجع_الحجة;
            إذا (!الحجة.تجميعي) {
                دع ج: متغير طبيعي = 0;
                طالما (ج < (الطول(الحجة.المواضع) مثل طبيعي)) {
                    طابق الحجة.المواضع[ج] مع
                    | موضع_جزء_واجهة.مكدس(موضع_المكدس) -> {
                        طابق ألحق_تخزين_حجة_مكدس_نداء_إكس(
                            البايتات, &الحجة.الموقع, &موضع_المكدس, تعديل_المكدس, سجل_العمل
                        ) مع
                        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    }
                    | _ -> { };
                    ج := ج + 1;
                }
            };
            ف_مكدس := ف_مكدس + 1;
        }

        // أجزاء التجميع المكدسية تقرأ من عنوان القيمة المحفوظ.
        فهرس_الحفظ := 0;
        دع فت: متغير طبيعي = 0;
        طالما (فت < (الطول(الخطة.الحجج) مثل طبيعي)) {
            دع مرجع_الحجة: &قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &الخطة.الحجج[فت];
            دع الحجة: قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *مرجع_الحجة;
            إذا (الحجة.تجميعي) {
                دع إزاحة_الحفظ: طبيعي = حجم_حجج_المكدس + فهرس_الحفظ * 8;
                دع عنوان_الحفظ: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(إزاحة_الحفظ);
                طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_العمل, &عنوان_الحفظ, 8, خطأ) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                // An aggregate wholly on the stack, in consecutive eightbytes
                // (SysV MEMORY class): one copy of its bytes.
                دع بداية_المكدس: متغير طبيعي = 0;
                دع متتالية: متغير منطقي = (الطول(الحجة.المواضع) مثل طبيعي) > 0;
                دع جم: متغير طبيعي = 0;
                طالما (جم < (الطول(الحجة.المواضع) مثل طبيعي)) {
                    طابق الحجة.المواضع[جم] مع
                    | موضع_جزء_واجهة.مكدس(موضع_المكدس) -> {
                        إذا (جم == 0) { بداية_المكدس := موضع_المكدس.الإزاحة; };
                        إذا (موضع_المكدس.الإزاحة != بداية_المكدس + جم * 8) { متتالية := خطأ; };
                    }
                    | _ -> { متتالية := خطأ; };
                    جم := جم + 1;
                }
                إذا (متتالية && الحجة.الحجم > (الطول(الحجة.المواضع) مثل طبيعي) * 8) { متتالية := خطأ; };
                إذا (متتالية) {
                    دع مؤشر_المكدس: معرف_سجل_فعلي = { القيمة: 4 };
                    طابق ألحق_نسخ_ذاكرة_إكس(البايتات, مؤشر_المكدس, سجل_العمل, الحجة.الحجم, بداية_المكدس, 0, الهدف) مع
                    | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                };
                دع ج: متغير طبيعي = 0;
                طالما (ج < (الطول(الحجة.المواضع) مثل طبيعي) && !متتالية) {
                    طابق الحجة.المواضع[ج] مع
                    | موضع_جزء_واجهة.مكدس(موضع_المكدس) -> {
                        دع حجم_الجزء: طبيعي = حجم_جزء_تجميع_واجهة_إكس(الحجة.الحجم, ج);
                        دع عنوان_المصدر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                            عنوان_سجل_بإزاحة_إكس(سجل_العمل, ج * 8);
                        طابق ألحق_تحميل_جزء_تجميع_إكس(
                            البايتات, سجل_الجزء, &عنوان_المصدر, حجم_الجزء, الهدف
                        ) مع
                        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        دع عنوان_الوجهة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                            عنوان_مكدس_إكس(موضع_المكدس.الإزاحة);
                        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_الجزء, &عنوان_الوجهة, 8) مع
                        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    }
                    | _ -> { };
                    ج := ج + 1;
                }
                فهرس_الحفظ := فهرس_الحفظ + 1;
            };
            فت := فت + 1;
        }

        // حمّل حجج SSE أولا من تمثيلها الخام في GPR/spill إلى سجلات XMM المقننة.
        دع ف_عائم: متغير طبيعي = 0;
        طالما (ف_عائم < (الطول(الخطة.الحجج) مثل طبيعي)) {
            دع مرجع_الحجة_عائمة: &قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &الخطة.الحجج[ف_عائم];
            دع الحجة_عائمة: قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *مرجع_الحجة_عائمة;
            إذا (!الحجة_عائمة.تجميعي && (الطول(الحجة_عائمة.المواضع) مثل طبيعي) == 1) {
                طابق الحجة_عائمة.المواضع[0] مع
                | موضع_جزء_واجهة.سجل(مرجع_عائم) -> {
                    إذا (مرجع_عائم.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                        دع المصدر_المعدل: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                            عدل_مصدر_نداء_بعد_خفض_المكدس_إكس(&الحجة_عائمة.الموقع, تعديل_المكدس);
                        دع موقع_العمل: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                            موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(سجل_العمل);
                        طابق ألحق_نقل_موقع_إكس(البايتات, &المصدر_المعدل, &موقع_العمل, سجل_الجزء) مع
                        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(
                            البايتات, مرجع_عائم.الفهرس, سجل_العمل, الحجة_عائمة.الحجم * 8
                        ) مع
                        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    };
                }
                | _ -> { };
            };
            ف_عائم := ف_عائم + 1;
        }

        // حجج scalar في السجلات تنفذ كنقل متواز.
        دع نقلات_السجل: متغير متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الخطة.الحجج) مثل طبيعي)) {
            دع مرجع_الحجة: &قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &الخطة.الحجج[ف];
            دع الحجة: قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *مرجع_الحجة;
            إذا (!الحجة.تجميعي) {
                دع ج: متغير طبيعي = 0;
                طالما (ج < (الطول(الحجة.المواضع) مثل طبيعي)) {
                    طابق الحجة.المواضع[ج] مع
                    | موضع_جزء_واجهة.سجل(مرجع_الواجهة) -> {
                        إذا (مرجع_الواجهة.الفئة != فئة_سجل_واجهة.عائم_متجه()) {
                            طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_الواجهة) مع
                            | اختياري.لا_شيء -> {
                                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                                );
                            }
                            | اختياري.موجود(الوجهة) -> {
                                دع المصدر: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                    عدل_مصدر_نداء_بعد_خفض_المكدس_إكس(&الحجة.الموقع, تعديل_المكدس);
                                دع موقع_الوجهة: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                    موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(الوجهة);
                                دع النقلة: نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = {
                                    المصدر: المصدر,
                                    الوجهة: موقع_الوجهة
                                };
                                ألحق(نقلات_السجل, النقلة);
                            };
                        };
                    }
                    | _ -> { };
                    ج := ج + 1;
                }
            };
            ف := ف + 1;
        }
        طابق ألحق_نقلات_مواقع_متوازية_إكس(البايتات, &نقلات_السجل, الهدف) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

        // حمّل أجزاء التجميع السجلية بعد النقل المتوازي من العناوين التي حفظناها.
        فهرس_الحفظ := 0;
        فت := 0;
        طالما (فت < (الطول(الخطة.الحجج) مثل طبيعي)) {
            دع مرجع_الحجة: &قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &الخطة.الحجج[فت];
            دع الحجة: قيمة_نداء_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *مرجع_الحجة;
            إذا (الحجة.تجميعي) {
                دع إزاحة_الحفظ: طبيعي = حجم_حجج_المكدس + فهرس_الحفظ * 8;
                دع عنوان_الحفظ: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(إزاحة_الحفظ);
                طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_العمل, &عنوان_الحفظ, 8, خطأ) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                دع ج: متغير طبيعي = 0;
                طالما (ج < (الطول(الحجة.المواضع) مثل طبيعي)) {
                    طابق الحجة.المواضع[ج] مع
                    | موضع_جزء_واجهة.سجل(مرجع_الواجهة) -> {
                        إذا (مرجع_الواجهة.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                            دع حجم_الجزء_العائم: طبيعي = حجم_جزء_تجميع_واجهة_إكس(الحجة.الحجم, ج);
                            دع عنوان_المصدر_العائم: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                عنوان_سجل_بإزاحة_إكس(سجل_العمل, ج * 8);
                            طابق ألحق_تحميل_جزء_تجميع_إكس(
                                البايتات, سجل_الجزء, &عنوان_المصدر_العائم, حجم_الجزء_العائم, الهدف
                            ) مع
                            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                            طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(
                                البايتات, مرجع_الواجهة.الفهرس, سجل_الجزء, حجم_الجزء_العائم * 8
                            ) مع
                            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        } وإلا {
                            طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_الواجهة) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                            );
                        }
                        | اختياري.موجود(الوجهة) -> {
                            دع حجم_الجزء: طبيعي = حجم_جزء_تجميع_واجهة_إكس(الحجة.الحجم, ج);
                            دع عنوان_المصدر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                عنوان_سجل_بإزاحة_إكس(سجل_العمل, ج * 8);
                            طابق ألحق_تحميل_جزء_تجميع_إكس(
                                البايتات, الوجهة, &عنوان_المصدر, حجم_الجزء, الهدف
                            ) مع
                            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        };
                        };
                    }
                    | _ -> { };
                    ج := ج + 1;
                }
                فهرس_الحفظ := فهرس_الحفظ + 1;
            };
            فت := فت + 1;
        }

        // النتيجة التجميعية غير المباشرة تمر بعنوان التخزين في الموضع الذي صنفه Target.
        طابق الخطة.الناتج مع
        | اختياري.موجود(الناتج) -> {
            إذا (الناتج.تجميعي && الناتج.غير_مباشر) {
                طابق موضع_حفظ_الناتج مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                        خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                    );
                }
                | اختياري.موجود(إزاحة_الحفظ) -> {
                    إذا ((الطول(الناتج.المواضع) مثل طبيعي) != 1) {
                        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                        );
                    };
                    طابق الناتج.المواضع[0] مع
                    | موضع_جزء_واجهة.سجل(المرجع) -> {
                        طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &المرجع) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                            );
                        }
                        | اختياري.موجود(الوجهة) -> {
                            دع عنوان_الحفظ: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                عنوان_مكدس_إكس(إزاحة_الحفظ);
                            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, &عنوان_الحفظ, 8, خطأ) مع
                            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        };
                    }
                    | موضع_جزء_واجهة.مكدس(_) -> {
                        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                        );
                    };
                };
            };
        }
        | اختياري.لا_شيء -> { };

        طابق الخطة.الهدف مع
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.دالة(الدالة) -> {
            ألحق_بايت_إكس(البايتات, 0xE8);
            دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
            ألحق_ط32_إكس(البايتات, 0);

            دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدالة);
            دع الإضافة: عدد = -4;
            دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
                نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
            دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
                إزاحة_بايت: الموضع, النوع: نوع_الإزاحة, الرمز: الرمز, الإضافة: الإضافة
            };
            ألحق_نداء_إكس_للمشفّر(النداءات, الإزاحة);

        }
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.دالة_خارجية(المعرف) -> {
            إذا (الخطة.متغيرة) { ألحق_حد_متجهات_نداء_متغير_إكس(البايتات); };
            ألحق_بايت_إكس(البايتات, 0xE8);
            دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
            ألحق_ط32_إكس(البايتات, 0);

            دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.رمز_خارجي(المعرف);
            دع الإضافة: عدد = -4;
            دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
                نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
            دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
                إزاحة_بايت: الموضع, النوع: نوع_الإزاحة, الرمز: الرمز, الإضافة: الإضافة
            };
            ألحق_نداء_إكس_للمشفّر(النداءات, الإزاحة);

        }
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.بدائي_تشغيل(البدائي) -> {
            ألحق_بايت_إكس(البايتات, 0xE8);
            دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
            ألحق_ط32_إكس(البايتات, 0);

            دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.بدائي_تشغيل(البدائي);
            دع الإضافة: عدد = -4;
            دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
                نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
            دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
                إزاحة_بايت: الموضع, النوع: نوع_الإزاحة, الرمز: الرمز, الإضافة: الإضافة
            };
            ألحق_نداء_إكس_للمشفّر(النداءات, الإزاحة);

        }
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.قيمة_دالة(_) -> {
            دع عنوان_الهدف: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                عنوان_مكدس_إكس(موضع_حفظ_هدف_غير_مباشر);
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_العمل, &عنوان_الهدف, 8, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            دع سجل_البيئة: معرف_سجل_فعلي;
            طابق سجل_بيئة_إغلاق_للهدف(الهدف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختياري.موجود(السجل) -> { سجل_البيئة := السجل; };
            طابق ألحق_نقل_سجل_إكس(البايتات, سجل_البيئة, سجل_العمل) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            دع لا_فهرس: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
            دع قاعدة_البيئة: اختياري معرف_سجل_فعلي = اختياري.موجود(سجل_البيئة);
            دع عنوان_الشفرة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
                الأساس: قاعدة_البيئة, الفهرس: لا_فهرس, المقياس: 1, الإزاحة: 0
            };
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_العمل, &عنوان_الشفرة, 8, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            إذا (!سجل_إكس_قابل_للترميز(سجل_العمل)) {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(سجل_العمل)
                );
            };
            دع لا_حقل: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
            دع قاعدة: اختياري معرف_سجل_فعلي = اختياري.موجود(سجل_العمل);
            ألحق_بايت_إكس(البايتات, ركس_إكس(لا_حقل, قاعدة));
            ألحق_بايت_إكس(البايتات, 0xFF);
            ألحق_بايت_إكس(البايتات, 0xD0 + (سجل_العمل.القيمة % 8));
        }
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.عنوان_سي(_) -> {
            // The C function at the saved address: every argument is already
            // in its System V register or stack slot. AL bounds the vector
            // registers a variadic callee saves (all eight may carry
            // arguments); RAX is no argument register. Then CALL r11.
            دع عنوان_الهدف_سي: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                عنوان_مكدس_إكس(موضع_حفظ_هدف_غير_مباشر);
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_العمل, &عنوان_الهدف_سي, 8, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            إذا (!سجل_إكس_قابل_للترميز(سجل_العمل) || سجل_العمل.القيمة == 0) {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(سجل_العمل)
                );
            };
            // mov eax, 8
            ألحق_بايت_إكس(البايتات, 0xB8);
            ألحق_ط32_إكس(البايتات, 8);
            دع لا_حقل_سي: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
            دع قاعدة_سي: اختياري معرف_سجل_فعلي = اختياري.موجود(سجل_العمل);
            ألحق_بايت_إكس(البايتات, ركس_إكس(لا_حقل_سي, قاعدة_سي));
            ألحق_بايت_إكس(البايتات, 0xFF);
            ألحق_بايت_إكس(البايتات, 0xD0 + (سجل_العمل.القيمة % 8));
        }
        | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص.نداء_نواة -> {
            // Kernel entries are fully encoded by the dedicated arm above.
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
            );
        };

        // أعد تركيب النتيجة التجميعية المباشرة قبل تحرير منطقة النداء وحفظ العنوان.
        طابق الخطة.الناتج مع
        | اختياري.موجود(الناتج) -> {
            إذا (الناتج.تجميعي && !الناتج.غير_مباشر) {
                طابق موضع_حفظ_الناتج مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                        خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                    );
                }
                | اختياري.موجود(إزاحة_الحفظ) -> {
                    دع عنوان_الحفظ: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                        عنوان_مكدس_إكس(إزاحة_الحفظ);
                    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_العمل, &عنوان_الحفظ, 8, خطأ) مع
                    | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    دع ج: متغير طبيعي = 0;
                    طالما (ج < (الطول(الناتج.المواضع) مثل طبيعي)) {
                        طابق الناتج.المواضع[ج] مع
                        | موضع_جزء_واجهة.سجل(المرجع) -> {
                            إذا (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                                دع حجم_الجزء_العائم: طبيعي = حجم_جزء_تجميع_واجهة_إكس(الناتج.الحجم, ج);
                                طابق ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(
                                    البايتات, سجل_الجزء, المرجع.الفهرس, حجم_الجزء_العائم * 8
                                ) مع
                                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                                دع عنوان_الوجهة_العائمة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                    عنوان_سجل_بإزاحة_إكس(سجل_العمل, ج * 8);
                                طابق ألحق_تخزين_جزء_تجميع_إكس(
                                    البايتات, سجل_الجزء, &عنوان_الوجهة_العائمة, حجم_الجزء_العائم, الهدف
                                ) مع
                                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                            } وإلا {
                            طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &المرجع) مع
                            | اختياري.لا_شيء -> {
                                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                                );
                            }
                            | اختياري.موجود(المصدر) -> {
                                دع حجم_الجزء: طبيعي = حجم_جزء_تجميع_واجهة_إكس(الناتج.الحجم, ج);
                                دع عنوان_الوجهة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                    عنوان_سجل_بإزاحة_إكس(سجل_العمل, ج * 8);
                                طابق ألحق_تخزين_جزء_تجميع_إكس(
                                    البايتات, المصدر, &عنوان_الوجهة, حجم_الجزء, الهدف
                                ) مع
                                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                            };
                            };
                        }
                        | موضع_جزء_واجهة.مكدس(_) -> {
                            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                            );
                        };
                        ج := ج + 1;
                    }
                };
            };
        }
        | اختياري.لا_شيء -> { };

        ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, خطأ, بداية_الدالة, فك_المكدس);

        // نتائج scalar تنقل بعد استعادة RSP كي تكون إزاحات الانسكاب من إطار الدالة صحيحة.
        طابق الخطة.الناتج مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الناتج) -> {
            إذا (!الناتج.تجميعي) {
                إذا ((الطول(الناتج.المواضع) مثل طبيعي) != 1) {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                        خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                    );
                };
                طابق الناتج.المواضع[0] مع
                | موضع_جزء_واجهة.سجل(مرجع_الواجهة) -> {
                    إذا (مرجع_الواجهة.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                        طابق ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(
                            البايتات, سجل_العمل, مرجع_الواجهة.الفهرس, الناتج.الحجم * 8
                        ) مع
                        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        دع موقع_المصدر_عائم: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                            موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(سجل_العمل);
                        طابق ألحق_نقل_موقع_إكس(البايتات, &موقع_المصدر_عائم, &الناتج.الموقع, سجل_الجزء) مع
                        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    } وإلا {
                        طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_الواجهة) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                            );
                        }
                        | اختياري.موجود(المصدر) -> {
                            دع موقع_المصدر: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(المصدر);
                            طابق ألحق_نقل_موقع_إكس(
                                البايتات, &موقع_المصدر, &الناتج.الموقع, سجل_العمل
                            ) مع
                            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        };
                    };
                }
                | موضع_جزء_واجهة.مكدس(_) -> {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                        خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                    );
                };
            };
        };
    }

    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.عودة -> {
        دع عدد_البايتات_قبل_الخاتمة: طبيعي = الطول(*البايتات) مثل طبيعي;
        دع بداية_الخاتمة: طبيعي = عدد_البايتات_قبل_الخاتمة - بداية_الدالة;
        سجل_حفظ_حالة_فك_المكدس(فك_المكدس, بداية_الخاتمة);
        طابق ألحق_حفظ_المحفوظة_إكس(البايتات, &إطار, صواب, الهدف, بداية_الدالة, فك_المكدس) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, إطار.الحجم_بايت, خطأ, بداية_الدالة, فك_المكدس);
        ألحق_بايت_إكس(البايتات, 0xC3);
        دع عدد_البايتات_بعد_الخاتمة: طبيعي = الطول(*البايتات) مثل طبيعي;
        دع نهاية_الخاتمة: طبيعي = عدد_البايتات_بعد_الخاتمة - بداية_الدالة;
        سجل_استعادة_حالة_فك_المكدس(فك_المكدس, نهاية_الخاتمة);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.عودة_بقيمة(الناتج) -> {
        دع مرجع_القيمة: &قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &الناتج.القيمة;
        دع القيمة: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *مرجع_القيمة;
        إذا (القيمة.تجميعي) {
            إذا (القيمة.غير_مباشر) {
                طابق الناتج.عنوان_ناتج_غير_مباشر مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                        خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                    );
                }
                | اختياري.موجود(عنوان_الناتج) -> {
                    طابق ألحق_نسخ_ذاكرة_إكس(
                        البايتات, عنوان_الناتج, القيمة.السجل, القيمة.الحجم, 0, 0, الهدف
                    ) مع
                    | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    طابق مرجع_إرجاع_عنوان_ناتج_غير_مباشر_للهدف(الهدف) مع
                    | اختياري.موجود(مرجع_العودة) -> {
                        طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_العودة) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                            );
                        }
                        | اختياري.موجود(سجل_العودة) -> {
                            طابق ألحق_نقل_سجل_إكس(البايتات, سجل_العودة, عنوان_الناتج) مع
                            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                };
            } وإلا {
                دع قاعدة_الناتج: متغير معرف_سجل_فعلي = { القيمة: 0 };
                طابق سجل_عمل_نقل_نداء_للهدف(الهدف) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                        خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                    );
                }
                | اختياري.موجود(السجل) -> { قاعدة_الناتج := السجل; };
                // Scratch register for staging SSE parts; never the result base.
                دع سجل_الجزء: متغير معرف_سجل_فعلي = { القيمة: 0 };
                طابق اختر_سجل_عمل_إكس(
                    الهدف, اختياري.موجود(قاعدة_الناتج), اختياري.لا_شيء(), اختياري.لا_شيء()
                ) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                        خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()
                    );
                }
                | اختياري.موجود(السجل) -> { سجل_الجزء := السجل; };
                طابق ألحق_نقل_سجل_إكس(البايتات, قاعدة_الناتج, القيمة.السجل) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                دع ج: متغير طبيعي = 0;
                طالما (ج < (الطول(القيمة.المواضع) مثل طبيعي)) {
                    طابق القيمة.المواضع[ج] مع
                    | موضع_جزء_واجهة.سجل(مرجع_الواجهة) -> {
                        إذا (مرجع_الواجهة.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                            دع حجم_الجزء_العائم: طبيعي = حجم_جزء_تجميع_واجهة_إكس(القيمة.الحجم, ج);
                            دع عنوان_المصدر_العائم: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                عنوان_سجل_بإزاحة_إكس(قاعدة_الناتج, ج * 8);
                            طابق ألحق_تحميل_جزء_تجميع_إكس(
                                البايتات, سجل_الجزء, &عنوان_المصدر_العائم, حجم_الجزء_العائم, الهدف
                            ) مع
                            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                            طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(
                                البايتات, مرجع_الواجهة.الفهرس, سجل_الجزء, حجم_الجزء_العائم * 8
                            ) مع
                            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        } وإلا {
                            طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_الواجهة) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                            );
                        }
                        | اختياري.موجود(الوجهة) -> {
                            دع حجم_الجزء: طبيعي = حجم_جزء_تجميع_واجهة_إكس(القيمة.الحجم, ج);
                            دع عنوان_المصدر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
                                عنوان_سجل_بإزاحة_إكس(قاعدة_الناتج, ج * 8);
                            طابق ألحق_تحميل_جزء_تجميع_إكس(
                                البايتات, الوجهة, &عنوان_المصدر, حجم_الجزء, الهدف
                            ) مع
                            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                        };
                        };
                    }
                    | موضع_جزء_واجهة.مكدس(_) -> {
                        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                        );
                    };
                    ج := ج + 1;
                }
            };
        } وإلا {
            إذا ((الطول(القيمة.المواضع) مثل طبيعي) != 1) {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            };
            طابق القيمة.المواضع[0] مع
            | موضع_جزء_واجهة.سجل(مرجع_الواجهة) -> {
                إذا (مرجع_الواجهة.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(
                        البايتات, مرجع_الواجهة.الفهرس, القيمة.السجل, القيمة.الحجم * 8
                    ) مع
                    | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                } وإلا {
                    طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_الواجهة) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                        );
                    }
                    | اختياري.موجود(الوجهة) -> {
                        طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, القيمة.السجل) مع
                        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    };
                };
            }
            | موضع_جزء_واجهة.مكدس(_) -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            };
        };
        دع عدد_البايتات_قبل_الخاتمة: طبيعي = الطول(*البايتات) مثل طبيعي;
        دع بداية_الخاتمة: طبيعي = عدد_البايتات_قبل_الخاتمة - بداية_الدالة;
        سجل_حفظ_حالة_فك_المكدس(فك_المكدس, بداية_الخاتمة);
        طابق ألحق_حفظ_المحفوظة_إكس(البايتات, &إطار, صواب, الهدف, بداية_الدالة, فك_المكدس) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, إطار.الحجم_بايت, خطأ, بداية_الدالة, فك_المكدس);
        ألحق_بايت_إكس(البايتات, 0xC3);
        دع عدد_البايتات_بعد_الخاتمة: طبيعي = الطول(*البايتات) مثل طبيعي;
        دع نهاية_الخاتمة: طبيعي = عدد_البايتات_بعد_الخاتمة - بداية_الدالة;
        سجل_استعادة_حالة_فك_المكدس(فك_المكدس, نهاية_الخاتمة);
    }

    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.إعادة_تحميل_انسكاب(السجل, الموقع) -> {
        أرجع ألحق_تحميل_انسكاب_إكس(البايتات, السجل, &الموقع);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تخزين_انسكاب(الموقع, السجل) -> {
        أرجع ألحق_تخزين_انسكاب_إكس(البايتات, &الموقع, السجل);
    };
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}


// Edge moves whose every source already is its destination emit nothing.
عرف نقلات_حافة_بديهية_إكس(
    النقلات: &متطلبات_نقل_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النقلات).النقلات) مثل طبيعي)) {
        إذا (!موقعا_قيمة_إكس_متساويان(&(*النقلات).النقلات[ف].المصدر, &(*النقلات).النقلات[ف].الوجهة)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The target of an unconditional jump without moves, if that is the
// instruction.
عرف هدف_قفز_مجرد_إكس(
    التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة
): اختياري معرف_كتلة_منتقاة {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز(الهدف) -> { أرجع اختياري.موجود(الهدف); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_مع_نقلات(النقلات) -> {
        إذا (نقلات_حافة_بديهية_إكس(&النقلات)) { أرجع اختياري.موجود(النقلات.الهدف); };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// Jump threading: a block that only jumps forwards every branch into it to
// its final target (indexed by block id; a block that does not forward, or
// whose chain loops, maps to itself). Such blocks are then never entered and
// are not emitted, except the entry block.
عرف ابن_تمريرات_كتل_إكس(
    الكتل: &متجه كتلة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة
): متجه معرف_كتلة_منتقاة {
    دع العدد_الأقصى: متغير طبيعي = 0;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(*الكتل) مثل طبيعي)) {
        إذا ((*الكتل)[ك].الرأس.المعرف.القيمة + 1 > العدد_الأقصى) {
            العدد_الأقصى := (*الكتل)[ك].الرأس.المعرف.القيمة + 1;
        };
        ك := ك + 1;
    }
    دع المباشرة: متغير متجه معرف_كتلة_منتقاة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد_الأقصى) {
        دع ذاته: معرف_كتلة_منتقاة = { القيمة: ف };
        ألحق(المباشرة, ذاته);
        ف := ف + 1;
    }
    ك := 0;
    طالما (ك < (الطول(*الكتل) مثل طبيعي)) {
        // Register moves that allocation made into self-moves encode nothing.
        دع العدد: طبيعي = الطول((*الكتل)[ك].التعليمات) مثل طبيعي;
        دع فارغة: متغير منطقي = العدد >= 1;
        دع ت: متغير طبيعي = 0;
        طالما (فارغة && ت + 1 < العدد) {
            طابق (*الكتل)[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نقل_سجل(و, م) -> {
                إذا (و.القيمة != م.القيمة) { فارغة := خطأ; };
            }
            | _ -> { فارغة := خطأ; };
            ت := ت + 1;
        }
        إذا (فارغة) {
            طابق هدف_قفز_مجرد_إكس(&(*الكتل)[ك].التعليمات[العدد - 1]) مع
            | اختياري.موجود(الهدف) -> {
                إذا (الهدف.القيمة < العدد_الأقصى) {
                    المباشرة[(*الكتل)[ك].الرأس.المعرف.القيمة] := الهدف;
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ك := ك + 1;
    }
    دع النهائية: متغير متجه معرف_كتلة_منتقاة = [];
    ف := 0;
    طالما (ف < العدد_الأقصى) {
        دع الحالي: متغير معرف_كتلة_منتقاة = { القيمة: ف };
        دع الخطوات: متغير طبيعي = 0;
        طالما (المباشرة[الحالي.القيمة].القيمة != الحالي.القيمة && الخطوات <= العدد_الأقصى) {
            الحالي := المباشرة[الحالي.القيمة];
            الخطوات := الخطوات + 1;
        }
        إذا (الخطوات > العدد_الأقصى) {
            // A cycle of jump-only blocks (an empty infinite loop): keep it.
            دع ذاته: معرف_كتلة_منتقاة = { القيمة: ف };
            الحالي := ذاته;
        };
        ألحق(النهائية, الحالي);
        ف := ف + 1;
    }
    أرجع النهائية;
}

عرف حل_تمرير_كتلة_إكس(
    التمريرات: &متجه معرف_كتلة_منتقاة,
    الهدف: معرف_كتلة_منتقاة
): معرف_كتلة_منتقاة {
    إذا (الهدف.القيمة < (الطول(*التمريرات) مثل طبيعي)) { أرجع (*التمريرات)[الهدف.القيمة]; };
    أرجع الهدف;
}

عرف كتلة_تالية_هي_إكس(
    التالية: &اختياري معرف_كتلة_منتقاة,
    الهدف: معرف_كتلة_منتقاة
): منطقي {
    طابق *التالية مع
    | اختياري.موجود(ك) -> { أرجع ك.القيمة == الهدف.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// A jump to the (threaded) target, omitted when that block is laid out next.
// A branch back to a block already laid out within reach of a signed
// byte: the two-byte JMP rel8 or Jcc rel8 (الرمز: 0xEB, or 0x70 + the
// condition code), and true. A forward branch keeps its 32-bit form: its
// target's offset is not known yet.
عرف ألحق_فرع_قصير_للخلف_إكس(
    البايتات: &متغير متجه ط8,
    المواقع: &متجه موضع_كتلة_إكس,
    الهدف: معرف_كتلة_منتقاة,
    الرمز: طبيعي
): منطقي {
    طابق ابحث_موضع_كتلة_إكس(المواقع, الهدف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(موضع_الهدف) -> {
        دع بعد: طبيعي = (الطول(*البايتات) مثل طبيعي) + 2;
        إذا (موضع_الهدف > بعد || بعد - موضع_الهدف > 128) { أرجع خطأ; };
        ألحق_بايت_إكس(البايتات, الرمز);
        ألحق_بايت_إكس(البايتات, 256 - (بعد - موضع_الهدف));
        أرجع صواب;
    };
}

عرف ألحق_قفز_مخطط_إكس(
    البايتات: &متغير متجه ط8,
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    التمريرات: &متجه معرف_كتلة_منتقاة,
    التالية: &اختياري معرف_كتلة_منتقاة,
    الهدف: معرف_كتلة_منتقاة,
    المواقع: &متجه موضع_كتلة_إكس
): فراغ {
    دع النهائي: معرف_كتلة_منتقاة = حل_تمرير_كتلة_إكس(التمريرات, الهدف);
    إذا (!كتلة_تالية_هي_إكس(التالية, النهائي)) {
        إذا (!ألحق_فرع_قصير_للخلف_إكس(البايتات, المواقع, النهائي, 0xEB)) {
            ألحق_فرع_إكس_مؤجل(البايتات, الفروع, النهائي, اختياري.لا_شيء());
        };
    };
}

// Encodes a block's branch instructions with the layout in view: a
// conditional branch without edge moves becomes one Jcc to its target (or
// the inverted Jcc to the other target when its own is next), and jumps to
// the next block disappear. Returns how many instructions it consumed (0
// when the instruction is not such a branch).
عرف شفّر_فرع_مخطط_إكس(
    التعليمات: &متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    الموضع: طبيعي,
    التمريرات: &متجه معرف_كتلة_منتقاة,
    التالية: &اختياري معرف_كتلة_منتقاة,
    الهدف: &واصف_هدف,
    البايتات: &متغير متجه ط8,
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    المواقع: &متجه موضع_كتلة_إكس
): نتيجة طبيعي, خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون {
    دع العدد: طبيعي = الطول(*التعليمات) مثل طبيعي;
    // The false edge of a two-way branch: the plain jump that ends the block.
    دع هدف_التالي: متغير اختياري معرف_كتلة_منتقاة = اختياري.لا_شيء();
    إذا (الموضع + 2 == العدد) {
        هدف_التالي := هدف_قفز_مجرد_إكس(&(*التعليمات)[الموضع + 1]);
    };
    // Condition code of "jump to the true edge" and the true edge, for the
    // two conditional forms without moves.
    دع رمز_الشرط: متغير طبيعي = 0;
    دع رمز_المعكوس: متغير طبيعي = 0;
    دع هدف_الصواب: متغير اختياري معرف_كتلة_منتقاة = اختياري.لا_شيء();
    طابق (*التعليمات)[الموضع] مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز(الهدف_) -> {
        ألحق_قفز_مخطط_إكس(البايتات, الفروع, التمريرات, التالية, الهدف_, المواقع);
        أرجع نتيجة.نجح(1);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_مع_نقلات(النقلات) -> {
        طابق ألحق_نقلات_حافة_إكس(البايتات, &النقلات, الهدف) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_قفز_مخطط_إكس(البايتات, الفروع, التمريرات, التالية, النقلات.الهدف, المواقع);
        أرجع نتيجة.نجح(1);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_بقيمة(السجل, النقلات) -> {
        إذا (!نقلات_حافة_بديهية_إكس(&النقلات)) { أرجع نتيجة.نجح(0); };
        ألحق_اختبار_سجل_إكس(البايتات, السجل);
        رمز_الشرط := 5;
        رمز_المعكوس := 4;
        هدف_الصواب := اختياري.موجود(النقلات.الهدف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قفز_شرطي_مع_نقلات(الشرط, النقلات) -> {
        إذا (!نقلات_حافة_بديهية_إكس(&النقلات)) { أرجع نتيجة.نجح(0); };
        رمز_الشرط := رمز_شرط_إكس(الشرط);
        رمز_المعكوس := رمز_شرط_معكوس_إكس(الشرط);
        هدف_الصواب := اختياري.موجود(النقلات.الهدف);
    }
    | _ -> { أرجع نتيجة.نجح(0); };
    طابق هدف_الصواب مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(0); }
    | اختياري.موجود(الصواب) -> {
        دع الصواب_النهائي: معرف_كتلة_منتقاة = حل_تمرير_كتلة_إكس(التمريرات, الصواب);
        طابق هدف_التالي مع
        | اختياري.موجود(الخطأ_) -> {
            دع الخطأ_النهائي: معرف_كتلة_منتقاة = حل_تمرير_كتلة_إكس(التمريرات, الخطأ_);
            إذا (كتلة_تالية_هي_إكس(التالية, الصواب_النهائي)) {
                إذا (!كتلة_تالية_هي_إكس(التالية, الخطأ_النهائي)
                    && !ألحق_فرع_قصير_للخلف_إكس(البايتات, المواقع, الخطأ_النهائي, 0x70 + رمز_المعكوس)) {
                    ألحق_بايت_إكس(البايتات, 0x0F);
                    ألحق_بايت_إكس(البايتات, 0x80 + رمز_المعكوس);
                    ألحق_فرع_مثبت_إكس(البايتات, الفروع, الخطأ_النهائي);
                };
                أرجع نتيجة.نجح(2);
            };
        }
        | اختياري.لا_شيء -> { };
        // Otherwise the instructions after this one run on the false edge,
        // so the true edge always takes its Jcc.
        إذا (!ألحق_فرع_قصير_للخلف_إكس(البايتات, المواقع, الصواب_النهائي, 0x70 + رمز_الشرط)) {
            ألحق_بايت_إكس(البايتات, 0x0F);
            ألحق_بايت_إكس(البايتات, 0x80 + رمز_الشرط);
            ألحق_فرع_مثبت_إكس(البايتات, الفروع, الصواب_النهائي);
        };
        أرجع نتيجة.نجح(1);
    };
}

// The rel32 field of a branch opcode just written, fixed up to الهدف.
عرف ألحق_فرع_مثبت_إكس(
    البايتات: &متغير متجه ط8,
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    الهدف: معرف_كتلة_منتقاة
): فراغ {
    دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_ط32_إكس(البايتات, 0);
    دع التثبيت: تثبيت_فرع_إكس_مؤجل = {
        إزاحة_الحقل: الموضع,
        بعد_التعليمة: الطول(*البايتات) مثل طبيعي,
        الهدف: الهدف
    };
    ألحق_فرع_إكس_للمشفّر(الفروع, التثبيت);
}

عرف حل_فروع_إكس(
    الدالة: معرف_دالة_منتقاة,
    البايتات: &متغير متجه ط8,
    المواقع: &متجه موضع_كتلة_إكس,
    الفروع: &متجه تثبيت_فرع_إكس_مؤجل,
    التمريرات: &متجه معرف_كتلة_منتقاة,
    المحلولة: &متغير متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون
): اختياري خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون {
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول(*الفروع) مثل طبيعي)) {
        دع التثبيت: متغير تثبيت_فرع_إكس_مؤجل = (*الفروع)[ت];
        التثبيت.الهدف := حل_تمرير_كتلة_إكس(التمريرات, التثبيت.الهدف);
        طابق ابحث_موضع_كتلة_إكس(المواقع, التثبيت.الهدف) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.هدف_كتلة_مفقود(التثبيت.الهدف)
            );
        }
        | اختياري.موجود(موضع_الهدف) -> {
            طابق إزاحة_نسبية_32(التثبيت.بعد_التعليمة, موضع_الهدف) مع
            | نتيجة_إزاحة_نسبية_32.خارج_المدى -> {
                أرجع اختياري.موجود(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.فرع_خارج_مدى_نسبي_32(
                        التثبيت.الهدف
                    )
                );
            }
            | نتيجة_إزاحة_نسبية_32.نجحت(الحقل) -> {
                اكتب_ط32_إكس(البايتات, التثبيت.إزاحة_الحقل, الحقل);

                دع المثبت: تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون = {
                    الدالة: الدالة,
                    إزاحة_الحقل: التثبيت.إزاحة_الحقل,
                    بعد_التعليمة: التثبيت.بعد_التعليمة,
                    الهدف: التثبيت.الهدف,
                    إزاحة_الهدف: موضع_الهدف
                };
                ألحق_فرع_محلول_إكس_للمشفّر(المحلولة, المثبت);

            };
        };
        ت := ت + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Saves (or restores) the callee-saved registers the function allocates, in
// their frame slots, with their unwind records.
عرف ألحق_حفظ_المحفوظة_إكس(
    البايتات: &متغير متجه ط8,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    استعادة: منطقي,
    الهدف: &واصف_هدف,
    بداية_الدالة: طبيعي,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    دع العدد: طبيعي = الطول((*الإطار).السجلات_المحفوظة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع السجل: معرف_سجل_فعلي = (*الإطار).السجلات_المحفوظة[ف];
        دع الإزاحة: طبيعي = (*الإطار).إزاحة_الحفظ + ف * 8;
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(الإزاحة);
        إذا (استعادة) {
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, السجل, &العنوان, 8, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            سجل_استعادة_سجل_فك_المكدس(فك_المكدس, الهدف, السجل, (الطول(*البايتات) مثل طبيعي) - بداية_الدالة);
        } وإلا {
            طابق ألحق_تخزين_ذاكرة_إكس(البايتات, السجل, &العنوان, 8) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            سجل_حفظ_سجل_فك_المكدس(فك_المكدس, الهدف, السجل, الإزاحة, (الطول(*البايتات) مثل طبيعي) - بداية_الدالة);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عام عرف شفّر_دالة_إكس_ستة_وثمانون_أربعة_وستون(
    الدالة_المخصصة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف,
    البايتات: &متغير متجه ط8,
    الدوال: &متغير متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الفروع_المحلولة: &متغير متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    أصول_الآلة: &متغير متجه مدى_شفرة_آلة_بأصل,
    المرفقات: &متغير مرفقات_كائن_مشفرة,
    // Debug output: per block of الدالة.الكتل, the function-relative byte
    // offset of each allocated instruction, then the block's end (empty for a
    // block that is not laid out).
    مواضع_التعليمات: &متغير متجه متجه طبيعي
): نتيجة_ترميز_دالة_إكس {
    دع و: واصف_هدف = *الهدف;
    طابق و.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> {
        أرجع نتيجة_ترميز_دالة_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.هدف_غير_صالح(و.المعرف)
        );
    };

    دع الدالة: دالة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الدالة_المخصصة;

    إذا (دالة_موجودة_مشفرة(الدوال, الدالة.الرأس.المعرف)) {
        أرجع نتيجة_ترميز_دالة_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.دالة_مكررة(الدالة.الرأس.المعرف)
        );
    };

    دع بداية_الدالة: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع فك_المكدس: متغير متتبع_فك_المكدس = متتبع_فك_المكدس_جديد(الهدف);
    // Windows commits the stack page by page: probe a frame of a page or more.
    إذا (تركيب_الهدف_الأصلي(الهدف) == هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف()) {
        ألحق_مسبار_مكدس_ويندوز_إكس(البايتات, الدالة.إطار_الانسكاب.الحجم_بايت);
    };
    ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(
        البايتات, الدالة.إطار_الانسكاب.الحجم_بايت, صواب, بداية_الدالة, &متغير فك_المكدس
    );
    طابق ألحق_حفظ_المحفوظة_إكس(البايتات, &الدالة.إطار_الانسكاب, خطأ, الهدف, بداية_الدالة, &متغير فك_المكدس) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_ترميز_دالة_إكس.خطأ(الخطأ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع المواقع: متغير متجه موضع_كتلة_إكس = [];
    دع الفروع: متغير متجه تثبيت_فرع_إكس_مؤجل = [];
    دع التمريرات: متجه معرف_كتلة_منتقاة = ابن_تمريرات_كتل_إكس(&الدالة.الكتل);
    // Laid out: every block but the jump-only ones branches are threaded past
    // (the entry block stays first).
    دع المرسومة: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(الدالة.الكتل) مثل طبيعي)) {
        دع معرف_م: معرف_كتلة_منتقاة = الدالة.الكتل[م].الرأس.المعرف;
        إذا (م == 0 || حل_تمرير_كتلة_إكس(&التمريرات, معرف_م).القيمة == معرف_م.القيمة) {
            ألحق(المرسومة, م);
        };
        م := م + 1;
    }

    دع بلا_مواضع: متجه متجه طبيعي = [];
    *مواضع_التعليمات := بلا_مواضع;
    م := 0;
    طالما (م < (الطول(الدالة.الكتل) مثل طبيعي)) { دع فارغة: متجه طبيعي = []; ألحق(*مواضع_التعليمات, فارغة); م := م + 1; }
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول(المرسومة) مثل طبيعي)) {
        دع ك: طبيعي = المرسومة[ر];
        دع التالية: متغير اختياري معرف_كتلة_منتقاة = اختياري.لا_شيء();
        إذا (ر + 1 < (الطول(المرسومة) مثل طبيعي)) {
            التالية := اختياري.موجود(الدالة.الكتل[المرسومة[ر + 1]].الرأس.المعرف);
        };
        ر := ر + 1;
        دع مرجع_الكتلة: &كتلة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &الدالة.الكتل[ك];
        دع الكتلة: كتلة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *مرجع_الكتلة;
        طابق ابحث_موضع_كتلة_إكس(&المواقع, الكتلة.الرأس.المعرف) مع
        | اختياري.موجود(_) -> {
            أرجع نتيجة_ترميز_دالة_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.كتلة_مكررة(الكتلة.الرأس.المعرف)
            );
        }
        | اختياري.لا_شيء -> { };
        دع إزاحة_الكتلة: طبيعي = الطول(*البايتات) مثل طبيعي;
        دع الموقع: موضع_كتلة_إكس = {
            المعرف: الكتلة.الرأس.المعرف,
            إزاحة_بايت: إزاحة_الكتلة
        };
        ألحق(المواقع, الموقع);
        دع مواضع_الكتلة: متغير متجه طبيعي = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(الكتلة.التعليمات) مثل طبيعي)) {
            دع بداية_الأصل_مطلقة: طبيعي = الطول(*البايتات) مثل طبيعي;
            دع المستهلكة: متغير طبيعي = 0;
            طابق شفّر_فرع_مخطط_إكس(
                &الكتلة.التعليمات, ت, &التمريرات, &التالية, الهدف, البايتات, &متغير الفروع, &المواقع
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_ترميز_دالة_إكس.خطأ(الخطأ); }
            | نتيجة.نجح(العدد) -> { المستهلكة := العدد; };
            إذا (المستهلكة == 0) {
                طابق شفّر_تعليمة_إكس(
                    &الكتلة.التعليمات[ت],
                    الهدف,
                    &الدالة.إطار_الانسكاب,
                    البايتات,
                    &متغير الفروع,
                    النداءات,
                    المرفقات,
                    الدالة.الرأس.المعرف,
                    بداية_الدالة,
                    &متغير فك_المكدس
                ) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> {
                    أرجع نتيجة_ترميز_دالة_إكس.خطأ(الخطأ);
                }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                المستهلكة := 1;
            };
            دع نهاية_الأصل_مطلقة: طبيعي = الطول(*البايتات) مثل طبيعي;
            طابق مرجع_تصحيح_تعليمة_آلة_عند(&الكتلة.أصول_التعليمات, ت) مع
            | اختياري.موجود(مرجع_التصحيح) -> {
                إذا (نهاية_الأصل_مطلقة > بداية_الأصل_مطلقة) {
                    دع إزاحة_الأصل: طبيعي = بداية_الأصل_مطلقة - بداية_الدالة;
                    دع حجم_الأصل: طبيعي = نهاية_الأصل_مطلقة - بداية_الأصل_مطلقة;
                    دع المدى: مدى_شفرة_آلة_بأصل = {
                        الدالة: الدالة.الرأس.المعرف,
                        إزاحة_بايت: إزاحة_الأصل,
                        حجم_بايت: حجم_الأصل,
                        الأصل: مرجع_التصحيح.الأصل,
                        موقع_التصحيح: مرجع_التصحيح.موقع_التصحيح,
                        نطاق_التصحيح: مرجع_التصحيح.نطاق_التصحيح
                    };
                    ألحق_أصل_آلة_إكس_للمشفّر(أصول_الآلة, المدى);
                };
            }
            | اختياري.لا_شيء -> { };
            دع ع: متغير طبيعي = 0;
            طالما (ع < المستهلكة) { ألحق(مواضع_الكتلة, بداية_الأصل_مطلقة - بداية_الدالة); ع := ع + 1; }
            ت := ت + المستهلكة;
        }
        ألحق(مواضع_الكتلة, (الطول(*البايتات) مثل طبيعي) - بداية_الدالة);
        (*مواضع_التعليمات)[ك] := مواضع_الكتلة;
    }

    طابق حل_فروع_إكس(
        الدالة.الرأس.المعرف,
        البايتات,
        &المواقع,
        &الفروع,
        &التمريرات,
        الفروع_المحلولة
    ) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_ترميز_دالة_إكس.خطأ(الخطأ);
    }
    | اختياري.لا_شيء -> { };
    دع نهاية_الدالة: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع حجم_الدالة: طبيعي = نهاية_الدالة - بداية_الدالة;
    دع أحداث_فك_المكدس: متجه حدث_فك_المكدس = انسخ_أحداث_فك_المكدس(&فك_المكدس.الأحداث);
    دع موضع_الدالة: موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
        الدالة: الدالة.الرأس.المعرف,
        إزاحة_بايت: بداية_الدالة,
        حجم_بايت: حجم_الدالة,
        أحداث_فك_المكدس: أحداث_فك_المكدس
    };
    ألحق_موضع_دالة_إكس_للمشفّر(الدوال, موضع_الدالة);





    أرجع نتيجة_ترميز_دالة_إكس.نجحت();
}

عام عرف شفّر_إكس_ستة_وثمانون_أربعة_وستون(
    الشفرة: &شفرة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف
): نتيجة_ترميز_إكس_ستة_وثمانون_أربعة_وستون {
    دع ش: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *الشفرة;
    دع و: واصف_هدف = *الهدف;
    إذا (!معرفا_هدف_متساويان(ش.الرأس.الهدف, و.المعرف)) {
        أرجع نتيجة_ترميز_إكس_ستة_وثمانون_أربعة_وستون.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.هدف_غير_صالح(ش.الرأس.الهدف)
        );
    };
    دع البايتات: متغير متجه ط8 = [];
    دع الدوال: متغير متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = [];
    دع الفروع_المحلولة: متغير متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع النداءات: متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = [];
    دع أصول_الآلة: متغير متجه مدى_شفرة_آلة_بأصل = [];
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    دع مواضع_التعليمات: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ش.الدوال) مثل طبيعي)) {
        طابق شفّر_دالة_إكس_ستة_وثمانون_أربعة_وستون(
            &ش.الدوال[ف],
            الهدف,
            &متغير البايتات,
            &متغير الدوال,
            &متغير الفروع_المحلولة,
            &متغير النداءات,
            &متغير أصول_الآلة,
            &متغير المرفقات,
            &متغير مواضع_التعليمات
        ) مع
        | نتيجة_ترميز_دالة_إكس.خطأ(الخطأ) -> {
            أرجع نتيجة_ترميز_إكس_ستة_وثمانون_أربعة_وستون.خطأ(الخطأ);
        }
        | نتيجة_ترميز_دالة_إكس.نجحت -> { };
        ف := ف + 1;
    }
    دع بلا_دخول_لينكس: اختياري دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = اختياري.لا_شيء();
    دع الناتج: شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
        الهدف: و.المعرف,
        البيانات: البايتات,
        الدوال: الدوال,
        تثبيتات_الفروع: الفروع_المحلولة,
        إزاحات_النداء: النداءات,
        أصول_الآلة: أصول_الآلة,
        المرفقات: المرفقات,
        دخول_عملية_لينكس: بلا_دخول_لينكس
    };
    أرجع نتيجة_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نجح(الناتج);
}

// Preserve Linux initial-stack information in ordinary, linker-visible data
// symbols before constructors. The canonical object writer owns their storage;
// the architecture emits only a RIP-relative store and its symbolic relocation.
عرف ألحق_حفظ_قيمة_إقلاع_إكس(
    البايتات: &متغير متجه ط8,
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الرموز_الخارجية: &متغير متجه متجه ط8,
    السجل: معرف_سجل_فعلي,
    الاسم: متجه ط8
): فراغ {
    دع بادئة: متغير طبيعي = 0x48;
    إذا (السجل.القيمة >= 8) { بادئة := بادئة + 4; };
    ألحق_بايت_إكس(البايتات, بادئة);
    ألحق_بايت_إكس(البايتات, 0x89);
    ألحق_بايت_إكس(البايتات, 0x05 + (السجل.القيمة % 8) * 8);
    دع موضع_الحقل: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_ط32_إكس(البايتات, 0);
    دع الفهرس: متغير طبيعي = 0;
    دع معرف_الرمز: متغير طبيعي = الطول(*الرموز_الخارجية) مثل طبيعي;
    دع موجود: متغير منطقي = خطأ;
    طالما (الفهرس < (الطول(*الرموز_الخارجية) مثل طبيعي)) {
        إذا (اسما_رمز_خارجي_كائن_متساويان(&(*الرموز_الخارجية)[الفهرس], &الاسم)) {
            معرف_الرمز := الفهرس;
            موجود := صواب;
        };
        الفهرس := الفهرس + 1;
    }
    إذا (!موجود) { ألحق(*الرموز_الخارجية, الاسم); };
    دع المعرف: معرف_دالة_خارجية_منتقاة = { القيمة: معرف_الرمز };
    دع المرجع: مرجع_رمز_كائن = مرجع_رمز_كائن.رمز_خارجي(المعرف);
    دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
        إزاحة_بايت: موضع_الحقل,
        النوع: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان(),
        الرمز: المرجع,
        الإضافة: -4
    };
    ألحق((*الشفرة).إزاحات_النداء, الإزاحة);
}

// The Linux ELF process entry is compiler-owned ABI lowering, not a runtime
// service. Assemble individual instructions using the canonical x86 encoder;
// the process exit is an ordinary unresolved STD symbol. No inline syscall,
// allocator state, OS wrapper or preassembled machine-code image is emitted.
عام عرف أضف_دخول_عملية_لينكس_إكس_للمشفر(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    دالة_الخروج: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متغير متجه متجه ط8
): نتيجة_دفعة_ترميز_إكس {
    // Linux: the argument block [argc][argv...] is at the initial RSP.
    دع مؤشر_المكدس: معرف_سجل_فعلي = { القيمة: 4 };
    أرجع أضف_دخول_عملية_نواة_إكس_للمشفر(
        الشفرة, دالة_الدخول, دالة_الخروج, الرموز_الخارجية, مؤشر_المكدس
    );
}

// FreeBSD: exec_setregs passes the argument block's address in RDI and
// enters with RSP = 8 mod 16 (lib/csu/amd64/crt1_s.S).
عام عرف أضف_دخول_عملية_فري_بي_إس_دي_إكس_للمشفر(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    دالة_الخروج: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متغير متجه متجه ط8
): نتيجة_دفعة_ترميز_إكس {
    دع سجل_الكتلة: معرف_سجل_فعلي = { القيمة: 7 };
    أرجع أضف_دخول_عملية_نواة_إكس_للمشفر(
        الشفرة, دالة_الدخول, دالة_الخروج, الرموز_الخارجية, سجل_الكتلة
    );
}

عرف أضف_دخول_عملية_نواة_إكس_للمشفر(
    الشفرة: &متغير شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    دالة_الدخول: اختياري معرف_دالة_منتقاة,
    دالة_الخروج: اختياري معرف_دالة_منتقاة,
    الرموز_الخارجية: &متغير متجه متجه ط8,
    سجل_الكتلة: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    طابق دالة_الدخول مع
    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); }
    | اختياري.موجود(الدالة) -> {
        // The STD exit provider must be part of the program: fail closed.
        دع مزود_الخروج: معرف_دالة_منتقاة;
        طابق دالة_الخروج مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.مزود_خروج_عملية_مفقود()
            );
        }
        | اختياري.موجود(المعرف) -> { مزود_الخروج := المعرف; };
        دع مرجع_البايتات: &متجه ط8 = &(*الشفرة).البيانات;
        دع البايتات: متغير متجه ط8 = انسخ_بايتات(مرجع_البايتات);
        دع بداية_الدخول: طبيعي = الطول(البايتات) مثل طبيعي;
        دع سجل_الإطار: معرف_سجل_فعلي = { القيمة: 5 };
        دع سجل_المكدس: معرف_سجل_فعلي = { القيمة: 4 };
        دع سجل_العدد: معرف_سجل_فعلي = { القيمة: 7 };
        دع سجل_المؤشر: معرف_سجل_فعلي = { القيمة: 6 };
        دع سجل_الناتج: معرف_سجل_فعلي = { القيمة: 0 };
        دع سجل_بداية_المنشئات: معرف_سجل_فعلي = { القيمة: 12 };
        دع سجل_نهاية_المنشئات: معرف_سجل_فعلي = { القيمة: 13 };
        دع سجل_العدد_المحفوظ: معرف_سجل_فعلي = { القيمة: 14 };
        دع سجل_المؤشر_المحفوظ: معرف_سجل_فعلي = { القيمة: 15 };
        دع سجل_البيئة_المحفوظ: معرف_سجل_فعلي = { القيمة: 3 };
        دع سجل_البيئة: معرف_سجل_فعلي = { القيمة: 2 };

        // XOR EBP, EBP: no caller frame exists at ELF entry.
        طابق ألحق_عملية_سجلين_بعرض_إكس(
            &متغير البايتات, 32, سجل_الإطار, سجل_الإطار, 0x30, 0x31
        ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

        // RSI = &argv[0], then RDI = argc, from the kernel's argument block
        // (RSI first: on FreeBSD the block's address arrives in RDI).
        دع عنوان_المؤشر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
            عنوان_كتلة_دخول_إكس(سجل_الكتلة, 8);
        طابق ألحق_تكوين_عنوان_إكس(
            &متغير البايتات, سجل_المؤشر, &عنوان_المؤشر
        ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        دع عنوان_العدد: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
            عنوان_كتلة_دخول_إكس(سجل_الكتلة, 0);
        طابق ألحق_تحميل_ذاكرة_إكس(
            &متغير البايتات, سجل_العدد, &عنوان_العدد, 8, خطأ
        ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

        // Constructor calls may change all caller-saved argument registers.
        // Keep the initial process arguments in SysV callee-saved registers.
        طابق ألحق_نقل_سجل_إكس(&متغير البايتات, سجل_العدد_المحفوظ, سجل_العدد) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_سجل_إكس(&متغير البايتات, سجل_المؤشر_المحفوظ, سجل_المؤشر) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

        // The System V constructor ABI also permits (argc, argv, envp).
        // envp follows argv[argc] and its terminating null pointer.
        دع عنوان_البيئة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
            الأساس: اختياري.موجود(سجل_المؤشر),
            الفهرس: اختياري.موجود(سجل_العدد),
            المقياس: 8,
            الإزاحة: 8
        };
        طابق ألحق_تكوين_عنوان_إكس(
            &متغير البايتات, سجل_البيئة_المحفوظ, &عنوان_البيئة
        ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

        // The saved registers are stable across all initializer calls. Publish
        // the original argc, argv, envp using the compiler-owned startup ABI.
        ألحق_حفظ_قيمة_إقلاع_إكس(
            &متغير البايتات, الشفرة, الرموز_الخارجية,
            سجل_العدد_المحفوظ, اسم_عدد_وسائط_إقلاع_أساسي()
        );
        ألحق_حفظ_قيمة_إقلاع_إكس(
            &متغير البايتات, الشفرة, الرموز_الخارجية,
            سجل_المؤشر_المحفوظ, اسم_مؤشر_وسائط_إقلاع_أساسي()
        );
        ألحق_حفظ_قيمة_إقلاع_إكس(
            &متغير البايتات, الشفرة, الرموز_الخارجية,
            سجل_البيئة_المحفوظ, اسم_مؤشر_بيئة_إقلاع_أساسي()
        );

        // AND RSP, -16: maintain SysV 16-byte stack alignment before CALL.
        ألحق_بايت_إكس(&متغير البايتات, 0x48);
        ألحق_بايت_إكس(&متغير البايتات, 0x83);
        ألحق_بايت_إكس(&متغير البايتات, مود_آر_إم_سجلين(سجل_المكدس, سجل_المكدس));
        ألحق_بايت_إكس(&متغير البايتات, 0xF0);

        // Walk the ELF constructor range supplied by the final linker.
        // This also covers separately linked object modules. Both boundaries
        // resolve to the same address when there are no constructors.
        دع نوع_العنوان: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
            نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان();
        دع معرف_بداية_المنشئات: معرف_دالة_خارجية_منتقاة = {
            القيمة: الطول(*الرموز_الخارجية) مثل طبيعي
        };
        ألحق(*الرموز_الخارجية, اسم_بداية_منشئات_إلف_أساسي());
        // LEA R12, [RIP + disp32] using the canonical x86 instruction emitter.
        ألحق_بايت_إكس(&متغير البايتات, 0x4C);
        ألحق_بايت_إكس(&متغير البايتات, 0x8D);
        ألحق_بايت_إكس(&متغير البايتات, 0x25);
        دع موضع_حقل_بداية_المنشئات: طبيعي = الطول(البايتات) مثل طبيعي;
        ألحق_ط32_إكس(&متغير البايتات, 0);
        دع مرجع_بداية_المنشئات: مرجع_رمز_كائن =
            مرجع_رمز_كائن.رمز_خارجي(معرف_بداية_المنشئات);
        دع إزاحة_بداية_المنشئات: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: موضع_حقل_بداية_المنشئات,
            النوع: نوع_العنوان,
            الرمز: مرجع_بداية_المنشئات,
            الإضافة: -4
        };
        ألحق((*الشفرة).إزاحات_النداء, إزاحة_بداية_المنشئات);

        دع معرف_نهاية_المنشئات: معرف_دالة_خارجية_منتقاة = {
            القيمة: الطول(*الرموز_الخارجية) مثل طبيعي
        };
        ألحق(*الرموز_الخارجية, اسم_نهاية_منشئات_إلف_أساسي());
        // LEA R13, [RIP + disp32].
        ألحق_بايت_إكس(&متغير البايتات, 0x4C);
        ألحق_بايت_إكس(&متغير البايتات, 0x8D);
        ألحق_بايت_إكس(&متغير البايتات, 0x2D);
        دع موضع_حقل_نهاية_المنشئات: طبيعي = الطول(البايتات) مثل طبيعي;
        ألحق_ط32_إكس(&متغير البايتات, 0);
        دع مرجع_نهاية_المنشئات: مرجع_رمز_كائن =
            مرجع_رمز_كائن.رمز_خارجي(معرف_نهاية_المنشئات);
        دع إزاحة_نهاية_المنشئات: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: موضع_حقل_نهاية_المنشئات,
            النوع: نوع_العنوان,
            الرمز: مرجع_نهاية_المنشئات,
            الإضافة: -4
        };
        ألحق((*الشفرة).إزاحات_النداء, إزاحة_نهاية_المنشئات);

        طابق ألحق_مقارنة_بعرض_إكس(
            &متغير البايتات, سجل_بداية_المنشئات, سجل_نهاية_المنشئات, 64
        ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        // JE after the iterator when the range is empty.
        ألحق_بايت_إكس(&متغير البايتات, 0x74);
        دع موضع_شرط_الفراغ: طبيعي = الطول(البايتات) مثل طبيعي;
        ألحق_بايت_إكس(&متغير البايتات, 0);
        دع بداية_حلقة_المنشئات: طبيعي = الطول(البايتات) مثل طبيعي;
        دع عنوان_دالة_المنشئ: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
            الأساس: اختياري.موجود(سجل_بداية_المنشئات),
            الفهرس: اختياري.لا_شيء(),
            المقياس: 1,
            الإزاحة: 0
        };
        طابق ألحق_تحميل_ذاكرة_إكس(
            &متغير البايتات, سجل_الناتج, &عنوان_دالة_المنشئ, 8, خطأ
        ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        // Advance R12 before the call; constructors preserve callee-saved R12/R13.
        ألحق_بايت_إكس(&متغير البايتات, 0x49);
        ألحق_بايت_إكس(&متغير البايتات, 0x83);
        ألحق_بايت_إكس(&متغير البايتات, 0xC4);
        ألحق_بايت_إكس(&متغير البايتات, 8);
        // Pass conventional initializer arguments on each invocation;
        // unlike caller-saved registers, RBX/R12-R15 survive each call.
        طابق ألحق_نقل_سجل_إكس(&متغير البايتات, سجل_العدد, سجل_العدد_المحفوظ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_سجل_إكس(&متغير البايتات, سجل_المؤشر, سجل_المؤشر_المحفوظ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_سجل_إكس(&متغير البايتات, سجل_البيئة, سجل_البيئة_المحفوظ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        // CALL RAX.
        ألحق_بايت_إكس(&متغير البايتات, 0xFF);
        ألحق_بايت_إكس(&متغير البايتات, 0xD0);
        طابق ألحق_مقارنة_بعرض_إكس(
            &متغير البايتات, سجل_بداية_المنشئات, سجل_نهاية_المنشئات, 64
        ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        دع موضع_فرع_الحلقة: طبيعي = الطول(البايتات) مثل طبيعي;
        ألحق_بايت_إكس(&متغير البايتات, 0x75);
        دع حجم_رجوع_الحلقة: طبيعي = موضع_فرع_الحلقة + 2 - بداية_حلقة_المنشئات;
        إذا (حجم_رجوع_الحلقة > 128) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نداء_تشغيل_خارج_المدى()
            );
        };
        ألحق_بايت_إكس(&متغير البايتات, 256 - حجم_رجوع_الحلقة);
        دع نهاية_حلقة_المنشئات: طبيعي = الطول(البايتات) مثل طبيعي;
        إذا (نهاية_حلقة_المنشئات - موضع_شرط_الفراغ - 1 > 127) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نداء_تشغيل_خارج_المدى()
            );
        };
        البايتات[موضع_شرط_الفراغ] :=
            (نهاية_حلقة_المنشئات - موضع_شرط_الفراغ - 1) مثل ط8;
        // Restore argc/argv before entering SultanC source.
        طابق ألحق_نقل_سجل_إكس(&متغير البايتات, سجل_العدد, سجل_العدد_المحفوظ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_سجل_إكس(&متغير البايتات, سجل_المؤشر, سجل_المؤشر_المحفوظ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

        // CALL الرئيسية: the existing ELF entry-name mapping preserves the
        // canonical source entry without introducing a C main dependency.
        ألحق_بايت_إكس(&متغير البايتات, 0xE8);
        دع موضع_حقل_الدخول: طبيعي = الطول(البايتات) مثل طبيعي;
        ألحق_ط32_إكس(&متغير البايتات, 0);
        دع مرجع_الدخول: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(الدالة);
        دع نوع_النداء: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
            نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
        دع نداء_الدخول: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: موضع_حقل_الدخول,
            النوع: نوع_النداء,
            الرمز: مرجع_الدخول,
            الإضافة: -4
        };

        // The language entry's return code becomes the STD exit argument.
        طابق ألحق_عملية_سجلين_بعرض_إكس(
            &متغير البايتات, 32, سجل_العدد, سجل_الناتج, 0x88, 0x89
        ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(&متغير البايتات, 0xE8);
        دع موضع_حقل_الخروج: طبيعي = الطول(البايتات) مثل طبيعي;
        ألحق_ط32_إكس(&متغير البايتات, 0);
        // Exit must not return. The trap detects a broken STD exit provider.
        ألحق_فخ_إكس(&متغير البايتات);

        دع مرجع_الخروج: مرجع_رمز_كائن = مرجع_رمز_كائن.دالة(مزود_الخروج);
        دع نداء_الخروج: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: موضع_حقل_الخروج,
            النوع: نوع_النداء,
            الرمز: مرجع_الخروج,
            الإضافة: -4
        };
        ألحق((*الشفرة).إزاحات_النداء, نداء_الدخول);
        ألحق((*الشفرة).إزاحات_النداء, نداء_الخروج);
        دع نهاية_الدخول: طبيعي = الطول(البايتات) مثل طبيعي;
        (*الشفرة).البيانات := البايتات;
        دع دخول_العملية: دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: بداية_الدخول,
            حجم_بايت: نهاية_الدخول - بداية_الدخول
        };
        (*الشفرة).دخول_عملية_لينكس := اختياري.موجود(دخول_العملية);
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_نقلة_سجل_نداء_إكس(القيمة: &متجه نقلة_سجل_نداء_إكس): متجه نقلة_سجل_نداء_إكس {
    دع الناتج: متغير متجه نقلة_سجل_نداء_إكس = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Before a call of a C variadic function (System V AMD64 ABI 3.5.7): every
// argument is already in its register or stack slot, as for a prototyped
// call, and AL must bound the vector registers holding arguments, which the
// callee's prologue reads to save them. Eight is always a valid bound (the
// C call at an address does the same). RAX is no argument register.
عرف ألحق_حد_متجهات_نداء_متغير_إكس(البايتات: &متغير متجه ط8): فراغ {
    // mov eax, 8
    ألحق_بايت_إكس(البايتات, 0xB8);
    ألحق_ط32_إكس(البايتات, 8);
}
