استورد compiler.backend.architectures.x86_64.encoded_code;
استورد compiler.backend.architectures.x86_64.allocated_code;
استورد compiler.backend.architectures.x86_64.instruction_model;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.call_frame_information;
استورد compiler.backend.target.target_model;
استورد compiler.backend.abi.abi_model;
استورد compiler.backend.target.register_query_context;
استورد compiler.backend.target.target_abi_resolution;
استورد compiler.backend.target.runtime_query_context;
استورد compiler.backend.target.runtime_allocation_model;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.backend.object.object_reference_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_runtime_abi;

نوع تثبيت_فرع_إكس_مؤجل = {
    إزاحة_الحقل: غير_موقع,
    بعد_التعليمة: غير_موقع,
    الهدف: معرف_كتلة_منتقاة
};

نوع موضع_كتلة_إكس = {
    المعرف: معرف_كتلة_منتقاة,
    إزاحة_بايت: غير_موقع
};

نوع نقلة_سجل_نداء_إكس = {
    المصدر: معرف_سجل_فعلي,
    الوجهة: معرف_سجل_فعلي
};

عام نوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون =
    | هدف_غير_صالح بنوع معرف_هدف
    | سجل_فعلي_غير_صالح بنوع معرف_سجل_فعلي
    | دالة_مكررة بنوع معرف_دالة_منتقاة
    | كتلة_مكررة بنوع معرف_كتلة_منتقاة
    | هدف_كتلة_مفقود بنوع معرف_كتلة_منتقاة
    | فرع_خارج_مدى_نسبي_32 بنوع معرف_كتلة_منتقاة
    | سجل_واجهة_غير_مدعوم
    | عنوان_ذاكرة_غير_مدعوم
    | عرض_ذاكرة_غير_مدعوم بنوع غير_موقع
    | نقل_حافة_غير_قابل_للترميز
    | سجلات_عمل_غير_كافية
    | موضع_محلي_مفقود بنوع غير_موقع
    | تخصيص_ذاكرة_غير_متاح
    | نداء_تشغيل_خارج_المدى
    | مزود_خروج_عملية_مفقود
;

عام نوع نتيجة_ترميز_إكس_ستة_وثمانون_أربعة_وستون =
    | نجح بنوع شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة
    | خطأ بنوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
;

عام نوع نتيجة_دفعة_ترميز_إكس =
    | نجحت
    | خطأ بنوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
;

عام نوع نتيجة_ترميز_دالة_إكس =
    | نجحت
    | خطأ بنوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
;

نوع نتيجة_إزاحة_نسبية_32 =
    | نجحت بنوع غير_موقع
    | خارج_المدى
;

عرف ألحق_بايت_إكس(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق(*البايتات, (القيمة % 256) مثل غ8);
}

عرف ألحق_فرع_إكس_للمشفّر(
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    التثبيت: تثبيت_فرع_إكس_مؤجل
): فراغ {
    ألحق(*الفروع, التثبيت);
}

عرف ألحق_نداء_إكس_للمشفّر(
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    ألحق(*النداءات, الإزاحة);
}

عرف ألحق_فرع_محلول_إكس_للمشفّر(
    المحلولة: &متغير متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون,
    المثبت: تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    ألحق(*المحلولة, المثبت);
}

عرف ألحق_أصل_آلة_إكس_للمشفّر(
    الأصول: &متغير متجه مدى_شفرة_آلة_بأصل,
    المدى: مدى_شفرة_آلة_بأصل
): فراغ {
    ألحق(*الأصول, المدى);
}

عرف ألحق_موضع_دالة_إكس_للمشفّر(
    الدوال: &متغير متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الموضع: موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة
): فراغ {
    ألحق(*الدوال, الموضع);
}

عرف ألحق_غ32_إكس(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        ألحق_بايت_إكس(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_غ64_إكس(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        ألحق_بايت_إكس(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف اكتب_غ32_إكس(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): فراغ {

    دع الباقي: متغير غير_موقع = القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        دع الفهرس: غير_موقع = الموضع + ف;
        (*البايتات)[الفهرس] := (الباقي % 256) مثل غ8;
        الباقي := الباقي / 256;
        ف := ف + 1;
    }

}

عرف سجل_إكس_قابل_للترميز(السجل: معرف_سجل_فعلي): منطقي {
    أرجع السجل.القيمة < 16;
}

عرف ركس_إكس(
    سجل_حقل: اختيار معرف_سجل_فعلي,
    سجل_قاعدة: اختيار معرف_سجل_فعلي
): غير_موقع {
    دع القيمة: متغير غير_موقع = 0x48;
    طابق سجل_حقل مع
    | اختيار.بعض(السجل) -> {
        لو (السجل.القيمة >= 8) {
            القيمة := القيمة + 4;
        };
    }
    | اختيار.لا_شيء -> { };
    طابق سجل_قاعدة مع
    | اختيار.بعض(السجل) -> {
        لو (السجل.القيمة >= 8) {
            القيمة := القيمة + 1;
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع القيمة;
}

عرف مود_آر_إم_سجلين(حقل: معرف_سجل_فعلي, قاعدة: معرف_سجل_فعلي): غير_موقع {
    أرجع 0xC0 + ((حقل.القيمة % 8) * 8) + (قاعدة.القيمة % 8);
}

عرف بتات_مقياس_إكس(المقياس: غير_موقع): اختيار غير_موقع {
    لو (المقياس == 1) { أرجع اختيار.بعض(0); };
    لو (المقياس == 2) { أرجع اختيار.بعض(1); };
    لو (المقياس == 4) { أرجع اختيار.بعض(2); };
    لو (المقياس == 8) { أرجع اختيار.بعض(3); };
    أرجع اختيار.لا_شيء();
}

عرف ركس_ذاكرة_إكس(
    أربعة_وستون: منطقي,
    سجل_حقل: معرف_سجل_فعلي,
    الفهرس: اختيار معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي
): غير_موقع {
    دع القيمة: متغير غير_موقع = 0x40;
    لو (أربعة_وستون) { القيمة := القيمة + 8; };
    لو (سجل_حقل.القيمة >= 8) { القيمة := القيمة + 4; };
    طابق الفهرس مع
    | اختيار.بعض(السجل) -> {
        لو (السجل.القيمة >= 8) { القيمة := القيمة + 2; };
    }
    | اختيار.لا_شيء -> { };
    لو (الأساس.القيمة >= 8) { القيمة := القيمة + 1; };
    أرجع القيمة;
}

عرف ألحق_معامل_ذاكرة_إكس(
    البايتات: &متغير متجه غ8,
    سجل_الحقل: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): نتيجة_دفعة_ترميز_إكس {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع الأساس: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق ع.الأساس مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختيار.بعض(السجل) -> { الأساس := السجل; };
    لو (!سجل_إكس_قابل_للترميز(سجل_الحقل) || !سجل_إكس_قابل_للترميز(الأساس)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    };
    لو (ع.الإزاحة < -2147483648 || ع.الإزاحة > 2147483647) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    };
    دع حقل_الفهرس: متغير غير_موقع = 4;
    طابق ع.الفهرس مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الفهرس) -> {
        لو (!سجل_إكس_قابل_للترميز(الفهرس)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
            );
        };
        حقل_الفهرس := الفهرس.القيمة % 8;
    };
    دع بتات_المقياس: متغير غير_موقع = 0;
    طابق بتات_مقياس_إكس(ع.المقياس) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختيار.بعض(القيمة) -> { بتات_المقياس := القيمة; };
    // Mod=10 + SIB + disp32 avoids the RBP/R13 zero-displacement special case.
    ألحق_بايت_إكس(البايتات, 0x84 + ((سجل_الحقل.القيمة % 8) * 8));
    ألحق_بايت_إكس(
        البايتات,
        (بتات_المقياس * 64) + (حقل_الفهرس * 8) + (الأساس.القيمة % 8)
    );
    ألحق_غ32_إكس(البايتات, ع.الإزاحة مثل غير_موقع);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تكوين_عنوان_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): نتيجة_دفعة_ترميز_إكس {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    طابق ع.الأساس مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختيار.بعض(الأساس) -> {
        ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, ع.الفهرس, الأساس));
    };
    ألحق_بايت_إكس(البايتات, 0x8D);
    أرجع ألحق_معامل_ذاكرة_إكس(البايتات, الوجهة, العنوان);
}

عرف ألحق_تحميل_ذاكرة_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الحجم: غير_موقع,
    بإشارة: منطقي
): نتيجة_دفعة_ترميز_إكس {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع الأساس: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق ع.الأساس مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختيار.بعض(السجل) -> { الأساس := السجل; };
    لو (!(الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم)
        );
    };
    لو (الحجم == 1 || الحجم == 2) {
        ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, ع.الفهرس, الأساس));
        ألحق_بايت_إكس(البايتات, 0x0F);
        لو (الحجم == 1) {
            لو (بإشارة) { ألحق_بايت_إكس(البايتات, 0xBE); }
            وإلا { ألحق_بايت_إكس(البايتات, 0xB6); };
        } وإلا {
            لو (بإشارة) { ألحق_بايت_إكس(البايتات, 0xBF); }
            وإلا { ألحق_بايت_إكس(البايتات, 0xB7); };
        };
    } وإلا لو (الحجم == 4) {
        لو (بإشارة) {
            ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, ع.الفهرس, الأساس));
            ألحق_بايت_إكس(البايتات, 0x63);
        } وإلا {
            ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(خطأ, الوجهة, ع.الفهرس, الأساس));
            ألحق_بايت_إكس(البايتات, 0x8B);
        };
    } وإلا {
        ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, ع.الفهرس, الأساس));
        ألحق_بايت_إكس(البايتات, 0x8B);
    };
    أرجع ألحق_معامل_ذاكرة_إكس(البايتات, الوجهة, العنوان);
}

عرف ألحق_تخزين_ذاكرة_إكس(
    البايتات: &متغير متجه غ8,
    المصدر: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الحجم: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع الأساس: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق ع.الأساس مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختيار.بعض(السجل) -> { الأساس := السجل; };
    لو (!(الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم)
        );
    };
    لو (الحجم == 2) { ألحق_بايت_إكس(البايتات, 0x66); };
    ألحق_بايت_إكس(
        البايتات,
        ركس_ذاكرة_إكس(الحجم == 8, المصدر, ع.الفهرس, الأساس)
    );
    لو (الحجم == 1) { ألحق_بايت_إكس(البايتات, 0x88); }
    وإلا { ألحق_بايت_إكس(البايتات, 0x89); };
    أرجع ألحق_معامل_ذاكرة_إكس(البايتات, المصدر, العنوان);
}

عرف ألحق_حارس_فخ_تجاوز_إكس(
    البايتات: &متغير متجه غ8,
    الصنف: صنف_فخ_تجاوز_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    // JNO/JNC يتجاوزان UD2 بطول بايتين عند عدم وقوع التجاوز.
    طابق الصنف مع
    | صنف_فخ_تجاوز_إكس_ستة_وثمانون_أربعة_وستون.موقع -> {
        ألحق_بايت_إكس(البايتات, 0x71);
    }
    | صنف_فخ_تجاوز_إكس_ستة_وثمانون_أربعة_وستون.غير_موقع -> {
        ألحق_بايت_إكس(البايتات, 0x73);
    };
    ألحق_بايت_إكس(البايتات, 2);
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x0B);
}

عرف ألحق_نقل_سجل_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    لو (!سجل_إكس_قابل_للترميز(الوجهة)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
        );
    };
    لو (!سجل_إكس_قابل_للترميز(المصدر)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر)
        );
    };
    لو (معرفا_سجل_فعلي_متساويان(الوجهة, المصدر)) {
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
    ألحق_بايت_إكس(البايتات, ركس_إكس(اختيار.بعض(المصدر), اختيار.بعض(الوجهة)));
    ألحق_بايت_إكس(البايتات, 0x89);
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف عنوان_انسكاب_إكس(الموقع: &موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون): عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    دع م: موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الموقع;
    دع مؤشر_المكدس: معرف_سجل_فعلي = { القيمة: 4 };
    دع الأساس: اختيار معرف_سجل_فعلي = اختيار.بعض(مؤشر_المكدس);
    دع الفهرس: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    دع الإزاحة: عدد = م.إزاحة_بايت مثل عدد;
    دع الناتج: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: الأساس,
        الفهرس: الفهرس,
        المقياس: 1,
        الإزاحة: الإزاحة
    };
    أرجع الناتج;
}

عرف عنوان_مكدس_إكس(الإزاحة: غير_موقع): عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    دع مؤشر_المكدس: معرف_سجل_فعلي = { القيمة: 4 };
    دع الأساس: اختيار معرف_سجل_فعلي = اختيار.بعض(مؤشر_المكدس);
    دع الفهرس: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
    دع الناتج: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: الأساس,
        الفهرس: الفهرس,
        المقياس: 1,
        الإزاحة: الإزاحة_الموقعة
    };
    أرجع الناتج;
}

عرف ألحق_تعديل_مؤشر_المكدس_إكس(
    البايتات: &متغير متجه غ8,
    الحجم: غير_موقع,
    طرح: منطقي
): فراغ {
    // ADD/SUB r64, imm32 يمدد imm32 بإشارة. قسّم أي تعديل أكبر من INT32_MAX
    // بدلا من إسقاط البتات العليا؛ المحاذاة المطلوبة تتحقق بعد اكتمال كل الأجزاء.
    دع الباقي: متغير غير_موقع = الحجم;
    بينما (الباقي > 0) {
        دع الجزء: متغير غير_موقع = الباقي;
        لو (الجزء > 2147483647) { الجزء := 2147483647; };
        ألحق_بايت_إكس(البايتات, 0x48);
        لو (الجزء <= 127) {
            ألحق_بايت_إكس(البايتات, 0x83);
            لو (طرح) { ألحق_بايت_إكس(البايتات, 0xEC); }
            وإلا { ألحق_بايت_إكس(البايتات, 0xC4); };
            ألحق_بايت_إكس(البايتات, الجزء);
        } وإلا {
            ألحق_بايت_إكس(البايتات, 0x81);
            لو (طرح) { ألحق_بايت_إكس(البايتات, 0xEC); }
            وإلا { ألحق_بايت_إكس(البايتات, 0xC4); };
            ألحق_غ32_إكس(البايتات, الجزء);
        };
        الباقي := الباقي - الجزء;
    }
}

عرف ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(
    البايتات: &متغير متجه غ8,
    الحجم: غير_موقع,
    طرح: منطقي,
    بداية_الدالة: غير_موقع,
    فك_المكدس: &متغير متتبع_فك_المكدس
): فراغ {
    دع الباقي: متغير غير_موقع = الحجم;
    بينما (الباقي > 0) {
        دع الجزء: متغير غير_موقع = الباقي;
        لو (الجزء > 2147483647) { الجزء := 2147483647; };
        ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, الجزء, طرح);
        دع عدد_البايتات_بعد_التعديل: غير_موقع = الطول(*البايتات) مثل غير_موقع;
        دع إزاحة_بعد_التعديل: غير_موقع = عدد_البايتات_بعد_التعديل - بداية_الدالة;
        لو (طرح) { سجل_طرح_مكدس_فك_المكدس(فك_المكدس, إزاحة_بعد_التعديل, الجزء); }
        وإلا { سجل_إضافة_مكدس_فك_المكدس(فك_المكدس, إزاحة_بعد_التعديل, الجزء); };
        الباقي := الباقي - الجزء;
    }
}

عرف ألحق_تحميل_انسكاب_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    الموقع: &موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): نتيجة_دفعة_ترميز_إكس {
    دع م: موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الموقع;
    لو (م.إزاحة_بايت <= 2147483647) {
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_انسكاب_إكس(&م);
        أرجع ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, &العنوان, 8, خطأ);
    };
    // disp32 موقّع. للوصول إلى موضع انسكاب أبعد، حرّك RSP مؤقتا إلى الموضع
    // نفسه ثم حمّل من [RSP] وأعد RSP مباشرة؛ لا نسرق سجلا حيا كسجل عنوان.
    ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, م.إزاحة_بايت, خطأ);
    دع العنوان_القريب: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(0);
    دع النتيجة: نتيجة_دفعة_ترميز_إكس = ألحق_تحميل_ذاكرة_إكس(
        البايتات, الوجهة, &العنوان_القريب, 8, خطأ
    );
    ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, م.إزاحة_بايت, صواب);
    أرجع النتيجة;
}

عرف ألحق_تخزين_انسكاب_إكس(
    البايتات: &متغير متجه غ8,
    الموقع: &موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    المصدر: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    دع م: موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الموقع;
    لو (م.إزاحة_بايت <= 2147483647) {
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_انسكاب_إكس(&م);
        أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, المصدر, &العنوان, 8);
    };
    ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, م.إزاحة_بايت, خطأ);
    دع العنوان_القريب: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(0);
    دع النتيجة: نتيجة_دفعة_ترميز_إكس = ألحق_تخزين_ذاكرة_إكس(
        البايتات, المصدر, &العنوان_القريب, 8
    );
    ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, م.إزاحة_بايت, صواب);
    أرجع النتيجة;
}

عرف عنوان_سجل_بإزاحة_إكس(
    السجل: معرف_سجل_فعلي,
    الإزاحة: غير_موقع
): عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    دع الأساس: اختيار معرف_سجل_فعلي = اختيار.بعض(السجل);
    دع الفهرس: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
    دع الناتج: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: الأساس,
        الفهرس: الفهرس,
        المقياس: 1,
        الإزاحة: الإزاحة_الموقعة
    };
    أرجع الناتج;
}

عرف حجم_حجج_مكدس_نداء_إكس(
    الخطة: &نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): غير_موقع {
    دع خ: نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *الخطة;
    دع النهاية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(خ.الحجج) مثل غير_موقع)) {
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول(خ.الحجج[ف].المواضع) مثل غير_موقع)) {
            طابق خ.الحجج[ف].المواضع[ج] مع
            | موضع_جزء_واجهة.مكدس(الموضع) -> {
                دع حد: غير_موقع = الموضع.الإزاحة + الموضع.الحجم;
                لو (حد > النهاية) { النهاية := حد; };
            }
            | _ -> { };
            ج := ج + 1;
        }
        ف := ف + 1;
    }
    أرجع النهاية;
}

عرف حجم_جزء_تجميع_واجهة_إكس(الحجم: غير_موقع, الفهرس: غير_موقع): غير_موقع {
    دع البداية: غير_موقع = الفهرس * 8;
    لو (البداية >= الحجم) { أرجع 0; };
    دع الباقي: غير_موقع = الحجم - البداية;
    لو (الباقي > 8) { أرجع 8; };
    أرجع الباقي;
}

عرف عدد_عناوين_تجميع_نداء_إكس(
    الخطة: &نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): غير_موقع {
    دع خ: نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *الخطة;
    دع العدد: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(خ.الحجج) مثل غير_موقع)) {
        لو (خ.الحجج[ف].تجميعي) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    طابق خ.الناتج مع
    | اختيار.بعض(الناتج) -> { لو (الناتج.تجميعي) { العدد := العدد + 1; }; }
    | اختيار.لا_شيء -> { };
    أرجع العدد;
}


عرف عدل_مصدر_نداء_بعد_خفض_المكدس_إكس(
    المصدر: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    تعديل_المكدس: غير_موقع
): موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    طابق *المصدر مع
    | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(السجل) -> {
        أرجع موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(السجل);
    }
    | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.انسكاب(الموضع) -> {
        دع الإزاحة_المعدلة: غير_موقع = الموضع.إزاحة_بايت + تعديل_المكدس;
        دع المعدل: موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = {
            السجل: الموضع.السجل,
            الفهرس: الموضع.الفهرس,
            إزاحة_بايت: الإزاحة_المعدلة,
            الحجم: الموضع.الحجم,
            المحاذاة: الموضع.المحاذاة
        };
        أرجع موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.انسكاب(المعدل);
    };
}

عرف ألحق_تخزين_حجة_مكدس_نداء_إكس(
    البايتات: &متغير متجه غ8,
    المصدر: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الموضع: &موضع_مكدس_واجهة,
    تعديل_المكدس: غير_موقع,
    سجل_العمل: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    دع م: موضع_مكدس_واجهة = *الموضع;
    دع عنوان_الوجهة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(م.الإزاحة);
    دع المصدر_المعدل: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
        عدل_مصدر_نداء_بعد_خفض_المكدس_إكس(المصدر, تعديل_المكدس);
    طابق سجل_موقع_قيمة_إكس(&المصدر_المعدل) مع
    | اختيار.بعض(السجل) -> {
        أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, السجل, &عنوان_الوجهة, 8);
    }
    | اختيار.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_إكس(&المصدر_المعدل) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()
            );
        }
        | اختيار.بعض(موضع_المصدر) -> {
            طابق ألحق_تحميل_انسكاب_إكس(البايتات, سجل_العمل, &موضع_المصدر) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_العمل, &عنوان_الوجهة, 8);
        };
    };
}

عرف ألحق_حفظ_موقع_في_مكدس_نداء_إكس(
    البايتات: &متغير متجه غ8,
    المصدر: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الإزاحة: غير_موقع,
    تعديل_المكدس: غير_موقع,
    سجل_العمل: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    دع العنوان_الوجهة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(الإزاحة);
    دع المصدر_المعدل: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
        عدل_مصدر_نداء_بعد_خفض_المكدس_إكس(المصدر, تعديل_المكدس);
    طابق سجل_موقع_قيمة_إكس(&المصدر_المعدل) مع
    | اختيار.بعض(السجل) -> {
        أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, السجل, &العنوان_الوجهة, 8);
    }
    | اختيار.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_إكس(&المصدر_المعدل) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()
            );
        }
        | اختيار.بعض(موضع_المصدر) -> {
            طابق ألحق_تحميل_انسكاب_إكس(البايتات, سجل_العمل, &موضع_المصدر) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_العمل, &العنوان_الوجهة, 8);
        };
    };
}

عرف ألحق_نقل_موقع_إكس(
    البايتات: &متغير متجه غ8,
    المصدر: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الوجهة: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    سجل_عمل: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    لو (موقعا_قيمة_إكس_متساويان(المصدر, الوجهة)) { أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); };
    طابق سجل_موقع_قيمة_إكس(المصدر) مع
    | اختيار.بعض(سجل_المصدر) -> {
        طابق سجل_موقع_قيمة_إكس(الوجهة) مع
        | اختيار.بعض(سجل_الوجهة) -> { أرجع ألحق_نقل_سجل_إكس(البايتات, سجل_الوجهة, سجل_المصدر); }
        | اختيار.لا_شيء -> {
            طابق انسكاب_موقع_قيمة_إكس(الوجهة) مع
            | اختيار.بعض(موضع_الوجهة) -> {
                أرجع ألحق_تخزين_انسكاب_إكس(البايتات, &موضع_الوجهة, سجل_المصدر);
            }
            | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); };
        };
    }
    | اختيار.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_إكس(المصدر) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); }
        | اختيار.بعض(موضع_المصدر) -> {
            طابق سجل_موقع_قيمة_إكس(الوجهة) مع
            | اختيار.بعض(سجل_الوجهة) -> { أرجع ألحق_تحميل_انسكاب_إكس(البايتات, سجل_الوجهة, &موضع_المصدر); }
            | اختيار.لا_شيء -> {
                طابق انسكاب_موقع_قيمة_إكس(الوجهة) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); }
                | اختيار.بعض(موضع_الوجهة) -> {
                    طابق ألحق_تحميل_انسكاب_إكس(البايتات, سجل_عمل, &موضع_المصدر) مع
                    | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    أرجع ألحق_تخزين_انسكاب_إكس(البايتات, &موضع_الوجهة, سجل_عمل);
                };
            };
        };
    };
}

عرف وجهة_مستخدمة_كمصدر_إكس(
    النقلات: &متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    النشطة: &متجه منطقي,
    الفهرس: غير_موقع
): منطقي {
    دع ن: متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *النقلات;
    دع ح: متجه منطقي = *النشطة;
    دع الوجهة: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = ن[الفهرس].الوجهة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ن) مثل غير_موقع)) {
        لو (ح[ف] && ف != الفهرس && موقعا_قيمة_إكس_متساويان(&الوجهة, &ن[ف].المصدر)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف استبدل_مصدر_موقع_إكس(
    النقلات: &متغير متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    النشطة: &متجه منطقي,
    القديم: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الجديد: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): فراغ {

    دع ن: متغير متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *النقلات;
    دع ح: متجه منطقي = *النشطة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ن) مثل غير_موقع)) {
        لو (ح[ف] && موقعا_قيمة_إكس_متساويان(&ن[ف].المصدر, القديم)) { ن[ف].المصدر := الجديد; };
        ف := ف + 1;
    }
    *النقلات := ن;

}

عرف ألحق_نقلات_مواقع_متوازية_إكس(
    البايتات: &متغير متجه غ8,
    النقلات_المدخلة: &متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع النقلات: متغير متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *النقلات_المدخلة;
    دع العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_للهدف(الهدف);
    لو ((الطول(العمل) مثل غير_موقع) < 2) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); };
    دع سجل_الدورة: معرف_سجل_فعلي = العمل[0];
    دع سجل_النقل: معرف_سجل_فعلي = العمل[1];
    دع النشطة: متغير متجه منطقي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النقلات) مثل غير_موقع)) { ألحق(النشطة, صواب); ف := ف + 1; }
    دع الباقي: متغير غير_موقع = الطول(النقلات) مثل غير_موقع;
    بينما (الباقي > 0) {
        دع تقدم: متغير منطقي = خطأ;
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول(النقلات) مثل غير_موقع)) {
            لو (النشطة[ن] && !وجهة_مستخدمة_كمصدر_إكس(&النقلات, &النشطة, ن)) {
                طابق ألحق_نقل_موقع_إكس(البايتات, &النقلات[ن].المصدر, &النقلات[ن].الوجهة, سجل_النقل) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                النشطة[ن] := خطأ; الباقي := الباقي - 1; تقدم := صواب;
            };
            ن := ن + 1;
        }
        لو (!تقدم && الباقي > 0) {
            دع أول: متغير غير_موقع = 0;
            بينما (أول < (الطول(النقلات) مثل غير_موقع) && !النشطة[أول]) { أول := أول + 1; }
            لو (أول >= (الطول(النقلات) مثل غير_موقع)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); };
            دع القديمة: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = النقلات[أول].الوجهة;
            دع المؤقت: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(سجل_الدورة);
            طابق ألحق_نقل_موقع_إكس(البايتات, &القديمة, &المؤقت, سجل_النقل) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            استبدل_مصدر_موقع_إكس(&متغير النقلات, &النشطة, &القديمة, المؤقت);
        };
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_نقلات_حافة_إكس(
    البايتات: &متغير متجه غ8,
    المتطلبات: &متطلبات_نقل_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع م: متطلبات_نقل_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *المتطلبات;
    دع مرجع_النقلات: &متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &م.النقلات;
    أرجع ألحق_نقلات_مواقع_متوازية_إكس(البايتات, مرجع_النقلات, الهدف);
}

عرف احذف_نقلة_نداء_إكس_عند(
    النقلات: &متجه نقلة_سجل_نداء_إكس,
    الفهرس: غير_موقع
): متجه نقلة_سجل_نداء_إكس {
    دع ن: متجه نقلة_سجل_نداء_إكس = *النقلات;
    دع الناتج: متغير متجه نقلة_سجل_نداء_إكس = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ن) مثل غير_موقع)) {
        لو (ف != الفهرس) {
            ألحق(الناتج, ن[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سجل_وجهة_مطلوب_كمصدر_نداء(
    النقلات: &متجه نقلة_سجل_نداء_إكس,
    الوجهة: معرف_سجل_فعلي
): منطقي {
    دع ن: متجه نقلة_سجل_نداء_إكس = *النقلات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ن) مثل غير_موقع)) {
        لو (
            !معرفا_سجل_فعلي_متساويان(ن[ف].المصدر, ن[ف].الوجهة)
            && معرفا_سجل_فعلي_متساويان(ن[ف].المصدر, الوجهة)
        ) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف ألحق_نقلات_نداء_إكس(
    البايتات: &متغير متجه غ8,
    النقلات: &متجه نقلة_سجل_نداء_إكس,
    سجل_العمل: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    دع الباقية: متغير متجه نقلة_سجل_نداء_إكس = *النقلات;
    بينما ((الطول(الباقية) مثل غير_موقع) != 0) {
        دع تقدم: متغير منطقي = خطأ;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الباقية) مثل غير_موقع)) {
            دع النقلة: نقلة_سجل_نداء_إكس = الباقية[ف];
            لو (معرفا_سجل_فعلي_متساويان(النقلة.المصدر, النقلة.الوجهة)) {
                الباقية := احذف_نقلة_نداء_إكس_عند(&الباقية, ف);
                تقدم := صواب;
                ف := الطول(الباقية) مثل غير_موقع;
            } وإلا لو (!سجل_وجهة_مطلوب_كمصدر_نداء(&الباقية, النقلة.الوجهة)) {
                طابق ألحق_نقل_سجل_إكس(البايتات, النقلة.الوجهة, النقلة.المصدر) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ);
                }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                الباقية := احذف_نقلة_نداء_إكس_عند(&الباقية, ف);
                تقدم := صواب;
                ف := الطول(الباقية) مثل غير_موقع;
            } وإلا {
                ف := ف + 1;
            };
        }
        لو (!تقدم) {
            دع الأولى: نقلة_سجل_نداء_إكس = الباقية[0];
            دع المؤقت: معرف_سجل_فعلي = سجل_العمل;
            طابق ألحق_نقل_سجل_إكس(البايتات, المؤقت, الأولى.المصدر) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ);
            }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            الباقية[0].المصدر := المؤقت;
        };
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف رمز_شرط_إكس(الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون): غير_موقع {
    طابق الشرط مع
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ -> {
        أرجع 4;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.لاتكافؤ -> {
        أرجع 5;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة -> {
        أرجع 12;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو -> {
        أرجع 14;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة -> {
        أرجع 15;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو -> {
        أرجع 13;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_غير_موقع -> {
        أرجع 2;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_غير_موقع_أو_مساو -> {
        أرجع 6;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_غير_موقع -> {
        أرجع 7;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_غير_موقع_أو_مساو -> {
        أرجع 3;
    };
}

عرف رمز_شرط_معكوس_إكس(الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون): غير_موقع {
    طابق الشرط مع
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ -> { أرجع 5; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.لاتكافؤ -> { أرجع 4; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة -> { أرجع 13; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو -> { أرجع 15; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة -> { أرجع 14; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو -> { أرجع 12; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_غير_موقع -> { أرجع 3; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_غير_موقع_أو_مساو -> { أرجع 7; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_غير_موقع -> { أرجع 6; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_غير_موقع_أو_مساو -> { أرجع 2; };
}

عرف إزاحة_نسبية_32(من_بعد: غير_موقع, إلى: غير_موقع): نتيجة_إزاحة_نسبية_32 {
    دع الفرق: متغير عدد = 0;
    لو (إلى >= من_بعد) {
        الفرق := (إلى - من_بعد) مثل عدد;
    } وإلا {
        الفرق := -((من_بعد - إلى) مثل عدد);
    };
    لو (الفرق < -2147483648 || الفرق > 2147483647) {
        أرجع نتيجة_إزاحة_نسبية_32.خارج_المدى();
    };
    لو (الفرق < 0) {
        دع الحقل: عدد = 4294967296 + الفرق;
        أرجع نتيجة_إزاحة_نسبية_32.نجحت(الحقل مثل غير_موقع);
    };
    أرجع نتيجة_إزاحة_نسبية_32.نجحت(الفرق مثل غير_موقع);
}

عرف ابحث_موضع_كتلة_إكس(
    المواقع: &متجه موضع_كتلة_إكس,
    المعرف: معرف_كتلة_منتقاة
): اختيار غير_موقع {
    دع م: متجه موضع_كتلة_إكس = *المواقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م) مثل غير_موقع)) {
        لو (معرفا_كتلة_منتقاة_متساويان(م[ف].المعرف, المعرف)) {
            أرجع اختيار.بعض(م[ف].إزاحة_بايت);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف دالة_موجودة_مشفرة(
    الدوال: &متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    المعرف: معرف_دالة_منتقاة
): منطقي {
    دع د: متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = *الدوال;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(د) مثل غير_موقع)) {
        لو (معرفا_دالة_منتقاة_متساويان(د[ف].الدالة, المعرف)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف ألحق_فرع_إكس_مؤجل(
    البايتات: &متغير متجه غ8,
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    الهدف: معرف_كتلة_منتقاة,
    شرطي: اختيار شرط_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    طابق شرطي مع
    | اختيار.بعض(الشرط) -> {
        ألحق_بايت_إكس(البايتات, 0x0F);
        ألحق_بايت_إكس(البايتات, 0x80 + رمز_شرط_إكس(الشرط));
    }
    | اختيار.لا_شيء -> {
        ألحق_بايت_إكس(البايتات, 0xE9);
    };
    دع الموضع: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    ألحق_غ32_إكس(البايتات, 0);
    دع بعد: غير_موقع = الطول(*البايتات) مثل غير_موقع;

    دع التثبيت: تثبيت_فرع_إكس_مؤجل = {
        إزاحة_الحقل: الموضع,
        بعد_التعليمة: بعد,
        الهدف: الهدف
    };
    ألحق_فرع_إكس_للمشفّر(الفروع, التثبيت);

}

عرف سجلان_فعليان_متساويان_إكس(أ: معرف_سجل_فعلي, ب: معرف_سجل_فعلي): منطقي {
    أرجع معرفا_سجل_فعلي_متساويان(أ, ب);
}

عرف اختر_سجل_عمل_إكس(
    الهدف: &واصف_هدف,
    ممنوع1: اختيار معرف_سجل_فعلي,
    ممنوع2: اختيار معرف_سجل_فعلي,
    ممنوع3: اختيار معرف_سجل_فعلي
): اختيار معرف_سجل_فعلي {
    دع العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_للهدف(الهدف);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(العمل) مثل غير_موقع)) {
        دع س: معرف_سجل_فعلي = العمل[ف];
        دع مرفوض: متغير منطقي = خطأ;
        طابق ممنوع1 مع | اختيار.بعض(م) -> { لو (سجلان_فعليان_متساويان_إكس(س, م)) { مرفوض := صواب; }; } | اختيار.لا_شيء -> { };
        طابق ممنوع2 مع | اختيار.بعض(م) -> { لو (سجلان_فعليان_متساويان_إكس(س, م)) { مرفوض := صواب; }; } | اختيار.لا_شيء -> { };
        طابق ممنوع3 مع | اختيار.بعض(م) -> { لو (سجلان_فعليان_متساويان_إكس(س, م)) { مرفوض := صواب; }; } | اختيار.لا_شيء -> { };
        لو (!مرفوض) { أرجع اختيار.بعض(س); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ألحق_إزاحة_فورية_64_إكس(
    البايتات: &متغير متجه غ8,
    السجل: معرف_سجل_فعلي,
    المقدار: غير_موقع,
    لليسار: منطقي
): نتيجة_دفعة_ترميز_إكس {
    لو (المقدار == 0) { أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); };
    لو (!سجل_إكس_قابل_للترميز(السجل) || المقدار >= 64) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(السجل)
        );
    };
    ألحق_بايت_إكس(البايتات, ركس_إكس(اختيار.لا_شيء(), اختيار.بعض(السجل)));
    ألحق_بايت_إكس(البايتات, 0xC1);
    دع الحقل: متغير غير_موقع = 5;
    لو (لليسار) { الحقل := 4; };
    دع حقل_مود: معرف_سجل_فعلي = { القيمة: الحقل };
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(حقل_مود, السجل));
    ألحق_بايت_إكس(البايتات, المقدار);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تحميل_جزء_تجميع_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الحجم: غير_موقع,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    لو (الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8) {
        أرجع ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, العنوان, الحجم, خطأ);
    };
    لو (الحجم == 0 || الحجم > 8) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم)
        );
    };
    دع الأصل: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(الوجهة), الأصل.الأساس, الأصل.الفهرس) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()
        );
    }
    | اختيار.بعض(السجل) -> { العمل := السجل; };
    دع المنجز: متغير غير_موقع = 0;
    بينما (المنجز < الحجم) {
        دع الباقي: غير_موقع = الحجم - المنجز;
        دع الجزء: متغير غير_موقع = 1;
        لو (الباقي >= 4) { الجزء := 4; } وإلا لو (الباقي >= 2) { الجزء := 2; };
        دع الحالي: متغير عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = الأصل;
        الحالي.الإزاحة := الحالي.الإزاحة + (المنجز مثل عدد);
        لو (المنجز == 0) {
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, &الحالي, الجزء, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        } وإلا {
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, العمل, &الحالي, الجزء, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_إزاحة_فورية_64_إكس(البايتات, العمل, المنجز * 8, صواب) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, الوجهة, العمل, 0x08, 0x09) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        };
        المنجز := المنجز + الجزء;
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تخزين_جزء_تجميع_إكس(
    البايتات: &متغير متجه غ8,
    المصدر: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الحجم: غير_موقع,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    لو (الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8) {
        أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, المصدر, العنوان, الحجم);
    };
    لو (الحجم == 0 || الحجم > 8) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم)
        );
    };
    دع الأصل: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(المصدر), الأصل.الأساس, الأصل.الفهرس) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()
        );
    }
    | اختيار.بعض(السجل) -> { العمل := السجل; };
    دع المنجز: متغير غير_موقع = 0;
    بينما (المنجز < الحجم) {
        دع الباقي: غير_موقع = الحجم - المنجز;
        دع الجزء: متغير غير_موقع = 1;
        لو (الباقي >= 4) { الجزء := 4; } وإلا لو (الباقي >= 2) { الجزء := 2; };
        دع الحالي: متغير عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = الأصل;
        الحالي.الإزاحة := الحالي.الإزاحة + (المنجز مثل عدد);
        لو (المنجز == 0) {
            طابق ألحق_تخزين_ذاكرة_إكس(البايتات, المصدر, &الحالي, الجزء) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        } وإلا {
            طابق ألحق_نقل_سجل_إكس(البايتات, العمل, المصدر) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_إزاحة_فورية_64_إكس(البايتات, العمل, المنجز * 8, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_تخزين_ذاكرة_إكس(البايتات, العمل, &الحالي, الجزء) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        };
        المنجز := المنجز + الجزء;
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_نقل_فوري_بتات_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    القيمة: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    لو (!سجل_إكس_قابل_للترميز(الوجهة)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)); };
    ألحق_بايت_إكس(البايتات, ركس_إكس(اختيار.لا_شيء(), اختيار.بعض(الوجهة)));
    ألحق_بايت_إكس(البايتات, 0xB8 + (الوجهة.القيمة % 8));
    ألحق_غ64_إكس(البايتات, القيمة);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ركس_عرض_سجلين_إكس(
    البتات: غير_موقع,
    حقل: معرف_سجل_فعلي,
    قاعدة: معرف_سجل_فعلي
): غير_موقع {
    دع القيمة: متغير غير_موقع = 0x40;
    لو (البتات == 64) { القيمة := القيمة + 8; };
    لو (حقل.القيمة >= 8) { القيمة := القيمة + 4; };
    لو (قاعدة.القيمة >= 8) { القيمة := القيمة + 1; };
    أرجع القيمة;
}

عرف ألحق_عملية_سجلين_بعرض_إكس(
    البايتات: &متغير متجه غ8,
    البتات: غير_موقع,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    رمز8: غير_موقع,
    رمز_أوسع: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    لو (!(البتات == 8 || البتات == 16 || البتات == 32 || البتات == 64)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8)); };
    لو (!سجل_إكس_قابل_للترميز(الوجهة) || !سجل_إكس_قابل_للترميز(المصدر)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)); };
    لو (البتات == 16) { ألحق_بايت_إكس(البايتات, 0x66); };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, المصدر, الوجهة));
    لو (البتات == 8) { ألحق_بايت_إكس(البايتات, رمز8); } وإلا { ألحق_بايت_إكس(البايتات, رمز_أوسع); };
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_مقارنة_بعرض_إكس(
    البايتات: &متغير متجه غ8,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    أرجع ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, أ, ب, 0x38, 0x39);
}

عرف ألحق_توسيع_خام_إلى64_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    البتات: غير_موقع,
    بإشارة: منطقي
): نتيجة_دفعة_ترميز_إكس {
    لو (البتات == 64) { أرجع ألحق_نقل_سجل_إكس(البايتات, الوجهة, المصدر); };
    لو (!(البتات == 8 || البتات == 16 || البتات == 32)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8)); };
    لو (بإشارة) {
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, الوجهة, المصدر));
        لو (البتات == 32) { ألحق_بايت_إكس(البايتات, 0x63); }
        وإلا { ألحق_بايت_إكس(البايتات, 0x0F); لو (البتات == 8) { ألحق_بايت_إكس(البايتات, 0xBE); } وإلا { ألحق_بايت_إكس(البايتات, 0xBF); }; };
        ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(الوجهة, المصدر));
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
    لو (البتات == 32) {
        // MOV r32,r32 zero-extends into the full physical register.
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(32, المصدر, الوجهة)); ألحق_بايت_إكس(البايتات, 0x89); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
    } وإلا {
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, الوجهة, المصدر)); ألحق_بايت_إكس(البايتات, 0x0F); لو (البتات == 8) { ألحق_بايت_إكس(البايتات, 0xB6); } وإلا { ألحق_بايت_إكس(البايتات, 0xB7); }; ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(الوجهة, المصدر));
    };
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تقنين_عرض_إكس(
    البايتات: &متغير متجه غ8,
    السجل: معرف_سجل_فعلي,
    البتات: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    لو (البتات == 64) { أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); };
    أرجع ألحق_توسيع_خام_إلى64_إكس(البايتات, السجل, السجل, البتات, خطأ);
}

عرف ألحق_فخ_إكس(البايتات: &متغير متجه غ8): فراغ { ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x0B); }

عرف ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات: &متغير متجه غ8, رمز_الشرط: غير_موقع): فراغ {
    ألحق_بايت_إكس(البايتات, 0x70 + رمز_الشرط); ألحق_بايت_إكس(البايتات, 2); ألحق_فخ_إكس(البايتات);
}

عرف ألحق_مقارنة_فوري8_إكس(البايتات: &متغير متجه غ8, السجل: معرف_سجل_فعلي, القيمة: غير_موقع): فراغ {
    دع حقل_مقارنة: معرف_سجل_فعلي = { القيمة: 7 }; ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, حقل_مقارنة, السجل));
    ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, 0xF8 + (السجل.القيمة % 8)); ألحق_بايت_إكس(البايتات, القيمة);
}

عرف ألحق_اختبار_سجل_إكس(البايتات: &متغير متجه غ8, السجل: معرف_سجل_فعلي): فراغ {
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, السجل, السجل)); ألحق_بايت_إكس(البايتات, 0x85); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(السجل, السجل));
}

عرف ألحق_مقارنة_إلى_منطق_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون,
    البتات: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    طابق ألحق_مقارنة_بعرض_إكس(البايتات, أ, ب, البتات) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع ركس: متغير غير_موقع = 0x40; لو (الوجهة.القيمة >= 8) { ركس := ركس + 1; }; ألحق_بايت_إكس(البايتات, ركس);
    ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x90 + رمز_شرط_إكس(الشرط)); ألحق_بايت_إكس(البايتات, 0xC0 + (الوجهة.القيمة % 8));
    أرجع ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, الوجهة, 8, خطأ);
}

عرف ألحق_تحويل_صحيح_إكس(
    البايتات: &متغير متجه غ8,
    العملية: تحويل_صحيح_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    من_بتات: غير_موقع,
    إلى_بتات: غير_موقع,
    المصدر_موقع: منطقي
): نتيجة_دفعة_ترميز_إكس {
    طابق العملية مع
    | تحويل_صحيح_إكس_كامل.توسيع_بإشارة -> {
        طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, المصدر, من_بتات, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, إلى_بتات);
    }
    | تحويل_صحيح_إكس_كامل.توسيع_صفري -> {
        طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, المصدر, من_بتات, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, إلى_بتات);
    }
    | تحويل_صحيح_إكس_كامل.اقتطاع -> {
        طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, المصدر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, إلى_بتات);
    }
    | تحويل_صحيح_إكس_كامل.إعادة_تفسير -> {
        طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, المصدر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, إلى_بتات);
    };
}

عرف ألحق_ضرب_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: غير_موقع,
    بإشارة: منطقي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع م1: متغير معرف_سجل_فعلي = { القيمة: 0 }; دع م2: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(الوجهة), اختيار.بعض(أ), اختيار.بعض(ب)) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختيار.بعض(س) -> { م1 := س; };
    دع ركس_أ_ضرب: معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(الوجهة), اختيار.بعض(ركس_أ_ضرب), اختيار.بعض(م1)) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختيار.بعض(س) -> { م2 := س; };
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, م1, أ, البتات, بإشارة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, م2, ب, البتات, بإشارة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, م1) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    // IMUL r64,r/m64. For narrow widths the full product fits 64 bits and is range-checked below.
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, الوجهة, م2)); ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0xAF); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(الوجهة, م2));
    لو (البتات == 64) {
        لو (بإشارة) { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1); أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); };
        // unsigned 64-bit multiply needs the high half. Recompute with MUL using RAX/RDX and trap when RDX != 0.
        دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 }; دع ركس_د: معرف_سجل_فعلي = { القيمة: 2 };
        طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, م1) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        دع حقل_ضرب: معرف_سجل_فعلي = { القيمة: 4 }; ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, حقل_ضرب, م2)); ألحق_بايت_إكس(البايتات, 0xF7); ألحق_بايت_إكس(البايتات, 0xE0 + (م2.القيمة % 8));
        ألحق_اختبار_سجل_إكس(البايتات, ركس_د); ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 4);
        أرجع ألحق_نقل_سجل_إكس(البايتات, الوجهة, ركس_أ);
    };
    دع فحص: متغير معرف_سجل_فعلي = م1;
    طابق ألحق_نقل_سجل_إكس(البايتات, فحص, الوجهة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تقنين_عرض_إكس(البايتات, فحص, البتات) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    لو (بإشارة) { طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, فحص, فحص, البتات, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; };
    طابق ألحق_مقارنة_بعرض_إكس(البايتات, فحص, الوجهة, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 4);
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

عرف ألحق_قسمة_أو_باقي_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: غير_موقع,
    بإشارة: منطقي,
    باقي: منطقي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع يسار: متغير معرف_سجل_فعلي = { القيمة: 0 }; دع يمين: متغير معرف_سجل_فعلي = { القيمة: 0 };
    دع ركس_أ_محجوز: معرف_سجل_فعلي = { القيمة: 0 };
    دع ركس_د_محجوز: معرف_سجل_فعلي = { القيمة: 2 };
    // احفظ اليسار في سجل عمل لا يمكن أن يطغى على اليمين قبل نسخه.
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(ركس_أ_محجوز), اختيار.بعض(ركس_د_محجوز), اختيار.بعض(ب)) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختيار.بعض(س) -> { يسار := س; };
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(ركس_أ_محجوز), اختيار.بعض(ركس_د_محجوز), اختيار.بعض(يسار)) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختيار.بعض(س) -> { يمين := س; };
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, يسار, أ, البتات, بإشارة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, يمين, ب, البتات, بإشارة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_اختبار_سجل_إكس(البايتات, يمين); ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 5);
    لو (بإشارة && البتات < 64) {
        دع حد: متغير معرف_سجل_فعلي = { القيمة: 0 };
        طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(يسار), اختيار.بعض(يمين), اختيار.بعض(الوجهة)) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختيار.بعض(س) -> { حد := س; };
        دع صفر_غير_موقع: غير_موقع = 0;
        دع واحد_غير_موقع: غير_موقع = 1;
        دع كل_البتات: غير_موقع = ~(صفر_غير_موقع);
        دع بت_الإشارة: غير_موقع = واحد_غير_موقع << (البتات - 1);
        دع قناع_الإشارة_العليا: غير_موقع = كل_البتات << البتات;
        دع قيمة_الصغرى: غير_موقع = قناع_الإشارة_العليا | بت_الإشارة;
        طابق ألحق_نقل_فوري_بتات_إكس(البايتات, حد, قيمة_الصغرى) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_مقارنة_بعرض_إكس(البايتات, يسار, حد, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, 0x75); ألحق_بايت_إكس(البايتات, 8);
        ألحق_مقارنة_فوري8_إكس(البايتات, يمين, 255);
        ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 5);
    };
    دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 }; دع ركس_د: معرف_سجل_فعلي = { القيمة: 2 };
    طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, يسار) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    لو (بإشارة) { ألحق_بايت_إكس(البايتات, 0x48); ألحق_بايت_إكس(البايتات, 0x99); }
    وإلا { ألحق_بايت_إكس(البايتات, 0x31); ألحق_بايت_إكس(البايتات, 0xD2); };
    دع حقل_قسمة: متغير غير_موقع = 0xF0;
    لو (بإشارة) { حقل_قسمة := 0xF8; };
    دع سجل_حقل_قسمة: معرف_سجل_فعلي = { القيمة: 7 };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, سجل_حقل_قسمة, يمين)); ألحق_بايت_إكس(البايتات, 0xF7); ألحق_بايت_إكس(البايتات, حقل_قسمة + (يمين.القيمة % 8));
    لو (باقي) { طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, ركس_د) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    وإلا { طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

عرف ألحق_إزاحة_بعدد_سي_إكس(
    البايتات: &متغير متجه غ8,
    السجل: معرف_سجل_فعلي,
    البتات: غير_موقع,
    الحقل: غير_موقع
): فراغ {
    لو (البتات == 16) { ألحق_بايت_إكس(البايتات, 0x66); };
    دع حقل_إزاحة_ركس: معرف_سجل_فعلي = { القيمة: 0 };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, حقل_إزاحة_ركس, السجل));
    لو (البتات == 8) { ألحق_بايت_إكس(البايتات, 0xD2); } وإلا { ألحق_بايت_إكس(البايتات, 0xD3); };
    ألحق_بايت_إكس(البايتات, 0xC0 + (الحقل * 8) + (السجل.القيمة % 8));
}

عرف ألحق_إزاحة_إكس(
    البايتات: &متغير متجه غ8,
    العملية: حساب_صحيح_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: غير_موقع,
    بإشارة: منطقي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    // x86 يخفي عداد الإزاحة إلى خمس/ست بتات؛ MSIR لا يفعل ذلك، لذلك نفخ قبل التعليمة.
    ألحق_مقارنة_فوري8_إكس(البايتات, ب, البتات);
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 2);

    دع سجل_العد: معرف_سجل_فعلي = { القيمة: 1 };
    دع سجل_القيمة: متغير معرف_سجل_فعلي = { القيمة: 0 };
    // احتفظ بالأصل في أ لفحص تجاوز الإزاحة اليسرى؛ سجلات allocator العامة لا تشمل RCX.
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(سجل_العد), اختيار.بعض(ب), اختيار.بعض(أ)) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); }
    | اختيار.بعض(س) -> { سجل_القيمة := س; };
    طابق ألحق_نقل_سجل_إكس(البايتات, سجل_القيمة, أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_سجل_إكس(البايتات, سجل_العد, ب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

    دع حقل: متغير غير_موقع = 4;
    دع إزاحة_يسرى: متغير منطقي = خطأ;
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.إزاحة_يسرى -> { حقل := 4; إزاحة_يسرى := صواب; }
    | حساب_صحيح_إكس_كامل.إزاحة_يمنى -> { حقل := 5; }
    | حساب_صحيح_إكس_كامل.إزاحة_حسابية_يمنى -> { حقل := 7; }
    | _ -> { };
    ألحق_إزاحة_بعدد_سي_إكس(البايتات, سجل_القيمة, البتات, حقل);

    لو (إزاحة_يسرى) {
        // MSIR يجعل فقدان أي بت ذي دلالة تجاوزا. اعكس الإزاحة وقارن بالأصل قبل قبول الناتج.
        دع حقل_العكس: متغير غير_موقع = 5;
        لو (بإشارة) { حقل_العكس := 7; };
        ألحق_إزاحة_بعدد_سي_إكس(البايتات, سجل_القيمة, البتات, حقل_العكس);
        طابق ألحق_مقارنة_بعرض_إكس(البايتات, سجل_القيمة, أ, البتات) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 4);
        // أعد تكوين الناتج الصحيح بعد أن استُخدمت نسخة العمل للفحص العكسي.
        ألحق_إزاحة_بعدد_سي_إكس(البايتات, سجل_القيمة, البتات, 4);
    };

    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, سجل_القيمة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

عرف احفظ_يمين_عملية_ثنائية_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    الهدف: &واصف_هدف
): نتيجة معرف_سجل_فعلي, خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون {
    لو (!سجلان_فعليان_متساويان_إكس(الوجهة, ب) || سجلان_فعليان_متساويان_إكس(أ, ب)) {
        أرجع نتيجة.نجح(ب);
    };
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(الوجهة), اختيار.بعض(أ), اختيار.بعض(ب)) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); }
    | اختيار.بعض(العمل) -> {
        طابق ألحق_نقل_سجل_إكس(البايتات, العمل, ب) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { أرجع نتيجة.نجح(العمل); };
    };
}

عرف ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(
    البايتات: &متغير متجه غ8,
    السجل_العائم: غير_موقع,
    المصدر: معرف_سجل_فعلي,
    البتات: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    لو (!(البتات == 32 || البتات == 64)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8));
    };
    لو (!سجل_إكس_قابل_للترميز(المصدر) || السجل_العائم > 7) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر));
    };
    دع حقل: معرف_سجل_فعلي = { القيمة: السجل_العائم };
    ألحق_بايت_إكس(البايتات, 0x66);
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, حقل, المصدر));
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x6E);
    ألحق_بايت_إكس(البايتات, 0xC0 + ((السجل_العائم % 8) * 8) + (المصدر.القيمة % 8));
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    السجل_العائم: غير_موقع,
    البتات: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    لو (!(البتات == 32 || البتات == 64)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8));
    };
    لو (!سجل_إكس_قابل_للترميز(الوجهة) || السجل_العائم > 7) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة));
    };
    دع حقل: معرف_سجل_فعلي = { القيمة: السجل_العائم };
    ألحق_بايت_إكس(البايتات, 0x66);
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, حقل, الوجهة));
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x7E);
    ألحق_بايت_إكس(البايتات, 0xC0 + ((السجل_العائم % 8) * 8) + (الوجهة.القيمة % 8));
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_حساب_عشري_إكس(
    البايتات: &متغير متجه غ8,
    العملية: حساب_عشري_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 0, أ, البتات) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 1, ب, البتات) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    لو (البتات == 32) { ألحق_بايت_إكس(البايتات, 0xF3); } وإلا { ألحق_بايت_إكس(البايتات, 0xF2); };
    ألحق_بايت_إكس(البايتات, 0x0F);
    دع الرمز: متغير غير_موقع = 0x58;
    طابق العملية مع
    | حساب_عشري_إكس_كامل.جمع -> { الرمز := 0x58; }
    | حساب_عشري_إكس_كامل.طرح -> { الرمز := 0x5C; }
    | حساب_عشري_إكس_كامل.ضرب -> { الرمز := 0x59; }
    | حساب_عشري_إكس_كامل.قسمة -> { الرمز := 0x5E; };
    ألحق_بايت_إكس(البايتات, الرمز);
    ألحق_بايت_إكس(البايتات, 0xC1);
    أرجع ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(البايتات, الوجهة, 0, البتات);
}

عرف ألحق_ثبت_شرط_عشري_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    رمز_الشرط: غير_موقع,
    صحح_عدم_الترتيب: منطقي,
    قيمة_عدم_الترتيب: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    دع ركس: متغير غير_موقع = 0x40;
    لو (الوجهة.القيمة >= 8) { ركس := ركس + 1; };
    ألحق_بايت_إكس(البايتات, ركس);
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x90 + رمز_الشرط);
    ألحق_بايت_إكس(البايتات, 0xC0 + (الوجهة.القيمة % 8));
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, الوجهة, 8, خطأ) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    لو (صحح_عدم_الترتيب) {
        // UCOMI sets PF for unordered. MOV/MOVZX keep flags intact, so ordered values skip the override.
        ألحق_بايت_إكس(البايتات, 0x7B); // JNP
        ألحق_بايت_إكس(البايتات, 10);
        أرجع ألحق_نقل_فوري_بتات_إكس(البايتات, الوجهة, قيمة_عدم_الترتيب);
    };
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_مقارنة_عشرية_إلى_منطق_إكس(
    البايتات: &متغير متجه غ8,
    العملية: مقارنة_عشرية_إكس_كاملة,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: غير_موقع
): نتيجة_دفعة_ترميز_إكس {
    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 0, أ, البتات) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 1, ب, البتات) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    لو (البتات == 64) { ألحق_بايت_إكس(البايتات, 0x66); };
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x2E);
    ألحق_بايت_إكس(البايتات, 0xC1); // UCOMIS{S,D} xmm0,xmm1
    طابق العملية مع
    | مقارنة_عشرية_إكس_كاملة.يساوي -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 4, صواب, 0); }
    | مقارنة_عشرية_إكس_كاملة.لا_يساوي -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 5, صواب, 1); }
    | مقارنة_عشرية_إكس_كاملة.أصغر -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 2, صواب, 0); }
    | مقارنة_عشرية_إكس_كاملة.أصغر_أو_يساوي -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 6, صواب, 0); }
    | مقارنة_عشرية_إكس_كاملة.أكبر -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 7, خطأ, 0); }
    | مقارنة_عشرية_إكس_كاملة.أكبر_أو_يساوي -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 3, خطأ, 0); };
}

عرف ألحق_حساب_صحيح_كامل_إكس(
    البايتات: &متغير متجه غ8,
    العملية: حساب_صحيح_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: غير_موقع,
    بإشارة: منطقي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.ضرب -> { أرجع ألحق_ضرب_إكس(البايتات, الوجهة, أ, ب, البتات, بإشارة, الهدف); }
    | حساب_صحيح_إكس_كامل.قسمة_موقعة -> { أرجع ألحق_قسمة_أو_باقي_إكس(البايتات, الوجهة, أ, ب, البتات, صواب, خطأ, الهدف); }
    | حساب_صحيح_إكس_كامل.قسمة_غير_موقعة -> { أرجع ألحق_قسمة_أو_باقي_إكس(البايتات, الوجهة, أ, ب, البتات, خطأ, خطأ, الهدف); }
    | حساب_صحيح_إكس_كامل.باقي_موقع -> { أرجع ألحق_قسمة_أو_باقي_إكس(البايتات, الوجهة, أ, ب, البتات, صواب, صواب, الهدف); }
    | حساب_صحيح_إكس_كامل.باقي_غير_موقع -> { أرجع ألحق_قسمة_أو_باقي_إكس(البايتات, الوجهة, أ, ب, البتات, خطأ, صواب, الهدف); }
    | حساب_صحيح_إكس_كامل.إزاحة_يسرى -> { أرجع ألحق_إزاحة_إكس(البايتات, العملية, الوجهة, أ, ب, البتات, بإشارة, الهدف); }
    | حساب_صحيح_إكس_كامل.إزاحة_يمنى -> { أرجع ألحق_إزاحة_إكس(البايتات, العملية, الوجهة, أ, ب, البتات, بإشارة, الهدف); }
    | حساب_صحيح_إكس_كامل.إزاحة_حسابية_يمنى -> { أرجع ألحق_إزاحة_إكس(البايتات, العملية, الوجهة, أ, ب, البتات, بإشارة, الهدف); }
    | _ -> { };
    دع يمين_آمن: متغير معرف_سجل_فعلي = ب;
    طابق احفظ_يمين_عملية_ثنائية_إكس(البايتات, الوجهة, أ, ب, الهدف) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة.نجح(س) -> { يمين_آمن := س; };
    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; لو (بإشارة) { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1); } وإلا { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 3); }; }
    | حساب_صحيح_إكس_كامل.طرح -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x28, 0x29) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; لو (بإشارة) { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1); } وإلا { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 3); }; }
    | حساب_صحيح_إكس_كامل.و_بتي -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x20, 0x21) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x08, 0x09) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x30, 0x31) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    | _ -> { };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

عرف ألحق_تكوين_عنوان_مقاس_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي,
    الفهرس: معرف_سجل_فعلي,
    الحجم: غير_موقع,
    الإزاحة: عدد,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    طابق بتات_مقياس_إكس(الحجم) مع
    | اختيار.بعض(_) -> {
        دع أساس_العنوان: اختيار معرف_سجل_فعلي = اختيار.بعض(الأساس);
        دع فهرس_العنوان: اختيار معرف_سجل_فعلي = اختيار.بعض(الفهرس);
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
            الأساس: أساس_العنوان,
            الفهرس: فهرس_العنوان,
            المقياس: الحجم,
            الإزاحة: الإزاحة
        };
        أرجع ألحق_تكوين_عنوان_إكس(البايتات, الوجهة, &العنوان);
    }
    | اختيار.لا_شيء -> {
        دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
        طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(الوجهة), اختيار.بعض(الأساس), اختيار.بعض(الفهرس)) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختيار.بعض(س) -> { العمل := س; };
        طابق ألحق_نقل_سجل_إكس(البايتات, العمل, الفهرس) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, العمل, العمل)); ألحق_بايت_إكس(البايتات, 0x69); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(العمل, العمل)); ألحق_غ32_إكس(البايتات, الحجم);
        دع أساس_العنوان: اختيار معرف_سجل_فعلي = اختيار.بعض(الأساس);
        دع فهرس_العنوان: اختيار معرف_سجل_فعلي = اختيار.بعض(العمل);
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
            الأساس: أساس_العنوان,
            الفهرس: فهرس_العنوان,
            المقياس: 1,
            الإزاحة: الإزاحة
        };
        أرجع ألحق_تكوين_عنوان_إكس(البايتات, الوجهة, &العنوان);
    };
}

عرف ألحق_عنوان_موضع_محلي_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    المعرف: غير_موقع,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): نتيجة_دفعة_ترميز_إكس {
    طابق ابحث_موضع_محلي_إكس(الإطار, المعرف) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.موضع_محلي_مفقود(المعرف)); }
    | اختيار.بعض(الموضع) -> { دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(الموضع.إزاحة_بايت); أرجع ألحق_تكوين_عنوان_إكس(البايتات, الوجهة, &العنوان); };
}

عرف ألحق_نسخ_ذاكرة_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    الحجم: غير_موقع,
    إزاحة_الوجهة: غير_موقع,
    إزاحة_المصدر: غير_موقع,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(الوجهة), اختيار.بعض(المصدر), اختيار.لا_شيء()) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختيار.بعض(س) -> { العمل := س; };
    دع المنجز: متغير غير_موقع = 0;
    بينما (المنجز < الحجم) {
        دع الباقي: غير_موقع = الحجم - المنجز; دع جزء: متغير غير_موقع = 1;
        لو (الباقي >= 8) { جزء := 8; } وإلا لو (الباقي >= 4) { جزء := 4; } وإلا لو (الباقي >= 2) { جزء := 2; };
        دع أساس_المصدر: اختيار معرف_سجل_فعلي = اختيار.بعض(المصدر);
        دع فهرس_المصدر: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
        دع إزاحة_المصدر_الحالية: غير_موقع = إزاحة_المصدر + المنجز;
        دع إزاحة_المصدر_الموقعة: عدد = إزاحة_المصدر_الحالية مثل عدد;
        دع ع_م: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
            الأساس: أساس_المصدر,
            الفهرس: فهرس_المصدر,
            المقياس: 1,
            الإزاحة: إزاحة_المصدر_الموقعة
        };
        دع أساس_الوجهة: اختيار معرف_سجل_فعلي = اختيار.بعض(الوجهة);
        دع فهرس_الوجهة: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
        دع إزاحة_الوجهة_الحالية: غير_موقع = إزاحة_الوجهة + المنجز;
        دع إزاحة_الوجهة_الموقعة: عدد = إزاحة_الوجهة_الحالية مثل عدد;
        دع ع_و: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
            الأساس: أساس_الوجهة,
            الفهرس: فهرس_الوجهة,
            المقياس: 1,
            الإزاحة: إزاحة_الوجهة_الموقعة
        };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, العمل, &ع_م, جزء, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, العمل, &ع_و, جزء) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        المنجز := المنجز + جزء;
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تخزين_فوري_ذاكرة_إكس(
    البايتات: &متغير متجه غ8,
    الأساس: معرف_سجل_فعلي,
    الإزاحة: غير_موقع,
    القيمة: غير_موقع,
    الحجم: غير_موقع,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.بعض(الأساس), اختيار.لا_شيء(), اختيار.لا_شيء()) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختيار.بعض(س) -> { العمل := س; };
    طابق ألحق_نقل_فوري_بتات_إكس(البايتات, العمل, القيمة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع أساس_العنوان: اختيار معرف_سجل_فعلي = اختيار.بعض(الأساس);
    دع فهرس_العنوان: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
    دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: أساس_العنوان,
        الفهرس: فهرس_العنوان,
        المقياس: 1,
        الإزاحة: الإزاحة_الموقعة
    };
    أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, العمل, &العنوان, الحجم);
}

عرف ألحق_تخصيص_صندوق_إكس(
    البايتات: &متغير متجه غ8,
    الوجهة: معرف_سجل_فعلي,
    الحجم: غير_موقع,
    المحاذاة: غير_موقع,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    بداية_الدالة: غير_موقع,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    طابق خطة_تخصيص_ذاكرة_للهدف(الهدف) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_ذاكرة_غير_متاح()); }
    | اختيار.بعض(الخطة) -> {
        طابق الخطة مع
        | خطة_تخصيص_ذاكرة_هدف.نداء_رمزي(نداء_التخصيص) -> {
            دع حجم_فعلي: متغير غير_موقع = الحجم;
            لو (حجم_فعلي == 0) { حجم_فعلي := 1; };

            دع سجل_الحجم: متغير معرف_سجل_فعلي = { القيمة: 0 };
            طابق حل_سجل_معامل_صحيح_إكس(الهدف, 0) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختيار.بعض(س) -> { سجل_الحجم := س; };

            دع فئة_الناتج: فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
            دع دور_الناتج: دور_سجل_واجهة = دور_سجل_واجهة.ناتج();
            دع حفظ_الناتج: حفظ_سجل_واجهة = حفظ_سجل_واجهة.متطاير_عبر_النداء();
            دع مرجع_الناتج: مرجع_سجل_واجهة = {
                الفئة: فئة_الناتج,
                الفهرس: 0,
                الدور: دور_الناتج,
                الحفظ: حفظ_الناتج
            };
            دع سجل_الناتج: متغير معرف_سجل_فعلي = { القيمة: 0 };
            طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_الناتج) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختيار.بعض(س) -> { سجل_الناتج := س; };

            طابق ألحق_نقل_فوري_بتات_إكس(البايتات, سجل_الحجم, حجم_فعلي) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

            دع إطار_حالي: إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الإطار;
            دع تعديل_المكدس: متغير غير_موقع = 0;
            طابق تعديل_مكدس_نداء_لحجم_إطار_للهدف(الهدف, إطار_حالي.الحجم_بايت) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختيار.بعض(القيمة) -> { تعديل_المكدس := القيمة; };
            ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, صواب, بداية_الدالة, فك_المكدس);

            ألحق_بايت_إكس(البايتات, 0xE8);
            دع موضع_الإزاحة: غير_موقع = الطول(*البايتات) مثل غير_موقع;
            ألحق_غ32_إكس(البايتات, 0);

            دع الخدمة: خدمة_تشغيل_هدف = انسخ_خدمة_تشغيل_هدف(نداء_التخصيص.الخدمة);
            دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.خدمة_تشغيل(الخدمة);
            دع الإضافة: عدد = -4;
            دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
                نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
            دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
                إزاحة_بايت: موضع_الإزاحة,
                النوع: نوع_الإزاحة,
                الرمز: الرمز,
                الإضافة: الإضافة
            };
            ألحق_نداء_إكس_للمشفّر(النداءات, الإزاحة);


            ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, خطأ, بداية_الدالة, فك_المكدس);
            ألحق_اختبار_سجل_إكس(البايتات, سجل_الناتج);
            // JNZ +2 skips UD2; allocator returns zero only on exhaustion/overflow.
            ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 5);
            أرجع ألحق_نقل_سجل_إكس(البايتات, الوجهة, سجل_الناتج);
        };
    };
}

عرف ألحق_ثابت_نص_إكس(
    البايتات: &متغير متجه غ8,
    الثابت: &ثابت_نص_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    بداية_الدالة: غير_موقع,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    دع ث: ثابت_نص_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *الثابت;
    دع الموضع: متغير موضع_محلي_إكس_ستة_وثمانون_أربعة_وستون;
    طابق ابحث_موضع_محلي_إكس(الإطار, ث.الهوية) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.موضع_محلي_مفقود(ث.الهوية)
        );
    }
    | اختيار.بعض(م) -> { الموضع := م; };

    دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختيار.لا_شيء(), اختيار.لا_شيء(), اختيار.لا_شيء()) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()
        );
    }
    | اختيار.بعض(س) -> { العمل := س; };

    دع الطول_الدلالي: غير_موقع = الطول(ث.البايتات) مثل غير_موقع;
    دع حجم_الحجز: متغير غير_موقع = الطول_الدلالي;
    لو (حجم_الحجز == 0) { حجم_الحجز := 1; };
    طابق ألحق_تخصيص_صندوق_إكس(البايتات, العمل, حجم_الحجز, 1, الهدف, الإطار, النداءات, بداية_الدالة, فك_المكدس) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

    دع ف: متغير غير_موقع = 0;
    بينما (ف < الطول_الدلالي) {
        طابق ألحق_تخزين_فوري_ذاكرة_إكس(
            البايتات, العمل, ف, ث.البايتات[ف] مثل غير_موقع, 1, الهدف
        ) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ف := ف + 1;
    }

    دع مؤشر_المكدس: معرف_سجل_فعلي = { القيمة: 4 };
    دع عنوان_البيانات: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
        عنوان_مكدس_إكس(الموضع.إزاحة_بايت + ث.إزاحة_البيانات);
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, العمل, &عنوان_البيانات, 8) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_فوري_ذاكرة_إكس(
        البايتات, مؤشر_المكدس,
        الموضع.إزاحة_بايت + ث.إزاحة_الطول,
        الطول_الدلالي, 8, الهدف
    ) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_فوري_ذاكرة_إكس(
        البايتات, مؤشر_المكدس,
        الموضع.إزاحة_بايت + ث.إزاحة_السعة,
        الطول_الدلالي, 8, الهدف
    ) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف حل_سجل_معامل_صحيح_إكس(الهدف: &واصف_هدف, الفهرس: غير_موقع): اختيار معرف_سجل_فعلي {
    دع الفئة: فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
    دع الدور: دور_سجل_واجهة = دور_سجل_واجهة.معامل();
    دع الحفظ: حفظ_سجل_واجهة = حفظ_سجل_واجهة.متطاير_عبر_النداء();
    دع المرجع: مرجع_سجل_واجهة = {
        الفئة: الفئة, الفهرس: الفهرس, الدور: الدور, الحفظ: الحفظ
    };
    أرجع حل_سجل_واجهة_فعلي_للهدف(الهدف, &المرجع);
}

عرف ألحق_إلحاق_متجه_إكس(
    البايتات: &متغير متجه غ8,
    الإلحاق: &إلحاق_متجه_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    بداية_الدالة: غير_موقع,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    دع م: إلحاق_متجه_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *الإلحاق;
    لو (!(م.حجم_الطول == 8 && م.حجم_السعة == 8)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(م.حجم_الطول)
        );
    };
    دع س0: معرف_سجل_فعلي; دع س1: معرف_سجل_فعلي; دع س2: معرف_سجل_فعلي;
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 0) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختيار.بعض(س) -> { س0 := س; };
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 1) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختيار.بعض(س) -> { س1 := س; };
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 2) مع | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختيار.بعض(س) -> { س2 := س; };

    // vector/element sources can arrive in ABI destinations or reserved spill-work registers.
    // Prepare the first two call arguments as one parallel move set so moving one source
    // never destroys the other before it has been captured.
    دع نقلات_الحجج: متغير متجه نقلة_سجل_نداء_إكس = [];
    دع نقلة_المتجه: نقلة_سجل_نداء_إكس = { المصدر: م.المتجه, الوجهة: س0 };
    دع نقلة_العنصر: نقلة_سجل_نداء_إكس = { المصدر: م.العنصر, الوجهة: س1 };
    ألحق(نقلات_الحجج, نقلة_المتجه);
    ألحق(نقلات_الحجج, نقلة_العنصر);
    دع سجل_عمل_النداء: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق سجل_عمل_نقل_نداء_للهدف(الهدف) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); }
    | اختيار.بعض(السجل) -> { سجل_عمل_النداء := السجل; };
    طابق ألحق_نقلات_نداء_إكس(البايتات, &نقلات_الحجج, سجل_عمل_النداء) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

    // Vector append is a composite of the target realloc service (see
    // runtime_primitive_query_context: إلحاق = تركيب_خدمات). It is expanded
    // here like the LLVM provider expansion; no retired runtime helper symbol
    // is referenced. s0 holds the vector address and s1 the element value (or
    // its address for aggregates). Every register used below is volatile across
    // the ABI call this instruction is allocated as.
    لو (م.حجم_العنصر > 2147483647 || م.عامل_النمو > 2147483647 || م.السعة_الدنيا > 2147483647) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(م.حجم_العنصر)
        );
    };
    دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 };
    دع سجل_ب: معرف_سجل_فعلي = { القيمة: 10 };
    // Three reserved stack slots: vector address, element, grown capacity.
    دع حجم_حجج_المكدس: غير_موقع = 32;
    دع الإطار_الحالي: إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الإطار;
    دع تعديل_المكدس: متغير غير_موقع = 0;
    طابق تعديل_مكدس_نداء_مع_حجج_للهدف(الهدف, الإطار_الحالي.الحجم_بايت, حجم_حجج_المكدس) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); }
    | اختيار.بعض(القيمة) -> { تعديل_المكدس := القيمة; };
    ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, صواب, بداية_الدالة, فك_المكدس);
    دع خانة_المتجه: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(0);
    دع خانة_العنصر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(8);
    دع خانة_السعة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(16);
    دع عنوان_الطول: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س0, م.إزاحة_الطول);
    دع عنوان_السعة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س0, م.إزاحة_السعة);
    دع عنوان_البيانات: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س0, م.إزاحة_البيانات);
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س0, &خانة_المتجه, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س1, &خانة_العنصر, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

    لو (م.حجم_العنصر > 0) {
        // len < capacity → store directly.
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_ب, &عنوان_السعة, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_مقارنة_بعرض_إكس(البايتات, ركس_أ, سجل_ب, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        // JB rel32 → store.
        ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x82);
        دع موضع_فرع_التخزين: غير_موقع = الطول(*البايتات) مثل غير_موقع;
        ألحق_غ32_إكس(البايتات, 0);

        // Grow: capacity = max(capacity * growth, minimum), trapping on overflow.
        دع عامل_النمو: متغير غير_موقع = م.عامل_النمو;
        لو (عامل_النمو < 2) { عامل_النمو := 2; };
        دع السعة_الدنيا: متغير غير_موقع = م.السعة_الدنيا;
        لو (السعة_الدنيا < 1) { السعة_الدنيا := 1; };
        ألحق_ضرب_فوري_إلحاق_إكس(البايتات, سجل_ب, عامل_النمو);
        طابق ألحق_نقل_فوري_بتات_إكس(البايتات, ركس_أ, السعة_الدنيا) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_مقارنة_بعرض_إكس(البايتات, سجل_ب, ركس_أ, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        // JAE rel8 over the minimum-capacity move.
        ألحق_بايت_إكس(البايتات, 0x73);
        دع موضع_فرع_الحد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
        ألحق_بايت_إكس(البايتات, 0);
        طابق ألحق_نقل_سجل_إكس(البايتات, سجل_ب, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        دع نهاية_الحد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
        (*البايتات)[موضع_فرع_الحد] := (نهاية_الحد - (موضع_فرع_الحد + 1)) مثل غ8;
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_ب, &خانة_السعة, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        // realloc(data, capacity * element_size)
        طابق ألحق_نقل_سجل_إكس(البايتات, س1, سجل_ب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_ضرب_فوري_إلحاق_إكس(البايتات, س1, م.حجم_العنصر);
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س0, &عنوان_البيانات, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, 0xE8);
        دع موضع_الإزاحة: غير_موقع = الطول(*البايتات) مثل غير_موقع;
        ألحق_غ32_إكس(البايتات, 0);
        دع خدمة_إعادة_التخصيص: خدمة_تشغيل_هدف = خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة();
        دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.خدمة_تشغيل(خدمة_إعادة_التخصيص);
        دع الإضافة: عدد = -4;
        دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
            نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
        دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: موضع_الإزاحة, النوع: نوع_الإزاحة, الرمز: الرمز, الإضافة: الإضافة
        };
        ألحق_نداء_إكس_للمشفّر(النداءات, الإزاحة);
        // A null result means allocation failure: trap, never continue.
        ألحق_اختبار_سجل_إكس(البايتات, ركس_أ);
        ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 5);
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س0, &خانة_المتجه, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_البيانات, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_ب, &خانة_السعة, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_ب, &عنوان_السعة, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

        // store: destination = data + len * element_size.
        دع موضع_التخزين: غير_موقع = الطول(*البايتات) مثل غير_موقع;
        اكتب_غ32_إكس(البايتات, موضع_فرع_التخزين, موضع_التخزين - (موضع_فرع_التخزين + 4));
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س0, &خانة_المتجه, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س1, &خانة_العنصر, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_سجل_إكس(البايتات, سجل_ب, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_ضرب_فوري_إلحاق_إكس(البايتات, سجل_ب, م.حجم_العنصر);
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س2, &عنوان_البيانات, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, سجل_ب, س2, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        // length + 1 is committed before the element copy, which may use a work register.
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, ركس_أ, ركس_أ));
        ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, 0xC0 + (ركس_أ.القيمة % 8)); ألحق_بايت_إكس(البايتات, 1);
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        لو (م.العنصر_تجميعي) {
            طابق ألحق_نسخ_ذاكرة_إكس(البايتات, سجل_ب, س1, م.حجم_العنصر, 0, 0, الهدف) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        } وإلا {
            دع عنوان_العنصر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(سجل_ب, 0);
            طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س1, &عنوان_العنصر, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        };
    } وإلا {
        // Zero-sized elements own no storage; only the length changes.
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, ركس_أ, ركس_أ));
        ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, 0xC0 + (ركس_أ.القيمة % 8)); ألحق_بايت_إكس(البايتات, 1);
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    };

    ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, خطأ, بداية_الدالة, فك_المكدس);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

// IMUL r64, r/m64, imm32 on one register, trapping on signed overflow.
عرف ألحق_ضرب_فوري_إلحاق_إكس(
    البايتات: &متغير متجه غ8,
    السجل: معرف_سجل_فعلي,
    القيمة: غير_موقع
): فراغ {
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, السجل, السجل));
    ألحق_بايت_إكس(البايتات, 0x69);
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(السجل, السجل));
    ألحق_غ32_إكس(البايتات, القيمة);
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1);
}

عرف شفّر_تعليمة_إكس(
    التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    البايتات: &متغير متجه غ8,
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    المرفقات: &متغير مرفقات_كائن_مشفرة,
    معرف_الدالة: معرف_دالة_منتقاة,
    بداية_الدالة: غير_موقع,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    دع وصف_الهدف: واصف_هدف = *الهدف;
    دع إطار: إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الإطار;
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.استلام_معامل(القيمة) -> {
        لو ((الطول(القيمة.المواضع) مثل غير_موقع) != 1) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
            );
        };
        دع موضع_الواجهة: موضع_جزء_واجهة = القيمة.المواضع[0];
        طابق موضع_الواجهة مع
        | موضع_جزء_واجهة.سجل(مرجع_الواجهة) -> {
            لو (مرجع_الواجهة.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                أرجع ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(
                    البايتات, القيمة.السجل, مرجع_الواجهة.الفهرس, القيمة.الحجم * 8
                );
            };
            طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_الواجهة) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختيار.بعض(المصدر) -> {
                طابق ألحق_نقل_سجل_إكس(البايتات, القيمة.السجل, المصدر) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            };
        }
        | موضع_جزء_واجهة.مكدس(موضع_المعامل) -> {
            دع الإزاحة: متغير غير_موقع = 0;
            طابق إزاحة_معامل_مكدس_بعد_إطار_للهدف(الهدف, إطار.الحجم_بايت, &موضع_المعامل) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختيار.بعض(القيمة_الإزاحة) -> { الإزاحة := القيمة_الإزاحة; };
            دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(الإزاحة);
            // استهلك عرض موضع ABI نفسه، لا عرض القيمة الدلالية. SysV يضع المعامل
            // الصحيح الممرر على المكدس في eightbyte slot، والمرسل يخزن القيمة
            // المقننة كاملة فيه؛ تحميل i8/i16/i32 فقط هنا كان يصفر البتات العليا
            // ويفسد القيم الموقعة السالبة بعد المعامل السادس.
            دع حجم_التحميل: غير_موقع = موضع_المعامل.الحجم;
            لو (!(حجم_التحميل == 1 || حجم_التحميل == 2 || حجم_التحميل == 4 || حجم_التحميل == 8)) {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(حجم_التحميل)
                );
            };
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, القيمة.السجل, &العنوان, حجم_التحميل, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نقل_سجل(الوجهة, المصدر) -> {
        طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, المصدر) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ);
        }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نقل_فوري(الوجهة, القيمة) -> {
        لو (!سجل_إكس_قابل_للترميز(الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
            );
        };
        ألحق_بايت_إكس(البايتات, ركس_إكس(اختيار.لا_شيء(), اختيار.بعض(الوجهة)));
        ألحق_بايت_إكس(البايتات, 0xB8 + (الوجهة.القيمة % 8));
        ألحق_غ64_إكس(البايتات, القيمة مثل غير_موقع);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نقل_فوري_بتات(الوجهة, القيمة) -> {
        أرجع ألحق_نقل_فوري_بتات_إكس(البايتات, الوجهة, القيمة);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.حساب_صحيح_كامل(العملية, الوجهة, أ, ب, البتات, بإشارة) -> {
        أرجع ألحق_حساب_صحيح_كامل_إكس(البايتات, العملية, الوجهة, أ, ب, البتات, بإشارة, الهدف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تحويل_صحيح_كامل(العملية, الوجهة, المصدر, من_بتات, إلى_بتات, بإشارة) -> {
        أرجع ألحق_تحويل_صحيح_إكس(البايتات, العملية, الوجهة, المصدر, من_بتات, إلى_بتات, بإشارة);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.حساب_عشري(العملية, الوجهة, أ, ب, البتات) -> {
        أرجع ألحق_حساب_عشري_إكس(البايتات, العملية, الوجهة, أ, ب, البتات);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.مقارنة_عشرية_إلى_منطق(العملية, الوجهة, أ, ب, البتات) -> {
        أرجع ألحق_مقارنة_عشرية_إلى_منطق_إكس(البايتات, العملية, الوجهة, أ, ب, البتات);
    }
