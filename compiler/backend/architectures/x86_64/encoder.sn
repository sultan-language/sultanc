        ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 5);
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س0, &خانة_المتجه, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_البيانات, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_ب, &خانة_السعة, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_ب, &عنوان_السعة, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

        // store: destination = data + len * element_size.
        دع موضع_التخزين: طبيعي = الطول(*البايتات) مثل طبيعي;
        اكتب_ط32_إكس(البايتات, موضع_فرع_التخزين, موضع_التخزين - (موضع_فرع_التخزين + 4));
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س0, &خانة_المتجه, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س1, &خانة_العنصر, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_سجل_إكس(البايتات, سجل_ب, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_ضرب_فوري_إلحاق_إكس(البايتات, سجل_ب, م.حجم_العنصر);
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س2, &عنوان_البيانات, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, سجل_ب, س2, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        // length + 1 is committed before the element copy, which may use a work register.
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, ركس_أ, ركس_أ));
        ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, 0xC0 + (ركس_أ.القيمة % 8)); ألحق_بايت_إكس(البايتات, 1);
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        لو (م.العنصر_تجميعي) {
            طابق ألحق_نسخ_ذاكرة_إكس(البايتات, سجل_ب, س1, م.حجم_العنصر, 0, 0, الهدف) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        } وإلا {
            دع عنوان_العنصر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(سجل_ب, 0);
            طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س1, &عنوان_العنصر, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        };
    } وإلا {
        // Zero-sized elements own no storage; only the length changes.
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, ركس_أ, ركس_أ));
        ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, 0xC0 + (ركس_أ.القيمة % 8)); ألحق_بايت_إكس(البايتات, 1);
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    };

    ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, خطأ, بداية_الدالة, فك_المكدس);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

// IMUL r64, r/m64, imm32 on one register, trapping on signed overflow.
عرف ألحق_ضرب_فوري_إلحاق_إكس(
    البايتات: &متغير متجه ط8,
    السجل: معرف_سجل_فعلي,
    القيمة: طبيعي
): فراغ {
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, السجل, السجل));
    ألحق_بايت_إكس(البايتات, 0x69);
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(السجل, السجل));
    ألحق_ط32_إكس(البايتات, القيمة);
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1);
}

// ---- Atomics (thread support, docs/CONCURRENCY.md) ----
// The operands may sit in any allocatable or spill-work register (a spilled
// operand is reloaded into RAX, RCX, RDX or R10), never in R11, which these
// sequences use as their own scratch. LOCK CMPXCHG needs RAX for the expected
// value, so an operand found in RAX is first moved to another work register.

عرف عنوان_أساس_ذري_إكس(الأساس: معرف_سجل_فعلي): عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: اختياري.موجود(الأساس), الفهرس: اختياري.لا_شيء(), المقياس: 1, الإزاحة: 0
    };
    أرجع العنوان;
}

// [prefix] REX op1 [op2] ModRM/SIB for a register and a [base] memory operand.
عرف ألحق_عملية_ذاكرة_ذرية_إكس(
    البايتات: &متغير متجه ط8,
    قفل: منطقي,
    البتات: طبيعي,
    رمز_مزدوج: منطقي,
    الرمز: طبيعي,
    السجل: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    لو (!(البتات == 32 || البتات == 64)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8)); };
    لو (قفل) { ألحق_بايت_إكس(البايتات, 0xF0); };
    ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(البتات == 64, السجل, اختياري.لا_شيء(), الأساس));
    لو (رمز_مزدوج) { ألحق_بايت_إكس(البايتات, 0x0F); };
    ألحق_بايت_إكس(البايتات, الرمز);
    دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_ذري_إكس(الأساس);
    أرجع ألحق_معامل_ذاكرة_إكس(البايتات, السجل, &العنوان);
}

عرف ألحق_ذري_إكس(
    البايتات: &متغير متجه ط8,
    العملية: عملية_ذرية_إكس,
    الوجهة: معرف_سجل_فعلي,
    العنوان: معرف_سجل_فعلي,
    القيمة: معرف_سجل_فعلي,
    البتات: طبيعي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع رقم_الخدش: معرف_سجل_فعلي = { القيمة: 11 };
    دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 };
    دع بسيطة: متغير منطقي = خطأ;
    دع رمز_بسيط: متغير طبيعي = 0x87;
    دع قفل_بسيط: متغير منطقي = خطأ;
    دع مزدوج_بسيط: متغير منطقي = خطأ;
    دع رمز_الحساب: متغير طبيعي = 0x21;
    طابق العملية مع
    | عملية_ذرية_إكس.تبديل -> { بسيطة := صواب; }
    | عملية_ذرية_إكس.جلب_جمع -> { بسيطة := صواب; رمز_بسيط := 0xC1; قفل_بسيط := صواب; مزدوج_بسيط := صواب; }
    | عملية_ذرية_إكس.جلب_و -> { رمز_الحساب := 0x21; }
    | عملية_ذرية_إكس.جلب_أو -> { رمز_الحساب := 0x09; }
    | عملية_ذرية_إكس.جلب_أو_حصري -> { رمز_الحساب := 0x31; };
    لو (بسيطة) {
        // mov r11, value; [lock] xchg/xadd [address], r11; mov destination, r11
        طابق ألحق_نقل_سجل_إكس(البايتات, رقم_الخدش, القيمة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_عملية_ذاكرة_ذرية_إكس(البايتات, قفل_بسيط, البتات, مزدوج_بسيط, رمز_بسيط, رقم_الخدش, العنوان) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, رقم_الخدش) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
    };
    // AND/OR/XOR: mov rax, [a]; L: mov r11, rax; op r11, v; lock cmpxchg [a], r11; jne L
    دع العنوان_الفعلي: متغير معرف_سجل_فعلي = العنوان;
    دع القيمة_الفعلية: متغير معرف_سجل_فعلي = القيمة;
    لو (سجلان_فعليان_متساويان_إكس(العنوان, ركس_أ) || سجلان_فعليان_متساويان_إكس(القيمة, ركس_أ)) {
        طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(ركس_أ), اختياري.موجود(العنوان), اختياري.موجود(القيمة)) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); }
        | اختياري.موجود(البديل) -> {
            طابق ألحق_نقل_سجل_إكس(البايتات, البديل, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            لو (سجلان_فعليان_متساويان_إكس(العنوان, ركس_أ)) { العنوان_الفعلي := البديل; } وإلا { القيمة_الفعلية := البديل; };
        };
    };
    دع عنوان_الحمل: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_ذري_إكس(العنوان_الفعلي);
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الحمل, البتات / 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع بداية_الحلقة: طبيعي = الطول(*البايتات) مثل طبيعي;
    طابق ألحق_نقل_سجل_إكس(البايتات, رقم_الخدش, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, رقم_الخدش, القيمة_الفعلية, رمز_الحساب - 1, رمز_الحساب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_عملية_ذاكرة_ذرية_إكس(البايتات, صواب, البتات, صواب, 0xB1, رقم_الخدش, العنوان_الفعلي) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع بعد_القفز: طبيعي = (الطول(*البايتات) مثل طبيعي) + 2;
    دع المسافة: طبيعي = بعد_القفز - بداية_الحلقة;
    لو (المسافة > 128) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); };
    ألحق_بايت_إكس(البايتات, 0x75);
    ألحق_بايت_إكس(البايتات, 256 - المسافة);
    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

// mov rax, expected; mov r11, new; lock cmpxchg [address], r11; mov destination, rax
عرف ألحق_ذري_قارن_وبدل_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    العنوان: معرف_سجل_فعلي,
    المتوقع: معرف_سجل_فعلي,
    الجديد: معرف_سجل_فعلي,
    البتات: طبيعي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع رقم_الخدش: معرف_سجل_فعلي = { القيمة: 11 };
    دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 };
    دع العنوان_الفعلي: متغير معرف_سجل_فعلي = العنوان;
    لو (سجلان_فعليان_متساويان_إكس(العنوان, ركس_أ)) {
        طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(ركس_أ), اختياري.موجود(المتوقع), اختياري.موجود(الجديد)) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); }
        | اختياري.موجود(البديل) -> {
            طابق ألحق_نقل_سجل_إكس(البايتات, البديل, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            العنوان_الفعلي := البديل;
        };
    };
    // r11 takes the new value before RAX is overwritten (the new value may be in RAX).
    طابق ألحق_نقل_سجل_إكس(البايتات, رقم_الخدش, الجديد) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    لو (!سجلان_فعليان_متساويان_إكس(المتوقع, ركس_أ)) {
        طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, المتوقع) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    };
    طابق ألحق_عملية_ذاكرة_ذرية_إكس(البايتات, صواب, البتات, صواب, 0xB1, رقم_الخدش, العنوان_الفعلي) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

// The Linux thread clone after the kernel registers are loaded (rax=number,
// rdi=flags, rsi=stack, rdx=parent tid, r10=child tid, r8=tls, r9=closure):
// the closure is pushed on the child's stack, and the child pops it into
// the closure-environment register (R15), calls it, and exits the thread
// (musl src/thread/x86_64/clone.s; Go runtime·clone).
عرف ألحق_ذيل_استنساخ_خيط_إكس(البايتات: &متغير متجه ط8): فراغ {
    // and rsi,-16; sub rsi,8; mov [rsi],r9
    ألحق_بايت_إكس(البايتات, 0x48); ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, 0xE6); ألحق_بايت_إكس(البايتات, 0xF0);
    ألحق_بايت_إكس(البايتات, 0x48); ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, 0xEE); ألحق_بايت_إكس(البايتات, 0x08);
    ألحق_بايت_إكس(البايتات, 0x4C); ألحق_بايت_إكس(البايتات, 0x89); ألحق_بايت_إكس(البايتات, 0x0E);
    // syscall; test rax,rax; jnz parent
    ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x05);
    ألحق_بايت_إكس(البايتات, 0x48); ألحق_بايت_إكس(البايتات, 0x85); ألحق_بايت_إكس(البايتات, 0xC0);
    ألحق_بايت_إكس(البايتات, 0x75); ألحق_بايت_إكس(البايتات, 18);
    // child: xor ebp,ebp; pop r15; call [r15]; xor edi,edi; mov eax,60; syscall; ud2
    ألحق_بايت_إكس(البايتات, 0x31); ألحق_بايت_إكس(البايتات, 0xED);
    ألحق_بايت_إكس(البايتات, 0x41); ألحق_بايت_إكس(البايتات, 0x5F);
    ألحق_بايت_إكس(البايتات, 0x41); ألحق_بايت_إكس(البايتات, 0xFF); ألحق_بايت_إكس(البايتات, 0x17);
    ألحق_بايت_إكس(البايتات, 0x31); ألحق_بايت_إكس(البايتات, 0xFF);
    ألحق_بايت_إكس(البايتات, 0xB8); ألحق_ط32_إكس(البايتات, 60);
    ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x05);
    ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x0B);
}

عرف شفّر_تعليمة_إكس(
    التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    البايتات: &متغير متجه ط8,
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    المرفقات: &متغير مرفقات_كائن_مشفرة,
    معرف_الدالة: معرف_دالة_منتقاة,
    بداية_الدالة: طبيعي,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    دع وصف_الهدف: واصف_هدف = *الهدف;
    دع إطار: إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الإطار;
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.استلام_معامل(القيمة) -> {
        لو ((الطول(القيمة.المواضع) مثل طبيعي) != 1) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
            );
        };
        دع موضع_الواجهة: موضع_جزء_واجهة = القيمة.المواضع[0];
        طابق موضع_الواجهة مع
        | موضع_جزء_واجهة.سجل(مرجع_الواجهة) -> {
            لو (مرجع_الواجهة.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
                أرجع ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(
                    البايتات, القيمة.السجل, مرجع_الواجهة.الفهرس, القيمة.الحجم * 8
                );
            };
            طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_الواجهة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختياري.موجود(المصدر) -> {
                طابق ألحق_نقل_سجل_إكس(البايتات, القيمة.السجل, المصدر) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            };
        }
        | موضع_جزء_واجهة.مكدس(موضع_المعامل) -> {
            دع الإزاحة: متغير طبيعي = 0;
            طابق إزاحة_معامل_مكدس_بعد_إطار_للهدف(الهدف, إطار.الحجم_بايت, &موضع_المعامل) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختياري.موجود(القيمة_الإزاحة) -> { الإزاحة := القيمة_الإزاحة; };
            دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(الإزاحة);
            // استهلك عرض موضع ABI نفسه، لا عرض القيمة الدلالية. SysV يضع المعامل
            // الصحيح الممرر على المكدس في eightbyte slot، والمرسل يخزن القيمة
            // المقننة كاملة فيه؛ تحميل i8/i16/i32 فقط هنا كان يصفر البتات العليا
            // ويفسد القيم الموقعة السالبة بعد المعامل السادس.
            دع حجم_التحميل: طبيعي = موضع_المعامل.الحجم;
            لو (!(حجم_التحميل == 1 || حجم_التحميل == 2 || حجم_التحميل == 4 || حجم_التحميل == 8)) {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(حجم_التحميل)
                );
            };
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, القيمة.السجل, &العنوان, حجم_التحميل, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نقل_سجل(الوجهة, المصدر) -> {
        طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, المصدر) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ);
        }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نقل_فوري(الوجهة, القيمة) -> {
        لو (!سجل_إكس_قابل_للترميز(الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
            );
        };
        ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.لا_شيء(), اختياري.موجود(الوجهة)));
        ألحق_بايت_إكس(البايتات, 0xB8 + (الوجهة.القيمة % 8));
        ألحق_ط64_إكس(البايتات, القيمة مثل طبيعي);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.نقل_فوري_بتات(الوجهة, القيمة) -> {
        أرجع ألحق_نقل_فوري_بتات_إكس(البايتات, الوجهة, القيمة);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.حساب_صحيح_كامل(العملية, الوجهة, أ, ب, البتات, بإشارة) -> {
        أرجع ألحق_حساب_صحيح_كامل_إكس(البايتات, العملية, الوجهة, أ, ب, البتات, بإشارة, الهدف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تحويل_صحيح_كامل(العملية, الوجهة, المصدر, من_بتات, إلى_بتات, بإشارة) -> {
        أرجع ألحق_تحويل_صحيح_إكس(البايتات, العملية, الوجهة, المصدر, من_بتات, إلى_بتات, بإشارة);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.قسمة_على_ثابت(الوجهة, المصدر, القاسم, البتات, موقع, باقي) -> {
        أرجع ألحق_قسمة_على_ثابت_إكس(البايتات, الوجهة, المصدر, القاسم, البتات, موقع, باقي, الهدف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.حساب_عشري(العملية, الوجهة, أ, ب, البتات) -> {
        أرجع ألحق_حساب_عشري_إكس(البايتات, العملية, الوجهة, أ, ب, البتات);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تحويل_عائم(العملية, الوجهة, المصدر, من_بتات, إلى_بتات) -> {
        أرجع ألحق_تحويل_عائم_إكس(البايتات, العملية, الوجهة, المصدر, من_بتات, إلى_بتات);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.مقارنة_عشرية_إلى_منطق(العملية, الوجهة, أ, ب, البتات) -> {
        أرجع ألحق_مقارنة_عشرية_إلى_منطق_إكس(البايتات, العملية, الوجهة, أ, ب, البتات);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.مقارنة_إلى_منطق(الوجهة, أ, ب, الشرط, البتات) -> {
        أرجع ألحق_مقارنة_إلى_منطق_إكس(البايتات, الوجهة, أ, ب, الشرط, البتات);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.جمع_ثنائي_العنوان(الوجهة, المصدر) -> {
        لو (!سجل_إكس_قابل_للترميز(الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
            );
        };
        لو (!سجل_إكس_قابل_للترميز(المصدر)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر)
            );
        };
        ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.موجود(المصدر), اختياري.موجود(الوجهة)));
        ألحق_بايت_إكس(البايتات, 0x01);
        ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.جمع_ثنائي_العنوان_مع_فخ_تجاوز(الوجهة, المصدر, الصنف) -> {
        لو (!سجل_إكس_قابل_للترميز(الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
            );
        };
        لو (!سجل_إكس_قابل_للترميز(المصدر)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر)
            );
        };
        ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.موجود(المصدر), اختياري.موجود(الوجهة)));
        ألحق_بايت_إكس(البايتات, 0x01);
        ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
        ألحق_حارس_فخ_تجاوز_إكس(البايتات, الصنف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.طرح_ثنائي_العنوان(الوجهة, المصدر) -> {
        لو (!سجل_إكس_قابل_للترميز(الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
            );
        };
        لو (!سجل_إكس_قابل_للترميز(المصدر)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر)
            );
        };
        ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.موجود(المصدر), اختياري.موجود(الوجهة)));
        ألحق_بايت_إكس(البايتات, 0x29);
        ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.طرح_ثنائي_العنوان_مع_فخ_تجاوز(الوجهة, المصدر, الصنف) -> {
        لو (!سجل_إكس_قابل_للترميز(الوجهة)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
            );
        };
        لو (!سجل_إكس_قابل_للترميز(المصدر)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر)
            );
        };
        ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.موجود(المصدر), اختياري.موجود(الوجهة)));
        ألحق_بايت_إكس(البايتات, 0x29);
        ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
        ألحق_حارس_فخ_تجاوز_إكس(البايتات, الصنف);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تكوين_عنوان(الوجهة, العنوان) -> {
        طابق ألحق_تكوين_عنوان_إكس(البايتات, الوجهة, &العنوان) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
