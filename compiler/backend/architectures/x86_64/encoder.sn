    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة.تحميل(الوجهة, العنوان, الحجم, بإشارة) -> {
        لو (!بإشارة && الحجم > 0 && الحجم <= 8) {
            أرجع ألحق_تحميل_جزء_تجميع_إكس(البايتات, الوجهة, &العنوان, الحجم, الهدف);
        };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, &العنوان, الحجم, بإشارة) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
