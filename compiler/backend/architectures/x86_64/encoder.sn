عرف ألحق_نقل_فوري_بتات_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    القيمة: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    إذا (!سجل_إكس_قابل_للترميز(الوجهة)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)); };
    // The shortest form, none of which touches the flags: MOV r32, imm32
    // zero-extends into the whole register; MOV r/m64, imm32 sign-extends;
    // only other values take MOVABS r64, imm64.
    إذا (القيمة <= 0xFFFFFFFF) {
        إذا (الوجهة.القيمة >= 8) { ألحق_بايت_إكس(البايتات, 0x41); };
        ألحق_بايت_إكس(البايتات, 0xB8 + (الوجهة.القيمة % 8));
        ألحق_ط32_إكس(البايتات, القيمة);
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
    إذا (القيمة >= 0xFFFFFFFF80000000) {
        ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.لا_شيء(), اختياري.موجود(الوجهة)));
        ألحق_بايت_إكس(البايتات, 0xC7);
        ألحق_بايت_إكس(البايتات, 0xC0 + (الوجهة.القيمة % 8));
        ألحق_ط32_إكس(البايتات, القيمة & 0xFFFFFFFF);
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
    ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.لا_شيء(), اختياري.موجود(الوجهة)));
    ألحق_بايت_إكس(البايتات, 0xB8 + (الوجهة.القيمة % 8));
    ألحق_ط64_إكس(البايتات, القيمة);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ركس_عرض_سجلين_إكس(
    البتات: طبيعي,
    حقل: معرف_سجل_فعلي,
    قاعدة: معرف_سجل_فعلي
): طبيعي {
    دع القيمة: متغير طبيعي = 0x40;
    إذا (البتات == 64) { القيمة := القيمة + 8; };
    إذا (حقل.القيمة >= 8) { القيمة := القيمة + 4; };
    إذا (قاعدة.القيمة >= 8) { القيمة := القيمة + 1; };
    أرجع القيمة;
}

عرف ألحق_عملية_سجلين_بعرض_إكس(
    البايتات: &متغير متجه ط8,
    البتات: طبيعي,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    رمز8: طبيعي,
    رمز_أوسع: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    إذا (!(البتات == 8 || البتات == 16 || البتات == 32 || البتات == 64)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8)); };
    إذا (!سجل_إكس_قابل_للترميز(الوجهة) || !سجل_إكس_قابل_للترميز(المصدر)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)); };
    إذا (البتات == 16) { ألحق_بايت_إكس(البايتات, 0x66); };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, المصدر, الوجهة));
    إذا (البتات == 8) { ألحق_بايت_إكس(البايتات, رمز8); } وإلا { ألحق_بايت_إكس(البايتات, رمز_أوسع); };
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_مقارنة_بعرض_إكس(
    البايتات: &متغير متجه ط8,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    أرجع ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, أ, ب, 0x38, 0x39);
}

عرف ألحق_توسيع_خام_إلى64_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    البتات: طبيعي,
    بإشارة: منطقي
): نتيجة_دفعة_ترميز_إكس {
    إذا (البتات == 64) { أرجع ألحق_نقل_سجل_إكس(البايتات, الوجهة, المصدر); };
    إذا (!(البتات == 8 || البتات == 16 || البتات == 32)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8)); };
    إذا (بإشارة) {
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, الوجهة, المصدر));
        إذا (البتات == 32) { ألحق_بايت_إكس(البايتات, 0x63); }
        وإلا { ألحق_بايت_إكس(البايتات, 0x0F); إذا (البتات == 8) { ألحق_بايت_إكس(البايتات, 0xBE); } وإلا { ألحق_بايت_إكس(البايتات, 0xBF); }; };
        ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(الوجهة, المصدر));
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
    إذا (البتات == 32) {
        // MOV r32,r32 zero-extends into the full physical register.
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(32, المصدر, الوجهة)); ألحق_بايت_إكس(البايتات, 0x89); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
    } وإلا {
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, الوجهة, المصدر)); ألحق_بايت_إكس(البايتات, 0x0F); إذا (البتات == 8) { ألحق_بايت_إكس(البايتات, 0xB6); } وإلا { ألحق_بايت_إكس(البايتات, 0xB7); }; ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(الوجهة, المصدر));
    };
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تقنين_عرض_إكس(
    البايتات: &متغير متجه ط8,
    السجل: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    إذا (البتات == 64) { أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); };
    أرجع ألحق_توسيع_خام_إلى64_إكس(البايتات, السجل, السجل, البتات, خطأ);
}

عرف ألحق_فخ_إكس(البايتات: &متغير متجه ط8): فراغ { ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x0B); }

عرف ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات: &متغير متجه ط8, رمز_الشرط: طبيعي): فراغ {
    ألحق_بايت_إكس(البايتات, 0x70 + رمز_الشرط); ألحق_بايت_إكس(البايتات, 2); ألحق_فخ_إكس(البايتات);
}

عرف ألحق_مقارنة_فوري8_إكس(البايتات: &متغير متجه ط8, السجل: معرف_سجل_فعلي, القيمة: طبيعي): فراغ {
    دع حقل_مقارنة: معرف_سجل_فعلي = { القيمة: 7 }; ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, حقل_مقارنة, السجل));
    ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, 0xF8 + (السجل.القيمة % 8)); ألحق_بايت_إكس(البايتات, القيمة);
}

عرف ألحق_اختبار_سجل_إكس(البايتات: &متغير متجه ط8, السجل: معرف_سجل_فعلي): فراغ {
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, السجل, السجل)); ألحق_بايت_إكس(البايتات, 0x85); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(السجل, السجل));
}

عرف ألحق_مقارنة_إلى_منطق_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    طابق ألحق_مقارنة_بعرض_إكس(البايتات, أ, ب, البتات) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع ركس: متغير طبيعي = 0x40; إذا (الوجهة.القيمة >= 8) { ركس := ركس + 1; }; ألحق_بايت_إكس(البايتات, ركس);
    ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x90 + رمز_شرط_إكس(الشرط)); ألحق_بايت_إكس(البايتات, 0xC0 + (الوجهة.القيمة % 8));
    أرجع ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, الوجهة, 8, خطأ);
}

// CMP r/m, imm at a width: the 8-bit sign-extended form when the pattern
// allows it, else imm8/imm16/imm32 (a 64-bit compare's pattern must be a
// sign-extended 32-bit one; the simplification only makes those).
عرف ألحق_مقارنة_فورية_بعرض_إكس(
    البايتات: &متغير متجه ط8,
    أ: معرف_سجل_فعلي,
    الفوري: طبيعي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    إذا (!(البتات == 8 || البتات == 16 || البتات == 32 || البتات == 64)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8)); };
    إذا (!سجل_إكس_قابل_للترميز(أ)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(أ)); };
    دع حقل_مقارنة: معرف_سجل_فعلي = { القيمة: 7 };
    إذا (البتات == 16) { ألحق_بايت_إكس(البايتات, 0x66); };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, حقل_مقارنة, أ));
    دع مود: طبيعي = مود_آر_إم_سجلين(حقل_مقارنة, أ);
    إذا (البتات == 8) {
        ألحق_بايت_إكس(البايتات, 0x80); ألحق_بايت_إكس(البايتات, مود); ألحق_بايت_إكس(البايتات, الفوري & 0xFF);
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
    // The pattern sign-extended from its width, then whether imm8 holds it.
    دع النصف: طبيعي = 1 << (البتات - 1);
    دع صغير: متغير منطقي = خطأ;
    إذا (البتات == 64) {
        صغير := الفوري < 0x80 || الفوري >= 0xFFFFFFFFFFFFFF80;
    } وإلا {
        دع الحد: طبيعي = (النصف << 1) - 0x80;
        صغير := الفوري < 0x80 || (الفوري >= الحد && الفوري < (النصف << 1));
    };
    إذا (صغير) {
        ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, مود); ألحق_بايت_إكس(البايتات, الفوري & 0xFF);
    } وإلا {
        ألحق_بايت_إكس(البايتات, 0x81); ألحق_بايت_إكس(البايتات, مود);
        إذا (البتات == 16) {
            ألحق_بايت_إكس(البايتات, الفوري & 0xFF); ألحق_بايت_إكس(البايتات, (الفوري >> 8) & 0xFF);
        } وإلا {
            ألحق_ط32_إكس(البايتات, الفوري & 0xFFFFFFFF);
        };
    };
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

// The ModRM reg field of OP r/m, imm (group 1), or none for an operation
// without an immediate form here.
عرف حقل_عملية_فورية_إكس(العملية: حساب_صحيح_إكس_كامل): اختياري طبيعي {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { أرجع اختياري.موجود(0); }
    | حساب_صحيح_إكس_كامل.جمع_ملتف -> { أرجع اختياري.موجود(0); }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { أرجع اختياري.موجود(1); }
    | حساب_صحيح_إكس_كامل.و_بتي -> { أرجع اختياري.موجود(4); }
    | حساب_صحيح_إكس_كامل.طرح -> { أرجع اختياري.موجود(5); }
    | حساب_صحيح_إكس_كامل.طرح_ملتف -> { أرجع اختياري.موجود(5); }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { أرجع اختياري.موجود(6); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Group-1 OP r/m, imm at a width (CMP is field 7): the sign-extended imm8
// form when the pattern allows it, else imm8/imm16/imm32.
عرف ألحق_عملية_فورية_بعرض_إكس(
    البايتات: &متغير متجه ط8,
    الحقل: طبيعي,
    أ: معرف_سجل_فعلي,
    الفوري: طبيعي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    إذا (!(البتات == 8 || البتات == 16 || البتات == 32 || البتات == 64)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8)); };
    إذا (!سجل_إكس_قابل_للترميز(أ)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(أ)); };
    دع حقل_العملية: معرف_سجل_فعلي = { القيمة: الحقل };
    إذا (البتات == 16) { ألحق_بايت_إكس(البايتات, 0x66); };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, حقل_العملية, أ));
    دع مود: طبيعي = مود_آر_إم_سجلين(حقل_العملية, أ);
    إذا (البتات == 8) {
        ألحق_بايت_إكس(البايتات, 0x80); ألحق_بايت_إكس(البايتات, مود); ألحق_بايت_إكس(البايتات, الفوري & 0xFF);
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
    // The pattern sign-extended from its width, then whether imm8 holds it.
    دع النصف: طبيعي = 1 << (البتات - 1);
    دع صغير: متغير منطقي = خطأ;
    إذا (البتات == 64) {
        صغير := الفوري < 0x80 || الفوري >= 0xFFFFFFFFFFFFFF80;
    } وإلا {
        دع الحد: طبيعي = (النصف << 1) - 0x80;
        صغير := الفوري < 0x80 || (الفوري >= الحد && الفوري < (النصف << 1));
    };
    إذا (صغير) {
        ألحق_بايت_إكس(البايتات, 0x83); ألحق_بايت_إكس(البايتات, مود); ألحق_بايت_إكس(البايتات, الفوري & 0xFF);
    } وإلا {
        ألحق_بايت_إكس(البايتات, 0x81); ألحق_بايت_إكس(البايتات, مود);
        إذا (البتات == 16) {
            ألحق_بايت_إكس(البايتات, الفوري & 0xFF); ألحق_بايت_إكس(البايتات, (الفوري >> 8) & 0xFF);
        } وإلا {
            ألحق_ط32_إكس(البايتات, الفوري & 0xFFFFFFFF);
        };
    };
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

// ألحق_حساب_صحيح_كامل_إكس with an immediate right operand: MOV, OP imm,
// the same overflow guard, then the width's canonical form.
عرف ألحق_حساب_صحيح_فوري_إكس(
    البايتات: &متغير متجه ط8,
    العملية: حساب_صحيح_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    الفوري: طبيعي,
    البتات: طبيعي,
    بإشارة: منطقي
): نتيجة_دفعة_ترميز_إكس {
    دع الحقل: متغير طبيعي = 0;
    طابق حقل_عملية_فورية_إكس(العملية) مع
    | اختياري.موجود(ح) -> { الحقل := ح; }
    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)); };
    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_عملية_فورية_بعرض_إكس(البايتات, الحقل, الوجهة, الفوري, البتات) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { إذا (بإشارة) { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1); } وإلا { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 3); }; }
    | حساب_صحيح_إكس_كامل.طرح -> { إذا (بإشارة) { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1); } وإلا { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 3); }; }
    | _ -> { };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

// SETcc into the destination's low byte, zero-extended to the register.
عرف ألحق_ثبت_شرط_إلى_منطق_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون
): نتيجة_دفعة_ترميز_إكس {
    دع ركس: متغير طبيعي = 0x40; إذا (الوجهة.القيمة >= 8) { ركس := ركس + 1; }; ألحق_بايت_إكس(البايتات, ركس);
    ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x90 + رمز_شرط_إكس(الشرط)); ألحق_بايت_إكس(البايتات, 0xC0 + (الوجهة.القيمة % 8));
    أرجع ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, الوجهة, 8, خطأ);
}

عرف ألحق_تحويل_صحيح_إكس(
    البايتات: &متغير متجه ط8,
    العملية: تحويل_صحيح_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    من_بتات: طبيعي,
    إلى_بتات: طبيعي,
    المصدر_موقع: منطقي
): نتيجة_دفعة_ترميز_إكس {
    طابق العملية مع
    | تحويل_صحيح_إكس_كامل.توسيع_بإشارة -> {
        طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, المصدر, من_بتات, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, إلى_بتات);
    }
    | تحويل_صحيح_إكس_كامل.توسيع_صفري -> {
        طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, المصدر, من_بتات, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, إلى_بتات);
    }
    | تحويل_صحيح_إكس_كامل.اقتطاع -> {
        طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, المصدر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, إلى_بتات);
    }
    | تحويل_صحيح_إكس_كامل.إعادة_تفسير -> {
        طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, المصدر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, إلى_بتات);
    };
}

عرف ألحق_ضرب_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: طبيعي,
    بإشارة: منطقي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    إذا (البتات == 64) {
        دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 };
        إذا (!بإشارة) {
            // MUL r/m64: RDX:RAX = RAX * r/m64, with OF (and CF) set when the
            // high half is not 0. The product commutes, so an operand already
            // in RAX stays there.
            دع المضروب: متغير معرف_سجل_فعلي = ب;
            إذا (سجلان_فعليان_متساويان_إكس(ب, ركس_أ)) {
                المضروب := أ;
            } وإلا {
                طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            };
            دع حقل_ضرب: معرف_سجل_فعلي = { القيمة: 4 };
            ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, حقل_ضرب, المضروب)); ألحق_بايت_إكس(البايتات, 0xF7); ألحق_بايت_إكس(البايتات, 0xE0 + (المضروب.القيمة % 8));
            ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1);
            أرجع ألحق_نقل_سجل_إكس(البايتات, الوجهة, ركس_أ);
        };
        // IMUL r64, r/m64 sets OF when the signed product does not fit.
        دع الآخر: متغير معرف_سجل_فعلي = ب;
        إذا (سجلان_فعليان_متساويان_إكس(الوجهة, ب) && !سجلان_فعليان_متساويان_إكس(الوجهة, أ)) {
            الآخر := أ;
        } وإلا {
            طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        };
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, الوجهة, الآخر)); ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0xAF); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(الوجهة, الآخر));
        ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1);
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
    دع م1: متغير معرف_سجل_فعلي = { القيمة: 0 }; دع م2: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(الوجهة), اختياري.موجود(أ), اختياري.موجود(ب)) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختياري.موجود(س) -> { م1 := س; };
    دع ركس_أ_ضرب: معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(الوجهة), اختياري.موجود(ركس_أ_ضرب), اختياري.موجود(م1)) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختياري.موجود(س) -> { م2 := س; };
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, م1, أ, البتات, بإشارة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, م2, ب, البتات, بإشارة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, م1) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    // IMUL r64,r/m64. For narrow widths the full product fits 64 bits and is range-checked below.
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, الوجهة, م2)); ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0xAF); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(الوجهة, م2));
    إذا (البتات == 64) {
        إذا (بإشارة) { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1); أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); };
        // unsigned 64-bit multiply needs the high half. Recompute with MUL using RAX/RDX and trap when RDX != 0.
        دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 }; دع ركس_د: معرف_سجل_فعلي = { القيمة: 2 };
        طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, م1) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        دع حقل_ضرب: معرف_سجل_فعلي = { القيمة: 4 }; ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, حقل_ضرب, م2)); ألحق_بايت_إكس(البايتات, 0xF7); ألحق_بايت_إكس(البايتات, 0xE0 + (م2.القيمة % 8));
        ألحق_اختبار_سجل_إكس(البايتات, ركس_د); ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 4);
        أرجع ألحق_نقل_سجل_إكس(البايتات, الوجهة, ركس_أ);
    };
    دع فحص: متغير معرف_سجل_فعلي = م1;
    طابق ألحق_نقل_سجل_إكس(البايتات, فحص, الوجهة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تقنين_عرض_إكس(البايتات, فحص, البتات) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    إذا (بإشارة) { طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, فحص, فحص, البتات, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; };
    طابق ألحق_مقارنة_بعرض_إكس(البايتات, فحص, الوجهة, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 4);
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

عرف ألحق_قسمة_أو_باقي_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: طبيعي,
    بإشارة: منطقي,
    باقي: منطقي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع يسار: متغير معرف_سجل_فعلي = { القيمة: 0 }; دع يمين: متغير معرف_سجل_فعلي = { القيمة: 0 };
    دع ركس_أ_محجوز: معرف_سجل_فعلي = { القيمة: 0 };
    دع ركس_د_محجوز: معرف_سجل_فعلي = { القيمة: 2 };
    // احفظ اليسار في سجل عمل لا يمكن أن يطغى على اليمين قبل نسخه.
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(ركس_أ_محجوز), اختياري.موجود(ركس_د_محجوز), اختياري.موجود(ب)) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختياري.موجود(س) -> { يسار := س; };
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(ركس_أ_محجوز), اختياري.موجود(ركس_د_محجوز), اختياري.موجود(يسار)) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختياري.موجود(س) -> { يمين := س; };
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, يسار, أ, البتات, بإشارة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, يمين, ب, البتات, بإشارة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_اختبار_سجل_إكس(البايتات, يمين); ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 5);
    // MIN / -1 traps as on ARM64 (ألحق_تحقق_قسمة_ذراع). Below 64 bits the
    // 64-bit IDIV would not fault and the result would leave the type; at
    // 64 bits IDIV itself would raise #DE (SIGFPE) instead of the trap.
    إذا (بإشارة) {
        دع حد: متغير معرف_سجل_فعلي = { القيمة: 0 };
        طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(يسار), اختياري.موجود(يمين), اختياري.موجود(الوجهة)) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختياري.موجود(س) -> { حد := س; };
        دع صفر_طبيعي: طبيعي = 0;
        دع واحد_طبيعي: طبيعي = 1;
        دع كل_البتات: طبيعي = ~(صفر_طبيعي);
        دع بت_الإشارة: طبيعي = واحد_طبيعي << (البتات - 1);
        // The type's minimum sign-extended to 64 bits: every bit from the sign
        // bit up (a left shift of all ones would overflow).
        دع قيمة_الصغرى: طبيعي = كل_البتات ^ (بت_الإشارة - 1);
        طابق ألحق_نقل_فوري_بتات_إكس(البايتات, حد, قيمة_الصغرى) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_مقارنة_بعرض_إكس(البايتات, يسار, حد, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, 0x75); ألحق_بايت_إكس(البايتات, 8);
        ألحق_مقارنة_فوري8_إكس(البايتات, يمين, 255);
        ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 5);
    };
    دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 }; دع ركس_د: معرف_سجل_فعلي = { القيمة: 2 };
    طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, يسار) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    إذا (بإشارة) { ألحق_بايت_إكس(البايتات, 0x48); ألحق_بايت_إكس(البايتات, 0x99); }
    وإلا { ألحق_بايت_إكس(البايتات, 0x31); ألحق_بايت_إكس(البايتات, 0xD2); };
    دع حقل_قسمة: متغير طبيعي = 0xF0;
    إذا (بإشارة) { حقل_قسمة := 0xF8; };
    دع سجل_حقل_قسمة: معرف_سجل_فعلي = { القيمة: 7 };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, سجل_حقل_قسمة, يمين)); ألحق_بايت_إكس(البايتات, 0xF7); ألحق_بايت_إكس(البايتات, حقل_قسمة + (يمين.القيمة % 8));
    إذا (باقي) { طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, ركس_د) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    وإلا { طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

// SAR/SHR/SHL r64, imm8 (ModRM field 7, 5, 4); nothing for 0.
عرف ألحق_إزاحة_فورية_بحقل_إكس(البايتات: &متغير متجه ط8, السجل: معرف_سجل_فعلي, المقدار: طبيعي, الحقل: طبيعي): فراغ {
    إذا (المقدار == 0) { أرجع; };
    دع حقل_مود: معرف_سجل_فعلي = { القيمة: الحقل };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, حقل_مود, السجل));
    ألحق_بايت_إكس(البايتات, 0xC1);
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(حقل_مود, السجل));
    ألحق_بايت_إكس(البايتات, المقدار);
}

// F7 /الحقل r64: MUL 4, IMUL (one operand) 5, NEG 3.
عرف ألحق_أحادي_إف7_إكس(البايتات: &متغير متجه ط8, السجل: معرف_سجل_فعلي, الحقل: طبيعي): فراغ {
    دع حقل_مود: معرف_سجل_فعلي = { القيمة: الحقل };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, حقل_مود, السجل));
    ألحق_بايت_إكس(البايتات, 0xF7);
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(حقل_مود, السجل));
}

// Division or remainder by a constant (backend/codegen/division_by_constant.sn).
// The dividend is read once, extended to 64 bits, into a work register س
// (R10 or RCX, never the destination); RAX:RDX take the multiply. The
// destination is written last, so it may be any register, a work one too.
عرف ألحق_قسمة_على_ثابت_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    القاسم: طبيعي,
    البتات: طبيعي,
    موقع: منطقي,
    باقي: منطقي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 };
    دع ركس_د: معرف_سجل_فعلي = { القيمة: 2 };
    دع س: متغير معرف_سجل_فعلي = { القيمة: 10 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(ركس_أ), اختياري.موجود(ركس_د), اختياري.موجود(الوجهة)) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); }
    | اختياري.موجود(ع) -> { س := ع; };
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, س, المصدر, البتات, موقع) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    // The quotient register: RAX or RDX.
    دع الخارج: متغير معرف_سجل_فعلي = ركس_أ;
    طابق أس_قوة_اثنين_قسمة_ثابت(القاسم) مع
    | اختياري.موجود(الأس) -> {
        إذا (!موقع) {
            إذا (باقي) {
                طابق ألحق_نقل_فوري_بتات_إكس(البايتات, ركس_أ, القاسم - 1) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, س, ركس_أ, 0x20, 0x21) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            } وإلا {
                ألحق_إزاحة_فورية_بحقل_إكس(البايتات, س, الأس, 5);
            };
            طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, س) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
        };
    }
    | اختياري.لا_شيء -> { };
    دع سالب: منطقي = موقع && (القاسم >> 63) != 0;
    دع المطلق: متغير طبيعي = القاسم;
    إذا (سالب) { المطلق := (~القاسم) + 1; };
    إذا (موقع) {
        طابق أس_قوة_اثنين_قسمة_ثابت(المطلق) مع
        | اختياري.موجود(الأس) -> {
            // RAX := (x + ((x >>s 63) >>u (64 - k))) >>s k, negated for d < 0.
            طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, س) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            ألحق_إزاحة_فورية_بحقل_إكس(البايتات, ركس_أ, 63, 7);
            ألحق_إزاحة_فورية_بحقل_إكس(البايتات, ركس_أ, 64 - الأس, 5);
            طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_أ, س, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            ألحق_إزاحة_فورية_بحقل_إكس(البايتات, ركس_أ, الأس, 7);
            إذا (سالب) { ألحق_أحادي_إف7_إكس(البايتات, ركس_أ, 3); };
        }
        | اختياري.لا_شيء -> {
            دع الخطة: خطة_قسمة_موقعة_على_ثابت = خطة_قسمة_موقعة_على_ثابت_من(القاسم);
            // RDX := mulhs(x, magic), corrected by ±x, shifted, + its sign bit.
            طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, س) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_نقل_فوري_بتات_إكس(البايتات, ركس_د, الخطة.المضاعف) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            ألحق_أحادي_إف7_إكس(البايتات, ركس_د, 5);
            دع مضاعف_سالب: منطقي = (الخطة.المضاعف >> 63) != 0;
            إذا (!سالب && مضاعف_سالب) {
                طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_د, س, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            };
            إذا (سالب && !مضاعف_سالب) {
                طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_د, س, 0x28, 0x29) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            };
            ألحق_إزاحة_فورية_بحقل_إكس(البايتات, ركس_د, الخطة.الإزاحة, 7);
            طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, ركس_د) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            ألحق_إزاحة_فورية_بحقل_إكس(البايتات, ركس_أ, 63, 5);
            طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_د, ركس_أ, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            الخارج := ركس_د;
        };
    } وإلا {
        دع الخطة: خطة_قسمة_طبيعية_على_ثابت = خطة_قسمة_طبيعية_على_ثابت_من(القاسم);
        // RDX := mulhu(x >> pre, magic); with add: RAX := ((x - RDX) >> 1) + RDX.
        طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, س) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_إزاحة_فورية_بحقل_إكس(البايتات, ركس_أ, الخطة.إزاحة_قبلية, 5);
        طابق ألحق_نقل_فوري_بتات_إكس(البايتات, ركس_د, الخطة.المضاعف) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_أحادي_إف7_إكس(البايتات, ركس_د, 4);
        إذا (الخطة.جمع) {
            طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, س) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_أ, ركس_د, 0x28, 0x29) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            ألحق_إزاحة_فورية_بحقل_إكس(البايتات, ركس_أ, 1, 5);
            طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_أ, ركس_د, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            ألحق_إزاحة_فورية_بحقل_إكس(البايتات, ركس_أ, الخطة.إزاحة_بعدية, 5);
            الخارج := ركس_أ;
        } وإلا {
            ألحق_إزاحة_فورية_بحقل_إكس(البايتات, ركس_د, الخطة.إزاحة_بعدية, 5);
            الخارج := ركس_د;
        };
    };
    إذا (باقي) {
        // س := x - q * d (exact; the product never exceeds |x|).
        دع الآخر: متغير معرف_سجل_فعلي = ركس_د;
        إذا (الخارج.القيمة == 2) { الآخر := ركس_أ; };
        طابق ألحق_نقل_فوري_بتات_إكس(البايتات, الآخر, القاسم) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, الآخر, الخارج)); ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0xAF); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(الآخر, الخارج));
        طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, س, الآخر, 0x28, 0x29) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        الخارج := س;
    };
    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, الخارج) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

عرف ألحق_إزاحة_بعدد_سي_إكس(
    البايتات: &متغير متجه ط8,
    السجل: معرف_سجل_فعلي,
    البتات: طبيعي,
    الحقل: طبيعي
): فراغ {
    إذا (البتات == 16) { ألحق_بايت_إكس(البايتات, 0x66); };
    دع حقل_إزاحة_ركس: معرف_سجل_فعلي = { القيمة: 0 };
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, حقل_إزاحة_ركس, السجل));
    إذا (البتات == 8) { ألحق_بايت_إكس(البايتات, 0xD2); } وإلا { ألحق_بايت_إكس(البايتات, 0xD3); };
    ألحق_بايت_إكس(البايتات, 0xC0 + (الحقل * 8) + (السجل.القيمة % 8));
}

عرف ألحق_إزاحة_إكس(
    البايتات: &متغير متجه ط8,
    العملية: حساب_صحيح_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: طبيعي,
    بإشارة: منطقي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    // x86 يخفي عداد الإزاحة إلى خمس/ست بتات؛ MSIR لا يفعل ذلك، لذلك نفخ قبل التعليمة.
    ألحق_مقارنة_فوري8_إكس(البايتات, ب, البتات);
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 2);

    دع سجل_العد: معرف_سجل_فعلي = { القيمة: 1 };
    دع سجل_القيمة: متغير معرف_سجل_فعلي = { القيمة: 0 };
    // احتفظ بالأصل في أ لفحص تجاوز الإزاحة اليسرى؛ سجلات allocator العامة لا تشمل RCX.
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(سجل_العد), اختياري.موجود(ب), اختياري.موجود(أ)) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); }
    | اختياري.موجود(س) -> { سجل_القيمة := س; };
    طابق ألحق_نقل_سجل_إكس(البايتات, سجل_القيمة, أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_سجل_إكس(البايتات, سجل_العد, ب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

    دع حقل: متغير طبيعي = 4;
    دع إزاحة_يسرى: متغير منطقي = خطأ;
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.إزاحة_يسرى -> { حقل := 4; إزاحة_يسرى := صواب; }
    | حساب_صحيح_إكس_كامل.إزاحة_يسرى_ملتفة -> { حقل := 4; }
    | حساب_صحيح_إكس_كامل.إزاحة_يمنى -> { حقل := 5; }
    | حساب_صحيح_إكس_كامل.إزاحة_حسابية_يمنى -> { حقل := 7; }
    | _ -> { };
    ألحق_إزاحة_بعدد_سي_إكس(البايتات, سجل_القيمة, البتات, حقل);

    إذا (إزاحة_يسرى) {
        // MSIR يجعل فقدان أي بت ذي دلالة تجاوزا. اعكس الإزاحة وقارن بالأصل قبل قبول الناتج.
        دع حقل_العكس: متغير طبيعي = 5;
        إذا (بإشارة) { حقل_العكس := 7; };
        ألحق_إزاحة_بعدد_سي_إكس(البايتات, سجل_القيمة, البتات, حقل_العكس);
        طابق ألحق_مقارنة_بعرض_إكس(البايتات, سجل_القيمة, أ, البتات) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 4);
        // أعد تكوين الناتج الصحيح بعد أن استُخدمت نسخة العمل للفحص العكسي.
        ألحق_إزاحة_بعدد_سي_إكس(البايتات, سجل_القيمة, البتات, 4);
    };

    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, سجل_القيمة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

عرف احفظ_يمين_عملية_ثنائية_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    الهدف: &واصف_هدف
): نتيجة معرف_سجل_فعلي, خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون {
    إذا (!سجلان_فعليان_متساويان_إكس(الوجهة, ب) || سجلان_فعليان_متساويان_إكس(أ, ب)) {
        أرجع نتيجة.نجح(ب);
    };
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(الوجهة), اختياري.موجود(أ), اختياري.موجود(ب)) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); }
    | اختياري.موجود(العمل) -> {
        طابق ألحق_نقل_سجل_إكس(البايتات, العمل, ب) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { أرجع نتيجة.نجح(العمل); };
    };
}

عرف ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(
    البايتات: &متغير متجه ط8,
    السجل_العائم: طبيعي,
    المصدر: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    إذا (!(البتات == 32 || البتات == 64)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8));
    };
    إذا (!سجل_إكس_قابل_للترميز(المصدر) || السجل_العائم > 7) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر));
    };
    دع حقل: معرف_سجل_فعلي = { القيمة: السجل_العائم };
    ألحق_بايت_إكس(البايتات, 0x66);
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, حقل, المصدر));
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x6E);
    ألحق_بايت_إكس(البايتات, 0xC0 + ((السجل_العائم % 8) * 8) + (المصدر.القيمة % 8));
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    السجل_العائم: طبيعي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    إذا (!(البتات == 32 || البتات == 64)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(البتات / 8));
    };
    إذا (!سجل_إكس_قابل_للترميز(الوجهة) || السجل_العائم > 7) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة));
    };
    دع حقل: معرف_سجل_فعلي = { القيمة: السجل_العائم };
    ألحق_بايت_إكس(البايتات, 0x66);
    ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(البتات, حقل, الوجهة));
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x7E);
    ألحق_بايت_إكس(البايتات, 0xC0 + ((السجل_العائم % 8) * 8) + (الوجهة.القيمة % 8));
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

// One SSE instruction between two of xmm0..xmm5 (no REX needed):
// [prefix] 0F op /r with ModRM 11 dst src; prefix 0 means none.
عرف ألحق_عملية_إس_إس_إي_إكس(البايتات: &متغير متجه ط8, البادئة: طبيعي, الرمز: طبيعي, الوجهة: طبيعي, المصدر: طبيعي): فراغ {
    إذا (البادئة != 0) { ألحق_بايت_إكس(البايتات, البادئة); };
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, الرمز);
    ألحق_بايت_إكس(البايتات, 0xC0 + (الوجهة * 8) + المصدر);
}

// The float primitives on SSE2 registers. a is in xmm0, b in xmm1 (a again
// for the unary ones); xmm2..xmm5 are scratch (caller-saved in SysV and in
// Microsoft x64); the destination register is scratch once a and b are read.
// minimum/maximum follow LLVM's SSE lowering of FMINIMUM/FMAXIMUM: MINSD
// selects the ordered result, equal operands (only the sign of a zero can
// differ) combine their bits (OR for minimum, AND for maximum), and an
// unordered pair gives a + b, the quieted NaN operand.
عرف ألحق_عملية_عائمة_خاصة_إكس(
    البايتات: &متغير متجه ط8,
    العملية: حساب_عشري_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    دع بادئة_سلمية: متغير طبيعي = 0xF2;
    إذا (البتات == 32) { بادئة_سلمية := 0xF3; };
    دع واحد: طبيعي = 1;
    دع بت_الإشارة: متغير طبيعي = واحد << 63;
    إذا (البتات == 32) { بت_الإشارة := واحد << 31; };
    دع سجل_الناتج: متغير طبيعي = 0;
    طابق العملية مع
    | حساب_عشري_إكس_كامل.جذر_تربيعي -> {
        ألحق_عملية_إس_إس_إي_إكس(البايتات, بادئة_سلمية, 0x51, 0, 1);
    }
    | حساب_عشري_إكس_كامل.قيمة_مطلقة -> {
        // xmm1 := ~sign (through the destination); ANDPD xmm0, xmm1.
        طابق ألحق_نقل_فوري_بتات_إكس(البايتات, الوجهة, ~بت_الإشارة & قناع_بتات_إكس(البتات)) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 1, الوجهة, 64) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x54, 0, 1);
    }
    | حساب_عشري_إكس_كامل.نسخ_إشارة -> {
        // xmm2 := sign; ANDPD xmm1, xmm2; ANDNPD xmm2, xmm0; ORPD xmm2, xmm1.
        طابق ألحق_نقل_فوري_بتات_إكس(البايتات, الوجهة, بت_الإشارة) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 2, الوجهة, 64) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x54, 1, 2);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x55, 2, 0);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x56, 2, 1);
        سجل_الناتج := 2;
    }
    | _ -> {
        دع أقصى: منطقي = العملية == حساب_عشري_إكس_كامل.أقصى();
        // xmm2 := MINSD/MAXSD(a, b).
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x28, 2, 0);
        دع رمز_الاختيار: متغير طبيعي = 0x5D;
        إذا (أقصى) { رمز_الاختيار := 0x5F; };
        ألحق_عملية_إس_إس_إي_إكس(البايتات, بادئة_سلمية, رمز_الاختيار, 2, 1);
        // xmm3 := a | b (minimum) or a & b (maximum).
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x28, 3, 0);
        دع رمز_الدمج: متغير طبيعي = 0x56;
        إذا (أقصى) { رمز_الدمج := 0x54; };
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, رمز_الدمج, 3, 1);
        // xmm4 := (a == b) mask; xmm4 := (eq & xmm3) | (~eq & xmm2).
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x28, 4, 0);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, بادئة_سلمية, 0xC2, 4, 1);
        ألحق_بايت_إكس(البايتات, 0);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x54, 3, 4);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x55, 4, 2);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x56, 4, 3);
        // xmm5 := unordered mask; xmm0 := (unord & (a + b)) | (~unord & xmm4).
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x28, 5, 0);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, بادئة_سلمية, 0xC2, 5, 1);
        ألحق_بايت_إكس(البايتات, 3);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, بادئة_سلمية, 0x58, 0, 1);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x54, 0, 5);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x55, 5, 4);
        ألحق_عملية_إس_إس_إي_إكس(البايتات, 0x66, 0x56, 0, 5);
    };
    أرجع ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(البايتات, الوجهة, سجل_الناتج, البتات);
}

عرف ألحق_حساب_عشري_إكس(
    البايتات: &متغير متجه ط8,
    العملية: حساب_عشري_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 0, أ, البتات) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 1, ب, البتات) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع الرمز: متغير طبيعي = 0x58;
    طابق العملية مع
    | حساب_عشري_إكس_كامل.جمع -> { الرمز := 0x58; }
    | حساب_عشري_إكس_كامل.طرح -> { الرمز := 0x5C; }
    | حساب_عشري_إكس_كامل.ضرب -> { الرمز := 0x59; }
    | حساب_عشري_إكس_كامل.قسمة -> { الرمز := 0x5E; }
    | _ -> { أرجع ألحق_عملية_عائمة_خاصة_إكس(البايتات, العملية, الوجهة, البتات); };
    إذا (البتات == 32) { ألحق_بايت_إكس(البايتات, 0xF3); } وإلا { ألحق_بايت_إكس(البايتات, 0xF2); };
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, الرمز);
    ألحق_بايت_إكس(البايتات, 0xC1);
    أرجع ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(البايتات, الوجهة, 0, البتات);
}

// Float conversions (docs/en/reference/type-system.md, "Numeric casts"). Floats live in
// general registers as bits; xmm0 and xmm1 are scratch, as for arithmetic.
// The destination is also scratch: every read of the source comes first.

عرف ألحق_كتلة_بايتات_إكس(البايتات: &متغير متجه ط8, الكتلة: &متجه ط8): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الكتلة) مثل طبيعي)) {
        ألحق_بايت_إكس(البايتات, (*الكتلة)[ف] مثل طبيعي);
        ف := ف + 1;
    }
}

عرف طول_بايتات_إكس(الكتلة: &متجه ط8): طبيعي { أرجع الطول(*الكتلة) مثل طبيعي; }

// CVTTSS2SI / CVTTSD2SI r64, xmm0: truncates; 0x8000000000000000 when out of range.
عرف ألحق_اقتطاع_عائم_إلى_صحيح_إكس(البايتات: &متغير متجه ط8, الوجهة: معرف_سجل_فعلي, بتات_العائم: طبيعي): فراغ {
    إذا (بتات_العائم == 32) { ألحق_بايت_إكس(البايتات, 0xF3); } وإلا { ألحق_بايت_إكس(البايتات, 0xF2); };
    دع ركس: متغير طبيعي = 0x48; إذا (الوجهة.القيمة >= 8) { ركس := ركس + 4; };
    ألحق_بايت_إكس(البايتات, ركس); ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x2C);
    ألحق_بايت_إكس(البايتات, 0xC0 + ((الوجهة.القيمة % 8) * 8));
}

// CVTSI2SS / CVTSI2SD xmm0, r64: rounds to nearest, ties to even (MXCSR default).
عرف ألحق_صحيح_إلى_عائم_إكس(البايتات: &متغير متجه ط8, المصدر: معرف_سجل_فعلي, بتات_العائم: طبيعي): فراغ {
    إذا (بتات_العائم == 32) { ألحق_بايت_إكس(البايتات, 0xF3); } وإلا { ألحق_بايت_إكس(البايتات, 0xF2); };
    دع ركس: متغير طبيعي = 0x48; إذا (المصدر.القيمة >= 8) { ركس := ركس + 1; };
    ألحق_بايت_إكس(البايتات, ركس); ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x2A);
    ألحق_بايت_إكس(البايتات, 0xC0 + (المصدر.القيمة % 8));
}

// A scalar SSE operation xmm0 := xmm0 op xmmN (ADD 58, SUB 5C, CVT 5A).
عرف ألحق_عملية_عائمة_سلمية_إكس(البايتات: &متغير متجه ط8, بتات_العائم: طبيعي, الرمز: طبيعي, الثاني: طبيعي): فراغ {
    إذا (بتات_العائم == 32) { ألحق_بايت_إكس(البايتات, 0xF3); } وإلا { ألحق_بايت_إكس(البايتات, 0xF2); };
    ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, الرمز); ألحق_بايت_إكس(البايتات, 0xC0 + الثاني);
}

// UCOMISS / UCOMISD xmm0, xmm1: CF for below, PF for unordered.
عرف ألحق_مقارنة_عائمة_سلمية_إكس(البايتات: &متغير متجه ط8, بتات_العائم: طبيعي): فراغ {
    إذا (بتات_العائم == 64) { ألحق_بايت_إكس(البايتات, 0x66); };
    ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x2E); ألحق_بايت_إكس(البايتات, 0xC1);
}

// ±2^k as float bits.
عرف بتات_قوة_اثنين_عائمة_إكس(الأس: طبيعي, سالب: منطقي, بتات_العائم: طبيعي): طبيعي {
    دع واحد: طبيعي = 1;
    إذا (بتات_العائم == 32) {
        دع الناتج: طبيعي = (127 + الأس) << 23;
        إذا (سالب) { أرجع الناتج | (واحد << 31); };
        أرجع الناتج;
    };
    دع الناتج: طبيعي = (1023 + الأس) << 52;
    إذا (سالب) { أرجع الناتج | (واحد << 63); };
    أرجع الناتج;
}

عرف قناع_بتات_إكس(البتات: طبيعي): طبيعي {
    إذا (البتات >= 64) { أرجع ~(0 مثل طبيعي); };
    أرجع ((1 مثل طبيعي) << البتات) - 1;
}

// Loads the float constant into xmm1 through the destination register.
عرف ألحق_ثابت_عائم_في_الثاني_إكس(البايتات: &متغير متجه ط8, الوجهة: معرف_سجل_فعلي, البتات_الخام: طبيعي, بتات_العائم: طبيعي): نتيجة_دفعة_ترميز_إكس {
    طابق ألحق_نقل_فوري_بتات_إكس(البايتات, الوجهة, البتات_الخام) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    أرجع ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 1, الوجهة, بتات_العائم);
}

عرف ألحق_قفز_قصير_إكس(البايتات: &متغير متجه ط8, الرمز: طبيعي, المسافة: طبيعي): فراغ {
    ألحق_بايت_إكس(البايتات, الرمز); ألحق_بايت_إكس(البايتات, المسافة);
}

// float -> iN/uN, Rust `as`: truncate, saturate at the type's bounds, NaN -> 0.
// Bounds are compared as floats (exact powers of two), so CVTT only ever
// sees an in-range value; u64 above 2^63 converts x - 2^63 and sets bit 63.
عرف ألحق_عائم_إلى_صحيح_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    بتات_العائم: طبيعي,
    بتات_الصحيح: طبيعي,
    موقع: منطقي
): نتيجة_دفعة_ترميز_إكس {
    دع الأدنى: متغير طبيعي = 0;
    دع الأقصى: متغير طبيعي = قناع_بتات_إكس(بتات_الصحيح);
    دع حد_أدنى_عائم: متغير طبيعي = 0;
    دع حد_أعلى_عائم: متغير طبيعي = بتات_قوة_اثنين_عائمة_إكس(بتات_الصحيح, خطأ, بتات_العائم);
    إذا (موقع) {
        الأدنى := (1 مثل طبيعي) << (بتات_الصحيح - 1);
        الأقصى := الأدنى - 1;
        حد_أدنى_عائم := بتات_قوة_اثنين_عائمة_إكس(بتات_الصحيح - 1, صواب, بتات_العائم);
        حد_أعلى_عائم := بتات_قوة_اثنين_عائمة_إكس(بتات_الصحيح - 1, خطأ, بتات_العائم);
    };
    // Upper-bound test: x >= 2^N (or 2^(N-1)) saturates high.
    دع كتلة_الأعلى_اختبار: متغير متجه ط8 = [];
    طابق ألحق_ثابت_عائم_في_الثاني_إكس(&متغير كتلة_الأعلى_اختبار, الوجهة, حد_أعلى_عائم, بتات_العائم) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_مقارنة_عائمة_سلمية_إكس(&متغير كتلة_الأعلى_اختبار, بتات_العائم);
    // In range.
    دع كتلة_المدى: متغير متجه ط8 = [];
    إذا (!موقع && بتات_الصحيح == 64) {
        دع الصغير: متغير متجه ط8 = [];
        ألحق_اقتطاع_عائم_إلى_صحيح_إكس(&متغير الصغير, الوجهة, بتات_العائم);
        دع الكبير: متغير متجه ط8 = [];
        ألحق_عملية_عائمة_سلمية_إكس(&متغير الكبير, بتات_العائم, 0x5C, 1);
        ألحق_اقتطاع_عائم_إلى_صحيح_إكس(&متغير الكبير, الوجهة, بتات_العائم);
        // BTC r64, 63
        دع ركس: متغير طبيعي = 0x48; إذا (الوجهة.القيمة >= 8) { ركس := ركس + 1; };
        ألحق_بايت_إكس(&متغير الكبير, ركس); ألحق_بايت_إكس(&متغير الكبير, 0x0F); ألحق_بايت_إكس(&متغير الكبير, 0xBA);
        ألحق_بايت_إكس(&متغير الكبير, 0xF8 + (الوجهة.القيمة % 8)); ألحق_بايت_إكس(&متغير الكبير, 63);
        طابق ألحق_ثابت_عائم_في_الثاني_إكس(&متغير كتلة_المدى, الوجهة, بتات_قوة_اثنين_عائمة_إكس(63, خطأ, بتات_العائم), بتات_العائم) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_مقارنة_عائمة_سلمية_إكس(&متغير كتلة_المدى, بتات_العائم);
        ألحق_قفز_قصير_إكس(&متغير كتلة_المدى, 0x73, طول_بايتات_إكس(&الصغير) + 2); // JAE
        ألحق_كتلة_بايتات_إكس(&متغير كتلة_المدى, &الصغير);
        ألحق_قفز_قصير_إكس(&متغير كتلة_المدى, 0xEB, طول_بايتات_إكس(&الكبير));
        ألحق_كتلة_بايتات_إكس(&متغير كتلة_المدى, &الكبير);
    } وإلا {
        ألحق_اقتطاع_عائم_إلى_صحيح_إكس(&متغير كتلة_المدى, الوجهة, بتات_العائم);
        طابق ألحق_تقنين_عرض_إكس(&متغير كتلة_المدى, الوجهة, بتات_الصحيح) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    };
    دع كتلة_أدنى: متغير متجه ط8 = [];
    طابق ألحق_نقل_فوري_بتات_إكس(&متغير كتلة_أدنى, الوجهة, الأدنى) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع كتلة_أعلى: متغير متجه ط8 = [];
    طابق ألحق_نقل_فوري_بتات_إكس(&متغير كتلة_أعلى, الوجهة, الأقصى) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع كتلة_نان: متغير متجه ط8 = [];
    طابق ألحق_نقل_فوري_بتات_إكس(&متغير كتلة_نان, الوجهة, 0) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

    دع ط_أعلى_اختبار: طبيعي = طول_بايتات_إكس(&كتلة_الأعلى_اختبار) + 2;
    دع ط_المدى: طبيعي = طول_بايتات_إكس(&كتلة_المدى) + 2;
    دع ط_أدنى: طبيعي = طول_بايتات_إكس(&كتلة_أدنى) + 2;
    دع ط_أعلى: طبيعي = طول_بايتات_إكس(&كتلة_أعلى) + 2;
    دع ط_نان: طبيعي = طول_بايتات_إكس(&كتلة_نان);

    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 0, المصدر, بتات_العائم) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_ثابت_عائم_في_الثاني_إكس(البايتات, الوجهة, حد_أدنى_عائم, بتات_العائم) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_مقارنة_عائمة_سلمية_إكس(البايتات, بتات_العائم);
    // JP NaN; JB low (an unsigned lower bound is +0.0: -0.0 is not below it).
    ألحق_قفز_قصير_إكس(البايتات, 0x7A, 2 + ط_أعلى_اختبار + ط_المدى + ط_أدنى + ط_أعلى);
    ألحق_قفز_قصير_إكس(البايتات, 0x72, ط_أعلى_اختبار + ط_المدى);
    ألحق_كتلة_بايتات_إكس(البايتات, &كتلة_الأعلى_اختبار);
    ألحق_قفز_قصير_إكس(البايتات, 0x73, ط_المدى + ط_أدنى); // JAE high
    ألحق_كتلة_بايتات_إكس(البايتات, &كتلة_المدى);
    ألحق_قفز_قصير_إكس(البايتات, 0xEB, ط_أدنى + ط_أعلى + ط_نان);
    ألحق_كتلة_بايتات_إكس(البايتات, &كتلة_أدنى);
    ألحق_قفز_قصير_إكس(البايتات, 0xEB, ط_أعلى + ط_نان);
    ألحق_كتلة_بايتات_إكس(البايتات, &كتلة_أعلى);
    ألحق_قفز_قصير_إكس(البايتات, 0xEB, ط_نان);
    ألحق_كتلة_بايتات_إكس(البايتات, &كتلة_نان);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

// iN/uN -> float, rounded to nearest (ties to even). u64 values with the top
// bit set are halved with the lost bit kept sticky, converted and doubled.
عرف ألحق_صحيح_إلى_عائم_كامل_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    بتات_الصحيح: طبيعي,
    بتات_العائم: طبيعي,
    موقع: منطقي
): نتيجة_دفعة_ترميز_إكس {
    إذا (بتات_الصحيح < 64) {
        طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, المصدر, بتات_الصحيح, موقع) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_صحيح_إلى_عائم_إكس(البايتات, الوجهة, بتات_العائم);
    } وإلا إذا (موقع) {
        ألحق_صحيح_إلى_عائم_إكس(البايتات, المصدر, بتات_العائم);
    } وإلا {
        دع الصغير: متغير متجه ط8 = [];
        ألحق_صحيح_إلى_عائم_إكس(&متغير الصغير, المصدر, بتات_العائم);
        دع الكبير: متغير متجه ط8 = [];
        طابق ألحق_نقل_سجل_إكس(&متغير الكبير, الوجهة, المصدر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        دع ركس: متغير طبيعي = 0x48; إذا (الوجهة.القيمة >= 8) { ركس := ركس + 1; };
        // SHR r64, 1 ; JNC +4 ; OR r64, 1
        ألحق_بايت_إكس(&متغير الكبير, ركس); ألحق_بايت_إكس(&متغير الكبير, 0xD1); ألحق_بايت_إكس(&متغير الكبير, 0xE8 + (الوجهة.القيمة % 8));
        ألحق_قفز_قصير_إكس(&متغير الكبير, 0x73, 4);
        ألحق_بايت_إكس(&متغير الكبير, ركس); ألحق_بايت_إكس(&متغير الكبير, 0x83); ألحق_بايت_إكس(&متغير الكبير, 0xC8 + (الوجهة.القيمة % 8)); ألحق_بايت_إكس(&متغير الكبير, 1);
        ألحق_صحيح_إلى_عائم_إكس(&متغير الكبير, الوجهة, بتات_العائم);
        ألحق_عملية_عائمة_سلمية_إكس(&متغير الكبير, بتات_العائم, 0x58, 0);
        ألحق_اختبار_سجل_إكس(البايتات, المصدر);
        ألحق_قفز_قصير_إكس(البايتات, 0x78, طول_بايتات_إكس(&الصغير) + 2); // JS
        ألحق_كتلة_بايتات_إكس(البايتات, &الصغير);
        ألحق_قفز_قصير_إكس(البايتات, 0xEB, طول_بايتات_إكس(&الكبير));
        ألحق_كتلة_بايتات_إكس(البايتات, &الكبير);
    };
    أرجع ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(البايتات, الوجهة, 0, بتات_العائم);
}

عرف ألحق_تحويل_عائم_إكس(
    البايتات: &متغير متجه ط8,
    العملية: تحويل_عائم_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    من_بتات: طبيعي,
    إلى_بتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    إذا (!سجل_إكس_قابل_للترميز(الوجهة) || !سجل_إكس_قابل_للترميز(المصدر)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة));
    };
    طابق العملية مع
    | تحويل_عائم_إكس_كامل.عائم_إلى_موقع -> { أرجع ألحق_عائم_إلى_صحيح_إكس(البايتات, الوجهة, المصدر, من_بتات, إلى_بتات, صواب); }
    | تحويل_عائم_إكس_كامل.عائم_إلى_طبيعي -> { أرجع ألحق_عائم_إلى_صحيح_إكس(البايتات, الوجهة, المصدر, من_بتات, إلى_بتات, خطأ); }
    | تحويل_عائم_إكس_كامل.موقع_إلى_عائم -> { أرجع ألحق_صحيح_إلى_عائم_كامل_إكس(البايتات, الوجهة, المصدر, من_بتات, إلى_بتات, صواب); }
    | تحويل_عائم_إكس_كامل.طبيعي_إلى_عائم -> { أرجع ألحق_صحيح_إلى_عائم_كامل_إكس(البايتات, الوجهة, المصدر, من_بتات, إلى_بتات, خطأ); }
    | تحويل_عائم_إكس_كامل.عائم_إلى_عائم -> {
        طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 0, المصدر, من_بتات) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        إذا (من_بتات != إلى_بتات) {
            // CVTSS2SD (F3 0F 5A) widens; CVTSD2SS (F2 0F 5A) rounds to nearest.
            ألحق_عملية_عائمة_سلمية_إكس(البايتات, من_بتات, 0x5A, 0);
        };
        أرجع ألحق_نقل_بتات_عائم_إلى_جي_بي_إكس(البايتات, الوجهة, 0, إلى_بتات);
    };
}

عرف ألحق_ثبت_شرط_عشري_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    رمز_الشرط: طبيعي,
    صحح_عدم_الترتيب: منطقي,
    قيمة_عدم_الترتيب: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    دع ركس: متغير طبيعي = 0x40;
    إذا (الوجهة.القيمة >= 8) { ركس := ركس + 1; };
    ألحق_بايت_إكس(البايتات, ركس);
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x90 + رمز_الشرط);
    ألحق_بايت_إكس(البايتات, 0xC0 + (الوجهة.القيمة % 8));
    طابق ألحق_توسيع_خام_إلى64_إكس(البايتات, الوجهة, الوجهة, 8, خطأ) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    إذا (صحح_عدم_الترتيب) {
        // UCOMI sets PF for unordered. MOV/MOVZX keep flags intact, so ordered values skip the override,
        // whose length depends on the value.
        دع التصحيح: متغير متجه ط8 = [];
        طابق ألحق_نقل_فوري_بتات_إكس(&متغير التصحيح, الوجهة, قيمة_عدم_الترتيب) مع
        | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
        | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, 0x7B); // JNP
        ألحق_بايت_إكس(البايتات, طول_بايتات_إكس(&التصحيح));
        ألحق_كتلة_بايتات_إكس(البايتات, &التصحيح);
    };
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_مقارنة_عشرية_إلى_منطق_إكس(
    البايتات: &متغير متجه ط8,
    العملية: مقارنة_عشرية_إكس_كاملة,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 0, أ, البتات) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_بتات_جي_بي_إلى_عائم_إكس(البايتات, 1, ب, البتات) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    إذا (البتات == 64) { ألحق_بايت_إكس(البايتات, 0x66); };
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x2E);
    ألحق_بايت_إكس(البايتات, 0xC1); // UCOMIS{S,D} xmm0,xmm1
    طابق العملية مع
    | مقارنة_عشرية_إكس_كاملة.يساوي -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 4, صواب, 0); }
    | مقارنة_عشرية_إكس_كاملة.لا_يساوي -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 5, صواب, 1); }
    | مقارنة_عشرية_إكس_كاملة.أصغر -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 2, صواب, 0); }
    | مقارنة_عشرية_إكس_كاملة.أصغر_أو_يساوي -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 6, صواب, 0); }
    | مقارنة_عشرية_إكس_كاملة.أكبر -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 7, خطأ, 0); }
    | مقارنة_عشرية_إكس_كاملة.أكبر_أو_يساوي -> { أرجع ألحق_ثبت_شرط_عشري_إكس(البايتات, الوجهة, 3, خطأ, 0); };
}

عرف ألحق_حساب_صحيح_كامل_إكس(
    البايتات: &متغير متجه ط8,
    العملية: حساب_صحيح_إكس_كامل,
    الوجهة: معرف_سجل_فعلي,
    أ: معرف_سجل_فعلي,
    ب: معرف_سجل_فعلي,
    البتات: طبيعي,
    بإشارة: منطقي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.ضرب -> { أرجع ألحق_ضرب_إكس(البايتات, الوجهة, أ, ب, البتات, بإشارة, الهدف); }
    | حساب_صحيح_إكس_كامل.قسمة_موقعة -> { أرجع ألحق_قسمة_أو_باقي_إكس(البايتات, الوجهة, أ, ب, البتات, صواب, خطأ, الهدف); }
    | حساب_صحيح_إكس_كامل.قسمة_طبيعية -> { أرجع ألحق_قسمة_أو_باقي_إكس(البايتات, الوجهة, أ, ب, البتات, خطأ, خطأ, الهدف); }
    | حساب_صحيح_إكس_كامل.باقي_موقع -> { أرجع ألحق_قسمة_أو_باقي_إكس(البايتات, الوجهة, أ, ب, البتات, صواب, صواب, الهدف); }
    | حساب_صحيح_إكس_كامل.باقي_طبيعي -> { أرجع ألحق_قسمة_أو_باقي_إكس(البايتات, الوجهة, أ, ب, البتات, خطأ, صواب, الهدف); }
    | حساب_صحيح_إكس_كامل.إزاحة_يسرى -> { أرجع ألحق_إزاحة_إكس(البايتات, العملية, الوجهة, أ, ب, البتات, بإشارة, الهدف); }
    | حساب_صحيح_إكس_كامل.إزاحة_يمنى -> { أرجع ألحق_إزاحة_إكس(البايتات, العملية, الوجهة, أ, ب, البتات, بإشارة, الهدف); }
    | حساب_صحيح_إكس_كامل.إزاحة_حسابية_يمنى -> { أرجع ألحق_إزاحة_إكس(البايتات, العملية, الوجهة, أ, ب, البتات, بإشارة, الهدف); }
    | حساب_صحيح_إكس_كامل.إزاحة_يسرى_ملتفة -> { أرجع ألحق_إزاحة_إكس(البايتات, العملية, الوجهة, أ, ب, البتات, بإشارة, الهدف); }
    | _ -> { };
    دع يمين_آمن: متغير معرف_سجل_فعلي = ب;
    طابق احفظ_يمين_عملية_ثنائية_إكس(البايتات, الوجهة, أ, ب, الهدف) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة.نجح(س) -> { يمين_آمن := س; };
    طابق ألحق_نقل_سجل_إكس(البايتات, الوجهة, أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; إذا (بإشارة) { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1); } وإلا { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 3); }; }
    | حساب_صحيح_إكس_كامل.جمع_ملتف -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    | حساب_صحيح_إكس_كامل.طرح_ملتف -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x28, 0x29) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    // IMUL r64, r/m64: the low 64 bits of the product are the same for signed
    // and unsigned operands, and the low N bits only depend on theirs.
    | حساب_صحيح_إكس_كامل.ضرب_ملتف -> { ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, الوجهة, يمين_آمن)); ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0xAF); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(الوجهة, يمين_آمن)); }
    | حساب_صحيح_إكس_كامل.طرح -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x28, 0x29) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; إذا (بإشارة) { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 1); } وإلا { ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 3); }; }
    | حساب_صحيح_إكس_كامل.و_بتي -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x20, 0x21) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x08, 0x09) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, البتات, الوجهة, يمين_آمن, 0x30, 0x31) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { }; }
    | _ -> { };
    أرجع ألحق_تقنين_عرض_إكس(البايتات, الوجهة, البتات);
}

عرف ألحق_تكوين_عنوان_مقاس_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي,
    الفهرس: معرف_سجل_فعلي,
    الحجم: طبيعي,
    الإزاحة: عدد,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    طابق بتات_مقياس_إكس(الحجم) مع
    | اختياري.موجود(_) -> {
        دع أساس_العنوان: اختياري معرف_سجل_فعلي = اختياري.موجود(الأساس);
        دع فهرس_العنوان: اختياري معرف_سجل_فعلي = اختياري.موجود(الفهرس);
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
            الأساس: أساس_العنوان,
            الفهرس: فهرس_العنوان,
            المقياس: الحجم,
            الإزاحة: الإزاحة
        };
        أرجع ألحق_تكوين_عنوان_إكس(البايتات, الوجهة, &العنوان);
    }
    | اختياري.لا_شيء -> {
        // IMUL r64, r/m64, imm32 sign-extends its immediate: an element size
        // above INT32_MAX would scale by a negative factor, so it is an
        // encoding error, never a silently wrong address.
        إذا (الحجم > 0x7FFFFFFF) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.فوري_خارج_مدى_32(الحجم));
        };
        دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
        طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(الوجهة), اختياري.موجود(الأساس), اختياري.موجود(الفهرس)) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختياري.موجود(س) -> { العمل := س; };
        // IMUL r64, r/m64, imm: the three-operand form scales the index into
        // the work register without a copy first (imm8 when it fits).
        ألحق_بايت_إكس(البايتات, ركس_عرض_سجلين_إكس(64, العمل, الفهرس));
        إذا (الحجم < 128) {
            ألحق_بايت_إكس(البايتات, 0x6B); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(العمل, الفهرس)); ألحق_بايت_إكس(البايتات, الحجم);
        } وإلا {
            ألحق_بايت_إكس(البايتات, 0x69); ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(العمل, الفهرس)); ألحق_ط32_إكس(البايتات, الحجم);
        };
        دع أساس_العنوان: اختياري معرف_سجل_فعلي = اختياري.موجود(الأساس);
        دع فهرس_العنوان: اختياري معرف_سجل_فعلي = اختياري.موجود(العمل);
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
            الأساس: أساس_العنوان,
            الفهرس: فهرس_العنوان,
            المقياس: 1,
            الإزاحة: الإزاحة
        };
        أرجع ألحق_تكوين_عنوان_إكس(البايتات, الوجهة, &العنوان);
    };
}

عرف ألحق_عنوان_موضع_محلي_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    المعرف: طبيعي,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): نتيجة_دفعة_ترميز_إكس {
    طابق ابحث_موضع_محلي_إكس(الإطار, المعرف) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.موضع_محلي_مفقود(المعرف)); }
    | اختياري.موجود(الموضع) -> { دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(الموضع.إزاحة_بايت); أرجع ألحق_تكوين_عنوان_إكس(البايتات, الوجهة, &العنوان); };
}

// MOVUPS xmmN, [address] (a load) or MOVUPS [address], xmmN: 16 bytes at
// any alignment. N is one of the scratch xmm0..xmm5 (no value lives in an
// xmm register between instructions; floats travel in general registers).
عرف ألحق_نقل_ستة_عشر_بايتا_إكس(
    البايتات: &متغير متجه ط8,
    السجل_العائم: طبيعي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    تحميل: منطقي
): نتيجة_دفعة_ترميز_إكس {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع الحقل: معرف_سجل_فعلي = { القيمة: السجل_العائم };
    طابق ع.الأساس مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختياري.موجود(الأساس) -> {
        دع ركس: طبيعي = ركس_ذاكرة_إكس(خطأ, الحقل, ع.الفهرس, الأساس);
        إذا (ركس != 0x40) { ألحق_بايت_إكس(البايتات, ركس); };
    };
    ألحق_بايت_إكس(البايتات, 0x0F);
    إذا (تحميل) { ألحق_بايت_إكس(البايتات, 0x10); } وإلا { ألحق_بايت_إكس(البايتات, 0x11); };
    أرجع ألحق_معامل_ذاكرة_إكس(البايتات, الحقل, العنوان);
}

عرف عنوان_أساس_وإزاحة_إكس(الأساس: معرف_سجل_فعلي, الإزاحة: طبيعي): عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    دع أساس: اختياري معرف_سجل_فعلي = اختياري.موجود(الأساس);
    دع فهرس: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
    دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: أساس, الفهرس: فهرس, المقياس: 1, الإزاحة: الإزاحة مثل عدد
    };
    أرجع العنوان;
}

// Copies الحجم bytes: 32 bytes per step through xmm0 and xmm1, then 16, then
// a tail. A tail after at least 16 bytes that is not one 1/2/4/8-byte move
// is one 16-byte move ending at the last byte, which rewrites some bytes
// already copied with the same values (source and destination are the same
// place or disjoint). Smaller tails go through a general work register.
عرف ألحق_نسخ_ذاكرة_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي,
    الحجم: طبيعي,
    إزاحة_الوجهة: طبيعي,
    إزاحة_المصدر: طبيعي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(الوجهة), اختياري.موجود(المصدر), اختياري.لا_شيء()) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختياري.موجود(س) -> { العمل := س; };
    دع المنجز: متغير طبيعي = 0;
    طالما (الحجم - المنجز >= 32) {
        دع م0: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(المصدر, إزاحة_المصدر + المنجز);
        دع م1: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(المصدر, إزاحة_المصدر + المنجز + 16);
        دع و0: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(الوجهة, إزاحة_الوجهة + المنجز);
        دع و1: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(الوجهة, إزاحة_الوجهة + المنجز + 16);
        طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 0, &م0, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 1, &م1, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 0, &و0, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 1, &و1, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        المنجز := المنجز + 32;
    }
    دع الباقي_الأول: طبيعي = الحجم - المنجز;
    دع ذيل_متداخل: منطقي = الحجم >= 16 && الباقي_الأول > 16
        && الباقي_الأول != 24 && الباقي_الأول != 20 && الباقي_الأول != 18 && الباقي_الأول != 17;
    إذا (الباقي_الأول >= 16) {
        دع م: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(المصدر, إزاحة_المصدر + المنجز);
        دع و: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(الوجهة, إزاحة_الوجهة + المنجز);
        إذا (ذيل_متداخل) {
            // Both 16-byte halves before either store: the second ends at the last byte.
            دع م_الأخير: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(المصدر, إزاحة_المصدر + الحجم - 16);
            دع و_الأخير: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(الوجهة, إزاحة_الوجهة + الحجم - 16);
            طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 0, &م, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 1, &م_الأخير, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 0, &و, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 1, &و_الأخير, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            المنجز := الحجم;
        } وإلا {
            طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 0, &م, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 0, &و, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            المنجز := المنجز + 16;
        };
    };
    دع الباقي_الثاني: طبيعي = الحجم - المنجز;
    إذا (الحجم >= 16 && الباقي_الثاني > 0
        && الباقي_الثاني != 1 && الباقي_الثاني != 2 && الباقي_الثاني != 4 && الباقي_الثاني != 8) {
        دع م: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(المصدر, إزاحة_المصدر + الحجم - 16);
        دع و: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(الوجهة, إزاحة_الوجهة + الحجم - 16);
        طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 0, &م, صواب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_ستة_عشر_بايتا_إكس(البايتات, 0, &و, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        المنجز := الحجم;
    };
    طالما (المنجز < الحجم) {
        دع الباقي: طبيعي = الحجم - المنجز; دع جزء: متغير طبيعي = 1;
        إذا (الباقي >= 8) { جزء := 8; } وإلا إذا (الباقي >= 4) { جزء := 4; } وإلا إذا (الباقي >= 2) { جزء := 2; };
        دع ع_م: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(المصدر, إزاحة_المصدر + المنجز);
        دع ع_و: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_أساس_وإزاحة_إكس(الوجهة, إزاحة_الوجهة + المنجز);
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, العمل, &ع_م, جزء, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, العمل, &ع_و, جزء) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        المنجز := المنجز + جزء;
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تخزين_فوري_ذاكرة_إكس(
    البايتات: &متغير متجه ط8,
    الأساس: معرف_سجل_فعلي,
    الإزاحة: طبيعي,
    القيمة: طبيعي,
    الحجم: طبيعي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(الأساس), اختياري.لا_شيء(), اختياري.لا_شيء()) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()); } | اختياري.موجود(س) -> { العمل := س; };
    طابق ألحق_نقل_فوري_بتات_إكس(البايتات, العمل, القيمة) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع أساس_العنوان: اختياري معرف_سجل_فعلي = اختياري.موجود(الأساس);
    دع فهرس_العنوان: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
    دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
    دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: أساس_العنوان,
        الفهرس: فهرس_العنوان,
        المقياس: 1,
        الإزاحة: الإزاحة_الموقعة
    };
    أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, العمل, &العنوان, الحجم);
}

عرف ألحق_تخصيص_صندوق_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    بداية_الدالة: طبيعي,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    طابق خطة_تخصيص_ذاكرة_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_ذاكرة_غير_متاح()); }
    | اختياري.موجود(الخطة) -> {
        طابق الخطة مع
        | خطة_تخصيص_ذاكرة_هدف.نداء_رمزي(نداء_التخصيص) -> {
            دع حجم_فعلي: متغير طبيعي = الحجم;
            إذا (حجم_فعلي == 0) { حجم_فعلي := 1; };

            دع سجل_الحجم: متغير معرف_سجل_فعلي = { القيمة: 0 };
            طابق حل_سجل_معامل_صحيح_إكس(الهدف, 0) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختياري.موجود(س) -> { سجل_الحجم := س; };

            دع فئة_الناتج: فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
            دع دور_الناتج: دور_سجل_واجهة = دور_سجل_واجهة.ناتج();
            دع حفظ_الناتج: حفظ_سجل_واجهة = حفظ_سجل_واجهة.متطاير_عبر_النداء();
            دع مرجع_الناتج: مرجع_سجل_واجهة = {
                الفئة: فئة_الناتج,
                الفهرس: 0,
                الدور: دور_الناتج,
                الحفظ: حفظ_الناتج
            };
            دع سجل_الناتج: متغير معرف_سجل_فعلي = { القيمة: 0 };
            طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &مرجع_الناتج) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختياري.موجود(س) -> { سجل_الناتج := س; };

            طابق ألحق_نقل_فوري_بتات_إكس(البايتات, سجل_الحجم, حجم_فعلي) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

            دع إطار_حالي: إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الإطار;
            دع تعديل_المكدس: متغير طبيعي = 0;
            طابق تعديل_مكدس_نداء_لحجم_إطار_للهدف(الهدف, إطار_حالي.الحجم_بايت) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                    خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()
                );
            }
            | اختياري.موجود(القيمة) -> { تعديل_المكدس := القيمة; };
            ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, صواب, بداية_الدالة, فك_المكدس);

            ألحق_بايت_إكس(البايتات, 0xE8);
            دع موضع_الإزاحة: طبيعي = الطول(*البايتات) مثل طبيعي;
            ألحق_ط32_إكس(البايتات, 0);

            دع الخدمة: خدمة_تشغيل_هدف = انسخ_خدمة_تشغيل_هدف(نداء_التخصيص.الخدمة);
            دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.خدمة_تشغيل(الخدمة);
            دع الإضافة: عدد = -4;
            دع نوع_الإزاحة: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
                نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
            دع الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
                إزاحة_بايت: موضع_الإزاحة,
                النوع: نوع_الإزاحة,
                الرمز: الرمز,
                الإضافة: الإضافة
            };
            ألحق_نداء_إكس_للمشفّر(النداءات, الإزاحة);


            ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, خطأ, بداية_الدالة, فك_المكدس);
            ألحق_اختبار_سجل_إكس(البايتات, سجل_الناتج);
            // JNZ +2 skips UD2; allocator returns zero only on exhaustion/overflow.
            ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 5);
            أرجع ألحق_نقل_سجل_إكس(البايتات, الوجهة, سجل_الناتج);
        };
    };
}

عرف ألحق_ثابت_نص_إكس(
    البايتات: &متغير متجه ط8,
    الثابت: &ثابت_نص_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    المرفقات: &متغير مرفقات_كائن_مشفرة,
    معرف_الدالة: معرف_دالة_منتقاة,
    بداية_الدالة: طبيعي,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    دع ث: ثابت_نص_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *الثابت;
    دع الموضع: متغير موضع_محلي_إكس_ستة_وثمانون_أربعة_وستون;
    طابق ابحث_موضع_محلي_إكس(الإطار, ث.الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.موضع_محلي_مفقود(ث.الهوية)
        );
    }
    | اختياري.موجود(م) -> { الموضع := م; };

    دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء()) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()
        );
    }
    | اختياري.موجود(س) -> { العمل := س; };

    دع الطول_الدلالي: طبيعي = الطول(ث.البايتات) مثل طبيعي;
    // Like ARM64 and LLVM, immutable literals belong to object rodata.
    // Materializing them through malloc on every execution retained all
    // literals in the Native-generated compiler's runtime heap.
    دع بايتات_الثابت: متغير متجه ط8 = انسخ_بايتات_ثابت_نص_إكس(&ث.البايتات);
    إذا (الطول_الدلالي == 0) { ألحق(بايتات_الثابت, 0); };
    دع معرف_البيانات: معرف_بيانات_ثابتة_كائن = معرف_بيانات_ثابتة_كائن_من(
        معرف_الدالة, ث.الهوية
    );
    دع البيانات: بيانات_ثابتة_كائن = {
        المعرف: معرف_البيانات,
        البيانات: بايتات_الثابت,
        المحاذاة: 1,
        للقراءة_فقط: صواب
    };
    ألحق((*المرفقات).البيانات_الثابتة, البيانات);

    // LEA r64, [RIP+disp32] produces the address of the canonical object
    // constant. The existing x86 object-address relocation handles PC32.
    دع حقل: اختياري معرف_سجل_فعلي = اختياري.موجود(العمل);
    دع لا_قاعدة: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
    ألحق_بايت_إكس(البايتات, ركس_إكس(حقل, لا_قاعدة));
    ألحق_بايت_إكس(البايتات, 0x8D);
    ألحق_بايت_إكس(البايتات, 0x05 + ((العمل.القيمة % 8) * 8));
    دع موضع_الإزاحة: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_ط32_إكس(البايتات, 0);
    دع الرمز: مرجع_رمز_كائن = مرجع_رمز_كائن.بيانات_ثابتة(معرف_البيانات);
    دع الطلب: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
        إزاحة_بايت: موضع_الإزاحة,
        النوع: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.عنوان(),
        الرمز: الرمز,
        الإضافة: -4
    };
    ألحق_نداء_إكس_للمشفّر(النداءات, الطلب);

    دع مؤشر_المكدس: معرف_سجل_فعلي = { القيمة: 4 };
    دع عنوان_البيانات: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
        عنوان_مكدس_إكس(الموضع.إزاحة_بايت + ث.إزاحة_البيانات);
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, العمل, &عنوان_البيانات, 8) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_فوري_ذاكرة_إكس(
        البايتات, مؤشر_المكدس,
        الموضع.إزاحة_بايت + ث.إزاحة_الطول,
        الطول_الدلالي, 8, الهدف
    ) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_فوري_ذاكرة_إكس(
        البايتات, مؤشر_المكدس,
        الموضع.إزاحة_بايت + ث.إزاحة_السعة,
        الطول_الدلالي, 8, الهدف
    ) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف حل_سجل_معامل_صحيح_إكس(الهدف: &واصف_هدف, الفهرس: طبيعي): اختياري معرف_سجل_فعلي {
    دع الفئة: فئة_سجل_واجهة = فئة_سجل_واجهة.عدد_صحيح();
    دع الدور: دور_سجل_واجهة = دور_سجل_واجهة.معامل();
    دع الحفظ: حفظ_سجل_واجهة = حفظ_سجل_واجهة.متطاير_عبر_النداء();
    دع المرجع: مرجع_سجل_واجهة = {
        الفئة: الفئة, الفهرس: الفهرس, الدور: الدور, الحفظ: الحفظ
    };
    أرجع حل_سجل_واجهة_فعلي_للهدف(الهدف, &المرجع);
}

// Extend (إلحاق_نطاق_متجه), in SultanC's internal register convention,
// which is the System V one on every native x86-64 target, Windows included
// (systems/windows/register_rules.sn): the operands go to the first four
// argument registers and stack slots, the source range is checked
// (start + count <= source length, else trap), a buffer too small for
// length + count grows once through the realloc service (a SultanC function,
// called internally) to max(length + count, capacity * growth, minimum), the
// policy's amortized rule (سعة_نمو_المتجه), not to length + count exactly as
// reserve_exact does, and the range is copied with REP MOVSB (RDI, RSI, RCX are
// caller-saved there). A target whose first internal argument register is
// not RDI is refused below rather than mis-encoded.
عرف ألحق_امتداد_متجه_إكس(
    البايتات: &متغير متجه ط8,
    الامتداد: &امتداد_متجه_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    بداية_الدالة: طبيعي,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    دع م: امتداد_متجه_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *الامتداد;
    دع س0: معرف_سجل_فعلي; دع س1: معرف_سجل_فعلي; دع س2: معرف_سجل_فعلي; دع س3: معرف_سجل_فعلي;
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 0) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختياري.موجود(س) -> { س0 := س; };
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 1) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختياري.موجود(س) -> { س1 := س; };
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 2) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختياري.موجود(س) -> { س2 := س; };
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 3) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختياري.موجود(س) -> { س3 := س; };
    // The internal convention passes the first argument in RDI.
    إذا (س0.القيمة != 7 || م.حجم_العنصر == 0 || م.حجم_العنصر > 8) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم());
    };
    دع نقلات_الحجج: متغير متجه نقلة_سجل_نداء_إكس = [];
    دع ن0: نقلة_سجل_نداء_إكس = { المصدر: م.المتجه, الوجهة: س0 };
    دع ن1: نقلة_سجل_نداء_إكس = { المصدر: م.العدد, الوجهة: س1 };
    دع ن2: نقلة_سجل_نداء_إكس = { المصدر: م.المصدر, الوجهة: س2 };
    دع ن3: نقلة_سجل_نداء_إكس = { المصدر: م.البداية, الوجهة: س3 };
    ألحق(نقلات_الحجج, ن0); ألحق(نقلات_الحجج, ن1); ألحق(نقلات_الحجج, ن2); ألحق(نقلات_الحجج, ن3);
    دع سجل_عمل_النداء: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق سجل_عمل_نقل_نداء_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); }
    | اختياري.موجود(السجل) -> { سجل_عمل_النداء := السجل; };
    طابق ألحق_نقلات_نداء_إكس(البايتات, &نقلات_الحجج, سجل_عمل_النداء) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع ركس_أ: معرف_سجل_فعلي = { القيمة: 0 };
    دع ركس_ج: معرف_سجل_فعلي = { القيمة: 1 };
    دع ركس_د: معرف_سجل_فعلي = { القيمة: 2 };
    دع ركس_مص: معرف_سجل_فعلي = { القيمة: 6 };
    دع ركس_وج: معرف_سجل_فعلي = { القيمة: 7 };
    دع سجل_ب: معرف_سجل_فعلي = { القيمة: 10 };
    دع سجل_ج: معرف_سجل_فعلي = { القيمة: 11 };
    // Slots: vector, count, grown capacity, source, start.
    دع الإطار_الحالي: إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الإطار;
    دع تعديل_المكدس: متغير طبيعي = 0;
    طابق تعديل_مكدس_نداء_مع_حجج_للهدف(الهدف, الإطار_الحالي.الحجم_بايت, 48) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); }
    | اختياري.موجود(القيمة) -> { تعديل_المكدس := القيمة; };
    ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, صواب, بداية_الدالة, فك_المكدس);
    دع خانة_المتجه: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(0);
    دع خانة_العدد: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(8);
    دع خانة_السعة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(16);
    دع خانة_المصدر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(24);
    دع خانة_البداية: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(32);
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س0, &خانة_المتجه, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س1, &خانة_العدد, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س2, &خانة_المصدر, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س3, &خانة_البداية, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    // The source range: r10 = start + count (a carry traps) <= source length.
    دع طول_المصدر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س2, م.إزاحة_الطول);
    طابق ألحق_نقل_سجل_إكس(البايتات, سجل_ب, س3) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, سجل_ب, س1, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 3);
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &طول_المصدر, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_مقارنة_بعرض_إكس(البايتات, سجل_ب, ركس_أ, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 6);
    // Reserve: rax = length + count (a carry traps); grow when above capacity.
    دع عنوان_الطول: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س0, م.إزاحة_الطول);
    دع عنوان_السعة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س0, م.إزاحة_السعة);
    دع عنوان_البيانات: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(س0, م.إزاحة_البيانات);
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_الطول, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_أ, س1, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 3);
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_ب, &عنوان_السعة, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_مقارنة_بعرض_إكس(البايتات, ركس_أ, سجل_ب, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_بايت_إكس(البايتات, 0x0F); ألحق_بايت_إكس(البايتات, 0x86);
    دع موضع_فرع_الكفاية: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_ط32_إكس(البايتات, 0);
    // Grow: r10 = max(capacity * growth (an overflow traps), minimum), then
    // rax = max(rax, r10), as append grows.
    دع عامل_النمو: متغير طبيعي = م.عامل_النمو;
    إذا (عامل_النمو < 2) { عامل_النمو := 2; };
    دع السعة_الدنيا: متغير طبيعي = م.السعة_الدنيا;
    إذا (السعة_الدنيا < 1) { السعة_الدنيا := 1; };
    طابق ألحق_ضرب_فوري_إلحاق_إكس(البايتات, سجل_ب, عامل_النمو) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_فوري_بتات_إكس(البايتات, سجل_ج, السعة_الدنيا) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_مقارنة_بعرض_إكس(البايتات, سجل_ب, سجل_ج, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    // JAE rel8 over the minimum-capacity move.
    ألحق_بايت_إكس(البايتات, 0x73);
    دع موضع_فرع_الحد: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_بايت_إكس(البايتات, 0);
    طابق ألحق_نقل_سجل_إكس(البايتات, سجل_ب, سجل_ج) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع نهاية_الحد: طبيعي = الطول(*البايتات) مثل طبيعي;
    (*البايتات)[موضع_فرع_الحد] := (نهاية_الحد - (موضع_فرع_الحد + 1)) مثل ط8;
    طابق ألحق_مقارنة_بعرض_إكس(البايتات, سجل_ب, ركس_أ, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    // JBE rel8 over the move: length + count is already the larger.
    ألحق_بايت_إكس(البايتات, 0x76);
    دع موضع_فرع_المطلوب: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_بايت_إكس(البايتات, 0);
    طابق ألحق_نقل_سجل_إكس(البايتات, ركس_أ, سجل_ب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع نهاية_المطلوب: طبيعي = الطول(*البايتات) مثل طبيعي;
    (*البايتات)[موضع_فرع_المطلوب] := (نهاية_المطلوب - (موضع_فرع_المطلوب + 1)) مثل ط8;
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &خانة_السعة, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_سجل_إكس(البايتات, س1, ركس_أ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_ضرب_فوري_إلحاق_إكس(البايتات, س1, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س0, &عنوان_البيانات, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    ألحق_بايت_إكس(البايتات, 0xE8);
    دع موضع_إزاحة_الحجز: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_ط32_إكس(البايتات, 0);
    دع رمز_الحجز: مرجع_رمز_كائن = مرجع_رمز_كائن.خدمة_تشغيل(خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة());
    دع نوع_إزاحة_الحجز: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون = نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء();
    دع إزاحة_الحجز: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
        إزاحة_بايت: موضع_إزاحة_الحجز, النوع: نوع_إزاحة_الحجز, الرمز: رمز_الحجز, الإضافة: -4
    };
    ألحق_نداء_إكس_للمشفّر(النداءات, إزاحة_الحجز);
    // A null result means allocation failure: trap, never continue.
    ألحق_اختبار_سجل_إكس(البايتات, ركس_أ);
    ألحق_حارس_شرط_لا_فخ_قصير_إكس(البايتات, 5);
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س0, &خانة_المتجه, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_أ, &عنوان_البيانات, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_ب, &خانة_السعة, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_ب, &عنوان_السعة, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع نهاية_الحجز: طبيعي = الطول(*البايتات) مثل طبيعي;
    اكتب_ط32_إكس(البايتات, موضع_فرع_الكفاية, نهاية_الحجز - (موضع_فرع_الكفاية + 4));
    // The copy: rdi = data + length * size, rsi = source data + start * size,
    // rcx = count * size; then length += count.
    دع طول_الهدف: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(ركس_أ, م.إزاحة_الطول);
    دع بيانات_الهدف: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(ركس_أ, م.إزاحة_البيانات);
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &خانة_المتجه, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_ب, &طول_الهدف, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, سجل_ج, &خانة_العدد, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_سجل_إكس(البايتات, ركس_د, سجل_ب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_د, سجل_ج, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تخزين_ذاكرة_إكس(البايتات, ركس_د, &طول_الهدف, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_وج, &بيانات_الهدف, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_ضرب_فوري_إلحاق_إكس(البايتات, سجل_ب, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_وج, سجل_ب, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    دع بيانات_المصدر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_سجل_بإزاحة_إكس(ركس_أ, م.إزاحة_البيانات);
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &خانة_المصدر, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_مص, &بيانات_المصدر, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_تحميل_ذاكرة_إكس(البايتات, ركس_أ, &خانة_البداية, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_ضرب_فوري_إلحاق_إكس(البايتات, ركس_أ, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, ركس_مص, ركس_أ, 0x00, 0x01) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_نقل_سجل_إكس(البايتات, ركس_ج, سجل_ج) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    طابق ألحق_ضرب_فوري_إلحاق_إكس(البايتات, ركس_ج, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
    // REP MOVSB.
    ألحق_بايت_إكس(البايتات, 0xF3); ألحق_بايت_إكس(البايتات, 0xA4);
    ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, خطأ, بداية_الدالة, فك_المكدس);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_إلحاق_متجه_إكس(
    البايتات: &متغير متجه ط8,
    الإلحاق: &إلحاق_متجه_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    بداية_الدالة: طبيعي,
    فك_المكدس: &متغير متتبع_فك_المكدس
): نتيجة_دفعة_ترميز_إكس {
    دع م: إلحاق_متجه_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *الإلحاق;
    إذا (!(م.حجم_الطول == 8 && م.حجم_السعة == 8)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(م.حجم_الطول)
        );
    };
    دع س0: معرف_سجل_فعلي; دع س1: معرف_سجل_فعلي; دع س2: معرف_سجل_فعلي;
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 0) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختياري.موجود(س) -> { س0 := س; };
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 1) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختياري.موجود(س) -> { س1 := س; };
    طابق حل_سجل_معامل_صحيح_إكس(الهدف, 2) مع | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); } | اختياري.موجود(س) -> { س2 := س; };

    // vector/element sources can arrive in ABI destinations or reserved spill-work registers.
    // Prepare the first two call arguments as one parallel move set so moving one source
    // never destroys the other before it has been captured.
    دع نقلات_الحجج: متغير متجه نقلة_سجل_نداء_إكس = [];
    دع نقلة_المتجه: نقلة_سجل_نداء_إكس = { المصدر: م.المتجه, الوجهة: س0 };
    دع نقلة_العنصر: نقلة_سجل_نداء_إكس = { المصدر: م.العنصر, الوجهة: س1 };
    ألحق(نقلات_الحجج, نقلة_المتجه);
    ألحق(نقلات_الحجج, نقلة_العنصر);
    دع سجل_عمل_النداء: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق سجل_عمل_نقل_نداء_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم()); }
    | اختياري.موجود(السجل) -> { سجل_عمل_النداء := السجل; };
    طابق ألحق_نقلات_نداء_إكس(البايتات, &نقلات_الحجج, سجل_عمل_النداء) مع
    | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); }
    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };

