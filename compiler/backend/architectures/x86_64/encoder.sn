استورد std.text.from_bytes;
استورد compiler.backend.architectures.x86_64.encoded_code;
استورد compiler.backend.architectures.x86_64.allocated_code;
استورد compiler.backend.architectures.x86_64.instruction_model;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.division_by_constant;
استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.call_frame_information;
استورد compiler.backend.target.target_model;
استورد compiler.backend.abi.abi_model;
استورد compiler.backend.target.register_query_context;
استورد compiler.backend.target.target_abi_resolution;
استورد compiler.backend.target.runtime_query_context;
استورد compiler.backend.target.runtime_allocation_model;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.backend.object.object_reference_model;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_runtime_abi;

نوع تثبيت_فرع_إكس_مؤجل = {
    إزاحة_الحقل: طبيعي,
    بعد_التعليمة: طبيعي,
    الهدف: معرف_كتلة_منتقاة
};

نوع موضع_كتلة_إكس = {
    المعرف: معرف_كتلة_منتقاة,
    إزاحة_بايت: طبيعي
};

نوع نقلة_سجل_نداء_إكس = {
    المصدر: معرف_سجل_فعلي,
    الوجهة: معرف_سجل_فعلي
};

عام نوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون =
    | هدف_غير_صالح بنوع معرف_هدف
    | سجل_فعلي_غير_صالح بنوع معرف_سجل_فعلي
    | دالة_مكررة بنوع معرف_دالة_منتقاة
    | كتلة_مكررة بنوع معرف_كتلة_منتقاة
    | هدف_كتلة_مفقود بنوع معرف_كتلة_منتقاة
    | فرع_خارج_مدى_نسبي_32 بنوع معرف_كتلة_منتقاة
    | سجل_واجهة_غير_مدعوم
    | عنوان_ذاكرة_غير_مدعوم
    | عرض_ذاكرة_غير_مدعوم بنوع طبيعي
    | نقل_حافة_غير_قابل_للترميز
    | سجلات_عمل_غير_كافية
    | موضع_محلي_مفقود بنوع طبيعي
    | تخصيص_ذاكرة_غير_متاح
    | نداء_تشغيل_خارج_المدى
    | مزود_خروج_عملية_مفقود
;

عام نوع نتيجة_ترميز_إكس_ستة_وثمانون_أربعة_وستون =
    | نجح بنوع شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة
    | خطأ بنوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
;

عام نوع نتيجة_دفعة_ترميز_إكس =
    | نجحت
    | خطأ بنوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
;

عام نوع نتيجة_ترميز_دالة_إكس =
    | نجحت
    | خطأ بنوع خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
;

نوع نتيجة_إزاحة_نسبية_32 =
    | نجحت بنوع طبيعي
    | خارج_المدى
;

عرف ألحق_بايت_إكس(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق(*البايتات, (القيمة % 256) مثل ط8);
}

عرف ألحق_فرع_إكس_للمشفّر(
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    التثبيت: تثبيت_فرع_إكس_مؤجل
): فراغ {
    ألحق(*الفروع, التثبيت);
}

عرف ألحق_نداء_إكس_للمشفّر(
    النداءات: &متغير متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    الإزاحة: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    ألحق(*النداءات, الإزاحة);
}

عرف ألحق_فرع_محلول_إكس_للمشفّر(
    المحلولة: &متغير متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون,
    المثبت: تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    ألحق(*المحلولة, المثبت);
}

// Merge encoded intervals only when every debug/provenance identity matches.
// The canonical DWARF consumer observes the same contiguous address coverage,
// while the encoder retains one interval rather than one record per instruction.
عرف موقعا_تصحيح_اختياريان_متساويان(
    الأول: اختياري معرف_موقع_تصحيح,
    الثاني: اختياري معرف_موقع_تصحيح
): منطقي {
    طابق الأول مع
    | اختياري.لا_شيء -> {
        طابق الثاني مع
        | اختياري.لا_شيء -> { أرجع صواب; }
        | اختياري.موجود(_) -> { أرجع خطأ; };
    }
    | اختياري.موجود(أ) -> {
        طابق الثاني مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(ب) -> { أرجع أ.القيمة == ب.القيمة; };
    };
}

عرف نطاقا_تصحيح_اختياريان_متساويان(
    الأول: اختياري معرف_نطاق_تصحيح,
    الثاني: اختياري معرف_نطاق_تصحيح
): منطقي {
    طابق الأول مع
    | اختياري.لا_شيء -> {
        طابق الثاني مع
        | اختياري.لا_شيء -> { أرجع صواب; }
        | اختياري.موجود(_) -> { أرجع خطأ; };
    }
    | اختياري.موجود(أ) -> {
        طابق الثاني مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(ب) -> { أرجع أ.القيمة == ب.القيمة; };
    };
}

عرف ألحق_أصل_آلة_إكس_للمشفّر(
    الأصول: &متغير متجه مدى_شفرة_آلة_بأصل,
    المدى: مدى_شفرة_آلة_بأصل
): فراغ {
    دع العدد: طبيعي = الطول(*الأصول) مثل طبيعي;
    لو (العدد > 0) {
        دع الأخير: &مدى_شفرة_آلة_بأصل = &(*الأصول)[العدد - 1];
        لو (معرفا_دالة_منتقاة_متساويان((*الأخير).الدالة, المدى.الدالة)
            && (*الأخير).إزاحة_بايت + (*الأخير).حجم_بايت == المدى.إزاحة_بايت
            && (*الأخير).الأصل.القيمة == المدى.الأصل.القيمة
            && موقعا_تصحيح_اختياريان_متساويان((*الأخير).موقع_التصحيح, المدى.موقع_التصحيح)
            && نطاقا_تصحيح_اختياريان_متساويان((*الأخير).نطاق_التصحيح, المدى.نطاق_التصحيح)) {
            (*الأصول)[العدد - 1].حجم_بايت := (*الأخير).حجم_بايت + المدى.حجم_بايت;
            أرجع;
        };
    };
    ألحق(*الأصول, المدى);
}

عرف ألحق_موضع_دالة_إكس_للمشفّر(
    الدوال: &متغير متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    الموضع: موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة
): فراغ {
    ألحق(*الدوال, الموضع);
}

عرف ألحق_ط32_إكس(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        ألحق_بايت_إكس(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف ألحق_ط64_إكس(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        ألحق_بايت_إكس(البايتات, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف اكتب_ط32_إكس(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): فراغ {

    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        دع الفهرس: طبيعي = الموضع + ف;
        (*البايتات)[الفهرس] := (الباقي % 256) مثل ط8;
        الباقي := الباقي / 256;
        ف := ف + 1;
    }

}

عرف سجل_إكس_قابل_للترميز(السجل: معرف_سجل_فعلي): منطقي {
    أرجع السجل.القيمة < 16;
}

عرف ركس_إكس(
    سجل_حقل: اختياري معرف_سجل_فعلي,
    سجل_قاعدة: اختياري معرف_سجل_فعلي
): طبيعي {
    دع القيمة: متغير طبيعي = 0x48;
    طابق سجل_حقل مع
    | اختياري.موجود(السجل) -> {
        لو (السجل.القيمة >= 8) {
            القيمة := القيمة + 4;
        };
    }
    | اختياري.لا_شيء -> { };
    طابق سجل_قاعدة مع
    | اختياري.موجود(السجل) -> {
        لو (السجل.القيمة >= 8) {
            القيمة := القيمة + 1;
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع القيمة;
}

عرف مود_آر_إم_سجلين(حقل: معرف_سجل_فعلي, قاعدة: معرف_سجل_فعلي): طبيعي {
    أرجع 0xC0 + ((حقل.القيمة % 8) * 8) + (قاعدة.القيمة % 8);
}

عرف بتات_مقياس_إكس(المقياس: طبيعي): اختياري طبيعي {
    لو (المقياس == 1) { أرجع اختياري.موجود(0); };
    لو (المقياس == 2) { أرجع اختياري.موجود(1); };
    لو (المقياس == 4) { أرجع اختياري.موجود(2); };
    لو (المقياس == 8) { أرجع اختياري.موجود(3); };
    أرجع اختياري.لا_شيء();
}

عرف ركس_ذاكرة_إكس(
    أربعة_وستون: منطقي,
    سجل_حقل: معرف_سجل_فعلي,
    الفهرس: اختياري معرف_سجل_فعلي,
    الأساس: معرف_سجل_فعلي
): طبيعي {
    دع القيمة: متغير طبيعي = 0x40;
    لو (أربعة_وستون) { القيمة := القيمة + 8; };
    لو (سجل_حقل.القيمة >= 8) { القيمة := القيمة + 4; };
    طابق الفهرس مع
    | اختياري.موجود(السجل) -> {
        لو (السجل.القيمة >= 8) { القيمة := القيمة + 2; };
    }
    | اختياري.لا_شيء -> { };
    لو (الأساس.القيمة >= 8) { القيمة := القيمة + 1; };
    أرجع القيمة;
}

عرف ألحق_معامل_ذاكرة_إكس(
    البايتات: &متغير متجه ط8,
    سجل_الحقل: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): نتيجة_دفعة_ترميز_إكس {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع الأساس: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق ع.الأساس مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختياري.موجود(السجل) -> { الأساس := السجل; };
    لو (!سجل_إكس_قابل_للترميز(سجل_الحقل) || !سجل_إكس_قابل_للترميز(الأساس)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    };
    لو (ع.الإزاحة < -2147483648 || ع.الإزاحة > 2147483647) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    };
    دع حقل_الفهرس: متغير طبيعي = 4;
    طابق ع.الفهرس مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الفهرس) -> {
        لو (!سجل_إكس_قابل_للترميز(الفهرس)) {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
            );
        };
        حقل_الفهرس := الفهرس.القيمة % 8;
    };
    دع بتات_المقياس: متغير طبيعي = 0;
    طابق بتات_مقياس_إكس(ع.المقياس) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختياري.موجود(القيمة) -> { بتات_المقياس := القيمة; };
    // Mod=10 + SIB + disp32 avoids the RBP/R13 zero-displacement special case.
    ألحق_بايت_إكس(البايتات, 0x84 + ((سجل_الحقل.القيمة % 8) * 8));
    ألحق_بايت_إكس(
        البايتات,
        (بتات_المقياس * 64) + (حقل_الفهرس * 8) + (الأساس.القيمة % 8)
    );
    ألحق_ط32_إكس(البايتات, ع.الإزاحة مثل طبيعي);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تكوين_عنوان_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): نتيجة_دفعة_ترميز_إكس {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    طابق ع.الأساس مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختياري.موجود(الأساس) -> {
        ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, ع.الفهرس, الأساس));
    };
    ألحق_بايت_إكس(البايتات, 0x8D);
    أرجع ألحق_معامل_ذاكرة_إكس(البايتات, الوجهة, العنوان);
}

عرف ألحق_تحميل_ذاكرة_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الحجم: طبيعي,
    بإشارة: منطقي
): نتيجة_دفعة_ترميز_إكس {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع الأساس: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق ع.الأساس مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختياري.موجود(السجل) -> { الأساس := السجل; };
    لو (!(الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم)
        );
    };
    لو (الحجم == 1 || الحجم == 2) {
        ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, ع.الفهرس, الأساس));
        ألحق_بايت_إكس(البايتات, 0x0F);
        لو (الحجم == 1) {
            لو (بإشارة) { ألحق_بايت_إكس(البايتات, 0xBE); }
            وإلا { ألحق_بايت_إكس(البايتات, 0xB6); };
        } وإلا {
            لو (بإشارة) { ألحق_بايت_إكس(البايتات, 0xBF); }
            وإلا { ألحق_بايت_إكس(البايتات, 0xB7); };
        };
    } وإلا لو (الحجم == 4) {
        لو (بإشارة) {
            ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, ع.الفهرس, الأساس));
            ألحق_بايت_إكس(البايتات, 0x63);
        } وإلا {
            ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(خطأ, الوجهة, ع.الفهرس, الأساس));
            ألحق_بايت_إكس(البايتات, 0x8B);
        };
    } وإلا {
        ألحق_بايت_إكس(البايتات, ركس_ذاكرة_إكس(صواب, الوجهة, ع.الفهرس, الأساس));
        ألحق_بايت_إكس(البايتات, 0x8B);
    };
    أرجع ألحق_معامل_ذاكرة_إكس(البايتات, الوجهة, العنوان);
}

عرف ألحق_تخزين_ذاكرة_إكس(
    البايتات: &متغير متجه ط8,
    المصدر: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الحجم: طبيعي
): نتيجة_دفعة_ترميز_إكس {
    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع الأساس: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق ع.الأساس مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم()
        );
    }
    | اختياري.موجود(السجل) -> { الأساس := السجل; };
    لو (!(الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم)
        );
    };
    لو (الحجم == 2) { ألحق_بايت_إكس(البايتات, 0x66); };
    ألحق_بايت_إكس(
        البايتات,
        ركس_ذاكرة_إكس(الحجم == 8, المصدر, ع.الفهرس, الأساس)
    );
    لو (الحجم == 1) { ألحق_بايت_إكس(البايتات, 0x88); }
    وإلا { ألحق_بايت_إكس(البايتات, 0x89); };
    أرجع ألحق_معامل_ذاكرة_إكس(البايتات, المصدر, العنوان);
}

عرف ألحق_حارس_فخ_تجاوز_إكس(
    البايتات: &متغير متجه ط8,
    الصنف: صنف_فخ_تجاوز_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    // JNO/JNC يتجاوزان UD2 بطول بايتين عند عدم وقوع التجاوز.
    طابق الصنف مع
    | صنف_فخ_تجاوز_إكس_ستة_وثمانون_أربعة_وستون.موقع -> {
        ألحق_بايت_إكس(البايتات, 0x71);
    }
    | صنف_فخ_تجاوز_إكس_ستة_وثمانون_أربعة_وستون.طبيعي -> {
        ألحق_بايت_إكس(البايتات, 0x73);
    };
    ألحق_بايت_إكس(البايتات, 2);
    ألحق_بايت_إكس(البايتات, 0x0F);
    ألحق_بايت_إكس(البايتات, 0x0B);
}

عرف ألحق_نقل_سجل_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    المصدر: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    لو (!سجل_إكس_قابل_للترميز(الوجهة)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(الوجهة)
        );
    };
    لو (!سجل_إكس_قابل_للترميز(المصدر)) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(المصدر)
        );
    };
    لو (معرفا_سجل_فعلي_متساويان(الوجهة, المصدر)) {
        أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
    };
    ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.موجود(المصدر), اختياري.موجود(الوجهة)));
    ألحق_بايت_إكس(البايتات, 0x89);
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(المصدر, الوجهة));
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف عنوان_انسكاب_إكس(الموقع: &موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون): عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    دع م: موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الموقع;
    دع مؤشر_المكدس: معرف_سجل_فعلي = { القيمة: 4 };
    دع الأساس: اختياري معرف_سجل_فعلي = اختياري.موجود(مؤشر_المكدس);
    دع الفهرس: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
    دع الإزاحة: عدد = م.إزاحة_بايت مثل عدد;
    دع الناتج: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: الأساس,
        الفهرس: الفهرس,
        المقياس: 1,
        الإزاحة: الإزاحة
    };
    أرجع الناتج;
}

عرف عنوان_مكدس_إكس(الإزاحة: طبيعي): عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    دع مؤشر_المكدس: معرف_سجل_فعلي = { القيمة: 4 };
    دع الأساس: اختياري معرف_سجل_فعلي = اختياري.موجود(مؤشر_المكدس);
    دع الفهرس: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
    دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
    دع الناتج: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: الأساس,
        الفهرس: الفهرس,
        المقياس: 1,
        الإزاحة: الإزاحة_الموقعة
    };
    أرجع الناتج;
}

عرف ألحق_تعديل_مؤشر_المكدس_إكس(
    البايتات: &متغير متجه ط8,
    الحجم: طبيعي,
    طرح: منطقي
): فراغ {
    // ADD/SUB r64, imm32 يمدد imm32 بإشارة. قسّم أي تعديل أكبر من INT32_MAX
    // بدلا من إسقاط البتات العليا؛ المحاذاة المطلوبة تتحقق بعد اكتمال كل الأجزاء.
    دع الباقي: متغير طبيعي = الحجم;
    طالما (الباقي > 0) {
        دع الجزء: متغير طبيعي = الباقي;
        لو (الجزء > 2147483647) { الجزء := 2147483647; };
        ألحق_بايت_إكس(البايتات, 0x48);
        لو (الجزء <= 127) {
            ألحق_بايت_إكس(البايتات, 0x83);
            لو (طرح) { ألحق_بايت_إكس(البايتات, 0xEC); }
            وإلا { ألحق_بايت_إكس(البايتات, 0xC4); };
            ألحق_بايت_إكس(البايتات, الجزء);
        } وإلا {
            ألحق_بايت_إكس(البايتات, 0x81);
            لو (طرح) { ألحق_بايت_إكس(البايتات, 0xEC); }
            وإلا { ألحق_بايت_إكس(البايتات, 0xC4); };
            ألحق_ط32_إكس(البايتات, الجزء);
        };
        الباقي := الباقي - الجزء;
    }
}

عرف ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(
    البايتات: &متغير متجه ط8,
    الحجم: طبيعي,
    طرح: منطقي,
    بداية_الدالة: طبيعي,
    فك_المكدس: &متغير متتبع_فك_المكدس
): فراغ {
    دع الباقي: متغير طبيعي = الحجم;
    طالما (الباقي > 0) {
        دع الجزء: متغير طبيعي = الباقي;
        لو (الجزء > 2147483647) { الجزء := 2147483647; };
        ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, الجزء, طرح);
        دع عدد_البايتات_بعد_التعديل: طبيعي = الطول(*البايتات) مثل طبيعي;
        دع إزاحة_بعد_التعديل: طبيعي = عدد_البايتات_بعد_التعديل - بداية_الدالة;
        لو (طرح) { سجل_طرح_مكدس_فك_المكدس(فك_المكدس, إزاحة_بعد_التعديل, الجزء); }
        وإلا { سجل_إضافة_مكدس_فك_المكدس(فك_المكدس, إزاحة_بعد_التعديل, الجزء); };
        الباقي := الباقي - الجزء;
    }
}

عرف ألحق_تحميل_انسكاب_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    الموقع: &موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): نتيجة_دفعة_ترميز_إكس {
    دع م: موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الموقع;
    لو (م.إزاحة_بايت <= 2147483647) {
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_انسكاب_إكس(&م);
        أرجع ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, &العنوان, 8, خطأ);
    };
    // disp32 موقّع. للوصول إلى موضع انسكاب أبعد، حرّك RSP مؤقتا إلى الموضع
    // نفسه ثم حمّل من [RSP] وأعد RSP مباشرة؛ لا نسرق سجلا حيا كسجل عنوان.
    ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, م.إزاحة_بايت, خطأ);
    دع العنوان_القريب: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(0);
    دع النتيجة: نتيجة_دفعة_ترميز_إكس = ألحق_تحميل_ذاكرة_إكس(
        البايتات, الوجهة, &العنوان_القريب, 8, خطأ
    );
    ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, م.إزاحة_بايت, صواب);
    أرجع النتيجة;
}

عرف ألحق_تخزين_انسكاب_إكس(
    البايتات: &متغير متجه ط8,
    الموقع: &موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون,
    المصدر: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    دع م: موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = *الموقع;
    لو (م.إزاحة_بايت <= 2147483647) {
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_انسكاب_إكس(&م);
        أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, المصدر, &العنوان, 8);
    };
    ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, م.إزاحة_بايت, خطأ);
    دع العنوان_القريب: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(0);
    دع النتيجة: نتيجة_دفعة_ترميز_إكس = ألحق_تخزين_ذاكرة_إكس(
        البايتات, المصدر, &العنوان_القريب, 8
    );
    ألحق_تعديل_مؤشر_المكدس_إكس(البايتات, م.إزاحة_بايت, صواب);
    أرجع النتيجة;
}

عرف عنوان_سجل_بإزاحة_إكس(
    السجل: معرف_سجل_فعلي,
    الإزاحة: طبيعي
): عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    دع الأساس: اختياري معرف_سجل_فعلي = اختياري.موجود(السجل);
    دع الفهرس: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
    دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
    دع الناتج: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = {
        الأساس: الأساس,
        الفهرس: الفهرس,
        المقياس: 1,
        الإزاحة: الإزاحة_الموقعة
    };
    أرجع الناتج;
}

عرف حجم_حجج_مكدس_نداء_إكس(
    الخطة: &نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): طبيعي {
    دع خ: نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *الخطة;
    دع النهاية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(خ.الحجج) مثل طبيعي)) {
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(خ.الحجج[ف].المواضع) مثل طبيعي)) {
            طابق خ.الحجج[ف].المواضع[ج] مع
            | موضع_جزء_واجهة.مكدس(الموضع) -> {
                دع حد: طبيعي = الموضع.الإزاحة + الموضع.الحجم;
                لو (حد > النهاية) { النهاية := حد; };
            }
            | _ -> { };
            ج := ج + 1;
        }
        ف := ف + 1;
    }
    أرجع النهاية;
}

عرف حجم_جزء_تجميع_واجهة_إكس(الحجم: طبيعي, الفهرس: طبيعي): طبيعي {
    دع البداية: طبيعي = الفهرس * 8;
    لو (البداية >= الحجم) { أرجع 0; };
    دع الباقي: طبيعي = الحجم - البداية;
    لو (الباقي > 8) { أرجع 8; };
    أرجع الباقي;
}

عرف عدد_عناوين_تجميع_نداء_إكس(
    الخطة: &نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): طبيعي {
    دع خ: نداء_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *الخطة;
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(خ.الحجج) مثل طبيعي)) {
        لو (خ.الحجج[ف].تجميعي) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    طابق خ.الناتج مع
    | اختياري.موجود(الناتج) -> { لو (الناتج.تجميعي) { العدد := العدد + 1; }; }
    | اختياري.لا_شيء -> { };
    أرجع العدد;
}


عرف عدل_مصدر_نداء_بعد_خفض_المكدس_إكس(
    المصدر: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    تعديل_المكدس: طبيعي
): موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص {
    طابق *المصدر مع
    | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(السجل) -> {
        أرجع موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(السجل);
    }
    | موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.انسكاب(الموضع) -> {
        دع الإزاحة_المعدلة: طبيعي = الموضع.إزاحة_بايت + تعديل_المكدس;
        دع المعدل: موضع_انسكاب_إكس_ستة_وثمانون_أربعة_وستون = {
            السجل: الموضع.السجل,
            الفهرس: الموضع.الفهرس,
            إزاحة_بايت: الإزاحة_المعدلة,
            الحجم: الموضع.الحجم,
            المحاذاة: الموضع.المحاذاة
        };
        أرجع موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.انسكاب(المعدل);
    };
}

عرف ألحق_تخزين_حجة_مكدس_نداء_إكس(
    البايتات: &متغير متجه ط8,
    المصدر: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الموضع: &موضع_مكدس_واجهة,
    تعديل_المكدس: طبيعي,
    سجل_العمل: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    دع م: موضع_مكدس_واجهة = *الموضع;
    دع عنوان_الوجهة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(م.الإزاحة);
    دع المصدر_المعدل: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
        عدل_مصدر_نداء_بعد_خفض_المكدس_إكس(المصدر, تعديل_المكدس);
    طابق سجل_موقع_قيمة_إكس(&المصدر_المعدل) مع
    | اختياري.موجود(السجل) -> {
        أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, السجل, &عنوان_الوجهة, 8);
    }
    | اختياري.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_إكس(&المصدر_المعدل) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()
            );
        }
        | اختياري.موجود(موضع_المصدر) -> {
            طابق ألحق_تحميل_انسكاب_إكس(البايتات, سجل_العمل, &موضع_المصدر) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_العمل, &عنوان_الوجهة, 8);
        };
    };
}

عرف ألحق_حفظ_موقع_في_مكدس_نداء_إكس(
    البايتات: &متغير متجه ط8,
    المصدر: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الإزاحة: طبيعي,
    تعديل_المكدس: طبيعي,
    سجل_العمل: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    دع العنوان_الوجهة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = عنوان_مكدس_إكس(الإزاحة);
    دع المصدر_المعدل: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص =
        عدل_مصدر_نداء_بعد_خفض_المكدس_إكس(المصدر, تعديل_المكدس);
    طابق سجل_موقع_قيمة_إكس(&المصدر_المعدل) مع
    | اختياري.موجود(السجل) -> {
        أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, السجل, &العنوان_الوجهة, 8);
    }
    | اختياري.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_إكس(&المصدر_المعدل) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
                خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()
            );
        }
        | اختياري.موجود(موضع_المصدر) -> {
            طابق ألحق_تحميل_انسكاب_إكس(البايتات, سجل_العمل, &موضع_المصدر) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            أرجع ألحق_تخزين_ذاكرة_إكس(البايتات, سجل_العمل, &العنوان_الوجهة, 8);
        };
    };
}

عرف ألحق_نقل_موقع_إكس(
    البايتات: &متغير متجه ط8,
    المصدر: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الوجهة: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    سجل_عمل: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    لو (موقعا_قيمة_إكس_متساويان(المصدر, الوجهة)) { أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); };
    طابق سجل_موقع_قيمة_إكس(المصدر) مع
    | اختياري.موجود(سجل_المصدر) -> {
        طابق سجل_موقع_قيمة_إكس(الوجهة) مع
        | اختياري.موجود(سجل_الوجهة) -> { أرجع ألحق_نقل_سجل_إكس(البايتات, سجل_الوجهة, سجل_المصدر); }
        | اختياري.لا_شيء -> {
            طابق انسكاب_موقع_قيمة_إكس(الوجهة) مع
            | اختياري.موجود(موضع_الوجهة) -> {
                أرجع ألحق_تخزين_انسكاب_إكس(البايتات, &موضع_الوجهة, سجل_المصدر);
            }
            | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); };
        };
    }
    | اختياري.لا_شيء -> {
        طابق انسكاب_موقع_قيمة_إكس(المصدر) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); }
        | اختياري.موجود(موضع_المصدر) -> {
            طابق سجل_موقع_قيمة_إكس(الوجهة) مع
            | اختياري.موجود(سجل_الوجهة) -> { أرجع ألحق_تحميل_انسكاب_إكس(البايتات, سجل_الوجهة, &موضع_المصدر); }
            | اختياري.لا_شيء -> {
                طابق انسكاب_موقع_قيمة_إكس(الوجهة) مع
                | اختياري.لا_شيء -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); }
                | اختياري.موجود(موضع_الوجهة) -> {
                    طابق ألحق_تحميل_انسكاب_إكس(البايتات, سجل_عمل, &موضع_المصدر) مع
                    | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                    | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                    أرجع ألحق_تخزين_انسكاب_إكس(البايتات, &موضع_الوجهة, سجل_عمل);
                };
            };
        };
    };
}

عرف وجهة_مستخدمة_كمصدر_إكس(
    النقلات: &متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    النشطة: &متجه منطقي,
    الفهرس: طبيعي
): منطقي {
    دع ن: متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *النقلات;
    دع ح: متجه منطقي = *النشطة;
    دع الوجهة: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = ن[الفهرس].الوجهة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ن) مثل طبيعي)) {
        لو (ح[ف] && ف != الفهرس && موقعا_قيمة_إكس_متساويان(&الوجهة, &ن[ف].المصدر)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف استبدل_مصدر_موقع_إكس(
    النقلات: &متغير متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    النشطة: &متجه منطقي,
    القديم: &موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الجديد: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص
): فراغ {

    دع ح: متجه منطقي = *النشطة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النقلات) مثل طبيعي)) {
        لو (ح[ف] && موقعا_قيمة_إكس_متساويان(&(*النقلات)[ف].المصدر, القديم)) { (*النقلات)[ف].المصدر := الجديد; };
        ف := ف + 1;
    }

}

عرف ألحق_نقلات_مواقع_متوازية_إكس(
    البايتات: &متغير متجه ط8,
    النقلات_المدخلة: &متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع النقلات: متغير متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = انسخ_مملوكا_متجه_نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة(النقلات_المدخلة);
    دع العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_للهدف(الهدف);
    لو ((الطول(العمل) مثل طبيعي) < 2) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); };
    دع سجل_الدورة: معرف_سجل_فعلي = العمل[0];
    دع سجل_النقل: معرف_سجل_فعلي = العمل[1];
    دع النشطة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النقلات) مثل طبيعي)) { ألحق(النشطة, صواب); ف := ف + 1; }
    دع الباقي: متغير طبيعي = الطول(النقلات) مثل طبيعي;
    طالما (الباقي > 0) {
        دع تقدم: متغير منطقي = خطأ;
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول(النقلات) مثل طبيعي)) {
            لو (النشطة[ن] && !وجهة_مستخدمة_كمصدر_إكس(&النقلات, &النشطة, ن)) {
                طابق ألحق_نقل_موقع_إكس(البايتات, &النقلات[ن].المصدر, &النقلات[ن].الوجهة, سجل_النقل) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                النشطة[ن] := خطأ; الباقي := الباقي - 1; تقدم := صواب;
            };
            ن := ن + 1;
        }
        لو (!تقدم && الباقي > 0) {
            دع أول: متغير طبيعي = 0;
            طالما (أول < (الطول(النقلات) مثل طبيعي) && !النشطة[أول]) { أول := أول + 1; }
            لو (أول >= (الطول(النقلات) مثل طبيعي)) { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز()); };
            دع القديمة: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = النقلات[أول].الوجهة;
            دع المؤقت: موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = موقع_قيمة_إكس_ستة_وثمانون_أربعة_وستون_مخصص.سجل(سجل_الدورة);
            طابق ألحق_نقل_موقع_إكس(البايتات, &القديمة, &المؤقت, سجل_النقل) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            استبدل_مصدر_موقع_إكس(&متغير النقلات, &النشطة, &القديمة, المؤقت);
        };
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_نقلات_حافة_إكس(
    البايتات: &متغير متجه ط8,
    المتطلبات: &متطلبات_نقل_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    دع م: متطلبات_نقل_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = *المتطلبات;
    دع مرجع_النقلات: &متجه نقلة_حافة_إكس_ستة_وثمانون_أربعة_وستون_مخصصة = &م.النقلات;
    أرجع ألحق_نقلات_مواقع_متوازية_إكس(البايتات, مرجع_النقلات, الهدف);
}

عرف احذف_نقلة_نداء_إكس_عند(
    النقلات: &متجه نقلة_سجل_نداء_إكس,
    الفهرس: طبيعي
): متجه نقلة_سجل_نداء_إكس {
    دع ن: متجه نقلة_سجل_نداء_إكس = *النقلات;
    دع الناتج: متغير متجه نقلة_سجل_نداء_إكس = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ن) مثل طبيعي)) {
        لو (ف != الفهرس) {
            ألحق(الناتج, ن[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سجل_وجهة_مطلوب_كمصدر_نداء(
    النقلات: &متجه نقلة_سجل_نداء_إكس,
    الوجهة: معرف_سجل_فعلي
): منطقي {
    دع ن: متجه نقلة_سجل_نداء_إكس = *النقلات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ن) مثل طبيعي)) {
        لو (
            !معرفا_سجل_فعلي_متساويان(ن[ف].المصدر, ن[ف].الوجهة)
            && معرفا_سجل_فعلي_متساويان(ن[ف].المصدر, الوجهة)
        ) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف ألحق_نقلات_نداء_إكس(
    البايتات: &متغير متجه ط8,
    النقلات: &متجه نقلة_سجل_نداء_إكس,
    سجل_العمل: معرف_سجل_فعلي
): نتيجة_دفعة_ترميز_إكس {
    دع الباقية: متغير متجه نقلة_سجل_نداء_إكس = انسخ_مملوكا_متجه_نقلة_سجل_نداء_إكس(النقلات);
    طالما ((الطول(الباقية) مثل طبيعي) != 0) {
        دع تقدم: متغير منطقي = خطأ;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الباقية) مثل طبيعي)) {
            دع النقلة: نقلة_سجل_نداء_إكس = الباقية[ف];
            لو (معرفا_سجل_فعلي_متساويان(النقلة.المصدر, النقلة.الوجهة)) {
                الباقية := احذف_نقلة_نداء_إكس_عند(&الباقية, ف);
                تقدم := صواب;
                ف := الطول(الباقية) مثل طبيعي;
            } وإلا لو (!سجل_وجهة_مطلوب_كمصدر_نداء(&الباقية, النقلة.الوجهة)) {
                طابق ألحق_نقل_سجل_إكس(البايتات, النقلة.الوجهة, النقلة.المصدر) مع
                | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> {
                    أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ);
                }
                | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
                الباقية := احذف_نقلة_نداء_إكس_عند(&الباقية, ف);
                تقدم := صواب;
                ف := الطول(الباقية) مثل طبيعي;
            } وإلا {
                ف := ف + 1;
            };
        }
        لو (!تقدم) {
            دع الأولى: نقلة_سجل_نداء_إكس = الباقية[0];
            دع المؤقت: معرف_سجل_فعلي = سجل_العمل;
            طابق ألحق_نقل_سجل_إكس(البايتات, المؤقت, الأولى.المصدر) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> {
                أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ);
            }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            الباقية[0].المصدر := المؤقت;
        };
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف رمز_شرط_إكس(الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون): طبيعي {
    طابق الشرط مع
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ -> {
        أرجع 4;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.لاتكافؤ -> {
        أرجع 5;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة -> {
        أرجع 12;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو -> {
        أرجع 14;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة -> {
        أرجع 15;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو -> {
        أرجع 13;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي -> {
        أرجع 2;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي_أو_مساو -> {
        أرجع 6;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي -> {
        أرجع 7;
    }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي_أو_مساو -> {
        أرجع 3;
    };
}

عرف رمز_شرط_معكوس_إكس(الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون): طبيعي {
    طابق الشرط مع
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ -> { أرجع 5; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.لاتكافؤ -> { أرجع 4; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة -> { أرجع 13; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو -> { أرجع 15; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة -> { أرجع 14; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو -> { أرجع 12; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي -> { أرجع 3; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي_أو_مساو -> { أرجع 7; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي -> { أرجع 6; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي_أو_مساو -> { أرجع 2; };
}

عرف إزاحة_نسبية_32(من_بعد: طبيعي, إلى: طبيعي): نتيجة_إزاحة_نسبية_32 {
    دع الفرق: متغير عدد = 0;
    لو (إلى >= من_بعد) {
        الفرق := (إلى - من_بعد) مثل عدد;
    } وإلا {
        الفرق := -((من_بعد - إلى) مثل عدد);
    };
    لو (الفرق < -2147483648 || الفرق > 2147483647) {
        أرجع نتيجة_إزاحة_نسبية_32.خارج_المدى();
    };
    لو (الفرق < 0) {
        دع الحقل: عدد = 4294967296 + الفرق;
        أرجع نتيجة_إزاحة_نسبية_32.نجحت(الحقل مثل طبيعي);
    };
    أرجع نتيجة_إزاحة_نسبية_32.نجحت(الفرق مثل طبيعي);
}

عرف ابحث_موضع_كتلة_إكس(
    المواقع: &متجه موضع_كتلة_إكس,
    المعرف: معرف_كتلة_منتقاة
): اختياري طبيعي {
    دع م: متجه موضع_كتلة_إكس = *المواقع;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(م) مثل طبيعي)) {
        لو (معرفا_كتلة_منتقاة_متساويان(م[ف].المعرف, المعرف)) {
            أرجع اختياري.موجود(م[ف].إزاحة_بايت);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف دالة_موجودة_مشفرة(
    الدوال: &متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    المعرف: معرف_دالة_منتقاة
): منطقي {
    دع د: متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = *الدوال;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(د) مثل طبيعي)) {
        لو (معرفا_دالة_منتقاة_متساويان(د[ف].الدالة, المعرف)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف ألحق_فرع_إكس_مؤجل(
    البايتات: &متغير متجه ط8,
    الفروع: &متغير متجه تثبيت_فرع_إكس_مؤجل,
    الهدف: معرف_كتلة_منتقاة,
    شرطي: اختياري شرط_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    طابق شرطي مع
    | اختياري.موجود(الشرط) -> {
        ألحق_بايت_إكس(البايتات, 0x0F);
        ألحق_بايت_إكس(البايتات, 0x80 + رمز_شرط_إكس(الشرط));
    }
    | اختياري.لا_شيء -> {
        ألحق_بايت_إكس(البايتات, 0xE9);
    };
    دع الموضع: طبيعي = الطول(*البايتات) مثل طبيعي;
    ألحق_ط32_إكس(البايتات, 0);
    دع بعد: طبيعي = الطول(*البايتات) مثل طبيعي;

    دع التثبيت: تثبيت_فرع_إكس_مؤجل = {
        إزاحة_الحقل: الموضع,
        بعد_التعليمة: بعد,
        الهدف: الهدف
    };
    ألحق_فرع_إكس_للمشفّر(الفروع, التثبيت);

}

عرف سجلان_فعليان_متساويان_إكس(أ: معرف_سجل_فعلي, ب: معرف_سجل_فعلي): منطقي {
    أرجع معرفا_سجل_فعلي_متساويان(أ, ب);
}

عرف اختر_سجل_عمل_إكس(
    الهدف: &واصف_هدف,
    ممنوع1: اختياري معرف_سجل_فعلي,
    ممنوع2: اختياري معرف_سجل_فعلي,
    ممنوع3: اختياري معرف_سجل_فعلي
): اختياري معرف_سجل_فعلي {
    دع العمل: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_للهدف(الهدف);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العمل) مثل طبيعي)) {
        دع س: معرف_سجل_فعلي = العمل[ف];
        دع مرفوض: متغير منطقي = خطأ;
        طابق ممنوع1 مع | اختياري.موجود(م) -> { لو (سجلان_فعليان_متساويان_إكس(س, م)) { مرفوض := صواب; }; } | اختياري.لا_شيء -> { };
        طابق ممنوع2 مع | اختياري.موجود(م) -> { لو (سجلان_فعليان_متساويان_إكس(س, م)) { مرفوض := صواب; }; } | اختياري.لا_شيء -> { };
        طابق ممنوع3 مع | اختياري.موجود(م) -> { لو (سجلان_فعليان_متساويان_إكس(س, م)) { مرفوض := صواب; }; } | اختياري.لا_شيء -> { };
        لو (!مرفوض) { أرجع اختياري.موجود(س); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ألحق_إزاحة_فورية_64_إكس(
    البايتات: &متغير متجه ط8,
    السجل: معرف_سجل_فعلي,
    المقدار: طبيعي,
    لليسار: منطقي
): نتيجة_دفعة_ترميز_إكس {
    لو (المقدار == 0) { أرجع نتيجة_دفعة_ترميز_إكس.نجحت(); };
    لو (!سجل_إكس_قابل_للترميز(السجل) || المقدار >= 64) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(السجل)
        );
    };
    ألحق_بايت_إكس(البايتات, ركس_إكس(اختياري.لا_شيء(), اختياري.موجود(السجل)));
    ألحق_بايت_إكس(البايتات, 0xC1);
    دع الحقل: متغير طبيعي = 5;
    لو (لليسار) { الحقل := 4; };
    دع حقل_مود: معرف_سجل_فعلي = { القيمة: الحقل };
    ألحق_بايت_إكس(البايتات, مود_آر_إم_سجلين(حقل_مود, السجل));
    ألحق_بايت_إكس(البايتات, المقدار);
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

عرف ألحق_تحميل_جزء_تجميع_إكس(
    البايتات: &متغير متجه ط8,
    الوجهة: معرف_سجل_فعلي,
    العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص,
    الحجم: طبيعي,
    الهدف: &واصف_هدف
): نتيجة_دفعة_ترميز_إكس {
    لو (الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8) {
        أرجع ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, العنوان, الحجم, خطأ);
    };
    لو (الحجم == 0 || الحجم > 8) {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(الحجم)
        );
    };
    دع الأصل: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = *العنوان;
    دع العمل: متغير معرف_سجل_فعلي = { القيمة: 0 };
    طابق اختر_سجل_عمل_إكس(الهدف, اختياري.موجود(الوجهة), الأصل.الأساس, الأصل.الفهرس) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دفعة_ترميز_إكس.خطأ(
            خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية()
        );
    }
    | اختياري.موجود(السجل) -> { العمل := السجل; };
    دع المنجز: متغير طبيعي = 0;
    طالما (المنجز < الحجم) {
        دع الباقي: طبيعي = الحجم - المنجز;
        دع الجزء: متغير طبيعي = 1;
        لو (الباقي >= 4) { الجزء := 4; } وإلا لو (الباقي >= 2) { الجزء := 2; };
        دع الحالي: متغير عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون_مخصص = الأصل;
        الحالي.الإزاحة := الحالي.الإزاحة + (المنجز مثل عدد);
        لو (المنجز == 0) {
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, &الحالي, الجزء, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        } وإلا {
            طابق ألحق_تحميل_ذاكرة_إكس(البايتات, العمل, &الحالي, الجزء, خطأ) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_إزاحة_فورية_64_إكس(البايتات, العمل, المنجز * 8, صواب) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
            طابق ألحق_عملية_سجلين_بعرض_إكس(البايتات, 64, الوجهة, العمل, 0x08, 0x09) مع
            | نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(الخطأ); }
            | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        };
        المنجز := المنجز + الجزء;
    }
    أرجع نتيجة_دفعة_ترميز_إكس.نجحت();
}

