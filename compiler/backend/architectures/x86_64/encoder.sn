        // Grow: capacity = max(capacity * growth, minimum), trapping on overflow.
        دع عامل_النمو: متغير طبيعي = م.عامل_النمو;
        لو (عامل_النمو < 2) { عامل_النمو := 2; };
        دع السعة_الدنيا: متغير طبيعي = م.السعة_الدنيا;
        لو (السعة_الدنيا < 1) { السعة_الدنيا := 1; };
        ألحق_ضرب_فوري_إلحاق_إكس(البايتات, سجل_ب, عامل_النمو);
        طابق ألحق_نقل_فوري_بتات_إكس(البايتات, ركس_أ, السعة_الدنيا) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_مقارنة_بعرض_إكس(البايتات, سجل_ب, ركس_أ, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
