        ألحق_ط32_إكس(البايتات, 0);
        // grow: capacity = max(capacity * growth, minimum), trapping on
        // overflow; rax holds the length and r10 the capacity here.
        دع بداية_النمو: طبيعي = الطول(*البايتات) مثل طبيعي;
        اكتب_ط32_إكس(البايتات, موضع_فرع_النمو, بداية_النمو - (موضع_فرع_النمو + 4));
        ألحق_تعديل_مؤشر_المكدس_إكس_مع_فك(البايتات, تعديل_المكدس, صواب, بداية_الدالة, فك_المكدس);
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س0, &خانة_المتجه_, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تخزين_ذاكرة_إكس(البايتات, س1, &خانة_العنصر_, 8) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        دع عامل_النمو_: متغير طبيعي = م.عامل_النمو;
        إذا (عامل_النمو_ < 2) { عامل_النمو_ := 2; };
        دع السعة_الدنيا_: متغير طبيعي = م.السعة_الدنيا;
        إذا (السعة_الدنيا_ < 1) { السعة_الدنيا_ := 1; };
        طابق ألحق_ضرب_فوري_إلحاق_إكس(البايتات, سجل_ب, عامل_النمو_) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_نقل_فوري_بتات_إكس(البايتات, ركس_أ, السعة_الدنيا_) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_مقارنة_بعرض_إكس(البايتات, سجل_ب, ركس_أ, 64) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        // JAE rel8 over the minimum-capacity move.
        ألحق_بايت_إكس(البايتات, 0x73);
