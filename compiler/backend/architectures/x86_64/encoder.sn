        طابق ألحق_نقل_سجل_إكس(البايتات, س1, سجل_ب) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_ضرب_فوري_إلحاق_إكس(البايتات, س1, م.حجم_العنصر) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        طابق ألحق_تحميل_ذاكرة_إكس(البايتات, س0, &عنوان_البيانات_, 8, خطأ) مع | نتيجة_دفعة_ترميز_إكس.خطأ(خ) -> { أرجع نتيجة_دفعة_ترميز_إكس.خطأ(خ); } | نتيجة_دفعة_ترميز_إكس.نجحت -> { };
        ألحق_بايت_إكس(البايتات, 0xE8);
        دع موضع_الإزاحة_: طبيعي = الطول(*البايتات) مثل طبيعي;
        ألحق_ط32_إكس(البايتات, 0);
        دع خدمة_إعادة_التخصيص_: خدمة_تشغيل_هدف = خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة();
        دع الإزاحة_: إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
            إزاحة_بايت: موضع_الإزاحة_,
            النوع: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون.نداء(),
