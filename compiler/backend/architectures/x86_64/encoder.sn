            دع رمز_الحجز: مرجع_رمز_كائن = مرجع_رمز_كائن.خدمة_تشغيل(خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة());
            دع نوع_إزاحة_الحجز: نوع_إزاحة_نسبية_إكس_ستة_وثمانون_أربعة_وستون =
