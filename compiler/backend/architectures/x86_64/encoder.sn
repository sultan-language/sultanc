    إذا (الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8) {
        أرجع ألحق_تحميل_ذاكرة_إكس(البايتات, الوجهة, العنوان, الحجم, خطأ);
    };
    إذا (الحجم == 0 || الحجم > 8) {
