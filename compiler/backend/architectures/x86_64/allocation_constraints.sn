استورد compiler.backend.architectures.x86_64.instruction_model;
استورد compiler.backend.architectures.x86_64.selected_code;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.target.target_model;
استورد compiler.backend.abi.abi_model;
استورد compiler.backend.target.register_query_context;

عرف فئة_إكس_صحيح(): معرف_فئة_تخصيص {
    دع الناتج: معرف_فئة_تخصيص = { القيمة: 0 };
    أرجع الناتج;
}

عرف طلب_إكس(السجل: معرف_سجل_افتراضي): طلب_سجل_تخصيص {
    دع الفئة: معرف_فئة_تخصيص = فئة_إكس_صحيح();
    دع الثابت: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    دع الناتج: طلب_سجل_تخصيص = { السجل: السجل, الفئة: الفئة, ثابت: الثابت };
    أرجع الناتج;
}

عرف طلب_إكس_من_مرجع_واجهة(
    السجل: معرف_سجل_افتراضي,
    المرجع: &مرجع_سجل_واجهة,
    الهدف: &واصف_هدف
): طلب_سجل_تخصيص {
    طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, المرجع) مع
    | اختيار.بعض(الفعلي) -> {
        // لا يمكن تثبيت حامل حد الدخول في سجل لا يدخل مجموعة allocator
        // (مثل RDX/RCX المحجوزين للعمل الداخلي). هذه المصادر آمنة لأن allocator
        // لن يختارها كوجهات؛ أما RDI/RSI/R8/R9 فتثبت حواملها القصيرة لمنع
        // نقل مبكر من الكتابة فوق قيمة ABI لم تُلتقط بعد.
        دع المتاحة: متجه معرف_سجل_فعلي = سجلات_عمل_قابلة_للتخصيص_للهدف(الهدف);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المتاحة) مثل غير_موقع)) {
            لو (معرفا_سجل_فعلي_متساويان(المتاحة[ف], الفعلي)) {
                دع الفئة: معرف_فئة_تخصيص = فئة_إكس_صحيح();
                دع الثابت: اختيار معرف_سجل_فعلي = اختيار.بعض(الفعلي);
                دع الناتج: طلب_سجل_تخصيص = { السجل: السجل, الفئة: الفئة, ثابت: الثابت };
                أرجع الناتج;
            };
            ف := ف + 1;
        }
        أرجع طلب_إكس(السجل);
    }
    | اختيار.لا_شيء -> {
        أرجع طلب_إكس(السجل);
    };
}

عرف حوّل_نقلات_حافة_إكس_للتخصيص(
    المتطلبات: &متطلبات_نقل_حافة_منتقاة
): متجه نقلة_حافة_تخصيص {
    دع م: متطلبات_نقل_حافة_منتقاة = *المتطلبات;
    دع الناتج: متغير متجه نقلة_حافة_تخصيص = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م.النقلات) مثل غير_موقع)) {
        دع النقلة: نقلة_حافة_منتقاة = م.النقلات[ف];
        دع المصدر: طلب_سجل_تخصيص = طلب_إكس(النقلة.المصدر);
        دع الوجهة: طلب_سجل_تخصيص = طلب_إكس(النقلة.الوجهة);
        دع حقيقة_النقلة: نقلة_حافة_تخصيص = {
            المصدر: المصدر,
            الوجهة: الوجهة
        };
        ألحق(الناتج, حقيقة_النقلة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف سجلات_إكس_متاحة_للتخصيص(الهدف: &واصف_هدف): متجه سجل_فعلي_متاح {
    // Target يركب مجموعة السجلات القابلة للتخصيص؛ x86 العام لا يعرف هوية نظام بعينه.
    دع الناتج: متغير متجه سجل_فعلي_متاح = [];
    دع السجلات: متجه معرف_سجل_فعلي = سجلات_عمل_قابلة_للتخصيص_للهدف(الهدف);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(السجلات) مثل غير_موقع)) {
        دع الفئة: معرف_فئة_تخصيص = فئة_إكس_صحيح();
        دع المتاح: سجل_فعلي_متاح = { المعرف: السجلات[ف], الفئة: الفئة };
        ألحق(الناتج, المتاح);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أضف_طلبات_نداء_إكس(
    النداء: &نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى,
    الاستخدامات: &متغير متجه طلب_سجل_تخصيص,
    التعريفات: &متغير متجه طلب_سجل_تخصيص
): فراغ {
    دع ن: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = *النداء;
    دع حالة_الاستخدامات: متغير متجه طلب_سجل_تخصيص = *الاستخدامات;
    دع حالة_التعريفات: متغير متجه طلب_سجل_تخصيص = *التعريفات;
    طابق ن.الهدف مع
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.قيمة_دالة(السجل) -> { ألحق(حالة_الاستخدامات, طلب_إكس(السجل)); }
    | _ -> { };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ن.الحجج) مثل غير_موقع)) {
        ألحق(حالة_الاستخدامات, طلب_إكس(ن.الحجج[ف].السجل));
        ف := ف + 1;
    }
    طابق ن.الناتج مع
    | اختيار.بعض(الناتج) -> {
        لو (الناتج.تجميعي) {
            ألحق(حالة_الاستخدامات, طلب_إكس(الناتج.السجل));
        } وإلا {
            ألحق(حالة_التعريفات, طلب_إكس(الناتج.السجل));
        };
    }
    | اختيار.لا_شيء -> { };
    *الاستخدامات := حالة_الاستخدامات;
    *التعريفات := حالة_التعريفات;
}

عام عرف حقيقة_تخصيص_تعليمة_إكس(
    التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    الهدف: &واصف_هدف,
    الموضع: غير_موقع
): حقيقة_تعليمة_تخصيص {
    دع الاستخدامات: متغير متجه طلب_سجل_تخصيص = [];
    دع التعريفات: متغير متجه طلب_سجل_تخصيص = [];
    دع الربط: متغير متجه قيد_ربط_تخصيص = [];
    دع نقل: متغير اختيار قيد_ربط_تخصيص = اختيار.لا_شيء();
    دع نداء: متغير منطقي = خطأ;
    دع يحتاج_عمل_خاص: متغير منطقي = خطأ;
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(القيمة) -> {
        // selector يعطي كل قيمة دخل حاملا قصير العمر. سجل ABI يثبت هذا الحامل
        // عند حد الدخول فقط، ثم تنقل القيمة إلى سجل المعامل الدلالي غير المثبت.
        دع عدد_المواضع: غير_موقع = الطول(القيمة.المواضع) مثل غير_موقع;
        لو (عدد_المواضع == 1) {
            دع الموضع: موضع_جزء_واجهة = القيمة.المواضع[0];
            طابق الموضع مع
            | موضع_جزء_واجهة.سجل(المرجع) -> {
                دع الطلب: طلب_سجل_تخصيص = طلب_إكس_من_مرجع_واجهة(
                    القيمة.السجل, &المرجع, الهدف
                );
                ألحق(التعريفات, الطلب);
            }
            | موضع_جزء_واجهة.مكدس(_) -> {
                ألحق(التعريفات, طلب_إكس(القيمة.السجل));
            };
        } وإلا {
            ألحق(التعريفات, طلب_إكس(القيمة.السجل));
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(الوجهة, المصدر) -> {
        ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة));
        دع قيد_النقل: قيد_ربط_تخصيص = { الأول: المصدر, الثاني: الوجهة }; نقل := اختيار.بعض(قيد_النقل);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(الوجهة, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(_, الوجهة, الأيسر, الأيمن, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(الأيسر)); ألحق(الاستخدامات, طلب_إكس(الأيمن)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_صحيح_كامل_إكس(_, الوجهة, المصدر, _, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_عشري_إكس(_, الوجهة, الأيسر, الأيمن, _) -> {
        ألحق(الاستخدامات, طلب_إكس(الأيسر)); ألحق(الاستخدامات, طلب_إكس(الأيمن)); ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_عشرية_إلى_منطق_إكس(_, الوجهة, الأيسر, الأيمن, _) -> {
        ألحق(الاستخدامات, طلب_إكس(الأيسر)); ألحق(الاستخدامات, طلب_إكس(الأيمن)); ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(الوجهة, أ, ب, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(أ)); ألحق(الاستخدامات, طلب_إكس(ب)); ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.جمع_ثنائي_العنوان_إكس(الوجهة, المصدر) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.جمع_ثنائي_العنوان_إكس_مع_فخ_تجاوز(الوجهة, المصدر, _) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.طرح_ثنائي_العنوان_إكس(الوجهة, المصدر) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.طرح_ثنائي_العنوان_إكس_مع_فخ_تجاوز(الوجهة, المصدر, _) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_إكس(الوجهة, العنوان) -> {
        طابق العنوان.الأساس مع | اختيار.بعض(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختيار.لا_شيء -> { };
        طابق العنوان.الفهرس مع | اختيار.بعض(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختيار.لا_شيء -> { };
        ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(الوجهة, الأساس, الفهرس, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(الأساس)); ألحق(الاستخدامات, طلب_إكس(الفهرس)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(الوجهة, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نسخ_ذاكرة_إكس(الوجهة, المصدر, _, _, _) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); يحتاج_عمل_خاص := صواب; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(الأساس, _, _, _) -> { ألحق(الاستخدامات, طلب_إكس(الأساس)); يحتاج_عمل_خاص := صواب; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.إلحاق_متجه_إكس(الإلحاق) -> {
        ألحق(الاستخدامات, طلب_إكس(الإلحاق.المتجه));
        ألحق(الاستخدامات, طلب_إكس(الإلحاق.العنصر));
        نداء := صواب;
        يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ثابت_نص_إكس(_) -> { نداء := صواب; يحتاج_عمل_خاص := صواب; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_صندوق_إكس(الوجهة, _, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); نداء := صواب; يحتاج_عمل_خاص := صواب; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الوجهة, العنوان, _, _) -> {
        طابق العنوان.الأساس مع | اختيار.بعض(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختيار.لا_شيء -> { };
        طابق العنوان.الفهرس مع | اختيار.بعض(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختيار.لا_شيء -> { };
        ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, _) -> {
        ألحق(الاستخدامات, طلب_إكس(المصدر));
        طابق العنوان.الأساس مع | اختيار.بعض(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختيار.لا_شيء -> { };
        طابق العنوان.الفهرس مع | اختيار.بعض(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختيار.لا_شيء -> { };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_سجل_إكس(أ, ب) -> { ألحق(الاستخدامات, طلب_إكس(أ)); ألحق(الاستخدامات, طلب_إكس(ب)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(الشرط, _) -> { ألحق(الاستخدامات, طلب_إكس(الشرط)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(الخطة) -> { نداء := صواب; أضف_طلبات_نداء_إكس(&الخطة, &متغير الاستخدامات, &متغير التعريفات); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس_بقيمة(الناتج) -> {
        ألحق(الاستخدامات, طلب_إكس(الناتج.القيمة.السجل));
        طابق الناتج.عنوان_ناتج_غير_مباشر مع
        | اختيار.بعض(العنوان) -> { ألحق(الاستخدامات, طلب_إكس(العنوان)); }
        | اختيار.لا_شيء -> { };
    }
    | _ -> { };

    دع المفسدة: متغير متجه معرف_سجل_فعلي = [];
    لو (نداء) {
        // حد النداء الحقيقي فقط يفسد سجلات caller-saved القابلة للتخصيص.
        // تعليمات الخفض الخاصة تستعمل سجلات العمل المحجوزة التي لا تدخل allocator،
        // فلا يجوز اعتبار RDI/RSI/R8/R9 مفسدة عند كل عملية حسابية/نسخ ذاكرة.
        المفسدة := سجلات_متطايرة_للهدف(الهدف);
    };
    دع الناتج: حقيقة_تعليمة_تخصيص = {
        الموضع: الموضع, الاستخدامات: الاستخدامات, التعريفات: التعريفات, القيود_المربوطة: الربط,
        السجلات_المفسدة: المفسدة, حد_نداء: نداء, قابل_للانسكاب: صواب, نقل_مفضل: نقل
    };
    أرجع الناتج;
}

عرف حافة_تخصيص_إكس_موجودة(
    الحواف: &متجه حقيقة_نقل_حافة_تخصيص,
    الكتلة_المصدر: معرف_كتلة_منتقاة,
    الكتلة_الهدف: معرف_كتلة_منتقاة
): منطقي {
    دع ح: متجه حقيقة_نقل_حافة_تخصيص = *الحواف;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ح) مثل غير_موقع)) {
        لو (
            معرفا_كتلة_منتقاة_متساويان(ح[ف].من_كتلة, الكتلة_المصدر)
            && معرفا_كتلة_منتقاة_متساويان(ح[ف].إلى_كتلة, الكتلة_الهدف)
        ) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف ابن_مسألة_تخصيص_دالة_إكس(
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): مسألة_تخصيص {
    دع د: دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *الدالة;
    دع الحقائق: متغير متجه حقيقة_تعليمة_تخصيص = [];
    دع الحواف: متغير متجه حقيقة_نقل_حافة_تخصيص = [];
    دع حقائق_الكتل: متغير متجه حقيقة_كتلة_تخصيص = [];
    دع الموضع: متغير غير_موقع = 0;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(د.الكتل) مثل غير_موقع)) {
        دع مرجع_الكتلة: &كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = &د.الكتل[ك];
        دع الكتلة: كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *مرجع_الكتلة;
        دع بداية_الكتلة: غير_موقع = الموضع;
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الكتلة.التعليمات) مثل غير_موقع)) {
            دع مرجع_التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون = &الكتلة.التعليمات[ت];
            دع التعليمة: تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *مرجع_التعليمة;
            ألحق(الحقائق, حقيقة_تخصيص_تعليمة_إكس(&التعليمة, الهدف, الموضع));
            طابق التعليمة مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(النقلات) -> {
                دع نسخة_النقلات: متجه نقلة_حافة_تخصيص = حوّل_نقلات_حافة_إكس_للتخصيص(&النقلات);
                دع حافة: حقيقة_نقل_حافة_تخصيص = {
                    من_كتلة: الكتلة.الرأس.المعرف,
                    إلى_كتلة: النقلات.الهدف,
                    النقلات: نسخة_النقلات
                };
                ألحق(الحواف, حافة);
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(_, النقلات) -> {
                دع نسخة_النقلات: متجه نقلة_حافة_تخصيص = حوّل_نقلات_حافة_إكس_للتخصيص(&النقلات);
                دع حافة: حقيقة_نقل_حافة_تخصيص = {
                    من_كتلة: الكتلة.الرأس.المعرف,
                    إلى_كتلة: النقلات.الهدف,
                    النقلات: نسخة_النقلات
                };
                ألحق(الحواف, حافة);
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(_, النقلات) -> {
                دع نسخة_النقلات: متجه نقلة_حافة_تخصيص = حوّل_نقلات_حافة_إكس_للتخصيص(&النقلات);
                دع حافة: حقيقة_نقل_حافة_تخصيص = { من_كتلة: الكتلة.الرأس.المعرف, إلى_كتلة: النقلات.الهدف, النقلات: نسخة_النقلات };
                ألحق(الحواف, حافة);
            }
            | _ -> { };
            الموضع := الموضع + 1;
            ت := ت + 1;
        }
        // العقد المشترك للحياة يحتاج كل حافة CFG، حتى الحواف التي لا تحمل نقلات.
        دع خ: متغير غير_موقع = 0;
        بينما (خ < (الطول(الكتلة.الرأس.الخلفاء) مثل غير_موقع)) {
            دع اللاحق: معرف_كتلة_منتقاة = الكتلة.الرأس.الخلفاء[خ];
            لو (!حافة_تخصيص_إكس_موجودة(&الحواف, الكتلة.الرأس.المعرف, اللاحق)) {
                دع لا_نقلات: متجه نقلة_حافة_تخصيص = [];
                دع حافة: حقيقة_نقل_حافة_تخصيص = {
                    من_كتلة: الكتلة.الرأس.المعرف,
                    إلى_كتلة: اللاحق,
                    النقلات: لا_نقلات
                };
                ألحق(الحواف, حافة);
            };
            خ := خ + 1;
        }
        دع حقيقة_الكتلة: حقيقة_كتلة_تخصيص = {
            المعرف: الكتلة.الرأس.المعرف,
            البداية: بداية_الكتلة,
            النهاية: الموضع
        };
        ألحق(حقائق_الكتل, حقيقة_الكتلة);
        ك := ك + 1;
    }
    دع المتاحة: متجه سجل_فعلي_متاح = سجلات_إكس_متاحة_للتخصيص(الهدف);
    دع الناتج: مسألة_تخصيص = {
        عدد_السجلات_الافتراضية: د.الرأس.عدد_السجلات_الافتراضية,
        التعليمات: الحقائق,
        نقلات_الحواف: الحواف,
        الكتل: حقائق_الكتل,
        السجلات_المتاحة: المتاحة
    };
    أرجع الناتج;
}
