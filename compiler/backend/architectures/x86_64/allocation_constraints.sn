استورد compiler.backend.architectures.x86_64.instruction_model;
استورد compiler.backend.architectures.x86_64.selected_code;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.target.target_model;
استورد compiler.backend.abi.abi_model;
استورد compiler.backend.target.register_query_context;
استورد compiler.runtime.primitive_identity;

عرف فئة_إكس_صحيح(): معرف_فئة_تخصيص {
    ليكن الناتج: معرف_فئة_تخصيص = { القيمة: 0 };
    أرجع الناتج;
}

عرف طلب_إكس(السجل: معرف_سجل_افتراضي): طلب_سجل_تخصيص {
    ليكن الفئة: معرف_فئة_تخصيص = فئة_إكس_صحيح();
    ليكن الثابت: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
    ليكن الناتج: طلب_سجل_تخصيص = { السجل: السجل, الفئة: الفئة, ثابت: الثابت };
    أرجع الناتج;
}

عرف طلب_إكس_من_مرجع_واجهة(
    السجل: معرف_سجل_افتراضي,
    المرجع: &مرجع_سجل_واجهة,
    الهدف: &واصف_هدف
): طلب_سجل_تخصيص {
    طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, المرجع) مع
    | اختياري.موجود(الفعلي) -> {
        // لا يمكن تثبيت حامل حد الدخول في سجل لا يدخل مجموعة allocator
        // (مثل RDX/RCX المحجوزين للعمل الداخلي). هذه المصادر آمنة لأن allocator
        // لن يختارها كوجهات؛ أما RDI/RSI/R8/R9 فتثبت حواملها القصيرة لمنع
        // نقل مبكر من الكتابة فوق قيمة ABI لم تُلتقط بعد.
        ليكن المتاحة: متجه معرف_سجل_فعلي = سجلات_عمل_قابلة_للتخصيص_للهدف(الهدف);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المتاحة) مثل طبيعي)) {
            إذا (معرفا_سجل_فعلي_متساويان(المتاحة[ف], الفعلي)) {
                ليكن الفئة: معرف_فئة_تخصيص = فئة_إكس_صحيح();
                ليكن الثابت: اختياري معرف_سجل_فعلي = اختياري.موجود(الفعلي);
                ليكن الناتج: طلب_سجل_تخصيص = { السجل: السجل, الفئة: الفئة, ثابت: الثابت };
                أرجع الناتج;
            };
            ف := ف + 1;
        }
        أرجع طلب_إكس(السجل);
    }
    | اختياري.لا_شيء -> {
        أرجع طلب_إكس(السجل);
    };
}

عرف حوّل_نقلات_حافة_إكس_للتخصيص(
    المتطلبات: &متطلبات_نقل_حافة_منتقاة
): متجه نقلة_حافة_تخصيص {
    ليكن م: متطلبات_نقل_حافة_منتقاة = *المتطلبات;
    ليكن الناتج: متغير متجه نقلة_حافة_تخصيص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(م.النقلات) مثل طبيعي)) {
        ليكن النقلة: نقلة_حافة_منتقاة = م.النقلات[ف];
        ليكن المصدر: طلب_سجل_تخصيص = طلب_إكس(النقلة.المصدر);
        ليكن الوجهة: طلب_سجل_تخصيص = طلب_إكس(النقلة.الوجهة);
        ليكن حقيقة_النقلة: نقلة_حافة_تخصيص = {
            المصدر: المصدر,
            الوجهة: الوجهة
        };
        ألحق(الناتج, حقيقة_النقلة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف سجلات_إكس_متاحة_للتخصيص(الهدف: &واصف_هدف): متجه سجل_فعلي_متاح {
    // Target يركب مجموعة السجلات القابلة للتخصيص؛ x86 العام لا يعرف هوية نظام بعينه.
    ليكن الناتج: متغير متجه سجل_فعلي_متاح = [];
    ليكن السجلات: متجه معرف_سجل_فعلي = سجلات_عمل_قابلة_للتخصيص_للهدف(الهدف);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(السجلات) مثل طبيعي)) {
        ليكن الفئة: معرف_فئة_تخصيص = فئة_إكس_صحيح();
        ليكن المتاح: سجل_فعلي_متاح = { المعرف: السجلات[ف], الفئة: الفئة };
        ألحق(الناتج, المتاح);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أضف_طلبات_نداء_إكس(
    النداء: &نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى,
    الاستخدامات: &متغير متجه طلب_سجل_تخصيص,
    التعريفات: &متغير متجه طلب_سجل_تخصيص
): فراغ {
    ليكن ن: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = *النداء;
    طابق ن.الهدف مع
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.قيمة_دالة(السجل) -> { ألحق(*الاستخدامات, طلب_إكس(السجل)); }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.عنوان_سي(السجل) -> { ألحق(*الاستخدامات, طلب_إكس(السجل)); }
    | _ -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ن.الحجج) مثل طبيعي)) {
        ألحق(*الاستخدامات, طلب_إكس(ن.الحجج[ف].السجل));
        ف := ف + 1;
    }
    طابق ن.الناتج مع
    | اختياري.موجود(الناتج) -> {
        إذا (الناتج.تجميعي) {
            ألحق(*الاستخدامات, طلب_إكس(الناتج.السجل));
        } وإلا {
            ألحق(*التعريفات, طلب_إكس(الناتج.السجل));
        };
    }
    | اختياري.لا_شيء -> { };
}

// The argument registers a call's scalar integer arguments go to, where the
// allocator may hold them (the encoder's parallel move then skips them). A
// kernel call (and the thread clone) stages its arguments on the stack
// instead.
عرف تفضيلات_حجج_نداء_إكس(
    النداء: &نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى,
    الهدف: &واصف_هدف,
    المفضلة: &متغير متجه تفضيل_سجل_تخصيص
): فراغ {
    طابق (*النداء).الهدف مع
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.نداء_نواة -> { أرجع; }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.بدائي_تشغيل(البدائي) -> {
        إذا (هويتا_بدائي_مترجم_متساويتان(البدائي, هوية_بدائي_مترجم.استنساخ_خيط_نواة())) { أرجع; };
    }
    | _ -> { };
    ليكن المتاحة: متجه معرف_سجل_فعلي = سجلات_عمل_قابلة_للتخصيص_للهدف(الهدف);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
        ليكن الحجة: &قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = &(*النداء).الحجج[ف];
        إذا (!(*الحجة).تجميعي && !(*الحجة).غير_مباشر && (الطول((*الحجة).المواضع) مثل طبيعي) == 1) {
            طابق (*الحجة).المواضع[0] مع
            | موضع_جزء_واجهة.سجل(المرجع) -> {
                إذا (المرجع.الفئة == فئة_سجل_واجهة.عدد_صحيح()) {
                    طابق حل_سجل_واجهة_فعلي_للهدف(الهدف, &المرجع) مع
                    | اختياري.موجود(الفعلي) -> {
                        ليكن م: متغير طبيعي = 0;
                        طالما (م < (الطول(المتاحة) مثل طبيعي)) {
                            إذا (معرفا_سجل_فعلي_متساويان(المتاحة[م], الفعلي)) {
                                ليكن التفضيل: تفضيل_سجل_تخصيص = { السجل: (*الحجة).السجل, الفعلي: الفعلي };
                                ألحق(*المفضلة, التفضيل);
                            };
                            م := م + 1;
                        }
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
}

// The integer operations encoded as MOV destination, left; OP destination,
// right (encoder.sn ألحق_حساب_صحيح_كامل_إكس).
عام عرف حساب_ثنائي_العنوان_إكس(العملية: حساب_صحيح_إكس_كامل): منطقي {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.طرح -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.جمع_ملتف -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.طرح_ملتف -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.ضرب_ملتف -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.و_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { أرجع صواب; }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// المتطايرة: the target's caller-saved registers, built once per function by
// ابن_مسألة_تخصيص_دالة_إكس. Every call fact shares that one read-only list
// (liveness copies clobbers into its own interval lists) instead of building
// a fresh vector per call instruction.
عام عرف حقيقة_تخصيص_تعليمة_إكس(
    التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    الهدف: &واصف_هدف,
    المتطايرة: &متجه معرف_سجل_فعلي,
    الموضع: طبيعي
): حقيقة_تعليمة_تخصيص {
    ليكن الاستخدامات: متغير متجه طلب_سجل_تخصيص = [];
    ليكن التعريفات: متغير متجه طلب_سجل_تخصيص = [];
    ليكن الربط: متغير متجه قيد_ربط_تخصيص = [];
    ليكن نقل: متغير اختياري قيد_ربط_تخصيص = اختياري.لا_شيء();
    ليكن المفضلة: متغير متجه تفضيل_سجل_تخصيص = [];
    ليكن نداء: متغير منطقي = خطأ;
    ليكن يحتاج_عمل_خاص: متغير منطقي = خطأ;
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(القيمة) -> {
        // selector يعطي كل قيمة دخل حاملا قصير العمر. سجل ABI يثبت هذا الحامل
        // عند حد الدخول فقط، ثم تنقل القيمة إلى سجل المعامل الدلالي غير المثبت.
        ليكن عدد_المواضع: طبيعي = الطول(القيمة.المواضع) مثل طبيعي;
        إذا (عدد_المواضع == 1) {
            ليكن الموضع: موضع_جزء_واجهة = القيمة.المواضع[0];
            طابق الموضع مع
            | موضع_جزء_واجهة.سجل(المرجع) -> {
                ليكن الطلب: طلب_سجل_تخصيص = طلب_إكس_من_مرجع_واجهة(
                    القيمة.السجل, &المرجع, الهدف
                );
                ألحق(التعريفات, الطلب);
            }
            | موضع_جزء_واجهة.مكدس(_) -> {
                ألحق(التعريفات, طلب_إكس(القيمة.السجل));
            };
        } وإلا {
            ألحق(التعريفات, طلب_إكس(القيمة.السجل));
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(الوجهة, المصدر) -> {
        ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة));
        ليكن قيد_النقل: قيد_ربط_تخصيص = { الأول: المصدر, الثاني: الوجهة }; نقل := اختياري.موجود(قيد_النقل);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(الوجهة, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_عام_إكس(الوجهة, _, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.بيئة_إغلاق_إكس(الوجهة) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(العملية, الوجهة, الأيسر, الأيمن, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(الأيسر)); ألحق(الاستخدامات, طلب_إكس(الأيمن)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
        // Two-address forms copy the left operand into the destination first
        // and read it no more: sharing its register drops that copy.
        إذا (حساب_ثنائي_العنوان_إكس(العملية)) {
            ليكن قيد_النقل: قيد_ربط_تخصيص = { الأول: الأيسر, الثاني: الوجهة }; نقل := اختياري.موجود(قيد_النقل);
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_فوري_إكس(_, الوجهة, الأيسر, _, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(الأيسر)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
        ليكن قيد_النقل: قيد_ربط_تخصيص = { الأول: الأيسر, الثاني: الوجهة }; نقل := اختياري.موجود(قيد_النقل);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_صحيح_كامل_إكس(_, الوجهة, المصدر, _, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
        // One move or extension from the source, then only the destination.
        ليكن قيد_النقل: قيد_ربط_تخصيص = { الأول: المصدر, الثاني: الوجهة }; نقل := اختياري.موجود(قيد_النقل);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قسمة_على_ثابت_إكس(الوجهة, المصدر, _, _, _, _) -> {
        // Uses only the reserved work registers (RAX, RDX and one of R10/RCX).
        ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_عائم_إكس(_, الوجهة, المصدر, _, _) -> {
        // Every read of the source precedes the first write of the destination.
        ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_عشري_إكس(_, الوجهة, الأيسر, الأيمن, _) -> {
        ألحق(الاستخدامات, طلب_إكس(الأيسر)); ألحق(الاستخدامات, طلب_إكس(الأيمن)); ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_عشرية_إلى_منطق_إكس(_, الوجهة, الأيسر, الأيمن, _) -> {
        ألحق(الاستخدامات, طلب_إكس(الأيسر)); ألحق(الاستخدامات, طلب_إكس(الأيمن)); ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(الوجهة, أ, ب, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(أ)); ألحق(الاستخدامات, طلب_إكس(ب)); ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.جمع_ثنائي_العنوان_إكس(الوجهة, المصدر) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.جمع_ثنائي_العنوان_إكس_مع_فخ_تجاوز(الوجهة, المصدر, _) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.طرح_ثنائي_العنوان_إكس(الوجهة, المصدر) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.طرح_ثنائي_العنوان_إكس_مع_فخ_تجاوز(الوجهة, المصدر, _) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_إكس(الوجهة, العنوان) -> {
        طابق العنوان.الأساس مع | اختياري.موجود(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختياري.لا_شيء -> { };
        طابق العنوان.الفهرس مع | اختياري.موجود(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختياري.لا_شيء -> { };
        ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(الوجهة, الأساس, الفهرس, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(الأساس)); ألحق(الاستخدامات, طلب_إكس(الفهرس)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(الوجهة, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نسخ_ذاكرة_إكس(الوجهة, المصدر, _, _, _) -> { ألحق(الاستخدامات, طلب_إكس(الوجهة)); ألحق(الاستخدامات, طلب_إكس(المصدر)); يحتاج_عمل_خاص := صواب; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(الأساس, _, _, _) -> { ألحق(الاستخدامات, طلب_إكس(الأساس)); يحتاج_عمل_خاص := صواب; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.إلحاق_متجه_إكس(الإلحاق) -> {
        ألحق(الاستخدامات, طلب_إكس(الإلحاق.المتجه));
        ألحق(الاستخدامات, طلب_إكس(الإلحاق.العنصر));
        نداء := صواب;
        يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.امتداد_متجه_إكس(الامتداد) -> {
        ألحق(الاستخدامات, طلب_إكس(الامتداد.المتجه));
        ألحق(الاستخدامات, طلب_إكس(الامتداد.المصدر));
        ألحق(الاستخدامات, طلب_إكس(الامتداد.البداية));
        ألحق(الاستخدامات, طلب_إكس(الامتداد.العدد));
        نداء := صواب;
        يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ثابت_نص_إكس(_) -> { نداء := صواب; يحتاج_عمل_خاص := صواب; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_صندوق_إكس(الوجهة, _, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); نداء := صواب; يحتاج_عمل_خاص := صواب; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الوجهة, العنوان, _, _) -> {
        طابق العنوان.الأساس مع | اختياري.موجود(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختياري.لا_شيء -> { };
        طابق العنوان.الفهرس مع | اختياري.موجود(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختياري.لا_شيء -> { };
        ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, العنوان, _) -> {
        ألحق(الاستخدامات, طلب_إكس(المصدر));
        طابق العنوان.الأساس مع | اختياري.موجود(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختياري.لا_شيء -> { };
        طابق العنوان.الفهرس مع | اختياري.موجود(س) -> { ألحق(الاستخدامات, طلب_إكس(س)); } | اختياري.لا_شيء -> { };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_عام_إكس(الوجهة, _, _, _, _) -> { ألحق(التعريفات, طلب_إكس(الوجهة)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_عام_إكس(المصدر, _, _, _) -> { ألحق(الاستخدامات, طلب_إكس(المصدر)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_سجل_إكس(أ, ب) -> { ألحق(الاستخدامات, طلب_إكس(أ)); ألحق(الاستخدامات, طلب_إكس(ب)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_بعرض_إكس(أ, ب, _) -> { ألحق(الاستخدامات, طلب_إكس(أ)); ألحق(الاستخدامات, طلب_إكس(ب)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_فورية_إكس(أ, _, _) -> { ألحق(الاستخدامات, طلب_إكس(أ)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_فورية_إلى_منطق_إكس(الوجهة, أ, _, _, _) -> {
        ألحق(الاستخدامات, طلب_إكس(أ)); ألحق(التعريفات, طلب_إكس(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_إكس(_, الوجهة, العنوان, القيمة, _) -> {
        ألحق(الاستخدامات, طلب_إكس(العنوان)); ألحق(الاستخدامات, طلب_إكس(القيمة)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_قارن_وبدل_إكس(الوجهة, العنوان, المتوقع, الجديد, _) -> {
        ألحق(الاستخدامات, طلب_إكس(العنوان)); ألحق(الاستخدامات, طلب_إكس(المتوقع)); ألحق(الاستخدامات, طلب_إكس(الجديد)); ألحق(التعريفات, طلب_إكس(الوجهة)); يحتاج_عمل_خاص := صواب;
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_خزن_إكس(العنوان, القيمة, _) -> { ألحق(الاستخدامات, طلب_إكس(العنوان)); ألحق(الاستخدامات, طلب_إكس(القيمة)); يحتاج_عمل_خاص := صواب; }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_جدولي_إكس(المميز, _, _, _) -> { ألحق(الاستخدامات, طلب_إكس(المميز)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(الشرط, _) -> { ألحق(الاستخدامات, طلب_إكس(الشرط)); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(الخطة) -> {
        نداء := صواب;
        أضف_طلبات_نداء_إكس(&الخطة, &متغير الاستخدامات, &متغير التعريفات);
        تفضيلات_حجج_نداء_إكس(&الخطة, الهدف, &متغير المفضلة);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس_بقيمة(الناتج) -> {
        ألحق(الاستخدامات, طلب_إكس(الناتج.القيمة.السجل));
        طابق الناتج.عنوان_ناتج_غير_مباشر مع
        | اختياري.موجود(العنوان) -> { ألحق(الاستخدامات, طلب_إكس(العنوان)); }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };

    ليكن المفسدة: متغير متجه معرف_سجل_فعلي = [];
    إذا (نداء) {
        // حد النداء الحقيقي فقط يفسد سجلات caller-saved القابلة للتخصيص.
        // تعليمات الخفض الخاصة تستعمل سجلات العمل المحجوزة التي لا تدخل allocator،
        // فلا يجوز اعتبار RDI/RSI/R8/R9 مفسدة عند كل عملية حسابية/نسخ ذاكرة.
        المفسدة := انسخ_مملوكا_متجه_معرف_سجل_فعلي(المتطايرة);
    };
    ليكن الناتج: حقيقة_تعليمة_تخصيص = {
        الموضع: الموضع, الاستخدامات: الاستخدامات, التعريفات: التعريفات, القيود_المربوطة: الربط,
        السجلات_المفسدة: المفسدة, حد_نداء: نداء, قابل_للانسكاب: صواب, نقل_مفضل: نقل,
        سجلات_مفضلة: المفضلة
    };
    أرجع الناتج;
}

// Searches only the edges recorded for the current block: they start at
// البداية, because a block's edges are appended while that block is scanned.
// Scanning every earlier edge made edge construction quadratic per function.
عرف حافة_تخصيص_إكس_موجودة(
    الحواف: &متجه حقيقة_نقل_حافة_تخصيص,
    البداية: طبيعي,
    الكتلة_المصدر: معرف_كتلة_منتقاة,
    الكتلة_الهدف: معرف_كتلة_منتقاة
): منطقي {
    ليكن ح: متجه حقيقة_نقل_حافة_تخصيص = *الحواف;
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < (الطول(ح) مثل طبيعي)) {
        إذا (
            معرفا_كتلة_منتقاة_متساويان(ح[ف].من_كتلة, الكتلة_المصدر)
            && معرفا_كتلة_منتقاة_متساويان(ح[ف].إلى_كتلة, الكتلة_الهدف)
        ) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف ابن_مسألة_تخصيص_دالة_إكس(
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    الهدف: &واصف_هدف
): مسألة_تخصيص {
    ليكن د: دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *الدالة;
    ليكن الحقائق: متغير متجه حقيقة_تعليمة_تخصيص = [];
    ليكن الحواف: متغير متجه حقيقة_نقل_حافة_تخصيص = [];
    ليكن حقائق_الكتل: متغير متجه حقيقة_كتلة_تخصيص = [];
    ليكن المتطايرة: متجه معرف_سجل_فعلي = سجلات_متطايرة_للهدف(الهدف);
    ليكن الموضع: متغير طبيعي = 0;
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول(د.الكتل) مثل طبيعي)) {
        ليكن مرجع_الكتلة: &كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = &د.الكتل[ك];
        ليكن الكتلة: كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = *مرجع_الكتلة;
        ليكن بداية_الكتلة: طبيعي = الموضع;
        ليكن بداية_حواف_الكتلة: طبيعي = الطول(الحواف) مثل طبيعي;
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول(الكتلة.التعليمات) مثل طبيعي)) {
            ليكن مرجع_التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون = &الكتلة.التعليمات[ت];
            ليكن التعليمة: تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *مرجع_التعليمة;
            ألحق(الحقائق, حقيقة_تخصيص_تعليمة_إكس(&التعليمة, الهدف, &المتطايرة, الموضع));
            طابق التعليمة مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(النقلات) -> {
                ليكن نسخة_النقلات: متجه نقلة_حافة_تخصيص = حوّل_نقلات_حافة_إكس_للتخصيص(&النقلات);
                ليكن حافة: حقيقة_نقل_حافة_تخصيص = {
                    من_كتلة: الكتلة.الرأس.المعرف,
                    إلى_كتلة: النقلات.الهدف,
                    النقلات: نسخة_النقلات
                };
                ألحق(الحواف, حافة);
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(_, النقلات) -> {
                ليكن نسخة_النقلات: متجه نقلة_حافة_تخصيص = حوّل_نقلات_حافة_إكس_للتخصيص(&النقلات);
                ليكن حافة: حقيقة_نقل_حافة_تخصيص = {
                    من_كتلة: الكتلة.الرأس.المعرف,
                    إلى_كتلة: النقلات.الهدف,
                    النقلات: نسخة_النقلات
                };
                ألحق(الحواف, حافة);
            }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(_, النقلات) -> {
                ليكن نسخة_النقلات: متجه نقلة_حافة_تخصيص = حوّل_نقلات_حافة_إكس_للتخصيص(&النقلات);
                ليكن حافة: حقيقة_نقل_حافة_تخصيص = { من_كتلة: الكتلة.الرأس.المعرف, إلى_كتلة: النقلات.الهدف, النقلات: نسخة_النقلات };
                ألحق(الحواف, حافة);
            }
            | _ -> { };
            الموضع := الموضع + 1;
            ت := ت + 1;
        }
        // العقد المشترك للحياة يحتاج كل حافة CFG، حتى الحواف التي لا تحمل نقلات.
        ليكن خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الكتلة.الرأس.الخلفاء) مثل طبيعي)) {
            ليكن اللاحق: معرف_كتلة_منتقاة = الكتلة.الرأس.الخلفاء[خ];
            إذا (!حافة_تخصيص_إكس_موجودة(&الحواف, بداية_حواف_الكتلة, الكتلة.الرأس.المعرف, اللاحق)) {
                ليكن لا_نقلات: متجه نقلة_حافة_تخصيص = [];
                ليكن حافة: حقيقة_نقل_حافة_تخصيص = {
                    من_كتلة: الكتلة.الرأس.المعرف,
                    إلى_كتلة: اللاحق,
                    النقلات: لا_نقلات
                };
                ألحق(الحواف, حافة);
            };
            خ := خ + 1;
        }
        ليكن حقيقة_الكتلة: حقيقة_كتلة_تخصيص = {
            المعرف: الكتلة.الرأس.المعرف,
            البداية: بداية_الكتلة,
            النهاية: الموضع
        };
        ألحق(حقائق_الكتل, حقيقة_الكتلة);
        ك := ك + 1;
    }
    ليكن المتاحة: متجه سجل_فعلي_متاح = سجلات_إكس_متاحة_للتخصيص(الهدف);
    ليكن بلا_ممتدة: متجه متجه طبيعي = [];
    ليكن الناتج: مسألة_تخصيص = {
        عدد_السجلات_الافتراضية: د.الرأس.عدد_السجلات_الافتراضية,
        التعليمات: الحقائق,
        نقلات_الحواف: الحواف,
        الكتل: حقائق_الكتل,
        السجلات_المتاحة: المتاحة,
        بالمقاطع: صواب,
        القيم_الممتدة: بلا_ممتدة
    };
    أرجع الناتج;
}
