// ناتج x86_64 المشفر يملك بايتات ISA وتثبيتات الفروع الداخلية وإزاحات النداء الرمزية فقط.
// سياسة ELF تبقى خارج المعمارية.
عام نوع موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
    الدالة: معرف_دالة_منتقاة,
    إزاحة_بايت: غير_موقع,
    حجم_بايت: غير_موقع
};

عام نوع تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون = {
    الدالة: معرف_دالة_منتقاة,
    إزاحة_الحقل: غير_موقع,
    بعد_التعليمة: غير_موقع,
    الهدف: معرف_كتلة_منتقاة,
    إزاحة_الهدف: غير_موقع
};

عام نوع إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون = {
    إزاحة_بايت: غير_موقع,
    الرمز: مرجع_رمز_كائن,
    الإضافة: عدد
};

// موضع مهايئ دخول العملية الذي تنتجه طبقة نظام Linux/x86_64.
// ELF يستهلك هذا الموضع لاحقا كـ e_entry؛ ولا يولد أي تعليمة CPU بنفسه.
عام نوع دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون = {
    إزاحة_بايت: غير_موقع,
    حجم_بايت: غير_موقع
};

عام نوع شفرة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة = {
    الهدف: معرف_هدف,
    البيانات: متجه غ8,
    الدوال: متجه موضع_دالة_إكس_ستة_وثمانون_أربعة_وستون_مشفرة,
    تثبيتات_الفروع: متجه تثبيت_فرع_إكس_ستة_وثمانون_أربعة_وستون,
    إزاحات_النداء: متجه إزاحة_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    دخول_عملية_لينكس: اختيار دخول_عملية_لينكس_إكس_ستة_وثمانون_أربعة_وستون
};
