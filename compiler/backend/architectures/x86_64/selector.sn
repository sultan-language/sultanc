عام نوع سبب_فشل_تخطيط_اختيار_إكس =
    | استعلام_قيمة بنوع فشل_تخطيط_قيمة_للاختيار
    | بنية_تخطيط_غير_متوافقة بنوع معرف_قيمة_مسير
    | جزء_تخطيط_مفقود بنوع (معرف_قيمة_مسير, طبيعي)
    | عرض_قيمة_غير_مدعوم بنوع (معرف_قيمة_مسير, طبيعي)
    | حمولة_منشئ_مؤجلة بنوع (معرف_قيمة_مسير, سبب_تأجيل_تخطيط)
    | حمولة_منشئ_مرفوضة بنوع (معرف_قيمة_مسير, خطأ_تخطيط)
    | حمولة_منشئ_مفقودة بنوع (معرف_قيمة_مسير, طبيعي)
;

// منتقي x86_64 يستهلك MSIR المتحقق مباشرة ويصدر نموذج Selected Code الموجود.
// الحالات التي لا يملك النموذج الحالي تمثيلا صحيحا لها ترفض صراحة ولا تسقط دلالتها.
عام نوع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون =
    | هدف_ليس_إكس_ستة_وثمانون_أربعة_وستون بنوع معرف_هدف
    | دالة_مسير_مفقودة بنوع معرف_دالة_مسير
    | كتلة_مسير_مفقودة بنوع معرف_كتلة_مسير
    | ناتج_تعليمة_مفقود
    | نوع_غير_مدعوم
    | ثابت_غير_مدعوم
    | تحويل_غير_مدعوم
    | حساب_غير_مدعوم
    | مقارنة_غير_مدعومة
    | مقارنة_ليست_شرط_المنهي
    | عملية_غير_مدعومة
    | منهي_غير_مدعوم
    | معاملات_كتلة_غير_مدعومة بنوع معرف_كتلة_مسير
    | واجهة_دالة_غير_مدعومة
    | فشل_حل_واجهة بنوع خطأ_حل_واجهة_اختيار
    | نداء_دالة_غير_مدعوم
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | تخطيط_غير_متاح بنوع سبب_فشل_تخطيط_اختيار_إكس
;

عرف ألحق_تعليمة_إكس_للاختيار(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    التعليمة: تعليمة_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    ألحق(*التعليمات, التعليمة);
}

عرف ألحق_خلفا_إكس_للاختيار(
    الخلفاء: &متغير متجه معرف_كتلة_منتقاة,
    الخلف: معرف_كتلة_منتقاة
): فراغ {
    ألحق(*الخلفاء, الخلف);
}

عرف ألحق_طلب_موضع_إكس_للاختيار(
    المواضع: &متغير متجه طلب_موضع_محلي_إكس,
    الطلب: طلب_موضع_محلي_إكس
): فراغ {
    ألحق(*المواضع, الطلب);
}

عام نوع فئة_عملية_اختيار_إكس =
    | ثابت
    | حساب_صحيح
    | مقارنة_صحيح
    | تحويل_صحيح
    | تحويل_عائم
    | حساب_عشري
    | مقارنة_عشري
    | مرجع_إلى_مؤشر
    | نقل_تسلسل_مملوك
    | تجميع
    | تهيئة_متجه
    | استخراج_حقل
    | استخراج_فهرس
    | مكان_محلي
    | مكان_عام
    | مرجع_إلى_مكان
    | صندوق_إلى_مكان
    | مكان_حقل
    | مكان_فهرس
    | موضع_تخزين_عنصر_مؤشر
    | تحميل
    | تخزين
    | مكان_إلى_مرجع
    | بناء_موسوم
    | استعلام_وسم
    | استخراج_حمولة
    | بناء_صندوق
    | بناء_إغلاق
    | استخراج_التقاط
    | نداء
;

عرف فئة_عملية_اختيار_إكس_من(العملية: &عملية_مسير): فئة_عملية_اختيار_إكس {
    دع الحالة: عملية_مسير = *العملية;
    طابق الحالة مع
    | عملية_مسير.ثابت(_) -> { أرجع فئة_عملية_اختيار_إكس.ثابت(); }
    | عملية_مسير.حساب_صحيح(_) -> { أرجع فئة_عملية_اختيار_إكس.حساب_صحيح(); }
    | عملية_مسير.مقارنة_صحيح(_) -> { أرجع فئة_عملية_اختيار_إكس.مقارنة_صحيح(); }
    | عملية_مسير.تحويل_صحيح(_) -> { أرجع فئة_عملية_اختيار_إكس.تحويل_صحيح(); }
    | عملية_مسير.تحويل_عائم(_) -> { أرجع فئة_عملية_اختيار_إكس.تحويل_عائم(); }
    | عملية_مسير.حساب_عشري(_) -> { أرجع فئة_عملية_اختيار_إكس.حساب_عشري(); }
    | عملية_مسير.مقارنة_عشري(_) -> { أرجع فئة_عملية_اختيار_إكس.مقارنة_عشري(); }
    | عملية_مسير.نقل_تسلسل_مملوك(_) -> { أرجع فئة_عملية_اختيار_إكس.نقل_تسلسل_مملوك(); }
    | عملية_مسير.مرجع_إلى_مؤشر(_) -> { أرجع فئة_عملية_اختيار_إكس.مرجع_إلى_مؤشر(); }
    | عملية_مسير.تجميع(_) -> { أرجع فئة_عملية_اختيار_إكس.تجميع(); }
    | عملية_مسير.تهيئة_متجه(_) -> { أرجع فئة_عملية_اختيار_إكس.تهيئة_متجه(); }
    | عملية_مسير.استخراج_حقل(_) -> { أرجع فئة_عملية_اختيار_إكس.استخراج_حقل(); }
    | عملية_مسير.استخراج_فهرس(_) -> { أرجع فئة_عملية_اختيار_إكس.استخراج_فهرس(); }
    | عملية_مسير.مكان_محلي(_) -> { أرجع فئة_عملية_اختيار_إكس.مكان_محلي(); }
    | عملية_مسير.مكان_عام(_) -> { أرجع فئة_عملية_اختيار_إكس.مكان_عام(); }
    | عملية_مسير.مرجع_إلى_مكان(_) -> { أرجع فئة_عملية_اختيار_إكس.مرجع_إلى_مكان(); }
    | عملية_مسير.صندوق_إلى_مكان(_) -> { أرجع فئة_عملية_اختيار_إكس.صندوق_إلى_مكان(); }
    | عملية_مسير.مكان_حقل(_) -> { أرجع فئة_عملية_اختيار_إكس.مكان_حقل(); }
    | عملية_مسير.مكان_فهرس(_) -> { أرجع فئة_عملية_اختيار_إكس.مكان_فهرس(); }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(_) -> { أرجع فئة_عملية_اختيار_إكس.موضع_تخزين_عنصر_مؤشر(); }
    | عملية_مسير.تحميل(_) -> { أرجع فئة_عملية_اختيار_إكس.تحميل(); }
    | عملية_مسير.تخزين(_) -> { أرجع فئة_عملية_اختيار_إكس.تخزين(); }
    | عملية_مسير.مكان_إلى_مرجع(_) -> { أرجع فئة_عملية_اختيار_إكس.مكان_إلى_مرجع(); }
    | عملية_مسير.بناء_موسوم(_) -> { أرجع فئة_عملية_اختيار_إكس.بناء_موسوم(); }
    | عملية_مسير.استعلام_وسم(_) -> { أرجع فئة_عملية_اختيار_إكس.استعلام_وسم(); }
    | عملية_مسير.استخراج_حمولة(_) -> { أرجع فئة_عملية_اختيار_إكس.استخراج_حمولة(); }
    | عملية_مسير.بناء_صندوق(_) -> { أرجع فئة_عملية_اختيار_إكس.بناء_صندوق(); }
    | عملية_مسير.بناء_إغلاق(_) -> { أرجع فئة_عملية_اختيار_إكس.بناء_إغلاق(); }
    | عملية_مسير.استخراج_التقاط(_) -> { أرجع فئة_عملية_اختيار_إكس.استخراج_التقاط(); }
    | عملية_مسير.نداء(_) -> { أرجع فئة_عملية_اختيار_إكس.نداء(); };
}

عام نوع فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
    الدالة: اختياري معرف_دالة_مسير,
    الكتلة: اختياري معرف_كتلة_مسير,
    فهرس_التعليمة: اختياري طبيعي,
    العملية: اختياري فئة_عملية_اختيار_إكس,
    السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون
};

عرف فشل_اختيار_إكس_عام(السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون): فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع لا_دالة: اختياري معرف_دالة_مسير = اختياري.لا_شيء();
    دع لا_كتلة: اختياري معرف_كتلة_مسير = اختياري.لا_شيء();
    دع لا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
    دع لا_عملية: اختياري فئة_عملية_اختيار_إكس = اختياري.لا_شيء();
    دع الفشل: فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
        الدالة: لا_دالة, الكتلة: لا_كتلة, فهرس_التعليمة: لا_فهرس, العملية: لا_عملية, السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_إكس_في_دالة(الدالة: معرف_دالة_مسير, السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون): فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع له_دالة: اختياري معرف_دالة_مسير = اختياري.موجود(الدالة);
    دع لا_كتلة: اختياري معرف_كتلة_مسير = اختياري.لا_شيء();
    دع لا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
    دع لا_عملية: اختياري فئة_عملية_اختيار_إكس = اختياري.لا_شيء();
    دع الفشل: فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
        الدالة: له_دالة, الكتلة: لا_كتلة, فهرس_التعليمة: لا_فهرس, العملية: لا_عملية, السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_إكس_في_كتلة(الدالة: معرف_دالة_مسير, الكتلة: معرف_كتلة_مسير, السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون): فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع له_دالة: اختياري معرف_دالة_مسير = اختياري.موجود(الدالة);
    دع له_كتلة: اختياري معرف_كتلة_مسير = اختياري.موجود(الكتلة);
    دع لا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
    دع لا_عملية: اختياري فئة_عملية_اختيار_إكس = اختياري.لا_شيء();
    دع الفشل: فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
        الدالة: له_دالة, الكتلة: له_كتلة, فهرس_التعليمة: لا_فهرس, العملية: لا_عملية, السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_إكس_في_تعليمة(
    الدالة: معرف_دالة_مسير, الكتلة: معرف_كتلة_مسير, الفهرس: طبيعي,
    العملية: فئة_عملية_اختيار_إكس, السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون
): فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع له_دالة: اختياري معرف_دالة_مسير = اختياري.موجود(الدالة);
    دع له_كتلة: اختياري معرف_كتلة_مسير = اختياري.موجود(الكتلة);
    دع له_فهرس: اختياري طبيعي = اختياري.موجود(الفهرس);
    دع له_عملية: اختياري فئة_عملية_اختيار_إكس = اختياري.موجود(العملية);
    دع الفشل: فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
        الدالة: له_دالة, الكتلة: له_كتلة, فهرس_التعليمة: له_فهرس, العملية: له_عملية, السبب: السبب
    };
    أرجع الفشل;
}

عام نوع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون =
    | نجح بنوع شفرة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | خطأ بنوع فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون
;

نوع مقارنة_إكس_مؤجلة = {
    الناتج: معرف_قيمة_مسير,
    الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون
};

نوع ثابت_صحيح_إكس =
    | موقع بنوع عدد
    | طبيعي بنوع طبيعي
;

نوع تجهيز_معامل_تجميعي_إكس = {
    المعرف: معرف_قيمة_مسير,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    الأجزاء: متجه معرف_سجل_افتراضي,
    أحجام_الأجزاء: متجه طبيعي,
    // The parts on the stack, received only when stored (no move clobbers
    // a stack position), so that each lives for one instruction.
    أجزاء_المكدس: متجه اختياري موضع_جزء_واجهة
};

نوع تجهيز_معامل_مفرد_إكس = {
    الوجهة: معرف_سجل_افتراضي,
    الحامل: معرف_سجل_افتراضي
};

// What a function's selection knows about copies of composite values: the
// codes of رموز_نسخ_قيم_مسير (msir_analysis.sn) and the register holding the
// address of the caller's result storage when the result returns through it.
نوع حقائق_نسخ_إكس = {
    النسخ: حقائق_نسخ_قيم_مسير,
    عنوان_الناتج: اختياري معرف_سجل_افتراضي,
    // مخازن_ثابتة_للنداء_مسير: the values a hidden-reference argument may
    // pass by the address of their own bytes.
    الثابتة: متجه منطقي
};

// Whether an argument's plan entry is an internal hidden reference: an
// aggregate passed indirectly that the callee never writes.
عرف مرجع_خفي_واجهة_إكس(المعامل: &خطة_معامل_واجهة): منطقي {
    إذا (!(*المعامل).التصنيف.تجميعي || (*المعامل).التصنيف.نسخة_للمستدعى) { أرجع خطأ; };
    أرجع موقع_واجهة_غير_مباشر_إكس(&(*المعامل).الموقع);
}

// The selected argument of one call argument. A hidden reference travels as
// a pointer, the address of the value's own bytes when nothing can change
// them during the call (مخازن_ثابتة_للنداء_مسير, the copy-elision rule in
// compiler/msir/msir_copies.sn), else of a copy made in a local slot of the
// call; every other argument as its plan places it.
عرف حجة_نداء_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    عدد_السجلات: &متغير طبيعي,
    الثابتة: &متجه منطقي,
    القيمة: معرف_قيمة_مسير,
    المعامل: &خطة_معامل_واجهة
): قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة {
    دع سجل_القيمة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(القيمة);
    إذا (!مرجع_خفي_واجهة_إكس(المعامل)) {
        أرجع قيمة_واجهة_من_خطة_إكس(سجل_القيمة, &(*المعامل).التصنيف, &(*المعامل).الموقع);
    };
    دع العنوان: متغير معرف_سجل_افتراضي = سجل_القيمة;
    دع ثابتة: منطقي = (القيمة.القيمة مثل طبيعي) < (الطول(*الثابتة) مثل طبيعي) && (*الثابتة)[القيمة.القيمة];
    إذا (!ثابتة) {
        دع النسخة: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
        *عدد_السجلات := *عدد_السجلات + 1;
        أضف_طلب_موضع_محلي_إكس(
            المواضع_المحلية, النسخة.القيمة,
            حجم_موضع_تجميعي_واجهة_إكس((*المعامل).التصنيف.الحجم), (*المعامل).التصنيف.المحاذاة
        );
        ألحق_تعليمة_إكس_للاختيار(التعليمات,
            تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(النسخة, النسخة.القيمة));
        ألحق_تعليمة_إكس_للاختيار(التعليمات,
            تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نسخ_ذاكرة_إكس(النسخة, سجل_القيمة, (*المعامل).التصنيف.الحجم, 0, 0));
        العنوان := النسخة;
    };
    دع الحجة: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
        السجل: العنوان,
        المواضع: مواضع_واجهة_إكس(&(*المعامل).الموقع),
        الحجم: 8,
        تجميعي: خطأ,
        غير_مباشر: خطأ
    };
    أرجع الحجة;
}

عرف رمز_نسخ_إكس(الحقائق: &حقائق_نسخ_إكس, القيمة: معرف_قيمة_مسير): طبيعي {
    إذا ((القيمة.القيمة مثل طبيعي) < (الطول((*الحقائق).النسخ.الرموز) مثل طبيعي)) {
        أرجع (*الحقائق).النسخ.الرموز[القيمة.القيمة];
    };
    أرجع 0;
}

// The value a code 4 load stands for, or the owner of a code 3 value.
عرف مصدر_نسخ_إكس(الحقائق: &حقائق_نسخ_إكس, القيمة: معرف_قيمة_مسير): معرف_قيمة_مسير {
    دع المصدر: متغير طبيعي = 0;
    إذا ((القيمة.القيمة مثل طبيعي) < (الطول((*الحقائق).النسخ.المصادر) مثل طبيعي)) {
        المصدر := (*الحقائق).النسخ.المصادر[القيمة.القيمة];
    };
    أرجع معرف_قيمة_مسير_من(القيمة.الدالة, المصدر);
}

// Whether the value (code 2) is built in the result storage.
عرف مبني_في_الناتج_إكس(الحقائق: &حقائق_نسخ_إكس, القيمة: معرف_قيمة_مسير): منطقي {
    إذا (رمز_نسخ_إكس(الحقائق, القيمة) == 4) {
        // A load standing for a value built there.
        دع المصدر: معرف_قيمة_مسير = مصدر_نسخ_إكس(الحقائق, القيمة);
        أرجع رمز_نسخ_إكس(الحقائق, المصدر) == 2 && مبني_في_الناتج_إكس(الحقائق, المصدر);
    };
    طابق عنوان_ناتج_للبناء_إكس(الحقائق, القيمة) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The result-storage register when the value (code 2) is built there.
عرف عنوان_ناتج_للبناء_إكس(الحقائق: &حقائق_نسخ_إكس, القيمة: معرف_قيمة_مسير): اختياري معرف_سجل_افتراضي {
    إذا (رمز_نسخ_إكس(الحقائق, القيمة) != 2) { أرجع اختياري.لا_شيء(); };
    أرجع (*الحقائق).عنوان_الناتج;
}

عرف خطأ_استعلام_تخطيط_إكس(الفشل: فشل_تخطيط_قيمة_للاختيار): خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.استعلام_قيمة(الفشل);
    أرجع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب);
}

عرف خطأ_بنية_تخطيط_إكس(القيمة: معرف_قيمة_مسير): خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.بنية_تخطيط_غير_متوافقة(القيمة);
    أرجع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب);
}

عرف خطأ_جزء_تخطيط_إكس(القيمة: معرف_قيمة_مسير, الفهرس: طبيعي): خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.جزء_تخطيط_مفقود(القيمة, الفهرس);
    أرجع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب);
}

عرف خطأ_عرض_تخطيط_إكس(القيمة: معرف_قيمة_مسير, الحجم: طبيعي): خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(القيمة, الحجم);
    أرجع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب);
}

// The C call at an address on native Windows (as the LLVM provider lowers
// it): the eight integer words are the arguments by position, the first four
// in RCX/RDX/R8/R9 and also in XMM0-XMM3 (the Win64 variadic rule, so an
// integer or a floating parameter finds its bits), the next four in the
// stack slots above the home area; the float words are unused.
عرف ألحق_نداء_عنوان_سي_ويندوز_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    إذا ((الطول(*الحجج) مثل طبيعي) != 18) {
        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
    | اختياري.موجود(_) -> { };
    دع حجج_سي: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 2;
    طالما (ف < 10) { ألحق(حجج_سي, (*الحجج)[ف]); ف := ف + 1; }
    طابق حل_واجهة_نداء_خارجي_قيم_مسير_للهدف(
        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &حجج_سي, الناتج
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ)); }
    | نتيجة.نجح(الخطة_الأساس) -> {
        دع الخطة: متغير خطة_دالة_واجهة = الخطة_الأساس;
        دع ك: متغير طبيعي = 0;
        طالما (ك < 4) {
            ألحق(حجج_سي, (*الحجج)[2 + ك]);
            دع المرجع: مرجع_سجل_واجهة = {
                الفئة: فئة_سجل_واجهة.عائم_متجه(), الفهرس: ك, الدور: دور_سجل_واجهة.معامل(),
                الحفظ: حفظ_سجل_واجهة.متطاير_عبر_النداء()
            };
            دع التصنيف: متغير تصنيف_قيمة_واجهة = الخطة.المعاملات[ك].التصنيف;
            التصنيف.فئة_السجل := اختياري.موجود(فئة_سجل_واجهة.عائم_متجه());
            دع لا_أشكال: متجه شكل_جزء_واجهة = [];
            دع النسخة: خطة_معامل_واجهة = {
                الفهرس: 8 + ك,
                النوع: الخطة.المعاملات[ك].النوع,
                التصنيف: التصنيف,
                الموقع: موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.سجل(المرجع)),
                أشكال_الأجزاء: لا_أشكال
            };
            ألحق(الخطة.المعاملات, النسخة);
            ك := ك + 1;
        }
        دع هدف_سي: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون =
            هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.عنوان_سي(سجل_إكس_لقيمة_مسير((*الحجج)[1]));
        دع بلا_سجلات: متغير طبيعي = 0;
        دع بلا_ثابتة: متجه منطقي = [];
        أرجع ألحق_نداء_إكس_بخطة(
            التعليمات, المواضع_المحلية, &متغير بلا_سجلات, &بلا_ثابتة, هدف_سي, &حجج_سي, الناتج, &الخطة
        );
    };
}

// A C variadic call on native Windows (Microsoft x64, "Varargs"): a
// floating-point variadic argument in one of the four register slots also
// travels in that slot's integer register (RCX, RDX, R8 or R9), where the
// callee's va_arg reads it after spilling the registers to the home area.
// Each such argument gets a second plan entry, its slot's integer register,
// fed the same value (the selector keeps a float's bits in an integer
// virtual register; the encoder moves them as they are). Variadic arguments
// in stack slots and integer ones need nothing more.
عرف ضاعف_عائمات_متغيرة_ويندوز_إكس(
    الخطة: &متغير خطة_دالة_واجهة,
    الحجج: &متغير متجه معرف_قيمة_مسير,
    الثابتة: طبيعي
): فراغ {
    دع العدد: طبيعي = الطول((*الخطة).المعاملات) مثل طبيعي;
    دع ف: متغير طبيعي = الثابتة;
    طالما (ف < العدد && ف < (الطول(*الحجج) مثل طبيعي)) {
        دع الخانة: متغير طبيعي = 4;
        طابق (*الخطة).المعاملات[ف].الموقع مع
        | موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.سجل(المرجع)) -> {
            إذا (المرجع.الفئة == فئة_سجل_واجهة.عائم_متجه()) { الخانة := المرجع.الفهرس; };
        }
        | _ -> { };
        إذا (الخانة < 4) {
            دع المرجع_الصحيح: مرجع_سجل_واجهة = {
                الفئة: فئة_سجل_واجهة.عدد_صحيح(), الفهرس: فهرس_سجل_معامل_مايكروسوفت_إكس(الخانة),
                الدور: دور_سجل_واجهة.معامل(), الحفظ: حفظ_سجل_واجهة.متطاير_عبر_النداء()
            };
            دع التصنيف: متغير تصنيف_قيمة_واجهة = (*الخطة).المعاملات[ف].التصنيف;
            التصنيف.فئة_السجل := اختياري.موجود(فئة_سجل_واجهة.عدد_صحيح());
            دع لا_أشكال: متجه شكل_جزء_واجهة = [];
            دع النسخة: خطة_معامل_واجهة = {
                الفهرس: (الطول((*الخطة).المعاملات) مثل طبيعي),
                النوع: (*الخطة).المعاملات[ف].النوع,
                التصنيف: التصنيف,
                الموقع: موقع_تمرير_واجهة.مباشر(موضع_جزء_واجهة.سجل(المرجع_الصحيح)),
                أشكال_الأجزاء: لا_أشكال
            };
            ألحق((*الخطة).المعاملات, النسخة);
            ألحق(*الحجج, (*الحجج)[ف]);
        };
        ف := ف + 1;
    }
}

// The C entry of a closure on native Windows and macOS is one fixed
// trampoline the native output appends after the MSIR functions, with the
// first function id past them (معرف_مدخل_سي_ويندوز_إكس); its address is the
// primitive's value.
عام عرف معرف_مدخل_سي_ويندوز_إكس(المسير: &سياق_مستهلك_مسير): معرف_دالة_منتقاة {
    دع المعرف: معرف_دالة_منتقاة = { القيمة: عدد_دوال_مسير(المسير) };
    أرجع المعرف;
}

عرف ألحق_مدخل_سي_ويندوز_إكس(
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم,
    الناتج: اختياري معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    إذا (تركيب_الهدف_الأصلي(الهدف) != هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_ويندوز_كوف()
        && تركيب_الهدف_الأصلي(الهدف) != هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_داروين_ماتشو()
        && !هدف_نواة_فري_بي_إس_دي_مباشر(الهدف)) {
        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
    | اختياري.موجود(المعرف) -> {
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(
            سجل_إكس_لقيمة_مسير(المعرف), معرف_مدخل_سي_ويندوز_إكس(المسير)
        ));
        أرجع اختياري.لا_شيء();
    };
}

عرف سجل_إكس_لقيمة_مسير(المعرف: معرف_قيمة_مسير): معرف_سجل_افتراضي {
    أرجع معرف_سجل_افتراضي_من(المعرف.القيمة);
}

عرف مقياس_عنصر_إكس(الحجم: طبيعي): اختياري طبيعي {
    إذا (الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8) {
        أرجع اختياري.موجود(الحجم);
    };
    أرجع اختياري.لا_شيء();
}

عرف دالة_إكس_من_مسير(المعرف: معرف_دالة_مسير): معرف_دالة_منتقاة {
    دع الناتج: معرف_دالة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عرف كتلة_إكس_من_مسير(المعرف: معرف_كتلة_مسير): معرف_كتلة_منتقاة {
    دع الناتج: معرف_كتلة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عرف موضع_واجهة_صحيح_مدعوم_لإكس(
    الموضع: &موضع_جزء_واجهة,
    الدور: دور_سجل_واجهة
): منطقي {
    طابق *الموضع مع
    | موضع_جزء_واجهة.سجل(المرجع) -> {
        أرجع المرجع.الفئة == فئة_سجل_واجهة.عدد_صحيح() && المرجع.الدور == الدور;
    }
    | موضع_جزء_واجهة.مكدس(المكدس) -> {
        إذا (الدور != دور_سجل_واجهة.معامل()) { أرجع خطأ; };
        أرجع المكدس.الحجم == 8 && المكدس.المحاذاة == 8 && (المكدس.الإزاحة % 8) == 0;
    };
}

عرف مواضع_واجهة_إكس(الموقع: &موقع_تمرير_واجهة): متجه موضع_جزء_واجهة {
    دع الناتج: متغير متجه موضع_جزء_واجهة = [];
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الموضع) -> { ألحق(الناتج, الموضع); }
    | موقع_تمرير_واجهة.مجزأ(المواضع) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المواضع) مثل طبيعي)) {
            ألحق(الناتج, المواضع[ف]);
            ف := ف + 1;
        }
    }
    | موقع_تمرير_واجهة.غير_مباشر(الموضع) -> { ألحق(الناتج, الموضع); }
    | موقع_تمرير_واجهة.متجاهل -> { };
    أرجع الناتج;
}

عرف موقع_واجهة_غير_مباشر_إكس(الموقع: &موقع_تمرير_واجهة): منطقي {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف قيمة_واجهة_من_خطة_إكس(
    السجل: معرف_سجل_افتراضي,
    التصنيف: &تصنيف_قيمة_واجهة,
    الموقع: &موقع_تمرير_واجهة
): قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة {
    دع ت: تصنيف_قيمة_واجهة = *التصنيف;
    دع المواضع: متجه موضع_جزء_واجهة = مواضع_واجهة_إكس(الموقع);
    دع غير_مباشر: منطقي = موقع_واجهة_غير_مباشر_إكس(الموقع);
    دع الناتج: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
        السجل: السجل,
        المواضع: المواضع,
        الحجم: ت.الحجم,
        تجميعي: ت.تجميعي,
        غير_مباشر: غير_مباشر
    };
    أرجع الناتج;
}

عرف حد_عدد_موقع_موجب(): عدد {
    دع صفر: طبيعي = 0;
    دع كل_البتات: طبيعي = ~(صفر);
    دع الأعلى_طبيعي: طبيعي = كل_البتات >> 1;
    أرجع الأعلى_طبيعي مثل عدد;
}

عرف حد_عدد_موقع_سالب(): عدد {
    دع الأعلى: عدد = حد_عدد_موقع_موجب();
    أرجع -الأعلى - 1;
}

عرف جمع_موقع_آمن(أ: عدد, ب: عدد): منطقي {
    دع الأعلى: عدد = حد_عدد_موقع_موجب();
    دع الأدنى: عدد = حد_عدد_موقع_سالب();
    إذا (ب > 0) {
        أرجع أ <= الأعلى - ب;
    };
    إذا (ب < 0) {
        أرجع أ >= الأدنى - ب;
    };
    أرجع صواب;
}

عرف طرح_موقع_آمن(أ: عدد, ب: عدد): منطقي {
    دع الأعلى: عدد = حد_عدد_موقع_موجب();
    دع الأدنى: عدد = حد_عدد_موقع_سالب();
    إذا (ب < 0) {
        أرجع أ <= الأعلى + ب;
    };
    إذا (ب > 0) {
        أرجع أ >= الأدنى + ب;
    };
    أرجع صواب;
}

عرف حد_طبيعي_أقصى(): طبيعي {
    دع الأعلى_الموقع: طبيعي = حد_عدد_موقع_موجب() مثل طبيعي;
    أرجع (الأعلى_الموقع * 2) + 1;
}

عرف شرط_إكس_من_مقارنة(
    العملية: عملية_مقارنة_صحيح,
    الإشارة: صنف_إشارة_عدد_خلفية
): شرط_إكس_ستة_وثمانون_أربعة_وستون {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> {
        أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ();
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> {
        أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.لاتكافؤ();
    }
    | عملية_مقارنة_صحيح.أصغر -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة();
        }
        | صنف_إشارة_عدد_خلفية.طبيعي -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي();
        };
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو();
        }
        | صنف_إشارة_عدد_خلفية.طبيعي -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي_أو_مساو();
        };
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة();
        }
        | صنف_إشارة_عدد_خلفية.طبيعي -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي();
        };
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو();
        }
        | صنف_إشارة_عدد_خلفية.طبيعي -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي_أو_مساو();
        };
    };
}

عرف حزمة_نقل_حافة_إكس(
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير
): نتيجة متطلبات_نقل_حافة_منتقاة, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع القيمة: حافة_مسير = *الحافة;
    طابق ابحث_كتلة_مسير(المسير, القيمة.الهدف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(المعرف) -> {
        أرجع نتيجة.خطأ(
            خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.كتلة_مسير_مفقودة(المعرف)
        );
    }
    | نتيجة_بحث_كتلة_مسير.موجودة(الهدف) -> {
        إذا ((الطول(القيمة.الحجج) مثل طبيعي) != الهدف.عدد_المعاملات) {
            أرجع نتيجة.خطأ(
                خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.معاملات_كتلة_غير_مدعومة(القيمة.الهدف)
            );
        };
        دع النقلات: متغير متجه نقلة_حافة_منتقاة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < الهدف.عدد_المعاملات) {
            طابق معامل_كتلة_مسير_عند(المسير, القيمة.الهدف, ف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(
                    خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.معاملات_كتلة_غير_مدعومة(القيمة.الهدف)
                );
            }
            | اختياري.موجود(المعامل) -> {
                دع المصدر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(القيمة.الحجج[ف]);
                دع الوجهة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المعامل.المعرف);
                دع النقلة: نقلة_حافة_منتقاة = {
                    المصدر: المصدر,
                    الوجهة: الوجهة
                };
                ألحق(النقلات, النقلة);
            };
            ف := ف + 1;
        }
        دع هدف_الحزمة: معرف_كتلة_منتقاة = كتلة_إكس_من_مسير(القيمة.الهدف);
        دع الحزمة: متطلبات_نقل_حافة_منتقاة = {
            الهدف: هدف_الحزمة,
            النقلات: النقلات
        };
        أرجع نتيجة.نجح(الحزمة);
    };
}


عرف بتات_قيمة_عدد_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختياري طبيعي {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع بتات_عدد_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف بتات_قيمة_مصدر_تحويل_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختياري طبيعي {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        طابق وصف_نوع_لتحويل_صحيح_للاختيار(&حقائق.الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الوصف) -> { أرجع اختياري.موجود(الوصف.البتات); };
    };
}

عرف بتات_قيمة_عائمة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختياري طبيعي {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع بتات_عائم_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف حساب_عشري_إكس_من_مسير(العملية: عملية_حساب_عشري): حساب_عشري_إكس_كامل {
    طابق العملية مع
    | عملية_حساب_عشري.جمع -> { أرجع حساب_عشري_إكس_كامل.جمع(); }
    | عملية_حساب_عشري.طرح -> { أرجع حساب_عشري_إكس_كامل.طرح(); }
    | عملية_حساب_عشري.ضرب -> { أرجع حساب_عشري_إكس_كامل.ضرب(); }
    | عملية_حساب_عشري.قسمة -> { أرجع حساب_عشري_إكس_كامل.قسمة(); };
}

عرف مقارنة_عشرية_إكس_من_مسير(العملية: عملية_مقارنة_عشري): مقارنة_عشرية_إكس_كاملة {
    طابق العملية مع
    | عملية_مقارنة_عشري.يساوي -> { أرجع مقارنة_عشرية_إكس_كاملة.يساوي(); }
    | عملية_مقارنة_عشري.لا_يساوي -> { أرجع مقارنة_عشرية_إكس_كاملة.لا_يساوي(); }
    | عملية_مقارنة_عشري.أصغر -> { أرجع مقارنة_عشرية_إكس_كاملة.أصغر(); }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { أرجع مقارنة_عشرية_إكس_كاملة.أصغر_أو_يساوي(); }
    | عملية_مقارنة_عشري.أكبر -> { أرجع مقارنة_عشرية_إكس_كاملة.أكبر(); }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { أرجع مقارنة_عشرية_إكس_كاملة.أكبر_أو_يساوي(); };
}

عرف وصف_تحويل_لقيمة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختياري وصف_تحويل_صحيح_خلفية {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع وصف_نوع_لتحويل_صحيح_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف عرض_عدد_إكس_مدعوم(البتات: طبيعي): منطقي {
    أرجع البتات == 8 || البتات == 16 || البتات == 32 || البتات == 64;
}

عرف قناع_عرض_عدد_إكس(البتات: طبيعي): طبيعي {
    إذا (البتات >= 64) { أرجع حد_طبيعي_أقصى(); };
    إذا (البتات == 32) { أرجع 4294967295; };
    إذا (البتات == 16) { أرجع 65535; };
    إذا (البتات == 8) { أرجع 255; };
    أرجع 0;
}

عرف بإشارة_لقيمة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): منطقي {
    طابق صنف_إشارة_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, القيمة) مع
    | اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف حساب_إكس_من_مسير(العملية: عملية_حساب_صحيح): حساب_صحيح_إكس_كامل {
    طابق العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع حساب_صحيح_إكس_كامل.جمع(); }
    | عملية_حساب_صحيح.طرح -> { أرجع حساب_صحيح_إكس_كامل.طرح(); }
    | عملية_حساب_صحيح.ضرب -> { أرجع حساب_صحيح_إكس_كامل.ضرب(); }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع حساب_صحيح_إكس_كامل.قسمة_موقعة(); }
    | عملية_حساب_صحيح.قسمة_طبيعية -> { أرجع حساب_صحيح_إكس_كامل.قسمة_طبيعية(); }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع حساب_صحيح_إكس_كامل.باقي_موقع(); }
    | عملية_حساب_صحيح.باقي_طبيعي -> { أرجع حساب_صحيح_إكس_كامل.باقي_طبيعي(); }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع حساب_صحيح_إكس_كامل.أو_بتي(); }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع حساب_صحيح_إكس_كامل.أو_حصري(); }
    | عملية_حساب_صحيح.و_بتي -> { أرجع حساب_صحيح_إكس_كامل.و_بتي(); }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع حساب_صحيح_إكس_كامل.إزاحة_يسرى(); }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع حساب_صحيح_إكس_كامل.إزاحة_يمنى(); }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع حساب_صحيح_إكس_كامل.إزاحة_حسابية_يمنى(); }
    | عملية_حساب_صحيح.جمع_ملتف -> { أرجع حساب_صحيح_إكس_كامل.جمع_ملتف(); }
    | عملية_حساب_صحيح.طرح_ملتف -> { أرجع حساب_صحيح_إكس_كامل.طرح_ملتف(); }
    | عملية_حساب_صحيح.ضرب_ملتف -> { أرجع حساب_صحيح_إكس_كامل.ضرب_ملتف(); }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { أرجع حساب_صحيح_إكس_كامل.إزاحة_يسرى_ملتفة(); };
}

عرف تحويل_عائم_إكس_من_مسير(العملية: عملية_تحويل_عائم): تحويل_عائم_إكس_كامل {
    طابق العملية مع
    | عملية_تحويل_عائم.عائم_إلى_موقع -> { أرجع تحويل_عائم_إكس_كامل.عائم_إلى_موقع(); }
    | عملية_تحويل_عائم.عائم_إلى_طبيعي -> { أرجع تحويل_عائم_إكس_كامل.عائم_إلى_طبيعي(); }
    | عملية_تحويل_عائم.موقع_إلى_عائم -> { أرجع تحويل_عائم_إكس_كامل.موقع_إلى_عائم(); }
    | عملية_تحويل_عائم.طبيعي_إلى_عائم -> { أرجع تحويل_عائم_إكس_كامل.طبيعي_إلى_عائم(); }
    | عملية_تحويل_عائم.عائم_إلى_عائم -> { أرجع تحويل_عائم_إكس_كامل.عائم_إلى_عائم(); };
}

// The width of a float conversion's side: a float's bits or an integer's.
عرف بتات_طرف_تحويل_عائم_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختياري طبيعي {
    طابق بتات_قيمة_عائمة_إكس(المسير, حقائق_الخلفية, القيمة) مع
    | اختياري.موجود(ب) -> { أرجع اختياري.موجود(ب); }
    | اختياري.لا_شيء -> { };
    طابق وصف_تحويل_لقيمة_إكس(المسير, حقائق_الخلفية, القيمة) مع
    | اختياري.موجود(الوصف) -> { أرجع اختياري.موجود(الوصف.البتات); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف تحويل_إكس_من_مسير(العملية: عملية_تحويل_صحيح): تحويل_صحيح_إكس_كامل {
    طابق العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع تحويل_صحيح_إكس_كامل.توسيع_بإشارة(); }
    | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع تحويل_صحيح_إكس_كامل.توسيع_صفري(); }
    | عملية_تحويل_صحيح.اقتطاع -> { أرجع تحويل_صحيح_إكس_كامل.اقتطاع(); }
    | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع تحويل_صحيح_إكس_كامل.إعادة_تفسير(); };
}

عرف تخطيط_مركب_إكس(التخطيط: &واصف_تخطيط): منطقي {
    دع الوصف: واصف_تخطيط = *التخطيط;
    طابق الوصف.التفاصيل مع
    | تفاصيل_تخطيط.صف(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.سجل(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.تعداد(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف جزء_تخطيط_عند_إكس(التخطيط: &واصف_تخطيط, الفهرس: طبيعي): اختياري موضع_جزء_تخطيط {
    دع الوصف: واصف_تخطيط = *التخطيط;
    طابق الوصف.التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        إذا (الفهرس >= (الطول(الأجزاء) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        دع مرجع_الجزء: &موضع_جزء_تخطيط = &الأجزاء[الفهرس];
        دع الجزء: موضع_جزء_تخطيط = *مرجع_الجزء;
        أرجع اختياري.موجود(الجزء);
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        إذا (الفهرس >= (الطول(الأجزاء) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        دع مرجع_الجزء: &موضع_جزء_تخطيط = &الأجزاء[الفهرس];
        دع الجزء: موضع_جزء_تخطيط = *مرجع_الجزء;
        أرجع اختياري.موجود(الجزء);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف أضف_طلب_موضع_محلي_إكس(
    المواضع: &متغير متجه طلب_موضع_محلي_إكس,
    المعرف: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي
): فراغ {
    دع الطلب: طلب_موضع_محلي_إكس = {
        المعرف: المعرف,
        الحجم: الحجم,
        المحاذاة: المحاذاة
    };
    ألحق_طلب_موضع_إكس_للاختيار(المواضع, الطلب);
}

عرف أضف_موضع_محلي_إكس(
    المواضع: &متغير متجه طلب_موضع_محلي_إكس,
    المعرف: طبيعي,
    التخطيط: &واصف_تخطيط
): فراغ {
    دع الوصف: واصف_تخطيط = *التخطيط;
    أضف_طلب_موضع_محلي_إكس(المواضع, المعرف, الوصف.الحجم, الوصف.المحاذاة);
}

عرف حجم_موضع_تجميعي_واجهة_إكس(الحجم: طبيعي): طبيعي {
    إذا (الحجم == 0) { أرجع 8; };
    أرجع ((الحجم + 7) / 8) * 8;
}

عرف عنوان_بإزاحة_إكس(
    الوجهة: معرف_سجل_افتراضي,
    الأساس: معرف_سجل_افتراضي,
    الإزاحة: طبيعي
): تعليمة_إكس_ستة_وثمانون_أربعة_وستون {
    دع ب: اختياري معرف_سجل_افتراضي = اختياري.موجود(الأساس);
    دع ف: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
    دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
    دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
        الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: الإزاحة_الموقعة
    };
    أرجع تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_إكس(الوجهة, العنوان);
}

عرف ألحق_عنوان_عنصر_تسلسل_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المصدر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير,
    تخطيط_العنصر: &واصف_تخطيط,
    الوجهة: معرف_سجل_افتراضي
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع تخطيط_المصدر: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, المصدر) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المصدر := التخطيط; };

    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المصدر, 0) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(المصدر, 0)); }
    | اختياري.موجود(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المصدر, 1) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(المصدر, 1)); }
    | اختياري.موجود(الجزء) -> { جزء_الطول := الجزء; };

    إذا (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة) {
        أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المصدر));
    };
    دع حجم_مؤشر_البيانات: طبيعي = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
    إذا (حجم_مؤشر_البيانات != 8) {
        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(المصدر, حجم_مؤشر_البيانات)
        ));
    };

    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المصدر);
    دع ب: اختياري معرف_سجل_افتراضي = اختياري.موجود(سجل_المصدر);
    دع ف: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
    دع إزاحة_البيانات: عدد = جزء_البيانات.الإزاحة مثل عدد;
    دع عنوان_البيانات: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
        الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: إزاحة_البيانات
    };
    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
        الوجهة, عنوان_البيانات, حجم_مؤشر_البيانات, خطأ
    ));
    دع وصف_العنصر: واصف_تخطيط = *تخطيط_العنصر;
    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(
        الوجهة, الوجهة, سجل_إكس_لقيمة_مسير(الفهرس), وصف_العنصر.الحجم, 0
    ));
    أرجع اختياري.لا_شيء();
}

// The address of the storage a built value (code 2 or 3) is built in, into
// الوجهة: the result storage, or its owner's storage at the member's
// offset, or the owner's own slot (the owner requests that slot).
عرف ألحق_عنوان_تخزين_مبني_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    حقائق_النسخ: &حقائق_نسخ_إكس,
    الوجهة: معرف_سجل_افتراضي,
    القيمة: معرف_قيمة_مسير,
    العمق: طبيعي
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق عنوان_ناتج_للبناء_إكس(حقائق_النسخ, القيمة) مع
    | اختياري.موجود(العنوان) -> {
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(الوجهة, العنوان));
        أرجع اختياري.لا_شيء();
    }
    | اختياري.لا_شيء -> { };
    إذا (رمز_نسخ_إكس(حقائق_النسخ, القيمة) != 3 || العمق > 64) {
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(الوجهة, القيمة.القيمة));
        أرجع اختياري.لا_شيء();
    };
    دع المالك: معرف_قيمة_مسير = مصدر_نسخ_إكس(حقائق_النسخ, القيمة);
    دع الفهرس: طبيعي = (*حقائق_النسخ).النسخ.الفهارس[القيمة.القيمة];
    طابق ألحق_عنوان_تخزين_مبني_إكس(
        التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, حقائق_النسخ, الوجهة, المالك, العمق + 1
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع الإزاحة: متغير طبيعي = 0;
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, المالك) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المالك) -> {
        طابق تخطيط_المالك.التفاصيل مع
        | تفاصيل_تخطيط.تعداد(التعداد) -> {
            طابق تخطيط_منشئ_قيمة_مسير_للاختيار(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, المالك, (*حقائق_النسخ).النسخ.المنشئات[القيمة.القيمة]
            ) مع
            | نتيجة_تخطيط_منشئ.مكتمل(المنشئ) -> {
                إذا (الفهرس >= (الطول(المنشئ.الحمولات) مثل طبيعي)) { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المالك)); };
                الإزاحة := التعداد.مخزن_الحمولة.الإزاحة + المنشئ.الحمولات[الفهرس].الإزاحة;
            }
            | _ -> { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المالك)); };
        }
        | _ -> {
            طابق جزء_تخطيط_عند_إكس(&تخطيط_المالك, الفهرس) مع
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(المالك, الفهرس)); }
            | اختياري.موجود(الجزء) -> { الإزاحة := الجزء.الإزاحة; };
        };
    };
    إذا (الإزاحة != 0) {
        ألحق_تعليمة_إكس_للاختيار(التعليمات, عنوان_بإزاحة_إكس(الوجهة, الوجهة, الإزاحة));
    };
    أرجع اختياري.لا_شيء();
}

// The storage of an aggregate or tagged value the instruction builds: the
// caller's result storage for a value the function only returns (code 2 of
// رموز_نسخ_قيم_مسير), its owner's storage for one built in place (code 3),
// else a local slot of its own.
عرف ألحق_مكان_قيمة_مبنية_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    حقائق_النسخ: &حقائق_نسخ_إكس,
    الناتج: معرف_قيمة_مسير,
    التخطيط: &واصف_تخطيط
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
    إذا (رمز_نسخ_إكس(حقائق_النسخ, الناتج) == 3) {
        أرجع ألحق_عنوان_تخزين_مبني_إكس(
            التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, حقائق_النسخ, سجل_الناتج, الناتج, 0
        );
    };
    طابق عنوان_ناتج_للبناء_إكس(حقائق_النسخ, الناتج) مع
    | اختياري.موجود(العنوان) -> {
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_الناتج, العنوان));
    }
    | اختياري.لا_شيء -> {
        أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, التخطيط);
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(سجل_الناتج, الناتج.القيمة));
    };
    أرجع اختياري.لا_شيء();
}

// Whether the member, an aggregate, was built in place in its owner
// (code 3; a call result of a scalar Type is stored as usual).
عرف مبني_في_مالكه_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    حقائق_النسخ: &حقائق_نسخ_إكس,
    العضو: معرف_قيمة_مسير,
    المالك: معرف_قيمة_مسير
): منطقي {
    إذا (رمز_نسخ_إكس(حقائق_النسخ, العضو) != 3
        || مصدر_نسخ_إكس(حقائق_النسخ, العضو).القيمة != المالك.القيمة) { أرجع خطأ; };
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العضو) مع
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { أرجع تخطيط_مركب_إكس(&التخطيط); }
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(_) -> { أرجع خطأ; };
}

عرف ألحق_تخزين_قيمة_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير,
    العنوان: معرف_سجل_افتراضي,
    الإزاحة: طبيعي
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, القيمة) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        دع المصدر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(القيمة);
        إذا (تخطيط_مركب_إكس(&التخطيط)) {
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نسخ_ذاكرة_إكس(العنوان, المصدر, التخطيط.الحجم, الإزاحة, 0));
        } وإلا {
            دع ب: اختياري معرف_سجل_افتراضي = اختياري.موجود(العنوان);
            دع ف: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
            دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
            دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = { الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: الإزاحة_الموقعة };
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, ع, التخطيط.الحجم));
        };
        أرجع اختياري.لا_شيء();
    };
}


عرف ألحق_استخراج_قيمة_من_عنوان_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    الأساس: معرف_سجل_افتراضي,
    الإزاحة: طبيعي,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    مستعار: منطقي
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        دع الوجهة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
        إذا (تخطيط_مركب_إكس(&التخطيط) && مستعار) {
            // The part stands for the source's bytes (رموز_نسخ_قيم_مسير).
            إذا (الإزاحة == 0) {
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(الوجهة, الأساس));
            } وإلا {
                ألحق_تعليمة_إكس_للاختيار(التعليمات, عنوان_بإزاحة_إكس(الوجهة, الأساس, الإزاحة));
            };
        } وإلا إذا (تخطيط_مركب_إكس(&التخطيط)) {
            // استخراج VALUE التجميعي يملك تخزينه المستقل ولا يبقى اسما مستعارا داخل الأصل.
            أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
            ألحق_تعليمة_إكس_للاختيار(التعليمات,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                    الوجهة, الناتج.القيمة
                )
            );
            ألحق_تعليمة_إكس_للاختيار(التعليمات,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نسخ_ذاكرة_إكس(
                    الوجهة, الأساس, التخطيط.الحجم, 0, الإزاحة
                )
            );
        } وإلا {
            إذا (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
                أرجع اختياري.موجود(
                    خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                        سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(
                            الناتج, التخطيط.الحجم
                        )
                    )
                );
            };
            دع ب: اختياري معرف_سجل_افتراضي = اختياري.موجود(الأساس);
            دع ف: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
            دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
            دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: الإزاحة_الموقعة
            };
            ألحق_تعليمة_إكس_للاختيار(التعليمات,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
                    الوجهة, العنوان, التخطيط.الحجم,
                    بإشارة_لقيمة_إكس(المسير, حقائق_الخلفية, الناتج)
                )
            );
        };
        أرجع اختياري.لا_شيء();
    };
}


عرف ألحق_نداء_إكس_بخطة(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    عدد_السجلات: &متغير طبيعي,
    الثابتة: &متجه منطقي,
    هدف_النداء: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    الحجج_المسير: &متجه معرف_قيمة_مسير,
    ناتج_المسير: اختياري معرف_قيمة_مسير,
    الخطة: &خطة_دالة_واجهة
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    أرجع ألحق_نداء_إكس_بخطة_ومتغيرة(
        التعليمات, المواضع_المحلية, عدد_السجلات, الثابتة, هدف_النداء, الحجج_المسير, ناتج_المسير, الخطة, خطأ
    );
}

// متغيرة: the callee is a C variadic function (MSIR المعاملات_الثابتة).
عرف ألحق_نداء_إكس_بخطة_ومتغيرة(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    عدد_السجلات: &متغير طبيعي,
    الثابتة: &متجه منطقي,
    هدف_النداء: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    الحجج_المسير: &متجه معرف_قيمة_مسير,
    ناتج_المسير: اختياري معرف_قيمة_مسير,
    الخطة: &خطة_دالة_واجهة,
    متغيرة: منطقي
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع خ: خطة_دالة_واجهة = *الخطة;
    دع قيم_الحجج_المسير: متجه معرف_قيمة_مسير = *الحجج_المسير;
    دع الحجج: متغير متجه قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(قيم_الحجج_المسير) مثل طبيعي)) {
        إذا (ف >= (الطول(خ.المعاملات) مثل طبيعي)) {
            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم());
        };
        دع مرجع_المعامل: &خطة_معامل_واجهة = &خ.المعاملات[ف];
        دع المعامل: خطة_معامل_واجهة = *مرجع_المعامل;
        طابق المعامل.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> {
            // Primitive calls use the same canonical SysV value model as ordinary
            // Sultan calls. Do not collapse split/stack/indirect aggregate plans
            // back to the old scalar-register-only representation.
            دع القيمة: معرف_قيمة_مسير = قيم_الحجج_المسير[ف];
            دع الحجة: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = حجة_نداء_إكس(
                التعليمات, المواضع_المحلية, عدد_السجلات, الثابتة, القيمة, مرجع_المعامل
            );
            ألحق(الحجج, الحجة);
        };
        ف := ف + 1;
    }
    دع الناتج: متغير اختياري قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = اختياري.لا_شيء();
    طابق ناتج_المسير مع
    | اختياري.لا_شيء -> {
        طابق خ.الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم()); };
    }
    | اختياري.موجود(معرف_الناتج) -> {
        طابق خ.الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> {
            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم());
        }
        | _ -> {
            دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(معرف_الناتج);
            دع قيمة_الناتج: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                سجل_الناتج, &خ.الناتج.التصنيف, &خ.الناتج.الموقع
            );
            إذا (قيمة_الناتج.تجميعي) {
                // نتيجة التجميع تحتاج تخزينا ماديا قبل النداء. عند SysV MEMORY-class
                // يحمل هذا السجل عنوان التخزين الذي يمر لاحقا كمؤشر sret مخفي.
                دع حجم_التجميع: طبيعي = خ.الناتج.التصنيف.الحجم;
                دع محاذاة_التجميع: طبيعي = خ.الناتج.التصنيف.المحاذاة;
                دع هوية_التجميع: طبيعي = معرف_الناتج.القيمة;
                دع حجم_الحجز: طبيعي = حجم_موضع_تجميعي_واجهة_إكس(حجم_التجميع);
                أضف_طلب_موضع_محلي_إكس(
                    المواضع_المحلية, هوية_التجميع, حجم_الحجز, محاذاة_التجميع
                );
                ألحق_تعليمة_إكس_للاختيار(التعليمات,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                        سجل_الناتج, هوية_التجميع
                    )
                );
            };
            الناتج := اختياري.موجود(قيمة_الناتج);
        };
    };
    دع النداء: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = {
        الهدف: هدف_النداء, الحجج: الحجج, الناتج: الناتج, متغيرة: متغيرة
    };
    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(النداء));
    أرجع اختياري.لا_شيء();
}

// Extend (إلحاق_نطاق_متجه): the vector's header layout, as append reads it,
// and the integer element size of its Type.
عرف ألحق_امتداد_متجه_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المتجه: معرف_قيمة_مسير,
    المصدر: معرف_قيمة_مسير,
    البداية: معرف_قيمة_مسير,
    العدد: معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع البدائي: هوية_بدائي_مترجم = هوية_بدائي_مترجم.إلحاق_نطاق_متجه();
    طابق خطة_ربط_بدائي_للهدف(الهدف, هوية_بدائي_مترجم.إلحاق()) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); }
    | اختياري.موجود(_) -> { };
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, المتجه) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المتجه := التخطيط; };
    إذا (!تخطيط_مركب_إكس(&تخطيط_المتجه)) { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المتجه)); };
    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    دع جزء_السعة: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 0) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(المتجه, 0)); }
    | اختياري.موجود(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 1) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(المتجه, 1)); }
    | اختياري.موجود(الجزء) -> { جزء_الطول := الجزء; };
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 2) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(المتجه, 2)); }
    | اختياري.موجود(الجزء) -> { جزء_السعة := الجزء; };
    إذا (جزء_الطول.الإزاحة != جزء_البيانات.الإزاحة + 8 || جزء_السعة.الإزاحة != جزء_الطول.الإزاحة + 8
        || تخطيط_المتجه.الحجم != جزء_السعة.الإزاحة + 8) {
        أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المتجه));
    };
    دع حجم_العنصر: متغير طبيعي = 0;
    دع نوع_العنصر: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق نوع_قيمة_مسير(المسير, المتجه) مع
    | اختياري.موجود(نوع_المتجه) -> { نوع_العنصر := نوع_عنصر_تسلسل_دلالي(&(*حقائق_الخلفية).الأنواع, نوع_المتجه); }
    | اختياري.لا_شيء -> { };
    طابق نوع_العنصر مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المتجه)); }
    | اختياري.موجود(النوع) -> {
        طابق تخطيط_نوع_للاختيار(حقائق_الخلفية, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_تخطيط.مكتمل(التخطيط) -> { حجم_العنصر := التخطيط.الحجم; }
        | _ -> { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المتجه)); };
    };
    إذا (!(حجم_العنصر == 1 || حجم_العنصر == 2 || حجم_العنصر == 4 || حجم_العنصر == 8)) {
        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(حجم_العنصر);
    دع الامتداد: امتداد_متجه_إكس_ستة_وثمانون_أربعة_وستون = {
        المتجه: سجل_إكس_لقيمة_مسير(المتجه),
        المصدر: سجل_إكس_لقيمة_مسير(المصدر),
        البداية: سجل_إكس_لقيمة_مسير(البداية),
        العدد: سجل_إكس_لقيمة_مسير(العدد),
        إزاحة_البيانات: جزء_البيانات.الإزاحة,
        إزاحة_الطول: جزء_الطول.الإزاحة,
        إزاحة_السعة: جزء_السعة.الإزاحة,
        حجم_العنصر: حجم_العنصر,
        السعة_الدنيا: السياسة.السعة_الدنيا,
        عامل_النمو: السياسة.عامل_النمو
    };
    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.امتداد_متجه_إكس(الامتداد));
    أرجع اختياري.لا_شيء();
}

عرف ألحق_إلحاق_متجه_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المتجه: معرف_قيمة_مسير,
    العنصر: معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    الحجز: منطقي
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق خطة_ربط_بدائي_للهدف(الهدف, هوية_بدائي_مترجم.إلحاق()) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(هوية_بدائي_مترجم.إلحاق()));
    }
    | اختياري.موجود(_) -> { };
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, المتجه) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المتجه := التخطيط; };
    إذا (!تخطيط_مركب_إكس(&تخطيط_المتجه)) {
        أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المتجه));
    };
    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    دع جزء_السعة: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 0) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(المتجه, 0)); }
    | اختياري.موجود(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 1) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(المتجه, 1)); }
    | اختياري.موجود(الجزء) -> { جزء_الطول := الجزء; };
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 2) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(المتجه, 2)); }
    | اختياري.موجود(الجزء) -> { جزء_السعة := الجزء; };
    إذا (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة
        || جزء_السعة.الإزاحة <= جزء_الطول.الإزاحة
        || تخطيط_المتجه.الحجم <= جزء_السعة.الإزاحة) {
        أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المتجه));
    };
    دع حجم_البيانات: طبيعي = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
    دع حجم_الطول: طبيعي = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
    دع حجم_السعة: طبيعي = تخطيط_المتجه.الحجم - جزء_السعة.الإزاحة;
    إذا (!(حجم_البيانات == 8 && حجم_الطول == 8 && حجم_السعة == 8)) {
        أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المتجه));
    };
    // Reserve takes the element layout from the vector's Type; its second
    // argument is the additional count, not an element.
    دع تخطيط_المصدر: متغير نتيجة_تخطيط_قيمة_للاختيار = تخطيط_قيمة_مسير_للاختيار(
        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العنصر
    );
    إذا (الحجز) {
        دع نوع_العنصر: متغير اختياري معرف_نوع = اختياري.لا_شيء();
        طابق نوع_قيمة_مسير(المسير, المتجه) مع
        | اختياري.موجود(نوع_المتجه) -> { نوع_العنصر := نوع_عنصر_تسلسل_دلالي(&(*حقائق_الخلفية).الأنواع, نوع_المتجه); }
        | اختياري.لا_شيء -> { };
        طابق نوع_العنصر مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المتجه)); }
        | اختياري.موجود(النوع) -> {
            طابق تخطيط_نوع_للاختيار(حقائق_الخلفية, الهدف, سجل_التخطيط, النوع) مع
            | نتيجة_تخطيط.مكتمل(التخطيط) -> { تخطيط_المصدر := نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط); }
            | _ -> { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(المتجه)); };
        };
    };
    طابق تخطيط_المصدر مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_العنصر) -> {
        إذا (تخطيط_العنصر.الحجم == 0) {
            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(العنصر, 0)
            ));
        };
        إذا (!تخطيط_مركب_إكس(&تخطيط_العنصر)
            && !(تخطيط_العنصر.الحجم == 1 || تخطيط_العنصر.الحجم == 2
                || تخطيط_العنصر.الحجم == 4 || تخطيط_العنصر.الحجم == 8)) {
            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(العنصر, تخطيط_العنصر.الحجم)
            ));
        };
        دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(تخطيط_العنصر.الحجم مثل طبيعي);
        دع سجل_المتجه: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المتجه);
        دع سجل_العنصر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(العنصر);
        دع العنصر_تجميعي: منطقي = تخطيط_مركب_إكس(&تخطيط_العنصر) && !الحجز;
        دع الإلحاق: إلحاق_متجه_إكس_ستة_وثمانون_أربعة_وستون = {
            المتجه: سجل_المتجه,
            العنصر: سجل_العنصر,
            إزاحة_البيانات: جزء_البيانات.الإزاحة,
            إزاحة_الطول: جزء_الطول.الإزاحة,
            إزاحة_السعة: جزء_السعة.الإزاحة,
            حجم_الطول: حجم_الطول,
            حجم_السعة: حجم_السعة,
            حجم_العنصر: تخطيط_العنصر.الحجم,
            العنصر_تجميعي: العنصر_تجميعي,
            السعة_الدنيا: السياسة.السعة_الدنيا,
            عامل_النمو: السياسة.عامل_النمو,
            الحجز: الحجز
        };
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.إلحاق_متجه_إكس(الإلحاق));
        أرجع اختياري.لا_شيء();
    };
}

عرف ألحق_تهيئة_متجه_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    التهيئة: &تهيئة_متجه_مسير,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        إذا (!تخطيط_مركب_إكس(&التخطيط)) {
            أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(الناتج));
        };
        دع جزء_البيانات: موضع_جزء_تخطيط;
        دع جزء_الطول: موضع_جزء_تخطيط;
        دع جزء_السعة: موضع_جزء_تخطيط;
        طابق جزء_تخطيط_عند_إكس(&التخطيط, 0) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الناتج, 0)); }
        | اختياري.موجود(الجزء) -> { جزء_البيانات := الجزء; };
        طابق جزء_تخطيط_عند_إكس(&التخطيط, 1) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الناتج, 1)); }
        | اختياري.موجود(الجزء) -> { جزء_الطول := الجزء; };
        طابق جزء_تخطيط_عند_إكس(&التخطيط, 2) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الناتج, 2)); }
        | اختياري.موجود(الجزء) -> { جزء_السعة := الجزء; };
        إذا (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة
            || جزء_السعة.الإزاحة <= جزء_الطول.الإزاحة
            || التخطيط.الحجم <= جزء_السعة.الإزاحة) {
            أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(الناتج));
        };
        دع حجم_البيانات: طبيعي = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
        دع حجم_الطول: طبيعي = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
        دع حجم_السعة: طبيعي = التخطيط.الحجم - جزء_السعة.الإزاحة;
        إذا (!(حجم_البيانات == 1 || حجم_البيانات == 2 || حجم_البيانات == 4 || حجم_البيانات == 8)) {
            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(الناتج, حجم_البيانات)
            ));
        };
        إذا (!(حجم_الطول == 1 || حجم_الطول == 2 || حجم_الطول == 4 || حجم_الطول == 8)) {
            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(الناتج, حجم_الطول)
            ));
        };
        إذا (!(حجم_السعة == 1 || حجم_السعة == 2 || حجم_السعة == 4 || حجم_السعة == 8)) {
            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(الناتج, حجم_السعة)
            ));
        };
        أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
        دع الوجهة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(الوجهة, الناتج.القيمة));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(
            الوجهة, جزء_البيانات.الإزاحة, 0, حجم_البيانات
        ));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(
            الوجهة, جزء_الطول.الإزاحة, 0, حجم_الطول
        ));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(
            الوجهة, جزء_السعة.الإزاحة, 0, حجم_السعة
        ));
        دع وصف_التهيئة: تهيئة_متجه_مسير = *التهيئة;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(وصف_التهيئة.العناصر) مثل طبيعي)) {
            دع العنصر: معرف_قيمة_مسير = وصف_التهيئة.العناصر[ف];
            طابق ألحق_إلحاق_متجه_إكس(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج, العنصر, التعليمات, خطأ
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

عرف ألحق_بدائي_هوية_مضيف_إكس(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    إذا ((الطول(*الحجج) مثل طبيعي) != 0) {
        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    دع معرف_الناتج: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود());
    }
    | اختياري.موجود(المعرف) -> { معرف_الناتج := المعرف; };
    طابق رمز_بدائي_هوية_مضيف_للهدف(الهدف, البدائي) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    }
    | اختياري.موجود(الرمز) -> {
        ألحق_تعليمة_إكس_للاختيار(التعليمات,
            تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(
                سجل_إكس_لقيمة_مسير(معرف_الناتج), الرمز مثل طبيعي
            )
        );
        أرجع اختياري.لا_شيء();
    };
}

// The closure-environment reference-counting primitives on the header laid
// out by خطط_بيئة_إغلاق_للاختيار: count one more reference; count one fewer
// and answer whether none is left; or point word zero at the destructor and
// answer the environment itself, now a `() -> ()` closure running it.
عرف ألحق_بدائي_بيئة_إغلاق_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    عدد_السجلات: &متغير طبيعي,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    إذا ((الطول(*الحجج) مثل طبيعي) != 1) {
        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    دع البيئة: اختياري معرف_سجل_افتراضي = اختياري.موجود(سجل_إكس_لقيمة_مسير((*الحجج)[0]));
    دع بلا_فهرس: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
    دع الأول: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
    دع الثاني: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات + 1);
    دع الثالث: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات + 2);
    *عدد_السجلات := *عدد_السجلات + 3;
    طابق البدائي مع
    // The count is changed with LOCK XADD, so closures (and the shared
    // values built on them, std.sync's مشترك) may be copied and dropped on
    // several threads at once, as Swift's atomic retain/release.
    | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> {
        دع الرابع: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
        *عدد_السجلات := *عدد_السجلات + 1;
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الثاني, إزاحة_عداد_بيئة_إغلاق() مثل عدد));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(
            حساب_صحيح_إكس_كامل.جمع(), الأول, سجل_إكس_لقيمة_مسير((*الحجج)[0]), الثاني, 64, خطأ
        ));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الثالث, 1));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_إكس(
            عملية_ذرية_إكس.جلب_جمع(), الرابع, الأول, الثالث, 64
        ));
    }
    | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> {
        دع سجل_الناتج: معرف_سجل_افتراضي;
        طابق الناتج مع
        | اختياري.موجود(القيمة) -> { سجل_الناتج := سجل_إكس_لقيمة_مسير(القيمة); }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
        دع الرابع: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
        دع الواحد: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات + 1);
        *عدد_السجلات := *عدد_السجلات + 2;
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الثاني, إزاحة_عداد_بيئة_إغلاق() مثل عدد));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(
            حساب_صحيح_إكس_كامل.جمع(), الأول, سجل_إكس_لقيمة_مسير((*الحجج)[0]), الثاني, 64, خطأ
        ));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الثالث, -1));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_إكس(
            عملية_ذرية_إكس.جلب_جمع(), الرابع, الأول, الثالث, 64
        ));
        // The last reference was this one when the count was one before.
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الواحد, 1));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(
            سجل_الناتج, الرابع, الواحد, شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ(), 64
        ));
    }
    | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> {
        دع سجل_الناتج: معرف_سجل_افتراضي;
        طابق الناتج مع
        | اختياري.موجود(القيمة) -> { سجل_الناتج := سجل_إكس_لقيمة_مسير(القيمة); }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
        دع عنوان_المدمر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
            الأساس: البيئة, الفهرس: بلا_فهرس, المقياس: 1, الإزاحة: إزاحة_مدمر_بيئة_إغلاق() مثل عدد
        };
        دع عنوان_الشفرة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
            الأساس: البيئة, الفهرس: بلا_فهرس, المقياس: 1, الإزاحة: 0
        };
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(الأول, عنوان_المدمر, 8, خطأ));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(الأول, عنوان_الشفرة, 8));
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(
            سجل_الناتج, سجل_إكس_لقيمة_مسير((*الحجج)[0])
        ));
    }
    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
    أرجع اختياري.لا_شيء();
}

// The width in bits of an atomic operand (4 or 8 bytes).
عرف بتات_قيمة_ذرية_إكس(
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير
): اختياري طبيعي {
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, القيمة) مع
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        إذا (التخطيط.الحجم == 4 || التخطيط.الحجم == 8) { أرجع اختياري.موجود(التخطيط.الحجم * 8); };
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(_) -> { أرجع اختياري.لا_شيء(); };
}

// Atomic primitives: one machine sequence each (encoder.sn). Every ordering
// is given sequentially consistent strength: x86 loads are already acquire,
// read-modify-writes are LOCKed, and stores use XCHG.
عرف ألحق_بدائي_ذري_إكس(
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع العدد: طبيعي = الطول(*الحجج) مثل طبيعي;
    طابق البدائي مع
    | هوية_بدائي_مترجم.سياج_ذاكرة -> {
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.سياج_إكس());
        أرجع اختياري.لا_شيء();
    }
    | هوية_بدائي_مترجم.ذري_خزن -> {
        إذا (العدد != 3) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        طابق بتات_قيمة_ذرية_إكس(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, (*الحجج)[1]) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); }
        | اختياري.موجود(البتات) -> {
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_خزن_إكس(
                سجل_إكس_لقيمة_مسير((*الحجج)[0]), سجل_إكس_لقيمة_مسير((*الحجج)[1]), البتات
            ));
        };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { };
    دع سجل_الناتج: معرف_سجل_افتراضي;
    طابق الناتج مع
    | اختياري.موجود(القيمة) -> { سجل_الناتج := سجل_إكس_لقيمة_مسير(القيمة); }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
    دع البتات: طبيعي;
    طابق الناتج مع
    | اختياري.موجود(القيمة) -> {
        طابق بتات_قيمة_ذرية_إكس(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); }
        | اختياري.موجود(ب) -> { البتات := ب; };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
    طابق البدائي مع
    | هوية_بدائي_مترجم.ذري_حمل -> {
        إذا (العدد != 2) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
            الأساس: اختياري.موجود(سجل_إكس_لقيمة_مسير((*الحجج)[0])),
            الفهرس: اختياري.لا_شيء(), المقياس: 1, الإزاحة: 0
        };
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(سجل_الناتج, العنوان, البتات / 8, خطأ));
    }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> {
        إذا (العدد != 5) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_قارن_وبدل_إكس(
            سجل_الناتج, سجل_إكس_لقيمة_مسير((*الحجج)[0]), سجل_إكس_لقيمة_مسير((*الحجج)[1]),
            سجل_إكس_لقيمة_مسير((*الحجج)[2]), البتات
        ));
    }
    | _ -> {
        إذا (العدد != 3) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        دع العملية: متغير عملية_ذرية_إكس = عملية_ذرية_إكس.تبديل();
        طابق البدائي مع
        | هوية_بدائي_مترجم.ذري_تبديل -> { العملية := عملية_ذرية_إكس.تبديل(); }
        | هوية_بدائي_مترجم.ذري_جلب_جمع -> { العملية := عملية_ذرية_إكس.جلب_جمع(); }
        | هوية_بدائي_مترجم.ذري_جلب_و -> { العملية := عملية_ذرية_إكس.جلب_و(); }
        | هوية_بدائي_مترجم.ذري_جلب_أو -> { العملية := عملية_ذرية_إكس.جلب_أو(); }
        | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { العملية := عملية_ذرية_إكس.جلب_أو_حصري(); }
        | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_إكس(
            العملية, سجل_الناتج, سجل_إكس_لقيمة_مسير((*الحجج)[0]), سجل_إكس_لقيمة_مسير((*الحجج)[1]), البتات
        ));
    };
    أرجع اختياري.لا_شيء();
}

عرف انتق_تعليمة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    التعليمة: &عرض_تعليمة_مسير,
    آخر_تعليمة: منطقي,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المقارنة_المؤجلة: &متغير اختياري مقارنة_إكس_مؤجلة,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    عدد_السجلات: &متغير طبيعي,
    حقائق_النسخ: &حقائق_نسخ_إكس
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع العرض: عرض_تعليمة_مسير = *التعليمة;
    طابق العرض.العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع الوجهة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
            طابق الثابت مع
            | ثابت_مسير.منطق(القيمة) -> {
                دع بتات: متغير طبيعي = 0;
                إذا (القيمة) { بتات := 1; };
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, بتات));
            }
            | ثابت_مسير.صحيح_موقع(القيمة) -> {
                دع البتات: متغير طبيعي = 0;
                طابق بتات_قيمة_عدد_إكس(المسير, حقائق_الخلفية, الناتج) مع
                | اختياري.موجود(ب) -> { البتات := ب; }
                | _ -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الناتج, 0)); };
                إذا (!عرض_عدد_إكس_مدعوم(البتات)) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
                دع القيمة_غير_الموقعة: طبيعي = القيمة مثل طبيعي;
                دع القناع: طبيعي = قناع_عرض_عدد_إكس(البتات);
                دع الخام: طبيعي = القيمة_غير_الموقعة & القناع;
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, الخام));
            }
            | ثابت_مسير.مؤشر_فارغ -> {
                إذا ((*الهدف).نموذج_البيانات.عرض_المؤشر != 64) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ثابت_غير_مدعوم());
                };
                ألحق_تعليمة_إكس_للاختيار(التعليمات,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, 0));
            }
            | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
                دع البتات: متغير طبيعي = 0;
                طابق بتات_قيمة_مصدر_تحويل_إكس(المسير, حقائق_الخلفية, الناتج) مع
                | اختياري.موجود(ب) -> { البتات := ب; }
                | _ -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الناتج, 1)); };
                إذا (!عرض_عدد_إكس_مدعوم(البتات)) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, القيمة & قناع_عرض_عدد_إكس(البتات)));
            }
            | ثابت_مسير.عشري(البايتات) -> {
                دع العرض_عائم: متغير طبيعي = 0;
                طابق بتات_قيمة_عائمة_إكس(المسير, حقائق_الخلفية, الناتج) مع
                | اختياري.موجود(ب) -> { العرض_عائم := ب; }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
                طابق بتات_عائم_من_عشري(&البايتات, العرض_عائم) مع
                | اختياري.موجود(الخام) -> {
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, الخام));
                }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ثابت_غير_مدعوم()); };
            }
            | ثابت_مسير.دالة(الدالة) -> {
                دع الهدف_المنتقى: معرف_دالة_منتقاة = دالة_إكس_من_مسير(الدالة);
                ألحق_تعليمة_إكس_للاختيار(التعليمات,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(الوجهة, الهدف_المنتقى)
                );
            }
            | ثابت_مسير.نص(البايتات) -> {
                طابق تخطيط_قيمة_مسير_للاختيار(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج
                ) مع
                | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                    أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
                }
                | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                    إذا (!تخطيط_مركب_إكس(&التخطيط)) {
                        أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(الناتج));
                    };
                    دع إزاحة_البيانات: متغير طبيعي = 0;
                    دع إزاحة_الطول: متغير طبيعي = 0;
                    دع إزاحة_السعة: متغير طبيعي = 0;
                    طابق جزء_تخطيط_عند_إكس(&التخطيط, 0) مع
                    | اختياري.موجود(الجزء) -> { إزاحة_البيانات := الجزء.الإزاحة; }
                    | _ -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الناتج, 0)); };
                    طابق جزء_تخطيط_عند_إكس(&التخطيط, 1) مع
                    | اختياري.موجود(الجزء) -> { إزاحة_الطول := الجزء.الإزاحة; }
                    | _ -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الناتج, 1)); };
                    طابق جزء_تخطيط_عند_إكس(&التخطيط, 2) مع
                    | اختياري.موجود(الجزء) -> { إزاحة_السعة := الجزء.الإزاحة; }
                    | _ -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الناتج, 2)); };
                    أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
                    دع بايتات_النص: متجه ط8 = انسخ_بايتات_ثابت_نص_إكس(&البايتات);
                    دع الثابت_النصي: ثابت_نص_إكس_ستة_وثمانون_أربعة_وستون = {
                        الهوية: الناتج.القيمة,
                        البايتات: بايتات_النص,
                        إزاحة_البيانات: إزاحة_البيانات,
                        إزاحة_الطول: إزاحة_الطول,
                        إزاحة_السعة: إزاحة_السعة
                    };
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ثابت_نص_إكس(الثابت_النصي));
                    ألحق_تعليمة_إكس_للاختيار(التعليمات,
                        تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                            الوجهة, الناتج.القيمة
                        )
                    );
                };
            }
            | ثابت_مسير.متجه(_) -> {
                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ثابت_غير_مدعوم());
            };
        };
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع البتات: متغير طبيعي = 0;
            طابق بتات_قيمة_عدد_إكس(المسير, حقائق_الخلفية, الناتج) مع
            | اختياري.موجود(ب) -> { البتات := ب; }
            | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
            إذا (!عرض_عدد_إكس_مدعوم(البتات)) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
            // Division and remainder by a constant: a multiply, never DIV
            // (backend/codegen/division_by_constant.sn), as LLVM and GCC.
            دع قسمة_موقعة: متغير اختياري منطقي = اختياري.لا_شيء();
            دع باقي_القسمة: متغير منطقي = خطأ;
            طابق الحساب.العملية مع
            | عملية_حساب_صحيح.قسمة_طبيعية -> { قسمة_موقعة := اختياري.موجود(خطأ); }
            | عملية_حساب_صحيح.قسمة_موقعة -> { قسمة_موقعة := اختياري.موجود(صواب); }
            | عملية_حساب_صحيح.باقي_طبيعي -> { قسمة_موقعة := اختياري.موجود(خطأ); باقي_القسمة := صواب; }
            | عملية_حساب_صحيح.باقي_موقع -> { قسمة_موقعة := اختياري.موجود(صواب); باقي_القسمة := صواب; }
            | _ -> { };
            طابق قسمة_موقعة مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(موقع) -> {
                طابق ثابت_صحيح_لقيمة_مسير(المسير, الحساب.اليمين) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الثابت) -> {
                    // The constant's pattern, sign-extended from its width.
                    دع القاسم: متغير طبيعي = الثابت & قناع_عرض_عدد_إكس(البتات);
                    إذا (موقع && البتات < 64 && ((القاسم >> (البتات - 1)) & 1) != 0) {
                        القاسم := القاسم | ~قناع_عرض_عدد_إكس(البتات);
                    };
                    إذا (قسمة_على_ثابت_مدعومة(القاسم, موقع)) {
                        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قسمة_على_ثابت_إكس(
                            سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(الحساب.اليسار),
                            القاسم, البتات, موقع, باقي_القسمة
                        ));
                        أرجع اختياري.لا_شيء();
                    };
                };
            };
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(
                حساب_إكس_من_مسير(الحساب.العملية), سجل_إكس_لقيمة_مسير(الناتج),
                سجل_إكس_لقيمة_مسير(الحساب.اليسار), سجل_إكس_لقيمة_مسير(الحساب.اليمين),
                البتات, بإشارة_لقيمة_إكس(المسير, حقائق_الخلفية, الناتج)
            ));
        };
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع البتات: متغير طبيعي = 0;
            طابق بتات_قيمة_عائمة_إكس(المسير, حقائق_الخلفية, الحساب.اليسار) مع
            | اختياري.موجود(ب) -> { البتات := ب; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.حساب_غير_مدعوم()); };
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_عشري_إكس(
                حساب_عشري_إكس_من_مسير(الحساب.العملية), سجل_إكس_لقيمة_مسير(الناتج),
                سجل_إكس_لقيمة_مسير(الحساب.اليسار), سجل_إكس_لقيمة_مسير(الحساب.اليمين), البتات
            ));
        };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع البتات: متغير طبيعي = 0;
            طابق بتات_قيمة_عائمة_إكس(المسير, حقائق_الخلفية, المقارنة.اليسار) مع
            | اختياري.موجود(ب) -> { البتات := ب; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة()); };
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_عشرية_إلى_منطق_إكس(
                مقارنة_عشرية_إكس_من_مسير(المقارنة.العملية), سجل_إكس_لقيمة_مسير(الناتج),
                سجل_إكس_لقيمة_مسير(المقارنة.اليسار), سجل_إكس_لقيمة_مسير(المقارنة.اليمين), البتات
            ));
            *المقارنة_المؤجلة := اختياري.لا_شيء();
        };
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع البتات: متغير طبيعي = 0;
            طابق بتات_قيمة_عدد_إكس(المسير, حقائق_الخلفية, المقارنة.اليسار) مع
            | اختياري.موجود(ب) -> { البتات := ب; }
            | _ -> {
                دع نوع_المدخل: معرف_نوع;
                طابق نوع_قيمة_مسير(المسير, المقارنة.اليسار) مع
                | اختياري.موجود(ن) -> { نوع_المدخل := ن; }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة()); };
                طابق وصف_شكل_نوع_دلالي_عند(&(*حقائق_الخلفية).الأنواع, نوع_المدخل) مع
                | اختياري.موجود(الشكل) -> {
                    طابق الشكل.الصنف مع
                    | صنف_شكل_نوع_دلالي.مؤشر -> { البتات := (*الهدف).نموذج_البيانات.عرض_المؤشر; }
                    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة()); };
                }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة()); };
            };
            إذا (!عرض_عدد_إكس_مدعوم(البتات)) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة()); };
            دع إشارة_المقارنة: متغير صنف_إشارة_عدد_خلفية = صنف_إشارة_عدد_خلفية.طبيعي();
            طابق صنف_إشارة_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, المقارنة.اليسار) مع
            | اختياري.لا_شيء -> {
                // A missing integer sign is valid only for verifier-approved
                // raw-pointer equality, which compares the full pointer word.
                دع نوع_المدخل: معرف_نوع;
                طابق نوع_قيمة_مسير(المسير, المقارنة.اليسار) مع
                | اختياري.موجود(ن) -> { نوع_المدخل := ن; }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
                طابق وصف_شكل_نوع_دلالي_عند(&(*حقائق_الخلفية).الأنواع, نوع_المدخل) مع
                | اختياري.موجود(الشكل) -> {
                    طابق الشكل.الصنف مع
                    | صنف_شكل_نوع_دلالي.مؤشر -> { }
                    | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
                }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
            }
            | اختياري.موجود(الإشارة) -> { إشارة_المقارنة := الإشارة; };
            دع الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون = شرط_إكس_من_مقارنة(المقارنة.العملية, إشارة_المقارنة);
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(
                    سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(المقارنة.اليسار),
                    سجل_إكس_لقيمة_مسير(المقارنة.اليمين), الشرط, البتات
                ));
            *المقارنة_المؤجلة := اختياري.لا_شيء();
        };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع من_بتات: متغير طبيعي = 0;
            دع إلى_بتات: متغير طبيعي = 0;
            دع المصدر_موقع: متغير منطقي = خطأ;
            طابق وصف_تحويل_لقيمة_إكس(المسير, حقائق_الخلفية, التحويل.المصدر) مع
            | اختياري.موجود(الوصف) -> {
                من_بتات := الوصف.البتات;
                المصدر_موقع := الوصف.موقع;
            }
            | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم()); };
            طابق وصف_تحويل_لقيمة_إكس(المسير, حقائق_الخلفية, الناتج) مع
            | اختياري.موجود(الوصف) -> { إلى_بتات := الوصف.البتات; }
            | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم()); };
            إذا (!عرض_عدد_إكس_مدعوم(من_بتات) || !عرض_عدد_إكس_مدعوم(إلى_بتات)) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم()); };
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_صحيح_كامل_إكس(
                تحويل_إكس_من_مسير(التحويل.العملية), سجل_إكس_لقيمة_مسير(الناتج),
                سجل_إكس_لقيمة_مسير(التحويل.المصدر), من_بتات, إلى_بتات,
                المصدر_موقع
            ));
        };
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع من_بتات: طبيعي;
            طابق بتات_طرف_تحويل_عائم_إكس(المسير, حقائق_الخلفية, التحويل.المصدر) مع
            | اختياري.موجود(ب) -> { من_بتات := ب; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم()); };
            دع إلى_بتات: طبيعي;
            طابق بتات_طرف_تحويل_عائم_إكس(المسير, حقائق_الخلفية, الناتج) مع
            | اختياري.موجود(ب) -> { إلى_بتات := ب; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم()); };
            إذا (!عرض_عدد_إكس_مدعوم(من_بتات) || !عرض_عدد_إكس_مدعوم(إلى_بتات)) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم()); };
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_عائم_إكس(
                تحويل_عائم_إكس_من_مسير(التحويل.العملية), سجل_إكس_لقيمة_مسير(الناتج),
                سجل_إكس_لقيمة_مسير(التحويل.المصدر), من_بتات, إلى_بتات
            ));
        };
    }
    | عملية_مسير.نقل_تسلسل_مملوك(النقل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            ألحق_تعليمة_إكس_للاختيار(التعليمات,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(
                    سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(النقل.المصدر)
                )
            );
        };
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> { ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(التحويل.المرجع))); };
    }
    | عملية_مسير.تجميع(التجميع) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                إذا (!تخطيط_مركب_إكس(&التخطيط)) { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(الناتج)); };
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
                طابق ألحق_مكان_قيمة_مبنية_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المواضع_المحلية, حقائق_النسخ, الناتج, &التخطيط) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(التجميع.الأعضاء) مثل طبيعي)) {
                    طابق جزء_تخطيط_عند_إكس(&التخطيط, ف) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الناتج, ف)); }
                    | اختياري.موجود(الجزء) -> {
                        // A member built in place is already there.
                        إذا (!مبني_في_مالكه_إكس(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, حقائق_النسخ, التجميع.الأعضاء[ف], الناتج)) {
                            طابق ألحق_تخزين_قيمة_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, التجميع.الأعضاء[ف], سجل_الناتج, الجزء.الإزاحة) مع
                            | اختياري.موجود(خطأ_التخطيط) -> { أرجع اختياري.موجود(خطأ_التخطيط); }
                            | اختياري.لا_شيء -> { };
                        };
                    };
                    ف := ف + 1;
                }
            };
        };
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختياري.موجود(الناتج) -> {
            طابق ألحق_تهيئة_متجه_إكس(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                الناتج, &التهيئة, التعليمات, المواضع_المحلية
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
