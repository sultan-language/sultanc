عام نوع سبب_فشل_تخطيط_اختيار_إكس =
    | استعلام_قيمة بنوع فشل_تخطيط_قيمة_للاختيار
    | بنية_تخطيط_غير_متوافقة بنوع معرف_قيمة_مسير
    | جزء_تخطيط_مفقود بنوع (معرف_قيمة_مسير, غير_موقع)
    | عرض_قيمة_غير_مدعوم بنوع (معرف_قيمة_مسير, غير_موقع)
    | حمولة_منشئ_مؤجلة بنوع (معرف_قيمة_مسير, سبب_تأجيل_تخطيط)
    | حمولة_منشئ_مرفوضة بنوع (معرف_قيمة_مسير, خطأ_تخطيط)
    | حمولة_منشئ_مفقودة بنوع (معرف_قيمة_مسير, غير_موقع)
;

// منتقي x86_64 يستهلك MSIR المتحقق مباشرة ويصدر نموذج Selected Code الموجود.
// الحالات التي لا يملك النموذج الحالي تمثيلا صحيحا لها ترفض صراحة ولا تسقط دلالتها.
عام نوع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون =
    | هدف_ليس_إكس_ستة_وثمانون_أربعة_وستون بنوع معرف_هدف
    | دالة_مسير_مفقودة بنوع معرف_دالة_مسير
    | كتلة_مسير_مفقودة بنوع معرف_كتلة_مسير
    | ناتج_تعليمة_مفقود
    | نوع_غير_مدعوم
    | ثابت_غير_مدعوم
    | تحويل_غير_مدعوم
    | حساب_غير_مدعوم
    | مقارنة_غير_مدعومة
    | مقارنة_ليست_شرط_المنهي
    | عملية_غير_مدعومة
    | منهي_غير_مدعوم
    | معاملات_كتلة_غير_مدعومة بنوع معرف_كتلة_مسير
    | واجهة_دالة_غير_مدعومة
    | فشل_حل_واجهة بنوع خطأ_حل_واجهة_اختيار
    | نداء_دالة_غير_مدعوم
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | تخطيط_غير_متاح بنوع سبب_فشل_تخطيط_اختيار_إكس
;

عام نوع فئة_عملية_اختيار_إكس =
    | ثابت
    | حساب_صحيح
    | مقارنة_صحيح
    | تحويل_صحيح
    | حساب_عشري
    | مقارنة_عشري
    | مرجع_إلى_مؤشر
    | تجميع
    | تهيئة_متجه
    | استخراج_حقل
    | استخراج_فهرس
    | مكان_محلي
    | مرجع_إلى_مكان
    | صندوق_إلى_مكان
    | مكان_حقل
    | مكان_فهرس
    | موضع_تخزين_عنصر_مؤشر
    | تحميل
    | تخزين
    | مكان_إلى_مرجع
    | بناء_موسوم
    | استعلام_وسم
    | استخراج_حمولة
    | بناء_صندوق
    | نداء
;

عرف فئة_عملية_اختيار_إكس_من(العملية: &عملية_مسير): فئة_عملية_اختيار_إكس {
    دع الحالة: عملية_مسير = *العملية;
    طابق الحالة مع
    | عملية_مسير.ثابت(_) -> { أرجع فئة_عملية_اختيار_إكس.ثابت(); }
    | عملية_مسير.حساب_صحيح(_) -> { أرجع فئة_عملية_اختيار_إكس.حساب_صحيح(); }
    | عملية_مسير.مقارنة_صحيح(_) -> { أرجع فئة_عملية_اختيار_إكس.مقارنة_صحيح(); }
    | عملية_مسير.تحويل_صحيح(_) -> { أرجع فئة_عملية_اختيار_إكس.تحويل_صحيح(); }
    | عملية_مسير.حساب_عشري(_) -> { أرجع فئة_عملية_اختيار_إكس.حساب_عشري(); }
    | عملية_مسير.مقارنة_عشري(_) -> { أرجع فئة_عملية_اختيار_إكس.مقارنة_عشري(); }
    | عملية_مسير.مرجع_إلى_مؤشر(_) -> { أرجع فئة_عملية_اختيار_إكس.مرجع_إلى_مؤشر(); }
    | عملية_مسير.تجميع(_) -> { أرجع فئة_عملية_اختيار_إكس.تجميع(); }
    | عملية_مسير.تهيئة_متجه(_) -> { أرجع فئة_عملية_اختيار_إكس.تهيئة_متجه(); }
    | عملية_مسير.استخراج_حقل(_) -> { أرجع فئة_عملية_اختيار_إكس.استخراج_حقل(); }
    | عملية_مسير.استخراج_فهرس(_) -> { أرجع فئة_عملية_اختيار_إكس.استخراج_فهرس(); }
    | عملية_مسير.مكان_محلي(_) -> { أرجع فئة_عملية_اختيار_إكس.مكان_محلي(); }
    | عملية_مسير.مرجع_إلى_مكان(_) -> { أرجع فئة_عملية_اختيار_إكس.مرجع_إلى_مكان(); }
    | عملية_مسير.صندوق_إلى_مكان(_) -> { أرجع فئة_عملية_اختيار_إكس.صندوق_إلى_مكان(); }
    | عملية_مسير.مكان_حقل(_) -> { أرجع فئة_عملية_اختيار_إكس.مكان_حقل(); }
    | عملية_مسير.مكان_فهرس(_) -> { أرجع فئة_عملية_اختيار_إكس.مكان_فهرس(); }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(_) -> { أرجع فئة_عملية_اختيار_إكس.موضع_تخزين_عنصر_مؤشر(); }
    | عملية_مسير.تحميل(_) -> { أرجع فئة_عملية_اختيار_إكس.تحميل(); }
    | عملية_مسير.تخزين(_) -> { أرجع فئة_عملية_اختيار_إكس.تخزين(); }
    | عملية_مسير.مكان_إلى_مرجع(_) -> { أرجع فئة_عملية_اختيار_إكس.مكان_إلى_مرجع(); }
    | عملية_مسير.بناء_موسوم(_) -> { أرجع فئة_عملية_اختيار_إكس.بناء_موسوم(); }
    | عملية_مسير.استعلام_وسم(_) -> { أرجع فئة_عملية_اختيار_إكس.استعلام_وسم(); }
    | عملية_مسير.استخراج_حمولة(_) -> { أرجع فئة_عملية_اختيار_إكس.استخراج_حمولة(); }
    | عملية_مسير.بناء_صندوق(_) -> { أرجع فئة_عملية_اختيار_إكس.بناء_صندوق(); }
    | عملية_مسير.نداء(_) -> { أرجع فئة_عملية_اختيار_إكس.نداء(); };
}

عام نوع فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
    الدالة: اختيار معرف_دالة_مسير,
    الكتلة: اختيار معرف_كتلة_مسير,
    فهرس_التعليمة: اختيار غير_موقع,
    العملية: اختيار فئة_عملية_اختيار_إكس,
    السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون
};

عرف فشل_اختيار_إكس_عام(السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون): فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع لا_دالة: اختيار معرف_دالة_مسير = اختيار.لا_شيء();
    دع لا_كتلة: اختيار معرف_كتلة_مسير = اختيار.لا_شيء();
    دع لا_فهرس: اختيار غير_موقع = اختيار.لا_شيء();
    دع لا_عملية: اختيار فئة_عملية_اختيار_إكس = اختيار.لا_شيء();
    دع الفشل: فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
        الدالة: لا_دالة, الكتلة: لا_كتلة, فهرس_التعليمة: لا_فهرس, العملية: لا_عملية, السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_إكس_في_دالة(الدالة: معرف_دالة_مسير, السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون): فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع له_دالة: اختيار معرف_دالة_مسير = اختيار.بعض(الدالة);
    دع لا_كتلة: اختيار معرف_كتلة_مسير = اختيار.لا_شيء();
    دع لا_فهرس: اختيار غير_موقع = اختيار.لا_شيء();
    دع لا_عملية: اختيار فئة_عملية_اختيار_إكس = اختيار.لا_شيء();
    دع الفشل: فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
        الدالة: له_دالة, الكتلة: لا_كتلة, فهرس_التعليمة: لا_فهرس, العملية: لا_عملية, السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_إكس_في_كتلة(الدالة: معرف_دالة_مسير, الكتلة: معرف_كتلة_مسير, السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون): فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع له_دالة: اختيار معرف_دالة_مسير = اختيار.بعض(الدالة);
    دع له_كتلة: اختيار معرف_كتلة_مسير = اختيار.بعض(الكتلة);
    دع لا_فهرس: اختيار غير_موقع = اختيار.لا_شيء();
    دع لا_عملية: اختيار فئة_عملية_اختيار_إكس = اختيار.لا_شيء();
    دع الفشل: فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
        الدالة: له_دالة, الكتلة: له_كتلة, فهرس_التعليمة: لا_فهرس, العملية: لا_عملية, السبب: السبب
    };
    أرجع الفشل;
}

عرف فشل_اختيار_إكس_في_تعليمة(
    الدالة: معرف_دالة_مسير, الكتلة: معرف_كتلة_مسير, الفهرس: غير_موقع,
    العملية: فئة_عملية_اختيار_إكس, السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون
): فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع له_دالة: اختيار معرف_دالة_مسير = اختيار.بعض(الدالة);
    دع له_كتلة: اختيار معرف_كتلة_مسير = اختيار.بعض(الكتلة);
    دع له_فهرس: اختيار غير_موقع = اختيار.بعض(الفهرس);
    دع له_عملية: اختيار فئة_عملية_اختيار_إكس = اختيار.بعض(العملية);
    دع الفشل: فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون = {
        الدالة: له_دالة, الكتلة: له_كتلة, فهرس_التعليمة: له_فهرس, العملية: له_عملية, السبب: السبب
    };
    أرجع الفشل;
}

عام نوع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون =
    | نجح بنوع شفرة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | خطأ بنوع فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون
;

نوع مقارنة_إكس_مؤجلة = {
    الناتج: معرف_قيمة_مسير,
    الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون
};

نوع ثابت_صحيح_إكس =
    | موقع بنوع عدد
    | غير_موقع بنوع غير_موقع
;

نوع تجهيز_معامل_تجميعي_إكس = {
    المعرف: معرف_قيمة_مسير,
    الحجم: غير_موقع,
    المحاذاة: غير_موقع,
    الأجزاء: متجه معرف_سجل_افتراضي,
    أحجام_الأجزاء: متجه غير_موقع
};

نوع تجهيز_معامل_مفرد_إكس = {
    الوجهة: معرف_سجل_افتراضي,
    الحامل: معرف_سجل_افتراضي
};

عرف خطأ_استعلام_تخطيط_إكس(الفشل: فشل_تخطيط_قيمة_للاختيار): خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.استعلام_قيمة(الفشل);
    أرجع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب);
}

عرف خطأ_بنية_تخطيط_إكس(القيمة: معرف_قيمة_مسير): خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.بنية_تخطيط_غير_متوافقة(القيمة);
    أرجع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب);
}

عرف خطأ_جزء_تخطيط_إكس(القيمة: معرف_قيمة_مسير, الفهرس: غير_موقع): خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.جزء_تخطيط_مفقود(القيمة, الفهرس);
    أرجع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب);
}

عرف خطأ_عرض_تخطيط_إكس(القيمة: معرف_قيمة_مسير, الحجم: غير_موقع): خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(القيمة, الحجم);
    أرجع خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب);
}

عرف سجل_إكس_لقيمة_مسير(المعرف: معرف_قيمة_مسير): معرف_سجل_افتراضي {
    أرجع معرف_سجل_افتراضي_من(المعرف.القيمة);
}

عرف مقياس_عنصر_إكس(الحجم: غير_موقع): اختيار غير_موقع {
    لو (الحجم == 1 || الحجم == 2 || الحجم == 4 || الحجم == 8) {
        أرجع اختيار.بعض(الحجم);
    };
    أرجع اختيار.لا_شيء();
}

عرف دالة_إكس_من_مسير(المعرف: معرف_دالة_مسير): معرف_دالة_منتقاة {
    دع الناتج: معرف_دالة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عرف كتلة_إكس_من_مسير(المعرف: معرف_كتلة_مسير): معرف_كتلة_منتقاة {
    دع الناتج: معرف_كتلة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عرف موضع_واجهة_صحيح_مدعوم_لإكس(
    الموضع: &موضع_جزء_واجهة,
    الدور: دور_سجل_واجهة
): منطقي {
    طابق *الموضع مع
    | موضع_جزء_واجهة.سجل(المرجع) -> {
        أرجع المرجع.الفئة == فئة_سجل_واجهة.عدد_صحيح() && المرجع.الدور == الدور;
    }
    | موضع_جزء_واجهة.مكدس(المكدس) -> {
        لو (الدور != دور_سجل_واجهة.معامل()) { أرجع خطأ; };
        أرجع المكدس.الحجم == 8 && المكدس.المحاذاة == 8 && (المكدس.الإزاحة % 8) == 0;
    };
}

عرف مواضع_واجهة_إكس(الموقع: &موقع_تمرير_واجهة): متجه موضع_جزء_واجهة {
    دع الناتج: متغير متجه موضع_جزء_واجهة = [];
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الموضع) -> { ألحق(الناتج, الموضع); }
    | موقع_تمرير_واجهة.مجزأ(المواضع) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المواضع) مثل غير_موقع)) {
            ألحق(الناتج, المواضع[ف]);
            ف := ف + 1;
        }
    }
    | موقع_تمرير_واجهة.غير_مباشر(الموضع) -> { ألحق(الناتج, الموضع); }
    | موقع_تمرير_واجهة.متجاهل -> { };
    أرجع الناتج;
}

عرف موقع_واجهة_غير_مباشر_إكس(الموقع: &موقع_تمرير_واجهة): منطقي {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف قيمة_واجهة_من_خطة_إكس(
    السجل: معرف_سجل_افتراضي,
    التصنيف: &تصنيف_قيمة_واجهة,
    الموقع: &موقع_تمرير_واجهة
): قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة {
    دع ت: تصنيف_قيمة_واجهة = *التصنيف;
    دع المواضع: متجه موضع_جزء_واجهة = مواضع_واجهة_إكس(الموقع);
    دع غير_مباشر: منطقي = موقع_واجهة_غير_مباشر_إكس(الموقع);
    دع الناتج: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
        السجل: السجل,
        المواضع: المواضع,
        الحجم: ت.الحجم,
        تجميعي: ت.تجميعي,
        غير_مباشر: غير_مباشر
    };
    أرجع الناتج;
}

عرف حد_عدد_موقع_موجب(): عدد {
    دع صفر: غير_موقع = 0;
    دع كل_البتات: غير_موقع = ~(صفر);
    دع الأعلى_غير_موقع: غير_موقع = كل_البتات >> 1;
    أرجع الأعلى_غير_موقع مثل عدد;
}

عرف حد_عدد_موقع_سالب(): عدد {
    دع الأعلى: عدد = حد_عدد_موقع_موجب();
    أرجع -الأعلى - 1;
}

عرف جمع_موقع_آمن(أ: عدد, ب: عدد): منطقي {
    دع الأعلى: عدد = حد_عدد_موقع_موجب();
    دع الأدنى: عدد = حد_عدد_موقع_سالب();
    لو (ب > 0) {
        أرجع أ <= الأعلى - ب;
    };
    لو (ب < 0) {
        أرجع أ >= الأدنى - ب;
    };
    أرجع صواب;
}

عرف طرح_موقع_آمن(أ: عدد, ب: عدد): منطقي {
    دع الأعلى: عدد = حد_عدد_موقع_موجب();
    دع الأدنى: عدد = حد_عدد_موقع_سالب();
    لو (ب < 0) {
        أرجع أ <= الأعلى + ب;
    };
    لو (ب > 0) {
        أرجع أ >= الأدنى + ب;
    };
    أرجع صواب;
}

عرف حد_غير_موقع_أقصى(): غير_موقع {
    دع الأعلى_الموقع: غير_موقع = حد_عدد_موقع_موجب() مثل غير_موقع;
    أرجع (الأعلى_الموقع * 2) + 1;
}

عرف شرط_إكس_من_مقارنة(
    العملية: عملية_مقارنة_صحيح,
    الإشارة: صنف_إشارة_عدد_خلفية
): شرط_إكس_ستة_وثمانون_أربعة_وستون {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> {
        أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ();
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> {
        أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.لاتكافؤ();
    }
    | عملية_مقارنة_صحيح.أصغر -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة();
        }
        | صنف_إشارة_عدد_خلفية.غير_موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_غير_موقع();
        };
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو();
        }
        | صنف_إشارة_عدد_خلفية.غير_موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_غير_موقع_أو_مساو();
        };
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة();
        }
        | صنف_إشارة_عدد_خلفية.غير_موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_غير_موقع();
        };
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        طابق الإشارة مع
        | صنف_إشارة_عدد_خلفية.موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو();
        }
        | صنف_إشارة_عدد_خلفية.غير_موقع -> {
            أرجع شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_غير_موقع_أو_مساو();
        };
    };
}

عرف حزمة_نقل_حافة_إكس(
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير
): نتيجة متطلبات_نقل_حافة_منتقاة, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع القيمة: حافة_مسير = *الحافة;
    طابق ابحث_كتلة_مسير(المسير, القيمة.الهدف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(المعرف) -> {
        أرجع نتيجة.خطأ(
            خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.كتلة_مسير_مفقودة(المعرف)
        );
    }
    | نتيجة_بحث_كتلة_مسير.موجودة(الهدف) -> {
        لو ((الطول(القيمة.الحجج) مثل غير_موقع) != الهدف.عدد_المعاملات) {
            أرجع نتيجة.خطأ(
                خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.معاملات_كتلة_غير_مدعومة(القيمة.الهدف)
            );
        };
        دع النقلات: متغير متجه نقلة_حافة_منتقاة = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الهدف.عدد_المعاملات) {
            طابق معامل_كتلة_مسير_عند(المسير, القيمة.الهدف, ف) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(
                    خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.معاملات_كتلة_غير_مدعومة(القيمة.الهدف)
                );
            }
            | اختيار.بعض(المعامل) -> {
                دع المصدر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(القيمة.الحجج[ف]);
                دع الوجهة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المعامل.المعرف);
                دع النقلة: نقلة_حافة_منتقاة = {
                    المصدر: المصدر,
                    الوجهة: الوجهة
                };
                ألحق(النقلات, النقلة);
            };
            ف := ف + 1;
        }
        دع هدف_الحزمة: معرف_كتلة_منتقاة = كتلة_إكس_من_مسير(القيمة.الهدف);
        دع الحزمة: متطلبات_نقل_حافة_منتقاة = {
            الهدف: هدف_الحزمة,
            النقلات: النقلات
        };
        أرجع نتيجة.نجح(الحزمة);
    };
}


عرف بتات_قيمة_عدد_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختيار غير_موقع {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع بتات_عدد_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف بتات_قيمة_عائمة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختيار غير_موقع {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع بتات_عائم_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف حساب_عشري_إكس_من_مسير(العملية: عملية_حساب_عشري): حساب_عشري_إكس_كامل {
    طابق العملية مع
    | عملية_حساب_عشري.جمع -> { أرجع حساب_عشري_إكس_كامل.جمع(); }
    | عملية_حساب_عشري.طرح -> { أرجع حساب_عشري_إكس_كامل.طرح(); }
    | عملية_حساب_عشري.ضرب -> { أرجع حساب_عشري_إكس_كامل.ضرب(); }
    | عملية_حساب_عشري.قسمة -> { أرجع حساب_عشري_إكس_كامل.قسمة(); };
}

عرف مقارنة_عشرية_إكس_من_مسير(العملية: عملية_مقارنة_عشري): مقارنة_عشرية_إكس_كاملة {
    طابق العملية مع
    | عملية_مقارنة_عشري.يساوي -> { أرجع مقارنة_عشرية_إكس_كاملة.يساوي(); }
    | عملية_مقارنة_عشري.لا_يساوي -> { أرجع مقارنة_عشرية_إكس_كاملة.لا_يساوي(); }
    | عملية_مقارنة_عشري.أصغر -> { أرجع مقارنة_عشرية_إكس_كاملة.أصغر(); }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { أرجع مقارنة_عشرية_إكس_كاملة.أصغر_أو_يساوي(); }
    | عملية_مقارنة_عشري.أكبر -> { أرجع مقارنة_عشرية_إكس_كاملة.أكبر(); }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { أرجع مقارنة_عشرية_إكس_كاملة.أكبر_أو_يساوي(); };
}

عرف وصف_تحويل_لقيمة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): اختيار وصف_تحويل_صحيح_خلفية {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        دع حقائق: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
        أرجع وصف_نوع_لتحويل_صحيح_للاختيار(&حقائق.الأنواع, النوع);
    };
}

عرف عرض_عدد_إكس_مدعوم(البتات: غير_موقع): منطقي {
    أرجع البتات == 8 || البتات == 16 || البتات == 32 || البتات == 64;
}

عرف قناع_عرض_عدد_إكس(البتات: غير_موقع): غير_موقع {
    لو (البتات >= 64) { أرجع حد_غير_موقع_أقصى(); };
    لو (البتات == 32) { أرجع 4294967295; };
    لو (البتات == 16) { أرجع 65535; };
    لو (البتات == 8) { أرجع 255; };
    أرجع 0;
}

عرف بإشارة_لقيمة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): منطقي {
    طابق صنف_إشارة_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, القيمة) مع
    | اختيار.بعض(صنف_إشارة_عدد_خلفية.موقع) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف حساب_إكس_من_مسير(العملية: عملية_حساب_صحيح): حساب_صحيح_إكس_كامل {
    طابق العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع حساب_صحيح_إكس_كامل.جمع(); }
    | عملية_حساب_صحيح.طرح -> { أرجع حساب_صحيح_إكس_كامل.طرح(); }
    | عملية_حساب_صحيح.ضرب -> { أرجع حساب_صحيح_إكس_كامل.ضرب(); }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع حساب_صحيح_إكس_كامل.قسمة_موقعة(); }
    | عملية_حساب_صحيح.قسمة_غير_موقعة -> { أرجع حساب_صحيح_إكس_كامل.قسمة_غير_موقعة(); }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع حساب_صحيح_إكس_كامل.باقي_موقع(); }
    | عملية_حساب_صحيح.باقي_غير_موقع -> { أرجع حساب_صحيح_إكس_كامل.باقي_غير_موقع(); }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع حساب_صحيح_إكس_كامل.أو_بتي(); }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع حساب_صحيح_إكس_كامل.أو_حصري(); }
    | عملية_حساب_صحيح.و_بتي -> { أرجع حساب_صحيح_إكس_كامل.و_بتي(); }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع حساب_صحيح_إكس_كامل.إزاحة_يسرى(); }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع حساب_صحيح_إكس_كامل.إزاحة_يمنى(); }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع حساب_صحيح_إكس_كامل.إزاحة_حسابية_يمنى(); };
}

عرف تحويل_إكس_من_مسير(العملية: عملية_تحويل_صحيح): تحويل_صحيح_إكس_كامل {
    طابق العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع تحويل_صحيح_إكس_كامل.توسيع_بإشارة(); }
    | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع تحويل_صحيح_إكس_كامل.توسيع_صفري(); }
    | عملية_تحويل_صحيح.اقتطاع -> { أرجع تحويل_صحيح_إكس_كامل.اقتطاع(); }
    | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع تحويل_صحيح_إكس_كامل.إعادة_تفسير(); };
}

عرف تخطيط_مركب_إكس(التخطيط: &واصف_تخطيط): منطقي {
    دع الوصف: واصف_تخطيط = *التخطيط;
    طابق الوصف.التفاصيل مع
    | تفاصيل_تخطيط.صف(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.سجل(_) -> { أرجع صواب; }
    | تفاصيل_تخطيط.تعداد(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف جزء_تخطيط_عند_إكس(التخطيط: &واصف_تخطيط, الفهرس: غير_موقع): اختيار موضع_جزء_تخطيط {
    دع الوصف: واصف_تخطيط = *التخطيط;
    طابق الوصف.التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        لو (الفهرس >= (الطول(الأجزاء) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
        دع مرجع_الجزء: &موضع_جزء_تخطيط = &الأجزاء[الفهرس];
        دع الجزء: موضع_جزء_تخطيط = *مرجع_الجزء;
        أرجع اختيار.بعض(الجزء);
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        لو (الفهرس >= (الطول(الأجزاء) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
        دع مرجع_الجزء: &موضع_جزء_تخطيط = &الأجزاء[الفهرس];
        دع الجزء: موضع_جزء_تخطيط = *مرجع_الجزء;
        أرجع اختيار.بعض(الجزء);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف أضف_طلب_موضع_محلي_إكس(
    المواضع: &متغير متجه طلب_موضع_محلي_إكس,
    المعرف: غير_موقع,
    الحجم: غير_موقع,
    المحاذاة: غير_موقع
): فراغ {
    دع الحالة: متغير متجه طلب_موضع_محلي_إكس = *المواضع;
    دع الطلب: طلب_موضع_محلي_إكس = {
        المعرف: المعرف,
        الحجم: الحجم,
        المحاذاة: المحاذاة
    };
    ألحق(الحالة, الطلب);
    *المواضع := الحالة;
}

عرف أضف_موضع_محلي_إكس(
    المواضع: &متغير متجه طلب_موضع_محلي_إكس,
    المعرف: غير_موقع,
    التخطيط: &واصف_تخطيط
): فراغ {
    دع الوصف: واصف_تخطيط = *التخطيط;
    أضف_طلب_موضع_محلي_إكس(المواضع, المعرف, الوصف.الحجم, الوصف.المحاذاة);
}

عرف حجم_موضع_تجميعي_واجهة_إكس(الحجم: غير_موقع): غير_موقع {
    لو (الحجم == 0) { أرجع 8; };
    أرجع ((الحجم + 7) / 8) * 8;
}

عرف عنوان_بإزاحة_إكس(
    الوجهة: معرف_سجل_افتراضي,
    الأساس: معرف_سجل_افتراضي,
    الإزاحة: غير_موقع
): تعليمة_إكس_ستة_وثمانون_أربعة_وستون {
    دع ب: اختيار معرف_سجل_افتراضي = اختيار.بعض(الأساس);
    دع ف: اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
    دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
    دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
        الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: الإزاحة_الموقعة
    };
    أرجع تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_إكس(الوجهة, العنوان);
}

عرف ألحق_عنوان_عنصر_تسلسل_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المصدر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير,
    تخطيط_العنصر: &واصف_تخطيط,
    الوجهة: معرف_سجل_افتراضي
): اختيار خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع تخطيط_المصدر: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, المصدر) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المصدر := التخطيط; };

    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المصدر, 0) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(المصدر, 0)); }
    | اختيار.بعض(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المصدر, 1) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(المصدر, 1)); }
    | اختيار.بعض(الجزء) -> { جزء_الطول := الجزء; };

    لو (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة) {
        أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(المصدر));
    };
    دع حجم_مؤشر_البيانات: غير_موقع = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
    لو (حجم_مؤشر_البيانات != 8) {
        أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
            سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(المصدر, حجم_مؤشر_البيانات)
        ));
    };

    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المصدر);
    دع ب: اختيار معرف_سجل_افتراضي = اختيار.بعض(سجل_المصدر);
    دع ف: اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
    دع إزاحة_البيانات: عدد = جزء_البيانات.الإزاحة مثل عدد;
    دع عنوان_البيانات: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
        الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: إزاحة_البيانات
    };
    دع الحالة: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
    ألحق(الحالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
        الوجهة, عنوان_البيانات, حجم_مؤشر_البيانات, خطأ
    ));
    دع وصف_العنصر: واصف_تخطيط = *تخطيط_العنصر;
    ألحق(الحالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(
        الوجهة, الوجهة, سجل_إكس_لقيمة_مسير(الفهرس), وصف_العنصر.الحجم, 0
    ));
    *التعليمات := الحالة;
    أرجع اختيار.لا_شيء();
}

عرف ألحق_تخزين_قيمة_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير,
    العنوان: معرف_سجل_افتراضي,
    الإزاحة: غير_موقع
): اختيار خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, القيمة) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        دع الحالة: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
        دع المصدر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(القيمة);
        لو (تخطيط_مركب_إكس(&التخطيط)) {
            ألحق(الحالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نسخ_ذاكرة_إكس(العنوان, المصدر, التخطيط.الحجم, الإزاحة, 0));
        } وإلا {
            دع ب: اختيار معرف_سجل_افتراضي = اختيار.بعض(العنوان);
            دع ف: اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
            دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
            دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = { الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: الإزاحة_الموقعة };
            ألحق(الحالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(المصدر, ع, التخطيط.الحجم));
        };
        *التعليمات := الحالة;
        أرجع اختيار.لا_شيء();
    };
}


عرف ألحق_استخراج_قيمة_من_عنوان_إكس(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    الأساس: معرف_سجل_افتراضي,
    الإزاحة: غير_موقع,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس
): اختيار خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        دع الحالة: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
        دع الوجهة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
        لو (تخطيط_مركب_إكس(&التخطيط)) {
            // استخراج VALUE التجميعي يملك تخزينه المستقل ولا يبقى اسما مستعارا داخل الأصل.
            أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
            ألحق(
                الحالة,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                    الوجهة, الناتج.القيمة
                )
            );
            ألحق(
                الحالة,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نسخ_ذاكرة_إكس(
                    الوجهة, الأساس, التخطيط.الحجم, 0, الإزاحة
                )
            );
        } وإلا {
            لو (!(التخطيط.الحجم == 1 || التخطيط.الحجم == 2 || التخطيط.الحجم == 4 || التخطيط.الحجم == 8)) {
                أرجع اختيار.بعض(
                    خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                        سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(
                            الناتج, التخطيط.الحجم
                        )
                    )
                );
            };
            دع ب: اختيار معرف_سجل_افتراضي = اختيار.بعض(الأساس);
            دع ف: اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
            دع الإزاحة_الموقعة: عدد = الإزاحة مثل عدد;
            دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: الإزاحة_الموقعة
            };
            ألحق(
                الحالة,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
                    الوجهة, العنوان, التخطيط.الحجم,
                    بإشارة_لقيمة_إكس(المسير, حقائق_الخلفية, الناتج)
                )
            );
        };
        *التعليمات := الحالة;
        أرجع اختيار.لا_شيء();
    };
}


عرف ألحق_نداء_إكس_بخطة(
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    هدف_النداء: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون,
    الحجج_المسير: &متجه معرف_قيمة_مسير,
    ناتج_المسير: اختيار معرف_قيمة_مسير,
    الخطة: &خطة_دالة_واجهة
): اختيار خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع خ: خطة_دالة_واجهة = *الخطة;
    دع قيم_الحجج_المسير: متجه معرف_قيمة_مسير = *الحجج_المسير;
    دع الحجج: متغير متجه قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(قيم_الحجج_المسير) مثل غير_موقع)) {
        لو (ف >= (الطول(خ.المعاملات) مثل غير_موقع)) {
            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم());
        };
        دع مرجع_المعامل: &خطة_معامل_واجهة = &خ.المعاملات[ف];
        دع المعامل: خطة_معامل_واجهة = *مرجع_المعامل;
        طابق المعامل.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> {
            // Primitive calls use the same canonical SysV value model as ordinary
            // Sultan calls. Do not collapse split/stack/indirect aggregate plans
            // back to the old scalar-register-only representation.
            دع القيمة: معرف_قيمة_مسير = قيم_الحجج_المسير[ف];
            دع سجل_القيمة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(القيمة);
            دع الحجة: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                سجل_القيمة, &المعامل.التصنيف, &المعامل.الموقع
            );
            ألحق(الحجج, الحجة);
        };
        ف := ف + 1;
    }
    دع الناتج: متغير اختيار قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = اختيار.لا_شيء();
    طابق ناتج_المسير مع
    | اختيار.لا_شيء -> {
        طابق خ.الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | _ -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم()); };
    }
    | اختيار.بعض(معرف_الناتج) -> {
        طابق خ.الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> {
            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم());
        }
        | _ -> {
            دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(معرف_الناتج);
            دع قيمة_الناتج: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                سجل_الناتج, &خ.الناتج.التصنيف, &خ.الناتج.الموقع
            );
            لو (قيمة_الناتج.تجميعي) {
                // نتيجة التجميع تحتاج تخزينا ماديا قبل النداء. عند SysV MEMORY-class
                // يحمل هذا السجل عنوان التخزين الذي يمر لاحقا كمؤشر sret مخفي.
                دع حجم_التجميع: غير_موقع = خ.الناتج.التصنيف.الحجم;
                دع محاذاة_التجميع: غير_موقع = خ.الناتج.التصنيف.المحاذاة;
                دع هوية_التجميع: غير_موقع = معرف_الناتج.القيمة;
                دع حجم_الحجز: غير_موقع = حجم_موضع_تجميعي_واجهة_إكس(حجم_التجميع);
                أضف_طلب_موضع_محلي_إكس(
                    المواضع_المحلية, هوية_التجميع, حجم_الحجز, محاذاة_التجميع
                );
                دع حالة_الحجز: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
                ألحق(
                    حالة_الحجز,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                        سجل_الناتج, هوية_التجميع
                    )
                );
                *التعليمات := حالة_الحجز;
            };
            الناتج := اختيار.بعض(قيمة_الناتج);
        };
    };
    دع النداء: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = {
        الهدف: هدف_النداء, الحجج: الحجج, الناتج: الناتج
    };
    دع الحالة: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
    ألحق(الحالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(النداء));
    *التعليمات := الحالة;
    أرجع اختيار.لا_شيء();
}

عرف ألحق_إلحاق_متجه_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المتجه: معرف_قيمة_مسير,
    العنصر: معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون
): اختيار خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق خطة_ربط_بدائي_للهدف(الهدف, هوية_بدائي_مترجم.إلحاق()) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(هوية_بدائي_مترجم.إلحاق()));
    }
    | اختيار.بعض(_) -> { };
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, المتجه) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { تخطيط_المتجه := التخطيط; };
    لو (!تخطيط_مركب_إكس(&تخطيط_المتجه)) {
        أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(المتجه));
    };
    دع جزء_البيانات: موضع_جزء_تخطيط;
    دع جزء_الطول: موضع_جزء_تخطيط;
    دع جزء_السعة: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 0) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(المتجه, 0)); }
    | اختيار.بعض(الجزء) -> { جزء_البيانات := الجزء; };
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 1) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(المتجه, 1)); }
    | اختيار.بعض(الجزء) -> { جزء_الطول := الجزء; };
    طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 2) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(المتجه, 2)); }
    | اختيار.بعض(الجزء) -> { جزء_السعة := الجزء; };
    لو (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة
        || جزء_السعة.الإزاحة <= جزء_الطول.الإزاحة
        || تخطيط_المتجه.الحجم <= جزء_السعة.الإزاحة) {
        أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(المتجه));
    };
    دع حجم_البيانات: غير_موقع = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
    دع حجم_الطول: غير_موقع = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
    دع حجم_السعة: غير_موقع = تخطيط_المتجه.الحجم - جزء_السعة.الإزاحة;
    لو (!(حجم_البيانات == 8 && حجم_الطول == 8 && حجم_السعة == 8)) {
        أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(المتجه));
    };
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العنصر) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(الفشل) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(الفشل)); }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_العنصر) -> {
        لو (تخطيط_العنصر.الحجم == 0) {
            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(العنصر, 0)
            ));
        };
        لو (!تخطيط_مركب_إكس(&تخطيط_العنصر)
            && !(تخطيط_العنصر.الحجم == 1 || تخطيط_العنصر.الحجم == 2
                || تخطيط_العنصر.الحجم == 4 || تخطيط_العنصر.الحجم == 8)) {
            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(العنصر, تخطيط_العنصر.الحجم)
            ));
        };
        دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه();
        دع سجل_المتجه: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المتجه);
        دع سجل_العنصر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(العنصر);
        دع العنصر_تجميعي: منطقي = تخطيط_مركب_إكس(&تخطيط_العنصر);
        دع الإلحاق: إلحاق_متجه_إكس_ستة_وثمانون_أربعة_وستون = {
            المتجه: سجل_المتجه,
            العنصر: سجل_العنصر,
            إزاحة_البيانات: جزء_البيانات.الإزاحة,
            إزاحة_الطول: جزء_الطول.الإزاحة,
            إزاحة_السعة: جزء_السعة.الإزاحة,
            حجم_الطول: حجم_الطول,
            حجم_السعة: حجم_السعة,
            حجم_العنصر: تخطيط_العنصر.الحجم,
            العنصر_تجميعي: العنصر_تجميعي,
            السعة_الدنيا: السياسة.السعة_الدنيا,
            عامل_النمو: السياسة.عامل_النمو
        };
        دع الحالة: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
        ألحق(الحالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.إلحاق_متجه_إكس(الإلحاق));
        *التعليمات := الحالة;
        أرجع اختيار.لا_شيء();
    };
}

عرف ألحق_تهيئة_متجه_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    التهيئة: &تهيئة_متجه_مسير,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس
): اختيار خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
        أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
    }
    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
        لو (!تخطيط_مركب_إكس(&التخطيط)) {
            أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(الناتج));
        };
        دع جزء_البيانات: موضع_جزء_تخطيط;
        دع جزء_الطول: موضع_جزء_تخطيط;
        دع جزء_السعة: موضع_جزء_تخطيط;
        طابق جزء_تخطيط_عند_إكس(&التخطيط, 0) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الناتج, 0)); }
        | اختيار.بعض(الجزء) -> { جزء_البيانات := الجزء; };
        طابق جزء_تخطيط_عند_إكس(&التخطيط, 1) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الناتج, 1)); }
        | اختيار.بعض(الجزء) -> { جزء_الطول := الجزء; };
        طابق جزء_تخطيط_عند_إكس(&التخطيط, 2) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الناتج, 2)); }
        | اختيار.بعض(الجزء) -> { جزء_السعة := الجزء; };
        لو (جزء_الطول.الإزاحة <= جزء_البيانات.الإزاحة
            || جزء_السعة.الإزاحة <= جزء_الطول.الإزاحة
            || التخطيط.الحجم <= جزء_السعة.الإزاحة) {
            أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(الناتج));
        };
        دع حجم_البيانات: غير_موقع = جزء_الطول.الإزاحة - جزء_البيانات.الإزاحة;
        دع حجم_الطول: غير_موقع = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
        دع حجم_السعة: غير_موقع = التخطيط.الحجم - جزء_السعة.الإزاحة;
        لو (!(حجم_البيانات == 1 || حجم_البيانات == 2 || حجم_البيانات == 4 || حجم_البيانات == 8)) {
            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(الناتج, حجم_البيانات)
            ));
        };
        لو (!(حجم_الطول == 1 || حجم_الطول == 2 || حجم_الطول == 4 || حجم_الطول == 8)) {
            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(الناتج, حجم_الطول)
            ));
        };
        لو (!(حجم_السعة == 1 || حجم_السعة == 2 || حجم_السعة == 4 || حجم_السعة == 8)) {
            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(
                سبب_فشل_تخطيط_اختيار_إكس.عرض_قيمة_غير_مدعوم(الناتج, حجم_السعة)
            ));
        };
        أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
        دع حالة: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
        دع الوجهة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
        ألحق(حالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(الوجهة, الناتج.القيمة));
        ألحق(حالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(
            الوجهة, جزء_البيانات.الإزاحة, 0, حجم_البيانات
        ));
        ألحق(حالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(
            الوجهة, جزء_الطول.الإزاحة, 0, حجم_الطول
        ));
        ألحق(حالة, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(
            الوجهة, جزء_السعة.الإزاحة, 0, حجم_السعة
        ));
        *التعليمات := حالة;
        دع وصف_التهيئة: تهيئة_متجه_مسير = *التهيئة;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(وصف_التهيئة.العناصر) مثل غير_موقع)) {
            دع العنصر: معرف_قيمة_مسير = وصف_التهيئة.العناصر[ف];
            طابق ألحق_إلحاق_متجه_إكس(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الناتج, العنصر, التعليمات
            ) مع
            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        حالة := *التعليمات;
        *التعليمات := حالة;
        أرجع اختيار.لا_شيء();
    };
}

عرف ألحق_بدائي_هوية_مضيف_إكس(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم,
    الحجج: &متجه معرف_قيمة_مسير,
    الناتج: اختيار معرف_قيمة_مسير,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون
): اختيار خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    لو ((الطول(*الحجج) مثل غير_موقع) != 0) {
        أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    };
    دع معرف_الناتج: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود());
    }
    | اختيار.بعض(المعرف) -> { معرف_الناتج := المعرف; };
    طابق رمز_بدائي_هوية_مضيف_للهدف(الهدف, البدائي) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
    }
    | اختيار.بعض(الرمز) -> {
        دع الحالة: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
        ألحق(
            الحالة,
            تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(
                سجل_إكس_لقيمة_مسير(معرف_الناتج), الرمز مثل غير_موقع
            )
        );
        *التعليمات := الحالة;
        أرجع اختيار.لا_شيء();
    };
}

عرف انتق_تعليمة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    التعليمة: &عرض_تعليمة_مسير,
    آخر_تعليمة: منطقي,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المقارنة_المؤجلة: &متغير اختيار مقارنة_إكس_مؤجلة,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    عدد_السجلات: &متغير غير_موقع
): اختيار خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع حالة_التعليمات: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
    دع العرض: عرض_تعليمة_مسير = *التعليمة;
    طابق العرض.العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            دع الوجهة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
            طابق الثابت مع
            | ثابت_مسير.منطق(القيمة) -> {
                دع بتات: متغير غير_موقع = 0;
                لو (القيمة) { بتات := 1; };
                ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, بتات));
            }
            | ثابت_مسير.صحيح_موقع(القيمة) -> {
                دع البتات: متغير غير_موقع = 0;
                طابق بتات_قيمة_عدد_إكس(المسير, حقائق_الخلفية, الناتج) مع
                | اختيار.بعض(ب) -> { البتات := ب; }
                | _ -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الناتج, 0)); };
                لو (!عرض_عدد_إكس_مدعوم(البتات)) { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
                دع القيمة_غير_الموقعة: غير_موقع = القيمة مثل غير_موقع;
                دع القناع: غير_موقع = قناع_عرض_عدد_إكس(البتات);
                دع الخام: غير_موقع = القيمة_غير_الموقعة & القناع;
                ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, الخام));
            }
            | ثابت_مسير.صحيح_غير_موقع(القيمة) -> {
                دع البتات: متغير غير_موقع = 0;
                طابق بتات_قيمة_عدد_إكس(المسير, حقائق_الخلفية, الناتج) مع
                | اختيار.بعض(ب) -> { البتات := ب; }
                | _ -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الناتج, 1)); };
                لو (!عرض_عدد_إكس_مدعوم(البتات)) { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
                ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, القيمة & قناع_عرض_عدد_إكس(البتات)));
            }
            | ثابت_مسير.عشري(البايتات) -> {
                دع العرض_عائم: متغير غير_موقع = 0;
                طابق بتات_قيمة_عائمة_إكس(المسير, حقائق_الخلفية, الناتج) مع
                | اختيار.بعض(ب) -> { العرض_عائم := ب; }
                | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
                طابق بتات_عائم_من_عشري(&البايتات, العرض_عائم) مع
                | اختيار.بعض(الخام) -> {
                    ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, الخام));
                }
                | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ثابت_غير_مدعوم()); };
            }
            | ثابت_مسير.دالة(الدالة) -> {
                دع الهدف_المنتقى: معرف_دالة_منتقاة = دالة_إكس_من_مسير(الدالة);
                ألحق(
                    حالة_التعليمات,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(الوجهة, الهدف_المنتقى)
                );
            }
            | ثابت_مسير.نص(البايتات) -> {
                طابق تخطيط_قيمة_مسير_للاختيار(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج
                ) مع
                | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                    أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
                }
                | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                    لو (!تخطيط_مركب_إكس(&التخطيط)) {
                        أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(الناتج));
                    };
                    دع إزاحة_البيانات: متغير غير_موقع = 0;
                    دع إزاحة_الطول: متغير غير_موقع = 0;
                    دع إزاحة_السعة: متغير غير_موقع = 0;
                    طابق جزء_تخطيط_عند_إكس(&التخطيط, 0) مع
                    | اختيار.بعض(الجزء) -> { إزاحة_البيانات := الجزء.الإزاحة; }
                    | _ -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الناتج, 0)); };
                    طابق جزء_تخطيط_عند_إكس(&التخطيط, 1) مع
                    | اختيار.بعض(الجزء) -> { إزاحة_الطول := الجزء.الإزاحة; }
                    | _ -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الناتج, 1)); };
                    طابق جزء_تخطيط_عند_إكس(&التخطيط, 2) مع
                    | اختيار.بعض(الجزء) -> { إزاحة_السعة := الجزء.الإزاحة; }
                    | _ -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الناتج, 2)); };
                    أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
                    دع بايتات_النص: متجه غ8 = انسخ_بايتات_ثابت_نص_إكس(&البايتات);
                    دع الثابت_النصي: ثابت_نص_إكس_ستة_وثمانون_أربعة_وستون = {
                        الهوية: الناتج.القيمة,
                        البايتات: بايتات_النص,
                        إزاحة_البيانات: إزاحة_البيانات,
                        إزاحة_الطول: إزاحة_الطول,
                        إزاحة_السعة: إزاحة_السعة
                    };
                    ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ثابت_نص_إكس(الثابت_النصي));
                    ألحق(
                        حالة_التعليمات,
                        تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                            الوجهة, الناتج.القيمة
                        )
                    );
                };
            };
        };
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            دع البتات: متغير غير_موقع = 0;
            طابق بتات_قيمة_عدد_إكس(المسير, حقائق_الخلفية, الناتج) مع
            | اختيار.بعض(ب) -> { البتات := ب; }
            | _ -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
            لو (!عرض_عدد_إكس_مدعوم(البتات)) { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
            ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(
                حساب_إكس_من_مسير(الحساب.العملية), سجل_إكس_لقيمة_مسير(الناتج),
                سجل_إكس_لقيمة_مسير(الحساب.اليسار), سجل_إكس_لقيمة_مسير(الحساب.اليمين),
                البتات, بإشارة_لقيمة_إكس(المسير, حقائق_الخلفية, الناتج)
            ));
        };
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            دع البتات: متغير غير_موقع = 0;
            طابق بتات_قيمة_عائمة_إكس(المسير, حقائق_الخلفية, الحساب.اليسار) مع
            | اختيار.بعض(ب) -> { البتات := ب; }
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.حساب_غير_مدعوم()); };
            ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_عشري_إكس(
                حساب_عشري_إكس_من_مسير(الحساب.العملية), سجل_إكس_لقيمة_مسير(الناتج),
                سجل_إكس_لقيمة_مسير(الحساب.اليسار), سجل_إكس_لقيمة_مسير(الحساب.اليمين), البتات
            ));
        };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            دع البتات: متغير غير_موقع = 0;
            طابق بتات_قيمة_عائمة_إكس(المسير, حقائق_الخلفية, المقارنة.اليسار) مع
            | اختيار.بعض(ب) -> { البتات := ب; }
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة()); };
            ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_عشرية_إلى_منطق_إكس(
                مقارنة_عشرية_إكس_من_مسير(المقارنة.العملية), سجل_إكس_لقيمة_مسير(الناتج),
                سجل_إكس_لقيمة_مسير(المقارنة.اليسار), سجل_إكس_لقيمة_مسير(المقارنة.اليمين), البتات
            ));
            *المقارنة_المؤجلة := اختيار.لا_شيء();
        };
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            دع البتات: متغير غير_موقع = 0;
            طابق بتات_قيمة_عدد_إكس(المسير, حقائق_الخلفية, المقارنة.اليسار) مع
            | اختيار.بعض(ب) -> { البتات := ب; }
            | _ -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة()); };
            لو (!عرض_عدد_إكس_مدعوم(البتات)) { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة()); };
            طابق صنف_إشارة_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, المقارنة.اليسار) مع
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); }
            | اختيار.بعض(الإشارة) -> {
                دع الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون = شرط_إكس_من_مقارنة(المقارنة.العملية, الإشارة);
                ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(
                    سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(المقارنة.اليسار),
                    سجل_إكس_لقيمة_مسير(المقارنة.اليمين), الشرط, البتات
                ));
                *المقارنة_المؤجلة := اختيار.لا_شيء();
            };
        };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            دع من_بتات: متغير غير_موقع = 0;
            دع إلى_بتات: متغير غير_موقع = 0;
            دع المصدر_موقع: متغير منطقي = خطأ;
            طابق وصف_تحويل_لقيمة_إكس(المسير, حقائق_الخلفية, التحويل.المصدر) مع
            | اختيار.بعض(الوصف) -> {
                من_بتات := الوصف.البتات;
                المصدر_موقع := الوصف.موقع;
            }
            | _ -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم()); };
            طابق وصف_تحويل_لقيمة_إكس(المسير, حقائق_الخلفية, الناتج) مع
            | اختيار.بعض(الوصف) -> { إلى_بتات := الوصف.البتات; }
            | _ -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم()); };
            لو (!عرض_عدد_إكس_مدعوم(من_بتات) || !عرض_عدد_إكس_مدعوم(إلى_بتات)) { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم()); };
            ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_صحيح_كامل_إكس(
                تحويل_إكس_من_مسير(التحويل.العملية), سجل_إكس_لقيمة_مسير(الناتج),
                سجل_إكس_لقيمة_مسير(التحويل.المصدر), من_بتات, إلى_بتات,
                المصدر_موقع
            ));
        };
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> { ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(التحويل.المرجع))); };
    }
    | عملية_مسير.تجميع(التجميع) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                لو (!تخطيط_مركب_إكس(&التخطيط)) { أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(الناتج)); };
                أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
                ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(سجل_الناتج, الناتج.القيمة));
                *التعليمات := حالة_التعليمات;
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(التجميع.الأعضاء) مثل غير_موقع)) {
                    طابق جزء_تخطيط_عند_إكس(&التخطيط, ف) مع
                    | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الناتج, ف)); }
                    | اختيار.بعض(الجزء) -> {
                        طابق ألحق_تخزين_قيمة_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, التجميع.الأعضاء[ف], سجل_الناتج, الجزء.الإزاحة) مع
                        | اختيار.بعض(خطأ_التخطيط) -> { أرجع اختيار.بعض(خطأ_التخطيط); }
                        | اختيار.لا_شيء -> { };
                    };
                    ف := ف + 1;
                }
                حالة_التعليمات := *التعليمات;
            };
        };
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود());
        }
        | اختيار.بعض(الناتج) -> {
            *التعليمات := حالة_التعليمات;
            طابق ألحق_تهيئة_متجه_إكس(
                المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                الناتج, &التهيئة, التعليمات, المواضع_المحلية
            ) مع
            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | اختيار.لا_شيء -> { };
            حالة_التعليمات := *التعليمات;
        };
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الاستخراج.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المصدر) -> {
                طابق جزء_تخطيط_عند_إكس(&تخطيط_المصدر, الاستخراج.الفهرس) مع
                | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(الاستخراج.المصدر, الاستخراج.الفهرس)); }
                | اختيار.بعض(الجزء) -> {
                    طابق ألحق_استخراج_قيمة_من_عنوان_إكس(
                        &متغير حالة_التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                        الناتج, سجل_إكس_لقيمة_مسير(الاستخراج.المصدر), الجزء.الإزاحة,
                        المواضع_المحلية
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                    | اختيار.لا_شيء -> { };
                };
            };
        };
    }
    | عملية_مسير.استخراج_فهرس(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
                دع سجل_العنوان: متغير معرف_سجل_افتراضي = سجل_الناتج;
                لو (تخطيط_مركب_إكس(&التخطيط)) {
                    دع التالي: غير_موقع = *عدد_السجلات;
                    سجل_العنوان := معرف_سجل_افتراضي_من(التالي);
                    *عدد_السجلات := التالي + 1;
                };
                *التعليمات := حالة_التعليمات;
                طابق ألحق_عنوان_عنصر_تسلسل_إكس(
                    التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    الاستخراج.المصدر, الاستخراج.الفهرس, &التخطيط, سجل_العنوان
                ) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
                طابق ألحق_استخراج_قيمة_من_عنوان_إكس(
                    التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    الناتج, سجل_العنوان, 0, المواضع_المحلية
                ) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
                حالة_التعليمات := *التعليمات;
            };
        };
    }
    | عملية_مسير.مكان_محلي(_) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
                ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(سجل_إكس_لقيمة_مسير(الناتج), الناتج.القيمة));
            };
        };
    }
    | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
        طابق العرض.الناتج مع | اختيار.بعض(الناتج) -> { ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(العملية.المرجع))); } | _ -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
    }
    | عملية_مسير.صندوق_إلى_مكان(العملية) -> {
        طابق العرض.الناتج مع | اختيار.بعض(الناتج) -> { ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(العملية.الصندوق))); } | _ -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
    }
    | عملية_مسير.مكان_حقل(العملية) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.الأصل) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الأصل) -> {
                طابق جزء_تخطيط_عند_إكس(&تخطيط_الأصل, العملية.الفهرس) مع
                | اختيار.بعض(الجزء) -> { ألحق(حالة_التعليمات, عنوان_بإزاحة_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(العملية.الأصل), الجزء.الإزاحة)); }
                | _ -> { أرجع اختيار.بعض(خطأ_جزء_تخطيط_إكس(العملية.الأصل, العملية.الفهرس)); };
            }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.مكان_فهرس(العملية) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
                *التعليمات := حالة_التعليمات;
                طابق ألحق_عنوان_عنصر_تسلسل_إكس(
                    التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    العملية.الأصل, العملية.الفهرس, &التخطيط, سجل_الناتج
                ) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
                حالة_التعليمات := *التعليمات;
            }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(العملية.المؤشر), سجل_إكس_لقيمة_مسير(العملية.الفهرس), التخطيط.الحجم, 0)); }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.تحميل(العملية) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج); دع سجل_المكان: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(العملية.المكان);
                لو (تخطيط_مركب_إكس(&التخطيط)) {
                    أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
                    ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(سجل_الناتج, الناتج.القيمة));
                    ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نسخ_ذاكرة_إكس(سجل_الناتج, سجل_المكان, التخطيط.الحجم, 0, 0));
                } وإلا {
                    دع ب: اختيار معرف_سجل_افتراضي = اختيار.بعض(سجل_المكان); دع ف: اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
                    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = { الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: 0 };
                    ألحق(
                        حالة_التعليمات,
                        تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
                            سجل_الناتج, ع, التخطيط.الحجم,
                            بإشارة_لقيمة_إكس(المسير, حقائق_الخلفية, الناتج)
                        )
                    );
                };
            };
        };
    }
    | عملية_مسير.تخزين(العملية) -> {
        *التعليمات := حالة_التعليمات;
        طابق ألحق_تخزين_قيمة_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العملية.القيمة, سجل_إكس_لقيمة_مسير(العملية.المكان), 0) مع
                        | اختيار.بعض(خطأ_التخطيط) -> { أرجع اختيار.بعض(خطأ_التخطيط); }
                        | اختيار.لا_شيء -> { };
        حالة_التعليمات := *التعليمات;
    }
    | عملية_مسير.مكان_إلى_مرجع(العملية) -> {
        طابق العرض.الناتج مع | اختيار.بعض(الناتج) -> { ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(العملية.المكان))); } | _ -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
    }
    | عملية_مسير.بناء_موسوم(العملية) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج, العملية.المنشئ
                    ) مع
                    | نتيجة_تخطيط_منشئ.مكتمل(المنشئ) -> {
                        دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
                        ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(سجل_الناتج, الناتج.القيمة));
                        ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(سجل_الناتج, التعداد.الوسم.الإزاحة, المنشئ.قيمة_الوسم, التعداد.الوسم.الحجم));
                        *التعليمات := حالة_التعليمات;
                        دع ف: متغير غير_موقع = 0;
                        بينما (ف < (الطول(العملية.الحمولات) مثل غير_موقع)) {
                            لو (ف >= (الطول(المنشئ.الحمولات) مثل غير_موقع)) {
                                دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مفقودة(الناتج, ف);
                                أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                            };
                            دع الإزاحة: غير_موقع = التعداد.مخزن_الحمولة.الإزاحة + المنشئ.الحمولات[ف].الإزاحة;
                            طابق ألحق_تخزين_قيمة_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العملية.الحمولات[ف], سجل_الناتج, الإزاحة) مع
                        | اختيار.بعض(خطأ_التخطيط) -> { أرجع اختيار.بعض(خطأ_التخطيط); }
                        | اختيار.لا_شيء -> { };
                            ف := ف + 1;
                        }
                        حالة_التعليمات := *التعليمات;
                    }
                    | نتيجة_تخطيط_منشئ.مؤجل(السبب_المؤجل) -> {
                        دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مؤجلة(الناتج, السبب_المؤجل);
                        أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                    }
                    | نتيجة_تخطيط_منشئ.مرفوض(الخطأ) -> {
                        دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مرفوضة(الناتج, الخطأ);
                        أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                    };
                }
                | _ -> { أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(الناتج)); };
            };
        };
    }
    | عملية_مسير.استعلام_وسم(العملية) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(العملية.المصدر);
                    دع ب: اختيار معرف_سجل_افتراضي = اختيار.بعض(سجل_المصدر);
                    دع ف: اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
                    دع إزاحة_الوسم_الموقعة: عدد = التعداد.الوسم.الإزاحة مثل عدد;
                    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = { الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: إزاحة_الوسم_الموقعة };
                    ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(سجل_إكس_لقيمة_مسير(الناتج), ع, التعداد.الوسم.الحجم, خطأ));
                }
                | _ -> { أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(العملية.المصدر)); };
            }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.استخراج_حمولة(العملية) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المصدر) -> {
                طابق تخطيط_المصدر.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.المصدر, العملية.المنشئ
                    ) مع
                    | نتيجة_تخطيط_منشئ.مكتمل(المنشئ) -> {
                        لو (العملية.الحمولة >= (الطول(المنشئ.الحمولات) مثل غير_موقع)) {
                            دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مفقودة(العملية.المصدر, العملية.الحمولة);
                            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                        };
                        دع الإزاحة: غير_موقع = التعداد.مخزن_الحمولة.الإزاحة + المنشئ.الحمولات[العملية.الحمولة].الإزاحة;
                        طابق ألحق_استخراج_قيمة_من_عنوان_إكس(
                            &متغير حالة_التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                            الناتج, سجل_إكس_لقيمة_مسير(العملية.المصدر), الإزاحة,
                            المواضع_المحلية
                        ) مع
                        | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                        | اختيار.لا_شيء -> { };
                    }
                    | نتيجة_تخطيط_منشئ.مؤجل(السبب_المؤجل) -> {
                        دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مؤجلة(العملية.المصدر, السبب_المؤجل);
                        أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                    }
                    | نتيجة_تخطيط_منشئ.مرفوض(الخطأ) -> {
                        دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مرفوضة(العملية.المصدر, الخطأ);
                        أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                    };
                }
                | _ -> { أرجع اختيار.بعض(خطأ_بنية_تخطيط_إكس(العملية.المصدر)); };
            }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.بناء_صندوق(العملية) -> {
        طابق العرض.الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختيار.بعض(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.القيمة) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
                ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_صندوق_إكس(سجل_الناتج, التخطيط.الحجم, التخطيط.المحاذاة));
                *التعليمات := حالة_التعليمات;
                طابق ألحق_تخزين_قيمة_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العملية.القيمة, سجل_الناتج, 0) مع
                        | اختيار.بعض(خطأ_التخطيط) -> { أرجع اختيار.بعض(خطأ_التخطيط); }
                        | اختيار.لا_شيء -> { };
                حالة_التعليمات := *التعليمات;
            }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
            طابق البدائي مع
            | هوية_بدائي_مترجم.معمارية_المضيف -> {
                طابق ألحق_بدائي_هوية_مضيف_إكس(الهدف, البدائي, &النداء.الحجج, العرض.الناتج, &متغير حالة_التعليمات) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
            }
            | هوية_بدائي_مترجم.منصة_المضيف -> {
                طابق ألحق_بدائي_هوية_مضيف_إكس(الهدف, البدائي, &النداء.الحجج, العرض.الناتج, &متغير حالة_التعليمات) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
            }
            | هوية_بدائي_مترجم.بيئة_المضيف -> {
                طابق ألحق_بدائي_هوية_مضيف_إكس(الهدف, البدائي, &النداء.الحجج, العرض.الناتج, &متغير حالة_التعليمات) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
            }
            | هوية_بدائي_مترجم.طول -> {
                لو ((الطول(النداء.الحجج) مثل غير_موقع) != 1) {
                    أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود());
                }
                | اختيار.بعض(الناتج) -> {
                    طابق تخطيط_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, النداء.الحجج[0]
                    ) مع
                    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                        أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
                    }
                    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الحجة) -> {
                        طابق جزء_تخطيط_عند_إكس(&تخطيط_الحجة, 1) مع
                        | اختيار.لا_شيء -> {
                            أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم());
                        }
                        | اختيار.بعض(جزء_الطول) -> {
                            طابق تخطيط_قيمة_مسير_للاختيار(
                                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج
                            ) مع
                            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                                أرجع اختيار.بعض(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
                            }
                            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الناتج) -> {
                                دع الأساس: اختيار معرف_سجل_افتراضي =
                                    اختيار.بعض(سجل_إكس_لقيمة_مسير(النداء.الحجج[0]));
                                دع الفهرس: اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
                                دع إزاحة_الطول: عدد = جزء_الطول.الإزاحة مثل عدد;
                                دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                                    الأساس: الأساس,
                                    الفهرس: الفهرس,
                                    المقياس: 1,
                                    الإزاحة: إزاحة_الطول
                                };
                                ألحق(
                                    حالة_التعليمات,
                                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
                                        سجل_إكس_لقيمة_مسير(الناتج),
                                        العنوان,
                                        تخطيط_الناتج.الحجم,
                                        خطأ
                                    )
                                );
                            };
                        };
                    };
                };
            }
            | هوية_بدائي_مترجم.إلحاق -> {
                لو ((الطول(النداء.الحجج) مثل غير_موقع) != 2) {
                    أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختيار.بعض(_) -> {
                    أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختيار.لا_شيء -> { };
                دع العنصر: معرف_قيمة_مسير = النداء.الحجج[1];
                طابق النداء.مكان_التعديل مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختيار.بعض(مكان_المتجه) -> {
                    طابق ألحق_إلحاق_متجه_إكس(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, مكان_المتجه, العنصر, &متغير حالة_التعليمات
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                    | اختيار.لا_شيء -> { };
                };
            }
            | _ -> {
                طابق حل_واجهة_نداء_قيم_مسير_للهدف(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &النداء.الحجج, العرض.الناتج
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ));
                }
                | نتيجة.نجح(خطة_البدائي) -> {
                    دع هدف_البدائي: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون =
                        هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.بدائي_تشغيل(البدائي);
                    طابق ألحق_نداء_إكس_بخطة(
                        &متغير حالة_التعليمات, المواضع_المحلية, هدف_البدائي,
                        &النداء.الحجج, العرض.الناتج, &خطة_البدائي
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                    | اختيار.لا_شيء -> { };
                };
            };
        }
        | هدف_نداء_مسير.قيمة_دالة(الدالة_القيمة) -> {
            طابق حل_واجهة_نداء_قيم_مسير_للهدف(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                &النداء.الحجج, العرض.الناتج
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(
                    خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ)
                );
            }
            | نتيجة.نجح(خطة_الدالة) -> {
                دع هدف_القيمة: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون =
                    هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.قيمة_دالة(
                        سجل_إكس_لقيمة_مسير(الدالة_القيمة)
                    );
                طابق ألحق_نداء_إكس_بخطة(
                    &متغير حالة_التعليمات, المواضع_المحلية, هدف_القيمة,
                    &النداء.الحجج, العرض.الناتج, &خطة_الدالة
                ) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
            };
        }
        | هدف_نداء_مسير.دالة_خارجية(معرف_الدالة) -> {
            طابق ابحث_دالة_خارجية_مسير(المسير, معرف_الدالة) مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(
                    خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم()
                );
            }
            | اختيار.بعض(الدالة) -> {
                لو ((الطول(النداء.الحجج) مثل غير_موقع) != (الطول(الدالة.المعاملات) مثل غير_موقع)) {
                    أرجع اختيار.بعض(
                        خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم()
                    );
                };
                طابق حل_واجهة_نداء_قيم_مسير_للهدف(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                    &النداء.الحجج, العرض.الناتج
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(
                        خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ)
                    );
                }
                | نتيجة.نجح(الخطة) -> {
                    دع المعرف_المنتقى: معرف_دالة_خارجية_منتقاة =
                        معرف_دالة_خارجية_منتقاة_من_مسير(معرف_الدالة);
                    دع هدف_الدالة: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون =
                        هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة_خارجية(المعرف_المنتقى);
                    طابق ألحق_نداء_إكس_بخطة(
                        &متغير حالة_التعليمات, المواضع_المحلية, هدف_الدالة,
                        &النداء.الحجج, العرض.الناتج, &الخطة
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                    | اختيار.لا_شيء -> { };
                };
            };
        }
        | هدف_نداء_مسير.دالة_سلطان(معرف_الدالة) -> {
            طابق ابحث_دالة_مسير(المسير, معرف_الدالة) مع
            | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
                أرجع اختيار.بعض(
                    خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.دالة_مسير_مفقودة(المفقود)
                );
            }
            | نتيجة_بحث_دالة_مسير.موجودة(الدالة) -> {
                لو ((الطول(النداء.الحجج) مثل غير_موقع) != الدالة.عدد_المعاملات) {
                    أرجع اختيار.بعض(
                        خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم()
                    );
                };
                طابق حل_واجهة_عرض_دالة_مسير_للهدف(
                    حقائق_الخلفية,
                    المسير,
                    الهدف,
                    سجل_التخطيط,
                    &الدالة
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(
                        خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ)
                    );
                }
                | نتيجة.نجح(الخطة) -> {
                    دع الحجج: متغير متجه قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = [];
                    دع ف: متغير غير_موقع = 0;
                    بينما (ف < (الطول(النداء.الحجج) مثل غير_موقع)) {
                        لو (ف >= (الطول(الخطة.المعاملات) مثل غير_موقع)) {
                            أرجع اختيار.بعض(
                                خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم()
                            );
                        };
                        دع مرجع_خطة_المعامل: &خطة_معامل_واجهة = &الخطة.المعاملات[ف];
                        دع خطة_المعامل: خطة_معامل_واجهة = *مرجع_خطة_المعامل;
                        طابق خطة_المعامل.الموقع مع
                        | موقع_تمرير_واجهة.متجاهل -> { }
                        | _ -> {
                            دع سجل_الحجة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(النداء.الحجج[ف]);
                            دع الحجة: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                                سجل_الحجة, &خطة_المعامل.التصنيف, &خطة_المعامل.الموقع
                            );
                            ألحق(الحجج, الحجة);
                        };
                        ف := ف + 1;
                    }
                    دع الناتج: متغير اختيار قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = اختيار.لا_شيء();
                    طابق العرض.الناتج مع
                    | اختيار.لا_شيء -> {
                        طابق الخطة.الناتج.الموقع مع
                        | موقع_تمرير_واجهة.متجاهل -> { }
                        | _ -> {
                            أرجع اختيار.بعض(
                                خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم()
                            );
                        };
                    }
                    | اختيار.بعض(معرف_الناتج) -> {
                        طابق الخطة.الناتج.الموقع مع
                        | موقع_تمرير_واجهة.متجاهل -> { }
                        | _ -> {
                            دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(معرف_الناتج);
                            دع قيمة_الناتج: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                                سجل_الناتج, &الخطة.الناتج.التصنيف, &الخطة.الناتج.الموقع
                            );
                            لو (قيمة_الناتج.تجميعي) {
                                دع حجم_التجميع: غير_موقع = الخطة.الناتج.التصنيف.الحجم;
                                دع محاذاة_التجميع: غير_موقع = الخطة.الناتج.التصنيف.المحاذاة;
                                دع هوية_التجميع: غير_موقع = معرف_الناتج.القيمة;
                                دع حجم_الحجز: غير_موقع = حجم_موضع_تجميعي_واجهة_إكس(حجم_التجميع);
                                أضف_طلب_موضع_محلي_إكس(
                                    المواضع_المحلية, هوية_التجميع, حجم_الحجز, محاذاة_التجميع
                                );
                                ألحق(
                                    حالة_التعليمات,
                                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                                        سجل_الناتج, هوية_التجميع
                                    )
                                );
                            };
                            الناتج := اختيار.بعض(قيمة_الناتج);
                        };
                    };
                    دع دالة_النداء: معرف_دالة_منتقاة = دالة_إكس_من_مسير(معرف_الدالة);
                    دع هدف_النداء: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون =
                        هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة(دالة_النداء);
                    دع الخطة_المنتقاة: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = {
                        الهدف: هدف_النداء,
                        الحجج: الحجج,
                        الناتج: الناتج
                    };
                    ألحق(
                        حالة_التعليمات,
                        تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(الخطة_المنتقاة)
                    );
                };
            };
        };
    }
    *التعليمات := حالة_التعليمات;
    أرجع اختيار.لا_شيء();
}

عرف انتق_منهي_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    خطة_الناتج: اختيار خطة_ناتج_واجهة,
    عنوان_ناتج_غير_مباشر: اختيار معرف_سجل_افتراضي,
    المنهي: &منهي_مسير,
    المقارنة_المؤجلة: اختيار مقارنة_إكس_مؤجلة,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    الخلفاء: &متغير متجه معرف_كتلة_منتقاة
): اختيار خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع حالة_التعليمات: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *التعليمات;
    دع حالة_الخلفاء: متغير متجه معرف_كتلة_منتقاة = *الخلفاء;
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        طابق حزمة_نقل_حافة_إكس(المسير, &الحافة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(الحزمة) -> {
            دع هدف_الحافة: معرف_كتلة_منتقاة = الحزمة.الهدف;
            ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(الحزمة));
            ألحق(حالة_الخلفاء, هدف_الحافة);
        };
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        طابق حزمة_نقل_حافة_إكس(المسير, &عند_الصواب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(حزمة_الصواب) -> {
            طابق حزمة_نقل_حافة_إكس(المسير, &عند_الخطأ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | نتيجة.نجح(حزمة_الخطأ) -> {
                ألحق(
                    حالة_التعليمات,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(
                        سجل_إكس_لقيمة_مسير(الشرط), حزمة_الصواب
                    )
                );
                ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(حزمة_الخطأ));
                ألحق(حالة_الخلفاء, كتلة_إكس_من_مسير(عند_الصواب.الهدف));
                ألحق(حالة_الخلفاء, كتلة_إكس_من_مسير(عند_الخطأ.الهدف));
            };
        };
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        طابق القيمة مع
        | اختيار.لا_شيء -> {
            طابق خطة_الناتج مع
            | اختيار.بعض(الخطة) -> {
                طابق الخطة.الموقع مع
                | موقع_تمرير_واجهة.متجاهل -> {
                    ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس());
                }
                | _ -> {
                    أرجع اختيار.بعض(
                        خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                    );
                };
            }
            | اختيار.لا_شيء -> {
                ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس());
            };
        }
        | اختيار.بعض(المعرف) -> {
            طابق خطة_الناتج مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(
                    خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                );
            }
            | اختيار.بعض(الخطة) -> {
                طابق الخطة.الموقع مع
                | موقع_تمرير_واجهة.متجاهل -> {
                    أرجع اختيار.بعض(
                        خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                    );
                }
                | _ -> {
                    دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المعرف);
                    دع قيمة_الناتج: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                        سجل_الناتج, &الخطة.التصنيف, &الخطة.الموقع
                    );
                    دع الناتج: ناتج_عودة_إكس_ستة_وثمانون_أربعة_وستون_منتقى = {
                        القيمة: قيمة_الناتج,
                        عنوان_ناتج_غير_مباشر: عنوان_ناتج_غير_مباشر
                    };
                    ألحق(
                        حالة_التعليمات,
                        تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس_بقيمة(الناتج)
                    );
                };
            };
        };
    }
    | منهي_مسير.فخ -> {
        ألحق(حالة_التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس());
    };
    *التعليمات := حالة_التعليمات;
    *الخلفاء := حالة_الخلفاء;
    أرجع اختيار.لا_شيء();
}

عرف انتق_كتلة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    خطة_الناتج: اختيار خطة_ناتج_واجهة,
    عنوان_ناتج_غير_مباشر: اختيار معرف_سجل_افتراضي,
    تعليمات_المدخل: &متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    عدد_السجلات: &متغير غير_موقع,
    الدالة: معرف_دالة_مسير,
    المعرف: معرف_كتلة_مسير
): نتيجة كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة, فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق ابحث_كتلة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(المفقود) -> {
        أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_كتلة(
            الدالة, المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.كتلة_مسير_مفقودة(المفقود)
        ));
    }
    | نتيجة_بحث_كتلة_مسير.موجودة(العرض) -> {
        دع التعليمات: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = *تعليمات_المدخل;
        دع الخلفاء: متغير متجه معرف_كتلة_منتقاة = [];
        دع المقارنة_المؤجلة: متغير اختيار مقارنة_إكس_مؤجلة = اختيار.لا_شيء();
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العرض.عدد_التعليمات) {
            طابق تعليمة_مسير_عند(المسير, المعرف, ف) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_كتلة(
                    الدالة, المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()
                ));
            }
            | اختيار.بعض(التعليمة) -> {
                دع فئة_العملية: فئة_عملية_اختيار_إكس = فئة_عملية_اختيار_إكس_من(&التعليمة.العملية);
                دع آخر_تعليمة: منطقي = ف + 1 == العرض.عدد_التعليمات;
                طابق انتق_تعليمة_إكس(
                    المسير,
                    حقائق_الخلفية,
                    الهدف,
                    سجل_التخطيط,
                    &التعليمة,
                    آخر_تعليمة,
                    &متغير التعليمات,
                    &متغير المقارنة_المؤجلة,
                    المواضع_المحلية,
                    عدد_السجلات
                ) مع
                | اختيار.بعض(الخطأ) -> {
                    أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_تعليمة(
                        الدالة, المعرف, ف, فئة_العملية, الخطأ
                    ));
                }
                | اختيار.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        طابق منهي_كتلة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_منهي_مسير.موجود(المنهي) -> {
            طابق انتق_منهي_إكس(
                المسير,
                حقائق_الخلفية,
                خطة_الناتج,
                عنوان_ناتج_غير_مباشر,
                &المنهي,
                المقارنة_المؤجلة,
                &متغير التعليمات,
                &متغير الخلفاء
            ) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_كتلة(الدالة, المعرف, الخطأ));
            }
            | اختيار.لا_شيء -> { };
        }
        | _ -> {
            أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_كتلة(
                الدالة, المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.منهي_غير_مدعوم()
            ));
        };
        دع معرف_الكتلة_المنتقاة: معرف_كتلة_منتقاة = كتلة_إكس_من_مسير(المعرف);
        دع الرأس: رأس_كتلة_منتقاة = {
            المعرف: معرف_الكتلة_المنتقاة,
            الخلفاء: الخلفاء
        };
        دع الكتلة: كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
            الرأس: الرأس,
            التعليمات: التعليمات
        };
        أرجع نتيجة.نجح(الكتلة);
    };
}

عام عرف انتق_دالة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_دالة_مسير
): نتيجة دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة, فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع عدد_السجلات: متغير غير_موقع = 0;
    طابق عدد_سجلات_افتراضية_لمعرف_دالة_مسير(المسير, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
            المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.دالة_مسير_مفقودة(المعرف)
        ));
    }
    | اختيار.بعض(العدد) -> { عدد_السجلات := العدد; };

    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
        أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
            المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.دالة_مسير_مفقودة(المفقود)
        ));
    }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
        دع خطة_الواجهة: متغير خطة_دالة_واجهة;
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(
            حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &العرض
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ)
            ));
        }
        | نتيجة.نجح(الخطة) -> { خطة_الواجهة := الخطة; };

        دع مرجع_خطة_الناتج: &خطة_ناتج_واجهة = &خطة_الواجهة.الناتج;
        دع خطة_الناتج: اختيار خطة_ناتج_واجهة = اختيار.بعض(*مرجع_خطة_الناتج);
        دع عنوان_ناتج_غير_مباشر: متغير اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
        دع تعليمات_المدخل: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [];
        دع المواضع_المحلية: متغير متجه طلب_موضع_محلي_إكس = [];

        // التقط حامل النتيجة غير المباشرة أولا، ثم انقله إلى سجل عادي بعد التقاط كل حوامل ABI.
        دع حامل_ناتج_غير_مباشر: متغير اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
        طابق خطة_الواجهة.الناتج.الموقع مع
        | موقع_تمرير_واجهة.غير_مباشر(موضع_العنوان) -> {
            دع حامل: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
            دع محفوظ: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات + 1);
            عدد_السجلات := عدد_السجلات + 2;
            دع المواضع: متغير متجه موضع_جزء_واجهة = [];
            ألحق(المواضع, موضع_العنوان);
            دع قيمة_الحامل: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
                السجل: حامل,
                المواضع: المواضع,
                الحجم: 8,
                تجميعي: خطأ,
                غير_مباشر: خطأ
            };
            ألحق(
                تعليمات_المدخل,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(قيمة_الحامل)
            );
            حامل_ناتج_غير_مباشر := اختيار.بعض(حامل);
            عنوان_ناتج_غير_مباشر := اختيار.بعض(محفوظ);
        }
        | _ -> { };

        // التقط أجزاء التجميع في سجلات مؤقتة قبل بناء التخزين المحلي.
        دع التجميعات_المؤجلة: متغير متجه تجهيز_معامل_تجميعي_إكس = [];
        دع النقلات_المؤجلة: متغير متجه تجهيز_معامل_مفرد_إكس = [];
        دع ف_المعامل: متغير غير_موقع = 0;
        بينما (ف_المعامل < العرض.عدد_المعاملات) {
            لو (ف_المعامل >= (الطول(خطة_الواجهة.المعاملات) مثل غير_موقع)) {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                    المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                ));
            };
            طابق معامل_دالة_مسير_عند(المسير, المعرف, ف_المعامل) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                    المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                ));
            }
            | اختيار.بعض(المعامل) -> {
                دع مرجع_خطة_المعامل: &خطة_معامل_واجهة = &خطة_الواجهة.المعاملات[ف_المعامل];
                دع خطة_المعامل: خطة_معامل_واجهة = *مرجع_خطة_المعامل;
                طابق خطة_المعامل.الموقع مع
                | موقع_تمرير_واجهة.متجاهل -> { }
                | _ -> {
                    دع سجل_المعامل: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المعامل.المعرف);
                    دع قيمة_الواجهة: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                        سجل_المعامل, &خطة_المعامل.التصنيف, &خطة_المعامل.الموقع
                    );
                    لو (قيمة_الواجهة.تجميعي && !قيمة_الواجهة.غير_مباشر) {
                        دع الأجزاء: متغير متجه معرف_سجل_افتراضي = [];
                        دع أحجام_الأجزاء: متغير متجه غير_موقع = [];
                        دع فج: متغير غير_موقع = 0;
                        بينما (فج < (الطول(قيمة_الواجهة.المواضع) مثل غير_موقع)) {
                            دع سجل_الجزء: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                            عدد_السجلات := عدد_السجلات + 1;
                            دع بداية_الجزء: غير_موقع = فج * 8;
                            دع المتبقي: غير_موقع = قيمة_الواجهة.الحجم - بداية_الجزء;
                            دع حجم_الجزء: متغير غير_موقع = المتبقي;
                            لو (حجم_الجزء > 8) { حجم_الجزء := 8; };
                            دع مواضع_الجزء: متغير متجه موضع_جزء_واجهة = [];
                            ألحق(مواضع_الجزء, قيمة_الواجهة.المواضع[فج]);
                            دع قيمة_الجزء: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
                                السجل: سجل_الجزء,
                                المواضع: مواضع_الجزء,
                                الحجم: حجم_الجزء,
                                تجميعي: خطأ,
                                غير_مباشر: خطأ
                            };
                            ألحق(
                                تعليمات_المدخل,
                                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(قيمة_الجزء)
                            );
                            ألحق(الأجزاء, سجل_الجزء);
                            ألحق(أحجام_الأجزاء, حجم_الجزء);
                            فج := فج + 1;
                        }
                        دع حجم_التجميع: غير_موقع = خطة_المعامل.التصنيف.الحجم;
                        دع محاذاة_التجميع: غير_موقع = خطة_المعامل.التصنيف.المحاذاة;
                        دع التجهيز: تجهيز_معامل_تجميعي_إكس = {
                            المعرف: المعامل.المعرف,
                            الحجم: حجم_التجميع,
                            المحاذاة: محاذاة_التجميع,
                            الأجزاء: الأجزاء,
                            أحجام_الأجزاء: أحجام_الأجزاء
                        };
                        ألحق(التجميعات_المؤجلة, التجهيز);
                    } وإلا {
                        // التقط موضع SysV في حامل قصير العمر، ثم انقل القيمة إلى
                        // سجل المعامل العادي بعد التقاط كل سجلات/مواضع ABI.
                        دع سجل_الحامل: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                        عدد_السجلات := عدد_السجلات + 1;
                        دع قيمة_الحامل: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                            سجل_الحامل, &خطة_المعامل.التصنيف, &خطة_المعامل.الموقع
                        );
                        ألحق(
                            تعليمات_المدخل,
                            تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(قيمة_الحامل)
                        );
                        دع النقل: تجهيز_معامل_مفرد_إكس = {
                            الوجهة: سجل_المعامل,
                            الحامل: سجل_الحامل
                        };
                        ألحق(النقلات_المؤجلة, النقل);
                    };
                };
            };
            ف_المعامل := ف_المعامل + 1;
        }

        طابق حامل_ناتج_غير_مباشر مع
        | اختيار.بعض(الحامل) -> {
            طابق عنوان_ناتج_غير_مباشر مع
            | اختيار.بعض(المحفوظ) -> {
                ألحق(
                    تعليمات_المدخل,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(المحفوظ, الحامل)
                );
            }
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                    المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                ));
            };
        }
        | اختيار.لا_شيء -> { };

        // لا تُنقل الحوامل إلى سجلات المعاملات إلا بعد اكتمال التقاط جميع
        // مواضع SysV، حتى لا يكتب نقل مبكر فوق سجل دخل لم يُلتقط بعد.
        دع ف_النقل: متغير غير_موقع = 0;
        بينما (ف_النقل < (الطول(النقلات_المؤجلة) مثل غير_موقع)) {
            دع مرجع_النقل: &تجهيز_معامل_مفرد_إكس = &النقلات_المؤجلة[ف_النقل];
            دع النقل: تجهيز_معامل_مفرد_إكس = *مرجع_النقل;
            ألحق(
                تعليمات_المدخل,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(النقل.الوجهة, النقل.الحامل)
            );
            ف_النقل := ف_النقل + 1;
        }

        // أعد تركيب المعاملات التجميعية من حقائق SysV التي حُسمت بالفعل
        // عند تصنيف المعامل، بلا إعادة استعلام للتخطيط عبر معرف MSIR.
        دع فت: متغير غير_موقع = 0;
        بينما (فت < (الطول(التجميعات_المؤجلة) مثل غير_موقع)) {
            دع مرجع_التجهيز: &تجهيز_معامل_تجميعي_إكس = &التجميعات_المؤجلة[فت];
            دع التجهيز: تجهيز_معامل_تجميعي_إكس = *مرجع_التجهيز;
            دع سجل_القيمة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(التجهيز.المعرف);
            دع حجم_التجميع: غير_موقع = التجهيز.الحجم;
            دع محاذاة_التجميع: غير_موقع = التجهيز.المحاذاة;
            دع هوية_التجميع: غير_موقع = التجهيز.المعرف.القيمة;
            دع حجم_الحجز: غير_موقع = حجم_موضع_تجميعي_واجهة_إكس(حجم_التجميع);
            أضف_طلب_موضع_محلي_إكس(
                &متغير المواضع_المحلية, هوية_التجميع, حجم_الحجز, محاذاة_التجميع
            );
            ألحق(
                تعليمات_المدخل,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                    سجل_القيمة, هوية_التجميع
                )
            );
            دع فج: متغير غير_موقع = 0;
            بينما (فج < (الطول(التجهيز.الأجزاء) مثل غير_موقع)) {
                دع الإزاحة_غير_الموقعة: غير_موقع = فج * 8;
                دع الإزاحة: عدد = الإزاحة_غير_الموقعة مثل عدد;
                دع الأساس: اختيار معرف_سجل_افتراضي = اختيار.بعض(سجل_القيمة);
                دع الفهرس: اختيار معرف_سجل_افتراضي = اختيار.لا_شيء();
                دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                    الأساس: الأساس,
                    الفهرس: الفهرس,
                    المقياس: 1,
                    الإزاحة: الإزاحة
                };
                ألحق(
                    تعليمات_المدخل,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(
                        التجهيز.الأجزاء[فج], العنوان, التجهيز.أحجام_الأجزاء[فج]
                    )
                );
                فج := فج + 1;
            }
            فت := فت + 1;
        }

        دع الكتل: متغير متجه كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العرض.عدد_الكتل) {
            طابق معرف_كتلة_مسير_عند(المسير, المعرف, ف) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                    المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()
                ));
            }
            | اختيار.بعض(معرف_الكتلة) -> {
                دع بادئة: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [];
                طابق العرض.المدخل مع
                | اختيار.بعض(المدخل) -> {
                    لو (كتلتان_مسير_متساويتان(المدخل, معرف_الكتلة)) {
                        بادئة := تعليمات_المدخل;
                    };
                }
                | اختيار.لا_شيء -> { };
                طابق انتق_كتلة_إكس(
                    المسير,
                    حقائق_الخلفية,
                    الهدف,
                    سجل_التخطيط,
                    خطة_الناتج,
                    عنوان_ناتج_غير_مباشر,
                    &بادئة,
                    &متغير المواضع_المحلية,
                    &متغير عدد_السجلات,
                    المعرف,
                    معرف_الكتلة
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الكتلة) -> { ألحق(الكتل, الكتلة); };
            };
            ف := ف + 1;
        }
        دع معرف_الدالة_المنتقاة: معرف_دالة_منتقاة = دالة_إكس_من_مسير(المعرف);
        دع الرأس: رأس_دالة_منتقاة = {
            المعرف: معرف_الدالة_المنتقاة,
            عدد_السجلات_الافتراضية: عدد_السجلات
        };
        دع الدالة: دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
            الرأس: الرأس,
            الكتل: الكتل,
            المواضع_المحلية: المواضع_المحلية
        };
        أرجع نتيجة.نجح(الدالة);
    };
}

عام عرف انتق_مسير_إلى_إكس_ستة_وثمانون_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع الوصف: واصف_هدف = *الهدف;
    طابق الوصف.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> {
        دع السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون = خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.هدف_ليس_إكس_ستة_وثمانون_أربعة_وستون(الوصف.المعرف);
        أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.خطأ(فشل_اختيار_إكس_عام(السبب));
    };

    دع الدوال: متغير متجه دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختيار.لا_شيء -> {
            دع السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون = خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة();
            أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.خطأ(فشل_اختيار_إكس_عام(السبب));
        }
        | اختيار.بعض(المعرف) -> {
            طابق انتق_دالة_إكس(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
            | نتيجة.خطأ(الخطأ) -> {
                طابق الخطأ.السبب مع
                | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> {
                    أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي);
                }
                | _ -> {
                    أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.خطأ(الخطأ);
                };
            }
            | نتيجة.نجح(الدالة) -> {
                ألحق(الدوال, الدالة);
            };
        };
        ف := ف + 1;
    }
    دع الرأس: رأس_برنامج_منتقى = { الهدف: الوصف.المعرف };
    دع الشفرة: شفرة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
        الرأس: الرأس,
        الدوال: الدوال
    };
    أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نجح(الشفرة);
}
