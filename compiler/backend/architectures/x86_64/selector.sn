        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.الأصل) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الأصل) -> {
