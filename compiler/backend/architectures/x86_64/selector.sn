        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الاستخراج.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المصدر) -> {
                طابق جزء_تخطيط_عند_إكس(&تخطيط_المصدر, الاستخراج.الفهرس) مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(الاستخراج.المصدر, الاستخراج.الفهرس)); }
                | اختياري.موجود(الجزء) -> {
                    طابق ألحق_استخراج_قيمة_من_عنوان_إكس(
                        التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                        الناتج, سجل_إكس_لقيمة_مسير(الاستخراج.المصدر), الجزء.الإزاحة,
                        المواضع_المحلية, رمز_نسخ_إكس(حقائق_النسخ, الناتج) == 1
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
    }
    | عملية_مسير.استخراج_فهرس(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
                دع سجل_العنوان: متغير معرف_سجل_افتراضي = سجل_الناتج;
                // An aliased element is its address in the buffer.
                دع مستعار: منطقي = تخطيط_مركب_إكس(&التخطيط) && رمز_نسخ_إكس(حقائق_النسخ, الناتج) == 1;
                إذا (تخطيط_مركب_إكس(&التخطيط) && !مستعار) {
                    دع التالي: طبيعي = *عدد_السجلات;
                    سجل_العنوان := معرف_سجل_افتراضي_من(التالي);
                    *عدد_السجلات := التالي + 1;
                };
                طابق ألحق_عنوان_عنصر_تسلسل_إكس(
                    التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    الاستخراج.المصدر, الاستخراج.الفهرس, &التخطيط, سجل_العنوان
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                إذا (!مستعار) {
                    طابق ألحق_استخراج_قيمة_من_عنوان_إكس(
                        التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                        الناتج, سجل_العنوان, 0, المواضع_المحلية, خطأ
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
    }
    | عملية_مسير.مكان_محلي(_) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(سجل_إكس_لقيمة_مسير(الناتج), الناتج.القيمة));
            };
        };
    }
    | عملية_مسير.مكان_عام(المكان) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            // Verified MSIR global IDs index the canonical global table.
            // Pass its import fact through allocation without a new symbol owner.
            إذا (!عام_مسير_موجود(&(*المسير).المسير, المكان.العام)) {
                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة());
            };
            دع مستورد: متغير منطقي = خطأ;
            طابق (*المسير).المسير.العوام[المكان.العام.القيمة].الاسم_الخارجي مع
            | اختياري.موجود(_) -> { مستورد := صواب; }
            | اختياري.لا_شيء -> { };
            دع الوجهة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
            ألحق_تعليمة_إكس_للاختيار(
                التعليمات,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_عام_إكس(الوجهة, المكان.العام, مستورد)
            );
        };
    }
    | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
        طابق العرض.الناتج مع | اختياري.موجود(الناتج) -> { ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(العملية.المرجع))); } | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
    }
