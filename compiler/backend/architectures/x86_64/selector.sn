            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> { ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(العملية.المؤشر), سجل_إكس_لقيمة_مسير(العملية.الفهرس), التخطيط.الحجم, 0)); }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.تحميل(العملية) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج); دع سجل_المكان: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(العملية.المكان);
                // A load only read before anything may write the place stands
                // for the place itself (msir_analysis.sn رموز_نسخ_قيم_مسير):
                // no copy of the whole value.
                دع مستعار: منطقي = رمز_نسخ_إكس(حقائق_النسخ, الناتج) == 1;
                إذا (تخطيط_مركب_إكس(&التخطيط) && رمز_نسخ_إكس(حقائق_النسخ, الناتج) == 4) {
                    // The value the place's only store stored (code 4).
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(
                        سجل_الناتج, سجل_إكس_لقيمة_مسير(مصدر_نسخ_إكس(حقائق_النسخ, الناتج))));
                } وإلا إذا (تخطيط_مركب_إكس(&التخطيط) && مستعار) {
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_الناتج, سجل_المكان));
                } وإلا إذا (تخطيط_مركب_إكس(&التخطيط)) {
                    أضف_موضع_محلي_إكس(المواضع_المحلية, الناتج.القيمة, &التخطيط);
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(سجل_الناتج, الناتج.القيمة));
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نسخ_ذاكرة_إكس(سجل_الناتج, سجل_المكان, التخطيط.الحجم, 0, 0));
                } وإلا {
                    دع ب: اختياري معرف_سجل_افتراضي = اختياري.موجود(سجل_المكان); دع ف: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
                    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = { الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: 0 };
                    ألحق_تعليمة_إكس_للاختيار(التعليمات,
                        تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
                            سجل_الناتج, ع, التخطيط.الحجم,
                            بإشارة_لقيمة_إكس(المسير, حقائق_الخلفية, الناتج)
                        )
                    );
                };
            };
        };
    }
    | عملية_مسير.تخزين(العملية) -> {
        // Nothing reads a place whose every load stands for this stored
        // aggregate (code 5); a scalar is stored all the same.
        دع غير_مقروء: متغير منطقي = خطأ;
        إذا (رمز_نسخ_إكس(حقائق_النسخ, العملية.المكان) == 5) {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.القيمة) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المخزن) -> { غير_مقروء := تخطيط_مركب_إكس(&تخطيط_المخزن); }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(_) -> { };
        };
        إذا (غير_مقروء) { أرجع اختياري.لا_شيء(); };
        طابق ألحق_تخزين_قيمة_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العملية.القيمة, سجل_إكس_لقيمة_مسير(العملية.المكان), 0) مع
                        | اختياري.موجود(خطأ_التخطيط) -> { أرجع اختياري.موجود(خطأ_التخطيط); }
                        | اختياري.لا_شيء -> { };
    }
    | عملية_مسير.مكان_إلى_مرجع(العملية) -> {
        طابق العرض.الناتج مع | اختياري.موجود(الناتج) -> { ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(العملية.المكان))); } | _ -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
    }
    | عملية_مسير.بناء_موسوم(العملية) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج) مع
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); }
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج, العملية.المنشئ
                    ) مع
                    | نتيجة_تخطيط_منشئ.مكتمل(المنشئ) -> {
                        دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
                        طابق ألحق_مكان_قيمة_مبنية_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المواضع_المحلية, حقائق_النسخ, الناتج, &التخطيط) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> { };
                        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(سجل_الناتج, التعداد.الوسم.الإزاحة, المنشئ.قيمة_الوسم, التعداد.الوسم.الحجم));
                        دع ف: متغير طبيعي = 0;
                        طالما (ف < (الطول(العملية.الحمولات) مثل طبيعي)) {
                            إذا (ف >= (الطول(المنشئ.الحمولات) مثل طبيعي)) {
                                دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مفقودة(الناتج, ف);
                                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                            };
                            دع الإزاحة: طبيعي = التعداد.مخزن_الحمولة.الإزاحة + المنشئ.الحمولات[ف].الإزاحة;
                            إذا (!مبني_في_مالكه_إكس(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, حقائق_النسخ, العملية.الحمولات[ف], الناتج)) {
                                طابق ألحق_تخزين_قيمة_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العملية.الحمولات[ف], سجل_الناتج, الإزاحة) مع
                                | اختياري.موجود(خطأ_التخطيط) -> { أرجع اختياري.موجود(خطأ_التخطيط); }
                                | اختياري.لا_شيء -> { };
                            };
                            ف := ف + 1;
                        }
                    }
                    | نتيجة_تخطيط_منشئ.مؤجل(السبب_المؤجل) -> {
                        دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مؤجلة(الناتج, السبب_المؤجل);
                        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                    }
                    | نتيجة_تخطيط_منشئ.مرفوض(الخطأ) -> {
                        دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مرفوضة(الناتج, الخطأ);
                        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                    };
                }
                | _ -> { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(الناتج)); };
            };
        };
    }
    | عملية_مسير.استعلام_وسم(العملية) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                طابق التخطيط.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    دع سجل_المصدر: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(العملية.المصدر);
                    دع ب: اختياري معرف_سجل_افتراضي = اختياري.موجود(سجل_المصدر);
                    دع ف: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
                    دع إزاحة_الوسم_الموقعة: عدد = التعداد.الوسم.الإزاحة مثل عدد;
                    دع ع: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = { الأساس: ب, الفهرس: ف, المقياس: 1, الإزاحة: إزاحة_الوسم_الموقعة };
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(سجل_إكس_لقيمة_مسير(الناتج), ع, التعداد.الوسم.الحجم, خطأ));
                }
                | _ -> { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(العملية.المصدر)); };
            }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.استخراج_حمولة(العملية) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.المصدر) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المصدر) -> {
                طابق تخطيط_المصدر.التفاصيل مع
                | تفاصيل_تخطيط.تعداد(التعداد) -> {
                    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.المصدر, العملية.المنشئ
                    ) مع
                    | نتيجة_تخطيط_منشئ.مكتمل(المنشئ) -> {
                        إذا (العملية.الحمولة >= (الطول(المنشئ.الحمولات) مثل طبيعي)) {
                            دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مفقودة(العملية.المصدر, العملية.الحمولة);
                            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                        };
                        دع الإزاحة: طبيعي = التعداد.مخزن_الحمولة.الإزاحة + المنشئ.الحمولات[العملية.الحمولة].الإزاحة;
                        طابق ألحق_استخراج_قيمة_من_عنوان_إكس(
                            التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                            الناتج, سجل_إكس_لقيمة_مسير(العملية.المصدر), الإزاحة,
                            المواضع_المحلية, رمز_نسخ_إكس(حقائق_النسخ, الناتج) == 1
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    }
                    | نتيجة_تخطيط_منشئ.مؤجل(السبب_المؤجل) -> {
                        دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مؤجلة(العملية.المصدر, السبب_المؤجل);
                        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                    }
                    | نتيجة_تخطيط_منشئ.مرفوض(الخطأ) -> {
                        دع السبب: سبب_فشل_تخطيط_اختيار_إكس = سبب_فشل_تخطيط_اختيار_إكس.حمولة_منشئ_مرفوضة(العملية.المصدر, الخطأ);
                        أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(السبب));
                    };
                }
                | _ -> { أرجع اختياري.موجود(خطأ_بنية_تخطيط_إكس(العملية.المصدر)); };
            }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.بناء_إغلاق(البناء) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع عرض_الهدف: عرض_دالة_مسير;
            طابق ابحث_دالة_مسير(المسير, البناء.الدالة) مع
            | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_بحث_دالة_مسير.موجودة(الدالة) -> { عرض_الهدف := الدالة; };
            دع خطة_البيئة: تخطيط_بيئة_إغلاق_اختيار;
            طابق خطط_بيئة_إغلاق_للاختيار(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                عرض_الهدف.المعرف, عرض_الهدف.عدد_الالتقاطات
            ) مع
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مؤجل -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(الخطة) -> { خطة_البيئة := الخطة; };
            دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_صندوق_إكس(
                سجل_الناتج, خطة_البيئة.الحجم, خطة_البيئة.المحاذاة
            ));
            دع التالي: طبيعي = *عدد_السجلات;
            دع سجل_الدالة: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(التالي);
            *عدد_السجلات := التالي + 1;
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(
                سجل_الدالة, دالة_إكس_من_مسير(البناء.الدالة)
            ));
            دع ب: اختياري معرف_سجل_افتراضي = اختياري.موجود(سجل_الناتج);
            دع فهرس_فارغ: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
            دع عنوان_الدالة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                الأساس: ب, الفهرس: فهرس_فارغ, المقياس: 1, الإزاحة: 0
            };
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(
                سجل_الدالة, عنوان_الدالة, 8
            ));
            // The environment header: one reference, and the destructor.
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_فوري_ذاكرة_إكس(
                سجل_الناتج, إزاحة_عداد_بيئة_إغلاق(), 1, 8
            ));
            طابق البناء.المدمر مع
            | اختياري.موجود(المدمر) -> {
                دع سجل_المدمر: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
                *عدد_السجلات := *عدد_السجلات + 1;
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(
                    سجل_المدمر, دالة_إكس_من_مسير(المدمر)
                ));
                دع عنوان_المدمر: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                    الأساس: ب, الفهرس: فهرس_فارغ, المقياس: 1,
                    الإزاحة: إزاحة_مدمر_بيئة_إغلاق() مثل عدد
                };
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(
                    سجل_المدمر, عنوان_المدمر, 8
                ));
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة());
            };
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(البناء.الالتقاطات) مثل طبيعي)) {
                طابق ألحق_تخزين_قيمة_إكس(
                    التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                    البناء.الالتقاطات[ف], سجل_الناتج,
                    خطة_البيئة.إزاحات_الالتقاطات[ف]
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
        };
    }
    | عملية_مسير.استخراج_التقاط(الاستخراج) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            دع عرض_الحالية: عرض_دالة_مسير;
            طابق ابحث_دالة_مسير(المسير, الناتج.الدالة) مع
            | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_بحث_دالة_مسير.موجودة(الدالة) -> { عرض_الحالية := الدالة; };
            دع خطة_البيئة: تخطيط_بيئة_إغلاق_اختيار;
            طابق خطط_بيئة_إغلاق_للاختيار(
                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط,
                عرض_الحالية.المعرف, عرض_الحالية.عدد_الالتقاطات
            ) مع
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مؤجل -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()); }
            | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(الخطة) -> { خطة_البيئة := الخطة; };
            إذا (الاستخراج.الفهرس >= (الطول(خطة_البيئة.إزاحات_الالتقاطات) مثل طبيعي)) {
                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة());
            };
            دع التالي: طبيعي = *عدد_السجلات;
            دع سجل_البيئة: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(التالي);
            *عدد_السجلات := التالي + 1;
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.بيئة_إغلاق_إكس(سجل_البيئة));
            طابق ألحق_استخراج_قيمة_من_عنوان_إكس(
                التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
                الناتج, سجل_البيئة, خطة_البيئة.إزاحات_الالتقاطات[الاستخراج.الفهرس],
                المواضع_المحلية, خطأ
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | عملية_مسير.بناء_صندوق(العملية) -> {
        طابق العرض.الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
        | اختياري.موجود(الناتج) -> {
            طابق تخطيط_قيمة_مسير_للاختيار(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, العملية.القيمة) مع
            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(التخطيط) -> {
                دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الناتج);
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_صندوق_إكس(سجل_الناتج, التخطيط.الحجم, التخطيط.المحاذاة));
                طابق ألحق_تخزين_قيمة_إكس(التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, العملية.القيمة, سجل_الناتج, 0) مع
                        | اختياري.موجود(خطأ_التخطيط) -> { أرجع اختياري.موجود(خطأ_التخطيط); }
                        | اختياري.لا_شيء -> { };
            }
            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> { أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط)); };
        };
    }
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
            طابق البدائي مع
            | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                إذا ((!هدف_نواة_لينكس_مباشر(الهدف) && !هدف_نواة_فري_بي_إس_دي_مباشر(الهدف))
                    || (*الهدف).نموذج_البيانات.عرض_المؤشر != 64
                    || (الطول(النداء.الحجج) مثل طبيعي) != 7) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
                | اختياري.موجود(_) -> { };
                طابق حل_واجهة_نداء_قيم_مسير_للهدف(
                    حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &النداء.الحجج, العرض.الناتج
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ));
                }
                | نتيجة.نجح(خطة_النواة) -> {
                    دع هدف_النواة: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون =
                        هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.نداء_نواة();
                    طابق ألحق_نداء_إكس_بخطة(
                        التعليمات, المواضع_المحلية, عدد_السجلات, &(*حقائق_النسخ).الثابتة, هدف_النواة,
                        &النداء.الحجج, العرض.الناتج, &خطة_النواة
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            }
            | هوية_بدائي_مترجم.معمارية_المضيف -> {
                طابق ألحق_بدائي_هوية_مضيف_إكس(الهدف, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            }
            | هوية_بدائي_مترجم.منصة_المضيف -> {
                طابق ألحق_بدائي_هوية_مضيف_إكس(الهدف, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            }
            | هوية_بدائي_مترجم.بيئة_المضيف -> {
                طابق ألحق_بدائي_هوية_مضيف_إكس(الهدف, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            }
            | هوية_بدائي_مترجم.بتات_ع64 -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
                طابق العرض.الناتج مع
                | اختياري.موجود(الناتج) -> { ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(النداء.الحجج[0]))); }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
            }
            | هوية_بدائي_مترجم.ع64_من_بتات -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
                طابق العرض.الناتج مع
                | اختياري.موجود(الناتج) -> { ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(النداء.الحجج[0]))); }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
            }
            | هوية_بدائي_مترجم.بتات_ع32 -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
                طابق العرض.الناتج مع
                | اختياري.موجود(الناتج) -> { ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(النداء.الحجج[0]))); }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
            }
            | هوية_بدائي_مترجم.ع32_من_بتات -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
                طابق العرض.الناتج مع
                | اختياري.موجود(الناتج) -> { ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_إكس_لقيمة_مسير(الناتج), سجل_إكس_لقيمة_مسير(النداء.الحجج[0]))); }
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); };
            }
            // Float primitives baseline x86-64 has (encoder.sn ألحق_عملية_عائمة_خاصة_إكس).
            | هوية_بدائي_مترجم.عملية_عائمة(العملية_العائمة) -> {
                دع عملية_إكس: متغير حساب_عشري_إكس_كامل = حساب_عشري_إكس_كامل.جذر_تربيعي();
                دع مدعومة: متغير منطقي = صواب;
                طابق العملية_العائمة مع
                | عملية_عائمة_بدائية.جذر_تربيعي -> { عملية_إكس := حساب_عشري_إكس_كامل.جذر_تربيعي(); }
                | عملية_عائمة_بدائية.قيمة_مطلقة -> { عملية_إكس := حساب_عشري_إكس_كامل.قيمة_مطلقة(); }
                | عملية_عائمة_بدائية.نسخ_إشارة -> { عملية_إكس := حساب_عشري_إكس_كامل.نسخ_إشارة(); }
                | عملية_عائمة_بدائية.أدنى -> { عملية_إكس := حساب_عشري_إكس_كامل.أدنى(); }
                | عملية_عائمة_بدائية.أقصى -> { عملية_إكس := حساب_عشري_إكس_كامل.أقصى(); }
                | _ -> { مدعومة := خطأ; };
                إذا (!مدعومة || (الطول(النداء.الحجج) مثل طبيعي) != عدد_معاملات_عملية_عائمة(العملية_العائمة)) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
                | اختياري.موجود(الناتج) -> {
                    دع البتات: طبيعي;
                    طابق بتات_قيمة_عائمة_إكس(المسير, حقائق_الخلفية, الناتج) مع
                    | اختياري.موجود(ب) -> { البتات := ب; }
                    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي)); };
                    دع الثاني: متغير معرف_قيمة_مسير = النداء.الحجج[0];
                    إذا ((الطول(النداء.الحجج) مثل طبيعي) > 1) { الثاني := النداء.الحجج[1]; };
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_عشري_إكس(
                        عملية_إكس, سجل_إكس_لقيمة_مسير(الناتج),
                        سجل_إكس_لقيمة_مسير(النداء.الحجج[0]), سجل_إكس_لقيمة_مسير(الثاني), البتات
                    ));
                };
            }
            // WebAssembly-only linear-memory primitives have no lowering here.
            | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
            }
            | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
            }
            | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
            }
            | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
            }
            | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
                أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
            }
            // Flat machine memory: one 8-byte MOV from/to [address].
            | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1 || (*الهدف).نموذج_البيانات.عرض_المؤشر != 64) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود()); }
                | اختياري.موجود(الناتج) -> {
                    دع عنوان_الآلة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                        الأساس: اختياري.موجود(سجل_إكس_لقيمة_مسير(النداء.الحجج[0])),
                        الفهرس: اختياري.لا_شيء(), المقياس: 1, الإزاحة: 0
                    };
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
                        سجل_إكس_لقيمة_مسير(الناتج), عنوان_الآلة, 8, خطأ
                    ));
                };
            }
            | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 2 || (*الهدف).نموذج_البيانات.عرض_المؤشر != 64) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                دع عنوان_الآلة: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                    الأساس: اختياري.موجود(سجل_إكس_لقيمة_مسير(النداء.الحجج[0])),
                    الفهرس: اختياري.لا_شيء(), المقياس: 1, الإزاحة: 0
                };
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(
                    سجل_إكس_لقيمة_مسير(النداء.الحجج[1]), عنوان_الآلة, 8
                ));
            }
            | هوية_بدائي_مترجم.طول -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود());
                }
                | اختياري.موجود(الناتج) -> {
                    طابق تخطيط_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, النداء.الحجج[0]
                    ) مع
                    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
                    }
                    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الحجة) -> {
                        طابق جزء_تخطيط_عند_إكس(&تخطيط_الحجة, 1) مع
                        | اختياري.لا_شيء -> {
                            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم());
                        }
                        | اختياري.موجود(جزء_الطول) -> {
                            طابق تخطيط_قيمة_مسير_للاختيار(
                                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج
                            ) مع
                            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                                أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
                            }
                            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الناتج) -> {
                                دع الأساس: اختياري معرف_سجل_افتراضي =
                                    اختياري.موجود(سجل_إكس_لقيمة_مسير(النداء.الحجج[0]));
                                دع الفهرس: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
                                دع إزاحة_الطول: عدد = جزء_الطول.الإزاحة مثل عدد;
                                دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                                    الأساس: الأساس,
                                    الفهرس: الفهرس,
                                    المقياس: 1,
                                    الإزاحة: إزاحة_الطول
                                };
                                ألحق_تعليمة_إكس_للاختيار(التعليمات,
                                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
                                        سجل_إكس_لقيمة_مسير(الناتج),
                                        العنوان,
                                        تخطيط_الناتج.الحجم,
                                        خطأ
                                    )
                                );
                            };
                        };
                    };
                };
            }
            | هوية_بدائي_مترجم.سعة_متجه -> {
                // The header capacity word, read as length reads its word.
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود());
                }
                | اختياري.موجود(الناتج) -> {
                    طابق تخطيط_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, النداء.الحجج[0]
                    ) مع
                    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
                    }
                    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الحجة) -> {
                        طابق جزء_تخطيط_عند_إكس(&تخطيط_الحجة, 2) مع
                        | اختياري.لا_شيء -> {
                            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم());
                        }
                        | اختياري.موجود(جزء_الطول) -> {
                            طابق تخطيط_قيمة_مسير_للاختيار(
                                حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, الناتج
                            ) مع
                            | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                                أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
                            }
                            | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_الناتج) -> {
                                دع الأساس: اختياري معرف_سجل_افتراضي =
                                    اختياري.موجود(سجل_إكس_لقيمة_مسير(النداء.الحجج[0]));
                                دع الفهرس: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
                                دع إزاحة_الطول: عدد = جزء_الطول.الإزاحة مثل عدد;
                                دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                                    الأساس: الأساس,
                                    الفهرس: الفهرس,
                                    المقياس: 1,
                                    الإزاحة: إزاحة_الطول
                                };
                                ألحق_تعليمة_إكس_للاختيار(التعليمات,
                                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(
                                        سجل_إكس_لقيمة_مسير(الناتج),
                                        العنوان,
                                        تخطيط_الناتج.الحجم,
                                        خطأ
                                    )
                                );
                            };
                        };
                    };
                };
            }
            | هوية_بدائي_مترجم.ضبط_طول_متجه -> {
                // The vector's place holds its header: store the new length
                // into the header's length word (pop and truncate glue).
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 2) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق النداء.مكان_التعديل مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.موجود(مكان_المتجه) -> {
                    طابق تخطيط_قيمة_مسير_للاختيار(
                        حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, مكان_المتجه
                    ) مع
                    | نتيجة_تخطيط_قيمة_للاختيار.أخفق(فشل_التخطيط) -> {
                        أرجع اختياري.موجود(خطأ_استعلام_تخطيط_إكس(فشل_التخطيط));
                    }
                    | نتيجة_تخطيط_قيمة_للاختيار.مكتمل(تخطيط_المتجه) -> {
                        طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 1) مع
                        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(مكان_المتجه, 1)); }
                        | اختياري.موجود(جزء_الطول) -> {
                            طابق جزء_تخطيط_عند_إكس(&تخطيط_المتجه, 2) مع
                            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_جزء_تخطيط_إكس(مكان_المتجه, 2)); }
                            | اختياري.موجود(جزء_السعة) -> {
                                دع حجم_الطول: طبيعي = جزء_السعة.الإزاحة - جزء_الطول.الإزاحة;
                                دع عنوان_الطول: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                                    الأساس: اختياري.موجود(سجل_إكس_لقيمة_مسير(مكان_المتجه)),
                                    الفهرس: اختياري.لا_شيء(), المقياس: 1,
                                    الإزاحة: جزء_الطول.الإزاحة مثل عدد
                                };
                                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(
                                    سجل_إكس_لقيمة_مسير(النداء.الحجج[1]), عنوان_الطول, حجم_الطول
                                ));
                            };
                        };
                    };
                };
            }
            | هوية_بدائي_مترجم.إلحاق -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 2) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق العرض.الناتج مع
                | اختياري.موجود(_) -> {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.لا_شيء -> { };
                دع العنصر: معرف_قيمة_مسير = النداء.الحجج[1];
                طابق النداء.مكان_التعديل مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.موجود(مكان_المتجه) -> {
                    طابق ألحق_إلحاق_متجه_إكس(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, مكان_المتجه, العنصر, التعليمات, خطأ
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            }
            | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> {
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 4) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق النداء.مكان_التعديل مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.موجود(مكان_المتجه) -> {
                    طابق ألحق_امتداد_متجه_إكس(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, مكان_المتجه,
                        النداء.الحجج[1], النداء.الحجج[2], النداء.الحجج[3], التعليمات
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            }
            | هوية_بدائي_مترجم.حجز_سعة_متجه -> {
                // The append instruction in reserve form: the same registers,
                // stack slots and realloc call (encoder.sn).
                إذا ((الطول(النداء.الحجج) مثل طبيعي) != 2) {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                };
                طابق النداء.مكان_التعديل مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي));
                }
                | اختياري.موجود(مكان_المتجه) -> {
                    طابق ألحق_إلحاق_متجه_إكس(
                        المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, مكان_المتجه, النداء.الحجج[1], التعليمات, صواب
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            }
            // Thread support: atomics, leaked boxes and closure addresses
            // (the same machine word), and the Linux thread clone.
            | هوية_بدائي_مترجم.ذري_حمل -> { أرجع ألحق_بدائي_ذري_إكس(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_خزن -> { أرجع ألحق_بدائي_ذري_إكس(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_تبديل -> { أرجع ألحق_بدائي_ذري_إكس(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { أرجع ألحق_بدائي_ذري_إكس(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_جلب_جمع -> { أرجع ألحق_بدائي_ذري_إكس(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
            | هوية_بدائي_مترجم.ذري_جلب_و -> { أرجع ألحق_بدائي_ذري_إكس(حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, البدائي, &النداء.الحجج, العرض.الناتج, التعليمات); }
