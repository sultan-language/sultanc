                    دع ف: متغير طبيعي = 0;
                    طالما (ف < (الطول(النداء.الحجج) مثل طبيعي)) {
                        إذا (ف >= (الطول(الخطة.المعاملات) مثل طبيعي)) {
                            أرجع اختياري.موجود(
                                خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم()
                            );
                        };
                        دع مرجع_خطة_المعامل: &خطة_معامل_واجهة = &الخطة.المعاملات[ف];
                        دع خطة_المعامل: خطة_معامل_واجهة = *مرجع_خطة_المعامل;
                        طابق خطة_المعامل.الموقع مع
                        | موقع_تمرير_واجهة.متجاهل -> { }
                        | _ -> {
                            دع الحجة: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = حجة_نداء_إكس(
                                التعليمات, المواضع_المحلية, عدد_السجلات, &(*حقائق_النسخ).الثابتة,
                                النداء.الحجج[ف], مرجع_خطة_المعامل
                            );
                            ألحق(الحجج, الحجة);
                        };
                        ف := ف + 1;
                    }
                    دع الناتج: متغير اختياري قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = اختياري.لا_شيء();
                    طابق العرض.الناتج مع
                    | اختياري.لا_شيء -> {
                        طابق الخطة.الناتج.الموقع مع
                        | موقع_تمرير_واجهة.متجاهل -> { }
                        | _ -> {
                            أرجع اختياري.موجود(
                                خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم()
                            );
                        };
                    }
                    | اختياري.موجود(معرف_الناتج) -> {
                        طابق الخطة.الناتج.الموقع مع
                        | موقع_تمرير_واجهة.متجاهل -> { }
                        | _ -> {
                            دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(معرف_الناتج);
                            دع قيمة_الناتج: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                                سجل_الناتج, &الخطة.الناتج.التصنيف, &الخطة.الناتج.الموقع
                            );
                            دع عنوان_البناء: اختياري معرف_سجل_افتراضي = عنوان_ناتج_للبناء_إكس(حقائق_النسخ, معرف_الناتج);
                            إذا (قيمة_الناتج.تجميعي && رمز_نسخ_إكس(حقائق_النسخ, معرف_الناتج) == 3) {
                                // The callee returns into the storage of the value built from this one.
                                طابق ألحق_عنوان_تخزين_مبني_إكس(
                                    التعليمات, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, حقائق_النسخ,
                                    سجل_الناتج, معرف_الناتج, 0
                                ) مع
                                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                                | اختياري.لا_شيء -> { };
                            } وإلا إذا (قيمة_الناتج.تجميعي && قيمة_الناتج.غير_مباشر && مبني_في_الناتج_إكس(حقائق_النسخ, معرف_الناتج)) {
                                // The callee returns straight into this function's result storage.
                                طابق عنوان_البناء مع
                                | اختياري.موجود(العنوان) -> {
                                    ألحق_تعليمة_إكس_للاختيار(التعليمات,
                                        تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(سجل_الناتج, العنوان));
                                }
                                | اختياري.لا_شيء -> { };
                            } وإلا إذا (قيمة_الناتج.تجميعي) {
                                دع حجم_التجميع: طبيعي = الخطة.الناتج.التصنيف.الحجم;
                                دع محاذاة_التجميع: طبيعي = الخطة.الناتج.التصنيف.المحاذاة;
                                دع هوية_التجميع: طبيعي = معرف_الناتج.القيمة;
                                دع حجم_الحجز: طبيعي = حجم_موضع_تجميعي_واجهة_إكس(حجم_التجميع);
                                أضف_طلب_موضع_محلي_إكس(
                                    المواضع_المحلية, هوية_التجميع, حجم_الحجز, محاذاة_التجميع
                                );
                                ألحق_تعليمة_إكس_للاختيار(التعليمات,
                                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                                        سجل_الناتج, هوية_التجميع
                                    )
                                );
                            };
                            الناتج := اختياري.موجود(قيمة_الناتج);
                        };
                    };
                    دع دالة_النداء: معرف_دالة_منتقاة = دالة_إكس_من_مسير(معرف_الدالة);
                    دع هدف_النداء: هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون =
                        هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة(دالة_النداء);
                    دع الخطة_المنتقاة: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = {
                        الهدف: هدف_النداء,
                        الحجج: الحجج,
                        الناتج: الناتج,
                        متغيرة: خطأ
                    };
                    ألحق_تعليمة_إكس_للاختيار(التعليمات,
                        تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(الخطة_المنتقاة)
                    );
                };
            };
        };
    }
    أرجع اختياري.لا_شيء();
}

عرف انتق_منهي_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    خطة_الناتج: &اختياري خطة_ناتج_واجهة,
    عنوان_ناتج_غير_مباشر: اختياري معرف_سجل_افتراضي,
    حقائق_النسخ: &حقائق_نسخ_إكس,
    المنهي: &منهي_مسير,
    المقارنة_المؤجلة: اختياري مقارنة_إكس_مؤجلة,
    عدد_السجلات: &متغير طبيعي,
    التعليمات: &متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    الخلفاء: &متغير متجه معرف_كتلة_منتقاة
): اختياري خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        طابق حزمة_نقل_حافة_إكس(المسير, &الحافة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(الحزمة) -> {
            دع هدف_الحافة: معرف_كتلة_منتقاة = الحزمة.الهدف;
            ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(الحزمة));
            ألحق_خلفا_إكس_للاختيار(الخلفاء, هدف_الحافة);
        };
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        طابق حزمة_نقل_حافة_إكس(المسير, &عند_الصواب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(حزمة_الصواب) -> {
            طابق حزمة_نقل_حافة_إكس(المسير, &عند_الخطأ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة.نجح(حزمة_الخطأ) -> {
                ألحق_تعليمة_إكس_للاختيار(التعليمات,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(
                        سجل_إكس_لقيمة_مسير(الشرط), حزمة_الصواب
                    )
                );
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(حزمة_الخطأ));
                ألحق_خلفا_إكس_للاختيار(الخلفاء, كتلة_إكس_من_مسير(عند_الصواب.الهدف));
                ألحق_خلفا_إكس_للاختيار(الخلفاء, كتلة_إكس_من_مسير(عند_الخطأ.الهدف));
            };
        };
    }
    | منهي_مسير.فرع_متعدد(الفرع) -> {
        دع عرض_المميز: طبيعي;
        طابق بتات_قيمة_عدد_إكس(المسير, حقائق_الخلفية, الفرع.المميز) مع
        | اختياري.موجود(البتات) -> { عرض_المميز := البتات; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم()); };
        إذا (!عرض_عدد_إكس_مدعوم(عرض_المميز)) {
            أرجع اختياري.موجود(خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم());
        };
        دع سجل_المميز: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(الفرع.المميز);
        // Jump table when the shared policy accepts the switch
        // (selection_contract.sn, خطط_جدول_قفز_لفرع_متعدد).
        دع مميز_ط32_طبيعي: متغير منطقي = خطأ;
        إذا (عرض_المميز == 32) {
            طابق نوع_قيمة_مسير(المسير, الفرع.المميز) مع
            | اختياري.موجود(نوع_المميز) -> {
                دع حقائق_المميز: سياق_استعلام_اختيار_خلفية = *حقائق_الخلفية;
                طابق صنف_إشارة_عدد_للاختيار(&حقائق_المميز.الأنواع, نوع_المميز) مع
                | اختياري.موجود(صنف_إشارة_عدد_خلفية.طبيعي) -> { مميز_ط32_طبيعي := صواب; }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
        };
        طابق خطط_جدول_قفز_لفرع_متعدد(&الفرع, مميز_ط32_طبيعي) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(خطة_الجدول) -> {
            دع الهدف_الافتراضي: معرف_كتلة_منتقاة = كتلة_إكس_من_مسير(الفرع.الافتراضي.الهدف);
            دع الأهداف: متغير متجه معرف_كتلة_منتقاة = [];
            دع موضع: متغير طبيعي = 0;
            طالما (موضع < (الطول(خطة_الجدول.الأهداف) مثل طبيعي)) {
                ألحق(الأهداف, كتلة_إكس_من_مسير(خطة_الجدول.الأهداف[موضع]));
                موضع := موضع + 1;
            }
            ألحق_تعليمة_إكس_للاختيار(التعليمات,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_جدولي_إكس(
                    سجل_المميز, الأهداف, الهدف_الافتراضي, خطة_الجدول.الأدنى
                ));
            دع حالة_الخلفاء: متغير طبيعي = 0;
            طالما (حالة_الخلفاء < (الطول(الفرع.الحالات) مثل طبيعي)) {
                ألحق_خلفا_إكس_للاختيار(الخلفاء, كتلة_إكس_من_مسير(الفرع.الحالات[حالة_الخلفاء].الحافة.الهدف));
                حالة_الخلفاء := حالة_الخلفاء + 1;
            }
            ألحق_خلفا_إكس_للاختيار(الخلفاء, الهدف_الافتراضي);
            أرجع اختياري.لا_شيء();
        };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
            دع الحالة: &حالة_فرع_متعدد_مسير = &الفرع.الحالات[ف];
            دع سجل_الوسم: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات);
            دع سجل_المساواة: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(*عدد_السجلات + 1);
            *عدد_السجلات := *عدد_السجلات + 2;
            ألحق_تعليمة_إكس_للاختيار(التعليمات,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(سجل_الوسم, (*الحالة).الوسم & قناع_عرض_عدد_إكس(عرض_المميز)));
            ألحق_تعليمة_إكس_للاختيار(التعليمات,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(
                    سجل_المساواة, سجل_المميز, سجل_الوسم,
                    شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ(), عرض_المميز
                ));
            طابق حزمة_نقل_حافة_إكس(المسير, &(*الحالة).الحافة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة.نجح(الحزمة) -> {
                ألحق_تعليمة_إكس_للاختيار(التعليمات,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(سجل_المساواة, الحزمة));
                ألحق_خلفا_إكس_للاختيار(الخلفاء, كتلة_إكس_من_مسير((*الحالة).الحافة.الهدف));
            };
            ف := ف + 1;
        }
        طابق حزمة_نقل_حافة_إكس(المسير, &الفرع.الافتراضي) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(الحزمة) -> {
            ألحق_تعليمة_إكس_للاختيار(التعليمات,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(الحزمة));
            ألحق_خلفا_إكس_للاختيار(الخلفاء, كتلة_إكس_من_مسير(الفرع.الافتراضي.الهدف));
        };
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        طابق القيمة مع
        | اختياري.لا_شيء -> {
            طابق *خطة_الناتج مع
            | اختياري.موجود(الخطة) -> {
                طابق الخطة.الموقع مع
                | موقع_تمرير_واجهة.متجاهل -> {
                    ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس());
                }
                | _ -> {
                    أرجع اختياري.موجود(
                        خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                    );
                };
            }
            | اختياري.لا_شيء -> {
                ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس());
            };
        }
        | اختياري.موجود(المعرف) -> {
            طابق *خطة_الناتج مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(
                    خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                );
            }
            | اختياري.موجود(الخطة) -> {
                طابق الخطة.الموقع مع
                | موقع_تمرير_واجهة.متجاهل -> {
                    أرجع اختياري.موجود(
                        خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                    );
                }
                | _ -> {
                    دع سجل_الناتج: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المعرف);
                    دع قيمة_الناتج: متغير قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                        سجل_الناتج, &الخطة.التصنيف, &الخطة.الموقع
                    );
                    إذا (قيمة_الناتج.تجميعي && قيمة_الناتج.غير_مباشر
                        && مبني_في_الناتج_إكس(حقائق_النسخ, المعرف)) {
                        // Built in the result storage already: nothing to copy.
                        قيمة_الناتج.الحجم := 0;
                    };
                    دع الناتج: ناتج_عودة_إكس_ستة_وثمانون_أربعة_وستون_منتقى = {
                        القيمة: قيمة_الناتج,
                        عنوان_ناتج_غير_مباشر: عنوان_ناتج_غير_مباشر
                    };
                    ألحق_تعليمة_إكس_للاختيار(التعليمات,
                        تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس_بقيمة(الناتج)
                    );
                };
            };
        };
    }
    | منهي_مسير.فخ -> {
        ألحق_تعليمة_إكس_للاختيار(التعليمات, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.فخ_إكس());
    };
    أرجع اختياري.لا_شيء();
}

عرف انتق_كتلة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    خطة_الناتج: &اختياري خطة_ناتج_واجهة,
    عنوان_ناتج_غير_مباشر: اختياري معرف_سجل_افتراضي,
    تعليمات_المدخل: متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المواضع_المحلية: &متغير متجه طلب_موضع_محلي_إكس,
    عدد_السجلات: &متغير طبيعي,
    الدالة: معرف_دالة_مسير,
    المعرف: معرف_كتلة_مسير,
    حقائق_النسخ: &حقائق_نسخ_إكس
): نتيجة كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة, فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    طابق ابحث_كتلة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(المفقود) -> {
        أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_كتلة(
            الدالة, المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.كتلة_مسير_مفقودة(المفقود)
        ));
    }
    | نتيجة_بحث_كتلة_مسير.موجودة(العرض) -> {
        دع التعليمات: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = تعليمات_المدخل;
        دع أصول_التعليمات: متغير متجه مدى_أصل_تعليمات = [];
        دع الخلفاء: متغير متجه معرف_كتلة_منتقاة = [];
        دع المقارنة_المؤجلة: متغير اختياري مقارنة_إكس_مؤجلة = اختياري.لا_شيء();
        دع ف: متغير طبيعي = 0;
        طالما (ف < العرض.عدد_التعليمات) {
            طابق تعليمة_مسير_عند(المسير, المعرف, ف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_كتلة(
                    الدالة, المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()
                ));
            }
            | اختياري.موجود(التعليمة) -> {
                دع بداية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
                دع فئة_العملية: فئة_عملية_اختيار_إكس = فئة_عملية_اختيار_إكس_من(&التعليمة.العملية);
                دع آخر_تعليمة: منطقي = ف + 1 == العرض.عدد_التعليمات;
                طابق انتق_تعليمة_إكس(
                    المسير,
                    حقائق_الخلفية,
                    الهدف,
                    سجل_التخطيط,
                    &التعليمة,
                    آخر_تعليمة,
                    &متغير التعليمات,
                    &متغير المقارنة_المؤجلة,
                    المواضع_المحلية,
                    عدد_السجلات,
                    حقائق_النسخ
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_تعليمة(
                        الدالة, المعرف, ف, فئة_العملية, الخطأ
                    ));
                }
                | اختياري.لا_شيء -> { };
                دع نهاية_الأصل: طبيعي = الطول(التعليمات) مثل طبيعي;
                إذا (نهاية_الأصل > بداية_الأصل) {
                    طابق التعليمة.الأصل مع
                    | اختياري.موجود(الأصل) -> {
                        دع المدى: مدى_أصل_تعليمات = {
                            البداية: بداية_الأصل,
                            النهاية: نهاية_الأصل,
                            الأصل: الأصل,
                            موقع_التصحيح: التعليمة.موقع_التصحيح,
                            نطاق_التصحيح: التعليمة.نطاق_التصحيح
                        };
                        ألحق(أصول_التعليمات, المدى);
                    }
                    | اختياري.لا_شيء -> { };
                };
            };
            ف := ف + 1;
        }
        طابق منهي_كتلة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_منهي_مسير.موجود(المنهي) -> {
            طابق انتق_منهي_إكس(
                المسير,
                حقائق_الخلفية,
                خطة_الناتج,
                عنوان_ناتج_غير_مباشر,
                حقائق_النسخ,
                &المنهي,
                المقارنة_المؤجلة,
                عدد_السجلات,
                &متغير التعليمات,
                &متغير الخلفاء
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_كتلة(الدالة, المعرف, الخطأ));
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> {
            أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_كتلة(
                الدالة, المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.منهي_غير_مدعوم()
            ));
        };
        دع معرف_الكتلة_المنتقاة: معرف_كتلة_منتقاة = كتلة_إكس_من_مسير(المعرف);
        دع الرأس: رأس_كتلة_منتقاة = {
            المعرف: معرف_الكتلة_المنتقاة,
            الخلفاء: الخلفاء
        };
        دع الكتلة: كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
            الرأس: الرأس,
            التعليمات: التعليمات,
            أصول_التعليمات: أصول_التعليمات
        };
        أرجع نتيجة.نجح(الكتلة);
    };
}

عام عرف انتق_دالة_إكس(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_دالة_مسير
): نتيجة دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة, فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع عدد_السجلات: متغير طبيعي = 0;
    طابق عدد_سجلات_افتراضية_لمعرف_دالة_مسير(المسير, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
            المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.دالة_مسير_مفقودة(المعرف)
        ));
    }
    | اختياري.موجود(العدد) -> { عدد_السجلات := العدد; };

    طابق ابحث_دالة_مسير(المسير, المعرف) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(المفقود) -> {
        أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
            المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.دالة_مسير_مفقودة(المفقود)
        ));
    }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
        دع خطة_الواجهة: متغير خطة_دالة_واجهة;
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(
            حقائق_الخلفية, المسير, الهدف, سجل_التخطيط, &العرض
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ)
            ));
        }
        | نتيجة.نجح(الخطة) -> { خطة_الواجهة := الخطة; };

        دع مرجع_خطة_الناتج: &خطة_ناتج_واجهة = &خطة_الواجهة.الناتج;
        دع خطة_الناتج: اختياري خطة_ناتج_واجهة = اختياري.موجود(انسخ_مملوكا_خطة_ناتج_واجهة(مرجع_خطة_الناتج));
        دع عنوان_ناتج_غير_مباشر: متغير اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
        دع تعليمات_المدخل: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [];
        دع المواضع_المحلية: متغير متجه طلب_موضع_محلي_إكس = [];

        // التقط حامل النتيجة غير المباشرة أولا، ثم انقله إلى سجل عادي بعد التقاط كل حوامل ABI.
        دع حامل_ناتج_غير_مباشر: متغير اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
        طابق خطة_الواجهة.الناتج.الموقع مع
        | موقع_تمرير_واجهة.غير_مباشر(موضع_العنوان) -> {
            دع حامل: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
            دع محفوظ: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات + 1);
            عدد_السجلات := عدد_السجلات + 2;
            دع المواضع: متغير متجه موضع_جزء_واجهة = [];
            ألحق(المواضع, موضع_العنوان);
            دع قيمة_الحامل: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
                السجل: حامل,
                المواضع: المواضع,
                الحجم: 8,
                تجميعي: خطأ,
                غير_مباشر: خطأ
            };
            ألحق(
                تعليمات_المدخل,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(قيمة_الحامل)
            );
            حامل_ناتج_غير_مباشر := اختياري.موجود(حامل);
            عنوان_ناتج_غير_مباشر := اختياري.موجود(محفوظ);
        }
        | _ -> { };

        // التقط أجزاء التجميع في سجلات مؤقتة قبل بناء التخزين المحلي.
        دع التجميعات_المؤجلة: متغير متجه تجهيز_معامل_تجميعي_إكس = [];
        دع النقلات_المؤجلة: متغير متجه تجهيز_معامل_مفرد_إكس = [];
        دع ف_المعامل: متغير طبيعي = 0;
        طالما (ف_المعامل < العرض.عدد_المعاملات) {
            إذا (ف_المعامل >= (الطول(خطة_الواجهة.المعاملات) مثل طبيعي)) {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                    المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                ));
            };
            طابق معامل_دالة_مسير_عند(المسير, المعرف, ف_المعامل) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                    المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                ));
            }
            | اختياري.موجود(المعامل) -> {
                دع مرجع_خطة_المعامل: &خطة_معامل_واجهة = &خطة_الواجهة.المعاملات[ف_المعامل];
                دع خطة_المعامل: خطة_معامل_واجهة = *مرجع_خطة_المعامل;
                طابق خطة_المعامل.الموقع مع
                | موقع_تمرير_واجهة.متجاهل -> { }
                | _ -> {
                    دع سجل_المعامل: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(المعامل.المعرف);
                    دع قيمة_الواجهة: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                        سجل_المعامل, &خطة_المعامل.التصنيف, &خطة_المعامل.الموقع
                    );
                    إذا (قيمة_الواجهة.تجميعي && !قيمة_الواجهة.غير_مباشر) {
                        دع الأجزاء: متغير متجه معرف_سجل_افتراضي = [];
                        دع أحجام_الأجزاء: متغير متجه طبيعي = [];
                        دع أجزاء_المكدس: متغير متجه اختياري موضع_جزء_واجهة = [];
                        دع فج: متغير طبيعي = 0;
                        طالما (فج < (الطول(قيمة_الواجهة.المواضع) مثل طبيعي)) {
                            دع سجل_الجزء: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                            عدد_السجلات := عدد_السجلات + 1;
                            دع بداية_الجزء: طبيعي = فج * 8;
                            دع المتبقي: طبيعي = قيمة_الواجهة.الحجم - بداية_الجزء;
                            دع حجم_الجزء: متغير طبيعي = المتبقي;
                            إذا (حجم_الجزء > 8) { حجم_الجزء := 8; };
                            دع مواضع_الجزء: متغير متجه موضع_جزء_واجهة = [];
                            ألحق(مواضع_الجزء, قيمة_الواجهة.المواضع[فج]);
                            دع قيمة_الجزء: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
                                السجل: سجل_الجزء,
                                المواضع: مواضع_الجزء,
                                الحجم: حجم_الجزء,
                                تجميعي: خطأ,
                                غير_مباشر: خطأ
                            };
                            طابق قيمة_الواجهة.المواضع[فج] مع
                            | موضع_جزء_واجهة.مكدس(موضع_المكدس) -> {
                                ألحق(أجزاء_المكدس, اختياري.موجود(موضع_جزء_واجهة.مكدس(موضع_المكدس)));
                            }
                            | _ -> {
                                ألحق(
                                    تعليمات_المدخل,
                                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(قيمة_الجزء)
                                );
                                ألحق(أجزاء_المكدس, اختياري.لا_شيء());
                            };
                            ألحق(الأجزاء, سجل_الجزء);
                            ألحق(أحجام_الأجزاء, حجم_الجزء);
                            فج := فج + 1;
                        }
                        دع حجم_التجميع: طبيعي = خطة_المعامل.التصنيف.الحجم;
                        دع محاذاة_التجميع: طبيعي = خطة_المعامل.التصنيف.المحاذاة;
                        دع التجهيز: تجهيز_معامل_تجميعي_إكس = {
                            المعرف: المعامل.المعرف,
                            الحجم: حجم_التجميع,
                            المحاذاة: محاذاة_التجميع,
                            الأجزاء: الأجزاء,
                            أحجام_الأجزاء: أحجام_الأجزاء,
                            أجزاء_المكدس: أجزاء_المكدس
                        };
                        ألحق(التجميعات_المؤجلة, التجهيز);
                    } وإلا {
                        // التقط موضع SysV في حامل قصير العمر، ثم انقل القيمة إلى
                        // سجل المعامل العادي بعد التقاط كل سجلات/مواضع ABI.
                        دع سجل_الحامل: معرف_سجل_افتراضي = معرف_سجل_افتراضي_من(عدد_السجلات);
                        عدد_السجلات := عدد_السجلات + 1;
                        دع قيمة_الحامل: متغير قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_خطة_إكس(
                            سجل_الحامل, &خطة_المعامل.التصنيف, &خطة_المعامل.الموقع
                        );
                        إذا (قيمة_الواجهة.غير_مباشر) {
                            // A hidden reference: the parameter's value is the
                            // address of its bytes, read in place and never
                            // written (no copy into a slot of its own).
                            قيمة_الحامل.الحجم := 8;
                            قيمة_الحامل.تجميعي := خطأ;
                            قيمة_الحامل.غير_مباشر := خطأ;
                        };
                        ألحق(
                            تعليمات_المدخل,
                            تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(قيمة_الحامل)
                        );
                        دع النقل: تجهيز_معامل_مفرد_إكس = {
                            الوجهة: سجل_المعامل,
                            الحامل: سجل_الحامل
                        };
                        ألحق(النقلات_المؤجلة, النقل);
                    };
                };
            };
            ف_المعامل := ف_المعامل + 1;
        }

        طابق حامل_ناتج_غير_مباشر مع
        | اختياري.موجود(الحامل) -> {
            طابق عنوان_ناتج_غير_مباشر مع
            | اختياري.موجود(المحفوظ) -> {
                ألحق(
                    تعليمات_المدخل,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(المحفوظ, الحامل)
                );
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                    المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة()
                ));
            };
        }
        | اختياري.لا_شيء -> { };

        // لا تُنقل الحوامل إلى سجلات المعاملات إلا بعد اكتمال التقاط جميع
        // مواضع SysV، حتى لا يكتب نقل مبكر فوق سجل دخل لم يُلتقط بعد.
        دع ف_النقل: متغير طبيعي = 0;
        طالما (ف_النقل < (الطول(النقلات_المؤجلة) مثل طبيعي)) {
            دع مرجع_النقل: &تجهيز_معامل_مفرد_إكس = &النقلات_المؤجلة[ف_النقل];
            دع النقل: تجهيز_معامل_مفرد_إكس = *مرجع_النقل;
            ألحق(
                تعليمات_المدخل,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(النقل.الوجهة, النقل.الحامل)
            );
            ف_النقل := ف_النقل + 1;
        }

        // أعد تركيب المعاملات التجميعية من حقائق SysV التي حُسمت بالفعل
        // عند تصنيف المعامل، بلا إعادة استعلام للتخطيط عبر معرف MSIR.
        دع فت: متغير طبيعي = 0;
        طالما (فت < (الطول(التجميعات_المؤجلة) مثل طبيعي)) {
            دع مرجع_التجهيز: &تجهيز_معامل_تجميعي_إكس = &التجميعات_المؤجلة[فت];
            دع التجهيز: تجهيز_معامل_تجميعي_إكس = *مرجع_التجهيز;
            دع سجل_القيمة: معرف_سجل_افتراضي = سجل_إكس_لقيمة_مسير(التجهيز.المعرف);
            دع حجم_التجميع: طبيعي = التجهيز.الحجم;
            دع محاذاة_التجميع: طبيعي = التجهيز.المحاذاة;
            دع هوية_التجميع: طبيعي = التجهيز.المعرف.القيمة;
            دع حجم_الحجز: طبيعي = حجم_موضع_تجميعي_واجهة_إكس(حجم_التجميع);
            أضف_طلب_موضع_محلي_إكس(
                &متغير المواضع_المحلية, هوية_التجميع, حجم_الحجز, محاذاة_التجميع
            );
            ألحق(
                تعليمات_المدخل,
                تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(
                    سجل_القيمة, هوية_التجميع
                )
            );
            دع فج: متغير طبيعي = 0;
            طالما (فج < (الطول(التجهيز.الأجزاء) مثل طبيعي)) {
                دع الإزاحة_غير_الموقعة: طبيعي = فج * 8;
                دع الإزاحة: عدد = الإزاحة_غير_الموقعة مثل عدد;
                دع الأساس: اختياري معرف_سجل_افتراضي = اختياري.موجود(سجل_القيمة);
                دع الفهرس: اختياري معرف_سجل_افتراضي = اختياري.لا_شيء();
                دع العنوان: عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون = {
                    الأساس: الأساس,
                    الفهرس: الفهرس,
                    المقياس: 1,
                    الإزاحة: الإزاحة
                };
                طابق التجهيز.أجزاء_المكدس[فج] مع
                | اختياري.موجود(موضع_الجزء) -> {
                    دع مواضع_الجزء: متغير متجه موضع_جزء_واجهة = [];
                    ألحق(مواضع_الجزء, موضع_الجزء);
                    دع قيمة_الجزء: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
                        السجل: التجهيز.الأجزاء[فج],
                        المواضع: مواضع_الجزء,
                        الحجم: التجهيز.أحجام_الأجزاء[فج],
                        تجميعي: خطأ,
                        غير_مباشر: خطأ
                    };
                    ألحق(تعليمات_المدخل, تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(قيمة_الجزء));
                }
                | اختياري.لا_شيء -> { };
                ألحق(
                    تعليمات_المدخل,
                    تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخزين_إكس(
                        التجهيز.الأجزاء[فج], العنوان, التجهيز.أحجام_الأجزاء[فج]
                    )
                );
                فج := فج + 1;
            }
            فت := فت + 1;
        }

        دع الكتل: متغير متجه كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = [];
        دع رموز_النسخ: متغير حقائق_نسخ_قيم_مسير = حقائق_نسخ_فارغة_مسير(0);
        إذا ((المعرف.القيمة مثل طبيعي) < (الطول((*المسير).المسير.الدوال) مثل طبيعي)) {
            رموز_النسخ := رموز_نسخ_قيم_مسير(&(*المسير).المسير.الدوال[المعرف.القيمة]);
        };
        دع الثابتة: متغير متجه منطقي = [];
        إذا ((المعرف.القيمة مثل طبيعي) < (الطول((*المسير).المسير.الدوال) مثل طبيعي)) {
            الثابتة := مخازن_ثابتة_للنداء_مسير(&(*المسير).المسير.الدوال[المعرف.القيمة], &رموز_النسخ);
        };
        دع حقائق_النسخ: حقائق_نسخ_إكس = {
            النسخ: رموز_النسخ, عنوان_الناتج: عنوان_ناتج_غير_مباشر, الثابتة: الثابتة
        };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العرض.عدد_الكتل) {
            طابق معرف_كتلة_مسير_عند(المسير, المعرف, ف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(فشل_اختيار_إكس_في_دالة(
                    المعرف, خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة()
                ));
            }
            | اختياري.موجود(معرف_الكتلة) -> {
                دع بادئة: متغير متجه تعليمة_إكس_ستة_وثمانون_أربعة_وستون = [];
                طابق العرض.المدخل مع
                | اختياري.موجود(المدخل) -> {
                    إذا (كتلتان_مسير_متساويتان(المدخل, معرف_الكتلة)) {
                        // Only the entry block takes the prologue.
                        بدّل(بادئة, تعليمات_المدخل);
                    };
                }
                | اختياري.لا_شيء -> { };
                طابق انتق_كتلة_إكس(
                    المسير,
                    حقائق_الخلفية,
                    الهدف,
                    سجل_التخطيط,
                    &خطة_الناتج,
                    عنوان_ناتج_غير_مباشر,
                    بادئة,
                    &متغير المواضع_المحلية,
                    &متغير عدد_السجلات,
                    المعرف,
                    معرف_الكتلة,
                    &حقائق_النسخ
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الكتلة) -> { ألحق(الكتل, الكتلة); };
            };
            ف := ف + 1;
        }
        دع معرف_الدالة_المنتقاة: معرف_دالة_منتقاة = دالة_إكس_من_مسير(المعرف);
        دع الرأس: رأس_دالة_منتقاة = {
            المعرف: معرف_الدالة_المنتقاة,
            عدد_السجلات_الافتراضية: عدد_السجلات
        };
        دع الدالة: دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
            الرأس: الرأس,
            الكتل: الكتل,
            المواضع_المحلية: المواضع_المحلية
        };
        أرجع نتيجة.نجح(الدالة);
    };
}

عام عرف انتق_مسير_إلى_إكس_ستة_وثمانون_أربعة_وستون(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط
): نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون {
    دع الوصف: واصف_هدف = *الهدف;
    طابق الوصف.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> {
        دع السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون = خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.هدف_ليس_إكس_ستة_وثمانون_أربعة_وستون(الوصف.المعرف);
        أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.خطأ(فشل_اختيار_إكس_عام(السبب));
    };

    دع الدوال: متغير متجه دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختياري.لا_شيء -> {
            دع السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون = خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة();
            أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.خطأ(فشل_اختيار_إكس_عام(السبب));
        }
        | اختياري.موجود(المعرف) -> {
            طابق انتق_دالة_إكس(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف) مع
            | نتيجة.خطأ(الخطأ) -> {
                طابق الخطأ.السبب مع
                | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> {
                    أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي);
                }
                | _ -> {
                    أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.خطأ(الخطأ);
                };
            }
            | نتيجة.نجح(الدالة) -> {
                ألحق(الدوال, الدالة);
            };
        };
        ف := ف + 1;
    }
    دع الرأس: رأس_برنامج_منتقى = { الهدف: الوصف.المعرف };
    دع الشفرة: شفرة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
        الرأس: الرأس,
        الدوال: الدوال
    };
    أرجع نتيجة_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نجح(الشفرة);
}
