استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.types;
استورد compiler.backend.provider.llvm.functions;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.target.selection_query_context;
استورد compiler.backend.target.target_abi_resolution;
استورد compiler.backend.layout.layout_model;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.msir_model;
استورد compiler.msir.decimal_float_bits;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.type_identity;
استورد compiler.backend.target.target_model;
استورد std.text.from_bytes;

عرف ثابت_تهيئة_عام_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    القيد: &قيد_نوع_إل_إل_في_إم,
    الثابت: &ثابت_مسير
): اختيار مرجع_قيمة_إل_إل_في_إم {
    طابق *الثابت مع
    | ثابت_مسير.منطق(ق) -> {
        دع قيمة: متغير غ64 = 0; لو (ق) { قيمة := 1; };
        أرجع اختيار.بعض(ثابت_صحيح_إل_إل_في_إم((*القيد).التمثيل, قيمة, خطأ));
    }
    | ثابت_مسير.صحيح_موقع(ق) -> { أرجع اختيار.بعض(ثابت_صحيح_إل_إل_في_إم((*القيد).التمثيل, ق مثل غ64, صواب)); }
    | ثابت_مسير.صحيح_غير_موقع(ق) -> { أرجع اختيار.بعض(ثابت_صحيح_إل_إل_في_إم((*القيد).التمثيل, ق مثل غ64, خطأ));
        }
    | ثابت_مسير.مؤشر_فارغ -> {
        أرجع اختيار.بعض(ثابت_صفر_إل_إل_في_إم((*القيد).التمثيل));
    }
    | ثابت_مسير.عشري(البايتات) -> {
        دع العرض: غير_موقع;
        طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, (*القيد).النوع) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ب) -> { العرض := ب; };
        دع البتات: غير_موقع;
        طابق بتات_عائم_من_عشري(&البايتات, العرض) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ب) -> { البتات := ب; };
        دع نوع_البتات: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, العرض مثل غ32);
        دع الخام: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_البتات, البتات مثل غ64, خطأ);
        أرجع اختيار.بعض(ثابت_إعادة_تفسير_إل_إل_في_إم(الخام, (*القيد).التمثيل));
    }
    | ثابت_مسير.دالة(المعرف) -> {
        طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(ق) -> { أرجع اختيار.بعض(ق.الدالة); };
    }
    | ثابت_مسير.نص(_) -> { أرجع اختيار.لا_شيء(); }
    | ثابت_مسير.متجه(_) -> { أرجع اختيار.لا_شيء(); };
}

عرف أعلن_عام_نص_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العام_المسير: &عام_مسير,
    البايتات: &متجه غ8
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    // A mutable text value cannot initially own read-only static bytes:
    // subsequent growth/release must operate on genuinely owned storage.
    لو ((*العام_المسير).قابل_للكتابة
        && (الطول(*البايتات) مثل غير_موقع) != 0) {
        أرجع نتيجة.خطأ(
            فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع)
        );
    };
    دع التخطيط: واصف_تخطيط;
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, (*العام_المسير).النوع) مع
    | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل((*العام_المسير).النوع)); }
    | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض((*العام_المسير).النوع)); }
    | نتيجة_تخطيط.مكتمل(ت) -> { التخطيط := ت; };
    دع حجم_المؤشر: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
    لو (التخطيط.الحجم != حجم_المؤشر * 3 || التخطيط.المحاذاة != حجم_المؤشر) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع));
    };
    دع الأجزاء: متجه موضع_جزء_تخطيط;
    طابق التخطيط.التفاصيل مع
    | تفاصيل_تخطيط.سجل(ق) -> { الأجزاء := ق; }
    | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع)); };
    لو ((الطول(الأجزاء) مثل غير_موقع) != 3
        || الأجزاء[0].الإزاحة != 0
        || الأجزاء[1].الإزاحة != حجم_المؤشر
        || الأجزاء[2].الإزاحة != حجم_المؤشر * 2) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع));
    };

    // Empty text owns no bytes. Its data pointer must be null, especially for
    // mutable globals: a zero-length static LLVM array is not heap storage.
    دع مخزن_النص: مرجع_قيمة_إل_إل_في_إم;
    لو ((الطول(*البايتات) مثل غير_موقع) == 0) {
        مخزن_النص := ثابت_صفر_إل_إل_في_إم(نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
    } وإلا {
        دع اسم_بايتات_خام: متجه غ8 = اسم_نص_عام_إل_إل_في_إم((*العام_المسير).المعرف.القيمة);
        دع اسم_بايتات: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_بايتات_خام);
        دع نوع_بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
        دع نوع_المصفوفة: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(
            نوع_بايت, الطول(*البايتات) مثل غ64
        );
        مخزن_النص := أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_المصفوفة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_بايتات));
        دع النسخة: متغير متجه غ8 = *البايتات;
        ضع_تهيئة_عام_إل_إل_في_إم(مخزن_النص, ثابت_بايتات_إل_إل_في_إم(
            (*الحالة).السياق, &متغير النسخة[0], الطول(النسخة) مثل غير_موقع
        ));
        ضع_ثبات_عام_إل_إل_في_إم(مخزن_النص, صواب);
    };

    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل غ32);
    دع العدد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, الطول(*البايتات) مثل غ64, خطأ);
    دع الحقول: متغير متجه مرجع_قيمة_إل_إل_في_إم = [مخزن_النص, العدد, العدد];
    دع التهيئة: مرجع_قيمة_إل_إل_في_إم = ثابت_بنية_إل_إل_في_إم((*الحالة).السياق, &متغير الحقول[0], 3);
    دع نوع_العام: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(التهيئة);
    دع الاسم_الخام: متجه غ8 = اسم_عام_إل_إل_في_إم((*العام_المسير).المعرف.القيمة);
    دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
    دع العام: مرجع_قيمة_إل_إل_في_إم = أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_العام,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم));
    ضع_تهيئة_عام_إل_إل_في_إم(العام, التهيئة);
    ضع_ثبات_عام_إل_إل_في_إم(العام, !(*العام_المسير).قابل_للكتابة);
    ضع_محاذاة_قيمة_إل_إل_في_إم(العام, التخطيط.المحاذاة مثل غ32);
    أرجع نتيجة.نجح(العام);
}


// Materialize constant vector elements as ordinary LLVM globals. The backing
// store has static lifetime and is read-only; writable vectors require owned
// allocation and cannot alias this storage (realloc/free would be invalid).
عرف ابن_ثابت_متجه_عام_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_عام_مسير,
    الرقم_التالي: &متغير غير_موقع,
    النوع: معرف_نوع,
    العناصر: &متجه ثابت_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_متجه_دلالي(&(*الحقائق).الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); }
    | اختيار.بعض(القيمة) -> { نوع_العنصر := القيمة; };
    دع التخطيط: واصف_تخطيط;
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(النوع)); }
    | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(النوع)); }
    | نتيجة_تخطيط.مكتمل(القيمة) -> { التخطيط := القيمة; };
    دع عرض_المؤشر: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر;
    دع حجم_المؤشر: غير_موقع = عرض_المؤشر / 8;
    لو (عرض_المؤشر == 0 || التخطيط.الحجم != حجم_المؤشر * 3
        || التخطيط.المحاذاة != حجم_المؤشر) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع));
    };
    دع حقول_الهيئة: متجه موضع_جزء_تخطيط;
    طابق التخطيط.التفاصيل مع
    | تفاصيل_تخطيط.سجل(الحقول) -> { حقول_الهيئة := الحقول; }
    | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
    لو ((الطول(حقول_الهيئة) مثل غير_موقع) != 3
        || حقول_الهيئة[0].الإزاحة != 0
        || حقول_الهيئة[1].الإزاحة != حجم_المؤشر
        || حقول_الهيئة[2].الإزاحة != حجم_المؤشر * 2) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع));
    };
    دع الطول_الثابت: غير_موقع = الطول(*العناصر) مثل غير_موقع;
    دع المؤشر: مرجع_قيمة_إل_إل_في_إم;
    لو (الطول_الثابت == 0) {
        المؤشر := ثابت_صفر_إل_إل_في_إم(نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
    } وإلا {
        دع القيم: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
        دع فهرس_العنصر: متغير غير_موقع = 0;
        بينما (فهرس_العنصر < الطول_الثابت) {
            دع الثابت: &ثابت_مسير = &(*العناصر)[فهرس_العنصر];
            دع قيمة_العنصر: مرجع_قيمة_إل_إل_في_إم;
            طابق *الثابت مع
            | ثابت_مسير.متجه(الداخل) -> {
                طابق ابن_ثابت_متجه_عام_إل_إل_في_إم(
                    الحالة, الحقائق, الهدف, سجل_التخطيط,
                    المعرف, الرقم_التالي, نوع_العنصر, &الداخل
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(القيمة) -> { قيمة_العنصر := القيمة; };
            }
            | _ -> {
                دع قيد_العنصر: قيد_نوع_إل_إل_في_إم;
                طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع
                | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة_نوع_إل_إل_في_إم.نجح(القيد) -> { قيد_العنصر := القيد; };
                لو (قيد_العنصر.تجميعي) {
                    أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_العنصر));
                };
                طابق ثابت_تهيئة_عام_إل_إل_في_إم(الحالة, الحقائق, &قيد_العنصر, الثابت) مع
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_العنصر)); }
                | اختيار.بعض(القيمة) -> { قيمة_العنصر := القيمة; };
            };
            ألحق(القيم, قيمة_العنصر);
            فهرس_العنصر := فهرس_العنصر + 1;
        }
        دع نوع_البيانات: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(القيم[0]);
        دع نوع_المصفوفة: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(نوع_البيانات, الطول_الثابت مثل غ64);
        دع الاسم_الخام: متغير متجه غ8 = اسم_عام_إل_إل_في_إم(المعرف.القيمة);
        ألحق(الاسم_الخام, 0x5F);
        ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم_الخام, *الرقم_التالي);
        *الرقم_التالي := *الرقم_التالي + 1;
        دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
        المؤشر := أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_المصفوفة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم));
        ضع_تهيئة_عام_إل_إل_في_إم(المؤشر,
            ثابت_مصفوفة_إل_إل_في_إم(نوع_البيانات, &متغير القيم[0], الطول_الثابت مثل غ64));
        ضع_ثبات_عام_إل_إل_في_إم(المؤشر, صواب);
        دع تخطيط_العنصر: واصف_تخطيط;
        طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع
        | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(نوع_العنصر)); }
        | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(نوع_العنصر)); }
        | نتيجة_تخطيط.مكتمل(البيانات) -> { تخطيط_العنصر := البيانات; };
        ضع_محاذاة_قيمة_إل_إل_في_إم(المؤشر, تخطيط_العنصر.المحاذاة مثل غ32);
    };
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, عرض_المؤشر مثل غ32);
    دع العدد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, الطول_الثابت مثل غ64, خطأ);
    دع الحقول: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المؤشر, العدد, العدد];
    أرجع نتيجة.نجح(ثابت_بنية_إل_إل_في_إم((*الحالة).السياق, &متغير الحقول[0], 3));
}

عرف أعلن_عام_متجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العام_المسير: &عام_مسير,
    العناصر: &متجه ثابت_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    // Mutable empty vectors own no backing array; a null pointer and zero
    // length/capacity can be materialized as a writable global. Nonempty
    // mutable vectors cannot alias the static constant arrays below because
    // vector growth must be able to release or reallocate owned storage.
    لو ((*العام_المسير).قابل_للكتابة && (الطول(*العناصر) مثل غير_موقع) != 0) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع));
    };
    دع التسلسل: متغير غير_موقع = 0;
    دع الثابت: مرجع_قيمة_إل_إل_في_إم;
    طابق ابن_ثابت_متجه_عام_إل_إل_في_إم(
        الحالة, الحقائق, الهدف, سجل_التخطيط, (*العام_المسير).المعرف,
        &متغير التسلسل, (*العام_المسير).النوع, العناصر
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الثابت := القيمة; };
    دع الاسم_الخام: متجه غ8 = اسم_عام_إل_إل_في_إم((*العام_المسير).المعرف.القيمة);
    دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
    دع العام: مرجع_قيمة_إل_إل_في_إم = أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_قيمة_إل_إل_في_إم(الثابت),
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم));
    ضع_تهيئة_عام_إل_إل_في_إم(العام, الثابت);
    ضع_ثبات_عام_إل_إل_في_إم(العام, !(*العام_المسير).قابل_للكتابة);
    دع تخطيط_العام: واصف_تخطيط;
    طابق حل_تخطيط_نوع_للاختيار(
        الحقائق, الهدف, سجل_التخطيط, (*العام_المسير).النوع
    ) مع
    | نتيجة_تخطيط.مؤجل(_) -> {
        أرجع نتيجة.خطأ(
            فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل((*العام_المسير).النوع)
        );
    }
    | نتيجة_تخطيط.مرفوض(_) -> {
        أرجع نتيجة.خطأ(
            فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض((*العام_المسير).النوع)
        );
    }
    | نتيجة_تخطيط.مكتمل(التخطيط) -> { تخطيط_العام := التخطيط; };
    ضع_محاذاة_قيمة_إل_إل_في_إم(العام, تخطيط_العام.المحاذاة مثل غ32);
    أرجع نتيجة.نجح(العام);
}

// Standalone MSIR module initializers remain loader-visible. A local ABI
// trampoline supplies the hidden SultanC environment pointer as null, since
// ELF/Mach-O loader initializers do not use SultanC's calling convention.
// This does not promise process startup data before the loader runs it.
عرف أعلن_منشئ_وحدة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المعرف) -> {
        دع قيد_الدالة: قيد_دالة_إل_إل_في_إم;
        طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); }
        | نتيجة.نجح(القيد) -> { قيد_الدالة := القيد; };
        دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
        دع نوع_المؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم(السياق);
        // Verified MSIR owns one zero-argument, void module initializer.
        // Functions are only declared here; their bodies are lowered later.
        // Ordinary SultanC functions have a hidden closure-environment pointer;
        // a loader initializer must instead have a void(void) CRT signature.
        دع توقيع_اللغة: مرجع_نوع_إل_إل_في_إم = قيد_الدالة.نوع_الدالة;
        لو (!قيد_الدالة.له_بيئة_إغلاق
            || قيد_الدالة.غير_مباشر_الناتج
            || قيد_الدالة.عدد_معاملات_إل_إل_في_إم != 1
            || LLVMGlobalGetValueType(قيد_الدالة.الدالة) != توقيع_اللغة
            || LLVMGetFunctionCallConv(قيد_الدالة.الدالة) != 0
            || LLVMIsFunctionVarArg(توقيع_اللغة) != 0
            || LLVMCountParamTypes(توقيع_اللغة) != 1
            || LLVMGetReturnType(توقيع_اللغة) != LLVMVoidTypeInContext(السياق)
            || LLVMTypeOf(LLVMGetParam(قيد_الدالة.الدالة, 0)) != نوع_المؤشر) {
            أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
        دع اسم_المدخل_الخام: متجه غ8 = بايتات_من_نص(«sultanc.module_ctor»);
        دع اسم_المدخل: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_المدخل_الخام);
        // Each standalone object owns exactly one loader registration. Both
        // reserved LLVM names must be free before emitting the trampoline;
        // LLVMAddGlobal/LLVMAddFunction would otherwise uniquify a collision.
        دع اسم_منشئات_خام: متجه غ8 = بايتات_من_نص(«llvm.global_ctors»);
        دع اسم_منشئات: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_منشئات_خام);
        لو (LLVMGetNamedFunction((*الحالة).الوحدة, &متغير اسم_المدخل[0]) != الفارغ
            || LLVMGetNamedGlobal((*الحالة).الوحدة, &متغير اسم_المدخل[0]) != الفارغ
            || LLVMGetNamedFunction((*الحالة).الوحدة, &متغير اسم_منشئات[0]) != الفارغ
            || LLVMGetNamedGlobal((*الحالة).الوحدة, &متغير اسم_منشئات[0]) != الفارغ) {
            أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
        دع معاملات_المدخل: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_المؤشر];
        دع توقيع_المدخل: مرجع_نوع_إل_إل_في_إم = LLVMFunctionType(
            LLVMVoidTypeInContext(السياق), &متغير معاملات_المدخل[0], 0, 0
        );
        دع مدخل_المنشئ: مرجع_قيمة_إل_إل_في_إم = LLVMAddFunction(
            (*الحالة).الوحدة, &متغير اسم_المدخل[0], توقيع_المدخل
        );
        لو (!يطابق_اسم_قيمة_إل_إل_في_إم(مدخل_المنشئ, &اسم_المدخل_الخام)
            || LLVMGlobalGetValueType(مدخل_المنشئ) != توقيع_المدخل) {
            أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
        LLVMSetLinkage(مدخل_المنشئ, ربط_داخلي_إل_إل_في_إم());
        دع اسم_الكتلة: متغير متجه غ8 = بايتات_منتهية_بصفر_من_نص(«entry»);
        دع الكتلة: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(
            السياق, مدخل_المنشئ, &متغير اسم_الكتلة[0]
        );
        دع الباني: مرجع_بان_إل_إل_في_إم = LLVMCreateBuilderInContext(السياق);
        LLVMPositionBuilderAtEnd(الباني, الكتلة);
        دع اسم_فارغ: متغير متجه غ8 = [0];
        دع المؤشر_الفارغ: مرجع_قيمة_إل_إل_في_إم = LLVMConstNull(نوع_المؤشر);
        دع المعاملات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المؤشر_الفارغ];
        LLVMBuildCall2(
            الباني, توقيع_اللغة, قيد_الدالة.الدالة,
            &متغير المعاملات[0], 1, &متغير اسم_فارغ[0]
        );
        LLVMBuildRetVoid(الباني);
        LLVMDisposeBuilder(الباني);
        دع نوع_الأولوية: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, 32);
        دع أنواع_الحقول: متغير متجه مرجع_نوع_إل_إل_في_إم = [
            نوع_الأولوية, نوع_المؤشر, نوع_المؤشر
        ];
        دع نوع_السجل: مرجع_نوع_إل_إل_في_إم = نوع_بنية_إل_إل_في_إم(
            السياق, &متغير أنواع_الحقول[0], 3
        );
        دع أولوية_المنشئ: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_الأولوية, 65535, خطأ);
        دع بيانات_المنشئ: مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(نوع_المؤشر);
        دع حقول_المنشئ: متغير متجه مرجع_قيمة_إل_إل_في_إم = [
            أولوية_المنشئ,
            مدخل_المنشئ,
            بيانات_المنشئ
        ];
        دع المنشئ: مرجع_قيمة_إل_إل_في_إم = ثابت_بنية_إل_إل_في_إم(
            السياق, &متغير حقول_المنشئ[0], 3
        );
        دع المنشئات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المنشئ];
        دع المصفوفة: مرجع_قيمة_إل_إل_في_إم = ثابت_مصفوفة_إل_إل_في_إم(
            نوع_السجل, &متغير المنشئات[0], 1
        );
        دع نوع_المصفوفة: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(نوع_السجل, 1);
        دع العام: مرجع_قيمة_إل_إل_في_إم = أضف_عام_إل_إل_في_إم(
            (*الحالة).الوحدة, نوع_المصفوفة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_منشئات)
        );
        لو (!يطابق_اسم_قيمة_إل_إل_في_إم(العام, &اسم_منشئات_خام)) {
            أرجع اختيار.بعض(
                فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(اسم_منشئات_خام)
            );
        };
        ضع_تهيئة_عام_إل_إل_في_إم(العام, المصفوفة);
        ضع_ربط_منشئات_إل_إل_في_إم(العام);
        أرجع اختيار.لا_شيء();
    };
}

عام عرف أعلن_وحدة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: &اختيار معرف_دالة_مسير,
    الدوال_المطلوبة: &متجه منطقي
): اختيار فشل_مزود_إل_إل_في_إم {
    // MSIR represents module initialization by exactly one of two routes:
    // an entry-prelude call for executables, or a loader constructor for
    // standalone objects. Never register the latter for an executable:
    // it could run before CRT startup and repeat the entry-prelude call.
    طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
    | اختيار.بعض(_) -> {
        طابق (*المسير).المسير.دالة_بدء_البرنامج مع
        | اختيار.بعض(_) -> {
            أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        }
        | اختيار.لا_شيء -> { };
        طابق *دالة_الدخول مع
        | اختيار.بعض(_) -> {
            أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    (*الحالة).مزودات_تخصيص_الذاكرة := (*المسير).المسير.مزودات_تخصيص_الذاكرة;
    // Only the functions selected by the shared MSIR reachability query are
    // declared and lowered (all of them for objects; the entry closure for
    // executables, exactly like the native provider).
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المعرف) -> {
            لو (دالة_إل_إل_في_إم_مطلوبة(الدوال_المطلوبة, المعرف)) {
            طابق ابحث_دالة_مسير(المسير, المعرف) مع
            | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); }
            | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
                طابق أعلن_دالة_سلطان_إل_إل_في_إم(
                    الحالة, المسير, الحقائق, الهدف, سجل_التخطيط, دالة_الدخول, &العرض
                ) مع
                | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
                | اختيار.لا_شيء -> { };
            };
            };
        };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول((*المسير).المسير.الدوال_الخارجية) مثل غير_موقع)) {
        دع د: &دالة_خارجية_مسير = &(*المسير).المسير.الدوال_الخارجية[ف];
        طابق أعلن_دالة_خارجية_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, د) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول((*المسير).المسير.العوام) مثل غير_موقع)) {
        دع ع: &عام_مسير = &(*المسير).المسير.العوام[ف];
        دع العام: مرجع_قيمة_إل_إل_في_إم;
        طابق (*ع).الاسم_الخارجي مع
        | اختيار.بعض(اسم_الربط) -> {
            // LLVMAddGlobal without an initializer declares external data storage.
            // It is NOT an external function and must not receive LLVMSetInitializer.
            دع القيد: قيد_نوع_إل_إل_في_إم;
            طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*ع).النوع) مع
            | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | نتيجة_نوع_إل_إل_في_إم.نجح(القيمة) -> { القيد := القيمة; };
            دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_الربط);
            العام := أضف_عام_إل_إل_في_إم(
                (*الحالة).الوحدة, القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم)
            );
            // Do not let LLVM silently turn an imported linker name into
            // name.1 when it collides with a previously emitted symbol.
            لو (!يطابق_اسم_قيمة_إل_إل_في_إم(العام, &اسم_الربط)) {
                أرجع اختيار.بعض(
                    فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(
                        انسخ_بايتات_إل_إل_في_إم(&اسم_الربط)
                    )
                );
            };
            دع التخطيط: واصف_تخطيط;
            طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, (*ع).النوع) مع
            | نتيجة_تخطيط.مؤجل(_) -> {
                أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل((*ع).النوع));
            }
            | نتيجة_تخطيط.مرفوض(_) -> {
                أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض((*ع).النوع));
            }
            | نتيجة_تخطيط.مكتمل(القيمة) -> { التخطيط := القيمة; };
            ضع_محاذاة_قيمة_إل_إل_في_إم(العام, التخطيط.المحاذاة مثل غ32);
            // This is only a declaration. Its external owner may initialize
            // even a source-readonly value, so never mark it LLVM constant.
        }
        | اختيار.لا_شيء -> {
        طابق (*ع).التهيئة مع
        | ثابت_مسير.نص(البايتات) -> {
            طابق أعلن_عام_نص_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, ع, &البايتات) مع
            | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة.نجح(ق) -> { العام := ق; };
        }
        | ثابت_مسير.متجه(العناصر) -> {
            طابق أعلن_عام_متجه_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, ع, &العناصر) مع
            | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة.نجح(ق) -> { العام := ق; };
        }
        | _ -> {
            دع قيد_النوع: قيد_نوع_إل_إل_في_إم;
            طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*ع).النوع) مع
            | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد_النوع := ق; };
            // Other aggregate forms require an explicit supported constant layout.
            // Do not pass opaque storage as a scalar initializer.
            لو (قيد_النوع.تجميعي) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*ع).النوع)); };
            دع الاسم_الخام: متجه غ8 = اسم_عام_إل_إل_في_إم((*ع).المعرف.القيمة);
            دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
            العام := أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, قيد_النوع.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
                الاسم));
            طابق ثابت_تهيئة_عام_إل_إل_في_إم(الحالة, الحقائق, &قيد_النوع, &(*ع).التهيئة) مع
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*ع).النوع)); }
            | اختيار.بعض(قيمة) -> { ضع_تهيئة_عام_إل_إل_في_إم(العام, قيمة); };
            ضع_ثبات_عام_إل_إل_في_إم(العام, !(*ع).قابل_للكتابة);
            // Match Native's canonical target layout rather than relying on
            // the LLVM module's implicit alignment for scalar globals.
            دع تخطيط_العام: واصف_تخطيط;
            طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, (*ع).النوع) مع
            | نتيجة_تخطيط.مؤجل(_) -> {
                أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل((*ع).النوع));
            }
            | نتيجة_تخطيط.مرفوض(_) -> {
                أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض((*ع).النوع));
            }
            | نتيجة_تخطيط.مكتمل(التخطيط) -> { تخطيط_العام := التخطيط; };
            ضع_محاذاة_قيمة_إل_إل_في_إم(العام, تخطيط_العام.المحاذاة مثل غ32);
        };
        };
        دع موضع_العام: غير_موقع = (*ع).المعرف.القيمة;
        بينما ((الطول((*الحالة).العوام) مثل غير_موقع) <= موضع_العام) { ألحق((*الحالة).العوام, اختيار.لا_شيء());
            }
        دع قيد: قيد_عام_إل_إل_في_إم = { المعرف: (*ع).المعرف, القيمة: العام, النوع: (*ع).النوع };
        (*الحالة).العوام[موضع_العام] := اختيار.بعض(قيد);
        ف := ف + 1;
    }
    طابق أعلن_منشئ_وحدة_إل_إل_في_إم(الحالة, المسير) مع
    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
    | اختيار.لا_شيء -> { };
    أرجع اختيار.لا_شيء();
}
