عرف ثابت_تهيئة_عام_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    القيد: &قيد_نوع_إل_إل_في_إم,
    الثابت: &ثابت_مسير
): اختياري مرجع_قيمة_إل_إل_في_إم {
    طابق *الثابت مع
    | ثابت_مسير.منطق(ق) -> {
        ليكن قيمة: متغير ط64 = 0; إذا (ق) { قيمة := 1; };
        أرجع اختياري.موجود(ثابت_صحيح_إل_إل_في_إم((*القيد).التمثيل, قيمة, خطأ));
    }
    | ثابت_مسير.صحيح_موقع(ق) -> { أرجع اختياري.موجود(ثابت_صحيح_إل_إل_في_إم((*القيد).التمثيل, ق مثل ط64, صواب)); }
    | ثابت_مسير.صحيح_طبيعي(ق) -> { أرجع اختياري.موجود(ثابت_صحيح_إل_إل_في_إم((*القيد).التمثيل, ق مثل ط64, خطأ));
    }
    | ثابت_مسير.مؤشر_فارغ -> {
        أرجع اختياري.موجود(ثابت_صفر_إل_إل_في_إم((*القيد).التمثيل));
    }
    | ثابت_مسير.عشري(البايتات) -> {
        ليكن العرض: طبيعي;
        طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, (*القيد).النوع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ب) -> { العرض := ب; };
        ليكن البتات: طبيعي;
        طابق بتات_عائم_من_عشري(&البايتات, العرض) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ب) -> { البتات := ب; };
        ليكن نوع_البتات: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, العرض مثل ط32);
        ليكن الخام: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_البتات, البتات مثل ط64, خطأ);
        أرجع اختياري.موجود(ثابت_إعادة_تفسير_إل_إل_في_إم(الخام, (*القيد).التمثيل));
    }
    | ثابت_مسير.دالة(المعرف) -> {
        طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(ق) -> { أرجع اختياري.موجود(ثابت_دالة_بتمثيل_إل_إل_في_إم(ق.الدالة, (*القيد).التمثيل)); };
    }
    | ثابت_مسير.نص(_) -> { أرجع اختياري.لا_شيء(); }
    | ثابت_مسير.متجه(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف أعلن_عام_نص_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العام_المسير: &عام_مسير,
    البايتات: &متجه ط8
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    // A mutable text value cannot initially own read-only static bytes:
    // subsequent growth/release must operate on genuinely owned storage.
    إذا ((*العام_المسير).قابل_للكتابة
        && (الطول(*البايتات) مثل طبيعي) != 0) {
        أرجع نتيجة.خطأ(
            فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع)
        );
    };
    ليكن التخطيط: واصف_تخطيط;
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, (*العام_المسير).النوع) مع
    | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل((*العام_المسير).النوع)); }
    | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض((*العام_المسير).النوع)); }
    | نتيجة_تخطيط.مكتمل(ت) -> { التخطيط := ت; };
    ليكن حجم_المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
    إذا (التخطيط.الحجم != حجم_المؤشر * 3 || التخطيط.المحاذاة != حجم_المؤشر) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع));
    };
    ليكن الأجزاء: متجه موضع_جزء_تخطيط;
    طابق التخطيط.التفاصيل مع
    | تفاصيل_تخطيط.سجل(ق) -> { الأجزاء := انسخ_مملوكا_متجه_موضع_جزء_تخطيط(&ق); }
    | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع)); };
    إذا ((الطول(الأجزاء) مثل طبيعي) != 3
        || الأجزاء[0].الإزاحة != 0
        || الأجزاء[1].الإزاحة != حجم_المؤشر
        || الأجزاء[2].الإزاحة != حجم_المؤشر * 2) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع));
    };

    // Empty text owns no bytes. Its data pointer must be null, especially for
    // mutable globals: a zero-length static LLVM array is not heap storage.
    ليكن مخزن_النص: مرجع_قيمة_إل_إل_في_إم;
    إذا ((الطول(*البايتات) مثل طبيعي) == 0) {
        مخزن_النص := ثابت_صفر_إل_إل_في_إم(نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
    } وإلا {
        ليكن اسم_بايتات_خام: متجه ط8 = اسم_نص_عام_إل_إل_في_إم((*العام_المسير).المعرف.القيمة);
        ليكن اسم_بايتات: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_بايتات_خام);
        ليكن نوع_بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
        ليكن نوع_المصفوفة: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(
            نوع_بايت, الطول(*البايتات) مثل ط64
        );
        مخزن_النص := أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_المصفوفة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_بايتات));
        ليكن النسخة: متغير متجه ط8 = انسخ_بايتات(البايتات);
        ضع_تهيئة_عام_إل_إل_في_إم(مخزن_النص, ثابت_بايتات_إل_إل_في_إم(
            (*الحالة).السياق, &متغير النسخة[0], الطول(النسخة) مثل طبيعي
        ));
        ضع_ثبات_عام_إل_إل_في_إم(مخزن_النص, صواب);
    };

    ليكن نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل ط32);
    ليكن العدد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, الطول(*البايتات) مثل ط64, خطأ);
    ليكن الحقول: متغير متجه مرجع_قيمة_إل_إل_في_إم = [مخزن_النص, العدد, العدد];
    ليكن التهيئة: مرجع_قيمة_إل_إل_في_إم = ثابت_بنية_إل_إل_في_إم((*الحالة).السياق, &متغير الحقول[0], 3);
    ليكن نوع_العام: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(التهيئة);
    ليكن الاسم_الخام: متجه ط8 = اسم_عام_إل_إل_في_إم((*العام_المسير).المعرف.القيمة);
    ليكن الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
    ليكن العام: مرجع_قيمة_إل_إل_في_إم = أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_العام,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم));
    ضع_تهيئة_عام_إل_إل_في_إم(العام, التهيئة);
    ضع_ثبات_عام_إل_إل_في_إم(العام, !(*العام_المسير).قابل_للكتابة);
    ضع_محاذاة_قيمة_إل_إل_في_إم(العام, التخطيط.المحاذاة مثل ط32);
    أرجع نتيجة.نجح(العام);
}

// Materialize constant vector elements as ordinary LLVM globals. The backing
// store has static lifetime and is read-only; writable vectors require owned
// allocation and cannot alias this storage (realloc/free would be invalid).
عرف ابن_ثابت_متجه_عام_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_عام_مسير,
    الرقم_التالي: &متغير طبيعي,
    النوع: معرف_نوع,
    العناصر: &متجه ثابت_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    ليكن نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_تسلسل_دلالي(&(*الحقائق).الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); }
    | اختياري.موجود(القيمة) -> { نوع_العنصر := القيمة; };
    ليكن التخطيط: واصف_تخطيط;
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(النوع)); }
    | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(النوع)); }
    | نتيجة_تخطيط.مكتمل(القيمة) -> { التخطيط := القيمة; };
    ليكن عرض_المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر;
    ليكن حجم_المؤشر: طبيعي = عرض_المؤشر / 8;
    إذا (عرض_المؤشر == 0 || التخطيط.الحجم != حجم_المؤشر * 3
        || التخطيط.المحاذاة != حجم_المؤشر) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع));
    };
    ليكن حقول_الهيئة: متجه موضع_جزء_تخطيط;
    طابق التخطيط.التفاصيل مع
    | تفاصيل_تخطيط.سجل(الحقول) -> { حقول_الهيئة := انسخ_مملوكا_متجه_موضع_جزء_تخطيط(&الحقول); }
    | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
    إذا ((الطول(حقول_الهيئة) مثل طبيعي) != 3
        || حقول_الهيئة[0].الإزاحة != 0
        || حقول_الهيئة[1].الإزاحة != حجم_المؤشر
        || حقول_الهيئة[2].الإزاحة != حجم_المؤشر * 2) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع));
    };
    ليكن الطول_الثابت: طبيعي = الطول(*العناصر) مثل طبيعي;
    ليكن المؤشر: مرجع_قيمة_إل_إل_في_إم;
    إذا (الطول_الثابت == 0) {
        المؤشر := ثابت_صفر_إل_إل_في_إم(نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
    } وإلا {
        ليكن القيم: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
        ليكن فهرس_العنصر: متغير طبيعي = 0;
        طالما (فهرس_العنصر < الطول_الثابت) {
            ليكن الثابت: &ثابت_مسير = &(*العناصر)[فهرس_العنصر];
            ليكن قيمة_العنصر: مرجع_قيمة_إل_إل_في_إم;
            طابق *الثابت مع
            | ثابت_مسير.متجه(الداخل) -> {
                طابق ابن_ثابت_متجه_عام_إل_إل_في_إم(
                    الحالة, الحقائق, الهدف, سجل_التخطيط,
                    المعرف, الرقم_التالي, نوع_العنصر, &الداخل
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(القيمة) -> { قيمة_العنصر := القيمة; };
            }
            | _ -> {
                ليكن قيد_العنصر: قيد_نوع_إل_إل_في_إم;
                طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع
                | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة_نوع_إل_إل_في_إم.نجح(القيد) -> { قيد_العنصر := القيد; };
                إذا (قيد_العنصر.تجميعي) {
                    أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_العنصر));
                };
                طابق ثابت_تهيئة_عام_إل_إل_في_إم(الحالة, الحقائق, &قيد_العنصر, الثابت) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_العنصر)); }
                | اختياري.موجود(القيمة) -> { قيمة_العنصر := القيمة; };
            };
            ألحق(القيم, قيمة_العنصر);
            فهرس_العنصر := فهرس_العنصر + 1;
        }
        ليكن نوع_البيانات: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(القيم[0]);
        ليكن نوع_المصفوفة: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(نوع_البيانات, الطول_الثابت مثل ط64);
        ليكن الاسم_الخام: متغير متجه ط8 = اسم_عام_إل_إل_في_إم(المعرف.القيمة);
        ألحق(الاسم_الخام, 0x5F);
        ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم_الخام, *الرقم_التالي);
        *الرقم_التالي := *الرقم_التالي + 1;
        ليكن الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
        المؤشر := أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_المصفوفة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم));
        ضع_تهيئة_عام_إل_إل_في_إم(المؤشر,
            ثابت_مصفوفة_إل_إل_في_إم(نوع_البيانات, &متغير القيم[0], الطول_الثابت مثل ط64));
        ضع_ثبات_عام_إل_إل_في_إم(المؤشر, صواب);
        ليكن تخطيط_العنصر: واصف_تخطيط;
        طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع
        | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(نوع_العنصر)); }
        | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(نوع_العنصر)); }
        | نتيجة_تخطيط.مكتمل(البيانات) -> { تخطيط_العنصر := البيانات; };
        ضع_محاذاة_قيمة_إل_إل_في_إم(المؤشر, تخطيط_العنصر.المحاذاة مثل ط32);
    };
    ليكن نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, عرض_المؤشر مثل ط32);
    ليكن العدد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, الطول_الثابت مثل ط64, خطأ);
    ليكن الحقول: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المؤشر, العدد, العدد];
    أرجع نتيجة.نجح(ثابت_بنية_إل_إل_في_إم((*الحالة).السياق, &متغير الحقول[0], 3));
}

عرف أعلن_عام_متجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العام_المسير: &عام_مسير,
    العناصر: &متجه ثابت_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    // Mutable empty vectors own no backing array; a null pointer and zero
    // length/capacity can be materialized as a writable global. Nonempty
    // mutable vectors cannot alias the static constant arrays below because
    // vector growth must be able to release or reallocate owned storage.
    إذا ((*العام_المسير).قابل_للكتابة && (الطول(*العناصر) مثل طبيعي) != 0) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام_المسير).النوع));
    };
    ليكن التسلسل: متغير طبيعي = 0;
    ليكن الثابت: مرجع_قيمة_إل_إل_في_إم;
    طابق ابن_ثابت_متجه_عام_إل_إل_في_إم(
        الحالة, الحقائق, الهدف, سجل_التخطيط, (*العام_المسير).المعرف,
        &متغير التسلسل, (*العام_المسير).النوع, العناصر
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الثابت := القيمة; };
    ليكن الاسم_الخام: متجه ط8 = اسم_عام_إل_إل_في_إم((*العام_المسير).المعرف.القيمة);
    ليكن الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
    ليكن العام: مرجع_قيمة_إل_إل_في_إم = أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_قيمة_إل_إل_في_إم(الثابت),
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم));
    ضع_تهيئة_عام_إل_إل_في_إم(العام, الثابت);
    ضع_ثبات_عام_إل_إل_في_إم(العام, !(*العام_المسير).قابل_للكتابة);
    ليكن تخطيط_العام: واصف_تخطيط;
    طابق حل_تخطيط_نوع_للاختيار(
        الحقائق, الهدف, سجل_التخطيط, (*العام_المسير).النوع
    ) مع
    | نتيجة_تخطيط.مؤجل(_) -> {
        أرجع نتيجة.خطأ(
            فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل((*العام_المسير).النوع)
        );
    }
    | نتيجة_تخطيط.مرفوض(_) -> {
        أرجع نتيجة.خطأ(
            فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض((*العام_المسير).النوع)
        );
    }
    | نتيجة_تخطيط.مكتمل(التخطيط) -> { تخطيط_العام := التخطيط; };
    ضع_محاذاة_قيمة_إل_إل_في_إم(العام, تخطيط_العام.المحاذاة مثل ط32);
    أرجع نتيجة.نجح(العام);
}

// Standalone MSIR module initializers remain loader-visible. A local ABI
// trampoline supplies the hidden SultanC environment pointer as null, since
// ELF/Mach-O loader initializers do not use SultanC's calling convention.
// This does not promise process startup data before the loader runs it.
عرف أعلن_منشئ_وحدة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> {
        ليكن قيد_الدالة: قيد_دالة_إل_إل_في_إم;
        طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); }
        | نتيجة.نجح(القيد) -> { قيد_الدالة := القيد; };
        ليكن السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
        ليكن نوع_المؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم(السياق);
        // Verified MSIR owns one zero-argument, void module initializer.
        // Functions are only declared here; their bodies are lowered later.
        // Ordinary SultanC functions have a hidden closure-environment pointer;
        // a loader initializer must instead have a void(void) signature (an
        // .init_array or .CRT$XCU entry).
        ليكن توقيع_اللغة: مرجع_نوع_إل_إل_في_إم = قيد_الدالة.نوع_الدالة;
        إذا (!قيد_الدالة.له_بيئة_إغلاق
            || قيد_الدالة.غير_مباشر_الناتج
            || قيد_الدالة.عدد_معاملات_إل_إل_في_إم != 1
            || LLVMGlobalGetValueType(قيد_الدالة.الدالة) != توقيع_اللغة
            || LLVMGetFunctionCallConv(قيد_الدالة.الدالة) != 0
            || LLVMIsFunctionVarArg(توقيع_اللغة) != 0
            || LLVMCountParamTypes(توقيع_اللغة) != 1
            || LLVMGetReturnType(توقيع_اللغة) != LLVMVoidTypeInContext(السياق)
            || LLVMTypeOf(LLVMGetParam(قيد_الدالة.الدالة, 0)) != نوع_المؤشر) {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
        ليكن اسم_المدخل_الخام: متجه ط8 = بايتات_من_نص(«sultanc.module_ctor»);
        ليكن اسم_المدخل: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_المدخل_الخام);
        // Each standalone object owns exactly one loader registration. Both
        // reserved LLVM names must be free before emitting the trampoline;
        // LLVMAddGlobal/LLVMAddFunction would otherwise uniquify a collision.
        ليكن اسم_منشئات_خام: متجه ط8 = بايتات_من_نص(«llvm.global_ctors»);
        ليكن اسم_منشئات: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_منشئات_خام);
        إذا (LLVMGetNamedFunction((*الحالة).الوحدة, &متغير اسم_المدخل[0]) != الفارغ
            || LLVMGetNamedGlobal((*الحالة).الوحدة, &متغير اسم_المدخل[0]) != الفارغ
            || LLVMGetNamedFunction((*الحالة).الوحدة, &متغير اسم_منشئات[0]) != الفارغ
            || LLVMGetNamedGlobal((*الحالة).الوحدة, &متغير اسم_منشئات[0]) != الفارغ) {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
        ليكن معاملات_المدخل: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_المؤشر];
        ليكن توقيع_المدخل: مرجع_نوع_إل_إل_في_إم = LLVMFunctionType(
            LLVMVoidTypeInContext(السياق), &متغير معاملات_المدخل[0], 0, 0
        );
        ليكن مدخل_المنشئ: مرجع_قيمة_إل_إل_في_إم = LLVMAddFunction(
            (*الحالة).الوحدة, &متغير اسم_المدخل[0], توقيع_المدخل
        );
        إذا (!يطابق_اسم_قيمة_إل_إل_في_إم(مدخل_المنشئ, &اسم_المدخل_الخام)
            || LLVMGlobalGetValueType(مدخل_المنشئ) != توقيع_المدخل) {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
        LLVMSetLinkage(مدخل_المنشئ, ربط_داخلي_إل_إل_في_إم());
        ليكن اسم_الكتلة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«entry»);
        ليكن الكتلة: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(
            السياق, مدخل_المنشئ, &متغير اسم_الكتلة[0]
        );
        ليكن الباني: مرجع_بان_إل_إل_في_إم = LLVMCreateBuilderInContext(السياق);
        LLVMPositionBuilderAtEnd(الباني, الكتلة);
        ليكن اسم_فارغ: متغير متجه ط8 = [0];
        ليكن المؤشر_الفارغ: مرجع_قيمة_إل_إل_في_إم = LLVMConstNull(نوع_المؤشر);
        ليكن المعاملات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المؤشر_الفارغ];
        LLVMBuildCall2(
            الباني, توقيع_اللغة, قيد_الدالة.الدالة,
            &متغير المعاملات[0], 1, &متغير اسم_فارغ[0]
        );
        LLVMBuildRetVoid(الباني);
        LLVMDisposeBuilder(الباني);
        ليكن نوع_الأولوية: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, 32);
        ليكن أنواع_الحقول: متغير متجه مرجع_نوع_إل_إل_في_إم = [
            نوع_الأولوية, نوع_المؤشر, نوع_المؤشر
        ];
        ليكن نوع_السجل: مرجع_نوع_إل_إل_في_إم = نوع_بنية_إل_إل_في_إم(
            السياق, &متغير أنواع_الحقول[0], 3
        );
        ليكن أولوية_المنشئ: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_الأولوية, 65535, خطأ);
        ليكن بيانات_المنشئ: مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(نوع_المؤشر);
        ليكن حقول_المنشئ: متغير متجه مرجع_قيمة_إل_إل_في_إم = [
            أولوية_المنشئ,
            مدخل_المنشئ,
            بيانات_المنشئ
        ];
        ليكن المنشئ: مرجع_قيمة_إل_إل_في_إم = ثابت_بنية_إل_إل_في_إم(
            السياق, &متغير حقول_المنشئ[0], 3
        );
        ليكن المنشئات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المنشئ];
        ليكن المصفوفة: مرجع_قيمة_إل_إل_في_إم = ثابت_مصفوفة_إل_إل_في_إم(
            نوع_السجل, &متغير المنشئات[0], 1
        );
        ليكن نوع_المصفوفة: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(نوع_السجل, 1);
        ليكن العام: مرجع_قيمة_إل_إل_في_إم = أضف_عام_إل_إل_في_إم(
            (*الحالة).الوحدة, نوع_المصفوفة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_منشئات)
        );
        إذا (!يطابق_اسم_قيمة_إل_إل_في_إم(العام, &اسم_منشئات_خام)) {
            أرجع اختياري.موجود(
                فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(اسم_منشئات_خام)
            );
        };
        ضع_تهيئة_عام_إل_إل_في_إم(العام, المصفوفة);
        ضع_ربط_منشئات_إل_إل_في_إم(العام);
        أرجع اختياري.لا_شيء();
    };
}

// The static closure environments (compiler/msir/static_environments.sn):
// one writable global per function, named by اسم_بيئة_إغلاق_ساكنة_إل_إل_في_إم,
// laid out as the 24-byte environment header whatever the pointer width
// (selection_query_context.sn): the function at 0, the static count
// (2^62) as an i64 at 8, the destructor (null when none) at 16. Padding
// arrays keep those offsets where a pointer is narrower than 8 bytes.
عرف أعلن_بيئات_إغلاق_ساكنة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الهدف: &واصف_هدف
): اختياري فشل_مزود_إل_إل_في_إم {
    ليكن حجم_المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر / 8;
    إذا (حجم_المؤشر == 0 || حجم_المؤشر > 8) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة());
    };
    ليكن نوع_بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
    ليكن نوع_الحشو: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(نوع_بايت, (8 - حجم_المؤشر) مثل ط64);
    ليكن نوع_العداد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المسير).المسير.البيئات_الساكنة) مثل طبيعي)) {
        ليكن البيئة: &بيئة_إغلاق_ساكنة_مسير = &(*المسير).المسير.البيئات_الساكنة[ف];
        ليكن قيد_الدالة: قيد_دالة_إل_إل_في_إم;
        طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, (*البيئة).الدالة) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ق) -> { قيد_الدالة := ق; };
        ليكن المدمر: متغير مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
        طابق (*البيئة).المدمر مع
        | اختياري.موجود(معرف_المدمر) -> {
            طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, معرف_المدمر) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(ق) -> { المدمر := ق.الدالة; };
        }
        | اختياري.لا_شيء -> { };
        ليكن الحقول: متغير متجه مرجع_قيمة_إل_إل_في_إم = [
            قيد_الدالة.الدالة,
            ثابت_صفر_إل_إل_في_إم(نوع_الحشو),
            ثابت_صحيح_إل_إل_في_إم(نوع_العداد, عداد_بيئة_إغلاق_ساكنة_مسير() مثل ط64, خطأ),
            المدمر,
            ثابت_صفر_إل_إل_في_إم(نوع_الحشو)
        ];
        ليكن التهيئة: مرجع_قيمة_إل_إل_في_إم = ثابت_بنية_إل_إل_في_إم((*الحالة).السياق, &متغير الحقول[0], 5);
        ليكن الاسم_الخام: متجه ط8 = اسم_بيئة_إغلاق_ساكنة_إل_إل_في_إم((*البيئة).الدالة.القيمة مثل طبيعي);
        ليكن الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
        ليكن العام: مرجع_قيمة_إل_إل_في_إم = أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_قيمة_إل_إل_في_إم(التهيئة),
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم));
        إذا (!يطابق_اسم_قيمة_إل_إل_في_إم(العام, &الاسم_الخام)) {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(انسخ_بايتات_إل_إل_في_إم(&الاسم_الخام)));
        };
        ضع_تهيئة_عام_إل_إل_في_إم(العام, التهيئة);
        // Writable: retain and release update the count atomically.
        ضع_ثبات_عام_إل_إل_في_إم(العام, خطأ);
        ضع_محاذاة_قيمة_إل_إل_في_إم(العام, 8);
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف أعلن_وحدة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: &اختياري معرف_دالة_مسير,
    الدوال_المطلوبة: &متجه منطقي
): اختياري فشل_مزود_إل_إل_في_إم {
    // MSIR represents module initialization by exactly one of two routes:
    // an entry-prelude call for executables, or a loader constructor for
    // standalone objects. Never register the latter for an executable:
    // it could run before the process start and repeat the entry-prelude call.
    طابق (*المسير).المسير.دالة_تهيئة_الوحدة مع
    | اختياري.موجود(_) -> {
        طابق (*المسير).المسير.دالة_بدء_البرنامج مع
        | اختياري.موجود(_) -> {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        }
        | اختياري.لا_شيء -> { };
        طابق *دالة_الدخول مع
        | اختياري.موجود(_) -> {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    (*الحالة).مزودات_تخصيص_الذاكرة := (*المسير).المسير.مزودات_تخصيص_الذاكرة;
    // Only the functions selected by the shared MSIR reachability query are
    // declared and lowered (all of them for objects; the entry closure for
    // executables, exactly like the native provider).
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المعرف) -> {
            إذا (دالة_إل_إل_في_إم_مطلوبة(الدوال_المطلوبة, المعرف)) {
                طابق ابحث_دالة_مسير(المسير, المعرف) مع
                | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); }
                | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> {
                    طابق أعلن_دالة_سلطان_إل_إل_في_إم(
                        الحالة, المسير, الحقائق, الهدف, سجل_التخطيط, دالة_الدخول, &العرض
                    ) مع
                    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*المسير).المسير.الدوال_الخارجية) مثل طبيعي)) {
        ليكن د: &دالة_خارجية_مسير = &(*المسير).المسير.الدوال_الخارجية[ف];
        // A call shape at an address declares no symbol (ابن_نداء_شكل_عنوان_إل_إل_في_إم).
        إذا (!(*د).عند_عنوان) {
            طابق أعلن_دالة_خارجية_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, د) مع
            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*المسير).المسير.العوام) مثل طبيعي)) {
        ليكن ع: &عام_مسير = &(*المسير).المسير.العوام[ف];
        ليكن العام: مرجع_قيمة_إل_إل_في_إم;
        طابق (*ع).الاسم_الخارجي مع
        | اختياري.موجود(اسم_الربط) -> {
            // LLVMAddGlobal without an initializer declares external data storage.
            // It is NOT an external function and must not receive LLVMSetInitializer.
            ليكن القيد: قيد_نوع_إل_إل_في_إم;
            طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*ع).النوع) مع
            | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_إل_إل_في_إم.نجح(القيمة) -> { القيد := القيمة; };
            ليكن الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_الربط);
            العام := أضف_عام_إل_إل_في_إم(
                (*الحالة).الوحدة, القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم)
            );
            // Do not let LLVM silently turn an imported linker name into
            // name.1 when it collides with a previously emitted symbol.
            إذا (!يطابق_اسم_قيمة_إل_إل_في_إم(العام, &اسم_الربط)) {
                أرجع اختياري.موجود(
                    فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(
                        انسخ_بايتات_إل_إل_في_إم(&اسم_الربط)
                    )
                );
            };
            ليكن التخطيط: واصف_تخطيط;
            طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, (*ع).النوع) مع
            | نتيجة_تخطيط.مؤجل(_) -> {
                أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل((*ع).النوع));
            }
            | نتيجة_تخطيط.مرفوض(_) -> {
                أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض((*ع).النوع));
            }
            | نتيجة_تخطيط.مكتمل(القيمة) -> { التخطيط := القيمة; };
            ضع_محاذاة_قيمة_إل_إل_في_إم(العام, التخطيط.المحاذاة مثل ط32);
            // This is only a declaration. Its external owner may initialize
            // even a source-readonly value, so never mark it LLVM constant.
        }
        | اختياري.لا_شيء -> {
            طابق (*ع).التهيئة مع
            | ثابت_مسير.نص(البايتات) -> {
                طابق أعلن_عام_نص_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, ع, &البايتات) مع
                | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                | نتيجة.نجح(ق) -> { العام := ق; };
            }
            | ثابت_مسير.متجه(العناصر) -> {
                طابق أعلن_عام_متجه_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, ع, &العناصر) مع
                | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                | نتيجة.نجح(ق) -> { العام := ق; };
            }
            | _ -> {
                ليكن قيد_النوع: قيد_نوع_إل_إل_في_إم;
                طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*ع).النوع) مع
                | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد_النوع := ق; };
                // Other aggregate forms require an explicit supported constant layout.
                // Do not pass opaque storage as a scalar initializer.
                إذا (قيد_النوع.تجميعي) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*ع).النوع)); };
                ليكن الاسم_الخام: متجه ط8 = اسم_عام_إل_إل_في_إم((*ع).المعرف.القيمة);
                ليكن الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
                العام := أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, قيد_النوع.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
                    الاسم));
                طابق ثابت_تهيئة_عام_إل_إل_في_إم(الحالة, الحقائق, &قيد_النوع, &(*ع).التهيئة) مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*ع).النوع)); }
                | اختياري.موجود(قيمة) -> { ضع_تهيئة_عام_إل_إل_في_إم(العام, قيمة); };
                ضع_ثبات_عام_إل_إل_في_إم(العام, !(*ع).قابل_للكتابة);
                // Match Native's canonical target layout rather than relying on
                // the LLVM module's implicit alignment for scalar globals.
                ليكن تخطيط_العام: واصف_تخطيط;
                طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, (*ع).النوع) مع
                | نتيجة_تخطيط.مؤجل(_) -> {
                    أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل((*ع).النوع));
                }
                | نتيجة_تخطيط.مرفوض(_) -> {
                    أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض((*ع).النوع));
                }
                | نتيجة_تخطيط.مكتمل(التخطيط) -> { تخطيط_العام := التخطيط; };
                ضع_محاذاة_قيمة_إل_إل_في_إم(العام, تخطيط_العام.المحاذاة مثل ط32);
            };
        };
        ليكن موضع_العام: طبيعي = (*ع).المعرف.القيمة;
        طالما ((الطول((*الحالة).العوام) مثل طبيعي) <= موضع_العام) { ألحق((*الحالة).العوام, اختياري.لا_شيء());
        }
        ليكن قيد: قيد_عام_إل_إل_في_إم = { المعرف: (*ع).المعرف, القيمة: العام, النوع: (*ع).النوع };
        (*الحالة).العوام[موضع_العام] := اختياري.موجود(قيد);
        ف := ف + 1;
    }
    طابق أعلن_بيئات_إغلاق_ساكنة_إل_إل_في_إم(الحالة, المسير, الهدف) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    طابق أعلن_منشئ_وحدة_إل_إل_في_إم(الحالة, المسير) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}
