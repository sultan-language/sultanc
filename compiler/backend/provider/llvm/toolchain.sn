// LLVM provider owns discovery of the LLVM implementation the running
// compiler is linked with (its "host toolchain" LLVM, in the build/host/target
// terms of LLVM's cross-compilation guide). These are facts about the host
// that runs this compiler, never about the target of the code it generates:
//
// - The location is the file the host's loader mapped (Linux /proc/self/maps,
//   Darwin dladdr). The Driver records it in the link plan together with the
//   compiler's registered host target, and the LLVM link-dependency resolver
//   (link/dependency/llvm.sn) uses it only for outputs whose target IS that
//   host target, by ingesting that very file as a dynamic-library input; an
//   output for any other target needs the target's own libLLVM as an explicit
//   link input, as with Clang/LLD and a target sysroot.
// - A compiler built for a WASI host links no libLLVM and has no host LLVM:
//   no location. It never carries facts of the compiler that built it. Previously the toolchain primitives recorded the builder's
//   libLLVM path and version into the WASI compiler, which then wrote that
//   builder library (for example a macOS `libLLVM.23.1.dylib`) into the
//   dynamic section of executables it linked for Linux.
// The non-WASI hosts bind the LLVM C API (Darwin's discovery below asks the
// loader which image holds LLVM's global context).
لو (الهدف.المنصة != «wasi») {
    استورد compiler.backend.provider.llvm.ffi.core;
    استورد compiler.backend.provider.llvm.ffi.types;
}

// Linux: the kernel's own map of this process (/proc/self/maps) names the
// loaded monolithic libLLVM; no C library call is involved.
لو (الهدف.المنصة == «linux») {
    استورد std.fs.read_file;

    // libLLVM followed by '-' (libLLVM-20.so) or '.' (libLLVM.so.20.1), as a
    // shared object: component libraries (libLLVMCore.so) never match.
    عرف اسم_مكتبة_إل_إل_في_إم_أحادية(الاسم: &متجه غ8): منطقي {
        دع البادئة: نص = «libLLVM»;
        دع اللاحقة: نص = «.so»;
        دع طول_البادئة: غير_موقع = الطول(البادئة) مثل غير_موقع;
        دع الطول_الكلي: غير_موقع = الطول(*الاسم) مثل غير_موقع;
        لو (الطول_الكلي <= طول_البادئة) { أرجع خطأ; };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < طول_البادئة) {
            لو ((*الاسم)[ف] != البادئة[ف]) { أرجع خطأ; };
            ف := ف + 1;
        }
        دع الفاصلان: نص = «-.»;
        دع التالي: غ8 = (*الاسم)[طول_البادئة];
        لو (التالي != الفاصلان[0] && التالي != الفاصلان[1]) { أرجع خطأ; };
        دع طول_اللاحقة: غير_موقع = الطول(اللاحقة) مثل غير_موقع;
        دع م: متغير غير_موقع = طول_البادئة;
        بينما (م + طول_اللاحقة <= الطول_الكلي) {
            دع يطابق: متغير منطقي = صواب;
            دع ح: متغير غير_موقع = 0;
            بينما (ح < طول_اللاحقة) {
                لو ((*الاسم)[م + ح] != اللاحقة[ح]) { يطابق := خطأ; };
                ح := ح + 1;
            }
            لو (يطابق) { أرجع صواب; };
            م := م + 1;
        }
        أرجع خطأ;
    }

    عام عرف مسار_مكتبة_إل_إل_في_إم_الحالي(): اختيار متجه غ8 {
        دع مسار_الخريطة: نص = «/proc/self/maps»;
        دع الفاصل: غ8 = مسار_الخريطة[0];
        دع الخريطة: متجه غ8;
        طابق اقرأ_بايتات_ملف(&مسار_الخريطة) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(البايتات) -> { الخريطة := البايتات; };
        دع الطول_الكلي: غير_موقع = الطول(الخريطة) مثل غير_موقع;
        دع بداية_السطر: متغير غير_موقع = 0;
        بينما (بداية_السطر < الطول_الكلي) {
            دع نهاية_السطر: متغير غير_موقع = بداية_السطر;
            بينما (نهاية_السطر < الطول_الكلي && الخريطة[نهاية_السطر] != 0x0A) {
                نهاية_السطر := نهاية_السطر + 1;
            }
            // The path field is the rest of the line from its first '/'.
            دع بداية_المسار: متغير غير_موقع = بداية_السطر;
            بينما (بداية_المسار < نهاية_السطر && الخريطة[بداية_المسار] != الفاصل) {
                بداية_المسار := بداية_المسار + 1;
            }
            لو (بداية_المسار < نهاية_السطر) {
                دع آخر_فاصل: متغير غير_موقع = بداية_المسار;
                دع ف: متغير غير_موقع = بداية_المسار;
                بينما (ف < نهاية_السطر) {
                    لو (الخريطة[ف] == الفاصل) { آخر_فاصل := ف; };
                    ف := ف + 1;
                }
                دع الاسم: متغير متجه غ8 = [];
                ف := آخر_فاصل + 1;
                بينما (ف < نهاية_السطر) { ألحق(الاسم, الخريطة[ف]); ف := ف + 1; }
                لو (اسم_مكتبة_إل_إل_في_إم_أحادية(&الاسم)) {
                    دع المسار: متغير متجه غ8 = [];
                    ف := بداية_المسار;
                    بينما (ف < نهاية_السطر) { ألحق(المسار, الخريطة[ف]); ف := ف + 1; }
                    أرجع اختيار.بعض(المسار);
                };
            };
            بداية_السطر := نهاية_السطر + 1;
        }
        أرجع اختيار.لا_شيء();
    }
}

// Windows: outputs for Windows import LLVM-C.dll by name
// (runtime_symbol_query_context.sn مكتبة_إل_إل_في_إم_باسم_للهدف), so the
// linker never reads the host library file and no location is recorded.
// Previously Windows fell into the Darwin block below and referenced dladdr,
// which no Windows DLL exports.
لو (الهدف.المنصة == «windows») {
    عام عرف مسار_مكتبة_إل_إل_في_إم_الحالي(): اختيار متجه غ8 {
        أرجع اختيار.لا_شيء();
    }
}

// Other hosts: the dynamic loader of the system interface (Darwin's dyld in
// libSystem) reports the image that holds LLVM's global context.
لو (الهدف.المنصة != «wasi» && الهدف.المنصة != «linux» && الهدف.المنصة != «windows») {
    استورد std.os.platform.unix.apple.darwin.dynamic_loader;

    عام عرف مسار_مكتبة_إل_إل_في_إم_الحالي(): اختيار متجه غ8 {
        دع حارس_مؤشر: متغير غ8 = 0;
        دع المعلومات: متغير معلومات_عنوان_محمل_ديناميكي = {
            اسم_الملف: &متغير حارس_مؤشر,
            قاعدة: &متغير حارس_مؤشر,
            اسم_الرمز: &متغير حارس_مؤشر,
            عنوان_الرمز: &متغير حارس_مؤشر
        };
        دع السياق_العالمي: مرجع_سياق_إل_إل_في_إم = LLVMGetGlobalContext();
        لو (ابحث_معلومات_عنوان_ديناميكي(
            السياق_العالمي,
            &متغير المعلومات
        ) == 0) {
            أرجع اختيار.لا_شيء();
        };

        دع المسار: متجه غ8 = انسخ_نص_سي_من_محمل_ديناميكي(
            المعلومات.اسم_الملف
        );
        أرجع اختيار.بعض(المسار);
    }
}

لو (الهدف.المنصة == «wasi») {
    // A WASI host has no libLLVM (see above).
    عام عرف مسار_مكتبة_إل_إل_في_إم_الحالي(): اختيار متجه غ8 {
        أرجع اختيار.لا_شيء();
    }
}
