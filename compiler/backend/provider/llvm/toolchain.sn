استورد compiler.runtime.toolchain_facts;

// LLVM provider owns discovery of the LLVM ABI used by this compiler toolchain.
// The linker receives this as explicit plan metadata and never inspects the host
// process or asks LLVM for its version during dependency resolution.
عام نوع بيانات_أداة_إل_إل_في_إم = {
    الإصدار_الكبير: غير_موقع,
    الإصدار_الصغير: غير_موقع,
    إصدار_الرقعة: غير_موقع
};

// The running compiler reports the libLLVM it is linked with. A compiler
// built for a WASI host links no LLVM and cannot discover one: it reports the
// facts of the compiler that built it, which MSIR lowering recorded as
// compile-time constants (runtime/toolchain_facts.sn). Previously a WASI
// compiler reported major version 0 and no location, so every executable it
// linked against libLLVM (the compiler itself) failed with
// link.missing-toolchain-metadata.

// Splits the absolute path of the loaded libLLVM into its directory and
// file name.
عرف قسم_مسار_مكتبة_إل_إل_في_إم(
    المسار: &متجه غ8,
    اسم_المكتبة: &متغير اختيار متجه غ8,
    دليل_البحث: &متغير اختيار متجه غ8
): منطقي {
    دع الطول_الكلي: غير_موقع = الطول(*المسار) مثل غير_موقع;
    لو (الطول_الكلي == 0) {
        أرجع خطأ;
    };

    دع موضع_الفاصل: متغير غير_موقع = الطول_الكلي;
    دع الفهرس: متغير غير_موقع = الطول_الكلي;
    بينما (الفهرس > 0 && موضع_الفاصل == الطول_الكلي) {
        دع الحالي: غير_موقع = الفهرس - 1;
        لو ((*المسار)[الحالي] == 0x2F) {
            موضع_الفاصل := الحالي;
        };
        الفهرس := الحالي;
    }
    لو (موضع_الفاصل == الطول_الكلي || موضع_الفاصل + 1 >= الطول_الكلي) {
        أرجع خطأ;
    };

    دع الدليل: متغير متجه غ8 = [];
    دع الاسم: متغير متجه غ8 = [];
    دع موضع_البايت: متغير غير_موقع = 0;
    بينما (موضع_البايت < موضع_الفاصل) {
        ألحق(الدليل, (*المسار)[موضع_البايت]);
        موضع_البايت := موضع_البايت + 1;
    }
    لو ((الطول(الدليل) مثل غير_موقع) == 0) {
        ألحق(الدليل, 0x2F);
    };
    موضع_البايت := موضع_الفاصل + 1;
    بينما (موضع_البايت < الطول_الكلي) {
        ألحق(الاسم, (*المسار)[موضع_البايت]);
        موضع_البايت := موضع_البايت + 1;
    }

    *اسم_المكتبة := اختيار.بعض(الاسم);
    *دليل_البحث := اختيار.بعض(الدليل);
    أرجع صواب;
}


// The location of the libLLVM this compiler uses, split into file name and
// directory for the link plan.
عام عرف اكتشف_موقع_مكتبة_إل_إل_في_إم_الحالية(
    اسم_المكتبة: &متغير اختيار متجه غ8,
    دليل_البحث: &متغير اختيار متجه غ8
): منطقي {
    طابق مسار_مكتبة_إل_إل_في_إم_الحالي() مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المسار) -> {
        أرجع قسم_مسار_مكتبة_إل_إل_في_إم(&المسار, اسم_المكتبة, دليل_البحث);
    };
}

// The facts MSIR lowering records for a program compiled by this compiler
// (the toolchain primitives). Empty when this compiler uses no LLVM.
عام عرف حقائق_أداة_مترجم_الحالية(): حقائق_أداة_مترجم {
    دع الحقائق: متغير حقائق_أداة_مترجم = حقائق_أداة_مترجم_فارغة();
    دع البيانات: بيانات_أداة_إل_إل_في_إم = بيانات_أداة_إل_إل_في_إم_الحالية();
    لو (البيانات.الإصدار_الكبير == 0) { أرجع الحقائق; };
    الحقائق.إصدار_إل_إل_في_إم_الكبير := البيانات.الإصدار_الكبير;
    طابق مسار_مكتبة_إل_إل_في_إم_الحالي() مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المسار) -> { الحقائق.مسار_مكتبة_إل_إل_في_إم := المسار; };
    أرجع الحقائق;
}

لو (الهدف.المنصة != «wasi») {
    استورد compiler.backend.provider.llvm.ffi.core;
    استورد compiler.backend.provider.llvm.ffi.types;

    عام عرف بيانات_أداة_إل_إل_في_إم_الحالية(): بيانات_أداة_إل_إل_في_إم {
        دع الكبير: متغير غ32 = 0;
        دع الصغير: متغير غ32 = 0;
        دع الرقعة: متغير غ32 = 0;
        اقرأ_إصدار_إل_إل_في_إم(
            &متغير الكبير,
            &متغير الصغير,
            &متغير الرقعة
        );
        دع البيانات: بيانات_أداة_إل_إل_في_إم = {
            الإصدار_الكبير: الكبير مثل غير_موقع,
            الإصدار_الصغير: الصغير مثل غير_موقع,
            إصدار_الرقعة: الرقعة مثل غير_موقع
        };
        أرجع البيانات;
    }
}

// Linux: the kernel's own map of this process (/proc/self/maps) names the
// loaded monolithic libLLVM; no C library call is involved.
لو (الهدف.المنصة == «linux») {
    استورد std.fs.read_file;

    // libLLVM followed by '-' (libLLVM-20.so) or '.' (libLLVM.so.20.1), as a
    // shared object: component libraries (libLLVMCore.so) never match.
    عرف اسم_مكتبة_إل_إل_في_إم_أحادية(الاسم: &متجه غ8): منطقي {
        دع البادئة: نص = «libLLVM»;
        دع اللاحقة: نص = «.so»;
        دع طول_البادئة: غير_موقع = الطول(البادئة) مثل غير_موقع;
        دع الطول_الكلي: غير_موقع = الطول(*الاسم) مثل غير_موقع;
        لو (الطول_الكلي <= طول_البادئة) { أرجع خطأ; };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < طول_البادئة) {
            لو ((*الاسم)[ف] != البادئة[ف]) { أرجع خطأ; };
            ف := ف + 1;
        }
        دع الفاصلان: نص = «-.»;
        دع التالي: غ8 = (*الاسم)[طول_البادئة];
        لو (التالي != الفاصلان[0] && التالي != الفاصلان[1]) { أرجع خطأ; };
        دع طول_اللاحقة: غير_موقع = الطول(اللاحقة) مثل غير_موقع;
        دع م: متغير غير_موقع = طول_البادئة;
        بينما (م + طول_اللاحقة <= الطول_الكلي) {
            دع يطابق: متغير منطقي = صواب;
            دع ح: متغير غير_موقع = 0;
            بينما (ح < طول_اللاحقة) {
                لو ((*الاسم)[م + ح] != اللاحقة[ح]) { يطابق := خطأ; };
                ح := ح + 1;
            }
            لو (يطابق) { أرجع صواب; };
            م := م + 1;
        }
        أرجع خطأ;
    }

    عام عرف مسار_مكتبة_إل_إل_في_إم_الحالي(): اختيار متجه غ8 {
        دع مسار_الخريطة: نص = «/proc/self/maps»;
        دع الفاصل: غ8 = مسار_الخريطة[0];
        دع الخريطة: متجه غ8;
        طابق اقرأ_بايتات_ملف(&مسار_الخريطة) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة.نجح(البايتات) -> { الخريطة := البايتات; };
        دع الطول_الكلي: غير_موقع = الطول(الخريطة) مثل غير_موقع;
        دع بداية_السطر: متغير غير_موقع = 0;
        بينما (بداية_السطر < الطول_الكلي) {
            دع نهاية_السطر: متغير غير_موقع = بداية_السطر;
            بينما (نهاية_السطر < الطول_الكلي && الخريطة[نهاية_السطر] != 0x0A) {
                نهاية_السطر := نهاية_السطر + 1;
            }
            // The path field is the rest of the line from its first '/'.
            دع بداية_المسار: متغير غير_موقع = بداية_السطر;
            بينما (بداية_المسار < نهاية_السطر && الخريطة[بداية_المسار] != الفاصل) {
                بداية_المسار := بداية_المسار + 1;
            }
            لو (بداية_المسار < نهاية_السطر) {
                دع آخر_فاصل: متغير غير_موقع = بداية_المسار;
                دع ف: متغير غير_موقع = بداية_المسار;
                بينما (ف < نهاية_السطر) {
                    لو (الخريطة[ف] == الفاصل) { آخر_فاصل := ف; };
                    ف := ف + 1;
                }
                دع الاسم: متغير متجه غ8 = [];
                ف := آخر_فاصل + 1;
                بينما (ف < نهاية_السطر) { ألحق(الاسم, الخريطة[ف]); ف := ف + 1; }
                لو (اسم_مكتبة_إل_إل_في_إم_أحادية(&الاسم)) {
                    دع المسار: متغير متجه غ8 = [];
                    ف := بداية_المسار;
                    بينما (ف < نهاية_السطر) { ألحق(المسار, الخريطة[ف]); ف := ف + 1; }
                    أرجع اختيار.بعض(المسار);
                };
            };
            بداية_السطر := نهاية_السطر + 1;
        }
        أرجع اختيار.لا_شيء();
    }
}

// Other hosts: the dynamic loader of the system interface (Darwin's dyld in
// libSystem) reports the image that holds LLVM's global context.
لو (الهدف.المنصة != «wasi» && الهدف.المنصة != «linux») {
    استورد compiler.link.dependency.ffi.dynamic_loader;

    عام عرف مسار_مكتبة_إل_إل_في_إم_الحالي(): اختيار متجه غ8 {
        دع حارس_مؤشر: متغير غ8 = 0;
        دع المعلومات: متغير معلومات_عنوان_محمل_ديناميكي = {
            اسم_الملف: &متغير حارس_مؤشر,
            قاعدة: &متغير حارس_مؤشر,
            اسم_الرمز: &متغير حارس_مؤشر,
            عنوان_الرمز: &متغير حارس_مؤشر
        };
        دع السياق_العالمي: مرجع_سياق_إل_إل_في_إم = LLVMGetGlobalContext();
        لو (ابحث_معلومات_عنوان_ديناميكي(
            السياق_العالمي,
            &متغير المعلومات
        ) == 0) {
            أرجع اختيار.لا_شيء();
        };

        دع المسار: متجه غ8 = انسخ_نص_سي_من_محمل_ديناميكي(
            المعلومات.اسم_الملف
        );
        أرجع اختيار.بعض(المسار);
    }
}

لو (الهدف.المنصة == «wasi») {
    // The recorded facts of the compiler that built this one (see above).
    استورد compiler.backend.provider.llvm.recorded_toolchain;

    عام عرف مسار_مكتبة_إل_إل_في_إم_الحالي(): اختيار متجه غ8 {
        دع المسار: نص = مسار_مكتبة_إل_إل_في_إم_المسجل();
        لو ((الطول(المسار) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
        دع البايتات: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المسار) مثل غير_موقع)) {
            ألحق(البايتات, المسار[ف]);
            ف := ف + 1;
        }
        أرجع اختيار.بعض(البايتات);
    }

    عام عرف بيانات_أداة_إل_إل_في_إم_الحالية(): بيانات_أداة_إل_إل_في_إم {
        دع الكبير: غ32 = إصدار_إل_إل_في_إم_المسجل();
        دع البيانات: بيانات_أداة_إل_إل_في_إم = {
            الإصدار_الكبير: الكبير مثل غير_موقع, الإصدار_الصغير: 0, إصدار_الرقعة: 0
        };
        أرجع البيانات;
    }
}
