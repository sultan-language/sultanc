استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.link.dependency.ffi.dynamic_loader;

// LLVM provider owns discovery of the LLVM ABI used by this compiler toolchain.
// The linker receives this as explicit plan metadata and never inspects the host
// process or asks LLVM for its version during dependency resolution.
عام نوع بيانات_أداة_إل_إل_في_إم = {
    الإصدار_الكبير: غير_موقع,
    الإصدار_الصغير: غير_موقع,
    إصدار_الرقعة: غير_موقع
};


عام عرف اكتشف_موقع_مكتبة_إل_إل_في_إم_الحالية(
    اسم_المكتبة: &متغير اختيار متجه غ8,
    دليل_البحث: &متغير اختيار متجه غ8
): منطقي {
    دع حارس_مؤشر: متغير غ8 = 0;
    دع المعلومات: متغير معلومات_عنوان_محمل_ديناميكي = {
        اسم_الملف: &متغير حارس_مؤشر,
        قاعدة: &متغير حارس_مؤشر,
        اسم_الرمز: &متغير حارس_مؤشر,
        عنوان_الرمز: &متغير حارس_مؤشر
    };
    دع السياق_العالمي: مرجع_سياق_إل_إل_في_إم = LLVMGetGlobalContext();
    لو (ابحث_معلومات_عنوان_ديناميكي(
        السياق_العالمي,
        &متغير المعلومات
    ) == 0) {
        أرجع خطأ;
    };

    دع المسار: متجه غ8 = انسخ_نص_سي_من_محمل_ديناميكي(
        المعلومات.اسم_الملف
    );
    دع الطول_الكلي: غير_موقع = الطول(المسار) مثل غير_موقع;
    لو (الطول_الكلي == 0) {
        أرجع خطأ;
    };

    دع موضع_الفاصل: متغير غير_موقع = الطول_الكلي;
    دع الفهرس: متغير غير_موقع = الطول_الكلي;
    بينما (الفهرس > 0 && موضع_الفاصل == الطول_الكلي) {
        دع الحالي: غير_موقع = الفهرس - 1;
        لو (المسار[الحالي] == 0x2F) {
            موضع_الفاصل := الحالي;
        };
        الفهرس := الحالي;
    }
    لو (موضع_الفاصل == الطول_الكلي || موضع_الفاصل + 1 >= الطول_الكلي) {
        أرجع خطأ;
    };

    دع الدليل: متغير متجه غ8 = [];
    دع الاسم: متغير متجه غ8 = [];
    دع موضع_البايت: متغير غير_موقع = 0;
    بينما (موضع_البايت < موضع_الفاصل) {
        ألحق(الدليل, المسار[موضع_البايت]);
        موضع_البايت := موضع_البايت + 1;
    }
    لو ((الطول(الدليل) مثل غير_موقع) == 0) {
        ألحق(الدليل, 0x2F);
    };
    موضع_البايت := موضع_الفاصل + 1;
    بينما (موضع_البايت < الطول_الكلي) {
        ألحق(الاسم, المسار[موضع_البايت]);
        موضع_البايت := موضع_البايت + 1;
    }

    *اسم_المكتبة := اختيار.بعض(الاسم);
    *دليل_البحث := اختيار.بعض(الدليل);
    أرجع صواب;
}

عام عرف بيانات_أداة_إل_إل_في_إم_الحالية(): بيانات_أداة_إل_إل_في_إم {
    دع الكبير: متغير غ32 = 0;
    دع الصغير: متغير غ32 = 0;
    دع الرقعة: متغير غ32 = 0;
    اقرأ_إصدار_إل_إل_في_إم(
        &متغير الكبير,
        &متغير الصغير,
        &متغير الرقعة
    );
    دع البيانات: بيانات_أداة_إل_إل_في_إم = {
        الإصدار_الكبير: الكبير مثل غير_موقع,
        الإصدار_الصغير: الصغير مثل غير_موقع,
        إصدار_الرقعة: الرقعة مثل غير_موقع
    };
    أرجع البيانات;
}
