};

عام نوع حالة_دالة_إل_إل_في_إم = {
    المعرف: معرف_دالة_مسير,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    نوع_الدالة: مرجع_نوع_إل_إل_في_إم,
    الكتل: متجه مرجع_كتلة_إل_إل_في_إم,
    القيم: متجه اختيار تمثيل_قيمة_إل_إل_في_إم,
    فاي_الكتل: متجه متجه اختيار مرجع_قيمة_إل_إل_في_إم,
    بيئة_الإغلاق: اختيار مرجع_قيمة_إل_إل_في_إم,
    عنوان_الناتج_غير_المباشر: اختيار مرجع_قيمة_إل_إل_في_إم
};


