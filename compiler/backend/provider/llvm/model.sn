// حالة LLVM مؤقتة تخص مزود الخلفية فقط. لا تعيد امتلاك Type/MSIR/Target/Layout.
عام نوع تمثيل_قيمة_إل_إل_في_إم =
    | سلمية بنوع مرجع_قيمة_إل_إل_في_إم
    | عنوان بنوع مرجع_قيمة_إل_إل_في_إم
;

عام نوع قيد_نوع_إل_إل_في_إم = {
    النوع: معرف_نوع,
    التمثيل: مرجع_نوع_إل_إل_في_إم,
    تجميعي: منطقي
};

عام نوع قيد_دالة_إل_إل_في_إم = {
    المعرف: معرف_دالة_مسير,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    نوع_الدالة: مرجع_نوع_إل_إل_في_إم,
    غير_مباشر_الناتج: منطقي,
    عدد_معاملات_إل_إل_في_إم: غير_موقع,
    له_بيئة_إغلاق: منطقي
};

عام نوع قيد_دالة_خارجية_إل_إل_في_إم = {
    المعرف: معرف_دالة_خارجية_مسير,
    الاسم: متجه غ8,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    نوع_الدالة: مرجع_نوع_إل_إل_في_إم,
    غير_مباشر_الناتج: منطقي
};

عام نوع قيد_عام_إل_إل_في_إم = {
    المعرف: معرف_عام_مسير,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    النوع: معرف_نوع
};

عام نوع حالة_دالة_إل_إل_في_إم = {
    المعرف: معرف_دالة_مسير,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    نوع_الدالة: مرجع_نوع_إل_إل_في_إم,
    الكتل: متجه مرجع_كتلة_إل_إل_في_إم,
    القيم: متجه اختيار تمثيل_قيمة_إل_إل_في_إم,
    فاي_الكتل: متجه متجه اختيار مرجع_قيمة_إل_إل_في_إم,
    بيئة_الإغلاق: اختيار مرجع_قيمة_إل_إل_في_إم,
    عنوان_الناتج_غير_المباشر: اختيار مرجع_قيمة_إل_إل_في_إم
};


عام نوع تصريح_بدائي_نداء_إل_إل_في_إم = {
    الهوية: هوية_بدائي_مترجم,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    النوع: مرجع_نوع_إل_إل_في_إم
};


عام نوع حالة_مزود_إل_إل_في_إم = {
    السياق: مرجع_سياق_إل_إل_في_إم,
    الوحدة: مرجع_وحدة_إل_إل_في_إم,
    الباني: مرجع_بان_إل_إل_في_إم,
    باني_الحجز: مرجع_بان_إل_إل_في_إم,
    الهدف: مرجع_هدف_إل_إل_في_إم,
    آلة_الهدف: مرجع_آلة_هدف_إل_إل_في_إم,
    بيانات_الهدف: مرجع_بيانات_هدف_إل_إل_في_إم,
    الأنواع: متجه اختيار قيد_نوع_إل_إل_في_إم,
    الدوال: متجه اختيار قيد_دالة_إل_إل_في_إم,
    الدوال_الخارجية: متجه اختيار قيد_دالة_خارجية_إل_إل_في_إم,
    العوام: متجه اختيار قيد_عام_إل_إل_في_إم,
    بدائيات_التشغيل: متجه تصريح_بدائي_نداء_إل_إل_في_إم,
    // True when the target has no double-width integer multiply (WebAssembly):
    // LLVM legalizes llvm.*mul.with.overflow there into compiler-rt calls
    // (__multi3), which no SultanC link provides, so the checked product is
    // expanded with native division instead (lowering.sn).
    ضرب_التجاوز_بالقسمة: منطقي,
    // The program's std allocation-service providers (MSIR program fact), used
    // for storage services where the target has no C allocator (wasm32).
    مزودات_تخصيص_الذاكرة: اختيار مزودات_تخصيص_ذاكرة_مسير
};

عام نوع فشل_مزود_إل_إل_في_إم =
    | هدف_غير_مدعوم
    | خلفية_هدف_غير_متاحة بنوع متجه غ8
    | عدم_تطابق_حجم_المؤشر بنوع (غير_موقع, غير_موقع)
    | نوع_مفقود بنوع معرف_نوع
    | نوع_غير_مدعوم بنوع معرف_نوع
    | تخطيط_مؤجل بنوع معرف_نوع
    | تخطيط_مرفوض بنوع معرف_نوع
    | دالة_مفقودة بنوع معرف_دالة_مسير
    | دالة_خارجية_مفقودة بنوع معرف_دالة_خارجية_مسير
    | كتلة_مفقودة بنوع معرف_كتلة_مسير
    | قيمة_مفقودة بنوع معرف_قيمة_مسير
    | مكان_متوقع بنوع معرف_قيمة_مسير
    | قيمة_متوقعة بنوع معرف_قيمة_مسير
    | عام_مفقود بنوع معرف_عام_مسير
    | واجهة_ثنائية_غير_متاحة
    | بدائي_غير_مدعوم
    | عملية_مسير_غير_مدعومة
    | حافة_مسير_غير_صالحة
    | تحقق_إل_إل_في_إم_فشل بنوع متجه غ8
    | تحسين_إل_إل_في_إم_فشل بنوع متجه غ8
    | إصدار_مخرج_إل_إل_في_إم_فشل بنوع متجه غ8
    | تصحيح_إل_إل_في_إم_فشل
    // The target's declared machine output is assembly (e.g. NVPTX PTX, XCore),
    // so a binary object cannot be produced for it.
    | مخرج_كائن_غير_مدعوم
;


// Selection vector from compiler/msir/msir_consumer.sn
// (كل_دوال_مسير_مطلوبة / دوال_مسير_تنفيذية_مطلوبة), indexed by MSIR function id.
عام عرف دالة_إل_إل_في_إم_مطلوبة(
    المطلوبة: &متجه منطقي,
    المعرف: معرف_دالة_مسير
): منطقي {
    لو (المعرف.القيمة >= (الطول(*المطلوبة) مثل غير_موقع)) { أرجع خطأ; };
    أرجع (*المطلوبة)[المعرف.القيمة];
}

عام عرف ابحث_قيد_دالة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المعرف: معرف_دالة_مسير
): نتيجة قيد_دالة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    لو (المعرف.القيمة >= (الطول((*الحالة).الدوال) مثل غير_موقع)) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف));
    };
    طابق (*الحالة).الدوال[المعرف.القيمة] مع
    | اختيار.بعض(ق) -> { أرجع نتيجة.نجح(ق); }
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); };
}

عام عرف ابحث_قيد_دالة_خارجية_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المعرف: معرف_دالة_خارجية_مسير
): نتيجة قيد_دالة_خارجية_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    لو (المعرف.القيمة >= (الطول((*الحالة).الدوال_الخارجية) مثل غير_موقع)) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.دالة_خارجية_مفقودة(المعرف));
    };
    طابق (*الحالة).الدوال_الخارجية[المعرف.القيمة] مع
    | اختيار.بعض(ق) -> { أرجع نتيجة.نجح(ق); }
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.دالة_خارجية_مفقودة(المعرف)); };
}

عام نوع نوع_ناتج_مزود_إل_إل_في_إم =
    | كائن
    | تجميع
;

عام نوع ناتج_مزود_إل_إل_في_إم = {
    البايتات: متجه غ8,
    النوع: نوع_ناتج_مزود_إل_إل_في_إم,
    نص_الوحدة: اختيار متجه غ8,
    بيانات_الأداة: بيانات_أداة_إل_إل_في_إم
};

عام نوع نتيجة_مزود_إل_إل_في_إم =
    | نجح بنوع ناتج_مزود_إل_إل_في_إم
    | خطأ بنوع فشل_مزود_إل_إل_في_إم
;

عام نوع مستوى_تحسين_مزود_إل_إل_في_إم =
    | بلا
    | افتراضي
    | عال
;

// Code-placement policy belongs to the output/toolchain request, not to LLVM host state.
عام نوع سياسة_تموضع_شفرة_إل_إل_في_إم =
    | افتراضية
    | مستقلة_الموضع
;
