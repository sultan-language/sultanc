استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.msir.identifiers;
استورد compiler.backend.target.target_model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.runtime.primitive_runtime_abi;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.msir_model;
استورد std.text.from_bytes;

// The source may already have declared the executable's startup symbols as
// external data. Reuse the existing LLVM value so LLVMAddGlobal cannot rename
// a second definition and disconnect typed loads from startup stores.
عرف اسما_إقلاع_متساويان(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    لو ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أعلن_أو_أعد_استخدام_عام_إقلاع_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    اسم_الربط: &متجه ط8,
    النوع: مرجع_نوع_إل_إل_في_إم
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المسير).المسير.العوام) مثل طبيعي)) {
        دع العام: &عام_مسير = &(*المسير).المسير.العوام[ف];
        طابق (*العام).الاسم_الخارجي مع
        | اختياري.موجود(الاسم) -> {
            لو (اسما_إقلاع_متساويان(&الاسم, اسم_الربط)) {
                دع موضع: طبيعي = (*العام).المعرف.القيمة;
                لو (موضع < (الطول((*الحالة).العوام) مثل طبيعي)) {
                    طابق (*الحالة).العوام[موضع] مع
                    | اختياري.موجود(القيد) -> {
                        // A conflicting source-level external declaration must
                        // not be turned into a definition of the wrong LLVM type.
                        لو (LLVMGlobalGetValueType(القيد.القيمة) != النوع) {
                            أرجع نتيجة.خطأ(
                                فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم((*العام).النوع)
                            );
                        };
                        أرجع نتيجة.نجح(القيد.القيمة);
                    }
                    | اختياري.لا_شيء -> { };
                };
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(اسم_الربط);
    دع القيمة: مرجع_قيمة_إل_إل_في_إم = LLVMAddGlobal((*الحالة).الوحدة, النوع, &متغير الاسم[0]);
    لو (!يطابق_اسم_قيمة_إل_إل_في_إم(القيمة, اسم_الربط)) {
        أرجع نتيجة.خطأ(
            فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(
                انسخ_بايتات_إل_إل_في_إم(اسم_الربط)
            )
        );
    };
    أرجع نتيجة.نجح(القيمة);
}

// The process entry of an executable. SultanC links no C runtime, so nothing
// but this module and the OS calls into the program:
//   * Linux and FreeBSD: `main(argc, argv, envp)` below records the startup
//     globals and calls the language entry; the `_start` this provider emits
//     (أضف_بدء_عملية_لينكس_إل_إل_في_إم, أضف_بدء_عملية_فري_بي_إس_دي_إل_إل_في_إم)
//     reads the kernel's argument block and calls it;
//   * macOS: the same `main`, called by dyld through LC_MAIN;
//   * WASI and Windows: no startup arguments reach the entry (std reads them
//     from args_get or GetCommandLineW), so `_start` calls the language
//     entry and exits through the std provider (أضف_بدء_عملية_بلا_وسائط_إل_إل_في_إم).
// The language entry remains parameterless. Previously Windows, Android,
// FreeBSD and delegated Linux links entered through the C runtime's startup
// code (mainCRTStartup, __libc_start_main and their equivalents).
عام عرف أنشئ_مدخل_عملية_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    دالة_الدخول: &اختياري معرف_دالة_مسير,
    المسير: &سياق_مستهلك_مسير,
    بدء_عملية_ذاتي: منطقي
): اختياري فشل_مزود_إل_إل_في_إم {
    // Only Linux (SultanC's own `_start`) and macOS (dyld) pass the startup
    // arguments consumed below. Other targets get no such `main`: inventing a
    // foreign start signature would silently break their ABI.
    // Android runs SultanC's own `_start` on the Linux kernel ABI as well.
    دع بيئة_لينكس: منطقي = ((*الهدف).المنصة.المنصة == هوية_منصة.لينكس()
        && ((*الهدف).المنصة.البيئة == هوية_بيئة.جنو()
            || (*الهدف).المنصة.البيئة == هوية_بيئة.مسل()
            || (*الهدف).المنصة.البيئة == هوية_بيئة.إي_إيه_بي_آي_إتش_إف()))
        || (*الهدف).المنصة.المنصة == هوية_منصة.أندرويد();
    دع بيئة_داروين: منطقي = (*الهدف).المنصة.المنصة == هوية_منصة.ماك_أو_إس();
    // FreeBSD runs SultanC's own `_start` too (raw system calls, no libc).
    دع بيئة_فري_بي_إس_دي: منطقي = هدف_نواة_فري_بي_إس_دي_مباشر(الهدف);
    // A WASI command module's or a Windows executable's `_start` is emitted
    // here when SultanC owns the process start (a linked executable); their
    // other outputs keep the language entry named `_start` unchanged.
    دع بلا_وسائط_إقلاع: منطقي =
        (*الهدف).مزود_التشغيل == مزود_تشغيل_هدف.واسي()
            || ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.كوف()
                && (*الهدف).المنصة.المنصة == هوية_منصة.ويندوز());
    لو (بلا_وسائط_إقلاع) {
        لو (!بدء_عملية_ذاتي) { أرجع اختياري.لا_شيء(); };
        طابق أضف_بدء_عملية_بلا_وسائط_إل_إل_في_إم(الحالة, دالة_الدخول, المسير) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        لو ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.كوف()) {
            أرجع أضف_مسبار_مكدس_ويندوز_إل_إل_في_إم(الحالة, الهدف);
        };
        أرجع اختياري.لا_شيء();
    };
    لو (!بيئة_لينكس && !بيئة_داروين && !بيئة_فري_بي_إس_دي) { أرجع اختياري.لا_شيء(); };
    دع معرف_اللغة: معرف_دالة_مسير;
    طابق *دالة_الدخول مع
    | اختياري.موجود(المعرف) -> { معرف_اللغة := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    // The `main` wrapper may only rename the actual verified MSIR entry.
    // A driver-selected function is not sufficient evidence by itself.
    طابق (*المسير).المسير.دالة_بدء_البرنامج مع
    | اختياري.موجود(المعرف) -> {
        لو (المعرف.القيمة != معرف_اللغة.القيمة) {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع القيد: قيد_دالة_إل_إل_في_إم;
    طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, معرف_اللغة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(الدالة) -> { القيد := الدالة; };
    دع اسم_المدخل: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«main»);
    دع مدخل_اللغة: مرجع_قيمة_إل_إل_في_إم = القيد.الدالة;
    // main must be precisely the selected MSIR entry definition, not a
    // foreign declaration or a different function sharing its linker name.
    لو (LLVMGetNamedFunction((*الحالة).الوحدة, &متغير اسم_المدخل[0]) != مدخل_اللغة
        || LLVMCountBasicBlocks(مدخل_اللغة) == 0
        || LLVMGetFunctionCallConv(مدخل_اللغة) != 0
        || LLVMGlobalGetValueType(مدخل_اللغة) != القيد.نوع_الدالة
        || LLVMCountParamTypes(القيد.نوع_الدالة) != 0
        || LLVMIsFunctionVarArg(القيد.نوع_الدالة) != 0) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    دع عدد_صحيح32: مرجع_نوع_إل_إل_في_إم = LLVMInt32TypeInContext(السياق);
    دع نوع_الناتج_اللغة: مرجع_نوع_إل_إل_في_إم = LLVMGetReturnType(القيد.نوع_الدالة);
    لو (LLVMGetTypeKind(نوع_الناتج_اللغة) != 0
        && LLVMGetTypeKind(نوع_الناتج_اللغة) != LLVMGetTypeKind(عدد_صحيح32)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع اسم_الداخلي: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«sultanc.entry»);
    // Fail before renaming. LLVM otherwise silently chooses sultanc.entry.1
    // and can turn the new main into a second conflicting declaration.
    لو (LLVMGetNamedFunction((*الحالة).الوحدة, &متغير اسم_الداخلي[0]) != الفارغ
        || LLVMGetNamedGlobal((*الحالة).الوحدة, &متغير اسم_الداخلي[0]) != الفارغ) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    LLVMSetValueName2(مدخل_اللغة, &متغير اسم_الداخلي[0], (الطول(اسم_الداخلي) - 1) مثل طبيعي);
    دع اسم_الداخلي_الخام: متجه ط8 = بايتات_من_نص(«sultanc.entry»);
    لو (!يطابق_اسم_قيمة_إل_إل_في_إم(مدخل_اللغة, &اسم_الداخلي_الخام)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    LLVMSetLinkage(مدخل_اللغة, ربط_داخلي_إل_إل_في_إم());
    دع عدد_صحيح64: مرجع_نوع_إل_إل_في_إم = LLVMInt64TypeInContext(السياق);
    // The canonical runtime startup count is u64 even on 32-bit targets;
    // only argv and envp use the target's pointer width.
    دع نوع_المؤشر: مرجع_نوع_إل_إل_في_إم = LLVMPointerTypeInContext(السياق, 0);
    // SultanC's Linux `_start` and Darwin's dyld pass an explicit third envp
    // argument to main. dyld also passes an Apple-vector fourth argument.
    دع المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [عدد_صحيح32, نوع_المؤشر, نوع_المؤشر];
    لو (بيئة_داروين) { ألحق(المعاملات, نوع_المؤشر); };
    دع عدد_المعاملات: ط32 = الطول(المعاملات) مثل ط32;
    دع نوع_المدخل: مرجع_نوع_إل_إل_في_إم = LLVMFunctionType(
        عدد_صحيح32, &متغير المعاملات[0], عدد_المعاملات, 0
    );
    دع مدخل_النظام: مرجع_قيمة_إل_إل_في_إم = LLVMAddFunction(
        (*الحالة).الوحدة, &متغير اسم_المدخل[0], نوع_المدخل
    );
    دع اسم_المدخل_الخام: متجه ط8 = بايتات_من_نص(«main»);
    لو (!يطابق_اسم_قيمة_إل_إل_في_إم(مدخل_النظام, &اسم_المدخل_الخام)
        || LLVMGlobalGetValueType(مدخل_النظام) != نوع_المدخل) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع اسم_الكتلة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«entry»);
    دع الكتلة: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(
        السياق, مدخل_النظام, &متغير اسم_الكتلة[0]
    );
    دع الباني: مرجع_بان_إل_إل_في_إم = LLVMCreateBuilderInContext(السياق);
    LLVMPositionBuilderAtEnd(الباني, الكتلة);

    دع اسم_عدد_الوسائط_الخام: متجه ط8 = اسم_عدد_وسائط_إقلاع_أساسي();
    دع اسم_مؤشر_الوسائط_الخام: متجه ط8 = اسم_مؤشر_وسائط_إقلاع_أساسي();
    دع اسم_مؤشر_البيئة_الخام: متجه ط8 = اسم_مؤشر_بيئة_إقلاع_أساسي();
    دع عدد_الوسائط: مرجع_قيمة_إل_إل_في_إم;
    طابق أعلن_أو_أعد_استخدام_عام_إقلاع_إل_إل_في_إم(
        الحالة, المسير, &اسم_عدد_الوسائط_الخام, عدد_صحيح64
    ) مع
    | نتيجة.خطأ(الخطأ) -> { LLVMDisposeBuilder(الباني); أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(القيمة) -> { عدد_الوسائط := القيمة; };
    دع مؤشر_الوسائط: مرجع_قيمة_إل_إل_في_إم;
    طابق أعلن_أو_أعد_استخدام_عام_إقلاع_إل_إل_في_إم(
        الحالة, المسير, &اسم_مؤشر_الوسائط_الخام, نوع_المؤشر
    ) مع
    | نتيجة.خطأ(الخطأ) -> { LLVMDisposeBuilder(الباني); أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(القيمة) -> { مؤشر_الوسائط := القيمة; };
    دع مؤشر_البيئة: مرجع_قيمة_إل_إل_في_إم;
    طابق أعلن_أو_أعد_استخدام_عام_إقلاع_إل_إل_في_إم(
        الحالة, المسير, &اسم_مؤشر_البيئة_الخام, نوع_المؤشر
    ) مع
    | نتيجة.خطأ(الخطأ) -> { LLVMDisposeBuilder(الباني); أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(القيمة) -> { مؤشر_البيئة := القيمة; };
    دع محاذاة_المؤشر: ط32 = ((*الهدف).نموذج_البيانات.عرض_المؤشر / 8) مثل ط32;
    ضع_محاذاة_قيمة_إل_إل_في_إم(عدد_الوسائط, محاذاة_المؤشر);
    ضع_محاذاة_قيمة_إل_إل_في_إم(مؤشر_الوسائط, محاذاة_المؤشر);
    ضع_محاذاة_قيمة_إل_إل_في_إم(مؤشر_البيئة, محاذاة_المؤشر);
    // These are executable-owned process ABI definitions, not libc services.
    // On ELF the linker may select a strong definition from a native entry
    // object instead of these weak LLVM definitions.
    LLVMSetInitializer(عدد_الوسائط, LLVMConstInt(عدد_صحيح64, 0, 0));
    LLVMSetInitializer(مؤشر_الوسائط, LLVMConstNull(نوع_المؤشر));
    LLVMSetInitializer(مؤشر_البيئة, LLVMConstNull(نوع_المؤشر));
    // Darwin's executable owns these process globals directly. Weak definitions
    // can still be lowered into GOT_LOAD relocations even with hidden visibility;
    // the Mach-O static linker handles ordinary local PAGE21/PAGEOFF12 instead.
    لو ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.ماتشو()) {
        دع الظهور_المخفي: تعداد_إل_إل_في_إم = 1;
        LLVMSetVisibility(عدد_الوسائط, الظهور_المخفي);
        LLVMSetVisibility(مؤشر_الوسائط, الظهور_المخفي);
        LLVMSetVisibility(مؤشر_البيئة, الظهور_المخفي);
    } وإلا {
        دع الربط_الضعيف: تعداد_إل_إل_في_إم = ربط_ضعيف_إل_إل_في_إم();
        LLVMSetLinkage(عدد_الوسائط, الربط_الضعيف);
        LLVMSetLinkage(مؤشر_الوسائط, الربط_الضعيف);
        LLVMSetLinkage(مؤشر_البيئة, الربط_الضعيف);
    };

    دع اسم_فارغ: متغير متجه ط8 = [0];
    // argc includes argv[0]. Do not subtract one: that would discard the
    // process name and underflow when the kernel supplies an empty argv.
    دع عدد_الوسائط32: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(مدخل_النظام, 0);
    دع عدد_الوسائط64: مرجع_قيمة_إل_إل_في_إم = LLVMBuildZExt(
        الباني, عدد_الوسائط32, عدد_صحيح64, &متغير اسم_فارغ[0]
    );
    LLVMBuildStore(الباني, عدد_الوسائط64, عدد_الوسائط);
    دع متجه_الوسائط: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(مدخل_النظام, 1);
    LLVMBuildStore(الباني, متجه_الوسائط, مؤشر_الوسائط);

    // Preserve the actual process environment pointer supplied by the start.
    // Its lifetime covers main and the canonical language entry it invokes.
    دع بداية_البيئة: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(مدخل_النظام, 2);
    LLVMBuildStore(الباني, بداية_البيئة, مؤشر_البيئة);

    دع لا_معاملات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [مدخل_اللغة];
    // LLVMBuildCall2 ignores the arguments pointer when its count is zero.
    دع توقيع_اللغة: مرجع_نوع_إل_إل_في_إم = LLVMGlobalGetValueType(مدخل_اللغة);
    دع نوع_ناتج_اللغة: مرجع_نوع_إل_إل_في_إم = LLVMGetReturnType(توقيع_اللغة);
    دع الناتج: مرجع_قيمة_إل_إل_في_إم = LLVMBuildCall2(
        الباني, توقيع_اللغة, مدخل_اللغة,
        &متغير لا_معاملات[0], 0, &متغير اسم_فارغ[0]
    );
    دع نتيجة_الدخول: مرجع_قيمة_إل_إل_في_إم;
    لو (LLVMGetTypeKind(نوع_ناتج_اللغة) == 0) {
        // A void language entry exits successfully.
        نتيجة_الدخول := LLVMConstInt(عدد_صحيح32, 0, 0);
    } وإلا {
        دع العرض: ط32 = LLVMGetIntTypeWidth(نوع_ناتج_اللغة);
        لو (العرض > 32) {
            نتيجة_الدخول := LLVMBuildTrunc(
                الباني, الناتج, عدد_صحيح32, &متغير اسم_فارغ[0]
            );
        } وإلا لو (العرض < 32) {
            نتيجة_الدخول := LLVMBuildZExt(
                الباني, الناتج, عدد_صحيح32, &متغير اسم_فارغ[0]
            );
        } وإلا { نتيجة_الدخول := الناتج; };
    };
    LLVMBuildRet(الباني, نتيجة_الدخول);
    LLVMDisposeBuilder(الباني);
    لو (بدء_عملية_ذاتي && بيئة_لينكس) {
        أرجع أضف_بدء_عملية_لينكس_إل_إل_في_إم(الحالة, الهدف, المسير);
    };
    لو (بدء_عملية_ذاتي && بيئة_فري_بي_إس_دي) {
        أرجع أضف_بدء_عملية_فري_بي_إس_دي_إل_إل_في_إم(الحالة, الهدف, المسير);
    };
    أرجع اختياري.لا_شيء();
}

عرف ألحق_نص_تجميع_إل_إل_في_إم(الناتج: &متغير متجه ط8, النص: &نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        ألحق(*الناتج, (*النص)[ف] مثل ط8);
        ف := ف + 1;
    }
}

// Builds `void sultanc.process_exit(i32 status)`, which calls the STD
// process-exit provider (the MSIR program fact) through its LLVM function
// record. Shared by every process start the LLVM provider emits itself.
عرف أنشئ_جسر_خروج_عملية_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع معرف_الخروج: معرف_دالة_مسير;
    طابق (*المسير).المسير.دالة_خروج_العملية مع
    | اختياري.موجود(المعرف) -> { معرف_الخروج := المعرف; }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع قيد_الخروج: قيد_دالة_إل_إل_في_إم;
    طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, معرف_الخروج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيد) -> { قيد_الخروج := القيد; };
    // The provider is `اخرج_من_عملية_النظام(الرمز: عدد): فراغ`: one integer
    // after the optional environment pointer, no indirect result.
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    دع عدد_صحيح32: مرجع_نوع_إل_إل_في_إم = LLVMInt32TypeInContext(السياق);
    دع نوع_المؤشر: مرجع_نوع_إل_إل_في_إم = LLVMPointerTypeInContext(السياق, 0);
    دع فهرس_الرمز: متغير طبيعي = 0;
    لو (قيد_الخروج.له_بيئة_إغلاق) { فهرس_الرمز := 1; };
    لو (قيد_الخروج.غير_مباشر_الناتج
        || قيد_الخروج.عدد_معاملات_إل_إل_في_إم != (فهرس_الرمز + 1)
        || LLVMGetFunctionCallConv(قيد_الخروج.الدالة) != 0
        || LLVMIsFunctionVarArg(قيد_الخروج.نوع_الدالة) != 0
        || LLVMGetTypeKind(LLVMGetReturnType(قيد_الخروج.نوع_الدالة)) != 0) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع نوع_الرمز: مرجع_نوع_إل_إل_في_إم = LLVMTypeOf(
        LLVMGetParam(قيد_الخروج.الدالة, فهرس_الرمز مثل ط32)
    );
    لو (LLVMGetTypeKind(نوع_الرمز) != LLVMGetTypeKind(عدد_صحيح32)) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع اسم_الجسر_الخام: متجه ط8 = بايتات_من_نص(«sultanc.process_exit»);
    دع اسم_الجسر: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_الجسر_الخام);
    لو (LLVMGetNamedFunction((*الحالة).الوحدة, &متغير اسم_الجسر[0]) != الفارغ
        || LLVMGetNamedGlobal((*الحالة).الوحدة, &متغير اسم_الجسر[0]) != الفارغ) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع معاملات_الجسر: متغير متجه مرجع_نوع_إل_إل_في_إم = [عدد_صحيح32];
    دع توقيع_الجسر: مرجع_نوع_إل_إل_في_إم = LLVMFunctionType(
        LLVMVoidTypeInContext(السياق), &متغير معاملات_الجسر[0], 1, 0
    );
    دع الجسر: مرجع_قيمة_إل_إل_في_إم = LLVMAddFunction(
        (*الحالة).الوحدة, &متغير اسم_الجسر[0], توقيع_الجسر
    );
    لو (!يطابق_اسم_قيمة_إل_إل_في_إم(الجسر, &اسم_الجسر_الخام)) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    // Referenced only from the module assembly below: keep it external so no
    // pass can drop it, and hidden so it never enters a dynamic symbol table.
    دع الظهور_المخفي: تعداد_إل_إل_في_إم = 1;
    LLVMSetVisibility(الجسر, الظهور_المخفي);
    دع اسم_الكتلة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«entry»);
    دع الكتلة: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(
        السياق, الجسر, &متغير اسم_الكتلة[0]
    );
    دع الباني: مرجع_بان_إل_إل_في_إم = LLVMCreateBuilderInContext(السياق);
    LLVMPositionBuilderAtEnd(الباني, الكتلة);
    دع اسم_فارغ: متغير متجه ط8 = [0];
    دع الحالة_الخام: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(الجسر, 0);
    دع عرض_الرمز: ط32 = LLVMGetIntTypeWidth(نوع_الرمز);
    دع قيمة_الرمز: متغير مرجع_قيمة_إل_إل_في_إم = الحالة_الخام;
    // main's status is a C int: sign-extend it like the native entry does.
    لو (عرض_الرمز > 32) {
        قيمة_الرمز := LLVMBuildSExt(الباني, الحالة_الخام, نوع_الرمز, &متغير اسم_فارغ[0]);
    } وإلا لو (عرض_الرمز < 32) {
        قيمة_الرمز := LLVMBuildTrunc(الباني, الحالة_الخام, نوع_الرمز, &متغير اسم_فارغ[0]);
    };
    دع وسائط_الخروج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    لو (قيد_الخروج.له_بيئة_إغلاق) { ألحق(وسائط_الخروج, LLVMConstNull(نوع_المؤشر)); };
    ألحق(وسائط_الخروج, قيمة_الرمز);
    LLVMBuildCall2(
        الباني, قيد_الخروج.نوع_الدالة, قيد_الخروج.الدالة,
        &متغير وسائط_الخروج[0], (فهرس_الرمز + 1) مثل ط32, &متغير اسم_فارغ[0]
    );
    LLVMBuildUnreachable(الباني);
    LLVMDisposeBuilder(الباني);
    أرجع نتيجة.نجح(الجسر);
}

// Linux executables link no C runtime, so nothing else defines _start: the
// same role the native encoder fills with encoded instructions. The stub only
// recovers the kernel's initial stack (argc, argv, envp), runs the
// linker-owned .init_array range, calls the main above (which stores the startup globals and calls the language
// entry) and passes its i32 status to sultanc.process_exit. That LLVM function
// calls the STD process-exit provider (the program fact recorded by MSIR
// lowering) through its LLVM signature, so the provider's hidden closure-
// environment parameter and integer width come from the canonical function
// record instead of being restated in assembly. It never returns.
عرف أضف_بدء_عملية_لينكس_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    المسير: &سياق_مستهلك_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق أنشئ_جسر_خروج_عملية_إل_إل_في_إم(الحالة, المسير) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(_) -> { };
    دع النص: متغير متجه ط8 = [];
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        دع البداية: نص = «.text;.globl _start;.type _start,@function;_start:;xorl %ebp,%ebp;movq %rsp,%r12;movq (%r12),%r13;leaq 8(%r12),%r14;leaq 8(%r14,%r13,8),%r15;andq $-16,%rsp;leaq __init_array_start(%rip),%rbx;1:;leaq __init_array_end(%rip),%rax;cmpq %rax,%rbx;jae 2f;movq %r13,%rdi;movq %r14,%rsi;movq %r15,%rdx;callq *(%rbx);addq $8,%rbx;jmp 1b;2:;movq %r13,%rdi;movq %r14,%rsi;movq %r15,%rdx;callq main;movl %eax,%edi;callq sultanc.process_exit;ud2;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> {
        // cdecl: three stack arguments, the stack 16-byte aligned at each call.
        دع البداية: نص = «.text;.globl _start;.type _start,@function;_start:;xorl %ebp,%ebp;movl (%esp),%edi;leal 4(%esp),%esi;leal 4(%esi,%edi,4),%ebx;andl $-16,%esp;movl $__init_array_start,%ebp;1:;cmpl $__init_array_end,%ebp;jae 2f;subl $4,%esp;pushl %ebx;pushl %esi;pushl %edi;calll *(%ebp);addl $16,%esp;addl $4,%ebp;jmp 1b;2:;subl $4,%esp;pushl %ebx;pushl %esi;pushl %edi;calll main;movl %eax,(%esp);calll sultanc.process_exit;ud2;.size _start,.-_start»;
        ألحق_بايتات_نص(&متغير النص, البداية);
    }
    | هوية_معمارية.ذراع_سبعة -> {
        // A32 code (interworking bl/blx reaches Thumb functions); AAPCS keeps
        // r4-r8 across the calls.
        دع البداية: نص = «.text;.arm;.p2align 2;.globl _start;.type _start,%function;_start:;mov fp,#0;mov lr,#0;mov r4,sp;ldr r5,[r4];add r6,r4,#4;add r7,r6,r5,lsl #2;add r7,r7,#4;bic r0,r4,#15;mov sp,r0;movw r8,#:lower16:__init_array_start;movt r8,#:upper16:__init_array_start;1:;movw r9,#:lower16:__init_array_end;movt r9,#:upper16:__init_array_end;cmp r8,r9;bhs 2f;ldr r3,[r8],#4;mov r0,r5;mov r1,r6;mov r2,r7;blx r3;b 1b;2:;mov r0,r5;mov r1,r6;mov r2,r7;bl main;bl sultanc.process_exit;udf #0;.size _start,.-_start»;
        ألحق_بايتات_نص(&متغير النص, البداية);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        دع البداية: نص = «.text;.globl _start;.type _start,%function;_start:;mov x29,#0;mov x30,#0;mov x19,sp;ldr x20,[x19];add x21,x19,#8;add x22,x21,x20,lsl #3;add x22,x22,#8;adrp x23,__init_array_start;add x23,x23,:lo12:__init_array_start;1:;adrp x9,__init_array_end;add x9,x9,:lo12:__init_array_end;cmp x23,x9;b.hs 2f;ldr x10,[x23],#8;mov x0,x20;mov x1,x21;mov x2,x22;blr x10;b 1b;2:;mov x0,x20;mov x1,x21;mov x2,x22;bl main;bl sultanc.process_exit;brk #0;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> {
        دع البداية: نص = «.text;.globl _start;.type _start,@function;_start:;ld s1,0(sp);addi s2,sp,8;slli s3,s1,3;add s3,s3,s2;addi s3,s3,8;andi sp,sp,-16;lla s4,__init_array_start;1:;lla t0,__init_array_end;bgeu s4,t0,2f;ld t1,0(s4);mv a0,s1;mv a1,s2;mv a2,s3;jalr t1;addi s4,s4,8;j 1b;2:;mv a0,s1;mv a1,s2;mv a2,s3;call main;call sultanc.process_exit;unimp;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> {
        دع البداية: نص = «.text;.globl _start;.type _start,@function;_start:;ld.d $s0,$sp,0;addi.d $s1,$sp,8;slli.d $s2,$s0,3;add.d $s2,$s2,$s1;addi.d $s2,$s2,8;bstrins.d $sp,$zero,3,0;la.local $s3,__init_array_start;1:;la.local $t0,__init_array_end;bgeu $s3,$t0,2f;ld.d $t1,$s3,0;move $a0,$s0;move $a1,$s1;move $a2,$s2;jirl $ra,$t1,0;addi.d $s3,$s3,8;b 1b;2:;move $a0,$s0;move $a1,$s1;move $a2,$s2;bl main;bl sultanc.process_exit;break 0;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> {
        دع البداية: نص = «.text;.abiversion 2;.globl _start;.type _start,@function;_start:;bl 0f;0:;mflr 12;addis 2,12,(.TOC.-0b)@ha;addi 2,2,(.TOC.-0b)@l;mr 14,1;ld 15,0(14);addi 16,14,8;sldi 17,15,3;add 17,17,16;addi 17,17,8;clrrdi 1,1,4;li 0,0;stdu 0,-32(1);addis 18,2,__init_array_start@toc@ha;addi 18,18,__init_array_start@toc@l;1:;addis 19,2,__init_array_end@toc@ha;addi 19,19,__init_array_end@toc@l;cmpld 18,19;bge 2f;ld 12,0(18);mtctr 12;mr 3,15;mr 4,16;mr 5,17;bctrl;addi 18,18,8;b 1b;2:;mr 3,15;mr 4,16;mr 5,17;bl main;nop;bl sultanc.process_exit;nop;trap;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | هوية_معمارية.سيستم_زد -> {
        دع البداية: نص = «.text;.globl _start;.type _start,@function;_start:;lgr %r6,%r15;lg %r7,0(%r6);la %r8,8(%r6);sllg %r9,%r7,3;la %r9,8(%r9,%r8);aghi %r15,-160;nill %r15,65528;xc 0(8,%r15),0(%r15);larl %r10,__init_array_start;1:;larl %r1,__init_array_end;clgr %r10,%r1;jhe 2f;lg %r1,0(%r10);lgr %r2,%r7;lgr %r3,%r8;lgr %r4,%r9;basr %r14,%r1;aghi %r10,8;j 1b;2:;lgr %r2,%r7;lgr %r3,%r8;lgr %r4,%r9;brasl %r14,main;brasl %r14,sultanc.process_exit;.word 0;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | هوية_معمارية.ميبس_أربعة_وستون -> {
        دع البداية: نص = «.text;.globl _start;.type _start,@function;.ent _start;_start:;move $16,$sp;ld $17,0($16);daddiu $18,$16,8;dsll $19,$17,3;daddu $19,$19,$18;daddiu $19,$19,8;li $8,-16;and $sp,$sp,$8;dla $20,__init_array_start;1:;dla $8,__init_array_end;sltu $9,$20,$8;beqz $9,2f;ld $25,0($20);move $4,$17;move $5,$18;move $6,$19;jalr $25;daddiu $20,$20,8;b 1b;2:;move $4,$17;move $5,$18;move $6,$19;dla $25,main;jalr $25;move $4,$2;dla $25,sultanc.process_exit;jalr $25;break;.end _start;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | هوية_معمارية.سبارك_أربعة_وستون -> {
        دع البداية: نص = «.text;.globl _start;.type _start,@function;_start:;mov %g0,%fp;ldx [%sp+2175],%l0;add %sp,2183,%l1;sllx %l0,3,%l2;add %l2,%l1,%l2;add %l2,8,%l2;sub %sp,48,%sp;setx __init_array_start,%g1,%l3;1:;setx __init_array_end,%g1,%l4;cmp %l3,%l4;bgeu %xcc,2f;nop;ldx [%l3],%l5;mov %l0,%o0;mov %l1,%o1;call %l5;mov %l2,%o2;ba 1b;add %l3,8,%l3;2:;mov %l0,%o0;mov %l1,%o1;call main;mov %l2,%o2;call sultanc.process_exit;nop;illtrap 0;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | _ -> {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع الطول_الفعلي: طبيعي = الطول(النص) مثل طبيعي;
    LLVMAppendModuleInlineAsm((*الحالة).الوحدة, &النص[0], الطول_الفعلي);
    أرجع اختياري.لا_شيء();
}

// FreeBSD executables link no C runtime either, so this is their crt1 and
// crtbrand. The kernel hands `_start` the address of its argument block
// [argc][argv...][NULL][envp...][NULL][auxv] in the first argument register
// (exec_setregs: rdi on amd64, x0 on arm64, a0 on riscv), not in the stack
// pointer: amd64 enters with %rsp = 8 mod 16 and arm64/riscv with sp
// 16-byte aligned (sys/<arch>/<arch>/exec_machdep.c; lib/csu/<arch>/crt1_s.S
// reads the same register). The rest is the Linux start above: the
// .init_array range, then main and sultanc.process_exit.
// The .note.tag ABI note (NT_FREEBSD_ABI_TAG, lib/csu/common/crtbrand.S)
// records the FreeBSD release the image targets (__FreeBSD_version of
// releng/14.2, sys/sys/param.h); the kernel derives p_osrel from it
// (imgact_elf.c) and keys current, not compatibility, behaviour on it. The
// ELF header also carries ELFOSABI_FREEBSD (link/elf/target_policy.sn).
عرف أضف_بدء_عملية_فري_بي_إس_دي_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    المسير: &سياق_مستهلك_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق أنشئ_جسر_خروج_عملية_إل_إل_في_إم(الحالة, المسير) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(_) -> { };
    دع النص: متغير متجه ط8 = [];
    دع الملاحظة: نص = «.section .note.tag,"a",%note;.p2align 2;.long 8;.long 4;.long 1;.asciz "FreeBSD";.long 1402000;»;
    ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &الملاحظة);
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        دع البداية: نص = «.text;.globl _start;.type _start,@function;_start:;xorl %ebp,%ebp;movq %rdi,%r12;movq (%r12),%r13;leaq 8(%r12),%r14;leaq 8(%r14,%r13,8),%r15;andq $-16,%rsp;leaq __init_array_start(%rip),%rbx;1:;leaq __init_array_end(%rip),%rax;cmpq %rax,%rbx;jae 2f;movq %r13,%rdi;movq %r14,%rsi;movq %r15,%rdx;callq *(%rbx);addq $8,%rbx;jmp 1b;2:;movq %r13,%rdi;movq %r14,%rsi;movq %r15,%rdx;callq main;movl %eax,%edi;callq sultanc.process_exit;ud2;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        دع البداية: نص = «.text;.globl _start;.type _start,%function;_start:;mov x29,#0;mov x30,#0;mov x19,x0;ldr x20,[x19];add x21,x19,#8;add x22,x21,x20,lsl #3;add x22,x22,#8;adrp x23,__init_array_start;add x23,x23,:lo12:__init_array_start;1:;adrp x9,__init_array_end;add x9,x9,:lo12:__init_array_end;cmp x23,x9;b.hs 2f;ldr x10,[x23],#8;mov x0,x20;mov x1,x21;mov x2,x22;blr x10;b 1b;2:;mov x0,x20;mov x1,x21;mov x2,x22;bl main;bl sultanc.process_exit;brk #0;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> {
        دع البداية: نص = «.text;.globl _start;.type _start,@function;_start:;ld s1,0(a0);addi s2,a0,8;slli s3,s1,3;add s3,s3,s2;addi s3,s3,8;andi sp,sp,-16;lla s4,__init_array_start;1:;lla t0,__init_array_end;bgeu s4,t0,2f;ld t1,0(s4);mv a0,s1;mv a1,s2;mv a2,s3;jalr t1;addi s4,s4,8;j 1b;2:;mv a0,s1;mv a1,s2;mv a2,s3;call main;call sultanc.process_exit;unimp;.size _start,.-_start»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &البداية);
    }
    | _ -> {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع الطول_الفعلي: طبيعي = الطول(النص) مثل طبيعي;
    LLVMAppendModuleInlineAsm((*الحالة).الوحدة, &النص[0], الطول_الفعلي);
    أرجع اختياري.لا_شيء();
}

// Windows stack probe. LLVM calls `__chkstk` from the prologue of every
// Windows function whose frame exceeds one page (4 KiB), so that each page
// is touched in order and the stack's guard page can grow the stack; skipping
// the probe would fault. The routine is otherwise supplied by the C runtime
// (MSVC chkstk.obj, compiler-rt chkstk.S), which SultanC never links, so a
// SultanC executable defines it once, beside its `_start`, with the Windows
// ABI of that routine: on x86-64 RAX holds the frame size and only R10/R11
// and flags may change (RSP is not adjusted); on AArch64 X15 holds the size
// in 16-byte units and only X16/X17 may change. The sequences are those of
// compiler-rt's chkstk.S for each architecture.
عرف أضف_مسبار_مكدس_ويندوز_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف
): اختياري فشل_مزود_إل_إل_في_إم {
    دع النص: متغير متجه ط8 = [];
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        دع المسبار: نص = «.text;.globl __chkstk;.def __chkstk;.scl 2;.type 32;.endef;.p2align 4;__chkstk:;pushq %rcx;pushq %rax;cmpq $0x1000,%rax;leaq 24(%rsp),%rcx;jb 1f;2:;subq $0x1000,%rcx;testq %rcx,(%rcx);subq $0x1000,%rax;cmpq $0x1000,%rax;ja 2b;1:;subq %rax,%rcx;testq %rcx,(%rcx);popq %rax;popq %rcx;retq»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &المسبار);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        دع المسبار: نص = «.text;.globl __chkstk;.def __chkstk;.scl 2;.type 32;.endef;.p2align 2;__chkstk:;lsl x16,x15,#4;mov x17,sp;1:;sub x17,x17,#4096;subs x16,x16,#4096;ldr xzr,[x17];b.gt 1b;ret»;
        ألحق_نص_تجميع_إل_إل_في_إم(&متغير النص, &المسبار);
    }
    | _ -> {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع الطول_الفعلي: طبيعي = الطول(النص) مثل طبيعي;
    LLVMAppendModuleInlineAsm((*الحالة).الوحدة, &النص[0], الطول_الفعلي);
    أرجع اختياري.لا_شيء();
}

// A process start that receives no startup arguments:
//   * WASI preview 1 command: the host calls `void _start()` and takes the
//     exit status only from proc_exit (a returning `_start` means status 0);
//   * Windows: the PE entry point (link/coff/names.sn) is called with no
//     arguments by the loader; the status reaches the OS only through
//     ExitProcess.
// The language entry is declared as `_start` for these targets; rename it to
// the internal sultanc.entry, then define `_start` to call it and pass its
// status to sultanc.process_exit, which calls the STD exit provider (WASI
// proc_exit, kernel32 ExitProcess).
عرف أضف_بدء_عملية_بلا_وسائط_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    دالة_الدخول: &اختياري معرف_دالة_مسير,
    المسير: &سياق_مستهلك_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    دع معرف_اللغة: معرف_دالة_مسير;
    طابق *دالة_الدخول مع
    | اختياري.موجود(المعرف) -> { معرف_اللغة := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق (*المسير).المسير.دالة_بدء_البرنامج مع
    | اختياري.موجود(المعرف) -> {
        لو (المعرف.القيمة != معرف_اللغة.القيمة) {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع القيد: قيد_دالة_إل_إل_في_إم;
    طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, معرف_اللغة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(الدالة) -> { القيد := الدالة; };
    دع مدخل_اللغة: مرجع_قيمة_إل_إل_في_إم = القيد.الدالة;
    دع اسم_البدء: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«_start»);
    لو (LLVMGetNamedFunction((*الحالة).الوحدة, &متغير اسم_البدء[0]) != مدخل_اللغة
        || LLVMCountBasicBlocks(مدخل_اللغة) == 0
        || LLVMCountParamTypes(القيد.نوع_الدالة) != 0
        || LLVMIsFunctionVarArg(القيد.نوع_الدالة) != 0) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    دع عدد_صحيح32: مرجع_نوع_إل_إل_في_إم = LLVMInt32TypeInContext(السياق);
    دع نوع_ناتج_اللغة: مرجع_نوع_إل_إل_في_إم = LLVMGetReturnType(القيد.نوع_الدالة);
    لو (LLVMGetTypeKind(نوع_ناتج_اللغة) != 0
        && LLVMGetTypeKind(نوع_ناتج_اللغة) != LLVMGetTypeKind(عدد_صحيح32)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع اسم_الداخلي: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«sultanc.entry»);
    لو (LLVMGetNamedFunction((*الحالة).الوحدة, &متغير اسم_الداخلي[0]) != الفارغ
        || LLVMGetNamedGlobal((*الحالة).الوحدة, &متغير اسم_الداخلي[0]) != الفارغ) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    LLVMSetValueName2(مدخل_اللغة, &متغير اسم_الداخلي[0], (الطول(اسم_الداخلي) - 1) مثل طبيعي);
    دع اسم_الداخلي_الخام: متجه ط8 = بايتات_من_نص(«sultanc.entry»);
    لو (!يطابق_اسم_قيمة_إل_إل_في_إم(مدخل_اللغة, &اسم_الداخلي_الخام)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    LLVMSetLinkage(مدخل_اللغة, ربط_داخلي_إل_إل_في_إم());
    دع الجسر: مرجع_قيمة_إل_إل_في_إم;
    طابق أنشئ_جسر_خروج_عملية_إل_إل_في_إم(الحالة, المسير) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الجسر := القيمة; };
    // LLVMFunctionType ignores the parameter pointer when the count is zero.
    دع لا_أنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [عدد_صحيح32];
    دع نوع_البدء: مرجع_نوع_إل_إل_في_إم = LLVMFunctionType(
        LLVMVoidTypeInContext(السياق), &متغير لا_أنواع[0], 0, 0
    );
    دع البدء: مرجع_قيمة_إل_إل_في_إم = LLVMAddFunction(
        (*الحالة).الوحدة, &متغير اسم_البدء[0], نوع_البدء
    );
    دع اسم_البدء_الخام: متجه ط8 = بايتات_من_نص(«_start»);
    لو (!يطابق_اسم_قيمة_إل_إل_في_إم(البدء, &اسم_البدء_الخام)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع اسم_الكتلة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«entry»);
    دع الكتلة: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(
        السياق, البدء, &متغير اسم_الكتلة[0]
    );
    دع الباني: مرجع_بان_إل_إل_في_إم = LLVMCreateBuilderInContext(السياق);
    LLVMPositionBuilderAtEnd(الباني, الكتلة);
    دع اسم_فارغ: متغير متجه ط8 = [0];
    دع لا_معاملات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [مدخل_اللغة];
    دع الناتج: مرجع_قيمة_إل_إل_في_إم = LLVMBuildCall2(
        الباني, القيد.نوع_الدالة, مدخل_اللغة,
        &متغير لا_معاملات[0], 0, &متغير اسم_فارغ[0]
    );
    دع الحالة_النهائية: متغير مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(عدد_صحيح32, 0, 0);
    لو (LLVMGetTypeKind(نوع_ناتج_اللغة) != 0) {
        دع العرض: ط32 = LLVMGetIntTypeWidth(نوع_ناتج_اللغة);
        لو (العرض > 32) {
            الحالة_النهائية := LLVMBuildTrunc(الباني, الناتج, عدد_صحيح32, &متغير اسم_فارغ[0]);
        } وإلا لو (العرض < 32) {
            الحالة_النهائية := LLVMBuildZExt(الباني, الناتج, عدد_صحيح32, &متغير اسم_فارغ[0]);
        } وإلا { الحالة_النهائية := الناتج; };
    };
    دع وسائط_الجسر: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الحالة_النهائية];
    LLVMBuildCall2(
        الباني, LLVMGlobalGetValueType(الجسر), الجسر,
        &متغير وسائط_الجسر[0], 1, &متغير اسم_فارغ[0]
    );
    LLVMBuildRetVoid(الباني);
    LLVMDisposeBuilder(الباني);
    أرجع اختياري.لا_شيء();
}
