استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.ffi.debuginfo;
استورد compiler.msir.debug_contract;

// تبقى دلالات التصحيح مملوكة لطبقة التصحيح وعقد تصحيح MSIR المقنن.
// هذا الملف يملك فقط عمر بيانات التصحيح الخاصة بالمزود ولا يختلق مسارات أو أسطرا أو نطاقات أو مواقع آلة.
عام نوع حالة_تصحيح_إل_إل_في_إم = {
    الباني: مرجع_باني_تصحيح_إل_إل_في_إم,
    مفعلة: منطقي
};

عام عرف أنشئ_حالة_تصحيح_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير
): حالة_تصحيح_إل_إل_في_إم {
    دع الباني: مرجع_باني_تصحيح_إل_إل_في_إم = أنشئ_باني_تصحيح_إل_إل_في_إم((*الحالة).الوحدة);
    // وجود عقد التصحيح المقنن يجيز إنشاء باني البيانات فقط؛ لا تنشأ بيانات مصطنعة هنا.
    دع الناتج: حالة_تصحيح_إل_إل_في_إم = { الباني: الباني, مفعلة: صواب };
    أرجع الناتج;
}

عام عرف اختم_حالة_تصحيح_إل_إل_في_إم(الحالة: &متغير حالة_تصحيح_إل_إل_في_إم): فراغ {
    لو ((*الحالة).مفعلة) {
        اختم_باني_تصحيح_إل_إل_في_إم((*الحالة).الباني);
        حرر_باني_تصحيح_إل_إل_في_إم((*الحالة).الباني);
        (*الحالة).مفعلة := خطأ;
    };
}
