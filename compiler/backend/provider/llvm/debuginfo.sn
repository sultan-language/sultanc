// بيانات LLVM هنا مرايا أجنبية فقط. الهوية والدلالة تبقيان في عقد تصحيح MSIR المقنن.
عام نوع حالة_تصحيح_إل_إل_في_إم = {
    الباني: مرجع_باني_تصحيح_إل_إل_في_إم,
    مفعلة: منطقي,
    مختومة: منطقي,
    الفارغ: مرجع_بيانات_وصفية_إل_إل_في_إم,
    وحدة_التجميع: مرجع_بيانات_وصفية_إل_إل_في_إم,
    الملف_الافتراضي: مرجع_بيانات_وصفية_إل_إل_في_إم,
    التعبير_الفارغ: مرجع_بيانات_وصفية_إل_إل_في_إم,
    الملفات: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم,
    الوحدات: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم,
    الدوال: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم,
    النطاقات: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم,
    // Scopes inside an inlined call, relative to the inlined function.
    النطاقات_في_المضمن: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم,
    الأنواع: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم,
    المتغيرات: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم,
    المواقع: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم,
    محسن: منطقي,
    // The line-0 location of the function being lowered (null when it has no
    // subprogram): compiler-generated instructions with no source location
    // take it, as Clang's artificial locations do. A call without a location
    // in a function with a subprogram breaks the inliner's location rewrite.
    موقع_الدالة: مرجع_بيانات_وصفية_إل_إل_في_إم
};

نوع إحداثي_تصحيح_إل_إل_في_إم = {
    الملف: مرجع_بيانات_وصفية_إل_إل_في_إم,
    السطر: ط32,
    العمود: ط32
};

عرف بايتات_نص_تصحيح_إل_إل_في_إم(النص: &نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        ألحق(الناتج, (*النص)[ف] مثل ط8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اسم_نوع_افتراضي_تصحيح_إل_إل_في_إم(): متجه ط8 {
    دع الاسم: متجه ط8 = بايتات_من_نص(«SultanC type»);
    أرجع الاسم;
}

// The debugger-facing name (compiler/debuginfo/type_names.sn), shared with
// the native DWARF writer.
عرف اسم_نوع_تصحيح_إل_إل_في_إم(البيانات: &بيانات_تصحيح_مسير, الأنواع: &سجل_أنواع, النوع: معرف_نوع): متجه ط8 {
    دع الاسم: متجه ط8 = اسم_نوع_تصحيح_معروض(&(*البيانات).الدلالي, الأنواع, النوع);
    إذا ((الطول(الاسم) مثل طبيعي) == 0) { أرجع اسم_نوع_افتراضي_تصحيح_إل_إل_في_إم(); };
    أرجع الاسم;
}

عرف اسم_عضو_نوع_تصحيح_إل_إل_في_إم(
    البيانات: &بيانات_تصحيح_مسير,
    النوع: معرف_نوع,
    الفهرس: طبيعي
): متجه ط8 {
    إذا ((النوع.القيمة مثل طبيعي) < (الطول((*البيانات).الدلالي.فهرس_الأنواع_الدلالية) مثل طبيعي)) {
        طابق (*البيانات).الدلالي.فهرس_الأنواع_الدلالية[النوع.القيمة] مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(معرف_التصحيح) -> {
            إذا (معرف_التصحيح.القيمة < (الطول((*البيانات).الدلالي.الأنواع) مثل طبيعي)) {
                دع الوصف: &نوع_تصحيح = &(*البيانات).الدلالي.الأنواع[معرف_التصحيح.القيمة];
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول((*الوصف).الأعضاء) مثل طبيعي)) {
                    إذا ((*الوصف).الأعضاء[ف].الفهرس == الفهرس) {
                        أرجع انسخ_بايتات_إل_إل_في_إم(&(*الوصف).الأعضاء[ف].الاسم);
                    };
                    ف := ف + 1;
                }
            };
        };
    };
    دع بلا_اسم: متجه ط8 = [];
    أرجع بلا_اسم;
}

عرف ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(
    المخزن: &متغير متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم,
    الفهرس: طبيعي
): فراغ {
    طالما ((الطول(*المخزن) مثل طبيعي) <= الفهرس) {
        ألحق(*المخزن, اختياري.لا_شيء());
    }
}

عرف ملف_تصحيح_إل_إل_في_إم(
    الحالة: &حالة_تصحيح_إل_إل_في_إم,
    المصدر: طبيعي
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    إذا (المصدر < (الطول((*الحالة).الملفات) مثل طبيعي)) {
        طابق (*الحالة).الملفات[المصدر] مع
        | اختياري.موجود(م) -> { أرجع م; }
        | اختياري.لا_شيء -> { };
    };
    أرجع (*الحالة).الملف_الافتراضي;
}

عرف إحداثي_أصل_تصحيح_إل_إل_في_إم(
    الحالة: &حالة_تصحيح_إل_إل_في_إم,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر
): إحداثي_تصحيح_إل_إل_في_إم {
    دع الناتج: متغير إحداثي_تصحيح_إل_إل_في_إم = {
        الملف: (*الحالة).الملف_الافتراضي,
        السطر: 0,
        العمود: 0
    };
    طابق أصل_مصدر_بالمعرف(الأصول, الأصل) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(وصف) -> {
        الناتج.الملف := ملف_تصحيح_إل_إل_في_إم(الحالة, وصف.النطاق.البداية.المصدر);
        طابق إحداثي_من_الخريطة(المصادر, وصف.النطاق.البداية) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(إحداثي) -> {
            الناتج.السطر := إحداثي.السطر;
            // SourceMap is zero-based for columns; debugger coordinates are one-based.
            الناتج.العمود := إحداثي.العمود + 1;
        };
        أرجع الناتج;
    };
}

عام عرف أنشئ_حالة_تصحيح_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &خريطة_مصادر,
    محسن: منطقي
): حالة_تصحيح_إل_إل_في_إم {
    دع الباني: مرجع_باني_تصحيح_إل_إل_في_إم = أنشئ_باني_تصحيح_إل_إل_في_إم((*الحالة).الوحدة);
    دع مفتاح_فارغ: متغير متجه ط8 = بايتات_من_نص(«sultanc.null»);
    دع الفارغ: مرجع_بيانات_وصفية_إل_إل_في_إم = علم_وحدة_إل_إل_في_إم((*الحالة).الوحدة, &متغير مفتاح_فارغ[0],
        الطول(مفتاح_فارغ) مثل طبيعي);
    دع الملفات: متغير متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع الملف_الافتراضي: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = الفارغ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المصادر).المصادر) مثل طبيعي)) {
        دع بايتات_الاسم: متجه ط8 = بايتات_نص_تصحيح_إل_إل_في_إم(&(*المصادر).المصادر[ف].الاسم);
        دع اسم_سي: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&بايتات_الاسم);
        دع دليل: متغير متجه ط8 = [0];
        دع الملف: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_ملف_تصحيح_إل_إل_في_إم(
            الباني, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_سي), (الطول(بايتات_الاسم) مثل حجم_إل_إل_في_إم),
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير دليل), (0 مثل حجم_إل_إل_في_إم)
        );
        ألحق(الملفات, اختياري.موجود(الملف));
        إذا (ف == 0) { الملف_الافتراضي := الملف; };
        ف := ف + 1;
    }
    دع مفعلة: منطقي = (الطول((*المصادر).المصادر) > 0)
        && ((الطول((*البيانات).الدلالي.الدوال) > 0)
            || (الطول((*البيانات).الدلالي.العوام) > 0)
            || (الطول((*البيانات).الدلالي.الثوابت) > 0)
            || (الطول((*البيانات).الدلالي.الوحدات) > 0)
            || (الطول((*البيانات).الدلالي.الأنواع) > 0)
            || (الطول((*البيانات).الدلالي.المواقع) > 0));
    دع وحدة_التجميع: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = الفارغ;
    دع التعبير_الفارغ: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = الفارغ;
    إذا (مفعلة) {
        // LLVM 23 debug-record insertion requires the module's new debug-info format.
        فعل_صيغة_سجلات_تصحيح_إل_إل_في_إم((*الحالة).الوحدة);
        // LLVM debug metadata uses its own module-format version independently of DWARF/CodeView policy.
        دع مفتاح_إصدار_التصحيح_خام: متجه ط8 =
            بايتات_من_نص(«Debug Info Version»);
        دع مفتاح_إصدار_التصحيح: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&مفتاح_إصدار_التصحيح_خام);
        دع نوع_ط32: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 32);
        دع قيمة_إصدار_التصحيح: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_ط32, 3, خطأ);
        دع بيانات_إصدار_التصحيح: مرجع_بيانات_وصفية_إل_إل_في_إم =
            بيانات_وصفية_من_قيمة_إل_إل_في_إم(قيمة_إصدار_التصحيح);
        أضف_علم_تحذير_وحدة_إل_إل_في_إم(
            (*الحالة).الوحدة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير مفتاح_إصدار_التصحيح),
            (الطول(مفتاح_إصدار_التصحيح_خام) مثل طبيعي),
            بيانات_إصدار_التصحيح
        );
        دع المنتج_خام: متجه ط8 = بايتات_من_نص(«SultanC LLVM»);
        دع المنتج: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&المنتج_خام);
        دع الرايات: متغير متجه ط8 = [0];
        وحدة_التجميع := أنشئ_وحدة_تصحيح_إل_إل_في_إم(
            الباني, لغة_مصدر_توافق_تصحيح_إل_إل_في_إم(), الملف_الافتراضي,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير المنتج), (الطول(المنتج_خام) مثل طبيعي), محسن,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الرايات), 0,
            إصدار_تصحيح_كامل_إل_إل_في_إم()
        );
        دع العمليات: متغير متجه ط64 = [0];
        التعبير_الفارغ := أنشئ_تعبير_تصحيح_فارغ_إل_إل_في_إم(الباني, &متغير العمليات[0]);
    };
    دع الوحدات: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع الدوال: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع النطاقات: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع النطاقات_في_المضمن: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع الأنواع: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع المتغيرات: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع المواقع: متجه اختياري مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع الناتج: حالة_تصحيح_إل_إل_في_إم = {
        الباني: الباني, مفعلة: مفعلة, مختومة: خطأ, الفارغ: الفارغ,
        وحدة_التجميع: وحدة_التجميع, الملف_الافتراضي: الملف_الافتراضي,
        التعبير_الفارغ: التعبير_الفارغ, الملفات: الملفات, الوحدات: الوحدات, الدوال: الدوال,
        النطاقات: النطاقات, النطاقات_في_المضمن: النطاقات_في_المضمن, الأنواع: الأنواع, المتغيرات: المتغيرات, المواقع: المواقع,
        محسن: محسن, موقع_الدالة: الفارغ
    };
    أرجع الناتج;
}

عام عرف اختم_حالة_تصحيح_إل_إل_في_إم(الحالة: &متغير حالة_تصحيح_إل_إل_في_إم): فراغ {
    إذا ((*الحالة).مفعلة && !(*الحالة).مختومة) {
        اختم_باني_تصحيح_إل_إل_في_إم((*الحالة).الباني);
        (*الحالة).مختومة := صواب;
    };
}

عام عرف حرر_حالة_تصحيح_إل_إل_في_إم(الحالة: &متغير حالة_تصحيح_إل_إل_في_إم): فراغ {
    حرر_باني_تصحيح_إل_إل_في_إم((*الحالة).الباني);
    (*الحالة).مفعلة := خطأ;
}

عرف مصدر_أصل_تصحيح_إل_إل_في_إم(الأصول: &سجل_أصول_مصدر, الأصل: معرف_أصل_مصدر): اختياري طبيعي {
    طابق أصل_مصدر_بالمعرف(الأصول, الأصل) مع
    | اختياري.موجود(وصف) -> { أرجع اختياري.موجود(وصف.النطاق.البداية.المصدر); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف نطاق_وحدة_لأصل_تصحيح_إل_إل_في_إم(
    الحالة: &حالة_تصحيح_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    طابق مصدر_أصل_تصحيح_إل_إل_في_إم(الأصول, الأصل) مع
    | اختياري.لا_شيء -> { أرجع (*الحالة).وحدة_التجميع; }
    | اختياري.موجود(المصدر) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*البيانات).الدلالي.الوحدات) مثل طبيعي)) {
            دع الوحدة: &وحدة_تصحيح = &(*البيانات).الدلالي.الوحدات[ف];
            دع معرف_الوحدة: طبيعي = (*الوحدة).المعرف.القيمة;
            إذا ((*الوحدة).معرف_المصدر == المصدر && معرف_الوحدة < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
                طابق (*الحالة).الوحدات[معرف_الوحدة] مع
                | اختياري.موجود(نطاق) -> { أرجع نطاق; }
                | اختياري.لا_شيء -> { };
            };
            ف := ف + 1;
        }
    };
    أرجع (*الحالة).وحدة_التجميع;
}

// The constructor name of tagged Type النوع: option and result constructors
// as the language spells them, a declared enum's as written.
عرف اسم_منشئ_تصحيح_إل_إل_في_إم(
    البيانات: &بيانات_تصحيح_مسير,
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    الفهرس: طبيعي
): متجه ط8 {
    طابق منشئ_نوع_عند(الأنواع, النوع, الفهرس) مع
    | اختياري.موجود(المنشئ) -> {
        طابق اسم_منشئ_مدمج_تصحيح(&المنشئ.الهوية) مع
        | اختياري.موجود(الاسم) -> { أرجع الاسم; }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    دع معرف_التصحيح: متغير اختياري معرف_نوع_تصحيح = معرف_نوع_تصحيح_لنوع(&(*البيانات).الدلالي, النوع);
    إذا ((النوع.القيمة مثل طبيعي) < (الطول((*الأنواع).الأنواع) مثل طبيعي)) {
        طابق (*الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.مسمى(الرمز, _, _) -> {
            طابق معرف_نوع_تصحيح_لرمز(&(*البيانات).الدلالي, الرمز) مع
            | اختياري.موجود(المعرف) -> { معرف_التصحيح := اختياري.موجود(المعرف); }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
    };
    طابق معرف_التصحيح مع
    | اختياري.موجود(المعرف) -> {
        إذا (المعرف.القيمة < (الطول((*البيانات).الدلالي.الأنواع) مثل طبيعي)) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*البيانات).الدلالي.الأنواع[المعرف.القيمة].البدائل) مثل طبيعي)) {
                إذا ((*البيانات).الدلالي.الأنواع[المعرف.القيمة].البدائل[ف].الفهرس == الفهرس) {
                    أرجع انسخ_بايتات_إل_إل_في_إم(&(*البيانات).الدلالي.الأنواع[المعرف.القيمة].البدائل[ف].الاسم);
                };
                ف := ف + 1;
            }
        };
    }
    | اختياري.لا_شيء -> { };
    دع الناتج: متغير متجه ط8 = بايتات_من_نص(«منشئ»);
    ألحق(الناتج, (0x30 + الفهرس % 10) مثل ط8);
    أرجع الناتج;
}

// One member of a composite being built (offset in bytes).
عرف ألحق_عضو_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البيانات: &بيانات_تصحيح_مسير,
    المؤقت: مرجع_بيانات_وصفية_إل_إل_في_إم,
    الاسم_الخام: &متجه ط8,
    الإزاحة: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    نوع_العضو: مرجع_بيانات_وصفية_إل_إل_في_إم,
    العناصر: &متغير متجه مرجع_بيانات_وصفية_إل_إل_في_إم
): فراغ {
    دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(الاسم_الخام);
    دع العضو: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_عضو_تصحيح_إل_إل_في_إم(
        (*حالة_التصحيح).الباني, المؤقت, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(*الاسم_الخام) مثل طبيعي),
        (*حالة_التصحيح).الملف_الافتراضي, 0, (الحجم * 8) مثل ط64, (المحاذاة * 8) مثل ط32, (الإزاحة * 8) مثل ط64,
        نوع_العضو
    );
    ألحق(*العناصر, العضو);
}

عرف ألحق_عضو_بنوع_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البيانات: &بيانات_تصحيح_مسير,
    المؤقت: مرجع_بيانات_وصفية_إل_إل_في_إم,
    الاسم_الخام: &متجه ط8,
    الإزاحة: طبيعي,
    النوع: معرف_نوع,
    العناصر: &متغير متجه مرجع_بيانات_وصفية_إل_إل_في_إم
): فراغ {
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(التخطيط) -> {
        دع نوع_العضو: مرجع_بيانات_وصفية_إل_إل_في_إم = نوع_تصحيح_إل_إل_في_إم(
            حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, النوع
        );
        ألحق_عضو_تصحيح_إل_إل_في_إم(
            حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, المؤقت, الاسم_الخام,
            الإزاحة, التخطيط.الحجم, التخطيط.المحاذاة, نوع_العضو, العناصر
        );
    }
    | _ -> { };
}

// A vector or text (data, length, capacity, with an element-typed data
// pointer; text's elements are UTF-8 bytes), or a tagged Type (its tag and,
// at their offsets, each constructor's payloads named by the constructor),
// from its canonical layout; any other Type is a sized composite without
// members.
عرف نوع_تصحيح_مركب_بأعضاء_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البيانات: &بيانات_تصحيح_مسير,
    النوع: معرف_نوع,
    الاسم_الخام: &متجه ط8
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(الاسم_الخام);
    دع التخطيط: واصف_تخطيط;
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(ت) -> { التخطيط := ت; }
    | _ -> {
        أرجع أنشئ_نوع_غير_محدد_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(*الاسم_الخام) مثل طبيعي));
    };
    دع فريد: متغير متجه ط8 = [0];
    دع المؤقت: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_نوع_مركب_مؤقت_تصحيح_إل_إل_في_إم(
        (*حالة_التصحيح).الباني, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(*الاسم_الخام) مثل طبيعي),
        (*حالة_التصحيح).وحدة_التجميع, (*حالة_التصحيح).الملف_الافتراضي, 0,
        (التخطيط.الحجم * 8) مثل ط64, (التخطيط.المحاذاة * 8) مثل ط32, خطأ, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فريد)
    );
    (*حالة_التصحيح).الأنواع[النوع.القيمة] := اختياري.موجود(المؤقت);
    دع العناصر: متغير متجه مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع عرض_المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر;
    دع نوع_الطول: معرف_نوع = معرف_نوع_من(رقم_نوع_بدائي(نوع_بدائي_مقنن.طبيعي()));
    طابق التخطيط.التفاصيل مع
    | تفاصيل_تخطيط.سجل(المواضع) -> {
        دع عنصر_البيانات: متغير اختياري مرجع_بيانات_وصفية_إل_إل_في_إم = اختياري.لا_شيء();
        إذا ((النوع.القيمة مثل طبيعي) < (الطول((*الحقائق).الأنواع.الأنواع) مثل طبيعي) && (الطول(المواضع) مثل طبيعي) >= 3) {
            طابق (*الحقائق).الأنواع.الأنواع[النوع.القيمة] مع
            | نوع_مقنن.متجه(الداخل) -> {
                عنصر_البيانات := اختياري.موجود(نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, الداخل));
            }
            | نوع_مقنن.بدائي(_) -> {
                دع اسم_البايت_خام: متجه ط8 = بايتات_من_نص(«بايت_نص»);
                دع اسم_البايت: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_البايت_خام);
                عنصر_البيانات := اختياري.موجود(أنشئ_نوع_أساسي_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
                    مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_البايت), (الطول(اسم_البايت_خام) مثل طبيعي), 8,
                    ترميز_محرف_تصحيح_إل_إل_في_إم()));
            }
            | _ -> { };
        };
        طابق عنصر_البيانات مع
        | اختياري.موجود(العنصر) -> {
            دع بلا_اسم: متغير متجه ط8 = [0];
            دع المؤشر: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_نوع_مؤشر_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, العنصر,
                (عرض_المؤشر * 8) مثل ط64, (عرض_المؤشر * 8) مثل ط32, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير بلا_اسم), 0);
            دع اسم_البيانات: متجه ط8 = بايتات_من_نص(«data»);
            دع اسم_الطول: متجه ط8 = بايتات_من_نص(«length»);
            دع اسم_السعة: متجه ط8 = بايتات_من_نص(«capacity»);
            ألحق_عضو_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, المؤقت, &اسم_البيانات,
                المواضع[0].الإزاحة, عرض_المؤشر, عرض_المؤشر, المؤشر, &متغير العناصر);
            ألحق_عضو_بنوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, المؤقت, &اسم_الطول,
                المواضع[1].الإزاحة, نوع_الطول, &متغير العناصر);
            ألحق_عضو_بنوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, المؤقت, &اسم_السعة,
                المواضع[2].الإزاحة, نوع_الطول, &متغير العناصر);
        }
        | اختياري.لا_شيء -> { };
    }
    | تفاصيل_تخطيط.تعداد(التعداد) -> {
        دع نوع_الوسم: متغير معرف_نوع = معرف_نوع_من(رقم_نوع_بدائي(نوع_بدائي_مقنن.ط64()));
        إذا (التعداد.الوسم.الحجم == 1) { نوع_الوسم := معرف_نوع_من(رقم_نوع_بدائي(نوع_بدائي_مقنن.ط8())); };
        إذا (التعداد.الوسم.الحجم == 2) { نوع_الوسم := معرف_نوع_من(رقم_نوع_بدائي(نوع_بدائي_مقنن.ط16())); };
        إذا (التعداد.الوسم.الحجم == 4) { نوع_الوسم := معرف_نوع_من(رقم_نوع_بدائي(نوع_بدائي_مقنن.ط32())); };
        دع اسم_الوسم: متجه ط8 = بايتات_من_نص(«$tag»);
        ألحق_عضو_بنوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, المؤقت, &اسم_الوسم,
            التعداد.الوسم.الإزاحة, نوع_الوسم, &متغير العناصر);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعداد.المنشئات) مثل طبيعي)) {
            طابق منشئ_نوع_عند(&(*الحقائق).الأنواع, النوع, ف) مع
            | اختياري.موجود(المنشئ) -> {
                دع اسم_المنشئ: متجه ط8 = اسم_منشئ_تصحيح_إل_إل_في_إم(البيانات, &(*الحقائق).الأنواع, النوع, ف);
                دع عدد_الحمولات: طبيعي = الطول(التعداد.المنشئات[ف].الحمولات) مثل طبيعي;
                دع ح: متغير طبيعي = 0;
                طالما (ح < عدد_الحمولات && ح < (الطول(المنشئ.الحمولات) مثل طبيعي)) {
                    دع اسم_الحمولة: متغير متجه ط8 = انسخ_بايتات_إل_إل_في_إم(&اسم_المنشئ);
                    إذا (عدد_الحمولات > 1) { ألحق(اسم_الحمولة, 0x2e); ألحق(اسم_الحمولة, (0x30 + ح % 10) مثل ط8); };
                    ألحق_عضو_بنوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, المؤقت, &اسم_الحمولة,
                        التعداد.مخزن_الحمولة.الإزاحة + التعداد.المنشئات[ف].الحمولات[ح].الإزاحة,
                        المنشئ.الحمولات[ح], &متغير العناصر);
                    ح := ح + 1;
                }
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
    }
    | _ -> { };
    دع عدد_العناصر: ط32 = الطول(العناصر) مثل ط32;
    إذا ((الطول(العناصر) مثل طبيعي) == 0) { ألحق(العناصر, (*حالة_التصحيح).الفارغ); };
    دع الناتج: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_نوع_بنية_تصحيح_إل_إل_في_إم(
        (*حالة_التصحيح).الباني, (*حالة_التصحيح).وحدة_التجميع, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم),
        (الطول(*الاسم_الخام) مثل طبيعي), (*حالة_التصحيح).الملف_الافتراضي, 0,
        (التخطيط.الحجم * 8) مثل ط64, (التخطيط.المحاذاة * 8) مثل ط32, خطأ,
        &متغير العناصر[0], عدد_العناصر, (*حالة_التصحيح).الفارغ, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فريد)
    );
    استبدل_نوع_تصحيح_مؤقت_إل_إل_في_إم(المؤقت, الناتج);
    أرجع الناتج;
}

عام عرف نوع_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البيانات: &بيانات_تصحيح_مسير,
    النوع: معرف_نوع
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    إذا (!(*حالة_التصحيح).مفعلة) { أرجع (*حالة_التصحيح).الفارغ; };
    ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(&متغير (*حالة_التصحيح).الأنواع, النوع.القيمة);
    طابق (*حالة_التصحيح).الأنواع[النوع.القيمة] مع
    | اختياري.موجود(م) -> { أرجع م; }
    | اختياري.لا_شيء -> { };
    دع الاسم_الخام: متجه ط8 = اسم_نوع_تصحيح_إل_إل_في_إم(البيانات, &(*الحقائق).الأنواع, النوع);
    دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
    دع الوصف: وصف_شكل_نوع_دلالي;
    طابق وصف_شكل_نوع_دلالي_عند(&(*الحقائق).الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        دع م: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_نوع_غير_محدد_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي));
        (*حالة_التصحيح).الأنواع[النوع.القيمة] := اختياري.موجود(م); أرجع م;
    }
    | اختياري.موجود(و) -> { الوصف := و; };
    دع الناتج: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).الفارغ;
    طابق الوصف.الصنف مع
    | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
        دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
        دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
        طابق الصنف مع
        | صنف_نوع_بدائي.منطقي -> { الناتج := أنشئ_نوع_أساسي_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي), البتات مثل ط64,
            ترميز_منطقي_تصحيح_إل_إل_في_إم()); }
        | صنف_نوع_بدائي.عدد_موقع -> { الناتج := أنشئ_نوع_أساسي_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي), البتات مثل ط64,
            ترميز_موقع_تصحيح_إل_إل_في_إم()); }
        | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> { الناتج :=
            أنشئ_نوع_أساسي_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم),
            (الطول(الاسم_الخام) مثل طبيعي), البتات مثل ط64, ترميز_طبيعي_تصحيح_إل_إل_في_إم()); }
        | صنف_نوع_بدائي.حرف -> { الناتج := أنشئ_نوع_أساسي_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي), البتات مثل ط64,
            ترميز_طبيعي_تصحيح_إل_إل_في_إم()); }
        | صنف_نوع_بدائي.عشري -> { الناتج := أنشئ_نوع_أساسي_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي), البتات مثل ط64,
            ترميز_عشري_تصحيح_إل_إل_في_إم()); }
        | _ -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.نص -> {
                الناتج := نوع_تصحيح_مركب_بأعضاء_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, النوع, &الاسم_الخام);
            }
            | _ -> { الناتج := أنشئ_نوع_غير_محدد_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي)); };
        };
    }
    | صنف_شكل_نوع_دلالي.مؤشر -> {
        الناتج := أنشئ_نوع_مؤشر_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, (*حالة_التصحيح).الفارغ,
            (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط64, (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي));
    }
    | صنف_شكل_نوع_دلالي.مرجع -> {
        دع الداخل: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).الفارغ;
        طابق نوع_داخل_مرجع_دلالي(&(*الحقائق).الأنواع, النوع) مع
        | اختياري.موجود(ن) -> { الداخل := نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط,
            البيانات, ن); }
        | اختياري.لا_شيء -> {
            طابق نوع_داخل_مرجع_متغير_دلالي(&(*الحقائق).الأنواع, النوع) مع
            | اختياري.موجود(ن) -> { الداخل := نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط,
                البيانات, ن); }
            | اختياري.لا_شيء -> { };
        };
        الناتج := أنشئ_نوع_مؤشر_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, الداخل,
            (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط64, (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي));
    }
    | صنف_شكل_نوع_دلالي.صندوق -> {
        دع الداخل: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).الفارغ;
        طابق نوع_حمولة_صندوق_دلالي(&(*الحقائق).الأنواع, النوع) مع | اختياري.موجود(ن) -> { الداخل :=
            نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, ن); } | اختياري.لا_شيء ->
            { };
        الناتج := أنشئ_نوع_مؤشر_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, الداخل,
            (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط64, (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي));
    }
    | صنف_شكل_نوع_دلالي.صف -> {
        طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_تخطيط.مكتمل(ت) -> {
            طابق ت.التفاصيل مع
            | تفاصيل_تخطيط.صف(المواضع) -> {
                دع فريد: متغير متجه ط8 = [0];
                دع المؤقت: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_نوع_مركب_مؤقت_تصحيح_إل_إل_في_إم(
                    (*حالة_التصحيح).الباني, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل
                        طبيعي),
                    (*حالة_التصحيح).وحدة_التجميع, (*حالة_التصحيح).الملف_الافتراضي, 0,
                    (ت.الحجم * 8) مثل ط64, (ت.المحاذاة * 8) مثل ط32, خطأ, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فريد)
                );
                (*حالة_التصحيح).الأنواع[النوع.القيمة] := اختياري.موجود(المؤقت);
                دع العناصر: متغير متجه مرجع_بيانات_وصفية_إل_إل_في_إم = [];
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(المواضع) مثل طبيعي)) {
                    طابق نوع_عنصر_صف_دلالي_عند(&(*الحقائق).الأنواع, النوع, المواضع[ف].الفهرس) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(نوع_العضو) -> {
                        طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, نوع_العضو) مع
                        | نتيجة_تخطيط.مكتمل(تخطيط_العضو) -> {
                            دع اسم_العضو_خام: متجه ط8 = اسم_عضو_نوع_تصحيح_إل_إل_في_إم(البيانات, النوع,
                                المواضع[ف].الفهرس);
                            دع اسم_العضو: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_العضو_خام);
                            دع وصف_العضو: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_عضو_تصحيح_إل_إل_في_إم(
                                (*حالة_التصحيح).الباني, المؤقت, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_العضو),
                                    (الطول(اسم_العضو_خام) مثل طبيعي),
                                (*حالة_التصحيح).الملف_الافتراضي, 0, (تخطيط_العضو.الحجم * 8) مثل ط64,
                                (تخطيط_العضو.المحاذاة * 8) مثل ط32, (المواضع[ف].الإزاحة * 8) مثل ط64,
                                نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات,
                                    نوع_العضو)
                            );
                            ألحق(العناصر, وصف_العضو);
                        }
                        | _ -> { };
                    };
                    ف := ف + 1;
                }
                دع عدد_العناصر: ط32 = الطول(العناصر) مثل ط32;
                دع مؤشر_العناصر: متغير متجه مرجع_بيانات_وصفية_إل_إل_في_إم = العناصر;
                إذا ((الطول(مؤشر_العناصر) مثل طبيعي) == 0) { ألحق(مؤشر_العناصر, (*حالة_التصحيح).الفارغ); };
                الناتج := أنشئ_نوع_بنية_تصحيح_إل_إل_في_إم(
                    (*حالة_التصحيح).الباني, (*حالة_التصحيح).وحدة_التجميع, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
                        الاسم), (الطول(الاسم_الخام) مثل طبيعي),
                    (*حالة_التصحيح).الملف_الافتراضي, 0, (ت.الحجم * 8) مثل ط64, (ت.المحاذاة * 8) مثل ط32, خطأ,
                    &متغير مؤشر_العناصر[0], عدد_العناصر, (*حالة_التصحيح).الفارغ, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
                        فريد)
                );
                استبدل_نوع_تصحيح_مؤقت_إل_إل_في_إم(المؤقت, الناتج);
            }
            | _ -> { الناتج := أنشئ_نوع_غير_محدد_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي)); };
        }
        | _ -> { الناتج := أنشئ_نوع_غير_محدد_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي)); };
    }
    | صنف_شكل_نوع_دلالي.سجل -> {
        طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_تخطيط.مكتمل(ت) -> {
            طابق ت.التفاصيل مع
            | تفاصيل_تخطيط.سجل(المواضع) -> {
                دع فريد: متغير متجه ط8 = [0];
                دع المؤقت: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_نوع_مركب_مؤقت_تصحيح_إل_إل_في_إم(
                    (*حالة_التصحيح).الباني, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل
                        طبيعي),
                    (*حالة_التصحيح).وحدة_التجميع, (*حالة_التصحيح).الملف_الافتراضي, 0,
                    (ت.الحجم * 8) مثل ط64, (ت.المحاذاة * 8) مثل ط32, خطأ, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فريد)
                );
                (*حالة_التصحيح).الأنواع[النوع.القيمة] := اختياري.موجود(المؤقت);
                دع العناصر: متغير متجه مرجع_بيانات_وصفية_إل_إل_في_إم = [];
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(المواضع) مثل طبيعي)) {
                    طابق نوع_حقل_سجل_دلالي_عند(&(*الحقائق).الأنواع, النوع, المواضع[ف].الفهرس) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(نوع_العضو) -> {
                        طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, نوع_العضو) مع
                        | نتيجة_تخطيط.مكتمل(تخطيط_العضو) -> {
                            دع اسم_العضو_خام: متجه ط8 = اسم_عضو_نوع_تصحيح_إل_إل_في_إم(البيانات, النوع,
                                المواضع[ف].الفهرس);
                            دع اسم_العضو: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_العضو_خام);
                            دع وصف_العضو: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_عضو_تصحيح_إل_إل_في_إم(
                                (*حالة_التصحيح).الباني, المؤقت, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_العضو),
                                    (الطول(اسم_العضو_خام) مثل طبيعي),
                                (*حالة_التصحيح).الملف_الافتراضي, 0, (تخطيط_العضو.الحجم * 8) مثل ط64,
                                (تخطيط_العضو.المحاذاة * 8) مثل ط32, (المواضع[ف].الإزاحة * 8) مثل ط64,
                                نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات,
                                    نوع_العضو)
                            );
                            ألحق(العناصر, وصف_العضو);
                        }
                        | _ -> { };
                    };
                    ف := ف + 1;
                }
                دع عدد_العناصر: ط32 = الطول(العناصر) مثل ط32;
                دع مؤشر_العناصر: متغير متجه مرجع_بيانات_وصفية_إل_إل_في_إم = العناصر;
                إذا ((الطول(مؤشر_العناصر) مثل طبيعي) == 0) { ألحق(مؤشر_العناصر, (*حالة_التصحيح).الفارغ); };
                الناتج := أنشئ_نوع_بنية_تصحيح_إل_إل_في_إم(
                    (*حالة_التصحيح).الباني, (*حالة_التصحيح).وحدة_التجميع, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
                        الاسم), (الطول(الاسم_الخام) مثل طبيعي),
                    (*حالة_التصحيح).الملف_الافتراضي, 0, (ت.الحجم * 8) مثل ط64, (ت.المحاذاة * 8) مثل ط32, خطأ,
                    &متغير مؤشر_العناصر[0], عدد_العناصر, (*حالة_التصحيح).الفارغ, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
                        فريد)
                );
                استبدل_نوع_تصحيح_مؤقت_إل_إل_في_إم(المؤقت, الناتج);
            }
            | _ -> { الناتج := أنشئ_نوع_غير_محدد_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي)); };
        }
        | _ -> { الناتج := أنشئ_نوع_غير_محدد_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي)); };
    }
    | _ -> {
        الناتج := نوع_تصحيح_مركب_بأعضاء_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات, النوع, &الاسم_الخام);
    };
    (*حالة_التصحيح).الأنواع[النوع.القيمة] := اختياري.موجود(الناتج);
    أرجع الناتج;
}

عرف نطاق_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    المعرف: معرف_نطاق_تصحيح
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(&متغير (*حالة_التصحيح).النطاقات, المعرف.القيمة);
    طابق (*حالة_التصحيح).النطاقات[المعرف.القيمة] مع | اختياري.موجود(م) -> { أرجع م; } | اختياري.لا_شيء -> { };
    إذا (المعرف.القيمة >= (الطول((*البيانات).الدلالي.النطاقات) مثل طبيعي)) { أرجع
        (*حالة_التصحيح).وحدة_التجميع; };
    دع النطاق: &نطاق_تصحيح = &(*البيانات).الدلالي.النطاقات[المعرف.القيمة];
    دع الأب: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).وحدة_التجميع;
    طابق (*النطاق).الأب مع
    | اختياري.موجود(أ) -> { الأب := نطاق_تصحيح_إل_إل_في_إم(حالة_التصحيح, البيانات, المصادر, الأصول, أ); }
    | اختياري.لا_شيء -> {
        دع معرف_الدالة_الأب: طبيعي = (*النطاق).الدالة.القيمة;
        إذا (معرف_الدالة_الأب < (الطول((*حالة_التصحيح).الدوال) مثل طبيعي)) {
            طابق (*حالة_التصحيح).الدوال[معرف_الدالة_الأب] مع | اختياري.موجود(د) -> { الأب := د; } | اختياري.لا_شيء
                -> { };
        };
    };
    دع الإحداثي: إحداثي_تصحيح_إل_إل_في_إم = إحداثي_أصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, المصادر, الأصول,
        (*النطاق).الأصل);
    دع م: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_نطاق_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, الأب,
        الإحداثي.الملف, الإحداثي.السطر, الإحداثي.العمود);
    (*حالة_التصحيح).النطاقات[المعرف.القيمة] := اختياري.موجود(م);
    أرجع م;
}

// Inlined calls (compiler/debuginfo/inlining.sn). An instruction, or a
// variable, in an inlined-call scope is described inside the inlined
// function's subprogram, with an inlinedAt chain to the call: LLVM then emits
// DW_TAG_inlined_subroutine and keeps the callee's lines and variables.

// The nearest inlined-call scope enclosing النطاق (itself included) whose
// inlined function has a subprogram in this module.
عرف نطاق_مضمن_محيط_إل_إل_في_إم(
    حالة_التصحيح: &حالة_تصحيح_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    النطاق: معرف_نطاق_تصحيح
): اختياري معرف_نطاق_تصحيح {
    دع الحالي: متغير طبيعي = النطاق.القيمة;
    دع العمق: متغير طبيعي = 0;
    طالما (العمق < 4096) {
        إذا (الحالي >= (الطول((*البيانات).الدلالي.النطاقات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        طابق (*البيانات).الدلالي.النطاقات[الحالي].الدالة_المضمنة مع
        | اختياري.موجود(المضمنة) -> {
            إذا (المضمنة.القيمة < (الطول((*حالة_التصحيح).الدوال) مثل طبيعي)) {
                طابق (*حالة_التصحيح).الدوال[المضمنة.القيمة] مع
                | اختياري.موجود(_) -> { أرجع اختياري.موجود(معرف_نطاق_تصحيح_من(الحالي)); }
                | اختياري.لا_شيء -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        طابق (*البيانات).الدلالي.النطاقات[الحالي].الأب مع
        | اختياري.موجود(الأب) -> { الحالي := الأب.القيمة; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        العمق := العمق + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The DI scope of النطاق: inside an inlined call, relative to the inlined
// function's subprogram; otherwise the function's own scope chain.
عرف نطاق_تصحيح_سياقي_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    النطاق: معرف_نطاق_تصحيح
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    طابق نطاق_مضمن_محيط_إل_إل_في_إم(حالة_التصحيح, البيانات, النطاق) مع
    | اختياري.لا_شيء -> { أرجع نطاق_تصحيح_إل_إل_في_إم(حالة_التصحيح, البيانات, المصادر, الأصول, النطاق); }
    | اختياري.موجود(المحيط) -> {
        ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(&متغير (*حالة_التصحيح).النطاقات_في_المضمن, النطاق.القيمة);
        طابق (*حالة_التصحيح).النطاقات_في_المضمن[النطاق.القيمة] مع | اختياري.موجود(م) -> { أرجع م; } | اختياري.لا_شيء -> { };
        دع الناتج: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).الفارغ;
        إذا (المحيط.القيمة == النطاق.القيمة) {
            طابق (*البيانات).الدلالي.النطاقات[النطاق.القيمة].الدالة_المضمنة مع
            | اختياري.موجود(المضمنة) -> {
                طابق (*حالة_التصحيح).الدوال[المضمنة.القيمة] مع
                | اختياري.موجود(البرنامج_الفرعي) -> { الناتج := البرنامج_الفرعي; }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        } وإلا {
            دع الأب: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).الفارغ;
            طابق (*البيانات).الدلالي.النطاقات[النطاق.القيمة].الأب مع
            | اختياري.موجود(أ) -> { الأب := نطاق_تصحيح_سياقي_إل_إل_في_إم(حالة_التصحيح, البيانات, المصادر, الأصول, أ); }
            | اختياري.لا_شيء -> { };
            دع الإحداثي: إحداثي_تصحيح_إل_إل_في_إم = إحداثي_أصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, المصادر, الأصول,
                (*البيانات).الدلالي.النطاقات[النطاق.القيمة].الأصل);
            الناتج := أنشئ_نطاق_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, الأب,
                الإحداثي.الملف, الإحداثي.السطر, الإحداثي.العمود);
        };
        (*حالة_التصحيح).النطاقات_في_المضمن[النطاق.القيمة] := اختياري.موجود(الناتج);
        أرجع الناتج;
    };
}

// The DILocation of source origin الأصل in scope النطاق, with the chain of
// calls it was inlined at. الاحتياطي is the function's own subprogram, the
// scope of a call made outside any scope.
عرف موقع_في_نطاق_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    حالة_المزود: &حالة_مزود_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر,
    النطاق: معرف_نطاق_تصحيح,
    الاحتياطي: مرجع_بيانات_وصفية_إل_إل_في_إم,
    العمق: طبيعي
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    دع النطاق_المعين: مرجع_بيانات_وصفية_إل_إل_في_إم = نطاق_تصحيح_سياقي_إل_إل_في_إم(
        حالة_التصحيح, البيانات, المصادر, الأصول, النطاق
    );
    دع المضمن_في: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).الفارغ;
    إذا (العمق < 64) {
        طابق نطاق_مضمن_محيط_إل_إل_في_إم(حالة_التصحيح, البيانات, النطاق) مع
        | اختياري.موجود(المحيط) -> {
            دع أصل_النداء: متغير معرف_أصل_مصدر = الأصل;
            طابق (*البيانات).الدلالي.النطاقات[المحيط.القيمة].مضمن_عند مع
            | اختياري.موجود(م) -> {
                إذا (م.القيمة < (الطول((*البيانات).الدلالي.المواقع) مثل طبيعي)) {
                    أصل_النداء := (*البيانات).الدلالي.المواقع[م.القيمة].الأصل;
                };
            }
            | اختياري.لا_شيء -> { };
            طابق (*البيانات).الدلالي.النطاقات[المحيط.القيمة].الأب مع
            | اختياري.موجود(أ) -> {
                المضمن_في := موقع_في_نطاق_إل_إل_في_إم(حالة_التصحيح, حالة_المزود, البيانات, المصادر, الأصول,
                    أصل_النداء, أ, الاحتياطي, العمق + 1);
            }
            | اختياري.لا_شيء -> {
                دع إحداثي_النداء: إحداثي_تصحيح_إل_إل_في_إم = إحداثي_أصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, المصادر,
                    الأصول, أصل_النداء);
                المضمن_في := أنشئ_موقع_تصحيح_إل_إل_في_إم((*حالة_المزود).السياق, إحداثي_النداء.السطر,
                    إحداثي_النداء.العمود, الاحتياطي, (*حالة_التصحيح).الفارغ);
            };
        }
        | اختياري.لا_شيء -> { };
    };
    دع الإحداثي: إحداثي_تصحيح_إل_إل_في_إم = إحداثي_أصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, المصادر, الأصول, الأصل);
    أرجع أنشئ_موقع_تصحيح_إل_إل_في_إم((*حالة_المزود).السياق, الإحداثي.السطر, الإحداثي.العمود,
        النطاق_المعين, المضمن_في);
}

عرف موقع_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    حالة_المزود: &حالة_مزود_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    المعرف: معرف_موقع_تصحيح,
    النطاق_الافتراضي: مرجع_بيانات_وصفية_إل_إل_في_إم
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(&متغير (*حالة_التصحيح).المواقع, المعرف.القيمة);
    طابق (*حالة_التصحيح).المواقع[المعرف.القيمة] مع | اختياري.موجود(م) -> { أرجع م; } | اختياري.لا_شيء -> { };
    إذا (المعرف.القيمة >= (الطول((*البيانات).الدلالي.المواقع) مثل طبيعي)) { أرجع (*حالة_التصحيح).الفارغ; };
    دع الموقع: &موقع_تصحيح = &(*البيانات).الدلالي.المواقع[المعرف.القيمة];
    دع النطاق: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = النطاق_الافتراضي;
    طابق (*الموقع).النطاق مع | اختياري.موجود(ن) -> { النطاق := نطاق_تصحيح_إل_إل_في_إم(حالة_التصحيح, البيانات,
        المصادر, الأصول, ن); } | اختياري.لا_شيء -> { };
    دع الإحداثي: إحداثي_تصحيح_إل_إل_في_إم = إحداثي_أصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, المصادر, الأصول,
        (*الموقع).الأصل);
    دع م: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_موقع_تصحيح_إل_إل_في_إم((*حالة_المزود).السياق, الإحداثي.السطر,
        الإحداثي.العمود, النطاق, (*حالة_التصحيح).الفارغ);
    (*حالة_التصحيح).المواقع[المعرف.القيمة] := اختياري.موجود(م);
    أرجع م;
}

عرف نوع_توقيع_دالة_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البيانات: &بيانات_تصحيح_مسير,
    الدالة: &دالة_تصحيح
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    دع الأنواع: متغير متجه مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    طابق (*الدالة).الناتج مع
    | اختياري.موجود(ن) -> { ألحق(الأنواع, نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط,
        البيانات, ن)); }
    | اختياري.لا_شيء -> { ألحق(الأنواع, (*حالة_التصحيح).الفارغ); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        دع م: معرف_متغير_تصحيح = (*الدالة).المعاملات[ف];
        إذا (م.القيمة < (الطول((*البيانات).الدلالي.المتغيرات) مثل طبيعي)) {
            ألحق(الأنواع, نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات,
                (*البيانات).الدلالي.المتغيرات[م.القيمة].النوع));
        };
        ف := ف + 1;
    }
    أرجع أنشئ_نوع_دالة_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, (*حالة_التصحيح).الملف_الافتراضي, &متغير
        الأنواع[0], الطول(الأنواع) مثل ط32);
}

عام عرف أعلن_تصحيح_وحدة_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    حالة_المزود: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا (!(*حالة_التصحيح).مفعلة) { أرجع اختياري.لا_شيء(); };
    // Materialize canonical source modules first so functions/globals/constants can use them as scopes.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيانات).الدلالي.الوحدات) مثل طبيعي)) {
        دع الوحدة: &وحدة_تصحيح = &(*البيانات).الدلالي.الوحدات[ف];
        ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(&متغير (*حالة_التصحيح).الوحدات, (*الوحدة).المعرف.القيمة);
        دع الاسم_الخام: متجه ط8 = انسخ_بايتات_إل_إل_في_إم(&(*الوحدة).الاسم);
        دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
        دع فارغ_الوحدة: متغير متجه ط8 = [0];
        دع وصف: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_نطاق_وحدة_تصحيح_إل_إل_في_إم(
            (*حالة_التصحيح).الباني, (*حالة_التصحيح).وحدة_التجميع,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_الخام) مثل طبيعي),
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ_الوحدة)
        );
        دع موضع_الوحدة: طبيعي = (*الوحدة).المعرف.القيمة;
        (*حالة_التصحيح).الوحدات[موضع_الوحدة] := اختياري.موجود(وصف);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(معرف_المسير) -> {
            طابق دالة_تصحيح_لمسير(&(*البيانات).العقد, معرف_المسير) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(معرف_التصحيح) -> {
                إذا (معرف_التصحيح.القيمة < (الطول((*البيانات).الدلالي.الدوال) مثل طبيعي)) {
                    ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(&متغير (*حالة_التصحيح).الدوال, معرف_التصحيح.القيمة);
                    دع د: &دالة_تصحيح = &(*البيانات).الدلالي.الدوال[معرف_التصحيح.القيمة];
                    دع الإحداثي: إحداثي_تصحيح_إل_إل_في_إم = إحداثي_أصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, المصادر,
                        الأصول, (*د).الأصل);
                    دع الاسم_خام: متجه ط8 = انسخ_بايتات_إل_إل_في_إم(&(*د).الاسم);
                    دع الربط_خام: متجه ط8 = انسخ_بايتات_إل_إل_في_إم(&(*د).اسم_الربط);
                    دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_خام);
                    دع الربط: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الربط_خام);
                    دع نوع_الدالة: مرجع_بيانات_وصفية_إل_إل_في_إم =
                        نوع_توقيع_دالة_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط, البيانات,
                        د);
                    دع نطاق_الوحدة: مرجع_بيانات_وصفية_إل_إل_في_إم =
                        نطاق_وحدة_لأصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, البيانات, الأصول, (*د).الأصل);
                    دع وصف: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_دالة_تصحيح_إل_إل_في_إم(
                        (*حالة_التصحيح).الباني, نطاق_الوحدة,
                        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_خام) مثل طبيعي),
                        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الربط), (الطول(الربط_خام) مثل طبيعي),
                        الإحداثي.الملف, الإحداثي.السطر, نوع_الدالة,
                        !(*د).علني, !(*د).إعلان_فقط, (*د).اصطناعي, (*حالة_التصحيح).محسن
                    );
                    (*حالة_التصحيح).الدوال[معرف_التصحيح.القيمة] := اختياري.موجود(وصف);
                    إذا ((معرف_المسير.القيمة مثل طبيعي) < (الطول((*حالة_المزود).الدوال) مثل طبيعي)) {
                        طابق (*حالة_المزود).الدوال[معرف_المسير.القيمة] مع | اختياري.موجود(ق) -> {
                            اربط_دالة_بتصحيح_إل_إل_في_إم(ق.الدالة, وصف); } | اختياري.لا_شيء -> { };
                    };
                    طابق (*د).النطاق_الجذري مع
                    | اختياري.موجود(ن) -> { ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(&متغير
                        (*حالة_التصحيح).النطاقات, ن.القيمة); (*حالة_التصحيح).النطاقات[ن.القيمة] :=
                        اختياري.موجود(وصف); }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*المسير).المسير.العوام) مثل طبيعي)) {
        دع معرف_العام: معرف_عام_مسير = (*المسير).المسير.العوام[ف].المعرف;
        طابق عام_تصحيح_لمسير(&(*البيانات).العقد, معرف_العام) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(معرف_التصحيح) -> {
            إذا (معرف_التصحيح.القيمة < (الطول((*البيانات).الدلالي.العوام) مثل طبيعي) && (معرف_العام.القيمة مثل طبيعي) <
                (الطول((*حالة_المزود).العوام) مثل طبيعي)) {
                طابق (*حالة_المزود).العوام[معرف_العام.القيمة] مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(قيد) -> {
                    دع ع: &عام_تصحيح = &(*البيانات).الدلالي.العوام[معرف_التصحيح.القيمة];
                    دع الإحداثي: إحداثي_تصحيح_إل_إل_في_إم = إحداثي_أصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, المصادر,
                        الأصول, (*ع).الأصل);
                    دع الاسم_خام: متجه ط8 = انسخ_بايتات_إل_إل_في_إم(&(*ع).الاسم); دع الاسم: متغير متجه ط8 =
                        اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_خام);
                    دع الربط_خام: متجه ط8 = انسخ_بايتات_إل_إل_في_إم(&(*ع).اسم_الربط); دع الربط: متغير متجه ط8 =
                        اجعل_اسما_سي_لإل_إل_في_إم(&الربط_خام);
                    دع النوع: مرجع_بيانات_وصفية_إل_إل_في_إم = نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق,
                        الهدف, سجل_التخطيط, البيانات, (*ع).النوع);
                    دع نطاق_الوحدة: مرجع_بيانات_وصفية_إل_إل_في_إم =
                        نطاق_وحدة_لأصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, البيانات, الأصول, (*ع).الأصل);
                    دع وصف: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_عام_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني,
                        نطاق_الوحدة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_خام) مثل طبيعي),
                        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الربط), (الطول(الربط_خام) مثل طبيعي), الإحداثي.الملف,
                        الإحداثي.السطر, النوع, !(*ع).علني, (*حالة_التصحيح).التعبير_الفارغ,
                        (*حالة_التصحيح).الفارغ, 0);
                    أضف_تصحيح_عام_إل_إل_في_إم(قيد.القيمة, وصف);
                };
            };
        };
        ف := ف + 1;
    }
    // Immutable top-level constants do not own an LLVM global. Emit their canonical
    // debug value directly when the MSIR debug contract carries a scalar value.
    ف := 0;
    طالما (ف < (الطول((*البيانات).الدلالي.الثوابت) مثل طبيعي)) {
        دع ث: &ثابت_تصحيح = &(*البيانات).الدلالي.الثوابت[ف];
        دع قيمة_خام: متغير اختياري ط64 = اختياري.لا_شيء();
        طابق (*ث).القيمة مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(قيمة) -> {
            طابق قيمة مع
            | قيمة_ثابت_تصحيح.منطق(ق) -> { إذا (ق) { قيمة_خام := اختياري.موجود(1); } وإلا { قيمة_خام :=
                اختياري.موجود(0); }; }
            | قيمة_ثابت_تصحيح.صحيح_موقع(ق) -> { قيمة_خام := اختياري.موجود(ق مثل ط64); }
            | قيمة_ثابت_تصحيح.صحيح_طبيعي(ق) -> { قيمة_خام := اختياري.موجود(ق مثل ط64); };
        };
        طابق قيمة_خام مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(قيمة) -> {
            دع الإحداثي: إحداثي_تصحيح_إل_إل_في_إم = إحداثي_أصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, المصادر, الأصول,
                (*ث).الأصل);
            دع الاسم_خام: متجه ط8 = انسخ_بايتات_إل_إل_في_إم(&(*ث).الاسم);
            دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_خام);
            دع اسم_ربط: متغير متجه ط8 = [0];
            دع النوع: مرجع_بيانات_وصفية_إل_إل_في_إم = نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف,
                سجل_التخطيط, البيانات, (*ث).النوع);
            دع التعبير: مرجع_بيانات_وصفية_إل_إل_في_إم =
                أنشئ_تعبير_قيمة_ثابتة_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, قيمة);
            دع نطاق_الوحدة: مرجع_بيانات_وصفية_إل_إل_في_إم = نطاق_وحدة_لأصل_تصحيح_إل_إل_في_إم(حالة_التصحيح,
                البيانات, الأصول, (*ث).الأصل);
            أنشئ_عام_تصحيح_إل_إل_في_إم(
                (*حالة_التصحيح).الباني, نطاق_الوحدة,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), (الطول(الاسم_خام) مثل طبيعي),
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_ربط), 0,
                الإحداثي.الملف, الإحداثي.السطر, النوع, !(*ث).علني,
                التعبير, (*حالة_التصحيح).الفارغ, 0
            );
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف رقم_معامل_تصحيح_إل_إل_في_إم(البيانات: &بيانات_تصحيح_مسير, المتغير: معرف_متغير_تصحيح): ط32 {
    إذا (المتغير.القيمة >= (الطول((*البيانات).الدلالي.المتغيرات) مثل طبيعي)) { أرجع 0; };
    دع و: &متغير_تصحيح = &(*البيانات).الدلالي.المتغيرات[المتغير.القيمة];
    إذا ((*و).النطاق.القيمة >= (الطول((*البيانات).الدلالي.النطاقات) مثل طبيعي)) { أرجع 0; };
    دع معرف_النطاق: طبيعي = (*و).النطاق.القيمة;
    دع معرف_الدالة: معرف_دالة_تصحيح = (*البيانات).الدلالي.النطاقات[معرف_النطاق].الدالة;
    إذا (معرف_الدالة.القيمة >= (الطول((*البيانات).الدلالي.الدوال) مثل طبيعي)) { أرجع 0; };
    دع د: &دالة_تصحيح = &(*البيانات).الدلالي.الدوال[معرف_الدالة.القيمة];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*د).المعاملات) مثل طبيعي)) {
        إذا ((*د).المعاملات[ف].القيمة == المتغير.القيمة) { أرجع (ف + 1) مثل ط32; };
        ف := ف + 1;
    }
    أرجع 0;
}

عرف متغير_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    المعرف: معرف_متغير_تصحيح
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(&متغير (*حالة_التصحيح).المتغيرات, المعرف.القيمة);
    طابق (*حالة_التصحيح).المتغيرات[المعرف.القيمة] مع | اختياري.موجود(م) -> { أرجع م; } | اختياري.لا_شيء -> { };
    إذا (المعرف.القيمة >= (الطول((*البيانات).الدلالي.المتغيرات) مثل طبيعي)) { أرجع (*حالة_التصحيح).الفارغ; };
    دع و: &متغير_تصحيح = &(*البيانات).الدلالي.المتغيرات[المعرف.القيمة];
    دع النطاق: مرجع_بيانات_وصفية_إل_إل_في_إم = نطاق_تصحيح_سياقي_إل_إل_في_إم(حالة_التصحيح, البيانات, المصادر, الأصول,
        (*و).النطاق);
    دع الإحداثي: إحداثي_تصحيح_إل_إل_في_إم = إحداثي_أصل_تصحيح_إل_إل_في_إم(حالة_التصحيح, المصادر, الأصول,
        (*و).الأصل);
    دع النوع: مرجع_بيانات_وصفية_إل_إل_في_إم = نوع_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف, سجل_التخطيط,
        البيانات, (*و).النوع);
    دع الاسم_خام: متجه ط8 = انسخ_بايتات_إل_إل_في_إم(&(*و).الاسم); دع الاسم: متغير متجه ط8 =
        اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_خام);
    دع وصف: مرجع_بيانات_وصفية_إل_إل_في_إم;
    طابق (*و).الصنف مع
    | صنف_متغير_تصحيح.معامل -> {
        وصف := أنشئ_معامل_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, النطاق, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
            الاسم), (الطول(الاسم_خام) مثل طبيعي), رقم_معامل_تصحيح_إل_إل_في_إم(البيانات, المعرف),
            الإحداثي.الملف, الإحداثي.السطر, النوع, (*و).اصطناعي);
    }
    | _ -> {
        وصف := أنشئ_محلي_تصحيح_إل_إل_في_إم((*حالة_التصحيح).الباني, النطاق, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
            الاسم), (الطول(الاسم_خام) مثل طبيعي), الإحداثي.الملف, الإحداثي.السطر, النوع, (*و).اصطناعي, 0);
    };
    (*حالة_التصحيح).المتغيرات[المعرف.القيمة] := اختياري.موجود(وصف);
    أرجع وصف;
}

عام عرف ضع_موقع_تعليمة_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    حالة_المزود: &حالة_مزود_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    التعليمة: &عرض_تعليمة_مسير
): فراغ {
    إذا (!(*حالة_التصحيح).مفعلة) { أرجع; };
    دع معرف_الموقع: متغير اختياري معرف_موقع_تصحيح = (*التعليمة).موقع_التصحيح;
    طابق معرف_الموقع مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        طابق (*التعليمة).الناتج مع
        | اختياري.موجود(قيمة) -> { معرف_الموقع := موقع_تصحيح_لقيمة(&(*البيانات).العقد, قيمة); }
        | اختياري.لا_شيء -> { };
    };
    طابق معرف_الموقع مع
    | اختياري.لا_شيء -> { ضع_موقع_تصحيح_حالي_إل_إل_في_إم((*حالة_المزود).الباني, (*حالة_التصحيح).موقع_الدالة); }
    | اختياري.موجود(م) -> {
        // A function without a subprogram (code reached only from comptime
        // in an object output) gets no location: a DILocation needs a local scope.
        إذا ((*حالة_التصحيح).موقع_الدالة == (*حالة_التصحيح).الفارغ) {
            ضع_موقع_تصحيح_حالي_إل_إل_في_إم((*حالة_المزود).الباني, (*حالة_التصحيح).الفارغ);
            أرجع;
        };
        دع النطاق: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).وحدة_التجميع;
        طابق دالة_تصحيح_لمسير(&(*البيانات).العقد, الدالة) مع
        | اختياري.موجود(د) -> { إذا (د.القيمة < (الطول((*حالة_التصحيح).الدوال) مثل طبيعي)) { طابق
            (*حالة_التصحيح).الدوال[د.القيمة] مع | اختياري.موجود(و) -> { النطاق := و; } | اختياري.لا_شيء -> { }; }; }
        | اختياري.لا_شيء -> { };
        دع الموقع: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).الفارغ;
        طابق (*التعليمة).نطاق_التصحيح مع
        | اختياري.موجود(نطاق_التعليمة) -> {
            إذا (م.القيمة < (الطول((*البيانات).الدلالي.المواقع) مثل طبيعي)) {
                الموقع := موقع_في_نطاق_إل_إل_في_إم(حالة_التصحيح, حالة_المزود, البيانات, المصادر, الأصول,
                    (*البيانات).الدلالي.المواقع[م.القيمة].الأصل, نطاق_التعليمة, النطاق, 0);
            };
        }
        | اختياري.لا_شيء -> {
            الموقع := موقع_تصحيح_إل_إل_في_إم(حالة_التصحيح, حالة_المزود, البيانات, المصادر, الأصول, م, النطاق);
        };
        ضع_موقع_تصحيح_حالي_إل_إل_في_إم((*حالة_المزود).الباني, الموقع);
    };
}

عام عرف امسح_موقع_تعليمة_تصحيح_إل_إل_في_إم(حالة_التصحيح: &حالة_تصحيح_إل_إل_في_إم, حالة_المزود:
    &حالة_مزود_إل_إل_في_إم): فراغ {
    إذا ((*حالة_التصحيح).مفعلة) { ضع_موقع_تصحيح_حالي_إل_إل_في_إم((*حالة_المزود).الباني, (*حالة_التصحيح).موقع_الدالة);
        };
}

// Clears the fallback location once a function is lowered, so code emitted
// outside any function with a subprogram (the process entry) carries none.
عام عرف أنه_دالة_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    حالة_المزود: &حالة_مزود_إل_إل_في_إم
): فراغ {
    إذا (!(*حالة_التصحيح).مفعلة) { أرجع; };
    (*حالة_التصحيح).موقع_الدالة := (*حالة_التصحيح).الفارغ;
    ضع_موقع_تصحيح_حالي_إل_إل_في_إم((*حالة_المزود).الباني, (*حالة_التصحيح).الفارغ);
}

// Sets the line-0 fallback location of the function about to be lowered.
عام عرف ابدأ_دالة_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    حالة_المزود: &حالة_مزود_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): فراغ {
    إذا (!(*حالة_التصحيح).مفعلة) { أرجع; };
    (*حالة_التصحيح).موقع_الدالة := (*حالة_التصحيح).الفارغ;
    طابق دالة_تصحيح_لمسير(&(*البيانات).العقد, الدالة) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(د) -> {
        إذا (د.القيمة < (الطول((*حالة_التصحيح).الدوال) مثل طبيعي)) {
            طابق (*حالة_التصحيح).الدوال[د.القيمة] مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(البرنامج_الفرعي) -> {
                (*حالة_التصحيح).موقع_الدالة := أنشئ_موقع_تصحيح_إل_إل_في_إم((*حالة_المزود).السياق,
                    0, 0, البرنامج_الفرعي, (*حالة_التصحيح).الفارغ);
            };
        };
    };
    ضع_موقع_تصحيح_حالي_إل_إل_في_إم((*حالة_المزود).الباني, (*حالة_التصحيح).موقع_الدالة);
}

عام عرف سجل_قيمة_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    حالة_المزود: &حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    القيمة: معرف_قيمة_مسير,
    التمثيل: &تمثيل_قيمة_إل_إل_في_إم,
    قبل_التعليمة: مرجع_قيمة_إل_إل_في_إم
): فراغ {
    إذا (!(*حالة_التصحيح).مفعلة) { أرجع; };
    إذا ((*حالة_التصحيح).موقع_الدالة == (*حالة_التصحيح).الفارغ) { أرجع; };
    دع المتغيرات: متجه معرف_متغير_تصحيح = متغيرات_تصحيح_لقيمة(&(*البيانات).العقد, القيمة);
    إذا ((الطول(المتغيرات) مثل طبيعي) == 0) { أرجع; };
    دع النطاق_الدالة: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).وحدة_التجميع;
    طابق دالة_تصحيح_لمسير(&(*البيانات).العقد, القيمة.الدالة) مع | اختياري.موجود(د) -> { إذا (د.القيمة <
        (الطول((*حالة_التصحيح).الدوال) مثل طبيعي)) { طابق (*حالة_التصحيح).الدوال[د.القيمة] مع |
        اختياري.موجود(و) -> { النطاق_الدالة := و; } | اختياري.لا_شيء -> { }; }; } | اختياري.لا_شيء -> { };
    دع موقع_القيمة: اختياري معرف_موقع_تصحيح = موقع_تصحيح_لقيمة(&(*البيانات).العقد, القيمة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المتغيرات) مثل طبيعي)) {
        دع وصف: مرجع_بيانات_وصفية_إل_إل_في_إم = متغير_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحقائق, الهدف,
            سجل_التخطيط, البيانات, المصادر, الأصول, المتغيرات[ف]);
        // The record's location is in the variable's own scope (and, in an
        // inlined call, has the same inlinedAt chain as the variable's scope).
        دع الموقع: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = (*حالة_التصحيح).الفارغ;
        إذا (المتغيرات[ف].القيمة < (الطول((*البيانات).الدلالي.المتغيرات) مثل طبيعي)) {
            دع أصل_الموقع: متغير معرف_أصل_مصدر = (*البيانات).الدلالي.المتغيرات[المتغيرات[ف].القيمة].الأصل;
            طابق موقع_القيمة مع
            | اختياري.موجود(م) -> {
                إذا (م.القيمة < (الطول((*البيانات).الدلالي.المواقع) مثل طبيعي)) {
                    أصل_الموقع := (*البيانات).الدلالي.المواقع[م.القيمة].الأصل;
                };
            }
            | اختياري.لا_شيء -> { };
            الموقع := موقع_في_نطاق_إل_إل_في_إم(حالة_التصحيح, حالة_المزود, البيانات, المصادر, الأصول,
                أصل_الموقع, (*البيانات).الدلالي.المتغيرات[المتغيرات[ف].القيمة].النطاق, النطاق_الدالة, 0);
        };
        طابق *التمثيل مع
        | تمثيل_قيمة_إل_إل_في_إم.سلمية(ق) -> {
            أدرج_قيمة_متغير_تصحيح_قبل_تعليمة_إل_إل_في_إم((*حالة_التصحيح).الباني, ق, وصف,
            (*حالة_التصحيح).التعبير_الفارغ, الموقع, قبل_التعليمة); }
        | تمثيل_قيمة_إل_إل_في_إم.عنوان(ع) -> {
            أدرج_تصريح_متغير_تصحيح_قبل_تعليمة_إل_إل_في_إم((*حالة_التصحيح).الباني, ع, وصف,
            (*حالة_التصحيح).التعبير_الفارغ, الموقع, قبل_التعليمة); };
        ف := ف + 1;
    }
}
