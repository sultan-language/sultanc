// بيانات LLVM هنا مرايا أجنبية فقط. الهوية والدلالة تبقيان في عقد تصحيح MSIR المقنن.
عام نوع حالة_تصحيح_إل_إل_في_إم = {
    الباني: مرجع_باني_تصحيح_إل_إل_في_إم,
    مفعلة: منطقي,
    مختومة: منطقي,
    الفارغ: مرجع_بيانات_وصفية_إل_إل_في_إم,
    وحدة_التجميع: مرجع_بيانات_وصفية_إل_إل_في_إم,
    الملف_الافتراضي: مرجع_بيانات_وصفية_إل_إل_في_إم,
    التعبير_الفارغ: مرجع_بيانات_وصفية_إل_إل_في_إم,
    الملفات: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم,
    الوحدات: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم,
    الدوال: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم,
    النطاقات: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم,
    الأنواع: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم,
    المتغيرات: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم,
    المواقع: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم,
    محسن: منطقي
};

نوع إحداثي_تصحيح_إل_إل_في_إم = {
    الملف: مرجع_بيانات_وصفية_إل_إل_في_إم,
    السطر: غ32,
    العمود: غ32
};

عرف بايتات_نص_تصحيح_إل_إل_في_إم(النص: &نص): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*النص) مثل غير_موقع)) {
        ألحق(الناتج, (*النص)[ف] مثل غ8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اسم_نوع_افتراضي_تصحيح_إل_إل_في_إم(): متجه غ8 {
    دع الاسم: متجه غ8 = [0x53,0x75,0x6C,0x74,0x61,0x6E,0x43,0x20,0x74,0x79,0x70,0x65];
    أرجع الاسم;
}

عرف اسم_نوع_تصحيح_إل_إل_في_إم(البيانات: &بيانات_تصحيح_مسير, النوع: معرف_نوع): متجه غ8 {
    لو (النوع.القيمة < (الطول((*البيانات).الدلالي.فهرس_الأنواع_الدلالية) مثل غير_موقع)) {
        طابق (*البيانات).الدلالي.فهرس_الأنواع_الدلالية[النوع.القيمة] مع
        | اختيار.بعض(المعرف) -> {
            لو (المعرف.القيمة < (الطول((*البيانات).الدلالي.الأنواع) مثل غير_موقع)) {
                أرجع انسخ_بايتات_إل_إل_في_إم(&(*البيانات).الدلالي.الأنواع[المعرف.القيمة].الاسم);
            };
        }
        | اختيار.لا_شيء -> { };
    };
    أرجع اسم_نوع_افتراضي_تصحيح_إل_إل_في_إم();
}

عرف اسم_عضو_نوع_تصحيح_إل_إل_في_إم(
    البيانات: &بيانات_تصحيح_مسير,
    النوع: معرف_نوع,
    الفهرس: غير_موقع
): متجه غ8 {
    لو (النوع.القيمة < (الطول((*البيانات).الدلالي.فهرس_الأنواع_الدلالية) مثل غير_موقع)) {
        طابق (*البيانات).الدلالي.فهرس_الأنواع_الدلالية[النوع.القيمة] مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(معرف_التصحيح) -> {
            لو (معرف_التصحيح.القيمة < (الطول((*البيانات).الدلالي.الأنواع) مثل غير_موقع)) {
                دع الوصف: &نوع_تصحيح = &(*البيانات).الدلالي.الأنواع[معرف_التصحيح.القيمة];
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول((*الوصف).الأعضاء) مثل غير_موقع)) {
                    لو ((*الوصف).الأعضاء[ف].الفهرس == الفهرس) {
                        أرجع انسخ_بايتات_إل_إل_في_إم(&(*الوصف).الأعضاء[ف].الاسم);
                    };
                    ف := ف + 1;
                }
            };
        };
    };
    دع بلا_اسم: متجه غ8 = [];
    أرجع بلا_اسم;
}

عرف ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(
    المخزن: &متغير متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم,
    الفهرس: غير_موقع
): فراغ {
    بينما ((الطول(*المخزن) مثل غير_موقع) <= الفهرس) {
        ألحق(*المخزن, اختيار.لا_شيء());
    }
}

عرف ملف_تصحيح_إل_إل_في_إم(
    الحالة: &حالة_تصحيح_إل_إل_في_إم,
    المصدر: غير_موقع
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    لو (المصدر < (الطول((*الحالة).الملفات) مثل غير_موقع)) {
        طابق (*الحالة).الملفات[المصدر] مع
        | اختيار.بعض(م) -> { أرجع م; }
        | اختيار.لا_شيء -> { };
    };
    أرجع (*الحالة).الملف_الافتراضي;
}

عرف إحداثي_أصل_تصحيح_إل_إل_في_إم(
    الحالة: &حالة_تصحيح_إل_إل_في_إم,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر
): إحداثي_تصحيح_إل_إل_في_إم {
    دع الناتج: متغير إحداثي_تصحيح_إل_إل_في_إم = {
        الملف: (*الحالة).الملف_الافتراضي,
        السطر: 0,
        العمود: 0
    };
    طابق أصل_مصدر_بالمعرف(الأصول, الأصل) مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(وصف) -> {
        الناتج.الملف := ملف_تصحيح_إل_إل_في_إم(الحالة, وصف.النطاق.البداية.المصدر);
        طابق إحداثي_من_الخريطة(المصادر, وصف.النطاق.البداية) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(إحداثي) -> {
            الناتج.السطر := إحداثي.السطر;
            // SourceMap is zero-based for columns; debugger coordinates are one-based.
            الناتج.العمود := إحداثي.العمود + 1;
        };
        أرجع الناتج;
    };
}

عام عرف أنشئ_حالة_تصحيح_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    المصادر: &خريطة_مصادر,
    محسن: منطقي
): حالة_تصحيح_إل_إل_في_إم {
    دع الباني: مرجع_باني_تصحيح_إل_إل_في_إم = أنشئ_باني_تصحيح_إل_إل_في_إم((*الحالة).الوحدة);
    دع مفتاح_فارغ: متغير متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x2E,0x6E,0x75,0x6C,0x6C];
    دع الفارغ: مرجع_بيانات_وصفية_إل_إل_في_إم = علم_وحدة_إل_إل_في_إم((*الحالة).الوحدة, &متغير مفتاح_فارغ[0],
        الطول(مفتاح_فارغ) مثل غير_موقع);
    دع الملفات: متغير متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع الملف_الافتراضي: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = الفارغ;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*المصادر).المصادر) مثل غير_موقع)) {
        دع بايتات_الاسم: متجه غ8 = بايتات_نص_تصحيح_إل_إل_في_إم(&(*المصادر).المصادر[ف].الاسم);
        دع اسم_سي: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&بايتات_الاسم);
        دع دليل: متغير متجه غ8 = [0];
        دع الملف: مرجع_بيانات_وصفية_إل_إل_في_إم = أنشئ_ملف_تصحيح_إل_إل_في_إم(
            الباني, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_سي), (الطول(بايتات_الاسم) مثل حجم_إل_إل_في_إم),
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير دليل), (0 مثل حجم_إل_إل_في_إم)
        );
        ألحق(الملفات, اختيار.بعض(الملف));
        لو (ف == 0) { الملف_الافتراضي := الملف; };
        ف := ف + 1;
    }
    دع مفعلة: منطقي = (الطول((*المصادر).المصادر) > 0)
        && ((الطول((*البيانات).الدلالي.الدوال) > 0)
            || (الطول((*البيانات).الدلالي.العوام) > 0)
            || (الطول((*البيانات).الدلالي.الثوابت) > 0)
            || (الطول((*البيانات).الدلالي.الوحدات) > 0)
            || (الطول((*البيانات).الدلالي.الأنواع) > 0)
            || (الطول((*البيانات).الدلالي.المواقع) > 0));
    دع وحدة_التجميع: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = الفارغ;
    دع التعبير_الفارغ: متغير مرجع_بيانات_وصفية_إل_إل_في_إم = الفارغ;
    لو (مفعلة) {
        // LLVM 23 debug-record insertion requires the module's new debug-info format.
        فعل_صيغة_سجلات_تصحيح_إل_إل_في_إم((*الحالة).الوحدة);
        // LLVM debug metadata uses its own module-format version independently of DWARF/CodeView policy.
        دع مفتاح_إصدار_التصحيح_خام: متجه غ8 =
            [0x44,0x65,0x62,0x75,0x67,0x20,0x49,0x6E,0x66,0x6F,0x20,0x56,0x65,0x72,0x73,0x69,0x6F,0x6E];
        دع مفتاح_إصدار_التصحيح: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&مفتاح_إصدار_التصحيح_خام);
        دع نوع_غ32: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 32);
        دع قيمة_إصدار_التصحيح: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_غ32, 3, خطأ);
        دع بيانات_إصدار_التصحيح: مرجع_بيانات_وصفية_إل_إل_في_إم =
            بيانات_وصفية_من_قيمة_إل_إل_في_إم(قيمة_إصدار_التصحيح);
        أضف_علم_تحذير_وحدة_إل_إل_في_إم(
            (*الحالة).الوحدة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير مفتاح_إصدار_التصحيح),
            (الطول(مفتاح_إصدار_التصحيح_خام) مثل غير_موقع),
            بيانات_إصدار_التصحيح
        );
        دع المنتج_خام: متجه غ8 = [0x53,0x75,0x6C,0x74,0x61,0x6E,0x43,0x20,0x4C,0x4C,0x56,0x4D];
        دع المنتج: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&المنتج_خام);
        دع الرايات: متغير متجه غ8 = [0];
        وحدة_التجميع := أنشئ_وحدة_تصحيح_إل_إل_في_إم(
            الباني, لغة_مصدر_توافق_تصحيح_إل_إل_في_إم(), الملف_الافتراضي,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير المنتج), (الطول(المنتج_خام) مثل غير_موقع), محسن,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الرايات), 0,
            إصدار_تصحيح_كامل_إل_إل_في_إم()
        );
        دع العمليات: متغير متجه غ64 = [0];
        التعبير_الفارغ := أنشئ_تعبير_تصحيح_فارغ_إل_إل_في_إم(الباني, &متغير العمليات[0]);
    };
    دع الوحدات: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع الدوال: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع النطاقات: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع الأنواع: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع المتغيرات: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع المواقع: متجه اختيار مرجع_بيانات_وصفية_إل_إل_في_إم = [];
    دع الناتج: حالة_تصحيح_إل_إل_في_إم = {
        الباني: الباني, مفعلة: مفعلة, مختومة: خطأ, الفارغ: الفارغ,
        وحدة_التجميع: وحدة_التجميع, الملف_الافتراضي: الملف_الافتراضي,
        التعبير_الفارغ: التعبير_الفارغ, الملفات: الملفات, الوحدات: الوحدات, الدوال: الدوال,
        النطاقات: النطاقات, الأنواع: الأنواع, المتغيرات: المتغيرات, المواقع: المواقع,
        محسن: محسن
    };
    أرجع الناتج;
}

عام عرف اختم_حالة_تصحيح_إل_إل_في_إم(الحالة: &متغير حالة_تصحيح_إل_إل_في_إم): فراغ {
    لو ((*الحالة).مفعلة && !(*الحالة).مختومة) {
        اختم_باني_تصحيح_إل_إل_في_إم((*الحالة).الباني);
        (*الحالة).مختومة := صواب;
    };
}

عام عرف حرر_حالة_تصحيح_إل_إل_في_إم(الحالة: &متغير حالة_تصحيح_إل_إل_في_إم): فراغ {
    حرر_باني_تصحيح_إل_إل_في_إم((*الحالة).الباني);
    (*الحالة).مفعلة := خطأ;
}

عرف مصدر_أصل_تصحيح_إل_إل_في_إم(الأصول: &سجل_أصول_مصدر, الأصل: معرف_أصل_مصدر): اختيار غير_موقع {
    طابق أصل_مصدر_بالمعرف(الأصول, الأصل) مع
    | اختيار.بعض(وصف) -> { أرجع اختيار.بعض(وصف.النطاق.البداية.المصدر); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عرف نطاق_وحدة_لأصل_تصحيح_إل_إل_في_إم(
    الحالة: &حالة_تصحيح_إل_إل_في_إم,
    البيانات: &بيانات_تصحيح_مسير,
    الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    طابق مصدر_أصل_تصحيح_إل_إل_في_إم(الأصول, الأصل) مع
    | اختيار.لا_شيء -> { أرجع (*الحالة).وحدة_التجميع; }
    | اختيار.بعض(المصدر) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول((*البيانات).الدلالي.الوحدات) مثل غير_موقع)) {
            دع الوحدة: &وحدة_تصحيح = &(*البيانات).الدلالي.الوحدات[ف];
            دع معرف_الوحدة: غير_موقع = (*الوحدة).المعرف.القيمة;
            لو ((*الوحدة).معرف_المصدر == المصدر && معرف_الوحدة < (الطول((*الحالة).الوحدات) مثل غير_موقع)) {
                طابق (*الحالة).الوحدات[معرف_الوحدة] مع
                | اختيار.بعض(نطاق) -> { أرجع نطاق; }
                | اختيار.لا_شيء -> { };
            };
            ف := ف + 1;
        }
    };
    أرجع (*الحالة).وحدة_التجميع;
}

عام عرف نوع_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البيانات: &بيانات_تصحيح_مسير,
    النوع: معرف_نوع
): مرجع_بيانات_وصفية_إل_إل_في_إم {
    لو (!(*حالة_التصحيح).مفعلة) { أرجع (*حالة_التصحيح).الفارغ; };
    ضمن_مخزن_بيانات_وصفية_تصحيح_إل_إل_في_إم(&متغير (*حالة_التصحيح).الأنواع, النوع.القيمة);
    طابق (*حالة_التصحيح).الأنواع[النوع.القيمة] مع
    | اختيار.بعض(م) -> { أرجع م; }
    | اختيار.لا_شيء -> { };
    دع الاسم_الخام: متجه غ8 = اسم_نوع_تصحيح_إل_إل_في_إم(البيانات, النوع);
