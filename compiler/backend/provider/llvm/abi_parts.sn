استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.values;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.abi.abi_model;
استورد std.text.from_bytes;

// The LLVM provider's single conversion between a value in memory and the
// register parts its canonical ABI plan assigns (target_abi_resolution.sn).
// The plan decides the parts; this module only spells them in LLVM IR:
// - with part shapes, each part is float/double (floating class) or iN of the
//   part's byte size (integer class) at the shape's offset;
// - without shapes, parts are the 8-byte integer chunks of the value;
// - a consecutive register block (كتلة_متصلة) travels as one [N x part] array
//   value, which LLVM's AArch64 and PowerPC lowering never splits between
//   registers and the stack, as AAPCS64 and ELFv2 require.
// Values are copied through a padded temporary when the IR parts cover more
// bytes than the value, so no load or store reaches past the value.

عرف أشكال_موجودة_إل_إل_في_إم(الأشكال: &متجه شكل_جزء_واجهة, العدد: غير_موقع): منطقي {
    أرجع العدد > 0 && (الطول(*الأشكال) مثل غير_موقع) == العدد;
}

عام عرف إزاحة_جزء_واجهة_إل_إل_في_إم(
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    ف: غير_موقع
): غير_موقع {
    لو (أشكال_موجودة_إل_إل_في_إم(الأشكال, (*التصنيف).عدد_الأجزاء)) {
        أرجع (*الأشكال)[ف].الإزاحة;
    };
    أرجع ف * 8;
}

عرف حجم_جزء_واجهة_إل_إل_في_إم(
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    ف: غير_موقع
): غير_موقع {
    لو (أشكال_موجودة_إل_إل_في_إم(الأشكال, (*التصنيف).عدد_الأجزاء)) {
        أرجع (*الأشكال)[ف].الحجم;
    };
    دع البداية: غير_موقع = ف * 8;
    دع المتبقي: متغير غير_موقع = 1;
    لو ((*التصنيف).الحجم > البداية) { المتبقي := (*التصنيف).الحجم - البداية; };
    لو (المتبقي > 8) { المتبقي := 8; };
    أرجع المتبقي;
}

عام عرف نوع_جزء_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    ف: غير_موقع
): مرجع_نوع_إل_إل_في_إم {
    لو (أشكال_موجودة_إل_إل_في_إم(الأشكال, (*التصنيف).عدد_الأجزاء)) {
        دع الشكل: شكل_جزء_واجهة = (*الأشكال)[ف];
        لو (الشكل.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
            لو (الشكل.الحجم == 4) { أرجع نوع_ع32_إل_إل_في_إم((*الحالة).السياق); };
            أرجع نوع_ع64_إل_إل_في_إم((*الحالة).السياق);
        };
        أرجع نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (الشكل.الحجم * 8) مثل غ32);
    };
    دع الحجم: غير_موقع = حجم_جزء_واجهة_إل_إل_في_إم(التصنيف, الأشكال, ف);
    أرجع نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (الحجم * 8) مثل غ32);
}

عام عرف أجزاء_ككتلة_إل_إل_في_إم(التصنيف: &تصنيف_قيمة_واجهة): منطقي {
    أرجع (*التصنيف).كتلة_متصلة && (*التصنيف).عدد_الأجزاء > 1;
}

// A block's element type is the type of its widest part (block parts share
// one size; a shorter trailing integer chunk widens to it).
عرف نوع_عنصر_كتلة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة
): مرجع_نوع_إل_إل_في_إم {
    لو (أشكال_موجودة_إل_إل_في_إم(الأشكال, (*التصنيف).عدد_الأجزاء)) {
        دع الأول: شكل_جزء_واجهة = (*الأشكال)[0];
        لو (الأول.الفئة == فئة_سجل_واجهة.عائم_متجه()) {
            أرجع نوع_جزء_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال, 0);
        };
        أرجع نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (الأول.الحجم * 8) مثل غ32);
    };
    أرجع نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
}

عرف حجم_عنصر_كتلة_إل_إل_في_إم(
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة
): غير_موقع {
    لو (أشكال_موجودة_إل_إل_في_إم(الأشكال, (*التصنيف).عدد_الأجزاء)) {
        أرجع (*الأشكال)[0].الحجم;
    };
    أرجع 8;
}

عام عرف نوع_كتلة_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة
): مرجع_نوع_إل_إل_في_إم {
    أرجع نوع_مصفوفة_إل_إل_في_إم(
        نوع_عنصر_كتلة_إل_إل_في_إم(الحالة, التصنيف, الأشكال),
        (*التصنيف).عدد_الأجزاء مثل غ64
    );
}

// IR parameter types a register-class aggregate contributes to a signature.
عام عرف ألحق_أنواع_أجزاء_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    الناتج: &متغير متجه مرجع_نوع_إل_إل_في_إم
): فراغ {
    لو (أجزاء_ككتلة_إل_إل_في_إم(التصنيف)) {
        ألحق(*الناتج, نوع_كتلة_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال));
        أرجع;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*التصنيف).عدد_الأجزاء) {
        ألحق(*الناتج, نوع_جزء_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال, ف));
        ف := ف + 1;
    }
}

// Number of IR parameters a register-class aggregate occupies.
عام عرف عدد_معاملات_أجزاء_واجهة_إل_إل_في_إم(التصنيف: &تصنيف_قيمة_واجهة): غير_موقع {
    لو (أجزاء_ككتلة_إل_إل_في_إم(التصنيف)) { أرجع 1; };
    أرجع (*التصنيف).عدد_الأجزاء;
}

// IR type of a register-class aggregate returned as one value.
عام عرف نوع_قيمة_أجزاء_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة
): مرجع_نوع_إل_إل_في_إم {
    لو (أجزاء_ككتلة_إل_إل_في_إم(التصنيف)) {
        أرجع نوع_كتلة_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال);
    };
    لو ((*التصنيف).عدد_الأجزاء <= 1) {
        أرجع نوع_جزء_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال, 0);
    };
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    ألحق_أنواع_أجزاء_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال, &متغير الأنواع);
    أرجع نوع_بنية_إل_إل_في_إم(
        (*الحالة).السياق, &متغير الأنواع[0], الطول(الأنواع) مثل غ32
    );
}

// Largest power of two (≤ 16) dividing both the part offset and the value
// alignment: the alignment a part access may assume.
عرف محاذاة_جزء_إل_إل_في_إم(محاذاة_القيمة: غير_موقع, الإزاحة: غير_موقع, الحجم: غير_موقع): غ32 {
    دع م: متغير غير_موقع = 16;
    بينما (م > 1 && (م > محاذاة_القيمة || (الإزاحة % م) != 0 || م > الحجم)) {
        م := م / 2;
    }
    أرجع م مثل غ32;
}

عرف ثابت_حجم_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم, الحجم: غير_موقع): مرجع_قيمة_إل_إل_في_إم {
    أرجع ثابت_صحيح_إل_إل_في_إم(
        نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64), الحجم مثل غ64, خطأ
    );
}

// A temporary of the block's array type holding the value's bytes.
عرف كتلة_مؤقتة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة
): مرجع_قيمة_إل_إل_في_إم {
    دع اسم: متغير متجه غ8 = [0];
    دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_حجز_إل_إل_في_إم(
        (*الحالة).باني_الحجز,
        نوع_كتلة_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال),
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
    );
    دع المحاذاة: متغير غير_موقع = حجم_عنصر_كتلة_إل_إل_في_إم(التصنيف, الأشكال);
    لو ((*التصنيف).المحاذاة > المحاذاة) { المحاذاة := (*التصنيف).المحاذاة; };
    ضع_محاذاة_قيمة_إل_إل_في_إم(المكان, المحاذاة مثل غ32);
    أرجع المكان;
}

عرف محاذاة_كتلة_إل_إل_في_إم(
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة
): غ32 {
    دع المحاذاة: متغير غير_موقع = حجم_عنصر_كتلة_إل_إل_في_إم(التصنيف, الأشكال);
    لو ((*التصنيف).المحاذاة > المحاذاة) { المحاذاة := (*التصنيف).المحاذاة; };
    أرجع المحاذاة مثل غ32;
}

عرف محاذاة_قيمة_آمنة_إل_إل_في_إم(التصنيف: &تصنيف_قيمة_واجهة): غ32 {
    لو ((*التصنيف).المحاذاة == 0) { أرجع 1; };
    أرجع (*التصنيف).المحاذاة مثل غ32;
}

عرف حمّل_كتلة_من_عنوان_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    العنوان: مرجع_قيمة_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة
): مرجع_قيمة_إل_إل_في_إم {
    دع المؤقت: مرجع_قيمة_إل_إل_في_إم = كتلة_مؤقتة_إل_إل_في_إم(الحالة, التصنيف, الأشكال);
    دع ب: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    ابن_نسخ_ذاكرة_ثابتة_إل_إل_في_إم(
        الحالة, المؤقت, محاذاة_كتلة_إل_إل_في_إم(التصنيف, الأشكال),
        العنوان, محاذاة_قيمة_آمنة_إل_إل_في_إم(التصنيف),
        (*التصنيف).الحجم مثل غ64
    );
    دع اسم: متغير متجه غ8 = [0];
    دع المحمل: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم(
        ب, نوع_كتلة_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال), المؤقت,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
    );
    ضع_محاذاة_قيمة_إل_إل_في_إم(المحمل, محاذاة_كتلة_إل_إل_في_إم(التصنيف, الأشكال));
    أرجع المحمل;
}

عرف خزّن_كتلة_في_عنوان_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المكان: مرجع_قيمة_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    القيمة: مرجع_قيمة_إل_إل_في_إم
): فراغ {
    دع المؤقت: مرجع_قيمة_إل_إل_في_إم = كتلة_مؤقتة_إل_إل_في_إم(الحالة, التصنيف, الأشكال);
    دع ب: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع المخزن: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم(ب, القيمة, المؤقت);
    ضع_محاذاة_قيمة_إل_إل_في_إم(المخزن, محاذاة_كتلة_إل_إل_في_إم(التصنيف, الأشكال));
    ابن_نسخ_ذاكرة_ثابتة_إل_إل_في_إم(
        الحالة, المكان, محاذاة_قيمة_آمنة_إل_إل_في_إم(التصنيف),
        المؤقت, محاذاة_كتلة_إل_إل_في_إم(التصنيف, الأشكال),
        (*التصنيف).الحجم مثل غ64
    );
}

// A zero-filled byte temporary of at least the bytes the parts cover, holding
// a copy of the value, for parts that extend past the value (big-endian ABIs
// that left-align a short structure in a doubleword slot).
عرف مؤقت_مبطن_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الحجم_المبطن: غير_موقع
): مرجع_قيمة_إل_إل_في_إم {
    دع اسم: متغير متجه غ8 = [0];
    دع نوع_البايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
    دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_حجز_إل_إل_في_إم(
        (*الحالة).باني_الحجز, نوع_مصفوفة_إل_إل_في_إم(نوع_البايت, الحجم_المبطن مثل غ64),
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
    );
    ضع_محاذاة_قيمة_إل_إل_في_إم(المكان, 16);
    دع تجاهل: مرجع_قيمة_إل_إل_في_إم = ابن_ملء_ذاكرة_إل_إل_في_إم(
        (*الحالة).الباني, المكان, ثابت_صحيح_إل_إل_في_إم(نوع_البايت, 0, خطأ),
        ثابت_حجم_إل_إل_في_إم(الحالة, الحجم_المبطن), 16
    );
    أرجع المكان;
}

عرف نهاية_جزء_إل_إل_في_إم(
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    ف: غير_موقع
): غير_موقع {
    أرجع إزاحة_جزء_واجهة_إل_إل_في_إم(التصنيف, الأشكال, ف)
        + حجم_جزء_واجهة_إل_إل_في_إم(التصنيف, الأشكال, ف);
}

// Loads register part ف of the value at العنوان.
عام عرف حمّل_جزء_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    العنوان: مرجع_قيمة_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    ف: غير_موقع
): مرجع_قيمة_إل_إل_في_إم {
    دع الإزاحة: غير_موقع = إزاحة_جزء_واجهة_إل_إل_في_إم(التصنيف, الأشكال, ف);
    دع الحجم: غير_موقع = حجم_جزء_واجهة_إل_إل_في_إم(التصنيف, الأشكال, ف);
    دع النهاية: غير_موقع = نهاية_جزء_إل_إل_في_إم(التصنيف, الأشكال, ف);
    دع المصدر: متغير مرجع_قيمة_إل_إل_في_إم = العنوان;
    لو (النهاية > (*التصنيف).الحجم) {
        المصدر := مؤقت_مبطن_إل_إل_في_إم(الحالة, النهاية);
        ابن_نسخ_ذاكرة_ثابتة_إل_إل_في_إم(
            الحالة, المصدر, 16, العنوان, محاذاة_قيمة_آمنة_إل_إل_في_إم(التصنيف),
            (*التصنيف).الحجم مثل غ64
        );
    };
    دع عنوان_الجزء: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المصدر, الإزاحة);
    دع اسم: متغير متجه غ8 = [0];
    دع المحمل: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم(
        (*الحالة).الباني, نوع_جزء_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال, ف),
        عنوان_الجزء, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
    );
    دع محاذاة_المصدر: متغير غير_موقع = (*التصنيف).المحاذاة;
    لو (النهاية > (*التصنيف).الحجم) { محاذاة_المصدر := 16; };
    ضع_محاذاة_قيمة_إل_إل_في_إم(المحمل, محاذاة_جزء_إل_إل_في_إم(محاذاة_المصدر, الإزاحة, الحجم));
    أرجع المحمل;
}

// Stores register part ف (an IR value of the part type) into the value at المكان.
عام عرف خزّن_جزء_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المكان: مرجع_قيمة_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    ف: غير_موقع,
    القيمة: مرجع_قيمة_إل_إل_في_إم
): فراغ {
    دع الإزاحة: غير_موقع = إزاحة_جزء_واجهة_إل_إل_في_إم(التصنيف, الأشكال, ف);
    دع الحجم: غير_موقع = حجم_جزء_واجهة_إل_إل_في_إم(التصنيف, الأشكال, ف);
    دع النهاية: غير_موقع = نهاية_جزء_إل_إل_في_إم(التصنيف, الأشكال, ف);
    لو (النهاية > (*التصنيف).الحجم) {
        // Only the bytes inside the value are copied back.
        دع المؤقت: مرجع_قيمة_إل_إل_في_إم = مؤقت_مبطن_إل_إل_في_إم(الحالة, النهاية);
        دع مخزن_مؤقت: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم(
            (*الحالة).الباني, القيمة, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المؤقت, الإزاحة)
        );
        ضع_محاذاة_قيمة_إل_إل_في_إم(مخزن_مؤقت, محاذاة_جزء_إل_إل_في_إم(16, الإزاحة, الحجم));
        لو (الإزاحة < (*التصنيف).الحجم) {
            ابن_نسخ_ذاكرة_ثابتة_إل_إل_في_إم(
                الحالة,
                ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, الإزاحة), 1,
                ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المؤقت, الإزاحة), 1,
                ((*التصنيف).الحجم - الإزاحة) مثل غ64
            );
        };
        أرجع;
    };
    دع المخزن: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم(
        (*الحالة).الباني, القيمة, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, الإزاحة)
    );
    ضع_محاذاة_قيمة_إل_إل_في_إم(المخزن, محاذاة_جزء_إل_إل_في_إم((*التصنيف).المحاذاة, الإزاحة, الحجم));
}

// IR argument values of a register-class aggregate stored at العنوان.
عام عرف ألحق_قيم_أجزاء_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    العنوان: مرجع_قيمة_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    الحجج: &متغير متجه مرجع_قيمة_إل_إل_في_إم
): فراغ {
    لو (أجزاء_ككتلة_إل_إل_في_إم(التصنيف)) {
        ألحق(*الحجج, حمّل_كتلة_من_عنوان_إل_إل_في_إم(الحالة, العنوان, التصنيف, الأشكال));
        أرجع;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*التصنيف).عدد_الأجزاء) {
        ألحق(*الحجج, حمّل_جزء_واجهة_إل_إل_في_إم(الحالة, العنوان, التصنيف, الأشكال, ف));
        ف := ف + 1;
    }
}

// The aggregate at العنوان as the single IR value a function returns.
عام عرف قيمة_إرجاع_أجزاء_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    العنوان: مرجع_قيمة_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة
): مرجع_قيمة_إل_إل_في_إم {
    لو (أجزاء_ككتلة_إل_إل_في_إم(التصنيف)) {
        أرجع حمّل_كتلة_من_عنوان_إل_إل_في_إم(الحالة, العنوان, التصنيف, الأشكال);
    };
    لو ((*التصنيف).عدد_الأجزاء <= 1) {
        أرجع حمّل_جزء_واجهة_إل_إل_في_إم(الحالة, العنوان, التصنيف, الأشكال, 0);
    };
    دع النوع: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_أجزاء_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال);
    دع المجمع: متغير مرجع_قيمة_إل_إل_في_إم = قيمة_غير_معرفة_إل_إل_في_إم(النوع);
    دع اسم: متغير متجه غ8 = [0];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*التصنيف).عدد_الأجزاء) {
        دع الجزء: مرجع_قيمة_إل_إل_في_إم = حمّل_جزء_واجهة_إل_إل_في_إم(
            الحالة, العنوان, التصنيف, الأشكال, ف
        );
        المجمع := ابن_إدخال_عنصر_بنية_إل_إل_في_إم(
            (*الحالة).الباني, المجمع, الجزء, ف مثل غ32, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        ف := ف + 1;
    }
    أرجع المجمع;
}

// Stores a returned register value (single part, struct of parts or block
// array) into the value at المكان.
عام عرف خزّن_قيمة_إرجاع_أجزاء_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المكان: مرجع_قيمة_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    القيمة: مرجع_قيمة_إل_إل_في_إم
): فراغ {
    لو (أجزاء_ككتلة_إل_إل_في_إم(التصنيف)) {
        خزّن_كتلة_في_عنوان_إل_إل_في_إم(الحالة, المكان, التصنيف, الأشكال, القيمة);
        أرجع;
    };
    لو ((*التصنيف).عدد_الأجزاء <= 1) {
        خزّن_جزء_واجهة_إل_إل_في_إم(الحالة, المكان, التصنيف, الأشكال, 0, القيمة);
        أرجع;
    };
    دع اسم: متغير متجه غ8 = [0];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*التصنيف).عدد_الأجزاء) {
        دع الجزء: مرجع_قيمة_إل_إل_في_إم = ابن_استخراج_عنصر_بنية_إل_إل_في_إم(
            (*الحالة).الباني, القيمة, ف مثل غ32, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        خزّن_جزء_واجهة_إل_إل_في_إم(الحالة, المكان, التصنيف, الأشكال, ف, الجزء);
        ف := ف + 1;
    }
}

// Stores incoming IR parameters (as many as عدد_معاملات_أجزاء_واجهة) into
// the value at المكان.
عام عرف خزّن_معاملات_أجزاء_واجهة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المكان: مرجع_قيمة_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    المعاملات: &متجه مرجع_قيمة_إل_إل_في_إم
): فراغ {
    لو (أجزاء_ككتلة_إل_إل_في_إم(التصنيف)) {
        خزّن_كتلة_في_عنوان_إل_إل_في_إم(الحالة, المكان, التصنيف, الأشكال, (*المعاملات)[0]);
        أرجع;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*التصنيف).عدد_الأجزاء) {
        خزّن_جزء_واجهة_إل_إل_في_إم(الحالة, المكان, التصنيف, الأشكال, ف, (*المعاملات)[ف]);
        ف := ف + 1;
    }
}

// A caller-owned copy of the value at العنوان for a foreign indirect
// argument (نسخة_للمستدعى): the callee may write through the pointer.
عام عرف نسخة_مستدعى_لقيمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    العنوان: مرجع_قيمة_إل_إل_في_إم,
    نوع_التخزين: مرجع_نوع_إل_إل_في_إم,
    التصنيف: &تصنيف_قيمة_واجهة
): مرجع_قيمة_إل_إل_في_إم {
    دع اسم: متغير متجه غ8 = [0];
    دع النسخة: مرجع_قيمة_إل_إل_في_إم = ابن_حجز_إل_إل_في_إم(
        (*الحالة).باني_الحجز, نوع_التخزين, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
    );
    دع المحاذاة: غ32 = محاذاة_قيمة_آمنة_إل_إل_في_إم(التصنيف);
    ضع_محاذاة_قيمة_إل_إل_في_إم(النسخة, المحاذاة);
    ابن_نسخ_ذاكرة_ثابتة_إل_إل_في_إم(
        الحالة, النسخة, المحاذاة, العنوان, المحاذاة,
        (*التصنيف).الحجم مثل غ64
    );
    أرجع النسخة;
}

// zeroext/signext on a parameter or result (LLVM attribute index: 0 for the
// result, 1 + n for IR parameter n) when the plan requires an extension.
عام عرف أضف_صفة_توسيع_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    الفهرس: غ32,
    التوسيع: توسيع_عدد_واجهة,
    موضع_نداء: منطقي
): فراغ {
    دع الاسم: متغير متجه غ8;
    طابق التوسيع مع
    | توسيع_عدد_واجهة.بلا_توسيع -> { أرجع; }
    | توسيع_عدد_واجهة.توسيع_صفري -> { الاسم := بايتات_منتهية_بصفر_من_نص(«zeroext»); }
    | توسيع_عدد_واجهة.توسيع_إشاري -> { الاسم := بايتات_منتهية_بصفر_من_نص(«signext»); };
    دع الطول_بلا_صفر: غير_موقع = (الطول(الاسم) مثل غير_موقع) - 1;
    دع المعرف: غ32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), الطول_بلا_صفر);
    دع الصفة: مرجع_صفة_إل_إل_في_إم = أنشئ_صفة_تعداد_إل_إل_في_إم((*الحالة).السياق, المعرف, 0);
    لو (موضع_نداء) {
        أضف_صفة_معامل_نداء_إل_إل_في_إم(القيمة, الفهرس, الصفة);
    } وإلا {
        أضف_صفة_معامل_إل_إل_في_إم(القيمة, الفهرس, الصفة);
    };
}

// `inreg` on a parameter or result whose register parts the plan packs into
// shared doubleword slots (تصنيف_قيمة_واجهة.أجزاء_مرصوصة, SPARC V9), as
// Clang marks the same coerced parts.
عام عرف أضف_صفة_أجزاء_مرصوصة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    الفهرس: غ32,
    موضع_نداء: منطقي
): فراغ {
    دع الاسم: متغير متجه غ8 = بايتات_منتهية_بصفر_من_نص(«inreg»);
    دع المعرف: غ32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), 5);
    دع الصفة: مرجع_صفة_إل_إل_في_إم = أنشئ_صفة_تعداد_إل_إل_في_إم((*الحالة).السياق, المعرف, 0);
    لو (موضع_نداء) {
        أضف_صفة_معامل_نداء_إل_إل_في_إم(القيمة, الفهرس, الصفة);
    } وإلا {
        أضف_صفة_معامل_إل_إل_في_إم(القيمة, الفهرس, الصفة);
    };
}
