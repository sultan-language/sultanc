استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.target.target_model;
استورد std.text.from_bytes;

// Operations the Cortex-M instruction sets lack, which LLVM would lower to
// calls of run-time routines (the Arm run-time ABI's __aeabi_* functions,
// normally from libgcc or compiler-rt). SultanC links neither. The MSIR
// operations that would need one are rejected before lowering, at their
// source location (freestanding_check.sn); after the optimization pipeline,
// before code generation, this pass expands what it can and reports, at its
// function, anything lowering or optimization formed that still would:
// - on ARMv6-M, 64-bit multiplication and 64-bit shifts by a variable amount
//   (__aeabi_lmul, __aeabi_llsl, __aeabi_llsr, __aeabi_lasr) are expanded
//   into 32-bit instructions: Thumb-1 has no 32 x 32 -> 64 multiply, so the
//   low product is built from 16-bit halves;
// - a float operation wider than the target's FPU computes (every one on the
//   soft-float eabi targets, f64 on thumbv7em-none-eabihf), and `frem`
//   (fmod) at any width, is rejected with SULTANC-TARGET-FEATURE-UNSUPPORTED
//   at its source location (freestanding_check.sn): it would need a soft-float
//   routine (__aeabi_fadd, __aeabi_dmul, __aeabi_f2d, ...), which SultanC
//   does not provide. Loads, stores, moves, `fneg`, `llvm.fabs` and
//   `llvm.copysign` are bit operations and stay allowed;
// - an atomic wider than the target does inline (target_model.sn
//   عرض_الذريات_للهدف: read-modify-write and compare-and-swap up to 32 bits
//   on ARMv7-M, none on ARMv6-M; atomic loads and stores up to 32 bits) is
//   rejected: it would call an __atomic_*/__sync_* routine. std declares no
//   such atomics for these targets (library/std/sync/atomic.sn), so only a
//   direct use of the compiler's atomic intrinsics reaches this check.
// 64-bit division is expanded earlier (wide_division.sn), as on every
// 32-bit target. The facts come from the target (target_model.sn
// هدف_بلا_ضرب_وإزاحة_64, عرض_عائم_بالعتاد_للهدف).

// LLVMTypeKind and LLVMOpcode values of the stable C API (llvm-c/Core.h).
عرف عرض_عائم_لنوع_إل_إل_في_إم(النوع: مرجع_نوع_إل_إل_في_إم): طبيعي {
    دع النوع_: ص32 = LLVMGetTypeKind(النوع);
    إذا (النوع_ == 1 || النوع_ == 18) { أرجع 16; };
    إذا (النوع_ == 2) { أرجع 32; };
    إذا (النوع_ == 3) { أرجع 64; };
    إذا (النوع_ == 4) { أرجع 80; };
    إذا (النوع_ == 5 || النوع_ == 6) { أرجع 128; };
    أرجع 0;
}

عرف عرض_عائم_أقصى_لتعليمة_إل_إل_في_إم(التعليمة: مرجع_قيمة_إل_إل_في_إم): طبيعي {
    دع الأقصى: متغير طبيعي = عرض_عائم_لنوع_إل_إل_في_إم(LLVMTypeOf(التعليمة));
    دع العدد: ص32 = LLVMGetNumOperands(التعليمة);
    دع ف: متغير ص32 = 0;
    طالما (ف < العدد) {
        دع العرض: طبيعي = عرض_عائم_لنوع_إل_إل_في_إم(LLVMTypeOf(LLVMGetOperand(التعليمة, ف مثل ط32)));
        إذا (العرض > الأقصى) { الأقصى := العرض; };
        ف := ف + 1;
    }
    أرجع الأقصى;
}

عرف اسم_قيمة_إل_إل_في_إم(القيمة: مرجع_قيمة_إل_إل_في_إم): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع الطول_: متغير حجم_إل_إل_في_إم = 0;
    دع البايتات: مؤشر_محرف_ثابت_إل_إل_في_إم = LLVMGetValueName2(القيمة, &متغير الطول_);
    دع ف: متغير طبيعي = 0;
    غير_آمن {
        طالما (ف < الطول_) {
            ألحق(الناتج, البايتات[ف]);
            ف := ف + 1;
        }
    }
    أرجع الناتج;
}

عرف يبدأ_ب_إل_إل_في_إم(النص: &متجه ط8, البادئة: نص): منطقي {
    دع ب: متجه ط8 = بايتات_من_نص(البادئة);
    إذا ((الطول(ب) مثل طبيعي) > (الطول(*النص) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ب) مثل طبيعي)) {
        إذا ((*النص)[ف] != ب[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The operation a float instruction stands for, or an empty name for an
// instruction that is no float computation (or a bit operation on floats).
عرف عملية_عائمة_لتعليمة_إل_إل_في_إم(التعليمة: مرجع_قيمة_إل_إل_في_إم): متجه ط8 {
    دع الرمز: ص32 = LLVMGetInstructionOpcode(التعليمة);
    إذا (الرمز == 9) { أرجع بايتات_من_نص(«fadd»); };
    إذا (الرمز == 11) { أرجع بايتات_من_نص(«fsub»); };
    إذا (الرمز == 13) { أرجع بايتات_من_نص(«fmul»); };
    إذا (الرمز == 16) { أرجع بايتات_من_نص(«fdiv»); };
    إذا (الرمز == 19) { أرجع بايتات_من_نص(«frem»); };
    إذا (الرمز == 33) { أرجع بايتات_من_نص(«fptoui»); };
    إذا (الرمز == 34) { أرجع بايتات_من_نص(«fptosi»); };
    إذا (الرمز == 35) { أرجع بايتات_من_نص(«uitofp»); };
    إذا (الرمز == 36) { أرجع بايتات_من_نص(«sitofp»); };
    إذا (الرمز == 37) { أرجع بايتات_من_نص(«fptrunc»); };
    إذا (الرمز == 38) { أرجع بايتات_من_نص(«fpext»); };
    إذا (الرمز == 43) { أرجع بايتات_من_نص(«fcmp»); };
    إذا (LLVMIsACallInst(التعليمة) != الفارغ) {
        دع المستدعى: مرجع_قيمة_إل_إل_في_إم = LLVMGetCalledValue(التعليمة);
        إذا (المستدعى != الفارغ && LLVMIsAFunction(المستدعى) != الفارغ && LLVMGetIntrinsicID(المستدعى) != 0) {
            دع الاسم: متجه ط8 = اسم_قيمة_إل_إل_في_إم(المستدعى);
            إذا (يبدأ_ب_إل_إل_في_إم(&الاسم, «llvm.fabs.») || يبدأ_ب_إل_إل_في_إم(&الاسم, «llvm.copysign.»)) {
                دع لا_عملية: متجه ط8 = [];
                أرجع لا_عملية;
            };
            أرجع الاسم;
        };
    };
    دع لا_عملية: متجه ط8 = [];
    أرجع لا_عملية;
}

عرف رقم_عشري_إل_إل_في_إم(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    إذا (القيمة >= 10) { رقم_عشري_إل_إل_في_إم(الناتج, القيمة / 10); };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل ط8);
}

// The canonical name of an IEEE or integer width, "f64" or "i64": the type
// fact a diagnostic carries.
عام عرف نص_عرض_نوع_إل_إل_في_إم(البادئة: ط8, العرض: طبيعي): متجه ط8 {
    دع النص: متغير متجه ط8 = [البادئة];
    رقم_عشري_إل_إل_في_إم(&متغير النص, العرض);
    أرجع النص;
}

// An operation the target cannot do without a run-time routine, found in the
// LLVM module: the function it is in, the operation (an LLVM opcode or
// intrinsic name) and its type. llvm_codegen.sn turns it into a failure with
// the source function and location (freestanding_check.sn).
عام نوع عملية_بلا_روتين_إل_إل_في_إم = {
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    العملية: متجه ط8,
    النوع: متجه ط8
};

عام نوع زوج_كلمات_إل_إل_في_إم = {
    المنخفضة: مرجع_قيمة_إل_إل_في_إم,
    المرتفعة: مرجع_قيمة_إل_إل_في_إم
};

// The full 64-bit product of two 32-bit words from four 16 x 16 -> 32-bit
// products, which Thumb-1 MULS computes exactly.
عرف ضرب_كلمتين_كامل_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم
): زوج_كلمات_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع ف: متغير متجه ط8 = [0];
    دع نوع32: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 32);
    دع قناع: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع32, 0xFFFF, 0);
    دع ستة_عشر: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع32, 16, 0);
    دع أ0: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAnd(الباني, أ, قناع, &متغير ف[0]);
    دع أ1: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, أ, ستة_عشر, &متغير ف[0]);
    دع ب0: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAnd(الباني, ب, قناع, &متغير ف[0]);
    دع ب1: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, ب, ستة_عشر, &متغير ف[0]);
    دع ض00: مرجع_قيمة_إل_إل_في_إم = LLVMBuildMul(الباني, أ0, ب0, &متغير ف[0]);
    دع ض01: مرجع_قيمة_إل_إل_في_إم = LLVMBuildMul(الباني, أ0, ب1, &متغير ف[0]);
    دع ض10: مرجع_قيمة_إل_إل_في_إم = LLVMBuildMul(الباني, أ1, ب0, &متغير ف[0]);
    دع ض11: مرجع_قيمة_إل_إل_في_إم = LLVMBuildMul(الباني, أ1, ب1, &متغير ف[0]);
    // ICmp ULT = 36: the carry out of a wrapping addition.
    دع الوسط: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAdd(الباني, ض01, ض10, &متغير ف[0]);
    دع حمل1: مرجع_قيمة_إل_إل_في_إم = LLVMBuildZExt(الباني,
        LLVMBuildICmp(الباني, 36, الوسط, ض01, &متغير ف[0]), نوع32, &متغير ف[0]);
    دع المنخفضة: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAdd(الباني, ض00,
        LLVMBuildShl(الباني, الوسط, ستة_عشر, &متغير ف[0]), &متغير ف[0]);
    دع حمل2: مرجع_قيمة_إل_إل_في_إم = LLVMBuildZExt(الباني,
        LLVMBuildICmp(الباني, 36, المنخفضة, ض00, &متغير ف[0]), نوع32, &متغير ف[0]);
    دع المرتفعة: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAdd(الباني,
        LLVMBuildAdd(الباني, ض11, LLVMBuildLShr(الباني, الوسط, ستة_عشر, &متغير ف[0]), &متغير ف[0]),
        LLVMBuildAdd(الباني, LLVMBuildShl(الباني, حمل1, ستة_عشر, &متغير ف[0]), حمل2, &متغير ف[0]),
        &متغير ف[0]);
    دع الزوج: زوج_كلمات_إل_إل_في_إم = { المنخفضة: المنخفضة, المرتفعة: المرتفعة };
    أرجع الزوج;
}

عرف كلمة_منخفضة_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم, س: مرجع_قيمة_إل_إل_في_إم): مرجع_قيمة_إل_إل_في_إم {
    دع ف: متغير متجه ط8 = [0];
    أرجع LLVMBuildTrunc((*الحالة).الباني, س, نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 32), &متغير ف[0]);
}

عرف كلمة_مرتفعة_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم, س: مرجع_قيمة_إل_إل_في_إم): مرجع_قيمة_إل_إل_في_إم {
    دع ف: متغير متجه ط8 = [0];
    دع نوع64: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    دع المزاح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr((*الحالة).الباني, س, LLVMConstInt(نوع64, 32, 0), &متغير ف[0]);
    أرجع LLVMBuildTrunc((*الحالة).الباني, المزاح, نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 32), &متغير ف[0]);
}

// (high << 32) | low; a shift by the constant 32 is a register move.
عرف اجمع_كلمتين_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم, الزوج: زوج_كلمات_إل_إل_في_إم): مرجع_قيمة_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع ف: متغير متجه ط8 = [0];
    دع نوع64: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    دع م: مرجع_قيمة_إل_إل_في_إم = LLVMBuildZExt(الباني, الزوج.المنخفضة, نوع64, &متغير ف[0]);
    دع ع: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني,
        LLVMBuildZExt(الباني, الزوج.المرتفعة, نوع64, &متغير ف[0]), LLVMConstInt(نوع64, 32, 0), &متغير ف[0]);
    أرجع LLVMBuildOr(الباني, ع, م, &متغير ف[0]);
}

// a * b mod 2^64 = lo(a) * lo(b) (full) + ((hi(a) * lo(b) + lo(a) * hi(b)) << 32).
عرف ضرب_64_بكلمات_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم
): مرجع_قيمة_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع ف: متغير متجه ط8 = [0];
    دع أ_م: مرجع_قيمة_إل_إل_في_إم = كلمة_منخفضة_إل_إل_في_إم(الحالة, أ);
    دع أ_ع: مرجع_قيمة_إل_إل_في_إم = كلمة_مرتفعة_إل_إل_في_إم(الحالة, أ);
    دع ب_م: مرجع_قيمة_إل_إل_في_إم = كلمة_منخفضة_إل_إل_في_إم(الحالة, ب);
    دع ب_ع: مرجع_قيمة_إل_إل_في_إم = كلمة_مرتفعة_إل_إل_في_إم(الحالة, ب);
    دع المنخفض: زوج_كلمات_إل_إل_في_إم = ضرب_كلمتين_كامل_إل_إل_في_إم(الحالة, أ_م, ب_م);
    دع التقاطع: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAdd(الباني,
        LLVMBuildMul(الباني, أ_ع, ب_م, &متغير ف[0]),
        LLVMBuildMul(الباني, أ_م, ب_ع, &متغير ف[0]), &متغير ف[0]);
    دع الزوج: زوج_كلمات_إل_إل_في_إم = {
        المنخفضة: المنخفض.المنخفضة,
        المرتفعة: LLVMBuildAdd(الباني, المنخفض.المرتفعة, التقاطع, &متغير ف[0])
    };
    أرجع اجمع_كلمتين_إل_إل_في_إم(الحالة, الزوج);
}

// A 64-bit shift by a variable amount n (taken mod 64) from 32-bit shifts
// whose amounts stay in 0..31: s = n & 31, and n & 32 selects the half that
// crosses. The bits that cross between the words are shifted in two steps
// (by 1, then by 31 - s), so s = 0 needs no shift by 32. Opcode: 20 shl,
// 21 lshr, 22 ashr.
عرف إزاحة_64_بكلمات_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    المقدار: مرجع_قيمة_إل_إل_في_إم,
    الرمز: ص32
): مرجع_قيمة_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع ف: متغير متجه ط8 = [0];
    دع نوع32: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 32);
    دع م: مرجع_قيمة_إل_إل_في_إم = كلمة_منخفضة_إل_إل_في_إم(الحالة, أ);
    دع ع: مرجع_قيمة_إل_إل_في_إم = كلمة_مرتفعة_إل_إل_في_إم(الحالة, أ);
    دع ن: مرجع_قيمة_إل_إل_في_إم = كلمة_منخفضة_إل_إل_في_إم(الحالة, المقدار);
    دع واحد: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع32, 1, 0);
    دع صفر: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع32, 0, 0);
    دع س: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAnd(الباني, ن, LLVMConstInt(نوع32, 31, 0), &متغير ف[0]);
    دع عكس: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, LLVMConstInt(نوع32, 31, 0), س, &متغير ف[0]);
    // ICmp NE = 33.
    دع كبير: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 33,
        LLVMBuildAnd(الباني, ن, LLVMConstInt(نوع32, 32, 0), &متغير ف[0]), صفر, &متغير ف[0]);
    دع الزوج: متغير زوج_كلمات_إل_إل_في_إم = { المنخفضة: م, المرتفعة: ع };
    إذا (الرمز == 20) {
        دع م_صغير: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني, م, س, &متغير ف[0]);
        دع عابر: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني,
            LLVMBuildLShr(الباني, م, واحد, &متغير ف[0]), عكس, &متغير ف[0]);
        دع ع_صغير: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني,
            LLVMBuildShl(الباني, ع, س, &متغير ف[0]), عابر, &متغير ف[0]);
        الزوج.المنخفضة := LLVMBuildSelect(الباني, كبير, صفر, م_صغير, &متغير ف[0]);
        الزوج.المرتفعة := LLVMBuildSelect(الباني, كبير, م_صغير, ع_صغير, &متغير ف[0]);
    } وإلا {
        دع عابر: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني,
            LLVMBuildShl(الباني, ع, واحد, &متغير ف[0]), عكس, &متغير ف[0]);
        دع م_صغير: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني,
            LLVMBuildLShr(الباني, م, س, &متغير ف[0]), عابر, &متغير ف[0]);
        دع ع_مزاح: متغير مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, ع, س, &متغير ف[0]);
        دع الملء: متغير مرجع_قيمة_إل_إل_في_إم = صفر;
        إذا (الرمز == 22) {
            ع_مزاح := LLVMBuildAShr(الباني, ع, س, &متغير ف[0]);
            الملء := LLVMBuildAShr(الباني, ع, LLVMConstInt(نوع32, 31, 0), &متغير ف[0]);
        };
        الزوج.المنخفضة := LLVMBuildSelect(الباني, كبير, ع_مزاح, م_صغير, &متغير ف[0]);
        الزوج.المرتفعة := LLVMBuildSelect(الباني, كبير, الملء, ع_مزاح, &متغير ف[0]);
    };
    أرجع اجمع_كلمتين_إل_إل_في_إم(الحالة, الزوج);
}

// The width of the value an atomic instruction accesses, 0 for any other
// instruction. Opcodes: 27 load, 28 store, 56 cmpxchg, 57 atomicrmw; a load
// or store is atomic when its ordering is not NotAtomic (0).
عرف عرض_ذري_لتعليمة_إل_إل_في_إم(التعليمة: مرجع_قيمة_إل_إل_في_إم, الرمز: ص32): طبيعي {
    دع النوع: متغير مرجع_نوع_إل_إل_في_إم = الفارغ;
    إذا (الرمز == 27 && LLVMGetOrdering(التعليمة) != 0) { النوع := LLVMTypeOf(التعليمة); };
    إذا (الرمز == 28 && LLVMGetOrdering(التعليمة) != 0) { النوع := LLVMTypeOf(LLVMGetOperand(التعليمة, 0)); };
    إذا (الرمز == 56 || الرمز == 57) { النوع := LLVMTypeOf(LLVMGetOperand(التعليمة, 1)); };
    إذا (النوع == الفارغ) { أرجع 0; };
    إذا (LLVMGetTypeKind(النوع) == 8) { أرجع LLVMGetIntTypeWidth(النوع) مثل طبيعي; };
    // Pointers (12) are 32 bits on these targets; anything else is unusual.
    إذا (LLVMGetTypeKind(النوع) == 12) { أرجع 32; };
    أرجع 128;
}

عرف اسم_عملية_ذرية_إل_إل_في_إم(الرمز: ص32): متجه ط8 {
    إذا (الرمز == 27) { أرجع بايتات_من_نص(«atomic load»); };
    إذا (الرمز == 28) { أرجع بايتات_من_نص(«atomic store»); };
    إذا (الرمز == 56) { أرجع بايتات_من_نص(«cmpxchg»); };
    أرجع بايتات_من_نص(«atomicrmw»);
}

عرف عدد_صحيح_64_إل_إل_في_إم(القيمة: مرجع_قيمة_إل_إل_في_إم): منطقي {
    دع النوع: مرجع_نوع_إل_إل_في_إم = LLVMTypeOf(القيمة);
    أرجع LLVMGetTypeKind(النوع) == 8 && LLVMGetIntTypeWidth(النوع) == 64;
}

عام عرف اخفض_روتينات_التشغيل_الحرة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف
): اختياري عملية_بلا_روتين_إل_إل_في_إم {
    دع حد_العتاد: متغير طبيعي = 0;
    دع يفحص_العائم: متغير منطقي = خطأ;
    طابق عرض_عائم_بالعتاد_للهدف(الهدف) مع
    | اختياري.موجود(العرض) -> { حد_العتاد := العرض; يفحص_العائم := صواب; }
    | اختياري.لا_شيء -> { };
    دع يوسع_64: منطقي = هدف_بلا_ضرب_وإزاحة_64(الهدف);
    دع يفحص_الذريات: منطقي = يفحص_العائم;
    دع عرض_التعديل: طبيعي = عرض_الذريات_للهدف(الهدف);
    إذا (!يفحص_العائم && !يوسع_64) { أرجع اختياري.لا_شيء(); };
    دع الدالة: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetFirstFunction((*الحالة).الوحدة);
    طالما (الدالة != الفارغ) {
        دع الكتلة: متغير مرجع_كتلة_إل_إل_في_إم = LLVMGetFirstBasicBlock(الدالة);
        طالما (الكتلة != الفارغ) {
            دع التعليمة: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetFirstInstruction(الكتلة);
            طالما (التعليمة != الفارغ) {
                // The instruction may be replaced and erased below.
                دع التالية: مرجع_قيمة_إل_إل_في_إم = LLVMGetNextInstruction(التعليمة);
                إذا (يفحص_العائم) {
                    دع العملية: متجه ط8 = عملية_عائمة_لتعليمة_إل_إل_في_إم(التعليمة);
                    إذا ((الطول(العملية) مثل طبيعي) > 0) {
                        دع العرض: طبيعي = عرض_عائم_أقصى_لتعليمة_إل_إل_في_إم(التعليمة);
                        دع باقي_عائم: منطقي = LLVMGetInstructionOpcode(التعليمة) == 19;
                        إذا (العرض > حد_العتاد || (باقي_عائم && العرض > 0)) {
                            دع الموجود: عملية_بلا_روتين_إل_إل_في_إم = {
                                الدالة: الدالة, العملية: العملية,
                                النوع: نص_عرض_نوع_إل_إل_في_إم(0x66 مثل ط8, العرض)
                            };
                            أرجع اختياري.موجود(الموجود);
                        };
                    };
                };
                إذا (يفحص_الذريات) {
                    دع الرمز_الذري: ص32 = LLVMGetInstructionOpcode(التعليمة);
                    دع العرض_الذري: طبيعي = عرض_ذري_لتعليمة_إل_إل_في_إم(التعليمة, الرمز_الذري);
                    دع الحد: متغير طبيعي = 32;
                    إذا (الرمز_الذري == 56 || الرمز_الذري == 57) { الحد := عرض_التعديل; };
                    إذا (العرض_الذري > الحد) {
                        دع الموجود: عملية_بلا_روتين_إل_إل_في_إم = {
                            الدالة: الدالة, العملية: اسم_عملية_ذرية_إل_إل_في_إم(الرمز_الذري),
                            النوع: نص_عرض_نوع_إل_إل_في_إم(0x69 مثل ط8, العرض_الذري)
                        };
                        أرجع اختياري.موجود(الموجود);
                    };
                };
                إذا (يوسع_64 && عدد_صحيح_64_إل_إل_في_إم(التعليمة)) {
                    دع الرمز: ص32 = LLVMGetInstructionOpcode(التعليمة);
                    دع البديل: متغير مرجع_قيمة_إل_إل_في_إم = الفارغ;
                    إذا (الرمز == 12) {
                        LLVMPositionBuilderBefore((*الحالة).الباني, التعليمة);
                        البديل := ضرب_64_بكلمات_إل_إل_في_إم(
                            الحالة, LLVMGetOperand(التعليمة, 0), LLVMGetOperand(التعليمة, 1));
                    } وإلا إذا ((الرمز == 20 || الرمز == 21 || الرمز == 22)
                        && LLVMIsAConstantInt(LLVMGetOperand(التعليمة, 1)) == الفارغ) {
                        LLVMPositionBuilderBefore((*الحالة).الباني, التعليمة);
                        البديل := إزاحة_64_بكلمات_إل_إل_في_إم(
                            الحالة, LLVMGetOperand(التعليمة, 0), LLVMGetOperand(التعليمة, 1), الرمز);
                    };
                    إذا (البديل != الفارغ) {
                        LLVMReplaceAllUsesWith(التعليمة, البديل);
                        LLVMInstructionEraseFromParent(التعليمة);
                    };
                };
                التعليمة := التالية;
            }
            الكتلة := LLVMGetNextBasicBlock(الكتلة);
        }
        الدالة := LLVMGetNextFunction(الدالة);
    }
    أرجع اختياري.لا_شيء();
}
