استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_primitive_query_context;
استورد compiler.backend.target.runtime_primitive_symbol_query_context;
استورد compiler.backend.target.runtime_symbol_query_context;
استورد compiler.backend.target.host_environment_query_context;
