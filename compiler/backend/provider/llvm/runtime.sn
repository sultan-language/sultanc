استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.runtime_primitive_query_context;
استورد compiler.backend.target.runtime_primitive_symbol_query_context;
استورد compiler.backend.target.runtime_symbol_query_context;
استورد compiler.backend.target.runtime_service_model;
استورد compiler.backend.target.host_environment_query_context;
استورد compiler.runtime.primitive_identity;

// Runtime/Target remain the owners of primitive availability and external symbol spelling.
// The LLVM provider only materializes those already-canonical decisions as LLVM declarations/calls.

عام عرف رمز_هوية_مضيف_إل_إل_في_إم(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): اختيار عدد {
    أرجع رمز_بدائي_هوية_مضيف_للهدف(الهدف, البدائي);
}

عام عرف اسم_بدائي_تشغيل_إل_إل_في_إم(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): اختيار متجه غ8 {
    طابق خطة_ربط_بدائي_للهدف(الهدف, البدائي) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(_) -> { };
    أرجع اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي);
}

عرف أعلن_خدمة_بسيطة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الاسم_الخام: &متجه غ8,
    الناتج: مرجع_نوع_إل_إل_في_إم,
    المعاملات: &متغير متجه مرجع_نوع_إل_إل_في_إم
): مرجع_قيمة_إل_إل_في_إم {
    دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(الاسم_الخام);
    دع المؤشر: مؤشر_محرف_ثابت_إل_إل_في_إم = مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم);
    دع الموجود: مرجع_قيمة_إل_إل_في_إم = ابحث_دالة_باسم_إل_إل_في_إم((*الحالة).الوحدة, المؤشر);
    لو ((الموجود مثل غير_موقع) != 0) { أرجع الموجود; };
    دع النوع: مرجع_نوع_إل_إل_في_إم;
    لو ((الطول(*المعاملات) مثل غير_موقع) == 0) {
        دع فارغ: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_فراغ_إل_إل_في_إم((*الحالة).السياق)];
        النوع := نوع_دالة_إل_إل_في_إم(الناتج, &متغير فارغ[0], 0);
    } وإلا {
        النوع := نوع_دالة_إل_إل_في_إم(الناتج, &متغير (*المعاملات)[0], الطول(*المعاملات) مثل غ32);
    };
    أرجع أضف_دالة_إل_إل_في_إم((*الحالة).الوحدة, المؤشر, النوع);
}

عام عرف ابن_تخصيص_ذاكرة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    الحجم: مرجع_قيمة_إل_إل_في_إم
): اختيار مرجع_قيمة_إل_إل_في_إم {
    دع الاسم: متجه غ8;
    طابق اسم_رمز_خدمة_تشغيل_للهدف(الهدف, خدمة_تشغيل_هدف.تخصيص_ذاكرة()) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ن) -> { الاسم := ن; };
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر مثل غ32);
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_حجم];
    دع الدالة: مرجع_قيمة_إل_إل_في_إم = أعلن_خدمة_بسيطة_إل_إل_في_إم(الحالة, &الاسم, نوع_مؤشر, &متغير الأنواع);
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_مؤشر, &متغير الأنواع[0], 1);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الحجم];
    دع اسم_فارغ: متغير متجه غ8 = [0];
    أرجع اختيار.بعض(ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, الدالة, &متغير الحجج[0], 1, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فارغ)));
}

عام عرف ابن_إعادة_تخصيص_ذاكرة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    الأصل: مرجع_قيمة_إل_إل_في_إم,
    الحجم: مرجع_قيمة_إل_إل_في_إم
): اختيار مرجع_قيمة_إل_إل_في_إم {
    دع الاسم: متجه غ8;
    طابق اسم_رمز_خدمة_تشغيل_للهدف(الهدف, خدمة_تشغيل_هدف.إعادة_تخصيص_ذاكرة()) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ن) -> { الاسم := ن; };
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر مثل غ32);
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_مؤشر, نوع_حجم];
    دع الدالة: مرجع_قيمة_إل_إل_في_إم = أعلن_خدمة_بسيطة_إل_إل_في_إم(الحالة, &الاسم, نوع_مؤشر, &متغير الأنواع);
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_مؤشر, &متغير الأنواع[0], 2);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الأصل, الحجم];
    دع اسم_فارغ: متغير متجه غ8 = [0];
    أرجع اختيار.بعض(ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, الدالة, &متغير الحجج[0], 2, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فارغ)));
}

عام عرف ابن_تحرير_ذاكرة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    الأصل: مرجع_قيمة_إل_إل_في_إم
): منطقي {
    دع الاسم: متجه غ8;
    طابق اسم_رمز_خدمة_تشغيل_للهدف(الهدف, خدمة_تشغيل_هدف.تحرير_ذاكرة()) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(ن) -> { الاسم := ن; };
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع نوع_فراغ: مرجع_نوع_إل_إل_في_إم = نوع_فراغ_إل_إل_في_إم((*الحالة).السياق);
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_مؤشر];
    دع الدالة: مرجع_قيمة_إل_إل_في_إم = أعلن_خدمة_بسيطة_إل_إل_في_إم(الحالة, &الاسم, نوع_فراغ, &متغير الأنواع);
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_فراغ, &متغير الأنواع[0], 1);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الأصل];
    دع اسم_فارغ: متغير متجه غ8 = [0];
    ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, الدالة, &متغير الحجج[0], 1, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فارغ));
    أرجع صواب;
}
