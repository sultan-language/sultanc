استورد compiler.msir.identifiers;

// Runtime/Target remain the owners of primitive availability and external symbol spelling.
// The LLVM provider only materializes those already-canonical decisions as LLVM declarations/calls.
// LLVM IR uses source-level symbol names. LLVM's Mach-O writer adds the ABI underscore.

عرف اسم_رمز_إل_إل_في_إم_من_رمز_هدف(
    الهدف: &واصف_هدف,
    اسم_الهدف: &متجه غ8
): متجه غ8 {
    طابق تركيب_الهدف_الأصلي(الهدف) مع
    | هوية_تركيب_هدف_أصلي.ذراع_أربعة_وستون_داروين_ماتشو -> {
        لو ((الطول(*اسم_الهدف) مثل غير_موقع) > 0 && (*اسم_الهدف)[0] == 0x5F) {
            دع الاسم: متغير متجه غ8 = [];
            دع الفهرس: متغير غير_موقع = 1;
            بينما (الفهرس < (الطول(*اسم_الهدف) مثل غير_موقع)) {
                ألحق(الاسم, (*اسم_الهدف)[الفهرس]);
                الفهرس := الفهرس + 1;
            }
            أرجع الاسم;
        };
    }
    | _ -> { };
    دع الاسم: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*اسم_الهدف) مثل غير_موقع)) {
        ألحق(الاسم, (*اسم_الهدف)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الاسم;
}

عام عرف رمز_هوية_مضيف_إل_إل_في_إم(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): اختيار عدد {
    أرجع رمز_بدائي_هوية_مضيف_للهدف(الهدف, البدائي);
}

عام عرف اسم_بدائي_تشغيل_إل_إل_في_إم(
    الهدف: &واصف_هدف,
    البدائي: هوية_بدائي_مترجم
): اختيار متجه غ8 {
    طابق خطة_ربط_بدائي_للهدف(الهدف, البدائي) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(_) -> { };
    طابق اسم_رمز_بدائي_تشغيل_للهدف(الهدف, البدائي) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الاسم) -> {
        أرجع اختيار.بعض(اسم_رمز_إل_إل_في_إم_من_رمز_هدف(الهدف, &الاسم));
    };
}


// Calls one of the program's std allocation providers (std
// os/allocation.sn). Its record is the canonical declaration: a hidden
// closure-environment pointer (null here) then pointer-width integer operands,
// a pointer-width integer result for allocate/reallocate. Pointers cross the
// call as those integers; any other shape fails closed.
عرف ابن_نداء_مزود_ذاكرة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    المعرف: معرف_دالة_مسير,
    الوسائط: &متجه مرجع_قيمة_إل_إل_في_إم,
    له_ناتج: منطقي
): اختيار مرجع_قيمة_إل_إل_في_إم {
    دع القيد: قيد_دالة_إل_إل_في_إم;
    طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { القيد := القيمة; };
    دع عدد_الوسائط: غير_موقع = الطول(*الوسائط) مثل غير_موقع;
    لو (!القيد.له_بيئة_إغلاق || القيد.غير_مباشر_الناتج
        || القيد.عدد_معاملات_إل_إل_في_إم != عدد_الوسائط + 1) {
        أرجع اختيار.لا_شيء();
    };
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(
        (*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر مثل غ32
    );
    دع اسم_فارغ: متغير متجه غ8 = [0];
    دع البيئة_الفارغة: مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(نوع_مؤشر);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [البيئة_الفارغة];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الوسائط) {
        دع الوسيط: مرجع_قيمة_إل_إل_في_إم = (*الوسائط)[ف];
        لو (نوع_قيمة_إل_إل_في_إم(الوسيط) == نوع_مؤشر) {
            ألحق(الحجج, ابن_تحويل_مؤشر_إلى_صحيح_إل_إل_في_إم(
                (*الحالة).الباني, الوسيط, نوع_حجم, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فارغ)
            ));
        } وإلا {
            ألحق(الحجج, الوسيط);
        };
        ف := ف + 1;
    }
    دع الناتج: مرجع_قيمة_إل_إل_في_إم = ابن_نداء_إل_إل_في_إم(
        (*الحالة).الباني, القيد.نوع_الدالة, القيد.الدالة, &متغير الحجج[0],
        (عدد_الوسائط + 1) مثل غ32, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فارغ)
    );
    لو (!له_ناتج) { أرجع اختيار.بعض(الناتج); };
    أرجع اختيار.بعض(ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
        (*الحالة).الباني, الناتج, نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فارغ)
    ));
}

عام عرف ابن_تخصيص_ذاكرة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    الحجم: مرجع_قيمة_إل_إل_في_إم
): اختيار مرجع_قيمة_إل_إل_في_إم {
    لو (خدمات_الذاكرة_من_المكتبة_القياسية(الهدف)) {
        طابق (*الحالة).مزودات_تخصيص_الذاكرة مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المزودات) -> {
            دع الوسائط: متجه مرجع_قيمة_إل_إل_في_إم = [الحجم];
            أرجع ابن_نداء_مزود_ذاكرة_إل_إل_في_إم(الحالة, الهدف, المزودات.التخصيص, &الوسائط, صواب);
        };
    };
    // No target has a storage-service symbol (no C allocator is linked).
    أرجع اختيار.لا_شيء();
}

عام عرف ابن_إعادة_تخصيص_ذاكرة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    الأصل: مرجع_قيمة_إل_إل_في_إم,
    الحجم: مرجع_قيمة_إل_إل_في_إم
): اختيار مرجع_قيمة_إل_إل_في_إم {
    لو (خدمات_الذاكرة_من_المكتبة_القياسية(الهدف)) {
        طابق (*الحالة).مزودات_تخصيص_الذاكرة مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المزودات) -> {
            دع الوسائط: متجه مرجع_قيمة_إل_إل_في_إم = [الأصل, الحجم];
            أرجع ابن_نداء_مزود_ذاكرة_إل_إل_في_إم(الحالة, الهدف, المزودات.إعادة_التخصيص, &الوسائط, صواب);
        };
    };
    // No target has a storage-service symbol (no C allocator is linked).
    أرجع اختيار.لا_شيء();
}

عام عرف ابن_تحرير_ذاكرة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    الأصل: مرجع_قيمة_إل_إل_في_إم
): منطقي {
    لو (خدمات_الذاكرة_من_المكتبة_القياسية(الهدف)) {
        طابق (*الحالة).مزودات_تخصيص_الذاكرة مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(المزودات) -> {
            دع الوسائط: متجه مرجع_قيمة_إل_إل_في_إم = [الأصل];
            طابق ابن_نداء_مزود_ذاكرة_إل_إل_في_إم(الحالة, الهدف, المزودات.التحرير, &الوسائط, خطأ) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(_) -> { أرجع صواب; };
        };
    };
    // No target has a storage-service symbol (no C allocator is linked).
    أرجع خطأ;
}
