استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.target_machine;

عرف انسخ_مخزن_إل_إل_في_إم(المخزن: مرجع_مخزن_ذاكرة_إل_إل_في_إم): متجه غ8 {
    دع البداية: مؤشر_محرف_ثابت_إل_إل_في_إم = بداية_مخزن_إل_إل_في_إم(المخزن);
    دع العدد: غير_موقع = حجم_مخزن_إل_إل_في_إم(المخزن) مثل غير_موقع;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    غير_آمن {
        بينما (ف < العدد) {
            ألحق(الناتج, البداية[ف]);
            ف := ف + 1;
        }
    }
    أرجع الناتج;
}

عام عرف أصدر_وحدة_ككائن_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    احتفظ_بنص_الوحدة: منطقي
): نتيجة ناتج_مزود_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع رسالة: متغير مؤشر_محرف_متغير_إل_إل_في_إم;
    دع المخزن: متغير مرجع_مخزن_ذاكرة_إل_إل_في_إم;
    لو (أصدر_كائن_إل_إل_في_إم((*الحالة).آلة_الهدف, (*الحالة).الوحدة, &متغير رسالة, &متغير المخزن) != 0) {
        دع النص: متجه غ8 = انسخ_رسالة_سي_لإل_إل_في_إم(رسالة);
        حرر_رسالة_إل_إل_في_إم(رسالة);
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.إصدار_كائن_إل_إل_في_إم_فشل(النص));
    };
    دع الكائن: متجه غ8 = انسخ_مخزن_إل_إل_في_إم(المخزن);
    حرر_مخزن_إل_إل_في_إم(المخزن);
    دع نص_الوحدة: متغير اختيار متجه غ8 = اختيار.لا_شيء();
    لو (احتفظ_بنص_الوحدة) {
        دع الرسالة_المطبوعة: مؤشر_محرف_متغير_إل_إل_في_إم = اطبع_وحدة_إل_إل_في_إم((*الحالة).الوحدة);
        دع النص: متجه غ8 = انسخ_رسالة_سي_لإل_إل_في_إم(الرسالة_المطبوعة);
        حرر_رسالة_إل_إل_في_إم(الرسالة_المطبوعة);
        نص_الوحدة := اختيار.بعض(النص);
    };
    دع الناتج: ناتج_مزود_إل_إل_في_إم = { الكائن: الكائن, نص_الوحدة: نص_الوحدة };
    أرجع نتيجة.نجح(الناتج);
}
