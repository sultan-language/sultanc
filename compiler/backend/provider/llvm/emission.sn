استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.provider.llvm.ffi.target_machine;
استورد compiler.backend.target.target_model;
استورد std.text.from_bytes;

عرف انسخ_مخزن_إل_إل_في_إم(المخزن: مرجع_مخزن_ذاكرة_إل_إل_في_إم): متجه ط8 {
    دع البداية: مؤشر_محرف_ثابت_إل_إل_في_إم = بداية_مخزن_إل_إل_في_إم(المخزن);
    دع العدد: طبيعي = حجم_مخزن_إل_إل_في_إم(المخزن) مثل طبيعي;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    غير_آمن {
        طالما (ف < العدد) {
            ألحق(الناتج, البداية[ف]);
            ف := ف + 1;
        }
    }
    أرجع الناتج;
}

عام عرف أصدر_وحدة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    احتفظ_بنص_الوحدة: منطقي,
    فرض_التجميع: منطقي
): نتيجة ناتج_مزود_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع نوع_ملف: متغير نوع_ملف_توليد_إل_إل_في_إم = 1;
    دع نوع_ناتج: متغير نوع_ناتج_مزود_إل_إل_في_إم = نوع_ناتج_مزود_إل_إل_في_إم.كائن();
    طابق (*الهدف).نوع_مخرج_الآلة مع
    | نوع_مخرج_آلة_هدف.كائن -> { نوع_ملف := 1; نوع_ناتج := نوع_ناتج_مزود_إل_إل_في_إم.كائن(); }
    | نوع_مخرج_آلة_هدف.تجميع -> { نوع_ملف := 0; نوع_ناتج := نوع_ناتج_مزود_إل_إل_في_إم.تجميع(); };
    لو (فرض_التجميع) { نوع_ملف := 0; نوع_ناتج := نوع_ناتج_مزود_إل_إل_في_إم.تجميع(); };
    // --emit=llvm-ir: the optimized module as LLVM prints it, before code
    // generation (whose passes, such as CodeGenPrepare, rewrite the IR).
    لو (احتفظ_بنص_الوحدة) {
        دع الرسالة_المطبوعة: مؤشر_محرف_متغير_إل_إل_في_إم = اطبع_وحدة_إل_إل_في_إم((*الحالة).الوحدة);
        دع النص: متجه ط8 = انسخ_رسالة_سي_لإل_إل_في_إم(الرسالة_المطبوعة);
        حرر_رسالة_إل_إل_في_إم(الرسالة_المطبوعة);
        دع فارغ: متجه ط8 = [];
        دع ناتج_النص: ناتج_مزود_إل_إل_في_إم = {
            البايتات: فارغ,
            النوع: نوع_ناتج_مزود_إل_إل_في_إم.تجميع(),
            نص_الوحدة: اختياري.موجود(النص)
        };
        أرجع نتيجة.نجح(ناتج_النص);
    };

    دع رسالة: متغير مؤشر_محرف_متغير_إل_إل_في_إم = الفارغ;
    دع المخزن: متغير مرجع_مخزن_ذاكرة_إل_إل_في_إم = الفارغ;
    لو (أصدر_ملف_إل_إل_في_إم((*الحالة).آلة_الهدف, (*الحالة).الوحدة, نوع_ملف, &متغير رسالة, &متغير المخزن) != 0)
        {
        دع النص: متغير متجه ط8 = بايتات_من_نص(«LLVM object/assembly emission failed»);
        لو (رسالة != الفارغ) {
            النص := انسخ_رسالة_سي_لإل_إل_في_إم(رسالة);
            حرر_رسالة_إل_إل_في_إم(رسالة);
        };
        لو (المخزن != الفارغ) { حرر_مخزن_إل_إل_في_إم(المخزن); };
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(النص));
    };
    // LLVM success must return an owned, nonempty buffer of the *requested*
    // file kind. Assembly-only targets stay assembly; never feed text to an
    // object writer or linker as if it were a binary object.
    لو (المخزن == الفارغ) {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(
            بايتات_من_نص(«LLVM returned no emission buffer»)
        ));
    };
    لو (حجم_مخزن_إل_إل_في_إم(المخزن) == 0) {
        حرر_مخزن_إل_إل_في_إم(المخزن);
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(
            بايتات_من_نص(«LLVM emitted an empty object/assembly buffer»)
        ));
    };
    دع البايتات: متجه ط8 = انسخ_مخزن_إل_إل_في_إم(المخزن);
    حرر_مخزن_إل_إل_في_إم(المخزن);
    دع نص_الوحدة: اختياري متجه ط8 = اختياري.لا_شيء();
    دع الناتج: ناتج_مزود_إل_إل_في_إم = {
        البايتات: البايتات,
        النوع: نوع_ناتج,
        نص_الوحدة: نص_الوحدة
    };
    أرجع نتيجة.نجح(الناتج);
}
