استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.target;
استورد compiler.backend.provider.llvm.ffi.target_machine;
استورد compiler.backend.target.target_model;

عرف ثلاثي_هدف_إل_إل_في_إم(الهدف: &واصف_هدف): اختيار متجه غ8 {
    دع و: واصف_هدف = *الهدف;
    طابق و.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        طابق و.المنصة.المنصة مع
        | هوية_منصة.ماك_أو_إس -> {
            دع ت: متجه غ8 = [0x61,0x61,0x72,0x63,0x68,0x36,0x34,0x2D,0x61,0x70,0x70,0x6C,0x65,0x2D,0x64,0x61,0x72,0x77,0x69,0x6E];
            أرجع اختيار.بعض(ت);
        }
        | هوية_منصة.لينكس -> {
            دع ت: متجه غ8 = [0x61,0x61,0x72,0x63,0x68,0x36,0x34,0x2D,0x75,0x6E,0x6B,0x6E,0x6F,0x77,0x6E,0x2D,0x6C,0x69,0x6E,0x75,0x78,0x2D,0x67,0x6E,0x75];
            أرجع اختيار.بعض(ت);
        }
        | هوية_منصة.ويندوز -> {
            دع ت: متجه غ8 = [0x61,0x61,0x72,0x63,0x68,0x36,0x34,0x2D,0x70,0x63,0x2D,0x77,0x69,0x6E,0x64,0x6F,0x77,0x73,0x2D,0x6D,0x73,0x76,0x63];
            أرجع اختيار.بعض(ت);
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        طابق و.المنصة.المنصة مع
        | هوية_منصة.لينكس -> {
            دع ت: متجه غ8 = [0x78,0x38,0x36,0x5F,0x36,0x34,0x2D,0x75,0x6E,0x6B,0x6E,0x6F,0x77,0x6E,0x2D,0x6C,0x69,0x6E,0x75,0x78,0x2D,0x67,0x6E,0x75];
            أرجع اختيار.بعض(ت);
        }
        | هوية_منصة.ماك_أو_إس -> {
            دع ت: متجه غ8 = [0x78,0x38,0x36,0x5F,0x36,0x34,0x2D,0x61,0x70,0x70,0x6C,0x65,0x2D,0x64,0x61,0x72,0x77,0x69,0x6E];
            أرجع اختيار.بعض(ت);
        }
        | هوية_منصة.ويندوز -> {
            دع ت: متجه غ8 = [0x78,0x38,0x36,0x5F,0x36,0x34,0x2D,0x70,0x63,0x2D,0x77,0x69,0x6E,0x64,0x6F,0x77,0x73,0x2D,0x6D,0x73,0x76,0x63];
            أرجع اختيار.بعض(ت);
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> {
        لو (و.المنصة.المنصة == هوية_منصة.لينكس()) {
            دع ت: متجه غ8 = [0x72,0x69,0x73,0x63,0x76,0x36,0x34,0x2D,0x75,0x6E,0x6B,0x6E,0x6F,0x77,0x6E,0x2D,0x6C,0x69,0x6E,0x75,0x78,0x2D,0x67,0x6E,0x75];
            أرجع اختيار.بعض(ت);
        };
        أرجع اختيار.لا_شيء();
    }
    | هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون -> {
        لو (و.المنصة.المنصة == هوية_منصة.واسي()) {
            دع ت: متجه غ8 = [0x77,0x61,0x73,0x6D,0x33,0x32,0x2D,0x75,0x6E,0x6B,0x6E,0x6F,0x77,0x6E,0x2D,0x77,0x61,0x73,0x69];
            أرجع اختيار.بعض(ت);
        };
        أرجع اختيار.لا_شيء();
    }
    | هوية_معمارية.ذراع_سبعة -> { أرجع اختيار.لا_شيء(); };
}

عرف هيئ_معمارية_إل_إل_في_إم(الهدف: &واصف_هدف): منطقي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { هيئ_هدف_إكس_إل_إل_في_إم(); أرجع صواب; }
    | هوية_معمارية.ذراع_أربعة_وستون -> { هيئ_هدف_ذراع64_إل_إل_في_إم(); أرجع صواب; }
    | هوية_معمارية.ذراع_سبعة -> { هيئ_هدف_ذراع_إل_إل_في_إم(); أرجع صواب; }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> { هيئ_هدف_رايسك_في_إل_إل_في_إم(); أرجع صواب; }
    | هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون -> { هيئ_هدف_ويب_أسمبلي_إل_إل_في_إم(); أرجع صواب; };
}

عام نوع نتيجة_تهيئة_هدف_إل_إل_في_إم =
    | نجح بنوع حالة_مزود_إل_إل_في_إم
    | خطأ بنوع فشل_مزود_إل_إل_في_إم
;

عام عرف هيئ_حالة_مزود_إل_إل_في_إم(
    الهدف_المقنن: &واصف_هدف,
    المستوى: مستوى_تحسين_مزود_إل_إل_في_إم
): نتيجة_تهيئة_هدف_إل_إل_في_إم {
    لو (!هيئ_معمارية_إل_إل_في_إم(الهدف_المقنن)) {
        أرجع نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.هدف_غير_مدعوم());
    };
    دع الثلاثي_الأولي: متجه غ8;
    طابق ثلاثي_هدف_إل_إل_في_إم(الهدف_المقنن) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.هدف_غير_مدعوم()); }
    | اختيار.بعض(ت) -> { الثلاثي_الأولي := ت; };
    دع الثلاثي_سي: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الثلاثي_الأولي);
    دع الثلاثي_المطبع: مؤشر_محرف_متغير_إل_إل_في_إم = طبع_ثلاثي_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الثلاثي_سي));
    دع مرجع_هدف: متغير مرجع_هدف_إل_إل_في_إم;
    دع رسالة: متغير مؤشر_محرف_متغير_إل_إل_في_إم;
    لو (ابحث_هدف_إل_إل_في_إم(الثلاثي_المطبع, &متغير مرجع_هدف, &متغير رسالة) != 0) {
        دع النص: متجه غ8 = انسخ_رسالة_سي_لإل_إل_في_إم(رسالة);
        حرر_رسالة_إل_إل_في_إم(رسالة); حرر_رسالة_إل_إل_في_إم(الثلاثي_المطبع);
        أرجع نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.خلفية_هدف_غير_متاحة(النص));
    };
    دع اسم_الوحدة: متغير متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0];
    دع السياق: مرجع_سياق_إل_إل_في_إم = أنشئ_سياق_إل_إل_في_إم();
    دع الوحدة: مرجع_وحدة_إل_إل_في_إم = أنشئ_وحدة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الوحدة), السياق);
    ضع_ثلاثي_وحدة_إل_إل_في_إم(الوحدة, الثلاثي_المطبع);
    دع خيارات: مرجع_خيارات_آلة_هدف_إل_إل_في_إم = أنشئ_خيارات_آلة_إل_إل_في_إم();
    دع مستوى_آلة: متغير ص32 = 0;
    طابق المستوى مع
    | مستوى_تحسين_مزود_إل_إل_في_إم.بلا -> { مستوى_آلة := 0; }
    | مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي -> { مستوى_آلة := 2; }
    | مستوى_تحسين_مزود_إل_إل_في_إم.عال -> { مستوى_آلة := 3; };
    ضع_تحسين_آلة_إل_إل_في_إم(خيارات, مستوى_آلة);
    دع الآلة: مرجع_آلة_هدف_إل_إل_في_إم = أنشئ_آلة_إل_إل_في_إم(مرجع_هدف, الثلاثي_المطبع, خيارات);
    حرر_خيارات_آلة_إل_إل_في_إم(خيارات);
    دع البيانات: مرجع_بيانات_هدف_إل_إل_في_إم = أنشئ_بيانات_هدف_إل_إل_في_إم(الآلة);
    ضع_بيانات_تخطيط_وحدة_إل_إل_في_إم(الوحدة, البيانات);
    دع حجم_المؤشر: غير_موقع = حجم_مؤشر_إل_إل_في_إم(البيانات) مثل غير_موقع;
    دع المتوقع: غير_موقع = (*الهدف_المقنن).نموذج_البيانات.عرض_المؤشر / 8;
    لو (حجم_المؤشر != المتوقع) {
        حرر_بيانات_هدف_إل_إل_في_إم(البيانات); حرر_آلة_إل_إل_في_إم(الآلة); حرر_وحدة_إل_إل_في_إم(الوحدة); حرر_سياق_إل_إل_في_إم(السياق); حرر_رسالة_إل_إل_في_إم(الثلاثي_المطبع);
        أرجع نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.عدم_تطابق_حجم_المؤشر(المتوقع, حجم_المؤشر));
    };
    دع الباني: مرجع_بان_إل_إل_في_إم = أنشئ_باني_إل_إل_في_إم(السياق);
    حرر_رسالة_إل_إل_في_إم(الثلاثي_المطبع);
    دع الأنواع: متجه اختيار قيد_نوع_إل_إل_في_إم = [];
    دع الدوال: متجه اختيار قيد_دالة_إل_إل_في_إم = [];
    دع الخارجية: متجه اختيار قيد_دالة_خارجية_إل_إل_في_إم = [];
    دع العوام: متجه اختيار قيد_عام_إل_إل_في_إم = [];
    دع الحالة: حالة_مزود_إل_إل_في_إم = {
        السياق: السياق, الوحدة: الوحدة, الباني: الباني,
        الهدف: مرجع_هدف, آلة_الهدف: الآلة, بيانات_الهدف: البيانات,
        الأنواع: الأنواع, الدوال: الدوال, الدوال_الخارجية: الخارجية, العوام: العوام
    };
    أرجع نتيجة_تهيئة_هدف_إل_إل_في_إم.نجح(الحالة);
}

عام عرف حرر_حالة_مزود_إل_إل_في_إم(الحالة: &متغير حالة_مزود_إل_إل_في_إم): فراغ {
    حرر_باني_إل_إل_في_إم((*الحالة).الباني);
    حرر_بيانات_هدف_إل_إل_في_إم((*الحالة).بيانات_الهدف);
    حرر_آلة_إل_إل_في_إم((*الحالة).آلة_الهدف);
    حرر_وحدة_إل_إل_في_إم((*الحالة).الوحدة);
    حرر_سياق_إل_إل_في_إم((*الحالة).السياق);
}
