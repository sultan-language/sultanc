استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.provider.llvm.ffi.target;
استورد compiler.backend.provider.llvm.ffi.target_machine;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;

عرف ثلاثي_هدف_إل_إل_في_إم(الهدف: &واصف_هدف): متجه غ8 {
    دع النص: &نص = &(*الهدف).الثلاثي_المقنن;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*النص) مثل غير_موقع)) {
        ألحق(الناتج, (*النص)[ف] مثل غ8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف هيئ_معمارية_إل_إل_في_إم(الهدف: &واصف_هدف): فراغ {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { هيئ_هدف_ذراع64_إل_إل_في_إم(); }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { هيئ_هدف_إكس_إل_إل_في_إم(); }
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> { هيئ_هدف_إكس_إل_إل_في_إم(); }
    | هوية_معمارية.ذراع_سبعة -> { هيئ_هدف_ذراع_إل_إل_في_إم(); }
    | هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون -> { هيئ_هدف_ويب_أسمبلي_إل_إل_في_إم(); }
    | هوية_معمارية.ويب_أسمبلي_أربعة_وستون -> { هيئ_هدف_ويب_أسمبلي_إل_إل_في_إم(); }
    | هوية_معمارية.رايسك_في_اثنان_وثلاثون -> { هيئ_هدف_رايسك_في_إل_إل_في_إم(); }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> { هيئ_هدف_رايسك_في_إل_إل_في_إم(); }
    | هوية_معمارية.إيه_إم_دي_جي_بي_يو -> { هيئ_هدف_إيه_إم_دي_جي_بي_يو_إل_إل_في_إم(); }
    | هوية_معمارية.إيه_في_آر -> { هيئ_هدف_إيه_في_آر_إل_إل_في_إم(); }
    | هوية_معمارية.بي_بي_إف -> { هيئ_هدف_بي_بي_إف_إل_إل_في_إم(); }
    | هوية_معمارية.هيكساغون -> { هيئ_هدف_هيكساغون_إل_إل_في_إم(); }
    | هوية_معمارية.لاناي -> { هيئ_هدف_لاناي_إل_إل_في_إم(); }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> { هيئ_هدف_لونغ_آرتش_إل_إل_في_إم(); }
    | هوية_معمارية.ميبس_أربعة_وستون -> { هيئ_هدف_ميبس_إل_إل_في_إم(); }
    | هوية_معمارية.إم_إس_بي_أربعمئة_وثلاثون -> { هيئ_هدف_إم_إس_بي_أربعمئة_وثلاثون_إل_إل_في_إم(); }
    | هوية_معمارية.إن_في_بي_تي_إكس_أربعة_وستون -> { هيئ_هدف_إن_في_بي_تي_إكس_إل_إل_في_إم(); }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> { هيئ_هدف_باور_بي_سي_إل_إل_في_إم(); }
    | هوية_معمارية.سبارك_أربعة_وستون -> { هيئ_هدف_سبارك_إل_إل_في_إم(); }
    | هوية_معمارية.سبير_في_أربعة_وستون -> { هيئ_هدف_سبير_في_إل_إل_في_إم(); }
    | هوية_معمارية.سيستم_زد -> { هيئ_هدف_سيستم_زد_إل_إل_في_إم(); }
    | هوية_معمارية.في_إي -> { هيئ_هدف_في_إي_إل_إل_في_إم(); }
    | هوية_معمارية.إكس_كور -> { هيئ_هدف_إكس_كور_إل_إل_في_إم(); };
}

عام نوع نتيجة_تهيئة_هدف_إل_إل_في_إم =
    | نجح بنوع حالة_مزود_إل_إل_في_إم
    | خطأ بنوع فشل_مزود_إل_إل_في_إم
;

عام عرف هيئ_حالة_مزود_إل_إل_في_إم(
    الهدف_المقنن: &واصف_هدف,
    المستوى: مستوى_تحسين_مزود_إل_إل_في_إم,
    سياسة_التموضع: سياسة_تموضع_شفرة_إل_إل_في_إم
): نتيجة_تهيئة_هدف_إل_إل_في_إم {
    دع الهدف: واصف_هدف;
    طابق حل_بمعرف_هدف((*الهدف_المقنن).المعرف) مع
    | نتيجة_حل_هدف.غير_مسجل -> {
        أرجع نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.هدف_غير_مدعوم());
    }
    | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف := الوصف; };
    هيئ_معمارية_إل_إل_في_إم(&الهدف);
    دع الثلاثي_الأولي: متجه غ8 = ثلاثي_هدف_إل_إل_في_إم(&الهدف);
    دع الثلاثي_سي: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الثلاثي_الأولي);
    دع الثلاثي_المطبع_الخام: مؤشر_محرف_متغير_إل_إل_في_إم = طبع_ثلاثي_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
        الثلاثي_سي));
    دع الثلاثي_المطبع_بايتات: متجه غ8 = انسخ_رسالة_سي_لإل_إل_في_إم(الثلاثي_المطبع_الخام);
    حرر_رسالة_إل_إل_في_إم(الثلاثي_المطبع_الخام);
    دع الثلاثي_المطبع_سي: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الثلاثي_المطبع_بايتات);
    دع الثلاثي_المطبع: مؤشر_محرف_ثابت_إل_إل_في_إم = مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الثلاثي_المطبع_سي);
    دع حارس_مؤشر: متغير غ8 = 0;
    دع مرجع_هدف: متغير مرجع_هدف_إل_إل_في_إم = &متغير حارس_مؤشر;
    دع رسالة: متغير مؤشر_محرف_متغير_إل_إل_في_إم = &متغير حارس_مؤشر;
    لو (ابحث_هدف_إل_إل_في_إم(الثلاثي_المطبع, &متغير مرجع_هدف, &متغير رسالة) != 0) {
        دع النص: متجه غ8 = انسخ_رسالة_سي_لإل_إل_في_إم(رسالة);
        حرر_رسالة_إل_إل_في_إم(رسالة);
        أرجع نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.خلفية_هدف_غير_متاحة(النص));
    };
    دع اسم_الوحدة: متغير متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0];
    دع السياق: مرجع_سياق_إل_إل_في_إم = أنشئ_سياق_إل_إل_في_إم();
    دع الوحدة: مرجع_وحدة_إل_إل_في_إم = أنشئ_وحدة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الوحدة),
        السياق);
    ضع_ثلاثي_وحدة_إل_إل_في_إم(الوحدة, الثلاثي_المطبع);
    دع خيارات: مرجع_خيارات_آلة_هدف_إل_إل_في_إم = أنشئ_خيارات_آلة_إل_إل_في_إم();
    دع مستوى_آلة: متغير ص32 = 0;
    طابق المستوى مع
    | مستوى_تحسين_مزود_إل_إل_في_إم.بلا -> { مستوى_آلة := 0; }
    | مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي -> { مستوى_آلة := 2; }
    | مستوى_تحسين_مزود_إل_إل_في_إم.عال -> { مستوى_آلة := 3; };
    ضع_تحسين_آلة_إل_إل_في_إم(خيارات, مستوى_آلة);
    طابق سياسة_التموضع مع
    | سياسة_تموضع_شفرة_إل_إل_في_إم.افتراضية -> { }
    | سياسة_تموضع_شفرة_إل_إل_في_إم.مستقلة_الموضع -> {
        // LLVMRelocPIC = 2 in the stable LLVM C API enum.
        ضع_نمط_إعادة_تموضع_آلة_إل_إل_في_إم(خيارات, 2);
    };
    دع الآلة: مرجع_آلة_هدف_إل_إل_في_إم = أنشئ_آلة_إل_إل_في_إم(
        مرجع_هدف,
        الثلاثي_المطبع,
        خيارات
    );
    حرر_خيارات_آلة_إل_إل_في_إم(خيارات);
    دع البيانات: مرجع_بيانات_هدف_إل_إل_في_إم = أنشئ_بيانات_هدف_إل_إل_في_إم(الآلة);
    ضع_بيانات_تخطيط_وحدة_إل_إل_في_إم(الوحدة, البيانات);
    دع حجم_المؤشر: غير_موقع = حجم_مؤشر_إل_إل_في_إم(البيانات) مثل غير_موقع;
    دع المتوقع: غير_موقع = الهدف.نموذج_البيانات.عرض_المؤشر / 8;
    لو (حجم_المؤشر != المتوقع) {
        حرر_بيانات_هدف_إل_إل_في_إم(البيانات); حرر_آلة_إل_إل_في_إم(الآلة); حرر_وحدة_إل_إل_في_إم(الوحدة);
            حرر_سياق_إل_إل_في_إم(السياق);
        أرجع نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.عدم_تطابق_حجم_المؤشر(المتوقع, حجم_المؤشر));
    };
    دع الباني: مرجع_بان_إل_إل_في_إم = أنشئ_باني_إل_إل_في_إم(السياق);
    دع باني_الحجز: مرجع_بان_إل_إل_في_إم = أنشئ_باني_إل_إل_في_إم(السياق);
    دع الأنواع: متجه اختيار قيد_نوع_إل_إل_في_إم = [];
    دع الدوال: متجه اختيار قيد_دالة_إل_إل_في_إم = [];
    دع الخارجية: متجه اختيار قيد_دالة_خارجية_إل_إل_في_إم = [];
    دع العوام: متجه اختيار قيد_عام_إل_إل_في_إم = [];
    دع البدائيات: متجه تصريح_بدائي_نداء_إل_إل_في_إم = [];
    دع الخدمات: متجه تصريح_خدمة_تشغيل_إل_إل_في_إم = [];
    دع الحالة: حالة_مزود_إل_إل_في_إم = {
        السياق: السياق, الوحدة: الوحدة, الباني: الباني, باني_الحجز: باني_الحجز,
        الهدف: مرجع_هدف, آلة_الهدف: الآلة, بيانات_الهدف: البيانات,
        الأنواع: الأنواع, الدوال: الدوال, الدوال_الخارجية: الخارجية, العوام: العوام,
        بدائيات_التشغيل: البدائيات, خدمات_التشغيل: الخدمات
    };
    أرجع نتيجة_تهيئة_هدف_إل_إل_في_إم.نجح(الحالة);
}

عام عرف حرر_حالة_مزود_إل_إل_في_إم(الحالة: &متغير حالة_مزود_إل_إل_في_إم): فراغ {
    حرر_باني_إل_إل_في_إم((*الحالة).باني_الحجز);
    حرر_باني_إل_إل_في_إم((*الحالة).الباني);
    حرر_بيانات_هدف_إل_إل_في_إم((*الحالة).بيانات_الهدف);
    حرر_آلة_إل_إل_في_إم((*الحالة).آلة_الهدف);
    حرر_وحدة_إل_إل_في_إم((*الحالة).الوحدة);
    حرر_سياق_إل_إل_في_إم((*الحالة).السياق);
}
