استورد compiler.backend.provider.llvm.model;
استورد std.text.from_bytes;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;

// Division that the target cannot do with an instruction. LLVM legalizes it
// into compiler-rt or libgcc calls, which no SultanC link provides:
// - 64-bit division where registers are narrower (i386, ARM, the 32- and
//   16-bit embedded targets): __udivdi3, __aeabi_uldivmod, ...;
// - every width on targets with no divide instruction (ARMv7-A, which does
//   not guarantee SDIV/UDIV: __aeabi_idiv; AVR: __divmodqi4/__divmodhi4;
//   MSP430: __mspabi_divi; Hexagon: __hexagon_divsi3; Lanai: __divsi3).
// The provider emits one internal function per width N, sultanc.udivmodN,
// that divides by restoring shift-and-subtract with constant shifts only,
// and builds the signed forms around it. Every other case uses the
// instruction; SPARC V9 does narrow division in 64 bits (SDIVX/UDIVX) rather
// than with the deprecated Y-register SDIV/UDIV.

عرف دالة_قسمة_برمجية_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم, العرض: ط32): مرجع_قيمة_إل_إل_في_إم {
    دع الاسم: متغير متجه ط8 = بايتات_من_نص(«sultanc.udivmod»);
    لو (العرض >= 10) { ألحق(الاسم, (0x30 + ((العرض / 10) مثل ط8)) مثل ط8); };
    ألحق(الاسم, (0x30 + ((العرض % 10) مثل ط8)) مثل ط8);
    ألحق(الاسم, 0 مثل ط8);
    دع الموجودة: مرجع_قيمة_إل_إل_في_إم = LLVMGetNamedFunction((*الحالة).الوحدة, &متغير الاسم[0]);
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    // نوع_ص64 is the operand width N (64 for the original 64-bit form).
    دع نوع_ص64: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, العرض);
    دع نوع_ص32: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, 32);
    دع نوع_ص1: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, 1);
    لو (الموجودة != الفارغ) { أرجع الموجودة; };
    دع المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_ص64, نوع_ص64, نوع_ص1];
    دع التوقيع: مرجع_نوع_إل_إل_في_إم = LLVMFunctionType(نوع_ص64, &متغير المعاملات[0], 3, 0);
    دع الدالة: مرجع_قيمة_إل_إل_في_إم = LLVMAddFunction((*الحالة).الوحدة, &متغير الاسم[0], التوقيع);
    LLVMSetLinkage(الدالة, ربط_داخلي_إل_إل_في_إم());
    دع اسم_الدخول: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«entry»);
    دع اسم_الحلقة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«loop»);
    دع اسم_الخروج: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«exit»);
    دع الدخول: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(السياق, الدالة, &متغير اسم_الدخول[0]);
    دع الحلقة: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(السياق, الدالة, &متغير اسم_الحلقة[0]);
    دع الخروج: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(السياق, الدالة, &متغير اسم_الخروج[0]);
    دع الباني: مرجع_بان_إل_إل_في_إم = LLVMCreateBuilderInContext(السياق);
    دع ف: متغير متجه ط8 = [0];
    دع المقسوم: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(الدالة, 0);
    دع المقسوم_عليه: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(الدالة, 1);
    دع طلب_الباقي: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(الدالة, 2);
    دع صفر64: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 0, 0);
    دع واحد64: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 1, 0);
    دع ثلاثة_وستون: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, (العرض - 1) مثل ط64, 0);
    دع أربعة_وستون: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص32, العرض مثل ط64, 0);
    دع واحد32: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص32, 1, 0);
    دع صفر32: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص32, 0, 0);
    LLVMPositionBuilderAtEnd(الباني, الدخول);
    LLVMBuildBr(الباني, الحلقة);
    LLVMPositionBuilderAtEnd(الباني, الحلقة);
    // i: bits left; n: dividend shifted so its next bit is the top one;
    // q: quotient so far; r: remainder so far (r < d).
    دع ي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildPhi(الباني, نوع_ص32, &متغير ف[0]);
    دع ن: مرجع_قيمة_إل_إل_في_إم = LLVMBuildPhi(الباني, نوع_ص64, &متغير ف[0]);
    دع ق: مرجع_قيمة_إل_إل_في_إم = LLVMBuildPhi(الباني, نوع_ص64, &متغير ف[0]);
    دع ب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildPhi(الباني, نوع_ص64, &متغير ف[0]);
    دع البت: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, ن, ثلاثة_وستون, &متغير ف[0]);
    دع ن_التالي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني, ن, واحد64, &متغير ف[0]);
    // r < d <= 2^N - 1, so 2r + bit has at most N + 1 bits: its top bit is
    // r's top bit, and a set top bit means it is at least d.
    دع أعلى_ب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, ب, ثلاثة_وستون, &متغير ف[0]);
    دع ب_مزاح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني, ب, واحد64, &متغير ف[0]);
    دع ب_جديد: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني, ب_مزاح, البت, &متغير ف[0]);
    دع أكبر: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 35, ب_جديد, المقسوم_عليه, &متغير ف[0]);
    دع حمل: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 33, أعلى_ب, صفر64, &متغير ف[0]);
    دع يطرح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني, أكبر, حمل, &متغير ف[0]);
    دع المطروح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, ب_جديد, المقسوم_عليه, &متغير ف[0]);
    دع ب_التالي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, يطرح, المطروح, ب_جديد, &متغير ف[0]);
    دع ق_مزاح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني, ق, واحد64, &متغير ف[0]);
    دع ق_زائد: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني, ق_مزاح, واحد64, &متغير ف[0]);
    دع ق_التالي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, يطرح, ق_زائد, ق_مزاح, &متغير ف[0]);
    دع ي_التالي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, ي, واحد32, &متغير ف[0]);
    دع انتهى: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 32, ي_التالي, صفر32, &متغير ف[0]);
    LLVMBuildCondBr(الباني, انتهى, الخروج, الحلقة);
    دع قيم_ي: متغير متجه مرجع_قيمة_إل_إل_في_إم = [أربعة_وستون, ي_التالي];
    دع قيم_ن: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المقسوم, ن_التالي];
    دع قيم_ق: متغير متجه مرجع_قيمة_إل_إل_في_إم = [صفر64, ق_التالي];
    دع قيم_ب: متغير متجه مرجع_قيمة_إل_إل_في_إم = [صفر64, ب_التالي];
    دع الكتل_ي: متغير متجه مرجع_كتلة_إل_إل_في_إم = [الدخول, الحلقة];
    دع الكتل_ن: متغير متجه مرجع_كتلة_إل_إل_في_إم = [الدخول, الحلقة];
    دع الكتل_ق: متغير متجه مرجع_كتلة_إل_إل_في_إم = [الدخول, الحلقة];
    دع الكتل_ب: متغير متجه مرجع_كتلة_إل_إل_في_إم = [الدخول, الحلقة];
    LLVMAddIncoming(ي, &متغير قيم_ي[0], &متغير الكتل_ي[0], 2);
    LLVMAddIncoming(ن, &متغير قيم_ن[0], &متغير الكتل_ن[0], 2);
    LLVMAddIncoming(ق, &متغير قيم_ق[0], &متغير الكتل_ق[0], 2);
    LLVMAddIncoming(ب, &متغير قيم_ب[0], &متغير الكتل_ب[0], 2);
    LLVMPositionBuilderAtEnd(الباني, الخروج);
    دع الناتج: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, طلب_الباقي, ب_التالي, ق_التالي, &متغير ف[0]);
    LLVMBuildRet(الباني, الناتج);
    LLVMDisposeBuilder(الباني);
    أرجع الدالة;
}

عرف استدع_قسمة_برمجية_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    باقي: منطقي
): مرجع_قيمة_إل_إل_في_إم {
    دع العرض: ط32 = LLVMGetIntTypeWidth(LLVMTypeOf(أ));
    دع الدالة: مرجع_قيمة_إل_إل_في_إم = دالة_قسمة_برمجية_إل_إل_في_إم(الحالة, العرض);
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    دع نوع_ص64: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, العرض);
    دع نوع_ص1: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, 1);
    دع المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_ص64, نوع_ص64, نوع_ص1];
    دع التوقيع: مرجع_نوع_إل_إل_في_إم = LLVMFunctionType(نوع_ص64, &متغير المعاملات[0], 3, 0);
    دع العلم: متغير ط64 = 0;
    لو (باقي) { العلم := 1; };
    دع طلب: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص1, العلم, 0);
    دع الوسائط: متغير متجه مرجع_قيمة_إل_إل_في_إم = [أ, ب, طلب];
    دع ف: متغير متجه ط8 = [0];
    أرجع LLVMBuildCall2((*الحالة).الباني, التوقيع, الدالة, &متغير الوسائط[0], 3, &متغير ف[0]);
}

// a / b or a % b (signed or unsigned). The caller has already trapped
// division by zero and the signed MIN / -1 overflow where the language
// requires it.
عام عرف ابن_قسمة_صحيحة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    موقع: منطقي,
    باقي: منطقي
): مرجع_قيمة_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع ف: متغير متجه ط8 = [0];
    دع العرض: ط32 = LLVMGetIntTypeWidth(LLVMTypeOf(أ));
    لو ((*الحالة).قسمة_ضيقة_بعرض_64 && العرض < 64) {
        // The quotient and remainder of the extended operands are those of
        // the narrow ones (MIN / -1 was trapped before).
        دع نوع_ص64_الواسع: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
        دع أ_واسع: متغير مرجع_قيمة_إل_إل_في_إم = أ;
        دع ب_واسع: متغير مرجع_قيمة_إل_إل_في_إم = ب;
        لو (موقع) {
            أ_واسع := LLVMBuildSExt(الباني, أ, نوع_ص64_الواسع, &متغير ف[0]);
            ب_واسع := LLVMBuildSExt(الباني, ب, نوع_ص64_الواسع, &متغير ف[0]);
        } وإلا {
            أ_واسع := LLVMBuildZExt(الباني, أ, نوع_ص64_الواسع, &متغير ف[0]);
            ب_واسع := LLVMBuildZExt(الباني, ب, نوع_ص64_الواسع, &متغير ف[0]);
        };
        دع الناتج_الواسع: مرجع_قيمة_إل_إل_في_إم = ابن_قسمة_صحيحة_إل_إل_في_إم(الحالة, أ_واسع, ب_واسع, موقع, باقي);
        أرجع LLVMBuildTrunc(الباني, الناتج_الواسع, LLVMTypeOf(أ), &متغير ف[0]);
    };
    دع برمجية: منطقي = ((*الحالة).قسمة_64_برمجية && العرض == 64)
        || (*الحالة).قسمة_برمجية_كلها;
    لو (!برمجية) {
        لو (باقي) {
            لو (موقع) { أرجع LLVMBuildSRem(الباني, أ, ب, &متغير ف[0]); };
            أرجع LLVMBuildURem(الباني, أ, ب, &متغير ف[0]);
        };
        لو (موقع) { أرجع LLVMBuildSDiv(الباني, أ, ب, &متغير ف[0]); };
        أرجع LLVMBuildUDiv(الباني, أ, ب, &متغير ف[0]);
    };
    لو (!موقع) { أرجع استدع_قسمة_برمجية_إل_إل_في_إم(الحالة, أ, ب, باقي); };
    // Signed: divide the magnitudes; the quotient is negative when the signs
    // differ, the remainder takes the dividend's sign.
    دع نوع_ص64: مرجع_نوع_إل_إل_في_إم = LLVMTypeOf(أ);
    دع صفر: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 0, 0);
    دع أ_سالب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 40, أ, صفر, &متغير ف[0]);
    دع ب_سالب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 40, ب, صفر, &متغير ف[0]);
    دع سالب_أ: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, صفر, أ, &متغير ف[0]);
    دع سالب_ب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, صفر, ب, &متغير ف[0]);
    دع مقدار_أ: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, أ_سالب, سالب_أ, أ, &متغير ف[0]);
    دع مقدار_ب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, ب_سالب, سالب_ب, ب, &متغير ف[0]);
    دع الناتج: مرجع_قيمة_إل_إل_في_إم = استدع_قسمة_برمجية_إل_إل_في_إم(الحالة, مقدار_أ, مقدار_ب, باقي);
    دع سالب_الناتج: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, صفر, الناتج, &متغير ف[0]);
    لو (باقي) {
        أرجع LLVMBuildSelect(الباني, أ_سالب, سالب_الناتج, الناتج, &متغير ف[0]);
    };
    دع مختلفان: مرجع_قيمة_إل_إل_في_إم = LLVMBuildXor(الباني, أ_سالب, ب_سالب, &متغير ف[0]);
    أرجع LLVMBuildSelect(الباني, مختلفان, سالب_الناتج, الناتج, &متغير ف[0]);
}
