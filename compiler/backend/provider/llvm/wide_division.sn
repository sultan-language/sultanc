استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد المكتبة.نصوص.من_بايتات;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;

// Division that the target cannot do with an instruction. LLVM legalizes it
// into compiler-rt or libgcc calls, which no SultanC link provides:
// - 64-bit division where registers are narrower (i386, ARM, the 32- and
//   16-bit embedded targets): __udivdi3, __aeabi_uldivmod, ...;
// - every width on targets with no divide instruction (ARMv7-A, which does
//   not guarantee SDIV/UDIV: __aeabi_idiv; AVR: __divmodqi4/__divmodhi4;
//   MSP430: __mspabi_divi; Hexagon: __hexagon_divsi3; Lanai: __divsi3).
// The provider emits one internal function per width N, sultanc.udivmodN,
// that divides by restoring shift-and-subtract with constant shifts only,
// and builds the signed forms around it. Every other case uses the
// instruction; SPARC V9 does narrow division in 64 bits (SDIVX/UDIVX) rather
// than with the deprecated Y-register SDIV/UDIV.

عرف دالة_قسمة_برمجية_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم, العرض: ط32): مرجع_قيمة_إل_إل_في_إم {
    ليكن الاسم: متغير متجه ط8 = بايتات_من_نص(«sultanc.udivmod»);
    إذا (العرض >= 10) { ألحق(الاسم, (0x30 + ((العرض / 10) مثل ط8)) مثل ط8); };
    ألحق(الاسم, (0x30 + ((العرض % 10) مثل ط8)) مثل ط8);
    ألحق(الاسم, 0 مثل ط8);
    ليكن الموجودة: مرجع_قيمة_إل_إل_في_إم = LLVMGetNamedFunction((*الحالة).الوحدة, &متغير الاسم[0]);
    ليكن السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    // نوع_ص64 is the operand width N (64 for the original 64-bit form).
    ليكن نوع_ص64: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, العرض);
    ليكن نوع_ص32: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, 32);
    ليكن نوع_ص1: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, 1);
    إذا (الموجودة != الفارغ) { أرجع الموجودة; };
    ليكن المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_ص64, نوع_ص64, نوع_ص1];
    ليكن التوقيع: مرجع_نوع_إل_إل_في_إم = LLVMFunctionType(نوع_ص64, &متغير المعاملات[0], 3, 0);
    ليكن الدالة: مرجع_قيمة_إل_إل_في_إم = LLVMAddFunction((*الحالة).الوحدة, &متغير الاسم[0], التوقيع);
    LLVMSetLinkage(الدالة, ربط_داخلي_إل_إل_في_إم());
    ليكن اسم_الدخول: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«entry»);
    ليكن اسم_الحلقة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«loop»);
    ليكن اسم_الخروج: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«exit»);
    ليكن الدخول: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(السياق, الدالة, &متغير اسم_الدخول[0]);
    ليكن الحلقة: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(السياق, الدالة, &متغير اسم_الحلقة[0]);
    ليكن الخروج: مرجع_كتلة_إل_إل_في_إم = LLVMAppendBasicBlockInContext(السياق, الدالة, &متغير اسم_الخروج[0]);
    ليكن الباني: مرجع_بان_إل_إل_في_إم = LLVMCreateBuilderInContext(السياق);
    ليكن ف: متغير متجه ط8 = [0];
    ليكن المقسوم: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(الدالة, 0);
    ليكن المقسوم_عليه: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(الدالة, 1);
    ليكن طلب_الباقي: مرجع_قيمة_إل_إل_في_إم = LLVMGetParam(الدالة, 2);
    ليكن صفر64: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 0, 0);
    ليكن واحد64: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 1, 0);
    ليكن ثلاثة_وستون: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, (العرض - 1) مثل ط64, 0);
    ليكن أربعة_وستون: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص32, العرض مثل ط64, 0);
    ليكن واحد32: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص32, 1, 0);
    ليكن صفر32: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص32, 0, 0);
    LLVMPositionBuilderAtEnd(الباني, الدخول);
    LLVMBuildBr(الباني, الحلقة);
    LLVMPositionBuilderAtEnd(الباني, الحلقة);
    // i: bits left; n: dividend shifted so its next bit is the top one;
    // q: quotient so far; r: remainder so far (r < d).
    ليكن ي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildPhi(الباني, نوع_ص32, &متغير ف[0]);
    ليكن ن: مرجع_قيمة_إل_إل_في_إم = LLVMBuildPhi(الباني, نوع_ص64, &متغير ف[0]);
    ليكن ق: مرجع_قيمة_إل_إل_في_إم = LLVMBuildPhi(الباني, نوع_ص64, &متغير ف[0]);
    ليكن ب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildPhi(الباني, نوع_ص64, &متغير ف[0]);
    ليكن البت: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, ن, ثلاثة_وستون, &متغير ف[0]);
    ليكن ن_التالي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني, ن, واحد64, &متغير ف[0]);
    // r < d <= 2^N - 1, so 2r + bit has at most N + 1 bits: its top bit is
    // r's top bit, and a set top bit means it is at least d.
    ليكن أعلى_ب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, ب, ثلاثة_وستون, &متغير ف[0]);
    ليكن ب_مزاح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني, ب, واحد64, &متغير ف[0]);
    ليكن ب_جديد: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني, ب_مزاح, البت, &متغير ف[0]);
    ليكن أكبر: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 35, ب_جديد, المقسوم_عليه, &متغير ف[0]);
    ليكن حمل: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 33, أعلى_ب, صفر64, &متغير ف[0]);
    ليكن يطرح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني, أكبر, حمل, &متغير ف[0]);
    ليكن المطروح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, ب_جديد, المقسوم_عليه, &متغير ف[0]);
    ليكن ب_التالي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, يطرح, المطروح, ب_جديد, &متغير ف[0]);
    ليكن ق_مزاح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني, ق, واحد64, &متغير ف[0]);
    ليكن ق_زائد: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني, ق_مزاح, واحد64, &متغير ف[0]);
    ليكن ق_التالي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, يطرح, ق_زائد, ق_مزاح, &متغير ف[0]);
    ليكن ي_التالي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, ي, واحد32, &متغير ف[0]);
    ليكن انتهى: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 32, ي_التالي, صفر32, &متغير ف[0]);
    LLVMBuildCondBr(الباني, انتهى, الخروج, الحلقة);
    ليكن قيم_ي: متغير متجه مرجع_قيمة_إل_إل_في_إم = [أربعة_وستون, ي_التالي];
    ليكن قيم_ن: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المقسوم, ن_التالي];
    ليكن قيم_ق: متغير متجه مرجع_قيمة_إل_إل_في_إم = [صفر64, ق_التالي];
    ليكن قيم_ب: متغير متجه مرجع_قيمة_إل_إل_في_إم = [صفر64, ب_التالي];
    ليكن الكتل_ي: متغير متجه مرجع_كتلة_إل_إل_في_إم = [الدخول, الحلقة];
    ليكن الكتل_ن: متغير متجه مرجع_كتلة_إل_إل_في_إم = [الدخول, الحلقة];
    ليكن الكتل_ق: متغير متجه مرجع_كتلة_إل_إل_في_إم = [الدخول, الحلقة];
    ليكن الكتل_ب: متغير متجه مرجع_كتلة_إل_إل_في_إم = [الدخول, الحلقة];
    LLVMAddIncoming(ي, &متغير قيم_ي[0], &متغير الكتل_ي[0], 2);
    LLVMAddIncoming(ن, &متغير قيم_ن[0], &متغير الكتل_ن[0], 2);
    LLVMAddIncoming(ق, &متغير قيم_ق[0], &متغير الكتل_ق[0], 2);
    LLVMAddIncoming(ب, &متغير قيم_ب[0], &متغير الكتل_ب[0], 2);
    LLVMPositionBuilderAtEnd(الباني, الخروج);
    ليكن الناتج: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, طلب_الباقي, ب_التالي, ق_التالي, &متغير ف[0]);
    LLVMBuildRet(الباني, الناتج);
    LLVMDisposeBuilder(الباني);
    أرجع الدالة;
}

عرف استدع_قسمة_برمجية_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    باقي: منطقي
): مرجع_قيمة_إل_إل_في_إم {
    ليكن العرض: ط32 = LLVMGetIntTypeWidth(LLVMTypeOf(أ));
    ليكن الدالة: مرجع_قيمة_إل_إل_في_إم = دالة_قسمة_برمجية_إل_إل_في_إم(الحالة, العرض);
    ليكن السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    ليكن نوع_ص64: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, العرض);
    ليكن نوع_ص1: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم(السياق, 1);
    ليكن المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_ص64, نوع_ص64, نوع_ص1];
    ليكن التوقيع: مرجع_نوع_إل_إل_في_إم = LLVMFunctionType(نوع_ص64, &متغير المعاملات[0], 3, 0);
    ليكن العلم: متغير ط64 = 0;
    إذا (باقي) { العلم := 1; };
    ليكن طلب: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص1, العلم, 0);
    ليكن الوسائط: متغير متجه مرجع_قيمة_إل_إل_في_إم = [أ, ب, طلب];
    ليكن ف: متغير متجه ط8 = [0];
    أرجع LLVMBuildCall2((*الحالة).الباني, التوقيع, الدالة, &متغير الوسائط[0], 3, &متغير ف[0]);
}

// a / b or a % b (signed or unsigned). The caller has already trapped
// division by zero and the signed MIN / -1 overflow where the language
// requires it.
عام عرف ابن_قسمة_صحيحة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    موقع: منطقي,
    باقي: منطقي
): مرجع_قيمة_إل_إل_في_إم {
    ليكن الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    ليكن ف: متغير متجه ط8 = [0];
    ليكن العرض: ط32 = LLVMGetIntTypeWidth(LLVMTypeOf(أ));
    إذا ((*الحالة).قسمة_ضيقة_بعرض_64 && العرض < 64) {
        // The quotient and remainder of the extended operands are those of
        // the narrow ones (MIN / -1 was trapped before).
        ليكن نوع_ص64_الواسع: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
        ليكن أ_واسع: متغير مرجع_قيمة_إل_إل_في_إم = أ;
        ليكن ب_واسع: متغير مرجع_قيمة_إل_إل_في_إم = ب;
        إذا (موقع) {
            أ_واسع := LLVMBuildSExt(الباني, أ, نوع_ص64_الواسع, &متغير ف[0]);
            ب_واسع := LLVMBuildSExt(الباني, ب, نوع_ص64_الواسع, &متغير ف[0]);
        } وإلا {
            أ_واسع := LLVMBuildZExt(الباني, أ, نوع_ص64_الواسع, &متغير ف[0]);
            ب_واسع := LLVMBuildZExt(الباني, ب, نوع_ص64_الواسع, &متغير ف[0]);
        };
        ليكن الناتج_الواسع: مرجع_قيمة_إل_إل_في_إم = ابن_قسمة_صحيحة_إل_إل_في_إم(الحالة, أ_واسع, ب_واسع, موقع, باقي);
        أرجع LLVMBuildTrunc(الباني, الناتج_الواسع, LLVMTypeOf(أ), &متغير ف[0]);
    };
    ليكن برمجية: منطقي = ((*الحالة).قسمة_64_برمجية && العرض == 64)
        || (*الحالة).قسمة_برمجية_كلها;
    إذا (!برمجية && !(موقع && (*الحالة).قسمة_موقعة_بالمقادير)) {
        إذا (باقي) {
            إذا (موقع) { أرجع LLVMBuildSRem(الباني, أ, ب, &متغير ف[0]); };
            أرجع LLVMBuildURem(الباني, أ, ب, &متغير ف[0]);
        };
        إذا (موقع) { أرجع LLVMBuildSDiv(الباني, أ, ب, &متغير ف[0]); };
        أرجع LLVMBuildUDiv(الباني, أ, ب, &متغير ف[0]);
    };
    إذا (!موقع) { أرجع استدع_قسمة_برمجية_إل_إل_في_إم(الحالة, أ, ب, باقي); };
    // Signed: divide the magnitudes; the quotient is negative when the signs
    // differ, the remainder takes the dividend's sign.
    ليكن نوع_ص64: مرجع_نوع_إل_إل_في_إم = LLVMTypeOf(أ);
    ليكن صفر: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 0, 0);
    ليكن أ_سالب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 40, أ, صفر, &متغير ف[0]);
    ليكن ب_سالب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 40, ب, صفر, &متغير ف[0]);
    ليكن سالب_أ: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, صفر, أ, &متغير ف[0]);
    ليكن سالب_ب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, صفر, ب, &متغير ف[0]);
    ليكن مقدار_أ: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, أ_سالب, سالب_أ, أ, &متغير ف[0]);
    ليكن مقدار_ب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, ب_سالب, سالب_ب, ب, &متغير ف[0]);
    ليكن الناتج: متغير مرجع_قيمة_إل_إل_في_إم = مقدار_أ;
    إذا (برمجية) {
        الناتج := استدع_قسمة_برمجية_إل_إل_في_إم(الحالة, مقدار_أ, مقدار_ب, باقي);
    } وإلا إذا (باقي) {
        الناتج := LLVMBuildURem(الباني, مقدار_أ, مقدار_ب, &متغير ف[0]);
    } وإلا {
        الناتج := LLVMBuildUDiv(الباني, مقدار_أ, مقدار_ب, &متغير ف[0]);
    };
    ليكن سالب_الناتج: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, صفر, الناتج, &متغير ف[0]);
    إذا (باقي) {
        أرجع LLVMBuildSelect(الباني, أ_سالب, سالب_الناتج, الناتج, &متغير ف[0]);
    };
    ليكن مختلفان: مرجع_قيمة_إل_إل_في_إم = LLVMBuildXor(الباني, أ_سالب, ب_سالب, &متغير ف[0]);
    أرجع LLVMBuildSelect(الباني, مختلفان, سالب_الناتج, الناتج, &متغير ف[0]);
}

// A checked product: the wrapped value and the overflow flag (i1).
عام نوع ضرب_مفحوص_إل_إل_في_إم = {
    الناتج: مرجع_قيمة_إل_إل_في_إم,
    التجاوز: مرجع_قيمة_إل_إل_في_إم
};

// Checked 64-bit multiplication from 32-bit halves, for targets without a
// 128-bit product (wasm32, wasm64, SPARC V9, the 32-bit targets), where
// llvm.*mul.with.overflow.i64 becomes a __multi3 or __mulodi4 call.
// Unsigned a * b overflows iff both high halves are nonzero, the cross
// product a_hi*b_lo + a_lo*b_hi reaches 2^32, or adding it (shifted) to
// a_lo*b_lo carries. Signed: the magnitudes are multiplied unsigned, and
// the product overflows past 2^63 - 1, or 2^63 when the signs differ.
عام عرف ضرب_64_بالأنصاف_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    موقع: منطقي
): ضرب_مفحوص_إل_إل_في_إم {
    ليكن الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    ليكن ف: متغير متجه ط8 = [0];
    ليكن نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    ليكن صفر: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_عدد, 0, 0);
    ليكن اثنان_وثلاثون: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_عدد, 32, 0);
    ليكن قناع_منخفض: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_عدد, 0xFFFFFFFF, 0);
    ليكن ع_أ: متغير مرجع_قيمة_إل_إل_في_إم = أ;
    ليكن ع_ب: متغير مرجع_قيمة_إل_إل_في_إم = ب;
    إذا (موقع) {
        // ICmp SLT = 40. The magnitude of MIN is 2^63, exact as unsigned.
        ليكن أ_سالب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 40, أ, صفر, &متغير ف[0]);
        ليكن ب_سالب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 40, ب, صفر, &متغير ف[0]);
        ع_أ := LLVMBuildSelect(الباني, أ_سالب, LLVMBuildSub(الباني, صفر, أ, &متغير ف[0]), أ, &متغير ف[0]);
        ع_ب := LLVMBuildSelect(الباني, ب_سالب, LLVMBuildSub(الباني, صفر, ب, &متغير ف[0]), ب, &متغير ف[0]);
    };
    ليكن أ_عال: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, ع_أ, اثنان_وثلاثون, &متغير ف[0]);
    ليكن ب_عال: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, ع_ب, اثنان_وثلاثون, &متغير ف[0]);
    ليكن أ_منخفض: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAnd(الباني, ع_أ, قناع_منخفض, &متغير ف[0]);
    ليكن ب_منخفض: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAnd(الباني, ع_ب, قناع_منخفض, &متغير ف[0]);
    // ICmp NE = 33, UGT = 34, ULT = 36.
    ليكن كلاهما_عال: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAnd(الباني,
        LLVMBuildICmp(الباني, 33, أ_عال, صفر, &متغير ف[0]),
        LLVMBuildICmp(الباني, 33, ب_عال, صفر, &متغير ف[0]), &متغير ف[0]);
    ليكن التقاطع: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAdd(الباني,
        LLVMBuildMul(الباني, أ_عال, ب_منخفض, &متغير ف[0]),
        LLVMBuildMul(الباني, أ_منخفض, ب_عال, &متغير ف[0]), &متغير ف[0]);
    ليكن تقاطع_كبير: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 33,
        LLVMBuildLShr(الباني, التقاطع, اثنان_وثلاثون, &متغير ف[0]), صفر, &متغير ف[0]);
    ليكن المنخفض: مرجع_قيمة_إل_إل_في_إم = LLVMBuildMul(الباني, أ_منخفض, ب_منخفض, &متغير ف[0]);
    ليكن المقدار: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAdd(الباني, المنخفض,
        LLVMBuildShl(الباني, التقاطع, اثنان_وثلاثون, &متغير ف[0]), &متغير ف[0]);
    ليكن حمل: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 36, المقدار, المنخفض, &متغير ف[0]);
    ليكن تجاوز: متغير مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني,
        LLVMBuildOr(الباني, كلاهما_عال, تقاطع_كبير, &متغير ف[0]), حمل, &متغير ف[0]);
    إذا (موقع) {
        // The limit is 2^63 - 1, plus one when exactly one operand is negative.
        ليكن بت_الإشارة: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني,
            LLVMBuildXor(الباني, أ, ب, &متغير ف[0]), LLVMConstInt(نوع_عدد, 63, 0), &متغير ف[0]);
        ليكن الحد: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAdd(الباني,
            LLVMConstInt(نوع_عدد, 0x7FFFFFFFFFFFFFFF, 0), بت_الإشارة, &متغير ف[0]);
        تجاوز := LLVMBuildOr(الباني, تجاوز,
            LLVMBuildICmp(الباني, 34, المقدار, الحد, &متغير ف[0]), &متغير ف[0]);
    };
    ليكن الناتج: ضرب_مفحوص_إل_إل_في_إم = {
        الناتج: LLVMBuildMul(الباني, أ, ب, &متغير ف[0]),
        التجاوز: تجاوز
    };
    أرجع الناتج;
}

// Replaces every llvm.umul/smul.with.overflow.i64 left after optimization
// (InstCombine forms them from user code too, such as `b > MAX / a`) with
// the halves expansion above, on targets without a 128-bit product.
عام عرف وسع_ضرب_التجاوز_64_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم): فراغ {
    إذا (!(*الحالة).ضرب_التجاوز_بالقسمة) { أرجع; };
    ليكن ف: متغير متجه ط8 = [0];
    ليكن خام_طبيعي: متجه ط8 = بايتات_من_نص(«llvm.umul.with.overflow»);
    ليكن خام_موقع: متجه ط8 = بايتات_من_نص(«llvm.smul.with.overflow»);
    ليكن اسم_طبيعي: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&خام_طبيعي);
    ليكن اسم_موقع: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&خام_موقع);
    ليكن هوية_طبيعي: ط32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_طبيعي), الطول(خام_طبيعي) مثل طبيعي);
    ليكن هوية_موقع: ط32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_موقع), الطول(خام_موقع) مثل طبيعي);
    ليكن الدالة: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetFirstFunction((*الحالة).الوحدة);
    طالما (الدالة != الفارغ) {
        ليكن الكتلة: متغير مرجع_كتلة_إل_إل_في_إم = LLVMGetFirstBasicBlock(الدالة);
        طالما (الكتلة != الفارغ) {
            ليكن التعليمة: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetFirstInstruction(الكتلة);
            طالما (التعليمة != الفارغ) {
                ليكن التالية: مرجع_قيمة_إل_إل_في_إم = LLVMGetNextInstruction(التعليمة);
                إذا (LLVMIsACallInst(التعليمة) != الفارغ) {
                    ليكن المستدعى: مرجع_قيمة_إل_إل_في_إم = LLVMGetCalledValue(التعليمة);
                    إذا (المستدعى != الفارغ && LLVMIsAFunction(المستدعى) != الفارغ) {
                        ليكن الهوية: ط32 = LLVMGetIntrinsicID(المستدعى);
                        ليكن أ: مرجع_قيمة_إل_إل_في_إم = LLVMGetOperand(التعليمة, 0);
                        إذا (الهوية != 0 && (الهوية == هوية_طبيعي || الهوية == هوية_موقع)
                            && LLVMGetIntTypeWidth(LLVMTypeOf(أ)) == 64) {
                            LLVMPositionBuilderBefore((*الحالة).الباني, التعليمة);
                            ليكن الضرب: ضرب_مفحوص_إل_إل_في_إم = ضرب_64_بالأنصاف_إل_إل_في_إم(
                                الحالة, أ, LLVMGetOperand(التعليمة, 1), الهوية == هوية_موقع);
                            ليكن البنية: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetUndef(LLVMTypeOf(التعليمة));
                            البنية := LLVMBuildInsertValue((*الحالة).الباني, البنية, الضرب.الناتج, 0, &متغير ف[0]);
                            البنية := LLVMBuildInsertValue((*الحالة).الباني, البنية, الضرب.التجاوز, 1, &متغير ف[0]);
                            LLVMReplaceAllUsesWith(التعليمة, البنية);
                            LLVMInstructionEraseFromParent(التعليمة);
                        };
                    };
                };
                التعليمة := التالية;
            }
            الكتلة := LLVMGetNextBasicBlock(الكتلة);
        }
        الدالة := LLVMGetNextFunction(الدالة);
    }
}
