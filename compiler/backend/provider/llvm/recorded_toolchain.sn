// The LLVM toolchain facts recorded into a compiler built for a WASI host: the
// facts of the compiler that built it, folded into constants by MSIR lowering
// (runtime/toolchain_facts.sn). Imported only from toolchain.sn's WASI block,
// so no other host loads these primitive bindings.
مرادف مكتبة_إل_إل_في_إم_المسجلة_بدائيا = بدائي_مكتبة_إل_إل_في_إم_للأداة;
مرادف إصدار_إل_إل_في_إم_المسجل_بدائيا = بدائي_إصدار_إل_إل_في_إم_للأداة;

عام عرف مسار_مكتبة_إل_إل_في_إم_المسجل(): نص {
    أرجع مكتبة_إل_إل_في_إم_المسجلة_بدائيا();
}

عام عرف إصدار_إل_إل_في_إم_المسجل(): غ32 {
    أرجع إصدار_إل_إل_في_إم_المسجل_بدائيا();
}
