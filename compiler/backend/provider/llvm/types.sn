عام نوع نتيجة_نوع_إل_إل_في_إم =
    | نجح بنوع قيد_نوع_إل_إل_في_إم
    | خطأ بنوع فشل_مزود_إل_إل_في_إم
;

عرف ضمن_فهرس_نوع_إل_إل_في_إم(الحالة: &متغير حالة_مزود_إل_إل_في_إم, النوع: معرف_نوع): فراغ {
    بينما ((الطول((*الحالة).الأنواع) مثل غير_موقع) <= النوع.القيمة) {
        ألحق((*الحالة).الأنواع, اختيار.لا_شيء());
    }
}

عام عرف هل_نوع_تجميعي_إل_إل_في_إم(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    النوع: معرف_نوع
): اختيار منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(&(*الحقائق).الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.نص -> { أرجع اختيار.بعض(صواب); }
            | _ -> { أرجع اختيار.بعض(خطأ); };
        }
        | صنف_شكل_نوع_دلالي.صف -> { أرجع اختيار.بعض(صواب); }
        | صنف_شكل_نوع_دلالي.سجل -> { أرجع اختيار.بعض(صواب); }
        | صنف_شكل_نوع_دلالي.تعداد -> { أرجع اختيار.بعض(صواب); }
        | صنف_شكل_نوع_دلالي.اختيار -> { أرجع اختيار.بعض(صواب); }
        | صنف_شكل_نوع_دلالي.نتيجة -> { أرجع اختيار.بعض(صواب); }
        | صنف_شكل_نوع_دلالي.متجه -> { أرجع اختيار.بعض(صواب); }
        | صنف_شكل_نوع_دلالي.شريحة -> { أرجع اختيار.بعض(صواب); }
        | _ -> { أرجع اختيار.بعض(خطأ); };
    };
}

عرف نوع_بدائي_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    البدائي: نوع_بدائي_مقنن
): اختيار مرجع_نوع_إل_إل_في_إم {
    طابق البدائي مع
    | نوع_بدائي_مقنن.فراغ -> { أرجع اختيار.بعض(نوع_فراغ_إل_إل_في_إم((*الحالة).السياق)); }
    | نوع_بدائي_مقنن.منطقي -> { أرجع اختيار.بعض(نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 1)); }
    | نوع_بدائي_مقنن.ع32 -> { أرجع اختيار.بعض(نوع_ع32_إل_إل_في_إم((*الحالة).السياق)); }
    | نوع_بدائي_مقنن.ع64 -> { أرجع اختيار.بعض(نوع_ع64_إل_إل_في_إم((*الحالة).السياق)); }
    | نوع_بدائي_مقنن.أي -> { أرجع اختيار.لا_شيء(); }
    | نوع_بدائي_مقنن.نص -> { أرجع اختيار.لا_شيء(); }
    | _ -> {
        دع البتات: متغير غير_موقع = بتات_نوع_بدائي(البدائي);
        لو (البدائي == نوع_بدائي_مقنن.عدد() || البدائي == نوع_بدائي_مقنن.غير_موقع()) {
            البتات := (*الهدف).نموذج_البيانات.عرض_المؤشر;
        };
        لو (البتات == 0) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, البتات مثل غ32));
    };
}

عام عرف حل_نوع_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة_نوع_إل_إل_في_إم {
    ضمن_فهرس_نوع_إل_إل_في_إم(الحالة, النوع);
    طابق (*الحالة).الأنواع[النوع.القيمة] مع
    | اختيار.بعض(الموجود) -> { أرجع نتيجة_نوع_إل_إل_في_إم.نجح(الموجود); }
    | اختيار.لا_شيء -> { };

    دع الوصف: وصف_شكل_نوع_دلالي;
    طابق وصف_شكل_نوع_دلالي_عند(&(*الحقائق).الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_نوع_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.نوع_مفقود(النوع)); }
    | اختيار.بعض(ق) -> { الوصف := ق; };

    دع حارس_مرجع: متغير غ8 = 0;
    دع المرجع: متغير مرجع_نوع_إل_إل_في_إم = &متغير حارس_مرجع;
    دع تجميعي: متغير منطقي = خطأ;
    طابق الوصف.الصنف مع
    | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
        طابق نوع_بدائي_إل_إل_في_إم(الحالة, الهدف, البدائي) مع
        | اختيار.بعض(ن) -> { المرجع := ن; }
        | اختيار.لا_شيء -> {
            لو (البدائي == نوع_بدائي_مقنن.نص()) { تجميعي := صواب; }
            وإلا { أرجع نتيجة_نوع_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
        };
    }
    | صنف_شكل_نوع_دلالي.مؤشر -> { المرجع := نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق); }
    | صنف_شكل_نوع_دلالي.مرجع -> { المرجع := نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق); }
    | صنف_شكل_نوع_دلالي.صندوق -> { المرجع := نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق); }
    | صنف_شكل_نوع_دلالي.دالة -> { المرجع := نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق); }
    | صنف_شكل_نوع_دلالي.معامل_نوع -> { أرجع
        نتيجة_نوع_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); }
    | _ -> { تجميعي := صواب; };

    لو (تجميعي) {
        طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_تخطيط.مكتمل(التخطيط) -> {
            دع بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
            المرجع := نوع_مصفوفة_إل_إل_في_إم(بايت, التخطيط.الحجم مثل غ64);
        }
        | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة_نوع_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(النوع)); }
        | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة_نوع_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(النوع)); };
    };
    دع القيد: قيد_نوع_إل_إل_في_إم = { النوع: النوع, التمثيل: المرجع, تجميعي: تجميعي };
    (*الحالة).الأنواع[النوع.القيمة] := اختيار.بعض(القيد);
    أرجع نتيجة_نوع_إل_إل_في_إم.نجح(القيد);
}
