استورد compiler.backend.provider.llvm.ffi.types;

// Exact exported target-registration and triple symbols.
// Higher-level target policy belongs to SultanC Target, not this FFI layer.

عام خارجي عرف LLVMInitializeX86TargetInfo(): فراغ;
عام خارجي عرف LLVMInitializeX86Target(): فراغ;
عام خارجي عرف LLVMInitializeX86TargetMC(): فراغ;
عام خارجي عرف LLVMInitializeX86AsmPrinter(): فراغ;

عام خارجي عرف LLVMInitializeAArch64TargetInfo(): فراغ;
عام خارجي عرف LLVMInitializeAArch64Target(): فراغ;
عام خارجي عرف LLVMInitializeAArch64TargetMC(): فراغ;
عام خارجي عرف LLVMInitializeAArch64AsmPrinter(): فراغ;

عام خارجي عرف LLVMInitializeARMTargetInfo(): فراغ;
عام خارجي عرف LLVMInitializeARMTarget(): فراغ;
عام خارجي عرف LLVMInitializeARMTargetMC(): فراغ;
عام خارجي عرف LLVMInitializeARMAsmPrinter(): فراغ;

