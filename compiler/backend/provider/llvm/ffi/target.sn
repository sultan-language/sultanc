    LLVMNormalizeTargetTriple(الثلاثي); }
عام عرف ابحث_هدف_إل_إل_في_إم(الثلاثي: مؤشر_محرف_ثابت_إل_إل_في_إم, الهدف: *متغير مرجع_هدف_إل_إل_في_إم, الرسالة:
    *متغير مؤشر_محرف_متغير_إل_إل_في_إم): منطق_إل_إل_في_إم { أرجع LLVMGetTargetFromTriple(الثلاثي, الهدف,
    الرسالة); }
