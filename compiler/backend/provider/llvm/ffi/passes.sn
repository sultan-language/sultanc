استورد compiler.backend.provider.llvm.ffi.types;

// New-pass-manager and verifier bindings only. Pipeline policy belongs above FFI.

عام خارجي عرف LLVMCreatePassBuilderOptions(): مرجع_خيارات_باني_تمريرات_إل_إل_في_إم;
عام خارجي عرف LLVMDisposePassBuilderOptions(
    الخيارات: مرجع_خيارات_باني_تمريرات_إل_إل_في_إم
): فراغ;
