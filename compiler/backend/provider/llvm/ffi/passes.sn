): فراغ;
عام خارجي عرف LLVMPassBuilderOptionsSetSLPVectorization(
    الخيارات: مرجع_خيارات_باني_تمريرات_إل_إل_في_إم,
    التفعيل: منطق_إل_إل_في_إم
): فراغ;
عام خارجي عرف LLVMPassBuilderOptionsSetLoopUnrolling(
    الخيارات: مرجع_خيارات_باني_تمريرات_إل_إل_في_إم,
    التفعيل: منطق_إل_إل_في_إم
): فراغ;
عام خارجي عرف LLVMRunPasses(
    الوحدة: مرجع_وحدة_إل_إل_في_إم,
    التمريرات: مؤشر_محرف_ثابت_إل_إل_في_إم,
    الآلة: مرجع_آلة_هدف_إل_إل_في_إم,
    الخيارات: مرجع_خيارات_باني_تمريرات_إل_إل_في_إم
): مرجع_خطأ_إل_إل_في_إم;
عام خارجي عرف LLVMRunPassesOnFunction(
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    التمريرات: مؤشر_محرف_ثابت_إل_إل_في_إم,
    الآلة: مرجع_آلة_هدف_إل_إل_في_إم,
    الخيارات: مرجع_خيارات_باني_تمريرات_إل_إل_في_إم
): مرجع_خطأ_إل_إل_في_إم;

عام خارجي عرف LLVMVerifyModule(
    الوحدة: مرجع_وحدة_إل_إل_في_إم,
    الفعل: فعل_فشل_تحقق_إل_إل_في_إم,
    الرسالة: *متغير مؤشر_محرف_متغير_إل_إل_في_إم
): منطق_إل_إل_في_إم;
عام خارجي عرف LLVMVerifyFunction(
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    الفعل: فعل_فشل_تحقق_إل_إل_في_إم
): منطق_إل_إل_في_إم;

عام خارجي عرف LLVMGetErrorMessage(
    الخطأ: مرجع_خطأ_إل_إل_في_إم
): مؤشر_محرف_متغير_إل_إل_في_إم;
عام خارجي عرف LLVMDisposeErrorMessage(
    الرسالة: مؤشر_محرف_متغير_إل_إل_في_إم
): فراغ;
عام خارجي عرف LLVMConsumeError(
    الخطأ: مرجع_خطأ_إل_إل_في_إم
): فراغ;

عام عرف تحقق_وحدة_إل_إل_في_إم(و: مرجع_وحدة_إل_إل_في_إم, ر: *متغير مؤشر_محرف_متغير_إل_إل_في_إم): منطق_إل_إل_في_إم { أرجع LLVMVerifyModule(و, 2, ر); }
عام عرف شغل_تمريرات_إل_إل_في_إم(و: مرجع_وحدة_إل_إل_في_إم, ت: مؤشر_محرف_ثابت_إل_إل_في_إم, آ: مرجع_آلة_هدف_إل_إل_في_إم): مرجع_خطأ_إل_إل_في_إم {
    دع خ: مرجع_خيارات_باني_تمريرات_إل_إل_في_إم = LLVMCreatePassBuilderOptions();
    LLVMPassBuilderOptionsSetVerifyEach(خ, 1);
    دع ر: مرجع_خطأ_إل_إل_في_إم = LLVMRunPasses(و, ت, آ, خ);
    LLVMDisposePassBuilderOptions(خ);
    أرجع ر;
}
عام عرف رسالة_خطأ_إل_إل_في_إم(خ: مرجع_خطأ_إل_إل_في_إم): مؤشر_محرف_متغير_إل_إل_في_إم { أرجع LLVMGetErrorMessage(خ); }
عام عرف حرر_رسالة_خطأ_إل_إل_في_إم(ر: مؤشر_محرف_متغير_إل_إل_في_إم): فراغ { LLVMDisposeErrorMessage(ر); }
