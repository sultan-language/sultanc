    الخيارات: مرجع_خيارات_باني_تمريرات_إل_إل_في_إم,
    التحقق: منطق_إل_إل_في_إم
): فراغ;
عام خارجي عرف LLVMPassBuilderOptionsSetDebugLogging(
    الخيارات: مرجع_خيارات_باني_تمريرات_إل_إل_في_إم,
