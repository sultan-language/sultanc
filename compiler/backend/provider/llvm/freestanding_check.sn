// Operations a Cortex-M target cannot do without a run-time routine SultanC
// does not provide (soft-float __aeabi_* routines, __atomic_*/__sync_*
// library atomics), reported as SULTANC-TARGET-FEATURE-UNSUPPORTED at the
// source: the MSIR instruction's origin and its function's source name
// (the MSIR debug contract). The facts of the target are in target_model.sn
// (عرض_عائم_بالعتاد_للهدف, عرض_الذريات_للهدف).

// The diagnostic span of a source origin, through the map's generated-text
// redirections; none when the origin or its source is unknown.
عرف نطاق_أصل_تشخيص_إل_إل_في_إم(
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    الأصل: معرف_أصل_مصدر
): اختياري نطاق_مصدر_تشخيص {
    طابق أصل_مصدر_بالمعرف(الأصول, الأصل) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الوصف) -> {
        دع النطاق: نطاق = نطاق_الإبلاغ(المصادر, الوصف.النطاق);
        دع المقتطف: اختياري نص = مقتطف_من_الخريطة(المصادر, &النطاق);
        أرجع نطاق_مصدر_تشخيص_من_خريطة(النطاق, المصادر, النطاق.البداية.المصدر, المقتطف);
    };
}

// The source function of an MSIR function: its debug-contract record.
عرف دالة_تصحيح_مصدرية_إل_إل_في_إم(
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): اختياري طبيعي {
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, الدالة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> {
        إذا (المعرف.القيمة >= (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(المعرف.القيمة);
    };
}

// The failure for an operation found in MSIR function الدالة, at origin
// الأصل when the instruction has one, else at the function's own origin.
عام عرف فشل_روتين_تشغيل_إل_إل_في_إم(
    الهدف: &واصف_هدف,
    العملية: متجه ط8,
    النوع: متجه ط8,
    التصحيح: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    الدالة: اختياري معرف_دالة_مسير,
    الأصل: اختياري معرف_أصل_مصدر
): فشل_مزود_إل_إل_في_إم {
    دع الاسم: متغير متجه ط8 = [];
    دع الموقع: متغير اختياري نطاق_مصدر_تشخيص = اختياري.لا_شيء();
    طابق الأصل مع
    | اختياري.موجود(أ) -> { الموقع := نطاق_أصل_تشخيص_إل_إل_في_إم(المصادر, الأصول, أ); }
    | اختياري.لا_شيء -> { };
    طابق الدالة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(معرف_الدالة) -> {
        طابق دالة_تصحيح_مصدرية_إل_إل_في_إم(التصحيح, معرف_الدالة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الموضع) -> {
            دع د: &دالة_تصحيح = &(*التصحيح).الدلالي.الدوال[الموضع];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*د).الاسم) مثل طبيعي)) { ألحق(الاسم, (*د).الاسم[ف]); ف := ف + 1; }
            طابق الموقع مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> { الموقع := نطاق_أصل_تشخيص_إل_إل_في_إم(المصادر, الأصول, (*د).الأصل); };
        };
    };
    دع الحقائق: روتين_تشغيل_غير_متاح_إل_إل_في_إم = {
        الهدف: (*الهدف).المعرف,
        العملية: العملية,
        النوع: النوع,
        الدالة: الاسم,
        الموقع: الموقع
    };
    أرجع فشل_مزود_إل_إل_في_إم.روتين_تشغيل_غير_متاح(الحقائق);
}

عرف بتات_عائم_قيمة_مسير_إل_إل_في_إم(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): طبيعي {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع 0; }
    | اختياري.موجود(النوع) -> {
        طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, النوع) مع
        | اختياري.موجود(البتات) -> { أرجع البتات; }
        | اختياري.لا_شيء -> { أرجع 0; };
    };
}

عرف بتات_عدد_قيمة_مسير_إل_إل_في_إم(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    القيمة: معرف_قيمة_مسير
): طبيعي {
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع 0; }
    | اختياري.موجود(النوع) -> {
        طابق بتات_عدد_للاختيار(&(*الحقائق).الأنواع, النوع) مع
        | اختياري.موجود(البتات) -> { أرجع البتات; }
        | اختياري.لا_شيء -> { أرجع 0; };
    };
}

// The operation of an MSIR instruction that would need a run-time routine on
// the target, with its type; none for every other instruction.
عام نوع عملية_مسير_بلا_روتين_إل_إل_في_إم = {
    العملية: متجه ط8,
    النوع: متجه ط8
};

عرف عملية_بلا_روتين_إل_إل_في_إم(العملية: نص, البادئة: ط8, العرض: طبيعي): اختياري عملية_مسير_بلا_روتين_إل_إل_في_إم {
    دع الناتج: عملية_مسير_بلا_روتين_إل_إل_في_إم = {
        العملية: بايتات_من_نص(العملية),
        النوع: نص_عرض_نوع_إل_إل_في_إم(البادئة, العرض)
    };
    أرجع اختياري.موجود(الناتج);
}

عرف فحص_تعليمة_مسير_إل_إل_في_إم(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    التعليمة: &عرض_تعليمة_مسير,
    حد_العائم: طبيعي,
    حد_التعديل: طبيعي
): اختياري عملية_مسير_بلا_روتين_إل_إل_في_إم {
    دع ف_ب: ط8 = 0x66 مثل ط8;
    دع ص_ب: ط8 = 0x69 مثل ط8;
    دع عرض_الناتج: متغير طبيعي = 0;
    طابق (*التعليمة).الناتج مع
    | اختياري.موجود(ن) -> { عرض_الناتج := بتات_عائم_قيمة_مسير_إل_إل_في_إم(المسير, الحقائق, ن); }
    | اختياري.لا_شيء -> { };
    طابق (*التعليمة).العملية مع
    | عملية_مسير.حساب_عشري(الحساب) -> {
        إذا (عرض_الناتج <= حد_العائم) { أرجع اختياري.لا_شيء(); };
        طابق الحساب.العملية مع
        | عملية_حساب_عشري.جمع -> { أرجع عملية_بلا_روتين_إل_إل_في_إم(«fadd», ف_ب, عرض_الناتج); }
        | عملية_حساب_عشري.طرح -> { أرجع عملية_بلا_روتين_إل_إل_في_إم(«fsub», ف_ب, عرض_الناتج); }
        | عملية_حساب_عشري.ضرب -> { أرجع عملية_بلا_روتين_إل_إل_في_إم(«fmul», ف_ب, عرض_الناتج); }
        | عملية_حساب_عشري.قسمة -> { أرجع عملية_بلا_روتين_إل_إل_في_إم(«fdiv», ف_ب, عرض_الناتج); };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        دع العرض: طبيعي = بتات_عائم_قيمة_مسير_إل_إل_في_إم(المسير, الحقائق, المقارنة.اليسار);
        إذا (العرض <= حد_العائم) { أرجع اختياري.لا_شيء(); };
        أرجع عملية_بلا_روتين_إل_إل_في_إم(«fcmp», ف_ب, العرض);
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        دع عرض_المصدر: طبيعي = بتات_عائم_قيمة_مسير_إل_إل_في_إم(المسير, الحقائق, التحويل.المصدر);
        دع العرض: متغير طبيعي = عرض_الناتج;
        إذا (عرض_المصدر > العرض) { العرض := عرض_المصدر; };
        إذا (العرض <= حد_العائم) { أرجع اختياري.لا_شيء(); };
        طابق التحويل.العملية مع
        | عملية_تحويل_عائم.عائم_إلى_موقع -> { أرجع عملية_بلا_روتين_إل_إل_في_إم(«fptosi», ف_ب, العرض); }
        | عملية_تحويل_عائم.عائم_إلى_طبيعي -> { أرجع عملية_بلا_روتين_إل_إل_في_إم(«fptoui», ف_ب, العرض); }
        | عملية_تحويل_عائم.موقع_إلى_عائم -> { أرجع عملية_بلا_روتين_إل_إل_في_إم(«sitofp», ف_ب, العرض); }
        | عملية_تحويل_عائم.طبيعي_إلى_عائم -> { أرجع عملية_بلا_روتين_إل_إل_في_إم(«uitofp», ف_ب, العرض); }
        | عملية_تحويل_عائم.عائم_إلى_عائم -> {
            إذا (عرض_الناتج > عرض_المصدر) { أرجع عملية_بلا_روتين_إل_إل_في_إم(«fpext», ف_ب, العرض); };
            أرجع عملية_بلا_روتين_إل_إل_في_إم(«fptrunc», ف_ب, العرض);
        };
    }
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
            طابق البدائي مع
            | هوية_بدائي_مترجم.عملية_عائمة(العملية) -> {
                // Absolute value and copysign are sign-bit operations.
                إذا (العملية == عملية_عائمة_بدائية.قيمة_مطلقة() || العملية == عملية_عائمة_بدائية.نسخ_إشارة()) {
                    أرجع اختياري.لا_شيء();
                };
                إذا (عرض_الناتج <= حد_العائم) { أرجع اختياري.لا_شيء(); };
                أرجع عملية_بلا_روتين_إل_إل_في_إم(«float intrinsic», ف_ب, عرض_الناتج);
            }
            | هوية_بدائي_مترجم.ذري_حمل -> {
                طابق (*التعليمة).الناتج مع
                | اختياري.موجود(ن) -> {
                    دع العرض: طبيعي = بتات_عدد_قيمة_مسير_إل_إل_في_إم(المسير, الحقائق, ن);
                    إذا (العرض > 32) { أرجع عملية_بلا_روتين_إل_إل_في_إم(«atomic load», ص_ب, العرض); };
                }
                | اختياري.لا_شيء -> { };
                أرجع اختياري.لا_شيء();
            }
            | _ -> { };
            دع عملية_ذرية: متغير نص = «»;
            دع حد_الذرية: متغير طبيعي = حد_التعديل;
            طابق البدائي مع
            | هوية_بدائي_مترجم.ذري_خزن -> { عملية_ذرية := «atomic store»; حد_الذرية := 32; }
            | هوية_بدائي_مترجم.ذري_تبديل -> { عملية_ذرية := «atomicrmw»; }
            | هوية_بدائي_مترجم.ذري_جلب_جمع -> { عملية_ذرية := «atomicrmw»; }
            | هوية_بدائي_مترجم.ذري_جلب_و -> { عملية_ذرية := «atomicrmw»; }
            | هوية_بدائي_مترجم.ذري_جلب_أو -> { عملية_ذرية := «atomicrmw»; }
            | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { عملية_ذرية := «atomicrmw»; }
            | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { عملية_ذرية := «cmpxchg»; }
            | _ -> { أرجع اختياري.لا_شيء(); };
            إذا ((الطول(النداء.الحجج) مثل طبيعي) < 2) { أرجع اختياري.لا_شيء(); };
            دع العرض: طبيعي = بتات_عدد_قيمة_مسير_إل_إل_في_إم(المسير, الحقائق, النداء.الحجج[1]);
            إذا (العرض > حد_الذرية) { أرجع عملية_بلا_روتين_إل_إل_في_إم(عملية_ذرية, ص_ب, العرض); };
            أرجع اختياري.لا_شيء();
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Every required MSIR function of a Cortex-M program, before lowering: the
// first instruction that would need a run-time routine fails the build at
// its source location. Nothing is checked on other targets.
عام عرف افحص_عمليات_بلا_روتين_مسير_إل_إل_في_إم(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    التصحيح: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    المطلوبة: &متجه منطقي
): اختياري فشل_مزود_إل_إل_في_إم {
    دع حد_العائم: طبيعي;
    طابق عرض_عائم_بالعتاد_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(العرض) -> { حد_العائم := العرض; };
    دع حد_التعديل: طبيعي = عرض_الذريات_للهدف(الهدف);
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(معرف_الدالة) -> {
            إذا (دالة_إل_إل_في_إم_مطلوبة(المطلوبة, معرف_الدالة)) {
                دع عدد_الكتل: متغير طبيعي = 0;
                طابق ابحث_دالة_مسير(المسير, معرف_الدالة) مع
                | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> { عدد_الكتل := العرض.عدد_الكتل; }
                | _ -> { };
                دع ك: متغير طبيعي = 0;
                طالما (ك < عدد_الكتل) {
                    طابق معرف_كتلة_مسير_عند(المسير, معرف_الدالة, ك) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(معرف_الكتلة) -> {
                        دع عدد_التعليمات: متغير طبيعي = 0;
                        طابق ابحث_كتلة_مسير(المسير, معرف_الكتلة) مع
                        | نتيجة_بحث_كتلة_مسير.موجودة(عرض_الكتلة) -> { عدد_التعليمات := عرض_الكتلة.عدد_التعليمات; }
                        | _ -> { };
                        دع ت: متغير طبيعي = 0;
                        طالما (ت < عدد_التعليمات) {
                            طابق تعليمة_مسير_عند(المسير, معرف_الكتلة, ت) مع
                            | اختياري.لا_شيء -> { }
                            | اختياري.موجود(التعليمة) -> {
                                طابق فحص_تعليمة_مسير_إل_إل_في_إم(المسير, الحقائق, &التعليمة, حد_العائم, حد_التعديل) مع
                                | اختياري.لا_شيء -> { }
                                | اختياري.موجود(الموجود) -> {
                                    أرجع اختياري.موجود(فشل_روتين_تشغيل_إل_إل_في_إم(
                                        الهدف, انسخ_بايتات_إل_إل_في_إم(&الموجود.العملية), انسخ_بايتات_إل_إل_في_إم(&الموجود.النوع), التصحيح, المصادر, الأصول,
                                        اختياري.موجود(معرف_الدالة), التعليمة.الأصل));
                                };
                            };
                            ت := ت + 1;
                        }
                    };
                    ك := ك + 1;
                }
            };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The LLVM-module pass of freestanding_routines.sn, with what it finds
// reported at its MSIR function (found through the provider's function
// records) and that function's source origin.
عام عرف اخفض_روتينات_التشغيل_بمواقع_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    التصحيح: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق اخفض_روتينات_التشغيل_الحرة_إل_إل_في_إم(الحالة, الهدف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموجود) -> {
        دع معرف_المسير: متغير اختياري معرف_دالة_مسير = اختياري.لا_شيء();
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الحالة).الدوال) مثل طبيعي)) {
            طابق (*الحالة).الدوال[ف] مع
            | اختياري.موجود(القيد) -> {
                إذا (القيد.الدالة == الموجود.الدالة) {
                    دع المعرف: معرف_دالة_مسير = معرف_دالة_مسير_من(ف);
                    معرف_المسير := اختياري.موجود(المعرف);
                };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.موجود(فشل_روتين_تشغيل_إل_إل_في_إم(
            الهدف, انسخ_بايتات_إل_إل_في_إم(&الموجود.العملية), انسخ_بايتات_إل_إل_في_إم(&الموجود.النوع), التصحيح, المصادر, الأصول,
            معرف_المسير, اختياري.لا_شيء()));
    };
}
