استورد compiler.backend.provider.llvm.ffi.types;

عام عرف انسخ_بايتات_إل_إل_في_إم(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف اجعل_اسما_سي_لإل_إل_في_إم(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = انسخ_بايتات_إل_إل_في_إم(المصدر);
    ألحق(الناتج, 0);
    أرجع الناتج;
}

عام عرف مؤشر_اسم_سي_لإل_إل_في_إم(الاسم: &متغير متجه غ8): مؤشر_محرف_ثابت_إل_إل_في_إم {
    لو ((الطول(*الاسم) مثل غير_موقع) == 0) { ألحق(*الاسم, 0); };
    أرجع &متغير (*الاسم)[0];
}

عام عرف انسخ_رسالة_سي_لإل_إل_في_إم(المصدر: مؤشر_محرف_متغير_إل_إل_في_إم): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    غير_آمن {
        بينما (المصدر[ف] != 0) {
            ألحق(الناتج, المصدر[ف]);
            ف := ف + 1;
        }
    }
    أرجع الناتج;
}

عرف رقم_سداسي_إل_إل_في_إم(القيمة: غير_موقع): غ8 {
    لو (القيمة < 10) { أرجع (0x30 + القيمة) مثل غ8; };
    أرجع (0x61 + (القيمة - 10)) مثل غ8;
}

عرف ألحق_معرف_سداسي_إل_إل_في_إم(الناتج: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 16) {
        دع موضع: غير_موقع = 15 - ف;
        دع إزاحة: غير_موقع = موضع * 4;
        دع المزاح: غير_موقع = القيمة >> إزاحة;
        دع الرقم: غير_موقع = المزاح & 0xF;
        ألحق(*الناتج, رقم_سداسي_إل_إل_في_إم(الرقم));
        ف := ف + 1;
    }
}

عام عرف اسم_دالة_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = [
        0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x66,0x6E,0x5F
    ];
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_عام_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = [
        0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x67,0x6C,0x6F,0x62,0x61,0x6C,0x5F
    ];
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_كتلة_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = [0x62,0x62,0x5F];
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_نص_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x73,0x74,0x72,0x5F];
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_نص_عام_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = [0x73,0x75,0x6C,0x74,0x61,0x6E,0x63,0x5F,0x67,0x73,0x74,0x72,0x5F];
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}
