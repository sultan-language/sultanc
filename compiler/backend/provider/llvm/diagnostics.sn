استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.provider.llvm.ffi.core;
استورد std.text.from_bytes;

عام عرف انسخ_بايتات_إل_إل_في_إم(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف اجعل_اسما_سي_لإل_إل_في_إم(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = انسخ_بايتات_إل_إل_في_إم(المصدر);
    ألحق(الناتج, 0);
    أرجع الناتج;
}

عام عرف مؤشر_اسم_سي_لإل_إل_في_إم(الاسم: &متغير متجه غ8): مؤشر_محرف_ثابت_إل_إل_في_إم {
    لو ((الطول(*الاسم) مثل غير_موقع) == 0) { ألحق(*الاسم, 0); };
    أرجع &متغير (*الاسم)[0];
}

// LLVM may silently suffix a colliding global or function name. Imported
// linker symbols must retain the exact identity recorded in verified MSIR.
عام عرف يطابق_اسم_قيمة_إل_إل_في_إم(
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    الاسم: &متجه غ8
): منطقي {
    دع عدد_البايتات: متغير حجم_إل_إل_في_إم = 0;
    دع البايتات: مؤشر_محرف_ثابت_إل_إل_في_إم = LLVMGetValueName2(القيمة, &متغير عدد_البايتات);
    لو (عدد_البايتات != (الطول(*الاسم) مثل غير_موقع)) { أرجع خطأ; };
    دع الفهرس: متغير غير_موقع = 0;
    غير_آمن {
        بينما (الفهرس < عدد_البايتات) {
            لو (البايتات[الفهرس] != (*الاسم)[الفهرس]) { أرجع خطأ; };
            الفهرس := الفهرس + 1;
        }
    }
    أرجع صواب;
}

عام عرف انسخ_رسالة_سي_لإل_إل_في_إم(المصدر: مؤشر_محرف_متغير_إل_إل_في_إم): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    غير_آمن {
        بينما (المصدر[ف] != 0) {
            ألحق(الناتج, المصدر[ف]);
            ف := ف + 1;
        }
    }
    أرجع الناتج;
}

عرف رقم_سداسي_إل_إل_في_إم(القيمة: غير_موقع): غ8 {
    لو (القيمة < 10) { أرجع (0x30 + القيمة) مثل غ8; };
    أرجع (0x61 + (القيمة - 10)) مثل غ8;
}

عام عرف ألحق_معرف_سداسي_إل_إل_في_إم(الناتج: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 16) {
        دع موضع: غير_موقع = 15 - ف;
        دع إزاحة: غير_موقع = موضع * 4;
        دع المزاح: غير_موقع = القيمة >> إزاحة;
        دع الرقم: غير_موقع = المزاح & 0xF;
        ألحق(*الناتج, رقم_سداسي_إل_إل_في_إم(الرقم));
        ف := ف + 1;
    }
}

عام عرف اسم_دالة_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بايتات_من_نص(«sultanc_fn_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_عام_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بايتات_من_نص(«sultanc_global_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_كتلة_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بايتات_من_نص(«bb_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_نص_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بايتات_من_نص(«sultanc_str_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_نص_عام_إل_إل_في_إم(القيمة: غير_موقع): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بايتات_من_نص(«sultanc_gstr_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}
