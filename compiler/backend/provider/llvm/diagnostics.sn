استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.provider.llvm.ffi.core;
استورد std.text.from_bytes;

عام عرف انسخ_بايتات_إل_إل_في_إم(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف اجعل_اسما_سي_لإل_إل_في_إم(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = انسخ_بايتات_إل_إل_في_إم(المصدر);
    ألحق(الناتج, 0);
    أرجع الناتج;
}

عام عرف مؤشر_اسم_سي_لإل_إل_في_إم(الاسم: &متغير متجه ط8): مؤشر_محرف_ثابت_إل_إل_في_إم {
    إذا ((الطول(*الاسم) مثل طبيعي) == 0) { ألحق(*الاسم, 0); };
    أرجع &متغير (*الاسم)[0];
}

// LLVM may silently suffix a colliding global or function name. Imported
// linker symbols must retain the exact identity recorded in verified MSIR.
عام عرف يطابق_اسم_قيمة_إل_إل_في_إم(
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    الاسم: &متجه ط8
): منطقي {
    دع عدد_البايتات: متغير حجم_إل_إل_في_إم = 0;
    دع البايتات: مؤشر_محرف_ثابت_إل_إل_في_إم = LLVMGetValueName2(القيمة, &متغير عدد_البايتات);
    إذا (عدد_البايتات != (الطول(*الاسم) مثل طبيعي)) { أرجع خطأ; };
    دع الفهرس: متغير طبيعي = 0;
    غير_آمن {
        طالما (الفهرس < عدد_البايتات) {
            إذا (البايتات[الفهرس] != (*الاسم)[الفهرس]) { أرجع خطأ; };
            الفهرس := الفهرس + 1;
        }
    }
    أرجع صواب;
}

عام عرف انسخ_رسالة_سي_لإل_إل_في_إم(المصدر: مؤشر_محرف_متغير_إل_إل_في_إم): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    غير_آمن {
        طالما (المصدر[ف] != 0) {
            ألحق(الناتج, المصدر[ف]);
            ف := ف + 1;
        }
    }
    أرجع الناتج;
}

عرف رقم_سداسي_إل_إل_في_إم(القيمة: طبيعي): ط8 {
    إذا (القيمة < 10) { أرجع (0x30 + القيمة) مثل ط8; };
    أرجع (0x61 + (القيمة - 10)) مثل ط8;
}

عام عرف ألحق_معرف_سداسي_إل_إل_في_إم(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < 16) {
        دع موضع: طبيعي = 15 - ف;
        دع إزاحة: طبيعي = موضع * 4;
        دع المزاح: طبيعي = القيمة >> إزاحة;
        دع الرقم: طبيعي = المزاح & 0xF;
        ألحق(*الناتج, رقم_سداسي_إل_إل_في_إم(الرقم));
        ف := ف + 1;
    }
}

عام عرف اسم_دالة_إل_إل_في_إم(القيمة: طبيعي): متجه ط8 {
    دع الاسم: متغير متجه ط8 = بايتات_من_نص(«sultanc_fn_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_عام_إل_إل_في_إم(القيمة: طبيعي): متجه ط8 {
    دع الاسم: متغير متجه ط8 = بايتات_من_نص(«sultanc_global_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_كتلة_إل_إل_في_إم(القيمة: طبيعي): متجه ط8 {
    دع الاسم: متغير متجه ط8 = بايتات_من_نص(«bb_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_نص_إل_إل_في_إم(القيمة: طبيعي): متجه ط8 {
    دع الاسم: متغير متجه ط8 = بايتات_من_نص(«sultanc_str_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}

عام عرف اسم_نص_عام_إل_إل_في_إم(القيمة: طبيعي): متجه ط8 {
    دع الاسم: متغير متجه ط8 = بايتات_من_نص(«sultanc_gstr_»);
    ألحق_معرف_سداسي_إل_إل_في_إم(&متغير الاسم, القيمة);
    أرجع الاسم;
}
