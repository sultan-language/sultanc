استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;

// Conversions between floats and 64-bit integers on targets whose registers
// are narrower (i386, ARM, the 32- and 16-bit embedded targets). LLVM
// legalizes them there into compiler-rt calls (__aeabi_d2lz, __fixdfdi,
// __floatdidf, ...), which no SultanC link provides, so, as for 64-bit
// division (wide_division.sn), the provider builds them from 32-bit
// conversions, which those targets have, and exact float steps:
// - i64/u64 -> f64: hi * 2^32 + lo, both terms exact, one rounding (the add);
// - i64/u64 -> f32: the magnitude, cut to 53 bits with the lost bits kept as
//   a sticky bit (so the single f64 -> f32 rounding is correct), scaled back;
// - f32/f64 -> i64/u64: the magnitude split at 2^32 into two u32
//   conversions (the subtraction is exact), then Rust's saturation.
// Every comparison and select is branch-free; no out-of-range value ever
// reaches a 32-bit conversion.

عرف ثابت_ع64_ببتات_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم, البتات: ط64): مرجع_قيمة_إل_إل_في_إم {
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    دع ف: متغير متجه ط8 = [0];
    دع الخام: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(LLVMInt64TypeInContext(السياق), البتات, 0);
    أرجع LLVMBuildBitCast((*الحالة).الباني, الخام, LLVMDoubleTypeInContext(السياق), &متغير ف[0]);
}

// An unsigned or signed 64-bit integer as the nearest f64.
عرف صحيح64_إلى_ع64_برمجي_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    موقع: منطقي
): مرجع_قيمة_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    دع ف: متغير متجه ط8 = [0];
    دع نوع_ص64: مرجع_نوع_إل_إل_في_إم = LLVMInt64TypeInContext(السياق);
    دع نوع_ص32: مرجع_نوع_إل_إل_في_إم = LLVMInt32TypeInContext(السياق);
    دع نوع_ع64: مرجع_نوع_إل_إل_في_إم = LLVMDoubleTypeInContext(السياق);
    دع اثنان_وثلاثون: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 32, 0);
    دع العالي: متغير مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, القيمة, اثنان_وثلاثون, &متغير ف[0]);
    لو (موقع) { العالي := LLVMBuildAShr(الباني, القيمة, اثنان_وثلاثون, &متغير ف[0]); };
    دع العالي32: مرجع_قيمة_إل_إل_في_إم = LLVMBuildTrunc(الباني, العالي, نوع_ص32, &متغير ف[0]);
    دع المنخفض32: مرجع_قيمة_إل_إل_في_إم = LLVMBuildTrunc(الباني, القيمة, نوع_ص32, &متغير ف[0]);
    دع عالي_عائم: متغير مرجع_قيمة_إل_إل_في_إم = LLVMBuildUIToFP(الباني, العالي32, نوع_ع64, &متغير ف[0]);
    لو (موقع) { عالي_عائم := LLVMBuildSIToFP(الباني, العالي32, نوع_ع64, &متغير ف[0]); };
    دع منخفض_عائم: مرجع_قيمة_إل_إل_في_إم = LLVMBuildUIToFP(الباني, المنخفض32, نوع_ع64, &متغير ف[0]);
    // 2^32 = 0x41F0000000000000
    دع قوة32: مرجع_قيمة_إل_إل_في_إم = ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 4751297606875873280);
    دع المضروب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFMul(الباني, عالي_عائم, قوة32, &متغير ف[0]);
    أرجع LLVMBuildFAdd(الباني, المضروب, منخفض_عائم, &متغير ف[0]);
}

// i64/u64 -> f64 or f32 (round to nearest, ties to even).
عام عرف صحيح64_إلى_عائم_برمجي_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    موقع: منطقي,
    نوع_الهدف: مرجع_نوع_إل_إل_في_إم,
    بتات_الهدف: طبيعي
): مرجع_قيمة_إل_إل_في_إم {
    لو (بتات_الهدف == 64) { أرجع صحيح64_إلى_ع64_برمجي_إل_إل_في_إم(الحالة, القيمة, موقع); };
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    دع ف: متغير متجه ط8 = [0];
    دع نوع_ص64: مرجع_نوع_إل_إل_في_إم = LLVMInt64TypeInContext(السياق);
    دع صفر: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 0, 0);
    دع سالب: متغير مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(LLVMInt1TypeInContext(السياق), 0, 0);
    دع القدر: متغير مرجع_قيمة_إل_إل_في_إم = القيمة;
    لو (موقع) {
        سالب := LLVMBuildICmp(الباني, 40, القيمة, صفر, &متغير ف[0]);
        دع المعكوس: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, صفر, القيمة, &متغير ف[0]);
        القدر := LLVMBuildSelect(الباني, سالب, المعكوس, القيمة, &متغير ف[0]);
    };
    // |x| >= 2^53: keep bits 11.. and fold bits 0..10 into a sticky bit 0.
    دع حد53: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 9007199254740992, 0);
    دع كبير: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 35, القدر, حد53, &متغير ف[0]);
    دع قناع11: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 2047, 0);
    دع الضائع: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAnd(الباني, القدر, قناع11, &متغير ف[0]);
    دع ضائع_موجود: مرجع_قيمة_إل_إل_في_إم = LLVMBuildICmp(الباني, 33, الضائع, صفر, &متغير ف[0]);
    دع اللزج: مرجع_قيمة_إل_إل_في_إم = LLVMBuildZExt(الباني, ضائع_موجود, نوع_ص64, &متغير ف[0]);
    دع المزاح: مرجع_قيمة_إل_إل_في_إم = LLVMBuildLShr(الباني, القدر, LLVMConstInt(نوع_ص64, 11, 0), &متغير ف[0]);
    دع المقصوص: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني, المزاح, اللزج, &متغير ف[0]);
    دع المختار: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, كبير, المقصوص, القدر, &متغير ف[0]);
    دع المضاعف_عائم: مرجع_قيمة_إل_إل_في_إم = صحيح64_إلى_ع64_برمجي_إل_إل_في_إم(الحالة, المختار, خطأ);
    // 2048.0 = 0x40A0000000000000, 1.0 = 0x3FF0000000000000
    دع المقياس: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, كبير,
        ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 4656722014701092864),
        ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 4607182418800017408), &متغير ف[0]);
    دع المقيس: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFMul(الباني, المضاعف_عائم, المقياس, &متغير ف[0]);
    دع الضيق: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFPTrunc(الباني, المقيس, نوع_الهدف, &متغير ف[0]);
    لو (!موقع) { أرجع الضيق; };
    // -0.0f = 0x80000000
    دع صفر_سالب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildBitCast(الباني,
        LLVMConstInt(LLVMInt32TypeInContext(السياق), 2147483648, 0), نوع_الهدف, &متغير ف[0]);
    دع المنفي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFSub(الباني, صفر_سالب, الضيق, &متغير ف[0]);
    أرجع LLVMBuildSelect(الباني, سالب, المنفي, الضيق, &متغير ف[0]);
}

// f32/f64 -> i64/u64 with Rust's saturating semantics (NaN -> 0).
عام عرف عائم_إلى_صحيح64_برمجي_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المصدر: مرجع_قيمة_إل_إل_في_إم,
    بتات_المصدر: طبيعي,
    موقع: منطقي
): مرجع_قيمة_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    دع ف: متغير متجه ط8 = [0];
    دع نوع_ص64: مرجع_نوع_إل_إل_في_إم = LLVMInt64TypeInContext(السياق);
    دع نوع_ص32: مرجع_نوع_إل_إل_في_إم = LLVMInt32TypeInContext(السياق);
    دع نوع_ع64: مرجع_نوع_إل_إل_في_إم = LLVMDoubleTypeInContext(السياق);
    دع س: متغير مرجع_قيمة_إل_إل_في_إم = المصدر;
    لو (بتات_المصدر == 32) { س := LLVMBuildFPExt(الباني, المصدر, نوع_ع64, &متغير ف[0]); };
    دع صفر_عائم: مرجع_قيمة_إل_إل_في_إم = ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 0);
    دع صفر_سالب: مرجع_قيمة_إل_إل_في_إم = ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 9223372036854775808);
    // fcmp: 4 = olt, 3 = oge, 7 = ord
    دع مرتب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFCmp(الباني, 7, س, س, &متغير ف[0]);
    دع سالب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFCmp(الباني, 4, س, صفر_عائم, &متغير ف[0]);
    دع المعكوس: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFSub(الباني, صفر_سالب, س, &متغير ف[0]);
    دع القدر: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, سالب, المعكوس, س, &متغير ف[0]);
    // 2^64 = 0x43F0000000000000, 2^63 = 0x43E0000000000000, -2^63 = 0xC3E0000000000000
    دع قوة64: مرجع_قيمة_إل_إل_في_إم = ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 4895412794951729152);
    دع قوة63: مرجع_قيمة_إل_إل_في_إم = ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 4890909195324358656);
    دع سالب_قوة63: مرجع_قيمة_إل_إل_في_إم = ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 14114281232179134464);
    دع قدر_صغير: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFCmp(الباني, 4, القدر, قوة64, &متغير ف[0]);
    دع في_المدى: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAnd(الباني, مرتب, قدر_صغير, &متغير ف[0]);
    دع الآمن: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, في_المدى, القدر, صفر_عائم, &متغير ف[0]);
    // 2^-32 = 0x3DF0000000000000, 2^32 = 0x41F0000000000000
    دع عالي_عائم: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFMul(الباني, الآمن,
        ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 4463067230724161536), &متغير ف[0]);
    دع العالي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFPToUI(الباني, عالي_عائم, نوع_ص32, &متغير ف[0]);
    دع عالي_كامل: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFMul(الباني,
        LLVMBuildUIToFP(الباني, العالي, نوع_ع64, &متغير ف[0]),
        ثابت_ع64_ببتات_إل_إل_في_إم(الحالة, 4751297606875873280), &متغير ف[0]);
    دع منخفض_عائم: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFSub(الباني, الآمن, عالي_كامل, &متغير ف[0]);
    دع المنخفض: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFPToUI(الباني, منخفض_عائم, نوع_ص32, &متغير ف[0]);
    دع عالي64: مرجع_قيمة_إل_إل_في_إم = LLVMBuildShl(الباني,
        LLVMBuildZExt(الباني, العالي, نوع_ص64, &متغير ف[0]), LLVMConstInt(نوع_ص64, 32, 0), &متغير ف[0]);
    دع المقدار: مرجع_قيمة_إل_إل_في_إم = LLVMBuildOr(الباني, عالي64,
        LLVMBuildZExt(الباني, المنخفض, نوع_ص64, &متغير ف[0]), &متغير ف[0]);
    دع صفر: مرجع_قيمة_إل_إل_في_إم = LLVMConstInt(نوع_ص64, 0, 0);
    لو (!موقع) {
        دع أعلى: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFCmp(الباني, 3, س, قوة64, &متغير ف[0]);
        دع بلا_سالب: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, سالب, صفر, المقدار, &متغير ف[0]);
        دع مشبع: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, أعلى,
            LLVMConstInt(نوع_ص64, 18446744073709551615, 0), بلا_سالب, &متغير ف[0]);
        أرجع LLVMBuildSelect(الباني, مرتب, مشبع, صفر, &متغير ف[0]);
    };
    دع منفي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSub(الباني, صفر, المقدار, &متغير ف[0]);
    دع موقع_الناتج: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, سالب, منفي, المقدار, &متغير ف[0]);
    دع أعلى: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFCmp(الباني, 3, س, قوة63, &متغير ف[0]);
    دع أدنى: مرجع_قيمة_إل_إل_في_إم = LLVMBuildFCmp(الباني, 4, س, سالب_قوة63, &متغير ف[0]);
    دع بحد_أدنى: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, أدنى,
        LLVMConstInt(نوع_ص64, 9223372036854775808, 0), موقع_الناتج, &متغير ف[0]);
    دع مشبع: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSelect(الباني, أعلى,
        LLVMConstInt(نوع_ص64, 9223372036854775807, 0), بحد_أدنى, &متغير ف[0]);
    أرجع LLVMBuildSelect(الباني, مرتب, مشبع, صفر, &متغير ف[0]);
}
