استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.types;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.target.selection_query_context;
استورد compiler.backend.target.target_abi_resolution;
استورد compiler.backend.abi.abi_model;
استورد compiler.backend.target.target_model;
استورد compiler.msir.msir_consumer;

عام نوع وصف_توقيع_إل_إل_في_إم = {
    النوع: مرجع_نوع_إل_إل_في_إم,
    المعاملات: متجه مرجع_نوع_إل_إل_في_إم,
    الناتج_غير_مباشر: منطقي,
    فهرس_بيئة_الإغلاق: اختيار غير_موقع
};

عام عرف نوع_جزء_تجميعي_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الحجم: غير_موقع,
    الجزء: غير_موقع
): مرجع_نوع_إل_إل_في_إم {
    دع البداية: غير_موقع = الجزء * 8;
    دع المتبقي: متغير غير_موقع = 1;
    لو (الحجم > البداية) { المتبقي := الحجم - البداية; };
    لو (المتبقي > 8) { المتبقي := 8; };
    أرجع نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (المتبقي * 8) مثل غ32);
}

عرف أضف_أنواع_تصنيف_واجهة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    التصنيف: &تصنيف_قيمة_واجهة,
    الناتج: &متغير متجه مرجع_نوع_إل_إل_في_إم
): اختيار فشل_مزود_إل_إل_في_إم {
    دع ت: تصنيف_قيمة_واجهة = *التصنيف;
    لو (!ت.تجميعي) {
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { ألحق(*الناتج, ق.التمثيل); أرجع اختيار.لا_شيء(); };
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < ت.عدد_الأجزاء) {
        ألحق(*الناتج, نوع_جزء_تجميعي_إل_إل_في_إم(الحالة, ت.الحجم, ف));
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ابن_توقيع_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_دالة_واجهة,
    له_بيئة_إغلاق: منطقي
): نتيجة وصف_توقيع_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    دع غير_مباشر: متغير منطقي = خطأ;
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        ألحق(الأنواع, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
        غير_مباشر := صواب;
    }
    | _ -> { };
    دع فهرس_البيئة: متغير اختيار غير_موقع = اختيار.لا_شيء();
    لو (له_بيئة_إغلاق) {
        فهرس_البيئة := اختيار.بعض(الطول(الأنواع) مثل غير_موقع);
        ألحق(الأنواع, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الخطة).المعاملات) مثل غير_موقع)) {
        دع م: &خطة_معامل_واجهة = &(*الخطة).المعاملات[ف];
        طابق (*م).الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | موقع_تمرير_واجهة.غير_مباشر(_) -> { ألحق(الأنواع, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق)); }
        | موقع_تمرير_واجهة.مباشر(_) -> {
            طابق أضف_أنواع_تصنيف_واجهة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*م).النوع, &(*م).التصنيف, &متغير الأنواع) مع
            | اختيار.بعض(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختيار.لا_شيء -> { };
        }
        | موقع_تمرير_واجهة.مجزأ(_) -> {
            طابق أضف_أنواع_تصنيف_واجهة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*م).النوع, &(*م).التصنيف, &متغير الأنواع) مع
            | اختيار.بعض(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختيار.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    دع نوع_الناتج: متغير مرجع_نوع_إل_إل_في_إم = نوع_فراغ_إل_إل_في_إم((*الحالة).السياق);
    لو (!غير_مباشر) {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { }
        | موقع_تمرير_واجهة.غير_مباشر(_) -> { }
        | موقع_تمرير_واجهة.مباشر(_) -> {
            دع أجزاء: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
            طابق أضف_أنواع_تصنيف_واجهة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع, &(*الخطة).الناتج.التصنيف, &متغير أجزاء) مع
            | اختيار.بعض(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختيار.لا_شيء -> { };
            لو ((الطول(أجزاء) مثل غير_موقع) > 0) { نوع_الناتج := أجزاء[0]; };
        }
        | موقع_تمرير_واجهة.مجزأ(_) -> {
            دع أجزاء: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
            طابق أضف_أنواع_تصنيف_واجهة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع, &(*الخطة).الناتج.التصنيف, &متغير أجزاء) مع
            | اختيار.بعض(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختيار.لا_شيء -> { };
            لو ((الطول(أجزاء) مثل غير_موقع) == 1) { نوع_الناتج := أجزاء[0]; }
            وإلا لو ((الطول(أجزاء) مثل غير_موقع) > 1) { نوع_الناتج := نوع_بنية_إل_إل_في_إم((*الحالة).السياق, &متغير أجزاء[0], الطول(أجزاء) مثل غ32); };
        };
    };
    دع مؤشر_المعاملات: متغير مرجع_نوع_إل_إل_في_إم;
    لو ((الطول(الأنواع) مثل غير_موقع) > 0) { مؤشر_المعاملات := الأنواع[0]; };
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم;
    لو ((الطول(الأنواع) مثل غير_موقع) == 0) {
        دع فارغ: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_فراغ_إل_إل_في_إم((*الحالة).السياق)];
        نوع_الدالة := نوع_دالة_إل_إل_في_إم(نوع_الناتج, &متغير فارغ[0], 0);
    } وإلا {
        نوع_الدالة := نوع_دالة_إل_إل_في_إم(نوع_الناتج, &متغير الأنواع[0], الطول(الأنواع) مثل غ32);
    };
    دع الوصف: وصف_توقيع_إل_إل_في_إم = { النوع: نوع_الدالة, المعاملات: الأنواع, الناتج_غير_مباشر: غير_مباشر, فهرس_بيئة_الإغلاق: فهرس_البيئة };
    أرجع نتيجة.نجح(الوصف);
}

عام عرف أضف_صفة_ناتج_غير_مباشر_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    نوع_التخزين: مرجع_نوع_إل_إل_في_إم
): فراغ {
    دع الاسم: متغير متجه غ8 = [0x73,0x72,0x65,0x74,0];
    دع المعرف: غ32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), 4);
    دع الصفة: مرجع_صفة_إل_إل_في_إم = أنشئ_صفة_نوع_إل_إل_في_إم((*الحالة).السياق, المعرف, نوع_التخزين);
    أضف_صفة_معامل_إل_إل_في_إم(الدالة, 1, الصفة);
}

عام عرف أعلن_دالة_سلطان_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العرض: &عرض_دالة_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    دع الخطة: خطة_دالة_واجهة;
    طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, العرض) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
    | نتيجة.نجح(خ) -> { الخطة := خ; };
    دع له_بيئة: منطقي = (*العرض).عدد_الالتقاطات > 0;
    دع التوقيع: وصف_توقيع_إل_إل_في_إم;
    طابق ابن_توقيع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, &الخطة, له_بيئة) مع
    | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
    | نتيجة.نجح(ت) -> { التوقيع := ت; };
    دع الاسم_الخام: متجه غ8 = اسم_دالة_إل_إل_في_إم((*العرض).المعرف.القيمة);
    دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
    دع الدالة: مرجع_قيمة_إل_إل_في_إم = أضف_دالة_إل_إل_في_إم((*الحالة).الوحدة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), التوقيع.النوع);
    لو (التوقيع.الناتج_غير_مباشر) {
        دع قيد_الناتج: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, الخطة.الناتج.النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد_الناتج := ق; };
        أضف_صفة_ناتج_غير_مباشر_إل_إل_في_إم(الحالة, الدالة, قيد_الناتج.التمثيل);
    };
    بينما ((الطول((*الحالة).الدوال) مثل غير_موقع) <= (*العرض).المعرف.القيمة) { ألحق((*الحالة).الدوال, اختيار.لا_شيء()); };
    دع القيد: قيد_دالة_إل_إل_في_إم = { المعرف: (*العرض).المعرف, الدالة: الدالة, نوع_الدالة: التوقيع.النوع, غير_مباشر_الناتج: التوقيع.الناتج_غير_مباشر, عدد_معاملات_إل_إل_في_إم: الطول(التوقيع.المعاملات) مثل غير_موقع };
    (*الحالة).الدوال[(*العرض).المعرف.القيمة] := اختيار.بعض(القيد);
    أرجع اختيار.لا_شيء();
}

عام عرف أعلن_دالة_خارجية_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الدالة_الخارجية: &دالة_خارجية_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    دع الخطة: خطة_دالة_واجهة;
    طابق حل_خطة_واجهة_دالة_اختيارية_للهدف(&(*الحقائق).الأنواع, الهدف, سجل_التخطيط, &(*الدالة_الخارجية).المعاملات, (*الدالة_الخارجية).الناتج) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
    | نتيجة.نجح(خ) -> { الخطة := خ; };
    دع التوقيع: وصف_توقيع_إل_إل_في_إم;
    طابق ابن_توقيع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, &الخطة, خطأ) مع
    | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
    | نتيجة.نجح(ت) -> { التوقيع := ت; };
    دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&(*الدالة_الخارجية).الاسم);
    دع القيمة: مرجع_قيمة_إل_إل_في_إم = أضف_دالة_إل_إل_في_إم((*الحالة).الوحدة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), التوقيع.النوع);
    بينما ((الطول((*الحالة).الدوال_الخارجية) مثل غير_موقع) <= (*الدالة_الخارجية).المعرف.القيمة) { ألحق((*الحالة).الدوال_الخارجية, اختيار.لا_شيء()); };
    دع القيد: قيد_دالة_خارجية_إل_إل_في_إم = { المعرف: (*الدالة_الخارجية).المعرف, الدالة: القيمة, نوع_الدالة: التوقيع.النوع, غير_مباشر_الناتج: التوقيع.الناتج_غير_مباشر };
    (*الحالة).الدوال_الخارجية[(*الدالة_الخارجية).المعرف.القيمة] := اختيار.بعض(القيد);
    أرجع اختيار.لا_شيء();
}
