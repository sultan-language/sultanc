عام نوع وصف_توقيع_إل_إل_في_إم = {
    النوع: مرجع_نوع_إل_إل_في_إم,
    المعاملات: متجه مرجع_نوع_إل_إل_في_إم,
    الناتج_غير_مباشر: منطقي,
    فهرس_بيئة_الإغلاق: اختياري طبيعي
};

عرف موضع_جزء_واجهة_على_المكدس_لإل_إل_في_إم(
    الموضع: &موضع_جزء_واجهة
): منطقي {
    طابق *الموضع مع
    | موضع_جزء_واجهة.مكدس(_) -> { أرجع صواب; }
    | موضع_جزء_واجهة.سجل(_) -> { أرجع خطأ; };
}

عام عرف معامل_واجهة_بالقيمة_في_الذاكرة_لإل_إل_في_إم(
    الخطة: &خطة_معامل_واجهة
): منطقي {
    إذا (!(*الخطة).التصنيف.تجميعي) { أرجع خطأ; };
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.مباشر(الموضع) -> {
        أرجع موضع_جزء_واجهة_على_المكدس_لإل_إل_في_إم(&الموضع);
    }
    | موقع_تمرير_واجهة.مجزأ(المواضع) -> {
        إذا ((الطول(المواضع) مثل طبيعي) == 0) { أرجع خطأ; };
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < (الطول(المواضع) مثل طبيعي)) {
            إذا (!موضع_جزء_واجهة_على_المكدس_لإل_إل_في_إم(&المواضع[الفهرس])) {
                أرجع خطأ;
            };
            الفهرس := الفهرس + 1;
        }
        أرجع صواب;
    }
    | _ -> { أرجع خطأ; };
}

عرف عدد_معاملات_إل_إل_في_إم_لخطة_معامل(
    الخطة: &خطة_معامل_واجهة
): طبيعي {
    إذا (معامل_واجهة_بالقيمة_في_الذاكرة_لإل_إل_في_إم(الخطة)) { أرجع 1; };
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع 0; }
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { أرجع 1; }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        إذا ((*الخطة).التصنيف.تجميعي) { أرجع عدد_معاملات_أجزاء_واجهة_إل_إل_في_إم(&(*الخطة).التصنيف); };
        أرجع 1;
    }
    | موقع_تمرير_واجهة.مجزأ(_) -> {
        إذا ((*الخطة).التصنيف.تجميعي) { أرجع عدد_معاملات_أجزاء_واجهة_إل_إل_في_إم(&(*الخطة).التصنيف); };
        أرجع 1;
    };
}

عرف أضف_أنواع_تصنيف_واجهة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    التصنيف: &تصنيف_قيمة_واجهة,
    الأشكال: &متجه شكل_جزء_واجهة,
    الناتج: &متغير متجه مرجع_نوع_إل_إل_في_إم
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا (!(*التصنيف).تجميعي) {
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { ألحق(*الناتج, ق.التمثيل); أرجع اختياري.لا_شيء(); };
    };
    ألحق_أنواع_أجزاء_واجهة_إل_إل_في_إم(الحالة, التصنيف, الأشكال, الناتج);
    أرجع اختياري.لا_شيء();
}

// External calls use the canonical target ABI plan, including indirect aggregate
// returns and memory arguments. Do not override it with an LLVM-only ABI.
عام عرف ابن_توقيع_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_دالة_واجهة,
    له_بيئة_إغلاق: منطقي
): نتيجة وصف_توقيع_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    دع غير_مباشر: متغير منطقي = خطأ;
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        ألحق(الأنواع, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
        غير_مباشر := صواب;
    }
    | _ -> { };
    دع فهرس_البيئة: متغير اختياري طبيعي = اختياري.لا_شيء();
    إذا (له_بيئة_إغلاق) {
        فهرس_البيئة := اختياري.موجود(الطول(الأنواع) مثل طبيعي);
        ألحق(الأنواع, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الخطة).المعاملات) مثل طبيعي)) {
        دع م: &خطة_معامل_واجهة = &(*الخطة).المعاملات[ف];
        إذا (معامل_واجهة_بالقيمة_في_الذاكرة_لإل_إل_في_إم(م)) {
            ألحق(الأنواع, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
        } وإلا {
            طابق (*م).الموقع مع
            | موقع_تمرير_واجهة.متجاهل -> { }
            | موقع_تمرير_واجهة.غير_مباشر(_) -> { ألحق(الأنواع, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق)); }
            | موقع_تمرير_واجهة.مباشر(_) -> {
                طابق أضف_أنواع_تصنيف_واجهة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*م).النوع,
                    &(*م).التصنيف, &(*م).أشكال_الأجزاء, &متغير الأنواع) مع
                | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                | اختياري.لا_شيء -> { };
            }
            | موقع_تمرير_واجهة.مجزأ(_) -> {
                طابق أضف_أنواع_تصنيف_واجهة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*م).النوع,
                    &(*م).التصنيف, &(*م).أشكال_الأجزاء, &متغير الأنواع) مع
                | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                | اختياري.لا_شيء -> { };
            };
        };
        ف := ف + 1;
    }
    دع نوع_الناتج: متغير مرجع_نوع_إل_إل_في_إم = نوع_فراغ_إل_إل_في_إم((*الحالة).السياق);
    إذا (!غير_مباشر) {
        دع في_سجلات: متغير منطقي = خطأ;
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.مباشر(_) -> { في_سجلات := صواب; }
        | موقع_تمرير_واجهة.مجزأ(_) -> { في_سجلات := صواب; }
        | _ -> { };
        إذا (في_سجلات) {
            إذا (!(*الخطة).الناتج.التصنيف.تجميعي) {
                طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
                | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { نوع_الناتج := ق.التمثيل; };
            } وإلا إذا ((*الخطة).الناتج.التصنيف.عدد_الأجزاء > 0) {
                نوع_الناتج := نوع_قيمة_أجزاء_واجهة_إل_إل_في_إم(
                    الحالة, &(*الخطة).الناتج.التصنيف, &(*الخطة).الناتج.أشكال_الأجزاء
                );
            };
        };
    };
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم;
    إذا ((الطول(الأنواع) مثل طبيعي) == 0) {
        دع فارغ: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
        ألحق(فارغ, نوع_فراغ_إل_إل_في_إم((*الحالة).السياق));
        نوع_الدالة := نوع_دالة_إل_إل_في_إم(نوع_الناتج, &متغير فارغ[0], 0);
    } وإلا {
        نوع_الدالة := نوع_دالة_إل_إل_في_إم(نوع_الناتج, &متغير الأنواع[0], الطول(الأنواع) مثل ط32);
    };
    دع الوصف: وصف_توقيع_إل_إل_في_إم = { النوع: نوع_الدالة, المعاملات: الأنواع, الناتج_غير_مباشر: غير_مباشر,
        فهرس_بيئة_الإغلاق: فهرس_البيئة };
    أرجع نتيجة.نجح(الوصف);
}

عام عرف أضف_صفة_ناتج_غير_مباشر_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    نوع_التخزين: مرجع_نوع_إل_إل_في_إم,
    موضع_نداء: منطقي
): فراغ {
    دع الاسم: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«sret»);
    دع المعرف: ط32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), 4);
    دع الصفة: مرجع_صفة_إل_إل_في_إم = أنشئ_صفة_نوع_إل_إل_في_إم((*الحالة).السياق, المعرف, نوع_التخزين);
    إذا (موضع_نداء) {
        أضف_صفة_معامل_نداء_إل_إل_في_إم(القيمة, 1, الصفة);
    } وإلا {
        أضف_صفة_معامل_إل_إل_في_إم(القيمة, 1, الصفة);
    };
}

عرف أضف_صفتي_معامل_بالقيمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    فهرس_المعامل: ط32,
    نوع_التخزين: مرجع_نوع_إل_إل_في_إم,
    المحاذاة: طبيعي,
    موضع_نداء: منطقي
): فراغ {
    دع اسم_بالقيمة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«byval»);
    دع معرف_بالقيمة: ط32 = معرف_صفة_إل_إل_في_إم(
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_بالقيمة), 5
    );
    دع صفة_بالقيمة: مرجع_صفة_إل_إل_في_إم = أنشئ_صفة_نوع_إل_إل_في_إم(
        (*الحالة).السياق, معرف_بالقيمة, نوع_التخزين
    );
    دع اسم_المحاذاة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«align»);
    دع معرف_المحاذاة: ط32 = معرف_صفة_إل_إل_في_إم(
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_المحاذاة), 5
    );
    دع صفة_المحاذاة: مرجع_صفة_إل_إل_في_إم = أنشئ_صفة_تعداد_إل_إل_في_إم(
        (*الحالة).السياق, معرف_المحاذاة, المحاذاة مثل ط64
    );
    إذا (موضع_نداء) {
        أضف_صفة_معامل_نداء_إل_إل_في_إم(القيمة, فهرس_المعامل, صفة_بالقيمة);
        أضف_صفة_معامل_نداء_إل_إل_في_إم(القيمة, فهرس_المعامل, صفة_المحاذاة);
    } وإلا {
        أضف_صفة_معامل_إل_إل_في_إم(القيمة, فهرس_المعامل, صفة_بالقيمة);
        أضف_صفة_معامل_إل_إل_في_إم(القيمة, فهرس_المعامل, صفة_المحاذاة);
    };
}

عام عرف أضف_صفات_معاملات_الذاكرة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    الخطة: &خطة_دالة_واجهة,
    له_بيئة_إغلاق: منطقي,
    موضع_نداء: منطقي
): اختياري فشل_مزود_إل_إل_في_إم {
    دع فهرس_إل_إل_في_إم: متغير طبيعي = 1;
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> { فهرس_إل_إل_في_إم := فهرس_إل_إل_في_إم + 1; }
    | _ -> { };
    إذا (له_بيئة_إغلاق) { فهرس_إل_إل_في_إم := فهرس_إل_إل_في_إم + 1; };
    // Packed register parts of an aggregate result (index 0).
    إذا ((*الخطة).الناتج.التصنيف.تجميعي && (*الخطة).الناتج.التصنيف.أجزاء_مرصوصة) {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.مباشر(_) -> { أضف_صفة_أجزاء_مرصوصة_إل_إل_في_إم(الحالة, القيمة, 0, موضع_نداء); }
        | موقع_تمرير_واجهة.مجزأ(_) -> { أضف_صفة_أجزاء_مرصوصة_إل_إل_في_إم(الحالة, القيمة, 0, موضع_نداء); }
        | _ -> { };
    };
    // Integer extension the plan requires of a scalar result (index 0).
    إذا (!(*الخطة).الناتج.التصنيف.تجميعي) {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.مباشر(_) -> {
            أضف_صفة_توسيع_إل_إل_في_إم(
                الحالة, القيمة, 0, (*الخطة).الناتج.التصنيف.التوسيع, موضع_نداء
            );
        }
        | _ -> { };
    };
    دع فهرس_الخطة: متغير طبيعي = 0;
    طالما (فهرس_الخطة < (الطول((*الخطة).المعاملات) مثل طبيعي)) {
        دع مرجع_الخطة: &خطة_معامل_واجهة = &(*الخطة).المعاملات[فهرس_الخطة];
        إذا (!(*مرجع_الخطة).التصنيف.تجميعي) {
            طابق (*مرجع_الخطة).الموقع مع
            | موقع_تمرير_واجهة.مباشر(_) -> {
                أضف_صفة_توسيع_إل_إل_في_إم(
                    الحالة, القيمة, فهرس_إل_إل_في_إم مثل ط32,
                    (*مرجع_الخطة).التصنيف.التوسيع, موضع_نداء
                );
            }
            | _ -> { };
        };
        إذا ((*مرجع_الخطة).التصنيف.تجميعي && (*مرجع_الخطة).التصنيف.أجزاء_مرصوصة
            && !معامل_واجهة_بالقيمة_في_الذاكرة_لإل_إل_في_إم(مرجع_الخطة)) {
            دع عدد_الأجزاء: طبيعي = عدد_معاملات_إل_إل_في_إم_لخطة_معامل(مرجع_الخطة);
            دع ج: متغير طبيعي = 0;
            طالما (ج < عدد_الأجزاء) {
                أضف_صفة_أجزاء_مرصوصة_إل_إل_في_إم(
                    الحالة, القيمة, (فهرس_إل_إل_في_إم + ج) مثل ط32, موضع_نداء
                );
                ج := ج + 1;
            }
        };
        إذا (معامل_واجهة_بالقيمة_في_الذاكرة_لإل_إل_في_إم(مرجع_الخطة)) {
            دع القيد: قيد_نوع_إل_إل_في_إم;
            طابق حل_نوع_إل_إل_في_إم(
                الحالة, الحقائق, الهدف, سجل_التخطيط, (*مرجع_الخطة).النوع
            ) مع
            | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_إل_إل_في_إم.نجح(النوع) -> { القيد := النوع; };
            أضف_صفتي_معامل_بالقيمة_إل_إل_في_إم(
                الحالة, القيمة, فهرس_إل_إل_في_إم مثل ط32, القيد.التمثيل,
                (*مرجع_الخطة).التصنيف.المحاذاة, موضع_نداء
            );
        };
        إذا ((*مرجع_الخطة).التصنيف.تجميعي && !(*مرجع_الخطة).التصنيف.نسخة_للمستدعى) {
            طابق (*مرجع_الخطة).الموقع مع
            | موقع_تمرير_واجهة.غير_مباشر(_) -> {
                أضف_صفات_مرجع_خفي_إل_إل_في_إم(الحالة, القيمة, فهرس_إل_إل_في_إم مثل ط32, موضع_نداء);
            }
            | _ -> { };
        };
        فهرس_إل_إل_في_إم := فهرس_إل_إل_في_إم +
            عدد_معاملات_إل_إل_في_إم_لخطة_معامل(مرجع_الخطة);
        فهرس_الخطة := فهرس_الخطة + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اسم_دالة_سلطان_إل_إل_في_إم(
    الهدف: &واصف_هدف,
    دالة_الدخول: &اختياري معرف_دالة_مسير,
    المعرف: معرف_دالة_مسير
): متجه ط8 {
    طابق *دالة_الدخول مع
    | اختياري.موجود(الدخول) -> {
        إذا (الدخول.القيمة == المعرف.القيمة) {
            طابق (*الهدف).صيغة_الكائن مع
            | صيغة_كائن_هدف.إلف -> {
                // main
                دع الاسم: متجه ط8 = بايتات_من_نص(«main»);
                أرجع الاسم;
            }
            | صيغة_كائن_هدف.ماتشو -> {
                // main; LLVM's Mach-O writer applies the leading underscore.
                دع الاسم: متجه ط8 = بايتات_من_نص(«main»);
                أرجع الاسم;
            }
            | صيغة_كائن_هدف.كوف -> {
                // _start, the PE entry point (link/coff/names.sn); an executable's
                // process start renames it (entry.sn أضف_بدء_عملية_بلا_وسائط_إل_إل_في_إم).
                دع الاسم: متجه ط8 = بايتات_من_نص(«_start»);
                أرجع الاسم;
            }
            | صيغة_كائن_هدف.ويب_أسمبلي -> {
                // _start for WASI command modules. Non-command Wasm outputs ignore entry roots.
                دع الاسم: متجه ط8 = بايتات_من_نص(«_start»);
                أرجع الاسم;
            }
            | _ -> { };
        };
    }
    | اختياري.لا_شيء -> { };

    أرجع اسم_دالة_إل_إل_في_إم(المعرف.القيمة);
}

عام عرف أعلن_دالة_سلطان_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: &اختياري معرف_دالة_مسير,
    العرض: &عرض_دالة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    دع الخطة: متغير خطة_دالة_واجهة;
    طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, العرض) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
    | نتيجة.نجح(خ) -> { الخطة := خ; };
    دع هو_مدخل_البرنامج: متغير منطقي = خطأ;
    طابق *دالة_الدخول مع
    | اختياري.موجود(الدخول) -> {
        إذا (الدخول.القيمة == (*العرض).المعرف.القيمة) {
            هو_مدخل_البرنامج := صواب;
        };
    }
    | اختياري.لا_شيء -> { };
    // All ordinary SultanC functions use one hidden closure-environment
    // parameter. The process entry alone keeps the plain C ABI its caller (the
    // process start, dyld or the WASI host) uses.
    دع له_بيئة: منطقي = !هو_مدخل_البرنامج;
    دع التوقيع: وصف_توقيع_إل_إل_في_إم;
    طابق ابن_توقيع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, &الخطة, له_بيئة) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ت) -> { التوقيع := ت; };
    دع الاسم_الخام: متجه ط8 = اسم_دالة_سلطان_إل_إل_في_إم(
        الهدف, دالة_الدخول, (*العرض).المعرف
    );
    دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
    دع الدالة: مرجع_قيمة_إل_إل_في_إم = أضف_دالة_إل_إل_في_إم((*الحالة).الوحدة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
        الاسم), التوقيع.النوع);
    إذا (!يطابق_اسم_قيمة_إل_إل_في_إم(الدالة, &الاسم_الخام)) {
        أرجع اختياري.موجود(
            فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(
                انسخ_بايتات_إل_إل_في_إم(&الاسم_الخام)
            )
        );
    };
    إذا (التوقيع.الناتج_غير_مباشر) {
        دع قيد_الناتج: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, الخطة.الناتج.النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد_الناتج := ق; };
        أضف_صفة_ناتج_غير_مباشر_إل_إل_في_إم(الحالة, الدالة, قيد_الناتج.التمثيل, خطأ);
    };
    طابق أضف_صفات_معاملات_الذاكرة_إل_إل_في_إم(
        الحالة, الحقائق, الهدف, سجل_التخطيط, الدالة, &الخطة, له_بيئة, خطأ
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع موضع_الدالة: طبيعي = (*العرض).المعرف.القيمة;
    طالما ((الطول((*الحالة).الدوال) مثل طبيعي) <= موضع_الدالة) { ألحق((*الحالة).الدوال, اختياري.لا_شيء()); }
    دع القيد: قيد_دالة_إل_إل_في_إم = { المعرف: (*العرض).المعرف, الدالة: الدالة, نوع_الدالة: التوقيع.النوع,
        غير_مباشر_الناتج: التوقيع.الناتج_غير_مباشر, عدد_معاملات_إل_إل_في_إم: الطول(التوقيع.المعاملات) مثل
        طبيعي, له_بيئة_إغلاق: له_بيئة };
    (*الحالة).الدوال[موضع_الدالة] := اختياري.موجود(القيد);
    أرجع اختياري.لا_شيء();
}

عرف اسما_دالة_خارجية_إل_إل_في_إم_متساويان(
    اليسار: &متجه ط8,
    اليمين: &متجه ط8
): منطقي {
    إذا ((الطول(*اليسار) مثل طبيعي) != (الطول(*اليمين) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*اليسار) مثل طبيعي)) {
        إذا ((*اليسار)[الفهرس] != (*اليمين)[الفهرس]) { أرجع خطأ; };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عرف انسخ_اسم_دالة_خارجية_إل_إل_في_إم(الاسم: &متجه ط8): متجه ط8 {
    دع النسخة: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الاسم) مثل طبيعي)) {
        ألحق(النسخة, (*الاسم)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع النسخة;
}

// Function types alone do not encode sret/byval element types or byval
// alignment with opaque pointers. Validate the ABI-bearing attributes before
// reusing a declaration, rather than overwriting attributes on the existing
// LLVM symbol. The canonical target ABI plan remains their source of truth.
عرف يطابق_صفة_نوع_معامل_خارجية_إل_إل_في_إم(
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    الفهرس: ط32,
    معرف_الصفة: ط32,
    النوع_المتوقع: اختياري مرجع_نوع_إل_إل_في_إم
): منطقي {
    دع الموجودة: مرجع_صفة_إل_إل_في_إم = LLVMGetEnumAttributeAtIndex(الدالة, الفهرس, معرف_الصفة);
    طابق النوع_المتوقع مع
    | اختياري.لا_شيء -> { أرجع الموجودة == الفارغ; }
    | اختياري.موجود(النوع) -> {
        إذا (الموجودة == الفارغ) { أرجع خطأ; };
        أرجع LLVMGetTypeAttributeValue(الموجودة) == النوع;
    };
}

عرف يطابق_صفة_محاذاة_معامل_خارجية_إل_إل_في_إم(
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    الفهرس: ط32,
    معرف_الصفة: ط32,
    المحاذاة_المتوقعة: طبيعي
): منطقي {
    دع الموجودة: مرجع_صفة_إل_إل_في_إم = LLVMGetEnumAttributeAtIndex(الدالة, الفهرس, معرف_الصفة);
    إذا (المحاذاة_المتوقعة == 0) { أرجع الموجودة == الفارغ; };
    إذا (الموجودة == الفارغ) { أرجع خطأ; };
    أرجع LLVMGetEnumAttributeValue(الموجودة) == (المحاذاة_المتوقعة مثل ط64);
}

عرف تحقق_صفات_إعادة_استخدام_خارجية_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    الخطة: &خطة_دالة_واجهة,
    التوقيع: &وصف_توقيع_إل_إل_في_إم
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا (LLVMGlobalGetValueType(القيمة) != (*التوقيع).النوع
        || LLVMGetFunctionCallConv(القيمة) != 0
        || LLVMCountBasicBlocks(القيمة) != 0) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
    };
    دع اسم_الناتج: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«sret»);
    دع اسم_بالقيمة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«byval»);
    دع اسم_المحاذاة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«align»);
    دع معرف_الناتج: ط32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الناتج), 4);
    دع معرف_بالقيمة: ط32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_بالقيمة), 5);
    دع معرف_المحاذاة: ط32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_المحاذاة), 5);
    دع الفهرس: متغير ط32 = 1;
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع القيد: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(النوع) -> { القيد := النوع; };
        إذا (!يطابق_صفة_نوع_معامل_خارجية_إل_إل_في_إم(
            القيمة, الفهرس, معرف_الناتج, اختياري.موجود(القيد.التمثيل)
        )) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); };
        إذا (!يطابق_صفة_نوع_معامل_خارجية_إل_إل_في_إم(
            القيمة, الفهرس, معرف_بالقيمة, اختياري.لا_شيء()
        ) || !يطابق_صفة_محاذاة_معامل_خارجية_إل_إل_في_إم(
            القيمة, الفهرس, معرف_المحاذاة, 0
        )) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); };
        الفهرس := الفهرس + 1;
    }
    | _ -> { };
    دع المعامل: متغير طبيعي = 0;
    طالما (المعامل < (الطول((*الخطة).المعاملات) مثل طبيعي)) {
        دع قيد_الخطة: &خطة_معامل_واجهة = &(*الخطة).المعاملات[المعامل];
        دع عدد_الأجزاء: طبيعي = عدد_معاملات_إل_إل_في_إم_لخطة_معامل(قيد_الخطة);
        دع نوع_بالقيمة: متغير اختياري مرجع_نوع_إل_إل_في_إم = اختياري.لا_شيء();
        دع المحاذاة: متغير طبيعي = 0;
        إذا (معامل_واجهة_بالقيمة_في_الذاكرة_لإل_إل_في_إم(قيد_الخطة)) {
            طابق حل_نوع_إل_إل_في_إم(
                الحالة, الحقائق, الهدف, سجل_التخطيط, (*قيد_الخطة).النوع
            ) مع
            | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_إل_إل_في_إم.نجح(النوع) -> { نوع_بالقيمة := اختياري.موجود(النوع.التمثيل); };
            المحاذاة := (*قيد_الخطة).التصنيف.المحاذاة;
        };
        دع الجزء: متغير طبيعي = 0;
        طالما (الجزء < عدد_الأجزاء) {
            دع المتوقع: اختياري مرجع_نوع_إل_إل_في_إم;
            دع محاذاة_الجزء: طبيعي;
            إذا (الجزء == 0) {
                المتوقع := نوع_بالقيمة;
                محاذاة_الجزء := المحاذاة;
            } وإلا {
                المتوقع := اختياري.لا_شيء();
                محاذاة_الجزء := 0;
            };
            إذا (!يطابق_صفة_نوع_معامل_خارجية_إل_إل_في_إم(
                القيمة, الفهرس, معرف_الناتج, اختياري.لا_شيء()
            ) || !يطابق_صفة_نوع_معامل_خارجية_إل_إل_في_إم(
                القيمة, الفهرس, معرف_بالقيمة, المتوقع
            ) || !يطابق_صفة_محاذاة_معامل_خارجية_إل_إل_في_إم(
                القيمة, الفهرس, معرف_المحاذاة, محاذاة_الجزء
            )) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); };
            الفهرس := الفهرس + 1;
            الجزء := الجزء + 1;
        }
        المعامل := المعامل + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف أعلن_دالة_خارجية_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الدالة_الخارجية: &دالة_خارجية_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    دع الخطة: متغير خطة_دالة_واجهة;
    طابق حل_خطة_واجهة_دالة_خارجية_للهدف(&(*الحقائق).الأنواع, الهدف, سجل_التخطيط,
        &(*الدالة_الخارجية).المعاملات, (*الدالة_الخارجية).الناتج) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
    | نتيجة.نجح(خ) -> { الخطة := خ; };
    دع التوقيع: متغير وصف_توقيع_إل_إل_في_إم;
    طابق ابن_توقيع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, &الخطة, خطأ) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ت) -> { التوقيع := ت; };
    طابق (*الدالة_الخارجية).المعاملات_الثابتة مع
    | اختياري.موجود(الثابتة) -> {
        طابق اجعل_توقيع_دالة_متغيرة_إل_إل_في_إم(&متغير الخطة, الثابتة, &متغير التوقيع) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    دع القيمة_الموجودة: متغير اختياري مرجع_قيمة_إل_إل_في_إم = اختياري.لا_شيء();
    دع فهرس_التصريح: متغير طبيعي = 0;
    طالما (فهرس_التصريح < (الطول((*الحالة).الدوال_الخارجية) مثل طبيعي)) {
        طابق القيمة_الموجودة مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            طابق (*الحالة).الدوال_الخارجية[فهرس_التصريح] مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الموجود) -> {
                إذا (اسما_دالة_خارجية_إل_إل_في_إم_متساويان(
                    &الموجود.الاسم,
                    &(*الدالة_الخارجية).الاسم
                )) {
                    القيمة_الموجودة := اختياري.موجود(الموجود.الدالة);
                };
            };
        };
        فهرس_التصريح := فهرس_التصريح + 1;
    }
    دع القيمة: مرجع_قيمة_إل_إل_في_إم;
    دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&(*الدالة_الخارجية).الاسم);
    دع القيمة_بالاسم: مرجع_قيمة_إل_إل_في_إم = LLVMGetNamedFunction(
        (*الحالة).الوحدة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم)
    );
    طابق القيمة_الموجودة مع
    | اختياري.موجود(الموجودة) -> {
        // The symbol must still be the exact external declaration we own.
        إذا (القيمة_بالاسم != الموجودة) {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
        طابق تحقق_صفات_إعادة_استخدام_خارجية_إل_إل_في_إم(
            الحالة, الحقائق, الهدف, سجل_التخطيط, الموجودة, &الخطة, &التوقيع
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        القيمة := الموجودة;
    }
    | اختياري.لا_شيء -> {
        // A name already owned by a language entry, generated function or
        // data symbol cannot be adopted as an unrelated external declaration.
        إذا (القيمة_بالاسم != الفارغ ||
            LLVMGetNamedGlobal((*الحالة).الوحدة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم))
                != الفارغ) {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
        القيمة := أضف_دالة_إل_إل_في_إم(
            (*الحالة).الوحدة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم),
            التوقيع.النوع
        );
    };
    إذا (!يطابق_اسم_قيمة_إل_إل_في_إم(القيمة, &(*الدالة_الخارجية).الاسم)) {
        أرجع اختياري.موجود(
            فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(
                انسخ_بايتات_إل_إل_في_إم(&(*الدالة_الخارجية).الاسم)
            )
        );
    };
    طابق القيمة_الموجودة مع
    | اختياري.موجود(_) -> { } // ABI attributes have already been validated, never replaced.
    | اختياري.لا_شيء -> {
        إذا (التوقيع.الناتج_غير_مباشر) {
            دع قيد_الناتج: قيد_نوع_إل_إل_في_إم;
            طابق حل_نوع_إل_إل_في_إم(
                الحالة, الحقائق, الهدف, سجل_التخطيط, الخطة.الناتج.النوع
            ) مع
            | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_إل_إل_في_إم.نجح(النوع) -> { قيد_الناتج := النوع; };
            أضف_صفة_ناتج_غير_مباشر_إل_إل_في_إم(الحالة, القيمة, قيد_الناتج.التمثيل, خطأ);
        };
        طابق أضف_صفات_معاملات_الذاكرة_إل_إل_في_إم(
            الحالة, الحقائق, الهدف, سجل_التخطيط, القيمة, &الخطة, خطأ, خطأ
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        // A WebAssembly import from the module the declaration names (its
        // library, `خارجي «wasi_snapshot_preview1» عرف ...`), field = the
        // linker symbol, as clang's import_module/import_name attributes and
        // Rust's #[link(wasm_import_module)]. Without a declared module LLVM
        // imports from `env`. Placed on the function index (~0).
        دع وحدة_مصرحة: متغير اختياري متجه ط8 = اختياري.لا_شيء();
        إذا ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.ويب_أسمبلي()) {
            وحدة_مصرحة := انسخ_اختيار_بايتات(&(*الدالة_الخارجية).المكتبة);
        };
        طابق وحدة_مصرحة مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(وحدة_الاستيراد) -> {
            دع مفتاح_الوحدة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«wasm-import-module»);
            دع قيمة_الوحدة: متغير متجه ط8 = انسخ_بايتات(&وحدة_الاستيراد);
            دع طول_القيمة: ط32 = الطول(قيمة_الوحدة) مثل ط32;
            ألحق(قيمة_الوحدة, 0);
            دع الصفة: مرجع_صفة_إل_إل_في_إم = LLVMCreateStringAttribute(
                (*الحالة).السياق,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير مفتاح_الوحدة), 18,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير قيمة_الوحدة), طول_القيمة
            );
            LLVMAddAttributeAtIndex(القيمة, 4294967295, الصفة);
            // An explicit import name marks the symbol as a host import
            // (WASM_SYMBOL_EXPLICIT_NAME) whose field is that name, as the
            // native wasm32 writer marks WASI imports; link/wasm/linker.sn
            // imports it from this module when no input defines it.
            دع مفتاح_الاسم: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«wasm-import-name»);
            دع قيمة_الاسم: متغير متجه ط8 = انسخ_اسم_دالة_خارجية_إل_إل_في_إم(
                &(*الدالة_الخارجية).الاسم
            );
            دع طول_الاسم: ط32 = الطول(قيمة_الاسم) مثل ط32;
            ألحق(قيمة_الاسم, 0);
            دع صفة_الاسم: مرجع_صفة_إل_إل_في_إم = LLVMCreateStringAttribute(
                (*الحالة).السياق,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير مفتاح_الاسم), 16,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير قيمة_الاسم), طول_الاسم
            );
            LLVMAddAttributeAtIndex(القيمة, 4294967295, صفة_الاسم);
        };
    };
    دع موضع_الدالة_الخارجية: طبيعي = (*الدالة_الخارجية).المعرف.القيمة;
    طالما ((الطول((*الحالة).الدوال_الخارجية) مثل طبيعي) <= موضع_الدالة_الخارجية) {
        ألحق((*الحالة).الدوال_الخارجية, اختياري.لا_شيء()); }
    دع اسم_مخزن: متجه ط8 = انسخ_اسم_دالة_خارجية_إل_إل_في_إم(
        &(*الدالة_الخارجية).الاسم
    );
    دع القيد: قيد_دالة_خارجية_إل_إل_في_إم = {
        المعرف: (*الدالة_الخارجية).المعرف,
        الاسم: اسم_مخزن,
        الدالة: القيمة,
        نوع_الدالة: التوقيع.النوع,
        غير_مباشر_الناتج: التوقيع.الناتج_غير_مباشر
    };
    (*الحالة).الدوال_الخارجية[موضع_الدالة_الخارجية] := اختياري.موجود(القيد);
    أرجع اختياري.لا_شيء();
}

// C variadic functions (msir_model.sn, دالة_خارجية_مسير.المعاملات_الثابتة).
// Each MSIR declaration is one call shape: the fixed parameters, then the
// promoted variadic arguments. LLVM declares the symbol once, with its fixed
// parameters and `...`, as Clang does; a call through that function type
// passes the further arguments under the target's C variadic convention
// (System V x86-64 sets AL to the vector registers used, Apple arm64 puts
// them on the stack in 8-byte slots, Win64 copies a float to its integer
// register as well).

// Makes التوقيع (built from the whole shape's plan) the variadic function
// type of the first الثابتة parameters, and الخطة the plan of those
// parameters (the declaration's attributes describe only them). Every
// variadic argument must be one direct scalar part.
عام عرف اجعل_توقيع_دالة_متغيرة_إل_إل_في_إم(
    الخطة: &متغير خطة_دالة_واجهة,
    الثابتة: طبيعي,
    التوقيع: &متغير وصف_توقيع_إل_إل_في_إم
): اختياري فشل_مزود_إل_إل_في_إم {
    دع العدد: طبيعي = الطول((*الخطة).المعاملات) مثل طبيعي;
    إذا (الثابتة > العدد) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); };
    دع ف: متغير طبيعي = الثابتة;
    طالما (ف < العدد) {
        دع م: &خطة_معامل_واجهة = &(*الخطة).المعاملات[ف];
        دع مباشر: متغير منطقي = خطأ;
        طابق (*م).الموقع مع
        | موقع_تمرير_واجهة.مباشر(_) -> { مباشر := صواب; }
        | _ -> { };
        إذا (!مباشر || (*م).التصنيف.تجميعي) {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة());
        };
        ف := ف + 1;
    }
    دع الكل: طبيعي = الطول((*التوقيع).المعاملات) مثل طبيعي;
    إذا (الكل < العدد - الثابتة) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); };
    دع عدد_الثابتة: طبيعي = الكل - (العدد - الثابتة);
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    ف := 0;
    طالما (ف < عدد_الثابتة) { ألحق(الأنواع, (*التوقيع).المعاملات[ف]); ف := ف + 1; }
    دع نوع_الناتج: مرجع_نوع_إل_إل_في_إم = LLVMGetReturnType((*التوقيع).النوع);
    دع النوع: متغير مرجع_نوع_إل_إل_في_إم = نوع_الناتج;
    إذا (عدد_الثابتة == 0) {
        دع بديل: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_الناتج];
        النوع := LLVMFunctionType(نوع_الناتج, &متغير بديل[0], 0, 1);
    } وإلا {
        النوع := LLVMFunctionType(نوع_الناتج, &متغير الأنواع[0], عدد_الثابتة مثل ط32, 1);
    };
    (*التوقيع).النوع := النوع;
    (*التوقيع).المعاملات := الأنواع;
    دع الثابتة_ف: متغير متجه خطة_معامل_واجهة = [];
    ف := 0;
    طالما (ف < الثابتة) {
        دع م: &خطة_معامل_واجهة = &(*الخطة).المعاملات[ف];
        دع النسخة: خطة_معامل_واجهة = {
            الفهرس: (*م).الفهرس, النوع: (*م).النوع, التصنيف: (*م).التصنيف,
            الموقع: انسخ_مملوكا_موقع_تمرير_واجهة(&(*م).الموقع),
            أشكال_الأجزاء: انسخ_مملوكا_متجه_شكل_جزء_واجهة(&(*م).أشكال_الأجزاء)
        };
        ألحق(الثابتة_ف, النسخة);
        ف := ف + 1;
    }
    (*الخطة).المعاملات := الثابتة_ف;
    أرجع اختياري.لا_شيء();
}
