استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.target.selection_query_context;
استورد compiler.backend.target.target_model;
استورد compiler.backend.layout.layout_model;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.debug_contract;
استورد compiler.msir.identifiers;
استورد compiler.source.source_map;
استورد compiler.source.provenance;
استورد std.text.from_bytes;
استورد compiler.backend.provider.llvm.target;
استورد compiler.backend.provider.llvm.module;
استورد compiler.backend.provider.llvm.lowering;
استورد compiler.backend.provider.llvm.optimization;
استورد compiler.backend.provider.llvm.emission;
استورد compiler.backend.provider.llvm.entry;
استورد compiler.backend.provider.llvm.debuginfo;
استورد compiler.backend.provider.llvm.toolchain;

// LLVM provider inclusion boundary (logical module
// compiler.backend.provider.llvm.llvm_codegen).
//
// This module is what the Driver links against for everything that needs the
// LLVM C API: code generation and the location of the libLLVM the running
// compiler is linked with. Whether a produced compiler contains it is a
// compiler-build capability chosen by the build of that compiler, never by
// the target the compiler is generated for and never by the backend that
// generates it:
//
// - LLVM included (this file, the default source of the module): the full
//   provider below and its reachable LLVM C API references.
// - LLVM excluded: the build binds this logical module to
//   compiler/backend/provider/llvm/unavailable.sn with the Driver's
//   --module-source option (the canonical explicit source location of the
//   logical environment, logical_environment.sn أضف_موقع_مصدر_وحدة). That
//   source declares the same entry points without importing any LLVM
//   module, so nothing the produced compiler reaches references libLLVM.
//
// Previously inclusion was a top-level target condition on the output
// platform (`الهدف.المنصة != «wasi»`): every non-WASI compiler carried the
// LLVM C API, so a Native-generated arm64-darwin compiler needed a Darwin
// libLLVM at link time even when it was meant to be Native-only, and a WASI
// compiler could never include LLVM. See docs/SULTANC_KERNEL_ARCHITECTURE.md ("Compiler-build capabilities").

// مدخل مزود LLVM المنتج. يستهلك MSIR المتحقق وحقائق Target/Layout المقننة فقط.
// لا يملك سياق تجميع موازيا ولا يعيد بناء حقائق الواجهة أو الأنواع.
عام عرف ولد_مخرج_بمزود_إل_إل_في_إم(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: &اختياري معرف_دالة_مسير,
    المستوى: مستوى_تحسين_مزود_إل_إل_في_إم,
    سياسة_التموضع: سياسة_تموضع_شفرة_إل_إل_في_إم,
    احتفظ_بنص_الوحدة: منطقي,
    // True for an executable whose process start SultanC emits (driver بدء_عملية_ذاتي_لربط).
    بدء_عملية_ذاتي: منطقي,
    // Executables keep only the entry closure; every other output keeps
    // every function (msir_consumer.sn, دوال_مسير_مطلوبة_لمخرج), exactly
    // the selection the native provider makes.
    مخرج_تنفيذي: منطقي,
    // Target assembly text instead of an object (--emit=asm).
    فرض_التجميع: منطقي
): نتيجة_مزود_إل_إل_في_إم {
    دع الحالة: متغير حالة_مزود_إل_إل_في_إم;
    طابق هيئ_حالة_مزود_إل_إل_في_إم(
        الهدف,
        المستوى,
        سياسة_التموضع
    ) مع
    | نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ); }
    | نتيجة_تهيئة_هدف_إل_إل_في_إم.نجح(ح) -> { الحالة := ح; };

    دع محسن: منطقي = المستوى != مستوى_تحسين_مزود_إل_إل_في_إم.بلا();
    دع حالة_التصحيح: متغير حالة_تصحيح_إل_إل_في_إم = أنشئ_حالة_تصحيح_إل_إل_في_إم(&الحالة, التصحيح, المصادر,
        محسن);

    دع الدوال_المطلوبة: متغير متجه منطقي = دوال_مسير_مطلوبة_لمخرج(
        المسير, مخرج_تنفيذي, *دالة_الدخول
    );
    طابق أعلن_وحدة_إل_إل_في_إم(
        &متغير الحالة, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
        &الدوال_المطلوبة
    ) مع
    | اختياري.موجود(خ) -> {
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختياري.لا_شيء -> { };

    طابق أعلن_تصحيح_وحدة_إل_إل_في_إم(&متغير حالة_التصحيح, &متغير الحالة, المسير, حقائق_الخلفية, الهدف,
        سجل_التخطيط, التصحيح, المصادر, الأصول) مع
    | اختياري.موجود(خ) -> {
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختياري.لا_شيء -> { };

    طابق اخفض_كل_دوال_إل_إل_في_إم(&متغير الحالة, &متغير حالة_التصحيح, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
        التصحيح, المصادر, الأصول, &الدوال_المطلوبة) مع
    | اختياري.موجود(خ) -> {
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختياري.لا_شيء -> { };

    طابق أنشئ_مدخل_عملية_إل_إل_في_إم(&الحالة, الهدف, دالة_الدخول, المسير, بدء_عملية_ذاتي) مع
    | اختياري.موجود(الخطأ) -> {
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(الخطأ);
    }
    | اختياري.لا_شيء -> { };
    اختم_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
    طابق تحقق_وحسن_وحدة_إل_إل_في_إم(&الحالة, المستوى) مع
    | اختياري.موجود(خ) -> {
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختياري.لا_شيء -> { };

    دع الناتج: نتيجة ناتج_مزود_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم =
        أصدر_وحدة_إل_إل_في_إم(&الحالة, الهدف, احتفظ_بنص_الوحدة, فرض_التجميع);
    حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
    حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
    طابق الناتج مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ); }
    | نتيجة.نجح(ن) -> { أرجع نتيجة_مزود_إل_إل_في_إم.نجح(ن); };
}

// The produced compiler contains the LLVM provider: an explicit LLVM request
// is served when the registered target admits LLVM
// (backend_provider_query_context.sn يدعم_مزود_الخلفية).
عام عرف مزود_إل_إل_في_إم_مضمن(): منطقي {
    أرجع صواب;
}

// The libLLVM this running compiler is linked with, as its host loader mapped
// it (toolchain.sn). It is a fact of the running compiler's host, recorded by
// the Driver for outputs whose target is that host; never a fact of a target.
عام عرف موقع_مكتبة_إل_إل_في_إم_المضيف(): اختياري متجه ط8 {
    أرجع مسار_مكتبة_إل_إل_في_إم_الحالي();
}
