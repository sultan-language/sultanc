استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.target;
استورد compiler.backend.provider.llvm.module;
استورد compiler.backend.provider.llvm.lowering;
استورد compiler.backend.provider.llvm.optimization;
استورد compiler.backend.provider.llvm.emission;
استورد compiler.backend.target.selection_query_context;
استورد compiler.backend.target.target_model;
استورد compiler.backend.layout.layout_model;
استورد compiler.msir.msir_consumer;

// مدخل مزود LLVM المنتج. يستهلك MSIR المتحقق وحقائق Target/Layout المقننة فقط.
// لا يملك سياق تجميع موازيا ولا يعيد بناء حقائق الواجهة أو الأنواع.
عام عرف ولد_كائن_بمزود_إل_إل_في_إم(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المستوى: مستوى_تحسين_مزود_إل_إل_في_إم,
    احتفظ_بنص_الوحدة: منطقي
): نتيجة_مزود_إل_إل_في_إم {
    دع الحالة: متغير حالة_مزود_إل_إل_في_إم;
    طابق هيئ_حالة_مزود_إل_إل_في_إم(الهدف, المستوى) مع
    | نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ); }
    | نتيجة_تهيئة_هدف_إل_إل_في_إم.نجح(ح) -> { الحالة := ح; };

    طابق أعلن_وحدة_إل_إل_في_إم(&متغير الحالة, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط) مع
    | اختيار.بعض(خ) -> {
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختيار.لا_شيء -> { };

    طابق اخفض_كل_دوال_إل_إل_في_إم(&متغير الحالة, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط) مع
    | اختيار.بعض(خ) -> {
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختيار.لا_شيء -> { };

    طابق تحقق_وحسن_وحدة_إل_إل_في_إم(&الحالة, المستوى) مع
    | اختيار.بعض(خ) -> {
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختيار.لا_شيء -> { };

    دع الناتج: نتيجة ناتج_مزود_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم =
        أصدر_وحدة_ككائن_إل_إل_في_إم(&الحالة, احتفظ_بنص_الوحدة);
    حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
    طابق الناتج مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ); }
    | نتيجة.نجح(ن) -> { أرجع نتيجة_مزود_إل_إل_في_إم.نجح(ن); };
}
