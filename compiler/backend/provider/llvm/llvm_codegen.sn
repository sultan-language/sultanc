استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.target.selection_query_context;
استورد compiler.backend.target.target_model;
استورد compiler.backend.layout.layout_model;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.debug_contract;
استورد compiler.msir.identifiers;
استورد compiler.source.source_map;
استورد compiler.source.provenance;
استورد std.text.from_bytes;

// The LLVM provider calls the LLVM C API of the libLLVM the compiler is
// linked with. A compiler built for a WASI host has no libLLVM (and no way to
// load one), so there the provider is absent: the entry reports the backend
// as unavailable and the native backend remains usable. Hosts are selected by
// the frontend's target conditions, so no LLVM symbol is referenced on WASI.
لو (الهدف.المنصة != «wasi») {
    استورد compiler.backend.provider.llvm.target;
    استورد compiler.backend.provider.llvm.module;
    استورد compiler.backend.provider.llvm.lowering;
    استورد compiler.backend.provider.llvm.optimization;
    استورد compiler.backend.provider.llvm.emission;
    استورد compiler.backend.provider.llvm.entry;
    استورد compiler.backend.provider.llvm.debuginfo;

    // مدخل مزود LLVM المنتج. يستهلك MSIR المتحقق وحقائق Target/Layout المقننة فقط.
    // لا يملك سياق تجميع موازيا ولا يعيد بناء حقائق الواجهة أو الأنواع.
    عام عرف ولد_مخرج_بمزود_إل_إل_في_إم(
        المسير: &سياق_مستهلك_مسير,
        حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
        المصادر: &متغير خريطة_مصادر,
        الأصول: &سجل_أصول_مصدر,
        التصحيح: &بيانات_تصحيح_مسير,
        الهدف: &واصف_هدف,
        سجل_التخطيط: &متغير سجل_تخطيط,
        دالة_الدخول: &اختيار معرف_دالة_مسير,
        المستوى: مستوى_تحسين_مزود_إل_إل_في_إم,
        سياسة_التموضع: سياسة_تموضع_شفرة_إل_إل_في_إم,
        احتفظ_بنص_الوحدة: منطقي,
        // True only for an executable linked without a CRT (internal ELF linker).
        بدء_عملية_ذاتي: منطقي,
        // Executables keep only the entry closure; every other output keeps
        // every function (msir_consumer.sn, دوال_مسير_مطلوبة_لمخرج), exactly
        // the selection the native provider makes.
        مخرج_تنفيذي: منطقي
    ): نتيجة_مزود_إل_إل_في_إم {
        دع الحالة: متغير حالة_مزود_إل_إل_في_إم;
        طابق هيئ_حالة_مزود_إل_إل_في_إم(
            الهدف,
            المستوى,
            سياسة_التموضع
        ) مع
        | نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ); }
        | نتيجة_تهيئة_هدف_إل_إل_في_إم.نجح(ح) -> { الحالة := ح; };

        دع محسن: منطقي = المستوى != مستوى_تحسين_مزود_إل_إل_في_إم.بلا();
        دع حالة_التصحيح: متغير حالة_تصحيح_إل_إل_في_إم = أنشئ_حالة_تصحيح_إل_إل_في_إم(&الحالة, التصحيح, المصادر,
            محسن);

        دع الدوال_المطلوبة: متغير متجه منطقي = دوال_مسير_مطلوبة_لمخرج(
            المسير, مخرج_تنفيذي, *دالة_الدخول
        );
        طابق أعلن_وحدة_إل_إل_في_إم(
            &متغير الحالة, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول,
            &الدوال_المطلوبة
        ) مع
        | اختيار.بعض(خ) -> {
            حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
            حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
            أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
        }
        | اختيار.لا_شيء -> { };

        طابق أعلن_تصحيح_وحدة_إل_إل_في_إم(&متغير حالة_التصحيح, &متغير الحالة, المسير, حقائق_الخلفية, الهدف,
            سجل_التخطيط, التصحيح, المصادر, الأصول) مع
        | اختيار.بعض(خ) -> {
            حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
            حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
            أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
        }
        | اختيار.لا_شيء -> { };

        طابق اخفض_كل_دوال_إل_إل_في_إم(&متغير الحالة, &متغير حالة_التصحيح, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
            التصحيح, المصادر, الأصول, &الدوال_المطلوبة) مع
        | اختيار.بعض(خ) -> {
            حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
            حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
            أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
        }
        | اختيار.لا_شيء -> { };

        طابق أنشئ_مدخل_عملية_إل_إل_في_إم(&الحالة, الهدف, دالة_الدخول, المسير, بدء_عملية_ذاتي) مع
        | اختيار.بعض(الخطأ) -> {
            حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
            حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
            أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(الخطأ);
        }
        | اختيار.لا_شيء -> { };
        اختم_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        طابق تحقق_وحسن_وحدة_إل_إل_في_إم(&الحالة, المستوى) مع
        | اختيار.بعض(خ) -> {
            حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
            حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
            أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
        }
        | اختيار.لا_شيء -> { };

        دع الناتج: نتيجة ناتج_مزود_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم =
            أصدر_وحدة_إل_إل_في_إم(&الحالة, الهدف, احتفظ_بنص_الوحدة);
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        طابق الناتج مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ); }
        | نتيجة.نجح(ن) -> { أرجع نتيجة_مزود_إل_إل_في_إم.نجح(ن); };
    }
}

لو (الهدف.المنصة == «wasi») {
    عام عرف ولد_مخرج_بمزود_إل_إل_في_إم(
        المسير: &سياق_مستهلك_مسير,
        حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
        المصادر: &متغير خريطة_مصادر,
        الأصول: &سجل_أصول_مصدر,
        التصحيح: &بيانات_تصحيح_مسير,
        الهدف: &واصف_هدف,
        سجل_التخطيط: &متغير سجل_تخطيط,
        دالة_الدخول: &اختيار معرف_دالة_مسير,
        المستوى: مستوى_تحسين_مزود_إل_إل_في_إم,
        سياسة_التموضع: سياسة_تموضع_شفرة_إل_إل_في_إم,
        احتفظ_بنص_الوحدة: منطقي,
        // True only for an executable linked without a CRT (internal ELF linker).
        بدء_عملية_ذاتي: منطقي,
        // Executables keep only the entry closure; every other output keeps
        // every function (msir_consumer.sn, دوال_مسير_مطلوبة_لمخرج), exactly
        // the selection the native provider makes.
        مخرج_تنفيذي: منطقي
    ): نتيجة_مزود_إل_إل_في_إم {
        دع الرسالة: متجه غ8 = بايتات_من_نص(«LLVM is not available in a WASI-hosted compiler»);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.خلفية_هدف_غير_متاحة(الرسالة));
    }
}
