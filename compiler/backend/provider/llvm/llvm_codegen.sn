// مدخل مزود LLVM المنتج. يستهلك MSIR المتحقق وحقائق Target/Layout المقننة فقط.
// لا يملك سياق تجميع موازيا ولا يعيد بناء حقائق الواجهة أو الأنواع.
عام عرف ولد_مخرج_بمزود_إل_إل_في_إم(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_الدخول: &اختيار معرف_دالة_مسير,
    المستوى: مستوى_تحسين_مزود_إل_إل_في_إم,
    سياسة_التموضع: سياسة_تموضع_شفرة_إل_إل_في_إم,
    احتفظ_بنص_الوحدة: منطقي
): نتيجة_مزود_إل_إل_في_إم {
    دع الحالة: متغير حالة_مزود_إل_إل_في_إم;
    طابق هيئ_حالة_مزود_إل_إل_في_إم(
        الهدف,
        المستوى,
        سياسة_التموضع
    ) مع
    | نتيجة_تهيئة_هدف_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ); }
    | نتيجة_تهيئة_هدف_إل_إل_في_إم.نجح(ح) -> { الحالة := ح; };

    دع محسن: منطقي = المستوى != مستوى_تحسين_مزود_إل_إل_في_إم.بلا();
    دع حالة_التصحيح: متغير حالة_تصحيح_إل_إل_في_إم = أنشئ_حالة_تصحيح_إل_إل_في_إم(&الحالة, التصحيح, المصادر,
        محسن);

    طابق أعلن_وحدة_إل_إل_في_إم(
        &متغير الحالة, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, دالة_الدخول
    ) مع
    | اختيار.بعض(خ) -> {
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختيار.لا_شيء -> { };

    طابق أعلن_تصحيح_وحدة_إل_إل_في_إم(&متغير حالة_التصحيح, &متغير الحالة, المسير, حقائق_الخلفية, الهدف,
        سجل_التخطيط, التصحيح, المصادر, الأصول) مع
    | اختيار.بعض(خ) -> {
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختيار.لا_شيء -> { };

    طابق اخفض_كل_دوال_إل_إل_في_إم(&متغير الحالة, &متغير حالة_التصحيح, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط,
        التصحيح, المصادر, الأصول) مع
    | اختيار.بعض(خ) -> {
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختيار.لا_شيء -> { };

    أنشئ_مدخل_عملية_إل_إل_في_إم(&الحالة, الهدف, دالة_الدخول);
    اختم_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
    طابق تحقق_وحسن_وحدة_إل_إل_في_إم(&الحالة, المستوى) مع
    | اختيار.بعض(خ) -> {
        حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
        حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
        أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ);
    }
    | اختيار.لا_شيء -> { };

    دع الناتج: نتيجة ناتج_مزود_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم =
        أصدر_وحدة_إل_إل_في_إم(&الحالة, الهدف, احتفظ_بنص_الوحدة);
    حرر_حالة_تصحيح_إل_إل_في_إم(&متغير حالة_التصحيح);
    حرر_حالة_مزود_إل_إل_في_إم(&متغير الحالة);
    طابق الناتج مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_مزود_إل_إل_في_إم.خطأ(خ); }
    | نتيجة.نجح(ن) -> { أرجع نتيجة_مزود_إل_إل_في_إم.نجح(ن); };
}
