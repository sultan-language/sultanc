استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.passes;

عرف اسم_خط_تمريرات_إل_إل_في_إم(المستوى: مستوى_تحسين_مزود_إل_إل_في_إم): متجه غ8 {
    طابق المستوى مع
    | مستوى_تحسين_مزود_إل_إل_في_إم.بلا -> { دع ن: متجه غ8 = []; أرجع ن; }
    | مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي -> {
        دع ن: متجه غ8 = [0x64,0x65,0x66,0x61,0x75,0x6C,0x74,0x3C,0x4F,0x32,0x3E];
        أرجع ن;
    }
    | مستوى_تحسين_مزود_إل_إل_في_إم.عال -> {
        دع ن: متجه غ8 = [0x64,0x65,0x66,0x61,0x75,0x6C,0x74,0x3C,0x4F,0x33,0x3E];
        أرجع ن;
    };
}

عام عرف تحقق_وحسن_وحدة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المستوى: مستوى_تحسين_مزود_إل_إل_في_إم
): اختيار فشل_مزود_إل_إل_في_إم {
    دع رسالة: متغير مؤشر_محرف_متغير_إل_إل_في_إم;
    لو (تحقق_وحدة_إل_إل_في_إم((*الحالة).الوحدة, &متغير رسالة) != 0) {
        دع النص: متجه غ8 = انسخ_رسالة_سي_لإل_إل_في_إم(رسالة);
        حرر_رسالة_إل_إل_في_إم(رسالة);
        أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.تحقق_إل_إل_في_إم_فشل(النص));
    };
    طابق المستوى مع
    | مستوى_تحسين_مزود_إل_إل_في_إم.بلا -> { أرجع اختيار.لا_شيء(); }
    | _ -> { };
    دع الخط_الخام: متجه غ8 = اسم_خط_تمريرات_إل_إل_في_إم(المستوى);
    دع الخط: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الخط_الخام);
    دع الخطأ: مرجع_خطأ_إل_إل_في_إم = شغل_تمريرات_إل_إل_في_إم(
        (*الحالة).الوحدة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الخط),
        (*الحالة).آلة_الهدف
    );
    // مرجع خطأ الواجهة الخارجية يكون صفرا عند النجاح؛ يبقى فحصه محصورا في حد المزود.
    لو ((الخطأ مثل غير_موقع) != 0) {
        دع رسالة_خطأ: مؤشر_محرف_متغير_إل_إل_في_إم = رسالة_خطأ_إل_إل_في_إم(الخطأ);
        دع النص: متجه غ8 = انسخ_رسالة_سي_لإل_إل_في_إم(رسالة_خطأ);
        حرر_رسالة_خطأ_إل_إل_في_إم(رسالة_خطأ);
        أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.تحسين_إل_إل_في_إم_فشل(النص));
    };
    // Verify the optimized module as a distinct correctness boundary.
    لو (تحقق_وحدة_إل_إل_في_إم((*الحالة).الوحدة, &متغير رسالة) != 0) {
        دع النص: متجه غ8 = انسخ_رسالة_سي_لإل_إل_في_إم(رسالة);
        حرر_رسالة_إل_إل_في_إم(رسالة);
        أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.تحقق_إل_إل_في_إم_فشل(النص));
    };
    أرجع اختيار.لا_شيء();
}
