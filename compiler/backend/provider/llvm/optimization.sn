استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.wide_division;
استورد compiler.backend.provider.llvm.ffi.passes;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.provider.llvm.ffi.debuginfo;
استورد std.text.from_bytes;
استورد std.env.system;
استورد compiler.backend.target.target_model;

عرف اسم_خط_تمريرات_إل_إل_في_إم(المستوى: مستوى_تحسين_مزود_إل_إل_في_إم): متجه ط8 {
    طابق المستوى مع
    | مستوى_تحسين_مزود_إل_إل_في_إم.بلا -> { دع ن: متجه ط8 = []; أرجع ن; }
    | مستوى_تحسين_مزود_إل_إل_في_إم.منخفض -> {
        دع ن: متجه ط8 = بايتات_من_نص(«default<O1>»);
        أرجع ن;
    }
    | مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي -> {
        دع ن: متجه ط8 = بايتات_من_نص(«default<O2>»);
        أرجع ن;
    }
    | مستوى_تحسين_مزود_إل_إل_في_إم.عال -> {
        دع ن: متجه ط8 = بايتات_من_نص(«default<O3>»);
        أرجع ن;
    };
}

// Every function SultanC defines is freestanding ("no-builtins", as clang
// -ffreestanding / -fno-builtin): SultanC executables link no C library, so
// LLVM must not turn copy and fill loops into memcpy/memset calls
// (LoopIdiomRecognize, MemCpyOpt) or otherwise call a libc function the code
// never named. The memory intrinsics SultanC emits itself stay inline
// (llvm.memcpy.inline).
عرف علّم_دوال_مستقلة_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم): فراغ {
    دع المفتاح_خام: متجه ط8 = بايتات_من_نص(«no-builtins»);
    دع المفتاح: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&المفتاح_خام);
    دع القيمة: متغير متجه ط8 = [0];
    دع الصفة: مرجع_صفة_إل_إل_في_إم = LLVMCreateStringAttribute(
        (*الحالة).السياق,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير المفتاح), (الطول(المفتاح_خام) مثل طبيعي) مثل ط32,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير القيمة), 0
    );
    دع الدالة: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetFirstFunction((*الحالة).الوحدة);
    طالما (الدالة != الفارغ) {
        إذا (LLVMIsDeclaration(الدالة) == 0) {
            LLVMAddAttributeAtIndex(الدالة, 4294967295, الصفة);
        };
        الدالة := LLVMGetNextFunction(الدالة);
    }
}

// Every defined function carries asynchronous unwind tables ("uwtable",
// as clang's -funwind-tables / -fasynchronous-unwind-tables): LLVM then emits
// call-frame information (.eh_frame on ELF, compact unwind and .eh_frame on
// Mach-O, .pdata/.xdata on Windows), which debuggers read to walk SultanC
// frames and find a caller's variables. Only for targets with an operating
// system: bare-metal images (Cortex-M) and WebAssembly have no unwinder, and
// their linker scripts place no unwind sections.
عام عرف علّم_جداول_فك_المكدس_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم, الهدف: &واصف_هدف): فراغ {
    دع له_نظام: متغير منطقي = خطأ;
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.ماك_أو_إس -> { له_نظام := صواب; }
    | هوية_منصة.آي_أو_إس -> { له_نظام := صواب; }
    | هوية_منصة.لينكس -> { له_نظام := صواب; }
    | هوية_منصة.ويندوز -> { له_نظام := صواب; }
    | هوية_منصة.أندرويد -> { له_نظام := صواب; }
    | هوية_منصة.فري_بي_إس_دي -> { له_نظام := صواب; }
    | _ -> { };
    إذا (!له_نظام) { أرجع; };
    دع الاسم_خام: متجه ط8 = بايتات_من_نص(«uwtable»);
    دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_خام);
    دع المعرف: ط32 = LLVMGetEnumAttributeKindForName(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), الطول(الاسم_خام) مثل طبيعي);
    // UWTableKind::Async.
    دع الصفة: مرجع_صفة_إل_إل_في_إم = LLVMCreateEnumAttribute((*الحالة).السياق, المعرف, 2);
    دع الدالة: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetFirstFunction((*الحالة).الوحدة);
    طالما (الدالة != الفارغ) {
        إذا (LLVMIsDeclaration(الدالة) == 0) {
            LLVMAddAttributeAtIndex(الدالة, 4294967295, الصفة);
        };
        الدالة := LLVMGetNextFunction(الدالة);
    }
}

عرف معرف_جوهر_بالاسم_إل_إل_في_إم(الاسم: نص): ط32 {
    دع الخام: متجه ط8 = بايتات_من_نص(الاسم);
    دع الاسم_سي: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الخام);
    أرجع معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم_سي), الطول(الخام) مثل طبيعي);
}

// After the pipeline, a memcpy or memset of constant length may be left
// that SROA split from SultanC's llvm.memcpy.inline. Lowering such a call
// on a target with a small inline-store limit (RISC-V, MIPS, SPARC, ARMv7)
// would call libc's memcpy/memset; its .inline form (same operands) is
// always expanded in place, as SultanC's own aggregate copies are.
//
// MemCpyOpt also turns a fixed-size copy whose ends it cannot prove apart
// into llvm.memmove, which has no .inline form and is lowered to a call of
// libc's memmove. Such a call is replaced by two inline copies through a
// stack temporary of the same size (allocated in the entry block): the
// source is read whole before the destination is written, as memmove does.
عرف محاذاة_معامل_نداء_إل_إل_في_إم(النداء: مرجع_قيمة_إل_إل_في_إم, الفهرس: ط32, معرف_المحاذاة: ط32): ط32 {
    دع الصفة: مرجع_صفة_إل_إل_في_إم = LLVMGetCallSiteEnumAttribute(النداء, الفهرس, معرف_المحاذاة);
    إذا (الصفة == الفارغ) { أرجع 1; };
    دع القيمة: ط64 = LLVMGetEnumAttributeValue(الصفة);
    إذا (القيمة == 0 || القيمة > 4096) { أرجع 1; };
    أرجع القيمة مثل ط32;
}

عرف ابن_نسخ_مضمن_بمحاذاة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الباني: مرجع_بان_إل_إل_في_إم,
    الجوهر: مرجع_قيمة_إل_إل_في_إم,
    الوجهة: مرجع_قيمة_إل_إل_في_إم,
    محاذاة_الوجهة: ط32,
    المصدر: مرجع_قيمة_إل_إل_في_إم,
    محاذاة_المصدر: ط32,
    الطول_: مرجع_قيمة_إل_إل_في_إم,
    التطاير: مرجع_قيمة_إل_إل_في_إم,
    معرف_المحاذاة: ط32,
    الموضع: مرجع_بيانات_وصفية_إل_إل_في_إم
): فراغ {
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الوجهة, المصدر, الطول_, التطاير];
    دع فارغ: متغير متجه ط8 = [0];
    دع النداء: مرجع_قيمة_إل_إل_في_إم = LLVMBuildCall2(
        الباني, LLVMGlobalGetValueType(الجوهر), الجوهر, &متغير الحجج[0], 4,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ)
    );
    LLVMAddCallSiteAttribute(النداء, 1,
        LLVMCreateEnumAttribute((*الحالة).السياق, معرف_المحاذاة, محاذاة_الوجهة مثل ط64));
    LLVMAddCallSiteAttribute(النداء, 2,
        LLVMCreateEnumAttribute((*الحالة).السياق, معرف_المحاذاة, محاذاة_المصدر مثل ط64));
    إذا (الموضع != الفارغ) { LLVMInstructionSetDebugLoc(النداء, الموضع); };
}

عرف بدل_نقل_ذاكرة_ثابت_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    التعليمة: مرجع_قيمة_إل_إل_في_إم,
    نسخ_مضمن: ط32
): فراغ {
    دع الطول_: مرجع_قيمة_إل_إل_في_إم = LLVMGetOperand(التعليمة, 2);
    دع العدد: ط64 = LLVMConstIntGetZExtValue(الطول_);
    إذا (العدد == 0) { LLVMInstructionEraseFromParent(التعليمة); أرجع; };
    دع الوجهة: مرجع_قيمة_إل_إل_في_إم = LLVMGetOperand(التعليمة, 0);
    دع المصدر: مرجع_قيمة_إل_إل_في_إم = LLVMGetOperand(التعليمة, 1);
    دع التطاير: مرجع_قيمة_إل_إل_في_إم = LLVMGetOperand(التعليمة, 3);
    دع اسم_المحاذاة: متغير متجه ط8 = [97, 108, 105, 103, 110, 0];
    دع معرف_المحاذاة: ط32 = LLVMGetEnumAttributeKindForName(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_المحاذاة), 5);
    دع محاذاة_الوجهة: ط32 = محاذاة_معامل_نداء_إل_إل_في_إم(التعليمة, 1, معرف_المحاذاة);
    دع محاذاة_المصدر: ط32 = محاذاة_معامل_نداء_إل_إل_في_إم(التعليمة, 2, معرف_المحاذاة);
    دع الموضع: مرجع_بيانات_وصفية_إل_إل_في_إم = LLVMInstructionGetDebugLoc(التعليمة);
    دع الباني: مرجع_بان_إل_إل_في_إم = LLVMCreateBuilderInContext((*الحالة).السياق);
    دع الدخول: مرجع_كتلة_إل_إل_في_إم = LLVMGetEntryBasicBlock(الدالة);
    LLVMPositionBuilderBefore(الباني, LLVMGetFirstInstruction(الدخول));
    دع فارغ: متغير متجه ط8 = [0];
    دع المؤقت_الخاص: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAlloca(
        الباني, LLVMArrayType2(LLVMInt8TypeInContext((*الحالة).السياق), العدد),
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ)
    );
    LLVMSetAlignment(المؤقت_الخاص, 16);
    // AMDGPU stack slots are private-address-space pointers (values.sn).
    دع المؤقت: متغير مرجع_قيمة_إل_إل_في_إم = المؤقت_الخاص;
    إذا (LLVMGetPointerAddressSpace(LLVMTypeOf(المؤقت_الخاص)) != 0) {
        المؤقت := LLVMBuildAddrSpaceCast(الباني, المؤقت_الخاص, LLVMPointerTypeInContext((*الحالة).السياق, 0),
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    };
    LLVMPositionBuilderBefore(الباني, التعليمة);
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [
        نوع_قيمة_إل_إل_في_إم(الوجهة), نوع_قيمة_إل_إل_في_إم(المصدر), نوع_قيمة_إل_إل_في_إم(الطول_)
    ];
    دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم((*الحالة).الوحدة, نسخ_مضمن, &متغير الأنواع[0], 3);
    ابن_نسخ_مضمن_بمحاذاة_إل_إل_في_إم(الحالة, الباني, الجوهر, المؤقت, 16, المصدر, محاذاة_المصدر,
        الطول_, التطاير, معرف_المحاذاة, الموضع);
    ابن_نسخ_مضمن_بمحاذاة_إل_إل_في_إم(الحالة, الباني, الجوهر, الوجهة, محاذاة_الوجهة, المؤقت, 16,
        الطول_, التطاير, معرف_المحاذاة, الموضع);
    LLVMInstructionEraseFromParent(التعليمة);
    LLVMDisposeBuilder(الباني);
}

عرف ضمن_نسخ_مضمن_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم): فراغ {
    دع نقل: ط32 = معرف_جوهر_بالاسم_إل_إل_في_إم(«llvm.memmove»);
    دع نسخ: ط32 = معرف_جوهر_بالاسم_إل_إل_في_إم(«llvm.memcpy»);
    دع ملء: ط32 = معرف_جوهر_بالاسم_إل_إل_في_إم(«llvm.memset»);
    دع نسخ_مضمن: ط32 = معرف_جوهر_بالاسم_إل_إل_في_إم(«llvm.memcpy.inline»);
    دع ملء_مضمن: ط32 = معرف_جوهر_بالاسم_إل_إل_في_إم(«llvm.memset.inline»);
    دع الدالة: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetFirstFunction((*الحالة).الوحدة);
    طالما (الدالة != الفارغ) {
        دع الكتلة: متغير مرجع_كتلة_إل_إل_في_إم = LLVMGetFirstBasicBlock(الدالة);
        طالما (الكتلة != الفارغ) {
            دع التعليمة: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetFirstInstruction(الكتلة);
            طالما (التعليمة != الفارغ) {
                // The call may be replaced and erased below.
                دع التالية: مرجع_قيمة_إل_إل_في_إم = LLVMGetNextInstruction(التعليمة);
                إذا (LLVMIsACallInst(التعليمة) != الفارغ) {
                    دع المستدعى: مرجع_قيمة_إل_إل_في_إم = LLVMGetCalledValue(التعليمة);
                    إذا (المستدعى != الفارغ && LLVMIsAFunction(المستدعى) != الفارغ) {
                        دع الهوية: ط32 = LLVMGetIntrinsicID(المستدعى);
                        إذا (الهوية == نقل && الهوية != 0 && نسخ_مضمن != 0
                            && LLVMIsAConstantInt(LLVMGetOperand(التعليمة, 2)) != الفارغ) {
                            بدل_نقل_ذاكرة_ثابت_إل_إل_في_إم(الحالة, الدالة, التعليمة, نسخ_مضمن);
                        } وإلا إذا ((الهوية == نسخ || الهوية == ملء) && الهوية != 0) {
                            دع الطول_: مرجع_قيمة_إل_إل_في_إم = LLVMGetOperand(التعليمة, 2);
                            إذا (LLVMIsAConstantInt(الطول_) != الفارغ) {
                                دع الوجهة: مرجع_قيمة_إل_إل_في_إم = LLVMGetOperand(التعليمة, 0);
                                دع الثاني: مرجع_قيمة_إل_إل_في_إم = LLVMGetOperand(التعليمة, 1);
                                دع الجديد: متغير مرجع_قيمة_إل_إل_في_إم = الفارغ;
                                إذا (الهوية == نسخ) {
                                    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
                                    ألحق(الأنواع, نوع_قيمة_إل_إل_في_إم(الوجهة));
                                    ألحق(الأنواع, نوع_قيمة_إل_إل_في_إم(الثاني));
                                    ألحق(الأنواع, نوع_قيمة_إل_إل_في_إم(الطول_));
                                    الجديد := تصريح_جوهر_إل_إل_في_إم((*الحالة).الوحدة, نسخ_مضمن, &متغير الأنواع[0], 3);
                                } وإلا {
                                    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
                                    ألحق(الأنواع, نوع_قيمة_إل_إل_في_إم(الوجهة));
                                    ألحق(الأنواع, نوع_قيمة_إل_إل_في_إم(الطول_));
                                    الجديد := تصريح_جوهر_إل_إل_في_إم((*الحالة).الوحدة, ملء_مضمن, &متغير الأنواع[0], 2);
                                };
                                دع العدد: ص32 = LLVMGetNumOperands(التعليمة);
                                إذا (العدد > 0) {
                                    LLVMSetOperand(التعليمة, (العدد - 1) مثل ط32, الجديد);
                                };
                            };
                        };
                    };
                };
                التعليمة := التالية;
            }
            الكتلة := LLVMGetNextBasicBlock(الكتلة);
        }
        الدالة := LLVMGetNextFunction(الدالة);
    }
}

عام عرف تحقق_وحسن_وحدة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المستوى: مستوى_تحسين_مزود_إل_إل_في_إم
): اختياري فشل_مزود_إل_إل_في_إم {
    دع حارس_مؤشر: متغير ط8 = 0;
    دع رسالة: متغير مؤشر_محرف_متغير_إل_إل_في_إم = &متغير حارس_مؤشر;
    إذا (تحقق_وحدة_إل_إل_في_إم((*الحالة).الوحدة, &متغير رسالة) != 0) {
        دع النص: متجه ط8 = انسخ_رسالة_سي_لإل_إل_في_إم(رسالة);
        حرر_رسالة_إل_إل_في_إم(رسالة);
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.تحقق_إل_إل_في_إم_فشل(النص));
    };
    طابق المستوى مع
    | مستوى_تحسين_مزود_إل_إل_في_إم.بلا -> { أرجع اختياري.لا_شيء(); }
    | _ -> { };
    علّم_دوال_مستقلة_إل_إل_في_إم(الحالة);
    دع الخط_الخام: متجه ط8 = اسم_خط_تمريرات_إل_إل_في_إم(المستوى);
    دع الخط: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الخط_الخام);
    دع الخطأ: مرجع_خطأ_إل_إل_في_إم = شغل_تمريرات_إل_إل_في_إم(
        (*الحالة).الوحدة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الخط),
        (*الحالة).آلة_الهدف,
        تحقق_بعد_كل_تمريرة_مطلوب_إل_إل_في_إم()
    );
    // LLVMGetErrorMessage consumes both failure and success handles; success yields an empty message.
    دع رسالة_خطأ: مؤشر_محرف_متغير_إل_إل_في_إم = رسالة_خطأ_إل_إل_في_إم(الخطأ);
    دع نص_الخطأ: متجه ط8 = انسخ_رسالة_سي_لإل_إل_في_إم(رسالة_خطأ);
    حرر_رسالة_خطأ_إل_إل_في_إم(رسالة_خطأ);
    إذا ((الطول(نص_الخطأ) مثل طبيعي) != 0) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.تحسين_إل_إل_في_إم_فشل(نص_الخطأ));
    };
    ضمن_نسخ_مضمن_إل_إل_في_إم(الحالة);
    وسع_ضرب_التجاوز_64_إل_إل_في_إم(الحالة);
    // Verify the optimized module as a distinct correctness boundary.
    إذا (تحقق_وحدة_إل_إل_في_إم((*الحالة).الوحدة, &متغير رسالة) != 0) {
        دع النص: متجه ط8 = انسخ_رسالة_سي_لإل_إل_في_إم(رسالة);
        حرر_رسالة_إل_إل_في_إم(رسالة);
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.تحقق_إل_إل_في_إم_فشل(النص));
    };
    أرجع اختياري.لا_شيء();
}

// SULTANC_LLVM_VERIFY_EACH=1 turns on LLVM's per-pass verifier, for
// debugging the compiler's IR. Off by default (clang and rustc verify once).
عرف تحقق_بعد_كل_تمريرة_مطلوب_إل_إل_في_إم(): منطقي {
    دع الاسم: نص = «SULTANC_LLVM_VERIFY_EACH»;
    طابق متغير_بيئة_النظام(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        أرجع (الطول(القيمة) مثل طبيعي) == 1 && القيمة[0] == (0x31 مثل ط8);
    }
    | _ -> { أرجع خطأ; };
}
