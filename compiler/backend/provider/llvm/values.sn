استورد compiler.backend.provider.llvm.model;
استورد compiler.backend.provider.llvm.types;
استورد compiler.backend.provider.llvm.diagnostics;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.backend.provider.llvm.ffi.types;
استورد compiler.backend.target.selection_query_context;
استورد compiler.backend.layout.layout_model;
استورد compiler.msir.msir_consumer;
استورد compiler.frontend.types.type_identity;
استورد compiler.msir.identifiers;
استورد compiler.backend.target.target_model;
استورد std.text.from_bytes;

عام نوع نتيجة_قيمة_إل_إل_في_إم =
    | نجح بنوع تمثيل_قيمة_إل_إل_في_إم
    | خطأ بنوع فشل_مزود_إل_إل_في_إم
;

عام عرف ضع_قيمة_إل_إل_في_إم(
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المعرف: معرف_قيمة_مسير,
    القيمة: تمثيل_قيمة_إل_إل_في_إم
): فراغ {
    بينما ((الطول((*الدالة).القيم) مثل غير_موقع) <= المعرف.القيمة) {
        ألحق((*الدالة).القيم, اختيار.لا_شيء());
    }
    (*الدالة).القيم[المعرف.القيمة] := اختيار.بعض(القيمة);
}

عام عرف قيمة_إل_إل_في_إم(
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المعرف: معرف_قيمة_مسير
): نتيجة_قيمة_إل_إل_في_إم {
    لو (المعرف.القيمة >= (الطول((*الدالة).القيم) مثل غير_موقع)) {
        أرجع نتيجة_قيمة_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المعرف));
    };
    طابق (*الدالة).القيم[المعرف.القيمة] مع
    | اختيار.بعض(ق) -> { أرجع نتيجة_قيمة_إل_إل_في_إم.نجح(ق); }
    | اختيار.لا_شيء -> { أرجع نتيجة_قيمة_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المعرف)); };
}

عام عرف سلمية_إل_إل_في_إم(
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المعرف: معرف_قيمة_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع
    | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> {
        طابق ق مع
        | تمثيل_قيمة_إل_إل_في_إم.سلمية(س) -> { أرجع نتيجة.نجح(س); }
        | تمثيل_قيمة_إل_إل_في_إم.عنوان(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_متوقعة(المعرف)); };
    };
}

عام عرف عنوان_إل_إل_في_إم(
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المعرف: معرف_قيمة_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع
    | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> {
        طابق ق مع
        | تمثيل_قيمة_إل_إل_في_إم.عنوان(ع) -> { أرجع نتيجة.نجح(ع); }
        | تمثيل_قيمة_إل_إل_في_إم.سلمية(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.مكان_متوقع(المعرف)); };
    };
}

عام عرف ابن_عنوان_إزاحة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الأصل: مرجع_قيمة_إل_إل_في_إم,
    الإزاحة: غير_موقع
): مرجع_قيمة_إل_إل_في_إم {
    دع اسم: متغير متجه غ8 = [0];
    دع نوع_بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
    دع نوع_فهرس: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    دع فهرس: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_فهرس, الإزاحة مثل غ64, خطأ);
    دع الفهارس: متغير متجه مرجع_قيمة_إل_إل_في_إم = [فهرس];
    أرجع ابن_فهرسة_إل_إل_في_إم((*الحالة).الباني, نوع_بايت, الأصل, &متغير الفهارس[0], 1,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
}

عام عرف حجز_تمثيل_نوع_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    القيد: &قيد_نوع_إل_إل_في_إم,
    المحاذاة: غير_موقع
): مرجع_قيمة_إل_إل_في_إم {
    دع اسم: متغير متجه غ8 = [0];
    دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_حجز_إل_إل_في_إم((*الحالة).باني_الحجز, (*القيد).التمثيل,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ضع_محاذاة_قيمة_إل_إل_في_إم(المكان, المحاذاة مثل غ32);
    أرجع المكان;
}

// Fixed-size copies use llvm.memcpy.inline, which LLVM expands in place for
// every size and never lowers to a call of the C library's memcpy. SultanC
// executables link no C library, so the plain llvm.memcpy intrinsic, which
// LLVM turns into a memcpy call above its inline threshold (for example the
// copy of a TLS connection state), failed to link. Alignments are kept as
// call-site parameter attributes, as LLVMBuildMemCpy records them.
عام عرف ابن_نسخ_ذاكرة_ثابتة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الوجهة: مرجع_قيمة_إل_إل_في_إم,
    محاذاة_الوجهة: غ32,
    المصدر: مرجع_قيمة_إل_إل_في_إم,
    محاذاة_المصدر: غ32,
    الحجم: غ64
): فراغ {
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع نوع_الحجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    دع نوع_منطق: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 1);
    دع اسم_الجوهر: متغير متجه غ8 = بايتات_منتهية_بصفر_من_نص(«llvm.memcpy.inline»);
    دع الهوية: غ32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الجوهر), 18);
    دع أنواع_التحميل: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_مؤشر, نوع_مؤشر, نوع_الحجم];
    دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم(
        (*الحالة).الوحدة, الهوية, &متغير أنواع_التحميل[0], 3
    );
    دع المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_مؤشر, نوع_مؤشر, نوع_الحجم, نوع_منطق];
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(
        نوع_فراغ_إل_إل_في_إم((*الحالة).السياق), &متغير المعاملات[0], 4
    );
    دع قيمة_الحجم: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_الحجم, الحجم, خطأ);
    دع غير_متطاير: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_منطق, 0, خطأ);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الوجهة, المصدر, قيمة_الحجم, غير_متطاير];
    دع فارغ: متغير متجه غ8 = [0];
    دع النداء: مرجع_قيمة_إل_إل_في_إم = ابن_نداء_إل_إل_في_إم(
        (*الحالة).الباني, نوع_الدالة, الجوهر, &متغير الحجج[0], 4,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ)
    );
    دع اسم_المحاذاة: متغير متجه غ8 = بايتات_منتهية_بصفر_من_نص(«align»);
    دع معرف_المحاذاة: غ32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_المحاذاة), 5);
    لو (محاذاة_الوجهة > 0) {
        دع صفة_الوجهة: مرجع_صفة_إل_إل_في_إم = أنشئ_صفة_تعداد_إل_إل_في_إم(
            (*الحالة).السياق, معرف_المحاذاة, محاذاة_الوجهة مثل غ64
        );
        أضف_صفة_معامل_نداء_إل_إل_في_إم(النداء, 1, صفة_الوجهة);
    };
    لو (محاذاة_المصدر > 0) {
        دع صفة_المصدر: مرجع_صفة_إل_إل_في_إم = أنشئ_صفة_تعداد_إل_إل_في_إم(
            (*الحالة).السياق, معرف_المحاذاة, محاذاة_المصدر مثل غ64
        );
        أضف_صفة_معامل_نداء_إل_إل_في_إم(النداء, 2, صفة_المصدر);
    };
}

عام عرف انسخ_قيمة_تجميعية_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    المصدر: مرجع_قيمة_إل_إل_في_إم,
    القيد: &قيد_نوع_إل_إل_في_إم,
    التخطيط: &واصف_تخطيط
): مرجع_قيمة_إل_إل_في_إم {
    دع الوجهة: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, القيد, (*التخطيط).المحاذاة);
    ابن_نسخ_ذاكرة_ثابتة_إل_إل_في_إم(الحالة, الوجهة, (*التخطيط).المحاذاة مثل غ32, المصدر,
        (*التخطيط).المحاذاة مثل غ32, (*التخطيط).الحجم مثل غ64);
    أرجع الوجهة;
}

عام عرف حمّل_من_مكان_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    المكان: مرجع_قيمة_إل_إل_في_إم
): نتيجة_قيمة_إل_إل_في_إم {
    دع القيد: قيد_نوع_إل_إل_في_إم;
    طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة_قيمة_إل_إل_في_إم.خطأ(خ); }
    | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
    لو (القيد.تجميعي) {
        طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_تخطيط.مكتمل(ت) -> {
            دع نسخة: مرجع_قيمة_إل_إل_في_إم = انسخ_قيمة_تجميعية_إل_إل_في_إم(الحالة, المكان, &القيد, &ت);
            أرجع نتيجة_قيمة_إل_إل_في_إم.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(نسخة));
        }
        | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة_قيمة_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(النوع)); }
        | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة_قيمة_إل_إل_في_إم.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(النوع)); };
    };
    دع اسم: متغير متجه غ8 = [0];
    دع القيمة: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, القيد.التمثيل, المكان,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    أرجع نتيجة_قيمة_إل_إل_في_إم.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(القيمة));
}

عام عرف خزّن_في_مكان_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    المكان: مرجع_قيمة_إل_إل_في_إم,
    القيمة: &تمثيل_قيمة_إل_إل_في_إم
): اختيار فشل_مزود_إل_إل_في_إم {
    دع القيد: قيد_نوع_إل_إل_في_إم;
    طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
    | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
    لو (القيد.تجميعي) {
        دع المصدر: مرجع_قيمة_إل_إل_في_إم;
        طابق *القيمة مع
        | تمثيل_قيمة_إل_إل_في_إم.عنوان(ع) -> { المصدر := ع; }
        | _ -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
        طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_تخطيط.مكتمل(ت) -> {
            ابن_نسخ_ذاكرة_ثابتة_إل_إل_في_إم(الحالة, المكان, ت.المحاذاة مثل غ32, المصدر, ت.المحاذاة مثل غ32,
                ت.الحجم مثل غ64);
            أرجع اختيار.لا_شيء();
        }
        | نتيجة_تخطيط.مؤجل(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(النوع)); }
        | نتيجة_تخطيط.مرفوض(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(النوع)); };
    };
    دع السلمية: مرجع_قيمة_إل_إل_في_إم;
    طابق *القيمة مع
    | تمثيل_قيمة_إل_إل_في_إم.سلمية(س) -> { السلمية := س; }
    | _ -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, السلمية, المكان);
    أرجع اختيار.لا_شيء();
}
