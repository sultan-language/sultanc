// هذا الملف هو المالك الوحيد لتحويل MSIR المتحقق إلى LLVM IR.
// لا يقرأ AST ولا يعيد بناء Type/Layout/ABI؛ كل الحقائق الفيزيائية تسأل من ملاكها المقننين.

نوع وصف_حقول_تسلسل_إل_إل_في_إم = {
    البيانات: موضع_جزء_تخطيط,
    الطول: موضع_جزء_تخطيط,
    السعة: موضع_جزء_تخطيط
};

عرف اسم_فارغ_إل_إل_في_إم(): متجه ط8 { دع ن: متجه ط8 = [0]; أرجع ن; }

عرف تخطيط_نوع_إل_إل_في_إم(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة واصف_تخطيط, فشل_مزود_إل_إل_في_إم {
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(ت) -> { أرجع نتيجة.نجح(ت); }
    | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(النوع)); }
    | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(النوع)); };
}

عرف تخطيط_قيمة_إل_إل_في_إم(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير
): نتيجة واصف_تخطيط, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(القيمة)); }
    | اختياري.موجود(ن) -> { النوع := ن; };
    أرجع تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع);
}

عرف جزء_تخطيط_إل_إل_في_إم(التخطيط: &واصف_تخطيط, الفهرس: طبيعي): اختياري موضع_جزء_تخطيط {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        إذا (الفهرس < (الطول(الأجزاء) مثل طبيعي)) { أرجع اختياري.موجود(الأجزاء[الفهرس]); };
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        إذا (الفهرس < (الطول(الأجزاء) مثل طبيعي)) { أرجع اختياري.موجود(الأجزاء[الفهرس]); };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

عرف تعداد_تخطيط_إل_إل_في_إم(التخطيط: &واصف_تخطيط): اختياري تخطيط_تعداد {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.تعداد(ت) -> { أرجع اختياري.موجود(انسخ_مملوكا_تخطيط_تعداد(&ت)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف كتلة_إل_إل_في_إم(الدالة: &حالة_دالة_إل_إل_في_إم, المعرف: معرف_كتلة_مسير): نتيجة مرجع_كتلة_إل_إل_في_إم,
    فشل_مزود_إل_إل_في_إم {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(المعرف)); };
    أرجع نتيجة.نجح((*الدالة).الكتل[المعرف.القيمة]);
}

عرف ابن_عنوان_عنصر_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الأصل: مرجع_قيمة_إل_إل_في_إم,
    الفهرس: مرجع_قيمة_إل_إل_في_إم,
    حجم_العنصر: طبيعي
): مرجع_قيمة_إل_إل_في_إم {
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع نوع_الفهرس: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(الفهرس);
    دع الحجم: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_الفهرس, حجم_العنصر مثل ط64, خطأ);
    دع الإزاحة: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم((*الحالة).الباني, الفهرس, الحجم,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع الفهارس: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الإزاحة];
    دع بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
    أرجع ابن_فهرسة_إل_إل_في_إم((*الحالة).الباني, بايت, الأصل, &متغير الفهارس[0], 1,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
}

عرف ابن_فخ_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم): فراغ {
    دع الاسم: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«llvm.trap»);
    دع الهوية: ط32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), 9);
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    ألحق(الأنواع, نوع_فراغ_إل_إل_في_إم((*الحالة).السياق));
    دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم((*الحالة).الوحدة, الهوية, &متغير الأنواع[0], 0);
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_فراغ_إل_إل_في_إم((*الحالة).السياق), &متغير
        الأنواع[0], 0);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع فارغ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, الجوهر, &متغير الأنواع[0], 0,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_غير_قابل_للوصول_إل_إل_في_إم((*الحالة).الباني);
}

عرف ابن_فخ_إذا_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    الشرط: مرجع_قيمة_إل_إل_في_إم
): فراغ {
    دع اسم_فخ: متغير متجه ط8 = [0];
    دع اسم_استمرار: متغير متجه ط8 = [0];
    دع كتلة_الفخ: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, الدالة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فخ));
    دع كتلة_الاستمرار: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, الدالة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_استمرار));
    ابن_فرع_شرطي_إل_إل_في_إم((*الحالة).الباني, الشرط, كتلة_الفخ, كتلة_الاستمرار);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_الفخ);
    ابن_فخ_إل_إل_في_إم(الحالة);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_الاستمرار);
}

// Allocation services can return null. Branch to the existing compiler
// trap before storing through a freshly allocated pointer. This is separate
// from a source-level nullable raw pointer and does not create provenance.
عرف تحقق_تخصيص_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المؤشر: مرجع_قيمة_إل_إل_في_إم
): فراغ {
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(نوع_قيمة_إل_إل_في_إم(المؤشر));
    دع فشل: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 32, المؤشر, صفر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, فشل);
}

عرف محمول_مقارنة_صحيح_إل_إل_في_إم(
    العملية: عملية_مقارنة_صحيح,
    موقع: منطقي
): محمول_مقارنة_صحيحة_إل_إل_في_إم {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> { أرجع 32; }
    | عملية_مقارنة_صحيح.لا_يساوي -> { أرجع 33; }
    | عملية_مقارنة_صحيح.أصغر -> { إذا (موقع) { أرجع 40; } أرجع 36; }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> { إذا (موقع) { أرجع 41; } أرجع 37; }
    | عملية_مقارنة_صحيح.أكبر -> { إذا (موقع) { أرجع 38; } أرجع 34; }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> { إذا (موقع) { أرجع 39; } أرجع 35; };
}

عرف محمول_مقارنة_عشري_إل_إل_في_إم(العملية: عملية_مقارنة_عشري): محمول_مقارنة_عائمة_إل_إل_في_إم {
    طابق العملية مع
    | عملية_مقارنة_عشري.يساوي -> { أرجع 1; }
    | عملية_مقارنة_عشري.لا_يساوي -> { أرجع 14; }
    | عملية_مقارنة_عشري.أصغر -> { أرجع 4; }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { أرجع 5; }
    | عملية_مقارنة_عشري.أكبر -> { أرجع 2; }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { أرجع 3; };
}

عرف ابن_حساب_صحيح_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الحساب: &حساب_صحيح_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع أ: مرجع_قيمة_إل_إل_في_إم; دع ب: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { أ := ق; };
    طابق سلمية_إل_إل_في_إم(الدالة, (*الحساب).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { ب := ق; };
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, (*الحساب).اليسار) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*الحساب).اليسار)); } | اختياري.موجود(ن) -> { النوع := ن; };
    // LLVM integer arithmetic follows the lowered SSA operand width.
    دع البتات: طبيعي = LLVMGetIntTypeWidth(نوع_قيمة_إل_إل_في_إم(أ)) مثل طبيعي;
    دع موقع: متغير منطقي = خطأ; طابق صنف_إشارة_عدد_للاختيار(&(*الحقائق).الأنواع, النوع) مع |
        اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع) -> { موقع := صواب; } | اختياري.موجود(_) -> { } | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    طابق (*الحساب).العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع ابن_حساب_بتجاوز_إل_إل_في_إم(الحالة, الدالة, أ, ب, النوع, البتات, موقع, 0); }
    | عملية_حساب_صحيح.طرح -> { أرجع ابن_حساب_بتجاوز_إل_إل_في_إم(الحالة, الدالة, أ, ب, النوع, البتات, موقع, 1); }
    | عملية_حساب_صحيح.ضرب -> { أرجع ابن_حساب_بتجاوز_إل_إل_في_إم(الحالة, الدالة, أ, ب, النوع, البتات, موقع, 2); }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع نتيجة.نجح(ابن_أو_بتي_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع نتيجة.نجح(ابن_أو_حصري_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_صحيح.و_بتي -> { أرجع نتيجة.نجح(ابن_و_بتي_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع ابن_قسمة_أو_باقي_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, صواب,
        خطأ); }
    | عملية_حساب_صحيح.قسمة_طبيعية -> { أرجع ابن_قسمة_أو_باقي_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, خطأ,
        خطأ); }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع ابن_قسمة_أو_باقي_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, صواب,
        صواب); }
    | عملية_حساب_صحيح.باقي_طبيعي -> { أرجع ابن_قسمة_أو_باقي_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, خطأ,
        صواب); }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع ابن_إزاحة_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, موقع, 0); }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع ابن_إزاحة_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, موقع, 1); }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع ابن_إزاحة_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, صواب, 2);
        }
    // Wrapping forms: plain add/sub/mul/shl (no nsw/nuw, no overflow intrinsic);
    // the shift amount is below the width.
    | عملية_حساب_صحيح.جمع_ملتف -> { أرجع نتيجة.نجح(ابن_جمع_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_صحيح.طرح_ملتف -> { أرجع نتيجة.نجح(ابن_طرح_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_صحيح.ضرب_ملتف -> { أرجع نتيجة.نجح(ابن_ضرب_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { أرجع نتيجة.نجح(ابن_إزاحة_يسرى_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); };
}

عرف اسم_جوهر_تجاوز_إل_إل_في_إم(موقع: منطقي, العملية: طبيعي): متجه ط8 {
    إذا (موقع) {
        إذا (العملية == 0) { دع ن: متجه ط8 =
            بايتات_من_نص(«llvm.sadd.with.overflow»);
            أرجع ن; };
        إذا (العملية == 1) { دع ن: متجه ط8 =
            بايتات_من_نص(«llvm.ssub.with.overflow»);
            أرجع ن; };
        دع ن: متجه ط8 =
            بايتات_من_نص(«llvm.smul.with.overflow»);
            أرجع ن;
    };
    إذا (العملية == 0) { دع ن: متجه ط8 =
        بايتات_من_نص(«llvm.uadd.with.overflow»);
        أرجع ن; };
    إذا (العملية == 1) { دع ن: متجه ط8 =
        بايتات_من_نص(«llvm.usub.with.overflow»);
        أرجع ن; };
    دع ن: متجه ط8 =
        بايتات_من_نص(«llvm.umul.with.overflow»);
        أرجع ن;
}

// Checked multiplication without a double-width multiply: p = a * b wraps;
// it is exact iff a == 0 or p / a == b. Division is native on these targets.
// The divisor is made safe first: unsigned a == 0 -> 1; signed a in {0, -1}
// -> 1, because MIN / -1 itself traps. Signed a == -1 overflows exactly when
// b == MIN. Any overflow traps, like the intrinsic path.
عرف ابن_ضرب_بتجاوز_بالقسمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    البتات: طبيعي,
    موقع: منطقي
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, البتات مثل ط32);
    دع فارغ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, 0, خطأ);
    دع واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, 1, خطأ);
    دع الناتج: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم(الباني, أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    // ICmp predicates: EQ = 32, NE = 33.
    دع أ_صفر: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, أ, صفر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع أ_غير_صفر: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 33, أ, صفر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع تجاوز: متغير مرجع_قيمة_إل_إل_في_إم = أ_صفر;
    إذا (موقع) {
        دع سالب_واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, (~(0 مثل ط64)), صواب);
        دع مقدار_الإزاحة: ط64 = (البتات - 1) مثل ط64;
        دع أدنى: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, (1 مثل ط64) << مقدار_الإزاحة, خطأ);
        دع أ_سالب_واحد: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, أ, سالب_واحد,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع غير_آمن_للقسمة: مرجع_قيمة_إل_إل_في_إم = ابن_أو_بتي_إل_إل_في_إم(الباني, أ_صفر, أ_سالب_واحد,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع المقسوم_عليه: مرجع_قيمة_إل_إل_في_إم = ابن_اختيار_إل_إل_في_إم(الباني, غير_آمن_للقسمة, واحد, أ,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع الخارج: مرجع_قيمة_إل_إل_في_إم = ابن_قسمة_صحيحة_إل_إل_في_إم(الحالة, الناتج, المقسوم_عليه, صواب, خطأ);
        دع الخارج_مختلف: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 33, الخارج, ب,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع آمن: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, غير_آمن_للقسمة,
            ثابت_صحيح_إل_إل_في_إم(نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 1), 0, خطأ),
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع تجاوز_عام: مرجع_قيمة_إل_إل_في_إم = ابن_و_بتي_إل_إل_في_إم(الباني, آمن, الخارج_مختلف,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع ب_أدنى: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, ب, أدنى,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع تجاوز_سالب: مرجع_قيمة_إل_إل_في_إم = ابن_و_بتي_إل_إل_في_إم(الباني, أ_سالب_واحد, ب_أدنى,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        تجاوز := ابن_أو_بتي_إل_إل_في_إم(الباني, تجاوز_عام, تجاوز_سالب,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    } وإلا {
        دع المقسوم_عليه: مرجع_قيمة_إل_إل_في_إم = ابن_اختيار_إل_إل_في_إم(الباني, أ_صفر, واحد, أ,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع الخارج: مرجع_قيمة_إل_إل_في_إم = ابن_قسمة_صحيحة_إل_إل_في_إم(الحالة, الناتج, المقسوم_عليه, خطأ, خطأ);
        دع الخارج_مختلف: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 33, الخارج, ب,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        تجاوز := ابن_و_بتي_إل_إل_في_إم(الباني, أ_غير_صفر, الخارج_مختلف,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    };
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, تجاوز);
    أرجع نتيجة.نجح(الناتج);
}

// Checked 64-bit multiplication on targets without a 128-bit product
// (wide_division.sn ضرب_64_بالأنصاف_إل_إل_في_إم); any overflow traps.
عرف ابن_ضرب_64_بتجاوز_بالأنصاف_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    موقع: منطقي
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع الضرب: ضرب_مفحوص_إل_إل_في_إم = ضرب_64_بالأنصاف_إل_إل_في_إم(الحالة, أ, ب, موقع);
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, الضرب.التجاوز);
    أرجع نتيجة.نجح(الضرب.الناتج);
}

// Checked add/sub without overflow intrinsics. Unsigned: a + b overflows iff
// the sum is below a; a - b iff a < b. Signed: a + b iff a and b share a sign
// the sum lacks ((a ^ r) & (b ^ r) < 0); a - b iff a and b differ in sign and
// r differs from a ((a ^ b) & (a ^ r) < 0). Any overflow traps.
عرف ابن_جمع_أو_طرح_بتجاوز_يدويا_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    البتات: طبيعي,
    موقع: منطقي,
    العملية: طبيعي
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, البتات مثل ط32);
    دع فارغ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, 0, خطأ);
    دع الناتج: متغير مرجع_قيمة_إل_إل_في_إم = أ;
    إذا (العملية == 0) {
        الناتج := ابن_جمع_إل_إل_في_إم(الباني, أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    } وإلا {
        الناتج := ابن_طرح_إل_إل_في_إم(الباني, أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    };
    دع تجاوز: متغير مرجع_قيمة_إل_إل_في_إم = أ;
    إذا (موقع) {
        دع أ_ر: مرجع_قيمة_إل_إل_في_إم = ابن_أو_حصري_إل_إل_في_إم(الباني, أ, الناتج, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع الآخر: متغير مرجع_قيمة_إل_إل_في_إم = أ;
        إذا (العملية == 0) {
            الآخر := ابن_أو_حصري_إل_إل_في_إم(الباني, ب, الناتج, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        } وإلا {
            الآخر := ابن_أو_حصري_إل_إل_في_إم(الباني, أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        };
        دع المشترك: مرجع_قيمة_إل_إل_في_إم = ابن_و_بتي_إل_إل_في_إم(الباني, أ_ر, الآخر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        // ICmp SLT = 40.
        تجاوز := ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 40, المشترك, صفر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    } وإلا إذا (العملية == 0) {
        // ICmp ULT = 36.
        تجاوز := ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 36, الناتج, أ, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    } وإلا {
        تجاوز := ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 36, أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    };
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, تجاوز);
    أرجع نتيجة.نجح(الناتج);
}

عرف ابن_حساب_بتجاوز_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    النوع: معرف_نوع,
    البتات: طبيعي,
    موقع: منطقي,
    العملية: طبيعي
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    إذا (العملية == 2 && البتات == 64 && ((*الحالة).ضرب_التجاوز_بالقسمة || (*الحالة).جمع_التجاوز_يدويا)) {
        أرجع ابن_ضرب_64_بتجاوز_بالأنصاف_إل_إل_في_إم(الحالة, الدالة, أ, ب, موقع);
    };
    إذا (العملية == 2 && ((*الحالة).ضرب_التجاوز_بالقسمة || (*الحالة).جمع_التجاوز_يدويا)) {
        أرجع ابن_ضرب_بتجاوز_بالقسمة_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, موقع);
    };
    إذا (العملية < 2 && (*الحالة).جمع_التجاوز_يدويا) {
        أرجع ابن_جمع_أو_طرح_بتجاوز_يدويا_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, موقع, العملية);
    };
    دع نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, البتات مثل ط32);
    دع أعضاء: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_عدد];
    ألحق(أعضاء, نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 1));
    دع نوع_ناتج: مرجع_نوع_إل_إل_في_إم = نوع_بنية_إل_إل_في_إم((*الحالة).السياق, &متغير أعضاء[0], 2);
    دع اسم_الجوهر_خام: متجه ط8 = اسم_جوهر_تجاوز_إل_إل_في_إم(موقع, العملية);
    دع اسم_الجوهر: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_الجوهر_خام);
    دع الهوية: ط32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الجوهر), الطول(اسم_الجوهر_خام)
        مثل طبيعي);
    دع أنواع_التحميل: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_عدد];
    دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم((*الحالة).الوحدة, الهوية, &متغير أنواع_التحميل[0],
        1);
    دع معاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_عدد, نوع_عدد];
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_ناتج, &متغير معاملات[0], 2);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [أ, ب];
    دع فارغ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع النتيجة: مرجع_قيمة_إل_إل_في_إم = ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, الجوهر, &متغير
        الحجج[0], 2, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع القيمة: مرجع_قيمة_إل_إل_في_إم = ابن_استخراج_عنصر_بنية_إل_إل_في_إم((*الحالة).الباني, النتيجة, 0,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع تجاوز: مرجع_قيمة_إل_إل_في_إم = ابن_استخراج_عنصر_بنية_إل_إل_في_إم((*الحالة).الباني, النتيجة, 1,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, تجاوز);
    أرجع نتيجة.نجح(القيمة);
}

عرف ابن_قسمة_أو_باقي_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    البتات: طبيعي,
    موقع: منطقي,
    باقي: منطقي
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, البتات مثل ط32);
    دع صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, 0, خطأ);
    دع فارغ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع صفر_قسمة: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 32, ب, صفر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, صفر_قسمة);
    إذا (موقع) {
        دع مقدار_الإزاحة: ط64 = (البتات - 1) مثل ط64;
        دع أدنى: ط64 = (1 مثل ط64) << مقدار_الإزاحة;
        دع قيمة_أدنى: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, أدنى, خطأ);
        دع سالب_واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, (~(0 مثل ط64)), صواب);
        دع أ_أدنى: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 32, أ, قيمة_أدنى,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع ب_سالب: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 32, ب, سالب_واحد,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع الشرط: مرجع_قيمة_إل_إل_في_إم = ابن_و_بتي_إل_إل_في_إم((*الحالة).الباني, أ_أدنى, ب_سالب,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, الشرط);
    };
    أرجع نتيجة.نجح(ابن_قسمة_صحيحة_إل_إل_في_إم(الحالة, أ, ب, موقع, باقي));
}

عرف ابن_إزاحة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    البتات: طبيعي,
    موقع: منطقي,
    العملية: طبيعي
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(أ);
    دع حد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, البتات مثل ط64, خطأ);
    دع فارغ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع خارج: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 35, ب, حد,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, خارج);
    إذا (العملية == 1) { أرجع نتيجة.نجح(ابن_إزاحة_يمنى_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ))); };
    إذا (العملية == 2) { أرجع نتيجة.نجح(ابن_إزاحة_حسابية_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ))); };
    دع الناتج: مرجع_قيمة_إل_إل_في_إم = ابن_إزاحة_يسرى_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع معكوس: مرجع_قيمة_إل_إل_في_إم;
    إذا (موقع) { معكوس := ابن_إزاحة_حسابية_إل_إل_في_إم((*الحالة).الباني, الناتج, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ)); }
    وإلا { معكوس := ابن_إزاحة_يمنى_إل_إل_في_إم((*الحالة).الباني, الناتج, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
        فارغ)); };
    دع فقد: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 33, معكوس, أ,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, فقد);
    أرجع نتيجة.نجح(الناتج);
}

عرف ابن_ثابت_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    الثابت: &ثابت_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { النوع := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق;
        };
    طابق *الثابت مع
    | ثابت_مسير.منطق(ق) -> { دع v: متغير ط64 = 0; إذا (ق) { v := 1; }; أرجع
        نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل, v, خطأ))); }
    | ثابت_مسير.صحيح_موقع(ق) -> { أرجع
        نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل, ق مثل ط64, صواب))); }
    | ثابت_مسير.صحيح_طبيعي(ق) -> { أرجع
        نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل, ق مثل ط64, خطأ))); }
    | ثابت_مسير.مؤشر_فارغ -> {
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(
            ثابت_صفر_إل_إل_في_إم(القيد.التمثيل)));
    }
    | ثابت_مسير.عشري(البايتات) -> {
        دع العرض: طبيعي; طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, النوع) مع | اختياري.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ب) -> { العرض := ب; };
        دع البتات: طبيعي; طابق بتات_عائم_من_عشري(&البايتات, العرض) مع | اختياري.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ب) -> { البتات := ب; };
        دع نوع_بتات: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, العرض مثل ط32);
        دع خام: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_بتات, البتات مثل ط64, خطأ);
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_إعادة_تفسير_إل_إل_في_إم(خام, القيد.التمثيل)));
    }
    | ثابت_مسير.دالة(المعرف) -> {
        طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } |
            نتيجة.نجح(ق) -> { أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ق.الدالة)); };
    }
    | ثابت_مسير.نص(البايتات) -> {
        دع التخطيط: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ)
            -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع جزء_البيانات: موضع_جزء_تخطيط; دع جزء_الطول: موضع_جزء_تخطيط; دع جزء_السعة: موضع_جزء_تخطيط;
        طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, 0) مع | اختياري.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ج) -> { جزء_البيانات := ج; };
        طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, 1) مع | اختياري.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ج) -> { جزء_الطول := ج; };
        طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, 2) مع | اختياري.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ج) -> { جزء_السعة := ج; };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
        دع اسم_خام: متجه ط8 = اسم_نص_إل_إل_في_إم(الناتج.القيمة); دع اسم: متغير متجه ط8 =
            اجعل_اسما_سي_لإل_إل_في_إم(&اسم_خام);
        دع طول_البايتات: طبيعي = الطول(البايتات) مثل طبيعي;
        دع نوع_بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
        دع نوع_المصفوفة: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(نوع_بايت, طول_البايتات مثل ط64);
        دع العام: مرجع_قيمة_إل_إل_في_إم = أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_المصفوفة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        دع نسخ: متغير متجه ط8 = انسخ_بايتات(&البايتات); دع مؤشر_بايتات: مؤشر_محرف_ثابت_إل_إل_في_إم;
        إذا ((الطول(نسخ) مثل طبيعي) == 0) { دع صفر: متغير متجه ط8 = [0]; مؤشر_بايتات := &متغير صفر[0]; }
        وإلا { مؤشر_بايتات := &متغير نسخ[0]; };
        ضع_تهيئة_عام_إل_إل_في_إم(العام, ثابت_بايتات_إل_إل_في_إم((*الحالة).السياق, مؤشر_بايتات, طول_البايتات));
        ضع_ثبات_عام_إل_إل_في_إم(العام, صواب);
        دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق,
            (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32);
        دع عدد_البايتات: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, طول_البايتات مثل ط64, خطأ);
        ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, العام, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
            جزء_البيانات.الإزاحة));
        ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, عدد_البايتات, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
            جزء_الطول.الإزاحة));
        ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, عدد_البايتات, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
            جزء_السعة.الإزاحة));
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
    }
    | ثابت_مسير.متجه(_) -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع));
    };
}

عرف ابن_تجميع_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير, التجميع: &تجميع_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { النوع := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق;
        };
    دع التخطيط: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ) ->
        { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التجميع).الأعضاء) مثل طبيعي)) {
        دع الجزء: موضع_جزء_تخطيط; طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, ف) مع | اختياري.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ج) -> { الجزء := ج; };
        دع عضو: معرف_قيمة_مسير = (*التجميع).الأعضاء[ف]; دع نوع_عضو: معرف_نوع; طابق نوع_قيمة_مسير(المسير, عضو) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(عضو)); } | اختياري.موجود(ن) -> {
            نوع_عضو := ن; };
        دع تمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, عضو) مع | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ)
            -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { تمثيل := ق; };
        طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_عضو,
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, الجزء.الإزاحة), &تمثيل) مع | اختياري.موجود(خ) -> { أرجع
            نتيجة.خطأ(خ); } | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف ابن_عنوان_حقل_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم, المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية, الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط, المصدر: معرف_قيمة_مسير,
    الأساس: مرجع_قيمة_إل_إل_في_إم, الفهرس: طبيعي
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع التخطيط: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, المصدر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, الفهرس) مع | اختياري.لا_شيء -> { دع ن: معرف_نوع; طابق
        نوع_قيمة_مسير(المسير, المصدر) مع | اختياري.موجود(ت) -> { ن := ت; } | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المصدر)); }; أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(ن)); } | اختياري.موجود(ج) -> { أرجع
        نتيجة.نجح(ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, الأساس, ج.الإزاحة)); };
}

عرف نوع_عنصر_تسلسل_إل_إل_في_إم(الحقائق: &سياق_استعلام_اختيار_خلفية, النوع: معرف_نوع): اختياري معرف_نوع {
    طابق نوع_عنصر_تسلسل_دلالي(&(*الحقائق).الأنواع, النوع) مع
    | اختياري.موجود(ن) -> { أرجع اختياري.موجود(ن); }
    | اختياري.لا_شيء -> { };
    أرجع نوع_عنصر_شريحة_دلالي(&(*الحقائق).الأنواع, النوع);
}

// Capacity is checked before multiplying by the element stride or emitting
// any allocation. A wrapped capacity would produce an undersized buffer.
عرف احسب_سعة_تهيئة_متجه_إل_إل_في_إم(
    العدد: طبيعي, حجم_العنصر: طبيعي, حد_العنوان: طبيعي
): اختياري طبيعي {
    إذا (العدد == 0) { أرجع اختياري.موجود(0); };
    إذا (حجم_العنصر == 0) { أرجع اختياري.لا_شيء(); };
    دع الحد: طبيعي = حد_العنوان / حجم_العنصر;
    إذا (العدد > الحد) { أرجع اختياري.لا_شيء(); };
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(حجم_العنصر);
    إذا (السياسة.السعة_الدنيا == 0 || السياسة.عامل_النمو <= 1) {
        أرجع اختياري.لا_شيء();
    };
    دع السعة: متغير طبيعي = السياسة.السعة_الدنيا;
    إذا (السعة > الحد) { أرجع اختياري.لا_شيء(); };
    طالما (السعة < العدد) {
        إذا (السعة > الحد / السياسة.عامل_النمو) {
            // The requested count fits; use it rather than overflowing the
            // geometric growth sequence on the final step.
            أرجع اختياري.موجود(العدد);
        };
        السعة := السعة * السياسة.عامل_النمو;
    };
    أرجع اختياري.موجود(السعة);
}

عرف حقول_تسلسل_إل_إل_في_إم(
    التخطيط: &واصف_تخطيط,
    النوع: معرف_نوع
): نتيجة وصف_حقول_تسلسل_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_إل_إل_في_إم(التخطيط, 0) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ج) -> { بيانات := ج; };
    طابق جزء_تخطيط_إل_إل_في_إم(التخطيط, 1) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ج) -> { طول_ := ج; };
    طابق جزء_تخطيط_إل_إل_في_إم(التخطيط, 2) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ج) -> { سعة := ج; };
    دع الحقول: وصف_حقول_تسلسل_إل_إل_في_إم = { البيانات: بيانات, الطول: طول_, السعة: سعة };
    أرجع نتيجة.نجح(الحقول);
}

عرف ابن_تهيئة_متجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير, التهيئة: &تهيئة_متجه_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع نوع_المتجه: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { نوع_المتجه := ن; };
    دع نوع_العنصر: معرف_نوع; طابق نوع_عنصر_تسلسل_إل_إل_في_إم(الحقائق, نوع_المتجه) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_المتجه)); } | اختياري.موجود(ن) -> { نوع_العنصر := ن; };
    دع قيد_المتجه: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_المتجه)
        مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> {
        قيد_المتجه := ق; };
    دع تخطيط_المتجه: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع تخطيط_العنصر: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } |
        نتيجة.نجح(ح) -> { بيانات := ح.البيانات; طول_ := ح.الطول; سعة_ := ح.السعة; };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &قيد_المتجه, تخطيط_المتجه.المحاذاة);
    دع عدد_العناصر: طبيعي = الطول((*التهيئة).العناصر) مثل طبيعي;
    دع حد_العنوان: طبيعي;
    إذا ((*الهدف).نموذج_البيانات.عرض_المؤشر == 32) {
        حد_العنوان := 0xFFFFFFFF;
    } وإلا إذا ((*الهدف).نموذج_البيانات.عرض_المؤشر == 64) {
        حد_العنوان := 0xFFFFFFFFFFFFFFFF;
    } وإلا {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_المتجه));
    };
    دع السعة: طبيعي;
    طابق احسب_سعة_تهيئة_متجه_إل_إل_في_إم(
        عدد_العناصر, تخطيط_العنصر.الحجم, حد_العنوان
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_المتجه));
    }
    | اختياري.موجود(الحجم) -> { السعة := الحجم; };
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل ط32);
    دع صفر_مؤشر: مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
    دع مؤشر_البيانات: متغير مرجع_قيمة_إل_إل_في_إم = صفر_مؤشر;
    إذا (السعة > 0) {
        دع حجم_الذاكرة: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, (السعة * تخطيط_العنصر.الحجم) مثل
            ط64, خطأ);
        طابق ابن_تخصيص_ذاكرة_إل_إل_في_إم(الحالة, الهدف, حجم_الذاكرة) مع | اختياري.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختياري.موجود(ق) -> {
            تحقق_تخصيص_إل_إل_في_إم(الحالة, الدالة, ق);
            مؤشر_البيانات := ق;
        };
    };
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, مؤشر_البيانات, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
        بيانات.الإزاحة));
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, ثابت_صحيح_إل_إل_في_إم(نوع_حجم, عدد_العناصر مثل ط64, خطأ),
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, طول_.الإزاحة));
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, ثابت_صحيح_إل_إل_في_إم(نوع_حجم, السعة مثل ط64, خطأ),
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, سعة_.الإزاحة));
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_العناصر) {
        دع المعرف: معرف_قيمة_مسير = (*التهيئة).العناصر[ف]; دع التمثيل: تمثيل_قيمة_إل_إل_في_إم;
        طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } |
            نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل := ق; };
        طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر,
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, مؤشر_البيانات, ف * تخطيط_العنصر.الحجم), &التمثيل) مع |
            اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); } | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف ابن_عنوان_عنصر_تسلسل_من_قيمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    المصدر: معرف_قيمة_مسير, الفهرس: معرف_قيمة_مسير, نوع_العنصر: معرف_نوع
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع عنوان_المصدر: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع
        نتيجة.خطأ(خ); } | نتيجة.نجح(ع) -> { عنوان_المصدر := ع; };
    دع تخطيط_المصدر: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, المصدر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_المصدر := ت; };
    دع نوع_المصدر: معرف_نوع; طابق نوع_قيمة_مسير(المسير, المصدر) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المصدر)); } | اختياري.موجود(ن) -> { نوع_المصدر := ن; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط_المصدر, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } |
        نتيجة.نجح(ح) -> { بيانات := ح.البيانات; طول_ := ح.الطول; سعة_ := ح.السعة; };
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق); دع اسم: متغير متجه ط8 =
        اسم_فارغ_إل_إل_في_إم();
    دع مؤشر_البيانات: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المصدر, بيانات.الإزاحة), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
        اسم));
    دع قيمة_الفهرس: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, الفهرس) مع | نتيجة.خطأ(خ) -> { أرجع
        نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { قيمة_الفهرس := ق; };
    دع تخطيط_العنصر: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    أرجع نتيجة.نجح(ابن_عنوان_عنصر_إل_إل_في_إم(الحالة, مؤشر_البيانات, قيمة_الفهرس, تخطيط_العنصر.الحجم));
}

// --- ABI marshalling -------------------------------------------------------

عرف اجعل_عنوانا_لقيمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    التمثيل: &تمثيل_قيمة_إل_إل_في_إم
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    طابق *التمثيل مع
    | تمثيل_قيمة_إل_إل_في_إم.عنوان(ع) -> { أرجع نتيجة.نجح(ع); }
    | تمثيل_قيمة_إل_إل_في_إم.سلمية(س) -> {
        دع القيد: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
        ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, س, المكان);
        أرجع نتيجة.نجح(المكان);
    };
}

// The LLVM provider copies every load and read into an alloca of its own
// (حمّل_من_مكان_إل_إل_في_إم): it gives the copy-elision rule empty copy facts.
عرف مخازن_ثابتة_لدالة_إل_إل_في_إم(المسير: &سياق_مستهلك_مسير, المعرف: معرف_دالة_مسير): متجه منطقي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*المسير).المسير.الدوال) مثل طبيعي)) {
        دع فارغة: متجه منطقي = [];
        أرجع فارغة;
    };
    دع الدالة: &دالة_مسير = &(*المسير).المسير.الدوال[المعرف.القيمة];
    دع بلا_نسخ: حقائق_نسخ_قيم_مسير = حقائق_نسخ_فارغة_مسير((*الدالة).القيمة_التالية);
    أرجع مخازن_ثابتة_للنداء_مسير(الدالة, &بلا_نسخ);
}

عرف ألحق_حجة_واجهة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_قيمة_مسير,
    الخطة: &خطة_معامل_واجهة,
    الحجج: &متغير متجه مرجع_قيمة_إل_إل_في_إم
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع اختياري.لا_شيء(); }
    | _ -> { };
    دع التمثيل: تمثيل_قيمة_إل_إل_في_إم;
    طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع
    | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل := ق; };
    إذا (معامل_واجهة_بالقيمة_في_الذاكرة_لإل_إل_في_إم(الخطة)) {
        طابق اجعل_عنوانا_لقيمة_إل_إل_في_إم(
            الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, &التمثيل
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(العنوان) -> { ألحق(*الحجج, العنوان); };
        أرجع اختياري.لا_شيء();
    };
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        طابق اجعل_عنوانا_لقيمة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, &التمثيل) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ع) -> {
            دع ثابتة: منطقي = (المعرف.القيمة مثل طبيعي) < (الطول((*الدالة).الثابتة) مثل طبيعي)
                && (*الدالة).الثابتة[المعرف.القيمة];
            إذا ((*الخطة).التصنيف.نسخة_للمستدعى || !ثابتة) {
                // Foreign C ABIs: the callee owns the pointed-to copy. A
                // SultanC hidden reference whose bytes might change during
                // the call (مخازن_ثابتة_للنداء_مسير): a copy for the call.
                دع القيد: قيد_نوع_إل_إل_في_إم;
                طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
                | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
                ألحق(*الحجج, نسخة_مستدعى_لقيمة_إل_إل_في_إم(
                    الحالة, ع, القيد.التمثيل, &(*الخطة).التصنيف
                ));
            } وإلا {
                ألحق(*الحجج, ع);
            };
        };
    }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        إذا ((*الخطة).التصنيف.تجميعي) {
            دع ع: مرجع_قيمة_إل_إل_في_إم;
            طابق اجعل_عنوانا_لقيمة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, &التمثيل) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(عنوان_) -> { ع := عنوان_; };
            ألحق_قيم_أجزاء_واجهة_إل_إل_في_إم(
                الحالة, ع, &(*الخطة).التصنيف, &(*الخطة).أشكال_الأجزاء, الحجج
            );
        } وإلا {
            طابق التمثيل مع
            | تمثيل_قيمة_إل_إل_في_إم.سلمية(س) -> { ألحق(*الحجج, س); }
            | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_متوقعة(المعرف)); };
        };
    }
    | موقع_تمرير_واجهة.مجزأ(_) -> {
        دع ع: مرجع_قيمة_إل_إل_في_إم;
        طابق اجعل_عنوانا_لقيمة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, &التمثيل) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(عنوان_) -> { ع := عنوان_; };
        ألحق_قيم_أجزاء_واجهة_إل_إل_في_إم(
            الحالة, ع, &(*الخطة).التصنيف, &(*الخطة).أشكال_الأجزاء, الحجج
        );
    }
    | موقع_تمرير_واجهة.متجاهل -> { };
    أرجع اختياري.لا_شيء();
}

عرف ابن_قيمة_من_ناتج_واجهة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_ناتج_واجهة,
    قيمة_النداء: مرجع_قيمة_إل_إل_في_إم,
    عنوان_غير_مباشر: اختياري مرجع_قيمة_إل_إل_في_إم
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); }
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        طابق عنوان_غير_مباشر مع
        | اختياري.موجود(ع) -> { أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(ع)); }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        إذا (!(*الخطة).التصنيف.تجميعي) { أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(قيمة_النداء)); };
    }
    | موقع_تمرير_واجهة.مجزأ(_) -> { };
    دع القيد: قيد_نوع_إل_إل_في_إم;
    طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
    | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
    دع التخطيط: واصف_تخطيط;
    طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
    خزّن_قيمة_إرجاع_أجزاء_واجهة_إل_إل_في_إم(
        الحالة, المكان, &(*الخطة).التصنيف, &(*الخطة).أشكال_الأجزاء, قيمة_النداء
    );
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف اجمع_ناتج_واجهة_للإرجاع_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    الخطة: &خطة_ناتج_واجهة,
    المعرف: معرف_قيمة_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع التمثيل: تمثيل_قيمة_إل_إل_في_إم;
    طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع
    | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل := ق; };
    إذا (!(*الخطة).التصنيف.تجميعي) {
        طابق التمثيل مع
        | تمثيل_قيمة_إل_إل_في_إم.سلمية(س) -> { أرجع نتيجة.نجح(س); }
        | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_متوقعة(المعرف)); };
    };
    دع العنوان: مرجع_قيمة_إل_إل_في_إم;
    طابق التمثيل مع
    | تمثيل_قيمة_إل_إل_في_إم.عنوان(ع) -> { العنوان := ع; }
    | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.مكان_متوقع(المعرف)); };
    أرجع نتيجة.نجح(قيمة_إرجاع_أجزاء_واجهة_إل_إل_في_إم(
        الحالة, العنوان, &(*الخطة).التصنيف, &(*الخطة).أشكال_الأجزاء
    ));
}

عرف ابن_نداء_بخطة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المستدعى: مرجع_قيمة_إل_إل_في_إم,
    نوع_الدالة: مرجع_نوع_إل_إل_في_إم,
    الخطة: &خطة_دالة_واجهة,
    بيئة_الإغلاق: اختياري مرجع_قيمة_إل_إل_في_إم,
    حجج_مسير: &متجه معرف_قيمة_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا ((الطول(*حجج_مسير) مثل طبيعي) != (الطول((*الخطة).المعاملات) مثل طبيعي)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة());
    };
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع عنوان_الناتج: متغير اختياري مرجع_قيمة_إل_إل_في_إم = اختياري.لا_شيء();
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع القيد: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع ع: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
        عنوان_الناتج := اختياري.موجود(ع);
        ألحق(الحجج, ع);
    }
    | _ -> { };
    طابق بيئة_الإغلاق مع
    | اختياري.موجود(ب) -> { ألحق(الحجج, ب); }
    | اختياري.لا_شيء -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*حجج_مسير) مثل طبيعي)) {
        دع مرجع_الخطة: &خطة_معامل_واجهة = &(*الخطة).المعاملات[ف];
        طابق ألحق_حجة_واجهة_إل_إل_في_إم(
            الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط,
            (*حجج_مسير)[ف], مرجع_الخطة, &متغير الحجج
        ) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع مؤشر_الحجج: متغير مرجع_قيمة_إل_إل_في_إم;
    دع قيمة_النداء: مرجع_قيمة_إل_إل_في_إم;
    إذا ((الطول(الحجج) مثل طبيعي) == 0) {
        دع فارغ: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المستدعى];
        قيمة_النداء := ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, المستدعى, &متغير فارغ[0], 0,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    } وإلا {
        مؤشر_الحجج := الحجج[0];
        قيمة_النداء := ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, المستدعى, &متغير الحجج[0],
            الطول(الحجج) مثل ط32, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    };
    دع له_بيئة_إغلاق: منطقي;
    طابق بيئة_الإغلاق مع
    | اختياري.موجود(_) -> { له_بيئة_إغلاق := صواب; }
    | اختياري.لا_شيء -> { له_بيئة_إغلاق := خطأ; };
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع قيد_الناتج: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(
            الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع
        ) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(القيد) -> { قيد_الناتج := القيد; };
        أضف_صفة_ناتج_غير_مباشر_إل_إل_في_إم(
            الحالة, قيمة_النداء, قيد_الناتج.التمثيل, صواب
        );
    }
    | _ -> { };
    طابق أضف_صفات_معاملات_الذاكرة_إل_إل_في_إم(
        الحالة, الحقائق, الهدف, سجل_التخطيط, قيمة_النداء, الخطة, له_بيئة_إغلاق, صواب
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    طابق الناتج مع
    | اختياري.لا_شيء -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { أرجع اختياري.لا_شيء(); }
        | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    }
    | اختياري.موجود(معرف_الناتج) -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { أرجع اختياري.لا_شيء(); }
        | _ -> {
            طابق ابن_قيمة_من_ناتج_واجهة_إل_إل_في_إم(
                الحالة, الحقائق, الهدف, سجل_التخطيط,
                &(*الخطة).الناتج, قيمة_النداء, عنوان_الناتج
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, معرف_الناتج, ق); };
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف أعلن_بدائي_تشغيل_للنداء_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البدائي: هوية_بدائي_مترجم,
    الخطة: &متغير خطة_دالة_واجهة
): نتيجة تصريح_بدائي_نداء_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع الاسم_الخام: متجه ط8;
    طابق اسم_بدائي_تشغيل_إل_إل_في_إم(الهدف, البدائي) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(ن) -> { الاسم_الخام := ن; };
    دع التوقيع: وصف_توقيع_إل_إل_في_إم;
    طابق ابن_توقيع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, الخطة, خطأ) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ت) -> { التوقيع := ت; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).بدائيات_التشغيل) مثل طبيعي)) {
        دع الموجود: &تصريح_بدائي_نداء_إل_إل_في_إم = &(*الحالة).بدائيات_التشغيل[ف];
        إذا (هويتا_بدائي_مترجم_متساويتان((*الموجود).الهوية, البدائي)) {
            دع التصريح_الموجود: تصريح_بدائي_نداء_إل_إل_في_إم = *الموجود;
            أرجع نتيجة.نجح(التصريح_الموجود);
        };
        ف := ف + 1;
    }
    دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
    دع المؤشر: مؤشر_محرف_ثابت_إل_إل_في_إم = مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم);
    دع الجديدة: مرجع_قيمة_إل_إل_في_إم = أضف_دالة_إل_إل_في_إم((*الحالة).الوحدة, المؤشر, التوقيع.النوع);
    إذا (التوقيع.الناتج_غير_مباشر) {
        دع القيد: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
        أضف_صفة_ناتج_غير_مباشر_إل_إل_في_إم(الحالة, الجديدة, القيد.التمثيل, خطأ);
    };
    طابق أضف_صفات_معاملات_الذاكرة_إل_إل_في_إم(
        الحالة, الحقائق, الهدف, سجل_التخطيط, الجديدة, الخطة, خطأ, خطأ
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع التصريح: تصريح_بدائي_نداء_إل_إل_في_إم = { الهوية: البدائي, الدالة: الجديدة, النوع: التوقيع.النوع };
    ألحق((*الحالة).بدائيات_التشغيل, التصريح);
    أرجع نتيجة.نجح(التصريح);
}

// A raw kernel entry is a side-effecting machine operation. The selected target,
// not the host, determines the ABI; OS numbers and error decoding stay in STD.
عرف ابن_نداء_نواة_خام_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    // The Linux kernel entry (Android is the same kernel ABI). The kernel
    // reports errors as -errno in the result register, except on MIPS,
    // PowerPC and SPARC, which flag them; the sequences below turn those into
    // -errno so std sees one convention on every architecture. SPARC clone
    // (217) also returns the parent's PID in the child with %o1 = 1; the
    // child gets 0 here, as on every other architecture.
    // On the 32-bit ABIs (i386, ARM EABI) the registers are 32 bits: the
    // 64-bit std operands are truncated, and the result is widened back
    // with the -errno range sign-extended so std decodes one convention.
    دع نواة_لينكس: منطقي = (*الهدف).المنصة.المنصة == هوية_منصة.لينكس()
        || (*الهدف).المنصة.المنصة == هوية_منصة.أندرويد();
    دع نواة_فري_بي_إس_دي: منطقي = هدف_نواة_فري_بي_إس_دي_مباشر(الهدف);
    دع عرض_الكلمة: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر;
    إذا ((!نواة_لينكس && !نواة_فري_بي_إس_دي)
        || (عرض_الكلمة != 64 && عرض_الكلمة != 32)
        || (الطول((*النداء).الحجج) مثل طبيعي) != 7) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    دع رمز_التجميع: متغير متجه ط8 = [];
    دع رمز_القيود: متغير متجه ط8 = [];
    // i386 has six argument registers besides EAX only if EBP is one, and
    // EBP may be the frame pointer: the number and the sixth argument go in
    // a two-word stack block whose address is in EAX, and EBP is saved
    // around int $0x80 (the sequence musl uses).
    دع عبر_كتلة: متغير منطقي = خطأ;
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> {
        دع رمز_التجميع_17: متجه ط8 = بايتات_منتهية_بصفر_من_نص("pushl %ebp\nmovl 4(%eax), %ebp\nmovl (%eax), %eax\nint $$0x80\npopl %ebp");
        رمز_التجميع := رمز_التجميع_17;
        دع رمز_القيود_18: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={eax},0,{ebx},{ecx},{edx},{esi},{edi},~{memory},~{flags}»);
        رمز_القيود := رمز_القيود_18;
        عبر_كتلة := صواب;
    }
    | هوية_معمارية.ذراع_سبعة -> {
        دع رمز_التجميع_19: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«svc 0»);
        رمز_التجميع := رمز_التجميع_19;
        دع رمز_القيود_20: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={r0},{r7},0,{r1},{r2},{r3},{r4},{r5},~{memory}»);
        رمز_القيود := رمز_القيود_20;
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        دع رمز_التجميع_1: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«syscall»);
        رمز_التجميع := رمز_التجميع_1;
        دع رمز_القيود_2: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={rax},0,{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{flags},~{memory}»);
        رمز_القيود := رمز_القيود_2;
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        دع رمز_التجميع_3: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«svc #0»);
        رمز_التجميع := رمز_التجميع_3;
        دع رمز_القيود_4: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={x0},{x8},0,{x1},{x2},{x3},{x4},{x5},~{memory},~{cc}»);
        رمز_القيود := رمز_القيود_4;
    }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> {
        دع رمز_التجميع_5: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«ecall»);
        رمز_التجميع := رمز_التجميع_5;
        دع رمز_القيود_6: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={x10},{x17},0,{x11},{x12},{x13},{x14},{x15},~{memory}»);
        رمز_القيود := رمز_القيود_6;
    }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> {
        دع رمز_التجميع_7: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«syscall 0»);
        رمز_التجميع := رمز_التجميع_7;
        دع رمز_القيود_8: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={$r4},{$r11},0,{$r5},{$r6},{$r7},{$r8},{$r9},~{$r12},~{$r13},~{$r14},~{$r15},~{$r16},~{$r17},~{$r18},~{$r19},~{$r20},~{memory}»);
        رمز_القيود := رمز_القيود_8;
    }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> {
        دع رمز_التجميع_9: متجه ط8 = بايتات_منتهية_بصفر_من_نص("sc\nbns+ 1f\nneg 3, 3\n1:");
        رمز_التجميع := رمز_التجميع_9;
        دع رمز_القيود_10: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={r3},{r0},0,{r4},{r5},{r6},{r7},{r8},~{r9},~{r10},~{r11},~{r12},~{cr0},~{ctr},~{xer},~{memory}»);
        رمز_القيود := رمز_القيود_10;
    }
    | هوية_معمارية.سيستم_زد -> {
        دع رمز_التجميع_11: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«svc 0»);
        رمز_التجميع := رمز_التجميع_11;
        دع رمز_القيود_12: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={r2},{r1},0,{r3},{r4},{r5},{r6},{r7},~{memory},~{cc}»);
        رمز_القيود := رمز_القيود_12;
    }
    | هوية_معمارية.ميبس_أربعة_وستون -> {
        دع رمز_التجميع_13: متجه ط8 = بايتات_منتهية_بصفر_من_نص(".set push\n.set noreorder\nmove $$7, $$12\nsyscall\nbeqz $$7, 1f\nnop\ndsubu $$2, $$0, $$2\n1:\n.set pop");
        رمز_التجميع := رمز_التجميع_13;
        دع رمز_القيود_14: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={$2},0,{$4},{$5},{$6},{$12},{$8},{$9},~{$1},~{$3},~{$7},~{$10},~{$11},~{$13},~{$14},~{$15},~{$24},~{$25},~{hi},~{lo},~{memory}»);
        رمز_القيود := رمز_القيود_14;
    }
    | هوية_معمارية.سبارك_أربعة_وستون -> {
        دع رمز_التجميع_15: متجه ط8 = بايتات_منتهية_بصفر_من_نص("mov %g1, %g4\nta 0x6d\nbcc,pt %xcc, 1f\nnop\nsub %g0, %o0, %o0\nba,pt %xcc, 2f\nnop\n1:\ncmp %g4, 217\nbne,pt %xcc, 2f\nnop\nmovrnz %o1, 0, %o0\n2:");
        رمز_التجميع := رمز_التجميع_15;
        دع رمز_القيود_16: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={o0},{g1},0,{o1},{o2},{o3},{o4},{o5},~{g4},~{icc},~{xcc},~{memory}»);
        رمز_القيود := رمز_القيود_16;
    }
    | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    // The FreeBSD kernel entry replaces the Linux one chosen above. Every
    // architecture flags an error and leaves the positive errno in the result
    // register (cpu_set_syscall_retval in sys/<arch>/<arch>/vm_machdep.c):
    // amd64 and arm64 set the carry flag,
    // riscv sets t0 to 1. The sequences turn that into -errno, as for MIPS,
    // PowerPC and SPARC Linux. A successful call also writes the second
    // result word (td_retval[1]: rdx, x1, a1), so that register is clobbered
    // even though it carries an argument in; riscv's t0 carries the number
    // in and the flag out. The number register is rax / x8 / t0 and the
    // arguments rdi rsi rdx r10 r8 r9 / x0-x5 / a0-a5 (cpu_fetch_syscall_args).
    // fork returns 0 in the child on all three (cpu_fork), as clone does.
    إذا (نواة_فري_بي_إس_دي) {
        طابق (*الهدف).المعمارية.الهوية مع
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
            دع تجميع_فري_1: متجه ط8 = بايتات_منتهية_بصفر_من_نص("syscall\njnc 1f\nnegq %rax\n1:");
            رمز_التجميع := تجميع_فري_1;
            دع قيود_فري_1: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={rax},0,{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rdx},~{rcx},~{r11},~{flags},~{memory}»);
            رمز_القيود := قيود_فري_1;
        }
        | هوية_معمارية.ذراع_أربعة_وستون -> {
            دع تجميع_فري_2: متجه ط8 = بايتات_منتهية_بصفر_من_نص("svc #0\nb.cc 1f\nneg x0, x0\n1:");
            رمز_التجميع := تجميع_فري_2;
            دع قيود_فري_2: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={x0},{x8},0,{x1},{x2},{x3},{x4},{x5},~{x1},~{memory},~{cc}»);
            رمز_القيود := قيود_فري_2;
        }
        | هوية_معمارية.رايسك_في_أربعة_وستون -> {
            دع تجميع_فري_3: متجه ط8 = بايتات_منتهية_بصفر_من_نص("ecall\nbeqz t0, 1f\nneg a0, a0\n1:");
            رمز_التجميع := تجميع_فري_3;
            دع قيود_فري_3: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={x10},{x5},0,{x11},{x12},{x13},{x14},{x15},~{x5},~{x11},~{memory}»);
            رمز_القيود := قيود_فري_3;
        }
        | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    };
    دع المعرف: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(ن) -> { المعرف := ن; };
    دع نوع_العدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, عرض_الكلمة مثل ط32);
    دع نوع_العدد_64: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    دع أنواع_المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    دع قيم_المعاملات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 7) {
        دع قيمة: مرجع_قيمة_إل_إل_في_إم;
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[الفهرس]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(القيمة) -> { قيمة := القيمة; };
        دع قيمة_آلة: متغير مرجع_قيمة_إل_إل_في_إم = قيمة;
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_قيمة_مسير(المسير, (*النداء).الحجج[الفهرس]) مع
        | اختياري.موجود(النوع) -> { نوع_المصدر := النوع; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*النداء).الحجج[الفهرس])); };
        طابق وصف_شكل_نوع_دلالي_عند(&(*الحقائق).الأنواع, نوع_المصدر) مع
        | اختياري.موجود(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.مؤشر -> {
                دع اسم_التحويل: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
                قيمة_آلة := ابن_تحويل_مؤشر_إلى_صحيح_إل_إل_في_إم(
                    (*الحالة).الباني, قيمة, نوع_العدد,
                    مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_التحويل)
                );
            }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
        دع عرض_القيمة: ط32 = LLVMGetIntTypeWidth(نوع_قيمة_إل_إل_في_إم(قيمة_آلة));
        إذا (عرض_القيمة > (عرض_الكلمة مثل ط32)) {
            دع اسم_الاقتطاع: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
            قيمة_آلة := ابن_اقتطاع_إل_إل_في_إم((*الحالة).الباني, قيمة_آلة, نوع_العدد,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الاقتطاع));
        };
        إذا (عرض_القيمة < (عرض_الكلمة مثل ط32)) {
            دع اسم_التوسيع: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
            قيمة_آلة := ابن_توسيع_صفري_إل_إل_في_إم((*الحالة).الباني, قيمة_آلة, نوع_العدد,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_التوسيع));
        };
        ألحق(أنواع_المعاملات, نوع_العدد);
        ألحق(قيم_المعاملات, قيمة_آلة);
        الفهرس := الفهرس + 1;
    }
    دع عدد_المعاملات: متغير ط32 = 7;
    إذا (عبر_كتلة) {
        // [number, sixth argument] in an entry-block slot; EAX gets its address.
        دع نوع_الكتلة: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(نوع_العدد, 2);
        دع اسم_الكتلة: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
        دع الكتلة: مرجع_قيمة_إل_إل_في_إم = ابن_حجز_إل_إل_في_إم((*الحالة).باني_الحجز, نوع_الكتلة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الكتلة));
        ضع_محاذاة_قيمة_إل_إل_في_إم(الكتلة, 4);
        دع صفر_الفهرس: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_العدد, 0, خطأ);
        دع واحد_الفهرس: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_العدد, 1, خطأ);
        دع فهارس_الرقم: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
        ألحق(فهارس_الرقم, صفر_الفهرس);
        ألحق(فهارس_الرقم, صفر_الفهرس);
        دع فهارس_السادس: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
        ألحق(فهارس_السادس, صفر_الفهرس);
        ألحق(فهارس_السادس, واحد_الفهرس);
        دع اسم_أ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
        دع خانة_الرقم: مرجع_قيمة_إل_إل_في_إم = ابن_فهرسة_إل_إل_في_إم((*الحالة).الباني, نوع_الكتلة, الكتلة,
            &متغير فهارس_الرقم[0], 2, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_أ));
        دع اسم_ب: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
        دع خانة_السادس: مرجع_قيمة_إل_إل_في_إم = ابن_فهرسة_إل_إل_في_إم((*الحالة).الباني, نوع_الكتلة, الكتلة,
            &متغير فهارس_السادس[0], 2, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_ب));
        دع تخزين_الرقم: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, قيم_المعاملات[0], خانة_الرقم);
        دع تخزين_السادس: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, قيم_المعاملات[6], خانة_السادس);
        دع اسم_ج: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
        دع عنوان_الكتلة: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_مؤشر_إلى_صحيح_إل_إل_في_إم(
            (*الحالة).الباني, الكتلة, نوع_العدد, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_ج));
        دع قيم_الكتلة: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
        ألحق(قيم_الكتلة, عنوان_الكتلة);
        دع ك: متغير طبيعي = 1;
        طالما (ك < 6) { ألحق(قيم_الكتلة, قيم_المعاملات[ك]); ك := ك + 1; }
        قيم_المعاملات := قيم_الكتلة;
        دع أنواع_الكتلة: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
        دع م: متغير طبيعي = 0;
        طالما (م < 6) { ألحق(أنواع_الكتلة, نوع_العدد); م := م + 1; }
        أنواع_المعاملات := أنواع_الكتلة;
        عدد_المعاملات := 6;
    };
    دع التوقيع: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(
        نوع_العدد, &متغير أنواع_المعاملات[0], عدد_المعاملات
    );
    دع التجميع: مرجع_قيمة_إل_إل_في_إم = LLVMGetInlineAsm(
        التوقيع,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير رمز_التجميع),
        (الطول(رمز_التجميع) - 1) مثل طبيعي,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير رمز_القيود),
        (الطول(رمز_القيود) - 1) مثل طبيعي,
        1, 0, 0, 0
    );
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع قيمة_العودة: مرجع_قيمة_إل_إل_في_إم = ابن_نداء_إل_إل_في_إم(
        (*الحالة).الباني, التوقيع, التجميع, &متغير قيم_المعاملات[0], عدد_المعاملات,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
    );
    إذا (عرض_الكلمة == 64) {
        ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(قيمة_العودة));
        أرجع اختياري.لا_شيء();
    };
    // [-4095, -1] is -errno: sign-extend it; any other word (an address
    // from mmap2 above 2 GiB, a byte count) is unsigned.
    دع حد_الخطأ: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_العدد, 0xFFFFF001, خطأ);
    دع اسم_د: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع خطأ_نواة: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 35, قيمة_العودة, حد_الخطأ,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_د));
    دع اسم_هـ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع موسعة_بإشارة: مرجع_قيمة_إل_إل_في_إم = ابن_توسيع_إشارة_إل_إل_في_إم((*الحالة).الباني, قيمة_العودة, نوع_العدد_64,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_هـ));
    دع اسم_و: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع موسعة_بصفر: مرجع_قيمة_إل_إل_في_إم = ابن_توسيع_صفري_إل_إل_في_إم((*الحالة).الباني, قيمة_العودة, نوع_العدد_64,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_و));
    دع اسم_ز: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع الموسعة: مرجع_قيمة_إل_إل_في_إم = ابن_اختيار_إل_إل_في_إم((*الحالة).الباني, خطأ_نواة, موسعة_بإشارة, موسعة_بصفر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_ز));
    ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(الموسعة));
    أرجع اختياري.لا_شيء();
}

// WebAssembly linear-memory primitives (wasm32 only, gated by the target
// owner). Addresses are u32 offsets into the module's one linear memory, so a
// load/store is an inttoptr of that offset; memory.grow and the linker heap
// base map to their LLVM WebAssembly forms; the copy is llvm.memcpy, which the
// default wasm CPU (bulk-memory) lowers to memory.copy without a libc call.
عرف ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    البدائي: هوية_بدائي_مترجم
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا (!يدعم_ذاكرة_خطية_للهدف(الهدف)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(الحجج, القيمة); };
        ف := ف + 1;
    }
    دع نوع_ع32_خطي: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 32);
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع الناتج_إل_إل_في_إم: متغير اختياري مرجع_قيمة_إل_إل_في_إم = اختياري.لا_شيء();
    طابق البدائي مع
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
        إذا ((الطول(الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        // llvm.wasm.memory.grow.i32(i32 memory, i32 delta) -> i32
        دع اسم_الجوهر: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«llvm.wasm.memory.grow»);
        دع الهوية: ط32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الجوهر), 21);
        إذا (الهوية == 0) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع أنواع_التحميل: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_ع32_خطي];
        دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم(
            (*الحالة).الوحدة, الهوية, &متغير أنواع_التحميل[0], 1
        );
        دع المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_ع32_خطي, نوع_ع32_خطي];
        دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_ع32_خطي, &متغير المعاملات[0], 2);
        دع الذاكرة_صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_ع32_خطي, 0, خطأ);
        دع مقدار_النمو: مرجع_قيمة_إل_إل_في_إم = الحجج[0];
        دع القيم: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الذاكرة_صفر, مقدار_النمو];
        الناتج_إل_إل_في_إم := اختياري.موجود(ابن_نداء_إل_إل_في_إم(
            (*الحالة).الباني, نوع_الدالة, الجوهر, &متغير القيم[0], 2,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        ));
    }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
        إذا ((الطول(الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المحمل: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم(
            (*الحالة).الباني, نوع_ع32_خطي, المكان, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        ضع_محاذاة_قيمة_إل_إل_في_إم(المحمل, 4);
        الناتج_إل_إل_في_إم := اختياري.موجود(المحمل);
    }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
        إذا ((الطول(الحجج) مثل طبيعي) != 2) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المخزن: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, الحجج[1], المكان);
        ضع_محاذاة_قيمة_إل_إل_في_إم(المخزن, 4);
    }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
        إذا ((الطول(الحجج) مثل طبيعي) != 3) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع الوجهة: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المصدر: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[1], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        ابن_نسخ_ذاكرة_إل_إل_في_إم((*الحالة).الباني, الوجهة, 1, المصدر, 1, الحجج[2]);
    }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
        // __heap_base: the WebAssembly linker (link/wasm/linker.sn) defines
        // it as the first address after the stack and static data. Declared
        // once as external storage.
        دع اسم_القاعدة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«__heap_base»);
        دع العام: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetNamedGlobal(
            (*الحالة).الوحدة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_القاعدة)
        );
        إذا (العام == الفارغ) {
            دع بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
            العام := أضف_عام_إل_إل_في_إم(
                (*الحالة).الوحدة, بايت, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_القاعدة)
            );
        };
        الناتج_إل_إل_في_إم := اختياري.موجود(ابن_تحويل_مؤشر_إلى_صحيح_إل_إل_في_إم(
            (*الحالة).الباني, العام, نوع_ع32_خطي, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        ));
    }
    | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    طابق الناتج_إل_إل_في_إم مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
        | اختياري.موجود(المعرف) -> {
            ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(القيمة));
        };
    };
    أرجع اختياري.لا_شيء();
}

// Flat machine-memory primitives (64/32-bit non-wasm targets, gated by the target
// owner): the u64 address becomes a pointer by inttoptr and one 8-byte-aligned
// i64 load/store accesses it.
عرف ابن_بدائي_ذاكرة_آلة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    البدائي: هوية_بدائي_مترجم
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا (!يدعم_ذاكرة_آلة_للهدف(الهدف)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(الحجج, القيمة); };
        ف := ف + 1;
    }
    دع نوع_كلمة: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    طابق البدائي مع
    | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> {
        إذا ((الطول(الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المحمل: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم(
            (*الحالة).الباني, نوع_كلمة, المكان, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        ضع_محاذاة_قيمة_إل_إل_في_إم(المحمل, 8);
        طابق الناتج مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
        | اختياري.موجود(المعرف) -> {
            ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(المحمل));
        };
    }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> {
        إذا ((الطول(الحجج) مثل طبيعي) != 2) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المخزن: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, الحجج[1], المكان);
        ضع_محاذاة_قيمة_إل_إل_في_إم(المخزن, 8);
    }
    | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    أرجع اختياري.لا_شيء();
}

// An overloaded LLVM intrinsic of one float Type: T name(T, ...).
عرف ابن_جوهر_عائم_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الاسم: نص,
    الحجج: &متغير متجه مرجع_قيمة_إل_إل_في_إم
): مرجع_قيمة_إل_إل_في_إم {
    دع اسم_الجوهر_خام: متجه ط8 = بايتات_من_نص(الاسم);
    دع اسم_الجوهر: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_الجوهر_خام);
    دع الهوية: ط32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الجوهر), الطول(اسم_الجوهر_خام)
        مثل طبيعي);
    دع النوع: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم((*الحجج)[0]);
    دع أنواع_التحميل: متغير متجه مرجع_نوع_إل_إل_في_إم = [النوع];
    دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم((*الحالة).الوحدة, الهوية, &متغير أنواع_التحميل[0], 1);
    دع المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحجج) مثل طبيعي)) { ألحق(المعاملات, النوع); ف := ف + 1; }
    دع نوع_الجوهر: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(النوع, &متغير المعاملات[0],
        (الطول(المعاملات) مثل طبيعي) مثل ط32);
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    أرجع ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الجوهر, الجوهر, &متغير (*الحجج)[0],
        (الطول(*الحجج) مثل طبيعي) مثل ط32, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
}

// IEEE 754-2019 minimum/maximum spelled with compares and selects, for
// targets whose LLVM back end may not lower llvm.minimum/llvm.maximum without
// a libm call: unordered gives a + b (a quiet NaN); equal operands (only the
// sign of a zero can differ) combine their bits with OR (minimum: -0 wins) or
// AND (maximum: +0 wins); otherwise an ordered compare selects.
عرف ابن_أدنى_أقصى_صريح_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    البتات: طبيعي,
    أقصى: منطقي
): مرجع_قيمة_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع النوع: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(أ);
    دع نوع_الصحيح: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, البتات مثل ط32);
    // LLVMRealPredicate: OEQ 1, OGT 2, OLT 4, UNO 8.
    دع محمول_الترتيب: متغير محمول_مقارنة_عائمة_إل_إل_في_إم = 4;
    إذا (أقصى) { محمول_الترتيب := 2; };
    دع غير_مرتب: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_عشرية_إل_إل_في_إم(الباني, 8, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع مرتب: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_عشرية_إل_إل_في_إم(الباني, محمول_الترتيب, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع المختار: مرجع_قيمة_إل_إل_في_إم = ابن_اختيار_إل_إل_في_إم(الباني, مرتب, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع متساويان: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_عشرية_إل_إل_في_إم(الباني, 1, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بتات_أ: مرجع_قيمة_إل_إل_في_إم = ابن_إعادة_تفسير_إل_إل_في_إم(الباني, أ, نوع_الصحيح,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بتات_ب: مرجع_قيمة_إل_إل_في_إم = ابن_إعادة_تفسير_إل_إل_في_إم(الباني, ب, نوع_الصحيح,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بتات_الصفر: متغير مرجع_قيمة_إل_إل_في_إم = ابن_أو_بتي_إل_إل_في_إم(الباني, بتات_أ, بتات_ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    إذا (أقصى) {
        بتات_الصفر := ابن_و_بتي_إل_إل_في_إم(الباني, بتات_أ, بتات_ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    };
    دع الصفر: مرجع_قيمة_إل_إل_في_إم = ابن_إعادة_تفسير_إل_إل_في_إم(الباني, بتات_الصفر, النوع,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع المرتب: مرجع_قيمة_إل_إل_في_إم = ابن_اختيار_إل_إل_في_إم(الباني, متساويان, الصفر, المختار,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع النان: مرجع_قيمة_إل_إل_في_إم = ابن_جمع_عشري_إل_إل_في_إم(الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    أرجع ابن_اختيار_إل_إل_في_إم(الباني, غير_مرتب, النان, المرتب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
}

// The float primitives (primitive_identity.sn, عملية_عائمة_بدائية) as the
// LLVM intrinsics rustc emits for f64::sqrt, abs, floor, ceil, trunc,
// round_ties_even, minimum, maximum, copysign and mul_add.
عرف ابن_عملية_عائمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    العملية: عملية_عائمة_بدائية
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا (!يدعم_عملية_عائمة_للهدف(الهدف, العملية)
        || (الطول((*النداء).الحجج) مثل طبيعي) != عدد_معاملات_عملية_عائمة(العملية)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    دع المعرف: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(م) -> { المعرف := م; };
    دع البتات: طبيعي;
    طابق نوع_قيمة_مسير(المسير, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المعرف)); }
    | اختياري.موجود(ن) -> {
        طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, ن) مع
        | اختياري.موجود(ب) -> { البتات := ب; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    };
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(الحجج, القيمة); };
        ف := ف + 1;
    }
    دع المعمارية: هوية_معمارية = (*الهدف).المعمارية.الهوية;
    // LLVM lowers llvm.minimum/llvm.maximum natively on AArch64 (FMIN/FMAX),
    // WebAssembly (f64.min/max) and x86-64 (custom SSE lowering).
    دع أدنى_أصلي: منطقي = المعمارية == هوية_معمارية.ذراع_أربعة_وستون()
        || المعمارية == هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون()
        || المعمارية == هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون();
    دع القيمة: متغير مرجع_قيمة_إل_إل_في_إم = الحجج[0];
    طابق العملية مع
    | عملية_عائمة_بدائية.جذر_تربيعي -> { القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.sqrt», &متغير الحجج); }
    | عملية_عائمة_بدائية.قيمة_مطلقة -> { القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.fabs», &متغير الحجج); }
    | عملية_عائمة_بدائية.أرضية -> { القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.floor», &متغير الحجج); }
    | عملية_عائمة_بدائية.سقف -> { القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.ceil», &متغير الحجج); }
    | عملية_عائمة_بدائية.بتر -> { القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.trunc», &متغير الحجج); }
    | عملية_عائمة_بدائية.تقريب_زوجي -> {
        القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.roundeven», &متغير الحجج);
    }
    | عملية_عائمة_بدائية.أدنى -> {
        إذا (أدنى_أصلي) { القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.minimum», &متغير الحجج); }
        وإلا { القيمة := ابن_أدنى_أقصى_صريح_إل_إل_في_إم(الحالة, الحجج[0], الحجج[1], البتات, خطأ); };
    }
    | عملية_عائمة_بدائية.أقصى -> {
        إذا (أدنى_أصلي) { القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.maximum», &متغير الحجج); }
        وإلا { القيمة := ابن_أدنى_أقصى_صريح_إل_إل_في_إم(الحالة, الحجج[0], الحجج[1], البتات, صواب); };
    }
    | عملية_عائمة_بدائية.نسخ_إشارة -> {
        القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.copysign», &متغير الحجج);
    }
    | عملية_عائمة_بدائية.ضرب_جمع_مدمج -> {
        القيمة := ابن_جوهر_عائم_إل_إل_في_إم(الحالة, «llvm.fma», &متغير الحجج);
    };
    ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(القيمة));
    أرجع اختياري.لا_شيء();
}

// Thread support (docs/en/reference/concurrency.md). Every ordering is lowered at
// sequentially consistent strength (LLVMAtomicOrdering SequentiallyConsistent
// = 7), which is always sound; the std API records the requested ordering.
// The first operand is a reference, already a pointer in LLVM.
عرف نوع_نتيجة_بدائي_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة مرجع_نوع_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, المعرف) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المعرف)); }
    | اختياري.موجود(ت) -> { النوع := ت; };
    طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { أرجع نتيجة.نجح(ق.التمثيل); };
}

عرف ابن_بدائي_ذري_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المسير: &سياق_مستهلك_مسير,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    البدائي: هوية_بدائي_مترجم
): اختياري فشل_مزود_إل_إل_في_إم {
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(الحجج, القيمة); };
        ف := ف + 1;
    }
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    طابق البدائي مع
    | هوية_بدائي_مترجم.سياج_ذاكرة -> {
        دع اسم_س: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
        LLVMBuildFence((*الحالة).الباني, 7, 0, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_س));
        أرجع اختياري.لا_شيء();
    }
    | هوية_بدائي_مترجم.ذري_خزن -> {
        إذا ((الطول(الحجج) مثل طبيعي) < 2) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع المخزن: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, الحجج[1], الحجج[0]);
        LLVMSetOrdering(المخزن, 7);
        // Natural alignment: i386 aligns an i64 to 4 bytes, and an atomic
        // access below its size is a __atomic_* library call std does not link.
        ضع_محاذاة_قيمة_إل_إل_في_إم(المخزن, LLVMGetIntTypeWidth(نوع_قيمة_إل_إل_في_إم(الحجج[1])) / 8);
        أرجع اختياري.لا_شيء();
    }
    | _ -> { };
    دع معرف_الناتج: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(ن) -> { معرف_الناتج := ن; };
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    طابق البدائي مع
    | هوية_بدائي_مترجم.ذري_حمل -> {
        دع نوع_الناتج: مرجع_نوع_إل_إل_في_إم;
        طابق نوع_نتيجة_بدائي_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, المسير, معرف_الناتج) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ت) -> { نوع_الناتج := ت; };
        دع المحمل: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_الناتج, الحجج[0], مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        LLVMSetOrdering(المحمل, 7);
        ضع_محاذاة_قيمة_إل_إل_في_إم(المحمل, LLVMGetIntTypeWidth(نوع_الناتج) / 8);
        ضع_قيمة_إل_إل_في_إم(الدالة, معرف_الناتج, تمثيل_قيمة_إل_إل_في_إم.سلمية(المحمل));
        أرجع اختياري.لا_شيء();
    }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> {
        إذا ((الطول(الحجج) مثل طبيعي) < 3) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع النتيجة: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAtomicCmpXchg(
            (*الحالة).الباني, الحجج[0], الحجج[1], الحجج[2], 7, 7, 0
        );
        دع اسم_ق: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
        دع القديم: مرجع_قيمة_إل_إل_في_إم = LLVMBuildExtractValue((*الحالة).الباني, النتيجة, 0, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_ق));
        ضع_قيمة_إل_إل_في_إم(الدالة, معرف_الناتج, تمثيل_قيمة_إل_إل_في_إم.سلمية(القديم));
        أرجع اختياري.لا_شيء();
    }
    | _ -> { };
    إذا ((الطول(الحجج) مثل طبيعي) < 2) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع العملية: متغير ص32 = 0;
    طابق البدائي مع
    | هوية_بدائي_مترجم.ذري_تبديل -> { العملية := 0; }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> { العملية := 1; }
    | هوية_بدائي_مترجم.ذري_جلب_و -> { العملية := 3; }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> { العملية := 5; }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { العملية := 6; }
    | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع القديم: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAtomicRMW((*الحالة).الباني, العملية, الحجج[0], الحجج[1], 7, 0);
    ضع_قيمة_إل_إل_في_إم(الدالة, معرف_الناتج, تمثيل_قيمة_إل_إل_في_إم.سلمية(القديم));
    أرجع اختياري.لا_شيء();
}

// A leaked box is the identity on the value's LLVM representation (one
// pointer): copy the operand to the result.
عرف ابن_بدائي_تطابق_إل_إل_في_إم(
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع المصدر: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[0]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { المصدر := ق; };
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(ن) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(المصدر)); };
    أرجع اختياري.لا_شيء();
}

// A value as an integer of عرض bits: a pointer through ptrtoint, a narrower
// integer zero-extended, a wider one truncated.
عرف كلمة_بعرض_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    القيمة: مرجع_قيمة_إل_إل_في_إم,
    العرض: ط32
): مرجع_قيمة_إل_إل_في_إم {
    دع نوع_الكلمة: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, العرض);
    دع ف: متغير متجه ط8 = [0];
    إذا (LLVMGetTypeKind(نوع_قيمة_إل_إل_في_إم(القيمة)) == 12) {
        أرجع ابن_تحويل_مؤشر_إلى_صحيح_إل_إل_في_إم((*الحالة).الباني, القيمة, نوع_الكلمة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير ف));
    };
    دع عرض_القيمة: ط32 = LLVMGetIntTypeWidth(نوع_قيمة_إل_إل_في_إم(القيمة));
    إذا (عرض_القيمة > العرض) {
        أرجع ابن_اقتطاع_إل_إل_في_إم((*الحالة).الباني, القيمة, نوع_الكلمة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير ف));
    };
    إذا (عرض_القيمة < العرض) {
        أرجع ابن_توسيع_صفري_إل_إل_في_إم((*الحالة).الباني, القيمة, نوع_الكلمة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير ف));
    };
    أرجع القيمة;
}

عرف مؤشر_من_قيمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    القيمة: مرجع_قيمة_إل_إل_في_إم
): مرجع_قيمة_إل_إل_في_إم {
    إذا (LLVMGetTypeKind(نوع_قيمة_إل_إل_في_إم(القيمة)) == 12) { أرجع القيمة; };
    دع ف: متغير متجه ط8 = [0];
    أرجع ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
        (*الحالة).الباني, القيمة, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير ف)
    );
}

// The closure-address conversions (docs/en/reference/concurrency.md). A closure value is
// the address of its environment, whose first word is the code pointer; in
// LLVM the code takes the environment as its first parameter with the C
// calling convention, so a `() -> ()` closure's code pointer is already a C
// entry `void entry(void *environment)`, which pthread_create, CreateThread
// and thr_new call with the environment as the argument.
عرف ابن_بدائي_عنوان_دالة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    البدائي: هوية_بدائي_مترجم
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع المصدر: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[0]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { المصدر := ق; };
    دع المعرف: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(ن) -> { المعرف := ن; };
    دع الناتج_الجديد: متغير مرجع_قيمة_إل_إل_في_إم = المصدر;
    طابق البدائي مع
    | هوية_بدائي_مترجم.عنوان_دالة -> { الناتج_الجديد := كلمة_بعرض_إل_إل_في_إم(الحالة, المصدر, 64); }
    | هوية_بدائي_مترجم.دالة_من_عنوان -> { الناتج_الجديد := مؤشر_من_قيمة_إل_إل_في_إم(الحالة, المصدر); }
    | هوية_بدائي_مترجم.مدخل_سي_لدالة -> {
        دع البيئة: مرجع_قيمة_إل_إل_في_إم = مؤشر_من_قيمة_إل_إل_في_إم(الحالة, المصدر);
        دع ف: متغير متجه ط8 = [0];
        دع الرمز: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم(
            (*الحالة).الباني, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق), البيئة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير ف)
        );
        الناتج_الجديد := كلمة_بعرض_إل_إل_في_إم(الحالة, الرمز, 64);
    }
    | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(الناتج_الجديد));
    أرجع اختياري.لا_شيء();
}

// The C call at an address (بدائي_نداء_عنوان_سي): an indirect call with the C
// calling convention, as Rust lowers a call through an `extern "C" fn`
// pointer. The arguments are the result witness (its LLVM type, i64 or
// double, is the result type), the address, eight integer words and eight
// float words. The call type differs by ABI:
// - System V x86-64: `ret (...)`, every word a variadic argument, so LLVM
//   assigns them as for a prototyped call (six integer registers, then the
//   stack; xmm0-7) and also sets AL, which a variadic callee reads;
// - Windows x64: `ret (...)` with positional words: the first four as
//   double, which the Win64 variadic convention passes in xmm k and copies
//   to the k-th integer register (so an integer or a float parameter finds
//   the same bits), the next four as i64 on the stack;
// - otherwise (AAPCS64, including Apple's, RISC-V LP64D): the prototyped
//   `ret (i64 x8, double x8)`; no variadic argument is passed, so Apple's
//   rule that variadic arguments go on the stack never arises.
عرف ابن_نداء_عنوان_سي_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 18 || (*الهدف).نموذج_البيانات.عرض_المؤشر != 64) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    دع المعرف: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(ن) -> { المعرف := ن; };
    دع السياق: مرجع_سياق_إل_إل_في_إم = (*الحالة).السياق;
    دع نوع_ص64: مرجع_نوع_إل_إل_في_إم = LLVMInt64TypeInContext(السياق);
    دع نوع_ع64: مرجع_نوع_إل_إل_في_إم = LLVMDoubleTypeInContext(السياق);
    دع القيم: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 18) {
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ق) -> { ألحق(القيم, ق); };
        ف := ف + 1;
    }
    دع ناتج_عائم: منطقي = LLVMGetTypeKind(نوع_قيمة_إل_إل_في_إم(القيم[0])) == 3;
    دع نوع_الناتج: متغير مرجع_نوع_إل_إل_في_إم = نوع_ص64;
    إذا (ناتج_عائم) { نوع_الناتج := نوع_ع64; };
    دع اسم: متغير متجه ط8 = [0];
    دع المستدعى: مرجع_قيمة_إل_إل_في_إم = مؤشر_من_قيمة_إل_إل_في_إم(الحالة, كلمة_بعرض_إل_إل_في_إم(الحالة, القيم[1], 64));
    // The words as i64 and double values.
    دع الصحاح: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع العشريات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    ف := 0;
    طالما (ف < 8) {
        ألحق(الصحاح, كلمة_بعرض_إل_إل_في_إم(الحالة, القيم[2 + ف], 64));
        دع العشري: متغير مرجع_قيمة_إل_إل_في_إم = القيم[10 + ف];
        إذا (LLVMGetTypeKind(نوع_قيمة_إل_إل_في_إم(العشري)) != 3) {
            العشري := ابن_إعادة_تفسير_إل_إل_في_إم((*الحالة).الباني, كلمة_بعرض_إل_إل_في_إم(الحالة, العشري, 64),
                نوع_ع64, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        };
        ألحق(العشريات, العشري);
        ف := ف + 1;
    }
    دع إكس64: منطقي = (*الهدف).المعمارية.الهوية == هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون();
    دع ويندوز: منطقي = (*الهدف).المنصة.المنصة == هوية_منصة.ويندوز();
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    دع متغير_الحجج: متغير ط32 = 0;
    إذا (إكس64 && ويندوز) {
        ف := 0;
        طالما (ف < 8) {
            إذا (ف < 4) {
                ألحق(الحجج, ابن_إعادة_تفسير_إل_إل_في_إم((*الحالة).الباني, الصحاح[ف], نوع_ع64,
                    مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
            } وإلا {
                ألحق(الحجج, الصحاح[ف]);
            };
            ف := ف + 1;
        }
        متغير_الحجج := 1;
    } وإلا {
        ف := 0;
        طالما (ف < 8) { ألحق(الحجج, الصحاح[ف]); ألحق(المعاملات, نوع_ص64); ف := ف + 1; }
        ف := 0;
        طالما (ف < 8) { ألحق(الحجج, العشريات[ف]); ألحق(المعاملات, نوع_ع64); ف := ف + 1; }
        إذا (إكس64) {
            متغير_الحجج := 1;
        };
    };
    // A variadic call type has no fixed parameter.
    دع نوع_الدالة: متغير مرجع_نوع_إل_إل_في_إم = نوع_الناتج;
    إذا (متغير_الحجج == 1) {
        دع بلا_معاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_ص64];
        نوع_الدالة := LLVMFunctionType(نوع_الناتج, &متغير بلا_معاملات[0], 0, 1);
    } وإلا {
        نوع_الدالة := LLVMFunctionType(نوع_الناتج, &متغير المعاملات[0], 16, 0);
    };
    دع النتيجة: مرجع_قيمة_إل_إل_في_إم = ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, المستدعى,
        &متغير الحجج[0], (الطول(الحجج) مثل ط32), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(النتيجة));
    أرجع اختياري.لا_شيء();
}

// The Linux thread clone (docs/en/reference/concurrency.md). std passes the clone number,
// the flags, the new stack's top, the parent-tid, child-tid and TLS words
// (std passes the tid cell for all three: CLONE_SETTLS is not set, so the
// TLS word is ignored, and the order of the three differs between
// architectures, CLONE_BACKWARDS in kernel/fork.c) and the environment of
// the closure the thread runs. The environment is stored at the 16-byte
// aligned top of the new stack, which becomes the child's stack pointer; the
// child loads it from there, calls the closure's code with it as the first
// argument and leaves with the thread-only exit system call when the closure
// returns, as musl's __clone does (src/thread/<arch>/clone.s; Go's
// runtime·clone). s390x takes the stack before the flags (CLONE_BACKWARDS2).
عرف ابن_استنساخ_خيط_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    دع نواة_لينكس: منطقي = (*الهدف).المنصة.المنصة == هوية_منصة.لينكس()
        || (*الهدف).المنصة.المنصة == هوية_منصة.أندرويد();
    دع عرض_الكلمة: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر;
    إذا (!نواة_لينكس || (عرض_الكلمة != 64 && عرض_الكلمة != 32) || (الطول((*النداء).الحجج) مثل طبيعي) != 7) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    دع رمز_التجميع: متغير متجه ط8 = [];
    دع رمز_القيود: متغير متجه ط8 = [];
    دع المكدس_أولا: متغير منطقي = خطأ;
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص("syscall\ntestq %rax, %rax\njnz 1f\nxorl %ebp, %ebp\nmovq (%rsp), %rdi\ncallq *(%rdi)\nxorl %edi, %edi\nmovl $$60, %eax\nsyscall\nud2\n1:");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={rax},0,{rdi},{rsi},{rdx},{r10},{r8},~{rcx},~{r11},~{flags},~{memory}»);
        رمز_القيود := ق;
    }
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص("int $$0x80\ntestl %eax, %eax\njnz 1f\nxorl %ebp, %ebp\nmovl (%esp), %eax\ncalll *(%eax)\nxorl %ebx, %ebx\nmovl $$1, %eax\nint $$0x80\nud2\n1:");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={eax},0,{ebx},{ecx},{edx},{esi},{edi},~{flags},~{memory}»);
        رمز_القيود := ق;
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص("svc #0\ncbnz x0, 1f\nmov x29, #0\nmov x30, #0\nldr x0, [sp]\nldr x16, [x0]\nblr x16\nmov x0, #0\nmov x8, #93\nsvc #0\nbrk #0\n1:");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={x0},{x8},0,{x1},{x2},{x3},{x4},~{x16},~{x30},~{memory},~{cc}»);
        رمز_القيود := ق;
    }
    | هوية_معمارية.ذراع_سبعة -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص("svc 0\ncmp r0, #0\nbne 1f\nmov lr, #0\nldr r0, [sp]\nldr ip, [r0]\nblx ip\nmov r0, #0\nmov r7, #1\nsvc 0\nudf #0\n1:");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={r0},{r7},0,{r1},{r2},{r3},{r4},~{r12},~{lr},~{memory},~{cc}»);
        رمز_القيود := ق;
    }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص("ecall\nbnez a0, 1f\nmv s0, zero\nmv ra, zero\nld a0, 0(sp)\nld t0, 0(a0)\njalr t0\nmv a0, zero\nli a7, 93\necall\nunimp\n1:");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={x10},{x17},0,{x11},{x12},{x13},{x14},~{x5},~{x1},~{memory}»);
        رمز_القيود := ق;
    }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص("syscall 0\nbnez $$a0, 1f\nor $$fp, $$zero, $$zero\nor $$ra, $$zero, $$zero\nld.d $$a0, $$sp, 0\nld.d $$t0, $$a0, 0\njirl $$ra, $$t0, 0\nor $$a0, $$zero, $$zero\nori $$a7, $$zero, 93\nsyscall 0\nbreak 0\n1:");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={$r4},{$r11},0,{$r5},{$r6},{$r7},{$r8},~{$r1},~{$r12},~{$r13},~{$r14},~{$r15},~{$r16},~{$r17},~{$r18},~{$r19},~{$r20},~{memory}»);
        رمز_القيود := ق;
    }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص("sc\nbns+ 2f\nneg 3, 3\nb 1f\n2:\ncmpdi 3, 0\nbne 1f\nld 3, 0(1)\nli 0, 0\nstdu 0, -32(1)\nld 12, 0(3)\nmtctr 12\nbctrl\nli 3, 0\nli 0, 1\nsc\ntrap\n1:");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={r3},{r0},0,{r4},{r5},{r6},{r7},~{r9},~{r10},~{r11},~{r12},~{cr0},~{ctr},~{xer},~{lr},~{memory}»);
        رمز_القيود := ق;
    }
    | هوية_معمارية.سيستم_زد -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص("svc 0\nltgr %r2, %r2\njnz 1f\nlg %r2, 0(%r15)\naghi %r15, -160\nxc 0(8,%r15), 0(%r15)\nlg %r1, 0(%r2)\nbasr %r14, %r1\nlghi %r2, 0\nlghi %r1, 1\nsvc 0\n.word 0\n1:");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={r2},{r1},0,{r3},{r4},{r5},{r6},~{r14},~{memory},~{cc}»);
        رمز_القيود := ق;
        المكدس_أولا := صواب;
    }
    | هوية_معمارية.ميبس_أربعة_وستون -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص(".set push\n.set noreorder\nmove $$7, $$12\nsyscall\nbeqz $$7, 2f\nnop\nb 1f\ndsubu $$2, $$0, $$2\n2:\nbnez $$2, 1f\nnop\nld $$4, 0($$29)\nld $$25, 0($$4)\njalr $$25\nnop\nmove $$4, $$0\nli $$2, 5058\nsyscall\nbreak\n1:\n.set pop");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={$2},0,{$4},{$5},{$6},{$12},{$8},~{$1},~{$3},~{$7},~{$10},~{$11},~{$13},~{$14},~{$15},~{$24},~{$25},~{$31},~{hi},~{lo},~{memory}»);
        رمز_القيود := ق;
    }
    // SPARC V9 (glibc sysdeps/unix/sysv/linux/sparc/sparc64/clone.S): the
    // kernel takes the child's %sp biased by 2047 and expects a 176-byte
    // register-window save and argument area above it, so the stack word is
    // lowered by 192 + 2047 and the environment slot is [%sp + 2239] in the
    // child. The kernel flags an error with the carry and answers 1 in %o1
    // in the child (0 in the parent).
    | هوية_معمارية.سبارك_أربعة_وستون -> {
        دع ت: متجه ط8 = بايتات_منتهية_بصفر_من_نص("sub %o1, 2239, %o1\nta 0x6d\nbcs,pn %xcc, 2f\nnop\nbrnz,pn %o1, 3f\nnop\nba,pt %xcc, 1f\nnop\n2:\nsub %g0, %o0, %o0\nba,pt %xcc, 1f\nnop\n3:\nmov %g0, %fp\nldx [%sp + 2239], %o0\nldx [%o0], %g2\njmpl %g2, %o7\nnop\nmov 1, %g1\nmov %g0, %o0\nta 0x6d\nunimp 0\n1:");
        رمز_التجميع := ت;
        دع ق: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«={o0},{g1},0,{o1},{o2},{o3},{o4},~{g2},~{o7},~{icc},~{xcc},~{memory}»);
        رمز_القيود := ق;
    }
    | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع العرض: ط32 = عرض_الكلمة مثل ط32;
    دع نوع_العدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, العرض);
    دع الكلمات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 7) {
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(الكلمات, كلمة_بعرض_إل_إل_في_إم(الحالة, القيمة, العرض)); };
        ف := ف + 1;
    }
    // The child's stack pointer: the aligned top less one 16-byte slot that
    // holds the environment.
    دع اسم_م: متغير متجه ط8 = [0];
    دع القناع: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_العدد, 18446744073709551600, صواب);
    دع المحاذى: مرجع_قيمة_إل_إل_في_إم = ابن_و_بتي_إل_إل_في_إم((*الحالة).الباني, الكلمات[2], القناع, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_م));
    دع ستة_عشر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_العدد, 16, خطأ);
    دع المكدس: مرجع_قيمة_إل_إل_في_إم = ابن_طرح_إل_إل_في_إم((*الحالة).الباني, المحاذى, ستة_عشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_م));
    دع خانة_البيئة: مرجع_قيمة_إل_إل_في_إم = مؤشر_من_قيمة_إل_إل_في_إم(الحالة, المكدس);
    دع تجاهل_الخزن: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, الكلمات[6], خانة_البيئة);
    دع قيم_المعاملات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    ألحق(قيم_المعاملات, الكلمات[0]);
    إذا (المكدس_أولا) {
        ألحق(قيم_المعاملات, المكدس);
        ألحق(قيم_المعاملات, الكلمات[1]);
    } وإلا {
        ألحق(قيم_المعاملات, الكلمات[1]);
        ألحق(قيم_المعاملات, المكدس);
    };
    ألحق(قيم_المعاملات, الكلمات[3]);
    ألحق(قيم_المعاملات, الكلمات[4]);
    ألحق(قيم_المعاملات, الكلمات[5]);
    دع أنواع_المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    دع م: متغير طبيعي = 0;
    طالما (م < 6) { ألحق(أنواع_المعاملات, نوع_العدد); م := م + 1; }
    دع التوقيع: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_العدد, &متغير أنواع_المعاملات[0], 6);
    دع التجميع: مرجع_قيمة_إل_إل_في_إم = LLVMGetInlineAsm(
        التوقيع, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير رمز_التجميع), (الطول(رمز_التجميع) - 1) مثل طبيعي,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير رمز_القيود), (الطول(رمز_القيود) - 1) مثل طبيعي, 1, 0, 0, 0
    );
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع قيمة_العودة: متغير مرجع_قيمة_إل_إل_في_إم = ابن_نداء_إل_إل_في_إم(
        (*الحالة).الباني, التوقيع, التجميع, &متغير قيم_المعاملات[0], 6, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
    );
    // A 32-bit result is widened with the -errno range sign-extended.
    إذا (العرض < 64) {
        دع اسم_ت: متغير متجه ط8 = [0];
        قيمة_العودة := ابن_توسيع_إشارة_إل_إل_في_إم((*الحالة).الباني, قيمة_العودة,
            نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_ت));
    };
    طابق الناتج مع
    | اختياري.موجود(المعرف) -> { ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(قيمة_العودة)); }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    أرجع اختياري.لا_شيء();
}

عرف ابن_نداء_تعليمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(المعرف) -> {
        دع العرض: عرض_دالة_مسير;
        طابق ابحث_دالة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); }
        | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
        // هدف النداء المباشر لا يحمل بيئة إغلاق. الدالة ذات الالتقاطات يجب أن تصل
        // عبر قيمة دالة/إغلاق؛ إبقاء هذا الحاجز يمنع اختلاق ABI خاص داخل المزود.
        إذا (العرض.عدد_الالتقاطات > 0) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
        دع الخطة: متغير خطة_دالة_واجهة;
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع القيد: قيد_دالة_إل_إل_في_إم;
        طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
            نتيجة.نجح(ق) -> { القيد := ق; };
        دع بيئة_النداء: متغير اختياري مرجع_قيمة_إل_إل_في_إم = اختياري.لا_شيء();
        إذا (القيد.له_بيئة_إغلاق) {
            دع البيئة_الفارغة: مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(
                نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق)
            );
            بيئة_النداء := اختياري.موجود(البيئة_الفارغة);
        };
        أرجع ابن_نداء_بخطة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, القيد.الدالة,
            القيد.نوع_الدالة, &الخطة, بيئة_النداء, &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.دالة_خارجية(المعرف) -> {
        دع الخطة: متغير خطة_دالة_واجهة;
        طابق حل_واجهة_نداء_خارجي_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الحجج, الناتج) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع القيد: قيد_دالة_خارجية_إل_إل_في_إم;
        طابق ابحث_قيد_دالة_خارجية_إل_إل_في_إم(الحالة, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
            نتيجة.نجح(ق) -> { القيد := ق; };
        أرجع ابن_نداء_بخطة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, القيد.الدالة,
            القيد.نوع_الدالة, &الخطة, اختياري.لا_شيء(), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.قيمة_دالة(معرف_القيمة) -> {
        دع الإغلاق: مرجع_قيمة_إل_إل_في_إم;
        طابق سلمية_إل_إل_في_إم(الدالة, معرف_القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق)
            -> { الإغلاق := ق; };
        دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
        دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
        دع الرمز: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر, الإغلاق,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        دع الخطة: متغير خطة_دالة_واجهة;
        طابق حل_واجهة_هدف_نداء_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الهدف,
            &(*النداء).الحجج, الناتج) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع التوقيع: وصف_توقيع_إل_إل_في_إم;
        طابق ابن_توقيع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, &الخطة, صواب) مع | نتيجة.خطأ(خ) -> {
            أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { التوقيع := ت; };
        أرجع ابن_نداء_بخطة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, الرمز,
            التوقيع.النوع, &الخطة, اختياري.موجود(الإغلاق), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        طابق البدائي مع
        | هوية_بدائي_مترجم.نداء_نواة_خام -> {
            أرجع ابن_نداء_نواة_خام_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, النداء, الناتج);
        }
        | هوية_بدائي_مترجم.معمارية_المضيف -> {
            طابق الناتج مع | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } |
                اختياري.موجود(ن) -> {
                دع الرمز: عدد; طابق رمز_هوية_مضيف_إل_إل_في_إم(الهدف, البدائي) مع | اختياري.لا_شيء -> { أرجع
                    اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختياري.موجود(ر) -> { الرمز := ر; };
                دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختياري.لا_شيء -> { أرجع
                    اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(ن)); } | اختياري.موجود(ت) -> { النوع := ت; };
                دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط,
                    النوع) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
                    نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
                ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل,
                    الرمز مثل ط64, صواب))); أرجع اختياري.لا_شيء();
            }; }
        | هوية_بدائي_مترجم.منصة_المضيف -> {
            طابق الناتج مع | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } |
                اختياري.موجود(ن) -> {
                دع الرمز: عدد; طابق رمز_هوية_مضيف_إل_إل_في_إم(الهدف, البدائي) مع | اختياري.لا_شيء -> { أرجع
                    اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختياري.موجود(ر) -> { الرمز := ر; };
                دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختياري.لا_شيء -> { أرجع
                    اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(ن)); } | اختياري.موجود(ت) -> { النوع := ت; };
                دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط,
                    النوع) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
                    نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
                ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل,
                    الرمز مثل ط64, صواب))); أرجع اختياري.لا_شيء();
            }; }
        | هوية_بدائي_مترجم.بيئة_المضيف -> {
            طابق الناتج مع | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } |
                اختياري.موجود(ن) -> {
                دع الرمز: عدد; طابق رمز_هوية_مضيف_إل_إل_في_إم(الهدف, البدائي) مع | اختياري.لا_شيء -> { أرجع
                    اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختياري.موجود(ر) -> { الرمز := ر; };
                دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختياري.لا_شيء -> { أرجع
                    اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(ن)); } | اختياري.موجود(ت) -> { النوع := ت; };
                دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط,
                    النوع) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
                    نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
                ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل,
                    الرمز مثل ط64, صواب))); أرجع اختياري.لا_شيء();
            }; }
        | هوية_بدائي_مترجم.بتات_ع64 -> { }
        | هوية_بدائي_مترجم.ع64_من_بتات -> { }
        | هوية_بدائي_مترجم.بتات_ع32 -> { }
        | هوية_بدائي_مترجم.ع32_من_بتات -> { }
        | هوية_بدائي_مترجم.طول -> { }
        | هوية_بدائي_مترجم.إلحاق -> { }
        | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> {
            أرجع ابن_بدائي_ذاكرة_آلة_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> {
            أرجع ابن_بدائي_ذاكرة_آلة_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.عملية_عائمة(العملية) -> {
            أرجع ابن_عملية_عائمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, النداء, الناتج, العملية);
        }
        | هوية_بدائي_مترجم.ذري_حمل -> { أرجع ابن_بدائي_ذري_إل_إل_في_إم(الحالة, الدالة, الحقائق, الهدف, سجل_التخطيط, المسير, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.ذري_خزن -> { أرجع ابن_بدائي_ذري_إل_إل_في_إم(الحالة, الدالة, الحقائق, الهدف, سجل_التخطيط, المسير, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.ذري_تبديل -> { أرجع ابن_بدائي_ذري_إل_إل_في_إم(الحالة, الدالة, الحقائق, الهدف, سجل_التخطيط, المسير, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { أرجع ابن_بدائي_ذري_إل_إل_في_إم(الحالة, الدالة, الحقائق, الهدف, سجل_التخطيط, المسير, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.ذري_جلب_جمع -> { أرجع ابن_بدائي_ذري_إل_إل_في_إم(الحالة, الدالة, الحقائق, الهدف, سجل_التخطيط, المسير, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.ذري_جلب_و -> { أرجع ابن_بدائي_ذري_إل_إل_في_إم(الحالة, الدالة, الحقائق, الهدف, سجل_التخطيط, المسير, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.ذري_جلب_أو -> { أرجع ابن_بدائي_ذري_إل_إل_في_إم(الحالة, الدالة, الحقائق, الهدف, سجل_التخطيط, المسير, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { أرجع ابن_بدائي_ذري_إل_إل_في_إم(الحالة, الدالة, الحقائق, الهدف, سجل_التخطيط, المسير, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.سياج_ذاكرة -> { أرجع ابن_بدائي_ذري_إل_إل_في_إم(الحالة, الدالة, الحقائق, الهدف, سجل_التخطيط, المسير, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.سرب_قيمة -> { أرجع ابن_بدائي_تطابق_إل_إل_في_إم(الدالة, النداء, الناتج); }
        | هوية_بدائي_مترجم.عنوان_دالة -> { أرجع ابن_بدائي_عنوان_دالة_إل_إل_في_إم(الحالة, الدالة, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.دالة_من_عنوان -> { أرجع ابن_بدائي_عنوان_دالة_إل_إل_في_إم(الحالة, الدالة, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.مدخل_سي_لدالة -> { أرجع ابن_بدائي_عنوان_دالة_إل_إل_في_إم(الحالة, الدالة, النداء, الناتج, البدائي); }
        | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> { أرجع ابن_استنساخ_خيط_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج); }
        | هوية_بدائي_مترجم.نداء_عنوان_سي -> { أرجع ابن_نداء_عنوان_سي_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج); }
        | _ -> {
            دع الخطة: متغير خطة_دالة_واجهة;
            طابق حل_واجهة_نداء_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الحجج, الناتج) مع
            | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
            | نتيجة.نجح(خ) -> { الخطة := خ; };
            دع المستدعى: مرجع_قيمة_إل_إل_في_إم; دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم;
            طابق أعلن_بدائي_تشغيل_للنداء_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, البدائي, &متغير الخطة) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(ت) -> { المستدعى := ت.الدالة; نوع_الدالة := ت.النوع; };
            أرجع ابن_نداء_بخطة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, المستدعى,
                نوع_الدالة, &الخطة, اختياري.لا_شيء(), &(*النداء).الحجج, الناتج);
        };
        // Four bit-reinterpret primitives are represented as a pure LLVM bitcast.
        دع إعادة_تفسير: متغير منطقي = خطأ;
        طابق البدائي مع
        | هوية_بدائي_مترجم.بتات_ع64 -> { إعادة_تفسير := صواب; }
        | هوية_بدائي_مترجم.ع64_من_بتات -> { إعادة_تفسير := صواب; }
        | هوية_بدائي_مترجم.بتات_ع32 -> { إعادة_تفسير := صواب; }
        | هوية_بدائي_مترجم.ع32_من_بتات -> { إعادة_تفسير := صواب; }
        | _ -> { };
        إذا (إعادة_تفسير) {
            إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 1) { أرجع
                اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
            دع ن: معرف_قيمة_مسير; طابق الناتج مع | اختياري.لا_شيء -> { أرجع
                اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختياري.موجود(ق) -> { ن := ق; };
            دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[0]) مع |
                نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { المصدر := ق; };
            دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختياري.لا_شيء -> { أرجع
                اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(ن)); } | اختياري.موجود(ت) -> { النوع := ت; };
            دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع)
                مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> {
                القيد := ق; };
            دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
            ضع_قيمة_إل_إل_في_إم(الدالة, ن,
                تمثيل_قيمة_إل_إل_في_إم.سلمية(ابن_إعادة_تفسير_إل_إل_في_إم((*الحالة).الباني, المصدر,
                القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))));
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
}

عرف ابن_بناء_موسوم_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    البناء: &بناء_موسوم_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { النوع := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق;
        };
    دع التخطيط: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ) ->
        { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع تعداد: تخطيط_تعداد; طابق تعداد_تخطيط_إل_إل_في_إم(&التخطيط) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختياري.موجود(ت) -> { تعداد := ت; };
    دع خطة_المنشئ: تخطيط_حمولات_منشئ;
    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, الناتج, (*البناء).المنشئ) مع
    | نتيجة_تخطيط_منشئ.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(النوع)); }
    | نتيجة_تخطيط_منشئ.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(النوع)); }
    | نتيجة_تخطيط_منشئ.مكتمل(خ) -> { خطة_المنشئ := خ; };
    إذا ((الطول((*البناء).الحمولات) مثل طبيعي) != (الطول(خطة_المنشئ.الحمولات) مثل طبيعي)) { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
    دع نوع_الوسم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (تعداد.الوسم.الحجم * 8) مثل
        ط32);
    دع قيمة_الوسم: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_الوسم, خطة_المنشئ.قيمة_الوسم مثل ط64, خطأ);
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, قيمة_الوسم, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
        تعداد.الوسم.الإزاحة));
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البناء).الحمولات) مثل طبيعي)) {
        دع معرف_الحمولة: معرف_قيمة_مسير = (*البناء).الحمولات[ف];
        دع نوع_الحمولة: معرف_نوع; طابق نوع_قيمة_مسير(المسير, معرف_الحمولة) مع | اختياري.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(معرف_الحمولة)); } | اختياري.موجود(ن) -> { نوع_الحمولة := ن;
            };
        دع تمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, معرف_الحمولة) مع |
            نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { تمثيل
            := ق; };
        دع الإزاحة: طبيعي = تعداد.مخزن_الحمولة.الإزاحة + خطة_المنشئ.الحمولات[ف].الإزاحة;
        طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الحمولة,
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, الإزاحة), &تمثيل) مع | اختياري.موجود(خ) -> { أرجع
            نتيجة.خطأ(خ); } | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف ابن_استعلام_وسم_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    العملية: &استعلام_وسم_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع التخطيط: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, (*العملية).المصدر)
        مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع تعداد: تخطيط_تعداد; طابق تعداد_تخطيط_إل_إل_في_إم(&التخطيط) مع | اختياري.لا_شيء -> { دع ن: معرف_نوع; طابق
        نوع_قيمة_مسير(المسير, (*العملية).المصدر) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).المصدر)); } | اختياري.موجود(ق) -> { ن := ق; }; أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(ن)); } | اختياري.موجود(ت) -> { تعداد := ت; };
    دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, (*العملية).المصدر) مع | نتيجة.خطأ(خ) -> {
        أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ع) -> { المصدر := ع; };
    دع نوع_الوسم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (تعداد.الوسم.الحجم * 8) مثل
        ط32);
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع الوسم: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_الوسم,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المصدر, تعداد.الوسم.الإزاحة), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع نوع_الناتج: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { نوع_الناتج := ن; };
    دع قيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد := ق; };
    دع البتات_وسم: طبيعي = تعداد.الوسم.الحجم * 8;
    دع قيمة: متغير مرجع_قيمة_إل_إل_في_إم = الوسم;
    إذا (البتات_وسم < 32) { قيمة := ابن_توسيع_صفري_إل_إل_في_إم((*الحالة).الباني, الوسم, قيد.التمثيل,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)); }
    وإلا إذا (البتات_وسم > 32) { قيمة := ابن_اقتطاع_إل_إل_في_إم((*الحالة).الباني, الوسم, قيد.التمثيل,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)); };
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(قيمة));
}

عرف ابن_استخراج_حمولة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    العملية: &استخراج_حمولة_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع التخطيط: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, (*العملية).المصدر)
        مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع تعداد: تخطيط_تعداد; طابق تعداد_تخطيط_إل_إل_في_إم(&التخطيط) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختياري.موجود(ت) -> { تعداد := ت; };
    دع نوع_المصدر: معرف_نوع; طابق نوع_قيمة_مسير(المسير, (*العملية).المصدر) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).المصدر)); } | اختياري.موجود(ن) -> { نوع_المصدر := ن;
        };
    دع خطة: تخطيط_حمولات_منشئ; طابق تخطيط_منشئ_قيمة_مسير_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط,
        (*العملية).المصدر, (*العملية).المنشئ) مع | نتيجة_تخطيط_منشئ.مؤجل(_) -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(نوع_المصدر)); } | نتيجة_تخطيط_منشئ.مرفوض(_) -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(نوع_المصدر)); } | نتيجة_تخطيط_منشئ.مكتمل(خ) -> { خطة := خ; };
    إذا ((*العملية).الحمولة >= (الطول(خطة.الحمولات) مثل طبيعي)) { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, (*العملية).المصدر) مع | نتيجة.خطأ(خ) -> {
        أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ع) -> { المصدر := ع; };
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { النوع := ن; };
    دع فهرس_الحمولة: طبيعي = (*العملية).الحمولة;
    دع الإزاحة: طبيعي = تعداد.مخزن_الحمولة.الإزاحة + خطة.الحمولات[فهرس_الحمولة].الإزاحة;
    طابق حمّل_من_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المصدر, الإزاحة)) مع | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع
        نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { أرجع نتيجة.نجح(ق); };
}

عرف ابن_بناء_صندوق_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    العملية: &بناء_صندوق_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, (*العملية).القيمة) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).القيمة)); } | اختياري.موجود(ن) -> { النوع := ن; };
    دع التخطيط: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ) ->
        { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل ط32);
    دع الحجم: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, التخطيط.الحجم مثل ط64, خطأ);
    دع المكان: مرجع_قيمة_إل_إل_في_إم; طابق ابن_تخصيص_ذاكرة_إل_إل_في_إم(الحالة, الهدف, الحجم) مع | اختياري.لا_شيء
        -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختياري.موجود(ق) -> {
        تحقق_تخصيص_إل_إل_في_إم(الحالة, الدالة, ق);
        المكان := ق;
    };
    دع التمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, (*العملية).القيمة) مع |
        نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل :=
        ق; };
    طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع, المكان, &التمثيل) مع |
        اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); } | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(المكان));
}

عرف ابن_بناء_إغلاق_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    البناء: &بناء_إغلاق_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع العرض: عرض_دالة_مسير; طابق ابحث_دالة_مسير(المسير, (*البناء).الدالة) مع | نتيجة_بحث_دالة_مسير.مفقودة(_) ->
        { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.دالة_مفقودة((*البناء).الدالة)); } | نتيجة_بحث_دالة_مسير.موجودة(ع)
        -> { العرض := ع; };
    دع الخطة: تخطيط_بيئة_إغلاق_اختيار; طابق خطط_بيئة_إغلاق_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط,
        (*البناء).الدالة, العرض.عدد_الالتقاطات) مع | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مؤجل -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(خ)
        -> { الخطة := خ; };
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل ط32);
    دع الحجم: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, الخطة.الحجم مثل ط64, خطأ);
    دع البيئة: مرجع_قيمة_إل_إل_في_إم; طابق ابن_تخصيص_ذاكرة_إل_إل_في_إم(الحالة, الهدف, الحجم) مع | اختياري.لا_شيء
        -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختياري.موجود(ق) -> {
        تحقق_تخصيص_إل_إل_في_إم(الحالة, الدالة, ق);
        البيئة := ق;
    };
    دع قيد_الدالة: قيد_دالة_إل_إل_في_إم; طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, (*البناء).الدالة) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { قيد_الدالة := ق; };
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, قيد_الدالة.الدالة, البيئة);
    // The environment header: one reference, and the destructor.
    دع نوع_العداد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, ثابت_صحيح_إل_إل_في_إم(نوع_العداد, 1, خطأ),
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, البيئة, إزاحة_عداد_بيئة_إغلاق()));
    طابق (*البناء).المدمر مع
    | اختياري.موجود(المدمر) -> {
        دع قيد_المدمر: قيد_دالة_إل_إل_في_إم; طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المدمر) مع |
            نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { قيد_المدمر := ق; };
        ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, قيد_المدمر.الدالة,
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, البيئة, إزاحة_مدمر_بيئة_إغلاق()));
    }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البناء).الالتقاطات) مثل طبيعي)) {
        إذا (ف >= (الطول(الخطة.إزاحات_الالتقاطات) مثل طبيعي)) { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
        دع المعرف: معرف_قيمة_مسير = (*البناء).الالتقاطات[ف]; دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير,
            المعرف) مع | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المعرف)); } |
            اختياري.موجود(ن) -> { النوع := ن; };
        دع تمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع |
            نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { تمثيل
            := ق; };
        طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع,
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, البيئة, الخطة.إزاحات_الالتقاطات[ف]), &تمثيل) مع | اختياري.موجود(خ)
            -> { أرجع نتيجة.خطأ(خ); } | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(البيئة));
}

عرف ابن_استخراج_التقاط_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير, العملية: &استخراج_التقاط_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع البيئة: مرجع_قيمة_إل_إل_في_إم; طابق (*الدالة).بيئة_الإغلاق مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختياري.موجود(ب) -> { البيئة := ب; };
    دع العرض: عرض_دالة_مسير; طابق ابحث_دالة_مسير(المسير, (*الدالة).المعرف) مع | نتيجة_بحث_دالة_مسير.مفقودة(_) ->
        { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.دالة_مفقودة((*الدالة).المعرف)); } | نتيجة_بحث_دالة_مسير.موجودة(ع)
        -> { العرض := ع; };
    دع الخطة: تخطيط_بيئة_إغلاق_اختيار; طابق خطط_بيئة_إغلاق_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط,
        (*الدالة).المعرف, العرض.عدد_الالتقاطات) مع | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مؤجل -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(خ)
        -> { الخطة := خ; };
    إذا ((*العملية).الفهرس >= (الطول(الخطة.إزاحات_الالتقاطات) مثل طبيعي)) { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { النوع := ن; };
    دع فهرس_الالتقاط: طبيعي = (*العملية).الفهرس;
    طابق حمّل_من_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, البيئة, الخطة.إزاحات_الالتقاطات[فهرس_الالتقاط])) مع |
        نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { أرجع
        نتيجة.نجح(ق); };
}

// --- Complete MSIR lowering -------------------------------------------------

عرف احفظ_تمثيل_ناتج_إل_إل_في_إم(
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الناتج: اختياري معرف_قيمة_مسير,
    التمثيل: تمثيل_قيمة_إل_إل_في_إم
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); }
    | اختياري.موجود(المعرف) -> { ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, التمثيل); أرجع اختياري.لا_شيء(); };
}

عرف معرف_ناتج_مطلوب_إل_إل_في_إم(الناتج: اختياري معرف_قيمة_مسير): نتيجة معرف_قيمة_مسير, فشل_مزود_إل_إل_في_إم {
    طابق الناتج مع
    | اختياري.موجود(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
}

عرف ابن_حساب_عشري_تعليمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    العملية: &حساب_عشري_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع أ: مرجع_قيمة_إل_إل_في_إم; دع ب: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { أ := ق; };
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { ب := ق; };
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    طابق (*العملية).العملية مع
    | عملية_حساب_عشري.جمع -> { أرجع نتيجة.نجح(ابن_جمع_عشري_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_عشري.طرح -> { أرجع نتيجة.نجح(ابن_طرح_عشري_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_عشري.ضرب -> { أرجع نتيجة.نجح(ابن_ضرب_عشري_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_عشري.قسمة -> { أرجع نتيجة.نجح(ابن_قسمة_عشرية_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); };
}

عرف ابن_مقارنة_صحيح_تعليمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    العملية: &مقارنة_صحيح_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع أ: مرجع_قيمة_إل_إل_في_إم; دع ب: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { أ := ق; };
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { ب := ق; };
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, (*العملية).اليسار) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).اليسار)); } | اختياري.موجود(ن) -> { النوع := ن; };
    دع موقع: متغير منطقي = خطأ;
    طابق صنف_إشارة_عدد_للاختيار(&(*الحقائق).الأنواع, النوع) مع
    | اختياري.موجود(صنف_إشارة_عدد_خلفية.موقع) -> { موقع := صواب; }
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        طابق وصف_شكل_نوع_دلالي_عند(&(*الحقائق).الأنواع, النوع) مع
        | اختياري.موجود(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.مؤشر -> { }
            | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
    };
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    أرجع نتيجة.نجح(ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني,
        محمول_مقارنة_صحيح_إل_إل_في_إم((*العملية).العملية, موقع), أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
}

عرف ابن_مقارنة_عشري_تعليمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    العملية: &مقارنة_عشري_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
