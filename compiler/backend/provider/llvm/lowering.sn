    | عملية_مسير.بناء_إغلاق(العملية) -> { دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; }; طابق ابن_بناء_إغلاق_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &العملية) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); }; }
    | عملية_مسير.استخراج_التقاط(العملية) -> { دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; }; طابق ابن_استخراج_التقاط_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &العملية) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); }; }
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.طول) -> {
            دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
            طابق ابن_طول_تسلسل_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء, ن) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.إلحاق) -> {
            أرجع اخفض_إلحاق_متجه_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء);
        }
        | _ -> { أرجع ابن_نداء_تعليمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء, (*التعليمة).الناتج); };
    };
    أرجع اختيار.لا_شيء();
}

عرف اخفض_إلحاق_متجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    لو ((الطول((*النداء).الحجج) مثل غير_موقع) != 2) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع مكان_المتجه: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختيار.بعض(م) -> { مكان_المتجه := م; };
    دع عنوان_المتجه: مرجع_قيمة_إل_إل_في_إم;
    طابق عنوان_إل_إل_في_إم(الدالة, مكان_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ع) -> { عنوان_المتجه := ع; };
    دع نوع_المتجه: معرف_نوع; طابق نوع_قيمة_مسير(المسير, مكان_المتجه) مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(مكان_المتجه)); } | اختيار.بعض(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح((د,ط,س)) -> { بيانات := د; طول_ := ط; سعة_ := س; };
    دع العنصر: معرف_قيمة_مسير = (*النداء).الحجج[1];
    دع نوع_العنصر: معرف_نوع; طابق نوع_قيمة_مسير(المسير, العنصر) مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(العنصر)); } | اختيار.بعض(ن) -> { نوع_العنصر := ن; };
    دع تخطيط_العنصر: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    لو (تخطيط_العنصر.الحجم == 0) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_العنصر)); };
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر مثل غ32);
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع عنوان_البيانات: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, بيانات.الإزاحة);
    دع عنوان_الطول: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, طول_.الإزاحة);
    دع عنوان_السعة: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, سعة_.الإزاحة);
    دع طول_حالي: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم, عنوان_الطول, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع سعة_حالية: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم, عنوان_السعة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع ممتلئ: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 32, طول_حالي, سعة_حالية, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع اسم_نمو: متغير متجه غ8 = [0]; دع اسم_استمرار: متغير متجه غ8 = [0];
    دع كتلة_نمو: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_نمو));
    دع كتلة_استمرار: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_استمرار));
    ابن_فرع_شرطي_إل_إل_في_إم((*الحالة).الباني, ممتلئ, كتلة_نمو, كتلة_استمرار);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_نمو);
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه();
    دع صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 0, خطأ);
    دع هل_صفر: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 32, سعة_حالية, صفر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع دنيا: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, السياسة.السعة_الدنيا مثل غ64, خطأ);
    دع عامل: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, السياسة.عامل_النمو مثل غ64, خطأ);
    دع مضاعفة: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم((*الحالة).الباني, سعة_حالية, عامل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع سعة_جديدة: مرجع_قيمة_إل_إل_في_إم = ابن_اختيار_إل_إل_في_إم((*الحالة).الباني, هل_صفر, دنيا, مضاعفة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع حجم_عنصر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, تخطيط_العنصر.الحجم مثل غ64, خطأ);
    دع بايتات: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم((*الحالة).الباني, سعة_جديدة, حجم_عنصر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بيانات_قديمة: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر, عنوان_البيانات, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بيانات_جديدة: مرجع_قيمة_إل_إل_في_إم; طابق ابن_إعادة_تخصيص_ذاكرة_إل_إل_في_إم(الحالة, الهدف, بيانات_قديمة, بايتات) مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختيار.بعض(ق) -> { بيانات_جديدة := ق; };
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, بيانات_جديدة, عنوان_البيانات);
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, سعة_جديدة, عنوان_السعة);
    ابن_فرع_إل_إل_في_إم((*الحالة).الباني, كتلة_استمرار);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_استمرار);
    دع بيانات_نهائية: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر, عنوان_البيانات, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع مكان_العنصر: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_عنصر_إل_إل_في_إم(الحالة, بيانات_نهائية, طول_حالي, تخطيط_العنصر.الحجم);
    دع تمثيل_العنصر: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, العنصر) مع | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { تمثيل_العنصر := ق; };
    طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر, مكان_العنصر, &تمثيل_العنصر) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
    دع واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 1, خطأ);
    دع طول_جديد: مرجع_قيمة_إل_إل_في_إم = ابن_جمع_إل_إل_في_إم((*الحالة).الباني, طول_حالي, واحد, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, طول_جديد, عنوان_الطول);
    أرجع اختيار.لا_شيء();
}

// --- Function / block lowering ---------------------------------------------

عرف تمثيل_معامل_واجهة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_معامل_واجهة,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    فهرس_إل_إل_في_إم: &متغير غير_موقع
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع قيد_النوع: قيد_نوع_إل_إل_في_إم;
    طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
    | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد_النوع := ق; };
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> {
        لو (قيد_النوع.تجميعي) {
            دع التخطيط: واصف_تخطيط;
            طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(ت) -> { التخطيط := ت; };
            أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &قيد_النوع, التخطيط.المحاذاة)));
        };
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(قيمة_غير_معرفة_إل_إل_في_إم(قيد_النوع.التمثيل)));
    }
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع المعامل: مرجع_قيمة_إل_إل_في_إم = معامل_دالة_إل_إل_في_إم(الدالة, (*فهرس_إل_إل_في_إم) مثل غ32);
        *فهرس_إل_إل_في_إم := *فهرس_إل_إل_في_إم + 1;
        لو (قيد_النوع.تجميعي) { أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المعامل)); };
        دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
        دع القيمة: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, قيد_النوع.التمثيل, المعامل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(القيمة));
    }
    | موقع_تمرير_واجهة.مباشر(_) -> { }
    | موقع_تمرير_واجهة.مجزأ(_) -> { };
    لو (!(*الخطة).التصنيف.تجميعي) {
        دع المعامل: مرجع_قيمة_إل_إل_في_إم = معامل_دالة_إل_إل_في_إم(الدالة, (*فهرس_إل_إل_في_إم) مثل غ32);
        *فهرس_إل_إل_في_إم := *فهرس_إل_إل_في_إم + 1;
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(المعامل));
    };
    دع التخطيط: واصف_تخطيط;
    طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &قيد_النوع, التخطيط.المحاذاة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*الخطة).التصنيف.عدد_الأجزاء) {
        دع الجزء: مرجع_قيمة_إل_إل_في_إم = معامل_دالة_إل_إل_في_إم(الدالة, (*فهرس_إل_إل_في_إم) مثل غ32);
        *فهرس_إل_إل_في_إم := *فهرس_إل_إل_في_إم + 1;
        خزّن_جزء_واجهة_في_عنوان_إل_إل_في_إم(الحالة, المكان, ف, الجزء);
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف هيئ_معاملات_دالة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العرض: &عرض_دالة_مسير,
    الخطة: &خطة_دالة_واجهة
): اختيار فشل_مزود_إل_إل_في_إم {
    دع فهرس_إل_إل_في_إم: متغير غير_موقع = 0;
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        (*الدالة).عنوان_الناتج_غير_المباشر := اختيار.بعض(معامل_دالة_إل_إل_في_إم((*الدالة).الدالة, فهرس_إل_إل_في_إم مثل غ32));
        فهرس_إل_إل_في_إم := فهرس_إل_إل_في_إم + 1;
    }
    | _ -> { };
    لو ((*العرض).عدد_الالتقاطات > 0) {
        (*الدالة).بيئة_الإغلاق := اختيار.بعض(معامل_دالة_إل_إل_في_إم((*الدالة).الدالة, فهرس_إل_إل_في_إم مثل غ32));
        فهرس_إل_إل_في_إم := فهرس_إل_إل_في_إم + 1;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*العرض).عدد_المعاملات) {
        دع القيمة: عرض_قيمة_مسير;
        طابق معامل_دالة_مسير_عند(المسير, (*العرض).المعرف, ف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.دالة_مفقودة((*العرض).المعرف)); }
        | اختيار.بعض(ق) -> { القيمة := ق; };
        دع التمثيل: تمثيل_قيمة_إل_إل_في_إم;
        طابق تمثيل_معامل_واجهة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, &(*الخطة).المعاملات[ف], (*الدالة).الدالة, &متغير فهرس_إل_إل_في_إم) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ق) -> { التمثيل := ق; };
        ضع_قيمة_إل_إل_في_إم(الدالة, القيمة.المعرف, التمثيل);
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف هيئ_كتل_وفاي_دالة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العرض: &عرض_دالة_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*العرض).عدد_الكتل) {
        دع المعرف: معرف_كتلة_مسير;
        طابق معرف_كتلة_مسير_عند(المسير, (*العرض).المعرف, ف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(معرف_كتلة_مسير_من((*العرض).المعرف, ف))); }
        | اختيار.بعض(م) -> { المعرف := م; };
        دع الاسم_الخام: متجه غ8 = اسم_كتلة_إل_إل_في_إم(المعرف.القيمة);
        دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
        دع الكتلة: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم));
        بينما ((الطول((*الدالة).الكتل) مثل غير_موقع) <= المعرف.القيمة) { ألحق((*الدالة).الكتل, الكتلة); };
        (*الدالة).الكتل[المعرف.القيمة] := الكتلة;
        بينما ((الطول((*الدالة).فاي_الكتل) مثل غير_موقع) <= المعرف.القيمة) { دع خ: متجه اختيار مرجع_قيمة_إل_إل_في_إم = []; ألحق((*الدالة).فاي_الكتل, خ); };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (*العرض).عدد_الكتل) {
        دع المعرف: معرف_كتلة_مسير; طابق معرف_كتلة_مسير_عند(المسير, (*العرض).المعرف, ف) مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختيار.بعض(م) -> { المعرف := م; };
        دع عرض_الكتلة: عرض_كتلة_مسير; طابق ابحث_كتلة_مسير(المسير, المعرف) مع | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(المعرف)); } | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> { عرض_الكتلة := ع; };
        ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, (*الدالة).الكتل[المعرف.القيمة]);
        دع م: متغير غير_موقع = 0;
        بينما (م < عرض_الكتلة.عدد_المعاملات) {
            دع المعامل: عرض_قيمة_مسير; طابق معامل_كتلة_مسير_عند(المسير, المعرف, م) مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختيار.بعض(ق) -> { المعامل := ق; };
            دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, المعامل.النوع) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
            دع نوع_فاي: مرجع_نوع_إل_إل_في_إم = القيد.التمثيل; لو (القيد.تجميعي) { نوع_فاي := نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق); };
            دع اسم_فاي: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
            دع فاي: مرجع_قيمة_إل_إل_في_إم = ابن_فاي_إل_إل_في_إم((*الحالة).الباني, نوع_فاي, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فاي));
            ألحق((*الدالة).فاي_الكتل[المعرف.القيمة], اختيار.بعض(فاي));
            لو (القيد.تجميعي) { ضع_قيمة_إل_إل_في_إم(الدالة, المعامل.المعرف, تمثيل_قيمة_إل_إل_في_إم.عنوان(فاي)); }
            وإلا { ضع_قيمة_إل_إل_في_إم(الدالة, المعامل.المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(فاي)); };
            م := م + 1;
        }
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أضف_حافة_فاي_إل_إل_في_إم(
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير,
    السابق: مرجع_كتلة_إل_إل_في_إم
): اختيار فشل_مزود_إل_إل_في_إم {
    دع الهدف_: معرف_كتلة_مسير = (*الحافة).الهدف;
    دع العرض: عرض_كتلة_مسير; طابق ابحث_كتلة_مسير(المسير, الهدف_) مع | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(الهدف_)); } | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> { العرض := ع; };
    لو ((الطول((*الحافة).الحجج) مثل غير_موقع) != العرض.عدد_المعاملات) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.حافة_مسير_غير_صالحة()); };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العرض.عدد_المعاملات) {
        طابق (*الدالة).فاي_الكتل[الهدف_.القيمة][ف] مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.حافة_مسير_غير_صالحة()); }
        | اختيار.بعض(فاي) -> {
            دع التمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, (*الحافة).الحجج[ف]) مع | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل := ق; };
            دع الداخل: مرجع_قيمة_إل_إل_في_إم; طابق التمثيل مع | تمثيل_قيمة_إل_إل_في_إم.سلمية(ق) -> { الداخل := ق; } | تمثيل_قيمة_إل_إل_في_إم.عنوان(ق) -> { الداخل := ق; };
            دع قيم: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الداخل]; دع كتل: متغير متجه مرجع_كتلة_إل_إل_في_إم = [السابق];
            أضف_دخل_فاي_إل_إل_في_إم(فاي, &متغير قيم[0], &متغير كتل[0], 1);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اخفض_منهي_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_دالة_واجهة,
    المنهي: &منهي_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        دع السابق: مرجع_كتلة_إل_إل_في_إم = كتلة_الباني_الحالية_إل_إل_في_إم((*الحالة).الباني);
        طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &الحافة, السابق) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
        دع الوجهة: مرجع_كتلة_إل_إل_في_إم; طابق كتلة_إل_إل_في_إم(الدالة, الحافة.الهدف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ك) -> { الوجهة := ك; };
        ابن_فرع_إل_إل_في_إم((*الحالة).الباني, الوجهة);
    }
    | منهي_مسير.فرع_شرطي((الشرط, عند_الصواب, عند_الخطأ)) -> {
        دع قيمة_الشرط: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, الشرط) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { قيمة_الشرط := ق; };
        دع السابق: مرجع_كتلة_إل_إل_في_إم = كتلة_الباني_الحالية_إل_إل_في_إم((*الحالة).الباني);
        طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &عند_الصواب, السابق) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
        طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &عند_الخطأ, السابق) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
        دع كتلة_الصواب: مرجع_كتلة_إل_إل_في_إم; طابق كتلة_إل_إل_في_إم(الدالة, عند_الصواب.الهدف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ك) -> { كتلة_الصواب := ك; };
        دع كتلة_الخطأ: مرجع_كتلة_إل_إل_في_إم; طابق كتلة_إل_إل_في_إم(الدالة, عند_الخطأ.الهدف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ك) -> { كتلة_الخطأ := ك; };
        ابن_فرع_شرطي_إل_إل_في_إم((*الحالة).الباني, قيمة_الشرط, كتلة_الصواب, كتلة_الخطأ);
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { ابن_إرجاع_فراغ_إل_إل_في_إم((*الحالة).الباني); }
        | موقع_تمرير_واجهة.غير_مباشر(_) -> {
            دع المعرف: معرف_قيمة_مسير; طابق القيمة مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختيار.بعض(ق) -> { المعرف := ق; };
            دع العنوان: مرجع_قيمة_إل_إل_في_إم; طابق (*الدالة).عنوان_الناتج_غير_المباشر مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); } | اختيار.بعض(ع) -> { العنوان := ع; };
            دع التمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل := ق; };
            طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع, العنوان, &التمثيل) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
            ابن_إرجاع_فراغ_إل_إل_في_إم((*الحالة).الباني);
        }
        | _ -> {
            دع المعرف: معرف_قيمة_مسير; طابق القيمة مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختيار.بعض(ق) -> { المعرف := ق; };
            دع الناتج: مرجع_قيمة_إل_إل_في_إم; طابق اجمع_ناتج_واجهة_للإرجاع_إل_إل_في_إم(الحالة, الدالة, &(*الخطة).الناتج, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { الناتج := ق; };
            ابن_إرجاع_إل_إل_في_إم((*الحالة).الباني, الناتج);
        };
    }
    | منهي_مسير.فخ -> { ابن_فخ_وغير_قابل_للوصول_إل_إل_في_إم(الحالة); };
    أرجع اختيار.لا_شيء();
}

عام عرف اخفض_جسم_دالة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_دالة_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    دع العرض: عرض_دالة_مسير; طابق ابحث_دالة_مسير(المسير, المعرف) مع | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); } | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
    دع القيد: قيد_دالة_إل_إل_في_إم; طابق قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { القيد := ق; };
    دع عدد_القيم: غير_موقع; طابق عدد_قيم_دالة_مسير(المسير, المعرف) مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); } | اختيار.بعض(ع) -> { عدد_القيم := ع; };
    دع القيم: متغير متجه اختيار تمثيل_قيمة_إل_إل_في_إم = []; دع ف: متغير غير_موقع = 0; بينما (ف < عدد_القيم) { ألحق(القيم, اختيار.لا_شيء()); ف := ف + 1; };
    دع الكتل: متجه مرجع_كتلة_إل_إل_في_إم = []; دع فاي: متجه متجه اختيار مرجع_قيمة_إل_إل_في_إم = [];
    دع دالة: متغير حالة_دالة_إل_إل_في_إم = { المعرف: المعرف, الدالة: القيد.الدالة, نوع_الدالة: القيد.نوع_الدالة, الكتل: الكتل, القيم: القيم, فاي_الكتل: فاي, بيئة_الإغلاق: اختيار.لا_شيء(), عنوان_الناتج_غير_المباشر: اختيار.لا_شيء() };
    دع الخطة: خطة_دالة_واجهة; طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); } | نتيجة.نجح(خ) -> { الخطة := خ; };
    طابق هيئ_كتل_وفاي_دالة_إل_إل_في_إم(الحالة, &متغير دالة, المسير, الحقائق, الهدف, سجل_التخطيط, &العرض) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
    دع المدخل: معرف_كتلة_مسير; طابق العرض.المدخل مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); } | اختيار.بعض(م) -> { المدخل := م; };
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, دالة.الكتل[المدخل.القيمة]);
    طابق هيئ_معاملات_دالة_إل_إل_في_إم(الحالة, &متغير دالة, المسير, الحقائق, الهدف, سجل_التخطيط, &العرض, &الخطة) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
    ف := 0;
    بينما (ف < العرض.عدد_الكتل) {
        دع معرف_الكتلة: معرف_كتلة_مسير; طابق معرف_كتلة_مسير_عند(المسير, المعرف, ف) مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختيار.بعض(م) -> { معرف_الكتلة := م; };
        دع عرض_الكتلة: عرض_كتلة_مسير; طابق ابحث_كتلة_مسير(المسير, معرف_الكتلة) مع | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(معرف_الكتلة)); } | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> { عرض_الكتلة := ع; };
        ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, دالة.الكتل[معرف_الكتلة.القيمة]);
        دع ت: متغير غير_موقع = 0;
        بينما (ت < عرض_الكتلة.عدد_التعليمات) {
            دع التعليمة: عرض_تعليمة_مسير; طابق تعليمة_مسير_عند(المسير, معرف_الكتلة, ت) مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختيار.بعض(ع) -> { التعليمة := ع; };
            طابق اخفض_تعليمة_إل_إل_في_إم(الحالة, &متغير دالة, المسير, الحقائق, الهدف, سجل_التخطيط, &التعليمة) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
            ت := ت + 1;
        }
        دع المنهي: منهي_مسير; طابق منهي_كتلة_مسير(المسير, معرف_الكتلة) مع | نتيجة_بحث_منهي_مسير.موجود(م) -> { المنهي := م; } | _ -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
        طابق اخفض_منهي_إل_إل_في_إم(الحالة, &متغير دالة, المسير, الحقائق, الهدف, سجل_التخطيط, &الخطة, &المنهي) مع | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); } | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف اخفض_كل_دوال_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط
): اختيار فشل_مزود_إل_إل_في_إم {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المعرف) -> {
            طابق اخفض_جسم_دالة_إل_إل_في_إم(الحالة, المسير, الحقائق, الهدف, سجل_التخطيط, المعرف) مع
            | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
            | اختيار.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}
