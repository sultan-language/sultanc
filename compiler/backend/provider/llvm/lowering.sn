// هذا الملف هو المالك الوحيد لتحويل MSIR المتحقق إلى LLVM IR.
// لا يقرأ AST ولا يعيد بناء Type/Layout/ABI؛ كل الحقائق الفيزيائية تسأل من ملاكها المقننين.

نوع وصف_حقول_تسلسل_إل_إل_في_إم = {
    البيانات: موضع_جزء_تخطيط,
    الطول: موضع_جزء_تخطيط,
    السعة: موضع_جزء_تخطيط
};

عرف اسم_فارغ_إل_إل_في_إم(): متجه غ8 { دع ن: متجه غ8 = [0]; أرجع ن; }

عرف تخطيط_نوع_إل_إل_في_إم(
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة واصف_تخطيط, فشل_مزود_إل_إل_في_إم {
    طابق حل_تخطيط_نوع_للاختيار(الحقائق, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(ت) -> { أرجع نتيجة.نجح(ت); }
    | نتيجة_تخطيط.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(النوع)); }
    | نتيجة_تخطيط.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(النوع)); };
}

عرف تخطيط_قيمة_إل_إل_في_إم(
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    القيمة: معرف_قيمة_مسير
): نتيجة واصف_تخطيط, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, القيمة) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(القيمة)); }
    | اختيار.بعض(ن) -> { النوع := ن; };
    أرجع تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع);
}

عرف جزء_تخطيط_إل_إل_في_إم(التخطيط: &واصف_تخطيط, الفهرس: غير_موقع): اختيار موضع_جزء_تخطيط {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.صف(الأجزاء) -> {
        لو (الفهرس < (الطول(الأجزاء) مثل غير_موقع)) { أرجع اختيار.بعض(الأجزاء[الفهرس]); };
    }
    | تفاصيل_تخطيط.سجل(الأجزاء) -> {
        لو (الفهرس < (الطول(الأجزاء) مثل غير_موقع)) { أرجع اختيار.بعض(الأجزاء[الفهرس]); };
    }
    | _ -> { };
    أرجع اختيار.لا_شيء();
}

عرف تعداد_تخطيط_إل_إل_في_إم(التخطيط: &واصف_تخطيط): اختيار تخطيط_تعداد {
    طابق (*التخطيط).التفاصيل مع
    | تفاصيل_تخطيط.تعداد(ت) -> { أرجع اختيار.بعض(ت); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف كتلة_إل_إل_في_إم(الدالة: &حالة_دالة_إل_إل_في_إم, المعرف: معرف_كتلة_مسير): نتيجة مرجع_كتلة_إل_إل_في_إم,
    فشل_مزود_إل_إل_في_إم {
    لو (المعرف.القيمة >= (الطول((*الدالة).الكتل) مثل غير_موقع)) { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(المعرف)); };
    أرجع نتيجة.نجح((*الدالة).الكتل[المعرف.القيمة]);
}

عرف ابن_عنوان_عنصر_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الأصل: مرجع_قيمة_إل_إل_في_إم,
    الفهرس: مرجع_قيمة_إل_إل_في_إم,
    حجم_العنصر: غير_موقع
): مرجع_قيمة_إل_إل_في_إم {
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع نوع_الفهرس: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(الفهرس);
    دع الحجم: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_الفهرس, حجم_العنصر مثل غ64, خطأ);
    دع الإزاحة: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم((*الحالة).الباني, الفهرس, الحجم,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع الفهارس: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الإزاحة];
    دع بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
    أرجع ابن_فهرسة_إل_إل_في_إم((*الحالة).الباني, بايت, الأصل, &متغير الفهارس[0], 1,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
}

عرف ابن_فخ_إل_إل_في_إم(الحالة: &حالة_مزود_إل_إل_في_إم): فراغ {
    دع الاسم: متغير متجه غ8 = بايتات_منتهية_بصفر_من_نص(«llvm.trap»);
    دع الهوية: غ32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم), 9);
    دع الأنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    ألحق(الأنواع, نوع_فراغ_إل_إل_في_إم((*الحالة).السياق));
    دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم((*الحالة).الوحدة, الهوية, &متغير الأنواع[0], 0);
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_فراغ_إل_إل_في_إم((*الحالة).السياق), &متغير
        الأنواع[0], 0);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع فارغ: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, الجوهر, &متغير الأنواع[0], 0,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_غير_قابل_للوصول_إل_إل_في_إم((*الحالة).الباني);
}

عرف ابن_فخ_إذا_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    الشرط: مرجع_قيمة_إل_إل_في_إم
): فراغ {
    دع اسم_فخ: متغير متجه غ8 = [0];
    دع اسم_استمرار: متغير متجه غ8 = [0];
    دع كتلة_الفخ: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, الدالة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فخ));
    دع كتلة_الاستمرار: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, الدالة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_استمرار));
    ابن_فرع_شرطي_إل_إل_في_إم((*الحالة).الباني, الشرط, كتلة_الفخ, كتلة_الاستمرار);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_الفخ);
    ابن_فخ_إل_إل_في_إم(الحالة);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_الاستمرار);
}

// Allocation services can return null. Branch to the existing compiler
// trap before storing through a freshly allocated pointer. This is separate
// from a source-level nullable raw pointer and does not create provenance.
عرف تحقق_تخصيص_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المؤشر: مرجع_قيمة_إل_إل_في_إم
): فراغ {
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(نوع_قيمة_إل_إل_في_إم(المؤشر));
    دع فشل: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 32, المؤشر, صفر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, فشل);
}

عرف محمول_مقارنة_صحيح_إل_إل_في_إم(
    العملية: عملية_مقارنة_صحيح,
    موقع: منطقي
): محمول_مقارنة_صحيحة_إل_إل_في_إم {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> { أرجع 32; }
    | عملية_مقارنة_صحيح.لا_يساوي -> { أرجع 33; }
    | عملية_مقارنة_صحيح.أصغر -> { لو (موقع) { أرجع 40; } أرجع 36; }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> { لو (موقع) { أرجع 41; } أرجع 37; }
    | عملية_مقارنة_صحيح.أكبر -> { لو (موقع) { أرجع 38; } أرجع 34; }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> { لو (موقع) { أرجع 39; } أرجع 35; };
}

عرف محمول_مقارنة_عشري_إل_إل_في_إم(العملية: عملية_مقارنة_عشري): محمول_مقارنة_عائمة_إل_إل_في_إم {
    طابق العملية مع
    | عملية_مقارنة_عشري.يساوي -> { أرجع 1; }
    | عملية_مقارنة_عشري.لا_يساوي -> { أرجع 14; }
    | عملية_مقارنة_عشري.أصغر -> { أرجع 4; }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { أرجع 5; }
    | عملية_مقارنة_عشري.أكبر -> { أرجع 2; }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { أرجع 3; };
}

عرف ابن_حساب_صحيح_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    المسير: &سياق_مستهلك_مسير,
    الحساب: &حساب_صحيح_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع أ: مرجع_قيمة_إل_إل_في_إم; دع ب: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*الحساب).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { أ := ق; };
    طابق سلمية_إل_إل_في_إم(الدالة, (*الحساب).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { ب := ق; };
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, (*الحساب).اليسار) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*الحساب).اليسار)); } | اختيار.بعض(ن) -> { النوع := ن; };
    // LLVM integer arithmetic follows the lowered SSA operand width.
    دع البتات: غير_موقع = LLVMGetIntTypeWidth(نوع_قيمة_إل_إل_في_إم(أ)) مثل غير_موقع;
    دع موقع: متغير منطقي = خطأ; طابق صنف_إشارة_عدد_للاختيار(&(*الحقائق).الأنواع, النوع) مع |
        اختيار.بعض(صنف_إشارة_عدد_خلفية.موقع) -> { موقع := صواب; } | اختيار.بعض(_) -> { } | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    طابق (*الحساب).العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع ابن_حساب_بتجاوز_إل_إل_في_إم(الحالة, الدالة, أ, ب, النوع, البتات, موقع, 0); }
    | عملية_حساب_صحيح.طرح -> { أرجع ابن_حساب_بتجاوز_إل_إل_في_إم(الحالة, الدالة, أ, ب, النوع, البتات, موقع, 1); }
    | عملية_حساب_صحيح.ضرب -> { أرجع ابن_حساب_بتجاوز_إل_إل_في_إم(الحالة, الدالة, أ, ب, النوع, البتات, موقع, 2); }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع نتيجة.نجح(ابن_أو_بتي_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع نتيجة.نجح(ابن_أو_حصري_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_صحيح.و_بتي -> { أرجع نتيجة.نجح(ابن_و_بتي_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع ابن_قسمة_أو_باقي_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, صواب,
        خطأ); }
    | عملية_حساب_صحيح.قسمة_غير_موقعة -> { أرجع ابن_قسمة_أو_باقي_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, خطأ,
        خطأ); }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع ابن_قسمة_أو_باقي_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, صواب,
        صواب); }
    | عملية_حساب_صحيح.باقي_غير_موقع -> { أرجع ابن_قسمة_أو_باقي_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, خطأ,
        صواب); }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع ابن_إزاحة_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, موقع, 0); }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع ابن_إزاحة_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, موقع, 1); }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع ابن_إزاحة_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, صواب, 2);
        };
}

عرف اسم_جوهر_تجاوز_إل_إل_في_إم(موقع: منطقي, العملية: غير_موقع): متجه غ8 {
    لو (موقع) {
        لو (العملية == 0) { دع ن: متجه غ8 =
            بايتات_من_نص(«llvm.sadd.with.overflow»);
            أرجع ن; };
        لو (العملية == 1) { دع ن: متجه غ8 =
            بايتات_من_نص(«llvm.ssub.with.overflow»);
            أرجع ن; };
        دع ن: متجه غ8 =
            بايتات_من_نص(«llvm.smul.with.overflow»);
            أرجع ن;
    };
    لو (العملية == 0) { دع ن: متجه غ8 =
        بايتات_من_نص(«llvm.uadd.with.overflow»);
        أرجع ن; };
    لو (العملية == 1) { دع ن: متجه غ8 =
        بايتات_من_نص(«llvm.usub.with.overflow»);
        أرجع ن; };
    دع ن: متجه غ8 =
        بايتات_من_نص(«llvm.umul.with.overflow»);
        أرجع ن;
}

// Checked multiplication without a double-width multiply: p = a * b wraps;
// it is exact iff a == 0 or p / a == b. Division is native on these targets.
// The divisor is made safe first: unsigned a == 0 -> 1; signed a in {0, -1}
// -> 1, because MIN / -1 itself traps. Signed a == -1 overflows exactly when
// b == MIN. Any overflow traps, like the intrinsic path.
عرف ابن_ضرب_بتجاوز_بالقسمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    البتات: غير_موقع,
    موقع: منطقي
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, البتات مثل غ32);
    دع فارغ: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, 0, خطأ);
    دع واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, 1, خطأ);
    دع الناتج: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم(الباني, أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    // ICmp predicates: EQ = 32, NE = 33.
    دع أ_صفر: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, أ, صفر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع أ_غير_صفر: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 33, أ, صفر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع تجاوز: متغير مرجع_قيمة_إل_إل_في_إم = أ_صفر;
    لو (موقع) {
        دع سالب_واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, (~(0 مثل غ64)), صواب);
        دع مقدار_الإزاحة: غ64 = (البتات - 1) مثل غ64;
        دع أدنى: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, (1 مثل غ64) << مقدار_الإزاحة, خطأ);
        دع أ_سالب_واحد: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, أ, سالب_واحد,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع غير_آمن_للقسمة: مرجع_قيمة_إل_إل_في_إم = ابن_أو_بتي_إل_إل_في_إم(الباني, أ_صفر, أ_سالب_واحد,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع المقسوم_عليه: مرجع_قيمة_إل_إل_في_إم = ابن_اختيار_إل_إل_في_إم(الباني, غير_آمن_للقسمة, واحد, أ,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع الخارج: مرجع_قيمة_إل_إل_في_إم = ابن_قسمة_موقعة_إل_إل_في_إم(الباني, الناتج, المقسوم_عليه,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع الخارج_مختلف: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 33, الخارج, ب,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع آمن: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, غير_آمن_للقسمة,
            ثابت_صحيح_إل_إل_في_إم(نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 1), 0, خطأ),
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع تجاوز_عام: مرجع_قيمة_إل_إل_في_إم = ابن_و_بتي_إل_إل_في_إم(الباني, آمن, الخارج_مختلف,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع ب_أدنى: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, ب, أدنى,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع تجاوز_سالب: مرجع_قيمة_إل_إل_في_إم = ابن_و_بتي_إل_إل_في_إم(الباني, أ_سالب_واحد, ب_أدنى,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        تجاوز := ابن_أو_بتي_إل_إل_في_إم(الباني, تجاوز_عام, تجاوز_سالب,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    } وإلا {
        دع المقسوم_عليه: مرجع_قيمة_إل_إل_في_إم = ابن_اختيار_إل_إل_في_إم(الباني, أ_صفر, واحد, أ,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع الخارج: مرجع_قيمة_إل_إل_في_إم = ابن_قسمة_غير_موقعة_إل_إل_في_إم(الباني, الناتج, المقسوم_عليه,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع الخارج_مختلف: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 33, الخارج, ب,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        تجاوز := ابن_و_بتي_إل_إل_في_إم(الباني, أ_غير_صفر, الخارج_مختلف,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    };
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, تجاوز);
    أرجع نتيجة.نجح(الناتج);
}

عرف ابن_حساب_بتجاوز_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    النوع: معرف_نوع,
    البتات: غير_موقع,
    موقع: منطقي,
    العملية: غير_موقع
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    لو (العملية == 2 && (*الحالة).ضرب_التجاوز_بالقسمة) {
        أرجع ابن_ضرب_بتجاوز_بالقسمة_إل_إل_في_إم(الحالة, الدالة, أ, ب, البتات, موقع);
    };
    دع نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, البتات مثل غ32);
    دع أعضاء: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_عدد];
    ألحق(أعضاء, نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 1));
    دع نوع_ناتج: مرجع_نوع_إل_إل_في_إم = نوع_بنية_إل_إل_في_إم((*الحالة).السياق, &متغير أعضاء[0], 2);
    دع اسم_الجوهر_خام: متجه غ8 = اسم_جوهر_تجاوز_إل_إل_في_إم(موقع, العملية);
    دع اسم_الجوهر: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_الجوهر_خام);
    دع الهوية: غ32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الجوهر), الطول(اسم_الجوهر_خام)
        مثل غير_موقع);
    دع أنواع_التحميل: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_عدد];
    دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم((*الحالة).الوحدة, الهوية, &متغير أنواع_التحميل[0],
        1);
    دع معاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_عدد, نوع_عدد];
    دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_ناتج, &متغير معاملات[0], 2);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [أ, ب];
    دع فارغ: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع النتيجة: مرجع_قيمة_إل_إل_في_إم = ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, الجوهر, &متغير
        الحجج[0], 2, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع القيمة: مرجع_قيمة_إل_إل_في_إم = ابن_استخراج_عنصر_بنية_إل_إل_في_إم((*الحالة).الباني, النتيجة, 0,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع تجاوز: مرجع_قيمة_إل_إل_في_إم = ابن_استخراج_عنصر_بنية_إل_إل_في_إم((*الحالة).الباني, النتيجة, 1,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, تجاوز);
    أرجع نتيجة.نجح(القيمة);
}

عرف ابن_قسمة_أو_باقي_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    البتات: غير_موقع,
    موقع: منطقي,
    باقي: منطقي
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, البتات مثل غ32);
    دع صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, 0, خطأ);
    دع فارغ: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع صفر_قسمة: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 32, ب, صفر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, صفر_قسمة);
    لو (موقع) {
        دع مقدار_الإزاحة: غ64 = (البتات - 1) مثل غ64;
        دع أدنى: غ64 = (1 مثل غ64) << مقدار_الإزاحة;
        دع قيمة_أدنى: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, أدنى, خطأ);
        دع سالب_واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, (~(0 مثل غ64)), صواب);
        دع أ_أدنى: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 32, أ, قيمة_أدنى,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع ب_سالب: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 32, ب, سالب_واحد,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        دع الشرط: مرجع_قيمة_إل_إل_في_إم = ابن_و_بتي_إل_إل_في_إم((*الحالة).الباني, أ_أدنى, ب_سالب,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
        ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, الشرط);
    };
    لو (باقي) { لو (موقع) { أرجع نتيجة.نجح(ابن_باقي_موقع_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ))); } أرجع
        نتيجة.نجح(ابن_باقي_غير_موقع_إل_إل_في_إم((*الحالة).الباني, أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ)));
        };
    لو (موقع) { أرجع نتيجة.نجح(ابن_قسمة_موقعة_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ))); };
    أرجع نتيجة.نجح(ابن_قسمة_غير_موقعة_إل_إل_في_إم((*الحالة).الباني, أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
        فارغ)));
}

عرف ابن_إزاحة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    أ: مرجع_قيمة_إل_إل_في_إم,
    ب: مرجع_قيمة_إل_إل_في_إم,
    البتات: غير_موقع,
    موقع: منطقي,
    العملية: غير_موقع
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع نوع_عدد: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(أ);
    دع حد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_عدد, البتات مثل غ64, خطأ);
    دع فارغ: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع خارج: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 35, ب, حد,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, خارج);
    لو (العملية == 1) { أرجع نتيجة.نجح(ابن_إزاحة_يمنى_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ))); };
    لو (العملية == 2) { أرجع نتيجة.نجح(ابن_إزاحة_حسابية_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ))); };
    دع الناتج: مرجع_قيمة_إل_إل_في_إم = ابن_إزاحة_يسرى_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    دع معكوس: مرجع_قيمة_إل_إل_في_إم;
    لو (موقع) { معكوس := ابن_إزاحة_حسابية_إل_إل_في_إم((*الحالة).الباني, الناتج, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ)); }
    وإلا { معكوس := ابن_إزاحة_يمنى_إل_إل_في_إم((*الحالة).الباني, الناتج, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
        فارغ)); };
    دع فقد: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 33, معكوس, أ,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير فارغ));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, فقد);
    أرجع نتيجة.نجح(الناتج);
}

عرف ابن_ثابت_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    الثابت: &ثابت_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { النوع := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق;
        };
    طابق *الثابت مع
    | ثابت_مسير.منطق(ق) -> { دع v: متغير غ64 = 0; لو (ق) { v := 1; }; أرجع
        نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل, v, خطأ))); }
    | ثابت_مسير.صحيح_موقع(ق) -> { أرجع
        نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل, ق مثل غ64, صواب))); }
    | ثابت_مسير.صحيح_غير_موقع(ق) -> { أرجع
        نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل, ق مثل غ64, خطأ))); }
    | ثابت_مسير.مؤشر_فارغ -> {
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(
            ثابت_صفر_إل_إل_في_إم(القيد.التمثيل)));
    }
    | ثابت_مسير.عشري(البايتات) -> {
        دع العرض: غير_موقع; طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, النوع) مع | اختيار.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ب) -> { العرض := ب; };
        دع البتات: غير_موقع; طابق بتات_عائم_من_عشري(&البايتات, العرض) مع | اختيار.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ب) -> { البتات := ب; };
        دع نوع_بتات: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, العرض مثل غ32);
        دع خام: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_بتات, البتات مثل غ64, خطأ);
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_إعادة_تفسير_إل_إل_في_إم(خام, القيد.التمثيل)));
    }
    | ثابت_مسير.دالة(المعرف) -> {
        طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } |
            نتيجة.نجح(ق) -> { أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ق.الدالة)); };
    }
    | ثابت_مسير.نص(البايتات) -> {
        دع التخطيط: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ)
            -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع جزء_البيانات: موضع_جزء_تخطيط; دع جزء_الطول: موضع_جزء_تخطيط; دع جزء_السعة: موضع_جزء_تخطيط;
        طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, 0) مع | اختيار.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ج) -> { جزء_البيانات := ج; };
        طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, 1) مع | اختيار.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ج) -> { جزء_الطول := ج; };
        طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, 2) مع | اختيار.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ج) -> { جزء_السعة := ج; };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
        دع اسم_خام: متجه غ8 = اسم_نص_إل_إل_في_إم(الناتج.القيمة); دع اسم: متغير متجه غ8 =
            اجعل_اسما_سي_لإل_إل_في_إم(&اسم_خام);
        دع طول_البايتات: غير_موقع = الطول(البايتات) مثل غير_موقع;
        دع نوع_بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
        دع نوع_المصفوفة: مرجع_نوع_إل_إل_في_إم = نوع_مصفوفة_إل_إل_في_إم(نوع_بايت, طول_البايتات مثل غ64);
        دع العام: مرجع_قيمة_إل_إل_في_إم = أضف_عام_إل_إل_في_إم((*الحالة).الوحدة, نوع_المصفوفة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        دع نسخ: متغير متجه غ8 = البايتات; دع مؤشر_بايتات: مؤشر_محرف_ثابت_إل_إل_في_إم;
        لو ((الطول(نسخ) مثل غير_موقع) == 0) { دع صفر: متغير متجه غ8 = [0]; مؤشر_بايتات := &متغير صفر[0]; }
        وإلا { مؤشر_بايتات := &متغير نسخ[0]; };
        ضع_تهيئة_عام_إل_إل_في_إم(العام, ثابت_بايتات_إل_إل_في_إم((*الحالة).السياق, مؤشر_بايتات, طول_البايتات));
        ضع_ثبات_عام_إل_إل_في_إم(العام, صواب);
        دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق,
            (*الهدف).نموذج_البيانات.عرض_المؤشر مثل غ32);
        دع عدد_البايتات: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, طول_البايتات مثل غ64, خطأ);
        ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, العام, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
            جزء_البيانات.الإزاحة));
        ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, عدد_البايتات, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
            جزء_الطول.الإزاحة));
        ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, عدد_البايتات, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
            جزء_السعة.الإزاحة));
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
    }
    | ثابت_مسير.متجه(_) -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع));
    };
}

عرف ابن_تجميع_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير, التجميع: &تجميع_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { النوع := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق;
        };
    دع التخطيط: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ) ->
        { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*التجميع).الأعضاء) مثل غير_موقع)) {
        دع الجزء: موضع_جزء_تخطيط; طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, ف) مع | اختيار.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ج) -> { الجزء := ج; };
        دع عضو: معرف_قيمة_مسير = (*التجميع).الأعضاء[ف]; دع نوع_عضو: معرف_نوع; طابق نوع_قيمة_مسير(المسير, عضو) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(عضو)); } | اختيار.بعض(ن) -> {
            نوع_عضو := ن; };
        دع تمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, عضو) مع | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ)
            -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { تمثيل := ق; };
        طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_عضو,
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, الجزء.الإزاحة), &تمثيل) مع | اختيار.بعض(خ) -> { أرجع
            نتيجة.خطأ(خ); } | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف ابن_عنوان_حقل_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم, المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية, الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط, المصدر: معرف_قيمة_مسير,
    الأساس: مرجع_قيمة_إل_إل_في_إم, الفهرس: غير_موقع
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع التخطيط: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, المصدر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    طابق جزء_تخطيط_إل_إل_في_إم(&التخطيط, الفهرس) مع | اختيار.لا_شيء -> { دع ن: معرف_نوع; طابق
        نوع_قيمة_مسير(المسير, المصدر) مع | اختيار.بعض(ت) -> { ن := ت; } | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المصدر)); }; أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(ن)); } | اختيار.بعض(ج) -> { أرجع
        نتيجة.نجح(ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, الأساس, ج.الإزاحة)); };
}

عرف نوع_عنصر_تسلسل_إل_إل_في_إم(الحقائق: &سياق_استعلام_اختيار_خلفية, النوع: معرف_نوع): اختيار معرف_نوع {
    طابق نوع_عنصر_متجه_دلالي(&(*الحقائق).الأنواع, النوع) مع
    | اختيار.بعض(ن) -> { أرجع اختيار.بعض(ن); }
    | اختيار.لا_شيء -> { };
    أرجع نوع_عنصر_شريحة_دلالي(&(*الحقائق).الأنواع, النوع);
}

// Capacity is checked before multiplying by the element stride or emitting
// any allocation. A wrapped capacity would produce an undersized buffer.
عرف احسب_سعة_تهيئة_متجه_إل_إل_في_إم(
    العدد: غير_موقع, حجم_العنصر: غير_موقع, حد_العنوان: غير_موقع
): اختيار غير_موقع {
    لو (العدد == 0) { أرجع اختيار.بعض(0); };
    لو (حجم_العنصر == 0) { أرجع اختيار.لا_شيء(); };
    دع الحد: غير_موقع = حد_العنوان / حجم_العنصر;
    لو (العدد > الحد) { أرجع اختيار.لا_شيء(); };
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه();
    لو (السياسة.السعة_الدنيا == 0 || السياسة.عامل_النمو <= 1) {
        أرجع اختيار.لا_شيء();
    };
    دع السعة: متغير غير_موقع = السياسة.السعة_الدنيا;
    لو (السعة > الحد) { أرجع اختيار.لا_شيء(); };
    بينما (السعة < العدد) {
        لو (السعة > الحد / السياسة.عامل_النمو) {
            // The requested count fits; use it rather than overflowing the
            // geometric growth sequence on the final step.
            أرجع اختيار.بعض(العدد);
        };
        السعة := السعة * السياسة.عامل_النمو;
    };
    أرجع اختيار.بعض(السعة);
}

عرف حقول_تسلسل_إل_إل_في_إم(
    التخطيط: &واصف_تخطيط,
    النوع: معرف_نوع
): نتيجة وصف_حقول_تسلسل_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة: موضع_جزء_تخطيط;
    طابق جزء_تخطيط_إل_إل_في_إم(التخطيط, 0) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ج) -> { بيانات := ج; };
    طابق جزء_تخطيط_إل_إل_في_إم(التخطيط, 1) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ج) -> { طول_ := ج; };
    طابق جزء_تخطيط_إل_إل_في_إم(التخطيط, 2) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ج) -> { سعة := ج; };
    دع الحقول: وصف_حقول_تسلسل_إل_إل_في_إم = { البيانات: بيانات, الطول: طول_, السعة: سعة };
    أرجع نتيجة.نجح(الحقول);
}

عرف ابن_تهيئة_متجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير, التهيئة: &تهيئة_متجه_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع نوع_المتجه: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { نوع_المتجه := ن; };
    دع نوع_العنصر: معرف_نوع; طابق نوع_عنصر_تسلسل_إل_إل_في_إم(الحقائق, نوع_المتجه) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_المتجه)); } | اختيار.بعض(ن) -> { نوع_العنصر := ن; };
    دع قيد_المتجه: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_المتجه)
        مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> {
        قيد_المتجه := ق; };
    دع تخطيط_المتجه: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع تخطيط_العنصر: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } |
        نتيجة.نجح(ح) -> { بيانات := ح.البيانات; طول_ := ح.الطول; سعة_ := ح.السعة; };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &قيد_المتجه, تخطيط_المتجه.المحاذاة);
    دع عدد_العناصر: غير_موقع = الطول((*التهيئة).العناصر) مثل غير_موقع;
    دع حد_العنوان: غير_موقع;
    لو ((*الهدف).نموذج_البيانات.عرض_المؤشر == 32) {
        حد_العنوان := 0xFFFFFFFF;
    } وإلا لو ((*الهدف).نموذج_البيانات.عرض_المؤشر == 64) {
        حد_العنوان := 0xFFFFFFFFFFFFFFFF;
    } وإلا {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_المتجه));
    };
    دع السعة: غير_موقع;
    طابق احسب_سعة_تهيئة_متجه_إل_إل_في_إم(
        عدد_العناصر, تخطيط_العنصر.الحجم, حد_العنوان
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_المتجه));
    }
    | اختيار.بعض(الحجم) -> { السعة := الحجم; };
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل غ32);
    دع صفر_مؤشر: مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق));
    دع مؤشر_البيانات: متغير مرجع_قيمة_إل_إل_في_إم = صفر_مؤشر;
    لو (السعة > 0) {
        دع حجم_الذاكرة: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, (السعة * تخطيط_العنصر.الحجم) مثل
            غ64, خطأ);
        طابق ابن_تخصيص_ذاكرة_إل_إل_في_إم(الحالة, الهدف, حجم_الذاكرة) مع | اختيار.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختيار.بعض(ق) -> {
            تحقق_تخصيص_إل_إل_في_إم(الحالة, الدالة, ق);
            مؤشر_البيانات := ق;
        };
    };
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, مؤشر_البيانات, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
        بيانات.الإزاحة));
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, ثابت_صحيح_إل_إل_في_إم(نوع_حجم, عدد_العناصر مثل غ64, خطأ),
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, طول_.الإزاحة));
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, ثابت_صحيح_إل_إل_في_إم(نوع_حجم, السعة مثل غ64, خطأ),
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, سعة_.الإزاحة));
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_العناصر) {
        دع المعرف: معرف_قيمة_مسير = (*التهيئة).العناصر[ف]; دع التمثيل: تمثيل_قيمة_إل_إل_في_إم;
        طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } |
            نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل := ق; };
        طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر,
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, مؤشر_البيانات, ف * تخطيط_العنصر.الحجم), &التمثيل) مع |
            اختيار.بعض(خ) -> { أرجع نتيجة.خطأ(خ); } | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف ابن_عنوان_عنصر_تسلسل_من_قيمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    المصدر: معرف_قيمة_مسير, الفهرس: معرف_قيمة_مسير, نوع_العنصر: معرف_نوع
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع عنوان_المصدر: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع
        نتيجة.خطأ(خ); } | نتيجة.نجح(ع) -> { عنوان_المصدر := ع; };
    دع تخطيط_المصدر: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, المصدر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_المصدر := ت; };
    دع نوع_المصدر: معرف_نوع; طابق نوع_قيمة_مسير(المسير, المصدر) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المصدر)); } | اختيار.بعض(ن) -> { نوع_المصدر := ن; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط_المصدر, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } |
        نتيجة.نجح(ح) -> { بيانات := ح.البيانات; طول_ := ح.الطول; سعة_ := ح.السعة; };
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق); دع اسم: متغير متجه غ8 =
        اسم_فارغ_إل_إل_في_إم();
    دع مؤشر_البيانات: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المصدر, بيانات.الإزاحة), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير
        اسم));
    دع قيمة_الفهرس: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, الفهرس) مع | نتيجة.خطأ(خ) -> { أرجع
        نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { قيمة_الفهرس := ق; };
    دع تخطيط_العنصر: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    أرجع نتيجة.نجح(ابن_عنوان_عنصر_إل_إل_في_إم(الحالة, مؤشر_البيانات, قيمة_الفهرس, تخطيط_العنصر.الحجم));
}

// --- ABI marshalling -------------------------------------------------------

عرف اجعل_عنوانا_لقيمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    التمثيل: &تمثيل_قيمة_إل_إل_في_إم
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    طابق *التمثيل مع
    | تمثيل_قيمة_إل_إل_في_إم.عنوان(ع) -> { أرجع نتيجة.نجح(ع); }
    | تمثيل_قيمة_إل_إل_في_إم.سلمية(س) -> {
        دع القيد: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
        ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, س, المكان);
        أرجع نتيجة.نجح(المكان);
    };
}

عرف ألحق_حجة_واجهة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_قيمة_مسير,
    الخطة: &خطة_معامل_واجهة,
    الحجج: &متغير متجه مرجع_قيمة_إل_إل_في_إم
): اختيار فشل_مزود_إل_إل_في_إم {
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع اختيار.لا_شيء(); }
    | _ -> { };
    دع التمثيل: تمثيل_قيمة_إل_إل_في_إم;
    طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع
    | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
    | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل := ق; };
    لو (معامل_واجهة_بالقيمة_في_الذاكرة_لإل_إل_في_إم(الخطة)) {
        طابق اجعل_عنوانا_لقيمة_إل_إل_في_إم(
            الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, &التمثيل
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(العنوان) -> { ألحق(*الحجج, العنوان); };
        أرجع اختيار.لا_شيء();
    };
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        طابق اجعل_عنوانا_لقيمة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, &التمثيل) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ع) -> {
            لو ((*الخطة).التصنيف.نسخة_للمستدعى) {
                // Foreign C ABIs: the callee owns the pointed-to copy.
                دع القيد: قيد_نوع_إل_إل_في_إم;
                طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
                | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
                | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
                ألحق(*الحجج, نسخة_مستدعى_لقيمة_إل_إل_في_إم(
                    الحالة, ع, القيد.التمثيل, &(*الخطة).التصنيف
                ));
            } وإلا {
                ألحق(*الحجج, ع);
            };
        };
    }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        لو ((*الخطة).التصنيف.تجميعي) {
            دع ع: مرجع_قيمة_إل_إل_في_إم;
            طابق اجعل_عنوانا_لقيمة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, &التمثيل) مع
            | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة.نجح(عنوان_) -> { ع := عنوان_; };
            ألحق_قيم_أجزاء_واجهة_إل_إل_في_إم(
                الحالة, ع, &(*الخطة).التصنيف, &(*الخطة).أشكال_الأجزاء, الحجج
            );
        } وإلا {
            طابق التمثيل مع
            | تمثيل_قيمة_إل_إل_في_إم.سلمية(س) -> { ألحق(*الحجج, س); }
            | _ -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.قيمة_متوقعة(المعرف)); };
        };
    }
    | موقع_تمرير_واجهة.مجزأ(_) -> {
        دع ع: مرجع_قيمة_إل_إل_في_إم;
        طابق اجعل_عنوانا_لقيمة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع, &التمثيل) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(عنوان_) -> { ع := عنوان_; };
        ألحق_قيم_أجزاء_واجهة_إل_إل_في_إم(
            الحالة, ع, &(*الخطة).التصنيف, &(*الخطة).أشكال_الأجزاء, الحجج
        );
    }
    | موقع_تمرير_واجهة.متجاهل -> { };
    أرجع اختيار.لا_شيء();
}

عرف ابن_قيمة_من_ناتج_واجهة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_ناتج_واجهة,
    قيمة_النداء: مرجع_قيمة_إل_إل_في_إم,
    عنوان_غير_مباشر: اختيار مرجع_قيمة_إل_إل_في_إم
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); }
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        طابق عنوان_غير_مباشر مع
        | اختيار.بعض(ع) -> { أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(ع)); }
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    }
    | موقع_تمرير_واجهة.مباشر(_) -> {
        لو (!(*الخطة).التصنيف.تجميعي) { أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(قيمة_النداء)); };
    }
    | موقع_تمرير_واجهة.مجزأ(_) -> { };
    دع القيد: قيد_نوع_إل_إل_في_إم;
    طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
    | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
    دع التخطيط: واصف_تخطيط;
    طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
    خزّن_قيمة_إرجاع_أجزاء_واجهة_إل_إل_في_إم(
        الحالة, المكان, &(*الخطة).التصنيف, &(*الخطة).أشكال_الأجزاء, قيمة_النداء
    );
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف اجمع_ناتج_واجهة_للإرجاع_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    الخطة: &خطة_ناتج_واجهة,
    المعرف: معرف_قيمة_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع التمثيل: تمثيل_قيمة_إل_إل_في_إم;
    طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع
    | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل := ق; };
    لو (!(*الخطة).التصنيف.تجميعي) {
        طابق التمثيل مع
        | تمثيل_قيمة_إل_إل_في_إم.سلمية(س) -> { أرجع نتيجة.نجح(س); }
        | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_متوقعة(المعرف)); };
    };
    دع العنوان: مرجع_قيمة_إل_إل_في_إم;
    طابق التمثيل مع
    | تمثيل_قيمة_إل_إل_في_إم.عنوان(ع) -> { العنوان := ع; }
    | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.مكان_متوقع(المعرف)); };
    أرجع نتيجة.نجح(قيمة_إرجاع_أجزاء_واجهة_إل_إل_في_إم(
        الحالة, العنوان, &(*الخطة).التصنيف, &(*الخطة).أشكال_الأجزاء
    ));
}

عرف ابن_نداء_بخطة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المستدعى: مرجع_قيمة_إل_إل_في_إم,
    نوع_الدالة: مرجع_نوع_إل_إل_في_إم,
    الخطة: &خطة_دالة_واجهة,
    بيئة_الإغلاق: اختيار مرجع_قيمة_إل_إل_في_إم,
    حجج_مسير: &متجه معرف_قيمة_مسير,
    الناتج: اختيار معرف_قيمة_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    لو ((الطول(*حجج_مسير) مثل غير_موقع) != (الطول((*الخطة).المعاملات) مثل غير_موقع)) {
        أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة());
    };
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع عنوان_الناتج: متغير اختيار مرجع_قيمة_إل_إل_في_إم = اختيار.لا_شيء();
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع القيد: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
        دع التخطيط: واصف_تخطيط;
        طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
        | نتيجة.نجح(ت) -> { التخطيط := ت; };
        دع ع: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
        عنوان_الناتج := اختيار.بعض(ع);
        ألحق(الحجج, ع);
    }
    | _ -> { };
    طابق بيئة_الإغلاق مع
    | اختيار.بعض(ب) -> { ألحق(الحجج, ب); }
    | اختيار.لا_شيء -> { };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*حجج_مسير) مثل غير_موقع)) {
        دع مرجع_الخطة: &خطة_معامل_واجهة = &(*الخطة).المعاملات[ف];
        طابق ألحق_حجة_واجهة_إل_إل_في_إم(
            الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط,
            (*حجج_مسير)[ف], مرجع_الخطة, &متغير الحجج
        ) مع
        | اختيار.بعض(خ) -> { أرجع اختيار.بعض(خ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع مؤشر_الحجج: متغير مرجع_قيمة_إل_إل_في_إم;
    دع قيمة_النداء: مرجع_قيمة_إل_إل_في_إم;
    لو ((الطول(الحجج) مثل غير_موقع) == 0) {
        دع فارغ: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المستدعى];
        قيمة_النداء := ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, المستدعى, &متغير فارغ[0], 0,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    } وإلا {
        مؤشر_الحجج := الحجج[0];
        قيمة_النداء := ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الدالة, المستدعى, &متغير الحجج[0],
            الطول(الحجج) مثل غ32, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    };
    دع له_بيئة_إغلاق: منطقي;
    طابق بيئة_الإغلاق مع
    | اختيار.بعض(_) -> { له_بيئة_إغلاق := صواب; }
    | اختيار.لا_شيء -> { له_بيئة_إغلاق := خطأ; };
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع قيد_الناتج: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(
            الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع
        ) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(القيد) -> { قيد_الناتج := القيد; };
        أضف_صفة_ناتج_غير_مباشر_إل_إل_في_إم(
            الحالة, قيمة_النداء, قيد_الناتج.التمثيل, صواب
        );
    }
    | _ -> { };
    طابق أضف_صفات_معاملات_الذاكرة_إل_إل_في_إم(
        الحالة, الحقائق, الهدف, سجل_التخطيط, قيمة_النداء, الخطة, له_بيئة_إغلاق, صواب
    ) مع
    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
    | اختيار.لا_شيء -> { };
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { أرجع اختيار.لا_شيء(); }
        | _ -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    }
    | اختيار.بعض(معرف_الناتج) -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { أرجع اختيار.لا_شيء(); }
        | _ -> {
            طابق ابن_قيمة_من_ناتج_واجهة_إل_إل_في_إم(
                الحالة, الحقائق, الهدف, سجل_التخطيط,
                &(*الخطة).الناتج, قيمة_النداء, عنوان_الناتج
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, معرف_الناتج, ق); };
        };
    };
    أرجع اختيار.لا_شيء();
}

عرف أعلن_بدائي_تشغيل_للنداء_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البدائي: هوية_بدائي_مترجم,
    الخطة: &متغير خطة_دالة_واجهة
): نتيجة تصريح_بدائي_نداء_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع الاسم_الخام: متجه غ8;
    طابق اسم_بدائي_تشغيل_إل_إل_في_إم(الهدف, البدائي) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختيار.بعض(ن) -> { الاسم_الخام := ن; };
    دع التوقيع: وصف_توقيع_إل_إل_في_إم;
    طابق ابن_توقيع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, الخطة, خطأ) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ت) -> { التوقيع := ت; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الحالة).بدائيات_التشغيل) مثل غير_موقع)) {
        دع الموجود: &تصريح_بدائي_نداء_إل_إل_في_إم = &(*الحالة).بدائيات_التشغيل[ف];
        لو (هويتا_بدائي_مترجم_متساويتان((*الموجود).الهوية, البدائي)) {
            دع التصريح_الموجود: تصريح_بدائي_نداء_إل_إل_في_إم = *الموجود;
            أرجع نتيجة.نجح(التصريح_الموجود);
        };
        ف := ف + 1;
    }
    دع الاسم: متغير متجه غ8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
    دع المؤشر: مؤشر_محرف_ثابت_إل_إل_في_إم = مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم);
    دع الجديدة: مرجع_قيمة_إل_إل_في_إم = أضف_دالة_إل_إل_في_إم((*الحالة).الوحدة, المؤشر, التوقيع.النوع);
    لو (التوقيع.الناتج_غير_مباشر) {
        دع القيد: قيد_نوع_إل_إل_في_إم;
        طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع) مع
        | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
        أضف_صفة_ناتج_غير_مباشر_إل_إل_في_إم(الحالة, الجديدة, القيد.التمثيل, خطأ);
    };
    طابق أضف_صفات_معاملات_الذاكرة_إل_إل_في_إم(
        الحالة, الحقائق, الهدف, سجل_التخطيط, الجديدة, الخطة, خطأ, خطأ
    ) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { };
    دع التصريح: تصريح_بدائي_نداء_إل_إل_في_إم = { الهوية: البدائي, الدالة: الجديدة, النوع: التوقيع.النوع };
    ألحق((*الحالة).بدائيات_التشغيل, التصريح);
    أرجع نتيجة.نجح(التصريح);
}

// A raw kernel entry is a side-effecting machine operation. The selected target,
// not the host, determines the ABI; OS numbers and error decoding stay in STD.
عرف ابن_نداء_نواة_خام_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختيار معرف_قيمة_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    لو ((*الهدف).المنصة.المنصة != هوية_منصة.لينكس()
        || (*الهدف).نموذج_البيانات.عرض_المؤشر != 64
        || (الطول((*النداء).الحجج) مثل غير_موقع) != 7) {
        أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    دع رمز_التجميع: متغير متجه غ8 = [];
    دع رمز_القيود: متغير متجه غ8 = [];
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        دع رمز_التجميع_1: متجه غ8 = بايتات_منتهية_بصفر_من_نص(«syscall»);
        رمز_التجميع := رمز_التجميع_1;
        دع رمز_القيود_2: متجه غ8 = بايتات_منتهية_بصفر_من_نص(«={rax},0,{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{flags},~{memory}»);
        رمز_القيود := رمز_القيود_2;
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        دع رمز_التجميع_3: متجه غ8 = بايتات_منتهية_بصفر_من_نص(«svc #0»);
        رمز_التجميع := رمز_التجميع_3;
        دع رمز_القيود_4: متجه غ8 = بايتات_منتهية_بصفر_من_نص(«={x0},{x8},0,{x1},{x2},{x3},{x4},{x5},~{memory},~{cc}»);
        رمز_القيود := رمز_القيود_4;
    }
    | _ -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع المعرف: معرف_قيمة_مسير;
    طابق الناتج مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختيار.بعض(ن) -> { المعرف := ن; };
    دع نوع_العدد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    دع أنواع_المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    دع قيم_المعاملات: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 7) {
        دع قيمة: مرجع_قيمة_إل_إل_في_إم;
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[الفهرس]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(القيمة) -> { قيمة := القيمة; };
        دع قيمة_آلة: متغير مرجع_قيمة_إل_إل_في_إم = قيمة;
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_قيمة_مسير(المسير, (*النداء).الحجج[الفهرس]) مع
        | اختيار.بعض(النوع) -> { نوع_المصدر := النوع; }
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*النداء).الحجج[الفهرس])); };
        طابق وصف_شكل_نوع_دلالي_عند(&(*الحقائق).الأنواع, نوع_المصدر) مع
        | اختيار.بعض(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.مؤشر -> {
                دع اسم_التحويل: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
                قيمة_آلة := ابن_تحويل_مؤشر_إلى_صحيح_إل_إل_في_إم(
                    (*الحالة).الباني, قيمة, نوع_العدد,
                    مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_التحويل)
                );
            }
            | _ -> { };
        }
        | اختيار.لا_شيء -> { };
        ألحق(أنواع_المعاملات, نوع_العدد);
        ألحق(قيم_المعاملات, قيمة_آلة);
        الفهرس := الفهرس + 1;
    }
    دع التوقيع: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(
        نوع_العدد, &متغير أنواع_المعاملات[0], 7
    );
    دع التجميع: مرجع_قيمة_إل_إل_في_إم = LLVMGetInlineAsm(
        التوقيع,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير رمز_التجميع),
        (الطول(رمز_التجميع) - 1) مثل غير_موقع,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير رمز_القيود),
        (الطول(رمز_القيود) - 1) مثل غير_موقع,
        1, 0, 0, 0
    );
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع قيمة_العودة: مرجع_قيمة_إل_إل_في_إم = ابن_نداء_إل_إل_في_إم(
        (*الحالة).الباني, التوقيع, التجميع, &متغير قيم_المعاملات[0], 7,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
    );
    ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(قيمة_العودة));
    أرجع اختيار.لا_شيء();
}

// WebAssembly linear-memory primitives (wasm32 only, gated by the target
// owner). Addresses are u32 offsets into the module's one linear memory, so a
// load/store is an inttoptr of that offset; memory.grow and the linker heap
// base map to their LLVM WebAssembly forms; the copy is llvm.memcpy, which the
// default wasm CPU (bulk-memory) lowers to memory.copy without a libc call.
عرف ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختيار معرف_قيمة_مسير,
    البدائي: هوية_بدائي_مترجم
): اختيار فشل_مزود_إل_إل_في_إم {
    لو (!يدعم_ذاكرة_خطية_للهدف(الهدف)) {
        أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*النداء).الحجج) مثل غير_موقع)) {
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(الحجج, القيمة); };
        ف := ف + 1;
    }
    دع نوع_ع32_خطي: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 32);
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع الناتج_إل_إل_في_إم: متغير اختيار مرجع_قيمة_إل_إل_في_إم = اختيار.لا_شيء();
    طابق البدائي مع
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
        لو ((الطول(الحجج) مثل غير_موقع) != 1) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        // llvm.wasm.memory.grow.i32(i32 memory, i32 delta) -> i32
        دع اسم_الجوهر: متغير متجه غ8 = بايتات_منتهية_بصفر_من_نص(«llvm.wasm.memory.grow»);
        دع الهوية: غ32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الجوهر), 21);
        لو (الهوية == 0) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع أنواع_التحميل: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_ع32_خطي];
        دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم(
            (*الحالة).الوحدة, الهوية, &متغير أنواع_التحميل[0], 1
        );
        دع المعاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_ع32_خطي, نوع_ع32_خطي];
        دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(نوع_ع32_خطي, &متغير المعاملات[0], 2);
        دع الذاكرة_صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_ع32_خطي, 0, خطأ);
        دع مقدار_النمو: مرجع_قيمة_إل_إل_في_إم = الحجج[0];
        دع القيم: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الذاكرة_صفر, مقدار_النمو];
        الناتج_إل_إل_في_إم := اختيار.بعض(ابن_نداء_إل_إل_في_إم(
            (*الحالة).الباني, نوع_الدالة, الجوهر, &متغير القيم[0], 2,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        ));
    }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
        لو ((الطول(الحجج) مثل غير_موقع) != 1) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المحمل: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم(
            (*الحالة).الباني, نوع_ع32_خطي, المكان, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        ضع_محاذاة_قيمة_إل_إل_في_إم(المحمل, 4);
        الناتج_إل_إل_في_إم := اختيار.بعض(المحمل);
    }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
        لو ((الطول(الحجج) مثل غير_موقع) != 2) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المخزن: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, الحجج[1], المكان);
        ضع_محاذاة_قيمة_إل_إل_في_إم(المخزن, 4);
    }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
        لو ((الطول(الحجج) مثل غير_موقع) != 3) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع الوجهة: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المصدر: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[1], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        ابن_نسخ_ذاكرة_إل_إل_في_إم((*الحالة).الباني, الوجهة, 1, المصدر, 1, الحجج[2]);
    }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
        // __heap_base: wasm-ld defines it as the first address after static
        // data and the stack. Declared once as external storage.
        دع اسم_القاعدة: متغير متجه غ8 = بايتات_منتهية_بصفر_من_نص(«__heap_base»);
        دع العام: متغير مرجع_قيمة_إل_إل_في_إم = LLVMGetNamedGlobal(
            (*الحالة).الوحدة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_القاعدة)
        );
        لو (العام == الفارغ) {
            دع بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
            العام := أضف_عام_إل_إل_في_إم(
                (*الحالة).الوحدة, بايت, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_القاعدة)
            );
        };
        الناتج_إل_إل_في_إم := اختيار.بعض(ابن_تحويل_مؤشر_إلى_صحيح_إل_إل_في_إم(
            (*الحالة).الباني, العام, نوع_ع32_خطي, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        ));
    }
    | _ -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    طابق الناتج_إل_إل_في_إم مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        طابق الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
        | اختيار.بعض(المعرف) -> {
            ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(القيمة));
        };
    };
    أرجع اختيار.لا_شيء();
}

// Flat machine-memory primitives (64-bit non-wasm targets, gated by the target
// owner): the u64 address becomes a pointer by inttoptr and one 8-byte-aligned
// i64 load/store accesses it.
عرف ابن_بدائي_ذاكرة_آلة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختيار معرف_قيمة_مسير,
    البدائي: هوية_بدائي_مترجم
): اختيار فشل_مزود_إل_إل_في_إم {
    لو (!يدعم_ذاكرة_آلة_للهدف(الهدف)) {
        أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*النداء).الحجج) مثل غير_موقع)) {
        طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ألحق(الحجج, القيمة); };
        ف := ف + 1;
    }
    دع نوع_كلمة: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    طابق البدائي مع
    | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> {
        لو ((الطول(الحجج) مثل غير_موقع) != 1) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المحمل: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم(
            (*الحالة).الباني, نوع_كلمة, المكان, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        ضع_محاذاة_قيمة_إل_إل_في_إم(المحمل, 8);
        طابق الناتج مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
        | اختيار.بعض(المعرف) -> {
            ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(المحمل));
        };
    }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> {
        لو ((الطول(الحجج) مثل غير_موقع) != 2) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        دع المكان: مرجع_قيمة_إل_إل_في_إم = ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
            (*الحالة).الباني, الحجج[0], نوع_مؤشر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)
        );
        دع المخزن: مرجع_قيمة_إل_إل_في_إم = ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, الحجج[1], المكان);
        ضع_محاذاة_قيمة_إل_إل_في_إم(المخزن, 8);
    }
    | _ -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    أرجع اختيار.لا_شيء();
}

عرف ابن_نداء_تعليمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير,
    الناتج: اختيار معرف_قيمة_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(المعرف) -> {
        دع العرض: عرض_دالة_مسير;
        طابق ابحث_دالة_مسير(المسير, المعرف) مع
        | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); }
        | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع; };
        // هدف النداء المباشر لا يحمل بيئة إغلاق. الدالة ذات الالتقاطات يجب أن تصل
        // عبر قيمة دالة/إغلاق؛ إبقاء هذا الحاجز يمنع اختلاق ABI خاص داخل المزود.
        لو (العرض.عدد_الالتقاطات > 0) { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
        دع الخطة: متغير خطة_دالة_واجهة;
        طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع القيد: قيد_دالة_إل_إل_في_إم;
        طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } |
            نتيجة.نجح(ق) -> { القيد := ق; };
        دع بيئة_النداء: متغير اختيار مرجع_قيمة_إل_إل_في_إم = اختيار.لا_شيء();
        لو (القيد.له_بيئة_إغلاق) {
            دع البيئة_الفارغة: مرجع_قيمة_إل_إل_في_إم = ثابت_صفر_إل_إل_في_إم(
                نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق)
            );
            بيئة_النداء := اختيار.بعض(البيئة_الفارغة);
        };
        أرجع ابن_نداء_بخطة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, القيد.الدالة,
            القيد.نوع_الدالة, &الخطة, بيئة_النداء, &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.دالة_خارجية(المعرف) -> {
        دع الخطة: متغير خطة_دالة_واجهة;
        طابق حل_واجهة_نداء_خارجي_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الحجج, الناتج) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع القيد: قيد_دالة_خارجية_إل_إل_في_إم;
        طابق ابحث_قيد_دالة_خارجية_إل_إل_في_إم(الحالة, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } |
            نتيجة.نجح(ق) -> { القيد := ق; };
        أرجع ابن_نداء_بخطة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, القيد.الدالة,
            القيد.نوع_الدالة, &الخطة, اختيار.لا_شيء(), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.قيمة_دالة(معرف_القيمة) -> {
        دع الإغلاق: مرجع_قيمة_إل_إل_في_إم;
        طابق سلمية_إل_إل_في_إم(الدالة, معرف_القيمة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق)
            -> { الإغلاق := ق; };
        دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
        دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
        دع الرمز: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر, الإغلاق,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        دع الخطة: متغير خطة_دالة_واجهة;
        طابق حل_واجهة_نداء_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الحجج, الناتج) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
        | نتيجة.نجح(خ) -> { الخطة := خ; };
        دع التوقيع: وصف_توقيع_إل_إل_في_إم;
        طابق ابن_توقيع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, &الخطة, صواب) مع | نتيجة.خطأ(خ) -> {
            أرجع اختيار.بعض(خ); } | نتيجة.نجح(ت) -> { التوقيع := ت; };
        أرجع ابن_نداء_بخطة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, الرمز,
            التوقيع.النوع, &الخطة, اختيار.بعض(الإغلاق), &(*النداء).الحجج, الناتج);
    }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        طابق البدائي مع
        | هوية_بدائي_مترجم.نداء_نواة_خام -> {
            أرجع ابن_نداء_نواة_خام_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, النداء, الناتج);
        }
        | هوية_بدائي_مترجم.معمارية_المضيف -> {
            طابق الناتج مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } |
                اختيار.بعض(ن) -> {
                دع الرمز: عدد; طابق رمز_هوية_مضيف_إل_إل_في_إم(الهدف, البدائي) مع | اختيار.لا_شيء -> { أرجع
                    اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختيار.بعض(ر) -> { الرمز := ر; };
                دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختيار.لا_شيء -> { أرجع
                    اختيار.بعض(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(ن)); } | اختيار.بعض(ت) -> { النوع := ت; };
                دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط,
                    النوع) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); } |
                    نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
                ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل,
                    الرمز مثل غ64, صواب))); أرجع اختيار.لا_شيء();
            }; }
        | هوية_بدائي_مترجم.منصة_المضيف -> {
            طابق الناتج مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } |
                اختيار.بعض(ن) -> {
                دع الرمز: عدد; طابق رمز_هوية_مضيف_إل_إل_في_إم(الهدف, البدائي) مع | اختيار.لا_شيء -> { أرجع
                    اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختيار.بعض(ر) -> { الرمز := ر; };
                دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختيار.لا_شيء -> { أرجع
                    اختيار.بعض(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(ن)); } | اختيار.بعض(ت) -> { النوع := ت; };
                دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط,
                    النوع) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); } |
                    نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
                ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل,
                    الرمز مثل غ64, صواب))); أرجع اختيار.لا_شيء();
            }; }
        | هوية_بدائي_مترجم.بيئة_المضيف -> {
            طابق الناتج مع | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } |
                اختيار.بعض(ن) -> {
                دع الرمز: عدد; طابق رمز_هوية_مضيف_إل_إل_في_إم(الهدف, البدائي) مع | اختيار.لا_شيء -> { أرجع
                    اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختيار.بعض(ر) -> { الرمز := ر; };
                دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختيار.لا_شيء -> { أرجع
                    اختيار.بعض(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(ن)); } | اختيار.بعض(ت) -> { النوع := ت; };
                دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط,
                    النوع) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); } |
                    نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
                ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ثابت_صحيح_إل_إل_في_إم(القيد.التمثيل,
                    الرمز مثل غ64, صواب))); أرجع اختيار.لا_شيء();
            }; }
        | هوية_بدائي_مترجم.بتات_ع64 -> { }
        | هوية_بدائي_مترجم.ع64_من_بتات -> { }
        | هوية_بدائي_مترجم.بتات_ع32 -> { }
        | هوية_بدائي_مترجم.ع32_من_بتات -> { }
        | هوية_بدائي_مترجم.طول -> { }
        | هوية_بدائي_مترجم.إلحاق -> { }
        | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
            أرجع ابن_بدائي_ذاكرة_خطية_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> {
            أرجع ابن_بدائي_ذاكرة_آلة_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> {
            أرجع ابن_بدائي_ذاكرة_آلة_إل_إل_في_إم(الحالة, الدالة, الهدف, النداء, الناتج, البدائي);
        }
        | _ -> {
            دع الخطة: متغير خطة_دالة_واجهة;
            طابق حل_واجهة_نداء_قيم_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &(*النداء).الحجج, الناتج) مع
            | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); }
            | نتيجة.نجح(خ) -> { الخطة := خ; };
            دع المستدعى: مرجع_قيمة_إل_إل_في_إم; دع نوع_الدالة: مرجع_نوع_إل_إل_في_إم;
            طابق أعلن_بدائي_تشغيل_للنداء_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, البدائي, &متغير الخطة) مع
            | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة.نجح(ت) -> { المستدعى := ت.الدالة; نوع_الدالة := ت.النوع; };
            أرجع ابن_نداء_بخطة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, المستدعى,
                نوع_الدالة, &الخطة, اختيار.لا_شيء(), &(*النداء).الحجج, الناتج);
        };
        // Four bit-reinterpret primitives are represented as a pure LLVM bitcast.
        دع إعادة_تفسير: متغير منطقي = خطأ;
        طابق البدائي مع
        | هوية_بدائي_مترجم.بتات_ع64 -> { إعادة_تفسير := صواب; }
        | هوية_بدائي_مترجم.ع64_من_بتات -> { إعادة_تفسير := صواب; }
        | هوية_بدائي_مترجم.بتات_ع32 -> { إعادة_تفسير := صواب; }
        | هوية_بدائي_مترجم.ع32_من_بتات -> { إعادة_تفسير := صواب; }
        | _ -> { };
        لو (إعادة_تفسير) {
            لو ((الطول((*النداء).الحجج) مثل غير_موقع) != 1) { أرجع
                اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
            دع ن: معرف_قيمة_مسير; طابق الناتج مع | اختيار.لا_شيء -> { أرجع
                اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختيار.بعض(ق) -> { ن := ق; };
            دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[0]) مع |
                نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { المصدر := ق; };
            دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختيار.لا_شيء -> { أرجع
                اختيار.بعض(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(ن)); } | اختيار.بعض(ت) -> { النوع := ت; };
            دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع)
                مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> {
                القيد := ق; };
            دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
            ضع_قيمة_إل_إل_في_إم(الدالة, ن,
                تمثيل_قيمة_إل_إل_في_إم.سلمية(ابن_إعادة_تفسير_إل_إل_في_إم((*الحالة).الباني, المصدر,
                القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))));
            أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
}

عرف ابن_بناء_موسوم_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    البناء: &بناء_موسوم_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { النوع := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق;
        };
    دع التخطيط: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ) ->
        { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع تعداد: تخطيط_تعداد; طابق تعداد_تخطيط_إل_إل_في_إم(&التخطيط) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); } | اختيار.بعض(ت) -> { تعداد := ت; };
    دع خطة_المنشئ: تخطيط_حمولات_منشئ;
    طابق تخطيط_منشئ_قيمة_مسير_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط, الناتج, (*البناء).المنشئ) مع
    | نتيجة_تخطيط_منشئ.مؤجل(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(النوع)); }
    | نتيجة_تخطيط_منشئ.مرفوض(_) -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(النوع)); }
    | نتيجة_تخطيط_منشئ.مكتمل(خ) -> { خطة_المنشئ := خ; };
    لو ((الطول((*البناء).الحمولات) مثل غير_موقع) != (الطول(خطة_المنشئ.الحمولات) مثل غير_موقع)) { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &القيد, التخطيط.المحاذاة);
    دع نوع_الوسم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (تعداد.الوسم.الحجم * 8) مثل
        غ32);
    دع قيمة_الوسم: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_الوسم, خطة_المنشئ.قيمة_الوسم مثل غ64, خطأ);
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, قيمة_الوسم, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان,
        تعداد.الوسم.الإزاحة));
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*البناء).الحمولات) مثل غير_موقع)) {
        دع معرف_الحمولة: معرف_قيمة_مسير = (*البناء).الحمولات[ف];
        دع نوع_الحمولة: معرف_نوع; طابق نوع_قيمة_مسير(المسير, معرف_الحمولة) مع | اختيار.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(معرف_الحمولة)); } | اختيار.بعض(ن) -> { نوع_الحمولة := ن;
            };
        دع تمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, معرف_الحمولة) مع |
            نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { تمثيل
            := ق; };
        دع الإزاحة: غير_موقع = تعداد.مخزن_الحمولة.الإزاحة + خطة_المنشئ.الحمولات[ف].الإزاحة;
        طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الحمولة,
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المكان, الإزاحة), &تمثيل) مع | اختيار.بعض(خ) -> { أرجع
            نتيجة.خطأ(خ); } | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف ابن_استعلام_وسم_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    العملية: &استعلام_وسم_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع التخطيط: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, (*العملية).المصدر)
        مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع تعداد: تخطيط_تعداد; طابق تعداد_تخطيط_إل_إل_في_إم(&التخطيط) مع | اختيار.لا_شيء -> { دع ن: معرف_نوع; طابق
        نوع_قيمة_مسير(المسير, (*العملية).المصدر) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).المصدر)); } | اختيار.بعض(ق) -> { ن := ق; }; أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(ن)); } | اختيار.بعض(ت) -> { تعداد := ت; };
    دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, (*العملية).المصدر) مع | نتيجة.خطأ(خ) -> {
        أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ع) -> { المصدر := ع; };
    دع نوع_الوسم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (تعداد.الوسم.الحجم * 8) مثل
        غ32);
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    دع الوسم: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_الوسم,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المصدر, تعداد.الوسم.الإزاحة), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع نوع_الناتج: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { نوع_الناتج := ن; };
    دع قيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد := ق; };
    دع البتات_وسم: غير_موقع = تعداد.الوسم.الحجم * 8;
    دع قيمة: متغير مرجع_قيمة_إل_إل_في_إم = الوسم;
    لو (البتات_وسم < 32) { قيمة := ابن_توسيع_صفري_إل_إل_في_إم((*الحالة).الباني, الوسم, قيد.التمثيل,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)); }
    وإلا لو (البتات_وسم > 32) { قيمة := ابن_اقتطاع_إل_إل_في_إم((*الحالة).الباني, الوسم, قيد.التمثيل,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)); };
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(قيمة));
}

عرف ابن_استخراج_حمولة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    العملية: &استخراج_حمولة_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع التخطيط: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, (*العملية).المصدر)
        مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع تعداد: تخطيط_تعداد; طابق تعداد_تخطيط_إل_إل_في_إم(&التخطيط) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختيار.بعض(ت) -> { تعداد := ت; };
    دع نوع_المصدر: معرف_نوع; طابق نوع_قيمة_مسير(المسير, (*العملية).المصدر) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).المصدر)); } | اختيار.بعض(ن) -> { نوع_المصدر := ن;
        };
    دع خطة: تخطيط_حمولات_منشئ; طابق تخطيط_منشئ_قيمة_مسير_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط,
        (*العملية).المصدر, (*العملية).المنشئ) مع | نتيجة_تخطيط_منشئ.مؤجل(_) -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(نوع_المصدر)); } | نتيجة_تخطيط_منشئ.مرفوض(_) -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(نوع_المصدر)); } | نتيجة_تخطيط_منشئ.مكتمل(خ) -> { خطة := خ; };
    لو ((*العملية).الحمولة >= (الطول(خطة.الحمولات) مثل غير_موقع)) { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, (*العملية).المصدر) مع | نتيجة.خطأ(خ) -> {
        أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ع) -> { المصدر := ع; };
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { النوع := ن; };
    دع فهرس_الحمولة: غير_موقع = (*العملية).الحمولة;
    دع الإزاحة: غير_موقع = تعداد.مخزن_الحمولة.الإزاحة + خطة.الحمولات[فهرس_الحمولة].الإزاحة;
    طابق حمّل_من_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, المصدر, الإزاحة)) مع | نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع
        نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { أرجع نتيجة.نجح(ق); };
}

عرف ابن_بناء_صندوق_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    العملية: &بناء_صندوق_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, (*العملية).القيمة) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).القيمة)); } | اختيار.بعض(ن) -> { النوع := ن; };
    دع التخطيط: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, النوع) مع | نتيجة.خطأ(خ) ->
        { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل غ32);
    دع الحجم: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, التخطيط.الحجم مثل غ64, خطأ);
    دع المكان: مرجع_قيمة_إل_إل_في_إم; طابق ابن_تخصيص_ذاكرة_إل_إل_في_إم(الحالة, الهدف, الحجم) مع | اختيار.لا_شيء
        -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختيار.بعض(ق) -> {
        تحقق_تخصيص_إل_إل_في_إم(الحالة, الدالة, ق);
        المكان := ق;
    };
    دع التمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, (*العملية).القيمة) مع |
        نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { التمثيل :=
        ق; };
    طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع, المكان, &التمثيل) مع |
        اختيار.بعض(خ) -> { أرجع نتيجة.خطأ(خ); } | اختيار.لا_شيء -> { };
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(المكان));
}

عرف ابن_بناء_إغلاق_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    البناء: &بناء_إغلاق_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع العرض: عرض_دالة_مسير; طابق ابحث_دالة_مسير(المسير, (*البناء).الدالة) مع | نتيجة_بحث_دالة_مسير.مفقودة(_) ->
        { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.دالة_مفقودة((*البناء).الدالة)); } | نتيجة_بحث_دالة_مسير.موجودة(ع)
        -> { العرض := ع; };
    دع الخطة: تخطيط_بيئة_إغلاق_اختيار; طابق خطط_بيئة_إغلاق_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط,
        (*البناء).الدالة, العرض.عدد_الالتقاطات) مع | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مؤجل -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(خ)
        -> { الخطة := خ; };
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل غ32);
    دع الحجم: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, الخطة.الحجم مثل غ64, خطأ);
    دع البيئة: مرجع_قيمة_إل_إل_في_إم; طابق ابن_تخصيص_ذاكرة_إل_إل_في_إم(الحالة, الهدف, الحجم) مع | اختيار.لا_شيء
        -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } | اختيار.بعض(ق) -> {
        تحقق_تخصيص_إل_إل_في_إم(الحالة, الدالة, ق);
        البيئة := ق;
    };
    دع قيد_الدالة: قيد_دالة_إل_إل_في_إم; طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, (*البناء).الدالة) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { قيد_الدالة := ق; };
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, قيد_الدالة.الدالة, البيئة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*البناء).الالتقاطات) مثل غير_موقع)) {
        لو (ف >= (الطول(الخطة.إزاحات_الالتقاطات) مثل غير_موقع)) { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
        دع المعرف: معرف_قيمة_مسير = (*البناء).الالتقاطات[ف]; دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير,
            المعرف) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المعرف)); } |
            اختيار.بعض(ن) -> { النوع := ن; };
        دع تمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع |
            نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { تمثيل
            := ق; };
        طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع,
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, البيئة, الخطة.إزاحات_الالتقاطات[ف]), &تمثيل) مع | اختيار.بعض(خ)
            -> { أرجع نتيجة.خطأ(خ); } | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(البيئة));
}

عرف ابن_استخراج_التقاط_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم, الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير, الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف, سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير, العملية: &استخراج_التقاط_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع البيئة: مرجع_قيمة_إل_إل_في_إم; طابق (*الدالة).بيئة_الإغلاق مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختيار.بعض(ب) -> { البيئة := ب; };
    دع العرض: عرض_دالة_مسير; طابق ابحث_دالة_مسير(المسير, (*الدالة).المعرف) مع | نتيجة_بحث_دالة_مسير.مفقودة(_) ->
        { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.دالة_مفقودة((*الدالة).المعرف)); } | نتيجة_بحث_دالة_مسير.موجودة(ع)
        -> { العرض := ع; };
    دع الخطة: تخطيط_بيئة_إغلاق_اختيار; طابق خطط_بيئة_إغلاق_للاختيار(الحقائق, المسير, الهدف, سجل_التخطيط,
        (*الدالة).المعرف, العرض.عدد_الالتقاطات) مع | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مؤجل -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مرفوض -> {
        أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | نتيجة_تخطيط_بيئة_إغلاق_اختيار.مكتمل(خ)
        -> { الخطة := خ; };
    لو ((*العملية).الفهرس >= (الطول(الخطة.إزاحات_الالتقاطات) مثل غير_موقع)) { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { النوع := ن; };
    دع فهرس_الالتقاط: غير_موقع = (*العملية).الفهرس;
    طابق حمّل_من_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, النوع,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, البيئة, الخطة.إزاحات_الالتقاطات[فهرس_الالتقاط])) مع |
        نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> { أرجع
        نتيجة.نجح(ق); };
}

// --- Complete MSIR lowering -------------------------------------------------

عرف احفظ_تمثيل_ناتج_إل_إل_في_إم(
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الناتج: اختيار معرف_قيمة_مسير,
    التمثيل: تمثيل_قيمة_إل_إل_في_إم
): اختيار فشل_مزود_إل_إل_في_إم {
    طابق الناتج مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); }
    | اختيار.بعض(المعرف) -> { ضع_قيمة_إل_إل_في_إم(الدالة, المعرف, التمثيل); أرجع اختيار.لا_شيء(); };
}

عرف معرف_ناتج_مطلوب_إل_إل_في_إم(الناتج: اختيار معرف_قيمة_مسير): نتيجة معرف_قيمة_مسير, فشل_مزود_إل_إل_في_إم {
    طابق الناتج مع
    | اختيار.بعض(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
}

عرف ابن_حساب_عشري_تعليمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    العملية: &حساب_عشري_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع أ: مرجع_قيمة_إل_إل_في_إم; دع ب: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { أ := ق; };
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { ب := ق; };
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    طابق (*العملية).العملية مع
    | عملية_حساب_عشري.جمع -> { أرجع نتيجة.نجح(ابن_جمع_عشري_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_عشري.طرح -> { أرجع نتيجة.نجح(ابن_طرح_عشري_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_عشري.ضرب -> { أرجع نتيجة.نجح(ابن_ضرب_عشري_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_حساب_عشري.قسمة -> { أرجع نتيجة.نجح(ابن_قسمة_عشرية_إل_إل_في_إم((*الحالة).الباني, أ, ب,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); };
}

عرف ابن_مقارنة_صحيح_تعليمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    العملية: &مقارنة_صحيح_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع أ: مرجع_قيمة_إل_إل_في_إم; دع ب: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { أ := ق; };
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { ب := ق; };
    دع النوع: معرف_نوع; طابق نوع_قيمة_مسير(المسير, (*العملية).اليسار) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).اليسار)); } | اختيار.بعض(ن) -> { النوع := ن; };
    دع موقع: متغير منطقي = خطأ;
    طابق صنف_إشارة_عدد_للاختيار(&(*الحقائق).الأنواع, النوع) مع
    | اختيار.بعض(صنف_إشارة_عدد_خلفية.موقع) -> { موقع := صواب; }
    | اختيار.بعض(_) -> { }
    | اختيار.لا_شيء -> {
        طابق وصف_شكل_نوع_دلالي_عند(&(*الحقائق).الأنواع, النوع) مع
        | اختيار.بعض(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.مؤشر -> { }
            | _ -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
        }
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(النوع)); };
    };
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    أرجع نتيجة.نجح(ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني,
        محمول_مقارنة_صحيح_إل_إل_في_إم((*العملية).العملية, موقع), أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
}

عرف ابن_مقارنة_عشري_تعليمة_إل_إل_في_إم(
    الحالة: &حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    العملية: &مقارنة_عشري_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع أ: مرجع_قيمة_إل_إل_في_إم; دع ب: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { أ := ق; };
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { ب := ق; };
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    أرجع نتيجة.نجح(ابن_مقارنة_عشرية_إل_إل_في_إم((*الحالة).الباني,
        محمول_مقارنة_عشري_إل_إل_في_إم((*العملية).العملية), أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
}

عرف ابن_تحويل_صحيح_تعليمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    العملية: &تحويل_صحيح_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).المصدر) مع | نتيجة.خطأ(خ) -> {
        أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { المصدر := ق; };
    دع نوع_الناتج: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { نوع_الناتج := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق;
        };
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    طابق (*العملية).العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع نتيجة.نجح(ابن_توسيع_إشارة_إل_إل_في_إم((*الحالة).الباني, المصدر,
        القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع نتيجة.نجح(ابن_توسيع_صفري_إل_إل_في_إم((*الحالة).الباني, المصدر,
        القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_صحيح.اقتطاع -> { أرجع نتيجة.نجح(ابن_اقتطاع_إل_إل_في_إم((*الحالة).الباني, المصدر,
        القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع نتيجة.نجح(ابن_إعادة_تفسير_إل_إل_في_إم((*الحالة).الباني, المصدر,
        القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); };
}

عرف ابن_طول_تسلسل_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير,
    الناتج: معرف_قيمة_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    لو ((الطول((*النداء).الحجج) مثل غير_موقع) != 1) { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع المصدر: معرف_قيمة_مسير = (*النداء).الحجج[0];
    دع عنوان_: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع
        نتيجة.خطأ(خ); } | نتيجة.نجح(ع) -> { عنوان_ := ع; };
    دع تخطيط: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, المصدر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط := ت; };
    دع نوع_المصدر: معرف_نوع; طابق نوع_قيمة_مسير(المسير, المصدر) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المصدر)); } | اختيار.بعض(ن) -> { نوع_المصدر := ن; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ح)
        -> { بيانات := ح.البيانات; طول_ := ح.الطول; سعة_ := ح.السعة; };
    دع نوع_الناتج: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { نوع_الناتج := ن; };
    دع قيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد := ق; };
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    // The header length field is pointer-sized (as stored by literals and
    // append); load it at that width, then widen/narrow to the result type.
    // Loading it at the result width read the capacity too on 32-bit targets.
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل غ32);
    دع الطول_الخام: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_, طول_.الإزاحة), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع عرض_الناتج: غ32 = LLVMGetIntTypeWidth(قيد.التمثيل);
    دع عرض_الحقل: غ32 = (*الهدف).نموذج_البيانات.عرض_المؤشر مثل غ32;
    لو (عرض_الناتج > عرض_الحقل) {
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(LLVMBuildZExt((*الحالة).الباني, الطول_الخام, قيد.التمثيل,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))));
    };
    لو (عرض_الناتج < عرض_الحقل) {
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(LLVMBuildTrunc((*الحالة).الباني, الطول_الخام, قيد.التمثيل,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))));
    };
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(الطول_الخام));
}

عرف اخفض_تعليمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    التعليمة: &عرض_تعليمة_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    طابق (*التعليمة).العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_ثابت_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &الثابت) مع |
            نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_حساب_صحيح_إل_إل_في_إم(الحالة, الدالة, الحقائق, المسير, &الحساب) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_مقارنة_صحيح_تعليمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, &المقارنة) مع | نتيجة.خطأ(خ) ->
            { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_حساب_عشري_تعليمة_إل_إل_في_إم(الحالة, الدالة, &الحساب) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_مقارنة_عشري_تعليمة_إل_إل_في_إم(الحالة, الدالة, &المقارنة) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تحويل_صحيح_تعليمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التحويل)
            مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.نقل_تسلسل_مملوك(النقل) -> {
        دع الناتج: معرف_قيمة_مسير;
        طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(القيمة) -> { الناتج := القيمة; };
        دع العنوان: مرجع_قيمة_إل_إل_في_إم;
        طابق عنوان_إل_إل_في_إم(الدالة, النقل.المصدر) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة.نجح(القيمة) -> { العنوان := القيمة; };
        ضع_قيمة_إل_إل_في_إم(الدالة, الناتج, تمثيل_قيمة_إل_إل_في_إم.عنوان(العنوان));
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        دع ق: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, التحويل.المرجع) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(س) -> { ق := س; };
        ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ق));
    }
    | عملية_مسير.تجميع(التجميع) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تجميع_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التجميع) مع |
            نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تهيئة_متجه_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التهيئة) مع |
            نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        دع أساس: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, الاستخراج.المصدر) مع | نتيجة.خطأ(خ) -> {
            أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { أساس := ق; };
        دع عنوان_: مرجع_قيمة_إل_إل_في_إم; طابق ابن_عنوان_حقل_إل_إل_في_إم(الحالة, المسير, الحقائق, الهدف,
            سجل_التخطيط, الاستخراج.المصدر, أساس, الاستخراج.الفهرس) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); }
            | نتيجة.نجح(ق) -> { عنوان_ := ق; };
        دع نوع_: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختيار.لا_شيء -> { أرجع
