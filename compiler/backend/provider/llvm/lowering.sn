    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { أ := ق; };
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق)
        -> { ب := ق; };
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    أرجع نتيجة.نجح(ابن_مقارنة_عشرية_إل_إل_في_إم((*الحالة).الباني,
        محمول_مقارنة_عشري_إل_إل_في_إم((*العملية).العملية), أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
}

عرف ابن_تحويل_صحيح_تعليمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    العملية: &تحويل_صحيح_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).المصدر) مع | نتيجة.خطأ(خ) -> {
        أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { المصدر := ق; };
    دع نوع_الناتج: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { نوع_الناتج := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق;
        };
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    طابق (*العملية).العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع نتيجة.نجح(ابن_توسيع_إشارة_إل_إل_في_إم((*الحالة).الباني, المصدر,
        القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع نتيجة.نجح(ابن_توسيع_صفري_إل_إل_في_إم((*الحالة).الباني, المصدر,
        القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_صحيح.اقتطاع -> { أرجع نتيجة.نجح(ابن_اقتطاع_إل_إل_في_إم((*الحالة).الباني, المصدر,
        القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع نتيجة.نجح(ابن_إعادة_تفسير_إل_إل_في_إم((*الحالة).الباني, المصدر,
        القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); };
}

// Float conversions (docs/en/reference/type-system.md, "Numeric casts"). float -> integer
// is llvm.fptosi.sat / llvm.fptoui.sat, which LLVM defines exactly as Rust's
// `as` (saturating, NaN -> 0); integer -> float is sitofp/uitofp (round to
// nearest even); f32 <-> f64 is fpext/fptrunc.
عرف ابن_تحويل_عائم_تعليمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    العملية: &تحويل_عائم_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).المصدر) مع | نتيجة.خطأ(خ) -> {
        أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { المصدر := ق; };
    دع نوع_الناتج: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { نوع_الناتج := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق;
        };
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع اسم_الجوهر_خام: متغير متجه ط8 = [];
    // 64-bit integer sides on narrow targets: wide_conversion.sn.
    إذا ((*الحالة).قسمة_64_برمجية) {
        دع موقع: متغير منطقي = خطأ;
        دع إلى_عائم: متغير منطقي = خطأ;
        طابق (*العملية).العملية مع
        | عملية_تحويل_عائم.موقع_إلى_عائم -> { موقع := صواب; إلى_عائم := صواب; }
        | عملية_تحويل_عائم.طبيعي_إلى_عائم -> { إلى_عائم := صواب; }
        | عملية_تحويل_عائم.عائم_إلى_موقع -> { موقع := صواب; }
        | _ -> { };
        طابق (*العملية).العملية مع
        | عملية_تحويل_عائم.عائم_إلى_عائم -> { }
        | _ -> {
            إذا (إلى_عائم) {
                إذا (LLVMGetIntTypeWidth(نوع_قيمة_إل_إل_في_إم(المصدر)) == 64) {
                    دع بتات_الناتج: طبيعي; طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, نوع_الناتج) مع |
                        اختياري.موجود(ب) -> { بتات_الناتج := ب; } | اختياري.لا_شيء -> { أرجع
                        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
                    أرجع نتيجة.نجح(صحيح64_إلى_عائم_برمجي_إل_إل_في_إم(الحالة, المصدر, موقع, القيد.التمثيل,
                        بتات_الناتج));
                };
            } وإلا إذا (LLVMGetIntTypeWidth(القيد.التمثيل) == 64) {
                دع بتات_المصدر: طبيعي; طابق نوع_قيمة_مسير(المسير, (*العملية).المصدر) مع | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).المصدر)); } | اختياري.موجود(ن) -> {
                    طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, ن) مع | اختياري.موجود(ب) -> { بتات_المصدر := ب; }
                        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }; };
                أرجع نتيجة.نجح(عائم_إلى_صحيح64_برمجي_إل_إل_في_إم(الحالة, المصدر, بتات_المصدر, موقع));
            };
        };
    };
    طابق (*العملية).العملية مع
    | عملية_تحويل_عائم.موقع_إلى_عائم -> { أرجع نتيجة.نجح(ابن_صحيح_موقع_إلى_عائم_إل_إل_في_إم((*الحالة).الباني,
        المصدر, القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_عائم.طبيعي_إلى_عائم -> { أرجع نتيجة.نجح(ابن_صحيح_طبيعي_إلى_عائم_إل_إل_في_إم((*الحالة).الباني,
        المصدر, القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_عائم.عائم_إلى_عائم -> {
        دع بتات_المصدر: طبيعي; طابق نوع_قيمة_مسير(المسير, (*العملية).المصدر) مع | اختياري.لا_شيء -> { أرجع
            نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة((*العملية).المصدر)); } | اختياري.موجود(ن) -> {
            طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, ن) مع | اختياري.موجود(ب) -> { بتات_المصدر := ب; } |
                اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }; };
        دع بتات_الناتج: طبيعي; طابق بتات_عائم_للاختيار(&(*الحقائق).الأنواع, نوع_الناتج) مع | اختياري.موجود(ب) -> {
            بتات_الناتج := ب; } | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
        إذا (بتات_المصدر == بتات_الناتج) { أرجع نتيجة.نجح(المصدر); };
        إذا (بتات_المصدر < بتات_الناتج) { أرجع نتيجة.نجح(ابن_توسيع_عائم_إل_إل_في_إم((*الحالة).الباني, المصدر,
            القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); };
        أرجع نتيجة.نجح(ابن_تضييق_عائم_إل_إل_في_إم((*الحالة).الباني, المصدر, القيد.التمثيل,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
    }
    | عملية_تحويل_عائم.عائم_إلى_موقع -> { اسم_الجوهر_خام := بايتات_من_نص(«llvm.fptosi.sat»); }
    | عملية_تحويل_عائم.عائم_إلى_طبيعي -> { اسم_الجوهر_خام := بايتات_من_نص(«llvm.fptoui.sat»); };
    دع اسم_الجوهر: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_الجوهر_خام);
    دع الهوية: ط32 = معرف_جوهر_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الجوهر), الطول(اسم_الجوهر_خام)
        مثل طبيعي);
    دع نوع_المصدر: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(المصدر);
    دع أنواع_التحميل: متغير متجه مرجع_نوع_إل_إل_في_إم = [القيد.التمثيل, نوع_المصدر];
    دع الجوهر: مرجع_قيمة_إل_إل_في_إم = تصريح_جوهر_إل_إل_في_إم((*الحالة).الوحدة, الهوية, &متغير أنواع_التحميل[0],
        2);
    دع معاملات: متغير متجه مرجع_نوع_إل_إل_في_إم = [نوع_المصدر];
    دع نوع_الجوهر: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(القيد.التمثيل, &متغير معاملات[0], 1);
    دع الحجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [المصدر];
    أرجع نتيجة.نجح(ابن_نداء_إل_إل_في_إم((*الحالة).الباني, نوع_الجوهر, الجوهر, &متغير الحجج[0], 1,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
}

عرف ابن_طول_تسلسل_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير,
    الناتج: معرف_قيمة_مسير,
    السعة_مطلوبة: منطقي
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 1) { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع المصدر: معرف_قيمة_مسير = (*النداء).الحجج[0];
    دع عنوان_: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع
        نتيجة.خطأ(خ); } | نتيجة.نجح(ع) -> { عنوان_ := ع; };
    دع تخطيط: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, المصدر) مع |
        نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط := ت; };
    دع نوع_المصدر: معرف_نوع; طابق نوع_قيمة_مسير(المسير, المصدر) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المصدر)); } | اختياري.موجود(ن) -> { نوع_المصدر := ن; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ح)
        -> { بيانات := ح.البيانات; طول_ := ح.الطول; سعة_ := ح.السعة; };
    دع نوع_الناتج: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختياري.لا_شيء -> { أرجع
        نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختياري.موجود(ن) -> { نوع_الناتج := ن; };
    دع قيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع |
        نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد := ق; };
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    // The header length field is pointer-sized (as stored by literals and
    // append); load it at that width, then widen/narrow to the result type.
    // Loading it at the result width read the capacity too on 32-bit targets.
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل ط32);
    // Capacity is the next pointer-sized header field.
    دع إزاحة_الحقل: متغير طبيعي = طول_.الإزاحة;
    إذا (السعة_مطلوبة) { إزاحة_الحقل := سعة_.الإزاحة; };
    دع الطول_الخام: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_, إزاحة_الحقل), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع عرض_الناتج: ط32 = LLVMGetIntTypeWidth(قيد.التمثيل);
    دع عرض_الحقل: ط32 = (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32;
    إذا (عرض_الناتج > عرض_الحقل) {
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(LLVMBuildZExt((*الحالة).الباني, الطول_الخام, قيد.التمثيل,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))));
    };
    إذا (عرض_الناتج < عرض_الحقل) {
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(LLVMBuildTrunc((*الحالة).الباني, الطول_الخام, قيد.التمثيل,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))));
    };
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(الطول_الخام));
}

عرف اخفض_تعليمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    التعليمة: &عرض_تعليمة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق (*التعليمة).العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_ثابت_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &الثابت) مع |
            نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_حساب_صحيح_إل_إل_في_إم(الحالة, الدالة, الحقائق, المسير, &الحساب) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_مقارنة_صحيح_تعليمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, &المقارنة) مع | نتيجة.خطأ(خ) ->
            { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_حساب_عشري_تعليمة_إل_إل_في_إم(الحالة, الدالة, &الحساب) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_مقارنة_عشري_تعليمة_إل_إل_في_إم(الحالة, الدالة, &المقارنة) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تحويل_صحيح_تعليمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التحويل)
            مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تحويل_عائم_تعليمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التحويل)
            مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن,
            تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.نقل_تسلسل_مملوك(النقل) -> {
        دع الناتج: معرف_قيمة_مسير;
        طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(القيمة) -> { الناتج := القيمة; };
        دع العنوان: مرجع_قيمة_إل_إل_في_إم;
        طابق عنوان_إل_إل_في_إم(الدالة, النقل.المصدر) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(القيمة) -> { العنوان := القيمة; };
        ضع_قيمة_إل_إل_في_إم(الدالة, الناتج, تمثيل_قيمة_إل_إل_في_إم.عنوان(العنوان));
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        دع ق: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, التحويل.المرجع) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(س) -> { ق := س; };
        // A raw pointer read as its address (`p as u64`) is ptrtoint.
        دع القيمة_الناتجة: متغير مرجع_قيمة_إل_إل_في_إم = ق;
        طابق نوع_قيمة_مسير(المسير, ن) مع
        | اختياري.موجود(نوع_الناتج) -> {
            طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع
            | نتيجة_نوع_إل_إل_في_إم.نجح(القيد) -> {
                // LLVMIntegerTypeKind is 8.
                إذا (LLVMGetTypeKind(القيد.التمثيل) == 8) {
                    القيمة_الناتجة := كلمة_بعرض_إل_إل_في_إم(الحالة, ق, LLVMGetIntTypeWidth(القيد.التمثيل));
                };
                // An address taken as a pointer (LLVMPointerTypeKind 12).
                إذا (LLVMGetTypeKind(القيد.التمثيل) == 12 && LLVMGetTypeKind(نوع_قيمة_إل_إل_في_إم(ق)) == 8) {
                    دع اسم_التحويل: متغير متجه ط8 = [0];
                    القيمة_الناتجة := ابن_تحويل_صحيح_إلى_مؤشر_إل_إل_في_إم(
                        (*الحالة).الباني, ق, القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_التحويل)
                    );
                };
            }
            | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
        }
        | اختياري.لا_شيء -> { };
        ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(القيمة_الناتجة));
    }
    | عملية_مسير.تجميع(التجميع) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تجميع_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التجميع) مع |
            نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تهيئة_متجه_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التهيئة) مع |
            نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        دع أساس: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, الاستخراج.المصدر) مع | نتيجة.خطأ(خ) -> {
            أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { أساس := ق; };
        دع عنوان_: مرجع_قيمة_إل_إل_في_إم; طابق ابن_عنوان_حقل_إل_إل_في_إم(الحالة, المسير, الحقائق, الهدف,
            سجل_التخطيط, الاستخراج.المصدر, أساس, الاستخراج.الفهرس) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(ق) -> { عنوان_ := ق; };
        دع نوع_: معرف_نوع; طابق نوع_قيمة_مسير(المسير, ن) مع | اختياري.لا_شيء -> { أرجع
