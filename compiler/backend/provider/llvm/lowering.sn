    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليسار) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { أ := ق; };
    طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).اليمين) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { ب := ق; };
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    أرجع نتيجة.نجح(ابن_مقارنة_عشرية_إل_إل_في_إم((*الحالة).الباني, محمول_مقارنة_عشري_إل_إل_في_إم((*العملية).العملية), أ, ب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
}

عرف ابن_تحويل_صحيح_تعليمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الناتج: معرف_قيمة_مسير,
    العملية: &تحويل_صحيح_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع المصدر: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, (*العملية).المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ق) -> { المصدر := ق; };
    دع نوع_الناتج: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { نوع_الناتج := ن; };
    دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    طابق (*العملية).العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع نتيجة.نجح(ابن_توسيع_إشارة_إل_إل_في_إم((*الحالة).الباني, المصدر, القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع نتيجة.نجح(ابن_توسيع_صفري_إل_إل_في_إم((*الحالة).الباني, المصدر, القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_صحيح.اقتطاع -> { أرجع نتيجة.نجح(ابن_اقتطاع_إل_إل_في_إم((*الحالة).الباني, المصدر, القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); }
    | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع نتيجة.نجح(ابن_إعادة_تفسير_إل_إل_في_إم((*الحالة).الباني, المصدر, القيد.التمثيل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))); };
}

عرف ابن_طول_تسلسل_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير,
    الناتج: معرف_قيمة_مسير
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    لو ((الطول((*النداء).الحجج) مثل غير_موقع) != 1) { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع المصدر: معرف_قيمة_مسير = (*النداء).الحجج[0];
    دع عنوان_: مرجع_قيمة_إل_إل_في_إم; طابق عنوان_إل_إل_في_إم(الدالة, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ع) -> { عنوان_ := ع; };
    دع تخطيط: واصف_تخطيط; طابق تخطيط_قيمة_إل_إل_في_إم(المسير, الحقائق, الهدف, سجل_التخطيط, المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ت) -> { تخطيط := ت; };
    دع نوع_المصدر: معرف_نوع; طابق نوع_قيمة_مسير(المسير, المصدر) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المصدر)); } | اختيار.بعض(ن) -> { نوع_المصدر := ن; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط, نوع_المصدر) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح((د,ط,س)) -> { بيانات := د; طول_ := ط; سعة_ := س; };
    دع نوع_الناتج: معرف_نوع; طابق نوع_قيمة_مسير(المسير, الناتج) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(الناتج)); } | اختيار.بعض(ن) -> { نوع_الناتج := ن; };
    دع قيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_الناتج) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد := ق; };
    دع اسم: متغير متجه غ8 = اسم_فارغ_إل_إل_في_إم();
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, قيد.التمثيل, ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_, طول_.الإزاحة), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم))));
}

عرف اخفض_تعليمة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    التعليمة: &عرض_تعليمة_مسير
): اختيار فشل_مزود_إل_إل_في_إم {
    طابق (*التعليمة).العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_ثابت_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &الثابت) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_حساب_صحيح_إل_إل_في_إم(الحالة, الدالة, الحقائق, المسير, &الحساب) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_مقارنة_صحيح_تعليمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, &المقارنة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_حساب_عشري_تعليمة_إل_إل_في_إم(الحالة, الدالة, &الحساب) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_مقارنة_عشري_تعليمة_إل_إل_في_إم(الحالة, الدالة, &المقارنة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تحويل_صحيح_تعليمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التحويل) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ق)); };
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        دع ق: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, التحويل.المرجع) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(س) -> { ق := س; };
        ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(ق));
    }
    | عملية_مسير.تجميع(التجميع) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تجميع_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التجميع) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        طابق ابن_تهيئة_متجه_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, ن, &التهيئة) مع | نتيجة.خطأ(خ) -> { أرجع اختيار.بعض(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); };
    }
