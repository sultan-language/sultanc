        نتيجة.نجح(ق) -> { ن := ق; }; طابق ابن_بناء_إغلاق_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف,
        سجل_التخطيط, &العملية) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> {
        ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); }; }
    | عملية_مسير.استخراج_التقاط(العملية) -> { دع ن: معرف_قيمة_مسير; طابق
        معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
        نتيجة.نجح(ق) -> { ن := ق; }; طابق ابن_استخراج_التقاط_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف,
        سجل_التخطيط, ن, &العملية) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> {
        ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق); }; }
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.طول) -> {
            دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> {
                أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
            طابق ابن_طول_تسلسل_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء, ن, خطأ) مع |
                نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق);
                };
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.سعة_متجه) -> {
            دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم((*التعليمة).الناتج) مع | نتيجة.خطأ(خ) -> {
                أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
            طابق ابن_طول_تسلسل_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء, ن, صواب) مع |
                نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ضع_قيمة_إل_إل_في_إم(الدالة, ن, ق);
                };
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.حجز_سعة_متجه) -> {
            أرجع اخفض_حجز_سعة_متجه_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء);
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.إلحاق_نطاق_متجه) -> {
            أرجع اخفض_إلحاق_نطاق_متجه_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء);
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.إلحاق) -> {
            أرجع اخفض_إلحاق_متجه_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء);
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.ضبط_طول_متجه) -> {
            أرجع اخفض_ضبط_طول_متجه_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء);
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.تحرير) -> {
            أرجع اخفض_تحرير_صندوق_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, &النداء);
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.زيادة_مراجع_إغلاق) -> {
            أرجع اخفض_بدائي_بيئة_إغلاق_إل_إل_في_إم(الحالة, الدالة, الهدف, &النداء, (*التعليمة).الناتج, 0);
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق) -> {
            أرجع اخفض_بدائي_بيئة_إغلاق_إل_إل_في_إم(الحالة, الدالة, الهدف, &النداء, (*التعليمة).الناتج, 1);
        }
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.مدمر_بيئة_إغلاق) -> {
            أرجع اخفض_بدائي_بيئة_إغلاق_إل_إل_في_إم(الحالة, الدالة, الهدف, &النداء, (*التعليمة).الناتج, 2);
        }
        | _ -> { أرجع ابن_نداء_تعليمة_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &النداء,
            (*التعليمة).الناتج); };
    };
    أرجع اختياري.لا_شيء();
}

// The closure-environment reference-counting primitives on the header laid
// out by خطط_بيئة_إغلاق_للاختيار. العملية: 0 counts one more reference; 1
// counts one fewer and answers whether none is left; 2 points word zero at
// the destructor and answers the environment, now a `() -> ()` closure.
عرف اخفض_بدائي_بيئة_إغلاق_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير,
    الناتج: اختياري معرف_قيمة_مسير,
    العملية: طبيعي
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 1) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع البيئة: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[0]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { البيئة := ق; };
    دع الباني: مرجع_بان_إل_إل_في_إم = (*الحالة).الباني;
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    إذا (العملية == 2) {
        دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم(الناتج) مع | نتيجة.خطأ(خ) -> {
            أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
        دع المدمر: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم(الباني, نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق),
            ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, البيئة, إزاحة_مدمر_بيئة_إغلاق()), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        ابن_تخزين_إل_إل_في_إم(الباني, المدمر, البيئة);
        ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(البيئة));
        أرجع اختياري.لا_شيء();
    };
    دع نوع_العداد: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 64);
    دع عنوان_العداد: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, البيئة, إزاحة_عداد_بيئة_إغلاق());
    دع واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_العداد, 1, خطأ);
    // On a target with threads the count changes atomically (atomicrmw,
    // sequentially consistent), so closures and std.sync's مشترك may be
    // copied and dropped on several threads at once (Swift's retain/release).
    // A freestanding target has no threads and no atomic run-time support.
    إذا (هدف_بخيوط_إل_إل_في_إم(الهدف)) {
        // atomicrmw add = 1, sub = 2.
        دع العملية_الذرية: متغير ص32 = 1;
        إذا (العملية == 1) { العملية_الذرية := 2; };
        دع السابق: مرجع_قيمة_إل_إل_في_إم = LLVMBuildAtomicRMW(الباني, العملية_الذرية, عنوان_العداد, واحد, 7, 0);
        إذا (العملية == 0) { أرجع اختياري.لا_شيء(); };
        دع ن_ذري: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم(الناتج) مع | نتيجة.خطأ(خ) -> {
            أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن_ذري := ق; };
        // The last reference was this one when the count was one before. ICmp EQ = 32.
        دع الأخير: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, السابق, واحد,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        ضع_قيمة_إل_إل_في_إم(الدالة, ن_ذري, تمثيل_قيمة_إل_إل_في_إم.سلمية(الأخير));
        أرجع اختياري.لا_شيء();
    };
    دع القديم: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم(الباني, نوع_العداد, عنوان_العداد,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    إذا (العملية == 0) {
        دع الأكبر: مرجع_قيمة_إل_إل_في_إم = ابن_جمع_إل_إل_في_إم(الباني, القديم, واحد, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        ابن_تخزين_إل_إل_في_إم(الباني, الأكبر, عنوان_العداد);
        أرجع اختياري.لا_شيء();
    };
    دع ن: معرف_قيمة_مسير; طابق معرف_ناتج_مطلوب_إل_إل_في_إم(الناتج) مع | نتيجة.خطأ(خ) -> {
        أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { ن := ق; };
    دع الأصغر: مرجع_قيمة_إل_إل_في_إم = ابن_طرح_إل_إل_في_إم(الباني, القديم, واحد, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_تخزين_إل_إل_في_إم(الباني, الأصغر, عنوان_العداد);
    // ICmp EQ = 32.
    دع لا_مراجع: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(الباني, 32, الأصغر,
        ثابت_صحيح_إل_إل_في_إم(نوع_العداد, 0, خطأ), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ضع_قيمة_إل_إل_في_إم(الدالة, ن, تمثيل_قيمة_إل_إل_في_إم.سلمية(لا_مراجع));
    أرجع اختياري.لا_شيء();
}

// Whether the target has an operating system with threads (std.thread).
عرف هدف_بخيوط_إل_إل_في_إم(الهدف: &واصف_هدف): منطقي {
    دع المنصة: هوية_منصة = (*الهدف).المنصة.المنصة;
    أرجع المنصة == هوية_منصة.لينكس() || المنصة == هوية_منصة.أندرويد()
        || المنصة == هوية_منصة.فري_بي_إس_دي() || المنصة == هوية_منصة.ماك_أو_إس()
        || المنصة == هوية_منصة.ويندوز();
}

// Release adapts the std release provider on the box pointer
// (runtime_primitive_query_context.sn); other owned values fail closed.
عرف اخفض_تحرير_صندوق_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    النداء: &نداء_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق نداء_تحرير_مكيف_للهدف(الهدف, الحقائق, المسير, النداء) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(_) -> { };
    دع الصندوق: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[0]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { الصندوق := ق; };
    إذا (!ابن_تحرير_ذاكرة_إل_إل_في_إم(الحالة, الهدف, الصندوق)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
    };
    أرجع اختياري.لا_شيء();
}

// The new length of the vector at the mutated place (pop and truncate glue),
// stored at the header's pointer-sized length width.
عرف اخفض_ضبط_طول_متجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 2) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع مكان_المتجه: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(م) -> { مكان_المتجه := م; };
    دع عنوان_المتجه: مرجع_قيمة_إل_إل_في_إم;
    طابق عنوان_إل_إل_في_إم(الدالة, مكان_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ع) -> {
        عنوان_المتجه := ع; };
    دع نوع_المتجه: معرف_نوع; طابق نوع_قيمة_مسير(المسير, مكان_المتجه) مع | اختياري.لا_شيء -> { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(مكان_المتجه)); } | اختياري.موجود(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع |
        نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع طول_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
        نتيجة.نجح(ح) -> { طول_ := ح.الطول; };
    دع الطول: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[1]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { الطول := ق; };
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل ط32);
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع الطول_بعرض_الحقل: متغير مرجع_قيمة_إل_إل_في_إم = الطول;
    دع عرض_القيمة: ط32 = LLVMGetIntTypeWidth(نوع_قيمة_إل_إل_في_إم(الطول));
    دع عرض_الحقل: ط32 = (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32;
    إذا (عرض_القيمة > عرض_الحقل) {
        الطول_بعرض_الحقل := LLVMBuildTrunc((*الحالة).الباني, الطول, نوع_حجم, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    };
    إذا (عرض_القيمة < عرض_الحقل) {
        الطول_بعرض_الحقل := LLVMBuildZExt((*الحالة).الباني, الطول, نوع_حجم, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    };
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, الطول_بعرض_الحقل,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, طول_.الإزاحة));
    أرجع اختياري.لا_شيء();
}

// The policy's amortized capacity (سعة_نمو_المتجه): max(المطلوب,
// السعة × عامل_النمو, السعة_الدنيا). The multiplication traps when it would
// pass حد_الطول, as append's growth does in every backend.
عرف ابن_سعة_نمو_المتجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    نوع_حجم: مرجع_نوع_إل_إل_في_إم,
    حد_الطول: مرجع_قيمة_إل_إل_في_إم,
    السياسة: &سياسة_نمو_متجه,
    السعة: مرجع_قيمة_إل_إل_في_إم,
    المطلوب: مرجع_قيمة_إل_إل_في_إم
): مرجع_قيمة_إل_إل_في_إم {
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع دنيا: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, (*السياسة).السعة_الدنيا مثل ط64, خطأ);
    دع عامل: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, (*السياسة).عامل_النمو مثل ط64, خطأ);
    دع حد_النمو: مرجع_قيمة_إل_إل_في_إم = ابن_قسمة_طبيعية_إل_إل_في_إم(
        (*الحالة).الباني, حد_الطول, عامل, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 34, السعة, حد_النمو, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
    دع مضاعفة: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم((*الحالة).الباني, السعة, عامل,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع تحت_الدنيا: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 36, مضاعفة, دنيا, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع الخطوة: مرجع_قيمة_إل_إل_في_إم = ابن_اختيار_إل_إل_في_إم((*الحالة).الباني, تحت_الدنيا, دنيا, مضاعفة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع تحت_المطلوب: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 36, الخطوة, المطلوب, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    أرجع ابن_اختيار_إل_إل_في_إم((*الحالة).الباني, تحت_المطلوب, المطلوب, الخطوة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
}

// Reserve (Rust's Vec::reserve_exact): when length + additional exceeds the
// capacity, the buffer is reallocated to exactly that many elements, through
// the same allocation service and checks as append's growth. Extend reuses
// this lowering with مطفأ, growing to the policy's amortized capacity instead.
// A طبيعي argument at the target's pointer width (a value above a 32-bit
// address space traps there), as reserve converts its count.
عرف حجم_بعرض_المؤشر_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    الهدف: &واصف_هدف,
    القيمة: معرف_قيمة_مسير
): نتيجة مرجع_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32);
    دع الخام: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, القيمة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ق) -> { الخام := ق; };
    دع عرض_القيمة: ط32 = LLVMGetIntTypeWidth(نوع_قيمة_إل_إل_في_إم(الخام));
    دع عرض_الحقل: ط32 = (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32;
    إذا (عرض_القيمة > عرض_الحقل) {
        دع الحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_قيمة_إل_إل_في_إم(الخام), 0xFFFFFFFF, خطأ);
        دع كبير: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
            (*الحالة).الباني, 34, الخام, الحد, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, كبير);
        أرجع نتيجة.نجح(LLVMBuildTrunc((*الحالة).الباني, الخام, نوع_حجم, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
    };
    إذا (عرض_القيمة < عرض_الحقل) {
        أرجع نتيجة.نجح(LLVMBuildZExt((*الحالة).الباني, الخام, نوع_حجم, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
    };
    أرجع نتيجة.نجح(الخام);
}

// Extend (إلحاق_نطاق_متجه): the source range is checked (start + count <=
// source length, else trap), a vector too small for length + count grows
// once through reserve's lowering to the policy's amortized capacity
// (max(length + count, capacity * growth, minimum), not length + count
// exactly), then the bytes are copied by a loop. The loop, not llvm.memcpy:
// a variable-length memcpy is a libc call, and SultanC programs link none;
// functions carry "no-builtins", so LLVM vectorizes the loop instead of
// turning it back into that call.
عرف اخفض_إلحاق_نطاق_متجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 4) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع مكان_المتجه: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(م) -> { مكان_المتجه := م; };
    دع نوع_المتجه: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, مكان_المتجه) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(مكان_المتجه)); }
    | اختياري.موجود(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط;
    طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط_المتجه, نوع_المتجه) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ح) -> { بيانات := ح.البيانات; طول_ := ح.الطول; };
    دع نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_تسلسل_إل_إل_في_إم(الحقائق, نوع_المتجه) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_المتجه)); }
    | اختياري.موجود(ن) -> { نوع_العنصر := ن; };
    دع تخطيط_العنصر: واصف_تخطيط;
    طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    إذا (تخطيط_العنصر.الحجم == 0) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_العنصر)); };
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32);
    دع بايت: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, 8);
    دع عنوان_المصدر: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[1]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { عنوان_المصدر := ق; };
    دع البداية: مرجع_قيمة_إل_إل_في_إم;
    طابق حجم_بعرض_المؤشر_إل_إل_في_إم(الحالة, الدالة, الهدف, (*النداء).الحجج[2]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { البداية := ق; };
    دع العدد: مرجع_قيمة_إل_إل_في_إم;
    طابق حجم_بعرض_المؤشر_إل_إل_في_إم(الحالة, الدالة, الهدف, (*النداء).الحجج[3]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { العدد := ق; };
    // The source range: start + count (a wrap traps) <= source length.
    دع طول_المصدر: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المصدر, طول_.الإزاحة), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع النهاية: مرجع_قيمة_إل_إل_في_إم = ابن_جمع_إل_إل_في_إم((*الحالة).الباني, البداية, العدد, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 36, النهاية, البداية, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 34, النهاية, طول_المصدر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)));
    // Grow once: reserve's lowering, with the count as its additional
    // argument, growing by the amortized rule.
    دع نداء_الحجز: متغير نداء_مسير = انسخ_مملوكا_نداء_مسير(النداء);
    دع حجج_الحجز: متجه معرف_قيمة_مسير = [(*النداء).الحجج[0], (*النداء).الحجج[3]];
    نداء_الحجز.الحجج := حجج_الحجز;
    طابق اخفض_حجز_سعة_متجه_بنمو_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &نداء_الحجز, صواب) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    دع عنوان_المتجه: مرجع_قيمة_إل_إل_في_إم;
    طابق عنوان_إل_إل_في_إم(الدالة, مكان_المتجه) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ع) -> { عنوان_المتجه := ع; };
    دع عنوان_الطول: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, طول_.الإزاحة);
    دع طول_الهدف: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم, عنوان_الطول, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بيانات_الهدف: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, بيانات.الإزاحة), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بيانات_المصدر: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر,
        ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المصدر, بيانات.الإزاحة), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع الوجهة: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_عنصر_إل_إل_في_إم(الحالة, بيانات_الهدف, طول_الهدف, تخطيط_العنصر.الحجم);
    دع المنبع: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_عنصر_إل_إل_في_إم(الحالة, بيانات_المصدر, البداية, تخطيط_العنصر.الحجم);
    دع حجم_عنصر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, تخطيط_العنصر.الحجم مثل ط64, خطأ);
    دع البايتات: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم((*الحالة).الباني, العدد, حجم_عنصر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, ابن_جمع_إل_إل_في_إم((*الحالة).الباني, طول_الهدف, العدد,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم)), عنوان_الطول);
    // for (i = 0; i < bytes; i++) dst[i] = src[i];
    دع صفر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 0, خطأ);
    دع واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 1, خطأ);
    دع كتلة_الدخول: مرجع_كتلة_إل_إل_في_إم = كتلة_الباني_الحالية_إل_إل_في_إم((*الحالة).الباني);
    دع اسم_رأس: متغير متجه ط8 = [0]; دع اسم_جسم: متغير متجه ط8 = [0]; دع اسم_خروج: متغير متجه ط8 = [0];
    دع كتلة_الرأس: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_رأس));
    دع كتلة_الجسم: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_جسم));
    دع كتلة_الخروج: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_خروج));
    ابن_فرع_إل_إل_في_إم((*الحالة).الباني, كتلة_الرأس);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_الرأس);
    دع العداد: مرجع_قيمة_إل_إل_في_إم = ابن_فاي_إل_إل_في_إم((*الحالة).الباني, نوع_حجم, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع مستمر: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 36, العداد, البايتات, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فرع_شرطي_إل_إل_في_إم((*الحالة).الباني, مستمر, كتلة_الجسم, كتلة_الخروج);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_الجسم);
    دع فهارس_منبع: متغير متجه مرجع_قيمة_إل_إل_في_إم = [العداد];
    دع عنوان_القراءة: مرجع_قيمة_إل_إل_في_إم = ابن_فهرسة_إل_إل_في_إم((*الحالة).الباني, بايت, المنبع, &متغير فهارس_منبع[0], 1, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع فهارس_وجهة: متغير متجه مرجع_قيمة_إل_إل_في_إم = [العداد];
    دع عنوان_الكتابة: مرجع_قيمة_إل_إل_في_إم = ابن_فهرسة_إل_إل_في_إم((*الحالة).الباني, بايت, الوجهة, &متغير فهارس_وجهة[0], 1, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع القيمة: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, بايت, عنوان_القراءة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, القيمة, عنوان_الكتابة);
    دع التالي: مرجع_قيمة_إل_إل_في_إم = ابن_جمع_إل_إل_في_إم((*الحالة).الباني, العداد, واحد, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فرع_إل_إل_في_إم((*الحالة).الباني, كتلة_الرأس);
    دع قيم_فاي: متغير متجه مرجع_قيمة_إل_إل_في_إم = [صفر, التالي];
    دع كتل_فاي: متغير متجه مرجع_كتلة_إل_إل_في_إم = [كتلة_الدخول, كتلة_الجسم];
    أضف_دخل_فاي_إل_إل_في_إم(العداد, &متغير قيم_فاي[0], &متغير كتل_فاي[0], 2);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_الخروج);
    أرجع اختياري.لا_شيء();
}

عرف اخفض_حجز_سعة_متجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    أرجع اخفض_حجز_سعة_متجه_بنمو_إل_إل_في_إم(الحالة, الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, النداء, خطأ);
}

عرف اخفض_حجز_سعة_متجه_بنمو_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير,
    مطفأ: منطقي
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 2) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); };
    دع مكان_المتجه: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(م) -> { مكان_المتجه := م; };
    دع عنوان_المتجه: مرجع_قيمة_إل_إل_في_إم;
    طابق عنوان_إل_إل_في_إم(الدالة, مكان_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ع) -> {
        عنوان_المتجه := ع; };
    دع نوع_المتجه: معرف_نوع; طابق نوع_قيمة_مسير(المسير, مكان_المتجه) مع | اختياري.لا_شيء -> { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(مكان_المتجه)); } | اختياري.موجود(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع |
        نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
        نتيجة.نجح(ح) -> { بيانات := ح.البيانات; طول_ := ح.الطول; سعة_ := ح.السعة; };
    دع نوع_العنصر: معرف_نوع; طابق نوع_عنصر_تسلسل_إل_إل_في_إم(الحقائق, نوع_المتجه) مع | اختياري.لا_شيء -> { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_المتجه)); } | اختياري.موجود(ن) -> { نوع_العنصر := ن; };
    دع تخطيط_العنصر: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع |
        نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    // Zero-sized elements own no storage: nothing to reserve.
    إذا (تخطيط_العنصر.الحجم == 0) { أرجع اختياري.لا_شيء(); };
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل ط32);
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع عنوان_البيانات: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه,
        بيانات.الإزاحة);
    دع عنوان_الطول: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, طول_.الإزاحة);
    دع عنوان_السعة: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, سعة_.الإزاحة);
    دع طول_حالي: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم, عنوان_الطول,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع سعة_حالية: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم, عنوان_السعة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع الإضافي_الخام: مرجع_قيمة_إل_إل_في_إم;
    طابق سلمية_إل_إل_في_إم(الدالة, (*النداء).الحجج[1]) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { الإضافي_الخام := ق; };
    دع الإضافي: متغير مرجع_قيمة_إل_إل_في_إم = الإضافي_الخام;
    دع عرض_القيمة: ط32 = LLVMGetIntTypeWidth(نوع_قيمة_إل_إل_في_إم(الإضافي_الخام));
    دع عرض_الحقل: ط32 = (*الهدف).نموذج_البيانات.عرض_المؤشر مثل ط32;
    دع حد_الطول: متغير مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 0xFFFFFFFFFFFFFFFF, خطأ);
    إذا (عرض_الحقل == 32) {
        حد_الطول := ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 0xFFFFFFFF, خطأ);
        إذا (عرض_القيمة > عرض_الحقل) {
            // An additional count above the address space cannot be met.
            دع حد_القيمة: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(
                نوع_قيمة_إل_إل_في_إم(الإضافي_الخام), 0xFFFFFFFF, خطأ);
            دع كبير: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
                (*الحالة).الباني, 34, الإضافي_الخام, حد_القيمة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
            ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, كبير);
            الإضافي := LLVMBuildTrunc((*الحالة).الباني, الإضافي_الخام, نوع_حجم, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        };
    };
    إذا (عرض_القيمة < عرض_الحقل) {
        الإضافي := LLVMBuildZExt((*الحالة).الباني, الإضافي_الخام, نوع_حجم, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    };
    // total = length + additional, trapping on wrap.
    دع المطلوب: مرجع_قيمة_إل_إل_في_إم = ابن_جمع_إل_إل_في_إم((*الحالة).الباني, طول_حالي, الإضافي,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع التفاف: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 36, المطلوب, طول_حالي, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, التفاف);
    دع ينمو: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 34, المطلوب, سعة_حالية, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع اسم_نمو: متغير متجه ط8 = [0]; دع اسم_استمرار: متغير متجه ط8 = [0];
    دع كتلة_نمو: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_نمو));
    دع كتلة_استمرار: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_استمرار));
    ابن_فرع_شرطي_إل_إل_في_إم((*الحالة).الباني, ينمو, كتلة_نمو, كتلة_استمرار);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_نمو);
    دع السعة_الجديدة: متغير مرجع_قيمة_إل_إل_في_إم = المطلوب;
    إذا (مطفأ) {
        دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(تخطيط_العنصر.الحجم مثل طبيعي);
        السعة_الجديدة := ابن_سعة_نمو_المتجه_إل_إل_في_إم(
            الحالة, الدالة, نوع_حجم, حد_الطول, &السياسة, سعة_حالية, المطلوب);
    };
    دع حجم_عنصر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, تخطيط_العنصر.الحجم مثل ط64, خطأ);
    دع حد_البايتات: مرجع_قيمة_إل_إل_في_إم = ابن_قسمة_طبيعية_إل_إل_في_إم(
        (*الحالة).الباني, حد_الطول, حجم_عنصر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع تجاوز_البايتات: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 34, السعة_الجديدة, حد_البايتات, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, تجاوز_البايتات);
    دع بايتات: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم((*الحالة).الباني, السعة_الجديدة, حجم_عنصر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بيانات_قديمة: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر, عنوان_البيانات,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بيانات_جديدة: مرجع_قيمة_إل_إل_في_إم; طابق ابن_إعادة_تخصيص_ذاكرة_إل_إل_في_إم(الحالة, الهدف, بيانات_قديمة,
        بايتات) مع | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } |
        اختياري.موجود(ق) -> {
            تحقق_تخصيص_إل_إل_في_إم(الحالة, الدالة, ق);
            بيانات_جديدة := ق;
        };
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, بيانات_جديدة, عنوان_البيانات);
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, السعة_الجديدة, عنوان_السعة);
    ابن_فرع_إل_إل_في_إم((*الحالة).الباني, كتلة_استمرار);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_استمرار);
    أرجع اختياري.لا_شيء();
}

عرف اخفض_إلحاق_متجه_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النداء: &نداء_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 2) { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم());
        };
    دع مكان_المتجه: معرف_قيمة_مسير;
    طابق (*النداء).مكان_التعديل مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); }
    | اختياري.موجود(م) -> { مكان_المتجه := م; };
    دع عنوان_المتجه: مرجع_قيمة_إل_إل_في_إم;
    طابق عنوان_إل_إل_في_إم(الدالة, مكان_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ع) -> {
        عنوان_المتجه := ع; };
    دع نوع_المتجه: معرف_نوع; طابق نوع_قيمة_مسير(المسير, مكان_المتجه) مع | اختياري.لا_شيء -> { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(مكان_المتجه)); } | اختياري.موجود(ن) -> { نوع_المتجه := ن; };
    دع تخطيط_المتجه: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_المتجه) مع |
        نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_المتجه := ت; };
    دع بيانات: موضع_جزء_تخطيط; دع طول_: موضع_جزء_تخطيط; دع سعة_: موضع_جزء_تخطيط;
    طابق حقول_تسلسل_إل_إل_في_إم(&تخطيط_المتجه, نوع_المتجه) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
        نتيجة.نجح(ح) -> { بيانات := ح.البيانات; طول_ := ح.الطول; سعة_ := ح.السعة; };
    دع العنصر: معرف_قيمة_مسير = (*النداء).الحجج[1];
    دع نوع_العنصر: معرف_نوع; طابق نوع_قيمة_مسير(المسير, العنصر) مع | اختياري.لا_شيء -> { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(العنصر)); } | اختياري.موجود(ن) -> { نوع_العنصر := ن; };
    دع تخطيط_العنصر: واصف_تخطيط; طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, نوع_العنصر) مع |
        نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ت) -> { تخطيط_العنصر := ت; };
    إذا (تخطيط_العنصر.الحجم == 0
        || ((*الهدف).نموذج_البيانات.عرض_المؤشر == 32
            && تخطيط_العنصر.الحجم > 0xFFFFFFFF)) {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(نوع_العنصر));
    };
    دع نوع_مؤشر: مرجع_نوع_إل_إل_في_إم = نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق);
    دع نوع_حجم: مرجع_نوع_إل_إل_في_إم = نوع_صحيح_إل_إل_في_إم((*الحالة).السياق, (*الهدف).نموذج_البيانات.عرض_المؤشر
        مثل ط32);
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    دع عنوان_البيانات: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه,
        بيانات.الإزاحة);
    دع عنوان_الطول: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, طول_.الإزاحة);
    دع عنوان_السعة: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_إزاحة_إل_إل_في_إم(الحالة, عنوان_المتجه, سعة_.الإزاحة);
    دع طول_حالي: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم, عنوان_الطول,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع سعة_حالية: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_حجم, عنوان_السعة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    // A corrupted header must never turn an out-of-bounds append into an
    // unchecked store. Reaching the maximum length also cannot wrap to zero.
    دع حد_الطول: متغير مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 0xFFFFFFFFFFFFFFFF, خطأ);
    إذا ((*الهدف).نموذج_البيانات.عرض_المؤشر == 32) {
        حد_الطول := ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 0xFFFFFFFF, خطأ);
    };
    دع تجاوز_السعة: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 34, طول_حالي, سعة_حالية,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, تجاوز_السعة);
    دع تجاوز_الطول: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 32, طول_حالي, حد_الطول,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, تجاوز_الطول);
    دع ممتلئ: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم((*الحالة).الباني, 32, طول_حالي, سعة_حالية,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع اسم_نمو: متغير متجه ط8 = [0]; دع اسم_استمرار: متغير متجه ط8 = [0];
    دع كتلة_نمو: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_نمو));
    دع كتلة_استمرار: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_استمرار));
    ابن_فرع_شرطي_إل_إل_في_إم((*الحالة).الباني, ممتلئ, كتلة_نمو, كتلة_استمرار);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_نمو);
    // capacity = max(capacity * growth, minimum, length + 1) (سعة_نمو_المتجه),
    // as every backend and the interpreter grow it.
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(تخطيط_العنصر.الحجم مثل طبيعي);
    دع التالي_الطول: مرجع_قيمة_إل_إل_في_إم = ابن_جمع_إل_إل_في_إم((*الحالة).الباني, طول_حالي,
        ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 1, خطأ), مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع سعة_جديدة: مرجع_قيمة_إل_إل_في_إم = ابن_سعة_نمو_المتجه_إل_إل_في_إم(
        الحالة, الدالة, نوع_حجم, حد_الطول, &السياسة, سعة_حالية, التالي_الطول);
    دع حجم_عنصر: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, تخطيط_العنصر.الحجم مثل ط64, خطأ);
    دع حد_البايتات: مرجع_قيمة_إل_إل_في_إم = ابن_قسمة_طبيعية_إل_إل_في_إم(
        (*الحالة).الباني, حد_الطول, حجم_عنصر, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع تجاوز_البايتات: مرجع_قيمة_إل_إل_في_إم = ابن_مقارنة_صحيحة_إل_إل_في_إم(
        (*الحالة).الباني, 34, سعة_جديدة, حد_البايتات,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_فخ_إذا_إل_إل_في_إم(الحالة, (*الدالة).الدالة, تجاوز_البايتات);
    دع بايتات: مرجع_قيمة_إل_إل_في_إم = ابن_ضرب_إل_إل_في_إم((*الحالة).الباني, سعة_جديدة, حجم_عنصر,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بيانات_قديمة: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر, عنوان_البيانات,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع بيانات_جديدة: مرجع_قيمة_إل_إل_في_إم; طابق ابن_إعادة_تخصيص_ذاكرة_إل_إل_في_إم(الحالة, الهدف, بيانات_قديمة,
        بايتات) مع | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم()); } |
        اختياري.موجود(ق) -> {
            تحقق_تخصيص_إل_إل_في_إم(الحالة, الدالة, ق);
            بيانات_جديدة := ق;
        };
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, بيانات_جديدة, عنوان_البيانات);
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, سعة_جديدة, عنوان_السعة);
    ابن_فرع_إل_إل_في_إم((*الحالة).الباني, كتلة_استمرار);
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_استمرار);
    دع بيانات_نهائية: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, نوع_مؤشر, عنوان_البيانات,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    دع مكان_العنصر: مرجع_قيمة_إل_إل_في_إم = ابن_عنوان_عنصر_إل_إل_في_إم(الحالة, بيانات_نهائية, طول_حالي,
        تخطيط_العنصر.الحجم);
    دع تمثيل_العنصر: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, العنصر) مع |
        نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> {
        تمثيل_العنصر := ق; };
    طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, نوع_العنصر, مكان_العنصر, &تمثيل_العنصر)
        مع | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
    دع واحد: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(نوع_حجم, 1, خطأ);
    دع طول_جديد: مرجع_قيمة_إل_إل_في_إم = ابن_جمع_إل_إل_في_إم((*الحالة).الباني, طول_حالي, واحد,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_تخزين_إل_إل_في_إم((*الحالة).الباني, طول_جديد, عنوان_الطول);
    أرجع اختياري.لا_شيء();
}

// --- Function / block lowering ---------------------------------------------

عرف تمثيل_معامل_واجهة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_معامل_واجهة,
    الدالة: مرجع_قيمة_إل_إل_في_إم,
    فهرس_إل_إل_في_إم: &متغير طبيعي
): نتيجة تمثيل_قيمة_إل_إل_في_إم, فشل_مزود_إل_إل_في_إم {
    دع قيد_النوع: قيد_نوع_إل_إل_في_إم;
    طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
    | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { قيد_النوع := ق; };
    إذا (معامل_واجهة_بالقيمة_في_الذاكرة_لإل_إل_في_إم(الخطة)) {
        دع المعامل: مرجع_قيمة_إل_إل_في_إم = معامل_دالة_إل_إل_في_إم(
            الدالة, (*فهرس_إل_إل_في_إم) مثل ط32
        );
        *فهرس_إل_إل_في_إم := *فهرس_إل_إل_في_إم + 1;
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المعامل));
    };
    طابق (*الخطة).الموقع مع
    | موقع_تمرير_واجهة.متجاهل -> {
        إذا (قيد_النوع.تجميعي) {
            دع التخطيط: واصف_تخطيط;
            طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(ت) -> { التخطيط := ت; };
            أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &قيد_النوع,
                التخطيط.المحاذاة)));
        };
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(قيمة_غير_معرفة_إل_إل_في_إم(قيد_النوع.التمثيل)));
    }
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        دع المعامل: مرجع_قيمة_إل_إل_في_إم = معامل_دالة_إل_إل_في_إم(الدالة, (*فهرس_إل_إل_في_إم) مثل ط32);
        *فهرس_إل_إل_في_إم := *فهرس_إل_إل_في_إم + 1;
        إذا (قيد_النوع.تجميعي) { أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المعامل)); };
        دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
        دع القيمة: مرجع_قيمة_إل_إل_في_إم = ابن_تحميل_إل_إل_في_إم((*الحالة).الباني, قيد_النوع.التمثيل, المعامل,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(القيمة));
    }
    | موقع_تمرير_واجهة.مباشر(_) -> { }
    | موقع_تمرير_واجهة.مجزأ(_) -> { };
    إذا (!(*الخطة).التصنيف.تجميعي) {
        دع المعامل: مرجع_قيمة_إل_إل_في_إم = معامل_دالة_إل_إل_في_إم(الدالة, (*فهرس_إل_إل_في_إم) مثل ط32);
        *فهرس_إل_إل_في_إم := *فهرس_إل_إل_في_إم + 1;
        أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.سلمية(المعامل));
    };
    دع التخطيط: واصف_تخطيط;
    طابق تخطيط_نوع_إل_إل_في_إم(الحقائق, الهدف, سجل_التخطيط, (*الخطة).النوع) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(ت) -> { التخطيط := ت; };
    دع المكان: مرجع_قيمة_إل_إل_في_إم = حجز_تمثيل_نوع_إل_إل_في_إم(الحالة, &قيد_النوع, التخطيط.المحاذاة);
    دع المعاملات_الواردة: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    دع عدد_الواردة: طبيعي = عدد_معاملات_أجزاء_واجهة_إل_إل_في_إم(&(*الخطة).التصنيف);
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الواردة) {
        ألحق(المعاملات_الواردة, معامل_دالة_إل_إل_في_إم(الدالة, (*فهرس_إل_إل_في_إم) مثل ط32));
        *فهرس_إل_إل_في_إم := *فهرس_إل_إل_في_إم + 1;
        ف := ف + 1;
    }
    خزّن_معاملات_أجزاء_واجهة_إل_إل_في_إم(
        الحالة, المكان, &(*الخطة).التصنيف, &(*الخطة).أشكال_الأجزاء, &المعاملات_الواردة
    );
    أرجع نتيجة.نجح(تمثيل_قيمة_إل_إل_في_إم.عنوان(المكان));
}

عرف هيئ_معاملات_دالة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العرض: &عرض_دالة_مسير,
    الخطة: &خطة_دالة_واجهة,
    له_بيئة_إغلاق: منطقي
): اختياري فشل_مزود_إل_إل_في_إم {
    دع فهرس_إل_إل_في_إم: متغير طبيعي = 0;
    طابق (*الخطة).الناتج.الموقع مع
    | موقع_تمرير_واجهة.غير_مباشر(_) -> {
        (*الدالة).عنوان_الناتج_غير_المباشر := اختياري.موجود(معامل_دالة_إل_إل_في_إم((*الدالة).الدالة,
            فهرس_إل_إل_في_إم مثل ط32));
        فهرس_إل_إل_في_إم := فهرس_إل_إل_في_إم + 1;
    }
    | _ -> { };
    إذا (له_بيئة_إغلاق) {
        إذا ((*العرض).عدد_الالتقاطات > 0) {
            (*الدالة).بيئة_الإغلاق := اختياري.موجود(معامل_دالة_إل_إل_في_إم(
                (*الدالة).الدالة, فهرس_إل_إل_في_إم مثل ط32
            ));
        };
        فهرس_إل_إل_في_إم := فهرس_إل_إل_في_إم + 1;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*العرض).عدد_المعاملات) {
        دع القيمة: عرض_قيمة_مسير;
        طابق معامل_دالة_مسير_عند(المسير, (*العرض).المعرف, ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.دالة_مفقودة((*العرض).المعرف)); }
        | اختياري.موجود(ق) -> { القيمة := ق; };
        دع التمثيل: تمثيل_قيمة_إل_إل_في_إم;
        طابق تمثيل_معامل_واجهة_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, &(*الخطة).المعاملات[ف],
            (*الدالة).الدالة, &متغير فهرس_إل_إل_في_إم) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(ق) -> { التمثيل := ق; };
        ضع_قيمة_إل_إل_في_إم(الدالة, القيمة.المعرف, التمثيل);
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف هيئ_كتل_وفاي_دالة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    العرض: &عرض_دالة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*العرض).عدد_الكتل) {
        دع المعرف: معرف_كتلة_مسير;
        طابق معرف_كتلة_مسير_عند(المسير, (*العرض).المعرف, ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(معرف_كتلة_مسير_من((*العرض).المعرف,
            ف))); }
        | اختياري.موجود(م) -> { المعرف := م; };
        دع الاسم_الخام: متجه ط8 = اسم_كتلة_إل_إل_في_إم(المعرف.القيمة);
        دع الاسم: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&الاسم_الخام);
        دع الكتلة: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة,
            مؤشر_اسم_سي_لإل_إل_في_إم(&متغير الاسم));
        طالما ((الطول((*الدالة).الكتل) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) { ألحق((*الدالة).الكتل, الكتلة); }
        (*الدالة).الكتل[المعرف.القيمة] := الكتلة;
        طالما ((الطول((*الدالة).فاي_الكتل) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) { دع خ: متجه اختياري
            مرجع_قيمة_إل_إل_في_إم = []; ألحق((*الدالة).فاي_الكتل, خ); }
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (*العرض).عدد_الكتل) {
        دع المعرف: معرف_كتلة_مسير; طابق معرف_كتلة_مسير_عند(المسير, (*العرض).المعرف, ف) مع | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختياري.موجود(م) -> { المعرف := م;
            };
        دع عرض_الكتلة: عرض_كتلة_مسير; طابق ابحث_كتلة_مسير(المسير, المعرف) مع | نتيجة_بحث_كتلة_مسير.مفقودة(_) ->
            { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(المعرف)); } | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> {
            عرض_الكتلة := ع; };
        ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, (*الدالة).الكتل[المعرف.القيمة]);
        دع م: متغير طبيعي = 0;
        طالما (م < عرض_الكتلة.عدد_المعاملات) {
            دع المعامل: عرض_قيمة_مسير; طابق معامل_كتلة_مسير_عند(المسير, المعرف, م) مع | اختياري.لا_شيء -> { أرجع
                اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختياري.موجود(ق) -> { المعامل := ق;
                };
            دع القيد: قيد_نوع_إل_إل_في_إم; طابق حل_نوع_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط,
                المعامل.النوع) مع | نتيجة_نوع_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); } |
                نتيجة_نوع_إل_إل_في_إم.نجح(ق) -> { القيد := ق; };
            دع نوع_فاي: متغير مرجع_نوع_إل_إل_في_إم = القيد.التمثيل; إذا (القيد.تجميعي) { نوع_فاي :=
                نوع_مؤشر_إل_إل_في_إم((*الحالة).السياق); };
            دع اسم_فاي: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
            دع فاي: مرجع_قيمة_إل_إل_في_إم = ابن_فاي_إل_إل_في_إم((*الحالة).الباني, نوع_فاي,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فاي));
            ألحق((*الدالة).فاي_الكتل[المعرف.القيمة], اختياري.موجود(فاي));
            إذا (القيد.تجميعي) { ضع_قيمة_إل_إل_في_إم(الدالة, المعامل.المعرف, تمثيل_قيمة_إل_إل_في_إم.عنوان(فاي));
                }
            وإلا { ضع_قيمة_إل_إل_في_إم(الدالة, المعامل.المعرف, تمثيل_قيمة_إل_إل_في_إم.سلمية(فاي)); };
            م := م + 1;
        }
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أضف_حافة_فاي_إل_إل_في_إم(
    الدالة: &حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير,
    السابق: مرجع_كتلة_إل_إل_في_إم
): اختياري فشل_مزود_إل_إل_في_إم {
    دع الهدف_: معرف_كتلة_مسير = (*الحافة).الهدف;
    دع العرض: عرض_كتلة_مسير; طابق ابحث_كتلة_مسير(المسير, الهدف_) مع | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(الهدف_)); } | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> { العرض := ع;
        };
    إذا ((الطول((*الحافة).الحجج) مثل طبيعي) != العرض.عدد_المعاملات) { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.حافة_مسير_غير_صالحة()); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض.عدد_المعاملات) {
        طابق (*الدالة).فاي_الكتل[الهدف_.القيمة][ف] مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.حافة_مسير_غير_صالحة()); }
        | اختياري.موجود(فاي) -> {
            دع التمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, (*الحافة).الحجج[ف]) مع |
                نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> {
                التمثيل := ق; };
            دع الداخل: مرجع_قيمة_إل_إل_في_إم; طابق التمثيل مع | تمثيل_قيمة_إل_إل_في_إم.سلمية(ق) -> { الداخل :=
                ق; } | تمثيل_قيمة_إل_إل_في_إم.عنوان(ق) -> { الداخل := ق; };
            دع قيم: متغير متجه مرجع_قيمة_إل_إل_في_إم = [الداخل]; دع كتل: متغير متجه مرجع_كتلة_إل_إل_في_إم =
                [السابق];
            أضف_دخل_فاي_إل_إل_في_إم(فاي, &متغير قيم[0], &متغير كتل[0], 1);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اخفض_منهي_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الخطة: &خطة_دالة_واجهة,
    المنهي: &منهي_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        دع السابق: مرجع_كتلة_إل_إل_في_إم = كتلة_الباني_الحالية_إل_إل_في_إم((*الحالة).الباني);
        طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &الحافة, السابق) مع | اختياري.موجود(خ) -> { أرجع
            اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
        دع الوجهة: مرجع_كتلة_إل_إل_في_إم; طابق كتلة_إل_إل_في_إم(الدالة, الحافة.الهدف) مع | نتيجة.خطأ(خ) -> {
            أرجع اختياري.موجود(خ); } | نتيجة.نجح(ك) -> { الوجهة := ك; };
        ابن_فرع_إل_إل_في_إم((*الحالة).الباني, الوجهة);
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        دع قيمة_الشرط: مرجع_قيمة_إل_إل_في_إم; طابق سلمية_إل_إل_في_إم(الدالة, الشرط) مع | نتيجة.خطأ(خ) -> { أرجع
            اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { قيمة_الشرط := ق; };
        دع السابق: مرجع_كتلة_إل_إل_في_إم = كتلة_الباني_الحالية_إل_إل_في_إم((*الحالة).الباني);
        دع كتلة_الصواب: مرجع_كتلة_إل_إل_في_إم; طابق كتلة_إل_إل_في_إم(الدالة, عند_الصواب.الهدف) مع | نتيجة.خطأ(خ)
            -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ك) -> { كتلة_الصواب := ك; };
        دع كتلة_الخطأ: مرجع_كتلة_إل_إل_في_إم; طابق كتلة_إل_إل_في_إم(الدالة, عند_الخطأ.الهدف) مع | نتيجة.خطأ(خ)
            -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ك) -> { كتلة_الخطأ := ك; };
        // LLVM PHIs are keyed by predecessor block, not by abstract CFG edge.
        // If both conditional edges target the same MSIR block, preserve the two
        // distinct edge-argument sets with two synthetic LLVM edge blocks.
        إذا (كتلتان_مسير_متساويتان(عند_الصواب.الهدف, عند_الخطأ.الهدف)) {
            دع اسم_حافة_صواب: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
            دع اسم_حافة_خطأ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
            دع حافة_صواب: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_حافة_صواب));
            دع حافة_خطأ: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم((*الحالة).السياق, (*الدالة).الدالة,
                مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_حافة_خطأ));
            ابن_فرع_شرطي_إل_إل_في_إم((*الحالة).الباني, قيمة_الشرط, حافة_صواب, حافة_خطأ);
            ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, حافة_صواب);
            طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &عند_الصواب, حافة_صواب) مع | اختياري.موجود(خ) -> { أرجع
                اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
            ابن_فرع_إل_إل_في_إم((*الحالة).الباني, كتلة_الصواب);
            ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, حافة_خطأ);
            طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &عند_الخطأ, حافة_خطأ) مع | اختياري.موجود(خ) -> { أرجع
                اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
            ابن_فرع_إل_إل_في_إم((*الحالة).الباني, كتلة_الخطأ);
        } وإلا {
            طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &عند_الصواب, السابق) مع | اختياري.موجود(خ) -> { أرجع
                اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
            طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &عند_الخطأ, السابق) مع | اختياري.موجود(خ) -> { أرجع
                اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
            ابن_فرع_شرطي_إل_إل_في_إم((*الحالة).الباني, قيمة_الشرط, كتلة_الصواب, كتلة_الخطأ);
        };
    }
    | منهي_مسير.فرع_متعدد(الفرع) -> {
        دع قيمة_الاختيار: مرجع_قيمة_إل_إل_في_إم;
        طابق سلمية_إل_إل_في_إم(الدالة, الفرع.المميز) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(القيمة) -> { قيمة_الاختيار := القيمة; };
        دع النوع: مرجع_نوع_إل_إل_في_إم = نوع_قيمة_إل_إل_في_إم(قيمة_الاختيار);
        دع الأصل: مرجع_كتلة_إل_إل_في_إم = كتلة_الباني_الحالية_إل_إل_في_إم((*الحالة).الباني);
        // Every edge has its own LLVM predecessor: MSIR block arguments may
        // differ even when multiple cases point to the same destination.
        دع اسم_فارغ: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
        دع كتلة_الافتراضي: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم(
            (*الحالة).السياق, (*الدالة).الدالة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فارغ)
        );
        دع المنهي_المرجعي: مرجع_قيمة_إل_إل_في_إم = LLVMBuildSwitch(
            (*الحالة).الباني, قيمة_الاختيار, كتلة_الافتراضي,
            الطول(الفرع.الحالات) مثل ط32
        );
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
            دع الحالة_الواحدة: &حالة_فرع_متعدد_مسير = &الفرع.الحالات[ف];
            دع كتلة_الفرع: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم(
                (*الحالة).السياق, (*الدالة).الدالة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_فارغ)
            );
            دع المفتاح: مرجع_قيمة_إل_إل_في_إم = ثابت_صحيح_إل_إل_في_إم(
                النوع, (*الحالة_الواحدة).الوسم مثل ط64, خطأ
            );
            LLVMAddCase(المنهي_المرجعي, المفتاح, كتلة_الفرع);
            ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_الفرع);
            طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &(*الحالة_الواحدة).الحافة, كتلة_الفرع) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            دع الهدف_الحالي: مرجع_كتلة_إل_إل_في_إم;
            طابق كتلة_إل_إل_في_إم(الدالة, (*الحالة_الواحدة).الحافة.الهدف) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة.نجح(الكتلة) -> { الهدف_الحالي := الكتلة; };
            ابن_فرع_إل_إل_في_إم((*الحالة).الباني, الهدف_الحالي);
            ف := ف + 1;
        }
        ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, كتلة_الافتراضي);
        طابق أضف_حافة_فاي_إل_إل_في_إم(الدالة, المسير, &الفرع.الافتراضي, كتلة_الافتراضي) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        دع هدف_الافتراضي: مرجع_كتلة_إل_إل_في_إم;
        طابق كتلة_إل_إل_في_إم(الدالة, الفرع.الافتراضي.الهدف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة.نجح(الكتلة) -> { هدف_الافتراضي := الكتلة; };
        ابن_فرع_إل_إل_في_إم((*الحالة).الباني, هدف_الافتراضي);
        ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, الأصل);
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        طابق (*الخطة).الناتج.الموقع مع
        | موقع_تمرير_واجهة.متجاهل -> { ابن_إرجاع_فراغ_إل_إل_في_إم((*الحالة).الباني); }
        | موقع_تمرير_واجهة.غير_مباشر(_) -> {
            دع المعرف: معرف_قيمة_مسير; طابق القيمة مع | اختياري.لا_شيء -> { أرجع
                اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختياري.موجود(ق) -> { المعرف := ق; };
            دع العنوان: مرجع_قيمة_إل_إل_في_إم; طابق (*الدالة).عنوان_الناتج_غير_المباشر مع | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); } | اختياري.موجود(ع) -> { العنوان
                := ع; };
            دع التمثيل: تمثيل_قيمة_إل_إل_في_إم; طابق قيمة_إل_إل_في_إم(الدالة, المعرف) مع |
                نتيجة_قيمة_إل_إل_في_إم.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة_قيمة_إل_إل_في_إم.نجح(ق) -> {
                التمثيل := ق; };
            طابق خزّن_في_مكان_إل_إل_في_إم(الحالة, الحقائق, الهدف, سجل_التخطيط, (*الخطة).الناتج.النوع, العنوان,
                &التمثيل) مع | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
            ابن_إرجاع_فراغ_إل_إل_في_إم((*الحالة).الباني);
        }
        | _ -> {
            دع المعرف: معرف_قيمة_مسير; طابق القيمة مع | اختياري.لا_شيء -> { أرجع
                اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختياري.موجود(ق) -> { المعرف := ق; };
            دع الناتج: مرجع_قيمة_إل_إل_في_إم; طابق اجمع_ناتج_واجهة_للإرجاع_إل_إل_في_إم(الحالة, الدالة,
                &(*الخطة).الناتج, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); } | نتيجة.نجح(ق) -> {
                الناتج := ق; };
            ابن_إرجاع_إل_إل_في_إم((*الحالة).الباني, الناتج);
        };
    }
    | منهي_مسير.فخ -> { ابن_فخ_إل_إل_في_إم(الحالة); };
    أرجع اختياري.لا_شيء();
}



// LLVM instruction emission must follow CFG dominance, not canonical storage order.
// Blocks and PHIs are still predeclared for the whole function, then reachable bodies
// are emitted in reverse postorder so every ordinary SSA definition dominates its use.
عرف ابن_ترتيب_بعدي_كتل_إل_إل_في_إم(
    الدالة: &دالة_مسير,
    المعرف: معرف_كتلة_مسير,
    المزارة: &متغير متجه منطقي,
    البعدي: &متغير متجه معرف_كتلة_مسير
): فراغ {
    // An explicit stack of (block, next successor): the same post-order as
    // a recursive walk, without one native frame per block of a long chain.
    طالما ((الطول(*المزارة) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) { ألحق(*المزارة, خطأ); }
    إذا ((*المزارة)[المعرف.القيمة]) { أرجع; };
    (*المزارة)[المعرف.القيمة] := صواب;
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) { أرجع; };
    دع الكتل: متغير متجه معرف_كتلة_مسير = [المعرف];
    دع التالي: متغير متجه طبيعي = [0];
    طالما ((الطول(الكتل) مثل طبيعي) > 0) {
        دع القمة: طبيعي = (الطول(الكتل) مثل طبيعي) - 1;
        دع الحالية: معرف_كتلة_مسير = الكتل[القمة];
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[الحالية.القيمة]);
        إذا (التالي[القمة] < (الطول(الخلفاء) مثل طبيعي)) {
            دع الخلف: معرف_كتلة_مسير = الخلفاء[التالي[القمة]];
            التالي[القمة] := التالي[القمة] + 1;
            طالما ((الطول(*المزارة) مثل طبيعي) <= (الخلف.القيمة مثل طبيعي)) { ألحق(*المزارة, خطأ); }
            إذا (!(*المزارة)[الخلف.القيمة]) {
                (*المزارة)[الخلف.القيمة] := صواب;
                إذا ((الخلف.القيمة مثل طبيعي) < (الطول((*الدالة).الكتل) مثل طبيعي)) {
                    ألحق(الكتل, الخلف);
                    ألحق(التالي, 0);
                };
            };
        } وإلا {
            ألحق(*البعدي, الحالية);
            دع تجاهل_كتلة: اختياري معرف_كتلة_مسير = أزل_الأخير(الكتل);
            دع تجاهل_موضع: اختياري طبيعي = أزل_الأخير(التالي);
        };
    }
}

عرف ترتيب_خفض_كتل_إل_إل_في_إم(الدالة: &دالة_مسير): متجه معرف_كتلة_مسير {
    دع المزارة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).الكتل) مثل طبيعي)) { ألحق(المزارة, خطأ); ف := ف + 1; }
    دع الناتج: متغير متجه معرف_كتلة_مسير = [];
    دع البعدي: متغير متجه معرف_كتلة_مسير = [];
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(المدخل) -> { ابن_ترتيب_بعدي_كتل_إل_إل_في_إم(الدالة, المدخل, &متغير المزارة, &متغير البعدي); }
    | اختياري.لا_شيء -> { };
    ألحق_معكوسا_كتل_إل_إل_في_إم(&متغير الناتج, &البعدي);
    // Preserve valid unreachable components too; each component gets the same
    // dominance-safe traversal instead of silently dropping canonical MSIR blocks.
    // Each comes after the reachable blocks (in its own reverse postorder):
    // an unreachable block may use a value the entry defines (the code after
    // a branch a specialized copy folded away), which must be emitted first.
    ف := 0;
    طالما (ف < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع المعرف: معرف_كتلة_مسير = (*الدالة).الكتل[ف].المعرف;
        إذا (!المزارة[المعرف.القيمة]) {
            دع المكون: متغير متجه معرف_كتلة_مسير = [];
            ابن_ترتيب_بعدي_كتل_إل_إل_في_إم(الدالة, المعرف, &متغير المزارة, &متغير المكون);
            ألحق_معكوسا_كتل_إل_إل_في_إم(&متغير الناتج, &المكون);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ألحق_معكوسا_كتل_إل_إل_في_إم(الناتج: &متغير متجه معرف_كتلة_مسير, البعدي: &متجه معرف_كتلة_مسير): فراغ {
    دع ع: متغير طبيعي = الطول(*البعدي) مثل طبيعي;
    طالما (ع > 0) { ع := ع - 1; ألحق(*الناتج, (*البعدي)[ع]); }
}

عرف سجل_تعريفات_كتلة_تصحيح_إل_إل_في_إم(
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    حالة_المزود: &حالة_مزود_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    بيانات_التصحيح: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    حالة_الدالة: &متغير حالة_دالة_إل_إل_في_إم,
    العرض: &عرض_دالة_مسير,
    معرف_الكتلة: معرف_كتلة_مسير,
    المدخل: معرف_كتلة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    إذا (!(*حالة_التصحيح).مفعلة) { أرجع اختياري.لا_شيء(); };
    دع كتلة_إل_إل_في_إم_: مرجع_كتلة_إل_إل_في_إم = (*حالة_الدالة).الكتل[معرف_الكتلة.القيمة];
    دع قبل_التعليمة: مرجع_قيمة_إل_إل_في_إم = منهي_كتلة_إل_إل_في_إم(كتلة_إل_إل_في_إم_);
    // DbgRecords in LLVM's new debug format must be anchored before a real
    // instruction. Emit variable records only after the block terminator exists,
    // and place them immediately before that terminator.
    دع م: متغير طبيعي = 0;
    إذا (كتلتان_مسير_متساويتان(معرف_الكتلة, المدخل)) {
        طالما (م < (*العرض).عدد_المعاملات) {
            طابق معامل_دالة_مسير_عند(المسير, (*العرض).المعرف, م) مع
            | اختياري.موجود(قيمة) -> {
                طابق قيمة_إل_إل_في_إم(حالة_الدالة, قيمة.المعرف) مع
                | نتيجة_قيمة_إل_إل_في_إم.نجح(تمثيل) -> { سجل_قيمة_تصحيح_إل_إل_في_إم(حالة_التصحيح, حالة_المزود,
                    الحقائق, الهدف, سجل_التخطيط, بيانات_التصحيح, المصادر, الأصول, قيمة.المعرف, &تمثيل,
                    قبل_التعليمة); }
                | نتيجة_قيمة_إل_إل_في_إم.خطأ(_) -> { };
            }
            | اختياري.لا_شيء -> { };
            م := م + 1;
        }
    };
    دع عرض_الكتلة: عرض_كتلة_مسير;
    طابق ابحث_كتلة_مسير(المسير, معرف_الكتلة) مع | نتيجة_بحث_كتلة_مسير.موجودة(ك) -> { عرض_الكتلة := ك; } | _ -> {
        أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
    م := 0;
    طالما (م < عرض_الكتلة.عدد_المعاملات) {
        طابق معامل_كتلة_مسير_عند(المسير, معرف_الكتلة, م) مع
        | اختياري.موجود(قيمة) -> {
            طابق قيمة_إل_إل_في_إم(حالة_الدالة, قيمة.المعرف) مع
            | نتيجة_قيمة_إل_إل_في_إم.نجح(تمثيل) -> { سجل_قيمة_تصحيح_إل_إل_في_إم(حالة_التصحيح, حالة_المزود,
                الحقائق, الهدف, سجل_التخطيط, بيانات_التصحيح, المصادر, الأصول, قيمة.المعرف, &تمثيل,
                قبل_التعليمة); }
            | نتيجة_قيمة_إل_إل_في_إم.خطأ(_) -> { };
        }
        | اختياري.لا_شيء -> { };
        م := م + 1;
    }
    دع ت: متغير طبيعي = 0;
    طالما (ت < عرض_الكتلة.عدد_التعليمات) {
        طابق تعليمة_مسير_عند(المسير, معرف_الكتلة, ت) مع
        | اختياري.موجود(تعليمة) -> {
            طابق تعليمة.الناتج مع
            | اختياري.موجود(معرف_الناتج) -> {
                طابق قيمة_إل_إل_في_إم(حالة_الدالة, معرف_الناتج) مع
                | نتيجة_قيمة_إل_إل_في_إم.نجح(تمثيل) -> { سجل_قيمة_تصحيح_إل_إل_في_إم(حالة_التصحيح, حالة_المزود,
                    الحقائق, الهدف, سجل_التخطيط, بيانات_التصحيح, المصادر, الأصول, معرف_الناتج, &تمثيل,
                    قبل_التعليمة); }
                | نتيجة_قيمة_إل_إل_في_إم.خطأ(_) -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
        ت := ت + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف اخفض_جسم_دالة_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    بيانات_التصحيح: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    المعرف: معرف_دالة_مسير
): اختياري فشل_مزود_إل_إل_في_إم {
    دع العرض: عرض_دالة_مسير; طابق ابحث_دالة_مسير(المسير, المعرف) مع | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); } | نتيجة_بحث_دالة_مسير.موجودة(ع) -> { العرض := ع;
        };
    دع القيد: قيد_دالة_إل_إل_في_إم; طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع | نتيجة.خطأ(خ) -> { أرجع
        اختياري.موجود(خ); } | نتيجة.نجح(ق) -> { القيد := ق; };
    دع عدد_القيم: طبيعي; طابق عدد_قيم_دالة_مسير(المسير, المعرف) مع | اختياري.لا_شيء -> { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); } | اختياري.موجود(ع) -> { عدد_القيم := ع; };
    دع القيم: متغير متجه اختياري تمثيل_قيمة_إل_إل_في_إم = []; دع ف: متغير طبيعي = 0; طالما (ف < عدد_القيم) {
        ألحق(القيم, اختياري.لا_شيء()); ف := ف + 1; }
    دع الكتل: متجه مرجع_كتلة_إل_إل_في_إم = []; دع فاي: متجه متجه اختياري مرجع_قيمة_إل_إل_في_إم = [];
    دع حالة_الدالة: متغير حالة_دالة_إل_إل_في_إم = { المعرف: المعرف, الدالة: القيد.الدالة, نوع_الدالة:
        القيد.نوع_الدالة, الكتل: الكتل, القيم: القيم, فاي_الكتل: فاي, بيئة_الإغلاق: اختياري.لا_شيء(),
        عنوان_الناتج_غير_المباشر: اختياري.لا_شيء(), الثابتة: مخازن_ثابتة_لدالة_إل_إل_في_إم(المسير, المعرف) };
    // Keep all temporary stack allocations in a dedicated function-entry
    // block. Emitting alloca in loop bodies grows the native stack on every
    // iteration and can exhaust the process stack while compiling large files.
    دع اسم_كتلة_الحجز_الخام: متجه ط8 = بايتات_من_نص(«alloca»);
    دع اسم_كتلة_الحجز: متغير متجه ط8 = اجعل_اسما_سي_لإل_إل_في_إم(&اسم_كتلة_الحجز_الخام);
    دع كتلة_الحجز: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم(
        (*الحالة).السياق,
        القيد.الدالة,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_كتلة_الحجز)
    );
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).باني_الحجز, كتلة_الحجز);
    دع الخطة: متغير خطة_دالة_واجهة; طابق حل_واجهة_عرض_دالة_مسير_للهدف(الحقائق, المسير, الهدف, سجل_التخطيط, &العرض) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة()); } | نتيجة.نجح(خ) ->
        { الخطة := خ; };
    طابق هيئ_كتل_وفاي_دالة_إل_إل_في_إم(الحالة, &متغير حالة_الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &العرض)
        مع | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
    دع المدخل: معرف_كتلة_مسير; طابق العرض.المدخل مع | اختياري.لا_شيء -> { أرجع
        اختياري.موجود(فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف)); } | اختياري.موجود(م) -> { المدخل := م; };
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, حالة_الدالة.الكتل[المدخل.القيمة]);
    ابدأ_دالة_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحالة, بيانات_التصحيح, المعرف);
    طابق هيئ_معاملات_دالة_إل_إل_في_إم(الحالة, &متغير حالة_الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &العرض,
        &الخطة, القيد.له_بيئة_إغلاق) مع | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
    دع مرجع_الدالة_المسير: &دالة_مسير = &(*المسير).المسير.الدوال[المعرف.القيمة];
    دع ترتيب_الخفض: متجه معرف_كتلة_مسير = ترتيب_خفض_كتل_إل_إل_في_إم(مرجع_الدالة_المسير);
    ف := 0;
    طالما (ف < (الطول(ترتيب_الخفض) مثل طبيعي)) {
        دع معرف_الكتلة: معرف_كتلة_مسير = ترتيب_الخفض[ف];
        دع عرض_الكتلة: عرض_كتلة_مسير; طابق ابحث_كتلة_مسير(المسير, معرف_الكتلة) مع |
            نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(معرف_الكتلة)); }
            | نتيجة_بحث_كتلة_مسير.موجودة(ع) -> { عرض_الكتلة := ع; };
        ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, حالة_الدالة.الكتل[معرف_الكتلة.القيمة]);
        دع ت: متغير طبيعي = 0;
        طالما (ت < عرض_الكتلة.عدد_التعليمات) {
            دع التعليمة: عرض_تعليمة_مسير; طابق تعليمة_مسير_عند(المسير, معرف_الكتلة, ت) مع | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); } | اختياري.موجود(ع) -> { التعليمة
                := ع; };
            ضع_موقع_تعليمة_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحالة, بيانات_التصحيح, المصادر, الأصول, المعرف,
                &التعليمة);
            طابق اخفض_تعليمة_إل_إل_في_إم(الحالة, &متغير حالة_الدالة, المسير, الحقائق, الهدف, سجل_التخطيط,
                &التعليمة) مع | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
            امسح_موقع_تعليمة_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحالة);
            ت := ت + 1;
        }
        امسح_موقع_تعليمة_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحالة);
        دع المنهي: منهي_مسير; طابق منهي_كتلة_مسير(المسير, معرف_الكتلة) مع | نتيجة_بحث_منهي_مسير.موجود(م) -> {
            المنهي := م; } | _ -> { أرجع اختياري.موجود(فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة()); };
        طابق اخفض_منهي_إل_إل_في_إم(الحالة, &متغير حالة_الدالة, المسير, الحقائق, الهدف, سجل_التخطيط, &الخطة,
            &المنهي) مع | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
        طابق سجل_تعريفات_كتلة_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحالة, المسير, الحقائق, الهدف, سجل_التخطيط,
            بيانات_التصحيح, المصادر, الأصول, &متغير حالة_الدالة, &العرض, معرف_الكتلة, المدخل) مع | اختياري.موجود(خ)
            -> { أرجع اختياري.موجود(خ); } | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    // The allocation block is the LLVM entry block and transfers control to
    // the semantic MSIR entry only after all temporary allocas are emitted.
    ابن_فرع_إل_إل_في_إم(
        (*الحالة).باني_الحجز,
        حالة_الدالة.الكتل[المدخل.القيمة]
    );
    أنه_دالة_تصحيح_إل_إل_في_إم(حالة_التصحيح, الحالة);
    أرجع اختياري.لا_شيء();
}

عام عرف اخفض_كل_دوال_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    حالة_التصحيح: &متغير حالة_تصحيح_إل_إل_في_إم,
    المسير: &سياق_مستهلك_مسير,
    الحقائق: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    بيانات_التصحيح: &بيانات_تصحيح_مسير,
    المصادر: &متغير خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    الدوال_المطلوبة: &متجه منطقي
): اختياري فشل_مزود_إل_إل_في_إم {
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_دوال_مسير(المسير)) {
        طابق معرف_دالة_مسير_عند(المسير, ف) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المعرف) -> {
            إذا (دالة_إل_إل_في_إم_مطلوبة(الدوال_المطلوبة, المعرف)) {
                دع نص_التبديل: متغير اختياري متجه ط8 = اختياري.لا_شيء();
                طابق (*المسير).المسير.دالة_تبديل_سياق_المهام مع
                | اختياري.موجود(د) -> {
                    إذا (د.القيمة == المعرف.القيمة) { نص_التبديل := نص_تبديل_سياق_المهام_إل_إل_في_إم(الهدف); };
                }
                | اختياري.لا_شيء -> { };
                طابق نص_التبديل مع
                | اختياري.موجود(النص) -> {
                    طابق اخفض_تبديل_سياق_المهام_إل_إل_في_إم(الحالة, المعرف, &النص) مع
                    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> {
                    طابق اخفض_جسم_دالة_إل_إل_في_إم(الحالة, حالة_التصحيح, المسير, الحقائق, الهدف, سجل_التخطيط,
                        بيانات_التصحيح, المصادر, الأصول, المعرف) مع
                    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// std.async's task context switch (اسم_تبديل_سياق_المهام_أساسي) on System V
// x86_64 and AAPCS64: a naked function of fixed assembly, the same routine
// and saved-frame layout as the native encoders. LLVM passes the closure
// environment first, so the save address and the new stack are the second
// and third arguments. Other targets keep the source body (no switching).
عرف نص_تبديل_سياق_المهام_إل_إل_في_إم(الهدف: &واصف_هدف): اختياري متجه ط8 {
    إذا ((*الهدف).المنصة.المنصة == هوية_منصة.ويندوز()) { أرجع اختياري.لا_شيء(); };
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        دع ن: متجه ط8 = بايتات_منتهية_بصفر_من_نص("testq %rdx,%rdx\njnz 1f\nleaq 2f(%rip),%rax\nretq\n1:\npushq %rbp\npushq %rbx\npushq %r12\npushq %r13\npushq %r14\npushq %r15\nmovq %rsp,(%rsi)\nmovq %rdx,%rsp\npopq %r15\npopq %r14\npopq %r13\npopq %r12\npopq %rbx\npopq %rbp\nxorl %eax,%eax\nretq\n2:\nmovq %r12,%rdi\nmovq %r12,%r15\ncallq *(%r12)\nud2");
        أرجع اختياري.موجود(ن);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        دع ن: متجه ط8 = بايتات_منتهية_بصفر_من_نص("cbnz x2, 1f\nadr x0, 2f\nret\n1:\nsub sp, sp, #176\nstp x19, x20, [sp, #0]\nstp x21, x22, [sp, #16]\nstp x23, x24, [sp, #32]\nstp x25, x26, [sp, #48]\nstp x27, x28, [sp, #64]\nstp x29, x30, [sp, #80]\nstp d8, d9, [sp, #96]\nstp d10, d11, [sp, #112]\nstp d12, d13, [sp, #128]\nstp d14, d15, [sp, #144]\nmov x9, sp\nstr x9, [x1]\nmov sp, x2\nldp x19, x20, [sp, #0]\nldp x21, x22, [sp, #16]\nldp x23, x24, [sp, #32]\nldp x25, x26, [sp, #48]\nldp x27, x28, [sp, #64]\nldp x29, x30, [sp, #80]\nldp d8, d9, [sp, #96]\nldp d10, d11, [sp, #112]\nldp d12, d13, [sp, #128]\nldp d14, d15, [sp, #144]\nadd sp, sp, #176\nmov x0, #0\nret\n2:\nmov x0, x19\nmov x14, x19\nldr x16, [x19]\nblr x16\nbrk #0");
        أرجع اختياري.موجود(ن);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف اخفض_تبديل_سياق_المهام_إل_إل_في_إم(
    الحالة: &متغير حالة_مزود_إل_إل_في_إم,
    المعرف: معرف_دالة_مسير,
    النص: &متجه ط8
): اختياري فشل_مزود_إل_إل_في_إم {
    دع القيد: قيد_دالة_إل_إل_في_إم;
    طابق ابحث_قيد_دالة_إل_إل_في_إم(الحالة, المعرف) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(ق) -> { القيد := ق; };
    // naked: no prologue, the arguments stay in their registers; noinline:
    // the routine returns on another stack.
    دع اسم_عاري: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«naked»);
    دع معرف_عاري: ط32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_عاري), 5);
    أضف_صفة_معامل_إل_إل_في_إم(القيد.الدالة, 0xFFFFFFFF مثل ط32,
        أنشئ_صفة_تعداد_إل_إل_في_إم((*الحالة).السياق, معرف_عاري, 0));
    دع اسم_بلا_تضمين: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«noinline»);
    دع معرف_بلا_تضمين: ط32 = معرف_صفة_إل_إل_في_إم(مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_بلا_تضمين), 8);
    أضف_صفة_معامل_إل_إل_في_إم(القيد.الدالة, 0xFFFFFFFF مثل ط32,
        أنشئ_صفة_تعداد_إل_إل_في_إم((*الحالة).السياق, معرف_بلا_تضمين, 0));
    دع اسم_الكتلة: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«entry»);
    دع الكتلة: مرجع_كتلة_إل_إل_في_إم = أضف_كتلة_إل_إل_في_إم(
        (*الحالة).السياق, القيد.الدالة, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم_الكتلة)
    );
    ضع_الباني_بنهاية_كتلة_إل_إل_في_إم((*الحالة).الباني, الكتلة);
    دع بلا_أنواع: متغير متجه مرجع_نوع_إل_إل_في_إم = [];
    ألحق(بلا_أنواع, نوع_فراغ_إل_إل_في_إم((*الحالة).السياق));
    دع التوقيع: مرجع_نوع_إل_إل_في_إم = نوع_دالة_إل_إل_في_إم(
        نوع_فراغ_إل_إل_في_إم((*الحالة).السياق), &متغير بلا_أنواع[0], 0
    );
    دع رمز_التجميع: متغير متجه ط8 = انسخ_بايتات_إل_إل_في_إم(النص);
    دع رمز_القيود: متغير متجه ط8 = بايتات_منتهية_بصفر_من_نص(«~{memory}»);
    دع التجميع: مرجع_قيمة_إل_إل_في_إم = LLVMGetInlineAsm(
        التوقيع, مؤشر_اسم_سي_لإل_إل_في_إم(&متغير رمز_التجميع), (الطول(رمز_التجميع) - 1) مثل طبيعي,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير رمز_القيود), (الطول(رمز_القيود) - 1) مثل طبيعي, 1, 0, 0, 0
    );
    دع بلا_حجج: متغير متجه مرجع_قيمة_إل_إل_في_إم = [];
    ألحق(بلا_حجج, التجميع);
    دع اسم: متغير متجه ط8 = اسم_فارغ_إل_إل_في_إم();
    ابن_نداء_إل_إل_في_إم((*الحالة).الباني, التوقيع, التجميع, &متغير بلا_حجج[0], 0,
        مؤشر_اسم_سي_لإل_إل_في_إم(&متغير اسم));
    ابن_غير_قابل_للوصول_إل_إل_في_إم((*الحالة).الباني);
    أرجع اختياري.لا_شيء();
}
