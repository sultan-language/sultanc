// تركيب المزود الأصلي يستهلك قدرة Target المحلولة ثم يفوض منطق الاختيار إلى مالك ISA.
// يحتفظ المزود بخطأ ISA كاملا؛ لا يعيد تصنيفه إلى فشل مرحلة عام.
عام نوع فشل_شفرة_منتقاة_أصلية =
    | اختيار_ذراع_أربعة_وستون بنوع فشل_اختيار_ذراع_أربعة_وستون
    | اختيار_إكس_ستة_وثمانون_أربعة_وستون بنوع فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون
    | قدرة_منتق_أصلي_غير_متاحة بنوع معرف_هدف
;

// حد اختيار دالة واحدة للمسار المتدرج: Target يختار ISA، ومالك ISA يختار الدالة.
// لا يحتفظ هذا الحد بمتجه شفرة آلة لكل دوال البرنامج.
عام نوع نتيجة_دالة_منتقاة_أصلية =
    | ذراع_أربعة_وستون بنوع دالة_ذراع_أربعة_وستون_منتقاة
    | إكس_ستة_وثمانون_أربعة_وستون بنوع دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة
    | بدائي_مسير_غير_مخفض بنوع هوية_بدائي_مترجم
    | خطأ بنوع فشل_شفرة_منتقاة_أصلية
;

عام عرف هيئ_دالة_منتقاة_بالمزود_الأصلي(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    المعرف: معرف_دالة_مسير
): نتيجة_دالة_منتقاة_أصلية {
    طابق حل_قدرة_منتق_أصلي(الهدف) مع
    | قدرة_منتق_أصلي.ذراع_أربعة_وستون -> {
        طابق انتق_دالة_ذراع_أربعة_وستون(
            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف
        ) مع
        | نتيجة.نجح(الدالة) -> {
            أرجع نتيجة_دالة_منتقاة_أصلية.ذراع_أربعة_وستون(الدالة);
        }
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ.السبب مع
            | خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> {
                أرجع نتيجة_دالة_منتقاة_أصلية.بدائي_مسير_غير_مخفض(البدائي);
            }
            | _ -> {
                دع الفشل: فشل_شفرة_منتقاة_أصلية =
                    فشل_شفرة_منتقاة_أصلية.اختيار_ذراع_أربعة_وستون(الخطأ);
                أرجع نتيجة_دالة_منتقاة_أصلية.خطأ(الفشل);
            };
        };
    }
    | قدرة_منتق_أصلي.إكس_ستة_وثمانون_أربعة_وستون -> {
        طابق انتق_دالة_إكس(
            المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, المعرف
        ) مع
        | نتيجة.نجح(الدالة) -> {
            أرجع نتيجة_دالة_منتقاة_أصلية.إكس_ستة_وثمانون_أربعة_وستون(الدالة);
        }
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ.السبب مع
            | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> {
                أرجع نتيجة_دالة_منتقاة_أصلية.بدائي_مسير_غير_مخفض(البدائي);
            }
            | _ -> {
                دع الفشل: فشل_شفرة_منتقاة_أصلية =
                    فشل_شفرة_منتقاة_أصلية.اختيار_إكس_ستة_وثمانون_أربعة_وستون(الخطأ);
                أرجع نتيجة_دالة_منتقاة_أصلية.خطأ(الفشل);
            };
        };
    }
    | قدرة_منتق_أصلي.غير_متاحة -> {
        دع و: واصف_هدف = *الهدف;
        دع الفشل: فشل_شفرة_منتقاة_أصلية =
            فشل_شفرة_منتقاة_أصلية.قدرة_منتق_أصلي_غير_متاحة(و.المعرف);
        أرجع نتيجة_دالة_منتقاة_أصلية.خطأ(الفشل);
    };
}
