    طابق الحالة.الدالة مع
    | اختياري.موجود(الدالة) -> { أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | اختياري.لا_شيء -> { };
    طابق الحالة.الكتلة مع
    | اختياري.موجود(الكتلة) -> { أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | اختياري.لا_شيء -> { };
    طابق الحالة.فهرس_التعليمة مع
    | اختياري.موجود(الفهرس) -> { أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.التعليمة(), الفهرس); }
    | اختياري.لا_شيء -> { };
    طابق الحالة.العملية مع
    | اختياري.موجود(العملية) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.العملية(), نص_عملية_إكس_أصلية(العملية)); }
    | اختياري.لا_شيء -> { };
}

عرف أضف_سبب_تخطيط_ذراع(
    التشخيص: &متغير تشخيص,
    السبب: سبب_فشل_تخطيط_اختيار_ذراع
): فراغ {
    طابق السبب مع
    | سبب_فشل_تخطيط_اختيار_ذراع.استعلام_قيمة(الفشل) -> { أضف_فشل_استعلام_تخطيط_قيمة(التشخيص, الفشل); }
    | سبب_فشل_تخطيط_اختيار_ذراع.بنية_تخطيط_غير_متوافقة(القيمة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخطيط_غير_متوافق_هيكل());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
    }
    | سبب_فشل_تخطيط_اختيار_ذراع.جزء_تخطيط_مفقود(القيمة, الفهرس) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخطيط_مفقود_جزء());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | سبب_فشل_تخطيط_اختيار_ذراع.عرض_قيمة_غير_مدعوم(القيمة, العرض) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخطيط_غير_مدعوم_قيمة_عرض());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), العرض);
    }
    | سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مؤجلة(القيمة, سبب_التأجيل) -> {
        أضف_سبب_فشل_أصلي(التشخيص, نص_سبب_تأجيل_تخطيط_أصلي(سبب_التأجيل));
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
    }
    | سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مرفوضة(القيمة, الخطأ) -> {
        أضف_سبب_فشل_أصلي(التشخيص, نص_خطأ_تخطيط_أصلي(الخطأ));
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
    }
    | سبب_فشل_تخطيط_اختيار_ذراع.حمولة_منشئ_مفقودة(القيمة, الفهرس) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخطيط_مفقود_منشئ_حمولة());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    };
}

