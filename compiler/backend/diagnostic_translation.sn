عرف أضف_سبب_اختيار_ذراع(
    التشخيص: &متغير تشخيص,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
): فراغ {
    طابق السبب مع
    | خطأ_اختيار_ذراع_أربعة_وستون.هدف_ليس_ذراع_أربعة_وستون(الهدف) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_هدف_عدم_تطابق());
        أضف_هدف_فشل_أصلي(التشخيص, الهدف);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(الدالة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_مفقود_مسير_دالة());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.كتلة_مسير_مفقودة(الكتلة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_مفقود_مسير_كتلة());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.قيمة_مسير_مفقودة(القيمة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_مفقود_مسير_قيمة());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_مفقود_تعليمة_نتيجة()); }
    | خطأ_اختيار_ذراع_أربعة_وستون.نوع_قيمة_مفقود(القيمة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_مفقود_قيمة_نوع());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_صحيح_نوع()); }
    | خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_عملية()); }
    | خطأ_اختيار_ذراع_أربعة_وستون.ثابت_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_ثابت()); }
    | خطأ_اختيار_ذراع_أربعة_وستون.حساب_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_حسابي()); }
    | خطأ_اختيار_ذراع_أربعة_وستون.منهي_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_منه()); }
    | خطأ_اختيار_ذراع_أربعة_وستون.حافة_غير_صالحة(الكتلة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_صحيح_حافة());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_دالة_واجهة_الاستدعاء_غير_متاح()); }
    | خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ) -> { أضف_خطأ_حل_واجهة_اختيار_أصلي(التشخيص, الخطأ); }
    | خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_لم_يخفض_بدائي()); أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)); }
    | خطأ_اختيار_ذراع_أربعة_وستون.ثابت_نص_يحتاج_مقطع_بيانات -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_نص_ثابت_يحتاج_بيانات_قسم()); }
    | خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_التخطيط) -> { أضف_سبب_تخطيط_ذراع(التشخيص, سبب_التخطيط); };
}

عرف أضف_سبب_اختيار_إكس(
    التشخيص: &متغير تشخيص,
    السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    طابق السبب مع
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.هدف_ليس_إكس_ستة_وثمانون_أربعة_وستون(الهدف) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_هدف_عدم_تطابق()); أضف_هدف_فشل_أصلي(التشخيص, الهدف); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.دالة_مسير_مفقودة(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_مفقود_مسير_دالة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.كتلة_مسير_مفقودة(الكتلة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_مفقود_مسير_كتلة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ناتج_تعليمة_مفقود -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_مفقود_تعليمة_نتيجة()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_نوع()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.ثابت_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_ثابت()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_تحويل()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.حساب_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_حسابي()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_مقارنة()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_ليست_شرط_المنهي -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_مقارنة_ليس_منه_شرط()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_عملية()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.منهي_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_منه()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.معاملات_كتلة_غير_مدعومة(الكتلة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_كتلة_معاملات()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_دالة_واجهة_الاستدعاء_غير_متاح()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ) -> { أضف_خطأ_حل_واجهة_اختيار_أصلي(التشخيص, الخطأ); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_غير_مدعوم_استدعاء()); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_لم_يخفض_بدائي()); أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(سبب_التخطيط) -> { أضف_سبب_تخطيط_إكس(التشخيص, سبب_التخطيط); };
}

عرف أضف_فشل_اختيار_أصلي(
    التشخيص: &متغير تشخيص,
    الفشل: فشل_شفرة_منتقاة_أصلية
): فراغ {
    طابق الفشل مع
    | فشل_شفرة_منتقاة_أصلية.اختيار_ذراع_أربعة_وستون(فشل_ذراع) -> {
        أضف_سياق_اختيار_ذراع(التشخيص, &فشل_ذراع);
        أضف_سبب_اختيار_ذراع(التشخيص, فشل_ذراع.السبب);
    }
    | فشل_شفرة_منتقاة_أصلية.اختيار_إكس_ستة_وثمانون_أربعة_وستون(فشل_إكس) -> {
        أضف_سياق_اختيار_إكس(التشخيص, &فشل_إكس);
        أضف_سبب_اختيار_إكس(التشخيص, فشل_إكس.السبب);
    }
    | فشل_شفرة_منتقاة_أصلية.قدرة_منتق_أصلي_غير_متاحة(الهدف) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_أصلي_منتقي_قدرة_غير_متاح());
        أضف_هدف_فشل_أصلي(التشخيص, الهدف);
    };
}

عرف أضف_فشل_تخصيص_ذراع(
    التشخيص: &متغير تشخيص,
    الفشل: فشل_تخصيص_ذراع_أربعة_وستون
): فراغ {
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «arm64»);
    طابق الفشل مع
    | فشل_تخصيص_ذراع_أربعة_وستون.يحتاج_انسكاب(السبب) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخصيص_يحتاج_سكب()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السبب.السجل.القيمة); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), السبب.عند_الموضع); }
    | فشل_تخصيص_ذراع_أربعة_وستون.فشل_قيود(السجل) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخصيص_قيد_إخفاق()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | فشل_تخصيص_ذراع_أربعة_وستون.حالة_انسكاب_غير_مدعومة(السجل) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخصيص_غير_مدعوم_سكب_حالة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | فشل_تخصيص_ذراع_أربعة_وستون.سياسة_إطار_غير_متاحة(الهدف) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخصيص_إطار_سياسة_غير_متاح()); أضف_هدف_فشل_أصلي(التشخيص, الهدف); }
    | فشل_تخصيص_ذراع_أربعة_وستون.هدف_غير_صالح(الهدف) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخصيص_غير_صحيح_هدف()); أضف_هدف_فشل_أصلي(التشخيص, الهدف); };
}

