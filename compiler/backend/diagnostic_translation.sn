عرف أضف_فشل_دخول_أصلي(
    التشخيص: &متغير تشخيص,
    الفشل: فشل_حل_دخول_أصلي
): فراغ {
    طابق الفشل مع
    | فشل_حل_دخول_أصلي.دالة_مسير_مفقودة(الدالة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_دخول_مفقود_مسير_دالة());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | فشل_حل_دخول_أصلي.واجهة_دخول_غير_متاحة(الدالة, الخطأ) -> {
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
        أضف_خطأ_حل_واجهة_اختيار_أصلي(التشخيص, الخطأ);
    }
    | فشل_حل_دخول_أصلي.هدف_دخول_غير_متاح(الهدف) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_دخول_هدف_قدرة_غير_متاح());
        أضف_هدف_فشل_أصلي(التشخيص, الهدف);
    }
    | فشل_حل_دخول_أصلي.مهايئ_دخول_مطلوب(الدالة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_دخول_موائم_مطلوب());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    };
}

عرف أضف_خطأ_ماتشو_أصلي(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_ماتشو
): فراغ {
    طابق الخطأ مع
    | خطأ_ماتشو.هدف_غير_متوافق(الهدف) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_هدف_عدم_تطابق()); أضف_هدف_فشل_أصلي(التشخيص, الهدف); }
    | خطأ_ماتشو.دالة_مكررة(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_مكرر_دالة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.رمز_مكرر -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_مكرر_رمز()); }
    | خطأ_ماتشو.كلمة_تعليمة_خارج_نطاق_ط32(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_تعليمة_كلمة_خارج_من_نطاق()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.تثبيت_غير_صالح(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_غير_صحيح_تصحيح_ارتباط()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.إضافة_تثبيت_غير_مدعومة(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_غير_مدعوم_تصحيح_ارتباط_مضاف()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.طلب_إزاحة_غير_صالح(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_غير_صحيح_إعادة_توطين_طلب()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.نوع_إزاحة_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_غير_مدعوم_إعادة_توطين_صنف()); }
    | خطأ_ماتشو.رمز_تشغيل_غير_متاح -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_وقت_تشغيل_رمز_غير_متاح()); }
    | خطأ_ماتشو.بيانات_ثابتة_مكررة(القيمة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_مكرر_ثابت_بيانات()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة); }
    | خطأ_ماتشو.حدود_صيغة_متجاوزة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_صيغة_حد_متجاوز()); }
    | خطأ_ماتشو.قسم_نص_مفقود -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_مفقود_نص_قسم()); }
    | خطأ_ماتشو.رمز_إزاحة_مفقود -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_مفقود_إعادة_توطين_رمز()); }
    | خطأ_ماتشو.رمز_دخول_مفقود(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_ماك_أو_مفقود_دخول_رمز()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); };
}

