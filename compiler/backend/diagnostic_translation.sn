عرف أضف_فشل_اختيار_ويب_أسمبلي(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_اختيار_ويب_أسمبلي
): فراغ {
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «wasm32»);
    طابق الخطأ مع
    | خطأ_اختيار_ويب_أسمبلي.دالة_مفقودة(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_مفقود_دالة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_اختيار_ويب_أسمبلي.كتلة_مفقودة(الكتلة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_مفقود_كتلة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الكتلة.الدالة.القيمة); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), الكتلة.القيمة); }
    | خطأ_اختيار_ويب_أسمبلي.قيمة_مفقودة(القيمة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_مفقود_قيمة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), القيمة.الدالة.القيمة); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة); }
    | خطأ_اختيار_ويب_أسمبلي.نوع_غير_مدعوم(النوع) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_غير_مدعوم_نوع()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), النوع.القيمة); }
    | خطأ_اختيار_ويب_أسمبلي.تخطيط_غير_مكتمل(النوع) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_ناقص_تخطيط()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), النوع.القيمة); }
    | خطأ_اختيار_ويب_أسمبلي.واجهة_غير_متاحة(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_واجهة_الاستدعاء_غير_متاح()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_اختيار_ويب_أسمبلي.بدائي_غير_مخفض(البدائي) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_لم_يخفض_بدائي()); أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)); }
    | خطأ_اختيار_ويب_أسمبلي.عملية_غير_مدعومة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_غير_مدعوم_عملية()); }
    | خطأ_اختيار_ويب_أسمبلي.تدفق_غير_قابل_للاختزال(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_غير_قابل_للاختزال_تحكم_تدفق()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_اختيار_ويب_أسمبلي.مزود_ذاكرة_مفقود -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_مفقود_تخصيص_موفر()); }
    | خطأ_اختيار_ويب_أسمبلي.مزود_خروج_مفقود -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_مفقود_خروج_موفر()); }
    | خطأ_اختيار_ويب_أسمبلي.حافة_غير_صالحة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_انتقاء_واسم32_غير_صحيح_حافة()); };
}

عرف أضف_فشل_كائن_ويب_أسمبلي(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_كائن_ويب_أسمبلي
): فراغ {
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «wasm32/wasm»);
    طابق الخطأ مع
    | خطأ_كائن_ويب_أسمبلي.رمز_غير_محلول(_) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_واسم_مفقود_إعادة_توطين_رمز()); }
    | خطأ_كائن_ويب_أسمبلي.إضافة_غير_صالحة(_) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_واسم_غير_مدعوم_إعادة_توطين_مضاف()); }
    | خطأ_كائن_ويب_أسمبلي.إزاحة_بيانات_غير_صالحة(العام) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_واسم_غير_صحيح_بيانات_إعادة_توطين()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), العام.القيمة); }
    | خطأ_كائن_ويب_أسمبلي.توقيع_غير_صالح(التوقيع) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_واسم_غير_صحيح_نوع_فهرس()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), التوقيع); }
    | خطأ_كائن_ويب_أسمبلي.إزاحة_تصحيح_غير_ممثلة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_واسم_إزاحة_تنقيح_غير_قابلة_للتمثيل()); }
    | خطأ_كائن_ويب_أسمبلي.عنوان_موضعي_غير_ممثل -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_واسم_عنوان_مستقل_غير_قابل_للتمثيل()); };
}

عام عرف حول_فشل_مخرج_أصلي_إلى_تشخيصات(
    الفشل: &فشل_مخرج_أصلي
): مجموعة_تشخيصات {
    دع الحالة: فشل_مخرج_أصلي = *الفشل;
    دع التشخيص: متغير تشخيص;
    طابق الحالة مع
    | فشل_مخرج_أصلي.قدرة_مخرج_غير_متاحة(الهدف) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-output»);
        أضف_سبب_فشل_أصلي(&متغير التشخيص, سبب_تشخيص.سبب_أصلي_إخراج_قدرة_غير_متاح());
        أضف_هدف_فشل_أصلي(&متغير التشخيص, الهدف);
    }
    | فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-selection»);
        أضف_سبب_فشل_أصلي(&متغير التشخيص, سبب_تشخيص.سبب_انتقاء_لم_يخفض_بدائي());
        أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي));
    }
    | فشل_مخرج_أصلي.دخول_تنفيذي(فشل_الدخول) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-entry»);
        أضف_فشل_دخول_أصلي(&متغير التشخيص, فشل_الدخول);
    }
    | فشل_مخرج_أصلي.اختيار(فشل_الاختيار) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-selection»);
        أضف_فشل_اختيار_أصلي(&متغير التشخيص, فشل_الاختيار);
    }
    | فشل_مخرج_أصلي.اختيار_غير_متطابق(الهدف) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-selection»);
        أضف_سبب_فشل_أصلي(&متغير التشخيص, سبب_تشخيص.سبب_انتقاء_هدف_نتيجة_عدم_تطابق());
        أضف_هدف_فشل_أصلي(&متغير التشخيص, الهدف);
    }
    | فشل_مخرج_أصلي.تخصيص_ذراع(فشل_التخصيص) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-allocation»);
        أضف_فشل_تخصيص_ذراع(&متغير التشخيص, فشل_التخصيص);
    }
    | فشل_مخرج_أصلي.ترميز_ذراع(الخطأ) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-encoding»);
        أضف_سبب_ترميز_ذراع(&متغير التشخيص, الخطأ);
    }
    | فشل_مخرج_أصلي.كائن_ذراع(فشل_الكائن) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-object»);
        أضف_فشل_كائن_ذراع(&متغير التشخيص, فشل_الكائن);
    }
    | فشل_مخرج_أصلي.تخصيص_إكس(فشل_التخصيص) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-allocation»);
        أضف_فشل_تخصيص_إكس(&متغير التشخيص, فشل_التخصيص);
    }
    | فشل_مخرج_أصلي.ترميز_إكس(الخطأ) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-encoding»);
        أضف_سبب_ترميز_إكس(&متغير التشخيص, الخطأ);
    }
    | فشل_مخرج_أصلي.كائن_إكس(فشل_الكائن) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-object»);
        أضف_فشل_كائن_إكس(&متغير التشخيص, فشل_الكائن);
    }
    | فشل_مخرج_أصلي.اختيار_ويب_أسمبلي(الخطأ) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-selection»);
        أضف_فشل_اختيار_ويب_أسمبلي(&متغير التشخيص, الخطأ);
    }
    | فشل_مخرج_أصلي.كائن_ويب_أسمبلي(الخطأ) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-object»);
        أضف_فشل_كائن_ويب_أسمبلي(&متغير التشخيص, الخطأ);
    }
    | فشل_مخرج_أصلي.تخطيط_عام_غير_مكتمل(العام) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-global»);
        أضف_سبب_فشل_أصلي(&متغير التشخيص, سبب_تشخيص.سبب_عام_ناقص_تخطيط());
        أضف_عدد_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), العام.القيمة);
    }
    | فشل_مخرج_أصلي.تهيئة_عام_غير_مدعومة(العام) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-global»);
        أضف_سبب_فشل_أصلي(&متغير التشخيص, سبب_تشخيص.سبب_عام_غير_مدعوم_مهيئ());
        أضف_عدد_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), العام.القيمة);
    };

    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}


// The first line of an LLVM message (verifier, pass pipeline, emitter) as
// the diagnostic's value fact; nothing is added for an empty message.
عرف أضف_سطر_تفصيل_إل_إل_في_إم(التشخيص: &متغير تشخيص, التفصيل: &متجه ط8): منطقي {
    دع السطر: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التفصيل) مثل طبيعي) && ف < 400) {
        دع البايت: ط8 = (*التفصيل)[ف];
        لو (البايت == (10 مثل ط8) || البايت == (0 مثل ط8)) { ف := الطول(*التفصيل) مثل طبيعي; }
        وإلا { ألحق(السطر, البايت); ف := ف + 1; };
    }
    لو ((الطول(السطر) مثل طبيعي) == 0) { أرجع خطأ; };
    أرجع أضف_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.القيمة(), من_بايتات(&السطر));
}

// LLVM failures cross into the same structured Diagnostics model as native
// backend failures. The provider never prints and never owns user rendering.
عام عرف حول_فشل_مزود_إل_إل_في_إم_إلى_تشخيصات(
    الفشل: &فشل_مزود_إل_إل_في_إم
): مجموعة_تشخيصات {
    // A backend absent from this compiler (the LLVM provider of a compiler
    // built without LLVM, compiler/backend/provider/llvm/unavailable.sn) or a
    // target the linked libLLVM lacks is an environmental limit, not an
    // internal error. Previously it was reported as SULTANC-ICE-CONTEXT.
    دع معرف_التشخيص: متغير معرف_تشخيص = معرف_تشخيص.خطأ_سياق_داخلي();
    طابق *الفشل مع
    | فشل_مزود_إل_إل_في_إم.خلفية_هدف_غير_متاحة(_) -> {
        معرف_التشخيص := معرف_تشخيص.خلفية_مترجم_غير_متاحة();
    }
    | _ -> { };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_التشخيص, اختياري.لا_شيء()
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «llvm-backend»
    );
    طابق *الفشل مع
    | فشل_مزود_إل_إل_في_إم.هدف_غير_مدعوم -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_غير_مدعوم_هدف());
    }
    | فشل_مزود_إل_إل_في_إم.خلفية_هدف_غير_متاحة(التفصيل) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_هدف_خلفية_غير_متاح());
        // LLVM's own reason (no TargetMachine, no object writer, ...).
        لو (الطول(التفصيل) > 0) {
            دع ب: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), من_بايتات(&التفصيل)
            );
        };
    }
    | فشل_مزود_إل_إل_في_إم.عدم_تطابق_حجم_المؤشر(المتوقع, الفعلي) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_مؤشر_حجم_عدم_تطابق());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع);
        دع ج: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الفعلي);
    }
    | فشل_مزود_إل_إل_في_إم.نوع_مفقود(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_مفقود_نوع());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.نوع_غير_مدعوم(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_غير_مدعوم_نوع());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.تخطيط_مؤجل(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_مؤجل_تخطيط());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.تخطيط_مرفوض(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_مرفوض_تخطيط());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.دالة_مفقودة(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_مفقود_دالة());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.دالة_خارجية_مفقودة(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_مفقود_خارجي_دالة());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.كتلة_مفقودة(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_مفقود_كتلة());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.قيمة_مفقودة(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_مفقود_قيمة());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.مكان_متوقع(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_متوقع_موضع());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.قيمة_متوقعة(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_متوقع_قيمة());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.عام_مفقود(المعرف) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_مفقود_عام());
        دع ب: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), المعرف.القيمة);
    }
    | فشل_مزود_إل_إل_في_إم.واجهة_ثنائية_غير_متاحة -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_واجهة_الاستدعاء_غير_متاح());
    }
    | فشل_مزود_إل_إل_في_إم.بدائي_غير_مدعوم -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_غير_مدعوم_بدائي());
    }
    | فشل_مزود_إل_إل_في_إم.عملية_مسير_غير_مدعومة -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_غير_مدعوم_مسير_عملية());
    }
    | فشل_مزود_إل_إل_في_إم.حافة_مسير_غير_صالحة -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_غير_صحيح_مسير_حافة());
    }
    | فشل_مزود_إل_إل_في_إم.تحقق_إل_إل_في_إم_فشل(التفصيل) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_تحقق_فشل());
        // LLVM's own message, first line only.
        دع ب: منطقي = أضف_سطر_تفصيل_إل_إل_في_إم(&متغير التشخيص, &التفصيل);
    }
    | فشل_مزود_إل_إل_في_إم.تحسين_إل_إل_في_إم_فشل(التفصيل) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_تحسين_فشل());
        // LLVM's own message, first line only.
        دع ب: منطقي = أضف_سطر_تفصيل_إل_إل_في_إم(&متغير التشخيص, &التفصيل);
    }
    | فشل_مزود_إل_إل_في_إم.إصدار_مخرج_إل_إل_في_إم_فشل(التفصيل) -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_إصدار_فشل());
        // LLVM's own message, first line only.
        دع ب: منطقي = أضف_سطر_تفصيل_إل_إل_في_إم(&متغير التشخيص, &التفصيل);
    }
    | فشل_مزود_إل_إل_في_إم.مخرج_كائن_غير_مدعوم -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_كائن_إخراج_غير_مدعوم());
    }
    | فشل_مزود_إل_إل_في_إم.تصحيح_إل_إل_في_إم_فشل -> {
        دع أ: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إل_إل_في_إم_تصحيح_معلومات_فشل());
    };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// A backend provider that the running compiler was built without
// (llvm_codegen.sn مزود_إل_إل_في_إم_مضمن): the explicit request is refused
// before any source is loaded, as an unavailable backend, never by falling
// back to another provider.
عام عرف تشخيصات_مزود_خلفية_غير_مضمن(
    الهدف: معرف_هدف,
    المزود: هوية_مزود_خلفية
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خلفية_مترجم_غير_متاحة(), اختياري.لا_شيء()
    );
    دع المرحلة: نص = «backend-select»;
    دع السبب: سبب_تشخيص;
    طابق المزود مع
    | هوية_مزود_خلفية.أصلي -> { السبب := سبب_تشخيص.سبب_خلفية_أصلية_غير_مضمنة(); }
    | هوية_مزود_خلفية.إل_إل_في_إم -> { السبب := سبب_تشخيص.سبب_خلفية_إل_إل_في_إم_غير_مضمنة(); };
    دع أ: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), المرحلة);
    دع ب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    أضف_هدف_فشل_أصلي(&متغير التشخيص, الهدف);
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// A provider the registered target does not admit (Target,
// يدعم_مزود_الخلفية): an unavailable backend for that target, an
// environmental limit of the request. Previously reported as
// SULTANC-ICE-CONTEXT.
عام عرف تشخيصات_مزود_خلفية_غير_متاح(
    الهدف: معرف_هدف,
    المزود: هوية_مزود_خلفية
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خلفية_مترجم_غير_متاحة(), اختياري.لا_شيء()
    );
    دع المرحلة: نص = «backend-select»;
    دع السبب: سبب_تشخيص;
    طابق المزود مع
    | هوية_مزود_خلفية.أصلي -> { السبب := سبب_تشخيص.سبب_أصلي_خلفية_غير_متاح_ل_هدف(); }
    | هوية_مزود_خلفية.إل_إل_في_إم -> {
        السبب := سبب_تشخيص.سبب_إل_إل_في_إم_خلفية_غير_متاح_ل_هدف();
    };
    دع أ: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), المرحلة);
    دع ب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    أضف_هدف_فشل_أصلي(&متغير التشخيص, الهدف);
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}
