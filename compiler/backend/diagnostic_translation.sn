    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.دالة_مكررة(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_مكرر_دالة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.كتلة_مكررة(الكتلة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_مكرر_كتلة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.هدف_كتلة_مفقود(الكتلة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_مفقود_كتلة_هدف()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.فرع_خارج_مدى_نسبي_32(الكتلة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_إزاحة32_تفرع_خارج_من_نطاق()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_مدعوم_واجهة_الاستدعاء_مسجل()); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_مدعوم_ذاكرة_عنوان()); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(العرض) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_مدعوم_ذاكرة_عرض()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), العرض); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_قابل_للترميز_حافة_نقل_ملكية()); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_كاف_عمل_مسجلات()); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.موضع_محلي_مفقود(الموضع) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_مفقود_محلي_خانة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الموضع); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_ذاكرة_غير_متاح -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_ذاكرة_تخصيص_غير_متاح()); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نداء_تشغيل_خارج_المدى -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_وقت_تشغيل_استدعاء_خارج_من_نطاق()); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.مزود_خروج_عملية_مفقود -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_عملية_خروج_موفر_مفقود()); };
