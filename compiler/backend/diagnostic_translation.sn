    | فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.فشل_قيود(السجل) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخصيص_قيد_إخفاق()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.حالة_انسكاب_غير_مدعومة(السجل) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخصيص_غير_مدعوم_سكب_حالة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.سياسة_إطار_غير_متاحة(الهدف) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخصيص_إطار_سياسة_غير_متاح()); أضف_هدف_فشل_أصلي(التشخيص, الهدف); }
    | فشل_تخصيص_إكس_ستة_وثمانون_أربعة_وستون.هدف_غير_صالح(الهدف) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخصيص_غير_صحيح_هدف()); أضف_هدف_فشل_أصلي(التشخيص, الهدف); };
}

عرف أضف_سبب_ترميز_ذراع(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_ترميز_ذراع_أربعة_وستون
): فراغ {
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «arm64»);
    طابق الخطأ مع
    | خطأ_ترميز_ذراع_أربعة_وستون.هدف_غير_صالح(الهدف) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_صحيح_هدف()); أضف_هدف_فشل_أصلي(التشخيص, الهدف); }
    | خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(السجل) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_صحيح_فيزيائي_مسجل()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.سجل_واجهة_غير_متطابق(السجل) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_واجهة_الاستدعاء_مسجل_عدم_تطابق()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.فوري_حساب_خارج_المدى(القيمة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_حسابي_فوري_خارج_من_نطاق()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.إزاحة_ذاكرة_خارج_المدى(الإزاحة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_ذاكرة_إزاحة_خارج_من_نطاق()); أضف_عدد_موقع_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), الإزاحة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(العرض) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_مدعوم_ذاكرة_عرض()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), العرض); }
    | خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(العرض) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_مدعوم_صحيح_عرض()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), العرض); }
    | خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_مدعوم_واجهة_الاستدعاء_موقع()); }
    | خطأ_ترميز_ذراع_أربعة_وستون.موضع_إطار_مفقود(الموضع) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_مفقود_إطار_خانة()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الموضع); }
    | خطأ_ترميز_ذراع_أربعة_وستون.إزاحة_انسكاب_خارج_المدى(الإزاحة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_سكب_إزاحة_خارج_من_نطاق()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), الإزاحة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.هدف_كتلة_مفقود(الكتلة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_مفقود_كتلة_هدف()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.فرع_غير_محاذى(الكتلة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_محاذى_تفرع()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.فرع_خارج_المدى(الكتلة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_تفرع_خارج_من_نطاق()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.نقل_حافة_غير_قابل_للترميز -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_غير_قابل_للترميز_حافة_نقل_ملكية()); }
    | خطأ_ترميز_ذراع_أربعة_وستون.تخصيص_ذاكرة_غير_متاح -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_ترميز_ذاكرة_تخصيص_غير_متاح()); };
}

