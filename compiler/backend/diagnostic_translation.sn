// هذا هو حد التحويل الوحيد من فشل المخرج الأصلي المهيكل إلى نموذج Diagnostics.
// لا يطبع هذا الملف شيئا؛ يحتفظ بالسبب والسياق ثم يترك renderer يملك العرض.
عرف أضف_نص_فشل_أصلي(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: نص
): فراغ {
    دع أضيف: منطقي = أضف_حجة_تشخيص(التشخيص, المفتاح, القيمة);
}

عرف أضف_سبب_فشل_أصلي(التشخيص: &متغير تشخيص, السبب: سبب_تشخيص): فراغ {
    دع أضيف: منطقي = أضف_سبب_تشخيص(التشخيص, السبب);
}

عرف أضف_عدد_فشل_أصلي(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: طبيعي
): فراغ {
    دع أضيف: منطقي = أضف_حجة_طبيعية(التشخيص, المفتاح, القيمة);
}

// A target fact names the registered spelling, not the registry index.
عرف أضف_هدف_فشل_أصلي(التشخيص: &متغير تشخيص, الهدف: معرف_هدف): فراغ {
    طابق تهجئة_معرف_هدف(الهدف) مع
    | اختياري.موجود(التهجئة) -> {
        دع أضيف: منطقي = أضف_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.الهدف(), التهجئة);
    }
    | اختياري.لا_شيء -> { أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); };
}

عرف أضف_عدد_موقع_فشل_أصلي(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: عدد
): فراغ {
    دع أضيف: منطقي = أضف_حجة_موقعة(التشخيص, المفتاح, القيمة);
}

عرف ابدأ_تشخيص_فشل_أصلي(المرحلة: نص): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_سياق_داخلي(),
        اختياري.لا_شيء()
    );
    دع أضيف_المرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), المرحلة
    );
    أرجع التشخيص;
}

عرف ابدأ_تشخيص_فشل_أصلي_بسبب(المرحلة: نص, السبب: سبب_تشخيص): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيص_فشل_أصلي(المرحلة);
    دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب
    );
    أرجع التشخيص;
}

عرف ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
    المرحلة: نص,
    السياق: نص,
    السبب: سبب_تشخيص
): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيص_فشل_أصلي_بسبب(المرحلة, السبب);
    دع أضيف_السياق: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السياق(), السياق
    );
    أرجع التشخيص;
}

عرف ابدأ_تشخيص_فشل_أصلي_بسبب_وهدف(
    المرحلة: نص,
    السبب: سبب_تشخيص,
    الهدف: طبيعي
): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيص_فشل_أصلي_بسبب(المرحلة, السبب);
    دع أضيف_الهدف: منطقي = أضف_حجة_طبيعية(
        &متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف
    );
    أرجع التشخيص;
}

عرف نص_سبب_تأجيل_تخطيط_أصلي(السبب: سبب_تأجيل_تخطيط): سبب_تشخيص {
    طابق السبب مع
    | سبب_تأجيل_تخطيط.نوع_ديناميكي -> { أرجع سبب_تشخيص.سبب_تخطيط_مؤجل_ديناميكي_نوع(); }
    | سبب_تأجيل_تخطيط.نص_مدار_وقت_التشغيل -> { أرجع سبب_تشخيص.سبب_تخطيط_مؤجل_وقت_تشغيل_مدار_نص(); }
    | سبب_تأجيل_تخطيط.شريحة_غير_مجمدة -> { أرجع سبب_تشخيص.سبب_تخطيط_مؤجل_غير_مثبت_شريحة(); }
    | سبب_تأجيل_تخطيط.متجه_غير_مجمد -> { أرجع سبب_تشخيص.سبب_تخطيط_مؤجل_غير_مثبت_متجه(); }
    | سبب_تأجيل_تخطيط.دالة_غير_مجمدة -> { أرجع سبب_تشخيص.سبب_تخطيط_مؤجل_غير_مثبت_دالة(); }
    | سبب_تأجيل_تخطيط.بلا_تمثيل_قيمة -> { أرجع سبب_تشخيص.سبب_تخطيط_مؤجل_بلا_قيمة_تمثيل(); };
}

عرف نص_خطأ_تخطيط_أصلي(الخطأ: خطأ_تخطيط): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_تخطيط.معرف_نوع_غير_صالح -> { أرجع سبب_تشخيص.سبب_تخطيط_مرفوض_غير_صحيح_نوع_معرف(); }
    | خطأ_تخطيط.نموذج_بيانات_هدف_غير_صالح -> { أرجع سبب_تشخيص.سبب_تخطيط_مرفوض_غير_صحيح_هدف_بيانات_نموذج(); }
    | خطأ_تخطيط.دورة_مادية_مباشرة -> { أرجع سبب_تشخيص.سبب_تخطيط_مرفوض_مباشر_فيزيائي_دورة(); }
    | خطأ_تخطيط.بنية_نوع_ناقصة -> { أرجع سبب_تشخيص.سبب_تخطيط_مرفوض_ناقص_نوع_هيكل(); };
}

عرف أضف_خطأ_واجهة_هدف_أصلي(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_حل_واجهة_هدف
): فراغ {
    طابق الخطأ مع
    | خطأ_حل_واجهة_هدف.واجهة_ثنائية_غير_متاحة(الهدف) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_واجهة_الاستدعاء_هدف_قدرة_غير_متاح());
        أضف_هدف_فشل_أصلي(التشخيص, الهدف);
    }
    | خطأ_حل_واجهة_هدف.خطأ_واجهة_ثنائية(خطأ_الواجهة) -> {
        طابق خطأ_الواجهة مع
        | خطأ_واجهة.معرف_نوع_غير_صالح(النوع) -> {
            أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_واجهة_الاستدعاء_غير_صحيح_نوع_معرف());
            أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة);
        }
        | خطأ_واجهة.تخطيط_نوع_مؤجل(النوع, السبب) -> {
            أضف_سبب_فشل_أصلي(التشخيص, نص_سبب_تأجيل_تخطيط_أصلي(السبب));
            أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة);
        }
        | خطأ_واجهة.تخطيط_نوع_مرفوض(النوع, سبب_الرفض) -> {
            أضف_سبب_فشل_أصلي(التشخيص, نص_خطأ_تخطيط_أصلي(سبب_الرفض));
            أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة);
        }
        | خطأ_واجهة.نوع_غير_مدعوم(النوع) -> {
            أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_واجهة_الاستدعاء_غير_مدعوم_نوع());
            أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة);
        }
        | خطأ_واجهة.حجم_نوع_غير_مدعوم(النوع, الحجم) -> {
            أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_واجهة_الاستدعاء_غير_مدعوم_نوع_حجم());
            أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة);
            أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), الحجم);
        };
    };
}

عرف أضف_خطأ_حل_واجهة_اختيار_أصلي(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_حل_واجهة_اختيار
): فراغ {
    طابق الخطأ مع
    | خطأ_حل_واجهة_اختيار.فشل_واجهة_هدف(خطأ_الهدف) -> {
        أضف_خطأ_واجهة_هدف_أصلي(التشخيص, خطأ_الهدف);
    }
    | خطأ_حل_واجهة_اختيار.معامل_دالة_مفقود(الدالة, الفهرس) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_واجهة_الاستدعاء_مفقود_مسير_معامل());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_حل_واجهة_اختيار.نوع_قيمة_مفقود(القيمة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_واجهة_الاستدعاء_مفقود_مسير_قيمة_نوع());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), القيمة.الدالة.القيمة);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
    };
}

عرف أضف_فشل_استعلام_تخطيط_قيمة(
    التشخيص: &متغير تشخيص,
    الفشل: فشل_تخطيط_قيمة_للاختيار
): فراغ {
    طابق الفشل مع
    | فشل_تخطيط_قيمة_للاختيار.نوع_قيمة_مفقود(القيمة) -> {
        أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_تخطيط_قيمة_نوع_مفقود());
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
    }
    | فشل_تخطيط_قيمة_للاختيار.مؤجل(القيمة, النوع, السبب) -> {
        أضف_سبب_فشل_أصلي(التشخيص, نص_سبب_تأجيل_تخطيط_أصلي(السبب));
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة);
    }
    | فشل_تخطيط_قيمة_للاختيار.مرفوض(القيمة, النوع, الخطأ) -> {
        أضف_سبب_فشل_أصلي(التشخيص, نص_خطأ_تخطيط_أصلي(الخطأ));
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة);
    };
}

عرف نص_عملية_ذراع_أصلية(العملية: فئة_عملية_اختيار_ذراع): نص {
    طابق العملية مع
    | فئة_عملية_اختيار_ذراع.ثابت -> { أرجع «constant»; }
    | فئة_عملية_اختيار_ذراع.حساب_صحيح -> { أرجع «integer-arithmetic»; }
    | فئة_عملية_اختيار_ذراع.حساب_عشري -> { أرجع «float-arithmetic»; }
    | فئة_عملية_اختيار_ذراع.مقارنة_عشري -> { أرجع «float-compare»; }
    | فئة_عملية_اختيار_ذراع.مقارنة_صحيح -> { أرجع «integer-compare»; }
    | فئة_عملية_اختيار_ذراع.تحويل_صحيح -> { أرجع «integer-convert»; }
    | فئة_عملية_اختيار_ذراع.تحويل_عائم -> { أرجع «float-convert»; }
    | فئة_عملية_اختيار_ذراع.نقل_تسلسل_مملوك -> { أرجع «owned-byte-vector-to-text»; }
    | فئة_عملية_اختيار_ذراع.مرجع_إلى_مؤشر -> { أرجع «reference-to-pointer»; }
    | فئة_عملية_اختيار_ذراع.تجميع -> { أرجع «aggregate»; }
    | فئة_عملية_اختيار_ذراع.تهيئة_متجه -> { أرجع «vector-init»; }
    | فئة_عملية_اختيار_ذراع.استخراج_حقل -> { أرجع «extract-field»; }
    | فئة_عملية_اختيار_ذراع.استخراج_فهرس -> { أرجع «extract-index»; }
    | فئة_عملية_اختيار_ذراع.مكان_محلي -> { أرجع «local-place»; }
    | فئة_عملية_اختيار_ذراع.مكان_عام -> { أرجع «global-place»; }
    | فئة_عملية_اختيار_ذراع.مرجع_إلى_مكان -> { أرجع «reference-to-place»; }
    | فئة_عملية_اختيار_ذراع.صندوق_إلى_مكان -> { أرجع «box-to-place»; }
    | فئة_عملية_اختيار_ذراع.مكان_حقل -> { أرجع «field-place»; }
    | فئة_عملية_اختيار_ذراع.مكان_فهرس -> { أرجع «index-place»; }
    | فئة_عملية_اختيار_ذراع.موضع_تخزين_عنصر_مؤشر -> { أرجع «pointer-element-place»; }
    | فئة_عملية_اختيار_ذراع.تحميل -> { أرجع «load»; }
    | فئة_عملية_اختيار_ذراع.تخزين -> { أرجع «store»; }
    | فئة_عملية_اختيار_ذراع.مكان_إلى_مرجع -> { أرجع «place-to-reference»; }
    | فئة_عملية_اختيار_ذراع.بناء_موسوم -> { أرجع «tagged-build»; }
    | فئة_عملية_اختيار_ذراع.استعلام_وسم -> { أرجع «tag-query»; }
    | فئة_عملية_اختيار_ذراع.استخراج_حمولة -> { أرجع «payload-extract»; }
    | فئة_عملية_اختيار_ذراع.بناء_صندوق -> { أرجع «box-build»; }
    | فئة_عملية_اختيار_ذراع.بناء_إغلاق -> { أرجع «closure-build»; }
    | فئة_عملية_اختيار_ذراع.استخراج_التقاط -> { أرجع «capture-extract»; }
    | فئة_عملية_اختيار_ذراع.نداء -> { أرجع «call»; };
}

عرف نص_عملية_إكس_أصلية(العملية: فئة_عملية_اختيار_إكس): نص {
    طابق العملية مع
    | فئة_عملية_اختيار_إكس.ثابت -> { أرجع «constant»; }
    | فئة_عملية_اختيار_إكس.حساب_صحيح -> { أرجع «integer-arithmetic»; }
    | فئة_عملية_اختيار_إكس.حساب_عشري -> { أرجع «float-arithmetic»; }
    | فئة_عملية_اختيار_إكس.مقارنة_عشري -> { أرجع «float-compare»; }
    | فئة_عملية_اختيار_إكس.مقارنة_صحيح -> { أرجع «integer-compare»; }
    | فئة_عملية_اختيار_إكس.تحويل_صحيح -> { أرجع «integer-convert»; }
    | فئة_عملية_اختيار_إكس.تحويل_عائم -> { أرجع «float-convert»; }
    | فئة_عملية_اختيار_إكس.نقل_تسلسل_مملوك -> { أرجع «owned-byte-vector-to-text»; }
    | فئة_عملية_اختيار_إكس.مرجع_إلى_مؤشر -> { أرجع «reference-to-pointer»; }
    | فئة_عملية_اختيار_إكس.تجميع -> { أرجع «aggregate»; }
    | فئة_عملية_اختيار_إكس.تهيئة_متجه -> { أرجع «vector-init»; }
    | فئة_عملية_اختيار_إكس.استخراج_حقل -> { أرجع «extract-field»; }
    | فئة_عملية_اختيار_إكس.استخراج_فهرس -> { أرجع «extract-index»; }
    | فئة_عملية_اختيار_إكس.مكان_محلي -> { أرجع «local-place»; }
    | فئة_عملية_اختيار_إكس.مكان_عام -> { أرجع «global-place»; }
    | فئة_عملية_اختيار_إكس.مرجع_إلى_مكان -> { أرجع «reference-to-place»; }
    | فئة_عملية_اختيار_إكس.صندوق_إلى_مكان -> { أرجع «box-to-place»; }
    | فئة_عملية_اختيار_إكس.مكان_حقل -> { أرجع «field-place»; }
    | فئة_عملية_اختيار_إكس.مكان_فهرس -> { أرجع «index-place»; }
    | فئة_عملية_اختيار_إكس.موضع_تخزين_عنصر_مؤشر -> { أرجع «pointer-element-place»; }
    | فئة_عملية_اختيار_إكس.تحميل -> { أرجع «load»; }
    | فئة_عملية_اختيار_إكس.تخزين -> { أرجع «store»; }
    | فئة_عملية_اختيار_إكس.مكان_إلى_مرجع -> { أرجع «place-to-reference»; }
    | فئة_عملية_اختيار_إكس.بناء_موسوم -> { أرجع «tagged-build»; }
    | فئة_عملية_اختيار_إكس.استعلام_وسم -> { أرجع «tag-query»; }
    | فئة_عملية_اختيار_إكس.استخراج_حمولة -> { أرجع «payload-extract»; }
    | فئة_عملية_اختيار_إكس.بناء_صندوق -> { أرجع «box-build»; }
    | فئة_عملية_اختيار_إكس.بناء_إغلاق -> { أرجع «closure-build»; }
    | فئة_عملية_اختيار_إكس.استخراج_التقاط -> { أرجع «capture-extract»; }
    | فئة_عملية_اختيار_إكس.نداء -> { أرجع «call»; };
}

عرف أضف_سياق_اختيار_ذراع(
    التشخيص: &متغير تشخيص,
    الفشل: &فشل_اختيار_ذراع_أربعة_وستون
): فراغ {
    دع الحالة: فشل_اختيار_ذراع_أربعة_وستون = *الفشل;
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «arm64»);
    طابق الحالة.الدالة مع
    | اختياري.موجود(الدالة) -> { أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | اختياري.لا_شيء -> { };
    طابق الحالة.الكتلة مع
    | اختياري.موجود(الكتلة) -> { أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | اختياري.لا_شيء -> { };
    طابق الحالة.فهرس_التعليمة مع
    | اختياري.موجود(الفهرس) -> { أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.التعليمة(), الفهرس); }
    | اختياري.لا_شيء -> { };
    طابق الحالة.العملية مع
    | اختياري.موجود(العملية) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.العملية(), نص_عملية_ذراع_أصلية(العملية)); }
    | اختياري.لا_شيء -> { };
}

عرف أضف_سياق_اختيار_إكس(
    التشخيص: &متغير تشخيص,
    الفشل: &فشل_اختيار_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
