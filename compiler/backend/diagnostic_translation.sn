    | خطأ_إلف.نموذج_بيانات_غير_مدعوم(الهدف) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_إلف_غير_مدعوم_بيانات_نموذج()); أضف_هدف_فشل_أصلي(التشخيص, الهدف); }
    | خطأ_إلف.رمز_مكرر -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_إلف_مكرر_رمز()); }
    | خطأ_إلف.إزاحة_نداء_خارج_النص -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_إلف_استدعاء_إعادة_توطين_خارج_نص()); }
    | خطأ_إلف.إضافة_إزاحة_غير_مدعومة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_إلف_غير_مدعوم_إعادة_توطين_مضاف()); }
    | خطأ_إلف.رمز_إزاحة_مفقود -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_إلف_مفقود_إعادة_توطين_رمز()); }
    | خطأ_إلف.رمز_دخول_مفقود(الدالة) -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_إلف_مفقود_دخول_رمز()); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_إلف.حدود_صيغة_متجاوزة -> { أضف_سبب_فشل_أصلي(التشخيص, سبب_تشخيص.سبب_كائن_إلف_صيغة_حد_متجاوز()); };
