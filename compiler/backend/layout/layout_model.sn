استورد compiler.frontend.types.type_identity;
استورد compiler.backend.target.target_model;

// Layout owns physical representation only. Semantic field/constructor identity remains in Type.
عام نوع موضع_جزء_تخطيط = {
    الفهرس: طبيعي,
    الإزاحة: طبيعي,
    المحاذاة: طبيعي
};

// A constructor payload layout is keyed only by the constructor's canonical Type-owned index.
// Payload entries are likewise keyed by their Type-owned payload index.
عام نوع تخطيط_حمولات_منشئ = {
    فهرس_المنشئ: طبيعي,
    قيمة_الوسم: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    الحمولات: متجه موضع_جزء_تخطيط
};

عام نوع تمثيل_وسم_تعداد = {
    الإزاحة: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي
};

عام نوع مخزن_حمولة_تعداد = {
    الإزاحة: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي
};

عام نوع تخطيط_تعداد = {
    الوسم: تمثيل_وسم_تعداد,
    مخزن_الحمولة: مخزن_حمولة_تعداد,
    المنشئات: متجه تخطيط_حمولات_منشئ
};

// تفاصيل layout contain only representation facts. They never copy semantic names or constructors.
عام نوع تفاصيل_تخطيط =
    | بدائي
    | مؤشر_شبيه
    | صف بنوع متجه موضع_جزء_تخطيط
    | سجل بنوع متجه موضع_جزء_تخطيط
    | تعداد بنوع تخطيط_تعداد
;

عام نوع واصف_تخطيط = {
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    التفاصيل: تفاصيل_تخطيط
};

// Deferred means the semantic Type is valid but its physical representation is intentionally unfrozen.
عام نوع سبب_تأجيل_تخطيط =
    | نوع_ديناميكي
    | نص_مدار_وقت_التشغيل
    | شريحة_غير_مجمدة
    | متجه_غير_مجمد
    | دالة_غير_مجمدة
    | بلا_تمثيل_قيمة
;

عام نوع خطأ_تخطيط =
    | معرف_نوع_غير_صالح
    | نموذج_بيانات_هدف_غير_صالح
    | دورة_مادية_مباشرة
    | بنية_نوع_ناقصة
;

عام نوع نتيجة_تخطيط =
    | مكتمل بنوع واصف_تخطيط
    | مؤجل بنوع سبب_تأجيل_تخطيط
    | مرفوض بنوع خطأ_تخطيط
;

عام نوع نتيجة_تخطيط_منشئ =
    | مكتمل بنوع تخطيط_حمولات_منشئ
    | مؤجل بنوع سبب_تأجيل_تخطيط
    | مرفوض بنوع خطأ_تخطيط
;

// Cache entries are coherent state transitions for one Type ID; no parallel state vectors exist.
عام نوع حالة_قيد_تخطيط =
    | جار
    | مكتمل بنوع واصف_تخطيط
    | مؤجل بنوع سبب_تأجيل_تخطيط
    | مرفوض بنوع خطأ_تخطيط
;

// The cache belongs to one target data-model at a time. The model key is stored once;
// TypeID is dense, so each cached layout state lives directly in its TypeID slot.
// Reusing the same cache with a different model resets only derived cache state.
عام نوع مفتاح_نموذج_تخطيط = {
    نموذج_البيانات: معرف_نموذج_بيانات_هدف,
    عرض_المؤشر: طبيعي,
    ترتيب_البايت: ترتيب_بايت
};

عام نوع سجل_تخطيط = {
    النموذج: اختياري مفتاح_نموذج_تخطيط,
    الحالات: متجه اختياري حالة_قيد_تخطيط
};

عام عرف سجل_تخطيط_جديد(): سجل_تخطيط {
    دع النموذج: اختياري مفتاح_نموذج_تخطيط = اختياري.لا_شيء();
    دع الحالات: متجه اختياري حالة_قيد_تخطيط = [];
    دع السجل: سجل_تخطيط = {
        النموذج: النموذج,
        الحالات: الحالات
    };
    أرجع السجل;
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_سجل_تخطيط(القيمة: &سجل_تخطيط): سجل_تخطيط {
    دع الناتج: سجل_تخطيط = {
        النموذج: (*القيمة).النموذج,
        الحالات: انسخ_مملوكا__متجه_اختيار_حالة_قيد_تخطيط(&(*القيمة).الحالات)
    };
    أرجع الناتج;
}

عرف انسخ_مملوكا__متجه_اختيار_حالة_قيد_تخطيط(القيمة: &متجه اختياري حالة_قيد_تخطيط): متجه اختياري حالة_قيد_تخطيط {
    دع الناتج: متغير متجه اختياري حالة_قيد_تخطيط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_اختيار_حالة_قيد_تخطيط(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حالة_قيد_تخطيط(القيمة: &حالة_قيد_تخطيط): حالة_قيد_تخطيط {
    طابق *القيمة مع
    | حالة_قيد_تخطيط.جار -> { أرجع حالة_قيد_تخطيط.جار(); }
    | حالة_قيد_تخطيط.مكتمل(ح0) -> { أرجع حالة_قيد_تخطيط.مكتمل(انسخ_مملوكا_واصف_تخطيط(&ح0)); }
    | حالة_قيد_تخطيط.مؤجل(ح0) -> { أرجع حالة_قيد_تخطيط.مؤجل(ح0); }
    | حالة_قيد_تخطيط.مرفوض(ح0) -> { أرجع حالة_قيد_تخطيط.مرفوض(ح0); };
}

عام عرف انسخ_مملوكا_واصف_تخطيط(القيمة: &واصف_تخطيط): واصف_تخطيط {
    دع الناتج: واصف_تخطيط = {
        الحجم: (*القيمة).الحجم,
        المحاذاة: (*القيمة).المحاذاة,
        التفاصيل: انسخ_مملوكا_تفاصيل_تخطيط(&(*القيمة).التفاصيل)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تفاصيل_تخطيط(القيمة: &تفاصيل_تخطيط): تفاصيل_تخطيط {
    طابق *القيمة مع
    | تفاصيل_تخطيط.بدائي -> { أرجع تفاصيل_تخطيط.بدائي(); }
    | تفاصيل_تخطيط.مؤشر_شبيه -> { أرجع تفاصيل_تخطيط.مؤشر_شبيه(); }
    | تفاصيل_تخطيط.صف(ح0) -> { أرجع تفاصيل_تخطيط.صف(انسخ_مملوكا_متجه_موضع_جزء_تخطيط(&ح0)); }
    | تفاصيل_تخطيط.سجل(ح0) -> { أرجع تفاصيل_تخطيط.سجل(انسخ_مملوكا_متجه_موضع_جزء_تخطيط(&ح0)); }
    | تفاصيل_تخطيط.تعداد(ح0) -> { أرجع تفاصيل_تخطيط.تعداد(انسخ_مملوكا_تخطيط_تعداد(&ح0)); };
}

عام عرف انسخ_مملوكا_متجه_موضع_جزء_تخطيط(القيمة: &متجه موضع_جزء_تخطيط): متجه موضع_جزء_تخطيط {
    دع الناتج: متغير متجه موضع_جزء_تخطيط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تخطيط_تعداد(القيمة: &تخطيط_تعداد): تخطيط_تعداد {
    دع الناتج: تخطيط_تعداد = {
        الوسم: (*القيمة).الوسم,
        مخزن_الحمولة: (*القيمة).مخزن_الحمولة,
        المنشئات: انسخ_مملوكا_متجه_تخطيط_حمولات_منشئ(&(*القيمة).المنشئات)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_تخطيط_حمولات_منشئ(القيمة: &متجه تخطيط_حمولات_منشئ): متجه تخطيط_حمولات_منشئ {
    دع الناتج: متغير متجه تخطيط_حمولات_منشئ = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_تخطيط_حمولات_منشئ(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تخطيط_حمولات_منشئ(القيمة: &تخطيط_حمولات_منشئ): تخطيط_حمولات_منشئ {
    دع الناتج: تخطيط_حمولات_منشئ = {
        فهرس_المنشئ: (*القيمة).فهرس_المنشئ,
        قيمة_الوسم: (*القيمة).قيمة_الوسم,
        الحجم: (*القيمة).الحجم,
        المحاذاة: (*القيمة).المحاذاة,
        الحمولات: انسخ_مملوكا_متجه_موضع_جزء_تخطيط(&(*القيمة).الحمولات)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_اختيار_حالة_قيد_تخطيط(القيمة: &اختياري حالة_قيد_تخطيط): اختياري حالة_قيد_تخطيط {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(انسخ_مملوكا_حالة_قيد_تخطيط(&الداخل)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}
