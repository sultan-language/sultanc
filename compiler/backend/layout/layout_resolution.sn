استورد compiler.backend.layout.layout_model;
استورد compiler.backend.layout.alignment;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_registry;
استورد compiler.backend.target.target_model;

عرف أكبر(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    لو (أ > ب) {
        أرجع أ;
    };
    أرجع ب;
}

عرف بايتات_المؤشر(النموذج: &نموذج_بيانات_هدف): اختيار غير_موقع {
    دع القيمة: نموذج_بيانات_هدف = *النموذج;
    لو ((القيمة.عرض_المؤشر == 0) || ((القيمة.عرض_المؤشر % 8) != 0)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(القيمة.عرض_المؤشر / 8);
}

عرف واصف_بسيط(
    الحجم: غير_موقع,
    المحاذاة: غير_موقع,
    التفاصيل: تفاصيل_تخطيط
): نتيجة_تخطيط {
    دع الوصف: واصف_تخطيط = {
        الحجم: الحجم,
        المحاذاة: المحاذاة,
        التفاصيل: التفاصيل
    };
    أرجع نتيجة_تخطيط.مكتمل(الوصف);
}

عرف تخطيط_تسلسل_مدار(النموذج: &نموذج_بيانات_هدف): نتيجة_تخطيط {
    طابق بايتات_المؤشر(النموذج) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.نموذج_بيانات_هدف_غير_صالح());
    }
    | اختيار.بعض(حجم_المؤشر) -> {
        دع موضع_البيانات: موضع_جزء_تخطيط = {
            الفهرس: 0,
            الإزاحة: 0,
            المحاذاة: حجم_المؤشر
        };
        دع موضع_الطول: موضع_جزء_تخطيط = {
            الفهرس: 1,
            الإزاحة: حجم_المؤشر,
            المحاذاة: حجم_المؤشر
        };
        دع إزاحة_السعة: غير_موقع = حجم_المؤشر * 2;
        دع موضع_السعة: موضع_جزء_تخطيط = {
            الفهرس: 2,
            الإزاحة: إزاحة_السعة,
            المحاذاة: حجم_المؤشر
        };
        دع الأجزاء: متجه موضع_جزء_تخطيط = [موضع_البيانات, موضع_الطول, موضع_السعة];
        دع التفاصيل: تفاصيل_تخطيط = تفاصيل_تخطيط.سجل(الأجزاء);
        دع الحجم: غير_موقع = حجم_المؤشر * 3;
        أرجع واصف_بسيط(الحجم, حجم_المؤشر, التفاصيل);
    };
}

عرف تخطيط_بدائي(النوع: نوع_بدائي_مقنن, النموذج: &نموذج_بيانات_هدف): نتيجة_تخطيط {
    طابق النوع مع
    | نوع_بدائي_مقنن.أي -> {
        أرجع نتيجة_تخطيط.مؤجل(سبب_تأجيل_تخطيط.نوع_ديناميكي());
    }
    | نوع_بدائي_مقنن.نص -> {
        أرجع تخطيط_تسلسل_مدار(النموذج);
    }
    | نوع_بدائي_مقنن.فراغ -> {
        أرجع نتيجة_تخطيط.مؤجل(سبب_تأجيل_تخطيط.بلا_تمثيل_قيمة());
    }
    | نوع_بدائي_مقنن.منطقي -> {
        أرجع واصف_بسيط(1, 1, تفاصيل_تخطيط.بدائي());
    }
    | _ -> {
        دع البتات: غير_موقع = بتات_نوع_بدائي(النوع);
        لو ((البتات == 0) || ((البتات % 8) != 0)) {
            أرجع نتيجة_تخطيط.مؤجل(سبب_تأجيل_تخطيط.بلا_تمثيل_قيمة());
        };
        دع الحجم: غير_موقع = البتات / 8;
        أرجع واصف_بسيط(الحجم, الحجم, تفاصيل_تخطيط.بدائي());
    };
}

عرف رقم_ترتيب_بايت(الترتيب: ترتيب_بايت): غير_موقع {
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> {
        أرجع 0;
    }
    | ترتيب_بايت.كبير -> {
        أرجع 1;
    };
}

عرف مفتاح_نموذج_التخطيط(
    معرف_النموذج: معرف_نموذج_بيانات_هدف,
    النموذج: &نموذج_بيانات_هدف
): مفتاح_نموذج_تخطيط {
    دع القيمة: نموذج_بيانات_هدف = *النموذج;
    دع المفتاح: مفتاح_نموذج_تخطيط = {
        نموذج_البيانات: معرف_النموذج,
        عرض_المؤشر: القيمة.عرض_المؤشر,
        ترتيب_البايت: القيمة.ترتيب_البايت
    };
    أرجع المفتاح;
}

عرف مفتاحا_نموذج_تخطيط_متساويان(
    أ: &مفتاح_نموذج_تخطيط,
    ب: &مفتاح_نموذج_تخطيط
): منطقي {
    دع اليسار: مفتاح_نموذج_تخطيط = *أ;
    دع اليمين: مفتاح_نموذج_تخطيط = *ب;
    أرجع معرفا_نموذج_بيانات_هدف_متساويان(اليسار.نموذج_البيانات, اليمين.نموذج_البيانات)
        && اليسار.عرض_المؤشر == اليمين.عرض_المؤشر
        && رقم_ترتيب_بايت(اليسار.ترتيب_البايت) == رقم_ترتيب_بايت(اليمين.ترتيب_البايت);
}

عرف تأكد_نموذج_سجل_التخطيط(
    السجل: &متغير سجل_تخطيط,
    المفتاح: مفتاح_نموذج_تخطيط
): فراغ {
    دع الحالة: متغير سجل_تخطيط = *السجل;
    طابق الحالة.النموذج مع
    | اختيار.بعض(الحالي) -> {
        لو (مفتاحا_نموذج_تخطيط_متساويان(&الحالي, &المفتاح)) {
            أرجع;
        };
    }
    | اختيار.لا_شيء -> { };
    دع الحالات: متجه اختيار حالة_قيد_تخطيط = [];
    الحالة.النموذج := اختيار.بعض(المفتاح);
    الحالة.الحالات := الحالات;
    *السجل := الحالة;
}

عرف حالة_قيد_عند(
    السجل: &سجل_تخطيط,
    النوع: معرف_نوع
): اختيار حالة_قيد_تخطيط {
    دع الحالة: سجل_تخطيط = *السجل;
    لو (النوع.القيمة >= (الطول(الحالة.الحالات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع المرجع: &اختيار حالة_قيد_تخطيط = &الحالة.الحالات[النوع.القيمة];
    دع القيمة: اختيار حالة_قيد_تخطيط = *المرجع;
    أرجع القيمة;
}

عرف نتيجة_من_حالة(الحالة: &حالة_قيد_تخطيط): نتيجة_تخطيط {
    دع القيمة: حالة_قيد_تخطيط = *الحالة;
    طابق القيمة مع
    | حالة_قيد_تخطيط.جار -> {
        أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.دورة_مادية_مباشرة());
    }
    | حالة_قيد_تخطيط.مكتمل(الوصف) -> {
        أرجع نتيجة_تخطيط.مكتمل(الوصف);
    }
    | حالة_قيد_تخطيط.مؤجل(السبب) -> {
        أرجع نتيجة_تخطيط.مؤجل(السبب);
    }
    | حالة_قيد_تخطيط.مرفوض(الخطأ) -> {
        أرجع نتيجة_تخطيط.مرفوض(الخطأ);
    };
}

عرف حالة_من_نتيجة(النتيجة: نتيجة_تخطيط): حالة_قيد_تخطيط {
    طابق النتيجة مع
    | نتيجة_تخطيط.مكتمل(الوصف) -> {
        أرجع حالة_قيد_تخطيط.مكتمل(الوصف);
    }
    | نتيجة_تخطيط.مؤجل(السبب) -> {
        أرجع حالة_قيد_تخطيط.مؤجل(السبب);
    }
    | نتيجة_تخطيط.مرفوض(الخطأ) -> {
        أرجع حالة_قيد_تخطيط.مرفوض(الخطأ);
    };
}

عرف ابدأ_قيد(
    السجل: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): فراغ {
    دع الحالة: متغير سجل_تخطيط = *السجل;
    بينما ((الطول(الحالة.الحالات) مثل غير_موقع) <= النوع.القيمة) {
        ألحق(الحالة.الحالات, اختيار.لا_شيء());
    }
    الحالة.الحالات[النوع.القيمة] := اختيار.بعض(حالة_قيد_تخطيط.جار());
    *السجل := الحالة;
}

عرف اختم_قيد(
    السجل: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    النتيجة: نتيجة_تخطيط
): نتيجة_تخطيط {
    دع الحالة: متغير سجل_تخطيط = *السجل;
    دع الحالة_النهائية: حالة_قيد_تخطيط = حالة_من_نتيجة(النتيجة);
    دع نتيجة_المستدعي: نتيجة_تخطيط = نتيجة_من_حالة(&الحالة_النهائية);
    الحالة.الحالات[النوع.القيمة] := اختيار.بعض(الحالة_النهائية);
    *السجل := الحالة;
    أرجع نتيجة_المستدعي;
}

عرف تخطيط_مؤشر_شبيه(النموذج: &نموذج_بيانات_هدف): نتيجة_تخطيط {
    طابق بايتات_المؤشر(النموذج) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.نموذج_بيانات_هدف_غير_صالح());
    }
    | اختيار.بعض(الحجم) -> {
        أرجع واصف_بسيط(الحجم, الحجم, تفاصيل_تخطيط.مؤشر_شبيه());
    };
}

عرف تخطيط_صف(
    الأنواع: &سجل_أنواع,
    النموذج: &نموذج_بيانات_هدف,
    معرف_النموذج: معرف_نموذج_بيانات_هدف,
    السجل: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة_تخطيط {
    طابق عدد_عناصر_صف_دلالي(الأنواع, النوع) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.بنية_نوع_ناقصة());
    }
    | اختيار.بعض(العدد) -> {
        دع الأجزاء: متجه موضع_جزء_تخطيط = [];
        دع الناتج: متغير متجه موضع_جزء_تخطيط = الأجزاء;
        دع الإزاحة: متغير غير_موقع = 0;
        دع محاذاة_الكل: متغير غير_موقع = 1;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.بنية_نوع_ناقصة());
            }
            | اختيار.بعض(نوع_العنصر) -> {
                طابق احسب_تخطيط(الأنواع, النموذج, معرف_النموذج, السجل, نوع_العنصر) مع
                | نتيجة_تخطيط.مؤجل(السبب) -> {
                    أرجع نتيجة_تخطيط.مؤجل(السبب);
                }
                | نتيجة_تخطيط.مرفوض(الخطأ) -> {
                    أرجع نتيجة_تخطيط.مرفوض(الخطأ);
                }
                | نتيجة_تخطيط.مكتمل(تخطيط_العنصر) -> {
                    الإزاحة := محاذاة_لأعلى(الإزاحة, تخطيط_العنصر.المحاذاة);
                    دع الموضع: موضع_جزء_تخطيط = {
                        الفهرس: ف,
                        الإزاحة: الإزاحة,
                        المحاذاة: تخطيط_العنصر.المحاذاة
                    };
                    ألحق(الناتج, الموضع);
                    الإزاحة := الإزاحة + تخطيط_العنصر.الحجم;
                    محاذاة_الكل := أكبر(محاذاة_الكل, تخطيط_العنصر.المحاذاة);
                };
            };
            ف := ف + 1;
        }
        دع الحجم: غير_موقع = محاذاة_لأعلى(الإزاحة, محاذاة_الكل);
        دع التفاصيل: تفاصيل_تخطيط = تفاصيل_تخطيط.صف(الناتج);
        دع الوصف: واصف_تخطيط = {
            الحجم: الحجم,
            المحاذاة: محاذاة_الكل,
            التفاصيل: التفاصيل
        };
        أرجع نتيجة_تخطيط.مكتمل(الوصف);
    };
}

عرف تخطيط_سجل(
    الأنواع: &سجل_أنواع,
    النموذج: &نموذج_بيانات_هدف,
    معرف_النموذج: معرف_نموذج_بيانات_هدف,
    السجل: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة_تخطيط {
    طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.بنية_نوع_ناقصة());
    }
    | اختيار.بعض(العدد) -> {
        دع الأجزاء: متجه موضع_جزء_تخطيط = [];
        دع الناتج: متغير متجه موضع_جزء_تخطيط = الأجزاء;
        دع الإزاحة: متغير غير_موقع = 0;
        دع محاذاة_الكل: متغير غير_موقع = 1;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.بنية_نوع_ناقصة());
            }
            | اختيار.بعض(نوع_الحقل) -> {
                طابق احسب_تخطيط(الأنواع, النموذج, معرف_النموذج, السجل, نوع_الحقل) مع
                | نتيجة_تخطيط.مؤجل(السبب) -> {
                    أرجع نتيجة_تخطيط.مؤجل(السبب);
                }
                | نتيجة_تخطيط.مرفوض(الخطأ) -> {
                    أرجع نتيجة_تخطيط.مرفوض(الخطأ);
                }
                | نتيجة_تخطيط.مكتمل(تخطيط_الحقل) -> {
                    الإزاحة := محاذاة_لأعلى(الإزاحة, تخطيط_الحقل.المحاذاة);
                    دع الموضع: موضع_جزء_تخطيط = {
                        الفهرس: ف,
                        الإزاحة: الإزاحة,
                        المحاذاة: تخطيط_الحقل.المحاذاة
                    };
                    ألحق(الناتج, الموضع);
                    الإزاحة := الإزاحة + تخطيط_الحقل.الحجم;
                    محاذاة_الكل := أكبر(محاذاة_الكل, تخطيط_الحقل.المحاذاة);
                };
            };
            ف := ف + 1;
        }
        دع الحجم: غير_موقع = محاذاة_لأعلى(الإزاحة, محاذاة_الكل);
        دع التفاصيل: تفاصيل_تخطيط = تفاصيل_تخطيط.سجل(الناتج);
        دع الوصف: واصف_تخطيط = {
            الحجم: الحجم,
            المحاذاة: محاذاة_الكل,
            التفاصيل: التفاصيل
        };
        أرجع نتيجة_تخطيط.مكتمل(الوصف);
    };
}

عرف حجم_وسم_لعدد_منشئات(العدد: غير_موقع): اختيار غير_موقع {
    لو (العدد == 0) {
        أرجع اختيار.لا_شيء();
    };
    لو (العدد <= 256) {
        أرجع اختيار.بعض(1);
    };
    لو (العدد <= 65536) {
        أرجع اختيار.بعض(2);
    };
    لو (العدد <= 4294967296) {
        أرجع اختيار.بعض(4);
    };
    أرجع اختيار.بعض(8);
}

عرف تخطيط_حمولات_منشئ_عند(
    الأنواع: &سجل_أنواع,
    النموذج: &نموذج_بيانات_هدف,
    معرف_النموذج: معرف_نموذج_بيانات_هدف,
    السجل: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    الفهرس: غير_موقع
): نتيجة_تخطيط_منشئ {
    طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, النوع, الفهرس) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تخطيط_منشئ.مرفوض(خطأ_تخطيط.بنية_نوع_ناقصة());
    }
    | اختيار.بعض(العدد) -> {
        دع المواقع: متجه موضع_جزء_تخطيط = [];
        دع الناتج: متغير متجه موضع_جزء_تخطيط = المواقع;
        دع الإزاحة: متغير غير_موقع = 0;
        دع محاذاة_الكل: متغير غير_موقع = 1;
        دع ح: متغير غير_موقع = 0;
        بينما (ح < العدد) {
            طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, النوع, الفهرس, ح) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تخطيط_منشئ.مرفوض(خطأ_تخطيط.بنية_نوع_ناقصة());
            }
            | اختيار.بعض(نوع_الحمولة) -> {
                طابق احسب_تخطيط(الأنواع, النموذج, معرف_النموذج, السجل, نوع_الحمولة) مع
                | نتيجة_تخطيط.مؤجل(السبب) -> {
                    أرجع نتيجة_تخطيط_منشئ.مؤجل(السبب);
                }
                | نتيجة_تخطيط.مرفوض(الخطأ) -> {
                    أرجع نتيجة_تخطيط_منشئ.مرفوض(الخطأ);
                }
                | نتيجة_تخطيط.مكتمل(تخطيط_الحمولة) -> {
                    الإزاحة := محاذاة_لأعلى(الإزاحة, تخطيط_الحمولة.المحاذاة);
                    دع الموضع: موضع_جزء_تخطيط = {
                        الفهرس: ح,
                        الإزاحة: الإزاحة,
                        المحاذاة: تخطيط_الحمولة.المحاذاة
                    };
                    ألحق(الناتج, الموضع);
                    الإزاحة := الإزاحة + تخطيط_الحمولة.الحجم;
                    محاذاة_الكل := أكبر(محاذاة_الكل, تخطيط_الحمولة.المحاذاة);
                };
            };
            ح := ح + 1;
        }
        دع الحجم: غير_موقع = محاذاة_لأعلى(الإزاحة, محاذاة_الكل);
        دع التخطيط: تخطيط_حمولات_منشئ = {
            فهرس_المنشئ: الفهرس,
            قيمة_الوسم: الفهرس,
            الحجم: الحجم,
            المحاذاة: محاذاة_الكل,
            الحمولات: الناتج
        };
        أرجع نتيجة_تخطيط_منشئ.مكتمل(التخطيط);
    };
}

عرف تخطيط_تعداد_نوع(
    الأنواع: &سجل_أنواع,
    النموذج: &نموذج_بيانات_هدف,
    معرف_النموذج: معرف_نموذج_بيانات_هدف,
    السجل: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة_تخطيط {
    طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.بنية_نوع_ناقصة());
    }
    | اختيار.بعض(عدد_المنشئات) -> {
        طابق حجم_وسم_لعدد_منشئات(عدد_المنشئات) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.بنية_نوع_ناقصة());
        }
        | اختيار.بعض(حجم_الوسم) -> {
            دع التخطيطات: متجه تخطيط_حمولات_منشئ = [];
            دع منشئات: متغير متجه تخطيط_حمولات_منشئ = التخطيطات;
            دع حجم_الحمولة: متغير غير_موقع = 0;
            دع محاذاة_الحمولة: متغير غير_موقع = 1;
            دع ف: متغير غير_موقع = 0;
            بينما (ف < عدد_المنشئات) {
                طابق تخطيط_حمولات_منشئ_عند(الأنواع, النموذج, معرف_النموذج, السجل, النوع, ف) مع
                | نتيجة_تخطيط_منشئ.مؤجل(السبب) -> {
                    أرجع نتيجة_تخطيط.مؤجل(السبب);
                }
                | نتيجة_تخطيط_منشئ.مرفوض(الخطأ) -> {
                    أرجع نتيجة_تخطيط.مرفوض(الخطأ);
                }
                | نتيجة_تخطيط_منشئ.مكتمل(تخطيط_المنشئ) -> {
                    دع حجم_المنشئ: غير_موقع = تخطيط_المنشئ.الحجم;
                    دع محاذاة_المنشئ: غير_موقع = تخطيط_المنشئ.المحاذاة;
                    ألحق(منشئات, تخطيط_المنشئ);
                    حجم_الحمولة := أكبر(حجم_الحمولة, حجم_المنشئ);
                    محاذاة_الحمولة := أكبر(محاذاة_الحمولة, محاذاة_المنشئ);
                };
                ف := ف + 1;
            }
            دع إزاحة_الحمولة: غير_موقع = محاذاة_لأعلى(حجم_الوسم, محاذاة_الحمولة);
            دع محاذاة_الكل: غير_موقع = أكبر(حجم_الوسم, محاذاة_الحمولة);
            دع الحجم: غير_موقع = محاذاة_لأعلى(إزاحة_الحمولة + حجم_الحمولة, محاذاة_الكل);
            دع الوسم: تمثيل_وسم_تعداد = {
                الإزاحة: 0,
                الحجم: حجم_الوسم,
                المحاذاة: حجم_الوسم
            };
            دع المخزن: مخزن_حمولة_تعداد = {
                الإزاحة: إزاحة_الحمولة,
                الحجم: حجم_الحمولة,
                المحاذاة: محاذاة_الحمولة
            };
            دع تفاصيل_التعداد: تخطيط_تعداد = {
                الوسم: الوسم,
                مخزن_الحمولة: المخزن,
                المنشئات: منشئات
            };
            دع التفاصيل: تفاصيل_تخطيط = تفاصيل_تخطيط.تعداد(تفاصيل_التعداد);
            دع الوصف: واصف_تخطيط = {
                الحجم: الحجم,
                المحاذاة: محاذاة_الكل,
                التفاصيل: التفاصيل
            };
            أرجع نتيجة_تخطيط.مكتمل(الوصف);
        };
    };
}

عرف احسب_تخطيط(
    الأنواع: &سجل_أنواع,
    النموذج: &نموذج_بيانات_هدف,
    معرف_النموذج: معرف_نموذج_بيانات_هدف,
    السجل: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة_تخطيط {
    لو (!معرف_نوع_صالح(الأنواع, النوع)) {
        أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.معرف_نوع_غير_صالح());
    };
    دع مفتاح_النموذج: مفتاح_نموذج_تخطيط = مفتاح_نموذج_التخطيط(معرف_النموذج, النموذج);
    تأكد_نموذج_سجل_التخطيط(السجل, مفتاح_النموذج);
    طابق حالة_قيد_عند(السجل, النوع) مع
    | اختيار.بعض(الحالة) -> {
        أرجع نتيجة_من_حالة(&الحالة);
    }
    | اختيار.لا_شيء -> {
        ابدأ_قيد(السجل, النوع);
        دع النتيجة: نتيجة_تخطيط = احسب_تخطيط_جوهري(الأنواع, النموذج, معرف_النموذج, السجل, النوع);
        أرجع اختم_قيد(السجل, النوع, النتيجة);
    };
}

عرف احسب_تخطيط_جوهري(
    الأنواع: &سجل_أنواع,
    النموذج: &نموذج_بيانات_هدف,
    معرف_النموذج: معرف_نموذج_بيانات_هدف,
    السجل: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة_تخطيط {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.معرف_نوع_غير_صالح());
    }
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع تخطيط_بدائي(البدائي, النموذج);
        }
        | صنف_شكل_نوع_دلالي.معامل_نوع -> {
            أرجع نتيجة_تخطيط.مؤجل(سبب_تأجيل_تخطيط.بلا_تمثيل_قيمة());
        }
        | صنف_شكل_نوع_دلالي.صف -> {
            أرجع تخطيط_صف(الأنواع, النموذج, معرف_النموذج, السجل, الوصف.المعرف);
        }
        | صنف_شكل_نوع_دلالي.سجل -> {
            أرجع تخطيط_سجل(الأنواع, النموذج, معرف_النموذج, السجل, الوصف.المعرف);
        }
        | صنف_شكل_نوع_دلالي.تعداد -> {
            أرجع تخطيط_تعداد_نوع(الأنواع, النموذج, معرف_النموذج, السجل, الوصف.المعرف);
        }
        | صنف_شكل_نوع_دلالي.اختيار -> {
            أرجع تخطيط_تعداد_نوع(الأنواع, النموذج, معرف_النموذج, السجل, الوصف.المعرف);
        }
        | صنف_شكل_نوع_دلالي.نتيجة -> {
            أرجع تخطيط_تعداد_نوع(الأنواع, النموذج, معرف_النموذج, السجل, الوصف.المعرف);
        }
        | صنف_شكل_نوع_دلالي.مؤشر -> {
            أرجع تخطيط_مؤشر_شبيه(النموذج);
        }
        | صنف_شكل_نوع_دلالي.مرجع -> {
            أرجع تخطيط_مؤشر_شبيه(النموذج);
        }
        | صنف_شكل_نوع_دلالي.صندوق -> {
            أرجع تخطيط_مؤشر_شبيه(النموذج);
        }
        | صنف_شكل_نوع_دلالي.شريحة -> {
            أرجع نتيجة_تخطيط.مؤجل(سبب_تأجيل_تخطيط.شريحة_غير_مجمدة());
        }
        | صنف_شكل_نوع_دلالي.متجه -> {
            أرجع تخطيط_تسلسل_مدار(النموذج);
        }
        | صنف_شكل_نوع_دلالي.دالة -> {
            أرجع تخطيط_مؤشر_شبيه(النموذج);
        };
    };
}


عام عرف حل_تخطيط_حمولات_منشئ(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع,
    الفهرس: غير_موقع
): نتيجة_تخطيط_منشئ {
    دع واصف_الهدف: واصف_هدف = *الهدف;
    دع معرف_النموذج: معرف_نموذج_بيانات_هدف = معرف_نموذج_بيانات_الهدف(&واصف_الهدف);
    أرجع تخطيط_حمولات_منشئ_عند(
        الأنواع,
        &واصف_الهدف.نموذج_البيانات,
        معرف_النموذج,
        سجل_التخطيط,
        النوع,
        الفهرس
    );
}

عام عرف حل_تخطيط_نوع(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): نتيجة_تخطيط {
    دع واصف_الهدف: واصف_هدف = *الهدف;
    دع معرف_النموذج: معرف_نموذج_بيانات_هدف = معرف_نموذج_بيانات_الهدف(&واصف_الهدف);
    طابق بايتات_المؤشر(&واصف_الهدف.نموذج_البيانات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تخطيط.مرفوض(خطأ_تخطيط.نموذج_بيانات_هدف_غير_صالح());
    }
    | اختيار.بعض(حجم_المؤشر) -> {
        أرجع احسب_تخطيط(
            الأنواع,
            &واصف_الهدف.نموذج_البيانات,
            معرف_النموذج,
            سجل_التخطيط,
            النوع
        );
    };
}
