// الآلية الحسابية العامة الوحيدة للمحاذاة داخل Backend/Layout.
// قيم المحاذاة وسياسة ABI تبقى عند مالكيها؛ هذا الملف يملك الحساب فقط.
عام عرف محاذاة_لأعلى(القيمة: غير_موقع, المحاذاة: غير_موقع): غير_موقع {
    لو (المحاذاة <= 1) {
        أرجع القيمة;
    };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) {
        أرجع القيمة;
    };
    أرجع القيمة + (المحاذاة - الباقي);
}
