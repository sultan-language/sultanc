استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.liveness;
استورد compiler.backend.codegen.virtual_registers;

عرف مفسد_داخل_المجال(
    المجال: &مجال_حياة_سجل,
    المرشح: معرف_سجل_فعلي
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المجال).السجلات_المفسدة) مثل طبيعي)) {
        إذا (معرفا_سجل_فعلي_متساويان((*المجال).السجلات_المفسدة[ف], المرشح)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Linear-scan worklists in compressed (offset + flat) form, the layout mature
// allocators use for start-ordered interval lists (LLVM's RegAllocLinearScan
// keeps one sorted vector, not one container per program point). Previously
// the table held one heap vector per instruction position and one per
// physical register; every position allocated a vector header even when no
// interval started there. Order is unchanged: by start position, then by
// interval index.
نوع جدول_تخصيص_خطي = {
    المرتبة_بالبداية: متجه معرف_سجل_افتراضي,
    حدود_البدايات: متجه طبيعي,
    الثوابت_المرتبة: متجه معرف_سجل_افتراضي,
    حدود_الثوابت: متجه طبيعي
};

عرف عدد_مواضع_جدول_خطي(الجدول: &جدول_تخصيص_خطي): طبيعي {
    أرجع (الطول((*الجدول).حدود_البدايات) مثل طبيعي) - 1;
}

عرف بداية_مجالات_الموضع(الجدول: &جدول_تخصيص_خطي, الموضع: طبيعي): طبيعي {
    أرجع (*الجدول).حدود_البدايات[الموضع];
}

عرف نهاية_مجالات_الموضع(الجدول: &جدول_تخصيص_خطي, الموضع: طبيعي): طبيعي {
    أرجع (*الجدول).حدود_البدايات[الموضع + 1];
}

عرف عدد_فعلية_جدول_خطي(الجدول: &جدول_تخصيص_خطي): طبيعي {
    أرجع (الطول((*الجدول).حدود_الثوابت) مثل طبيعي) - 1;
}

عرف عدد_ثوابت_الفعلي(الجدول: &جدول_تخصيص_خطي, الفعلي: طبيعي): طبيعي {
    أرجع (*الجدول).حدود_الثوابت[الفعلي + 1] - (*الجدول).حدود_الثوابت[الفعلي];
}

عرف ثابت_الفعلي_عند(الجدول: &جدول_تخصيص_خطي, الفعلي: طبيعي, الموضع: طبيعي): معرف_سجل_افتراضي {
    أرجع (*الجدول).الثوابت_المرتبة[(*الجدول).حدود_الثوابت[الفعلي] + الموضع];
}

// Turns per-bucket counts into exclusive prefix offsets (length = buckets + 1).
عرف حول_الأعداد_إلى_حدود(الأعداد: &متغير متجه طبيعي): فراغ {
    دع المجموع: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأعداد) مثل طبيعي)) {
        دع العدد: طبيعي = (*الأعداد)[ف];
        (*الأعداد)[ف] := المجموع;
        المجموع := المجموع + العدد;
        ف := ف + 1;
    }
    ألحق(*الأعداد, المجموع);
}

عرف ابن_معرفات_فارغة(العدد: طبيعي): متجه معرف_سجل_افتراضي {
    دع الناتج: متغير متجه معرف_سجل_افتراضي = [];
    دع صفر: معرف_سجل_افتراضي = { القيمة: 0 };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, صفر);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ابن_خيارات_سجلات_فعلية(العدد: طبيعي): متجه اختياري معرف_سجل_فعلي {
    دع الناتج: متغير متجه اختياري معرف_سجل_فعلي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, اختياري.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ابن_خيارات_نهايات(العدد: طبيعي): متجه اختياري طبيعي {
    دع الناتج: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, اختياري.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ابن_أصفار(العدد: طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, 0);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف عدد_السجلات_الفعلية_المتابعة(
    المسألة: &مسألة_تخصيص,
    المجالات: &متجه مجال_حياة_سجل
): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
        دع المطلوب: طبيعي = (*المسألة).السجلات_المتاحة[ف].المعرف.القيمة + 1;
        إذا (المطلوب > العدد) { العدد := المطلوب; };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*المجالات) مثل طبيعي)) {
        طابق (*المجالات)[ف].ثابت مع
        | اختياري.موجود(الثابت) -> {
            دع المطلوب: طبيعي = الثابت.القيمة + 1;
            إذا (المطلوب > العدد) { العدد := المطلوب; };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف ابن_جدول_تخصيص_خطي(
    المسألة: &مسألة_تخصيص,
    المجالات: &متجه مجال_حياة_سجل
): جدول_تخصيص_خطي {
    دع أقصى_بداية: متغير طبيعي = 0;
    دع عدد_المصنفة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المجالات) مثل طبيعي)) {
        طابق (*المجالات)[ف].الفئة مع
        | اختياري.موجود(_) -> {
            إذا ((*المجالات)[ف].البداية > أقصى_بداية) { أقصى_بداية := (*المجالات)[ف].البداية; };
            عدد_المصنفة := عدد_المصنفة + 1;
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Counting sort of the classified intervals by start position.
    دع حدود_البدايات: متغير متجه طبيعي = ابن_أصفار(أقصى_بداية + 1);
    ف := 0;
    طالما (ف < (الطول(*المجالات) مثل طبيعي)) {
        طابق (*المجالات)[ف].الفئة مع
        | اختياري.موجود(_) -> {
            دع ب: طبيعي = (*المجالات)[ف].البداية;
            حدود_البدايات[ب] := حدود_البدايات[ب] + 1;
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    حول_الأعداد_إلى_حدود(&متغير حدود_البدايات);
    دع المرتبة: متغير متجه معرف_سجل_افتراضي = ابن_معرفات_فارغة(عدد_المصنفة);
    // Fill cursors: their own storage, so حدود_البدايات stays intact.
    دع المواضع_التالية: متغير متجه طبيعي = ابن_أصفار(أقصى_بداية + 1);
    ف := 0;
    طالما (ف <= أقصى_بداية) {
        المواضع_التالية[ف] := حدود_البدايات[ف];
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*المجالات) مثل طبيعي)) {
        طابق (*المجالات)[ف].الفئة مع
        | اختياري.موجود(_) -> {
            دع ب: طبيعي = (*المجالات)[ف].البداية;
            المرتبة[المواضع_التالية[ب]] := (*المجالات)[ف].السجل;
            المواضع_التالية[ب] := المواضع_التالية[ب] + 1;
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Fixed intervals per physical register, in start order.
    دع عدد_الفعلية: طبيعي = عدد_السجلات_الفعلية_المتابعة(المسألة, المجالات);
    دع حدود_الثوابت: متغير متجه طبيعي = ابن_أصفار(عدد_الفعلية);
    دع عدد_الثوابت: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < عدد_المصنفة) {
        طابق (*المجالات)[المرتبة[ف].القيمة].ثابت مع
        | اختياري.موجود(الثابت) -> {
            إذا (الثابت.القيمة < عدد_الفعلية) {
                حدود_الثوابت[الثابت.القيمة] := حدود_الثوابت[الثابت.القيمة] + 1;
                عدد_الثوابت := عدد_الثوابت + 1;
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    حول_الأعداد_إلى_حدود(&متغير حدود_الثوابت);
    دع الثوابت: متغير متجه معرف_سجل_افتراضي = ابن_معرفات_فارغة(عدد_الثوابت);
    دع مؤشرات_الثوابت: متغير متجه طبيعي = ابن_أصفار(عدد_الفعلية);
    ف := 0;
    طالما (ف < عدد_الفعلية) {
        مؤشرات_الثوابت[ف] := حدود_الثوابت[ف];
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < عدد_المصنفة) {
        دع المعرف: معرف_سجل_افتراضي = المرتبة[ف];
        طابق (*المجالات)[المعرف.القيمة].ثابت مع
        | اختياري.موجود(الثابت) -> {
            إذا (الثابت.القيمة < عدد_الفعلية) {
                الثوابت[مؤشرات_الثوابت[الثابت.القيمة]] := المعرف;
                مؤشرات_الثوابت[الثابت.القيمة] := مؤشرات_الثوابت[الثابت.القيمة] + 1;
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع الناتج: جدول_تخصيص_خطي = {
        المرتبة_بالبداية: المرتبة,
        حدود_البدايات: حدود_البدايات,
        الثوابت_المرتبة: الثوابت,
        حدود_الثوابت: حدود_الثوابت
    };
    أرجع الناتج;
}

عرف حدث_مؤشرات_الثوابت(
    المجالات: &متجه مجال_حياة_سجل,
    الجدول: &جدول_تخصيص_خطي,
    المؤشرات: &متغير متجه طبيعي,
    البداية: طبيعي
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المؤشرات) مثل طبيعي)) {
        دع استمر: متغير منطقي = صواب;
        طالما (استمر && (*المؤشرات)[ف] < عدد_ثوابت_الفعلي(الجدول, ف)) {
            دع مؤشر_الثابت: طبيعي = (*المؤشرات)[ف];
            دع السجل: معرف_سجل_افتراضي = ثابت_الفعلي_عند(الجدول, ف, مؤشر_الثابت);
            إذا ((*المجالات)[السجل.القيمة].النهاية < البداية) {
                (*المؤشرات)[ف] := (*المؤشرات)[ف] + 1;
            } وإلا { استمر := خطأ; };
        }
        ف := ف + 1;
    }
}

عرف محجوز_بثابت_قادم(
    المجالات: &متجه مجال_حياة_سجل,
    الجدول: &جدول_تخصيص_خطي,
    المؤشرات: &متجه طبيعي,
    فهرس_الفعلي: طبيعي,
    المجال: &مجال_حياة_سجل
): منطقي {
    إذا (فهرس_الفعلي >= عدد_فعلية_جدول_خطي(الجدول)) { أرجع خطأ; };
    دع الموضع: طبيعي = (*المؤشرات)[فهرس_الفعلي];
    إذا (الموضع >= عدد_ثوابت_الفعلي(الجدول, فهرس_الفعلي)) { أرجع خطأ; };
    دع المعرف: معرف_سجل_افتراضي = ثابت_الفعلي_عند(الجدول, فهرس_الفعلي, الموضع);
    أرجع (*المجالات)[المعرف.القيمة].البداية <= (*المجال).النهاية
        && (*المجال).البداية <= (*المجالات)[المعرف.القيمة].النهاية;
}

عرف سجل_مربوط_مخصص_مباشر(
    المجال: &مجال_حياة_سجل,
    التعيينات: &متجه اختياري معرف_سجل_فعلي
): اختياري معرف_سجل_فعلي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المجال).السجلات_المربوطة) مثل طبيعي)) {
        دع المعرف: معرف_سجل_افتراضي = (*المجال).السجلات_المربوطة[ف];
        إذا (المعرف.القيمة < (الطول(*التعيينات) مثل طبيعي)) {
            طابق (*التعيينات)[المعرف.القيمة] مع
            | اختياري.موجود(الفعلي) -> { أرجع اختياري.موجود(الفعلي); }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف مرشح_متاح_خطي(
    المجالات: &متجه مجال_حياة_سجل,
    الجدول: &جدول_تخصيص_خطي,
    مؤشرات_الثوابت: &متجه طبيعي,
    النهايات_النشطة: &متجه اختياري طبيعي,
    المجال: &مجال_حياة_سجل,
    المرشح: معرف_سجل_فعلي,
    فهرس_الفعلي: طبيعي,
    احترم_الثوابت_القادمة: منطقي
): منطقي {
    إذا (مفسد_داخل_المجال(المجال, المرشح)) { أرجع خطأ; };
    طابق (*النهايات_النشطة)[فهرس_الفعلي] مع
    | اختياري.موجود(النهاية) -> { إذا (النهاية >= (*المجال).البداية) { أرجع خطأ; }; }
    | اختياري.لا_شيء -> { };
    إذا (احترم_الثوابت_القادمة && محجوز_بثابت_قادم(
        المجالات, الجدول, مؤشرات_الثوابت, فهرس_الفعلي, المجال
    )) { أرجع خطأ; };
    أرجع صواب;
}

عرف اجمع_تعيينات_مباشرة(
    المباشرة: &متجه اختياري معرف_سجل_فعلي
): متجه تعيين_سجل {
    دع الناتج: متغير متجه تعيين_سجل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المباشرة) مثل طبيعي)) {
        طابق (*المباشرة)[ف] مع
        | اختياري.موجود(الفعلي) -> {
            دع الافتراضي: معرف_سجل_افتراضي = { القيمة: ف };
            دع التعيين: تعيين_سجل = { الافتراضي: الافتراضي, الفعلي: الفعلي };
            ألحق(الناتج, التعيين);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سجل_فعلي_من_الفهرس(
    المسألة: &مسألة_تخصيص,
    الفهرس: طبيعي
): معرف_سجل_فعلي {
    أرجع (*المسألة).السجلات_المتاحة[الفهرس].المعرف;
}

عام عرف خصص_السجلات(المسألة: &مسألة_تخصيص): نتيجة_تخصيص {
    دع المجالات: متجه مجال_حياة_سجل = حلل_مجالات_الحياة(المسألة);
    دع الجدول: جدول_تخصيص_خطي = ابن_جدول_تخصيص_خطي(المسألة, &المجالات);
    دع التعيينات: متغير متجه اختياري معرف_سجل_فعلي = ابن_خيارات_سجلات_فعلية(
        (*المسألة).عدد_السجلات_الافتراضية
    );
    دع عدد_الفعلية: طبيعي = عدد_السجلات_الفعلية_المتابعة(المسألة, &المجالات);
    دع النهايات_النشطة: متغير متجه اختياري طبيعي = ابن_خيارات_نهايات(عدد_الفعلية);
    دع مؤشرات_الثوابت: متغير متجه طبيعي = ابن_أصفار(عدد_الفعلية);

    دع موضع: متغير طبيعي = 0;
    طالما (موضع < عدد_مواضع_جدول_خطي(&الجدول)) {
        حدث_مؤشرات_الثوابت(&المجالات, &الجدول, &متغير مؤشرات_الثوابت, موضع);
        دع المرحلة: متغير طبيعي = 0;
        طالما (المرحلة < 2) {
            دع ف: متغير طبيعي = بداية_مجالات_الموضع(&الجدول, موضع);
            طالما (ف < نهاية_مجالات_الموضع(&الجدول, موضع)) {
                دع المعرف: معرف_سجل_افتراضي = الجدول.المرتبة_بالبداية[ف];
                دع مرجع_المجال: &مجال_حياة_سجل = &المجالات[المعرف.القيمة];
                دع المجال: مجال_حياة_سجل = *مرجع_المجال;
                إذا (المجال.تعارض_قيود) {
                    أرجع نتيجة_تخصيص.فشل_قيود(المجال.السجل);
                };
                دع ثابت_مسبق: متغير منطقي = خطأ;
                طابق المجال.ثابت مع
                | اختياري.موجود(_) -> { ثابت_مسبق := صواب; }
                | اختياري.لا_شيء -> { };
                إذا ((المرحلة == 0 && ثابت_مسبق) || (المرحلة == 1 && !ثابت_مسبق)) {
                    دع المختار: متغير اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
                    دع فهرس_المختار: متغير اختياري طبيعي = اختياري.لا_شيء();
                    طابق المجال.ثابت مع
                    | اختياري.موجود(ثابت) -> {
                        إذا (
                            ثابت.القيمة < (الطول(النهايات_النشطة) مثل طبيعي)
                            && مرشح_متاح_خطي(
                                &المجالات, &الجدول, &مؤشرات_الثوابت,
                                &النهايات_النشطة, &المجال, ثابت, ثابت.القيمة, خطأ
                            )
                        ) {
                            المختار := اختياري.موجود(ثابت);
                            فهرس_المختار := اختياري.موجود(ثابت.القيمة);
                        } وإلا {
                            أرجع نتيجة_تخصيص.فشل_قيود(المجال.السجل);
                        };
                    }
                    | اختياري.لا_شيء -> {
                        طابق سجل_مربوط_مخصص_مباشر(&المجال, &التعيينات) مع
                        | اختياري.موجود(مربوط) -> {
                            إذا (
                                مربوط.القيمة < (الطول(النهايات_النشطة) مثل طبيعي)
                                && مرشح_متاح_خطي(
                                    &المجالات, &الجدول, &مؤشرات_الثوابت,
                                    &النهايات_النشطة, &المجال, مربوط, مربوط.القيمة, صواب
                                )
                            ) {
                                المختار := اختياري.موجود(مربوط);
                                فهرس_المختار := اختياري.موجود(مربوط.القيمة);
                            } وإلا {
                                أرجع نتيجة_تخصيص.فشل_قيود(المجال.السجل);
                            };
                        }
                        | اختياري.لا_شيء -> {
                            دع ر: متغير طبيعي = 0;
                            طالما (ر < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
                                دع المرشح: سجل_فعلي_متاح = (*المسألة).السجلات_المتاحة[ر];
                                دع صحيح_الفئة: متغير منطقي = صواب;
                                طابق المجال.الفئة مع
                                | اختياري.موجود(الفئة) -> {
                                    صحيح_الفئة := معرفا_فئة_تخصيص_متساويان(الفئة, المرشح.الفئة);
                                }
                                | اختياري.لا_شيء -> { };
                                إذا (
                                    صحيح_الفئة
                                    && مرشح_متاح_خطي(
                                        &المجالات, &الجدول, &مؤشرات_الثوابت,
                                        &النهايات_النشطة, &المجال, المرشح.المعرف, المرشح.المعرف.القيمة, صواب
                                    )
                                ) {
                                    المختار := اختياري.موجود(المرشح.المعرف);
                                    فهرس_المختار := اختياري.موجود(المرشح.المعرف.القيمة);
                                    ر := الطول((*المسألة).السجلات_المتاحة) مثل طبيعي;
                                } وإلا {
                                    ر := ر + 1;
                                };
                            }
                        };
                    };
                    طابق المختار مع
                    | اختياري.موجود(فعلي) -> {
                        التعيينات[المجال.السجل.القيمة] := اختياري.موجود(فعلي);
                        طابق فهرس_المختار مع
                        | اختياري.موجود(فهرس) -> {
                            النهايات_النشطة[فهرس] := اختياري.موجود(المجال.النهاية);
                        }
                        | اختياري.لا_شيء -> { أرجع نتيجة_تخصيص.فشل_قيود(المجال.السجل); };
                    }
                    | اختياري.لا_شيء -> {
                        دع السبب: سبب_حاجة_انسكاب = {
                            السجل: المجال.السجل,
                            عند_الموضع: المجال.البداية
                        };
                        أرجع نتيجة_تخصيص.يحتاج_انسكاب(السبب);
                    };
                };
                ف := ف + 1;
            }
            المرحلة := المرحلة + 1;
        }
        موضع := موضع + 1;
    }
    أرجع نتيجة_تخصيص.مخصص(اجمع_تعيينات_مباشرة(&التعيينات));
}


// The position in السجلات_المتاحة of the physical register numbered الفهرس.
عرف موقع_السجل_المتاح(المسألة: &مسألة_تخصيص, الفهرس: طبيعي): طبيعي {
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
        إذا ((*المسألة).السجلات_المتاحة[ر].المعرف.القيمة == الفهرس) { أرجع ر; };
        ر := ر + 1;
    }
    أرجع 0;
}

// Spill costs: each virtual register's uses and definitions (instruction
// operands and edge moves), each weighted by the loop depth of its position
// (8 per level, up to three), as a spilled register pays a reload or store
// at each of them. Loops are the position ranges a backward CFG edge spans
// in the flat order (the selected blocks are laid out in MSIR order, where a
// loop's body follows its header).
عرف وزن_عمق_حلقة(العمق: طبيعي): طبيعي {
    إذا (العمق == 0) { أرجع 1; };
    إذا (العمق == 1) { أرجع 8; };
    إذا (العمق == 2) { أرجع 64; };
    أرجع 512;
}

عرف احسب_كلف_الانسكاب(المسألة: &مسألة_تخصيص): متجه طبيعي {
    دع عدد_المواضع: طبيعي = الطول((*المسألة).التعليمات) مثل طبيعي;
    دع الفروق: متغير متجه عدد = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف <= عدد_المواضع) { ألحق(الفروق, 0); ف := ف + 1; }
    // Block identity -> its fact index.
    دع أقصى: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول((*المسألة).الكتل) مثل طبيعي)) {
        إذا ((*المسألة).الكتل[ف].المعرف.القيمة + 1 > أقصى) { أقصى := (*المسألة).الكتل[ف].المعرف.القيمة + 1; };
        ف := ف + 1;
    }
    دع فهرس_الكتلة: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < أقصى) { ألحق(فهرس_الكتلة, 0); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*المسألة).الكتل) مثل طبيعي)) {
        فهرس_الكتلة[(*المسألة).الكتل[ف].المعرف.القيمة] := ف;
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*المسألة).نقلات_الحواف) مثل طبيعي)) {
        دع المنطلق: طبيعي = (*المسألة).نقلات_الحواف[ف].من_كتلة.القيمة;
        دع المقصد: طبيعي = (*المسألة).نقلات_الحواف[ف].إلى_كتلة.القيمة;
        إذا (المنطلق < أقصى && المقصد < أقصى) {
            دع كتلة_من: &حقيقة_كتلة_تخصيص = &(*المسألة).الكتل[فهرس_الكتلة[المنطلق]];
            دع كتلة_إلى: &حقيقة_كتلة_تخصيص = &(*المسألة).الكتل[فهرس_الكتلة[المقصد]];
            إذا ((*كتلة_إلى).البداية <= (*كتلة_من).البداية && (*كتلة_من).النهاية <= عدد_المواضع) {
                الفروق[(*كتلة_إلى).البداية] := الفروق[(*كتلة_إلى).البداية] + 1;
                الفروق[(*كتلة_من).النهاية] := الفروق[(*كتلة_من).النهاية] - 1;
            };
        };
        ف := ف + 1;
    }
    دع الأوزان: متغير متجه طبيعي = [];
    دع العمق: متغير عدد = 0;
    ف := 0;
    طالما (ف < عدد_المواضع) {
        العمق := العمق + الفروق[ف];
        دع ع: متغير طبيعي = 0;
        إذا (العمق > 0) { ع := العمق مثل طبيعي; };
        ألحق(الأوزان, وزن_عمق_حلقة(ع));
        ف := ف + 1;
    }
    دع الكلف: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (*المسألة).عدد_السجلات_الافتراضية) { ألحق(الكلف, 0); ف := ف + 1; }
    ف := 0;
    طالما (ف < عدد_المواضع) {
        دع الحقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[ف];
        دع الوزن: طبيعي = الأوزان[ف];
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*الحقيقة).الاستخدامات) مثل طبيعي)) {
            دع س: طبيعي = (*الحقيقة).الاستخدامات[ع].السجل.القيمة;
            إذا (س < (الطول(الكلف) مثل طبيعي)) { الكلف[س] := الكلف[س] + الوزن; };
            ع := ع + 1;
        }
        ع := 0;
        طالما (ع < (الطول((*الحقيقة).التعريفات) مثل طبيعي)) {
            دع س: طبيعي = (*الحقيقة).التعريفات[ع].السجل.القيمة;
            إذا (س < (الطول(الكلف) مثل طبيعي)) { الكلف[س] := الكلف[س] + الوزن; };
            ع := ع + 1;
        }
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*المسألة).نقلات_الحواف) مثل طبيعي)) {
        دع المنطلق: طبيعي = (*المسألة).نقلات_الحواف[ف].من_كتلة.القيمة;
        دع الوزن: متغير طبيعي = 1;
        إذا (المنطلق < أقصى) {
            دع نهاية: طبيعي = (*المسألة).الكتل[فهرس_الكتلة[المنطلق]].النهاية;
            إذا (نهاية > 0 && نهاية <= عدد_المواضع) { الوزن := الأوزان[نهاية - 1]; };
        };
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول((*المسألة).نقلات_الحواف[ف].النقلات) مثل طبيعي)) {
            دع م: طبيعي = (*المسألة).نقلات_الحواف[ف].النقلات[ن].المصدر.السجل.القيمة;
            دع و: طبيعي = (*المسألة).نقلات_الحواف[ف].النقلات[ن].الوجهة.السجل.القيمة;
            إذا (م < (الطول(الكلف) مثل طبيعي)) { الكلف[م] := الكلف[م] + الوزن; };
            إذا (و < (الطول(الكلف) مثل طبيعي)) { الكلف[و] := الكلف[و] + الوزن; };
            ن := ن + 1;
        }
        ف := ف + 1;
    }
    أرجع الكلف;
}

// The spill cost of an interval per position it spans (scaled): spilling the
// lowest frees a register for the longest stretch at the least reload cost.
عرف كثافة_انسكاب(المجالات: &متجه مجال_حياة_سجل, الكلف: &متجه طبيعي, السجل: طبيعي): طبيعي {
    دع الكلفة: متغير طبيعي = 0;
    إذا (السجل < (الطول(*الكلف) مثل طبيعي)) { الكلفة := (*الكلف)[السجل]; };
    دع الطول_: طبيعي = (*المجالات)[السجل].النهاية - (*المجالات)[السجل].البداية + 1;
    أرجع (الكلفة * 1024) / الطول_;
}

// The register whose current (unfixed, unbound) interval is cheapest to
// spill, when it is cheaper than the interval being allocated, among the
// registers that interval could use if that one were spilled.
عرف اختر_شاغلا_للانسكاب(
    المسألة: &مسألة_تخصيص,
    المجالات: &متجه مجال_حياة_سجل,
    الجدول: &جدول_تخصيص_خطي,
    مؤشرات_الثوابت: &متجه طبيعي,
    النهايات_النشطة: &متجه اختياري طبيعي,
    الشاغلون: &متجه اختياري معرف_سجل_افتراضي,
    الكلف: &متجه طبيعي,
    المجال: &مجال_حياة_سجل
): اختياري طبيعي {
    إذا ((الطول((*المجال).السجلات_المربوطة) مثل طبيعي) != 0) { أرجع اختياري.لا_شيء(); };
    دع الأفضل: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع أدنى_كثافة: متغير طبيعي = كثافة_انسكاب(المجالات, الكلف, (*المجال).السجل.القيمة);
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
        دع المرشح: سجل_فعلي_متاح = (*المسألة).السجلات_المتاحة[ر];
        دع الفهرس: طبيعي = المرشح.المعرف.القيمة;
        دع صحيح_الفئة: متغير منطقي = صواب;
        طابق (*المجال).الفئة مع
        | اختياري.موجود(الفئة) -> { صحيح_الفئة := معرفا_فئة_تخصيص_متساويان(الفئة, المرشح.الفئة); }
        | اختياري.لا_شيء -> { };
        إذا (صحيح_الفئة && الفهرس < (الطول(*الشاغلون) مثل طبيعي)
            && !مفسد_داخل_المجال(المجال, المرشح.المعرف)
            && !محجوز_بثابت_قادم(المجالات, الجدول, مؤشرات_الثوابت, الفهرس, المجال)) {
            طابق (*الشاغلون)[الفهرس] مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الشاغل) -> {
                دع مرجع_الشاغل: &مجال_حياة_سجل = &(*المجالات)[الشاغل.القيمة];
                دع ثابت_الشاغل: متغير منطقي = خطأ;
                طابق (*مرجع_الشاغل).ثابت مع
                | اختياري.موجود(_) -> { ثابت_الشاغل := صواب; }
                | اختياري.لا_شيء -> { };
                دع مربوط_الشاغل: منطقي = (الطول((*مرجع_الشاغل).السجلات_المربوطة) مثل طبيعي) != 0;
                طابق (*النهايات_النشطة)[الفهرس] مع
                | اختياري.موجود(النهاية) -> {
                    دع الكثافة: طبيعي = كثافة_انسكاب(المجالات, الكلف, الشاغل.القيمة);
                    إذا (!ثابت_الشاغل && !مربوط_الشاغل && الكثافة < أدنى_كثافة
                        && النهاية == (*مرجع_الشاغل).النهاية) {
                        أدنى_كثافة := الكثافة;
                        الأفضل := اختياري.موجود(الفهرس);
                    };
                }
                | اختياري.لا_شيء -> { };
            };
        };
        ر := ر + 1;
    }
    أرجع الأفضل;
}

// Copy coalescing hints: the source of the move that defines each virtual
// register (source + 1, 0 for none) and that move's position. A register
// defined by a move first tries its source's physical register, so the move
// disappears; an instruction move may share it even when the source's last
// use is that move itself (a move reads before it writes). Edge moves into
// block parameters hint too, at no shared position.
نوع تلميحات_نقل_تخصيص = {
    المصدر: متجه طبيعي,
    الموضع: متجه طبيعي,
    // Whether the hint's position may be shared (an instruction move).
    مشترك: متجه منطقي,
    // The physical register (+ 1, 0 for none) an instruction reading the
    // register would rather find it in (a call argument's ABI register).
    المفضل: متجه طبيعي
};

عرف ابن_تلميحات_نقل_تخصيص(المسألة: &مسألة_تخصيص): تلميحات_نقل_تخصيص {
    دع العدد: طبيعي = (*المسألة).عدد_السجلات_الافتراضية;
    دع المصدر: متغير متجه طبيعي = [];
    دع الموضع: متغير متجه طبيعي = [];
    دع مشترك: متغير متجه منطقي = [];
    دع المفضل: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(المصدر, 0); ألحق(الموضع, 0); ألحق(مشترك, خطأ); ألحق(المفضل, 0); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*المسألة).التعليمات) مثل طبيعي)) {
        طابق (*المسألة).التعليمات[ف].نقل_مفضل مع
        | اختياري.موجود(النقل) -> {
            إذا (النقل.الثاني.القيمة < العدد && المصدر[النقل.الثاني.القيمة] == 0) {
                المصدر[النقل.الثاني.القيمة] := النقل.الأول.القيمة + 1;
                الموضع[النقل.الثاني.القيمة] := (*المسألة).التعليمات[ف].الموضع;
                مشترك[النقل.الثاني.القيمة] := صواب;
            };
        }
        | اختياري.لا_شيء -> { };
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول((*المسألة).التعليمات[ف].سجلات_مفضلة) مثل طبيعي)) {
            دع التفضيل: تفضيل_سجل_تخصيص = (*المسألة).التعليمات[ف].سجلات_مفضلة[م];
            إذا (التفضيل.السجل.القيمة < العدد && المفضل[التفضيل.السجل.القيمة] == 0) {
                المفضل[التفضيل.السجل.القيمة] := التفضيل.الفعلي.القيمة + 1;
            };
            م := م + 1;
        }
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*المسألة).نقلات_الحواف) مثل طبيعي)) {
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول((*المسألة).نقلات_الحواف[ف].النقلات) مثل طبيعي)) {
            دع الوجهة: طبيعي = (*المسألة).نقلات_الحواف[ف].النقلات[ن].الوجهة.السجل.القيمة;
            إذا (الوجهة < العدد && المصدر[الوجهة] == 0) {
                المصدر[الوجهة] := (*المسألة).نقلات_الحواف[ف].النقلات[ن].المصدر.السجل.القيمة + 1;
            };
            ن := ن + 1;
        }
        ف := ف + 1;
    }
    دع الناتج: تلميحات_نقل_تخصيص = { المصدر: المصدر, الموضع: الموضع, مشترك: مشترك, المفضل: المفضل };
    أرجع الناتج;
}

// The hinted register for المجال, when it may take it: the register its
// move source holds, free over the interval (or held by that source up to
// the shared move only), not clobbered inside it and not reserved by an
// upcoming fixed interval.
عرف سجل_تلميح_متاح(
    المسألة: &مسألة_تخصيص,
    المجالات: &متجه مجال_حياة_سجل,
    الجدول: &جدول_تخصيص_خطي,
    مؤشرات_الثوابت: &متجه طبيعي,
    النهايات_النشطة: &متجه اختياري طبيعي,
    الشاغلون: &متجه اختياري معرف_سجل_افتراضي,
    التعيينات: &متجه اختياري معرف_سجل_فعلي,
    التلميحات: &تلميحات_نقل_تخصيص,
    المجال: &مجال_حياة_سجل
): اختياري معرف_سجل_فعلي {
    دع السجل: طبيعي = (*المجال).السجل.القيمة;
    إذا (السجل >= (الطول((*التلميحات).المصدر) مثل طبيعي) || (*التلميحات).المصدر[السجل] == 0) {
        أرجع اختياري.لا_شيء();
    };
    دع المصدر: طبيعي = (*التلميحات).المصدر[السجل] - 1;
    إذا (المصدر >= (الطول(*التعيينات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*التعيينات)[المصدر] مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الفعلي) -> {
        دع الفهرس: طبيعي = الفعلي.القيمة;
        إذا (الفهرس >= (الطول(*النهايات_النشطة) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        // Only a register of the interval's class.
        دع في_الفئة: متغير منطقي = خطأ;
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
            إذا ((*المسألة).السجلات_المتاحة[ر].المعرف.القيمة == الفهرس) {
                طابق (*المجال).الفئة مع
                | اختياري.موجود(الفئة) -> {
                    في_الفئة := معرفا_فئة_تخصيص_متساويان(الفئة, (*المسألة).السجلات_المتاحة[ر].الفئة);
                }
                | اختياري.لا_شيء -> { في_الفئة := صواب; };
            };
            ر := ر + 1;
        }
        إذا (!في_الفئة) { أرجع اختياري.لا_شيء(); };
        إذا (مفسد_داخل_المجال(المجال, الفعلي)) { أرجع اختياري.لا_شيء(); };
        طابق (*النهايات_النشطة)[الفهرس] مع
        | اختياري.موجود(النهاية) -> {
            إذا (النهاية >= (*المجال).البداية) {
                // The register is still the source's, up to the move: the
                // source holds it (it was assigned the register) and its
                // interval ends exactly there, so no other interval does.
                دع مشاركة: منطقي = (*التلميحات).مشترك[السجل]
                    && النهاية == (*المجال).البداية
                    && (*التلميحات).الموضع[السجل] == (*المجال).البداية
                    && المصدر < (الطول(*المجالات) مثل طبيعي)
                    && (*المجالات)[المصدر].النهاية == (*المجال).البداية;
                إذا (!مشاركة) { أرجع اختياري.لا_شيء(); };
            };
        }
        | اختياري.لا_شيء -> { };
        // The next fixed interval on the register, skipping the source itself
        // (a fixed ABI holder whose last use is this move).
        إذا (الفهرس < عدد_فعلية_جدول_خطي(الجدول)) {
            دع الموضع: متغير طبيعي = (*مؤشرات_الثوابت)[الفهرس];
            دع العدد: طبيعي = عدد_ثوابت_الفعلي(الجدول, الفهرس);
            إذا (الموضع < العدد && ثابت_الفعلي_عند(الجدول, الفهرس, الموضع).القيمة == المصدر) {
                الموضع := الموضع + 1;
            };
            إذا (الموضع < العدد) {
                دع الثابت: معرف_سجل_افتراضي = ثابت_الفعلي_عند(الجدول, الفهرس, الموضع);
                إذا ((*المجالات)[الثابت.القيمة].البداية <= (*المجال).النهاية
                    && (*المجال).البداية <= (*المجالات)[الثابت.القيمة].النهاية) {
                    أرجع اختياري.لا_شيء();
                };
            };
        };
        أرجع اختياري.موجود(الفعلي);
    };
}

// ---- Allocation over lifetime segments ----
// Linear scan as above, but a register holds a list of the segments its
// values occupy (Traub, Holloway and Smith's second-chance binpacking without
// the splitting; Wimmer and Mössenböck's lifetime holes): a value takes a
// register when none of its segments meets one already there, so a value
// defined at a loop's top and read at the start of each arm of a large
// dispatch leaves the register free in each arm after its last read, and a
// value of one arm that lives across a call may take it there. Fixed values
// (ABI registers) enter their registers' lists before the scan, so later
// fixed values are respected without looking ahead. A value never changes
// location: the lowering is unchanged.

// One register's occupied segments, sorted by start: pairs of positions
// and the owner of each pair.
نوع حجوزات_سجل_مقاطع = {
    المقاطع: متجه طبيعي,
    المالكون: متجه طبيعي
};

// Whether الثانية (sorted pairs) meets any segment in الحجوزات, other than
// one of المسموح (+ 1; 0 for none) ending exactly at the position
// المشترك (a move hint's shared position).
عرف مقاطع_تتقاطع(
    الحجوزات: &حجوزات_سجل_مقاطع,
    الثانية: &متجه طبيعي,
    المسموح: طبيعي,
    المشترك: طبيعي
): منطقي {
    دع أ: متغير طبيعي = 0;
    دع ب: متغير طبيعي = 0;
    دع عدد_أ: طبيعي = الطول((*الحجوزات).المقاطع) مثل طبيعي;
    دع عدد_ب: طبيعي = الطول(*الثانية) مثل طبيعي;
    طالما (أ < عدد_أ && ب < عدد_ب) {
        دع بداية_أ: طبيعي = (*الحجوزات).المقاطع[أ];
        دع نهاية_أ: طبيعي = (*الحجوزات).المقاطع[أ + 1];
        دع بداية_ب: طبيعي = (*الثانية)[ب];
        دع نهاية_ب: طبيعي = (*الثانية)[ب + 1];
        إذا (نهاية_أ < بداية_ب) { أ := أ + 2; }
        وإلا إذا (نهاية_ب < بداية_أ) { ب := ب + 2; }
        وإلا {
            دع مسموح: منطقي = المسموح != 0 && (*الحجوزات).المالكون[أ / 2] + 1 == المسموح
                && نهاية_أ == المشترك && بداية_ب == المشترك;
            إذا (!مسموح) { أرجع صواب; };
            أ := أ + 2;
        };
    }
    أرجع خطأ;
}

// The owners (one each) of the segments in الحجوزات that meet الثانية.
عرف مالكو_التقاطع(الحجوزات: &حجوزات_سجل_مقاطع, الثانية: &متجه طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع أ: متغير طبيعي = 0;
    دع ب: متغير طبيعي = 0;
    دع عدد_أ: طبيعي = الطول((*الحجوزات).المقاطع) مثل طبيعي;
    دع عدد_ب: طبيعي = الطول(*الثانية) مثل طبيعي;
    طالما (أ < عدد_أ && ب < عدد_ب) {
        دع نهاية_أ: طبيعي = (*الحجوزات).المقاطع[أ + 1];
        دع نهاية_ب: طبيعي = (*الثانية)[ب + 1];
        إذا (نهاية_أ < (*الثانية)[ب]) { أ := أ + 2; }
        وإلا إذا (نهاية_ب < (*الحجوزات).المقاطع[أ]) { ب := ب + 2; }
        وإلا {
            دع المالك: طبيعي = (*الحجوزات).المالكون[أ / 2];
            دع موجود: متغير منطقي = خطأ;
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(الناتج) مثل طبيعي)) { إذا (الناتج[م] == المالك) { موجود := صواب; }; م := م + 1; }
            إذا (!موجود) { ألحق(الناتج, المالك); };
            أ := أ + 2;
        };
    }
    أرجع الناتج;
}

// Merges a value's segments into a register's list.
عرف احجز_مقاطع(الحجوزات: &متغير حجوزات_سجل_مقاطع, المقاطع: &متجه طبيعي, المالك: طبيعي): فراغ {
    دع الجديدة: متغير متجه طبيعي = [];
    دع المالكون: متغير متجه طبيعي = [];
    دع أ: متغير طبيعي = 0;
    دع ب: متغير طبيعي = 0;
    دع عدد_أ: طبيعي = الطول((*الحجوزات).المقاطع) مثل طبيعي;
    دع عدد_ب: طبيعي = الطول(*المقاطع) مثل طبيعي;
    طالما (أ < عدد_أ || ب < عدد_ب) {
        إذا (ب >= عدد_ب || (أ < عدد_أ && (*الحجوزات).المقاطع[أ] <= (*المقاطع)[ب])) {
            ألحق(الجديدة, (*الحجوزات).المقاطع[أ]);
            ألحق(الجديدة, (*الحجوزات).المقاطع[أ + 1]);
            ألحق(المالكون, (*الحجوزات).المالكون[أ / 2]);
            أ := أ + 2;
        } وإلا {
            ألحق(الجديدة, (*المقاطع)[ب]);
            ألحق(الجديدة, (*المقاطع)[ب + 1]);
            ألحق(المالكون, المالك);
            ب := ب + 2;
        };
    }
    (*الحجوزات).المقاطع := الجديدة;
    (*الحجوزات).المالكون := المالكون;
}

// Drops a value's segments from a register's list.
عرف حرر_مقاطع(الحجوزات: &متغير حجوزات_سجل_مقاطع, المالك: طبيعي): فراغ {
    دع الجديدة: متغير متجه طبيعي = [];
    دع المالكون: متغير متجه طبيعي = [];
    دع أ: متغير طبيعي = 0;
    طالما (أ < (الطول((*الحجوزات).المقاطع) مثل طبيعي)) {
        إذا ((*الحجوزات).المالكون[أ / 2] != المالك) {
            ألحق(الجديدة, (*الحجوزات).المقاطع[أ]);
            ألحق(الجديدة, (*الحجوزات).المقاطع[أ + 1]);
            ألحق(المالكون, (*الحجوزات).المالكون[أ / 2]);
        };
        أ := أ + 2;
    }
    (*الحجوزات).المقاطع := الجديدة;
    (*الحجوزات).المالكون := المالكون;
}

// Drops the segments that end before الموضع: no value from here on starts
// before it.
عرف قلم_مقاطع(الحجوزات: &متغير حجوزات_سجل_مقاطع, الموضع: طبيعي): فراغ {
    دع العدد: طبيعي = الطول((*الحجوزات).المقاطع) مثل طبيعي;
    // The segments in one register do not overlap (but at a move's shared
    // position), so their ends rise with their starts: the ones that end
    // before الموضع are a prefix.
    إذا (العدد == 0 || (*الحجوزات).المقاطع[1] >= الموضع) { أرجع; };
    دع الجديدة: متغير متجه طبيعي = [];
    دع المالكون: متغير متجه طبيعي = [];
    دع أ: متغير طبيعي = 0;
    طالما (أ < العدد) {
        إذا ((*الحجوزات).المقاطع[أ + 1] >= الموضع) {
            ألحق(الجديدة, (*الحجوزات).المقاطع[أ]);
            ألحق(الجديدة, (*الحجوزات).المقاطع[أ + 1]);
            ألحق(المالكون, (*الحجوزات).المالكون[أ / 2]);
        };
        أ := أ + 2;
    }
    (*الحجوزات).المقاطع := الجديدة;
    (*الحجوزات).المالكون := المالكون;
}

// The positions a value is live at (the sum of its segments).
عرف طول_مقاطع(المقاطع: &متجه طبيعي): طبيعي {
    دع الطول_: متغير طبيعي = 0;
    دع أ: متغير طبيعي = 0;
    طالما (أ + 1 < (الطول(*المقاطع) مثل طبيعي)) {
        الطول_ := الطول_ + (*المقاطع)[أ + 1] - (*المقاطع)[أ] + 1;
        أ := أ + 2;
    }
    أرجع الطول_;
}

عرف كثافة_مقاطع(المجالات: &متجه مجال_حياة_سجل, الكلف: &متجه طبيعي, السجل: طبيعي): طبيعي {
    دع الكلفة: متغير طبيعي = 0;
    إذا (السجل < (الطول(*الكلف) مثل طبيعي)) { الكلفة := (*الكلف)[السجل]; };
    دع الطول_: متغير طبيعي = طول_مقاطع(&(*المجالات)[السجل].المقاطع);
    إذا (الطول_ == 0) { الطول_ := 1; };
    أرجع (الكلفة * 1024) / الطول_;
}

// Whether the physical register المرشح of the class الفئة may hold المجال.
عرف فئة_مرشح_مقاطع(المجال: &مجال_حياة_سجل, المرشح: &سجل_فعلي_متاح): منطقي {
    طابق (*المجال).الفئة مع
    | اختياري.موجود(الفئة) -> { أرجع معرفا_فئة_تخصيص_متساويان(الفئة, (*المرشح).الفئة); }
    | اختياري.لا_شيء -> { أرجع صواب; };
}

// The live positions of every virtual register, for the debug-information
// owner (allocation_contract.sn, خطة_تخصيص_مع_انسكاب.مقاطع_الحياة).
عرف مقاطع_حياة_المجالات(المجالات: &متجه مجال_حياة_سجل): متجه متجه طبيعي {
    دع الناتج: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المجالات) مثل طبيعي)) {
        دع المقاطع: متغير متجه طبيعي = [];
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول((*المجالات)[ف].المقاطع) مثل طبيعي)) {
            ألحق(المقاطع, (*المجالات)[ف].المقاطع[م]);
            م := م + 1;
        }
        ألحق(الناتج, المقاطع);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف خصص_السجلات_بالمقاطع(المسألة: &مسألة_تخصيص): نتيجة_تخصيص_مع_انسكاب {
    دع المجالات: متغير متجه مجال_حياة_سجل = حلل_مجالات_الحياة(المسألة);
    دع الجدول: جدول_تخصيص_خطي = ابن_جدول_تخصيص_خطي(المسألة, &المجالات);
    دع التعيينات: متغير متجه اختياري معرف_سجل_فعلي = ابن_خيارات_سجلات_فعلية(
        (*المسألة).عدد_السجلات_الافتراضية
    );
    دع عدد_الفعلية: طبيعي = عدد_السجلات_الفعلية_المتابعة(المسألة, &المجالات);
    دع الحجوزات: متغير متجه حجوزات_سجل_مقاطع = [];
    دع ش: متغير طبيعي = 0;
    طالما (ش < عدد_الفعلية) {
        دع بلا_مقاطع: متجه طبيعي = [];
        دع بلا_مالكين: متجه طبيعي = [];
        دع الفارغة: حجوزات_سجل_مقاطع = { المقاطع: بلا_مقاطع, المالكون: بلا_مالكين };
        ألحق(الحجوزات, الفارغة);
        ش := ش + 1;
    }
    دع الانسكابات: متغير متجه معرف_سجل_افتراضي = [];
    دع التلميحات: تلميحات_نقل_تخصيص = ابن_تلميحات_نقل_تخصيص(المسألة);
    دع الكلف: متجه طبيعي = احسب_كلف_الانسكاب(المسألة);
    // Fixed values first, in their registers.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الجدول.المرتبة_بالبداية) مثل طبيعي)) {
        دع المعرف: معرف_سجل_افتراضي = الجدول.المرتبة_بالبداية[ف];
        دع مرجع_الثابت: &مجال_حياة_سجل = &المجالات[المعرف.القيمة];
        طابق (*مرجع_الثابت).ثابت مع
        | اختياري.موجود(الثابت) -> {
            إذا (الثابت.القيمة >= عدد_الفعلية
                || مقاطع_تتقاطع(&الحجوزات[الثابت.القيمة], &المجالات[المعرف.القيمة].المقاطع, 0, 0)
                || مفسد_داخل_المجال(&المجالات[المعرف.القيمة], الثابت)) {
                أرجع نتيجة_تخصيص_مع_انسكاب.فشل_قيود(المعرف);
            };
            احجز_مقاطع(&متغير الحجوزات[الثابت.القيمة], &المجالات[المعرف.القيمة].المقاطع, المعرف.القيمة);
            التعيينات[المعرف.القيمة] := اختياري.موجود(الثابت);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع آخر_قلم: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول(الجدول.المرتبة_بالبداية) مثل طبيعي)) {
        دع المعرف: معرف_سجل_افتراضي = الجدول.المرتبة_بالبداية[ف];
        دع مرجع_المجال: &مجال_حياة_سجل = &المجالات[المعرف.القيمة];
        دع المجال: مجال_حياة_سجل = *مرجع_المجال;
        إذا (المجال.تعارض_قيود) {
            أرجع نتيجة_تخصيص_مع_انسكاب.فشل_قيود(المجال.السجل);
        };
        دع ثابت_مسبق: متغير منطقي = خطأ;
        طابق المجال.ثابت مع
        | اختياري.موجود(_) -> { ثابت_مسبق := صواب; }
        | اختياري.لا_شيء -> { };
        // Segments that ended before this start can meet nothing from here.
        إذا (المجال.البداية > آخر_قلم + 64) {
            ش := 0;
            طالما (ش < عدد_الفعلية) { قلم_مقاطع(&متغير الحجوزات[ش], المجال.البداية); ش := ش + 1; }
            آخر_قلم := المجال.البداية;
        };
        إذا (!ثابت_مسبق) {
            دع المختار: متغير اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
            دع مربوط_محسوم: متغير منطقي = خطأ;
            طابق سجل_مربوط_مخصص_مباشر(&المجال, &التعيينات) مع
            | اختياري.موجود(مربوط) -> {
                مربوط_محسوم := صواب;
                إذا (مربوط.القيمة < عدد_الفعلية
                    && !مفسد_داخل_المجال(&المجال, مربوط)
                    && !مقاطع_تتقاطع(&الحجوزات[مربوط.القيمة], &المجال.المقاطع, 0, 0)) {
                    المختار := اختياري.موجود(مربوط);
                } وإلا {
                    أرجع نتيجة_تخصيص_مع_انسكاب.فشل_قيود(المجال.السجل);
                };
            }
            | اختياري.لا_شيء -> { };
            // The move source's register: free, or held by the source up to
            // the shared move only.
            إذا (!مربوط_محسوم) {
                دع السجل: طبيعي = المجال.السجل.القيمة;
                إذا (السجل < (الطول(التلميحات.المصدر) مثل طبيعي) && التلميحات.المصدر[السجل] != 0) {
                    دع المصدر: طبيعي = التلميحات.المصدر[السجل] - 1;
                    إذا (المصدر < (الطول(التعيينات) مثل طبيعي)) {
                        طابق التعيينات[المصدر] مع
                        | اختياري.موجود(الفعلي) -> {
                            دع المسموح: متغير طبيعي = 0;
                            إذا (التلميحات.مشترك[السجل] && التلميحات.الموضع[السجل] == المجال.البداية) {
                                المسموح := المصدر + 1;
                            };
                            دع ر: متغير طبيعي = 0;
                            طالما (ر < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
                                دع المرشح: سجل_فعلي_متاح = (*المسألة).السجلات_المتاحة[ر];
                                إذا (المرشح.المعرف.القيمة == الفعلي.القيمة && الفعلي.القيمة < عدد_الفعلية
                                    && فئة_مرشح_مقاطع(&المجال, &المرشح)
                                    && !مفسد_داخل_المجال(&المجال, الفعلي)
                                    && !مقاطع_تتقاطع(&الحجوزات[الفعلي.القيمة], &المجال.المقاطع, المسموح, المجال.البداية)) {
                                    المختار := اختياري.موجود(الفعلي);
                                };
                                ر := ر + 1;
                            }
                        }
                        | اختياري.لا_شيء -> { };
                    };
                };
                // Then the register an instruction would rather read it from.
                طابق المختار مع
                | اختياري.لا_شيء -> {
                    إذا (السجل < (الطول(التلميحات.المفضل) مثل طبيعي) && التلميحات.المفضل[السجل] != 0) {
                        دع المفضل: طبيعي = التلميحات.المفضل[السجل] - 1;
                        دع ر: متغير طبيعي = 0;
                        طالما (ر < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
                            دع المرشح: سجل_فعلي_متاح = (*المسألة).السجلات_المتاحة[ر];
                            إذا (المرشح.المعرف.القيمة == المفضل && المفضل < عدد_الفعلية
                                && فئة_مرشح_مقاطع(&المجال, &المرشح)
                                && !مفسد_داخل_المجال(&المجال, المرشح.المعرف)
                                && !مقاطع_تتقاطع(&الحجوزات[المفضل], &المجال.المقاطع, 0, 0)) {
                                المختار := اختياري.موجود(المرشح.المعرف);
                            };
                            ر := ر + 1;
                        }
                    };
                }
                | اختياري.موجود(_) -> { };
                // Then the first free register of its class.
                دع ر: متغير طبيعي = 0;
                طالما (ر < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
                    طابق المختار مع
                    | اختياري.موجود(_) -> { ر := الطول((*المسألة).السجلات_المتاحة) مثل طبيعي; }
                    | اختياري.لا_شيء -> {
                        دع المرشح: سجل_فعلي_متاح = (*المسألة).السجلات_المتاحة[ر];
                        دع الفهرس: طبيعي = المرشح.المعرف.القيمة;
                        إذا (الفهرس < عدد_الفعلية && فئة_مرشح_مقاطع(&المجال, &المرشح)
                            && !مفسد_داخل_المجال(&المجال, المرشح.المعرف)
                            && !مقاطع_تتقاطع(&الحجوزات[الفهرس], &المجال.المقاطع, 0, 0)) {
                            المختار := اختياري.موجود(المرشح.المعرف);
                        };
                        ر := ر + 1;
                    };
                }
                // No free register: spill the cheapest (per position) of
                // this value and a value it alone meets in a register.
                طابق المختار مع
                | اختياري.لا_شيء -> {
                    إذا ((الطول(المجال.السجلات_المربوطة) مثل طبيعي) == 0) {
                        دع أدنى_كثافة: متغير طبيعي = كثافة_مقاطع(&المجالات, &الكلف, السجل);
                        دع كلفة_المجال: متغير طبيعي = 0;
                        إذا (السجل < (الطول(الكلف) مثل طبيعي)) { كلفة_المجال := الكلف[السجل]; };
                        دع الأفضل: متغير اختياري طبيعي = اختياري.لا_شيء();
                        دع الشاغل_الأفضل: متغير طبيعي = 0;
                        ر := 0;
                        طالما (ر < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
                            دع المرشح: سجل_فعلي_متاح = (*المسألة).السجلات_المتاحة[ر];
                            دع الفهرس: طبيعي = المرشح.المعرف.القيمة;
                            إذا (الفهرس < عدد_الفعلية && فئة_مرشح_مقاطع(&المجال, &المرشح)
                                && !مفسد_داخل_المجال(&المجال, المرشح.المعرف)) {
                                دع المالكون: متجه طبيعي = مالكو_التقاطع(&الحجوزات[الفهرس], &المجال.المقاطع);
                                إذا ((الطول(المالكون) مثل طبيعي) == 1) {
                                    دع الشاغل: طبيعي = المالكون[0];
                                    دع مرجع_الشاغل: &مجال_حياة_سجل = &المجالات[الشاغل];
                                    دع ثابت_الشاغل: متغير منطقي = خطأ;
                                    طابق (*مرجع_الشاغل).ثابت مع
                                    | اختياري.موجود(_) -> { ثابت_الشاغل := صواب; }
                                    | اختياري.لا_شيء -> { };
                                    دع مربوط_الشاغل: منطقي = (الطول((*مرجع_الشاغل).السجلات_المربوطة) مثل طبيعي) != 0;
                                    دع الكثافة: طبيعي = كثافة_مقاطع(&المجالات, &الكلف, الشاغل);
                                    // Not for a value that costs over 16 times as much
                                    // in all: a short value of one arm of a large loop
                                    // must not push a value the loop carries to memory
                                    // everywhere.
                                    دع كلفة_الشاغل: طبيعي = الكلف[الشاغل];
                                    إذا (!ثابت_الشاغل && !مربوط_الشاغل && الكثافة < أدنى_كثافة
                                        && كلفة_الشاغل <= كلفة_المجال * 16) {
                                        أدنى_كثافة := الكثافة;
                                        الأفضل := اختياري.موجود(ر);
                                        الشاغل_الأفضل := الشاغل;
                                    };
                                };
                            };
                            ر := ر + 1;
                        }
                        طابق الأفضل مع
                        | اختياري.موجود(موقع) -> {
                            دع المرشح: سجل_فعلي_متاح = (*المسألة).السجلات_المتاحة[موقع];
                            حرر_مقاطع(&متغير الحجوزات[المرشح.المعرف.القيمة], الشاغل_الأفضل);
                            التعيينات[الشاغل_الأفضل] := اختياري.لا_شيء();
                            دع المسكوب: معرف_سجل_افتراضي = { القيمة: الشاغل_الأفضل };
                            ألحق(الانسكابات, المسكوب);
                            المختار := اختياري.موجود(المرشح.المعرف);
                        }
                        | اختياري.لا_شيء -> { };
                    };
                }
                | اختياري.موجود(_) -> { };
            };
            طابق المختار مع
            | اختياري.موجود(الفعلي) -> {
                احجز_مقاطع(&متغير الحجوزات[الفعلي.القيمة], &المجال.المقاطع, المجال.السجل.القيمة);
                التعيينات[المجال.السجل.القيمة] := اختياري.موجود(الفعلي);
            }
            | اختياري.لا_شيء -> { ألحق(الانسكابات, المجال.السجل); };
        };
        ف := ف + 1;
    }
    دع التعيينات_النهائية: متجه تعيين_سجل = اجمع_تعيينات_مباشرة(&التعيينات);
    دع الانسكابات_المرتبة: متجه معرف_سجل_افتراضي = رتب_سجلات_افتراضية(&الانسكابات);
    دع الخطة: خطة_تخصيص_مع_انسكاب = {
        التعيينات: التعيينات_النهائية,
        السجلات_المسكوبة: الانسكابات_المرتبة,
        مقاطع_الحياة: مقاطع_حياة_المجالات(&المجالات)
    };
    أرجع نتيجة_تخصيص_مع_انسكاب.مكتمل(الخطة);
}

عام عرف خصص_السجلات_مع_انسكاب(المسألة: &مسألة_تخصيص): نتيجة_تخصيص_مع_انسكاب {
    إذا ((*المسألة).بالمقاطع) { أرجع خصص_السجلات_بالمقاطع(المسألة); };
    دع المجالات: متجه مجال_حياة_سجل = حلل_مجالات_الحياة(المسألة);
    دع الجدول: جدول_تخصيص_خطي = ابن_جدول_تخصيص_خطي(المسألة, &المجالات);
    دع التعيينات: متغير متجه اختياري معرف_سجل_فعلي = ابن_خيارات_سجلات_فعلية(
        (*المسألة).عدد_السجلات_الافتراضية
    );
    دع عدد_الفعلية: طبيعي = عدد_السجلات_الفعلية_المتابعة(المسألة, &المجالات);
    دع النهايات_النشطة: متغير متجه اختياري طبيعي = ابن_خيارات_نهايات(عدد_الفعلية);
    دع مؤشرات_الثوابت: متغير متجه طبيعي = ابن_أصفار(عدد_الفعلية);
    دع الانسكابات: متغير متجه معرف_سجل_افتراضي = [];
    دع التلميحات: تلميحات_نقل_تخصيص = ابن_تلميحات_نقل_تخصيص(المسألة);
    دع الكلف: متجه طبيعي = احسب_كلف_الانسكاب(المسألة);
    // The interval each register holds now (for spilling it instead).
    دع الشاغلون: متغير متجه اختياري معرف_سجل_افتراضي = [];
    دع ش: متغير طبيعي = 0;
    طالما (ش < عدد_الفعلية) { ألحق(الشاغلون, اختياري.لا_شيء()); ش := ش + 1; }

    دع موضع: متغير طبيعي = 0;
    طالما (موضع < عدد_مواضع_جدول_خطي(&الجدول)) {
        حدث_مؤشرات_الثوابت(&المجالات, &الجدول, &متغير مؤشرات_الثوابت, موضع);
        دع المرحلة: متغير طبيعي = 0;
        طالما (المرحلة < 2) {
            دع ف: متغير طبيعي = بداية_مجالات_الموضع(&الجدول, موضع);
            طالما (ف < نهاية_مجالات_الموضع(&الجدول, موضع)) {
                دع المعرف: معرف_سجل_افتراضي = الجدول.المرتبة_بالبداية[ف];
                دع مرجع_المجال: &مجال_حياة_سجل = &المجالات[المعرف.القيمة];
                دع المجال: مجال_حياة_سجل = *مرجع_المجال;
                إذا (المجال.تعارض_قيود) {
                    أرجع نتيجة_تخصيص_مع_انسكاب.فشل_قيود(المجال.السجل);
                };
                دع ثابت_مسبق: متغير منطقي = خطأ;
                طابق المجال.ثابت مع
                | اختياري.موجود(_) -> { ثابت_مسبق := صواب; }
                | اختياري.لا_شيء -> { };
                إذا ((المرحلة == 0 && ثابت_مسبق) || (المرحلة == 1 && !ثابت_مسبق)) {
                    دع المختار: متغير اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
                    دع فهرس_المختار: متغير اختياري طبيعي = اختياري.لا_شيء();
                    طابق المجال.ثابت مع
                    | اختياري.موجود(ثابت) -> {
                        إذا (
                            ثابت.القيمة < (الطول(النهايات_النشطة) مثل طبيعي)
                            && مرشح_متاح_خطي(
                                &المجالات, &الجدول, &مؤشرات_الثوابت,
                                &النهايات_النشطة, &المجال, ثابت, ثابت.القيمة, خطأ
                            )
                        ) {
                            المختار := اختياري.موجود(ثابت);
                            فهرس_المختار := اختياري.موجود(ثابت.القيمة);
                        };
                    }
                    | اختياري.لا_شيء -> {
                        طابق سجل_مربوط_مخصص_مباشر(&المجال, &التعيينات) مع
                        | اختياري.موجود(مربوط) -> {
                            إذا (
                                مربوط.القيمة < (الطول(النهايات_النشطة) مثل طبيعي)
                                && مرشح_متاح_خطي(
                                    &المجالات, &الجدول, &مؤشرات_الثوابت,
                                    &النهايات_النشطة, &المجال, مربوط, مربوط.القيمة, صواب
                                )
                            ) {
                                المختار := اختياري.موجود(مربوط);
                                فهرس_المختار := اختياري.موجود(مربوط.القيمة);
                            };
                        }
                        | اختياري.لا_شيء -> {
                            دع ر: متغير طبيعي = 0;
                            طابق سجل_تلميح_متاح(
                                المسألة, &المجالات, &الجدول, &مؤشرات_الثوابت, &النهايات_النشطة,
                                &الشاغلون, &التعيينات, &التلميحات, &المجال
                            ) مع
                            | اختياري.موجود(الملمح) -> {
                                المختار := اختياري.موجود(الملمح);
                                فهرس_المختار := اختياري.موجود(الملمح.القيمة);
                                ر := الطول((*المسألة).السجلات_المتاحة) مثل طبيعي;
                            }
                            | اختياري.لا_شيء -> {
                                // Then the register an instruction would
                                // rather read it from (a call argument's).
                                دع المفضل: طبيعي = التلميحات.المفضل[المجال.السجل.القيمة];
                                إذا (المفضل != 0) {
                                    دع فهرس_المفضل: طبيعي = المفضل - 1;
                                    دع م: متغير طبيعي = 0;
                                    طالما (م < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
                                        دع المرشح: سجل_فعلي_متاح = (*المسألة).السجلات_المتاحة[م];
                                        دع صحيح_الفئة: متغير منطقي = صواب;
                                        طابق المجال.الفئة مع
                                        | اختياري.موجود(الفئة) -> {
                                            صحيح_الفئة := معرفا_فئة_تخصيص_متساويان(الفئة, المرشح.الفئة);
                                        }
                                        | اختياري.لا_شيء -> { };
                                        إذا (المرشح.المعرف.القيمة == فهرس_المفضل && صحيح_الفئة
                                            && فهرس_المفضل < (الطول(النهايات_النشطة) مثل طبيعي)
                                            && مرشح_متاح_خطي(
                                                &المجالات, &الجدول, &مؤشرات_الثوابت,
                                                &النهايات_النشطة, &المجال, المرشح.المعرف, فهرس_المفضل, صواب
                                            )) {
                                            المختار := اختياري.موجود(المرشح.المعرف);
                                            فهرس_المختار := اختياري.موجود(فهرس_المفضل);
                                            ر := الطول((*المسألة).السجلات_المتاحة) مثل طبيعي;
                                        };
                                        م := م + 1;
                                    }
                                };
                            };
                            طالما (ر < (الطول((*المسألة).السجلات_المتاحة) مثل طبيعي)) {
                                دع المرشح: سجل_فعلي_متاح = (*المسألة).السجلات_المتاحة[ر];
                                دع صحيح_الفئة: متغير منطقي = صواب;
                                طابق المجال.الفئة مع
                                | اختياري.موجود(الفئة) -> {
                                    صحيح_الفئة := معرفا_فئة_تخصيص_متساويان(الفئة, المرشح.الفئة);
                                }
                                | اختياري.لا_شيء -> { };
                                إذا (
                                    صحيح_الفئة
                                    && مرشح_متاح_خطي(
                                        &المجالات, &الجدول, &مؤشرات_الثوابت,
                                        &النهايات_النشطة, &المجال, المرشح.المعرف, المرشح.المعرف.القيمة, صواب
                                    )
                                ) {
                                    المختار := اختياري.موجود(المرشح.المعرف);
                                    فهرس_المختار := اختياري.موجود(المرشح.المعرف.القيمة);
                                    ر := الطول((*المسألة).السجلات_المتاحة) مثل طبيعي;
                                } وإلا {
                                    ر := ر + 1;
                                };
                            }
                        };
                    };
                    // No free register: as Poletto & Sarkar's linear scan, spill
                    // whichever of the current interval and the active ones it
                    // could replace ends last, so a short-lived value is not
                    // spilled while a long one holds the register.
                    طابق المختار مع
                    | اختياري.لا_شيء -> {
                        إذا (!ثابت_مسبق) {
                            طابق اختر_شاغلا_للانسكاب(
                                المسألة, &المجالات, &الجدول, &مؤشرات_الثوابت, &النهايات_النشطة,
                                &الشاغلون, &الكلف, &المجال
                            ) مع
                            | اختياري.لا_شيء -> { }
                            | اختياري.موجود(فهرس_السجل) -> {
                                طابق الشاغلون[فهرس_السجل] مع
                                | اختياري.موجود(الشاغل) -> {
                                    التعيينات[الشاغل.القيمة] := اختياري.لا_شيء();
                                    ألحق(الانسكابات, الشاغل);
                                }
                                | اختياري.لا_شيء -> { };
                                المختار := اختياري.موجود(سجل_فعلي_من_الفهرس(المسألة, موقع_السجل_المتاح(المسألة, فهرس_السجل)));
                                فهرس_المختار := اختياري.موجود(فهرس_السجل);
                            };
                        };
                    }
                    | اختياري.موجود(_) -> { };
                    طابق المختار مع
                    | اختياري.موجود(فعلي) -> {
                        التعيينات[المجال.السجل.القيمة] := اختياري.موجود(فعلي);
                        طابق فهرس_المختار مع
                        | اختياري.موجود(فهرس) -> {
                            النهايات_النشطة[فهرس] := اختياري.موجود(المجال.النهاية);
                            إذا (فهرس < (الطول(الشاغلون) مثل طبيعي)) {
                                إذا (!ثابت_مسبق) {
                                    الشاغلون[فهرس] := اختياري.موجود(المجال.السجل);
                                } وإلا {
                                    الشاغلون[فهرس] := اختياري.لا_شيء();
                                };
                            };
                        }
                        | اختياري.لا_شيء -> { أرجع نتيجة_تخصيص_مع_انسكاب.فشل_قيود(المجال.السجل); };
                    }
                    | اختياري.لا_شيء -> {
                        ألحق(الانسكابات, المجال.السجل);
                    };
                };
                ف := ف + 1;
            }
            المرحلة := المرحلة + 1;
        }
        موضع := موضع + 1;
    }
    دع التعيينات_النهائية: متجه تعيين_سجل = اجمع_تعيينات_مباشرة(&التعيينات);
    دع الانسكابات_المرتبة: متجه معرف_سجل_افتراضي = رتب_سجلات_افتراضية(&الانسكابات);
    دع الخطة: خطة_تخصيص_مع_انسكاب = {
        التعيينات: التعيينات_النهائية,
        السجلات_المسكوبة: الانسكابات_المرتبة,
        مقاطع_الحياة: مقاطع_حياة_المجالات(&المجالات)
    };
    أرجع نتيجة_تخصيص_مع_انسكاب.مكتمل(الخطة);
}
