استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.liveness;
استورد compiler.backend.codegen.virtual_registers;

عرف مفسد_داخل_المجال(
    المجال: &مجال_حياة_سجل,
    المرشح: معرف_سجل_فعلي
): منطقي {
    دع ج: مجال_حياة_سجل = *المجال;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ج.السجلات_المفسدة) مثل غير_موقع)) {
        لو (معرفا_سجل_فعلي_متساويان(ج.السجلات_المفسدة[ف], المرشح)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

نوع جدول_تخصيص_خطي = {
    يبدأ_عند: متجه متجه معرف_سجل_افتراضي,
    الثوابت_حسب_الفعلي: متجه متجه معرف_سجل_افتراضي
};

عرف ابن_خيارات_سجلات_فعلية(العدد: غير_موقع): متجه اختيار معرف_سجل_فعلي {
    دع الناتج: متغير متجه اختيار معرف_سجل_فعلي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, اختيار.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ابن_خيارات_نهايات(العدد: غير_موقع): متجه اختيار غير_موقع {
    دع الناتج: متغير متجه اختيار غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, اختيار.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ابن_أصفار(العدد: غير_موقع): متجه غير_موقع {
    دع الناتج: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, 0);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف عدد_السجلات_الفعلية_المتابعة(
    المسألة: &مسألة_تخصيص,
    المجالات: &متجه مجال_حياة_سجل
): غير_موقع {
    دع م: مسألة_تخصيص = *المسألة;
    دع ج: متجه مجال_حياة_سجل = *المجالات;
    دع العدد: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م.السجلات_المتاحة) مثل غير_موقع)) {
        دع المطلوب: غير_موقع = م.السجلات_المتاحة[ف].المعرف.القيمة + 1;
        لو (المطلوب > العدد) { العدد := المطلوب; };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(ج) مثل غير_موقع)) {
        طابق ج[ف].ثابت مع
        | اختيار.بعض(الثابت) -> {
            دع المطلوب: غير_موقع = الثابت.القيمة + 1;
            لو (المطلوب > العدد) { العدد := المطلوب; };
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف ابن_جدول_تخصيص_خطي(
    المسألة: &مسألة_تخصيص,
    المجالات: &متجه مجال_حياة_سجل
): جدول_تخصيص_خطي {
    دع م: مسألة_تخصيص = *المسألة;
    دع ج: متجه مجال_حياة_سجل = *المجالات;
    دع أقصى_بداية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ج) مثل غير_موقع)) {
        طابق ج[ف].الفئة مع
        | اختيار.بعض(_) -> {
            لو (ج[ف].البداية > أقصى_بداية) { أقصى_بداية := ج[ف].البداية; };
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    دع يبدأ_عند: متغير متجه متجه معرف_سجل_افتراضي = [];
    ف := 0;
    بينما (ف <= أقصى_بداية) {
        دع فارغ: متجه معرف_سجل_افتراضي = [];
        ألحق(يبدأ_عند, فارغ);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(ج) مثل غير_موقع)) {
        طابق ج[ف].الفئة مع
        | اختيار.بعض(_) -> { ألحق(يبدأ_عند[ج[ف].البداية], ج[ف].السجل); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    دع الثوابت: متغير متجه متجه معرف_سجل_افتراضي = [];
    دع عدد_الفعلية: غير_موقع = عدد_السجلات_الفعلية_المتابعة(&م, &ج);
    ف := 0;
    بينما (ف < عدد_الفعلية) {
        دع فارغ: متجه معرف_سجل_افتراضي = [];
        ألحق(الثوابت, فارغ);
        ف := ف + 1;
    }
    دع موضع: متغير غير_موقع = 0;
    بينما (موضع < (الطول(يبدأ_عند) مثل غير_موقع)) {
        دع س: متغير غير_موقع = 0;
        بينما (س < (الطول(يبدأ_عند[موضع]) مثل غير_موقع)) {
            دع المعرف: معرف_سجل_افتراضي = يبدأ_عند[موضع][س];
            طابق ج[المعرف.القيمة].ثابت مع
            | اختيار.بعض(الثابت) -> {
                لو (الثابت.القيمة < (الطول(الثوابت) مثل غير_موقع)) {
                    ألحق(الثوابت[الثابت.القيمة], المعرف);
                };
            }
            | اختيار.لا_شيء -> { };
            س := س + 1;
        }
        موضع := موضع + 1;
    }
    دع الناتج: جدول_تخصيص_خطي = {
        يبدأ_عند: يبدأ_عند,
        الثوابت_حسب_الفعلي: الثوابت
    };
    أرجع الناتج;
}

عرف حدث_مؤشرات_الثوابت(
    المجالات: &متجه مجال_حياة_سجل,
    الجدول: &جدول_تخصيص_خطي,
    المؤشرات: &متغير متجه غير_موقع,
    البداية: غير_موقع
): فراغ {
    دع ج: متجه مجال_حياة_سجل = *المجالات;
    دع د: جدول_تخصيص_خطي = *الجدول;
    دع الحالة: متغير متجه غير_موقع = *المؤشرات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع استمر: متغير منطقي = صواب;
        بينما (استمر && الحالة[ف] < (الطول(د.الثوابت_حسب_الفعلي[ف]) مثل غير_موقع)) {
            دع السجل: معرف_سجل_افتراضي = د.الثوابت_حسب_الفعلي[ف][الحالة[ف]];
            لو (ج[السجل.القيمة].النهاية < البداية) {
                الحالة[ف] := الحالة[ف] + 1;
            } وإلا {
                استمر := خطأ;
            };
        }
        ف := ف + 1;
    }
    *المؤشرات := الحالة;
}

عرف محجوز_بثابت_قادم(
    المجالات: &متجه مجال_حياة_سجل,
    الجدول: &جدول_تخصيص_خطي,
    المؤشرات: &متجه غير_موقع,
    فهرس_الفعلي: غير_موقع,
    المجال: &مجال_حياة_سجل
): منطقي {
    دع ج: متجه مجال_حياة_سجل = *المجالات;
    دع د: جدول_تخصيص_خطي = *الجدول;
    دع م: متجه غير_موقع = *المؤشرات;
    لو (فهرس_الفعلي >= (الطول(د.الثوابت_حسب_الفعلي) مثل غير_موقع)) { أرجع خطأ; };
    دع الموضع: غير_موقع = م[فهرس_الفعلي];
    لو (الموضع >= (الطول(د.الثوابت_حسب_الفعلي[فهرس_الفعلي]) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع المعرف: معرف_سجل_افتراضي = د.الثوابت_حسب_الفعلي[فهرس_الفعلي][الموضع];
    دع مرجع_الثابت: &مجال_حياة_سجل = &ج[المعرف.القيمة];
    دع ثابت: مجال_حياة_سجل = *مرجع_الثابت;
    دع الحالي: مجال_حياة_سجل = *المجال;
    أرجع ثابت.البداية <= الحالي.النهاية && الحالي.البداية <= ثابت.النهاية;
}

عرف سجل_مربوط_مخصص_مباشر(
    المجال: &مجال_حياة_سجل,
    التعيينات: &متجه اختيار معرف_سجل_فعلي
): اختيار معرف_سجل_فعلي {
    دع ج: مجال_حياة_سجل = *المجال;
    دع ع: متجه اختيار معرف_سجل_فعلي = *التعيينات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ج.السجلات_المربوطة) مثل غير_موقع)) {
        دع المعرف: معرف_سجل_افتراضي = ج.السجلات_المربوطة[ف];
        لو (المعرف.القيمة < (الطول(ع) مثل غير_موقع)) {
            طابق ع[المعرف.القيمة] مع
            | اختيار.بعض(الفعلي) -> { أرجع اختيار.بعض(الفعلي); }
            | اختيار.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف مرشح_متاح_خطي(
    المجالات: &متجه مجال_حياة_سجل,
    الجدول: &جدول_تخصيص_خطي,
    مؤشرات_الثوابت: &متجه غير_موقع,
    النهايات_النشطة: &متجه اختيار غير_موقع,
    المجال: &مجال_حياة_سجل,
    المرشح: معرف_سجل_فعلي,
    فهرس_الفعلي: غير_موقع,
    احترم_الثوابت_القادمة: منطقي
): منطقي {
    لو (مفسد_داخل_المجال(المجال, المرشح)) { أرجع خطأ; };
    دع النهايات: متجه اختيار غير_موقع = *النهايات_النشطة;
    دع الحالي: مجال_حياة_سجل = *المجال;
    طابق النهايات[فهرس_الفعلي] مع
    | اختيار.بعض(النهاية) -> {
        لو (النهاية >= الحالي.البداية) { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { };
    لو (احترم_الثوابت_القادمة) {
        لو (محجوز_بثابت_قادم(
            المجالات, الجدول, مؤشرات_الثوابت, فهرس_الفعلي, &الحالي
        )) { أرجع خطأ; };
    };
    أرجع صواب;
}

عرف اجمع_تعيينات_مباشرة(
    المباشرة: &متجه اختيار معرف_سجل_فعلي
): متجه تعيين_سجل {
    دع م: متجه اختيار معرف_سجل_فعلي = *المباشرة;
    دع الناتج: متغير متجه تعيين_سجل = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م) مثل غير_موقع)) {
        طابق م[ف] مع
        | اختيار.بعض(الفعلي) -> {
            دع الافتراضي: معرف_سجل_افتراضي = { القيمة: ف };
            دع التعيين: تعيين_سجل = { الافتراضي: الافتراضي, الفعلي: الفعلي };
            ألحق(الناتج, التعيين);
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سجل_فعلي_من_الفهرس(
    المسألة: &مسألة_تخصيص,
    الفهرس: غير_موقع
): معرف_سجل_فعلي {
    دع م: مسألة_تخصيص = *المسألة;
    أرجع م.السجلات_المتاحة[الفهرس].المعرف;
}

عام عرف خصص_السجلات(المسألة: &مسألة_تخصيص): نتيجة_تخصيص {
    دع م: مسألة_تخصيص = *المسألة;
    دع المجالات: متجه مجال_حياة_سجل = حلل_مجالات_الحياة(المسألة);
    دع الجدول: جدول_تخصيص_خطي = ابن_جدول_تخصيص_خطي(&م, &المجالات);
    دع التعيينات: متغير متجه اختيار معرف_سجل_فعلي = ابن_خيارات_سجلات_فعلية(
        م.عدد_السجلات_الافتراضية
    );
    دع عدد_الفعلية: غير_موقع = عدد_السجلات_الفعلية_المتابعة(&م, &المجالات);
    دع النهايات_النشطة: متغير متجه اختيار غير_موقع = ابن_خيارات_نهايات(عدد_الفعلية);
    دع مؤشرات_الثوابت: متغير متجه غير_موقع = ابن_أصفار(عدد_الفعلية);

    دع موضع: متغير غير_موقع = 0;
    بينما (موضع < (الطول(الجدول.يبدأ_عند) مثل غير_موقع)) {
        حدث_مؤشرات_الثوابت(&المجالات, &الجدول, &متغير مؤشرات_الثوابت, موضع);
        دع المرحلة: متغير غير_موقع = 0;
        بينما (المرحلة < 2) {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الجدول.يبدأ_عند[موضع]) مثل غير_موقع)) {
                دع المعرف: معرف_سجل_افتراضي = الجدول.يبدأ_عند[موضع][ف];
                دع مرجع_المجال: &مجال_حياة_سجل = &المجالات[المعرف.القيمة];
                دع المجال: مجال_حياة_سجل = *مرجع_المجال;
                لو (المجال.تعارض_قيود) {
                    أرجع نتيجة_تخصيص.فشل_قيود(المجال.السجل);
                };
                دع ثابت_مسبق: متغير منطقي = خطأ;
                طابق المجال.ثابت مع
                | اختيار.بعض(_) -> { ثابت_مسبق := صواب; }
                | اختيار.لا_شيء -> { };
                لو ((المرحلة == 0 && ثابت_مسبق) || (المرحلة == 1 && !ثابت_مسبق)) {
                    دع المختار: متغير اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
                    دع فهرس_المختار: متغير اختيار غير_موقع = اختيار.لا_شيء();
                    طابق المجال.ثابت مع
                    | اختيار.بعض(ثابت) -> {
                        لو (
                            ثابت.القيمة < (الطول(النهايات_النشطة) مثل غير_موقع)
                            && مرشح_متاح_خطي(
                                &المجالات, &الجدول, &مؤشرات_الثوابت,
                                &النهايات_النشطة, &المجال, ثابت, ثابت.القيمة, خطأ
                            )
                        ) {
                            المختار := اختيار.بعض(ثابت);
                            فهرس_المختار := اختيار.بعض(ثابت.القيمة);
                        } وإلا {
                            أرجع نتيجة_تخصيص.فشل_قيود(المجال.السجل);
                        };
                    }
                    | اختيار.لا_شيء -> {
                        طابق سجل_مربوط_مخصص_مباشر(&المجال, &التعيينات) مع
                        | اختيار.بعض(مربوط) -> {
                            لو (
                                مربوط.القيمة < (الطول(النهايات_النشطة) مثل غير_موقع)
                                && مرشح_متاح_خطي(
                                    &المجالات, &الجدول, &مؤشرات_الثوابت,
                                    &النهايات_النشطة, &المجال, مربوط, مربوط.القيمة, صواب
                                )
                            ) {
                                المختار := اختيار.بعض(مربوط);
                                فهرس_المختار := اختيار.بعض(مربوط.القيمة);
                            } وإلا {
                                أرجع نتيجة_تخصيص.فشل_قيود(المجال.السجل);
                            };
                        }
                        | اختيار.لا_شيء -> {
                            دع ر: متغير غير_موقع = 0;
                            بينما (ر < (الطول(م.السجلات_المتاحة) مثل غير_موقع)) {
                                دع المرشح: سجل_فعلي_متاح = م.السجلات_المتاحة[ر];
                                دع صحيح_الفئة: متغير منطقي = صواب;
                                طابق المجال.الفئة مع
                                | اختيار.بعض(الفئة) -> {
                                    صحيح_الفئة := معرفا_فئة_تخصيص_متساويان(الفئة, المرشح.الفئة);
                                }
                                | اختيار.لا_شيء -> { };
                                لو (
                                    صحيح_الفئة
                                    && مرشح_متاح_خطي(
                                        &المجالات, &الجدول, &مؤشرات_الثوابت,
                                        &النهايات_النشطة, &المجال, المرشح.المعرف, المرشح.المعرف.القيمة, صواب
                                    )
                                ) {
                                    المختار := اختيار.بعض(المرشح.المعرف);
                                    فهرس_المختار := اختيار.بعض(المرشح.المعرف.القيمة);
                                    ر := الطول(م.السجلات_المتاحة) مثل غير_موقع;
                                } وإلا {
                                    ر := ر + 1;
                                };
                            }
                        };
                    };
                    طابق المختار مع
                    | اختيار.بعض(فعلي) -> {
                        التعيينات[المجال.السجل.القيمة] := اختيار.بعض(فعلي);
                        طابق فهرس_المختار مع
                        | اختيار.بعض(فهرس) -> {
                            النهايات_النشطة[فهرس] := اختيار.بعض(المجال.النهاية);
                        }
                        | اختيار.لا_شيء -> { أرجع نتيجة_تخصيص.فشل_قيود(المجال.السجل); };
                    }
                    | اختيار.لا_شيء -> {
                        دع السبب: سبب_حاجة_انسكاب = {
                            السجل: المجال.السجل,
                            عند_الموضع: المجال.البداية
                        };
                        أرجع نتيجة_تخصيص.يحتاج_انسكاب(السبب);
                    };
                };
                ف := ف + 1;
            }
            المرحلة := المرحلة + 1;
        }
        موضع := موضع + 1;
    }
    أرجع نتيجة_تخصيص.مخصص(اجمع_تعيينات_مباشرة(&التعيينات));
}

عام عرف خصص_السجلات_مع_انسكاب(المسألة: &مسألة_تخصيص): نتيجة_تخصيص_مع_انسكاب {
    دع م: مسألة_تخصيص = *المسألة;
    دع المجالات: متجه مجال_حياة_سجل = حلل_مجالات_الحياة(المسألة);
    دع الجدول: جدول_تخصيص_خطي = ابن_جدول_تخصيص_خطي(&م, &المجالات);
    دع التعيينات: متغير متجه اختيار معرف_سجل_فعلي = ابن_خيارات_سجلات_فعلية(
        م.عدد_السجلات_الافتراضية
    );
    دع عدد_الفعلية: غير_موقع = عدد_السجلات_الفعلية_المتابعة(&م, &المجالات);
    دع النهايات_النشطة: متغير متجه اختيار غير_موقع = ابن_خيارات_نهايات(عدد_الفعلية);
    دع مؤشرات_الثوابت: متغير متجه غير_موقع = ابن_أصفار(عدد_الفعلية);
    دع الانسكابات: متغير متجه معرف_سجل_افتراضي = [];

    دع موضع: متغير غير_موقع = 0;
    بينما (موضع < (الطول(الجدول.يبدأ_عند) مثل غير_موقع)) {
        حدث_مؤشرات_الثوابت(&المجالات, &الجدول, &متغير مؤشرات_الثوابت, موضع);
        دع المرحلة: متغير غير_موقع = 0;
        بينما (المرحلة < 2) {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الجدول.يبدأ_عند[موضع]) مثل غير_موقع)) {
                دع المعرف: معرف_سجل_افتراضي = الجدول.يبدأ_عند[موضع][ف];
                دع مرجع_المجال: &مجال_حياة_سجل = &المجالات[المعرف.القيمة];
                دع المجال: مجال_حياة_سجل = *مرجع_المجال;
                لو (المجال.تعارض_قيود) {
                    أرجع نتيجة_تخصيص_مع_انسكاب.فشل_قيود(المجال.السجل);
                };
                دع ثابت_مسبق: متغير منطقي = خطأ;
                طابق المجال.ثابت مع
                | اختيار.بعض(_) -> { ثابت_مسبق := صواب; }
                | اختيار.لا_شيء -> { };
                لو ((المرحلة == 0 && ثابت_مسبق) || (المرحلة == 1 && !ثابت_مسبق)) {
                    دع المختار: متغير اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
                    دع فهرس_المختار: متغير اختيار غير_موقع = اختيار.لا_شيء();
                    طابق المجال.ثابت مع
                    | اختيار.بعض(ثابت) -> {
                        لو (
                            ثابت.القيمة < (الطول(النهايات_النشطة) مثل غير_موقع)
                            && مرشح_متاح_خطي(
                                &المجالات, &الجدول, &مؤشرات_الثوابت,
                                &النهايات_النشطة, &المجال, ثابت, ثابت.القيمة, خطأ
                            )
                        ) {
                            المختار := اختيار.بعض(ثابت);
                            فهرس_المختار := اختيار.بعض(ثابت.القيمة);
                        };
                    }
                    | اختيار.لا_شيء -> {
                        طابق سجل_مربوط_مخصص_مباشر(&المجال, &التعيينات) مع
                        | اختيار.بعض(مربوط) -> {
                            لو (
                                مربوط.القيمة < (الطول(النهايات_النشطة) مثل غير_موقع)
                                && مرشح_متاح_خطي(
                                    &المجالات, &الجدول, &مؤشرات_الثوابت,
                                    &النهايات_النشطة, &المجال, مربوط, مربوط.القيمة, صواب
                                )
                            ) {
                                المختار := اختيار.بعض(مربوط);
                                فهرس_المختار := اختيار.بعض(مربوط.القيمة);
                            };
                        }
                        | اختيار.لا_شيء -> {
                            دع ر: متغير غير_موقع = 0;
                            بينما (ر < (الطول(م.السجلات_المتاحة) مثل غير_موقع)) {
                                دع المرشح: سجل_فعلي_متاح = م.السجلات_المتاحة[ر];
                                دع صحيح_الفئة: متغير منطقي = صواب;
                                طابق المجال.الفئة مع
                                | اختيار.بعض(الفئة) -> {
                                    صحيح_الفئة := معرفا_فئة_تخصيص_متساويان(الفئة, المرشح.الفئة);
                                }
                                | اختيار.لا_شيء -> { };
                                لو (
                                    صحيح_الفئة
                                    && مرشح_متاح_خطي(
                                        &المجالات, &الجدول, &مؤشرات_الثوابت,
                                        &النهايات_النشطة, &المجال, المرشح.المعرف, المرشح.المعرف.القيمة, صواب
                                    )
                                ) {
                                    المختار := اختيار.بعض(المرشح.المعرف);
                                    فهرس_المختار := اختيار.بعض(المرشح.المعرف.القيمة);
                                    ر := الطول(م.السجلات_المتاحة) مثل غير_موقع;
                                } وإلا {
                                    ر := ر + 1;
                                };
                            }
                        };
                    };
                    طابق المختار مع
                    | اختيار.بعض(فعلي) -> {
                        التعيينات[المجال.السجل.القيمة] := اختيار.بعض(فعلي);
                        طابق فهرس_المختار مع
                        | اختيار.بعض(فهرس) -> {
                            النهايات_النشطة[فهرس] := اختيار.بعض(المجال.النهاية);
                        }
                        | اختيار.لا_شيء -> { أرجع نتيجة_تخصيص_مع_انسكاب.فشل_قيود(المجال.السجل); };
                    }
                    | اختيار.لا_شيء -> {
                        ألحق(الانسكابات, المجال.السجل);
                    };
                };
                ف := ف + 1;
            }
            المرحلة := المرحلة + 1;
        }
        موضع := موضع + 1;
    }
    دع التعيينات_النهائية: متجه تعيين_سجل = اجمع_تعيينات_مباشرة(&التعيينات);
    دع الانسكابات_المرتبة: متجه معرف_سجل_افتراضي = رتب_سجلات_افتراضية(&الانسكابات);
    دع الخطة: خطة_تخصيص_مع_انسكاب = {
        التعيينات: التعيينات_النهائية,
        السجلات_المسكوبة: الانسكابات_المرتبة
    };
    أرجع نتيجة_تخصيص_مع_انسكاب.مكتمل(الخطة);
}
