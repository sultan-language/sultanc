استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.source.provenance;

// Canonical machine debug facts after codegen. Target/ABI owners resolve register
// numbering and storage facts before records enter this layer; DWARF only
// serializes the resulting machine locations and ranges.
عام نوع موضع_دالة_آلة_تصحيح = {
    الدالة: معرف_دالة_منتقاة,
    إزاحة_بايت: غير_موقع,
    حجم_بايت: غير_موقع
};

عام نوع موقع_آلة_تصحيح =
    | غير_متاح
    | سجل بنوع غير_موقع
    | مكدس بنوع (غير_موقع, غير_موقع)
;

// A source variable is independent from storage. Transitions are keyed by the
// compact DebugLocID that survived MSIR -> selection -> allocation -> encoding.
عام نوع انتقال_موقع_آلة_تصحيح = {
    المتغير: معرف_متغير_تصحيح,
    موقع_التصحيح: اختيار معرف_موقع_تصحيح,
    الأصل: معرف_أصل_مصدر,
    السجل_الافتراضي: غير_موقع,
    الموقع: موقع_آلة_تصحيح
};

عام نوع مدى_موقع_آلة_تصحيح = {
    المتغير: معرف_متغير_تصحيح,
    بداية_بايت: غير_موقع,
    نهاية_بايت: غير_موقع,
    الموقع: موقع_آلة_تصحيح
};

عام نوع مدى_سطر_آلة_تصحيح = {
    الدالة: معرف_دالة_منتقاة,
    بداية_بايت: غير_موقع,
    نهاية_بايت: غير_موقع,
    الموقع: معرف_موقع_تصحيح
};

عام نوع مدى_نطاق_آلة_تصحيح = {
    النطاق: معرف_نطاق_تصحيح,
    بداية_بايت: غير_موقع,
    نهاية_بايت: غير_موقع
};

// Function-local sparse indexes keep storage proportional to facts actually
// used by this function instead of the process-global DebugLocID/DebugScopeID.
عام نوع فهرس_موقع_آلة_تصحيح = {
    الموقع: معرف_موقع_تصحيح,
    الفهارس: متجه غير_موقع
};

عام نوع فهرس_نطاق_آلة_تصحيح = {
    النطاق: معرف_نطاق_تصحيح,
    الفهارس: متجه غير_موقع
};

عام نوع تصحيح_دالة_آلة = {
    الدالة: معرف_دالة_منتقاة,
    دالة_التصحيح: اختيار معرف_دالة_تصحيح,
    حجم_إطار_بايت: غير_موقع,
    انتقالات_المواقع: متجه انتقال_موقع_آلة_تصحيح,
    // Sparse DebugLocID -> indices in انتقالات_المواقع.
    انتقالات_بالموقع: متجه فهرس_موقع_آلة_تصحيح,
    مديات_المواقع: متجه مدى_موقع_آلة_تصحيح,
    مديات_السطور: متجه مدى_سطر_آلة_تصحيح,
    مديات_النطاقات: متجه مدى_نطاق_آلة_تصحيح,
    مديات_النطاقات_بالمعرف: متجه فهرس_نطاق_آلة_تصحيح
};

عام عرف موضع_فهرس_موقع_تصحيح_آلة(
    الدالة: &تصحيح_دالة_آلة,
    الموقع: معرف_موقع_تصحيح
): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الدالة).انتقالات_بالموقع) مثل غير_موقع)) {
        لو ((*الدالة).انتقالات_بالموقع[ف].الموقع.القيمة == الموقع.القيمة) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ضمن_فهرس_موقع_تصحيح_آلة(
    الدالة: &متغير تصحيح_دالة_آلة,
    الموقع: معرف_موقع_تصحيح
): غير_موقع {
    طابق موضع_فهرس_موقع_تصحيح_آلة(الدالة, الموقع) مع
    | اختيار.بعض(الموضع) -> { أرجع الموضع; }
    | اختيار.لا_شيء -> { };
    دع الفهارس: متجه غير_موقع = [];
    دع المدخل: فهرس_موقع_آلة_تصحيح = { الموقع: الموقع, الفهارس: الفهارس };
    دع الموضع: غير_موقع = الطول((*الدالة).انتقالات_بالموقع) مثل غير_موقع;
    ألحق((*الدالة).انتقالات_بالموقع, المدخل);
    أرجع الموضع;
}

عام عرف موضع_فهرس_نطاق_تصحيح_آلة(
    الدالة: &تصحيح_دالة_آلة,
    النطاق: معرف_نطاق_تصحيح
): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الدالة).مديات_النطاقات_بالمعرف) مثل غير_موقع)) {
        لو ((*الدالة).مديات_النطاقات_بالمعرف[ف].النطاق.القيمة == النطاق.القيمة) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ضمن_فهرس_نطاق_تصحيح_آلة(
    الدالة: &متغير تصحيح_دالة_آلة,
    النطاق: معرف_نطاق_تصحيح
): غير_موقع {
    طابق موضع_فهرس_نطاق_تصحيح_آلة(الدالة, النطاق) مع
    | اختيار.بعض(الموضع) -> { أرجع الموضع; }
    | اختيار.لا_شيء -> { };
    دع الفهارس: متجه غير_موقع = [];
    دع المدخل: فهرس_نطاق_آلة_تصحيح = { النطاق: النطاق, الفهارس: الفهارس };
    دع الموضع: غير_موقع = الطول((*الدالة).مديات_النطاقات_بالمعرف) مثل غير_موقع;
    ألحق((*الدالة).مديات_النطاقات_بالمعرف, المدخل);
    أرجع الموضع;
}

عام نوع سياق_تصحيح_آلة = {
    الدوال: متجه تصحيح_دالة_آلة,
    // Canonical FunctionID -> optional machine-debug owner position.
    فهرس_الدوال: متجه اختيار غير_موقع
};

عام عرف سياق_تصحيح_آلة_جديد(): سياق_تصحيح_آلة {
    دع الدوال: متجه تصحيح_دالة_آلة = [];
    دع الفهرس: متجه اختيار غير_موقع = [];
    دع السياق: سياق_تصحيح_آلة = { الدوال: الدوال, فهرس_الدوال: الفهرس };
    أرجع السياق;
}

عام عرف موضع_دالة_تصحيح_آلة(
    السياق: &سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة
): اختيار غير_موقع {
    لو (الدالة.القيمة >= (الطول((*السياق).فهرس_الدوال) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*السياق).فهرس_الدوال[الدالة.القيمة];
}

عام عرف اربط_موضع_دالة_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة,
    الموضع: غير_موقع
): فراغ {
    بينما ((الطول((*السياق).فهرس_الدوال) مثل غير_موقع) <= الدالة.القيمة) {
        دع فارغ: اختيار غير_موقع = اختيار.لا_شيء();
        ألحق((*السياق).فهرس_الدوال, فارغ);
    }
    (*السياق).فهرس_الدوال[الدالة.القيمة] := اختيار.بعض(الموضع);
}
