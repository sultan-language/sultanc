استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.source.provenance;

// Canonical machine debug facts after codegen. Target/ABI owners resolve register
// numbering and storage facts before records enter this layer; DWARF only
// serializes the resulting machine locations and ranges.
عام نوع موضع_دالة_آلة_تصحيح = {
    الدالة: معرف_دالة_منتقاة,
    إزاحة_بايت: طبيعي,
    حجم_بايت: طبيعي
};

عام نوع موقع_آلة_تصحيح =
    | غير_متاح
    | سجل بنوع طبيعي
    | مكدس بنوع (طبيعي, طبيعي)
    // The value's address is stored at (register + offset): an aggregate
    // whose address was spilled to a stack slot.
    | مكدس_غير_مباشر بنوع (طبيعي, طبيعي)
    // Memory at a signed offset from the frame's canonical frame address
    // (DW_AT_frame_base is the CFA): stable across the stack adjustments
    // around calls, and correct in a caller's frame during a call.
    | إطار بنوع عدد
    // The value's address is stored at that frame offset.
    | إطار_غير_مباشر بنوع عدد
    // WebAssembly has no registers: a value lives in a function local
    // (index). With the flag set the local holds the address of the value's
    // storage in linear memory (an aggregate); otherwise it is the value.
    | محلي_ويب_أسمبلي بنوع (طبيعي, منطقي)
;

// A source variable is independent from storage. Transitions are keyed by the
// compact DebugLocID that survived MSIR -> selection -> allocation -> encoding.
عام نوع انتقال_موقع_آلة_تصحيح = {
    المتغير: معرف_متغير_تصحيح,
    موقع_التصحيح: اختياري معرف_موقع_تصحيح,
    الأصل: معرف_أصل_مصدر,
    السجل_الافتراضي: طبيعي,
    الموقع: موقع_آلة_تصحيح
};

عام نوع مدى_موقع_آلة_تصحيح = {
    المتغير: معرف_متغير_تصحيح,
    بداية_بايت: طبيعي,
    نهاية_بايت: طبيعي,
    الموقع: موقع_آلة_تصحيح
};

عام نوع مدى_سطر_آلة_تصحيح = {
    الدالة: معرف_دالة_منتقاة,
    بداية_بايت: طبيعي,
    نهاية_بايت: طبيعي,
    الموقع: معرف_موقع_تصحيح
};

عام نوع مدى_نطاق_آلة_تصحيح = {
    النطاق: معرف_نطاق_تصحيح,
    بداية_بايت: طبيعي,
    نهاية_بايت: طبيعي
};

// Function-local sparse indexes keep storage proportional to facts actually
// used by this function instead of the process-global DebugLocID/DebugScopeID.
عام نوع فهرس_موقع_آلة_تصحيح = {
    الموقع: معرف_موقع_تصحيح,
    الفهارس: متجه طبيعي,
    التالي: اختياري طبيعي
};

عام نوع فهرس_نطاق_آلة_تصحيح = {
    النطاق: معرف_نطاق_تصحيح,
    الفهارس: متجه طبيعي,
    التالي: اختياري طبيعي
};

عام نوع تصحيح_دالة_آلة = {
    الدالة: معرف_دالة_منتقاة,
    دالة_التصحيح: اختياري معرف_دالة_تصحيح,
    حجم_إطار_بايت: طبيعي,
    انتقالات_المواقع: متجه انتقال_موقع_آلة_تصحيح,
    // Sparse DebugLocID -> indices in انتقالات_المواقع.
    انتقالات_بالموقع: متجه فهرس_موقع_آلة_تصحيح,
    رؤوس_المواقع: متجه اختياري طبيعي,
    مديات_المواقع: متجه مدى_موقع_آلة_تصحيح,
    مديات_السطور: متجه مدى_سطر_آلة_تصحيح,
    مديات_النطاقات: متجه مدى_نطاق_آلة_تصحيح,
    مديات_النطاقات_بالمعرف: متجه فهرس_نطاق_آلة_تصحيح,
    رؤوس_النطاقات: متجه اختياري طبيعي
};

// Function-local hash-bucket indexing is deliberately not tied to the
// process-global DebugLocID/DebugScopeID cardinality. Chained buckets preserve
// stable entry indices, avoiding sorted-vector insertion and nested-vector
// copies. Resizing is deterministic and does not change DWARF emission order.
عرف أعد_تجزئة_مواقع_تصحيح_آلة(الدالة: &متغير تصحيح_دالة_آلة, السعة: طبيعي): فراغ {
    دع الرؤوس: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الرؤوس, اختياري.لا_شيء()); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*الدالة).انتقالات_بالموقع) مثل طبيعي)) {
        دع دلو: طبيعي = (*الدالة).انتقالات_بالموقع[ف].الموقع.القيمة % السعة;
        (*الدالة).انتقالات_بالموقع[ف].التالي := الرؤوس[دلو];
        الرؤوس[دلو] := اختياري.موجود(ف);
        ف := ف + 1;
    }
    (*الدالة).رؤوس_المواقع := الرؤوس;
}

عام عرف موضع_فهرس_موقع_تصحيح_آلة(
    الدالة: &تصحيح_دالة_آلة,
    الموقع: معرف_موقع_تصحيح
): اختياري طبيعي {
    دع السعة: طبيعي = الطول((*الدالة).رؤوس_المواقع) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع فهرس: متغير اختياري طبيعي = (*الدالة).رؤوس_المواقع[الموقع.القيمة % السعة];
    طالما (صواب) {
        طابق فهرس مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الموضع) -> {
            إذا ((*الدالة).انتقالات_بالموقع[الموضع].الموقع.القيمة == الموقع.القيمة) {
                أرجع اختياري.موجود(الموضع);
            };
            فهرس := (*الدالة).انتقالات_بالموقع[الموضع].التالي;
        };
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ضمن_فهرس_موقع_تصحيح_آلة(
    الدالة: &متغير تصحيح_دالة_آلة,
    الموقع: معرف_موقع_تصحيح
): طبيعي {
    طابق موضع_فهرس_موقع_تصحيح_آلة(الدالة, الموقع) مع
    | اختياري.موجود(الموضع) -> { أرجع الموضع; }
    | اختياري.لا_شيء -> { };
    دع العدد: طبيعي = الطول((*الدالة).انتقالات_بالموقع) مثل طبيعي;
    دع السعة: طبيعي = الطول((*الدالة).رؤوس_المواقع) مثل طبيعي;
    إذا (السعة == 0) {
        أعد_تجزئة_مواقع_تصحيح_آلة(الدالة, 16);
    } وإلا {
        إذا (العدد >= السعة) { أعد_تجزئة_مواقع_تصحيح_آلة(الدالة, السعة * 2); };
    };
    دع دلو: طبيعي = الموقع.القيمة % (الطول((*الدالة).رؤوس_المواقع) مثل طبيعي);
    دع الفهارس: متجه طبيعي = [];
    دع المدخل: فهرس_موقع_آلة_تصحيح = {
        الموقع: الموقع, الفهارس: الفهارس, التالي: (*الدالة).رؤوس_المواقع[دلو]
    };
    ألحق((*الدالة).انتقالات_بالموقع, المدخل);
    (*الدالة).رؤوس_المواقع[دلو] := اختياري.موجود(العدد);
    أرجع العدد;
}

عرف أعد_تجزئة_نطاقات_تصحيح_آلة(الدالة: &متغير تصحيح_دالة_آلة, السعة: طبيعي): فراغ {
    دع الرؤوس: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الرؤوس, اختياري.لا_شيء()); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*الدالة).مديات_النطاقات_بالمعرف) مثل طبيعي)) {
        دع دلو: طبيعي = (*الدالة).مديات_النطاقات_بالمعرف[ف].النطاق.القيمة % السعة;
        (*الدالة).مديات_النطاقات_بالمعرف[ف].التالي := الرؤوس[دلو];
        الرؤوس[دلو] := اختياري.موجود(ف);
        ف := ف + 1;
    }
    (*الدالة).رؤوس_النطاقات := الرؤوس;
}

عام عرف موضع_فهرس_نطاق_تصحيح_آلة(
    الدالة: &تصحيح_دالة_آلة,
    النطاق: معرف_نطاق_تصحيح
): اختياري طبيعي {
    دع السعة: طبيعي = الطول((*الدالة).رؤوس_النطاقات) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع فهرس: متغير اختياري طبيعي = (*الدالة).رؤوس_النطاقات[النطاق.القيمة % السعة];
    طالما (صواب) {
        طابق فهرس مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الموضع) -> {
            إذا ((*الدالة).مديات_النطاقات_بالمعرف[الموضع].النطاق.القيمة == النطاق.القيمة) {
                أرجع اختياري.موجود(الموضع);
            };
            فهرس := (*الدالة).مديات_النطاقات_بالمعرف[الموضع].التالي;
        };
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ضمن_فهرس_نطاق_تصحيح_آلة(
    الدالة: &متغير تصحيح_دالة_آلة,
    النطاق: معرف_نطاق_تصحيح
): طبيعي {
    طابق موضع_فهرس_نطاق_تصحيح_آلة(الدالة, النطاق) مع
    | اختياري.موجود(الموضع) -> { أرجع الموضع; }
    | اختياري.لا_شيء -> { };
    دع العدد: طبيعي = الطول((*الدالة).مديات_النطاقات_بالمعرف) مثل طبيعي;
    دع السعة: طبيعي = الطول((*الدالة).رؤوس_النطاقات) مثل طبيعي;
    إذا (السعة == 0) {
        أعد_تجزئة_نطاقات_تصحيح_آلة(الدالة, 16);
    } وإلا {
        إذا (العدد >= السعة) { أعد_تجزئة_نطاقات_تصحيح_آلة(الدالة, السعة * 2); };
    };
    دع دلو: طبيعي = النطاق.القيمة % (الطول((*الدالة).رؤوس_النطاقات) مثل طبيعي);
    دع الفهارس: متجه طبيعي = [];
    دع المدخل: فهرس_نطاق_آلة_تصحيح = {
        النطاق: النطاق, الفهارس: الفهارس, التالي: (*الدالة).رؤوس_النطاقات[دلو]
    };
    ألحق((*الدالة).مديات_النطاقات_بالمعرف, المدخل);
    (*الدالة).رؤوس_النطاقات[دلو] := اختياري.موجود(العدد);
    أرجع العدد;
}

عام نوع سياق_تصحيح_آلة = {
    الدوال: متجه تصحيح_دالة_آلة,
    // Canonical FunctionID -> optional machine-debug owner position.
    فهرس_الدوال: متجه اختياري طبيعي
};

عام عرف سياق_تصحيح_آلة_جديد(): سياق_تصحيح_آلة {
    دع الدوال: متجه تصحيح_دالة_آلة = [];
    دع الفهرس: متجه اختياري طبيعي = [];
    دع السياق: سياق_تصحيح_آلة = { الدوال: الدوال, فهرس_الدوال: الفهرس };
    أرجع السياق;
}

عام عرف موضع_دالة_تصحيح_آلة(
    السياق: &سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة
): اختياري طبيعي {
    إذا (الدالة.القيمة >= (الطول((*السياق).فهرس_الدوال) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*السياق).فهرس_الدوال[الدالة.القيمة];
}

عام عرف اربط_موضع_دالة_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة,
    الموضع: طبيعي
): فراغ {
    طالما ((الطول((*السياق).فهرس_الدوال) مثل طبيعي) <= الدالة.القيمة) {
        دع فارغ: اختياري طبيعي = اختياري.لا_شيء();
        ألحق((*السياق).فهرس_الدوال, فارغ);
    }
    (*السياق).فهرس_الدوال[الدالة.القيمة] := اختياري.موجود(الموضع);
}
