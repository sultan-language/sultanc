استورد compiler.backend.codegen.debug.model;
استورد compiler.debuginfo.model;
استورد compiler.msir.debug_contract;
استورد compiler.msir.identifiers;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.layout.layout_model;
استورد compiler.backend.layout.layout_resolution;
استورد compiler.backend.target.target_model;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_identity;

// Source-variable locations of a register-allocated function (x86-64, ARM64).
//
// A source variable is bound to MSIR values (debug_contract.sn); value N is
// virtual register N. A value is in its register or spill slot exactly at the
// positions where liveness says it is live (خطة_تخصيص_مع_انسكاب.مقاطع_الحياة):
// the allocator gives no other value that register there, so the debugger
// never reads another value's bits. Outside those positions the variable has
// no location and the debugger reports it optimized out.
//
// An aggregate value (record, tuple, enum, vector, text) is the address of its
// storage. When its storage is a stack slot of the frame (the value owns the
// slot), the variable is that memory from the value's definition on; otherwise
// it is the memory the live address register (or spilled address) points to.

// Where one virtual register lives for its whole lifetime.
عام نوع تخزين_قيمة_آلة_تصحيح =
    | بلا
    // DWARF register number.
    | سجل بنوع طبيعي
    // Offset of its spill slot from the stack pointer.
    | مكدس بنوع طبيعي
;

عام نوع حقائق_قيم_دالة_آلة_تصحيح = {
    // Per allocation position (a selected instruction, numbered across the
    // function's blocks in order): the function-relative byte range of the
    // machine code it became. A position with no code has equal bounds.
    بدايات_المواضع: متجه طبيعي,
    نهايات_المواضع: متجه طبيعي,
    // Per virtual register: live positions as inclusive pairs.
    مقاطع_الحياة: متجه متجه طبيعي,
    // Per virtual register.
    التخزين: متجه تخزين_قيمة_آلة_تصحيح,
    // The MSIR values that own a frame stack slot, with its offset from the
    // stack pointer.
    قيم_المواضع_المحلية: متجه طبيعي,
    إزاحات_المواضع_المحلية: متجه طبيعي,
    // Per virtual register: when every definition of it is the address of a
    // frame stack slot, possibly plus a constant (an aggregate built inside
    // its owner's storage), that address's offset from the stack pointer
    // plus one; zero otherwise.
    عناوين_الإطار: متجه طبيعي,
    // The canonical frame address's offset from the stack pointer in the
    // body (after the prologue): stack-slot offsets become CFA offsets.
    إزاحة_الإطار: طبيعي,
    // Function-relative end of the function's code.
    نهاية_الدالة: طبيعي
};

// Positions of one function from its blocks: each block's first position,
// per block the first allocated instruction of each selected instruction (and
// the allocated count), and per block the byte offset of each allocated
// instruction (and the block's end; empty when the block is not laid out).
عام عرف مواضع_بايتات_من_كتل_تصحيح(
    بدايات_الكتل: &متجه طبيعي,
    بدايات_المنتقاة: &متجه متجه طبيعي,
    مواضع_التعليمات: &متجه متجه طبيعي,
    البدايات: &متغير متجه طبيعي,
    النهايات: &متغير متجه طبيعي
): فراغ {
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(*بدايات_الكتل) مثل طبيعي) && ك < (الطول(*بدايات_المنتقاة) مثل طبيعي)) {
        دع الأولى: طبيعي = (*بدايات_الكتل)[ك];
        دع المنتقاة: &متجه طبيعي = &(*بدايات_المنتقاة)[ك];
        دع عدد_المنتقاة: طبيعي = الطول(*المنتقاة) مثل طبيعي;
        دع ف: متغير طبيعي = 0;
        طالما (ف + 1 < عدد_المنتقاة) {
            دع الموضع: طبيعي = الأولى + ف;
            طالما ((الطول(*البدايات) مثل طبيعي) <= الموضع) { ألحق(*البدايات, 0); ألحق(*النهايات, 0); }
            إذا (ك < (الطول(*مواضع_التعليمات) مثل طبيعي)) {
                دع البايتات: &متجه طبيعي = &(*مواضع_التعليمات)[ك];
                دع أ: طبيعي = (*المنتقاة)[ف];
                دع ب: طبيعي = (*المنتقاة)[ف + 1];
                إذا (ب < (الطول(*البايتات) مثل طبيعي) && أ <= ب) {
                    (*البدايات)[الموضع] := (*البايتات)[أ];
                    (*النهايات)[الموضع] := (*البايتات)[ب];
                };
            };
            ف := ف + 1;
        }
        ك := ك + 1;
    }
}

نوع مدى_قيمة_متغير_تصحيح = {
    البداية: طبيعي,
    النهاية: طبيعي,
    الموقع: موقع_آلة_تصحيح
};

// Whether a Type's values are the address of their storage.
عرف نوع_بعنوان_تصحيح(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    النوع: معرف_نوع
): منطقي {
    طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(التخطيط) -> {
        طابق التخطيط.التفاصيل مع
        | تفاصيل_تخطيط.صف(_) -> { أرجع صواب; }
        | تفاصيل_تخطيط.سجل(_) -> { أرجع صواب; }
        | تفاصيل_تخطيط.تعداد(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف ألحق_مدى_قيمة_تصحيح(
    المديات: &متغير متجه مدى_قيمة_متغير_تصحيح,
    البداية: طبيعي,
    النهاية: طبيعي,
    الموقع: موقع_آلة_تصحيح
): فراغ {
    إذا (النهاية <= البداية) { أرجع; };
    دع العدد: طبيعي = الطول(*المديات) مثل طبيعي;
    إذا (العدد > 0) {
        إذا ((*المديات)[العدد - 1].النهاية == البداية
            && موقعا_آلة_تصحيح_متساويان(&(*المديات)[العدد - 1].الموقع, &الموقع)) {
            (*المديات)[العدد - 1].النهاية := النهاية;
            أرجع;
        };
    };
    دع المدى: مدى_قيمة_متغير_تصحيح = { البداية: البداية, النهاية: النهاية, الموقع: الموقع };
    ألحق(*المديات, المدى);
}

عرف موقعا_آلة_تصحيح_متساويان(أ: &موقع_آلة_تصحيح, ب: &موقع_آلة_تصحيح): منطقي {
    طابق *أ مع
    | موقع_آلة_تصحيح.سجل(س) -> {
        طابق *ب مع | موقع_آلة_تصحيح.سجل(ص) -> { أرجع س == ص; } | _ -> { أرجع خطأ; };
    }
    | موقع_آلة_تصحيح.مكدس(س, ع) -> {
        طابق *ب مع | موقع_آلة_تصحيح.مكدس(ص, ل) -> { أرجع س == ص && ع == ل; } | _ -> { أرجع خطأ; };
    }
    | موقع_آلة_تصحيح.مكدس_غير_مباشر(س, ع) -> {
        طابق *ب مع | موقع_آلة_تصحيح.مكدس_غير_مباشر(ص, ل) -> { أرجع س == ص && ع == ل; } | _ -> { أرجع خطأ; };
    }
    | موقع_آلة_تصحيح.إطار(ع) -> {
        طابق *ب مع | موقع_آلة_تصحيح.إطار(ل) -> { أرجع ع == ل; } | _ -> { أرجع خطأ; };
    }
    | موقع_آلة_تصحيح.إطار_غير_مباشر(ع) -> {
        طابق *ب مع | موقع_آلة_تصحيح.إطار_غير_مباشر(ل) -> { أرجع ع == ل; } | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// The bytes where a live segment [الأول, الأخير] holds its value: every
// position strictly inside it, plus the first byte of its last position (the
// instruction that reads it last, before it executes). The defining position
// itself is excluded: its value exists only once that code has run.
عرف ألحق_مقطع_قيمة_تصحيح(
    الحقائق: &حقائق_قيم_دالة_آلة_تصحيح,
    الأول: طبيعي,
    الأخير: طبيعي,
    الموقع: موقع_آلة_تصحيح,
    المديات: &متغير متجه مدى_قيمة_متغير_تصحيح
): فراغ {
    دع العدد: طبيعي = الطول((*الحقائق).بدايات_المواضع) مثل طبيعي;
    دع م: متغير طبيعي = الأول + 1;
    طالما (م < الأخير && م < العدد) {
        ألحق_مدى_قيمة_تصحيح(المديات, (*الحقائق).بدايات_المواضع[م], (*الحقائق).نهايات_المواضع[م], الموقع);
        م := م + 1;
    }
    إذا (الأخير > الأول && الأخير < العدد) {
        دع البداية: طبيعي = (*الحقائق).بدايات_المواضع[الأخير];
        إذا ((*الحقائق).نهايات_المواضع[الأخير] > البداية) {
            ألحق_مدى_قيمة_تصحيح(المديات, البداية, البداية + 1, الموقع);
        };
    };
}

// A stack-pointer offset in the body as an offset from the CFA.
عرف إزاحة_إطار_تصحيح(الحقائق: &حقائق_قيم_دالة_آلة_تصحيح, الإزاحة: طبيعي): عدد {
    أرجع (الإزاحة مثل عدد) - ((*الحقائق).إزاحة_الإطار مثل عدد);
}

// The first byte of code after position الموضع.
عرف أول_بايت_بعد_موضع_تصحيح(الحقائق: &حقائق_قيم_دالة_آلة_تصحيح, الموضع: طبيعي): اختياري طبيعي {
    دع العدد: طبيعي = الطول((*الحقائق).بدايات_المواضع) مثل طبيعي;
    إذا (الموضع < العدد && (*الحقائق).نهايات_المواضع[الموضع] > (*الحقائق).بدايات_المواضع[الموضع]) {
        أرجع اختياري.موجود((*الحقائق).نهايات_المواضع[الموضع]);
    };
    دع م: متغير طبيعي = الموضع + 1;
    طالما (م < العدد) {
        إذا ((*الحقائق).نهايات_المواضع[م] > (*الحقائق).بدايات_المواضع[م]) {
            أرجع اختياري.موجود((*الحقائق).بدايات_المواضع[م]);
        };
        م := م + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The ranges where value القيمة is variable المتغير.
عرف مديات_قيمة_لمتغير_تصحيح(
    الحقائق: &حقائق_قيم_دالة_آلة_تصحيح,
    القيمة: طبيعي,
    بعنوان: منطقي,
    المديات: &متغير متجه مدى_قيمة_متغير_تصحيح
): فراغ {
    إذا (القيمة >= (الطول((*الحقائق).مقاطع_الحياة) مثل طبيعي)) { أرجع; };
    دع المقاطع: &متجه طبيعي = &(*الحقائق).مقاطع_الحياة[القيمة];
    دع عدد_المقاطع: طبيعي = الطول(*المقاطع) مثل طبيعي;
    إذا (عدد_المقاطع < 2) { أرجع; };
    // A value owning a frame slot (an aggregate, or a local whose address is
    // taken): that memory, from its definition on.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحقائق).قيم_المواضع_المحلية) مثل طبيعي)) {
        إذا ((*الحقائق).قيم_المواضع_المحلية[ف] == القيمة) {
            طابق أول_بايت_بعد_موضع_تصحيح(الحقائق, (*المقاطع)[0]) مع
            | اختياري.موجود(البداية) -> {
                دع الموقع: موقع_آلة_تصحيح = موقع_آلة_تصحيح.إطار(
                    إزاحة_إطار_تصحيح(الحقائق, (*الحقائق).إزاحات_المواضع_المحلية[ف])
                );
                ألحق_مدى_قيمة_تصحيح(المديات, البداية, (*الحقائق).نهاية_الدالة, الموقع);
            }
            | اختياري.لا_شيء -> { };
            أرجع;
        };
        ف := ف + 1;
    }
    // An aggregate built in another value's slot: that memory, from the
    // definition of its address on.
    إذا (بعنوان && القيمة < (الطول((*الحقائق).عناوين_الإطار) مثل طبيعي) && (*الحقائق).عناوين_الإطار[القيمة] != 0) {
        طابق أول_بايت_بعد_موضع_تصحيح(الحقائق, (*المقاطع)[0]) مع
        | اختياري.موجود(البداية) -> {
            دع الموقع: موقع_آلة_تصحيح = موقع_آلة_تصحيح.إطار(
                إزاحة_إطار_تصحيح(الحقائق, (*الحقائق).عناوين_الإطار[القيمة] - 1)
            );
            ألحق_مدى_قيمة_تصحيح(المديات, البداية, (*الحقائق).نهاية_الدالة, الموقع);
        }
        | اختياري.لا_شيء -> { };
        أرجع;
    };
    إذا (القيمة >= (الطول((*الحقائق).التخزين) مثل طبيعي)) { أرجع; };
    دع الموقع: متغير موقع_آلة_تصحيح = موقع_آلة_تصحيح.غير_متاح();
    طابق (*الحقائق).التخزين[القيمة] مع
    | تخزين_قيمة_آلة_تصحيح.بلا -> { أرجع; }
    | تخزين_قيمة_آلة_تصحيح.سجل(الرقم) -> {
        إذا (بعنوان) { الموقع := موقع_آلة_تصحيح.مكدس(الرقم, 0); }
        وإلا { الموقع := موقع_آلة_تصحيح.سجل(الرقم); };
    }
    | تخزين_قيمة_آلة_تصحيح.مكدس(الإزاحة) -> {
        إذا (بعنوان) { الموقع := موقع_آلة_تصحيح.إطار_غير_مباشر(إزاحة_إطار_تصحيح(الحقائق, الإزاحة)); }
        وإلا { الموقع := موقع_آلة_تصحيح.إطار(إزاحة_إطار_تصحيح(الحقائق, الإزاحة)); };
    };
    دع م: متغير طبيعي = 0;
    طالما (م + 1 < عدد_المقاطع) {
        ألحق_مقطع_قيمة_تصحيح(الحقائق, (*المقاطع)[م], (*المقاطع)[م + 1], الموقع, المديات);
        م := م + 2;
    }
}

// Orders a variable's ranges by start (insertion sort: a variable has few
// values) and cuts each one where the next begins: a later value of the
// variable replaces the earlier one, which is never shown again after it.
عرف رتب_مديات_متغير_تصحيح(المديات: &متغير متجه مدى_قيمة_متغير_تصحيح): فراغ {
    دع العدد: طبيعي = الطول(*المديات) مثل طبيعي;
    دع ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        دع ج: متغير طبيعي = ف;
        طالما (ج > 0 && (*المديات)[ج - 1].البداية > (*المديات)[ج].البداية) {
            دع المؤقت: مدى_قيمة_متغير_تصحيح = (*المديات)[ج - 1];
            (*المديات)[ج - 1] := (*المديات)[ج];
            (*المديات)[ج] := المؤقت;
            ج := ج - 1;
        }
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف + 1 < العدد) {
        إذا ((*المديات)[ف].النهاية > (*المديات)[ف + 1].البداية) {
            (*المديات)[ف].النهاية := (*المديات)[ف + 1].البداية;
        };
        ف := ف + 1;
    }
}

// Records the location ranges of every source variable bound to the values
// of function الدالة. Call after the line ranges of the function are recorded
// (سجل_مديات_شفرة_في_تصحيح_آلة_من_مدى resets the location ranges).
عام عرف سجل_مديات_قيم_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_منتقاة,
    الحقائق: &حقائق_قيم_دالة_آلة_تصحيح,
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط
): فراغ {
    دع موضع_الدالة: طبيعي;
    طابق موضع_دالة_تصحيح_آلة(السياق, الدالة) مع
    | اختياري.موجود(الموضع) -> { موضع_الدالة := الموضع; }
    | اختياري.لا_شيء -> { أرجع; };
    دع فهرس_الدالة: طبيعي = الدالة.القيمة;
    دع العقد: &عقد_تصحيح_مسير = &(*التصحيح).العقد;
    إذا (فهرس_الدالة >= (الطول((*العقد).متغيرات_القيم) مثل طبيعي)) { أرجع; };
    دع جدول: &متجه متجه معرف_متغير_تصحيح = &(*العقد).متغيرات_القيم[فهرس_الدالة];
    // The distinct variables in order of first binding, with their ranges.
    دع المتغيرات: متغير متجه طبيعي = [];
    دع المديات: متغير متجه متجه مدى_قيمة_متغير_تصحيح = [];
    دع ق: متغير طبيعي = 0;
    طالما (ق < (الطول(*جدول) مثل طبيعي)) {
        دع المرتبطة: &متجه معرف_متغير_تصحيح = &(*جدول)[ق];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*المرتبطة) مثل طبيعي)) {
            دع المتغير: طبيعي = (*المرتبطة)[ف].القيمة;
            إذا (المتغير < (الطول((*التصحيح).الدلالي.المتغيرات) مثل طبيعي)) {
                دع الموضع: متغير اختياري طبيعي = اختياري.لا_شيء();
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(المتغيرات) مثل طبيعي)) {
                    إذا (المتغيرات[م] == المتغير) { الموضع := اختياري.موجود(م); م := الطول(المتغيرات) مثل طبيعي; } وإلا { م := م + 1; };
                }
                دع موضع_المتغير: متغير طبيعي = 0;
                طابق الموضع مع
                | اختياري.موجود(الموجود) -> { موضع_المتغير := الموجود; }
                | اختياري.لا_شيء -> {
                    موضع_المتغير := الطول(المتغيرات) مثل طبيعي;
                    ألحق(المتغيرات, المتغير);
                    دع فارغة: متجه مدى_قيمة_متغير_تصحيح = [];
                    ألحق(المديات, فارغة);
                };
                دع النوع: معرف_نوع = (*التصحيح).الدلالي.المتغيرات[المتغير].النوع;
                دع بعنوان: منطقي = نوع_بعنوان_تصحيح(الأنواع, الهدف, سجل_التخطيط, النوع);
                مديات_قيمة_لمتغير_تصحيح(الحقائق, ق, بعنوان, &متغير المديات[موضع_المتغير]);
            };
            ف := ف + 1;
        }
        ق := ق + 1;
    }
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(المتغيرات) مثل طبيعي)) {
        رتب_مديات_متغير_تصحيح(&متغير المديات[م]);
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(المديات[م]) مثل طبيعي)) {
            إذا (المديات[م][ر].النهاية > المديات[م][ر].البداية) {
                دع المدى: مدى_موقع_آلة_تصحيح = {
                    المتغير: معرف_متغير_تصحيح_من(المتغيرات[م]),
                    بداية_بايت: المديات[م][ر].البداية,
                    نهاية_بايت: المديات[م][ر].النهاية,
                    الموقع: المديات[م][ر].الموقع
                };
                ألحق((*السياق).الدوال[موضع_الدالة].مديات_المواقع, المدى);
            };
            ر := ر + 1;
        }
        م := م + 1;
    }
}
