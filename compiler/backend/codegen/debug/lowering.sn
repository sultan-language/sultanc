عام عرف هيئ_سياق_تصحيح_آلة(): سياق_تصحيح_آلة {
    أرجع سياق_تصحيح_آلة_جديد();
}

عام عرف سجل_إطار_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    العقد: &عقد_تصحيح_مسير,
    الدالة: معرف_دالة_منتقاة,
    الحجم: غير_موقع
): فراغ {
    طابق موضع_دالة_تصحيح_آلة(السياق, الدالة) مع
    | اختيار.بعض(الموضع) -> {
        (*السياق).الدوال[الموضع].حجم_إطار_بايت := الحجم;
        أرجع;
    }
    | اختيار.لا_شيء -> { };
    // Ensure a function machine-debug owner exists even when it has only frame facts.
    دع دالة_مسير: معرف_دالة_مسير = معرف_دالة_مسير_من(الدالة.القيمة);
    دع معرف_التصحيح: اختيار معرف_دالة_تصحيح = دالة_تصحيح_لمسير(العقد, دالة_مسير);
    دع الانتقالات: متجه انتقال_موقع_آلة_تصحيح = [];
    دع فهرس_الانتقالات: متجه فهرس_موقع_آلة_تصحيح = [];
    دع المديات: متجه مدى_موقع_آلة_تصحيح = [];
    دع السطور: متجه مدى_سطر_آلة_تصحيح = [];
    دع مديات_النطاقات: متجه مدى_نطاق_آلة_تصحيح = [];
    دع فهرس_النطاقات: متجه فهرس_نطاق_آلة_تصحيح = [];
    دع الوصف: تصحيح_دالة_آلة = {
        الدالة: الدالة, دالة_التصحيح: معرف_التصحيح, حجم_إطار_بايت: الحجم,
        انتقالات_المواقع: الانتقالات, انتقالات_بالموقع: فهرس_الانتقالات, مديات_المواقع: المديات,
        مديات_السطور: السطور, مديات_النطاقات: مديات_النطاقات,
        مديات_النطاقات_بالمعرف: فهرس_النطاقات
    };
    دع الموضع: غير_موقع = الطول((*السياق).الدوال) مثل غير_موقع;
    ألحق((*السياق).الدوال, الوصف);
    اربط_موضع_دالة_تصحيح_آلة(السياق, الدالة, الموضع);
}

عام عرف سجل_سطور_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_منتقاة,
    الأصول: &متجه مدى_شفرة_آلة_بأصل
): فراغ {
    سجل_مديات_شفرة_في_تصحيح_آلة(السياق, الدالة, الأصول);
}

عام عرف سجل_انسكابات_ذراع_في_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_منتقاة,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_ذراع_أربعة_وستون
): فراغ {
    سجل_إطار_تصحيح_آلة(السياق, &(*التصحيح).العقد, الدالة, (*الإطار).الحجم_بايت);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الإطار).المواقع) مثل غير_موقع)) {
        طابق موقع_آلة_من_انسكاب(الهدف, (*الإطار).المواقع[ف].إزاحة_بايت) مع
        | اختيار.بعض(الموقع) -> {
            // Spill storage supersedes the register assignment for this value.
            سجل_تعيين_موقع_افتراضي_تصحيح_آلة(
                السياق, التصحيح, الدالة, (*الإطار).المواقع[ف].السجل, الموقع
            );
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
}

عام عرف سجل_انسكابات_إكس_في_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_منتقاة,
    الهدف: &واصف_هدف,
    الإطار: &إطار_انسكاب_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    سجل_إطار_تصحيح_آلة(السياق, &(*التصحيح).العقد, الدالة, (*الإطار).الحجم_بايت);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الإطار).المواقع) مثل غير_موقع)) {
        طابق موقع_آلة_من_انسكاب(الهدف, (*الإطار).المواقع[ف].إزاحة_بايت) مع
        | اختيار.بعض(الموقع) -> {
            سجل_تعيين_موقع_افتراضي_تصحيح_آلة(
                السياق, التصحيح, الدالة, (*الإطار).المواقع[ف].السجل, الموقع
            );
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
}
