استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.debug.model;
استورد compiler.backend.codegen.debug.location;
استورد compiler.msir.debug_contract;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.target.target_model;
استورد compiler.source.provenance;
استورد compiler.backend.codegen.virtual_registers;
استورد compiler.msir.identifiers;

عام عرف ضمن_دالة_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    العقد: &عقد_تصحيح_مسير,
    الدالة: معرف_دالة_منتقاة
): طبيعي {
    طابق موضع_دالة_تصحيح_آلة(السياق, الدالة) مع
    | اختياري.موجود(الموضع) -> { أرجع الموضع; }
    | اختياري.لا_شيء -> { };
    دع دالة_مسير: معرف_دالة_مسير = معرف_دالة_مسير_من(الدالة.القيمة);
    دع معرف_التصحيح: اختياري معرف_دالة_تصحيح = دالة_تصحيح_لمسير(العقد, دالة_مسير);
    دع الانتقالات: متجه انتقال_موقع_آلة_تصحيح = [];
    دع فهرس_الانتقالات: متجه فهرس_موقع_آلة_تصحيح = [];
    دع رؤوس_المواقع: متجه اختياري طبيعي = [];
    دع المديات: متجه مدى_موقع_آلة_تصحيح = [];
    دع السطور: متجه مدى_سطر_آلة_تصحيح = [];
    دع مديات_النطاقات: متجه مدى_نطاق_آلة_تصحيح = [];
    دع فهرس_النطاقات: متجه فهرس_نطاق_آلة_تصحيح = [];
    دع رؤوس_النطاقات: متجه اختياري طبيعي = [];
    دع الوصف: تصحيح_دالة_آلة = {
        الدالة: الدالة,
        دالة_التصحيح: معرف_التصحيح,
        حجم_إطار_بايت: 0,
        انتقالات_المواقع: الانتقالات,
        انتقالات_بالموقع: فهرس_الانتقالات, رؤوس_المواقع: رؤوس_المواقع,
        مديات_المواقع: المديات,
        مديات_السطور: السطور,
        مديات_النطاقات: مديات_النطاقات,
        مديات_النطاقات_بالمعرف: فهرس_النطاقات, رؤوس_النطاقات: رؤوس_النطاقات
    };
    دع الموضع: طبيعي = الطول((*السياق).الدوال) مثل طبيعي;
    ألحق((*السياق).الدوال, الوصف);
    اربط_موضع_دالة_تصحيح_آلة(السياق, الدالة, الموضع);
    أرجع الموضع;
}

عرف سجل_انتقال_متغير_في_موقع(
    الدالة: &متغير تصحيح_دالة_آلة,
    المتغير: معرف_متغير_تصحيح,
    موقع_التصحيح: اختياري معرف_موقع_تصحيح,
    الأصل: معرف_أصل_مصدر,
    السجل_الافتراضي: معرف_سجل_افتراضي,
    الموقع: موقع_آلة_تصحيح
): فراغ {
    // Register assignment followed by spill for the same value must update the
    // same location fact rather than produce contradictory parallel entries.
    طابق موقع_التصحيح مع
    | اختياري.موجود(معرف_الموقع) -> {
        دع موضع_الفهرس: طبيعي = ضمن_فهرس_موقع_تصحيح_آلة(الدالة, معرف_الموقع);
        دع الفهارس: &متجه طبيعي = &(*الدالة).انتقالات_بالموقع[موضع_الفهرس].الفهارس;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الفهارس) مثل طبيعي)) {
            دع موضع_الانتقال: طبيعي = (*الفهارس)[ف];
            إذا ((*الدالة).انتقالات_المواقع[موضع_الانتقال].المتغير.القيمة == المتغير.القيمة) {
                (*الدالة).انتقالات_المواقع[موضع_الانتقال].السجل_الافتراضي := السجل_الافتراضي.القيمة;
                (*الدالة).انتقالات_المواقع[موضع_الانتقال].الموقع := الموقع;
                أرجع;
            };
            ف := ف + 1;
        }
        دع الانتقال: انتقال_موقع_آلة_تصحيح = {
            المتغير: المتغير,
            موقع_التصحيح: موقع_التصحيح,
            الأصل: الأصل,
            السجل_الافتراضي: السجل_الافتراضي.القيمة,
            الموقع: الموقع
        };
        دع الموضع: طبيعي = الطول((*الدالة).انتقالات_المواقع) مثل طبيعي;
        ألحق((*الدالة).انتقالات_المواقع, الانتقال);
        ألحق((*الدالة).انتقالات_بالموقع[موضع_الفهرس].الفهارس, الموضع);
    }
    | اختياري.لا_شيء -> {
        دع الانتقال: انتقال_موقع_آلة_تصحيح = {
            المتغير: المتغير,
            موقع_التصحيح: موقع_التصحيح,
            الأصل: الأصل,
            السجل_الافتراضي: السجل_الافتراضي.القيمة,
            الموقع: الموقع
        };
        ألحق((*الدالة).انتقالات_المواقع, الانتقال);
    };
}

عرف سجل_انتقالات_لقيمة(
    الدالة: &متغير تصحيح_دالة_آلة,
    العقد: &عقد_تصحيح_مسير,
    الدلالي: &سياق_تصحيح,
    معرف_الدالة: معرف_دالة_منتقاة,
    السجل_الافتراضي: معرف_سجل_افتراضي,
    الموقع: موقع_آلة_تصحيح
): فراغ {
    دع قيمة_مسير: معرف_قيمة_مسير = معرف_قيمة_مسير_من(
        معرف_دالة_مسير_من(معرف_الدالة.القيمة), السجل_الافتراضي.القيمة
    );
    دع المتغيرات: متجه معرف_متغير_تصحيح = متغيرات_تصحيح_لقيمة(العقد, قيمة_مسير);
    دع موقع_التصحيح: اختياري معرف_موقع_تصحيح = موقع_تصحيح_لقيمة(العقد, قيمة_مسير);
    دع الأصل: متغير معرف_أصل_مصدر = { القيمة: 0 };
    طابق موقع_التصحيح مع
    | اختياري.موجود(معرف_الموقع) -> {
        إذا (معرف_الموقع.القيمة < (الطول((*الدلالي).المواقع) مثل طبيعي)) {
            الأصل := (*الدلالي).المواقع[معرف_الموقع.القيمة].الأصل;
        };
    }
    | اختياري.لا_شيء -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المتغيرات) مثل طبيعي)) {
        سجل_انتقال_متغير_في_موقع(
            الدالة, المتغيرات[ف], موقع_التصحيح, الأصل, السجل_الافتراضي, الموقع
        );
        ف := ف + 1;
    }
}

عام عرف سجل_تعيينات_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    العقد: &عقد_تصحيح_مسير,
    الدلالي: &سياق_تصحيح,
    الدالة: معرف_دالة_منتقاة,
    الهدف: &واصف_هدف,
    التعيينات: &متجه تعيين_سجل
): فراغ {
    دع السياق_المتغير: متغير &متغير سياق_تصحيح_آلة = السياق;
    دع موضع: طبيعي = ضمن_دالة_آلة(السياق_المتغير, العقد, الدالة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التعيينات) مثل طبيعي)) {
        طابق موقع_آلة_من_سجل_فعلي(الهدف, (*التعيينات)[ف].الفعلي) مع
        | اختياري.موجود(الموقع) -> {
            سجل_انتقالات_لقيمة(&متغير (*السياق_المتغير).الدوال[موضع], العقد, الدلالي, الدالة, (*التعيينات)[ف].الافتراضي, الموقع);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
}

عام عرف سجل_تعيين_موقع_افتراضي_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_منتقاة,
    السجل: معرف_سجل_افتراضي,
    الموقع: موقع_آلة_تصحيح
): فراغ {
    دع السياق_المتغير: متغير &متغير سياق_تصحيح_آلة = السياق;
    دع موضع: طبيعي = ضمن_دالة_آلة(السياق_المتغير, &(*التصحيح).العقد, الدالة);
    سجل_انتقالات_لقيمة(
        &متغير (*السياق_المتغير).الدوال[موضع], &(*التصحيح).العقد, &(*التصحيح).الدلالي,
        الدالة, السجل, الموقع
    );
}
