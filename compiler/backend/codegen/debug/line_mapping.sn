استورد compiler.backend.codegen.debug.model;
استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;

// Compact DebugLocID survives the complete MSIR -> machine path. This owner
// turns encoded machine ranges into line and variable-location ranges once;
// DWARF never rescans source provenance or register-allocation state.
عام عرف سجل_مديات_شفرة_في_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة,
    الأصول: &متجه مدى_شفرة_آلة_بأصل
): فراغ {
    دع موضع_الدالة: غير_موقع;
    طابق موضع_دالة_تصحيح_آلة(السياق, الدالة) مع
    | اختيار.بعض(الموضع) -> { موضع_الدالة := الموضع; }
    | اختيار.لا_شيء -> { أرجع; };

    دع سطور_فارغة: متجه مدى_سطر_آلة_تصحيح = [];
    دع مواقع_فارغة: متجه مدى_موقع_آلة_تصحيح = [];
    دع نطاقات_فارغة: متجه مدى_نطاق_آلة_تصحيح = [];
    دع فهرس_نطاقات_فارغ: متجه فهرس_نطاق_آلة_تصحيح = [];
    (*السياق).الدوال[موضع_الدالة].مديات_السطور := سطور_فارغة;
    (*السياق).الدوال[موضع_الدالة].مديات_المواقع := مواقع_فارغة;
    (*السياق).الدوال[موضع_الدالة].مديات_النطاقات := نطاقات_فارغة;
    (*السياق).الدوال[موضع_الدالة].مديات_النطاقات_بالمعرف := فهرس_نطاقات_فارغ;

    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأصول) مثل غير_موقع)) {
        دع المدى: &مدى_شفرة_آلة_بأصل = &(*الأصول)[ف];
        لو (معرفا_دالة_منتقاة_متساويان((*المدى).الدالة, الدالة)) {
            دع بداية: غير_موقع = (*المدى).إزاحة_بايت;
            دع نهاية: غير_موقع = بداية + (*المدى).حجم_بايت;
            طابق (*المدى).نطاق_التصحيح مع
            | اختيار.بعض(معرف_النطاق) -> {
                دع موضع_فهرس_النطاق: غير_موقع = ضمن_فهرس_نطاق_تصحيح_آلة(
                    &متغير (*السياق).الدوال[موضع_الدالة], معرف_النطاق
                );
                لو (نهاية > بداية) {
                    دع مدى_النطاق: مدى_نطاق_آلة_تصحيح = { النطاق: معرف_النطاق, بداية_بايت: بداية, نهاية_بايت: نهاية };
                    دع موضع_النطاق: غير_موقع = الطول((*السياق).الدوال[موضع_الدالة].مديات_النطاقات) مثل غير_موقع;
                    ألحق((*السياق).الدوال[موضع_الدالة].مديات_النطاقات, مدى_النطاق);
                    ألحق((*السياق).الدوال[موضع_الدالة].مديات_النطاقات_بالمعرف[موضع_فهرس_النطاق].الفهارس, موضع_النطاق);
                };
            }
            | اختيار.لا_شيء -> { };
            طابق (*المدى).موقع_التصحيح مع
            | اختيار.بعض(الموقع) -> {
                لو (نهاية > بداية) {
                    دع السطر: مدى_سطر_آلة_تصحيح = {
                        الدالة: الدالة,
                        بداية_بايت: بداية,
                        نهاية_بايت: نهاية,
                        الموقع: الموقع
                    };
                    ألحق((*السياق).الدوال[موضع_الدالة].مديات_السطور, السطر);

                    طابق موضع_فهرس_موقع_تصحيح_آلة(&(*السياق).الدوال[موضع_الدالة], الموقع) مع
                    | اختيار.بعض(موضع_فهرس_الموقع) -> {
                        دع الفهارس: &متجه غير_موقع = &(*السياق).الدوال[موضع_الدالة].انتقالات_بالموقع[موضع_فهرس_الموقع].الفهارس;
                        دع ت: متغير غير_موقع = 0;
                        بينما (ت < (الطول(*الفهارس) مثل غير_موقع)) {
                            دع موضع_الانتقال: غير_موقع = (*الفهارس)[ت];
                            لو (موضع_الانتقال < (الطول((*السياق).الدوال[موضع_الدالة].انتقالات_المواقع) مثل غير_موقع)) {
                                دع الانتقال: &انتقال_موقع_آلة_تصحيح = &(*السياق).الدوال[موضع_الدالة].انتقالات_المواقع[موضع_الانتقال];
                                دع متغير_الانتقال: معرف_متغير_تصحيح = (*الانتقال).المتغير;
                                دع موقع_الانتقال: موقع_آلة_تصحيح = (*الانتقال).الموقع;
                                دع مدى_الموقع: مدى_موقع_آلة_تصحيح = {
                                    المتغير: متغير_الانتقال,
                                    بداية_بايت: بداية,
                                    نهاية_بايت: نهاية,
                                    الموقع: موقع_الانتقال
                                };
                                ألحق((*السياق).الدوال[موضع_الدالة].مديات_المواقع, مدى_الموقع);
                            };
                            ت := ت + 1;
                        }
                    }
                    | اختيار.لا_شيء -> { };
                };
            }
            | اختيار.لا_شيء -> { };
        };
        ف := ف + 1;
    }
}
