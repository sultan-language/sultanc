استورد compiler.backend.codegen.debug.model;
استورد compiler.debuginfo.model;
استورد compiler.backend.codegen.selected_code_core;

// Compact DebugLocID survives the complete MSIR -> machine path. This owner
// turns encoded machine ranges into line and variable-location ranges once;
// DWARF never rescans source provenance or register-allocation state.
// Read a bounded view of the canonical encoded-origin vector. Native x86
// appends origins from successive functions to one owned vector, so materializing
// a second vector per function would retain duplicate provenance allocations.
عام عرف سجل_مديات_شفرة_في_تصحيح_آلة_من_مدى(
    السياق: &متغير سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة,
    الأصول: &متجه مدى_شفرة_آلة_بأصل,
    البداية: طبيعي,
    النهاية: طبيعي
): فراغ {
    لو (البداية > النهاية || النهاية > (الطول(*الأصول) مثل طبيعي)) { أرجع; };
    دع موضع_الدالة: طبيعي;
    طابق موضع_دالة_تصحيح_آلة(السياق, الدالة) مع
    | اختياري.موجود(الموضع) -> { موضع_الدالة := الموضع; }
    | اختياري.لا_شيء -> { أرجع; };

    دع سطور_فارغة: متجه مدى_سطر_آلة_تصحيح = [];
    دع مواقع_فارغة: متجه مدى_موقع_آلة_تصحيح = [];
    دع نطاقات_فارغة: متجه مدى_نطاق_آلة_تصحيح = [];
    دع فهرس_نطاقات_فارغ: متجه فهرس_نطاق_آلة_تصحيح = [];
    دع رؤوس_نطاقات_فارغة: متجه اختياري طبيعي = [];
    (*السياق).الدوال[موضع_الدالة].مديات_السطور := سطور_فارغة;
    (*السياق).الدوال[موضع_الدالة].مديات_المواقع := مواقع_فارغة;
    (*السياق).الدوال[موضع_الدالة].مديات_النطاقات := نطاقات_فارغة;
    (*السياق).الدوال[موضع_الدالة].مديات_النطاقات_بالمعرف := فهرس_نطاقات_فارغ;
    (*السياق).الدوال[موضع_الدالة].رؤوس_النطاقات := رؤوس_نطاقات_فارغة;

    // Each transition has one canonical variable and machine location. A run of
    // adjacent encoded ranges need only one DWARF variable-location interval.
    // Keep the last range position for each existing transition, not a second
    // copy of machine locations; zero denotes no range yet.
    دع آخر_مدى: متغير متجه طبيعي = [];
    دع تهيئة: متغير طبيعي = 0;
    طالما (تهيئة < (الطول((*السياق).الدوال[موضع_الدالة].انتقالات_المواقع) مثل طبيعي)) {
        ألحق(آخر_مدى, 0);
        تهيئة := تهيئة + 1;
    }
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع المدى: &مدى_شفرة_آلة_بأصل = &(*الأصول)[ف];
        لو (معرفا_دالة_منتقاة_متساويان((*المدى).الدالة, الدالة)) {
            دع بداية: طبيعي = (*المدى).إزاحة_بايت;
            دع نهاية: طبيعي = بداية + (*المدى).حجم_بايت;
            طابق (*المدى).نطاق_التصحيح مع
            | اختياري.موجود(معرف_النطاق) -> {
                دع موضع_فهرس_النطاق: طبيعي = ضمن_فهرس_نطاق_تصحيح_آلة(
                    &متغير (*السياق).الدوال[موضع_الدالة], معرف_النطاق
                );
                لو (نهاية > بداية) {
                    // The per-scope index already records the last interval;
                    // extend adjacent ranges without duplicating the same scope.
                    دع الفهارس: &متجه طبيعي = &(*السياق).الدوال[موضع_الدالة].مديات_النطاقات_بالمعرف[موضع_فهرس_النطاق].الفهارس;
                    دع متصل: متغير منطقي = خطأ;
                    لو ((الطول(*الفهارس) مثل طبيعي) > 0) {
                        دع آخر: طبيعي = (*الفهارس)[(الطول(*الفهارس) مثل طبيعي) - 1];
                        لو ((*السياق).الدوال[موضع_الدالة].مديات_النطاقات[آخر].نهاية_بايت == بداية) {
                            (*السياق).الدوال[موضع_الدالة].مديات_النطاقات[آخر].نهاية_بايت := نهاية;
                            متصل := صواب;
                        };
                    };
                    لو (!متصل) {
                        دع مدى_النطاق: مدى_نطاق_آلة_تصحيح = { النطاق: معرف_النطاق, بداية_بايت: بداية, نهاية_بايت: نهاية };
                        دع موضع_النطاق: طبيعي = الطول((*السياق).الدوال[موضع_الدالة].مديات_النطاقات) مثل طبيعي;
                        ألحق((*السياق).الدوال[موضع_الدالة].مديات_النطاقات, مدى_النطاق);
                        ألحق((*السياق).الدوال[موضع_الدالة].مديات_النطاقات_بالمعرف[موضع_فهرس_النطاق].الفهارس, موضع_النطاق);
                    };
                };
            }
            | اختياري.لا_شيء -> { };
            طابق (*المدى).موقع_التصحيح مع
            | اختياري.موجود(الموقع) -> {
                لو (نهاية > بداية) {
                    دع العدد_السابق: طبيعي = الطول((*السياق).الدوال[موضع_الدالة].مديات_السطور) مثل طبيعي;
                    دع سطر_متصل: متغير منطقي = خطأ;
                    لو (العدد_السابق > 0) {
                        دع آخر: طبيعي = العدد_السابق - 1;
                        لو ((*السياق).الدوال[موضع_الدالة].مديات_السطور[آخر].نهاية_بايت == بداية
                            && (*السياق).الدوال[موضع_الدالة].مديات_السطور[آخر].الموقع.القيمة == الموقع.القيمة) {
                            (*السياق).الدوال[موضع_الدالة].مديات_السطور[آخر].نهاية_بايت := نهاية;
                            سطر_متصل := صواب;
                        };
                    };
                    لو (!سطر_متصل) {
                        دع السطر: مدى_سطر_آلة_تصحيح = {
                            الدالة: الدالة,
                            بداية_بايت: بداية,
                            نهاية_بايت: نهاية,
                            الموقع: الموقع
                        };
                        ألحق((*السياق).الدوال[موضع_الدالة].مديات_السطور, السطر);
                    };

                    طابق موضع_فهرس_موقع_تصحيح_آلة(&(*السياق).الدوال[موضع_الدالة], الموقع) مع
                    | اختياري.موجود(موضع_فهرس_الموقع) -> {
                        // The loop appends to this function's location ranges through
                        // السياق, so the index list is read through السياق each time
                        // rather than through a reference held across the append.
                        دع ت: متغير طبيعي = 0;
                        طالما (ت < (الطول((*السياق).الدوال[موضع_الدالة].انتقالات_بالموقع[موضع_فهرس_الموقع].الفهارس) مثل طبيعي)) {
                            دع موضع_الانتقال: طبيعي = (*السياق).الدوال[موضع_الدالة].انتقالات_بالموقع[موضع_فهرس_الموقع].الفهارس[ت];
                            لو (موضع_الانتقال < (الطول((*السياق).الدوال[موضع_الدالة].انتقالات_المواقع) مثل طبيعي)) {
                                دع الانتقال: &انتقال_موقع_آلة_تصحيح = &(*السياق).الدوال[موضع_الدالة].انتقالات_المواقع[موضع_الانتقال];
                                دع متغير_الانتقال: معرف_متغير_تصحيح = (*الانتقال).المتغير;
                                دع موقع_الانتقال: موقع_آلة_تصحيح = (*الانتقال).الموقع;
                                دع موضع_آخر: طبيعي = آخر_مدى[موضع_الانتقال];
                                دع اتصل: متغير منطقي = خطأ;
                                لو (موضع_آخر != 0) {
                                    دع السابق: طبيعي = موضع_آخر - 1;
                                    لو ((*السياق).الدوال[موضع_الدالة].مديات_المواقع[السابق].نهاية_بايت == بداية) {
                                        (*السياق).الدوال[موضع_الدالة].مديات_المواقع[السابق].نهاية_بايت := نهاية;
                                        اتصل := صواب;
                                    };
                                };
                                لو (!اتصل) {
                                    دع مدى_الموقع: مدى_موقع_آلة_تصحيح = {
                                        المتغير: متغير_الانتقال,
                                        بداية_بايت: بداية,
                                        نهاية_بايت: نهاية,
                                        الموقع: موقع_الانتقال
                                    };
                                    ألحق((*السياق).الدوال[موضع_الدالة].مديات_المواقع, مدى_الموقع);
                                    آخر_مدى[موضع_الانتقال] := الطول((*السياق).الدوال[موضع_الدالة].مديات_المواقع) مثل طبيعي;
                                };
                            };
                            ت := ت + 1;
                        }
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
}

// Existing consumers with a function-local vector use the same canonical path.
عام عرف سجل_مديات_شفرة_في_تصحيح_آلة(
    السياق: &متغير سياق_تصحيح_آلة,
    الدالة: معرف_دالة_منتقاة,
    الأصول: &متجه مدى_شفرة_آلة_بأصل
): فراغ {
    سجل_مديات_شفرة_في_تصحيح_آلة_من_مدى(
        السياق, الدالة, الأصول, 0, الطول(*الأصول) مثل طبيعي
    );
}
