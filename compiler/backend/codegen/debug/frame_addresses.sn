// Which virtual registers hold a constant frame address (an aggregate's
// storage inside a frame stack slot), for source-variable locations
// (value_ranges.sn). Architecture allocators list the frame-address
// definitions of their selected code; nothing here knows an instruction set.

// A frame-address definition of a virtual register, in position order.
عام نوع مصدر_عنوان_إطار_تصحيح =
    // The address of a frame stack slot (its offset from the stack pointer).
    | خانة بنوع طبيعي
    // Another register plus a constant.
    | إزاحة بنوع (طبيعي, طبيعي)
    // A copy of another register.
    | نسخة بنوع طبيعي
;

عام نوع تعريف_عنوان_إطار_تصحيح = {
    السجل: طبيعي,
    المصدر: مصدر_عنوان_إطار_تصحيح
};

// The frame-address table of a function (حقائق_قيم_دالة_آلة_تصحيح.
// عناوين_الإطار): a register qualifies when all its definitions
// (عدد_التعريفات, every instruction and edge-move definition) are
// frame-address definitions that agree: one offset, or a slot address the
// following definitions advance in place (d := d + constant), whose final
// offset it keeps.
عام عرف عناوين_إطار_تصحيح(
    عدد_السجلات: طبيعي,
    عدد_التعريفات: &متجه طبيعي,
    التعريفات: &متجه تعريف_عنوان_إطار_تصحيح
): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع العدد: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_السجلات) { ألحق(الناتج, 0); ألحق(العدد, 0); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(*التعريفات) مثل طبيعي)) {
        دع السجل: طبيعي = (*التعريفات)[ف].السجل;
        إذا (السجل < عدد_السجلات) { العدد[السجل] := العدد[السجل] + 1; };
        ف := ف + 1;
    }
    // Rounds: a register's base resolves in an earlier round.
    دع الجولة: متغير طبيعي = 0;
    دع تغير: متغير منطقي = صواب;
    طالما (تغير && الجولة < 8) {
        تغير := خطأ;
        دع الأخير: متغير متجه طبيعي = [];
        دع صالح: متغير متجه منطقي = [];
        ف := 0;
        طالما (ف < عدد_السجلات) { ألحق(الأخير, 0); ألحق(صالح, صواب); ف := ف + 1; }
        ف := 0;
        طالما (ف < (الطول(*التعريفات) مثل طبيعي)) {
            دع السجل: طبيعي = (*التعريفات)[ف].السجل;
            إذا (السجل < عدد_السجلات) {
                دع القيمة: متغير طبيعي = 0;
                دع متسلسل: متغير منطقي = خطأ;
                طابق (*التعريفات)[ف].المصدر مع
                | مصدر_عنوان_إطار_تصحيح.خانة(الإزاحة) -> { القيمة := الإزاحة + 1; }
                | مصدر_عنوان_إطار_تصحيح.إزاحة(الأساس, الإضافة) -> {
                    إذا (الأساس == السجل) {
                        متسلسل := صواب;
                        إذا (الأخير[السجل] != 0) { القيمة := الأخير[السجل] + الإضافة; };
                    } وإلا إذا (الأساس < عدد_السجلات && الناتج[الأساس] != 0) {
                        القيمة := الناتج[الأساس] + الإضافة;
                    };
                }
                | مصدر_عنوان_إطار_تصحيح.نسخة(المصدر) -> {
                    إذا (المصدر < عدد_السجلات) { القيمة := الناتج[المصدر]; };
                };
                إذا (القيمة == 0) { صالح[السجل] := خطأ; };
                إذا (!متسلسل && الأخير[السجل] != 0 && القيمة != الأخير[السجل]) { صالح[السجل] := خطأ; };
                الأخير[السجل] := القيمة;
            };
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < عدد_السجلات) {
            دع الجديد: متغير طبيعي = 0;
            إذا (صالح[ف] && العدد[ف] > 0 && ف < (الطول(*عدد_التعريفات) مثل طبيعي)
                && العدد[ف] == (*عدد_التعريفات)[ف]) {
                الجديد := الأخير[ف];
            };
            إذا (الجديد != الناتج[ف]) { الناتج[ف] := الجديد; تغير := صواب; };
            ف := ف + 1;
        }
        الجولة := الجولة + 1;
    }
    أرجع الناتج;
}
