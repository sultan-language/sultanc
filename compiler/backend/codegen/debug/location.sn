استورد compiler.backend.codegen.debug.model;
استورد compiler.backend.target.register_query_context;
استورد compiler.backend.target.target_model;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.virtual_registers;

عام عرف موقع_آلة_من_سجل_فعلي(
    الهدف: &واصف_هدف,
    السجل: معرف_سجل_فعلي
): اختياري موقع_آلة_تصحيح {
    طابق رقم_سجل_دوارف_للهدف(الهدف, السجل) مع
    | اختياري.موجود(الرقم) -> { أرجع اختياري.موجود(موقع_آلة_تصحيح.سجل(الرقم)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف موقع_آلة_من_انسكاب(
    الهدف: &واصف_هدف,
    الإزاحة: طبيعي
): اختياري موقع_آلة_تصحيح {
    طابق رقم_مؤشر_المكدس_دوارف_للهدف(الهدف) مع
    | اختياري.موجود(السجل) -> { أرجع اختياري.موجود(موقع_آلة_تصحيح.مكدس(السجل, الإزاحة)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}
