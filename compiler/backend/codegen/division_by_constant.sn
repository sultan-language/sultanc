// Division and remainder by a constant without a divide instruction, shared by
// the native selectors (x86-64, ARM64). The plans are LLVM's
// (UnsignedDivisionByConstantInfo / SignedDivisionByConstantInfo in
// llvm/lib/Support/DivisionByConstantInfo.cpp, used by TargetLowering::
// BuildUDIV / BuildSDIV), which follow Hacker's Delight, 2nd ed., chapter 10
// (figures 10-1 and 10-2) and Granlund & Montgomery, "Division by Invariant
// Integers using Multiplication" (PLDI 1994).
//
// Every width is computed on the 64-bit register: an N-bit operand is first
// zero- or sign-extended to 64 bits, and the 64-bit quotient of that value by
// the constant is the N-bit quotient (it fits, because the divisor is never 0
// or -1; those keep the trapping divide). A remainder is x - q * d.
//
// Unsigned:   q = mulhu(x >> pre, magic); with add: q = ((x - q) >> 1) + q;
//             q >>= post.  A power of two 2^k: q = x >> k, r = x & (2^k - 1).
// Signed:     q = mulhs(x, magic) (+ x if d > 0 and magic < 0, - x if d < 0
//             and magic > 0); q >>= shift (arithmetic); q += q >>u 63.
//             |d| = 2^k: q = (x + ((x >>s 63) >>u (64 - k))) >>s k, negated
//             for d < 0.

مرادف جمع_ملتف_قسمة_ثابت = بدائي_جمع_ملتف;
مرادف طرح_ملتف_قسمة_ثابت = بدائي_طرح_ملتف;

عام نوع خطة_قسمة_طبيعية_على_ثابت = {
    المضاعف: طبيعي,
    جمع: منطقي,
    إزاحة_قبلية: طبيعي,
    إزاحة_بعدية: طبيعي
};

عام نوع خطة_قسمة_موقعة_على_ثابت = {
    المضاعف: طبيعي,
    الإزاحة: طبيعي
};

عرف ضاعف_ملتف_قسمة_ثابت(القيمة: طبيعي): طبيعي {
    دع نصف: طبيعي = (1 مثل طبيعي) << 63;
    أرجع (القيمة & (نصف - 1)) << 1;
}

// Whether the divisor (its 64-bit pattern) is a power of two, and which.
عام عرف أس_قوة_اثنين_قسمة_ثابت(القاسم: طبيعي): اختياري طبيعي {
    إذا (القاسم == 0 || (القاسم & (القاسم - 1)) != 0) { أرجع اختياري.لا_شيء(); };
    دع الأس: متغير طبيعي = 0;
    طالما (((القاسم >> الأس) & 1) == 0) { الأس := الأس + 1; }
    أرجع اختياري.موجود(الأس);
}

// The unsigned plan for 1 < d (not a power of two), on 64-bit values whose top
// الأصفار_البادئة bits are zero.
عرف خطة_قسمة_طبيعية_داخلية(
    القاسم: طبيعي,
    الأصفار_البادئة: طبيعي,
    السماح_بالزوجي: منطقي
): خطة_قسمة_طبيعية_على_ثابت {
    دع واحد: طبيعي = 1;
    دع الأدنى_الموقع: طبيعي = واحد << 63;
    دع الأقصى_الموقع: طبيعي = الأدنى_الموقع - 1;
    دع كل_الواحدات: متغير طبيعي = ~(0 مثل طبيعي);
    إذا (الأصفار_البادئة > 0) { كل_الواحدات := (واحد << (64 - الأصفار_البادئة)) - 1; };
    // NC: the largest dividend with NC mod d == d - 1.
    دع المؤقت: طبيعي = طرح_ملتف_قسمة_ثابت(جمع_ملتف_قسمة_ثابت(كل_الواحدات, 1), القاسم);
    دع ن_ج: طبيعي = كل_الواحدات - (المؤقت % القاسم);
    دع ب: متغير طبيعي = 63;
    دع ق1: متغير طبيعي = الأدنى_الموقع / ن_ج;
    دع ر1: متغير طبيعي = الأدنى_الموقع % ن_ج;
    دع ق2: متغير طبيعي = الأقصى_الموقع / القاسم;
    دع ر2: متغير طبيعي = الأقصى_الموقع % القاسم;
    دع جمع: متغير منطقي = خطأ;
    دع استمر: متغير منطقي = صواب;
    طالما (استمر) {
        ب := ب + 1;
        إذا (ر1 >= ن_ج - ر1) {
            إذا (ق1 >= الأقصى_الموقع) { جمع := صواب; };
            ق1 := ضاعف_ملتف_قسمة_ثابت(ق1) + 1;
            ر1 := طرح_ملتف_قسمة_ثابت(ضاعف_ملتف_قسمة_ثابت(ر1), ن_ج);
        } وإلا {
            إذا (ق1 >= الأدنى_الموقع) { جمع := صواب; };
            ق1 := ضاعف_ملتف_قسمة_ثابت(ق1);
            ر1 := ضاعف_ملتف_قسمة_ثابت(ر1);
        };
        إذا (ر2 + 1 >= القاسم - ر2) {
            إذا (ق2 >= الأقصى_الموقع) { جمع := صواب; };
            ق2 := ضاعف_ملتف_قسمة_ثابت(ق2) + 1;
            ر2 := طرح_ملتف_قسمة_ثابت(ضاعف_ملتف_قسمة_ثابت(ر2) + 1, القاسم);
        } وإلا {
            إذا (ق2 >= الأدنى_الموقع) { جمع := صواب; };
            ق2 := ضاعف_ملتف_قسمة_ثابت(ق2);
            ر2 := ضاعف_ملتف_قسمة_ثابت(ر2) + 1;
        };
        دع الفرق: طبيعي = القاسم - 1 - ر2;
        استمر := ب < 128 && (ق1 < الفرق || (ق1 == الفرق && ر1 == 0));
    }
    إذا (جمع && (القاسم & 1) == 0 && السماح_بالزوجي) {
        // An even divisor: shift its trailing zeros out of the dividend first,
        // which makes the multiplier fit without the add step.
        دع القبلية: متغير طبيعي = 0;
        طالما (((القاسم >> القبلية) & 1) == 0) { القبلية := القبلية + 1; }
        دع الداخلية: خطة_قسمة_طبيعية_على_ثابت = خطة_قسمة_طبيعية_داخلية(
            القاسم >> القبلية, الأصفار_البادئة + القبلية, خطأ
        );
        دع الناتج: خطة_قسمة_طبيعية_على_ثابت = {
            المضاعف: الداخلية.المضاعف,
            جمع: الداخلية.جمع,
            إزاحة_قبلية: القبلية,
            إزاحة_بعدية: الداخلية.إزاحة_بعدية
        };
        أرجع الناتج;
    };
    دع البعدية: متغير طبيعي = ب - 64;
    إذا (جمع) { البعدية := البعدية - 1; };
    دع الناتج: خطة_قسمة_طبيعية_على_ثابت = {
        المضاعف: جمع_ملتف_قسمة_ثابت(ق2, 1),
        جمع: جمع,
        إزاحة_قبلية: 0,
        إزاحة_بعدية: البعدية
    };
    أرجع الناتج;
}

// The unsigned plan for a divisor that is neither 0, 1 nor a power of two.
عام عرف خطة_قسمة_طبيعية_على_ثابت_من(القاسم: طبيعي): خطة_قسمة_طبيعية_على_ثابت {
    أرجع خطة_قسمة_طبيعية_داخلية(القاسم, 0, صواب);
}

// The signed plan for a divisor (its 64-bit two's-complement pattern) whose
// magnitude is neither 0, 1 nor a power of two.
عام عرف خطة_قسمة_موقعة_على_ثابت_من(القاسم: طبيعي): خطة_قسمة_موقعة_على_ثابت {
    دع واحد: طبيعي = 1;
    دع الأدنى_الموقع: طبيعي = واحد << 63;
    دع سالب: منطقي = (القاسم >> 63) != 0;
    دع المطلق: متغير طبيعي = القاسم;
    إذا (سالب) { المطلق := طرح_ملتف_قسمة_ثابت(0 مثل طبيعي, القاسم); };
    دع ت: طبيعي = الأدنى_الموقع + (القاسم >> 63);
    دع ن_ج: طبيعي = ت - 1 - (ت % المطلق);
    دع ب: متغير طبيعي = 63;
    دع ق1: متغير طبيعي = الأدنى_الموقع / ن_ج;
    دع ر1: متغير طبيعي = الأدنى_الموقع % ن_ج;
    دع ق2: متغير طبيعي = الأدنى_الموقع / المطلق;
    دع ر2: متغير طبيعي = الأدنى_الموقع % المطلق;
    دع استمر: متغير منطقي = صواب;
    طالما (استمر) {
        ب := ب + 1;
        // ر1 < ن_ج <= 2^63 and ر2 < المطلق <= 2^63: the doublings stay below 2^64.
        ق1 := ضاعف_ملتف_قسمة_ثابت(ق1);
        ر1 := ر1 * 2;
        إذا (ر1 >= ن_ج) { ق1 := ق1 + 1; ر1 := ر1 - ن_ج; };
        ق2 := ضاعف_ملتف_قسمة_ثابت(ق2);
        ر2 := ر2 * 2;
        إذا (ر2 >= المطلق) { ق2 := ق2 + 1; ر2 := ر2 - المطلق; };
        دع الفرق: طبيعي = المطلق - ر2;
        استمر := ق1 < الفرق || (ق1 == الفرق && ر1 == 0);
    }
    دع المضاعف: متغير طبيعي = جمع_ملتف_قسمة_ثابت(ق2, 1);
    إذا (سالب) { المضاعف := طرح_ملتف_قسمة_ثابت(0 مثل طبيعي, المضاعف); };
    دع الناتج: خطة_قسمة_موقعة_على_ثابت = { المضاعف: المضاعف, الإزاحة: ب - 64 };
    أرجع الناتج;
}

// Whether a division or remainder by this constant takes the multiply path:
// any divisor except 0 for unsigned values; signed divisors except 0, 1 and
// -1 (MIN / -1 must still trap).
عام عرف قسمة_على_ثابت_مدعومة(القاسم: طبيعي, موقع: منطقي): منطقي {
    إذا (القاسم == 0) { أرجع خطأ; };
    إذا (!موقع) { أرجع صواب; };
    دع كل_الواحدات: طبيعي = ~(0 مثل طبيعي);
    أرجع القاسم != 1 && القاسم != كل_الواحدات;
}
