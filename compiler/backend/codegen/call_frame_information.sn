استورد compiler.backend.target.register_query_context;
استورد compiler.backend.target.target_model;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.allocation_contract;

عام نوع نوع_حدث_فك_المكدس =
    | قاعدة_الإطار_حددت بنوع (طبيعي, طبيعي)
    | إزاحة_قاعدة_الإطار_تغيرت بنوع طبيعي
    | سجل_حفظ بنوع (طبيعي, طبيعي)
    | سجل_استعيد بنوع طبيعي
    | سجل_غير_معرف بنوع طبيعي
    | سجل_نفس_القيمة بنوع طبيعي
    | احفظ_الحالة
    | استعد_الحالة
;

عام نوع حدث_فك_المكدس = {
    إزاحة_بايت: طبيعي,
    الحدث: نوع_حدث_فك_المكدس
};

عام عرف انسخ_أحداث_فك_المكدس(المدخل: &متجه حدث_فك_المكدس): متجه حدث_فك_المكدس {
    دع الناتج: متغير متجه حدث_فك_المكدس = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المدخل) مثل طبيعي)) {
        دع الحدث: حدث_فك_المكدس = (*المدخل)[ف];
        دع النسخة: حدث_فك_المكدس = { إزاحة_بايت: الحدث.إزاحة_بايت, الحدث: الحدث.الحدث };
        ألحق(الناتج, النسخة);
        ف := ف + 1;
    }
    أرجع الناتج;
}


// Canonical per-function unwind facts produced by machine encoders. This is
// deliberately independent from source/machine variable debug state so the
// same facts can feed .debug_frame now and .eh_frame later.
عام نوع بيانات_معلومات_إطار_النداء_لدالة = {
    الدالة: معرف_دالة_منتقاة,
    الأحداث: متجه حدث_فك_المكدس
};

عام نوع سياق_معلومات_إطار_النداء = {
    الدوال: متجه بيانات_معلومات_إطار_النداء_لدالة,
    فهرس_الدوال: متجه اختياري طبيعي
};

عام عرف سياق_معلومات_إطار_النداء_جديد(): سياق_معلومات_إطار_النداء {
    دع الدوال: متجه بيانات_معلومات_إطار_النداء_لدالة = [];
    دع الفهرس: متجه اختياري طبيعي = [];
    دع السياق: سياق_معلومات_إطار_النداء = { الدوال: الدوال, فهرس_الدوال: الفهرس };
    أرجع السياق;
}

عام عرف سجل_أحداث_معلومات_إطار_النداء(
    السياق: &متغير سياق_معلومات_إطار_النداء,
    الدالة: معرف_دالة_منتقاة,
    الأحداث: &متجه حدث_فك_المكدس
): فراغ {
    دع النسخة: متجه حدث_فك_المكدس = انسخ_أحداث_فك_المكدس(الأحداث);
    لو (الدالة.القيمة < (الطول((*السياق).فهرس_الدوال) مثل طبيعي)) {
        طابق (*السياق).فهرس_الدوال[الدالة.القيمة] مع
        | اختياري.موجود(الموضع) -> {
            (*السياق).الدوال[الموضع].الأحداث := النسخة;
            أرجع;
        }
        | اختياري.لا_شيء -> { };
    };
    دع الوصف: بيانات_معلومات_إطار_النداء_لدالة = { الدالة: الدالة, الأحداث: النسخة };
    دع الموضع: طبيعي = الطول((*السياق).الدوال) مثل طبيعي;
    ألحق((*السياق).الدوال, الوصف);
    طالما ((الطول((*السياق).فهرس_الدوال) مثل طبيعي) <= الدالة.القيمة) {
        دع فارغ: اختياري طبيعي = اختياري.لا_شيء();
        ألحق((*السياق).فهرس_الدوال, فارغ);
    }
    (*السياق).فهرس_الدوال[الدالة.القيمة] := اختياري.موجود(الموضع);
}

// The machine encoder owns when call-frame-information changes happen. This tracker only records
// target-independent unwind state transitions at encoder-supplied byte offsets.
عام نوع متتبع_فك_المكدس = {
    الأحداث: متجه حدث_فك_المكدس,
    إزاحة_قاعدة_الإطار: طبيعي,
    مكدس_إزاحات_قاعدة_الإطار: متجه طبيعي
};

عرف ألحق_حدث_فك_المكدس(
    المتتبع: &متغير متتبع_فك_المكدس,
    إزاحة_بايت: طبيعي,
    النوع: نوع_حدث_فك_المكدس
): فراغ {
    دع الحدث: حدث_فك_المكدس = { إزاحة_بايت: إزاحة_بايت, الحدث: النوع };
    ألحق((*المتتبع).الأحداث, الحدث);
}

عام عرف متتبع_فك_المكدس_جديد(الهدف: &واصف_هدف): متتبع_فك_المكدس {
    دع الأحداث: متغير متجه حدث_فك_المكدس = [];
    دع مكدس_الإزاحات: متجه طبيعي = [];
    دع المتتبع: متغير متتبع_فك_المكدس = {
        الأحداث: الأحداث,
        إزاحة_قاعدة_الإطار: 0,
        مكدس_إزاحات_قاعدة_الإطار: مكدس_الإزاحات
    };
    // Establish the initial CFA atomically. DW_CFA_def_cfa_register and
    // DW_CFA_def_cfa_offset only modify an already-defined CFA rule.
    طابق رقم_مؤشر_المكدس_دوارف_للهدف(الهدف) مع
    | اختياري.موجود(السجل) -> {
        طابق إزاحة_قاعدة_الإطار_عند_الدخول_للهدف(الهدف) مع
        | اختياري.موجود(الإزاحة) -> {
            المتتبع.إزاحة_قاعدة_الإطار := الإزاحة;
            ألحق_حدث_فك_المكدس(
                &متغير المتتبع, 0,
                نوع_حدث_فك_المكدس.قاعدة_الإطار_حددت(السجل, الإزاحة)
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };

    // Return-address ownership is Target-defined. A physical RA register starts
    // in same-value state; a caller-pushed RA is already saved below the CFA.
    طابق رقم_سجل_عودة_دوارف_للهدف(الهدف) مع
    | اختياري.موجود(رقم_العودة) -> {
        طابق سجل_عودة_فعلي_للهدف(الهدف) مع
        | اختياري.موجود(_) -> {
            ألحق_حدث_فك_المكدس(
                &متغير المتتبع, 0, نوع_حدث_فك_المكدس.سجل_نفس_القيمة(رقم_العودة)
            );
        }
        | اختياري.لا_شيء -> {
            لو (المتتبع.إزاحة_قاعدة_الإطار > 0) {
                ألحق_حدث_فك_المكدس(
                    &متغير المتتبع, 0,
                    نوع_حدث_فك_المكدس.سجل_حفظ(رقم_العودة, المتتبع.إزاحة_قاعدة_الإطار)
                );
            };
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع المتتبع;
}

عام عرف سجل_طرح_مكدس_فك_المكدس(
    المتتبع: &متغير متتبع_فك_المكدس,
    إزاحة_بايت: طبيعي,
    الحجم: طبيعي
): فراغ {
    لو (الحجم == 0) { أرجع; };
    (*المتتبع).إزاحة_قاعدة_الإطار := (*المتتبع).إزاحة_قاعدة_الإطار + الحجم;
    ألحق_حدث_فك_المكدس(
        المتتبع, إزاحة_بايت,
        نوع_حدث_فك_المكدس.إزاحة_قاعدة_الإطار_تغيرت((*المتتبع).إزاحة_قاعدة_الإطار)
    );
}

عام عرف سجل_إضافة_مكدس_فك_المكدس(
    المتتبع: &متغير متتبع_فك_المكدس,
    إزاحة_بايت: طبيعي,
    الحجم: طبيعي
): فراغ {
    لو (الحجم == 0) { أرجع; };
    لو ((*المتتبع).إزاحة_قاعدة_الإطار >= الحجم) {
        (*المتتبع).إزاحة_قاعدة_الإطار := (*المتتبع).إزاحة_قاعدة_الإطار - الحجم;
    } وإلا {
        (*المتتبع).إزاحة_قاعدة_الإطار := 0;
    };
    ألحق_حدث_فك_المكدس(
        المتتبع, إزاحة_بايت,
        نوع_حدث_فك_المكدس.إزاحة_قاعدة_الإطار_تغيرت((*المتتبع).إزاحة_قاعدة_الإطار)
    );
}

عام عرف سجل_حفظ_سجل_فك_المكدس(
    المتتبع: &متغير متتبع_فك_المكدس,
    الهدف: &واصف_هدف,
    السجل: معرف_سجل_فعلي,
    إزاحة_موضع_المكدس: طبيعي,
    إزاحة_بايت: طبيعي
): فراغ {
    طابق رقم_سجل_دوارف_للهدف(الهدف, السجل) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(رقم_دوارف) -> {
        لو ((*المتتبع).إزاحة_قاعدة_الإطار >= إزاحة_موضع_المكدس) {
            دع البعد: طبيعي = (*المتتبع).إزاحة_قاعدة_الإطار - إزاحة_موضع_المكدس;
            ألحق_حدث_فك_المكدس(
                المتتبع, إزاحة_بايت, نوع_حدث_فك_المكدس.سجل_حفظ(رقم_دوارف, البعد)
            );
        };
    };
}

عام عرف سجل_استعادة_سجل_فك_المكدس(
    المتتبع: &متغير متتبع_فك_المكدس,
    الهدف: &واصف_هدف,
    السجل: معرف_سجل_فعلي,
    إزاحة_بايت: طبيعي
): فراغ {
    طابق رقم_سجل_دوارف_للهدف(الهدف, السجل) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(رقم_دوارف) -> {
        ألحق_حدث_فك_المكدس(
            المتتبع, إزاحة_بايت, نوع_حدث_فك_المكدس.سجل_استعيد(رقم_دوارف)
        );
    };
}

عام عرف سجل_سجل_غير_معرف_فك_المكدس(
    المتتبع: &متغير متتبع_فك_المكدس,
    رقم_دوارف: طبيعي,
    إزاحة_بايت: طبيعي
): فراغ {
    ألحق_حدث_فك_المكدس(
        المتتبع, إزاحة_بايت, نوع_حدث_فك_المكدس.سجل_غير_معرف(رقم_دوارف)
    );
}

عام عرف سجل_سجل_نفس_القيمة_فك_المكدس(
    المتتبع: &متغير متتبع_فك_المكدس,
    رقم_دوارف: طبيعي,
    إزاحة_بايت: طبيعي
): فراغ {
    ألحق_حدث_فك_المكدس(
        المتتبع, إزاحة_بايت, نوع_حدث_فك_المكدس.سجل_نفس_القيمة(رقم_دوارف)
    );
}

عام عرف سجل_حفظ_حالة_فك_المكدس(
    المتتبع: &متغير متتبع_فك_المكدس,
    إزاحة_بايت: طبيعي
): فراغ {
    ألحق((*المتتبع).مكدس_إزاحات_قاعدة_الإطار, (*المتتبع).إزاحة_قاعدة_الإطار);
    ألحق_حدث_فك_المكدس(
        المتتبع, إزاحة_بايت, نوع_حدث_فك_المكدس.احفظ_الحالة()
    );
}

عام عرف سجل_استعادة_حالة_فك_المكدس(
    المتتبع: &متغير متتبع_فك_المكدس,
    إزاحة_بايت: طبيعي
): فراغ {
    دع العدد: طبيعي = الطول((*المتتبع).مكدس_إزاحات_قاعدة_الإطار) مثل طبيعي;
    لو (العدد == 0) { أرجع; };
    دع الفهرس_الأخير: طبيعي = العدد - 1;
    (*المتتبع).إزاحة_قاعدة_الإطار := (*المتتبع).مكدس_إزاحات_قاعدة_الإطار[الفهرس_الأخير];
    دع الباقي: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف + 1 < العدد) {
        ألحق(الباقي, (*المتتبع).مكدس_إزاحات_قاعدة_الإطار[ف]);
        ف := ف + 1;
    }
    (*المتتبع).مكدس_إزاحات_قاعدة_الإطار := الباقي;
    ألحق_حدث_فك_المكدس(
        المتتبع, إزاحة_بايت, نوع_حدث_فك_المكدس.استعد_الحالة()
    );
}
