استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.target.target_model;
استورد compiler.msir.identifiers;
استورد compiler.source.provenance;
استورد compiler.debuginfo.model;

// هيكل الشفرة المنتقاة المشترك يحمل الهوية والبيانات الوصفية فقط؛ لا يصف أي تعليمة ISA.
عام نوع معرف_دالة_منتقاة = {
    القيمة: غير_موقع
};

// External-call identity is preserved numerically without carrying owned symbol text through machine IR.
عام نوع معرف_دالة_خارجية_منتقاة = {
    القيمة: غير_موقع
};

عام نوع معرف_كتلة_منتقاة = {
    القيمة: غير_موقع
};

عام عرف معرفا_دالة_منتقاة_متساويان(أ: معرف_دالة_منتقاة, ب: معرف_دالة_منتقاة): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

// Function identity is preserved numerically across the MSIR→Selected-Code boundary.
عام عرف معرف_دالة_منتقاة_من_مسير(المعرف: معرف_دالة_مسير): معرف_دالة_منتقاة {
    دع الناتج: معرف_دالة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عام عرف معرف_دالة_خارجية_منتقاة_من_مسير(المعرف: معرف_دالة_خارجية_مسير): معرف_دالة_خارجية_منتقاة {
    دع الناتج: معرف_دالة_خارجية_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عام عرف معرفا_دالة_خارجية_منتقاة_متساويان(أ: معرف_دالة_خارجية_منتقاة, ب: معرف_دالة_خارجية_منتقاة): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف معرفا_كتلة_منتقاة_متساويان(أ: معرف_كتلة_منتقاة, ب: معرف_كتلة_منتقاة): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام نوع رأس_كتلة_منتقاة = {
    المعرف: معرف_كتلة_منتقاة,
    الخلفاء: متجه معرف_كتلة_منتقاة
};

عام نوع رأس_دالة_منتقاة = {
    المعرف: معرف_دالة_منتقاة,
    عدد_السجلات_الافتراضية: غير_موقع
};

عام نوع رأس_برنامج_منتقى = {
    الهدف: معرف_هدف
};

// Source provenance follows instruction ranges through selection, allocation and encoding.
// The range is half-open and indexes the instruction vector of one machine block.
عام نوع مدى_أصل_تعليمات = {
    البداية: غير_موقع,
    النهاية: غير_موقع,
    الأصل: معرف_أصل_مصدر,
    موقع_التصحيح: اختيار معرف_موقع_تصحيح,
    نطاق_التصحيح: اختيار معرف_نطاق_تصحيح
};

// Encoded provenance is function-relative so object-format writers can place it
// without making architecture encoders decide Mach-O/ELF policy.
عام نوع مدى_شفرة_آلة_بأصل = {
    الدالة: معرف_دالة_منتقاة,
    إزاحة_بايت: غير_موقع,
    حجم_بايت: غير_موقع,
    الأصل: معرف_أصل_مصدر,
    موقع_التصحيح: اختيار معرف_موقع_تصحيح,
    نطاق_التصحيح: اختيار معرف_نطاق_تصحيح
};

عام عرف أصل_تعليمة_آلة_عند(
    الأصول: &متجه مدى_أصل_تعليمات,
    الفهرس: غير_موقع
): اختيار معرف_أصل_مصدر {
    دع أ: متجه مدى_أصل_تعليمات = *الأصول;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أ) مثل غير_موقع)) {
        لو ((الفهرس >= أ[ف].البداية) && (الفهرس < أ[ف].النهاية)) {
            أرجع اختيار.بعض(أ[ف].الأصل);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف مرجع_تصحيح_تعليمة_آلة_عند(
    الأصول: &متجه مدى_أصل_تعليمات,
    الفهرس: غير_موقع
): اختيار مدى_أصل_تعليمات {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأصول) مثل غير_موقع)) {
        لو ((الفهرس >= (*الأصول)[ف].البداية) && (الفهرس < (*الأصول)[ف].النهاية)) {
            أرجع اختيار.بعض((*الأصول)[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف انسخ_مديات_شفرة_آلة_بأصل(
    المدخل: &متجه مدى_شفرة_آلة_بأصل
): متجه مدى_شفرة_آلة_بأصل {
    دع المصدر: متجه مدى_شفرة_آلة_بأصل = *المدخل;
    دع الناتج: متغير متجه مدى_شفرة_آلة_بأصل = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع المدى: مدى_شفرة_آلة_بأصل = {
            الدالة: المصدر[ف].الدالة,
            إزاحة_بايت: المصدر[ف].إزاحة_بايت,
            حجم_بايت: المصدر[ف].حجم_بايت,
            الأصل: المصدر[ف].الأصل,
            موقع_التصحيح: المصدر[ف].موقع_التصحيح,
            نطاق_التصحيح: المصدر[ف].نطاق_التصحيح
        };
        ألحق(الناتج, المدى);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// نقل معاملات كتلة MSIR على الحافة مطلب نسخ متواز مشترك قبل تحقيقه بتعليمات المعمارية.
عام نوع نقلة_حافة_منتقاة = {
    المصدر: معرف_سجل_افتراضي,
    الوجهة: معرف_سجل_افتراضي
};

عام نوع متطلبات_نقل_حافة_منتقاة = {
    الهدف: معرف_كتلة_منتقاة,
    النقلات: متجه نقلة_حافة_منتقاة
};
