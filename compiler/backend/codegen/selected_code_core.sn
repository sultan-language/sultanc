استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.target.target_model;
استورد compiler.msir.identifiers;

// هيكل الشفرة المنتقاة المشترك يحمل الهوية والبيانات الوصفية فقط؛ لا يصف أي تعليمة ISA.
عام نوع معرف_دالة_منتقاة = {
    القيمة: غير_موقع
};

// External-call identity is preserved numerically without carrying owned symbol text through machine IR.
عام نوع معرف_دالة_خارجية_منتقاة = {
    القيمة: غير_موقع
};

عام نوع معرف_كتلة_منتقاة = {
    القيمة: غير_موقع
};

عام عرف معرفا_دالة_منتقاة_متساويان(أ: معرف_دالة_منتقاة, ب: معرف_دالة_منتقاة): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

// Function identity is preserved numerically across the MSIR→Selected-Code boundary.
عام عرف معرف_دالة_منتقاة_من_مسير(المعرف: معرف_دالة_مسير): معرف_دالة_منتقاة {
    دع الناتج: معرف_دالة_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عام عرف معرف_دالة_خارجية_منتقاة_من_مسير(المعرف: معرف_دالة_خارجية_مسير): معرف_دالة_خارجية_منتقاة {
    دع الناتج: معرف_دالة_خارجية_منتقاة = { القيمة: المعرف.القيمة };
    أرجع الناتج;
}

عام عرف معرفا_دالة_خارجية_منتقاة_متساويان(أ: معرف_دالة_خارجية_منتقاة, ب: معرف_دالة_خارجية_منتقاة): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف معرفا_كتلة_منتقاة_متساويان(أ: معرف_كتلة_منتقاة, ب: معرف_كتلة_منتقاة): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام نوع رأس_كتلة_منتقاة = {
    المعرف: معرف_كتلة_منتقاة,
    الخلفاء: متجه معرف_كتلة_منتقاة
};

عام نوع رأس_دالة_منتقاة = {
    المعرف: معرف_دالة_منتقاة,
    عدد_السجلات_الافتراضية: غير_موقع
};

عام نوع رأس_برنامج_منتقى = {
    الهدف: معرف_هدف
};

// نقل معاملات كتلة MSIR على الحافة مطلب نسخ متواز مشترك قبل تحقيقه بتعليمات المعمارية.
عام نوع نقلة_حافة_منتقاة = {
    المصدر: معرف_سجل_افتراضي,
    الوجهة: معرف_سجل_افتراضي
};

عام نوع متطلبات_نقل_حافة_منتقاة = {
    الهدف: معرف_كتلة_منتقاة,
    النقلات: متجه نقلة_حافة_منتقاة
};
