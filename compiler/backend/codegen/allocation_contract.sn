استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.codegen.selected_code_core;

// هويات مجردة يفسرها مزود قيود المعمارية فقط. الخوارزمية المشتركة لا تعرف أسماء سجلات ISA.
عام نوع معرف_سجل_فعلي = { القيمة: غير_موقع };
عام نوع معرف_فئة_تخصيص = { القيمة: غير_موقع };

عام عرف معرفا_سجل_فعلي_متساويان(أ: معرف_سجل_فعلي, ب: معرف_سجل_فعلي): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف معرفا_فئة_تخصيص_متساويان(أ: معرف_فئة_تخصيص, ب: معرف_فئة_تخصيص): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام نوع سجل_فعلي_متاح = {
    المعرف: معرف_سجل_فعلي,
    الفئة: معرف_فئة_تخصيص
};

عام نوع طلب_سجل_تخصيص = {
    السجل: معرف_سجل_افتراضي,
    الفئة: معرف_فئة_تخصيص,
    ثابت: اختيار معرف_سجل_فعلي
};

عام نوع قيد_ربط_تخصيص = {
    الأول: معرف_سجل_افتراضي,
    الثاني: معرف_سجل_افتراضي
};

عام نوع حقيقة_تعليمة_تخصيص = {
    الموضع: غير_موقع,
    الاستخدامات: متجه طلب_سجل_تخصيص,
    التعريفات: متجه طلب_سجل_تخصيص,
    القيود_المربوطة: متجه قيد_ربط_تخصيص,
    السجلات_المفسدة: متجه معرف_سجل_فعلي,
    حد_نداء: منطقي,
    قابل_للانسكاب: منطقي,
    نقل_مفضل: اختيار قيد_ربط_تخصيص
};

// الحافة حقيقة CFG مشتركة حتى عندما لا تحمل نسخا. النقلات المتوازية، إن وجدت،
// تبقى جزءا من الحافة نفسها وفئة كل سجل تأتي من مزود المعمارية.
عام نوع نقلة_حافة_تخصيص = {
    المصدر: طلب_سجل_تخصيص,
    الوجهة: طلب_سجل_تخصيص
};

عام نوع حقيقة_نقل_حافة_تخصيص = {
    من_كتلة: معرف_كتلة_منتقاة,
    إلى_كتلة: معرف_كتلة_منتقاة,
    النقلات: متجه نقلة_حافة_تخصيص
};

// حدود مواضع تعليمات الكتلة في التسلسل المسطح. النهاية حصرية.
// يحتاجها تحليل الحياة لوضع نقلات الحواف عند حدود CFG الحقيقية، لا بعد الدالة.
عام نوع حقيقة_كتلة_تخصيص = {
    المعرف: معرف_كتلة_منتقاة,
    البداية: غير_موقع,
    النهاية: غير_موقع
};

عام نوع مسألة_تخصيص = {
    عدد_السجلات_الافتراضية: غير_موقع,
    التعليمات: متجه حقيقة_تعليمة_تخصيص,
    نقلات_الحواف: متجه حقيقة_نقل_حافة_تخصيص,
    الكتل: متجه حقيقة_كتلة_تخصيص,
    السجلات_المتاحة: متجه سجل_فعلي_متاح
};

عام نوع تعيين_سجل = {
    الافتراضي: معرف_سجل_افتراضي,
    الفعلي: معرف_سجل_فعلي
};

// Temporary target lowering may append scratch assignments. It must never mutate
// a shallow descriptor alias of the canonical allocation plan, because vector
// growth can reallocate the backing storage and leave the plan descriptor stale.
عام عرف انسخ_تعيينات_سجلات(المصدر: &متجه تعيين_سجل): متجه تعيين_سجل {
    دع م: متجه تعيين_سجل = *المصدر;
    دع الناتج: متغير متجه تعيين_سجل = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م) مثل غير_موقع)) {
        دع التعيين: تعيين_سجل = م[ف];
        ألحق(الناتج, التعيين);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// أثناء التخصيص تبنى التعيينات على مرحلتين، لذلك تكون غير مرتبة مؤقتا.
// هذا الاستعلام الخطي محصور في تلك الحالة الداخلية فقط.
عام عرف ابحث_تعيين_سجل_خطي(
    التعيينات: &متجه تعيين_سجل,
    السجل: معرف_سجل_افتراضي
): اختيار معرف_سجل_فعلي {
    دع ع: متجه تعيين_سجل = *التعيينات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ع) مثل غير_موقع)) {
        لو (معرفا_سجل_افتراضي_متساويان(ع[ف].الافتراضي, السجل)) {
            أرجع اختيار.بعض(ع[ف].الفعلي);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

// يحول ناتج المخصص مرة واحدة إلى ترتيب معرف السجل الافتراضي.
// يبقى متجه التعيينات هو مصدر الحقيقة الوحيد؛ الترتيب مجرد تمثيل مقنن يسمح ببحث لوغاريتمي.
عام عرف رتب_تعيينات_سجلات(
    التعيينات: &متجه تعيين_سجل,
    العدد_المتوقع: غير_موقع
): متجه تعيين_سجل {
    // Sort only the assignments that actually exist. The old dense index allocated
    // one slot for every virtual-register ID, including registers with no assignment.
    // Bottom-up merge sort keeps canonical lookup logarithmic with O(assignments) memory.
    دع المصدر: متجه تعيين_سجل = *التعيينات;
    دع الحالية: متغير متجه تعيين_سجل = انسخ_تعيينات_سجلات(&المصدر);
    دع العدد: غير_موقع = الطول(الحالية) مثل غير_موقع;
    لو (العدد < 2) { أرجع الحالية; };

    دع العرض: متغير غير_موقع = 1;
    بينما (العرض < العدد) {
        دع التالية: متغير متجه تعيين_سجل = [];
        دع البداية: متغير غير_موقع = 0;
        بينما (البداية < العدد) {
            دع الوسط_الأولي: غير_موقع = البداية + العرض;
            دع الوسط: متغير غير_موقع = الوسط_الأولي;
            لو (الوسط > العدد) { الوسط := العدد; };
            دع النهاية_الأولية: غير_موقع = الوسط + العرض;
            دع النهاية: متغير غير_موقع = النهاية_الأولية;
            لو (النهاية > العدد) { النهاية := العدد; };

            دع يسار: متغير غير_موقع = البداية;
            دع يمين: متغير غير_موقع = الوسط;
            بينما ((يسار < الوسط) || (يمين < النهاية)) {
                لو (يمين >= النهاية) {
                    ألحق(التالية, الحالية[يسار]);
                    يسار := يسار + 1;
                } وإلا لو (يسار >= الوسط) {
                    ألحق(التالية, الحالية[يمين]);
                    يمين := يمين + 1;
                } وإلا لو (الحالية[يسار].الافتراضي.القيمة <= الحالية[يمين].الافتراضي.القيمة) {
                    ألحق(التالية, الحالية[يسار]);
                    يسار := يسار + 1;
                } وإلا {
                    ألحق(التالية, الحالية[يمين]);
                    يمين := يمين + 1;
                };
            }
            البداية := النهاية;
        }
        الحالية := التالية;
        لو (العرض > (العدد / 2)) {
            العرض := العدد;
        } وإلا {
            العرض := العرض * 2;
        };
    }
    أرجع الحالية;
}

// خطط الانسكاب تستهلكها المعماريات ببحث ثنائي حسب معرف السجل الافتراضي.
// المخصص الخطي ينتج الانسكابات بترتيب بداية مجال الحياة، لذلك نقننها مرة واحدة
// قبل نشر الخطة بدل افتراض أن ترتيب المجالات يساوي ترتيب المعرفات.
عام عرف رتب_سجلات_افتراضية(
    السجلات: &متجه معرف_سجل_افتراضي
): متجه معرف_سجل_افتراضي {
    دع المصدر: متجه معرف_سجل_افتراضي = *السجلات;
    دع الحالية: متغير متجه معرف_سجل_افتراضي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        ألحق(الحالية, المصدر[ف]);
        ف := ف + 1;
    }
    دع العدد: غير_موقع = الطول(الحالية) مثل غير_موقع;
    لو (العدد < 2) { أرجع الحالية; };

    دع العرض: متغير غير_موقع = 1;
    بينما (العرض < العدد) {
        دع التالية: متغير متجه معرف_سجل_افتراضي = [];
        دع البداية: متغير غير_موقع = 0;
        بينما (البداية < العدد) {
            دع الوسط_الأولي: غير_موقع = البداية + العرض;
            دع الوسط: متغير غير_موقع = الوسط_الأولي;
            لو (الوسط > العدد) { الوسط := العدد; };
            دع النهاية_الأولية: غير_موقع = الوسط + العرض;
            دع النهاية: متغير غير_موقع = النهاية_الأولية;
            لو (النهاية > العدد) { النهاية := العدد; };

            دع يسار: متغير غير_موقع = البداية;
            دع يمين: متغير غير_موقع = الوسط;
            بينما ((يسار < الوسط) || (يمين < النهاية)) {
                لو (يمين >= النهاية) {
                    ألحق(التالية, الحالية[يسار]);
                    يسار := يسار + 1;
                } وإلا لو (يسار >= الوسط) {
                    ألحق(التالية, الحالية[يمين]);
                    يمين := يمين + 1;
                } وإلا لو (الحالية[يسار].القيمة <= الحالية[يمين].القيمة) {
                    ألحق(التالية, الحالية[يسار]);
                    يسار := يسار + 1;
                } وإلا {
                    ألحق(التالية, الحالية[يمين]);
                    يمين := يمين + 1;
                };
            }
            البداية := النهاية;
        }
        الحالية := التالية;
        لو (العرض > (العدد / 2)) {
            العرض := العدد;
        } وإلا {
            العرض := العرض * 2;
        };
    }
    أرجع الحالية;
}

// تعيينات خطط الانسكاب المؤقتة تبدأ مرتبة وتضيف عددا صغيرا من سجلات العمل.
// حافظ على الترتيب كي يبقى الاستعلام المقنن سريعا وصحيحا حتى أثناء خفض التعليمة.
عام عرف أدخل_تعيين_سجل_مرتب(
    التعيينات: &متغير متجه تعيين_سجل,
    التعيين: تعيين_سجل
): فراغ {
    دع الحالة: متغير متجه تعيين_سجل = *التعيينات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        لو (معرفا_سجل_افتراضي_متساويان(الحالة[ف].الافتراضي, التعيين.الافتراضي)) {
            الحالة[ف] := التعيين;
            *التعيينات := الحالة;
            أرجع;
        };
        ف := ف + 1;
    }
    ألحق(الحالة, التعيين);
    دع موضع: متغير غير_موقع = الطول(الحالة) مثل غير_موقع;
    موضع := موضع - 1;
    دع استمر: متغير منطقي = صواب;
    بينما (موضع > 0 && استمر) {
        دع موضع_السابق: متغير غير_موقع = موضع;
        موضع_السابق := موضع_السابق - 1;
        لو (الحالة[موضع].الافتراضي.القيمة < الحالة[موضع_السابق].الافتراضي.القيمة) {
            دع السابق: تعيين_سجل = الحالة[موضع_السابق];
            الحالة[موضع_السابق] := الحالة[موضع];
            الحالة[موضع] := السابق;
            موضع := موضع_السابق;
        } وإلا {
            استمر := خطأ;
        };
    }
    *التعيينات := الحالة;
}

// الاستعلام المقنن عن خطة تخصيص مكتملة. منتج الخطة يضمن ترتيب المعرف الافتراضي.
عام عرف ابحث_تعيين_سجل(
    التعيينات: &متجه تعيين_سجل,
    السجل: معرف_سجل_افتراضي
): اختيار معرف_سجل_فعلي {
    دع ع: متجه تعيين_سجل = *التعيينات;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(ع) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع الموجود: غير_موقع = ع[الوسط].الافتراضي.القيمة;
        لو (الموجود == السجل.القيمة) {
            أرجع اختيار.بعض(ع[الوسط].الفعلي);
        };
        لو (الموجود < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع اختيار.لا_شيء();
}

عام نوع سبب_حاجة_انسكاب = {
    السجل: معرف_سجل_افتراضي,
    عند_الموضع: غير_موقع
};

عام نوع نتيجة_تخصيص =
    | مخصص بنوع متجه تعيين_سجل
    | يحتاج_انسكاب بنوع سبب_حاجة_انسكاب
    | فشل_قيود بنوع معرف_سجل_افتراضي
;

// B5: نتيجة تخصيص مكتملة قد تضع بعض القيم في مواقع انسكاب مع إبقاء قرار الموقع مشتركا.
عام نوع خطة_تخصيص_مع_انسكاب = {
    التعيينات: متجه تعيين_سجل,
    السجلات_المسكوبة: متجه معرف_سجل_افتراضي
};

عام نوع نتيجة_تخصيص_مع_انسكاب =
    | مكتمل بنوع خطة_تخصيص_مع_انسكاب
    | فشل_قيود بنوع معرف_سجل_افتراضي
;
