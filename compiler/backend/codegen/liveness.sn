استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.virtual_registers;

عام نوع مجال_حياة_سجل = {
    السجل: معرف_سجل_افتراضي,
    البداية: طبيعي,
    النهاية: طبيعي,
    يعبر_نداء: منطقي,
    السجلات_المفسدة: متجه معرف_سجل_فعلي,
    السجلات_المربوطة: متجه معرف_سجل_افتراضي,
    ثابت: اختياري معرف_سجل_فعلي,
    الفئة: اختياري معرف_فئة_تخصيص,
    تعارض_قيود: منطقي,
    // The positions where the register is live, as sorted disjoint
    // inclusive pairs (start, end, start, end, ...): البداية..النهاية
    // with its holes (Traub et al.'s lifetime holes). A definition nothing
    // reads is live at its own position.
    المقاطع: متجه طبيعي
};

// Sparse sets keep backing capacity across fixed-point iterations. The same
// owned buffers hold final per-block liveness; no second finalized copy.
نوع مخزن_حياة_مؤقت = {
    القيم: متجه معرف_سجل_افتراضي,
    العدد: طبيعي
};

نوع حياة_كتلة_تخصيص = {
    الاستخدامات: متجه معرف_سجل_افتراضي,
    التعريفات: متجه معرف_سجل_افتراضي,
    الدخول: مخزن_حياة_مؤقت,
    الخروج: مخزن_حياة_مؤقت
};

نوع فهارس_حواف_حياة = {
    الخارجة: متجه متجه طبيعي,
    الأسلاف: متجه متجه طبيعي
};

عرف انسخ_مجموعة_حياة(
    المصدر: &متجه معرف_سجل_افتراضي
): متجه معرف_سجل_افتراضي {
    ليكن الناتج: متغير متجه معرف_سجل_افتراضي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف مجموعتا_حياة_متساويتان(
    أ: &متجه معرف_سجل_افتراضي,
    ب: &متجه معرف_سجل_افتراضي
): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) {
        أرجع خطأ;
    };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا (!معرفا_سجل_افتراضي_متساويان((*أ)[ف], (*ب)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف موضع_سجل_حي(
    المجموعة: &متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): طبيعي {
    ليكن البداية: متغير طبيعي = 0;
    ليكن النهاية: متغير طبيعي = الطول(*المجموعة) مثل طبيعي;
    طالما (البداية < النهاية) {
        ليكن الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        إذا ((*المجموعة)[الوسط].القيمة < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عرف مجموعة_حياة_تحتوي(
    المجموعة: &متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): منطقي {
    ليكن الموضع: طبيعي = موضع_سجل_حي(المجموعة, السجل);
    إذا (الموضع >= (الطول(*المجموعة) مثل طبيعي)) { أرجع خطأ; };
    أرجع معرفا_سجل_افتراضي_متساويان((*المجموعة)[الموضع], السجل);
}

عرف أضف_سجلا_حيا(
    المجموعة: &متغير متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): فراغ {
    // Keep the common increasing-ID insertion append-only; shift only for
    // genuinely out-of-order values, preserving the sparse sorted invariant.
    ليكن العدد: طبيعي = الطول(*المجموعة) مثل طبيعي;
    إذا (العدد == 0) { ألحق(*المجموعة, السجل); أرجع; };
    ليكن الأخير: طبيعي = (*المجموعة)[العدد - 1].القيمة;
    إذا (الأخير == السجل.القيمة) { أرجع; };
    إذا (الأخير < السجل.القيمة) { ألحق(*المجموعة, السجل); أرجع; };
    ليكن الموضع: طبيعي = موضع_سجل_حي(المجموعة, السجل);
    إذا (الموضع < العدد) {
        إذا (معرفا_سجل_افتراضي_متساويان((*المجموعة)[الموضع], السجل)) { أرجع; };
    };
    ألحق(*المجموعة, السجل);
    ليكن ف: متغير طبيعي = الطول(*المجموعة) مثل طبيعي;
    ف := ف - 1;
    طالما (ف > الموضع) {
        ليكن السابق: طبيعي = ف - 1;
        (*المجموعة)[ف] := (*المجموعة)[السابق];
        ف := السابق;
    }
    (*المجموعة)[الموضع] := السجل;
}

عرف احسب_دخول_حياة(
    الاستخدامات: &متجه معرف_سجل_افتراضي,
    التعريفات: &متجه معرف_سجل_افتراضي,
    الخروج: &متجه معرف_سجل_افتراضي
): متجه معرف_سجل_افتراضي {
    ليكن الناتج: متغير متجه معرف_سجل_افتراضي = انسخ_مجموعة_حياة(الاستخدامات);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الخروج) مثل طبيعي)) {
        إذا (!مجموعة_حياة_تحتوي(التعريفات, (*الخروج)[ف])) {
            أضف_سجلا_حيا(&متغير الناتج, (*الخروج)[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اكتب_في_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت,
    الموضع: طبيعي,
    السجل: معرف_سجل_افتراضي
): فراغ {
    إذا (الموضع < (الطول((*المخزن).القيم) مثل طبيعي)) {
        (*المخزن).القيم[الموضع] := السجل;
    } وإلا {
        ألحق((*المخزن).القيم, السجل);
    };
    إذا (الموضع >= (*المخزن).العدد) { (*المخزن).العدد := الموضع + 1; };
}

عرف موضع_سجل_في_مخزن_حياة(
    المخزن: &مخزن_حياة_مؤقت,
    السجل: معرف_سجل_افتراضي
): طبيعي {
    ليكن البداية: متغير طبيعي = 0;
    ليكن النهاية: متغير طبيعي = (*المخزن).العدد;
    طالما (البداية < النهاية) {
        ليكن الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        إذا ((*المخزن).القيم[الوسط].القيمة < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عرف أضف_إلى_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت,
    السجل: معرف_سجل_افتراضي
): فراغ {
    ليكن القديم: طبيعي = (*المخزن).العدد;
    إذا (القديم == 0) { اكتب_في_مخزن_حياة(المخزن, 0, السجل); أرجع; };
    ليكن الأخير: طبيعي = (*المخزن).القيم[القديم - 1].القيمة;
    إذا (الأخير == السجل.القيمة) { أرجع; };
    إذا (الأخير < السجل.القيمة) {
        اكتب_في_مخزن_حياة(المخزن, القديم, السجل);
        أرجع;
    };
    ليكن الموضع: طبيعي = موضع_سجل_في_مخزن_حياة(المخزن, السجل);
    إذا (الموضع < القديم) {
        إذا (معرفا_سجل_افتراضي_متساويان((*المخزن).القيم[الموضع], السجل)) { أرجع; };
    };
    إذا (القديم < (الطول((*المخزن).القيم) مثل طبيعي)) {
        (*المخزن).العدد := القديم + 1;
    } وإلا {
        ألحق((*المخزن).القيم, السجل);
        (*المخزن).العدد := القديم + 1;
    };
    ليكن ف: متغير طبيعي = القديم;
    طالما (ف > الموضع) {
        ليكن السابق: طبيعي = ف - 1;
        (*المخزن).القيم[ف] := (*المخزن).القيم[السابق];
        ف := السابق;
    }
    (*المخزن).القيم[الموضع] := السجل;
}

عرف انتقال_تعليمة_حياة_إلى_مخزن(
    بعد: &مخزن_حياة_مؤقت,
    التعريفات: &متجه طلب_سجل_تخصيص,
    الاستخدامات: &متجه طلب_سجل_تخصيص,
    الناتج: &متغير مخزن_حياة_مؤقت
): فراغ {
    (*الناتج).العدد := 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (*بعد).العدد) {
        ليكن معرف: معرف_سجل_افتراضي = (*بعد).القيم[ف];
        ليكن معرف_معرف: متغير منطقي = خطأ;
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول(*التعريفات) مثل طبيعي)) {
            إذا (معرفا_سجل_افتراضي_متساويان((*التعريفات)[ت].السجل, معرف)) {
                معرف_معرف := صواب;
                ت := الطول(*التعريفات) مثل طبيعي;
            } وإلا {
                ت := ت + 1;
            };
        }
        إذا (!معرف_معرف) {
            اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, معرف);
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*الاستخدامات) مثل طبيعي)) {
        أضف_إلى_مخزن_حياة(الناتج, (*الاستخدامات)[ف].السجل);
        ف := ف + 1;
    }
}

عرف امسح_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت
): فراغ {
    (*المخزن).العدد := 0;
}

عرف مخزنا_حياة_متساويان(
    أ: &مخزن_حياة_مؤقت,
    ب: &مخزن_حياة_مؤقت
): منطقي {
    إذا ((*أ).العدد != (*ب).العدد) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (*أ).العدد) {
        إذا (!معرفا_سجل_افتراضي_متساويان((*أ).القيم[ف], (*ب).القيم[ف])) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_مخزن_حياة_إلى_مخزن(
    المصدر: &مخزن_حياة_مؤقت,
    الوجهة: &متغير مخزن_حياة_مؤقت
): فراغ {
    امسح_مخزن_حياة(الوجهة);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (*المصدر).العدد) {
        اكتب_في_مخزن_حياة(الوجهة, ف, (*المصدر).القيم[ف]);
        ف := ف + 1;
    }
}

عرف احسب_دخول_حياة_في_مخزن(
    الاستخدامات: &متجه معرف_سجل_افتراضي,
    التعريفات: &متجه معرف_سجل_افتراضي,
    الخروج: &مخزن_حياة_مؤقت,
    الناتج: &متغير مخزن_حياة_مؤقت
): فراغ {
    // Both inputs are sorted sparse sets. Merge use with (out - def) in
    // linear output order instead of inserting each out element and shifting
    // the growing live-in vector O(L^2) times.
    امسح_مخزن_حياة(الناتج);
    ليكن ف: متغير طبيعي = 0;
    ليكن خ: متغير طبيعي = 0;
    ليكن عدد_الاستخدامات: طبيعي = الطول(*الاستخدامات) مثل طبيعي;
    طالما (ف < عدد_الاستخدامات || خ < (*الخروج).العدد) {
        طالما (خ < (*الخروج).العدد && مجموعة_حياة_تحتوي(التعريفات, (*الخروج).القيم[خ])) {
            خ := خ + 1;
        }
        إذا (ف < عدد_الاستخدامات && خ < (*الخروج).العدد) {
            ليكن من_استخدام: معرف_سجل_افتراضي = (*الاستخدامات)[ف];
            ليكن من_خروج: معرف_سجل_افتراضي = (*الخروج).القيم[خ];
            إذا (من_استخدام.القيمة <= من_خروج.القيمة) {
                اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, من_استخدام);
                ف := ف + 1;
                إذا (من_استخدام.القيمة == من_خروج.القيمة) { خ := خ + 1; };
            } وإلا {
                اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, من_خروج);
                خ := خ + 1;
            };
        } وإلا إذا (ف < عدد_الاستخدامات) {
            اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, (*الاستخدامات)[ف]);
            ف := ف + 1;
        } وإلا إذا (خ < (*الخروج).العدد) {
            اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, (*الخروج).القيم[خ]);
            خ := خ + 1;
        };
    }
}

عرف طبق_قيد_طلب(
    المجالات: &متغير متجه مجال_حياة_سجل,
    الفهرس: طبيعي,
    الطلب: &طلب_سجل_تخصيص
): فراغ {
    طابق (*المجالات)[الفهرس].الفئة مع
    | اختياري.موجود(الفئة) -> {
        إذا (!معرفا_فئة_تخصيص_متساويان(الفئة, (*الطلب).الفئة)) {
            (*المجالات)[الفهرس].تعارض_قيود := صواب;
        };
    }
    | اختياري.لا_شيء -> {
        (*المجالات)[الفهرس].الفئة := اختياري.موجود((*الطلب).الفئة);
    };
    طابق (*الطلب).ثابت مع
    | اختياري.موجود(الثابت) -> {
        طابق (*المجالات)[الفهرس].ثابت مع
        | اختياري.موجود(الحالي) -> {
            إذا (!معرفا_سجل_فعلي_متساويان(الحالي, الثابت)) {
                (*المجالات)[الفهرس].تعارض_قيود := صواب;
            };
        }
        | اختياري.لا_شيء -> {
            (*المجالات)[الفهرس].ثابت := اختياري.موجود(الثابت);
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف ألحق_مجال_فارغ(المجالات: &متغير متجه مجال_حياة_سجل): فراغ {
    ليكن م: طبيعي = الطول(*المجالات) مثل طبيعي;
    ليكن المعرف: معرف_سجل_افتراضي = { القيمة: م };
    ليكن لا_ثابت: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
    ليكن لا_فئة: اختياري معرف_فئة_تخصيص = اختياري.لا_شيء();
    ليكن لا_مفسدات: متجه معرف_سجل_فعلي = [];
    ليكن لا_مربوطات: متجه معرف_سجل_افتراضي = [];
    ليكن لا_مقاطع: متجه طبيعي = [];
    ليكن فارغ: مجال_حياة_سجل = {
        السجل: المعرف,
        البداية: 0,
        النهاية: 0,
        يعبر_نداء: خطأ,
        السجلات_المفسدة: لا_مفسدات,
        السجلات_المربوطة: لا_مربوطات,
        ثابت: لا_ثابت,
        الفئة: لا_فئة,
        تعارض_قيود: خطأ,
        المقاطع: لا_مقاطع
    };
    ألحق(*المجالات, فارغ);
}

عرف تأكد_عدد_المجالات(
    المجالات: &متغير متجه مجال_حياة_سجل,
    العدد: طبيعي
): فراغ {
    طالما ((الطول(*المجالات) مثل طبيعي) < العدد) {
        ألحق_مجال_فارغ(المجالات);
    }
}

عرف وسع_مجال(
    المجالات: &متغير متجه مجال_حياة_سجل,
    الطلب: &طلب_سجل_تخصيص,
    الموضع: طبيعي
): فراغ {
    تأكد_عدد_المجالات(المجالات, (*الطلب).السجل.القيمة + 1);
    ليكن ف: طبيعي = (*الطلب).السجل.القيمة;
    طابق (*المجالات)[ف].الفئة مع
    | اختياري.لا_شيء -> {
        (*المجالات)[ف].البداية := الموضع;
        (*المجالات)[ف].النهاية := الموضع;
    }
    | اختياري.موجود(_) -> {
        إذا (الموضع < (*المجالات)[ف].البداية) { (*المجالات)[ف].البداية := الموضع; };
        إذا (الموضع > (*المجالات)[ف].النهاية) { (*المجالات)[ف].النهاية := الموضع; };
    };
    طبق_قيد_طلب(المجالات, ف, الطلب);
}

عرف وسع_حدود_مجال(
    المجالات: &متغير متجه مجال_حياة_سجل,
    السجل: معرف_سجل_افتراضي,
    الموضع: طبيعي
): فراغ {
    إذا (السجل.القيمة >= (الطول(*المجالات) مثل طبيعي)) { أرجع; };
    طابق (*المجالات)[السجل.القيمة].الفئة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(_) -> {
        إذا (الموضع < (*المجالات)[السجل.القيمة].البداية) {
            (*المجالات)[السجل.القيمة].البداية := الموضع;
        };
        إذا (الموضع > (*المجالات)[السجل.القيمة].النهاية) {
            (*المجالات)[السجل.القيمة].النهاية := الموضع;
        };
    };
}

عرف أضف_مفسدات_إلى_مجال(
    المجال: &متغير مجال_حياة_سجل,
    المفسدات: &متجه معرف_سجل_فعلي,
    حد_نداء: منطقي
): فراغ {
    إذا (حد_نداء) { (*المجال).يعبر_نداء := صواب; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المفسدات) مثل طبيعي)) {
        ليكن موجود: متغير منطقي = خطأ;
        ليكن س: متغير طبيعي = 0;
        طالما (س < (الطول((*المجال).السجلات_المفسدة) مثل طبيعي)) {
            إذا (معرفا_سجل_فعلي_متساويان((*المجال).السجلات_المفسدة[س], (*المفسدات)[ف])) {
                موجود := صواب;
                س := الطول((*المجال).السجلات_المفسدة) مثل طبيعي;
            } وإلا {
                س := س + 1;
            };
        }
        إذا (!موجود) { ألحق((*المجال).السجلات_المفسدة, (*المفسدات)[ف]); };
        ف := ف + 1;
    }
}

عرف ابحث_حقيقة_كتلة_تخصيص(
    الكتل: &متجه حقيقة_كتلة_تخصيص,
    المعرف: معرف_كتلة_منتقاة
): اختياري حقيقة_كتلة_تخصيص {
    ليكن ف: طبيعي = المعرف.القيمة;
    إذا (ف >= (الطول(*الكتل) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا (!معرفا_كتلة_منتقاة_متساويان((*الكتل)[ف].المعرف, المعرف)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*الكتل)[ف]);
}

عرف موضع_نهاية_كتلة_تخصيص(الحقيقة: &حقيقة_كتلة_تخصيص): طبيعي {
    إذا ((*الحقيقة).النهاية > (*الحقيقة).البداية) { أرجع (*الحقيقة).النهاية - 1; };
    أرجع (*الحقيقة).البداية;
}

عرف ابن_حياة_كتل_تخصيص(المسألة: &مسألة_تخصيص): متجه حياة_كتلة_تخصيص {
    ليكن الناتج: متغير متجه حياة_كتلة_تخصيص = [];
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*المسألة).الكتل) مثل طبيعي)) {
        ليكن الاستخدامات: متغير متجه معرف_سجل_افتراضي = [];
        ليكن التعريفات: متغير متجه معرف_سجل_افتراضي = [];
        ليكن الحقيقة_الكتلة: &حقيقة_كتلة_تخصيص = &(*المسألة).الكتل[ك];
        ليكن الموضع: متغير طبيعي = (*الحقيقة_الكتلة).البداية;
        طالما (الموضع < (*الحقيقة_الكتلة).النهاية) {
            ليكن حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[الموضع];
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*حقيقة).الاستخدامات) مثل طبيعي)) {
                ليكن السجل: معرف_سجل_افتراضي = (*حقيقة).الاستخدامات[ف].السجل;
                إذا (!مجموعة_حياة_تحتوي(&التعريفات, السجل)) {
                    أضف_سجلا_حيا(&متغير الاستخدامات, السجل);
                };
                ف := ف + 1;
            }
            ف := 0;
            طالما (ف < (الطول((*حقيقة).التعريفات) مثل طبيعي)) {
                أضف_سجلا_حيا(&متغير التعريفات, (*حقيقة).التعريفات[ف].السجل);
                ف := ف + 1;
            }
            الموضع := الموضع + 1;
        }
        ليكن قيم_الدخول: متجه معرف_سجل_افتراضي = [];
        ليكن قيم_الخروج: متجه معرف_سجل_افتراضي = [];
        ليكن الدخول: مخزن_حياة_مؤقت = { القيم: قيم_الدخول, العدد: 0 };
        ليكن الخروج: مخزن_حياة_مؤقت = { القيم: قيم_الخروج, العدد: 0 };
        ليكن حياة: حياة_كتلة_تخصيص = {
            الاستخدامات: الاستخدامات,
            التعريفات: التعريفات,
            الدخول: الدخول,
            الخروج: الخروج
        };
        ألحق(الناتج, حياة);
        ك := ك + 1;
    }
    أرجع الناتج;
}

عرف ادمج_نقلات_حافة_في_حياة(
    الناتج: &متغير متجه معرف_سجل_افتراضي,
    الدخول_اللاحق: &متجه معرف_سجل_افتراضي,
    الحافة: &حقيقة_نقل_حافة_تخصيص
): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الدخول_اللاحق) مثل طبيعي)) {
        ليكن مقتول: متغير منطقي = خطأ;
        ليكن ن: متغير طبيعي = 0;
        طالما (ن < (الطول((*الحافة).النقلات) مثل طبيعي)) {
            إذا (معرفا_سجل_افتراضي_متساويان(
                (*الحافة).النقلات[ن].الوجهة.السجل, (*الدخول_اللاحق)[ف]
            )) {
                مقتول := صواب;
                ن := الطول((*الحافة).النقلات) مثل طبيعي;
            } وإلا { ن := ن + 1; };
        }
        إذا (!مقتول) { أضف_سجلا_حيا(الناتج, (*الدخول_اللاحق)[ف]); };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الحافة).النقلات) مثل طبيعي)) {
        أضف_سجلا_حيا(الناتج, (*الحافة).النقلات[ف].المصدر.السجل);
        ف := ف + 1;
    }
}

عرف ادمج_نقلات_حافة_في_مخزن_حياة(
    الناتج: &متغير مخزن_حياة_مؤقت,
    الدخول_اللاحق: &مخزن_حياة_مؤقت,
    الحافة: &حقيقة_نقل_حافة_تخصيص
): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (*الدخول_اللاحق).العدد) {
        ليكن مقتول: متغير منطقي = خطأ;
        ليكن ن: متغير طبيعي = 0;
        طالما (ن < (الطول((*الحافة).النقلات) مثل طبيعي)) {
            إذا (معرفا_سجل_افتراضي_متساويان(
                (*الحافة).النقلات[ن].الوجهة.السجل, (*الدخول_اللاحق).القيم[ف]
            )) {
                مقتول := صواب;
                ن := الطول((*الحافة).النقلات) مثل طبيعي;
            } وإلا { ن := ن + 1; };
        }
        إذا (!مقتول) { أضف_إلى_مخزن_حياة(الناتج, (*الدخول_اللاحق).القيم[ف]); };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الحافة).النقلات) مثل طبيعي)) {
        أضف_إلى_مخزن_حياة(الناتج, (*الحافة).النقلات[ف].المصدر.السجل);
        ف := ف + 1;
    }
}

عرف ابن_فهارس_حواف_حياة(المسألة: &مسألة_تخصيص): فهارس_حواف_حياة {
    ليكن الخارجة: متغير متجه متجه طبيعي = [];
    ليكن الأسلاف: متغير متجه متجه طبيعي = [];
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*المسألة).الكتل) مثل طبيعي)) {
        ليكن فارغ_خارج: متجه طبيعي = [];
        ليكن فارغ_سلف: متجه طبيعي = [];
        ألحق(الخارجة, فارغ_خارج);
        ألحق(الأسلاف, فارغ_سلف);
        ك := ك + 1;
    }
    ليكن ه: متغير طبيعي = 0;
    طالما (ه < (الطول((*المسألة).نقلات_الحواف) مثل طبيعي)) {
        ليكن الحافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[ه];
        ليكن فهرس_المصدر: طبيعي = (*الحافة).من_كتلة.القيمة;
        ليكن فهرس_الوجهة: طبيعي = (*الحافة).إلى_كتلة.القيمة;
        إذا (
            فهرس_المصدر < (الطول(الخارجة) مثل طبيعي)
            && فهرس_الوجهة < (الطول(الأسلاف) مثل طبيعي)
        ) {
            ألحق(الخارجة[فهرس_المصدر], ه);
            ألحق(الأسلاف[فهرس_الوجهة], فهرس_المصدر);
        };
        ه := ه + 1;
    }
    ليكن الناتج: فهارس_حواف_حياة = { الخارجة: الخارجة, الأسلاف: الأسلاف };
    أرجع الناتج;
}

// Per block, the values of مسألة_تخصيص.القيم_الممتدة that are live out of
// it besides what reads them. Each group is the values of one source
// variable; a forward must-analysis finds, per group, the value every path
// to a block's end defined last (a block parameter is defined by the moves
// of the edges into its block). A value stays live out of a block when it
// is that value for every group it is in. Liveness then carries it back to
// its definition only along paths where no other value of those variables
// is defined: it is live only where it is each of its variables' current
// value, and a debugger reading it there reads that variable. Where paths
// disagree (no value merges them) nothing is extended.
عرف خروج_ممتد_لكتل_تخصيص(المسألة: &مسألة_تخصيص): متجه متجه معرف_سجل_افتراضي {
    ليكن عدد_الكتل: طبيعي = الطول((*المسألة).الكتل) مثل طبيعي;
    ليكن الناتج: متغير متجه متجه معرف_سجل_افتراضي = [];
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        ليكن فارغة: متجه معرف_سجل_افتراضي = [];
        ألحق(الناتج, فارغة);
        ك := ك + 1;
    }
    ليكن عدد_المجموعات: طبيعي = الطول((*المسألة).القيم_الممتدة) مثل طبيعي;
    إذا (عدد_الكتل == 0 || عدد_المجموعات == 0) { أرجع الناتج; };
    ليكن عدد_السجلات: طبيعي = (*المسألة).عدد_السجلات_الافتراضية;
    // The groups each register is in.
    ليكن مجموعات_السجل: متغير متجه متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_السجلات) { ليكن فارغة: متجه طبيعي = []; ألحق(مجموعات_السجل, فارغة); ف := ف + 1; }
    ليكن م: متغير طبيعي = 0;
    طالما (م < عدد_المجموعات) {
        ليكن ق: متغير طبيعي = 0;
        طالما (ق < (الطول((*المسألة).القيم_الممتدة[م]) مثل طبيعي)) {
            ليكن السجل: طبيعي = (*المسألة).القيم_الممتدة[م][ق];
            إذا (السجل < عدد_السجلات) { ألحق(مجموعات_السجل[السجل], م); };
            ق := ق + 1;
        }
        م := م + 1;
    }
    // Lattice per group and block: غير_محدد (no path yet), متعارض (paths
    // disagree, or no value), else a register.
    ليكن غير_محدد: طبيعي = 0xFFFFFFFFFFFFFFFF;
    ليكن متعارض: طبيعي = 0xFFFFFFFFFFFFFFFE;
    // Per block and group, the register of the group the block's own
    // instructions define last (غير_محدد: none).
    ليكن الأخير: متغير متجه طبيعي = [];
    ليكن الخروج: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الكتل * عدد_المجموعات) { ألحق(الأخير, غير_محدد); ألحق(الخروج, غير_محدد); ف := ف + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ليكن الموضع: متغير طبيعي = (*المسألة).الكتل[ك].البداية;
        طالما (الموضع < (*المسألة).الكتل[ك].النهاية && الموضع < (الطول((*المسألة).التعليمات) مثل طبيعي)) {
            ليكن حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[الموضع];
            ليكن ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*حقيقة).التعريفات) مثل طبيعي)) {
                ليكن السجل: طبيعي = (*حقيقة).التعريفات[ت].السجل.القيمة;
                إذا (السجل < عدد_السجلات) {
                    ليكن ج: متغير طبيعي = 0;
                    طالما (ج < (الطول(مجموعات_السجل[السجل]) مثل طبيعي)) {
                        الأخير[ك * عدد_المجموعات + مجموعات_السجل[السجل][ج]] := السجل;
                        ج := ج + 1;
                    }
                };
                ت := ت + 1;
            }
            الموضع := الموضع + 1;
        }
        ك := ك + 1;
    }
    // Edges into each block, and the successors.
    ليكن الداخلة: متغير متجه متجه طبيعي = [];
    ليكن اللواحق: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ليكن فارغة: متجه طبيعي = [];
        ألحق(الداخلة, فارغة);
        ليكن فارغة_: متجه طبيعي = [];
        ألحق(اللواحق, فارغة_);
        ك := ك + 1;
    }
    ليكن ه: متغير طبيعي = 0;
    طالما (ه < (الطول((*المسألة).نقلات_الحواف) مثل طبيعي)) {
        ليكن المنبع: طبيعي = (*المسألة).نقلات_الحواف[ه].من_كتلة.القيمة;
        ليكن المصب: طبيعي = (*المسألة).نقلات_الحواف[ه].إلى_كتلة.القيمة;
        إذا (المنبع < عدد_الكتل && المصب < عدد_الكتل) {
            ألحق(الداخلة[المصب], ه);
            ألحق(اللواحق[المنبع], المصب);
        };
        ه := ه + 1;
    }
    // Reverse postorder from the entry (block 0), iteratively.
    ليكن تمت: متغير متجه منطقي = [];
    ليكن مؤشرات: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ألحق(تمت, خطأ); ألحق(مؤشرات, 0); ك := ك + 1; }
    ليكن البعدي: متغير متجه طبيعي = [];
    ليكن المكدس: متغير متجه طبيعي = [];
    ألحق(المكدس, 0);
    تمت[0] := صواب;
    طالما ((الطول(المكدس) مثل طبيعي) > 0) {
        ليكن القمة_: طبيعي = (الطول(المكدس) مثل طبيعي) - 1;
        ليكن القمة: طبيعي = المكدس[القمة_];
        إذا (مؤشرات[القمة] < (الطول(اللواحق[القمة]) مثل طبيعي)) {
            ليكن التالي: طبيعي = اللواحق[القمة][مؤشرات[القمة]];
            مؤشرات[القمة] := مؤشرات[القمة] + 1;
            إذا (!تمت[التالي]) {
                تمت[التالي] := صواب;
                ألحق(المكدس, التالي);
            };
        } وإلا {
            ألحق(البعدي, القمة);
            اقتطع(المكدس, القمة_);
        };
    }
    // Forward must-analysis to a fixed point, in reverse postorder. Per
    // block, the in-state of every group is the meet of what each edge
    // brings: its own move into a register of the group, else its source
    // block's out-state.
    ليكن الداخل: متغير متجه طبيعي = [];
    ليكن التجاوز: متغير متجه طبيعي = [];
    م := 0;
    طالما (م < عدد_المجموعات) { ألحق(الداخل, غير_محدد); ألحق(التجاوز, غير_محدد); م := م + 1; }
    ليكن المتجاوزة: متغير متجه طبيعي = [];
    ليكن تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        ليكن ر: متغير طبيعي = الطول(البعدي) مثل طبيعي;
        طالما (ر > 0) {
            ر := ر - 1;
            ليكن ب: طبيعي = البعدي[ر];
            ليكن البداية: متغير طبيعي = غير_محدد;
            إذا (ب == 0) { البداية := متعارض; };
            م := 0;
            طالما (م < عدد_المجموعات) { الداخل[م] := البداية; م := م + 1; }
            ليكن د: متغير طبيعي = 0;
            طالما (د < (الطول(الداخلة[ب]) مثل طبيعي)) {
                ليكن الحافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[الداخلة[ب][د]];
                ليكن المنبع: طبيعي = (*الحافة).من_كتلة.القيمة;
                ليكن ن: متغير طبيعي = 0;
                طالما (ن < (الطول((*الحافة).النقلات) مثل طبيعي)) {
                    ليكن الوجهة: طبيعي = (*الحافة).النقلات[ن].الوجهة.السجل.القيمة;
                    إذا (الوجهة < عدد_السجلات) {
                        ليكن ج: متغير طبيعي = 0;
                        طالما (ج < (الطول(مجموعات_السجل[الوجهة]) مثل طبيعي)) {
                            التجاوز[مجموعات_السجل[الوجهة][ج]] := الوجهة;
                            ألحق(المتجاوزة, مجموعات_السجل[الوجهة][ج]);
                            ج := ج + 1;
                        }
                    };
                    ن := ن + 1;
                }
                م := 0;
                طالما (م < عدد_المجموعات) {
                    ليكن الوارد: متغير طبيعي = التجاوز[م];
                    إذا (الوارد == غير_محدد) { الوارد := الخروج[المنبع * عدد_المجموعات + م]; };
                    إذا (الوارد != غير_محدد) {
                        إذا (الداخل[م] == غير_محدد) { الداخل[م] := الوارد; }
                        وإلا إذا (الداخل[م] != الوارد) { الداخل[م] := متعارض; };
                    };
                    م := م + 1;
                }
                ن := 0;
                طالما (ن < (الطول(المتجاوزة) مثل طبيعي)) { التجاوز[المتجاوزة[ن]] := غير_محدد; ن := ن + 1; }
                اقتطع(المتجاوزة, 0);
                د := د + 1;
            }
            م := 0;
            طالما (م < عدد_المجموعات) {
                ليكن الجديد: متغير طبيعي = الأخير[ب * عدد_المجموعات + م];
                إذا (الجديد == غير_محدد) { الجديد := الداخل[م]; };
                إذا (الجديد != الخروج[ب * عدد_المجموعات + م]) {
                    الخروج[ب * عدد_المجموعات + م] := الجديد;
                    تغير := صواب;
                };
                م := م + 1;
            }
        }
    }
    // A register stays live out of a block when every group it is in
    // ends the block with it.
    ك := 0;
    طالما (ك < عدد_الكتل) {
        إذا (تمت[ك]) {
            م := 0;
            طالما (م < عدد_المجموعات) {
                ليكن السجل: طبيعي = الخروج[ك * عدد_المجموعات + م];
                إذا (السجل < عدد_السجلات) {
                    ليكن الكل: متغير منطقي = صواب;
                    ليكن ج: متغير طبيعي = 0;
                    طالما (ج < (الطول(مجموعات_السجل[السجل]) مثل طبيعي)) {
                        إذا (الخروج[ك * عدد_المجموعات + مجموعات_السجل[السجل][ج]] != السجل) { الكل := خطأ; };
                        ج := ج + 1;
                    }
                    إذا (الكل) {
                        ليكن المعرف: معرف_سجل_افتراضي = { القيمة: السجل };
                        ألحق(الناتج[ك], المعرف);
                    };
                };
                م := م + 1;
            }
        };
        ك := ك + 1;
    }
    أرجع الناتج;
}

عرف حل_حياة_كتل_تخصيص(
    المسألة: &مسألة_تخصيص,
    الحياة: &متغير متجه حياة_كتلة_تخصيص,
    الممتدة: &متجه متجه معرف_سجل_افتراضي
): فراغ {
    ليكن الفهارس: فهارس_حواف_حياة = ابن_فهارس_حواف_حياة(المسألة);
    ليكن عدد_الكتل: طبيعي = الطول((*المسألة).الكتل) مثل طبيعي;

    // Fixed-point updates mutate the already-owned per-block live-in/out
    // buffers. Candidate buffers alone are scratch; final users borrow facts
    // directly from the block, without a second materialization pass.
    ليكن ك: متغير طبيعي = 0;
    ليكن قيم_خروج_جديد: متجه معرف_سجل_افتراضي = [];
    ليكن خروج_جديد: متغير مخزن_حياة_مؤقت = { القيم: قيم_خروج_جديد, العدد: 0 };
    ليكن قيم_دخول_جديد: متجه معرف_سجل_افتراضي = [];
    ليكن دخول_جديد: متغير مخزن_حياة_مؤقت = { القيم: قيم_دخول_جديد, العدد: 0 };

    // The worklist can never have more pending entries than blocks because
    // `في_الطابور` suppresses duplicates. Keep a bounded FIFO ring instead of
    // retaining every processed/requeued entry in an append-only history.
    ليكن الطابور: متغير متجه طبيعي = [];
    ليكن في_الطابور: متغير متجه منطقي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ألحق(الطابور, 0);
        ألحق(في_الطابور, خطأ);
        ك := ك + 1;
    }
    ليكن رأس_الطابور: متغير طبيعي = 0;
    ليكن ذيل_الطابور: متغير طبيعي = 0;
    ليكن عدد_الطابور: متغير طبيعي = 0;
    ك := عدد_الكتل;
    طالما (ك > 0) {
        ك := ك - 1;
        الطابور[ذيل_الطابور] := ك;
        ذيل_الطابور := (ذيل_الطابور + 1) % عدد_الكتل;
        عدد_الطابور := عدد_الطابور + 1;
        في_الطابور[ك] := صواب;
    }
    طالما (عدد_الطابور > 0) {
        ليكن الكتلة: طبيعي = الطابور[رأس_الطابور];
        رأس_الطابور := (رأس_الطابور + 1) % عدد_الكتل;
        عدد_الطابور := عدد_الطابور - 1;
        في_الطابور[الكتلة] := خطأ;

        امسح_مخزن_حياة(&متغير خروج_جديد);
        ليكن ه: متغير طبيعي = 0;
        طالما (ه < (الطول(الفهارس.الخارجة[الكتلة]) مثل طبيعي)) {
            ليكن فهرس_الحافة: طبيعي = الفهارس.الخارجة[الكتلة][ه];
            ليكن الحافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[فهرس_الحافة];
            ليكن اللاحق: طبيعي = (*الحافة).إلى_كتلة.القيمة;
            إذا (اللاحق < عدد_الكتل) {
                ادمج_نقلات_حافة_في_مخزن_حياة(
                    &متغير خروج_جديد, &(*الحياة)[اللاحق].الدخول, الحافة
                );
            };
            ه := ه + 1;
        }
        إذا (الكتلة < (الطول(*الممتدة) مثل طبيعي)) {
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول((*الممتدة)[الكتلة]) مثل طبيعي)) {
                أضف_إلى_مخزن_حياة(&متغير خروج_جديد, (*الممتدة)[الكتلة][م]);
                م := م + 1;
            }
        };
        احسب_دخول_حياة_في_مخزن(
            &(*الحياة)[الكتلة].الاستخدامات,
            &(*الحياة)[الكتلة].التعريفات,
            &خروج_جديد,
            &متغير دخول_جديد
        );
        ليكن تغير_الخروج: منطقي = !مخزنا_حياة_متساويان(&خروج_جديد, &(*الحياة)[الكتلة].الخروج);
        ليكن تغير_الدخول: منطقي = !مخزنا_حياة_متساويان(&دخول_جديد, &(*الحياة)[الكتلة].الدخول);
        إذا (تغير_الخروج) {
            انسخ_مخزن_حياة_إلى_مخزن(&خروج_جديد, &متغير (*الحياة)[الكتلة].الخروج);
        };
        إذا (تغير_الدخول) {
            انسخ_مخزن_حياة_إلى_مخزن(&دخول_جديد, &متغير (*الحياة)[الكتلة].الدخول);
            ليكن س: متغير طبيعي = 0;
            طالما (س < (الطول(الفهارس.الأسلاف[الكتلة]) مثل طبيعي)) {
                ليكن السلف: طبيعي = الفهارس.الأسلاف[الكتلة][س];
                إذا (!في_الطابور[السلف]) {
                    الطابور[ذيل_الطابور] := السلف;
                    ذيل_الطابور := (ذيل_الطابور + 1) % عدد_الكتل;
                    عدد_الطابور := عدد_الطابور + 1;
                    في_الطابور[السلف] := صواب;
                };
                س := س + 1;
            }
        };
    }

}

// Appends the segment (البداية, النهاية) to a register's segments.
عرف أضف_مقطعا_حيا(
    المجالات: &متغير متجه مجال_حياة_سجل,
    السجل: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي
): فراغ {
    إذا (السجل >= (الطول(*المجالات) مثل طبيعي)) { أرجع; };
    ألحق((*المجالات)[السجل].المقاطع, البداية);
    ألحق((*المجالات)[السجل].المقاطع, النهاية);
}

// Sorts a register's segments by start and merges those that overlap or
// touch.
عرف رتب_مقاطع_حية(المقاطع: &متجه طبيعي): متجه طبيعي {
    ليكن العدد: طبيعي = (الطول(*المقاطع) مثل طبيعي) / 2;
    ليكن الترتيب: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الترتيب, ف); ف := ف + 1; }
    // Insertion sort of the pair indices by start: a register has few
    // segments, mostly already in order.
    ف := 1;
    طالما (ف < العدد) {
        ليكن الحالي: طبيعي = الترتيب[ف];
        ليكن م: متغير طبيعي = ف;
        طالما (م > 0 && (*المقاطع)[الترتيب[م - 1] * 2] > (*المقاطع)[الحالي * 2]) {
            الترتيب[م] := الترتيب[م - 1];
            م := م - 1;
        }
        الترتيب[م] := الحالي;
        ف := ف + 1;
    }
    ليكن الناتج: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) {
        ليكن ب: طبيعي = (*المقاطع)[الترتيب[ف] * 2];
        ليكن ن: طبيعي = (*المقاطع)[الترتيب[ف] * 2 + 1];
        ليكن الطول_: طبيعي = الطول(الناتج) مثل طبيعي;
        إذا (الطول_ >= 2 && ب <= الناتج[الطول_ - 1] + 1) {
            إذا (ن > الناتج[الطول_ - 1]) { الناتج[الطول_ - 1] := ن; };
        } وإلا {
            ألحق(الناتج, ب);
            ألحق(الناتج, ن);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف حلل_مجالات_الحياة(المسألة: &مسألة_تخصيص): متجه مجال_حياة_سجل {
    ليكن المجالات: متغير متجه مجال_حياة_سجل = [];
    تأكد_عدد_المجالات(&متغير المجالات, (*المسألة).عدد_السجلات_الافتراضية);

    // اجمع القيود والمواضع الصريحة أولا؛ تحليل CFG سيضيف المقاطع الحية بين هذه المواضع.
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المسألة).التعليمات) مثل طبيعي)) {
        ليكن حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[ف];
        ليكن ي: متغير طبيعي = 0;
        طالما (ي < (الطول((*حقيقة).الاستخدامات) مثل طبيعي)) {
            وسع_مجال(&متغير المجالات, &(*حقيقة).الاستخدامات[ي], (*حقيقة).الموضع);
            ي := ي + 1;
        }
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*حقيقة).التعريفات) مثل طبيعي)) {
            وسع_مجال(&متغير المجالات, &(*حقيقة).التعريفات[ت], (*حقيقة).الموضع);
            ت := ت + 1;
        }
        ف := ف + 1;
    }

    // حقائق النسخ على الحواف تحمل قيود السجلات أيضا، وتثبت حدود المصدر/الوجهة عند CFG.
    ليكن ه: متغير طبيعي = 0;
    طالما (ه < (الطول((*المسألة).نقلات_الحواف) مثل طبيعي)) {
        ليكن حافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[ه];
        ليكن موضع_المصدر: متغير طبيعي = 0;
        ليكن موضع_الوجهة: متغير طبيعي = 0;
        طابق ابحث_حقيقة_كتلة_تخصيص(&(*المسألة).الكتل, (*حافة).من_كتلة) مع
        | اختياري.موجود(حقيقة_المصدر) -> { موضع_المصدر := موضع_نهاية_كتلة_تخصيص(&حقيقة_المصدر); }
        | اختياري.لا_شيء -> { };
        طابق ابحث_حقيقة_كتلة_تخصيص(&(*المسألة).الكتل, (*حافة).إلى_كتلة) مع
        | اختياري.موجود(حقيقة_الوجهة) -> { موضع_الوجهة := حقيقة_الوجهة.البداية; }
        | اختياري.لا_شيء -> { };
        ليكن ن: متغير طبيعي = 0;
        طالما (ن < (الطول((*حافة).النقلات) مثل طبيعي)) {
            وسع_مجال(&متغير المجالات, &(*حافة).النقلات[ن].المصدر, موضع_المصدر);
            وسع_مجال(&متغير المجالات, &(*حافة).النقلات[ن].الوجهة, موضع_الوجهة);
            // An edge reads its sources at the end of its block and writes
            // its destinations at the start of its target.
            أضف_مقطعا_حيا(&متغير المجالات, (*حافة).النقلات[ن].المصدر.السجل.القيمة, موضع_المصدر, موضع_المصدر);
            أضف_مقطعا_حيا(&متغير المجالات, (*حافة).النقلات[ن].الوجهة.السجل.القيمة, موضع_الوجهة, موضع_الوجهة);
            ن := ن + 1;
        }
        ه := ه + 1;
    }

    // حقائق الربط تخص السجل الافتراضي نفسه؛ لا يعاد البحث عنها أثناء التخصيص.
    ليكن قف: متغير طبيعي = 0;
    طالما (قف < (الطول((*المسألة).التعليمات) مثل طبيعي)) {
        ليكن قح: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[قف];
        ليكن قر: متغير طبيعي = 0;
        طالما (قر < (الطول((*قح).القيود_المربوطة) مثل طبيعي)) {
            ليكن قيد: قيد_ربط_تخصيص = (*قح).القيود_المربوطة[قر];
            ألحق(المجالات[قيد.الأول.القيمة].السجلات_المربوطة, قيد.الثاني);
            ألحق(المجالات[قيد.الثاني.القيمة].السجلات_المربوطة, قيد.الأول);
            قر := قر + 1;
        }
        قف := قف + 1;
    }

    ليكن حياة_الكتل: متغير متجه حياة_كتلة_تخصيص = ابن_حياة_كتل_تخصيص(المسألة);
    ليكن الممتدة: متجه متجه معرف_سجل_افتراضي = خروج_ممتد_لكتل_تخصيص(المسألة);
    حل_حياة_كتل_تخصيص(المسألة, &متغير حياة_الكتل, &الممتدة);
    // The end of the segment each register has open in the backward walk
    // below (لا_مقطع_مفتوح: none).
    ليكن لا_مقطع_مفتوح: طبيعي = 0xFFFFFFFFFFFFFFFF;
    ليكن النهاية_المفتوحة: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(المجالات) مثل طبيعي)) { ألحق(النهاية_المفتوحة, لا_مقطع_مفتوح); ف := ف + 1; }

    // تمثل الحياة كمجموعات سجلات افتراضية مرتبة ومتناثرة؛ لا توجد مصفوفة
    // كتلة × سجل، ولا مسح لجميع السجلات عند حدود الكتلة أو النداء.
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*المسألة).الكتل) مثل طبيعي)) {
        ليكن حقيقة_الكتلة: &حقيقة_كتلة_تخصيص = &(*المسألة).الكتل[ك];
        ليكن بداية_الكتلة: طبيعي = (*حقيقة_الكتلة).البداية;
        ليكن نهاية_الكتلة: طبيعي = موضع_نهاية_كتلة_تخصيص(حقيقة_الكتلة);
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < (حياة_الكتل[ك].الدخول.العدد)) {
            وسع_حدود_مجال(&متغير المجالات, حياة_الكتل[ك].الدخول.القيم[ر], بداية_الكتلة);
            ر := ر + 1;
        }
        ر := 0;
        طالما (ر < (حياة_الكتل[ك].الخروج.العدد)) {
            وسع_حدود_مجال(&متغير المجالات, حياة_الكتل[ك].الخروج.القيم[ر], نهاية_الكتلة);
            ر := ر + 1;
        }

        ليكن قيم_الحي: متجه معرف_سجل_افتراضي = [];
        ليكن الحي: متغير مخزن_حياة_مؤقت = { القيم: قيم_الحي, العدد: 0 };
        انسخ_مخزن_حياة_إلى_مخزن(&حياة_الكتل[ك].الخروج, &متغير الحي);
        ر := 0;
        طالما (ر < الحي.العدد) {
            ليكن الخارج: طبيعي = الحي.القيم[ر].القيمة;
            إذا (الخارج < (الطول(النهاية_المفتوحة) مثل طبيعي)) { النهاية_المفتوحة[الخارج] := نهاية_الكتلة; };
            ر := ر + 1;
        }
        ليكن قيم_الحي_التالي: متجه معرف_سجل_افتراضي = [];
        ليكن الحي_التالي: متغير مخزن_حياة_مؤقت = { القيم: قيم_الحي_التالي, العدد: 0 };
        ليكن موضع: متغير طبيعي = (*حقيقة_الكتلة).النهاية;
        طالما (موضع > (*حقيقة_الكتلة).البداية) {
            موضع := موضع - 1;
            ليكن حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[موضع];
            // Segments: a definition closes its register's open segment
            // (or is one position of its own); a use opens one.
            ليكن ت_م: متغير طبيعي = 0;
            طالما (ت_م < (الطول((*حقيقة).التعريفات) مثل طبيعي)) {
                ليكن المعرف_: طبيعي = (*حقيقة).التعريفات[ت_م].السجل.القيمة;
                إذا (المعرف_ < (الطول(النهاية_المفتوحة) مثل طبيعي)) {
                    إذا (النهاية_المفتوحة[المعرف_] != لا_مقطع_مفتوح) {
                        أضف_مقطعا_حيا(&متغير المجالات, المعرف_, موضع, النهاية_المفتوحة[المعرف_]);
                        النهاية_المفتوحة[المعرف_] := لا_مقطع_مفتوح;
                    } وإلا {
                        أضف_مقطعا_حيا(&متغير المجالات, المعرف_, موضع, موضع);
                    };
                };
                ت_م := ت_م + 1;
            }
            ليكن س_م: متغير طبيعي = 0;
            طالما (س_م < (الطول((*حقيقة).الاستخدامات) مثل طبيعي)) {
                ليكن المعرف_: طبيعي = (*حقيقة).الاستخدامات[س_م].السجل.القيمة;
                إذا (المعرف_ < (الطول(النهاية_المفتوحة) مثل طبيعي) && النهاية_المفتوحة[المعرف_] == لا_مقطع_مفتوح) {
                    النهاية_المفتوحة[المعرف_] := موضع;
                };
                س_م := س_م + 1;
            }
            ليكن له_حد: منطقي = (((الطول((*حقيقة).السجلات_المفسدة) مثل طبيعي) > 0) || (*حقيقة).حد_نداء);
            إذا (له_حد) {
                ليكن ب: متغير طبيعي = 0;
                طالما (ب < الحي.العدد) {
                    ليكن السجل_الحي: معرف_سجل_افتراضي = الحي.القيم[ب];
                    ليكن معرف_هنا: متغير منطقي = خطأ;
                    ليكن د: متغير طبيعي = 0;
                    طالما (د < (الطول((*حقيقة).التعريفات) مثل طبيعي)) {
                        إذا (معرفا_سجل_افتراضي_متساويان((*حقيقة).التعريفات[د].السجل, السجل_الحي)) {
                            معرف_هنا := صواب;
                            د := الطول((*حقيقة).التعريفات) مثل طبيعي;
                        } وإلا { د := د + 1; };
                    }
                    ليكن مستخدم_هنا: متغير منطقي = خطأ;
                    إذا (معرف_هنا) {
                        ليكن س: متغير طبيعي = 0;
                        طالما (س < (الطول((*حقيقة).الاستخدامات) مثل طبيعي)) {
                            إذا (معرفا_سجل_افتراضي_متساويان((*حقيقة).الاستخدامات[س].السجل, السجل_الحي)) {
                                مستخدم_هنا := صواب;
                                س := الطول((*حقيقة).الاستخدامات) مثل طبيعي;
                            } وإلا { س := س + 1; };
                        }
                    };
                    إذا (!معرف_هنا || مستخدم_هنا) {
                        أضف_مفسدات_إلى_مجال(
                            &متغير المجالات[السجل_الحي.القيمة],
                            &(*حقيقة).السجلات_المفسدة,
                            (*حقيقة).حد_نداء
                        );
                    };
                    ب := ب + 1;
                }
            };
            انتقال_تعليمة_حياة_إلى_مخزن(
                &الحي,
                &(*حقيقة).التعريفات,
                &(*حقيقة).الاستخدامات,
                &متغير الحي_التالي
            );
            ليكن التبادل: مخزن_حياة_مؤقت = الحي;
            الحي := الحي_التالي;
            الحي_التالي := التبادل;
        }
        // What is still open is live into the block.
        ر := 0;
        طالما (ر < الحي.العدد) {
            ليكن الداخل: طبيعي = الحي.القيم[ر].القيمة;
            إذا (الداخل < (الطول(النهاية_المفتوحة) مثل طبيعي) && النهاية_المفتوحة[الداخل] != لا_مقطع_مفتوح) {
                أضف_مقطعا_حيا(&متغير المجالات, الداخل, بداية_الكتلة, النهاية_المفتوحة[الداخل]);
                النهاية_المفتوحة[الداخل] := لا_مقطع_مفتوح;
            };
            ر := ر + 1;
        }
        ك := ك + 1;
    }
    // Sorted, merged segments; a register no position reached keeps its
    // whole span.
    ف := 0;
    طالما (ف < (الطول(المجالات) مثل طبيعي)) {
        طابق المجالات[ف].الفئة مع
        | اختياري.موجود(_) -> {
            إذا ((الطول(المجالات[ف].المقاطع) مثل طبيعي) == 0) {
                ألحق(المجالات[ف].المقاطع, المجالات[ف].البداية);
                ألحق(المجالات[ف].المقاطع, المجالات[ف].النهاية);
            } وإلا {
                المجالات[ف].المقاطع := رتب_مقاطع_حية(&المجالات[ف].المقاطع);
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع المجالات;
}
