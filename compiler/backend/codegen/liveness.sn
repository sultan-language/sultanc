استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.virtual_registers;

عام نوع مجال_حياة_سجل = {
    السجل: معرف_سجل_افتراضي,
    البداية: طبيعي,
    النهاية: طبيعي,
    يعبر_نداء: منطقي,
    السجلات_المفسدة: متجه معرف_سجل_فعلي,
    السجلات_المربوطة: متجه معرف_سجل_افتراضي,
    ثابت: اختياري معرف_سجل_فعلي,
    الفئة: اختياري معرف_فئة_تخصيص,
    تعارض_قيود: منطقي,
    // The positions where the register is live, as sorted disjoint
    // inclusive pairs (start, end, start, end, ...): البداية..النهاية
    // with its holes (Traub et al.'s lifetime holes). A definition nothing
    // reads is live at its own position.
    المقاطع: متجه طبيعي
};

// Sparse sets keep backing capacity across fixed-point iterations. The same
// owned buffers hold final per-block liveness; no second finalized copy.
نوع مخزن_حياة_مؤقت = {
    القيم: متجه معرف_سجل_افتراضي,
    العدد: طبيعي
};

نوع حياة_كتلة_تخصيص = {
    الاستخدامات: متجه معرف_سجل_افتراضي,
    التعريفات: متجه معرف_سجل_افتراضي,
    الدخول: مخزن_حياة_مؤقت,
    الخروج: مخزن_حياة_مؤقت
};

نوع فهارس_حواف_حياة = {
    الخارجة: متجه متجه طبيعي,
    الأسلاف: متجه متجه طبيعي
};

عرف انسخ_مجموعة_حياة(
    المصدر: &متجه معرف_سجل_افتراضي
): متجه معرف_سجل_افتراضي {
    دع الناتج: متغير متجه معرف_سجل_افتراضي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف مجموعتا_حياة_متساويتان(
    أ: &متجه معرف_سجل_افتراضي,
    ب: &متجه معرف_سجل_افتراضي
): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا (!معرفا_سجل_افتراضي_متساويان((*أ)[ف], (*ب)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف موضع_سجل_حي(
    المجموعة: &متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): طبيعي {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*المجموعة) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        إذا ((*المجموعة)[الوسط].القيمة < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عرف مجموعة_حياة_تحتوي(
    المجموعة: &متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): منطقي {
    دع الموضع: طبيعي = موضع_سجل_حي(المجموعة, السجل);
    إذا (الموضع >= (الطول(*المجموعة) مثل طبيعي)) { أرجع خطأ; };
    أرجع معرفا_سجل_افتراضي_متساويان((*المجموعة)[الموضع], السجل);
}

عرف أضف_سجلا_حيا(
    المجموعة: &متغير متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): فراغ {
    // Keep the common increasing-ID insertion append-only; shift only for
    // genuinely out-of-order values, preserving the sparse sorted invariant.
    دع العدد: طبيعي = الطول(*المجموعة) مثل طبيعي;
    إذا (العدد == 0) { ألحق(*المجموعة, السجل); أرجع; };
    دع الأخير: طبيعي = (*المجموعة)[العدد - 1].القيمة;
    إذا (الأخير == السجل.القيمة) { أرجع; };
    إذا (الأخير < السجل.القيمة) { ألحق(*المجموعة, السجل); أرجع; };
    دع الموضع: طبيعي = موضع_سجل_حي(المجموعة, السجل);
    إذا (الموضع < العدد) {
        إذا (معرفا_سجل_افتراضي_متساويان((*المجموعة)[الموضع], السجل)) { أرجع; };
    };
    ألحق(*المجموعة, السجل);
    دع ف: متغير طبيعي = الطول(*المجموعة) مثل طبيعي;
    ف := ف - 1;
    طالما (ف > الموضع) {
        دع السابق: طبيعي = ف - 1;
        (*المجموعة)[ف] := (*المجموعة)[السابق];
        ف := السابق;
    }
    (*المجموعة)[الموضع] := السجل;
}

عرف احسب_دخول_حياة(
    الاستخدامات: &متجه معرف_سجل_افتراضي,
    التعريفات: &متجه معرف_سجل_افتراضي,
    الخروج: &متجه معرف_سجل_افتراضي
): متجه معرف_سجل_افتراضي {
    دع الناتج: متغير متجه معرف_سجل_افتراضي = انسخ_مجموعة_حياة(الاستخدامات);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الخروج) مثل طبيعي)) {
        إذا (!مجموعة_حياة_تحتوي(التعريفات, (*الخروج)[ف])) {
            أضف_سجلا_حيا(&متغير الناتج, (*الخروج)[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اكتب_في_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت,
    الموضع: طبيعي,
    السجل: معرف_سجل_افتراضي
): فراغ {
    إذا (الموضع < (الطول((*المخزن).القيم) مثل طبيعي)) {
        (*المخزن).القيم[الموضع] := السجل;
    } وإلا {
        ألحق((*المخزن).القيم, السجل);
    };
    إذا (الموضع >= (*المخزن).العدد) { (*المخزن).العدد := الموضع + 1; };
}

عرف موضع_سجل_في_مخزن_حياة(
    المخزن: &مخزن_حياة_مؤقت,
    السجل: معرف_سجل_افتراضي
): طبيعي {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = (*المخزن).العدد;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        إذا ((*المخزن).القيم[الوسط].القيمة < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عرف أضف_إلى_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت,
    السجل: معرف_سجل_افتراضي
): فراغ {
    دع القديم: طبيعي = (*المخزن).العدد;
    إذا (القديم == 0) { اكتب_في_مخزن_حياة(المخزن, 0, السجل); أرجع; };
    دع الأخير: طبيعي = (*المخزن).القيم[القديم - 1].القيمة;
    إذا (الأخير == السجل.القيمة) { أرجع; };
    إذا (الأخير < السجل.القيمة) {
        اكتب_في_مخزن_حياة(المخزن, القديم, السجل);
        أرجع;
    };
    دع الموضع: طبيعي = موضع_سجل_في_مخزن_حياة(المخزن, السجل);
    إذا (الموضع < القديم) {
        إذا (معرفا_سجل_افتراضي_متساويان((*المخزن).القيم[الموضع], السجل)) { أرجع; };
    };
    إذا (القديم < (الطول((*المخزن).القيم) مثل طبيعي)) {
        (*المخزن).العدد := القديم + 1;
    } وإلا {
        ألحق((*المخزن).القيم, السجل);
        (*المخزن).العدد := القديم + 1;
    };
    دع ف: متغير طبيعي = القديم;
    طالما (ف > الموضع) {
        دع السابق: طبيعي = ف - 1;
        (*المخزن).القيم[ف] := (*المخزن).القيم[السابق];
        ف := السابق;
    }
    (*المخزن).القيم[الموضع] := السجل;
}

عرف انتقال_تعليمة_حياة_إلى_مخزن(
    بعد: &مخزن_حياة_مؤقت,
    التعريفات: &متجه طلب_سجل_تخصيص,
    الاستخدامات: &متجه طلب_سجل_تخصيص,
    الناتج: &متغير مخزن_حياة_مؤقت
): فراغ {
    (*الناتج).العدد := 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*بعد).العدد) {
        دع معرف: معرف_سجل_افتراضي = (*بعد).القيم[ف];
        دع معرف_معرف: متغير منطقي = خطأ;
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(*التعريفات) مثل طبيعي)) {
            إذا (معرفا_سجل_افتراضي_متساويان((*التعريفات)[ت].السجل, معرف)) {
                معرف_معرف := صواب;
                ت := الطول(*التعريفات) مثل طبيعي;
            } وإلا {
                ت := ت + 1;
            };
        }
        إذا (!معرف_معرف) {
            اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, معرف);
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*الاستخدامات) مثل طبيعي)) {
        أضف_إلى_مخزن_حياة(الناتج, (*الاستخدامات)[ف].السجل);
        ف := ف + 1;
    }
}

عرف امسح_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت
): فراغ {
    (*المخزن).العدد := 0;
}

عرف مخزنا_حياة_متساويان(
    أ: &مخزن_حياة_مؤقت,
    ب: &مخزن_حياة_مؤقت
): منطقي {
    إذا ((*أ).العدد != (*ب).العدد) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*أ).العدد) {
        إذا (!معرفا_سجل_افتراضي_متساويان((*أ).القيم[ف], (*ب).القيم[ف])) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_مخزن_حياة_إلى_مخزن(
    المصدر: &مخزن_حياة_مؤقت,
    الوجهة: &متغير مخزن_حياة_مؤقت
): فراغ {
    امسح_مخزن_حياة(الوجهة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*المصدر).العدد) {
        اكتب_في_مخزن_حياة(الوجهة, ف, (*المصدر).القيم[ف]);
        ف := ف + 1;
    }
}

عرف احسب_دخول_حياة_في_مخزن(
    الاستخدامات: &متجه معرف_سجل_افتراضي,
    التعريفات: &متجه معرف_سجل_افتراضي,
    الخروج: &مخزن_حياة_مؤقت,
    الناتج: &متغير مخزن_حياة_مؤقت
): فراغ {
    // Both inputs are sorted sparse sets. Merge use with (out - def) in
    // linear output order instead of inserting each out element and shifting
    // the growing live-in vector O(L^2) times.
    امسح_مخزن_حياة(الناتج);
    دع ف: متغير طبيعي = 0;
    دع خ: متغير طبيعي = 0;
    دع عدد_الاستخدامات: طبيعي = الطول(*الاستخدامات) مثل طبيعي;
    طالما (ف < عدد_الاستخدامات || خ < (*الخروج).العدد) {
        طالما (خ < (*الخروج).العدد && مجموعة_حياة_تحتوي(التعريفات, (*الخروج).القيم[خ])) {
            خ := خ + 1;
        }
        إذا (ف < عدد_الاستخدامات && خ < (*الخروج).العدد) {
            دع من_استخدام: معرف_سجل_افتراضي = (*الاستخدامات)[ف];
            دع من_خروج: معرف_سجل_افتراضي = (*الخروج).القيم[خ];
            إذا (من_استخدام.القيمة <= من_خروج.القيمة) {
                اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, من_استخدام);
                ف := ف + 1;
                إذا (من_استخدام.القيمة == من_خروج.القيمة) { خ := خ + 1; };
            } وإلا {
                اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, من_خروج);
                خ := خ + 1;
            };
        } وإلا إذا (ف < عدد_الاستخدامات) {
            اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, (*الاستخدامات)[ف]);
            ف := ف + 1;
        } وإلا إذا (خ < (*الخروج).العدد) {
            اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, (*الخروج).القيم[خ]);
            خ := خ + 1;
        };
    }
}

عرف طبق_قيد_طلب(
    المجالات: &متغير متجه مجال_حياة_سجل,
    الفهرس: طبيعي,
    الطلب: &طلب_سجل_تخصيص
): فراغ {
    طابق (*المجالات)[الفهرس].الفئة مع
    | اختياري.موجود(الفئة) -> {
        إذا (!معرفا_فئة_تخصيص_متساويان(الفئة, (*الطلب).الفئة)) {
            (*المجالات)[الفهرس].تعارض_قيود := صواب;
        };
    }
    | اختياري.لا_شيء -> {
        (*المجالات)[الفهرس].الفئة := اختياري.موجود((*الطلب).الفئة);
    };
    طابق (*الطلب).ثابت مع
    | اختياري.موجود(الثابت) -> {
        طابق (*المجالات)[الفهرس].ثابت مع
        | اختياري.موجود(الحالي) -> {
            إذا (!معرفا_سجل_فعلي_متساويان(الحالي, الثابت)) {
                (*المجالات)[الفهرس].تعارض_قيود := صواب;
            };
        }
        | اختياري.لا_شيء -> {
            (*المجالات)[الفهرس].ثابت := اختياري.موجود(الثابت);
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف ألحق_مجال_فارغ(المجالات: &متغير متجه مجال_حياة_سجل): فراغ {
    دع م: طبيعي = الطول(*المجالات) مثل طبيعي;
    دع المعرف: معرف_سجل_افتراضي = { القيمة: م };
    دع لا_ثابت: اختياري معرف_سجل_فعلي = اختياري.لا_شيء();
    دع لا_فئة: اختياري معرف_فئة_تخصيص = اختياري.لا_شيء();
    دع لا_مفسدات: متجه معرف_سجل_فعلي = [];
    دع لا_مربوطات: متجه معرف_سجل_افتراضي = [];
    دع لا_مقاطع: متجه طبيعي = [];
    دع فارغ: مجال_حياة_سجل = {
        السجل: المعرف,
        البداية: 0,
        النهاية: 0,
        يعبر_نداء: خطأ,
        السجلات_المفسدة: لا_مفسدات,
        السجلات_المربوطة: لا_مربوطات,
        ثابت: لا_ثابت,
        الفئة: لا_فئة,
        تعارض_قيود: خطأ,
        المقاطع: لا_مقاطع
    };
    ألحق(*المجالات, فارغ);
}

عرف تأكد_عدد_المجالات(
    المجالات: &متغير متجه مجال_حياة_سجل,
    العدد: طبيعي
): فراغ {
    طالما ((الطول(*المجالات) مثل طبيعي) < العدد) {
        ألحق_مجال_فارغ(المجالات);
    }
}

عرف وسع_مجال(
    المجالات: &متغير متجه مجال_حياة_سجل,
    الطلب: &طلب_سجل_تخصيص,
    الموضع: طبيعي
): فراغ {
    تأكد_عدد_المجالات(المجالات, (*الطلب).السجل.القيمة + 1);
    دع ف: طبيعي = (*الطلب).السجل.القيمة;
    طابق (*المجالات)[ف].الفئة مع
    | اختياري.لا_شيء -> {
        (*المجالات)[ف].البداية := الموضع;
        (*المجالات)[ف].النهاية := الموضع;
    }
    | اختياري.موجود(_) -> {
        إذا (الموضع < (*المجالات)[ف].البداية) { (*المجالات)[ف].البداية := الموضع; };
        إذا (الموضع > (*المجالات)[ف].النهاية) { (*المجالات)[ف].النهاية := الموضع; };
    };
    طبق_قيد_طلب(المجالات, ف, الطلب);
}

عرف وسع_حدود_مجال(
    المجالات: &متغير متجه مجال_حياة_سجل,
    السجل: معرف_سجل_افتراضي,
    الموضع: طبيعي
): فراغ {
    إذا (السجل.القيمة >= (الطول(*المجالات) مثل طبيعي)) { أرجع; };
    طابق (*المجالات)[السجل.القيمة].الفئة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(_) -> {
        إذا (الموضع < (*المجالات)[السجل.القيمة].البداية) {
            (*المجالات)[السجل.القيمة].البداية := الموضع;
        };
        إذا (الموضع > (*المجالات)[السجل.القيمة].النهاية) {
            (*المجالات)[السجل.القيمة].النهاية := الموضع;
        };
    };
}

عرف أضف_مفسدات_إلى_مجال(
    المجال: &متغير مجال_حياة_سجل,
    المفسدات: &متجه معرف_سجل_فعلي,
    حد_نداء: منطقي
): فراغ {
    إذا (حد_نداء) { (*المجال).يعبر_نداء := صواب; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المفسدات) مثل طبيعي)) {
        دع موجود: متغير منطقي = خطأ;
        دع س: متغير طبيعي = 0;
        طالما (س < (الطول((*المجال).السجلات_المفسدة) مثل طبيعي)) {
            إذا (معرفا_سجل_فعلي_متساويان((*المجال).السجلات_المفسدة[س], (*المفسدات)[ف])) {
                موجود := صواب;
                س := الطول((*المجال).السجلات_المفسدة) مثل طبيعي;
            } وإلا {
                س := س + 1;
            };
        }
        إذا (!موجود) { ألحق((*المجال).السجلات_المفسدة, (*المفسدات)[ف]); };
        ف := ف + 1;
    }
}

عرف ابحث_حقيقة_كتلة_تخصيص(
    الكتل: &متجه حقيقة_كتلة_تخصيص,
    المعرف: معرف_كتلة_منتقاة
): اختياري حقيقة_كتلة_تخصيص {
    دع ف: طبيعي = المعرف.القيمة;
    إذا (ف >= (الطول(*الكتل) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا (!معرفا_كتلة_منتقاة_متساويان((*الكتل)[ف].المعرف, المعرف)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*الكتل)[ف]);
}

عرف موضع_نهاية_كتلة_تخصيص(الحقيقة: &حقيقة_كتلة_تخصيص): طبيعي {
    إذا ((*الحقيقة).النهاية > (*الحقيقة).البداية) { أرجع (*الحقيقة).النهاية - 1; };
    أرجع (*الحقيقة).البداية;
}

عرف ابن_حياة_كتل_تخصيص(المسألة: &مسألة_تخصيص): متجه حياة_كتلة_تخصيص {
    دع الناتج: متغير متجه حياة_كتلة_تخصيص = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*المسألة).الكتل) مثل طبيعي)) {
        دع الاستخدامات: متغير متجه معرف_سجل_افتراضي = [];
        دع التعريفات: متغير متجه معرف_سجل_افتراضي = [];
        دع الحقيقة_الكتلة: &حقيقة_كتلة_تخصيص = &(*المسألة).الكتل[ك];
        دع الموضع: متغير طبيعي = (*الحقيقة_الكتلة).البداية;
        طالما (الموضع < (*الحقيقة_الكتلة).النهاية) {
            دع حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[الموضع];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*حقيقة).الاستخدامات) مثل طبيعي)) {
                دع السجل: معرف_سجل_افتراضي = (*حقيقة).الاستخدامات[ف].السجل;
                إذا (!مجموعة_حياة_تحتوي(&التعريفات, السجل)) {
                    أضف_سجلا_حيا(&متغير الاستخدامات, السجل);
                };
                ف := ف + 1;
            }
            ف := 0;
            طالما (ف < (الطول((*حقيقة).التعريفات) مثل طبيعي)) {
                أضف_سجلا_حيا(&متغير التعريفات, (*حقيقة).التعريفات[ف].السجل);
                ف := ف + 1;
            }
            الموضع := الموضع + 1;
        }
        دع قيم_الدخول: متجه معرف_سجل_افتراضي = [];
        دع قيم_الخروج: متجه معرف_سجل_افتراضي = [];
        دع الدخول: مخزن_حياة_مؤقت = { القيم: قيم_الدخول, العدد: 0 };
        دع الخروج: مخزن_حياة_مؤقت = { القيم: قيم_الخروج, العدد: 0 };
        دع حياة: حياة_كتلة_تخصيص = {
            الاستخدامات: الاستخدامات,
            التعريفات: التعريفات,
            الدخول: الدخول,
            الخروج: الخروج
        };
        ألحق(الناتج, حياة);
        ك := ك + 1;
    }
    أرجع الناتج;
}

عرف ادمج_نقلات_حافة_في_حياة(
    الناتج: &متغير متجه معرف_سجل_افتراضي,
    الدخول_اللاحق: &متجه معرف_سجل_افتراضي,
    الحافة: &حقيقة_نقل_حافة_تخصيص
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الدخول_اللاحق) مثل طبيعي)) {
        دع مقتول: متغير منطقي = خطأ;
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول((*الحافة).النقلات) مثل طبيعي)) {
            إذا (معرفا_سجل_افتراضي_متساويان(
                (*الحافة).النقلات[ن].الوجهة.السجل, (*الدخول_اللاحق)[ف]
            )) {
                مقتول := صواب;
                ن := الطول((*الحافة).النقلات) مثل طبيعي;
            } وإلا { ن := ن + 1; };
        }
        إذا (!مقتول) { أضف_سجلا_حيا(الناتج, (*الدخول_اللاحق)[ف]); };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الحافة).النقلات) مثل طبيعي)) {
        أضف_سجلا_حيا(الناتج, (*الحافة).النقلات[ف].المصدر.السجل);
        ف := ف + 1;
    }
}

عرف ادمج_نقلات_حافة_في_مخزن_حياة(
    الناتج: &متغير مخزن_حياة_مؤقت,
    الدخول_اللاحق: &مخزن_حياة_مؤقت,
    الحافة: &حقيقة_نقل_حافة_تخصيص
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الدخول_اللاحق).العدد) {
        دع مقتول: متغير منطقي = خطأ;
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول((*الحافة).النقلات) مثل طبيعي)) {
            إذا (معرفا_سجل_افتراضي_متساويان(
                (*الحافة).النقلات[ن].الوجهة.السجل, (*الدخول_اللاحق).القيم[ف]
            )) {
                مقتول := صواب;
                ن := الطول((*الحافة).النقلات) مثل طبيعي;
            } وإلا { ن := ن + 1; };
        }
        إذا (!مقتول) { أضف_إلى_مخزن_حياة(الناتج, (*الدخول_اللاحق).القيم[ف]); };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الحافة).النقلات) مثل طبيعي)) {
        أضف_إلى_مخزن_حياة(الناتج, (*الحافة).النقلات[ف].المصدر.السجل);
        ف := ف + 1;
    }
}

عرف ابن_فهارس_حواف_حياة(المسألة: &مسألة_تخصيص): فهارس_حواف_حياة {
    دع الخارجة: متغير متجه متجه طبيعي = [];
    دع الأسلاف: متغير متجه متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*المسألة).الكتل) مثل طبيعي)) {
        دع فارغ_خارج: متجه طبيعي = [];
        دع فارغ_سلف: متجه طبيعي = [];
        ألحق(الخارجة, فارغ_خارج);
        ألحق(الأسلاف, فارغ_سلف);
        ك := ك + 1;
    }
    دع ه: متغير طبيعي = 0;
    طالما (ه < (الطول((*المسألة).نقلات_الحواف) مثل طبيعي)) {
        دع الحافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[ه];
        دع فهرس_المصدر: طبيعي = (*الحافة).من_كتلة.القيمة;
        دع فهرس_الوجهة: طبيعي = (*الحافة).إلى_كتلة.القيمة;
        إذا (
            فهرس_المصدر < (الطول(الخارجة) مثل طبيعي)
            && فهرس_الوجهة < (الطول(الأسلاف) مثل طبيعي)
        ) {
            ألحق(الخارجة[فهرس_المصدر], ه);
            ألحق(الأسلاف[فهرس_الوجهة], فهرس_المصدر);
        };
        ه := ه + 1;
    }
    دع الناتج: فهارس_حواف_حياة = { الخارجة: الخارجة, الأسلاف: الأسلاف };
    أرجع الناتج;
}

عرف حل_حياة_كتل_تخصيص(
    المسألة: &مسألة_تخصيص,
    الحياة: &متغير متجه حياة_كتلة_تخصيص
): فراغ {
    دع الفهارس: فهارس_حواف_حياة = ابن_فهارس_حواف_حياة(المسألة);
    دع عدد_الكتل: طبيعي = الطول((*المسألة).الكتل) مثل طبيعي;

    // Fixed-point updates mutate the already-owned per-block live-in/out
    // buffers. Candidate buffers alone are scratch; final users borrow facts
    // directly from the block, without a second materialization pass.
    دع ك: متغير طبيعي = 0;
    دع قيم_خروج_جديد: متجه معرف_سجل_افتراضي = [];
    دع خروج_جديد: متغير مخزن_حياة_مؤقت = { القيم: قيم_خروج_جديد, العدد: 0 };
    دع قيم_دخول_جديد: متجه معرف_سجل_افتراضي = [];
    دع دخول_جديد: متغير مخزن_حياة_مؤقت = { القيم: قيم_دخول_جديد, العدد: 0 };

    // The worklist can never have more pending entries than blocks because
    // `في_الطابور` suppresses duplicates. Keep a bounded FIFO ring instead of
    // retaining every processed/requeued entry in an append-only history.
    دع الطابور: متغير متجه طبيعي = [];
    دع في_الطابور: متغير متجه منطقي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ألحق(الطابور, 0);
        ألحق(في_الطابور, خطأ);
        ك := ك + 1;
    }
    دع رأس_الطابور: متغير طبيعي = 0;
    دع ذيل_الطابور: متغير طبيعي = 0;
    دع عدد_الطابور: متغير طبيعي = 0;
    ك := عدد_الكتل;
    طالما (ك > 0) {
        ك := ك - 1;
        الطابور[ذيل_الطابور] := ك;
        ذيل_الطابور := (ذيل_الطابور + 1) % عدد_الكتل;
        عدد_الطابور := عدد_الطابور + 1;
        في_الطابور[ك] := صواب;
    }
    طالما (عدد_الطابور > 0) {
        دع الكتلة: طبيعي = الطابور[رأس_الطابور];
        رأس_الطابور := (رأس_الطابور + 1) % عدد_الكتل;
        عدد_الطابور := عدد_الطابور - 1;
        في_الطابور[الكتلة] := خطأ;

        امسح_مخزن_حياة(&متغير خروج_جديد);
        دع ه: متغير طبيعي = 0;
        طالما (ه < (الطول(الفهارس.الخارجة[الكتلة]) مثل طبيعي)) {
            دع فهرس_الحافة: طبيعي = الفهارس.الخارجة[الكتلة][ه];
            دع الحافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[فهرس_الحافة];
            دع اللاحق: طبيعي = (*الحافة).إلى_كتلة.القيمة;
            إذا (اللاحق < عدد_الكتل) {
                ادمج_نقلات_حافة_في_مخزن_حياة(
                    &متغير خروج_جديد, &(*الحياة)[اللاحق].الدخول, الحافة
                );
            };
            ه := ه + 1;
        }
        احسب_دخول_حياة_في_مخزن(
            &(*الحياة)[الكتلة].الاستخدامات,
            &(*الحياة)[الكتلة].التعريفات,
            &خروج_جديد,
            &متغير دخول_جديد
        );
        دع تغير_الخروج: منطقي = !مخزنا_حياة_متساويان(&خروج_جديد, &(*الحياة)[الكتلة].الخروج);
        دع تغير_الدخول: منطقي = !مخزنا_حياة_متساويان(&دخول_جديد, &(*الحياة)[الكتلة].الدخول);
        إذا (تغير_الخروج) {
            انسخ_مخزن_حياة_إلى_مخزن(&خروج_جديد, &متغير (*الحياة)[الكتلة].الخروج);
        };
        إذا (تغير_الدخول) {
            انسخ_مخزن_حياة_إلى_مخزن(&دخول_جديد, &متغير (*الحياة)[الكتلة].الدخول);
            دع س: متغير طبيعي = 0;
            طالما (س < (الطول(الفهارس.الأسلاف[الكتلة]) مثل طبيعي)) {
                دع السلف: طبيعي = الفهارس.الأسلاف[الكتلة][س];
                إذا (!في_الطابور[السلف]) {
                    الطابور[ذيل_الطابور] := السلف;
                    ذيل_الطابور := (ذيل_الطابور + 1) % عدد_الكتل;
                    عدد_الطابور := عدد_الطابور + 1;
                    في_الطابور[السلف] := صواب;
                };
                س := س + 1;
            }
        };
    }

}

// Appends the segment (البداية, النهاية) to a register's segments.
عرف أضف_مقطعا_حيا(
    المجالات: &متغير متجه مجال_حياة_سجل,
    السجل: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي
): فراغ {
    إذا (السجل >= (الطول(*المجالات) مثل طبيعي)) { أرجع; };
    ألحق((*المجالات)[السجل].المقاطع, البداية);
    ألحق((*المجالات)[السجل].المقاطع, النهاية);
}

// Sorts a register's segments by start and merges those that overlap or
// touch.
عرف رتب_مقاطع_حية(المقاطع: &متجه طبيعي): متجه طبيعي {
    دع العدد: طبيعي = (الطول(*المقاطع) مثل طبيعي) / 2;
    دع الترتيب: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الترتيب, ف); ف := ف + 1; }
    // Insertion sort of the pair indices by start: a register has few
    // segments, mostly already in order.
    ف := 1;
    طالما (ف < العدد) {
        دع الحالي: طبيعي = الترتيب[ف];
        دع م: متغير طبيعي = ف;
        طالما (م > 0 && (*المقاطع)[الترتيب[م - 1] * 2] > (*المقاطع)[الحالي * 2]) {
            الترتيب[م] := الترتيب[م - 1];
            م := م - 1;
        }
        الترتيب[م] := الحالي;
        ف := ف + 1;
    }
    دع الناتج: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) {
        دع ب: طبيعي = (*المقاطع)[الترتيب[ف] * 2];
        دع ن: طبيعي = (*المقاطع)[الترتيب[ف] * 2 + 1];
        دع الطول_: طبيعي = الطول(الناتج) مثل طبيعي;
        إذا (الطول_ >= 2 && ب <= الناتج[الطول_ - 1] + 1) {
            إذا (ن > الناتج[الطول_ - 1]) { الناتج[الطول_ - 1] := ن; };
        } وإلا {
            ألحق(الناتج, ب);
            ألحق(الناتج, ن);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف حلل_مجالات_الحياة(المسألة: &مسألة_تخصيص): متجه مجال_حياة_سجل {
    دع المجالات: متغير متجه مجال_حياة_سجل = [];
    تأكد_عدد_المجالات(&متغير المجالات, (*المسألة).عدد_السجلات_الافتراضية);

    // اجمع القيود والمواضع الصريحة أولا؛ تحليل CFG سيضيف المقاطع الحية بين هذه المواضع.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المسألة).التعليمات) مثل طبيعي)) {
        دع حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[ف];
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول((*حقيقة).الاستخدامات) مثل طبيعي)) {
            وسع_مجال(&متغير المجالات, &(*حقيقة).الاستخدامات[ي], (*حقيقة).الموضع);
            ي := ي + 1;
        }
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*حقيقة).التعريفات) مثل طبيعي)) {
            وسع_مجال(&متغير المجالات, &(*حقيقة).التعريفات[ت], (*حقيقة).الموضع);
            ت := ت + 1;
        }
        ف := ف + 1;
    }

    // حقائق النسخ على الحواف تحمل قيود السجلات أيضا، وتثبت حدود المصدر/الوجهة عند CFG.
    دع ه: متغير طبيعي = 0;
    طالما (ه < (الطول((*المسألة).نقلات_الحواف) مثل طبيعي)) {
        دع حافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[ه];
        دع موضع_المصدر: متغير طبيعي = 0;
        دع موضع_الوجهة: متغير طبيعي = 0;
        طابق ابحث_حقيقة_كتلة_تخصيص(&(*المسألة).الكتل, (*حافة).من_كتلة) مع
        | اختياري.موجود(حقيقة_المصدر) -> { موضع_المصدر := موضع_نهاية_كتلة_تخصيص(&حقيقة_المصدر); }
        | اختياري.لا_شيء -> { };
        طابق ابحث_حقيقة_كتلة_تخصيص(&(*المسألة).الكتل, (*حافة).إلى_كتلة) مع
        | اختياري.موجود(حقيقة_الوجهة) -> { موضع_الوجهة := حقيقة_الوجهة.البداية; }
        | اختياري.لا_شيء -> { };
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول((*حافة).النقلات) مثل طبيعي)) {
            وسع_مجال(&متغير المجالات, &(*حافة).النقلات[ن].المصدر, موضع_المصدر);
            وسع_مجال(&متغير المجالات, &(*حافة).النقلات[ن].الوجهة, موضع_الوجهة);
            // An edge reads its sources at the end of its block and writes
            // its destinations at the start of its target.
            أضف_مقطعا_حيا(&متغير المجالات, (*حافة).النقلات[ن].المصدر.السجل.القيمة, موضع_المصدر, موضع_المصدر);
            أضف_مقطعا_حيا(&متغير المجالات, (*حافة).النقلات[ن].الوجهة.السجل.القيمة, موضع_الوجهة, موضع_الوجهة);
            ن := ن + 1;
        }
        ه := ه + 1;
    }

    // حقائق الربط تخص السجل الافتراضي نفسه؛ لا يعاد البحث عنها أثناء التخصيص.
    دع قف: متغير طبيعي = 0;
    طالما (قف < (الطول((*المسألة).التعليمات) مثل طبيعي)) {
        دع قح: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[قف];
        دع قر: متغير طبيعي = 0;
        طالما (قر < (الطول((*قح).القيود_المربوطة) مثل طبيعي)) {
            دع قيد: قيد_ربط_تخصيص = (*قح).القيود_المربوطة[قر];
            ألحق(المجالات[قيد.الأول.القيمة].السجلات_المربوطة, قيد.الثاني);
            ألحق(المجالات[قيد.الثاني.القيمة].السجلات_المربوطة, قيد.الأول);
            قر := قر + 1;
        }
        قف := قف + 1;
    }

    دع حياة_الكتل: متغير متجه حياة_كتلة_تخصيص = ابن_حياة_كتل_تخصيص(المسألة);
    حل_حياة_كتل_تخصيص(المسألة, &متغير حياة_الكتل);
    // The end of the segment each register has open in the backward walk
    // below (لا_مقطع_مفتوح: none).
    دع لا_مقطع_مفتوح: طبيعي = 0xFFFFFFFFFFFFFFFF;
    دع النهاية_المفتوحة: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(المجالات) مثل طبيعي)) { ألحق(النهاية_المفتوحة, لا_مقطع_مفتوح); ف := ف + 1; }

    // تمثل الحياة كمجموعات سجلات افتراضية مرتبة ومتناثرة؛ لا توجد مصفوفة
    // كتلة × سجل، ولا مسح لجميع السجلات عند حدود الكتلة أو النداء.
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*المسألة).الكتل) مثل طبيعي)) {
        دع حقيقة_الكتلة: &حقيقة_كتلة_تخصيص = &(*المسألة).الكتل[ك];
        دع بداية_الكتلة: طبيعي = (*حقيقة_الكتلة).البداية;
        دع نهاية_الكتلة: طبيعي = موضع_نهاية_كتلة_تخصيص(حقيقة_الكتلة);
        دع ر: متغير طبيعي = 0;
        طالما (ر < (حياة_الكتل[ك].الدخول.العدد)) {
            وسع_حدود_مجال(&متغير المجالات, حياة_الكتل[ك].الدخول.القيم[ر], بداية_الكتلة);
            ر := ر + 1;
        }
        ر := 0;
        طالما (ر < (حياة_الكتل[ك].الخروج.العدد)) {
            وسع_حدود_مجال(&متغير المجالات, حياة_الكتل[ك].الخروج.القيم[ر], نهاية_الكتلة);
            ر := ر + 1;
        }

        دع قيم_الحي: متجه معرف_سجل_افتراضي = [];
        دع الحي: متغير مخزن_حياة_مؤقت = { القيم: قيم_الحي, العدد: 0 };
        انسخ_مخزن_حياة_إلى_مخزن(&حياة_الكتل[ك].الخروج, &متغير الحي);
        ر := 0;
        طالما (ر < الحي.العدد) {
            دع الخارج: طبيعي = الحي.القيم[ر].القيمة;
            إذا (الخارج < (الطول(النهاية_المفتوحة) مثل طبيعي)) { النهاية_المفتوحة[الخارج] := نهاية_الكتلة; };
            ر := ر + 1;
        }
        دع قيم_الحي_التالي: متجه معرف_سجل_افتراضي = [];
        دع الحي_التالي: متغير مخزن_حياة_مؤقت = { القيم: قيم_الحي_التالي, العدد: 0 };
        دع موضع: متغير طبيعي = (*حقيقة_الكتلة).النهاية;
        طالما (موضع > (*حقيقة_الكتلة).البداية) {
            موضع := موضع - 1;
            دع حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[موضع];
            // Segments: a definition closes its register's open segment
            // (or is one position of its own); a use opens one.
            دع ت_م: متغير طبيعي = 0;
            طالما (ت_م < (الطول((*حقيقة).التعريفات) مثل طبيعي)) {
                دع المعرف_: طبيعي = (*حقيقة).التعريفات[ت_م].السجل.القيمة;
                إذا (المعرف_ < (الطول(النهاية_المفتوحة) مثل طبيعي)) {
                    إذا (النهاية_المفتوحة[المعرف_] != لا_مقطع_مفتوح) {
                        أضف_مقطعا_حيا(&متغير المجالات, المعرف_, موضع, النهاية_المفتوحة[المعرف_]);
                        النهاية_المفتوحة[المعرف_] := لا_مقطع_مفتوح;
                    } وإلا {
                        أضف_مقطعا_حيا(&متغير المجالات, المعرف_, موضع, موضع);
                    };
                };
                ت_م := ت_م + 1;
            }
            دع س_م: متغير طبيعي = 0;
            طالما (س_م < (الطول((*حقيقة).الاستخدامات) مثل طبيعي)) {
                دع المعرف_: طبيعي = (*حقيقة).الاستخدامات[س_م].السجل.القيمة;
                إذا (المعرف_ < (الطول(النهاية_المفتوحة) مثل طبيعي) && النهاية_المفتوحة[المعرف_] == لا_مقطع_مفتوح) {
                    النهاية_المفتوحة[المعرف_] := موضع;
                };
                س_م := س_م + 1;
            }
            دع له_حد: منطقي = (((الطول((*حقيقة).السجلات_المفسدة) مثل طبيعي) > 0) || (*حقيقة).حد_نداء);
            إذا (له_حد) {
                دع ب: متغير طبيعي = 0;
                طالما (ب < الحي.العدد) {
                    دع السجل_الحي: معرف_سجل_افتراضي = الحي.القيم[ب];
                    دع معرف_هنا: متغير منطقي = خطأ;
                    دع د: متغير طبيعي = 0;
                    طالما (د < (الطول((*حقيقة).التعريفات) مثل طبيعي)) {
                        إذا (معرفا_سجل_افتراضي_متساويان((*حقيقة).التعريفات[د].السجل, السجل_الحي)) {
                            معرف_هنا := صواب;
                            د := الطول((*حقيقة).التعريفات) مثل طبيعي;
                        } وإلا { د := د + 1; };
                    }
                    دع مستخدم_هنا: متغير منطقي = خطأ;
                    إذا (معرف_هنا) {
                        دع س: متغير طبيعي = 0;
                        طالما (س < (الطول((*حقيقة).الاستخدامات) مثل طبيعي)) {
                            إذا (معرفا_سجل_افتراضي_متساويان((*حقيقة).الاستخدامات[س].السجل, السجل_الحي)) {
                                مستخدم_هنا := صواب;
                                س := الطول((*حقيقة).الاستخدامات) مثل طبيعي;
                            } وإلا { س := س + 1; };
                        }
                    };
                    إذا (!معرف_هنا || مستخدم_هنا) {
                        أضف_مفسدات_إلى_مجال(
                            &متغير المجالات[السجل_الحي.القيمة],
                            &(*حقيقة).السجلات_المفسدة,
                            (*حقيقة).حد_نداء
                        );
                    };
                    ب := ب + 1;
                }
            };
            انتقال_تعليمة_حياة_إلى_مخزن(
                &الحي,
                &(*حقيقة).التعريفات,
                &(*حقيقة).الاستخدامات,
                &متغير الحي_التالي
            );
            دع التبادل: مخزن_حياة_مؤقت = الحي;
            الحي := الحي_التالي;
            الحي_التالي := التبادل;
        }
        // What is still open is live into the block.
        ر := 0;
        طالما (ر < الحي.العدد) {
            دع الداخل: طبيعي = الحي.القيم[ر].القيمة;
            إذا (الداخل < (الطول(النهاية_المفتوحة) مثل طبيعي) && النهاية_المفتوحة[الداخل] != لا_مقطع_مفتوح) {
                أضف_مقطعا_حيا(&متغير المجالات, الداخل, بداية_الكتلة, النهاية_المفتوحة[الداخل]);
                النهاية_المفتوحة[الداخل] := لا_مقطع_مفتوح;
            };
            ر := ر + 1;
        }
        ك := ك + 1;
    }
    // Sorted, merged segments; a register no position reached keeps its
    // whole span.
    ف := 0;
    طالما (ف < (الطول(المجالات) مثل طبيعي)) {
        طابق المجالات[ف].الفئة مع
        | اختياري.موجود(_) -> {
            إذا ((الطول(المجالات[ف].المقاطع) مثل طبيعي) == 0) {
                ألحق(المجالات[ف].المقاطع, المجالات[ف].البداية);
                ألحق(المجالات[ف].المقاطع, المجالات[ف].النهاية);
            } وإلا {
                المجالات[ف].المقاطع := رتب_مقاطع_حية(&المجالات[ف].المقاطع);
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع المجالات;
}
