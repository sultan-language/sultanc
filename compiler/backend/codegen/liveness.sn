استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.virtual_registers;

عام نوع مجال_حياة_سجل = {
    السجل: معرف_سجل_افتراضي,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    يعبر_نداء: منطقي,
    السجلات_المفسدة: متجه معرف_سجل_فعلي,
    السجلات_المربوطة: متجه معرف_سجل_افتراضي,
    ثابت: اختيار معرف_سجل_فعلي,
    الفئة: اختيار معرف_فئة_تخصيص,
    تعارض_قيود: منطقي
};

نوع حياة_كتلة_تخصيص = {
    الاستخدامات: متجه معرف_سجل_افتراضي,
    التعريفات: متجه معرف_سجل_افتراضي,
    الدخول: متجه معرف_سجل_افتراضي,
    الخروج: متجه معرف_سجل_افتراضي
};

نوع فهارس_حواف_حياة = {
    الخارجة: متجه متجه غير_موقع,
    الأسلاف: متجه متجه غير_موقع
};

// Reusable sparse-set scratch. `القيم` retains backing storage while `العدد`
// is the logical length. Persistent liveness facts remain ordinary sorted vectors.
نوع مخزن_حياة_مؤقت = {
    القيم: متجه معرف_سجل_افتراضي,
    العدد: غير_موقع
};

عرف انسخ_مجموعة_حياة(
    المصدر: &متجه معرف_سجل_افتراضي
): متجه معرف_سجل_افتراضي {
    دع الناتج: متغير متجه معرف_سجل_افتراضي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف مجموعتا_حياة_متساويتان(
    أ: &متجه معرف_سجل_افتراضي,
    ب: &متجه معرف_سجل_افتراضي
): منطقي {
    لو ((الطول(*أ) مثل غير_موقع) != (الطول(*ب) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*أ) مثل غير_موقع)) {
        لو (!معرفا_سجل_افتراضي_متساويان((*أ)[ف], (*ب)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف موضع_سجل_حي(
    المجموعة: &متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): غير_موقع {
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(*المجموعة) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        لو ((*المجموعة)[الوسط].القيمة < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عرف مجموعة_حياة_تحتوي(
    المجموعة: &متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): منطقي {
    دع الموضع: غير_موقع = موضع_سجل_حي(المجموعة, السجل);
    لو (الموضع >= (الطول(*المجموعة) مثل غير_موقع)) { أرجع خطأ; };
    أرجع معرفا_سجل_افتراضي_متساويان((*المجموعة)[الموضع], السجل);
}

عرف أضف_سجلا_حيا(
    المجموعة: &متغير متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): فراغ {
    دع الموضع: غير_موقع = موضع_سجل_حي(المجموعة, السجل);
    لو (الموضع < (الطول(*المجموعة) مثل غير_موقع)) {
        لو (معرفا_سجل_افتراضي_متساويان((*المجموعة)[الموضع], السجل)) { أرجع; };
    };
    ألحق(*المجموعة, السجل);
    دع ف: متغير غير_موقع = الطول(*المجموعة) مثل غير_موقع;
    ف := ف - 1;
    بينما (ف > الموضع) {
        دع السابق: غير_موقع = ف - 1;
        (*المجموعة)[ف] := (*المجموعة)[السابق];
        ف := السابق;
    }
    (*المجموعة)[الموضع] := السجل;
}

عرف احسب_دخول_حياة(
    الاستخدامات: &متجه معرف_سجل_افتراضي,
    التعريفات: &متجه معرف_سجل_افتراضي,
    الخروج: &متجه معرف_سجل_افتراضي
): متجه معرف_سجل_افتراضي {
    دع الناتج: متغير متجه معرف_سجل_افتراضي = انسخ_مجموعة_حياة(الاستخدامات);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الخروج) مثل غير_موقع)) {
        لو (!مجموعة_حياة_تحتوي(التعريفات, (*الخروج)[ف])) {
            أضف_سجلا_حيا(&متغير الناتج, (*الخروج)[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اكتب_في_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت,
    الموضع: غير_موقع,
    السجل: معرف_سجل_افتراضي
): فراغ {
    لو (الموضع < (الطول((*المخزن).القيم) مثل غير_موقع)) {
        (*المخزن).القيم[الموضع] := السجل;
    } وإلا {
        ألحق((*المخزن).القيم, السجل);
    };
    لو (الموضع >= (*المخزن).العدد) { (*المخزن).العدد := الموضع + 1; };
}

عرف موضع_سجل_في_مخزن_حياة(
    المخزن: &مخزن_حياة_مؤقت,
    السجل: معرف_سجل_افتراضي
): غير_موقع {
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = (*المخزن).العدد;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        لو ((*المخزن).القيم[الوسط].القيمة < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عرف أضف_إلى_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت,
    السجل: معرف_سجل_افتراضي
): فراغ {
    دع الموضع: غير_موقع = موضع_سجل_في_مخزن_حياة(المخزن, السجل);
    لو (الموضع < (*المخزن).العدد) {
        لو (معرفا_سجل_افتراضي_متساويان((*المخزن).القيم[الموضع], السجل)) { أرجع; };
    };
    دع القديم: غير_موقع = (*المخزن).العدد;
    لو (القديم < (الطول((*المخزن).القيم) مثل غير_موقع)) {
        (*المخزن).العدد := القديم + 1;
    } وإلا {
        ألحق((*المخزن).القيم, السجل);
        (*المخزن).العدد := القديم + 1;
    };
    دع ف: متغير غير_موقع = القديم;
    بينما (ف > الموضع) {
        دع السابق: غير_موقع = ف - 1;
        (*المخزن).القيم[ف] := (*المخزن).القيم[السابق];
        ف := السابق;
    }
    (*المخزن).القيم[الموضع] := السجل;
}

عرف ابن_مخزن_حياة_من(
    المصدر: &متجه معرف_سجل_افتراضي
): مخزن_حياة_مؤقت {
    دع القيم: متجه معرف_سجل_افتراضي = انسخ_مجموعة_حياة(المصدر);
    دع العدد: غير_موقع = الطول(القيم) مثل غير_موقع;
    دع الناتج: مخزن_حياة_مؤقت = {
        القيم: القيم,
        العدد: العدد
    };
    أرجع الناتج;
}

عرف انتقال_تعليمة_حياة_إلى_مخزن(
    بعد: &مخزن_حياة_مؤقت,
    التعريفات: &متجه طلب_سجل_تخصيص,
    الاستخدامات: &متجه طلب_سجل_تخصيص,
    الناتج: &متغير مخزن_حياة_مؤقت
): فراغ {
    (*الناتج).العدد := 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*بعد).العدد) {
        دع معرف: معرف_سجل_افتراضي = (*بعد).القيم[ف];
        دع معرف_معرف: متغير منطقي = خطأ;
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(*التعريفات) مثل غير_موقع)) {
            لو (معرفا_سجل_افتراضي_متساويان((*التعريفات)[ت].السجل, معرف)) {
                معرف_معرف := صواب;
                ت := الطول(*التعريفات) مثل غير_موقع;
            } وإلا {
                ت := ت + 1;
            };
        }
        لو (!معرف_معرف) {
            اكتب_في_مخزن_حياة(الناتج, (*الناتج).العدد, معرف);
        };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(*الاستخدامات) مثل غير_موقع)) {
        أضف_إلى_مخزن_حياة(الناتج, (*الاستخدامات)[ف].السجل);
        ف := ف + 1;
    }
}

عرف امسح_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت
): فراغ {
    (*المخزن).العدد := 0;
}

عرف مخزنا_حياة_متساويان(
    أ: &مخزن_حياة_مؤقت,
    ب: &مخزن_حياة_مؤقت
): منطقي {
    لو ((*أ).العدد != (*ب).العدد) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*أ).العدد) {
        لو (!معرفا_سجل_افتراضي_متساويان((*أ).القيم[ف], (*ب).القيم[ف])) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_مخزن_حياة_إلى_مخزن(
    المصدر: &مخزن_حياة_مؤقت,
    الوجهة: &متغير مخزن_حياة_مؤقت
): فراغ {
    امسح_مخزن_حياة(الوجهة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*المصدر).العدد) {
        اكتب_في_مخزن_حياة(الوجهة, ف, (*المصدر).القيم[ف]);
        ف := ف + 1;
    }
}

عرف حول_مخزن_حياة_إلى_مجموعة(
    المصدر: &مخزن_حياة_مؤقت
): متجه معرف_سجل_افتراضي {
    دع الناتج: متغير متجه معرف_سجل_افتراضي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*المصدر).العدد) {
        ألحق(الناتج, (*المصدر).القيم[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف احسب_دخول_حياة_في_مخزن(
    الاستخدامات: &متجه معرف_سجل_افتراضي,
    التعريفات: &متجه معرف_سجل_افتراضي,
    الخروج: &مخزن_حياة_مؤقت,
    الناتج: &متغير مخزن_حياة_مؤقت
): فراغ {
    امسح_مخزن_حياة(الناتج);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الاستخدامات) مثل غير_موقع)) {
        أضف_إلى_مخزن_حياة(الناتج, (*الاستخدامات)[ف]);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (*الخروج).العدد) {
        لو (!مجموعة_حياة_تحتوي(التعريفات, (*الخروج).القيم[ف])) {
            أضف_إلى_مخزن_حياة(الناتج, (*الخروج).القيم[ف]);
        };
        ف := ف + 1;
    }
}

عرف طبق_قيد_طلب(
    المجالات: &متغير متجه مجال_حياة_سجل,
    الفهرس: غير_موقع,
    الطلب: &طلب_سجل_تخصيص
): فراغ {
    طابق (*المجالات)[الفهرس].الفئة مع
    | اختيار.بعض(الفئة) -> {
        لو (!معرفا_فئة_تخصيص_متساويان(الفئة, (*الطلب).الفئة)) {
            (*المجالات)[الفهرس].تعارض_قيود := صواب;
        };
    }
    | اختيار.لا_شيء -> {
        (*المجالات)[الفهرس].الفئة := اختيار.بعض((*الطلب).الفئة);
    };
    طابق (*الطلب).ثابت مع
    | اختيار.بعض(الثابت) -> {
        طابق (*المجالات)[الفهرس].ثابت مع
        | اختيار.بعض(الحالي) -> {
            لو (!معرفا_سجل_فعلي_متساويان(الحالي, الثابت)) {
                (*المجالات)[الفهرس].تعارض_قيود := صواب;
            };
        }
        | اختيار.لا_شيء -> {
            (*المجالات)[الفهرس].ثابت := اختيار.بعض(الثابت);
        };
    }
    | اختيار.لا_شيء -> { };
}

عرف ألحق_مجال_فارغ(المجالات: &متغير متجه مجال_حياة_سجل): فراغ {
    دع م: غير_موقع = الطول(*المجالات) مثل غير_موقع;
    دع المعرف: معرف_سجل_افتراضي = { القيمة: م };
    دع لا_ثابت: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    دع لا_فئة: اختيار معرف_فئة_تخصيص = اختيار.لا_شيء();
    دع لا_مفسدات: متجه معرف_سجل_فعلي = [];
    دع لا_مربوطات: متجه معرف_سجل_افتراضي = [];
    دع فارغ: مجال_حياة_سجل = {
        السجل: المعرف,
        البداية: 0,
        النهاية: 0,
        يعبر_نداء: خطأ,
        السجلات_المفسدة: لا_مفسدات,
        السجلات_المربوطة: لا_مربوطات,
        ثابت: لا_ثابت,
        الفئة: لا_فئة,
        تعارض_قيود: خطأ
    };
    ألحق(*المجالات, فارغ);
}

عرف تأكد_عدد_المجالات(
    المجالات: &متغير متجه مجال_حياة_سجل,
    العدد: غير_موقع
): فراغ {
    بينما ((الطول(*المجالات) مثل غير_موقع) < العدد) {
        ألحق_مجال_فارغ(المجالات);
    }
}

عرف وسع_مجال(
    المجالات: &متغير متجه مجال_حياة_سجل,
    الطلب: &طلب_سجل_تخصيص,
    الموضع: غير_موقع
): فراغ {
    تأكد_عدد_المجالات(المجالات, (*الطلب).السجل.القيمة + 1);
    دع ف: غير_موقع = (*الطلب).السجل.القيمة;
    طابق (*المجالات)[ف].الفئة مع
    | اختيار.لا_شيء -> {
        (*المجالات)[ف].البداية := الموضع;
        (*المجالات)[ف].النهاية := الموضع;
    }
    | اختيار.بعض(_) -> {
        لو (الموضع < (*المجالات)[ف].البداية) { (*المجالات)[ف].البداية := الموضع; };
        لو (الموضع > (*المجالات)[ف].النهاية) { (*المجالات)[ف].النهاية := الموضع; };
    };
    طبق_قيد_طلب(المجالات, ف, الطلب);
}

عرف وسع_حدود_مجال(
    المجالات: &متغير متجه مجال_حياة_سجل,
    السجل: معرف_سجل_افتراضي,
    الموضع: غير_موقع
): فراغ {
    لو (السجل.القيمة >= (الطول(*المجالات) مثل غير_موقع)) { أرجع; };
    طابق (*المجالات)[السجل.القيمة].الفئة مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(_) -> {
        لو (الموضع < (*المجالات)[السجل.القيمة].البداية) {
            (*المجالات)[السجل.القيمة].البداية := الموضع;
        };
        لو (الموضع > (*المجالات)[السجل.القيمة].النهاية) {
            (*المجالات)[السجل.القيمة].النهاية := الموضع;
        };
    };
}

عرف أضف_مفسدات_إلى_مجال(
    المجال: &متغير مجال_حياة_سجل,
    المفسدات: &متجه معرف_سجل_فعلي,
    حد_نداء: منطقي
): فراغ {
    لو (حد_نداء) { (*المجال).يعبر_نداء := صواب; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المفسدات) مثل غير_موقع)) {
        دع موجود: متغير منطقي = خطأ;
        دع س: متغير غير_موقع = 0;
        بينما (س < (الطول((*المجال).السجلات_المفسدة) مثل غير_موقع)) {
            لو (معرفا_سجل_فعلي_متساويان((*المجال).السجلات_المفسدة[س], (*المفسدات)[ف])) {
                موجود := صواب;
                س := الطول((*المجال).السجلات_المفسدة) مثل غير_موقع;
            } وإلا {
                س := س + 1;
            };
        }
        لو (!موجود) { ألحق((*المجال).السجلات_المفسدة, (*المفسدات)[ف]); };
        ف := ف + 1;
    }
}

عرف ابحث_حقيقة_كتلة_تخصيص(
    الكتل: &متجه حقيقة_كتلة_تخصيص,
    المعرف: معرف_كتلة_منتقاة
): اختيار حقيقة_كتلة_تخصيص {
    دع ف: غير_موقع = المعرف.القيمة;
    لو (ف >= (الطول(*الكتل) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    لو (!معرفا_كتلة_منتقاة_متساويان((*الكتل)[ف].المعرف, المعرف)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض((*الكتل)[ف]);
}

عرف موضع_نهاية_كتلة_تخصيص(الحقيقة: &حقيقة_كتلة_تخصيص): غير_موقع {
    لو ((*الحقيقة).النهاية > (*الحقيقة).البداية) { أرجع (*الحقيقة).النهاية - 1; };
    أرجع (*الحقيقة).البداية;
}

عرف ابن_حياة_كتل_تخصيص(المسألة: &مسألة_تخصيص): متجه حياة_كتلة_تخصيص {
    دع الناتج: متغير متجه حياة_كتلة_تخصيص = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول((*المسألة).الكتل) مثل غير_موقع)) {
        دع الاستخدامات: متغير متجه معرف_سجل_افتراضي = [];
        دع التعريفات: متغير متجه معرف_سجل_افتراضي = [];
        دع الحقيقة_الكتلة: &حقيقة_كتلة_تخصيص = &(*المسألة).الكتل[ك];
        دع الموضع: متغير غير_موقع = (*الحقيقة_الكتلة).البداية;
        بينما (الموضع < (*الحقيقة_الكتلة).النهاية) {
            دع حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[الموضع];
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول((*حقيقة).الاستخدامات) مثل غير_موقع)) {
                دع السجل: معرف_سجل_افتراضي = (*حقيقة).الاستخدامات[ف].السجل;
                لو (!مجموعة_حياة_تحتوي(&التعريفات, السجل)) {
                    أضف_سجلا_حيا(&متغير الاستخدامات, السجل);
                };
                ف := ف + 1;
            }
            ف := 0;
            بينما (ف < (الطول((*حقيقة).التعريفات) مثل غير_موقع)) {
                أضف_سجلا_حيا(&متغير التعريفات, (*حقيقة).التعريفات[ف].السجل);
                ف := ف + 1;
            }
            الموضع := الموضع + 1;
        }
        دع الدخول: متجه معرف_سجل_افتراضي = [];
        دع الخروج: متجه معرف_سجل_افتراضي = [];
        دع حياة: حياة_كتلة_تخصيص = {
            الاستخدامات: الاستخدامات,
            التعريفات: التعريفات,
            الدخول: الدخول,
            الخروج: الخروج
        };
        ألحق(الناتج, حياة);
        ك := ك + 1;
    }
    أرجع الناتج;
}

عرف ادمج_نقلات_حافة_في_حياة(
    الناتج: &متغير متجه معرف_سجل_افتراضي,
    الدخول_اللاحق: &متجه معرف_سجل_افتراضي,
    الحافة: &حقيقة_نقل_حافة_تخصيص
): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الدخول_اللاحق) مثل غير_موقع)) {
        دع مقتول: متغير منطقي = خطأ;
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول((*الحافة).النقلات) مثل غير_موقع)) {
            لو (معرفا_سجل_افتراضي_متساويان(
                (*الحافة).النقلات[ن].الوجهة.السجل, (*الدخول_اللاحق)[ف]
            )) {
                مقتول := صواب;
                ن := الطول((*الحافة).النقلات) مثل غير_موقع;
            } وإلا { ن := ن + 1; };
        }
        لو (!مقتول) { أضف_سجلا_حيا(الناتج, (*الدخول_اللاحق)[ف]); };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول((*الحافة).النقلات) مثل غير_موقع)) {
        أضف_سجلا_حيا(الناتج, (*الحافة).النقلات[ف].المصدر.السجل);
        ف := ف + 1;
    }
}

عرف ادمج_نقلات_حافة_في_مخزن_حياة(
    الناتج: &متغير مخزن_حياة_مؤقت,
    الدخول_اللاحق: &مخزن_حياة_مؤقت,
    الحافة: &حقيقة_نقل_حافة_تخصيص
): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*الدخول_اللاحق).العدد) {
        دع مقتول: متغير منطقي = خطأ;
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول((*الحافة).النقلات) مثل غير_موقع)) {
            لو (معرفا_سجل_افتراضي_متساويان(
                (*الحافة).النقلات[ن].الوجهة.السجل, (*الدخول_اللاحق).القيم[ف]
            )) {
                مقتول := صواب;
                ن := الطول((*الحافة).النقلات) مثل غير_موقع;
            } وإلا { ن := ن + 1; };
        }
        لو (!مقتول) { أضف_إلى_مخزن_حياة(الناتج, (*الدخول_اللاحق).القيم[ف]); };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول((*الحافة).النقلات) مثل غير_موقع)) {
        أضف_إلى_مخزن_حياة(الناتج, (*الحافة).النقلات[ف].المصدر.السجل);
        ف := ف + 1;
    }
}

عرف ابن_فهارس_حواف_حياة(المسألة: &مسألة_تخصيص): فهارس_حواف_حياة {
    دع الخارجة: متغير متجه متجه غير_موقع = [];
    دع الأسلاف: متغير متجه متجه غير_موقع = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول((*المسألة).الكتل) مثل غير_موقع)) {
        دع فارغ_خارج: متجه غير_موقع = [];
        دع فارغ_سلف: متجه غير_موقع = [];
        ألحق(الخارجة, فارغ_خارج);
        ألحق(الأسلاف, فارغ_سلف);
        ك := ك + 1;
    }
    دع ه: متغير غير_موقع = 0;
    بينما (ه < (الطول((*المسألة).نقلات_الحواف) مثل غير_موقع)) {
        دع الحافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[ه];
        دع فهرس_المصدر: غير_موقع = (*الحافة).من_كتلة.القيمة;
        دع فهرس_الوجهة: غير_موقع = (*الحافة).إلى_كتلة.القيمة;
        لو (
            فهرس_المصدر < (الطول(الخارجة) مثل غير_موقع)
            && فهرس_الوجهة < (الطول(الأسلاف) مثل غير_موقع)
        ) {
            ألحق(الخارجة[فهرس_المصدر], ه);
            ألحق(الأسلاف[فهرس_الوجهة], فهرس_المصدر);
        };
        ه := ه + 1;
    }
    دع الناتج: فهارس_حواف_حياة = { الخارجة: الخارجة, الأسلاف: الأسلاف };
    أرجع الناتج;
}

عرف حل_حياة_كتل_تخصيص(
    المسألة: &مسألة_تخصيص,
    الحياة: &متغير متجه حياة_كتلة_تخصيص
): فراغ {
    دع الفهارس: فهارس_حواف_حياة = ابن_فهارس_حواف_حياة(المسألة);
    دع عدد_الكتل: غير_موقع = الطول((*المسألة).الكتل) مثل غير_موقع;

    // Fixed-point state uses capacity-retaining sparse buffers. Requeues reset
    // logical lengths instead of allocating new live-in/live-out vectors.
    دع دخول_عامل: متغير متجه مخزن_حياة_مؤقت = [];
    دع خروج_عامل: متغير متجه مخزن_حياة_مؤقت = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < عدد_الكتل) {
        دع قيم_دخول: متجه معرف_سجل_افتراضي = [];
        دع قيم_خروج: متجه معرف_سجل_افتراضي = [];
        دع مخزن_دخول: مخزن_حياة_مؤقت = { القيم: قيم_دخول, العدد: 0 };
        دع مخزن_خروج: مخزن_حياة_مؤقت = { القيم: قيم_خروج, العدد: 0 };
        ألحق(دخول_عامل, مخزن_دخول);
        ألحق(خروج_عامل, مخزن_خروج);
        ك := ك + 1;
    }
    دع قيم_خروج_جديد: متجه معرف_سجل_افتراضي = [];
    دع خروج_جديد: متغير مخزن_حياة_مؤقت = { القيم: قيم_خروج_جديد, العدد: 0 };
    دع قيم_دخول_جديد: متجه معرف_سجل_افتراضي = [];
    دع دخول_جديد: متغير مخزن_حياة_مؤقت = { القيم: قيم_دخول_جديد, العدد: 0 };

    // The worklist can never have more pending entries than blocks because
    // `في_الطابور` suppresses duplicates. Keep a bounded FIFO ring instead of
    // retaining every processed/requeued entry in an append-only history.
    دع الطابور: متغير متجه غير_موقع = [];
    دع في_الطابور: متغير متجه منطقي = [];
    ك := 0;
    بينما (ك < عدد_الكتل) {
        ألحق(الطابور, 0);
        ألحق(في_الطابور, خطأ);
        ك := ك + 1;
    }
    دع رأس_الطابور: متغير غير_موقع = 0;
    دع ذيل_الطابور: متغير غير_موقع = 0;
    دع عدد_الطابور: متغير غير_موقع = 0;
    ك := عدد_الكتل;
    بينما (ك > 0) {
        ك := ك - 1;
        الطابور[ذيل_الطابور] := ك;
        ذيل_الطابور := (ذيل_الطابور + 1) % عدد_الكتل;
        عدد_الطابور := عدد_الطابور + 1;
        في_الطابور[ك] := صواب;
    }
    بينما (عدد_الطابور > 0) {
        دع الكتلة: غير_موقع = الطابور[رأس_الطابور];
        رأس_الطابور := (رأس_الطابور + 1) % عدد_الكتل;
        عدد_الطابور := عدد_الطابور - 1;
        في_الطابور[الكتلة] := خطأ;

        امسح_مخزن_حياة(&متغير خروج_جديد);
        دع ه: متغير غير_موقع = 0;
        بينما (ه < (الطول(الفهارس.الخارجة[الكتلة]) مثل غير_موقع)) {
            دع فهرس_الحافة: غير_موقع = الفهارس.الخارجة[الكتلة][ه];
            دع الحافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[فهرس_الحافة];
            دع اللاحق: غير_موقع = (*الحافة).إلى_كتلة.القيمة;
            لو (اللاحق < عدد_الكتل) {
                ادمج_نقلات_حافة_في_مخزن_حياة(
                    &متغير خروج_جديد, &دخول_عامل[اللاحق], الحافة
                );
            };
            ه := ه + 1;
        }
        احسب_دخول_حياة_في_مخزن(
            &(*الحياة)[الكتلة].الاستخدامات,
            &(*الحياة)[الكتلة].التعريفات,
            &خروج_جديد,
            &متغير دخول_جديد
        );
        دع تغير_الخروج: منطقي = !مخزنا_حياة_متساويان(&خروج_جديد, &خروج_عامل[الكتلة]);
        دع تغير_الدخول: منطقي = !مخزنا_حياة_متساويان(&دخول_جديد, &دخول_عامل[الكتلة]);
        لو (تغير_الخروج) {
            انسخ_مخزن_حياة_إلى_مخزن(&خروج_جديد, &متغير خروج_عامل[الكتلة]);
        };
        لو (تغير_الدخول) {
            انسخ_مخزن_حياة_إلى_مخزن(&دخول_جديد, &متغير دخول_عامل[الكتلة]);
            دع س: متغير غير_موقع = 0;
            بينما (س < (الطول(الفهارس.الأسلاف[الكتلة]) مثل غير_موقع)) {
                دع السلف: غير_موقع = الفهارس.الأسلاف[الكتلة][س];
                لو (!في_الطابور[السلف]) {
                    الطابور[ذيل_الطابور] := السلف;
                    ذيل_الطابور := (ذيل_الطابور + 1) % عدد_الكتل;
                    عدد_الطابور := عدد_الطابور + 1;
                    في_الطابور[السلف] := صواب;
                };
                س := س + 1;
            }
        };
    }

    // Materialize persistent liveness exactly once, after the fixed point.
    ك := 0;
    بينما (ك < عدد_الكتل) {
        (*الحياة)[ك].الدخول := حول_مخزن_حياة_إلى_مجموعة(&دخول_عامل[ك]);
        (*الحياة)[ك].الخروج := حول_مخزن_حياة_إلى_مجموعة(&خروج_عامل[ك]);
        ك := ك + 1;
    }
}

عام عرف حلل_مجالات_الحياة(المسألة: &مسألة_تخصيص): متجه مجال_حياة_سجل {
    دع المجالات: متغير متجه مجال_حياة_سجل = [];
    تأكد_عدد_المجالات(&متغير المجالات, (*المسألة).عدد_السجلات_الافتراضية);

    // اجمع القيود والمواضع الصريحة أولا؛ تحليل CFG سيضيف المقاطع الحية بين هذه المواضع.
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*المسألة).التعليمات) مثل غير_موقع)) {
        دع حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[ف];
        دع ي: متغير غير_موقع = 0;
        بينما (ي < (الطول((*حقيقة).الاستخدامات) مثل غير_موقع)) {
            وسع_مجال(&متغير المجالات, &(*حقيقة).الاستخدامات[ي], (*حقيقة).الموضع);
            ي := ي + 1;
        }
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول((*حقيقة).التعريفات) مثل غير_موقع)) {
            وسع_مجال(&متغير المجالات, &(*حقيقة).التعريفات[ت], (*حقيقة).الموضع);
            ت := ت + 1;
        }
        ف := ف + 1;
    }

    // حقائق النسخ على الحواف تحمل قيود السجلات أيضا، وتثبت حدود المصدر/الوجهة عند CFG.
    دع ه: متغير غير_موقع = 0;
    بينما (ه < (الطول((*المسألة).نقلات_الحواف) مثل غير_موقع)) {
        دع حافة: &حقيقة_نقل_حافة_تخصيص = &(*المسألة).نقلات_الحواف[ه];
        دع موضع_المصدر: متغير غير_موقع = 0;
        دع موضع_الوجهة: متغير غير_موقع = 0;
        طابق ابحث_حقيقة_كتلة_تخصيص(&(*المسألة).الكتل, (*حافة).من_كتلة) مع
        | اختيار.بعض(حقيقة_المصدر) -> { موضع_المصدر := موضع_نهاية_كتلة_تخصيص(&حقيقة_المصدر); }
        | اختيار.لا_شيء -> { };
        طابق ابحث_حقيقة_كتلة_تخصيص(&(*المسألة).الكتل, (*حافة).إلى_كتلة) مع
        | اختيار.بعض(حقيقة_الوجهة) -> { موضع_الوجهة := حقيقة_الوجهة.البداية; }
        | اختيار.لا_شيء -> { };
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول((*حافة).النقلات) مثل غير_موقع)) {
            وسع_مجال(&متغير المجالات, &(*حافة).النقلات[ن].المصدر, موضع_المصدر);
            وسع_مجال(&متغير المجالات, &(*حافة).النقلات[ن].الوجهة, موضع_الوجهة);
            ن := ن + 1;
        }
        ه := ه + 1;
    }

    // حقائق الربط تخص السجل الافتراضي نفسه؛ لا يعاد البحث عنها أثناء التخصيص.
    دع قف: متغير غير_موقع = 0;
    بينما (قف < (الطول((*المسألة).التعليمات) مثل غير_موقع)) {
        دع قح: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[قف];
        دع قر: متغير غير_موقع = 0;
        بينما (قر < (الطول((*قح).القيود_المربوطة) مثل غير_موقع)) {
            دع قيد: قيد_ربط_تخصيص = (*قح).القيود_المربوطة[قر];
            ألحق(المجالات[قيد.الأول.القيمة].السجلات_المربوطة, قيد.الثاني);
            ألحق(المجالات[قيد.الثاني.القيمة].السجلات_المربوطة, قيد.الأول);
            قر := قر + 1;
        }
        قف := قف + 1;
    }

    دع حياة_الكتل: متغير متجه حياة_كتلة_تخصيص = ابن_حياة_كتل_تخصيص(المسألة);
    حل_حياة_كتل_تخصيص(المسألة, &متغير حياة_الكتل);

    // تمثل الحياة كمجموعات سجلات افتراضية مرتبة ومتناثرة؛ لا توجد مصفوفة
    // كتلة × سجل، ولا مسح لجميع السجلات عند حدود الكتلة أو النداء.
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول((*المسألة).الكتل) مثل غير_موقع)) {
        دع حقيقة_الكتلة: &حقيقة_كتلة_تخصيص = &(*المسألة).الكتل[ك];
        دع بداية_الكتلة: غير_موقع = (*حقيقة_الكتلة).البداية;
        دع نهاية_الكتلة: غير_موقع = موضع_نهاية_كتلة_تخصيص(حقيقة_الكتلة);
        دع ر: متغير غير_موقع = 0;
        بينما (ر < (الطول(حياة_الكتل[ك].الدخول) مثل غير_موقع)) {
            وسع_حدود_مجال(&متغير المجالات, حياة_الكتل[ك].الدخول[ر], بداية_الكتلة);
            ر := ر + 1;
        }
        ر := 0;
        بينما (ر < (الطول(حياة_الكتل[ك].الخروج) مثل غير_موقع)) {
            وسع_حدود_مجال(&متغير المجالات, حياة_الكتل[ك].الخروج[ر], نهاية_الكتلة);
            ر := ر + 1;
        }

        دع الحي: متغير مخزن_حياة_مؤقت = ابن_مخزن_حياة_من(&حياة_الكتل[ك].الخروج);
        دع قيم_الحي_التالي: متجه معرف_سجل_افتراضي = [];
        دع الحي_التالي: متغير مخزن_حياة_مؤقت = { القيم: قيم_الحي_التالي, العدد: 0 };
        دع موضع: متغير غير_موقع = (*حقيقة_الكتلة).النهاية;
        بينما (موضع > (*حقيقة_الكتلة).البداية) {
            موضع := موضع - 1;
            دع حقيقة: &حقيقة_تعليمة_تخصيص = &(*المسألة).التعليمات[موضع];
            دع له_حد: منطقي = (((الطول((*حقيقة).السجلات_المفسدة) مثل غير_موقع) > 0) || (*حقيقة).حد_نداء);
            لو (له_حد) {
                دع ب: متغير غير_موقع = 0;
                بينما (ب < الحي.العدد) {
                    دع السجل_الحي: معرف_سجل_افتراضي = الحي.القيم[ب];
                    دع معرف_هنا: متغير منطقي = خطأ;
                    دع د: متغير غير_موقع = 0;
                    بينما (د < (الطول((*حقيقة).التعريفات) مثل غير_موقع)) {
                        لو (معرفا_سجل_افتراضي_متساويان((*حقيقة).التعريفات[د].السجل, السجل_الحي)) {
                            معرف_هنا := صواب;
                            د := الطول((*حقيقة).التعريفات) مثل غير_موقع;
                        } وإلا { د := د + 1; };
                    }
                    دع مستخدم_هنا: متغير منطقي = خطأ;
                    لو (معرف_هنا) {
                        دع س: متغير غير_موقع = 0;
                        بينما (س < (الطول((*حقيقة).الاستخدامات) مثل غير_موقع)) {
                            لو (معرفا_سجل_افتراضي_متساويان((*حقيقة).الاستخدامات[س].السجل, السجل_الحي)) {
                                مستخدم_هنا := صواب;
                                س := الطول((*حقيقة).الاستخدامات) مثل غير_موقع;
                            } وإلا { س := س + 1; };
                        }
                    };
                    لو (!معرف_هنا || مستخدم_هنا) {
                        أضف_مفسدات_إلى_مجال(
                            &متغير المجالات[السجل_الحي.القيمة],
                            &(*حقيقة).السجلات_المفسدة,
                            (*حقيقة).حد_نداء
                        );
                    };
                    ب := ب + 1;
                }
            };
            انتقال_تعليمة_حياة_إلى_مخزن(
                &الحي,
                &(*حقيقة).التعريفات,
                &(*حقيقة).الاستخدامات,
                &متغير الحي_التالي
            );
            دع التبادل: مخزن_حياة_مؤقت = الحي;
            الحي := الحي_التالي;
            الحي_التالي := التبادل;
        }
        ك := ك + 1;
    }
    أرجع المجالات;
}
