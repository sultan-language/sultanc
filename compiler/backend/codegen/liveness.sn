استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.virtual_registers;

عام نوع مجال_حياة_سجل = {
    السجل: معرف_سجل_افتراضي,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    يعبر_نداء: منطقي,
    السجلات_المفسدة: متجه معرف_سجل_فعلي,
    السجلات_المربوطة: متجه معرف_سجل_افتراضي,
    ثابت: اختيار معرف_سجل_فعلي,
    الفئة: اختيار معرف_فئة_تخصيص,
    تعارض_قيود: منطقي
};

نوع حياة_كتلة_تخصيص = {
    الاستخدامات: متجه معرف_سجل_افتراضي,
    التعريفات: متجه معرف_سجل_افتراضي,
    الدخول: متجه معرف_سجل_افتراضي,
    الخروج: متجه معرف_سجل_افتراضي
};

نوع فهارس_حواف_حياة = {
    الخارجة: متجه متجه غير_موقع,
    الأسلاف: متجه متجه غير_موقع
};

// Reusable sparse-set scratch. `القيم` retains backing storage while `العدد`
// is the logical length. Persistent liveness facts remain ordinary sorted vectors.
نوع مخزن_حياة_مؤقت = {
    القيم: متجه معرف_سجل_افتراضي,
    العدد: غير_موقع
};

عرف انسخ_مجموعة_حياة(
    المصدر: &متجه معرف_سجل_افتراضي
): متجه معرف_سجل_افتراضي {
    دع م: متجه معرف_سجل_افتراضي = *المصدر;
    دع الناتج: متغير متجه معرف_سجل_افتراضي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م) مثل غير_موقع)) {
        ألحق(الناتج, م[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف مجموعتا_حياة_متساويتان(
    أ: &متجه معرف_سجل_افتراضي,
    ب: &متجه معرف_سجل_افتراضي
): منطقي {
    دع الأول: متجه معرف_سجل_افتراضي = *أ;
    دع الثاني: متجه معرف_سجل_افتراضي = *ب;
    لو ((الطول(الأول) مثل غير_موقع) != (الطول(الثاني) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأول) مثل غير_موقع)) {
        لو (!معرفا_سجل_افتراضي_متساويان(الأول[ف], الثاني[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف موضع_سجل_حي(
    المجموعة: &متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): غير_موقع {
    دع م: متجه معرف_سجل_افتراضي = *المجموعة;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(م) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        لو (م[الوسط].القيمة < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عرف مجموعة_حياة_تحتوي(
    المجموعة: &متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): منطقي {
    دع م: متجه معرف_سجل_افتراضي = *المجموعة;
    دع الموضع: غير_موقع = موضع_سجل_حي(&م, السجل);
    لو (الموضع >= (الطول(م) مثل غير_موقع)) { أرجع خطأ; };
    أرجع معرفا_سجل_افتراضي_متساويان(م[الموضع], السجل);
}

عرف أضف_سجلا_حيا(
    المجموعة: &متغير متجه معرف_سجل_افتراضي,
    السجل: معرف_سجل_افتراضي
): فراغ {
    دع الحالة: متغير متجه معرف_سجل_افتراضي = *المجموعة;
    دع الموضع: غير_موقع = موضع_سجل_حي(&الحالة, السجل);
    لو (الموضع < (الطول(الحالة) مثل غير_موقع)) {
        لو (معرفا_سجل_افتراضي_متساويان(الحالة[الموضع], السجل)) { أرجع; };
    };
    ألحق(الحالة, السجل);
    دع ف: متغير غير_موقع = الطول(الحالة) مثل غير_موقع;
    ف := ف - 1;
    بينما (ف > الموضع) {
        دع السابق: متغير غير_موقع = ف;
        السابق := السابق - 1;
        الحالة[ف] := الحالة[السابق];
        ف := السابق;
    }
    الحالة[الموضع] := السجل;
    *المجموعة := الحالة;
}

عرف احسب_دخول_حياة(
    الاستخدامات: &متجه معرف_سجل_افتراضي,
    التعريفات: &متجه معرف_سجل_افتراضي,
    الخروج: &متجه معرف_سجل_افتراضي
): متجه معرف_سجل_افتراضي {
    // Keep one sparse result buffer. The previous form first built (out - defs)
    // and then allocated a second vector for union(uses, remainder).
    دع الناتج: متغير متجه معرف_سجل_افتراضي = انسخ_مجموعة_حياة(الاستخدامات);
    دع خ: متجه معرف_سجل_افتراضي = *الخروج;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(خ) مثل غير_موقع)) {
        لو (!مجموعة_حياة_تحتوي(التعريفات, خ[ف])) {
            أضف_سجلا_حيا(&متغير الناتج, خ[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اكتب_في_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت,
    الموضع: غير_موقع,
    السجل: معرف_سجل_افتراضي
): فراغ {
    دع الحالة: متغير مخزن_حياة_مؤقت = *المخزن;
    لو (الموضع < (الطول(الحالة.القيم) مثل غير_موقع)) {
        الحالة.القيم[الموضع] := السجل;
    } وإلا {
        ألحق(الحالة.القيم, السجل);
    };
    لو (الموضع >= الحالة.العدد) { الحالة.العدد := الموضع + 1; };
    *المخزن := الحالة;
}

عرف موضع_سجل_في_مخزن_حياة(
    المخزن: &مخزن_حياة_مؤقت,
    السجل: معرف_سجل_افتراضي
): غير_موقع {
    دع الحالة: مخزن_حياة_مؤقت = *المخزن;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الحالة.العدد;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        لو (الحالة.القيم[الوسط].القيمة < السجل.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عرف أضف_إلى_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت,
    السجل: معرف_سجل_افتراضي
): فراغ {
    دع الحالة: متغير مخزن_حياة_مؤقت = *المخزن;
    دع الموضع: غير_موقع = موضع_سجل_في_مخزن_حياة(&الحالة, السجل);
    لو (الموضع < الحالة.العدد) {
        لو (معرفا_سجل_افتراضي_متساويان(الحالة.القيم[الموضع], السجل)) { أرجع; };
    };
    دع القديم: غير_موقع = الحالة.العدد;
    لو (القديم < (الطول(الحالة.القيم) مثل غير_موقع)) {
        الحالة.العدد := القديم + 1;
    } وإلا {
        ألحق(الحالة.القيم, السجل);
        الحالة.العدد := القديم + 1;
    };
    دع ف: متغير غير_موقع = القديم;
    بينما (ف > الموضع) {
        دع السابق: غير_موقع = ف - 1;
        الحالة.القيم[ف] := الحالة.القيم[السابق];
        ف := السابق;
    }
    الحالة.القيم[الموضع] := السجل;
    *المخزن := الحالة;
}

عرف ابن_مخزن_حياة_من(
    المصدر: &متجه معرف_سجل_افتراضي
): مخزن_حياة_مؤقت {
    دع القيم: متجه معرف_سجل_افتراضي = انسخ_مجموعة_حياة(المصدر);
    دع العدد: غير_موقع = الطول(القيم) مثل غير_موقع;
    دع الناتج: مخزن_حياة_مؤقت = {
        القيم: القيم,
        العدد: العدد
    };
    أرجع الناتج;
}

عرف انتقال_تعليمة_حياة_إلى_مخزن(
    بعد: &مخزن_حياة_مؤقت,
    التعريفات: &متجه طلب_سجل_تخصيص,
    الاستخدامات: &متجه طلب_سجل_تخصيص,
    الناتج: &متغير مخزن_حياة_مؤقت
): فراغ {
    دع لاحق: مخزن_حياة_مؤقت = *بعد;
    دع تعريفات_الحالية: متجه طلب_سجل_تخصيص = *التعريفات;
    دع استخدامات_الحالية: متجه طلب_سجل_تخصيص = *الاستخدامات;
    دع الحالة: متغير مخزن_حياة_مؤقت = *الناتج;
    الحالة.العدد := 0;
    *الناتج := الحالة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < لاحق.العدد) {
        دع معرف: معرف_سجل_افتراضي = لاحق.القيم[ف];
        دع معرف_معرف: متغير منطقي = خطأ;
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(تعريفات_الحالية) مثل غير_موقع)) {
            لو (معرفا_سجل_افتراضي_متساويان(تعريفات_الحالية[ت].السجل, معرف)) {
                معرف_معرف := صواب;
                ت := الطول(تعريفات_الحالية) مثل غير_موقع;
            } وإلا {
                ت := ت + 1;
            };
        }
        لو (!معرف_معرف) {
            دع حالة_الناتج: مخزن_حياة_مؤقت = *الناتج;
            دع موضع_الكتابة: غير_موقع = حالة_الناتج.العدد;
            اكتب_في_مخزن_حياة(الناتج, موضع_الكتابة, معرف);
        };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(استخدامات_الحالية) مثل غير_موقع)) {
        أضف_إلى_مخزن_حياة(الناتج, استخدامات_الحالية[ف].السجل);
        ف := ف + 1;
    }
}


عرف امسح_مخزن_حياة(
    المخزن: &متغير مخزن_حياة_مؤقت
): فراغ {
    دع الحالة: متغير مخزن_حياة_مؤقت = *المخزن;
    الحالة.العدد := 0;
    *المخزن := الحالة;
}

عرف مخزنا_حياة_متساويان(
    أ: &مخزن_حياة_مؤقت,
    ب: &مخزن_حياة_مؤقت
): منطقي {
    دع الأول: مخزن_حياة_مؤقت = *أ;
    دع الثاني: مخزن_حياة_مؤقت = *ب;
    لو (الأول.العدد != الثاني.العدد) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الأول.العدد) {
        لو (!معرفا_سجل_افتراضي_متساويان(الأول.القيم[ف], الثاني.القيم[ف])) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_مخزن_حياة_إلى_مخزن(
    المصدر: &مخزن_حياة_مؤقت,
    الوجهة: &متغير مخزن_حياة_مؤقت
): فراغ {
    دع م: مخزن_حياة_مؤقت = *المصدر;
    امسح_مخزن_حياة(الوجهة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < م.العدد) {
        اكتب_في_مخزن_حياة(الوجهة, ف, م.القيم[ف]);
        ف := ف + 1;
    }
}

عرف حول_مخزن_حياة_إلى_مجموعة(
    المصدر: &مخزن_حياة_مؤقت
): متجه معرف_سجل_افتراضي {
    دع م: مخزن_حياة_مؤقت = *المصدر;
    دع الناتج: متغير متجه معرف_سجل_افتراضي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < م.العدد) {
        ألحق(الناتج, م.القيم[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف احسب_دخول_حياة_في_مخزن(
    الاستخدامات: &متجه معرف_سجل_افتراضي,
    التعريفات: &متجه معرف_سجل_افتراضي,
    الخروج: &مخزن_حياة_مؤقت,
    الناتج: &متغير مخزن_حياة_مؤقت
): فراغ {
    امسح_مخزن_حياة(الناتج);
    دع الاستعمال: متجه معرف_سجل_افتراضي = *الاستخدامات;
    دع خ: مخزن_حياة_مؤقت = *الخروج;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الاستعمال) مثل غير_موقع)) {
        أضف_إلى_مخزن_حياة(الناتج, الاستعمال[ف]);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < خ.العدد) {
        لو (!مجموعة_حياة_تحتوي(التعريفات, خ.القيم[ف])) {
            أضف_إلى_مخزن_حياة(الناتج, خ.القيم[ف]);
        };
        ف := ف + 1;
    }
}

عرف طبق_قيد_طلب(
    المجال: &متغير مجال_حياة_سجل,
    الطلب: &طلب_سجل_تخصيص
): فراغ {
    دع الحالة: متغير مجال_حياة_سجل = *المجال;
    دع ط: طلب_سجل_تخصيص = *الطلب;
    طابق الحالة.الفئة مع
    | اختيار.بعض(الفئة) -> {
        لو (!معرفا_فئة_تخصيص_متساويان(الفئة, ط.الفئة)) {
            الحالة.تعارض_قيود := صواب;
        };
    }
    | اختيار.لا_شيء -> {
        الحالة.الفئة := اختيار.بعض(ط.الفئة);
    };
    طابق ط.ثابت مع
    | اختيار.بعض(الثابت) -> {
        طابق الحالة.ثابت مع
        | اختيار.بعض(الحالي) -> {
            لو (!معرفا_سجل_فعلي_متساويان(الحالي, الثابت)) {
                الحالة.تعارض_قيود := صواب;
            };
        }
        | اختيار.لا_شيء -> {
            الحالة.ثابت := اختيار.بعض(الثابت);
        };
    }
    | اختيار.لا_شيء -> { };
    *المجال := الحالة;
}

عرف ألحق_مجال_فارغ(المجالات: &متغير متجه مجال_حياة_سجل): فراغ {
    دع الحالة: متغير متجه مجال_حياة_سجل = *المجالات;
    دع م: غير_موقع = الطول(الحالة) مثل غير_موقع;
    دع المعرف: معرف_سجل_افتراضي = { القيمة: م };
    دع لا_ثابت: اختيار معرف_سجل_فعلي = اختيار.لا_شيء();
    دع لا_فئة: اختيار معرف_فئة_تخصيص = اختيار.لا_شيء();
    دع لا_مفسدات: متجه معرف_سجل_فعلي = [];
    دع لا_مربوطات: متجه معرف_سجل_افتراضي = [];
    دع فارغ: مجال_حياة_سجل = {
        السجل: المعرف,
        البداية: 0,
        النهاية: 0,
        يعبر_نداء: خطأ,
        السجلات_المفسدة: لا_مفسدات,
        السجلات_المربوطة: لا_مربوطات,
        ثابت: لا_ثابت,
        الفئة: لا_فئة,
        تعارض_قيود: خطأ
    };
    ألحق(الحالة, فارغ);
    *المجالات := الحالة;
}

عرف تأكد_عدد_المجالات(
    المجالات: &متغير متجه مجال_حياة_سجل,
    العدد: غير_موقع
): فراغ {
    بينما ((الطول(*المجالات) مثل غير_موقع) < العدد) {
        ألحق_مجال_فارغ(المجالات);
    }
}

عرف وسع_مجال(
    المجالات: &متغير متجه مجال_حياة_سجل,
    الطلب: &طلب_سجل_تخصيص,
    الموضع: غير_موقع
): فراغ {
    دع ط: طلب_سجل_تخصيص = *الطلب;
    تأكد_عدد_المجالات(المجالات, ط.السجل.القيمة + 1);
    دع الحالة: متغير متجه مجال_حياة_سجل = *المجالات;
    دع ف: غير_موقع = ط.السجل.القيمة;
    طابق الحالة[ف].الفئة مع
    | اختيار.لا_شيء -> {
        الحالة[ف].البداية := الموضع;
        الحالة[ف].النهاية := الموضع;
    }
    | اختيار.بعض(_) -> {
        لو (الموضع < الحالة[ف].البداية) { الحالة[ف].البداية := الموضع; };
        لو (الموضع > الحالة[ف].النهاية) { الحالة[ف].النهاية := الموضع; };
    };
    طبق_قيد_طلب(&متغير الحالة[ف], &ط);
    *المجالات := الحالة;
}

عرف وسع_حدود_مجال(
    المجالات: &متغير متجه مجال_حياة_سجل,
    السجل: معرف_سجل_افتراضي,
    الموضع: غير_موقع
): فراغ {
    دع الحالة: متغير متجه مجال_حياة_سجل = *المجالات;
    لو (السجل.القيمة >= (الطول(الحالة) مثل غير_موقع)) { أرجع; };
    طابق الحالة[السجل.القيمة].الفئة مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(_) -> {
        لو (الموضع < الحالة[السجل.القيمة].البداية) {
            الحالة[السجل.القيمة].البداية := الموضع;
        };
        لو (الموضع > الحالة[السجل.القيمة].النهاية) {
            الحالة[السجل.القيمة].النهاية := الموضع;
        };
    };
    *المجالات := الحالة;
}

عرف أضف_مفسدات_إلى_مجال(
    المجال: &متغير مجال_حياة_سجل,
    المفسدات: &متجه معرف_سجل_فعلي,
    حد_نداء: منطقي
): فراغ {
    دع الحالة: متغير مجال_حياة_سجل = *المجال;
    لو (حد_نداء) { الحالة.يعبر_نداء := صواب; };
    دع م: متجه معرف_سجل_فعلي = *المفسدات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م) مثل غير_موقع)) {
        دع موجود: متغير منطقي = خطأ;
        دع س: متغير غير_موقع = 0;
        بينما (س < (الطول(الحالة.السجلات_المفسدة) مثل غير_موقع)) {
            لو (معرفا_سجل_فعلي_متساويان(الحالة.السجلات_المفسدة[س], م[ف])) {
                موجود := صواب;
                س := الطول(الحالة.السجلات_المفسدة) مثل غير_موقع;
            } وإلا {
                س := س + 1;
            };
        }
        لو (!موجود) { ألحق(الحالة.السجلات_المفسدة, م[ف]); };
        ف := ف + 1;
    }
    *المجال := الحالة;
}

عرف ابحث_حقيقة_كتلة_تخصيص(
    الكتل: &متجه حقيقة_كتلة_تخصيص,
    المعرف: معرف_كتلة_منتقاة
): اختيار حقيقة_كتلة_تخصيص {
    دع ك: متجه حقيقة_كتلة_تخصيص = *الكتل;
    دع ف: غير_موقع = المعرف.القيمة;
    لو (ف >= (الطول(ك) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    لو (!معرفا_كتلة_منتقاة_متساويان(ك[ف].المعرف, المعرف)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(ك[ف]);
}

عرف موضع_نهاية_كتلة_تخصيص(الحقيقة: &حقيقة_كتلة_تخصيص): غير_موقع {
    دع ح: حقيقة_كتلة_تخصيص = *الحقيقة;
    لو (ح.النهاية > ح.البداية) { أرجع ح.النهاية - 1; };
    أرجع ح.البداية;
}

عرف ابن_حياة_كتل_تخصيص(المسألة: &مسألة_تخصيص): متجه حياة_كتلة_تخصيص {
    دع م: مسألة_تخصيص = *المسألة;
    دع الناتج: متغير متجه حياة_كتلة_تخصيص = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(م.الكتل) مثل غير_موقع)) {
        دع الاستخدامات: متغير متجه معرف_سجل_افتراضي = [];
        دع التعريفات: متغير متجه معرف_سجل_افتراضي = [];
        دع الحقيقة_الكتلة: حقيقة_كتلة_تخصيص = م.الكتل[ك];
        دع الموضع: متغير غير_موقع = الحقيقة_الكتلة.البداية;
        بينما (الموضع < الحقيقة_الكتلة.النهاية) {
            دع مرجع_الحقيقة: &حقيقة_تعليمة_تخصيص = &م.التعليمات[الموضع];
            دع حقيقة: حقيقة_تعليمة_تخصيص = *مرجع_الحقيقة;
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(حقيقة.الاستخدامات) مثل غير_موقع)) {
                دع السجل: معرف_سجل_افتراضي = حقيقة.الاستخدامات[ف].السجل;
                لو (!مجموعة_حياة_تحتوي(&التعريفات, السجل)) {
                    أضف_سجلا_حيا(&متغير الاستخدامات, السجل);
                };
                ف := ف + 1;
            }
            ف := 0;
            بينما (ف < (الطول(حقيقة.التعريفات) مثل غير_موقع)) {
                أضف_سجلا_حيا(&متغير التعريفات, حقيقة.التعريفات[ف].السجل);
                ف := ف + 1;
            }
            الموضع := الموضع + 1;
        }
        دع الدخول: متجه معرف_سجل_افتراضي = [];
        دع الخروج: متجه معرف_سجل_افتراضي = [];
        دع حياة: حياة_كتلة_تخصيص = {
            الاستخدامات: الاستخدامات,
            التعريفات: التعريفات,
            الدخول: الدخول,
            الخروج: الخروج
        };
        ألحق(الناتج, حياة);
        ك := ك + 1;
    }
    أرجع الناتج;
}

عرف ادمج_نقلات_حافة_في_حياة(
    الناتج: &متغير متجه معرف_سجل_افتراضي,
    الدخول_اللاحق: &متجه معرف_سجل_افتراضي,
    الحافة: &حقيقة_نقل_حافة_تخصيص
): فراغ {
    // Merge the transformed successor set directly into the block's sparse
    // live-out set. Do not allocate a per-edge set and another union result.
    دع اللاحق: متجه معرف_سجل_افتراضي = *الدخول_اللاحق;
    دع ح: حقيقة_نقل_حافة_تخصيص = *الحافة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(اللاحق) مثل غير_موقع)) {
        دع مقتول: متغير منطقي = خطأ;
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول(ح.النقلات) مثل غير_موقع)) {
            لو (معرفا_سجل_افتراضي_متساويان(
                ح.النقلات[ن].الوجهة.السجل, اللاحق[ف]
            )) {
                مقتول := صواب;
                ن := الطول(ح.النقلات) مثل غير_موقع;
            } وإلا {
                ن := ن + 1;
            };
        }
        لو (!مقتول) { أضف_سجلا_حيا(الناتج, اللاحق[ف]); };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(ح.النقلات) مثل غير_موقع)) {
        أضف_سجلا_حيا(الناتج, ح.النقلات[ف].المصدر.السجل);
        ف := ف + 1;
    }
}


عرف ادمج_نقلات_حافة_في_مخزن_حياة(
    الناتج: &متغير مخزن_حياة_مؤقت,
    الدخول_اللاحق: &مخزن_حياة_مؤقت,
    الحافة: &حقيقة_نقل_حافة_تخصيص
): فراغ {
    دع اللاحق: مخزن_حياة_مؤقت = *الدخول_اللاحق;
    دع ح: حقيقة_نقل_حافة_تخصيص = *الحافة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < اللاحق.العدد) {
        دع مقتول: متغير منطقي = خطأ;
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول(ح.النقلات) مثل غير_موقع)) {
            لو (معرفا_سجل_افتراضي_متساويان(
                ح.النقلات[ن].الوجهة.السجل, اللاحق.القيم[ف]
            )) {
                مقتول := صواب;
                ن := الطول(ح.النقلات) مثل غير_موقع;
            } وإلا {
                ن := ن + 1;
            };
        }
        لو (!مقتول) { أضف_إلى_مخزن_حياة(الناتج, اللاحق.القيم[ف]); };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(ح.النقلات) مثل غير_موقع)) {
        أضف_إلى_مخزن_حياة(الناتج, ح.النقلات[ف].المصدر.السجل);
        ف := ف + 1;
    }
}

عرف ابن_فهارس_حواف_حياة(المسألة: &مسألة_تخصيص): فهارس_حواف_حياة {
    دع م: مسألة_تخصيص = *المسألة;
    دع الخارجة: متغير متجه متجه غير_موقع = [];
    دع الأسلاف: متغير متجه متجه غير_موقع = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(م.الكتل) مثل غير_موقع)) {
        دع فارغ_خارج: متجه غير_موقع = [];
        دع فارغ_سلف: متجه غير_موقع = [];
        ألحق(الخارجة, فارغ_خارج);
        ألحق(الأسلاف, فارغ_سلف);
        ك := ك + 1;
    }
    دع ه: متغير غير_موقع = 0;
    بينما (ه < (الطول(م.نقلات_الحواف) مثل غير_موقع)) {
        دع مرجع_الحافة: &حقيقة_نقل_حافة_تخصيص = &م.نقلات_الحواف[ه];
        دع الحافة: حقيقة_نقل_حافة_تخصيص = *مرجع_الحافة;
        دع فهرس_المصدر: غير_موقع = الحافة.من_كتلة.القيمة;
        دع فهرس_الوجهة: غير_موقع = الحافة.إلى_كتلة.القيمة;
        لو (
            فهرس_المصدر < (الطول(الخارجة) مثل غير_موقع)
            && فهرس_الوجهة < (الطول(الأسلاف) مثل غير_موقع)
        ) {
            ألحق(الخارجة[فهرس_المصدر], ه);
            ألحق(الأسلاف[فهرس_الوجهة], فهرس_المصدر);
        };
        ه := ه + 1;
    }
    دع الناتج: فهارس_حواف_حياة = { الخارجة: الخارجة, الأسلاف: الأسلاف };
    أرجع الناتج;
}

عرف حل_حياة_كتل_تخصيص(
    المسألة: &مسألة_تخصيص,
    الحياة: &متغير متجه حياة_كتلة_تخصيص
): فراغ {
    دع م: مسألة_تخصيص = *المسألة;
    دع الحالة: متغير متجه حياة_كتلة_تخصيص = *الحياة;
    دع الفهارس: فهارس_حواف_حياة = ابن_فهارس_حواف_حياة(&م);
    دع عدد_الكتل: غير_موقع = الطول(م.الكتل) مثل غير_موقع;

    // Fixed-point state uses capacity-retaining sparse buffers. Requeues reset
    // logical lengths instead of allocating new live-in/live-out vectors.
    دع دخول_عامل: متغير متجه مخزن_حياة_مؤقت = [];
    دع خروج_عامل: متغير متجه مخزن_حياة_مؤقت = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < عدد_الكتل) {
        دع قيم_دخول: متجه معرف_سجل_افتراضي = [];
        دع قيم_خروج: متجه معرف_سجل_افتراضي = [];
        دع مخزن_دخول: مخزن_حياة_مؤقت = { القيم: قيم_دخول, العدد: 0 };
        دع مخزن_خروج: مخزن_حياة_مؤقت = { القيم: قيم_خروج, العدد: 0 };
        ألحق(دخول_عامل, مخزن_دخول);
        ألحق(خروج_عامل, مخزن_خروج);
        ك := ك + 1;
    }
    دع قيم_خروج_جديد: متجه معرف_سجل_افتراضي = [];
    دع خروج_جديد: متغير مخزن_حياة_مؤقت = {
        القيم: قيم_خروج_جديد,
        العدد: 0
    };
    دع قيم_دخول_جديد: متجه معرف_سجل_افتراضي = [];
    دع دخول_جديد: متغير مخزن_حياة_مؤقت = {
        القيم: قيم_دخول_جديد,
        العدد: 0
    };

    // The worklist can never have more pending entries than blocks because
    // `في_الطابور` suppresses duplicates. Keep a bounded FIFO ring instead of
    // retaining every processed/requeued entry in an append-only history.
    دع الطابور: متغير متجه غير_موقع = [];
    دع في_الطابور: متغير متجه منطقي = [];
    ك := 0;
    بينما (ك < عدد_الكتل) {
        ألحق(الطابور, 0);
        ألحق(في_الطابور, خطأ);
        ك := ك + 1;
    }
    دع رأس_الطابور: متغير غير_موقع = 0;
    دع ذيل_الطابور: متغير غير_موقع = 0;
    دع عدد_الطابور: متغير غير_موقع = 0;
    ك := عدد_الكتل;
    بينما (ك > 0) {
        ك := ك - 1;
        الطابور[ذيل_الطابور] := ك;
        ذيل_الطابور := (ذيل_الطابور + 1) % عدد_الكتل;
        عدد_الطابور := عدد_الطابور + 1;
        في_الطابور[ك] := صواب;
    }
    بينما (عدد_الطابور > 0) {
        دع الكتلة: غير_موقع = الطابور[رأس_الطابور];
        رأس_الطابور := (رأس_الطابور + 1) % عدد_الكتل;
        عدد_الطابور := عدد_الطابور - 1;
        في_الطابور[الكتلة] := خطأ;

        امسح_مخزن_حياة(&متغير خروج_جديد);
        دع ه: متغير غير_موقع = 0;
        بينما (ه < (الطول(الفهارس.الخارجة[الكتلة]) مثل غير_موقع)) {
            دع فهرس_الحافة: غير_موقع = الفهارس.الخارجة[الكتلة][ه];
            دع مرجع_الحافة: &حقيقة_نقل_حافة_تخصيص = &م.نقلات_الحواف[فهرس_الحافة];
            دع الحافة: حقيقة_نقل_حافة_تخصيص = *مرجع_الحافة;
            دع اللاحق: غير_موقع = الحافة.إلى_كتلة.القيمة;
            لو (اللاحق < عدد_الكتل) {
                ادمج_نقلات_حافة_في_مخزن_حياة(
                    &متغير خروج_جديد, &دخول_عامل[اللاحق], &الحافة
                );
            };
            ه := ه + 1;
        }
        احسب_دخول_حياة_في_مخزن(
            &الحالة[الكتلة].الاستخدامات,
            &الحالة[الكتلة].التعريفات,
            &خروج_جديد,
            &متغير دخول_جديد
        );
        دع تغير_الخروج: منطقي = !مخزنا_حياة_متساويان(
            &خروج_جديد, &خروج_عامل[الكتلة]
        );
        دع تغير_الدخول: منطقي = !مخزنا_حياة_متساويان(
            &دخول_جديد, &دخول_عامل[الكتلة]
        );
        لو (تغير_الخروج) {
            انسخ_مخزن_حياة_إلى_مخزن(
                &خروج_جديد, &متغير خروج_عامل[الكتلة]
            );
        };
        لو (تغير_الدخول) {
            انسخ_مخزن_حياة_إلى_مخزن(
                &دخول_جديد, &متغير دخول_عامل[الكتلة]
            );
            دع س: متغير غير_موقع = 0;
            بينما (س < (الطول(الفهارس.الأسلاف[الكتلة]) مثل غير_موقع)) {
                دع السلف: غير_موقع = الفهارس.الأسلاف[الكتلة][س];
                لو (!في_الطابور[السلف]) {
                    الطابور[ذيل_الطابور] := السلف;
                    ذيل_الطابور := (ذيل_الطابور + 1) % عدد_الكتل;
                    عدد_الطابور := عدد_الطابور + 1;
                    في_الطابور[السلف] := صواب;
                };
                س := س + 1;
            }
        };
    }

    // Materialize persistent liveness exactly once, after the fixed point.
    ك := 0;
    بينما (ك < عدد_الكتل) {
        الحالة[ك].الدخول := حول_مخزن_حياة_إلى_مجموعة(&دخول_عامل[ك]);
        الحالة[ك].الخروج := حول_مخزن_حياة_إلى_مجموعة(&خروج_عامل[ك]);
        ك := ك + 1;
    }
    *الحياة := الحالة;
}

عام عرف حلل_مجالات_الحياة(المسألة: &مسألة_تخصيص): متجه مجال_حياة_سجل {
    دع المسألة_الحالية: مسألة_تخصيص = *المسألة;
    دع المجالات: متغير متجه مجال_حياة_سجل = [];
    تأكد_عدد_المجالات(&متغير المجالات, المسألة_الحالية.عدد_السجلات_الافتراضية);

    // اجمع القيود والمواضع الصريحة أولا؛ تحليل CFG سيضيف المقاطع الحية بين هذه المواضع.
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المسألة_الحالية.التعليمات) مثل غير_موقع)) {
        دع مرجع_الحقيقة: &حقيقة_تعليمة_تخصيص = &المسألة_الحالية.التعليمات[ف];
        دع حقيقة: حقيقة_تعليمة_تخصيص = *مرجع_الحقيقة;
        دع ي: متغير غير_موقع = 0;
        بينما (ي < (الطول(حقيقة.الاستخدامات) مثل غير_موقع)) {
            وسع_مجال(&متغير المجالات, &حقيقة.الاستخدامات[ي], حقيقة.الموضع);
            ي := ي + 1;
        }
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(حقيقة.التعريفات) مثل غير_موقع)) {
            وسع_مجال(&متغير المجالات, &حقيقة.التعريفات[ت], حقيقة.الموضع);
            ت := ت + 1;
        }
        ف := ف + 1;
    }

    // حقائق النسخ على الحواف تحمل قيود السجلات أيضا، وتثبت حدود المصدر/الوجهة عند CFG.
    دع ه: متغير غير_موقع = 0;
    بينما (ه < (الطول(المسألة_الحالية.نقلات_الحواف) مثل غير_موقع)) {
        دع مرجع_الحافة: &حقيقة_نقل_حافة_تخصيص = &المسألة_الحالية.نقلات_الحواف[ه];
        دع حافة: حقيقة_نقل_حافة_تخصيص = *مرجع_الحافة;
        دع موضع_المصدر: متغير غير_موقع = 0;
        دع موضع_الوجهة: متغير غير_موقع = 0;
        طابق ابحث_حقيقة_كتلة_تخصيص(&المسألة_الحالية.الكتل, حافة.من_كتلة) مع
        | اختيار.بعض(حقيقة_المصدر) -> { موضع_المصدر := موضع_نهاية_كتلة_تخصيص(&حقيقة_المصدر); }
        | اختيار.لا_شيء -> { };
        طابق ابحث_حقيقة_كتلة_تخصيص(&المسألة_الحالية.الكتل, حافة.إلى_كتلة) مع
        | اختيار.بعض(حقيقة_الوجهة) -> { موضع_الوجهة := حقيقة_الوجهة.البداية; }
        | اختيار.لا_شيء -> { };
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول(حافة.النقلات) مثل غير_موقع)) {
            دع نقلة: نقلة_حافة_تخصيص = حافة.النقلات[ن];
            وسع_مجال(&متغير المجالات, &نقلة.المصدر, موضع_المصدر);
            وسع_مجال(&متغير المجالات, &نقلة.الوجهة, موضع_الوجهة);
            ن := ن + 1;
        }
        ه := ه + 1;
    }

    // حقائق الربط تخص السجل الافتراضي نفسه؛ لا يعاد البحث عنها أثناء التخصيص.
    دع قف: متغير غير_موقع = 0;
    بينما (قف < (الطول(المسألة_الحالية.التعليمات) مثل غير_موقع)) {
        دع مرجع_قح: &حقيقة_تعليمة_تخصيص = &المسألة_الحالية.التعليمات[قف];
        دع قح: حقيقة_تعليمة_تخصيص = *مرجع_قح;
        دع قر: متغير غير_موقع = 0;
        بينما (قر < (الطول(قح.القيود_المربوطة) مثل غير_موقع)) {
            دع قيد: قيد_ربط_تخصيص = قح.القيود_المربوطة[قر];
            ألحق(المجالات[قيد.الأول.القيمة].السجلات_المربوطة, قيد.الثاني);
            ألحق(المجالات[قيد.الثاني.القيمة].السجلات_المربوطة, قيد.الأول);
            قر := قر + 1;
        }
        قف := قف + 1;
    }

    دع حياة_الكتل: متغير متجه حياة_كتلة_تخصيص = ابن_حياة_كتل_تخصيص(&المسألة_الحالية);
    حل_حياة_كتل_تخصيص(&المسألة_الحالية, &متغير حياة_الكتل);

    // تمثل الحياة كمجموعات سجلات افتراضية مرتبة ومتناثرة؛ لا توجد مصفوفة
    // كتلة × سجل، ولا مسح لجميع السجلات عند حدود الكتلة أو النداء.
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(المسألة_الحالية.الكتل) مثل غير_موقع)) {
        دع حقيقة_الكتلة: حقيقة_كتلة_تخصيص = المسألة_الحالية.الكتل[ك];
        دع بداية_الكتلة: غير_موقع = حقيقة_الكتلة.البداية;
        دع نهاية_الكتلة: غير_موقع = موضع_نهاية_كتلة_تخصيص(&حقيقة_الكتلة);
        دع ر: متغير غير_موقع = 0;
        بينما (ر < (الطول(حياة_الكتل[ك].الدخول) مثل غير_موقع)) {
            وسع_حدود_مجال(
                &متغير المجالات, حياة_الكتل[ك].الدخول[ر], بداية_الكتلة
            );
            ر := ر + 1;
        }
        ر := 0;
        بينما (ر < (الطول(حياة_الكتل[ك].الخروج) مثل غير_موقع)) {
            وسع_حدود_مجال(
                &متغير المجالات, حياة_الكتل[ك].الخروج[ر], نهاية_الكتلة
            );
            ر := ر + 1;
        }

        دع الحي: متغير مخزن_حياة_مؤقت = ابن_مخزن_حياة_من(
            &حياة_الكتل[ك].الخروج
        );
        دع قيم_الحي_التالي: متجه معرف_سجل_افتراضي = [];
        دع الحي_التالي: متغير مخزن_حياة_مؤقت = {
            القيم: قيم_الحي_التالي,
            العدد: 0
        };
        دع موضع: متغير غير_موقع = حقيقة_الكتلة.النهاية;
        بينما (موضع > حقيقة_الكتلة.البداية) {
            موضع := موضع - 1;
            دع مرجع_الحقيقة: &حقيقة_تعليمة_تخصيص = &المسألة_الحالية.التعليمات[موضع];
            دع حقيقة: حقيقة_تعليمة_تخصيص = *مرجع_الحقيقة;
            دع له_حد: منطقي = (((الطول(حقيقة.السجلات_المفسدة) مثل غير_موقع) > 0) || حقيقة.حد_نداء);
            لو (له_حد) {
                // A value crosses this boundary exactly when it is live after the
                // instruction and remains live before it. Derive that intersection
                // from the current live-after set plus defs/uses instead of copying
                // the whole live set just to intersect it after the transfer.
                دع ب: متغير غير_موقع = 0;
                بينما (ب < الحي.العدد) {
                    دع السجل_الحي: معرف_سجل_افتراضي = الحي.القيم[ب];
                    دع معرف_هنا: متغير منطقي = خطأ;
                    دع د: متغير غير_موقع = 0;
                    بينما (د < (الطول(حقيقة.التعريفات) مثل غير_موقع)) {
                        لو (معرفا_سجل_افتراضي_متساويان(
                            حقيقة.التعريفات[د].السجل, السجل_الحي
                        )) {
                            معرف_هنا := صواب;
                            د := الطول(حقيقة.التعريفات) مثل غير_موقع;
                        } وإلا {
                            د := د + 1;
                        };
                    }
                    دع مستخدم_هنا: متغير منطقي = خطأ;
                    لو (معرف_هنا) {
                        دع س: متغير غير_موقع = 0;
                        بينما (س < (الطول(حقيقة.الاستخدامات) مثل غير_موقع)) {
                            لو (معرفا_سجل_افتراضي_متساويان(
                                حقيقة.الاستخدامات[س].السجل, السجل_الحي
                            )) {
                                مستخدم_هنا := صواب;
                                س := الطول(حقيقة.الاستخدامات) مثل غير_موقع;
                            } وإلا {
                                س := س + 1;
                            };
                        }
                    };
                    لو (!معرف_هنا || مستخدم_هنا) {
                        أضف_مفسدات_إلى_مجال(
                            &متغير المجالات[السجل_الحي.القيمة],
                            &حقيقة.السجلات_المفسدة,
                            حقيقة.حد_نداء
                        );
                    };
                    ب := ب + 1;
                }
            };
            انتقال_تعليمة_حياة_إلى_مخزن(
                &الحي,
                &حقيقة.التعريفات,
                &حقيقة.الاستخدامات,
                &متغير الحي_التالي
            );
            دع التبادل: مخزن_حياة_مؤقت = الحي;
            الحي := الحي_التالي;
            الحي_التالي := التبادل;
        }
        ك := ك + 1;
    }
    أرجع المجالات;
}
