    | خطأ_بناء_سياقات_أنواع.فهرس_خارج_طول_معروف(النطاق, الفهرس, الطول) -> {
        // The index and the length name the problem; no tuple reason applies.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.فهرس_خارج_الحدود(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
