        | اختياري.لا_شيء -> { };
        دع بلا_حجج_المساعدة: متجه حجة_تشخيص = [];
        دع أضيفت_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_مرر_نوع_مؤشر_حجة_نوع(), بلا_حجج_المساعدة
        );
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
