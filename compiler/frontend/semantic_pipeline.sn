            دع أضيفت_المساعدة: منطقي = أضف_مساعدة(
                &متغير التشخيص, مفتاح_صياغة.مساعدة_مرر_نوع_مؤشر_حجة_نوع(), بلا_حجج
            );
        }
        | صنف_استعمال_معتم.فك -> {
            دع أضيفت_المساعدة: منطقي = أضف_مساعدة(
