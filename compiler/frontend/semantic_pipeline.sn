        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.حقل_سجل_مفقود(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        طابق الحقل مع
        | اختياري.موجود(هوية_الحقل) -> {
            طابق تهجئة_معرف_اسم(&(*سياق_الأسماء).الأسماء, هوية_الحقل) مع
            | اختياري.موجود(الاسم) -> {
                دع أضف_الاسم: منطقي = أضف_حجة_تشخيص(
                    &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الاسم
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.حقل_سجل_مكرر(النطاق, النطاق_الأول) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.حقل_سجل_مكرر(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, النطاق, مفتاح_حجة_تشخيص.الرمز());
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق_الأول) مع
        | اختياري.موجود(المصدر_الأول) -> {
            دع أضف_الأول: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر_الأول, دور_نطاق_تشخيص.سياق_مرتبط()
            );
        }
        | اختياري.لا_شيء -> { };
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.قفز_خارج_حلقة(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_عند(
            معرف_تشخيص.تحكم_حلقة_خارج_حلقة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
    }
    | خطأ_بناء_سياقات_أنواع.فك_غير_مؤشر(النطاق, النوع) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.فك_مرجع_غير_مؤشر(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضيف_النوع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, النوع
        );
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.فهرس_خارج_طول_معروف(النطاق, الفهرس, الطول) -> {
        // The index and the length name the problem; no tuple reason applies.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.فهرس_خارج_الحدود(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضيفت_المرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»
        );
        دع أضيف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        دع أضيف_الطول: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول
        );
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.فهرس_صف_خارج_الحدود(النطاق, الفهرس, الطول) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_نوعي(
            معرف_تشخيص.فهرس_خارج_الحدود(), المحمل, النطاق,
            سبب_تشخيص.سبب_نوع_فهرس_صف_خارج_الحدود()
        );
        دع أضيف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        دع أضيف_الطول: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول
        );
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(النطاق, النوع) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.تعبير_غير_قابل_للاستدعاء(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_9: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_9: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_تعبير_ليس_قابل_للاستدعاء()

        );
        دع أضيف_النوع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, النوع
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    };
}

عرف سبب_خطأ_بناء_نمط(الخطأ: خطأ_بناء_نمط): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_بناء_نمط.مصدر_غير_متطابق(_) -> { أرجع سبب_تشخيص.سبب_نمط_مصدر_عدم_تطابق(); }
    | خطأ_بناء_نمط.نطاق_خارج_المصدر(_) -> { أرجع سبب_تشخيص.سبب_نمط_نطاق_مصدر_خارج_مصدر(); }
    | خطأ_بناء_نمط.هوية_اسم_مفقودة(_) -> { أرجع سبب_تشخيص.سبب_نمط_مفقود_اسم_هوية(); }
    | خطأ_بناء_نمط.تابع_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_نمط_غير_صحيح_فرعي(); }
    | خطأ_بناء_نمط.حرفي_غير_مدعوم(_) -> { أرجع سبب_تشخيص.سبب_نمط_غير_مدعوم_قيمة_حرفية(); };
}

عرف نطاق_خطأ_بناء_نمط(الخطأ: خطأ_بناء_نمط): اختياري نطاق {
    طابق الخطأ مع
    | خطأ_بناء_نمط.مصدر_غير_متطابق(النطاق) -> { أرجع اختياري.موجود(النطاق); }
    | خطأ_بناء_نمط.نطاق_خارج_المصدر(النطاق) -> { أرجع اختياري.موجود(النطاق); }
    | خطأ_بناء_نمط.هوية_اسم_مفقودة(النطاق) -> { أرجع اختياري.موجود(النطاق); }
    | خطأ_بناء_نمط.تابع_غير_صالح(_) -> { أرجع اختياري.لا_شيء(); }
    | خطأ_بناء_نمط.حرفي_غير_مدعوم(النطاق) -> { أرجع اختياري.موجود(النطاق); };
}

عرف سبب_خطأ_تكامل_نمط(الخطأ: خطأ_تكامل_نوع_نمط): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(_) -> { أرجع سبب_تشخيص.سبب_نمط_مفقود_مميز_نوع(); }
    | خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(_) -> { أرجع سبب_تشخيص.سبب_نمط_مفقود_منشئ_ربط_اسم(); }
    | خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(_) -> { أرجع سبب_تشخيص.سبب_نمط_غير_دلالي_منشئ(); }
    | خطأ_تكامل_نوع_نمط.تحقق(_) -> { أرجع سبب_تشخيص.سبب_نمط_نوع_فحص_فشل(); };
}

عرف نطاق_خطأ_تكامل_نمط(الخطأ: خطأ_تكامل_نوع_نمط): نطاق {
    طابق الخطأ مع
    | خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(النطاق) -> { أرجع النطاق; }
    | خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(النطاق) -> { أرجع النطاق; }
    | خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(النطاق) -> { أرجع النطاق; }
    | خطأ_تكامل_نوع_نمط.تحقق(النطاق) -> { أرجع النطاق; };
}

عرف هل_خطأ_تكامل_نمط_مشتقا(الخطأ: خطأ_تكامل_نوع_نمط): منطقي {
    طابق الخطأ مع
    | خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(_) -> { أرجع صواب; }
    | خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(_) -> { أرجع صواب; }
    | خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف تشخيصات_خطأ_أنماط_مفصلة(
    الخطأ: خطأ_أنماط_وحدة,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_أنماط_وحدة.بناء(خطأ_البناء) -> {
        دع المصدر: متغير اختياري نطاق_مصدر_تشخيص = اختياري.لا_شيء();
        طابق نطاق_خطأ_بناء_نمط(خطأ_البناء) مع
        | اختياري.موجود(النطاق) -> { المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق); }
        | اختياري.لا_شيء -> { };
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.نمط_غير_صالح(), المصدر);
        دع أضف_مرحلة_نمط: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «pattern»
        );
        دع أضف_سبب_نمط: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_خطأ_بناء_نمط(خطأ_البناء)
        );
        طابق خطأ_البناء مع
        | خطأ_بناء_نمط.تابع_غير_صالح(النمط) -> {
            دع أضف_النمط: منطقي = أضف_حجة_طبيعية(
                &متغير التشخيص, مفتاح_حجة_تشخيص.النمط(), النمط.القيمة
            );
        }
        | خطأ_بناء_نمط.هوية_اسم_مفقودة(النطاق) -> {
            أضف_اعتماد_تشخيص_من_نطاق_محمل(&متغير التشخيص, المحمل, النطاق);
        }
        | _ -> { };
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_أنماط_وحدة.نوعي(خطأ_النوع) -> {
        دع النطاق: نطاق = نطاق_خطأ_تكامل_نمط(خطأ_النوع);
        لو (هل_خطأ_تكامل_نمط_مشتقا(خطأ_النوع)) {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق) مع
            | اختياري.موجود(الاعتماد) -> {
                أرجع تشخيصات_فشل_واجهة_مفصلة_مشتقة(
                    معرف_تشخيص.نمط_غير_صالح(),
                    مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
                    الاعتماد, «pattern», سبب_خطأ_تكامل_نمط(خطأ_النوع)
                );
            }
            | اختياري.لا_شيء -> { };
        };
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نمط_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «pattern», سبب_خطأ_تكامل_نمط(خطأ_النوع)
        );
    }
    | خطأ_أنماط_وحدة.غير_شامل(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_عند(
            معرف_تشخيص.نمط_غير_شامل(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
    };
}

// Whether a Type can be the program entry's result: nothing, or an integer
// that becomes the process exit status (as C's `main` returns `int`).
عرف ناتج_نقطة_دخول_مقبول(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق صنف_النوع_البدائي(البدائي) مع
            | صنف_نوع_بدائي.عدد_موقع -> { أرجع صواب; }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> { أرجع صواب; }
            | صنف_نوع_بدائي.فراغ -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}

// A program entry whose result is not an exit status is rejected at its
// result Type. A missing fact leaves the decision to the backend.
عرف تشخيصات_ناتج_نقطة_الدخول(
    رمز_البدء: اختياري معرف_رمز,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    الوحدات: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    شجرة_الجذر: اختياري طبيعي,
    المحمل: &خريطة_مصادر
): اختياري مجموعة_تشخيصات {
    دع الرمز: معرف_رمز;
    طابق رمز_البدء مع
    | اختياري.موجود(القيمة) -> { الرمز := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع نوع_الدالة: معرف_نوع;
    طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
    | اختياري.موجود(القيمة) -> { نوع_الدالة := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة) مع
    | اختياري.موجود(الناتج) -> {
        لو (ناتج_نقطة_دخول_مقبول(الأنواع, الناتج)) { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    // Point at the result Type of the entry declaration in the root module.
    دع المصدر: متغير اختياري نطاق_مصدر_تشخيص = اختياري.لا_شيء();
    طابق شجرة_الجذر مع
    | اختياري.موجود(الجذر) -> {
        لو (الجذر < (الطول(*الوحدات) مثل طبيعي) && الجذر < (الطول(*الروابط) مثل طبيعي)) {
            دع الوحدة: &وحدة_مصدر = &(*الوحدات)[الجذر];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
                طابق (*الوحدة).العناصر[ف] مع
                | عنصر_وحدة.دالة(الدالة) -> {
                    طابق رمز_اسم_محلول_عند(&(*الروابط)[الجذر], الدالة.الاسم.النطاق) مع
                    | اختياري.موجود(رمز_الدالة) -> {
                        لو (رمز_الدالة.القيمة == الرمز.القيمة) {
                            المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_نوع_تركيبي(&الدالة.الناتج));
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
                ف := ف + 1;
            }
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.موجود(تشخيصات_فشل_واجهة_عند(معرف_تشخيص.نقطة_دخول_بتوقيع_غير_صالح(), المصدر));
}

// An arm an earlier arm already covers never runs: a warning at the arm's
// pattern. It does not stop the compilation.
عرف أصدر_تحذيرات_أذرع_غير_قابلة_للوصول(
    النطاقات: &متجه نطاق,
    المحمل: &خريطة_مصادر,
    المجموعة: &متغير مجموعة_تشخيصات
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النطاقات) مثل طبيعي)) {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نمط_غير_قابل_للوصول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, (*النطاقات)[ف])
        );
        ضع_دور_النطاق_الرئيسي(&متغير التشخيص, دور_نطاق_تشخيص.نمط_غير_قابل_للوصول());
        أصدر_تشخيصا(المجموعة, &التشخيص);
        ف := ف + 1;
    }
}

عرف تشخيصات_خطأ_واجهة(
    الخطأ: خطأ_واجهة_وحدة,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_واجهة_وحدة.تحميل(الخطأ) -> {
        دع بلا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
        أرجع تشخيصات_خطأ_تحميل_وحدة_مفصلة(الخطأ, بلا_فهرس, اختياري.لا_شيء());
    }
    | خطأ_واجهة_وحدة.تحميل_استيراد(الخطأ, النطاق) -> {
        // The span is the module path as written: name it, not the import's index.
        دع بلا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص_خطأ_تحميل_وحدة(الخطأ.الخطأ), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «module-loading»
        );
        دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_خطأ_تحميل_وحدة(الخطأ.الخطأ));
        أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, النطاق, مفتاح_حجة_تشخيص.المسار());
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_واجهة_وحدة.معجم(الخطأ) -> {
        أرجع تشخيصات_خطأ_معجمي_مفصلة(الخطأ, المحمل);
    }
    | خطأ_واجهة_وحدة.نحو(الخطأ) -> {
        أرجع تشخيصات_خطأ_نحوي_مفصلة(الخطأ, المحمل);
    }
    | خطأ_واجهة_وحدة.خلل_نحوي_داخلي -> {
        أرجع تشخيصات_خلل_نحوي_داخلي();
    }
    | خطأ_واجهة_وحدة.أنماط(الخطأ) -> {
        أرجع تشخيصات_خطأ_أنماط_مفصلة(الخطأ, المحمل);
    };
}

عرف وحدة_نحوية_مسجلة(المسجلة: &متجه منطقي, المعرف: معرف_وحدة): منطقي {
    دع الحالة: متجه منطقي = *المسجلة;
    لو (المعرف.القيمة >= (الطول(الحالة) مثل طبيعي)) {
        أرجع خطأ;
    };
    أرجع الحالة[المعرف.القيمة];
}

عرف سجل_وحدة_نحوية(المسجلة: &متغير متجه منطقي, المعرف: معرف_وحدة): فراغ {
    طالما ((الطول(*المسجلة) مثل طبيعي) <= المعرف.القيمة) {
        ألحق(*المسجلة, خطأ);
    }
    (*المسجلة)[المعرف.القيمة] := صواب;
}

// The module path as written in an import (`std.text`), or the whole import
// when it has no name path.
عرف نطاق_مسار_استيراد_واجهة(الاستيراد: &استيراد): نطاق {
    دع القيمة: استيراد = *الاستيراد;
    طابق القيمة مع
    | استيراد.اسم(النطاق, الأسماء, _) -> {
        دع العدد: طبيعي = الطول(الأسماء) مثل طبيعي;
        لو (العدد == 0) { أرجع النطاق; };
        أرجع دمج_نطاق(الأسماء[0].النطاق, الأسماء[العدد - 1].النطاق);
    }
    | استيراد.نص(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.انتقائي(النطاق, الأسماء, _) -> {
        دع العدد: طبيعي = الطول(الأسماء) مثل طبيعي;
        لو (العدد == 0) { أرجع النطاق; };
        أرجع دمج_نطاق(الأسماء[0].النطاق, الأسماء[العدد - 1].النطاق);
    };
}

عرف نطاق_استيراد_واجهة(الاستيراد: &استيراد): نطاق {
    دع القيمة: استيراد = *الاستيراد;
    طابق القيمة مع
    | استيراد.اسم(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.نص(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.انتقائي(النطاق, _, _) -> { أرجع النطاق; };
}

// Lexer tokens are only needed while parsing a single module. Keep this
// call separate from recursive import discovery so its token vector and parser
// temporaries are no longer live while imported modules are loaded.
نوع نتيجة_شجرة_محللة_واجهة =
    | مكتملة بنوع وحدة_مصدر
    | مرفوضة بنوع خطأ_واجهة_وحدة
;

// A keyword written in a deprecated spelling (token_registry.def,
// SULTANC__KEYWORD_DEPRECATED__) compiles as its token. Each such token in the
// module warns once, at the token: the module is lexed once per compilation.
عرف أصدر_تحذيرات_تهجئة_مهجورة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المحمل: &خريطة_مصادر,
    المجموعة: &متغير مجموعة_تشخيصات
): فراغ {
    دع الأصل: مصدر = *المصدر;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        دع النطاق: نطاق = (*الرموز)[ف].النطاق;
        طابق تهجئة_مهجورة_لرمز(
            (*الرموز)[ف].النوع, &الأصل.المحتوى, النطاق.البداية.البايت, النطاق.النهاية.البايت
        ) مع
        | اختياري.موجود({ القديمة: القديمة, الجديدة: الجديدة }) -> {
            دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
                معرف_تشخيص.تهجئة_مهجورة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
            );
            دع أضف_القديمة: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), القديمة
            );
            دع أضف_الجديدة: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الجديدة
            );
            أصدر_تشخيصا(المجموعة, &التشخيص);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
}

// A deprecated contextual spelling the Name pass met (the Option type name
// اختيار, the Option constructor بعض): one warning per occurrence, in order.
عرف أصدر_تحذيرات_تهجئات_مربوطة(
    المهجورة: &متجه تهجئة_مهجورة_مربوطة,
    المحمل: &خريطة_مصادر,
    المجموعة: &متغير مجموعة_تشخيصات
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المهجورة) مثل طبيعي)) {
        دع المدخل: &تهجئة_مهجورة_مربوطة = &(*المهجورة)[ف];
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.تهجئة_مهجورة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, (*المدخل).النطاق)
        );
        دع أضف_القديمة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), انسخ_نص(&(*المدخل).القديمة)
        );
        دع أضف_الجديدة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), انسخ_نص(&(*المدخل).الجديدة)
        );
        أصدر_تشخيصا(المجموعة, &التشخيص);
        ف := ف + 1;
    }
}

عرف حلل_شجرة_محملة_واجهة(
    المصدر: &مصدر,
    الهدف: &اختياري واصف_هدف,
    استرداد_الأدوات: منطقي,
    سياق_المصادر: &متغير خريطة_مصادر,
    تشخيصات_الأدوات: &متغير مجموعة_تشخيصات
): نتيجة_شجرة_محللة_واجهة {
    طابق حلل_معجميا(المصدر) مع
    | نتيجة_تحليل_معجمي.مرفوض(الخطأ) -> {
        أرجع نتيجة_شجرة_محللة_واجهة.مرفوضة(خطأ_واجهة_وحدة.معجم(الخطأ));
    }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        أصدر_تحذيرات_تهجئة_مهجورة(المصدر, &السلسلة.الرموز, سياق_المصادر, تشخيصات_الأدوات);
        لو (استرداد_الأدوات) {
            دع أخطاء_الاسترداد: متغير متجه خطأ_نحوي = [];
            دع الشجرة: وحدة_مصدر = حلل_الرموز_للأدوات_لهدف(
                المصدر, &السلسلة.الرموز, الهدف, &متغير أخطاء_الاسترداد
            );
            دع أ: متغير طبيعي = 0;
            طالما (أ < (الطول(أخطاء_الاسترداد) مثل طبيعي)) {
                دع مجموعة_الخطأ: مجموعة_تشخيصات = تشخيصات_خطأ_نحوي_مفصلة(
                    أخطاء_الاسترداد[أ], سياق_المصادر
                );
                ادمج_مجموعة_تشخيصات(تشخيصات_الأدوات, &مجموعة_الخطأ);
                أ := أ + 1;
            }
            أرجع نتيجة_شجرة_محللة_واجهة.مكتملة(الشجرة);
        } وإلا {
            طابق حلل_الرموز_لهدف(المصدر, &السلسلة.الرموز, الهدف) مع
            | نتيجة_تحليل.مرفوض(الخطأ) -> {
                أرجع نتيجة_شجرة_محللة_واجهة.مرفوضة(خطأ_واجهة_وحدة.نحو(الخطأ));
            }
            | نتيجة_تحليل.خلل_داخلي -> {
                أرجع نتيجة_شجرة_محللة_واجهة.مرفوضة(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
            }
            | نتيجة_تحليل.شجرة(الشجرة) -> {
                أرجع نتيجة_شجرة_محللة_واجهة.مكتملة(الشجرة);
            };
        };
    };
}


// Expansion mutates SourceMap (generated source spans). Give it an
// independent, short-lived source snapshot so no mutable SourceMap borrow
// aliases its input. The snapshot dies before import recursion starts.
عرف وسع_شجرة_محملة_واجهة(
    الشجرة: &متغير وحدة_مصدر,
    سياق_المصادر: &متغير خريطة_مصادر,
    معرف_المصدر: طبيعي,
    الهدف: &اختياري واصف_هدف,
    جذر_البرنامج: منطقي
): منطقي {
    لو (معرف_المصدر >= (الطول((*سياق_المصادر).المصادر) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع مرجع_المصدر: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
    لو ((*مرجع_المصدر).المعرف != معرف_المصدر) { أرجع خطأ; };
    // Propagation (`؟`) first: decorator expansion copies the expanded bodies.
    دع نسخة_الانتشار: مصدر = *مرجع_المصدر;
    لو (!وسع_انتشار_وحدة(الشجرة, سياق_المصادر, &نسخة_الانتشار, الهدف)) { أرجع خطأ; };
    // The program's entry returning a result (frontend/desugar/entry_result.sn).
    لو (جذر_البرنامج) {
        دع مرجع_المنتشر: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
        دع نسخة_الدخول: مصدر = *مرجع_المنتشر;
        لو (!وسع_نقطة_دخول_بنتيجة(الشجرة, سياق_المصادر, &نسخة_الدخول, الهدف)) { أرجع خطأ; };
    };
    دع مرجع_الممدد: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
    دع نسخة_التوسيع: مصدر = *مرجع_الممدد;
    أرجع وسع_مزخرفات_وحدة(الشجرة, سياق_المصادر, &نسخة_التوسيع, الهدف);
}

عرف حلل_وحدة_محملة_مع_استيراداتها(
    المحمل: &متغير محمل_وحدات, سياق_المصادر: &متغير خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء, الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية, المعرف: معرف_وحدة,
    الوحدات: &متغير متجه وحدة_نحوية_محملة,
    أشجار_الوحدات: &متغير متجه وحدة_مصدر,
    الوحدات_المسجلة: &متغير متجه منطقي,
    استرداد_الأدوات: منطقي,
    تشخيصات_الأدوات: &متغير مجموعة_تشخيصات,
    الإلغاء: &حالة_إلغاء_واجهة,
    جذر_البرنامج: منطقي
): اختياري خطأ_واجهة_وحدة {
    لو (هل_واجهة_ملغاة(الإلغاء)) {
        أرجع اختياري.موجود(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
    };
    لو (وحدة_نحوية_مسجلة(الوحدات_المسجلة, المعرف)) {
        أرجع اختياري.لا_شيء();
    };
    طابق معرف_مصدر_وحدة_محملة_بالمعرف(المحمل, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_واجهة_وحدة.تحميل(خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة()));
    }
    | اختياري.موجود(معرف_المصدر) -> {
        // SourceMap is the sole owner of text. Borrow its checked SourceID
        // for parsing and expansion; do not allocate a second source buffer.
        لو (معرف_المصدر >= (الطول((*سياق_المصادر).المصادر) مثل طبيعي)) {
            أرجع اختياري.موجود(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
        };
        دع مرجع_المصدر: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
        لو ((*مرجع_المصدر).المعرف != معرف_المصدر) {
            أرجع اختياري.موجود(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
        };
        طابق حلل_شجرة_محملة_واجهة(
            مرجع_المصدر, &(*المحمل).الهدف, استرداد_الأدوات,
            سياق_المصادر, تشخيصات_الأدوات
        ) مع
        | نتيجة_شجرة_محللة_واجهة.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة_شجرة_محللة_واجهة.مكتملة(الشجرة_النحوية) -> {
            // The lexer/parser frame has ended before import recursion.
            دع الشجرة: متغير وحدة_مصدر = الشجرة_النحوية;
            لو (!وسع_شجرة_محملة_واجهة(
                &متغير الشجرة, سياق_المصادر, معرف_المصدر, &(*المحمل).الهدف, جذر_البرنامج
            )) {
                أرجع اختياري.موجود(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
            };
            لو (!ابدأ_تحميل_استيرادات_وحدة(المحمل, المعرف)) {
                أرجع اختياري.موجود(
                    خطأ_واجهة_وحدة.تحميل(خطأ_تحميل_وحدة.دورة_استيراد())
                );
            };
            طابق حمل_استيرادات_مباشرة(
                المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المعرف, &الشجرة
            ) مع
            | نتيجة_تحميل_استيرادات.خطأ(الخطأ) -> {
                انه_تحميل_استيرادات_وحدة(المحمل, المعرف);
                دع نطاق_الاستيراد: متغير نطاق = نطاق_فارغ();
                لو (الخطأ.الفهرس < (الطول(الشجرة.الاستيرادات) مثل طبيعي)) {
                    نطاق_الاستيراد := نطاق_مسار_استيراد_واجهة(&الشجرة.الاستيرادات[الخطأ.الفهرس]);
                };
                أرجع اختياري.موجود(
                    خطأ_واجهة_وحدة.تحميل_استيراد(الخطأ, نطاق_الاستيراد)
                );
            }
            | نتيجة_تحميل_استيرادات.محملة(المعرفات) -> {
                دع فهرس_الشجرة: طبيعي = الطول(*أشجار_الوحدات) مثل طبيعي;
                ألحق(*أشجار_الوحدات, الشجرة);
                دع سجل: وحدة_نحوية_محملة = { الوحدة: المعرف, الشجرة: فهرس_الشجرة };
                ألحق(*الوحدات, سجل);
                سجل_وحدة_نحوية(الوحدات_المسجلة, المعرف);

                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(المعرفات) مثل طبيعي)) {
                    طابق حلل_وحدة_محملة_مع_استيراداتها(
                        المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة,
                        المعرفات[ف], الوحدات, أشجار_الوحدات, الوحدات_المسجلة,
                        استرداد_الأدوات, تشخيصات_الأدوات, الإلغاء, خطأ
                    ) مع
                    | اختياري.موجود(الخطأ) -> {
                        انه_تحميل_استيرادات_وحدة(المحمل, المعرف);
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | _ -> { };
                    ف := ف + 1;
                }
                انه_تحميل_استيرادات_وحدة(المحمل, المعرف);
            };
        };
    };
    أرجع اختياري.لا_شيء();
}

عام نوع طلب_واجهة_وحدة = {
    البيئة: بيئة_وحدات_منطقية,
    المفتاح_الجذري: مفتاح_وحدة_مقنن,
    احتفظ_بحقائق_الأدوات: منطقي
};

// Project/tooling analysis reuses one canonical Module/Name/Type universe for every
// supplied project root.  The caller supplies source inventory; Module remains the
// owner of canonical keys, import closure, SourceIDs and ModuleIDs.
عام نوع طلب_واجهة_مشروع = {
    البيئة: بيئة_وحدات_منطقية,
    المفاتيح_الجذرية: متجه مفتاح_وحدة_مقنن,
    احتفظ_بحقائق_الأدوات: منطقي
};

عرف تشخيصات_تصريح_مكرر_مفصلة(
    سياق_الأسماء: &سياق_أسماء,
    المحمل: &خريطة_مصادر,
    الموجود: معرف_رمز,
    النطاق_الجديد: نطاق
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.تصريح_مكرر(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق_الجديد)
    );
    دع أضف_مرحلة_10: منطقي = أضف_حجة_تشخيص(

        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»

    );

    دع أضف_سبب_10: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_اسم_مكرر_تصريح()

    );
    // The name as written; the Symbol number only when it has no name.
    طابق تهجئة_اسم_رمز(&(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, الموجود) مع
    | اختياري.موجود(الاسم) -> {
        دع أضف_الاسم: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الاسم
        );
    }
    | اختياري.لا_شيء -> {
        دع أضف_الرمز: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الموجود.القيمة
        );
    };
    طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, الموجود) مع
    | اختياري.موجود(النطاق_السابق) -> {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق_السابق) مع
        | اختياري.موجود(المصدر_السابق) -> {
            دع أضف_السابق: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر_السابق, دور_نطاق_تشخيص.سياق_مرتبط()
            );
            دع بلا_حجج: متجه حجة_تشخيص = [];
            دع أضف_الملاحظة: منطقي = أضف_ملاحظة(
                &متغير التشخيص, مفتاح_صياغة.ملاحظة_التصريح_السابق(), بلا_حجج
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف سبب_خطأ_ذاكرة_نوع(الخطأ: خطأ_ذاكرة_نوع): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_ذاكرة_نوع.معرف_نوع_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_غير_صحيح_نوع_معرف(); }
    | خطأ_ذاكرة_نوع.دورة_ملكية_نوع(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_ملكية_دورة(); }
    | خطأ_ذاكرة_نوع.بنية_سجل_غير_متاحة(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_سجل_بنية_غير_متاح(); }
    | خطأ_ذاكرة_نوع.حقل_سجل_غير_متاح(_, _) -> { أرجع سبب_تشخيص.سبب_ذاكرة_سجل_حقل_غير_متاح(); }
    | خطأ_ذاكرة_نوع.بنية_نوع_موسوم_غير_متاحة(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_موسوم_بنية_غير_متاح(); }
    | خطأ_ذاكرة_نوع.منشئ_نوع_غير_متاح(_, _) -> { أرجع سبب_تشخيص.سبب_ذاكرة_منشئ_غير_متاح(); }
    | خطأ_ذاكرة_نوع.حمولة_منشئ_غير_متاحة(_, _, _) -> { أرجع سبب_تشخيص.سبب_ذاكرة_منشئ_حمولة_غير_متاح(); }
    | خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_غير_متوقع_نوع_بنية(); };
}

عرف نوع_خطأ_ذاكرة(الخطأ: خطأ_ذاكرة_نوع): معرف_نوع {
    طابق الخطأ مع
    | خطأ_ذاكرة_نوع.معرف_نوع_غير_صالح(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.دورة_ملكية_نوع(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.بنية_سجل_غير_متاحة(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.حقل_سجل_غير_متاح(النوع, _) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.بنية_نوع_موسوم_غير_متاحة(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.منشئ_نوع_غير_متاح(النوع, _) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.حمولة_منشئ_غير_متاحة(النوع, _, _) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(النوع) -> { أرجع النوع; };
}

عرف تشخيصات_خطأ_ذاكرة(
    الخطأ: خطأ_ذاكرة_نوع,
    الأنواع: &سجل_أنواع,
    سياق_الأسماء: &سياق_أسماء
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_ذاكرة_نوع(), اختياري.لا_شيء()
    );
    دع أضف_مرحلة_ذاكرة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «memory»
    );
    دع أضف_سبب_ذاكرة: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_خطأ_ذاكرة_نوع(الخطأ)
    );
    دع النوع: معرف_نوع = نوع_خطأ_ذاكرة(الخطأ);
    دع أضف_النوع: منطقي = أضف_نوع_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع,
        &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, النوع
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف معرف_تشخيص_خطأ_تدفق_سلامة(الخطأ: خطأ_تدفق_سلامة): معرف_تشخيص {
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(_) -> { أرجع معرف_تشخيص.استخدام_قبل_التهيئة(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(_) -> { أرجع معرف_تشخيص.استخدام_بعد_النقل(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_التحرير(_) -> { أرجع معرف_تشخيص.مورد_محرر(); }
    | خطأ_تدفق_سلامة.تحرير_مكرر(_) -> { أرجع معرف_تشخيص.مورد_محرر(); }
    | خطأ_تدفق_سلامة.تعارض_استعارة(_, _) -> { أرجع معرف_تشخيص.تعارض_استعارة(); }
    | خطأ_تدفق_سلامة.هروب_غير_صالح(_) -> { أرجع معرف_تشخيص.هروب_مرجع(); }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(_) -> { أرجع معرف_تشخيص.نقل_جزئي_مملوك(); }
    | خطأ_تدفق_سلامة.نقل_من_مرجع(_) -> { أرجع معرف_تشخيص.نقل_من_مرجع(); }
    | خطأ_تدفق_سلامة.خطأ_ذاكرة(_) -> { أرجع معرف_تشخيص.خطأ_ذاكرة_نوع(); }
    // A user error (assigning to a local declared without `mutable`), not an ICE.
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(_, _) -> { أرجع معرف_تشخيص.كتابة_إلى_غير_متغير(); }
    // Releasing storage the function does not own (a module value) gives up
    // ownership it never had, like moving out of borrowed storage.
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(_, _) -> { أرجع معرف_تشخيص.نقل_من_مرجع(); }
    | _ -> { أرجع معرف_تشخيص.حقيقة_دلالية_مفقودة(); };
}

عرف سبب_خطأ_تدفق_سلامة(الخطأ: خطأ_تدفق_سلامة): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.محلي_مفقود(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_مفقود_محلي(); }
    | خطأ_تدفق_سلامة.محلي_مكرر(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_مكرر_محلي(); }
    | خطأ_تدفق_سلامة.نوع_محلي_غير_صالح(_, _) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_غير_صحيح_محلي_نوع(); }
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(_, _) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_إسناد_إلى_ثابت(); }
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استخدام_قبل_تهيئة(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استخدام_بعد_نقل_ملكية(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_التحرير(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استخدام_بعد_تحرير(); }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_غير_صحيح_نقل_ملكية(); }
    | خطأ_تدفق_سلامة.نقل_من_مرجع(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_نقل_من_مرجع(); }
    | خطأ_تدفق_سلامة.تحرير_مكرر(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_مزدوج_تحرير(); }
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(_, _) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_تحرير_غير_مملوك(); }
    | خطأ_تدفق_سلامة.تعارض_استعارة(_, النوع) -> {
        طابق النوع مع
        | نوع_استعارة.مشتركة -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استعارة_تعارض_مشترك(); }
        | نوع_استعارة.حصرية -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استعارة_تعارض_حصري(); };
    }
    | خطأ_تدفق_سلامة.معرف_استعارة_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_غير_صحيح_استعارة_معرف(); }
    | خطأ_تدفق_سلامة.دمج_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_غير_صحيح_تحكم_تدفق_دمج(); }
    | خطأ_تدفق_سلامة.هروب_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_غير_صحيح_مرجع_تسرب(); }
    | خطأ_تدفق_سلامة.ربط_نمط_بلا_رمز(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_نمط_ربط_اسم_مفقود_رمز(); }
    | خطأ_تدفق_سلامة.ربط_نمط_بلا_نوع(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_نمط_ربط_اسم_مفقود_نوع(); }
    | خطأ_تدفق_سلامة.خطأ_ذاكرة(خطأ_الذاكرة) -> { أرجع سبب_خطأ_ذاكرة_نوع(خطأ_الذاكرة); };
}

عرف رمز_خطأ_تدفق_سلامة(الخطأ: خطأ_تدفق_سلامة): اختياري معرف_رمز {
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.محلي_مفقود(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.محلي_مكرر(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.نوع_محلي_غير_صالح(الرمز, _) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(الرمز, _) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق) -> { أرجع اختياري.موجود(السياق.الرمز); }
    | خطأ_تدفق_سلامة.استخدام_بعد_التحرير(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.نقل_من_مرجع(السياق) -> { أرجع السياق.الرمز; }
    | خطأ_تدفق_سلامة.تحرير_مكرر(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز, _) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, _) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.معرف_استعارة_غير_صالح(المعرف) -> { أرجع اختياري.موجود(المعرف.المالك); }
    | خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The spawn capture check's diagnostic: the captured (or shared) name and
// its Type, at its use inside the closure.
عرف تشخيصات_انتهاك_التقاط_خيط(
    الانتهاك: &انتهاك_التقاط_خيط,
    سياق_الأسماء: &سياق_أسماء,
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع
): مجموعة_تشخيصات {
    دع المعرف: متغير معرف_تشخيص = معرف_تشخيص.التقاط_خيط_مؤشر_خام();
    طابق (*الانتهاك).الصنف مع
    | صنف_انتهاك_التقاط_خيط.مؤشر_خام -> { }
    | صنف_انتهاك_التقاط_خيط.مرجع_مستعار -> { المعرف := معرف_تشخيص.التقاط_خيط_مرجع(); }
    | صنف_انتهاك_التقاط_خيط.مشترك_غير_ذري -> { المعرف := معرف_تشخيص.التقاط_خيط_مشترك_غير_ذري(); };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        المعرف, مصدر_تشخيص_من_نطاق_محمل(المحمل, (*الانتهاك).النطاق)
    );
    دع أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «types»);
    طابق تهجئة_اسم_رمز(&(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, (*الانتهاك).الرمز) مع
    | اختياري.موجود(الاسم) -> {
        دع أضف_الاسم: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الاسم);
    }
    | اختياري.لا_شيء -> { };
    طابق (*الانتهاك).النوع مع
    | اختياري.موجود(النوع) -> {
        دع أضف_النوع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع,
            &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, النوع
        );
    }
    | اختياري.لا_شيء -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_خطأ_تدفق_سلامة(
    الخطأ: خطأ_تدفق_سلامة,
    سياق_الأسماء: &سياق_أسماء,
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع
): مجموعة_تشخيصات {
    دع الأسماء: &متجه اسم_مقنن = &(*سياق_الأسماء).الأسماء;
    دع الرموز: &متجه رمز_دلالي = &(*سياق_الأسماء).الرموز;
    دع المصدر: متغير اختياري نطاق_مصدر_تشخيص = اختياري.لا_شيء();
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.نقل_من_مرجع(السياق) -> {
        المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, السياق.الموضع);
    }
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(الرمز, اختياري.موجود(نطاق_الإسناد)) -> {
        المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإسناد);
    }
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز, اختياري.موجود(نطاق_التحرير)) -> {
        المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التحرير);
    }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق) -> {
        طابق السياق.الاستخدام مع
        | اختياري.موجود(النطاق) -> {
            المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق);
        }
        | اختياري.لا_شيء -> {
            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, السياق.الرمز) مع
            | اختياري.موجود(النطاق) -> {
                المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق);
            }
            | اختياري.لا_شيء -> { };
        };
    }
    | _ -> {
        طابق رمز_خطأ_تدفق_سلامة(الخطأ) مع
        | اختياري.موجود(الرمز) -> {
            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختياري.موجود(النطاق) -> {
                المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق);
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_خطأ_تدفق_سلامة(الخطأ), المصدر
    );
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق) -> {
        طابق السياق.الاستخدام مع
        | اختياري.موجود(_) -> {
            ضع_دور_النطاق_الرئيسي(
                &متغير التشخيص, دور_نطاق_تشخيص.استخدام_غير_صالح()
            );
            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, السياق.الرمز) مع
            | اختياري.موجود(نطاق_التصريح) -> {
                طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التصريح) مع
                | اختياري.موجود(مصدر_التصريح) -> {
                    دع أضف_المالك: منطقي = أضف_نطاقا_مرتبطا(
                        &متغير التشخيص,
                        مصدر_التصريح,
                        دور_نطاق_تشخيص.المالك_الأصلي()
                    );
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        طابق السياق.أصل_النقل مع
        | اختياري.موجود(نطاق_النقل) -> {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_النقل) مع
            | اختياري.موجود(مصدر_النقل) -> {
                دع أضف_النقل: منطقي = أضف_نطاقا_مرتبطا(
                    &متغير التشخيص,
                    مصدر_النقل,
                    دور_نطاق_تشخيص.أصل_النقل()
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(الرمز, اختياري.موجود(_)) -> {
        ضع_دور_النطاق_الرئيسي(&متغير التشخيص, دور_نطاق_تشخيص.استخدام_غير_صالح());
        طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, الرمز) مع
        | اختياري.موجود(نطاق_التصريح) -> {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التصريح) مع
            | اختياري.موجود(مصدر_التصريح) -> {
                دع أضف_التصريح: منطقي = أضف_نطاقا_مرتبطا(
                    &متغير التشخيص, مصدر_التصريح, دور_نطاق_تشخيص.تصريح_غير_قابل_للتغيير()
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    دع أضف_مرحلة_تدفق: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «ssf»
    );
    دع أضف_سبب_تدفق: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_خطأ_تدفق_سلامة(الخطأ)
    );
    // The Symbol is named as written; its number is kept only when it has no name.
    طابق رمز_خطأ_تدفق_سلامة(الخطأ) مع
    | اختياري.موجود(الرمز) -> {
        طابق تهجئة_اسم_رمز(الأسماء, الرموز, الرمز) مع
        | اختياري.موجود(الاسم) -> {
            دع أضف_الاسم: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الاسم
            );
        }
        | اختياري.لا_شيء -> {
            دع أضف_الرمز: منطقي = أضف_حجة_طبيعية(
                &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة
            );
        };
    }
    | اختياري.لا_شيء -> { };
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.نوع_محلي_غير_صالح(_, النوع) -> {
        دع أضف_النوع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع, الأسماء, الرموز, النوع
        );
    }
    | خطأ_تدفق_سلامة.ربط_نمط_بلا_رمز(النمط) -> {
        دع أضف_النمط: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النمط(), النمط.القيمة
        );
    }
    | خطأ_تدفق_سلامة.ربط_نمط_بلا_نوع(النمط) -> {
        دع أضف_النمط: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النمط(), النمط.القيمة
        );
    }
    | خطأ_تدفق_سلامة.خطأ_ذاكرة(خطأ_الذاكرة) -> {
        دع النوع: معرف_نوع = نوع_خطأ_ذاكرة(خطأ_الذاكرة);
        دع أضف_النوع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع, الأسماء, الرموز, النوع
        );
    }
    | _ -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف نتيجة_واجهة_ملغاة(): نتيجة_بناء_واجهة_وحدة {
    أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
        تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
            «frontend», سبب_تشخيص.سبب_واجهة_أمامية_ملغى()
        )
    );
}

عرف معرف_مصدر_شجرة_واجهة(الشجرة: &وحدة_مصدر): طبيعي {
    أرجع (*الشجرة).معرف_المصدر;
}

عرف ضع_روابط_وحدة_واجهة(
    الروابط: &متغير متجه سياق_روابط_أسماء,
    الفهرس: طبيعي,
    القيمة: سياق_روابط_أسماء
): فراغ {
    (*الروابط)[الفهرس] := القيمة;
}

عرف ابن_واجهة_داخلية(
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    المفتاح_الأساسي: &مفتاح_وحدة_مقنن,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الهدف: اختياري واصف_هدف,
    احتفظ_بحقائق_الأدوات: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_وحدة {
    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
    دع قيمة_المفاتيح_الإضافية: متجه مفتاح_وحدة_مقنن = *المفاتيح_الإضافية;
    دع سياق_المصادر: متغير خريطة_مصادر = خريطة_مصادر_جديدة();
    دع سياق_الأسماء: متغير سياق_أسماء = سياق_أسماء_جديد();
    دع الرسم: متغير رسم_وحدات = رسم_وحدات_جديد();
    دع المحمل: متغير محمل_وحدات = محمل_وحدات_جديد();
    حدد_هدف_محمل_وحدات(&متغير المحمل, الهدف);
    دع الجذر: متغير معرف_وحدة = معرف_وحدة_من(0);
    طابق حمل_وحدة_جذر(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        البيئة_المدخلة,
        المفتاح_الأساسي
    ) مع
    | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.تحميل(الخطأ), &سياق_المصادر));
    }
    | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
        الجذر := المحملة.الوحدة;
    };

    دع الوحدات: متغير متجه وحدة_نحوية_محملة = [];
    // Canonical AST owner: each parsed module tree is appended exactly once.
    دع أشجار_الوحدات: متغير متجه وحدة_مصدر = [];
    دع الوحدات_المسجلة: متغير متجه منطقي = [];
    دع تشخيصات_الأدوات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    طابق حلل_وحدة_محملة_مع_استيراداتها(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        البيئة_المدخلة,
        الجذر,
        &متغير الوحدات,
        &متغير أشجار_الوحدات,
        &متغير الوحدات_المسجلة,
        احتفظ_بحقائق_الأدوات,
        &متغير تشخيصات_الأدوات,
        الإلغاء,
        صواب
    ) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(تشخيصات_خطأ_واجهة(الخطأ, &سياق_المصادر));
    }
    | _ -> { };

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Additional project roots are loaded into the same canonical loader/graph and
    // semantic contexts.  Already reachable modules are deduplicated by ModuleKey.
    دع فهرس_الجذر_الإضافي: متغير طبيعي = 0;
    طالما (فهرس_الجذر_الإضافي < (الطول(قيمة_المفاتيح_الإضافية) مثل طبيعي)) {
        دع مرجع_المفتاح_الإضافي: &مفتاح_وحدة_مقنن =
            &قيمة_المفاتيح_الإضافية[فهرس_الجذر_الإضافي];
        دع معرف_الجذر_الإضافي: متغير معرف_وحدة = معرف_وحدة_من(0);
        طابق حمل_وحدة_جذر(
            &متغير المحمل,
            &متغير سياق_المصادر,
            &متغير سياق_الأسماء,
            &متغير الرسم,
            البيئة_المدخلة,
            مرجع_المفتاح_الإضافي
        ) مع
        | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.تحميل(الخطأ), &سياق_المصادر)
            );
        }
        | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
            معرف_الجذر_الإضافي := المحملة.الوحدة;
        };
        طابق حلل_وحدة_محملة_مع_استيراداتها(
            &متغير المحمل,
            &متغير سياق_المصادر,
            &متغير سياق_الأسماء,
            &متغير الرسم,
            البيئة_المدخلة,
            معرف_الجذر_الإضافي,
            &متغير الوحدات,
            &متغير أشجار_الوحدات,
            &متغير الوحدات_المسجلة,
            احتفظ_بحقائق_الأدوات,
            &متغير تشخيصات_الأدوات,
            الإلغاء,
            خطأ
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_خطأ_واجهة(الخطأ, &سياق_المصادر)
            );
        }
        | _ -> { };
        فهرس_الجذر_الإضافي := فهرس_الجذر_الإضافي + 1;
    }

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Compiler-provided primitive Names are registered once into canonical Symbols
    // before ordinary source declarations are collected. They are not source modules.
    طابق وحدة_في_الرسم(&الرسم, الجذر) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                «name», سبب_تشخيص.سبب_اسم_جذر_وحدة_حقيقة_مفقود()
            )
        );
    }
    | اختياري.موجود(الوحدة_الجذرية) -> {
        لو (!سجل_بدائيات_المترجم(
            &متغير سياق_الأسماء, الوحدة_الجذرية.النطاق_الجذري
        )) {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
                    «name», سبب_تشخيص.سبب_اسم_بدائي_تسجيل_فشل()
                )
            );
        };
    };

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Phase 1: register declarations for every canonical loaded module before
    // resolving any imported use. Discovery order is not semantic dependency order.
    دع التصريحات_المجمعة: متغير متجه جدول_تصريحات = [];
    دع فهرس_التصريحات: متغير طبيعي = 0;
    طالما (فهرس_التصريحات < (الطول(الوحدات) مثل طبيعي)) {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
        دع شجرة_التصريحات: &وحدة_مصدر = &أشجار_الوحدات[الوحدات[فهرس_التصريحات].الشجرة];
        // The canonical SourceMap retains the bytes; Name only borrows them
        // for this module and never needs a second owned Source value.
        دع معرف_مصدر_التصريحات: طبيعي = معرف_مصدر_شجرة_واجهة(شجرة_التصريحات);
        لو (معرف_مصدر_التصريحات >= (الطول(سياق_المصادر.المصادر) مثل طبيعي)) {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                    «source», سبب_تشخيص.سبب_مصدر_بحث_مفقود_تصريح_مصدر()
                )
            );
        };
        دع مصدر_التصريحات: &مصدر = &سياق_المصادر.المصادر[معرف_مصدر_التصريحات];
        لو ((*مصدر_التصريحات).المعرف != معرف_مصدر_التصريحات) {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                    «source», سبب_تشخيص.سبب_مصدر_بحث_مفقود_تصريح_مصدر()
                )
            );
        };
        طابق اجمع_تصريحات_أسماء_وحدة(
            &متغير سياق_الأسماء,
            &الرسم,
            الوحدات[فهرس_التصريحات].الوحدة,
            شجرة_التصريحات,
            مصدر_التصريحات
        ) مع
        | نتيجة_جمع_تصريحات_أسماء_وحدة.مكتملة(التصريحات) -> {
            ألحق(التصريحات_المجمعة, التصريحات);
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.وحدة_مجهولة -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                    «name», سبب_تشخيص.سبب_اسم_تصريح_جمع_مجهول_وحدة()
                )
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.مصدر_غير_مطابق -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                    «name», سبب_تشخيص.سبب_اسم_تصريح_جمع_مصدر_عدم_تطابق()
                )
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.تصريح_مكرر(الموجود, النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_تصريح_مكرر_مفصلة(
                    &سياق_الأسماء, &سياق_المصادر, الموجود, النطاق
                )
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_مفقود(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_اسم_مفقود_أو_لهدف_آخر(
                    &سياق_المصادر, &أشجار_الوحدات, &المحمل.الهدف, النطاق,
                    سبب_تشخيص.سبب_اسم_تصريح_جمع_مفقود_اسم()
                )
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_خاص(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_تصريح_خاص(&سياق_المصادر, النطاق, سبب_تشخيص.سبب_اسم_تصريح_جمع_خاص_اسم())
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.تعارض_ربط(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.خطأ_سياق_داخلي(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                    «name», سبب_تشخيص.سبب_اسم_تصريح_جمع_ربط_اسم_تعارض()
                )
            );
        };
        فهرس_التصريحات := فهرس_التصريحات + 1;
    }

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Selective imports are declarations of scope visibility, not lazy name-use
    // filters. Validate every requested export now that all module declarations exist.
    دع فهرس_تحقق_الاستيراد: متغير طبيعي = 0;
    طالما (فهرس_تحقق_الاستيراد < (الطول(الوحدات) مثل طبيعي)) {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
        طابق تحقق_استيرادات_انتقائية(
            &سياق_الأسماء, &الرسم, الوحدات[فهرس_تحقق_الاستيراد].الوحدة
        ) مع
        | نتيجة_تحقق_استيراد_انتقائي.صالح -> { }
        | نتيجة_تحقق_استيراد_انتقائي.اسم_مفقود(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_اسم_غير_معروف(&سياق_المصادر, النطاق, سبب_تشخيص.سبب_اسم_انتقائي_استيراد_مفقود_اسم())
            );
        }
        | نتيجة_تحقق_استيراد_انتقائي.اسم_خاص(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_تصريح_خاص(&سياق_المصادر, النطاق, سبب_تشخيص.سبب_اسم_انتقائي_استيراد_خاص_اسم())
            );
        }
        | نتيجة_تحقق_استيراد_انتقائي.اسم_غامض(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.استيراد_غامض(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                    «name», سبب_تشخيص.سبب_اسم_انتقائي_استيراد_ملتبس_اسم()
                )
            );
        };
        فهرس_تحقق_الاستيراد := فهرس_تحقق_الاستيراد + 1;
    }

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Phase 2: preserve the established per-module resolution order. Every direct
    // import now observes declarations that were registered exactly once above.
    // Resolved source occurrences remain owned by their module. Downstream phases
    // consume the binding context aligned with the corresponding module tree;
    // no whole-program binding table is materialized or rescanned.
    دع روابط_الوحدات: متغير متجه سياق_روابط_أسماء = [];
    دع فهرس_روابط: متغير طبيعي = 0;
    طالما (فهرس_روابط < (الطول(الوحدات) مثل طبيعي)) {
        ألحق(روابط_الوحدات, سياق_روابط_أسماء_جديد());
        فهرس_روابط := فهرس_روابط + 1;
    }
    دع شجرة_الجذر: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع رمز_بدء_البرنامج: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    دع ف: متغير طبيعي = الطول(الوحدات) مثل طبيعي;
    طالما (ف > 0) {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
        ف := ف - 1;
        دع شجرة_الأسماء: &وحدة_مصدر = &أشجار_الوحدات[الوحدات[ف].الشجرة];
        // The canonical SourceMap retains the bytes; Name only borrows them
        // for this module and never needs a second owned Source value.
        دع معرف_مصدر_الأسماء: طبيعي = معرف_مصدر_شجرة_واجهة(شجرة_الأسماء);
        لو (معرف_مصدر_الأسماء >= (الطول(سياق_المصادر.المصادر) مثل طبيعي)) {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                    «source», سبب_تشخيص.سبب_مصدر_بحث_مفقود_اسم_مصدر()
                )
            );
        };
        دع مصدر_الأسماء: &مصدر = &سياق_المصادر.المصادر[معرف_مصدر_الأسماء];
        لو ((*مصدر_الأسماء).المعرف != معرف_مصدر_الأسماء) {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                    «source», سبب_تشخيص.سبب_مصدر_بحث_مفقود_اسم_مصدر()
                )
            );
        };
        طابق ابن_دلالة_أسماء_وحدة_من_تصريحات(
            &متغير سياق_الأسماء,
            &الرسم,
            الوحدات[ف].الوحدة,
            شجرة_الأسماء,
            مصدر_الأسماء,
            &التصريحات_المجمعة[ف]
        ) مع
        | نتيجة_دلالة_أسماء_وحدة.مكتملة({
            الوحدة: _, الروابط: روابط_الدلالة
        }) -> {
            أصدر_تحذيرات_تهجئات_مربوطة(
                &روابط_الدلالة.التهجئات_المهجورة, &سياق_المصادر, &متغير تشخيصات_الأدوات
            );
            // Transfer the completed binding context, not a deep copy of its
            // resolved occurrences. It has no remaining Name-phase consumer.
            ضع_روابط_وحدة_واجهة(&متغير روابط_الوحدات, ف, روابط_الدلالة);
            لو (معرفا_وحدة_متساويان(الوحدات[ف].الوحدة, الجذر)) {
                شجرة_الجذر := اختياري.موجود(الوحدات[ف].الشجرة);
                رمز_بدء_البرنامج := رمز_بدء_البرنامج_من_تصريحات(
                    &سياق_الأسماء, &التصريحات_المجمعة[ف]
                );
            };
        }
        | نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                    «name», سبب_تشخيص.سبب_اسم_حل_مجهول_وحدة()
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.مصدر_غير_مطابق -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                    «name», سبب_تشخيص.سبب_اسم_حل_مصدر_عدم_تطابق()
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.تصريح_مكرر(الموجود, النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_تصريح_مكرر_مفصلة(
                    &سياق_الأسماء, &سياق_المصادر, الموجود, النطاق
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.اسم_مفقود(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_اسم_مفقود_أو_لهدف_آخر(
                    &سياق_المصادر, &أشجار_الوحدات, &المحمل.الهدف, النطاق,
                    سبب_تشخيص.سبب_اسم_حل_مفقود_اسم()
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.اسم_خاص(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_تصريح_خاص(&سياق_المصادر, النطاق, سبب_تشخيص.سبب_اسم_حل_خاص_اسم())
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.اسم_غامض(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.استيراد_غامض(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                    «name», سبب_تشخيص.سبب_اسم_حل_ملتبس_اسم()
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.تعارض_ربط(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.خطأ_سياق_داخلي(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                    «name», سبب_تشخيص.سبب_اسم_حل_ربط_اسم_تعارض()
                )
            );
        };
    }

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    طابق شجرة_الجذر مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
                «frontend», سبب_تشخيص.سبب_واجهة_أمامية_جذر_صياغة_شجرة_مفقود()
            )
        );
    }
    | اختياري.موجود(_) -> {
        طابق ابن_سياقات_أنواع_وحدات(&أشجار_الوحدات, &سياق_الأسماء, &روابط_الوحدات) مع
        | نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع_الجزئية) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_خطأ_أنواع(الخطأ, &سياق_المصادر, &الأنواع_الجزئية, &سياق_الأسماء)
            );
        }
        | نتيجة_بناء_سياقات_أنواع.مبنية({
            الأنواع: الأنواع,
            أنواع_التعبيرات: أنواع_التعبيرات,
            أنواع_الرموز: أنواع_الرموز,
            علاقات_هرم_الأنواع: علاقات_هرم_الأنواع
        }) -> {
            لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
            // The program entry returns nothing or an integer exit status.
            طابق تشخيصات_ناتج_نقطة_الدخول(
                رمز_بدء_البرنامج, &الأنواع, &أنواع_الرموز, &أشجار_الوحدات, &روابط_الوحدات,
                شجرة_الجذر, &سياق_المصادر
            ) مع
            | اختياري.موجود(التشخيصات) -> { أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات); }
            | اختياري.لا_شيء -> { };
            // Raw-pointer operations and raw kernel calls require an explicit unsafe scope.
            طابق أول_عملية_غير_آمنة_في_وحدات(&أشجار_الوحدات, &الأنواع, &أنواع_التعبيرات, &روابط_الوحدات, &سياق_الأسماء) مع
            | اختياري.موجود(نطاق_العملية) -> {
                أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(تشخيصات_فشل_واجهة_عند(
                    معرف_تشخيص.عملية_غير_آمنة(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, نطاق_العملية)
                ));
            }
            | اختياري.لا_شيء -> { };
            // A closure handed to another thread captures only what may cross threads.
            طابق أول_انتهاك_التقاط_خيط_في_وحدات(
                &أشجار_الوحدات, &الأنواع, &أنواع_التعبيرات, &أنواع_الرموز, &روابط_الوحدات, &سياق_الأسماء
            ) مع
            | اختياري.موجود(الانتهاك) -> {
                أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(تشخيصات_انتهاك_التقاط_خيط(
                    &الانتهاك, &سياق_الأسماء, &سياق_المصادر, &الأنواع
                ));
            }
            | اختياري.لا_شيء -> { };
            دع أذرع_غير_قابلة_للوصول: متغير متجه نطاق = [];
            طابق ابن_أنماط_وحدات(
                &أشجار_الوحدات, &سياق_المصادر, &متغير سياق_الأسماء, &روابط_الوحدات,
                &الأنواع, &أنواع_التعبيرات, &متغير أذرع_غير_قابلة_للوصول
            ) مع
            | نتيجة_أنماط_وحدة.مرفوضة(الخطأ) -> {
                أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.أنماط(الخطأ), &سياق_المصادر));
            }
            | نتيجة_أنماط_وحدة.مكتملة({
                الأنماط: الأنماط,
                التحققات: التحققات
            }) -> {
                لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
                أصدر_تحذيرات_أذرع_غير_قابلة_للوصول(
                    &أذرع_غير_قابلة_للوصول, &سياق_المصادر, &متغير تشخيصات_الأدوات
                );
                // Memory and SSF borrow canonical Type/Pattern contexts in place.
                // No flattened Type/Pattern copies are manufactured between phases.
                طابق ابن_ذاكرة_وحدة(&الأنواع) مع
                | نتيجة_ذاكرة_وحدة.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                        تشخيصات_خطأ_ذاكرة(الخطأ, &الأنواع, &سياق_الأسماء)
                    );
                }
                | نتيجة_ذاكرة_وحدة.مكتملة(سياق_الذاكرة_المبني) -> {
                    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
                    // SSF records inferred plain bounds of Type parameters here.
                    دع سياق_الذاكرة: متغير سياق_ذاكرة_وحدة = سياق_الذاكرة_المبني;
                    طابق ابن_تدفق_سلامة_وحدات(
                        &أشجار_الوحدات,
                        &سياق_الأسماء,
                        &روابط_الوحدات,
                        &متغير سياق_الذاكرة,
                        &الأنواع,
                        &أنواع_الرموز,
                        &أنواع_التعبيرات,
                        &الأنماط,
                        &التحققات
                    ) مع
                    | نتيجة_تدفق_سلامة_وحدة.حقيقة_دلالية_مفقودة(النطاق) -> {
                        طابق مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق) مع
                        | اختياري.موجود(الاعتماد) -> {
                            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                                تشخيصات_فشل_واجهة_مفصلة_مشتقة(
                                    معرف_تشخيص.حقيقة_دلالية_مفقودة(),
                                    مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                                    الاعتماد, «ssf», سبب_تشخيص.سبب_تدفق_سلامة_دلالي_حقيقة_مفقود()
                                )
                            );
                        }
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                                تشخيصات_فشل_واجهة_مفصلة(
                                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                                    «ssf», سبب_تشخيص.سبب_تدفق_سلامة_دلالي_حقيقة_مفقود()
                                )
                            );
                        };
                    }
                    | نتيجة_تدفق_سلامة_وحدة.مرفوضة(الأخطاء) -> {
                        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
                        دع ف_خطأ: متغير طبيعي = 0;
                        طالما (ف_خطأ < (الطول(الأخطاء) مثل طبيعي)) {
                            دع تشخيصات_الخطأ: مجموعة_تشخيصات = تشخيصات_خطأ_تدفق_سلامة(
                                الأخطاء[ف_خطأ], &سياق_الأسماء, &سياق_المصادر, &الأنواع
                            );
                            ادمج_مجموعة_تشخيصات(&متغير المجموعة, &تشخيصات_الخطأ);
                            ف_خطأ := ف_خطأ + 1;
                        }
                        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(المجموعة);
                    }
                    | نتيجة_تدفق_سلامة_وحدة.مكتملة({ مكتمل: _, حقائق_الملكية: حقائق_الملكية }) -> {
                        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
                        // Name facts are always retained: diagnostics after the frontend
                        // (MSIR lowering) print named Types with them. The vectors are
                        // moved, not copied.
                        دع كاملة_دلاليا: منطقي = !يجب_فشل_الترجمة(&تشخيصات_الأدوات);
                        طابق استخلص_حقائق_أسماء_مستمرة(سياق_الأسماء, صواب) مع
                        | { هويات_البدائيات: هويات_البدائيات, استعلامات: استعلامات_الأسماء } -> {
                            دع سياقات_الأنواع_النهائية: سياقات_أنواع_وحدة = {
                                الأنواع: الأنواع,
                                أنواع_التعبيرات: أنواع_التعبيرات,
                                أنواع_الرموز: أنواع_الرموز,
                                علاقات_هرم_الأنواع: علاقات_هرم_الأنواع
                            };
                            دع سياق_الأنماط_النهائي: سياق_أنماط_وحدة = {
                                الأنماط: الأنماط,
                                التحققات: التحققات
                            };
                            دع الوحدات_الدلالية: متجه وحدة_دلالية = الوحدات_الدلالية_للرسم(&الرسم);
                            دع فهرس_التصريحات: فهرس_تصريحات = ابن_فهرس_تصريحات(
                                &أشجار_الوحدات, &روابط_الوحدات
                            );
                            // Borrow the trees, bindings and sources before the
                            // record below takes ownership of them.
                            دع أصل_نواة_لينكس: اختياري أصل_نواة_موثق_واجهة = استخلص_أصل_نواة_واجهة(
                                البيئة_المدخلة, &المحمل, &الوحدات,
                                &أشجار_الوحدات, &روابط_الوحدات, &سياق_المصادر
                            );
                            دع رموز_لا_تعود: متجه معرف_رمز = استخلص_رموز_لا_تعود_واجهة(
                                البيئة_المدخلة, &المحمل, &الوحدات,
                                &أشجار_الوحدات, &روابط_الوحدات, &سياق_المصادر
                            );
                            دع رموز_التنسيق: متجه معرف_رمز = استخلص_رموز_تنسيق_واجهة(
                                البيئة_المدخلة, &المحمل, &الوحدات,
                                &أشجار_الوحدات, &روابط_الوحدات, &سياق_المصادر
                            );
                            دع الناتج: نتيجة_واجهة_وحدة = {
                                الوحدات: أشجار_الوحدات,
                                أصل_نواة_لينكس: أصل_نواة_لينكس,
                                رموز_لا_تعود: رموز_لا_تعود,
                                رموز_التنسيق: رموز_التنسيق,
                                الوحدات_الدلالية: الوحدات_الدلالية,
                                خريطة_المصادر: سياق_المصادر,
                                هويات_البدائيات: هويات_البدائيات,
                                روابط_الأسماء: روابط_الوحدات,
                                فهرس_التصريحات: فهرس_التصريحات,
                                استعلامات_الأسماء: استعلامات_الأسماء,
                                رمز_بدء_البرنامج: رمز_بدء_البرنامج,
                                سياقات_الأنواع: سياقات_الأنواع_النهائية,
                                سياق_الأنماط: سياق_الأنماط_النهائي,
                                كاملة_دلاليا: كاملة_دلاليا,
                                تشخيصات_الأدوات: تشخيصات_الأدوات,
                                حقائق_الملكية: حقائق_الملكية
                            };
                            أرجع نتيجة_بناء_واجهة_وحدة.مكتملة(الناتج);
                        };
                    };
                };
            };
        };
    };
}

عام عرف ابن_واجهة_وحدة(
    الطلب: طلب_واجهة_وحدة
): نتيجة_بناء_واجهة_وحدة {
    دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &الطلب.المفتاح_الجذري;
    دع الإضافية: متجه مفتاح_وحدة_مقنن = [];
    دع الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    أرجع ابن_واجهة_داخلية(
        مرجع_البيئة, مرجع_المفتاح, &الإضافية,
        اختياري.لا_شيء(), الطلب.احتفظ_بحقائق_الأدوات, &الإلغاء
    );
}

// Project discovery may enumerate filesystem candidates, but semantic project
// membership is owned by the canonical Module graph.  A candidate belongs to the
// anchored project when its import closure reaches the anchor.  Forward dependencies
// of the anchor are already loaded by the normal module closure and need not become
// additional roots.
نوع نتيجة_اختيار_جذور_مشروع =
    | مكتملة بنوع متجه مفتاح_وحدة_مقنن
    | مرفوضة بنوع مجموعة_تشخيصات
;

عرف وحدة_رسم_تصل_إلى(
    الرسم: &رسم_وحدات,
    البداية: معرف_وحدة,
    الهدف: معرف_وحدة
): منطقي {
    لو (البداية.القيمة == الهدف.القيمة) { أرجع صواب; };
    دع العدد: طبيعي = (*الرسم).معرف_الوحدة_التالي;
    لو (البداية.القيمة >= العدد || الهدف.القيمة >= العدد) { أرجع خطأ; };

    دع المزارة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(المزارة, خطأ);
        ف := ف + 1;
    }
    دع الطابور: متغير متجه معرف_وحدة = [];
    ألحق(الطابور, البداية);
    المزارة[البداية.القيمة] := صواب;

    دع موضع: متغير طبيعي = 0;
    طالما (موضع < (الطول(الطابور) مثل طبيعي)) {
        دع الحالي: معرف_وحدة = الطابور[موضع];
        دع ح: متغير طبيعي = 0;
        دع عدد_الاستيرادات: طبيعي = عدد_استيرادات_الوحدة(الرسم, الحالي);
        طالما (ح < عدد_الاستيرادات) {
            دع التالي: معرف_وحدة = استيراد_الوحدة_عند(الرسم, الحالي, ح);
            لو (التالي.القيمة == الهدف.القيمة) { أرجع صواب; };
            لو (التالي.القيمة < العدد && !المزارة[التالي.القيمة]) {
                المزارة[التالي.القيمة] := صواب;
                ألحق(الطابور, التالي);
            };
            ح := ح + 1;
        }
        موضع := موضع + 1;
    }
    أرجع خطأ;
}

عرف اختر_جذور_مشروع_مرتبطة(
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    المفاتيح_المدخلة: &متجه مفتاح_وحدة_مقنن,
    استرداد_الأدوات: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_اختيار_جذور_مشروع {
    لو (هل_واجهة_ملغاة(الإلغاء)) {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(), «frontend», سبب_تشخيص.سبب_واجهة_أمامية_ملغى()
        ));
    };
    دع قيمة_المفاتيح_المدخلة: متجه مفتاح_وحدة_مقنن = *المفاتيح_المدخلة;
    لو ((الطول(قيمة_المفاتيح_المدخلة) مثل طبيعي) == 0) {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
                «frontend», سبب_تشخيص.سبب_واجهة_أمامية_مشروع_بلا_جذور()
            )
        );
    };

    دع سياق_المصادر: متغير خريطة_مصادر = خريطة_مصادر_جديدة();
    دع سياق_الأسماء: متغير سياق_أسماء = سياق_أسماء_جديد();
    دع الرسم: متغير رسم_وحدات = رسم_وحدات_جديد();
    دع المحمل: متغير محمل_وحدات = محمل_وحدات_جديد();
    دع الوحدات: متغير متجه وحدة_نحوية_محملة = [];
    دع أشجار_الوحدات: متغير متجه وحدة_مصدر = [];
    دع الوحدات_المسجلة: متغير متجه منطقي = [];
    دع تشخيصات_اختيار_الأدوات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();

    دع مرجع_المفتاح_الأساسي: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح_المدخلة[0];
    دع الجذر: متغير معرف_وحدة = معرف_وحدة_من(0);
    طابق حمل_وحدة_جذر(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        البيئة_المدخلة,
        مرجع_المفتاح_الأساسي
    ) مع
    | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(
            تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.تحميل(الخطأ), &سياق_المصادر)
        );
    }
    | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
        الجذر := المحملة.الوحدة;
    };

    // The anchor and its forward dependencies are mandatory project members.
    // Their load/parse failures are canonical project failures, not candidates to ignore.
    طابق حلل_وحدة_محملة_مع_استيراداتها(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        البيئة_المدخلة,
        الجذر,
        &متغير الوحدات,
        &متغير أشجار_الوحدات,
        &متغير الوحدات_المسجلة,
        استرداد_الأدوات,
        &متغير تشخيصات_اختيار_الأدوات,
        الإلغاء,
        خطأ
    ) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(
            تشخيصات_خطأ_واجهة(الخطأ, &سياق_المصادر)
        );
    }
    | _ -> { };

    // Parse candidate roots through the canonical lexer/parser/module loader solely
    // to build import relationships.  Candidate-local failures are deferred unless
    // a relationship to the anchored project is established; the final strict build
    // then reports the canonical structured diagnostic for project members.
    دع ف: متغير طبيعي = 1;
    طالما (ف < (الطول(قيمة_المفاتيح_المدخلة) مثل طبيعي)) {
        لو (هل_واجهة_ملغاة(الإلغاء)) {
            أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(), «frontend», سبب_تشخيص.سبب_واجهة_أمامية_ملغى()
            ));
        };
        دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح_المدخلة[ف];
        طابق حمل_وحدة_جذر(
            &متغير المحمل,
            &متغير سياق_المصادر,
            &متغير سياق_الأسماء,
            &متغير الرسم,
            البيئة_المدخلة,
            مرجع_المفتاح
        ) مع
        | نتيجة_تحميل_وحدة.خطأ(_) -> { }
        | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
            دع خطأ_مرشح: اختياري خطأ_واجهة_وحدة = حلل_وحدة_محملة_مع_استيراداتها(
                &متغير المحمل,
                &متغير سياق_المصادر,
                &متغير سياق_الأسماء,
                &متغير الرسم,
                البيئة_المدخلة,
                المحملة.الوحدة,
                &متغير الوحدات,
                &متغير أشجار_الوحدات,
                &متغير الوحدات_المسجلة,
                استرداد_الأدوات,
                &متغير تشخيصات_اختيار_الأدوات,
                الإلغاء,
                خطأ
            );
        };
        ف := ف + 1;
    }

    دع المرتبطة: متغير متجه مفتاح_وحدة_مقنن = [];
    ف := 1;
    طالما (ف < (الطول(قيمة_المفاتيح_المدخلة) مثل طبيعي)) {
        دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح_المدخلة[ف];
        طابق وحدة_محملة_بالمفتاح(&المحمل, مرجع_المفتاح) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المحملة) -> {
            لو (وحدة_رسم_تصل_إلى(&الرسم, المحملة.الوحدة, الجذر)) {
                ألحق(المرتبطة, انسخ_مفتاح_وحدة_مقنن(مرجع_المفتاح));
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة_اختيار_جذور_مشروع.مكتملة(المرتبطة);
}

عام عرف ابن_واجهة_مشروع(
    الطلب: طلب_واجهة_مشروع
): نتيجة_بناء_واجهة_وحدة {
    دع الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    دع مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الطلب.المفاتيح_الجذرية;
    دع قيمة_المفاتيح: متجه مفتاح_وحدة_مقنن = *مرجع_المفاتيح;
    لو ((الطول(قيمة_المفاتيح) مثل طبيعي) == 0) {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
                «frontend», سبب_تشخيص.سبب_واجهة_أمامية_مشروع_بلا_جذور()
            )
        );
    };
    دع مرجع_الأساسي: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح[0];
    طابق اختر_جذور_مشروع_مرتبطة(مرجع_البيئة, مرجع_المفاتيح, الطلب.احتفظ_بحقائق_الأدوات, &الإلغاء) مع
    | نتيجة_اختيار_جذور_مشروع.مرفوضة(التشخيصات) -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات);
    }
    | نتيجة_اختيار_جذور_مشروع.مكتملة(الإضافية) -> {
        أرجع ابن_واجهة_داخلية(
            مرجع_البيئة, مرجع_الأساسي, &الإضافية,
            اختياري.لا_شيء(), الطلب.احتفظ_بحقائق_الأدوات, &الإلغاء
        );
    };
}

// Compiler-owned cancellable entry points for IDE/tooling consumers. Protocol code
// supplies a token; frontend phases only observe it at cooperative checkpoints.
// The driver supplies the selected target for compile-time source decisions,
// and any compiler-required module roots (for example the std process-exit
// provider of a self-started executable); they join the same module graph.
// Tooling callers continue to use the target-neutral interface unchanged.
عام عرف ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(
    الطلب: طلب_واجهة_وحدة,
    الهدف: اختياري واصف_هدف,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
    دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &الطلب.المفتاح_الجذري;
    طابق ابن_واجهة_داخلية(
        مرجع_البيئة, مرجع_المفتاح, المفاتيح_الإضافية,
        الهدف, الطلب.احتفظ_بحقائق_الأدوات, الإلغاء
    ) مع
    | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة);
    }
    | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
    };
}

عام عرف ابن_واجهة_وحدة_قابلة_للإلغاء(
    الطلب: طلب_واجهة_وحدة,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    دع الإضافية: متجه مفتاح_وحدة_مقنن = [];
    أرجع ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(
        الطلب, اختياري.لا_شيء(), &الإضافية, الإلغاء
    );
}

عام عرف ابن_واجهة_مشروع_قابلة_للإلغاء(
    الطلب: طلب_واجهة_مشروع,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
    دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    دع مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الطلب.المفاتيح_الجذرية;
    دع قيمة_المفاتيح: متجه مفتاح_وحدة_مقنن = *مرجع_المفاتيح;
    لو ((الطول(قيمة_المفاتيح) مثل طبيعي) == 0) {
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(), «frontend», سبب_تشخيص.سبب_واجهة_أمامية_مشروع_بلا_جذور()
        ));
    };
    دع مرجع_الأساسي: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح[0];
    طابق اختر_جذور_مشروع_مرتبطة(
        مرجع_البيئة, مرجع_المفاتيح, الطلب.احتفظ_بحقائق_الأدوات, الإلغاء
    ) مع
    | نتيجة_اختيار_جذور_مشروع.مرفوضة(التشخيصات) -> {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
    }
    | نتيجة_اختيار_جذور_مشروع.مكتملة(الإضافية) -> {
        طابق ابن_واجهة_داخلية(
            مرجع_البيئة, مرجع_الأساسي, &الإضافية,
            اختياري.لا_شيء(), الطلب.احتفظ_بحقائق_الأدوات, الإلغاء
        ) مع
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
            لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
            أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة);
        }
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
            لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
            أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
        };
    };
}

// General semantic point-query surface for tooling/compiler consumers.
عام عرف مصدر_واجهة_بمعرف(
    الواجهة: &نتيجة_واجهة_وحدة,
    المعرف: طبيعي
): اختياري مصدر {
    أرجع مصدر_محمل_بالمعرف(&(*الواجهة).خريطة_المصادر, المعرف);
}

عام عرف اسم_مصدر_واجهة_بمعرف(
    الواجهة: &نتيجة_واجهة_وحدة,
    المعرف: طبيعي
): اختياري نص {
    طابق مصدر_واجهة_بمعرف(الواجهة, المعرف) مع
    | اختياري.موجود(المصدر) -> {
        دع مرجع_الاسم: &نص = &المصدر.الاسم;
        دع الاسم: نص = انسخ_نص(مرجع_الاسم);
        أرجع اختياري.موجود(الاسم);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف معرف_مصدر_واجهة_باسم(
    الواجهة: &نتيجة_واجهة_وحدة,
    الاسم: &نص
): اختياري طبيعي {
    دع مرجع_الخريطة: &خريطة_مصادر = &(*الواجهة).خريطة_المصادر;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*مرجع_الخريطة).المصادر) مثل طبيعي)) {
        دع المصدر: &مصدر = &(*مرجع_الخريطة).المصادر[ف];
        لو (نصان_متساويان(&(*المصدر).الاسم, الاسم)) {
            أرجع اختياري.موجود((*المصدر).المعرف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ظهور_اسم_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري ظهور_اسم_محلول {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        لو ((*الواجهة).الوحدات[ف].معرف_المصدر == المصدر) {
            لو (ف >= (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع ظهور_اسم_محلول_عند_بايت(&(*الواجهة).روابط_الأسماء[ف], المصدر, البايت);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف رمز_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري معرف_رمز {
    طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
    | اختياري.موجود(الظهور) -> { أرجع الظهور.الرمز; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف تصريح_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختياري رمز_دلالي {
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.موجود(الاستعلامات) -> {
        أرجع رمز_دلالي_عند_استعلام(&الاستعلامات, الرمز);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف ظهورات_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه ظهور_اسم_محلول {
    دع الناتج: متغير متجه ظهور_اسم_محلول = [];
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
        دع مرجع_الروابط: &سياق_روابط_أسماء = &(*الواجهة).روابط_الأسماء[و];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_الروابط).الظهورات) مثل طبيعي)) {
            دع مرجع_الظهور: &ظهور_اسم_محلول = &(*مرجع_الروابط).الظهورات[ف];
            طابق (*مرجع_الظهور).الرمز مع
            | اختياري.موجود(المعرف) -> {
                لو (معرفا_رمز_متساويان(المعرف, الرمز)) { ألحق(الناتج, *مرجع_الظهور); };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    أرجع الناتج;
}

عام عرف نوع_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختياري معرف_نوع {
    أرجع نوع_رمز_دلالي_عند(&(*الواجهة).سياقات_الأنواع.أنواع_الرموز, الرمز);
}

عام عرف نوع_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري معرف_نوع {
    طابق رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
    | اختياري.موجود(الرمز) -> {
        طابق نوع_رمز_دلالي_عند(&(*الواجهة).سياقات_الأنواع.أنواع_الرموز, الرمز) مع
        | اختياري.موجود(النوع) -> { أرجع اختياري.موجود(النوع); }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        لو ((*الواجهة).الوحدات[ف].معرف_المصدر == المصدر) {
            لو (ف >= (الطول((*الواجهة).سياقات_الأنواع.أنواع_التعبيرات) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع نوع_تعبير_عند_بايت(&(*الواجهة).سياقات_الأنواع.أنواع_التعبيرات[ف], المصدر, البايت);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف استدعاء_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري استعلام_استدعاء_دلالي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        لو ((*الواجهة).الوحدات[ف].معرف_المصدر == المصدر) {
            لو (ف >= (الطول((*الواجهة).سياقات_الأنواع.أنواع_التعبيرات) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع استدعاء_عند_بايت(&(*الواجهة).سياقات_الأنواع.أنواع_التعبيرات[ف], المصدر, البايت);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف عدد_معاملات_نوع_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع
): اختياري طبيعي {
    أرجع عدد_معاملات_دالة_دلالية(&(*الواجهة).سياقات_الأنواع.الأنواع, النوع);
}

عام عرف نوع_معامل_نوع_واجهة_عند(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    أرجع نوع_معامل_دالة_دلالي_عند(&(*الواجهة).سياقات_الأنواع.الأنواع, النوع, الفهرس);
}

عام عرف روابط_مرئية_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): متجه ربط_اسم_نطاق {
    دع الناتج: متغير متجه ربط_اسم_نطاق = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الاستعلامات) -> {
        أرجع روابط_مرئية_عند_استعلام(&الاستعلامات, المصدر, البايت);
    };
}

عام عرف اسم_مقنن_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الاسم: معرف_اسم
): اختياري اسم_مقنن {
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاستعلامات) -> {
        أرجع اسم_مقنن_عند_استعلام(&الاستعلامات, الاسم);
    };
}


عام عرف حضر_إعادة_تسمية_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): نتيجة_تحضير_إعادة_تسمية_دلالية {
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختياري.موجود(الاستعلامات) -> {
        طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | اختياري.موجود(الظهور) -> {
            أرجع حضر_إعادة_تسمية_دلالية(&الاستعلامات, &الظهور);
        };
    };
}

عام عرف خطط_إعادة_تسمية_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي,
    الاسم_الجديد: &نص
): نتيجة_خطة_إعادة_تسمية_دلالية {
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختياري.موجود(الاستعلامات) -> {
        طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | اختياري.موجود(الظهور) -> {
            طابق حضر_إعادة_تسمية_دلالية(&الاستعلامات, &الظهور) مع
            | نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(السبب) -> {
                أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(السبب);
            }
            | نتيجة_تحضير_إعادة_تسمية_دلالية.جاهز(الهدف) -> {
                أرجع خطط_إعادة_تسمية_دلالية(
                    &الاستعلامات, الهدف, الاسم_الجديد, &(*الواجهة).روابط_الأسماء
                );
            };
        };
    };
}


عام عرف تهجئة_نوع_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع
): اختياري نص {
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأسماء) -> {
        أرجع تهجئة_عرض_نوع_دلالي(&(*الواجهة).سياقات_الأنواع.الأنواع, &الأسماء, النوع);
    };
}

عام عرف تهجئة_نوع_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري نص {
    طابق نوع_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> { أرجع تهجئة_نوع_واجهة(الواجهة, النوع); };
}

// General tooling queries over canonical Name facts retained by a tooling
// Frontend request. They expose classification/enumeration without exposing
// Name storage ownership to protocol consumers.
عام عرف ظهورات_مصنفة_واجهة_لمصدر(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي
): متجه ظهور_مصنف_دلاليا {
    دع الناتج: متغير متجه ظهور_مصنف_دلاليا = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
            لو ((*الواجهة).الوحدات[ف].معرف_المصدر == المصدر) {
                لو (ف < (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
                    أرجع صنف_ظهورات_مصدر_عند_استعلام(
                        &الأسماء, &(*الواجهة).روابط_الأسماء[ف], المصدر
                    );
                };
                أرجع الناتج;
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

عام عرف رموز_واجهة_لمصدر(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي
): متجه رمز_دلالي {
    دع الناتج: متغير متجه رمز_دلالي = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> { أرجع رموز_مصدر_عند_استعلام(&الأسماء, المصدر); };
}

عام عرف كل_رموز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة
): متجه رمز_دلالي {
    دع الناتج: متغير متجه رمز_دلالي = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> { أرجع كل_الرموز_عند_استعلام(&الأسماء); };
}

// Tooling-neutral call graph edge composed from Type-owned resolved call facts
// and Name-owned enclosing function declaration facts.
عام نوع حافة_استدعاء_دلالية = {
    المستدعي: معرف_رمز,
    المستدعى: معرف_رمز,
    النطاق: نطاق
};

عام عرف حواف_استدعاء_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة
): متجه حافة_استدعاء_دلالية {
    دع الناتج: متغير متجه حافة_استدعاء_دلالية = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الاستعلامات) -> {
        دع و: متغير طبيعي = 0;
        طالما (و < (الطول((*الواجهة).سياقات_الأنواع.أنواع_التعبيرات) مثل طبيعي)) {
            دع مرجع_السياق: &سياق_أنواع_تعبيرات = &(*الواجهة).سياقات_الأنواع.أنواع_التعبيرات[و];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*مرجع_السياق).الاستدعاءات) مثل طبيعي)) {
                دع مرجع_الاستدعاء: &حقيقة_استدعاء_نوعية = &(*مرجع_السياق).الاستدعاءات[ف];
                طابق (*مرجع_الاستدعاء).الرمز مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(المستدعى) -> {
                    دع المصدر: طبيعي = (*مرجع_الاستدعاء).النطاق.البداية.المصدر;
                    دع البايت: طبيعي = (*مرجع_الاستدعاء).النطاق.البداية.البايت;
                    طابق رمز_دالة_حاوية_عند_استعلام(&الاستعلامات, المصدر, البايت) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(المستدعي) -> {
                        دع نطاق_الاستدعاء: نطاق = (*مرجع_الاستدعاء).النطاق;
                        دع الحافة: حافة_استدعاء_دلالية = {
                            المستدعي: المستدعي,
                            المستدعى: المستدعى,
                            النطاق: نطاق_الاستدعاء
                        };
                        ألحق(الناتج, الحافة);
                    };
                };
                ف := ف + 1;
            }
            و := و + 1;
        }
        أرجع الناتج;
    };
}

عام عرف استدعاءات_صادرة_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه حافة_استدعاء_دلالية {
    دع الناتج: متغير متجه حافة_استدعاء_دلالية = [];
    دع الحواف: متجه حافة_استدعاء_دلالية = حواف_استدعاء_واجهة(الواجهة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحواف) مثل طبيعي)) {
        دع الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        لو (معرفا_رمز_متساويان(الحافة.المستدعي, الرمز)) { ألحق(الناتج, الحافة); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف استدعاءات_واردة_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه حافة_استدعاء_دلالية {
    دع الناتج: متغير متجه حافة_استدعاء_دلالية = [];
    دع الحواف: متجه حافة_استدعاء_دلالية = حواف_استدعاء_واجهة(الواجهة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحواف) مثل طبيعي)) {
        دع الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        لو (معرفا_رمز_متساويان(الحافة.المستدعى, الرمز)) { ألحق(الناتج, الحافة); };
        ف := ف + 1;
    }
    أرجع الناتج;
}


// Canonical type-hierarchy relations. SultanC currently has no nominal inheritance;
// type-alias declarations are the language's explicit named type relation. The Type
// layer records the direct source relation before alias canonicalization erases it.
عام عرف أنواع_عليا_لرمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه معرف_رمز {
    دع الناتج: متغير متجه معرف_رمز = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).سياقات_الأنواع.علاقات_هرم_الأنواع) مثل طبيعي)) {
        دع العلاقة: علاقة_هرم_نوع = (*الواجهة).سياقات_الأنواع.علاقات_هرم_الأنواع[ف];
        لو (معرفا_رمز_متساويان(العلاقة.النوع_الفرعي, الرمز)) {
            ألحق(الناتج, العلاقة.النوع_العلوي);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنواع_فرعية_لرمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه معرف_رمز {
    دع الناتج: متغير متجه معرف_رمز = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).سياقات_الأنواع.علاقات_هرم_الأنواع) مثل طبيعي)) {
        دع العلاقة: علاقة_هرم_نوع = (*الواجهة).سياقات_الأنواع.علاقات_هرم_الأنواع[ف];
        لو (معرفا_رمز_متساويان(العلاقة.النوع_العلوي, الرمز)) {
            ألحق(الناتج, العلاقة.النوع_الفرعي);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_منشئ_نواة_موثق_واجهة(القيمة: &متجه منشئ_نواة_موثق_واجهة): متجه منشئ_نواة_موثق_واجهة {
    دع الناتج: متغير متجه منشئ_نواة_موثق_واجهة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_منشئ_نواة_موثق_واجهة(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_منشئ_نواة_موثق_واجهة(القيمة: &منشئ_نواة_موثق_واجهة): منشئ_نواة_موثق_واجهة {
    دع الناتج: منشئ_نواة_موثق_واجهة = {
        الرمز: (*القيمة).الرمز,
        الاسم: انسخ_نص(&(*القيمة).الاسم),
        الترتيب: (*القيمة).الترتيب,
        التوقيع: انسخ_مملوكا_توقيع_نداء_بدائي(&(*القيمة).التوقيع)
    };
    أرجع الناتج;
}
