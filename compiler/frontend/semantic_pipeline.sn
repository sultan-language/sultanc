        );
        دع بلا_حجج: متجه حجة_تشخيص = [];
        طابق الاستعمال مع
        | صنف_استعمال_معتم.حقل -> {
            // The span is the field name as written. No help: there is no
            // field to reach.
            أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, النطاق, مفتاح_حجة_تشخيص.الرمز());
        }
