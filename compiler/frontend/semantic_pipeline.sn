عام نوع وحدة_نحوية_محملة = { الوحدة: معرف_وحدة, الشجرة: طبيعي };

// Only source declarations actually loaded under the Driver-resolved standard
// library RootID may provide Linux operation symbols. The operation names and
// tags are source facts; a caller cannot opt into this evidence through an
// import spelling, pathname suffix, or a syscall number.
عام نوع منشئ_نواة_موثق_واجهة = {
    الرمز: معرف_رمز,
    الاسم: نص,
    الترتيب: طبيعي,
    التوقيع: توقيع_نداء_بدائي
};

عام نوع أصل_نواة_موثق_واجهة = {
    المنتقي: معرف_رمز,
    المنشئات: متجه منشئ_نواة_موثق_واجهة
};

// Converts ABI effects only. Does not manufacture operation identity.
عرف حوّل_توقيع_لينكس_إلى_بدائي(المصدر: &توقيع_نداء_نواة_لينكس): اختياري توقيع_نداء_بدائي {
    إذا ((الطول((*المصدر).الأدوار) مثل طبيعي) != 6) { أرجع اختياري.لا_شيء(); };
    ليكن الأدوار: متغير متجه دور_وسيطة_بدائي = [];
    ليكن الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 6) {
        ليكن الدور: دور_وسيطة_بدائي;
        طابق (*المصدر).الأدوار[الفهرس] مع
        | دور_وسيطة_نواة_لينكس.عدد -> { الدور := دور_وسيطة_بدائي.عدد(); }
        | دور_وسيطة_نواة_لينكس.غير_مستخدم -> { الدور := دور_وسيطة_بدائي.غير_مستخدم(); }
        | دور_وسيطة_نواة_لينكس.مخزن(الاتجاه, الحد) -> {
            ليكن اتجاه_الناتج: اتجاه_وصول_بدائي;
            طابق الاتجاه مع
            | اتجاه_ذاكرة_نواة_لينكس.قراءة -> { اتجاه_الناتج := اتجاه_وصول_بدائي.قراءة(); }
            | اتجاه_ذاكرة_نواة_لينكس.كتابة -> { اتجاه_الناتج := اتجاه_وصول_بدائي.كتابة(); }
            | اتجاه_ذاكرة_نواة_لينكس.قراءة_وكتابة -> { اتجاه_الناتج := اتجاه_وصول_بدائي.قراءة_وكتابة(); };
            ليكن حد_الناتج: حد_وصول_بدائي;
            طابق الحد مع
            | حد_ذاكرة_نواة_لينكس.وسيطة(الموضع) -> { حد_الناتج := حد_وصول_بدائي.وسيطة(الموضع); }
            | حد_ذاكرة_نواة_لينكس.ثابت(العدد) -> { حد_الناتج := حد_وصول_بدائي.ثابت(العدد); }
            | حد_ذاكرة_نواة_لينكس.سلسلة_صفرية -> { حد_الناتج := حد_وصول_بدائي.سلسلة_صفرية(); };
            الدور := دور_وسيطة_بدائي.مخزن(اتجاه_الناتج, حد_الناتج);
        };
        ألحق(الأدوار, الدور);
        الفهرس := الفهرس + 1;
    }
    ليكن النسخ: نسخ_نتيجة_بدائي;
    طابق (*المصدر).النسخ مع
    | أثر_نتيجة_نواة_لينكس.بلا_نسخ -> { النسخ := نسخ_نتيجة_بدائي.بلا_نسخ(); }
    | أثر_نتيجة_نواة_لينكس.عدد_بايتات_النتيجة -> { النسخ := نسخ_نتيجة_بدائي.عدد_بايتات_النتيجة(); }
    | أثر_نتيجة_نواة_لينكس.كامل_عند_النجاح -> { النسخ := نسخ_نتيجة_بدائي.كامل_عند_النجاح(); }
    | أثر_نتيجة_نواة_لينكس.كامل_عند_المقاطعة -> { النسخ := نسخ_نتيجة_بدائي.كامل_عند_المقاطعة(); };
    ليكن التوقيع: توقيع_نداء_بدائي = { الأدوار: الأدوار, النسخ: النسخ };
    أرجع اختياري.موجود(التوقيع);
}

عرف بايتات_اسم_مقنن_واجهة(المصدر: &مصدر, النطاق: نطاق): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن البداية: طبيعي = النطاق.البداية.البايت;
    ليكن النهاية: طبيعي = النطاق.النهاية.البايت;
    ليكن العدد: طبيعي = الطول((*المصدر).المحتوى) مثل طبيعي;
    إذا (النهاية > العدد || البداية >= النهاية) { أرجع الناتج; };
    ليكن موضع: متغير طبيعي = البداية;
    طالما (موضع < النهاية) {
        ألحق(الناتج, (*المصدر).المحتوى[موضع]);
        موضع := موضع + 1;
    }
    أرجع الناتج;
}

عرف هل_مفتاح_وحدة_نواة_واجهة(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    الجذر: معرف_جذر_مكتبة,
    المسار: &نص
): منطقي {
    // The module may be in a library beneath std (alloc, core): any root of
    // the standard library holds it, at the same path.
    إذا (!معرفا_جذر_مكتبة_متساويان((*المفتاح).الجذر, الجذر)
        && !(جذر_قياسي(البيئة, الجذر) && جذر_قياسي(البيئة, (*المفتاح).الجذر))) {
        أرجع خطأ;
    };
    ليكن البايتات: متجه ط8 = بايتات_نص_بيانات_وحدة(المسار);
    طابق قنن_مسار_وحدة_منطقي(&البايتات) مع
    | نتيجة_مسار_وحدة_منطقي.صالح(المقنن) -> {
        أرجع مسارا_وحدة_منطقيان_متساويان(&(*المفتاح).المسار, &المقنن);
    }
    | نتيجة_مسار_وحدة_منطقي.غير_صالح -> { أرجع خطأ; };
}

عرف عرض_مؤشر_محمل(الهدف: &اختياري واصف_هدف): طبيعي {
    طابق *الهدف مع
    | اختياري.موجود(الوصف) -> { أرجع الوصف.نموذج_البيانات.عرض_المؤشر; }
    | اختياري.لا_شيء -> { أرجع 64; };
}

// Whether the function is the trusted library function الاسم of the module
// المفتاح names: the library's own key, never a spelling a user module can copy.
عرف دالة_مكتبة_موثوقة_واجهة(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    جذر_المكتبة: معرف_جذر_مكتبة,
    المصدر: &مصدر,
    الدالة: &تصريح_دالة,
    اسم_الوحدة: نص,
    الاسم: نص
): منطقي {
    أرجع هل_مفتاح_وحدة_نواة_واجهة(البيئة, المفتاح, جذر_المكتبة, &اسم_الوحدة)
        && تطابق_هوية_معرف_وشريحة(
            &(*المصدر).المحتوى, (*الدالة).الاسم.النطاق.البداية.البايت,
            (*الدالة).الاسم.النطاق.النهاية.البايت, الاسم
        );
}

// The functions that never return (docs/en/reference/errors.md), each call of
// which ends its path in a trap: core's إنهيار (process/panic.sn), std's
// process exit اخرج (process/exit.sn), std's runtime-check report
// (process/runtime_check.sn), and the panic handlers: std's
// (process/panic_handler.sn) and every function marked `@@panic_handler`,
// whose own body is checked to end on no path (msir/semantic_lowering.sn).
// The library's are identified like the kernel contract below by
// RootID+ModuleKey, never by a spelling a user module can copy.
عرف استخلص_رموز_لا_تعود_واجهة(
    البيئة: &بيئة_وحدات_منطقية,
    المحمل: &محمل_وحدات,
    الوحدات_المحملة: &متجه وحدة_نحوية_محملة,
    الأشجار: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    المصادر: &خريطة_مصادر
): متجه معرف_رمز {
    ليكن الناتج: متغير متجه معرف_رمز = [];
    ليكن جذر_المكتبة: متغير اختياري معرف_جذر_مكتبة = اختياري.لا_شيء();
    طابق جذر_قياسي_موثوق_لبيئة(البيئة) مع
    | اختياري.موجود(الجذر) -> { جذر_المكتبة := اختياري.موجود(الجذر); }
    | اختياري.لا_شيء -> { };
    ليكن موضع: متغير طبيعي = 0;
    طالما (موضع < (الطول(*الوحدات_المحملة) مثل طبيعي)) {
        ليكن ربط_الوحدة: &وحدة_نحوية_محملة = &(*الوحدات_المحملة)[موضع];
        إذا (((*ربط_الوحدة).الوحدة.القيمة مثل طبيعي) < (الطول((*المحمل).المحملة) مثل طبيعي)
            && (*ربط_الوحدة).الشجرة < (الطول(*الأشجار) مثل طبيعي)
            && موضع < (الطول(*الروابط) مثل طبيعي)) {
            ليكن المحملة: &وحدة_مصدر_محملة = &(*المحمل).المحملة[(*ربط_الوحدة).الوحدة.القيمة];
            ليكن الوحدة: &وحدة_مصدر = &(*الأشجار)[(*ربط_الوحدة).الشجرة];
            إذا ((*المحملة).معرف_المصدر == (*الوحدة).معرف_المصدر) {
                ليكن المصدر: &مصدر = &(*المصادر).المصادر[(*الوحدة).معرف_المصدر];
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
                    طابق (*الوحدة).العناصر[ف] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        ليكن لا_تعود: متغير منطقي = الدالة.معالج_الانهيار;
                        طابق جذر_المكتبة مع
                        | اختياري.موجود(الجذر) -> {
                            لا_تعود := لا_تعود
                                || دالة_مكتبة_موثوقة_واجهة(البيئة, &(*المحملة).المفتاح, الجذر, المصدر, &الدالة, «process/panic.sn», «إنهيار»)
                                || دالة_مكتبة_موثوقة_واجهة(البيئة, &(*المحملة).المفتاح, الجذر, المصدر, &الدالة, «process/exit.sn», «اخرج»)
                                || دالة_مكتبة_موثوقة_واجهة(
                                    البيئة, &(*المحملة).المفتاح, الجذر, المصدر, &الدالة, «process/runtime_check.sn», «فشل_فحص_تشغيل»
                                )
                                || دالة_مكتبة_موثوقة_واجهة(
                                    البيئة, &(*المحملة).المفتاح, الجذر, المصدر, &الدالة, «process/panic_handler.sn», «معالج_انهيار_المكتبة»
                                );
                        }
                        | اختياري.لا_شيء -> { };
                        إذا (لا_تعود) {
                            طابق رمز_اسم_محلول_عند(&(*الروابط)[موضع], الدالة.الاسم.النطاق) مع
                            | اختياري.موجود(الرمز) -> { ألحق(الناتج, الرمز); }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                    ف := ف + 1;
                }
            };
        };
        موضع := موضع + 1;
    }
    أرجع الناتج;
}

// The format functions of the trusted std modules fmt/fmt.sn and io/log.sn
// and std.fmt's compile-time checker (docs/en/reference/formatting.md, "Compile-time check"),
// identified like إنهيار above by RootID+ModuleKey. The first element is the
// checker, تحقق_قالب_تنسيق_وقت_الترجمة; the others are the functions whose
// last two parameters are القالب (the format string) and الوسائط (the
// argument vector). Empty when the checker is not loaded.
عرف استخلص_رموز_تنسيق_واجهة(
    البيئة: &بيئة_وحدات_منطقية,
    المحمل: &محمل_وحدات,
    الوحدات_المحملة: &متجه وحدة_نحوية_محملة,
    الأشجار: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    المصادر: &خريطة_مصادر
): متجه معرف_رمز {
    ليكن الدوال: متغير متجه معرف_رمز = [];
    ليكن المدقق: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    ليكن جذر_المكتبة: معرف_جذر_مكتبة;
    طابق جذر_قياسي_موثوق_لبيئة(البيئة) مع
    | اختياري.موجود(الجذر) -> { جذر_المكتبة := الجذر; }
    | اختياري.لا_شيء -> { أرجع الدوال; };
    ليكن اسم_التنسيق: نص = «fmt/fmt.sn»;
    ليكن اسم_السجل: نص = «io/log.sn»;
    // std.io's printing of formatted text: its format strings are checked like
    // std.fmt's.
    ليكن اسم_الطباعة: نص = «io/print_formatted.sn»;
    ليكن موضع: متغير طبيعي = 0;
    طالما (موضع < (الطول(*الوحدات_المحملة) مثل طبيعي)) {
        ليكن ربط_الوحدة: &وحدة_نحوية_محملة = &(*الوحدات_المحملة)[موضع];
        إذا (((*ربط_الوحدة).الوحدة.القيمة مثل طبيعي) < (الطول((*المحمل).المحملة) مثل طبيعي)
            && (*ربط_الوحدة).الشجرة < (الطول(*الأشجار) مثل طبيعي)
            && موضع < (الطول(*الروابط) مثل طبيعي)) {
            ليكن المحملة: &وحدة_مصدر_محملة = &(*المحمل).المحملة[(*ربط_الوحدة).الوحدة.القيمة];
            ليكن الوحدة: &وحدة_مصدر = &(*الأشجار)[(*ربط_الوحدة).الشجرة];
            ليكن وحدة_التنسيق: منطقي = هل_مفتاح_وحدة_نواة_واجهة(البيئة, &(*المحملة).المفتاح, جذر_المكتبة, &اسم_التنسيق);
            ليكن وحدة_السجل: منطقي = هل_مفتاح_وحدة_نواة_واجهة(البيئة, &(*المحملة).المفتاح, جذر_المكتبة, &اسم_السجل)
                || هل_مفتاح_وحدة_نواة_واجهة(البيئة, &(*المحملة).المفتاح, جذر_المكتبة, &اسم_الطباعة);
            إذا ((وحدة_التنسيق || وحدة_السجل) && (*المحملة).معرف_المصدر == (*الوحدة).معرف_المصدر) {
                ليكن المصدر: &مصدر = &(*المصادر).المصادر[(*الوحدة).معرف_المصدر];
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
                    طابق (*الوحدة).العناصر[ف] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        ليكن العدد: طبيعي = الطول(الدالة.المعاملات) مثل طبيعي;
                        ليكن مختارة: متغير منطقي = خطأ;
                        ليكن مدقق: متغير منطقي = خطأ;
                        إذا (وحدة_التنسيق && تطابق_هوية_معرف_وشريحة(
                            &(*المصدر).المحتوى, الدالة.الاسم.النطاق.البداية.البايت,
                            الدالة.الاسم.النطاق.النهاية.البايت, «تحقق_قالب_تنسيق_وقت_الترجمة»
                        )) {
                            مدقق := صواب;
                        } وإلا إذا (العدد >= 2) {
                            ليكن القالب: &معامل = &الدالة.المعاملات[العدد - 2];
                            ليكن الوسائط: &معامل = &الدالة.المعاملات[العدد - 1];
                            مختارة := تطابق_هوية_معرف_وشريحة(
                                &(*المصدر).المحتوى, (*القالب).الاسم.النطاق.البداية.البايت,
                                (*القالب).الاسم.النطاق.النهاية.البايت, «القالب»
                            ) && تطابق_هوية_معرف_وشريحة(
                                &(*المصدر).المحتوى, (*الوسائط).الاسم.النطاق.البداية.البايت,
                                (*الوسائط).الاسم.النطاق.النهاية.البايت, «الوسائط»
                            );
                        };
                        إذا (مدقق || مختارة) {
                            طابق رمز_اسم_محلول_عند(&(*الروابط)[موضع], الدالة.الاسم.النطاق) مع
                            | اختياري.موجود(الرمز) -> {
                                إذا (مدقق) { المدقق := اختياري.موجود(الرمز); } وإلا { ألحق(الدوال, الرمز); };
                            }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                    ف := ف + 1;
                }
            };
        };
        موضع := موضع + 1;
    }
    ليكن الناتج: متغير متجه معرف_رمز = [];
    طابق المدقق مع
    | اختياري.موجود(الرمز) -> { ألحق(الناتج, الرمز); }
    | اختياري.لا_شيء -> { أرجع الناتج; };
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الدوال) مثل طبيعي)) {
        ألحق(الناتج, الدوال[ر]);
        ر := ر + 1;
    }
    أرجع الناتج;
}

// Name resolution owns SymbolIDs; ModuleLoader owns immutable canonical keys.
// A source tree that merely copies standard-library filenames cannot satisfy
// the RootID+ModuleKey check. Missing/ambiguous symbols fail closed.
عرف استخلص_أصل_نواة_واجهة(
    البيئة: &بيئة_وحدات_منطقية,
    المحمل: &محمل_وحدات,
    الوحدات_المحملة: &متجه وحدة_نحوية_محملة,
    الأشجار: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    المصادر: &خريطة_مصادر
): اختياري أصل_نواة_موثق_واجهة {
    // Root authority originates only in Driver's standard-library registration.
    // No user-supplied spelling, module path suffix or alias is consulted.
    ليكن جذر_المكتبة: معرف_جذر_مكتبة;
    طابق جذر_قياسي_موثوق_لبيئة(البيئة) مع
    | اختياري.موجود(الجذر) -> {
        إذا (!جذر_مكتبة_مسجل(البيئة, الجذر)) { أرجع اختياري.لا_شيء(); };
        جذر_المكتبة := الجذر;
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن اسم_العمليات: نص = «os/platform/unix/linux/syscalls/operations.sn»;
    ليكن اسم_الانتقاء: نص = «os/platform/unix/linux/syscalls/selection.sn»;
    ليكن المنتقي: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    ليكن المنشئات: متغير متجه منشئ_نواة_موثق_واجهة = [];
    ليكن وجد_العمليات: متغير منطقي = خطأ;
    ليكن وجد_الانتقاء: متغير منطقي = خطأ;
    ليكن وجد_تعداد_العمليات: متغير منطقي = خطأ;
    ليكن وجد_دالة_الانتقاء: متغير منطقي = خطأ;
    ليكن موضع: متغير طبيعي = 0;
    طالما (موضع < (الطول(*الوحدات_المحملة) مثل طبيعي)) {
        ليكن ربط_الوحدة: &وحدة_نحوية_محملة = &(*الوحدات_المحملة)[موضع];
        // The loader's ModuleID is a dense direct index into its canonical
        // RootID+ModuleKey table. Source trees and resolved bindings have
        // their own existing aligned indexes; no global key/path scan needed.
        إذا (((*ربط_الوحدة).الوحدة.القيمة مثل طبيعي) >= (الطول((*المحمل).المحملة) مثل طبيعي)
            || (*ربط_الوحدة).الشجرة >= (الطول(*الأشجار) مثل طبيعي)
            || موضع >= (الطول(*الروابط) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        ليكن المحملة: &وحدة_مصدر_محملة = &(*المحمل).المحملة[(*ربط_الوحدة).الوحدة.القيمة];
        ليكن الوحدة: &وحدة_مصدر = &(*الأشجار)[(*ربط_الوحدة).الشجرة];
        إذا ((*المحملة).معرف_المصدر != (*الوحدة).معرف_المصدر) {
            أرجع اختياري.لا_شيء();
        };
        ليكن المصدر: &مصدر = &(*المصادر).المصادر[(*الوحدة).معرف_المصدر];
        ليكن المفتاح: &مفتاح_وحدة_مقنن = &(*المحملة).المفتاح;
        ليكن عمليات: منطقي = هل_مفتاح_وحدة_نواة_واجهة(البيئة, المفتاح, جذر_المكتبة, &اسم_العمليات);
        ليكن انتقاء: منطقي = هل_مفتاح_وحدة_نواة_واجهة(البيئة, المفتاح, جذر_المكتبة, &اسم_الانتقاء);
        إذا (عمليات || انتقاء) {
            إذا (عمليات) { إذا (وجد_العمليات) { أرجع اختياري.لا_شيء(); }; وجد_العمليات := صواب; };
            إذا (انتقاء) { إذا (وجد_الانتقاء) { أرجع اختياري.لا_شيء(); }; وجد_الانتقاء := صواب; };
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
                طابق (*الوحدة).العناصر[ف] مع
                | عنصر_وحدة.دالة(الدالة) -> {
                    إذا (انتقاء && تطابق_هوية_معرف_وشريحة(
                        &(*المصدر).المحتوى, الدالة.الاسم.النطاق.البداية.البايت,
                        الدالة.الاسم.النطاق.النهاية.البايت, «رقم_نداء_نواة_لينكس»
                    )) {
                        إذا (وجد_دالة_الانتقاء) { أرجع اختياري.لا_شيء(); };
                        وجد_دالة_الانتقاء := صواب;
                        طابق رمز_اسم_محلول_عند(&(*الروابط)[موضع], الدالة.الاسم.النطاق) مع
                        | اختياري.موجود(الرمز) -> { المنتقي := اختياري.موجود(الرمز); }
                        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
                    };
                }
                | عنصر_وحدة.نوع(التصريح) -> {
                    إذا (عمليات && تطابق_هوية_معرف_وشريحة(
                        &(*المصدر).المحتوى, التصريح.الاسم.النطاق.البداية.البايت,
                        التصريح.الاسم.النطاق.النهاية.البايت, «عملية_نداء_نواة_لينكس»
                    )) {
                        إذا (وجد_تعداد_العمليات) { أرجع اختياري.لا_شيء(); };
                        وجد_تعداد_العمليات := صواب;
                        طابق التصريح.الشكل مع
                        | شكل_تصريح_نوع.تعداد(الأعضاء) -> {
                            ليكن م: متغير طبيعي = 0;
                            طالما (م < (الطول(الأعضاء) مثل طبيعي)) {
                                ليكن الاسم_كبايتات: متجه ط8 = بايتات_اسم_مقنن_واجهة(المصدر, الأعضاء[م].الاسم.النطاق);
                                ليكن الاسم: نص = من_بايتات(&الاسم_كبايتات);
                                طابق رمز_اسم_محلول_عند(&(*الروابط)[موضع], الأعضاء[م].الاسم.النطاق) مع
                                | اختياري.موجود(الرمز) -> {
                                    // The signature query takes its own text; الاسم stays for the record.
                                    ليكن اسم_الاستعلام: نص = من_بايتات(&الاسم_كبايتات);
                                    طابق توقيع_عملية_نواة_لينكس(اسم_الاستعلام) مع
                                    | اختياري.موجود(التوقيع) -> {
                                        طابق حوّل_توقيع_لينكس_إلى_بدائي(&التوقيع) مع
                                        | اختياري.موجود(الأثر) -> {
                                            ليكن المنشئ: منشئ_نواة_موثق_واجهة = { الرمز: الرمز, الاسم: الاسم, الترتيب: م, التوقيع: الأثر };
                                            ألحق(المنشئات, المنشئ);
                                        }
                                        | اختياري.لا_شيء -> { };
                                    }
                                    | اختياري.لا_شيء -> { };

                                }
                                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
                                م := م + 1;
                            }
                        }
                        | _ -> { أرجع اختياري.لا_شيء(); };
                    };
                }
                | _ -> { };
                ف := ف + 1;
            }
        };
        موضع := موضع + 1;
    }
    إذا (!وجد_العمليات || !وجد_الانتقاء
        || !وجد_تعداد_العمليات || !وجد_دالة_الانتقاء
        || الطول(المنشئات) == 0) {
        أرجع اختياري.لا_شيء();
    };
    طابق المنتقي مع
    | اختياري.موجود(الرمز) -> {
        ليكن الأصل: أصل_نواة_موثق_واجهة = { المنتقي: الرمز, المنشئات: المنشئات };
        أرجع اختياري.موجود(الأصل);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// Composition only: each semantic owner keeps its canonical context; this is not a second database.
عام نوع نتيجة_واجهة_وحدة = {
    // Only facts consumed by MSIR lowering survive the Frontend boundary.
    // Module graph, root-tree duplicate, Memory tables, and SSF scratch are
    // validation-phase state and die before MSIR construction begins.
    الوحدات: متجه وحدة_مصدر,
    أصل_نواة_لينكس: اختياري أصل_نواة_موثق_واجهة,
    // Functions that never return (the stop primitive, std.process.panic):
    // lowering ends the caller's path after a call to one.
    رموز_لا_تعود: متجه معرف_رمز,
    // std.fmt's compile-time checker, then the format functions it checks
    // (استخلص_رموز_تنسيق_واجهة); empty without std.fmt.
    رموز_التنسيق: متجه معرف_رمز,
    // The target's pointer width in bits (64 without a target): the width of
    // the global allocator's address words (msir/semantic_lowering.sn).
    عرض_مؤشر_الهدف: طبيعي,
    الوحدات_الدلالية: متجه وحدة_دلالية,
    خريطة_المصادر: خريطة_مصادر,
    هويات_البدائيات: متجه ربط_رمز_بدائي_مترجم,
    روابط_الأسماء: متجه سياق_روابط_أسماء,
    فهرس_التصريحات: فهرس_تصريحات,
    استعلامات_الأسماء: اختياري سياق_استعلامات_أسماء,
    رمز_بدء_البرنامج: اختياري معرف_رمز,
    // Type and Pattern contexts cross the Frontend boundary as their canonical
    // owned aggregates.  They are borrowed during validation and moved here once.
    سياقات_الأنواع: سياقات_أنواع_وحدة,
    سياق_الأنماط: سياق_أنماط_وحدة,
    كاملة_دلاليا: منطقي,
    تشخيصات_الأدوات: مجموعة_تشخيصات,
    // A tooling request's moved names: where the use of a local's name moves
    // its value out (by span start, اسم_منقول_واجهة), which its ownership
    // analysis on MSIR finds (msir/ssf/ownership_tooling.sn). Empty for a
    // compilation.
    الأسماء_المنقولة: متجه طبيعي,
    // Whether that analysis ran on this result, and the functions (by
    // SymbolID) it left out because a partial program cannot lower them: it
    // checked nothing of theirs, so tooling states no ownership fact about
    // them (ملكية_دالة_محققة_واجهة).
    ملكية_محللة: منطقي,
    دوال_ملكية_متروكة: متجه طبيعي,
    // Tooling-only facts (tooling_facts.sn): direct import edges with their
    // spans, and the sources whose analysis is incomplete. Empty for a compilation.
    حقائق_الأدوات: حقائق_أدوات_واجهة,
    // The Memory facts of every Type (later_phase_facts.sn).
    الذاكرة: سياق_ذاكرة_وحدة
};

عام نوع خطأ_واجهة_وحدة =
    | تحميل بنوع خطأ_تحميل_وحدة
    | تحميل_استيراد بنوع (خطأ_تحميل_استيرادات, نطاق)
    | معجم بنوع خطأ_معجمي
    | نحو بنوع خطأ_نحوي
    | خلل_نحوي_داخلي
    | أنماط بنوع خطأ_أنماط_وحدة
    // A `@@json` field type the derivation cannot encode (annotations/json_derive.sn).
    | اشتقاق_جسون_غير_مدعوم بنوع نطاق
    // `module` in a file that is no folder's root file, with the root file
    // of its folder («» when it has none: a standalone file's directory).
    | تصريح_وحدة_خارج_ملف_الجذر بنوع (نطاق, نص)
;

عام نوع نتيجة_بناء_واجهة_وحدة =
    | مكتملة بنوع نتيجة_واجهة_وحدة
    | مرفوضة بنوع مجموعة_تشخيصات
;

عام نوع نتيجة_بناء_واجهة_قابلة_للإلغاء =
    | مكتملة بنوع نتيجة_واجهة_وحدة
    | مرفوضة بنوع مجموعة_تشخيصات
    | ملغاة
;

عرف تشخيصات_فشل_واجهة_عند(
    المعرف: معرف_تشخيص,
    المصدر: اختياري نطاق_مصدر_تشخيص
): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن التشخيص: تشخيص = ابدأ_تشخيصا(المعرف, المصدر);
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فشل_واجهة(المعرف: معرف_تشخيص): مجموعة_تشخيصات {
    أرجع تشخيصات_فشل_واجهة_عند(المعرف, اختياري.لا_شيء());
}

عرف تشخيصات_فشل_واجهة_مفصلة(
    المعرف: معرف_تشخيص,
    المصدر: اختياري نطاق_مصدر_تشخيص,
    المرحلة: نص,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, المصدر);
    ليكن أضف_مرحلة_مفصلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), المرحلة
    );
    ليكن أضف_سبب_مفصل: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب
    );
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فشل_واجهة_مفصلة_مشتقة(
    المعرف: معرف_تشخيص,
    المصدر: اختياري نطاق_مصدر_تشخيص,
    الاعتماد: نطاق_مصدر_تشخيص,
    المرحلة: نص,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, المصدر);
    ليكن أضف_مرحلة_مفصلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), المرحلة);
    ليكن أضف_سبب_مفصل: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    ليكن أضف_الاعتماد: منطقي = أضف_اعتماد_تشخيص(&متغير التشخيص, الاعتماد);
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف أضف_اعتماد_تشخيص_من_نطاق_محمل(
    التشخيص: &متغير تشخيص,
    المحمل: &خريطة_مصادر,
    النطاق: نطاق
): فراغ {
    طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق) مع
    | اختياري.موجود(الاعتماد) -> {
        ليكن أضف_الاعتماد: منطقي = أضف_اعتماد_تشخيص(التشخيص, الاعتماد);
    }
    | اختياري.لا_شيء -> { };
}

عرف سبب_فئة_خطأ_معجمي(الفئة: فئة_خطأ_معجمي): سبب_تشخيص {
    طابق الفئة مع
    | فئة_خطأ_معجمي.بناء -> { أرجع سبب_تشخيص.سبب_محلل_معجمي_إنشاء(); }
    | فئة_خطأ_معجمي.يوتيف8 -> { أرجع سبب_تشخيص.سبب_محلل_معجمي_يوتيف8(); }
    | فئة_خطأ_معجمي.داخلي -> { أرجع سبب_تشخيص.سبب_محلل_معجمي_داخلي(); }
    | فئة_خطأ_معجمي.تحكم_اتجاه -> { أرجع سبب_تشخيص.سبب_محلل_معجمي_تحكم_اتجاه(); };
}

عرف معرف_تشخيص_فئة_خطأ_معجمي(الفئة: فئة_خطأ_معجمي): معرف_تشخيص {
    طابق الفئة مع
    | فئة_خطأ_معجمي.بناء -> { أرجع معرف_تشخيص.خطأ_معجمي(); }
    | فئة_خطأ_معجمي.يوتيف8 -> { أرجع معرف_تشخيص.نص_مصدر_يوتيف8_غير_صالح(); }
    | فئة_خطأ_معجمي.داخلي -> { أرجع معرف_تشخيص.خلل_معجمي_داخلي(); }
    | فئة_خطأ_معجمي.تحكم_اتجاه -> { أرجع معرف_تشخيص.خطأ_معجمي(); };
}

عرف معرف_تشخيص_فئة_خطأ_نحوي(الفئة: فئة_خطأ_نحوي): معرف_تشخيص {
    طابق الفئة مع
    | فئة_خطأ_نحوي.متوقع -> { أرجع معرف_تشخيص.خطأ_نحوي(); }
    | فئة_خطأ_نحوي.فاصلة_منقوطة_في_غير_موضعها -> { أرجع معرف_تشخيص.فاصلة_منقوطة_في_غير_موضعها(); }
    | فئة_خطأ_نحوي.تهجئة_كلمة_محجوزة_محتملة -> { أرجع معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة(); }
    | فئة_خطأ_نحوي.عبارة_بلا_عملية -> { أرجع معرف_تشخيص.عبارة_بلا_عملية(); }
    | فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود -> { أرجع معرف_تشخيص.نوع_ناتج_دالة_مفقود(); }
    | فئة_خطأ_نحوي.تعبير -> { أرجع معرف_تشخيص.تعبير_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.نوع -> { أرجع معرف_تشخيص.نوع_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.نمط -> { أرجع معرف_تشخيص.نمط_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.عنصر -> { أرجع معرف_تشخيص.عنصر_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.شرط_هدف_غير_صالح -> { أرجع معرف_تشخيص.عنصر_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.شرط_هدف_بلا_هدف -> { أرجع معرف_تشخيص.عنصر_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.تعشيش_عميق_جدا -> { أرجع معرف_تشخيص.خطأ_نحوي(); }
    | فئة_خطأ_نحوي.ملف_مضمن_غير_مقروء -> { أرجع معرف_تشخيص.خطأ_نحوي(); }
    | فئة_خطأ_نحوي.تهيئة_قيمة_عليا_غير_مدعومة -> { أرجع معرف_تشخيص.عنصر_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.داخلي -> { أرجع معرف_تشخيص.خلل_محلل_داخلي(); };
}

عرف سبب_فئة_خطأ_نحوي(الفئة: فئة_خطأ_نحوي): سبب_تشخيص {
    طابق الفئة مع
    | فئة_خطأ_نحوي.متوقع -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_متوقع_رمز_معجمي(); }
    | فئة_خطأ_نحوي.فاصلة_منقوطة_في_غير_موضعها -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_في_موضع_خاطئ_فاصلة_منقوطة(); }
    | فئة_خطأ_نحوي.تهجئة_كلمة_محجوزة_محتملة -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_كلمة_محجوزة_خطأ_إملائي(); }
    | فئة_خطأ_نحوي.عبارة_بلا_عملية -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_عبارة_بلا_عملية(); }
    | فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_مفقود_دالة_إرجاع_نوع(); }
    | فئة_خطأ_نحوي.تعبير -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_تعبير(); }
    | فئة_خطأ_نحوي.نوع -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_نوع(); }
    | فئة_خطأ_نحوي.نمط -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_نمط(); }
    | فئة_خطأ_نحوي.عنصر -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_عنصر(); }
    | فئة_خطأ_نحوي.شرط_هدف_غير_صالح -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_هدف_شرط_غير_صحيح(); }
    | فئة_خطأ_نحوي.شرط_هدف_بلا_هدف -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_هدف_شرط_بلا_هدف(); }
    | فئة_خطأ_نحوي.تعشيش_عميق_جدا -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_تعشيش_عميق(); }
    | فئة_خطأ_نحوي.ملف_مضمن_غير_مقروء -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_ملف_مضمن_غير_مقروء(); }
    | فئة_خطأ_نحوي.تهيئة_قيمة_عليا_غير_مدعومة -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_تهيئة_قيمة_عليا_غير_مدعومة(); }
    | فئة_خطأ_نحوي.داخلي -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_داخلي(); };
}

// A module spelling error has its own identity and no reason.
عرف سبب_خطأ_تحميل_وحدة(الخطأ: خطأ_تحميل_وحدة): اختياري سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_تحميل_وحدة.مصدر_غير_موجود -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_مصدر_ليس_موجود()); }
    | خطأ_تحميل_وحدة.مصدر_غير_مقروء -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_مصدر_غير_مقروء()); }
    | خطأ_تحميل_وحدة.مرجع_غير_صالح -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_غير_صحيح_استيراد_مرجع()); }
    | خطأ_تحميل_وحدة.جذر_غير_معلن -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_مكتبة_جذر_غير_مسجل()); }
    | خطأ_تحميل_وحدة.هروب_من_الجذر -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_استيراد_يتجاوز_جذر()); }
    | خطأ_تحميل_وحدة.مسار_منطقي_غير_صالح -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_غير_صحيح_منطقي_مسار()); }
    | خطأ_تحميل_وحدة.تعارض_مسار_عام -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_عام_مسار_تعارض()); }
    | خطأ_تحميل_وحدة.مصدر_وحدة_متعارض -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_مصدر_تعارض()); }
    | خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_استيراد_ليس_محمل()); }
    | خطأ_تحميل_وحدة.دورة_استيراد -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_استيراد_دورة()); }
    | خطأ_تحميل_وحدة.رسم_وحدات_مرفوض -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_رسم_بياني_مرفوض()); }
    | خطأ_تحميل_وحدة.تصدير_انتقائي_مفقود -> { أرجع اختياري.موجود(سبب_تشخيص.سبب_وحدة_انتقائي_تصدير_ليس_موجود()); }
    | خطأ_تحميل_وحدة.تهجئة_وحدة(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف أضف_سبب_خطأ_تحميل_وحدة(التشخيص: &متغير تشخيص, الخطأ: خطأ_تحميل_وحدة): فراغ {
    طابق سبب_خطأ_تحميل_وحدة(الخطأ) مع
    | اختياري.موجود(السبب) -> { ليكن أضيف: منطقي = أضف_سبب_تشخيص(التشخيص, السبب); }
    | اختياري.لا_شيء -> { };
}

عرف معرف_تشخيص_خطأ_تحميل_وحدة(الخطأ: خطأ_تحميل_وحدة): معرف_تشخيص {
    طابق الخطأ مع
    | خطأ_تحميل_وحدة.مصدر_غير_موجود -> { أرجع معرف_تشخيص.وحدة_مصدر_غير_موجودة(); }
    | خطأ_تحميل_وحدة.مصدر_غير_مقروء -> { أرجع معرف_تشخيص.وحدة_مصدر_غير_مقروءة(); }
    | خطأ_تحميل_وحدة.مرجع_غير_صالح -> { أرجع معرف_تشخيص.مرجع_استيراد_غير_صالح(); }
    | خطأ_تحميل_وحدة.جذر_غير_معلن -> { أرجع معرف_تشخيص.جذر_مكتبة_غير_مسجل(); }
    | خطأ_تحميل_وحدة.هروب_من_الجذر -> { أرجع معرف_تشخيص.استيراد_يهرب_من_الجذر(); }
    | خطأ_تحميل_وحدة.مسار_منطقي_غير_صالح -> { أرجع معرف_تشخيص.مسار_وحدة_منطقي_غير_صالح(); }
    | خطأ_تحميل_وحدة.تعارض_مسار_عام -> { أرجع معرف_تشخيص.تعارض_مسار_وحدة_عام(); }
    | خطأ_تحميل_وحدة.مصدر_وحدة_متعارض -> { أرجع معرف_تشخيص.تعارض_مصدر_وحدة(); }
    | خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة -> { أرجع معرف_تشخيص.وحدة_مستوردة_غير_محملة(); }
    | خطأ_تحميل_وحدة.دورة_استيراد -> { أرجع معرف_تشخيص.دورة_استيراد(); }
    | خطأ_تحميل_وحدة.رسم_وحدات_مرفوض -> { أرجع معرف_تشخيص.رسم_وحدات_مرفوض(); }
    | خطأ_تحميل_وحدة.تصدير_انتقائي_مفقود -> { أرجع معرف_تشخيص.تصدير_انتقائي_غير_موجود(); }
    | خطأ_تحميل_وحدة.تهجئة_وحدة(خطأ_التهجئة) -> {
        طابق خطأ_التهجئة.الصنف مع
        | صنف_خطأ_تهجئة_وحدة.ابن_غير_موجود -> { أرجع معرف_تشخيص.وحدة_معلنة_بلا_ابن(); }
        | صنف_خطأ_تهجئة_وحدة.إعادة_تصدير_تحجب_ابنا -> { أرجع معرف_تشخيص.إعادة_تصدير_تحجب_ابنا(); }
        | صنف_خطأ_تهجئة_وحدة.هدف_إعادة_تصدير_غير_متاح -> { أرجع معرف_تشخيص.هدف_إعادة_تصدير_غير_متاح(); }
        | صنف_خطأ_تهجئة_وحدة.دورة_إعادة_تصدير -> { أرجع معرف_تشخيص.دورة_إعادة_تصدير(); }
        | صنف_خطأ_تهجئة_وحدة.تهجئة_مشتركة -> { أرجع معرف_تشخيص.تهجئة_وحدة_مشتركة(); }
        | صنف_خطأ_تهجئة_وحدة.كلمة_محجوزة -> { أرجع معرف_تشخيص.تهجئة_وحدة_محجوزة(); };
    };
}

// A root file's `module` error: at the name or spelling in the root file,
// which is the diagnostic's value.
عرف تشخيصات_خطأ_تهجئة_وحدة(
    الخطأ: خطأ_تهجئة_وحدة,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_خطأ_تحميل_وحدة(خطأ_تحميل_وحدة.تهجئة_وحدة(الخطأ)),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق)
    );
    ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «module-loading»
    );
    أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, الخطأ.النطاق, مفتاح_حجة_تشخيص.القيمة());
    طابق الخطأ.الصنف مع
    | صنف_خطأ_تهجئة_وحدة.كلمة_محجوزة -> {
        ليكن بلا_حجج: متجه حجة_تشخيص = [];
        ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_اختر_اسما_غير_محجوز(), بلا_حجج
        );
    }
    | _ -> { };
    أرجع مجموعة_تشخيص_واحد(&التشخيص);
}

عرف تشخيصات_خطأ_تحميل_وحدة_مفصلة(
    الخطأ: خطأ_تحميل_وحدة,
    فهرس_الاستيراد: اختياري طبيعي,
    المصدر: اختياري نطاق_مصدر_تشخيص
): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_خطأ_تحميل_وحدة(الخطأ), المصدر
    );
    ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «module-loading»
    );
    أضف_سبب_خطأ_تحميل_وحدة(&متغير التشخيص, الخطأ);
    طابق فهرس_الاستيراد مع
    | اختياري.موجود(الفهرس) -> {
        ليكن أضف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
    }
    | اختياري.لا_شيء -> { };
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_خلل_نحوي_داخلي(): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.لا_ناتج_تحليل(), اختياري.لا_شيء()
    );
    ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_داخلي_بلا_نتيجة()
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عام عرف مصدر_تشخيص_من_نطاق_محمل(
    المحمل: &خريطة_مصادر,
    النطاق_المعطى: نطاق
): اختياري نطاق_مصدر_تشخيص {
    ليكن النطاق: نطاق = نطاق_الإبلاغ(المحمل, النطاق_المعطى);
    ليكن المقتطف: اختياري نص = مقتطف_مصدر_محمل_لنطاق(المحمل, &النطاق);
    // Through the map (its cached line index), not a copy of the source.
    طابق نطاق_مصدر_تشخيص_من_خريطة(النطاق, المحمل, النطاق.البداية.المصدر, انسخ_اختيار_نص(&المقتطف)) مع
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف);
    }
    | اختياري.لا_شيء -> {
        ليكن الاسم: اختياري نص = اسم_مصدر_محمل_بالمعرف(
            المحمل, النطاق.البداية.المصدر
        );
        ليكن الوصف: نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_بأصل(
            النطاق, الاسم, المقتطف
        );
        أرجع اختياري.موجود(الوصف);
    };
}

// Unknown-name diagnostics carry the name as written, so the message can say
// which name was not found.
عرف ابن_تشخيص_اسم_غير_معروف(
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    السبب: سبب_تشخيص
): تشخيص {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.اسم_غير_معروف(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
    );
    ليكن أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»);
    ليكن أضف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    طابق مصدر_محمل_بالمعرف(المحمل, النطاق.البداية.المصدر) مع
    | اختياري.موجود(المصدر) -> {
        ليكن البايتات: متجه ط8 = بايتات_اسم_مقنن_واجهة(&المصدر, النطاق);
        إذا ((الطول(البايتات) مثل طبيعي) > 0) {
            ليكن أضف_الاسم: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), من_بايتات(&البايتات)
            );
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع التشخيص;
}

عرف تشخيصات_اسم_غير_معروف(
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن التشخيص: تشخيص = ابن_تشخيص_اسم_غير_معروف(المحمل, النطاق, السبب);
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// The import path (`std.text.compare`) of a loaded module of the standard
// library, or none: for another root the spelling an importer would use is
// not known here, so no import is suggested.
عرف مسار_استيراد_قياسي_لوحدة(
    البيئة: &بيئة_وحدات_منطقية,
    المحمل: &محمل_وحدات,
    الوحدة: معرف_وحدة
): اختياري نص {
    ليكن القياسي: معرف_جذر_مكتبة;
    طابق جذر_قياسي_موثوق_لبيئة(البيئة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الجذر) -> { القياسي := الجذر; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المحمل).المحملة) مثل طبيعي)) {
        ليكن المحملة: &وحدة_مصدر_محملة = &(*المحمل).المحملة[ف];
        ف := ف + 1;
        إذا (!معرفا_وحدة_متساويان((*المحملة).الوحدة, الوحدة)) { تابع_حلقة; };
        إذا (!معرفا_جذر_مكتبة_متساويان((*المحملة).المفتاح.الجذر, القياسي) && !جذر_قياسي(البيئة, (*المحملة).المفتاح.الجذر)) { أرجع اختياري.لا_شيء(); };
        ليكن الأجزاء: &متجه جزء_مسار_وحدة_منطقي = &(*المحملة).المفتاح.المسار.الأجزاء;
        إذا ((الطول(*الأجزاء) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
        ليكن الناتج: متغير متجه ط8 = [];
        ألحق_بايتات_نص(&متغير الناتج, «std»);
        ليكن ج: متغير طبيعي = 0;
        طالما (ج < (الطول(*الأجزاء) مثل طبيعي)) {
            ألحق(الناتج, 0x2E مثل ط8);
            // A module key's last part is the file name (`panic.sn`).
            ليكن طول_الجزء: متغير طبيعي = الطول((*الأجزاء)[ج].البايتات) مثل طبيعي;
            إذا (ج + 1 == (الطول(*الأجزاء) مثل طبيعي) && طول_الجزء > 3
                && (*الأجزاء)[ج].البايتات[طول_الجزء - 3] == 0x2E
                && (*الأجزاء)[ج].البايتات[طول_الجزء - 2] == 0x73
                && (*الأجزاء)[ج].البايتات[طول_الجزء - 1] == 0x6E) {
                طول_الجزء := طول_الجزء - 3;
            };
            ليكن ب: متغير طبيعي = 0;
            طالما (ب < طول_الجزء) {
                ليكن البايت: ط8 = (*الأجزاء)[ج].البايتات[ب];
                // A segment that is not a plain identifier part is not spelled here.
                إذا (البايت == 0x2E || البايت == 0x2F) { أرجع اختياري.لا_شيء(); };
                ألحق(الناتج, البايت);
                ب := ب + 1;
            }
            ج := ج + 1;
        }
        أرجع اختياري.موجود(من_بايتات(&الناتج));
    }
    أرجع اختياري.لا_شيء();
}

// The payload count of the enum constructor whose name is declared at
// تصريح_المنشئ, or none when no loaded tree declares one there.
عرف عدد_حمولات_منشئ_مصرح(الأشجار: &متجه وحدة_مصدر, تصريح_المنشئ: نطاق): اختياري طبيعي {
    ليكن المصدر_المطلوب: طبيعي = تصريح_المنشئ.البداية.المصدر مثل طبيعي;
    ليكن ش: متغير طبيعي = 0;
    طالما (ش < (الطول(*الأشجار) مثل طبيعي)) {
        إذا ((*الأشجار)[ش].معرف_المصدر == المصدر_المطلوب) {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الأشجار)[ش].العناصر) مثل طبيعي)) {
                طابق (*الأشجار)[ش].العناصر[ف] مع
                | عنصر_وحدة.نوع(التصريح) -> {
                    طابق التصريح.الشكل مع
                    | شكل_تصريح_نوع.تعداد(المنشئات) -> {
                        ليكن م: متغير طبيعي = 0;
                        طالما (م < (الطول(المنشئات) مثل طبيعي)) {
                            إذا (نطاقان_متساويان(المنشئات[م].الاسم.النطاق, تصريح_المنشئ)) {
                                أرجع اختياري.موجود(الطول(المنشئات[م].الحمولات) مثل طبيعي);
                            };
                            م := م + 1;
                        }
                    }
                    | _ -> { };
                }
                | _ -> { };
                ف := ف + 1;
            }
        };
        ش := ش + 1;
    }
    أرجع اختياري.لا_شيء();
}

// SULTANC-NAME-CONSTRUCTOR-NOT-CALLED at `Enum.Ctor` read as a value
// (names/resolved_bindings.sn). Its facts are the constructor as written
// (`Color.Red`, القيمة) and its payload count (المتوقع, the arguments a call
// takes). Without payloads: a help and a machine-applicable fix that inserts
// `()`. With payloads: a help only, since the arguments are the author's to
// write and no edit could be machine-applicable.
عرف ابن_تشخيص_منشئ_غير_مستدعى(
    المحمل: &خريطة_مصادر,
    الأشجار: &متجه وحدة_مصدر,
    النطاق: نطاق,
    المنشئ: منشئ_غير_مستدعى_مؤجل
): تشخيص {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.منشئ_غير_مستدعى(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
    );
    ليكن أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»);
    ليكن الاسم: متغير متجه ط8 = بايتات_نطاق_محمل(المحمل, المنشئ.نطاق_النوع);
    ليكن اسم_المنشئ: متجه ط8 = بايتات_نطاق_محمل(المحمل, المنشئ.نطاق_المنشئ);
    إذا ((الطول(الاسم) مثل طبيعي) > 0 && (الطول(اسم_المنشئ) مثل طبيعي) > 0) {
        ألحق(الاسم, 0x2E مثل ط8);
        ليكن ب: متغير طبيعي = 0;
        طالما (ب < (الطول(اسم_المنشئ) مثل طبيعي)) {
            ألحق(الاسم, اسم_المنشئ[ب]);
            ب := ب + 1;
        }
        ليكن أضف_الاسم: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), من_بايتات(&الاسم)
        );
    };
    ليكن العدد: متغير طبيعي = 0;
    ليكن القابلية: متغير قابلية_تطبيق_إصلاح = قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح();
    طابق عدد_حمولات_منشئ_مصرح(الأشجار, المنشئ.تصريح_المنشئ) مع
    | اختياري.موجود(عدد_الحمولات) -> {
        العدد := عدد_الحمولات;
        القابلية := قابلية_تطبيق_إصلاح.آلي();
    }
    | اختياري.لا_شيء -> { };
    ليكن أضف_العدد: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), العدد);
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    إذا (العدد == 0) {
        ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_استدع_المنشئ(), بلا_حجج
        );
        ليكن أضف_الإصلاح: منطقي = أضف_إصلاح_استدعاء_منشئ(
            &متغير التشخيص, المحمل, المنشئ.نطاق_المنشئ, القابلية
        );
    } وإلا {
        ليكن أضف_مساعدة_الحجج: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_مرر_حجج_المنشئ(), بلا_حجج
        );
    };
    أرجع التشخيص;
}

// Every deferred unknown name of a module (names/resolved_bindings.sn), in
// source order: a constructor read as a value without its call
// (SULTANC-NAME-CONSTRUCTOR-NOT-CALLED), a target limit when the loaded
// modules declare the name for other targets only, else an unknown name with
// its evidence: a visible name
// of close spelling (help and a maybe-incorrect fix) and the std modules that
// declare it public (help naming each).
عرف تشخيصات_أسماء_مفقودة(
    المحمل: &خريطة_مصادر,
    الأشجار: &متجه وحدة_مصدر,
    الهدف: &اختياري واصف_هدف,
    البيئة: &بيئة_وحدات_منطقية,
    محمل_الوحدات: &محمل_وحدات,
    المفقودة: &متجه اسم_مفقود_مؤجل,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المفقودة) مثل طبيعي)) {
        ليكن المفقود: &اسم_مفقود_مؤجل = &(*المفقودة)[ف];
        ف := ف + 1;
        // `Enum.Ctor` read as a value: not an unknown name.
        ليكن منشئ_غير_مستدعى: متغير منطقي = خطأ;
        طابق (*المفقود).المنشئ_غير_المستدعى مع
        | اختياري.موجود(المنشئ) -> {
            ليكن تشخيص_المنشئ: تشخيص = ابن_تشخيص_منشئ_غير_مستدعى(
                المحمل, الأشجار, (*المفقود).النطاق, المنشئ
            );
            أصدر_تشخيصا(&متغير المجموعة, &تشخيص_المنشئ);
            منشئ_غير_مستدعى := صواب;
        }
        | اختياري.لا_شيء -> { };
        إذا (منشئ_غير_مستدعى) { تابع_حلقة; };
        ليكن لهدف_آخر: متغير منطقي = خطأ;
        طابق *الهدف مع
        | اختياري.موجود(_) -> {
            طابق تصريح_لهدف_آخر_باسم(المحمل, الأشجار, (*المفقود).النطاق) مع
            | اختياري.موجود(_) -> { لهدف_آخر := صواب; }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        إذا (لهدف_آخر) {
            ليكن تشخيصات_الهدف: مجموعة_تشخيصات = تشخيصات_اسم_مفقود_أو_لهدف_آخر(
                المحمل, الأشجار, الهدف, (*المفقود).النطاق, السبب
            );
            ادمج_مجموعة_تشخيصات(&متغير المجموعة, &تشخيصات_الهدف);
            تابع_حلقة;
        };
        ليكن التشخيص: متغير تشخيص = ابن_تشخيص_اسم_غير_معروف(المحمل, (*المفقود).النطاق, السبب);
        طابق (*المفقود).الاقتراح مع
        | اختياري.موجود(الاقتراح) -> {
            ليكن حجج_المساعدة: متغير متجه حجة_تشخيص = [];
            ليكن حجة_الاقتراح: حجة_تشخيص = {
                المفتاح: مفتاح_حجة_تشخيص.الاستبدال(),
                القيمة: قيمة_حجة_تشخيص.نصية(انسخ_نص(&الاقتراح))
            };
            ألحق(حجج_المساعدة, حجة_الاقتراح);
            ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
                &متغير التشخيص, مفتاح_صياغة.مساعدة_اسم_مشابه_مرئي(), حجج_المساعدة
            );
            // A copy: the fix is added to التشخيص while its source is read.
            طابق انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(&التشخيص.المصدر_الرئيسي) مع
            | اختياري.موجود(مصدر_الإصلاح) -> {
                ليكن أضف_الإصلاح: منطقي = أضف_إصلاحا(
                    &متغير التشخيص, مصدر_الإصلاح, انسخ_نص(&الاقتراح),
                    قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح(),
                    مفتاح_صياغة.مساعدة_اسم_مشابه_مرئي()
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        // The std modules with an import path: one is a machine-applicable fix.
        ليكن عدد_المسارات: متغير طبيعي = 0;
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*المفقود).الوحدات_المصرحة) مثل طبيعي)) {
            طابق مسار_استيراد_قياسي_لوحدة(البيئة, محمل_الوحدات, (*المفقود).الوحدات_المصرحة[ع]) مع
            | اختياري.موجود(_) -> { عدد_المسارات := عدد_المسارات + 1; }
            | اختياري.لا_شيء -> { };
            ع := ع + 1;
        }
        ليكن و: متغير طبيعي = 0;
        طالما (و < (الطول((*المفقود).الوحدات_المصرحة) مثل طبيعي)) {
            طابق مسار_استيراد_قياسي_لوحدة(البيئة, محمل_الوحدات, (*المفقود).الوحدات_المصرحة[و]) مع
            | اختياري.موجود(المسار) -> {
                ليكن أضف_إصلاح_الاستيراد: منطقي = أضف_إصلاح_استيراد_وحدة(
                    &متغير التشخيص, المحمل, (*المفقود).النطاق, &المسار, عدد_المسارات == 1
                );
                ليكن حجج_الاستيراد: متغير متجه حجة_تشخيص = [];
                ليكن حجة_المسار: حجة_تشخيص = {
                    المفتاح: مفتاح_حجة_تشخيص.المسار(),
                    القيمة: قيمة_حجة_تشخيص.نصية(المسار)
                };
                ألحق(حجج_الاستيراد, حجة_المسار);
                ليكن أضف_مساعدة_الاستيراد: منطقي = أضف_مساعدة(
                    &متغير التشخيص, مفتاح_صياغة.مساعدة_استورد_وحدة_تصرح_بالاسم(), حجج_الاستيراد
                );
            }
            | اختياري.لا_شيء -> { };
            و := و + 1;
        }
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    }
    أرجع المجموعة;
}

// `type X = opaque;` while a type named opaque/معتم is visible: the
// declaration used to alias that type, so it is an invalid definition rather
// than a silent change of meaning. The name is the word as written.
عرف تشخيصات_معتم_يحجب_نوعا(
    المحمل: &خريطة_مصادر,
    النطاق: نطاق
): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.تعريف_نوع_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
    );
    ليكن أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»);
    ليكن البايتات: متجه ط8 = بايتات_نطاق_محمل(المحمل, النطاق);
    إذا ((الطول(البايتات) مثل طبيعي) > 0) {
        ليكن أضف_الاسم: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), من_بايتات(&البايتات)
        );
    };
    ليكن أضف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_معتم_يحجب_نوعا_مرئيا());
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص, مفتاح_صياغة.مساعدة_سم_النوع_أو_استعمل_مرادف_اسم(), بلا_حجج
    );
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// SULTANC-SAFETY-UNSAFE-OPERATION. For a pointer cast the pointer rules
// gate, the reason names the rule and the help shows the unsafe block and the
// null idiom; the cast's source Type is the expression fact that starts where
// the cast starts and ends before it (its operand).
عرف تشخيصات_عملية_غير_آمنة(
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    النطاق: نطاق
): مجموعة_تشخيصات {
    ليكن السبب: متغير اختياري سبب_تشخيص = اختياري.لا_شيء();
    ليكن و: متغير طبيعي = 0;
    طالما (و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        ليكن السياق: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        طابق نوع_تعبير_عند(السياق, النطاق) مع
        | اختياري.موجود(نوع_الهدف) -> {
            ليكن نوع_المصدر: متغير اختياري معرف_نوع = اختياري.لا_شيء();
            ليكن أبعد_نهاية: متغير ط32 = 0;
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*السياق).الحقائق) مثل طبيعي)) {
                ليكن الحقيقة: &حقيقة_تعبير_نوعية = &(*السياق).الحقائق[ف];
                إذا ((*الحقيقة).النطاق.البداية.المصدر == النطاق.البداية.المصدر
                    && (*الحقيقة).النطاق.البداية.البايت == النطاق.البداية.البايت
                    && (*الحقيقة).النطاق.النهاية.البايت < النطاق.النهاية.البايت
                    && (*الحقيقة).النطاق.النهاية.البايت >= أبعد_نهاية) {
                    أبعد_نهاية := (*الحقيقة).النطاق.النهاية.البايت;
                    نوع_المصدر := اختياري.موجود((*الحقيقة).النوع);
                };
                ف := ف + 1;
            }
            طابق نوع_المصدر مع
            | اختياري.موجود(المصدر) -> {
                طابق سبب_تحويل_يتطلب_غير_آمن(الأنواع, المصدر, نوع_الهدف) مع
                | اختياري.موجود(صنف_تحويل_يتطلب_غير_آمن.عدد_إلى_مؤشر) -> { السبب := اختياري.موجود(سبب_تشخيص.سبب_أمان_عدد_إلى_مؤشر_خام()); }
                | اختياري.موجود(صنف_تحويل_يتطلب_غير_آمن.مؤشر_إلى_نوع_آخر) -> { السبب := اختياري.موجود(سبب_تشخيص.سبب_أمان_مؤشر_خام_إلى_نوع_آخر()); }
                | اختياري.موجود(صنف_تحويل_يتطلب_غير_آمن.إضافة_متغير) -> { السبب := اختياري.موجود(سبب_تشخيص.سبب_أمان_إضافة_متغير_لمؤشر_خام()); }
                // `p as &T` keeps its existing message.
                | اختياري.موجود(صنف_تحويل_يتطلب_غير_آمن.مؤشر_إلى_مرجع) -> { }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            و := الطول(*أنواع_التعبيرات) مثل طبيعي;
        }
        | اختياري.لا_شيء -> { و := و + 1; };
    }
    طابق السبب مع
    | اختياري.لا_شيء -> {
        أرجع تشخيصات_فشل_واجهة_عند(
            معرف_تشخيص.عملية_غير_آمنة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
    }
    | اختياري.موجود(سبب_التحويل) -> {
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عملية_غير_آمنة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»);
        ليكن أضف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_التحويل);
        ليكن بلا_حجج: متجه حجة_تشخيص = [];
        ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_لف_التحويل_بغير_آمن(), بلا_حجج
        );
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    };
}

// A name that exists but is private to its module: SULTANC-NAME-PRIVATE
// (was reported as an unknown name). The name is the private declaration.
عرف تشخيصات_تصريح_خاص(
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.تصريح_خاص_غير_متاح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
    );
    ليكن أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»);
    ليكن البايتات: متجه ط8 = بايتات_نطاق_محمل(المحمل, النطاق);
    إذا ((الطول(البايتات) مثل طبيعي) > 0) {
        ليكن أضف_الاسم: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), من_بايتات(&البايتات)
        );
    };
    ليكن أضف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص, مفتاح_صياغة.مساعدة_اجعل_التصريح_عاما(), بلا_حجج
    );
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// The type-table invariant an internal type error names.
عرف سبب_ثابت_أنواع_مكسور(الثابت: ثابت_أنواع_مكسور): سبب_تشخيص {
    طابق الثابت مع
    | ثابت_أنواع_مكسور.تسجيل_نوع_تعبير -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_تسجيل_نوع_تعبير(); }
    | ثابت_أنواع_مكسور.تسجيل_نوع_منشئ -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_تسجيل_نوع_منشئ(); }
    | ثابت_أنواع_مكسور.نوع_حمولة_منشئ -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_نوع_حمولة_منشئ(); }
    | ثابت_أنواع_مكسور.نوع_عنصر_صف -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_نوع_عنصر_صف(); }
    | ثابت_أنواع_مكسور.حجة_بلا_نوع -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_حجة_بلا_نوع(); };
}

// The name of an unknown-name span, as written.
عرف بايتات_نطاق_محمل(المحمل: &خريطة_مصادر, النطاق: نطاق): متجه ط8 {
    طابق مصدر_محمل_بالمعرف(المحمل, النطاق.البداية.المصدر) مع
    | اختياري.موجود(المصدر) -> { أرجع بايتات_اسم_مقنن_واجهة(&المصدر, النطاق); }
    | اختياري.لا_شيء -> {
        ليكن بلا_بايتات: متجه ط8 = [];
        أرجع بلا_بايتات;
    };
}

عرف بايتات_متساوية_واجهة(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// A loaded module's declaration of this name that a false target condition
// left out.
عرف تصريح_لهدف_آخر_باسم(
    المحمل: &خريطة_مصادر,
    الأشجار: &متجه وحدة_مصدر,
    النطاق: نطاق
): اختياري نطاق {
    ليكن الاسم: متجه ط8 = بايتات_نطاق_محمل(المحمل, النطاق);
    إذا ((الطول(الاسم) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    ليكن ش: متغير طبيعي = 0;
    طالما (ش < (الطول(*الأشجار) مثل طبيعي)) {
        ليكن المستبعدة: &متجه نطاق = &(*الأشجار)[ش].المستبعدة_للهدف;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*المستبعدة) مثل طبيعي)) {
            ليكن المرشح: متجه ط8 = بايتات_نطاق_محمل(المحمل, (*المستبعدة)[ف]);
            إذا (بايتات_متساوية_واجهة(&المرشح, &الاسم)) { أرجع اختياري.موجود((*المستبعدة)[ف]); };
            ف := ف + 1;
        }
        ش := ش + 1;
    }
    أرجع اختياري.لا_شيء();
}

// An unknown name that the loaded modules declare only for other targets is
// a target limit (SULTANC-TARGET-FEATURE-UNSUPPORTED), not a typo.
عرف تشخيصات_اسم_مفقود_أو_لهدف_آخر(
    المحمل: &خريطة_مصادر,
    الأشجار: &متجه وحدة_مصدر,
    الهدف: &اختياري واصف_هدف,
    النطاق: نطاق,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    طابق *الهدف مع
    | اختياري.موجود(واصف) -> {
        طابق تصريح_لهدف_آخر_باسم(المحمل, الأشجار, النطاق) مع
        | اختياري.موجود(نطاق_التصريح) -> {
            ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
                معرف_تشخيص.هدف_لا_يدعم_الميزة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
            );
            ليكن أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»);
            ليكن أضف_السبب: منطقي = أضف_سبب_تشخيص(
                &متغير التشخيص, سبب_تشخيص.سبب_هدف_تصريح_لأهداف_أخرى()
            );
            أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, النطاق, مفتاح_حجة_تشخيص.الرمز());
            ليكن أضف_الهدف: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), تهجئة_هدف_مسجل(&واصف)
            );
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التصريح) مع
            | اختياري.موجود(مصدر_التصريح) -> {
                ليكن أضف_التصريح: منطقي = أضف_نطاقا_مرتبطا(
                    &متغير التشخيص, مصدر_التصريح, دور_نطاق_تشخيص.سياق_مرتبط()
                );
            }
            | اختياري.لا_شيء -> { };
            أرجع مجموعة_تشخيص_واحد(&التشخيص);
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع تشخيصات_اسم_غير_معروف(المحمل, النطاق, السبب);
}

عرف تشخيصات_خطأ_معجمي_مفصلة(
    الخطأ: خطأ_معجمي,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_فئة_خطأ_معجمي(الخطأ.الفئة),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق)
    );
    ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «lexer»
    );
    ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_فئة_خطأ_معجمي(الخطأ.الفئة)
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فاصلة_منقوطة_في_غير_موضعها(
    نطاق_الإدراج: نطاق,
    نطاق_الفاصلة: نطاق,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.فاصلة_منقوطة_في_غير_موضعها(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الفاصلة)
    );
    ضع_دور_النطاق_الرئيسي(
        &متغير التشخيص, دور_نطاق_تشخيص.فاصلة_منقوطة_في_غير_موضعها()
    );
    طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج) مع
    | اختياري.موجود(المصدر) -> {
        ليكن أضف_مرتبطا: منطقي = أضف_نطاقا_مرتبطا(
            &متغير التشخيص, المصدر, دور_نطاق_تشخيص.وجهة_فاصلة_منقوطة()
        );
    }
    | اختياري.لا_شيء -> { };
    ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_في_موضع_خاطئ_فاصلة_منقوطة()
    );
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص, مفتاح_صياغة.مساعدة_انقل_فاصلة_منقوطة(), بلا_حجج
    );
    طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج) مع
    | اختياري.موجود(مصدر_الإدراج) -> {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الفاصلة) مع
        | اختياري.موجود(مصدر_الحذف) -> {
            ليكن أضف_الإصلاح: منطقي = أضف_إصلاحا_مركبا_من_تعديلين(
                &متغير التشخيص,
                مصدر_الإدراج,
                «;»,
                مصدر_الحذف,
                «»,
                قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_انقل_فاصلة_منقوطة()
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_تهجئة_كلمة_محجوزة_محتملة(
    الخطأ: خطأ_نحوي,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    ليكن المصدر: اختياري نطاق_مصدر_تشخيص =
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق);
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة(), المصدر
    );
    ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_كلمة_محجوزة_خطأ_إملائي()
    );
    ليكن المتوقع_الإنجليزي: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
    ليكن المتوقع_العربي: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
    ليكن أضف_المتوقع: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.المتوقع(),
        المتوقع_الإنجليزي,
        المتوقع_العربي
    );
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة(),
        بلا_حجج
    );
    طابق الخطأ.التهجئة_المقترحة مع
    | تهجئة_كلمة_مقترحة.عربية -> {
        ليكن استبدال_الحجة: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
        ليكن أضف_الاستبدال: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الاستبدال(), استبدال_الحجة
        );
        // A copy: the fix is added to التشخيص while its source is read.
        طابق انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(&التشخيص.المصدر_الرئيسي) مع
        | اختياري.موجود(مصدر_الإصلاح) -> {
            ليكن استبدال_الإصلاح: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
            ليكن أضف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص,
                مصدر_الإصلاح,
                استبدال_الإصلاح,
                قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة()
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | تهجئة_كلمة_مقترحة.إنجليزية -> {
        ليكن استبدال_الحجة: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
        ليكن أضف_الاستبدال: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الاستبدال(), استبدال_الحجة
        );
        // A copy: the fix is added to التشخيص while its source is read.
        طابق انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(&التشخيص.المصدر_الرئيسي) مع
        | اختياري.موجود(مصدر_الإصلاح) -> {
            ليكن استبدال_الإصلاح: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
            ليكن أضف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص,
                مصدر_الإصلاح,
                استبدال_الإصلاح,
                قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة()
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | تهجئة_كلمة_مقترحة.بلا_اقتراح -> { };
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_عبارة_بلا_عملية(
    الخطأ: خطأ_نحوي,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.عبارة_بلا_عملية(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق)
    );
    ضع_دور_النطاق_الرئيسي(
        &متغير التشخيص, دور_نطاق_تشخيص.عبارة_بلا_عملية()
    );
    ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_عبارة_بلا_عملية()
    );
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_أكمل_العبارة_باستدعاء_أو_إسناد(),
        بلا_حجج
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_خطأ_نحوي_مفصلة(
    الخطأ: خطأ_نحوي,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    إذا (الخطأ.الفئة == فئة_خطأ_نحوي.تهجئة_كلمة_محجوزة_محتملة()) {
        أرجع تشخيصات_تهجئة_كلمة_محجوزة_محتملة(الخطأ, المحمل);
    };
    إذا (الخطأ.الفئة == فئة_خطأ_نحوي.عبارة_بلا_عملية()) {
        أرجع تشخيصات_عبارة_بلا_عملية(الخطأ, المحمل);
    };
    إذا (الخطأ.الفئة == فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود()) {
        ليكن المصدر_الرئيسي: متغير اختياري نطاق_مصدر_تشخيص =
            مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق);
        ليكن الدور_الرئيسي: متغير دور_نطاق_تشخيص = دور_نطاق_تشخيص.اكتشاف_المحلل();
        طابق الخطأ.نطاق_الإدراج مع
        | اختياري.موجود(نطاق_الإدراج) -> {
            المصدر_الرئيسي := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج);
            الدور_الرئيسي := دور_نطاق_تشخيص.موضع_متوقع();
        }
        | اختياري.لا_شيء -> { };
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_ناتج_دالة_مفقود(), المصدر_الرئيسي
        );
        ضع_دور_النطاق_الرئيسي(&متغير التشخيص, الدور_الرئيسي);
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق) مع
        | اختياري.موجود(المصدر) -> {
            ليكن أضف_مرتبطا: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر, دور_نطاق_تشخيص.اكتشاف_المحلل()
            );
        }
        | اختياري.لا_شيء -> { };
        ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
        );
        ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_مفقود_دالة_إرجاع_نوع()
        );
        ليكن بلا_حجج: متجه حجة_تشخيص = [];
        ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_أضف_نوع_ناتج_دالة(), بلا_حجج
        );
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    };
    // A top-level value initialized with a record, tuple or box literal: at
    // the literal, with the reason and a help (no expected/found tokens).
    إذا (الخطأ.الفئة == فئة_خطأ_نحوي.تهيئة_قيمة_عليا_غير_مدعومة()) {
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عنصر_نحوي_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق)
        );
        ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»);
        ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_تهيئة_قيمة_عليا_غير_مدعومة());
        ليكن بلا_حجج: متجه حجة_تشخيص = [];
        ليكن أضف_المساعدة: منطقي = أضف_مساعدة(&متغير التشخيص, مفتاح_صياغة.مساعدة_صرح_بالقيمة_داخل_دالة(), بلا_حجج);
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    };
    إذا (الخطأ.الفئة == فئة_خطأ_نحوي.فاصلة_منقوطة_في_غير_موضعها()) {
        طابق الخطأ.نطاق_الإدراج مع
        | اختياري.موجود(نطاق_الإدراج) -> {
            طابق الخطأ.نطاق_الفاصلة_المنقوطة_في_غير_موضعها مع
            | اختياري.موجود(نطاق_الفاصلة) -> {
                أرجع تشخيصات_فاصلة_منقوطة_في_غير_موضعها(
                    نطاق_الإدراج, نطاق_الفاصلة, المحمل
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    };
    ليكن المصدر_الرئيسي: متغير اختياري نطاق_مصدر_تشخيص =
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق);
    ليكن الدور_الرئيسي: متغير دور_نطاق_تشخيص = دور_نطاق_تشخيص.اكتشاف_المحلل();
    ليكن أضف_اكتشافا_مرتبطا: متغير منطقي = خطأ;
    إذا (الخطأ.المتوقع == رمز.فاصلة_منقوطة()) {
        طابق الخطأ.نطاق_الإدراج مع
        | اختياري.موجود(نطاق_الإدراج) -> {
            المصدر_الرئيسي := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج);
            الدور_الرئيسي := دور_نطاق_تشخيص.موضع_متوقع();
            أضف_اكتشافا_مرتبطا := صواب;
        }
        | اختياري.لا_شيء -> { };
    };
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_فئة_خطأ_نحوي(الخطأ.الفئة), المصدر_الرئيسي
    );
    ضع_دور_النطاق_الرئيسي(&متغير التشخيص, الدور_الرئيسي);
    إذا (أضف_اكتشافا_مرتبطا) {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق) مع
        | اختياري.موجود(المصدر) -> {
            ليكن أضف_مرتبطا: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر, دور_نطاق_تشخيص.اكتشاف_المحلل()
            );
        }
        | اختياري.لا_شيء -> { };
    };
    ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_فئة_خطأ_نحوي(الخطأ.الفئة)
    );
    ليكن المتوقع_الإنجليزي: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
    ليكن المتوقع_العربي: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
    ليكن الموجود_الإنجليزي: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.الموجود);
    ليكن الموجود_العربي: نص = تهجئة_عرض_رمز_عربية(الخطأ.الموجود);
    ليكن أضف_المتوقع: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع_الإنجليزي, المتوقع_العربي
    );
    ليكن أضف_الموجود: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود_الإنجليزي, الموجود_العربي
    );
    // A keyword where a name is expected: say it is reserved.
    إذا (الخطأ.المتوقع == رمز.معرف() && هل_كلمة_محجوزة(الخطأ.الموجود)) {
        ليكن بلا_حجج_اسم: متجه حجة_تشخيص = [];
        ليكن أضف_مساعدة_الاسم: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_اختر_اسما_غير_محجوز(), بلا_حجج_اسم
        );
    };
    إذا (الخطأ.المتوقع == رمز.فاصلة_منقوطة()) {
        ليكن بلا_حجج: متجه حجة_تشخيص = [];
        ليكن أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_أضف_فاصلة_منقوطة(), بلا_حجج
        );
        // A copy: the fix is added to التشخيص while its source is read.
        طابق انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(&التشخيص.المصدر_الرئيسي) مع
        | اختياري.موجود(المصدر) -> {
            ليكن أضف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص, المصدر, «;», قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_أضف_فاصلة_منقوطة()
            );
        }
        | اختياري.لا_شيء -> { };
    };
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف نوع_بلا_غلاف_متغير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): معرف_نوع {
    طابق أزل_غلاف_متغير(الأنواع, النوع) مع
    | اختياري.موجود(الأساس) -> { أرجع الأساس; }
    | اختياري.لا_شيء -> { أرجع النوع; };
}

// A type-phase diagnostic with its typed reason.
عرف ابدأ_تشخيص_نوعي(
    المعرف: معرف_تشخيص,
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    السبب: سبب_تشخيص
): تشخيص {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        المعرف, مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
    );
    ليكن أضف_المرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»
    );
    ليكن أضف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    أرجع التشخيص;
}

عرف مجموعة_تشخيص_واحد(التشخيص: &تشخيص): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, التشخيص);
    أرجع المجموعة;
}

// The source text of a span (a name as written) as a text argument.
عرف أضف_نص_نطاق_تشخيص(
    التشخيص: &متغير تشخيص,
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    المفتاح: مفتاح_حجة_تشخيص
): فراغ {
    طابق مصدر_محمل_بالمعرف(المحمل, النطاق.البداية.المصدر) مع
    | اختياري.موجود(المصدر) -> {
        ليكن البايتات: متجه ط8 = بايتات_اسم_مقنن_واجهة(&المصدر, النطاق);
        إذا ((الطول(البايتات) مثل طبيعي) > 0) {
            ليكن أضف_النص: منطقي = أضف_حجة_تشخيص(التشخيص, المفتاح, من_بايتات(&البايتات));
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف سبب_سياق_عدم_توافق_نوع(السياق: سياق_عدم_توافق_نوع): سبب_تشخيص {
    طابق السياق مع
    | سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان -> { أرجع سبب_تشخيص.سبب_نوع_طرفا_عامل_مختلفان(); }
    | سياق_عدم_توافق_نوع.عامل_يتطلب_منطقيا -> { أرجع سبب_تشخيص.سبب_نوع_عامل_يتطلب_منطقيا(); }
    | سياق_عدم_توافق_نوع.عامل_يتطلب_عددا -> { أرجع سبب_تشخيص.سبب_نوع_عامل_يتطلب_عددا(); }
    | سياق_عدم_توافق_نوع.عامل_يتطلب_عددا_صحيحا -> { أرجع سبب_تشخيص.سبب_نوع_عامل_يتطلب_عددا_صحيحا(); }
    | سياق_عدم_توافق_نوع.شرط_غير_منطقي -> { أرجع سبب_تشخيص.سبب_نوع_شرط_غير_منطقي(); }
    | سياق_عدم_توافق_نوع.قيمة_لا_تطابق_الوجهة -> { أرجع سبب_تشخيص.سبب_نوع_قيمة_لا_تطابق_الوجهة(); }
    | سياق_عدم_توافق_نوع.فهرس_ليس_عددا_صحيحا -> { أرجع سبب_تشخيص.سبب_نوع_فهرس_ليس_عددا_صحيحا(); }
    | سياق_عدم_توافق_نوع.نوع_غير_قابل_للفهرسة -> { أرجع سبب_تشخيص.سبب_نوع_غير_قابل_للفهرسة(); }
    | سياق_عدم_توافق_نوع.فهرس_صف_غير_ثابت -> { أرجع سبب_تشخيص.سبب_نوع_فهرس_صف_غير_ثابت(); }
    | سياق_عدم_توافق_نوع.عدد_عناصر_صف -> { أرجع سبب_تشخيص.سبب_نوع_صف_عدد_عناصر_غير_مطابق(); }
    | سياق_عدم_توافق_نوع.فارغ_بلا_مؤشر -> { أرجع سبب_تشخيص.سبب_نوع_فارغ_يتطلب_مؤشرا(); }
    | سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة -> { أرجع سبب_تشخيص.سبب_نوع_حرفي_لا_يناسب_الوجهة(); }
    | سياق_عدم_توافق_نوع.عدد_حرفي_خارج_المدى -> { أرجع سبب_تشخيص.سبب_نوع_عدد_حرفي_خارج_المدى(); }
    | سياق_عدم_توافق_نوع.تحويل_غير_صالح -> { أرجع سبب_تشخيص.سبب_نوع_تحويل_غير_صالح(); }
    | سياق_عدم_توافق_نوع.سالب_عدد_طبيعي -> { أرجع سبب_تشخيص.سبب_نوع_سالب_عدد_طبيعي(); };
}

// One identity per opaque-type rule (docs/en/reference/type-system.md,
// "Opaque types").
عرف معرف_تشخيص_استعمال_معتم(الاستعمال: صنف_استعمال_معتم): معرف_تشخيص {
    طابق الاستعمال مع
    | صنف_استعمال_معتم.بالقيمة -> { أرجع معرف_تشخيص.نوع_معتم_بالقيمة(); }
    | صنف_استعمال_معتم.حجة_نوع -> { أرجع معرف_تشخيص.نوع_معتم_حجة_نوع(); }
    | صنف_استعمال_معتم.فك -> { أرجع معرف_تشخيص.فك_مؤشر_معتم(); }
    | صنف_استعمال_معتم.حقل -> { أرجع معرف_تشخيص.حقل_عبر_مؤشر_معتم(); }
    | صنف_استعمال_معتم.فهرسة -> { أرجع معرف_تشخيص.حساب_مؤشر_معتم(); };
}

// Whether النطاق is the argument the entry expansion hands `main`'s error
// to the report with (desugar/entry_result.sn, حجة_خطأ_نقطة_الدخول).
عرف نطاق_حجة_خطأ_نقطة_دخول(المحمل: &خريطة_مصادر, النطاق: نطاق): منطقي {
    ليكن المعرف: طبيعي = النطاق.البداية.المصدر مثل طبيعي;
    إذا (المعرف >= (الطول((*المحمل).المصادر) مثل طبيعي)) { أرجع خطأ; };
    ليكن النص: &نص = &(*المحمل).المصادر[المعرف].المحتوى;
    ليكن الحجة: نص = حجة_خطأ_نقطة_الدخول();
    ليكن البداية: طبيعي = النطاق.البداية.البايت مثل طبيعي;
    ليكن النهاية: طبيعي = النطاق.النهاية.البايت مثل طبيعي;
    ليكن الطول_المطلوب: طبيعي = الطول(الحجة) مثل طبيعي;
    إذا (النهاية < البداية || النهاية - البداية != الطول_المطلوب || النهاية > (الطول(*النص) مثل طبيعي)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الطول_المطلوب) {
        إذا ((*النص)[البداية + ف] != الحجة[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// `main` returning `result T, E` with an E that is not std's `Error` /
// `فشل` (SULTANC-ENTRYPOINT-INVALID-SIGNATURE): at E, why, and a fix that
// writes the std error type instead.
عرف تشخيصات_خطأ_نقطة_دخول_ليس_فشلا(
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    الأنواع: &سجل_أنواع,
    سياق_الأسماء: &سياق_أسماء,
    الموجود: معرف_نوع
): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.نقطة_دخول_بتوقيع_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
    );
    ليكن أضيفت_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»);
    ليكن أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نقطة_دخول_خطأ_ليس_فشلا());
    // The found argument is a reference to E: name E itself.
    ليكن نوع_الخطأ: متغير معرف_نوع = الموجود;
    طابق نوع_داخل_مرجع_دلالي(الأنواع, الموجود) مع
    | اختياري.موجود(الداخل) -> { نوع_الخطأ := الداخل; }
    | اختياري.لا_شيء -> { };
    ليكن أضيف_الموجود: منطقي = أضف_نوع_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, نوع_الخطأ
    );
    // The fix writes the std error type in the source's language.
    ليكن المكتوب: نطاق = نطاق_الإبلاغ(المحمل, النطاق);
    ليكن المعرف: طبيعي = المكتوب.البداية.المصدر مثل طبيعي;
    إذا (المعرف < (الطول((*المحمل).المصادر) مثل طبيعي)) {
        ليكن البديل: متغير نص = «فشل»;
        إذا (شفرة_بسطح_إنجليزي(&(*المحمل).المصادر[المعرف].المحتوى)) { البديل := «Error»; };
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, المكتوب) مع
        | اختياري.موجود(مصدر_الإصلاح) -> {
            ليكن بلا_حجج: متجه حجة_تشخيص = [];
            ليكن أضيفت_المساعدة: منطقي = أضف_مساعدة(&متغير التشخيص, مفتاح_صياغة.مساعدة_أرجع_فشلا_من_الرئيسية(), بلا_حجج);
            ليكن أضيف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص, مصدر_الإصلاح, البديل,
                قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح(), مفتاح_صياغة.مساعدة_أرجع_فشلا_من_الرئيسية()
            );
        }
        | اختياري.لا_شيء -> { };
    };
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_خطأ_أنواع(
    الخطأ: خطأ_بناء_سياقات_أنواع,
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع,
    سياق_الأسماء: &سياق_أسماء
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.اسم_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_مفقود_اسم_ربط_اسم()
        );
    }
    | خطأ_بناء_سياقات_أنواع.هوية_اسم_مفقودة(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.اسم_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_مفقود_اسم_هوية()
        );
    }
    | خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نوع_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_غير_محلول_نوع()
        );
    }
    | خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.تعريف_نوع_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_غير_صحيح_نوع_تعريف()
        );
    }
    | خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(النطاق, الثابت) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.تعبير_نوعي_غير_مدعوم(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_ثابت_أنواع_مكسور(الثابت)
        );
    }
    | خطأ_بناء_سياقات_أنواع.توقيع_يتتبع_المستدعي_غير_صالح(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_عند(
            معرف_تشخيص.توقيع_يتتبع_المستدعي_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
    }
    | خطأ_بناء_سياقات_أنواع.استعمال_اتفاقية_سي_غير_صالح(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_عند(
            معرف_تشخيص.استعمال_اتفاقية_سي_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
    }
    | خطأ_بناء_سياقات_أنواع.حجة_موقع_المستدعي_صريحة(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_عند(
            معرف_تشخيص.حجة_موقع_المستدعي_صريحة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
    }
    | خطأ_بناء_سياقات_أنواع.سمة_تصريح_غير_مدعومة(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.سمة_تصريح_غير_مدعومة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_سمة_معالجة_غير_منفذة()
        );
    }
    | خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف(النطاق) -> {
        // The span is the field name as written.
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيص_نوعي(
            معرف_تشخيص.حقل_سجل_غير_معروف(), المحمل, النطاق,
            سبب_تشخيص.سبب_نوع_مجهول_سجل_حقل()
        );
        أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, النطاق, مفتاح_حجة_تشخيص.الرمز());
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.عدد_حمولات_نمط_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عدد_حمولات_نمط_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضيف_المتوقع: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع);
        ليكن أضيف_الموجود: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نمط_غير_صالح(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نمط_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_غير_صحيح_نمط()
        );
    }
    | خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(الرمز, النطاق) -> {
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.حقيقة_دلالية_مفقودة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضف_مرحلة_1: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        ليكن أضف_سبب_1: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_مفقود_رمز_نوع()

        );
        ليكن أضف_الرمز: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة
        );
        أضف_اعتماد_تشخيص_من_نطاق_محمل(&متغير التشخيص, المحمل, النطاق);
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عدد_حجج_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضف_مرحلة_2: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        ليكن أضف_سبب_2: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_استدعاء_حجة_عدد_عدم_تطابق()

        );
        ليكن أضيف_المتوقع: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع
        );
        ليكن أضيف_الموجود: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(النطاق, الفهرس, المتوقع, الموجود) -> {
        // `main`'s error handed to the report in the entry expansion: the
        // author wrote the error type, not this call.
        إذا (نطاق_حجة_خطأ_نقطة_دخول(المحمل, النطاق)) {
            أرجع تشخيصات_خطأ_نقطة_دخول_ليس_فشلا(المحمل, النطاق, الأنواع, سياق_الأسماء, الموجود);
        };
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_حجة_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضف_مرحلة_3: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        ليكن أضف_سبب_3: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_استدعاء_حجة_نوع_عدم_تطابق()

        );
        ليكن أضيف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        ليكن أضيف_المتوقع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, المتوقع
        );
        ليكن أضيف_الموجود: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, الموجود
        );
        ليكن أضيف_إصلاح_النوع: منطقي = أضف_إصلاح_تحويل_نوع(
            &متغير التشخيص, المحمل, الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز,
            النطاق, المتوقع, الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_إرجاع_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_إرجاع_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضف_مرحلة_4: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        ليكن أضف_سبب_4: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_إرجاع_نوع_عدم_تطابق()

        );
        ليكن أضيف_المتوقع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, المتوقع
        );
        ليكن أضيف_الموجود: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, الموجود
        );
        ليكن أضيف_إصلاح_النوع: منطقي = أضف_إصلاح_تحويل_نوع(
            &متغير التشخيص, المحمل, الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز,
            النطاق, المتوقع, الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.عدد_حجج_بدائية_غير_مطابق(النطاق, البدائي, المتوقع, الموجود) -> {
