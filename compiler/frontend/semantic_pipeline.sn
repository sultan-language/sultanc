        ليكن بلا_حجج_المساعدة: متجه حجة_تشخيص = [];
        ليكن أضيفت_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_مرر_نوع_مؤشر_حجة_نوع(), بلا_حجج_المساعدة
        );
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.فهرس_خارج_طول_معروف(النطاق, الفهرس, الطول) -> {
        // The index and the length name the problem; no tuple reason applies.
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.فهرس_خارج_الحدود(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضيفت_المرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»
        );
        ليكن أضيف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        ليكن أضيف_الطول: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول
        );
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.فهرس_صف_خارج_الحدود(النطاق, الفهرس, الطول) -> {
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيص_نوعي(
            معرف_تشخيص.فهرس_خارج_الحدود(), المحمل, النطاق,
            سبب_تشخيص.سبب_نوع_فهرس_صف_خارج_الحدود()
        );
        ليكن أضيف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        ليكن أضيف_الطول: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول
        );
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(النطاق, النوع) -> {
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.تعبير_غير_قابل_للاستدعاء(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضف_مرحلة_9: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        ليكن أضف_سبب_9: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_تعبير_ليس_قابل_للاستدعاء()

        );
        ليكن أضيف_النوع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, النوع
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    };
}

عرف سبب_خطأ_بناء_نمط(الخطأ: خطأ_بناء_نمط): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_بناء_نمط.مصدر_غير_متطابق(_) -> { أرجع سبب_تشخيص.سبب_نمط_مصدر_عدم_تطابق(); }
    | خطأ_بناء_نمط.نطاق_خارج_المصدر(_) -> { أرجع سبب_تشخيص.سبب_نمط_نطاق_مصدر_خارج_مصدر(); }
    | خطأ_بناء_نمط.هوية_اسم_مفقودة(_) -> { أرجع سبب_تشخيص.سبب_نمط_مفقود_اسم_هوية(); }
    | خطأ_بناء_نمط.تابع_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_نمط_غير_صحيح_فرعي(); }
    | خطأ_بناء_نمط.حرفي_غير_مدعوم(_) -> { أرجع سبب_تشخيص.سبب_نمط_غير_مدعوم_قيمة_حرفية(); };
}

عرف نطاق_خطأ_بناء_نمط(الخطأ: خطأ_بناء_نمط): اختياري نطاق {
    طابق الخطأ مع
    | خطأ_بناء_نمط.مصدر_غير_متطابق(النطاق) -> { أرجع اختياري.موجود(النطاق); }
    | خطأ_بناء_نمط.نطاق_خارج_المصدر(النطاق) -> { أرجع اختياري.موجود(النطاق); }
    | خطأ_بناء_نمط.هوية_اسم_مفقودة(النطاق) -> { أرجع اختياري.موجود(النطاق); }
    | خطأ_بناء_نمط.تابع_غير_صالح(_) -> { أرجع اختياري.لا_شيء(); }
    | خطأ_بناء_نمط.حرفي_غير_مدعوم(النطاق) -> { أرجع اختياري.موجود(النطاق); };
}

عرف سبب_خطأ_تكامل_نمط(الخطأ: خطأ_تكامل_نوع_نمط): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(_) -> { أرجع سبب_تشخيص.سبب_نمط_مفقود_مميز_نوع(); }
    | خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(_) -> { أرجع سبب_تشخيص.سبب_نمط_مفقود_منشئ_ربط_اسم(); }
    | خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(_) -> { أرجع سبب_تشخيص.سبب_نمط_غير_دلالي_منشئ(); }
    | خطأ_تكامل_نوع_نمط.تحقق(_) -> { أرجع سبب_تشخيص.سبب_نمط_نوع_فحص_فشل(); };
}

عرف نطاق_خطأ_تكامل_نمط(الخطأ: خطأ_تكامل_نوع_نمط): نطاق {
    طابق الخطأ مع
    | خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(النطاق) -> { أرجع النطاق; }
    | خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(النطاق) -> { أرجع النطاق; }
    | خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(النطاق) -> { أرجع النطاق; }
    | خطأ_تكامل_نوع_نمط.تحقق(النطاق) -> { أرجع النطاق; };
}

عرف هل_خطأ_تكامل_نمط_مشتقا(الخطأ: خطأ_تكامل_نوع_نمط): منطقي {
    طابق الخطأ مع
    | خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(_) -> { أرجع صواب; }
    | خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(_) -> { أرجع صواب; }
    | خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف تشخيصات_خطأ_أنماط_مفصلة(
    الخطأ: خطأ_أنماط_وحدة,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_أنماط_وحدة.بناء(خطأ_البناء) -> {
        ليكن المصدر: متغير اختياري نطاق_مصدر_تشخيص = اختياري.لا_شيء();
        طابق نطاق_خطأ_بناء_نمط(خطأ_البناء) مع
        | اختياري.موجود(النطاق) -> { المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق); }
        | اختياري.لا_شيء -> { };
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.نمط_غير_صالح(), المصدر);
        ليكن أضف_مرحلة_نمط: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «pattern»
        );
        ليكن أضف_سبب_نمط: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_خطأ_بناء_نمط(خطأ_البناء)
        );
        طابق خطأ_البناء مع
        | خطأ_بناء_نمط.تابع_غير_صالح(النمط) -> {
            ليكن أضف_النمط: منطقي = أضف_حجة_طبيعية(
                &متغير التشخيص, مفتاح_حجة_تشخيص.النمط(), النمط.القيمة
            );
        }
        | خطأ_بناء_نمط.هوية_اسم_مفقودة(النطاق) -> {
            أضف_اعتماد_تشخيص_من_نطاق_محمل(&متغير التشخيص, المحمل, النطاق);
        }
        | _ -> { };
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_أنماط_وحدة.نوعي(خطأ_النوع) -> {
        ليكن النطاق: نطاق = نطاق_خطأ_تكامل_نمط(خطأ_النوع);
        إذا (هل_خطأ_تكامل_نمط_مشتقا(خطأ_النوع)) {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق) مع
            | اختياري.موجود(الاعتماد) -> {
                أرجع تشخيصات_فشل_واجهة_مفصلة_مشتقة(
                    معرف_تشخيص.نمط_غير_صالح(),
                    مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
                    الاعتماد, «pattern», سبب_خطأ_تكامل_نمط(خطأ_النوع)
                );
            }
            | اختياري.لا_شيء -> { };
        };
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نمط_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «pattern», سبب_خطأ_تكامل_نمط(خطأ_النوع)
        );
    }
    | خطأ_أنماط_وحدة.غير_شامل(المطابقة) -> {
        أرجع تشخيصات_فشل_واجهة_عند(
            معرف_تشخيص.نمط_غير_شامل(), مصدر_تشخيص_من_نطاق_محمل(المحمل, المطابقة.النطاق)
        );
    };
}

// SULTANC-PATTERN-NON-EXHAUSTIVE: the cases no arm covers
// (up to three by name, then how many more; `_` when the scrutinee has no
// closed set of cases), why, and a fix that adds an arm for each of them.
// The diagnostics of a Patterns error that is a non-exhaustive match (its
// missing cases named), or none for any other Patterns error.
عرف تشخيصات_شمول_خطأ_أنماط(
    الخطأ: &خطأ_أنماط_وحدة,
    سياق_الأسماء: &سياق_أسماء,
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع
): اختياري مجموعة_تشخيصات {
    طابق *الخطأ مع
    | خطأ_أنماط_وحدة.غير_شامل(المطابقة) -> {
        أرجع اختياري.موجود(تشخيصات_نمط_غير_شامل(&المطابقة, سياق_الأسماء, المحمل, الأنواع));
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف تشخيصات_نمط_غير_شامل(
    المطابقة: &مطابقة_غير_شاملة,
    سياق_الأسماء: &سياق_أسماء,
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع
): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.نمط_غير_شامل(), مصدر_تشخيص_من_نطاق_محمل(المحمل, (*المطابقة).نطاق_المميز)
    );
    ليكن أضيفت_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «pattern»);
    ليكن أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نمط_حالات_غير_مغطاة());
    // The source's language spells the arms the fix adds.
    ليكن المصدر: طبيعي = (*المطابقة).النطاق.البداية.المصدر مثل طبيعي;
    ليكن إنجليزي: متغير منطقي = صواب;
    إذا (المصدر < (الطول((*المحمل).المصادر) مثل طبيعي)) {
        إنجليزي := شفرة_بسطح_إنجليزي(&(*المحمل).المصادر[المصدر].المحتوى);
    };
    ليكن لغة_المصدر: متغير لغة_تشخيص = لغة_تشخيص.العربية();
    إذا (إنجليزي) { لغة_المصدر := لغة_تشخيص.الإنجليزية(); };
    ليكن الإنجليزية: متغير متجه نص = [];
    ليكن العربية: متغير متجه نص = [];
    ليكن الأذرع: متغير متجه نص = [];
    طابق (*المطابقة).نوع_المميز مع
    | اختياري.موجود(النوع) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*المطابقة).الناقصة) مثل طبيعي)) {
            ليكن الترتيب: طبيعي = (*المطابقة).الناقصة[ف];
            طابق تهجئة_حالة_نمط_بلغة(
                الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, لغة_تشخيص.الإنجليزية(), النوع, الترتيب
            ) مع
            | اختياري.موجود(الحالة) -> { ألحق(الإنجليزية, الحالة); }
            | اختياري.لا_شيء -> { };
            طابق تهجئة_حالة_نمط_بلغة(
                الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, لغة_تشخيص.العربية(), النوع, الترتيب
            ) مع
            | اختياري.موجود(الحالة) -> { ألحق(العربية, الحالة); }
            | اختياري.لا_شيء -> { };
            طابق تهجئة_حالة_نمط_بلغة(
                الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, لغة_المصدر, النوع, الترتيب
            ) مع
            | اختياري.موجود(الحالة) -> { ألحق(الأذرع, الحالة); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    // Every case has a spelling in both languages, or none is named: some
    // value no arm covers is then `_`.
    ليكن العدد: طبيعي = الطول(الإنجليزية) مثل طبيعي;
    إذا (العدد == 0 || العدد != (الطول(العربية) مثل طبيعي) || العدد != (الطول(الأذرع) مثل طبيعي)) {
        ليكن بدل_إنجليزي: متجه نص = [«_»];
        ليكن بدل_عربي: متجه نص = [«_»];
        ليكن بدل_الذراع: متجه نص = [«_»];
        الإنجليزية := بدل_إنجليزي;
        العربية := بدل_عربي;
        الأذرع := بدل_الذراع;
    };
    ليكن أضيف_النمط: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.النمط(),
        قائمة_حالات_غير_مغطاة(لغة_تشخيص.الإنجليزية(), &الإنجليزية),
        قائمة_حالات_غير_مغطاة(لغة_تشخيص.العربية(), &العربية)
    );
    ليكن أضيف_الإصلاح: منطقي = أضف_إصلاح_أذرع_ناقصة(
        &متغير التشخيص, المحمل, (*المطابقة).نمط_الأخيرة, (*المطابقة).جسم_الأخيرة, &الأذرع
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// Whether a Type can be the program entry's result: nothing, or an integer
// that becomes the process exit status (as C's `main` returns `int`).
عرف ناتج_نقطة_دخول_مقبول(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق صنف_النوع_البدائي(البدائي) مع
            | صنف_نوع_بدائي.عدد_موقع -> { أرجع صواب; }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> { أرجع صواب; }
            | صنف_نوع_بدائي.فراغ -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}

// A program entry whose result is not an exit status is rejected at its
// result Type. A missing fact leaves the decision to the backend.
عرف تشخيصات_ناتج_نقطة_الدخول(
    رمز_البدء: اختياري معرف_رمز,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    الوحدات: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    شجرة_الجذر: اختياري طبيعي,
    المحمل: &خريطة_مصادر
): اختياري مجموعة_تشخيصات {
    ليكن الرمز: معرف_رمز;
    طابق رمز_البدء مع
    | اختياري.موجود(القيمة) -> { الرمز := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن نوع_الدالة: معرف_نوع;
    طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
    | اختياري.موجود(القيمة) -> { نوع_الدالة := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة) مع
    | اختياري.موجود(الناتج) -> {
        إذا (ناتج_نقطة_دخول_مقبول(الأنواع, الناتج)) { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    // Point at the result Type of the entry declaration in the root module.
    ليكن المصدر: متغير اختياري نطاق_مصدر_تشخيص = اختياري.لا_شيء();
    طابق شجرة_الجذر مع
    | اختياري.موجود(الجذر) -> {
        إذا (الجذر < (الطول(*الوحدات) مثل طبيعي) && الجذر < (الطول(*الروابط) مثل طبيعي)) {
            ليكن الوحدة: &وحدة_مصدر = &(*الوحدات)[الجذر];
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
                طابق (*الوحدة).العناصر[ف] مع
                | عنصر_وحدة.دالة(الدالة) -> {
                    طابق رمز_اسم_محلول_عند(&(*الروابط)[الجذر], الدالة.الاسم.النطاق) مع
                    | اختياري.موجود(رمز_الدالة) -> {
                        إذا (رمز_الدالة.القيمة == الرمز.القيمة) {
                            المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_نوع_تركيبي(&الدالة.الناتج));
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
                ف := ف + 1;
            }
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.موجود(تشخيصات_فشل_واجهة_عند(معرف_تشخيص.نقطة_دخول_بتوقيع_غير_صالح(), المصدر));
}

// An arm an earlier arm already covers never runs: a warning at the arm's
// pattern. It does not stop the compilation.
عرف أصدر_تحذيرات_أذرع_غير_قابلة_للوصول(
    النطاقات: &متجه نطاق,
    المحمل: &خريطة_مصادر,
    المجموعة: &متغير مجموعة_تشخيصات
): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النطاقات) مثل طبيعي)) {
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نمط_غير_قابل_للوصول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, (*النطاقات)[ف])
        );
        ضع_دور_النطاق_الرئيسي(&متغير التشخيص, دور_نطاق_تشخيص.نمط_غير_قابل_للوصول());
        أصدر_تشخيصا(المجموعة, &التشخيص);
        ف := ف + 1;
    }
}

// The diagnostics of a source the Frontend rejects, as `check` reports them,
// for tools that lex and parse one source themselves (the formatter): the
// lexical, syntax and internal parser errors keep one owner here.
عام عرف تشخيصات_رفض_مصدر_واجهة(
    الخطأ: خطأ_واجهة_وحدة,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    أرجع تشخيصات_خطأ_واجهة(الخطأ, المحمل);
}

عرف تشخيصات_خطأ_واجهة(
    الخطأ: خطأ_واجهة_وحدة,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_واجهة_وحدة.تحميل(الخطأ) -> {
        ليكن بلا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
        أرجع تشخيصات_خطأ_تحميل_وحدة_مفصلة(الخطأ, بلا_فهرس, اختياري.لا_شيء());
    }
    | خطأ_واجهة_وحدة.تحميل_استيراد(الخطأ, النطاق) -> {
        طابق الخطأ.الخطأ مع
        | خطأ_تحميل_وحدة.تهجئة_وحدة(خطأ_التهجئة) -> {
            أرجع تشخيصات_خطأ_تهجئة_وحدة(خطأ_التهجئة, المحمل);
        }
        | _ -> { };
        // The span is the module path as written: name it, not the import's index.
        ليكن بلا_فهرس: اختياري طبيعي = اختياري.لا_شيء();
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص_خطأ_تحميل_وحدة(الخطأ.الخطأ), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «module-loading»
        );
        أضف_سبب_خطأ_تحميل_وحدة(&متغير التشخيص, الخطأ.الخطأ);
        أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, النطاق, مفتاح_حجة_تشخيص.المسار());
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_واجهة_وحدة.معجم(الخطأ) -> {
        أرجع تشخيصات_خطأ_معجمي_مفصلة(الخطأ, المحمل);
    }
    | خطأ_واجهة_وحدة.نحو(الخطأ) -> {
        أرجع تشخيصات_خطأ_نحوي_مفصلة(الخطأ, المحمل);
    }
    | خطأ_واجهة_وحدة.خلل_نحوي_داخلي -> {
        أرجع تشخيصات_خلل_نحوي_داخلي();
    }
    | خطأ_واجهة_وحدة.أنماط(الخطأ) -> {
        أرجع تشخيصات_خطأ_أنماط_مفصلة(الخطأ, المحمل);
    }
    | خطأ_واجهة_وحدة.تصريح_وحدة_خارج_ملف_الجذر(النطاق, ملف_الجذر) -> {
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.تصريح_وحدة_خارج_ملف_الجذر(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        إذا ((الطول(ملف_الجذر) مثل طبيعي) > 0) {
            ليكن أضف_المسار: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), ملف_الجذر
            );
        };
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_واجهة_وحدة.اشتقاق_جسون_غير_مدعوم(النطاق) -> {
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.اشتقاق_جسون_نوع_حقل_غير_مدعوم(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        ليكن أضف_السبب: منطقي = أضف_سبب_تشخيص(
            &متغير التشخيص, سبب_تشخيص.سبب_جسون_نوع_حقل_غير_قابل_للاشتقاق()
        );
        أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, النطاق, مفتاح_حجة_تشخيص.النوع());
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    };
}

عرف وحدة_نحوية_مسجلة(المسجلة: &متجه منطقي, المعرف: معرف_وحدة): منطقي {
    ليكن الحالة: متجه منطقي = *المسجلة;
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(الحالة) مثل طبيعي)) {
        أرجع خطأ;
    };
    أرجع الحالة[المعرف.القيمة];
}

عرف سجل_وحدة_نحوية(المسجلة: &متغير متجه منطقي, المعرف: معرف_وحدة): فراغ {
    طالما ((الطول(*المسجلة) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) {
        ألحق(*المسجلة, خطأ);
    }
    (*المسجلة)[المعرف.القيمة] := صواب;
}

// The module path as written in an import (`std.text`), or the whole import
// when it has no name path.
عرف نطاق_مسار_استيراد_واجهة(الاستيراد: &استيراد): نطاق {
    ليكن القيمة: استيراد = *الاستيراد;
    طابق القيمة مع
    | استيراد.اسم(النطاق, الأسماء, _) -> {
        ليكن العدد: طبيعي = الطول(الأسماء) مثل طبيعي;
        إذا (العدد == 0) { أرجع النطاق; };
        أرجع دمج_نطاق(الأسماء[0].النطاق, الأسماء[العدد - 1].النطاق);
    }
    | استيراد.نص(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.انتقائي(النطاق, الأسماء, _) -> {
        ليكن العدد: طبيعي = الطول(الأسماء) مثل طبيعي;
        إذا (العدد == 0) { أرجع النطاق; };
        أرجع دمج_نطاق(الأسماء[0].النطاق, الأسماء[العدد - 1].النطاق);
    };
}

عرف نطاق_استيراد_واجهة(الاستيراد: &استيراد): نطاق {
    ليكن القيمة: استيراد = *الاستيراد;
    طابق القيمة مع
    | استيراد.اسم(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.نص(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.انتقائي(النطاق, _, _) -> { أرجع النطاق; };
}

// Lexer tokens are only needed while parsing a single module. Keep this
// call separate from recursive import discovery so its token vector and parser
// temporaries are no longer live while imported modules are loaded.
نوع نتيجة_شجرة_محللة_واجهة =
    | مكتملة بنوع وحدة_مصدر
    | مرفوضة بنوع خطأ_واجهة_وحدة
;

// A keyword written in a deprecated spelling (token_registry.def,
// SULTANC__KEYWORD_DEPRECATED__) compiles as its token. Each such token in the
// module warns once, at the token: the module is lexed once per compilation.
عرف أصدر_تحذيرات_تهجئة_مهجورة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المحمل: &خريطة_مصادر,
    المجموعة: &متغير مجموعة_تشخيصات
): فراغ {
    ليكن الأصل: مصدر = *المصدر;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        ليكن النطاق: نطاق = (*الرموز)[ف].النطاق;
        طابق تهجئة_مهجورة_لرمز(
            (*الرموز)[ف].النوع, &الأصل.المحتوى, النطاق.البداية.البايت, النطاق.النهاية.البايت
        ) مع
        | اختياري.موجود({ القديمة: القديمة, الجديدة: الجديدة }) -> {
            ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
                معرف_تشخيص.تهجئة_مهجورة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
            );
            ليكن أضف_القديمة: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), القديمة
            );
            ليكن أضف_الجديدة: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الجديدة
            );
            أصدر_تشخيصا(المجموعة, &التشخيص);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
}

// A deprecated contextual spelling the Name pass met (the Option type name
// اختيار, the Option constructor بعض): one warning per occurrence, in order.
عرف أصدر_تحذيرات_تهجئات_مربوطة(
    المهجورة: &متجه تهجئة_مهجورة_مربوطة,
    المحمل: &خريطة_مصادر,
    المجموعة: &متغير مجموعة_تشخيصات
): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المهجورة) مثل طبيعي)) {
        ليكن المدخل: &تهجئة_مهجورة_مربوطة = &(*المهجورة)[ف];
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.تهجئة_مهجورة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, (*المدخل).النطاق)
        );
        ليكن أضف_القديمة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), انسخ_نص(&(*المدخل).القديمة)
        );
        ليكن أضف_الجديدة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), انسخ_نص(&(*المدخل).الجديدة)
        );
        أصدر_تشخيصا(المجموعة, &التشخيص);
        ف := ف + 1;
    }
}

عرف حلل_شجرة_محملة_واجهة(
    المصدر: &مصدر,
    الهدف: &اختياري واصف_هدف,
    استرداد_الأدوات: منطقي,
    سياق_المصادر: &متغير خريطة_مصادر,
    تشخيصات_الأدوات: &متغير مجموعة_تشخيصات
): نتيجة_شجرة_محللة_واجهة {
    طابق حلل_معجميا(المصدر) مع
    | نتيجة_تحليل_معجمي.مرفوض(الخطأ) -> {
        أرجع نتيجة_شجرة_محللة_واجهة.مرفوضة(خطأ_واجهة_وحدة.معجم(الخطأ));
    }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        أصدر_تحذيرات_تهجئة_مهجورة(المصدر, &السلسلة.الرموز, سياق_المصادر, تشخيصات_الأدوات);
        إذا (استرداد_الأدوات) {
            ليكن أخطاء_الاسترداد: متغير متجه خطأ_نحوي = [];
            ليكن الشجرة: وحدة_مصدر = حلل_الرموز_للأدوات_لهدف(
                المصدر, &السلسلة.الرموز, الهدف, &متغير أخطاء_الاسترداد
            );
            ليكن أ: متغير طبيعي = 0;
            طالما (أ < (الطول(أخطاء_الاسترداد) مثل طبيعي)) {
                ليكن مجموعة_الخطأ: مجموعة_تشخيصات = تشخيصات_خطأ_نحوي_مفصلة(
                    أخطاء_الاسترداد[أ], سياق_المصادر
                );
                ادمج_مجموعة_تشخيصات(تشخيصات_الأدوات, &مجموعة_الخطأ);
                أ := أ + 1;
            }
            أرجع نتيجة_شجرة_محللة_واجهة.مكتملة(الشجرة);
        } وإلا {
            طابق حلل_الرموز_لهدف(المصدر, &السلسلة.الرموز, الهدف) مع
            | نتيجة_تحليل.مرفوض(الخطأ) -> {
                أرجع نتيجة_شجرة_محللة_واجهة.مرفوضة(خطأ_واجهة_وحدة.نحو(الخطأ));
            }
            | نتيجة_تحليل.خلل_داخلي -> {
                أرجع نتيجة_شجرة_محللة_واجهة.مرفوضة(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
            }
            | نتيجة_تحليل.شجرة(الشجرة) -> {
                أرجع نتيجة_شجرة_محللة_واجهة.مكتملة(الشجرة);
            };
        };
    };
}

// Expansion mutates SourceMap (generated source spans). Give it an
// independent, short-lived source snapshot so no mutable SourceMap borrow
// aliases its input. The snapshot dies before import recursion starts.
عرف وسع_شجرة_محملة_واجهة(
    الشجرة: &متغير وحدة_مصدر,
    سياق_المصادر: &متغير خريطة_مصادر,
    معرف_المصدر: طبيعي,
    الهدف: &اختياري واصف_هدف,
    جذر_البرنامج: منطقي
): منطقي {
    إذا (معرف_المصدر >= (الطول((*سياق_المصادر).المصادر) مثل طبيعي)) {
        أرجع خطأ;
    };
    ليكن مرجع_المصدر: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
    إذا ((*مرجع_المصدر).المعرف != معرف_المصدر) { أرجع خطأ; };
    // Propagation (`؟`) first: decorator expansion copies the expanded bodies.
    ليكن نسخة_الانتشار: مصدر = *مرجع_المصدر;
    إذا (!وسع_انتشار_وحدة(الشجرة, سياق_المصادر, &نسخة_الانتشار, الهدف)) { أرجع خطأ; };
    // The program's entry returning a result (frontend/desugar/entry_result.sn).
    إذا (جذر_البرنامج) {
        ليكن مرجع_المنتشر: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
        ليكن نسخة_الدخول: مصدر = *مرجع_المنتشر;
        إذا (!وسع_نقطة_دخول_بنتيجة(الشجرة, سياق_المصادر, &نسخة_الدخول, الهدف)) { أرجع خطأ; };
    };
    // Derived JSON on types (`@@json`), then definition-time decorators
    // (`@@d`) before the call-time ones (`@d`).
    ليكن مرجع_المشتق: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
    ليكن نسخة_المشتق: مصدر = *مرجع_المشتق;
    إذا (!وسع_اشتقاق_جسون_وحدة(الشجرة, سياق_المصادر, &نسخة_المشتق, الهدف)) { أرجع خطأ; };
    ليكن مرجع_المسجل: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
    ليكن نسخة_المسجلات: مصدر = *مرجع_المسجل;
    إذا (!وسع_مسجلات_تعريف_وحدة(الشجرة, سياق_المصادر, &نسخة_المسجلات, الهدف)) { أرجع خطأ; };
    ليكن مرجع_الممدد: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
    ليكن نسخة_التوسيع: مصدر = *مرجع_الممدد;
    أرجع وسع_مزخرفات_وحدة(الشجرة, سياق_المصادر, &نسخة_التوسيع, الهدف);
}

// The declarations of a module a tooling request could not collect: none,
// so the module still has its aligned (empty) table.
عرف جدول_تصريحات_فارغ_لوحدة(الرسم: &رسم_وحدات, الوحدة: معرف_وحدة): جدول_تصريحات {
    ليكن الدلالية: متغير وحدة_دلالية = { المعرف: الوحدة, النطاق_الجذري: معرف_نطاق_من(0), معرف_المصدر: 0 };
    طابق وحدة_في_الرسم(الرسم, الوحدة) مع
    | اختياري.موجود(القيمة) -> { الدلالية := القيمة; }
    | اختياري.لا_شيء -> { };
    ليكن الرموز: متجه معرف_رمز = [];
    ليكن المكررات: متجه تكرار_تصريح = [];
    ليكن المفقودة: متجه نطاق = [];
    ليكن الخاصة: متجه نطاق = [];
    ليكن التعارضات: متجه نطاق = [];
    ليكن المرادفات: متجه نطاق = [];
    ليكن الجدول: جدول_تصريحات = {
        الوحدة: الدلالية,
        الرموز: الرموز,
        المكررات: المكررات,
        الأهداف_المفقودة: المفقودة,
        الأهداف_الخاصة: الخاصة,
        تعارضات_الربط: التعارضات,
        مرادفات_أب_غير_مطابق: المرادفات
    };
    أرجع الجدول;
}

// A module with no declarations and no imports, for a source a tooling request
// could not read or bind.
عرف شجرة_فارغة_لمصدر(المصدر: طبيعي): وحدة_مصدر {
    ليكن بلا_استيرادات: متجه استيراد = [];
    ليكن بلا_عناصر: متجه عنصر_وحدة = [];
    ليكن بلا_مرادفات: متجه تصريح_مرادف_اسم = [];
    ليكن بلا_مستبعدة: متجه نطاق = [];
    ليكن بلا_تصريحات_وحدات: متجه نطاق = [];
    ليكن الفارغة: وحدة_مصدر = {
        معرف_المصدر: المصدر,
        الاستيرادات: بلا_استيرادات,
        العناصر: بلا_عناصر,
        مرادفات_الأسماء: بلا_مرادفات,
        المستبعدة_للهدف: بلا_مستبعدة,
        تصريحات_الوحدات: بلا_تصريحات_وحدات
    };
    أرجع الفارغة;
}

عرف مصدر_في_قائمة_الوحدات(القائمة: &متجه طبيعي, المصدر: طبيعي): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا ((*القائمة)[ف] == المصدر) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// ---- Setting declarations aside (tooling requests) ---------------------------------
// A tooling request types every module it can. A declaration that uses a name
// resolving into a source the request could not bind (or one set aside before),
// that uses an unknown name, or that a later phase rejects, is set aside before
// typing: a function whose body alone is concerned keeps its signature (its
// body is dropped, so callers still type), any other declaration is dropped and
// its Symbols become unavailable in turn. No declaration that remains refers
// to what is missing, so nothing cascades, and only the sources that lost
// something are marked as having partial Type facts.

عرف نطاق_عنصر_للأدوات(العنصر: &عنصر_وحدة): نطاق {
    طابق *العنصر مع
    | عنصر_وحدة.دالة(التصريح) -> { أرجع التصريح.النطاق; }
    | عنصر_وحدة.نوع(التصريح) -> { أرجع التصريح.النطاق; }
    | عنصر_وحدة.قيمة_عليا(التصريح) -> { أرجع التصريح.النطاق; }
    | عنصر_وحدة.تجميع(النطاق, _) -> { أرجع النطاق; };
}

عرف نطاق_جسم_عنصر_للأدوات(العنصر: &عنصر_وحدة): اختياري نطاق {
    طابق *العنصر مع
    | عنصر_وحدة.دالة(التصريح) -> {
        طابق التصريح.الجسم مع
        | اختياري.موجود(الجسم) -> { أرجع اختياري.موجود(الجسم.النطاق); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// A function whose body alone can be set aside: one whose signature is
// checked without its body. A track-caller or C-convention function needs a
// body, so it is set aside whole rather than reported again without one.
عرف جسم_يسقط_وحده_للأدوات(العنصر: &عنصر_وحدة): منطقي {
    طابق *العنصر مع
    | عنصر_وحدة.دالة(التصريح) -> {
        أرجع !التصريح.يتتبع_المستدعي && !التصريح.اتفاقية_سي;
    }
    | _ -> { أرجع خطأ; };
}

عرف نطاق_داخل_نطاقات_للأدوات(النطاقات: &متجه نطاق, النطاق: نطاق): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النطاقات) مثل طبيعي)) {
        إذا (نطاق_يحتوي_نطاقا((*النطاقات)[ف], النطاق)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The Symbols declared in sources a tooling request could not bind or read.
// Extends المسقطة to every Symbol: the ones declared in a source that could
// not be bound are unavailable.
عرف مدد_رموز_مصادر_فاشلة_للأدوات(
    الناتج: &متغير متجه منطقي,
    سياق_الأسماء: &سياق_أسماء,
    بلا_أسماء: &متجه طبيعي,
    بلا_تصريحات: &متجه طبيعي
): فراغ {
    ليكن ف: متغير طبيعي = الطول(*الناتج) مثل طبيعي;
    طالما (ف < (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
        ليكن المصدر: طبيعي = (*سياق_الأسماء).الرموز[ف].نطاق_الاسم.البداية.المصدر مثل طبيعي;
        ليكن فاشل: منطقي = طول_نطاق_بالبايت((*سياق_الأسماء).الرموز[ف].نطاق_الاسم) > 0
            && (مصدر_في_قائمة_الوحدات(بلا_أسماء, المصدر) || مصدر_في_قائمة_الوحدات(بلا_تصريحات, المصدر));
        ألحق(*الناتج, فاشل);
        ف := ف + 1;
    }
}

// Sets aside, in one rebuild per module, the declarations that contain the
// given spans: the body when the span is in a function's body, else the whole
// declaration (whose Symbols become unavailable). A span already inside a set
// aside region is done. Returns false when a span lies in no declaration of a
// kept module (the failure is not attributable to one).
عرف ضع_جانبا_عند_نطاقات(
    الأشجار: &متغير متجه وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    النطاقات: &متجه نطاق,
    المسقطة: &متغير متجه منطقي,
    المساحات: &متغير متجه نطاق,
    بلا_أنواع: &متغير متجه طبيعي
): منطقي {
    ليكن منسوبة: متغير منطقي = صواب;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النطاقات) مثل طبيعي)) {
        ليكن النطاق: نطاق = (*النطاقات)[ف];
        إذا (!نطاق_داخل_نطاقات_للأدوات(المساحات, النطاق)) {
            ليكن موجود: متغير منطقي = خطأ;
            ليكن و: متغير طبيعي = 0;
            طالما (و < (الطول(*الأشجار) مثل طبيعي) && !موجود) {
                إذا ((*الأشجار)[و].معرف_المصدر == (النطاق.البداية.المصدر مثل طبيعي)) {
                    موجود := ضع_جانبا_في_وحدة(الأشجار, و, سياق_الأسماء, النطاق, المسقطة, المساحات, بلا_أنواع);
                };
                و := و + 1;
            }
            إذا (!موجود) { منسوبة := خطأ; };
        };
        ف := ف + 1;
    }
    أرجع منسوبة;
}

عرف ضع_جانبا_في_وحدة(
    الأشجار: &متغير متجه وحدة_مصدر,
    الموضع: طبيعي,
    سياق_الأسماء: &سياق_أسماء,
    النطاق: نطاق,
    المسقطة: &متغير متجه منطقي,
    المساحات: &متغير متجه نطاق,
    بلا_أنواع: &متغير متجه طبيعي
): منطقي {
    ليكن العناصر: &متجه عنصر_وحدة = &(*الأشجار)[الموضع].العناصر;
    ليكن العدد: طبيعي = الطول(*العناصر) مثل طبيعي;
    ليكن الهدف: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن الجسم_فقط: متغير منطقي = خطأ;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن نطاق_العنصر: نطاق = نطاق_عنصر_للأدوات(&(*العناصر)[ف]);
        إذا (نطاق_يحتوي_نطاقا(نطاق_العنصر, النطاق)) {
            الهدف := اختياري.موجود(ف);
            طابق نطاق_جسم_عنصر_للأدوات(&(*العناصر)[ف]) مع
            | اختياري.موجود(الجسم) -> {
                الجسم_فقط := نطاق_يحتوي_نطاقا(الجسم, النطاق) && جسم_يسقط_وحده_للأدوات(&(*العناصر)[ف]);
                إذا (الجسم_فقط) { ألحق(*المساحات, الجسم); } وإلا { ألحق(*المساحات, نطاق_العنصر); };
            }
            | اختياري.لا_شيء -> { ألحق(*المساحات, نطاق_العنصر); };
            إذا (!الجسم_فقط) {
                // The Symbols this declaration declares become unavailable.
                ليكن ر: متغير طبيعي = 0;
                طالما (ر < (الطول((*سياق_الأسماء).الرموز) مثل طبيعي) && ر < (الطول(*المسقطة) مثل طبيعي)) {
                    إذا (طول_نطاق_بالبايت((*سياق_الأسماء).الرموز[ر].نطاق_الاسم) > 0
                        && نطاق_يحتوي_نطاقا(نطاق_العنصر, (*سياق_الأسماء).الرموز[ر].نطاق_الاسم)) {
                        (*المسقطة)[ر] := صواب;
                    };
                    ر := ر + 1;
                }
            };
        };
        ف := ف + 1;
    }
    ليكن المختار: متغير طبيعي = 0;
    طابق الهدف مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { المختار := القيمة; };
    ليكن الجديدة: متغير متجه عنصر_وحدة = [];
    ف := 0;
    طالما (ف < العدد) {
        إذا (ف != المختار) {
            ألحق(الجديدة, انسخ_مملوكا_عنصر_وحدة(&(*العناصر)[ف]));
        } وإلا إذا (الجسم_فقط) {
            طابق (*العناصر)[ف] مع
            | عنصر_وحدة.دالة(التصريح) -> {
                ليكن النسخة: متغير تصريح_دالة = انسخ_مملوكا_تصريح_دالة(&التصريح);
                النسخة.الجسم := اختياري.لا_شيء();
                ألحق(الجديدة, عنصر_وحدة.دالة(النسخة));
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    (*الأشجار)[الموضع].العناصر := الجديدة;
    ليكن المصدر: طبيعي = (*الأشجار)[الموضع].معرف_المصدر;
    إذا (!مصدر_في_قائمة_الوحدات(بلا_أنواع, المصدر)) { ألحق(*بلا_أنواع, المصدر); };
    أرجع صواب;
}

// Until nothing changes: every kept declaration that uses an unavailable
// Symbol is set aside (which may make more Symbols unavailable). Only the
// modules from البداية on can use a Symbol this stage made unavailable.
عرف ضع_جانبا_المعتمدة(
    الأشجار: &متغير متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    سياق_الأسماء: &سياق_أسماء,
    المسقطة: &متغير متجه منطقي,
    المساحات: &متغير متجه نطاق,
    بلا_أنواع: &متغير متجه طبيعي,
    البداية: طبيعي
): فراغ {
    ليكن تابع: متغير منطقي = صواب;
    طالما (تابع) {
        تابع := خطأ;
        ليكن النطاقات: متغير متجه نطاق = [];
        ليكن و: متغير طبيعي = البداية;
        طالما (و < (الطول(*الروابط) مثل طبيعي)) {
            ليكن مرجع_الروابط: &سياق_روابط_أسماء = &(*الروابط)[و];
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*مرجع_الروابط).الظهورات) مثل طبيعي)) {
                ليكن الظهور: ظهور_اسم_محلول = (*مرجع_الروابط).الظهورات[ف];
                طابق الظهور.الرمز مع
                | اختياري.موجود(الرمز) -> {
                    ليكن ر: طبيعي = الرمز.القيمة مثل طبيعي;
                    إذا (ر < (الطول(*المسقطة) مثل طبيعي) && (*المسقطة)[ر]
                        && !نطاقان_متساويان(الظهور.النطاق, (*سياق_الأسماء).الرموز[ر].نطاق_الاسم)
                        && !نطاق_داخل_نطاقات_للأدوات(المساحات, الظهور.النطاق)) {
                        ألحق(النطاقات, الظهور.النطاق);
                    };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            و := و + 1;
        }
        إذا ((الطول(النطاقات) مثل طبيعي) > 0) {
            ليكن قبل: طبيعي = الطول(*المساحات) مثل طبيعي;
            ليكن منسوبة: منطقي = ضع_جانبا_عند_نطاقات(الأشجار, سياق_الأسماء, &النطاقات, المسقطة, المساحات, بلا_أنواع);
            تابع := (الطول(*المساحات) مثل طبيعي) > قبل;
        };
    }
}

// The span a Type error is about.
عرف نطاق_خطأ_أنواع_للأدوات(الخطأ: &خطأ_بناء_سياقات_أنواع): اختياري نطاق {
    طابق *الخطأ مع
    | خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.هوية_اسم_مفقودة(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(_, س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(س, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.سمة_تصريح_غير_مدعومة(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.توقيع_يتتبع_المستدعي_غير_صالح(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.استعمال_اتفاقية_سي_غير_صالح(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.حجة_موقع_المستدعي_صريحة(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.نمط_غير_صالح(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(س, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.عدد_حمولات_نمط_غير_مطابق(س, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(س, _, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.نوع_إرجاع_غير_مطابق(س, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.عدد_حجج_بدائية_غير_مطابق(س, _, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_مطابق(س, _, _, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(س, _, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.دلالة_بدائي_غير_متاحة(س, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(س, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(س, _, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.إسناد_إلى_غير_موضع(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.حقل_سجل_مفقود(س, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.حقل_سجل_مكرر(س, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.فك_غير_مؤشر(س, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.عامل_غير_معرف(س, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.فهرس_صف_خارج_الحدود(س, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.فهرس_خارج_طول_معروف(س, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.قفز_خارج_حلقة(س) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(س, _, _) -> { أرجع اختياري.موجود(س); }
    | خطأ_بناء_سياقات_أنواع.معتم_في_توقيع_مثيل(س, _, _) -> { أرجع اختياري.موجود(س); };
}

عرف نطاق_خطأ_أنماط_للأدوات(الخطأ: &خطأ_أنماط_وحدة): اختياري نطاق {
    طابق *الخطأ مع
    | خطأ_أنماط_وحدة.بناء(الداخلي) -> { أرجع نطاق_خطأ_بناء_نمط(الداخلي); }
    | خطأ_أنماط_وحدة.نوعي(الداخلي) -> { أرجع اختياري.موجود(نطاق_خطأ_تكامل_نمط(الداخلي)); }
    | خطأ_أنماط_وحدة.غير_شامل(المطابقة) -> { أرجع اختياري.موجود(المطابقة.النطاق); };
}

عرف ألحق_نطاقا_اختياريا(النطاقات: &متغير متجه نطاق, النطاق: اختياري نطاق): فراغ {
    طابق النطاق مع
    | اختياري.موجود(القيمة) -> { ألحق(*النطاقات, القيمة); }
    | اختياري.لا_شيء -> { };
}

عرف نطاق_إعلان_رمز_للأدوات(سياق_الأسماء: &سياق_أسماء, الرمز: اختياري معرف_رمز): اختياري نطاق {
    طابق الرمز مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> {
        إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود((*سياق_الأسماء).الرموز[المعرف.القيمة].نطاق_الاسم);
    };
}

// The phases after Name binding, in order. A rejection carries its
// diagnostics and the spans it is about (none when no source accounts for it).
نوع ناتج_مراحل_لاحقة =
    | مكتملة بنوع حقائق_لاحقة_مرحلية
    | مرفوضة بنوع (مجموعة_تشخيصات, متجه نطاق)
    | ملغاة
    // The Types are built and some bodies hold implicit places (a field read
    // through references, a borrowed text argument): the caller writes them
    // out (frontend/desugar/implicit_places.sn) and runs the phases again.
    | مواضع_ضمنية بنوع متجه موضع_ضمني
;

// Runs the later phases over the modules from البداية on (every module for a
// compilation), continuing الأساس: the facts of the modules before it.
عرف شغل_المراحل_اللاحقة(
    أشجار_الوحدات: &متجه وحدة_مصدر,
    سياق_المصادر: &خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    روابط_الوحدات: &متجه سياق_روابط_أسماء,
    هدف_المحمل: &اختياري واصف_هدف,
    رمز_بدء_البرنامج: اختياري معرف_رمز,
    شجرة_الجذر: اختياري طبيعي,
    التحذيرات: &متغير مجموعة_تشخيصات,
    الإلغاء: &حالة_إلغاء_واجهة,
    الأساس: حقائق_لاحقة_مرحلية,
    البداية: طبيعي,
    كتبت_الضمنية: منطقي
): ناتج_مراحل_لاحقة {
    طابق الأساس مع
    | {
        سياقات_الأنواع: أنواع_الأساس,
        سياق_الأنماط: أنماط_الأساس,
        الأخطاء_السابقة: _,
        الذاكرة: _
    } -> {
        أرجع شغل_المراحل_اللاحقة_من(
            أشجار_الوحدات, سياق_المصادر, سياق_الأسماء, روابط_الوحدات, هدف_المحمل,
            رمز_بدء_البرنامج, شجرة_الجذر, التحذيرات, الإلغاء,
            أنواع_الأساس, أنماط_الأساس, البداية, كتبت_الضمنية
        );
    };
}

عرف شغل_المراحل_اللاحقة_من(
    أشجار_الوحدات: &متجه وحدة_مصدر,
    سياق_المصادر: &خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    روابط_الوحدات: &متجه سياق_روابط_أسماء,
    هدف_المحمل: &اختياري واصف_هدف,
    رمز_بدء_البرنامج: اختياري معرف_رمز,
    شجرة_الجذر: اختياري طبيعي,
    التحذيرات: &متغير مجموعة_تشخيصات,
    الإلغاء: &حالة_إلغاء_واجهة,
    أنواع_الأساس: سياقات_أنواع_وحدة,
    أنماط_الأساس: سياق_أنماط_وحدة,
    البداية: طبيعي,
    كتبت_الضمنية: منطقي
): ناتج_مراحل_لاحقة {
    ليكن بلا_نطاقات: متجه نطاق = [];
    // The program entry is checked with the modules that hold its root.
    ليكن بدء_المرحلة: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    طابق شجرة_الجذر مع
    | اختياري.موجود(موضع_الجذر) -> {
        إذا (موضع_الجذر >= البداية) { بدء_المرحلة := رمز_بدء_البرنامج; };
    }
    | اختياري.لا_شيء -> { };
    طابق ابن_سياقات_أنواع_وحدات_من(أنواع_الأساس, البداية, أشجار_الوحدات, سياق_الأسماء, روابط_الوحدات, الإلغاء) مع
    | نتيجة_بناء_سياقات_أنواع.ملغاة -> { أرجع ناتج_مراحل_لاحقة.ملغاة(); }
    | نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع_الجزئية) -> {
        ليكن تشخيصات_المرحلة: مجموعة_تشخيصات = تشخيصات_خطأ_أنواع(
            الخطأ, سياق_المصادر, &الأنواع_الجزئية, سياق_الأسماء
        );
        ليكن النطاقات: متغير متجه نطاق = [];
        ألحق_نطاقا_اختياريا(&متغير النطاقات, نطاق_خطأ_أنواع_للأدوات(&الخطأ));
        أرجع ناتج_مراحل_لاحقة.مرفوضة(تشخيصات_المرحلة, النطاقات);
    }
    | نتيجة_بناء_سياقات_أنواع.مبنية({
        الأنواع: الأنواع,
        أنواع_التعبيرات: أنواع_التعبيرات,
        أنواع_الرموز: أنواع_الرموز,
        علاقات_هرم_الأنواع: علاقات_هرم_الأنواع
    }) -> {
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مراحل_لاحقة.ملغاة(); };
        // Implicit places are written out once, before any later phase reads
        // the bodies that hold them.
        إذا (!كتبت_الضمنية) {
            ليكن المواضع: متغير متجه موضع_ضمني = [];
            ليكن م_ض: متغير طبيعي = البداية;
            طالما (م_ض < (الطول(أنواع_التعبيرات) مثل طبيعي)) {
                ليكن ح_ض: متغير طبيعي = 0;
                طالما (ح_ض < (الطول(أنواع_التعبيرات[م_ض].مواضع_ضمنية) مثل طبيعي)) {
                    ألحق(المواضع, أنواع_التعبيرات[م_ض].مواضع_ضمنية[ح_ض]);
                    ح_ض := ح_ض + 1;
                }
                م_ض := م_ض + 1;
            }
            إذا ((الطول(المواضع) مثل طبيعي) > 0) { أرجع ناتج_مراحل_لاحقة.مواضع_ضمنية(المواضع); };
        };
        // `p as u32` is an address word only where pointers are 32 bits.
        ليكن عرض_المؤشر: متغير طبيعي = 64;
        طابق *هدف_المحمل مع
        | اختياري.موجود(واصف_الهدف) -> { عرض_المؤشر := واصف_الهدف.نموذج_البيانات.عرض_المؤشر; }
        | اختياري.لا_شيء -> { };
        طابق أول_تحويل_عنوان_32_مرفوض(&أنواع_التعبيرات, عرض_المؤشر) مع
        | اختياري.موجود(الخطأ) -> {
            ليكن تشخيصات_العنوان: مجموعة_تشخيصات = تشخيصات_خطأ_أنواع(
                الخطأ, سياق_المصادر, &الأنواع, سياق_الأسماء
            );
            ليكن النطاقات: متغير متجه نطاق = [];
            ألحق_نطاقا_اختياريا(&متغير النطاقات, نطاق_خطأ_أنواع_للأدوات(&الخطأ));
            أرجع ناتج_مراحل_لاحقة.مرفوضة(تشخيصات_العنوان, النطاقات);
        }
        | اختياري.لا_شيء -> { };
        // The program entry returns nothing or an integer exit status.
        طابق تشخيصات_ناتج_نقطة_الدخول(
            بدء_المرحلة, &الأنواع, &أنواع_الرموز, أشجار_الوحدات, روابط_الوحدات,
            شجرة_الجذر, سياق_المصادر
        ) مع
        | اختياري.موجود(التشخيصات) -> {
            ليكن النطاقات: متغير متجه نطاق = [];
            ألحق_نطاقا_اختياريا(&متغير النطاقات, نطاق_إعلان_رمز_للأدوات(سياق_الأسماء, رمز_بدء_البرنامج));
            أرجع ناتج_مراحل_لاحقة.مرفوضة(التشخيصات, النطاقات);
        }
        | اختياري.لا_شيء -> { };
        // Raw-pointer operations and raw kernel calls require an explicit unsafe scope.
        طابق أول_عملية_غير_آمنة_في_وحدات_من(البداية, أشجار_الوحدات, &الأنواع, &أنواع_التعبيرات, روابط_الوحدات, سياق_الأسماء, سياق_المصادر) مع
        | اختياري.موجود(نطاق_العملية) -> {
            ليكن تشخيصات_المرحلة: مجموعة_تشخيصات = تشخيصات_عملية_غير_آمنة(
                سياق_المصادر, &الأنواع, &أنواع_التعبيرات, نطاق_العملية
            );
            ليكن النطاقات: متجه نطاق = [نطاق_العملية];
            أرجع ناتج_مراحل_لاحقة.مرفوضة(تشخيصات_المرحلة, النطاقات);
        }
        | اختياري.لا_شيء -> { };
        // A closure handed to another thread captures only what may cross threads.
        طابق أول_انتهاك_التقاط_خيط_في_وحدات_من(
            البداية, أشجار_الوحدات, &الأنواع, &أنواع_التعبيرات, &أنواع_الرموز, روابط_الوحدات, سياق_الأسماء
        ) مع
        | اختياري.موجود(الانتهاك) -> {
            ليكن تشخيصات_المرحلة: مجموعة_تشخيصات = تشخيصات_انتهاك_التقاط_خيط(
                &الانتهاك, سياق_الأسماء, سياق_المصادر, &الأنواع
            );
            ليكن النطاقات: متجه نطاق = [الانتهاك.النطاق];
            أرجع ناتج_مراحل_لاحقة.مرفوضة(تشخيصات_المرحلة, النطاقات);
        }
        | اختياري.لا_شيء -> { };
        ليكن أذرع_غير_قابلة_للوصول: متغير متجه نطاق = [];
        طابق ابن_أنماط_وحدات_من(
            أنماط_الأساس, البداية, أشجار_الوحدات, سياق_المصادر, سياق_الأسماء, روابط_الوحدات,
            &الأنواع, &أنواع_التعبيرات, &متغير أذرع_غير_قابلة_للوصول, الإلغاء
        ) مع
        | نتيجة_أنماط_وحدة.ملغاة -> { أرجع ناتج_مراحل_لاحقة.ملغاة(); }
        | نتيجة_أنماط_وحدة.مرفوضة(الخطأ) -> {
            ليكن النطاقات: متغير متجه نطاق = [];
            ألحق_نطاقا_اختياريا(&متغير النطاقات, نطاق_خطأ_أنماط_للأدوات(&الخطأ));
            // A match that is not exhaustive names its missing cases, which
            // takes the Name and Type facts.
            طابق تشخيصات_شمول_خطأ_أنماط(&الخطأ, سياق_الأسماء, سياق_المصادر, &الأنواع) مع
            | اختياري.موجود(تشخيصات_الشمول) -> { أرجع ناتج_مراحل_لاحقة.مرفوضة(تشخيصات_الشمول, النطاقات); }
            | اختياري.لا_شيء -> { };
            ليكن تشخيصات_المرحلة: مجموعة_تشخيصات = تشخيصات_خطأ_واجهة(
                خطأ_واجهة_وحدة.أنماط(الخطأ), سياق_المصادر
            );
            أرجع ناتج_مراحل_لاحقة.مرفوضة(تشخيصات_المرحلة, النطاقات);
        }
        | نتيجة_أنماط_وحدة.مكتملة({
            الأنماط: الأنماط,
            التحققات: التحققات
        }) -> {
            إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مراحل_لاحقة.ملغاة(); };
            أصدر_تحذيرات_أذرع_غير_قابلة_للوصول(
                &أذرع_غير_قابلة_للوصول, سياق_المصادر, التحذيرات
            );
            // Memory and SSF borrow canonical Type/Pattern contexts in place.
            // No flattened Type/Pattern copies are manufactured between phases.
            طابق ابن_ذاكرة_وحدة(&الأنواع) مع
            | نتيجة_ذاكرة_وحدة.مرفوضة(الخطأ) -> {
                ليكن تشخيصات_المرحلة: مجموعة_تشخيصات = تشخيصات_خطأ_ذاكرة(
                    الخطأ, &الأنواع, سياق_الأسماء
                );
                أرجع ناتج_مراحل_لاحقة.مرفوضة(تشخيصات_المرحلة, بلا_نطاقات);
            }
            | نتيجة_ذاكرة_وحدة.مكتملة(سياق_الذاكرة_المبني) -> {
                إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مراحل_لاحقة.ملغاة(); };
                // The legality of ownership is the ownership analysis's on
                // MSIR (msir/ssf/ownership_legality.sn), after the Frontend.
                ليكن سياقات_الأنواع: سياقات_أنواع_وحدة = {
                    الأنواع: الأنواع,
                    أنواع_التعبيرات: أنواع_التعبيرات,
                    أنواع_الرموز: أنواع_الرموز,
                    علاقات_هرم_الأنواع: علاقات_هرم_الأنواع
                };
                ليكن سياق_الأنماط: سياق_أنماط_وحدة = {
                    الأنماط: الأنماط,
                    التحققات: التحققات
                };
                ليكن الحقائق: حقائق_لاحقة_مرحلية = {
                    سياقات_الأنواع: سياقات_الأنواع,
                    سياق_الأنماط: سياق_الأنماط,
                    الأخطاء_السابقة: مجموعة_تشخيصات_جديدة(),
                    الذاكرة: سياق_الذاكرة_المبني
                };
                أرجع ناتج_مراحل_لاحقة.مكتملة(الحقائق);
            };
        };
    };
}

// Only an internal failure (a broken invariant, a cancellation) stops a tooling
// request's loading; a user's error in a source is recorded and loading goes on.
عرف خطأ_واجهة_داخلي(الخطأ: &خطأ_واجهة_وحدة): منطقي {
    طابق *الخطأ مع
    | خطأ_واجهة_وحدة.خلل_نحوي_داخلي -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف خطأ_تحميل_استيرادات_فارغ(): خطأ_تحميل_استيرادات {
    ليكن الناتج: خطأ_تحميل_استيرادات = { الفهرس: 0, الخطأ: خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة() };
    أرجع الناتج;
}

عرف حلل_وحدة_محملة_مع_استيراداتها(
    المحمل: &متغير محمل_وحدات, سياق_المصادر: &متغير خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء, الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية, المعرف: معرف_وحدة,
    الوحدات: &متغير متجه وحدة_نحوية_محملة,
    أشجار_الوحدات: &متغير متجه وحدة_مصدر,
    الوحدات_المسجلة: &متغير متجه منطقي,
    استرداد_الأدوات: منطقي,
    تشخيصات_الأدوات: &متغير مجموعة_تشخيصات,
    الإلغاء: &حالة_إلغاء_واجهة,
    جذر_البرنامج: منطقي,
    // A tooling request (استرداد_الأدوات) records here, with the diagnostics in
    // تشخيصات_الأدوات, what a compilation reports as its one load error.
    الإخفاقات: &متغير إخفاقات_تحميل_أدوات
): اختياري خطأ_واجهة_وحدة {
    إذا (هل_واجهة_ملغاة(الإلغاء)) {
        أرجع اختياري.موجود(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
    };
    إذا (وحدة_نحوية_مسجلة(الوحدات_المسجلة, المعرف)) {
        أرجع اختياري.لا_شيء();
    };
    طابق معرف_مصدر_وحدة_محملة_بالمعرف(المحمل, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_واجهة_وحدة.تحميل(خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة()));
    }
    | اختياري.موجود(معرف_المصدر) -> {
        // SourceMap is the sole owner of text. Borrow its checked SourceID
        // for parsing and expansion; do not allocate a second source buffer.
        إذا (معرف_المصدر >= (الطول((*سياق_المصادر).المصادر) مثل طبيعي)) {
            أرجع اختياري.موجود(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
        };
        ليكن مرجع_المصدر: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
        إذا ((*مرجع_المصدر).المعرف != معرف_المصدر) {
            أرجع اختياري.موجود(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
        };
        طابق حلل_شجرة_محملة_واجهة(
            مرجع_المصدر, &(*المحمل).الهدف, استرداد_الأدوات,
            سياق_المصادر, تشخيصات_الأدوات
        ) مع
        | نتيجة_شجرة_محللة_واجهة.مرفوضة(الخطأ) -> {
            إذا (!استرداد_الأدوات || خطأ_واجهة_داخلي(&الخطأ)) { أرجع اختياري.موجود(الخطأ); };
            // The source cannot be read as tokens: it stands as an empty module,
            // so its importers still load and bind what they can.
            ليكن تشخيصات_المصدر: مجموعة_تشخيصات = تشخيصات_خطأ_واجهة(الخطأ, سياق_المصادر);
            ادمج_مجموعة_تشخيصات(تشخيصات_الأدوات, &تشخيصات_المصدر);
            سجل_مصدرا_في_قائمة_أدوات(&متغير (*الإخفاقات).بلا_تصريحات, معرف_المصدر);
            ليكن الفارغة: وحدة_مصدر = شجرة_فارغة_لمصدر(معرف_المصدر);
            ليكن فهرس_الفارغة: طبيعي = الطول(*أشجار_الوحدات) مثل طبيعي;
            ألحق(*أشجار_الوحدات, الفارغة);
            ليكن سجل_الفارغة: وحدة_نحوية_محملة = { الوحدة: المعرف, الشجرة: فهرس_الفارغة };
            ألحق(*الوحدات, سجل_الفارغة);
            سجل_وحدة_نحوية(الوحدات_المسجلة, المعرف);
            أرجع اختياري.لا_شيء();
        }
        | نتيجة_شجرة_محللة_واجهة.مكتملة(الشجرة_النحوية) -> {
            // The lexer/parser frame has ended before import recursion.
            ليكن الشجرة: متغير وحدة_مصدر = الشجرة_النحوية;
            // `module` belongs to a folder's root file only (module_spellings.sn).
            إذا ((الطول(الشجرة.تصريحات_الوحدات) مثل طبيعي) > 0) {
                طابق وحدة_محملة_بالمعرف(المحمل, المعرف) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(المحملة) -> {
                    إذا (!وحدة_ملف_جذر(البيئة, &المحملة.المفتاح)) {
                        ليكن ملف_الجذر: متغير نص = «»;
                        طابق ملف_جذر_مجلد_الوحدة(البيئة, &المحملة.المفتاح) مع
                        | اختياري.موجود(القيمة) -> { ملف_الجذر := القيمة; }
                        | اختياري.لا_شيء -> { };
                        ليكن خطأ_الموضع: خطأ_واجهة_وحدة = خطأ_واجهة_وحدة.تصريح_وحدة_خارج_ملف_الجذر(
                            الشجرة.تصريحات_الوحدات[0], ملف_الجذر
                        );
                        إذا (!استرداد_الأدوات) { أرجع اختياري.موجود(خطأ_الموضع); };
                        // A tooling request records it on this source and
                        // analyses the rest: the declaration names nothing.
                        ليكن تشخيصات_الموضع: مجموعة_تشخيصات = تشخيصات_خطأ_واجهة(خطأ_الموضع, سياق_المصادر);
                        ادمج_مجموعة_تشخيصات(تشخيصات_الأدوات, &تشخيصات_الموضع);
                        سجل_مصدرا_في_قائمة_أدوات(&متغير (*الإخفاقات).بلا_تحميل, معرف_المصدر);
                    };
                };
            };
            // A `@@json` field type that cannot be derived is a compile-time
            // error at the field, not a JSON null at run time.
            إذا (معرف_المصدر < (الطول((*سياق_المصادر).المصادر) مثل طبيعي)) {
                طابق أول_نوع_حقل_جسون_غير_قابل_للاشتقاق(&الشجرة, &(*سياق_المصادر).المصادر[معرف_المصدر]) مع
                | اختياري.موجود(نطاق_الحقل) -> {
                    ليكن خطأ_الاشتقاق: خطأ_واجهة_وحدة = خطأ_واجهة_وحدة.اشتقاق_جسون_غير_مدعوم(نطاق_الحقل);
                    إذا (!استرداد_الأدوات) { أرجع اختياري.موجود(خطأ_الاشتقاق); };
                    ليكن تشخيصات_الاشتقاق: مجموعة_تشخيصات = تشخيصات_خطأ_واجهة(خطأ_الاشتقاق, سياق_المصادر);
                    ادمج_مجموعة_تشخيصات(تشخيصات_الأدوات, &تشخيصات_الاشتقاق);
                    سجل_مصدرا_في_قائمة_أدوات(&متغير (*الإخفاقات).بلا_تحميل, معرف_المصدر);
                }
                | اختياري.لا_شيء -> { };
            };
            إذا (!وسع_شجرة_محملة_واجهة(
                &متغير الشجرة, سياق_المصادر, معرف_المصدر, &(*المحمل).الهدف, جذر_البرنامج
            )) {
                أرجع اختياري.موجود(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
            };
            إذا (!ابدأ_تحميل_استيرادات_وحدة(المحمل, المعرف)) {
                أرجع اختياري.موجود(
                    خطأ_واجهة_وحدة.تحميل(خطأ_تحميل_وحدة.دورة_استيراد())
                );
            };
            ليكن أخطاء_الاستيرادات: متغير متجه خطأ_تحميل_استيرادات = [];
            ليكن نتيجة_الاستيرادات: متغير نتيجة_تحميل_استيرادات = نتيجة_تحميل_استيرادات.خطأ(
                خطأ_تحميل_استيرادات_فارغ()
            );
            إذا (استرداد_الأدوات) {
                نتيجة_الاستيرادات := حمل_استيرادات_مباشرة_متسامحا(
                    المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المعرف, &الشجرة,
                    &متغير أخطاء_الاستيرادات
                );
                // Each import that cannot be loaded is that source's diagnostic;
                // the statement adds no edge and the other imports load.
                ليكن ح_خطأ: متغير طبيعي = 0;
                طالما (ح_خطأ < (الطول(أخطاء_الاستيرادات) مثل طبيعي)) {
                    ليكن خطأ_الاستيراد: خطأ_تحميل_استيرادات = أخطاء_الاستيرادات[ح_خطأ];
                    ليكن نطاق_الاستيراد_الفاشل: متغير نطاق = نطاق_فارغ();
                    ليكن نطاق_العبارة_الفاشلة: متغير نطاق = نطاق_فارغ();
                    إذا (خطأ_الاستيراد.الفهرس < (الطول(الشجرة.الاستيرادات) مثل طبيعي)) {
                        نطاق_الاستيراد_الفاشل := نطاق_مسار_استيراد_واجهة(&الشجرة.الاستيرادات[خطأ_الاستيراد.الفهرس]);
                        نطاق_العبارة_الفاشلة := نطاق_استيراد_واجهة(&الشجرة.الاستيرادات[خطأ_الاستيراد.الفهرس]);
                    };
                    ليكن تشخيصات_الاستيراد: مجموعة_تشخيصات = تشخيصات_خطأ_واجهة(
                        خطأ_واجهة_وحدة.تحميل_استيراد(خطأ_الاستيراد, نطاق_الاستيراد_الفاشل), سياق_المصادر
                    );
                    ادمج_مجموعة_تشخيصات(تشخيصات_الأدوات, &تشخيصات_الاستيراد);
                    ألحق((*الإخفاقات).الاستيرادات, نطاق_العبارة_الفاشلة);
                    سجل_مصدرا_في_قائمة_أدوات(&متغير (*الإخفاقات).بلا_تحميل, معرف_المصدر);
                    ح_خطأ := ح_خطأ + 1;
                }
            } وإلا {
                نتيجة_الاستيرادات := حمل_استيرادات_مباشرة(
                    المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المعرف, &الشجرة
                );
            };
            طابق نتيجة_الاستيرادات مع
            | نتيجة_تحميل_استيرادات.خطأ(الخطأ) -> {
                انه_تحميل_استيرادات_وحدة(المحمل, المعرف);
                ليكن نطاق_الاستيراد: متغير نطاق = نطاق_فارغ();
                إذا (الخطأ.الفهرس < (الطول(الشجرة.الاستيرادات) مثل طبيعي)) {
                    نطاق_الاستيراد := نطاق_مسار_استيراد_واجهة(&الشجرة.الاستيرادات[الخطأ.الفهرس]);
                };
                أرجع اختياري.موجود(
                    خطأ_واجهة_وحدة.تحميل_استيراد(الخطأ, نطاق_الاستيراد)
                );
            }
            | نتيجة_تحميل_استيرادات.محملة(المعرفات) -> {
                ليكن فهرس_الشجرة: طبيعي = الطول(*أشجار_الوحدات) مثل طبيعي;
                ألحق(*أشجار_الوحدات, الشجرة);
                ليكن سجل: وحدة_نحوية_محملة = { الوحدة: المعرف, الشجرة: فهرس_الشجرة };
                ألحق(*الوحدات, سجل);
                سجل_وحدة_نحوية(الوحدات_المسجلة, المعرف);

                ليكن ف: متغير طبيعي = 0;
                طالما (ف < (الطول(المعرفات) مثل طبيعي)) {
                    طابق حلل_وحدة_محملة_مع_استيراداتها(
                        المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة,
                        المعرفات[ف], الوحدات, أشجار_الوحدات, الوحدات_المسجلة,
                        استرداد_الأدوات, تشخيصات_الأدوات, الإلغاء, خطأ, الإخفاقات
                    ) مع
                    | اختياري.موجود(الخطأ) -> {
                        انه_تحميل_استيرادات_وحدة(المحمل, المعرف);
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | _ -> { };
                    ف := ف + 1;
                }
                انه_تحميل_استيرادات_وحدة(المحمل, المعرف);
            };
        };
    };
    أرجع اختياري.لا_شيء();
}

عام نوع طلب_واجهة_وحدة = {
    البيئة: بيئة_وحدات_منطقية,
    المفتاح_الجذري: مفتاح_وحدة_مقنن,
    احتفظ_بحقائق_الأدوات: منطقي
};

// Project/tooling analysis reuses one canonical Module/Name/Type universe for every
// supplied project root.  The caller supplies source inventory; Module remains the
// owner of canonical keys, import closure, SourceIDs and ModuleIDs.
عام نوع طلب_واجهة_مشروع = {
    البيئة: بيئة_وحدات_منطقية,
    المفاتيح_الجذرية: متجه مفتاح_وحدة_مقنن,
    احتفظ_بحقائق_الأدوات: منطقي
};

عرف تشخيصات_تصريح_مكرر_مفصلة(
    سياق_الأسماء: &سياق_أسماء,
    المحمل: &خريطة_مصادر,
    الموجود: معرف_رمز,
    النطاق_الجديد: نطاق
): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.تصريح_مكرر(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق_الجديد)
    );
    ليكن أضف_مرحلة_10: منطقي = أضف_حجة_تشخيص(

        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»

    );

    ليكن أضف_سبب_10: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_اسم_مكرر_تصريح()

    );
    // The name as written; the Symbol number only when it has no name.
    طابق تهجئة_اسم_رمز(&(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, الموجود) مع
    | اختياري.موجود(الاسم) -> {
        ليكن أضف_الاسم: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الاسم
        );
    }
    | اختياري.لا_شيء -> {
        ليكن أضف_الرمز: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الموجود.القيمة
        );
    };
    طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, الموجود) مع
    | اختياري.موجود(النطاق_السابق) -> {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق_السابق) مع
        | اختياري.موجود(المصدر_السابق) -> {
            ليكن أضف_السابق: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر_السابق, دور_نطاق_تشخيص.سياق_مرتبط()
            );
            ليكن بلا_حجج: متجه حجة_تشخيص = [];
            ليكن أضف_الملاحظة: منطقي = أضف_ملاحظة(
                &متغير التشخيص, مفتاح_صياغة.ملاحظة_التصريح_السابق(), بلا_حجج
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف سبب_خطأ_ذاكرة_نوع(الخطأ: خطأ_ذاكرة_نوع): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_ذاكرة_نوع.معرف_نوع_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_غير_صحيح_نوع_معرف(); }
    | خطأ_ذاكرة_نوع.دورة_ملكية_نوع(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_ملكية_دورة(); }
    | خطأ_ذاكرة_نوع.بنية_سجل_غير_متاحة(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_سجل_بنية_غير_متاح(); }
    | خطأ_ذاكرة_نوع.حقل_سجل_غير_متاح(_, _) -> { أرجع سبب_تشخيص.سبب_ذاكرة_سجل_حقل_غير_متاح(); }
    | خطأ_ذاكرة_نوع.بنية_نوع_موسوم_غير_متاحة(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_موسوم_بنية_غير_متاح(); }
    | خطأ_ذاكرة_نوع.منشئ_نوع_غير_متاح(_, _) -> { أرجع سبب_تشخيص.سبب_ذاكرة_منشئ_غير_متاح(); }
    | خطأ_ذاكرة_نوع.حمولة_منشئ_غير_متاحة(_, _, _) -> { أرجع سبب_تشخيص.سبب_ذاكرة_منشئ_حمولة_غير_متاح(); }
    | خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(_) -> { أرجع سبب_تشخيص.سبب_ذاكرة_غير_متوقع_نوع_بنية(); };
}

عرف نوع_خطأ_ذاكرة(الخطأ: خطأ_ذاكرة_نوع): معرف_نوع {
    طابق الخطأ مع
    | خطأ_ذاكرة_نوع.معرف_نوع_غير_صالح(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.دورة_ملكية_نوع(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.بنية_سجل_غير_متاحة(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.حقل_سجل_غير_متاح(النوع, _) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.بنية_نوع_موسوم_غير_متاحة(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.منشئ_نوع_غير_متاح(النوع, _) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.حمولة_منشئ_غير_متاحة(النوع, _, _) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(النوع) -> { أرجع النوع; };
}

عرف تشخيصات_خطأ_ذاكرة(
    الخطأ: خطأ_ذاكرة_نوع,
    الأنواع: &سجل_أنواع,
    سياق_الأسماء: &سياق_أسماء
): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_ذاكرة_نوع(), اختياري.لا_شيء()
    );
    ليكن أضف_مرحلة_ذاكرة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «memory»
    );
    ليكن أضف_سبب_ذاكرة: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_خطأ_ذاكرة_نوع(الخطأ)
    );
    ليكن النوع: معرف_نوع = نوع_خطأ_ذاكرة(الخطأ);
    ليكن أضف_النوع: منطقي = أضف_نوع_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع,
        &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, النوع
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف معرف_تشخيص_خطأ_تدفق_سلامة(الخطأ: خطأ_تدفق_سلامة): معرف_تشخيص {
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(_, _) -> { أرجع معرف_تشخيص.استخدام_قبل_التهيئة(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(_) -> { أرجع معرف_تشخيص.استخدام_بعد_النقل(); }
    // Ownership states that differ where control flow joins: a user error.
    | خطأ_تدفق_سلامة.دمج_غير_صالح(_) -> { أرجع معرف_تشخيص.تعارض_ملكية_عند_الدمج(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_التحرير(_) -> { أرجع معرف_تشخيص.مورد_محرر(); }
    | خطأ_تدفق_سلامة.تحرير_مكرر(_) -> { أرجع معرف_تشخيص.مورد_محرر(); }
    | خطأ_تدفق_سلامة.تعارض_استعارة(_, _) -> { أرجع معرف_تشخيص.تعارض_استعارة(); }
    | خطأ_تدفق_سلامة.هروب_غير_صالح(_) -> { أرجع معرف_تشخيص.هروب_مرجع(); }
    | خطأ_تدفق_سلامة.مرجع_بعد_إتلاف(_) -> { أرجع معرف_تشخيص.هروب_مرجع(); }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(_, _) -> { أرجع معرف_تشخيص.نقل_جزئي_مملوك(); }
    | خطأ_تدفق_سلامة.نقل_من_مرجع(_) -> { أرجع معرف_تشخيص.نقل_من_مرجع(); }
    | خطأ_تدفق_سلامة.قيد_عادي_منتهك(_) -> { أرجع معرف_تشخيص.نقل_من_مرجع(); }
    // A user error (assigning to a local declared without `mutable`), not an ICE.
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(_, _) -> { أرجع معرف_تشخيص.كتابة_إلى_غير_متغير(); }
    // Releasing storage the function does not own (a module value) gives up
    // ownership it never had, like moving out of borrowed storage.
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(_, _) -> { أرجع معرف_تشخيص.نقل_من_مرجع(); };
}

عرف سبب_خطأ_تدفق_سلامة(الخطأ: خطأ_تدفق_سلامة): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(_, _) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_إسناد_إلى_ثابت(); }
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(_, _) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استخدام_قبل_تهيئة(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استخدام_بعد_نقل_ملكية(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_التحرير(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استخدام_بعد_تحرير(); }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(_, _) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_غير_صحيح_نقل_ملكية(); }
    | خطأ_تدفق_سلامة.نقل_من_مرجع(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_نقل_من_مرجع(); }
    | خطأ_تدفق_سلامة.قيد_عادي_منتهك(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_قيد_عادي_منتهك(); }
    | خطأ_تدفق_سلامة.تحرير_مكرر(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_مزدوج_تحرير(); }
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(_, _) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_تحرير_غير_مملوك(); }
    | خطأ_تدفق_سلامة.تعارض_استعارة(_, النوع) -> {
        طابق النوع مع
        | نوع_استعارة.مشتركة -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استعارة_تعارض_مشترك(); }
        | نوع_استعارة.حصرية -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_استعارة_تعارض_حصري(); };
    }
    | خطأ_تدفق_سلامة.دمج_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_غير_صحيح_تحكم_تدفق_دمج(); }
    | خطأ_تدفق_سلامة.هروب_غير_صالح(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_غير_صحيح_مرجع_تسرب(); }
    | خطأ_تدفق_سلامة.مرجع_بعد_إتلاف(_) -> { أرجع سبب_تشخيص.سبب_تدفق_سلامة_غير_صحيح_مرجع_تسرب(); };
}

عرف رمز_خطأ_تدفق_سلامة(الخطأ: خطأ_تدفق_سلامة): اختياري معرف_رمز {
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(الرمز, _) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز, _) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق) -> { أرجع اختياري.موجود(السياق.الرمز); }
    | خطأ_تدفق_سلامة.استخدام_بعد_التحرير(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز, _) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.نقل_من_مرجع(السياق) -> { أرجع السياق.الرمز; }
    | خطأ_تدفق_سلامة.تحرير_مكرر(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز, _) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, _) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | خطأ_تدفق_سلامة.مرجع_بعد_إتلاف(السياق) -> { أرجع اختياري.موجود(السياق.الحامل); }
    | خطأ_تدفق_سلامة.قيد_عادي_منتهك(_) -> { أرجع اختياري.لا_شيء(); };
}

// The spawn capture check's diagnostic: the captured (or shared) name and
// its Type, at its use inside the closure.
عرف تشخيصات_انتهاك_التقاط_خيط(
    الانتهاك: &انتهاك_التقاط_خيط,
    سياق_الأسماء: &سياق_أسماء,
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع
): مجموعة_تشخيصات {
    ليكن المعرف: متغير معرف_تشخيص = معرف_تشخيص.التقاط_خيط_مؤشر_خام();
    طابق (*الانتهاك).الصنف مع
    | صنف_انتهاك_التقاط_خيط.مؤشر_خام -> { }
    | صنف_انتهاك_التقاط_خيط.مرجع_مستعار -> { المعرف := معرف_تشخيص.التقاط_خيط_مرجع(); }
    | صنف_انتهاك_التقاط_خيط.مشترك_غير_ذري -> { المعرف := معرف_تشخيص.التقاط_خيط_مشترك_غير_ذري(); };
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        المعرف, مصدر_تشخيص_من_نطاق_محمل(المحمل, (*الانتهاك).النطاق)
    );
    ليكن أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»);
    طابق تهجئة_اسم_رمز(&(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, (*الانتهاك).الرمز) مع
    | اختياري.موجود(الاسم) -> {
        ليكن أضف_الاسم: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الاسم);
    }
    | اختياري.لا_شيء -> { };
    طابق (*الانتهاك).النوع مع
    | اختياري.موجود(النوع) -> {
        ليكن أضف_النوع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع,
            &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, النوع
        );
    }
    | اختياري.لا_شيء -> { };
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// The declaration span of a Symbol (نطاق_تصريح_رمز_عند) from the Symbols alone.
عرف نطاق_تصريح_رمز_في_رموز(الرموز: &متجه رمز_دلالي, الرمز: معرف_رمز): اختياري نطاق {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول(*الرموز) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الرموز)[الرمز.القيمة].نطاق_التصريح);
}

// A diagnostic marked at a use: the primary span is the invalid use, and
// the declaration of الرمز a related span ("declared here").
عرف أضف_تصريح_استخدام_تدفق(
    التشخيص: &متغير تشخيص,
    الرموز: &متجه رمز_دلالي,
    المحمل: &خريطة_مصادر,
    الرمز: معرف_رمز
): فراغ {
    ضع_دور_النطاق_الرئيسي(التشخيص, دور_نطاق_تشخيص.استخدام_غير_صالح());
    طابق نطاق_تصريح_رمز_في_رموز(الرموز, الرمز) مع
    | اختياري.موجود(نطاق_التصريح) -> {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التصريح) مع
        | اختياري.موجود(مصدر_التصريح) -> {
            ليكن أضيف: منطقي = أضف_نطاقا_مرتبطا(التشخيص, مصدر_التصريح, دور_نطاق_تشخيص.مصرح_هنا());
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
}

// The diagnostics of a flow-safety error from the Name facts alone (names and
// Symbols), so the ownership legality analysis on MSIR, which runs after the
// Frontend, states them exactly as SSF does.
عام عرف تشخيصات_خطأ_تدفق_سلامة_بالرموز(
    الخطأ: خطأ_تدفق_سلامة,
    الأسماء: &متجه اسم_مقنن,
    الرموز: &متجه رمز_دلالي,
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع
): مجموعة_تشخيصات {
    ليكن المصدر: متغير اختياري نطاق_مصدر_تشخيص = اختياري.لا_شيء();
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.نقل_من_مرجع(السياق) -> {
        المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, السياق.الموضع);
    }
    | خطأ_تدفق_سلامة.قيد_عادي_منتهك(السياق) -> {
        المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, السياق.الموضع);
    }
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(الرمز, اختياري.موجود(نطاق_الإسناد)) -> {
        المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإسناد);
    }
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز, اختياري.موجود(نطاق_التحرير)) -> {
        المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التحرير);
    }
    // A read before initialization and a partial move are marked at the
    // use; the declaration is a related span (below).
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز, اختياري.موجود(نطاق_الاستخدام)) -> {
        المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الاستخدام);
    }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز, اختياري.موجود(نطاق_الاستخدام)) -> {
        المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الاستخدام);
    }
    // A borrow that outlives its owner is marked where the owner is
    // destroyed (else at the owner's declaration).
    | خطأ_تدفق_سلامة.مرجع_بعد_إتلاف(السياق) -> {
        طابق السياق.الإتلاف مع
        | اختياري.موجود(النطاق) -> { المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق); }
        | اختياري.لا_شيء -> {
            طابق نطاق_تصريح_رمز_في_رموز(الرموز, السياق.المالك) مع
            | اختياري.موجود(النطاق) -> { المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق); }
            | اختياري.لا_شيء -> { };
        };
    }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق) -> {
        طابق السياق.الاستخدام مع
        | اختياري.موجود(النطاق) -> {
            المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق);
        }
        | اختياري.لا_شيء -> {
            طابق نطاق_تصريح_رمز_في_رموز(الرموز, السياق.الرمز) مع
            | اختياري.موجود(النطاق) -> {
                المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق);
            }
            | اختياري.لا_شيء -> { };
        };
    }
    | _ -> {
        طابق رمز_خطأ_تدفق_سلامة(الخطأ) مع
        | اختياري.موجود(الرمز) -> {
            طابق نطاق_تصريح_رمز_في_رموز(الرموز, الرمز) مع
            | اختياري.موجود(النطاق) -> {
                المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق);
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    };
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_خطأ_تدفق_سلامة(الخطأ), المصدر
    );
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق) -> {
        طابق السياق.الاستخدام مع
        | اختياري.موجود(_) -> {
            ضع_دور_النطاق_الرئيسي(
                &متغير التشخيص, دور_نطاق_تشخيص.استخدام_غير_صالح()
            );
            طابق نطاق_تصريح_رمز_في_رموز(الرموز, السياق.الرمز) مع
            | اختياري.موجود(نطاق_التصريح) -> {
                طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التصريح) مع
                | اختياري.موجود(مصدر_التصريح) -> {
                    ليكن أضف_المالك: منطقي = أضف_نطاقا_مرتبطا(
                        &متغير التشخيص,
                        مصدر_التصريح,
                        دور_نطاق_تشخيص.المالك_الأصلي()
                    );
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        طابق السياق.أصل_النقل مع
        | اختياري.موجود(نطاق_النقل) -> {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_النقل) مع
            | اختياري.موجود(مصدر_النقل) -> {
                ليكن أضف_النقل: منطقي = أضف_نطاقا_مرتبطا(
                    &متغير التشخيص,
                    مصدر_النقل,
                    دور_نطاق_تشخيص.أصل_النقل()
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز, اختياري.موجود(_)) -> {
        أضف_تصريح_استخدام_تدفق(&متغير التشخيص, الرموز, المحمل, الرمز);
    }
    // The owner's declaration, then the later use of the borrow.
    | خطأ_تدفق_سلامة.مرجع_بعد_إتلاف(السياق) -> {
        طابق نطاق_تصريح_رمز_في_رموز(الرموز, السياق.المالك) مع
        | اختياري.موجود(نطاق_التصريح) -> {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التصريح) مع
            | اختياري.موجود(مصدر_التصريح) -> {
                ليكن أضف_المالك: منطقي = أضف_نطاقا_مرتبطا(
                    &متغير التشخيص, مصدر_التصريح, دور_نطاق_تشخيص.المالك_الأصلي()
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        طابق السياق.الاستخدام مع
        | اختياري.موجود(نطاق_الاستخدام) -> {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الاستخدام) مع
            | اختياري.موجود(مصدر_الاستخدام) -> {
                ليكن أضف_الاستخدام: منطقي = أضف_نطاقا_مرتبطا(
                    &متغير التشخيص, مصدر_الاستخدام, دور_نطاق_تشخيص.استخدام_غير_صالح()
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز, اختياري.موجود(_)) -> {
        أضف_تصريح_استخدام_تدفق(&متغير التشخيص, الرموز, المحمل, الرمز);
    }
    | خطأ_تدفق_سلامة.قيد_عادي_منتهك(السياق) -> {
        // The function, its type parameter and the owning type: the
        // headline names all three (iSpeak, عنوان_قيد_عادي).
        طابق السياق.الدالة مع
        | اختياري.موجود(رمز_الدالة) -> {
            طابق تهجئة_اسم_رمز_بلغة(الأسماء, الرموز, رمز_الدالة, لغة_تشخيص.الإنجليزية()) مع
            | اختياري.موجود(الإنجليزي) -> {
                طابق تهجئة_اسم_رمز_بلغة(الأسماء, الرموز, رمز_الدالة, لغة_تشخيص.العربية()) مع
                | اختياري.موجود(العربي) -> {
                    ليكن أضيفت_الدالة: منطقي = أضف_حجة_ثنائية_اللغة(
                        &متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الإنجليزي, العربي
                    );
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        طابق تهجئة_اسم_رمز(الأسماء, الرموز, السياق.المعامل) مع
        | اختياري.موجود(اسم_المعامل) -> {
            ليكن أضيف_المعامل: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), اسم_المعامل);
        }
        | اختياري.لا_شيء -> { };
        ليكن أضيف_النوع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع, الأسماء, الرموز, السياق.الحجة
        );
        ليكن بلا_حجج_المساعدة: متجه حجة_تشخيص = [];
        ليكن أضيفت_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_استعمل_صيغة_تنسخ(), بلا_حجج_المساعدة
        );
    }
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(الرمز, اختياري.موجود(_)) -> {
        ضع_دور_النطاق_الرئيسي(&متغير التشخيص, دور_نطاق_تشخيص.استخدام_غير_صالح());
        طابق نطاق_تصريح_رمز_في_رموز(الرموز, الرمز) مع
        | اختياري.موجود(نطاق_التصريح) -> {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التصريح) مع
            | اختياري.موجود(مصدر_التصريح) -> {
                ليكن أضف_التصريح: منطقي = أضف_نطاقا_مرتبطا(
                    &متغير التشخيص, مصدر_التصريح, دور_نطاق_تشخيص.تصريح_غير_قابل_للتغيير()
                );
                ليكن أضف_إصلاح_التغيير: منطقي = أضف_إصلاح_اجعل_ربطا_متغيرا(
                    &متغير التشخيص, المحمل, نطاق_التصريح
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    ليكن أضف_مرحلة_تدفق: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «ssf»
    );
    ليكن أضف_سبب_تدفق: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_خطأ_تدفق_سلامة(الخطأ)
    );
    // The Symbol is named as written; its number is kept only when it has no name.
    طابق رمز_خطأ_تدفق_سلامة(الخطأ) مع
    | اختياري.موجود(الرمز) -> {
        طابق تهجئة_اسم_رمز(الأسماء, الرموز, الرمز) مع
        | اختياري.موجود(الاسم) -> {
            ليكن أضف_الاسم: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الاسم
            );
        }
        | اختياري.لا_شيء -> {
            ليكن أضف_الرمز: منطقي = أضف_حجة_طبيعية(
                &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة
            );
        };
    }
    | اختياري.لا_شيء -> { };
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف نتيجة_واجهة_ملغاة(): نتيجة_بناء_واجهة_وحدة {
    أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
        تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
            «frontend», سبب_تشخيص.سبب_واجهة_أمامية_ملغى()
        )
    );
}

عرف معرف_مصدر_شجرة_واجهة(الشجرة: &وحدة_مصدر): طبيعي {
    أرجع (*الشجرة).معرف_المصدر;
}

عرف ضع_روابط_وحدة_واجهة(
    الروابط: &متغير متجه سياق_روابط_أسماء,
    الفهرس: طبيعي,
    القيمة: سياق_روابط_أسماء
): فراغ {
    (*الروابط)[الفهرس] := القيمة;
}

// A tooling request keeps going where a compilation stops: when the Name pass
// cannot bind a module, or a later phase rejects the program, the request
// still returns every module's canonical Name facts (the modules that bound),
// with the phase's diagnostics in تشخيصات_الأدوات and the incomplete sources
// in حقائق_الأدوات. Type, Pattern and ownership facts are then absent. A compilation
// (احتفظ_بحقائق_الأدوات false) is rejected exactly as before.
عرف واجهة_أدوات_ناقصة(
    أشجار_الوحدات: متجه وحدة_مصدر,
    سياق_المصادر: خريطة_مصادر,
    سياق_الأسماء: سياق_أسماء,
    روابط_الوحدات: متجه سياق_روابط_أسماء,
    الرسم: &رسم_وحدات,
    رمز_بدء_البرنامج: اختياري معرف_رمز,
    تشخيصات_الأدوات: مجموعة_تشخيصات,
    بلا_أسماء: &متجه طبيعي,
    الإخفاقات: &إخفاقات_تحميل_أدوات
): نتيجة_بناء_واجهة_وحدة {
    ليكن حقائق_الأدوات: حقائق_أدوات_واجهة = حقائق_أدوات_ناقصة(الرسم, &أشجار_الوحدات, بلا_أسماء, الإخفاقات);
    ليكن الوحدات_الدلالية: متجه وحدة_دلالية = الوحدات_الدلالية_للرسم(الرسم);
    ليكن فهرس_التصريحات: فهرس_تصريحات = ابن_فهرس_تصريحات(&أشجار_الوحدات, &روابط_الوحدات);
    طابق استخلص_حقائق_أسماء_مستمرة(سياق_الأسماء, صواب) مع
    | { هويات_البدائيات: هويات_البدائيات, استعلامات: استعلامات_الأسماء } -> {
        ليكن أنواع_التعبيرات: متجه سياق_أنواع_تعبيرات = [];
        ليكن علاقات_هرم_الأنواع: متجه علاقة_هرم_نوع = [];
        ليكن سياقات_الأنواع: سياقات_أنواع_وحدة = {
            الأنواع: سجل_أنواع_جديد(),
            أنواع_التعبيرات: أنواع_التعبيرات,
            أنواع_الرموز: سياق_أنواع_رموز_جديد(),
            علاقات_هرم_الأنواع: علاقات_هرم_الأنواع
        };
        ليكن التحققات: متجه ربط_تحقق_نمط_وحدة = [];
        ليكن سياق_الأنماط: سياق_أنماط_وحدة = {
            الأنماط: سجل_أنماط_جديد(),
            التحققات: التحققات
        };
        ليكن بلا_رموز: متجه معرف_رمز = [];
        ليكن بلا_تنسيق: متجه معرف_رمز = [];
        ليكن الناتج: نتيجة_واجهة_وحدة = {
            الوحدات: أشجار_الوحدات,
            أصل_نواة_لينكس: اختياري.لا_شيء(),
            رموز_لا_تعود: بلا_رموز,
            رموز_التنسيق: بلا_تنسيق,
            عرض_مؤشر_الهدف: 64,
            الوحدات_الدلالية: الوحدات_الدلالية,
            خريطة_المصادر: سياق_المصادر,
            هويات_البدائيات: هويات_البدائيات,
            روابط_الأسماء: روابط_الوحدات,
            فهرس_التصريحات: فهرس_التصريحات,
            استعلامات_الأسماء: استعلامات_الأسماء,
            رمز_بدء_البرنامج: رمز_بدء_البرنامج,
            سياقات_الأنواع: سياقات_الأنواع,
            سياق_الأنماط: سياق_الأنماط,
            كاملة_دلاليا: خطأ,
            تشخيصات_الأدوات: تشخيصات_الأدوات,
            الأسماء_المنقولة: [],
            ملكية_محللة: خطأ,
            دوال_ملكية_متروكة: [],
            حقائق_الأدوات: حقائق_الأدوات,
            الذاكرة: سياق_ذاكرة_وحدة_فارغ()
        };
        أرجع نتيجة_بناء_واجهة_وحدة.مكتملة(الناتج);
    };
}

// A phase rejected the program: a compilation is rejected with التشخيصات; a
// tooling request returns the degraded result carrying them.
عرف ارفض_أو_أنه_للأدوات(
    احتفظ_بحقائق_الأدوات: منطقي,
    التشخيصات: مجموعة_تشخيصات,
    أشجار_الوحدات: متجه وحدة_مصدر,
    سياق_المصادر: خريطة_مصادر,
    سياق_الأسماء: سياق_أسماء,
    روابط_الوحدات: متجه سياق_روابط_أسماء,
    الرسم: &رسم_وحدات,
    رمز_بدء_البرنامج: اختياري معرف_رمز,
    تشخيصات_الأدوات: مجموعة_تشخيصات,
    بلا_أسماء: &متجه طبيعي,
    الإخفاقات: &إخفاقات_تحميل_أدوات
): نتيجة_بناء_واجهة_وحدة {
    إذا (!احتفظ_بحقائق_الأدوات) { أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات); };
    ليكن الكل: متغير مجموعة_تشخيصات = تشخيصات_الأدوات;
    ادمج_مجموعة_تشخيصات(&متغير الكل, &التشخيصات);
    أرجع واجهة_أدوات_ناقصة(
        أشجار_الوحدات, سياق_المصادر, سياق_الأسماء, روابط_الوحدات,
        الرسم, رمز_بدء_البرنامج, الكل, بلا_أسماء, الإخفاقات
    );
}

// The state of one analysis: every module loaded so far, in load order, and
// the facts of the first المعالجة of them. A compilation builds it once over
// every module (one stage). Incremental tooling analysis
// (incremental_analysis.sn) keeps copies of it between requests and analyses
// the modules a request adds in later stages: a module never imports one
// loaded after the stage it is analysed in, so each stage only continues the
// facts before it.
عام نوع حالة_واجهة_مرحلية = {
    سياق_المصادر: خريطة_مصادر,
    سياق_الأسماء: سياق_أسماء,
    الرسم: رسم_وحدات,
    المحمل: محمل_وحدات,
    الجذر: اختياري معرف_وحدة,
    الوحدات: متجه وحدة_نحوية_محملة,
    // Canonical AST owner: each parsed module tree is appended exactly once.
    أشجار_الوحدات: متجه وحدة_مصدر,
    الوحدات_المسجلة: متجه منطقي,
    تشخيصات_الأدوات: مجموعة_تشخيصات,
    إخفاقات_التحميل: إخفاقات_تحميل_أدوات,
    // Sources a tooling request could not bind (their diagnostics are kept),
    // and sources bound except for unknown names.
    بلا_أسماء: متجه طبيعي,
    مربوطة_جزئيا: متجه طبيعي,
    التصريحات_المجمعة: متجه جدول_تصريحات,
    روابط_الوحدات: متجه سياق_روابط_أسماء,
    شجرة_الجذر: اختياري طبيعي,
    رمز_بدء_البرنامج: اختياري معرف_رمز,
    // Set-aside declarations (ضع_جانبا_في_وحدة).
    المسقطة: متجه منطقي,
    المساحات_المسقطة: متجه نطاق,
    بلا_أنواع: متجه طبيعي,
    اللاحقة: حقائق_لاحقة_مرحلية,
    // A stage took the last resort: only Name facts remain.
    الأنواع_متوقفة: منطقي,
    المعالجة: طبيعي
};

عام عرف حالة_واجهة_مرحلية_جديدة(الهدف: اختياري واصف_هدف): حالة_واجهة_مرحلية {
    ليكن المحمل: متغير محمل_وحدات = محمل_وحدات_جديد();
    حدد_هدف_محمل_وحدات(&متغير المحمل, الهدف);
    ليكن الوحدات: متجه وحدة_نحوية_محملة = [];
    ليكن الأشجار: متجه وحدة_مصدر = [];
    ليكن المسجلة: متجه منطقي = [];
    ليكن بلا_أسماء: متجه طبيعي = [];
    ليكن مربوطة_جزئيا: متجه طبيعي = [];
    ليكن التصريحات: متجه جدول_تصريحات = [];
    ليكن الروابط: متجه سياق_روابط_أسماء = [];
    ليكن المسقطة: متجه منطقي = [];
    ليكن المساحات: متجه نطاق = [];
    ليكن بلا_أنواع: متجه طبيعي = [];
    ليكن الحالة: حالة_واجهة_مرحلية = {
        سياق_المصادر: خريطة_مصادر_جديدة(),
        سياق_الأسماء: سياق_أسماء_جديد(),
        الرسم: رسم_وحدات_جديد(),
        المحمل: المحمل,
        الجذر: اختياري.لا_شيء(),
        الوحدات: الوحدات,
        أشجار_الوحدات: الأشجار,
        الوحدات_المسجلة: المسجلة,
        تشخيصات_الأدوات: مجموعة_تشخيصات_جديدة(),
        إخفاقات_التحميل: إخفاقات_تحميل_أدوات_جديدة(),
        بلا_أسماء: بلا_أسماء,
        مربوطة_جزئيا: مربوطة_جزئيا,
        التصريحات_المجمعة: التصريحات,
        روابط_الوحدات: الروابط,
        شجرة_الجذر: اختياري.لا_شيء(),
        رمز_بدء_البرنامج: اختياري.لا_شيء(),
        المسقطة: المسقطة,
        المساحات_المسقطة: المساحات,
        بلا_أنواع: بلا_أنواع,
        اللاحقة: حقائق_لاحقة_مرحلية_فارغة(),
        الأنواع_متوقفة: خطأ,
        المعالجة: 0
    };
    أرجع الحالة;
}

عرف وحدة_هي_الجذر(الجذر: &اختياري معرف_وحدة, الوحدة: معرف_وحدة): منطقي {
    طابق *الجذر مع
    | اختياري.موجود(المعرف) -> { أرجع معرفا_وحدة_متساويان(المعرف, الوحدة); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام نوع ناتج_مرحلة_واجهة =
    | مكتملة بنوع حالة_واجهة_مرحلية
    | مرفوضة بنوع مجموعة_تشخيصات
    | ملغاة
;

// Loads one root module and its imports into the state. The program root
// (أساسي) must load; another root that cannot be loaded is a tooling
// request's diagnostic and a compilation's rejection. A module already in
// the state is not loaded again.
عام عرف حمل_جذرا_في_حالة(
    الحالة: حالة_واجهة_مرحلية,
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    أساسي: منطقي,
    احتفظ_بحقائق_الأدوات: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): ناتج_مرحلة_واجهة {
    ليكن الحالة_م: متغير حالة_واجهة_مرحلية = الحالة;
    طابق حمل_وحدة_جذر(
        &متغير الحالة_م.المحمل,
        &متغير الحالة_م.سياق_المصادر,
        &متغير الحالة_م.سياق_الأسماء,
        &متغير الحالة_م.الرسم,
        البيئة_المدخلة,
        المفتاح
    ) مع
    | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
        ليكن تشخيصات_الجذر: مجموعة_تشخيصات =
            تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.تحميل(الخطأ), &الحالة_م.سياق_المصادر);
        إذا (أساسي || !احتفظ_بحقائق_الأدوات) {
            أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_الجذر);
        };
        // A workspace source that cannot be loaded is its own diagnostic;
        // the other roots are still analysed.
        ادمج_مجموعة_تشخيصات(&متغير الحالة_م.تشخيصات_الأدوات, &تشخيصات_الجذر);
        أرجع ناتج_مرحلة_واجهة.مكتملة(الحالة_م);
    }
    | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
        إذا (أساسي) { الحالة_م.الجذر := اختياري.موجود(المحملة.الوحدة); };
        طابق حلل_وحدة_محملة_مع_استيراداتها(
            &متغير الحالة_م.المحمل,
            &متغير الحالة_م.سياق_المصادر,
            &متغير الحالة_م.سياق_الأسماء,
            &متغير الحالة_م.الرسم,
            البيئة_المدخلة,
            المحملة.الوحدة,
            &متغير الحالة_م.الوحدات,
            &متغير الحالة_م.أشجار_الوحدات,
            &متغير الحالة_م.الوحدات_المسجلة,
            احتفظ_بحقائق_الأدوات,
            &متغير الحالة_م.تشخيصات_الأدوات,
            الإلغاء,
            أساسي,
            &متغير الحالة_م.إخفاقات_التحميل
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_خطأ_واجهة(الخطأ, &الحالة_م.سياق_المصادر));
        }
        | _ -> { };
        أرجع ناتج_مرحلة_واجهة.مكتملة(الحالة_م);
    };
}

// Compiler-provided primitive Names are registered once into canonical Symbols
// before ordinary source declarations are collected. They are not source
// modules; المالك owns them (the program root in a compilation).
عام عرف سجل_بدائيات_في_حالة(
    الحالة: &متغير حالة_واجهة_مرحلية,
    المالك: معرف_وحدة
): اختياري مجموعة_تشخيصات {
    طابق وحدة_في_الرسم(&(*الحالة).الرسم, المالك) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                «name», سبب_تشخيص.سبب_اسم_جذر_وحدة_حقيقة_مفقود()
            )
        );
    }
    | اختياري.موجود(الوحدة_المالكة) -> {
        إذا (!سجل_بدائيات_المترجم(
            &متغير (*الحالة).سياق_الأسماء, الوحدة_المالكة.النطاق_الجذري
        )) {
            أرجع اختياري.موجود(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
                    «name», سبب_تشخيص.سبب_اسم_بدائي_تسجيل_فشل()
                )
            );
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف ابن_واجهة_داخلية(
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    المفتاح_الأساسي: &مفتاح_وحدة_مقنن,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الهدف: اختياري واصف_هدف,
    احتفظ_بحقائق_الأدوات: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_وحدة {
    طابق حلل_حالة_واجهة_كاملة(
        البيئة_المدخلة, المفتاح_الأساسي, المفاتيح_الإضافية, الهدف, احتفظ_بحقائق_الأدوات, الإلغاء
    ) مع
    | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات); }
    | ناتج_مرحلة_واجهة.ملغاة -> { أرجع نتيجة_واجهة_ملغاة(); }
    | ناتج_مرحلة_واجهة.مكتملة(المحللة) -> {
        أرجع أنه_واجهة_مرحلية(المحللة, البيئة_المدخلة, احتفظ_بحقائق_الأدوات);
    };
}

عام عرف هدف_تخدمه_المكتبة_القياسية(الهدف: &اختياري واصف_هدف): منطقي {
    طابق *الهدف مع
    | اختياري.موجود(الوصف) -> { أرجع خدمات_الذاكرة_من_المكتبة_القياسية(&الوصف); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف انهيار_الأساس_محمل(المصادر: &خريطة_مصادر): منطقي {
    ليكن ملف_الانهيار: نص = «core/process/panic.sn»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المصادر).المصادر) مثل طبيعي)) {
        إذا (اسم_مصدر_ينتهي_بمسار(&(*المصادر).المصادر[ف].الاسم, &ملف_الانهيار)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The std modules no source imports that join a program on a target std
// serves (تخدم): std's runtime-check report and, when core's panic is loaded,
// std's panic handler. A full analysis and an incremental one load them alike,
// and both count them as roots (مفاتيح_جذور_المكتبة_الضمنية).
عام عرف حمل_جذور_المكتبة_الضمنية(
    الحالة_المدخلة: حالة_واجهة_مرحلية,
    البيئة: &بيئة_وحدات_منطقية,
    تخدم: منطقي,
    احتفظ_بحقائق_الأدوات: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): ناتج_مرحلة_واجهة {
    ليكن الحالة: متغير حالة_واجهة_مرحلية = الحالة_المدخلة;
    // std's runtime-check report (library/std/process/runtime_check.sn)
    // joins every program on a target std serves: each integer operation and
    // bounds check that fails calls it (msir/runtime_checks.sn). It panics,
    // so core's process.panic and the handler below come with it.
    إذا (تخدم) {
        ليكن مسار_الفحص: متجه ط8 = بايتات_من_نص(«process/runtime_check.sn»);
        طابق حل_وحدة_مكتبة_قياسية_موثوقة(البيئة, &مسار_الفحص) مع
        | اختياري.موجود(مفتاح_الفحص) -> {
            طابق حمل_جذرا_في_حالة(
                الحالة, البيئة, &مفتاح_الفحص, خطأ, احتفظ_بحقائق_الأدوات, الإلغاء
            ) مع
            | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); }
            | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; };
        }
        | اختياري.لا_شيء -> { };
    };

    // std's panic handler (library/std/process/panic_handler.sn) joins a
    // program that can panic:
    // when core's process.panic is loaded and std serves the target.
    إذا (تخدم && انهيار_الأساس_محمل(&الحالة.سياق_المصادر)) {
        ليكن مسار_المعالج: متجه ط8 = بايتات_من_نص(«process/panic_handler.sn»);
        طابق حل_وحدة_مكتبة_قياسية_موثوقة(البيئة, &مسار_المعالج) مع
        | اختياري.موجود(مفتاح_المعالج) -> {
            طابق حمل_جذرا_في_حالة(
                الحالة, البيئة, &مفتاح_المعالج, خطأ, احتفظ_بحقائق_الأدوات, الإلغاء
            ) مع
            | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); }
            | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; };
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع ناتج_مرحلة_واجهة.مكتملة(الحالة);
}

// The keys of the std modules حمل_جذور_المكتبة_الضمنية may load.
عام عرف مفاتيح_جذور_المكتبة_الضمنية(البيئة: &بيئة_وحدات_منطقية): متجه مفتاح_وحدة_مقنن {
    ليكن المفاتيح: متغير متجه مفتاح_وحدة_مقنن = [];
    ليكن مسار_الفحص: متجه ط8 = بايتات_من_نص(«process/runtime_check.sn»);
    طابق حل_وحدة_مكتبة_قياسية_موثوقة(البيئة, &مسار_الفحص) مع
    | اختياري.موجود(المفتاح) -> { ألحق(المفاتيح, المفتاح); }
    | اختياري.لا_شيء -> { };
    ليكن مسار_المعالج: متجه ط8 = بايتات_من_نص(«process/panic_handler.sn»);
    طابق حل_وحدة_مكتبة_قياسية_موثوقة(البيئة, &مسار_المعالج) مع
    | اختياري.موجود(المفتاح) -> { ألحق(المفاتيح, المفتاح); }
    | اختياري.لا_شيء -> { };
    أرجع المفاتيح;
}

// Loads the program root and the other roots and analyses every module in
// one stage: a compilation, or a tooling request without kept state.
عام عرف حلل_حالة_واجهة_كاملة(
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    المفتاح_الأساسي: &مفتاح_وحدة_مقنن,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الهدف: اختياري واصف_هدف,
    احتفظ_بحقائق_الأدوات: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): ناتج_مرحلة_واجهة {
    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
    ليكن المكتبة_تخدم_الهدف: منطقي = هدف_تخدمه_المكتبة_القياسية(&الهدف);
    ليكن الحالة: متغير حالة_واجهة_مرحلية = حالة_واجهة_مرحلية_جديدة(الهدف);
    طابق حمل_جذرا_في_حالة(
        الحالة, البيئة_المدخلة, المفتاح_الأساسي, صواب, احتفظ_بحقائق_الأدوات, الإلغاء
    ) مع
    | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
    | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); }
    | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; };

    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };

    // Additional project roots are loaded into the same canonical loader/graph and
    // semantic contexts.  Already reachable modules are deduplicated by ModuleKey.
    ليكن فهرس_الجذر_الإضافي: متغير طبيعي = 0;
    طالما (فهرس_الجذر_الإضافي < (الطول(*المفاتيح_الإضافية) مثل طبيعي)) {
        طابق حمل_جذرا_في_حالة(
            الحالة, البيئة_المدخلة, &(*المفاتيح_الإضافية)[فهرس_الجذر_الإضافي], خطأ,
            احتفظ_بحقائق_الأدوات, الإلغاء
        ) مع
        | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
        | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); }
        | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; };
        فهرس_الجذر_الإضافي := فهرس_الجذر_الإضافي + 1;
    }

    طابق حمل_جذور_المكتبة_الضمنية(الحالة, البيئة_المدخلة, المكتبة_تخدم_الهدف, احتفظ_بحقائق_الأدوات, الإلغاء) مع
    | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
    | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); }
    | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; };

    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };

    ليكن المالك: متغير معرف_وحدة = معرف_وحدة_من(0);
    طابق الحالة.الجذر مع
    | اختياري.موجود(المعرف) -> { المالك := المعرف; }
    | اختياري.لا_شيء -> { };
    طابق سجل_بدائيات_في_حالة(&متغير الحالة, المالك) مع
    | اختياري.موجود(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
    | اختياري.لا_شيء -> { };

    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };

    أرجع حلل_مرحلة_واجهة(الحالة, البيئة_المدخلة, احتفظ_بحقائق_الأدوات, صواب, الإلغاء);
}

// The later-phase attempts a compilation makes to gather errors: each one
// types the program again, so a program with many errors stops after a
// bounded number of them.
عرف حد_محاولات_الترجمة(): طبيعي {
    أرجع 16;
}

// A compilation that stops at an error also reports those it gathered before.
عرف مع_أخطاء_الترجمة(
    السابقة: &مجموعة_تشخيصات,
    التشخيصات: &مجموعة_تشخيصات
): مجموعة_تشخيصات {
    ليكن الكل: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ادمج_مجموعة_تشخيصات(&متغير الكل, السابقة);
    ادمج_مجموعة_تشخيصات(&متغير الكل, التشخيصات);
    أرجع الكل;
}

// Analyses the modules of the state from المعالجة on: declarations, Name
// binding and the later phases, continuing the facts of the modules before
// them. يتطلب_الجذر: the program root must be bound by the end of this stage
// (a compilation's one stage, an incremental request's last).
عام عرف حلل_مرحلة_واجهة(
    الحالة: حالة_واجهة_مرحلية,
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    احتفظ_بحقائق_الأدوات: منطقي,
    يتطلب_الجذر: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): ناتج_مرحلة_واجهة {
    طابق الحالة مع
    | {
        سياق_المصادر: سياق_المصادر_و,
        سياق_الأسماء: سياق_الأسماء_و,
        الرسم: الرسم_و,
        المحمل: المحمل_و,
        الجذر: الجذر,
        الوحدات: الوحدات_و,
        أشجار_الوحدات: أشجار_الوحدات_و,
        الوحدات_المسجلة: الوحدات_المسجلة,
        تشخيصات_الأدوات: تشخيصات_الأدوات_و,
        إخفاقات_التحميل: إخفاقات_التحميل,
        بلا_أسماء: بلا_أسماء_و,
        مربوطة_جزئيا: مربوطة_جزئيا_و,
        التصريحات_المجمعة: التصريحات_المجمعة_و,
        روابط_الوحدات: روابط_الوحدات_و,
        شجرة_الجذر: شجرة_الجذر_و,
        رمز_بدء_البرنامج: رمز_بدء_البرنامج_و,
        المسقطة: المسقطة_و,
        المساحات_المسقطة: المساحات_المسقطة_و,
        بلا_أنواع: بلا_أنواع_و,
        اللاحقة: اللاحقة_و,
        الأنواع_متوقفة: الأنواع_متوقفة_و,
        المعالجة: البداية
    } -> {
        ليكن سياق_المصادر: متغير خريطة_مصادر = سياق_المصادر_و;
        ليكن سياق_الأسماء: متغير سياق_أسماء = سياق_الأسماء_و;
        ليكن الرسم: متغير رسم_وحدات = الرسم_و;
        ليكن المحمل: متغير محمل_وحدات = المحمل_و;
        ليكن الوحدات: متغير متجه وحدة_نحوية_محملة = الوحدات_و;
        ليكن أشجار_الوحدات: متغير متجه وحدة_مصدر = أشجار_الوحدات_و;
        ليكن تشخيصات_الأدوات: متغير مجموعة_تشخيصات = تشخيصات_الأدوات_و;
        ليكن بلا_أسماء: متغير متجه طبيعي = بلا_أسماء_و;
        ليكن مربوطة_جزئيا: متغير متجه طبيعي = مربوطة_جزئيا_و;
        ليكن التصريحات_المجمعة: متغير متجه جدول_تصريحات = التصريحات_المجمعة_و;
        ليكن روابط_الوحدات: متغير متجه سياق_روابط_أسماء = روابط_الوحدات_و;
        ليكن شجرة_الجذر: متغير اختياري طبيعي = شجرة_الجذر_و;
        ليكن رمز_بدء_البرنامج: متغير اختياري معرف_رمز = رمز_بدء_البرنامج_و;
        ليكن المسقطة: متغير متجه منطقي = المسقطة_و;
        ليكن المساحات_المسقطة: متغير متجه نطاق = المساحات_المسقطة_و;
        ليكن بلا_أنواع: متغير متجه طبيعي = بلا_أنواع_و;
        ليكن اللاحقة_الأساس: متغير حقائق_لاحقة_مرحلية = اللاحقة_و;
        ليكن الأنواع_متوقفة: متغير منطقي = الأنواع_متوقفة_و;
        // The spans of this stage's unknown names.
        ليكن نطاقات_مفقودة: متغير متجه نطاق = [];
        // A compilation reports every error it can reach, not only the first:
        // the unknown names of every module bound except for them, then each
        // rejection of the later phases. As for a tooling request, what an
        // error is about (and whatever uses it) is set aside before the next
        // attempt, so no error follows from another. The compilation is
        // rejected with all of them.
        ليكن أخطاء_الترجمة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        // Phase 1: register declarations for every canonical loaded module before
        // resolving any imported use. Discovery order is not semantic dependency order.
        ليكن فهرس_التصريحات: متغير طبيعي = البداية;
        طالما (فهرس_التصريحات < (الطول(الوحدات) مثل طبيعي)) {
            إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
            ليكن شجرة_التصريحات: &وحدة_مصدر = &أشجار_الوحدات[الوحدات[فهرس_التصريحات].الشجرة];
            // The canonical SourceMap retains the bytes; Name only borrows them
            // for this module and never needs a second owned Source value.
            ليكن معرف_مصدر_التصريحات: طبيعي = معرف_مصدر_شجرة_واجهة(شجرة_التصريحات);
            إذا (معرف_مصدر_التصريحات >= (الطول(سياق_المصادر.المصادر) مثل طبيعي)) {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                        «source», سبب_تشخيص.سبب_مصدر_بحث_مفقود_تصريح_مصدر()
                    )
                );
            };
            ليكن مصدر_التصريحات: &مصدر = &سياق_المصادر.المصادر[معرف_مصدر_التصريحات];
            إذا ((*مصدر_التصريحات).المعرف != معرف_مصدر_التصريحات) {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                        «source», سبب_تشخيص.سبب_مصدر_بحث_مفقود_تصريح_مصدر()
                    )
                );
            };
            طابق اجمع_تصريحات_أسماء_وحدة(
                &متغير سياق_الأسماء,
                &الرسم,
                الوحدات[فهرس_التصريحات].الوحدة,
                شجرة_التصريحات,
                مصدر_التصريحات
            ) مع
            | نتيجة_جمع_تصريحات_أسماء_وحدة.مكتملة(التصريحات) -> {
                ألحق(التصريحات_المجمعة, التصريحات);
            }
            | نتيجة_جمع_تصريحات_أسماء_وحدة.وحدة_مجهولة -> {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                        «name», سبب_تشخيص.سبب_اسم_تصريح_جمع_مجهول_وحدة()
                    )
                );
            }
            | نتيجة_جمع_تصريحات_أسماء_وحدة.مصدر_غير_مطابق -> {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                        «name», سبب_تشخيص.سبب_اسم_تصريح_جمع_مصدر_عدم_تطابق()
                    )
                );
            }
            | نتيجة_جمع_تصريحات_أسماء_وحدة.تصريح_مكرر(الموجود, النطاق) -> {
                ليكن تشخيصات_الجمع: مجموعة_تشخيصات = تشخيصات_تصريح_مكرر_مفصلة(
                    &سياق_الأسماء, &سياق_المصادر, الموجود, النطاق
                );
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_الجمع); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الجمع);
                ألحق(بلا_أسماء, معرف_مصدر_التصريحات);
                ألحق(التصريحات_المجمعة, جدول_تصريحات_فارغ_لوحدة(&الرسم, الوحدات[فهرس_التصريحات].الوحدة));
            }
            | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_مفقود(النطاق) -> {
                ليكن تشخيصات_الجمع: مجموعة_تشخيصات = تشخيصات_اسم_مفقود_أو_لهدف_آخر(
                    &سياق_المصادر, &أشجار_الوحدات, &المحمل.الهدف, النطاق,
                    سبب_تشخيص.سبب_اسم_تصريح_جمع_مفقود_اسم()
                );
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_الجمع); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الجمع);
                ألحق(بلا_أسماء, معرف_مصدر_التصريحات);
                ألحق(التصريحات_المجمعة, جدول_تصريحات_فارغ_لوحدة(&الرسم, الوحدات[فهرس_التصريحات].الوحدة));
            }
            | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_خاص(النطاق) -> {
                ليكن تشخيصات_الجمع: مجموعة_تشخيصات = تشخيصات_تصريح_خاص(&سياق_المصادر, النطاق, سبب_تشخيص.سبب_اسم_تصريح_جمع_خاص_اسم());
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_الجمع); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الجمع);
                ألحق(بلا_أسماء, معرف_مصدر_التصريحات);
                ألحق(التصريحات_المجمعة, جدول_تصريحات_فارغ_لوحدة(&الرسم, الوحدات[فهرس_التصريحات].الوحدة));
            }
            | نتيجة_جمع_تصريحات_أسماء_وحدة.تعارض_ربط(النطاق) -> {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.خطأ_سياق_داخلي(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                        «name», سبب_تشخيص.سبب_اسم_تصريح_جمع_ربط_اسم_تعارض()
                    )
                );
            }
            | نتيجة_جمع_تصريحات_أسماء_وحدة.مرادف_أب_غير_مطابق(النطاق) -> {
                ليكن تشخيصات_الجمع: مجموعة_تشخيصات = تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.اسم_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                    «name», سبب_تشخيص.سبب_اسم_مرادف_منشئ_أب_غير_مطابق()
                );
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_الجمع); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الجمع);
                ألحق(بلا_أسماء, معرف_مصدر_التصريحات);
                ألحق(التصريحات_المجمعة, جدول_تصريحات_فارغ_لوحدة(&الرسم, الوحدات[فهرس_التصريحات].الوحدة));
            };
            فهرس_التصريحات := فهرس_التصريحات + 1;
        }

        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };

        // Phase 1b: re-exports (`عام مرادف NAME = IMPORT.NAME;`) name another module's
        // Symbol, so they are bound once every module's declarations exist and before
        // any importer resolves a use (names/semantic_pipeline.sn).
        ليكن فهرس_إعادة_التصدير: متغير طبيعي = البداية;
        طالما (فهرس_إعادة_التصدير < (الطول(الوحدات) مثل طبيعي)) {
            إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
            ليكن شجرة_المعاد: &وحدة_مصدر = &أشجار_الوحدات[الوحدات[فهرس_إعادة_التصدير].الشجرة];
            ليكن معرف_مصدر_المعاد: طبيعي = معرف_مصدر_شجرة_واجهة(شجرة_المعاد);
            إذا (معرف_مصدر_المعاد < (الطول(سياق_المصادر.المصادر) مثل طبيعي)) {
                ليكن مصدر_المعاد: &مصدر = &سياق_المصادر.المصادر[معرف_مصدر_المعاد];
                ليكن نتيجة_المعاد: نتيجة_ربط_إعادة_تصدير = اربط_مرادفات_إعادة_التصدير(
                    &متغير سياق_الأسماء,
                    &الرسم,
                    الوحدات[فهرس_إعادة_التصدير].الوحدة,
                    شجرة_المعاد,
                    مصدر_المعاد
                );
                إذا (!ربط_إعادة_تصدير_مكتمل(&نتيجة_المعاد)) {
                    ليكن تشخيصات_المعاد: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
                    طابق نتيجة_المعاد مع
                    | نتيجة_ربط_إعادة_تصدير.مكتملة -> { }
                    | نتيجة_ربط_إعادة_تصدير.تصريح_مكرر(الموجود, النطاق) -> {
                        تشخيصات_المعاد := تشخيصات_تصريح_مكرر_مفصلة(
                            &سياق_الأسماء, &سياق_المصادر, الموجود, النطاق
                        );
                    }
                    | نتيجة_ربط_إعادة_تصدير.اسم_مفقود(النطاق) -> {
                        تشخيصات_المعاد := تشخيصات_اسم_مفقود_أو_لهدف_آخر(
                            &سياق_المصادر, &أشجار_الوحدات, &المحمل.الهدف, النطاق,
                            سبب_تشخيص.سبب_اسم_تصريح_جمع_مفقود_اسم()
                        );
                    }
                    | نتيجة_ربط_إعادة_تصدير.اسم_خاص(النطاق) -> {
                        تشخيصات_المعاد := تشخيصات_تصريح_خاص(
                            &سياق_المصادر, النطاق, سبب_تشخيص.سبب_اسم_تصريح_جمع_خاص_اسم()
                        );
                    }
                    | نتيجة_ربط_إعادة_تصدير.اسم_غامض(النطاق) -> {
                        تشخيصات_المعاد := تشخيصات_فشل_واجهة_مفصلة(
                            معرف_تشخيص.استيراد_غامض(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                            «name», سبب_تشخيص.سبب_اسم_انتقائي_استيراد_ملتبس_اسم()
                        );
                    };
                    إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_المعاد); };
                    ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_المعاد);
                    ألحق(بلا_أسماء, معرف_مصدر_المعاد);
                };
            };
            فهرس_إعادة_التصدير := فهرس_إعادة_التصدير + 1;
        }

        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };

        // Selective imports are declarations of scope visibility, not lazy name-use
        // filters. Validate every requested export now that all module declarations exist.
        ليكن فهرس_تحقق_الاستيراد: متغير طبيعي = البداية;
        طالما (فهرس_تحقق_الاستيراد < (الطول(الوحدات) مثل طبيعي)) {
            إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
            طابق تحقق_استيرادات_انتقائية(
                &سياق_الأسماء, &الرسم, الوحدات[فهرس_تحقق_الاستيراد].الوحدة
            ) مع
            | نتيجة_تحقق_استيراد_انتقائي.صالح -> { }
            | نتيجة_تحقق_استيراد_انتقائي.اسم_مفقود(النطاق) -> {
                ليكن تشخيصات_الانتقاء: مجموعة_تشخيصات = تشخيصات_اسم_غير_معروف(&سياق_المصادر, النطاق, سبب_تشخيص.سبب_اسم_انتقائي_استيراد_مفقود_اسم());
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_الانتقاء); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الانتقاء);
                ألحق(بلا_أسماء, النطاق.البداية.المصدر مثل طبيعي);
            }
            | نتيجة_تحقق_استيراد_انتقائي.اسم_خاص(النطاق) -> {
                ليكن تشخيصات_الانتقاء: مجموعة_تشخيصات = تشخيصات_تصريح_خاص(&سياق_المصادر, النطاق, سبب_تشخيص.سبب_اسم_انتقائي_استيراد_خاص_اسم());
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_الانتقاء); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الانتقاء);
                ألحق(بلا_أسماء, النطاق.البداية.المصدر مثل طبيعي);
            }
            | نتيجة_تحقق_استيراد_انتقائي.اسم_غامض(النطاق) -> {
                ليكن تشخيصات_الالتباس: مجموعة_تشخيصات = تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.استيراد_غامض(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                    «name», سبب_تشخيص.سبب_اسم_انتقائي_استيراد_ملتبس_اسم()
                );
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(تشخيصات_الالتباس); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الالتباس);
                ألحق(بلا_أسماء, النطاق.البداية.المصدر مثل طبيعي);
            };
            فهرس_تحقق_الاستيراد := فهرس_تحقق_الاستيراد + 1;
        }

        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };

        // Phase 2: preserve the established per-module resolution order. Every direct
        // import now observes declarations that were registered exactly once above.
        // Resolved source occurrences remain owned by their module. Downstream phases
        // consume the binding context aligned with the corresponding module tree;
        // no whole-program binding table is materialized or rescanned.
        ليكن فهرس_روابط: متغير طبيعي = الطول(روابط_الوحدات) مثل طبيعي;
        طالما (فهرس_روابط < (الطول(الوحدات) مثل طبيعي)) {
            ألحق(روابط_الوحدات, سياق_روابط_أسماء_جديد());
            فهرس_روابط := فهرس_روابط + 1;
        }
        ليكن ف: متغير طبيعي = الطول(الوحدات) مثل طبيعي;
        طالما (ف > البداية) {
            إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
            ف := ف - 1;
            ليكن شجرة_الأسماء: &وحدة_مصدر = &أشجار_الوحدات[الوحدات[ف].الشجرة];
            // The canonical SourceMap retains the bytes; Name only borrows them
            // for this module and never needs a second owned Source value.
            ليكن معرف_مصدر_الأسماء: طبيعي = معرف_مصدر_شجرة_واجهة(شجرة_الأسماء);
            إذا (معرف_مصدر_الأسماء >= (الطول(سياق_المصادر.المصادر) مثل طبيعي)) {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                        «source», سبب_تشخيص.سبب_مصدر_بحث_مفقود_اسم_مصدر()
                    )
                );
            };
            ليكن مصدر_الأسماء: &مصدر = &سياق_المصادر.المصادر[معرف_مصدر_الأسماء];
            إذا ((*مصدر_الأسماء).المعرف != معرف_مصدر_الأسماء) {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                        «source», سبب_تشخيص.سبب_مصدر_بحث_مفقود_اسم_مصدر()
                    )
                );
            };
            طابق ابن_دلالة_أسماء_وحدة_من_تصريحات(
                &متغير سياق_الأسماء,
                &الرسم,
                الوحدات[ف].الوحدة,
                شجرة_الأسماء,
                مصدر_الأسماء,
                &التصريحات_المجمعة[ف]
            ) مع
            | نتيجة_دلالة_أسماء_وحدة.مكتملة({
                الوحدة: _, الروابط: روابط_الدلالة
            }) -> {
                أصدر_تحذيرات_تهجئات_مربوطة(
                    &روابط_الدلالة.التهجئات_المهجورة, &سياق_المصادر, &متغير تشخيصات_الأدوات
                );
                // Transfer the completed binding context, not a deep copy of its
                // resolved occurrences. It has no remaining Name-phase consumer.
                ضع_روابط_وحدة_واجهة(&متغير روابط_الوحدات, ف, روابط_الدلالة);
                إذا (وحدة_هي_الجذر(&الجذر, الوحدات[ف].الوحدة)) {
                    شجرة_الجذر := اختياري.موجود(الوحدات[ف].الشجرة);
                    رمز_بدء_البرنامج := رمز_بدء_البرنامج_من_تصريحات(
                        &سياق_الأسماء, &التصريحات_المجمعة[ف]
                    );
                };
            }
            | نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة -> {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                        «name», سبب_تشخيص.سبب_اسم_حل_مجهول_وحدة()
                    )
                );
            }
            | نتيجة_دلالة_أسماء_وحدة.مصدر_غير_مطابق -> {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختياري.لا_شيء(),
                        «name», سبب_تشخيص.سبب_اسم_حل_مصدر_عدم_تطابق()
                    )
                );
            }
            | نتيجة_دلالة_أسماء_وحدة.تصريح_مكرر(الموجود, النطاق) -> {
                ليكن تشخيصات_الوحدة: مجموعة_تشخيصات = تشخيصات_تصريح_مكرر_مفصلة(
                    &سياق_الأسماء, &سياق_المصادر, الموجود, النطاق
                );
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(مع_أخطاء_الترجمة(&أخطاء_الترجمة, &تشخيصات_الوحدة)); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الوحدة);
                ألحق(بلا_أسماء, معرف_مصدر_الأسماء);
            }
            | نتيجة_دلالة_أسماء_وحدة.اسم_مفقود(النطاق) -> {
                ليكن تشخيصات_الوحدة: مجموعة_تشخيصات = تشخيصات_اسم_مفقود_أو_لهدف_آخر(
                    &سياق_المصادر, &أشجار_الوحدات, &المحمل.الهدف, النطاق,
                    سبب_تشخيص.سبب_اسم_حل_مفقود_اسم()
                );
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(مع_أخطاء_الترجمة(&أخطاء_الترجمة, &تشخيصات_الوحدة)); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الوحدة);
                ألحق(بلا_أسماء, معرف_مصدر_الأسماء);
            }
            | نتيجة_دلالة_أسماء_وحدة.اسم_خاص(النطاق) -> {
                ليكن تشخيصات_الوحدة: مجموعة_تشخيصات = تشخيصات_تصريح_خاص(&سياق_المصادر, النطاق, سبب_تشخيص.سبب_اسم_حل_خاص_اسم());
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(مع_أخطاء_الترجمة(&أخطاء_الترجمة, &تشخيصات_الوحدة)); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الوحدة);
                ألحق(بلا_أسماء, معرف_مصدر_الأسماء);
            }
            | نتيجة_دلالة_أسماء_وحدة.اسم_غامض(النطاق) -> {
                ليكن تشخيصات_الوحدة: مجموعة_تشخيصات = تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.استيراد_غامض(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                    «name», سبب_تشخيص.سبب_اسم_حل_ملتبس_اسم()
                );
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(مع_أخطاء_الترجمة(&أخطاء_الترجمة, &تشخيصات_الوحدة)); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الوحدة);
                ألحق(بلا_أسماء, معرف_مصدر_الأسماء);
            }
            | نتيجة_دلالة_أسماء_وحدة.تعارض_ربط(النطاق) -> {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.خطأ_سياق_داخلي(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                        «name», سبب_تشخيص.سبب_اسم_حل_ربط_اسم_تعارض()
                    )
                );
            }
            | نتيجة_دلالة_أسماء_وحدة.مرادف_أب_غير_مطابق(النطاق) -> {
                ليكن تشخيصات_الوحدة: مجموعة_تشخيصات = تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.اسم_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(&سياق_المصادر, النطاق),
                    «name», سبب_تشخيص.سبب_اسم_مرادف_منشئ_أب_غير_مطابق()
                );
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(مع_أخطاء_الترجمة(&أخطاء_الترجمة, &تشخيصات_الوحدة)); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الوحدة);
                ألحق(بلا_أسماء, معرف_مصدر_الأسماء);
            }
            | نتيجة_دلالة_أسماء_وحدة.معتم_يحجب_نوعا_مرئيا(النطاق) -> {
                ليكن تشخيصات_الوحدة: مجموعة_تشخيصات = تشخيصات_معتم_يحجب_نوعا(&سياق_المصادر, النطاق);
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(مع_أخطاء_الترجمة(&أخطاء_الترجمة, &تشخيصات_الوحدة)); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الوحدة);
                ألحق(بلا_أسماء, معرف_مصدر_الأسماء);
            }
            | نتيجة_دلالة_أسماء_وحدة.أسماء_مفقودة(المفقودة) -> {
                ليكن تشخيصات_الوحدة: مجموعة_تشخيصات = تشخيصات_أسماء_مفقودة(
                    &سياق_المصادر, &أشجار_الوحدات, &المحمل.الهدف, البيئة_المدخلة, &المحمل,
                    &المفقودة, سبب_تشخيص.سبب_اسم_حل_مفقود_اسم()
                );
                إذا (!احتفظ_بحقائق_الأدوات) { أرجع ناتج_مرحلة_واجهة.مرفوضة(مع_أخطاء_الترجمة(&أخطاء_الترجمة, &تشخيصات_الوحدة)); };
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الوحدة);
                ألحق(بلا_أسماء, معرف_مصدر_الأسماء);
            }
            | نتيجة_دلالة_أسماء_وحدة.أسماء_مفقودة_مربوطة(المفقودة, { الوحدة: _, الروابط: روابط_الدلالة }) -> {
                ليكن تشخيصات_الوحدة: مجموعة_تشخيصات = تشخيصات_أسماء_مفقودة(
                    &سياق_المصادر, &أشجار_الوحدات, &المحمل.الهدف, البيئة_المدخلة, &المحمل,
                    &المفقودة, سبب_تشخيص.سبب_اسم_حل_مفقود_اسم()
                );
                // The module is kept with every name that resolved; the declarations
                // that use an unknown name are set aside before typing. A
                // compilation gathers the errors and goes on to type the rest.
                إذا (احتفظ_بحقائق_الأدوات) {
                    ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_الوحدة);
                } وإلا {
                    ادمج_مجموعة_تشخيصات(&متغير أخطاء_الترجمة, &تشخيصات_الوحدة);
                };
                أصدر_تحذيرات_تهجئات_مربوطة(
                    &روابط_الدلالة.التهجئات_المهجورة, &سياق_المصادر, &متغير تشخيصات_الأدوات
                );
                ضع_روابط_وحدة_واجهة(&متغير روابط_الوحدات, ف, روابط_الدلالة);
                إذا (وحدة_هي_الجذر(&الجذر, الوحدات[ف].الوحدة)) {
                    شجرة_الجذر := اختياري.موجود(الوحدات[ف].الشجرة);
                    رمز_بدء_البرنامج := رمز_بدء_البرنامج_من_تصريحات(
                        &سياق_الأسماء, &التصريحات_المجمعة[ف]
                    );
                };
                ألحق(مربوطة_جزئيا, معرف_مصدر_الأسماء);
                ليكن م_مفقود: متغير طبيعي = 0;
                طالما (م_مفقود < (الطول(المفقودة) مثل طبيعي)) {
                    ألحق(نطاقات_مفقودة, المفقودة[م_مفقود].النطاق);
                    م_مفقود := م_مفقود + 1;
                }
            };
        }

        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };

        // A tooling request types every module it can. A module it could not
        // bind stands as an empty tree (its Name facts are absent); a root that
        // could not be bound still roots the tree. Then the declarations that use
        // an unknown name or anything unavailable are set aside (see
        // ضع_جانبا_المعتمدة), so no remaining declaration refers to what is
        // missing. A compilation that met unknown names does the same: the other
        // modules failed nothing, so only the setting aside applies.
        ليكن نطاقات_مفقودة_موجودة: منطقي = (الطول(نطاقات_مفقودة) مثل طبيعي) > 0;
        إذا (احتفظ_بحقائق_الأدوات || نطاقات_مفقودة_موجودة) {
            طابق شجرة_الجذر مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> {
                ليكن ف_الجذر: متغير طبيعي = 0;
                طالما (ف_الجذر < (الطول(الوحدات) مثل طبيعي)) {
                    إذا (وحدة_هي_الجذر(&الجذر, الوحدات[ف_الجذر].الوحدة)) {
                        شجرة_الجذر := اختياري.موجود(الوحدات[ف_الجذر].الشجرة);
                    };
                    ف_الجذر := ف_الجذر + 1;
                }
            };
            ليكن ف_فارغة: متغير طبيعي = البداية;
            طالما (ف_فارغة < (الطول(أشجار_الوحدات) مثل طبيعي)) {
                ليكن مصدر_الشجرة: طبيعي = أشجار_الوحدات[ف_فارغة].معرف_المصدر;
                إذا (مصدر_في_قائمة_الوحدات(&بلا_أسماء, مصدر_الشجرة)) {
                    أشجار_الوحدات[ف_فارغة] := شجرة_فارغة_لمصدر(مصدر_الشجرة);
                };
                ف_فارغة := ف_فارغة + 1;
            }
            مدد_رموز_مصادر_فاشلة_للأدوات(
                &متغير المسقطة, &سياق_الأسماء, &بلا_أسماء, &إخفاقات_التحميل.بلا_تصريحات
            );
            ليكن منسوبة_المفقودة: منطقي = ضع_جانبا_عند_نطاقات(
                &متغير أشجار_الوحدات, &سياق_الأسماء, &نطاقات_مفقودة,
                &متغير المسقطة, &متغير المساحات_المسقطة, &متغير بلا_أنواع
            );
            ضع_جانبا_المعتمدة(
                &متغير أشجار_الوحدات, &روابط_الوحدات, &سياق_الأسماء,
                &متغير المسقطة, &متغير المساحات_المسقطة, &متغير بلا_أنواع, البداية
            );
            // An unknown name no declaration accounts for would be met again
            // by Type: a compilation stops at the Name errors.
            إذا (!احتفظ_بحقائق_الأدوات && !منسوبة_المفقودة) {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(أخطاء_الترجمة);
            };
        };

        إذا (يتطلب_الجذر) {
            طابق شجرة_الجذر مع
            | اختياري.لا_شيء -> {
                أرجع ناتج_مرحلة_واجهة.مرفوضة(
                    تشخيصات_فشل_واجهة_مفصلة(
                        معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
                        «frontend», سبب_تشخيص.سبب_واجهة_أمامية_جذر_صياغة_شجرة_مفقود()
                    )
                );
            }
            | اختياري.موجود(_) -> { };
        };

        // A tooling request sets aside the declarations a rejection is about and
        // runs the later phases again, so one source's errors never take the
        // others' Type facts. The last resort, a rejection no declaration
        // accounts for, keeps the Name facts. A compilation goes on the same way
        // to gather each rejection's errors (at most حد_محاولات_الترجمة
        // attempts), and is rejected with them once nothing more can be typed.
        ليكن اللاحقة: متغير اختياري حقائق_لاحقة_مرحلية = اختياري.لا_شيء();
        ليكن تشخيصات_المراحل: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        ليكن المحاولة: متغير طبيعي = 0;
        // After the last resort, the later stages bind names only.
        ليكن تابع_المراحل: متغير منطقي = !الأنواع_متوقفة;
        // Implicit places are written out at most once per stage.
        ليكن كتبت_الضمنية: متغير منطقي = خطأ;
        طالما (تابع_المراحل) {
            ليكن تحذيرات_المحاولة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
            // Each attempt starts from the facts of the modules before البداية.
            ليكن أساس_المحاولة: متغير حقائق_لاحقة_مرحلية = حقائق_لاحقة_مرحلية_فارغة();
            إذا (البداية > 0) { أساس_المحاولة := انسخ_حقائق_لاحقة_مرحلية(&اللاحقة_الأساس); };
            طابق شغل_المراحل_اللاحقة(
                &أشجار_الوحدات, &سياق_المصادر, &متغير سياق_الأسماء, &روابط_الوحدات,
                &المحمل.الهدف, رمز_بدء_البرنامج, شجرة_الجذر, &متغير تحذيرات_المحاولة, الإلغاء,
                أساس_المحاولة, البداية, كتبت_الضمنية
            ) مع
            | ناتج_مراحل_لاحقة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); }
            | ناتج_مراحل_لاحقة.مواضع_ضمنية(المواضع) -> {
                // The rebuilt bodies are typed again by the next attempt; a
                // place that could not be written (outside a function body)
                // is left as typed.
                ليكن م_ض: متغير طبيعي = البداية;
                طالما (م_ض < (الطول(أشجار_الوحدات) مثل طبيعي)) {
                    ليكن المكتوبة: طبيعي = اكتب_المواضع_الضمنية_في_وحدة(&متغير أشجار_الوحدات[م_ض], &المواضع);
                    م_ض := م_ض + 1;
                }
                كتبت_الضمنية := صواب;
            }
            | ناتج_مراحل_لاحقة.مرفوضة(التشخيصات, النطاقات) -> {
                ليكن حد_المحاولات: متغير طبيعي = 64;
                إذا (احتفظ_بحقائق_الأدوات) {
                    ادمج_مجموعة_تشخيصات(&متغير تشخيصات_المراحل, &التشخيصات);
                } وإلا {
                    ادمج_مجموعة_تشخيصات(&متغير أخطاء_الترجمة, &التشخيصات);
                    حد_المحاولات := حد_محاولات_الترجمة();
                    // Every Symbol has its set-aside mark before any is set aside.
                    مدد_رموز_مصادر_فاشلة_للأدوات(
                        &متغير المسقطة, &سياق_الأسماء, &بلا_أسماء, &إخفاقات_التحميل.بلا_تصريحات
                    );
                };
                ليكن قبل: طبيعي = الطول(المساحات_المسقطة) مثل طبيعي;
                ليكن منسوبة: متغير منطقي = خطأ;
                إذا ((الطول(النطاقات) مثل طبيعي) > 0 && المحاولة < حد_المحاولات) {
                    منسوبة := ضع_جانبا_عند_نطاقات(
                        &متغير أشجار_الوحدات, &سياق_الأسماء, &النطاقات,
                        &متغير المسقطة, &متغير المساحات_المسقطة, &متغير بلا_أنواع
                    );
                };
                إذا (منسوبة) {
                    ضع_جانبا_المعتمدة(
                        &متغير أشجار_الوحدات, &روابط_الوحدات, &سياق_الأسماء,
                        &متغير المسقطة, &متغير المساحات_المسقطة, &متغير بلا_أنواع, البداية
                    );
                };
                إذا (!منسوبة || (الطول(المساحات_المسقطة) مثل طبيعي) == قبل) {
                    تابع_المراحل := خطأ;
                    الأنواع_متوقفة := صواب;
                };
                المحاولة := المحاولة + 1;
            }
            | ناتج_مراحل_لاحقة.مكتملة(الحقائق) -> {
                ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تحذيرات_المحاولة);
                اللاحقة := اختياري.موجود(الحقائق);
                تابع_المراحل := خطأ;
            };
        }
        ادمج_مجموعة_تشخيصات(&متغير تشخيصات_الأدوات, &تشخيصات_المراحل);
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
        ليكن عدد_المعالجة: طبيعي = الطول(الوحدات) مثل طبيعي;
        ليكن اللاحقة_الناتجة: متغير حقائق_لاحقة_مرحلية = اللاحقة_الأساس;
        ليكن اكتملت_اللاحقة: متغير منطقي = خطأ;
        طابق اللاحقة مع
        | اختياري.موجود(الحقائق) -> { اللاحقة_الناتجة := الحقائق; اكتملت_اللاحقة := صواب; }
        | اختياري.لا_شيء -> { };
        // A compilation that gathered errors but could type what remains goes
        // on to MSIR, rejected: the ownership analysis states its errors after
        // those, which come first (later_phase_facts.sn, الأخطاء_السابقة).
        ليكن بأخطاء_سابقة: منطقي = !احتفظ_بحقائق_الأدوات && اكتملت_اللاحقة
            && يجب_فشل_الترجمة(&أخطاء_الترجمة);
        إذا (!احتفظ_بحقائق_الأدوات && !بأخطاء_سابقة && يجب_فشل_الترجمة(&أخطاء_الترجمة)) {
            أرجع ناتج_مرحلة_واجهة.مرفوضة(أخطاء_الترجمة);
        };
        إذا (بأخطاء_سابقة) { اللاحقة_الناتجة.الأخطاء_السابقة := أخطاء_الترجمة; };
        ليكن الناتجة: حالة_واجهة_مرحلية = {
            سياق_المصادر: سياق_المصادر,
            سياق_الأسماء: سياق_الأسماء,
            الرسم: الرسم,
            المحمل: المحمل,
            الجذر: الجذر,
            الوحدات: الوحدات,
            أشجار_الوحدات: أشجار_الوحدات,
            الوحدات_المسجلة: الوحدات_المسجلة,
            تشخيصات_الأدوات: تشخيصات_الأدوات,
            إخفاقات_التحميل: إخفاقات_التحميل,
            بلا_أسماء: بلا_أسماء,
            مربوطة_جزئيا: مربوطة_جزئيا,
            التصريحات_المجمعة: التصريحات_المجمعة,
            روابط_الوحدات: روابط_الوحدات,
            شجرة_الجذر: شجرة_الجذر,
            رمز_بدء_البرنامج: رمز_بدء_البرنامج,
            المسقطة: المسقطة,
            المساحات_المسقطة: المساحات_المسقطة,
            بلا_أنواع: بلا_أنواع,
            اللاحقة: اللاحقة_الناتجة,
            الأنواع_متوقفة: الأنواع_متوقفة,
            المعالجة: عدد_المعالجة
        };
        أرجع ناتج_مرحلة_واجهة.مكتملة(الناتجة);
    };
}

// The key of a name use in الأسماء_المنقولة: its source and first byte.
عام عرف مفتاح_اسم_منقول_واجهة(النطاق: &نطاق): طبيعي {
    أرجع (((*النطاق).البداية.المصدر مثل طبيعي) * 1099511627776) + ((*النطاق).البداية.البايت مثل طبيعي);
}

// Whether the use of a local's name at النطاق moves its value out (a tooling
// request's ownership analysis found it so).
عام عرف اسم_منقول_واجهة(الواجهة: &نتيجة_واجهة_وحدة, النطاق: &نطاق): منطقي {
    ليكن المفتاح: طبيعي = مفتاح_اسم_منقول_واجهة(النطاق);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الأسماء_المنقولة) مثل طبيعي)) {
        إذا ((*الواجهة).الأسماء_المنقولة[ف] == المفتاح) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Whether the ownership analysis of a tooling request checked function
// الرمز: it ran, and did not leave the function out. Moved names and the
// absence of ownership errors mean something only for such a function.
عام عرف ملكية_دالة_محققة_واجهة(الواجهة: &نتيجة_واجهة_وحدة, الرمز: معرف_رمز): منطقي {
    إذا (!(*الواجهة).ملكية_محللة) { أرجع خطأ; };
    ليكن المعرف: طبيعي = الرمز.القيمة مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).دوال_ملكية_متروكة) مثل طبيعي)) {
        إذا ((*الواجهة).دوال_ملكية_متروكة[ف] == المعرف) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The ownership legality analysis runs on MSIR, which the Frontend does not
// import. The driver registers it before a compilation, and
// compiler/msir/ssf/ownership_tooling.sn (a definition-time decorator) in every
// program that loads it, as tooling_queries.sn does: one analysis, the last
// registered. Given a Frontend's result, it states the ownership errors of
// its program and records its moved names (الأسماء_المنقولة). A tooling
// request's errors join its diagnostics; a compilation that gathered errors
// is rejected with its ownership errors after those.
عام ليكن محللات_ملكية_الأدوات: متغير متجه دالة(&متغير نتيجة_واجهة_وحدة): مجموعة_تشخيصات = [];

عام عرف سجل_محلل_ملكية_أدوات(المحلل: دالة(&متغير نتيجة_واجهة_وحدة): مجموعة_تشخيصات): فراغ {
    غير_آمن {
        إذا ((الطول(محللات_ملكية_الأدوات) مثل طبيعي) == 0) {
            ألحق(محللات_ملكية_الأدوات, المحلل);
        } وإلا {
            محللات_ملكية_الأدوات[0] := المحلل;
        };
    }
}

// The same analysis for chosen modules only (all when the vector is empty),
// registered beside it (msir/ssf/ownership_tooling.sn): a tooling session
// analyses its kept state's modules once and each request's own modules
// apart (أنه_واجهة_مرحلية_بملكية).
عام ليكن محللات_ملكية_أدوات_مختارة: متغير متجه دالة(&متغير نتيجة_واجهة_وحدة, &متجه منطقي): مجموعة_تشخيصات = [];

عام عرف سجل_محلل_ملكية_أدوات_مختارة(المحلل: دالة(&متغير نتيجة_واجهة_وحدة, &متجه منطقي): مجموعة_تشخيصات): فراغ {
    غير_آمن {
        إذا ((الطول(محللات_ملكية_أدوات_مختارة) مثل طبيعي) == 0) {
            ألحق(محللات_ملكية_أدوات_مختارة, المحلل);
        } وإلا {
            محللات_ملكية_أدوات_مختارة[0] := المحلل;
        };
    }
}

// What the ownership analysis of a kept state's modules stated (the first
// العدد modules of a result, from the kept state of generation التوليد,
// incremental_analysis.sn): its diagnostics, moved names and left-out
// functions. The kept state's modules keep their Symbol and source IDs in
// every copy, and none imports a later module, so this holds for every
// request that starts from that state.
عام نوع ملكية_مخبأة_واجهة = {
    التوليد: طبيعي,
    العدد: طبيعي,
    التشخيصات: مجموعة_تشخيصات,
    الأسماء_المنقولة: متجه طبيعي,
    المتروكة: متجه طبيعي
};

// The ownership analysis a result takes: of every module (العدد 0), or of
// the modules after the first العدد, which come from a kept state of
// generation التوليد whose own analysis is المخبأة when it was made before
// (and is recorded there when it is made now).
عام نوع ملكية_مرحلية_واجهة = {
    العدد: طبيعي,
    التوليد: طبيعي,
    المخبأة: اختياري ملكية_مخبأة_واجهة
};

عام عرف ملكية_مرحلية_كاملة_واجهة(): ملكية_مرحلية_واجهة {
    ليكن الناتج: ملكية_مرحلية_واجهة = { العدد: 0, التوليد: 0, المخبأة: اختياري.لا_شيء() };
    أرجع الناتج;
}

عرف محلل_مختار_مسجل_واجهة(): منطقي {
    ليكن العدد: متغير طبيعي = 0;
    غير_آمن { العدد := الطول(محللات_ملكية_أدوات_مختارة) مثل طبيعي; }
    أرجع العدد > 0;
}

عرف حلل_ملكية_مختارة_طلب_أدوات_واجهة(الناتج: &متغير نتيجة_واجهة_وحدة, الاختيار: &متجه منطقي): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    غير_آمن { المجموعة := محللات_ملكية_أدوات_مختارة[0](&متغير (*الناتج), الاختيار); }
    أرجع المجموعة;
}

عرف اختيار_وحدات_واجهة(العدد_الكلي: طبيعي, الأول: طبيعي, حتى: طبيعي): متجه منطقي {
    ليكن الناتج: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد_الكلي) { ألحق(الناتج, ف >= الأول && ف < حتى); ف := ف + 1; }
    أرجع الناتج;
}

// A request's ownership analysis: the kept state's modules from the cache
// (or analysed now and cached), then the request's own modules. The result
// is that of analysing every module: each module's is independent of the
// others selected (semantic_lowering.sn, حلل_ملكية_وحدات_مختارة_للأدوات_مسير),
// and the kept state's modules come first in the order diagnostics follow.
عرف حلل_ملكية_مرحلية_واجهة(الناتج: &متغير نتيجة_واجهة_وحدة, الملكية: &متغير ملكية_مرحلية_واجهة): مجموعة_تشخيصات {
    ليكن الكلي: طبيعي = الطول((*الناتج).الوحدات) مثل طبيعي;
    إذا ((*الملكية).العدد == 0 || (*الملكية).العدد > الكلي || !محلل_مختار_مسجل_واجهة()) {
        أرجع حلل_ملكية_طلب_أدوات_واجهة(الناتج);
    };
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن صالحة: متغير منطقي = خطأ;
    طابق (*الملكية).المخبأة مع
    | اختياري.موجود(المخبأة) -> {
        صالحة := المخبأة.التوليد == (*الملكية).التوليد && المخبأة.العدد == (*الملكية).العدد;
    }
    | اختياري.لا_شيء -> { };
    إذا (!صالحة) {
        ليكن قبل_النقول: طبيعي = الطول((*الناتج).الأسماء_المنقولة) مثل طبيعي;
        ليكن قبل_المتروكة: طبيعي = الطول((*الناتج).دوال_ملكية_متروكة) مثل طبيعي;
        ليكن الأولى: متجه منطقي = اختيار_وحدات_واجهة(الكلي, 0, (*الملكية).العدد);
        ليكن تشخيصات_الأولى: مجموعة_تشخيصات = حلل_ملكية_مختارة_طلب_أدوات_واجهة(الناتج, &الأولى);
        ليكن النقول: متغير متجه طبيعي = [];
        ليكن ف: متغير طبيعي = قبل_النقول;
        طالما (ف < (الطول((*الناتج).الأسماء_المنقولة) مثل طبيعي)) { ألحق(النقول, (*الناتج).الأسماء_المنقولة[ف]); ف := ف + 1; }
        ليكن المتروكة: متغير متجه طبيعي = [];
        ف := قبل_المتروكة;
        طالما (ف < (الطول((*الناتج).دوال_ملكية_متروكة) مثل طبيعي)) { ألحق(المتروكة, (*الناتج).دوال_ملكية_متروكة[ف]); ف := ف + 1; }
        ليكن المحفوظة: ملكية_مخبأة_واجهة = {
            التوليد: (*الملكية).التوليد, العدد: (*الملكية).العدد,
            التشخيصات: تشخيصات_الأولى, الأسماء_المنقولة: النقول, المتروكة: المتروكة
        };
        (*الملكية).المخبأة := اختياري.موجود(المحفوظة);
    } وإلا {
        طابق (*الملكية).المخبأة مع
        | اختياري.موجود(المخبأة) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المخبأة.الأسماء_المنقولة) مثل طبيعي)) { ألحق((*الناتج).الأسماء_المنقولة, المخبأة.الأسماء_المنقولة[ف]); ف := ف + 1; }
            ف := 0;
            طالما (ف < (الطول(المخبأة.المتروكة) مثل طبيعي)) { ألحق((*الناتج).دوال_ملكية_متروكة, المخبأة.المتروكة[ف]); ف := ف + 1; }
        }
        | اختياري.لا_شيء -> { };
    };
    طابق (*الملكية).المخبأة مع
    | اختياري.موجود(المخبأة) -> {
        ادمج_مجموعة_تشخيصات(&متغير المجموعة, &المخبأة.التشخيصات);
    }
    | اختياري.لا_شيء -> { };
    ليكن الثانية: متجه منطقي = اختيار_وحدات_واجهة(الكلي, (*الملكية).العدد, الكلي);
    ليكن تشخيصات_الثانية: مجموعة_تشخيصات = حلل_ملكية_مختارة_طلب_أدوات_واجهة(الناتج, &الثانية);
    ادمج_مجموعة_تشخيصات(&متغير المجموعة, &تشخيصات_الثانية);
    (*الناتج).ملكية_محللة := صواب;
    أرجع المجموعة;
}

عرف حلل_ملكية_طلب_أدوات_واجهة(الناتج: &متغير نتيجة_واجهة_وحدة): مجموعة_تشخيصات {
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن العدد: متغير طبيعي = 0;
    غير_آمن { العدد := الطول(محللات_ملكية_الأدوات) مثل طبيعي; }
    إذا (العدد > 0) {
        غير_آمن { المجموعة := محللات_ملكية_الأدوات[0](&متغير (*الناتج)); }
    };
    أرجع المجموعة;
}

// The result of an analysed state. Name facts are always retained:
// diagnostics after the frontend (MSIR lowering) print named Types with them.
// The vectors are moved, not copied.
عام عرف أنه_واجهة_مرحلية(
    الحالة: حالة_واجهة_مرحلية,
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    احتفظ_بحقائق_الأدوات: منطقي
): نتيجة_بناء_واجهة_وحدة {
    ليكن الملكية: متغير ملكية_مرحلية_واجهة = ملكية_مرحلية_كاملة_واجهة();
    أرجع أنه_واجهة_مرحلية_بملكية(الحالة, البيئة_المدخلة, احتفظ_بحقائق_الأدوات, &متغير الملكية);
}

// The same, with the ownership analysis of a tooling request split as
// الملكية says (حلل_ملكية_مرحلية_واجهة).
عام عرف أنه_واجهة_مرحلية_بملكية(
    الحالة: حالة_واجهة_مرحلية,
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    احتفظ_بحقائق_الأدوات: منطقي,
    الملكية: &متغير ملكية_مرحلية_واجهة
): نتيجة_بناء_واجهة_وحدة {
    طابق الحالة مع
    | {
        سياق_المصادر: سياق_المصادر,
        سياق_الأسماء: سياق_الأسماء,
        الرسم: الرسم,
        المحمل: المحمل,
        الجذر: _,
        الوحدات: الوحدات,
        أشجار_الوحدات: أشجار_الوحدات,
        الوحدات_المسجلة: _,
        تشخيصات_الأدوات: تشخيصات_الأدوات,
        إخفاقات_التحميل: إخفاقات_التحميل,
        بلا_أسماء: بلا_أسماء,
        مربوطة_جزئيا: مربوطة_جزئيا,
        التصريحات_المجمعة: _,
        روابط_الوحدات: روابط_الوحدات,
        شجرة_الجذر: _,
        رمز_بدء_البرنامج: رمز_بدء_البرنامج,
        المسقطة: _,
        المساحات_المسقطة: _,
        بلا_أنواع: بلا_أنواع,
        اللاحقة: اللاحقة,
        الأنواع_متوقفة: الأنواع_متوقفة,
        المعالجة: _
    } -> {
        إذا (الأنواع_متوقفة) {
            أرجع واجهة_أدوات_ناقصة(
                أشجار_الوحدات, سياق_المصادر, سياق_الأسماء, روابط_الوحدات,
                &الرسم, رمز_بدء_البرنامج, تشخيصات_الأدوات, &بلا_أسماء, &إخفاقات_التحميل
            );
        };
        طابق اللاحقة مع
        | {
            سياقات_الأنواع: سياقات_الأنواع_النهائية,
            سياق_الأنماط: سياق_الأنماط_النهائي,
            الأخطاء_السابقة: الأخطاء_السابقة,
            الذاكرة: الذاكرة
        } -> {
            ليكن كاملة_دلاليا: منطقي = !يجب_فشل_الترجمة(&تشخيصات_الأدوات);
            طابق استخلص_حقائق_أسماء_مستمرة(سياق_الأسماء, صواب) مع
            | { هويات_البدائيات: هويات_البدائيات, استعلامات: استعلامات_الأسماء } -> {
                ليكن الوحدات_الدلالية: متجه وحدة_دلالية = الوحدات_الدلالية_للرسم(&الرسم);
                // Partly bound sources lack some Name facts; sources with set-aside
                // declarations (or no tree) lack some Type facts.
                ليكن ناقصة_الأسماء: متغير متجه طبيعي = [];
                ليكن ناقصة_الأنواع: متغير متجه طبيعي = [];
                ليكن ف_ناقص: متغير طبيعي = 0;
                طالما (ف_ناقص < (الطول(بلا_أسماء) مثل طبيعي)) {
                    ألحق(ناقصة_الأسماء, بلا_أسماء[ف_ناقص]);
                    ألحق(ناقصة_الأنواع, بلا_أسماء[ف_ناقص]);
                    ف_ناقص := ف_ناقص + 1;
                }
                ف_ناقص := 0;
                طالما (ف_ناقص < (الطول(مربوطة_جزئيا) مثل طبيعي)) {
                    ألحق(ناقصة_الأسماء, مربوطة_جزئيا[ف_ناقص]);
                    ف_ناقص := ف_ناقص + 1;
                }
                ف_ناقص := 0;
                طالما (ف_ناقص < (الطول(بلا_أنواع) مثل طبيعي)) {
                    ألحق(ناقصة_الأنواع, بلا_أنواع[ف_ناقص]);
                    ف_ناقص := ف_ناقص + 1;
                }
                ليكن حقائق_الأدوات: حقائق_أدوات_واجهة = حقائق_أدوات_للطلب(
                    &الرسم, &أشجار_الوحدات, احتفظ_بحقائق_الأدوات, &إخفاقات_التحميل,
                    &ناقصة_الأسماء, &ناقصة_الأنواع
                );
                ليكن فهرس_التصريحات: فهرس_تصريحات = ابن_فهرس_تصريحات(
                    &أشجار_الوحدات, &روابط_الوحدات
                );
                // Borrow the trees, bindings and sources before the
                // record below takes ownership of them.
                ليكن أصل_نواة_لينكس: اختياري أصل_نواة_موثق_واجهة = استخلص_أصل_نواة_واجهة(
                    البيئة_المدخلة, &المحمل, &الوحدات,
                    &أشجار_الوحدات, &روابط_الوحدات, &سياق_المصادر
                );
                ليكن رموز_لا_تعود: متجه معرف_رمز = استخلص_رموز_لا_تعود_واجهة(
                    البيئة_المدخلة, &المحمل, &الوحدات,
                    &أشجار_الوحدات, &روابط_الوحدات, &سياق_المصادر
                );
                ليكن رموز_التنسيق: متجه معرف_رمز = استخلص_رموز_تنسيق_واجهة(
                    البيئة_المدخلة, &المحمل, &الوحدات,
                    &أشجار_الوحدات, &روابط_الوحدات, &سياق_المصادر
                );
                // `@@test` (test_mode/validation.sn): a tooling request reports
                // the tests `sultanc test` would reject, by the same rules,
                // after the errors of its ownership analysis (below).
                ليكن تشخيصات_الاختبارات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
                إذا (احتفظ_بحقائق_الأدوات) {
                    تشخيصات_الاختبارات := تشخيصات_اختبارات_للأدوات(
                        &سياق_المصادر, &أشجار_الوحدات, &روابط_الوحدات,
                        &سياقات_الأنواع_النهائية, &استعلامات_الأسماء, &المحمل.الهدف
                    );
                };
                ليكن الناتج: متغير نتيجة_واجهة_وحدة = {
                    الوحدات: أشجار_الوحدات,
                    أصل_نواة_لينكس: أصل_نواة_لينكس,
                    رموز_لا_تعود: رموز_لا_تعود,
                    رموز_التنسيق: رموز_التنسيق,
                    عرض_مؤشر_الهدف: عرض_مؤشر_محمل(&المحمل.الهدف),
                    الوحدات_الدلالية: الوحدات_الدلالية,
                    خريطة_المصادر: سياق_المصادر,
                    هويات_البدائيات: هويات_البدائيات,
                    روابط_الأسماء: روابط_الوحدات,
                    فهرس_التصريحات: فهرس_التصريحات,
                    استعلامات_الأسماء: استعلامات_الأسماء,
                    رمز_بدء_البرنامج: رمز_بدء_البرنامج,
                    سياقات_الأنواع: سياقات_الأنواع_النهائية,
                    سياق_الأنماط: سياق_الأنماط_النهائي,
                    كاملة_دلاليا: كاملة_دلاليا,
                    تشخيصات_الأدوات: تشخيصات_الأدوات,
                    الأسماء_المنقولة: [],
                    ملكية_محللة: خطأ,
                    دوال_ملكية_متروكة: [],
                    حقائق_الأدوات: حقائق_الأدوات,
                    الذاكرة: الذاكرة
                };
                إذا (احتفظ_بحقائق_الأدوات) {
                    ليكن تشخيصات_الملكية: مجموعة_تشخيصات = حلل_ملكية_مرحلية_واجهة(&متغير الناتج, الملكية);
                    ادمج_مجموعة_تشخيصات(&متغير الناتج.تشخيصات_الأدوات, &تشخيصات_الملكية);
                    الناتج.كاملة_دلاليا := !يجب_فشل_الترجمة(&الناتج.تشخيصات_الأدوات);
                    ادمج_مجموعة_تشخيصات(&متغير الناتج.تشخيصات_الأدوات, &تشخيصات_الاختبارات);
                } وإلا إذا (يجب_فشل_الترجمة(&الأخطاء_السابقة)) {
                    // A compilation that gathered errors is rejected, with
                    // the errors of its ownership after them.
                    ليكن المرفوضة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
                    ادمج_مجموعة_تشخيصات(&متغير المرفوضة, &الأخطاء_السابقة);
                    ليكن تشخيصات_الملكية: مجموعة_تشخيصات = حلل_ملكية_طلب_أدوات_واجهة(&متغير الناتج);
                    ادمج_مجموعة_تشخيصات(&متغير المرفوضة, &تشخيصات_الملكية);
                    أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(المرفوضة);
                };
                أرجع نتيجة_بناء_واجهة_وحدة.مكتملة(الناتج);
            };
        };
    };
}

عام عرف ابن_واجهة_وحدة(
    الطلب: طلب_واجهة_وحدة
): نتيجة_بناء_واجهة_وحدة {
    ليكن مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    ليكن مرجع_المفتاح: &مفتاح_وحدة_مقنن = &الطلب.المفتاح_الجذري;
    ليكن الإضافية: متجه مفتاح_وحدة_مقنن = [];
    ليكن الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    أرجع ابن_واجهة_داخلية(
        مرجع_البيئة, مرجع_المفتاح, &الإضافية,
        اختياري.لا_شيء(), الطلب.احتفظ_بحقائق_الأدوات, &الإلغاء
    );
}

// Project discovery may enumerate filesystem candidates, but semantic project
// membership is owned by the canonical Module graph.  A candidate belongs to the
// anchored project when its import closure reaches the anchor.  Forward dependencies
// of the anchor are already loaded by the normal module closure and need not become
// additional roots.
نوع نتيجة_اختيار_جذور_مشروع =
    | مكتملة بنوع متجه مفتاح_وحدة_مقنن
    | مرفوضة بنوع مجموعة_تشخيصات
;

عرف وحدة_رسم_تصل_إلى(
    الرسم: &رسم_وحدات,
    البداية: معرف_وحدة,
    الهدف: معرف_وحدة
): منطقي {
    إذا (البداية.القيمة == الهدف.القيمة) { أرجع صواب; };
    ليكن العدد: طبيعي = (*الرسم).معرف_الوحدة_التالي;
    إذا ((البداية.القيمة مثل طبيعي) >= العدد || (الهدف.القيمة مثل طبيعي) >= العدد) { أرجع خطأ; };

    ليكن المزارة: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(المزارة, خطأ);
        ف := ف + 1;
    }
    ليكن الطابور: متغير متجه معرف_وحدة = [];
    ألحق(الطابور, البداية);
    المزارة[البداية.القيمة] := صواب;

    ليكن موضع: متغير طبيعي = 0;
    طالما (موضع < (الطول(الطابور) مثل طبيعي)) {
        ليكن الحالي: معرف_وحدة = الطابور[موضع];
        ليكن ح: متغير طبيعي = 0;
        ليكن عدد_الاستيرادات: طبيعي = عدد_استيرادات_الوحدة(الرسم, الحالي);
        طالما (ح < عدد_الاستيرادات) {
            ليكن التالي: معرف_وحدة = استيراد_الوحدة_عند(الرسم, الحالي, ح);
            إذا (التالي.القيمة == الهدف.القيمة) { أرجع صواب; };
            إذا ((التالي.القيمة مثل طبيعي) < العدد && !المزارة[التالي.القيمة]) {
                المزارة[التالي.القيمة] := صواب;
                ألحق(الطابور, التالي);
            };
            ح := ح + 1;
        }
        موضع := موضع + 1;
    }
    أرجع خطأ;
}

عرف اختر_جذور_مشروع_مرتبطة(
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    المفاتيح_المدخلة: &متجه مفتاح_وحدة_مقنن,
    استرداد_الأدوات: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_اختيار_جذور_مشروع {
    إذا (هل_واجهة_ملغاة(الإلغاء)) {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(), «frontend», سبب_تشخيص.سبب_واجهة_أمامية_ملغى()
        ));
    };
    ليكن قيمة_المفاتيح_المدخلة: متجه مفتاح_وحدة_مقنن = *المفاتيح_المدخلة;
    إذا ((الطول(قيمة_المفاتيح_المدخلة) مثل طبيعي) == 0) {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
                «frontend», سبب_تشخيص.سبب_واجهة_أمامية_مشروع_بلا_جذور()
            )
        );
    };

    ليكن سياق_المصادر: متغير خريطة_مصادر = خريطة_مصادر_جديدة();
    ليكن سياق_الأسماء: متغير سياق_أسماء = سياق_أسماء_جديد();
    ليكن الرسم: متغير رسم_وحدات = رسم_وحدات_جديد();
    ليكن المحمل: متغير محمل_وحدات = محمل_وحدات_جديد();
    ليكن الوحدات: متغير متجه وحدة_نحوية_محملة = [];
    ليكن أشجار_الوحدات: متغير متجه وحدة_مصدر = [];
    ليكن الوحدات_المسجلة: متغير متجه منطقي = [];
    ليكن تشخيصات_اختيار_الأدوات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    // Selection only builds import relations; the analysis that follows records
    // its own load failures.
    ليكن إخفاقات_الاختيار: متغير إخفاقات_تحميل_أدوات = إخفاقات_تحميل_أدوات_جديدة();

    ليكن مرجع_المفتاح_الأساسي: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح_المدخلة[0];
    ليكن الجذر: متغير معرف_وحدة = معرف_وحدة_من(0);
    طابق حمل_وحدة_جذر(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        البيئة_المدخلة,
        مرجع_المفتاح_الأساسي
    ) مع
    | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(
            تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.تحميل(الخطأ), &سياق_المصادر)
        );
    }
    | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
        الجذر := المحملة.الوحدة;
    };

    // The anchor and its forward dependencies are mandatory project members.
    // Their load/parse failures are canonical project failures, not candidates to ignore.
    طابق حلل_وحدة_محملة_مع_استيراداتها(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        البيئة_المدخلة,
        الجذر,
        &متغير الوحدات,
        &متغير أشجار_الوحدات,
        &متغير الوحدات_المسجلة,
        استرداد_الأدوات,
        &متغير تشخيصات_اختيار_الأدوات,
        الإلغاء,
        خطأ,
        &متغير إخفاقات_الاختيار
    ) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(
            تشخيصات_خطأ_واجهة(الخطأ, &سياق_المصادر)
        );
    }
    | _ -> { };

    // Parse candidate roots through the canonical lexer/parser/module loader solely
    // to build import relationships.  Candidate-local failures are deferred unless
    // a relationship to the anchored project is established; the final strict build
    // then reports the canonical structured diagnostic for project members.
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < (الطول(قيمة_المفاتيح_المدخلة) مثل طبيعي)) {
        إذا (هل_واجهة_ملغاة(الإلغاء)) {
            أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(), «frontend», سبب_تشخيص.سبب_واجهة_أمامية_ملغى()
            ));
        };
        ليكن مرجع_المفتاح: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح_المدخلة[ف];
        طابق حمل_وحدة_جذر(
            &متغير المحمل,
            &متغير سياق_المصادر,
            &متغير سياق_الأسماء,
            &متغير الرسم,
            البيئة_المدخلة,
            مرجع_المفتاح
        ) مع
        | نتيجة_تحميل_وحدة.خطأ(_) -> { }
        | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
            ليكن خطأ_مرشح: اختياري خطأ_واجهة_وحدة = حلل_وحدة_محملة_مع_استيراداتها(
                &متغير المحمل,
                &متغير سياق_المصادر,
                &متغير سياق_الأسماء,
                &متغير الرسم,
                البيئة_المدخلة,
                المحملة.الوحدة,
                &متغير الوحدات,
                &متغير أشجار_الوحدات,
                &متغير الوحدات_المسجلة,
                استرداد_الأدوات,
                &متغير تشخيصات_اختيار_الأدوات,
                الإلغاء,
                خطأ,
                &متغير إخفاقات_الاختيار
            );
        };
        ف := ف + 1;
    }

    ليكن المرتبطة: متغير متجه مفتاح_وحدة_مقنن = [];
    ف := 1;
    طالما (ف < (الطول(قيمة_المفاتيح_المدخلة) مثل طبيعي)) {
        ليكن مرجع_المفتاح: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح_المدخلة[ف];
        طابق وحدة_محملة_بالمفتاح(&المحمل, مرجع_المفتاح) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المحملة) -> {
            إذا (وحدة_رسم_تصل_إلى(&الرسم, المحملة.الوحدة, الجذر)) {
                ألحق(المرتبطة, انسخ_مفتاح_وحدة_مقنن(مرجع_المفتاح));
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة_اختيار_جذور_مشروع.مكتملة(المرتبطة);
}

عام عرف ابن_واجهة_مشروع(
    الطلب: طلب_واجهة_مشروع
): نتيجة_بناء_واجهة_وحدة {
    ليكن الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    ليكن مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    ليكن مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الطلب.المفاتيح_الجذرية;
    ليكن قيمة_المفاتيح: متجه مفتاح_وحدة_مقنن = *مرجع_المفاتيح;
    إذا ((الطول(قيمة_المفاتيح) مثل طبيعي) == 0) {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(),
                «frontend», سبب_تشخيص.سبب_واجهة_أمامية_مشروع_بلا_جذور()
            )
        );
    };
    ليكن مرجع_الأساسي: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح[0];
    طابق اختر_جذور_مشروع_مرتبطة(مرجع_البيئة, مرجع_المفاتيح, الطلب.احتفظ_بحقائق_الأدوات, &الإلغاء) مع
    | نتيجة_اختيار_جذور_مشروع.مرفوضة(التشخيصات) -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات);
    }
    | نتيجة_اختيار_جذور_مشروع.مكتملة(الإضافية) -> {
        أرجع ابن_واجهة_داخلية(
            مرجع_البيئة, مرجع_الأساسي, &الإضافية,
            اختياري.لا_شيء(), الطلب.احتفظ_بحقائق_الأدوات, &الإلغاء
        );
    };
}

// Compiler-owned cancellable entry points for IDE/tooling consumers. Protocol code
// supplies a token; frontend phases only observe it at cooperative checkpoints.
// The driver supplies the selected target for compile-time source decisions,
// and any compiler-required module roots (for example the std process-exit
// provider of a self-started executable); they join the same module graph.
// Tooling callers continue to use the target-neutral interface unchanged.
عام عرف ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(
    الطلب: طلب_واجهة_وحدة,
    الهدف: اختياري واصف_هدف,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
    ليكن مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    ليكن مرجع_المفتاح: &مفتاح_وحدة_مقنن = &الطلب.المفتاح_الجذري;
    طابق ابن_واجهة_داخلية(
        مرجع_البيئة, مرجع_المفتاح, المفاتيح_الإضافية,
        الهدف, الطلب.احتفظ_بحقائق_الأدوات, الإلغاء
    ) مع
    | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة);
    }
    | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
    };
}

عام عرف ابن_واجهة_وحدة_قابلة_للإلغاء(
    الطلب: طلب_واجهة_وحدة,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    ليكن الإضافية: متجه مفتاح_وحدة_مقنن = [];
    أرجع ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(
        الطلب, اختياري.لا_شيء(), &الإضافية, الإلغاء
    );
}

عام عرف ابن_واجهة_مشروع_قابلة_للإلغاء(
    الطلب: طلب_واجهة_مشروع,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
    ليكن مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    ليكن مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الطلب.المفاتيح_الجذرية;
    ليكن قيمة_المفاتيح: متجه مفتاح_وحدة_مقنن = *مرجع_المفاتيح;
    إذا ((الطول(قيمة_المفاتيح) مثل طبيعي) == 0) {
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء(), «frontend», سبب_تشخيص.سبب_واجهة_أمامية_مشروع_بلا_جذور()
        ));
    };
    ليكن مرجع_الأساسي: &مفتاح_وحدة_مقنن = &قيمة_المفاتيح[0];
    طابق اختر_جذور_مشروع_مرتبطة(
        مرجع_البيئة, مرجع_المفاتيح, الطلب.احتفظ_بحقائق_الأدوات, الإلغاء
    ) مع
    | نتيجة_اختيار_جذور_مشروع.مرفوضة(التشخيصات) -> {
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
    }
    | نتيجة_اختيار_جذور_مشروع.مكتملة(الإضافية) -> {
        طابق ابن_واجهة_داخلية(
            مرجع_البيئة, مرجع_الأساسي, &الإضافية,
            اختياري.لا_شيء(), الطلب.احتفظ_بحقائق_الأدوات, الإلغاء
        ) مع
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
            إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
            أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة);
        }
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
            إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
            أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
        };
    };
}

// General semantic point-query surface for tooling/compiler consumers.
عام عرف مصدر_واجهة_بمعرف(
    الواجهة: &نتيجة_واجهة_وحدة,
    المعرف: طبيعي
): اختياري مصدر {
    أرجع مصدر_محمل_بالمعرف(&(*الواجهة).خريطة_المصادر, المعرف);
}

عام عرف اسم_مصدر_واجهة_بمعرف(
    الواجهة: &نتيجة_واجهة_وحدة,
    المعرف: طبيعي
): اختياري نص {
    طابق مصدر_واجهة_بمعرف(الواجهة, المعرف) مع
    | اختياري.موجود(المصدر) -> {
        ليكن مرجع_الاسم: &نص = &المصدر.الاسم;
        ليكن الاسم: نص = انسخ_نص(مرجع_الاسم);
        أرجع اختياري.موجود(الاسم);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف معرف_مصدر_واجهة_باسم(
    الواجهة: &نتيجة_واجهة_وحدة,
    الاسم: &نص
): اختياري طبيعي {
    ليكن مرجع_الخريطة: &خريطة_مصادر = &(*الواجهة).خريطة_المصادر;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*مرجع_الخريطة).المصادر) مثل طبيعي)) {
        ليكن المصدر: &مصدر = &(*مرجع_الخريطة).المصادر[ف];
        إذا (نصان_متساويان(&(*المصدر).الاسم, الاسم)) {
            أرجع اختياري.موجود((*المصدر).المعرف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ظهور_اسم_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري ظهور_اسم_محلول {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        إذا ((*الواجهة).الوحدات[ف].معرف_المصدر == المصدر) {
            إذا (ف >= (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع ظهور_اسم_محلول_عند_بايت(&(*الواجهة).روابط_الأسماء[ف], المصدر, البايت);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف رمز_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري معرف_رمز {
    طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
    | اختياري.موجود(الظهور) -> { أرجع الظهور.الرمز; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف تصريح_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختياري رمز_دلالي {
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.موجود(الاستعلامات) -> {
        أرجع رمز_دلالي_عند_استعلام(&الاستعلامات, الرمز);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف ظهورات_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه ظهور_اسم_محلول {
    ليكن الناتج: متغير متجه ظهور_اسم_محلول = [];
    ليكن و: متغير طبيعي = 0;
    طالما (و < (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
        ليكن مرجع_الروابط: &سياق_روابط_أسماء = &(*الواجهة).روابط_الأسماء[و];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_الروابط).الظهورات) مثل طبيعي)) {
            ليكن مرجع_الظهور: &ظهور_اسم_محلول = &(*مرجع_الروابط).الظهورات[ف];
            طابق (*مرجع_الظهور).الرمز مع
            | اختياري.موجود(المعرف) -> {
                إذا (معرفا_رمز_متساويان(المعرف, الرمز)) { ألحق(الناتج, *مرجع_الظهور); };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    أرجع الناتج;
}

عام عرف نوع_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختياري معرف_نوع {
    أرجع نوع_رمز_دلالي_عند(&(*الواجهة).سياقات_الأنواع.أنواع_الرموز, الرمز);
}

عام عرف نوع_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري معرف_نوع {
    طابق رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
    | اختياري.موجود(الرمز) -> {
        طابق نوع_رمز_دلالي_عند(&(*الواجهة).سياقات_الأنواع.أنواع_الرموز, الرمز) مع
        | اختياري.موجود(النوع) -> { أرجع اختياري.موجود(النوع); }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        إذا ((*الواجهة).الوحدات[ف].معرف_المصدر == المصدر) {
            إذا (ف >= (الطول((*الواجهة).سياقات_الأنواع.أنواع_التعبيرات) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع نوع_تعبير_عند_بايت(&(*الواجهة).سياقات_الأنواع.أنواع_التعبيرات[ف], المصدر, البايت);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف استدعاء_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري استعلام_استدعاء_دلالي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        إذا ((*الواجهة).الوحدات[ف].معرف_المصدر == المصدر) {
            إذا (ف >= (الطول((*الواجهة).سياقات_الأنواع.أنواع_التعبيرات) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع استدعاء_عند_بايت(&(*الواجهة).سياقات_الأنواع.أنواع_التعبيرات[ف], المصدر, البايت);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف عدد_معاملات_نوع_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع
): اختياري طبيعي {
    أرجع عدد_معاملات_دالة_دلالية(&(*الواجهة).سياقات_الأنواع.الأنواع, النوع);
}

عام عرف نوع_معامل_نوع_واجهة_عند(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    أرجع نوع_معامل_دالة_دلالي_عند(&(*الواجهة).سياقات_الأنواع.الأنواع, النوع, الفهرس);
}

عام عرف روابط_مرئية_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): متجه ربط_اسم_نطاق {
    ليكن الناتج: متغير متجه ربط_اسم_نطاق = [];
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الاستعلامات) -> {
        أرجع روابط_مرئية_عند_استعلام(&الاستعلامات, المصدر, البايت);
    };
}

عام عرف اسم_مقنن_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الاسم: معرف_اسم
): اختياري اسم_مقنن {
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاستعلامات) -> {
        أرجع اسم_مقنن_عند_استعلام(&الاستعلامات, الاسم);
    };
}

عام عرف حضر_إعادة_تسمية_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): نتيجة_تحضير_إعادة_تسمية_دلالية {
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختياري.موجود(الاستعلامات) -> {
        طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | اختياري.موجود(الظهور) -> {
            أرجع حضر_إعادة_تسمية_دلالية(&الاستعلامات, &الظهور);
        };
    };
}

عام عرف خطط_إعادة_تسمية_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي,
    الاسم_الجديد: &نص
): نتيجة_خطة_إعادة_تسمية_دلالية {
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختياري.موجود(الاستعلامات) -> {
        طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | اختياري.موجود(الظهور) -> {
            طابق حضر_إعادة_تسمية_دلالية(&الاستعلامات, &الظهور) مع
            | نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(السبب) -> {
                أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(السبب);
            }
            | نتيجة_تحضير_إعادة_تسمية_دلالية.جاهز(الهدف) -> {
                // Only the occurrences spelled like the selected one change.
                ليكن المكتوبة: متجه ط8 = هوية_مكتوبة_عند(&(*الواجهة).خريطة_المصادر, الظهور.النطاق);
                أرجع خطط_إعادة_تسمية_دلالية_بمصادر(
                    &الاستعلامات, الهدف, الاسم_الجديد, &(*الواجهة).روابط_الأسماء,
                    &(*الواجهة).خريطة_المصادر, &المكتوبة
                );
            };
        };
    };
}

عام عرف تهجئة_نوع_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع
): اختياري نص {
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأسماء) -> {
        أرجع تهجئة_عرض_نوع_دلالي(&(*الواجهة).سياقات_الأنواع.الأنواع, &الأسماء, النوع);
    };
}

عام عرف تهجئة_نوع_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري نص {
    طابق نوع_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> { أرجع تهجئة_نوع_واجهة(الواجهة, النوع); };
}

// General tooling queries over canonical Name facts retained by a tooling
// Frontend request. They expose classification/enumeration without exposing
// Name storage ownership to protocol consumers.
عام عرف ظهورات_مصنفة_واجهة_لمصدر(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي
): متجه ظهور_مصنف_دلاليا {
    ليكن الناتج: متغير متجه ظهور_مصنف_دلاليا = [];
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
            إذا ((*الواجهة).الوحدات[ف].معرف_المصدر == المصدر) {
                إذا (ف < (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
                    أرجع صنف_ظهورات_مصدر_عند_استعلام(
                        &الأسماء, &(*الواجهة).روابط_الأسماء[ف], المصدر
                    );
                };
                أرجع الناتج;
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

عام عرف رموز_واجهة_لمصدر(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي
): متجه رمز_دلالي {
    ليكن الناتج: متغير متجه رمز_دلالي = [];
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> { أرجع رموز_مصدر_عند_استعلام(&الأسماء, المصدر); };
}

عام عرف كل_رموز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة
): متجه رمز_دلالي {
    ليكن الناتج: متغير متجه رمز_دلالي = [];
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> { أرجع كل_الرموز_عند_استعلام(&الأسماء); };
}

// Tooling-neutral call graph edge composed from Type-owned resolved call facts
// and Name-owned enclosing function declaration facts.
عام نوع حافة_استدعاء_دلالية = {
    المستدعي: معرف_رمز,
    المستدعى: معرف_رمز,
    النطاق: نطاق
};

عام عرف حواف_استدعاء_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة
): متجه حافة_استدعاء_دلالية {
    ليكن الناتج: متغير متجه حافة_استدعاء_دلالية = [];
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن الاستعلامات_المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الاستعلامات) -> {
        ليكن و: متغير طبيعي = 0;
        طالما (و < (الطول((*الواجهة).سياقات_الأنواع.أنواع_التعبيرات) مثل طبيعي)) {
            ليكن مرجع_السياق: &سياق_أنواع_تعبيرات = &(*الواجهة).سياقات_الأنواع.أنواع_التعبيرات[و];
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*مرجع_السياق).الاستدعاءات) مثل طبيعي)) {
                ليكن مرجع_الاستدعاء: &حقيقة_استدعاء_نوعية = &(*مرجع_السياق).الاستدعاءات[ف];
                طابق (*مرجع_الاستدعاء).الرمز مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(المستدعى) -> {
                    ليكن المصدر: طبيعي = (*مرجع_الاستدعاء).النطاق.البداية.المصدر;
                    ليكن البايت: طبيعي = (*مرجع_الاستدعاء).النطاق.البداية.البايت;
                    طابق رمز_دالة_حاوية_عند_استعلام(&الاستعلامات, المصدر, البايت) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(المستدعي) -> {
                        ليكن نطاق_الاستدعاء: نطاق = (*مرجع_الاستدعاء).النطاق;
                        ليكن الحافة: حافة_استدعاء_دلالية = {
                            المستدعي: المستدعي,
                            المستدعى: المستدعى,
                            النطاق: نطاق_الاستدعاء
                        };
                        ألحق(الناتج, الحافة);
                    };
                };
                ف := ف + 1;
            }
            و := و + 1;
        }
        أرجع الناتج;
    };
}

عام عرف استدعاءات_صادرة_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه حافة_استدعاء_دلالية {
    ليكن الناتج: متغير متجه حافة_استدعاء_دلالية = [];
    ليكن الحواف: متجه حافة_استدعاء_دلالية = حواف_استدعاء_واجهة(الواجهة);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحواف) مثل طبيعي)) {
        ليكن الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        إذا (معرفا_رمز_متساويان(الحافة.المستدعي, الرمز)) { ألحق(الناتج, الحافة); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف استدعاءات_واردة_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه حافة_استدعاء_دلالية {
    ليكن الناتج: متغير متجه حافة_استدعاء_دلالية = [];
    ليكن الحواف: متجه حافة_استدعاء_دلالية = حواف_استدعاء_واجهة(الواجهة);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحواف) مثل طبيعي)) {
        ليكن الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        إذا (معرفا_رمز_متساويان(الحافة.المستدعى, الرمز)) { ألحق(الناتج, الحافة); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Canonical type-hierarchy relations. SultanC currently has no nominal inheritance;
// type-alias declarations are the language's explicit named type relation. The Type
// layer records the direct source relation before alias canonicalization erases it.
عام عرف أنواع_عليا_لرمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه معرف_رمز {
    ليكن الناتج: متغير متجه معرف_رمز = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).سياقات_الأنواع.علاقات_هرم_الأنواع) مثل طبيعي)) {
        ليكن العلاقة: علاقة_هرم_نوع = (*الواجهة).سياقات_الأنواع.علاقات_هرم_الأنواع[ف];
        إذا (معرفا_رمز_متساويان(العلاقة.النوع_الفرعي, الرمز)) {
            ألحق(الناتج, العلاقة.النوع_العلوي);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنواع_فرعية_لرمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه معرف_رمز {
    ليكن الناتج: متغير متجه معرف_رمز = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).سياقات_الأنواع.علاقات_هرم_الأنواع) مثل طبيعي)) {
        ليكن العلاقة: علاقة_هرم_نوع = (*الواجهة).سياقات_الأنواع.علاقات_هرم_الأنواع[ف];
        إذا (معرفا_رمز_متساويان(العلاقة.النوع_العلوي, الرمز)) {
            ألحق(الناتج, العلاقة.النوع_الفرعي);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_منشئ_نواة_موثق_واجهة(القيمة: &متجه منشئ_نواة_موثق_واجهة): متجه منشئ_نواة_موثق_واجهة {
    ليكن الناتج: متغير متجه منشئ_نواة_موثق_واجهة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_منشئ_نواة_موثق_واجهة(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_منشئ_نواة_موثق_واجهة(القيمة: &منشئ_نواة_موثق_واجهة): منشئ_نواة_موثق_واجهة {
    ليكن الناتج: منشئ_نواة_موثق_واجهة = {
        الرمز: (*القيمة).الرمز,
        الاسم: انسخ_نص(&(*القيمة).الاسم),
        الترتيب: (*القيمة).الترتيب,
        التوقيع: انسخ_مملوكا_توقيع_نداء_بدائي(&(*القيمة).التوقيع)
    };
    أرجع الناتج;
}
