        );
        طابق المرتبط مع
        | اختياري.موجود(نطاق_العام) -> {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_العام) مع
            | اختياري.موجود(المصدر_المرتبط) -> {
                دع أضيف_المرتبط: منطقي = أضف_نطاقا_مرتبطا(
