عام نوع وحدة_نحوية_محملة = { الوحدة: معرف_وحدة, الشجرة: وحدة_مصدر };

// Composition only: each semantic owner keeps its canonical context; this is not a second database.
عام نوع نتيجة_واجهة_وحدة = {
    // Only facts consumed by MSIR lowering survive the Frontend boundary.
    // Module graph, root-tree duplicate, Memory tables, and SSF scratch are
    // validation-phase state and die before MSIR construction begins.
    الوحدات: متجه وحدة_مصدر,
    هويات_البدائيات: متجه ربط_رمز_بدائي_مترجم,
    روابط_الأسماء: متجه سياق_روابط_أسماء,
    استعلامات_الأسماء: اختيار سياق_استعلامات_أسماء,
    رمز_بدء_البرنامج: اختيار معرف_رمز,
    الأنواع: سجل_أنواع,
    أنواع_التعبيرات: متجه سياق_أنواع_تعبيرات,
    أنواع_الرموز: سياق_أنواع_رموز,
    علاقات_هرم_الأنواع: متجه علاقة_هرم_نوع,
    الأنماط: سجل_أنماط,
    كاملة_دلاليا: منطقي,
    تشخيصات_الأدوات: مجموعة_تشخيصات,
    تحققات_الأنماط: متجه ربط_تحقق_نمط_وحدة,
};

عام نوع خطأ_واجهة_وحدة =
    | تحميل بنوع خطأ_تحميل_وحدة
    | تحميل_استيراد بنوع (خطأ_تحميل_استيرادات, نطاق)
    | معجم بنوع خطأ_معجمي
    | نحو بنوع خطأ_نحوي
    | خلل_نحوي_داخلي
    | أنواع بنوع خطأ_بناء_سياقات_أنواع
    | أنماط بنوع خطأ_أنماط_وحدة
;

عام نوع نتيجة_بناء_واجهة_وحدة =
    | مكتملة بنوع نتيجة_واجهة_وحدة
    | مرفوضة بنوع مجموعة_تشخيصات
;

عام نوع نتيجة_بناء_واجهة_قابلة_للإلغاء =
    | مكتملة بنوع نتيجة_واجهة_وحدة
    | مرفوضة بنوع مجموعة_تشخيصات
    | ملغاة
;

عرف تشخيصات_فشل_واجهة_عند(
    المعرف: معرف_تشخيص,
    المصدر: اختيار نطاق_مصدر_تشخيص
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع التشخيص: تشخيص = ابدأ_تشخيصا(المعرف, المصدر);
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فشل_واجهة(المعرف: معرف_تشخيص): مجموعة_تشخيصات {
    أرجع تشخيصات_فشل_واجهة_عند(المعرف, اختيار.لا_شيء());
}

عرف تشخيصات_فشل_واجهة_مفصلة(
    المعرف: معرف_تشخيص,
    المصدر: اختيار نطاق_مصدر_تشخيص,
    المرحلة: نص,
    السبب: نص
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, المصدر);
    دع أضف_مرحلة_مفصلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), المرحلة
    );
    دع أضف_سبب_مفصل: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), السبب
    );
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف سبب_فئة_خطأ_معجمي(الفئة: فئة_خطأ_معجمي): نص {
    طابق الفئة مع
    | فئة_خطأ_معجمي.بناء -> { أرجع «lexer.construction»; }
    | فئة_خطأ_معجمي.يوتيف8 -> { أرجع «lexer.utf8»; }
    | فئة_خطأ_معجمي.داخلي -> { أرجع «lexer.internal»; };
}

عرف سبب_فئة_خطأ_نحوي(الفئة: فئة_خطأ_نحوي): نص {
    طابق الفئة مع
    | فئة_خطأ_نحوي.متوقع -> { أرجع «parser.expected-token»; }
    | فئة_خطأ_نحوي.فاصلة_منقوطة_في_غير_موضعها -> { أرجع «parser.misplaced-semicolon»; }
    | فئة_خطأ_نحوي.تهجئة_كلمة_محجوزة_محتملة -> { أرجع «parser.keyword-typo»; }
    | فئة_خطأ_نحوي.عبارة_بلا_عملية -> { أرجع «parser.statement-without-operation»; }
    | فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود -> { أرجع «parser.missing-function-return-type»; }
    | فئة_خطأ_نحوي.تعبير -> { أرجع «parser.expression»; }
    | فئة_خطأ_نحوي.نوع -> { أرجع «parser.type»; }
    | فئة_خطأ_نحوي.نمط -> { أرجع «parser.pattern»; }
    | فئة_خطأ_نحوي.عنصر -> { أرجع «parser.item»; }
    | فئة_خطأ_نحوي.داخلي -> { أرجع «parser.internal»; };
}

عرف سبب_خطأ_تحميل_وحدة(الخطأ: خطأ_تحميل_وحدة): نص {
    طابق الخطأ مع
    | خطأ_تحميل_وحدة.مصدر_غير_موجود -> { أرجع «module.source-not-found»; }
    | خطأ_تحميل_وحدة.مصدر_غير_مقروء -> { أرجع «module.source-unreadable»; }
    | خطأ_تحميل_وحدة.مرجع_غير_صالح -> { أرجع «module.invalid-import-reference»; }
    | خطأ_تحميل_وحدة.جذر_غير_معلن -> { أرجع «module.library-root-unregistered»; }
    | خطأ_تحميل_وحدة.هروب_من_الجذر -> { أرجع «module.import-escapes-root»; }
    | خطأ_تحميل_وحدة.مسار_منطقي_غير_صالح -> { أرجع «module.invalid-logical-path»; }
    | خطأ_تحميل_وحدة.تعارض_مسار_عام -> { أرجع «module.public-path-conflict»; }
    | خطأ_تحميل_وحدة.مصدر_وحدة_متعارض -> { أرجع «module.source-conflict»; }
    | خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة -> { أرجع «module.import-not-loaded»; }
    | خطأ_تحميل_وحدة.دورة_استيراد -> { أرجع «module.import-cycle»; }
    | خطأ_تحميل_وحدة.رسم_وحدات_مرفوض -> { أرجع «module.graph-rejected»; }
    | خطأ_تحميل_وحدة.تصدير_انتقائي_مفقود -> { أرجع «module.selective-export-not-found»; };
}

عرف معرف_تشخيص_خطأ_تحميل_وحدة(الخطأ: خطأ_تحميل_وحدة): معرف_تشخيص {
    طابق الخطأ مع
    | خطأ_تحميل_وحدة.دورة_استيراد -> { أرجع معرف_تشخيص.دورة_استيراد(); }
    | خطأ_تحميل_وحدة.تصدير_انتقائي_مفقود -> { أرجع معرف_تشخيص.اسم_غير_معروف(); }
    | _ -> { أرجع معرف_تشخيص.وحدة_مصدر_غير_موجودة(); };
}

عرف تشخيصات_خطأ_تحميل_وحدة_مفصلة(
    الخطأ: خطأ_تحميل_وحدة,
    فهرس_الاستيراد: اختيار غير_موقع,
    المصدر: اختيار نطاق_مصدر_تشخيص
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_خطأ_تحميل_وحدة(الخطأ), المصدر
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «module-loading»
    );
    دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), سبب_خطأ_تحميل_وحدة(الخطأ)
    );
    طابق فهرس_الاستيراد مع
    | اختيار.بعض(الفهرس) -> {
        دع أضف_الفهرس: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
    }
    | اختيار.لا_شيء -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_خلل_نحوي_داخلي(): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.لا_ناتج_تحليل(), اختيار.لا_شيء()
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «parser.internal-no-result»
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف مصدر_تشخيص_من_نطاق_محمل(
    المحمل: &محمل_وحدات,
    النطاق: نطاق
): اختيار نطاق_مصدر_تشخيص {
    دع الاسم: اختيار نص = اسم_مصدر_محمل_بالمعرف(
        المحمل, النطاق.البداية.المصدر
    );
    دع المقتطف: اختيار نص = مقتطف_مصدر_محمل_لنطاق(المحمل, &النطاق);
    دع المصدر: نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_بأصل(
        النطاق, الاسم, المقتطف
    );
    أرجع اختيار.بعض(المصدر);
}

عرف تشخيصات_خطأ_معجمي_مفصلة(
    الخطأ: خطأ_معجمي,
    المحمل: &محمل_وحدات
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_معجمي(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق)
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «lexer»
    );
    دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), سبب_فئة_خطأ_معجمي(الخطأ.الفئة)
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فاصلة_منقوطة_في_غير_موضعها(
    نطاق_الإدراج: نطاق,
    نطاق_الفاصلة: نطاق,
    المحمل: &محمل_وحدات
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.فاصلة_منقوطة_في_غير_موضعها(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الفاصلة)
    );
    ضع_دور_النطاق_الرئيسي(
        &متغير التشخيص, دور_نطاق_تشخيص.فاصلة_منقوطة_في_غير_موضعها()
    );
    طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج) مع
    | اختيار.بعض(المصدر) -> {
        دع أضف_مرتبطا: منطقي = أضف_نطاقا_مرتبطا(
            &متغير التشخيص, المصدر, دور_نطاق_تشخيص.وجهة_فاصلة_منقوطة()
        );
    }
    | اختيار.لا_شيء -> { };
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «parser.misplaced-semicolon»
    );
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص, مفتاح_صياغة.مساعدة_انقل_فاصلة_منقوطة(), بلا_حجج
    );
    طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج) مع
    | اختيار.بعض(مصدر_الإدراج) -> {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الفاصلة) مع
        | اختيار.بعض(مصدر_الحذف) -> {
            دع أضف_الإصلاح: منطقي = أضف_إصلاحا_مركبا_من_تعديلين(
                &متغير التشخيص,
                مصدر_الإدراج,
                «;»,
                مصدر_الحذف,
                «»,
                قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_انقل_فاصلة_منقوطة()
            );
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_تهجئة_كلمة_محجوزة_محتملة(
    الخطأ: خطأ_نحوي,
    المحمل: &محمل_وحدات
): مجموعة_تشخيصات {
    دع المصدر: اختيار نطاق_مصدر_تشخيص =
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق);
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة(), المصدر
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «parser.keyword-typo»
    );
    دع المتوقع_الإنجليزي: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
    دع المتوقع_العربي: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
    دع أضف_المتوقع: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.المتوقع(),
        المتوقع_الإنجليزي,
        المتوقع_العربي
    );
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة(),
        بلا_حجج
    );
    طابق الخطأ.التهجئة_المقترحة مع
    | تهجئة_كلمة_مقترحة.عربية -> {
        دع استبدال_الحجة: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
        دع أضف_الاستبدال: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الاستبدال(), استبدال_الحجة
        );
        طابق التشخيص.المصدر_الرئيسي مع
        | اختيار.بعض(مصدر_الإصلاح) -> {
            دع استبدال_الإصلاح: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
            دع أضف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص,
                مصدر_الإصلاح,
                استبدال_الإصلاح,
                قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة()
            );
        }
        | اختيار.لا_شيء -> { };
    }
    | تهجئة_كلمة_مقترحة.إنجليزية -> {
        دع استبدال_الحجة: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
        دع أضف_الاستبدال: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الاستبدال(), استبدال_الحجة
        );
        طابق التشخيص.المصدر_الرئيسي مع
        | اختيار.بعض(مصدر_الإصلاح) -> {
            دع استبدال_الإصلاح: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
            دع أضف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص,
                مصدر_الإصلاح,
                استبدال_الإصلاح,
                قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة()
            );
        }
        | اختيار.لا_شيء -> { };
    }
    | تهجئة_كلمة_مقترحة.بلا_اقتراح -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_عبارة_بلا_عملية(
    الخطأ: خطأ_نحوي,
    المحمل: &محمل_وحدات
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.عبارة_بلا_عملية(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق)
    );
    ضع_دور_النطاق_الرئيسي(
        &متغير التشخيص, دور_نطاق_تشخيص.عبارة_بلا_عملية()
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «parser.statement-without-operation»
    );
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_أكمل_العبارة_باستدعاء_أو_إسناد(),
        بلا_حجج
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_خطأ_نحوي_مفصلة(
    الخطأ: خطأ_نحوي,
    المحمل: &محمل_وحدات
): مجموعة_تشخيصات {
    لو (الخطأ.الفئة == فئة_خطأ_نحوي.تهجئة_كلمة_محجوزة_محتملة()) {
        أرجع تشخيصات_تهجئة_كلمة_محجوزة_محتملة(الخطأ, المحمل);
    };
    لو (الخطأ.الفئة == فئة_خطأ_نحوي.عبارة_بلا_عملية()) {
        أرجع تشخيصات_عبارة_بلا_عملية(الخطأ, المحمل);
    };
    لو (الخطأ.الفئة == فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود()) {
        دع المصدر_الرئيسي: متغير اختيار نطاق_مصدر_تشخيص =
            مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق);
        دع الدور_الرئيسي: متغير دور_نطاق_تشخيص = دور_نطاق_تشخيص.اكتشاف_المحلل();
        طابق الخطأ.نطاق_الإدراج مع
        | اختيار.بعض(نطاق_الإدراج) -> {
            المصدر_الرئيسي := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج);
            الدور_الرئيسي := دور_نطاق_تشخيص.موضع_متوقع();
        }
        | اختيار.لا_شيء -> { };
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_ناتج_دالة_مفقود(), المصدر_الرئيسي
        );
        ضع_دور_النطاق_الرئيسي(&متغير التشخيص, الدور_الرئيسي);
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق) مع
        | اختيار.بعض(المصدر) -> {
            دع أضف_مرتبطا: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر, دور_نطاق_تشخيص.اكتشاف_المحلل()
            );
        }
        | اختيار.لا_شيء -> { };
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
        );
        دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «parser.missing-function-return-type»
        );
        دع بلا_حجج: متجه حجة_تشخيص = [];
        دع أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_أضف_نوع_ناتج_دالة(), بلا_حجج
        );
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    };
    لو (الخطأ.الفئة == فئة_خطأ_نحوي.فاصلة_منقوطة_في_غير_موضعها()) {
        طابق الخطأ.نطاق_الإدراج مع
        | اختيار.بعض(نطاق_الإدراج) -> {
            طابق الخطأ.نطاق_الفاصلة_المنقوطة_في_غير_موضعها مع
            | اختيار.بعض(نطاق_الفاصلة) -> {
                أرجع تشخيصات_فاصلة_منقوطة_في_غير_موضعها(
                    نطاق_الإدراج, نطاق_الفاصلة, المحمل
                );
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
    };
    دع المصدر_الرئيسي: متغير اختيار نطاق_مصدر_تشخيص =
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق);
    دع الدور_الرئيسي: متغير دور_نطاق_تشخيص = دور_نطاق_تشخيص.اكتشاف_المحلل();
    دع أضف_اكتشافا_مرتبطا: متغير منطقي = خطأ;
    لو (الخطأ.المتوقع == رمز.فاصلة_منقوطة()) {
        طابق الخطأ.نطاق_الإدراج مع
        | اختيار.بعض(نطاق_الإدراج) -> {
            المصدر_الرئيسي := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج);
            الدور_الرئيسي := دور_نطاق_تشخيص.موضع_متوقع();
            أضف_اكتشافا_مرتبطا := صواب;
        }
        | اختيار.لا_شيء -> { };
    };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_نحوي(), المصدر_الرئيسي
    );
    ضع_دور_النطاق_الرئيسي(&متغير التشخيص, الدور_الرئيسي);
    لو (أضف_اكتشافا_مرتبطا) {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق) مع
        | اختيار.بعض(المصدر) -> {
            دع أضف_مرتبطا: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر, دور_نطاق_تشخيص.اكتشاف_المحلل()
            );
        }
        | اختيار.لا_شيء -> { };
    };
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), سبب_فئة_خطأ_نحوي(الخطأ.الفئة)
    );
    دع المتوقع_الإنجليزي: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
    دع المتوقع_العربي: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
    دع الموجود_الإنجليزي: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.الموجود);
    دع الموجود_العربي: نص = تهجئة_عرض_رمز_عربية(الخطأ.الموجود);
    دع أضف_المتوقع: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع_الإنجليزي, المتوقع_العربي
    );
    دع أضف_الموجود: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود_الإنجليزي, الموجود_العربي
    );
    لو (الخطأ.المتوقع == رمز.فاصلة_منقوطة()) {
        دع بلا_حجج: متجه حجة_تشخيص = [];
        دع أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_أضف_فاصلة_منقوطة(), بلا_حجج
        );
        طابق التشخيص.المصدر_الرئيسي مع
        | اختيار.بعض(المصدر) -> {
            دع أضف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص, المصدر, «;», قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_أضف_فاصلة_منقوطة()
            );
        }
        | اختيار.لا_شيء -> { };
    };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_خطأ_أنواع(
    الخطأ: خطأ_بناء_سياقات_أنواع,
    المحمل: &محمل_وحدات
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.اسم_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», «type.missing-name-binding»
        );
    }
    | خطأ_بناء_سياقات_أنواع.هوية_اسم_مفقودة(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.اسم_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», «type.missing-name-identity»
        );
    }
    | خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نوع_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», «type.unresolved-type»
        );
    }
    | خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نوع_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», «type.invalid-type-definition»
        );
    }
    | خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نوع_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», «type.unsupported-expression-type»
        );
    }
    | خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.حقل_سجل_غير_معروف(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», «type.unknown-record-field»
        );
    }
    | خطأ_بناء_سياقات_أنواع.نمط_غير_صالح(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نمط_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», «type.invalid-pattern»
        );
    }
    | خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(الرمز, النطاق) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.حقيقة_دلالية_مفقودة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_1: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_1: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «type.missing-symbol-type»

        );
        دع أضف_الرمز: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عدد_حجج_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_2: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_2: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «type.call-argument-count-mismatch»

        );
        دع أضيف_المتوقع: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع
        );
        دع أضيف_الموجود: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(النطاق, الفهرس, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_حجة_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_3: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_3: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «type.call-argument-type-mismatch»

        );
        دع أضيف_الفهرس: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        دع أضيف_المتوقع: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع.القيمة
        );
        دع أضيف_الموجود: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود.القيمة
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_إرجاع_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_إرجاع_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_4: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_4: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «type.return-type-mismatch»

        );
        دع أضيف_المتوقع: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع.القيمة
        );
        دع أضيف_الموجود: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود.القيمة
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.عدد_حجج_بدائية_غير_مطابق(النطاق, البدائي, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عدد_حجج_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_5: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_5: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «type.primitive-argument-count-mismatch»

        );
        دع أضف_البدائي: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)
        );
        دع أضف_المتوقع: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع
        );
        دع أضف_الموجود: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_مطابق(النطاق, البدائي, الفهرس, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_حجة_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_6: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_6: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «type.primitive-argument-type-mismatch»

        );
        دع أضف_البدائي: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)
        );
        دع أضف_الفهرس: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        دع أضف_المتوقع: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع.القيمة
        );
        دع أضف_الموجود: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود.القيمة
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(النطاق, البدائي, الفهرس, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوعان_غير_متوافقين(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_7: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_7: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «type.invalid-primitive-argument-type»

        );
        دع أضف_البدائي: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)
        );
        دع أضف_الفهرس: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        دع أضف_الموجود: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود.القيمة
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.دلالة_بدائي_غير_متاحة(النطاق, البدائي) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.حقيقة_دلالية_مفقودة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_8: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_8: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «type.primitive-semantics-unavailable»

        );
        دع أضف_البدائي: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(النطاق, النوع) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوعان_غير_متوافقين(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_9: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_9: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «type.expression-not-callable»

        );
        دع أضيف_النوع: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    };
}

عرف سبب_خطأ_بناء_نمط(الخطأ: خطأ_بناء_نمط): نص {
    طابق الخطأ مع
    | خطأ_بناء_نمط.مصدر_غير_متطابق(_) -> { أرجع «pattern.source-mismatch»; }
    | خطأ_بناء_نمط.نطاق_خارج_المصدر(_) -> { أرجع «pattern.span-outside-source»; }
    | خطأ_بناء_نمط.هوية_اسم_مفقودة(_) -> { أرجع «pattern.missing-name-identity»; }
    | خطأ_بناء_نمط.تابع_غير_صالح(_) -> { أرجع «pattern.invalid-child»; };
}

عرف نطاق_خطأ_بناء_نمط(الخطأ: خطأ_بناء_نمط): اختيار نطاق {
    طابق الخطأ مع
    | خطأ_بناء_نمط.مصدر_غير_متطابق(النطاق) -> { أرجع اختيار.بعض(النطاق); }
    | خطأ_بناء_نمط.نطاق_خارج_المصدر(النطاق) -> { أرجع اختيار.بعض(النطاق); }
    | خطأ_بناء_نمط.هوية_اسم_مفقودة(النطاق) -> { أرجع اختيار.بعض(النطاق); }
    | خطأ_بناء_نمط.تابع_غير_صالح(_) -> { أرجع اختيار.لا_شيء(); };
}

عرف سبب_خطأ_تكامل_نمط(الخطأ: خطأ_تكامل_نوع_نمط): نص {
    طابق الخطأ مع
    | خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(_) -> { أرجع «pattern.missing-distinguished-type»; }
    | خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(_) -> { أرجع «pattern.missing-constructor-binding»; }
    | خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(_) -> { أرجع «pattern.non-semantic-constructor»; }
    | خطأ_تكامل_نوع_نمط.تحقق(_) -> { أرجع «pattern.type-validation-failed»; };
}

عرف نطاق_خطأ_تكامل_نمط(الخطأ: خطأ_تكامل_نوع_نمط): نطاق {
    طابق الخطأ مع
    | خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(النطاق) -> { أرجع النطاق; }
    | خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(النطاق) -> { أرجع النطاق; }
    | خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(النطاق) -> { أرجع النطاق; }
    | خطأ_تكامل_نوع_نمط.تحقق(النطاق) -> { أرجع النطاق; };
}

عرف تشخيصات_خطأ_أنماط_مفصلة(
    الخطأ: خطأ_أنماط_وحدة,
    المحمل: &محمل_وحدات
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_أنماط_وحدة.بناء(خطأ_البناء) -> {
        دع المصدر: متغير اختيار نطاق_مصدر_تشخيص = اختيار.لا_شيء();
        طابق نطاق_خطأ_بناء_نمط(خطأ_البناء) مع
        | اختيار.بعض(النطاق) -> { المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق); }
        | اختيار.لا_شيء -> { };
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.نمط_غير_صالح(), المصدر);
        دع أضف_مرحلة_نمط: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «pattern»
        );
        دع أضف_سبب_نمط: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), سبب_خطأ_بناء_نمط(خطأ_البناء)
        );
        طابق خطأ_البناء مع
        | خطأ_بناء_نمط.تابع_غير_صالح(النمط) -> {
            دع أضف_النمط: منطقي = أضف_حجة_غير_موقعة(
                &متغير التشخيص, مفتاح_حجة_تشخيص.النمط(), النمط.القيمة
            );
        }
        | _ -> { };
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_أنماط_وحدة.نوعي(خطأ_النوع) -> {
        دع النطاق: نطاق = نطاق_خطأ_تكامل_نمط(خطأ_النوع);
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نمط_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «pattern», سبب_خطأ_تكامل_نمط(خطأ_النوع)
        );
    };
}

عرف تشخيصات_خطأ_واجهة(
    الخطأ: خطأ_واجهة_وحدة,
    المحمل: &محمل_وحدات
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_واجهة_وحدة.تحميل(الخطأ) -> {
        دع بلا_فهرس: اختيار غير_موقع = اختيار.لا_شيء();
        أرجع تشخيصات_خطأ_تحميل_وحدة_مفصلة(الخطأ, بلا_فهرس, اختيار.لا_شيء());
    }
    | خطأ_واجهة_وحدة.تحميل_استيراد(الخطأ, النطاق) -> {
        دع الفهرس: اختيار غير_موقع = اختيار.بعض(الخطأ.الفهرس);
        أرجع تشخيصات_خطأ_تحميل_وحدة_مفصلة(
            الخطأ.الخطأ, الفهرس, مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
    }
    | خطأ_واجهة_وحدة.معجم(الخطأ) -> {
        أرجع تشخيصات_خطأ_معجمي_مفصلة(الخطأ, المحمل);
    }
    | خطأ_واجهة_وحدة.نحو(الخطأ) -> {
        أرجع تشخيصات_خطأ_نحوي_مفصلة(الخطأ, المحمل);
    }
    | خطأ_واجهة_وحدة.خلل_نحوي_داخلي -> {
        أرجع تشخيصات_خلل_نحوي_داخلي();
    }
    | خطأ_واجهة_وحدة.أنواع(الخطأ) -> {
        أرجع تشخيصات_خطأ_أنواع(الخطأ, المحمل);
    }
    | خطأ_واجهة_وحدة.أنماط(الخطأ) -> {
        أرجع تشخيصات_خطأ_أنماط_مفصلة(الخطأ, المحمل);
    };
}

عرف وحدة_نحوية_مسجلة(المسجلة: &متجه منطقي, المعرف: معرف_وحدة): منطقي {
    دع الحالة: متجه منطقي = *المسجلة;
    لو (المعرف.القيمة >= (الطول(الحالة) مثل غير_موقع)) {
        أرجع خطأ;
    };
    أرجع الحالة[المعرف.القيمة];
}

عرف سجل_وحدة_نحوية(المسجلة: &متغير متجه منطقي, المعرف: معرف_وحدة): فراغ {
    دع الحالة: متغير متجه منطقي = *المسجلة;
    بينما ((الطول(الحالة) مثل غير_موقع) <= المعرف.القيمة) {
        ألحق(الحالة, خطأ);
    }
    الحالة[المعرف.القيمة] := صواب;
    *المسجلة := الحالة;
}

عرف نطاق_استيراد_واجهة(الاستيراد: &استيراد): نطاق {
    دع القيمة: استيراد = *الاستيراد;
    طابق القيمة مع
    | استيراد.اسم(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.نص(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.انتقائي(النطاق, _, _) -> { أرجع النطاق; };
}

عرف حلل_وحدة_محملة_مع_استيراداتها(
    المحمل: &متغير محمل_وحدات, سياق_المصادر: &متغير سياق_هوية_مصدر,
    سياق_الأسماء: &متغير سياق_أسماء, الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية, المعرف: معرف_وحدة,
    الوحدات: &متغير متجه وحدة_نحوية_محملة,
    الوحدات_المسجلة: &متغير متجه منطقي,
    استرداد_الأدوات: منطقي,
    تشخيصات_الأدوات: &متغير مجموعة_تشخيصات,
    الإلغاء: &حالة_إلغاء_واجهة
): اختيار خطأ_واجهة_وحدة {
    لو (هل_واجهة_ملغاة(الإلغاء)) {
        أرجع اختيار.بعض(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
    };
    لو (وحدة_نحوية_مسجلة(الوحدات_المسجلة, المعرف)) {
        أرجع اختيار.لا_شيء();
    };
    طابق وحدة_محملة_بالمعرف(المحمل, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_واجهة_وحدة.تحميل(خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة()));
    }
    | اختيار.بعض(المحملة) -> {
        دع مرجع_المصدر: &مصدر = &المحملة.المصدر;
        دع مصدر_المعجم: مصدر = *مرجع_المصدر;
        طابق حلل_معجميا(مصدر_المعجم) مع
        | نتيجة_تحليل_معجمي.مرفوض(الخطأ) -> {
            أرجع اختيار.بعض(خطأ_واجهة_وحدة.معجم(الخطأ));
        }
        | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
            دع الشجرة_المحللة: متغير اختيار وحدة_مصدر = اختيار.لا_شيء();
            لو (استرداد_الأدوات) {
                دع أخطاء_الاسترداد: متغير متجه خطأ_نحوي = [];
                دع الشجرة_المستردة: وحدة_مصدر = حلل_الرموز_للأدوات(
                    &السلسلة.المصدر, &السلسلة.الرموز, &متغير أخطاء_الاسترداد
                );
                دع أ: متغير غير_موقع = 0;
                بينما (أ < (الطول(أخطاء_الاسترداد) مثل غير_موقع)) {
                    دع مجموعة_الخطأ: مجموعة_تشخيصات = تشخيصات_خطأ_نحوي_مفصلة(
                        أخطاء_الاسترداد[أ], المحمل
                    );
                    ادمج_مجموعة_تشخيصات(تشخيصات_الأدوات, &مجموعة_الخطأ);
                    أ := أ + 1;
                }
                الشجرة_المحللة := اختيار.بعض(الشجرة_المستردة);
            } وإلا {
                طابق حلل_الرموز(&السلسلة.المصدر, &السلسلة.الرموز) مع
                | نتيجة_تحليل.مرفوض(الخطأ) -> {
                    أرجع اختيار.بعض(خطأ_واجهة_وحدة.نحو(الخطأ));
                }
                | نتيجة_تحليل.خلل_داخلي -> {
                    أرجع اختيار.بعض(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
                }
                | نتيجة_تحليل.شجرة(الشجرة) -> {
                    الشجرة_المحللة := اختيار.بعض(الشجرة);
                };
            };
            طابق الشجرة_المحللة مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(خطأ_واجهة_وحدة.خلل_نحوي_داخلي());
            }
            | اختيار.بعض(الشجرة) -> {
                طابق حمل_استيرادات_مباشرة(
                    المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المعرف, &الشجرة
                ) مع
                | نتيجة_تحميل_استيرادات.خطأ(الخطأ) -> {
                    دع نطاق_الاستيراد: متغير نطاق = نطاق_فارغ();
                    لو (الخطأ.الفهرس < (الطول(الشجرة.الاستيرادات) مثل غير_موقع)) {
                        نطاق_الاستيراد := نطاق_استيراد_واجهة(&الشجرة.الاستيرادات[الخطأ.الفهرس]);
                    };
                    أرجع اختيار.بعض(
                        خطأ_واجهة_وحدة.تحميل_استيراد(الخطأ, نطاق_الاستيراد)
                    );
                }
                | نتيجة_تحميل_استيرادات.محملة(المعرفات) -> {
                    دع سجل: وحدة_نحوية_محملة = { الوحدة: المعرف, الشجرة: الشجرة };
                    دع حالة: متغير متجه وحدة_نحوية_محملة = *الوحدات;
                    ألحق(حالة, سجل);
                    *الوحدات := حالة;
                    سجل_وحدة_نحوية(الوحدات_المسجلة, المعرف);

                    دع ف: متغير غير_موقع = 0;
                    بينما (ف < (الطول(المعرفات) مثل غير_موقع)) {
                        طابق حلل_وحدة_محملة_مع_استيراداتها(
                            المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة,
                            المعرفات[ف], الوحدات, الوحدات_المسجلة,
                            استرداد_الأدوات, تشخيصات_الأدوات, الإلغاء
                        ) مع
                        | اختيار.بعض(الخطأ) -> {
                            أرجع اختيار.بعض(الخطأ);
                        }
                        | _ -> { };
                        ف := ف + 1;
                    }
                };
            };
        };
    };
    أرجع اختيار.لا_شيء();
}

عام نوع طلب_واجهة_وحدة = {
    البيئة: بيئة_وحدات_منطقية,
    المفتاح_الجذري: مفتاح_وحدة_مقنن,
    احتفظ_بحقائق_الأدوات: منطقي
};

// Project/tooling analysis reuses one canonical Module/Name/Type universe for every
// supplied project root.  The caller supplies source inventory; Module remains the
// owner of canonical keys, import closure, SourceIDs and ModuleIDs.
عام نوع طلب_واجهة_مشروع = {
    البيئة: بيئة_وحدات_منطقية,
    المفاتيح_الجذرية: متجه مفتاح_وحدة_مقنن,
    احتفظ_بحقائق_الأدوات: منطقي
};

عرف تشخيصات_تصريح_مكرر_مفصلة(
    سياق_الأسماء: &سياق_أسماء,
    المحمل: &محمل_وحدات,
    الموجود: معرف_رمز,
    النطاق_الجديد: نطاق
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.تصريح_مكرر(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق_الجديد)
    );
    دع أضف_مرحلة_10: منطقي = أضف_حجة_تشخيص(

        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»

    );

    دع أضف_سبب_10: منطقي = أضف_حجة_تشخيص(

        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «name.duplicate-declaration»

    );
    دع أضف_الرمز: منطقي = أضف_حجة_غير_موقعة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الموجود.القيمة
    );
    طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, الموجود) مع
    | اختيار.بعض(النطاق_السابق) -> {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق_السابق) مع
        | اختيار.بعض(المصدر_السابق) -> {
            دع أضف_السابق: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر_السابق, دور_نطاق_تشخيص.سياق_مرتبط()
            );
            دع بلا_حجج: متجه حجة_تشخيص = [];
            دع أضف_الملاحظة: منطقي = أضف_ملاحظة(
                &متغير التشخيص, مفتاح_صياغة.ملاحظة_التصريح_السابق(), بلا_حجج
            );
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف سبب_خطأ_ذاكرة_نوع(الخطأ: خطأ_ذاكرة_نوع): نص {
    طابق الخطأ مع
    | خطأ_ذاكرة_نوع.معرف_نوع_غير_صالح(_) -> { أرجع «memory.invalid-type-id»; }
    | خطأ_ذاكرة_نوع.دورة_ملكية_نوع(_) -> { أرجع «memory.ownership-cycle»; }
    | خطأ_ذاكرة_نوع.بنية_سجل_غير_متاحة(_) -> { أرجع «memory.record-shape-unavailable»; }
    | خطأ_ذاكرة_نوع.حقل_سجل_غير_متاح(_, _) -> { أرجع «memory.record-field-unavailable»; }
    | خطأ_ذاكرة_نوع.بنية_نوع_موسوم_غير_متاحة(_) -> { أرجع «memory.tagged-shape-unavailable»; }
    | خطأ_ذاكرة_نوع.منشئ_نوع_غير_متاح(_, _) -> { أرجع «memory.constructor-unavailable»; }
    | خطأ_ذاكرة_نوع.حمولة_منشئ_غير_متاحة(_, _, _) -> { أرجع «memory.constructor-payload-unavailable»; }
    | خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(_) -> { أرجع «memory.unexpected-type-shape»; };
}

عرف نوع_خطأ_ذاكرة(الخطأ: خطأ_ذاكرة_نوع): معرف_نوع {
    طابق الخطأ مع
    | خطأ_ذاكرة_نوع.معرف_نوع_غير_صالح(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.دورة_ملكية_نوع(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.بنية_سجل_غير_متاحة(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.حقل_سجل_غير_متاح(النوع, _) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.بنية_نوع_موسوم_غير_متاحة(النوع) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.منشئ_نوع_غير_متاح(النوع, _) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.حمولة_منشئ_غير_متاحة(النوع, _, _) -> { أرجع النوع; }
    | خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(النوع) -> { أرجع النوع; };
}

عرف تشخيصات_خطأ_ذاكرة(الخطأ: خطأ_ذاكرة_نوع): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_ذاكرة_نوع(), اختيار.لا_شيء()
    );
    دع أضف_مرحلة_ذاكرة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «memory»
    );
    دع أضف_سبب_ذاكرة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), سبب_خطأ_ذاكرة_نوع(الخطأ)
    );
    دع النوع: معرف_نوع = نوع_خطأ_ذاكرة(الخطأ);
    دع أضف_النوع: منطقي = أضف_حجة_غير_موقعة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف معرف_تشخيص_خطأ_تدفق_سلامة(الخطأ: خطأ_تدفق_سلامة): معرف_تشخيص {
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(_) -> { أرجع معرف_تشخيص.استخدام_قبل_التهيئة(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(_) -> { أرجع معرف_تشخيص.استخدام_بعد_النقل(); }
    | خطأ_تدفق_سلامة.استخدام_بعد_التحرير(_) -> { أرجع معرف_تشخيص.مورد_محرر(); }
    | خطأ_تدفق_سلامة.تحرير_مكرر(_) -> { أرجع معرف_تشخيص.مورد_محرر(); }
    | خطأ_تدفق_سلامة.تعارض_استعارة(_, _) -> { أرجع معرف_تشخيص.تعارض_استعارة(); }
    | خطأ_تدفق_سلامة.هروب_غير_صالح(_) -> { أرجع معرف_تشخيص.هروب_مرجع(); }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(_) -> { أرجع معرف_تشخيص.نقل_جزئي_مملوك(); }
    | خطأ_تدفق_سلامة.خطأ_ذاكرة(_) -> { أرجع معرف_تشخيص.خطأ_ذاكرة_نوع(); }
    | _ -> { أرجع معرف_تشخيص.حقيقة_دلالية_مفقودة(); };
}

عرف سبب_خطأ_تدفق_سلامة(الخطأ: خطأ_تدفق_سلامة): نص {
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.محلي_مفقود(_) -> { أرجع «ssf.missing-local»; }
    | خطأ_تدفق_سلامة.محلي_مكرر(_) -> { أرجع «ssf.duplicate-local»; }
    | خطأ_تدفق_سلامة.نوع_محلي_غير_صالح(_, _) -> { أرجع «ssf.invalid-local-type»; }
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(_) -> { أرجع «ssf.assignment-to-immutable»; }
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(_) -> { أرجع «ssf.use-before-initialization»; }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(_) -> { أرجع «ssf.use-after-move»; }
    | خطأ_تدفق_سلامة.استخدام_بعد_التحرير(_) -> { أرجع «ssf.use-after-release»; }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(_) -> { أرجع «ssf.invalid-move»; }
    | خطأ_تدفق_سلامة.تحرير_مكرر(_) -> { أرجع «ssf.double-release»; }
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(_) -> { أرجع «ssf.release-non-owned»; }
    | خطأ_تدفق_سلامة.تعارض_استعارة(_, النوع) -> {
        طابق النوع مع
        | نوع_استعارة.مشتركة -> { أرجع «ssf.borrow-conflict.shared»; }
        | نوع_استعارة.حصرية -> { أرجع «ssf.borrow-conflict.exclusive»; };
    }
    | خطأ_تدفق_سلامة.معرف_استعارة_غير_صالح(_) -> { أرجع «ssf.invalid-borrow-id»; }
    | خطأ_تدفق_سلامة.دمج_غير_صالح(_) -> { أرجع «ssf.invalid-control-flow-merge»; }
    | خطأ_تدفق_سلامة.هروب_غير_صالح(_) -> { أرجع «ssf.invalid-reference-escape»; }
    | خطأ_تدفق_سلامة.ربط_نمط_بلا_رمز(_) -> { أرجع «ssf.pattern-binding-missing-symbol»; }
    | خطأ_تدفق_سلامة.ربط_نمط_بلا_نوع(_) -> { أرجع «ssf.pattern-binding-missing-type»; }
    | خطأ_تدفق_سلامة.خطأ_ذاكرة(خطأ_الذاكرة) -> { أرجع سبب_خطأ_ذاكرة_نوع(خطأ_الذاكرة); };
}

عرف رمز_خطأ_تدفق_سلامة(الخطأ: خطأ_تدفق_سلامة): اختيار معرف_رمز {
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.محلي_مفقود(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.محلي_مكرر(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.نوع_محلي_غير_صالح(الرمز, _) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق) -> { أرجع اختيار.بعض(السياق.الرمز); }
    | خطأ_تدفق_سلامة.استخدام_بعد_التحرير(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.تحرير_مكرر(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, _) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.معرف_استعارة_غير_صالح(المعرف) -> { أرجع اختيار.بعض(المعرف.المالك); }
    | خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف تشخيصات_خطأ_تدفق_سلامة(
    الخطأ: خطأ_تدفق_سلامة,
    سياق_الأسماء: &سياق_أسماء,
    المحمل: &محمل_وحدات
): مجموعة_تشخيصات {
    دع المصدر: متغير اختيار نطاق_مصدر_تشخيص = اختيار.لا_شيء();
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق) -> {
        طابق السياق.الاستخدام مع
        | اختيار.بعض(النطاق) -> {
            المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق);
        }
        | اختيار.لا_شيء -> {
            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, السياق.الرمز) مع
            | اختيار.بعض(النطاق) -> {
                المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق);
            }
            | اختيار.لا_شيء -> { };
        };
    }
    | _ -> {
        طابق رمز_خطأ_تدفق_سلامة(الخطأ) مع
        | اختيار.بعض(الرمز) -> {
            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختيار.بعض(النطاق) -> {
                المصدر := مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق);
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
    };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_خطأ_تدفق_سلامة(الخطأ), المصدر
    );
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق) -> {
        طابق السياق.الاستخدام مع
        | اختيار.بعض(_) -> {
            ضع_دور_النطاق_الرئيسي(
                &متغير التشخيص, دور_نطاق_تشخيص.استخدام_غير_صالح()
            );
            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, السياق.الرمز) مع
            | اختيار.بعض(نطاق_التصريح) -> {
                طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التصريح) مع
                | اختيار.بعض(مصدر_التصريح) -> {
                    دع أضف_المالك: منطقي = أضف_نطاقا_مرتبطا(
                        &متغير التشخيص,
                        مصدر_التصريح,
                        دور_نطاق_تشخيص.المالك_الأصلي()
                    );
                }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
        طابق السياق.أصل_النقل مع
        | اختيار.بعض(نطاق_النقل) -> {
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_النقل) مع
            | اختيار.بعض(مصدر_النقل) -> {
                دع أضف_النقل: منطقي = أضف_نطاقا_مرتبطا(
                    &متغير التشخيص,
                    مصدر_النقل,
                    دور_نطاق_تشخيص.أصل_النقل()
                );
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
    }
    | _ -> { };
    دع أضف_مرحلة_تدفق: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «ssf»
    );
    دع أضف_سبب_تدفق: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), سبب_خطأ_تدفق_سلامة(الخطأ)
    );
    طابق رمز_خطأ_تدفق_سلامة(الخطأ) مع
    | اختيار.بعض(الرمز) -> {
        دع أضف_الرمز: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة
        );
    }
    | اختيار.لا_شيء -> { };
    طابق الخطأ مع
    | خطأ_تدفق_سلامة.نوع_محلي_غير_صالح(_, النوع) -> {
        دع أضف_النوع: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة
        );
    }
    | خطأ_تدفق_سلامة.ربط_نمط_بلا_رمز(النمط) -> {
        دع أضف_النمط: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النمط(), النمط.القيمة
        );
    }
    | خطأ_تدفق_سلامة.ربط_نمط_بلا_نوع(النمط) -> {
        دع أضف_النمط: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النمط(), النمط.القيمة
        );
    }
    | خطأ_تدفق_سلامة.خطأ_ذاكرة(خطأ_الذاكرة) -> {
        دع النوع: معرف_نوع = نوع_خطأ_ذاكرة(خطأ_الذاكرة);
        دع أضف_النوع: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة
        );
    }
    | _ -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف نتيجة_واجهة_ملغاة(): نتيجة_بناء_واجهة_وحدة {
    أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
        تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختيار.لا_شيء(),
            «frontend», «frontend.cancelled»
        )
    );
}

عرف ابن_واجهة_داخلية(
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    المفتاح_الأساسي: &مفتاح_وحدة_مقنن,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    احتفظ_بحقائق_الأدوات: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_وحدة {
    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
    دع البيئة: بيئة_وحدات_منطقية = *البيئة_المدخلة;
    دع المفتاح: مفتاح_وحدة_مقنن = *المفتاح_الأساسي;
    دع سياق_المصادر: متغير سياق_هوية_مصدر = سياق_هوية_مصدر_جديد();
    دع سياق_الأسماء: متغير سياق_أسماء = سياق_أسماء_جديد();
    دع الرسم: متغير رسم_وحدات = رسم_وحدات_جديد();
    دع المحمل: متغير محمل_وحدات = محمل_وحدات_جديد();
    دع الجذر: متغير معرف_وحدة = معرف_وحدة_من(0);
    طابق حمل_وحدة_جذر(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        &البيئة,
        &المفتاح
    ) مع
    | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.تحميل(الخطأ), &المحمل));
    }
    | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
        الجذر := المحملة.الوحدة;
    };

    دع الوحدات: متغير متجه وحدة_نحوية_محملة = [];
    دع الوحدات_المسجلة: متغير متجه منطقي = [];
    دع تشخيصات_الأدوات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    طابق حلل_وحدة_محملة_مع_استيراداتها(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        &البيئة,
        الجذر,
        &متغير الوحدات,
        &متغير الوحدات_المسجلة,
        احتفظ_بحقائق_الأدوات,
        &متغير تشخيصات_الأدوات,
        الإلغاء
    ) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(تشخيصات_خطأ_واجهة(الخطأ, &المحمل));
    }
    | _ -> { };

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Additional project roots are loaded into the same canonical loader/graph and
    // semantic contexts.  Already reachable modules are deduplicated by ModuleKey.
    دع الجذور_الإضافية: متجه مفتاح_وحدة_مقنن = *المفاتيح_الإضافية;
    دع فهرس_الجذر_الإضافي: متغير غير_موقع = 0;
    بينما (فهرس_الجذر_الإضافي < (الطول(الجذور_الإضافية) مثل غير_موقع)) {
        دع مرجع_المفتاح_الإضافي: &مفتاح_وحدة_مقنن =
            &الجذور_الإضافية[فهرس_الجذر_الإضافي];
        دع معرف_الجذر_الإضافي: متغير معرف_وحدة = معرف_وحدة_من(0);
        طابق حمل_وحدة_جذر(
            &متغير المحمل,
            &متغير سياق_المصادر,
            &متغير سياق_الأسماء,
            &متغير الرسم,
            &البيئة,
            مرجع_المفتاح_الإضافي
        ) مع
        | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.تحميل(الخطأ), &المحمل)
            );
        }
        | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
            معرف_الجذر_الإضافي := المحملة.الوحدة;
        };
        طابق حلل_وحدة_محملة_مع_استيراداتها(
            &متغير المحمل,
            &متغير سياق_المصادر,
            &متغير سياق_الأسماء,
            &متغير الرسم,
            &البيئة,
            معرف_الجذر_الإضافي,
            &متغير الوحدات,
            &متغير الوحدات_المسجلة,
            احتفظ_بحقائق_الأدوات,
            &متغير تشخيصات_الأدوات,
            الإلغاء
        ) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_خطأ_واجهة(الخطأ, &المحمل)
            );
        }
        | _ -> { };
        فهرس_الجذر_الإضافي := فهرس_الجذر_الإضافي + 1;
    }

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Compiler-provided primitive Names are registered once into canonical Symbols
    // before ordinary source declarations are collected. They are not source modules.
    طابق وحدة_في_الرسم(&الرسم, الجذر) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختيار.لا_شيء(),
                «name», «name.root-module-fact-missing»
            )
        );
    }
    | اختيار.بعض(الوحدة_الجذرية) -> {
        لو (!سجل_بدائيات_المترجم(
            &متغير سياق_الأسماء, الوحدة_الجذرية.النطاق_الجذري
        )) {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.خطأ_سياق_داخلي(), اختيار.لا_شيء(),
                    «name», «name.primitive-registration-failed»
                )
            );
        };
    };

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Phase 1: register declarations for every canonical loaded module before
    // resolving any imported use. Discovery order is not semantic dependency order.
    دع التصريحات_المجمعة: متغير متجه جدول_تصريحات = [];
    دع فهرس_التصريحات: متغير غير_موقع = 0;
    بينما (فهرس_التصريحات < (الطول(الوحدات) مثل غير_موقع)) {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
        طابق اجمع_تصريحات_أسماء_وحدة(
            &متغير سياق_الأسماء,
            &الرسم,
            الوحدات[فهرس_التصريحات].الوحدة,
            &الوحدات[فهرس_التصريحات].الشجرة
        ) مع
        | نتيجة_جمع_تصريحات_أسماء_وحدة.مكتملة(التصريحات) -> {
            ألحق(التصريحات_المجمعة, التصريحات);
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.وحدة_مجهولة -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختيار.لا_شيء(),
                    «name», «name.declaration-collection.unknown-module»
                )
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.مصدر_غير_مطابق -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختيار.لا_شيء(),
                    «name», «name.declaration-collection.source-mismatch»
                )
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.تصريح_مكرر(الموجود, النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_تصريح_مكرر_مفصلة(
                    &سياق_الأسماء, &المحمل, الموجود, النطاق
                )
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_مفقود(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.اسم_غير_معروف(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.declaration-collection.missing-name»
                )
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_خاص(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.اسم_غير_معروف(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.declaration-collection.private-name»
                )
            );
        }
        | نتيجة_جمع_تصريحات_أسماء_وحدة.تعارض_ربط(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.خطأ_سياق_داخلي(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.declaration-collection.binding-conflict»
                )
            );
        };
        فهرس_التصريحات := فهرس_التصريحات + 1;
    }

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Selective imports are declarations of scope visibility, not lazy name-use
    // filters. Validate every requested export now that all module declarations exist.
    دع فهرس_تحقق_الاستيراد: متغير غير_موقع = 0;
    بينما (فهرس_تحقق_الاستيراد < (الطول(الوحدات) مثل غير_موقع)) {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
        طابق تحقق_استيرادات_انتقائية(
            &سياق_الأسماء, &الرسم, الوحدات[فهرس_تحقق_الاستيراد].الوحدة
        ) مع
        | نتيجة_تحقق_استيراد_انتقائي.صالح -> { }
        | نتيجة_تحقق_استيراد_انتقائي.اسم_مفقود(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.اسم_غير_معروف(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.selective-import.missing-name»
                )
            );
        }
        | نتيجة_تحقق_استيراد_انتقائي.اسم_خاص(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.اسم_غير_معروف(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.selective-import.private-name»
                )
            );
        }
        | نتيجة_تحقق_استيراد_انتقائي.اسم_غامض(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.استيراد_غامض(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.selective-import.ambiguous-name»
                )
            );
        };
        فهرس_تحقق_الاستيراد := فهرس_تحقق_الاستيراد + 1;
    }

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    // Phase 2: preserve the established per-module resolution order. Every direct
    // import now observes declarations that were registered exactly once above.
    // Resolved source occurrences remain owned by their module. Downstream phases
    // consume the binding context aligned with the corresponding module tree;
    // no whole-program binding table is materialized or rescanned.
    دع روابط_الوحدات: متغير متجه سياق_روابط_أسماء = [];
    دع فهرس_روابط: متغير غير_موقع = 0;
    بينما (فهرس_روابط < (الطول(الوحدات) مثل غير_موقع)) {
        ألحق(روابط_الوحدات, سياق_روابط_أسماء_جديد());
        فهرس_روابط := فهرس_روابط + 1;
    }
    دع شجرة_الجذر: متغير اختيار وحدة_مصدر = اختيار.لا_شيء();
    دع رمز_بدء_البرنامج: متغير اختيار معرف_رمز = اختيار.لا_شيء();
    دع ف: متغير غير_موقع = الطول(الوحدات) مثل غير_موقع;
    بينما (ف > 0) {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
        ف := ف - 1;
        طابق ابن_دلالة_أسماء_وحدة_من_تصريحات(
            &متغير سياق_الأسماء,
            &الرسم,
            الوحدات[ف].الوحدة,
            &الوحدات[ف].الشجرة,
            &التصريحات_المجمعة[ف]
        ) مع
        | نتيجة_دلالة_أسماء_وحدة.مكتملة(الدلالة) -> {
            دع مرجع_روابط_الوحدة: &سياق_روابط_أسماء = &الدلالة.الروابط;
            روابط_الوحدات[ف] := *مرجع_روابط_الوحدة;
            لو (معرفا_وحدة_متساويان(الوحدات[ف].الوحدة, الجذر)) {
                دع مرجع_الشجرة: &وحدة_مصدر = &الوحدات[ف].الشجرة;
                دع نسخة_الشجرة: وحدة_مصدر = *مرجع_الشجرة;
                شجرة_الجذر := اختيار.بعض(نسخة_الشجرة);
                رمز_بدء_البرنامج := رمز_بدء_البرنامج_من_تصريحات(
                    &سياق_الأسماء, &التصريحات_المجمعة[ف]
                );
            };
        }
        | نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختيار.لا_شيء(),
                    «name», «name.resolution.unknown-module»
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.مصدر_غير_مطابق -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.حقيقة_دلالية_مفقودة(), اختيار.لا_شيء(),
                    «name», «name.resolution.source-mismatch»
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.تصريح_مكرر(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.تصريح_مكرر(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.resolution.duplicate-declaration»
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.اسم_مفقود(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.اسم_غير_معروف(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.resolution.missing-name»
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.اسم_خاص(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.اسم_غير_معروف(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.resolution.private-name»
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.اسم_غامض(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.استيراد_غامض(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.resolution.ambiguous-name»
                )
            );
        }
        | نتيجة_دلالة_أسماء_وحدة.تعارض_ربط(النطاق) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                تشخيصات_فشل_واجهة_مفصلة(
                    معرف_تشخيص.خطأ_سياق_داخلي(), مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                    «name», «name.resolution.binding-conflict»
                )
            );
        };
    }

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    دع أشجار_الوحدات: متغير متجه وحدة_مصدر = [];
    دع فهرس_الشجرة: متغير غير_موقع = 0;
    بينما (فهرس_الشجرة < (الطول(الوحدات) مثل غير_موقع)) {
        دع مرجع_شجرة_الوحدة: &وحدة_مصدر = &الوحدات[فهرس_الشجرة].الشجرة;
        دع شجرة_الوحدة: وحدة_مصدر = *مرجع_شجرة_الوحدة;
        ألحق(أشجار_الوحدات, شجرة_الوحدة);
        فهرس_الشجرة := فهرس_الشجرة + 1;
    }

    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };

    طابق شجرة_الجذر مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختيار.لا_شيء(),
                «frontend», «frontend.root-syntax-tree-missing»
            )
        );
    }
    | اختيار.بعض(الشجرة) -> {
        طابق ابن_سياقات_أنواع_وحدات(&أشجار_الوحدات, &سياق_الأسماء, &روابط_الوحدات) مع
        | نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ) -> {
            أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.أنواع(الخطأ), &المحمل));
        }
        | نتيجة_بناء_سياقات_أنواع.مبنية(سياقات_الأنواع) -> {
            لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
            دع تكامل_نوع_النمط: سياق_تكامل_نوع_نمط = سياق_تكامل_نوع_نمط_من(
                &سياقات_الأنواع.الأنواع, &سياقات_الأنواع.أنواع_التعبيرات
            );
            طابق ابن_أنماط_وحدات(&أشجار_الوحدات, &متغير سياق_الأسماء, &روابط_الوحدات, &تكامل_نوع_النمط) مع
            | نتيجة_أنماط_وحدة.مرفوضة(الخطأ) -> {
                أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.أنماط(الخطأ), &المحمل));
            }
            | نتيجة_أنماط_وحدة.مكتملة(سياق_الأنماط) -> {
                لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
                دع مرجع_الأنواع: &سجل_أنواع = &سياقات_الأنواع.الأنواع;
                دع الأنواع: سجل_أنواع = *مرجع_الأنواع;
                دع مرجع_أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات = &سياقات_الأنواع.أنواع_التعبيرات;
                دع أنواع_التعبيرات: متجه سياق_أنواع_تعبيرات = *مرجع_أنواع_التعبيرات;
                دع مرجع_أنواع_الرموز: &سياق_أنواع_رموز = &سياقات_الأنواع.أنواع_الرموز;
                دع أنواع_الرموز: سياق_أنواع_رموز = *مرجع_أنواع_الرموز;
                دع مرجع_علاقات_هرم_الأنواع: &متجه علاقة_هرم_نوع = &سياقات_الأنواع.علاقات_هرم_الأنواع;
                دع علاقات_هرم_الأنواع: متجه علاقة_هرم_نوع = *مرجع_علاقات_هرم_الأنواع;
                دع مرجع_الأنماط: &سجل_أنماط = &سياق_الأنماط.الأنماط;
                دع الأنماط: سجل_أنماط = *مرجع_الأنماط;
                دع مرجع_تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة = &سياق_الأنماط.التحققات;
                دع تحققات_الأنماط: متجه ربط_تحقق_نمط_وحدة = *مرجع_تحققات_الأنماط;

                // Memory is the canonical static ownership classifier. SSF consumes
                // those facts only after Name/Type/Pattern have completed successfully.
                طابق ابن_ذاكرة_وحدة(&الأنواع) مع
                | نتيجة_ذاكرة_وحدة.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                        تشخيصات_خطأ_ذاكرة(الخطأ)
                    );
                }
                | نتيجة_ذاكرة_وحدة.مكتملة(سياق_الذاكرة) -> {
                    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
                    طابق ابن_تدفق_سلامة_وحدات(
                        &أشجار_الوحدات,
                        &سياق_الأسماء,
                        &روابط_الوحدات,
                        &سياق_الذاكرة,
                        &الأنواع,
                        &أنواع_الرموز,
                        &أنواع_التعبيرات,
                        &الأنماط,
                        &تحققات_الأنماط
                    ) مع
                    | نتيجة_تدفق_سلامة_وحدة.حقيقة_دلالية_مفقودة(النطاق) -> {
                        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                            تشخيصات_فشل_واجهة_مفصلة(
                                معرف_تشخيص.حقيقة_دلالية_مفقودة(),
                                مصدر_تشخيص_من_نطاق_محمل(&المحمل, النطاق),
                                «ssf», «ssf.semantic-fact-missing»
                            )
                        );
                    }
                    | نتيجة_تدفق_سلامة_وحدة.مرفوضة(الخطأ) -> {
                        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
                            تشخيصات_خطأ_تدفق_سلامة(الخطأ, &سياق_الأسماء, &المحمل)
                        );
                    }
                    | نتيجة_تدفق_سلامة_وحدة.مكتملة(سياق_التدفق) -> {
                        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_واجهة_ملغاة(); };
                        دع مرجع_هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم =
                            &سياق_الأسماء.هويات_البدائيات;
                        دع هويات_البدائيات: متجه ربط_رمز_بدائي_مترجم = *مرجع_هويات_البدائيات;
                        دع استعلامات_الأسماء: متغير اختيار سياق_استعلامات_أسماء = اختيار.لا_شيء();
                        لو (احتفظ_بحقائق_الأدوات) {
                            استعلامات_الأسماء := اختيار.بعض(ابن_سياق_استعلامات_أسماء(&سياق_الأسماء));
                        };
                        دع كاملة_دلاليا: منطقي = !يجب_فشل_الترجمة(&تشخيصات_الأدوات);
                        دع الناتج: نتيجة_واجهة_وحدة = {
                            الوحدات: أشجار_الوحدات,
                            هويات_البدائيات: هويات_البدائيات,
                            روابط_الأسماء: روابط_الوحدات,
                            استعلامات_الأسماء: استعلامات_الأسماء,
                            رمز_بدء_البرنامج: رمز_بدء_البرنامج,
                            الأنواع: الأنواع,
                            أنواع_التعبيرات: أنواع_التعبيرات,
                            أنواع_الرموز: أنواع_الرموز,
                            علاقات_هرم_الأنواع: علاقات_هرم_الأنواع,
                            الأنماط: الأنماط,
                            كاملة_دلاليا: كاملة_دلاليا,
                            تشخيصات_الأدوات: تشخيصات_الأدوات,
                            تحققات_الأنماط: تحققات_الأنماط
                        };
                        أرجع نتيجة_بناء_واجهة_وحدة.مكتملة(الناتج);
                    };
                };
            };
        };
    };
}

عام عرف ابن_واجهة_وحدة(
    الطلب: طلب_واجهة_وحدة
): نتيجة_بناء_واجهة_وحدة {
    دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &الطلب.المفتاح_الجذري;
    دع الإضافية: متجه مفتاح_وحدة_مقنن = [];
    دع الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    أرجع ابن_واجهة_داخلية(
        مرجع_البيئة, مرجع_المفتاح, &الإضافية, الطلب.احتفظ_بحقائق_الأدوات, &الإلغاء
    );
}

// Project discovery may enumerate filesystem candidates, but semantic project
// membership is owned by the canonical Module graph.  A candidate belongs to the
// anchored project when its import closure reaches the anchor.  Forward dependencies
// of the anchor are already loaded by the normal module closure and need not become
// additional roots.
نوع نتيجة_اختيار_جذور_مشروع =
    | مكتملة بنوع متجه مفتاح_وحدة_مقنن
    | مرفوضة بنوع مجموعة_تشخيصات
;

عرف وحدة_رسم_تصل_إلى(
    الرسم: &رسم_وحدات,
    البداية: معرف_وحدة,
    الهدف: معرف_وحدة
): منطقي {
    لو (البداية.القيمة == الهدف.القيمة) { أرجع صواب; };
    دع الحالة: رسم_وحدات = *الرسم;
    دع العدد: غير_موقع = الحالة.معرف_الوحدة_التالي;
    لو (البداية.القيمة >= العدد || الهدف.القيمة >= العدد) { أرجع خطأ; };

    دع المزارة: متغير متجه منطقي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(المزارة, خطأ);
        ف := ف + 1;
    }
    دع الطابور: متغير متجه معرف_وحدة = [];
    ألحق(الطابور, البداية);
    المزارة[البداية.القيمة] := صواب;

    دع موضع: متغير غير_موقع = 0;
    بينما (موضع < (الطول(الطابور) مثل غير_موقع)) {
        دع الحالي: معرف_وحدة = الطابور[موضع];
        دع ح: متغير غير_موقع = 0;
        دع عدد_الاستيرادات: غير_موقع = عدد_استيرادات_الوحدة(&الحالة, الحالي);
        بينما (ح < عدد_الاستيرادات) {
            دع التالي: معرف_وحدة = استيراد_الوحدة_عند(&الحالة, الحالي, ح);
            لو (التالي.القيمة == الهدف.القيمة) { أرجع صواب; };
            لو (التالي.القيمة < العدد && !المزارة[التالي.القيمة]) {
                المزارة[التالي.القيمة] := صواب;
                ألحق(الطابور, التالي);
            };
            ح := ح + 1;
        }
        موضع := موضع + 1;
    }
    أرجع خطأ;
}

عرف اختر_جذور_مشروع_مرتبطة(
    البيئة_المدخلة: &بيئة_وحدات_منطقية,
    المفاتيح_المدخلة: &متجه مفتاح_وحدة_مقنن,
    استرداد_الأدوات: منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_اختيار_جذور_مشروع {
    لو (هل_واجهة_ملغاة(الإلغاء)) {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختيار.لا_شيء(), «frontend», «frontend.cancelled»
        ));
    };
    دع المفاتيح: متجه مفتاح_وحدة_مقنن = *المفاتيح_المدخلة;
    لو ((الطول(المفاتيح) مثل غير_موقع) == 0) {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختيار.لا_شيء(),
                «frontend», «frontend.project-without-roots»
            )
        );
    };

    دع البيئة: بيئة_وحدات_منطقية = *البيئة_المدخلة;
    دع سياق_المصادر: متغير سياق_هوية_مصدر = سياق_هوية_مصدر_جديد();
    دع سياق_الأسماء: متغير سياق_أسماء = سياق_أسماء_جديد();
    دع الرسم: متغير رسم_وحدات = رسم_وحدات_جديد();
    دع المحمل: متغير محمل_وحدات = محمل_وحدات_جديد();
    دع الوحدات: متغير متجه وحدة_نحوية_محملة = [];
    دع الوحدات_المسجلة: متغير متجه منطقي = [];
    دع تشخيصات_اختيار_الأدوات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();

    دع مرجع_المفتاح_الأساسي: &مفتاح_وحدة_مقنن = &المفاتيح[0];
    دع الجذر: متغير معرف_وحدة = معرف_وحدة_من(0);
    طابق حمل_وحدة_جذر(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        &البيئة,
        مرجع_المفتاح_الأساسي
    ) مع
    | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(
            تشخيصات_خطأ_واجهة(خطأ_واجهة_وحدة.تحميل(الخطأ), &المحمل)
        );
    }
    | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
        الجذر := المحملة.الوحدة;
    };

    // The anchor and its forward dependencies are mandatory project members.
    // Their load/parse failures are canonical project failures, not candidates to ignore.
    طابق حلل_وحدة_محملة_مع_استيراداتها(
        &متغير المحمل,
        &متغير سياق_المصادر,
        &متغير سياق_الأسماء,
        &متغير الرسم,
        &البيئة,
        الجذر,
        &متغير الوحدات,
        &متغير الوحدات_المسجلة,
        استرداد_الأدوات,
        &متغير تشخيصات_اختيار_الأدوات,
        الإلغاء
    ) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(
            تشخيصات_خطأ_واجهة(الخطأ, &المحمل)
        );
    }
    | _ -> { };

    // Parse candidate roots through the canonical lexer/parser/module loader solely
    // to build import relationships.  Candidate-local failures are deferred unless
    // a relationship to the anchored project is established; the final strict build
    // then reports the canonical structured diagnostic for project members.
    دع ف: متغير غير_موقع = 1;
    بينما (ف < (الطول(المفاتيح) مثل غير_موقع)) {
        لو (هل_واجهة_ملغاة(الإلغاء)) {
            أرجع نتيجة_اختيار_جذور_مشروع.مرفوضة(تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختيار.لا_شيء(), «frontend», «frontend.cancelled»
            ));
        };
        دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &المفاتيح[ف];
        طابق حمل_وحدة_جذر(
            &متغير المحمل,
            &متغير سياق_المصادر,
            &متغير سياق_الأسماء,
            &متغير الرسم,
            &البيئة,
            مرجع_المفتاح
        ) مع
        | نتيجة_تحميل_وحدة.خطأ(_) -> { }
        | نتيجة_تحميل_وحدة.محملة(المحملة) -> {
            دع خطأ_مرشح: اختيار خطأ_واجهة_وحدة = حلل_وحدة_محملة_مع_استيراداتها(
                &متغير المحمل,
                &متغير سياق_المصادر,
                &متغير سياق_الأسماء,
                &متغير الرسم,
                &البيئة,
                المحملة.الوحدة,
                &متغير الوحدات,
                &متغير الوحدات_المسجلة,
                استرداد_الأدوات,
                &متغير تشخيصات_اختيار_الأدوات,
                الإلغاء
            );
        };
        ف := ف + 1;
    }

    دع المرتبطة: متغير متجه مفتاح_وحدة_مقنن = [];
    ف := 1;
    بينما (ف < (الطول(المفاتيح) مثل غير_موقع)) {
        دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &المفاتيح[ف];
        طابق وحدة_محملة_بالمفتاح(&المحمل, مرجع_المفتاح) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المحملة) -> {
            لو (وحدة_رسم_تصل_إلى(&الرسم, المحملة.الوحدة, الجذر)) {
                ألحق(المرتبطة, انسخ_مفتاح_وحدة_مقنن(مرجع_المفتاح));
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة_اختيار_جذور_مشروع.مكتملة(المرتبطة);
}

عام عرف ابن_واجهة_مشروع(
    الطلب: طلب_واجهة_مشروع
): نتيجة_بناء_واجهة_وحدة {
    دع الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    دع مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الطلب.المفاتيح_الجذرية;
    دع المفاتيح: متجه مفتاح_وحدة_مقنن = *مرجع_المفاتيح;
    لو ((الطول(المفاتيح) مثل غير_موقع) == 0) {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(
            تشخيصات_فشل_واجهة_مفصلة(
                معرف_تشخيص.خطأ_سياق_داخلي(), اختيار.لا_شيء(),
                «frontend», «frontend.project-without-roots»
            )
        );
    };
    دع مرجع_الأساسي: &مفتاح_وحدة_مقنن = &المفاتيح[0];
    طابق اختر_جذور_مشروع_مرتبطة(مرجع_البيئة, مرجع_المفاتيح, الطلب.احتفظ_بحقائق_الأدوات, &الإلغاء) مع
    | نتيجة_اختيار_جذور_مشروع.مرفوضة(التشخيصات) -> {
        أرجع نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات);
    }
    | نتيجة_اختيار_جذور_مشروع.مكتملة(الإضافية) -> {
        أرجع ابن_واجهة_داخلية(
            مرجع_البيئة, مرجع_الأساسي, &الإضافية, الطلب.احتفظ_بحقائق_الأدوات, &الإلغاء
        );
    };
}

// Compiler-owned cancellable entry points for IDE/tooling consumers. Protocol code
// supplies a token; frontend phases only observe it at cooperative checkpoints.
عام عرف ابن_واجهة_وحدة_قابلة_للإلغاء(
    الطلب: طلب_واجهة_وحدة,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
    دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &الطلب.المفتاح_الجذري;
    دع الإضافية: متجه مفتاح_وحدة_مقنن = [];
    طابق ابن_واجهة_داخلية(
        مرجع_البيئة, مرجع_المفتاح, &الإضافية, الطلب.احتفظ_بحقائق_الأدوات, الإلغاء
    ) مع
    | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة);
    }
    | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
    };
}

عام عرف ابن_واجهة_مشروع_قابلة_للإلغاء(
    الطلب: طلب_واجهة_مشروع,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
    دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    دع مرجع_المفاتيح: &متجه مفتاح_وحدة_مقنن = &الطلب.المفاتيح_الجذرية;
    دع المفاتيح: متجه مفتاح_وحدة_مقنن = *مرجع_المفاتيح;
    لو ((الطول(المفاتيح) مثل غير_موقع) == 0) {
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختيار.لا_شيء(), «frontend», «frontend.project-without-roots»
        ));
    };
    دع مرجع_الأساسي: &مفتاح_وحدة_مقنن = &المفاتيح[0];
    طابق اختر_جذور_مشروع_مرتبطة(
        مرجع_البيئة, مرجع_المفاتيح, الطلب.احتفظ_بحقائق_الأدوات, الإلغاء
    ) مع
    | نتيجة_اختيار_جذور_مشروع.مرفوضة(التشخيصات) -> {
        لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
    }
    | نتيجة_اختيار_جذور_مشروع.مكتملة(الإضافية) -> {
        طابق ابن_واجهة_داخلية(
            مرجع_البيئة, مرجع_الأساسي, &الإضافية, الطلب.احتفظ_بحقائق_الأدوات, الإلغاء
        ) مع
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
            لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
            أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة);
        }
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
            لو (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
            أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
        };
    };
}

// General semantic point-query surface for tooling/compiler consumers.
عام عرف مصدر_واجهة_بمعرف(
    الواجهة: &نتيجة_واجهة_وحدة,
    المعرف: غير_موقع
): اختيار مصدر {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الوحدات) مثل غير_موقع)) {
        دع مرجع_المصدر: &مصدر = &الحالة.الوحدات[ف].المصدر;
        دع المصدر: مصدر = *مرجع_المصدر;
        لو (المصدر.المعرف == المعرف) {
            أرجع اختيار.بعض(المصدر);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف اسم_مصدر_واجهة_بمعرف(
    الواجهة: &نتيجة_واجهة_وحدة,
    المعرف: غير_موقع
): اختيار نص {
    طابق مصدر_واجهة_بمعرف(الواجهة, المعرف) مع
    | اختيار.بعض(المصدر) -> {
        دع مرجع_الاسم: &نص = &المصدر.الاسم;
        دع الاسم: نص = *مرجع_الاسم;
        أرجع اختيار.بعض(الاسم);
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عام عرف معرف_مصدر_واجهة_باسم(
    الواجهة: &نتيجة_واجهة_وحدة,
    الاسم: &نص
): اختيار غير_موقع {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الوحدات) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &الحالة.الوحدات[ف];
        دع الوحدة: وحدة_مصدر = *مرجع_الوحدة;
        دع مرجع_المصدر: &مصدر = &الوحدة.المصدر;
        دع المصدر: مصدر = *مرجع_المصدر;
        لو (نصان_متساويان(&المصدر.الاسم, الاسم)) {
            أرجع اختيار.بعض(المصدر.المعرف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ظهور_اسم_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع,
    البايت: غير_موقع
): اختيار ظهور_اسم_محلول {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الوحدات) مثل غير_موقع)) {
        لو (الحالة.الوحدات[ف].المصدر.المعرف == المصدر) {
            لو (ف >= (الطول(الحالة.روابط_الأسماء) مثل غير_موقع)) {
                أرجع اختيار.لا_شيء();
            };
            أرجع ظهور_اسم_محلول_عند_بايت(&الحالة.روابط_الأسماء[ف], المصدر, البايت);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف رمز_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع,
    البايت: غير_موقع
): اختيار معرف_رمز {
    طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
    | اختيار.بعض(الظهور) -> { أرجع الظهور.الرمز; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عام عرف تصريح_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختيار رمز_دلالي {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختيار.بعض(الاستعلامات) -> {
        أرجع رمز_دلالي_عند_استعلام(&الاستعلامات, الرمز);
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عام عرف ظهورات_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه ظهور_اسم_محلول {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع الناتج: متغير متجه ظهور_اسم_محلول = [];
    دع و: متغير غير_موقع = 0;
    بينما (و < (الطول(الحالة.روابط_الأسماء) مثل غير_موقع)) {
        دع مرجع_الروابط: &سياق_روابط_أسماء = &الحالة.روابط_الأسماء[و];
        دع الروابط: سياق_روابط_أسماء = *مرجع_الروابط;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الروابط.الظهورات) مثل غير_موقع)) {
            دع مرجع_الظهور: &ظهور_اسم_محلول = &الروابط.الظهورات[ف];
            دع الظهور: ظهور_اسم_محلول = *مرجع_الظهور;
            طابق الظهور.الرمز مع
            | اختيار.بعض(المعرف) -> {
                لو (معرفا_رمز_متساويان(المعرف, الرمز)) { ألحق(الناتج, الظهور); };
            }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    أرجع الناتج;
}

عام عرف نوع_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختيار معرف_نوع {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    أرجع نوع_رمز_دلالي_عند(&الحالة.أنواع_الرموز, الرمز);
}

عام عرف نوع_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع,
    البايت: غير_موقع
): اختيار معرف_نوع {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    طابق رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
    | اختيار.بعض(الرمز) -> {
        طابق نوع_رمز_دلالي_عند(&الحالة.أنواع_الرموز, الرمز) مع
        | اختيار.بعض(النوع) -> { أرجع اختيار.بعض(النوع); }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الوحدات) مثل غير_موقع)) {
        لو (الحالة.الوحدات[ف].المصدر.المعرف == المصدر) {
            لو (ف >= (الطول(الحالة.أنواع_التعبيرات) مثل غير_موقع)) {
                أرجع اختيار.لا_شيء();
            };
            أرجع نوع_تعبير_عند_بايت(&الحالة.أنواع_التعبيرات[ف], المصدر, البايت);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف استدعاء_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع,
    البايت: غير_موقع
): اختيار استعلام_استدعاء_دلالي {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الوحدات) مثل غير_موقع)) {
        لو (الحالة.الوحدات[ف].المصدر.المعرف == المصدر) {
            لو (ف >= (الطول(الحالة.أنواع_التعبيرات) مثل غير_موقع)) {
                أرجع اختيار.لا_شيء();
            };
            أرجع استدعاء_عند_بايت(&الحالة.أنواع_التعبيرات[ف], المصدر, البايت);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف عدد_معاملات_نوع_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع
): اختيار غير_موقع {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    أرجع عدد_معاملات_دالة_دلالية(&الحالة.الأنواع, النوع);
}

عام عرف نوع_معامل_نوع_واجهة_عند(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    أرجع نوع_معامل_دالة_دلالي_عند(&الحالة.الأنواع, النوع, الفهرس);
}

عام عرف روابط_مرئية_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع,
    البايت: غير_موقع
): متجه ربط_اسم_نطاق {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع الناتج: متغير متجه ربط_اسم_نطاق = [];
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الاستعلامات) -> {
        أرجع روابط_مرئية_عند_استعلام(&الاستعلامات, المصدر, البايت);
    };
}

عام عرف اسم_مقنن_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الاسم: معرف_اسم
): اختيار اسم_مقنن {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الاستعلامات) -> {
        أرجع اسم_مقنن_عند_استعلام(&الاستعلامات, الاسم);
    };
}


عام عرف حضر_إعادة_تسمية_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع,
    البايت: غير_موقع
): نتيجة_تحضير_إعادة_تسمية_دلالية {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختيار.بعض(الاستعلامات) -> {
        طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | اختيار.بعض(الظهور) -> {
            أرجع حضر_إعادة_تسمية_دلالية(&الاستعلامات, &الظهور);
        };
    };
}

عام عرف خطط_إعادة_تسمية_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع,
    البايت: غير_موقع,
    الاسم_الجديد: &نص
): نتيجة_خطة_إعادة_تسمية_دلالية {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختيار.بعض(الاستعلامات) -> {
        طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
        }
        | اختيار.بعض(الظهور) -> {
            طابق حضر_إعادة_تسمية_دلالية(&الاستعلامات, &الظهور) مع
            | نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(السبب) -> {
                أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(السبب);
            }
            | نتيجة_تحضير_إعادة_تسمية_دلالية.جاهز(الهدف) -> {
                أرجع خطط_إعادة_تسمية_دلالية(
                    &الاستعلامات, الهدف, الاسم_الجديد, &الحالة.روابط_الأسماء
                );
            };
        };
    };
}


عام عرف تهجئة_نوع_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النوع: معرف_نوع
): اختيار نص {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الأسماء) -> {
        أرجع تهجئة_عرض_نوع_دلالي(&الحالة.الأنواع, &الأسماء, النوع);
    };
}

عام عرف تهجئة_نوع_واجهة_عند_بايت(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع,
    البايت: غير_موقع
): اختيار نص {
    طابق نوع_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> { أرجع تهجئة_نوع_واجهة(الواجهة, النوع); };
}

// General tooling queries over canonical Name facts retained by a tooling
// Frontend request. They expose classification/enumeration without exposing
// Name storage ownership to protocol consumers.
عام عرف ظهورات_مصنفة_واجهة_لمصدر(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع
): متجه ظهور_مصنف_دلاليا {
    دع الناتج: متغير متجه ظهور_مصنف_دلاليا = [];
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الأسماء) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحالة.الوحدات) مثل غير_موقع)) {
            لو (الحالة.الوحدات[ف].المصدر.المعرف == المصدر) {
                لو (ف < (الطول(الحالة.روابط_الأسماء) مثل غير_موقع)) {
                    أرجع صنف_ظهورات_مصدر_عند_استعلام(
                        &الأسماء, &الحالة.روابط_الأسماء[ف], المصدر
                    );
                };
                أرجع الناتج;
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

عام عرف رموز_واجهة_لمصدر(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: غير_موقع
): متجه رمز_دلالي {
    دع الناتج: متغير متجه رمز_دلالي = [];
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الأسماء) -> { أرجع رموز_مصدر_عند_استعلام(&الأسماء, المصدر); };
}

عام عرف كل_رموز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة
): متجه رمز_دلالي {
    دع الناتج: متغير متجه رمز_دلالي = [];
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الأسماء) -> { أرجع كل_الرموز_عند_استعلام(&الأسماء); };
}

// Tooling-neutral call graph edge composed from Type-owned resolved call facts
// and Name-owned enclosing function declaration facts.
عام نوع حافة_استدعاء_دلالية = {
    المستدعي: معرف_رمز,
    المستدعى: معرف_رمز,
    النطاق: نطاق
};

عام عرف حواف_استدعاء_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة
): متجه حافة_استدعاء_دلالية {
    دع الناتج: متغير متجه حافة_استدعاء_دلالية = [];
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع مرجع_الاستعلامات: &اختيار سياق_استعلامات_أسماء = &الحالة.استعلامات_الأسماء;
    دع الاستعلامات_المحفوظة: اختيار سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق الاستعلامات_المحفوظة مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(الاستعلامات) -> {
        دع و: متغير غير_موقع = 0;
        بينما (و < (الطول(الحالة.أنواع_التعبيرات) مثل غير_موقع)) {
            دع مرجع_السياق: &سياق_أنواع_تعبيرات = &الحالة.أنواع_التعبيرات[و];
            دع سياق_التعبيرات: سياق_أنواع_تعبيرات = *مرجع_السياق;
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(سياق_التعبيرات.الاستدعاءات) مثل غير_موقع)) {
                دع مرجع_الاستدعاء: &حقيقة_استدعاء_نوعية = &سياق_التعبيرات.الاستدعاءات[ف];
                دع الاستدعاء: حقيقة_استدعاء_نوعية = *مرجع_الاستدعاء;
                طابق الاستدعاء.الرمز مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(المستدعى) -> {
                    دع المصدر: غير_موقع = الاستدعاء.النطاق.البداية.المصدر;
                    دع البايت: غير_موقع = الاستدعاء.النطاق.البداية.البايت;
                    طابق رمز_دالة_حاوية_عند_استعلام(&الاستعلامات, المصدر, البايت) مع
                    | اختيار.لا_شيء -> { }
                    | اختيار.بعض(المستدعي) -> {
                        دع الحافة: حافة_استدعاء_دلالية = {
                            المستدعي: المستدعي,
                            المستدعى: المستدعى,
                            النطاق: الاستدعاء.النطاق
                        };
                        ألحق(الناتج, الحافة);
                    };
                };
                ف := ف + 1;
            }
            و := و + 1;
        }
        أرجع الناتج;
    };
}

عام عرف استدعاءات_صادرة_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه حافة_استدعاء_دلالية {
    دع الناتج: متغير متجه حافة_استدعاء_دلالية = [];
    دع الحواف: متجه حافة_استدعاء_دلالية = حواف_استدعاء_واجهة(الواجهة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحواف) مثل غير_موقع)) {
        دع الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        لو (معرفا_رمز_متساويان(الحافة.المستدعي, الرمز)) { ألحق(الناتج, الحافة); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف استدعاءات_واردة_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه حافة_استدعاء_دلالية {
    دع الناتج: متغير متجه حافة_استدعاء_دلالية = [];
    دع الحواف: متجه حافة_استدعاء_دلالية = حواف_استدعاء_واجهة(الواجهة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحواف) مثل غير_موقع)) {
        دع الحافة: حافة_استدعاء_دلالية = الحواف[ف];
        لو (معرفا_رمز_متساويان(الحافة.المستدعى, الرمز)) { ألحق(الناتج, الحافة); };
        ف := ف + 1;
    }
    أرجع الناتج;
}


// Canonical type-hierarchy relations. SultanC currently has no nominal inheritance;
// type-alias declarations are the language's explicit named type relation. The Type
// layer records the direct source relation before alias canonicalization erases it.
عام عرف أنواع_عليا_لرمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه معرف_رمز {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع الناتج: متغير متجه معرف_رمز = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.علاقات_هرم_الأنواع) مثل غير_موقع)) {
        دع العلاقة: علاقة_هرم_نوع = الحالة.علاقات_هرم_الأنواع[ف];
        لو (معرفا_رمز_متساويان(العلاقة.النوع_الفرعي, الرمز)) {
            ألحق(الناتج, العلاقة.النوع_العلوي);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنواع_فرعية_لرمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه معرف_رمز {
    دع الحالة: نتيجة_واجهة_وحدة = *الواجهة;
    دع الناتج: متغير متجه معرف_رمز = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.علاقات_هرم_الأنواع) مثل غير_موقع)) {
        دع العلاقة: علاقة_هرم_نوع = الحالة.علاقات_هرم_الأنواع[ف];
        لو (معرفا_رمز_متساويان(العلاقة.النوع_العلوي, الرمز)) {
            ألحق(الناتج, العلاقة.النوع_الفرعي);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}
