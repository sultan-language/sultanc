عام نوع وحدة_نحوية_محملة = { الوحدة: معرف_وحدة, الشجرة: طبيعي };

// Only source declarations actually loaded under the Driver-resolved standard
// library RootID may provide Linux operation symbols. The operation names and
// tags are source facts; a caller cannot opt into this evidence through an
// import spelling, pathname suffix, or a syscall number.
عام نوع منشئ_نواة_موثق_واجهة = {
    الرمز: معرف_رمز,
    الاسم: نص,
    الترتيب: طبيعي,
    التوقيع: توقيع_نداء_بدائي
};

عام نوع أصل_نواة_موثق_واجهة = {
    المنتقي: معرف_رمز,
    المنشئات: متجه منشئ_نواة_موثق_واجهة
};

// Converts ABI effects only. Does not manufacture operation identity.
عرف حوّل_توقيع_لينكس_إلى_بدائي(المصدر: &توقيع_نداء_نواة_لينكس): اختياري توقيع_نداء_بدائي {
    لو ((الطول((*المصدر).الأدوار) مثل طبيعي) != 6) { أرجع اختياري.لا_شيء(); };
    دع الأدوار: متغير متجه دور_وسيطة_بدائي = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 6) {
        دع الدور: دور_وسيطة_بدائي;
        طابق (*المصدر).الأدوار[الفهرس] مع
        | دور_وسيطة_نواة_لينكس.عدد -> { الدور := دور_وسيطة_بدائي.عدد(); }
        | دور_وسيطة_نواة_لينكس.غير_مستخدم -> { الدور := دور_وسيطة_بدائي.غير_مستخدم(); }
        | دور_وسيطة_نواة_لينكس.مخزن(الاتجاه, الحد) -> {
            دع اتجاه_الناتج: اتجاه_وصول_بدائي;
            طابق الاتجاه مع
            | اتجاه_ذاكرة_نواة_لينكس.قراءة -> { اتجاه_الناتج := اتجاه_وصول_بدائي.قراءة(); }
            | اتجاه_ذاكرة_نواة_لينكس.كتابة -> { اتجاه_الناتج := اتجاه_وصول_بدائي.كتابة(); }
            | اتجاه_ذاكرة_نواة_لينكس.قراءة_وكتابة -> { اتجاه_الناتج := اتجاه_وصول_بدائي.قراءة_وكتابة(); };
            دع حد_الناتج: حد_وصول_بدائي;
            طابق الحد مع
            | حد_ذاكرة_نواة_لينكس.وسيطة(الموضع) -> { حد_الناتج := حد_وصول_بدائي.وسيطة(الموضع); }
            | حد_ذاكرة_نواة_لينكس.ثابت(العدد) -> { حد_الناتج := حد_وصول_بدائي.ثابت(العدد); }
            | حد_ذاكرة_نواة_لينكس.سلسلة_صفرية -> { حد_الناتج := حد_وصول_بدائي.سلسلة_صفرية(); };
            الدور := دور_وسيطة_بدائي.مخزن(اتجاه_الناتج, حد_الناتج);
        };
        ألحق(الأدوار, الدور);
        الفهرس := الفهرس + 1;
    }
    دع النسخ: نسخ_نتيجة_بدائي;
    طابق (*المصدر).النسخ مع
    | أثر_نتيجة_نواة_لينكس.بلا_نسخ -> { النسخ := نسخ_نتيجة_بدائي.بلا_نسخ(); }
    | أثر_نتيجة_نواة_لينكس.عدد_بايتات_النتيجة -> { النسخ := نسخ_نتيجة_بدائي.عدد_بايتات_النتيجة(); }
    | أثر_نتيجة_نواة_لينكس.كامل_عند_النجاح -> { النسخ := نسخ_نتيجة_بدائي.كامل_عند_النجاح(); }
    | أثر_نتيجة_نواة_لينكس.كامل_عند_المقاطعة -> { النسخ := نسخ_نتيجة_بدائي.كامل_عند_المقاطعة(); };
    دع التوقيع: توقيع_نداء_بدائي = { الأدوار: الأدوار, النسخ: النسخ };
    أرجع اختياري.موجود(التوقيع);
}

عرف بايتات_اسم_مقنن_واجهة(المصدر: &مصدر, النطاق: نطاق): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع البداية: طبيعي = النطاق.البداية.البايت;
    دع النهاية: طبيعي = النطاق.النهاية.البايت;
    دع العدد: طبيعي = الطول((*المصدر).المحتوى) مثل طبيعي;
    لو (النهاية > العدد || البداية >= النهاية) { أرجع الناتج; };
    دع موضع: متغير طبيعي = البداية;
    طالما (موضع < النهاية) {
        ألحق(الناتج, (*المصدر).المحتوى[موضع]);
        موضع := موضع + 1;
    }
    أرجع الناتج;
}

عرف هل_مفتاح_وحدة_نواة_واجهة(
    المفتاح: &مفتاح_وحدة_مقنن,
    الجذر: معرف_جذر_مكتبة,
    المسار: &نص
): منطقي {
    لو (!معرفا_جذر_مكتبة_متساويان((*المفتاح).الجذر, الجذر)) {
        أرجع خطأ;
    };
    دع البايتات: متجه ط8 = بايتات_نص_بيانات_وحدة(المسار);
    طابق قنن_مسار_وحدة_منطقي(&البايتات) مع
    | نتيجة_مسار_وحدة_منطقي.صالح(المقنن) -> {
        أرجع مسارا_وحدة_منطقيان_متساويان(&(*المفتاح).المسار, &المقنن);
    }
    | نتيجة_مسار_وحدة_منطقي.غير_صالح -> { أرجع خطأ; };
}

// The functions that never return: إنهيار of the trusted std module
// process/panic.sn (docs/ERRORS.md), identified like the kernel contract
// below by RootID+ModuleKey, never by a spelling a user module can copy.
عرف استخلص_رموز_لا_تعود_واجهة(
    البيئة: &بيئة_وحدات_منطقية,
    المحمل: &محمل_وحدات,
    الوحدات_المحملة: &متجه وحدة_نحوية_محملة,
    الأشجار: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    المصادر: &خريطة_مصادر
): متجه معرف_رمز {
    دع الناتج: متغير متجه معرف_رمز = [];
    دع جذر_المكتبة: معرف_جذر_مكتبة;
    طابق جذر_قياسي_موثوق_لبيئة(البيئة) مع
    | اختياري.موجود(الجذر) -> { جذر_المكتبة := الجذر; }
    | اختياري.لا_شيء -> { أرجع الناتج; };
    دع اسم_الوحدة: نص = «process/panic.sn»;
    دع موضع: متغير طبيعي = 0;
    طالما (موضع < (الطول(*الوحدات_المحملة) مثل طبيعي)) {
        دع ربط_الوحدة: &وحدة_نحوية_محملة = &(*الوحدات_المحملة)[موضع];
        لو ((*ربط_الوحدة).الوحدة.القيمة < (الطول((*المحمل).المحملة) مثل طبيعي)
            && (*ربط_الوحدة).الشجرة < (الطول(*الأشجار) مثل طبيعي)
            && موضع < (الطول(*الروابط) مثل طبيعي)) {
            دع المحملة: &وحدة_مصدر_محملة = &(*المحمل).المحملة[(*ربط_الوحدة).الوحدة.القيمة];
            دع الوحدة: &وحدة_مصدر = &(*الأشجار)[(*ربط_الوحدة).الشجرة];
            لو (هل_مفتاح_وحدة_نواة_واجهة(&(*المحملة).المفتاح, جذر_المكتبة, &اسم_الوحدة)
                && (*المحملة).معرف_المصدر == (*الوحدة).معرف_المصدر) {
                دع المصدر: &مصدر = &(*المصادر).المصادر[(*الوحدة).معرف_المصدر];
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
                    طابق (*الوحدة).العناصر[ف] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        لو (تطابق_هوية_معرف_وشريحة(
                            &(*المصدر).المحتوى, الدالة.الاسم.النطاق.البداية.البايت,
                            الدالة.الاسم.النطاق.النهاية.البايت, «إنهيار»
                        )) {
                            طابق رمز_اسم_محلول_عند(&(*الروابط)[موضع], الدالة.الاسم.النطاق) مع
                            | اختياري.موجود(الرمز) -> { ألحق(الناتج, الرمز); }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                    ف := ف + 1;
                }
            };
        };
        موضع := موضع + 1;
    }
    أرجع الناتج;
}

// The format functions of the trusted std modules fmt/fmt.sn and io/log.sn
// and std.fmt's compile-time checker (docs/FMT.md, "Compile-time check"),
// identified like إنهيار above by RootID+ModuleKey. The first element is the
// checker, تحقق_قالب_تنسيق_وقت_الترجمة; the others are the functions whose
// last two parameters are القالب (the format string) and الوسائط (the
// argument vector). Empty when the checker is not loaded.
عرف استخلص_رموز_تنسيق_واجهة(
    البيئة: &بيئة_وحدات_منطقية,
    المحمل: &محمل_وحدات,
    الوحدات_المحملة: &متجه وحدة_نحوية_محملة,
    الأشجار: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    المصادر: &خريطة_مصادر
): متجه معرف_رمز {
    دع الدوال: متغير متجه معرف_رمز = [];
    دع المدقق: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    دع جذر_المكتبة: معرف_جذر_مكتبة;
    طابق جذر_قياسي_موثوق_لبيئة(البيئة) مع
    | اختياري.موجود(الجذر) -> { جذر_المكتبة := الجذر; }
    | اختياري.لا_شيء -> { أرجع الدوال; };
    دع اسم_التنسيق: نص = «fmt/fmt.sn»;
    دع اسم_السجل: نص = «io/log.sn»;
    دع موضع: متغير طبيعي = 0;
    طالما (موضع < (الطول(*الوحدات_المحملة) مثل طبيعي)) {
        دع ربط_الوحدة: &وحدة_نحوية_محملة = &(*الوحدات_المحملة)[موضع];
        لو ((*ربط_الوحدة).الوحدة.القيمة < (الطول((*المحمل).المحملة) مثل طبيعي)
            && (*ربط_الوحدة).الشجرة < (الطول(*الأشجار) مثل طبيعي)
            && موضع < (الطول(*الروابط) مثل طبيعي)) {
            دع المحملة: &وحدة_مصدر_محملة = &(*المحمل).المحملة[(*ربط_الوحدة).الوحدة.القيمة];
            دع الوحدة: &وحدة_مصدر = &(*الأشجار)[(*ربط_الوحدة).الشجرة];
            دع وحدة_التنسيق: منطقي = هل_مفتاح_وحدة_نواة_واجهة(&(*المحملة).المفتاح, جذر_المكتبة, &اسم_التنسيق);
            دع وحدة_السجل: منطقي = هل_مفتاح_وحدة_نواة_واجهة(&(*المحملة).المفتاح, جذر_المكتبة, &اسم_السجل);
            لو ((وحدة_التنسيق || وحدة_السجل) && (*المحملة).معرف_المصدر == (*الوحدة).معرف_المصدر) {
                دع المصدر: &مصدر = &(*المصادر).المصادر[(*الوحدة).معرف_المصدر];
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
                    طابق (*الوحدة).العناصر[ف] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        دع العدد: طبيعي = الطول(الدالة.المعاملات) مثل طبيعي;
                        دع مختارة: متغير منطقي = خطأ;
                        دع مدقق: متغير منطقي = خطأ;
                        لو (وحدة_التنسيق && تطابق_هوية_معرف_وشريحة(
                            &(*المصدر).المحتوى, الدالة.الاسم.النطاق.البداية.البايت,
                            الدالة.الاسم.النطاق.النهاية.البايت, «تحقق_قالب_تنسيق_وقت_الترجمة»
                        )) {
                            مدقق := صواب;
                        } وإلا لو (العدد >= 2) {
                            دع القالب: &معامل = &الدالة.المعاملات[العدد - 2];
                            دع الوسائط: &معامل = &الدالة.المعاملات[العدد - 1];
                            مختارة := تطابق_هوية_معرف_وشريحة(
                                &(*المصدر).المحتوى, (*القالب).الاسم.النطاق.البداية.البايت,
                                (*القالب).الاسم.النطاق.النهاية.البايت, «القالب»
                            ) && تطابق_هوية_معرف_وشريحة(
                                &(*المصدر).المحتوى, (*الوسائط).الاسم.النطاق.البداية.البايت,
                                (*الوسائط).الاسم.النطاق.النهاية.البايت, «الوسائط»
                            );
                        };
                        لو (مدقق || مختارة) {
                            طابق رمز_اسم_محلول_عند(&(*الروابط)[موضع], الدالة.الاسم.النطاق) مع
                            | اختياري.موجود(الرمز) -> {
                                لو (مدقق) { المدقق := اختياري.موجود(الرمز); } وإلا { ألحق(الدوال, الرمز); };
                            }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                    ف := ف + 1;
                }
            };
        };
        موضع := موضع + 1;
    }
    دع الناتج: متغير متجه معرف_رمز = [];
    طابق المدقق مع
    | اختياري.موجود(الرمز) -> { ألحق(الناتج, الرمز); }
    | اختياري.لا_شيء -> { أرجع الناتج; };
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الدوال) مثل طبيعي)) {
        ألحق(الناتج, الدوال[ر]);
        ر := ر + 1;
    }
    أرجع الناتج;
}

// Name resolution owns SymbolIDs; ModuleLoader owns immutable canonical keys.
// A source tree that merely copies standard-library filenames cannot satisfy
// the RootID+ModuleKey check. Missing/ambiguous symbols fail closed.
عرف استخلص_أصل_نواة_واجهة(
    البيئة: &بيئة_وحدات_منطقية,
    المحمل: &محمل_وحدات,
    الوحدات_المحملة: &متجه وحدة_نحوية_محملة,
    الأشجار: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    المصادر: &خريطة_مصادر
): اختياري أصل_نواة_موثق_واجهة {
    // Root authority originates only in Driver's standard-library registration.
    // No user-supplied spelling, module path suffix or alias is consulted.
    دع جذر_المكتبة: معرف_جذر_مكتبة;
    طابق جذر_قياسي_موثوق_لبيئة(البيئة) مع
    | اختياري.موجود(الجذر) -> {
        لو (!جذر_مكتبة_مسجل(البيئة, الجذر)) { أرجع اختياري.لا_شيء(); };
        جذر_المكتبة := الجذر;
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع اسم_العمليات: نص = «os/platform/unix/linux/syscalls/operations.sn»;
    دع اسم_الانتقاء: نص = «os/platform/unix/linux/syscalls/selection.sn»;
    دع المنتقي: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    دع المنشئات: متغير متجه منشئ_نواة_موثق_واجهة = [];
    دع وجد_العمليات: متغير منطقي = خطأ;
    دع وجد_الانتقاء: متغير منطقي = خطأ;
    دع وجد_تعداد_العمليات: متغير منطقي = خطأ;
    دع وجد_دالة_الانتقاء: متغير منطقي = خطأ;
    دع موضع: متغير طبيعي = 0;
    طالما (موضع < (الطول(*الوحدات_المحملة) مثل طبيعي)) {
        دع ربط_الوحدة: &وحدة_نحوية_محملة = &(*الوحدات_المحملة)[موضع];
        // The loader's ModuleID is a dense direct index into its canonical
        // RootID+ModuleKey table. Source trees and resolved bindings have
        // their own existing aligned indexes; no global key/path scan needed.
        لو ((*ربط_الوحدة).الوحدة.القيمة >= (الطول((*المحمل).المحملة) مثل طبيعي)
            || (*ربط_الوحدة).الشجرة >= (الطول(*الأشجار) مثل طبيعي)
            || موضع >= (الطول(*الروابط) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        دع المحملة: &وحدة_مصدر_محملة = &(*المحمل).المحملة[(*ربط_الوحدة).الوحدة.القيمة];
        دع الوحدة: &وحدة_مصدر = &(*الأشجار)[(*ربط_الوحدة).الشجرة];
        لو ((*المحملة).معرف_المصدر != (*الوحدة).معرف_المصدر) {
            أرجع اختياري.لا_شيء();
        };
        دع المصدر: &مصدر = &(*المصادر).المصادر[(*الوحدة).معرف_المصدر];
        دع المفتاح: &مفتاح_وحدة_مقنن = &(*المحملة).المفتاح;
        دع عمليات: منطقي = هل_مفتاح_وحدة_نواة_واجهة(المفتاح, جذر_المكتبة, &اسم_العمليات);
        دع انتقاء: منطقي = هل_مفتاح_وحدة_نواة_واجهة(المفتاح, جذر_المكتبة, &اسم_الانتقاء);
        لو (عمليات || انتقاء) {
            لو (عمليات) { لو (وجد_العمليات) { أرجع اختياري.لا_شيء(); }; وجد_العمليات := صواب; };
            لو (انتقاء) { لو (وجد_الانتقاء) { أرجع اختياري.لا_شيء(); }; وجد_الانتقاء := صواب; };
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
                طابق (*الوحدة).العناصر[ف] مع
                | عنصر_وحدة.دالة(الدالة) -> {
                    لو (انتقاء && تطابق_هوية_معرف_وشريحة(
                        &(*المصدر).المحتوى, الدالة.الاسم.النطاق.البداية.البايت,
                        الدالة.الاسم.النطاق.النهاية.البايت, «رقم_نداء_نواة_لينكس»
                    )) {
                        لو (وجد_دالة_الانتقاء) { أرجع اختياري.لا_شيء(); };
                        وجد_دالة_الانتقاء := صواب;
                        طابق رمز_اسم_محلول_عند(&(*الروابط)[موضع], الدالة.الاسم.النطاق) مع
                        | اختياري.موجود(الرمز) -> { المنتقي := اختياري.موجود(الرمز); }
                        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
                    };
                }
                | عنصر_وحدة.نوع(التصريح) -> {
                    لو (عمليات && تطابق_هوية_معرف_وشريحة(
                        &(*المصدر).المحتوى, التصريح.الاسم.النطاق.البداية.البايت,
                        التصريح.الاسم.النطاق.النهاية.البايت, «عملية_نداء_نواة_لينكس»
                    )) {
                        لو (وجد_تعداد_العمليات) { أرجع اختياري.لا_شيء(); };
                        وجد_تعداد_العمليات := صواب;
                        طابق التصريح.الشكل مع
                        | شكل_تصريح_نوع.تعداد(الأعضاء) -> {
                            دع م: متغير طبيعي = 0;
                            طالما (م < (الطول(الأعضاء) مثل طبيعي)) {
                                دع الاسم_كبايتات: متجه ط8 = بايتات_اسم_مقنن_واجهة(المصدر, الأعضاء[م].الاسم.النطاق);
                                دع الاسم: نص = من_بايتات(&الاسم_كبايتات);
                                طابق رمز_اسم_محلول_عند(&(*الروابط)[موضع], الأعضاء[م].الاسم.النطاق) مع
                                | اختياري.موجود(الرمز) -> {
                                    // The signature query takes its own text; الاسم stays for the record.
                                    دع اسم_الاستعلام: نص = من_بايتات(&الاسم_كبايتات);
                                    طابق توقيع_عملية_نواة_لينكس(اسم_الاستعلام) مع
                                    | اختياري.موجود(التوقيع) -> {
                                        طابق حوّل_توقيع_لينكس_إلى_بدائي(&التوقيع) مع
                                        | اختياري.موجود(الأثر) -> {
                                            دع المنشئ: منشئ_نواة_موثق_واجهة = { الرمز: الرمز, الاسم: الاسم, الترتيب: م, التوقيع: الأثر };
                                            ألحق(المنشئات, المنشئ);
                                        }
                                        | اختياري.لا_شيء -> { };
                                    }
                                    | اختياري.لا_شيء -> { };

                                }
                                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
                                م := م + 1;
                            }
                        }
                        | _ -> { أرجع اختياري.لا_شيء(); };
                    };
                }
                | _ -> { };
                ف := ف + 1;
            }
        };
        موضع := موضع + 1;
    }
    لو (!وجد_العمليات || !وجد_الانتقاء
        || !وجد_تعداد_العمليات || !وجد_دالة_الانتقاء
        || الطول(المنشئات) == 0) {
        أرجع اختياري.لا_شيء();
    };
    طابق المنتقي مع
    | اختياري.موجود(الرمز) -> {
        دع الأصل: أصل_نواة_موثق_واجهة = { المنتقي: الرمز, المنشئات: المنشئات };
        أرجع اختياري.موجود(الأصل);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// Composition only: each semantic owner keeps its canonical context; this is not a second database.
عام نوع نتيجة_واجهة_وحدة = {
    // Only facts consumed by MSIR lowering survive the Frontend boundary.
    // Module graph, root-tree duplicate, Memory tables, and SSF scratch are
    // validation-phase state and die before MSIR construction begins.
    الوحدات: متجه وحدة_مصدر,
    أصل_نواة_لينكس: اختياري أصل_نواة_موثق_واجهة,
    // Functions that never return (the stop primitive, std.process.panic):
    // lowering ends the caller's path after a call to one.
    رموز_لا_تعود: متجه معرف_رمز,
    // std.fmt's compile-time checker, then the format functions it checks
    // (استخلص_رموز_تنسيق_واجهة); empty without std.fmt.
    رموز_التنسيق: متجه معرف_رمز,
    الوحدات_الدلالية: متجه وحدة_دلالية,
    خريطة_المصادر: خريطة_مصادر,
    هويات_البدائيات: متجه ربط_رمز_بدائي_مترجم,
    روابط_الأسماء: متجه سياق_روابط_أسماء,
    فهرس_التصريحات: فهرس_تصريحات,
    استعلامات_الأسماء: اختياري سياق_استعلامات_أسماء,
    رمز_بدء_البرنامج: اختياري معرف_رمز,
    // Type and Pattern contexts cross the Frontend boundary as their canonical
    // owned aggregates.  They are borrowed during validation and moved here once.
    سياقات_الأنواع: سياقات_أنواع_وحدة,
    سياق_الأنماط: سياق_أنماط_وحدة,
    كاملة_دلاليا: منطقي,
    تشخيصات_الأدوات: مجموعة_تشخيصات,
    // SSF ownership facts (moves and borrowed views) for MSIR drop elaboration.
    حقائق_الملكية: حقائق_ملكية_تدفق,
};

عام نوع خطأ_واجهة_وحدة =
    | تحميل بنوع خطأ_تحميل_وحدة
    | تحميل_استيراد بنوع (خطأ_تحميل_استيرادات, نطاق)
    | معجم بنوع خطأ_معجمي
    | نحو بنوع خطأ_نحوي
    | خلل_نحوي_داخلي
    | أنماط بنوع خطأ_أنماط_وحدة
;

عام نوع نتيجة_بناء_واجهة_وحدة =
    | مكتملة بنوع نتيجة_واجهة_وحدة
    | مرفوضة بنوع مجموعة_تشخيصات
;

عام نوع نتيجة_بناء_واجهة_قابلة_للإلغاء =
    | مكتملة بنوع نتيجة_واجهة_وحدة
    | مرفوضة بنوع مجموعة_تشخيصات
    | ملغاة
;

عرف تشخيصات_فشل_واجهة_عند(
    المعرف: معرف_تشخيص,
    المصدر: اختياري نطاق_مصدر_تشخيص
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع التشخيص: تشخيص = ابدأ_تشخيصا(المعرف, المصدر);
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فشل_واجهة(المعرف: معرف_تشخيص): مجموعة_تشخيصات {
    أرجع تشخيصات_فشل_واجهة_عند(المعرف, اختياري.لا_شيء());
}

عرف تشخيصات_فشل_واجهة_مفصلة(
    المعرف: معرف_تشخيص,
    المصدر: اختياري نطاق_مصدر_تشخيص,
    المرحلة: نص,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, المصدر);
    دع أضف_مرحلة_مفصلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), المرحلة
    );
    دع أضف_سبب_مفصل: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب
    );
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فشل_واجهة_مفصلة_مشتقة(
    المعرف: معرف_تشخيص,
    المصدر: اختياري نطاق_مصدر_تشخيص,
    الاعتماد: نطاق_مصدر_تشخيص,
    المرحلة: نص,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, المصدر);
    دع أضف_مرحلة_مفصلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), المرحلة);
    دع أضف_سبب_مفصل: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    دع أضف_الاعتماد: منطقي = أضف_اعتماد_تشخيص(&متغير التشخيص, الاعتماد);
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف أضف_اعتماد_تشخيص_من_نطاق_محمل(
    التشخيص: &متغير تشخيص,
    المحمل: &خريطة_مصادر,
    النطاق: نطاق
): فراغ {
    طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق) مع
    | اختياري.موجود(الاعتماد) -> {
        دع أضف_الاعتماد: منطقي = أضف_اعتماد_تشخيص(التشخيص, الاعتماد);
    }
    | اختياري.لا_شيء -> { };
}

عرف سبب_فئة_خطأ_معجمي(الفئة: فئة_خطأ_معجمي): سبب_تشخيص {
    طابق الفئة مع
    | فئة_خطأ_معجمي.بناء -> { أرجع سبب_تشخيص.سبب_محلل_معجمي_إنشاء(); }
    | فئة_خطأ_معجمي.يوتيف8 -> { أرجع سبب_تشخيص.سبب_محلل_معجمي_يوتيف8(); }
    | فئة_خطأ_معجمي.داخلي -> { أرجع سبب_تشخيص.سبب_محلل_معجمي_داخلي(); };
}

عرف معرف_تشخيص_فئة_خطأ_معجمي(الفئة: فئة_خطأ_معجمي): معرف_تشخيص {
    طابق الفئة مع
    | فئة_خطأ_معجمي.بناء -> { أرجع معرف_تشخيص.خطأ_معجمي(); }
    | فئة_خطأ_معجمي.يوتيف8 -> { أرجع معرف_تشخيص.نص_مصدر_يوتيف8_غير_صالح(); }
    | فئة_خطأ_معجمي.داخلي -> { أرجع معرف_تشخيص.خلل_معجمي_داخلي(); };
}

عرف معرف_تشخيص_فئة_خطأ_نحوي(الفئة: فئة_خطأ_نحوي): معرف_تشخيص {
    طابق الفئة مع
    | فئة_خطأ_نحوي.متوقع -> { أرجع معرف_تشخيص.خطأ_نحوي(); }
    | فئة_خطأ_نحوي.فاصلة_منقوطة_في_غير_موضعها -> { أرجع معرف_تشخيص.فاصلة_منقوطة_في_غير_موضعها(); }
    | فئة_خطأ_نحوي.تهجئة_كلمة_محجوزة_محتملة -> { أرجع معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة(); }
    | فئة_خطأ_نحوي.عبارة_بلا_عملية -> { أرجع معرف_تشخيص.عبارة_بلا_عملية(); }
    | فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود -> { أرجع معرف_تشخيص.نوع_ناتج_دالة_مفقود(); }
    | فئة_خطأ_نحوي.تعبير -> { أرجع معرف_تشخيص.تعبير_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.نوع -> { أرجع معرف_تشخيص.نوع_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.نمط -> { أرجع معرف_تشخيص.نمط_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.عنصر -> { أرجع معرف_تشخيص.عنصر_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.شرط_هدف_غير_صالح -> { أرجع معرف_تشخيص.عنصر_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.شرط_هدف_بلا_هدف -> { أرجع معرف_تشخيص.عنصر_نحوي_غير_صالح(); }
    | فئة_خطأ_نحوي.داخلي -> { أرجع معرف_تشخيص.خلل_محلل_داخلي(); };
}

عرف سبب_فئة_خطأ_نحوي(الفئة: فئة_خطأ_نحوي): سبب_تشخيص {
    طابق الفئة مع
    | فئة_خطأ_نحوي.متوقع -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_متوقع_رمز_معجمي(); }
    | فئة_خطأ_نحوي.فاصلة_منقوطة_في_غير_موضعها -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_في_موضع_خاطئ_فاصلة_منقوطة(); }
    | فئة_خطأ_نحوي.تهجئة_كلمة_محجوزة_محتملة -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_كلمة_محجوزة_خطأ_إملائي(); }
    | فئة_خطأ_نحوي.عبارة_بلا_عملية -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_عبارة_بلا_عملية(); }
    | فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_مفقود_دالة_إرجاع_نوع(); }
    | فئة_خطأ_نحوي.تعبير -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_تعبير(); }
    | فئة_خطأ_نحوي.نوع -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_نوع(); }
    | فئة_خطأ_نحوي.نمط -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_نمط(); }
    | فئة_خطأ_نحوي.عنصر -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_عنصر(); }
    | فئة_خطأ_نحوي.شرط_هدف_غير_صالح -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_هدف_شرط_غير_صحيح(); }
    | فئة_خطأ_نحوي.شرط_هدف_بلا_هدف -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_هدف_شرط_بلا_هدف(); }
    | فئة_خطأ_نحوي.داخلي -> { أرجع سبب_تشخيص.سبب_محلل_نحوي_داخلي(); };
}

عرف سبب_خطأ_تحميل_وحدة(الخطأ: خطأ_تحميل_وحدة): سبب_تشخيص {
    طابق الخطأ مع
    | خطأ_تحميل_وحدة.مصدر_غير_موجود -> { أرجع سبب_تشخيص.سبب_وحدة_مصدر_ليس_موجود(); }
    | خطأ_تحميل_وحدة.مصدر_غير_مقروء -> { أرجع سبب_تشخيص.سبب_وحدة_مصدر_غير_مقروء(); }
    | خطأ_تحميل_وحدة.مرجع_غير_صالح -> { أرجع سبب_تشخيص.سبب_وحدة_غير_صحيح_استيراد_مرجع(); }
    | خطأ_تحميل_وحدة.جذر_غير_معلن -> { أرجع سبب_تشخيص.سبب_وحدة_مكتبة_جذر_غير_مسجل(); }
    | خطأ_تحميل_وحدة.هروب_من_الجذر -> { أرجع سبب_تشخيص.سبب_وحدة_استيراد_يتجاوز_جذر(); }
    | خطأ_تحميل_وحدة.مسار_منطقي_غير_صالح -> { أرجع سبب_تشخيص.سبب_وحدة_غير_صحيح_منطقي_مسار(); }
    | خطأ_تحميل_وحدة.تعارض_مسار_عام -> { أرجع سبب_تشخيص.سبب_وحدة_عام_مسار_تعارض(); }
    | خطأ_تحميل_وحدة.مصدر_وحدة_متعارض -> { أرجع سبب_تشخيص.سبب_وحدة_مصدر_تعارض(); }
    | خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة -> { أرجع سبب_تشخيص.سبب_وحدة_استيراد_ليس_محمل(); }
    | خطأ_تحميل_وحدة.دورة_استيراد -> { أرجع سبب_تشخيص.سبب_وحدة_استيراد_دورة(); }
    | خطأ_تحميل_وحدة.رسم_وحدات_مرفوض -> { أرجع سبب_تشخيص.سبب_وحدة_رسم_بياني_مرفوض(); }
    | خطأ_تحميل_وحدة.تصدير_انتقائي_مفقود -> { أرجع سبب_تشخيص.سبب_وحدة_انتقائي_تصدير_ليس_موجود(); };
}

عرف معرف_تشخيص_خطأ_تحميل_وحدة(الخطأ: خطأ_تحميل_وحدة): معرف_تشخيص {
    طابق الخطأ مع
    | خطأ_تحميل_وحدة.مصدر_غير_موجود -> { أرجع معرف_تشخيص.وحدة_مصدر_غير_موجودة(); }
    | خطأ_تحميل_وحدة.مصدر_غير_مقروء -> { أرجع معرف_تشخيص.وحدة_مصدر_غير_مقروءة(); }
    | خطأ_تحميل_وحدة.مرجع_غير_صالح -> { أرجع معرف_تشخيص.مرجع_استيراد_غير_صالح(); }
    | خطأ_تحميل_وحدة.جذر_غير_معلن -> { أرجع معرف_تشخيص.جذر_مكتبة_غير_مسجل(); }
    | خطأ_تحميل_وحدة.هروب_من_الجذر -> { أرجع معرف_تشخيص.استيراد_يهرب_من_الجذر(); }
    | خطأ_تحميل_وحدة.مسار_منطقي_غير_صالح -> { أرجع معرف_تشخيص.مسار_وحدة_منطقي_غير_صالح(); }
    | خطأ_تحميل_وحدة.تعارض_مسار_عام -> { أرجع معرف_تشخيص.تعارض_مسار_وحدة_عام(); }
    | خطأ_تحميل_وحدة.مصدر_وحدة_متعارض -> { أرجع معرف_تشخيص.تعارض_مصدر_وحدة(); }
    | خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة -> { أرجع معرف_تشخيص.وحدة_مستوردة_غير_محملة(); }
    | خطأ_تحميل_وحدة.دورة_استيراد -> { أرجع معرف_تشخيص.دورة_استيراد(); }
    | خطأ_تحميل_وحدة.رسم_وحدات_مرفوض -> { أرجع معرف_تشخيص.رسم_وحدات_مرفوض(); }
    | خطأ_تحميل_وحدة.تصدير_انتقائي_مفقود -> { أرجع معرف_تشخيص.تصدير_انتقائي_غير_موجود(); };
}

عرف تشخيصات_خطأ_تحميل_وحدة_مفصلة(
    الخطأ: خطأ_تحميل_وحدة,
    فهرس_الاستيراد: اختياري طبيعي,
    المصدر: اختياري نطاق_مصدر_تشخيص
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_خطأ_تحميل_وحدة(الخطأ), المصدر
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «module-loading»
    );
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_خطأ_تحميل_وحدة(الخطأ)
    );
    طابق فهرس_الاستيراد مع
    | اختياري.موجود(الفهرس) -> {
        دع أضف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
    }
    | اختياري.لا_شيء -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_خلل_نحوي_داخلي(): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.لا_ناتج_تحليل(), اختياري.لا_شيء()
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_داخلي_بلا_نتيجة()
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عام عرف مصدر_تشخيص_من_نطاق_محمل(
    المحمل: &خريطة_مصادر,
    النطاق_المعطى: نطاق
): اختياري نطاق_مصدر_تشخيص {
    دع النطاق: نطاق = نطاق_الإبلاغ(المحمل, النطاق_المعطى);
    دع المقتطف: اختياري نص = مقتطف_مصدر_محمل_لنطاق(المحمل, &النطاق);
    طابق مصدر_محمل_بالمعرف(المحمل, النطاق.البداية.المصدر) مع
    | اختياري.موجود(المصدر) -> {
        دع الوصف: نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_من_مصدر(
            النطاق, &المصدر, المقتطف
        );
        أرجع اختياري.موجود(الوصف);
    }
    | اختياري.لا_شيء -> {
        دع الاسم: اختياري نص = اسم_مصدر_محمل_بالمعرف(
            المحمل, النطاق.البداية.المصدر
        );
        دع الوصف: نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_بأصل(
            النطاق, الاسم, المقتطف
        );
        أرجع اختياري.موجود(الوصف);
    };
}

// Unknown-name diagnostics carry the name as written, so the message can say
// which name was not found.
عرف تشخيصات_اسم_غير_معروف(
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.اسم_غير_معروف(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
    );
    دع أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»);
    دع أضف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    طابق مصدر_محمل_بالمعرف(المحمل, النطاق.البداية.المصدر) مع
    | اختياري.موجود(المصدر) -> {
        دع البايتات: متجه ط8 = بايتات_اسم_مقنن_واجهة(&المصدر, النطاق);
        لو ((الطول(البايتات) مثل طبيعي) > 0) {
            دع أضف_الاسم: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), من_بايتات(&البايتات)
            );
        };
    }
    | اختياري.لا_شيء -> { };
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// A name that exists but is private to its module: SULTANC-NAME-PRIVATE
// (was reported as an unknown name). The name is the private declaration.
عرف تشخيصات_تصريح_خاص(
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.تصريح_خاص_غير_متاح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
    );
    دع أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»);
    دع البايتات: متجه ط8 = بايتات_نطاق_محمل(المحمل, النطاق);
    لو ((الطول(البايتات) مثل طبيعي) > 0) {
        دع أضف_الاسم: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), من_بايتات(&البايتات)
        );
    };
    دع أضف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص, مفتاح_صياغة.مساعدة_اجعل_التصريح_عاما(), بلا_حجج
    );
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// The type-table invariant an internal type error names.
عرف سبب_ثابت_أنواع_مكسور(الثابت: ثابت_أنواع_مكسور): سبب_تشخيص {
    طابق الثابت مع
    | ثابت_أنواع_مكسور.تسجيل_نوع_تعبير -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_تسجيل_نوع_تعبير(); }
    | ثابت_أنواع_مكسور.تسجيل_نوع_منشئ -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_تسجيل_نوع_منشئ(); }
    | ثابت_أنواع_مكسور.نوع_حمولة_منشئ -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_نوع_حمولة_منشئ(); }
    | ثابت_أنواع_مكسور.نوع_عنصر_صف -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_نوع_عنصر_صف(); }
    | ثابت_أنواع_مكسور.حجة_بلا_نوع -> { أرجع سبب_تشخيص.سبب_نوع_ثابت_حجة_بلا_نوع(); };
}

// The name of an unknown-name span, as written.
عرف بايتات_نطاق_محمل(المحمل: &خريطة_مصادر, النطاق: نطاق): متجه ط8 {
    طابق مصدر_محمل_بالمعرف(المحمل, النطاق.البداية.المصدر) مع
    | اختياري.موجود(المصدر) -> { أرجع بايتات_اسم_مقنن_واجهة(&المصدر, النطاق); }
    | اختياري.لا_شيء -> {
        دع بلا_بايتات: متجه ط8 = [];
        أرجع بلا_بايتات;
    };
}

عرف بايتات_متساوية_واجهة(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    لو (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// A loaded module's declaration of this name that a false target condition
// left out.
عرف تصريح_لهدف_آخر_باسم(
    المحمل: &خريطة_مصادر,
    الأشجار: &متجه وحدة_مصدر,
    النطاق: نطاق
): اختياري نطاق {
    دع الاسم: متجه ط8 = بايتات_نطاق_محمل(المحمل, النطاق);
    لو ((الطول(الاسم) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع ش: متغير طبيعي = 0;
    طالما (ش < (الطول(*الأشجار) مثل طبيعي)) {
        دع المستبعدة: &متجه نطاق = &(*الأشجار)[ش].المستبعدة_للهدف;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*المستبعدة) مثل طبيعي)) {
            دع المرشح: متجه ط8 = بايتات_نطاق_محمل(المحمل, (*المستبعدة)[ف]);
            لو (بايتات_متساوية_واجهة(&المرشح, &الاسم)) { أرجع اختياري.موجود((*المستبعدة)[ف]); };
            ف := ف + 1;
        }
        ش := ش + 1;
    }
    أرجع اختياري.لا_شيء();
}

// An unknown name that the loaded modules declare only for other targets is
// a target limit (SULTANC-TARGET-FEATURE-UNSUPPORTED), not a typo.
عرف تشخيصات_اسم_مفقود_أو_لهدف_آخر(
    المحمل: &خريطة_مصادر,
    الأشجار: &متجه وحدة_مصدر,
    الهدف: &اختياري واصف_هدف,
    النطاق: نطاق,
    السبب: سبب_تشخيص
): مجموعة_تشخيصات {
    طابق *الهدف مع
    | اختياري.موجود(واصف) -> {
        طابق تصريح_لهدف_آخر_باسم(المحمل, الأشجار, النطاق) مع
        | اختياري.موجود(نطاق_التصريح) -> {
            دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
                معرف_تشخيص.هدف_لا_يدعم_الميزة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
            );
            دع أضف_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «name»);
            دع أضف_السبب: منطقي = أضف_سبب_تشخيص(
                &متغير التشخيص, سبب_تشخيص.سبب_هدف_تصريح_لأهداف_أخرى()
            );
            أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, النطاق, مفتاح_حجة_تشخيص.الرمز());
            دع أضف_الهدف: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), تهجئة_هدف_مسجل(&واصف)
            );
            طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_التصريح) مع
            | اختياري.موجود(مصدر_التصريح) -> {
                دع أضف_التصريح: منطقي = أضف_نطاقا_مرتبطا(
                    &متغير التشخيص, مصدر_التصريح, دور_نطاق_تشخيص.سياق_مرتبط()
                );
            }
            | اختياري.لا_شيء -> { };
            أرجع مجموعة_تشخيص_واحد(&التشخيص);
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع تشخيصات_اسم_غير_معروف(المحمل, النطاق, السبب);
}

عرف تشخيصات_خطأ_معجمي_مفصلة(
    الخطأ: خطأ_معجمي,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_فئة_خطأ_معجمي(الخطأ.الفئة),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق)
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «lexer»
    );
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_فئة_خطأ_معجمي(الخطأ.الفئة)
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فاصلة_منقوطة_في_غير_موضعها(
    نطاق_الإدراج: نطاق,
    نطاق_الفاصلة: نطاق,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.فاصلة_منقوطة_في_غير_موضعها(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الفاصلة)
    );
    ضع_دور_النطاق_الرئيسي(
        &متغير التشخيص, دور_نطاق_تشخيص.فاصلة_منقوطة_في_غير_موضعها()
    );
    طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج) مع
    | اختياري.موجود(المصدر) -> {
        دع أضف_مرتبطا: منطقي = أضف_نطاقا_مرتبطا(
            &متغير التشخيص, المصدر, دور_نطاق_تشخيص.وجهة_فاصلة_منقوطة()
        );
    }
    | اختياري.لا_شيء -> { };
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_في_موضع_خاطئ_فاصلة_منقوطة()
    );
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص, مفتاح_صياغة.مساعدة_انقل_فاصلة_منقوطة(), بلا_حجج
    );
    طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج) مع
    | اختياري.موجود(مصدر_الإدراج) -> {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الفاصلة) مع
        | اختياري.موجود(مصدر_الحذف) -> {
            دع أضف_الإصلاح: منطقي = أضف_إصلاحا_مركبا_من_تعديلين(
                &متغير التشخيص,
                مصدر_الإدراج,
                «;»,
                مصدر_الحذف,
                «»,
                قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_انقل_فاصلة_منقوطة()
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_تهجئة_كلمة_محجوزة_محتملة(
    الخطأ: خطأ_نحوي,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    دع المصدر: اختياري نطاق_مصدر_تشخيص =
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق);
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة(), المصدر
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_كلمة_محجوزة_خطأ_إملائي()
    );
    دع المتوقع_الإنجليزي: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
    دع المتوقع_العربي: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
    دع أضف_المتوقع: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.المتوقع(),
        المتوقع_الإنجليزي,
        المتوقع_العربي
    );
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة(),
        بلا_حجج
    );
    طابق الخطأ.التهجئة_المقترحة مع
    | تهجئة_كلمة_مقترحة.عربية -> {
        دع استبدال_الحجة: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
        دع أضف_الاستبدال: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الاستبدال(), استبدال_الحجة
        );
        // A copy: the fix is added to التشخيص while its source is read.
        طابق انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(&التشخيص.المصدر_الرئيسي) مع
        | اختياري.موجود(مصدر_الإصلاح) -> {
            دع استبدال_الإصلاح: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
            دع أضف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص,
                مصدر_الإصلاح,
                استبدال_الإصلاح,
                قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة()
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | تهجئة_كلمة_مقترحة.إنجليزية -> {
        دع استبدال_الحجة: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
        دع أضف_الاستبدال: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الاستبدال(), استبدال_الحجة
        );
        // A copy: the fix is added to التشخيص while its source is read.
        طابق انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(&التشخيص.المصدر_الرئيسي) مع
        | اختياري.موجود(مصدر_الإصلاح) -> {
            دع استبدال_الإصلاح: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
            دع أضف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص,
                مصدر_الإصلاح,
                استبدال_الإصلاح,
                قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة()
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | تهجئة_كلمة_مقترحة.بلا_اقتراح -> { };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_عبارة_بلا_عملية(
    الخطأ: خطأ_نحوي,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.عبارة_بلا_عملية(),
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق)
    );
    ضع_دور_النطاق_الرئيسي(
        &متغير التشخيص, دور_نطاق_تشخيص.عبارة_بلا_عملية()
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_عبارة_بلا_عملية()
    );
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_المساعدة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_أكمل_العبارة_باستدعاء_أو_إسناد(),
        بلا_حجج
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_خطأ_نحوي_مفصلة(
    الخطأ: خطأ_نحوي,
    المحمل: &خريطة_مصادر
): مجموعة_تشخيصات {
    لو (الخطأ.الفئة == فئة_خطأ_نحوي.تهجئة_كلمة_محجوزة_محتملة()) {
        أرجع تشخيصات_تهجئة_كلمة_محجوزة_محتملة(الخطأ, المحمل);
    };
    لو (الخطأ.الفئة == فئة_خطأ_نحوي.عبارة_بلا_عملية()) {
        أرجع تشخيصات_عبارة_بلا_عملية(الخطأ, المحمل);
    };
    لو (الخطأ.الفئة == فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود()) {
        دع المصدر_الرئيسي: متغير اختياري نطاق_مصدر_تشخيص =
            مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق);
        دع الدور_الرئيسي: متغير دور_نطاق_تشخيص = دور_نطاق_تشخيص.اكتشاف_المحلل();
        طابق الخطأ.نطاق_الإدراج مع
        | اختياري.موجود(نطاق_الإدراج) -> {
            المصدر_الرئيسي := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج);
            الدور_الرئيسي := دور_نطاق_تشخيص.موضع_متوقع();
        }
        | اختياري.لا_شيء -> { };
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_ناتج_دالة_مفقود(), المصدر_الرئيسي
        );
        ضع_دور_النطاق_الرئيسي(&متغير التشخيص, الدور_الرئيسي);
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق) مع
        | اختياري.موجود(المصدر) -> {
            دع أضف_مرتبطا: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر, دور_نطاق_تشخيص.اكتشاف_المحلل()
            );
        }
        | اختياري.لا_شيء -> { };
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
        );
        دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_محلل_نحوي_مفقود_دالة_إرجاع_نوع()
        );
        دع بلا_حجج: متجه حجة_تشخيص = [];
        دع أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_أضف_نوع_ناتج_دالة(), بلا_حجج
        );
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    };
    لو (الخطأ.الفئة == فئة_خطأ_نحوي.فاصلة_منقوطة_في_غير_موضعها()) {
        طابق الخطأ.نطاق_الإدراج مع
        | اختياري.موجود(نطاق_الإدراج) -> {
            طابق الخطأ.نطاق_الفاصلة_المنقوطة_في_غير_موضعها مع
            | اختياري.موجود(نطاق_الفاصلة) -> {
                أرجع تشخيصات_فاصلة_منقوطة_في_غير_موضعها(
                    نطاق_الإدراج, نطاق_الفاصلة, المحمل
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    };
    دع المصدر_الرئيسي: متغير اختياري نطاق_مصدر_تشخيص =
        مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق);
    دع الدور_الرئيسي: متغير دور_نطاق_تشخيص = دور_نطاق_تشخيص.اكتشاف_المحلل();
    دع أضف_اكتشافا_مرتبطا: متغير منطقي = خطأ;
    لو (الخطأ.المتوقع == رمز.فاصلة_منقوطة()) {
        طابق الخطأ.نطاق_الإدراج مع
        | اختياري.موجود(نطاق_الإدراج) -> {
            المصدر_الرئيسي := مصدر_تشخيص_من_نطاق_محمل(المحمل, نطاق_الإدراج);
            الدور_الرئيسي := دور_نطاق_تشخيص.موضع_متوقع();
            أضف_اكتشافا_مرتبطا := صواب;
        }
        | اختياري.لا_شيء -> { };
    };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص_فئة_خطأ_نحوي(الخطأ.الفئة), المصدر_الرئيسي
    );
    ضع_دور_النطاق_الرئيسي(&متغير التشخيص, الدور_الرئيسي);
    لو (أضف_اكتشافا_مرتبطا) {
        طابق مصدر_تشخيص_من_نطاق_محمل(المحمل, الخطأ.النطاق) مع
        | اختياري.موجود(المصدر) -> {
            دع أضف_مرتبطا: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, المصدر, دور_نطاق_تشخيص.اكتشاف_المحلل()
            );
        }
        | اختياري.لا_شيء -> { };
    };
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «parser»
    );
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_فئة_خطأ_نحوي(الخطأ.الفئة)
    );
    دع المتوقع_الإنجليزي: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.المتوقع);
    دع المتوقع_العربي: نص = تهجئة_عرض_رمز_عربية(الخطأ.المتوقع);
    دع الموجود_الإنجليزي: نص = تهجئة_عرض_رمز_إنجليزية(الخطأ.الموجود);
    دع الموجود_العربي: نص = تهجئة_عرض_رمز_عربية(الخطأ.الموجود);
    دع أضف_المتوقع: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع_الإنجليزي, المتوقع_العربي
    );
    دع أضف_الموجود: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود_الإنجليزي, الموجود_العربي
    );
    لو (الخطأ.المتوقع == رمز.فاصلة_منقوطة()) {
        دع بلا_حجج: متجه حجة_تشخيص = [];
        دع أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_أضف_فاصلة_منقوطة(), بلا_حجج
        );
        // A copy: the fix is added to التشخيص while its source is read.
        طابق انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(&التشخيص.المصدر_الرئيسي) مع
        | اختياري.موجود(المصدر) -> {
            دع أضف_الإصلاح: منطقي = أضف_إصلاحا(
                &متغير التشخيص, المصدر, «;», قابلية_تطبيق_إصلاح.آلي(),
                مفتاح_صياغة.مساعدة_أضف_فاصلة_منقوطة()
            );
        }
        | اختياري.لا_شيء -> { };
    };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف نوع_بلا_غلاف_متغير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): معرف_نوع {
    طابق أزل_غلاف_متغير(الأنواع, النوع) مع
    | اختياري.موجود(الأساس) -> { أرجع الأساس; }
    | اختياري.لا_شيء -> { أرجع النوع; };
}

// A type-phase diagnostic with its typed reason.
عرف ابدأ_تشخيص_نوعي(
    المعرف: معرف_تشخيص,
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    السبب: سبب_تشخيص
): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        المعرف, مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
    );
    دع أضف_المرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»
    );
    دع أضف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    أرجع التشخيص;
}

عرف مجموعة_تشخيص_واحد(التشخيص: &تشخيص): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, التشخيص);
    أرجع المجموعة;
}

// The source text of a span (a name as written) as a text argument.
عرف أضف_نص_نطاق_تشخيص(
    التشخيص: &متغير تشخيص,
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    المفتاح: مفتاح_حجة_تشخيص
): فراغ {
    طابق مصدر_محمل_بالمعرف(المحمل, النطاق.البداية.المصدر) مع
    | اختياري.موجود(المصدر) -> {
        دع البايتات: متجه ط8 = بايتات_اسم_مقنن_واجهة(&المصدر, النطاق);
        لو ((الطول(البايتات) مثل طبيعي) > 0) {
            دع أضف_النص: منطقي = أضف_حجة_تشخيص(التشخيص, المفتاح, من_بايتات(&البايتات));
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف سبب_سياق_عدم_توافق_نوع(السياق: سياق_عدم_توافق_نوع): سبب_تشخيص {
    طابق السياق مع
    | سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان -> { أرجع سبب_تشخيص.سبب_نوع_طرفا_عامل_مختلفان(); }
    | سياق_عدم_توافق_نوع.عامل_يتطلب_منطقيا -> { أرجع سبب_تشخيص.سبب_نوع_عامل_يتطلب_منطقيا(); }
    | سياق_عدم_توافق_نوع.عامل_يتطلب_عددا -> { أرجع سبب_تشخيص.سبب_نوع_عامل_يتطلب_عددا(); }
    | سياق_عدم_توافق_نوع.عامل_يتطلب_عددا_صحيحا -> { أرجع سبب_تشخيص.سبب_نوع_عامل_يتطلب_عددا_صحيحا(); }
    | سياق_عدم_توافق_نوع.شرط_غير_منطقي -> { أرجع سبب_تشخيص.سبب_نوع_شرط_غير_منطقي(); }
    | سياق_عدم_توافق_نوع.قيمة_لا_تطابق_الوجهة -> { أرجع سبب_تشخيص.سبب_نوع_قيمة_لا_تطابق_الوجهة(); }
    | سياق_عدم_توافق_نوع.فهرس_ليس_عددا_صحيحا -> { أرجع سبب_تشخيص.سبب_نوع_فهرس_ليس_عددا_صحيحا(); }
    | سياق_عدم_توافق_نوع.نوع_غير_قابل_للفهرسة -> { أرجع سبب_تشخيص.سبب_نوع_غير_قابل_للفهرسة(); }
    | سياق_عدم_توافق_نوع.فهرس_صف_غير_ثابت -> { أرجع سبب_تشخيص.سبب_نوع_فهرس_صف_غير_ثابت(); }
    | سياق_عدم_توافق_نوع.عدد_عناصر_صف -> { أرجع سبب_تشخيص.سبب_نوع_صف_عدد_عناصر_غير_مطابق(); }
    | سياق_عدم_توافق_نوع.فارغ_بلا_مؤشر -> { أرجع سبب_تشخيص.سبب_نوع_فارغ_يتطلب_مؤشرا(); }
    | سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة -> { أرجع سبب_تشخيص.سبب_نوع_حرفي_لا_يناسب_الوجهة(); }
    | سياق_عدم_توافق_نوع.عدد_حرفي_خارج_المدى -> { أرجع سبب_تشخيص.سبب_نوع_عدد_حرفي_خارج_المدى(); }
    | سياق_عدم_توافق_نوع.تحويل_غير_صالح -> { أرجع سبب_تشخيص.سبب_نوع_تحويل_غير_صالح(); }
    | سياق_عدم_توافق_نوع.سالب_عدد_طبيعي -> { أرجع سبب_تشخيص.سبب_نوع_سالب_عدد_طبيعي(); };
}

عرف تشخيصات_خطأ_أنواع(
    الخطأ: خطأ_بناء_سياقات_أنواع,
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع,
    سياق_الأسماء: &سياق_أسماء
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.اسم_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_مفقود_اسم_ربط_اسم()
        );
    }
    | خطأ_بناء_سياقات_أنواع.هوية_اسم_مفقودة(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.اسم_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_مفقود_اسم_هوية()
        );
    }
    | خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نوع_غير_محلول(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_غير_محلول_نوع()
        );
    }
    | خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.تعريف_نوع_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_غير_صحيح_نوع_تعريف()
        );
    }
    | خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(النطاق, الثابت) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.تعبير_نوعي_غير_مدعوم(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_ثابت_أنواع_مكسور(الثابت)
        );
    }
    | خطأ_بناء_سياقات_أنواع.سمة_تصريح_غير_مدعومة(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.سمة_تصريح_غير_مدعومة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_سمة_معالجة_غير_منفذة()
        );
    }
    | خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف(النطاق) -> {
        // The span is the field name as written.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_نوعي(
            معرف_تشخيص.حقل_سجل_غير_معروف(), المحمل, النطاق,
            سبب_تشخيص.سبب_نوع_مجهول_سجل_حقل()
        );
        أضف_نص_نطاق_تشخيص(&متغير التشخيص, المحمل, النطاق, مفتاح_حجة_تشخيص.الرمز());
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.عدد_حمولات_نمط_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عدد_حمولات_نمط_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضيف_المتوقع: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع);
        دع أضيف_الموجود: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نمط_غير_صالح(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_مفصلة(
            معرف_تشخيص.نمط_غير_صالح(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق),
            «type», سبب_تشخيص.سبب_نوع_غير_صحيح_نمط()
        );
    }
    | خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(الرمز, النطاق) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.حقيقة_دلالية_مفقودة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_1: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_1: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_مفقود_رمز_نوع()

        );
        دع أضف_الرمز: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة
        );
        أضف_اعتماد_تشخيص_من_نطاق_محمل(&متغير التشخيص, المحمل, النطاق);
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عدد_حجج_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_2: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_2: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_استدعاء_حجة_عدد_عدم_تطابق()

        );
        دع أضيف_المتوقع: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع
        );
        دع أضيف_الموجود: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(النطاق, الفهرس, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_حجة_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_3: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_3: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_استدعاء_حجة_نوع_عدم_تطابق()

        );
        دع أضيف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        دع أضيف_المتوقع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, المتوقع
        );
        دع أضيف_الموجود: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_إرجاع_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_إرجاع_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_4: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_4: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_إرجاع_نوع_عدم_تطابق()

        );
        دع أضيف_المتوقع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, المتوقع
        );
        دع أضيف_الموجود: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.عدد_حجج_بدائية_غير_مطابق(النطاق, البدائي, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عدد_حجج_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_5: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_5: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_بدائي_حجة_عدد_عدم_تطابق()

        );
        دع أضف_البدائي: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)
        );
        دع أضف_المتوقع: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع
        );
        دع أضف_الموجود: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_مطابق(النطاق, البدائي, الفهرس, المتوقع, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_حجة_غير_مطابق(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_6: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_6: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_بدائي_حجة_نوع_عدم_تطابق()

        );
        دع أضف_البدائي: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)
        );
        دع أضف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        دع أضف_المتوقع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, المتوقع
        );
        دع أضف_الموجود: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(النطاق, البدائي, الفهرس, الموجود) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوعان_غير_متوافقين(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_7: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_7: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_غير_صحيح_بدائي_حجة_نوع()

        );
        دع أضف_البدائي: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)
        );
        دع أضف_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس
        );
        دع أضف_الموجود: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, الموجود
        );
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.دلالة_بدائي_غير_متاحة(النطاق, البدائي) -> {
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.حقيقة_دلالية_مفقودة(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
        دع أضف_مرحلة_8: منطقي = أضف_حجة_تشخيص(

            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»

        );

        دع أضف_سبب_8: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_نوع_بدائي_دلالات_غير_متاح()

        );
        دع أضف_البدائي: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)
        );
        أضف_اعتماد_تشخيص_من_نطاق_محمل(&متغير التشخيص, المحمل, النطاق);
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    }
    | خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(النطاق, السياق, المتوقع, الموجود) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_نوعي(
            معرف_تشخيص.نوعان_غير_متوافقين(), المحمل, النطاق, سبب_سياق_عدم_توافق_نوع(السياق)
        );
        // A value's Type is printed without the `mutable` of its storage.
        طابق المتوقع مع
        | اختياري.موجود(النوع) -> {
            دع أضيف_المتوقع: منطقي = أضف_نوع_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, نوع_بلا_غلاف_متغير(الأنواع, النوع)
            );
        }
        | اختياري.لا_شيء -> { };
        طابق الموجود مع
        | اختياري.موجود(النوع) -> {
            دع أضيف_الموجود: منطقي = أضف_نوع_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, &(*سياق_الأسماء).الأسماء, &(*سياق_الأسماء).الرموز, نوع_بلا_غلاف_متغير(الأنواع, النوع)
            );
        }
        | اختياري.لا_شيء -> { };
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(النطاق) -> {
        أرجع تشخيصات_فشل_واجهة_عند(
            معرف_تشخيص.أخذ_عنوان_غير_قيمة_يسرى(), مصدر_تشخيص_من_نطاق_محمل(المحمل, النطاق)
        );
    }
    | خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_نوعي(
            معرف_تشخيص.كتابة_إلى_غير_متغير(), المحمل, النطاق,
            سبب_تشخيص.سبب_نوع_موضع_غير_قابل_للتغيير()
        );
        أرجع مجموعة_تشخيص_واحد(&التشخيص);
    }
    | خطأ_بناء_سياقات_أنواع.إسناد_إلى_غير_موضع(النطاق) -> {
