استورد compiler.source.span;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.names.import_queries;
استورد compiler.frontend.ast.unit;

// Facts a tooling Frontend request keeps beside the canonical results, in one
// record so the Frontend result changes shape once. A compilation keeps none.

// The analysis of a source that is incomplete:
//   التحميل  false when the source did not load whole: one of its imports
//            could not be loaded (the statement adds no edge), or the source
//            could not be read as tokens (its declarations are absent).
//   الأسماء  false when its names are absent: the Name pass could not bind
//            the module, or the source has no declarations to bind.
//   الأنواع  false when no Type, Pattern or SSF facts exist for it because a
//            phase stopped.
// The diagnostics in تشخيصات_الأدوات say why, at their own spans.
عام نوع اكتمال_مصدر_أدوات = {
    المصدر: طبيعي,
    التحميل: منطقي,
    الأسماء: منطقي,
    الأنواع: منطقي
};

// المصادر_الناقصة lists only incomplete sources; an empty list means every
// analysed source is complete (its diagnostics may still report errors).
// الاستيرادات_الفاشلة: the import statements that could not be loaded.
// الأنواع_متوقفة: the last resort was taken: a phase failed in a way that no
// single source accounts for, so no source has Type facts (every entry of
// المصادر_الناقصة then says so).
عام نوع حقائق_أدوات_واجهة = {
    علاقات_الاستيراد: متجه علاقة_استيراد_وحدة,
    المصادر_الناقصة: متجه اكتمال_مصدر_أدوات,
    الاستيرادات_الفاشلة: متجه نطاق,
    الأنواع_متوقفة: منطقي
};

// What a tooling request recorded instead of stopping while it loaded the
// modules: sources that did not load whole, sources whose tokens could not be
// read (they stand as empty modules), and the failed import statements.
عام نوع إخفاقات_تحميل_أدوات = {
    بلا_تحميل: متجه طبيعي,
    بلا_تصريحات: متجه طبيعي,
    الاستيرادات: متجه نطاق
};

عام عرف إخفاقات_تحميل_أدوات_جديدة(): إخفاقات_تحميل_أدوات {
    دع بلا_تحميل: متجه طبيعي = [];
    دع بلا_تصريحات: متجه طبيعي = [];
    دع الاستيرادات: متجه نطاق = [];
    دع الناتج: إخفاقات_تحميل_أدوات = {
        بلا_تحميل: بلا_تحميل,
        بلا_تصريحات: بلا_تصريحات,
        الاستيرادات: الاستيرادات
    };
    أرجع الناتج;
}

عرف مصدر_في_قائمة_أدوات(القائمة: &متجه طبيعي, المصدر: طبيعي): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا ((*القائمة)[ف] == المصدر) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف سجل_مصدرا_في_قائمة_أدوات(القائمة: &متغير متجه طبيعي, المصدر: طبيعي): فراغ {
    إذا (!مصدر_في_قائمة_أدوات(القائمة, المصدر)) { ألحق(*القائمة, المصدر); };
}

عرف انسخ_نطاقات_أدوات(القيم: &متجه نطاق): متجه نطاق {
    دع الناتج: متغير متجه نطاق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        ألحق(الناتج, (*القيم)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The incomplete sources: الأنواع_متاحة false marks every source's Type facts
// absent (the last resort); بلا_أسماء lists the sources whose names are absent
// or only partly bound, بلا_أنواع those with declarations set aside before
// typing (or no Type facts at all).
عرف مصادر_ناقصة_أدوات(
    الأشجار: &متجه وحدة_مصدر,
    الإخفاقات: &إخفاقات_تحميل_أدوات,
    بلا_أسماء: &متجه طبيعي,
    بلا_أنواع: &متجه طبيعي,
    الأنواع_متاحة: منطقي
): متجه اكتمال_مصدر_أدوات {
    دع الناقصة: متغير متجه اكتمال_مصدر_أدوات = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأشجار) مثل طبيعي)) {
        دع المصدر: طبيعي = (*الأشجار)[ف].معرف_المصدر;
        دع بلا_تصريحات: منطقي = مصدر_في_قائمة_أدوات(&(*الإخفاقات).بلا_تصريحات, المصدر);
        دع التحميل: منطقي = !بلا_تصريحات && !مصدر_في_قائمة_أدوات(&(*الإخفاقات).بلا_تحميل, المصدر);
        دع الأسماء: منطقي = !بلا_تصريحات && !مصدر_في_قائمة_أدوات(بلا_أسماء, المصدر);
        دع الأنواع: منطقي = الأنواع_متاحة && !بلا_تصريحات && !مصدر_في_قائمة_أدوات(بلا_أنواع, المصدر);
        إذا (!التحميل || !الأسماء || !الأنواع) {
            دع المدخل: اكتمال_مصدر_أدوات = {
                المصدر: المصدر,
                التحميل: التحميل,
                الأسماء: الأسماء,
                الأنواع: الأنواع
            };
            ألحق(الناقصة, المدخل);
        };
        ف := ف + 1;
    }
    أرجع الناقصة;
}

// A completed request. A compilation keeps no tooling facts.
عام عرف حقائق_أدوات_للطلب(
    الرسم: &رسم_وحدات,
    الأشجار: &متجه وحدة_مصدر,
    احتفظ_بحقائق_الأدوات: منطقي,
    الإخفاقات: &إخفاقات_تحميل_أدوات,
    بلا_أسماء: &متجه طبيعي,
    بلا_أنواع: &متجه طبيعي
): حقائق_أدوات_واجهة {
    دع الناقصة: متغير متجه اكتمال_مصدر_أدوات = [];
    دع الفاشلة: متغير متجه نطاق = [];
    إذا (احتفظ_بحقائق_الأدوات) {
        الناقصة := مصادر_ناقصة_أدوات(الأشجار, الإخفاقات, بلا_أسماء, بلا_أنواع, صواب);
        الفاشلة := انسخ_نطاقات_أدوات(&(*الإخفاقات).الاستيرادات);
    };
    دع الناتج: حقائق_أدوات_واجهة = {
        علاقات_الاستيراد: علاقات_استيراد_للأدوات(
            الرسم, الأشجار, احتفظ_بحقائق_الأدوات, &(*الإخفاقات).الاستيرادات
        ),
        المصادر_الناقصة: الناقصة,
        الاستيرادات_الفاشلة: الفاشلة,
        الأنواع_متوقفة: خطأ
    };
    أرجع الناتج;
}

// The last resort: no source has Type facts, and the sources the Name pass
// could not bind lack Name facts too.
عام عرف حقائق_أدوات_ناقصة(
    الرسم: &رسم_وحدات,
    الأشجار: &متجه وحدة_مصدر,
    بلا_أسماء: &متجه طبيعي,
    الإخفاقات: &إخفاقات_تحميل_أدوات
): حقائق_أدوات_واجهة {
    دع الناتج: حقائق_أدوات_واجهة = {
        علاقات_الاستيراد: استخلص_علاقات_استيراد(الرسم, الأشجار, &(*الإخفاقات).الاستيرادات),
        المصادر_الناقصة: مصادر_ناقصة_أدوات(الأشجار, الإخفاقات, بلا_أسماء, بلا_أسماء, خطأ),
        الاستيرادات_الفاشلة: انسخ_نطاقات_أدوات(&(*الإخفاقات).الاستيرادات),
        الأنواع_متوقفة: صواب
    };
    أرجع الناتج;
}

// Completeness of one source.
عام عرف اكتمال_مصدر_في_حقائق(الحقائق: &حقائق_أدوات_واجهة, المصدر: طبيعي): اكتمال_مصدر_أدوات {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحقائق).المصادر_الناقصة) مثل طبيعي)) {
        إذا ((*الحقائق).المصادر_الناقصة[ف].المصدر == المصدر) { أرجع (*الحقائق).المصادر_الناقصة[ف]; };
        ف := ف + 1;
    }
    دع الكامل: اكتمال_مصدر_أدوات = { المصدر: المصدر, التحميل: صواب, الأسماء: صواب, الأنواع: صواب };
    أرجع الكامل;
}
