استورد compiler.frontend.source.position;

// نطاق نصف مفتوح بين موضعين من source نفسه.
عام نوع نطاق = {
    البداية: موضع,
    النهاية: موضع
};

عام عرف نطاق_بين(البداية: موضع, النهاية: موضع): نطاق {
    دع الناتج: نطاق = {
        البداية: البداية,
        النهاية: النهاية
    };
    أرجع الناتج;
}

عام عرف دمج_نطاق(البداية: نطاق, النهاية: نطاق): نطاق {
    أرجع نطاق_بين(البداية.البداية, النهاية.النهاية);
}

عام عرف نطاق_فارغ(): نطاق {
    دع الموضع: موضع = {
        المصدر: 0,
        البايت: 0,
        السطر: 1,
        العمود: 0
    };
    أرجع نطاق_بين(الموضع, الموضع);
}
// هوية نطاق source هي المصدر وحدود البايت؛ السطر/العمود بيانات تشخيصية فقط.
عام عرف نطاقان_متساويان(أ: نطاق, ب: نطاق): منطقي {
    أرجع (أ.البداية.المصدر == ب.البداية.المصدر)
        && (أ.البداية.البايت == ب.البداية.البايت)
        && (أ.النهاية.المصدر == ب.النهاية.المصدر)
        && (أ.النهاية.البايت == ب.النهاية.البايت);
}

// Point queries use the canonical half-open source-range rule: start <= byte < end.
عام عرف نطاق_يحتوي_بايتا(النطاق: نطاق, المصدر: غير_موقع, البايت: غير_موقع): منطقي {
    لو (النطاق.البداية.المصدر != المصدر || النطاق.النهاية.المصدر != المصدر) {
        أرجع خطأ;
    };
    أرجع (النطاق.البداية.البايت <= البايت) && (البايت < النطاق.النهاية.البايت);
}

عام عرف طول_نطاق_بالبايت(النطاق: نطاق): غير_موقع {
    لو (النطاق.النهاية.البايت < النطاق.البداية.البايت) { أرجع 0; };
    أرجع النطاق.النهاية.البايت - النطاق.البداية.البايت;
}

