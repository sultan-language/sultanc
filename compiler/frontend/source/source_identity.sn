استورد compiler.frontend.source.source;

// مجال المصدر يخصص معرفات المصادر من سياق الهوية المقنن.
// يشترك منتجو المصادر الشرعيون في هذا السياق بدلا من امتلاك عدادات مستقلة.
عام نوع سياق_هوية_مصدر = {
    معرف_المصدر_التالي: غير_موقع
};

عام عرف سياق_هوية_مصدر_جديد(): سياق_هوية_مصدر {
    دع السياق: سياق_هوية_مصدر = {
        معرف_المصدر_التالي: 0
    };
    أرجع السياق;
}

عام عرف خصص_معرف_مصدر(
    السياق: &متغير سياق_هوية_مصدر
): غير_موقع {
    دع الحالة: متغير سياق_هوية_مصدر = *السياق;
    دع المعرف: غير_موقع = الحالة.معرف_المصدر_التالي;
    الحالة.معرف_المصدر_التالي := المعرف + 1;
    *السياق := الحالة;
    أرجع المعرف;
}

// الإنشاء ذو الهوية يربط تخصيص معرف المصدر بإنشاء كائن المصدر نفسه.
عام عرف أنشئ_مصدر_بهوية(
    السياق: &متغير سياق_هوية_مصدر,
    الاسم: نص,
    المحتوى: نص
): مصدر {
    دع المعرف: غير_موقع = خصص_معرف_مصدر(السياق);
    أرجع مصدر_جديد(المعرف, الاسم, المحتوى);
}
