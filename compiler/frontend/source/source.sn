استورد std.text.range;
// يمثل source نص الإدخال واسمه وهويته طوال دورة التحليل.
// يحتفظ source بالاسم والمحتوى؛ الرموز تحفظ نطاقات رقمية ولا تنسخ النص الثابت.

عام نوع مصدر = {
    المعرف: غير_موقع,
    الاسم: نص,
    المحتوى: نص,
    الطول: غير_موقع
};

عام عرف مصدر_جديد(
    المعرف: غير_موقع,
    الاسم: نص,
    المحتوى: نص
): مصدر {
    دع العدد: غير_موقع = الطول(المحتوى) مثل غير_موقع;
    دع الناتج: مصدر = {
        المعرف: المعرف,
        الاسم: الاسم,
        المحتوى: المحتوى,
        الطول: العدد
    };
    أرجع الناتج;
}

عام عرف متاح_في_المصدر(
    المصدر: &مصدر,
    الموضع: غير_موقع,
    العدد: غير_موقع
): منطقي {
    دع قيمة: مصدر = *المصدر;
    أرجع متاح_في_النص(&قيمة.المحتوى, الموضع, العدد);
}

عام عرف بايت_المصدر(المصدر: &مصدر, الموضع: غير_موقع): غ8 {
    دع قيمة: مصدر = *المصدر;
    أرجع قيمة.المحتوى[الموضع];
}
