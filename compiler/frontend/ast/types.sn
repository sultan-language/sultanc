استورد compiler.source.span;
استورد compiler.frontend.ast.name;

// نوع آلة دلالي في ast؛ لا يخزن هوية رمز معجمي.
عام نوع نوع_آلة =
    | ص8
    | ص16
    | ص32
    | ص64
    | ط8
    | ط16
    | ط32
    | ط64
    | ع32
    | ع64
;

عام نوع نوع_تركيبي =
    | أي بنوع نطاق
    | منطقي بنوع نطاق
    | آلة بنوع (نطاق, نوع_آلة)
    | عدد بنوع نطاق
    | طبيعي بنوع نطاق
    | حرف بنوع نطاق
    | نص بنوع نطاق
    | صف بنوع (نطاق, متجه نوع_تركيبي)
    | صندوق بنوع (نطاق, صندوق نوع_تركيبي)
    | اختيار بنوع (نطاق, صندوق نوع_تركيبي)
    | نتيجة بنوع (
        نطاق,
        صندوق نوع_تركيبي,
        صندوق نوع_تركيبي
    )
    | دالة بنوع (
        نطاق,
        متجه نوع_تركيبي,
        صندوق نوع_تركيبي
    )
    | مسمى بنوع (
        نطاق,
        اسم,
        متجه نوع_تركيبي
    )
    | مؤشر بنوع (نطاق, صندوق نوع_تركيبي)
    | مرجع بنوع (نطاق, صندوق نوع_تركيبي)
    | شريحة بنوع (نطاق, صندوق نوع_تركيبي)
    | متجه بنوع (نطاق, صندوق نوع_تركيبي)
    | متغير بنوع (نطاق, صندوق نوع_تركيبي)
    | فراغ بنوع نطاق
;

// The source span of a written type.
عام عرف نطاق_نوع_تركيبي(النوع: &نوع_تركيبي): نطاق {
    دع القيمة: نوع_تركيبي = *النوع;
    طابق القيمة مع
    | نوع_تركيبي.أي(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.منطقي(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.آلة(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.عدد(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.طبيعي(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.حرف(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.نص(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.صف(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.صندوق(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.اختيار(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.نتيجة(س, _, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.دالة(س, _, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.مسمى(س, _, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.مؤشر(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.مرجع(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.شريحة(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.متجه(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.متغير(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.فراغ(س) -> {
        أرجع س;
    };
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_نوع_تركيبي(القيمة: &نوع_تركيبي): نوع_تركيبي {
    طابق *القيمة مع
    | نوع_تركيبي.أي(ح0) -> { أرجع نوع_تركيبي.أي(ح0); }
    | نوع_تركيبي.منطقي(ح0) -> { أرجع نوع_تركيبي.منطقي(ح0); }
    | نوع_تركيبي.آلة(ح0, ح1) -> { أرجع نوع_تركيبي.آلة(ح0, ح1); }
    | نوع_تركيبي.عدد(ح0) -> { أرجع نوع_تركيبي.عدد(ح0); }
    | نوع_تركيبي.طبيعي(ح0) -> { أرجع نوع_تركيبي.طبيعي(ح0); }
    | نوع_تركيبي.حرف(ح0) -> { أرجع نوع_تركيبي.حرف(ح0); }
    | نوع_تركيبي.نص(ح0) -> { أرجع نوع_تركيبي.نص(ح0); }
    | نوع_تركيبي.صف(ح0, ح1) -> { أرجع نوع_تركيبي.صف(ح0, انسخ_مملوكا_متجه_نوع_تركيبي(&ح1)); }
    | نوع_تركيبي.صندوق(ح0, ح1) -> { أرجع نوع_تركيبي.صندوق(ح0, انسخ_مملوكا__صندوق_نوع_تركيبي(&ح1)); }
    | نوع_تركيبي.اختيار(ح0, ح1) -> { أرجع نوع_تركيبي.اختيار(ح0, انسخ_مملوكا__صندوق_نوع_تركيبي(&ح1)); }
    | نوع_تركيبي.نتيجة(ح0, ح1, ح2) -> { أرجع نوع_تركيبي.نتيجة(ح0, انسخ_مملوكا__صندوق_نوع_تركيبي(&ح1), انسخ_مملوكا__صندوق_نوع_تركيبي(&ح2)); }
    | نوع_تركيبي.دالة(ح0, ح1, ح2) -> { أرجع نوع_تركيبي.دالة(ح0, انسخ_مملوكا_متجه_نوع_تركيبي(&ح1), انسخ_مملوكا__صندوق_نوع_تركيبي(&ح2)); }
    | نوع_تركيبي.مسمى(ح0, ح1, ح2) -> { أرجع نوع_تركيبي.مسمى(ح0, ح1, انسخ_مملوكا_متجه_نوع_تركيبي(&ح2)); }
    | نوع_تركيبي.مؤشر(ح0, ح1) -> { أرجع نوع_تركيبي.مؤشر(ح0, انسخ_مملوكا__صندوق_نوع_تركيبي(&ح1)); }
    | نوع_تركيبي.مرجع(ح0, ح1) -> { أرجع نوع_تركيبي.مرجع(ح0, انسخ_مملوكا__صندوق_نوع_تركيبي(&ح1)); }
    | نوع_تركيبي.شريحة(ح0, ح1) -> { أرجع نوع_تركيبي.شريحة(ح0, انسخ_مملوكا__صندوق_نوع_تركيبي(&ح1)); }
    | نوع_تركيبي.متجه(ح0, ح1) -> { أرجع نوع_تركيبي.متجه(ح0, انسخ_مملوكا__صندوق_نوع_تركيبي(&ح1)); }
    | نوع_تركيبي.متغير(ح0, ح1) -> { أرجع نوع_تركيبي.متغير(ح0, انسخ_مملوكا__صندوق_نوع_تركيبي(&ح1)); }
    | نوع_تركيبي.فراغ(ح0) -> { أرجع نوع_تركيبي.فراغ(ح0); };
}

عام عرف انسخ_مملوكا_متجه_نوع_تركيبي(القيمة: &متجه نوع_تركيبي): متجه نوع_تركيبي {
    دع الناتج: متغير متجه نوع_تركيبي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_نوع_تركيبي(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف انسخ_مملوكا__صندوق_نوع_تركيبي(القيمة: &صندوق نوع_تركيبي): صندوق نوع_تركيبي {
    دع الداخل: نوع_تركيبي = انسخ_مملوكا_نوع_تركيبي(&(*(*القيمة)));
    دع الصندوق: صندوق نوع_تركيبي = صندوق الداخل;
    أرجع الصندوق;
}
