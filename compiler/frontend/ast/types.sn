استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.ast.name;

// نوع آلة دلالي في ast؛ لا يخزن هوية رمز معجمي.
عام نوع نوع_آلة =
    | ص8
    | ص16
    | ص32
    | ص64
    | غ8
    | غ16
    | غ32
    | غ64
    | ع32
    | ع64
;

عام نوع نوع_تركيبي =
    | أي بنوع نطاق
    | منطقي بنوع نطاق
    | آلة بنوع (نطاق, نوع_آلة)
    | عدد بنوع نطاق
    | غير_موقع بنوع نطاق
    | حرف بنوع نطاق
    | نص بنوع نطاق
    | صف بنوع (نطاق, متجه نوع_تركيبي)
    | صندوق بنوع (نطاق, صندوق نوع_تركيبي)
    | اختيار بنوع (نطاق, صندوق نوع_تركيبي)
    | نتيجة بنوع (
        نطاق,
        صندوق نوع_تركيبي,
        صندوق نوع_تركيبي
    )
    | دالة بنوع (
        نطاق,
        متجه نوع_تركيبي,
        صندوق نوع_تركيبي
    )
    | مسمى بنوع (
        نطاق,
        اسم,
        متجه نوع_تركيبي
    )
    | مؤشر بنوع (نطاق, صندوق نوع_تركيبي)
    | مرجع بنوع (نطاق, صندوق نوع_تركيبي)
    | شريحة بنوع (نطاق, صندوق نوع_تركيبي)
    | متجه بنوع (نطاق, صندوق نوع_تركيبي)
    | متغير بنوع (نطاق, صندوق نوع_تركيبي)
    | فراغ بنوع نطاق
;
