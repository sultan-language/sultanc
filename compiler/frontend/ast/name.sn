استورد compiler.source.span;

// أسماء المصدر تبقى أسماء عادية؛ تصنيف Option/Result/Vector تملكه Type لا Lexer/Parser.
عام نوع صنف_اسم_تركيبي =
    | عادي
;

// اسم كما ظهر في source؛ دلالته تُحسم في طبقة لاحقة.
عام نوع اسم = {
    النطاق: نطاق,
    الصنف: صنف_اسم_تركيبي
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_اسم(القيمة: &متجه اسم): متجه اسم {
    دع الناتج: متغير متجه اسم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
