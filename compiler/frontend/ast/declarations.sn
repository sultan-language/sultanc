استورد std.text.from_bytes;
استورد compiler.frontend.ast.literals;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.patterns;
استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.statements;

// Declaration annotations preserve source order and actual expression syntax.
// They do not duplicate declaration identity or replace Name/Type resolution.
عام نوع سمة_تصريح = {
    النطاق: نطاق,
    المسار: متجه اسم,
    الحجج: متجه تعبير,
    // `@@d(args)`: a definition-time decorator, applied once before the
    // program's entry runs (frontend/annotations/definition_decorators.sn).
    عند_التعريف: منطقي
};

عام نوع معامل = {
    الاسم: اسم,
    النوع: نوع_تركيبي,
    النطاق: نطاق,
    مطلوب_مسبقا: منطقي
};

// غياب الجسم هو التمثيل الوحيد للدالة الخارجية؛ لا جسم/نطاق صوري ولا علم متوازٍ.
// An external declaration may name the platform library that exports it
// (`خارجي «kernel32.dll» عرف ...`: a PE DLL, a Mach-O install name, a
// WebAssembly import module) and the exact linker symbol it binds
// (`... = «stat$INODE64»;`). A function with a body has neither.
عام نوع تصريح_دالة = {
    النطاق: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    الأسماء_البديلة: متجه اسم,
    علني: منطقي,
    المعاملات: متجه معامل,
    الناتج: نوع_تركيبي,
    السمات: متجه سمة_تصريح,
    الجسم: اختياري كتلة_عبارات,
    المكتبة_الخارجية: اختياري متجه ط8,
    اسم_الربط: اختياري متجه ط8
};

// المرادف المستقل ربط اسم فقط؛ لا يملك تصريحا أو جسما أو هوية دلالية جديدة.
عام نوع تصريح_مرادف_اسم = {
    النطاق: نطاق,
    أب_الوجهة: اختياري اسم,
    الاسم: اسم,
    أب_الهدف: اختياري اسم,
    الهدف: اسم,
    علني: منطقي
};

عام نوع حقل_نوع = {
    الاسم: اسم,
    النوع: نوع_تركيبي
};
عام نوع منشئ_نوع = {
    الاسم: اسم,
    الحمولات: متجه نوع_تركيبي
};

عام نوع شكل_تصريح_نوع =
    | مرادف بنوع نوع_تركيبي
    | سجل بنوع متجه حقل_نوع
    | تعداد بنوع متجه منشئ_نوع
    // `type T = opaque;`: a named type with its own identity and no fields,
    // size or alignment. Only a raw pointer to it holds a value. The span is
    // the contextual word as written.
    | معتم بنوع نطاق
;

// التصريح نفسه هو صاحب الحقيقة الوحيد للاسم والنطاق وعلنية التصريح.
عام نوع تصريح_نوع = {
    النطاق: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    علني: منطقي,
    السمات: متجه سمة_تصريح,
    الشكل: شكل_تصريح_نوع
};

// Module-level aggregates reuse the same expression elements as local initializers.
// Unlike a runtime expression, the aggregate is evaluated before MSIR emission.
عام نوع تهيئة_قيمة_عليا =
    | تعبير بنوع تعبير
    | متجه بنوع متجه تعبير
    // Explicit target linker data symbol; no initializer or owned storage.
    | خارجية بنوع متجه ط8
;

// Top-level value declarations use the existing `let` surface. An outer
// `mutable` wrapper on the declared Type denotes writable global storage;
// otherwise the declaration is an immutable compile-time constant.
عام نوع تصريح_قيمة_عليا = {
    النطاق: نطاق,
    الاسم: اسم,
    النوع: نوع_تركيبي,
    علني: منطقي,
    السمات: متجه سمة_تصريح,
    التهيئة: تهيئة_قيمة_عليا
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_تصريح_دالة(القيمة: &تصريح_دالة): تصريح_دالة {
    دع الناتج: تصريح_دالة = {
        النطاق: (*القيمة).النطاق,
        الاسم: (*القيمة).الاسم,
        معاملات_النوع: انسخ_مملوكا_متجه_اسم(&(*القيمة).معاملات_النوع),
        الأسماء_البديلة: انسخ_مملوكا_متجه_اسم(&(*القيمة).الأسماء_البديلة),
        علني: (*القيمة).علني,
        المعاملات: انسخ_مملوكا_متجه_معامل(&(*القيمة).المعاملات),
        الناتج: انسخ_مملوكا_نوع_تركيبي(&(*القيمة).الناتج),
        السمات: انسخ_مملوكا_متجه_سمة_تصريح(&(*القيمة).السمات),
        الجسم: انسخ_مملوكا_اختيار_كتلة_عبارات(&(*القيمة).الجسم),
        المكتبة_الخارجية: انسخ_اختيار_بايتات(&(*القيمة).المكتبة_الخارجية),
        اسم_الربط: انسخ_اختيار_بايتات(&(*القيمة).اسم_الربط)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_معامل(القيمة: &متجه معامل): متجه معامل {
    دع الناتج: متغير متجه معامل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_معامل(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_معامل(القيمة: &معامل): معامل {
    دع الناتج: معامل = {
        الاسم: (*القيمة).الاسم,
        النوع: انسخ_مملوكا_نوع_تركيبي(&(*القيمة).النوع),
        النطاق: (*القيمة).النطاق,
        مطلوب_مسبقا: (*القيمة).مطلوب_مسبقا
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_سمة_تصريح(القيمة: &متجه سمة_تصريح): متجه سمة_تصريح {
    دع الناتج: متغير متجه سمة_تصريح = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_سمة_تصريح(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_سمة_تصريح(القيمة: &سمة_تصريح): سمة_تصريح {
    دع الناتج: سمة_تصريح = {
        النطاق: (*القيمة).النطاق,
        المسار: انسخ_مملوكا_متجه_اسم(&(*القيمة).المسار),
        الحجج: انسخ_مملوكا_متجه_تعبير(&(*القيمة).الحجج),
        عند_التعريف: (*القيمة).عند_التعريف
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تصريح_نوع(القيمة: &تصريح_نوع): تصريح_نوع {
    دع الناتج: تصريح_نوع = {
        النطاق: (*القيمة).النطاق,
        الاسم: (*القيمة).الاسم,
        معاملات_النوع: انسخ_مملوكا_متجه_اسم(&(*القيمة).معاملات_النوع),
        علني: (*القيمة).علني,
        السمات: انسخ_مملوكا_متجه_سمة_تصريح(&(*القيمة).السمات),
        الشكل: انسخ_مملوكا_شكل_تصريح_نوع(&(*القيمة).الشكل)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_شكل_تصريح_نوع(القيمة: &شكل_تصريح_نوع): شكل_تصريح_نوع {
    طابق *القيمة مع
    | شكل_تصريح_نوع.مرادف(ح0) -> { أرجع شكل_تصريح_نوع.مرادف(انسخ_مملوكا_نوع_تركيبي(&ح0)); }
    | شكل_تصريح_نوع.سجل(ح0) -> { أرجع شكل_تصريح_نوع.سجل(انسخ_مملوكا_متجه_حقل_نوع(&ح0)); }
    | شكل_تصريح_نوع.تعداد(ح0) -> { أرجع شكل_تصريح_نوع.تعداد(انسخ_مملوكا_متجه_منشئ_نوع(&ح0)); }
    | شكل_تصريح_نوع.معتم(ح0) -> { أرجع شكل_تصريح_نوع.معتم(ح0); };
}

عام عرف انسخ_مملوكا_متجه_حقل_نوع(القيمة: &متجه حقل_نوع): متجه حقل_نوع {
    دع الناتج: متغير متجه حقل_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_حقل_نوع(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حقل_نوع(القيمة: &حقل_نوع): حقل_نوع {
    دع الناتج: حقل_نوع = {
        الاسم: (*القيمة).الاسم,
        النوع: انسخ_مملوكا_نوع_تركيبي(&(*القيمة).النوع)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_منشئ_نوع(القيمة: &متجه منشئ_نوع): متجه منشئ_نوع {
    دع الناتج: متغير متجه منشئ_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_منشئ_نوع(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_منشئ_نوع(القيمة: &منشئ_نوع): منشئ_نوع {
    دع الناتج: منشئ_نوع = {
        الاسم: (*القيمة).الاسم,
        الحمولات: انسخ_مملوكا_متجه_نوع_تركيبي(&(*القيمة).الحمولات)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تصريح_قيمة_عليا(القيمة: &تصريح_قيمة_عليا): تصريح_قيمة_عليا {
    دع الناتج: تصريح_قيمة_عليا = {
        النطاق: (*القيمة).النطاق,
        الاسم: (*القيمة).الاسم,
        النوع: انسخ_مملوكا_نوع_تركيبي(&(*القيمة).النوع),
        علني: (*القيمة).علني,
        السمات: انسخ_مملوكا_متجه_سمة_تصريح(&(*القيمة).السمات),
        التهيئة: انسخ_مملوكا_تهيئة_قيمة_عليا(&(*القيمة).التهيئة)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تهيئة_قيمة_عليا(القيمة: &تهيئة_قيمة_عليا): تهيئة_قيمة_عليا {
    طابق *القيمة مع
    | تهيئة_قيمة_عليا.تعبير(ح0) -> { أرجع تهيئة_قيمة_عليا.تعبير(انسخ_مملوكا_تعبير(&ح0)); }
    | تهيئة_قيمة_عليا.متجه(ح0) -> { أرجع تهيئة_قيمة_عليا.متجه(انسخ_مملوكا_متجه_تعبير(&ح0)); }
    | تهيئة_قيمة_عليا.خارجية(ح0) -> { أرجع تهيئة_قيمة_عليا.خارجية(انسخ_بايتات(&ح0)); };
}
