استورد compiler.frontend.ast.literals;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.patterns;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.statements;

عام نوع معامل = {
    الاسم: اسم,
    النوع: نوع_تركيبي,
    النطاق: نطاق
};

// غياب الجسم هو التمثيل الوحيد للدالة الخارجية؛ لا جسم/نطاق صوري ولا علم متوازٍ.
عام نوع تصريح_دالة = {
    النطاق: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    الأسماء_البديلة: متجه اسم,
    علني: منطقي,
    المعاملات: متجه معامل,
    الناتج: نوع_تركيبي,
    الجسم: اختيار كتلة_عبارات
};

// المرادف المستقل ربط اسم فقط؛ لا يملك تصريحا أو جسما أو هوية دلالية جديدة.
عام نوع تصريح_مرادف_اسم = {
    النطاق: نطاق,
    أب_الوجهة: اختيار اسم,
    الاسم: اسم,
    أب_الهدف: اختيار اسم,
    الهدف: اسم,
    علني: منطقي
};

عام نوع حقل_نوع = {
    الاسم: اسم,
    النوع: نوع_تركيبي
};
عام نوع منشئ_نوع = {
    الاسم: اسم,
    الحمولات: متجه نوع_تركيبي
};

عام نوع شكل_تصريح_نوع =
    | مرادف بنوع نوع_تركيبي
    | سجل بنوع متجه حقل_نوع
    | تعداد بنوع متجه منشئ_نوع
;

// التصريح نفسه هو صاحب الحقيقة الوحيد للاسم والنطاق وعلنية التصريح.
عام نوع تصريح_نوع = {
    النطاق: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    علني: منطقي,
    الشكل: شكل_تصريح_نوع
};
