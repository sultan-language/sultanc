استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.literals;

عام نوع حقل_نمط = {
    الاسم: اسم,
    النمط: نمط
};

عام نوع نمط =
    | بدل بنوع نطاق
    | ربط بنوع (نطاق, اسم)
    | حرفي بنوع (نطاق, حرفي)
    | مدى بنوع (نطاق, حرفي, حرفي)
    | بدائل بنوع (نطاق, متجه نمط)
    | منشئ بنوع (
        نطاق,
        اسم,
        اسم,
        متجه نمط
    )
    | صف بنوع (نطاق, متجه نمط)
    | سجل بنوع (
        نطاق,
        متجه حقل_نمط
    )
;

// AST owns the source extent of syntactic patterns. Semantic consumers query
// this fact instead of reconstructing a second pattern-range rule.
عام عرف نطاق_نمط(النمط: &نمط): نطاق {
    دع القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.بدل(النطاق) -> { أرجع النطاق; }
    | نمط.ربط(النطاق, _) -> { أرجع النطاق; }
    | نمط.حرفي(النطاق, _) -> { أرجع النطاق; }
    | نمط.مدى(النطاق, _, _) -> { أرجع النطاق; }
    | نمط.بدائل(النطاق, _) -> { أرجع النطاق; }
    | نمط.منشئ(النطاق, _, _, _) -> { أرجع النطاق; }
    | نمط.صف(النطاق, _) -> { أرجع النطاق; }
    | نمط.سجل(النطاق, _) -> { أرجع النطاق; };
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_نمط(القيمة: &نمط): نمط {
    طابق *القيمة مع
    | نمط.بدل(ح0) -> { أرجع نمط.بدل(ح0); }
    | نمط.ربط(ح0, ح1) -> { أرجع نمط.ربط(ح0, ح1); }
    | نمط.حرفي(ح0, ح1) -> { أرجع نمط.حرفي(ح0, انسخ_مملوكا_حرفي(&ح1)); }
    | نمط.مدى(ح0, ح1, ح2) -> { أرجع نمط.مدى(ح0, انسخ_مملوكا_حرفي(&ح1), انسخ_مملوكا_حرفي(&ح2)); }
    | نمط.بدائل(ح0, ح1) -> { أرجع نمط.بدائل(ح0, انسخ_مملوكا_متجه_نمط(&ح1)); }
    | نمط.منشئ(ح0, ح1, ح2, ح3) -> { أرجع نمط.منشئ(ح0, ح1, ح2, انسخ_مملوكا_متجه_نمط(&ح3)); }
    | نمط.صف(ح0, ح1) -> { أرجع نمط.صف(ح0, انسخ_مملوكا_متجه_نمط(&ح1)); }
    | نمط.سجل(ح0, ح1) -> { أرجع نمط.سجل(ح0, انسخ_مملوكا_متجه_حقل_نمط(&ح1)); };
}

عام عرف انسخ_مملوكا_متجه_نمط(القيمة: &متجه نمط): متجه نمط {
    دع الناتج: متغير متجه نمط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_نمط(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_حقل_نمط(القيمة: &متجه حقل_نمط): متجه حقل_نمط {
    دع الناتج: متغير متجه حقل_نمط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_حقل_نمط(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حقل_نمط(القيمة: &حقل_نمط): حقل_نمط {
    دع الناتج: حقل_نمط = {
        الاسم: (*القيمة).الاسم,
        النمط: انسخ_مملوكا_نمط(&(*القيمة).النمط)
    };
    أرجع الناتج;
}
