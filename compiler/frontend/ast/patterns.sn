استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.literals;

عام نوع حقل_نمط = {
    الاسم: اسم,
    النمط: نمط
};

عام نوع نمط =
    | بدل بنوع نطاق
    | ربط بنوع (نطاق, اسم)
    | حرفي بنوع (نطاق, حرفي)
    // `range a..b`: the values a through b, both included; an open end
    // (`range 100..`, `range ..0`) is absent and reaches the end of the Type.
    | مدى بنوع (نطاق, اختياري حرفي, اختياري حرفي)
    | بدائل بنوع (نطاق, متجه نمط)
    | منشئ بنوع (
        نطاق,
        اسم,
        اسم,
        متجه نمط
    )
    | صف بنوع (نطاق, متجه نمط)
    | سجل بنوع (
        نطاق,
        متجه حقل_نمط
    )
    // `pattern as name` (`مثل`): the pattern, and a name for the whole value
    // it matches.
    | مستعار بنوع (نطاق, صندوق نمط, اسم)
    // A vector or slice pattern `[p, q, rest tail, r]`: the elements before
    // the rest, the rest (none, or one pattern: a wildcard at `rest _`, or a
    // binding at `rest name`), and the elements after it.
    | تسلسل بنوع (نطاق, متجه نمط, متجه نمط, متجه نمط)
;

// AST owns the source extent of syntactic patterns. Semantic consumers query
// this fact instead of reconstructing a second pattern-range rule.
عام عرف نطاق_نمط(النمط: &نمط): نطاق {
    ليكن القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.بدل(النطاق) -> { أرجع النطاق; }
    | نمط.ربط(النطاق, _) -> { أرجع النطاق; }
    | نمط.حرفي(النطاق, _) -> { أرجع النطاق; }
    | نمط.مدى(النطاق, _, _) -> { أرجع النطاق; }
    | نمط.بدائل(النطاق, _) -> { أرجع النطاق; }
    | نمط.منشئ(النطاق, _, _, _) -> { أرجع النطاق; }
    | نمط.صف(النطاق, _) -> { أرجع النطاق; }
    | نمط.سجل(النطاق, _) -> { أرجع النطاق; }
    | نمط.مستعار(النطاق, _, _) -> { أرجع النطاق; }
    | نمط.تسلسل(النطاق, _, _, _) -> { أرجع النطاق; };
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_نمط(القيمة: &نمط): نمط {
    طابق *القيمة مع
    | نمط.بدل(ح0) -> { أرجع نمط.بدل(ح0); }
    | نمط.ربط(ح0, ح1) -> { أرجع نمط.ربط(ح0, ح1); }
    | نمط.حرفي(ح0, ح1) -> { أرجع نمط.حرفي(ح0, انسخ_مملوكا_حرفي(&ح1)); }
    | نمط.مدى(ح0, ح1, ح2) -> { أرجع نمط.مدى(ح0, انسخ_مملوكا_حد_مدى(&ح1), انسخ_مملوكا_حد_مدى(&ح2)); }
    | نمط.بدائل(ح0, ح1) -> { أرجع نمط.بدائل(ح0, انسخ_مملوكا_متجه_نمط(&ح1)); }
    | نمط.منشئ(ح0, ح1, ح2, ح3) -> { أرجع نمط.منشئ(ح0, ح1, ح2, انسخ_مملوكا_متجه_نمط(&ح3)); }
    | نمط.صف(ح0, ح1) -> { أرجع نمط.صف(ح0, انسخ_مملوكا_متجه_نمط(&ح1)); }
    | نمط.سجل(ح0, ح1) -> { أرجع نمط.سجل(ح0, انسخ_مملوكا_متجه_حقل_نمط(&ح1)); }
    | نمط.مستعار(ح0, ح1, ح2) -> { أرجع نمط.مستعار(ح0, انسخ_مملوكا_صندوق_نمط(&ح1), ح2); }
    | نمط.تسلسل(ح0, ح1, ح2, ح3) -> {
        أرجع نمط.تسلسل(
            ح0, انسخ_مملوكا_متجه_نمط(&ح1), انسخ_مملوكا_متجه_نمط(&ح2), انسخ_مملوكا_متجه_نمط(&ح3)
        );
    };
}

عام عرف انسخ_مملوكا_صندوق_نمط(القيمة: &صندوق نمط): صندوق نمط {
    ليكن الداخل: نمط = انسخ_مملوكا_نمط(&(*(*القيمة)));
    ليكن الصندوق: صندوق نمط = صندوق الداخل;
    أرجع الصندوق;
}

عام عرف انسخ_مملوكا_متجه_نمط(القيمة: &متجه نمط): متجه نمط {
    ليكن الناتج: متغير متجه نمط = [];
    احجز_سعة(الناتج, الطول(*القيمة) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_نمط(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_حقل_نمط(القيمة: &متجه حقل_نمط): متجه حقل_نمط {
    ليكن الناتج: متغير متجه حقل_نمط = [];
    احجز_سعة(الناتج, الطول(*القيمة) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_حقل_نمط(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حقل_نمط(القيمة: &حقل_نمط): حقل_نمط {
    ليكن الناتج: حقل_نمط = {
        الاسم: (*القيمة).الاسم,
        النمط: انسخ_مملوكا_نمط(&(*القيمة).النمط)
    };
    أرجع الناتج;
}

// A bound of a range pattern, which an open end leaves out.
عرف انسخ_مملوكا_حد_مدى(القيمة: &اختياري حرفي): اختياري حرفي {
    طابق *القيمة مع
    | اختياري.موجود(الحرفي) -> { أرجع اختياري.موجود(انسخ_مملوكا_حرفي(&الحرفي)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}
