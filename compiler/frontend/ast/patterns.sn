استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.ast.name;

عام نوع حقل_نمط = {
    الاسم: اسم,
    النمط: نمط
};

عام نوع نمط =
    | بدل بنوع نطاق
    | ربط بنوع (نطاق, اسم)
    | منشئ بنوع (
        نطاق,
        اسم,
        اسم,
        متجه نمط
    )
    | صف بنوع (نطاق, متجه نمط)
    | سجل بنوع (
        نطاق,
        متجه حقل_نمط
    )
;

// AST owns the source extent of syntactic patterns. Semantic consumers query
// this fact instead of reconstructing a second pattern-range rule.
عام عرف نطاق_نمط(النمط: &نمط): نطاق {
    دع القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.بدل(النطاق) -> { أرجع النطاق; }
    | نمط.ربط(النطاق, _) -> { أرجع النطاق; }
    | نمط.منشئ(النطاق, _, _, _) -> { أرجع النطاق; }
    | نمط.صف(النطاق, _) -> { أرجع النطاق; }
    | نمط.سجل(النطاق, _) -> { أرجع النطاق; };
}
