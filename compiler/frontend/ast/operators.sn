عام نوع عامل_ثنائي =
    | أو
    | و
    | أو_بتي
    | أو_حصري
    | و_بتي
    | يساوي
    | لا_يساوي
    | أصغر
    | أصغر_أو_يساوي
    | أكبر_أو_يساوي
    | أكبر
    | إزاحة_يسرى
    | إزاحة_يمنى
    | إزاحة_حسابية_يمنى
    | جمع
    | طرح
    | ضرب
    | قسمة
    | باقي
;

عام نوع عامل_أحادي =
    | نفي
    | متمم
    | سالب
    | فك
    | عنوان
    | عنوان_متغير
    // `EXPR؟` (docs/en/reference/errors.md): a parser marker on the right-hand side of a
    // let, an assignment, a return or an expression statement. The frontend
    // expansion (frontend/desugar/propagation.sn) replaces every such
    // statement before name resolution, so no later phase sees it.
    | انتشار
;
