عام نوع عامل_ثنائي =
    | أو
    | و
    | أو_بتي
    | أو_حصري
    | و_بتي
    | يساوي
    | لا_يساوي
    | أصغر
    | أصغر_أو_يساوي
    | أكبر_أو_يساوي
    | أكبر
    | إزاحة_يسرى
    | إزاحة_يمنى
    | إزاحة_حسابية_يمنى
    | جمع
    | طرح
    | ضرب
    | قسمة
    | باقي
;

عام نوع عامل_أحادي =
    | نفي
    | متمم
    | سالب
    | فك
    | عنوان
    | عنوان_متغير
    // `EXPR؟` (docs/en/reference/errors.md): a parser marker on the right-hand side of a
    // let, an assignment, a return or an expression statement. The frontend
    // expansion (frontend/desugar/propagation.sn) replaces every such
    // statement before name resolution, so no later phase sees it.
    | انتشار
;

// A binary operator as written in source (both surfaces spell it alike), for
// diagnostics that name it.
عام عرف نص_عامل_ثنائي(العامل: عامل_ثنائي): نص {
    طابق العامل مع
    | عامل_ثنائي.أو -> { أرجع «||»; }
    | عامل_ثنائي.و -> { أرجع «&&»; }
    | عامل_ثنائي.أو_بتي -> { أرجع «|»; }
    | عامل_ثنائي.أو_حصري -> { أرجع «^»; }
    | عامل_ثنائي.و_بتي -> { أرجع «&»; }
    | عامل_ثنائي.يساوي -> { أرجع «==»; }
    | عامل_ثنائي.لا_يساوي -> { أرجع «!=»; }
    | عامل_ثنائي.أصغر -> { أرجع «<»; }
    | عامل_ثنائي.أصغر_أو_يساوي -> { أرجع «<=»; }
    | عامل_ثنائي.أكبر_أو_يساوي -> { أرجع «>=»; }
    | عامل_ثنائي.أكبر -> { أرجع «>»; }
    | عامل_ثنائي.إزاحة_يسرى -> { أرجع «<<»; }
    | عامل_ثنائي.إزاحة_يمنى -> { أرجع «>>»; }
    | عامل_ثنائي.إزاحة_حسابية_يمنى -> { أرجع «>>>»; }
    | عامل_ثنائي.جمع -> { أرجع «+»; }
    | عامل_ثنائي.طرح -> { أرجع «-»; }
    | عامل_ثنائي.ضرب -> { أرجع «*»; }
    | عامل_ثنائي.قسمة -> { أرجع «/»; }
    | عامل_ثنائي.باقي -> { أرجع «%»; };
}
