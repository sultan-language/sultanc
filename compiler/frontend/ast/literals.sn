استورد std.text.from_bytes;
// نطاق الحرفي يملكه تعبير.حرفي فقط؛ القيم الحرفية نفسها خالية من بيانات source.
عام نوع حرفي =
    | منطقي بنوع منطقي
    | عدد بنوع عدد
    | عدد_طبيعي بنوع طبيعي
    | عدد_عشري بنوع متجه ط8
    | حرف بنوع ط32
    | نص بنوع متجه ط8
    | غير_معرف
;

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_حرفي(القيمة: &حرفي): حرفي {
    طابق *القيمة مع
    | حرفي.منطقي(ح0) -> { أرجع حرفي.منطقي(ح0); }
    | حرفي.عدد(ح0) -> { أرجع حرفي.عدد(ح0); }
    | حرفي.عدد_طبيعي(ح0) -> { أرجع حرفي.عدد_طبيعي(ح0); }
    | حرفي.عدد_عشري(ح0) -> { أرجع حرفي.عدد_عشري(انسخ_بايتات(&ح0)); }
    | حرفي.حرف(ح0) -> { أرجع حرفي.حرف(ح0); }
    | حرفي.نص(ح0) -> { أرجع حرفي.نص(انسخ_بايتات(&ح0)); }
    | حرفي.غير_معرف -> { أرجع حرفي.غير_معرف(); };
}
