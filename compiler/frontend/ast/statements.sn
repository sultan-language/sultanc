استورد compiler.frontend.ast.operators;
استورد compiler.frontend.ast.literals;
استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.patterns;

عام نوع حقل_تهيئة = {
    الاسم: اسم,
    القيمة: تعبير
};

// كتلة واحدة تملك نطاقها وعباراتها معا؛ لا توجد حالة نطاق/جسم متوازية.
عام نوع كتلة_عبارات = {
    النطاق: نطاق,
    العبارات: متجه صندوق عبارة
};

عام نوع ذراع_مطابقة = {
    النمط: نمط,
    الجسم: كتلة_عبارات
};

عام نوع عبارة =
    | تصريح_متغير بنوع (
        نطاق,
        اسم,
        نوع_تركيبي
    )
    | تهيئة_سجل بنوع (
        نطاق,
        تعبير,
        متجه حقل_تهيئة
    )
    | تهيئة_صف بنوع (
        نطاق,
        تعبير,
        متجه تعبير
    )
    | تهيئة_متجه بنوع (
        نطاق,
        تعبير,
        متجه تعبير
    )
    | تهيئة_نص بنوع (
        نطاق,
        تعبير,
        متجه غ8
    )
    | تهيئة_صندوق بنوع (
        نطاق,
        تعبير,
        تعبير
    )
    | نسخ بنوع (
        نطاق,
        تعبير,
        تعبير
    )
    | استدعاء بنوع (نطاق, تعبير)
    | بينما بنوع (
        نطاق,
        تعبير,
        كتلة_عبارات
    )
    | لكل بنوع (
        نطاق,
        متجه صندوق عبارة,
        تعبير,
        صندوق عبارة,
        كتلة_عبارات
    )
    | اخرج_من_حلقة بنوع نطاق
    | تابع_حلقة بنوع نطاق
    | لو بنوع (
        نطاق,
        تعبير,
        كتلة_عبارات,
        اختيار كتلة_عبارات
    )
    | طابق بنوع (
        نطاق,
        تعبير,
        متجه ذراع_مطابقة
    )
    | أرجع بنوع (نطاق, اختيار تعبير)
    | تجميع بنوع (نطاق, متجه غ8)
    | غير_آمن بنوع (
        نطاق,
        كتلة_عبارات
    )
;


عام عرف نطاق_عبارة(العبارة: &عبارة): نطاق {
    طابق *العبارة مع
    | عبارة.تصريح_متغير(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_سجل(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_صف(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_متجه(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_نص(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_صندوق(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.نسخ(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.استدعاء(النطاق, _) -> { أرجع النطاق; }
    | عبارة.بينما(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.لكل(النطاق, _, _, _, _) -> { أرجع النطاق; }
    | عبارة.اخرج_من_حلقة(النطاق) -> { أرجع النطاق; }
    | عبارة.تابع_حلقة(النطاق) -> { أرجع النطاق; }
    | عبارة.لو(النطاق, _, _, _) -> { أرجع النطاق; }
    | عبارة.طابق(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.أرجع(النطاق, _) -> { أرجع النطاق; }
    | عبارة.تجميع(النطاق, _) -> { أرجع النطاق; }
    | عبارة.غير_آمن(النطاق, _) -> { أرجع النطاق; };
}
