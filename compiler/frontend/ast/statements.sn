استورد std.text.from_bytes;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.ast.literals;
استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.patterns;

// كتلة واحدة تملك نطاقها وعباراتها معا؛ لا توجد حالة نطاق/جسم متوازية.
عام نوع كتلة_عبارات = {
    النطاق: نطاق,
    العبارات: متجه صندوق عبارة
};

عام نوع ذراع_مطابقة = {
    النمط: نمط,
    الجسم: كتلة_عبارات
};

عام نوع عبارة =
    | تصريح_متغير بنوع (
        نطاق,
        اسم,
        نوع_تركيبي
    )
    | تهيئة_سجل بنوع (
        نطاق,
        تعبير,
        متجه حقل_تهيئة
    )
    | تهيئة_صف بنوع (
        نطاق,
        تعبير,
        متجه تعبير
    )
    | تهيئة_متجه بنوع (
        نطاق,
        تعبير,
        متجه تعبير
    )
    | تهيئة_نص بنوع (
        نطاق,
        تعبير,
        متجه ط8
    )
    | تهيئة_صندوق بنوع (
        نطاق,
        تعبير,
        تعبير
    )
    | نسخ بنوع (
        نطاق,
        تعبير,
        تعبير
    )
    | استدعاء بنوع (نطاق, تعبير)
    | طالما بنوع (
        نطاق,
        تعبير,
        كتلة_عبارات
    )
    | لكل بنوع (
        نطاق,
        متجه صندوق عبارة,
        تعبير,
        صندوق عبارة,
        كتلة_عبارات
    )
    | اخرج_من_حلقة بنوع نطاق
    | تابع_حلقة بنوع نطاق
    | إذا بنوع (
        نطاق,
        تعبير,
        كتلة_عبارات,
        اختياري كتلة_عبارات
    )
    | طابق بنوع (
        نطاق,
        تعبير,
        متجه ذراع_مطابقة
    )
    | أرجع بنوع (نطاق, اختياري تعبير)
    | تجميع بنوع (نطاق, متجه ط8)
    | غير_آمن بنوع (
        نطاق,
        كتلة_عبارات
    )
    // A statement-form comptime block is lowered as an independent MSIR
    // function and discharged before any backend sees its call.
    | وقت_الترجمة بنوع (
        نطاق,
        كتلة_عبارات
    )
    // `place := comptime { statements; result };` (and the same as a `let`
    // initializer): the block and its result are lowered as an independent
    // MSIR function evaluated once at compile time; the place receives the
    // resulting constant. The block cannot capture runtime locals.
    | إسناد_وقت_الترجمة بنوع (
        نطاق,
        تعبير,
        كتلة_عبارات,
        تعبير
    )
;


عام عرف نطاق_عبارة(العبارة: &عبارة): نطاق {
    طابق *العبارة مع
    | عبارة.تصريح_متغير(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_سجل(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_صف(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_متجه(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_نص(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_صندوق(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.نسخ(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.استدعاء(النطاق, _) -> { أرجع النطاق; }
    | عبارة.طالما(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.لكل(النطاق, _, _, _, _) -> { أرجع النطاق; }
    | عبارة.اخرج_من_حلقة(النطاق) -> { أرجع النطاق; }
    | عبارة.تابع_حلقة(النطاق) -> { أرجع النطاق; }
    | عبارة.إذا(النطاق, _, _, _) -> { أرجع النطاق; }
    | عبارة.طابق(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.أرجع(النطاق, _) -> { أرجع النطاق; }
    | عبارة.تجميع(النطاق, _) -> { أرجع النطاق; }
    | عبارة.غير_آمن(النطاق, _) -> { أرجع النطاق; }
    | عبارة.وقت_الترجمة(النطاق, _) -> { أرجع النطاق; }
    | عبارة.إسناد_وقت_الترجمة(النطاق, _, _, _) -> { أرجع النطاق; };
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_كتلة_عبارات(القيمة: &كتلة_عبارات): كتلة_عبارات {
    دع الناتج: كتلة_عبارات = {
        النطاق: (*القيمة).النطاق,
        العبارات: انسخ_مملوكا_متجه_صندوق_عبارة(&(*القيمة).العبارات)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_عبارة(القيمة: &عبارة): عبارة {
    طابق *القيمة مع
    | عبارة.تصريح_متغير(ح0, ح1, ح2) -> { أرجع عبارة.تصريح_متغير(ح0, ح1, انسخ_مملوكا_نوع_تركيبي(&ح2)); }
    | عبارة.تهيئة_سجل(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_سجل(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_متجه_حقل_تهيئة(&ح2)); }
    | عبارة.تهيئة_صف(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_صف(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_متجه_تعبير(&ح2)); }
    | عبارة.تهيئة_متجه(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_متجه(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_متجه_تعبير(&ح2)); }
    | عبارة.تهيئة_نص(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_نص(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_بايتات(&ح2)); }
    | عبارة.تهيئة_صندوق(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_صندوق(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_تعبير(&ح2)); }
    | عبارة.نسخ(ح0, ح1, ح2) -> { أرجع عبارة.نسخ(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_تعبير(&ح2)); }
    | عبارة.استدعاء(ح0, ح1) -> { أرجع عبارة.استدعاء(ح0, انسخ_مملوكا_تعبير(&ح1)); }
    | عبارة.طالما(ح0, ح1, ح2) -> { أرجع عبارة.طالما(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_كتلة_عبارات(&ح2)); }
    | عبارة.لكل(ح0, ح1, ح2, ح3, ح4) -> { أرجع عبارة.لكل(ح0, انسخ_مملوكا_متجه_صندوق_عبارة(&ح1), انسخ_مملوكا_تعبير(&ح2), انسخ_مملوكا_صندوق_عبارة(&ح3), انسخ_مملوكا_كتلة_عبارات(&ح4)); }
    | عبارة.اخرج_من_حلقة(ح0) -> { أرجع عبارة.اخرج_من_حلقة(ح0); }
    | عبارة.تابع_حلقة(ح0) -> { أرجع عبارة.تابع_حلقة(ح0); }
    | عبارة.إذا(ح0, ح1, ح2, ح3) -> { أرجع عبارة.إذا(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_كتلة_عبارات(&ح2), انسخ_مملوكا_اختيار_كتلة_عبارات(&ح3)); }
    | عبارة.طابق(ح0, ح1, ح2) -> { أرجع عبارة.طابق(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_متجه_ذراع_مطابقة(&ح2)); }
    | عبارة.أرجع(ح0, ح1) -> { أرجع عبارة.أرجع(ح0, انسخ_مملوكا__اختيار_تعبير(&ح1)); }
    | عبارة.تجميع(ح0, ح1) -> { أرجع عبارة.تجميع(ح0, انسخ_بايتات(&ح1)); }
    | عبارة.غير_آمن(ح0, ح1) -> { أرجع عبارة.غير_آمن(ح0, انسخ_مملوكا_كتلة_عبارات(&ح1)); }
    | عبارة.وقت_الترجمة(ح0, ح1) -> { أرجع عبارة.وقت_الترجمة(ح0, انسخ_مملوكا_كتلة_عبارات(&ح1)); }
    | عبارة.إسناد_وقت_الترجمة(ح0, ح1, ح2, ح3) -> { أرجع عبارة.إسناد_وقت_الترجمة(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_كتلة_عبارات(&ح2), انسخ_مملوكا_تعبير(&ح3)); };
}

عام عرف انسخ_مملوكا_متجه_ذراع_مطابقة(القيمة: &متجه ذراع_مطابقة): متجه ذراع_مطابقة {
    دع الناتج: متغير متجه ذراع_مطابقة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_ذراع_مطابقة(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_ذراع_مطابقة(القيمة: &ذراع_مطابقة): ذراع_مطابقة {
    دع الناتج: ذراع_مطابقة = {
        النمط: انسخ_مملوكا_نمط(&(*القيمة).النمط),
        الجسم: انسخ_مملوكا_كتلة_عبارات(&(*القيمة).الجسم)
    };
    أرجع الناتج;
}

عرف انسخ_مملوكا__اختيار_تعبير(القيمة: &اختياري تعبير): اختياري تعبير {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(انسخ_مملوكا_تعبير(&الداخل)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف انسخ_مملوكا_صندوق_عبارة(القيمة: &صندوق عبارة): صندوق عبارة {
    دع الداخل: عبارة = انسخ_مملوكا_عبارة(&(*(*القيمة)));
    دع الصندوق: صندوق عبارة = صندوق الداخل;
    أرجع الصندوق;
}

عام عرف انسخ_مملوكا_متجه_صندوق_عبارة(القيمة: &متجه صندوق عبارة): متجه صندوق عبارة {
    دع الناتج: متغير متجه صندوق عبارة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_صندوق_عبارة(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_اختيار_كتلة_عبارات(القيمة: &اختياري كتلة_عبارات): اختياري كتلة_عبارات {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(انسخ_مملوكا_كتلة_عبارات(&الداخل)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}
