استورد المكتبة.نصوص.من_بايتات;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.ast.literals;
استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.patterns;

// The expression AST lives here, with the statements: a match expression
// (تعبير.مطابقة) holds statement arms, and modules cannot import each other.
عام نوع معامل_إغلاق = {
    الاسم: اسم,
    النوع: نوع_تركيبي,
    النطاق: نطاق
};

عام نوع حقل_تهيئة = {
    الاسم: اسم,
    القيمة: تعبير
};

// المواضع القابلة للإسناد ممثلة كتعبيرات نحوية، والتحقق الدلالي يأتي لاحقا.
عام نوع تعبير =
    | حرفي بنوع (نطاق, حرفي)
    | اسم بنوع (نطاق, اسم)
    | حقل بنوع (
        نطاق,
        صندوق تعبير,
        اسم
    )
    | فهرس بنوع (
        نطاق,
        صندوق تعبير,
        صندوق تعبير
    )
    // `v[a..b]`: the elements a through b of a vector or slice, both ends
    // included, as a slice that views them (no copy). Not a place. An open
    // end is absent: `v[a..]` (to the end), `v[..b]` (from the start), `v[..]`.
    | مقطع بنوع (
        نطاق,
        صندوق تعبير,
        اختياري صندوق تعبير,
        اختياري صندوق تعبير
    )
    | فك_موضع بنوع (نطاق, صندوق تعبير)
    | ثنائي بنوع (
        نطاق,
        عامل_ثنائي,
        صندوق تعبير,
        صندوق تعبير
    )
    | أحادي بنوع (
        نطاق,
        عامل_أحادي,
        صندوق تعبير
    )
    | استدعاء بنوع (
        نطاق,
        صندوق تعبير,
        متجه تعبير
    )
    // The target and result Types of a cast and a closure are boxed: a
    // written Type is the largest AST payload (72 bytes), and inline it sized
    // every expression node; boxed, a node is 64 bytes instead of 128.
    | تحويل بنوع (
        نطاق,
        صندوق تعبير,
        صندوق نوع_تركيبي
    )
    | وقت_الترجمة بنوع (نطاق, صندوق تعبير)
    // An expression block evaluates each member in order; its last member
    // supplies the value. Statements/locals keep their ordinary AST owner.
    | تسلسل_وقت_الترجمة بنوع (نطاق, متجه تعبير)
    | إغلاق بنوع (
        نطاق,
        متجه معامل_إغلاق,
        صندوق نوع_تركيبي,
        صندوق تعبير
    )
    // A vector literal used as an expression (an argument, a returned value,
    // a field, an element): an owned temporary vector whose elements are
    // moved in, typed by its context. `let v: T = [..];` stays the
    // initializer statement (تهيئة_متجه).
    | حرفي_متجه بنوع (نطاق, متجه تعبير)
    // A record literal used as an expression (`f({a: 1, b: 2})`, `return
    // {..}`, `x := {..}`): a fresh owned record typed by its context, its
    // field values moved in. `let r: T = {..};` stays تهيئة_سجل.
    | حرفي_سجل بنوع (نطاق, متجه حقل_تهيئة)
    // A tuple literal used as an expression (`return (a, b);`, `f((1, 2))`):
    // a fresh owned tuple whose elements are moved in, typed by its context
    // or by its elements. `let p: T = (..);` stays تهيئة_صف.
    | حرفي_صف بنوع (نطاق, متجه تعبير)
    // `f<A, B>(..)`: the callee of a call with explicit type arguments. Its
    // span is the wrapped callee's own, so span-keyed facts about the callee
    // (its Symbol, its Type) are found through either.
    | حجج_نوع بنوع (نطاق, صندوق تعبير, متجه نوع_تركيبي)
    // `match e with | p -> v ...` used as an expression: its value is the
    // value of the arm that matches (مطابقة_تعبيرية). Boxed, so that an
    // expression node keeps its size.
    | مطابقة بنوع (نطاق, صندوق مطابقة_تعبيرية)
;

// كتلة واحدة تملك نطاقها وعباراتها معا؛ لا توجد حالة نطاق/جسم متوازية.
عام نوع كتلة_عبارات = {
    النطاق: نطاق,
    العبارات: متجه صندوق عبارة
};

عام نوع ذراع_مطابقة = {
    النمط: نمط,
    // The arm's guard (`| pattern if condition -> { … }`): the arm is chosen
    // only when the pattern matches and the condition, which sees the
    // pattern's bindings, holds.
    الحارس: اختياري تعبير,
    الجسم: كتلة_عبارات,
    // The Type written in a tuple `let` (`let (a, b): (A, B) = e;`), which
    // the parser reads as the match `match e with | (a, b) -> { the rest of
    // the block }` whose only arm carries it: each name gets its element.
    // Absent for every arm written in a match.
    نوع_ليكن: اختياري نوع_تركيبي
};

عام نوع عبارة =
    | تصريح_متغير بنوع (
        نطاق,
        اسم,
        نوع_تركيبي
    )
    | تهيئة_سجل بنوع (
        نطاق,
        تعبير,
        متجه حقل_تهيئة
    )
    | تهيئة_صف بنوع (
        نطاق,
        تعبير,
        متجه تعبير
    )
    | تهيئة_متجه بنوع (
        نطاق,
        تعبير,
        متجه تعبير
    )
    | تهيئة_نص بنوع (
        نطاق,
        تعبير,
        متجه ط8
    )
    | تهيئة_صندوق بنوع (
        نطاق,
        تعبير,
        تعبير
    )
    | نسخ بنوع (
        نطاق,
        تعبير,
        تعبير
    )
    | استدعاء بنوع (نطاق, تعبير)
    | طالما بنوع (
        نطاق,
        تعبير,
        كتلة_عبارات
    )
    | لكل بنوع (
        نطاق,
        متجه صندوق عبارة,
        تعبير,
        صندوق عبارة,
        كتلة_عبارات
    )
    | اخرج_من_حلقة بنوع نطاق
    | تابع_حلقة بنوع نطاق
    | إذا بنوع (
        نطاق,
        تعبير,
        كتلة_عبارات,
        اختياري كتلة_عبارات
    )
    | طابق بنوع (
        نطاق,
        تعبير,
        متجه ذراع_مطابقة
    )
    | أرجع بنوع (نطاق, اختياري تعبير)
    | تجميع بنوع (نطاق, متجه ط8)
    | غير_آمن بنوع (
        نطاق,
        كتلة_عبارات
    )
    // A statement-form comptime block is lowered as an independent MSIR
    // function and discharged before any backend sees its call.
    | وقت_الترجمة بنوع (
        نطاق,
        كتلة_عبارات
    )
    // `place := comptime { statements; result };` (and the same as a `let`
    // initializer): the block and its result are lowered as an independent
    // MSIR function evaluated once at compile time; the place receives the
    // resulting constant. The block cannot capture runtime locals.
    | إسناد_وقت_الترجمة بنوع (
        نطاق,
        تعبير,
        كتلة_عبارات,
        تعبير
    )
;

// A match expression (docs/en/book/ch06-02-match.md, "A match that gives a
// value"). Its arms are the statement form's own (ذراع_مطابقة): the pattern
// and a body. القيم holds, per arm, the expression that gives the match its
// value once the body has run: `| p -> v` is an empty body (spanning v) with
// the value v, `| p -> { s; v }` the body `s` with the value v. An arm
// without a value (`| p -> { s; }`) must not finish: its body returns, leaves
// or continues a loop, or panics.
عام نوع مطابقة_تعبيرية = {
    المميز: تعبير,
    الأذرع: متجه ذراع_مطابقة,
    القيم: متجه اختياري تعبير,
    // Written as `if (c) a else b` (parser/statements.sn, حلل_إذا_تعبيرية):
    // its diagnostics speak of the `if` and its branches.
    من_إذا: منطقي
};

عام عرف نطاق_عبارة(العبارة: &عبارة): نطاق {
    طابق *العبارة مع
    | عبارة.تصريح_متغير(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_سجل(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_صف(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_متجه(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_نص(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.تهيئة_صندوق(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.نسخ(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.استدعاء(النطاق, _) -> { أرجع النطاق; }
    | عبارة.طالما(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.لكل(النطاق, _, _, _, _) -> { أرجع النطاق; }
    | عبارة.اخرج_من_حلقة(النطاق) -> { أرجع النطاق; }
    | عبارة.تابع_حلقة(النطاق) -> { أرجع النطاق; }
    | عبارة.إذا(النطاق, _, _, _) -> { أرجع النطاق; }
    | عبارة.طابق(النطاق, _, _) -> { أرجع النطاق; }
    | عبارة.أرجع(النطاق, _) -> { أرجع النطاق; }
    | عبارة.تجميع(النطاق, _) -> { أرجع النطاق; }
    | عبارة.غير_آمن(النطاق, _) -> { أرجع النطاق; }
    | عبارة.وقت_الترجمة(النطاق, _) -> { أرجع النطاق; }
    | عبارة.إسناد_وقت_الترجمة(النطاق, _, _, _) -> { أرجع النطاق; };
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_كتلة_عبارات(القيمة: &كتلة_عبارات): كتلة_عبارات {
    ليكن الناتج: كتلة_عبارات = {
        النطاق: (*القيمة).النطاق,
        العبارات: انسخ_مملوكا_متجه_صندوق_عبارة(&(*القيمة).العبارات)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_عبارة(القيمة: &عبارة): عبارة {
    طابق *القيمة مع
    | عبارة.تصريح_متغير(ح0, ح1, ح2) -> { أرجع عبارة.تصريح_متغير(ح0, ح1, انسخ_مملوكا_نوع_تركيبي(&ح2)); }
    | عبارة.تهيئة_سجل(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_سجل(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_متجه_حقل_تهيئة(&ح2)); }
    | عبارة.تهيئة_صف(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_صف(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_متجه_تعبير(&ح2)); }
    | عبارة.تهيئة_متجه(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_متجه(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_متجه_تعبير(&ح2)); }
    | عبارة.تهيئة_نص(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_نص(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_بايتات(&ح2)); }
    | عبارة.تهيئة_صندوق(ح0, ح1, ح2) -> { أرجع عبارة.تهيئة_صندوق(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_تعبير(&ح2)); }
    | عبارة.نسخ(ح0, ح1, ح2) -> { أرجع عبارة.نسخ(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_تعبير(&ح2)); }
    | عبارة.استدعاء(ح0, ح1) -> { أرجع عبارة.استدعاء(ح0, انسخ_مملوكا_تعبير(&ح1)); }
    | عبارة.طالما(ح0, ح1, ح2) -> { أرجع عبارة.طالما(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_كتلة_عبارات(&ح2)); }
    | عبارة.لكل(ح0, ح1, ح2, ح3, ح4) -> { أرجع عبارة.لكل(ح0, انسخ_مملوكا_متجه_صندوق_عبارة(&ح1), انسخ_مملوكا_تعبير(&ح2), انسخ_مملوكا_صندوق_عبارة(&ح3), انسخ_مملوكا_كتلة_عبارات(&ح4)); }
    | عبارة.اخرج_من_حلقة(ح0) -> { أرجع عبارة.اخرج_من_حلقة(ح0); }
    | عبارة.تابع_حلقة(ح0) -> { أرجع عبارة.تابع_حلقة(ح0); }
    | عبارة.إذا(ح0, ح1, ح2, ح3) -> { أرجع عبارة.إذا(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_كتلة_عبارات(&ح2), انسخ_مملوكا_اختيار_كتلة_عبارات(&ح3)); }
    | عبارة.طابق(ح0, ح1, ح2) -> { أرجع عبارة.طابق(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_متجه_ذراع_مطابقة(&ح2)); }
    | عبارة.أرجع(ح0, ح1) -> { أرجع عبارة.أرجع(ح0, انسخ_مملوكا__اختيار_تعبير(&ح1)); }
    | عبارة.تجميع(ح0, ح1) -> { أرجع عبارة.تجميع(ح0, انسخ_بايتات(&ح1)); }
    | عبارة.غير_آمن(ح0, ح1) -> { أرجع عبارة.غير_آمن(ح0, انسخ_مملوكا_كتلة_عبارات(&ح1)); }
    | عبارة.وقت_الترجمة(ح0, ح1) -> { أرجع عبارة.وقت_الترجمة(ح0, انسخ_مملوكا_كتلة_عبارات(&ح1)); }
    | عبارة.إسناد_وقت_الترجمة(ح0, ح1, ح2, ح3) -> { أرجع عبارة.إسناد_وقت_الترجمة(ح0, انسخ_مملوكا_تعبير(&ح1), انسخ_مملوكا_كتلة_عبارات(&ح2), انسخ_مملوكا_تعبير(&ح3)); };
}

عام عرف انسخ_مملوكا_متجه_ذراع_مطابقة(القيمة: &متجه ذراع_مطابقة): متجه ذراع_مطابقة {
    ليكن الناتج: متغير متجه ذراع_مطابقة = [];
    احجز_سعة(الناتج, الطول(*القيمة) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_ذراع_مطابقة(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_ذراع_مطابقة(القيمة: &ذراع_مطابقة): ذراع_مطابقة {
    ليكن الناتج: ذراع_مطابقة = {
        النمط: انسخ_مملوكا_نمط(&(*القيمة).النمط),
        الحارس: انسخ_مملوكا__اختيار_تعبير(&(*القيمة).الحارس),
        الجسم: انسخ_مملوكا_كتلة_عبارات(&(*القيمة).الجسم),
        نوع_ليكن: انسخ_مملوكا_نوع_ليكن_ذراع(القيمة)
    };
    أرجع الناتج;
}

// The Type a tuple `let` wrote for an arm (ذراع_مطابقة.نوع_ليكن), copied.
عام عرف انسخ_مملوكا_نوع_ليكن_ذراع(الذراع: &ذراع_مطابقة): اختياري نوع_تركيبي {
    طابق (*الذراع).نوع_ليكن مع
    | اختياري.موجود(النوع) -> { أرجع اختياري.موجود(انسخ_مملوكا_نوع_تركيبي(&النوع)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// A copy of an arm's guard.
عام عرف انسخ_مملوكا_حارس_ذراع(الذراع: &ذراع_مطابقة): اختياري تعبير {
    أرجع انسخ_مملوكا__اختيار_تعبير(&(*الذراع).الحارس);
}

عرف انسخ_مملوكا__اختيار_تعبير(القيمة: &اختياري تعبير): اختياري تعبير {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(انسخ_مملوكا_تعبير(&الداخل)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف انسخ_مملوكا_صندوق_عبارة(القيمة: &صندوق عبارة): صندوق عبارة {
    ليكن الداخل: عبارة = انسخ_مملوكا_عبارة(&(*(*القيمة)));
    ليكن الصندوق: صندوق عبارة = صندوق الداخل;
    أرجع الصندوق;
}

عام عرف انسخ_مملوكا_متجه_صندوق_عبارة(القيمة: &متجه صندوق عبارة): متجه صندوق عبارة {
    ليكن الناتج: متغير متجه صندوق عبارة = [];
    احجز_سعة(الناتج, الطول(*القيمة) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_صندوق_عبارة(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_اختيار_كتلة_عبارات(القيمة: &اختياري كتلة_عبارات): اختياري كتلة_عبارات {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(انسخ_مملوكا_كتلة_عبارات(&الداخل)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف نطاق_تعبير(القيمة: &تعبير): نطاق {
    طابق *القيمة مع
    | تعبير.حرفي(س, ح) -> {
        أرجع س;
    }
    | تعبير.اسم(س, ا) -> {
        أرجع س;
    }
    | تعبير.حقل(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.فهرس(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.مقطع(س, _, _, _) -> { أرجع س; }
    | تعبير.فك_موضع(س, أ) -> {
        أرجع س;
    }
    | تعبير.ثنائي(س, ع, أ, ب) -> {
        أرجع س;
    }
    | تعبير.أحادي(س, ع, أ) -> {
        أرجع س;
    }
    | تعبير.استدعاء(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.تحويل(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.وقت_الترجمة(س, _) -> { أرجع س; }
    | تعبير.تسلسل_وقت_الترجمة(س, _) -> { أرجع س; }
    | تعبير.إغلاق(س, م, ن, ج) -> {
        أرجع س;
    }
    | تعبير.حرفي_متجه(س, _) -> { أرجع س; }
    | تعبير.حرفي_سجل(س, _) -> { أرجع س; }
    | تعبير.حرفي_صف(س, _) -> { أرجع س; }
    | تعبير.حجج_نوع(س, _, _) -> { أرجع س; }
    | تعبير.مطابقة(س, _) -> { أرجع س; };
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_تعبير(القيمة: &تعبير): تعبير {
    طابق *القيمة مع
    | تعبير.حرفي(ح0, ح1) -> { أرجع تعبير.حرفي(ح0, انسخ_مملوكا_حرفي(&ح1)); }
    | تعبير.اسم(ح0, ح1) -> { أرجع تعبير.اسم(ح0, ح1); }
    | تعبير.حقل(ح0, ح1, ح2) -> { أرجع تعبير.حقل(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), ح2); }
    | تعبير.فهرس(ح0, ح1, ح2) -> { أرجع تعبير.فهرس(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), انسخ_مملوكا__صندوق_تعبير(&ح2)); }
    | تعبير.مقطع(ح0, ح1, ح2, ح3) -> { أرجع تعبير.مقطع(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), انسخ_مملوكا_حد_مقطع(&ح2), انسخ_مملوكا_حد_مقطع(&ح3)); }
    | تعبير.فك_موضع(ح0, ح1) -> { أرجع تعبير.فك_موضع(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1)); }
    | تعبير.ثنائي(ح0, ح1, ح2, ح3) -> { أرجع تعبير.ثنائي(ح0, ح1, انسخ_مملوكا__صندوق_تعبير(&ح2), انسخ_مملوكا__صندوق_تعبير(&ح3)); }
    | تعبير.أحادي(ح0, ح1, ح2) -> { أرجع تعبير.أحادي(ح0, ح1, انسخ_مملوكا__صندوق_تعبير(&ح2)); }
    | تعبير.استدعاء(ح0, ح1, ح2) -> { أرجع تعبير.استدعاء(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), انسخ_مملوكا_متجه_تعبير(&ح2)); }
    | تعبير.تحويل(ح0, ح1, ح2) -> { أرجع تعبير.تحويل(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), انسخ_مملوكا__صندوق_نوع_تركيبي(&ح2)); }
    | تعبير.وقت_الترجمة(ح0, ح1) -> { أرجع تعبير.وقت_الترجمة(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1)); }
    | تعبير.تسلسل_وقت_الترجمة(ح0, ح1) -> { أرجع تعبير.تسلسل_وقت_الترجمة(ح0, انسخ_مملوكا_متجه_تعبير(&ح1)); }
    | تعبير.إغلاق(ح0, ح1, ح2, ح3) -> { أرجع تعبير.إغلاق(ح0, انسخ_مملوكا_متجه_معامل_إغلاق(&ح1), انسخ_مملوكا__صندوق_نوع_تركيبي(&ح2), انسخ_مملوكا__صندوق_تعبير(&ح3)); }
    | تعبير.حرفي_متجه(ح0, ح1) -> { أرجع تعبير.حرفي_متجه(ح0, انسخ_مملوكا_متجه_تعبير(&ح1)); }
    | تعبير.حرفي_سجل(ح0, ح1) -> { أرجع تعبير.حرفي_سجل(ح0, انسخ_مملوكا_متجه_حقل_تهيئة(&ح1)); }
    | تعبير.حرفي_صف(ح0, ح1) -> { أرجع تعبير.حرفي_صف(ح0, انسخ_مملوكا_متجه_تعبير(&ح1)); }
    | تعبير.حجج_نوع(ح0, ح1, ح2) -> { أرجع تعبير.حجج_نوع(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), انسخ_مملوكا_متجه_نوع_تركيبي(&ح2)); }
    | تعبير.مطابقة(ح0, ح1) -> { أرجع تعبير.مطابقة(ح0, انسخ_مملوكا_صندوق_مطابقة_تعبيرية(&ح1)); };
}

عرف انسخ_مملوكا__صندوق_تعبير(القيمة: &صندوق تعبير): صندوق تعبير {
    ليكن الداخل: تعبير = انسخ_مملوكا_تعبير(&(*(*القيمة)));
    ليكن الصندوق: صندوق تعبير = صندوق الداخل;
    أرجع الصندوق;
}

عرف انسخ_مملوكا__صندوق_نوع_تركيبي(القيمة: &صندوق نوع_تركيبي): صندوق نوع_تركيبي {
    ليكن الداخل: نوع_تركيبي = انسخ_مملوكا_نوع_تركيبي(&(*(*القيمة)));
    ليكن الصندوق: صندوق نوع_تركيبي = صندوق الداخل;
    أرجع الصندوق;
}

// A bound of a slice, which an open end leaves out.
عام عرف انسخ_مملوكا_حد_مقطع(القيمة: &اختياري صندوق تعبير): اختياري صندوق تعبير {
    طابق *القيمة مع
    | اختياري.موجود(الحد) -> { أرجع اختياري.موجود(انسخ_مملوكا__صندوق_تعبير(&الحد)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// The bounds a slice writes (none, one or two), as owned copies, for passes
// that only walk the expressions inside it.
عام عرف حدود_مقطع(الأدنى: &اختياري صندوق تعبير, الأعلى: &اختياري صندوق تعبير): متجه تعبير {
    ليكن الناتج: متغير متجه تعبير = [];
    طابق *الأدنى مع
    | اختياري.موجود(الحد) -> { ألحق(الناتج, انسخ_مملوكا_تعبير(&(*الحد))); }
    | اختياري.لا_شيء -> { };
    طابق *الأعلى مع
    | اختياري.موجود(الحد) -> { ألحق(الناتج, انسخ_مملوكا_تعبير(&(*الحد))); }
    | اختياري.لا_شيء -> { };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_تعبير(القيمة: &متجه تعبير): متجه تعبير {
    ليكن الناتج: متغير متجه تعبير = [];
    احجز_سعة(الناتج, الطول(*القيمة) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_تعبير(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_معامل_إغلاق(القيمة: &متجه معامل_إغلاق): متجه معامل_إغلاق {
    ليكن الناتج: متغير متجه معامل_إغلاق = [];
    احجز_سعة(الناتج, الطول(*القيمة) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_معامل_إغلاق(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_معامل_إغلاق(القيمة: &معامل_إغلاق): معامل_إغلاق {
    ليكن الناتج: معامل_إغلاق = {
        الاسم: (*القيمة).الاسم,
        النوع: انسخ_مملوكا_نوع_تركيبي(&(*القيمة).النوع),
        النطاق: (*القيمة).النطاق
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_حقل_تهيئة(القيمة: &متجه حقل_تهيئة): متجه حقل_تهيئة {
    ليكن الناتج: متغير متجه حقل_تهيئة = [];
    احجز_سعة(الناتج, الطول(*القيمة) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_حقل_تهيئة(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حقل_تهيئة(القيمة: &حقل_تهيئة): حقل_تهيئة {
    ليكن الناتج: حقل_تهيئة = {
        الاسم: (*القيمة).الاسم,
        القيمة: انسخ_مملوكا_تعبير(&(*القيمة).القيمة)
    };
    أرجع الناتج;
}

// The callee a call invokes, without explicit type arguments (an owned copy;
// a callee is a name or a qualified name).
عام عرف مستدعى_بلا_حجج_نوع(القيمة: &تعبير): تعبير {
    طابق *القيمة مع
    | تعبير.حجج_نوع(_, الداخل, _) -> { أرجع انسخ_مملوكا_تعبير(&(*الداخل)); }
    | _ -> { أرجع انسخ_مملوكا_تعبير(القيمة); };
}

عام عرف انسخ_مملوكا_مطابقة_تعبيرية(القيمة: &مطابقة_تعبيرية): مطابقة_تعبيرية {
    ليكن القيم: متغير متجه اختياري تعبير = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة).القيم) مثل طبيعي)) {
        ألحق(القيم, انسخ_مملوكا__اختيار_تعبير(&(*القيمة).القيم[ف]));
        ف := ف + 1;
    }
    ليكن الناتج: مطابقة_تعبيرية = {
        المميز: انسخ_مملوكا_تعبير(&(*القيمة).المميز),
        الأذرع: انسخ_مملوكا_متجه_ذراع_مطابقة(&(*القيمة).الأذرع),
        القيم: القيم,
        من_إذا: (*القيمة).من_إذا
    };
    أرجع الناتج;
}

عرف انسخ_مملوكا_صندوق_مطابقة_تعبيرية(القيمة: &صندوق مطابقة_تعبيرية): صندوق مطابقة_تعبيرية {
    ليكن الداخل: مطابقة_تعبيرية = انسخ_مملوكا_مطابقة_تعبيرية(&(*(*القيمة)));
    ليكن الصندوق: صندوق مطابقة_تعبيرية = صندوق الداخل;
    أرجع الصندوق;
}

// The match expressions (تعبير.مطابقة) an expression holds, each as an owned
// copy, outermost first: one inside another's scrutinee, arm or value is not
// listed (the enclosing one is, and holds it). With الإغلاقات, those in the
// bodies of closures too. Passes that walk statements visit through it the
// arms a match expression holds.
عام عرف اجمع_مطابقات_تعبير(التعبير: &تعبير, الإغلاقات: منطقي, الناتج: &متغير متجه تعبير): فراغ {
    طابق *التعبير مع
    | تعبير.مطابقة(_, _) -> { ألحق(*الناتج, انسخ_مملوكا_تعبير(التعبير)); }
    | تعبير.حقل(_, الأساس, _) -> { اجمع_مطابقات_تعبير(&(*الأساس), الإغلاقات, الناتج); }
    | تعبير.فهرس(_, الأساس, الفهرس) -> {
        اجمع_مطابقات_تعبير(&(*الأساس), الإغلاقات, الناتج);
        اجمع_مطابقات_تعبير(&(*الفهرس), الإغلاقات, الناتج);
    }
    | تعبير.مقطع(_, الأساس, الأدنى, الأعلى) -> {
        اجمع_مطابقات_تعبير(&(*الأساس), الإغلاقات, الناتج);
        ليكن الحدود: متجه تعبير = حدود_مقطع(&الأدنى, &الأعلى);
        اجمع_مطابقات_متجه_تعبير(&الحدود, الإغلاقات, الناتج);
    }
    | تعبير.فك_موضع(_, الداخل) -> { اجمع_مطابقات_تعبير(&(*الداخل), الإغلاقات, الناتج); }
    | تعبير.ثنائي(_, _, اليسار, اليمين) -> {
        اجمع_مطابقات_تعبير(&(*اليسار), الإغلاقات, الناتج);
        اجمع_مطابقات_تعبير(&(*اليمين), الإغلاقات, الناتج);
    }
    | تعبير.أحادي(_, _, الداخل) -> { اجمع_مطابقات_تعبير(&(*الداخل), الإغلاقات, الناتج); }
    | تعبير.استدعاء(_, المستدعى, الحجج) -> {
        اجمع_مطابقات_تعبير(&(*المستدعى), الإغلاقات, الناتج);
        اجمع_مطابقات_متجه_تعبير(&الحجج, الإغلاقات, الناتج);
    }
    | تعبير.تحويل(_, الداخل, _) -> { اجمع_مطابقات_تعبير(&(*الداخل), الإغلاقات, الناتج); }
    | تعبير.وقت_الترجمة(_, الداخل) -> { اجمع_مطابقات_تعبير(&(*الداخل), الإغلاقات, الناتج); }
    | تعبير.تسلسل_وقت_الترجمة(_, الأعضاء) -> { اجمع_مطابقات_متجه_تعبير(&الأعضاء, الإغلاقات, الناتج); }
    | تعبير.إغلاق(_, _, _, الجسم) -> {
        إذا (الإغلاقات) { اجمع_مطابقات_تعبير(&(*الجسم), الإغلاقات, الناتج); };
    }
    | تعبير.حرفي_متجه(_, العناصر) -> { اجمع_مطابقات_متجه_تعبير(&العناصر, الإغلاقات, الناتج); }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            اجمع_مطابقات_تعبير(&الحقول[ف].القيمة, الإغلاقات, الناتج);
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_صف(_, العناصر) -> { اجمع_مطابقات_متجه_تعبير(&العناصر, الإغلاقات, الناتج); }
    | تعبير.حجج_نوع(_, الداخل, _) -> { اجمع_مطابقات_تعبير(&(*الداخل), الإغلاقات, الناتج); }
    | _ -> { };
}

عام عرف اجمع_مطابقات_متجه_تعبير(القيم: &متجه تعبير, الإغلاقات: منطقي, الناتج: &متغير متجه تعبير): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        اجمع_مطابقات_تعبير(&(*القيم)[ف], الإغلاقات, الناتج);
        ف := ف + 1;
    }
}

// The match expressions in the statement's own expressions (not in the
// blocks it holds, which are statements of their own), as
// اجمع_مطابقات_تعبير lists them.
عام عرف مطابقات_تعبيرية_عبارة(العبارة: &عبارة, الإغلاقات: منطقي): متجه تعبير {
    ليكن الناتج: متغير متجه تعبير = [];
    طابق *العبارة مع
    | عبارة.تهيئة_سجل(_, الوجهة, الحقول) -> {
        اجمع_مطابقات_تعبير(&الوجهة, الإغلاقات, &متغير الناتج);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            اجمع_مطابقات_تعبير(&الحقول[ف].القيمة, الإغلاقات, &متغير الناتج);
            ف := ف + 1;
        }
    }
    | عبارة.تهيئة_صف(_, الوجهة, العناصر) -> {
        اجمع_مطابقات_تعبير(&الوجهة, الإغلاقات, &متغير الناتج);
        اجمع_مطابقات_متجه_تعبير(&العناصر, الإغلاقات, &متغير الناتج);
    }
    | عبارة.تهيئة_متجه(_, الوجهة, العناصر) -> {
        اجمع_مطابقات_تعبير(&الوجهة, الإغلاقات, &متغير الناتج);
        اجمع_مطابقات_متجه_تعبير(&العناصر, الإغلاقات, &متغير الناتج);
    }
    | عبارة.تهيئة_نص(_, الوجهة, _) -> { اجمع_مطابقات_تعبير(&الوجهة, الإغلاقات, &متغير الناتج); }
    | عبارة.تهيئة_صندوق(_, الوجهة, الحمولة) -> {
        اجمع_مطابقات_تعبير(&الوجهة, الإغلاقات, &متغير الناتج);
        اجمع_مطابقات_تعبير(&الحمولة, الإغلاقات, &متغير الناتج);
    }
    | عبارة.نسخ(_, الوجهة, المصدر) -> {
        اجمع_مطابقات_تعبير(&الوجهة, الإغلاقات, &متغير الناتج);
        اجمع_مطابقات_تعبير(&المصدر, الإغلاقات, &متغير الناتج);
    }
    | عبارة.استدعاء(_, التعبير) -> { اجمع_مطابقات_تعبير(&التعبير, الإغلاقات, &متغير الناتج); }
    | عبارة.طالما(_, الشرط, _) -> { اجمع_مطابقات_تعبير(&الشرط, الإغلاقات, &متغير الناتج); }
    | عبارة.لكل(_, _, الشرط, _, _) -> { اجمع_مطابقات_تعبير(&الشرط, الإغلاقات, &متغير الناتج); }
    | عبارة.إذا(_, الشرط, _, _) -> { اجمع_مطابقات_تعبير(&الشرط, الإغلاقات, &متغير الناتج); }
    | عبارة.طابق(_, المميز, الأذرع) -> {
        اجمع_مطابقات_تعبير(&المميز, الإغلاقات, &متغير الناتج);
        اجمع_مطابقات_حراس(&الأذرع, الإغلاقات, &متغير الناتج);
    }
    | عبارة.أرجع(_, القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(التعبير) -> { اجمع_مطابقات_تعبير(&التعبير, الإغلاقات, &متغير الناتج); }
        | اختياري.لا_شيء -> { };
    }
    | عبارة.إسناد_وقت_الترجمة(_, الوجهة, _, الناتج_النهائي) -> {
        اجمع_مطابقات_تعبير(&الوجهة, الإغلاقات, &متغير الناتج);
        اجمع_مطابقات_تعبير(&الناتج_النهائي, الإغلاقات, &متغير الناتج);
    }
    | _ -> { };
    أرجع الناتج;
}

// Whether the statement's own expressions hold a match expression (outside
// closures when !الإغلاقات).
عام عرف عبارة_تحوي_مطابقة_تعبيرية(العبارة: &عبارة, الإغلاقات: منطقي): منطقي {
    ليكن الموجودة: متجه تعبير = مطابقات_تعبيرية_عبارة(العبارة, الإغلاقات);
    أرجع (الطول(الموجودة) مثل طبيعي) > 0;
}

// A block of the statements an arm of a match expression runs: its body, and
// its value as the expression statement (عبارة.استدعاء) it is. Passes that
// only walk statements (names, references, captures) visit an arm through
// it.
عام عرف كتلة_ذراع_مطابقة_تعبيرية(المطابقة: &مطابقة_تعبيرية, الفهرس: طبيعي): كتلة_عبارات {
    ليكن الكتلة: متغير كتلة_عبارات = انسخ_مملوكا_كتلة_عبارات(&(*المطابقة).الأذرع[الفهرس].الجسم);
    طابق (*المطابقة).القيم[الفهرس] مع
    | اختياري.موجود(القيمة) -> {
        ليكن العبارة: عبارة = عبارة.استدعاء(نطاق_تعبير(&القيمة), انسخ_مملوكا_تعبير(&القيمة));
        ليكن الصندوق: صندوق عبارة = صندوق العبارة;
        ألحق(الكتلة.العبارات, الصندوق);
    }
    | اختياري.لا_شيء -> { };
    أرجع الكتلة;
}

// The match expression as the statement form it extends: the scrutinee and
// the arms, each arm's value appended to its body (كتلة_ذراع_مطابقة_تعبيرية).
عام عرف عبارة_مطابقة_تعبيرية(النطاق: نطاق, المطابقة: &مطابقة_تعبيرية): عبارة {
    ليكن الأذرع: متغير متجه ذراع_مطابقة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المطابقة).الأذرع) مثل طبيعي)) {
        ليكن الذراع: متغير ذراع_مطابقة = انسخ_مملوكا_ذراع_مطابقة(&(*المطابقة).الأذرع[ف]);
        الذراع.الجسم := كتلة_ذراع_مطابقة_تعبيرية(المطابقة, ف);
        ألحق(الأذرع, الذراع);
        ف := ف + 1;
    }
    أرجع عبارة.طابق(النطاق, انسخ_مملوكا_تعبير(&(*المطابقة).المميز), الأذرع);
}

// Every match expression the statement's own expressions hold at any depth
// of expressions: also those in another one's scrutinee or values, not those
// in an arm's body (whose statements a pass walks as statements). Passes that
// walk statements reach through it the arm bodies of match expressions.
عام عرف مطابقات_تعبيرية_متداخلة_عبارة(العبارة: &عبارة, الإغلاقات: منطقي): متجه تعبير {
    ليكن الناتج: متغير متجه تعبير = مطابقات_تعبيرية_عبارة(العبارة, الإغلاقات);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الناتج) مثل طبيعي)) {
        ليكن الداخلة: متجه تعبير = مطابقات_داخل_مطابقة_تعبيرية(&الناتج[ف], الإغلاقات);
        ليكن د: متغير طبيعي = 0;
        طالما (د < (الطول(الداخلة) مثل طبيعي)) {
            ألحق(الناتج, انسخ_مملوكا_تعبير(&الداخلة[د]));
            د := د + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The match expressions in the scrutinee and the values of the match
// expression المطابقة (اجمع_مطابقات_تعبير).
عرف مطابقات_داخل_مطابقة_تعبيرية(المطابقة: &تعبير, الإغلاقات: منطقي): متجه تعبير {
    ليكن الداخلة: متغير متجه تعبير = [];
    طابق *المطابقة مع
    | تعبير.مطابقة(_, المحتوى) -> {
        اجمع_مطابقات_تعبير(&(*المحتوى).المميز, الإغلاقات, &متغير الداخلة);
        اجمع_مطابقات_حراس(&(*المحتوى).الأذرع, الإغلاقات, &متغير الداخلة);
        ليكن ق: متغير طبيعي = 0;
        طالما (ق < (الطول((*المحتوى).القيم) مثل طبيعي)) {
            طابق (*المحتوى).القيم[ق] مع
            | اختياري.موجود(القيمة) -> { اجمع_مطابقات_تعبير(&القيمة, الإغلاقات, &متغير الداخلة); }
            | اختياري.لا_شيء -> { };
            ق := ق + 1;
        }
    }
    | _ -> { };
    أرجع الداخلة;
}

// The match expressions in the guards of the arms.
عرف اجمع_مطابقات_حراس(الأذرع: &متجه ذراع_مطابقة, الإغلاقات: منطقي, الناتج: &متغير متجه تعبير): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأذرع) مثل طبيعي)) {
        طابق (*الأذرع)[ف].الحارس مع
        | اختياري.موجود(الحارس) -> { اجمع_مطابقات_تعبير(&الحارس, الإغلاقات, الناتج); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
}
