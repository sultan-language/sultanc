استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.literals;

// المواضع القابلة للإسناد ممثلة كتعبيرات نحوية، والتحقق الدلالي يأتي لاحقا.
عام نوع تعبير =
    | حرفي بنوع (نطاق, حرفي)
    | اسم بنوع (نطاق, اسم)
    | حقل بنوع (
        نطاق,
        صندوق تعبير,
        اسم
    )
    | فهرس بنوع (
        نطاق,
        صندوق تعبير,
        صندوق تعبير
    )
    | فك_موضع بنوع (نطاق, صندوق تعبير)
    | ثنائي بنوع (
        نطاق,
        عامل_ثنائي,
        صندوق تعبير,
        صندوق تعبير
    )
    | أحادي بنوع (
        نطاق,
        عامل_أحادي,
        صندوق تعبير
    )
    | استدعاء بنوع (
        نطاق,
        صندوق تعبير,
        متجه تعبير
    )
    | تحويل بنوع (
        نطاق,
        صندوق تعبير,
        نوع_تركيبي
    )
;

عام عرف نطاق_تعبير(القيمة: &تعبير): نطاق {
    دع ت: تعبير = *القيمة;
    طابق ت مع
    | تعبير.حرفي(س, ح) -> {
        أرجع س;
    }
    | تعبير.اسم(س, ا) -> {
        أرجع س;
    }
    | تعبير.حقل(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.فهرس(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.فك_موضع(س, أ) -> {
        أرجع س;
    }
    | تعبير.ثنائي(س, ع, أ, ب) -> {
        أرجع س;
    }
    | تعبير.أحادي(س, ع, أ) -> {
        أرجع س;
    }
    | تعبير.استدعاء(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.تحويل(س, أ, ب) -> {
        أرجع س;
    };
}
