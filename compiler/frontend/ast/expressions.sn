استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.literals;

عام نوع معامل_إغلاق = {
    الاسم: اسم,
    النوع: نوع_تركيبي,
    النطاق: نطاق
};

// المواضع القابلة للإسناد ممثلة كتعبيرات نحوية، والتحقق الدلالي يأتي لاحقا.
عام نوع تعبير =
    | حرفي بنوع (نطاق, حرفي)
    | اسم بنوع (نطاق, اسم)
    | حقل بنوع (
        نطاق,
        صندوق تعبير,
        اسم
    )
    | فهرس بنوع (
        نطاق,
        صندوق تعبير,
        صندوق تعبير
    )
    | فك_موضع بنوع (نطاق, صندوق تعبير)
    | ثنائي بنوع (
        نطاق,
        عامل_ثنائي,
        صندوق تعبير,
        صندوق تعبير
    )
    | أحادي بنوع (
        نطاق,
        عامل_أحادي,
        صندوق تعبير
    )
    | استدعاء بنوع (
        نطاق,
        صندوق تعبير,
        متجه تعبير
    )
    | تحويل بنوع (
        نطاق,
        صندوق تعبير,
        نوع_تركيبي
    )
    | وقت_الترجمة بنوع (نطاق, صندوق تعبير)
    // An expression block evaluates each member in order; its last member
    // supplies the value. Statements/locals keep their ordinary AST owner.
    | تسلسل_وقت_الترجمة بنوع (نطاق, متجه تعبير)
    | إغلاق بنوع (
        نطاق,
        متجه معامل_إغلاق,
        نوع_تركيبي,
        صندوق تعبير
    )
    // A vector literal used as an expression (an argument, a returned value,
    // a field, an element): an owned temporary vector whose elements are
    // moved in, typed by its context. `let v: T = [..];` stays the
    // initializer statement (تهيئة_متجه).
    | حرفي_متجه بنوع (نطاق, متجه تعبير)
;

عام عرف نطاق_تعبير(القيمة: &تعبير): نطاق {
    طابق *القيمة مع
    | تعبير.حرفي(س, ح) -> {
        أرجع س;
    }
    | تعبير.اسم(س, ا) -> {
        أرجع س;
    }
    | تعبير.حقل(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.فهرس(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.فك_موضع(س, أ) -> {
        أرجع س;
    }
    | تعبير.ثنائي(س, ع, أ, ب) -> {
        أرجع س;
    }
    | تعبير.أحادي(س, ع, أ) -> {
        أرجع س;
    }
    | تعبير.استدعاء(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.تحويل(س, أ, ب) -> {
        أرجع س;
    }
    | تعبير.وقت_الترجمة(س, _) -> { أرجع س; }
    | تعبير.تسلسل_وقت_الترجمة(س, _) -> { أرجع س; }
    | تعبير.إغلاق(س, م, ن, ج) -> {
        أرجع س;
    }
    | تعبير.حرفي_متجه(س, _) -> { أرجع س; };
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_تعبير(القيمة: &تعبير): تعبير {
    طابق *القيمة مع
    | تعبير.حرفي(ح0, ح1) -> { أرجع تعبير.حرفي(ح0, انسخ_مملوكا_حرفي(&ح1)); }
    | تعبير.اسم(ح0, ح1) -> { أرجع تعبير.اسم(ح0, ح1); }
    | تعبير.حقل(ح0, ح1, ح2) -> { أرجع تعبير.حقل(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), ح2); }
    | تعبير.فهرس(ح0, ح1, ح2) -> { أرجع تعبير.فهرس(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), انسخ_مملوكا__صندوق_تعبير(&ح2)); }
    | تعبير.فك_موضع(ح0, ح1) -> { أرجع تعبير.فك_موضع(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1)); }
    | تعبير.ثنائي(ح0, ح1, ح2, ح3) -> { أرجع تعبير.ثنائي(ح0, ح1, انسخ_مملوكا__صندوق_تعبير(&ح2), انسخ_مملوكا__صندوق_تعبير(&ح3)); }
    | تعبير.أحادي(ح0, ح1, ح2) -> { أرجع تعبير.أحادي(ح0, ح1, انسخ_مملوكا__صندوق_تعبير(&ح2)); }
    | تعبير.استدعاء(ح0, ح1, ح2) -> { أرجع تعبير.استدعاء(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), انسخ_مملوكا_متجه_تعبير(&ح2)); }
    | تعبير.تحويل(ح0, ح1, ح2) -> { أرجع تعبير.تحويل(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1), انسخ_مملوكا_نوع_تركيبي(&ح2)); }
    | تعبير.وقت_الترجمة(ح0, ح1) -> { أرجع تعبير.وقت_الترجمة(ح0, انسخ_مملوكا__صندوق_تعبير(&ح1)); }
    | تعبير.تسلسل_وقت_الترجمة(ح0, ح1) -> { أرجع تعبير.تسلسل_وقت_الترجمة(ح0, انسخ_مملوكا_متجه_تعبير(&ح1)); }
    | تعبير.إغلاق(ح0, ح1, ح2, ح3) -> { أرجع تعبير.إغلاق(ح0, انسخ_مملوكا_متجه_معامل_إغلاق(&ح1), انسخ_مملوكا_نوع_تركيبي(&ح2), انسخ_مملوكا__صندوق_تعبير(&ح3)); }
    | تعبير.حرفي_متجه(ح0, ح1) -> { أرجع تعبير.حرفي_متجه(ح0, انسخ_مملوكا_متجه_تعبير(&ح1)); };
}

عرف انسخ_مملوكا__صندوق_تعبير(القيمة: &صندوق تعبير): صندوق تعبير {
    دع الداخل: تعبير = انسخ_مملوكا_تعبير(&(*(*القيمة)));
    دع الصندوق: صندوق تعبير = صندوق الداخل;
    أرجع الصندوق;
}

عام عرف انسخ_مملوكا_متجه_تعبير(القيمة: &متجه تعبير): متجه تعبير {
    دع الناتج: متغير متجه تعبير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_تعبير(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_معامل_إغلاق(القيمة: &متجه معامل_إغلاق): متجه معامل_إغلاق {
    دع الناتج: متغير متجه معامل_إغلاق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_معامل_إغلاق(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_معامل_إغلاق(القيمة: &معامل_إغلاق): معامل_إغلاق {
    دع الناتج: معامل_إغلاق = {
        الاسم: (*القيمة).الاسم,
        النوع: انسخ_مملوكا_نوع_تركيبي(&(*القيمة).النوع),
        النطاق: (*القيمة).النطاق
    };
    أرجع الناتج;
}
