// عنصر الوحدة لا يكرر حقائق التصريح؛ التصريح المضمن هو صاحب الحقيقة الوحيد لها.
عام نوع عنصر_وحدة =
    | دالة بنوع تصريح_دالة
    | نوع بنوع تصريح_نوع
    | تجميع بنوع (نطاق, متجه غ8)
;

عام نوع استيراد =
    | اسم بنوع (نطاق, متجه اسم, اختيار اسم)
    | نص بنوع (نطاق, متجه غ8, اختيار اسم)
    | انتقائي بنوع (نطاق, متجه اسم, متجه اسم)
;

عام نوع وحدة_مصدر = {
    المصدر: مصدر,
    الاستيرادات: متجه استيراد,
    العناصر: متجه عنصر_وحدة,
    مرادفات_الأسماء: متجه تصريح_مرادف_اسم
};
