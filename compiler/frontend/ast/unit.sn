استورد std.text.from_bytes;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.literals;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.statements;
استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.declarations;

// عنصر الوحدة لا يكرر حقائق التصريح؛ التصريح المضمن هو صاحب الحقيقة الوحيد لها.
عام نوع عنصر_وحدة =
    | دالة بنوع تصريح_دالة
    | نوع بنوع تصريح_نوع
    | قيمة_عليا بنوع تصريح_قيمة_عليا
    | تجميع بنوع (نطاق, متجه ط8)
;

عام نوع استيراد =
    | اسم بنوع (نطاق, متجه اسم, اختياري اسم)
    | نص بنوع (نطاق, متجه ط8, اختياري اسم)
    | انتقائي بنوع (نطاق, متجه اسم, متجه اسم)
;

عام نوع وحدة_مصدر = {
    معرف_المصدر: طبيعي,
    الاستيرادات: متجه استيراد,
    العناصر: متجه عنصر_وحدة,
    مرادفات_الأسماء: متجه تصريح_مرادف_اسم,
    // Name spans of declarations a false target condition left out, so an
    // unknown name can say that it exists only for other targets.
    المستبعدة_للهدف: متجه نطاق
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_عنصر_وحدة(القيمة: &عنصر_وحدة): عنصر_وحدة {
    طابق *القيمة مع
    | عنصر_وحدة.دالة(ح0) -> { أرجع عنصر_وحدة.دالة(انسخ_مملوكا_تصريح_دالة(&ح0)); }
    | عنصر_وحدة.نوع(ح0) -> { أرجع عنصر_وحدة.نوع(انسخ_مملوكا_تصريح_نوع(&ح0)); }
    | عنصر_وحدة.قيمة_عليا(ح0) -> { أرجع عنصر_وحدة.قيمة_عليا(انسخ_مملوكا_تصريح_قيمة_عليا(&ح0)); }
    | عنصر_وحدة.تجميع(ح0, ح1) -> { أرجع عنصر_وحدة.تجميع(ح0, انسخ_بايتات(&ح1)); };
}
