استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.lexer.contextual_name_classification;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.parser.cursor;

عام نوع نتيجة_اسم =
    | موجود بنوع اسم
    | غائب
;

عام عرف اسم_الحالي(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اسم {
    ليكن النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    ليكن الصنف: صنف_اسم_تركيبي = صنف_اسم_تركيبي.عادي();
    ليكن الناتج: اسم = {
        النطاق: النطاق,
        الصنف: الصنف
    };
    أرجع الناتج;
}

عام عرف اسم_سياقي(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): منطقي {
    أرجع يصلح_اسما_سياقيا(نوع_الحالي(الرموز, المؤشر));
}

عام عرف خذ_اسما_سياقيا(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): نتيجة_اسم {
    إذا (!اسم_سياقي(الرموز, المؤشر)) {
        أرجع نتيجة_اسم.غائب();
    };
    ليكن الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    أرجع نتيجة_اسم.موجود(الاسم);
}

عام عرف اسمان_بنفس_تهجئة_المصدر(
    المصدر: &مصدر,
    أ: &اسم,
    ب: &اسم
): منطقي {
    ليكن قيمة_أ: اسم = *أ;
    ليكن قيمة_ب: اسم = *ب;
    ليكن نطاق_أ: نطاق = قيمة_أ.النطاق;
    ليكن نطاق_ب: نطاق = قيمة_ب.النطاق;
    ليكن بداية_أ: موضع = نطاق_أ.البداية;
    ليكن بداية_ب: موضع = نطاق_ب.البداية;
    ليكن نهاية_أ: موضع = نطاق_أ.النهاية;
    ليكن نهاية_ب: موضع = نطاق_ب.النهاية;
    ليكن طول_أ: طبيعي = نهاية_أ.البايت - بداية_أ.البايت;
    ليكن طول_ب: طبيعي = نهاية_ب.البايت - بداية_ب.البايت;
    إذا (طول_أ != طول_ب) {
        أرجع خطأ;
    };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < طول_أ) {
        إذا (بايت_المصدر(المصدر, (بداية_أ.البايت مثل طبيعي) + ف) != بايت_المصدر(المصدر, (بداية_ب.البايت مثل طبيعي) + ف)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف اسم_موجود_في_قائمة_بنفس_تهجئة_المصدر(
    المصدر: &مصدر,
    الأسماء: &متجه اسم,
    المطلوب: &اسم
): منطقي {
    ليكن القائمة: متجه اسم = *الأسماء;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القائمة) مثل طبيعي)) {
        إذا (اسمان_بنفس_تهجئة_المصدر(المصدر, &القائمة[ف], المطلوب)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}
