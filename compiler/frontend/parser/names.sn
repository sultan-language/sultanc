استورد compiler.frontend.source.source;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.lexer.contextual_name_classification;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.parser.cursor;

عام نوع نتيجة_اسم =
    | موجود بنوع اسم
    | غائب
;

عام عرف اسم_الحالي(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اسم {
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع الصنف: صنف_اسم_تركيبي = صنف_اسم_تركيبي.عادي();
    دع الناتج: اسم = {
        النطاق: النطاق,
        الصنف: الصنف
    };
    أرجع الناتج;
}

عام عرف اسم_سياقي(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): منطقي {
    أرجع يصلح_اسما_سياقيا(نوع_الحالي(الرموز, المؤشر));
}

عام عرف خذ_اسما_سياقيا(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): نتيجة_اسم {
    لو (!اسم_سياقي(الرموز, المؤشر)) {
        أرجع نتيجة_اسم.غائب();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    أرجع نتيجة_اسم.موجود(الاسم);
}

عام عرف اسمان_بنفس_تهجئة_المصدر(
    المصدر: &مصدر,
    أ: &اسم,
    ب: &اسم
): منطقي {
    دع قيمة_أ: اسم = *أ;
    دع قيمة_ب: اسم = *ب;
    دع نطاق_أ: نطاق = قيمة_أ.النطاق;
    دع نطاق_ب: نطاق = قيمة_ب.النطاق;
    دع بداية_أ: موضع = نطاق_أ.البداية;
    دع بداية_ب: موضع = نطاق_ب.البداية;
    دع نهاية_أ: موضع = نطاق_أ.النهاية;
    دع نهاية_ب: موضع = نطاق_ب.النهاية;
    دع طول_أ: غير_موقع = نهاية_أ.البايت - بداية_أ.البايت;
    دع طول_ب: غير_موقع = نهاية_ب.البايت - بداية_ب.البايت;
    لو (طول_أ != طول_ب) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < طول_أ) {
        لو (بايت_المصدر(المصدر, بداية_أ.البايت + ف) != بايت_المصدر(المصدر, بداية_ب.البايت + ف)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف اسم_موجود_في_قائمة_بنفس_تهجئة_المصدر(
    المصدر: &مصدر,
    الأسماء: &متجه اسم,
    المطلوب: &اسم
): منطقي {
    دع القائمة: متجه اسم = *الأسماء;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القائمة) مثل غير_موقع)) {
        لو (اسمان_بنفس_تهجئة_المصدر(المصدر, &القائمة[ف], المطلوب)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}
