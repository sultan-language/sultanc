استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_spelling;
استورد compiler.frontend.identifier_identity;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.parser.cursor;
استورد compiler.frontend.parser.error;
استورد compiler.source.source_file;
استورد compiler.source.span;

// This is the compile-time target-predicate grammar, not an expression evaluator.
// Only the selected target descriptor can satisfy a predicate. Unsupported
// fields are errors; values compare against canonical target spellings.
عرف يساوي_معرف_حارس_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر, الاسم: نص
): منطقي {
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) { أرجع خطأ; };
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    أرجع تطابق_هوية_معرف_وشريحة(
        &(*المصدر).المحتوى, النطاق.البداية.البايت, النطاق.النهاية.البايت, الاسم
    );
}

عرف يساوي_نص_و_بايتات_حارس_هدف(القيمة: نص, البايتات: &متجه غ8): منطقي {
    لو (الطول(القيمة) != الطول(*البايتات)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*البايتات) مثل غير_موقع)) {
        لو (القيمة[ف] != (*البايتات)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف قيمة_حقل_حارس_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر,
    الهدف: &واصف_هدف
): اختيار نص {
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «المنصة»)) {
        أرجع اختيار.بعض(تهجئة_منصة_شرط_هدف((*الهدف).المنصة.المنصة));
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «البيئة»)) {
        أرجع اختيار.بعض(تهجئة_بيئة_شرط_هدف((*الهدف).المنصة.البيئة));
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «المعمارية»)) {
        أرجع اختيار.بعض(تهجئة_معمارية_هدف((*الهدف).المعمارية.الهوية));
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «الثلاثي»)) {
        // Same read pattern as تهجئة_هدف_مسجل: borrow the field, read the text.
        دع مرجع_الثلاثي: &نص = &(*الهدف).الثلاثي_المقنن;
        دع الثلاثي: نص = *مرجع_الثلاثي;
        أرجع اختيار.بعض(الثلاثي);
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «عائلة_المنصة»)) {
        طابق (*الهدف).المنصة.المنصة مع
        | هوية_منصة.ماك_أو_إس -> { أرجع اختيار.بعض(«unix»); }
        | هوية_منصة.آي_أو_إس -> { أرجع اختيار.بعض(«unix»); }
        | هوية_منصة.لينكس -> { أرجع اختيار.بعض(«unix»); }
        | هوية_منصة.أندرويد -> { أرجع اختيار.بعض(«unix»); }
        | هوية_منصة.فري_بي_إس_دي -> { أرجع اختيار.بعض(«unix»); }
        | هوية_منصة.ويندوز -> { أرجع اختيار.بعض(«windows»); }
        | هوية_منصة.واسي -> { أرجع اختيار.بعض(«wasm»); }
        | هوية_منصة.متصفح -> { أرجع اختيار.بعض(«wasm»); }
        | _ -> { أرجع اختيار.بعض(«none»); };
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «الواجهة_الثنائية»)) {
        أرجع اختيار.بعض(تهجئة_واجهة_ثنائية_شرط_هدف((*الهدف).الواجهة_الثنائية));
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «صيغة_الكائن»)) {
        أرجع اختيار.بعض(تهجئة_صيغة_شرط_هدف((*الهدف).صيغة_الكائن));
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «ترتيب_البايت»)) {
        أرجع اختيار.بعض(تهجئة_ترتيب_بايت_شرط_هدف((*الهدف).نموذج_البيانات.ترتيب_البايت));
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «الدعم»)) {
        أرجع اختيار.بعض(تهجئة_دعم_هدف((*الهدف).الدعم));
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «مزود_التشغيل»)) {
        أرجع اختيار.بعض(تهجئة_مزود_تشغيل_شرط_هدف((*الهدف).مزود_التشغيل));
    };
    لو (يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «عرض_المؤشر»)) {
        دع العرض: غير_موقع = (*الهدف).نموذج_البيانات.عرض_المؤشر;
        لو (العرض == 16) { أرجع اختيار.بعض(«16»); };
        لو (العرض == 32) { أرجع اختيار.بعض(«32»); };
        لو (العرض == 64) { أرجع اختيار.بعض(«64»); };
        لو (العرض == 128) { أرجع اختيار.بعض(«128»); };
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.لا_شيء();
}

// Target condition: لو (الهدف.المنصة == "linux") { ... } وإلا { ... }
// Conjunction, disjunction and negation reuse existing expression punctuation,
// but have a restricted, side-effect-free compile-time predicate grammar.
عرف اقرأ_ذرة_شرط_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر,
    الهدف: &واصف_هدف
): اختيار منطقي {
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.نفي()) {
        تقدم(الرموز, المؤشر);
        طابق اقرأ_ذرة_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
        | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(!القيمة); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    };
    لو (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
        دع الناتج: اختيار منطقي = اقرأ_شرط_هدف(المصدر, الرموز, المؤشر, الهدف);
        لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع اختيار.لا_شيء(); };
        أرجع الناتج;
    };
    لو (!يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, «الهدف»)) {
        أرجع اختيار.لا_شيء();
    };
    تقدم(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.نقطة())) { أرجع اختيار.لا_شيء(); };
    دع قيمة_الحقل: اختيار نص = قيمة_حقل_حارس_هدف(المصدر, الرموز, المؤشر, الهدف);
    دع قيمة_متوقعة: نص;
    طابق قيمة_الحقل مع
    | اختيار.بعض(القيمة) -> { قيمة_متوقعة := القيمة; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    تقدم(الرموز, المؤشر);
    دع عكس: منطقي = نوع_الحالي(الرموز, المؤشر) == رمز.لا_يساوي();
    لو (!عكس && نوع_الحالي(الرموز, المؤشر) != رمز.يساوي()) {
        أرجع اختيار.لا_شيء();
    };
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_نص()) {
        أرجع اختيار.لا_شيء();
    };
    دع البايتات: متجه غ8;
    طابق نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر)) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { البايتات := القيمة; };
    تقدم(الرموز, المؤشر);
    دع متطابقة: منطقي = يساوي_نص_و_بايتات_حارس_هدف(قيمة_متوقعة, &البايتات);
    لو (عكس) { أرجع اختيار.بعض(!متطابقة); };
    أرجع اختيار.بعض(متطابقة);
}

عرف اقرأ_اقتران_شرط_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر,
    الهدف: &واصف_هدف
): اختيار منطقي {
    دع النتيجة: متغير منطقي;
    طابق اقرأ_ذرة_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
    | اختيار.بعض(القيمة) -> { النتيجة := القيمة; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    بينما (اقبل(الرموز, المؤشر, رمز.و())) {
        طابق اقرأ_ذرة_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
        | اختيار.بعض(القيمة) -> { النتيجة := النتيجة && القيمة; }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    أرجع اختيار.بعض(النتيجة);
}

عام عرف اقرأ_شرط_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر,
    الهدف: &واصف_هدف
): اختيار منطقي {
    دع النتيجة: متغير منطقي;
    طابق اقرأ_اقتران_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
    | اختيار.بعض(القيمة) -> { النتيجة := القيمة; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    بينما (اقبل(الرموز, المؤشر, رمز.أو())) {
        طابق اقرأ_اقتران_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
        | اختيار.بعض(القيمة) -> { النتيجة := النتيجة || القيمة; }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    أرجع اختيار.بعض(النتيجة);
}
