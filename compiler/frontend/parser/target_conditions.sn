استورد std.text.from_bytes;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_spelling;
استورد compiler.frontend.identifier_identity;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.parser.cursor;
استورد compiler.frontend.parser.error;
استورد compiler.source.source_file;
استورد compiler.source.span;

// This is the compile-time target-predicate grammar, not an expression evaluator.
// Only the selected target descriptor can satisfy a predicate. Unsupported
// fields are errors; values compare against canonical target spellings.
عرف يساوي_معرف_حارس_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر, الاسم: نص
): منطقي {
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) { أرجع خطأ; };
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    أرجع تطابق_هوية_معرف_وشريحة(
        &(*المصدر).المحتوى, النطاق.البداية.البايت, النطاق.النهاية.البايت, الاسم
    );
}

// The guard names have an Arabic and an English spelling, like keywords.
عرف يساوي_معرف_حارس_هدف_بلغتين(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر,
    العربي: نص, الإنجليزي: نص
): منطقي {
    أرجع يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, العربي)
        || يساوي_معرف_حارس_هدف(المصدر, الرموز, المؤشر, الإنجليزي);
}

عرف يساوي_نص_و_بايتات_حارس_هدف(القيمة: نص, البايتات: &متجه ط8): منطقي {
    لو (الطول(القيمة) != الطول(*البايتات)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) {
        لو (القيمة[ف] != (*البايتات)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف قيمة_حقل_حارس_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر,
    الهدف: &واصف_هدف
): اختياري نص {
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «المنصة», «platform»)) {
        أرجع اختياري.موجود(تهجئة_منصة_شرط_هدف((*الهدف).المنصة.المنصة));
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «البيئة», «environment»)) {
        أرجع اختياري.موجود(تهجئة_بيئة_شرط_هدف((*الهدف).المنصة.البيئة));
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «المعمارية», «architecture»)) {
        أرجع اختياري.موجود(تهجئة_معمارية_هدف((*الهدف).المعمارية.الهوية));
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «الثلاثي», «triple»)) {
        // Same read pattern as تهجئة_هدف_مسجل: borrow the field, read the text.
        دع مرجع_الثلاثي: &نص = &(*الهدف).الثلاثي_المقنن;
        دع الثلاثي: نص = انسخ_نص(مرجع_الثلاثي);
        أرجع اختياري.موجود(الثلاثي);
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «عائلة_المنصة», «platform_family»)) {
        طابق (*الهدف).المنصة.المنصة مع
        | هوية_منصة.ماك_أو_إس -> { أرجع اختياري.موجود(«unix»); }
        | هوية_منصة.آي_أو_إس -> { أرجع اختياري.موجود(«unix»); }
        | هوية_منصة.لينكس -> { أرجع اختياري.موجود(«unix»); }
        | هوية_منصة.أندرويد -> { أرجع اختياري.موجود(«unix»); }
        | هوية_منصة.فري_بي_إس_دي -> { أرجع اختياري.موجود(«unix»); }
        | هوية_منصة.ويندوز -> { أرجع اختياري.موجود(«windows»); }
        | هوية_منصة.واسي -> { أرجع اختياري.موجود(«wasm»); }
        | هوية_منصة.متصفح -> { أرجع اختياري.موجود(«wasm»); }
        | _ -> { أرجع اختياري.موجود(«none»); };
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «الواجهة_الثنائية», «abi»)) {
        أرجع اختياري.موجود(تهجئة_واجهة_ثنائية_شرط_هدف((*الهدف).الواجهة_الثنائية));
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «صيغة_الكائن», «object_format»)) {
        أرجع اختياري.موجود(تهجئة_صيغة_شرط_هدف((*الهدف).صيغة_الكائن));
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «ترتيب_البايت», «byte_order»)) {
        أرجع اختياري.موجود(تهجئة_ترتيب_بايت_شرط_هدف((*الهدف).نموذج_البيانات.ترتيب_البايت));
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «الدعم», «support»)) {
        أرجع اختياري.موجود(تهجئة_دعم_هدف((*الهدف).الدعم));
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «مزود_التشغيل», «runtime_provider»)) {
        أرجع اختياري.موجود(تهجئة_مزود_تشغيل_شرط_هدف((*الهدف).مزود_التشغيل));
    };
    لو (يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «عرض_المؤشر», «pointer_width»)) {
        دع العرض: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر;
        لو (العرض == 16) { أرجع اختياري.موجود(«16»); };
        لو (العرض == 32) { أرجع اختياري.موجود(«32»); };
        لو (العرض == 64) { أرجع اختياري.موجود(«64»); };
        لو (العرض == 128) { أرجع اختياري.موجود(«128»); };
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.لا_شيء();
}

// Target condition: لو (الهدف.المنصة == "linux") { ... } وإلا { ... },
// in English `if (target.platform == "linux") { ... } else { ... }`.
// Conjunction, disjunction and negation reuse existing expression punctuation,
// but have a restricted, side-effect-free compile-time predicate grammar.
عرف اقرأ_ذرة_شرط_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر,
    الهدف: &واصف_هدف
): اختياري منطقي {
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.نفي()) {
        تقدم(الرموز, المؤشر);
        طابق اقرأ_ذرة_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
        | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(!القيمة); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
    لو (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
        دع الناتج: اختياري منطقي = اقرأ_شرط_هدف(المصدر, الرموز, المؤشر, الهدف);
        لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع اختياري.لا_شيء(); };
        أرجع الناتج;
    };
    لو (!يساوي_معرف_حارس_هدف_بلغتين(المصدر, الرموز, المؤشر, «الهدف», «target»)) {
        أرجع اختياري.لا_شيء();
    };
    تقدم(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.نقطة())) { أرجع اختياري.لا_شيء(); };
    دع قيمة_الحقل: اختياري نص = قيمة_حقل_حارس_هدف(المصدر, الرموز, المؤشر, الهدف);
    دع قيمة_متوقعة: نص;
    طابق قيمة_الحقل مع
    | اختياري.موجود(القيمة) -> { قيمة_متوقعة := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    تقدم(الرموز, المؤشر);
    دع عكس: منطقي = نوع_الحالي(الرموز, المؤشر) == رمز.لا_يساوي();
    لو (!عكس && نوع_الحالي(الرموز, المؤشر) != رمز.يساوي()) {
        أرجع اختياري.لا_شيء();
    };
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_نص()) {
        أرجع اختياري.لا_شيء();
    };
    دع البايتات: متجه ط8;
    طابق نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { البايتات := القيمة; };
    تقدم(الرموز, المؤشر);
    دع متطابقة: منطقي = يساوي_نص_و_بايتات_حارس_هدف(قيمة_متوقعة, &البايتات);
    لو (عكس) { أرجع اختياري.موجود(!متطابقة); };
    أرجع اختياري.موجود(متطابقة);
}

عرف اقرأ_اقتران_شرط_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر,
    الهدف: &واصف_هدف
): اختياري منطقي {
    دع النتيجة: متغير منطقي;
    طابق اقرأ_ذرة_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
    | اختياري.موجود(القيمة) -> { النتيجة := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طالما (اقبل(الرموز, المؤشر, رمز.و())) {
        طابق اقرأ_ذرة_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
        | اختياري.موجود(القيمة) -> { النتيجة := النتيجة && القيمة; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    أرجع اختياري.موجود(النتيجة);
}

عام عرف اقرأ_شرط_هدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر,
    الهدف: &واصف_هدف
): اختياري منطقي {
    دع النتيجة: متغير منطقي;
    طابق اقرأ_اقتران_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
    | اختياري.موجود(القيمة) -> { النتيجة := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طالما (اقبل(الرموز, المؤشر, رمز.أو())) {
        طابق اقرأ_اقتران_شرط_هدف(المصدر, الرموز, المؤشر, الهدف) مع
        | اختياري.موجود(القيمة) -> { النتيجة := النتيجة || القيمة; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    أرجع اختياري.موجود(النتيجة);
}
