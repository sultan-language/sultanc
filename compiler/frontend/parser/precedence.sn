استورد compiler.frontend.lexer.token;
استورد compiler.frontend.ast.operators;

// أسبقية العوامل الثنائية وترابطها؛ جميع العوامل الحالية يسارية الترابط.
عام نوع معلومة_عامل =
    | ثنائي بنوع (عدد, عامل_ثنائي)
    | ليس_ثنائيا
;

عام عرف معلومة_العامل(النوع: رمز): معلومة_عامل {
    طابق النوع مع
    | رمز.أو -> {
        أرجع معلومة_عامل.ثنائي(1, عامل_ثنائي.أو());
    }
    | رمز.و -> {
        أرجع معلومة_عامل.ثنائي(2, عامل_ثنائي.و());
    }
    | رمز.أو_بتي -> {
        أرجع معلومة_عامل.ثنائي(3, عامل_ثنائي.أو_بتي());
    }
    | رمز.أو_حصري -> {
        أرجع معلومة_عامل.ثنائي(4, عامل_ثنائي.أو_حصري());
    }
    | رمز.و_بتي -> {
        أرجع معلومة_عامل.ثنائي(5, عامل_ثنائي.و_بتي());
    }
    | رمز.يساوي -> {
        أرجع معلومة_عامل.ثنائي(6, عامل_ثنائي.يساوي());
    }
    | رمز.لا_يساوي -> {
        أرجع معلومة_عامل.ثنائي(6, عامل_ثنائي.لا_يساوي());
    }
    | رمز.أصغر -> {
        أرجع معلومة_عامل.ثنائي(7, عامل_ثنائي.أصغر());
    }
    | رمز.أصغر_أو_يساوي -> {
        أرجع معلومة_عامل.ثنائي(7, عامل_ثنائي.أصغر_أو_يساوي());
    }
    | رمز.أكبر_أو_يساوي -> {
        أرجع معلومة_عامل.ثنائي(7, عامل_ثنائي.أكبر_أو_يساوي());
    }
    | رمز.أكبر -> {
        أرجع معلومة_عامل.ثنائي(7, عامل_ثنائي.أكبر());
    }
    | رمز.إزاحة_يسرى -> {
        أرجع معلومة_عامل.ثنائي(8, عامل_ثنائي.إزاحة_يسرى());
    }
    | رمز.إزاحة_يمنى -> {
        أرجع معلومة_عامل.ثنائي(8, عامل_ثنائي.إزاحة_يمنى());
    }
    | رمز.إزاحة_حسابية_يمنى -> {
        أرجع معلومة_عامل.ثنائي(8, عامل_ثنائي.إزاحة_حسابية_يمنى());
    }
    | رمز.جمع -> {
        أرجع معلومة_عامل.ثنائي(9, عامل_ثنائي.جمع());
    }
    | رمز.طرح -> {
        أرجع معلومة_عامل.ثنائي(9, عامل_ثنائي.طرح());
    }
    | رمز.نجمة -> {
        أرجع معلومة_عامل.ثنائي(10, عامل_ثنائي.ضرب());
    }
    | رمز.قسمة -> {
        أرجع معلومة_عامل.ثنائي(10, عامل_ثنائي.قسمة());
    }
    | رمز.باقي -> {
        أرجع معلومة_عامل.ثنائي(10, عامل_ثنائي.باقي());
    }
    | _ -> {
        أرجع معلومة_عامل.ليس_ثنائيا();
    };
}
