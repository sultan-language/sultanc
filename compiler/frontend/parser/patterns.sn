// تحليل صياغة الأنماط فقط؛ صلاحية النمط الدلالية تتحقق في مرحلة لاحقة.

عرف حلل_منشئ_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    النوع: اسم,
    البداية: نطاق
): اختيار نمط {
    لو (!توقع(الرموز, المؤشر, رمز.نقطة())) {
        أرجع اختيار.لا_شيء();
    };
    دع نتيجة_الاسم: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
    طابق نتيجة_الاسم مع
    | نتيجة_اسم.غائب -> {
        أرجع اختيار.لا_شيء();
    }
    | نتيجة_اسم.موجود(المنشئ) -> {
        دع الحمولات: متغير متجه نمط = [];
        لو (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
            لو (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
                دع مستمر: متغير منطقي = صواب;
                بينما (مستمر) {
                    دع النتيجة: اختيار نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
                    طابق النتيجة مع
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.لا_شيء();
                    }
                    | اختيار.بعض(القيمة) -> {
                        ألحق(الحمولات, القيمة);
                    };
                    لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                        مستمر := خطأ;
                    };
                }
            };
            لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                أرجع اختيار.لا_شيء();
            };
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختيار.بعض(نمط.منشئ(دمج_نطاق(البداية, النهاية), النوع, المنشئ, الحمولات));
    };
}

عرف حلل_صف_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختيار نمط {
    تقدم(الرموز, المؤشر);
    دع العناصر: متغير متجه نمط = [];
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع النتيجة: اختيار نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
            طابق النتيجة مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            }
            | اختيار.بعض(القيمة) -> {
                ألحق(العناصر, القيمة);
            };
            لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                مستمر := خطأ;
            };
        }
    };
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختيار.بعض(نمط.صف(دمج_نطاق(البداية, النهاية), العناصر));
}

عرف حلل_سجل_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختيار نمط {
    تقدم(الرموز, المؤشر);
    دع الحقول: متغير متجه حقل_نمط = [];
    بينما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            أرجع اختيار.لا_شيء();
        };
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
            أرجع اختيار.لا_شيء();
        };
        دع النتيجة: اختيار نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
        طابق النتيجة مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(القيمة) -> {
            دع الحقل: حقل_نمط = {
                الاسم: الاسم,
                النمط: القيمة
            };
            ألحق(الحقول, الحقل);
        };
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            لو (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
                توقع(الرموز, المؤشر, رمز.معقوف_يمين());
                أرجع اختيار.لا_شيء();
            };
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختيار.بعض(نمط.سجل(دمج_نطاق(البداية, النهاية), الحقول));
}

عام عرف حلل_نمطا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار نمط {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    لو (النوع == رمز.شرطة_سفلية()) {
        تقدم(الرموز, المؤشر);
        أرجع اختيار.بعض(نمط.بدل(البداية));
    };
    لو (النوع == رمز.قوس_يسار()) {
        أرجع حلل_صف_نمط(المصدر, الرموز, المؤشر, البداية);
    };
    لو (النوع == رمز.معقوف_يسار()) {
        أرجع حلل_سجل_نمط(المصدر, الرموز, المؤشر, البداية);
    };
    لو (النوع != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.نقطة()) {
        أرجع حلل_منشئ_نمط(المصدر, الرموز, المؤشر, الاسم, البداية);
    };
    أرجع اختيار.بعض(نمط.ربط(البداية, الاسم));
}
