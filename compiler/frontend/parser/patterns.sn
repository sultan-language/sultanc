// تحليل صياغة الأنماط فقط؛ صلاحية النمط الدلالية تتحقق في مرحلة لاحقة.

عرف حلل_نمط_حرفيا(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري نمط {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    ليكن النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    إذا (النوع == رمز.طرح()) {
        تقدم(الرموز, المؤشر);
        إذا (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_عدد_صحيح()) {
            ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
            ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_عدد_صحيح());
            أرجع اختياري.لا_شيء();
        };
        ليكن محاولة_القيمة: اختياري قيمة_عدد_صحيح_رمز = قيمة_عدد_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق محاولة_القيمة مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            ليكن النهاية: نطاق = نطاق_الحالي(الرموز, المؤشر);
            طابق حرفي_عدد_سالب_من_قيمة_رمز(القيمة) مع
            | اختياري.لا_شيء -> {
                ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
                ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_عدد_صحيح());
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(الحرفي) -> {
                تقدم(الرموز, المؤشر);
                أرجع اختياري.موجود(نمط.حرفي(دمج_نطاق(البداية, النهاية), الحرفي));
            };
        };
    };
    إذا (النوع == رمز.حرفي_عدد_صحيح()) {
        طابق قيمة_عدد_عند(الرموز, فهرس_الحالي(المؤشر)) مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            أرجع اختياري.موجود(نمط.حرفي(البداية, حرفي_عدد_من_قيمة_رمز(القيمة)));
        };
    };
    إذا (النوع == رمز.حرفي_حرف()) {
        طابق قيمة_محرف_عند(الرموز, فهرس_الحالي(المؤشر)) مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            أرجع اختياري.موجود(نمط.حرفي(البداية, حرفي.حرف(القيمة)));
        };
    };
    إذا (النوع == رمز.حرفي_منطقي()) {
        طابق قيمة_منطق_عند(الرموز, فهرس_الحالي(المؤشر)) مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            أرجع اختياري.موجود(نمط.حرفي(البداية, حرفي.منطقي(القيمة)));
        };
    };
    إذا (النوع == رمز.حرفي_نص()) {
        طابق نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر)) مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(البايتات) -> {
            تقدم(الرموز, المؤشر);
            أرجع اختياري.موجود(نمط.حرفي(البداية, حرفي.نص(البايتات)));
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف حلل_منشئ_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    النوع: اسم,
    البداية: نطاق
): اختياري نمط {
    إذا (!توقع(الرموز, المؤشر, رمز.نقطة())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن نتيجة_الاسم: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
    طابق نتيجة_الاسم مع
    | نتيجة_اسم.غائب -> {
        // `T.` with no constructor name after the dot (at the end of the
        // file too): the user's syntax error. Previously nothing was
        // recorded and the parser reported an internal failure.
        ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.نمط(), رمز.معرف());
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_اسم.موجود(المنشئ) -> {
        أرجع حلل_حمولات_منشئ_نمط(المصدر, الرموز, المؤشر, النوع, المنشئ, البداية);
    };
}

// The payload patterns of a constructor pattern, `(p, q)` when written.
عرف حلل_حمولات_منشئ_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    النوع: اسم,
    المنشئ: اسم,
    البداية: نطاق
): اختياري نمط {
    ليكن الحمولات: متغير متجه نمط = [];
    إذا (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
        إذا (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
            ليكن مستمر: متغير منطقي = صواب;
            طالما (مستمر) {
                ليكن النتيجة: اختياري نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
                طابق النتيجة مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(القيمة) -> {
                    ألحق(الحمولات, القيمة);
                };
                إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                    مستمر := خطأ;
                };
            }
        };
        إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
            أرجع اختياري.لا_شيء();
        };
    };
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نمط.منشئ(دمج_نطاق(البداية, النهاية), النوع, المنشئ, الحمولات));
}

// Whether the token at the cursor spells a prelude constructor that a
// pattern may write bare: `some`, `ok`, `err` (`موجود`, `نجح`, `خطأ`) before
// `(`, and `none` (`لا_شيء`) with or without it. `خطأ` is also the literal
// false: it is the constructor only before `(`.
عرف هل_منشئ_تمهيدي_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): منطقي {
    ليكن النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    إذا (النوع != رمز.معرف() && النوع != رمز.حرفي_منطقي()) { أرجع خطأ; };
    ليكن النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    ليكن قوس: منطقي = نوع_التالي(الرموز, المؤشر) == رمز.قوس_يسار();
    إذا (النوع == رمز.حرفي_منطقي()) {
        أرجع قوس && هل_نطاق_يساوي_نصا(المصدر, النطاق, «خطأ»);
    };
    إذا (هل_نطاق_يساوي_نصا(المصدر, النطاق, «none») || هل_نطاق_يساوي_نصا(المصدر, النطاق, «لا_شيء»)) {
        أرجع نوع_التالي(الرموز, المؤشر) != رمز.نقطة();
    };
    أرجع قوس && (
        هل_نطاق_يساوي_نصا(المصدر, النطاق, «some») || هل_نطاق_يساوي_نصا(المصدر, النطاق, «موجود»)
        || هل_نطاق_يساوي_نصا(المصدر, النطاق, «ok») || هل_نطاق_يساوي_نصا(المصدر, النطاق, «نجح»)
        || هل_نطاق_يساوي_نصا(المصدر, النطاق, «err»)
    );
}

// `some(p)`, `none`, `ok(p)`, `err(p)` in a pattern: the constructor of option
// or result. Its Type is implied: an empty name at the constructor's start,
// of kind منشئ_تمهيدي, which Name binds to `option` or `result`.
عرف حلل_منشئ_تمهيدي_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري نمط {
    ليكن المنشئ: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    ليكن النوع: اسم = {
        النطاق: نطاق_بين(المنشئ.النطاق.البداية, المنشئ.النطاق.البداية),
        الصنف: صنف_اسم_تركيبي.منشئ_تمهيدي()
    };
    أرجع حلل_حمولات_منشئ_نمط(المصدر, الرموز, المؤشر, النوع, المنشئ, البداية);
}

عرف حلل_صف_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري نمط {
    تقدم(الرموز, المؤشر);
    ليكن العناصر: متغير متجه نمط = [];
    ليكن فاصلة_أخيرة: متغير منطقي = خطأ;
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        ليكن مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            ليكن النتيجة: اختياري نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
            طابق النتيجة مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(القيمة) -> {
                ألحق(العناصر, القيمة);
            };
            إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                مستمر := خطأ;
            } وإلا {
                فاصلة_أخيرة := صواب;
                // A trailing comma before `)` ends the tuple.
                إذا (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يمين()) {
                    مستمر := خطأ;
                } وإلا {
                    فاصلة_أخيرة := خطأ;
                };
            };
        }
    };
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    // `(pattern)` without a comma groups the pattern (`(A | B) as x`); it is
    // no tuple.
    إذا ((الطول(العناصر) مثل طبيعي) == 1 && !فاصلة_أخيرة) {
        أرجع اختياري.موجود(انسخ_مملوكا_نمط(&العناصر[0]));
    };
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نمط.صف(دمج_نطاق(البداية, النهاية), العناصر));
}

عرف حلل_سجل_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري نمط {
    تقدم(الرموز, المؤشر);
    ليكن الحقول: متغير متجه حقل_نمط = [];
    // Only the fields written are matched; the others are matched by
    // anything.
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            // A field name is expected: the user's syntax error.
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.نمط(), رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        ليكن الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        // `{ width }` binds the field to a name spelled as it is: the
        // binding's occurrence is the field's name.
        ليكن نمط_الحقل: متغير نمط = نمط.ربط(الاسم.النطاق, الاسم);
        إذا (اقبل(الرموز, المؤشر, رمز.نقطتان())) {
            طابق حلل_نمطا(المصدر, الرموز, المؤشر) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(القيمة) -> { نمط_الحقل := القيمة; };
        };
        ليكن الحقل: حقل_نمط = {
            الاسم: الاسم,
            النمط: نمط_الحقل
        };
        ألحق(الحقول, الحقل);
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
                توقع(الرموز, المؤشر, رمز.معقوف_يمين());
                أرجع اختياري.لا_شيء();
            };
        };
    }
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نمط.سجل(دمج_نطاق(البداية, النهاية), الحقول));
}

// A vector or slice pattern: `[]`, `[a, b]`, `[first, rest _]`,
// `[first, rest tail]`, `[rest _, last]`, `[first, rest middle, last]`. The
// word `rest` (`بقية`) followed by a name or `_` stands for the elements
// between the ones written, at most once; it is a word of this position only
// (هل_كلمة_بقية_حالية), so `[rest]` and `[rest, x]` bind a name `rest`.
عرف حلل_تسلسل_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري نمط {
    تقدم(الرموز, المؤشر);
    ليكن السابقة: متغير متجه نمط = [];
    ليكن البقية: متغير متجه نمط = [];
    ليكن اللاحقة: متغير متجه نمط = [];
    ليكن مستمر: متغير منطقي = نوع_الحالي(الرموز, المؤشر) != رمز.قوس_مربع_يمين();
    طالما (مستمر) {
        إذا (هل_كلمة_بقية_حالية(المصدر, الرموز, المؤشر)) {
            إذا ((الطول(البقية) مثل طبيعي) > 0) {
                // A second `rest`: which elements each stands for is unknown.
                ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.نمط(), رمز.قوس_مربع_يمين());
                أرجع اختياري.لا_شيء();
            };
            ليكن بداية_البقية: نطاق = نطاق_الحالي(الرموز, المؤشر);
            تقدم(الرموز, المؤشر);
            إذا (نوع_الحالي(الرموز, المؤشر) == رمز.معرف()) {
                ليكن الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
                تقدم(الرموز, المؤشر);
                ألحق(البقية, نمط.ربط(الاسم.النطاق, الاسم));
            } وإلا {
                ليكن نطاق_البقية: نطاق = دمج_نطاق(بداية_البقية, نطاق_الحالي(الرموز, المؤشر));
                تقدم(الرموز, المؤشر);
                ألحق(البقية, نمط.بدل(نطاق_البقية));
            };
        } وإلا {
            طابق حلل_نمطا(المصدر, الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> {
                إذا ((الطول(البقية) مثل طبيعي) > 0) {
                    ألحق(اللاحقة, القيمة);
                } وإلا {
                    ألحق(السابقة, القيمة);
                };
            };
        };
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            مستمر := خطأ;
        } وإلا إذا (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_مربع_يمين()) {
            مستمر := خطأ;
        };
    }
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_مربع_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نمط.تسلسل(دمج_نطاق(البداية, النهاية), السابقة, البقية, اللاحقة));
}

// `rest` (`بقية`) in a vector or slice pattern: the word, then a name or `_`.
عرف هل_كلمة_بقية_حالية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): منطقي {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) { أرجع خطأ; };
    ليكن التالي: رمز = نوع_التالي(الرموز, المؤشر);
    إذا (التالي != رمز.معرف() && التالي != رمز.شرطة_سفلية()) { أرجع خطأ; };
    ليكن النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    أرجع هل_نطاق_يساوي_نصا(المصدر, النطاق, «rest»)
        || هل_نطاق_يساوي_نصا(المصدر, النطاق, «بقية»);
}

عرف هل_بداية_حد_مدى(النوع: رمز): منطقي {
    أرجع (النوع == رمز.طرح())
        || (النوع == رمز.حرفي_عدد_صحيح())
        || (النوع == رمز.حرفي_حرف());
}

عرف حلل_حد_مدى(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري حرفي {
    إذا (!هل_بداية_حد_مدى(نوع_الحالي(الرموز, المؤشر))) {
        أرجع اختياري.لا_شيء();
    };
    طابق حلل_نمط_حرفيا(الرموز, المؤشر) مع
    | اختياري.موجود(نمط.حرفي(_, الحرفي)) -> { أرجع اختياري.موجود(الحرفي); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Whether `..` follows the bound that starts at token الموضع (`5`, `-5`,
// `'a'`).
عرف هل_نقطتان_بعد_حد(الرموز: &متجه رمز_مصدر, الموضع: طبيعي): منطقي {
    ليكن العدد: طبيعي = الطول(*الرموز) مثل طبيعي;
    إذا (الموضع >= العدد || !هل_بداية_حد_مدى(نوع_عند(الرموز, الموضع))) { أرجع خطأ; };
    ليكن بعده: متغير طبيعي = الموضع + 1;
    إذا (نوع_عند(الرموز, الموضع) == رمز.طرح()) { بعده := بعده + 1; };
    إذا (بعده + 1 >= العدد) { أرجع خطأ; };
    أرجع نوع_عند(الرموز, بعده) == رمز.نقطة() && نوع_عند(الرموز, بعده + 1) == رمز.نقطة();
}

// The contextual word `range` (`مدى`) before a range of values: followed by
// a bound (`range 1..9`) or by `..` (`range ..0`). Elsewhere `range` is an
// ordinary name.
عرف هل_كلمة_مدى_حالية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): منطقي {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) { أرجع خطأ; };
    ليكن التالي: طبيعي = فهرس_الحالي(المؤشر) + 1;
    ليكن العدد: طبيعي = الطول(*الرموز) مثل طبيعي;
    إذا (التالي + 1 >= العدد) { أرجع خطأ; };
    ليكن بعده_مدى: منطقي = هل_نقطتان_بعد_حد(الرموز, التالي)
        || (نوع_عند(الرموز, التالي) == رمز.نقطة() && نوع_عند(الرموز, التالي + 1) == رمز.نقطة());
    إذا (!بعده_مدى) { أرجع خطأ; };
    ليكن النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    أرجع هل_نطاق_يساوي_نصا(المصدر, النطاق, «range»)
        || هل_نطاق_يساوي_نصا(المصدر, النطاق, «مدى»);
}

// `range a..b`: the integers or characters from a through b, both ends
// included (`range 0..12`, `range 'a'..'z'`, `range -5..-1`). An open end
// reaches the end of the Type: `range 100..`, `range ..0`.
عرف حلل_نمط_مدى(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري نمط {
    تقدم(الرموز, المؤشر);
    ليكن الأدنى: متغير اختياري حرفي = اختياري.لا_شيء();
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.نقطة()) {
        طابق حلل_حد_مدى(الرموز, المؤشر) مع
        | اختياري.موجود(القيمة) -> { الأدنى := اختياري.موجود(القيمة); }
        | اختياري.لا_شيء -> {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.نمط(), رمز.حرفي_عدد_صحيح());
            أرجع اختياري.لا_شيء();
        };
    };
    إذا (!توقع(الرموز, المؤشر, رمز.نقطة()) || !توقع(الرموز, المؤشر, رمز.نقطة())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الأعلى: متغير اختياري حرفي = اختياري.لا_شيء();
    إذا (هل_بداية_حد_مدى(نوع_الحالي(الرموز, المؤشر))) {
        طابق حلل_حد_مدى(الرموز, المؤشر) مع
        | اختياري.موجود(القيمة) -> { الأعلى := اختياري.موجود(القيمة); }
        | اختياري.لا_شيء -> {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.نمط(), رمز.حرفي_عدد_صحيح());
            أرجع اختياري.لا_شيء();
        };
    } وإلا {
        // `range ..` has no end at all: a bound is missing.
        طابق الأدنى مع
        | اختياري.لا_شيء -> {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.نمط(), رمز.حرفي_عدد_صحيح());
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(_) -> { };
    };
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نمط.مدى(دمج_نطاق(البداية, النهاية), الأدنى, الأعلى));
}

عرف حلل_نمط_ذريا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري نمط {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    ليكن النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    إذا (هل_كلمة_مدى_حالية(المصدر, الرموز, المؤشر)) {
        أرجع حلل_نمط_مدى(الرموز, المؤشر, البداية);
    };
    إذا (هل_منشئ_تمهيدي_نمط(المصدر, الرموز, المؤشر)) {
        أرجع حلل_منشئ_تمهيدي_نمط(المصدر, الرموز, المؤشر, البداية);
    };
    // `1..9` without `range` is not a pattern: the help suggests the word.
    إذا (هل_نقطتان_بعد_حد(الرموز, فهرس_الحالي(المؤشر))) {
        ارفض_نطاقا(المؤشر, البداية, فئة_خطأ_نحوي.مدى_بلا_كلمته());
        أرجع اختياري.لا_شيء();
    };
    إذا ((النوع == رمز.طرح())
        || (النوع == رمز.حرفي_عدد_صحيح())
        || (النوع == رمز.حرفي_حرف())
        || (النوع == رمز.حرفي_منطقي())
        || (النوع == رمز.حرفي_نص())) {
        أرجع حلل_نمط_حرفيا(الرموز, المؤشر);
    };
    إذا (النوع == رمز.شرطة_سفلية()) {
        تقدم(الرموز, المؤشر);
        أرجع اختياري.موجود(نمط.بدل(البداية));
    };
    إذا (النوع == رمز.قوس_يسار()) {
        أرجع حلل_صف_نمط(المصدر, الرموز, المؤشر, البداية);
    };
    إذا (النوع == رمز.معقوف_يسار()) {
        أرجع حلل_سجل_نمط(المصدر, الرموز, المؤشر, البداية);
    };
    إذا (النوع == رمز.قوس_مربع_يسار()) {
        أرجع حلل_تسلسل_نمط(المصدر, الرموز, المؤشر, البداية);
    };
    إذا (النوع != رمز.معرف()) {
        ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    ليكن الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نقطة()) {
        أرجع حلل_منشئ_نمط(المصدر, الرموز, المؤشر, الاسم, البداية);
    };
    أرجع اختياري.موجود(نمط.ربط(البداية, الاسم));
}

// A pattern: alternatives `p | q | ...` of any patterns, at any depth
// (`| Hand.Rock | Hand.Paper ->`, `| (0, x) | (x, 0) ->`, `Shape.Circle(1 | 2)`),
// then any number of `as name` (`مثل name`), which binds weakest:
// `A | B as x` names the value either alternative matched.
// Whether every alternative binds the same names, with the same Types, is
// checked once the Types are known (pattern/type_validation.sn).
عام عرف حلل_نمطا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري نمط {
    ليكن الناتج: متغير نمط;
    طابق حلل_بدائل_نمط(المصدر, الرموز, المؤشر) مع
    | اختياري.موجود(القيمة) -> { الناتج := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طالما (اقبل(الرموز, المؤشر, رمز.تحويل_نوع())) {
        إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.نمط(), رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        ليكن الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        ليكن النطاق: نطاق = دمج_نطاق(نطاق_نمط(&الناتج), الاسم.النطاق);
        ليكن الداخل: صندوق نمط = صندوق الناتج;
        الناتج := نمط.مستعار(النطاق, الداخل, الاسم);
    }
    أرجع اختياري.موجود(الناتج);
}

عرف حلل_بدائل_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري نمط {
    ليكن الأول: نمط;
    طابق حلل_نمط_ذريا(المصدر, الرموز, المؤشر) مع
    | اختياري.موجود(القيمة) -> { الأول := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.أو_بتي()) {
        أرجع اختياري.موجود(الأول);
    };
    ليكن البدائل: متغير متجه نمط = [الأول];
    طالما (اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
        ليكن التالي: نمط;
        طابق حلل_نمط_ذريا(المصدر, الرموز, المؤشر) مع
        | اختياري.موجود(القيمة) -> { التالي := القيمة; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        ألحق(البدائل, التالي);
    }
    ليكن عدد_البدائل: عدد = الطول(البدائل);
    ليكن آخر_بديل: عدد = عدد_البدائل - 1;
    ليكن النهاية: نطاق = نطاق_نمط(&البدائل[آخر_بديل]);
    ليكن البداية: نطاق = نطاق_نمط(&البدائل[0]);
    أرجع اختياري.موجود(نمط.بدائل(دمج_نطاق(البداية, النهاية), البدائل));
}
