// تحليل صياغة الأنماط فقط؛ صلاحية النمط الدلالية تتحقق في مرحلة لاحقة.


عرف حلل_نمط_حرفيا(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري نمط {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    إذا (النوع == رمز.طرح()) {
        تقدم(الرموز, المؤشر);
        إذا (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_عدد_صحيح()) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
            ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_عدد_صحيح());
            أرجع اختياري.لا_شيء();
        };
        دع محاولة_القيمة: اختياري قيمة_عدد_صحيح_رمز = قيمة_عدد_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق محاولة_القيمة مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            دع النهاية: نطاق = نطاق_الحالي(الرموز, المؤشر);
            طابق حرفي_عدد_سالب_من_قيمة_رمز(القيمة) مع
            | اختياري.لا_شيء -> {
                دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
                ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_عدد_صحيح());
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(الحرفي) -> {
                تقدم(الرموز, المؤشر);
                أرجع اختياري.موجود(نمط.حرفي(دمج_نطاق(البداية, النهاية), الحرفي));
            };
        };
    };
    إذا (النوع == رمز.حرفي_عدد_صحيح()) {
        طابق قيمة_عدد_عند(الرموز, فهرس_الحالي(المؤشر)) مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            أرجع اختياري.موجود(نمط.حرفي(البداية, حرفي_عدد_من_قيمة_رمز(القيمة)));
        };
    };
    إذا (النوع == رمز.حرفي_حرف()) {
        طابق قيمة_محرف_عند(الرموز, فهرس_الحالي(المؤشر)) مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            أرجع اختياري.موجود(نمط.حرفي(البداية, حرفي.حرف(القيمة)));
        };
    };
    إذا (النوع == رمز.حرفي_منطقي()) {
        طابق قيمة_منطق_عند(الرموز, فهرس_الحالي(المؤشر)) مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            أرجع اختياري.موجود(نمط.حرفي(البداية, حرفي.منطقي(القيمة)));
        };
    };
    إذا (النوع == رمز.حرفي_نص()) {
        طابق نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر)) مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(البايتات) -> {
            تقدم(الرموز, المؤشر);
            أرجع اختياري.موجود(نمط.حرفي(البداية, حرفي.نص(البايتات)));
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف حلل_منشئ_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    النوع: اسم,
    البداية: نطاق
): اختياري نمط {
    إذا (!توقع(الرموز, المؤشر, رمز.نقطة())) {
        أرجع اختياري.لا_شيء();
    };
    دع نتيجة_الاسم: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
    طابق نتيجة_الاسم مع
    | نتيجة_اسم.غائب -> {
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_اسم.موجود(المنشئ) -> {
        دع الحمولات: متغير متجه نمط = [];
        إذا (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
            إذا (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
                دع مستمر: متغير منطقي = صواب;
                طالما (مستمر) {
                    دع النتيجة: اختياري نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
                    طابق النتيجة مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.لا_شيء();
                    }
                    | اختياري.موجود(القيمة) -> {
                        ألحق(الحمولات, القيمة);
                    };
                    إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                        مستمر := خطأ;
                    };
                }
            };
            إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                أرجع اختياري.لا_شيء();
            };
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختياري.موجود(نمط.منشئ(دمج_نطاق(البداية, النهاية), النوع, المنشئ, الحمولات));
    };
}

عرف حلل_صف_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري نمط {
    تقدم(الرموز, المؤشر);
    دع العناصر: متغير متجه نمط = [];
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            دع النتيجة: اختياري نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
            طابق النتيجة مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(القيمة) -> {
                ألحق(العناصر, القيمة);
            };
            إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                مستمر := خطأ;
            };
        }
    };
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نمط.صف(دمج_نطاق(البداية, النهاية), العناصر));
}

عرف حلل_سجل_نمط(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري نمط {
    تقدم(الرموز, المؤشر);
    دع الحقول: متغير متجه حقل_نمط = [];
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            أرجع اختياري.لا_شيء();
        };
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        إذا (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
            أرجع اختياري.لا_شيء();
        };
        دع النتيجة: اختياري نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
        طابق النتيجة مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            دع الحقل: حقل_نمط = {
                الاسم: الاسم,
                النمط: القيمة
            };
            ألحق(الحقول, الحقل);
        };
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
                توقع(الرموز, المؤشر, رمز.معقوف_يمين());
                أرجع اختياري.لا_شيء();
            };
        };
    }
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نمط.سجل(دمج_نطاق(البداية, النهاية), الحقول));
}

عرف هل_نطاق_يساوي_نصا(
    المصدر: &مصدر,
    النطاق: نطاق,
    المطلوب: نص
): منطقي {
    دع النص: نص = المطلوب;
    دع طول_النطاق: طبيعي = النطاق.النهاية.البايت - النطاق.البداية.البايت;
    إذا (طول_النطاق != (الطول(النص) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النطاق) {
        إذا (بايت_المصدر(المصدر, (النطاق.البداية.البايت مثل طبيعي) + ف) != النص[ف]) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف هل_كلمة_مدى_حالية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): منطقي {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) { أرجع خطأ; };
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    أرجع هل_نطاق_يساوي_نصا(المصدر, النطاق, «range»)
        || هل_نطاق_يساوي_نصا(المصدر, النطاق, «مدى»);
}

عرف هل_كلمة_إلى_حالية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): منطقي {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) { أرجع خطأ; };
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    أرجع هل_نطاق_يساوي_نصا(المصدر, النطاق, «to»)
        || هل_نطاق_يساوي_نصا(المصدر, النطاق, «إلى»);
}

عرف هل_بداية_حد_مدى(النوع: رمز): منطقي {
    أرجع (النوع == رمز.طرح())
        || (النوع == رمز.حرفي_عدد_صحيح())
        || (النوع == رمز.حرفي_حرف());
}

عرف حلل_حد_مدى(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري حرفي {
    إذا (!هل_بداية_حد_مدى(نوع_الحالي(الرموز, المؤشر))) {
        أرجع اختياري.لا_شيء();
    };
    طابق حلل_نمط_حرفيا(الرموز, المؤشر) مع
    | اختياري.موجود(نمط.حرفي(_, الحرفي)) -> { أرجع اختياري.موجود(الحرفي); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف حلل_نمط_مدى(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري نمط {
    تقدم(الرموز, المؤشر);
    دع الأدنى: حرفي;
    طابق حلل_حد_مدى(الرموز, المؤشر) مع
    | اختياري.موجود(القيمة) -> { الأدنى := القيمة; }
    | اختياري.لا_شيء -> {
        ارفض_داخليا(الرموز, المؤشر);
        أرجع اختياري.لا_شيء();
    };
    إذا (!هل_كلمة_إلى_حالية(المصدر, الرموز, المؤشر)) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    تقدم(الرموز, المؤشر);
    دع الأعلى: حرفي;
    طابق حلل_حد_مدى(الرموز, المؤشر) مع
    | اختياري.موجود(القيمة) -> { الأعلى := القيمة; }
    | اختياري.لا_شيء -> {
        ارفض_داخليا(الرموز, المؤشر);
        أرجع اختياري.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نمط.مدى(دمج_نطاق(البداية, النهاية), الأدنى, الأعلى));
}

عرف حلل_نمط_ذريا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري نمط {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    إذا (هل_كلمة_مدى_حالية(المصدر, الرموز, المؤشر)) {
        أرجع حلل_نمط_مدى(المصدر, الرموز, المؤشر, البداية);
    };
    إذا ((النوع == رمز.طرح())
        || (النوع == رمز.حرفي_عدد_صحيح())
        || (النوع == رمز.حرفي_حرف())
        || (النوع == رمز.حرفي_منطقي())
        || (النوع == رمز.حرفي_نص())) {
        أرجع حلل_نمط_حرفيا(الرموز, المؤشر);
    };
    إذا (النوع == رمز.شرطة_سفلية()) {
        تقدم(الرموز, المؤشر);
        أرجع اختياري.موجود(نمط.بدل(البداية));
    };
    إذا (النوع == رمز.قوس_يسار()) {
        أرجع حلل_صف_نمط(المصدر, الرموز, المؤشر, البداية);
    };
    إذا (النوع == رمز.معقوف_يسار()) {
        أرجع حلل_سجل_نمط(المصدر, الرموز, المؤشر, البداية);
    };
    إذا (النوع != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نقطة()) {
        أرجع حلل_منشئ_نمط(المصدر, الرموز, المؤشر, الاسم, البداية);
    };
    أرجع اختياري.موجود(نمط.ربط(البداية, الاسم));
}

عرف هل_نمط_بديل_حرفي(النمط: &نمط): منطقي {
    طابق *النمط مع
    | نمط.حرفي(_, _) -> { أرجع صواب; }
    | نمط.مدى(_, _, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف حلل_نمطا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري نمط {
    دع الأول: نمط;
    طابق حلل_نمط_ذريا(المصدر, الرموز, المؤشر) مع
    | اختياري.موجود(القيمة) -> { الأول := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    إذا (!هل_نمط_بديل_حرفي(&الأول) || (نوع_الحالي(الرموز, المؤشر) != رمز.أو_بتي())) {
        أرجع اختياري.موجود(الأول);
    };
    دع البدائل: متغير متجه نمط = [الأول];
    طالما (اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
        دع التالي: نمط;
        طابق حلل_نمط_ذريا(المصدر, الرموز, المؤشر) مع
        | اختياري.موجود(القيمة) -> { التالي := القيمة; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        إذا (!هل_نمط_بديل_حرفي(&التالي)) {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        };
        ألحق(البدائل, التالي);
    }
    دع عدد_البدائل: عدد = الطول(البدائل);
    دع آخر_بديل: عدد = عدد_البدائل - 1;
    دع النهاية: نطاق = نطاق_نمط(&البدائل[آخر_بديل]);
    دع البداية: نطاق = نطاق_نمط(&البدائل[0]);
    أرجع اختياري.موجود(نمط.بدائل(دمج_نطاق(البداية, النهاية), البدائل));
}
