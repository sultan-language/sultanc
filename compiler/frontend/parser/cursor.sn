استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.parser.error;

// يتحرك بين الرموز. غياب الخطأ يعني أن المؤشر سليم؛ أول رفض فقط يملك التشخيص.
عام نوع مؤشر = {
    الموضع: غير_موقع,
    الخطأ: اختيار خطأ_نحوي
};

عام عرف مؤشر_جديد(): مؤشر {
    دع بلا_خطأ: اختيار خطأ_نحوي = اختيار.لا_شيء();
    دع الناتج: مؤشر = {
        الموضع: 0,
        الخطأ: بلا_خطأ
    };
    أرجع الناتج;
}

عام عرف فهرس_الحالي(المؤشر: &متغير مؤشر): غير_موقع {
    دع الحالة: مؤشر = *المؤشر;
    أرجع الحالة.الموضع;
}

عام عرف نوع_عند(الرموز: &متجه رمز_مصدر, الموضع: غير_موقع): رمز {
    دع القيم: متجه رمز_مصدر = *الرموز;
    أرجع القيم[الموضع].النوع;
}

عام عرف نطاق_عند(الرموز: &متجه رمز_مصدر, الموضع: غير_موقع): نطاق {
    دع القيم: متجه رمز_مصدر = *الرموز;
    أرجع القيم[الموضع].النطاق;
}

عام عرف نوع_الحالي(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): رمز {
    أرجع نوع_عند(الرموز, فهرس_الحالي(المؤشر));
}

عام عرف نطاق_الحالي(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): نطاق {
    أرجع نطاق_عند(الرموز, فهرس_الحالي(المؤشر));
}

عام عرف نوع_التالي(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): رمز {
    دع القيم: متجه رمز_مصدر = *الرموز;
    دع العدد: غير_موقع = الطول(القيم) مثل غير_موقع;
    دع التالي: غير_موقع = فهرس_الحالي(المؤشر) + 1;
    لو (التالي >= العدد) {
        أرجع رمز.نهاية_الملف();
    };
    أرجع نوع_عند(الرموز, التالي);
}

عام عرف المؤشر_سليم(المؤشر: &متغير مؤشر): منطقي {
    دع الحالة: مؤشر = *المؤشر;
    طابق الحالة.الخطأ مع
    | اختيار.لا_شيء -> {
        أرجع صواب;
    }
    | اختيار.بعض(الخطأ) -> {
        أرجع خطأ;
    };
}

عام عرف تقدم(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): منطقي {
    لو (!المؤشر_سليم(المؤشر)) {
        أرجع خطأ;
    };
    دع الحالة: متغير مؤشر = *المؤشر;
    دع القيم: متجه رمز_مصدر = *الرموز;
    دع العدد: غير_موقع = الطول(القيم) مثل غير_موقع;
    دع التالي: غير_موقع = الحالة.الموضع + 1;
    لو (التالي < العدد) {
        الحالة.الموضع := التالي;
    };
    *المؤشر := الحالة;
    أرجع صواب;
}

عام عرف اقبل(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    النوع: رمز
): منطقي {
    لو (!المؤشر_سليم(المؤشر)) {
        أرجع خطأ;
    };
    لو (نوع_الحالي(الرموز, المؤشر) != النوع) {
        أرجع خطأ;
    };
    أرجع تقدم(الرموز, المؤشر);
}

عام عرف ارفض(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الفئة: فئة_خطأ_نحوي,
    المتوقع: رمز
): منطقي {
    دع الحالة: متغير مؤشر = *المؤشر;
    طابق الحالة.الخطأ مع
    | اختيار.بعض(الأول) -> {
        // first rejection wins: لا يكتب أي رفض لاحق فوق التشخيص الأصلي.
        أرجع خطأ;
    }
    | اختيار.لا_شيء -> {
        دع موضع_الرفض: غير_موقع = فهرس_الحالي(المؤشر);
        دع نطاق_الخطأ: متغير نطاق = نطاق_الحالي(الرموز, المؤشر);
        دع الموجود: رمز = نوع_الحالي(الرموز, المؤشر);
        لو (الفئة == فئة_خطأ_نحوي.عبارة_بلا_عملية() && موضع_الرفض > 0) {
            نطاق_الخطأ := نطاق_عند(الرموز, موضع_الرفض - 1);
        };
        دع نطاق_الإدراج: متغير اختيار نطاق = اختيار.لا_شيء();
        دع نطاق_الفاصلة_المنقوطة_في_غير_موضعها: متغير اختيار نطاق = اختيار.لا_شيء();
        دع بلا_اقتراح_تهجئة: تهجئة_كلمة_مقترحة = تهجئة_كلمة_مقترحة.بلا_اقتراح();
        دع الفئة_الفعلية: متغير فئة_خطأ_نحوي = الفئة;
        لو (الفئة == فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود() && موضع_الرفض > 0) {
            دع السابق: نطاق = نطاق_عند(الرموز, موضع_الرفض - 1);
            دع نقطة_الإدراج: نطاق = نطاق_بين(السابق.النهاية, السابق.النهاية);
            نطاق_الإدراج := اختيار.بعض(نقطة_الإدراج);
        };
        لو (المتوقع == رمز.فاصلة_منقوطة() && موضع_الرفض > 0) {
            دع السابق: نطاق = نطاق_عند(الرموز, موضع_الرفض - 1);
            دع نقطة_الإدراج: نطاق = نطاق_بين(السابق.النهاية, السابق.النهاية);
            نطاق_الإدراج := اختيار.بعض(نقطة_الإدراج);
            لو (
                الموجود == رمز.معقوف_يمين()
                && نوع_التالي(الرموز, المؤشر) == رمز.فاصلة_منقوطة()
            ) {
                نطاق_الفاصلة_المنقوطة_في_غير_موضعها := اختيار.بعض(
                    نطاق_عند(الرموز, موضع_الرفض + 1)
                );
                الفئة_الفعلية := فئة_خطأ_نحوي.فاصلة_منقوطة_في_غير_موضعها();
            };
        };
        دع الخطأ: خطأ_نحوي = {
            الفئة: الفئة_الفعلية,
            النطاق: نطاق_الخطأ,
            نطاق_الإدراج: نطاق_الإدراج,
            نطاق_الفاصلة_المنقوطة_في_غير_موضعها: نطاق_الفاصلة_المنقوطة_في_غير_موضعها,
            التهجئة_المقترحة: بلا_اقتراح_تهجئة,
            المتوقع: المتوقع,
            الموجود: الموجود
        };
        الحالة.الخطأ := اختيار.بعض(الخطأ);
        *المؤشر := الحالة;
        أرجع خطأ;
    };
}

عام عرف ارفض_تهجئة_كلمة_محجوزة(
    المؤشر: &متغير مؤشر,
    النطاق: نطاق,
    المتوقع: رمز,
    التهجئة: تهجئة_كلمة_مقترحة
): منطقي {
    دع الحالة: متغير مؤشر = *المؤشر;
    طابق الحالة.الخطأ مع
    | اختيار.بعض(الأول) -> {
        أرجع خطأ;
    }
    | اختيار.لا_شيء -> {
        دع بلا_إدراج: اختيار نطاق = اختيار.لا_شيء();
        دع بلا_فاصلة_منقوطة: اختيار نطاق = اختيار.لا_شيء();
        دع فئة_التهجئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.تهجئة_كلمة_محجوزة_محتملة();
        دع رمز_المعرف: رمز = رمز.معرف();
        دع الخطأ: خطأ_نحوي = {
            الفئة: فئة_التهجئة,
            النطاق: النطاق,
            نطاق_الإدراج: بلا_إدراج,
            نطاق_الفاصلة_المنقوطة_في_غير_موضعها: بلا_فاصلة_منقوطة,
            التهجئة_المقترحة: التهجئة,
            المتوقع: المتوقع,
            الموجود: رمز_المعرف
        };
        الحالة.الخطأ := اختيار.بعض(الخطأ);
        *المؤشر := الحالة;
        أرجع خطأ;
    };
}

عام عرف ارفض_داخليا(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): منطقي {
    أرجع ارفض(
        الرموز, المؤشر, فئة_خطأ_نحوي.داخلي(), نوع_الحالي(الرموز, المؤشر)
    );
}

عام عرف توقع(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    النوع: رمز
): منطقي {
    لو (اقبل(الرموز, المؤشر, النوع)) {
        أرجع صواب;
    };
    أرجع ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), النوع);
}

عام عرف نطاق_السابق(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): نطاق {
    دع الموضع: غير_موقع = فهرس_الحالي(المؤشر);
    لو (الموضع == 0) {
        أرجع نطاق_عند(الرموز, 0);
    };
    أرجع نطاق_عند(الرموز, الموضع - 1);
}

عام عرف خطأ_المؤشر(المؤشر: &متغير مؤشر): اختيار خطأ_نحوي {
    دع الحالة: مؤشر = *المؤشر;
    أرجع الحالة.الخطأ;
}

// Tooling recovery only: clear the first parser rejection after it has been
// recorded by the caller, then force progress to a synchronization token.
عام عرف امسح_خطأ_المؤشر(المؤشر: &متغير مؤشر): فراغ {
    دع الحالة: متغير مؤشر = *المؤشر;
    الحالة.الخطأ := اختيار.لا_شيء();
    *المؤشر := الحالة;
}

عام عرف تقدم_قسريا(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): منطقي {
    دع الحالة: متغير مؤشر = *المؤشر;
    دع القيم: متجه رمز_مصدر = *الرموز;
    دع العدد: غير_موقع = الطول(القيم) مثل غير_موقع;
    دع التالي: غير_موقع = الحالة.الموضع + 1;
    لو (التالي >= العدد) { أرجع خطأ; };
    الحالة.الموضع := التالي;
    *المؤشر := الحالة;
    أرجع صواب;
}
