استورد compiler.frontend.lexer.payload;
استورد compiler.frontend.ast.literals;

// تحويل حمولة العدد المعجمي إلى قيمة حرفية مشتركة بين التعبيرات والأنماط.
عام عرف حرفي_عدد_من_قيمة_رمز(القيمة: قيمة_عدد_صحيح_رمز): حرفي {
    طابق القيمة مع
    | قيمة_عدد_صحيح_رمز.موقع(العدد) -> { أرجع حرفي.عدد(العدد); }
    | قيمة_عدد_صحيح_رمز.طبيعي(العدد) -> { أرجع حرفي.عدد_طبيعي(العدد); };
}

// السالب جزء من صياغة الحرفي هنا فقط عندما يمكن تمثيله دلاليا كعدد موقع.
عام عرف حرفي_عدد_سالب_من_قيمة_رمز(القيمة: قيمة_عدد_صحيح_رمز): اختياري حرفي {
    طابق القيمة مع
    | قيمة_عدد_صحيح_رمز.موقع(العدد) -> {
        أرجع اختياري.موجود(حرفي.عدد(0 - العدد));
    }
    | قيمة_عدد_صحيح_رمز.طبيعي(المقدار) -> {
        دع أعلى_موقع: طبيعي = 9223372036854775807 مثل طبيعي;
        دع حد_أدنى_موقع: طبيعي = أعلى_موقع + 1;
        لو (المقدار == حد_أدنى_موقع) {
            دع قبل_الأدنى: عدد = 0 - 9223372036854775807;
            دع الأدنى: عدد = قبل_الأدنى - 1;
            أرجع اختياري.موجود(حرفي.عدد(الأدنى));
        };
        أرجع اختياري.لا_شيء();
    };
}
