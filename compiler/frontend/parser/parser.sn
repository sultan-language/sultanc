// The parser is recursive descent: its recursion follows the nesting of
// brackets ((, [, {), of prefix operators (- ! & * ~ in a row) and of
// `else if` chains (each link is an `if` nested in the previous `else`, in
// the parse and in the tree every later pass walks; its braces close before
// the next link, so bracket depth alone never sees the chain). One scan
// before parsing bounds both, as clang's -fbracket-depth does (256 by
// default), so input nested deeper is a syntax error at the bracket or
// operator that crosses the limit instead of a stack overflow in any of the
// recursive functions.
عام عرف حد_تعشيش_المحلل(): طبيعي { أرجع 256; }

عرف عامل_بادئ_محتمل(النوع: رمز): منطقي {
    أرجع النوع == رمز.طرح() || النوع == رمز.نفي() || النوع == رمز.و_بتي()
        || النوع == رمز.نجمة() || النوع == رمز.متمم();
}

عام عرف تحقق_عمق_تعشيش_الرموز(الرموز: &متجه رمز_مصدر): اختياري خطأ_نحوي {
    دع الأقواس: متغير طبيعي = 0;
    دع البادئات: متغير طبيعي = 0;
    // Open `else if` links per bracket depth: they nest until the statement
    // that holds the chain ends (a `;` at that depth, or its block closing).
    دع روابط_عند: متغير متجه طبيعي = [0];
    دع الروابط: متغير طبيعي = 0;
    دع السابق: متغير رمز = رمز.فاصلة_منقوطة();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        دع النوع: رمز = (*الرموز)[ف].النوع;
        إذا (النوع == رمز.قوس_يسار() || النوع == رمز.قوس_مربع_يسار() || النوع == رمز.معقوف_يسار()) {
            الأقواس := الأقواس + 1;
            البادئات := 0;
            طالما ((الطول(روابط_عند) مثل طبيعي) <= الأقواس) { ألحق(روابط_عند, 0); }
            روابط_عند[الأقواس] := 0;
        } وإلا إذا (النوع == رمز.قوس_يمين() || النوع == رمز.قوس_مربع_يمين() || النوع == رمز.معقوف_يمين()) {
            الروابط := الروابط - روابط_عند[الأقواس];
            روابط_عند[الأقواس] := 0;
            إذا (الأقواس > 0) { الأقواس := الأقواس - 1; };
            البادئات := 0;
        } وإلا إذا (النوع == رمز.فاصلة_منقوطة()) {
            الروابط := الروابط - روابط_عند[الأقواس];
            روابط_عند[الأقواس] := 0;
            البادئات := 0;
        } وإلا إذا (النوع == رمز.إذا() && السابق == رمز.وإلا()) {
            روابط_عند[الأقواس] := روابط_عند[الأقواس] + 1;
            الروابط := الروابط + 1;
            البادئات := 0;
        } وإلا إذا (عامل_بادئ_محتمل(النوع)) {
            البادئات := البادئات + 1;
        } وإلا {
            البادئات := 0;
        };
        السابق := النوع;
        إذا (الأقواس + الروابط + البادئات > حد_تعشيش_المحلل()) {
            دع الخطأ: خطأ_نحوي = {
                الفئة: فئة_خطأ_نحوي.تعشيش_عميق_جدا(),
                النطاق: (*الرموز)[ف].النطاق,
                نطاق_الإدراج: اختياري.لا_شيء(),
                نطاق_الفاصلة_المنقوطة_في_غير_موضعها: اختياري.لا_شيء(),
                التهجئة_المقترحة: تهجئة_كلمة_مقترحة.بلا_اقتراح(),
                المتوقع: النوع,
                الموجود: النوع
            };
            أرجع اختياري.موجود(الخطأ);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف وحدة_فارغة_لمحلل(المصدر: &مصدر): وحدة_مصدر {
    دع استيرادات_فارغة: متجه استيراد = [];
    دع عناصر_فارغة: متجه عنصر_وحدة = [];
    دع مرادفات_فارغة: متجه تصريح_مرادف_اسم = [];
    دع مستبعدة_فارغة: متجه نطاق = [];
    دع وحدات_فارغة: متجه نطاق = [];
    دع فارغ: وحدة_مصدر = {
        معرف_المصدر: (*المصدر).المعرف,
        الاستيرادات: استيرادات_فارغة, العناصر: عناصر_فارغة, مرادفات_الأسماء: مرادفات_فارغة,
        المستبعدة_للهدف: مستبعدة_فارغة, تصريحات_الوحدات: وحدات_فارغة
    };
    أرجع فارغ;
}

// مدخل التحليل النحوي يستهلك رموزا دلالية جاهزة ولا يفرّع حسب لغة source.
عام عرف حلل_الرموز(المصدر: &مصدر, الرموز: &متجه رمز_مصدر): نتيجة_تحليل {
    طابق تحقق_عمق_تعشيش_الرموز(الرموز) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تحليل.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع المؤشر: متغير مؤشر = مؤشر_جديد();
    أرجع حلل_وحدة(المصدر, الرموز, & متغير المؤشر);
}

// IDE/tooling entry point. It uses the same grammar builders as strict parsing,
// but declaration-level recovery lets later valid declarations remain semantic.
عام عرف حلل_الرموز_للأدوات(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    الأخطاء: &متغير متجه خطأ_نحوي
): وحدة_مصدر {
    طابق تحقق_عمق_تعشيش_الرموز(الرموز) مع
    | اختياري.موجود(الخطأ) -> { ألحق(*الأخطاء, الخطأ); أرجع وحدة_فارغة_لمحلل(المصدر); }
    | اختياري.لا_شيء -> { };
    دع المؤشر: متغير مؤشر = مؤشر_جديد();
    أرجع حلل_وحدة_للأدوات(المصدر, الرموز, &متغير المؤشر, الأخطاء);
}

// Target-aware parser entry for compilation and package export discovery.
// The historical target-neutral API remains for tools and older clients.
عام عرف حلل_الرموز_لهدف(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, الهدف: &اختياري واصف_هدف
): نتيجة_تحليل {
    طابق تحقق_عمق_تعشيش_الرموز(الرموز) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تحليل.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع المؤشر: متغير مؤشر = مؤشر_جديد();
    أرجع حلل_وحدة_لهدف(المصدر, الرموز, &متغير المؤشر, الهدف);
}

// Recovery preserves the historical permissive parser for target-neutral source.
// A top-level platform guard, however, must never be recovered by blindly
// collecting declarations from an inactive arm. Parse that source with the
// selected target, and leave its tree empty if the guard is invalid.
عام عرف حلل_الرموز_للأدوات_لهدف(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    الهدف: &اختياري واصف_هدف,
    الأخطاء: &متغير متجه خطأ_نحوي
): وحدة_مصدر {
    دع العمق: متغير طبيعي = 0;
    دع حارس: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        دع النوع: رمز = (*الرموز)[ف].النوع;
        إذا (العمق == 0 && النوع == رمز.إذا()) { حارس := صواب; };
        إذا (النوع == رمز.معقوف_يسار()) { العمق := العمق + 1; };
        إذا (النوع == رمز.معقوف_يمين() && العمق > 0) { العمق := العمق - 1; };
        ف := ف + 1;
    }
    إذا (!حارس) {
        أرجع حلل_الرموز_للأدوات(المصدر, الرموز, الأخطاء);
    };
    طابق حلل_الرموز_لهدف(المصدر, الرموز, الهدف) مع
    | نتيجة_تحليل.شجرة(الشجرة) -> { أرجع الشجرة; }
    | نتيجة_تحليل.مرفوض(الخطأ) -> { ألحق(*الأخطاء, الخطأ); }
    | نتيجة_تحليل.خلل_داخلي -> { };
    أرجع وحدة_فارغة_لمحلل(المصدر);
}
