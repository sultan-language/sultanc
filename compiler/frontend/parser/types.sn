// تحليل صياغة الأنواع وبناء عقدها في ast.

عرف نوع_بدائي(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار نوع_تركيبي {
    دع الرمز: رمز = نوع_الحالي(الرموز, المؤشر);
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع البدائي: اختيار نوع_تركيبي = عقدة_نوع_بدائي_من_رمز(الرمز, النطاق);
    طابق البدائي مع
    | اختيار.بعض(النوع) -> {
        تقدم(الرموز, المؤشر);
        أرجع اختيار.بعض(النوع);
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف نوع_ملفوف(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الغلاف: رمز
): اختيار نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع نتيجة_الداخل: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق نتيجة_الداخل مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الداخل) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        دع الصندوق: صندوق نوع_تركيبي = صندوق الداخل;
        طابق الغلاف مع
        | رمز.متغير -> {
            أرجع اختيار.بعض(نوع_تركيبي.متغير(النطاق, الصندوق));
        }
        | رمز.صندوق -> {
            أرجع اختيار.بعض(نوع_تركيبي.صندوق(النطاق, الصندوق));
        }
        | رمز.نجمة -> {
            أرجع اختيار.بعض(نوع_تركيبي.مؤشر(النطاق, الصندوق));
        }
        | رمز.و_بتي -> {
            أرجع اختيار.بعض(نوع_تركيبي.مرجع(النطاق, الصندوق));
        }
        | رمز.شريحة -> {
            أرجع اختيار.بعض(نوع_تركيبي.شريحة(النطاق, الصندوق));
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}

عرف نوع_ملفوف_سياقي(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الصنف: صنف_اسم_نوع_سياقي
): اختيار نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع نتيجة_الداخل: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق نتيجة_الداخل مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الداخل) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        دع الصندوق: صندوق نوع_تركيبي = صندوق الداخل;
        طابق الصنف مع
        | صنف_اسم_نوع_سياقي.اختيار -> { أرجع اختيار.بعض(نوع_تركيبي.اختيار(النطاق, الصندوق)); }
        | صنف_اسم_نوع_سياقي.متجه -> { أرجع اختيار.بعض(نوع_تركيبي.متجه(النطاق, الصندوق)); }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عرف حلل_صف_نوع(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختيار.لا_شيء();
    };
    دع العناصر: متغير متجه نوع_تركيبي = [];
    لو (اقبل(الرموز, المؤشر, رمز.قوس_يمين())) {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختيار.بعض(نوع_تركيبي.صف(دمج_نطاق(البداية, النهاية), العناصر));
    };
    دع أول: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق أول مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(القيمة) -> {
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                أرجع اختيار.لا_شيء();
            };
            أرجع اختيار.بعض(القيمة);
        };
        ألحق(العناصر, القيمة);
    };
    بينما (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع التالي: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
        طابق التالي مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(القيمة) -> {
            ألحق(العناصر, القيمة);
        };
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            دع مهمل: عدد = 0;
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختيار.بعض(نوع_تركيبي.صف(دمج_نطاق(البداية, النهاية), العناصر));
}

عرف حلل_نوع_دالة(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختيار.لا_شيء();
    };
    دع المعاملات: متغير متجه نوع_تركيبي = [];
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع التالي: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
            طابق التالي مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            }
            | اختيار.بعض(القيمة) -> {
                ألحق(المعاملات, القيمة);
            };
            لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                مستمر := خطأ;
            };
        }
    };
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
        أرجع اختيار.لا_شيء();
    };
    دع الناتج: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(القيمة) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع صندوق_الناتج: صندوق نوع_تركيبي = صندوق القيمة;
        أرجع اختيار.بعض(نوع_تركيبي.دالة(دمج_نطاق(البداية, النهاية), المعاملات, صندوق_الناتج));
    };
}

عرف حلل_نتيجة_نوع(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع النتيجة: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق النتيجة مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(نوع_نجاح) -> {
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة())) {
            أرجع اختيار.لا_شيء();
        };
        دع التالي: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
        طابق التالي مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(نوع_فشل) -> {
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع أ: صندوق نوع_تركيبي = صندوق نوع_نجاح;
            دع ب: صندوق نوع_تركيبي = صندوق نوع_فشل;
            أرجع اختيار.بعض(نوع_تركيبي.نتيجة(دمج_نطاق(البداية, النهاية), أ, ب));
        };
    };
}

عرف حلل_شريحة_مختصرة(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع داخل: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق داخل مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(القيمة) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع ص: صندوق نوع_تركيبي = صندوق القيمة;
        أرجع اختيار.بعض(نوع_تركيبي.شريحة(دمج_نطاق(البداية, النهاية), ص));
    };
}

عرف حلل_نوع_مسمى(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار نوع_تركيبي {
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        أرجع اختيار.لا_شيء();
    };
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع الحجج: متغير متجه نوع_تركيبي = [];
    لو (اقبل(الرموز, المؤشر, رمز.أصغر())) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.أكبر()) {
            دع مستمر: متغير منطقي = صواب;
            بينما (مستمر) {
                دع حجة: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
                طابق حجة مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.لا_شيء();
                }
                | اختيار.بعض(القيمة) -> {
                    ألحق(الحجج, القيمة);
                };
                لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                    مستمر := خطأ;
                };
            }
        };
        لو (!توقع(الرموز, المؤشر, رمز.أكبر())) {
            أرجع اختيار.لا_شيء();
        };
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختيار.بعض(نوع_تركيبي.مسمى(دمج_نطاق(البداية, النهاية), الاسم, الحجج));
}

عام عرف حلل_نوعا(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار نوع_تركيبي {
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    لو (النوع == رمز.نوع_دالة()) {
        أرجع حلل_نوع_دالة(المصدر, الرموز, المؤشر);
    };
    لو (النوع == رمز.قوس_يسار()) {
        أرجع حلل_صف_نوع(المصدر, الرموز, المؤشر);
    };
    لو ((النوع == رمز.متغير()) || (النوع == رمز.صندوق())) {
        أرجع نوع_ملفوف(المصدر, الرموز, المؤشر, النوع);
    };
    لو (
        (النوع == رمز.نجمة())
        || (النوع == رمز.و_بتي())
        || (النوع == رمز.شريحة())
    ) {
        أرجع نوع_ملفوف(المصدر, الرموز, المؤشر, النوع);
    };
    لو (النوع == رمز.معرف()) {
        دع صنف_سياقي: صنف_اسم_نوع_سياقي = صنف_اسم_نوع_سياقي_في_نطاق(
            المصدر, نطاق_الحالي(الرموز, المؤشر)
        );
        طابق صنف_سياقي مع
        | صنف_اسم_نوع_سياقي.اختيار -> {
            أرجع نوع_ملفوف_سياقي(المصدر, الرموز, المؤشر, صنف_سياقي);
        }
        | صنف_اسم_نوع_سياقي.متجه -> {
            أرجع نوع_ملفوف_سياقي(المصدر, الرموز, المؤشر, صنف_سياقي);
        }
        | صنف_اسم_نوع_سياقي.نتيجة -> {
            أرجع حلل_نتيجة_نوع(المصدر, الرموز, المؤشر);
        }
        | صنف_اسم_نوع_سياقي.عادي -> { };
    };
    لو ((النوع == رمز.قوس_مربع_يسار()) && (نوع_التالي(الرموز, المؤشر) == رمز.قوس_مربع_يمين())) {
        أرجع حلل_شريحة_مختصرة(المصدر, الرموز, المؤشر);
    };
    دع بدائي: اختيار نوع_تركيبي = نوع_بدائي(الرموز, المؤشر);
    طابق بدائي مع
    | اختيار.بعض(القيمة) -> {
        أرجع اختيار.بعض(القيمة);
    }
    | اختيار.لا_شيء -> {
        دع المسمى: اختيار نوع_تركيبي = حلل_نوع_مسمى(المصدر, الرموز, المؤشر);
        طابق المسمى مع
        | اختيار.بعض(القيمة) -> {
            أرجع اختيار.بعض(القيمة);
        }
        | اختيار.لا_شيء -> {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نوع();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختيار.لا_شيء();
        };
    };
}
