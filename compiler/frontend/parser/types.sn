// تحليل صياغة الأنواع وبناء عقدها في ast.

عرف نوع_بدائي(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري نوع_تركيبي {
    دع الرمز: رمز = نوع_الحالي(الرموز, المؤشر);
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع البدائي: اختياري نوع_تركيبي = عقدة_نوع_بدائي_من_رمز(الرمز, النطاق);
    طابق البدائي مع
    | اختياري.موجود(النوع) -> {
        تقدم(الرموز, المؤشر);
        أرجع اختياري.موجود(النوع);
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف نوع_ملفوف(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الغلاف: رمز
): اختياري نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع نتيجة_الداخل: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق نتيجة_الداخل مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الداخل) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        دع الصندوق: صندوق نوع_تركيبي = صندوق الداخل;
        طابق الغلاف مع
        | رمز.متغير -> {
            أرجع اختياري.موجود(نوع_تركيبي.متغير(النطاق, الصندوق));
        }
        | رمز.صندوق -> {
            أرجع اختياري.موجود(نوع_تركيبي.صندوق(النطاق, الصندوق));
        }
        | رمز.نجمة -> {
            أرجع اختياري.موجود(نوع_تركيبي.مؤشر(النطاق, الصندوق));
        }
        | رمز.و_بتي -> {
            أرجع اختياري.موجود(نوع_تركيبي.مرجع(النطاق, الصندوق));
        }
        | رمز.شريحة -> {
            أرجع اختياري.موجود(نوع_تركيبي.شريحة(النطاق, الصندوق));
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف نوع_ملفوف_سياقي(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الصنف: صنف_اسم_نوع_سياقي
): اختياري نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع نتيجة_الداخل: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق نتيجة_الداخل مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الداخل) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        دع الصندوق: صندوق نوع_تركيبي = صندوق الداخل;
        طابق الصنف مع
        | صنف_اسم_نوع_سياقي.اختياري -> { أرجع اختياري.موجود(نوع_تركيبي.اختيار(النطاق, الصندوق)); }
        | صنف_اسم_نوع_سياقي.متجه -> { أرجع اختياري.موجود(نوع_تركيبي.متجه(النطاق, الصندوق)); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف حلل_صف_نوع(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    دع العناصر: متغير متجه نوع_تركيبي = [];
    إذا (اقبل(الرموز, المؤشر, رمز.قوس_يمين())) {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختياري.موجود(نوع_تركيبي.صف(دمج_نطاق(البداية, النهاية), العناصر));
    };
    دع أول: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق أول مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(القيمة) -> {
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(القيمة);
        };
        ألحق(العناصر, القيمة);
    };
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع التالي: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
        طابق التالي مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            ألحق(العناصر, القيمة);
        };
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            دع مهمل: عدد = 0;
        };
    }
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نوع_تركيبي.صف(دمج_نطاق(البداية, النهاية), العناصر));
}

عرف حلل_نوع_دالة(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    دع المعاملات: متغير متجه نوع_تركيبي = [];
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            دع التالي: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
            طابق التالي مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(القيمة) -> {
                ألحق(المعاملات, القيمة);
            };
            إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                مستمر := خطأ;
            };
        }
    };
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    إذا (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
        أرجع اختياري.لا_شيء();
    };
    دع الناتج: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق الناتج مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(القيمة) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع صندوق_الناتج: صندوق نوع_تركيبي = صندوق القيمة;
        أرجع اختياري.موجود(نوع_تركيبي.دالة(دمج_نطاق(البداية, النهاية), المعاملات, صندوق_الناتج));
    };
}

عرف حلل_نتيجة_نوع(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع النتيجة: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق النتيجة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(نوع_نجاح) -> {
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة())) {
            أرجع اختياري.لا_شيء();
        };
        دع التالي: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
        طابق التالي مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(نوع_فشل) -> {
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع أ: صندوق نوع_تركيبي = صندوق نوع_نجاح;
            دع ب: صندوق نوع_تركيبي = صندوق نوع_فشل;
            أرجع اختياري.موجود(نوع_تركيبي.نتيجة(دمج_نطاق(البداية, النهاية), أ, ب));
        };
    };
}

عرف حلل_شريحة_مختصرة(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري نوع_تركيبي {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع داخل: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق داخل مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(القيمة) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع ص: صندوق نوع_تركيبي = صندوق القيمة;
        أرجع اختياري.موجود(نوع_تركيبي.شريحة(دمج_نطاق(البداية, النهاية), ص));
    };
}

عرف حلل_نوع_مسمى(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري نوع_تركيبي {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        أرجع اختياري.لا_شيء();
    };
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع الحجج: متغير متجه نوع_تركيبي = [];
    إذا (اقبل(الرموز, المؤشر, رمز.أصغر())) {
        إذا (نوع_الحالي(الرموز, المؤشر) != رمز.أكبر() && نوع_الحالي(الرموز, المؤشر) != رمز.إزاحة_يمنى()) {
            دع مستمر: متغير منطقي = صواب;
            طالما (مستمر) {
                دع حجة: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
                طابق حجة مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(القيمة) -> {
                    ألحق(الحجج, القيمة);
                };
                إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                    مستمر := خطأ;
                };
            }
        };
        إذا (!اغلق_زاوية_وسيطات_نوع(الرموز, المؤشر)) {
            أرجع اختياري.لا_شيء();
        };
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(نوع_تركيبي.مسمى(دمج_نطاق(البداية, النهاية), الاسم, الحجج));
}

عام عرف حلل_نوعا(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري نوع_تركيبي {
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    إذا (النوع == رمز.نوع_دالة()) {
        أرجع حلل_نوع_دالة(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.قوس_يسار()) {
        أرجع حلل_صف_نوع(المصدر, الرموز, المؤشر);
    };
    إذا ((النوع == رمز.متغير()) || (النوع == رمز.صندوق())) {
        أرجع نوع_ملفوف(المصدر, الرموز, المؤشر, النوع);
    };
    إذا (
        (النوع == رمز.نجمة())
        || (النوع == رمز.و_بتي())
        || (النوع == رمز.شريحة())
    ) {
        أرجع نوع_ملفوف(المصدر, الرموز, المؤشر, النوع);
    };
    إذا (النوع == رمز.معرف()) {
        دع صنف_سياقي: صنف_اسم_نوع_سياقي = صنف_اسم_نوع_سياقي_في_نطاق(
            المصدر, نطاق_الحالي(الرموز, المؤشر)
        );
        طابق صنف_سياقي مع
        | صنف_اسم_نوع_سياقي.اختياري -> {
            أرجع نوع_ملفوف_سياقي(المصدر, الرموز, المؤشر, صنف_سياقي);
        }
        | صنف_اسم_نوع_سياقي.متجه -> {
            أرجع نوع_ملفوف_سياقي(المصدر, الرموز, المؤشر, صنف_سياقي);
        }
        | صنف_اسم_نوع_سياقي.نتيجة -> {
            أرجع حلل_نتيجة_نوع(المصدر, الرموز, المؤشر);
        }
        | صنف_اسم_نوع_سياقي.عادي -> { };
    };
    إذا ((النوع == رمز.قوس_مربع_يسار()) && (نوع_التالي(الرموز, المؤشر) == رمز.قوس_مربع_يمين())) {
        أرجع حلل_شريحة_مختصرة(المصدر, الرموز, المؤشر);
    };
    دع بدائي: اختياري نوع_تركيبي = نوع_بدائي(الرموز, المؤشر);
    طابق بدائي مع
    | اختياري.موجود(القيمة) -> {
        أرجع اختياري.موجود(القيمة);
    }
    | اختياري.لا_شيء -> {
        دع المسمى: اختياري نوع_تركيبي = حلل_نوع_مسمى(المصدر, الرموز, المؤشر);
        طابق المسمى مع
        | اختياري.موجود(القيمة) -> {
            أرجع اختياري.موجود(القيمة);
        }
        | اختياري.لا_شيء -> {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نوع();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
    };
}
