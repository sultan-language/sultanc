// تحليل التصريحات وعناصر الوحدة دون حل أسماء أو تحقق دلالي للأنواع.

// معاملات النوع تتبع اسم التصريح مباشرة: Name<T, U>. لا تُحل هنا؛
// Name/Type layers own semantic identity and substitution.
عرف حلل_معاملات_نوع_تصريح(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار متجه اسم {
    دع المعاملات: متغير متجه اسم = [];
    لو (!اقبل(الرموز, المؤشر, رمز.أصغر())) {
        أرجع اختيار.بعض(المعاملات);
    };
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.أكبر()) {
        أرجع اختيار.لا_شيء();
    };
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            أرجع اختيار.لا_شيء();
        };
        ألحق(المعاملات, اسم_الحالي(الرموز, المؤشر));
        تقدم(الرموز, المؤشر);
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            مستمر := خطأ;
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.أكبر())) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(المعاملات);
}

عرف حلل_حقول_نوع(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار متجه حقل_نوع {
    دع الحقول: متغير متجه حقل_نوع = [];
    بينما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            أرجع اختيار.لا_شيء();
        };
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
            أرجع اختيار.لا_شيء();
        };
        دع النوع: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
        طابق النوع مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(ت) -> {
            دع الحقل: حقل_نوع = {
                الاسم: الاسم,
                النوع: ت
            };
            ألحق(الحقول, الحقل);
        };
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(الحقول);
}

عرف حلل_حمولات_منشئ(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار متجه نوع_تركيبي {
    دع الحمولات: متغير متجه نوع_تركيبي = [];
    لو (!اقبل(الرموز, المؤشر, رمز.بقيمة())) {
        أرجع اختيار.بعض(الحمولات);
    };
    لو (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع النوع: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
            طابق النوع مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            }
            | اختيار.بعض(ت) -> {
                ألحق(الحمولات, ت);
            };
            لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                مستمر := خطأ;
            };
        }
        لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
            أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(الحمولات);
    };
    دع النوع: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق النوع مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ت) -> {
        ألحق(الحمولات, ت);
        أرجع اختيار.بعض(الحمولات);
    };
}

عرف حلل_منشئات_نوع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار متجه منشئ_نوع {
    دع المنشئات: متغير متجه منشئ_نوع = [];
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع الاسم_نتيجة: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
        طابق الاسم_نتيجة مع
        | نتيجة_اسم.غائب -> {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نوع();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختيار.لا_شيء();
        }
        | نتيجة_اسم.موجود(الاسم) -> {
            دع الحمولات: اختيار متجه نوع_تركيبي = حلل_حمولات_منشئ(المصدر, الرموز, المؤشر);
            طابق الحمولات مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            }
            | اختيار.بعض(ح) -> {
                دع المنشئ: منشئ_نوع = {
                    الاسم: الاسم,
                    الحمولات: ح
                };
                ألحق(المنشئات, المنشئ);
            };
        };
        لو (!اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
            مستمر := خطأ;
        };
    }
    أرجع اختيار.بعض(المنشئات);
}

عرف حلل_شكل_تصريح_نوع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار شكل_تصريح_نوع {
    لو (اقبل(الرموز, المؤشر, رمز.معقوف_يسار())) {
        دع الحقول: اختيار متجه حقل_نوع = حلل_حقول_نوع(المصدر, الرموز, المؤشر);
        طابق الحقول مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(ح) -> {
            أرجع اختيار.بعض(شكل_تصريح_نوع.سجل(ح));
        };
    };
    لو (اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
        دع المنشئات: اختيار متجه منشئ_نوع = حلل_منشئات_نوع(المصدر, الرموز, المؤشر);
        طابق المنشئات مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(م) -> {
            أرجع اختيار.بعض(شكل_تصريح_نوع.تعداد(م));
        };
    };
    دع النوع: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق النوع مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ت) -> {
        أرجع اختيار.بعض(شكل_تصريح_نوع.مرادف(ت));
    };
}

عرف حلل_أسماء_دالة_بديلة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الاسم_الأساسي: &اسم
): اختيار متجه اسم {
    دع الأسماء: متغير متجه اسم = [];
    لو (!اقبل(الرموز, المؤشر, رمز.مرادف_تصريح())) {
        أرجع اختيار.بعض(الأسماء);
    };
    بينما (صواب) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختيار.لا_شيء();
        };
        دع البديل: اسم = اسم_الحالي(الرموز, المؤشر);
        لو (اسمان_بنفس_تهجئة_المصدر(المصدر, الاسم_الأساسي, &البديل)) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختيار.لا_شيء();
        };
        لو (اسم_موجود_في_قائمة_بنفس_تهجئة_المصدر(المصدر, &الأسماء, &البديل)) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختيار.لا_شيء();
        };
        ألحق(الأسماء, البديل);
        تقدم(الرموز, المؤشر);
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            أرجع اختيار.بعض(الأسماء);
        };
    }
    أرجع اختيار.بعض(الأسماء);
}

عرف حلل_معاملات(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار متجه معامل {
    دع المعاملات: متغير متجه معامل = [];
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختيار.لا_شيء();
    };
    بينما (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            أرجع اختيار.لا_شيء();
        };
        دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
            أرجع اختيار.لا_شيء();
        };
        دع النوع: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
        طابق النوع مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(ت) -> {
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع نطاق_المعامل: نطاق = دمج_نطاق(البداية, النهاية);
            دع المعامل: معامل = {
                الاسم: الاسم,
                النوع: ت,
                النطاق: نطاق_المعامل
            };
            ألحق(المعاملات, المعامل);
        };
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(المعاملات);
}

عرف أكمل_جسم_دالة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    الأسماء_البديلة: متجه اسم,
    علني: منطقي,
    خارجية: منطقي,
    المعاملات: متجه معامل,
    الناتج: نوع_تركيبي
): اختيار تصريح_دالة {
    لو (خارجية) {
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختيار.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع نطاق_الدالة: نطاق = دمج_نطاق(البداية, النهاية);
        دع بلا_جسم: اختيار كتلة_عبارات = اختيار.لا_شيء();
        دع الدالة: تصريح_دالة = {
            النطاق: نطاق_الدالة,
            الاسم: الاسم,
            معاملات_النوع: معاملات_النوع,
            الأسماء_البديلة: الأسماء_البديلة,
            علني: علني,
            المعاملات: المعاملات,
            الناتج: الناتج,
            الجسم: بلا_جسم
        };
        أرجع اختيار.بعض(الدالة);
    };
    دع الجسم: اختيار كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الجسم مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ك) -> {
        دع نطاق_الدالة: نطاق = دمج_نطاق(البداية, ك.النطاق);
        دع جسم_الدالة: اختيار كتلة_عبارات = اختيار.بعض(ك);
        دع الدالة: تصريح_دالة = {
            النطاق: نطاق_الدالة,
            الاسم: الاسم,
            معاملات_النوع: معاملات_النوع,
            الأسماء_البديلة: الأسماء_البديلة,
            علني: علني,
            المعاملات: المعاملات,
            الناتج: الناتج,
            الجسم: جسم_الدالة
        };
        أرجع اختيار.بعض(الدالة);
    };
}

عرف أكمل_دالة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    الأسماء_البديلة: متجه اسم,
    علني: منطقي,
    خارجية: منطقي,
    المعاملات: متجه معامل
): اختيار تصريح_دالة {
    لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
        أرجع اختيار.لا_شيء();
    };
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يسار()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
    دع الناتج: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ن) -> {
        أرجع أكمل_جسم_دالة(
            المصدر, الرموز, المؤشر, البداية, الاسم, معاملات_النوع, الأسماء_البديلة,
            علني, خارجية, المعاملات, ن
        );
    };
}

عرف ابن_دالة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    الأسماء_البديلة: متجه اسم,
    علني: منطقي,
    خارجية: منطقي
): اختيار تصريح_دالة {
    دع المعاملات: اختيار متجه معامل = حلل_معاملات(المصدر, الرموز, المؤشر);
    طابق المعاملات مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(م) -> {
        أرجع أكمل_دالة(
            المصدر, الرموز, المؤشر, البداية, الاسم, معاملات_النوع, الأسماء_البديلة,
            علني, خارجية, م
        );
    };
}

عرف حلل_عنصر_دالة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    علني: منطقي
): اختيار عنصر_وحدة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع خارجية: منطقي = اقبل(الرموز, المؤشر, رمز.خارجي());
    لو (!توقع(الرموز, المؤشر, رمز.تعريف_دالة())) {
        أرجع اختيار.لا_شيء();
    };
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع محاولة_معاملات_النوع: اختيار متجه اسم = حلل_معاملات_نوع_تصريح(الرموز, المؤشر);
    دع معاملات_النوع: متجه اسم;
    طابق محاولة_معاملات_النوع مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيم) -> { معاملات_النوع := القيم; };
    دع محاولة_الأسماء_البديلة: اختيار متجه اسم = حلل_أسماء_دالة_بديلة(
        المصدر, الرموز, المؤشر, &الاسم
    );
    طابق محاولة_الأسماء_البديلة مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الأسماء_البديلة) -> {
        دع الدالة: اختيار تصريح_دالة = ابن_دالة(
            المصدر, الرموز, المؤشر, البداية, الاسم, معاملات_النوع, الأسماء_البديلة, علني, خارجية
        );
        طابق الدالة مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(د) -> {
            أرجع اختيار.بعض(عنصر_وحدة.دالة(د));
        };
    };
}

عرف حلل_عنصر_نوع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    علني: منطقي
): اختيار عنصر_وحدة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نوع();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع محاولة_معاملات_النوع: اختيار متجه اسم = حلل_معاملات_نوع_تصريح(الرموز, المؤشر);
    دع معاملات_النوع: متجه اسم;
    طابق محاولة_معاملات_النوع مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيم) -> { معاملات_النوع := القيم; };
    لو (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) {
        أرجع اختيار.لا_شيء();
    };
    دع الشكل: اختيار شكل_تصريح_نوع = حلل_شكل_تصريح_نوع(المصدر, الرموز, المؤشر);
    طابق الشكل مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ش) -> {
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختيار.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع نطاق_التصريح: نطاق = دمج_نطاق(البداية, النهاية);
        دع التصريح: تصريح_نوع = {
            النطاق: نطاق_التصريح,
            الاسم: الاسم,
            معاملات_النوع: معاملات_النوع,
            علني: علني,
            الشكل: ش
        };
        أرجع اختيار.بعض(عنصر_وحدة.نوع(التصريح));
    };
}

عرف حلل_مرادف_اسم(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    علني: منطقي
): اختيار تصريح_مرادف_اسم {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    لو (علني) {
        تقدم(الرموز, المؤشر);
    };
    لو (!توقع(الرموز, المؤشر, رمز.مرادف_تصريح())) {
        أرجع اختيار.لا_شيء();
    };
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
    دع أول_الوجهة: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع أب_الوجهة: متغير اختيار اسم = اختيار.لا_شيء();
    دع الاسم: متغير اسم = أول_الوجهة;
    لو (اقبل(الرموز, المؤشر, رمز.نقطة())) {
        دع نتيجة_الاسم: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
        طابق نتيجة_الاسم مع
        | نتيجة_اسم.غائب -> {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختيار.لا_شيء();
        }
        | نتيجة_اسم.موجود(اسم_الابن) -> {
            أب_الوجهة := اختيار.بعض(أول_الوجهة);
            الاسم := اسم_الابن;
        };
    };
    لو (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) {
        أرجع اختيار.لا_شيء();
    };
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
    دع أول_الهدف: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع أب_الهدف: متغير اختيار اسم = اختيار.لا_شيء();
    دع الهدف: متغير اسم = أول_الهدف;
    لو (اقبل(الرموز, المؤشر, رمز.نقطة())) {
        دع نتيجة_الهدف: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
        طابق نتيجة_الهدف مع
        | نتيجة_اسم.غائب -> {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختيار.لا_شيء();
        }
        | نتيجة_اسم.موجود(اسم_الابن) -> {
            أب_الهدف := اختيار.بعض(أول_الهدف);
            الهدف := اسم_الابن;
        };
    };
    لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        أرجع اختيار.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع نطاق_التصريح: نطاق = دمج_نطاق(البداية, النهاية);
    دع التصريح: تصريح_مرادف_اسم = {
        النطاق: نطاق_التصريح,
        أب_الوجهة: أب_الوجهة,
        الاسم: الاسم,
        أب_الهدف: أب_الهدف,
        الهدف: الهدف,
        علني: علني
    };
    أرجع اختيار.بعض(التصريح);
}

عرف حلل_مسار_وحدة_انتقائي(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار متجه اسم {
    دع الأجزاء: متغير متجه اسم = [];
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
    ألحق(الأجزاء, اسم_الحالي(الرموز, المؤشر));
    تقدم(الرموز, المؤشر);
    بينما (اقبل(الرموز, المؤشر, رمز.نقطة())) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختيار.لا_شيء();
        };
        ألحق(الأجزاء, اسم_الحالي(الرموز, المؤشر));
        تقدم(الرموز, المؤشر);
    }
    أرجع اختيار.بعض(الأجزاء);
}

عرف حلل_استيرادا_انتقائيا(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار استيراد {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);

    دع المسار: متجه اسم;
    طابق حلل_مسار_وحدة_انتقائي(الرموز, المؤشر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { المسار := القيمة; };

    لو (!توقع(الرموز, المؤشر, رمز.استيراد())) {
        أرجع اختيار.لا_شيء();
    };

    دع الأسماء: متغير متجه اسم = [];
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
    ألحق(الأسماء, اسم_الحالي(الرموز, المؤشر));
    تقدم(الرموز, المؤشر);
    بينما (اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختيار.لا_شيء();
        };
        ألحق(الأسماء, اسم_الحالي(الرموز, المؤشر));
        تقدم(الرموز, المؤشر);
    }
    دع النهاية: متغير نطاق = نطاق_السابق(الرموز, المؤشر);
    لو (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        النهاية := نطاق_السابق(الرموز, المؤشر);
    };
    أرجع اختيار.بعض(
        استيراد.انتقائي(دمج_نطاق(البداية, النهاية), المسار, الأسماء)
    );
}

عرف حلل_استيرادا(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار استيراد {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.حرفي_نص()) {
        دع المحاولة: اختيار متجه غ8 = نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختيار.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(النص) -> {
            تقدم(الرموز, المؤشر);
            دع المرادف: متغير اختيار اسم = اختيار.لا_شيء();
            لو (اقبل(الرموز, المؤشر, رمز.تحويل_نوع())) {
                لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
                    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
                    ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
                    أرجع اختيار.لا_شيء();
                };
                المرادف := اختيار.بعض(اسم_الحالي(الرموز, المؤشر));
                تقدم(الرموز, المؤشر);
            };
            لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                أرجع اختيار.لا_شيء();
            };
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            أرجع اختيار.بعض(استيراد.نص(دمج_نطاق(البداية, النهاية), النص, المرادف));
        };
    };
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.معرف()) {
        دع المسار: متغير متجه اسم = [];
        ألحق(المسار, اسم_الحالي(الرموز, المؤشر));
        تقدم(الرموز, المؤشر);
        بينما (اقبل(الرموز, المؤشر, رمز.نقطة())) {
            لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
                دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
                ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
                أرجع اختيار.لا_شيء();
            };
            ألحق(المسار, اسم_الحالي(الرموز, المؤشر));
            تقدم(الرموز, المؤشر);
        }
        دع المرادف: متغير اختيار اسم = اختيار.لا_شيء();
        لو (اقبل(الرموز, المؤشر, رمز.تحويل_نوع())) {
            لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
                دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
                ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
                أرجع اختيار.لا_شيء();
            };
            المرادف := اختيار.بعض(اسم_الحالي(الرموز, المؤشر));
            تقدم(الرموز, المؤشر);
        };
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختيار.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختيار.بعض(استيراد.اسم(دمج_نطاق(البداية, النهاية), المسار, المرادف));
    };
    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
    ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_نص());
    أرجع اختيار.لا_شيء();
}

عرف حلل_تجميعا_عاما(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار عنصر_وحدة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_نص()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_نص());
        أرجع اختيار.لا_شيء();
    };
    دع المحاولة: اختيار متجه غ8 = نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر));
    طابق المحاولة مع
    | اختيار.لا_شيء -> {
        ارفض_داخليا(الرموز, المؤشر);
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النص) -> {
        تقدم(الرموز, المؤشر);
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختيار.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختيار.بعض(عنصر_وحدة.تجميع(دمج_نطاق(البداية, النهاية), النص));
    };
}

عرف حلل_عنصر_حسب_النوع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    علني: منطقي,
    النوع: رمز
): اختيار عنصر_وحدة {
    لو (النوع == رمز.نوع()) {
        أرجع حلل_عنصر_نوع(المصدر, الرموز, المؤشر, علني);
    };
    لو ((النوع == رمز.خارجي()) || (النوع == رمز.تعريف_دالة())) {
        أرجع حلل_عنصر_دالة(المصدر, الرموز, المؤشر, علني);
    };
    لو ((!علني) && (النوع == رمز.تجميع())) {
        أرجع حلل_تجميعا_عاما(الرموز, المؤشر);
    };

    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
    ارفض(الرموز, المؤشر, الفئة, رمز.تعريف_دالة());
    أرجع اختيار.لا_شيء();
}

عرف حلل_عنصرا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار عنصر_وحدة {
    دع علني: متغير منطقي = خطأ;
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.عام()) {
        علني := صواب;
        تقدم(الرموز, المؤشر);
    };

    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    أرجع حلل_عنصر_حسب_النوع(المصدر, الرموز, المؤشر, علني, النوع);
}

عرف رفض_المؤشر_كنتيجة(المؤشر: &متغير مؤشر): نتيجة_تحليل {
    دع الخطأ: اختيار خطأ_نحوي = خطأ_المؤشر(المؤشر);
    طابق الخطأ مع
    | اختيار.بعض(القيمة) -> {
        أرجع نتيجة_تحليل.مرفوض(القيمة);
    }
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تحليل.خلل_داخلي();
    };
}

عرف هل_بداية_عنصر_علوي_للأدوات(النوع: رمز): منطقي {
    أرجع النوع == رمز.عام()
        || النوع == رمز.مرادف_تصريح()
        || النوع == رمز.من_مصدر()
        || النوع == رمز.استيراد()
        || النوع == رمز.نوع()
        || النوع == رمز.خارجي()
        || النوع == رمز.تعريف_دالة()
        || النوع == رمز.تجميع()
        || النوع == رمز.نهاية_الملف();
}

عرف زامن_بعد_خطأ_أدوات(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): فراغ {
    امسح_خطأ_المؤشر(المؤشر);
    بينما (
        نوع_الحالي(الرموز, المؤشر) != رمز.نهاية_الملف()
        && !هل_بداية_عنصر_علوي_للأدوات(نوع_الحالي(الرموز, المؤشر))
    ) {
        لو (!تقدم_قسريا(الرموز, المؤشر)) { أرجع; };
    }
}

// Tooling recovery is deliberately top-level only. It never fabricates AST nodes:
// malformed declarations are omitted, while every successfully parsed declaration
// before/after them uses the exact strict-parser builders above.
عام عرف حلل_وحدة_للأدوات(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الأخطاء: &متغير متجه خطأ_نحوي
): وحدة_مصدر {
    دع الاستيرادات: متغير متجه استيراد = [];
    دع العناصر: متغير متجه عنصر_وحدة = [];
    دع مرادفات_الأسماء: متغير متجه تصريح_مرادف_اسم = [];

    بينما (نوع_الحالي(الرموز, المؤشر) != رمز.نهاية_الملف()) {
        دع نجح: متغير منطقي = خطأ;
        لو (
            (نوع_الحالي(الرموز, المؤشر) == رمز.عام())
            && (نوع_التالي(الرموز, المؤشر) == رمز.مرادف_تصريح())
        ) {
            طابق حلل_مرادف_اسم(الرموز, المؤشر, صواب) مع
            | اختيار.بعض(م) -> { ألحق(مرادفات_الأسماء, م); نجح := صواب; }
            | اختيار.لا_شيء -> { };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.مرادف_تصريح()) {
            طابق حلل_مرادف_اسم(الرموز, المؤشر, خطأ) مع
            | اختيار.بعض(م) -> { ألحق(مرادفات_الأسماء, م); نجح := صواب; }
            | اختيار.لا_شيء -> { };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.من_مصدر()) {
            طابق حلل_استيرادا_انتقائيا(الرموز, المؤشر) مع
            | اختيار.بعض(ا) -> { ألحق(الاستيرادات, ا); نجح := صواب; }
            | اختيار.لا_شيء -> { };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.استيراد()) {
            طابق حلل_استيرادا(الرموز, المؤشر) مع
            | اختيار.بعض(ا) -> { ألحق(الاستيرادات, ا); نجح := صواب; }
            | اختيار.لا_شيء -> { };
        }
        وإلا {
            طابق حلل_عنصرا(المصدر, الرموز, المؤشر) مع
            | اختيار.بعض(ع) -> { ألحق(العناصر, ع); نجح := صواب; }
            | اختيار.لا_شيء -> { };
        };

        لو (!نجح) {
            طابق خطأ_المؤشر(المؤشر) مع
            | اختيار.بعض(الخطأ) -> { دع حالة_الأخطاء: متغير متجه خطأ_نحوي = *الأخطاء;
                ألحق(حالة_الأخطاء, الخطأ);
                *الأخطاء := حالة_الأخطاء; }
            | اختيار.لا_شيء -> { };
            زامن_بعد_خطأ_أدوات(الرموز, المؤشر);
        };
    }

    دع نسخة: مصدر = *المصدر;
    دع الوحدة: وحدة_مصدر = {
        المصدر: نسخة,
        الاستيرادات: الاستيرادات,
        العناصر: العناصر,
        مرادفات_الأسماء: مرادفات_الأسماء
    };
    أرجع الوحدة;
}

عام عرف حلل_وحدة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): نتيجة_تحليل {
    دع الاستيرادات: متغير متجه استيراد = [];
    دع العناصر: متغير متجه عنصر_وحدة = [];
    دع مرادفات_الأسماء: متغير متجه تصريح_مرادف_اسم = [];
    بينما (نوع_الحالي(الرموز, المؤشر) != رمز.نهاية_الملف()) {
        لو (
            (نوع_الحالي(الرموز, المؤشر) == رمز.عام())
            && (نوع_التالي(الرموز, المؤشر) == رمز.مرادف_تصريح())
        ) {
            دع المرادف: اختيار تصريح_مرادف_اسم = حلل_مرادف_اسم(الرموز, المؤشر, صواب);
            طابق المرادف مع
            | اختيار.لا_شيء -> {
                أرجع رفض_المؤشر_كنتيجة(المؤشر);
            }
            | اختيار.بعض(م) -> {
                ألحق(مرادفات_الأسماء, م);
            };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.مرادف_تصريح()) {
            دع المرادف: اختيار تصريح_مرادف_اسم = حلل_مرادف_اسم(الرموز, المؤشر, خطأ);
            طابق المرادف مع
            | اختيار.لا_شيء -> { أرجع رفض_المؤشر_كنتيجة(المؤشر); }
            | اختيار.بعض(م) -> { ألحق(مرادفات_الأسماء, م); };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.من_مصدر()) {
            دع الاستيراد: اختيار استيراد = حلل_استيرادا_انتقائيا(الرموز, المؤشر);
            طابق الاستيراد مع
            | اختيار.لا_شيء -> {
                أرجع رفض_المؤشر_كنتيجة(المؤشر);
            }
            | اختيار.بعض(ا) -> {
                ألحق(الاستيرادات, ا);
            };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.استيراد()) {
            دع الاستيراد: اختيار استيراد = حلل_استيرادا(الرموز, المؤشر);
            طابق الاستيراد مع
            | اختيار.لا_شيء -> {
                أرجع رفض_المؤشر_كنتيجة(المؤشر);
            }
            | اختيار.بعض(ا) -> {
                ألحق(الاستيرادات, ا);
            };
        }
        وإلا {
            دع العنصر: اختيار عنصر_وحدة = حلل_عنصرا(المصدر, الرموز, المؤشر);
            طابق العنصر مع
            | اختيار.لا_شيء -> {
                أرجع رفض_المؤشر_كنتيجة(المؤشر);
            }
            | اختيار.بعض(ع) -> {
                ألحق(العناصر, ع);
            };
        };
    }
    دع نسخة: مصدر = *المصدر;
    دع الوحدة: وحدة_مصدر = {
        المصدر: نسخة,
        الاستيرادات: الاستيرادات,
        العناصر: العناصر,
        مرادفات_الأسماء: مرادفات_الأسماء
    };
    أرجع نتيجة_تحليل.شجرة(الوحدة);
}
