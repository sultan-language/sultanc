// تحليل التصريحات وعناصر الوحدة دون حل أسماء أو تحقق دلالي للأنواع.

عرف سمات_تصريح_فارغة(): متجه سمة_تصريح {
    دع السمات: متجه سمة_تصريح = [];
    أرجع السمات;
}

// A text literal naming a native linker identity: an external data symbol, an
// external function's link name, or the library that exports it. Native
// linker names are nonempty byte strings without embedded NUL.
عرف حلل_نص_ربط_أصلي(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري متجه ط8 {
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_نص()) {
        ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.حرفي_نص());
        أرجع اختياري.لا_شيء();
    };
    دع النص: متجه ط8;
    طابق نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر)) مع
    | اختياري.موجود(القيمة) -> { النص := القيمة; }
    | اختياري.لا_شيء -> { ارفض_داخليا(الرموز, المؤشر); أرجع اختياري.لا_شيء(); };
    لو ((الطول(النص) مثل طبيعي) == 0) {
        ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.حرفي_نص());
        أرجع اختياري.لا_شيء();
    };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(النص) مثل طبيعي)) {
        لو (النص[الفهرس] == 0) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.حرفي_نص());
            أرجع اختياري.لا_شيء();
        };
        الفهرس := الفهرس + 1;
    }
    تقدم(الرموز, المؤشر);
    أرجع اختياري.موجود(النص);
}

// معاملات النوع تتبع اسم التصريح مباشرة: Name<T, U>. لا تُحل هنا؛
// Name/Type layers own semantic identity and substitution.
عرف حلل_معاملات_نوع_تصريح(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري متجه اسم {
    دع المعاملات: متغير متجه اسم = [];
    لو (!اقبل(الرموز, المؤشر, رمز.أصغر())) {
        أرجع اختياري.موجود(المعاملات);
    };
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.أكبر()) {
        أرجع اختياري.لا_شيء();
    };
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            أرجع اختياري.لا_شيء();
        };
        ألحق(المعاملات, اسم_الحالي(الرموز, المؤشر));
        تقدم(الرموز, المؤشر);
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            مستمر := خطأ;
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.أكبر())) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(المعاملات);
}

عرف حلل_حقول_نوع(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري متجه حقل_نوع {
    دع الحقول: متغير متجه حقل_نوع = [];
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            أرجع اختياري.لا_شيء();
        };
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
            أرجع اختياري.لا_شيء();
        };
        دع النوع: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
        طابق النوع مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ت) -> {
            دع الحقل: حقل_نوع = {
                الاسم: الاسم,
                النوع: ت
            };
            ألحق(الحقول, الحقل);
        };
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(الحقول);
}

عرف حلل_حمولات_منشئ(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري متجه نوع_تركيبي {
    دع الحمولات: متغير متجه نوع_تركيبي = [];
    لو (!اقبل(الرموز, المؤشر, رمز.بقيمة())) {
        أرجع اختياري.موجود(الحمولات);
    };
    لو (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            دع النوع: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
            طابق النوع مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(ت) -> {
                ألحق(الحمولات, ت);
            };
            لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                مستمر := خطأ;
            };
        }
        لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(الحمولات);
    };
    دع النوع: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق النوع مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ت) -> {
        ألحق(الحمولات, ت);
        أرجع اختياري.موجود(الحمولات);
    };
}

عرف حلل_منشئات_نوع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري متجه منشئ_نوع {
    دع المنشئات: متغير متجه منشئ_نوع = [];
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع الاسم_نتيجة: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
        طابق الاسم_نتيجة مع
        | نتيجة_اسم.غائب -> {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نوع();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختياري.لا_شيء();
        }
        | نتيجة_اسم.موجود(الاسم) -> {
            دع الحمولات: اختياري متجه نوع_تركيبي = حلل_حمولات_منشئ(المصدر, الرموز, المؤشر);
            طابق الحمولات مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(ح) -> {
                دع المنشئ: منشئ_نوع = {
                    الاسم: الاسم,
                    الحمولات: ح
                };
                ألحق(المنشئات, المنشئ);
            };
        };
        لو (!اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
            مستمر := خطأ;
        };
    }
    أرجع اختياري.موجود(المنشئات);
}

عرف حلل_شكل_تصريح_نوع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري شكل_تصريح_نوع {
    لو (اقبل(الرموز, المؤشر, رمز.معقوف_يسار())) {
        دع الحقول: اختياري متجه حقل_نوع = حلل_حقول_نوع(المصدر, الرموز, المؤشر);
        طابق الحقول مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ح) -> {
            أرجع اختياري.موجود(شكل_تصريح_نوع.سجل(ح));
        };
    };
    لو (اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
        دع المنشئات: اختياري متجه منشئ_نوع = حلل_منشئات_نوع(المصدر, الرموز, المؤشر);
        طابق المنشئات مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(م) -> {
            أرجع اختياري.موجود(شكل_تصريح_نوع.تعداد(م));
        };
    };
    دع النوع: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق النوع مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ت) -> {
        أرجع اختياري.موجود(شكل_تصريح_نوع.مرادف(ت));
    };
}

عرف حلل_أسماء_دالة_بديلة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الاسم_الأساسي: &اسم
): اختياري متجه اسم {
    دع الأسماء: متغير متجه اسم = [];
    لو (!اقبل(الرموز, المؤشر, رمز.مرادف_تصريح())) {
        أرجع اختياري.موجود(الأسماء);
    };
    طالما (صواب) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        دع البديل: اسم = اسم_الحالي(الرموز, المؤشر);
        لو (اسمان_بنفس_تهجئة_المصدر(المصدر, الاسم_الأساسي, &البديل)) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        لو (اسم_موجود_في_قائمة_بنفس_تهجئة_المصدر(المصدر, &الأسماء, &البديل)) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        ألحق(الأسماء, البديل);
        تقدم(الرموز, المؤشر);
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            أرجع اختياري.موجود(الأسماء);
        };
    }
    أرجع اختياري.موجود(الأسماء);
}

عرف حلل_معاملات(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري متجه معامل {
    دع المعاملات: متغير متجه معامل = [];
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع وقت_الترجمة_مطلوب: منطقي = اقبل(الرموز, المؤشر, رمز.وقت_الترجمة());
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
            أرجع اختياري.لا_شيء();
        };
        دع النوع: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
        طابق النوع مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ت) -> {
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع نطاق_المعامل: نطاق = دمج_نطاق(البداية, النهاية);
            دع المعامل: معامل = {
                الاسم: الاسم,
                النوع: ت,
                النطاق: نطاق_المعامل,
                مطلوب_مسبقا: وقت_الترجمة_مطلوب
            };
            ألحق(المعاملات, المعامل);
        };
        لو (
            نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()
            && !توقع(الرموز, المؤشر, رمز.فاصلة())
        ) {
            أرجع اختياري.لا_شيء();
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(المعاملات);
}

عرف أكمل_جسم_دالة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    الأسماء_البديلة: متجه اسم,
    علني: منطقي,
    خارجية: منطقي,
    المعاملات: متجه معامل,
    الناتج: نوع_تركيبي
): اختياري تصريح_دالة {
    لو (خارجية) {
        // `= «symbol»` binds the declaration to an exact linker symbol (Rust's
        // link_name, an asm label in C) when it differs from the source name.
        دع اسم_الربط: متغير اختياري متجه ط8 = اختياري.لا_شيء();
        لو (اقبل(الرموز, المؤشر, رمز.فاصل_تعريف())) {
            طابق حلل_نص_ربط_أصلي(الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { اسم_الربط := اختياري.موجود(القيمة); };
        };
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع نطاق_الدالة: نطاق = دمج_نطاق(البداية, النهاية);
        دع بلا_جسم: اختياري كتلة_عبارات = اختياري.لا_شيء();
        دع الدالة: تصريح_دالة = {
            النطاق: نطاق_الدالة,
            الاسم: الاسم,
            معاملات_النوع: معاملات_النوع,
            الأسماء_البديلة: الأسماء_البديلة,
            علني: علني,
            المعاملات: المعاملات,
            الناتج: الناتج,
            السمات: سمات_تصريح_فارغة(),
            الجسم: بلا_جسم,
            المكتبة_الخارجية: اختياري.لا_شيء(),
            اسم_الربط: اسم_الربط
        };
        أرجع اختياري.موجود(الدالة);
    };
    دع الجسم: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الجسم مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ك) -> {
        دع نطاق_الدالة: نطاق = دمج_نطاق(البداية, ك.النطاق);
        دع جسم_الدالة: اختياري كتلة_عبارات = اختياري.موجود(ك);
        دع الدالة: تصريح_دالة = {
            النطاق: نطاق_الدالة,
            الاسم: الاسم,
            معاملات_النوع: معاملات_النوع,
            الأسماء_البديلة: الأسماء_البديلة,
            علني: علني,
            المعاملات: المعاملات,
            الناتج: الناتج,
            السمات: سمات_تصريح_فارغة(),
            الجسم: جسم_الدالة,
            المكتبة_الخارجية: اختياري.لا_شيء(),
            اسم_الربط: اختياري.لا_شيء()
        };
        أرجع اختياري.موجود(الدالة);
    };
}

عرف أكمل_دالة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    الأسماء_البديلة: متجه اسم,
    علني: منطقي,
    خارجية: منطقي,
    المعاملات: متجه معامل
): اختياري تصريح_دالة {
    لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
        أرجع اختياري.لا_شيء();
    };
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يسار()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نوع_ناتج_دالة_مفقود();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    دع الناتج: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق الناتج مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ن) -> {
        أرجع أكمل_جسم_دالة(
            المصدر, الرموز, المؤشر, البداية, الاسم, معاملات_النوع, الأسماء_البديلة,
            علني, خارجية, المعاملات, ن
        );
    };
}

عرف ابن_دالة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الاسم: اسم,
    معاملات_النوع: متجه اسم,
    الأسماء_البديلة: متجه اسم,
    علني: منطقي,
    خارجية: منطقي
): اختياري تصريح_دالة {
    دع المعاملات: اختياري متجه معامل = حلل_معاملات(المصدر, الرموز, المؤشر);
    طابق المعاملات مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(م) -> {
        أرجع أكمل_دالة(
            المصدر, الرموز, المؤشر, البداية, الاسم, معاملات_النوع, الأسماء_البديلة,
            علني, خارجية, م
        );
    };
}

عرف حلل_عنصر_دالة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    علني: منطقي
): اختياري عنصر_وحدة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع خارجية: منطقي = اقبل(الرموز, المؤشر, رمز.خارجي());
    // `خارجي «library» عرف`: the platform library that exports the function,
    // named at the declaration (as Rust names it with
    // `#[link(name = ...)]` on an extern block).
    دع المكتبة: متغير اختياري متجه ط8 = اختياري.لا_شيء();
    لو (خارجية && نوع_الحالي(الرموز, المؤشر) == رمز.حرفي_نص()) {
        طابق حلل_نص_ربط_أصلي(الرموز, المؤشر) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { المكتبة := اختياري.موجود(القيمة); };
    };
    لو (!توقع(الرموز, المؤشر, رمز.تعريف_دالة())) {
        أرجع اختياري.لا_شيء();
    };
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع محاولة_معاملات_النوع: اختياري متجه اسم = حلل_معاملات_نوع_تصريح(الرموز, المؤشر);
    دع معاملات_النوع: متجه اسم;
    طابق محاولة_معاملات_النوع مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيم) -> { معاملات_النوع := القيم; };
    دع محاولة_الأسماء_البديلة: اختياري متجه اسم = حلل_أسماء_دالة_بديلة(
        المصدر, الرموز, المؤشر, &الاسم
    );
    طابق محاولة_الأسماء_البديلة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأسماء_البديلة) -> {
        دع الدالة: اختياري تصريح_دالة = ابن_دالة(
            المصدر, الرموز, المؤشر, البداية, الاسم, معاملات_النوع, الأسماء_البديلة, علني, خارجية
        );
        طابق الدالة مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(د) -> {
            دع المعدلة: متغير تصريح_دالة = د;
            المعدلة.المكتبة_الخارجية := المكتبة;
            أرجع اختياري.موجود(عنصر_وحدة.دالة(المعدلة));
        };
    };
}

عرف حلل_عنصر_نوع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    علني: منطقي
): اختياري عنصر_وحدة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نوع();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع محاولة_معاملات_النوع: اختياري متجه اسم = حلل_معاملات_نوع_تصريح(الرموز, المؤشر);
    دع معاملات_النوع: متجه اسم;
    طابق محاولة_معاملات_النوع مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيم) -> { معاملات_النوع := القيم; };
    لو (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) {
        أرجع اختياري.لا_شيء();
    };
    دع الشكل: اختياري شكل_تصريح_نوع = حلل_شكل_تصريح_نوع(المصدر, الرموز, المؤشر);
    طابق الشكل مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ش) -> {
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع نطاق_التصريح: نطاق = دمج_نطاق(البداية, النهاية);
        دع التصريح: تصريح_نوع = {
            النطاق: نطاق_التصريح,
            الاسم: الاسم,
            معاملات_النوع: معاملات_النوع,
            علني: علني,
            السمات: سمات_تصريح_فارغة(),
            الشكل: ش
        };
        أرجع اختياري.موجود(عنصر_وحدة.نوع(التصريح));
    };
}

عرف حلل_مرادف_اسم(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    علني: منطقي
): اختياري تصريح_مرادف_اسم {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    لو (علني) {
        تقدم(الرموز, المؤشر);
    };
    لو (!توقع(الرموز, المؤشر, رمز.مرادف_تصريح())) {
        أرجع اختياري.لا_شيء();
    };
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    دع أول_الوجهة: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع أب_الوجهة: متغير اختياري اسم = اختياري.لا_شيء();
    دع الاسم: متغير اسم = أول_الوجهة;
    لو (اقبل(الرموز, المؤشر, رمز.نقطة())) {
        دع نتيجة_الاسم: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
        طابق نتيجة_الاسم مع
        | نتيجة_اسم.غائب -> {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختياري.لا_شيء();
        }
        | نتيجة_اسم.موجود(اسم_الابن) -> {
            أب_الوجهة := اختياري.موجود(أول_الوجهة);
            الاسم := اسم_الابن;
        };
    };
    لو (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) {
        أرجع اختياري.لا_شيء();
    };
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    دع أول_الهدف: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع أب_الهدف: متغير اختياري اسم = اختياري.لا_شيء();
    دع الهدف: متغير اسم = أول_الهدف;
    لو (اقبل(الرموز, المؤشر, رمز.نقطة())) {
        دع نتيجة_الهدف: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
        طابق نتيجة_الهدف مع
        | نتيجة_اسم.غائب -> {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختياري.لا_شيء();
        }
        | نتيجة_اسم.موجود(اسم_الابن) -> {
            أب_الهدف := اختياري.موجود(أول_الهدف);
            الهدف := اسم_الابن;
        };
    };
    لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        أرجع اختياري.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع نطاق_التصريح: نطاق = دمج_نطاق(البداية, النهاية);
    دع التصريح: تصريح_مرادف_اسم = {
        النطاق: نطاق_التصريح,
        أب_الوجهة: أب_الوجهة,
        الاسم: الاسم,
        أب_الهدف: أب_الهدف,
        الهدف: الهدف,
        علني: علني
    };
    أرجع اختياري.موجود(التصريح);
}

عرف حلل_مسار_وحدة_انتقائي(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري متجه اسم {
    دع الأجزاء: متغير متجه اسم = [];
    لو (!اسم_سياقي(الرموز, المؤشر)) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    ألحق(الأجزاء, اسم_الحالي(الرموز, المؤشر));
    تقدم(الرموز, المؤشر);
    طالما (اقبل(الرموز, المؤشر, رمز.نقطة())) {
        لو (!اسم_سياقي(الرموز, المؤشر)) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        ألحق(الأجزاء, اسم_الحالي(الرموز, المؤشر));
        تقدم(الرموز, المؤشر);
    }
    أرجع اختياري.موجود(الأجزاء);
}

عرف حلل_استيرادا_انتقائيا(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري استيراد {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);

    دع المسار: متجه اسم;
    طابق حلل_مسار_وحدة_انتقائي(الرموز, المؤشر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { المسار := القيمة; };

    لو (!توقع(الرموز, المؤشر, رمز.استيراد())) {
        أرجع اختياري.لا_شيء();
    };

    دع الأسماء: متغير متجه اسم = [];
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    ألحق(الأسماء, اسم_الحالي(الرموز, المؤشر));
    تقدم(الرموز, المؤشر);
    طالما (اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
            ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        ألحق(الأسماء, اسم_الحالي(الرموز, المؤشر));
        تقدم(الرموز, المؤشر);
    }
    دع النهاية: متغير نطاق = نطاق_السابق(الرموز, المؤشر);
    لو (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        النهاية := نطاق_السابق(الرموز, المؤشر);
    };
    أرجع اختياري.موجود(
        استيراد.انتقائي(دمج_نطاق(البداية, النهاية), المسار, الأسماء)
    );
}

عرف حلل_استيرادا(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري استيراد {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.حرفي_نص()) {
        دع المحاولة: اختياري متجه ط8 = نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(النص) -> {
            تقدم(الرموز, المؤشر);
            دع المرادف: متغير اختياري اسم = اختياري.لا_شيء();
            لو (اقبل(الرموز, المؤشر, رمز.تحويل_نوع())) {
                لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
                    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
                    ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
                    أرجع اختياري.لا_شيء();
                };
                المرادف := اختياري.موجود(اسم_الحالي(الرموز, المؤشر));
                تقدم(الرموز, المؤشر);
            };
            لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                أرجع اختياري.لا_شيء();
            };
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            أرجع اختياري.موجود(استيراد.نص(دمج_نطاق(البداية, النهاية), النص, المرادف));
        };
    };
    لو (اسم_سياقي(الرموز, المؤشر)) {
        دع المسار: متغير متجه اسم = [];
        ألحق(المسار, اسم_الحالي(الرموز, المؤشر));
        تقدم(الرموز, المؤشر);
        طالما (اقبل(الرموز, المؤشر, رمز.نقطة())) {
            لو (!اسم_سياقي(الرموز, المؤشر)) {
                دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
                ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
                أرجع اختياري.لا_شيء();
            };
            ألحق(المسار, اسم_الحالي(الرموز, المؤشر));
            تقدم(الرموز, المؤشر);
        }
        دع المرادف: متغير اختياري اسم = اختياري.لا_شيء();
        لو (اقبل(الرموز, المؤشر, رمز.تحويل_نوع())) {
            لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
                دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
                ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
                أرجع اختياري.لا_شيء();
            };
            المرادف := اختياري.موجود(اسم_الحالي(الرموز, المؤشر));
            تقدم(الرموز, المؤشر);
        };
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختياري.موجود(استيراد.اسم(دمج_نطاق(البداية, النهاية), المسار, المرادف));
    };
    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
    ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_نص());
    أرجع اختياري.لا_شيء();
}

عرف حلل_تجميعا_عاما(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري عنصر_وحدة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_نص()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_نص());
        أرجع اختياري.لا_شيء();
    };
    دع المحاولة: اختياري متجه ط8 = نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر));
    طابق المحاولة مع
    | اختياري.لا_شيء -> {
        ارفض_داخليا(الرموز, المؤشر);
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النص) -> {
        تقدم(الرموز, المؤشر);
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختياري.موجود(عنصر_وحدة.تجميع(دمج_نطاق(البداية, النهاية), النص));
    };
}

عرف حلل_عنصر_قيمة_عليا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    علني: منطقي,
    خارجية: منطقي
): اختياري عنصر_وحدة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.دع())) { أرجع اختياري.لا_شيء(); };
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) { أرجع اختياري.لا_شيء(); };
    دع النوع_المحلل: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    دع النوع: نوع_تركيبي;
    طابق النوع_المحلل مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { النوع := القيمة; };
    لو (خارجية) {
        // External data is an imported linker symbol, never an initialized value.
        // The name is explicit so punctuation in linker names needs no identifier escape.
        لو (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) { أرجع اختياري.لا_شيء(); };
        دع اسم_الربط: متجه ط8;
        طابق حلل_نص_ربط_أصلي(الرموز, المؤشر) مع
        | اختياري.موجود(القيمة) -> { اسم_الربط := القيمة; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { أرجع اختياري.لا_شيء(); };
        دع التصريح: تصريح_قيمة_عليا = {
            النطاق: دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر)),
            الاسم: الاسم, النوع: النوع, علني: علني,
            السمات: سمات_تصريح_فارغة(),
            التهيئة: تهيئة_قيمة_عليا.خارجية(اسم_الربط)
        };
        أرجع اختياري.موجود(عنصر_وحدة.قيمة_عليا(التصريح));
    };
    لو (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) { أرجع اختياري.لا_شيء(); };
    دع التهيئة_المحللة: اختياري صيغة_تهيئة = حلل_تهيئة(المصدر, الرموز, المؤشر);
    دع التهيئة: تهيئة_قيمة_عليا;
    طابق التهيئة_المحللة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الصيغة) -> {
        طابق الصيغة مع
        | صيغة_تهيئة.تعبير(_, القيمة) -> { التهيئة := تهيئة_قيمة_عليا.تعبير(القيمة); }
        | صيغة_تهيئة.متجه(_, العناصر) -> { التهيئة := تهيئة_قيمة_عليا.متجه(العناصر); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { أرجع اختياري.لا_شيء(); };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع نطاق_التصريح: نطاق = دمج_نطاق(البداية, النهاية);
    دع التصريح: تصريح_قيمة_عليا = {
        النطاق: نطاق_التصريح,
        الاسم: الاسم,
        النوع: النوع,
        علني: علني,
        السمات: سمات_تصريح_فارغة(),
        التهيئة: التهيئة
    };
    أرجع اختياري.موجود(عنصر_وحدة.قيمة_عليا(التصريح));
}

عرف حلل_عنصر_حسب_النوع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    علني: منطقي,
    النوع: رمز
): اختياري عنصر_وحدة {
    لو (النوع == رمز.نوع()) {
        أرجع حلل_عنصر_نوع(المصدر, الرموز, المؤشر, علني);
    };
    لو (النوع == رمز.خارجي()) {
        // A single external modifier applies to a function or a typed data symbol.
        لو ((فهرس_الحالي(المؤشر) + 1) < (الطول(*الرموز) مثل طبيعي)) {
            لو ((*الرموز)[فهرس_الحالي(المؤشر) + 1].النوع == رمز.دع()) {
                تقدم(الرموز, المؤشر);
                أرجع حلل_عنصر_قيمة_عليا(المصدر, الرموز, المؤشر, علني, صواب);
            };
        };
        أرجع حلل_عنصر_دالة(المصدر, الرموز, المؤشر, علني);
    };
    لو (النوع == رمز.تعريف_دالة()) {
        أرجع حلل_عنصر_دالة(المصدر, الرموز, المؤشر, علني);
    };
    لو (النوع == رمز.دع()) {
        أرجع حلل_عنصر_قيمة_عليا(المصدر, الرموز, المؤشر, علني, خطأ);
    };
    لو ((!علني) && (النوع == رمز.تجميع())) {
        أرجع حلل_تجميعا_عاما(الرموز, المؤشر);
    };

    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
    ارفض(الرموز, المؤشر, الفئة, رمز.تعريف_دالة());
    أرجع اختياري.لا_شيء();
}

// Parse attributes without consulting a framework registry. Compiler-defined
// @public retains its historical modifier semantics; all other annotations
// keep ordered, structured Name/Expression payloads for semantic resolution.
عرف حلل_سمة_تصريح(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري سمة_تصريح {
    دع المسار: متغير متجه اسم = [];
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.عنصر(), رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    ألحق(المسار, اسم_الحالي(الرموز, المؤشر));
    تقدم(الرموز, المؤشر);
    طالما (اقبل(الرموز, المؤشر, رمز.نقطة())) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.عنصر(), رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        ألحق(المسار, اسم_الحالي(الرموز, المؤشر));
        تقدم(الرموز, المؤشر);
    }
    دع الحجج: متغير متجه تعبير = [];
    لو (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
        طالما (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
            طابق حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1) مع
            | اختياري.موجود(الحجة) -> { ألحق(الحجج, الحجة); }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                لو (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
                    ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.قوس_يمين());
                    أرجع اختياري.لا_شيء();
                };
            };
        }
        لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
            أرجع اختياري.لا_شيء();
        };
    };
    دع الناتج: سمة_تصريح = {
        النطاق: دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر)),
        المسار: المسار,
        الحجج: الحجج
    };
    أرجع اختياري.موجود(الناتج);
}

عرف حلل_عنصرا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري عنصر_وحدة {
    دع علني: متغير منطقي = خطأ;
    دع السمات: متغير متجه سمة_تصريح = [];
    طالما (نوع_الحالي(الرموز, المؤشر) == رمز.علامة_سمة()) {
        دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        لو (نوع_الحالي(الرموز, المؤشر) == رمز.عام()) {
            لو (علني) {
                ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.عنصر(), رمز.معرف());
                أرجع اختياري.لا_شيء();
            };
            علني := صواب;
            تقدم(الرموز, المؤشر);
        } وإلا {
            طابق حلل_سمة_تصريح(المصدر, الرموز, المؤشر, البداية) مع
            | اختياري.موجود(السمة) -> { ألحق(السمات, السمة); }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        };
    }
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.عام()) {
        لو (علني) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.عنصر(), رمز.تعريف_دالة());
            أرجع اختياري.لا_شيء();
        };
        علني := صواب;
        تقدم(الرموز, المؤشر);
    };
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    طابق حلل_عنصر_حسب_النوع(المصدر, الرموز, المؤشر, علني, النوع) مع
    | اختياري.موجود(العنصر) -> {
        طابق العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            دع المعدلة: متغير تصريح_دالة = الدالة;
            المعدلة.السمات := السمات;
            أرجع اختياري.موجود(عنصر_وحدة.دالة(المعدلة));
        }
        | عنصر_وحدة.نوع(التصريح) -> {
            دع المعدلة: متغير تصريح_نوع = التصريح;
            المعدلة.السمات := السمات;
            أرجع اختياري.موجود(عنصر_وحدة.نوع(المعدلة));
        }
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            دع المعدلة: متغير تصريح_قيمة_عليا = التصريح;
            المعدلة.السمات := السمات;
            أرجع اختياري.موجود(عنصر_وحدة.قيمة_عليا(المعدلة));
        }
        | عنصر_وحدة.تجميع(_, _) -> {
            لو ((الطول(السمات) مثل طبيعي) != 0) {
                ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.عنصر(), رمز.تعريف_دالة());
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(العنصر);
        };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف رفض_المؤشر_كنتيجة(المؤشر: &متغير مؤشر): نتيجة_تحليل {
    دع الخطأ: اختياري خطأ_نحوي = خطأ_المؤشر(المؤشر);
    طابق الخطأ مع
    | اختياري.موجود(القيمة) -> {
        أرجع نتيجة_تحليل.مرفوض(القيمة);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحليل.خلل_داخلي();
    };
}

عرف هل_بداية_عنصر_علوي_للأدوات(النوع: رمز): منطقي {
    أرجع النوع == رمز.علامة_سمة()
        || النوع == رمز.عام()
        || النوع == رمز.مرادف_تصريح()
        || النوع == رمز.من_مصدر()
        || النوع == رمز.استيراد()
        || النوع == رمز.نوع()
        || النوع == رمز.دع()
        || النوع == رمز.خارجي()
        || النوع == رمز.تعريف_دالة()
        || النوع == رمز.تجميع()
        || النوع == رمز.نهاية_الملف();
}

عرف زامن_بعد_خطأ_أدوات(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): فراغ {
    امسح_خطأ_المؤشر(المؤشر);
    طالما (
        نوع_الحالي(الرموز, المؤشر) != رمز.نهاية_الملف()
        && !هل_بداية_عنصر_علوي_للأدوات(نوع_الحالي(الرموز, المؤشر))
    ) {
        لو (!تقدم_قسريا(الرموز, المؤشر)) { أرجع; };
    }
}

// Tooling recovery is deliberately top-level only. It never fabricates AST nodes:
// malformed declarations are omitted, while every successfully parsed declaration
// before/after them uses the exact strict-parser builders above.
عام عرف حلل_وحدة_للأدوات(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الأخطاء: &متغير متجه خطأ_نحوي
): وحدة_مصدر {
    دع الاستيرادات: متغير متجه استيراد = [];
    دع العناصر: متغير متجه عنصر_وحدة = [];
    دع مرادفات_الأسماء: متغير متجه تصريح_مرادف_اسم = [];

    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.نهاية_الملف()) {
        دع نجح: متغير منطقي = خطأ;
        لو (
            (نوع_الحالي(الرموز, المؤشر) == رمز.عام())
            && (نوع_التالي(الرموز, المؤشر) == رمز.مرادف_تصريح())
        ) {
            طابق حلل_مرادف_اسم(الرموز, المؤشر, صواب) مع
            | اختياري.موجود(م) -> { ألحق(مرادفات_الأسماء, م); نجح := صواب; }
            | اختياري.لا_شيء -> { };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.مرادف_تصريح()) {
            طابق حلل_مرادف_اسم(الرموز, المؤشر, خطأ) مع
            | اختياري.موجود(م) -> { ألحق(مرادفات_الأسماء, م); نجح := صواب; }
            | اختياري.لا_شيء -> { };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.من_مصدر()) {
            طابق حلل_استيرادا_انتقائيا(الرموز, المؤشر) مع
            | اختياري.موجود(ا) -> { ألحق(الاستيرادات, ا); نجح := صواب; }
            | اختياري.لا_شيء -> { };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.استيراد()) {
            طابق حلل_استيرادا(الرموز, المؤشر) مع
            | اختياري.موجود(ا) -> { ألحق(الاستيرادات, ا); نجح := صواب; }
            | اختياري.لا_شيء -> { };
        }
        وإلا {
            طابق حلل_عنصرا(المصدر, الرموز, المؤشر) مع
            | اختياري.موجود(ع) -> { ألحق(العناصر, ع); نجح := صواب; }
            | اختياري.لا_شيء -> { };
        };

        لو (!نجح) {
            طابق خطأ_المؤشر(المؤشر) مع
            | اختياري.موجود(الخطأ) -> { دع حالة_الأخطاء: متغير متجه خطأ_نحوي = انسخ_مملوكا_متجه_خطأ_نحوي(الأخطاء);
                ألحق(حالة_الأخطاء, الخطأ);
                *الأخطاء := حالة_الأخطاء; }
            | اختياري.لا_شيء -> { };
            زامن_بعد_خطأ_أدوات(الرموز, المؤشر);
        };
    }

    دع معرف_المصدر: طبيعي = (*المصدر).المعرف;
    دع بلا_مستبعدة: متجه نطاق = [];
    دع الوحدة: وحدة_مصدر = {
        معرف_المصدر: معرف_المصدر,
        الاستيرادات: الاستيرادات,
        العناصر: العناصر,
        مرادفات_الأسماء: مرادفات_الأسماء,
        المستبعدة_للهدف: بلا_مستبعدة
    };
    أرجع الوحدة;
}

// The declared name of a function, Type or module value.
عرف نطاق_اسم_عنصر_وحدة(العنصر: &عنصر_وحدة): اختياري نطاق {
    طابق *العنصر مع
    | عنصر_وحدة.دالة(التصريح) -> { أرجع اختياري.موجود(التصريح.الاسم.النطاق); }
    | عنصر_وحدة.نوع(التصريح) -> { أرجع اختياري.موجود(التصريح.الاسم.النطاق); }
    | عنصر_وحدة.قيمة_عليا(التصريح) -> { أرجع اختياري.موجود(التصريح.الاسم.النطاق); }
    | عنصر_وحدة.تجميع(_, _) -> { أرجع اختياري.لا_شيء(); };
}

// Restrict platform declarations before Name sees them. Both arms are parsed
// for syntax, but only the selected arm reaches imports, export indexing and
// semantic resolution. No conditional AST or duplicate symbol table is needed.
عرف حلل_محتوى_وحدة_مشروطة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الهدف: &اختياري واصف_هدف,
    نشط: منطقي,
    داخل_كتلة: منطقي,
    الاستيرادات: &متغير متجه استيراد,
    العناصر: &متغير متجه عنصر_وحدة,
    مرادفات_الأسماء: &متغير متجه تصريح_مرادف_اسم,
    المستبعدة: &متغير متجه نطاق
): منطقي {
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.نهاية_الملف()) {
        لو (داخل_كتلة && نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يمين()) {
            تقدم(الرموز, المؤشر);
            أرجع صواب;
        };
        لو (نوع_الحالي(الرموز, المؤشر) == رمز.لو()) {
            تقدم(الرموز, المؤشر);
            لو (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) { أرجع خطأ; };
            دع الحالة: منطقي;
            طابق *الهدف مع
            | اختياري.لا_شيء -> {
                // A target conditional without a target cannot silently select
                // either implementation (including tooling's neutral mode).
                ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.شرط_هدف_بلا_هدف(), رمز.معرف());
                أرجع خطأ;
            }
            | اختياري.موجود(واصف) -> {
                طابق اقرأ_شرط_هدف(المصدر, الرموز, المؤشر, &واصف) مع
                | اختياري.لا_شيء -> {
                    ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.شرط_هدف_غير_صالح(), رمز.معرف());
                    أرجع خطأ;
                }
                | اختياري.موجود(القيمة) -> { الحالة := القيمة; };
            };
            لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع خطأ; };
            لو (!توقع(الرموز, المؤشر, رمز.معقوف_يسار())) { أرجع خطأ; };
            لو (!حلل_محتوى_وحدة_مشروطة(
                المصدر, الرموز, المؤشر, الهدف, نشط && الحالة, صواب,
                الاستيرادات, العناصر, مرادفات_الأسماء, المستبعدة
            )) { أرجع خطأ; };
            لو (اقبل(الرموز, المؤشر, رمز.وإلا())) {
                لو (!توقع(الرموز, المؤشر, رمز.معقوف_يسار())) { أرجع خطأ; };
                لو (!حلل_محتوى_وحدة_مشروطة(
                    المصدر, الرموز, المؤشر, الهدف, نشط && !الحالة, صواب,
                    الاستيرادات, العناصر, مرادفات_الأسماء, المستبعدة
                )) { أرجع خطأ; };
            };
        }
        وإلا لو (
            نوع_الحالي(الرموز, المؤشر) == رمز.عام()
            && نوع_التالي(الرموز, المؤشر) == رمز.مرادف_تصريح()
        ) {
            طابق حلل_مرادف_اسم(الرموز, المؤشر, صواب) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(القيمة) -> {
                لو (نشط) { ألحق(*مرادفات_الأسماء, القيمة); };
            };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.مرادف_تصريح()) {
            طابق حلل_مرادف_اسم(الرموز, المؤشر, خطأ) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(القيمة) -> {
                لو (نشط) { ألحق(*مرادفات_الأسماء, القيمة); };
            };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.من_مصدر()) {
            طابق حلل_استيرادا_انتقائيا(الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(القيمة) -> {
                لو (نشط) { ألحق(*الاستيرادات, القيمة); };
            };
        }
        وإلا لو (نوع_الحالي(الرموز, المؤشر) == رمز.استيراد()) {
            طابق حلل_استيرادا(الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(القيمة) -> {
                لو (نشط) { ألحق(*الاستيرادات, القيمة); };
            };
        }
        وإلا {
            طابق حلل_عنصرا(المصدر, الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(القيمة) -> {
                لو (نشط) {
                    ألحق(*العناصر, القيمة);
                } وإلا {
                    طابق نطاق_اسم_عنصر_وحدة(&القيمة) مع
                    | اختياري.موجود(نطاق_الاسم) -> { ألحق(*المستبعدة, نطاق_الاسم); }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
    }
    لو (داخل_كتلة) {
        ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معقوف_يمين());
        أرجع خطأ;
    };
    أرجع صواب;
}

عام عرف حلل_وحدة_لهدف(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الهدف: &اختياري واصف_هدف
): نتيجة_تحليل {
    دع الاستيرادات: متغير متجه استيراد = [];
    دع العناصر: متغير متجه عنصر_وحدة = [];
    دع مرادفات_الأسماء: متغير متجه تصريح_مرادف_اسم = [];
    دع المستبعدة: متغير متجه نطاق = [];
    لو (!حلل_محتوى_وحدة_مشروطة(
        المصدر, الرموز, المؤشر, الهدف, صواب, خطأ,
        &متغير الاستيرادات, &متغير العناصر, &متغير مرادفات_الأسماء, &متغير المستبعدة
    )) {
        أرجع رفض_المؤشر_كنتيجة(المؤشر);
    };
    دع الوحدة: وحدة_مصدر = {
        معرف_المصدر: (*المصدر).المعرف,
        الاستيرادات: الاستيرادات,
        العناصر: العناصر,
        مرادفات_الأسماء: مرادفات_الأسماء,
        المستبعدة_للهدف: المستبعدة
    };
    أرجع نتيجة_تحليل.شجرة(الوحدة);
}

عام عرف حلل_وحدة(
    المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر
): نتيجة_تحليل {
    دع الهدف: اختياري واصف_هدف = اختياري.لا_شيء();
    أرجع حلل_وحدة_لهدف(المصدر, الرموز, المؤشر, &الهدف);
}
