// التهيئة فصل نحوي لأن البنى التجميعية تقبل الذرات حسب عقد المرحلة 0.
عام نوع صيغة_تهيئة =
    | تعبير بنوع (نطاق, تعبير)
    | صف بنوع (نطاق, متجه تعبير)
    | متجه بنوع (نطاق, متجه تعبير)
    | سجل بنوع (نطاق, متجه حقل_تهيئة)
    | صندوق بنوع (نطاق, تعبير)
;

عرف حلل_ذرة_تهيئة_سياقية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار تعبير {
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.طرح()) {
        أرجع حلل_ذرة(المصدر, الرموز, المؤشر);
    };
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_عدد_صحيح()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
        ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_عدد_صحيح());
        أرجع اختيار.لا_شيء();
    };
    دع المحاولة: اختيار قيمة_عدد_صحيح_رمز = قيمة_عدد_عند(الرموز, فهرس_الحالي(المؤشر));
    طابق المحاولة مع
    | اختيار.لا_شيء -> {
        ارفض_داخليا(الرموز, المؤشر);
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(القيمة) -> {
        دع النهاية: نطاق = نطاق_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        أرجع اختيار.بعض(تعبير_عدد_سالب_من_قيمة_رمز(النطاق, القيمة));
    };
}

عرف حلل_ذرات_حتى(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    النهاية: رمز
): اختيار متجه تعبير {
    دع القيم: متغير متجه تعبير = [];
    بينما (نوع_الحالي(الرموز, المؤشر) != النهاية) {
        دع القيمة: اختيار تعبير = حلل_ذرة_تهيئة_سياقية(المصدر, الرموز, المؤشر);
        طابق القيمة مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(ت) -> {
            ألحق(القيم, ت);
        };
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        };
    }
    لو (!توقع(الرموز, المؤشر, النهاية)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(القيم);
}

عرف حلل_سجل_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختيار صيغة_تهيئة {
    دع الحقول: متغير متجه حقل_تهيئة = [];
    بينما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            أرجع اختيار.لا_شيء();
        };
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
            أرجع اختيار.لا_شيء();
        };
        دع القيمة: اختيار تعبير = حلل_ذرة_تهيئة_سياقية(المصدر, الرموز, المؤشر);
        طابق القيمة مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(ت) -> {
            دع الحقل: حقل_تهيئة = {
                الاسم: الاسم,
                القيمة: ت
            };
            ألحق(الحقول, الحقل);
        };
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختيار.بعض(صيغة_تهيئة.سجل(دمج_نطاق(البداية, النهاية), الحقول));
}

عرف حلل_متجه_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختيار صيغة_تهيئة {
    تقدم(الرموز, المؤشر);
    دع القيم: اختيار متجه تعبير = حلل_ذرات_حتى(المصدر, الرموز, المؤشر, رمز.قوس_مربع_يمين());
    طابق القيم مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ق) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختيار.بعض(صيغة_تهيئة.متجه(دمج_نطاق(البداية, النهاية), ق));
    };
}

عرف حلل_صندوق_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختيار صيغة_تهيئة {
    تقدم(الرموز, المؤشر);
    دع القيمة: اختيار تعبير = حلل_ذرة_تهيئة_سياقية(المصدر, الرموز, المؤشر);
    طابق القيمة مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ت) -> {
        دع النهاية: نطاق = نطاق_تعبير(&ت);
        أرجع اختيار.بعض(صيغة_تهيئة.صندوق(دمج_نطاق(البداية, النهاية), ت));
    };
}

عرف حلل_قوس_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختيار صيغة_تهيئة {
    تقدم(الرموز, المؤشر);
    لو (اقبل(الرموز, المؤشر, رمز.قوس_يمين())) {
        دع فارغ: متجه تعبير = [];
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختيار.بعض(صيغة_تهيئة.صف(دمج_نطاق(البداية, النهاية), فارغ));
    };
    دع الأول: اختيار تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق الأول مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(أ) -> {
        أرجع أكمل_قوس_تهيئة(المصدر, الرموز, المؤشر, البداية, أ);
    };
}

عرف أكمل_قوس_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الأول: تعبير
): اختيار صيغة_تهيئة {
    لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
            أرجع اختيار.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختيار.بعض(صيغة_تهيئة.تعبير(دمج_نطاق(البداية, النهاية), الأول));
    };
    دع القيم: متغير متجه تعبير = [];
    ألحق(القيم, الأول);
    بينما (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع القيمة: اختيار تعبير = حلل_ذرة_تهيئة_سياقية(المصدر, الرموز, المؤشر);
        طابق القيمة مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(ت) -> {
            ألحق(القيم, ت);
        };
        لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختيار.بعض(صيغة_تهيئة.صف(دمج_نطاق(البداية, النهاية), القيم));
}

عام عرف حلل_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار صيغة_تهيئة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    لو (النوع == رمز.قوس_مربع_يسار()) {
        أرجع حلل_متجه_تهيئة(المصدر, الرموز, المؤشر, البداية);
    };
    لو (النوع == رمز.معقوف_يسار()) {
        تقدم(الرموز, المؤشر);
        أرجع حلل_سجل_تهيئة(المصدر, الرموز, المؤشر, البداية);
    };
    لو (النوع == رمز.صندوق()) {
        أرجع حلل_صندوق_تهيئة(المصدر, الرموز, المؤشر, البداية);
    };
    لو (النوع == رمز.قوس_يسار()) {
        أرجع حلل_قوس_تهيئة(المصدر, الرموز, المؤشر, البداية);
    };
    دع التعبير: اختيار تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق التعبير مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ت) -> {
        أرجع اختيار.بعض(صيغة_تهيئة.تعبير(نطاق_تعبير(&ت), ت));
    };
}
