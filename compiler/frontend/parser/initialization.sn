استورد compiler.frontend.parser.expressions;

// Aggregate initialization accepts full expressions in element/field positions.
// The initializer parser owns aggregate delimiters; expression parsing owns each value.
عام نوع صيغة_تهيئة =
    | تعبير بنوع (نطاق, تعبير)
    | صف بنوع (نطاق, متجه تعبير)
    | متجه بنوع (نطاق, متجه تعبير)
    | سجل بنوع (نطاق, متجه حقل_تهيئة)
    | صندوق بنوع (نطاق, تعبير)
;

عرف حلل_ذرات_حتى(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    النهاية: رمز
): اختياري متجه تعبير {
    دع القيم: متغير متجه تعبير = [];
    طالما (نوع_الحالي(الرموز, المؤشر) != النهاية) {
        دع القيمة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
        طابق القيمة مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ت) -> {
            ألحق(القيم, ت);
        };
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        };
    }
    إذا (!توقع(الرموز, المؤشر, النهاية)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(القيم);
}

عرف حلل_سجل_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري صيغة_تهيئة {
    دع الحقول: متغير متجه حقل_تهيئة = [];
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نهاية_الملف()) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معقوف_يمين());
            أرجع اختياري.لا_شيء();
        };
        إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        إذا (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
            أرجع اختياري.لا_شيء();
        };
        دع القيمة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
        طابق القيمة مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ت) -> {
            دع الحقل: حقل_تهيئة = {
                الاسم: الاسم,
                القيمة: ت
            };
            ألحق(الحقول, الحقل);
        };
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
        };
    }
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(صيغة_تهيئة.سجل(دمج_نطاق(البداية, النهاية), الحقول));
}

عرف حلل_متجه_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري صيغة_تهيئة {
    تقدم(الرموز, المؤشر);
    دع القيم: اختياري متجه تعبير = حلل_ذرات_حتى(المصدر, الرموز, المؤشر, رمز.قوس_مربع_يمين());
    طابق القيم مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ق) -> {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختياري.موجود(صيغة_تهيئة.متجه(دمج_نطاق(البداية, النهاية), ق));
    };
}

عرف حلل_صندوق_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري صيغة_تهيئة {
    تقدم(الرموز, المؤشر);
    دع القيمة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق القيمة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ت) -> {
        دع النهاية: نطاق = نطاق_تعبير(&ت);
        أرجع اختياري.موجود(صيغة_تهيئة.صندوق(دمج_نطاق(البداية, النهاية), ت));
    };
}

عرف حلل_قوس_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري صيغة_تهيئة {
    دع مؤشر_البداية: مؤشر = *المؤشر;
    تقدم(الرموز, المؤشر);
    إذا (اقبل(الرموز, المؤشر, رمز.قوس_يمين())) {
        دع فارغ: متجه تعبير = [];
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختياري.موجود(صيغة_تهيئة.صف(دمج_نطاق(البداية, النهاية), فارغ));
    };
    دع الأول: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق الأول مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(أ) -> {
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                أرجع اختياري.لا_شيء();
            };
            *المؤشر := مؤشر_البداية;
            دع الكامل: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
            طابق الكامل مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(ت) -> {
                أرجع اختياري.موجود(صيغة_تهيئة.تعبير(نطاق_تعبير(&ت), ت));
            };
        };
        دع القيم: متغير متجه تعبير = [];
        ألحق(القيم, أ);
        طالما (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
            دع القيمة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
            طابق القيمة مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(ت) -> {
                ألحق(القيم, ت);
            };
            إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            };
        }
        إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
            أرجع اختياري.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        أرجع اختياري.موجود(صيغة_تهيئة.صف(دمج_نطاق(البداية, النهاية), القيم));
    };
}

عام عرف حلل_تهيئة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري صيغة_تهيئة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    إذا (النوع == رمز.قوس_مربع_يسار()) {
        // `let v: T = [..];` is the initializer statement. A literal that a
        // suffix or operator follows (`[a, b][i]`, `[a] == b`) is an
        // expression: reparse it as one.
        دع موضع_البداية: طبيعي = (*المؤشر).الموضع;
        دع المتجه: اختياري صيغة_تهيئة = حلل_متجه_تهيئة(المصدر, الرموز, المؤشر, البداية);
        طابق المتجه مع
        | اختياري.موجود(_) -> {
            إذا (نوع_الحالي(الرموز, المؤشر) == رمز.فاصلة_منقوطة()) { أرجع المتجه; };
            (*المؤشر).الموضع := موضع_البداية;
        }
        | اختياري.لا_شيء -> { أرجع المتجه; };
    };
    إذا (النوع == رمز.معقوف_يسار()) {
        تقدم(الرموز, المؤشر);
        أرجع حلل_سجل_تهيئة(المصدر, الرموز, المؤشر, البداية);
    };
    إذا (النوع == رمز.صندوق()) {
        أرجع حلل_صندوق_تهيئة(المصدر, الرموز, المؤشر, البداية);
    };
    إذا (النوع == رمز.قوس_يسار() && نوع_التالي(الرموز, المؤشر) != رمز.نجمة()) {
        أرجع حلل_قوس_تهيئة(المصدر, الرموز, المؤشر, البداية);
    };
    دع التعبير: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق التعبير مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ت) -> {
        أرجع اختياري.موجود(صيغة_تهيئة.تعبير(نطاق_تعبير(&ت), ت));
    };
}
