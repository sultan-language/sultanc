نوع اقتراح_تهجئة_كلمة_عبارة = {
    الرمز: رمز,
    التهجئة: تهجئة_كلمة_مقترحة
};

عرف محارف_يوتيف8_في_شريحة(
    النص: &نص,
    البداية: طبيعي,
    النهاية: طبيعي
): متجه ط32 {
    دع الناتج: متغير متجه ط32 = [];
    دع الموضع: متغير طبيعي = البداية;
    طالما (الموضع < النهاية) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, الموضع);
        إذا (!المفكوك.صالح || ((الموضع + المفكوك.العرض) > النهاية)) {
            دع الفارغ: متجه ط32 = [];
            أرجع الفارغ;
        };
        ألحق(الناتج, المفكوك.القيمة);
        الموضع := الموضع + المفكوك.العرض;
    }
    أرجع الناتج;
}

عرف محارف_نطاق_مصدر(المصدر: &مصدر, النطاق: نطاق): متجه ط32 {
    أرجع محارف_يوتيف8_في_شريحة(
        &(*المصدر).المحتوى, النطاق.البداية.البايت, النطاق.النهاية.البايت
    );
}

عرف محارف_نص_كامل(النص: &نص): متجه ط32 {
    دع القيمة: نص = *النص;
    أرجع محارف_يوتيف8_في_شريحة(&القيمة, 0, الطول(القيمة) مثل طبيعي);
}

عرف يحوي_محرفا_زائدا_واحدا(
    الأطول: &متجه ط32,
    الأقصر: &متجه ط32
): منطقي {
    دع أ: متجه ط32 = *الأطول;
    دع ب: متجه ط32 = *الأقصر;
    دع طول_أ: طبيعي = الطول(أ) مثل طبيعي;
    دع طول_ب: طبيعي = الطول(ب) مثل طبيعي;
    إذا (طول_أ != طول_ب + 1) {
        أرجع خطأ;
    };
    دع ف: متغير طبيعي = 0;
    دع ج: متغير طبيعي = 0;
    دع تخطى: متغير منطقي = خطأ;
    طالما ((ف < (الطول(أ) مثل طبيعي)) && (ج < (الطول(ب) مثل طبيعي))) {
        إذا (أ[ف] == ب[ج]) {
            ف := ف + 1;
            ج := ج + 1;
        } وإلا {
            إذا (تخطى) {
                أرجع خطأ;
            };
            تخطى := صواب;
            ف := ف + 1;
        };
    }
    أرجع صواب;
}

عرف تهجئتان_متقاربتان_بتعديل_واحد(
    الأولى: &متجه ط32,
    الثانية: &متجه ط32
): منطقي {
    دع أ: متجه ط32 = *الأولى;
    دع ب: متجه ط32 = *الثانية;
    دع طول_أ: طبيعي = الطول(أ) مثل طبيعي;
    دع طول_ب: طبيعي = الطول(ب) مثل طبيعي;
    إذا (طول_أ == طول_ب) {
        دع الأول: متغير طبيعي = طول_أ;
        دع الثاني: متغير طبيعي = طول_أ;
        دع عدد_الاختلافات: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < طول_أ) {
            إذا (أ[ف] != ب[ف]) {
                إذا (عدد_الاختلافات == 0) {
                    الأول := ف;
                } وإلا {
                    إذا (عدد_الاختلافات == 1) {
                        الثاني := ف;
                    };
                };
                عدد_الاختلافات := عدد_الاختلافات + 1;
                إذا (عدد_الاختلافات > 2) {
                    أرجع خطأ;
                };
            };
            ف := ف + 1;
        }
        إذا (عدد_الاختلافات == 1) {
            أرجع صواب;
        };
        إذا (
            (عدد_الاختلافات == 2)
            && (الثاني == (الأول + 1))
            && (أ[الأول] == ب[الثاني])
            && (أ[الثاني] == ب[الأول])
        ) {
            أرجع صواب;
        };
        أرجع خطأ;
    };
    إذا (طول_أ == (طول_ب + 1)) {
        أرجع يحوي_محرفا_زائدا_واحدا(&أ, &ب);
    };
    إذا (طول_ب == (طول_أ + 1)) {
        أرجع يحوي_محرفا_زائدا_واحدا(&ب, &أ);
    };
    أرجع خطأ;
}

عرف تهجئة_نطاق_قريبة_من(
    المصدر: &مصدر,
    النطاق: نطاق,
    المرشح: &نص
): منطقي {
    دع المصدر_محارف: متجه ط32 = محارف_نطاق_مصدر(المصدر, النطاق);
    دع المرشح_محارف: متجه ط32 = محارف_نص_كامل(المرشح);
    إذا (
        ((الطول(المصدر_محارف) مثل طبيعي) == 0)
        || ((الطول(المرشح_محارف) مثل طبيعي) == 0)
    ) {
        أرجع خطأ;
    };
    أرجع تهجئتان_متقاربتان_بتعديل_واحد(&المصدر_محارف, &المرشح_محارف);
}

عرف اقترح_تهجئة_مرشح_عبارة(
    المصدر: &مصدر,
    النطاق: نطاق,
    المرشح: رمز
): اختياري اقتراح_تهجئة_كلمة_عبارة {
    دع العربية: نص = تهجئة_عرض_رمز_عربية(المرشح);
    إذا (تهجئة_نطاق_قريبة_من(المصدر, النطاق, &العربية)) {
        دع التهجئة: تهجئة_كلمة_مقترحة = تهجئة_كلمة_مقترحة.عربية();
        دع الاقتراح: اقتراح_تهجئة_كلمة_عبارة = {
            الرمز: المرشح,
            التهجئة: التهجئة
        };
        أرجع اختياري.موجود(الاقتراح);
    };
    دع الإنجليزية: نص = تهجئة_عرض_رمز_إنجليزية(المرشح);
    إذا (تهجئة_نطاق_قريبة_من(المصدر, النطاق, &الإنجليزية)) {
        دع التهجئة: تهجئة_كلمة_مقترحة = تهجئة_كلمة_مقترحة.إنجليزية();
        دع الاقتراح: اقتراح_تهجئة_كلمة_عبارة = {
            الرمز: المرشح,
            التهجئة: التهجئة
        };
        أرجع اختياري.موجود(الاقتراح);
    };
    أرجع اختياري.لا_شيء();
}

عرف اقترح_تهجئة_كلمة_عبارة(
    المصدر: &مصدر,
    النطاق: نطاق
): اختياري اقتراح_تهجئة_كلمة_عبارة {
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.دع()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.أرجع()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.طالما()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.لكل()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.اخرج_من_حلقة()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.تابع_حلقة()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.إذا()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.طابق()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.تجميع()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.غير_آمن()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

نوع ناتج_عبارة =
    | واحدة بنوع صندوق عبارة
    | اثنتان بنوع (صندوق عبارة, صندوق عبارة)
;

عرف نتيجة_واحدة(القيمة: عبارة): ناتج_عبارة {
    دع الصندوق: صندوق عبارة = صندوق القيمة;
    أرجع ناتج_عبارة.واحدة(الصندوق);
}

عرف نتيجة_اثنتين(الأولى: عبارة, الثانية: عبارة): ناتج_عبارة {
    دع أ: صندوق عبارة = صندوق الأولى;
    دع ب: صندوق عبارة = صندوق الثانية;
    أرجع ناتج_عبارة.اثنتان(أ, ب);
}

// `EXPR؟` (docs/en/reference/errors.md): propagation is accepted only as the last postfix
// of a statement's whole right-hand side (`let x: T = EXPR؟;`, `x := EXPR؟;`,
// `return EXPR؟;` and `EXPR؟;`). The parser marks it with the `؟` token's own
// span; frontend/desugar/propagation.sn expands the statement before name
// resolution. A `؟` anywhere else is an unexpected token.
عرف علّم_انتشارا_إن_وجد(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    القيمة: تعبير
): تعبير {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.استفهام()) {
        أرجع القيمة;
    };
    دع نطاق_العلامة: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع الصندوق: صندوق تعبير = صندوق القيمة;
    أرجع تعبير.أحادي(نطاق_العلامة, عامل_أحادي.انتشار(), الصندوق);
}

عرف علّم_تهيئة_بانتشار(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    التهيئة: صيغة_تهيئة
): صيغة_تهيئة {
    طابق التهيئة مع
    | صيغة_تهيئة.تعبير(س, القيمة) -> {
        أرجع صيغة_تهيئة.تعبير(س, علّم_انتشارا_إن_وجد(الرموز, المؤشر, القيمة));
    }
    | _ -> { أرجع التهيئة; };
}

عرف حوّل_تهيئة(
    النطاق: نطاق,
    الوجهة: تعبير,
    التهيئة: صيغة_تهيئة
): عبارة {
    طابق التهيئة مع
    | صيغة_تهيئة.تعبير(س, القيمة) -> {
        أرجع عبارة.نسخ(النطاق, الوجهة, القيمة);
    }
    | صيغة_تهيئة.صف(س, القيم) -> {
        أرجع عبارة.تهيئة_صف(النطاق, الوجهة, القيم);
    }
    | صيغة_تهيئة.متجه(س, القيم) -> {
        أرجع عبارة.تهيئة_متجه(النطاق, الوجهة, القيم);
    }
    | صيغة_تهيئة.سجل(س, الحقول) -> {
        أرجع عبارة.تهيئة_سجل(النطاق, الوجهة, الحقول);
    }
    | صيغة_تهيئة.صندوق(س, القيمة) -> {
        أرجع عبارة.تهيئة_صندوق(النطاق, الوجهة, القيمة);
    };
}

// A statement-valued compile-time block assigned to a place (CT-02):
//   let x: T = comptime { statements; result };
//   x := comptime { statements; result };
// The braced expression form `comptime { e1; e2; }` (expressions only, the
// last one supplying the value) is tried first and keeps its meaning. In the
// statement form the final expression, or a final call statement, supplies
// the value.
نوع نتيجة_كتلة_قيمة_وقت_الترجمة =
    | تعبيرية
    | كتلة بنوع (كتلة_عبارات, تعبير)
    | مرفوضة
;

عرف بداية_كتلة_وقت_الترجمة(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): منطقي {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.وقت_الترجمة()) { أرجع خطأ; };
    دع التالي: طبيعي = فهرس_الحالي(المؤشر) + 1;
    إذا (التالي >= (الطول(*الرموز) مثل طبيعي)) { أرجع خطأ; };
    أرجع (*الرموز)[التالي].النوع == رمز.معقوف_يسار();
}

عرف حلل_كتلة_قيمة_وقت_الترجمة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): نتيجة_كتلة_قيمة_وقت_الترجمة {
    دع المحفوظ: مؤشر = *المؤشر;
    طابق حلل_تعبيرا(المصدر, الرموز, المؤشر) مع
    | اختياري.موجود(_) -> {
        *المؤشر := المحفوظ;
        أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.تعبيرية();
    }
    | اختياري.لا_شيء -> { *المؤشر := المحفوظ; };
    تقدم(الرموز, المؤشر);
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يسار())) {
        أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
    };
    دع العبارات: متغير متجه صندوق عبارة = [];
    طالما (صواب) {
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يمين()
            || نوع_الحالي(الرموز, المؤشر) == رمز.نهاية_الملف()) {
            دع رفض: منطقي = ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.تعبير(), رمز.معرف());
            أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
        };
        دع قبل_العبارة: مؤشر = *المؤشر;
        طابق حلل_عبارة(المصدر, الرموز, المؤشر) مع
        | اختياري.موجود(ن) -> {
            دع الناتج_النهائي: متغير اختياري تعبير = اختياري.لا_شيء();
            طابق ن مع
            | ناتج_عبارة.واحدة(أ) -> {
                إذا (نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يمين()) {
                    دع الأخيرة: عبارة = *أ;
                    طابق الأخيرة مع
                    | عبارة.استدعاء(_, الاستدعاء) -> { الناتج_النهائي := اختياري.موجود(انسخ_مملوكا_تعبير(&الاستدعاء)); }
                    | _ -> { };
                };
                طابق الناتج_النهائي مع
                | اختياري.لا_شيء -> { ألحق(العبارات, أ); }
                | اختياري.موجود(_) -> { };
            }
            | ناتج_عبارة.اثنتان(أ, ب) -> {
                ألحق(العبارات, أ);
                ألحق(العبارات, ب);
            };
            طابق الناتج_النهائي مع
            | اختياري.موجود(الناتج) -> {
                إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
                    أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
                };
                دع الكتلة: كتلة_عبارات = {
                    النطاق: دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر)),
                    العبارات: العبارات
                };
                أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.كتلة(الكتلة, الناتج);
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> {
            *المؤشر := قبل_العبارة;
            طابق حلل_تعبيرا(المصدر, الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة(); }
            | اختياري.موجود(الناتج) -> {
                اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
                إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
                    أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
                };
                دع الكتلة: كتلة_عبارات = {
                    النطاق: دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر)),
                    العبارات: العبارات
                };
                أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.كتلة(الكتلة, الناتج);
            };
        };
    }
    أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
}

عرف حلل_ربطا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
        أرجع اختياري.لا_شيء();
    };
    دع النوع_نتيجة: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق النوع_نتيجة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        أرجع أكمل_ربطا(المصدر, الرموز, المؤشر, البداية, الاسم, النوع);
    };
}

عرف أكمل_ربطا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الاسم: اسم,
    النوع: نوع_تركيبي
): اختياري ناتج_عبارة {
    إذا (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        أرجع اختياري.موجود(نتيجة_واحدة(عبارة.تصريح_متغير(النطاق, الاسم, النوع)));
    };
    إذا (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) {
        أرجع اختياري.لا_شيء();
    };
    إذا (بداية_كتلة_وقت_الترجمة(الرموز, المؤشر)) {
        طابق حلل_كتلة_قيمة_وقت_الترجمة(المصدر, الرموز, المؤشر) مع
        | نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة -> { أرجع اختياري.لا_شيء(); }
        | نتيجة_كتلة_قيمة_وقت_الترجمة.كتلة(جسم_الكتلة, ناتج_الكتلة) -> {
            إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                أرجع اختياري.لا_شيء();
            };
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
            دع الوجهة: تعبير = تعبير.اسم(النطاق, الاسم);
            دع التصريح: عبارة = عبارة.تصريح_متغير(النطاق, الاسم, النوع);
            دع البدء: عبارة = عبارة.إسناد_وقت_الترجمة(
                النطاق, الوجهة, جسم_الكتلة, ناتج_الكتلة
            );
            أرجع اختياري.موجود(نتيجة_اثنتين(التصريح, البدء));
        }
        | نتيجة_كتلة_قيمة_وقت_الترجمة.تعبيرية -> { };
    };
    دع التهيئة_نتيجة: اختياري صيغة_تهيئة = حلل_تهيئة(المصدر, الرموز, المؤشر);
    طابق التهيئة_نتيجة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(التهيئة_المقروءة) -> {
        دع التهيئة: صيغة_تهيئة = علّم_تهيئة_بانتشار(الرموز, المؤشر, التهيئة_المقروءة);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        دع الوجهة: تعبير = تعبير.اسم(النطاق, الاسم);
        دع التصريح: عبارة = عبارة.تصريح_متغير(النطاق, الاسم, النوع);
        دع البدء: عبارة = حوّل_تهيئة(النطاق, الوجهة, التهيئة);
        أرجع اختياري.موجود(نتيجة_اثنتين(التصريح, البدء));
    };
}

عرف حلل_إرجاعا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع العبارة: عبارة = عبارة.أرجع(دمج_نطاق(البداية, النهاية), اختياري.لا_شيء());
        أرجع اختياري.موجود(نتيجة_واحدة(العبارة));
    };
    دع النتيجة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق النتيجة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(المقروءة) -> {
        دع القيمة: تعبير = علّم_انتشارا_إن_وجد(الرموز, المؤشر, المقروءة);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع العبارة: عبارة = عبارة.أرجع(دمج_نطاق(البداية, النهاية), اختياري.موجود(القيمة));
        أرجع اختياري.موجود(نتيجة_واحدة(العبارة));
    };
}

عام عرف حلل_كتلة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري كتلة_عبارات {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    دع العبارات: متغير متجه صندوق عبارة = [];
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نهاية_الملف()) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
            ارفض(الرموز, المؤشر, الفئة, رمز.معقوف_يمين());
            أرجع اختياري.لا_شيء();
        };
        دع النتيجة: اختياري ناتج_عبارة = حلل_عبارة(المصدر, الرموز, المؤشر);
        طابق النتيجة مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ن) -> {
            طابق ن مع
            | ناتج_عبارة.واحدة(أ) -> {
                ألحق(العبارات, أ);
            }
            | ناتج_عبارة.اثنتان(أ, ب) -> {
                ألحق(العبارات, أ);
                ألحق(العبارات, ب);
            };
        };
    }
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع نطاق_الكتلة: نطاق = دمج_نطاق(البداية, النهاية);
    دع الكتلة: كتلة_عبارات = {
        النطاق: نطاق_الكتلة,
        العبارات: العبارات
    };
    أرجع اختياري.موجود(الكتلة);
}

عرف حلل_بينما(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    دع الشرط: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق الشرط مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ق) -> {
        أرجع أكمل_بينما(المصدر, الرموز, المؤشر, البداية, ق);
    };
}

عرف أكمل_بينما(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير
): اختياري ناتج_عبارة {
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    دع الجسم: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الجسم مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ك) -> {
        // A while statement may carry the same optional `;` terminator as
        // other block statements (`طالما (ش) { ... };`).
        إذا (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { };
        دع ت: عبارة = عبارة.طالما(
            دمج_نطاق(البداية, ك.النطاق),
            الشرط,
            ك
        );
        أرجع اختياري.موجود(نتيجة_واحدة(ت));
    };
}

عرف عبارات_ناتج_إلى_متجه(الناتج: ناتج_عبارة): متجه صندوق عبارة {
    دع العبارات: متغير متجه صندوق عبارة = [];
    طابق الناتج مع
    | ناتج_عبارة.واحدة(أ) -> { ألحق(العبارات, أ); }
    | ناتج_عبارة.اثنتان(أ, ب) -> { ألحق(العبارات, أ); ألحق(العبارات, ب); };
    أرجع العبارات;
}

عرف حلل_خطوة_لكل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري صندوق عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع له_فك: منطقي = اقبل(الرموز, المؤشر, رمز.نجمة());
    دع الموضع: اختياري تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
    دع اليسار: متغير تعبير = تعبير.حرفي(البداية, حرفي.غير_معرف());
    طابق الموضع مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> {
        إذا (له_فك) {
            دع النهاية: نطاق = نطاق_تعبير(&قيمة);
            دع الأصل: صندوق تعبير = صندوق قيمة;
            اليسار := تعبير.فك_موضع(دمج_نطاق(البداية, النهاية), الأصل);
        } وإلا {
            اليسار := قيمة;
        };
    };
    إذا (!توقع(الرموز, المؤشر, رمز.إسناد())) { أرجع اختياري.لا_شيء(); };
    دع اليمين: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق اليمين مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ر) -> {
        دع النطاق: نطاق = دمج_نطاق(البداية, نطاق_تعبير(&ر));
        دع ت: عبارة = عبارة.نسخ(النطاق, اليسار, ر);
        دع الصندوق: صندوق عبارة = صندوق ت;
        أرجع اختياري.موجود(الصندوق);
    };
}

عرف حلل_لكل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) { أرجع اختياري.لا_شيء(); };
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.دع()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
        ارفض(الرموز, المؤشر, الفئة, رمز.دع());
        أرجع اختياري.لا_شيء();
    };
    دع البداية_نتيجة: اختياري ناتج_عبارة = حلل_ربطا(المصدر, الرموز, المؤشر);
    دع البداية_عبارات: متغير متجه صندوق عبارة = [];
    طابق البداية_نتيجة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ن) -> { البداية_عبارات := عبارات_ناتج_إلى_متجه(ن); };
    دع الشرط_نتيجة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    دع الشرط: متغير تعبير = تعبير.حرفي(البداية, حرفي.منطقي(صواب));
    طابق الشرط_نتيجة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ق) -> { الشرط := ق; };
    إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { أرجع اختياري.لا_شيء(); };
    دع الخطوة_نتيجة: اختياري صندوق عبارة = حلل_خطوة_لكل(المصدر, الرموز, المؤشر);
    طابق الخطوة_نتيجة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الخطوة) -> {
        إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع اختياري.لا_شيء(); };
        دع الجسم_نتيجة: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
        طابق الجسم_نتيجة مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الجسم) -> {
            دع ت: عبارة = عبارة.لكل(دمج_نطاق(البداية, الجسم.النطاق), البداية_عبارات, الشرط, الخطوة, الجسم);
            أرجع اختياري.موجود(نتيجة_واحدة(ت));
        };
    };
}

عرف حلل_تحكم_حلقة(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    متابعة: منطقي
): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { أرجع اختياري.لا_شيء(); };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
    إذا (متابعة) { أرجع اختياري.موجود(نتيجة_واحدة(عبارة.تابع_حلقة(النطاق))); };
    أرجع اختياري.موجود(نتيجة_واحدة(عبارة.اخرج_من_حلقة(النطاق)));
}

عرف ابن_إذا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    دع الشرط: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق الشرط مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ق) -> {
        أرجع أكمل_إذا(المصدر, الرموز, المؤشر, البداية, ق);
    };
}

عرف أكمل_إذا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير
): اختياري عبارة {
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    دع الفرع: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الفرع مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأول) -> {
        أرجع أكمل_بديل_إذا(المصدر, الرموز, المؤشر, البداية, الشرط, الأول);
    };
}

عرف ابن_إذا_بلا_بديل(
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختياري عبارة {
    دع النهاية: نطاق = دمج_نطاق(البداية, الأول.النطاق);
    أرجع اختياري.موجود(عبارة.إذا(النهاية, الشرط, الأول, اختياري.لا_شيء()));
}

عرف ابن_إذا_متداخل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختياري عبارة {
    دع بداية_المتداخل: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع المتداخل: اختياري عبارة = ابن_إذا(المصدر, الرموز, المؤشر);
    طابق المتداخل مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ت) -> {
        دع آخر_المتداخل: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع نطاق_ت: نطاق = دمج_نطاق(بداية_المتداخل, آخر_المتداخل);
        دع صندوق_ت: صندوق عبارة = صندوق ت;
        دع قائمة: متجه صندوق عبارة = [صندوق_ت];
        دع الثاني: كتلة_عبارات = {
            النطاق: نطاق_ت,
            العبارات: قائمة
        };
        دع الكل: نطاق = دمج_نطاق(البداية, نطاق_ت);
        أرجع اختياري.موجود(عبارة.إذا(الكل, الشرط, الأول, اختياري.موجود(الثاني)));
    };
}

عرف ابن_إذا_كتلة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختياري عبارة {
    دع الثاني: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الثاني مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ك) -> {
        دع الكل: نطاق = دمج_نطاق(البداية, ك.النطاق);
        أرجع اختياري.موجود(عبارة.إذا(الكل, الشرط, الأول, اختياري.موجود(ك)));
    };
}

عرف أكمل_بديل_إذا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختياري عبارة {
    إذا (!اقبل(الرموز, المؤشر, رمز.وإلا())) {
        أرجع ابن_إذا_بلا_بديل(البداية, الشرط, الأول);
    };
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.إذا()) {
        أرجع ابن_إذا_متداخل(المصدر, الرموز, المؤشر, البداية, الشرط, الأول);
    };
    أرجع ابن_إذا_كتلة(المصدر, الرموز, المؤشر, البداية, الشرط, الأول);
}

عرف حلل_مطابقة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع القيمة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق القيمة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ت) -> {
        أرجع أكمل_مطابقة(المصدر, الرموز, المؤشر, البداية, ت);
    };
}

عرف أكمل_مطابقة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    القيمة: تعبير
): اختياري ناتج_عبارة {
    إذا (!توقع(الرموز, المؤشر, رمز.مع())) {
        أرجع اختياري.لا_شيء();
    };
    دع الأذرع: متغير متجه ذراع_مطابقة = [];
    طالما (اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
        دع النمط: اختياري نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
        طابق النمط مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ن) -> {
            إذا (!توقع(الرموز, المؤشر, رمز.سهم_يمين())) {
                أرجع اختياري.لا_شيء();
            };
            دع الجسم: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
            طابق الجسم مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(ك) -> {
                دع الذراع: ذراع_مطابقة = {
                    النمط: ن,
                    الجسم: ك
                };
                ألحق(الأذرع, الذراع);
            };
        };
    }
    إذا (الطول(الأذرع) == 0) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
        ارفض(الرموز, المؤشر, الفئة, رمز.أو_بتي());
        أرجع اختياري.لا_شيء();
    };
    اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع ت: عبارة = عبارة.طابق(دمج_نطاق(البداية, النهاية), القيمة, الأذرع);
    أرجع اختياري.موجود(نتيجة_واحدة(ت));
}

عرف حلل_تجميعا(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_نص()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_نص());
        أرجع اختياري.لا_شيء();
    };
    دع المحاولة: اختياري متجه ط8 = نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر));
    طابق المحاولة مع
    | اختياري.لا_شيء -> {
        ارفض_داخليا(الرموز, المؤشر);
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النص) -> {
        تقدم(الرموز, المؤشر);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع ت: عبارة = عبارة.تجميع(دمج_نطاق(البداية, النهاية), النص);
        أرجع اختياري.موجود(نتيجة_واحدة(ت));
    };
}

عرف حلل_غير_آمن(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع الجسم: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الجسم مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ك) -> {
        اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
        دع ت: عبارة = عبارة.غير_آمن(دمج_نطاق(البداية, ك.النطاق), ك);
        أرجع اختياري.موجود(نتيجة_واحدة(ت));
    };
}

// Statement comptime blocks accept the full ordinary statement grammar.
// Their execution is handled later by verified MSIR, not by this parser.
عرف حلل_كتلة_وقت_الترجمة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    طابق حلل_كتلة(المصدر, الرموز, المؤشر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الجسم) -> {
        اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
        دع العبارة: عبارة = عبارة.وقت_الترجمة(دمج_نطاق(البداية, الجسم.النطاق), الجسم);
        أرجع اختياري.موجود(نتيجة_واحدة(العبارة));
    };
}

عرف حلل_إسنادا_أو_استدعاء(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع له_فك: منطقي = اقبل(الرموز, المؤشر, رمز.نجمة());
    دع الموضع: اختياري تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
    طابق الموضع مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(قيمة) -> {
        إذا (له_فك) {
            دع النهاية: نطاق = نطاق_تعبير(&قيمة);
            دع الأصل: صندوق تعبير = صندوق قيمة;
            دع اليسار: تعبير = تعبير.فك_موضع(دمج_نطاق(البداية, النهاية), الأصل);
            أرجع أكمل_إسنادا_أو_استدعاء(المصدر, الرموز, المؤشر, البداية, اليسار, صواب);
        };
        دع المستدعى_الممكن: تعبير = جرب_حجج_نوع_صريحة(المصدر, الرموز, المؤشر, قيمة);
        أرجع أكمل_إسنادا_أو_استدعاء(المصدر, الرموز, المؤشر, البداية, المستدعى_الممكن, خطأ);
    };
}

عرف أكمل_إسنادا_أو_استدعاء(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    اليسار: تعبير,
    له_فك: منطقي
): اختياري ناتج_عبارة {
    إذا ((!له_فك) && (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار())) {
        دع الاستدعاء: اختياري تعبير = ابن_استدعاء_بعد_موضع(المصدر, الرموز, المؤشر, البداية, اليسار);
        طابق الاستدعاء مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(المستدعى) -> {
            // `f().g();`, `f(x).h.k(y);`: projections and calls on the call
            // result, as in an expression. The statement must still end in a
            // call (or `؟`): `f().x;` does nothing and is rejected below.
            دع المقروء: تعبير;
            طابق حلل_لواحق_ناتج_استدعاء(المصدر, الرموز, المؤشر, البداية, المستدعى) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(ت) -> { المقروء := ت; };
            إذا (نوع_الحالي(الرموز, المؤشر) != رمز.استفهام()) {
                طابق المقروء مع
                | تعبير.استدعاء(_, _, _) -> { }
                | _ -> {
                    دع رفض_بلا_عملية: منطقي = ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.عبارة_بلا_عملية(), رمز.قوس_يسار());
                    أرجع اختياري.لا_شيء();
                };
            };
            دع قيمة: تعبير = علّم_انتشارا_إن_وجد(الرموز, المؤشر, المقروء);
            إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                أرجع اختياري.لا_شيء();
            };
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع ت: عبارة = عبارة.استدعاء(دمج_نطاق(البداية, النهاية), قيمة);
            أرجع اختياري.موجود(نتيجة_واحدة(ت));
        };
    };
    // `place؟;` propagates the error or absence held in a place.
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.استفهام()) {
        دع الموسومة: تعبير = علّم_انتشارا_إن_وجد(الرموز, المؤشر, اليسار);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        دع نهاية_الموسومة: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع عبارة_الموسومة: عبارة = عبارة.استدعاء(دمج_نطاق(البداية, نهاية_الموسومة), الموسومة);
        أرجع اختياري.موجود(نتيجة_واحدة(عبارة_الموسومة));
    };
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.فاصلة_منقوطة()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عبارة_بلا_عملية();
        دع رفض: منطقي = ارفض(الرموز, المؤشر, الفئة, رمز.إسناد());
        أرجع اختياري.لا_شيء();
    };
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.إسناد()) {
        طابق اقترح_تهجئة_كلمة_عبارة(المصدر, البداية) مع
        | اختياري.موجود(الاقتراح) -> {
            دع رفض: منطقي = ارفض_تهجئة_كلمة_محجوزة(
                المؤشر, البداية, الاقتراح.الرمز, الاقتراح.التهجئة
            );
            أرجع اختياري.لا_شيء();
        }
        | اختياري.لا_شيء -> { };
    };
    إذا (!توقع(الرموز, المؤشر, رمز.إسناد())) {
        أرجع اختياري.لا_شيء();
    };
    إذا (بداية_كتلة_وقت_الترجمة(الرموز, المؤشر)) {
        طابق حلل_كتلة_قيمة_وقت_الترجمة(المصدر, الرموز, المؤشر) مع
        | نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة -> { أرجع اختياري.لا_شيء(); }
        | نتيجة_كتلة_قيمة_وقت_الترجمة.كتلة(جسم_الكتلة, ناتج_الكتلة) -> {
            إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                أرجع اختياري.لا_شيء();
            };
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع ت: عبارة = عبارة.إسناد_وقت_الترجمة(
                دمج_نطاق(البداية, النهاية), اليسار, جسم_الكتلة, ناتج_الكتلة
            );
            أرجع اختياري.موجود(نتيجة_واحدة(ت));
        }
        | نتيجة_كتلة_قيمة_وقت_الترجمة.تعبيرية -> { };
    };
    دع اليمين: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق اليمين مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(المقروء) -> {
        دع ر: تعبير = علّم_انتشارا_إن_وجد(الرموز, المؤشر, المقروء);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع ت: عبارة = عبارة.نسخ(دمج_نطاق(البداية, النهاية), اليسار, ر);
        أرجع اختياري.موجود(نتيجة_واحدة(ت));
    };
}

عرف حلل_عبارة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    إذا (النوع == رمز.دع()) {
        أرجع حلل_ربطا(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.أرجع()) {
        أرجع حلل_إرجاعا(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.طالما()) {
        أرجع حلل_بينما(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.لكل()) {
        أرجع حلل_لكل(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.اخرج_من_حلقة()) {
        أرجع حلل_تحكم_حلقة(الرموز, المؤشر, خطأ);
    };
    إذا (النوع == رمز.تابع_حلقة()) {
        أرجع حلل_تحكم_حلقة(الرموز, المؤشر, صواب);
    };
    إذا (النوع == رمز.إذا()) {
        دع النتيجة: اختياري عبارة = ابن_إذا(المصدر, الرموز, المؤشر);
        طابق النتيجة مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ت) -> {
            اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
            أرجع اختياري.موجود(نتيجة_واحدة(ت));
        };
    };
    إذا (النوع == رمز.طابق()) {
        أرجع حلل_مطابقة(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.تجميع()) {
        أرجع حلل_تجميعا(الرموز, المؤشر);
    };
    إذا (النوع == رمز.غير_آمن()) {
        أرجع حلل_غير_آمن(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.وقت_الترجمة()) {
        أرجع حلل_كتلة_وقت_الترجمة(المصدر, الرموز, المؤشر);
    };
    إذا ((النوع == رمز.معرف()) || (النوع == رمز.نجمة()) || (النوع == رمز.قوس_يسار())) {
        أرجع حلل_إسنادا_أو_استدعاء(المصدر, الرموز, المؤشر);
    };
    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
    ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
    أرجع اختياري.لا_شيء();
}
