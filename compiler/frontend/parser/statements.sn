نوع اقتراح_تهجئة_كلمة_عبارة = {
    الرمز: رمز,
    التهجئة: تهجئة_كلمة_مقترحة
};

عرف محارف_يوتيف8_في_شريحة(
    النص: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع
): متجه غ32 {
    دع الناتج: متغير متجه غ32 = [];
    دع الموضع: متغير غير_موقع = البداية;
    بينما (الموضع < النهاية) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, الموضع);
        لو (!المفكوك.صالح || ((الموضع + المفكوك.العرض) > النهاية)) {
            دع الفارغ: متجه غ32 = [];
            أرجع الفارغ;
        };
        ألحق(الناتج, المفكوك.القيمة);
        الموضع := الموضع + المفكوك.العرض;
    }
    أرجع الناتج;
}

عرف محارف_نطاق_مصدر(المصدر: &مصدر, النطاق: نطاق): متجه غ32 {
    دع الأصل: مصدر = *المصدر;
    أرجع محارف_يوتيف8_في_شريحة(
        &الأصل.المحتوى, النطاق.البداية.البايت, النطاق.النهاية.البايت
    );
}

عرف محارف_نص_كامل(النص: &نص): متجه غ32 {
    دع القيمة: نص = *النص;
    أرجع محارف_يوتيف8_في_شريحة(&القيمة, 0, الطول(القيمة) مثل غير_موقع);
}

عرف يحوي_محرفا_زائدا_واحدا(
    الأطول: &متجه غ32,
    الأقصر: &متجه غ32
): منطقي {
    دع أ: متجه غ32 = *الأطول;
    دع ب: متجه غ32 = *الأقصر;
    لو ((الطول(أ) مثل غير_موقع) != ((الطول(ب) مثل غير_موقع) + 1)) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    دع ج: متغير غير_موقع = 0;
    دع تخطى: متغير منطقي = خطأ;
    بينما ((ف < (الطول(أ) مثل غير_موقع)) && (ج < (الطول(ب) مثل غير_موقع))) {
        لو (أ[ف] == ب[ج]) {
            ف := ف + 1;
            ج := ج + 1;
        } وإلا {
            لو (تخطى) {
                أرجع خطأ;
            };
            تخطى := صواب;
            ف := ف + 1;
        };
    }
    أرجع صواب;
}

عرف تهجئتان_متقاربتان_بتعديل_واحد(
    الأولى: &متجه غ32,
    الثانية: &متجه غ32
): منطقي {
    دع أ: متجه غ32 = *الأولى;
    دع ب: متجه غ32 = *الثانية;
    دع طول_أ: غير_موقع = الطول(أ) مثل غير_موقع;
    دع طول_ب: غير_موقع = الطول(ب) مثل غير_موقع;
    لو (طول_أ == طول_ب) {
        دع الأول: متغير غير_موقع = طول_أ;
        دع الثاني: متغير غير_موقع = طول_أ;
        دع عدد_الاختلافات: متغير غير_موقع = 0;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < طول_أ) {
            لو (أ[ف] != ب[ف]) {
                لو (عدد_الاختلافات == 0) {
                    الأول := ف;
                } وإلا {
                    لو (عدد_الاختلافات == 1) {
                        الثاني := ف;
                    };
                };
                عدد_الاختلافات := عدد_الاختلافات + 1;
                لو (عدد_الاختلافات > 2) {
                    أرجع خطأ;
                };
            };
            ف := ف + 1;
        }
        لو (عدد_الاختلافات == 1) {
            أرجع صواب;
        };
        لو (
            (عدد_الاختلافات == 2)
            && (الثاني == (الأول + 1))
            && (أ[الأول] == ب[الثاني])
            && (أ[الثاني] == ب[الأول])
        ) {
            أرجع صواب;
        };
        أرجع خطأ;
    };
    لو (طول_أ == (طول_ب + 1)) {
        أرجع يحوي_محرفا_زائدا_واحدا(&أ, &ب);
    };
    لو (طول_ب == (طول_أ + 1)) {
        أرجع يحوي_محرفا_زائدا_واحدا(&ب, &أ);
    };
    أرجع خطأ;
}

عرف تهجئة_نطاق_قريبة_من(
    المصدر: &مصدر,
    النطاق: نطاق,
    المرشح: &نص
): منطقي {
    دع المصدر_محارف: متجه غ32 = محارف_نطاق_مصدر(المصدر, النطاق);
    دع المرشح_محارف: متجه غ32 = محارف_نص_كامل(المرشح);
    لو (
        ((الطول(المصدر_محارف) مثل غير_موقع) == 0)
        || ((الطول(المرشح_محارف) مثل غير_موقع) == 0)
    ) {
        أرجع خطأ;
    };
    أرجع تهجئتان_متقاربتان_بتعديل_واحد(&المصدر_محارف, &المرشح_محارف);
}

عرف اقترح_تهجئة_مرشح_عبارة(
    المصدر: &مصدر,
    النطاق: نطاق,
    المرشح: رمز
): اختيار اقتراح_تهجئة_كلمة_عبارة {
    دع العربية: نص = تهجئة_عرض_رمز_عربية(المرشح);
    لو (تهجئة_نطاق_قريبة_من(المصدر, النطاق, &العربية)) {
        دع التهجئة: تهجئة_كلمة_مقترحة = تهجئة_كلمة_مقترحة.عربية();
        دع الاقتراح: اقتراح_تهجئة_كلمة_عبارة = {
            الرمز: المرشح,
            التهجئة: التهجئة
        };
        أرجع اختيار.بعض(الاقتراح);
    };
    دع الإنجليزية: نص = تهجئة_عرض_رمز_إنجليزية(المرشح);
    لو (تهجئة_نطاق_قريبة_من(المصدر, النطاق, &الإنجليزية)) {
        دع التهجئة: تهجئة_كلمة_مقترحة = تهجئة_كلمة_مقترحة.إنجليزية();
        دع الاقتراح: اقتراح_تهجئة_كلمة_عبارة = {
            الرمز: المرشح,
            التهجئة: التهجئة
        };
        أرجع اختيار.بعض(الاقتراح);
    };
    أرجع اختيار.لا_شيء();
}

عرف اقترح_تهجئة_كلمة_عبارة(
    المصدر: &مصدر,
    النطاق: نطاق
): اختيار اقتراح_تهجئة_كلمة_عبارة {
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.دع()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.أرجع()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.بينما()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.لكل()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.اخرج_من_حلقة()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.تابع_حلقة()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.لو()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.طابق()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.تجميع()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.غير_آمن()) مع
    | اختيار.بعض(الاقتراح) -> { أرجع اختيار.بعض(الاقتراح); }
    | اختيار.لا_شيء -> { };
    أرجع اختيار.لا_شيء();
}

نوع ناتج_عبارة =
    | واحدة بنوع صندوق عبارة
    | اثنتان بنوع (صندوق عبارة, صندوق عبارة)
;

عرف نتيجة_واحدة(القيمة: عبارة): ناتج_عبارة {
    دع الصندوق: صندوق عبارة = صندوق القيمة;
    أرجع ناتج_عبارة.واحدة(الصندوق);
}

عرف نتيجة_اثنتين(الأولى: عبارة, الثانية: عبارة): ناتج_عبارة {
    دع أ: صندوق عبارة = صندوق الأولى;
    دع ب: صندوق عبارة = صندوق الثانية;
    أرجع ناتج_عبارة.اثنتان(أ, ب);
}

عرف حوّل_تهيئة(
    النطاق: نطاق,
    الوجهة: تعبير,
    التهيئة: صيغة_تهيئة
): عبارة {
    طابق التهيئة مع
    | صيغة_تهيئة.تعبير(س, القيمة) -> {
        أرجع عبارة.نسخ(النطاق, الوجهة, القيمة);
    }
    | صيغة_تهيئة.صف(س, القيم) -> {
        أرجع عبارة.تهيئة_صف(النطاق, الوجهة, القيم);
    }
    | صيغة_تهيئة.متجه(س, القيم) -> {
        أرجع عبارة.تهيئة_متجه(النطاق, الوجهة, القيم);
    }
    | صيغة_تهيئة.سجل(س, الحقول) -> {
        أرجع عبارة.تهيئة_سجل(النطاق, الوجهة, الحقول);
    }
    | صيغة_تهيئة.صندوق(س, القيمة) -> {
        أرجع عبارة.تهيئة_صندوق(النطاق, الوجهة, القيمة);
    };
}

عرف حلل_ربطا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
        أرجع اختيار.لا_شيء();
    };
    دع النوع_نتيجة: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق النوع_نتيجة مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النوع) -> {
        أرجع أكمل_ربطا(المصدر, الرموز, المؤشر, البداية, الاسم, النوع);
    };
}

عرف أكمل_ربطا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الاسم: اسم,
    النوع: نوع_تركيبي
): اختيار ناتج_عبارة {
    لو (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        أرجع اختيار.بعض(نتيجة_واحدة(عبارة.تصريح_متغير(النطاق, الاسم, النوع)));
    };
    لو (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) {
        أرجع اختيار.لا_شيء();
    };
    دع التهيئة_نتيجة: اختيار صيغة_تهيئة = حلل_تهيئة(المصدر, الرموز, المؤشر);
    طابق التهيئة_نتيجة مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(التهيئة) -> {
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختيار.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        دع الوجهة: تعبير = تعبير.اسم(النطاق, الاسم);
        دع التصريح: عبارة = عبارة.تصريح_متغير(النطاق, الاسم, النوع);
        دع البدء: عبارة = حوّل_تهيئة(النطاق, الوجهة, التهيئة);
        أرجع اختيار.بعض(نتيجة_اثنتين(التصريح, البدء));
    };
}

عرف حلل_إرجاعا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع العبارة: عبارة = عبارة.أرجع(دمج_نطاق(البداية, النهاية), اختيار.لا_شيء());
        أرجع اختيار.بعض(نتيجة_واحدة(العبارة));
    };
    دع النتيجة: اختيار تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق النتيجة مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(القيمة) -> {
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختيار.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع العبارة: عبارة = عبارة.أرجع(دمج_نطاق(البداية, النهاية), اختيار.بعض(القيمة));
        أرجع اختيار.بعض(نتيجة_واحدة(العبارة));
    };
}

عام عرف حلل_كتلة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار كتلة_عبارات {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.معقوف_يسار())) {
        أرجع اختيار.لا_شيء();
    };
    دع العبارات: متغير متجه صندوق عبارة = [];
    بينما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        لو (نوع_الحالي(الرموز, المؤشر) == رمز.نهاية_الملف()) {
            دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
            ارفض(الرموز, المؤشر, الفئة, رمز.معقوف_يمين());
            أرجع اختيار.لا_شيء();
        };
        دع النتيجة: اختيار ناتج_عبارة = حلل_عبارة(المصدر, الرموز, المؤشر);
        طابق النتيجة مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(ن) -> {
            طابق ن مع
            | ناتج_عبارة.واحدة(أ) -> {
                ألحق(العبارات, أ);
            }
            | ناتج_عبارة.اثنتان(أ, ب) -> {
                ألحق(العبارات, أ);
                ألحق(العبارات, ب);
            };
        };
    }
    لو (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع نطاق_الكتلة: نطاق = دمج_نطاق(البداية, النهاية);
    دع الكتلة: كتلة_عبارات = {
        النطاق: نطاق_الكتلة,
        العبارات: العبارات
    };
    أرجع اختيار.بعض(الكتلة);
}

عرف حلل_بينما(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختيار.لا_شيء();
    };
    دع الشرط: اختيار تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق الشرط مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ق) -> {
        أرجع أكمل_بينما(المصدر, الرموز, المؤشر, البداية, ق);
    };
}

عرف أكمل_بينما(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير
): اختيار ناتج_عبارة {
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    دع الجسم: اختيار كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الجسم مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ك) -> {
        دع ت: عبارة = عبارة.بينما(
            دمج_نطاق(البداية, ك.النطاق),
            الشرط,
            ك
        );
        أرجع اختيار.بعض(نتيجة_واحدة(ت));
    };
}

عرف عبارات_ناتج_إلى_متجه(الناتج: ناتج_عبارة): متجه صندوق عبارة {
    دع العبارات: متغير متجه صندوق عبارة = [];
    طابق الناتج مع
    | ناتج_عبارة.واحدة(أ) -> { ألحق(العبارات, أ); }
    | ناتج_عبارة.اثنتان(أ, ب) -> { ألحق(العبارات, أ); ألحق(العبارات, ب); };
    أرجع العبارات;
}

عرف حلل_خطوة_لكل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار صندوق عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع له_فك: منطقي = اقبل(الرموز, المؤشر, رمز.نجمة());
    دع الموضع: اختيار تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
    دع اليسار: متغير تعبير = تعبير.حرفي(البداية, حرفي.غير_معرف());
    طابق الموضع مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قيمة) -> {
        لو (له_فك) {
            دع النهاية: نطاق = نطاق_تعبير(&قيمة);
            دع الأصل: صندوق تعبير = صندوق قيمة;
            اليسار := تعبير.فك_موضع(دمج_نطاق(البداية, النهاية), الأصل);
        } وإلا {
            اليسار := قيمة;
        };
    };
    لو (!توقع(الرموز, المؤشر, رمز.إسناد())) { أرجع اختيار.لا_شيء(); };
    دع اليمين: اختيار تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق اليمين مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ر) -> {
        دع النطاق: نطاق = دمج_نطاق(البداية, نطاق_تعبير(&ر));
        دع ت: عبارة = عبارة.نسخ(النطاق, اليسار, ر);
        دع الصندوق: صندوق عبارة = صندوق ت;
        أرجع اختيار.بعض(الصندوق);
    };
}

عرف حلل_لكل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) { أرجع اختيار.لا_شيء(); };
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.دع()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
        ارفض(الرموز, المؤشر, الفئة, رمز.دع());
        أرجع اختيار.لا_شيء();
    };
    دع البداية_نتيجة: اختيار ناتج_عبارة = حلل_ربطا(المصدر, الرموز, المؤشر);
    دع البداية_عبارات: متغير متجه صندوق عبارة = [];
    طابق البداية_نتيجة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ن) -> { البداية_عبارات := عبارات_ناتج_إلى_متجه(ن); };
    دع الشرط_نتيجة: اختيار تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    دع الشرط: متغير تعبير = تعبير.حرفي(البداية, حرفي.منطقي(صواب));
    طابق الشرط_نتيجة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ق) -> { الشرط := ق; };
    لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { أرجع اختيار.لا_شيء(); };
    دع الخطوة_نتيجة: اختيار صندوق عبارة = حلل_خطوة_لكل(المصدر, الرموز, المؤشر);
    طابق الخطوة_نتيجة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الخطوة) -> {
        لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع اختيار.لا_شيء(); };
        دع الجسم_نتيجة: اختيار كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
        طابق الجسم_نتيجة مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الجسم) -> {
            دع ت: عبارة = عبارة.لكل(دمج_نطاق(البداية, الجسم.النطاق), البداية_عبارات, الشرط, الخطوة, الجسم);
            أرجع اختيار.بعض(نتيجة_واحدة(ت));
        };
    };
}

عرف حلل_تحكم_حلقة(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    متابعة: منطقي
): اختيار ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { أرجع اختيار.لا_شيء(); };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
    لو (متابعة) { أرجع اختيار.بعض(نتيجة_واحدة(عبارة.تابع_حلقة(النطاق))); };
    أرجع اختيار.بعض(نتيجة_واحدة(عبارة.اخرج_من_حلقة(النطاق)));
}

عرف ابن_لو(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختيار.لا_شيء();
    };
    دع الشرط: اختيار تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق الشرط مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ق) -> {
        أرجع أكمل_لو(المصدر, الرموز, المؤشر, البداية, ق);
    };
}

عرف أكمل_لو(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير
): اختيار عبارة {
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    دع الفرع: اختيار كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الفرع مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الأول) -> {
        أرجع أكمل_بديل_لو(المصدر, الرموز, المؤشر, البداية, الشرط, الأول);
    };
}

عرف ابن_لو_بلا_بديل(
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختيار عبارة {
    دع النهاية: نطاق = دمج_نطاق(البداية, الأول.النطاق);
    أرجع اختيار.بعض(عبارة.لو(النهاية, الشرط, الأول, اختيار.لا_شيء()));
}

عرف ابن_لو_متداخل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختيار عبارة {
    دع بداية_المتداخل: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع المتداخل: اختيار عبارة = ابن_لو(المصدر, الرموز, المؤشر);
    طابق المتداخل مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ت) -> {
        دع آخر_المتداخل: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع نطاق_ت: نطاق = دمج_نطاق(بداية_المتداخل, آخر_المتداخل);
        دع صندوق_ت: صندوق عبارة = صندوق ت;
        دع قائمة: متجه صندوق عبارة = [صندوق_ت];
        دع الثاني: كتلة_عبارات = {
            النطاق: نطاق_ت,
            العبارات: قائمة
        };
        دع الكل: نطاق = دمج_نطاق(البداية, نطاق_ت);
        أرجع اختيار.بعض(عبارة.لو(الكل, الشرط, الأول, اختيار.بعض(الثاني)));
    };
}

عرف ابن_لو_كتلة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختيار عبارة {
    دع الثاني: اختيار كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الثاني مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ك) -> {
        دع الكل: نطاق = دمج_نطاق(البداية, ك.النطاق);
        أرجع اختيار.بعض(عبارة.لو(الكل, الشرط, الأول, اختيار.بعض(ك)));
    };
}

عرف أكمل_بديل_لو(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختيار عبارة {
    لو (!اقبل(الرموز, المؤشر, رمز.وإلا())) {
        أرجع ابن_لو_بلا_بديل(البداية, الشرط, الأول);
    };
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.لو()) {
        أرجع ابن_لو_متداخل(المصدر, الرموز, المؤشر, البداية, الشرط, الأول);
    };
    أرجع ابن_لو_كتلة(المصدر, الرموز, المؤشر, البداية, الشرط, الأول);
}

عرف حلل_مطابقة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع القيمة: اختيار تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق القيمة مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ت) -> {
        أرجع أكمل_مطابقة(المصدر, الرموز, المؤشر, البداية, ت);
    };
}

عرف أكمل_مطابقة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    القيمة: تعبير
): اختيار ناتج_عبارة {
    لو (!توقع(الرموز, المؤشر, رمز.مع())) {
        أرجع اختيار.لا_شيء();
    };
    دع الأذرع: متغير متجه ذراع_مطابقة = [];
    بينما (اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
        دع النمط: اختيار نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
        طابق النمط مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(ن) -> {
            لو (!توقع(الرموز, المؤشر, رمز.سهم_يمين())) {
                أرجع اختيار.لا_شيء();
            };
            دع الجسم: اختيار كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
            طابق الجسم مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            }
            | اختيار.بعض(ك) -> {
                دع الذراع: ذراع_مطابقة = {
                    النمط: ن,
                    الجسم: ك
                };
                ألحق(الأذرع, الذراع);
            };
        };
    }
    لو (الطول(الأذرع) == 0) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
        ارفض(الرموز, المؤشر, الفئة, رمز.أو_بتي());
        أرجع اختيار.لا_شيء();
    };
    اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع ت: عبارة = عبارة.طابق(دمج_نطاق(البداية, النهاية), القيمة, الأذرع);
    أرجع اختيار.بعض(نتيجة_واحدة(ت));
}

عرف حلل_تجميعا(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_نص()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_نص());
        أرجع اختيار.لا_شيء();
    };
    دع المحاولة: اختيار متجه غ8 = نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر));
    طابق المحاولة مع
    | اختيار.لا_شيء -> {
        ارفض_داخليا(الرموز, المؤشر);
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النص) -> {
        تقدم(الرموز, المؤشر);
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختيار.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع ت: عبارة = عبارة.تجميع(دمج_نطاق(البداية, النهاية), النص);
        أرجع اختيار.بعض(نتيجة_واحدة(ت));
    };
}

عرف حلل_غير_آمن(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع الجسم: اختيار كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الجسم مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ك) -> {
        اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
        دع ت: عبارة = عبارة.غير_آمن(دمج_نطاق(البداية, ك.النطاق), ك);
        أرجع اختيار.بعض(نتيجة_واحدة(ت));
    };
}

عرف حلل_إسنادا_أو_استدعاء(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار ناتج_عبارة {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع له_فك: منطقي = اقبل(الرموز, المؤشر, رمز.نجمة());
    دع الموضع: اختيار تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
    طابق الموضع مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(قيمة) -> {
        لو (له_فك) {
            دع النهاية: نطاق = نطاق_تعبير(&قيمة);
            دع الأصل: صندوق تعبير = صندوق قيمة;
            دع اليسار: تعبير = تعبير.فك_موضع(دمج_نطاق(البداية, النهاية), الأصل);
            أرجع أكمل_إسنادا_أو_استدعاء(المصدر, الرموز, المؤشر, البداية, اليسار, صواب);
        };
        أرجع أكمل_إسنادا_أو_استدعاء(المصدر, الرموز, المؤشر, البداية, قيمة, خطأ);
    };
}

عرف أكمل_إسنادا_أو_استدعاء(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    اليسار: تعبير,
    له_فك: منطقي
): اختيار ناتج_عبارة {
    لو ((!له_فك) && (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار())) {
        دع الاستدعاء: اختيار تعبير = ابن_استدعاء_بعد_موضع(المصدر, الرموز, المؤشر, البداية, اليسار);
        طابق الاستدعاء مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(قيمة) -> {
            لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                أرجع اختيار.لا_شيء();
            };
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع ت: عبارة = عبارة.استدعاء(دمج_نطاق(البداية, النهاية), قيمة);
            أرجع اختيار.بعض(نتيجة_واحدة(ت));
        };
    };
    لو (نوع_الحالي(الرموز, المؤشر) == رمز.فاصلة_منقوطة()) {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عبارة_بلا_عملية();
        دع رفض: منطقي = ارفض(الرموز, المؤشر, الفئة, رمز.إسناد());
        أرجع اختيار.لا_شيء();
    };
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.إسناد()) {
        طابق اقترح_تهجئة_كلمة_عبارة(المصدر, البداية) مع
        | اختيار.بعض(الاقتراح) -> {
            دع رفض: منطقي = ارفض_تهجئة_كلمة_محجوزة(
                المؤشر, البداية, الاقتراح.الرمز, الاقتراح.التهجئة
            );
            أرجع اختيار.لا_شيء();
        }
        | اختيار.لا_شيء -> { };
    };
    لو (!توقع(الرموز, المؤشر, رمز.إسناد())) {
        أرجع اختيار.لا_شيء();
    };
    دع اليمين: اختيار تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق اليمين مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(ر) -> {
        لو (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختيار.لا_شيء();
        };
        دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        دع ت: عبارة = عبارة.نسخ(دمج_نطاق(البداية, النهاية), اليسار, ر);
        أرجع اختيار.بعض(نتيجة_واحدة(ت));
    };
}

عرف حلل_عبارة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار ناتج_عبارة {
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    لو (النوع == رمز.دع()) {
        أرجع حلل_ربطا(المصدر, الرموز, المؤشر);
    };
    لو (النوع == رمز.أرجع()) {
        أرجع حلل_إرجاعا(المصدر, الرموز, المؤشر);
    };
    لو (النوع == رمز.بينما()) {
        أرجع حلل_بينما(المصدر, الرموز, المؤشر);
    };
    لو (النوع == رمز.لكل()) {
        أرجع حلل_لكل(المصدر, الرموز, المؤشر);
    };
    لو (النوع == رمز.اخرج_من_حلقة()) {
        أرجع حلل_تحكم_حلقة(الرموز, المؤشر, خطأ);
    };
    لو (النوع == رمز.تابع_حلقة()) {
        أرجع حلل_تحكم_حلقة(الرموز, المؤشر, صواب);
    };
    لو (النوع == رمز.لو()) {
        دع النتيجة: اختيار عبارة = ابن_لو(المصدر, الرموز, المؤشر);
        طابق النتيجة مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(ت) -> {
            اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
            أرجع اختيار.بعض(نتيجة_واحدة(ت));
        };
    };
    لو (النوع == رمز.طابق()) {
        أرجع حلل_مطابقة(المصدر, الرموز, المؤشر);
    };
    لو (النوع == رمز.تجميع()) {
        أرجع حلل_تجميعا(الرموز, المؤشر);
    };
    لو (النوع == رمز.غير_آمن()) {
        أرجع حلل_غير_آمن(المصدر, الرموز, المؤشر);
    };
    لو ((النوع == رمز.معرف()) || (النوع == رمز.نجمة())) {
        أرجع حلل_إسنادا_أو_استدعاء(المصدر, الرموز, المؤشر);
    };
    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
    ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
    أرجع اختيار.لا_شيء();
}
