استورد المكتبة.ترميز.يوتيف8;
نوع اقتراح_تهجئة_كلمة_عبارة = {
    الرمز: رمز,
    التهجئة: تهجئة_كلمة_مقترحة
};

عرف محارف_يوتيف8_في_شريحة(
    النص: &نص,
    البداية: طبيعي,
    النهاية: طبيعي
): متجه ط32 {
    ليكن الناتج: متغير متجه ط32 = [];
    ليكن الموضع: متغير طبيعي = البداية;
    طالما (الموضع < النهاية) {
        ليكن المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, الموضع);
        إذا (!المفكوك.صالح || ((الموضع + المفكوك.العرض) > النهاية)) {
            ليكن الفارغ: متجه ط32 = [];
            أرجع الفارغ;
        };
        ألحق(الناتج, المفكوك.القيمة);
        الموضع := الموضع + المفكوك.العرض;
    }
    أرجع الناتج;
}

عرف محارف_نطاق_مصدر(المصدر: &مصدر, النطاق: نطاق): متجه ط32 {
    أرجع محارف_يوتيف8_في_شريحة(
        &(*المصدر).المحتوى, النطاق.البداية.البايت, النطاق.النهاية.البايت
    );
}

عرف محارف_نص_كامل(النص: &نص): متجه ط32 {
    ليكن القيمة: نص = *النص;
    أرجع محارف_يوتيف8_في_شريحة(&القيمة, 0, الطول(القيمة) مثل طبيعي);
}

عرف يحوي_محرفا_زائدا_واحدا(
    الأطول: &متجه ط32,
    الأقصر: &متجه ط32
): منطقي {
    ليكن أ: متجه ط32 = *الأطول;
    ليكن ب: متجه ط32 = *الأقصر;
    ليكن طول_أ: طبيعي = الطول(أ) مثل طبيعي;
    ليكن طول_ب: طبيعي = الطول(ب) مثل طبيعي;
    إذا (طول_أ != طول_ب + 1) {
        أرجع خطأ;
    };
    ليكن ف: متغير طبيعي = 0;
    ليكن ج: متغير طبيعي = 0;
    ليكن تخطى: متغير منطقي = خطأ;
    طالما ((ف < (الطول(أ) مثل طبيعي)) && (ج < (الطول(ب) مثل طبيعي))) {
        إذا (أ[ف] == ب[ج]) {
            ف := ف + 1;
            ج := ج + 1;
        } وإلا {
            إذا (تخطى) {
                أرجع خطأ;
            };
            تخطى := صواب;
            ف := ف + 1;
        };
    }
    أرجع صواب;
}

عرف تهجئتان_متقاربتان_بتعديل_واحد(
    الأولى: &متجه ط32,
    الثانية: &متجه ط32
): منطقي {
    ليكن أ: متجه ط32 = *الأولى;
    ليكن ب: متجه ط32 = *الثانية;
    ليكن طول_أ: طبيعي = الطول(أ) مثل طبيعي;
    ليكن طول_ب: طبيعي = الطول(ب) مثل طبيعي;
    إذا (طول_أ == طول_ب) {
        ليكن الأول: متغير طبيعي = طول_أ;
        ليكن الثاني: متغير طبيعي = طول_أ;
        ليكن عدد_الاختلافات: متغير طبيعي = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < طول_أ) {
            إذا (أ[ف] != ب[ف]) {
                إذا (عدد_الاختلافات == 0) {
                    الأول := ف;
                } وإلا {
                    إذا (عدد_الاختلافات == 1) {
                        الثاني := ف;
                    };
                };
                عدد_الاختلافات := عدد_الاختلافات + 1;
                إذا (عدد_الاختلافات > 2) {
                    أرجع خطأ;
                };
            };
            ف := ف + 1;
        }
        إذا (عدد_الاختلافات == 1) {
            أرجع صواب;
        };
        إذا (
            (عدد_الاختلافات == 2)
            && (الثاني == (الأول + 1))
            && (أ[الأول] == ب[الثاني])
            && (أ[الثاني] == ب[الأول])
        ) {
            أرجع صواب;
        };
        أرجع خطأ;
    };
    إذا (طول_أ == (طول_ب + 1)) {
        أرجع يحوي_محرفا_زائدا_واحدا(&أ, &ب);
    };
    إذا (طول_ب == (طول_أ + 1)) {
        أرجع يحوي_محرفا_زائدا_واحدا(&ب, &أ);
    };
    أرجع خطأ;
}

عرف تهجئة_نطاق_قريبة_من(
    المصدر: &مصدر,
    النطاق: نطاق,
    المرشح: &نص
): منطقي {
    ليكن المصدر_محارف: متجه ط32 = محارف_نطاق_مصدر(المصدر, النطاق);
    ليكن المرشح_محارف: متجه ط32 = محارف_نص_كامل(المرشح);
    إذا (
        ((الطول(المصدر_محارف) مثل طبيعي) == 0)
        || ((الطول(المرشح_محارف) مثل طبيعي) == 0)
    ) {
        أرجع خطأ;
    };
    أرجع تهجئتان_متقاربتان_بتعديل_واحد(&المصدر_محارف, &المرشح_محارف);
}

عرف اقترح_تهجئة_مرشح_عبارة(
    المصدر: &مصدر,
    النطاق: نطاق,
    المرشح: رمز
): اختياري اقتراح_تهجئة_كلمة_عبارة {
    ليكن العربية: نص = تهجئة_عرض_رمز_عربية(المرشح);
    إذا (تهجئة_نطاق_قريبة_من(المصدر, النطاق, &العربية)) {
        ليكن التهجئة: تهجئة_كلمة_مقترحة = تهجئة_كلمة_مقترحة.عربية();
        ليكن الاقتراح: اقتراح_تهجئة_كلمة_عبارة = {
            الرمز: المرشح,
            التهجئة: التهجئة
        };
        أرجع اختياري.موجود(الاقتراح);
    };
    ليكن الإنجليزية: نص = تهجئة_عرض_رمز_إنجليزية(المرشح);
    إذا (تهجئة_نطاق_قريبة_من(المصدر, النطاق, &الإنجليزية)) {
        ليكن التهجئة: تهجئة_كلمة_مقترحة = تهجئة_كلمة_مقترحة.إنجليزية();
        ليكن الاقتراح: اقتراح_تهجئة_كلمة_عبارة = {
            الرمز: المرشح,
            التهجئة: التهجئة
        };
        أرجع اختياري.موجود(الاقتراح);
    };
    أرجع اختياري.لا_شيء();
}

عرف اقترح_تهجئة_كلمة_عبارة(
    المصدر: &مصدر,
    النطاق: نطاق
): اختياري اقتراح_تهجئة_كلمة_عبارة {
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.ليكن()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.أرجع()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.طالما()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.لكل()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.اخرج_من_حلقة()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.تابع_حلقة()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.إذا()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.طابق()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.تجميع()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    طابق اقترح_تهجئة_مرشح_عبارة(المصدر, النطاق, رمز.غير_آمن()) مع
    | اختياري.موجود(الاقتراح) -> { أرجع اختياري.موجود(الاقتراح); }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

نوع ناتج_عبارة =
    | واحدة بنوع صندوق عبارة
    | اثنتان بنوع (صندوق عبارة, صندوق عبارة)
    // A tuple `let` (`let (a, b): T = e;`), whose names are in scope for the
    // rest of the block: the block reads that rest and makes the match
    // (مطابقة_ربط_صف). Only a block's statements take one.
    | ربط_صف بنوع (نطاق, نمط, نوع_تركيبي, تعبير)
;

عرف نتيجة_واحدة(القيمة: عبارة): ناتج_عبارة {
    ليكن الصندوق: صندوق عبارة = صندوق القيمة;
    أرجع ناتج_عبارة.واحدة(الصندوق);
}

عرف نتيجة_اثنتين(الأولى: عبارة, الثانية: عبارة): ناتج_عبارة {
    ليكن أ: صندوق عبارة = صندوق الأولى;
    ليكن ب: صندوق عبارة = صندوق الثانية;
    أرجع ناتج_عبارة.اثنتان(أ, ب);
}

// `EXPR؟` (docs/en/reference/errors.md): propagation is accepted only as the last postfix
// of a statement's whole right-hand side (`let x: T = EXPR؟;`, `x := EXPR؟;`,
// `return EXPR؟;` and `EXPR؟;`). The parser marks it with the `؟` token's own
// span; frontend/desugar/propagation.sn expands the statement before name
// resolution. A `؟` anywhere else is an unexpected token.
عرف علّم_انتشارا_إن_وجد(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    القيمة: تعبير
): تعبير {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.استفهام()) {
        أرجع القيمة;
    };
    ليكن نطاق_العلامة: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    ليكن الصندوق: صندوق تعبير = صندوق القيمة;
    أرجع تعبير.أحادي(نطاق_العلامة, عامل_أحادي.انتشار(), الصندوق);
}

عرف علّم_تهيئة_بانتشار(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    التهيئة: صيغة_تهيئة
): صيغة_تهيئة {
    طابق التهيئة مع
    | صيغة_تهيئة.تعبير(س, القيمة) -> {
        أرجع صيغة_تهيئة.تعبير(س, علّم_انتشارا_إن_وجد(الرموز, المؤشر, القيمة));
    }
    | _ -> { أرجع التهيئة; };
}

عرف حوّل_تهيئة(
    النطاق: نطاق,
    الوجهة: تعبير,
    التهيئة: صيغة_تهيئة
): عبارة {
    طابق التهيئة مع
    | صيغة_تهيئة.تعبير(س, القيمة) -> {
        أرجع عبارة.نسخ(النطاق, الوجهة, القيمة);
    }
    | صيغة_تهيئة.صف(س, القيم) -> {
        أرجع عبارة.تهيئة_صف(النطاق, الوجهة, القيم);
    }
    | صيغة_تهيئة.متجه(س, القيم) -> {
        أرجع عبارة.تهيئة_متجه(النطاق, الوجهة, القيم);
    }
    | صيغة_تهيئة.سجل(س, الحقول) -> {
        أرجع عبارة.تهيئة_سجل(النطاق, الوجهة, الحقول);
    }
    | صيغة_تهيئة.صندوق(س, القيمة) -> {
        أرجع عبارة.تهيئة_صندوق(النطاق, الوجهة, القيمة);
    };
}

// A statement-valued compile-time block assigned to a place (CT-02):
//   let x: T = comptime { statements; result };
//   x := comptime { statements; result };
// The braced expression form `comptime { e1; e2; }` (expressions only, the
// last one supplying the value) is tried first and keeps its meaning. In the
// statement form the final expression, or a final call statement, supplies
// the value.
نوع نتيجة_كتلة_قيمة_وقت_الترجمة =
    | تعبيرية
    | كتلة بنوع (كتلة_عبارات, تعبير)
    | مرفوضة
;

عرف بداية_كتلة_وقت_الترجمة(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): منطقي {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.وقت_الترجمة()) { أرجع خطأ; };
    ليكن التالي: طبيعي = فهرس_الحالي(المؤشر) + 1;
    إذا (التالي >= (الطول(*الرموز) مثل طبيعي)) { أرجع خطأ; };
    أرجع (*الرموز)[التالي].النوع == رمز.معقوف_يسار();
}

عرف حلل_كتلة_قيمة_وقت_الترجمة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): نتيجة_كتلة_قيمة_وقت_الترجمة {
    ليكن المحفوظ: مؤشر = *المؤشر;
    طابق حلل_تعبيرا(المصدر, الرموز, المؤشر) مع
    | اختياري.موجود(_) -> {
        *المؤشر := المحفوظ;
        أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.تعبيرية();
    }
    | اختياري.لا_شيء -> { *المؤشر := المحفوظ; };
    تقدم(الرموز, المؤشر);
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يسار())) {
        أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
    };
    ليكن العبارات: متغير متجه صندوق عبارة = [];
    طالما (صواب) {
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يمين()
            || نوع_الحالي(الرموز, المؤشر) == رمز.نهاية_الملف()) {
            ليكن رفض: منطقي = ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.تعبير(), رمز.معرف());
            أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
        };
        ليكن قبل_العبارة: مؤشر = *المؤشر;
        طابق حلل_عبارة(المصدر, الرموز, المؤشر) مع
        | اختياري.موجود(ن) -> {
            ليكن الناتج_النهائي: متغير اختياري تعبير = اختياري.لا_شيء();
            طابق ن مع
            | ناتج_عبارة.واحدة(أ) -> {
                إذا (نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يمين()) {
                    ليكن الأخيرة: عبارة = *أ;
                    طابق الأخيرة مع
                    | عبارة.استدعاء(_, الاستدعاء) -> { الناتج_النهائي := اختياري.موجود(انسخ_مملوكا_تعبير(&الاستدعاء)); }
                    | _ -> { };
                };
                طابق الناتج_النهائي مع
                | اختياري.لا_شيء -> { ألحق(العبارات, أ); }
                | اختياري.موجود(_) -> { };
            }
            | ناتج_عبارة.اثنتان(أ, ب) -> {
                ألحق(العبارات, أ);
                ألحق(العبارات, ب);
            }
            | ناتج_عبارة.ربط_صف(نطاق_الربط, _, _, _) -> {
                ليكن رفض_الربط: منطقي = ارفض_نطاقا(المؤشر, نطاق_الربط, فئة_خطأ_نحوي.ربط_صف_غير_صالح());
                أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
            };
            طابق الناتج_النهائي مع
            | اختياري.موجود(الناتج) -> {
                إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
                    أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
                };
                ليكن الكتلة: كتلة_عبارات = {
                    النطاق: دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر)),
                    العبارات: العبارات
                };
                أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.كتلة(الكتلة, الناتج);
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> {
            *المؤشر := قبل_العبارة;
            طابق حلل_تعبيرا(المصدر, الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة(); }
            | اختياري.موجود(الناتج) -> {
                اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
                إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
                    أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
                };
                ليكن الكتلة: كتلة_عبارات = {
                    النطاق: دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر)),
                    العبارات: العبارات
                };
                أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.كتلة(الكتلة, الناتج);
            };
        };
    }
    أرجع نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة();
}

عرف حلل_ربطا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار()) {
        أرجع حلل_ربط_صف(المصدر, الرموز, المؤشر, البداية);
    };
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
        ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    ليكن الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.نقطتان())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن النوع_نتيجة: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    طابق النوع_نتيجة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        أرجع أكمل_ربطا(المصدر, الرموز, المؤشر, البداية, الاسم, النوع);
    };
}

// A tuple `let`: `let (a, (b, _)): (A, (B, C)) = e;` (docs/en/book/
// ch03-02-data-types.md, "Taking a tuple apart"). Its pattern is a tuple of
// names, `_` and nested tuples; any other pattern (a literal, a constructor,
// a range, a vector or record pattern, alternatives, `as`) tests a value and
// belongs in a `match`. The Type is written, as for every `let`, and the
// value is any expression.
عرف حلل_ربط_صف(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق
): اختياري ناتج_عبارة {
    ليكن النمط: نمط;
    طابق حلل_نمطا(المصدر, الرموز, المؤشر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ن) -> { النمط := ن; };
    طابق مخالف_نمط_ربط_صف(&النمط, صواب) مع
    | اختياري.موجود(نطاق_المخالف) -> {
        ليكن رفض: منطقي = ارفض_نطاقا(المؤشر, نطاق_المخالف, فئة_خطأ_نحوي.ربط_صف_غير_صالح());
        أرجع اختياري.لا_شيء();
    }
    | اختياري.لا_شيء -> { };
    إذا (!توقع(الرموز, المؤشر, رمز.نقطتان())) { أرجع اختياري.لا_شيء(); };
    ليكن النوع: نوع_تركيبي;
    طابق حلل_نوعا(المصدر, الرموز, المؤشر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ق) -> { النوع := ق; };
    إذا (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) { أرجع اختياري.لا_شيء(); };
    ليكن القيمة: تعبير;
    طابق حلل_تعبيرا(المصدر, الرموز, المؤشر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ت) -> { القيمة := ت; };
    إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { أرجع اختياري.لا_شيء(); };
    ليكن النطاق: نطاق = دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر));
    أرجع اختياري.موجود(ناتج_عبارة.ربط_صف(النطاق, النمط, النوع, القيمة));
}

// The span of the first part of a tuple `let`'s pattern that is not a tuple
// of names, `_` and nested tuples (the whole pattern when it is no tuple).
عرف مخالف_نمط_ربط_صف(النمط: &نمط, الجذر: منطقي): اختياري نطاق {
    طابق *النمط مع
    | نمط.صف(_, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            طابق مخالف_نمط_ربط_صف(&العناصر[ف], خطأ) مع
            | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | نمط.ربط(النطاق, _) -> {
        إذا (الجذر) { أرجع اختياري.موجود(النطاق); };
        أرجع اختياري.لا_شيء();
    }
    | نمط.بدل(النطاق) -> {
        إذا (الجذر) { أرجع اختياري.موجود(النطاق); };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.موجود(نطاق_نمط(النمط)); };
}

// The match a tuple `let` stands for: `match e with | (a, b) -> { البقية }`,
// the rest of its block as the arm's body, the arm carrying the written Type.
عرف مطابقة_ربط_صف(
    النطاق: نطاق,
    النمط: نمط,
    النوع: نوع_تركيبي,
    القيمة: تعبير,
    البقية: كتلة_عبارات
): صندوق عبارة {
    ليكن بلا_حارس: اختياري تعبير = اختياري.لا_شيء();
    ليكن الذراع: ذراع_مطابقة = {
        النمط: النمط, الحارس: بلا_حارس, الجسم: البقية, نوع_ليكن: اختياري.موجود(النوع)
    };
    ليكن الأذرع: متجه ذراع_مطابقة = [الذراع];
    ليكن العبارة: عبارة = عبارة.طابق(النطاق, القيمة, الأذرع);
    ليكن الصندوق: صندوق عبارة = صندوق العبارة;
    أرجع الصندوق;
}

// Adds what a statement of a block read (حلل_عبارة) to العبارات. A tuple
// `let` takes the rest of the block, up to its closing brace (not read), as
// its arm's body. False when that rest does not parse.
عرف ألحق_ناتج_عبارة_كتلة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الناتج: ناتج_عبارة,
    العبارات: &متغير متجه صندوق عبارة
): منطقي {
    طابق الناتج مع
    | ناتج_عبارة.واحدة(أ) -> { ألحق(*العبارات, أ); }
    | ناتج_عبارة.اثنتان(أ, ب) -> {
        ألحق(*العبارات, أ);
        ألحق(*العبارات, ب);
    }
    | ناتج_عبارة.ربط_صف(النطاق, النمط, النوع, القيمة) -> {
        ليكن بداية_البقية: نطاق = نطاق_الحالي(الرموز, المؤشر);
        ليكن البقية: متغير متجه صندوق عبارة = [];
        طالما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
            إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نهاية_الملف()) {
                ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معقوف_يمين());
                أرجع خطأ;
            };
            طابق حلل_عبارة(المصدر, الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(ن) -> {
                إذا (!ألحق_ناتج_عبارة_كتلة(المصدر, الرموز, المؤشر, ن, &متغير البقية)) { أرجع خطأ; };
            };
        }
        // The body ends where the block does, at its closing brace.
        ليكن الجسم: كتلة_عبارات = {
            النطاق: دمج_نطاق(بداية_البقية, نطاق_الحالي(الرموز, المؤشر)),
            العبارات: البقية
        };
        // The statement spans what its names are in scope for, as a match
        // spans its arms.
        ليكن نطاق_العبارة: نطاق = دمج_نطاق(النطاق, الجسم.النطاق);
        ألحق(*العبارات, مطابقة_ربط_صف(نطاق_العبارة, النمط, النوع, القيمة, الجسم));
    };
    أرجع صواب;
}

عرف أكمل_ربطا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الاسم: اسم,
    النوع: نوع_تركيبي
): اختياري ناتج_عبارة {
    إذا (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        ليكن النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        أرجع اختياري.موجود(نتيجة_واحدة(عبارة.تصريح_متغير(النطاق, الاسم, النوع)));
    };
    إذا (!توقع(الرموز, المؤشر, رمز.فاصل_تعريف())) {
        أرجع اختياري.لا_شيء();
    };
    إذا (بداية_كتلة_وقت_الترجمة(الرموز, المؤشر)) {
        طابق حلل_كتلة_قيمة_وقت_الترجمة(المصدر, الرموز, المؤشر) مع
        | نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة -> { أرجع اختياري.لا_شيء(); }
        | نتيجة_كتلة_قيمة_وقت_الترجمة.كتلة(جسم_الكتلة, ناتج_الكتلة) -> {
            إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                أرجع اختياري.لا_شيء();
            };
            ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            ليكن النطاق: نطاق = دمج_نطاق(البداية, النهاية);
            ليكن الوجهة: تعبير = تعبير.اسم(النطاق, الاسم);
            ليكن التصريح: عبارة = عبارة.تصريح_متغير(النطاق, الاسم, النوع);
            ليكن البدء: عبارة = عبارة.إسناد_وقت_الترجمة(
                النطاق, الوجهة, جسم_الكتلة, ناتج_الكتلة
            );
            أرجع اختياري.موجود(نتيجة_اثنتين(التصريح, البدء));
        }
        | نتيجة_كتلة_قيمة_وقت_الترجمة.تعبيرية -> { };
    };
    ليكن التهيئة_نتيجة: اختياري صيغة_تهيئة = حلل_تهيئة(المصدر, الرموز, المؤشر);
    طابق التهيئة_نتيجة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(التهيئة_المقروءة) -> {
        ليكن التهيئة: صيغة_تهيئة = علّم_تهيئة_بانتشار(الرموز, المؤشر, التهيئة_المقروءة);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        ليكن النطاق: نطاق = دمج_نطاق(البداية, النهاية);
        ليكن الوجهة: تعبير = تعبير.اسم(النطاق, الاسم);
        ليكن التصريح: عبارة = عبارة.تصريح_متغير(النطاق, الاسم, النوع);
        ليكن البدء: عبارة = حوّل_تهيئة(النطاق, الوجهة, التهيئة);
        أرجع اختياري.موجود(نتيجة_اثنتين(التصريح, البدء));
    };
}

عرف حلل_إرجاعا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
        ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        ليكن العبارة: عبارة = عبارة.أرجع(دمج_نطاق(البداية, النهاية), اختياري.لا_شيء());
        أرجع اختياري.موجود(نتيجة_واحدة(العبارة));
    };
    ليكن النتيجة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق النتيجة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(المقروءة) -> {
        ليكن القيمة: تعبير = علّم_انتشارا_إن_وجد(الرموز, المؤشر, المقروءة);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        ليكن العبارة: عبارة = عبارة.أرجع(دمج_نطاق(البداية, النهاية), اختياري.موجود(القيمة));
        أرجع اختياري.موجود(نتيجة_واحدة(العبارة));
    };
}

عام عرف حلل_كتلة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري كتلة_عبارات {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن العبارات: متغير متجه صندوق عبارة = [];
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نهاية_الملف()) {
            ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
            ارفض(الرموز, المؤشر, الفئة, رمز.معقوف_يمين());
            أرجع اختياري.لا_شيء();
        };
        ليكن النتيجة: اختياري ناتج_عبارة = حلل_عبارة(المصدر, الرموز, المؤشر);
        طابق النتيجة مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ن) -> {
            إذا (!ألحق_ناتج_عبارة_كتلة(المصدر, الرموز, المؤشر, ن, &متغير العبارات)) {
                أرجع اختياري.لا_شيء();
            };
        };
    }
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    ليكن نطاق_الكتلة: نطاق = دمج_نطاق(البداية, النهاية);
    ليكن الكتلة: كتلة_عبارات = {
        النطاق: نطاق_الكتلة,
        العبارات: العبارات
    };
    أرجع اختياري.موجود(الكتلة);
}

عرف حلل_بينما(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الشرط: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق الشرط مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ق) -> {
        أرجع أكمل_بينما(المصدر, الرموز, المؤشر, البداية, ق);
    };
}

عرف أكمل_بينما(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير
): اختياري ناتج_عبارة {
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الجسم: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الجسم مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ك) -> {
        // A while statement may carry the same optional `;` terminator as
        // other block statements (`طالما (ش) { ... };`).
        إذا (اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { };
        ليكن ت: عبارة = عبارة.طالما(
            دمج_نطاق(البداية, ك.النطاق),
            الشرط,
            ك
        );
        أرجع اختياري.موجود(نتيجة_واحدة(ت));
    };
}

عرف عبارات_ناتج_إلى_متجه(الناتج: ناتج_عبارة): متجه صندوق عبارة {
    ليكن العبارات: متغير متجه صندوق عبارة = [];
    طابق الناتج مع
    | ناتج_عبارة.واحدة(أ) -> { ألحق(العبارات, أ); }
    | ناتج_عبارة.اثنتان(أ, ب) -> { ألحق(العبارات, أ); ألحق(العبارات, ب); }
    // حلل_لكل rejects a tuple `let` before it is read.
    | ناتج_عبارة.ربط_صف(_, _, _, _) -> { };
    أرجع العبارات;
}

عرف حلل_خطوة_لكل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري صندوق عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    ليكن له_فك: منطقي = اقبل(الرموز, المؤشر, رمز.نجمة());
    ليكن الموضع: اختياري تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
    ليكن اليسار: متغير تعبير = تعبير.حرفي(البداية, حرفي.غير_معرف());
    طابق الموضع مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(قيمة) -> {
        إذا (له_فك) {
            ليكن النهاية: نطاق = نطاق_تعبير(&قيمة);
            ليكن الأصل: صندوق تعبير = صندوق قيمة;
            اليسار := تعبير.فك_موضع(دمج_نطاق(البداية, النهاية), الأصل);
        } وإلا {
            اليسار := قيمة;
        };
    };
    إذا (!توقع(الرموز, المؤشر, رمز.إسناد())) { أرجع اختياري.لا_شيء(); };
    ليكن اليمين: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق اليمين مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ر) -> {
        ليكن النطاق: نطاق = دمج_نطاق(البداية, نطاق_تعبير(&ر));
        ليكن ت: عبارة = عبارة.نسخ(النطاق, اليسار, ر);
        ليكن الصندوق: صندوق عبارة = صندوق ت;
        أرجع اختياري.موجود(الصندوق);
    };
}

عرف حلل_لكل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) { أرجع اختياري.لا_شيء(); };
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.ليكن()) {
        ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
        ارفض(الرموز, المؤشر, الفئة, رمز.ليكن());
        أرجع اختياري.لا_شيء();
    };
    // A loop's `let` names one variable: a tuple `let` is a block's statement.
    إذا (نوع_عند(الرموز, فهرس_الحالي(المؤشر) + 1) == رمز.قوس_يسار()) {
        تقدم(الرموز, المؤشر);
        ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
    ليكن البداية_نتيجة: اختياري ناتج_عبارة = حلل_ربطا(المصدر, الرموز, المؤشر);
    ليكن البداية_عبارات: متغير متجه صندوق عبارة = [];
    طابق البداية_نتيجة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ن) -> { البداية_عبارات := عبارات_ناتج_إلى_متجه(ن); };
    ليكن الشرط_نتيجة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    ليكن الشرط: متغير تعبير = تعبير.حرفي(البداية, حرفي.منطقي(صواب));
    طابق الشرط_نتيجة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ق) -> { الشرط := ق; };
    إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { أرجع اختياري.لا_شيء(); };
    ليكن الخطوة_نتيجة: اختياري صندوق عبارة = حلل_خطوة_لكل(المصدر, الرموز, المؤشر);
    طابق الخطوة_نتيجة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الخطوة) -> {
        إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع اختياري.لا_شيء(); };
        ليكن الجسم_نتيجة: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
        طابق الجسم_نتيجة مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الجسم) -> {
            ليكن ت: عبارة = عبارة.لكل(دمج_نطاق(البداية, الجسم.النطاق), البداية_عبارات, الشرط, الخطوة, الجسم);
            أرجع اختياري.موجود(نتيجة_واحدة(ت));
        };
    };
}

عرف حلل_تحكم_حلقة(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    متابعة: منطقي
): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) { أرجع اختياري.لا_شيء(); };
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    ليكن النطاق: نطاق = دمج_نطاق(البداية, النهاية);
    إذا (متابعة) { أرجع اختياري.موجود(نتيجة_واحدة(عبارة.تابع_حلقة(النطاق))); };
    أرجع اختياري.موجود(نتيجة_واحدة(عبارة.اخرج_من_حلقة(النطاق)));
}

عرف ابن_إذا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الشرط: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق الشرط مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ق) -> {
        أرجع أكمل_إذا(المصدر, الرموز, المؤشر, البداية, ق);
    };
}

عرف أكمل_إذا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير
): اختياري عبارة {
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الفرع: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الفرع مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأول) -> {
        أرجع أكمل_بديل_إذا(المصدر, الرموز, المؤشر, البداية, الشرط, الأول);
    };
}

عرف ابن_إذا_بلا_بديل(
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختياري عبارة {
    ليكن النهاية: نطاق = دمج_نطاق(البداية, الأول.النطاق);
    أرجع اختياري.موجود(عبارة.إذا(النهاية, الشرط, الأول, اختياري.لا_شيء()));
}

عرف ابن_إذا_متداخل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختياري عبارة {
    ليكن بداية_المتداخل: نطاق = نطاق_الحالي(الرموز, المؤشر);
    ليكن المتداخل: اختياري عبارة = ابن_إذا(المصدر, الرموز, المؤشر);
    طابق المتداخل مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ت) -> {
        ليكن آخر_المتداخل: نطاق = نطاق_السابق(الرموز, المؤشر);
        ليكن نطاق_ت: نطاق = دمج_نطاق(بداية_المتداخل, آخر_المتداخل);
        ليكن صندوق_ت: صندوق عبارة = صندوق ت;
        ليكن قائمة: متجه صندوق عبارة = [صندوق_ت];
        ليكن الثاني: كتلة_عبارات = {
            النطاق: نطاق_ت,
            العبارات: قائمة
        };
        ليكن الكل: نطاق = دمج_نطاق(البداية, نطاق_ت);
        أرجع اختياري.موجود(عبارة.إذا(الكل, الشرط, الأول, اختياري.موجود(الثاني)));
    };
}

عرف ابن_إذا_كتلة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختياري عبارة {
    ليكن الثاني: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الثاني مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ك) -> {
        ليكن الكل: نطاق = دمج_نطاق(البداية, ك.النطاق);
        أرجع اختياري.موجود(عبارة.إذا(الكل, الشرط, الأول, اختياري.موجود(ك)));
    };
}

عرف أكمل_بديل_إذا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الشرط: تعبير,
    الأول: كتلة_عبارات
): اختياري عبارة {
    إذا (!اقبل(الرموز, المؤشر, رمز.وإلا())) {
        أرجع ابن_إذا_بلا_بديل(البداية, الشرط, الأول);
    };
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.إذا()) {
        أرجع ابن_إذا_متداخل(المصدر, الرموز, المؤشر, البداية, الشرط, الأول);
    };
    أرجع ابن_إذا_كتلة(المصدر, الرموز, المؤشر, البداية, الشرط, الأول);
}

عرف حلل_مطابقة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    ليكن القيمة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق القيمة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ت) -> {
        أرجع أكمل_مطابقة(المصدر, الرموز, المؤشر, البداية, ت);
    };
}

عرف أكمل_مطابقة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    القيمة: تعبير
): اختياري ناتج_عبارة {
    إذا (!توقع(الرموز, المؤشر, رمز.مع())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الأذرع: متغير متجه ذراع_مطابقة = [];
    طالما (اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
        ليكن النمط: اختياري نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
        طابق النمط مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ن) -> {
            // A guard: `| pattern if condition -> { … }`.
            ليكن الحارس: متغير اختياري تعبير = اختياري.لا_شيء();
            إذا (اقبل(الرموز, المؤشر, رمز.إذا())) {
                طابق حلل_تعبيرا(المصدر, الرموز, المؤشر) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(الشرط) -> { الحارس := اختياري.موجود(الشرط); };
            };
            إذا (!توقع(الرموز, المؤشر, رمز.سهم_يمين())) {
                أرجع اختياري.لا_شيء();
            };
            ليكن الجسم: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
            طابق الجسم مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(ك) -> {
                ليكن الذراع: ذراع_مطابقة = {
                    النمط: ن,
                    الحارس: الحارس,
                    الجسم: ك,
                    نوع_ليكن: اختياري.لا_شيء()
                };
                ألحق(الأذرع, الذراع);
            };
        };
    }
    إذا (الطول(الأذرع) == 0) {
        ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
        ارفض(الرموز, المؤشر, الفئة, رمز.أو_بتي());
        أرجع اختياري.لا_شيء();
    };
    اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    ليكن ت: عبارة = عبارة.طابق(دمج_نطاق(البداية, النهاية), القيمة, الأذرع);
    أرجع اختياري.موجود(نتيجة_واحدة(ت));
}

عرف حلل_تجميعا(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_نص()) {
        ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عنصر();
        ارفض(الرموز, المؤشر, الفئة, رمز.حرفي_نص());
        أرجع اختياري.لا_شيء();
    };
    ليكن المحاولة: اختياري متجه ط8 = نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر));
    طابق المحاولة مع
    | اختياري.لا_شيء -> {
        ارفض_داخليا(الرموز, المؤشر);
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النص) -> {
        تقدم(الرموز, المؤشر);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        ليكن ت: عبارة = عبارة.تجميع(دمج_نطاق(البداية, النهاية), النص);
        أرجع اختياري.موجود(نتيجة_واحدة(ت));
    };
}

عرف حلل_غير_آمن(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    ليكن الجسم: اختياري كتلة_عبارات = حلل_كتلة(المصدر, الرموز, المؤشر);
    طابق الجسم مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(ك) -> {
        اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
        ليكن ت: عبارة = عبارة.غير_آمن(دمج_نطاق(البداية, ك.النطاق), ك);
        أرجع اختياري.موجود(نتيجة_واحدة(ت));
    };
}

// Statement comptime blocks accept the full ordinary statement grammar.
// Their execution is handled later by verified MSIR, not by this parser.
عرف حلل_كتلة_وقت_الترجمة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    طابق حلل_كتلة(المصدر, الرموز, المؤشر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الجسم) -> {
        اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
        ليكن العبارة: عبارة = عبارة.وقت_الترجمة(دمج_نطاق(البداية, الجسم.النطاق), الجسم);
        أرجع اختياري.موجود(نتيجة_واحدة(العبارة));
    };
}

عرف حلل_إسنادا_أو_استدعاء(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    ليكن له_فك: منطقي = اقبل(الرموز, المؤشر, رمز.نجمة());
    ليكن الموضع: اختياري تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
    طابق الموضع مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(قيمة) -> {
        إذا (له_فك) {
            ليكن النهاية: نطاق = نطاق_تعبير(&قيمة);
            ليكن الأصل: صندوق تعبير = صندوق قيمة;
            ليكن اليسار: تعبير = تعبير.فك_موضع(دمج_نطاق(البداية, النهاية), الأصل);
            أرجع أكمل_إسنادا_أو_استدعاء(المصدر, الرموز, المؤشر, البداية, اليسار, صواب);
        };
        ليكن المستدعى_الممكن: تعبير = جرب_حجج_نوع_صريحة(المصدر, الرموز, المؤشر, قيمة);
        أرجع أكمل_إسنادا_أو_استدعاء(المصدر, الرموز, المؤشر, البداية, المستدعى_الممكن, خطأ);
    };
}

عرف أكمل_إسنادا_أو_استدعاء(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    اليسار: تعبير,
    له_فك: منطقي
): اختياري ناتج_عبارة {
    إذا ((!له_فك) && (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار())) {
        ليكن الاستدعاء: اختياري تعبير = ابن_استدعاء_بعد_موضع(المصدر, الرموز, المؤشر, البداية, اليسار);
        طابق الاستدعاء مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(المستدعى) -> {
            // `f().g();`, `f(x).h.k(y);`: projections and calls on the call
            // result, as in an expression. The statement must still end in a
            // call (or `؟`): `f().x;` does nothing and is rejected below.
            ليكن المقروء: تعبير;
            طابق حلل_لواحق_ناتج_استدعاء(المصدر, الرموز, المؤشر, البداية, المستدعى) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(ت) -> { المقروء := ت; };
            إذا (نوع_الحالي(الرموز, المؤشر) != رمز.استفهام()) {
                طابق المقروء مع
                | تعبير.استدعاء(_, _, _) -> { }
                | _ -> {
                    ليكن رفض_بلا_عملية: منطقي = ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.عبارة_بلا_عملية(), رمز.قوس_يسار());
                    أرجع اختياري.لا_شيء();
                };
            };
            ليكن قيمة: تعبير = علّم_انتشارا_إن_وجد(الرموز, المؤشر, المقروء);
            إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                أرجع اختياري.لا_شيء();
            };
            ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            ليكن ت: عبارة = عبارة.استدعاء(دمج_نطاق(البداية, النهاية), قيمة);
            أرجع اختياري.موجود(نتيجة_واحدة(ت));
        };
    };
    // `place؟;` propagates the error or absence held in a place.
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.استفهام()) {
        ليكن الموسومة: تعبير = علّم_انتشارا_إن_وجد(الرموز, المؤشر, اليسار);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        ليكن نهاية_الموسومة: نطاق = نطاق_السابق(الرموز, المؤشر);
        ليكن عبارة_الموسومة: عبارة = عبارة.استدعاء(دمج_نطاق(البداية, نهاية_الموسومة), الموسومة);
        أرجع اختياري.موجود(نتيجة_واحدة(عبارة_الموسومة));
    };
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.فاصلة_منقوطة()) {
        ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.عبارة_بلا_عملية();
        ليكن رفض: منطقي = ارفض(الرموز, المؤشر, الفئة, رمز.إسناد());
        أرجع اختياري.لا_شيء();
    };
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.إسناد()) {
        طابق اقترح_تهجئة_كلمة_عبارة(المصدر, البداية) مع
        | اختياري.موجود(الاقتراح) -> {
            ليكن رفض: منطقي = ارفض_تهجئة_كلمة_محجوزة(
                المؤشر, البداية, الاقتراح.الرمز, الاقتراح.التهجئة
            );
            أرجع اختياري.لا_شيء();
        }
        | اختياري.لا_شيء -> { };
    };
    إذا (!توقع(الرموز, المؤشر, رمز.إسناد())) {
        أرجع اختياري.لا_شيء();
    };
    إذا (بداية_كتلة_وقت_الترجمة(الرموز, المؤشر)) {
        طابق حلل_كتلة_قيمة_وقت_الترجمة(المصدر, الرموز, المؤشر) مع
        | نتيجة_كتلة_قيمة_وقت_الترجمة.مرفوضة -> { أرجع اختياري.لا_شيء(); }
        | نتيجة_كتلة_قيمة_وقت_الترجمة.كتلة(جسم_الكتلة, ناتج_الكتلة) -> {
            إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                أرجع اختياري.لا_شيء();
            };
            ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            ليكن ت: عبارة = عبارة.إسناد_وقت_الترجمة(
                دمج_نطاق(البداية, النهاية), اليسار, جسم_الكتلة, ناتج_الكتلة
            );
            أرجع اختياري.موجود(نتيجة_واحدة(ت));
        }
        | نتيجة_كتلة_قيمة_وقت_الترجمة.تعبيرية -> { };
    };
    ليكن اليمين: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    طابق اليمين مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(المقروء) -> {
        ليكن ر: تعبير = علّم_انتشارا_إن_وجد(الرموز, المؤشر, المقروء);
        إذا (!توقع(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
            أرجع اختياري.لا_شيء();
        };
        ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
        ليكن ت: عبارة = عبارة.نسخ(دمج_نطاق(البداية, النهاية), اليسار, ر);
        أرجع اختياري.موجود(نتيجة_واحدة(ت));
    };
}

عرف حلل_عبارة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري ناتج_عبارة {
    ليكن النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    إذا (النوع == رمز.ليكن()) {
        أرجع حلل_ربطا(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.أرجع()) {
        أرجع حلل_إرجاعا(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.طالما()) {
        أرجع حلل_بينما(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.لكل()) {
        أرجع حلل_لكل(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.اخرج_من_حلقة()) {
        أرجع حلل_تحكم_حلقة(الرموز, المؤشر, خطأ);
    };
    إذا (النوع == رمز.تابع_حلقة()) {
        أرجع حلل_تحكم_حلقة(الرموز, المؤشر, صواب);
    };
    إذا (النوع == رمز.إذا()) {
        ليكن النتيجة: اختياري عبارة = ابن_إذا(المصدر, الرموز, المؤشر);
        طابق النتيجة مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(ت) -> {
            اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة());
            أرجع اختياري.موجود(نتيجة_واحدة(ت));
        };
    };
    إذا (النوع == رمز.طابق()) {
        أرجع حلل_مطابقة(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.تجميع()) {
        أرجع حلل_تجميعا(الرموز, المؤشر);
    };
    إذا (النوع == رمز.غير_آمن()) {
        أرجع حلل_غير_آمن(المصدر, الرموز, المؤشر);
    };
    إذا (النوع == رمز.وقت_الترجمة()) {
        أرجع حلل_كتلة_وقت_الترجمة(المصدر, الرموز, المؤشر);
    };
    إذا ((النوع == رمز.معرف()) || (النوع == رمز.نجمة()) || (النوع == رمز.قوس_يسار())) {
        أرجع حلل_إسنادا_أو_استدعاء(المصدر, الرموز, المؤشر);
    };
    ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
    ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
    أرجع اختياري.لا_شيء();
}

// A match expression (docs/en/book/ch06-02-match.md, "A match that gives a
// value"): `match e with | p -> v | q -> { s; w } | r -> { s; }`, wherever an
// expression is expected. parser/expressions.sn calls it through the parser
// it registers (سجل_محلل_مطابقة_تعبيرية, from parser.sn): its arms hold
// statements, which that module cannot parse. A statement that starts with
// `match` stays the match statement.
عام عرف حلل_مطابقة_تعبيرية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.إذا()) {
        أرجع حلل_إذا_تعبيرية(المصدر, الرموز, المؤشر);
    };
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    ليكن المميز_المقروء: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
    ليكن المميز: تعبير;
    طابق المميز_المقروء مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ت) -> { المميز := ت; };
    إذا (!توقع(الرموز, المؤشر, رمز.مع())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الأذرع: متغير متجه ذراع_مطابقة = [];
    ليكن القيم: متغير متجه اختياري تعبير = [];
    طالما (اقبل(الرموز, المؤشر, رمز.أو_بتي())) {
        ليكن النمط_المقروء: اختياري نمط = حلل_نمطا(المصدر, الرموز, المؤشر);
        ليكن النمط: نمط;
        طابق النمط_المقروء مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ن) -> { النمط := ن; };
        // A guard: `| pattern if condition -> value`.
        ليكن الحارس: متغير اختياري تعبير = اختياري.لا_شيء();
        إذا (اقبل(الرموز, المؤشر, رمز.إذا())) {
            طابق حلل_تعبيرا(المصدر, الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الشرط) -> { الحارس := اختياري.موجود(الشرط); };
        };
        إذا (!توقع(الرموز, المؤشر, رمز.سهم_يمين())) {
            أرجع اختياري.لا_شيء();
        };
        // `-> { ... }` is a braced arm unless the braces open a record
        // literal (`-> { x: 1 }`).
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يسار() && !بداية_حرفي_سجل(الرموز, المؤشر)) {
            ليكن قيمة_الذراع: متغير اختياري تعبير = اختياري.لا_شيء();
            طابق حلل_جسم_ذراع_مطابقة_تعبيرية(المصدر, الرموز, المؤشر, &متغير قيمة_الذراع) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(جسم_الذراع) -> {
                ليكن الذراع: ذراع_مطابقة = { النمط: النمط, الحارس: الحارس, الجسم: جسم_الذراع, نوع_ليكن: اختياري.لا_شيء() };
                ألحق(الأذرع, الذراع);
                ألحق(القيم, قيمة_الذراع);
            };
        } وإلا {
            طابق حلل_قيمة_ذراع_مطابقة_تعبيرية(المصدر, الرموز, المؤشر, 1) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> {
                ليكن لا_عبارات: متجه صندوق عبارة = [];
                ليكن الجسم: كتلة_عبارات = { النطاق: نطاق_تعبير(&القيمة), العبارات: لا_عبارات };
                ليكن الذراع: ذراع_مطابقة = { النمط: النمط, الحارس: الحارس, الجسم: الجسم, نوع_ليكن: اختياري.لا_شيء() };
                ألحق(الأذرع, الذراع);
                ألحق(القيم, اختياري.موجود(القيمة));
            };
        };
    }
    إذا (الطول(الأذرع) == 0) {
        ليكن الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.نمط();
        ارفض(الرموز, المؤشر, الفئة, رمز.أو_بتي());
        أرجع اختياري.لا_شيء();
    };
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    ليكن المطابقة: مطابقة_تعبيرية = { المميز: المميز, الأذرع: الأذرع, القيم: القيم, من_إذا: خطأ };
    ليكن الصندوق: صندوق مطابقة_تعبيرية = صندوق المطابقة;
    أرجع اختياري.موجود(تعبير.مطابقة(دمج_نطاق(البداية, النهاية), الصندوق));
}

// `if (c) a else b` as a value (in Arabic `إذا (ش) أ وإلا ب`): the match
// expression `match c with | true -> a | _ -> b`, so the typing, the joined
// value, the branches that return, leave a loop or continue it instead of
// giving a value, and the ownership of the values are the match
// expression's. A branch is a braced block whose last expression without `;`
// is its value, or a bare expression read as a match arm's (operators that
// bind tighter than `|`, and `&&` and `||`), so `if (c) a else b + 1` adds 1
// in the else branch only; `else if` is an if expression of its own. An `if`
// used as a value has an `else`: without one there is no value when the
// condition is false (SULTANC-PARSE-IF-WITHOUT-ELSE). A statement that
// starts with `if` stays the if statement.
عرف حلل_إذا_تعبيرية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) { أرجع اختياري.لا_شيء(); };
    ليكن الشرط: تعبير;
    طابق حلل_تعبيرا(المصدر, الرموز, المؤشر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ت) -> { الشرط := ت; };
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع اختياري.لا_شيء(); };
    ليكن الأذرع: متغير متجه ذراع_مطابقة = [];
    ليكن القيم: متغير متجه اختياري تعبير = [];
    إذا (!حلل_فرع_إذا_تعبيرية(المصدر, الرموز, المؤشر, نمط.حرفي(البداية, حرفي.منطقي(صواب)), &متغير الأذرع, &متغير القيم)) {
        أرجع اختياري.لا_شيء();
    };
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.وإلا()) {
        ارفض_نطاقا(المؤشر, دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر)), فئة_خطأ_نحوي.إذا_تعبيرية_بلا_وإلا());
        أرجع اختياري.لا_شيء();
    };
    ليكن نطاق_وإلا: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!حلل_فرع_إذا_تعبيرية(المصدر, الرموز, المؤشر, نمط.بدل(نطاق_وإلا), &متغير الأذرع, &متغير القيم)) {
        أرجع اختياري.لا_شيء();
    };
    ليكن النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    ليكن المطابقة: مطابقة_تعبيرية = { المميز: الشرط, الأذرع: الأذرع, القيم: القيم, من_إذا: صواب };
    ليكن الصندوق: صندوق مطابقة_تعبيرية = صندوق المطابقة;
    أرجع اختياري.موجود(تعبير.مطابقة(دمج_نطاق(البداية, النهاية), الصندوق));
}

// One branch of an if expression, as the match arm النمط: a braced block, or
// a bare expression (also `else if …`).
عرف حلل_فرع_إذا_تعبيرية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    النمط: نمط,
    الأذرع: &متغير متجه ذراع_مطابقة,
    القيم: &متغير متجه اختياري تعبير
): منطقي {
    ليكن بلا_حارس: اختياري تعبير = اختياري.لا_شيء();
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يسار() && !بداية_حرفي_سجل(الرموز, المؤشر)) {
        ليكن قيمة_الفرع: متغير اختياري تعبير = اختياري.لا_شيء();
        طابق حلل_جسم_ذراع_مطابقة_تعبيرية(المصدر, الرموز, المؤشر, &متغير قيمة_الفرع) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الجسم) -> {
            ليكن الذراع: ذراع_مطابقة = { النمط: النمط, الحارس: بلا_حارس, الجسم: الجسم, نوع_ليكن: اختياري.لا_شيء() };
            ألحق(*الأذرع, الذراع);
            ألحق(*القيم, قيمة_الفرع);
            أرجع صواب;
        };
    };
    طابق حلل_قيمة_ذراع_مطابقة_تعبيرية(المصدر, الرموز, المؤشر, 1) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> {
        ليكن لا_عبارات: متجه صندوق عبارة = [];
        ليكن الجسم: كتلة_عبارات = { النطاق: نطاق_تعبير(&القيمة), العبارات: لا_عبارات };
        ليكن الذراع: ذراع_مطابقة = { النمط: النمط, الحارس: بلا_حارس, الجسم: الجسم, نوع_ليكن: اختياري.لا_شيء() };
        ألحق(*الأذرع, الذراع);
        ألحق(*القيم, اختياري.موجود(القيمة));
        أرجع صواب;
    };
}

// The value of an arm written without braces: an expression whose operators
// bind tighter than `|`, which begins the next arm, joined by `&&` and `||`
// (الأدنى: 1 admits both, 2 only `&&`, 3 neither). An arm value that needs
// `|`, a closure or a further match before another arm is parenthesized.
عرف حلل_قيمة_ذراع_مطابقة_تعبيرية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الأدنى: عدد
): اختياري تعبير {
    ليكن الأول: اختياري تعبير = حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 4);
    ليكن اليسار: متغير تعبير = تعبير.حرفي(نطاق_الحالي(الرموز, المؤشر), حرفي.منطقي(خطأ));
    طابق الأول مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ت) -> { اليسار := ت; };
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        ليكن النوع: رمز = نوع_الحالي(الرموز, المؤشر);
        ليكن الأسبقية: متغير عدد = 0;
        ليكن العامل: متغير عامل_ثنائي = عامل_ثنائي.أو();
        إذا (النوع == رمز.أو()) {
            الأسبقية := 1;
            العامل := عامل_ثنائي.أو();
        };
        إذا (النوع == رمز.و()) {
            الأسبقية := 2;
            العامل := عامل_ثنائي.و();
        };
        إذا (الأسبقية == 0 || الأسبقية < الأدنى) {
            مستمر := خطأ;
        } وإلا {
            تقدم(الرموز, المؤشر);
            طابق حلل_قيمة_ذراع_مطابقة_تعبيرية(المصدر, الرموز, المؤشر, الأسبقية + 1) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(اليمين) -> {
                ليكن نطاق_الثنائي: نطاق = دمج_نطاق(نطاق_تعبير(&اليسار), نطاق_تعبير(&اليمين));
                ليكن أ: صندوق تعبير = صندوق اليسار;
                ليكن ب: صندوق تعبير = صندوق اليمين;
                اليسار := تعبير.ثنائي(نطاق_الثنائي, العامل, أ, ب);
            };
        };
    }
    أرجع اختياري.موجود(اليسار);
}

// A braced arm: statements, then optionally the arm's value, an expression
// with no `;` before the closing brace. Each item is read as a statement
// first; one that is not a statement is read as the final expression.
عرف حلل_جسم_ذراع_مطابقة_تعبيرية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    القيمة_النهائية: &متغير اختياري تعبير
): اختياري كتلة_عبارات {
    ليكن البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    ليكن أول_رمز: طبيعي = فهرس_الحالي(المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن العبارات: متغير متجه صندوق عبارة = [];
    طالما (صواب) {
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.معقوف_يمين()) {
            تقدم(الرموز, المؤشر);
            إذا (ارفض_انتشارا_في_ذراع(الرموز, المؤشر, أول_رمز)) { أرجع اختياري.لا_شيء(); };
            ليكن الكتلة: كتلة_عبارات = {
                النطاق: دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر)),
                العبارات: العبارات
            };
            أرجع اختياري.موجود(الكتلة);
        };
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نهاية_الملف()) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معقوف_يمين());
            أرجع اختياري.لا_شيء();
        };
        ليكن قبل_العبارة: مؤشر = *المؤشر;
        طابق حلل_عبارة(المصدر, الرموز, المؤشر) مع
        | اختياري.موجود(ن) -> {
            طابق ن مع
            | ناتج_عبارة.واحدة(أ) -> { ألحق(العبارات, أ); }
            | ناتج_عبارة.اثنتان(أ, ب) -> {
                ألحق(العبارات, أ);
                ألحق(العبارات, ب);
            }
            // The names of a tuple `let` would not reach the arm's value.
            | ناتج_عبارة.ربط_صف(نطاق_الربط, _, _, _) -> {
                ليكن رفض: منطقي = ارفض_نطاقا(المؤشر, نطاق_الربط, فئة_خطأ_نحوي.ربط_صف_غير_صالح());
                أرجع اختياري.لا_شيء();
            };
        }
        | اختياري.لا_شيء -> {
            // Not a statement: the arm's value. When it is no expression
            // either, the diagnostic is the one that read further.
            ليكن بعد_العبارة: مؤشر = *المؤشر;
            *المؤشر := قبل_العبارة;
            ليكن القيمة_المقروءة: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
            ليكن القيمة: تعبير;
            طابق القيمة_المقروءة مع
            | اختياري.لا_شيء -> {
                إذا (بعد_العبارة.الموضع >= (*المؤشر).الموضع) { *المؤشر := بعد_العبارة; };
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(ت) -> { القيمة := ت; };
            إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
                أرجع اختياري.لا_شيء();
            };
            إذا (ارفض_انتشارا_في_ذراع(الرموز, المؤشر, أول_رمز)) { أرجع اختياري.لا_شيء(); };
            ليكن الكتلة_القيمية: كتلة_عبارات = {
                النطاق: دمج_نطاق(البداية, نطاق_السابق(الرموز, المؤشر)),
                العبارات: العبارات
            };
            *القيمة_النهائية := اختياري.موجود(القيمة);
            أرجع اختياري.موجود(الكتلة_القيمية);
        };
    }
    أرجع اختياري.لا_شيء();
}

// `؟` is expanded in a function's own statements (desugar/propagation.sn),
// not in the arms of a match expression: one in a braced arm, from its
// opening brace (البداية) to the cursor, is rejected where it stands.
عرف ارفض_انتشارا_في_ذراع(
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: طبيعي
): منطقي {
    ليكن النهاية: طبيعي = فهرس_الحالي(المؤشر);
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        إذا (نوع_عند(الرموز, ف) == رمز.استفهام()) {
            (*المؤشر).الموضع := ف;
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.تعبير(), رمز.فاصلة_منقوطة());
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}
