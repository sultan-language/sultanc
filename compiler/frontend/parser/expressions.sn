// تبنى التعبيرات من هويات الرموز نفسها بغض النظر عن سطح source.

عرف انسخ_بايتات_حرفي_من_المصدر(المصدر: &مصدر, النطاق: نطاق): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = النطاق.البداية.البايت;
    طالما (ف < (النطاق.النهاية.البايت مثل طبيعي)) {
        ألحق(الناتج, بايت_المصدر(المصدر, ف));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف تعبير_عدد_سالب_من_قيمة_رمز(النطاق: نطاق, القيمة: قيمة_عدد_صحيح_رمز): تعبير {
    طابق حرفي_عدد_سالب_من_قيمة_رمز(القيمة) مع
    | اختياري.موجود(الحرفي) -> {
        أرجع تعبير.حرفي(النطاق, الحرفي);
    }
    | اختياري.لا_شيء -> {
        طابق القيمة مع
        | قيمة_عدد_صحيح_رمز.طبيعي(المقدار) -> {
            دع الداخل: تعبير = تعبير.حرفي(النطاق, حرفي.عدد_طبيعي(المقدار));
            دع الصندوق: صندوق تعبير = صندوق الداخل;
            أرجع تعبير.أحادي(النطاق, عامل_أحادي.سالب(), الصندوق);
        }
        | قيمة_عدد_صحيح_رمز.موقع(_) -> {
            أرجع تعبير.حرفي(النطاق, حرفي.عدد(0));
        };
    };
}

عرف حرفي_حالي(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختياري تعبير {
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    إذا (النوع == رمز.حرفي_عدد_صحيح()) {
        دع المحاولة: اختياري قيمة_عدد_صحيح_رمز = قيمة_عدد_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            دع الحرفي: حرفي = حرفي_عدد_من_قيمة_رمز(القيمة);
            أرجع اختياري.موجود(تعبير.حرفي(النطاق, الحرفي));
        };
    };
    إذا (النوع == رمز.حرفي_عدد_عشري()) {
        دع البايتات: متجه ط8 = انسخ_بايتات_حرفي_من_المصدر(المصدر, النطاق);
        تقدم(الرموز, المؤشر);
        دع الحرفي: حرفي = حرفي.عدد_عشري(البايتات);
        أرجع اختياري.موجود(تعبير.حرفي(النطاق, الحرفي));
    };
    إذا (النوع == رمز.حرفي_حرف()) {
        دع المحاولة: اختياري ط32 = قيمة_محرف_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            دع الحرفي: حرفي = حرفي.حرف(القيمة);
            أرجع اختياري.موجود(تعبير.حرفي(النطاق, الحرفي));
        };
    };
    إذا (النوع == رمز.حرفي_منطقي()) {
        دع المحاولة: اختياري منطقي = قيمة_منطق_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            دع الحرفي: حرفي = حرفي.منطقي(القيمة);
            أرجع اختياري.موجود(تعبير.حرفي(النطاق, الحرفي));
        };
    };
    إذا (النوع == رمز.حرفي_نص()) {
        دع المحاولة: اختياري متجه ط8 = نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            تقدم(الرموز, المؤشر);
            دع الحرفي: حرفي = حرفي.نص(القيمة);
            أرجع اختياري.موجود(تعبير.حرفي(النطاق, الحرفي));
        };
    };
    إذا (النوع == رمز.غير_معرف()) {
        تقدم(الرموز, المؤشر);
        دع الحرفي: حرفي = حرفي.غير_معرف();
        أرجع اختياري.موجود(تعبير.حرفي(النطاق, الحرفي));
    };
    أرجع اختياري.لا_شيء();
}

عرف بداية_موضع(النوع: رمز): منطقي {
    أرجع النوع == رمز.معرف();
}

عام عرف حلل_موضعا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع الحالي: متغير تعبير = تعبير.حرفي(البداية, حرفي.غير_معرف());
    إذا (بداية_موضع(نوع_الحالي(الرموز, المؤشر))) {
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        الحالي := تعبير.اسم(البداية, الاسم);
        تقدم(الرموز, المؤشر);
    } وإلا {
        إذا (!اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
            أرجع اختياري.لا_شيء();
        };
        إذا (!توقع(الرموز, المؤشر, رمز.نجمة())) {
            أرجع اختياري.لا_شيء();
        };
        دع الداخل_نتيجة: اختياري تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
        طابق الداخل_نتيجة مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الداخل) -> {
            إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                أرجع اختياري.لا_شيء();
            };
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع الأصل: صندوق تعبير = صندوق الداخل;
            الحالي := تعبير.فك_موضع(دمج_نطاق(البداية, النهاية), الأصل);
        };
    };
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        إذا (اقبل(الرموز, المؤشر, رمز.نقطة())) {
            إذا (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
                دع الفهرس: اختياري تعبير = حلل_ذرة(المصدر, الرموز, المؤشر);
                طابق الفهرس مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(القيمة) -> {
                    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                        أرجع اختياري.لا_شيء();
                    };
                    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                    دع الأصل: صندوق تعبير = صندوق الحالي;
                    دع الف: صندوق تعبير = صندوق القيمة;
                    الحالي := تعبير.فهرس(دمج_نطاق(البداية, النهاية), الأصل, الف);
                };
            }
            وإلا {
                دع النتيجة: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
                طابق النتيجة مع
                | نتيجة_اسم.غائب -> {
                    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
                    ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
                    أرجع اختياري.لا_شيء();
                }
                | نتيجة_اسم.موجود(الحقل) -> {
                    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                    دع الأصل: صندوق تعبير = صندوق الحالي;
                    الحالي := تعبير.حقل(دمج_نطاق(البداية, النهاية), الأصل, الحقل);
                };
            };
        }
        وإلا {
            إذا (اقبل(الرموز, المؤشر, رمز.قوس_مربع_يسار())) {
                // A bracketed index is a full expression (`س[م + 1]`); the
                // closing bracket delimits it, so no atom restriction applies.
                دع الفهرس: اختياري تعبير = حلل_تعبيرا(المصدر, الرموز, المؤشر);
                طابق الفهرس مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(القيمة) -> {
                    إذا (!توقع(الرموز, المؤشر, رمز.قوس_مربع_يمين())) {
                        أرجع اختياري.لا_شيء();
                    };
                    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                    دع الأصل: صندوق تعبير = صندوق الحالي;
                    دع الف: صندوق تعبير = صندوق القيمة;
                    الحالي := تعبير.فهرس(دمج_نطاق(البداية, النهاية), الأصل, الف);
                };
            }
            وإلا {
                مستمر := خطأ;
            };
        };
    }
    أرجع اختياري.موجود(الحالي);
}


عرف حلل_إغلاق(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.نوع_دالة())) { أرجع اختياري.لا_شيء(); };
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) { أرجع اختياري.لا_شيء(); };
    دع المعاملات: متغير متجه معامل_إغلاق = [];
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
                دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.تعبير();
                ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
                أرجع اختياري.لا_شيء();
            };
            دع بداية_المعامل: نطاق = نطاق_الحالي(الرموز, المؤشر);
            دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
            تقدم(الرموز, المؤشر);
            إذا (!توقع(الرموز, المؤشر, رمز.نقطتان())) { أرجع اختياري.لا_شيء(); };
            دع محاولة_النوع: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
            طابق محاولة_النوع مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(النوع) -> {
                دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                دع نطاق_المعامل: نطاق = دمج_نطاق(بداية_المعامل, النهاية);
                دع المعامل: معامل_إغلاق = {
                    الاسم: الاسم,
                    النوع: النوع,
                    النطاق: نطاق_المعامل
                };
                ألحق(المعاملات, المعامل);
            };
            إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) { مستمر := خطأ; };
        }
    };
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع اختياري.لا_شيء(); };
    إذا (!توقع(الرموز, المؤشر, رمز.نقطتان())) { أرجع اختياري.لا_شيء(); };
    دع محاولة_الناتج: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
    دع الناتج: نوع_تركيبي;
    طابق محاولة_الناتج مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> { الناتج := النوع; };
    إذا (!توقع(الرموز, المؤشر, رمز.سهم_يمين())) { أرجع اختياري.لا_شيء(); };
    دع محاولة_الجسم: اختياري تعبير = حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
    طابق محاولة_الجسم مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الجسم) -> {
        دع النهاية: نطاق = نطاق_تعبير(&الجسم);
        دع صندوق_الجسم: صندوق تعبير = صندوق الجسم;
        دع صندوق_الناتج: صندوق نوع_تركيبي = صندوق الناتج;
        أرجع اختياري.موجود(تعبير.إغلاق(دمج_نطاق(البداية, النهاية), المعاملات, صندوق_الناتج, صندوق_الجسم));
    };
}

عام عرف حلل_ذرة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نوع_دالة()) {
        أرجع حلل_إغلاق(المصدر, الرموز, المؤشر);
    };
    إذا (بداية_موضع(نوع_الحالي(الرموز, المؤشر))) {
        أرجع حلل_موضعا(المصدر, الرموز, المؤشر);
    };
    دع الحرفي: اختياري تعبير = حرفي_حالي(المصدر, الرموز, المؤشر);
    طابق الحرفي مع
    | اختياري.موجود(القيمة) -> {
        أرجع اختياري.موجود(القيمة);
    }
    | اختياري.لا_شيء -> {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.تعبير();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    };
}

عرف بعد_التحويل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    التعبير: تعبير
): اختياري تعبير {
    دع الحالي: متغير تعبير = التعبير;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        إذا (اقبل(الرموز, المؤشر, رمز.تحويل_نوع())) {
            دع النوع: اختياري نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
            طابق النوع مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(الهدف) -> {
                دع بداية_النطاق: نطاق = نطاق_تعبير(&الحالي);
                دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                دع الأصل: صندوق تعبير = صندوق الحالي;
                دع صندوق_الهدف: صندوق نوع_تركيبي = صندوق الهدف;
                الحالي := تعبير.تحويل(دمج_نطاق(بداية_النطاق, النهاية), الأصل, صندوق_الهدف);
            };
        }
        وإلا {
            مستمر := خطأ;
        };
    }
    أرجع اختياري.موجود(الحالي);
}

عام عرف ابن_استدعاء_بعد_موضع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الدالة_تعبير: تعبير
): اختياري تعبير {
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختياري.لا_شيء();
    };
    دع الحجج: متغير متجه تعبير = [];
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            إذا (نوع_الحالي(الرموز, المؤشر) == رمز.فاصلة()) {
                ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معرف());
                أرجع اختياري.لا_شيء();
            };
            دع حجة: اختياري تعبير = حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
            طابق حجة مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(ت) -> {
                ألحق(الحجج, ت);
            };
            إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                مستمر := خطأ;
            };
        }
    };
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختياري.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع الدالة: صندوق تعبير = صندوق الدالة_تعبير;
    أرجع اختياري.موجود(تعبير.استدعاء(دمج_نطاق(البداية, النهاية), الدالة, الحجج));
}

// Projections and calls applied to a call result: `f(x).field`,
// `f(x).(0)`, `f(x)[i]`, `f(x)(y)`, `f(x).callback(y)`. The call result is a
// temporary (docs/en/reference/ownership.md, "Temporaries").
عام عرف حلل_لواحق_ناتج_استدعاء(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    التعبير: تعبير
): اختياري تعبير {
    دع الحالي: متغير تعبير = التعبير;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار()) {
            طابق ابن_استدعاء_بعد_موضع(المصدر, الرموز, المؤشر, البداية, الحالي) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(ت) -> { الحالي := ت; };
        } وإلا إذا (اقبل(الرموز, المؤشر, رمز.نقطة())) {
            إذا (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
                طابق حلل_ذرة(المصدر, الرموز, المؤشر) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(القيمة) -> {
                    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع اختياري.لا_شيء(); };
                    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                    دع الأصل: صندوق تعبير = صندوق الحالي;
                    دع الف: صندوق تعبير = صندوق القيمة;
                    الحالي := تعبير.فهرس(دمج_نطاق(البداية, النهاية), الأصل, الف);
                };
            } وإلا {
                طابق خذ_اسما_سياقيا(الرموز, المؤشر) مع
                | نتيجة_اسم.غائب -> {
                    ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معرف());
                    أرجع اختياري.لا_شيء();
                }
                | نتيجة_اسم.موجود(الحقل) -> {
                    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                    دع الأصل: صندوق تعبير = صندوق الحالي;
                    الحالي := تعبير.حقل(دمج_نطاق(البداية, النهاية), الأصل, الحقل);
                };
            };
        } وإلا إذا (اقبل(الرموز, المؤشر, رمز.قوس_مربع_يسار())) {
            طابق حلل_تعبيرا(المصدر, الرموز, المؤشر) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> {
                إذا (!توقع(الرموز, المؤشر, رمز.قوس_مربع_يمين())) { أرجع اختياري.لا_شيء(); };
                دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                دع الأصل: صندوق تعبير = صندوق الحالي;
                دع الف: صندوق تعبير = صندوق القيمة;
                الحالي := تعبير.فهرس(دمج_نطاق(البداية, النهاية), الأصل, الف);
            };
        } وإلا {
            مستمر := خطأ;
        };
    }
    أرجع اختياري.موجود(الحالي);
}

// `[a, b, c]` in expression position (a trailing comma is accepted, as in
// an initializer). Indexing and calls may follow, as on a call result.
عرف حلل_حرفي_متجه(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع العناصر: متغير متجه تعبير = [];
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_مربع_يمين()) {
        إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نهاية_الملف()) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.قوس_مربع_يمين());
            أرجع اختياري.لا_شيء();
        };
        دع العنصر: اختياري تعبير = حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
        طابق العنصر مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ت) -> { ألحق(العناصر, ت); };
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            إذا (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_مربع_يمين()) {
                ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.قوس_مربع_يمين());
                أرجع اختياري.لا_شيء();
            };
        };
    }
    تقدم(الرموز, المؤشر);
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع الحرفي: تعبير = تعبير.حرفي_متجه(دمج_نطاق(البداية, النهاية), العناصر);
    أرجع حلل_لواحق_ناتج_استدعاء(المصدر, الرموز, المؤشر, البداية, الحرفي);
}

// Compile-time file embedding: `ضمن_ملف(«path»)` / `embed_file("path")` is
// the file's bytes as a text literal, read when the source is parsed. A
// relative path is resolved against the directory of the source file.
عرف معرف_يساوي_نصا(المصدر: &مصدر, النطاق: نطاق, المطلوب: &نص): منطقي {
    دع البداية: طبيعي = النطاق.البداية.البايت;
    دع الطول_المطلوب: طبيعي = الطول(*المطلوب) مثل طبيعي;
    إذا (((النطاق.النهاية.البايت مثل طبيعي) - البداية) != الطول_المطلوب) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_المطلوب) {
        إذا ((*المصدر).المحتوى[البداية + ف] != (*المطلوب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف بداية_تضمين_ملف(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): منطقي {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) { أرجع خطأ; };
    إذا (نوع_التالي(الرموز, المؤشر) != رمز.قوس_يسار()) { أرجع خطأ; };
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع العربي: نص = «ضمن_ملف»;
    دع الإنجليزي: نص = «embed_file»;
    أرجع معرف_يساوي_نصا(المصدر, النطاق, &العربي) || معرف_يساوي_نصا(المصدر, النطاق, &الإنجليزي);
}

عرف مسار_ملف_مضمن(المصدر: &مصدر, المطلوب: &متجه ط8): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع مطلق: منطقي = (الطول(*المطلوب) > 0) && (*المطلوب)[0] == (0x2F مثل ط8);
    إذا (!مطلق) {
        دع اسم_المصدر: نص = (*المصدر).الاسم;
        دع آخر_فاصل: متغير طبيعي = 0;
        دع وجد: متغير منطقي = خطأ;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(اسم_المصدر) مثل طبيعي)) {
            إذا (اسم_المصدر[ف] == (0x2F مثل ط8) || اسم_المصدر[ف] == (0x5C مثل ط8)) {
                آخر_فاصل := ف;
                وجد := صواب;
            };
            ف := ف + 1;
        }
        إذا (وجد) {
            دع ب: متغير طبيعي = 0;
            طالما (ب <= آخر_فاصل) {
                ألحق(الناتج, اسم_المصدر[ب]);
                ب := ب + 1;
            }
        };
    };
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(*المطلوب) مثل طبيعي)) {
        ألحق(الناتج, (*المطلوب)[م]);
        م := م + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عرف حلل_تضمين_ملف(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) { أرجع اختياري.لا_شيء(); };
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.حرفي_نص()) {
        ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.حرفي_نص());
        أرجع اختياري.لا_شيء();
    };
    دع موضع_الحرفي: طبيعي = (*المؤشر).الموضع;
    دع المطلوب: متغير متجه ط8 = [];
    طابق حرفي_حالي(المصدر, الرموز, المؤشر) مع
    | اختياري.موجود(الحرفي) -> {
        طابق الحرفي مع
        | تعبير.حرفي(_, حرفي.نص(البايتات)) -> { المطلوب := البايتات; }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع المسار: نص = مسار_ملف_مضمن(المصدر, &المطلوب);
    دع المحتوى: متغير متجه ط8 = [];
    طابق اقرأ_بايتات_ملف(&المسار) مع
    | نتيجة.نجح(البايتات) -> { المحتوى := البايتات; }
    | نتيجة.خطأ(_) -> {
        (*المؤشر).الموضع := موضع_الحرفي;
        ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.ملف_مضمن_غير_مقروء(), رمز.حرفي_نص());
        أرجع اختياري.لا_شيء();
    };
    إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) { أرجع اختياري.لا_شيء(); };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    أرجع اختياري.موجود(تعبير.حرفي(دمج_نطاق(البداية, النهاية), حرفي.نص(المحتوى)));
}

// After a callee place, `<A, B>(` is a list of explicit type arguments; any
// other `<` is the comparison it reads as, and the cursor goes back to it.
عام عرف جرب_حجج_نوع_صريحة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    القيمة: تعبير
): تعبير {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.أصغر()) { أرجع القيمة; };
    دع مستدعى_ممكن: متغير منطقي = خطأ;
    طابق القيمة مع
    | تعبير.اسم(_, _) -> { مستدعى_ممكن := صواب; }
    | تعبير.حقل(_, _, _) -> { مستدعى_ممكن := صواب; }
    | _ -> { };
    إذا (!مستدعى_ممكن) { أرجع القيمة; };
    دع موضع_البداية: طبيعي = (*المؤشر).الموضع;
    تقدم(الرموز, المؤشر);
    دع الحجج: متغير متجه نوع_تركيبي = [];
    دع سليم: متغير منطقي = صواب;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر && سليم) {
        طابق حلل_نوعا(المصدر, الرموز, المؤشر) مع
        | اختياري.لا_شيء -> { سليم := خطأ; }
        | اختياري.موجود(ن) -> { ألحق(الحجج, ن); };
        إذا (سليم && !اقبل(الرموز, المؤشر, رمز.فاصلة())) { مستمر := خطأ; };
    }
    إذا (سليم) {
        سليم := اغلق_زاوية_وسيطات_نوع(الرموز, المؤشر);
    };
    إذا (سليم) {
        سليم := !(*المؤشر).نصف_مستهلك && نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار();
    };
    إذا (!سليم) {
        (*المؤشر).الموضع := موضع_البداية;
        (*المؤشر).الخطأ := اختياري.لا_شيء();
        (*المؤشر).نصف_مستهلك := خطأ;
        أرجع القيمة;
    };
    دع النطاق: نطاق = نطاق_تعبير(&القيمة);
    دع الصندوق: صندوق تعبير = صندوق القيمة;
    أرجع تعبير.حجج_نوع(النطاق, الصندوق, الحجج);
}

// `{name: value, ...}` in expression position: a record literal typed by
// its context (an argument, a returned value, an assigned value).
عرف بداية_حرفي_سجل(الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): منطقي {
    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يسار()) { أرجع خطأ; };
    إذا (نوع_التالي(الرموز, المؤشر) != رمز.معرف()) { أرجع خطأ; };
    دع الثالث: طبيعي = فهرس_الحالي(المؤشر) + 2;
    إذا (الثالث >= (الطول(*الرموز) مثل طبيعي)) { أرجع خطأ; };
    أرجع نوع_عند(الرموز, الثالث) == رمز.نقطتان();
}

عرف حلل_حرفي_سجل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    دع الحقول: متغير متجه حقل_تهيئة = [];
    طالما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
        إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معرف()) {
            ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معرف());
            أرجع اختياري.لا_شيء();
        };
        دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        إذا (!توقع(الرموز, المؤشر, رمز.نقطتان())) { أرجع اختياري.لا_شيء(); };
        طابق حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(ت) -> {
            دع الحقل: حقل_تهيئة = { الاسم: الاسم, القيمة: ت };
            ألحق(الحقول, الحقل);
        };
        إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
            إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
                ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.معقوف_يمين());
                أرجع اختياري.لا_شيء();
            };
        };
    }
    تقدم(الرموز, المؤشر);
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع الحرفي: تعبير = تعبير.حرفي_سجل(دمج_نطاق(البداية, النهاية), الحقول);
    أرجع حلل_لواحق_ناتج_استدعاء(المصدر, الرموز, المؤشر, البداية, الحرفي);
}

عرف حلل_أولي(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.نوع_دالة()) {
        دع الإغلاق: اختياري تعبير = حلل_إغلاق(المصدر, الرموز, المؤشر);
        طابق الإغلاق مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); };
    };
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار() && نوع_التالي(الرموز, المؤشر) == رمز.نجمة()) {
        // `(*موضع)` is a dereferenced place; `(*أ != 0 && ب)` is a grouped
        // expression whose first operand is a dereference. Try the place
        // form first and reparse as a grouped expression when it does not
        // close immediately.
        دع موضع_البداية: طبيعي = (*المؤشر).الموضع;
        دع بداية_الموضع: نطاق = نطاق_الحالي(الرموز, المؤشر);
        دع موضع: اختياري تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
        طابق موضع مع
        | اختياري.لا_شيء -> {
            (*المؤشر).الموضع := موضع_البداية;
            (*المؤشر).الخطأ := اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            // `(*x).f(1)`: a call and its result's projections follow the
            // dereferenced place as they follow a named one.
            إذا (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار()) {
                طابق ابن_استدعاء_بعد_موضع(المصدر, الرموز, المؤشر, بداية_الموضع, القيمة) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(ت) -> {
                    أرجع حلل_لواحق_ناتج_استدعاء(المصدر, الرموز, المؤشر, بداية_الموضع, ت);
                };
            };
            أرجع اختياري.موجود(القيمة);
        };
    };
    إذا (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
        دع الداخل: اختياري تعبير = حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
        طابق الداخل مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            إذا (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(القيمة);
        };
    };
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_مربع_يسار()) {
        أرجع حلل_حرفي_متجه(المصدر, الرموز, المؤشر);
    };
    إذا (بداية_حرفي_سجل(الرموز, المؤشر)) {
        أرجع حلل_حرفي_سجل(المصدر, الرموز, المؤشر);
    };
    إذا (بداية_تضمين_ملف(المصدر, الرموز, المؤشر)) {
        أرجع حلل_تضمين_ملف(المصدر, الرموز, المؤشر);
    };
    إذا (بداية_موضع(نوع_الحالي(الرموز, المؤشر))) {
        دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
        دع موضع: اختياري تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
        طابق موضع مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(المقروء) -> {
            دع القيمة: تعبير = جرب_حجج_نوع_صريحة(المصدر, الرموز, المؤشر, المقروء);
            إذا (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار()) {
                دع الاستدعاء: اختياري تعبير = ابن_استدعاء_بعد_موضع(
                    المصدر,
                    الرموز,
                    المؤشر,
                    البداية,
                    القيمة
                );
                طابق الاستدعاء مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(ت) -> {
                    أرجع حلل_لواحق_ناتج_استدعاء(المصدر, الرموز, المؤشر, البداية, ت);
                };
            };
            أرجع اختياري.موجود(القيمة);
        };
    };
    دع الحرفي: اختياري تعبير = حرفي_حالي(المصدر, الرموز, المؤشر);
    طابق الحرفي مع
    | اختياري.لا_شيء -> {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.تعبير();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(القيمة) -> {
        أرجع اختياري.موجود(القيمة);
    };
}

عرف حلل_أحاديا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    إذا (نوع_الحالي(الرموز, المؤشر) == رمز.وقت_الترجمة()) {
        دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
        تقدم(الرموز, المؤشر);
        إذا (اقبل(الرموز, المؤشر, رمز.معقوف_يسار())) {
            دع العبارات: متغير متجه تعبير = [];
            طالما (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
                دع النتيجة: اختياري تعبير = حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
                طابق النتيجة مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(داخل) -> { ألحق(العبارات, داخل); };
                إذا (!اقبل(الرموز, المؤشر, رمز.فاصلة_منقوطة())) {
                    إذا (نوع_الحالي(الرموز, المؤشر) != رمز.معقوف_يمين()) {
                        ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.متوقع(), رمز.فاصلة_منقوطة());
                        أرجع اختياري.لا_شيء();
                    };
                };
            }
            إذا (!توقع(الرموز, المؤشر, رمز.معقوف_يمين())) {
                أرجع اختياري.لا_شيء();
            };
            دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
            دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
            إذا ((الطول(العبارات) مثل طبيعي) == 0) {
                ارفض(الرموز, المؤشر, فئة_خطأ_نحوي.تعبير(), رمز.معرف());
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(تعبير.تسلسل_وقت_الترجمة(النطاق, العبارات));
        };
        دع النتيجة: اختياري تعبير = حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
        طابق النتيجة مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الداخل) -> {
            دع النطاق: نطاق = دمج_نطاق(البداية, نطاق_تعبير(&الداخل));
            دع المملوك: صندوق تعبير = صندوق الداخل;
            أرجع اختياري.موجود(تعبير.وقت_الترجمة(النطاق, المملوك));
        };
    };
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    دع العملية: متغير عامل_أحادي = عامل_أحادي.نفي();
    دع أحادي: متغير منطقي = صواب;
    إذا (النوع == رمز.نفي()) {
        العملية := عامل_أحادي.نفي();
    }
    وإلا {
        إذا (النوع == رمز.متمم()) {
            العملية := عامل_أحادي.متمم();
        }
        وإلا {
            إذا (النوع == رمز.طرح()) {
                العملية := عامل_أحادي.سالب();
            }
            وإلا {
                إذا (النوع == رمز.و_بتي()) {
                    العملية := عامل_أحادي.عنوان();
                }
                وإلا {
                    إذا (النوع == رمز.نجمة()) {
                        العملية := عامل_أحادي.فك();
                    }
                    وإلا {
                        أحادي := خطأ;
                    };
                };
            };
        };
    };
    إذا (!أحادي) {
        دع الأولي: اختياري تعبير = حلل_أولي(المصدر, الرموز, المؤشر);
        طابق الأولي مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            أرجع بعد_التحويل(المصدر, الرموز, المؤشر, القيمة);
        };
    };
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    إذا ((العملية == عامل_أحادي.سالب()) && (نوع_الحالي(الرموز, المؤشر) == رمز.حرفي_عدد_صحيح())) {
        دع المحاولة: اختياري قيمة_عدد_صحيح_رمز = قيمة_عدد_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختياري.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(القيمة) -> {
            دع النهاية: نطاق = نطاق_الحالي(الرموز, المؤشر);
            تقدم(الرموز, المؤشر);
            دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
            دع الناتج: تعبير = تعبير_عدد_سالب_من_قيمة_رمز(النطاق, القيمة);
            أرجع بعد_التحويل(المصدر, الرموز, المؤشر, الناتج);
        };
    };
    إذا ((العملية == عامل_أحادي.عنوان()) && اقبل(الرموز, المؤشر, رمز.متغير())) {
        العملية := عامل_أحادي.عنوان_متغير();
    };
    دع الداخل: اختياري تعبير = حلل_أحاديا(المصدر, الرموز, المؤشر);
    طابق الداخل مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(القيمة) -> {
        دع النهاية: نطاق = نطاق_تعبير(&القيمة);
        دع الصندوق: صندوق تعبير = صندوق القيمة;
        دع الناتج: تعبير = تعبير.أحادي(دمج_نطاق(البداية, النهاية), العملية, الصندوق);
        أرجع بعد_التحويل(المصدر, الرموز, المؤشر, الناتج);
    };
}

عام عرف حلل_تعبيرا_بأسبقية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الأدنى: عدد
): اختياري تعبير {
    دع يسار_نتيجة: اختياري تعبير = حلل_أحاديا(المصدر, الرموز, المؤشر);
    طابق يسار_نتيجة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(أول) -> {
        دع اليسار: متغير تعبير = أول;
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            دع المعلومة: معلومة_عامل = معلومة_العامل(نوع_الحالي(الرموز, المؤشر));
            طابق المعلومة مع
            | معلومة_عامل.ليس_ثنائيا -> {
                مستمر := خطأ;
            }
            | معلومة_عامل.ثنائي(الأسبقية, العملية) -> {
                إذا (الأسبقية < الأدنى) {
                    مستمر := خطأ;
                }
                وإلا {
                    تقدم(الرموز, المؤشر);
                    دع يمين_نتيجة: اختياري تعبير = حلل_تعبيرا_بأسبقية(
                        المصدر,
                        الرموز,
                        المؤشر,
                        الأسبقية + 1
                    );
                    طابق يمين_نتيجة مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.لا_شيء();
                    }
                    | اختياري.موجود(اليمين) -> {
                        دع بداية_النطاق: نطاق = نطاق_تعبير(&اليسار);
                        دع نهاية_النطاق: نطاق = نطاق_تعبير(&اليمين);
                        دع أ: صندوق تعبير = صندوق اليسار;
                        دع ب: صندوق تعبير = صندوق اليمين;
                        اليسار := تعبير.ثنائي(دمج_نطاق(بداية_النطاق, نهاية_النطاق), العملية, أ, ب);
                    };
                };
            };
        }
        أرجع اختياري.موجود(اليسار);
    };
}

عام عرف حلل_تعبيرا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختياري تعبير {
    أرجع حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
}
