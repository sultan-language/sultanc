// تبنى التعبيرات من هويات الرموز نفسها بغض النظر عن سطح source.

عرف انسخ_بايتات_حرفي_من_المصدر(المصدر: &مصدر, النطاق: نطاق): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = النطاق.البداية.البايت;
    بينما (ف < النطاق.النهاية.البايت) {
        ألحق(الناتج, بايت_المصدر(المصدر, ف));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف حرفي_عدد_من_قيمة_رمز(القيمة: قيمة_عدد_صحيح_رمز): حرفي {
    طابق القيمة مع
    | قيمة_عدد_صحيح_رمز.موقع(العدد) -> { أرجع حرفي.عدد(العدد); }
    | قيمة_عدد_صحيح_رمز.غير_موقع(العدد) -> { أرجع حرفي.عدد_غير_موقع(العدد); };
}

عام عرف تعبير_عدد_سالب_من_قيمة_رمز(النطاق: نطاق, القيمة: قيمة_عدد_صحيح_رمز): تعبير {
    طابق القيمة مع
    | قيمة_عدد_صحيح_رمز.موقع(العدد) -> {
        أرجع تعبير.حرفي(النطاق, حرفي.عدد(0 - العدد));
    }
    | قيمة_عدد_صحيح_رمز.غير_موقع(المقدار) -> {
        دع أعلى_موقع: غير_موقع = 9223372036854775807 مثل غير_موقع;
        دع حد_أدنى_موقع: غير_موقع = أعلى_موقع + 1;
        لو (المقدار == حد_أدنى_موقع) {
            دع قبل_الأدنى: عدد = 0 - 9223372036854775807;
            دع الأدنى: عدد = قبل_الأدنى - 1;
            أرجع تعبير.حرفي(النطاق, حرفي.عدد(الأدنى));
        };
        دع الداخل: تعبير = تعبير.حرفي(النطاق, حرفي.عدد_غير_موقع(المقدار));
        دع الصندوق: صندوق تعبير = صندوق الداخل;
        أرجع تعبير.أحادي(النطاق, عامل_أحادي.سالب(), الصندوق);
    };
}

عرف حرفي_حالي(المصدر: &مصدر, الرموز: &متجه رمز_مصدر, المؤشر: &متغير مؤشر): اختيار تعبير {
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    دع النطاق: نطاق = نطاق_الحالي(الرموز, المؤشر);
    لو (النوع == رمز.حرفي_عدد_صحيح()) {
        دع المحاولة: اختيار قيمة_عدد_صحيح_رمز = قيمة_عدد_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختيار.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(القيمة) -> {
            تقدم(الرموز, المؤشر);
            دع الحرفي: حرفي = حرفي_عدد_من_قيمة_رمز(القيمة);
            أرجع اختيار.بعض(تعبير.حرفي(النطاق, الحرفي));
        };
    };
    لو (النوع == رمز.حرفي_عدد_عشري()) {
        دع البايتات: متجه غ8 = انسخ_بايتات_حرفي_من_المصدر(المصدر, النطاق);
        تقدم(الرموز, المؤشر);
        دع الحرفي: حرفي = حرفي.عدد_عشري(البايتات);
        أرجع اختيار.بعض(تعبير.حرفي(النطاق, الحرفي));
    };
    لو (النوع == رمز.حرفي_حرف()) {
        دع المحاولة: اختيار غ32 = قيمة_محرف_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختيار.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(القيمة) -> {
            تقدم(الرموز, المؤشر);
            دع الحرفي: حرفي = حرفي.حرف(القيمة);
            أرجع اختيار.بعض(تعبير.حرفي(النطاق, الحرفي));
        };
    };
    لو (النوع == رمز.حرفي_منطقي()) {
        دع المحاولة: اختيار منطقي = قيمة_منطق_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختيار.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(القيمة) -> {
            تقدم(الرموز, المؤشر);
            دع الحرفي: حرفي = حرفي.منطقي(القيمة);
            أرجع اختيار.بعض(تعبير.حرفي(النطاق, الحرفي));
        };
    };
    لو (النوع == رمز.حرفي_نص()) {
        دع المحاولة: اختيار متجه غ8 = نسخ_بايتات_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختيار.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(القيمة) -> {
            تقدم(الرموز, المؤشر);
            دع الحرفي: حرفي = حرفي.نص(القيمة);
            أرجع اختيار.بعض(تعبير.حرفي(النطاق, الحرفي));
        };
    };
    لو (النوع == رمز.غير_معرف()) {
        تقدم(الرموز, المؤشر);
        دع الحرفي: حرفي = حرفي.غير_معرف();
        أرجع اختيار.بعض(تعبير.حرفي(النطاق, الحرفي));
    };
    أرجع اختيار.لا_شيء();
}

عرف بداية_موضع(النوع: رمز): منطقي {
    أرجع النوع == رمز.معرف();
}

عام عرف حلل_موضعا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار تعبير {
    لو (!بداية_موضع(نوع_الحالي(الرموز, المؤشر))) {
        أرجع اختيار.لا_شيء();
    };
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    دع الاسم: اسم = اسم_الحالي(الرموز, المؤشر);
    دع الحالي: متغير تعبير = تعبير.اسم(البداية, الاسم);
    تقدم(الرموز, المؤشر);
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        لو (اقبل(الرموز, المؤشر, رمز.نقطة())) {
            لو (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
                دع الفهرس: اختيار تعبير = حلل_ذرة(المصدر, الرموز, المؤشر);
                طابق الفهرس مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.لا_شيء();
                }
                | اختيار.بعض(القيمة) -> {
                    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                        أرجع اختيار.لا_شيء();
                    };
                    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                    دع الأصل: صندوق تعبير = صندوق الحالي;
                    دع الف: صندوق تعبير = صندوق القيمة;
                    الحالي := تعبير.فهرس(دمج_نطاق(البداية, النهاية), الأصل, الف);
                };
            }
            وإلا {
                دع النتيجة: نتيجة_اسم = خذ_اسما_سياقيا(الرموز, المؤشر);
                طابق النتيجة مع
                | نتيجة_اسم.غائب -> {
                    دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.متوقع();
                    ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
                    أرجع اختيار.لا_شيء();
                }
                | نتيجة_اسم.موجود(الحقل) -> {
                    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                    دع الأصل: صندوق تعبير = صندوق الحالي;
                    الحالي := تعبير.حقل(دمج_نطاق(البداية, النهاية), الأصل, الحقل);
                };
            };
        }
        وإلا {
            لو (اقبل(الرموز, المؤشر, رمز.قوس_مربع_يسار())) {
                دع الفهرس: اختيار تعبير = حلل_ذرة(المصدر, الرموز, المؤشر);
                طابق الفهرس مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.لا_شيء();
                }
                | اختيار.بعض(القيمة) -> {
                    لو (!توقع(الرموز, المؤشر, رمز.قوس_مربع_يمين())) {
                        أرجع اختيار.لا_شيء();
                    };
                    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                    دع الأصل: صندوق تعبير = صندوق الحالي;
                    دع الف: صندوق تعبير = صندوق القيمة;
                    الحالي := تعبير.فهرس(دمج_نطاق(البداية, النهاية), الأصل, الف);
                };
            }
            وإلا {
                مستمر := خطأ;
            };
        };
    }
    أرجع اختيار.بعض(الحالي);
}

عام عرف حلل_ذرة(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار تعبير {
    لو (بداية_موضع(نوع_الحالي(الرموز, المؤشر))) {
        أرجع حلل_موضعا(المصدر, الرموز, المؤشر);
    };
    دع الحرفي: اختيار تعبير = حرفي_حالي(المصدر, الرموز, المؤشر);
    طابق الحرفي مع
    | اختيار.بعض(القيمة) -> {
        أرجع اختيار.بعض(القيمة);
    }
    | اختيار.لا_شيء -> {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.تعبير();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    };
}

عرف بعد_التحويل(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    التعبير: تعبير
): اختيار تعبير {
    دع الحالي: متغير تعبير = التعبير;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        لو (اقبل(الرموز, المؤشر, رمز.تحويل_نوع())) {
            دع النوع: اختيار نوع_تركيبي = حلل_نوعا(المصدر, الرموز, المؤشر);
            طابق النوع مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            }
            | اختيار.بعض(الهدف) -> {
                دع بداية_النطاق: نطاق = نطاق_تعبير(&الحالي);
                دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
                دع الأصل: صندوق تعبير = صندوق الحالي;
                الحالي := تعبير.تحويل(دمج_نطاق(بداية_النطاق, النهاية), الأصل, الهدف);
            };
        }
        وإلا {
            مستمر := خطأ;
        };
    }
    أرجع اختيار.بعض(الحالي);
}

عام عرف ابن_استدعاء_بعد_موضع(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    البداية: نطاق,
    الدالة_تعبير: تعبير
): اختيار تعبير {
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يسار())) {
        أرجع اختيار.لا_شيء();
    };
    دع الحجج: متغير متجه تعبير = [];
    لو (نوع_الحالي(الرموز, المؤشر) != رمز.قوس_يمين()) {
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع حجة: اختيار تعبير = حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
            طابق حجة مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            }
            | اختيار.بعض(ت) -> {
                ألحق(الحجج, ت);
            };
            لو (!اقبل(الرموز, المؤشر, رمز.فاصلة())) {
                مستمر := خطأ;
            };
        }
    };
    لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
        أرجع اختيار.لا_شيء();
    };
    دع النهاية: نطاق = نطاق_السابق(الرموز, المؤشر);
    دع الدالة: صندوق تعبير = صندوق الدالة_تعبير;
    أرجع اختيار.بعض(تعبير.استدعاء(دمج_نطاق(البداية, النهاية), الدالة, الحجج));
}

عرف حلل_أولي(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار تعبير {
    لو (اقبل(الرموز, المؤشر, رمز.قوس_يسار())) {
        دع الداخل: اختيار تعبير = حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
        طابق الداخل مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(القيمة) -> {
            لو (!توقع(الرموز, المؤشر, رمز.قوس_يمين())) {
                أرجع اختيار.لا_شيء();
            };
            أرجع بعد_التحويل(المصدر, الرموز, المؤشر, القيمة);
        };
    };
    لو (بداية_موضع(نوع_الحالي(الرموز, المؤشر))) {
        دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
        دع موضع: اختيار تعبير = حلل_موضعا(المصدر, الرموز, المؤشر);
        طابق موضع مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(القيمة) -> {
            لو (نوع_الحالي(الرموز, المؤشر) == رمز.قوس_يسار()) {
                دع الاستدعاء: اختيار تعبير = ابن_استدعاء_بعد_موضع(
                    المصدر,
                    الرموز,
                    المؤشر,
                    البداية,
                    القيمة
                );
                طابق الاستدعاء مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.لا_شيء();
                }
                | اختيار.بعض(ت) -> {
                    أرجع بعد_التحويل(المصدر, الرموز, المؤشر, ت);
                };
            };
            أرجع بعد_التحويل(المصدر, الرموز, المؤشر, القيمة);
        };
    };
    دع الحرفي: اختيار تعبير = حرفي_حالي(المصدر, الرموز, المؤشر);
    طابق الحرفي مع
    | اختيار.لا_شيء -> {
        دع الفئة: فئة_خطأ_نحوي = فئة_خطأ_نحوي.تعبير();
        ارفض(الرموز, المؤشر, الفئة, رمز.معرف());
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(القيمة) -> {
        أرجع بعد_التحويل(المصدر, الرموز, المؤشر, القيمة);
    };
}

عرف حلل_أحاديا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار تعبير {
    دع النوع: رمز = نوع_الحالي(الرموز, المؤشر);
    دع العملية: متغير عامل_أحادي = عامل_أحادي.نفي();
    دع أحادي: متغير منطقي = صواب;
    لو (النوع == رمز.نفي()) {
        العملية := عامل_أحادي.نفي();
    }
    وإلا {
        لو (النوع == رمز.متمم()) {
            العملية := عامل_أحادي.متمم();
        }
        وإلا {
            لو (النوع == رمز.طرح()) {
                العملية := عامل_أحادي.سالب();
            }
            وإلا {
                لو (النوع == رمز.و_بتي()) {
                    العملية := عامل_أحادي.عنوان();
                }
                وإلا {
                    لو (النوع == رمز.نجمة()) {
                        العملية := عامل_أحادي.فك();
                    }
                    وإلا {
                        أحادي := خطأ;
                    };
                };
            };
        };
    };
    لو (!أحادي) {
        أرجع حلل_أولي(المصدر, الرموز, المؤشر);
    };
    دع البداية: نطاق = نطاق_الحالي(الرموز, المؤشر);
    تقدم(الرموز, المؤشر);
    لو ((العملية == عامل_أحادي.سالب()) && (نوع_الحالي(الرموز, المؤشر) == رمز.حرفي_عدد_صحيح())) {
        دع المحاولة: اختيار قيمة_عدد_صحيح_رمز = قيمة_عدد_عند(الرموز, فهرس_الحالي(المؤشر));
        طابق المحاولة مع
        | اختيار.لا_شيء -> {
            ارفض_داخليا(الرموز, المؤشر);
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(القيمة) -> {
            دع النهاية: نطاق = نطاق_الحالي(الرموز, المؤشر);
            تقدم(الرموز, المؤشر);
            دع النطاق: نطاق = دمج_نطاق(البداية, النهاية);
            دع الناتج: تعبير = تعبير_عدد_سالب_من_قيمة_رمز(النطاق, القيمة);
            أرجع بعد_التحويل(المصدر, الرموز, المؤشر, الناتج);
        };
    };
    لو ((العملية == عامل_أحادي.عنوان()) && اقبل(الرموز, المؤشر, رمز.متغير())) {
        العملية := عامل_أحادي.عنوان_متغير();
    };
    دع الداخل: اختيار تعبير = حلل_أحاديا(المصدر, الرموز, المؤشر);
    طابق الداخل مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(القيمة) -> {
        دع النهاية: نطاق = نطاق_تعبير(&القيمة);
        دع الصندوق: صندوق تعبير = صندوق القيمة;
        دع الناتج: تعبير = تعبير.أحادي(دمج_نطاق(البداية, النهاية), العملية, الصندوق);
        أرجع بعد_التحويل(المصدر, الرموز, المؤشر, الناتج);
    };
}

عام عرف حلل_تعبيرا_بأسبقية(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر,
    الأدنى: عدد
): اختيار تعبير {
    دع يسار_نتيجة: اختيار تعبير = حلل_أحاديا(المصدر, الرموز, المؤشر);
    طابق يسار_نتيجة مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(أول) -> {
        دع اليسار: متغير تعبير = أول;
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع المعلومة: معلومة_عامل = معلومة_العامل(نوع_الحالي(الرموز, المؤشر));
            طابق المعلومة مع
            | معلومة_عامل.ليس_ثنائيا -> {
                مستمر := خطأ;
            }
            | معلومة_عامل.ثنائي(الأسبقية, العملية) -> {
                لو (الأسبقية < الأدنى) {
                    مستمر := خطأ;
                }
                وإلا {
                    تقدم(الرموز, المؤشر);
                    دع يمين_نتيجة: اختيار تعبير = حلل_تعبيرا_بأسبقية(
                        المصدر,
                        الرموز,
                        المؤشر,
                        الأسبقية + 1
                    );
                    طابق يمين_نتيجة مع
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.لا_شيء();
                    }
                    | اختيار.بعض(اليمين) -> {
                        دع بداية_النطاق: نطاق = نطاق_تعبير(&اليسار);
                        دع نهاية_النطاق: نطاق = نطاق_تعبير(&اليمين);
                        دع أ: صندوق تعبير = صندوق اليسار;
                        دع ب: صندوق تعبير = صندوق اليمين;
                        اليسار := تعبير.ثنائي(دمج_نطاق(بداية_النطاق, نهاية_النطاق), العملية, أ, ب);
                    };
                };
            };
        }
        أرجع اختيار.بعض(اليسار);
    };
}

عام عرف حلل_تعبيرا(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    المؤشر: &متغير مؤشر
): اختيار تعبير {
    أرجع حلل_تعبيرا_بأسبقية(المصدر, الرموز, المؤشر, 1);
}
