استورد compiler.source.span;
استورد compiler.frontend.lexer.token;

عام نوع فئة_خطأ_نحوي =
    | متوقع
    | فاصلة_منقوطة_في_غير_موضعها
    | تهجئة_كلمة_محجوزة_محتملة
    | عبارة_بلا_عملية
    | نوع_ناتج_دالة_مفقود
    | تعبير
    | نوع
    | نمط
    | عنصر
    | شرط_هدف_غير_صالح
    | شرط_هدف_بلا_هدف
    // Brackets and prefix operators nested past حد_تعشيش_المحلل.
    | تعشيش_عميق_جدا
    // `ضمن_ملف(«path»)` names a file that cannot be read.
    | ملف_مضمن_غير_مقروء
    // A top-level `let` initialized with a record, tuple or box literal.
    | تهيئة_قيمة_عليا_غير_مدعومة
    | داخلي
;

عام نوع تهجئة_كلمة_مقترحة =
    | بلا_اقتراح
    | عربية
    | إنجليزية
;

عام نوع خطأ_نحوي = {
    الفئة: فئة_خطأ_نحوي,
    النطاق: نطاق,
    نطاق_الإدراج: اختياري نطاق,
    نطاق_الفاصلة_المنقوطة_في_غير_موضعها: اختياري نطاق,
    التهجئة_المقترحة: تهجئة_كلمة_مقترحة,
    المتوقع: رمز,
    الموجود: رمز
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_خطأ_نحوي(القيمة: &متجه خطأ_نحوي): متجه خطأ_نحوي {
    دع الناتج: متغير متجه خطأ_نحوي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
