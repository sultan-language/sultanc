استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.backend.target.target_model;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.patterns;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.parser.parser;
استورد compiler.frontend.parser.result;
استورد std.text.from_bytes;

// The propagation operator `؟` / `?` (docs/ERRORS.md, layer 1b). The parser
// accepts it only as the last postfix of a statement's whole right-hand side
// and marks the statement (`عامل_أحادي.انتشار`, with the `؟` token's span).
// This expansion runs right after parsing, before name resolution, so names,
// types, patterns, ownership flow (SSF), MSIR and every backend see ordinary
// statements. For a function returning `نتيجة U, E`:
//
//   let x: T = EXPR؟;                 let x: T;
//                                     match EXPR with
//                                     | h -> {
//                                         match h with
//                                         | result.ok(v) -> { x := v; }
//                                         | result.err(e) -> { return result.err(e); };
//                                     };
//
// `x := EXPR؟;` assigns in the ok arm, `return EXPR؟;` returns v, and
// `EXPR؟;` ignores it. In a function returning `اختياري U` the arms are
// `option.some(v)` and `option.none -> { return option.none(); }`.
//
// EXPR is bound to the hidden owned local h by an irrefutable binding
// pattern, and the dispatching match is on h, never on the call result. Each
// arm binds one payload, and the early return is the ordinary return, so the
// drop frame releases every owned local exactly once. No error conversion
// happens: the error type of EXPR must be the function's (std.error's
// مع_سياق and إلى_فشل convert explicitly).
//
// Like decorator expansion (frontend/annotations/decorators.sn), the
// generated statements are SultanC text appended after the unit's own text
// and parsed by the ordinary parser, so every generated name has its own
// source position; EXPR and the assignment target keep their own positions,
// spliced in from the original statement. The source map maps each
// generated region back to its `؟` (source_map.sn إحالة_نص_مولد), so a type
// error inside the expansion, such as a different error type, is reported
// at the `؟` with both types.
//
// The arms follow the declared return type as written: `اختياري …` / `option …`
// gives the option arms; `نتيجة …` / `result …` or a named type (an alias of
// a result) the result arms. Any other return type has no error to return
// into: the error arm then returns the whole value, which is a return type
// mismatch at the `؟` naming both types. An option alias is not recognized.

نوع موضع_انتشار = {
    // 0: assign the value (let and assignment); 1: return it; 2: ignore it.
    الشكل: طبيعي,
    // The declared return type as written: 0 a result or a named type, 1 an
    // option, 2 any other type (no result at all).
    الصنف: طبيعي,
    العلامة: نطاق
};

عرف ألحق_عددا_لانتشار(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    لو (القيمة >= 10) { ألحق_عددا_لانتشار(الناتج, القيمة / 10); };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل ط8);
}

// Hidden names: a reserved prefix and the site number; no source declares them.
عرف ألحق_اسما_مخفيا_لانتشار(الناتج: &متغير متجه ط8, الرقم: طبيعي, اللاحقة: نص): فراغ {
    ألحق_بايتات_نص(الناتج, «انتشار__»);
    ألحق_عددا_لانتشار(الناتج, الرقم);
    ألحق_بايتات_نص(الناتج, اللاحقة);
}

// The propagation marker of a statement's right-hand side, if any.
عرف علامة_انتشار(القيمة: &تعبير): اختياري نطاق {
    طابق *القيمة مع
    | تعبير.أحادي(النطاق, العامل, _) -> {
        لو (العامل == عامل_أحادي.انتشار()) { أرجع اختياري.موجود(النطاق); };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The marked expression without its marker.
عرف داخل_علامة_انتشار(القيمة: &تعبير): تعبير {
    طابق *القيمة مع
    | تعبير.أحادي(_, _, الداخل) -> { أرجع انسخ_مملوكا_تعبير(&(*الداخل)); }
    | _ -> { أرجع انسخ_مملوكا_تعبير(القيمة); };
}

// The site of one statement: its form and marker span.
عرف موضع_عبارة_انتشار(العبارة: &عبارة, الصنف: طبيعي): اختياري موضع_انتشار {
    دع الشكل: متغير طبيعي = 0;
    دع العلامة: متغير اختياري نطاق = اختياري.لا_شيء();
    طابق *العبارة مع
    | عبارة.نسخ(_, _, المصدر) -> {
        العلامة := علامة_انتشار(&المصدر);
        الشكل := 0;
    }
    | عبارة.أرجع(_, القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(التعبير) -> { العلامة := علامة_انتشار(&التعبير); }
        | اختياري.لا_شيء -> { };
        الشكل := 1;
    }
    | عبارة.استدعاء(_, التعبير) -> {
        العلامة := علامة_انتشار(&التعبير);
        الشكل := 2;
    }
    | _ -> { };
    طابق العلامة مع
    | اختياري.موجود(النطاق) -> {
        دع الموضع: موضع_انتشار = { الشكل: الشكل, الصنف: الصنف, العلامة: النطاق };
        أرجع اختياري.موجود(الموضع);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// --- Collection, in one fixed statement order ------------------------------

عرف اجمع_مواضع_عبارات(
    العبارات: &متجه صندوق عبارة,
    الصنف: طبيعي,
    المواضع: &متغير متجه موضع_انتشار
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العبارات) مثل طبيعي)) {
        دع مرجع_الصندوق: &صندوق عبارة = &(*العبارات)[ف];
        اجمع_مواضع_عبارة(&(*(*مرجع_الصندوق)), الصنف, المواضع);
        ف := ف + 1;
    }
}

عرف اجمع_مواضع_كتلة(
    الكتلة: &كتلة_عبارات,
    الصنف: طبيعي,
    المواضع: &متغير متجه موضع_انتشار
): فراغ {
    اجمع_مواضع_عبارات(&(*الكتلة).العبارات, الصنف, المواضع);
}

عرف اجمع_مواضع_عبارة(
    العبارة: &عبارة,
    الصنف: طبيعي,
    المواضع: &متغير متجه موضع_انتشار
): فراغ {
    طابق موضع_عبارة_انتشار(العبارة, الصنف) مع
    | اختياري.موجود(الموضع) -> {
        ألحق(*المواضع, الموضع);
        أرجع;
    }
    | اختياري.لا_شيء -> { };
    طابق *العبارة مع
    | عبارة.طالما(_, _, الجسم) -> { اجمع_مواضع_كتلة(&الجسم, الصنف, المواضع); }
    | عبارة.لكل(_, البداية, _, _, الجسم) -> {
        اجمع_مواضع_عبارات(&البداية, الصنف, المواضع);
        اجمع_مواضع_كتلة(&الجسم, الصنف, المواضع);
    }
    | عبارة.لو(_, _, الأول, الثاني) -> {
        اجمع_مواضع_كتلة(&الأول, الصنف, المواضع);
        طابق الثاني مع
        | اختياري.موجود(الكتلة) -> { اجمع_مواضع_كتلة(&الكتلة, الصنف, المواضع); }
        | اختياري.لا_شيء -> { };
    }
    | عبارة.طابق(_, _, الأذرع) -> {
        دع ذ: متغير طبيعي = 0;
        طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
            اجمع_مواضع_كتلة(&الأذرع[ذ].الجسم, الصنف, المواضع);
            ذ := ذ + 1;
        }
    }
    | عبارة.غير_آمن(_, الجسم) -> { اجمع_مواضع_كتلة(&الجسم, الصنف, المواضع); }
    | عبارة.وقت_الترجمة(_, الجسم) -> { اجمع_مواضع_كتلة(&الجسم, الصنف, المواضع); }
    | عبارة.إسناد_وقت_الترجمة(_, _, الجسم, _) -> { اجمع_مواضع_كتلة(&الجسم, الصنف, المواضع); }
    | _ -> { };
}

عرف صنف_ناتج_مكتوب(الدالة: &تصريح_دالة): طبيعي {
    طابق (*الدالة).الناتج مع
    | نوع_تركيبي.نتيجة(_, _, _) -> { أرجع 0; }
    | نوع_تركيبي.مسمى(_, _, _) -> { أرجع 0; }
    | نوع_تركيبي.اختيار(_, _) -> { أرجع 1; }
    | _ -> { أرجع 2; };
}

// --- Generated text --------------------------------------------------------

// One site as a parameterless function whose body is the expansion; only
// the body is kept. The scrutinee `انتشار__N__قيمة` and the target
// `انتشار__N__وجهة` are placeholders for the original pieces.
عرف ألحق_نص_موضع_انتشار(
    الناتج: &متغير متجه ط8,
    الموضع: &موضع_انتشار,
    الرقم: طبيعي
): فراغ {
    ألحق_بايتات_نص(الناتج, «طابق »);
    ألحق_اسما_مخفيا_لانتشار(الناتج, الرقم, «__قيمة»);
    ألحق_بايتات_نص(الناتج, " مع\n| ");
    ألحق_اسما_مخفيا_لانتشار(الناتج, الرقم, «»);
    ألحق_بايتات_نص(الناتج, " -> {\n    طابق ");
    ألحق_اسما_مخفيا_لانتشار(الناتج, الرقم, «»);
    ألحق_بايتات_نص(الناتج, " مع\n    | ");
    دع اختياري: منطقي = (*الموضع).الصنف == 1;
    لو (اختياري) {
        ألحق_بايتات_نص(الناتج, «اختياري.موجود(»);
    } وإلا {
        ألحق_بايتات_نص(الناتج, «نتيجة.نجح(»);
    };
    لو ((*الموضع).الشكل == 2) {
        ألحق_بايتات_نص(الناتج, «_) -> { }»);
    } وإلا {
        ألحق_اسما_مخفيا_لانتشار(الناتج, الرقم, «__ناتج»);
        ألحق_بايتات_نص(الناتج, «) -> { »);
        لو ((*الموضع).الشكل == 0) {
            ألحق_اسما_مخفيا_لانتشار(الناتج, الرقم, «__وجهة»);
            ألحق_بايتات_نص(الناتج, « := »);
        } وإلا {
            ألحق_بايتات_نص(الناتج, «أرجع »);
        };
        ألحق_اسما_مخفيا_لانتشار(الناتج, الرقم, «__ناتج»);
        ألحق_بايتات_نص(الناتج, «; }»);
    };
    ألحق_بايتات_نص(الناتج, "\n    | ");
    لو (اختياري) {
        ألحق_بايتات_نص(الناتج, «اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };»);
    } وإلا لو ((*الموضع).الصنف == 2) {
        // No result to return into: returning the whole value reports the
        // return type mismatch, with both types, at the `؟`.
        ألحق_بايتات_نص(الناتج, «نتيجة.خطأ(_) -> { أرجع »);
        ألحق_اسما_مخفيا_لانتشار(الناتج, الرقم, «»);
        ألحق_بايتات_نص(الناتج, «; };»);
    } وإلا {
        ألحق_بايتات_نص(الناتج, «نتيجة.خطأ(»);
        ألحق_اسما_مخفيا_لانتشار(الناتج, الرقم, «__خطأ»);
        ألحق_بايتات_نص(الناتج, «) -> { أرجع نتيجة.خطأ(»);
        ألحق_اسما_مخفيا_لانتشار(الناتج, الرقم, «__خطأ»);
        ألحق_بايتات_نص(الناتج, «); };»);
    };
    ألحق_بايتات_نص(الناتج, "\n};");
}

// --- Splicing --------------------------------------------------------------

// The generated expansion with the original EXPR as the outer scrutinee and,
// for an assignment, the original target in the ok arm.
عرف ركب_موضع_انتشار(
    المولدة: عبارة,
    القيمة: تعبير,
    الوجهة: اختياري تعبير
): عبارة {
    طابق المولدة مع
    | عبارة.طابق(س, _, الأذرع) -> {
        طابق الوجهة مع
        | اختياري.لا_شيء -> { أرجع عبارة.طابق(س, القيمة, الأذرع); }
        | اختياري.موجود(الهدف) -> {
            دع الأذرع_الجديدة: متغير متجه ذراع_مطابقة = [];
            دع ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
                دع الجسم: متغير كتلة_عبارات = انسخ_مملوكا_كتلة_عبارات(&الأذرع[ذ].الجسم);
                لو (ذ == 0) {
                    الجسم := ضع_وجهة_في_كتلة_انتشار(الجسم, &الهدف);
                };
                دع الذراع: ذراع_مطابقة = {
                    النمط: انسخ_مملوكا_نمط(&الأذرع[ذ].النمط),
                    الجسم: الجسم
                };
                ألحق(الأذرع_الجديدة, الذراع);
                ذ := ذ + 1;
            }
            أرجع عبارة.طابق(س, القيمة, الأذرع_الجديدة);
        };
    }
    | _ -> { أرجع المولدة; };
}

// Outer arm body: its inner match; the inner ok arm (the first) holds the
// placeholder assignment.
عرف ضع_وجهة_في_كتلة_انتشار(الكتلة: كتلة_عبارات, الهدف: &تعبير): كتلة_عبارات {
    دع العبارات: متغير متجه صندوق عبارة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكتلة.العبارات) مثل طبيعي)) {
        دع مرجع_الصندوق: &صندوق عبارة = &الكتلة.العبارات[ف];
        دع العبارة: عبارة = انسخ_مملوكا_عبارة(&(*(*مرجع_الصندوق)));
        دع الجديدة: عبارة = ضع_وجهة_في_عبارة_انتشار(العبارة, الهدف);
        دع الصندوق: صندوق عبارة = صندوق الجديدة;
        ألحق(العبارات, الصندوق);
        ف := ف + 1;
    }
    دع الناتج: كتلة_عبارات = { النطاق: الكتلة.النطاق, العبارات: العبارات };
    أرجع الناتج;
}

عرف ضع_وجهة_في_عبارة_انتشار(العبارة: عبارة, الهدف: &تعبير): عبارة {
    طابق العبارة مع
    | عبارة.طابق(س, المميز, الأذرع) -> {
        دع الأذرع_الجديدة: متغير متجه ذراع_مطابقة = [];
        دع ذ: متغير طبيعي = 0;
        طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
            دع الجسم: متغير كتلة_عبارات = انسخ_مملوكا_كتلة_عبارات(&الأذرع[ذ].الجسم);
            لو (ذ == 0) {
                الجسم := ضع_وجهة_في_كتلة_انتشار(الجسم, الهدف);
            };
            دع الذراع: ذراع_مطابقة = {
                النمط: انسخ_مملوكا_نمط(&الأذرع[ذ].النمط),
                الجسم: الجسم
            };
            ألحق(الأذرع_الجديدة, الذراع);
            ذ := ذ + 1;
        }
        أرجع عبارة.طابق(س, المميز, الأذرع_الجديدة);
    }
    | عبارة.نسخ(س, _, المصدر) -> {
        أرجع عبارة.نسخ(س, انسخ_مملوكا_تعبير(الهدف), المصدر);
    }
    | _ -> { أرجع العبارة; };
}

// One original site statement replaced by its expansion.
عرف وسع_عبارة_موضع(العبارة: &عبارة, المولدة: عبارة): عبارة {
    طابق *العبارة مع
    | عبارة.نسخ(_, الوجهة, المصدر) -> {
        أرجع ركب_موضع_انتشار(
            المولدة, داخل_علامة_انتشار(&المصدر), اختياري.موجود(انسخ_مملوكا_تعبير(&الوجهة))
        );
    }
    | عبارة.أرجع(_, القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(التعبير) -> {
            أرجع ركب_موضع_انتشار(المولدة, داخل_علامة_انتشار(&التعبير), اختياري.لا_شيء());
        }
        | اختياري.لا_شيء -> { أرجع المولدة; };
    }
    | عبارة.استدعاء(_, التعبير) -> {
        أرجع ركب_موضع_انتشار(المولدة, داخل_علامة_انتشار(&التعبير), اختياري.لا_شيء());
    }
    | _ -> { أرجع المولدة; };
}

// Rebuilds statements in the collection order, taking expansions in turn.
عرف وسع_عبارات_انتشار(
    العبارات: &متجه صندوق عبارة,
    المولدة: &متجه عبارة,
    التالي: &متغير طبيعي
): متجه صندوق عبارة {
    دع الناتج: متغير متجه صندوق عبارة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العبارات) مثل طبيعي)) {
        دع مرجع_الصندوق: &صندوق عبارة = &(*العبارات)[ف];
        دع الجديدة: عبارة = وسع_عبارة_انتشار(&(*(*مرجع_الصندوق)), المولدة, التالي);
        دع الصندوق: صندوق عبارة = صندوق الجديدة;
        ألحق(الناتج, الصندوق);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف وسع_كتلة_انتشار(
    الكتلة: &كتلة_عبارات,
    المولدة: &متجه عبارة,
    التالي: &متغير طبيعي
): كتلة_عبارات {
    دع العبارات: متجه صندوق عبارة = وسع_عبارات_انتشار(&(*الكتلة).العبارات, المولدة, التالي);
    دع الناتج: كتلة_عبارات = { النطاق: (*الكتلة).النطاق, العبارات: العبارات };
    أرجع الناتج;
}

عرف وسع_عبارة_انتشار(
    العبارة: &عبارة,
    المولدة: &متجه عبارة,
    التالي: &متغير طبيعي
): عبارة {
    طابق موضع_عبارة_انتشار(العبارة, 0) مع
    | اختياري.موجود(_) -> {
        دع الرقم: طبيعي = *التالي;
        *التالي := الرقم + 1;
        لو (الرقم >= (الطول(*المولدة) مثل طبيعي)) {
            أرجع انسخ_مملوكا_عبارة(العبارة);
        };
        دع المولدة_الواحدة: عبارة = انسخ_مملوكا_عبارة(&(*المولدة)[الرقم]);
        أرجع وسع_عبارة_موضع(العبارة, المولدة_الواحدة);
    }
    | اختياري.لا_شيء -> { };
    طابق *العبارة مع
    | عبارة.طالما(س, الشرط, الجسم) -> {
        دع الجسم_الجديد: كتلة_عبارات = وسع_كتلة_انتشار(&الجسم, المولدة, التالي);
        أرجع عبارة.طالما(س, انسخ_مملوكا_تعبير(&الشرط), الجسم_الجديد);
    }
    | عبارة.لكل(س, البداية, الشرط, الخطوة, الجسم) -> {
        دع البداية_الجديدة: متجه صندوق عبارة = وسع_عبارات_انتشار(&البداية, المولدة, التالي);
        دع الجسم_الجديد: كتلة_عبارات = وسع_كتلة_انتشار(&الجسم, المولدة, التالي);
        أرجع عبارة.لكل(
            س, البداية_الجديدة, انسخ_مملوكا_تعبير(&الشرط),
            انسخ_مملوكا_صندوق_عبارة(&الخطوة), الجسم_الجديد
        );
    }
    | عبارة.لو(س, الشرط, الأول, الثاني) -> {
        دع الأول_الجديد: كتلة_عبارات = وسع_كتلة_انتشار(&الأول, المولدة, التالي);
        طابق الثاني مع
        | اختياري.موجود(الكتلة) -> {
            دع الثاني_الجديد: كتلة_عبارات = وسع_كتلة_انتشار(&الكتلة, المولدة, التالي);
            أرجع عبارة.لو(س, انسخ_مملوكا_تعبير(&الشرط), الأول_الجديد, اختياري.موجود(الثاني_الجديد));
        }
        | اختياري.لا_شيء -> {
            أرجع عبارة.لو(س, انسخ_مملوكا_تعبير(&الشرط), الأول_الجديد, اختياري.لا_شيء());
        };
    }
    | عبارة.طابق(س, المميز, الأذرع) -> {
        دع الأذرع_الجديدة: متغير متجه ذراع_مطابقة = [];
        دع ذ: متغير طبيعي = 0;
        طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
            دع الجسم_الجديد: كتلة_عبارات = وسع_كتلة_انتشار(&الأذرع[ذ].الجسم, المولدة, التالي);
            دع الذراع: ذراع_مطابقة = {
                النمط: انسخ_مملوكا_نمط(&الأذرع[ذ].النمط),
                الجسم: الجسم_الجديد
            };
            ألحق(الأذرع_الجديدة, الذراع);
            ذ := ذ + 1;
        }
        أرجع عبارة.طابق(س, انسخ_مملوكا_تعبير(&المميز), الأذرع_الجديدة);
    }
    | عبارة.غير_آمن(س, الجسم) -> {
        أرجع عبارة.غير_آمن(س, وسع_كتلة_انتشار(&الجسم, المولدة, التالي));
    }
    | عبارة.وقت_الترجمة(س, الجسم) -> {
        أرجع عبارة.وقت_الترجمة(س, وسع_كتلة_انتشار(&الجسم, المولدة, التالي));
    }
    | عبارة.إسناد_وقت_الترجمة(س, الوجهة, الجسم, الناتج) -> {
        دع الجسم_الجديد: كتلة_عبارات = وسع_كتلة_انتشار(&الجسم, المولدة, التالي);
        أرجع عبارة.إسناد_وقت_الترجمة(
            س, انسخ_مملوكا_تعبير(&الوجهة), الجسم_الجديد, انسخ_مملوكا_تعبير(&الناتج)
        );
    }
    | _ -> { أرجع انسخ_مملوكا_عبارة(العبارة); };
}

// --- Unit expansion --------------------------------------------------------

// Expands every propagation site of one parsed unit. A unit without `؟` is
// left untouched. Returns خطأ only when the generated text fails to lex or
// parse, which is a compiler fault: it is built from fixed text and numbers.
عام عرف وسع_انتشار_وحدة(
    الشجرة: &متغير وحدة_مصدر,
    سياق_المصادر: &متغير خريطة_مصادر,
    المصدر: &مصدر,
    الهدف: &اختياري واصف_هدف
): منطقي {
    دع المواضع: متغير متجه موضع_انتشار = [];
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            طابق الدالة.الجسم مع
            | اختياري.موجود(الجسم) -> {
                اجمع_مواضع_كتلة(&الجسم, صنف_ناتج_مكتوب(&الدالة), &متغير المواضع);
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ع := ع + 1;
    }
    لو ((الطول(المواضع) مثل طبيعي) == 0) { أرجع صواب; };

    دع مرجع_المحتوى: &نص = &(*المصدر).المحتوى;
    دع المولد: متغير متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_المحتوى));
    ألحق_بايتات_نص(&متغير المولد, "\n// SultanC propagation expansion (frontend/desugar/propagation.sn)\n");
    دع بداية_المولد: طبيعي = الطول(المولد) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المواضع) مثل طبيعي)) {
        ألحق_بايتات_نص(&متغير المولد, «عرف »);
        ألحق_اسما_مخفيا_لانتشار(&متغير المولد, ف, «__عبارة»);
        ألحق_بايتات_نص(&متغير المولد, "(): فراغ {\n");
        دع البداية: طبيعي = الطول(المولد) مثل طبيعي;
        ألحق_نص_موضع_انتشار(&متغير المولد, &المواضع[ف], ف);
        دع النهاية: طبيعي = الطول(المولد) مثل طبيعي;
        ألحق_بايتات_نص(&متغير المولد, "\n}\n");
        دع موضع_البداية: موضع = { المصدر: (*المصدر).المعرف, البايت: البداية };
        دع موضع_النهاية: موضع = { المصدر: (*المصدر).المعرف, البايت: النهاية };
        أضف_إحالة_نص_مولد(
            سياق_المصادر, نطاق_بين(موضع_البداية, موضع_النهاية), المواضع[ف].العلامة
        );
        ف := ف + 1;
    }

    دع مرجع_الاسم: &نص = &(*المصدر).الاسم;
    دع الممدد: مصدر = مصدر_جديد(
        (*المصدر).المعرف, انسخ_نص(مرجع_الاسم), من_بايتات(&المولد)
    );
    دع الرموز_المولدة: متغير متجه رمز_مصدر = [];
    طابق حلل_معجميا(&الممدد) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { أرجع خطأ; }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(السلسلة.الرموز) مثل طبيعي)) {
            لو (السلسلة.الرموز[ر].النطاق.البداية.البايت >= بداية_المولد) {
                دع مرجع_الرمز: &رمز_مصدر = &السلسلة.الرموز[ر];
                ألحق(الرموز_المولدة, انسخ_مملوكا_رمز_مصدر(مرجع_الرمز));
            };
            ر := ر + 1;
        }
    };
    دع المولدة: متغير متجه عبارة = [];
    طابق حلل_الرموز_لهدف(&الممدد, &الرموز_المولدة, الهدف) مع
    | نتيجة_تحليل.شجرة(الوحدة) -> {
        دع ع_مولد: متغير طبيعي = 0;
        طالما (ع_مولد < (الطول(الوحدة.العناصر) مثل طبيعي)) {
            طابق الوحدة.العناصر[ع_مولد] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                طابق الدالة.الجسم مع
                | اختياري.موجود(الجسم) -> {
                    لو ((الطول(الجسم.العبارات) مثل طبيعي) != 1) { أرجع خطأ; };
                    دع مرجع_الصندوق: &صندوق عبارة = &الجسم.العبارات[0];
                    ألحق(المولدة, انسخ_مملوكا_عبارة(&(*(*مرجع_الصندوق))));
                }
                | اختياري.لا_شيء -> { أرجع خطأ; };
            }
            | _ -> { أرجع خطأ; };
            ع_مولد := ع_مولد + 1;
        }
    }
    | _ -> { أرجع خطأ; };
    لو ((الطول(المولدة) مثل طبيعي) != (الطول(المواضع) مثل طبيعي)) { أرجع خطأ; };

    دع الجديدة: متغير متجه عنصر_وحدة = [];
    دع التالي: متغير طبيعي = 0;
    ع := 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        دع مرجع_العنصر: &عنصر_وحدة = &(*الشجرة).العناصر[ع];
        دع العنصر: متغير عنصر_وحدة = انسخ_مملوكا_عنصر_وحدة(مرجع_العنصر);
        طابق *مرجع_العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            طابق الدالة.الجسم مع
            | اختياري.موجود(الجسم) -> {
                دع الجسم_الجديد: كتلة_عبارات = وسع_كتلة_انتشار(&الجسم, &المولدة, &متغير التالي);
                دع المعدلة: متغير تصريح_دالة = انسخ_مملوكا_تصريح_دالة(&الدالة);
                المعدلة.الجسم := اختياري.موجود(الجسم_الجديد);
                العنصر := عنصر_وحدة.دالة(المعدلة);
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ألحق(الجديدة, العنصر);
        ع := ع + 1;
    }
    لو (التالي != (الطول(المولدة) مثل طبيعي)) { أرجع خطأ; };
    (*الشجرة).العناصر := الجديدة;
    أرجع مدد_محتوى_مصدر_في_خريطة(سياق_المصادر, (*المصدر).المعرف, من_بايتات(&المولد));
}
