استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.literals;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.patterns;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.types.expression_types;
استورد المكتبة.نصوص.من_بايتات;

// Places the source leaves implicit, written out after the Type pass so that
// ownership flow (SSF), patterns and MSIR lowering see only explicit ones
// (docs/en/reference/ownership.md, "Implicit dereference and borrow"):
//
//   r.f                 with r: &T or &mutable T     (*r).f
//   r.f                 with r: &&T                  (*(*r)).f
//   println(t)          with a `&string` parameter   println(&t)
//   fill(&mutable v)    with a `mutable [] T` one     fill(&mutable v[..])
//
// The Type pass records each such expression (موضع_ضمني, by its span) while
// it types it with the rule: a field read through references, and a text
// argument for a `&string` parameter. The frontend then rebuilds the bodies
// that hold one and types them again; the rebuilt body has no implicit
// place left, so the second pass records none.
//
// Each inserted node has a span no source expression has. The first
// dereference spans the base and the `.` after it (`r.`); a further one, and
// the `&` of a borrowed argument, are empty spans (at the bytes after the
// base, and at the argument's start). Diagnostics about the place itself use
// the enclosing field or the argument, whose spans are the source's own.

عرف موضع_ضمني_عند(المواضع: &متجه موضع_ضمني, النطاق: نطاق): اختياري موضع_ضمني {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        إذا (نطاقان_متساويان((*المواضع)[ف].النطاق, النطاق)) {
            أرجع اختياري.موجود((*المواضع)[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The span of the dereference at level المستوى (from 1) of the base whose
// span is النطاق.
عرف نطاق_فك_ضمني(النطاق: نطاق, المستوى: طبيعي): نطاق {
    إذا (المستوى <= 1) {
        ليكن النهاية: موضع = {
            المصدر: النطاق.النهاية.المصدر,
            البايت: النطاق.النهاية.البايت + 1
        };
        أرجع نطاق_بين(النطاق.البداية, النهاية);
    };
    ليكن الموضع: موضع = {
        المصدر: النطاق.النهاية.المصدر,
        البايت: النطاق.النهاية.البايت + ((المستوى - 1) مثل ط32)
    };
    أرجع نطاق_بين(الموضع, الموضع);
}

// The expression as the source wrote it stands for: its dereferences, its
// borrow, or the writable view of all of a vector that `&mutable v` is where
// a `mutable [] T` is expected (`&mutable v[..]`, the slice spanning the
// empty span after v).
عرف لف_موضعا_ضمنيا(التعبير: تعبير, الموضع: موضع_ضمني, العدد: &متغير طبيعي): تعبير {
    ليكن النطاق: نطاق = نطاق_تعبير(&التعبير);
    *العدد := *العدد + 1;
    إذا (الموضع.الصنف == 2) {
        طابق التعبير مع
        | تعبير.أحادي(س, العامل, صندوق_الداخل) -> {
            ليكن نطاق_الداخل: نطاق = نطاق_تعبير(&(*صندوق_الداخل));
            ليكن نطاق_المقطع: نطاق = نطاق_بين(نطاق_الداخل.النهاية, نطاق_الداخل.النهاية);
            ليكن بلا_أدنى: اختياري صندوق تعبير = اختياري.لا_شيء();
            ليكن بلا_أعلى: اختياري صندوق تعبير = اختياري.لا_شيء();
            ليكن المقطع: تعبير = تعبير.مقطع(نطاق_المقطع, صندوق_الداخل, بلا_أدنى, بلا_أعلى);
            ليكن الصندوق: صندوق تعبير = صندوق المقطع;
            أرجع تعبير.أحادي(س, العامل, الصندوق);
        }
        | _ -> { أرجع التعبير; };
    };
    إذا (الموضع.الصنف == 1) {
        ليكن البداية: نطاق = نطاق_بين(النطاق.البداية, النطاق.البداية);
        ليكن الصندوق: صندوق تعبير = صندوق التعبير;
        أرجع تعبير.أحادي(البداية, عامل_أحادي.عنوان(), الصندوق);
    };
    أرجع لف_فكا_ضمنيا(التعبير, النطاق, 1, الموضع.العدد);
}

// التعبير under the dereferences from المستوى to الأخير of the base whose
// span is النطاق.
عرف لف_فكا_ضمنيا(التعبير: تعبير, النطاق: نطاق, المستوى: طبيعي, الأخير: طبيعي): تعبير {
    إذا (المستوى > الأخير) { أرجع التعبير; };
    ليكن الصندوق: صندوق تعبير = صندوق التعبير;
    ليكن الفك: تعبير = تعبير.فك_موضع(نطاق_فك_ضمني(النطاق, المستوى), الصندوق);
    أرجع لف_فكا_ضمنيا(الفك, النطاق, المستوى + 1, الأخير);
}

عرف اكتب_صندوق_تعبير_ضمنيا(
    القيمة: &صندوق تعبير,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): صندوق تعبير {
    ليكن الداخل: تعبير = اكتب_تعبيرا_ضمنيا(&(*(*القيمة)), المواضع, العدد);
    ليكن الصندوق: صندوق تعبير = صندوق الداخل;
    أرجع الصندوق;
}

عرف اكتب_حد_مقطع_ضمنيا(
    القيمة: &اختياري صندوق تعبير,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): اختياري صندوق تعبير {
    طابق *القيمة مع
    | اختياري.موجود(الحد) -> { أرجع اختياري.موجود(اكتب_صندوق_تعبير_ضمنيا(&الحد, المواضع, العدد)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف اكتب_متجه_تعبير_ضمنيا(
    القيمة: &متجه تعبير,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): متجه تعبير {
    ليكن الناتج: متغير متجه تعبير = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, اكتب_تعبيرا_ضمنيا(&(*القيمة)[ف], المواضع, العدد));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اكتب_حقول_تهيئة_ضمنيا(
    القيمة: &متجه حقل_تهيئة,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): متجه حقل_تهيئة {
    ليكن الناتج: متغير متجه حقل_تهيئة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ليكن الحقل: حقل_تهيئة = {
            الاسم: (*القيمة)[ف].الاسم,
            القيمة: اكتب_تعبيرا_ضمنيا(&(*القيمة)[ف].القيمة, المواضع, العدد)
        };
        ألحق(الناتج, الحقل);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// An owned copy of التعبير with its implicit places written out.
عام عرف اكتب_تعبيرا_ضمنيا(
    التعبير: &تعبير,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): تعبير {
    ليكن المعاد: تعبير;
    طابق *التعبير مع
    | تعبير.حرفي(ح0, ح1) -> { المعاد := تعبير.حرفي(ح0, انسخ_مملوكا_حرفي(&ح1)); }
    | تعبير.اسم(ح0, ح1) -> { المعاد := تعبير.اسم(ح0, ح1); }
    | تعبير.حقل(ح0, ح1, ح2) -> { المعاد := تعبير.حقل(ح0, اكتب_صندوق_تعبير_ضمنيا(&ح1, المواضع, العدد), ح2); }
    | تعبير.فهرس(ح0, ح1, ح2) -> {
        المعاد := تعبير.فهرس(
            ح0, اكتب_صندوق_تعبير_ضمنيا(&ح1, المواضع, العدد), اكتب_صندوق_تعبير_ضمنيا(&ح2, المواضع, العدد)
        );
    }
    | تعبير.مقطع(ح0, ح1, ح2, ح3) -> {
        المعاد := تعبير.مقطع(
            ح0, اكتب_صندوق_تعبير_ضمنيا(&ح1, المواضع, العدد), اكتب_حد_مقطع_ضمنيا(&ح2, المواضع, العدد),
            اكتب_حد_مقطع_ضمنيا(&ح3, المواضع, العدد)
        );
    }
    | تعبير.فك_موضع(ح0, ح1) -> { المعاد := تعبير.فك_موضع(ح0, اكتب_صندوق_تعبير_ضمنيا(&ح1, المواضع, العدد)); }
    | تعبير.ثنائي(ح0, ح1, ح2, ح3) -> {
        المعاد := تعبير.ثنائي(
            ح0, ح1, اكتب_صندوق_تعبير_ضمنيا(&ح2, المواضع, العدد), اكتب_صندوق_تعبير_ضمنيا(&ح3, المواضع, العدد)
        );
    }
    | تعبير.أحادي(ح0, ح1, ح2) -> { المعاد := تعبير.أحادي(ح0, ح1, اكتب_صندوق_تعبير_ضمنيا(&ح2, المواضع, العدد)); }
    | تعبير.استدعاء(ح0, ح1, ح2) -> {
        المعاد := تعبير.استدعاء(
            ح0, اكتب_صندوق_تعبير_ضمنيا(&ح1, المواضع, العدد), اكتب_متجه_تعبير_ضمنيا(&ح2, المواضع, العدد)
        );
    }
    | تعبير.تحويل(ح0, ح1, ح2) -> {
        المعاد := تعبير.تحويل(ح0, اكتب_صندوق_تعبير_ضمنيا(&ح1, المواضع, العدد), انسخ_مملوكا__صندوق_نوع_ضمني(&ح2));
    }
    | تعبير.وقت_الترجمة(ح0, ح1) -> { المعاد := تعبير.وقت_الترجمة(ح0, اكتب_صندوق_تعبير_ضمنيا(&ح1, المواضع, العدد)); }
    | تعبير.تسلسل_وقت_الترجمة(ح0, ح1) -> { المعاد := تعبير.تسلسل_وقت_الترجمة(ح0, اكتب_متجه_تعبير_ضمنيا(&ح1, المواضع, العدد)); }
    | تعبير.إغلاق(ح0, ح1, ح2, ح3) -> {
        المعاد := تعبير.إغلاق(
            ح0, انسخ_مملوكا_متجه_معامل_إغلاق(&ح1), انسخ_مملوكا__صندوق_نوع_ضمني(&ح2),
            اكتب_صندوق_تعبير_ضمنيا(&ح3, المواضع, العدد)
        );
    }
    | تعبير.حرفي_متجه(ح0, ح1) -> { المعاد := تعبير.حرفي_متجه(ح0, اكتب_متجه_تعبير_ضمنيا(&ح1, المواضع, العدد)); }
    | تعبير.حرفي_سجل(ح0, ح1) -> { المعاد := تعبير.حرفي_سجل(ح0, اكتب_حقول_تهيئة_ضمنيا(&ح1, المواضع, العدد)); }
    | تعبير.حرفي_صف(ح0, ح1) -> { المعاد := تعبير.حرفي_صف(ح0, اكتب_متجه_تعبير_ضمنيا(&ح1, المواضع, العدد)); }
    | تعبير.حجج_نوع(ح0, ح1, ح2) -> {
        // The wrapper shares its callee's span: the callee is never an
        // implicit place, so only the wrapper is looked up.
        المعاد := تعبير.حجج_نوع(ح0, انسخ_مملوكا__صندوق_تعبير_ضمني(&ح1), انسخ_مملوكا_متجه_نوع_تركيبي(&ح2));
    }
    | تعبير.مطابقة(ح0, ح1) -> {
        ليكن القيم: متغير متجه اختياري تعبير = [];
        ليكن ق: متغير طبيعي = 0;
        طالما (ق < (الطول((*ح1).القيم) مثل طبيعي)) {
            ألحق(القيم, اكتب_اختياري_تعبير_ضمنيا(&(*ح1).القيم[ق], المواضع, العدد));
            ق := ق + 1;
        }
        ليكن المكتوبة: مطابقة_تعبيرية = {
            المميز: اكتب_تعبيرا_ضمنيا(&(*ح1).المميز, المواضع, العدد),
            الأذرع: اكتب_أذرع_ضمنيا(&(*ح1).الأذرع, المواضع, العدد),
            القيم: القيم,
            من_إذا: (*ح1).من_إذا
        };
        ليكن الصندوق: صندوق مطابقة_تعبيرية = صندوق المكتوبة;
        المعاد := تعبير.مطابقة(ح0, الصندوق);
    };
    طابق موضع_ضمني_عند(المواضع, نطاق_تعبير(التعبير)) مع
    | اختياري.موجود(الموضع) -> { أرجع لف_موضعا_ضمنيا(المعاد, الموضع, العدد); }
    | اختياري.لا_شيء -> { أرجع المعاد; };
}

عرف انسخ_مملوكا__صندوق_تعبير_ضمني(القيمة: &صندوق تعبير): صندوق تعبير {
    ليكن الداخل: تعبير = انسخ_مملوكا_تعبير(&(*(*القيمة)));
    ليكن الصندوق: صندوق تعبير = صندوق الداخل;
    أرجع الصندوق;
}

عرف انسخ_مملوكا__صندوق_نوع_ضمني(القيمة: &صندوق نوع_تركيبي): صندوق نوع_تركيبي {
    ليكن الداخل: نوع_تركيبي = انسخ_مملوكا_نوع_تركيبي(&(*(*القيمة)));
    ليكن الصندوق: صندوق نوع_تركيبي = صندوق الداخل;
    أرجع الصندوق;
}

عرف اكتب_كتلة_ضمنيا(
    القيمة: &كتلة_عبارات,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): كتلة_عبارات {
    ليكن الناتج: كتلة_عبارات = {
        النطاق: (*القيمة).النطاق,
        العبارات: اكتب_عبارات_ضمنيا(&(*القيمة).العبارات, المواضع, العدد)
    };
    أرجع الناتج;
}

عرف اكتب_عبارات_ضمنيا(
    القيمة: &متجه صندوق عبارة,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): متجه صندوق عبارة {
    ليكن الناتج: متغير متجه صندوق عبارة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, اكتب_صندوق_عبارة_ضمنيا(&(*القيمة)[ف], المواضع, العدد));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اكتب_صندوق_عبارة_ضمنيا(
    القيمة: &صندوق عبارة,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): صندوق عبارة {
    ليكن الداخل: عبارة = اكتب_عبارة_ضمنيا(&(*(*القيمة)), المواضع, العدد);
    ليكن الصندوق: صندوق عبارة = صندوق الداخل;
    أرجع الصندوق;
}

عرف اكتب_اختياري_تعبير_ضمنيا(
    القيمة: &اختياري تعبير,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): اختياري تعبير {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(اكتب_تعبيرا_ضمنيا(&الداخل, المواضع, العدد)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف اكتب_اختياري_كتلة_ضمنيا(
    القيمة: &اختياري كتلة_عبارات,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): اختياري كتلة_عبارات {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(اكتب_كتلة_ضمنيا(&الداخل, المواضع, العدد)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف اكتب_أذرع_ضمنيا(
    القيمة: &متجه ذراع_مطابقة,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): متجه ذراع_مطابقة {
    ليكن الناتج: متغير متجه ذراع_مطابقة = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ليكن الذراع: ذراع_مطابقة = {
            النمط: انسخ_مملوكا_نمط(&(*القيمة)[ف].النمط),
            الحارس: اكتب_اختياري_تعبير_ضمنيا(&(*القيمة)[ف].الحارس, المواضع, العدد),
            الجسم: اكتب_كتلة_ضمنيا(&(*القيمة)[ف].الجسم, المواضع, العدد),
            نوع_ليكن: انسخ_مملوكا_نوع_ليكن_ذراع(&(*القيمة)[ف])
        };
        ألحق(الناتج, الذراع);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اكتب_عبارة_ضمنيا(
    القيمة: &عبارة,
    المواضع: &متجه موضع_ضمني,
    العدد: &متغير طبيعي
): عبارة {
    طابق *القيمة مع
    | عبارة.تصريح_متغير(ح0, ح1, ح2) -> { أرجع عبارة.تصريح_متغير(ح0, ح1, انسخ_مملوكا_نوع_تركيبي(&ح2)); }
    | عبارة.تهيئة_سجل(ح0, ح1, ح2) -> {
        أرجع عبارة.تهيئة_سجل(ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), اكتب_حقول_تهيئة_ضمنيا(&ح2, المواضع, العدد));
    }
    | عبارة.تهيئة_صف(ح0, ح1, ح2) -> {
        أرجع عبارة.تهيئة_صف(ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), اكتب_متجه_تعبير_ضمنيا(&ح2, المواضع, العدد));
    }
    | عبارة.تهيئة_متجه(ح0, ح1, ح2) -> {
        أرجع عبارة.تهيئة_متجه(ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), اكتب_متجه_تعبير_ضمنيا(&ح2, المواضع, العدد));
    }
    | عبارة.تهيئة_نص(ح0, ح1, ح2) -> {
        أرجع عبارة.تهيئة_نص(ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), انسخ_بايتات(&ح2));
    }
    | عبارة.تهيئة_صندوق(ح0, ح1, ح2) -> {
        أرجع عبارة.تهيئة_صندوق(ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), اكتب_تعبيرا_ضمنيا(&ح2, المواضع, العدد));
    }
    | عبارة.نسخ(ح0, ح1, ح2) -> {
        أرجع عبارة.نسخ(ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), اكتب_تعبيرا_ضمنيا(&ح2, المواضع, العدد));
    }
    | عبارة.استدعاء(ح0, ح1) -> { أرجع عبارة.استدعاء(ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد)); }
    | عبارة.طالما(ح0, ح1, ح2) -> {
        أرجع عبارة.طالما(ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), اكتب_كتلة_ضمنيا(&ح2, المواضع, العدد));
    }
    | عبارة.لكل(ح0, ح1, ح2, ح3, ح4) -> {
        أرجع عبارة.لكل(
            ح0, اكتب_عبارات_ضمنيا(&ح1, المواضع, العدد), اكتب_تعبيرا_ضمنيا(&ح2, المواضع, العدد),
            اكتب_صندوق_عبارة_ضمنيا(&ح3, المواضع, العدد), اكتب_كتلة_ضمنيا(&ح4, المواضع, العدد)
        );
    }
    | عبارة.اخرج_من_حلقة(ح0) -> { أرجع عبارة.اخرج_من_حلقة(ح0); }
    | عبارة.تابع_حلقة(ح0) -> { أرجع عبارة.تابع_حلقة(ح0); }
    | عبارة.إذا(ح0, ح1, ح2, ح3) -> {
        أرجع عبارة.إذا(
            ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), اكتب_كتلة_ضمنيا(&ح2, المواضع, العدد),
            اكتب_اختياري_كتلة_ضمنيا(&ح3, المواضع, العدد)
        );
    }
    | عبارة.طابق(ح0, ح1, ح2) -> {
        أرجع عبارة.طابق(ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), اكتب_أذرع_ضمنيا(&ح2, المواضع, العدد));
    }
    | عبارة.أرجع(ح0, ح1) -> { أرجع عبارة.أرجع(ح0, اكتب_اختياري_تعبير_ضمنيا(&ح1, المواضع, العدد)); }
    | عبارة.تجميع(ح0, ح1) -> { أرجع عبارة.تجميع(ح0, انسخ_بايتات(&ح1)); }
    | عبارة.غير_آمن(ح0, ح1) -> { أرجع عبارة.غير_آمن(ح0, اكتب_كتلة_ضمنيا(&ح1, المواضع, العدد)); }
    | عبارة.وقت_الترجمة(ح0, ح1) -> { أرجع عبارة.وقت_الترجمة(ح0, اكتب_كتلة_ضمنيا(&ح1, المواضع, العدد)); }
    | عبارة.إسناد_وقت_الترجمة(ح0, ح1, ح2, ح3) -> {
        أرجع عبارة.إسناد_وقت_الترجمة(
            ح0, اكتب_تعبيرا_ضمنيا(&ح1, المواضع, العدد), اكتب_كتلة_ضمنيا(&ح2, المواضع, العدد),
            اكتب_تعبيرا_ضمنيا(&ح3, المواضع, العدد)
        );
    };
}

// Whether a recorded place lies in the source الوحدة was parsed from.
عرف في_مصدر_الوحدة(المواضع: &متجه موضع_ضمني, المصدر: طبيعي): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        إذا (((*المواضع)[ف].النطاق.البداية.المصدر مثل طبيعي) == المصدر) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Rebuilds every function body of الوحدة that holds a recorded implicit
// place, with it written out. The result is how many places were written.
عام عرف اكتب_المواضع_الضمنية_في_وحدة(
    الوحدة: &متغير وحدة_مصدر,
    المواضع: &متجه موضع_ضمني
): طبيعي {
    إذا (!في_مصدر_الوحدة(المواضع, (*الوحدة).معرف_المصدر)) { أرجع 0; };
    ليكن الكلي: متغير طبيعي = 0;
    ليكن ي: متغير طبيعي = 0;
    طالما (ي < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
        ليكن الجديد: متغير اختياري تصريح_دالة = اختياري.لا_شيء();
        طابق (*الوحدة).العناصر[ي] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            طابق الدالة.الجسم مع
            | اختياري.موجود(الجسم) -> {
                ليكن العدد: متغير طبيعي = 0;
                ليكن المكتوب: كتلة_عبارات = اكتب_كتلة_ضمنيا(&الجسم, المواضع, &متغير العدد);
                إذا (العدد > 0) {
                    ليكن النسخة: متغير تصريح_دالة = انسخ_مملوكا_تصريح_دالة(&الدالة);
                    النسخة.الجسم := اختياري.موجود(المكتوب);
                    الجديد := اختياري.موجود(النسخة);
                    الكلي := الكلي + العدد;
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        طابق الجديد مع
        | اختياري.موجود(الدالة_الجديدة) -> { (*الوحدة).العناصر[ي] := عنصر_وحدة.دالة(الدالة_الجديدة); }
        | اختياري.لا_شيء -> { };
        ي := ي + 1;
    }
    أرجع الكلي;
}
