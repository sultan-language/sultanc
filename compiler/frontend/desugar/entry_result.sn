// `main` returning `نتيجة …, فشل` (docs/en/reference/errors.md). In the root module, an
// entry function (الرئيسية / main) without parameters whose result is written
// `نتيجة T, E` keeps its body under a hidden name, and the entry becomes
//
//   def main(): T {
//       match <hidden>() with
//       | result.ok(n) -> { return n; }
//       | result.err(f) -> { report the error; return 1; };
//   }
//
// so every backend and the interpreter see an ordinary entry with an exit
// status (T must be one, as for any entry), and the error goes through the
// one runtime-failure path of a program (std.process.failure): the iSpeak
// frame "the program ended with an error" in the program's language, the
// error's صف_فشل text under it, exit status 1. The error is the std فشل
// (E must be it). The expansion is source text appended after the unit's own
// text, like decorator and propagation expansion; a diagnostic inside it
// (T not an exit status, E not فشل) is reported at the written result type.

عرف ألحق_نطاق_مصدر_لنقطة_دخول(الناتج: &متغير متجه ط8, الأصل: &متجه ط8, النطاق: نطاق): فراغ {
    دع ف: متغير طبيعي = النطاق.البداية.البايت;
    طالما (ف < (النطاق.النهاية.البايت مثل طبيعي) && ف < (الطول(*الأصل) مثل طبيعي)) {
        ألحق(*الناتج, (*الأصل)[ف]);
        ف := ف + 1;
    }
}

عرف انسخ_استيراد_مولد(القيمة: &استيراد): استيراد {
    طابق *القيمة مع
    | استيراد.انتقائي(س, المسار, الأسماء) -> {
        أرجع استيراد.انتقائي(س, انسخ_مملوكا_متجه_اسم(&المسار), انسخ_مملوكا_متجه_اسم(&الأسماء));
    }
    | استيراد.اسم(س, المسار, البديل) -> {
        أرجع استيراد.اسم(س, انسخ_مملوكا_متجه_اسم(&المسار), البديل);
    }
    | استيراد.نص(س, البايتات, البديل) -> {
        أرجع استيراد.نص(س, انسخ_بايتات(&البايتات), البديل);
    };
}

عرف هل_اسم_نقطة_دخول(المحتوى: &نص, الاسم: &اسم): منطقي {
    دع البداية: طبيعي = (*الاسم).النطاق.البداية.البايت;
    دع النهاية: طبيعي = (*الاسم).النطاق.النهاية.البايت;
    أرجع تطابق_هوية_معرف_وشريحة(المحتوى, البداية, النهاية, «الرئيسية»)
        || تطابق_هوية_معرف_وشريحة(المحتوى, البداية, النهاية, «main»);
}

// The index of the entry function with a written result type, if any.
عرف موضع_نقطة_دخول_بنتيجة(الشجرة: &وحدة_مصدر, المحتوى: &نص): اختياري طبيعي {
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            إذا (هل_اسم_نقطة_دخول(المحتوى, &الدالة.الاسم)
                && (الطول(الدالة.المعاملات) مثل طبيعي) == 0
                && (الطول(الدالة.معاملات_النوع) مثل طبيعي) == 0) {
                طابق الدالة.الجسم مع
                | اختياري.موجود(_) -> {
                    طابق الدالة.الناتج مع
                    | نوع_تركيبي.نتيجة(_, _, _) -> { أرجع اختياري.موجود(ع); }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | _ -> { };
        ع := ع + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Expands the entry of a root unit when it returns a result. Returns خطأ
// only when the generated text fails to lex or parse (a compiler fault).
عام عرف وسع_نقطة_دخول_بنتيجة(
    الشجرة: &متغير وحدة_مصدر,
    سياق_المصادر: &متغير خريطة_مصادر,
    المصدر: &مصدر,
    الهدف: &اختياري واصف_هدف
): منطقي {
    طابق موضع_نقطة_دخول_بنتيجة(الشجرة, &(*المصدر).المحتوى) مع
    | اختياري.موجود(الموضع) -> {
        طابق (*الشجرة).العناصر[الموضع] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            دع النسخة: تصريح_دالة = انسخ_مملوكا_تصريح_دالة(&الدالة);
            أرجع وسع_دالة_نقطة_دخول(الشجرة, سياق_المصادر, المصدر, الهدف, الموضع, النسخة);
        }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع صواب; };
}

عرف وسع_دالة_نقطة_دخول(
    الشجرة: &متغير وحدة_مصدر,
    سياق_المصادر: &متغير خريطة_مصادر,
    المصدر: &مصدر,
    الهدف: &اختياري واصف_هدف,
    الموضع: طبيعي,
    النسخة: تصريح_دالة
): منطقي {
    دع الأصلية: متغير تصريح_دالة = النسخة;
    دع نوع_النجاح: متغير نطاق = نطاق_نوع_تركيبي(&الأصلية.الناتج);
    طابق الأصلية.الناتج مع
    | نوع_تركيبي.نتيجة(_, النجاح, _) -> { نوع_النجاح := نطاق_نوع_تركيبي(&(*النجاح)); }
    | _ -> { };

    دع مرجع_المحتوى: &نص = &(*المصدر).المحتوى;
    دع الأصل: متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_المحتوى));
    دع المولد: متغير متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_المحتوى));
    ألحق_بايتات_نص(&متغير المولد, "\n// SultanC entry expansion (frontend/desugar/entry_result.sn)\n// ");
    دع بداية_المخفي: طبيعي = الطول(المولد) مثل طبيعي;
    ألحق_بايتات_نص(&متغير المولد, «نقطة_دخول__»);
    ألحق_نطاق_مصدر_لنقطة_دخول(&متغير المولد, &الأصل, الأصلية.الاسم.النطاق);
    دع نهاية_المخفي: طبيعي = الطول(المولد) مثل طبيعي;
    ألحق_بايتات_نص(&متغير المولد, "\n");
    دع بداية_المولد: طبيعي = الطول(المولد) مثل طبيعي;
    ألحق_بايتات_نص(&متغير المولد, "استورد std.process.failure;\n");
    ألحق_بايتات_نص(&متغير المولد, «عرف »);
    ألحق_نطاق_مصدر_لنقطة_دخول(&متغير المولد, &الأصل, الأصلية.الاسم.النطاق);
    ألحق_بايتات_نص(&متغير المولد, «(): »);
    ألحق_نطاق_مصدر_لنقطة_دخول(&متغير المولد, &الأصل, نوع_النجاح);
    ألحق_بايتات_نص(&متغير المولد, " {\n    طابق نقطة_دخول__");
    ألحق_نطاق_مصدر_لنقطة_دخول(&متغير المولد, &الأصل, الأصلية.الاسم.النطاق);
    ألحق_بايتات_نص(&متغير المولد, "() مع\n    | نتيجة.نجح(نقطة_دخول__قيمة) -> { أرجع نقطة_دخول__قيمة; }\n");
    ألحق_بايتات_نص(&متغير المولد, "    | نتيجة.خطأ(نقطة_دخول__فشل) -> {\n        أبلغ_عن_خطأ_نقطة_الدخول(&نقطة_دخول__فشل);\n        أرجع 1;\n    };\n}\n");
    دع نهاية_المولد: طبيعي = الطول(المولد) مثل طبيعي;

    دع معرف: طبيعي = (*المصدر).المعرف;
    دع موضع_بداية_المولد: موضع = { المصدر: (معرف مثل ط32), البايت: (بداية_المولد مثل ط32) };
    دع موضع_نهاية_المولد: موضع = { المصدر: (معرف مثل ط32), البايت: (نهاية_المولد مثل ط32) };
    أضف_إحالة_نص_مولد(
        سياق_المصادر, نطاق_بين(موضع_بداية_المولد, موضع_نهاية_المولد),
        نطاق_نوع_تركيبي(&الأصلية.الناتج)
    );

    دع مرجع_الاسم: &نص = &(*المصدر).الاسم;
    دع الممدد: مصدر = مصدر_جديد(معرف, انسخ_نص(مرجع_الاسم), من_بايتات(&المولد));
    دع الرموز_المولدة: متغير متجه رمز_مصدر = [];
    طابق حلل_معجميا(&الممدد) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { أرجع خطأ; }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(السلسلة.الرموز) مثل طبيعي)) {
            إذا ((السلسلة.الرموز[ر].النطاق.البداية.البايت مثل طبيعي) >= بداية_المولد) {
                دع مرجع_الرمز: &رمز_مصدر = &السلسلة.الرموز[ر];
                ألحق(الرموز_المولدة, انسخ_مملوكا_رمز_مصدر(مرجع_الرمز));
            };
            ر := ر + 1;
        }
    };
    طابق حلل_الرموز_لهدف(&الممدد, &الرموز_المولدة, الهدف) مع
    | نتيجة_تحليل.شجرة(الوحدة) -> {
        إذا ((الطول(الوحدة.العناصر) مثل طبيعي) != 1
            || (الطول(الوحدة.الاستيرادات) مثل طبيعي) != 1) {
            أرجع خطأ;
        };
        دع مرجع_الاستيراد: &استيراد = &الوحدة.الاستيرادات[0];
        ألحق((*الشجرة).الاستيرادات, انسخ_استيراد_مولد(مرجع_الاستيراد));
        دع موضع_الاسم_البداية: موضع = { المصدر: (معرف مثل ط32), البايت: (بداية_المخفي مثل ط32) };
        دع موضع_الاسم_النهاية: موضع = { المصدر: (معرف مثل ط32), البايت: (نهاية_المخفي مثل ط32) };
        دع اسم_مخفي: اسم = {
            النطاق: نطاق_بين(موضع_الاسم_البداية, موضع_الاسم_النهاية),
            الصنف: صنف_اسم_تركيبي.عادي()
        };
        دع العلنية: منطقي = الأصلية.علني;
        دع البدائل: متغير متجه اسم = [];
        بدّل(الأصلية.الأسماء_البديلة, البدائل);
        الأصلية.الاسم := اسم_مخفي;
        الأصلية.علني := خطأ;
        طابق الوحدة.العناصر[0] مع
        | عنصر_وحدة.دالة(المغلفة) -> {
            دع البديلة: متغير تصريح_دالة = انسخ_مملوكا_تصريح_دالة(&المغلفة);
            البديلة.علني := العلنية;
            بدّل(البديلة.الأسماء_البديلة, البدائل);
            (*الشجرة).العناصر[الموضع] := عنصر_وحدة.دالة(الأصلية);
            ألحق((*الشجرة).العناصر, عنصر_وحدة.دالة(البديلة));
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
    أرجع مدد_محتوى_مصدر_في_خريطة(سياق_المصادر, معرف, من_بايتات(&المولد));
}
