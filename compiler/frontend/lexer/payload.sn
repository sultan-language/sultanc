استورد std.text.from_bytes;
// القيم المتغيرة التي ترافق الرموز غير الثابتة.
عام نوع قيمة_عدد_صحيح_رمز =
    | موقع بنوع عدد
    | طبيعي بنوع طبيعي
;

عام نوع حمولة_رمز =
    | بلا
    | فهرس بنوع عدد
    | عدد_صحيح بنوع قيمة_عدد_صحيح_رمز
    | بايتات_نص بنوع متجه ط8
    | محرف بنوع ط32
    | منطق بنوع منطقي
;

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_حمولة_رمز(القيمة: &حمولة_رمز): حمولة_رمز {
    طابق *القيمة مع
    | حمولة_رمز.بلا -> { أرجع حمولة_رمز.بلا(); }
    | حمولة_رمز.فهرس(ح0) -> { أرجع حمولة_رمز.فهرس(ح0); }
    | حمولة_رمز.عدد_صحيح(ح0) -> { أرجع حمولة_رمز.عدد_صحيح(ح0); }
    | حمولة_رمز.بايتات_نص(ح0) -> { أرجع حمولة_رمز.بايتات_نص(انسخ_بايتات(&ح0)); }
    | حمولة_رمز.محرف(ح0) -> { أرجع حمولة_رمز.محرف(ح0); }
    | حمولة_رمز.منطق(ح0) -> { أرجع حمولة_رمز.منطق(ح0); };
}
