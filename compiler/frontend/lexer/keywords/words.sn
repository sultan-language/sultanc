استورد compiler.frontend.lexer.keywords.matching;
استورد compiler.frontend.lexer.keywords.keyword_registry;

// واجهة صغيرة مستقرة فوق السجل المولد؛ لا تملك أي تهجئة keyword بنفسها.
عام عرف الكلمة_المحجوزة(
    النص: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع
): مطابقة_كلمة {
    أرجع كلمة_مسجلة(النص, البداية, النهاية);
}
