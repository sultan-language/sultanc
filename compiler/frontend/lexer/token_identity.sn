    }
    | رمز.معقوف_يمين -> {
        أرجع «}»;
    }
    | رمز.أو_حصري -> {
        أرجع «^»;
    }
    | رمز.نقطة -> {
        أرجع «.»;
    }
    | رمز.فاصلة -> {
        أرجع «,»;
    }
    | رمز.فاصلة_منقوطة -> {
        أرجع «;»;
    }
    | رمز.إسناد -> {
        أرجع «:=»;
    }
    | رمز.نقطتان -> {
        أرجع «:»;
    }
    | رمز.سهم_يمين -> {
        أرجع «->»;
    }
    | رمز.قوس_يسار -> {
        أرجع «(»;
    }
    | رمز.قوس_يمين -> {
        أرجع «)»;
    }
    | رمز.قوس_مربع_يسار -> {
        أرجع «[»;
    }
    | رمز.قوس_مربع_يمين -> {
        أرجع «]»;
    }
    | رمز.معرف -> {
        أرجع «معرف»;
    }
    | رمز.حرفي_عدد_صحيح -> {
        أرجع «حرفي عدد صحيح»;
    }
    | رمز.حرفي_عدد_عشري -> {
