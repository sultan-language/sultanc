استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.token_registry;

// التصنيف نفسه مشتق في token_registry.sn؛ هذه الواجهة تملك سياسة الاسم السياقي فقط.
عام عرف يصلح_اسما_سياقيا(القيمة: رمز): منطقي {
    لو (القيمة == رمز.معرف()) {
        أرجع صواب;
    };
    أرجع هل_كلمة_محجوزة(القيمة);
}
