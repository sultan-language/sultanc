استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.payload;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.lexer.cursor;
استورد compiler.frontend.lexer.result;
استورد std.chars.ascii;
استورد std.text.compare;
استورد std.encoding.utf8;
// مسح النصوص والمحارف فقط؛ ملكية البايتات المفكوكة تنتقل إلى حمولة الرمز.

نوع هروب_سداسي =
    | مفكوك بنوع (مؤشر_مسح, ط32)
    | غير_صالح_سداسي
;

عرف حلل_هروب_سداسي(
    المصدر: &مصدر,
    المؤشر: مؤشر_مسح,
    العدد: طبيعي
): هروب_سداسي {
    دع الحالي: متغير مؤشر_مسح = المؤشر;
    دع القيمة: متغير ط32 = 0;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        إذا (!متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
            أرجع هروب_سداسي.غير_صالح_سداسي();
        };
        دع الرقم: عدد = قيمة_سداسية(بايت_المصدر(المصدر, الحالي.البايت));
        إذا (الرقم < 0) {
            أرجع هروب_سداسي.غير_صالح_سداسي();
        };
        القيمة := (القيمة << 4) | (الرقم مثل ط32);
        الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
        الفهرس := الفهرس + 1;
    }
    أرجع هروب_سداسي.مفكوك(الحالي, القيمة);
}

نوع نتيجة_هروب =
    | هروب_صالح بنوع (مؤشر_مسح, متجه ط8)
    | هروب_مرفوض بنوع مؤشر_مسح
    | هروب_داخلي بنوع مؤشر_مسح
;

عرف امسح_هروبا(
    المصدر: &مصدر,
    المؤشر: مؤشر_مسح,
    البايتات: متجه ط8
): نتيجة_هروب {
    دع الحالي: متغير مؤشر_مسح = المؤشر;
    دع الناتج: متغير متجه ط8 = البايتات;
    إذا (!متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
        أرجع نتيجة_هروب.هروب_مرفوض(الحالي);
    };
    دع الهروب: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
    الحالي := تقدم_المؤشر(المصدر, الحالي, 1);

    إذا (الهروب == 0x6E) {
        ألحق(الناتج, 10);
        أرجع نتيجة_هروب.هروب_صالح(الحالي, الناتج);
    };
    إذا (الهروب == 0x72) {
        ألحق(الناتج, 13);
        أرجع نتيجة_هروب.هروب_صالح(الحالي, الناتج);
    };
    إذا (الهروب == 0x74) {
        ألحق(الناتج, 9);
        أرجع نتيجة_هروب.هروب_صالح(الحالي, الناتج);
    };
    إذا (الهروب == 0x5C) {
        ألحق(الناتج, 92);
        أرجع نتيجة_هروب.هروب_صالح(الحالي, الناتج);
    };
    إذا (الهروب == 0x22) {
        ألحق(الناتج, 34);
        أرجع نتيجة_هروب.هروب_صالح(الحالي, الناتج);
    };

    دع أرقام: متغير طبيعي = 0;
    إذا (الهروب == 120) {
        أرقام := 2;
    };
    إذا (الهروب == 117) {
        أرقام := 4;
    };
    إذا (الهروب == 85) {
        أرقام := 8;
    };
    إذا (أرقام == 0) {
        أرجع نتيجة_هروب.هروب_مرفوض(الحالي);
    };

    دع التحليل: هروب_سداسي = حلل_هروب_سداسي(المصدر, الحالي, أرقام);
    طابق التحليل مع
    | هروب_سداسي.غير_صالح_سداسي -> {
        أرجع نتيجة_هروب.هروب_مرفوض(الحالي);
    }
    | هروب_سداسي.مفكوك(بعد, القيمة) -> {
        // A surrogate or a value past U+10FFFF is the author's mistake, a
        // lexical error like any other bad escape, not a compiler fault.
        إذا (!صالح_كسلم_يونيكود(القيمة)) {
            أرجع نتيجة_هروب.هروب_مرفوض(بعد);
        };
        دع الترميز: نتيجة_ترميز_يوتيف8 = ألحق_محرف_يوتيف8(الناتج, القيمة);
        طابق الترميز مع
        | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> {
            أرجع نتيجة_هروب.هروب_مرفوض(بعد);
        }
        | نتيجة_ترميز_يوتيف8.مشفر(الجديدة) -> {
            أرجع نتيجة_هروب.هروب_صالح(بعد, الجديدة);
        };
    };
}

عام عرف امسح_نصا(
    المصدر: &مصدر,
    البداية: مؤشر_مسح,
    بعد_الفتح: مؤشر_مسح,
    مزخرف: منطقي
): نتيجة_رمز {
    دع أصل: مصدر = *المصدر;
    دع الحالي: متغير مؤشر_مسح = بعد_الفتح;
    دع البايتات: متغير متجه ط8 = [];

    إذا (مزخرف) {
        دع العمق: متغير طبيعي = 1;
        طالما (متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
            إذا (يطابق_عند(&أصل.المحتوى, الحالي.البايت, "«")) {
                إذا (العمق >= 256) {
                    أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
                };
                ألحق(البايتات, بايت_المصدر(المصدر, الحالي.البايت));
                ألحق(البايتات, بايت_المصدر(المصدر, الحالي.البايت + 1));
                الحالي := تقدم_المؤشر(المصدر, الحالي, 2);
                العمق := العمق + 1;
            }
            وإلا {
                إذا (يطابق_عند(&أصل.المحتوى, الحالي.البايت, "»")) {
                    العمق := العمق - 1;
                    إذا (العمق == 0) {
                        الحالي := تقدم_المؤشر(المصدر, الحالي, 2);
                        أرجع نجاح_بنص(
                            الحالي, رمز.حرفي_نص(), أصل.المعرف, البداية, الحالي, البايتات
                        );
                    };
                    ألحق(البايتات, بايت_المصدر(المصدر, الحالي.البايت));
                    ألحق(البايتات, بايت_المصدر(المصدر, الحالي.البايت + 1));
                    الحالي := تقدم_المؤشر(المصدر, الحالي, 2);
                }
                وإلا {
                    دع البايت: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
                    إذا (البايت >= 0x80) {
                        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, الحالي.البايت);
                        إذا (!المفكوك.صالح) {
                            أرجع رفض_مصنف(أصل.المعرف, الحالي, تقدم_المؤشر(المصدر, الحالي, 1), فئة_خطأ_معجمي.يوتيف8());
                        };
                        إذا (هل_تحكم_اتجاه_ثنائي(المفكوك.القيمة)) {
                            أرجع رفض_مصنف(أصل.المعرف, الحالي, تقدم_المؤشر(المصدر, الحالي, المفكوك.العرض), فئة_خطأ_معجمي.تحكم_اتجاه());
                        };
                        دع الفهرس: متغير طبيعي = 0;
                        طالما (الفهرس < المفكوك.العرض) {
                            دع مكان: طبيعي = الحالي.البايت + الفهرس;
                            ألحق(البايتات, بايت_المصدر(المصدر, مكان));
                            الفهرس := الفهرس + 1;
                        }
                        الحالي := تقدم_المؤشر(المصدر, الحالي, المفكوك.العرض);
                    }
                    وإلا {
                        ألحق(البايتات, البايت);
                        الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                    };
                };
            };
        }
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };

    دع انتهى: متغير منطقي = خطأ;
    طالما (!انتهى && متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
        إذا (بايت_المصدر(المصدر, الحالي.البايت) == 0x22) {
            الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
            انتهى := صواب;
        }
        وإلا {
            دع البايت: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
            // A quoted string ends on its line; any line break (LF, CRLF or
            // a lone CR, the rule of std.encoding.positions) leaves it open.
            إذا (البايت == 0x0A || البايت == 0x0D) {
                أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
            };
            إذا (البايت == 0x5C) {
                الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                دع الهروب: نتيجة_هروب = امسح_هروبا(المصدر, الحالي, البايتات);
                طابق الهروب مع
                | نتيجة_هروب.هروب_مرفوض(موضع_الخطأ) -> {
                    أرجع رفض_مصنف(أصل.المعرف, البداية, موضع_الخطأ, فئة_خطأ_معجمي.بناء());
                }
                | نتيجة_هروب.هروب_داخلي(موضع_الخطأ) -> {
                    أرجع رفض_مصنف(أصل.المعرف, البداية, موضع_الخطأ, فئة_خطأ_معجمي.داخلي());
                }
                | نتيجة_هروب.هروب_صالح(بعد, جديدة) -> {
                    الحالي := بعد;
                    البايتات := جديدة;
                };
            }
            وإلا {
                إذا (البايت >= 0x80) {
                    دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, الحالي.البايت);
                    إذا (!المفكوك.صالح) {
                        أرجع رفض_مصنف(أصل.المعرف, الحالي, تقدم_المؤشر(المصدر, الحالي, 1), فئة_خطأ_معجمي.يوتيف8());
                    };
                    إذا (هل_تحكم_اتجاه_ثنائي(المفكوك.القيمة)) {
                        أرجع رفض_مصنف(أصل.المعرف, الحالي, تقدم_المؤشر(المصدر, الحالي, المفكوك.العرض), فئة_خطأ_معجمي.تحكم_اتجاه());
                    };
                    دع الفهرس: متغير طبيعي = 0;
                    طالما (الفهرس < المفكوك.العرض) {
                        دع مكان: طبيعي = الحالي.البايت + الفهرس;
                        ألحق(البايتات, بايت_المصدر(المصدر, مكان));
                        الفهرس := الفهرس + 1;
                    }
                    الحالي := تقدم_المؤشر(المصدر, الحالي, المفكوك.العرض);
                }
                وإلا {
                    ألحق(البايتات, البايت);
                    الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                };
            };
        };
    }

    إذا (!انتهى) {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };
    أرجع نجاح_بنص(
        الحالي, رمز.حرفي_نص(), أصل.المعرف, البداية, الحالي, البايتات
    );
}

عام عرف امسح_محرفا(
    المصدر: &مصدر,
    البداية: مؤشر_مسح,
    بعد_الفتح: مؤشر_مسح
): نتيجة_رمز {
    دع أصل: مصدر = *المصدر;
    دع الحالي: متغير مؤشر_مسح = بعد_الفتح;
    إذا (!متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };
    دع القيمة: متغير ط32 = 0;

    إذا (بايت_المصدر(المصدر, الحالي.البايت) == 0x5C) {
        الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
        إذا (!متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
            أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
        };
        دع الهروب: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
        الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
        إذا (الهروب == 0x6E) {
            القيمة := 10;
        }
        وإلا {
            إذا (الهروب == 0x72) {
                القيمة := 13;
            }
            وإلا {
                إذا (الهروب == 0x74) {
                    القيمة := 9;
                }
                وإلا {
                    إذا (الهروب == 0x5C) {
                        القيمة := 92;
                    }
                    وإلا {
                        إذا (الهروب == 0x27) {
                            القيمة := 39;
                        }
                        وإلا {
                            دع أرقام: متغير طبيعي = 0;
                            إذا (الهروب == 120) {
                                أرقام := 2;
                            };
                            إذا (الهروب == 117) {
                                أرقام := 4;
                            };
                            إذا (الهروب == 85) {
                                أرقام := 8;
                            };
                            إذا (أرقام == 0) {
                                أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
                            };
                            دع التحليل: هروب_سداسي = حلل_هروب_سداسي(المصدر, الحالي, أرقام);
                            طابق التحليل مع
                            | هروب_سداسي.غير_صالح_سداسي -> {
                                أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
                            }
                            | هروب_سداسي.مفكوك(بعد, محرف) -> {
                                الحالي := بعد;
                                القيمة := محرف;
                            };
                        };
                    };
                };
            };
        };
    }
    وإلا {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, الحالي.البايت);
        إذا (!المفكوك.صالح) {
            أرجع رفض_مصنف(أصل.المعرف, الحالي, تقدم_المؤشر(المصدر, الحالي, 1), فئة_خطأ_معجمي.يوتيف8());
        };
        القيمة := المفكوك.القيمة;
        الحالي := تقدم_المؤشر(المصدر, الحالي, المفكوك.العرض);
    };

    إذا (!صالح_كسلم_يونيكود(القيمة)) {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };

    إذا (!متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };
    إذا (بايت_المصدر(المصدر, الحالي.البايت) != 0x27) {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };
    الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
    أرجع نجاح_بمحرف(
        الحالي, رمز.حرفي_حرف(), أصل.المعرف, البداية, الحالي, القيمة
    );
}
