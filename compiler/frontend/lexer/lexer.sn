استورد std.encoding.utf8;
// يمسح مصدرا واحدا إلى دفق رموز دلالي مع النطاقات والحمولات اللازمة.
عام نوع سلسلة_رموز = {
    الرموز: متجه رمز_مصدر
};

عام نوع نتيجة_تحليل_معجمي =
    | سلسلة بنوع سلسلة_رموز
    | مرفوض بنوع خطأ_معجمي
;

// The UTF-8 length of a non-ASCII separator at البايت, or 0. Separators are
// the Unicode White_Space characters outside ASCII (NBSP U+00A0, U+2000-200A,
// the line/paragraph separators U+2028/2029, U+202F, U+205F, U+3000), the
// byte-order mark U+FEFF, and the implicit direction marks LRM U+200E,
// RLM U+200F and ALM U+061C that editors insert in mixed Arabic/Latin text.
// The explicit embedding and isolate controls (U+202A-202E, U+2066-2069)
// are not separators: they can reorder how code reads, so they stay errors.
عرف طول_فاصل_يونيكود(المصدر: &مصدر, البايت: طبيعي): طبيعي {
    لو (!متاح_في_المصدر(المصدر, البايت, 2)) { أرجع 0; };
    دع أ: ط8 = بايت_المصدر(المصدر, البايت);
    دع ب: ط8 = بايت_المصدر(المصدر, البايت + 1);
    لو (أ == 0xC2 && ب == 0xA0) { أرجع 2; };
    لو (أ == 0xD8 && ب == 0x9C) { أرجع 2; };
    لو (!متاح_في_المصدر(المصدر, البايت, 3)) { أرجع 0; };
    دع ج: ط8 = بايت_المصدر(المصدر, البايت + 2);
    لو (أ == 0xE2 && ب == 0x80) {
        لو (ج <= 0x8A) { أرجع 3; };
        لو (ج == 0x8E || ج == 0x8F || ج == 0xA8 || ج == 0xA9 || ج == 0xAF) { أرجع 3; };
    };
    لو (أ == 0xE2 && ب == 0x81 && ج == 0x9F) { أرجع 3; };
    لو (أ == 0xE3 && ب == 0x80 && ج == 0x80) { أرجع 3; };
    لو (أ == 0xEF && ب == 0xBB && ج == 0xBF) { أرجع 3; };
    أرجع 0;
}

عرف تجاوز_الفواصل(المصدر: &مصدر, المؤشر: مؤشر_مسح): مؤشر_مسح {
    دع أصل: مصدر = *المصدر;
    دع الحالي: متغير مؤشر_مسح = المؤشر;
    دع أعد: متغير منطقي = صواب;
    طالما (أعد) {
        أعد := خطأ;
        دع في_فاصل: متغير منطقي = صواب;
        طالما (في_فاصل) {
            في_فاصل := خطأ;
            طالما (
                متاح_في_المصدر(المصدر, الحالي.البايت, 1)
                && فاصل_أسكي(بايت_المصدر(المصدر, الحالي.البايت))
            ) {
                الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
            }
            دع طول_اليونيكود: طبيعي = طول_فاصل_يونيكود(المصدر, الحالي.البايت);
            لو (طول_اليونيكود > 0) {
                الحالي := تقدم_المؤشر(المصدر, الحالي, طول_اليونيكود);
                في_فاصل := صواب;
            };
        }
        لو (يطابق_عند(&أصل.المحتوى, الحالي.البايت, «//»)) {
            أعد := صواب;
            طالما (
                متاح_في_المصدر(المصدر, الحالي.البايت, 1)
                && (بايت_المصدر(المصدر, الحالي.البايت) != 0x0A)
            ) {
                الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
            }
        };
    }
    أرجع الحالي;
}

عرف امسح_فهرسا(المصدر: &مصدر, البداية: مؤشر_مسح): نتيجة_رمز {
    دع أصل: مصدر = *المصدر;
    دع الحالي: متغير مؤشر_مسح = تقدم_المؤشر(المصدر, البداية, 1);
    دع القيمة: متغير طبيعي = 0;
    دع الأعلى: طبيعي = الحد_الأعلى_لعدد_معجمي() مثل طبيعي;
    طالما (
        متاح_في_المصدر(المصدر, الحالي.البايت, 1)
        && رقم_عشري(بايت_المصدر(المصدر, الحالي.البايت))
    ) {
        دع بايت_الرقم: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
        دع الرقم_الموسع: طبيعي = بايت_الرقم مثل طبيعي;
        دع الرقم: طبيعي = الرقم_الموسع - 0x30;
        لو (القيمة > ((الأعلى - الرقم) / 10)) {
            أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
        };
        القيمة := (القيمة * 10) + الرقم;
        الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
    }
    أرجع نجاح_بفهرس(
        الحالي, رمز.شرطة_سفلية_مرقمة(), أصل.المعرف, البداية, الحالي, القيمة مثل عدد
    );
}

عرف امسح_معرفا(المصدر: &مصدر, البداية: مؤشر_مسح): نتيجة_رمز {
    دع أصل: مصدر = *المصدر;
    دع الحالي: متغير مؤشر_مسح = البداية;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر && متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, الحالي.البايت);
        لو (!المفكوك.صالح) {
            أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.يوتيف8());
        };
        لو (!تتمة_معرف(المفكوك.القيمة)) {
            مستمر := خطأ;
        }
        وإلا {
            الحالي := تقدم_المؤشر(المصدر, الحالي, المفكوك.العرض);
        };
    }
    لو (!هوية_معرف_لها_محتوى_في_شريحة(&أصل.المحتوى, البداية.البايت, الحالي.البايت)) {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };
    دع المطابقة: مطابقة_كلمة = الكلمة_المحجوزة(&أصل.المحتوى, البداية.البايت, الحالي.البايت);
    طابق المطابقة مع
    | مطابقة_كلمة.محجوزة(النوع) -> {
        أرجع نجاح_بلا_حمولة(الحالي, النوع, أصل.المعرف, البداية, الحالي);
    }
    | مطابقة_كلمة.منطقية(القيمة) -> {
        أرجع نجاح_بمنطق(
            الحالي, رمز.حرفي_منطقي(), أصل.المعرف, البداية, الحالي, القيمة
        );
    }
    | مطابقة_كلمة.غير_محجوزة -> {
        أرجع نجاح_بلا_حمولة(الحالي, رمز.معرف(), أصل.المعرف, البداية, الحالي);
    };
}

عام عرف الرمز_التالي(المصدر: &مصدر, المؤشر: مؤشر_مسح): نتيجة_رمز {
    دع أصل: مصدر = *المصدر;
    دع الحالي: مؤشر_مسح = تجاوز_الفواصل(المصدر, المؤشر);
    دع البداية: مؤشر_مسح = الحالي;

    لو (!متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
        أرجع نجاح_بلا_حمولة(الحالي, رمز.نهاية_الملف(), أصل.المعرف, البداية, الحالي);
    };

    لو (يطابق_عند(&أصل.المحتوى, الحالي.البايت, "«")) {
        دع بعد_الفتح: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 2);
        أرجع امسح_نصا(المصدر, البداية, بعد_الفتح, صواب);
    };

    دع الأول: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
    لو (الأول == 0x22) {
        دع بعد_الفتح: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
        أرجع امسح_نصا(المصدر, البداية, بعد_الفتح, خطأ);
    };
    لو (الأول == 0x27) {
        دع بعد_الفتح: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
        أرجع امسح_محرفا(المصدر, البداية, بعد_الفتح);
    };

    لو (الأول == 0x5F) {
        لو (!متاح_في_المصدر(المصدر, الحالي.البايت, 2)) {
            دع النهاية: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
            أرجع نجاح_بلا_حمولة(
                النهاية, رمز.شرطة_سفلية(), أصل.المعرف, البداية, النهاية
            );
        };
        دع التالي: طبيعي = الحالي.البايت + 1;
        دع بايت_التالي: ط8 = بايت_المصدر(المصدر, التالي);
        لو (رقم_عشري(بايت_التالي)) {
            أرجع امسح_فهرسا(المصدر, البداية);
        };
        دع المفكوك_التالي: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, التالي);
        لو (!المفكوك_التالي.صالح || !تتمة_معرف(المفكوك_التالي.القيمة)) {
            دع النهاية: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
            أرجع نجاح_بلا_حمولة(
                النهاية, رمز.شرطة_سفلية(), أصل.المعرف, البداية, النهاية
            );
        };
    };

    لو (رقم_عشري(الأول)) {
        أرجع امسح_عددا(المصدر, البداية);
    };
    دع المفكوك_الأول: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, الحالي.البايت);
    لو (المفكوك_الأول.صالح && بداية_معرف(المفكوك_الأول.القيمة)) {
        أرجع امسح_معرفا(المصدر, البداية);
    };

    دع المطابقة: مطابقة_عامل = العامل_عند(&أصل.المحتوى, الحالي.البايت);
    طابق المطابقة مع
    | مطابقة_عامل.عامل(النوع, العرض) -> {
        دع النهاية: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, العرض مثل طبيعي);
        أرجع نجاح_بلا_حمولة(النهاية, النوع, أصل.المعرف, البداية, النهاية);
    }
    | مطابقة_عامل.ليس_عاملا -> {
        لو (الأول >= 0x80) {
            دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, الحالي.البايت);
            لو (!المفكوك.صالح) {
                أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.يوتيف8());
            };
        };
        دع النهاية: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
        أرجع رفض_مصنف(أصل.المعرف, البداية, النهاية, فئة_خطأ_معجمي.بناء());
    };
}

عرف نهاية_الرمز(النوع: رمز): منطقي {
    طابق النوع مع
    | رمز.نهاية_الملف -> {
        أرجع صواب;
    }
    | _ -> {
        أرجع خطأ;
    };
}

عام عرف حلل_معجميا(المصدر: &مصدر): نتيجة_تحليل_معجمي {
    دع المؤشر: متغير مؤشر_مسح = بداية_المؤشر();
    دع الرموز: متغير متجه رمز_مصدر = [];
    دع انتهى: متغير منطقي = خطأ;
    طالما (!انتهى) {
        دع النتيجة: نتيجة_رمز = الرمز_التالي(المصدر, المؤشر);
        طابق النتيجة مع
        | نتيجة_رمز.مرفوض(الخطأ) -> {
            أرجع نتيجة_تحليل_معجمي.مرفوض(الخطأ);
        }
        | نتيجة_رمز.ناجح(بعد, الرمز) -> {
            المؤشر := بعد;
            دع أخير: منطقي = نهاية_الرمز(الرمز.النوع);
            ألحق(الرموز, الرمز);
            لو (أخير) {
                انتهى := صواب;
            };
        };
    }
    دع الدفق: سلسلة_رموز = { الرموز: الرموز };
    أرجع نتيجة_تحليل_معجمي.سلسلة(الدفق);
}
