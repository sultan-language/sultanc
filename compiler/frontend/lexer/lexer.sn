استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.identifier_identity;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.lexer.cursor;
استورد compiler.frontend.lexer.result;
استورد compiler.frontend.lexer.identifiers;
استورد compiler.frontend.lexer.keywords.matching;
استورد compiler.frontend.lexer.keywords.words;
استورد compiler.frontend.lexer.operators;
استورد compiler.frontend.lexer.numbers;
استورد compiler.frontend.lexer.text;
استورد compiler.frontend.lexer.trivia;
استورد std.chars.ascii;
استورد std.text.compare;
استورد std.encoding.utf8;
// يمسح مصدرا واحدا إلى دفق رموز دلالي مع النطاقات والحمولات اللازمة.
عام نوع سلسلة_رموز = {
    الرموز: متجه رمز_مصدر
};

عام نوع نتيجة_تحليل_معجمي =
    | سلسلة بنوع سلسلة_رموز
    | مرفوض بنوع خطأ_معجمي
;

// The token stream with its trivia (trivia.sn), for tools that rewrite
// source: the same tokens as حلل_معجميا, plus the comments and marks between
// them in source order.
عام نوع سلسلة_رموز_بتوافه = {
    الرموز: متجه رمز_مصدر,
    التوافه: متجه تافهة_مصدر
};

عام نوع نتيجة_تحليل_معجمي_بتوافه =
    | سلسلة بنوع سلسلة_رموز_بتوافه
    | مرفوض بنوع خطأ_معجمي
;

// The UTF-8 length of a non-ASCII separator at البايت, or 0. Separators are
// the Unicode White_Space characters outside ASCII (NBSP U+00A0, U+2000-200A,
// the line/paragraph separators U+2028/2029, U+202F, U+205F, U+3000), the
// byte-order mark U+FEFF, and the implicit direction marks LRM U+200E,
// RLM U+200F and ALM U+061C that editors insert in mixed Arabic/Latin text.
// The explicit embedding and isolate controls (U+202A-202E, U+2066-2069)
// are not separators: they can reorder how code reads, so they stay errors.
عرف طول_فاصل_يونيكود(المصدر: &مصدر, البايت: طبيعي): طبيعي {
    إذا (!متاح_في_المصدر(المصدر, البايت, 2)) { أرجع 0; };
    دع أ: ط8 = بايت_المصدر(المصدر, البايت);
    دع ب: ط8 = بايت_المصدر(المصدر, البايت + 1);
    إذا (أ == 0xC2 && ب == 0xA0) { أرجع 2; };
    إذا (أ == 0xD8 && ب == 0x9C) { أرجع 2; };
    إذا (!متاح_في_المصدر(المصدر, البايت, 3)) { أرجع 0; };
    دع ج: ط8 = بايت_المصدر(المصدر, البايت + 2);
    إذا (أ == 0xE2 && ب == 0x80) {
        إذا (ج <= 0x8A) { أرجع 3; };
        إذا (ج == 0x8E || ج == 0x8F || ج == 0xA8 || ج == 0xA9 || ج == 0xAF) { أرجع 3; };
    };
    إذا (أ == 0xE2 && ب == 0x81 && ج == 0x9F) { أرجع 3; };
    إذا (أ == 0xE3 && ب == 0x80 && ج == 0x80) { أرجع 3; };
    إذا (أ == 0xEF && ب == 0xBB && ج == 0xBF) { أرجع 3; };
    أرجع 0;
}

// The kind of trivia a non-ASCII separator of الطول bytes at البايت is, when
// it is one a rewriting tool must keep (the direction marks and the
// byte-order mark); the other separators are whitespace.
عرف تافهة_فاصل_يونيكود(المصدر: &مصدر, البايت: طبيعي, الطول: طبيعي): اختياري صنف_تافهة {
    دع أ: ط8 = بايت_المصدر(المصدر, البايت);
    إذا (الطول == 2) {
        إذا (أ == 0xD8) { أرجع اختياري.موجود(صنف_تافهة.علامة_اتجاه()); };
        أرجع اختياري.لا_شيء();
    };
    دع ج: ط8 = بايت_المصدر(المصدر, البايت + 2);
    إذا (أ == 0xE2 && (ج == 0x8E || ج == 0x8F)) { أرجع اختياري.موجود(صنف_تافهة.علامة_اتجاه()); };
    إذا (أ == 0xEF) { أرجع اختياري.موجود(صنف_تافهة.علامة_ترتيب_بايت()); };
    أرجع اختياري.لا_شيء();
}

عرف سجل_تافهة(
    التوافه: &متغير متجه تافهة_مصدر,
    معرف_المصدر: طبيعي,
    الصنف: صنف_تافهة,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح
): فراغ {
    دع التافهة: تافهة_مصدر = {
        الصنف: الصنف,
        النطاق: نطاق_المسح(معرف_المصدر, البداية, النهاية)
    };
    ألحق(*التوافه, التافهة);
}

// With يسجل the scan records trivia (trivia.sn) in التوافه. It costs one
// test per comment and per non-ASCII separator, outside the per-byte loops;
// ordinary lexing passes خطأ.
عرف تجاوز_الفواصل(
    المصدر: &مصدر,
    المؤشر: مؤشر_مسح,
    يسجل: منطقي,
    التوافه: &متغير متجه تافهة_مصدر
): مؤشر_مسح {
    // A direct byte loop: ASCII spaces and comment bytes move the byte and
    // column (a newline the line) without a cursor call each.
    دع الحد: طبيعي = (*المصدر).الطول;
    دع الحالي: متغير مؤشر_مسح = المؤشر;
    دع أعد: متغير منطقي = صواب;
    طالما (أعد) {
        أعد := خطأ;
        دع في_فاصل: متغير منطقي = صواب;
        طالما (في_فاصل) {
            في_فاصل := خطأ;
            دع في_أسكي: متغير منطقي = صواب;
            طالما (في_أسكي && الحالي.البايت < الحد) {
                دع البايت: ط8 = (*المصدر).المحتوى[الحالي.البايت];
                إذا (البايت == 0x0A) {
                    الحالي.البايت := الحالي.البايت + 1;
                    الحالي.السطر := الحالي.السطر + 1;
                    الحالي.العمود := 0;
                } وإلا {
                    إذا (البايت == 0x20 || البايت == 0x09 || البايت == 0x0D) {
                        الحالي.البايت := الحالي.البايت + 1;
                        الحالي.العمود := الحالي.العمود + 1;
                    } وإلا {
                        في_أسكي := خطأ;
                    };
                };
            }
            إذا (الحالي.البايت < الحد && (*المصدر).المحتوى[الحالي.البايت] >= 0x80) {
                دع طول_اليونيكود: طبيعي = طول_فاصل_يونيكود(المصدر, الحالي.البايت);
                إذا (طول_اليونيكود > 0) {
                    دع قبل_الفاصل: مؤشر_مسح = الحالي;
                    الحالي := تقدم_المؤشر(المصدر, الحالي, طول_اليونيكود);
                    في_فاصل := صواب;
                    إذا (يسجل) {
                        طابق تافهة_فاصل_يونيكود(المصدر, قبل_الفاصل.البايت, طول_اليونيكود) مع
                        | اختياري.موجود(الصنف) -> {
                            سجل_تافهة(التوافه, (*المصدر).المعرف, الصنف, قبل_الفاصل, الحالي);
                        }
                        | اختياري.لا_شيء -> { };
                    };
                };
            };
        }
        إذا (الحالي.البايت + 2 <= الحد
            && (*المصدر).المحتوى[الحالي.البايت] == 0x2F
            && (*المصدر).المحتوى[الحالي.البايت + 1] == 0x2F) {
            أعد := صواب;
            دع بداية_التعليق: مؤشر_مسح = الحالي;
            دع في_التعليق: متغير منطقي = صواب;
            طالما (في_التعليق && الحالي.البايت < الحد) {
                دع بايت_التعليق: ط8 = (*المصدر).المحتوى[الحالي.البايت];
                إذا (بايت_التعليق == 0x0A || بايت_التعليق == 0x0D) {
                    في_التعليق := خطأ;
                } وإلا {
                    إذا (بايت_التعليق < 0x80) {
                        الحالي.البايت := الحالي.البايت + 1;
                        الحالي.العمود := الحالي.العمود + 1;
                    } وإلا {
                        // A bidi control ends the skip there: the token scan
                        // then rejects it at its own position.
                        دع المفكوك_في_التعليق: فك_يوتيف8 = فك_محرف_يوتيف8(&(*المصدر).المحتوى, الحالي.البايت);
                        إذا (المفكوك_في_التعليق.صالح && هل_تحكم_اتجاه_ثنائي(المفكوك_في_التعليق.القيمة)) {
                            في_التعليق := خطأ;
                            أعد := خطأ;
                        } وإلا {
                            الحالي.البايت := الحالي.البايت + 1;
                            إذا (!بايت_استمرار_يوتيف8(بايت_التعليق)) {
                                الحالي.العمود := الحالي.العمود + 1;
                            };
                        };
                    };
                };
            }
            إذا (يسجل) {
                سجل_تافهة(التوافه, (*المصدر).المعرف, صنف_تافهة.تعليق_سطر(), بداية_التعليق, الحالي);
            };
        };
    }
    أرجع الحالي;
}

عرف امسح_فهرسا(المصدر: &مصدر, البداية: مؤشر_مسح): نتيجة_رمز {
    دع أصل: مصدر = *المصدر;
    دع الحالي: متغير مؤشر_مسح = تقدم_المؤشر(المصدر, البداية, 1);
    دع القيمة: متغير طبيعي = 0;
    دع الأعلى: طبيعي = الحد_الأعلى_لعدد_معجمي() مثل طبيعي;
    طالما (
        متاح_في_المصدر(المصدر, الحالي.البايت, 1)
        && رقم_عشري(بايت_المصدر(المصدر, الحالي.البايت))
    ) {
        دع بايت_الرقم: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
        دع الرقم_الموسع: طبيعي = بايت_الرقم مثل طبيعي;
        دع الرقم: طبيعي = الرقم_الموسع - 0x30;
        إذا (القيمة > ((الأعلى - الرقم) / 10)) {
            أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
        };
        القيمة := (القيمة * 10) + الرقم;
        الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
    }
    أرجع نجاح_بفهرس(
        الحالي, رمز.شرطة_سفلية_مرقمة(), أصل.المعرف, البداية, الحالي, القيمة مثل عدد
    );
}

// An ASCII byte that continues an identifier (the identifier policy's ASCII
// part: Latin letters, digits and the underscore).
عرف تتمة_معرف_آسكي(البايت: ط8): منطقي {
    إذا (البايت >= 0x61) { أرجع البايت <= 0x7A; };
    إذا (البايت >= 0x41) { أرجع البايت <= 0x5A || البايت == 0x5F; };
    أرجع البايت >= 0x30 && البايت <= 0x39;
}

عرف امسح_معرفا(المصدر: &مصدر, البداية: مؤشر_مسح): نتيجة_رمز {
    دع معرف_المصدر: طبيعي = (*المصدر).المعرف;
    دع الحد: طبيعي = (*المصدر).الطول;
    // The identifier holds no newline: only the byte and the column move,
    // one column per scalar.
    دع الموضع: متغير طبيعي = البداية.البايت;
    دع المحارف: متغير ط32 = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر && الموضع < الحد) {
        دع الأول: ط8 = (*المصدر).المحتوى[الموضع];
        إذا (الأول < 0x80) {
            إذا (تتمة_معرف_آسكي(الأول)) {
                الموضع := الموضع + 1;
                المحارف := المحارف + 1;
            } وإلا {
                مستمر := خطأ;
            };
        } وإلا {
            // Two-byte scalars (the Arabic letters) decode here; longer ones
            // and invalid bytes through std's decoder.
            إذا (الأول >= 0xC2 && الأول <= 0xDF && الموضع + 1 < الحد
                && ((*المصدر).المحتوى[الموضع + 1] & 0xC0) == 0x80) {
                دع القيمة: ط32 = ((((الأول & 0x1F) مثل ط32) << 6)
                    | (((*المصدر).المحتوى[الموضع + 1] & 0x3F) مثل ط32));
                إذا (تتمة_معرف(القيمة)) {
                    الموضع := الموضع + 2;
                    المحارف := المحارف + 1;
                } وإلا {
                    مستمر := خطأ;
                };
            } وإلا {
            دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&(*المصدر).المحتوى, الموضع);
            إذا (!المفكوك.صالح) {
                دع عند_الخطأ: مؤشر_مسح = {
                    البايت: الموضع,
                    السطر: البداية.السطر,
                    العمود: البداية.العمود + المحارف
                };
                أرجع رفض_مصنف(معرف_المصدر, عند_الخطأ, تقدم_المؤشر(المصدر, عند_الخطأ, 1), فئة_خطأ_معجمي.يوتيف8());
            };
            إذا (تتمة_معرف(المفكوك.القيمة)) {
                الموضع := الموضع + (المفكوك.العرض مثل طبيعي);
                المحارف := المحارف + 1;
            } وإلا {
                مستمر := خطأ;
            };
            };
        };
    }
    دع الحالي: مؤشر_مسح = {
        البايت: الموضع,
        السطر: البداية.السطر,
        العمود: البداية.العمود + المحارف
    };
    دع الوصف: وصف_هوية_معرف = صف_هوية_معرف_في_شريحة(&(*المصدر).المحتوى, البداية.البايت, الموضع);
    إذا (!الوصف.صالح || !الوصف.لها_محتوى) {
        أرجع رفض_مصنف(معرف_المصدر, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };
    دع المطابقة: مطابقة_كلمة = الكلمة_المحجوزة_بوصف(&(*المصدر).المحتوى, البداية.البايت, الموضع, &الوصف);
    طابق المطابقة مع
    | مطابقة_كلمة.محجوزة(النوع) -> {
        أرجع نجاح_بلا_حمولة(الحالي, النوع, معرف_المصدر, البداية, الحالي);
    }
    | مطابقة_كلمة.منطقية(القيمة) -> {
        أرجع نجاح_بمنطق(
            الحالي, رمز.حرفي_منطقي(), معرف_المصدر, البداية, الحالي, القيمة
        );
    }
    | مطابقة_كلمة.غير_محجوزة -> {
        أرجع نجاح_بلا_حمولة(الحالي, رمز.معرف(), معرف_المصدر, البداية, الحالي);
    };
}

عام عرف الرمز_التالي(المصدر: &مصدر, المؤشر: مؤشر_مسح): نتيجة_رمز {
    دع لا_توافه: متغير متجه تافهة_مصدر = [];
    أرجع الرمز_التالي_بتوافه(المصدر, المؤشر, خطأ, &متغير لا_توافه);
}

عرف الرمز_التالي_بتوافه(
    المصدر: &مصدر,
    المؤشر: مؤشر_مسح,
    يسجل: منطقي,
    التوافه: &متغير متجه تافهة_مصدر
): نتيجة_رمز {
    دع أصل: مصدر = *المصدر;
    دع الحالي: مؤشر_مسح = تجاوز_الفواصل(المصدر, المؤشر, يسجل, التوافه);
    دع البداية: مؤشر_مسح = الحالي;

    إذا (!متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
        أرجع نجاح_بلا_حمولة(الحالي, رمز.نهاية_الملف(), أصل.المعرف, البداية, الحالي);
    };

    إذا (الحالي.البايت + 2 <= (*المصدر).الطول
        && (*المصدر).المحتوى[الحالي.البايت] == 0xC2
        && (*المصدر).المحتوى[الحالي.البايت + 1] == 0xAB) {
        دع بعد_الفتح: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 2);
        أرجع امسح_نصا(المصدر, البداية, بعد_الفتح, صواب);
    };

    دع الأول: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
    إذا (الأول == 0x22) {
        دع بعد_الفتح: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
        أرجع امسح_نصا(المصدر, البداية, بعد_الفتح, خطأ);
    };
    إذا (الأول == 0x27) {
        دع بعد_الفتح: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
        أرجع امسح_محرفا(المصدر, البداية, بعد_الفتح);
    };

    إذا (الأول == 0x5F) {
        إذا (!متاح_في_المصدر(المصدر, الحالي.البايت, 2)) {
            دع النهاية: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
            أرجع نجاح_بلا_حمولة(
                النهاية, رمز.شرطة_سفلية(), أصل.المعرف, البداية, النهاية
            );
        };
        دع التالي: طبيعي = الحالي.البايت + 1;
        دع بايت_التالي: ط8 = بايت_المصدر(المصدر, التالي);
        إذا (رقم_عشري(بايت_التالي)) {
            أرجع امسح_فهرسا(المصدر, البداية);
        };
        دع المفكوك_التالي: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, التالي);
        إذا (!المفكوك_التالي.صالح || !تتمة_معرف(المفكوك_التالي.القيمة)) {
            دع النهاية: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
            أرجع نجاح_بلا_حمولة(
                النهاية, رمز.شرطة_سفلية(), أصل.المعرف, البداية, النهاية
            );
        };
    };

    إذا (رقم_عشري(الأول)) {
        أرجع امسح_عددا(المصدر, البداية);
    };
    دع المفكوك_الأول: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, الحالي.البايت);
    إذا (المفكوك_الأول.صالح && بداية_معرف(المفكوك_الأول.القيمة)) {
        أرجع امسح_معرفا(المصدر, البداية);
    };

    دع المطابقة: مطابقة_عامل = العامل_عند(&أصل.المحتوى, الحالي.البايت);
    طابق المطابقة مع
    | مطابقة_عامل.عامل(النوع, العرض) -> {
        دع النهاية: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, العرض مثل طبيعي);
        أرجع نجاح_بلا_حمولة(النهاية, النوع, أصل.المعرف, البداية, النهاية);
    }
    | مطابقة_عامل.ليس_عاملا -> {
        إذا (الأول >= 0x80) {
            دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&أصل.المحتوى, الحالي.البايت);
            إذا (!المفكوك.صالح) {
                أرجع رفض_مصنف(أصل.المعرف, الحالي, تقدم_المؤشر(المصدر, الحالي, 1), فئة_خطأ_معجمي.يوتيف8());
            };
            إذا (هل_تحكم_اتجاه_ثنائي(المفكوك.القيمة)) {
                دع نهاية_التحكم: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, المفكوك.العرض);
                أرجع رفض_مصنف(أصل.المعرف, البداية, نهاية_التحكم, فئة_خطأ_معجمي.تحكم_اتجاه());
            };
        };
        دع النهاية: مؤشر_مسح = تقدم_المؤشر(المصدر, الحالي, 1);
        أرجع رفض_مصنف(أصل.المعرف, البداية, النهاية, فئة_خطأ_معجمي.بناء());
    };
}

عرف نهاية_الرمز(النوع: رمز): منطقي {
    طابق النوع مع
    | رمز.نهاية_الملف -> {
        أرجع صواب;
    }
    | _ -> {
        أرجع خطأ;
    };
}

عام عرف حلل_معجميا(المصدر: &مصدر): نتيجة_تحليل_معجمي {
    دع الرموز: متغير متجه رمز_مصدر = [];
    دع لا_توافه: متغير متجه تافهة_مصدر = [];
    طابق حلل_معجميا_إلى(المصدر, خطأ, &متغير الرموز, &متغير لا_توافه) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تحليل_معجمي.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع الدفق: سلسلة_رموز = { الرموز: الرموز };
    أرجع نتيجة_تحليل_معجمي.سلسلة(الدفق);
}

// The tokens of حلل_معجميا together with the source's trivia (comments,
// direction marks, the byte-order mark) in source order.
عام عرف حلل_معجميا_مع_التوافه(المصدر: &مصدر): نتيجة_تحليل_معجمي_بتوافه {
    دع الرموز: متغير متجه رمز_مصدر = [];
    دع التوافه: متغير متجه تافهة_مصدر = [];
    طابق حلل_معجميا_إلى(المصدر, صواب, &متغير الرموز, &متغير التوافه) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تحليل_معجمي_بتوافه.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع الناتج: سلسلة_رموز_بتوافه = { الرموز: الرموز, التوافه: التوافه };
    أرجع نتيجة_تحليل_معجمي_بتوافه.سلسلة(الناتج);
}

// Lexes المصدر into الرموز (and, with يسجل, its trivia into التوافه); the
// lexical error, if any.
عرف حلل_معجميا_إلى(
    المصدر: &مصدر,
    يسجل: منطقي,
    الرموز: &متغير متجه رمز_مصدر,
    التوافه: &متغير متجه تافهة_مصدر
): اختياري خطأ_معجمي {
    دع المؤشر: متغير مؤشر_مسح = بداية_المؤشر();
    دع انتهى: متغير منطقي = خطأ;
    طالما (!انتهى) {
        دع النتيجة: نتيجة_رمز = الرمز_التالي_بتوافه(المصدر, المؤشر, يسجل, التوافه);
        طابق النتيجة مع
        | نتيجة_رمز.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة_رمز.ناجح(بعد, الرمز) -> {
            المؤشر := بعد;
            دع أخير: منطقي = نهاية_الرمز(الرمز.النوع);
            ألحق(*الرموز, الرمز);
            إذا (أخير) {
                انتهى := صواب;
            };
        };
    }
    أرجع اختياري.لا_شيء();
}
