استورد compiler.source.span;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.payload;
استورد compiler.frontend.lexer.payload_registry;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.lexer.cursor;

// عقد نتيجة المسح الأولية فقط؛ لا يمثل نظام التشخيص الكامل.
عام نوع فئة_خطأ_معجمي =
    | بناء
    | يوتيف8
    | داخلي
    // A bidirectional embedding, override or isolate control (U+202A..202E,
    // U+2066..2069) in a comment or literal: it can make code display in an
    // order other than the one compiled ("Trojan Source", CVE-2021-42574),
    // as rustc's text_direction_codepoint lints reject. Arabic text needs
    // none of them; the marks U+200E, U+200F and U+061C stay allowed.
    | تحكم_اتجاه
;

عام عرف هل_تحكم_اتجاه_ثنائي(القيمة: ط32): منطقي {
    أرجع ((القيمة >= 0x202A) && (القيمة <= 0x202E)) || ((القيمة >= 0x2066) && (القيمة <= 0x2069));
}

عام نوع خطأ_معجمي = {
    الفئة: فئة_خطأ_معجمي,
    النطاق: نطاق
};

عام نوع نتيجة_رمز =
    | ناجح بنوع (مؤشر_مسح, رمز_مصدر)
    | مرفوض بنوع خطأ_معجمي
;

عام عرف رفض_مصنف(
    معرف_المصدر: طبيعي,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح,
    الفئة: فئة_خطأ_معجمي
): نتيجة_رمز {
    دع النطاق: نطاق = نطاق_المسح(معرف_المصدر, البداية, النهاية);
    دع الخطأ: خطأ_معجمي = {
        الفئة: الفئة,
        النطاق: النطاق
    };
    أرجع نتيجة_رمز.مرفوض(الخطأ);
}

// هذا هو منفذ البناء الوحيد لرمز Stage-1. الفئة المولدة من السجل القانوني
// يجب أن تطابق الحمولة التي اختارها الباني المتخصص، وإلا فالخلل داخلي.
عرف نجاح_متحقق(
    المؤشر: مؤشر_مسح,
    النوع: رمز,
    معرف_المصدر: طبيعي,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح,
    الفئة: فئة_حمولة_رمز,
    الحمولة: حمولة_رمز
): نتيجة_رمز {
    إذا (فئة_حمولة_الرمز(النوع) != الفئة) {
        أرجع رفض_مصنف(معرف_المصدر, البداية, النهاية, فئة_خطأ_معجمي.داخلي());
    };
    دع النطاق: نطاق = نطاق_المسح(معرف_المصدر, البداية, النهاية);
    دع الرمز: رمز_مصدر = {
        النوع: النوع,
        النطاق: النطاق,
        الحمولة: الحمولة
    };
    أرجع نتيجة_رمز.ناجح(المؤشر, الرمز);
}

عام عرف نجاح_بلا_حمولة(
    المؤشر: مؤشر_مسح,
    النوع: رمز,
    معرف_المصدر: طبيعي,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح
): نتيجة_رمز {
    دع الحمولة: حمولة_رمز = حمولة_رمز.بلا();
    أرجع نجاح_متحقق(
        المؤشر, النوع, معرف_المصدر, البداية, النهاية, فئة_حمولة_رمز.بلا(), الحمولة
    );
}

عام عرف نجاح_بفهرس(
    المؤشر: مؤشر_مسح,
    النوع: رمز,
    معرف_المصدر: طبيعي,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح,
    القيمة: عدد
): نتيجة_رمز {
    دع الحمولة: حمولة_رمز = حمولة_رمز.فهرس(القيمة);
    أرجع نجاح_متحقق(
        المؤشر, النوع, معرف_المصدر, البداية, النهاية, فئة_حمولة_رمز.فهرس(), الحمولة
    );
}

عام عرف نجاح_بعدد_صحيح(
    المؤشر: مؤشر_مسح,
    النوع: رمز,
    معرف_المصدر: طبيعي,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح,
    القيمة: قيمة_عدد_صحيح_رمز
): نتيجة_رمز {
    دع الحمولة: حمولة_رمز = حمولة_رمز.عدد_صحيح(القيمة);
    أرجع نجاح_متحقق(
        المؤشر, النوع, معرف_المصدر, البداية, النهاية, فئة_حمولة_رمز.عدد_صحيح(), الحمولة
    );
}

عام عرف نجاح_بنص(
    المؤشر: مؤشر_مسح,
    النوع: رمز,
    معرف_المصدر: طبيعي,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح,
    القيمة: متجه ط8
): نتيجة_رمز {
    دع الحمولة: حمولة_رمز = حمولة_رمز.بايتات_نص(القيمة);
    أرجع نجاح_متحقق(
        المؤشر, النوع, معرف_المصدر, البداية, النهاية, فئة_حمولة_رمز.بايتات_نص(), الحمولة
    );
}

عام عرف نجاح_بمحرف(
    المؤشر: مؤشر_مسح,
    النوع: رمز,
    معرف_المصدر: طبيعي,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح,
    القيمة: ط32
): نتيجة_رمز {
    دع الحمولة: حمولة_رمز = حمولة_رمز.محرف(القيمة);
    أرجع نجاح_متحقق(
        المؤشر, النوع, معرف_المصدر, البداية, النهاية, فئة_حمولة_رمز.محرف(), الحمولة
    );
}

عام عرف نجاح_بمنطق(
    المؤشر: مؤشر_مسح,
    النوع: رمز,
    معرف_المصدر: طبيعي,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح,
    القيمة: منطقي
): نتيجة_رمز {
    دع الحمولة: حمولة_رمز = حمولة_رمز.منطق(القيمة);
    أرجع نجاح_متحقق(
        المؤشر, النوع, معرف_المصدر, البداية, النهاية, فئة_حمولة_رمز.منطق(), الحمولة
    );
}
