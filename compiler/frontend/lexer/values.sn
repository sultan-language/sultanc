استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.payload;
استورد compiler.frontend.lexer.payload_registry;
استورد compiler.source.span;
استورد std.bytes.range;
عام نوع رمز_مصدر = {
    النوع: رمز,
    النطاق: نطاق,
    الحمولة: حمولة_رمز
};

// وصولات الحمولة لا تصنع قيما بديلة. عدم التطابق يعني خرقا لعقد lexer
// ويظهر صراحة كاختيار فارغ كي يحوله parser إلى خطأ داخلي.
عام عرف قيمة_عدد_من_رمز(الرمز: &رمز_مصدر): اختياري قيمة_عدد_صحيح_رمز {
    دع قيمة_الرمز: رمز_مصدر = *الرمز;
    لو (فئة_حمولة_الرمز(قيمة_الرمز.النوع) != فئة_حمولة_رمز.عدد_صحيح()) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الحمولة: &حمولة_رمز = &قيمة_الرمز.الحمولة;
    دع الحمولة: حمولة_رمز = *مرجع_الحمولة;
    طابق الحمولة مع
    | حمولة_رمز.عدد_صحيح(العدد) -> {
        أرجع اختياري.موجود(العدد);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف قيمة_محرف_من_رمز(الرمز: &رمز_مصدر): اختياري ط32 {
    دع قيمة_الرمز: رمز_مصدر = *الرمز;
    لو (فئة_حمولة_الرمز(قيمة_الرمز.النوع) != فئة_حمولة_رمز.محرف()) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الحمولة: &حمولة_رمز = &قيمة_الرمز.الحمولة;
    دع الحمولة: حمولة_رمز = *مرجع_الحمولة;
    طابق الحمولة مع
    | حمولة_رمز.محرف(المحرف) -> {
        أرجع اختياري.موجود(المحرف);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف قيمة_منطق_من_رمز(الرمز: &رمز_مصدر): اختياري منطقي {
    دع قيمة_الرمز: رمز_مصدر = *الرمز;
    لو (فئة_حمولة_الرمز(قيمة_الرمز.النوع) != فئة_حمولة_رمز.منطق()) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الحمولة: &حمولة_رمز = &قيمة_الرمز.الحمولة;
    دع الحمولة: حمولة_رمز = *مرجع_الحمولة;
    طابق الحمولة مع
    | حمولة_رمز.منطق(المنطق) -> {
        أرجع اختياري.موجود(المنطق);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف نسخ_بايتات_رمز(الرمز: &رمز_مصدر): اختياري متجه ط8 {
    دع قيمة_الرمز: رمز_مصدر = *الرمز;
    لو (فئة_حمولة_الرمز(قيمة_الرمز.النوع) != فئة_حمولة_رمز.بايتات_نص()) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الحمولة: &حمولة_رمز = &قيمة_الرمز.الحمولة;
    دع الحمولة: حمولة_رمز = *مرجع_الحمولة;
    طابق الحمولة مع
    | حمولة_رمز.بايتات_نص(البايتات) -> {
        دع العدد: طبيعي = الطول(البايتات) مثل طبيعي;
        أرجع انسخ_نطاق_بايتات(&البايتات, 0, العدد);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف قيمة_عدد_عند(الرموز: &متجه رمز_مصدر, الموضع: طبيعي): اختياري قيمة_عدد_صحيح_رمز {
    دع قيمة_الرموز: متجه رمز_مصدر = *الرموز;
    أرجع قيمة_عدد_من_رمز(&قيمة_الرموز[الموضع]);
}

عام عرف قيمة_محرف_عند(الرموز: &متجه رمز_مصدر, الموضع: طبيعي): اختياري ط32 {
    دع قيمة_الرموز: متجه رمز_مصدر = *الرموز;
    أرجع قيمة_محرف_من_رمز(&قيمة_الرموز[الموضع]);
}

عام عرف قيمة_منطق_عند(الرموز: &متجه رمز_مصدر, الموضع: طبيعي): اختياري منطقي {
    دع قيمة_الرموز: متجه رمز_مصدر = *الرموز;
    أرجع قيمة_منطق_من_رمز(&قيمة_الرموز[الموضع]);
}

عام عرف نسخ_بايتات_عند(الرموز: &متجه رمز_مصدر, الموضع: طبيعي): اختياري متجه ط8 {
    دع قيمة_الرموز: متجه رمز_مصدر = *الرموز;
    أرجع نسخ_بايتات_رمز(&قيمة_الرموز[الموضع]);
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_رمز_مصدر(القيمة: &رمز_مصدر): رمز_مصدر {
    دع الناتج: رمز_مصدر = {
        النوع: (*القيمة).النوع,
        النطاق: (*القيمة).النطاق,
        الحمولة: انسخ_مملوكا_حمولة_رمز(&(*القيمة).الحمولة)
    };
    أرجع الناتج;
}
