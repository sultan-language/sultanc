استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.payload;
استورد compiler.frontend.lexer.payload_registry;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد std.bytes.range;
عام نوع رمز_مصدر = {
    النوع: رمز,
    النطاق: نطاق,
    الحمولة: حمولة_رمز
};

// وصولات الحمولة لا تصنع قيما بديلة. عدم التطابق يعني خرقا لعقد lexer
// ويظهر صراحة كاختيار فارغ كي يحوله parser إلى خطأ داخلي.
عام عرف قيمة_عدد_من_رمز(الرمز: &رمز_مصدر): اختيار قيمة_عدد_صحيح_رمز {
    دع القيمة: رمز_مصدر = *الرمز;
    لو (فئة_حمولة_الرمز(القيمة.النوع) != فئة_حمولة_رمز.عدد_صحيح()) {
        أرجع اختيار.لا_شيء();
    };
    طابق القيمة.الحمولة مع
    | حمولة_رمز.عدد_صحيح(العدد) -> {
        أرجع اختيار.بعض(العدد);
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف قيمة_محرف_من_رمز(الرمز: &رمز_مصدر): اختيار غ32 {
    دع القيمة: رمز_مصدر = *الرمز;
    لو (فئة_حمولة_الرمز(القيمة.النوع) != فئة_حمولة_رمز.محرف()) {
        أرجع اختيار.لا_شيء();
    };
    طابق القيمة.الحمولة مع
    | حمولة_رمز.محرف(المحرف) -> {
        أرجع اختيار.بعض(المحرف);
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف قيمة_منطق_من_رمز(الرمز: &رمز_مصدر): اختيار منطقي {
    دع القيمة: رمز_مصدر = *الرمز;
    لو (فئة_حمولة_الرمز(القيمة.النوع) != فئة_حمولة_رمز.منطق()) {
        أرجع اختيار.لا_شيء();
    };
    طابق القيمة.الحمولة مع
    | حمولة_رمز.منطق(المنطق) -> {
        أرجع اختيار.بعض(المنطق);
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف نسخ_بايتات_رمز(الرمز: &رمز_مصدر): اختيار متجه غ8 {
    دع القيمة: رمز_مصدر = *الرمز;
    لو (فئة_حمولة_الرمز(القيمة.النوع) != فئة_حمولة_رمز.بايتات_نص()) {
        أرجع اختيار.لا_شيء();
    };
    طابق القيمة.الحمولة مع
    | حمولة_رمز.بايتات_نص(البايتات) -> {
        دع العدد: غير_موقع = الطول(البايتات) مثل غير_موقع;
        أرجع انسخ_نطاق_بايتات(&البايتات, 0, العدد);
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف قيمة_عدد_عند(الرموز: &متجه رمز_مصدر, الموضع: غير_موقع): اختيار قيمة_عدد_صحيح_رمز {
    دع القيم: متجه رمز_مصدر = *الرموز;
    أرجع قيمة_عدد_من_رمز(&القيم[الموضع]);
}

عام عرف قيمة_محرف_عند(الرموز: &متجه رمز_مصدر, الموضع: غير_موقع): اختيار غ32 {
    دع القيم: متجه رمز_مصدر = *الرموز;
    أرجع قيمة_محرف_من_رمز(&القيم[الموضع]);
}

عام عرف قيمة_منطق_عند(الرموز: &متجه رمز_مصدر, الموضع: غير_موقع): اختيار منطقي {
    دع القيم: متجه رمز_مصدر = *الرموز;
    أرجع قيمة_منطق_من_رمز(&القيم[الموضع]);
}

عام عرف نسخ_بايتات_عند(الرموز: &متجه رمز_مصدر, الموضع: غير_موقع): اختيار متجه غ8 {
    دع القيم: متجه رمز_مصدر = *الرموز;
    أرجع نسخ_بايتات_رمز(&القيم[الموضع]);
}
