استورد compiler.frontend.source.source;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.payload;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.lexer.cursor;
استورد compiler.frontend.lexer.result;
استورد std.chars.ascii;
استورد std.text.compare;
نوع تحليل_عدد =
    | صالح بنوع قيمة_عدد_صحيح_رمز
    | غير_صالح
;

// الحد العددي المعجمي له مالك واحد؛ الملاءمة للأنواع الأصغر مسؤولية Type System لاحقا.
عام عرف الحد_الأعلى_لعدد_معجمي(): عدد {
    أرجع 9223372036854775807;
}

عرف رقم_للأساس(البايت: غ8, الأساس: عدد): منطقي {
    لو (الأساس == 2) {
        أرجع (البايت == 0x30) || (البايت == 0x31);
    };
    لو (الأساس == 16) {
        أرجع رقم_سداسي(البايت);
    };
    أرجع رقم_عشري(البايت);
}

// الشرطة السفلية الرقمية مسموحة فقط بين رقمين من الأساس الفعال.
عرف فواصل_العدد_صالحة(
    المصدر: &مصدر,
    البداية: غير_موقع,
    النهاية: غير_موقع
): منطقي {
    دع أصل: مصدر = *المصدر;
    دع الأساس: متغير عدد = 10;
    لو (يطابق_عند(&أصل.المحتوى, البداية, «0b»)) {
        الأساس := 2;
    };
    لو (يطابق_عند(&أصل.المحتوى, البداية, «0x»)) {
        الأساس := 16;
    };
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        لو (أصل.المحتوى[ف] == 0x5F) {
            لو ((ف == البداية) || ((ف + 1) >= النهاية)) {
                أرجع خطأ;
            };
            دع السابق: غير_موقع = ف - 1;
            دع التالي: غير_موقع = ف + 1;
            لو (!رقم_للأساس(أصل.المحتوى[السابق], الأساس) || !رقم_للأساس(أصل.المحتوى[التالي], الأساس)) {
                أرجع خطأ;
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف قيمة_العدد(
    المصدر: &مصدر,
    البداية: غير_موقع,
    النهاية: غير_موقع
): تحليل_عدد {
    دع أصل: مصدر = *المصدر;
    لو ((النهاية - البداية) >= 256) {
        أرجع تحليل_عدد.غير_صالح();
    };
    دع الأساس: متغير عدد = 10;
    دع الموضع: متغير غير_موقع = البداية;
    لو (يطابق_عند(&أصل.المحتوى, البداية, «0b»)) {
        الأساس := 2;
        الموضع := البداية + 2;
    }
    وإلا {
        لو (يطابق_عند(&أصل.المحتوى, البداية, «0x»)) {
            الأساس := 16;
            الموضع := البداية + 2;
        };
    };

    دع القيمة: متغير غير_موقع = 0;
    دع وجد_رقما: متغير منطقي = خطأ;
    بينما (الموضع < النهاية) {
        دع البايت: غ8 = أصل.المحتوى[الموضع];
        لو (البايت == 0x5F) {
            الموضع := الموضع + 1;
        }
        وإلا {
            دع الرقم_الموقع: متغير عدد = -1;
            لو (الأساس == 16) {
                الرقم_الموقع := قيمة_سداسية(البايت);
            }
            وإلا {
                لو (رقم_عشري(البايت)) {
                    الرقم_الموقع := (البايت - 0x30) مثل عدد;
                };
            };
            لو ((الرقم_الموقع < 0) || (الرقم_الموقع >= الأساس)) {
                أرجع تحليل_عدد.غير_صالح();
            };
            وجد_رقما := صواب;
            دع الرقم: غير_موقع = الرقم_الموقع مثل غير_موقع;
            دع الأساس_غير_موقع: غير_موقع = الأساس مثل غير_موقع;
            دع الأعلى: غير_موقع = ~((0 مثل غير_موقع));
            لو (القيمة > ((الأعلى - الرقم) / الأساس_غير_موقع)) {
                أرجع تحليل_عدد.غير_صالح();
            };
            القيمة := (القيمة * الأساس_غير_موقع) + الرقم;
            الموضع := الموضع + 1;
        };
    }
    لو (!وجد_رقما) {
        أرجع تحليل_عدد.غير_صالح();
    };
    دع أعلى_موقع: غير_موقع = الحد_الأعلى_لعدد_معجمي() مثل غير_موقع;
    لو (القيمة <= أعلى_موقع) {
        دع القيمة_الموقعة: قيمة_عدد_صحيح_رمز = قيمة_عدد_صحيح_رمز.موقع(القيمة مثل عدد);
        أرجع تحليل_عدد.صالح(القيمة_الموقعة);
    };
    دع القيمة_غير_الموقعة: قيمة_عدد_صحيح_رمز = قيمة_عدد_صحيح_رمز.غير_موقع(القيمة);
    أرجع تحليل_عدد.صالح(القيمة_غير_الموقعة);
}

عرف امسح_أرقاما_عشرية(المصدر: &مصدر, المؤشر: مؤشر_مسح): مؤشر_مسح {
    دع الحالي: متغير مؤشر_مسح = المؤشر;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر && متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
        دع البايت: غ8 = بايت_المصدر(المصدر, الحالي.البايت);
        لو (رقم_عشري(البايت) || (البايت == 0x5F)) {
            الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
        }
        وإلا {
            مستمر := خطأ;
        };
    }
    أرجع الحالي;
}

عام عرف امسح_عددا(المصدر: &مصدر, البداية: مؤشر_مسح): نتيجة_رمز {
    دع أصل: مصدر = *المصدر;
    دع الحالي: متغير مؤشر_مسح = البداية;
    دع عشري: متغير منطقي = خطأ;

    لو (يطابق_عند(&أصل.المحتوى, الحالي.البايت, «0b»)) {
        الحالي := تقدم_المؤشر(المصدر, الحالي, 2);
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر && متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
            دع البايت: غ8 = بايت_المصدر(المصدر, الحالي.البايت);
            لو ((البايت == 0x30) || (البايت == 0x31) || (البايت == 0x5F)) {
                الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
            }
            وإلا {
                مستمر := خطأ;
            };
        }
    }
    وإلا {
        لو (يطابق_عند(&أصل.المحتوى, الحالي.البايت, «0x»)) {
            الحالي := تقدم_المؤشر(المصدر, الحالي, 2);
            دع مستمر: متغير منطقي = صواب;
            بينما (مستمر && متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
                دع البايت: غ8 = بايت_المصدر(المصدر, الحالي.البايت);
                لو (رقم_سداسي(البايت) || (البايت == 0x5F)) {
                    الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                }
                وإلا {
                    مستمر := خطأ;
                };
            }
        }
        وإلا {
            الحالي := امسح_أرقاما_عشرية(المصدر, الحالي);
            لو (متاح_في_المصدر(المصدر, الحالي.البايت, 2)) {
                دع التالي: غير_موقع = الحالي.البايت + 1;
                لو (
                    (بايت_المصدر(المصدر, الحالي.البايت) == 0x2E)
                    && رقم_عشري(بايت_المصدر(المصدر, التالي))
                ) {
                    عشري := صواب;
                    الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                    الحالي := امسح_أرقاما_عشرية(المصدر, الحالي);
                };
            };
            لو (متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
                دع البايت: غ8 = بايت_المصدر(المصدر, الحالي.البايت);
                لو ((البايت == 0x65) || (البايت == 0x45)) {
                    دع المحفوظ: مؤشر_مسح = الحالي;
                    الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                    لو (متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
                        دع الإشارة: غ8 = بايت_المصدر(المصدر, الحالي.البايت);
                        لو ((الإشارة == 43) || (الإشارة == 45)) {
                            الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                        };
                    };
                    لو (
                        متاح_في_المصدر(المصدر, الحالي.البايت, 1)
                        && رقم_عشري(بايت_المصدر(المصدر, الحالي.البايت))
                    ) {
                        عشري := صواب;
                        الحالي := امسح_أرقاما_عشرية(المصدر, الحالي);
                    }
                    وإلا {
                        الحالي := المحفوظ;
                    };
                };
            };
        };
    };

    لو (!فواصل_العدد_صالحة(المصدر, البداية.البايت, الحالي.البايت)) {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };

    لو (عشري) {
        أرجع نجاح_بلا_حمولة(
            الحالي, رمز.حرفي_عدد_عشري(), أصل.المعرف, البداية, الحالي
        );
    };

    دع التحليل: تحليل_عدد = قيمة_العدد(المصدر, البداية.البايت, الحالي.البايت);
    طابق التحليل مع
    | تحليل_عدد.صالح(القيمة) -> {
        أرجع نجاح_بعدد_صحيح(
            الحالي, رمز.حرفي_عدد_صحيح(), أصل.المعرف, البداية, الحالي, القيمة
        );
    }
    | تحليل_عدد.غير_صالح -> {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };
}
