استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.payload;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.lexer.cursor;
استورد compiler.frontend.lexer.result;
استورد std.chars.ascii;
استورد std.text.compare;
نوع تحليل_عدد =
    | صالح بنوع قيمة_عدد_صحيح_رمز
    | غير_صالح
;

// الحد العددي المعجمي له مالك واحد؛ الملاءمة للأنواع الأصغر مسؤولية Type System لاحقا.
عام عرف الحد_الأعلى_لعدد_معجمي(): عدد {
    أرجع 9223372036854775807;
}

عرف رقم_للأساس(البايت: ط8, الأساس: عدد): منطقي {
    إذا (الأساس == 2) {
        أرجع (البايت == 0x30) || (البايت == 0x31);
    };
    إذا (الأساس == 16) {
        أرجع رقم_سداسي(البايت);
    };
    أرجع رقم_عشري(البايت);
}

// الشرطة السفلية الرقمية مسموحة فقط بين رقمين من الأساس الفعال.
عرف فواصل_العدد_صالحة(
    المصدر: &مصدر,
    البداية: طبيعي,
    النهاية: طبيعي
): منطقي {
    دع أصل: مصدر = *المصدر;
    دع الأساس: متغير عدد = 10;
    إذا (يطابق_عند(&أصل.المحتوى, البداية, «0b»)) {
        الأساس := 2;
    };
    إذا (يطابق_عند(&أصل.المحتوى, البداية, «0x»)) {
        الأساس := 16;
    };
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        إذا (أصل.المحتوى[ف] == 0x5F) {
            إذا ((ف == البداية) || ((ف + 1) >= النهاية)) {
                أرجع خطأ;
            };
            دع السابق: طبيعي = ف - 1;
            دع التالي: طبيعي = ف + 1;
            إذا (!رقم_للأساس(أصل.المحتوى[السابق], الأساس) || !رقم_للأساس(أصل.المحتوى[التالي], الأساس)) {
                أرجع خطأ;
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف قيمة_العدد(
    المصدر: &مصدر,
    البداية: طبيعي,
    النهاية: طبيعي
): تحليل_عدد {
    دع أصل: مصدر = *المصدر;
    إذا ((النهاية - البداية) >= 256) {
        أرجع تحليل_عدد.غير_صالح();
    };
    دع الأساس: متغير عدد = 10;
    دع الموضع: متغير طبيعي = البداية;
    إذا (يطابق_عند(&أصل.المحتوى, البداية, «0b»)) {
        الأساس := 2;
        الموضع := البداية + 2;
    }
    وإلا {
        إذا (يطابق_عند(&أصل.المحتوى, البداية, «0x»)) {
            الأساس := 16;
            الموضع := البداية + 2;
        };
    };

    دع القيمة: متغير طبيعي = 0;
    دع وجد_رقما: متغير منطقي = خطأ;
    طالما (الموضع < النهاية) {
        دع البايت: ط8 = أصل.المحتوى[الموضع];
        إذا (البايت == 0x5F) {
            الموضع := الموضع + 1;
        }
        وإلا {
            دع الرقم_الموقع: متغير عدد = -1;
            إذا (الأساس == 16) {
                الرقم_الموقع := قيمة_سداسية(البايت);
            }
            وإلا {
                إذا (رقم_عشري(البايت)) {
                    الرقم_الموقع := (البايت - 0x30) مثل عدد;
                };
            };
            إذا ((الرقم_الموقع < 0) || (الرقم_الموقع >= الأساس)) {
                أرجع تحليل_عدد.غير_صالح();
            };
            وجد_رقما := صواب;
            دع الرقم: طبيعي = الرقم_الموقع مثل طبيعي;
            دع الأساس_طبيعي: طبيعي = الأساس مثل طبيعي;
            دع الأعلى: طبيعي = ~((0 مثل طبيعي));
            إذا (القيمة > ((الأعلى - الرقم) / الأساس_طبيعي)) {
                أرجع تحليل_عدد.غير_صالح();
            };
            القيمة := (القيمة * الأساس_طبيعي) + الرقم;
            الموضع := الموضع + 1;
        };
    }
    إذا (!وجد_رقما) {
        أرجع تحليل_عدد.غير_صالح();
    };
    دع أعلى_موقع: طبيعي = الحد_الأعلى_لعدد_معجمي() مثل طبيعي;
    إذا (القيمة <= أعلى_موقع) {
        دع القيمة_الموقعة: قيمة_عدد_صحيح_رمز = قيمة_عدد_صحيح_رمز.موقع(القيمة مثل عدد);
        أرجع تحليل_عدد.صالح(القيمة_الموقعة);
    };
    دع القيمة_غير_الموقعة: قيمة_عدد_صحيح_رمز = قيمة_عدد_صحيح_رمز.طبيعي(القيمة);
    أرجع تحليل_عدد.صالح(القيمة_غير_الموقعة);
}

عرف امسح_أرقاما_عشرية(المصدر: &مصدر, المؤشر: مؤشر_مسح): مؤشر_مسح {
    دع الحالي: متغير مؤشر_مسح = المؤشر;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر && متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
        دع البايت: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
        إذا (رقم_عشري(البايت) || (البايت == 0x5F)) {
            الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
        }
        وإلا {
            مستمر := خطأ;
        };
    }
    أرجع الحالي;
}

عام عرف امسح_عددا(المصدر: &مصدر, البداية: مؤشر_مسح): نتيجة_رمز {
    دع أصل: مصدر = *المصدر;
    دع الحالي: متغير مؤشر_مسح = البداية;
    دع عشري: متغير منطقي = خطأ;

    إذا (يطابق_عند(&أصل.المحتوى, الحالي.البايت, «0b»)) {
        الحالي := تقدم_المؤشر(المصدر, الحالي, 2);
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر && متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
            دع البايت: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
            إذا ((البايت == 0x30) || (البايت == 0x31) || (البايت == 0x5F)) {
                الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
            }
            وإلا {
                مستمر := خطأ;
            };
        }
    }
    وإلا {
        إذا (يطابق_عند(&أصل.المحتوى, الحالي.البايت, «0x»)) {
            الحالي := تقدم_المؤشر(المصدر, الحالي, 2);
            دع مستمر: متغير منطقي = صواب;
            طالما (مستمر && متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
                دع البايت: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
                إذا (رقم_سداسي(البايت) || (البايت == 0x5F)) {
                    الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                }
                وإلا {
                    مستمر := خطأ;
                };
            }
        }
        وإلا {
            الحالي := امسح_أرقاما_عشرية(المصدر, الحالي);
            إذا (متاح_في_المصدر(المصدر, الحالي.البايت, 2)) {
                دع التالي: طبيعي = الحالي.البايت + 1;
                إذا (
                    (بايت_المصدر(المصدر, الحالي.البايت) == 0x2E)
                    && رقم_عشري(بايت_المصدر(المصدر, التالي))
                ) {
                    عشري := صواب;
                    الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                    الحالي := امسح_أرقاما_عشرية(المصدر, الحالي);
                };
            };
            إذا (متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
                دع البايت: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
                إذا ((البايت == 0x65) || (البايت == 0x45)) {
                    دع المحفوظ: مؤشر_مسح = الحالي;
                    الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                    إذا (متاح_في_المصدر(المصدر, الحالي.البايت, 1)) {
                        دع الإشارة: ط8 = بايت_المصدر(المصدر, الحالي.البايت);
                        إذا ((الإشارة == 43) || (الإشارة == 45)) {
                            الحالي := تقدم_المؤشر(المصدر, الحالي, 1);
                        };
                    };
                    إذا (
                        متاح_في_المصدر(المصدر, الحالي.البايت, 1)
                        && رقم_عشري(بايت_المصدر(المصدر, الحالي.البايت))
                    ) {
                        عشري := صواب;
                        الحالي := امسح_أرقاما_عشرية(المصدر, الحالي);
                    }
                    وإلا {
                        الحالي := المحفوظ;
                    };
                };
            };
        };
    };

    إذا (!فواصل_العدد_صالحة(المصدر, البداية.البايت, الحالي.البايت)) {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };

    إذا (عشري) {
        أرجع نجاح_بلا_حمولة(
            الحالي, رمز.حرفي_عدد_عشري(), أصل.المعرف, البداية, الحالي
        );
    };

    دع التحليل: تحليل_عدد = قيمة_العدد(المصدر, البداية.البايت, الحالي.البايت);
    طابق التحليل مع
    | تحليل_عدد.صالح(القيمة) -> {
        أرجع نجاح_بعدد_صحيح(
            الحالي, رمز.حرفي_عدد_صحيح(), أصل.المعرف, البداية, الحالي, القيمة
        );
    }
    | تحليل_عدد.غير_صالح -> {
        أرجع رفض_مصنف(أصل.المعرف, البداية, الحالي, فئة_خطأ_معجمي.بناء());
    };
}
