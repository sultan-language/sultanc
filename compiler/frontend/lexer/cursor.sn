استورد compiler.frontend.source.source;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد std.encoding.utf8;
// حالة التقدم بالبايت أثناء المسح المعجمي.
عام نوع مؤشر_مسح = {
    البايت: غير_موقع,
    السطر: غ32,
    العمود: غ32
};

عام عرف بداية_المؤشر(): مؤشر_مسح {
    دع الناتج: مؤشر_مسح = {
        البايت: 0,
        السطر: 1,
        العمود: 0
    };
    أرجع الناتج;
}

عام عرف موضع_المؤشر(معرف_المصدر: غير_موقع, المؤشر: مؤشر_مسح): موضع {
    دع الناتج: موضع = {
        المصدر: معرف_المصدر,
        البايت: المؤشر.البايت,
        السطر: المؤشر.السطر,
        العمود: المؤشر.العمود
    };
    أرجع الناتج;
}

عام عرف نطاق_المسح(
    معرف_المصدر: غير_موقع,
    البداية: مؤشر_مسح,
    النهاية: مؤشر_مسح
): نطاق {
    دع موضع_البداية: موضع = موضع_المؤشر(معرف_المصدر, البداية);
    دع موضع_النهاية: موضع = موضع_المؤشر(معرف_المصدر, النهاية);
    أرجع نطاق_بين(موضع_البداية, موضع_النهاية);
}

عام عرف تقدم_المؤشر(
    المصدر: &مصدر,
    المؤشر: مؤشر_مسح,
    العدد: غير_موقع
): مؤشر_مسح {
    دع الحالي: مصدر = *المصدر;
    دع الناتج: متغير مؤشر_مسح = المؤشر;
    دع الباقي: متغير غير_موقع = العدد;
    بينما ((الباقي > 0) && (الناتج.البايت < الحالي.الطول)) {
        دع البايت: غ8 = الحالي.المحتوى[الناتج.البايت];
        الناتج.البايت := الناتج.البايت + 1;
        لو (البايت == 0x0A) {
            الناتج.السطر := الناتج.السطر + 1;
            الناتج.العمود := 0;
        }
        وإلا {
            لو (!بايت_استمرار_يوتيف8(البايت)) {
                الناتج.العمود := الناتج.العمود + 1;
            };
        };
        الباقي := الباقي - 1;
    }
    أرجع الناتج;
}
