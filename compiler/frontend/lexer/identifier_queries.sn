استورد compiler.frontend.lexer.identifiers;
استورد compiler.frontend.lexer.keywords.keyword_registry;
استورد compiler.frontend.lexer.keywords.matching;
استورد compiler.frontend.identifier_identity;
استورد std.encoding.utf8;
// Canonical source-identifier legality query for compiler/tooling consumers.
// Character policy remains generated in identifiers.sn and keyword spelling
// remains generated from token_registry.def.
عام عرف تهجئة_معرف_مصدر_صالحة(النص: &نص): منطقي {
    دع القيمة: نص = *النص;
    دع النهاية: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (النهاية == 0) { أرجع خطأ; };
    لو (!هوية_معرف_لها_محتوى_في_شريحة(&القيمة, 0, النهاية)) { أرجع خطأ; };

    دع الأول: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, 0);
    لو (!الأول.صالح || !بداية_معرف(الأول.القيمة)) { أرجع خطأ; };

    دع الموضع: متغير غير_موقع = الأول.العرض;
    بينما (الموضع < النهاية) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&القيمة, الموضع);
        لو (!المفكوك.صالح || !تتمة_معرف(المفكوك.القيمة)) { أرجع خطأ; };
        الموضع := الموضع + المفكوك.العرض;
    }

    طابق كلمة_مسجلة(&القيمة, 0, النهاية) مع
    | مطابقة_كلمة.غير_محجوزة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}
