// Incremental tooling analysis: a session the editor keeps between requests.
//
// There is one analysis engine (semantic_pipeline.sn). A request analyses a
// حالة_واجهة_مرحلية in stages; a stage continues the facts of the modules
// before it, which never import a module of a later stage. The session keeps
// two copies of a state:
//   الأساس   the std and package modules (outside the workspace roots);
//   المساحة  الأساس and every workspace module the last edits do not reach.
// A request reads every module's text (an editor's unsaved text first),
// takes the largest kept state none of whose modules changed, and analyses
// only the modules after it: the changed modules, the modules that import
// them (directly or not) and the modules changed by the request before
// (the editor is likely to change them again), in a last stage. The result
// is that of a full analysis; IDs and the order of diagnostics may differ.
//
// What invalidates:
//   - a different target, workspace roots, package graph or other
//     configuration of the logical environment: everything (بصمة_طلب_جلسة);
//   - a root file whose `module` spellings changed, a package whose member
//     files changed: everything;
//   - a changed module text: the kept states holding it, and its importers;
//   - a module with an import that could not be loaded is analysed again on
//     every request (the file it names may appear);
//   - a module that is no longer reached from the roots: everything.
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.tooling_facts;
استورد compiler.frontend.tooling_queries;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.module_loader;
استورد compiler.frontend.module_loading.source_locator;
استورد compiler.frontend.module_loading.module_spellings;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.package_export_index;
استورد compiler.frontend.module_loading.source_provider;
استورد compiler.jisr.translate;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.ast.unit;
استورد compiler.backend.target.target_model;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.output.terminal;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.مجموعات.ترتيب;

// ---- Hashing ---------------------------------------------------------------
// Two 32-bit FNV-1a lanes (two primes) in one 64-bit value; the length is
// mixed in last. A text is only compared with the text of the same module in
// an earlier request.

عرف خطوة_هاش_جلسة(الهاش: طبيعي, البايت: طبيعي): طبيعي {
    دع الأول: طبيعي = (((الهاش / 4294967296) ^ البايت) * 16777619) % 4294967296;
    دع الثاني: طبيعي = (((الهاش % 4294967296) ^ البايت) * 2246822519) % 4294967296;
    أرجع (الأول * 4294967296) + الثاني;
}

عرف امزج_هاش_جلسة(الهاش: طبيعي, القيمة: طبيعي): طبيعي {
    دع الناتج: متغير طبيعي = الهاش;
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        الناتج := خطوة_هاش_جلسة(الناتج, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف بداية_هاش_جلسة(): طبيعي { أرجع (2166136261 * 4294967296) + 2166136261; }

عام عرف هاش_نص_جلسة(النص: &نص): طبيعي {
    دع الهاش: متغير طبيعي = بداية_هاش_جلسة();
    دع الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_الكلي) {
        الهاش := خطوة_هاش_جلسة(الهاش, (*النص)[ف] مثل طبيعي);
        ف := ف + 1;
    }
    أرجع امزج_هاش_جلسة(الهاش, الطول_الكلي);
}

عرف هاش_بايتات_جلسة(الهاش: طبيعي, البايتات: &متجه ط8): طبيعي {
    دع الناتج: متغير طبيعي = امزج_هاش_جلسة(الهاش, الطول(*البايتات) مثل طبيعي);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) {
        الناتج := امزج_هاش_جلسة(الناتج, (*البايتات)[ف] مثل طبيعي);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف هاش_مفتاح_جلسة(الهاش: طبيعي, المفتاح: &مفتاح_وحدة_مقنن): طبيعي {
    دع الناتج: متغير طبيعي = امزج_هاش_جلسة(الهاش, (*المفتاح).الجذر.القيمة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المفتاح).المسار.الأجزاء) مثل طبيعي)) {
        الناتج := هاش_بايتات_جلسة(الناتج, &(*المفتاح).المسار.الأجزاء[ف].البايتات);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The configuration a kept state depends on beyond the module texts: the
// target, the logical environment (roots, packages, spellings of roots, source
// locations) and the request's roots.
عام عرف بصمة_طلب_جلسة(
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    الجذر: &مفتاح_وحدة_مقنن,
    الإضافية: &متجه مفتاح_وحدة_مقنن
): طبيعي {
    دع ه: متغير طبيعي = بداية_هاش_جلسة();
    طابق *الهدف مع
    | اختياري.موجود(الواصف) -> {
        ه := امزج_هاش_جلسة(ه, هاش_نص_جلسة(&الواصف.الثلاثي_المقنن));
        ه := امزج_هاش_جلسة(ه, الواصف.نموذج_البيانات.عرض_المؤشر);
    }
    | اختياري.لا_شيء -> { ه := امزج_هاش_جلسة(ه, 1); };
    ه := امزج_هاش_جلسة(ه, (*البيئة).معرف_الجذر_التالي);
    طابق (*البيئة).جذر_قياسي_موثوق مع
    | اختياري.موجود(الجذر_القياسي) -> { ه := امزج_هاش_جلسة(ه, الجذر_القياسي.القيمة + 7); }
    | اختياري.لا_شيء -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).الجذور) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, (*البيئة).الجذور[ف].القيمة);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).روابط_الجذور) مثل طبيعي)) {
        دع الربط: &ربط_اسم_جذر_مكتبة = &(*البيئة).روابط_الجذور[ف];
        ه := امزج_هاش_جلسة(ه, (*الربط).الجذر_المرئي.القيمة);
        ه := هاش_بايتات_جلسة(ه, &(*الربط).التهجئة);
        ه := امزج_هاش_جلسة(ه, (*الربط).الجذر_الهدف.القيمة);
        إذا ((*الربط).يستهلك_التهجئة) { ه := امزج_هاش_جلسة(ه, 3); };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).جذور_المصادر) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, (*البيئة).جذور_المصادر[ف].القيمة);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).مسارات_جذور_المصادر) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, هاش_نص_جلسة(&(*البيئة).مسارات_جذور_المصادر[ف]));
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).المسارات_العامة) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, (*البيئة).المسارات_العامة[ف].الجذر_المرئي.القيمة);
        ه := هاش_بايتات_جلسة(ه, &(*البيئة).المسارات_العامة[ف].المسار_العام);
        ه := هاش_مفتاح_جلسة(ه, &(*البيئة).المسارات_العامة[ف].المفتاح);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).مواقع_المصادر) مثل طبيعي)) {
        ه := هاش_مفتاح_جلسة(ه, &(*البيئة).مواقع_المصادر[ف].المفتاح);
        ه := امزج_هاش_جلسة(ه, هاش_نص_جلسة(&(*البيئة).مواقع_المصادر[ف].مسار_ملف_المصدر));
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).أسماء_الحزم) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, (*البيئة).أسماء_الحزم[ف].الجذر.القيمة);
        ه := هاش_بايتات_جلسة(ه, &(*البيئة).أسماء_الحزم[ف].الاسم);
        ف := ف + 1;
    }
    ه := هاش_مفتاح_جلسة(ه, الجذر);
    ف := 0;
    طالما (ف < (الطول(*الإضافية) مثل طبيعي)) {
        ه := هاش_مفتاح_جلسة(ه, &(*الإضافية)[ف]);
        ف := ف + 1;
    }
    أرجع ه;
}

// The hash of a module's current text: an editor's unsaved text first, else
// the file. None when the module cannot be located or read.
عام عرف هاش_مصدر_حالي_جلسة(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    الهدف: &اختياري واصف_هدف
): اختياري طبيعي {
    طابق حدد_مصدر_وحدة_لهدف(البيئة, المفتاح, الهدف) مع
    | نتيجة_تحديد_مصدر.موجود(المحدد) -> { أرجع اختياري.موجود(هاش_نص_جلسة(&المحدد.المحتوى)); }
    | نتيجة_تحديد_مصدر.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// What a request knows of a module's current text: its hash (none when it
// cannot be located or read), and the file's size and modification time, which
// let the next request keep the hash without reading the file. بلا_بيانات:
// the text is an editor's unsaved text or a C import (always read again).
عام نوع حالة_نص_جلسة = {
    الهاش: اختياري طبيعي,
    الحجم: عدد,
    وقت_التعديل: عدد,
    بلا_بيانات: منطقي
};

نوع بيانات_ملف_جلسة_ناتجة = { الحجم: عدد, الوقت: عدد };

// The size and modification time of a file, when both can be read.
عرف بيانات_ملف_جلسة(المسار: &نص): اختياري بيانات_ملف_جلسة_ناتجة {
    طابق حجم_المسار(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الحجم) -> {
        طابق وقت_تعديل_المسار_نانو(المسار) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(الوقت) -> {
            دع البيانات: بيانات_ملف_جلسة_ناتجة = { الحجم: الحجم, الوقت: الوقت };
            أرجع اختياري.موجود(البيانات);
        };
    };
}

// A module's current text. A file whose size and modification time are those
// recorded for it keeps its recorded hash; an editor's unsaved text, a C
// import and any other file are read and hashed.
عرف حالة_نص_حالية_جلسة(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    الهدف: &اختياري واصف_هدف,
    المسار: &نص,
    السابقة: &اختياري حالة_نص_جلسة
): حالة_نص_جلسة {
    دع بلا_بيانات: متغير منطقي = (الطول(*المسار) مثل طبيعي) == 0 || هل_مصدر_سي(المسار);
    إذا (!بلا_بيانات) {
        دع التراكب: نتيجة_محتوى_تراكب_مصدر = محتوى_تراكب_مصدر(&(*البيئة).مزود_المصادر, المسار);
        بلا_بيانات := التراكب.موجود;
    };
    دع الحجم: متغير عدد = 0;
    دع الوقت: متغير عدد = 0;
    إذا (!بلا_بيانات) {
        طابق بيانات_ملف_جلسة(المسار) مع
        | اختياري.موجود(البيانات) -> {
            الحجم := البيانات.الحجم;
            الوقت := البيانات.الوقت;
            طابق *السابقة مع
            | اختياري.موجود(القديمة) -> {
                إذا (!القديمة.بلا_بيانات && القديمة.الحجم == الحجم && القديمة.وقت_التعديل == الوقت) {
                    دع المحفوظة: حالة_نص_جلسة = {
                        الهاش: القديمة.الهاش, الحجم: الحجم, وقت_التعديل: الوقت, بلا_بيانات: خطأ
                    };
                    أرجع المحفوظة;
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { بلا_بيانات := صواب; };
    };
    دع الحالة: حالة_نص_جلسة = {
        الهاش: هاش_مصدر_حالي_جلسة(البيئة, المفتاح, الهدف),
        الحجم: الحجم,
        وقت_التعديل: الوقت,
        بلا_بيانات: بلا_بيانات
    };
    أرجع الحالة;
}

// ---- Session -----------------------------------------------------------------

// One module of the last request.
عام نوع وحدة_جلسة_تحليل = {
    المفتاح: مفتاح_وحدة_مقنن,
    هاش_المفتاح: طبيعي,
    // The hash of the text it was analysed from.
    الهاش: طبيعي,
    // The file it was read from, and what the request knew of it.
    المسار: نص,
    النص: حالة_نص_جلسة,
    // Positions in the record of the modules it imports.
    الاستيرادات: متجه طبيعي,
    // Outside the request's workspace roots (std, packages).
    أساسية: منطقي,
    // An import of it could not be loaded: analysed again on every request.
    متسخة: منطقي,
    // A folder's root file (`module` spellings): a change invalidates everything.
    ملف_جذر: منطقي
};

// A kept state: its modules (all analysed) and the hash of each text.
عام نوع لقطة_تحليل = {
    الحالة: حالة_واجهة_مرحلية,
    الهاشات_المفتاحية: متجه طبيعي,
    المفاتيح: متجه مفتاح_وحدة_مقنن,
    الهاشات: متجه طبيعي,
    // The root files read for module spellings, and their text hashes.
    ملفات_الجذور: متجه نص,
    هاشات_ملفات_الجذور: متجه طبيعي,
    // Which kept state this is (one number per state the session ever made),
    // and how many module trees it holds: the ownership analysis of those
    // trees is made once per state (ملكية_مخبأة_واجهة).
    التوليد: طبيعي,
    عدد_الأشجار: طبيعي
};

// What the last request did (for an editor's status and for measurements).
عام نوع إحصاء_طلب_جلسة = {
    // 0: no kept state (a full analysis), 1: الأساس, 2: المساحة.
    اللقطة: طبيعي,
    // Modules analysed by this request, and reused from the kept state.
    المحللة: طبيعي,
    المعاد_استعمالها: طبيعي,
    // Module texts changed since the request before.
    المتغيرة: طبيعي,
    بنيت_لقطة_الأساس: منطقي,
    بنيت_لقطة_المساحة: منطقي,
    // A full analysis: first request, configuration change or fallback.
    كاملة: منطقي,
    // The kept state was the copy made ahead (جهز_جلسة_تحليل).
    جاهزة: منطقي
};

عام نوع جلسة_تحليل_تزايدي = {
    لها_بصمة: منطقي,
    البصمة: طبيعي,
    الأساس: اختياري لقطة_تحليل,
    المساحة: اختياري لقطة_تحليل,
    السجل: متجه وحدة_جلسة_تحليل,
    // The modules changed by the last request that changed any.
    الساخنة: متجه مفتاح_وحدة_مقنن,
    // The editor's open documents (عيّن_مستندات_مفتوحة_جلسة).
    المفتوحة: متجه مفتاح_وحدة_مقنن,
    // A copy of a kept state made ahead (جهز_جلسة_تحليل), and which one:
    // 1 الأساس, 2 المساحة.
    الجاهزة: اختياري حالة_واجهة_مرحلية,
    الجاهزة_من: طبيعي,
    الإحصاء: إحصاء_طلب_جلسة,
    // The number of the next kept state, and the ownership analysis of the
    // modules of the kept state the last request started from.
    التوليد_التالي: طبيعي,
    الملكية_المخبأة: اختياري ملكية_مخبأة_واجهة
};

عرف إحصاء_طلب_جلسة_فارغ(): إحصاء_طلب_جلسة {
    دع الإحصاء: إحصاء_طلب_جلسة = {
        اللقطة: 0, المحللة: 0, المعاد_استعمالها: 0, المتغيرة: 0,
        بنيت_لقطة_الأساس: خطأ, بنيت_لقطة_المساحة: خطأ, كاملة: خطأ, جاهزة: خطأ
    };
    أرجع الإحصاء;
}

عام عرف جلسة_تحليل_تزايدي_جديدة(): جلسة_تحليل_تزايدي {
    دع السجل: متجه وحدة_جلسة_تحليل = [];
    دع الساخنة: متجه مفتاح_وحدة_مقنن = [];
    دع المفتوحة: متجه مفتاح_وحدة_مقنن = [];
    دع الجلسة: جلسة_تحليل_تزايدي = {
        لها_بصمة: خطأ,
        البصمة: 0,
        الأساس: اختياري.لا_شيء(),
        المساحة: اختياري.لا_شيء(),
        السجل: السجل,
        الساخنة: الساخنة,
        المفتوحة: المفتوحة,
        الجاهزة: اختياري.لا_شيء(),
        الجاهزة_من: 0,
        الإحصاء: إحصاء_طلب_جلسة_فارغ(),
        التوليد_التالي: 1,
        الملكية_المخبأة: اختياري.لا_شيء()
    };
    أرجع الجلسة;
}

// Drops every kept state: the next request is a full analysis.
عام عرف أفرغ_جلسة_تحليل(الجلسة: &متغير جلسة_تحليل_تزايدي): فراغ {
    دع السجل: متجه وحدة_جلسة_تحليل = [];
    دع الساخنة: متجه مفتاح_وحدة_مقنن = [];
    (*الجلسة).لها_بصمة := خطأ;
    (*الجلسة).الأساس := اختياري.لا_شيء();
    (*الجلسة).المساحة := اختياري.لا_شيء();
    (*الجلسة).السجل := السجل;
    (*الجلسة).الساخنة := الساخنة;
    (*الجلسة).الملكية_المخبأة := اختياري.لا_شيء();
    أسقط_الجاهزة(الجلسة);
}

عرف أسقط_الجاهزة(الجلسة: &متغير جلسة_تحليل_تزايدي): فراغ {
    (*الجلسة).الجاهزة := اختياري.لا_شيء();
    (*الجلسة).الجاهزة_من := 0;
}

// Copies the kept state the next request is likely to start from, so that
// request does not copy it. An editor calls it while it waits for input
// (after it has shown a result); a request takes the copy only when it starts
// from that same kept state. Does nothing when a copy is ready.
عام عرف جهز_جلسة_تحليل(الجلسة: &متغير جلسة_تحليل_تزايدي): فراغ {
    طابق (*الجلسة).الجاهزة مع
    | اختياري.موجود(_) -> { أرجع; }
    | اختياري.لا_شيء -> { };
    طابق (*الجلسة).المساحة مع
    | اختياري.موجود(اللقطة) -> {
        (*الجلسة).الجاهزة := اختياري.موجود(استنسخ(&اللقطة.الحالة));
        (*الجلسة).الجاهزة_من := 2;
        أرجع;
    }
    | اختياري.لا_شيء -> { };
    طابق (*الجلسة).الأساس مع
    | اختياري.موجود(اللقطة) -> {
        (*الجلسة).الجاهزة := اختياري.موجود(استنسخ(&اللقطة.الحالة));
        (*الجلسة).الجاهزة_من := 1;
    }
    | اختياري.لا_شيء -> { };
}

// The copy made ahead of kept state اللقطة, taken out of the session; none when
// there is none of that state.
عرف خذ_الجاهزة(الجلسة: &متغير جلسة_تحليل_تزايدي, اللقطة: طبيعي): اختياري حالة_واجهة_مرحلية {
    إذا ((*الجلسة).الجاهزة_من != اللقطة) { أرجع اختياري.لا_شيء(); };
    دع المأخوذة: متغير اختياري حالة_واجهة_مرحلية = اختياري.لا_شيء();
    بدّل((*الجلسة).الجاهزة, المأخوذة);
    (*الجلسة).الجاهزة_من := 0;
    أرجع المأخوذة;
}

// The workspace modules the editor has open: they are likely to change, so the
// kept workspace state leaves them (and the modules that import them) out, and
// their first edit already reuses it. A std or package module that is open is
// kept until it changes.
عام عرف عيّن_مستندات_مفتوحة_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    المفاتيح: متجه مفتاح_وحدة_مقنن
): فراغ {
    (*الجلسة).المفتوحة := المفاتيح;
}

عام عرف إحصاء_جلسة_تحليل(الجلسة: &جلسة_تحليل_تزايدي): إحصاء_طلب_جلسة {
    أرجع (*الجلسة).الإحصاء;
}

عرف موضع_في_السجل(
    السجل: &متجه وحدة_جلسة_تحليل, المفتاح: &مفتاح_وحدة_مقنن, هاش_المفتاح: طبيعي
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السجل) مثل طبيعي)) {
        إذا ((*السجل)[ف].هاش_المفتاح == هاش_المفتاح
            && مفتاحا_وحدة_متساويان(&(*السجل)[ف].المفتاح, المفتاح)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف مفتاح_في_قائمة(القائمة: &متجه مفتاح_وحدة_مقنن, المفتاح: &مفتاح_وحدة_مقنن): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (مفتاحا_وحدة_متساويان(&(*القائمة)[ف], المفتاح)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف جذر_في_قائمة(القائمة: &متجه طبيعي, الجذر: طبيعي): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا ((*القائمة)[ف] == الجذر) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The module key of a state's module.
عرف مفتاح_وحدة_في_حالة(الحالة: &حالة_واجهة_مرحلية, الوحدة: معرف_وحدة): اختياري مفتاح_وحدة_مقنن {
    طابق وحدة_محملة_بالمعرف(&(*الحالة).المحمل, الوحدة) مع
    | اختياري.موجود(المحملة) -> { أرجع اختياري.موجود(انسخ_مفتاح_وحدة_مقنن(&المحملة.المفتاح)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// The current text of a module: from this request's reads, else read now.
عرف حالة_نص_لمفتاح(
    السجل: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    المفتاح: &مفتاح_وحدة_مقنن,
    المسار: &نص
): حالة_نص_جلسة {
    دع هاش_المفتاح: طبيعي = هاش_مفتاح_جلسة(0, المفتاح);
    طابق موضع_في_السجل(السجل, المفتاح, هاش_المفتاح) مع
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع < (الطول(*الحالية) مثل طبيعي)) { أرجع (*الحالية)[الموضع]; };
    }
    | اختياري.لا_شيء -> { };
    دع بلا_سابقة: اختياري حالة_نص_جلسة = اختياري.لا_شيء();
    أرجع حالة_نص_حالية_جلسة(البيئة, المفتاح, الهدف, المسار, &بلا_سابقة);
}

عرف هاش_حالي_لمفتاح(
    السجل: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    المفتاح: &مفتاح_وحدة_مقنن,
    المسار: &نص
): طبيعي {
    طابق حالة_نص_لمفتاح(السجل, الحالية, البيئة, الهدف, المفتاح, المسار).الهاش مع
    | اختياري.موجود(الهاش) -> { أرجع الهاش; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

// The file a state's module was read from.
عرف مسار_وحدة_في_حالة(الحالة: &حالة_واجهة_مرحلية, الوحدة: معرف_وحدة): نص {
    طابق وحدة_محملة_بالمعرف(&(*الحالة).المحمل, الوحدة) مع
    | اختياري.موجود(المحملة) -> { أرجع انسخ_نص(&المحملة.مسار_ملف_المصدر); }
    | اختياري.لا_شيء -> { أرجع «»; };
}

// The record of an analysed state's modules, in load order.
عرف سجل_من_حالة(
    الحالة: &حالة_واجهة_مرحلية,
    السجل_القديم: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    جذور_المساحة: &متجه طبيعي
): متجه وحدة_جلسة_تحليل {
    دع السجل: متغير متجه وحدة_جلسة_تحليل = [];
    دع مواضع_الوحدات: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).المحمل.المحملة) مثل طبيعي)) {
        ألحق(مواضع_الوحدات, اختياري.لا_شيء());
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
        دع الوحدة: معرف_وحدة = (*الحالة).الوحدات[ف].الوحدة;
        طابق مفتاح_وحدة_في_حالة(الحالة, الوحدة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المفتاح) -> {
            دع المسار: نص = مسار_وحدة_في_حالة(الحالة, الوحدة);
            دع النص: حالة_نص_جلسة = حالة_نص_لمفتاح(السجل_القديم, الحالية, البيئة, الهدف, &المفتاح, &المسار);
            دع الهاش: متغير طبيعي = 0;
            طابق النص.الهاش مع
            | اختياري.موجود(القيمة) -> { الهاش := القيمة; }
            | اختياري.لا_شيء -> { };
            دع المصدر: طبيعي = (*الحالة).أشجار_الوحدات[(*الحالة).الوحدات[ف].الشجرة].معرف_المصدر;
            دع ملف_جذر: منطقي =
                (الطول((*الحالة).أشجار_الوحدات[(*الحالة).الوحدات[ف].الشجرة].تصريحات_الوحدات) مثل طبيعي) > 0;
            دع بلا_استيرادات: متجه طبيعي = [];
            دع السجل_الجديد: وحدة_جلسة_تحليل = {
                المفتاح: انسخ_مفتاح_وحدة_مقنن(&المفتاح),
                هاش_المفتاح: هاش_مفتاح_جلسة(0, &المفتاح),
                الهاش: الهاش,
                المسار: المسار,
                النص: النص,
                الاستيرادات: بلا_استيرادات,
                أساسية: !جذر_في_قائمة(جذور_المساحة, المفتاح.الجذر.القيمة),
                متسخة: سجل_مصدرا_فاشلا_في(&(*الحالة).إخفاقات_التحميل.بلا_تحميل, المصدر),
                ملف_جذر: ملف_جذر
            };
            إذا ((الوحدة.القيمة مثل طبيعي) < (الطول(مواضع_الوحدات) مثل طبيعي)) {
                مواضع_الوحدات[الوحدة.القيمة] := اختياري.موجود(الطول(السجل) مثل طبيعي);
            };
            ألحق(السجل, السجل_الجديد);
        };
        ف := ف + 1;
    }
    // Import edges, as positions in the record.
    ف := 0;
    طالما (ف < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
        دع الوحدة: معرف_وحدة = (*الحالة).الوحدات[ف].الوحدة;
        إذا ((الوحدة.القيمة مثل طبيعي) < (الطول(مواضع_الوحدات) مثل طبيعي)) {
            طابق مواضع_الوحدات[الوحدة.القيمة] مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الموضع) -> {
                دع العدد: طبيعي = عدد_استيرادات_الوحدة(&(*الحالة).الرسم, الوحدة);
                دع ي: متغير طبيعي = 0;
                طالما (ي < العدد) {
                    دع المستورد: معرف_وحدة = استيراد_الوحدة_عند(&(*الحالة).الرسم, الوحدة, ي);
                    إذا ((المستورد.القيمة مثل طبيعي) < (الطول(مواضع_الوحدات) مثل طبيعي)) {
                        طابق مواضع_الوحدات[المستورد.القيمة] مع
                        | اختياري.موجود(موضع_المستورد) -> { ألحق(السجل[الموضع].الاستيرادات, موضع_المستورد); }
                        | اختياري.لا_شيء -> { };
                    };
                    ي := ي + 1;
                }
            };
        };
        ف := ف + 1;
    }
    أرجع السجل;
}

عرف سجل_مصدرا_فاشلا_في(القائمة: &متجه طبيعي, المصدر: طبيعي): منطقي {
    أرجع جذر_في_قائمة(القائمة, المصدر);
}

// Keeps a copy of an analysed state, with its modules' keys and text hashes.
عرف التقط_حالة(
    الحالة: &حالة_واجهة_مرحلية,
    السجل: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    التوليد: طبيعي
): لقطة_تحليل {
    دع المفاتيح: متغير متجه مفتاح_وحدة_مقنن = [];
    دع الهاشات_المفتاحية: متغير متجه طبيعي = [];
    دع الهاشات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
        طابق مفتاح_وحدة_في_حالة(الحالة, (*الحالة).الوحدات[ف].الوحدة) مع
        | اختياري.موجود(المفتاح) -> {
            دع المسار: نص = مسار_وحدة_في_حالة(الحالة, (*الحالة).الوحدات[ف].الوحدة);
            ألحق(الهاشات, هاش_حالي_لمفتاح(السجل, الحالية, البيئة, الهدف, &المفتاح, &المسار));
            ألحق(الهاشات_المفتاحية, هاش_مفتاح_جلسة(0, &المفتاح));
            ألحق(المفاتيح, المفتاح);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع ملفات_الجذور: متغير متجه نص = [];
    دع هاشات_ملفات_الجذور: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*الحالة).المحمل.تهجئات_الوحدات.المجلدات) مثل طبيعي)) {
        دع المسار: نص = انسخ_نص(&(*الحالة).المحمل.تهجئات_الوحدات.المجلدات[ف].ملف_الجذر);
        ألحق(هاشات_ملفات_الجذور, هاش_ملف_جذر_جلسة(البيئة, &المسار));
        ألحق(ملفات_الجذور, المسار);
        ف := ف + 1;
    }
    دع اللقطة: لقطة_تحليل = {
        الحالة: استنسخ(الحالة),
        الهاشات_المفتاحية: الهاشات_المفتاحية,
        المفاتيح: المفاتيح,
        الهاشات: الهاشات,
        ملفات_الجذور: ملفات_الجذور,
        هاشات_ملفات_الجذور: هاشات_ملفات_الجذور,
        التوليد: التوليد,
        عدد_الأشجار: الطول((*الحالة).أشجار_الوحدات) مثل طبيعي
    };
    أرجع اللقطة;
}

عرف هاش_ملف_جذر_جلسة(البيئة: &بيئة_وحدات_منطقية, المسار: &نص): طبيعي {
    طابق نص_ملف_جذر(البيئة, المسار) مع
    | اختياري.موجود(النص) -> { أرجع هاش_نص_جلسة(&النص); }
    | اختياري.لا_شيء -> { أرجع 1; };
}

// A kept state still holds what a full analysis would: none of its modules
// changed, and its root files and packages are as they were.
عرف لقطة_صالحة(
    اللقطة: &لقطة_تحليل,
    السجل: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البذور: &متجه منطقي,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*اللقطة).المفاتيح) مثل طبيعي)) {
        طابق موضع_في_السجل(السجل, &(*اللقطة).المفاتيح[ف], (*اللقطة).الهاشات_المفتاحية[ف]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الموضع) -> {
            إذا (الموضع >= (الطول(*الحالية) مثل طبيعي)) { أرجع خطأ; };
            إذا (الموضع < (الطول(*البذور) مثل طبيعي) && (*البذور)[الموضع]) { أرجع خطأ; };
            طابق (*الحالية)[الموضع].الهاش مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(الهاش) -> {
                إذا (الهاش != (*اللقطة).الهاشات[ف]) { أرجع خطأ; };
            };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*اللقطة).ملفات_الجذور) مثل طبيعي)) {
        إذا (هاش_ملف_جذر_جلسة(البيئة, &(*اللقطة).ملفات_الجذور[ف]) != (*اللقطة).هاشات_ملفات_الجذور[ف]) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    // A package's members are discovered from its folder: a file added or
    // removed there changes what importing the package means.
    دع المحمل: &محمل_وحدات = &(*اللقطة).الحالة.المحمل;
    ف := 0;
    طالما (ف < (الطول((*المحمل).الحزم_المكتشفة) مثل طبيعي)) {
        طابق اكتشف_أعضاء_حزمة_مصدر_لهدف(البيئة, &(*المحمل).الحزم_المكتشفة[ف].المفتاح, الهدف) مع
        | نتيجة_اكتشاف_أعضاء_حزمة.موجودة(الأعضاء) -> {
            دع القديمة: &متجه مفتاح_وحدة_مقنن = &(*المحمل).الحزم_المكتشفة[ف].الأعضاء;
            إذا (الطول(الأعضاء) != الطول(*القديمة)) { أرجع خطأ; };
            دع ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الأعضاء) مثل طبيعي)) {
                إذا (!مفتاحا_وحدة_متساويان(&الأعضاء[ع], &(*القديمة)[ع])) { أرجع خطأ; };
                ع := ع + 1;
            }
        }
        | _ -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Every module of the state is reached from the request's roots.
عرف كل_الوحدات_مستوردة(
    الحالة: &حالة_واجهة_مرحلية,
    الجذور: &متجه معرف_وحدة
): منطقي {
    دع العدد: طبيعي = الطول((*الحالة).المحمل.المحملة) مثل طبيعي;
    دع المبلوغة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(المبلوغة, خطأ); ف := ف + 1; }
    دع المكدس: متغير متجه معرف_وحدة = [];
    ف := 0;
    طالما (ف < (الطول(*الجذور) مثل طبيعي)) {
        دع الجذر: معرف_وحدة = (*الجذور)[ف];
        إذا ((الجذر.القيمة مثل طبيعي) < العدد && !المبلوغة[الجذر.القيمة]) {
            المبلوغة[الجذر.القيمة] := صواب;
            ألحق(المكدس, الجذر);
        };
        ف := ف + 1;
    }
    طالما ((الطول(المكدس) مثل طبيعي) > 0) {
        دع الوحدة: معرف_وحدة = المكدس[(الطول(المكدس) مثل طبيعي) - 1];
        أزل_الأخير(المكدس);
        دع عدد_الاستيرادات: طبيعي = عدد_استيرادات_الوحدة(&(*الحالة).الرسم, الوحدة);
        دع ي: متغير طبيعي = 0;
        طالما (ي < عدد_الاستيرادات) {
            دع المستورد: معرف_وحدة = استيراد_الوحدة_عند(&(*الحالة).الرسم, الوحدة, ي);
            إذا ((المستورد.القيمة مثل طبيعي) < العدد && !المبلوغة[المستورد.القيمة]) {
                المبلوغة[المستورد.القيمة] := صواب;
                ألحق(المكدس, المستورد);
            };
            ي := ي + 1;
        }
    }
    ف := 0;
    طالما (ف < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
        دع الوحدة: معرف_وحدة = (*الحالة).الوحدات[ف].الوحدة;
        إذا ((الوحدة.القيمة مثل طبيعي) < العدد && !المبلوغة[الوحدة.القيمة]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف معرف_وحدة_لمفتاح(الحالة: &حالة_واجهة_مرحلية, المفتاح: &مفتاح_وحدة_مقنن): اختياري معرف_وحدة {
    طابق وحدة_محملة_بالمفتاح(&(*الحالة).المحمل, المفتاح) مع
    | اختياري.موجود(المحملة) -> { أرجع اختياري.موجود(المحملة.الوحدة); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// ---- Requests ----------------------------------------------------------------

نوع ناتج_طلب_مرحلي =
    | مكتمل بنوع نتيجة_بناء_واجهة_قابلة_للإلغاء
    // Something a kept state cannot account for: analyse in full.
    | كامل
;

// Analyses a tooling request (الطلب.احتفظ_بحقائق_الأدوات) in the session: the
// same result as ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء, reusing what the session
// kept. A cancelled request leaves the kept states as they were. A request
// without tooling facts (a compilation) does not use the session.
عام عرف ابن_واجهة_في_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    الطلب: طلب_واجهة_وحدة,
    الهدف: اختياري واصف_هدف,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
    إذا (!الطلب.احتفظ_بحقائق_الأدوات) {
        أرجع ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, الهدف, المفاتيح_الإضافية, الإلغاء);
    };
    دع البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    دع الجذر: &مفتاح_وحدة_مقنن = &الطلب.المفتاح_الجذري;
    دع البصمة: طبيعي = بصمة_طلب_جلسة(البيئة, &الهدف, الجذر, المفاتيح_الإضافية);
    إذا (!(*الجلسة).لها_بصمة || (*الجلسة).البصمة != البصمة) {
        أفرغ_جلسة_تحليل(الجلسة);
        (*الجلسة).لها_بصمة := صواب;
        (*الجلسة).البصمة := البصمة;
    };
    (*الجلسة).الإحصاء := إحصاء_طلب_جلسة_فارغ();
    دع جذور_المساحة: متغير متجه طبيعي = [(*الجذر).الجذر.القيمة];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المفاتيح_الإضافية) مثل طبيعي)) {
        ألحق(جذور_المساحة, (*المفاتيح_الإضافية)[ف].الجذر.القيمة);
        ف := ف + 1;
    }
    // The current text of every module of the last request.
    دع الحالية: متغير متجه حالة_نص_جلسة = [];
    دع المتغيرة: متغير متجه منطقي = [];
    دع عدد_المتغيرة: متغير طبيعي = 0;
    دع جذر_تغير: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < (الطول((*الجلسة).السجل) مثل طبيعي)) {
        // A file whose size and modification time did not change keeps its hash.
        دع السابقة: اختياري حالة_نص_جلسة = اختياري.موجود((*الجلسة).السجل[ف].النص);
        دع الحالي: حالة_نص_جلسة = حالة_نص_حالية_جلسة(
            البيئة, &(*الجلسة).السجل[ف].المفتاح, &الهدف, &(*الجلسة).السجل[ف].المسار, &السابقة
        );
        دع تغير: متغير منطقي = صواب;
        طابق الحالي.الهاش مع
        | اختياري.موجود(الهاش) -> { تغير := الهاش != (*الجلسة).السجل[ف].الهاش; }
        | اختياري.لا_شيء -> { };
        إذا (تغير) {
            عدد_المتغيرة := عدد_المتغيرة + 1;
            إذا ((*الجلسة).السجل[ف].ملف_جذر) { جذر_تغير := صواب; };
        };
        ألحق(الحالية, الحالي);
        ألحق(المتغيرة, تغير);
        ف := ف + 1;
    }
    (*الجلسة).الإحصاء.المتغيرة := عدد_المتغيرة;
    إذا (جذر_تغير || (الطول((*الجلسة).السجل) مثل طبيعي) == 0) {
        أرجع حلل_كاملا_في_جلسة(الجلسة, البيئة, الجذر, المفاتيح_الإضافية, الهدف, &جذور_المساحة, الإلغاء);
    };
    طابق حلل_مرحليا_في_جلسة(
        الجلسة, البيئة, الجذر, المفاتيح_الإضافية, استنسخ(&الهدف), &جذور_المساحة,
        &الحالية, &المتغيرة, الإلغاء
    ) مع
    | ناتج_طلب_مرحلي.مكتمل(الناتج) -> { أرجع الناتج; }
    | ناتج_طلب_مرحلي.كامل -> {
        أفرغ_جلسة_تحليل(الجلسة);
        (*الجلسة).لها_بصمة := صواب;
        (*الجلسة).البصمة := البصمة;
        أرجع حلل_كاملا_في_جلسة(الجلسة, البيئة, الجذر, المفاتيح_الإضافية, الهدف, &جذور_المساحة, الإلغاء);
    };
}

// A full analysis in one stage; the session records its modules for the next
// request (which builds the kept states).
عرف حلل_كاملا_في_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: &مفتاح_وحدة_مقنن,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الهدف: اختياري واصف_هدف,
    جذور_المساحة: &متجه طبيعي,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    (*الجلسة).الإحصاء.كاملة := صواب;
    (*الجلسة).الأساس := اختياري.لا_شيء();
    (*الجلسة).المساحة := اختياري.لا_شيء();
    أسقط_الجاهزة(الجلسة);
    طابق حلل_حالة_واجهة_كاملة(البيئة, الجذر, المفاتيح_الإضافية, استنسخ(&الهدف), صواب, الإلغاء) مع
    | ناتج_مرحلة_واجهة.ملغاة -> { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); }
    | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> {
        دع بلا_سجل: متجه وحدة_جلسة_تحليل = [];
        (*الجلسة).السجل := بلا_سجل;
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
    }
    | ناتج_مرحلة_واجهة.مكتملة(الحالة) -> {
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        دع بلا_حالية: متجه حالة_نص_جلسة = [];
        دع بلا_سجل_قديم: متجه وحدة_جلسة_تحليل = [];
        (*الجلسة).السجل := سجل_من_حالة(&الحالة, &بلا_سجل_قديم, &بلا_حالية, البيئة, &الهدف, جذور_المساحة);
        (*الجلسة).الإحصاء.المحللة := الطول(الحالة.الوحدات) مثل طبيعي;
        طابق أنه_واجهة_مرحلية(الحالة, البيئة, صواب) مع
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة); }
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات); };
    };
}

// Loads the given record modules into the state, the program root first.
عرف حمل_وحدات_سجل(
    الحالة: حالة_واجهة_مرحلية,
    السجل: &متجه وحدة_جلسة_تحليل,
    المواضع: &متجه طبيعي,
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: &مفتاح_وحدة_مقنن,
    الإلغاء: &حالة_إلغاء_واجهة
): ناتج_مرحلة_واجهة {
    دع الحالة_م: متغير حالة_واجهة_مرحلية = الحالة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        دع المفتاح: &مفتاح_وحدة_مقنن = &(*السجل)[(*المواضع)[ف]].المفتاح;
        إذا (مفتاحا_وحدة_متساويان(المفتاح, الجذر)) {
            طابق حمل_جذرا_في_حالة(الحالة_م, البيئة, المفتاح, صواب, صواب, الإلغاء) مع
            | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة_م := المحملة; }
            | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        دع المفتاح: &مفتاح_وحدة_مقنن = &(*السجل)[(*المواضع)[ف]].المفتاح;
        إذا (!مفتاحا_وحدة_متساويان(المفتاح, الجذر)) {
            طابق حمل_جذرا_في_حالة(الحالة_م, البيئة, المفتاح, خطأ, صواب, الإلغاء) مع
            | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة_م := المحملة; }
            | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
        };
        ف := ف + 1;
    }
    أرجع ناتج_مرحلة_واجهة.مكتملة(الحالة_م);
}

// Registers the primitives once, before a fresh state's first stage.
عرف ضمن_بدائيات_حالة(
    الحالة: &متغير حالة_واجهة_مرحلية,
    مسجلة: &متغير منطقي
): منطقي {
    إذا (*مسجلة) { أرجع صواب; };
    دع المالك: متغير معرف_وحدة = معرف_وحدة_من(0);
    طابق (*الحالة).الجذر مع
    | اختياري.موجود(المعرف) -> { المالك := المعرف; }
    | اختياري.لا_شيء -> {
        إذا ((الطول((*الحالة).الوحدات) مثل طبيعي) > 0) { المالك := (*الحالة).الوحدات[0].الوحدة; };
    };
    طابق سجل_بدائيات_في_حالة(الحالة, المالك) مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    *مسجلة := صواب;
    أرجع صواب;
}

عرف حلل_مرحليا_في_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: &مفتاح_وحدة_مقنن,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الهدف: اختياري واصف_هدف,
    جذور_المساحة: &متجه طبيعي,
    الحالية: &متجه حالة_نص_جلسة,
    المتغيرة: &متجه منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): ناتج_طلب_مرحلي {
    دع العدد: طبيعي = الطول((*الجلسة).السجل) مثل طبيعي;
    // The modules to analyse again: changed, failed imports, workspace modules
    // changed by the request before or open in the editor, and every module
    // that imports one of them.
    دع المتأثرة: متغير متجه منطقي = [];
    دع البذور: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    دع المتغيرة_الآن: متغير متجه مفتاح_وحدة_مقنن = [];
    طالما (ف < العدد) {
        دع متأثرة: منطقي = (*المتغيرة)[ف] || (*الجلسة).السجل[ف].متسخة
            || (!(*الجلسة).السجل[ف].أساسية
                && (مفتاح_في_قائمة(&(*الجلسة).الساخنة, &(*الجلسة).السجل[ف].المفتاح)
                    || مفتاح_في_قائمة(&(*الجلسة).المفتوحة, &(*الجلسة).السجل[ف].المفتاح)));
        ألحق(المتأثرة, متأثرة);
        ألحق(البذور, متأثرة);
        إذا ((*المتغيرة)[ف]) { ألحق(المتغيرة_الآن, انسخ_مفتاح_وحدة_مقنن(&(*الجلسة).السجل[ف].المفتاح)); };
        ف := ف + 1;
    }
    دع تابع: متغير منطقي = صواب;
    طالما (تابع) {
        تابع := خطأ;
        ف := 0;
        طالما (ف < العدد) {
            إذا (!المتأثرة[ف]) {
                دع ي: متغير طبيعي = 0;
                طالما (ي < (الطول((*الجلسة).السجل[ف].الاستيرادات) مثل طبيعي)) {
                    دع المستورد: طبيعي = (*الجلسة).السجل[ف].الاستيرادات[ي];
                    إذا (المستورد < العدد && المتأثرة[المستورد] && !المتأثرة[ف]) {
                        المتأثرة[ف] := صواب;
                        تابع := صواب;
                    };
                    ي := ي + 1;
                }
            };
            ف := ف + 1;
        }
    }
    // The largest kept state none of whose modules changed.
    طابق (*الجلسة).المساحة مع
    | اختياري.موجود(اللقطة) -> {
        إذا (!لقطة_صالحة(&اللقطة, &(*الجلسة).السجل, الحالية, &البذور, البيئة, &الهدف)) {
            (*الجلسة).المساحة := اختياري.لا_شيء();
            إذا ((*الجلسة).الجاهزة_من == 2) { أسقط_الجاهزة(الجلسة); };
        };
    }
    | اختياري.لا_شيء -> { };
    طابق (*الجلسة).الأساس مع
    | اختياري.موجود(اللقطة) -> {
        إذا (!لقطة_صالحة(&اللقطة, &(*الجلسة).السجل, الحالية, &البذور, البيئة, &الهدف)) {
            (*الجلسة).الأساس := اختياري.لا_شيء();
            إذا ((*الجلسة).الجاهزة_من == 1) { أسقط_الجاهزة(الجلسة); };
        };
    }
    | اختياري.لا_شيء -> { };
    دع الحالة: متغير حالة_واجهة_مرحلية = حالة_واجهة_مرحلية_جديدة(استنسخ(&الهدف));
    دع المغطاة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(المغطاة, خطأ); ف := ف + 1; }
    دع اللقطة_المستعملة: متغير طبيعي = 0;
    دع البدائيات_مسجلة: متغير منطقي = خطأ;
    دع المعاد: متغير طبيعي = 0;
    طابق (*الجلسة).الأساس مع
    | اختياري.موجود(_) -> { اللقطة_المستعملة := 1; }
    | اختياري.لا_شيء -> { };
    طابق (*الجلسة).المساحة مع
    | اختياري.موجود(_) -> { اللقطة_المستعملة := 2; }
    | اختياري.لا_شيء -> { };
    // The copy made ahead (جهز_جلسة_تحليل) when there is one, else a copy now.
    إذا (اللقطة_المستعملة > 0) {
        طابق خذ_الجاهزة(الجلسة, اللقطة_المستعملة) مع
        | اختياري.موجود(الجاهزة) -> {
            الحالة := الجاهزة;
            (*الجلسة).الإحصاء.جاهزة := صواب;
        }
        | اختياري.لا_شيء -> {
            إذا (اللقطة_المستعملة == 2) {
                طابق (*الجلسة).المساحة مع
                | اختياري.موجود(اللقطة) -> { الحالة := استنسخ(&اللقطة.الحالة); }
                | اختياري.لا_شيء -> { };
            } وإلا {
                طابق (*الجلسة).الأساس مع
                | اختياري.موجود(اللقطة) -> { الحالة := استنسخ(&اللقطة.الحالة); }
                | اختياري.لا_شيء -> { };
            };
        };
    };
    إذا (اللقطة_المستعملة > 0) {
        البدائيات_مسجلة := صواب;
        المعاد := الحالة.المعالجة;
        ف := 0;
        طالما (ف < (الطول(الحالة.الوحدات) مثل طبيعي)) {
            طابق مفتاح_وحدة_في_حالة(&الحالة, الحالة.الوحدات[ف].الوحدة) مع
            | اختياري.موجود(المفتاح) -> {
                طابق موضع_في_السجل(&(*الجلسة).السجل, &المفتاح, هاش_مفتاح_جلسة(0, &المفتاح)) مع
                | اختياري.موجود(الموضع) -> { المغطاة[الموضع] := صواب; }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        // Package export indexes are rebuilt from the current member texts.
        دع بلا_فهارس: متجه فهرس_تصديرات_حزمة = [];
        الحالة.المحمل.فهارس_تصديرات_الحزم := بلا_فهارس;
    };
    (*الجلسة).الإحصاء.اللقطة := اللقطة_المستعملة;
    (*الجلسة).الإحصاء.المعاد_استعمالها := المعاد;
    // The kept state the analysis continues: its number and module trees
    // (a later stage that makes a new kept state replaces them).
    دع توليد_الحالة: متغير طبيعي = 0;
    دع أشجار_الحالة: متغير طبيعي = 0;
    إذا (اللقطة_المستعملة == 2) {
        طابق (*الجلسة).المساحة مع
        | اختياري.موجود(اللقطة) -> { توليد_الحالة := اللقطة.التوليد; أشجار_الحالة := اللقطة.عدد_الأشجار; }
        | اختياري.لا_شيء -> { };
    } وإلا إذا (اللقطة_المستعملة == 1) {
        طابق (*الجلسة).الأساس مع
        | اختياري.موجود(اللقطة) -> { توليد_الحالة := اللقطة.التوليد; أشجار_الحالة := اللقطة.عدد_الأشجار; }
        | اختياري.لا_شيء -> { };
    };

    // Stage 1: std and package modules a kept state lacks (only before the
    // workspace modules).
    إذا (اللقطة_المستعملة < 2) {
        دع الأساسية: متغير متجه طبيعي = [];
        ف := 0;
        طالما (ف < العدد) {
            إذا ((*الجلسة).السجل[ف].أساسية && !المتأثرة[ف] && !المغطاة[ف]) { ألحق(الأساسية, ف); };
            ف := ف + 1;
        }
        إذا ((الطول(الأساسية) مثل طبيعي) > 0) {
            طابق حمل_وحدات_سجل(الحالة, &(*الجلسة).السجل, &الأساسية, البيئة, الجذر, الإلغاء) مع
            | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
            | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
            إذا (!ضمن_بدائيات_حالة(&متغير الحالة, &متغير البدائيات_مسجلة)) { أرجع ناتج_طلب_مرحلي.كامل(); };
            طابق حلل_مرحلة_واجهة(الحالة, البيئة, صواب, خطأ, الإلغاء) مع
            | ناتج_مرحلة_واجهة.مكتملة(المحللة) -> { الحالة := المحللة; }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
            | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
            إذا (!الحالة.الأنواع_متوقفة) {
                إذا ((*الجلسة).الجاهزة_من == 1) { أسقط_الجاهزة(الجلسة); };
                (*الجلسة).الأساس := اختياري.موجود(
                    التقط_حالة(&الحالة, &(*الجلسة).السجل, الحالية, البيئة, &الهدف, (*الجلسة).التوليد_التالي)
                );
                توليد_الحالة := (*الجلسة).التوليد_التالي;
                أشجار_الحالة := الطول(الحالة.أشجار_الوحدات) مثل طبيعي;
                (*الجلسة).التوليد_التالي := (*الجلسة).التوليد_التالي + 1;
                (*الجلسة).الإحصاء.بنيت_لقطة_الأساس := صواب;
            };
        };
    };

    // Stage 2: the workspace modules no change reaches.
    دع الباقية: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) {
        إذا (!(*الجلسة).السجل[ف].أساسية && !المتأثرة[ف] && !المغطاة[ف]) { ألحق(الباقية, ف); };
        ف := ف + 1;
    }
    إذا ((الطول(الباقية) مثل طبيعي) > 0) {
        طابق حمل_وحدات_سجل(الحالة, &(*الجلسة).السجل, &الباقية, البيئة, الجذر, الإلغاء) مع
        | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
        | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
        | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
        إذا (!ضمن_بدائيات_حالة(&متغير الحالة, &متغير البدائيات_مسجلة)) { أرجع ناتج_طلب_مرحلي.كامل(); };
        طابق حلل_مرحلة_واجهة(الحالة, البيئة, صواب, خطأ, الإلغاء) مع
        | ناتج_مرحلة_واجهة.مكتملة(المحللة) -> { الحالة := المحللة; }
        | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
        | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
        إذا (!الحالة.الأنواع_متوقفة) {
            إذا ((*الجلسة).الجاهزة_من == 2) { أسقط_الجاهزة(الجلسة); };
            (*الجلسة).المساحة := اختياري.موجود(
                التقط_حالة(&الحالة, &(*الجلسة).السجل, الحالية, البيئة, &الهدف, (*الجلسة).التوليد_التالي)
            );
            توليد_الحالة := (*الجلسة).التوليد_التالي;
            أشجار_الحالة := الطول(الحالة.أشجار_الوحدات) مثل طبيعي;
            (*الجلسة).التوليد_التالي := (*الجلسة).التوليد_التالي + 1;
            (*الجلسة).الإحصاء.بنيت_لقطة_المساحة := صواب;
        };
    };

    // Stage 3: the roots, which load the changed modules, their importers and
    // anything new.
    دع قبل_الأخيرة: طبيعي = الحالة.المعالجة;
    طابق حمل_جذرا_في_حالة(الحالة, البيئة, الجذر, صواب, صواب, الإلغاء) مع
    | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
    | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
    | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
    ف := 0;
    طالما (ف < (الطول(*المفاتيح_الإضافية) مثل طبيعي)) {
        طابق حمل_جذرا_في_حالة(الحالة, البيئة, &(*المفاتيح_الإضافية)[ف], خطأ, صواب, الإلغاء) مع
        | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
        | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
        | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
        ف := ف + 1;
    }
    // std's modules that join without an import, as a full analysis loads them.
    طابق حمل_جذور_المكتبة_الضمنية(
        الحالة, البيئة, هدف_تخدمه_المكتبة_القياسية(&الهدف), صواب, الإلغاء
    ) مع
    | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
    | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
    | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); };
    // A module a kept state holds that the roots no longer reach would not be
    // in a full analysis. std's implicit modules count as roots.
    دع معرفات_الجذور: متغير متجه معرف_وحدة = [];
    دع مفاتيح_ضمنية: متجه مفتاح_وحدة_مقنن = مفاتيح_جذور_المكتبة_الضمنية(البيئة);
    ف := 0;
    طالما (ف < (الطول(مفاتيح_ضمنية) مثل طبيعي)) {
        طابق معرف_وحدة_لمفتاح(&الحالة, &مفاتيح_ضمنية[ف]) مع
        | اختياري.موجود(المعرف) -> { ألحق(معرفات_الجذور, المعرف); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق معرف_وحدة_لمفتاح(&الحالة, الجذر) مع
    | اختياري.موجود(المعرف) -> { ألحق(معرفات_الجذور, المعرف); }
    | اختياري.لا_شيء -> { };
    ف := 0;
    طالما (ف < (الطول(*المفاتيح_الإضافية) مثل طبيعي)) {
        طابق معرف_وحدة_لمفتاح(&الحالة, &(*المفاتيح_الإضافية)[ف]) مع
        | اختياري.موجود(المعرف) -> { ألحق(معرفات_الجذور, المعرف); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    إذا (!كل_الوحدات_مستوردة(&الحالة, &معرفات_الجذور)) { أرجع ناتج_طلب_مرحلي.كامل(); };
    إذا (!ضمن_بدائيات_حالة(&متغير الحالة, &متغير البدائيات_مسجلة)) { أرجع ناتج_طلب_مرحلي.كامل(); };
    إذا ((الطول(الحالة.الوحدات) مثل طبيعي) > الحالة.المعالجة || الحالة.المعالجة == 0) {
        طابق حلل_مرحلة_واجهة(الحالة, البيئة, صواب, صواب, الإلغاء) مع
        | ناتج_مرحلة_واجهة.مكتملة(المحللة) -> { الحالة := المحللة; }
        | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
        | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
    } وإلا {
        طابق الحالة.شجرة_الجذر مع
        | اختياري.لا_شيء -> { أرجع ناتج_طلب_مرحلي.كامل(); }
        | اختياري.موجود(_) -> { };
    };
    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); };
    (*الجلسة).الإحصاء.المحللة := (الطول(الحالة.الوحدات) مثل طبيعي) - المعاد;
    // The record of this request, and the modules it changed.
    دع السجل_الجديد: متجه وحدة_جلسة_تحليل = سجل_من_حالة(
        &الحالة, &(*الجلسة).السجل, الحالية, البيئة, &الهدف, جذور_المساحة
    );
    (*الجلسة).السجل := السجل_الجديد;
    إذا ((الطول(المتغيرة_الآن) مثل طبيعي) > 0) { (*الجلسة).الساخنة := المتغيرة_الآن; };
    دع قبل_الأخيرة_مستعمل: طبيعي = قبل_الأخيرة;
    // The ownership of the kept state's modules once per kept state, then
    // this request's modules (semantic_pipeline.sn, حلل_ملكية_مرحلية_واجهة).
    دع المخبأة_السابقة: متغير اختياري ملكية_مخبأة_واجهة = اختياري.لا_شيء();
    بدّل(المخبأة_السابقة, (*الجلسة).الملكية_المخبأة);
    دع الملكية: متغير ملكية_مرحلية_واجهة = {
        العدد: أشجار_الحالة, التوليد: توليد_الحالة, المخبأة: المخبأة_السابقة
    };
    دع الناتج_الأخير: نتيجة_بناء_واجهة_وحدة = أنه_واجهة_مرحلية_بملكية(الحالة, البيئة, صواب, &متغير الملكية);
    بدّل((*الجلسة).الملكية_المخبأة, الملكية.المخبأة);
    طابق الناتج_الأخير مع
    | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
        أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة));
    }
    | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
        أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات));
    };
}

// ---- Comparing results -------------------------------------------------------
// A description of a result's facts that does not depend on its IDs or on the
// order sources were loaded in: one line per diagnostic, per source's
// completeness, and per source a digest of every resolved occurrence (its
// span, the declaration it resolves to and that Symbol's Type). Two results of
// the same sources describe alike exactly when these facts are equal. The
// lines are sorted.

عرف موضع_نصي_للوصف(الإحداثي: &اختياري إحداثي_مصدر): نص {
    طابق *الإحداثي مع
    | اختياري.موجود(القيمة) -> {
        دع الأجزاء: متجه نص = [طبيعي_إلى_نص(القيمة.السطر مثل طبيعي), «:», طبيعي_إلى_نص(القيمة.العمود مثل طبيعي)];
        دع الفاصل: نص = «»;
        أرجع صل_النصوص(&الأجزاء, &الفاصل);
    }
    | اختياري.لا_شيء -> { أرجع «-»; };
}

عرف اسم_مصدر_للوصف(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي): نص {
    طابق اسم_مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختياري.موجود(الاسم) -> { أرجع الاسم; }
    | اختياري.لا_شيء -> { أرجع «?»; };
}

عرف وصف_رمز_للمقارنة(الواجهة: &نتيجة_واجهة_وحدة, الرمز: معرف_رمز): نص {
    دع الأجزاء: متغير متجه نص = [];
    طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.موجود(الدلالي) -> {
        إذا (الدلالي.نطاق_الاسم.البداية.البايت == الدلالي.نطاق_الاسم.النهاية.البايت) {
            // A primitive or a synthetic Symbol has no place in a source.
            ألحق(الأجزاء, «builtin#»);
            طابق اسم_مقنن_واجهة(الواجهة, الدلالي.الاسم) مع
            | اختياري.موجود(المقنن) -> { ألحق(الأجزاء, من_بايتات(&المقنن.البايتات)); }
            | اختياري.لا_شيء -> { ألحق(الأجزاء, «?»); };
        } وإلا {
            ألحق(الأجزاء, اسم_مصدر_للوصف(الواجهة, الدلالي.نطاق_الاسم.البداية.المصدر مثل طبيعي));
            ألحق(الأجزاء, «@»);
            ألحق(الأجزاء, طبيعي_إلى_نص(الدلالي.نطاق_الاسم.البداية.البايت مثل طبيعي));
        };
    }
    | اختياري.لا_شيء -> { ألحق(الأجزاء, «?»); };
    ألحق(الأجزاء, «:»);
    طابق نوع_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.موجود(النوع) -> {
        طابق تهجئة_نوع_واجهة(الواجهة, النوع) مع
        | اختياري.موجود(التهجئة) -> { ألحق(الأجزاء, التهجئة); }
        | اختياري.لا_شيء -> { ألحق(الأجزاء, «~»); };
    }
    | اختياري.لا_شيء -> { ألحق(الأجزاء, «-»); };
    دع الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عام عرف صف_واجهة_للمقارنة(الواجهة: &نتيجة_واجهة_وحدة): متجه نص {
    دع الأسطر: متغير متجه نص = [];
    دع الفاصل: نص = «»;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).تشخيصات_الأدوات.التشخيصات) مثل طبيعي)) {
        دع التشخيص: &تشخيص = &(*الواجهة).تشخيصات_الأدوات.التشخيصات[ف];
        دع الأجزاء: متغير متجه نص = [«D », سطر_عنوان_تشخيص_طرفي(التشخيص, لغة_تشخيص.الإنجليزية())];
        دع الرئيسي: اختياري نطاق_مصدر_تشخيص = استنسخ(&(*التشخيص).المصدر_الرئيسي);
        طابق الرئيسي مع
        | اختياري.موجود(المصدر) -> {
            ألحق(الأجزاء, « @ »);
            دع اسم_الرئيسي: اختياري نص = استنسخ(&المصدر.اسم_المصدر);
            طابق اسم_الرئيسي مع
            | اختياري.موجود(الاسم) -> { ألحق(الأجزاء, الاسم); }
            | اختياري.لا_شيء -> { ألحق(الأجزاء, «?»); };
            ألحق(الأجزاء, « »);
            ألحق(الأجزاء, موضع_نصي_للوصف(&المصدر.بداية_العرض));
            ألحق(الأجزاء, «-»);
            ألحق(الأجزاء, موضع_نصي_للوصف(&المصدر.نهاية_العرض));
        }
        | اختياري.لا_شيء -> { };
        ألحق(الأسطر, صل_النصوص(&الأجزاء, &الفاصل));
        ف := ف + 1;
    }
    دع العلامات: متجه نص = [
        «F types-stopped=», (إذا_نص((*الواجهة).حقائق_الأدوات.الأنواع_متوقفة)),
        « complete=», (إذا_نص((*الواجهة).كاملة_دلاليا))
    ];
    ألحق(الأسطر, صل_النصوص(&العلامات, &الفاصل));
    ف := 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        دع المصدر: طبيعي = (*الواجهة).الوحدات[ف].معرف_المصدر;
        دع الاسم: نص = اسم_مصدر_للوصف(الواجهة, المصدر);
        دع الاكتمال: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(الواجهة, المصدر);
        دع سطر_الاكتمال: متجه نص = [
            «C », انسخ_نص(&الاسم), « load=», إذا_نص(الاكتمال.التحميل),
            « names=», إذا_نص(الاكتمال.الأسماء), « types=», إذا_نص(الاكتمال.الأنواع)
        ];
        ألحق(الأسطر, صل_النصوص(&سطر_الاكتمال, &الفاصل));
        دع الملخص: متغير طبيعي = بداية_هاش_جلسة();
        دع عدد_الظهورات: متغير طبيعي = 0;
        إذا (ف < (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
            دع الظهورات: &متجه ظهور_اسم_محلول = &(*الواجهة).روابط_الأسماء[ف].الظهورات;
            دع ي: متغير طبيعي = 0;
            طالما (ي < (الطول(*الظهورات) مثل طبيعي)) {
                طابق (*الظهورات)[ي].الرمز مع
                | اختياري.موجود(الرمز) -> {
                    دع الوصف: نص = وصف_رمز_للمقارنة(الواجهة, الرمز);
                    الملخص := امزج_هاش_جلسة(الملخص, (*الظهورات)[ي].النطاق.البداية.البايت مثل طبيعي);
                    الملخص := امزج_هاش_جلسة(الملخص, (*الظهورات)[ي].النطاق.النهاية.البايت مثل طبيعي);
                    الملخص := امزج_هاش_جلسة(الملخص, هاش_نص_جلسة(&الوصف));
                    عدد_الظهورات := عدد_الظهورات + 1;
                }
                | اختياري.لا_شيء -> { };
                ي := ي + 1;
            }
        };
        دع سطر_الملخص: متجه نص = [
            «S », الاسم, « occurrences=», طبيعي_إلى_نص(عدد_الظهورات), « digest=», طبيعي_إلى_نص(الملخص)
        ];
        ألحق(الأسطر, صل_النصوص(&سطر_الملخص, &الفاصل));
        ف := ف + 1;
    }
    رتب_نصوص(&متغير الأسطر);
    أرجع الأسطر;
}

عرف إذا_نص(القيمة: منطقي): نص {
    إذا (القيمة) { أرجع «1»; };
    أرجع «0»;
}

// Every resolved occurrence of one source, one line each (its span, the
// declaration and the Symbol's Type): to show where two descriptions differ.
عام عرف صف_ظهورات_مصدر_للمقارنة(الواجهة: &نتيجة_واجهة_وحدة, الاسم: &نص): متجه نص {
    دع الأسطر: متغير متجه نص = [];
    دع الفاصل: نص = «»;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي) && ف < (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
        دع المصدر: طبيعي = (*الواجهة).الوحدات[ف].معرف_المصدر;
        دع اسم_المصدر: نص = اسم_مصدر_للوصف(الواجهة, المصدر);
        إذا (نصان_متساويان(&اسم_المصدر, الاسم)) {
            دع الظهورات: &متجه ظهور_اسم_محلول = &(*الواجهة).روابط_الأسماء[ف].الظهورات;
            دع ي: متغير طبيعي = 0;
            طالما (ي < (الطول(*الظهورات) مثل طبيعي)) {
                طابق (*الظهورات)[ي].الرمز مع
                | اختياري.موجود(الرمز) -> {
                    دع الأجزاء: متجه نص = [
                        طبيعي_إلى_نص((*الظهورات)[ي].النطاق.البداية.البايت مثل طبيعي), «-»,
                        طبيعي_إلى_نص((*الظهورات)[ي].النطاق.النهاية.البايت مثل طبيعي), « »,
                        وصف_رمز_للمقارنة(الواجهة, الرمز)
                    ];
                    ألحق(الأسطر, صل_النصوص(&الأجزاء, &الفاصل));
                }
                | اختياري.لا_شيء -> { };
                ي := ي + 1;
            }
        };
        ف := ف + 1;
    }
    أرجع الأسطر;
}
