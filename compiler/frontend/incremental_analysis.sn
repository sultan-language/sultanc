// Incremental tooling analysis: a session the editor keeps between requests.
//
// There is one analysis engine (semantic_pipeline.sn). A request analyses a
// حالة_واجهة_مرحلية in stages; a stage continues the facts of the modules
// before it, which never import a module of a later stage. The session keeps
// two copies of a state:
//   الأساس   the std and package modules (outside the workspace roots);
//   المساحة  الأساس and every workspace module the last edits do not reach.
// A request reads every module's text (an editor's unsaved text first),
// takes the largest kept state none of whose modules changed, and analyses
// only the modules after it: the changed modules, the modules that import
// them (directly or not) and the modules changed by the request before
// (the editor is likely to change them again), in a last stage. The result
// is that of a full analysis; IDs and the order of diagnostics may differ.
//
// Early cutoff: a request that changed at most one module also keeps its
// final state (النهائية), with the ownership analysis of every module. When
// the texts then differ from that state's in one module only, and in no
// token outside its function bodies (comments, whitespace and bodies only),
// no importer's facts can change: the session takes a copy of that state and
// re-checks that module's bodies in it (semantic_pipeline.sn,
// افحص_أجسام_وحدة_في_حالة), analysing one module instead of the module and
// its importers (none when no text differs). Anything that check cannot
// account for falls back to the stages above. The kept final state is never
// changed: each such request starts from it again, so what the old bodies
// leave behind does not grow.
//
// What invalidates:
//   - a different target, workspace roots, package graph or other
//     configuration of the logical environment: everything (بصمة_طلب_جلسة);
//   - a root file whose `module` spellings changed, a package whose member
//     files changed: everything;
//   - a changed module text: the kept states holding it, and its importers;
//   - a module with an import that could not be loaded is analysed again on
//     every request (the file it names may appear);
//   - a module that is no longer reached from the roots: everything.
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.tooling_facts;
استورد compiler.frontend.tooling_queries;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.module_loader;
استورد compiler.frontend.module_loading.source_locator;
استورد compiler.frontend.module_loading.module_spellings;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.package_export_index;
استورد compiler.frontend.module_loading.source_provider;
استورد compiler.jisr.translate;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.parser.parser;
استورد compiler.frontend.parser.error;
استورد compiler.backend.target.target_model;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.output.terminal;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.مقطع;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.مجموعات.ترتيب;

// ---- Hashing ---------------------------------------------------------------
// Two 32-bit FNV-1a lanes (two primes) in one 64-bit value; the length is
// mixed in last. A text is only compared with the text of the same module in
// an earlier request.

عرف خطوة_هاش_جلسة(الهاش: طبيعي, البايت: طبيعي): طبيعي {
    ليكن الأول: طبيعي = (((الهاش / 4294967296) ^ البايت) * 16777619) % 4294967296;
    ليكن الثاني: طبيعي = (((الهاش % 4294967296) ^ البايت) * 2246822519) % 4294967296;
    أرجع (الأول * 4294967296) + الثاني;
}

عرف امزج_هاش_جلسة(الهاش: طبيعي, القيمة: طبيعي): طبيعي {
    ليكن الناتج: متغير طبيعي = الهاش;
    ليكن الباقي: متغير طبيعي = القيمة;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        الناتج := خطوة_هاش_جلسة(الناتج, الباقي % 256);
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف بداية_هاش_جلسة(): طبيعي { أرجع (2166136261 * 4294967296) + 2166136261; }

عام عرف هاش_نص_جلسة(النص: &نص): طبيعي {
    ليكن الهاش: متغير طبيعي = بداية_هاش_جلسة();
    ليكن الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الطول_الكلي) {
        الهاش := خطوة_هاش_جلسة(الهاش, (*النص)[ف] مثل طبيعي);
        ف := ف + 1;
    }
    أرجع امزج_هاش_جلسة(الهاش, الطول_الكلي);
}

عرف هاش_بايتات_جلسة(الهاش: طبيعي, البايتات: &متجه ط8): طبيعي {
    ليكن الناتج: متغير طبيعي = امزج_هاش_جلسة(الهاش, الطول(*البايتات) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) {
        الناتج := امزج_هاش_جلسة(الناتج, (*البايتات)[ف] مثل طبيعي);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف هاش_مفتاح_جلسة(الهاش: طبيعي, المفتاح: &مفتاح_وحدة_مقنن): طبيعي {
    ليكن الناتج: متغير طبيعي = امزج_هاش_جلسة(الهاش, (*المفتاح).الجذر.القيمة);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المفتاح).المسار.الأجزاء) مثل طبيعي)) {
        الناتج := هاش_بايتات_جلسة(الناتج, &(*المفتاح).المسار.الأجزاء[ف].البايتات);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The configuration a kept state depends on beyond the module texts: the
// target, the logical environment (roots, packages, spellings of roots, source
// locations) and the request's roots.
عام عرف بصمة_طلب_جلسة(
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    الجذر: &مفتاح_وحدة_مقنن,
    الإضافية: &متجه مفتاح_وحدة_مقنن
): طبيعي {
    ليكن ه: متغير طبيعي = بداية_هاش_جلسة();
    طابق *الهدف مع
    | اختياري.موجود(الواصف) -> {
        ه := امزج_هاش_جلسة(ه, هاش_نص_جلسة(&الواصف.الثلاثي_المقنن));
        ه := امزج_هاش_جلسة(ه, الواصف.نموذج_البيانات.عرض_المؤشر);
    }
    | اختياري.لا_شيء -> { ه := امزج_هاش_جلسة(ه, 1); };
    ه := امزج_هاش_جلسة(ه, (*البيئة).معرف_الجذر_التالي);
    طابق (*البيئة).جذر_قياسي_موثوق مع
    | اختياري.موجود(الجذر_القياسي) -> { ه := امزج_هاش_جلسة(ه, الجذر_القياسي.القيمة + 7); }
    | اختياري.لا_شيء -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).الجذور) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, (*البيئة).الجذور[ف].القيمة);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).روابط_الجذور) مثل طبيعي)) {
        ليكن الربط: &ربط_اسم_جذر_مكتبة = &(*البيئة).روابط_الجذور[ف];
        ه := امزج_هاش_جلسة(ه, (*الربط).الجذر_المرئي.القيمة);
        ه := هاش_بايتات_جلسة(ه, &(*الربط).التهجئة);
        ه := امزج_هاش_جلسة(ه, (*الربط).الجذر_الهدف.القيمة);
        إذا ((*الربط).يستهلك_التهجئة) { ه := امزج_هاش_جلسة(ه, 3); };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).جذور_المصادر) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, (*البيئة).جذور_المصادر[ف].القيمة);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).مسارات_جذور_المصادر) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, هاش_نص_جلسة(&(*البيئة).مسارات_جذور_المصادر[ف]));
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).المسارات_العامة) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, (*البيئة).المسارات_العامة[ف].الجذر_المرئي.القيمة);
        ه := هاش_بايتات_جلسة(ه, &(*البيئة).المسارات_العامة[ف].المسار_العام);
        ه := هاش_مفتاح_جلسة(ه, &(*البيئة).المسارات_العامة[ف].المفتاح);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).مواقع_المصادر) مثل طبيعي)) {
        ه := هاش_مفتاح_جلسة(ه, &(*البيئة).مواقع_المصادر[ف].المفتاح);
        ه := امزج_هاش_جلسة(ه, هاش_نص_جلسة(&(*البيئة).مواقع_المصادر[ف].مسار_ملف_المصدر));
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البيئة).أسماء_الحزم) مثل طبيعي)) {
        ه := امزج_هاش_جلسة(ه, (*البيئة).أسماء_الحزم[ف].الجذر.القيمة);
        ه := هاش_بايتات_جلسة(ه, &(*البيئة).أسماء_الحزم[ف].الاسم);
        ف := ف + 1;
    }
    ه := هاش_مفتاح_جلسة(ه, الجذر);
    ف := 0;
    طالما (ف < (الطول(*الإضافية) مثل طبيعي)) {
        ه := هاش_مفتاح_جلسة(ه, &(*الإضافية)[ف]);
        ف := ف + 1;
    }
    أرجع ه;
}

// The hash of a module's current text: an editor's unsaved text first, else
// the file. None when the module cannot be located or read.
عام عرف هاش_مصدر_حالي_جلسة(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    الهدف: &اختياري واصف_هدف
): اختياري طبيعي {
    طابق حدد_مصدر_وحدة_لهدف(البيئة, المفتاح, الهدف) مع
    | نتيجة_تحديد_مصدر.موجود(المحدد) -> { أرجع اختياري.موجود(هاش_نص_جلسة(&المحدد.المحتوى)); }
    | نتيجة_تحديد_مصدر.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// What a request knows of a module's current text: its hash (none when it
// cannot be located or read), and the file's size and modification time, which
// let the next request keep the hash without reading the file. بلا_بيانات:
// the text is an editor's unsaved text or a C import (always read again).
عام نوع حالة_نص_جلسة = {
    الهاش: اختياري طبيعي,
    الحجم: عدد,
    وقت_التعديل: عدد,
    بلا_بيانات: منطقي
};

نوع بيانات_ملف_جلسة_ناتجة = { الحجم: عدد, الوقت: عدد };

// The size and modification time of a file, when both can be read.
عرف بيانات_ملف_جلسة(المسار: &نص): اختياري بيانات_ملف_جلسة_ناتجة {
    طابق حجم_المسار(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الحجم) -> {
        طابق وقت_تعديل_المسار_نانو(المسار) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(الوقت) -> {
            ليكن البيانات: بيانات_ملف_جلسة_ناتجة = { الحجم: الحجم, الوقت: الوقت };
            أرجع اختياري.موجود(البيانات);
        };
    };
}

// A module's current text. A file whose size and modification time are those
// recorded for it keeps its recorded hash; an editor's unsaved text, a C
// import and any other file are read and hashed.
عرف حالة_نص_حالية_جلسة(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    الهدف: &اختياري واصف_هدف,
    المسار: &نص,
    السابقة: &اختياري حالة_نص_جلسة
): حالة_نص_جلسة {
    ليكن بلا_بيانات: متغير منطقي = (الطول(*المسار) مثل طبيعي) == 0 || هل_مصدر_سي(المسار);
    إذا (!بلا_بيانات) {
        ليكن التراكب: نتيجة_محتوى_تراكب_مصدر = محتوى_تراكب_مصدر(&(*البيئة).مزود_المصادر, المسار);
        بلا_بيانات := التراكب.موجود;
    };
    ليكن الحجم: متغير عدد = 0;
    ليكن الوقت: متغير عدد = 0;
    إذا (!بلا_بيانات) {
        طابق بيانات_ملف_جلسة(المسار) مع
        | اختياري.موجود(البيانات) -> {
            الحجم := البيانات.الحجم;
            الوقت := البيانات.الوقت;
            طابق *السابقة مع
            | اختياري.موجود(القديمة) -> {
                إذا (!القديمة.بلا_بيانات && القديمة.الحجم == الحجم && القديمة.وقت_التعديل == الوقت) {
                    ليكن المحفوظة: حالة_نص_جلسة = {
                        الهاش: القديمة.الهاش, الحجم: الحجم, وقت_التعديل: الوقت, بلا_بيانات: خطأ
                    };
                    أرجع المحفوظة;
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { بلا_بيانات := صواب; };
    };
    ليكن الحالة: حالة_نص_جلسة = {
        الهاش: هاش_مصدر_حالي_جلسة(البيئة, المفتاح, الهدف),
        الحجم: الحجم,
        وقت_التعديل: الوقت,
        بلا_بيانات: بلا_بيانات
    };
    أرجع الحالة;
}

// ---- Session -----------------------------------------------------------------

// One module of the last request.
عام نوع وحدة_جلسة_تحليل = {
    المفتاح: مفتاح_وحدة_مقنن,
    هاش_المفتاح: طبيعي,
    // The hash of the text it was analysed from.
    الهاش: طبيعي,
    // The file it was read from, and what the request knew of it.
    المسار: نص,
    النص: حالة_نص_جلسة,
    // Positions in the record of the modules it imports.
    الاستيرادات: متجه طبيعي,
    // Outside the request's workspace roots (std, packages).
    أساسية: منطقي,
    // An import of it could not be loaded: analysed again on every request.
    متسخة: منطقي,
    // A folder's root file (`module` spellings): a change invalidates everything.
    ملف_جذر: منطقي
};

// A kept state: its modules (all analysed) and the hash of each text.
عام نوع لقطة_تحليل = {
    الحالة: حالة_واجهة_مرحلية,
    الهاشات_المفتاحية: متجه طبيعي,
    المفاتيح: متجه مفتاح_وحدة_مقنن,
    الهاشات: متجه طبيعي,
    // The root files read for module spellings, and their text hashes.
    ملفات_الجذور: متجه نص,
    هاشات_ملفات_الجذور: متجه طبيعي,
    // Which kept state this is (one number per state the session ever made),
    // and how many module trees it holds: the ownership analysis of those
    // trees is made once per state (ملكية_مخبأة_واجهة).
    التوليد: طبيعي,
    عدد_الأشجار: طبيعي
};

// What the last request did (for an editor's status and for measurements).
عام نوع إحصاء_طلب_جلسة = {
    // 0: no kept state (a full analysis), 1: الأساس, 2: المساحة, 3: the
    // final state of the request before, with one module's bodies checked
    // again (early cutoff).
    اللقطة: طبيعي,
    // Modules analysed by this request, and reused from the kept state.
    المحللة: طبيعي,
    المعاد_استعمالها: طبيعي,
    // Module texts changed since the request before.
    المتغيرة: طبيعي,
    بنيت_لقطة_الأساس: منطقي,
    بنيت_لقطة_المساحة: منطقي,
    // A full analysis: first request, configuration change or fallback.
    كاملة: منطقي,
    // The kept state was the copy made ahead (جهز_جلسة_تحليل).
    جاهزة: منطقي,
    // Early cutoff: the edit changed one module's bodies (or only its
    // comments and spacing), and only those were checked again.
    قطع_مبكر: منطقي
};

عام نوع جلسة_تحليل_تزايدي = {
    لها_بصمة: منطقي,
    البصمة: طبيعي,
    الأساس: اختياري لقطة_تحليل,
    المساحة: اختياري لقطة_تحليل,
    السجل: متجه وحدة_جلسة_تحليل,
    // The modules changed by the last request that changed any.
    الساخنة: متجه مفتاح_وحدة_مقنن,
    // The editor's open documents (عيّن_مستندات_مفتوحة_جلسة).
    المفتوحة: متجه مفتاح_وحدة_مقنن,
    // A copy of a kept state made ahead (جهز_جلسة_تحليل), and which one:
    // 1 الأساس, 2 المساحة, 3 النهائية.
    الجاهزة: اختياري حالة_واجهة_مرحلية,
    الجاهزة_من: طبيعي,
    الإحصاء: إحصاء_طلب_جلسة,
    // The number of the next kept state, and the ownership analysis of the
    // modules of the kept state the last request started from.
    التوليد_التالي: طبيعي,
    الملكية_المخبأة: اختياري ملكية_مخبأة_واجهة,
    // The final state of the last request that changed one module, for an
    // edit of that module's bodies (early cutoff).
    النهائية: اختياري نهائية_جلسة
};

عرف إحصاء_طلب_جلسة_فارغ(): إحصاء_طلب_جلسة {
    ليكن الإحصاء: إحصاء_طلب_جلسة = {
        اللقطة: 0, المحللة: 0, المعاد_استعمالها: 0, المتغيرة: 0,
        بنيت_لقطة_الأساس: خطأ, بنيت_لقطة_المساحة: خطأ, كاملة: خطأ, جاهزة: خطأ,
        قطع_مبكر: خطأ
    };
    أرجع الإحصاء;
}

عام عرف جلسة_تحليل_تزايدي_جديدة(): جلسة_تحليل_تزايدي {
    ليكن السجل: متجه وحدة_جلسة_تحليل = [];
    ليكن الساخنة: متجه مفتاح_وحدة_مقنن = [];
    ليكن المفتوحة: متجه مفتاح_وحدة_مقنن = [];
    ليكن الجلسة: جلسة_تحليل_تزايدي = {
        لها_بصمة: خطأ,
        البصمة: 0,
        الأساس: اختياري.لا_شيء(),
        المساحة: اختياري.لا_شيء(),
        السجل: السجل,
        الساخنة: الساخنة,
        المفتوحة: المفتوحة,
        الجاهزة: اختياري.لا_شيء(),
        الجاهزة_من: 0,
        الإحصاء: إحصاء_طلب_جلسة_فارغ(),
        التوليد_التالي: 1,
        الملكية_المخبأة: اختياري.لا_شيء(),
        النهائية: اختياري.لا_شيء()
    };
    أرجع الجلسة;
}

// Drops every kept state: the next request is a full analysis.
عام عرف أفرغ_جلسة_تحليل(الجلسة: &متغير جلسة_تحليل_تزايدي): فراغ {
    ليكن السجل: متجه وحدة_جلسة_تحليل = [];
    ليكن الساخنة: متجه مفتاح_وحدة_مقنن = [];
    (*الجلسة).لها_بصمة := خطأ;
    (*الجلسة).الأساس := اختياري.لا_شيء();
    (*الجلسة).المساحة := اختياري.لا_شيء();
    (*الجلسة).السجل := السجل;
    (*الجلسة).الساخنة := الساخنة;
    (*الجلسة).الملكية_المخبأة := اختياري.لا_شيء();
    (*الجلسة).النهائية := اختياري.لا_شيء();
    أسقط_الجاهزة(الجلسة);
}

عرف أسقط_الجاهزة(الجلسة: &متغير جلسة_تحليل_تزايدي): فراغ {
    (*الجلسة).الجاهزة := اختياري.لا_شيء();
    (*الجلسة).الجاهزة_من := 0;
}

// Copies the kept state the next request is likely to start from (the kept
// final state when there is one), so that request does not copy it. An editor calls it while it waits for input
// (after it has shown a result); a request takes the copy only when it starts
// from that same kept state. Does nothing when a copy is ready.
عام عرف جهز_جلسة_تحليل(الجلسة: &متغير جلسة_تحليل_تزايدي): فراغ {
    طابق (*الجلسة).الجاهزة مع
    | اختياري.موجود(_) -> { أرجع; }
    | اختياري.لا_شيء -> { };
    // The editor is likely to go on editing the module the last request
    // changed: an edit of its bodies starts from the kept final state.
    طابق (*الجلسة).النهائية مع
    | اختياري.موجود(النهائية) -> {
        (*الجلسة).الجاهزة := اختياري.موجود(استنسخ(&النهائية.اللقطة.الحالة));
        (*الجلسة).الجاهزة_من := 3;
        أرجع;
    }
    | اختياري.لا_شيء -> { };
    طابق (*الجلسة).المساحة مع
    | اختياري.موجود(اللقطة) -> {
        (*الجلسة).الجاهزة := اختياري.موجود(استنسخ(&اللقطة.الحالة));
        (*الجلسة).الجاهزة_من := 2;
        أرجع;
    }
    | اختياري.لا_شيء -> { };
    طابق (*الجلسة).الأساس مع
    | اختياري.موجود(اللقطة) -> {
        (*الجلسة).الجاهزة := اختياري.موجود(استنسخ(&اللقطة.الحالة));
        (*الجلسة).الجاهزة_من := 1;
    }
    | اختياري.لا_شيء -> { };
}

// The copy made ahead of kept state اللقطة, taken out of the session; none when
// there is none of that state.
عرف خذ_الجاهزة(الجلسة: &متغير جلسة_تحليل_تزايدي, اللقطة: طبيعي): اختياري حالة_واجهة_مرحلية {
    إذا ((*الجلسة).الجاهزة_من != اللقطة) { أرجع اختياري.لا_شيء(); };
    ليكن المأخوذة: متغير اختياري حالة_واجهة_مرحلية = اختياري.لا_شيء();
    بدّل((*الجلسة).الجاهزة, المأخوذة);
    (*الجلسة).الجاهزة_من := 0;
    أرجع المأخوذة;
}

// The workspace modules the editor has open: they are likely to change, so the
// kept workspace state leaves them (and the modules that import them) out, and
// their first edit already reuses it. A std or package module that is open is
// kept until it changes.
عام عرف عيّن_مستندات_مفتوحة_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    المفاتيح: متجه مفتاح_وحدة_مقنن
): فراغ {
    (*الجلسة).المفتوحة := المفاتيح;
}

عام عرف إحصاء_جلسة_تحليل(الجلسة: &جلسة_تحليل_تزايدي): إحصاء_طلب_جلسة {
    أرجع (*الجلسة).الإحصاء;
}

عرف موضع_في_السجل(
    السجل: &متجه وحدة_جلسة_تحليل, المفتاح: &مفتاح_وحدة_مقنن, هاش_المفتاح: طبيعي
): اختياري طبيعي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السجل) مثل طبيعي)) {
        إذا ((*السجل)[ف].هاش_المفتاح == هاش_المفتاح
            && مفتاحا_وحدة_متساويان(&(*السجل)[ف].المفتاح, المفتاح)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف مفتاح_في_قائمة(القائمة: &متجه مفتاح_وحدة_مقنن, المفتاح: &مفتاح_وحدة_مقنن): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (مفتاحا_وحدة_متساويان(&(*القائمة)[ف], المفتاح)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف جذر_في_قائمة(القائمة: &متجه طبيعي, الجذر: طبيعي): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا ((*القائمة)[ف] == الجذر) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The module key of a state's module.
عرف مفتاح_وحدة_في_حالة(الحالة: &حالة_واجهة_مرحلية, الوحدة: معرف_وحدة): اختياري مفتاح_وحدة_مقنن {
    طابق وحدة_محملة_بالمعرف(&(*الحالة).المحمل, الوحدة) مع
    | اختياري.موجود(المحملة) -> { أرجع اختياري.موجود(انسخ_مفتاح_وحدة_مقنن(&المحملة.المفتاح)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// The current text of a module: from this request's reads, else read now.
عرف حالة_نص_لمفتاح(
    السجل: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    المفتاح: &مفتاح_وحدة_مقنن,
    المسار: &نص
): حالة_نص_جلسة {
    ليكن هاش_المفتاح: طبيعي = هاش_مفتاح_جلسة(0, المفتاح);
    طابق موضع_في_السجل(السجل, المفتاح, هاش_المفتاح) مع
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع < (الطول(*الحالية) مثل طبيعي)) { أرجع (*الحالية)[الموضع]; };
    }
    | اختياري.لا_شيء -> { };
    ليكن بلا_سابقة: اختياري حالة_نص_جلسة = اختياري.لا_شيء();
    أرجع حالة_نص_حالية_جلسة(البيئة, المفتاح, الهدف, المسار, &بلا_سابقة);
}

عرف هاش_حالي_لمفتاح(
    السجل: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    المفتاح: &مفتاح_وحدة_مقنن,
    المسار: &نص
): طبيعي {
    طابق حالة_نص_لمفتاح(السجل, الحالية, البيئة, الهدف, المفتاح, المسار).الهاش مع
    | اختياري.موجود(الهاش) -> { أرجع الهاش; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

// The file a state's module was read from.
عرف مسار_وحدة_في_حالة(الحالة: &حالة_واجهة_مرحلية, الوحدة: معرف_وحدة): نص {
    طابق وحدة_محملة_بالمعرف(&(*الحالة).المحمل, الوحدة) مع
    | اختياري.موجود(المحملة) -> { أرجع انسخ_نص(&المحملة.مسار_ملف_المصدر); }
    | اختياري.لا_شيء -> { أرجع «»; };
}

// The record of an analysed state's modules, in load order.
عرف سجل_من_حالة(
    الحالة: &حالة_واجهة_مرحلية,
    السجل_القديم: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    جذور_المساحة: &متجه طبيعي
): متجه وحدة_جلسة_تحليل {
    ليكن السجل: متغير متجه وحدة_جلسة_تحليل = [];
    ليكن مواضع_الوحدات: متغير متجه اختياري طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).المحمل.المحملة) مثل طبيعي)) {
        ألحق(مواضع_الوحدات, اختياري.لا_شيء());
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
        ليكن الوحدة: معرف_وحدة = (*الحالة).الوحدات[ف].الوحدة;
        طابق مفتاح_وحدة_في_حالة(الحالة, الوحدة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المفتاح) -> {
            ليكن المسار: نص = مسار_وحدة_في_حالة(الحالة, الوحدة);
            ليكن النص: حالة_نص_جلسة = حالة_نص_لمفتاح(السجل_القديم, الحالية, البيئة, الهدف, &المفتاح, &المسار);
            ليكن الهاش: متغير طبيعي = 0;
            طابق النص.الهاش مع
            | اختياري.موجود(القيمة) -> { الهاش := القيمة; }
            | اختياري.لا_شيء -> { };
            ليكن المصدر: طبيعي = (*الحالة).أشجار_الوحدات[(*الحالة).الوحدات[ف].الشجرة].معرف_المصدر;
            ليكن ملف_جذر: منطقي =
                (الطول((*الحالة).أشجار_الوحدات[(*الحالة).الوحدات[ف].الشجرة].تصريحات_الوحدات) مثل طبيعي) > 0;
            ليكن بلا_استيرادات: متجه طبيعي = [];
            ليكن السجل_الجديد: وحدة_جلسة_تحليل = {
                المفتاح: انسخ_مفتاح_وحدة_مقنن(&المفتاح),
                هاش_المفتاح: هاش_مفتاح_جلسة(0, &المفتاح),
                الهاش: الهاش,
                المسار: المسار,
                النص: النص,
                الاستيرادات: بلا_استيرادات,
                أساسية: !جذر_في_قائمة(جذور_المساحة, المفتاح.الجذر.القيمة),
                متسخة: سجل_مصدرا_فاشلا_في(&(*الحالة).إخفاقات_التحميل.بلا_تحميل, المصدر),
                ملف_جذر: ملف_جذر
            };
            إذا ((الوحدة.القيمة مثل طبيعي) < (الطول(مواضع_الوحدات) مثل طبيعي)) {
                مواضع_الوحدات[الوحدة.القيمة] := اختياري.موجود(الطول(السجل) مثل طبيعي);
            };
            ألحق(السجل, السجل_الجديد);
        };
        ف := ف + 1;
    }
    // Import edges, as positions in the record.
    ف := 0;
    طالما (ف < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
        ليكن الوحدة: معرف_وحدة = (*الحالة).الوحدات[ف].الوحدة;
        إذا ((الوحدة.القيمة مثل طبيعي) < (الطول(مواضع_الوحدات) مثل طبيعي)) {
            طابق مواضع_الوحدات[الوحدة.القيمة] مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الموضع) -> {
                ليكن العدد: طبيعي = عدد_استيرادات_الوحدة(&(*الحالة).الرسم, الوحدة);
                ليكن ي: متغير طبيعي = 0;
                طالما (ي < العدد) {
                    ليكن المستورد: معرف_وحدة = استيراد_الوحدة_عند(&(*الحالة).الرسم, الوحدة, ي);
                    إذا ((المستورد.القيمة مثل طبيعي) < (الطول(مواضع_الوحدات) مثل طبيعي)) {
                        طابق مواضع_الوحدات[المستورد.القيمة] مع
                        | اختياري.موجود(موضع_المستورد) -> { ألحق(السجل[الموضع].الاستيرادات, موضع_المستورد); }
                        | اختياري.لا_شيء -> { };
                    };
                    ي := ي + 1;
                }
            };
        };
        ف := ف + 1;
    }
    أرجع السجل;
}

عرف سجل_مصدرا_فاشلا_في(القائمة: &متجه طبيعي, المصدر: طبيعي): منطقي {
    أرجع جذر_في_قائمة(القائمة, المصدر);
}

// Keeps a copy of an analysed state, with its modules' keys and text hashes.
عرف التقط_حالة(
    الحالة: &حالة_واجهة_مرحلية,
    السجل: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    التوليد: طبيعي
): لقطة_تحليل {
    ليكن المفاتيح: متغير متجه مفتاح_وحدة_مقنن = [];
    ليكن الهاشات_المفتاحية: متغير متجه طبيعي = [];
    ليكن الهاشات: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
        طابق مفتاح_وحدة_في_حالة(الحالة, (*الحالة).الوحدات[ف].الوحدة) مع
        | اختياري.موجود(المفتاح) -> {
            ليكن المسار: نص = مسار_وحدة_في_حالة(الحالة, (*الحالة).الوحدات[ف].الوحدة);
            ألحق(الهاشات, هاش_حالي_لمفتاح(السجل, الحالية, البيئة, الهدف, &المفتاح, &المسار));
            ألحق(الهاشات_المفتاحية, هاش_مفتاح_جلسة(0, &المفتاح));
            ألحق(المفاتيح, المفتاح);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    ليكن ملفات_الجذور: متغير متجه نص = [];
    ليكن هاشات_ملفات_الجذور: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*الحالة).المحمل.تهجئات_الوحدات.المجلدات) مثل طبيعي)) {
        ليكن المسار: نص = انسخ_نص(&(*الحالة).المحمل.تهجئات_الوحدات.المجلدات[ف].ملف_الجذر);
        ألحق(هاشات_ملفات_الجذور, هاش_ملف_جذر_جلسة(البيئة, &المسار));
        ألحق(ملفات_الجذور, المسار);
        ف := ف + 1;
    }
    ليكن اللقطة: لقطة_تحليل = {
        الحالة: استنسخ(الحالة),
        الهاشات_المفتاحية: الهاشات_المفتاحية,
        المفاتيح: المفاتيح,
        الهاشات: الهاشات,
        ملفات_الجذور: ملفات_الجذور,
        هاشات_ملفات_الجذور: هاشات_ملفات_الجذور,
        التوليد: التوليد,
        عدد_الأشجار: الطول((*الحالة).أشجار_الوحدات) مثل طبيعي
    };
    أرجع اللقطة;
}

عرف هاش_ملف_جذر_جلسة(البيئة: &بيئة_وحدات_منطقية, المسار: &نص): طبيعي {
    طابق نص_ملف_جذر(البيئة, المسار) مع
    | اختياري.موجود(النص) -> { أرجع هاش_نص_جلسة(&النص); }
    | اختياري.لا_شيء -> { أرجع 1; };
}

// A kept state still holds what a full analysis would: none of its modules
// changed, and its root files and packages are as they were.
عرف لقطة_صالحة(
    اللقطة: &لقطة_تحليل,
    السجل: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البذور: &متجه منطقي,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف
): منطقي {
    ليكن بلا_مستثنى: اختياري مفتاح_وحدة_مقنن = اختياري.لا_شيء();
    أرجع لقطة_صالحة_عدا(اللقطة, السجل, الحالية, البذور, البيئة, الهدف, &بلا_مستثنى);
}

// The same, except that module المستثنى may have changed (the kept final
// state, whose module's bodies are checked again).
عرف لقطة_صالحة_عدا(
    اللقطة: &لقطة_تحليل,
    السجل: &متجه وحدة_جلسة_تحليل,
    الحالية: &متجه حالة_نص_جلسة,
    البذور: &متجه منطقي,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    المستثنى: &اختياري مفتاح_وحدة_مقنن
): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*اللقطة).المفاتيح) مثل طبيعي)) {
        ليكن مستثنى: متغير منطقي = خطأ;
        طابق *المستثنى مع
        | اختياري.موجود(المفتاح) -> { مستثنى := مفتاحا_وحدة_متساويان(&المفتاح, &(*اللقطة).المفاتيح[ف]); }
        | اختياري.لا_شيء -> { };
        إذا (مستثنى) { ف := ف + 1; تابع_حلقة; };
        طابق موضع_في_السجل(السجل, &(*اللقطة).المفاتيح[ف], (*اللقطة).الهاشات_المفتاحية[ف]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الموضع) -> {
            إذا (الموضع >= (الطول(*الحالية) مثل طبيعي)) { أرجع خطأ; };
            إذا (الموضع < (الطول(*البذور) مثل طبيعي) && (*البذور)[الموضع]) { أرجع خطأ; };
            طابق (*الحالية)[الموضع].الهاش مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(الهاش) -> {
                إذا (الهاش != (*اللقطة).الهاشات[ف]) { أرجع خطأ; };
            };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*اللقطة).ملفات_الجذور) مثل طبيعي)) {
        إذا (هاش_ملف_جذر_جلسة(البيئة, &(*اللقطة).ملفات_الجذور[ف]) != (*اللقطة).هاشات_ملفات_الجذور[ف]) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    // A package's members are discovered from its folder: a file added or
    // removed there changes what importing the package means.
    ليكن المحمل: &محمل_وحدات = &(*اللقطة).الحالة.المحمل;
    ف := 0;
    طالما (ف < (الطول((*المحمل).الحزم_المكتشفة) مثل طبيعي)) {
        طابق اكتشف_أعضاء_حزمة_مصدر_لهدف(البيئة, &(*المحمل).الحزم_المكتشفة[ف].المفتاح, الهدف) مع
        | نتيجة_اكتشاف_أعضاء_حزمة.موجودة(الأعضاء) -> {
            ليكن القديمة: &متجه مفتاح_وحدة_مقنن = &(*المحمل).الحزم_المكتشفة[ف].الأعضاء;
            إذا (الطول(الأعضاء) != الطول(*القديمة)) { أرجع خطأ; };
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الأعضاء) مثل طبيعي)) {
                إذا (!مفتاحا_وحدة_متساويان(&الأعضاء[ع], &(*القديمة)[ع])) { أرجع خطأ; };
                ع := ع + 1;
            }
        }
        | _ -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Every module of the state is reached from the request's roots.
عرف كل_الوحدات_مستوردة(
    الحالة: &حالة_واجهة_مرحلية,
    الجذور: &متجه معرف_وحدة
): منطقي {
    ليكن العدد: طبيعي = الطول((*الحالة).المحمل.المحملة) مثل طبيعي;
    ليكن المبلوغة: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(المبلوغة, خطأ); ف := ف + 1; }
    ليكن المكدس: متغير متجه معرف_وحدة = [];
    ف := 0;
    طالما (ف < (الطول(*الجذور) مثل طبيعي)) {
        ليكن الجذر: معرف_وحدة = (*الجذور)[ف];
        إذا ((الجذر.القيمة مثل طبيعي) < العدد && !المبلوغة[الجذر.القيمة]) {
            المبلوغة[الجذر.القيمة] := صواب;
            ألحق(المكدس, الجذر);
        };
        ف := ف + 1;
    }
    طالما ((الطول(المكدس) مثل طبيعي) > 0) {
        ليكن الوحدة: معرف_وحدة = المكدس[(الطول(المكدس) مثل طبيعي) - 1];
        أزل_الأخير(المكدس);
        ليكن عدد_الاستيرادات: طبيعي = عدد_استيرادات_الوحدة(&(*الحالة).الرسم, الوحدة);
        ليكن ي: متغير طبيعي = 0;
        طالما (ي < عدد_الاستيرادات) {
            ليكن المستورد: معرف_وحدة = استيراد_الوحدة_عند(&(*الحالة).الرسم, الوحدة, ي);
            إذا ((المستورد.القيمة مثل طبيعي) < العدد && !المبلوغة[المستورد.القيمة]) {
                المبلوغة[المستورد.القيمة] := صواب;
                ألحق(المكدس, المستورد);
            };
            ي := ي + 1;
        }
    }
    ف := 0;
    طالما (ف < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
        ليكن الوحدة: معرف_وحدة = (*الحالة).الوحدات[ف].الوحدة;
        إذا ((الوحدة.القيمة مثل طبيعي) < العدد && !المبلوغة[الوحدة.القيمة]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف معرف_وحدة_لمفتاح(الحالة: &حالة_واجهة_مرحلية, المفتاح: &مفتاح_وحدة_مقنن): اختياري معرف_وحدة {
    طابق وحدة_محملة_بالمفتاح(&(*الحالة).المحمل, المفتاح) مع
    | اختياري.موجود(المحملة) -> { أرجع اختياري.موجود(المحملة.الوحدة); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// ---- Early cutoff --------------------------------------------------------------
// What a module's text is made of, to compare two versions of it: every token
// outside its function bodies and each body's two braces (the module's
// imports, declarations, signatures, parameter names, type definitions,
// top-level values and their order), with their kinds and ends; then, for
// each function with a body, in order, the inside of the body (between the
// braces), its tokens, and whether the function is generic or has
// compile-time parameters (its callers instantiate its body). Comments and
// spacing are not tokens.
نوع هيكل_نص_جلسة = {
    الأنواع: متجه رمز,
    البدايات: متجه طبيعي,
    النهايات: متجه طبيعي,
    الدواخل: متجه نطاق,
    القالبية: متجه منطقي,
    أول_الداخلية: متجه طبيعي,
    عدد_الداخلية: متجه طبيعي,
    أنواع_الداخلية: متجه رمز,
    بدايات_الداخلية: متجه طبيعي,
    نهايات_الداخلية: متجه طبيعي,
    الطول: طبيعي
};

نوع نص_محلل_جلسة = {
    الهيكل: هيكل_نص_جلسة,
    الشجرة: وحدة_مصدر,
    الرموز: متجه رمز_مصدر
};

// Lexes and parses a module's text (as a tooling request loads it, as source
// المعرف) and records what it is made of. None when it does not lex or parse
// whole, or when a declaration has an annotation (its expansion generates
// declarations from it) or the module declares `module` spellings.
عرف حلل_نص_وحدة_جلسة(
    النص: &نص,
    المعرف: طبيعي,
    الاسم: &نص,
    الهدف: &اختياري واصف_هدف
): اختياري نص_محلل_جلسة {
    ليكن المصدر: مصدر = مصدر_جديد(المعرف, انسخ_نص(الاسم), انسخ_نص(النص));
    طابق حلل_معجميا(&المصدر) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_تحليل_معجمي.سلسلة({ الرموز: رموز_السلسلة }) -> {
        ليكن الأخطاء: متغير متجه خطأ_نحوي = [];
        ليكن الشجرة: وحدة_مصدر = حلل_الرموز_للأدوات_لهدف(&المصدر, &رموز_السلسلة, الهدف, &متغير الأخطاء);
        إذا ((الطول(الأخطاء) مثل طبيعي) > 0) { أرجع اختياري.لا_شيء(); };
        إذا ((الطول(الشجرة.تصريحات_الوحدات) مثل طبيعي) > 0) { أرجع اختياري.لا_شيء(); };
        ليكن الأجسام: متغير متجه نطاق = [];
        ليكن القالبية: متغير متجه منطقي = [];
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول(الشجرة.العناصر) مثل طبيعي)) {
            طابق الشجرة.العناصر[ع] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                إذا ((الطول(الدالة.السمات) مثل طبيعي) > 0) { أرجع اختياري.لا_شيء(); };
                طابق الدالة.الجسم مع
                | اختياري.موجود(الجسم) -> {
                    ألحق(الأجسام, الجسم.النطاق);
                    ليكن قالبية: متغير منطقي = (الطول(الدالة.معاملات_النوع) مثل طبيعي) > 0;
                    ليكن م: متغير طبيعي = 0;
                    طالما (م < (الطول(الدالة.المعاملات) مثل طبيعي)) {
                        إذا (الدالة.المعاملات[م].مطلوب_مسبقا) { قالبية := صواب; };
                        م := م + 1;
                    }
                    ألحق(القالبية, قالبية);
                }
                | اختياري.لا_شيء -> { };
            }
            | عنصر_وحدة.نوع(التصريح) -> {
                إذا ((الطول(التصريح.السمات) مثل طبيعي) > 0) { أرجع اختياري.لا_شيء(); };
            }
            | عنصر_وحدة.قيمة_عليا(التصريح) -> {
                إذا ((الطول(التصريح.السمات) مثل طبيعي) > 0) { أرجع اختياري.لا_شيء(); };
            }
            | عنصر_وحدة.تجميع(_, _) -> { };
            ع := ع + 1;
        }
        ليكن عدد_الأجسام: طبيعي = الطول(الأجسام) مثل طبيعي;
        ليكن الأنواع: متغير متجه رمز = [];
        ليكن البدايات: متغير متجه طبيعي = [];
        ليكن النهايات: متغير متجه طبيعي = [];
        ليكن أول_الداخلية: متغير متجه طبيعي = [];
        ليكن عدد_الداخلية: متغير متجه طبيعي = [];
        ليكن نهايات_الفتح: متغير متجه طبيعي = [];
        ليكن بدايات_الإغلاق: متغير متجه طبيعي = [];
        ليكن ب: متغير طبيعي = 0;
        طالما (ب < عدد_الأجسام) {
            ألحق(أول_الداخلية, 0);
            ألحق(عدد_الداخلية, 0);
            ألحق(نهايات_الفتح, 0);
            ألحق(بدايات_الإغلاق, 0);
            ب := ب + 1;
        }
        ليكن أنواع_الداخلية: متغير متجه رمز = [];
        ليكن بدايات_الداخلية: متغير متجه طبيعي = [];
        ليكن نهايات_الداخلية: متغير متجه طبيعي = [];
        ب := 0;
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < (الطول(رموز_السلسلة) مثل طبيعي)) {
            ليكن النوع: رمز = رموز_السلسلة[ر].النوع;
            ليكن البداية: طبيعي = رموز_السلسلة[ر].النطاق.البداية.البايت مثل طبيعي;
            ليكن النهاية: طبيعي = رموز_السلسلة[ر].النطاق.النهاية.البايت مثل طبيعي;
            إذا (النوع != رمز.نهاية_الملف()) {
                طالما (ب < عدد_الأجسام && (الأجسام[ب].النهاية.البايت مثل طبيعي) <= البداية) { ب := ب + 1; }
                ليكن داخلي: متغير منطقي = خطأ;
                إذا (ب < عدد_الأجسام) {
                    ليكن بداية_الجسم: طبيعي = الأجسام[ب].البداية.البايت مثل طبيعي;
                    ليكن نهاية_الجسم: طبيعي = الأجسام[ب].النهاية.البايت مثل طبيعي;
                    إذا (البداية == بداية_الجسم) { نهايات_الفتح[ب] := النهاية; };
                    إذا (النهاية == نهاية_الجسم) { بدايات_الإغلاق[ب] := البداية; };
                    داخلي := بداية_الجسم <= البداية && النهاية <= نهاية_الجسم && البداية != بداية_الجسم && النهاية != نهاية_الجسم;
                };
                إذا (داخلي) {
                    إذا (عدد_الداخلية[ب] == 0) { أول_الداخلية[ب] := الطول(أنواع_الداخلية) مثل طبيعي; };
                    عدد_الداخلية[ب] := عدد_الداخلية[ب] + 1;
                    ألحق(أنواع_الداخلية, النوع);
                    ألحق(بدايات_الداخلية, البداية);
                    ألحق(نهايات_الداخلية, النهاية);
                } وإلا {
                    ألحق(الأنواع, النوع);
                    ألحق(البدايات, البداية);
                    ألحق(النهايات, النهاية);
                };
            };
            ر := ر + 1;
        }
        ليكن الدواخل: متغير متجه نطاق = [];
        ب := 0;
        طالما (ب < عدد_الأجسام) {
            ليكن الأول: موضع = { المصدر: (المعرف مثل ط32), البايت: (نهايات_الفتح[ب] مثل ط32) };
            ليكن الثاني: موضع = { المصدر: (المعرف مثل ط32), البايت: (بدايات_الإغلاق[ب] مثل ط32) };
            إذا (بدايات_الإغلاق[ب] < نهايات_الفتح[ب]) { أرجع اختياري.لا_شيء(); };
            ألحق(الدواخل, نطاق_بين(الأول, الثاني));
            ب := ب + 1;
        }
        ليكن الهيكل: هيكل_نص_جلسة = {
            الأنواع: الأنواع,
            البدايات: البدايات,
            النهايات: النهايات,
            الدواخل: الدواخل,
            القالبية: القالبية,
            أول_الداخلية: أول_الداخلية,
            عدد_الداخلية: عدد_الداخلية,
            أنواع_الداخلية: أنواع_الداخلية,
            بدايات_الداخلية: بدايات_الداخلية,
            نهايات_الداخلية: نهايات_الداخلية,
            الطول: الطول(*النص) مثل طبيعي
        };
        ليكن المحلل: نص_محلل_جلسة = { الهيكل: الهيكل, الشجرة: الشجرة, الرموز: رموز_السلسلة };
        أرجع اختياري.موجود(المحلل);
    };
}

// Whether two texts have the same bytes between the given ends.
عرف بايتات_متساوية_جلسة(
    الأول: &نص, من_الأول: طبيعي, إلى_الأول: طبيعي,
    الثاني: &نص, من_الثاني: طبيعي, إلى_الثاني: طبيعي
): منطقي {
    إذا (إلى_الأول < من_الأول || إلى_الثاني < من_الثاني) { أرجع خطأ; };
    إذا ((إلى_الأول - من_الأول) != (إلى_الثاني - من_الثاني)) { أرجع خطأ; };
    إذا (إلى_الأول > (الطول(*الأول) مثل طبيعي) || إلى_الثاني > (الطول(*الثاني) مثل طبيعي)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (إلى_الأول - من_الأول)) {
        إذا ((*الأول)[من_الأول + ف] != (*الثاني)[من_الثاني + ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Whether two versions of a module's text have the same tokens outside the
// function bodies, in the same order, with the same bodies: no declaration
// changed.
عرف هيكلان_متساويان_جلسة(
    القديم: &هيكل_نص_جلسة, نص_القديم: &نص,
    الجديد: &هيكل_نص_جلسة, نص_الجديد: &نص
): منطقي {
    إذا (الطول((*القديم).الأنواع) != الطول((*الجديد).الأنواع)) { أرجع خطأ; };
    إذا (الطول((*القديم).الدواخل) != الطول((*الجديد).الدواخل)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القديم).القالبية) مثل طبيعي)) {
        إذا ((*القديم).القالبية[ف] != (*الجديد).القالبية[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*القديم).الأنواع) مثل طبيعي)) {
        إذا ((*القديم).الأنواع[ف] != (*الجديد).الأنواع[ف]) { أرجع خطأ; };
        إذا (!بايتات_متساوية_جلسة(
            نص_القديم, (*القديم).البدايات[ف], (*القديم).النهايات[ف],
            نص_الجديد, (*الجديد).البدايات[ف], (*الجديد).النهايات[ف]
        )) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Whether the body of a generic function (or one with compile-time
// parameters) has other tokens: its callers' facts may read them.
عرف قالب_تغير_جلسة(
    القديم: &هيكل_نص_جلسة, نص_القديم: &نص,
    الجديد: &هيكل_نص_جلسة, نص_الجديد: &نص
): منطقي {
    ليكن ب: متغير طبيعي = 0;
    طالما (ب < (الطول((*القديم).القالبية) مثل طبيعي)) {
        إذا ((*القديم).القالبية[ب]) {
            إذا ((*القديم).عدد_الداخلية[ب] != (*الجديد).عدد_الداخلية[ب]) { أرجع صواب; };
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (*القديم).عدد_الداخلية[ب]) {
                ليكن أ: طبيعي = (*القديم).أول_الداخلية[ب] + ف;
                ليكن ج: طبيعي = (*الجديد).أول_الداخلية[ب] + ف;
                إذا ((*القديم).أنواع_الداخلية[أ] != (*الجديد).أنواع_الداخلية[ج]) { أرجع صواب; };
                إذا (!بايتات_متساوية_جلسة(
                    نص_القديم, (*القديم).بدايات_الداخلية[أ], (*القديم).نهايات_الداخلية[أ],
                    نص_الجديد, (*الجديد).بدايات_الداخلية[ج], (*الجديد).نهايات_الداخلية[ج]
                )) {
                    أرجع صواب;
                };
                ف := ف + 1;
            }
        };
        ب := ب + 1;
    }
    أرجع خطأ;
}

عرف انسخ_طبيعيات_جلسة(القيم: &متجه طبيعي): متجه طبيعي {
    ليكن الناتج: متغير متجه طبيعي = [];
    احجز_سعة(الناتج, الطول(*القيم) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) { ألحق(الناتج, (*القيم)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

// Where the positions of the old text move in the new one.
عرف نقل_بين_هيكلين_جلسة(القديم: &هيكل_نص_جلسة, الجديد: &هيكل_نص_جلسة): نقل_مواضع_وحدة {
    ليكن الدواخل: متغير متجه نطاق = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القديم).الدواخل) مثل طبيعي)) { ألحق(الدواخل, (*القديم).الدواخل[ف]); ف := ف + 1; }
    ليكن النقل: نقل_مواضع_وحدة = {
        البدايات_القديمة: انسخ_طبيعيات_جلسة(&(*القديم).البدايات),
        النهايات_القديمة: انسخ_طبيعيات_جلسة(&(*القديم).النهايات),
        البدايات_الجديدة: انسخ_طبيعيات_جلسة(&(*الجديد).البدايات),
        النهايات_الجديدة: انسخ_طبيعيات_جلسة(&(*الجديد).النهايات),
        الطول_القديم: (*القديم).الطول,
        الطول_الجديد: (*الجديد).الطول,
        الدواخل_القديمة: الدواخل
    };
    أرجع النقل;
}

// The position in the state's modules of the module with key المفتاح.
عرف موضع_وحدة_في_حالة(الحالة: &حالة_واجهة_مرحلية, المفتاح: &مفتاح_وحدة_مقنن): اختياري طبيعي {
    طابق معرف_وحدة_لمفتاح(الحالة, المفتاح) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الحالة).الوحدات) مثل طبيعي)) {
            إذا (معرفا_وحدة_متساويان((*الحالة).الوحدات[ف].الوحدة, المعرف)) { أرجع اختياري.موجود(ف); };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

// The final state a request ends with, and the hashes of the texts it was
// analysed from (اللقطة), kept so that a following edit of one module's
// bodies reuses it whole; the first module that request analysed (thread
// captures are checked from there, as it did); and the ownership analysis of
// every module, in which each fact is one module's (ملكية_بلا_مصدر_جلسة).
عام نوع نهائية_جلسة = {
    اللقطة: لقطة_تحليل,
    بداية_الطلب: طبيعي,
    الملكية: اختياري ملكية_مخبأة_واجهة
};

// Keeps the final state of a request that changed at most one module (an
// editor's edits change one at a time; a request that changed more keeps
// none). Whether it was kept: the request then records the ownership
// analysis of every module with it (احفظ_ملكية_نهائية_جلسة).
عرف احفظ_نهائية_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    الحالة: &حالة_واجهة_مرحلية,
    الحالية: &متجه حالة_نص_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    عدد_المتغيرة: طبيعي,
    بداية_الطلب: طبيعي
): منطقي {
    (*الجلسة).النهائية := اختياري.لا_شيء();
    إذا ((*الجلسة).الجاهزة_من == 3) { أسقط_الجاهزة(الجلسة); };
    إذا (عدد_المتغيرة > 1 || (*الحالة).الأنواع_متوقفة) { أرجع خطأ; };
    ليكن اللقطة: لقطة_تحليل = التقط_حالة(
        الحالة, &(*الجلسة).السجل, الحالية, البيئة, الهدف, (*الجلسة).التوليد_التالي
    );
    (*الجلسة).التوليد_التالي := (*الجلسة).التوليد_التالي + 1;
    ليكن النهائية: نهائية_جلسة = {
        اللقطة: اللقطة,
        بداية_الطلب: بداية_الطلب,
        الملكية: اختياري.لا_شيء()
    };
    (*الجلسة).النهائية := اختياري.موجود(النهائية);
    أرجع صواب;
}

// Records with the kept final state the ownership analysis of every module;
// without it the state is not kept.
عرف احفظ_ملكية_نهائية_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    الكل: اختياري ملكية_مخبأة_واجهة
): فراغ {
    ليكن النهائية: متغير اختياري نهائية_جلسة = اختياري.لا_شيء();
    بدّل(النهائية, (*الجلسة).النهائية);
    طابق النهائية مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المحفوظة) -> {
        طابق الكل مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الملكية) -> {
            ليكن المعدلة: متغير نهائية_جلسة = المحفوظة;
            المعدلة.الملكية := اختياري.موجود(الملكية);
            (*الجلسة).النهائية := اختياري.موجود(المعدلة);
        };
    };
}

// The ownership analysis of every module but one (whose source is
// المصدر): each moved name is a place in a source, each left-out function a
// Symbol declared in one, each diagnostic about the place it is reported at.
// None when a diagnostic has no place, or one of another module names a place
// in that module's text (it would have to move).
عرف ملكية_بلا_مصدر_جلسة(
    الكل: &ملكية_مخبأة_واجهة,
    المصدر: طبيعي,
    الحالة: &حالة_واجهة_مرحلية
): اختياري ملكية_مخبأة_واجهة {
    ليكن التشخيصات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكل).التشخيصات.التشخيصات) مثل طبيعي)) {
        ليكن التشخيص: &تشخيص = &(*الكل).التشخيصات.التشخيصات[ف];
        ليكن له_المصدر: متغير منطقي = خطأ;
        طابق (*التشخيص).المصدر_الرئيسي مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الموقع) -> {
            له_المصدر := (الموقع.النطاق.البداية.المصدر مثل طبيعي) == المصدر;
        };
        إذا (!له_المصدر) {
            إذا (تشخيص_يذكر_مصدرا(التشخيص, المصدر)) { أرجع اختياري.لا_شيء(); };
            أصدر_تشخيصا(&متغير التشخيصات, التشخيص);
        };
        ف := ف + 1;
    }
    ليكن النقول: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*الكل).الأسماء_المنقولة) مثل طبيعي)) {
        ليكن المفتاح: طبيعي = (*الكل).الأسماء_المنقولة[ف];
        إذا ((المفتاح / 1099511627776) != المصدر) { ألحق(النقول, المفتاح); };
        ف := ف + 1;
    }
    ليكن المتروكة: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*الكل).المتروكة) مثل طبيعي)) {
        ليكن الرمز: طبيعي = (*الكل).المتروكة[ف];
        ليكن له: متغير منطقي = خطأ;
        إذا (الرمز < (الطول((*الحالة).سياق_الأسماء.الرموز) مثل طبيعي)) {
            له := ((*الحالة).سياق_الأسماء.الرموز[الرمز].نطاق_الاسم.البداية.المصدر مثل طبيعي) == المصدر;
        };
        إذا (!له) { ألحق(المتروكة, الرمز); };
        ف := ف + 1;
    }
    ليكن الناتج: ملكية_مخبأة_واجهة = {
        التوليد: 0, العدد: 0,
        التشخيصات: التشخيصات, الأسماء_المنقولة: النقول, المتروكة: المتروكة
    };
    أرجع اختياري.موجود(الناتج);
}

// The text a state's module was analysed from: its source's text up to the
// end of the module's root scope (an expansion appends text after it).
عرف نص_أصلي_في_حالة(الحالة: &حالة_واجهة_مرحلية, الموضع: طبيعي): اختياري نص {
    ليكن المعرف: طبيعي = (*الحالة).أشجار_الوحدات[الموضع].معرف_المصدر;
    طابق وحدة_في_الرسم(&(*الحالة).الرسم, (*الحالة).الوحدات[الموضع].الوحدة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الدلالية) -> {
        ليكن الجذر: طبيعي = الدلالية.النطاق_الجذري.القيمة مثل طبيعي;
        إذا (الجذر >= (الطول((*الحالة).سياق_الأسماء.النطاقات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        طابق (*الحالة).سياق_الأسماء.النطاقات[الجذر].نطاق_المصدر مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المدى) -> {
            إذا ((المدى.البداية.المصدر مثل طبيعي) != المعرف || المدى.البداية.البايت != 0) {
                أرجع اختياري.لا_شيء();
            };
            أرجع مقطع_نص(
                &(*الحالة).سياق_المصادر.المصادر[المعرف].المحتوى, 0, المدى.النهاية.البايت مثل طبيعي
            );
        };
    };
}

// The request when the session kept the final state of the request before
// and, since then, at most one module changed, none of whose declarations:
// that state as it is, or with that module's bodies checked again. None when
// it is not so (the stages analyse the request).
عرف حلل_أجساما_في_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    الحالية: &متجه حالة_نص_جلسة,
    المتغيرة: &متجه منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): اختياري نتيجة_بناء_واجهة_قابلة_للإلغاء {
    ليكن النهائية: متغير اختياري نهائية_جلسة = اختياري.لا_شيء();
    بدّل(النهائية, (*الجلسة).النهائية);
    طابق النهائية مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المحفوظة) -> {
        ليكن الناتج: اختياري نتيجة_بناء_واجهة_قابلة_للإلغاء = حلل_أجساما_من_نهائية(
            الجلسة, &المحفوظة, البيئة, الهدف, الحالية, المتغيرة, الإلغاء
        );
        (*الجلسة).النهائية := اختياري.موجود(المحفوظة);
        أرجع الناتج;
    };
}

عرف حلل_أجساما_من_نهائية(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    النهائية: &نهائية_جلسة,
    البيئة: &بيئة_وحدات_منطقية,
    الهدف: &اختياري واصف_هدف,
    الحالية: &متجه حالة_نص_جلسة,
    المتغيرة: &متجه منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): اختياري نتيجة_بناء_واجهة_قابلة_للإلغاء {
    // The kept ownership analysis of every module.
    ليكن الكل: متغير ملكية_مخبأة_واجهة = {
        التوليد: 0, العدد: 0, التشخيصات: مجموعة_تشخيصات_جديدة(),
        الأسماء_المنقولة: [], المتروكة: []
    };
    طابق (*النهائية).الملكية مع
    | اختياري.موجود(الملكية) -> { الكل := استنسخ(&الملكية); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    // At most one module changed since that request, none waits for a file
    // to appear, and every other text, the root files and the packages are
    // as they were.
    ليكن العدد: طبيعي = الطول((*الجلسة).السجل) مثل طبيعي;
    إذا ((الطول((*النهائية).اللقطة.المفاتيح) مثل طبيعي) != العدد || (الطول(*الحالية) مثل طبيعي) != العدد) {
        أرجع اختياري.لا_شيء();
    };
    ليكن المتغير: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا ((*الجلسة).السجل[ف].متسخة) { أرجع اختياري.لا_شيء(); };
        ليكن تغير: منطقي = ف < (الطول(*المتغيرة) مثل طبيعي) && (*المتغيرة)[ف];
        إذا (تغير) {
            طابق المتغير مع
            | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
            | اختياري.لا_شيء -> { المتغير := اختياري.موجود(ف); };
        };
        ف := ف + 1;
    }
    // The module that changed since the kept state (it may have changed in
    // requests before this one, which re-checked it from the same state).
    ليكن المستثنى: متغير اختياري مفتاح_وحدة_مقنن = اختياري.لا_شيء();
    طابق المتغير مع
    | اختياري.موجود(الموضع) -> { المستثنى := اختياري.موجود(انسخ_مفتاح_وحدة_مقنن(&(*الجلسة).السجل[الموضع].المفتاح)); }
    | اختياري.لا_شيء -> {
        // Unchanged since the request before: the module, if any, that
        // differs from the kept state.
        ف := 0;
        طالما (ف < (الطول((*النهائية).اللقطة.المفاتيح) مثل طبيعي)) {
            طابق موضع_في_السجل(&(*الجلسة).السجل, &(*النهائية).اللقطة.المفاتيح[ف], (*النهائية).اللقطة.الهاشات_المفتاحية[ف]) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الموضع) -> {
                ليكن مختلف: متغير منطقي = صواب;
                طابق (*الحالية)[الموضع].الهاش مع
                | اختياري.موجود(الهاش) -> { مختلف := الهاش != (*النهائية).اللقطة.الهاشات[ف]; }
                | اختياري.لا_شيء -> { };
                إذا (مختلف) {
                    طابق المستثنى مع
                    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.لا_شيء -> { المستثنى := اختياري.موجود(انسخ_مفتاح_وحدة_مقنن(&(*النهائية).اللقطة.المفاتيح[ف])); };
                };
            };
            ف := ف + 1;
        }
    };
    ليكن بلا_بذور: متجه منطقي = [];
    إذا (!لقطة_صالحة_عدا(&(*النهائية).اللقطة, &(*الجلسة).السجل, الحالية, &بلا_بذور, البيئة, الهدف, &المستثنى)) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الحالة_المحفوظة: &حالة_واجهة_مرحلية = &(*النهائية).اللقطة.الحالة;
    // With a changed module: its position, its old and new texts, and that no
    // declaration changed.
    ليكن الطلب: متغير اختياري طلب_فحص_أجسام_وحدة = اختياري.لا_شيء();
    ليكن الملكية_الباقية: متغير ملكية_مخبأة_واجهة = استنسخ(&الكل);
    ليكن المستثناة: متغير اختياري طبيعي = اختياري.لا_شيء();
    طابق المستثنى مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المفتاح) -> {
        ليكن الموضع: متغير طبيعي = 0;
        طابق موضع_وحدة_في_حالة(الحالة_المحفوظة, &المفتاح) مع
        | اختياري.موجود(القيمة) -> { الموضع := القيمة; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        إذا (!وحدة_تقبل_فحص_الأجسام(الحالة_المحفوظة, الموضع)) { أرجع اختياري.لا_شيء(); };
        ليكن المعرف: طبيعي = (*الحالة_المحفوظة).أشجار_الوحدات[الموضع].معرف_المصدر;
        ليكن الاسم: نص = انسخ_نص(&(*الحالة_المحفوظة).سياق_المصادر.المصادر[المعرف].الاسم);
        // The old text, as the kept state's hash of it says.
        ليكن القديم: متغير نص = «»;
        طابق نص_أصلي_في_حالة(الحالة_المحفوظة, الموضع) مع
        | اختياري.موجود(القيمة) -> { القديم := القيمة; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        ليكن هاش_القديم: متغير اختياري طبيعي = اختياري.لا_شيء();
        ف := 0;
        طالما (ف < (الطول((*النهائية).اللقطة.المفاتيح) مثل طبيعي)) {
            إذا (مفتاحا_وحدة_متساويان(&(*النهائية).اللقطة.المفاتيح[ف], &المفتاح)) {
                هاش_القديم := اختياري.موجود((*النهائية).اللقطة.الهاشات[ف]);
            };
            ف := ف + 1;
        }
        طابق هاش_القديم مع
        | اختياري.موجود(الهاش) -> { إذا (هاش_نص_جلسة(&القديم) != الهاش) { أرجع اختياري.لا_شيء(); }; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        // The new text, as this request's hash of it says.
        ليكن النص: متغير نص = «»;
        طابق حدد_مصدر_وحدة_لهدف(البيئة, &المفتاح, الهدف) مع
        | نتيجة_تحديد_مصدر.موجود(المحدد) -> { النص := انسخ_نص(&المحدد.المحتوى); }
        | نتيجة_تحديد_مصدر.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
        طابق موضع_في_السجل(&(*الجلسة).السجل, &المفتاح, هاش_مفتاح_جلسة(0, &المفتاح)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(موضع_السجل) -> {
            طابق (*الحالية)[موضع_السجل].الهاش مع
            | اختياري.موجود(الهاش) -> { إذا (هاش_نص_جلسة(&النص) != الهاش) { أرجع اختياري.لا_شيء(); }; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        };
        ليكن هيكل_القديم: متغير اختياري هيكل_نص_جلسة = اختياري.لا_شيء();
        طابق حلل_نص_وحدة_جلسة(&القديم, المعرف, &الاسم, الهدف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود({ الهيكل: الهيكل, الشجرة: _, الرموز: _ }) -> { هيكل_القديم := اختياري.موجود(الهيكل); };
        طابق هيكل_القديم مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القديم_م) -> {
            طابق حلل_نص_وحدة_جلسة(&النص, المعرف, &الاسم, الهدف) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود({ الهيكل: الهيكل, الشجرة: الشجرة, الرموز: الرموز }) -> {
                إذا (!هيكلان_متساويان_جلسة(&القديم_م, &القديم, &الهيكل, &النص)) { أرجع اختياري.لا_شيء(); };
                إذا (قالب_تغير_جلسة(&القديم_م, &القديم, &الهيكل, &النص)) { أرجع اختياري.لا_شيء(); };
                // The ownership of every other module, from the kept state.
                طابق ملكية_بلا_مصدر_جلسة(&الكل, المعرف, الحالة_المحفوظة) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(الباقية) -> { الملكية_الباقية := الباقية; };
                ليكن البداية: متغير طبيعي = (*النهائية).بداية_الطلب;
                إذا (الموضع < البداية) { البداية := الموضع; };
                ليكن المطلوب: طلب_فحص_أجسام_وحدة = {
                    الموضع: الموضع,
                    النص: النص,
                    الشجرة: الشجرة,
                    الرموز: الرموز,
                    النقل: نقل_بين_هيكلين_جلسة(&القديم_م, &الهيكل),
                    بداية_الطلب: البداية
                };
                الطلب := اختياري.موجود(المطلوب);
                المستثناة := اختياري.موجود(الموضع);
            };
        };
    };
    // The copy made ahead when there is one, else a copy now: the kept state
    // is never changed.
    ليكن الحالة: متغير حالة_واجهة_مرحلية = حالة_واجهة_مرحلية_جديدة(استنسخ(الهدف));
    ليكن جاهزة: متغير منطقي = خطأ;
    طابق خذ_الجاهزة(الجلسة, 3) مع
    | اختياري.موجود(القيمة) -> { الحالة := القيمة; جاهزة := صواب; }
    | اختياري.لا_شيء -> { الحالة := استنسخ(الحالة_المحفوظة); };
    ليكن المحللة: متغير طبيعي = 0;
    طابق الطلب مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المطلوب) -> {
        طابق افحص_أجسام_وحدة_في_حالة(الحالة, المطلوب, الإلغاء) مع
        | ناتج_فحص_أجسام_وحدة.ملغى -> {
            أرجع اختياري.موجود(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة());
        }
        | ناتج_فحص_أجسام_وحدة.متعذر -> { أرجع اختياري.لا_شيء(); }
        | ناتج_فحص_أجسام_وحدة.مكتمل(المفحوصة) -> {
            الحالة := المفحوصة;
            المحللة := 1;
        };
    };
    إذا (هل_واجهة_ملغاة(الإلغاء)) {
        أرجع اختياري.موجود(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة());
    };
    ليكن الوحدات: طبيعي = الطول(الحالة.الوحدات) مثل طبيعي;
    (*الجلسة).الإحصاء.اللقطة := 3;
    (*الجلسة).الإحصاء.المحللة := المحللة;
    (*الجلسة).الإحصاء.المعاد_استعمالها := الوحدات - المحللة;
    (*الجلسة).الإحصاء.جاهزة := جاهزة;
    (*الجلسة).الإحصاء.قطع_مبكر := صواب;
    // The record: the current texts.
    ف := 0;
    طالما (ف < العدد) {
        (*الجلسة).السجل[ف].النص := (*الحالية)[ف];
        طابق (*الحالية)[ف].الهاش مع
        | اختياري.موجود(الهاش) -> { (*الجلسة).السجل[ف].الهاش := الهاش; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق المتغير مع
    | اختياري.موجود(الموضع) -> {
        ليكن الساخنة: متجه مفتاح_وحدة_مقنن = [انسخ_مفتاح_وحدة_مقنن(&(*الجلسة).السجل[الموضع].المفتاح)];
        (*الجلسة).الساخنة := الساخنة;
    }
    | اختياري.لا_شيء -> { };
    // Every other module's ownership from the kept state; the re-checked
    // one's now.
    ليكن الملكية: متغير ملكية_مرحلية_واجهة = {
        العدد: 0, التوليد: 0, المخبأة: اختياري.لا_شيء(),
        احفظ_الكل: خطأ, الكل: اختياري.موجود(الملكية_الباقية), من_الكل: صواب,
        المستثناة: المستثناة
    };
    طابق أنه_واجهة_مرحلية_بملكية(الحالة, البيئة, صواب, &متغير الملكية) مع
    | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
        أرجع اختياري.موجود(نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة));
    }
    | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
        أرجع اختياري.موجود(نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات));
    };
}

// ---- Requests ----------------------------------------------------------------

نوع ناتج_طلب_مرحلي =
    | مكتمل بنوع نتيجة_بناء_واجهة_قابلة_للإلغاء
    // Something a kept state cannot account for: analyse in full.
    | كامل
;

// Analyses a tooling request (الطلب.احتفظ_بحقائق_الأدوات) in the session: the
// same result as ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء, reusing what the session
// kept. A cancelled request leaves the kept states as they were. A request
// without tooling facts (a compilation) does not use the session.
عام عرف ابن_واجهة_في_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    الطلب: طلب_واجهة_وحدة,
    الهدف: اختياري واصف_هدف,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
    إذا (!الطلب.احتفظ_بحقائق_الأدوات) {
        أرجع ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, الهدف, المفاتيح_الإضافية, الإلغاء);
    };
    ليكن البيئة: &بيئة_وحدات_منطقية = &الطلب.البيئة;
    ليكن الجذر: &مفتاح_وحدة_مقنن = &الطلب.المفتاح_الجذري;
    ليكن البصمة: طبيعي = بصمة_طلب_جلسة(البيئة, &الهدف, الجذر, المفاتيح_الإضافية);
    إذا (!(*الجلسة).لها_بصمة || (*الجلسة).البصمة != البصمة) {
        أفرغ_جلسة_تحليل(الجلسة);
        (*الجلسة).لها_بصمة := صواب;
        (*الجلسة).البصمة := البصمة;
    };
    (*الجلسة).الإحصاء := إحصاء_طلب_جلسة_فارغ();
    ليكن جذور_المساحة: متغير متجه طبيعي = [(*الجذر).الجذر.القيمة];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المفاتيح_الإضافية) مثل طبيعي)) {
        ألحق(جذور_المساحة, (*المفاتيح_الإضافية)[ف].الجذر.القيمة);
        ف := ف + 1;
    }
    // The current text of every module of the last request.
    ليكن الحالية: متغير متجه حالة_نص_جلسة = [];
    ليكن المتغيرة: متغير متجه منطقي = [];
    ليكن عدد_المتغيرة: متغير طبيعي = 0;
    ليكن جذر_تغير: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < (الطول((*الجلسة).السجل) مثل طبيعي)) {
        // A file whose size and modification time did not change keeps its hash.
        ليكن السابقة: اختياري حالة_نص_جلسة = اختياري.موجود((*الجلسة).السجل[ف].النص);
        ليكن الحالي: حالة_نص_جلسة = حالة_نص_حالية_جلسة(
            البيئة, &(*الجلسة).السجل[ف].المفتاح, &الهدف, &(*الجلسة).السجل[ف].المسار, &السابقة
        );
        ليكن تغير: متغير منطقي = صواب;
        طابق الحالي.الهاش مع
        | اختياري.موجود(الهاش) -> { تغير := الهاش != (*الجلسة).السجل[ف].الهاش; }
        | اختياري.لا_شيء -> { };
        إذا (تغير) {
            عدد_المتغيرة := عدد_المتغيرة + 1;
            إذا ((*الجلسة).السجل[ف].ملف_جذر) { جذر_تغير := صواب; };
        };
        ألحق(الحالية, الحالي);
        ألحق(المتغيرة, تغير);
        ف := ف + 1;
    }
    (*الجلسة).الإحصاء.المتغيرة := عدد_المتغيرة;
    إذا (جذر_تغير || (الطول((*الجلسة).السجل) مثل طبيعي) == 0) {
        أرجع حلل_كاملا_في_جلسة(الجلسة, البيئة, الجذر, المفاتيح_الإضافية, الهدف, &جذور_المساحة, الإلغاء);
    };
    // Early cutoff: an edit of the bodies of the module the kept final
    // state was made for.
    طابق حلل_أجساما_في_جلسة(الجلسة, البيئة, &الهدف, &الحالية, &المتغيرة, الإلغاء) مع
    | اختياري.موجود(الناتج) -> { أرجع الناتج; }
    | اختياري.لا_شيء -> { };
    طابق حلل_مرحليا_في_جلسة(
        الجلسة, البيئة, الجذر, المفاتيح_الإضافية, استنسخ(&الهدف), &جذور_المساحة,
        &الحالية, &المتغيرة, الإلغاء
    ) مع
    | ناتج_طلب_مرحلي.مكتمل(الناتج) -> { أرجع الناتج; }
    | ناتج_طلب_مرحلي.كامل -> {
        أفرغ_جلسة_تحليل(الجلسة);
        (*الجلسة).لها_بصمة := صواب;
        (*الجلسة).البصمة := البصمة;
        أرجع حلل_كاملا_في_جلسة(الجلسة, البيئة, الجذر, المفاتيح_الإضافية, الهدف, &جذور_المساحة, الإلغاء);
    };
}

// A full analysis in one stage; the session records its modules for the next
// request (which builds the kept states).
عرف حلل_كاملا_في_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: &مفتاح_وحدة_مقنن,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الهدف: اختياري واصف_هدف,
    جذور_المساحة: &متجه طبيعي,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    (*الجلسة).الإحصاء.كاملة := صواب;
    (*الجلسة).الأساس := اختياري.لا_شيء();
    (*الجلسة).المساحة := اختياري.لا_شيء();
    (*الجلسة).النهائية := اختياري.لا_شيء();
    أسقط_الجاهزة(الجلسة);
    طابق حلل_حالة_واجهة_كاملة(البيئة, الجذر, المفاتيح_الإضافية, استنسخ(&الهدف), صواب, الإلغاء) مع
    | ناتج_مرحلة_واجهة.ملغاة -> { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); }
    | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> {
        ليكن بلا_سجل: متجه وحدة_جلسة_تحليل = [];
        (*الجلسة).السجل := بلا_سجل;
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات);
    }
    | ناتج_مرحلة_واجهة.مكتملة(الحالة) -> {
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); };
        ليكن بلا_حالية: متجه حالة_نص_جلسة = [];
        ليكن بلا_سجل_قديم: متجه وحدة_جلسة_تحليل = [];
        (*الجلسة).السجل := سجل_من_حالة(&الحالة, &بلا_سجل_قديم, &بلا_حالية, البيئة, &الهدف, جذور_المساحة);
        (*الجلسة).الإحصاء.المحللة := الطول(الحالة.الوحدات) مثل طبيعي;
        // The final state, kept for an edit of one module's bodies (early
        // cutoff), with the texts this request read.
        ليكن نصوص_السجل: متغير متجه حالة_نص_جلسة = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الجلسة).السجل) مثل طبيعي)) { ألحق(نصوص_السجل, (*الجلسة).السجل[ف].النص); ف := ف + 1; }
        ليكن احفظ_الكل: منطقي = احفظ_نهائية_جلسة(الجلسة, &الحالة, &نصوص_السجل, البيئة, &الهدف, 0, 0);
        ليكن الملكية: متغير ملكية_مرحلية_واجهة = ملكية_مرحلية_كاملة_واجهة();
        الملكية.احفظ_الكل := احفظ_الكل;
        ليكن الناتج: نتيجة_بناء_واجهة_وحدة = أنه_واجهة_مرحلية_بملكية(الحالة, البيئة, صواب, &متغير الملكية);
        ليكن الكل: متغير اختياري ملكية_مخبأة_واجهة = اختياري.لا_شيء();
        بدّل(الكل, الملكية.الكل);
        احفظ_ملكية_نهائية_جلسة(الجلسة, الكل);
        طابق الناتج مع
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة); }
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات); };
    };
}

// Loads the given record modules into the state, the program root first.
عرف حمل_وحدات_سجل(
    الحالة: حالة_واجهة_مرحلية,
    السجل: &متجه وحدة_جلسة_تحليل,
    المواضع: &متجه طبيعي,
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: &مفتاح_وحدة_مقنن,
    الإلغاء: &حالة_إلغاء_واجهة
): ناتج_مرحلة_واجهة {
    ليكن الحالة_م: متغير حالة_واجهة_مرحلية = الحالة;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        ليكن المفتاح: &مفتاح_وحدة_مقنن = &(*السجل)[(*المواضع)[ف]].المفتاح;
        إذا (مفتاحا_وحدة_متساويان(المفتاح, الجذر)) {
            طابق حمل_جذرا_في_حالة(الحالة_م, البيئة, المفتاح, صواب, صواب, الإلغاء) مع
            | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة_م := المحملة; }
            | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        ليكن المفتاح: &مفتاح_وحدة_مقنن = &(*السجل)[(*المواضع)[ف]].المفتاح;
        إذا (!مفتاحا_وحدة_متساويان(المفتاح, الجذر)) {
            طابق حمل_جذرا_في_حالة(الحالة_م, البيئة, المفتاح, خطأ, صواب, الإلغاء) مع
            | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة_م := المحملة; }
            | ناتج_مرحلة_واجهة.مرفوضة(التشخيصات) -> { أرجع ناتج_مرحلة_واجهة.مرفوضة(التشخيصات); }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_مرحلة_واجهة.ملغاة(); };
        };
        ف := ف + 1;
    }
    أرجع ناتج_مرحلة_واجهة.مكتملة(الحالة_م);
}

// Registers the primitives once, before a fresh state's first stage.
عرف ضمن_بدائيات_حالة(
    الحالة: &متغير حالة_واجهة_مرحلية,
    مسجلة: &متغير منطقي
): منطقي {
    إذا (*مسجلة) { أرجع صواب; };
    ليكن المالك: متغير معرف_وحدة = معرف_وحدة_من(0);
    طابق (*الحالة).الجذر مع
    | اختياري.موجود(المعرف) -> { المالك := المعرف; }
    | اختياري.لا_شيء -> {
        إذا ((الطول((*الحالة).الوحدات) مثل طبيعي) > 0) { المالك := (*الحالة).الوحدات[0].الوحدة; };
    };
    طابق سجل_بدائيات_في_حالة(الحالة, المالك) مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    *مسجلة := صواب;
    أرجع صواب;
}

عرف حلل_مرحليا_في_جلسة(
    الجلسة: &متغير جلسة_تحليل_تزايدي,
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: &مفتاح_وحدة_مقنن,
    المفاتيح_الإضافية: &متجه مفتاح_وحدة_مقنن,
    الهدف: اختياري واصف_هدف,
    جذور_المساحة: &متجه طبيعي,
    الحالية: &متجه حالة_نص_جلسة,
    المتغيرة: &متجه منطقي,
    الإلغاء: &حالة_إلغاء_واجهة
): ناتج_طلب_مرحلي {
    ليكن العدد: طبيعي = الطول((*الجلسة).السجل) مثل طبيعي;
    // A copy of the kept final state made ahead is of no use here.
    إذا ((*الجلسة).الجاهزة_من == 3) { أسقط_الجاهزة(الجلسة); };
    // The modules to analyse again: changed, failed imports, workspace modules
    // changed by the request before or open in the editor, and every module
    // that imports one of them.
    ليكن المتأثرة: متغير متجه منطقي = [];
    ليكن البذور: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    ليكن المتغيرة_الآن: متغير متجه مفتاح_وحدة_مقنن = [];
    طالما (ف < العدد) {
        ليكن متأثرة: منطقي = (*المتغيرة)[ف] || (*الجلسة).السجل[ف].متسخة
            || (!(*الجلسة).السجل[ف].أساسية
                && (مفتاح_في_قائمة(&(*الجلسة).الساخنة, &(*الجلسة).السجل[ف].المفتاح)
                    || مفتاح_في_قائمة(&(*الجلسة).المفتوحة, &(*الجلسة).السجل[ف].المفتاح)));
        ألحق(المتأثرة, متأثرة);
        ألحق(البذور, متأثرة);
        إذا ((*المتغيرة)[ف]) { ألحق(المتغيرة_الآن, انسخ_مفتاح_وحدة_مقنن(&(*الجلسة).السجل[ف].المفتاح)); };
        ف := ف + 1;
    }
    ليكن تابع: متغير منطقي = صواب;
    طالما (تابع) {
        تابع := خطأ;
        ف := 0;
        طالما (ف < العدد) {
            إذا (!المتأثرة[ف]) {
                ليكن ي: متغير طبيعي = 0;
                طالما (ي < (الطول((*الجلسة).السجل[ف].الاستيرادات) مثل طبيعي)) {
                    ليكن المستورد: طبيعي = (*الجلسة).السجل[ف].الاستيرادات[ي];
                    إذا (المستورد < العدد && المتأثرة[المستورد] && !المتأثرة[ف]) {
                        المتأثرة[ف] := صواب;
                        تابع := صواب;
                    };
                    ي := ي + 1;
                }
            };
            ف := ف + 1;
        }
    }
    // The largest kept state none of whose modules changed.
    طابق (*الجلسة).المساحة مع
    | اختياري.موجود(اللقطة) -> {
        إذا (!لقطة_صالحة(&اللقطة, &(*الجلسة).السجل, الحالية, &البذور, البيئة, &الهدف)) {
            (*الجلسة).المساحة := اختياري.لا_شيء();
            إذا ((*الجلسة).الجاهزة_من == 2) { أسقط_الجاهزة(الجلسة); };
        };
    }
    | اختياري.لا_شيء -> { };
    طابق (*الجلسة).الأساس مع
    | اختياري.موجود(اللقطة) -> {
        إذا (!لقطة_صالحة(&اللقطة, &(*الجلسة).السجل, الحالية, &البذور, البيئة, &الهدف)) {
            (*الجلسة).الأساس := اختياري.لا_شيء();
            إذا ((*الجلسة).الجاهزة_من == 1) { أسقط_الجاهزة(الجلسة); };
        };
    }
    | اختياري.لا_شيء -> { };
    ليكن الحالة: متغير حالة_واجهة_مرحلية = حالة_واجهة_مرحلية_جديدة(استنسخ(&الهدف));
    ليكن المغطاة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(المغطاة, خطأ); ف := ف + 1; }
    ليكن اللقطة_المستعملة: متغير طبيعي = 0;
    ليكن البدائيات_مسجلة: متغير منطقي = خطأ;
    ليكن المعاد: متغير طبيعي = 0;
    طابق (*الجلسة).الأساس مع
    | اختياري.موجود(_) -> { اللقطة_المستعملة := 1; }
    | اختياري.لا_شيء -> { };
    طابق (*الجلسة).المساحة مع
    | اختياري.موجود(_) -> { اللقطة_المستعملة := 2; }
    | اختياري.لا_شيء -> { };
    // The copy made ahead (جهز_جلسة_تحليل) when there is one, else a copy now.
    إذا (اللقطة_المستعملة > 0) {
        طابق خذ_الجاهزة(الجلسة, اللقطة_المستعملة) مع
        | اختياري.موجود(الجاهزة) -> {
            الحالة := الجاهزة;
            (*الجلسة).الإحصاء.جاهزة := صواب;
        }
        | اختياري.لا_شيء -> {
            إذا (اللقطة_المستعملة == 2) {
                طابق (*الجلسة).المساحة مع
                | اختياري.موجود(اللقطة) -> { الحالة := استنسخ(&اللقطة.الحالة); }
                | اختياري.لا_شيء -> { };
            } وإلا {
                طابق (*الجلسة).الأساس مع
                | اختياري.موجود(اللقطة) -> { الحالة := استنسخ(&اللقطة.الحالة); }
                | اختياري.لا_شيء -> { };
            };
        };
    };
    إذا (اللقطة_المستعملة > 0) {
        البدائيات_مسجلة := صواب;
        المعاد := الحالة.المعالجة;
        ف := 0;
        طالما (ف < (الطول(الحالة.الوحدات) مثل طبيعي)) {
            طابق مفتاح_وحدة_في_حالة(&الحالة, الحالة.الوحدات[ف].الوحدة) مع
            | اختياري.موجود(المفتاح) -> {
                طابق موضع_في_السجل(&(*الجلسة).السجل, &المفتاح, هاش_مفتاح_جلسة(0, &المفتاح)) مع
                | اختياري.موجود(الموضع) -> { المغطاة[الموضع] := صواب; }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        // Package export indexes are rebuilt from the current member texts.
        ليكن بلا_فهارس: متجه فهرس_تصديرات_حزمة = [];
        الحالة.المحمل.فهارس_تصديرات_الحزم := بلا_فهارس;
    };
    (*الجلسة).الإحصاء.اللقطة := اللقطة_المستعملة;
    (*الجلسة).الإحصاء.المعاد_استعمالها := المعاد;
    // The kept state the analysis continues: its number and module trees
    // (a later stage that makes a new kept state replaces them).
    ليكن توليد_الحالة: متغير طبيعي = 0;
    ليكن أشجار_الحالة: متغير طبيعي = 0;
    إذا (اللقطة_المستعملة == 2) {
        طابق (*الجلسة).المساحة مع
        | اختياري.موجود(اللقطة) -> { توليد_الحالة := اللقطة.التوليد; أشجار_الحالة := اللقطة.عدد_الأشجار; }
        | اختياري.لا_شيء -> { };
    } وإلا إذا (اللقطة_المستعملة == 1) {
        طابق (*الجلسة).الأساس مع
        | اختياري.موجود(اللقطة) -> { توليد_الحالة := اللقطة.التوليد; أشجار_الحالة := اللقطة.عدد_الأشجار; }
        | اختياري.لا_شيء -> { };
    };

    // Stage 1: std and package modules a kept state lacks (only before the
    // workspace modules).
    إذا (اللقطة_المستعملة < 2) {
        ليكن الأساسية: متغير متجه طبيعي = [];
        ف := 0;
        طالما (ف < العدد) {
            إذا ((*الجلسة).السجل[ف].أساسية && !المتأثرة[ف] && !المغطاة[ف]) { ألحق(الأساسية, ف); };
            ف := ف + 1;
        }
        إذا ((الطول(الأساسية) مثل طبيعي) > 0) {
            طابق حمل_وحدات_سجل(الحالة, &(*الجلسة).السجل, &الأساسية, البيئة, الجذر, الإلغاء) مع
            | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
            | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
            إذا (!ضمن_بدائيات_حالة(&متغير الحالة, &متغير البدائيات_مسجلة)) { أرجع ناتج_طلب_مرحلي.كامل(); };
            طابق حلل_مرحلة_واجهة(الحالة, البيئة, صواب, خطأ, الإلغاء) مع
            | ناتج_مرحلة_واجهة.مكتملة(المحللة) -> { الحالة := المحللة; }
            | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
            | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
            إذا (!الحالة.الأنواع_متوقفة) {
                إذا ((*الجلسة).الجاهزة_من == 1) { أسقط_الجاهزة(الجلسة); };
                (*الجلسة).الأساس := اختياري.موجود(
                    التقط_حالة(&الحالة, &(*الجلسة).السجل, الحالية, البيئة, &الهدف, (*الجلسة).التوليد_التالي)
                );
                توليد_الحالة := (*الجلسة).التوليد_التالي;
                أشجار_الحالة := الطول(الحالة.أشجار_الوحدات) مثل طبيعي;
                (*الجلسة).التوليد_التالي := (*الجلسة).التوليد_التالي + 1;
                (*الجلسة).الإحصاء.بنيت_لقطة_الأساس := صواب;
            };
        };
    };

    // Stage 2: the workspace modules no change reaches.
    ليكن الباقية: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) {
        إذا (!(*الجلسة).السجل[ف].أساسية && !المتأثرة[ف] && !المغطاة[ف]) { ألحق(الباقية, ف); };
        ف := ف + 1;
    }
    إذا ((الطول(الباقية) مثل طبيعي) > 0) {
        طابق حمل_وحدات_سجل(الحالة, &(*الجلسة).السجل, &الباقية, البيئة, الجذر, الإلغاء) مع
        | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
        | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
        | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
        إذا (!ضمن_بدائيات_حالة(&متغير الحالة, &متغير البدائيات_مسجلة)) { أرجع ناتج_طلب_مرحلي.كامل(); };
        طابق حلل_مرحلة_واجهة(الحالة, البيئة, صواب, خطأ, الإلغاء) مع
        | ناتج_مرحلة_واجهة.مكتملة(المحللة) -> { الحالة := المحللة; }
        | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
        | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
        إذا (!الحالة.الأنواع_متوقفة) {
            إذا ((*الجلسة).الجاهزة_من == 2) { أسقط_الجاهزة(الجلسة); };
            (*الجلسة).المساحة := اختياري.موجود(
                التقط_حالة(&الحالة, &(*الجلسة).السجل, الحالية, البيئة, &الهدف, (*الجلسة).التوليد_التالي)
            );
            توليد_الحالة := (*الجلسة).التوليد_التالي;
            أشجار_الحالة := الطول(الحالة.أشجار_الوحدات) مثل طبيعي;
            (*الجلسة).التوليد_التالي := (*الجلسة).التوليد_التالي + 1;
            (*الجلسة).الإحصاء.بنيت_لقطة_المساحة := صواب;
        };
    };

    // Stage 3: the roots, which load the changed modules, their importers and
    // anything new.
    ليكن قبل_الأخيرة: طبيعي = الحالة.المعالجة;
    طابق حمل_جذرا_في_حالة(الحالة, البيئة, الجذر, صواب, صواب, الإلغاء) مع
    | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
    | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
    | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
    ف := 0;
    طالما (ف < (الطول(*المفاتيح_الإضافية) مثل طبيعي)) {
        طابق حمل_جذرا_في_حالة(الحالة, البيئة, &(*المفاتيح_الإضافية)[ف], خطأ, صواب, الإلغاء) مع
        | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
        | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
        | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
        ف := ف + 1;
    }
    // std's modules that join without an import, as a full analysis loads them.
    طابق حمل_جذور_المكتبة_الضمنية(
        الحالة, البيئة, هدف_تخدمه_المكتبة_القياسية(&الهدف), صواب, الإلغاء
    ) مع
    | ناتج_مرحلة_واجهة.مكتملة(المحملة) -> { الحالة := المحملة; }
    | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
    | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); };
    // A module a kept state holds that the roots no longer reach would not be
    // in a full analysis. std's implicit modules count as roots.
    ليكن معرفات_الجذور: متغير متجه معرف_وحدة = [];
    ليكن مفاتيح_ضمنية: متجه مفتاح_وحدة_مقنن = مفاتيح_جذور_المكتبة_الضمنية(البيئة);
    ف := 0;
    طالما (ف < (الطول(مفاتيح_ضمنية) مثل طبيعي)) {
        طابق معرف_وحدة_لمفتاح(&الحالة, &مفاتيح_ضمنية[ف]) مع
        | اختياري.موجود(المعرف) -> { ألحق(معرفات_الجذور, المعرف); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق معرف_وحدة_لمفتاح(&الحالة, الجذر) مع
    | اختياري.موجود(المعرف) -> { ألحق(معرفات_الجذور, المعرف); }
    | اختياري.لا_شيء -> { };
    ف := 0;
    طالما (ف < (الطول(*المفاتيح_الإضافية) مثل طبيعي)) {
        طابق معرف_وحدة_لمفتاح(&الحالة, &(*المفاتيح_الإضافية)[ف]) مع
        | اختياري.موجود(المعرف) -> { ألحق(معرفات_الجذور, المعرف); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    إذا (!كل_الوحدات_مستوردة(&الحالة, &معرفات_الجذور)) { أرجع ناتج_طلب_مرحلي.كامل(); };
    إذا (!ضمن_بدائيات_حالة(&متغير الحالة, &متغير البدائيات_مسجلة)) { أرجع ناتج_طلب_مرحلي.كامل(); };
    إذا ((الطول(الحالة.الوحدات) مثل طبيعي) > الحالة.المعالجة || الحالة.المعالجة == 0) {
        طابق حلل_مرحلة_واجهة(الحالة, البيئة, صواب, صواب, الإلغاء) مع
        | ناتج_مرحلة_واجهة.مكتملة(المحللة) -> { الحالة := المحللة; }
        | ناتج_مرحلة_واجهة.ملغاة -> { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); }
        | ناتج_مرحلة_واجهة.مرفوضة(_) -> { أرجع ناتج_طلب_مرحلي.كامل(); };
    } وإلا {
        طابق الحالة.شجرة_الجذر مع
        | اختياري.لا_شيء -> { أرجع ناتج_طلب_مرحلي.كامل(); }
        | اختياري.موجود(_) -> { };
    };
    إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة()); };
    (*الجلسة).الإحصاء.المحللة := (الطول(الحالة.الوحدات) مثل طبيعي) - المعاد;
    // The final state, kept for an edit of one module's bodies (early cutoff).
    ليكن احفظ_الكل: منطقي = احفظ_نهائية_جلسة(
        الجلسة, &الحالة, الحالية, البيئة, &الهدف, الطول(المتغيرة_الآن) مثل طبيعي, قبل_الأخيرة
    );
    // The record of this request, and the modules it changed.
    ليكن السجل_الجديد: متجه وحدة_جلسة_تحليل = سجل_من_حالة(
        &الحالة, &(*الجلسة).السجل, الحالية, البيئة, &الهدف, جذور_المساحة
    );
    (*الجلسة).السجل := السجل_الجديد;
    إذا ((الطول(المتغيرة_الآن) مثل طبيعي) > 0) { (*الجلسة).الساخنة := المتغيرة_الآن; };
    ليكن قبل_الأخيرة_مستعمل: طبيعي = قبل_الأخيرة;
    // The ownership of the kept state's modules once per kept state, then
    // this request's modules (semantic_pipeline.sn, حلل_ملكية_مرحلية_واجهة).
    ليكن المخبأة_السابقة: متغير اختياري ملكية_مخبأة_واجهة = اختياري.لا_شيء();
    بدّل(المخبأة_السابقة, (*الجلسة).الملكية_المخبأة);
    ليكن الملكية: متغير ملكية_مرحلية_واجهة = {
        العدد: أشجار_الحالة, التوليد: توليد_الحالة, المخبأة: المخبأة_السابقة,
        احفظ_الكل: احفظ_الكل, الكل: اختياري.لا_شيء(), من_الكل: خطأ, المستثناة: اختياري.لا_شيء()
    };
    ليكن الناتج_الأخير: نتيجة_بناء_واجهة_وحدة = أنه_واجهة_مرحلية_بملكية(الحالة, البيئة, صواب, &متغير الملكية);
    بدّل((*الجلسة).الملكية_المخبأة, الملكية.المخبأة);
    ليكن الكل: متغير اختياري ملكية_مخبأة_واجهة = اختياري.لا_شيء();
    بدّل(الكل, الملكية.الكل);
    احفظ_ملكية_نهائية_جلسة(الجلسة, الكل);
    طابق الناتج_الأخير مع
    | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
        أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة));
    }
    | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
        أرجع ناتج_طلب_مرحلي.مكتمل(نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات));
    };
}

// ---- Comparing results -------------------------------------------------------
// A description of a result's facts that does not depend on its IDs or on the
// order sources were loaded in: one line per diagnostic, per source's
// completeness, and per source a digest of every resolved occurrence (its
// span, the declaration it resolves to and that Symbol's Type). Two results of
// the same sources describe alike exactly when these facts are equal. The
// lines are sorted.

عرف موضع_نصي_للوصف(الإحداثي: &اختياري إحداثي_مصدر): نص {
    طابق *الإحداثي مع
    | اختياري.موجود(القيمة) -> {
        ليكن الأجزاء: متجه نص = [طبيعي_إلى_نص(القيمة.السطر مثل طبيعي), «:», طبيعي_إلى_نص(القيمة.العمود مثل طبيعي)];
        ليكن الفاصل: نص = «»;
        أرجع صل_النصوص(&الأجزاء, &الفاصل);
    }
    | اختياري.لا_شيء -> { أرجع «-»; };
}

عرف اسم_مصدر_للوصف(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي): نص {
    طابق اسم_مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختياري.موجود(الاسم) -> { أرجع الاسم; }
    | اختياري.لا_شيء -> { أرجع «?»; };
}

عرف وصف_رمز_للمقارنة(الواجهة: &نتيجة_واجهة_وحدة, الرمز: معرف_رمز): نص {
    ليكن الأجزاء: متغير متجه نص = [];
    طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.موجود(الدلالي) -> {
        إذا (الدلالي.نطاق_الاسم.البداية.البايت == الدلالي.نطاق_الاسم.النهاية.البايت) {
            // A primitive or a synthetic Symbol has no place in a source.
            ألحق(الأجزاء, «builtin#»);
            طابق اسم_مقنن_واجهة(الواجهة, الدلالي.الاسم) مع
            | اختياري.موجود(المقنن) -> { ألحق(الأجزاء, من_بايتات(&المقنن.البايتات)); }
            | اختياري.لا_شيء -> { ألحق(الأجزاء, «?»); };
        } وإلا {
            ألحق(الأجزاء, اسم_مصدر_للوصف(الواجهة, الدلالي.نطاق_الاسم.البداية.المصدر مثل طبيعي));
            ألحق(الأجزاء, «@»);
            ألحق(الأجزاء, طبيعي_إلى_نص(الدلالي.نطاق_الاسم.البداية.البايت مثل طبيعي));
        };
    }
    | اختياري.لا_شيء -> { ألحق(الأجزاء, «?»); };
    ألحق(الأجزاء, «:»);
    طابق نوع_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.موجود(النوع) -> {
        طابق تهجئة_نوع_واجهة(الواجهة, النوع) مع
        | اختياري.موجود(التهجئة) -> { ألحق(الأجزاء, التهجئة); }
        | اختياري.لا_شيء -> { ألحق(الأجزاء, «~»); };
    }
    | اختياري.لا_شيء -> { ألحق(الأجزاء, «-»); };
    ليكن الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عام عرف صف_واجهة_للمقارنة(الواجهة: &نتيجة_واجهة_وحدة): متجه نص {
    ليكن الأسطر: متغير متجه نص = [];
    ليكن الفاصل: نص = «»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).تشخيصات_الأدوات.التشخيصات) مثل طبيعي)) {
        ليكن التشخيص: &تشخيص = &(*الواجهة).تشخيصات_الأدوات.التشخيصات[ف];
        ليكن الأجزاء: متغير متجه نص = [«D », سطر_عنوان_تشخيص_طرفي(التشخيص, لغة_تشخيص.الإنجليزية())];
        ليكن الرئيسي: اختياري نطاق_مصدر_تشخيص = استنسخ(&(*التشخيص).المصدر_الرئيسي);
        طابق الرئيسي مع
        | اختياري.موجود(المصدر) -> {
            ألحق(الأجزاء, « @ »);
            ليكن اسم_الرئيسي: اختياري نص = استنسخ(&المصدر.اسم_المصدر);
            طابق اسم_الرئيسي مع
            | اختياري.موجود(الاسم) -> { ألحق(الأجزاء, الاسم); }
            | اختياري.لا_شيء -> { ألحق(الأجزاء, «?»); };
            ألحق(الأجزاء, « »);
            ألحق(الأجزاء, موضع_نصي_للوصف(&المصدر.بداية_العرض));
            ألحق(الأجزاء, «-»);
            ألحق(الأجزاء, موضع_نصي_للوصف(&المصدر.نهاية_العرض));
        }
        | اختياري.لا_شيء -> { };
        ألحق(الأسطر, صل_النصوص(&الأجزاء, &الفاصل));
        ف := ف + 1;
    }
    ليكن العلامات: متجه نص = [
        «F types-stopped=», (إذا_نص((*الواجهة).حقائق_الأدوات.الأنواع_متوقفة)),
        « complete=», (إذا_نص((*الواجهة).كاملة_دلاليا))
    ];
    ألحق(الأسطر, صل_النصوص(&العلامات, &الفاصل));
    ف := 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        ليكن المصدر: طبيعي = (*الواجهة).الوحدات[ف].معرف_المصدر;
        ليكن الاسم: نص = اسم_مصدر_للوصف(الواجهة, المصدر);
        ليكن الاكتمال: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(الواجهة, المصدر);
        ليكن سطر_الاكتمال: متجه نص = [
            «C », انسخ_نص(&الاسم), « load=», إذا_نص(الاكتمال.التحميل),
            « names=», إذا_نص(الاكتمال.الأسماء), « types=», إذا_نص(الاكتمال.الأنواع)
        ];
        ألحق(الأسطر, صل_النصوص(&سطر_الاكتمال, &الفاصل));
        ليكن الملخص: متغير طبيعي = بداية_هاش_جلسة();
        ليكن عدد_الظهورات: متغير طبيعي = 0;
        إذا (ف < (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
            ليكن الظهورات: &متجه ظهور_اسم_محلول = &(*الواجهة).روابط_الأسماء[ف].الظهورات;
            ليكن ي: متغير طبيعي = 0;
            طالما (ي < (الطول(*الظهورات) مثل طبيعي)) {
                طابق (*الظهورات)[ي].الرمز مع
                | اختياري.موجود(الرمز) -> {
                    ليكن الوصف: نص = وصف_رمز_للمقارنة(الواجهة, الرمز);
                    الملخص := امزج_هاش_جلسة(الملخص, (*الظهورات)[ي].النطاق.البداية.البايت مثل طبيعي);
                    الملخص := امزج_هاش_جلسة(الملخص, (*الظهورات)[ي].النطاق.النهاية.البايت مثل طبيعي);
                    الملخص := امزج_هاش_جلسة(الملخص, هاش_نص_جلسة(&الوصف));
                    عدد_الظهورات := عدد_الظهورات + 1;
                }
                | اختياري.لا_شيء -> { };
                ي := ي + 1;
            }
        };
        ليكن سطر_الملخص: متجه نص = [
            «S », الاسم, « occurrences=», طبيعي_إلى_نص(عدد_الظهورات), « digest=», طبيعي_إلى_نص(الملخص)
        ];
        ألحق(الأسطر, صل_النصوص(&سطر_الملخص, &الفاصل));
        ف := ف + 1;
    }
    رتب_نصوص(&متغير الأسطر);
    أرجع الأسطر;
}

عرف إذا_نص(القيمة: منطقي): نص {
    إذا (القيمة) { أرجع «1»; };
    أرجع «0»;
}

// Every resolved occurrence of one source, one line each (its span, the
// declaration and the Symbol's Type): to show where two descriptions differ.
عام عرف صف_ظهورات_مصدر_للمقارنة(الواجهة: &نتيجة_واجهة_وحدة, الاسم: &نص): متجه نص {
    ليكن الأسطر: متغير متجه نص = [];
    ليكن الفاصل: نص = «»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي) && ف < (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
        ليكن المصدر: طبيعي = (*الواجهة).الوحدات[ف].معرف_المصدر;
        ليكن اسم_المصدر: نص = اسم_مصدر_للوصف(الواجهة, المصدر);
        إذا (نصان_متساويان(&اسم_المصدر, الاسم)) {
            ليكن الظهورات: &متجه ظهور_اسم_محلول = &(*الواجهة).روابط_الأسماء[ف].الظهورات;
            ليكن ي: متغير طبيعي = 0;
            طالما (ي < (الطول(*الظهورات) مثل طبيعي)) {
                طابق (*الظهورات)[ي].الرمز مع
                | اختياري.موجود(الرمز) -> {
                    ليكن الأجزاء: متجه نص = [
                        طبيعي_إلى_نص((*الظهورات)[ي].النطاق.البداية.البايت مثل طبيعي), «-»,
                        طبيعي_إلى_نص((*الظهورات)[ي].النطاق.النهاية.البايت مثل طبيعي), « »,
                        وصف_رمز_للمقارنة(الواجهة, الرمز)
                    ];
                    ألحق(الأسطر, صل_النصوص(&الأجزاء, &الفاصل));
                }
                | اختياري.لا_شيء -> { };
                ي := ي + 1;
            }
        };
        ف := ف + 1;
    }
    أرجع الأسطر;
}
