استورد compiler.frontend.ssf.local_state;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.memory.memory_model;
استورد compiler.frontend.memory.semantic_pipeline;
استورد compiler.frontend.pattern.pattern_model;

استورد compiler.frontend.types.type_context;
عرف يحتوي_أصلا(
    الأصول: &متجه أصل_استعارة,
    الأصل: أصل_استعارة
): منطقي {
    دع القيم: متجه أصل_استعارة = *الأصول;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        لو (أصلان_متساويان(القيم[ف], الأصل)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف انسخ_حالة_محلي_لشرعية_الاستعارة(المحلي: &حالة_محلي): حالة_محلي {
    أرجع انسخ_مملوكا_حالة_محلي(المحلي);
}

// A borrowed local propagates its existing roots; otherwise the owner local becomes the root.
عام عرف أصول_استعارة_محلي(
    الحالة: &حالة_تدفق_سلامة,
    المحلي: عرض_محلي_مقروء,
    النوع: نوع_استعارة
): متجه أصل_استعارة {
    دع الأصول: متغير متجه أصل_استعارة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < المحلي.الأصول.العدد) {
        ألحق(الأصول, أصل_محلي_مقروء_عند(الحالة, المحلي, ف));
        ف := ف + 1;
    }
    لو ((الطول(الأصول) مثل طبيعي) == 0) {
        ألحق(الأصول, أصل_استعارة.محلي(المحلي.الرمز, النوع));
    };
    أرجع الأصول;
}

عام عرف ابدأ_استعارة_مشتركة(
    الحالة: &متغير حالة_تدفق_سلامة,
    المالك: معرف_رمز,
    الحامل: اختياري معرف_رمز
): نتيجة استعارة_نشطة, خطأ_تدفق_سلامة {
    طابق تحقق_استخدام_محلي(الحالة, المالك) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(_) -> { };

    طابق محلي_عند(الحالة, المالك) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(المالك));
    }
    | اختياري.موجود(المحلي) -> {
        طابق المحلي.الاستعارات مع
        | حالة_استعارات_محلي_مقروء.حصرية -> {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(المالك, نوع_استعارة.مشتركة())
            );
        }
        | _ -> { };

        دع رقم_الاستعارة: طبيعي = (*الحالة).معرف_الاستعارة_التالي;
        (*الحالة).معرف_الاستعارة_التالي := (*الحالة).معرف_الاستعارة_التالي + 1;
        دع نوع_الأصل: نوع_استعارة = نوع_استعارة.مشتركة();
        دع أصول_الحالة: متجه أصل_استعارة = أصول_استعارة_محلي(الحالة, المحلي, نوع_الأصل);
        دع أصول_النتيجة: متجه أصل_استعارة = أصول_استعارة_محلي(الحالة, المحلي, نوع_الأصل);
        دع معرف_الحالة: معرف_استعارة = معرف_استعارة_من(المالك, رقم_الاستعارة);
        دع معرف_النتيجة: معرف_استعارة = معرف_استعارة_من(المالك, رقم_الاستعارة);
        دع نوع_الحالة: نوع_استعارة = نوع_استعارة.مشتركة();
        دع نوع_النتيجة: نوع_استعارة = نوع_استعارة.مشتركة();
        دع الجديدة_للحالة: استعارة_نشطة = {
            المعرف: معرف_الحالة,
            المالك: المالك,
            الحامل: الحامل,
            النوع: نوع_الحالة,
            الأصول: أصول_الحالة
        };
        دع الجديدة_للنتيجة: استعارة_نشطة = {
            المعرف: معرف_النتيجة,
            المالك: المالك,
            الحامل: الحامل,
            النوع: نوع_النتيجة,
            الأصول: أصول_النتيجة
        };
        طابق موضع_محلي(الحالة, المالك) مع
        | اختياري.موجود(ف) -> {
            دع حالة_المحلي: متغير حالة_محلي =
                انسخ_حالة_محلي_لشرعية_الاستعارة(&(*الحالة).المحليات[ف]);
            طابق المحلي.الاستعارات مع
            | حالة_استعارات_محلي_مقروء.بلا -> {
                دع القائمة: متغير متجه استعارة_نشطة = [];
                ألحق(القائمة, الجديدة_للحالة);
                حالة_المحلي.الاستعارات := حالة_استعارات_محلي.مشتركة(القائمة);
            }
            | حالة_استعارات_محلي_مقروء.مشتركة -> {
                طابق انسخ_استعارات_مشتركة_لتدفق(&حالة_المحلي.الاستعارات) مع
                | اختياري.موجود(الحالية) -> {
                    دع القائمة: متغير متجه استعارة_نشطة = الحالية;
                    ألحق(القائمة, الجديدة_للحالة);
                    حالة_المحلي.الاستعارات := حالة_استعارات_محلي.مشتركة(القائمة);
                }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ(
                        خطأ_تدفق_سلامة.تعارض_استعارة(المالك, نوع_استعارة.مشتركة())
                    );
                };
            }
            | حالة_استعارات_محلي_مقروء.حصرية -> {
                أرجع نتيجة.خطأ(
                    خطأ_تدفق_سلامة.تعارض_استعارة(المالك, نوع_استعارة.مشتركة())
                );
            };
            (*الحالة).المحليات[ف] := حالة_المحلي;
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(المالك));
        };

        أرجع نتيجة.نجح(الجديدة_للنتيجة);
    };
}

عام عرف ابدأ_استعارة_حصرية(
    الحالة: &متغير حالة_تدفق_سلامة,
    المالك: معرف_رمز,
    الحامل: اختياري معرف_رمز
): نتيجة استعارة_نشطة, خطأ_تدفق_سلامة {
    طابق تحقق_استخدام_محلي(الحالة, المالك) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(_) -> { };

    طابق محلي_عند(الحالة, المالك) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(المالك));
    }
    | اختياري.موجود(المحلي) -> {
        طابق المحلي.الاستعارات مع
        | حالة_استعارات_محلي_مقروء.بلا -> { }
        | _ -> {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(المالك, نوع_استعارة.حصرية())
            );
        };
        دع رقم_الاستعارة: طبيعي = (*الحالة).معرف_الاستعارة_التالي;
        (*الحالة).معرف_الاستعارة_التالي := (*الحالة).معرف_الاستعارة_التالي + 1;
        دع نوع_الأصل: نوع_استعارة = نوع_استعارة.حصرية();
        دع أصول_الحالة: متجه أصل_استعارة = أصول_استعارة_محلي(الحالة, المحلي, نوع_الأصل);
        دع أصول_النتيجة: متجه أصل_استعارة = أصول_استعارة_محلي(الحالة, المحلي, نوع_الأصل);
        دع معرف_الحالة: معرف_استعارة = معرف_استعارة_من(المالك, رقم_الاستعارة);
        دع معرف_النتيجة: معرف_استعارة = معرف_استعارة_من(المالك, رقم_الاستعارة);
        دع نوع_الحالة: نوع_استعارة = نوع_استعارة.حصرية();
        دع نوع_النتيجة: نوع_استعارة = نوع_استعارة.حصرية();
        دع الجديدة_للحالة: استعارة_نشطة = {
            المعرف: معرف_الحالة,
            المالك: المالك,
            الحامل: الحامل,
            النوع: نوع_الحالة,
            الأصول: أصول_الحالة
        };
        دع الجديدة_للنتيجة: استعارة_نشطة = {
            المعرف: معرف_النتيجة,
            المالك: المالك,
            الحامل: الحامل,
            النوع: نوع_النتيجة,
            الأصول: أصول_النتيجة
        };
        طابق موضع_محلي(الحالة, المالك) مع
        | اختياري.موجود(ف) -> {
            دع حالة_المحلي: متغير حالة_محلي =
                انسخ_حالة_محلي_لشرعية_الاستعارة(&(*الحالة).المحليات[ف]);
            حالة_المحلي.الاستعارات := حالة_استعارات_محلي.حصرية(الجديدة_للحالة);
            (*الحالة).المحليات[ف] := حالة_المحلي;
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(المالك));
        };

        أرجع نتيجة.نجح(الجديدة_للنتيجة);
    };
}

عرف بدون_استعارة(
    الاستعارات: &متجه استعارة_نشطة,
    المعرف: معرف_استعارة
): متجه استعارة_نشطة {
    دع القيم: متجه استعارة_نشطة = *الاستعارات;
    دع الناتج: متغير متجه استعارة_نشطة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        دع مرجع_القيمة: &استعارة_نشطة = &القيم[ف];
        دع قيمة_الفحص: استعارة_نشطة = *مرجع_القيمة;
        لو ((!معرفا_رمز_متساويان(قيمة_الفحص.المعرف.المالك, المعرف.المالك))
            || (قيمة_الفحص.المعرف.القيمة != المعرف.القيمة)) {
            دع القيمة_للناتج: استعارة_نشطة = انسخ_مملوكا_استعارة_نشطة(مرجع_القيمة);
            ألحق(الناتج, القيمة_للناتج);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف حالة_استعارات_بعد_الإنهاء(
    الاستعارات: &حالة_استعارات_محلي,
    المعرف: معرف_استعارة
): اختياري حالة_استعارات_محلي {
    طابق *الاستعارات مع
    | حالة_استعارات_محلي.بلا -> {
        أرجع اختياري.لا_شيء();
    }
    | حالة_استعارات_محلي.مشتركة(القائمة) -> {
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(القائمة) مثل طبيعي)) {
            لو (معرفا_رمز_متساويان(القائمة[ج].المعرف.المالك, المعرف.المالك)
                && القائمة[ج].المعرف.القيمة == المعرف.القيمة) {
                دع الباقية: متجه استعارة_نشطة = بدون_استعارة(&القائمة, المعرف);
                لو ((الطول(الباقية) مثل طبيعي) == 0) {
                    أرجع اختياري.موجود(حالة_استعارات_محلي.بلا());
                };
                أرجع اختياري.موجود(حالة_استعارات_محلي.مشتركة(الباقية));
            };
            ج := ج + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | حالة_استعارات_محلي.حصرية(الحالية) -> {
        لو (معرفا_رمز_متساويان(الحالية.المعرف.المالك, المعرف.المالك)
            && الحالية.المعرف.القيمة == المعرف.القيمة) {
            أرجع اختياري.موجود(حالة_استعارات_محلي.بلا());
        };
        أرجع اختياري.لا_شيء();
    };
}

عام عرف انه_استعارة(
    الحالة: &متغير حالة_تدفق_سلامة,
    المعرف: معرف_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        دع المحلي: متغير حالة_محلي =
            انسخ_حالة_محلي_لشرعية_الاستعارة(&(*الحالة).المحليات[ف]);
        دع الاستعارات_الجديدة: اختياري حالة_استعارات_محلي =
            حالة_استعارات_بعد_الإنهاء(&المحلي.الاستعارات, المعرف);
        طابق الاستعارات_الجديدة مع
        | اختياري.موجود(الجديدة) -> {
            المحلي.الاستعارات := الجديدة;
            (*الحالة).المحليات[ف] := المحلي;

            أرجع نتيجة.نجح(صواب);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.معرف_استعارة_غير_صالح(المعرف));
}

عام عرف تحقق_هروب_محلي(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق تحقق_استخدام_محلي(الحالة, الرمز) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(صالح) -> {
    };
    أرجع تحقق_هروب_أصول_محلي(سياق_الذاكرة, الحالة, الرمز, 16);
}

// Whether the value of the local الرمز may leave the function: none of its
// origins is a local of this function. A value read through a reference local
// lives as long as that reference's own origins (العمق bounds the chain).
عام عرف تحقق_هروب_أصول_محلي(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    العمق: طبيعي
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق محلي_عند(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختياري.موجود(المحلي) -> {
        طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, المحلي.النوع) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ));
        }
        | نتيجة.نجح(الحقائق) -> {
            لو (الحقائق.يحتوي_مستعارا && المحلي.الأصول.العدد == 0) {
                أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز));
            };
        };
        دع ف: متغير طبيعي = 0;
        طالما (ف < المحلي.الأصول.العدد) {
            طابق أصل_محلي_مقروء_عند(الحالة, المحلي, ف) مع
            | أصل_استعارة.محلي(المالك, _) -> {
                أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز));
            }
            | أصل_استعارة.معامل(المعامل) -> {
            }
            | أصل_استعارة.خارجي -> {
            }
            | أصل_استعارة.عبر_مرجع(المرجع) -> {
                لو (!معرفا_رمز_متساويان(المرجع, الرمز)) {
                    لو (العمق == 0) { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز)); };
                    طابق تحقق_هروب_أصول_محلي(سياق_الذاكرة, الحالة, المرجع, العمق - 1) مع
                    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز)); }
                    | نتيجة.نجح(_) -> { };
                };
            };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(صواب);
    };
}
