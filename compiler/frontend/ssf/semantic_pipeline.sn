            | نتيجة.نجح(_) -> { };
            دع الدخول: حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            دع بعد: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            طابق ابن_كتلة_تدفق_سلامة(
                &الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                سجل_الأنماط, التحققات, &متغير بعد
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(سقوط_الجسم) -> {
                طابق سقوط_الجسم مع
                | سقوط_كتلة_تدفق_سلامة.مستمرة -> {
                    دع قائمة_الخطوة: متجه صندوق عبارة = [الخطوة];
                    دع كتلة_الخطوة: كتلة_عبارات = { النطاق: النطاق, العبارات: قائمة_الخطوة };
                    طابق ابن_كتلة_تدفق_سلامة(
                        &كتلة_الخطوة, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                        سجل_الأنماط, التحققات, &متغير بعد
                    ) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(_) -> { };
                    طابق ادمج_تدفق_حلقة(&الدخول, &بعد) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(مدموج) -> { *الحالة := مدموج; };
                }
                | سقوط_كتلة_تدفق_سلامة.منتهية -> { *الحالة := الدخول; };
            };
        }
        | عبارة.اخرج_من_حلقة(_) -> { تسقط := خطأ; }
        | عبارة.تابع_حلقة(_) -> { تسقط := خطأ; }
        | عبارة.بينما(_, الشرط, الجسم) -> {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الشرط
            ) مع
            | اختيار.بعض(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | _ -> { };
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الشرط
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            دع الدخول: حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            دع بعد: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            دع الجسم_يسقط: متغير منطقي = صواب;
            طابق ابن_كتلة_تدفق_سلامة(
                &الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                سجل_الأنماط, التحققات, &متغير بعد
            ) مع
            | نتيجة.خطأ(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | نتيجة.نجح(سقوط_الجسم) -> {
                طابق سقوط_الجسم مع
                | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                | سقوط_كتلة_تدفق_سلامة.منتهية -> {
                    الجسم_يسقط := خطأ;
                };
            };
            لو (الجسم_يسقط) {
                طابق ادمج_تدفق_حلقة(&الدخول, &بعد) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(مدموج) -> {
                    *الحالة := مدموج;
                };
            } وإلا {
                // The loop may execute zero times; a non-fallthrough body contributes
                // no exit edge, so the only outgoing state is the entry state.
                *الحالة := الدخول;
            };
        }
        | عبارة.لو(_, الشرط, عند_الصواب, عند_الخطأ) -> {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الشرط
            ) مع
            | اختيار.بعض(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | _ -> { };
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الشرط
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            دع أ: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            دع ب: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            دع أ_تسقط: متغير منطقي = صواب;
            دع ب_تسقط: متغير منطقي = صواب;
            طابق ابن_كتلة_تدفق_سلامة(
                &عند_الصواب, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                سجل_الأنماط, التحققات, &متغير أ
            ) مع
            | نتيجة.خطأ(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | نتيجة.نجح(سقوط_أ) -> {
                طابق سقوط_أ مع
                | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                | سقوط_كتلة_تدفق_سلامة.منتهية -> { أ_تسقط := خطأ; };
            };
            طابق عند_الخطأ مع
            | اختيار.بعض(ج) -> {
                طابق ابن_كتلة_تدفق_سلامة(
                    &ج, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                    سجل_الأنماط, التحققات, &متغير ب
                ) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(سقوط_ب) -> {
                    طابق سقوط_ب مع
                    | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                    | سقوط_كتلة_تدفق_سلامة.منتهية -> { ب_تسقط := خطأ; };
                };
            }
            | _ -> { };

            لو (أ_تسقط && ب_تسقط) {
                طابق ادمج_تدفقين(&أ, &ب) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(مدموج) -> {
                    *الحالة := مدموج;
                };
            } وإلا لو (أ_تسقط) {
                *الحالة := أ;
            } وإلا لو (ب_تسقط) {
                *الحالة := ب;
            } وإلا {
                // Neither arm reaches the join; the enclosing block cannot fall through.
                تسقط := خطأ;
            };
        }
        | عبارة.طابق(_, المميز, الأذرع) -> {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &المميز
            ) مع
            | اختيار.بعض(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | _ -> { };
            دع أصول_المميز: متغير متجه أصل_استعارة = [];
            طابق أصول_قيمة_تعبير_لتدفق(
                الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &المميز
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(القيم) -> { أصول_المميز := القيم; };
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &المميز
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            دع الأصل: حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            دع مدموج: متغير اختيار حالة_تدفق_سلامة = اختيار.لا_شيء();
            دع ذ: متغير غير_موقع = 0;
            بينما (ذ < (الطول(الأذرع) مثل غير_موقع)) {
                دع فرع: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(&الأصل);
                دع الفرع_يسقط: متغير منطقي = صواب;
                طابق معرف_نمط_ذراع_مطابقة_عند(سجل_الأنماط, &الأذرع[ذ]) مع
                | اختيار.بعض(الجذر) -> {
                    طابق فهرس_تحقق_ربط_نمط_وحدة_عند(&حقائق_التحققات, الجذر) مع
                    | اختيار.بعض(فهرس_التحقق) -> {
                        دع مرجع_ربط_التحقق: &ربط_تحقق_نمط_وحدة = &حقائق_التحققات[فهرس_التحقق];
                        دع ربط_التحقق: ربط_تحقق_نمط_وحدة = *مرجع_ربط_التحقق;
                        دع مرجع_تحقق_الفرع: &تحقق_نمط_نوعي = &ربط_التحقق.التحقق;
                        دع الرموز: متجه رمز_ربط_نمط_محلول = ابن_رموز_ربط_تحقق(
                            مرجع_تحقق_الفرع, سجل_الأنماط, الروابط
                        );
                        دع الأصول: متغير متجه أصول_ربط_نمط = [];
                        دع تحقق_الفرع: تحقق_نمط_نوعي = *مرجع_تحقق_الفرع;
                        دع ب: متغير غير_موقع = 0;
                        بينما (ب < (الطول(تحقق_الفرع.الروابط) مثل غير_موقع)) {
                            دع أصول_الربط: متجه أصل_استعارة = انسخ_أصول_لتدفق(&أصول_المميز);
                            دع أصل_ربط: أصول_ربط_نمط = {
                                النمط: تحقق_الفرع.الروابط[ب].النمط,
                                الأصول: أصول_الربط
                            };
                            ألحق(الأصول, أصل_ربط);
                            ب := ب + 1;
                        }
                        طابق طبق_روابط_نمط(سياق_الذاكرة, &متغير فرع,
                            مرجع_تحقق_الفرع, &الرموز,
                            &الأصول
                        ) مع
                        | نتيجة.خطأ(خ) -> {
                            أرجع نتيجة.خطأ(خ);
                        }
                        | _ -> { };
                    }
                    | _ -> { };
                }
                | _ -> { };

                طابق ابن_كتلة_تدفق_سلامة(
                    &الأذرع[ذ].الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع,
                    أنواع_الرموز, أنواع_التعبيرات, سجل_الأنماط, التحققات, &متغير فرع
                ) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(سقوط_الفرع) -> {
                    طابق سقوط_الفرع مع
                    | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                    | سقوط_كتلة_تدفق_سلامة.منتهية -> { الفرع_يسقط := خطأ; };
                };

                // Pattern bindings belong only to this arm. Keep current facts for
                // Symbols that were already visible before entering the match.
                طابق احصر_حالة_تدفق_إلى_المرئي_عند_الدخول(&فرع, &الأصل) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(المرئي) -> {
                    فرع := المرئي;
                };

                لو (الفرع_يسقط) {
                    طابق مدموج مع
                    | اختيار.لا_شيء -> {
                        مدموج := اختيار.بعض(فرع);
                    }
                    | اختيار.بعض(سابق) -> {
                        طابق ادمج_تدفقين(&سابق, &فرع) مع
                        | نتيجة.خطأ(خ) -> {
                            أرجع نتيجة.خطأ(خ);
                        }
                        | نتيجة.نجح(جديد) -> {
                            مدموج := اختيار.بعض(جديد);
                        };
                    };
                };
                ذ := ذ + 1;
            }
            طابق مدموج مع
            | اختيار.بعض(نهاية) -> {
                *الحالة := نهاية;
            }
            | اختيار.لا_شيء -> {
                // Exhaustiveness is owned by Pattern semantics. If no arm falls
                // through, this statement has no outgoing CFG edge.
                تسقط := خطأ;
            };
        }
        | عبارة.أرجع(_, القيمة) -> {
            طابق القيمة مع
            | اختيار.بعض(ت) -> {
                طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                    سياق_الأسماء, الروابط, الحالة, &ت
                ) مع
                | اختيار.بعض(خ) -> { أرجع نتيجة.خطأ(خ); }
                | اختيار.لا_شيء -> { };
                طابق تحقق_هروب_تعبير_لتدفق(
                    الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &ت
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
                طابق طبق_مصدر_قيمة_لتدفق(
                    سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &ت
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
            }
            | اختيار.لا_شيء -> { };
            تسقط := خطأ;
        }
        | عبارة.غير_آمن(_, الجسم) -> {
            طابق ابن_كتلة_تدفق_سلامة(
                &الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                سجل_الأنماط, التحققات, الحالة
            ) مع
            | نتيجة.خطأ(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | نتيجة.نجح(سقوط_الجسم) -> {
                طابق سقوط_الجسم مع
                | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                | سقوط_كتلة_تدفق_سلامة.منتهية -> { تسقط := خطأ; };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }

    // Drop Symbols introduced by this lexical block while preserving the latest
    // flow facts for every Symbol that was visible on entry.
    طابق احصر_حالة_تدفق_إلى_المرئي_عند_الدخول(الحالة, &عند_دخول_الكتلة) مع
    | نتيجة.خطأ(خ) -> {
        أرجع نتيجة.خطأ(خ);
    }
    | نتيجة.نجح(المرئي) -> {
        *الحالة := المرئي;
    };

    لو (تسقط) {
        أرجع نتيجة.نجح(سقوط_كتلة_تدفق_سلامة.مستمرة());
    };
    أرجع نتيجة.نجح(سقوط_كتلة_تدفق_سلامة.منتهية());
}

عام عرف ابن_تدفق_سلامة_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &متجه سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    سجل_الأنماط: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة
): نتيجة_تدفق_سلامة_وحدة {
    دع القيم: متجه وحدة_مصدر = *الوحدات;
    دع روابط_القيم: متجه سياق_روابط_أسماء = *الروابط;
    دع أنواع_التعبيرات_القيم: متجه سياق_أنواع_تعبيرات = *أنواع_التعبيرات;
    دع و: متغير غير_موقع = 0;
    بينما (و < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &القيم[و];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &روابط_القيم[و];
        دع أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات = &أنواع_التعبيرات_القيم[و];
        دع الأصل: وحدة_مصدر = *مرجع_الوحدة;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأصل.العناصر) مثل غير_موقع)) {
            طابق الأصل.العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                طابق رمز_اسم_محلول_عند(روابط_الوحدة, الدالة.الاسم.النطاق) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_تدفق_سلامة_وحدة.حقيقة_دلالية_مفقودة(الدالة.الاسم.النطاق);
                }
                | اختيار.بعض(رمز_الدالة) -> {
                    دع الحالة: متغير حالة_تدفق_سلامة = حالة_تدفق_سلامة_جديدة();
                    دع م: متغير غير_موقع = 0;
                    بينما (م < (الطول(الدالة.المعاملات) مثل غير_موقع)) {
                        طابق رمز_اسم_محلول_عند(روابط_الوحدة, الدالة.المعاملات[م].الاسم.النطاق) مع
                        | اختيار.لا_شيء -> {
                            أرجع نتيجة_تدفق_سلامة_وحدة.حقيقة_دلالية_مفقودة(
                                الدالة.المعاملات[م].الاسم.النطاق
                            );
                        }
                        | اختيار.بعض(الرمز) -> {
                            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                            | اختيار.لا_شيء -> {
                                أرجع نتيجة_تدفق_سلامة_وحدة.حقيقة_دلالية_مفقودة(
                                    الدالة.المعاملات[م].الاسم.النطاق
                                );
                            }
                            | اختيار.بعض(النوع) -> {
                                دع أصول: متغير متجه أصل_استعارة = [];
                                طابق تحقق_حمل_استعارة_نوع_لتدفق(سياق_الذاكرة, النوع) مع
                                | نتيجة.خطأ(الخطأ) -> {
                                    أرجع نتيجة_تدفق_سلامة_وحدة.مرفوضة(الخطأ);
                                }
                                | نتيجة.نجح(يحمل) -> {
                                    لو (يحمل) {
                                        ألحق(أصول, أصل_استعارة.معامل(الرمز));
                                    };
                                };
                                طابق أضف_محليا(سياق_الذاكرة, &متغير الحالة, الرمز, النوع,
                                    حالة_قيمة_محلية.مهيأة(), أصول
                                ) مع
                                | نتيجة.خطأ(الخطأ) -> {
                                    أرجع نتيجة_تدفق_سلامة_وحدة.مرفوضة(الخطأ);
                                }
                                | نتيجة.نجح(_) -> { };
                            };
                        };
                        م := م + 1;
                    }

                    طابق الدالة.الجسم مع
                    | اختيار.لا_شيء -> { }
                    | اختيار.بعض(الجسم) -> {
                        طابق ابن_كتلة_تدفق_سلامة(
                            &الجسم, سياق_الأسماء, روابط_الوحدة, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_تعبيرات_الوحدة,
                            سجل_الأنماط, التحققات, &متغير الحالة
                        ) مع
                        | نتيجة.خطأ(الخطأ) -> {
                            أرجع نتيجة_تدفق_سلامة_وحدة.مرفوضة(الخطأ);
                        }
                        | نتيجة.نجح(_) -> { };
                    };

                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    دع السياق: سياق_تدفق_سلامة_وحدة = { مكتمل: صواب };
    أرجع نتيجة_تدفق_سلامة_وحدة.مكتملة(السياق);
}

عام عرف ابن_تدفق_سلامة_وحدة(
    الوحدة: &وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سجل_الأنماط: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة
): نتيجة_تدفق_سلامة_وحدة {
    دع الوحدات: متغير متجه وحدة_مصدر = [];
    دع روابط_الوحدات: متغير متجه سياق_روابط_أسماء = [];
    دع أنواع_تعبيرات_الوحدات: متغير متجه سياق_أنواع_تعبيرات = [];
    دع الأصل: وحدة_مصدر = *الوحدة;
    دع روابط_الوحدة: سياق_روابط_أسماء = *الروابط;
    دع أنواع_تعبيرات_الوحدة: سياق_أنواع_تعبيرات = *أنواع_التعبيرات;
    ألحق(الوحدات, الأصل);
    ألحق(روابط_الوحدات, روابط_الوحدة);
    ألحق(أنواع_تعبيرات_الوحدات, أنواع_تعبيرات_الوحدة);
    أرجع ابن_تدفق_سلامة_وحدات(
        &الوحدات, سياق_الأسماء, &روابط_الوحدات, سياق_الذاكرة, الأنواع, أنواع_الرموز,
        &أنواع_تعبيرات_الوحدات, سجل_الأنماط, التحققات
    );
}
