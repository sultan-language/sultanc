استورد compiler.frontend.types.type_context;
// SSF is a validation phase. Its per-function flow state is scratch and must die
// after that function has been proven legal; downstream phases consume no final
// borrow/local snapshot. Keep only a completion marker in the public context.
عام نوع سياق_تدفق_سلامة_وحدة = { مكتمل: منطقي };
عام نوع نتيجة_تدفق_سلامة_وحدة =
    | مكتملة بنوع سياق_تدفق_سلامة_وحدة
    | مرفوضة بنوع خطأ_تدفق_سلامة
    | حقيقة_دلالية_مفقودة بنوع نطاق
;

// Temporary call borrows carry a projection path so disjoint record fields are
// independent while whole-owner, same-field, and unknown-index aliases remain conservative.
نوع إسقاط_استعارة_مؤقتة =
    | حقل بنوع معرف_اسم
    | فهرس
;

نوع مسار_استعارة_مؤقتة = {
    المالك: معرف_رمز,
    الإسقاطات: متجه إسقاط_استعارة_مؤقتة
};

نوع استعارة_حجة_مؤقتة = {
    المسار: مسار_استعارة_مؤقتة,
    النوع: نوع_استعارة
};

// A block reports whether control can reach the statement after it. This is an
// SSF control-flow fact, independent from Type and Name ownership.
نوع سقوط_كتلة_تدفق_سلامة =
    | مستمرة
    | منتهية
;

عرف رمز_محلي_من_تعبير(الروابط: &سياق_روابط_أسماء, التعبير: &تعبير): اختيار معرف_رمز {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> {
        أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق);
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف تحقق_استخدامات_تعبير_لتدفق_سلامة(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير
): اختيار خطأ_تدفق_سلامة {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختيار.بعض(الرمز) -> {
            طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختيار.بعض(نوع_تصريح.معامل) -> { طابق تحقق_استخدام_محلي_عند(
                الحالة, الرمز, اختيار.بعض(الاسم.النطاق)) مع
        | نتيجة.خطأ(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
            | اختيار.بعض(نوع_تصريح.ربط_محلي) -> { طابق تحقق_استخدام_محلي_عند(
                الحالة, الرمز, اختيار.بعض(الاسم.النطاق)) مع
        | نتيجة.خطأ(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
            | _ -> { };
        }
        | _ -> { };
    }
    | تعبير.حقل(_, الأصل, _) -> {
        دع أ: تعبير = *الأصل;
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &أ);
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        دع أ: تعبير = *الأصل;
        دع ب: تعبير = *الفهرس;
        طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة,
            &أ) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { };
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &ب);
    }
    | تعبير.فك_موضع(_, الداخل) -> {
        دع أ: تعبير = *الداخل;
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &أ);
    }
    | تعبير.ثنائي(_, _, اليسار, اليمين) -> {
        دع أ: تعبير = *اليسار;
        دع ب: تعبير = *اليمين;
        طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة,
            &أ) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { };
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &ب);
    }
    | تعبير.أحادي(_, _, الداخل) -> {
        دع أ: تعبير = *الداخل;
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &أ);
    }
    | تعبير.استدعاء(_, المستدعى, الحجج) -> {
        دع أ: تعبير = *المستدعى;
        طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة,
            &أ) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة,
                &الحجج[ف]) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { };
            ف := ف + 1;
        }
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        دع أ: تعبير = *الداخل;
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &أ);
    }
    | تعبير.حرفي(_, _) -> { };
    أرجع اختيار.لا_شيء();
}

// A bare local destination may be its first initialization and therefore is not
// read. Composite destinations must read their base/index/reference chain before
// writing, exactly like canonical lvalue-for-write semantics.
عرف تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    الوجهة: &تعبير
): اختيار خطأ_تدفق_سلامة {
    دع القيمة: تعبير = *الوجهة;
    طابق القيمة مع
    | تعبير.اسم(_, _) -> {
        أرجع اختيار.لا_شيء();
    }
    | _ -> {
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(
            سياق_الأسماء, الروابط, الحالة, الوجهة
        );
    };
}

عرف هوية_بدائي_استدعاء_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    التعبير: &تعبير
): اختيار هوية_بدائي_مترجم {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.استدعاء(_, المستدعى_المملوك, _) -> {
        دع المستدعى: تعبير = *المستدعى_المملوك;
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&المستدعى)) مع
        | اختيار.بعض(الرمز) -> { أرجع هوية_بدائي_رمز_عند(سياق_الأسماء, الرمز); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف رمز_جذر_موضع_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    التعبير: &تعبير
): اختيار معرف_رمز {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> { أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق); }
    | تعبير.حقل(_, الأصل, _) -> {
        دع أ: تعبير = *الأصل;
        أرجع رمز_جذر_موضع_لتدفق(الروابط, &أ);
    }
    | تعبير.فهرس(_, الأصل, _) -> {
        دع أ: تعبير = *الأصل;
        أرجع رمز_جذر_موضع_لتدفق(الروابط, &أ);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف ألحق_أصلا_فريدا_لتدفق(
    الناتج: &متغير متجه أصل_استعارة,
    الأصل: أصل_استعارة
): منطقي {
    دع الحالية: متجه أصل_استعارة = *الناتج;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالية) مثل غير_موقع)) {
        لو (أصلان_متساويان(الحالية[ف], الأصل)) { أرجع صواب; };
        ف := ف + 1;
    }
    دع النسخة: متغير متجه أصل_استعارة = *الناتج;
    ألحق(النسخة, الأصل);
    *الناتج := النسخة;
    أرجع صواب;
}

عرف ادمج_أصول_تدفق_إلى(
    الناتج: &متغير متجه أصل_استعارة,
    الإضافة: &متجه أصل_استعارة
): منطقي {
    دع القيم: متجه أصل_استعارة = *الإضافة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع أضيف: منطقي = ألحق_أصلا_فريدا_لتدفق(الناتج, القيم[ف]);
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_أصول_لتدفق(المصدر: &متجه أصل_استعارة): متجه أصل_استعارة {
    دع القيم: متجه أصل_استعارة = *المصدر;
    دع الناتج: متغير متجه أصل_استعارة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        ألحق(الناتج, القيم[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أصول_رمز_محلي_لتدفق(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = [];
    طابق محلي_عند(الحالة, الرمز) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المحلي) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < المحلي.الأصول.العدد) {
            ألحق(الناتج, أصل_محلي_مقروء_عند(الحالة, المحلي, ف));
            ف := ف + 1;
        }
    };
    أرجع الناتج;
}

// Provenance is propagated only for view-dependent values. Ownership/release state
// itself remains in Memory + SSF and is never reconstructed from this origin list.
عرف أصول_تعبير_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير
): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = [];
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختيار.بعض(الرمز) -> { أرجع أصول_رمز_محلي_لتدفق(الحالة, الرمز); }
        | اختيار.لا_شيء -> { };
    }
    | تعبير.حقل(_, الأصل, _) -> {
        دع أ: تعبير = *الأصل;
        أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &أ);
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        دع أ: تعبير = *الأصل;
        أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &أ);
    }
    | تعبير.فك_موضع(_, الداخل) -> {
        دع أ: تعبير = *الداخل;
        أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &أ);
    }
    | تعبير.أحادي(_, العامل, الداخل) -> {
        دع أ: تعبير = *الداخل;
        طابق العامل مع
        | عامل_أحادي.عنوان -> {
            طابق رمز_جذر_موضع_لتدفق(الروابط, &أ) مع
            | اختيار.بعض(الرمز) -> {
                طابق محلي_عند(الحالة, الرمز) مع
                | اختيار.بعض(المحلي) -> {
                    دع النوع: نوع_استعارة = نوع_استعارة.مشتركة();
                    أرجع أصول_استعارة_محلي(الحالة, المحلي, النوع);
                }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | عامل_أحادي.عنوان_متغير -> {
            طابق رمز_جذر_موضع_لتدفق(الروابط, &أ) مع
            | اختيار.بعض(الرمز) -> {
                طابق محلي_عند(الحالة, الرمز) مع
                | اختيار.بعض(المحلي) -> {
                    دع النوع: نوع_استعارة = نوع_استعارة.حصرية();
                    أرجع أصول_استعارة_محلي(الحالة, المحلي, النوع);
                }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | _ -> { أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &أ); };
    }
    | تعبير.استدعاء(_, _, الحجج) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
            دع أصول_الحجة: متجه أصل_استعارة = أصول_تعبير_لتدفق(
                الروابط, الحالة, &الحجج[ف]
            );
            دع أضيف: منطقي = ادمج_أصول_تدفق_إلى(&متغير الناتج, &أصول_الحجة);
            ف := ف + 1;
        }
        أرجع الناتج;
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        دع أ: تعبير = *الداخل;
        أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &أ);
    }
    | _ -> { };
    أرجع الناتج;
}

عرف نوع_تعبير_لتدفق(
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): اختيار معرف_نوع {
    أرجع نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير));
}

عرف تحقق_حمل_استعارة_نوع_لتدفق(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    النوع: معرف_نوع
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
    | نتيجة.نجح(الحقائق) -> { أرجع نتيجة.نجح(الحقائق.يحتوي_مستعارا); };
}

// Borrow provenance is meaningful only for values whose canonical Memory
// classification can actually carry a borrowed reference. In particular, a
// function call does not inherit provenance from its arguments when its result
// is an ordinary owned/scalar value.
عرف أصول_قيمة_تعبير_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير
): نتيجة متجه أصل_استعارة, خطأ_تدفق_سلامة {
    دع الفارغة: متجه أصل_استعارة = [];
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(الفارغة); }
    | اختيار.بعض(النوع) -> {
        طابق تحقق_حمل_استعارة_نوع_لتدفق(سياق_الذاكرة, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(يحمل) -> {
            لو (!يحمل) { أرجع نتيجة.نجح(الفارغة); };
        };
    };
    أرجع نتيجة.نجح(أصول_تعبير_لتدفق(الروابط, الحالة, التعبير));
}

عرف نوع_استعارة_مرجع_مباشر_لتدفق(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختيار نوع_استعارة {
    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
    | اختيار.بعض(_) -> { أرجع اختيار.بعض(نوع_استعارة.حصرية()); }
    | اختيار.لا_شيء -> { };
    طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع) مع
    | اختيار.بعض(_) -> { أرجع اختيار.بعض(نوع_استعارة.مشتركة()); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عرف ثبت_استعارات_أصول_للحامل(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    الحالة: &متغير حالة_تدفق_سلامة,
    النوع: معرف_نوع,
    الأصول: &متجه أصل_استعارة,
    الحامل: معرف_رمز
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق تحقق_حمل_استعارة_نوع_لتدفق(سياق_الذاكرة, النوع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(يحمل) -> { لو (!يحمل) { أرجع نتيجة.نجح(صواب); }; };

    // A direct reference destination owns its exact mutability contract. This
    // permits a consumed &mutable value to be safely downgraded to a shared
    // reference while aggregate carriers preserve each field's recorded mode.
    دع وضع_المرجع_المباشر: اختيار نوع_استعارة =
        نوع_استعارة_مرجع_مباشر_لتدفق(الأنواع, النوع);
    دع القيم: متجه أصل_استعارة = *الأصول;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        طابق القيم[ف] مع
        | أصل_استعارة.محلي(المالك, نوع_الأصل) -> {
            دع نوع_الاستعارة: متغير نوع_استعارة = نوع_الأصل;
            طابق وضع_المرجع_المباشر مع
            | اختيار.بعض(الوضع) -> { نوع_الاستعارة := الوضع; }
            | اختيار.لا_شيء -> { };
            دع هوية_الحامل: اختيار معرف_رمز = اختيار.بعض(الحامل);
            طابق نوع_الاستعارة مع
            | نوع_استعارة.حصرية -> {
                طابق ابدأ_استعارة_حصرية(الحالة, المالك, هوية_الحامل) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            }
            | نوع_استعارة.مشتركة -> {
                طابق ابدأ_استعارة_مشتركة(الحالة, المالك, هوية_الحامل) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عرف أسند_محليا_مع_أصول_تدفق(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الأصول: متجه أصل_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع أصول_الحامل: متجه أصل_استعارة = انسخ_أصول_لتدفق(&الأصول);
    طابق أسند_محليا(الأنواع, الحالة, الرمز, الأصول) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };

    // Replacing a carrier ends only the borrow facts carried by its old value.
    دع أنهى_القديم: منطقي = انه_استعارات_حامل(الحالة, الرمز);
    طابق محلي_عند(الحالة, الرمز) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز)); }
    | اختيار.بعض(المحلي) -> {
        أرجع ثبت_استعارات_أصول_للحامل(
            سياق_الذاكرة, الأنواع, الحالة, المحلي.النوع, &أصول_الحامل, الرمز
        );
    };
}

عرف طبق_نقل_قيمة_تعبير(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختيار.بعض(الرمز) -> {
            طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختيار.بعض(نوع_تصريح.معامل) -> { }
            | اختيار.بعض(نوع_تصريح.ربط_محلي) -> { }
            | _ -> { أرجع نتيجة.نجح(صواب); };
            طابق انقل_محليا(سياق_الذاكرة, الحالة, الرمز, الاسم.النطاق) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(استهلك) -> {
                لو (استهلك) {
                    دع أنهى_الحمل: منطقي = انه_استعارات_حامل(الحالة, الرمز);
                };
                أرجع نتيجة.نجح(صواب);
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | تعبير.حقل(_, الأصل, _) -> {
        طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
        | اختيار.بعض(النوع) -> {
            طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
            | نتيجة.نجح(الحقائق) -> {
                لو (الحقائق.يتطلب_تحريرا) {
                    دع أ: تعبير = *الأصل;
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &أ) مع
                    | اختيار.بعض(الرمز) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز)); }
                    | اختيار.لا_شيء -> { };
                };
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | تعبير.فهرس(_, الأصل, _) -> {
        طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
        | اختيار.بعض(النوع) -> {
            طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
            | نتيجة.نجح(الحقائق) -> {
                لو (الحقائق.يتطلب_تحريرا) {
                    دع أ: تعبير = *الأصل;
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &أ) مع
                    | اختيار.بعض(الرمز) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز)); }
                    | اختيار.لا_شيء -> { };
                };
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        دع أ: تعبير = *الداخل;
        أرجع طبق_نقل_قيمة_تعبير(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &أ
        );
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

عرف طبق_تحرير_استدعاء(
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.استدعاء(_, _, الحجج) -> {
        لو ((الطول(الحجج) مثل غير_موقع) == 1) {
            طابق رمز_محلي_من_تعبير(الروابط, &الحجج[0]) مع
            | اختيار.بعض(الرمز) -> {
                طابق حرر_محليا(سياق_الذاكرة, الحالة, الرمز, نطاق_تعبير(&الحجج[0])) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> {
                    دع أنهى_الحمل: منطقي = انه_استعارات_حامل(الحالة, الرمز);
                    أرجع نتيجة.نجح(صواب);
                };
            }
            | اختيار.لا_شيء -> {
                دع مرجع_الحجة: &تعبير = &الحجج[0];
                دع الحجة: تعبير = *مرجع_الحجة;
                طابق الحجة مع
                | تعبير.حقل(_, الأصل, _) -> {
                    دع أ: تعبير = *الأصل;
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &أ) مع
                    | اختيار.بعض(الرمز) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز)); }
                    | اختيار.لا_شيء -> { };
                }
                | تعبير.فهرس(_, الأصل, _) -> {
                    دع أ: تعبير = *الأصل;
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &أ) مع
                    | اختيار.بعض(الرمز) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز)); }
                    | اختيار.لا_شيء -> { };
                }
                | _ -> { };
            };
        };
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

عرف هل_استدعاء_دالة_يعيد_استعارة(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    التعبير: &تعبير
): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.استدعاء(_, المستدعى_المملوك, _) -> {
        دع المستدعى: تعبير = *المستدعى_المملوك;
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&المستدعى)) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(الرمز) -> {
            طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختيار.بعض(نوع_تصريح.دالة) -> { أرجع صواب; }
            | اختيار.بعض(نوع_تصريح.دالة_خارجية) -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        };
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_مرجعا_مباشرا_لتدفق(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): منطقي {
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(النوع) -> {
        طابق نوع_استعارة_مرجع_مباشر_لتدفق(الأنواع, النوع) مع
        | اختيار.بعض(_) -> { أرجع صواب; }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    };
}

عرف طبق_آثار_استدعاء_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.استدعاء(_, _, الحجج) -> {
        طابق هوية_بدائي_استدعاء_لتدفق(سياق_الأسماء, الروابط, التعبير) مع
        | اختيار.بعض(الهوية) -> {
            طابق الهوية مع
            | هوية_بدائي_مترجم.تحرير -> {
                أرجع طبق_تحرير_استدعاء(
                    الروابط, سياق_الذاكرة, الأنواع, الحالة, التعبير
                );
            }
            | هوية_بدائي_مترجم.إلحاق -> {
                لو ((الطول(الحجج) مثل غير_موقع) >= 1) {
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &الحجج[0]) مع
                    | اختيار.بعض(الرمز) -> {
                        طابق تحقق_تغيير_محلي(الحالة, الرمز) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختيار.لا_شيء -> { };
                };
                لو ((الطول(الحجج) مثل غير_موقع) >= 2) {
                    أرجع طبق_نقل_قيمة_تعبير(
                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحجج[1]
                    );
                };
            }
            | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> {
                لو ((الطول(الحجج) مثل غير_موقع) >= 2) {
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &الحجج[1]) مع
                    | اختيار.بعض(الرمز) -> {
                        طابق تحقق_تغيير_محلي(الحالة, الرمز) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختيار.لا_شيء -> { };
                };
            }
            | هوية_بدائي_مترجم.قراءة_مدخل_دليل -> {
                لو ((الطول(الحجج) مثل غير_موقع) >= 2) {
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &الحجج[1]) مع
                    | اختيار.بعض(الرمز) -> {
                        طابق تحقق_تغيير_محلي(الحالة, الرمز) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختيار.لا_شيء -> { };
                };
            }
            | هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي -> {
                لو ((الطول(الحجج) مثل غير_موقع) >= 1) {
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &الحجج[0]) مع
                    | اختيار.بعض(الرمز) -> {
                        طابق تحقق_تغيير_محلي(الحالة, الرمز) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختيار.لا_شيء -> { };
                };
            }
            | _ -> { };
            أرجع نتيجة.نجح(صواب);
        }
        | اختيار.لا_شيء -> {
            // Owned arguments and constructor payloads transfer ownership. A direct
            // reference passed to an ordinary/external function is reborrowed for the
            // synchronous call; the reference carrier itself remains available after
            // return. Aggregate carriers that contain exclusive references remain affine.
            دع يعيد_استعارة: منطقي = هل_استدعاء_دالة_يعيد_استعارة(
                سياق_الأسماء, الروابط, التعبير
            );
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
                دع مرجع_مباشر: منطقي = هل_تعبير_مرجعا_مباشرا_لتدفق(
                    الأنواع, أنواع_التعبيرات, &الحجج[ف]
                );
                لو (!(يعيد_استعارة && مرجع_مباشر)) {
                    طابق طبق_نقل_قيمة_تعبير(
                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحجج[ف]
                    ) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                };
                ف := ف + 1;
            }
        };
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

// A direct address argument creates a borrow for the duration of the call.
// Temporary call borrows are projection-aware: sibling record fields do not alias,
// while a whole owner, the same field, or any dynamic index remains conservative.
عرف انسخ_إسقاطات_استعارة_مؤقتة(
    المصدر: &متجه إسقاط_استعارة_مؤقتة
): متجه إسقاط_استعارة_مؤقتة {
    دع القيم: متجه إسقاط_استعارة_مؤقتة = *المصدر;
    دع الناتج: متغير متجه إسقاط_استعارة_مؤقتة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        ألحق(الناتج, القيم[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف مسار_استعارة_موضع_مؤقتة(
    الروابط: &سياق_روابط_أسماء,
    التعبير: &تعبير
): اختيار مسار_استعارة_مؤقتة {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختيار.بعض(المالك) -> {
            دع الإسقاطات: متجه إسقاط_استعارة_مؤقتة = [];
            دع المسار: مسار_استعارة_مؤقتة = { المالك: المالك, الإسقاطات: الإسقاطات };
            أرجع اختيار.بعض(المسار);
        }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    | تعبير.حقل(_, الأصل, الاسم) -> {
        دع أ: تعبير = *الأصل;
        طابق مسار_استعارة_موضع_مؤقتة(الروابط, &أ) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المسار_الأصل) -> {
            طابق معرف_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(هوية_الحقل) -> {
                دع الإسقاطات: متغير متجه إسقاط_استعارة_مؤقتة =
                    انسخ_إسقاطات_استعارة_مؤقتة(&المسار_الأصل.الإسقاطات);
                ألحق(الإسقاطات, إسقاط_استعارة_مؤقتة.حقل(هوية_الحقل));
                دع المسار: مسار_استعارة_مؤقتة = {
                    المالك: المسار_الأصل.المالك,
                    الإسقاطات: الإسقاطات
                };
                أرجع اختيار.بعض(المسار);
            };
        };
    }
    | تعبير.فهرس(_, الأصل, _) -> {
        دع أ: تعبير = *الأصل;
        طابق مسار_استعارة_موضع_مؤقتة(الروابط, &أ) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المسار_الأصل) -> {
            دع الإسقاطات: متغير متجه إسقاط_استعارة_مؤقتة =
                انسخ_إسقاطات_استعارة_مؤقتة(&المسار_الأصل.الإسقاطات);
            ألحق(الإسقاطات, إسقاط_استعارة_مؤقتة.فهرس());
            دع المسار: مسار_استعارة_مؤقتة = {
                المالك: المسار_الأصل.المالك,
                الإسقاطات: الإسقاطات
            };
            أرجع اختيار.بعض(المسار);
        };
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف مسارا_استعارة_مؤقتة_متداخلان(
    أ: &مسار_استعارة_مؤقتة,
    ب: &مسار_استعارة_مؤقتة
): منطقي {
    دع قيمة_أ: مسار_استعارة_مؤقتة = *أ;
    دع قيمة_ب: مسار_استعارة_مؤقتة = *ب;
    لو (!معرفا_رمز_متساويان(قيمة_أ.المالك, قيمة_ب.المالك)) { أرجع خطأ; };
    دع حد_أ: غير_موقع = الطول(قيمة_أ.الإسقاطات) مثل غير_موقع;
    دع حد_ب: غير_موقع = الطول(قيمة_ب.الإسقاطات) مثل غير_موقع;
    دع الحد: متغير غير_موقع = حد_ب;
    لو (حد_أ < حد_ب) { الحد := حد_أ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحد) {
        طابق قيمة_أ.الإسقاطات[ف] مع
        | إسقاط_استعارة_مؤقتة.حقل(حقل_أ) -> {
            طابق قيمة_ب.الإسقاطات[ف] مع
            | إسقاط_استعارة_مؤقتة.حقل(حقل_ب) -> {
                لو (!معرفا_اسم_متساويان(حقل_أ, حقل_ب)) { أرجع خطأ; };
            }
            | إسقاط_استعارة_مؤقتة.فهرس -> { أرجع صواب; };
        }
        | إسقاط_استعارة_مؤقتة.فهرس -> { أرجع صواب; };
        ف := ف + 1;
    }
    // Equal paths and prefix paths overlap.
    أرجع صواب;
}

عرف استعارتا_حجة_مؤقتة_متعارضتان(
    أ: &استعارة_حجة_مؤقتة,
    ب: &استعارة_حجة_مؤقتة
): منطقي {
    دع قيمة_أ: استعارة_حجة_مؤقتة = *أ;
    دع قيمة_ب: استعارة_حجة_مؤقتة = *ب;
    لو (!مسارا_استعارة_مؤقتة_متداخلان(&قيمة_أ.المسار, &قيمة_ب.المسار)) { أرجع خطأ; };
    طابق قيمة_أ.النوع مع
    | نوع_استعارة.حصرية -> { أرجع صواب; }
    | نوع_استعارة.مشتركة -> {
        طابق قيمة_ب.النوع مع
        | نوع_استعارة.حصرية -> { أرجع صواب; }
        | نوع_استعارة.مشتركة -> { أرجع خطأ; };
    };
}

عرف تعارض_استعارة_مؤقتة_مع_حالة_المالك(
    الحالة: &حالة_تدفق_سلامة,
    الاستعارة: &استعارة_حجة_مؤقتة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع القيمة: استعارة_حجة_مؤقتة = *الاستعارة;
    طابق محلي_عند(الحالة, القيمة.المسار.المالك) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(القيمة.المسار.المالك));
    }
    | اختيار.بعض(المحلي) -> {
        طابق المحلي.الاستعارات مع
        | حالة_استعارات_محلي_مقروء.بلا -> { أرجع نتيجة.نجح(صواب); }
        | حالة_استعارات_محلي_مقروء.مشتركة -> {
            طابق القيمة.النوع مع
            | نوع_استعارة.مشتركة -> { أرجع نتيجة.نجح(صواب); }
            | نوع_استعارة.حصرية -> {
                أرجع نتيجة.خطأ(
                    خطأ_تدفق_سلامة.تعارض_استعارة(القيمة.المسار.المالك, القيمة.النوع)
                );
            };
        }
        | حالة_استعارات_محلي_مقروء.حصرية -> {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(القيمة.المسار.المالك, القيمة.النوع)
            );
        };
    };
}

عرف ابدأ_استعارة_حجة_مؤقتة(
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير,
    الاستعارات: &متغير متجه استعارة_حجة_مؤقتة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.أحادي(_, العامل, الداخل) -> {
        دع الموضع: تعبير = *الداخل;
        دع نوع_مؤقت: متغير اختيار نوع_استعارة = اختيار.لا_شيء();
        طابق العامل مع
        | عامل_أحادي.عنوان -> { نوع_مؤقت := اختيار.بعض(نوع_استعارة.مشتركة()); }
        | عامل_أحادي.عنوان_متغير -> { نوع_مؤقت := اختيار.بعض(نوع_استعارة.حصرية()); }
        | _ -> { };
        طابق نوع_مؤقت مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
        | اختيار.بعض(نوع_الاستعارة) -> {
            طابق مسار_استعارة_موضع_مؤقتة(الروابط, &الموضع) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
            | اختيار.بعض(المسار) -> {
                دع المالك: معرف_رمز = المسار.المالك;
                دع الجديدة: استعارة_حجة_مؤقتة = { المسار: المسار, النوع: نوع_الاستعارة };
                طابق تعارض_استعارة_مؤقتة_مع_حالة_المالك(الحالة, &الجديدة) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
                دع الحالية: متجه استعارة_حجة_مؤقتة = *الاستعارات;
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(الحالية) مثل غير_موقع)) {
                    لو (استعارتا_حجة_مؤقتة_متعارضتان(&الحالية[ف], &الجديدة)) {
                        أرجع نتيجة.خطأ(
                            خطأ_تدفق_سلامة.تعارض_استعارة(المالك, نوع_الاستعارة)
                        );
                    };
                    ف := ف + 1;
                }
                دع النسخة: متغير متجه استعارة_حجة_مؤقتة = الحالية;
                ألحق(النسخة, الجديدة);
                *الاستعارات := النسخة;
            };
        };
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

// Flow effects are applied recursively so nested calls cannot hide moves,
// releases, or storage mutations from SSF.
عرف طبق_آثار_تعبير_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حقل(_, الأصل, _) -> {
        دع أ: تعبير = *الأصل;
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &أ
        );
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        دع أ: تعبير = *الأصل;
        دع ب: تعبير = *الفهرس;
        طابق طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &أ
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &ب
        );
    }
    | تعبير.فك_موضع(_, الداخل) -> {
        دع أ: تعبير = *الداخل;
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &أ
        );
    }
    | تعبير.ثنائي(_, _, اليسار, اليمين) -> {
        دع أ: تعبير = *اليسار;
        دع ب: تعبير = *اليمين;
        طابق طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &أ
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &ب
        );
    }
    | تعبير.أحادي(_, _, الداخل) -> {
        دع أ: تعبير = *الداخل;
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &أ
        );
    }
    | تعبير.استدعاء(_, المستدعى, الحجج) -> {
        دع أ: تعبير = *المستدعى;
        طابق طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &أ
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحجج[ف]
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            ف := ف + 1;
        }
        دع المؤقتة: متغير متجه استعارة_حجة_مؤقتة = [];
        ف := 0;
        بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
            طابق ابدأ_استعارة_حجة_مؤقتة(الروابط, الحالة, &الحجج[ف], &متغير المؤقتة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            ف := ف + 1;
        }
        طابق طبق_آثار_استدعاء_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, التعبير
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        أرجع نتيجة.نجح(صواب);
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        دع أ: تعبير = *الداخل;
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &أ
        );
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

عرف طبق_مصدر_قيمة_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق طبق_آثار_تعبير_لتدفق(
        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, التعبير
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    أرجع طبق_نقل_قيمة_تعبير(
        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, التعبير
    );
}

عرف تحقق_هروب_تعبير_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
    | اختيار.بعض(النوع) -> {
        طابق تحقق_حمل_استعارة_نوع_لتدفق(سياق_الذاكرة, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(يحمل) -> { لو (!يحمل) { أرجع نتيجة.نجح(صواب); }; };
    };

    طابق رمز_محلي_من_تعبير(الروابط, التعبير) مع
    | اختيار.بعض(الرمز) -> { أرجع تحقق_هروب_محلي(سياق_الذاكرة, الحالة, الرمز); }
    | اختيار.لا_شيء -> { };

    دع الأصول: متجه أصل_استعارة = أصول_تعبير_لتدفق(الروابط, الحالة, التعبير);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأصول) مثل غير_موقع)) {
        طابق الأصول[ف] مع
        | أصل_استعارة.محلي(المالك, _) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.هروب_غير_صالح(المالك)); }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عرف ابن_رموز_ربط_تحقق(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    الروابط: &سياق_روابط_أسماء
): متجه رمز_ربط_نمط_محلول {
    دع القيمة: تحقق_نمط_نوعي = *التحقق;
    دع الناتج: متغير متجه رمز_ربط_نمط_محلول = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.الروابط) مثل غير_موقع)) {
        طابق رمز_ربط_نمط_متحقق_عند(سجل_الأنماط, الروابط, القيمة.الروابط[ف].النمط) مع
        | اختيار.بعض(الرمز) -> { دع ر: رمز_ربط_نمط_محلول = { النمط: القيمة.الروابط[ف].النمط,
            الرمز: الرمز };
        ألحق(الناتج, ر); }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Whole-unit SSF orchestration consumes canonical Name/Type/Pattern facts only.
// It establishes local availability, validates uses, applies Pattern bindings and merges CFG arms.
عرف ابن_كتلة_تدفق_سلامة(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سجل_الأنماط: &سجل_أنماط,
