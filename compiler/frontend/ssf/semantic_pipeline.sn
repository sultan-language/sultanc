استورد compiler.frontend.types.type_context;
// SSF is a validation phase. Its per-function flow state is scratch and must die
// after that function has been proven legal; downstream phases consume no final
// borrow/local snapshot. The public context keeps a completion marker and the
// ownership facts MSIR drop elaboration consumes (ownership_facts.sn).
عام نوع سياق_تدفق_سلامة_وحدة = { مكتمل: منطقي, حقائق_الملكية: حقائق_ملكية_تدفق };
عام نوع نتيجة_تدفق_سلامة_وحدة =
    | مكتملة بنوع سياق_تدفق_سلامة_وحدة
    // One error per rejected function, in program order. Analysis continues
    // with the next function, so a build reports every rejected function.
    | مرفوضة بنوع متجه خطأ_تدفق_سلامة
    | حقيقة_دلالية_مفقودة بنوع نطاق
;

// Temporary call borrows carry a projection path so disjoint record fields are
// independent while whole-owner, same-field, and unknown-index aliases remain conservative.
نوع إسقاط_استعارة_مؤقتة =
    | حقل بنوع معرف_اسم
    | فهرس
;

نوع معرف_مسار_استعارة_مؤقتة = { القيمة: طبيعي };

نوع عقدة_مسار_استعارة_مؤقتة = {
    المالك: معرف_رمز,
    الأب: اختياري معرف_مسار_استعارة_مؤقتة,
    الإسقاط: اختياري إسقاط_استعارة_مؤقتة
};

نوع سجل_مسارات_استعارة_مؤقتة = {
    العقد: متجه عقدة_مسار_استعارة_مؤقتة
};

نوع استعارة_حجة_مؤقتة = {
    المسار: معرف_مسار_استعارة_مؤقتة,
    النوع: نوع_استعارة
};

// A block reports whether control can reach the statement after it. This is an
// SSF control-flow fact, independent from Type and Name ownership.
نوع سقوط_كتلة_تدفق_سلامة =
    | مستمرة
    | منتهية
;

عرف رمز_محلي_من_تعبير(الروابط: &سياق_روابط_أسماء, التعبير: &تعبير): اختياري معرف_رمز {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف تحقق_استخدامات_تعبير_لتدفق_سلامة(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير
): اختياري خطأ_تدفق_سلامة {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختياري.موجود(نوع_تصريح.معامل) -> { طابق تحقق_استخدام_محلي_عند(
                الحالة, الرمز, اختياري.موجود(الاسم.النطاق)) مع
        | نتيجة.خطأ(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { }; }
            | اختياري.موجود(نوع_تصريح.ربط_محلي) -> { طابق تحقق_استخدام_محلي_عند(
                الحالة, الرمز, اختياري.موجود(الاسم.النطاق)) مع
        | نتيجة.خطأ(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { }; }
            | _ -> { };
        }
        | _ -> { };
    }
    | تعبير.حقل(_, الأصل, _) -> {
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &(*الأصل));
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة,
            &(*الأصل)) مع
        | اختياري.موجود(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { };
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &(*الفهرس));
    }
    | تعبير.فك_موضع(_, الداخل) -> {
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &(*الداخل));
    }
    | تعبير.ثنائي(_, _, اليسار, اليمين) -> {
        طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة,
            &(*اليسار)) مع
        | اختياري.موجود(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { };
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &(*اليمين));
    }
    | تعبير.أحادي(_, _, الداخل) -> {
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &(*الداخل));
    }
    | تعبير.استدعاء(_, المستدعى, الحجج) -> {
        طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة,
            &(*المستدعى)) مع
        | اختياري.موجود(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة,
                &الحجج[ف]) مع
        | اختياري.موجود(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { };
            ف := ف + 1;
        }
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &(*الداخل));
    }
    | تعبير.وقت_الترجمة(_, المملوك) -> {
        دع الداخل: تعبير = *المملوك;
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &الداخل);
    }
    | تعبير.تسلسل_وقت_الترجمة(_, التعابير) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &التعابير[ف]) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | _ -> { };
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_متجه(_, التعابير) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &التعابير[ف]) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | _ -> { };
            ف := ف + 1;
        }
    }
    | تعبير.إغلاق(_, _, _, _) -> { }
    | تعبير.حرفي(_, _) -> { };
    أرجع اختياري.لا_شيء();
}

// A bare local destination may be its first initialization and therefore is not
// read. Composite destinations must read their base/index/reference chain before
// writing, exactly like canonical lvalue-for-write semantics.
عرف تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    الوجهة: &تعبير
): اختياري خطأ_تدفق_سلامة {
    طابق *الوجهة مع
    | تعبير.اسم(_, _) -> {
        أرجع اختياري.لا_شيء();
    }
    | _ -> {
        أرجع تحقق_استخدامات_تعبير_لتدفق_سلامة(
            سياق_الأسماء, الروابط, الحالة, الوجهة
        );
    };
}

// The root local of a place a primitive mutates in place (append, swap, pop,
// truncate). A module value is not a local: it lives for the whole program
// and the type check already required it to be mutable, so there is no local
// state to check (a mutable global vector is a process-wide table).
عرف جذر_موضع_محلي_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الموضع: &تعبير
): اختياري معرف_رمز {
    طابق رمز_جذر_موضع_لتدفق(الروابط, الموضع) مع
    | اختياري.موجود(الرمز) -> {
        طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
        | اختياري.موجود(نوع_تصريح.قيمة_عليا) -> { أرجع اختياري.لا_شيء(); }
        | _ -> { أرجع اختياري.موجود(الرمز); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف هوية_بدائي_استدعاء_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    التعبير: &تعبير
): اختياري هوية_بدائي_مترجم {
    طابق *التعبير مع
    | تعبير.استدعاء(_, المستدعى_المملوك, _) -> {
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&(*المستدعى_المملوك))) مع
        | اختياري.موجود(الرمز) -> { أرجع هوية_بدائي_رمز_عند(سياق_الأسماء, الرمز); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف رمز_جذر_موضع_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    التعبير: &تعبير
): اختياري معرف_رمز {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> { أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق); }
    | تعبير.حقل(_, الأصل, _) -> {
        أرجع رمز_جذر_موضع_لتدفق(الروابط, &(*الأصل));
    }
    | تعبير.فهرس(_, الأصل, _) -> {
        أرجع رمز_جذر_موضع_لتدفق(الروابط, &(*الأصل));
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The local a place is ultimately reached from, looking through projections
// and dereferences: for `(*ر).حقل[ف]` it is ر. Unlike رمز_جذر_موضع_لتدفق it
// also names the reference local behind a dereference.
عرف رمز_مرجع_موضع_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    التعبير: &تعبير
): اختياري معرف_رمز {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> { أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق); }
    | تعبير.حقل(_, الأصل, _) -> { أرجع رمز_مرجع_موضع_لتدفق(الروابط, &(*الأصل)); }
    | تعبير.فهرس(_, الأصل, _) -> { أرجع رمز_مرجع_موضع_لتدفق(الروابط, &(*الأصل)); }
    | تعبير.فك_موضع(_, الداخل) -> { أرجع رمز_مرجع_موضع_لتدفق(الروابط, &(*الداخل)); }
    | تعبير.أحادي(_, عامل_أحادي.فك, الداخل) -> { أرجع رمز_مرجع_موضع_لتدفق(الروابط, &(*الداخل)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// A place whose path crosses a dereference: its storage is borrowed, not owned
// by any local of this function.
عرف هل_موضع_عبر_مرجع_لتدفق(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.حقل(_, الأصل, _) -> { أرجع هل_موضع_عبر_مرجع_لتدفق(&(*الأصل)); }
    | تعبير.فهرس(_, الأصل, _) -> { أرجع هل_موضع_عبر_مرجع_لتدفق(&(*الأصل)); }
    | تعبير.فك_موضع(_, _) -> { أرجع صواب; }
    | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// A field or element projection.
عرف هل_إسقاط_موضع_لتدفق(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.حقل(_, _, _) -> { أرجع صواب; }
    | تعبير.فهرس(_, _, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// A place whose storage is borrowed: reached through a dereference, or rooted
// at a borrowed-view local.
عرف هل_موضع_مستعار_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير
): منطقي {
    لو (هل_موضع_عبر_مرجع_لتدفق(التعبير)) { أرجع صواب; };
    طابق *التعبير مع
    | تعبير.اسم(_, _) -> { }
    | تعبير.حقل(_, _, _) -> { }
    | تعبير.فهرس(_, _, _) -> { }
    | _ -> { أرجع خطأ; };
    طابق رمز_جذر_موضع_لتدفق(الروابط, التعبير) مع
    | اختياري.موجود(الرمز) -> {
        طابق محلي_عند(الحالة, الرمز) مع
        | اختياري.موجود(المحلي) -> { أرجع المحلي.عرض_مستعار; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف نوع_محلي_متغير_لتدفق(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    لو (النوع.القيمة >= (الطول((*الأنواع).الأنواع) مثل طبيعي)) { أرجع خطأ; };
    دع مرجع_النوع: &نوع_مقنن = &(*الأنواع).الأنواع[النوع.القيمة];
    طابق *مرجع_النوع مع
    | نوع_مقنن.متغير(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_صندوقا_لتدفق(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): منطقي {
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
    | اختياري.موجود(النوع) -> {
        طابق نوع_حمولة_صندوق_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف يتطلب_تعبير_تحريرا_لتدفق(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
    | اختياري.موجود(النوع) -> {
        طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
        | نتيجة.نجح(الحقائق) -> { أرجع نتيجة.نجح(الحقائق.يتطلب_تحريرا); };
    }
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(خطأ); };
}

عرف خطأ_نقل_من_مرجع_لتدفق(الرمز: اختياري معرف_رمز, التعبير: &تعبير): خطأ_تدفق_سلامة {
    دع السياق: سياق_نقل_من_مرجع = { الرمز: الرمز, الموضع: نطاق_تعبير(التعبير) };
    أرجع خطأ_تدفق_سلامة.نقل_من_مرجع(السياق);
}

// Writing a place reached through a reference while a borrowed view of that
// reference's target is alive would change (and, on reassignment, destroy)
// storage the view still reads. The view holds a shared borrow of the
// reference local; the write needs it to be free.
// A write through the reference ends every borrowed view that reads through it
// (later uses of those views are errors); any other borrow is a conflict.
عرف تحقق_كتابة_عبر_مرجع_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    الحالة: &متغير حالة_تدفق_سلامة,
    الوجهة: &تعبير
): نتيجة منطقي, خطأ_تدفق_سلامة {
    لو (!هل_موضع_عبر_مرجع_لتدفق(الوجهة)) {
        // A write to an owned local, or to a projection of it, ends the
        // borrowed views of that local's storage (match bindings taken from
        // its fields or elements); later uses of them are errors.
        طابق رمز_جذر_موضع_لتدفق(الروابط, الوجهة) مع
        | اختياري.موجود(المالك) -> {
            طابق محلي_عند(الحالة, المالك) مع
            | اختياري.موجود(_) -> {
                دع الحوامل: متجه اختياري معرف_رمز = حوامل_استعارات_محلي(الحالة, المالك);
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الحوامل) مثل طبيعي)) {
                    طابق الحوامل[ف] مع
                    | اختياري.موجود(الحامل) -> {
                        دع أنهى: منطقي = أنه_عرضا_مستعارا(الحالة, الحامل, نطاق_تعبير(الوجهة));
                    }
                    | اختياري.لا_شيء -> { };
                    ف := ف + 1;
                }
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        أرجع نتيجة.نجح(صواب);
    };
    طابق رمز_مرجع_موضع_لتدفق(الروابط, الوجهة) مع
    | اختياري.موجود(المرجع) -> {
        أرجع أنه_عروض_مرجع_لتدفق(الحالة, المرجع, نطاق_تعبير(الوجهة));
    }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(صواب);
}

// Ends the borrowed views and the references held on the reference local
// المرجع: the storage they read may change, so a later use of them is an
// error. A borrow held by anything other than a local is a conflict.
عرف أنه_عروض_مرجع_لتدفق(
    الحالة: &متغير حالة_تدفق_سلامة,
    المرجع: معرف_رمز,
    النطاق: نطاق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع الحوامل: متجه اختياري معرف_رمز = حوامل_استعارات_محلي(الحالة, المرجع);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحوامل) مثل طبيعي)) {
        طابق الحوامل[ف] مع
        | اختياري.موجود(الحامل) -> {
            لو (!أنه_عرضا_مستعارا(الحالة, الحامل, النطاق)) {
                لو (!أنه_حامل_استعارة_مرجع(الحالة, الحامل, النطاق)) {
                    أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تعارض_استعارة(المرجع, نوع_استعارة.مشتركة()));
                };
            };
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تعارض_استعارة(المرجع, نوع_استعارة.مشتركة()));
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

// A call that receives a mutable reference may write the storage behind it.
// `&متغير مكان` through a reference, or an exclusive reference passed on
// directly, ends the views that read through that reference (Rust: a `&mut`
// reborrow conflicts with outstanding shared borrows of the same place).
// A parameter declared as a shared reference only reads: an exclusive
// reference passed to it is downgraded for the call.
عرف معامل_مرجع_مشترك_لتدفق(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    المستدعى: &تعبير,
    الفهرس: طبيعي
): منطقي {
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, المستدعى) مع
    | اختياري.موجود(نوع_المستدعى) -> {
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, الفهرس) مع
        | اختياري.موجود(نوع_المعامل) -> {
            طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, نوع_المعامل) مع
            | اختياري.موجود(_) -> { أرجع خطأ; }
            | اختياري.لا_شيء -> { };
            طابق نوع_داخل_مرجع_دلالي(الأنواع, نوع_المعامل) مع
            | اختياري.موجود(_) -> { أرجع صواب; }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف أنه_عروض_حجة_متغيرة_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    الحجة: &تعبير,
    معامل_مشترك: منطقي
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق *الحجة مع
    | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, الداخل) -> {
        أرجع تحقق_كتابة_عبر_مرجع_لتدفق(الروابط, الحالة, &(*الداخل));
    }
    | تعبير.اسم(_, الاسم) -> {
        لو (معامل_مشترك) { أرجع نتيجة.نجح(صواب); };
        طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, الحجة) مع
        | اختياري.موجود(النوع) -> {
            طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(_) -> {
                طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
                | اختياري.موجود(الرمز) -> {
                    طابق محلي_عند(الحالة, الرمز) مع
                    | اختياري.موجود(_) -> {
                        أرجع أنه_عروض_مرجع_لتدفق(الحالة, الرمز, نطاق_تعبير(الحجة));
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

// Turns an initialized local into a borrowed view of المصدر: it records the
// view flag and shared borrows of everything the view reads through — the
// origins carried by the reference and the reference local itself.
عرف ثبت_عرضا_مستعارا_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    المصدر: &تعبير,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق اجعل_محليا_عرضا_مستعارا(الحالة, الرمز) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(_) -> { };
    سجل_عرض_ملكية(حقائق_الملكية, الرمز);
    دع المالكون: متغير متجه معرف_رمز = [];
    دع الأصول: متجه أصل_استعارة = أصول_تعبير_لتدفق(الروابط, الحالة, المصدر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصول) مثل طبيعي)) {
        طابق الأصول[ف] مع
        | أصل_استعارة.محلي(المالك, _) -> { ألحق(المالكون, المالك); }
        | _ -> { };
        ف := ف + 1;
    }
    طابق رمز_مرجع_موضع_لتدفق(الروابط, المصدر) مع
    | اختياري.موجود(المرجع) -> {
        لو (!معرفا_رمز_متساويان(المرجع, الرمز)) { ألحق(المالكون, المرجع); };
    }
    | اختياري.لا_شيء -> { };
    ف := 0;
    طالما (ف < (الطول(المالكون) مثل طبيعي)) {
        طابق محلي_عند(الحالة, المالكون[ف]) مع
        | اختياري.موجود(_) -> {
            طابق ابدأ_استعارة_مشتركة(الحالة, المالكون[ف], اختياري.موجود(الرمز)) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عرف ألحق_أصلا_فريدا_لتدفق(
    الناتج: &متغير متجه أصل_استعارة,
    الأصل: أصل_استعارة
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الناتج) مثل طبيعي)) {
        لو (أصلان_متساويان((*الناتج)[ف], الأصل)) { أرجع صواب; };
        ف := ف + 1;
    }
    ألحق(*الناتج, الأصل);
    أرجع صواب;
}

عرف ادمج_أصول_تدفق_إلى(
    الناتج: &متغير متجه أصل_استعارة,
    الإضافة: &متجه أصل_استعارة
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الإضافة) مثل طبيعي)) {
        دع أضيف: منطقي = ألحق_أصلا_فريدا_لتدفق(الناتج, (*الإضافة)[ف]);
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_أصول_لتدفق(المصدر: &متجه أصل_استعارة): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أصول_رمز_محلي_لتدفق(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = [];
    طابق محلي_عند(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المحلي) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < المحلي.الأصول.العدد) {
            ألحق(الناتج, أصل_محلي_مقروء_عند(الحالة, المحلي, ف));
            ف := ف + 1;
        }
    };
    أرجع الناتج;
}

// The address of a place reached through a dereference of the reference local
// R (`&(*R).f`, `&(*R)[i]`) reads R's referent: it carries عبر_مرجع(R).
عرف أصول_عبر_مرجع_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    المكان: &تعبير
): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = [];
    لو (!هل_موضع_عبر_مرجع_لتدفق(المكان)) { أرجع الناتج; };
    طابق رمز_مرجع_موضع_لتدفق(الروابط, المكان) مع
    | اختياري.موجود(المرجع) -> {
        طابق محلي_عند(الحالة, المرجع) مع
        | اختياري.موجود(_) -> { ألحق(الناتج, أصل_استعارة.عبر_مرجع(المرجع)); }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع الناتج;
}

// Provenance is propagated only for view-dependent values. Ownership/release state
// itself remains in Memory + SSF and is never reconstructed from this origin list.
عرف أصول_تعبير_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير
): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = [];
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> { أرجع أصول_رمز_محلي_لتدفق(الحالة, الرمز); }
        | اختياري.لا_شيء -> { };
    }
    | تعبير.حقل(_, الأصل, _) -> {
        أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &(*الأصل));
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &(*الأصل));
    }
    | تعبير.فك_موضع(_, الداخل) -> {
        أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &(*الداخل));
    }
    | تعبير.أحادي(_, العامل, الداخل) -> {
        طابق العامل مع
        | عامل_أحادي.عنوان -> {
            طابق رمز_جذر_موضع_لتدفق(الروابط, &(*الداخل)) مع
            | اختياري.موجود(الرمز) -> {
                طابق محلي_عند(الحالة, الرمز) مع
                | اختياري.موجود(المحلي) -> {
                    دع النوع: نوع_استعارة = نوع_استعارة.مشتركة();
                    أرجع أصول_استعارة_محلي(الحالة, المحلي, النوع);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { أرجع أصول_عبر_مرجع_لتدفق(الروابط, الحالة, &(*الداخل)); };
        }
        | عامل_أحادي.عنوان_متغير -> {
            طابق رمز_جذر_موضع_لتدفق(الروابط, &(*الداخل)) مع
            | اختياري.موجود(الرمز) -> {
                طابق محلي_عند(الحالة, الرمز) مع
                | اختياري.موجود(المحلي) -> {
                    دع النوع: نوع_استعارة = نوع_استعارة.حصرية();
                    أرجع أصول_استعارة_محلي(الحالة, المحلي, النوع);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { أرجع أصول_عبر_مرجع_لتدفق(الروابط, الحالة, &(*الداخل)); };
        }
        | _ -> { أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &(*الداخل)); };
    }
    | تعبير.استدعاء(_, _, الحجج) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            دع أصول_الحجة: متجه أصل_استعارة = أصول_تعبير_لتدفق(
                الروابط, الحالة, &الحجج[ف]
            );
            دع أضيف: منطقي = ادمج_أصول_تدفق_إلى(&متغير الناتج, &أصول_الحجة);
            ف := ف + 1;
        }
        أرجع الناتج;
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        أرجع أصول_تعبير_لتدفق(الروابط, الحالة, &(*الداخل));
    }
    // A vector literal carries every borrow its elements carry.
    | تعبير.حرفي_متجه(_, العناصر) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            دع أصول_العنصر: متجه أصل_استعارة = أصول_تعبير_لتدفق(
                الروابط, الحالة, &العناصر[ف]
            );
            دع أضيف: منطقي = ادمج_أصول_تدفق_إلى(&متغير الناتج, &أصول_العنصر);
            ف := ف + 1;
        }
        أرجع الناتج;
    }
    | _ -> { };
    أرجع الناتج;
}

عرف نوع_تعبير_لتدفق(
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): اختياري معرف_نوع {
    أرجع نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير));
}

عرف تحقق_حمل_استعارة_نوع_لتدفق(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    النوع: معرف_نوع
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
    | نتيجة.نجح(الحقائق) -> { أرجع نتيجة.نجح(الحقائق.يحتوي_مستعارا); };
}

// Borrow provenance is meaningful only for values whose canonical Memory
// classification can actually carry a borrowed reference. In particular, a
// function call does not inherit provenance from its arguments when its result
// is an ordinary owned/scalar value.
عرف أصول_قيمة_تعبير_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير
): نتيجة متجه أصل_استعارة, خطأ_تدفق_سلامة {
    دع الفارغة: متجه أصل_استعارة = [];
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(الفارغة); }
    | اختياري.موجود(النوع) -> {
        طابق تحقق_حمل_استعارة_نوع_لتدفق(سياق_الذاكرة, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(يحمل) -> {
            لو (!يحمل) { أرجع نتيجة.نجح(الفارغة); };
        };
    };
    أرجع نتيجة.نجح(أصول_تعبير_لتدفق(الروابط, الحالة, التعبير));
}

عرف نوع_استعارة_مرجع_مباشر_لتدفق(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري نوع_استعارة {
    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(_) -> { أرجع اختياري.موجود(نوع_استعارة.حصرية()); }
    | اختياري.لا_شيء -> { };
    طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(_) -> { أرجع اختياري.موجود(نوع_استعارة.مشتركة()); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف ثبت_استعارات_أصول_للحامل(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    الحالة: &متغير حالة_تدفق_سلامة,
    النوع: معرف_نوع,
    الأصول: &متجه أصل_استعارة,
    الحامل: معرف_رمز
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق تحقق_حمل_استعارة_نوع_لتدفق(سياق_الذاكرة, النوع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(يحمل) -> { لو (!يحمل) { أرجع نتيجة.نجح(صواب); }; };

    // A direct reference destination owns its exact mutability contract. This
    // permits a consumed &mutable value to be safely downgraded to a shared
    // reference while aggregate carriers preserve each field's recorded mode.
    دع وضع_المرجع_المباشر: اختياري نوع_استعارة =
        نوع_استعارة_مرجع_مباشر_لتدفق(الأنواع, النوع);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأصول) مثل طبيعي)) {
        طابق (*الأصول)[ف] مع
        | أصل_استعارة.عبر_مرجع(المرجع) -> {
            // The holder reads through المرجع: a write or a mutable reborrow
            // through it ends the holder (أنه_عروض_مرجع_لتدفق).
            لو (!معرفا_رمز_متساويان(المرجع, الحامل)) {
                طابق محلي_عند(الحالة, المرجع) مع
                | اختياري.موجود(_) -> {
                    طابق ابدأ_استعارة_مشتركة(الحالة, المرجع, اختياري.موجود(الحامل)) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | أصل_استعارة.محلي(المالك, نوع_الأصل) -> {
            دع نوع_الاستعارة: متغير نوع_استعارة = نوع_الأصل;
            طابق وضع_المرجع_المباشر مع
            | اختياري.موجود(الوضع) -> { نوع_الاستعارة := الوضع; }
            | اختياري.لا_شيء -> { };
            دع هوية_الحامل: اختياري معرف_رمز = اختياري.موجود(الحامل);
            طابق نوع_الاستعارة مع
            | نوع_استعارة.حصرية -> {
                طابق ابدأ_استعارة_حصرية(الحالة, المالك, هوية_الحامل) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            }
            | نوع_استعارة.مشتركة -> {
                طابق ابدأ_استعارة_مشتركة(الحالة, المالك, هوية_الحامل) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عرف أسند_محليا_مع_أصول_تدفق(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الأصول: متجه أصل_استعارة,
    الموضع: نطاق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    // A target that is not a tracked local or parameter is a module value; the
    // type checker has already required its writable (mutable) Type. Global
    // storage outlives every borrow, so it may only receive plain values.
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        لو ((الطول(الأصول) مثل طبيعي) != 0) {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز));
        };
        أرجع نتيجة.نجح(صواب);
    }
    | اختياري.موجود(_) -> { };
    دع أصول_الحامل: متجه أصل_استعارة = انسخ_أصول_لتدفق(&الأصول);
    طابق أسند_محليا(الأنواع, الحالة, الرمز, الأصول) مع
    | نتيجة.خطأ(الخطأ) -> {
        // The diagnostic points at the assignment, not the declaration.
        طابق الخطأ مع
        | خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(رمز_الوجهة, _) -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(
                رمز_الوجهة, اختياري.موجود(الموضع)
            ));
        }
        | _ -> { };
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(_) -> { };

    // Replacing a carrier ends only the borrow facts carried by its old value.
    دع أنهى_القديم: منطقي = انه_استعارات_حامل(الحالة, الرمز);
    طابق محلي_عند(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز)); }
    | اختياري.موجود(المحلي) -> {
        أرجع ثبت_استعارات_أصول_للحامل(
            سياق_الذاكرة, الأنواع, الحالة, المحلي.النوع, &أصول_الحامل, الرمز
        );
    };
}

عرف طبق_نقل_قيمة_تعبير(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختياري.موجود(نوع_تصريح.معامل) -> { }
            | اختياري.موجود(نوع_تصريح.ربط_محلي) -> { }
            | اختياري.موجود(نوع_تصريح.قيمة_عليا) -> {
                // A global keeps owning its value for the whole program, so
                // reading an owned global by value would create a second owner
                // of the same storage (and free it at that owner's end). An
                // immutable text value is a constant: each read is a fresh copy.
                لو (هل_عليا_ثابتة(&(*حقائق_الملكية), &الرمز)) { أرجع نتيجة.نجح(صواب); };
                طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
                | اختياري.موجود(نوع_العليا) -> {
                    طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, نوع_العليا) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
                    | نتيجة.نجح(حقائق_العليا) -> {
                        لو (حقائق_العليا.يتطلب_تحريرا) {
                            أرجع نتيجة.خطأ(خطأ_نقل_من_مرجع_لتدفق(اختياري.موجود(الرمز), التعبير));
                        };
                    };
                }
                | اختياري.لا_شيء -> { };
                أرجع نتيجة.نجح(صواب);
            }
            | _ -> { أرجع نتيجة.نجح(صواب); };
            طابق انقل_محليا(سياق_الذاكرة, الحالة, الرمز, الاسم.النطاق) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(استهلك) -> {
                لو (استهلك) {
                    دع أنهى_الحمل: منطقي = انه_استعارات_حامل(الحالة, الرمز);
                    // Lowering clears the local's drop flag at this use.
                    سجل_نقل_ملكية(حقائق_الملكية, الاسم.النطاق);
                };
                أرجع نتيجة.نجح(صواب);
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | تعبير.حقل(_, الأصل, _) -> {
        طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
        | اختياري.موجود(النوع) -> {
            طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
            | نتيجة.نجح(الحقائق) -> {
                لو (الحقائق.يتطلب_تحريرا) {
                    // Only a whole owned local moves. A projection of borrowed
                    // storage is a move out of a reference; a projection of an
                    // owned local is a partial move.
                    لو (هل_موضع_عبر_مرجع_لتدفق(التعبير)) {
                        أرجع نتيجة.خطأ(خطأ_نقل_من_مرجع_لتدفق(
                            رمز_مرجع_موضع_لتدفق(الروابط, التعبير), التعبير
                        ));
                    };
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &(*الأصل)) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق محلي_عند(الحالة, الرمز) مع
                        | اختياري.موجود(المحلي) -> {
                            لو (المحلي.عرض_مستعار) {
                                أرجع نتيجة.خطأ(خطأ_نقل_من_مرجع_لتدفق(اختياري.موجود(الرمز), التعبير));
                            };
                        }
                        | اختياري.لا_شيء -> { };
                        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز));
                    }
                    | اختياري.لا_شيء -> { };
                };
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | تعبير.فهرس(_, الأصل, _) -> {
        طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
        | اختياري.موجود(النوع) -> {
            طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
            | نتيجة.نجح(الحقائق) -> {
                لو (الحقائق.يتطلب_تحريرا) {
                    // Only a whole owned local moves. A projection of borrowed
                    // storage is a move out of a reference; a projection of an
                    // owned local is a partial move.
                    لو (هل_موضع_عبر_مرجع_لتدفق(التعبير)) {
                        أرجع نتيجة.خطأ(خطأ_نقل_من_مرجع_لتدفق(
                            رمز_مرجع_موضع_لتدفق(الروابط, التعبير), التعبير
                        ));
                    };
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &(*الأصل)) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق محلي_عند(الحالة, الرمز) مع
                        | اختياري.موجود(المحلي) -> {
                            لو (المحلي.عرض_مستعار) {
                                أرجع نتيجة.خطأ(خطأ_نقل_من_مرجع_لتدفق(اختياري.موجود(الرمز), التعبير));
                            };
                        }
                        | اختياري.لا_شيء -> { };
                        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز));
                    }
                    | اختياري.لا_شيء -> { };
                };
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | تعبير.أحادي(_, عامل_أحادي.فك, الداخل) -> {
        // Reading a value that owns nothing copies it. Moving an owning
        // value out of an owned box consumes the box itself; moving it out of
        // a reference is a move out of borrowed storage.
        طابق يتطلب_تعبير_تحريرا_لتدفق(سياق_الذاكرة, أنواع_التعبيرات, التعبير) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(يتطلب) -> {
            لو (!يتطلب) { أرجع نتيجة.نجح(صواب); };
        };
        لو (هل_تعبير_صندوقا_لتدفق(الأنواع, أنواع_التعبيرات, &(*الداخل))) {
            أرجع طبق_نقل_قيمة_تعبير(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*الداخل), حقائق_الملكية
            );
        };
        أرجع نتيجة.خطأ(خطأ_نقل_من_مرجع_لتدفق(اختياري.لا_شيء(), التعبير));
    }
    | تعبير.فك_موضع(_, _) -> {
        طابق يتطلب_تعبير_تحريرا_لتدفق(سياق_الذاكرة, أنواع_التعبيرات, التعبير) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(يتطلب) -> {
            لو (يتطلب) { أرجع نتيجة.خطأ(خطأ_نقل_من_مرجع_لتدفق(اختياري.لا_شيء(), التعبير)); };
        };
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        أرجع طبق_نقل_قيمة_تعبير(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*الداخل), حقائق_الملكية
        );
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

عرف طبق_تحرير_استدعاء(
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق *التعبير مع
    | تعبير.استدعاء(_, _, الحجج) -> {
        لو ((الطول(الحجج) مثل طبيعي) == 1) {
            طابق رمز_محلي_من_تعبير(الروابط, &الحجج[0]) مع
            | اختياري.موجود(الرمز) -> {
                // A name that is not a local of this function is a module
                // value: the program owns it, so releasing it here would free
                // storage every later read still uses.
                طابق محلي_عند(الحالة, الرمز) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز, اختياري.موجود(نطاق_تعبير(&الحجج[0]))));
                }
                | اختياري.موجود(_) -> { };
                طابق حرر_محليا(سياق_الذاكرة, الحالة, الرمز, نطاق_تعبير(&الحجج[0])) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> {
                    دع أنهى_الحمل: منطقي = انه_استعارات_حامل(الحالة, الرمز);
                    // The release consumes the local: lowering must not drop it again.
                    طابق الحجج[0] مع
                    | تعبير.اسم(_, اسم_المحرر) -> { سجل_نقل_ملكية(حقائق_الملكية, اسم_المحرر.النطاق); }
                    | _ -> { };
                    أرجع نتيجة.نجح(صواب);
                };
            }
            | اختياري.لا_شيء -> {
                دع مرجع_الحجة: &تعبير = &الحجج[0];
                طابق *مرجع_الحجة مع
                | تعبير.حقل(_, الأصل, _) -> {
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &(*الأصل)) مع
                    | اختياري.موجود(الرمز) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز)); }
                    | اختياري.لا_شيء -> { };
                }
                | تعبير.فهرس(_, الأصل, _) -> {
                    طابق رمز_جذر_موضع_لتدفق(الروابط, &(*الأصل)) مع
                    | اختياري.موجود(الرمز) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز)); }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            };
        };
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

عرف هل_استدعاء_دالة_يعيد_استعارة(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    التعبير: &تعبير
): منطقي {
    طابق *التعبير مع
    | تعبير.استدعاء(_, المستدعى_المملوك, _) -> {
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&(*المستدعى_المملوك))) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختياري.موجود(نوع_تصريح.دالة) -> { أرجع صواب; }
            | اختياري.موجود(نوع_تصريح.دالة_خارجية) -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        };
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_مرجعا_مباشرا_لتدفق(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): منطقي {
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(النوع) -> {
        طابق نوع_استعارة_مرجع_مباشر_لتدفق(الأنواع, النوع) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    };
}

// A vector where a slice is expected: the type checker admitted it as a view
// (compatibility.sn, هل_عرض_متجه_كشريحة); the elements of a generic slice
// parameter are still unsubstituted here.
عرف هل_عرض_متجه_كشريحة_لتدفق(
    الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): منطقي {
    طابق نوع_عنصر_متجه_دلالي(الأنواع, المصدر) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> {
        طابق نوع_عنصر_شريحة_دلالي(الأنواع, الهدف) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(_) -> { أرجع صواب; };
    };
}

عرف طبق_آثار_استدعاء_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق *التعبير مع
    | تعبير.استدعاء(_, المستدعى, الحجج) -> {
        طابق هوية_بدائي_استدعاء_لتدفق(سياق_الأسماء, الروابط, التعبير) مع
        | اختياري.موجود(الهوية) -> {
            طابق الهوية مع
            | هوية_بدائي_مترجم.تحرير -> {
                أرجع طبق_تحرير_استدعاء(
                    الروابط, سياق_الذاكرة, الأنواع, الحالة, التعبير, حقائق_الملكية
                );
            }
            | هوية_بدائي_مترجم.إلحاق -> {
                لو ((الطول(الحجج) مثل طبيعي) >= 1) {
                    طابق تحقق_كتابة_عبر_مرجع_لتدفق(الروابط, الحالة, &الحجج[0]) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                    طابق جذر_موضع_محلي_لتدفق(سياق_الأسماء, الروابط, &الحجج[0]) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق تحقق_تغيير_محلي(الحالة, الرمز) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
                لو ((الطول(الحجج) مثل طبيعي) >= 2) {
                    أرجع طبق_نقل_قيمة_تعبير(
                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحجج[1], حقائق_الملكية
                    );
                };
            }
            // Reserve may reallocate the buffer: it writes the vector through
            // its place, as append does, and ends views read through it.
            | هوية_بدائي_مترجم.حجز_سعة_متجه -> {
                لو ((الطول(الحجج) مثل طبيعي) >= 1) {
                    طابق تحقق_كتابة_عبر_مرجع_لتدفق(الروابط, الحالة, &الحجج[0]) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                    طابق جذر_موضع_محلي_لتدفق(سياق_الأسماء, الروابط, &الحجج[0]) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق تحقق_تغيير_محلي(الحالة, الرمز) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            // Pop moves the last element out and truncate drops the tail: both
            // write the vector through its place, as append does. Pop's result
            // is a fresh owned value; truncate's length is a plain read.
            | هوية_بدائي_مترجم.إزالة_الأخير -> {
                لو ((الطول(الحجج) مثل طبيعي) >= 1) {
                    طابق تحقق_كتابة_عبر_مرجع_لتدفق(الروابط, الحالة, &الحجج[0]) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                    طابق جذر_موضع_محلي_لتدفق(سياق_الأسماء, الروابط, &الحجج[0]) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق تحقق_تغيير_محلي(الحالة, الرمز) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | هوية_بدائي_مترجم.اقتطاع_متجه -> {
                لو ((الطول(الحجج) مثل طبيعي) >= 1) {
                    طابق تحقق_كتابة_عبر_مرجع_لتدفق(الروابط, الحالة, &الحجج[0]) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                    طابق جذر_موضع_محلي_لتدفق(سياق_الأسماء, الروابط, &الحجج[0]) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق تحقق_تغيير_محلي(الحالة, الرمز) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
                لو ((الطول(الحجج) مثل طبيعي) >= 2) {
                    أرجع طبق_نقل_قيمة_تعبير(
                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحجج[1], حقائق_الملكية
                    );
                };
            }
            | هوية_بدائي_مترجم.تبديل_موضعين -> {
                // The exchange is atomic at the ownership level: neither projection is
                // exposed in a moved-out state. SSF therefore validates mutation of each
                // root while preserving the whole-root initialization state.
                دع ف_الموضع: متغير طبيعي = 0;
                طالما (ف_الموضع < (الطول(الحجج) مثل طبيعي)) {
                    طابق تحقق_كتابة_عبر_مرجع_لتدفق(الروابط, الحالة, &الحجج[ف_الموضع]) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                    طابق جذر_موضع_محلي_لتدفق(سياق_الأسماء, الروابط, &الحجج[ف_الموضع]) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق تحقق_تغيير_محلي(الحالة, الرمز) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    ف_الموضع := ف_الموضع + 1;
                }
            }
            // Leaking a box (Box::into_raw) consumes it: the owner gives the
            // allocation to the returned raw pointer and must not free it.
            | هوية_بدائي_مترجم.سرب_قيمة -> {
                لو ((الطول(الحجج) مثل طبيعي) >= 1) {
                    أرجع طبق_نقل_قيمة_تعبير(
                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحجج[0], حقائق_الملكية
                    );
                };
            }
            | _ -> { };
            أرجع نتيجة.نجح(صواب);
        }
        | اختياري.لا_شيء -> {
            // Owned arguments and constructor payloads transfer ownership. A direct
            // reference passed to an ordinary/external function is reborrowed for the
            // synchronous call; the reference carrier itself remains available after
            // return. Aggregate carriers that contain exclusive references remain affine.
            دع يعيد_استعارة: منطقي = هل_استدعاء_دالة_يعيد_استعارة(
                سياق_الأسماء, الروابط, التعبير
            );
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                طابق أنه_عروض_حجة_متغيرة_لتدفق(
                    الروابط, الأنواع, أنواع_التعبيرات, الحالة, &الحجج[ف],
                    معامل_مرجع_مشترك_لتدفق(الأنواع, أنواع_التعبيرات, &(*المستدعى), ف)
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
                دع مرجع_مباشر: منطقي = هل_تعبير_مرجعا_مباشرا_لتدفق(
                    الأنواع, أنواع_التعبيرات, &الحجج[ف]
                );
                // A vector passed as a slice parameter is viewed for the call,
                // not moved.
                دع عرض_شريحة: متغير منطقي = خطأ;
                طابق نوع_مستدعى_استدعاء_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير)) مع
                | اختياري.موجود(نوع_المستدعى) -> {
                    طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
                    | اختياري.موجود(نوع_المعامل) -> {
                        طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, &الحجج[ف]) مع
                        | اختياري.موجود(نوع_الحجة) -> {
                            عرض_شريحة := هل_عرض_متجه_كشريحة_لتدفق(الأنواع, نوع_الحجة, نوع_المعامل);
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                لو (!(يعيد_استعارة && مرجع_مباشر) && !عرض_شريحة) {
                    طابق طبق_نقل_قيمة_تعبير(
                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحجج[ف], حقائق_الملكية
                    ) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                };
                ف := ف + 1;
            }
        };
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

// A direct address argument creates a borrow for the duration of the call.
// Temporary paths are append-only PathID nodes: extending a path records only
// its parent and one projection. No projection vector is cloned.
عرف سجل_مسارات_استعارة_مؤقتة_جديد(): سجل_مسارات_استعارة_مؤقتة {
    دع العقد: متجه عقدة_مسار_استعارة_مؤقتة = [];
    دع السجل: سجل_مسارات_استعارة_مؤقتة = { العقد: العقد };
    أرجع السجل;
}

عرف أضف_عقدة_مسار_استعارة_مؤقتة(
    السجل: &متغير سجل_مسارات_استعارة_مؤقتة,
    المالك: معرف_رمز,
    الأب: اختياري معرف_مسار_استعارة_مؤقتة,
    الإسقاط: اختياري إسقاط_استعارة_مؤقتة
): معرف_مسار_استعارة_مؤقتة {
    دع القيمة: طبيعي = الطول((*السجل).العقد) مثل طبيعي;
    دع المعرف: معرف_مسار_استعارة_مؤقتة = {
        القيمة: القيمة
    };
    دع العقدة: عقدة_مسار_استعارة_مؤقتة = {
        المالك: المالك,
        الأب: الأب,
        الإسقاط: الإسقاط
    };
    ألحق((*السجل).العقد, العقدة);
    أرجع المعرف;
}

عرف مالك_مسار_استعارة_مؤقتة(
    السجل: &سجل_مسارات_استعارة_مؤقتة,
    المعرف: معرف_مسار_استعارة_مؤقتة
): اختياري معرف_رمز {
    لو (المعرف.القيمة >= (الطول((*السجل).العقد) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_العقدة: &عقدة_مسار_استعارة_مؤقتة = &(*السجل).العقد[المعرف.القيمة];
    أرجع اختياري.موجود((*مرجع_العقدة).المالك);
}

عرف عدد_إسقاطات_مسار_استعارة_مؤقتة(
    السجل: &سجل_مسارات_استعارة_مؤقتة,
    المعرف: معرف_مسار_استعارة_مؤقتة
): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع الحالي: متغير اختياري معرف_مسار_استعارة_مؤقتة = اختياري.موجود(المعرف);
    طالما (صواب) {
        طابق الحالي مع
        | اختياري.لا_شيء -> { أرجع العدد; }
        | اختياري.موجود(الموضع) -> {
            لو (الموضع.القيمة >= (الطول((*السجل).العقد) مثل طبيعي)) { أرجع العدد; };
            دع مرجع_العقدة: &عقدة_مسار_استعارة_مؤقتة = &(*السجل).العقد[الموضع.القيمة];
            طابق (*مرجع_العقدة).الإسقاط مع
            | اختياري.موجود(_) -> { العدد := العدد + 1; }
            | اختياري.لا_شيء -> { };
            الحالي := (*مرجع_العقدة).الأب;
        };
    }
    أرجع العدد;
}

عرف إسقاط_مسار_استعارة_مؤقتة_عند(
    السجل: &سجل_مسارات_استعارة_مؤقتة,
    المعرف: معرف_مسار_استعارة_مؤقتة,
    الفهرس: طبيعي
): اختياري إسقاط_استعارة_مؤقتة {
    دع العدد: طبيعي = عدد_إسقاطات_مسار_استعارة_مؤقتة(السجل, المعرف);
    لو (الفهرس >= العدد) { أرجع اختياري.لا_شيء(); };
    دع خطوات: متغير طبيعي = العدد - 1 - الفهرس;
    دع الحالي: متغير معرف_مسار_استعارة_مؤقتة = المعرف;
    طالما (خطوات > 0) {
        لو (الحالي.القيمة >= (الطول((*السجل).العقد) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        دع مرجع_العقدة: &عقدة_مسار_استعارة_مؤقتة = &(*السجل).العقد[الحالي.القيمة];
        طابق (*مرجع_العقدة).الأب مع
        | اختياري.موجود(الأب) -> { الحالي := الأب; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        خطوات := خطوات - 1;
    }
    لو (الحالي.القيمة >= (الطول((*السجل).العقد) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع مرجع_العقدة: &عقدة_مسار_استعارة_مؤقتة = &(*السجل).العقد[الحالي.القيمة];
    أرجع (*مرجع_العقدة).الإسقاط;
}

عرف مسار_استعارة_موضع_مؤقتة(
    الروابط: &سياق_روابط_أسماء,
    التعبير: &تعبير,
    السجل: &متغير سجل_مسارات_استعارة_مؤقتة
): اختياري معرف_مسار_استعارة_مؤقتة {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(المالك) -> {
            أرجع اختياري.موجود(أضف_عقدة_مسار_استعارة_مؤقتة(
                السجل, المالك, اختياري.لا_شيء(), اختياري.لا_شيء()
            ));
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | تعبير.حقل(_, الأصل, الاسم) -> {
        طابق مسار_استعارة_موضع_مؤقتة(الروابط, &(*الأصل), السجل) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(مسار_الأصل) -> {
            طابق معرف_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(هوية_الحقل) -> {
                طابق مالك_مسار_استعارة_مؤقتة(السجل, مسار_الأصل) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(المالك) -> {
                    أرجع اختياري.موجود(أضف_عقدة_مسار_استعارة_مؤقتة(
                        السجل, المالك, اختياري.موجود(مسار_الأصل),
                        اختياري.موجود(إسقاط_استعارة_مؤقتة.حقل(هوية_الحقل))
                    ));
                };
            };
        };
    }
    | تعبير.فهرس(_, الأصل, _) -> {
        طابق مسار_استعارة_موضع_مؤقتة(الروابط, &(*الأصل), السجل) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(مسار_الأصل) -> {
            طابق مالك_مسار_استعارة_مؤقتة(السجل, مسار_الأصل) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المالك) -> {
                أرجع اختياري.موجود(أضف_عقدة_مسار_استعارة_مؤقتة(
                    السجل, المالك, اختياري.موجود(مسار_الأصل),
                    اختياري.موجود(إسقاط_استعارة_مؤقتة.فهرس())
                ));
            };
        };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف مسارا_استعارة_مؤقتة_متداخلان(
    السجل: &سجل_مسارات_استعارة_مؤقتة,
    أ: معرف_مسار_استعارة_مؤقتة,
    ب: معرف_مسار_استعارة_مؤقتة
): منطقي {
    دع مالك_أ: معرف_رمز;
    طابق مالك_مسار_استعارة_مؤقتة(السجل, أ) مع
    | اختياري.موجود(المالك) -> { مالك_أ := المالك; }
    | اختياري.لا_شيء -> { أرجع صواب; };
    دع مالك_ب: معرف_رمز;
    طابق مالك_مسار_استعارة_مؤقتة(السجل, ب) مع
    | اختياري.موجود(المالك) -> { مالك_ب := المالك; }
    | اختياري.لا_شيء -> { أرجع صواب; };
    لو (!معرفا_رمز_متساويان(مالك_أ, مالك_ب)) { أرجع خطأ; };
    دع حد_أ: طبيعي = عدد_إسقاطات_مسار_استعارة_مؤقتة(السجل, أ);
    دع حد_ب: طبيعي = عدد_إسقاطات_مسار_استعارة_مؤقتة(السجل, ب);
    دع الحد: متغير طبيعي = حد_ب;
    لو (حد_أ < حد_ب) { الحد := حد_أ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحد) {
        دع إسقاط_أ: اختياري إسقاط_استعارة_مؤقتة = إسقاط_مسار_استعارة_مؤقتة_عند(السجل, أ, ف);
        دع إسقاط_ب: اختياري إسقاط_استعارة_مؤقتة = إسقاط_مسار_استعارة_مؤقتة_عند(السجل, ب, ف);
        طابق إسقاط_أ مع
        | اختياري.لا_شيء -> { أرجع صواب; }
        | اختياري.موجود(قيمة_أ) -> {
            طابق إسقاط_ب مع
            | اختياري.لا_شيء -> { أرجع صواب; }
            | اختياري.موجود(قيمة_ب) -> {
                طابق قيمة_أ مع
                | إسقاط_استعارة_مؤقتة.حقل(حقل_أ) -> {
                    طابق قيمة_ب مع
                    | إسقاط_استعارة_مؤقتة.حقل(حقل_ب) -> {
                        لو (!معرفا_اسم_متساويان(حقل_أ, حقل_ب)) { أرجع خطأ; };
                    }
                    | إسقاط_استعارة_مؤقتة.فهرس -> { أرجع صواب; };
                }
                | إسقاط_استعارة_مؤقتة.فهرس -> { أرجع صواب; };
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف استعارتا_حجة_مؤقتة_متعارضتان(
    السجل: &سجل_مسارات_استعارة_مؤقتة,
    أ: &استعارة_حجة_مؤقتة,
    ب: &استعارة_حجة_مؤقتة
): منطقي {
    لو (!مسارا_استعارة_مؤقتة_متداخلان(السجل, (*أ).المسار, (*ب).المسار)) { أرجع خطأ; };
    طابق (*أ).النوع مع
    | نوع_استعارة.حصرية -> { أرجع صواب; }
    | نوع_استعارة.مشتركة -> {
        طابق (*ب).النوع مع
        | نوع_استعارة.حصرية -> { أرجع صواب; }
        | نوع_استعارة.مشتركة -> { أرجع خطأ; };
    };
}

عرف تعارض_استعارة_مؤقتة_مع_حالة_المالك(
    سياق_الأسماء: &سياق_أسماء,
    السجل: &سجل_مسارات_استعارة_مؤقتة,
    الحالة: &حالة_تدفق_سلامة,
    الاستعارة: &استعارة_حجة_مؤقتة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع معرف_المسار: معرف_مسار_استعارة_مؤقتة = (*الاستعارة).المسار;
    دع مرجع_العقدة: &عقدة_مسار_استعارة_مؤقتة = &(*السجل).العقد[معرف_المسار.القيمة];
    دع المالك: معرف_رمز = (*مرجع_العقدة).المالك;
    // Module storage has no per-function local-state entry. Name owns its identity;
    // the existing temporary argument-path checks still enforce overlapping borrows.
    طابق نوع_رمز_عند(سياق_الأسماء, المالك) مع
    | اختياري.موجود(نوع_تصريح.قيمة_عليا) -> { أرجع نتيجة.نجح(صواب); }
    | _ -> { };
    طابق محلي_عند(الحالة, المالك) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(المالك));
    }
    | اختياري.موجود(المحلي) -> {
        طابق المحلي.الاستعارات مع
        | حالة_استعارات_محلي_مقروء.بلا -> { أرجع نتيجة.نجح(صواب); }
        | حالة_استعارات_محلي_مقروء.مشتركة -> {
            طابق (*الاستعارة).النوع مع
            | نوع_استعارة.مشتركة -> { أرجع نتيجة.نجح(صواب); }
            | نوع_استعارة.حصرية -> {
                أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تعارض_استعارة(المالك, (*الاستعارة).النوع));
            };
        }
        | حالة_استعارات_محلي_مقروء.حصرية -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تعارض_استعارة(المالك, (*الاستعارة).النوع));
        };
    };
}

عرف ابدأ_استعارة_حجة_مؤقتة(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير,
    المسارات: &متغير سجل_مسارات_استعارة_مؤقتة,
    الاستعارات: &متغير متجه استعارة_حجة_مؤقتة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق *التعبير مع
    | تعبير.أحادي(_, العامل, الداخل) -> {
        دع نوع_مؤقت: متغير اختياري نوع_استعارة = اختياري.لا_شيء();
        طابق العامل مع
        | عامل_أحادي.عنوان -> { نوع_مؤقت := اختياري.موجود(نوع_استعارة.مشتركة()); }
        | عامل_أحادي.عنوان_متغير -> { نوع_مؤقت := اختياري.موجود(نوع_استعارة.حصرية()); }
        | _ -> { };
        طابق نوع_مؤقت مع
        | اختياري.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
        | اختياري.موجود(نوع_الاستعارة) -> {
            طابق مسار_استعارة_موضع_مؤقتة(الروابط, &(*الداخل), المسارات) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
            | اختياري.موجود(المسار) -> {
                دع المالك: معرف_رمز;
                طابق مالك_مسار_استعارة_مؤقتة(المسارات, المسار) مع
                | اختياري.موجود(القيمة) -> { المالك := القيمة; }
                | اختياري.لا_شيء -> { أرجع نتيجة.نجح(صواب); };
                دع الجديدة: استعارة_حجة_مؤقتة = { المسار: المسار, النوع: نوع_الاستعارة };
                طابق تعارض_استعارة_مؤقتة_مع_حالة_المالك(سياق_الأسماء, المسارات, الحالة, &الجديدة) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(*الاستعارات) مثل طبيعي)) {
                    دع مرجع_الاستعارة: &استعارة_حجة_مؤقتة = &(*الاستعارات)[ف];
                    لو (استعارتا_حجة_مؤقتة_متعارضتان(المسارات, مرجع_الاستعارة, &الجديدة)) {
                        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تعارض_استعارة(المالك, نوع_الاستعارة));
                    };
                    ف := ف + 1;
                }
                ألحق(*الاستعارات, الجديدة);
            };
        };
    }
    // The borrows a vector literal argument's elements take (directly, or as
    // payloads of an element's enum constructor) last as long as the call,
    // like the argument's own borrows. A borrow passed to an element's
    // function call ends with that call.
    | تعبير.حرفي_متجه(_, العناصر) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            طابق ابدأ_استعارة_حجة_مؤقتة(
                سياق_الأسماء, الروابط, الحالة, &العناصر[ف], المسارات, الاستعارات
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            دع منشئ: متغير منطقي = خطأ;
            طابق العناصر[ف] مع
            | تعبير.استدعاء(_, المستدعى, _) -> {
                طابق *المستدعى مع
                | تعبير.حقل(_, _, اسم_المنشئ) -> {
                    طابق رمز_اسم_محلول_عند(الروابط, اسم_المنشئ.النطاق) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
                        | اختياري.موجود(نوع_تصريح.منشئ_تعداد) -> { منشئ := صواب; }
                        | _ -> { };
                    }
                    // option/result constructors are contextual and have no symbol.
                    | اختياري.لا_شيء -> { منشئ := صواب; };
                }
                | _ -> { };
            }
            | _ -> { };
            طابق العناصر[ف] مع
            | تعبير.استدعاء(_, _, حجج_العنصر) -> {
                دع ح: متغير طبيعي = 0;
                طالما (منشئ && ح < (الطول(حجج_العنصر) مثل طبيعي)) {
                    طابق ابدأ_استعارة_حجة_مؤقتة(
                        سياق_الأسماء, الروابط, الحالة, &حجج_العنصر[ح], المسارات, الاستعارات
                    ) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                    ح := ح + 1;
                }
            }
            | _ -> { };
            ف := ف + 1;
        }
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

// Flow effects are applied recursively so nested calls cannot hide moves,
// releases, or storage mutations from SSF.
// A closure captures plain values by copy and owned values by move (Rust's
// `move` closure): the environment owns a moved capture, its destructor
// drops it with the environment's last reference, and the local is moved
// out from the construction on. A capture that holds a reference escapes.
عرف تحقق_التقاطات_إغلاق_لتدفق(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    النطاق: نطاق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع الالتقاطات: متجه معرف_رمز;
    طابق التقاطات_إغلاق_عند(أنواع_التعبيرات, النطاق) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
    | اختياري.موجود(القيم) -> { الالتقاطات := القيم; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الالتقاطات) مثل طبيعي)) {
        دع الرمز: معرف_رمز = الالتقاطات[ف];
        طابق تحقق_استخدام_محلي_عند(الحالة, الرمز, اختياري.موجود(النطاق)) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        طابق محلي_عند(الحالة, الرمز) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز)); }
        | اختياري.موجود(المحلي) -> {
            طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, المحلي.النوع) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
            | نتيجة.نجح(الحقائق) -> {
                طابق الحقائق.الصنف مع
                | صنف_ذاكرة.عادي -> { }
                | صنف_ذاكرة.مملوك -> {
                    لو (الحقائق.يحتوي_استعارة_حصرية) {
                        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز));
                    };
                    طابق انقل_محليا(سياق_الذاكرة, الحالة, الرمز, النطاق) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                }
                | _ -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز)); };
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عرف طبق_آثار_تعبير_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق *التعبير مع
    | تعبير.حقل(_, الأصل, _) -> {
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*الأصل), حقائق_الملكية
        );
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        طابق طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*الأصل), حقائق_الملكية
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*الفهرس), حقائق_الملكية
        );
    }
    | تعبير.فك_موضع(_, الداخل) -> {
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*الداخل), حقائق_الملكية
        );
    }
    | تعبير.ثنائي(_, _, اليسار, اليمين) -> {
        طابق طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*اليسار), حقائق_الملكية
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*اليمين), حقائق_الملكية
        );
    }
    | تعبير.أحادي(_, العامل, الداخل) -> {
        // A mutable reborrow through a reference may write the storage behind
        // it: the views and references reading through that reference end.
        لو ((العامل == عامل_أحادي.عنوان_متغير()) && هل_موضع_عبر_مرجع_لتدفق(&(*الداخل))) {
            طابق تحقق_كتابة_عبر_مرجع_لتدفق(الروابط, الحالة, &(*الداخل)) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        };
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*الداخل), حقائق_الملكية
        );
    }
    | تعبير.استدعاء(_, المستدعى, الحجج) -> {
        طابق طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*المستدعى), حقائق_الملكية
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحجج[ف], حقائق_الملكية
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            ف := ف + 1;
        }
        دع مسارات_المؤقتة: متغير سجل_مسارات_استعارة_مؤقتة = سجل_مسارات_استعارة_مؤقتة_جديد();
        دع المؤقتة: متغير متجه استعارة_حجة_مؤقتة = [];
        ف := 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            طابق ابدأ_استعارة_حجة_مؤقتة(
                سياق_الأسماء, الروابط, الحالة, &الحجج[ف], &متغير مسارات_المؤقتة, &متغير المؤقتة
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            ف := ف + 1;
        }
        طابق طبق_آثار_استدعاء_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, التعبير, حقائق_الملكية
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        أرجع نتيجة.نجح(صواب);
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &(*الداخل), حقائق_الملكية
        );
    }
    | تعبير.وقت_الترجمة(_, المملوك) -> {
        دع الداخل: تعبير = *المملوك;
        أرجع طبق_آثار_تعبير_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الداخل, حقائق_الملكية
        );
    }
    | تعبير.تسلسل_وقت_الترجمة(_, التعابير) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &التعابير[ف], حقائق_الملكية
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(صواب);
    }
    // Each element is evaluated in order and moved into the new vector, as
    // in the initializer statement `let v: T = [..];`. Borrows the elements
    // hold for the duration of a call are checked where the literal is an
    // argument (ابدأ_استعارة_حجة_مؤقتة).
    | تعبير.حرفي_متجه(_, العناصر) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            طابق طبق_مصدر_قيمة_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &العناصر[ف], حقائق_الملكية
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(صواب);
    }
    | تعبير.إغلاق(النطاق, المعاملات, _, الجسم) -> {
        طابق تحقق_التقاطات_إغلاق_لتدفق(
            سياق_الذاكرة, أنواع_التعبيرات, الحالة, النطاق
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        أرجع حلل_جسم_إغلاق_لتدفق(
            سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة,
            التعبير, &المعاملات, &(*الجسم), حقائق_الملكية
        );
    }
    | _ -> { };
    أرجع نتيجة.نجح(صواب);
}

// A closure body is its own function body, as rustc borrow-checks a closure
// as a separate MIR body: its parameters are owned locals of a fresh flow
// state, its captures (plain values the environment holds) are initialized
// locals, and the body's value is returned. The moves it records let
// lowering drop the parameters the body does not consume.
عرف حلل_جسم_إغلاق_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة_الخارجية: &حالة_تدفق_سلامة,
    الإغلاق: &تعبير,
    المعاملات: &متجه معامل_إغلاق,
    الجسم: &تعبير,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع نوع_الإغلاق: معرف_نوع;
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, الإغلاق) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
    | اختياري.موجود(النوع) -> { نوع_الإغلاق := النوع; };
    دع الحالة: متغير حالة_تدفق_سلامة = حالة_تدفق_سلامة_جديدة();
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(*المعاملات) مثل طبيعي)) {
        دع نطاق_المعامل: نطاق = (*المعاملات)[م].الاسم.النطاق;
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_المعامل) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
        | اختياري.موجود(الرمز) -> {
            طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_الإغلاق, م) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
            | اختياري.موجود(النوع) -> {
                دع أصول: متغير متجه أصل_استعارة = [];
                طابق تحقق_حمل_استعارة_نوع_لتدفق(سياق_الذاكرة, النوع) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(يحمل) -> {
                    لو (يحمل) { ألحق(أصول, أصل_استعارة.معامل(الرمز)); };
                };
                طابق أضف_محليا(سياق_الذاكرة, &متغير الحالة, الرمز, النوع,
                    حالة_قيمة_محلية.مهيأة(), أصول
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            };
        };
        م := م + 1;
    }
    طابق التقاطات_إغلاق_عند(أنواع_التعبيرات, نطاق_تعبير(الإغلاق)) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الالتقاطات) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الالتقاطات) مثل طبيعي)) {
            طابق محلي_عند(الحالة_الخارجية, الالتقاطات[ف]) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المحلي) -> {
                دع بلا_أصول: متجه أصل_استعارة = [];
                طابق أضف_محليا(سياق_الذاكرة, &متغير الحالة, الالتقاطات[ف], المحلي.النوع,
                    حالة_قيمة_محلية.مهيأة(), بلا_أصول
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
                // An owned capture belongs to the environment, which every
                // call of the closure shares: the body sees it as a borrowed
                // view and may not move it out.
                طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, المحلي.النوع) مع
                | نتيجة.نجح(الحقائق) -> {
                    طابق الحقائق.الصنف مع
                    | صنف_ذاكرة.مملوك -> {
                        طابق اجعل_محليا_عرضا_مستعارا(&متغير الحالة, الالتقاطات[ف]) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | _ -> { };
                }
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); };
            };
            ف := ف + 1;
        }
    };
    طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, &الحالة, الجسم) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };
    طابق تحقق_هروب_تعبير_لتدفق(الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, &الحالة, الجسم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    أرجع طبق_مصدر_قيمة_لتدفق(
        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, &متغير الحالة, الجسم, حقائق_الملكية
    );
}

عرف طبق_مصدر_قيمة_لتدفق(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &متغير حالة_تدفق_سلامة,
    التعبير: &تعبير,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق طبق_آثار_تعبير_لتدفق(
        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, التعبير, حقائق_الملكية
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    أرجع طبق_نقل_قيمة_تعبير(
        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, التعبير, حقائق_الملكية
    );
}

عرف تحقق_هروب_تعبير_لتدفق(
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    الحالة: &حالة_تدفق_سلامة,
    التعبير: &تعبير
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, التعبير) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(صواب); }
    | اختياري.موجود(النوع) -> {
        طابق تحقق_حمل_استعارة_نوع_لتدفق(سياق_الذاكرة, النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(يحمل) -> { لو (!يحمل) { أرجع نتيجة.نجح(صواب); }; };
    };

    طابق رمز_محلي_من_تعبير(الروابط, التعبير) مع
    | اختياري.موجود(الرمز) -> { أرجع تحقق_هروب_محلي(سياق_الذاكرة, الحالة, الرمز); }
    | اختياري.لا_شيء -> { };

    دع الأصول: متجه أصل_استعارة = أصول_تعبير_لتدفق(الروابط, الحالة, التعبير);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصول) مثل طبيعي)) {
        طابق الأصول[ف] مع
        | أصل_استعارة.محلي(المالك, _) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.هروب_غير_صالح(المالك)); }
        | أصل_استعارة.عبر_مرجع(المرجع) -> {
            طابق تحقق_هروب_أصول_محلي(سياق_الذاكرة, الحالة, المرجع, 16) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عرف ابن_رموز_ربط_تحقق(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    الروابط: &سياق_روابط_أسماء
): متجه رمز_ربط_نمط_محلول {
    دع الناتج: متغير متجه رمز_ربط_نمط_محلول = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التحقق).الروابط) مثل طبيعي)) {
        دع مرجع_الربط: &ربط_نمط = &(*التحقق).الروابط[ف];
        دع معرف_النمط: معرف_نمط = (*مرجع_الربط).النمط;
        طابق رمز_ربط_نمط_متحقق_عند(سجل_الأنماط, الروابط, معرف_النمط) مع
        | اختياري.موجود(الرمز) -> { دع ر: رمز_ربط_نمط_محلول = { النمط: معرف_النمط,
            الرمز: الرمز };
        ألحق(الناتج, ر); }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Whole-unit SSF orchestration consumes canonical Name/Type/Pattern facts only.
// It establishes local availability, validates uses, applies Pattern bindings and merges CFG arms.
// The flow states that leave the loop being analyzed other than by its
// condition: one per `اخرج` (break) and one per `تابع` (continue). A loop is
// analyzed again from the merge of its entry with its back edges (the end of
// its body and every continue) until its locals' value states stop changing, so
// that a move in one iteration is seen by the next; its exit state merges the
// final loop-top state with every break.
نوع مخارج_حلقة_تدفق = {
    الخروج: متجه حالة_تدفق_سلامة,
    المتابعة: متجه حالة_تدفق_سلامة
};

عرف مخارج_حلقة_تدفق_جديدة(): مخارج_حلقة_تدفق {
    دع الخروج: متجه حالة_تدفق_سلامة = [];
    دع المتابعة: متجه حالة_تدفق_سلامة = [];
    دع المخارج: مخارج_حلقة_تدفق = { الخروج: الخروج, المتابعة: المتابعة };
    أرجع المخارج;
}

// Merges every state of الحالات into الأساس.
عرف ادمج_حالات_حلقة_تدفق(
    الأساس: &متغير حالة_تدفق_سلامة,
    الحالات: &متجه حالة_تدفق_سلامة
): اختياري خطأ_تدفق_سلامة {
    // A break or continue records the state at its own site, where blocks
    // nested in the loop body may still hold locals (and the borrows those
    // locals carry, such as match bindings). Leaving those blocks ends them,
    // so each state is first closed down to the loop's own scope.
    دع عدد_محليات_الحلقة: طبيعي = الطول((*الأساس).المحليات) مثل طبيعي;
    دع مواضع_الحلقة: فهرس_مواضع_رموز_تدفق = شارك_مواضع_رموز_لتدفق(&(*الأساس).مواضع_الرموز);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحالات) مثل طبيعي)) {
        دع المغلقة: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(&(*الحالات)[ف]);
        طابق احصر_حالة_تدفق_كتلة_إلى_الدخول(&المغلقة, عدد_محليات_الحلقة, &مواضع_الحلقة) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(المرئي) -> { المغلقة := المرئي; };
        طابق ادمج_تدفقين(الأساس, &المغلقة) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(مدموج) -> { *الأساس := مدموج; };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف رتبة_قيمة_محلي_لتدفق(القيمة: &حالة_قيمة_محلية): طبيعي {
    طابق *القيمة مع
    | حالة_قيمة_محلية.غير_مهيأة -> { أرجع 0; }
    | حالة_قيمة_محلية.مهيأة -> { أرجع 1; }
    | حالة_قيمة_محلية.منقولة -> { أرجع 2; }
    | حالة_قيمة_محلية.محررة -> { أرجع 3; }
    | حالة_قيمة_محلية.ربما_غير_مهيأة -> { أرجع 4; }
    | حالة_قيمة_محلية.ربما_منقولة -> { أرجع 5; }
    | حالة_قيمة_محلية.ربما_محررة -> { أرجع 6; };
}

// Whether every local of الأولى has the same value state in الثانية.
عرف قيم_محليات_تدفق_متساوية(
    الأولى: &حالة_تدفق_سلامة,
    الثانية: &حالة_تدفق_سلامة
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الأولى).المحليات) مثل طبيعي)) {
        طابق موضع_محلي(الثانية, (*الأولى).المحليات[ف].الرمز) مع
        | اختياري.موجود(الموضع) -> {
            لو (رتبة_قيمة_محلي_لتدفق(&(*الأولى).المحليات[ف].القيمة)
                != رتبة_قيمة_محلي_لتدفق(&(*الثانية).المحليات[الموضع].القيمة)) {
                أرجع خطأ;
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ابن_كتلة_تدفق_سلامة(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سجل_الأنماط: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق,
    مخارج_الحلقة: &متغير مخارج_حلقة_تدفق
): نتيجة سقوط_كتلة_تدفق_سلامة, خطأ_تدفق_سلامة {
    أرجع ابن_عبارات_كتلة_تدفق_سلامة(
        الكتلة, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع,
        أنواع_الرموز, أنواع_التعبيرات, سجل_الأنماط, التحققات, الحالة, صواب, حقائق_الملكية, مخارج_الحلقة
    );
}

// يحصر = صواب is an ordinary lexical block: Symbols it introduces leave the
// flow state at its end. A comptime value block (إسناد_وقت_الترجمة) passes
// خطأ because its trailing result expression is checked in the same frame,
// after the statements, and must still see the block's locals.
عرف ابن_عبارات_كتلة_تدفق_سلامة(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سجل_الأنماط: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    يحصر: منطقي,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق,
    مخارج_الحلقة: &متغير مخارج_حلقة_تدفق
): نتيجة سقوط_كتلة_تدفق_سلامة, خطأ_تدفق_سلامة {
    // Lexical scopes need an entry boundary, not a second vector of all locals.
    // For comptime value blocks (يحصر = خطأ) the checkpoint stays unused.
    دع عدد_محليات_الدخول: طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    دع مواضع_الدخول: فهرس_مواضع_رموز_تدفق =
        شارك_مواضع_رموز_لتدفق(&(*الحالة).مواضع_الرموز);
    دع تسقط: متغير منطقي = صواب;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكتلة).العبارات) مثل طبيعي) && تسقط) {
        طابق *(*الكتلة).العبارات[ف] مع
        | عبارة.تصريح_متغير(_, الاسم, _) -> {
            طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
            | اختياري.موجود(الرمز) -> { طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                | اختياري.موجود(النوع) -> { دع أصول: متجه أصل_استعارة = []; طابق أضف_محليا(سياق_الذاكرة,
                    الحالة, الرمز, النوع, حالة_قيمة_محلية.غير_مهيأة(),
                        أصول) مع
        | نتيجة.خطأ(خ) -> {
            أرجع نتيجة.خطأ(خ);
        }
        | _ -> { }; }
                | _ -> { }; }
            | _ -> { };
        }
        | عبارة.نسخ(_, الوجهة, المصدر) -> {
            طابق تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الوجهة
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };

            // The value is read before the write: its uses are checked first.
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &المصدر
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };

            // The write then ends the borrowed views of the written storage.
            طابق تحقق_كتابة_عبر_مرجع_لتدفق(الروابط, الحالة, &الوجهة) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.لا_شيء -> {
                طابق جذر_موضع_محلي_لتدفق(سياق_الأسماء, الروابط, &الوجهة) مع
                | اختياري.موجود(المالك) -> {
                    طابق تحقق_تغيير_محلي(الحالة, المالك) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(_) -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.موجود(_) -> { };

            دع أصول: متغير متجه أصل_استعارة = [];
            طابق أصول_قيمة_تعبير_لتدفق(
                الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &المصدر
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(القيم) -> { أصول := القيم; };

            // A slice local initialized or assigned from a vector place views
            // it: a shared borrow of the vector's root local, not a move.
            دع عرض_شريحة: متغير منطقي = خطأ;
            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.موجود(رمز_الشريحة) -> {
                طابق محلي_عند(الحالة, رمز_الشريحة) مع
                | اختياري.موجود(محلي_الشريحة) -> {
                    طابق نوع_تعبير_لتدفق(أنواع_التعبيرات, &المصدر) مع
                    | اختياري.موجود(نوع_المصدر) -> {
                        لو (هل_عرض_متجه_كشريحة_لتدفق(الأنواع, نوع_المصدر, محلي_الشريحة.النوع)) {
                            طابق رمز_جذر_موضع_لتدفق(الروابط, &المصدر) مع
                            | اختياري.موجود(رمز_المتجه) -> {
                                طابق محلي_عند(الحالة, رمز_المتجه) مع
                                | اختياري.موجود(محلي_المتجه) -> {
                                    عرض_شريحة := صواب;
                                    أصول := أصول_استعارة_محلي(الحالة, محلي_المتجه, نوع_استعارة.مشتركة());
                                }
                                | اختياري.لا_شيء -> { };
                            }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };

            // The first initialization of an immutable local from borrowed
            // storage binds a borrowed view instead of moving out of it.
            دع هو_عرض: متغير منطقي = خطأ;
            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.موجود(رمز_الوجهة) -> {
                طابق محلي_عند(الحالة, رمز_الوجهة) مع
                | اختياري.موجود(محلي_الوجهة) -> {
                    طابق محلي_الوجهة.القيمة مع
                    | حالة_قيمة_محلية.غير_مهيأة -> {
                        لو (!نوع_محلي_متغير_لتدفق(الأنواع, محلي_الوجهة.النوع)
                            && هل_موضع_مستعار_لتدفق(الروابط, الحالة, &المصدر)) {
                            طابق يتطلب_تعبير_تحريرا_لتدفق(سياق_الذاكرة, أنواع_التعبيرات, &المصدر) مع
                            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                            | نتيجة.نجح(يتطلب) -> { هو_عرض := يتطلب; };
                        };
                    }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };

            لو (هو_عرض || عرض_شريحة) {
                طابق طبق_آثار_تعبير_لتدفق(
                    سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &المصدر, حقائق_الملكية
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
            } وإلا {
                طابق طبق_مصدر_قيمة_لتدفق(
                    سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &المصدر, حقائق_الملكية
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
            };

            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.موجود(الرمز) -> {
                طابق أسند_محليا_مع_أصول_تدفق(سياق_الذاكرة,الأنواع, الحالة, الرمز, أصول, نطاق_تعبير(&الوجهة)) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
                لو (هو_عرض) {
                    طابق ثبت_عرضا_مستعارا_لتدفق(الروابط, الحالة, الرمز, &المصدر, حقائق_الملكية) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(_) -> { };
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.تهيئة_سجل(_, الوجهة, الحقول) -> {
            طابق تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الوجهة
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            دع أصول: متغير متجه أصل_استعارة = [];
            دع ه: متغير طبيعي = 0;
            طالما (ه < (الطول(الحقول) مثل طبيعي)) {
                طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                    سياق_الأسماء, الروابط, الحالة, &الحقول[ه].القيمة
                ) مع
                | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                | اختياري.لا_شيء -> { };
                دع أصول_القيمة: متغير متجه أصل_استعارة = [];
                طابق أصول_قيمة_تعبير_لتدفق(
                    الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحقول[ه].القيمة
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(القيم) -> { أصول_القيمة := القيم; };
                دع دمج: منطقي = ادمج_أصول_تدفق_إلى(&متغير أصول, &أصول_القيمة);
                طابق طبق_مصدر_قيمة_لتدفق(
                    سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات,
                    الحالة, &الحقول[ه].القيمة, حقائق_الملكية
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
                ه := ه + 1;
            }
            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.موجود(الرمز) -> {
                طابق أسند_محليا_مع_أصول_تدفق(سياق_الذاكرة,الأنواع, الحالة, الرمز, أصول, نطاق_تعبير(&الوجهة)) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.تهيئة_صف(_, الوجهة, العناصر) -> {
            طابق تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الوجهة
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            دع أصول: متغير متجه أصل_استعارة = [];
            دع ه: متغير طبيعي = 0;
            طالما (ه < (الطول(العناصر) مثل طبيعي)) {
                طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                    سياق_الأسماء, الروابط, الحالة, &العناصر[ه]
                ) مع
                | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                | اختياري.لا_شيء -> { };
                دع أصول_القيمة: متغير متجه أصل_استعارة = [];
                طابق أصول_قيمة_تعبير_لتدفق(
                    الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &العناصر[ه]
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(القيم) -> { أصول_القيمة := القيم; };
                دع دمج: منطقي = ادمج_أصول_تدفق_إلى(&متغير أصول, &أصول_القيمة);
                طابق طبق_مصدر_قيمة_لتدفق(
                    سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات,
                    الحالة, &العناصر[ه], حقائق_الملكية
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
                ه := ه + 1;
            }
            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.موجود(الرمز) -> {
                طابق أسند_محليا_مع_أصول_تدفق(سياق_الذاكرة,الأنواع, الحالة, الرمز, أصول, نطاق_تعبير(&الوجهة)) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.تهيئة_متجه(_, الوجهة, العناصر) -> {
            طابق تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الوجهة
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            دع أصول: متغير متجه أصل_استعارة = [];
            دع ه: متغير طبيعي = 0;
            طالما (ه < (الطول(العناصر) مثل طبيعي)) {
                طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                    سياق_الأسماء, الروابط, الحالة, &العناصر[ه]
                ) مع
                | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                | اختياري.لا_شيء -> { };
                دع أصول_القيمة: متغير متجه أصل_استعارة = [];
                طابق أصول_قيمة_تعبير_لتدفق(
                    الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &العناصر[ه]
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(القيم) -> { أصول_القيمة := القيم; };
                دع دمج: منطقي = ادمج_أصول_تدفق_إلى(&متغير أصول, &أصول_القيمة);
                طابق طبق_مصدر_قيمة_لتدفق(
                    سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات,
                    الحالة, &العناصر[ه], حقائق_الملكية
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
                ه := ه + 1;
            }
            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.موجود(الرمز) -> {
                طابق أسند_محليا_مع_أصول_تدفق(سياق_الذاكرة,الأنواع, الحالة, الرمز, أصول, نطاق_تعبير(&الوجهة)) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.تهيئة_نص(_, الوجهة, _) -> {
            طابق تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الوجهة
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.موجود(الرمز) -> {
                دع أصول: متجه أصل_استعارة = [];
                طابق أسند_محليا_مع_أصول_تدفق(سياق_الذاكرة,الأنواع, الحالة, الرمز, أصول, نطاق_تعبير(&الوجهة)) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.تهيئة_صندوق(_, الوجهة, الحمولة) -> {
            طابق تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الوجهة
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الحمولة
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            دع أصول: متغير متجه أصل_استعارة = [];
            طابق أصول_قيمة_تعبير_لتدفق(
                الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحمولة
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(القيم) -> { أصول := القيم; };
            طابق طبق_مصدر_قيمة_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الحمولة, حقائق_الملكية
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.موجود(الرمز) -> {
                طابق أسند_محليا_مع_أصول_تدفق(سياق_الذاكرة,الأنواع, الحالة, الرمز, أصول, نطاق_تعبير(&الوجهة)) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.استدعاء(_, التعبير) -> {
            دع هو_تحرير: متغير منطقي = خطأ;
            طابق هوية_بدائي_استدعاء_لتدفق(سياق_الأسماء, الروابط, &التعبير) مع
            | اختياري.موجود(الهوية) -> {
                طابق الهوية مع
                | هوية_بدائي_مترجم.تحرير -> { هو_تحرير := صواب; }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
            لو (!هو_تحرير) {
                طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                    سياق_الأسماء, الروابط, الحالة, &التعبير
                ) مع
                | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                | اختياري.لا_شيء -> { };
            };
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &التعبير, حقائق_الملكية
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
        }
        | عبارة.لكل(النطاق, البداية, الشرط, الخطوة, الجسم) -> {
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(البداية) مثل طبيعي)) {
                طابق *البداية[ب] مع
                | عبارة.تصريح_متغير(_, الاسم, _) -> {
                    طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                        | اختياري.موجود(النوع) -> {
                            دع أصول: متجه أصل_استعارة = [];
                            طابق أضف_محليا(
                                سياق_الذاكرة, الحالة, الرمز, النوع,
                                حالة_قيمة_محلية.غير_مهيأة(), أصول
                            ) مع
                            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                            | نتيجة.نجح(_) -> { };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | عبارة.نسخ(_, الوجهة, المصدر) -> {
                    طابق تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
                        سياق_الأسماء, الروابط, الحالة, &الوجهة
                    ) مع
                    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | اختياري.لا_شيء -> { };
                    طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                        سياق_الأسماء, الروابط, الحالة, &المصدر
                    ) مع
                    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | اختياري.لا_شيء -> { };
                    دع أصول: متغير متجه أصل_استعارة = [];
                    طابق أصول_قيمة_تعبير_لتدفق(
                        الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &المصدر
                    ) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(القيم) -> { أصول := القيم; };
                    طابق طبق_مصدر_قيمة_لتدفق(
                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &المصدر, حقائق_الملكية
                    ) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(_) -> { };
                    طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق أسند_محليا_مع_أصول_تدفق(سياق_الذاكرة, الأنواع, الحالة, الرمز, أصول, نطاق_تعبير(&الوجهة)) مع
                        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                        | نتيجة.نجح(_) -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
                ب := ب + 1;
            }
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, الحالة, &الشرط) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            طابق طبق_آثار_تعبير_لتدفق(سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الشرط, حقائق_الملكية) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            // The loop top state starts at the entry; each pass analyzes the body
            // and the step from it and merges the back edges in, until no local's
            // value state changes (مخارج_حلقة_تدفق).
            دع القمة: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            دع المخارج: متغير مخارج_حلقة_تدفق = مخارج_حلقة_تدفق_جديدة();
            دع يعاد_التحليل: متغير منطقي = صواب;
            طالما (يعاد_التحليل) {
                يعاد_التحليل := خطأ;
                المخارج := مخارج_حلقة_تدفق_جديدة();
                دع بعد: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(&القمة);
                دع الجسم_يسقط: متغير منطقي = صواب;
                طابق ابن_كتلة_تدفق_سلامة(
                    &الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                    سجل_الأنماط, التحققات, &متغير بعد, حقائق_الملكية, &متغير المخارج
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(سقوط_الجسم) -> {
                    طابق سقوط_الجسم مع
                    | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                    | سقوط_كتلة_تدفق_سلامة.منتهية -> { الجسم_يسقط := خطأ; };
                };
                // The step runs after the body's end and after every continue.
                دع له_ذيل: متغير منطقي = الجسم_يسقط;
                لو (!الجسم_يسقط && (الطول(المخارج.المتابعة) مثل طبيعي) > 0) {
                    بعد := انسخ_حالة_تدفق_سلامة(&المخارج.المتابعة[0]);
                    له_ذيل := صواب;
                };
                لو (له_ذيل) {
                    طابق ادمج_حالات_حلقة_تدفق(&متغير بعد, &المخارج.المتابعة) مع
                    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | اختياري.لا_شيء -> { };
                    دع نسخة_الخطوة: صندوق عبارة = انسخ_مملوكا_صندوق_عبارة(&الخطوة);
                    دع قائمة_الخطوة: متجه صندوق عبارة = [نسخة_الخطوة];
                    دع كتلة_الخطوة: كتلة_عبارات = { النطاق: النطاق, العبارات: قائمة_الخطوة };
                    دع مخارج_الخطوة: متغير مخارج_حلقة_تدفق = مخارج_حلقة_تدفق_جديدة();
                    طابق ابن_كتلة_تدفق_سلامة(
                        &كتلة_الخطوة, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                        سجل_الأنماط, التحققات, &متغير بعد, حقائق_الملكية, &متغير مخارج_الخطوة
                    ) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(_) -> { };
                    // The condition runs again after the step (see the while loop).
                    طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, &بعد, &الشرط) مع
                    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | اختياري.لا_شيء -> { };
                    طابق طبق_آثار_تعبير_لتدفق(سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, &متغير بعد, &الشرط, حقائق_الملكية) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(_) -> { };
                    طابق ادمج_تدفق_حلقة(&القمة, &بعد) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(مدموج) -> {
                        يعاد_التحليل := !قيم_محليات_تدفق_متساوية(&القمة, &مدموج);
                        القمة := مدموج;
                    };
                };
            }
            طابق ادمج_حالات_حلقة_تدفق(&متغير القمة, &المخارج.الخروج) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            *الحالة := القمة;
        }
        | عبارة.اخرج_من_حلقة(_) -> {
            ألحق((*مخارج_الحلقة).الخروج, انسخ_حالة_تدفق_سلامة(الحالة));
            تسقط := خطأ;
        }
        | عبارة.تابع_حلقة(_) -> {
            ألحق((*مخارج_الحلقة).المتابعة, انسخ_حالة_تدفق_سلامة(الحالة));
            تسقط := خطأ;
        }
        | عبارة.طالما(_, الشرط, الجسم) -> {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الشرط
            ) مع
            | اختياري.موجود(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | _ -> { };
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الشرط, حقائق_الملكية
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            // The loop top state starts at the entry; each pass analyzes the body
            // from it and merges the back edges (the body's end and every
            // continue) in, until no local's value state changes. The loop may
            // run zero times, so the exit merges the final top with every break.
            دع القمة: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            دع المخارج: متغير مخارج_حلقة_تدفق = مخارج_حلقة_تدفق_جديدة();
            دع يعاد_التحليل: متغير منطقي = صواب;
            طالما (يعاد_التحليل) {
                يعاد_التحليل := خطأ;
                المخارج := مخارج_حلقة_تدفق_جديدة();
                دع بعد: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(&القمة);
                دع الجسم_يسقط: متغير منطقي = صواب;
                طابق ابن_كتلة_تدفق_سلامة(
                    &الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                    سجل_الأنماط, التحققات, &متغير بعد, حقائق_الملكية, &متغير المخارج
                ) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(سقوط_الجسم) -> {
                    طابق سقوط_الجسم مع
                    | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                    | سقوط_كتلة_تدفق_سلامة.منتهية -> {
                        الجسم_يسقط := خطأ;
                    };
                };
                دع العودة: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(&القمة);
                // The back edge is the body's end and every continue: each
                // reaches the condition again before the next iteration.
                دع له_ذيل: متغير منطقي = الجسم_يسقط;
                لو (!الجسم_يسقط && (الطول(المخارج.المتابعة) مثل طبيعي) > 0) {
                    دع مواضع_القمة: فهرس_مواضع_رموز_تدفق = شارك_مواضع_رموز_لتدفق(&القمة.مواضع_الرموز);
                    طابق احصر_حالة_تدفق_كتلة_إلى_الدخول(
                        &المخارج.المتابعة[0], الطول(القمة.المحليات) مثل طبيعي, &مواضع_القمة
                    ) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(المغلقة) -> { بعد := المغلقة; };
                    له_ذيل := صواب;
                };
                لو (له_ذيل) {
                    طابق ادمج_حالات_حلقة_تدفق(&متغير بعد, &المخارج.المتابعة) مع
                    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | اختياري.لا_شيء -> { };
                    // The condition runs again before the next iteration: check it
                    // on the back edge too (a condition that moves an owned local
                    // is a use after move on the second iteration).
                    طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(سياق_الأسماء, الروابط, &بعد, &الشرط) مع
                    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | _ -> { };
                    طابق طبق_آثار_تعبير_لتدفق(
                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, &متغير بعد, &الشرط, حقائق_الملكية
                    ) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(_) -> { };
                    طابق ادمج_تدفق_حلقة(&العودة, &بعد) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(مدموج) -> { العودة := مدموج; };
                };
                يعاد_التحليل := !قيم_محليات_تدفق_متساوية(&القمة, &العودة);
                القمة := العودة;
            }
            طابق ادمج_حالات_حلقة_تدفق(&متغير القمة, &المخارج.الخروج) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            *الحالة := القمة;
        }
        | عبارة.لو(_, الشرط, عند_الصواب, عند_الخطأ) -> {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الشرط
            ) مع
            | اختياري.موجود(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | _ -> { };
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &الشرط, حقائق_الملكية
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            دع أ: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            // The false edge of an `if` without `else` is the entry state
            // itself, which nothing mutates before the merge reads it: share
            // its descriptor and fork a private copy only for an else block.
            // Previously every `if` copied the whole local state twice.
            دع ب: متغير حالة_تدفق_سلامة = انسخ_مملوكا_حالة_تدفق_سلامة(الحالة);
            طابق عند_الخطأ مع
            | اختياري.موجود(_) -> { ب := انسخ_حالة_تدفق_سلامة(الحالة); }
            | اختياري.لا_شيء -> { };
            دع أ_تسقط: متغير منطقي = صواب;
            دع ب_تسقط: متغير منطقي = صواب;
            طابق ابن_كتلة_تدفق_سلامة(
                &عند_الصواب, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                سجل_الأنماط, التحققات, &متغير أ, حقائق_الملكية, مخارج_الحلقة
            ) مع
            | نتيجة.خطأ(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | نتيجة.نجح(سقوط_أ) -> {
                طابق سقوط_أ مع
                | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                | سقوط_كتلة_تدفق_سلامة.منتهية -> { أ_تسقط := خطأ; };
            };
            طابق عند_الخطأ مع
            | اختياري.موجود(ج) -> {
                طابق ابن_كتلة_تدفق_سلامة(
                    &ج, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                    سجل_الأنماط, التحققات, &متغير ب, حقائق_الملكية, مخارج_الحلقة
                ) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(سقوط_ب) -> {
                    طابق سقوط_ب مع
                    | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                    | سقوط_كتلة_تدفق_سلامة.منتهية -> { ب_تسقط := خطأ; };
                };
            }
            | _ -> { };

            لو (أ_تسقط && ب_تسقط) {
                طابق ادمج_تدفقين(&أ, &ب) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(مدموج) -> {
                    *الحالة := مدموج;
                };
            } وإلا لو (أ_تسقط) {
                *الحالة := أ;
            } وإلا لو (ب_تسقط) {
                *الحالة := ب;
            } وإلا {
                // Neither arm reaches the join; the enclosing block cannot fall through.
                تسقط := خطأ;
            };
        }
        | عبارة.طابق(_, المميز, الأذرع) -> {
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &المميز
            ) مع
            | اختياري.موجود(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | _ -> { };
            دع أصول_المميز: متغير متجه أصل_استعارة = [];
            طابق أصول_قيمة_تعبير_لتدفق(
                الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &المميز
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(القيم) -> { أصول_المميز := القيم; };
            طابق طبق_آثار_تعبير_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &المميز, حقائق_الملكية
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            // Bindings taken through borrowed storage are borrowed views. So
            // are bindings taken from a projection of an owned local (a field
            // or element): moving them out would be a partial move.
            // A match on a module value (or a projection of one) never moves
            // it: the program keeps owning the global. An immutable global is
            // never written, so its bindings are borrowed views. A mutable
            // global may be reassigned while the arm runs (also by a call), so
            // a binding that would own part of it is rejected.
            دع مميز_عام: متغير منطقي = خطأ;
            دع عام_متغير_للمميز: متغير اختياري معرف_رمز = اختياري.لا_شيء();
            لو (!هل_موضع_عبر_مرجع_لتدفق(&المميز)) {
                طابق رمز_جذر_موضع_لتدفق(الروابط, &المميز) مع
                | اختياري.موجود(جذر_العام) -> {
                    طابق نوع_رمز_عند(سياق_الأسماء, جذر_العام) مع
                    | اختياري.موجود(نوع_تصريح.قيمة_عليا) -> {
                        طابق نوع_رمز_دلالي_عند(أنواع_الرموز, جذر_العام) مع
                        | اختياري.موجود(نوع_العام) -> {
                            لو (نوع_محلي_متغير_لتدفق(الأنواع, نوع_العام)) {
                                عام_متغير_للمميز := اختياري.موجود(جذر_العام);
                            } وإلا {
                                مميز_عام := صواب;
                            };
                        }
                        | اختياري.لا_شيء -> { مميز_عام := صواب; };
                    }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> { };
            };
            دع مميز_مستعار: منطقي = هل_موضع_مستعار_لتدفق(الروابط, الحالة, &المميز)
                || هل_إسقاط_موضع_لتدفق(&المميز) || مميز_عام;
            // All match arms fork from the same unmodified entry. The entry
            // itself is never mutated until the final merged result is stored.
            دع الأصل: حالة_تدفق_سلامة = *الحالة;
            دع مدموج: متغير اختياري حالة_تدفق_سلامة = اختياري.لا_شيء();
            دع ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
                دع فرع: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(&الأصل);
                دع الفرع_يسقط: متغير منطقي = صواب;
                طابق معرف_نمط_ذراع_مطابقة_عند(سجل_الأنماط, &الأذرع[ذ]) مع
                | اختياري.موجود(الجذر) -> {
                    طابق فهرس_تحقق_ربط_نمط_وحدة_عند(التحققات, الجذر) مع
                    | اختياري.موجود(فهرس_التحقق) -> {
                        دع مرجع_ربط_التحقق: &ربط_تحقق_نمط_وحدة = &(*التحققات)[فهرس_التحقق];
                        دع مرجع_تحقق_الفرع: &تحقق_نمط_نوعي = &(*مرجع_ربط_التحقق).التحقق;
                        دع الرموز: متجه رمز_ربط_نمط_محلول = ابن_رموز_ربط_تحقق(
                            مرجع_تحقق_الفرع, سجل_الأنماط, الروابط
                        );
                        دع الأصول: متغير متجه أصول_ربط_نمط = [];
                        دع ب: متغير طبيعي = 0;
                        طالما (ب < (الطول((*مرجع_تحقق_الفرع).الروابط) مثل طبيعي)) {
                            دع مرجع_ربط_الفرع: &ربط_نمط = &(*مرجع_تحقق_الفرع).الروابط[ب];
                            دع معرف_نمط_الربط: معرف_نمط = (*مرجع_ربط_الفرع).النمط;
                            دع أصول_الربط: متجه أصل_استعارة = انسخ_أصول_لتدفق(&أصول_المميز);
                            دع أصل_ربط: أصول_ربط_نمط = {
                                النمط: معرف_نمط_الربط,
                                الأصول: أصول_الربط
                            };
                            ألحق(الأصول, أصل_ربط);
                            ب := ب + 1;
                        }
                        طابق طبق_روابط_نمط(سياق_الذاكرة, &متغير فرع,
                            مرجع_تحقق_الفرع, &الرموز,
                            &الأصول, مميز_مستعار, حقائق_الملكية
                        ) مع
                        | نتيجة.خطأ(خ) -> {
                            أرجع نتيجة.خطأ(خ);
                        }
                        | _ -> { };
                        لو (مميز_مستعار) {
                            دع ر: متغير طبيعي = 0;
                            طالما (ر < (الطول(الرموز) مثل طبيعي)) {
                                طابق محلي_عند(&فرع, الرموز[ر].الرمز) مع
                                | اختياري.موجود(محلي_الربط) -> {
                                    لو (محلي_الربط.عرض_مستعار) {
                                        طابق ثبت_عرضا_مستعارا_لتدفق(
                                            الروابط, &متغير فرع, الرموز[ر].الرمز, &المميز, حقائق_الملكية
                                        ) مع
                                        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                                        | نتيجة.نجح(_) -> { };
                                    };
                                }
                                | اختياري.لا_شيء -> { };
                                ر := ر + 1;
                            }
                        };
                        طابق عام_متغير_للمميز مع
                        | اختياري.موجود(جذر_العام) -> {
                            دع ر: متغير طبيعي = 0;
                            طالما (ر < (الطول(الرموز) مثل طبيعي)) {
                                طابق محلي_عند(&فرع, الرموز[ر].الرمز) مع
                                | اختياري.موجود(محلي_الربط) -> {
                                    طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, محلي_الربط.النوع) مع
                                    | نتيجة.خطأ(الخطأ) -> {
                                        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ));
                                    }
                                    | نتيجة.نجح(حقائق_الربط) -> {
                                        لو (حقائق_الربط.يتطلب_تحريرا) {
                                            أرجع نتيجة.خطأ(خطأ_نقل_من_مرجع_لتدفق(اختياري.موجود(جذر_العام), &المميز));
                                        };
                                    };
                                }
                                | اختياري.لا_شيء -> { };
                                ر := ر + 1;
                            }
                        }
                        | اختياري.لا_شيء -> { };
                        // A binding of an owning value taken from owned storage
                        // moves it out (Rust's by-move binding): the arm consumes
                        // the scrutinee's root local, which may not be used after.
                        لو (!مميز_مستعار) {
                            طابق رمز_محلي_من_تعبير(الروابط, &المميز) مع
                            | اختياري.موجود(جذر_المميز) -> {
                                دع ينقل_المميز: متغير منطقي = خطأ;
                                طابق محلي_عند(&فرع, جذر_المميز) مع
                                | اختياري.موجود(_) -> {
                                    دع ر: متغير طبيعي = 0;
                                    طالما (ر < (الطول(الرموز) مثل طبيعي)) {
                                        طابق محلي_عند(&فرع, الرموز[ر].الرمز) مع
                                        | اختياري.موجود(محلي_الربط) -> {
                                            طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, محلي_الربط.النوع) مع
                                            | نتيجة.خطأ(الخطأ) -> {
                                                أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ));
                                            }
                                            | نتيجة.نجح(حقائق_الربط) -> {
                                                لو (حقائق_الربط.يتطلب_تحريرا) { ينقل_المميز := صواب; };
                                            };
                                        }
                                        | اختياري.لا_شيء -> { };
                                        ر := ر + 1;
                                    }
                                }
                                | اختياري.لا_شيء -> { };
                                لو (ينقل_المميز) {
                                    طابق انقل_محليا(سياق_الذاكرة, &متغير فرع, جذر_المميز, نطاق_تعبير(&المميز)) مع
                                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                                    | نتيجة.نجح(_) -> { };
                                };
                            }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                }
                | _ -> { };

                طابق ابن_كتلة_تدفق_سلامة(
                    &الأذرع[ذ].الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع,
                    أنواع_الرموز, أنواع_التعبيرات, سجل_الأنماط, التحققات, &متغير فرع, حقائق_الملكية, مخارج_الحلقة
                ) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(سقوط_الفرع) -> {
                    طابق سقوط_الفرع مع
                    | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                    | سقوط_كتلة_تدفق_سلامة.منتهية -> { الفرع_يسقط := خطأ; };
                };

                // Pattern bindings belong only to this arm. Keep current facts for
                // Symbols that were already visible before entering the match.
                طابق احصر_حالة_تدفق_إلى_المرئي_عند_الدخول(&فرع, &الأصل) مع
                | نتيجة.خطأ(خ) -> {
                    أرجع نتيجة.خطأ(خ);
                }
                | نتيجة.نجح(المرئي) -> {
                    فرع := المرئي;
                };

                لو (الفرع_يسقط) {
                    طابق مدموج مع
                    | اختياري.لا_شيء -> {
                        مدموج := اختياري.موجود(فرع);
                    }
                    | اختياري.موجود(سابق) -> {
                        طابق ادمج_تدفقين(&سابق, &فرع) مع
                        | نتيجة.خطأ(خ) -> {
                            أرجع نتيجة.خطأ(خ);
                        }
                        | نتيجة.نجح(جديد) -> {
                            مدموج := اختياري.موجود(جديد);
                        };
                    };
                };
                ذ := ذ + 1;
            }
            طابق مدموج مع
            | اختياري.موجود(نهاية) -> {
                *الحالة := نهاية;
            }
            | اختياري.لا_شيء -> {
                // Exhaustiveness is owned by Pattern semantics. If no arm falls
                // through, this statement has no outgoing CFG edge.
                تسقط := خطأ;
            };
        }
        | عبارة.أرجع(_, القيمة) -> {
            طابق القيمة مع
            | اختياري.موجود(ت) -> {
                طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                    سياق_الأسماء, الروابط, الحالة, &ت
                ) مع
                | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                | اختياري.لا_شيء -> { };
                طابق تحقق_هروب_تعبير_لتدفق(
                    الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &ت
                ) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
                // `return local.field` consumes the whole owned local: the
                // field is moved out and lowering destroys the other fields.
                دع نقل_كامل: متغير منطقي = خطأ;
                طابق ت مع
                | تعبير.حقل(_, أصل_الحقل, _) -> {
                    طابق *أصل_الحقل مع
                    | تعبير.اسم(_, _) -> {
                        لو (!هل_موضع_عبر_مرجع_لتدفق(&ت)) {
                            طابق يتطلب_تعبير_تحريرا_لتدفق(سياق_الذاكرة, أنواع_التعبيرات, &ت) مع
                            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                            | نتيجة.نجح(يتطلب) -> {
                                لو (يتطلب) {
                                    طابق طبق_نقل_قيمة_تعبير(
                                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات,
                                        الحالة, &(*أصل_الحقل), حقائق_الملكية
                                    ) مع
                                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                                    | نتيجة.نجح(_) -> { نقل_كامل := صواب; };
                                };
                            };
                        };
                    }
                    | _ -> { };
                }
                | _ -> { };
                لو (!نقل_كامل) {
                    طابق طبق_مصدر_قيمة_لتدفق(
                        سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات, الحالة, &ت, حقائق_الملكية
                    ) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(_) -> { };
                };
            }
            | اختياري.لا_شيء -> { };
            تسقط := خطأ;
        }
        | عبارة.وقت_الترجمة(_, الجسم) -> {
            طابق ابن_كتلة_تدفق_سلامة(
                &الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع,
                أنواع_الرموز, أنواع_التعبيرات, سجل_الأنماط, التحققات, الحالة, حقائق_الملكية, مخارج_الحلقة
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
        }
        | عبارة.إسناد_وقت_الترجمة(_, الوجهة, الجسم, الناتج) -> {
            // The block and its result belong to an independent compile-time
            // frame: they are checked in their own state, and the destination
            // receives a fresh constant with no borrow origin.
            دع حالة_مسبقة: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
            طابق ابن_عبارات_كتلة_تدفق_سلامة(
                &الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع,
                أنواع_الرموز, أنواع_التعبيرات, سجل_الأنماط, التحققات, &متغير حالة_مسبقة, خطأ, حقائق_الملكية, مخارج_الحلقة
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            طابق تحقق_استخدامات_تعبير_لتدفق_سلامة(
                سياق_الأسماء, الروابط, &حالة_مسبقة, &الناتج
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            طابق طبق_مصدر_قيمة_لتدفق(
                سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_التعبيرات,
                &متغير حالة_مسبقة, &الناتج, حقائق_الملكية
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
            طابق تحقق_استخدامات_وجهة_كتابة_لتدفق_سلامة(
                سياق_الأسماء, الروابط, الحالة, &الوجهة
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
            طابق رمز_محلي_من_تعبير(الروابط, &الوجهة) مع
            | اختياري.موجود(الرمز) -> {
                دع بلا_أصول: متجه أصل_استعارة = [];
                طابق أسند_محليا_مع_أصول_تدفق(سياق_الذاكرة, الأنواع, الحالة, الرمز, بلا_أصول, نطاق_تعبير(&الوجهة)) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(_) -> { };
            }
            | اختياري.لا_شيء -> {
                طابق جذر_موضع_محلي_لتدفق(سياق_الأسماء, الروابط, &الوجهة) مع
                | اختياري.موجود(المالك) -> {
                    طابق تحقق_تغيير_محلي(الحالة, المالك) مع
                    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                    | نتيجة.نجح(_) -> { };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | عبارة.غير_آمن(_, الجسم) -> {
            طابق ابن_كتلة_تدفق_سلامة(
                &الجسم, سياق_الأسماء, الروابط, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
                سجل_الأنماط, التحققات, الحالة, حقائق_الملكية, مخارج_الحلقة
            ) مع
            | نتيجة.خطأ(خ) -> {
                أرجع نتيجة.خطأ(خ);
            }
            | نتيجة.نجح(سقوط_الجسم) -> {
                طابق سقوط_الجسم مع
                | سقوط_كتلة_تدفق_سلامة.مستمرة -> { }
                | سقوط_كتلة_تدفق_سلامة.منتهية -> { تسقط := خطأ; };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }

    // Drop Symbols introduced by this lexical block while preserving the latest
    // flow facts for every Symbol that was visible on entry.
    لو (يحصر) {
        طابق احصر_حالة_تدفق_كتلة_إلى_الدخول(الحالة, عدد_محليات_الدخول, &مواضع_الدخول) مع
        | نتيجة.خطأ(خ) -> {
            أرجع نتيجة.خطأ(خ);
        }
        | نتيجة.نجح(المرئي) -> {
            *الحالة := المرئي;
        };
    };

    لو (تسقط) {
        أرجع نتيجة.نجح(سقوط_كتلة_تدفق_سلامة.مستمرة());
    };
    أرجع نتيجة.نجح(سقوط_كتلة_تدفق_سلامة.منتهية());
}

// One function's flow analysis outcome.
نوع ناتج_تدفق_دالة =
    | مقبولة
    | مرفوضة_بخطأ بنوع خطأ_تدفق_سلامة
    | حقيقة_مفقودة بنوع نطاق
;

عرف حلل_دالة_تدفق_سلامة(
    الدالة: &تصريح_دالة,
    سياق_الأسماء: &سياق_أسماء,
    روابط_الوحدة: &سياق_روابط_أسماء,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات,
    سجل_الأنماط: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): ناتج_تدفق_دالة {
    دع الحالة: متغير حالة_تدفق_سلامة = حالة_تدفق_سلامة_جديدة();
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        دع نطاق_المعامل: نطاق = (*الدالة).المعاملات[م].الاسم.النطاق;
        طابق رمز_اسم_محلول_عند(روابط_الوحدة, نطاق_المعامل) مع
        | اختياري.لا_شيء -> { أرجع ناتج_تدفق_دالة.حقيقة_مفقودة(نطاق_المعامل); }
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
            | اختياري.لا_شيء -> { أرجع ناتج_تدفق_دالة.حقيقة_مفقودة(نطاق_المعامل); }
            | اختياري.موجود(النوع) -> {
                دع أصول: متغير متجه أصل_استعارة = [];
                طابق تحقق_حمل_استعارة_نوع_لتدفق(سياق_الذاكرة, النوع) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع ناتج_تدفق_دالة.مرفوضة_بخطأ(الخطأ); }
                | نتيجة.نجح(يحمل) -> {
                    لو (يحمل) { ألحق(أصول, أصل_استعارة.معامل(الرمز)); };
                };
                طابق أضف_محليا(سياق_الذاكرة, &متغير الحالة, الرمز, النوع,
                    حالة_قيمة_محلية.مهيأة(), أصول
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع ناتج_تدفق_دالة.مرفوضة_بخطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            };
        };
        م := م + 1;
    }
    // Break and continue outside every loop leave nothing to merge.
    دع مخارج_الدالة: متغير مخارج_حلقة_تدفق = مخارج_حلقة_تدفق_جديدة();
    طابق (*الدالة).الجسم مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الجسم) -> {
        طابق ابن_كتلة_تدفق_سلامة(
            &الجسم, سياق_الأسماء, روابط_الوحدة, سياق_الذاكرة, الأنواع, أنواع_الرموز,
            أنواع_تعبيرات_الوحدة, سجل_الأنماط, التحققات, &متغير الحالة, حقائق_الملكية, &متغير مخارج_الدالة
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع ناتج_تدفق_دالة.مرفوضة_بخطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
    };
    أرجع ناتج_تدفق_دالة.مقبولة();
}

// The generic Type parameter whose value a rejected move copies out of
// borrowed storage, if the moved value has exactly that parameter Type and the
// parameter is not yet bound plain.
عرف معامل_نوع_منقول_من_مرجع(
    الخطأ: &خطأ_تدفق_سلامة,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): اختياري معرف_نوع {
    طابق *الخطأ مع
    | خطأ_تدفق_سلامة.نقل_من_مرجع(السياق) -> {
        دع النوع: متغير اختياري معرف_نوع = نوع_تعبير_عند(أنواع_التعبيرات, السياق.الموضع);
        طابق السياق.الرمز مع
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
            | اختياري.موجود(نوع_الرمز) -> { النوع := اختياري.موجود(نوع_الرمز); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        طابق النوع مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> {
            طابق رمز_معامل_نوع_عند(الأنواع, المعرف) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(_) -> {
                طابق حقائق_ذاكرة_نوع_عند(سياق_الذاكرة, المعرف) مع
                | اختياري.موجود(الحقائق) -> {
                    لو (الحقائق.يتطلب_تحريرا) { أرجع اختياري.موجود(المعرف); };
                }
                | اختياري.لا_شيء -> { };
                أرجع اختياري.لا_شيء();
            };
        };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Inferred plain bounds propagate from a generic callee to the caller's Type
// parameter it is instantiated with. Returns whether a bound was added.
عرف انشر_قيود_عادية_لتدفق(
    سياق_الذاكرة: &متغير سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات
): منطقي {
    دع أضيف: متغير منطقي = خطأ;
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        دع الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الوحدة).الاستدعاءات) مثل طبيعي)) {
            دع الاستدعاء: &حقيقة_استدعاء_نوعية = &(*الوحدة).الاستدعاءات[ك];
            دع ي: متغير طبيعي = 0;
            طالما (ي < (الطول((*الاستدعاء).استبدالات_النوع) مثل طبيعي)) {
                دع المعامل: معرف_رمز = (*الاستدعاء).استبدالات_النوع[ي].المعامل;
                دع الحجة: معرف_نوع = (*الاستدعاء).استبدالات_النوع[ي].الحجة;
                لو (معامل_نوع_مقيد_عاديا(سياق_الذاكرة, الأنواع, المعامل)) {
                    طابق رمز_معامل_نوع_عند(الأنواع, الحجة) مع
                    | اختياري.موجود(_) -> {
                        لو (قيد_معامل_نوع_عاديا(سياق_الذاكرة, الحجة)) { أضيف := صواب; };
                    }
                    | اختياري.لا_شيء -> { };
                };
                ي := ي + 1;
            }
            ك := ك + 1;
        }
        و := و + 1;
    }
    أرجع أضيف;
}

عرف معامل_نوع_مقيد_عاديا(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    المعامل: معرف_رمز
): منطقي {
    طابق نوع_معامل_مسجل_عند(الأنواع, المعامل) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(نوع_المعامل) -> {
        طابق حقائق_ذاكرة_نوع_عند(سياق_الذاكرة, نوع_المعامل) مع
        | اختياري.موجود(الحقائق) -> { أرجع !الحقائق.يتطلب_تحريرا; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    };
}

// Every call that instantiates a plain-bound Type parameter with an owning Type
// would copy owned storage out of a reference inside the callee.
عرف تحقق_قيود_عادية_لتدفق(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    الأخطاء: &متغير متجه خطأ_تدفق_سلامة
): منطقي {
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        دع الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الوحدة).الاستدعاءات) مثل طبيعي)) {
            دع الاستدعاء: &حقيقة_استدعاء_نوعية = &(*الوحدة).الاستدعاءات[ك];
            دع ي: متغير طبيعي = 0;
            دع مرفوض: متغير منطقي = خطأ;
            طالما ((ي < (الطول((*الاستدعاء).استبدالات_النوع) مثل طبيعي)) && !مرفوض) {
                دع المعامل: معرف_رمز = (*الاستدعاء).استبدالات_النوع[ي].المعامل;
                دع الحجة: معرف_نوع = (*الاستدعاء).استبدالات_النوع[ي].الحجة;
                لو (معامل_نوع_مقيد_عاديا(سياق_الذاكرة, الأنواع, المعامل)) {
                    طابق حقائق_ذاكرة_نوع_عند(سياق_الذاكرة, الحجة) مع
                    | اختياري.موجود(الحقائق) -> {
                        لو (الحقائق.يتطلب_تحريرا) {
                            دع السياق: سياق_نقل_من_مرجع = {
                                الرمز: اختياري.لا_شيء(),
                                الموضع: (*الاستدعاء).النطاق
                            };
                            ألحق(*الأخطاء, خطأ_تدفق_سلامة.نقل_من_مرجع(السياق));
                            مرفوض := صواب;
                        };
                    }
                    | اختياري.لا_شيء -> { };
                };
                ي := ي + 1;
            }
            ك := ك + 1;
        }
        و := و + 1;
    }
    أرجع صواب;
}

// Immutable text module values are compile-time constants that lowering
// substitutes at every read (a fresh, static-backed text). Externs are
// linker-owned storage and are never constants.
عرف سجل_عليا_ثابتة_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): فراغ {
    دع نوع_النص: اختياري معرف_نوع = معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.نص());
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي) && و < (الطول(*الروابط) مثل طبيعي)) {
        دع العناصر: &متجه عنصر_وحدة = &(*الوحدات)[و].العناصر;
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*الروابط)[و];
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول(*العناصر) مثل طبيعي)) {
            طابق (*العناصر)[ع] مع
            | عنصر_وحدة.قيمة_عليا(التصريح) -> {
                دع ثابتة: متغير منطقي = صواب;
                طابق التصريح.التهيئة مع
                | تهيئة_قيمة_عليا.تعبير(_) -> { }
                | _ -> { ثابتة := خطأ; };
                لو (ثابتة) {
                    طابق رمز_اسم_محلول_عند(روابط_الوحدة, التصريح.الاسم.النطاق) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                        | اختياري.موجود(النوع) -> {
                            طابق نوع_النص مع
                            | اختياري.موجود(النص) -> {
                                لو (معرفا_نوع_متساويان(النوع, النص)) {
                                    سجل_عليا_ثابتة(حقائق_الملكية, الرمز);
                                };
                            }
                            | اختياري.لا_شيء -> { };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
            ع := ع + 1;
        }
        و := و + 1;
    }
}

// Generic templates are checked before substitution with every Type parameter
// owning (memory classification). A template that copies a value of exactly a
// Type parameter out of borrowed storage instead gives that parameter an
// inferred plain bound: the function is re-analyzed with the parameter plain,
// the bound propagates to generic callers, and every instantiation with an
// owning Type is rejected at the call. Rust states the same bound as `T: Copy`.
عام عرف ابن_تدفق_سلامة_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &متجه سياق_روابط_أسماء,
    سياق_الذاكرة: &متغير سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    سجل_الأنماط: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة
): نتيجة_تدفق_سلامة_وحدة {
    دع الأخطاء: متغير متجه خطأ_تدفق_سلامة = [];
    دع حقائق_الملكية: متغير حقائق_ملكية_تدفق = حقائق_ملكية_تدفق_جديدة();
    سجل_عليا_ثابتة_وحدات(الوحدات, الروابط, الأنواع, أنواع_الرموز, &متغير حقائق_الملكية);
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[و];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*الروابط)[و];
        دع أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
            طابق (*مرجع_الوحدة).العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                طابق رمز_اسم_محلول_عند(روابط_الوحدة, الدالة.الاسم.النطاق) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تدفق_سلامة_وحدة.حقيقة_دلالية_مفقودة(الدالة.الاسم.النطاق);
                }
                | اختياري.موجود(_) -> { };
                دع يعاد: متغير منطقي = صواب;
                طالما (يعاد) {
                    يعاد := خطأ;
                    طابق حلل_دالة_تدفق_سلامة(
                        &الدالة, سياق_الأسماء, روابط_الوحدة, سياق_الذاكرة, الأنواع, أنواع_الرموز,
                        أنواع_تعبيرات_الوحدة, سجل_الأنماط, التحققات, &متغير حقائق_الملكية
                    ) مع
                    | ناتج_تدفق_دالة.مقبولة -> { }
                    | ناتج_تدفق_دالة.حقيقة_مفقودة(النطاق) -> {
                        أرجع نتيجة_تدفق_سلامة_وحدة.حقيقة_دلالية_مفقودة(النطاق);
                    }
                    | ناتج_تدفق_دالة.مرفوضة_بخطأ(الخطأ) -> {
                        طابق معامل_نوع_منقول_من_مرجع(
                            &الخطأ, سياق_الذاكرة, الأنواع, أنواع_الرموز, أنواع_تعبيرات_الوحدة
                        ) مع
                        | اختياري.موجود(نوع_المعامل) -> {
                            يعاد := قيد_معامل_نوع_عاديا(سياق_الذاكرة, نوع_المعامل);
                            لو (!يعاد) { ألحق(الأخطاء, الخطأ); };
                        }
                        | اختياري.لا_شيء -> { ألحق(الأخطاء, الخطأ); };
                    };
                }
            }
            | _ -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    طالما (انشر_قيود_عادية_لتدفق(سياق_الذاكرة, الأنواع, أنواع_التعبيرات)) { }
    دع تحقق: منطقي = تحقق_قيود_عادية_لتدفق(سياق_الذاكرة, الأنواع, أنواع_التعبيرات, &متغير الأخطاء);
    لو ((الطول(الأخطاء) مثل طبيعي) > 0) {
        أرجع نتيجة_تدفق_سلامة_وحدة.مرفوضة(الأخطاء);
    };
    دع السياق: سياق_تدفق_سلامة_وحدة = { مكتمل: صواب, حقائق_الملكية: حقائق_الملكية };
    أرجع نتيجة_تدفق_سلامة_وحدة.مكتملة(السياق);
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

