استورد compiler.frontend.ssf.local_state;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.source.span;

عرف ادمج_أصل_نقل(
    الحالة: حالة_قيمة_محلية,
    اليسار: اختياري نطاق,
    اليمين: اختياري نطاق
): اختياري نطاق {
    طابق الحالة مع
    | حالة_قيمة_محلية.منقولة -> {
        طابق اليسار مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { أرجع اليمين; };
    }
    | حالة_قيمة_محلية.ربما_منقولة -> {
        طابق اليسار مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { أرجع اليمين; };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف ادمج_حالة_قيمة(
    اليسار: حالة_قيمة_محلية,
    اليمين: حالة_قيمة_محلية
): اختياري حالة_قيمة_محلية {
    طابق اليسار مع
    | حالة_قيمة_محلية.مهيأة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.مهيأة());
        }
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.منقولة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.محررة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_محررة());
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_محررة());
        };
    }
    | حالة_قيمة_محلية.غير_مهيأة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.غير_مهيأة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.منقولة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.منقولة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.منقولة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_منقولة());
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.ربما_منقولة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.منقولة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_منقولة());
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.محررة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.محررة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.محررة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_محررة());
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_محررة());
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.ربما_محررة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.محررة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_محررة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_محررة());
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع اختياري.موجود(حالة_قيمة_محلية.ربما_محررة());
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف ادمج_الأصول(
    اليسار: &متجه أصل_استعارة,
    اليمين: &متجه أصل_استعارة
): متجه أصل_استعارة {
    دع قيم_اليسار: متجه أصل_استعارة = *اليسار;
    دع قيم_اليمين: متجه أصل_استعارة = *اليمين;
    دع الناتج: متغير متجه أصل_استعارة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(قيم_اليسار) مثل طبيعي)) {
        ألحق(الناتج, قيم_اليسار[ف]);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(قيم_اليمين) مثل طبيعي)) {
        دع موجود: متغير منطقي = خطأ;
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(الناتج) مثل طبيعي)) {
            إذا (أصلان_متساويان(الناتج[ج], قيم_اليمين[ف])) {
                موجود := صواب;
            };
            ج := ج + 1;
        }
        إذا (!موجود) {
            ألحق(الناتج, قيم_اليمين[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف حاملا_استعارة_متساويان(أ: اختياري معرف_رمز, ب: اختياري معرف_رمز): منطقي {
    طابق أ مع
    | اختياري.لا_شيء -> {
        طابق ب مع
        | اختياري.لا_شيء -> { أرجع صواب; }
        | اختياري.موجود(_) -> { أرجع خطأ; };
    }
    | اختياري.موجود(رمز_أ) -> {
        طابق ب مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(رمز_ب) -> { أرجع معرفا_رمز_متساويان(رمز_أ, رمز_ب); };
    };
}

عرف استعارتان_متساويتان(أ: &استعارة_نشطة, ب: &استعارة_نشطة): منطقي {
    دع قيمة_أ: استعارة_نشطة = *أ;
    دع قيمة_ب: استعارة_نشطة = *ب;
    أرجع معرفا_رمز_متساويان(قيمة_أ.المعرف.المالك, قيمة_ب.المعرف.المالك)
        && قيمة_أ.المعرف.القيمة == قيمة_ب.المعرف.القيمة
        && معرفا_رمز_متساويان(قيمة_أ.المالك, قيمة_ب.المالك)
        && حاملا_استعارة_متساويان(قيمة_أ.الحامل, قيمة_ب.الحامل);
}

عرف مادة_استعارة_للدمج(
    القيم: &متجه استعارة_نشطة,
    الفهرس: طبيعي
): استعارة_نشطة {
    دع الحالة: متجه استعارة_نشطة = *القيم;
    دع المرجع: &استعارة_نشطة = &الحالة[الفهرس];
    أرجع انسخ_مملوكا_استعارة_نشطة(المرجع);
}

عرف ادمج_استعارات_مشتركة(
    اليسار: &متجه استعارة_نشطة,
    اليمين: &متجه استعارة_نشطة
): متجه استعارة_نشطة {
    دع قيم_اليسار: متجه استعارة_نشطة = *اليسار;
    دع قيم_اليمين: متجه استعارة_نشطة = *اليمين;
    دع الناتج: متغير متجه استعارة_نشطة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(قيم_اليسار) مثل طبيعي)) {
        ألحق(الناتج, مادة_استعارة_للدمج(&قيم_اليسار, ف));
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(قيم_اليمين) مثل طبيعي)) {
        دع موجود: متغير منطقي = خطأ;
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(الناتج) مثل طبيعي)) {
            إذا (استعارتان_متساويتان(&الناتج[ج], &قيم_اليمين[ف])) {
                موجود := صواب;
            };
            ج := ج + 1;
        }
        إذا (!موجود) {
            دع الاستعارة_للناتج: استعارة_نشطة = مادة_استعارة_للدمج(&قيم_اليمين, ف);
            ألحق(الناتج, الاستعارة_للناتج);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ادمج_حالة_استعارة(
    اليسار: حالة_استعارات_محلي,
    اليمين: حالة_استعارات_محلي
): اختياري حالة_استعارات_محلي {
    طابق اليسار مع
    | حالة_استعارات_محلي.بلا -> {
        طابق اليمين مع
        | حالة_استعارات_محلي.بلا -> {
            أرجع اختياري.موجود(حالة_استعارات_محلي.بلا());
        }
        | حالة_استعارات_محلي.مشتركة(قائمة) -> {
            أرجع اختياري.موجود(حالة_استعارات_محلي.مشتركة(قائمة));
        }
        | حالة_استعارات_محلي.حصرية(استعارة) -> {
            أرجع اختياري.موجود(حالة_استعارات_محلي.حصرية(استعارة));
        };
    }
    | حالة_استعارات_محلي.مشتركة(قائمة_أ) -> {
        طابق اليمين مع
        | حالة_استعارات_محلي.بلا -> {
            أرجع اختياري.موجود(حالة_استعارات_محلي.مشتركة(قائمة_أ));
        }
        | حالة_استعارات_محلي.مشتركة(قائمة_ب) -> {
            دع المدمجة: متجه استعارة_نشطة = ادمج_استعارات_مشتركة(&قائمة_أ, &قائمة_ب);
            أرجع اختياري.موجود(حالة_استعارات_محلي.مشتركة(المدمجة));
        }
        | حالة_استعارات_محلي.حصرية(استعارة) -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | حالة_استعارات_محلي.حصرية(استعارة_أ) -> {
        طابق اليمين مع
        | حالة_استعارات_محلي.بلا -> {
            أرجع اختياري.موجود(حالة_استعارات_محلي.حصرية(استعارة_أ));
        }
        | حالة_استعارات_محلي.مشتركة(قائمة) -> {
            أرجع اختياري.لا_شيء();
        }
        | حالة_استعارات_محلي.حصرية(استعارة_ب) -> {
            إذا (استعارتان_متساويتان(&استعارة_أ, &استعارة_ب)) {
                أرجع اختياري.موجود(حالة_استعارات_محلي.حصرية(استعارة_أ));
            };
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف استعارات_محلي_للدمج(
    الحالة: &حالة_تدفق_سلامة,
    الموضع: طبيعي
): حالة_استعارات_محلي {
    دع قيمة_الحالة: حالة_تدفق_سلامة = *الحالة;
    دع مرجع_المحلي: &حالة_محلي = &قيمة_الحالة.المحليات[الموضع];
    دع المحلي: حالة_محلي = *مرجع_المحلي;
    دع مرجع_الاستعارات: &حالة_استعارات_محلي = &المحلي.الاستعارات;
    دع الاستعارات: حالة_استعارات_محلي = انسخ_مملوكا_حالة_استعارات_محلي(مرجع_الاستعارات);
    أرجع الاستعارات;
}

عرف أصول_محلي_للدمج(
    الحالة: &حالة_تدفق_سلامة,
    المحلي: عرض_محلي_مقروء
): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < المحلي.الأصول.العدد) {
        دع الأصل: أصل_استعارة = أصل_محلي_مقروء_عند(الحالة, المحلي, ف);
        ألحق(الناتج, الأصل);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// This is the sole owner of branch/loop state merging. Consumers never merge fields independently.
عام عرف ادمج_تدفقين(
    اليسار: &حالة_تدفق_سلامة,
    اليمين: &حالة_تدفق_سلامة
): نتيجة حالة_تدفق_سلامة, خطأ_تدفق_سلامة {
    دع أ: حالة_تدفق_سلامة = *اليسار;
    دع ب: حالة_تدفق_سلامة = *اليمين;

    // A control-flow join owns only locals visible on every incoming edge. Branch-,
    // match-arm-, and loop-body-local Symbols are lexical facts and must not escape
    // merely because an analyzed branch snapshot contains them.
    دع المحليات: متغير متجه حالة_محلي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(أ.المحليات) مثل طبيعي)) {
        دع رمز_أ: معرف_رمز = أ.المحليات[ف].الرمز;
        طابق محلي_عند(&أ, رمز_أ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_دمج_تدفق(رمز_أ));
        }
        | اختياري.موجود(محلي_أ) -> {
            طابق محلي_عند(&ب, محلي_أ.الرمز) مع
            | اختياري.لا_شيء -> {
                // This Symbol was introduced only on the left incoming edge; it is
                // out of scope after the join and contributes no outgoing flow fact.
            }
            | اختياري.موجود(محلي_ب) -> {
                إذا (!معرفا_نوع_متساويان(محلي_أ.النوع, محلي_ب.النوع)) {
                    أرجع نتيجة.خطأ(خطأ_دمج_تدفق(محلي_أ.الرمز));
                };
                طابق ادمج_حالة_قيمة(محلي_أ.القيمة, محلي_ب.القيمة) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_دمج_تدفق(محلي_أ.الرمز));
                }
                | اختياري.موجود(حالة_القيمة) -> {
                    دع استعارات_أ: حالة_استعارات_محلي = استعارات_محلي_للدمج(&أ, محلي_أ.الموضع);
                    دع استعارات_ب: حالة_استعارات_محلي = استعارات_محلي_للدمج(&ب, محلي_ب.الموضع);
                    طابق ادمج_حالة_استعارة(استعارات_أ, استعارات_ب) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة.خطأ(خطأ_دمج_تدفق(محلي_أ.الرمز));
                    }
                    | اختياري.موجود(حالة_الاستعارة) -> {
                        دع أصول_أ: متجه أصل_استعارة = أصول_محلي_للدمج(&أ, محلي_أ);
                        دع أصول_ب: متجه أصل_استعارة = أصول_محلي_للدمج(&ب, محلي_ب);
                        دع الأصول: متجه أصل_استعارة = ادمج_الأصول(&أصول_أ, &أصول_ب);
                        دع أصل_النقل: اختياري نطاق = ادمج_أصل_نقل(
                            حالة_القيمة, محلي_أ.أصل_النقل, محلي_ب.أصل_النقل
                        );
                        دع المدمج: حالة_محلي = {
                            الرمز: محلي_أ.الرمز,
                            النوع: محلي_أ.النوع,
                            القيمة: حالة_القيمة,
                            أصل_النقل: أصل_النقل,
                            الاستعارات: حالة_الاستعارة,
                            الأصول: الأصول,
                            // A local that is a borrowed view on either edge stays
                            // a view: it is never destroyed and cannot be moved.
                            عرض_مستعار: محلي_أ.عرض_مستعار || محلي_ب.عرض_مستعار
                        };
                        ألحق(المحليات, المدمج);
                    };
                };
            };
        };
        ف := ف + 1;
    }

    دع التالي: متغير طبيعي = ب.معرف_الاستعارة_التالي;
    إذا (أ.معرف_الاستعارة_التالي > ب.معرف_الاستعارة_التالي) {
        التالي := أ.معرف_الاستعارة_التالي;
    };
    // Both branches originate from the same lexical mapping version. Merge only
    // mutable flow facts; keep the canonical compact SymbolID -> slot mapping.
    دع مواضع_الرموز: فهرس_مواضع_رموز_تدفق = شارك_مواضع_رموز_لتدفق(&أ.مواضع_الرموز);
    دع الناتج: حالة_تدفق_سلامة = {
        المحليات: المحليات,
        مواضع_الرموز: مواضع_الرموز,
        معرف_الاستعارة_التالي: التالي
    };
    أرجع نتيجة.نجح(الناتج);
}

// A loop may execute zero times, therefore loop exit merges entry with one analyzed body state.
// Re-analysis/fixpoint scheduling belongs to the semantic driver, not to individual state fields.
عام عرف ادمج_تدفق_حلقة(
    عند_الدخول: &حالة_تدفق_سلامة,
    بعد_الجسم: &حالة_تدفق_سلامة
): نتيجة حالة_تدفق_سلامة, خطأ_تدفق_سلامة {
    أرجع ادمج_تدفقين(عند_الدخول, بعد_الجسم);
}
