استورد compiler.frontend.ssf.local_state;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.source.scope;

عرف ادمج_أصل_نقل(
    الحالة: حالة_قيمة_محلية,
    اليسار: اختيار نطاق,
    اليمين: اختيار نطاق
): اختيار نطاق {
    طابق الحالة مع
    | حالة_قيمة_محلية.منقولة -> {
        طابق اليسار مع
        | اختيار.بعض(النطاق) -> { أرجع اختيار.بعض(النطاق); }
        | اختيار.لا_شيء -> { أرجع اليمين; };
    }
    | حالة_قيمة_محلية.ربما_منقولة -> {
        طابق اليسار مع
        | اختيار.بعض(النطاق) -> { أرجع اختيار.بعض(النطاق); }
        | اختيار.لا_شيء -> { أرجع اليمين; };
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف ادمج_حالة_قيمة(
    اليسار: حالة_قيمة_محلية,
    اليمين: حالة_قيمة_محلية
): اختيار حالة_قيمة_محلية {
    طابق اليسار مع
    | حالة_قيمة_محلية.مهيأة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.مهيأة());
        }
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.منقولة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.محررة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_محررة());
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_محررة());
        };
    }
    | حالة_قيمة_محلية.غير_مهيأة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.غير_مهيأة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_غير_مهيأة());
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.منقولة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.منقولة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.منقولة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_منقولة());
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.ربما_منقولة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.منقولة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_منقولة());
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_منقولة());
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.محررة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.محررة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.محررة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_محررة());
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_محررة());
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | حالة_قيمة_محلية.ربما_محررة -> {
        طابق اليمين مع
        | حالة_قيمة_محلية.محررة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_محررة());
        }
        | حالة_قيمة_محلية.مهيأة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_محررة());
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع اختيار.بعض(حالة_قيمة_محلية.ربما_محررة());
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}

عرف ادمج_الأصول(
    اليسار: &متجه أصل_استعارة,
    اليمين: &متجه أصل_استعارة
): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = *اليسار;
    دع قيم_اليمين: متجه أصل_استعارة = *اليمين;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(قيم_اليمين) مثل غير_موقع)) {
        دع موجود: متغير منطقي = خطأ;
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول(الناتج) مثل غير_موقع)) {
            لو (أصلان_متساويان(الناتج[ج], قيم_اليمين[ف])) {
                موجود := صواب;
            };
            ج := ج + 1;
        }
        لو (!موجود) {
            ألحق(الناتج, قيم_اليمين[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف حاملا_استعارة_متساويان(أ: اختيار معرف_رمز, ب: اختيار معرف_رمز): منطقي {
    طابق أ مع
    | اختيار.لا_شيء -> {
        طابق ب مع
        | اختيار.لا_شيء -> { أرجع صواب; }
        | اختيار.بعض(_) -> { أرجع خطأ; };
    }
    | اختيار.بعض(رمز_أ) -> {
        طابق ب مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(رمز_ب) -> { أرجع معرفا_رمز_متساويان(رمز_أ, رمز_ب); };
    };
}

عرف استعارتان_متساويتان(أ: &استعارة_نشطة, ب: &استعارة_نشطة): منطقي {
    دع قيمة_أ: استعارة_نشطة = *أ;
    دع قيمة_ب: استعارة_نشطة = *ب;
    أرجع معرفا_رمز_متساويان(قيمة_أ.المعرف.المالك, قيمة_ب.المعرف.المالك)
        && قيمة_أ.المعرف.القيمة == قيمة_ب.المعرف.القيمة
        && معرفا_رمز_متساويان(قيمة_أ.المالك, قيمة_ب.المالك)
        && حاملا_استعارة_متساويان(قيمة_أ.الحامل, قيمة_ب.الحامل);
}

عرف مادة_استعارة_للدمج(
    القيم: &متجه استعارة_نشطة,
    الفهرس: غير_موقع
): استعارة_نشطة {
    دع النسخة: متجه استعارة_نشطة = *القيم;
    دع المرجع: &استعارة_نشطة = &النسخة[الفهرس];
    دع القيمة: استعارة_نشطة = *المرجع;
    أرجع القيمة;
}

عرف ادمج_استعارات_مشتركة(
    اليسار: &متجه استعارة_نشطة,
    اليمين: &متجه استعارة_نشطة
): متجه استعارة_نشطة {
    دع الناتج: متغير متجه استعارة_نشطة = *اليسار;
    دع قيم_اليمين: متجه استعارة_نشطة = *اليمين;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(قيم_اليمين) مثل غير_موقع)) {
        دع موجود: متغير منطقي = خطأ;
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول(الناتج) مثل غير_موقع)) {
            لو (استعارتان_متساويتان(&الناتج[ج], &قيم_اليمين[ف])) {
                موجود := صواب;
            };
            ج := ج + 1;
        }
        لو (!موجود) {
            دع الاستعارة_للناتج: استعارة_نشطة = مادة_استعارة_للدمج(&قيم_اليمين, ف);
            ألحق(الناتج, الاستعارة_للناتج);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ادمج_حالة_استعارة(
    اليسار: حالة_استعارات_محلي,
    اليمين: حالة_استعارات_محلي
): اختيار حالة_استعارات_محلي {
    طابق اليسار مع
    | حالة_استعارات_محلي.بلا -> {
        طابق اليمين مع
        | حالة_استعارات_محلي.بلا -> {
            أرجع اختيار.بعض(حالة_استعارات_محلي.بلا());
        }
        | حالة_استعارات_محلي.مشتركة(قائمة) -> {
            أرجع اختيار.بعض(حالة_استعارات_محلي.مشتركة(قائمة));
        }
        | حالة_استعارات_محلي.حصرية(استعارة) -> {
            أرجع اختيار.بعض(حالة_استعارات_محلي.حصرية(استعارة));
        };
    }
    | حالة_استعارات_محلي.مشتركة(قائمة_أ) -> {
        طابق اليمين مع
        | حالة_استعارات_محلي.بلا -> {
            أرجع اختيار.بعض(حالة_استعارات_محلي.مشتركة(قائمة_أ));
        }
        | حالة_استعارات_محلي.مشتركة(قائمة_ب) -> {
            دع المدمجة: متجه استعارة_نشطة = ادمج_استعارات_مشتركة(&قائمة_أ, &قائمة_ب);
            أرجع اختيار.بعض(حالة_استعارات_محلي.مشتركة(المدمجة));
        }
        | حالة_استعارات_محلي.حصرية(استعارة) -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | حالة_استعارات_محلي.حصرية(استعارة_أ) -> {
        طابق اليمين مع
        | حالة_استعارات_محلي.بلا -> {
            أرجع اختيار.بعض(حالة_استعارات_محلي.حصرية(استعارة_أ));
        }
        | حالة_استعارات_محلي.مشتركة(قائمة) -> {
            أرجع اختيار.لا_شيء();
        }
        | حالة_استعارات_محلي.حصرية(استعارة_ب) -> {
            لو (استعارتان_متساويتان(&استعارة_أ, &استعارة_ب)) {
                أرجع اختيار.بعض(حالة_استعارات_محلي.حصرية(استعارة_أ));
            };
            أرجع اختيار.لا_شيء();
        };
    };
}

عرف استعارات_محلي_للدمج(
    الحالة: &حالة_تدفق_سلامة,
    الموضع: غير_موقع
): حالة_استعارات_محلي {
    دع القيمة: حالة_تدفق_سلامة = *الحالة;
    دع المرجع: &حالة_استعارات_محلي = &القيمة.المحليات[الموضع].الاستعارات;
    دع الاستعارات: حالة_استعارات_محلي = *المرجع;
    أرجع الاستعارات;
}

عرف أصول_محلي_للدمج(
    الحالة: &حالة_تدفق_سلامة,
    المحلي: عرض_محلي_مقروء
): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < المحلي.الأصول.العدد) {
        دع الأصل: أصل_استعارة = أصل_محلي_مقروء_عند(الحالة, المحلي, ف);
        ألحق(الناتج, الأصل);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// This is the sole owner of branch/loop state merging. Consumers never merge fields independently.
عام عرف ادمج_تدفقين(
    اليسار: &حالة_تدفق_سلامة,
    اليمين: &حالة_تدفق_سلامة
): نتيجة حالة_تدفق_سلامة, خطأ_تدفق_سلامة {
    دع أ: حالة_تدفق_سلامة = *اليسار;
    دع ب: حالة_تدفق_سلامة = *اليمين;

    // A control-flow join owns only locals visible on every incoming edge. Branch-,
    // match-arm-, and loop-body-local Symbols are lexical facts and must not escape
    // merely because an analyzed branch snapshot contains them.
    دع المحليات: متغير متجه حالة_محلي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أ.المحليات) مثل غير_موقع)) {
        دع رمز_أ: معرف_رمز = أ.المحليات[ف].الرمز;
        طابق محلي_عند(&أ, رمز_أ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_دمج_تدفق(رمز_أ));
        }
        | اختيار.بعض(محلي_أ) -> {
            طابق محلي_عند(&ب, محلي_أ.الرمز) مع
            | اختيار.لا_شيء -> {
                // This Symbol was introduced only on the left incoming edge; it is
                // out of scope after the join and contributes no outgoing flow fact.
            }
            | اختيار.بعض(محلي_ب) -> {
                لو (!معرفا_نوع_متساويان(محلي_أ.النوع, محلي_ب.النوع)) {
                    أرجع نتيجة.خطأ(خطأ_دمج_تدفق(محلي_أ.الرمز));
                };
                طابق ادمج_حالة_قيمة(محلي_أ.القيمة, محلي_ب.القيمة) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_دمج_تدفق(محلي_أ.الرمز));
                }
                | اختيار.بعض(حالة_القيمة) -> {
                    دع استعارات_أ: حالة_استعارات_محلي = استعارات_محلي_للدمج(&أ, محلي_أ.الموضع);
                    دع استعارات_ب: حالة_استعارات_محلي = استعارات_محلي_للدمج(&ب, محلي_ب.الموضع);
                    طابق ادمج_حالة_استعارة(استعارات_أ, استعارات_ب) مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة.خطأ(خطأ_دمج_تدفق(محلي_أ.الرمز));
                    }
                    | اختيار.بعض(حالة_الاستعارة) -> {
                        دع أصول_أ: متجه أصل_استعارة = أصول_محلي_للدمج(&أ, محلي_أ);
                        دع أصول_ب: متجه أصل_استعارة = أصول_محلي_للدمج(&ب, محلي_ب);
                        دع الأصول: متجه أصل_استعارة = ادمج_الأصول(&أصول_أ, &أصول_ب);
                        دع أصل_النقل: اختيار نطاق = ادمج_أصل_نقل(
                            حالة_القيمة, محلي_أ.أصل_النقل, محلي_ب.أصل_النقل
                        );
                        دع المدمج: حالة_محلي = {
                            الرمز: محلي_أ.الرمز,
                            النوع: محلي_أ.النوع,
                            القيمة: حالة_القيمة,
                            أصل_النقل: أصل_النقل,
                            الاستعارات: حالة_الاستعارة,
                            الأصول: الأصول
                        };
                        ألحق(المحليات, المدمج);
                    };
                };
            };
        };
        ف := ف + 1;
    }

    دع التالي: متغير غير_موقع = ب.معرف_الاستعارة_التالي;
    لو (أ.معرف_الاستعارة_التالي > ب.معرف_الاستعارة_التالي) {
        التالي := أ.معرف_الاستعارة_التالي;
    };
    دع الناتج: حالة_تدفق_سلامة = {
        المحليات: المحليات,
        معرف_الاستعارة_التالي: التالي
    };
    أرجع نتيجة.نجح(الناتج);
}

// A loop may execute zero times, therefore loop exit merges entry with one analyzed body state.
// Re-analysis/fixpoint scheduling belongs to the semantic driver, not to individual state fields.
عام عرف ادمج_تدفق_حلقة(
    عند_الدخول: &حالة_تدفق_سلامة,
    بعد_الجسم: &حالة_تدفق_سلامة
): نتيجة حالة_تدفق_سلامة, خطأ_تدفق_سلامة {
    أرجع ادمج_تدفقين(عند_الدخول, بعد_الجسم);
}
