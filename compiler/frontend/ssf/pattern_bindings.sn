استورد compiler.frontend.ssf.local_state;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.memory.semantic_pipeline;
استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.type_validation;
استورد compiler.frontend.types.type_model;

استورد compiler.frontend.types.type_context;
// Name resolution supplies the Symbol ID for each Pattern-owned binding node.
// SSF consumes this resolved association and never performs name lookup itself.
عام نوع رمز_ربط_نمط_محلول = {
    النمط: معرف_نمط,
    الرمز: معرف_رمز
};

// Provenance is optional flow input for a binding produced from a borrowed/view source.
// Pattern still owns which bindings exist; SSF owns the resulting flow state.
عام نوع أصول_ربط_نمط = {
    النمط: معرف_نمط,
    الأصول: متجه أصل_استعارة
};

عرف رمز_للنمط(
    الرموز: &متجه رمز_ربط_نمط_محلول,
    النمط: معرف_نمط
): اختيار معرف_رمز {
    دع القيم: متجه رمز_ربط_نمط_محلول = *الرموز;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (معرفا_نمط_متساويان(القيم[ف].النمط, النمط)) {
            أرجع اختيار.بعض(القيم[ف].الرمز);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف نوع_للنمط(
    الأنواع: &متجه نوع_عقدة_نمط,
    النمط: معرف_نمط
): اختيار معرف_نوع {
    دع القيم: متجه نوع_عقدة_نمط = *الأنواع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (معرفا_نمط_متساويان(القيم[ف].النمط, النمط)) {
            أرجع اختيار.بعض(القيم[ف].النوع);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أصول_للنمط(
    الأصول: &متجه أصول_ربط_نمط,
    النمط: معرف_نمط
): متجه أصل_استعارة {
    دع القيم: متجه أصول_ربط_نمط = *الأصول;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (معرفا_نمط_متساويان(القيم[ف].النمط, النمط)) {
            دع الناتج: متغير متجه أصل_استعارة = [];
            دع ح: متغير غير_موقع = 0;
            بينما (ح < (الطول(القيم[ف].الأصول) مثل غير_موقع)) {
                ألحق(الناتج, القيم[ف].الأصول[ح]);
                ح := ح + 1;
            }
            أرجع الناتج;
        };
        ف := ف + 1;
    }
    دع فارغة: متجه أصل_استعارة = [];
    أرجع فارغة;
}

// Consume Pattern's already-validated binding list. No AST or Pattern tree traversal occurs here.
عام عرف طبق_روابط_نمط(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    التحقق: &تحقق_نمط_نوعي,
    الرموز: &متجه رمز_ربط_نمط_محلول,
    أصول_الروابط: &متجه أصول_ربط_نمط
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع القيمة: تحقق_نمط_نوعي = *التحقق;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.الروابط) مثل غير_موقع)) {
        دع الربط: ربط_نمط = القيمة.الروابط[ف];
        طابق رمز_للنمط(الرموز, الربط.النمط) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_ربط_نمط_بلا_رمز_للتدفق(الربط.النمط));
        }
        | اختيار.بعض(الرمز) -> {
            طابق نوع_للنمط(&القيمة.أنواع_العقد, الربط.النمط) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_ربط_نمط_بلا_نوع_للتدفق(الربط.النمط));
            }
            | اختيار.بعض(النوع) -> {
                دع الأصول: متجه أصل_استعارة = أصول_للنمط(أصول_الروابط, الربط.النمط);
                طابق أضف_محليا(
                    سياق_الذاكرة,
                    الحالة,
                    الرمز,
                    النوع,
                    حالة_قيمة_محلية.مهيأة(),
                    الأصول
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع نتيجة.خطأ(الخطأ);
                }
                | نتيجة.نجح(صالح) -> {
                };
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}
