استورد compiler.frontend.ssf.local_state;
استورد compiler.frontend.ssf.ownership_facts;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.memory.semantic_pipeline;
استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.type_validation;
استورد compiler.frontend.types.type_model;

استورد compiler.frontend.types.type_context;
// Name resolution supplies the Symbol ID for each Pattern-owned binding node.
// SSF consumes this resolved association and never performs name lookup itself.
عام نوع رمز_ربط_نمط_محلول = {
    النمط: معرف_نمط,
    الرمز: معرف_رمز
};

// Provenance is optional flow input for a binding produced from a borrowed/view source.
// Pattern still owns which bindings exist; SSF owns the resulting flow state.
عام نوع أصول_ربط_نمط = {
    النمط: معرف_نمط,
    الأصول: متجه أصل_استعارة
};

عرف رمز_للنمط(
    الرموز: &متجه رمز_ربط_نمط_محلول,
    النمط: معرف_نمط
): اختياري معرف_رمز {
    دع القيم: متجه رمز_ربط_نمط_محلول = *الرموز;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        إذا (معرفا_نمط_متساويان(القيم[ف].النمط, النمط)) {
            أرجع اختياري.موجود(القيم[ف].الرمز);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف نوع_للنمط(
    الأنواع: &متجه نوع_عقدة_نمط,
    النمط: معرف_نمط
): اختياري معرف_نوع {
    دع القيم: متجه نوع_عقدة_نمط = *الأنواع;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        إذا (معرفا_نمط_متساويان(القيم[ف].النمط, النمط)) {
            أرجع اختياري.موجود(القيم[ف].النوع);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أصول_للنمط(
    الأصول: &متجه أصول_ربط_نمط,
    النمط: معرف_نمط
): متجه أصل_استعارة {
    دع القيم: متجه أصول_ربط_نمط = *الأصول;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        دع مرجع_الربط: &أصول_ربط_نمط = &القيم[ف];
        دع الربط: أصول_ربط_نمط = *مرجع_الربط;
        إذا (معرفا_نمط_متساويان(الربط.النمط, النمط)) {
            دع مرجع_الأصول: &متجه أصل_استعارة = &الربط.الأصول;
            دع قيم_الأصول: متجه أصل_استعارة = *مرجع_الأصول;
            دع الناتج: متغير متجه أصل_استعارة = [];
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول(قيم_الأصول) مثل طبيعي)) {
                ألحق(الناتج, قيم_الأصول[ح]);
                ح := ح + 1;
            }
            أرجع الناتج;
        };
        ف := ف + 1;
    }
    دع فارغة: متجه أصل_استعارة = [];
    أرجع فارغة;
}

// Consume Pattern's already-validated binding list. No AST or Pattern tree traversal occurs here.
// عبر_مرجع: the scrutinee is borrowed storage, so every binding of an owning
// Type is a borrowed view of the scrutinee (Rust's default `ref` binding mode),
// not a move out of it.
عام عرف طبق_روابط_نمط(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    التحقق: &تحقق_نمط_نوعي,
    الرموز: &متجه رمز_ربط_نمط_محلول,
    أصول_الروابط: &متجه أصول_ربط_نمط,
    عبر_مرجع: منطقي,
    حقائق_الملكية: &متغير حقائق_ملكية_تدفق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    دع قيمة_التحقق: تحقق_نمط_نوعي = *التحقق;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(قيمة_التحقق.الروابط) مثل طبيعي)) {
        دع الربط: ربط_نمط = قيمة_التحقق.الروابط[ف];
        طابق رمز_للنمط(الرموز, الربط.النمط) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_ربط_نمط_بلا_رمز_للتدفق(الربط.النمط));
        }
        | اختياري.موجود(الرمز) -> {
            طابق نوع_للنمط(&قيمة_التحقق.أنواع_العقد, الربط.النمط) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_ربط_نمط_بلا_نوع_للتدفق(الربط.النمط));
            }
            | اختياري.موجود(النوع) -> {
                دع الأصول: متجه أصل_استعارة = أصول_للنمط(أصول_الروابط, الربط.النمط);
                طابق أضف_محليا(
                    سياق_الذاكرة,
                    الحالة,
                    الرمز,
                    النوع,
                    حالة_قيمة_محلية.مهيأة(),
                    الأصول
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع نتيجة.خطأ(الخطأ);
                }
                | نتيجة.نجح(صالح) -> {
                };
                إذا (عبر_مرجع) {
                    طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ)); }
                    | نتيجة.نجح(الحقائق) -> {
                        إذا (الحقائق.يتطلب_تحريرا) {
                            طابق اجعل_محليا_عرضا_مستعارا(الحالة, الرمز) مع
                            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                            | نتيجة.نجح(_) -> { };
                            سجل_عرض_ملكية(حقائق_الملكية, الرمز);
                        };
                    };
                };
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}
