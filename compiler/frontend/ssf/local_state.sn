}

عام عرف انسخ_مملوكا_استعارة_نشطة(القيمة: &استعارة_نشطة): استعارة_نشطة {
    دع الناتج: استعارة_نشطة = {
        المعرف: (*القيمة).المعرف,
        المالك: (*القيمة).المالك,
        الحامل: (*القيمة).الحامل,
        النوع: (*القيمة).النوع,
        الأصول: انسخ_مملوكا_متجه_أصل_استعارة(&(*القيمة).الأصول)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_أصل_استعارة(القيمة: &متجه أصل_استعارة): متجه أصل_استعارة {
    دع الناتج: متغير متجه أصل_استعارة = [];
    دع ف: متغير طبيعي = 0;
