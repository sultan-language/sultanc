عام عرف انسخ_مملوكا_حالة_تدفق_سلامة(القيمة: &حالة_تدفق_سلامة): حالة_تدفق_سلامة {
    دع الناتج: حالة_تدفق_سلامة = {
        المحليات: انسخ_مملوكا_متجه_حالة_محلي(&(*القيمة).المحليات),
        مواضع_الرموز: انسخ_مملوكا_فهرس_مواضع_رموز_تدفق(&(*القيمة).مواضع_الرموز),
        معرف_الاستعارة_التالي: (*القيمة).معرف_الاستعارة_التالي
    };
