استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.compatibility;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.memory.memory_model;
استورد compiler.frontend.memory.semantic_pipeline;
استورد compiler.frontend.pattern.pattern_model;
استورد compiler.source.span;

استورد compiler.frontend.types.type_context;
// SSF owns only flow-sensitive availability. Static ownership class remains Memory-owned.
عام نوع حالة_قيمة_محلية =
    | غير_مهيأة
    | مهيأة
    | منقولة
    | محررة
    | ربما_غير_مهيأة
    | ربما_منقولة
    | ربما_محررة
;

عام نوع معرف_استعارة = {
    المالك: معرف_رمز,
    القيمة: طبيعي
};

عام عرف معرف_استعارة_من(المالك: معرف_رمز, القيمة: طبيعي): معرف_استعارة {
    دع المعرف: معرف_استعارة = { المالك: المالك, القيمة: القيمة };
    أرجع المعرف;
}

عام نوع نوع_استعارة =
    | مشتركة
    | حصرية
;

عرف نوعا_استعارة_متساويان(أ: نوع_استعارة, ب: نوع_استعارة): منطقي {
    طابق أ مع
    | نوع_استعارة.مشتركة -> {
        طابق ب مع
        | نوع_استعارة.مشتركة -> { أرجع صواب; }
        | نوع_استعارة.حصرية -> { أرجع خطأ; };
    }
    | نوع_استعارة.حصرية -> {
        طابق ب مع
        | نوع_استعارة.مشتركة -> { أرجع خطأ; }
        | نوع_استعارة.حصرية -> { أرجع صواب; };
    };
}

// Provenance records the storage root and, for a local root, the exact borrow
// mode carried by that view. This lets aggregates transfer mutable/shared view
// facts without reconstructing their fields or inventing a second state machine.
// `عبر_مرجع` names a reference local whose referent the value reads (`&(*r).f`):
// the value holds a shared borrow of that reference local, and it lives as long
// as the reference's own origins allow.
عام نوع أصل_استعارة =
    | محلي بنوع (معرف_رمز, نوع_استعارة)
    | معامل بنوع معرف_رمز
    | خارجي
    | عبر_مرجع بنوع معرف_رمز
;

عام عرف أصلان_متساويان(أ: أصل_استعارة, ب: أصل_استعارة): منطقي {
    طابق أ مع
    | أصل_استعارة.محلي(رمز_أ, نوع_أ) -> {
        طابق ب مع
        | أصل_استعارة.محلي(رمز_ب, نوع_ب) -> {
            أرجع معرفا_رمز_متساويان(رمز_أ, رمز_ب)
                && نوعا_استعارة_متساويان(نوع_أ, نوع_ب);
        }
        | _ -> { أرجع خطأ; };
    }
    | أصل_استعارة.معامل(رمز_أ) -> {
        طابق ب مع
        | أصل_استعارة.معامل(رمز_ب) -> {
            أرجع معرفا_رمز_متساويان(رمز_أ, رمز_ب);
        }
        | _ -> { أرجع خطأ; };
    }
    | أصل_استعارة.خارجي -> {
        طابق ب مع
        | أصل_استعارة.خارجي -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | أصل_استعارة.عبر_مرجع(رمز_أ) -> {
        طابق ب مع
        | أصل_استعارة.عبر_مرجع(رمز_ب) -> { أرجع معرفا_رمز_متساويان(رمز_أ, رمز_ب); }
        | _ -> { أرجع خطأ; };
    };
}

عام نوع استعارة_نشطة = {
    المعرف: معرف_استعارة,
    المالك: معرف_رمز,
    الحامل: اختياري معرف_رمز,
    النوع: نوع_استعارة,
    الأصول: متجه أصل_استعارة
};

// A local permits either many shared borrows or exactly one exclusive borrow.
عام نوع حالة_استعارات_محلي =
    | بلا
    | مشتركة بنوع متجه استعارة_نشطة
    | حصرية بنوع استعارة_نشطة
;

// Type ID is a reference to Type-owned semantics. No Memory classification is cached here.
// عرض_مستعار: the local is a borrowed view of a place behind a reference (an
// immutable binding initialized from a dereference, or a pattern binding taken
// through a reference). It owns nothing: it is never destroyed, and moving it
// out is a move out of borrowed storage (see docs/en/reference/ownership.md).
عام نوع حالة_محلي = {
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: حالة_قيمة_محلية,
    أصل_النقل: اختياري نطاق,
    الاستعارات: حالة_استعارات_محلي,
    الأصول: متجه أصل_استعارة,
    عرض_مستعار: منطقي
};

عام نوع ربط_موضع_رمز_تدفق = {
    الرمز: معرف_رمز,
    الموضع: طبيعي
};

// Compact SymbolID -> local-slot index: one flat run, sorted ascending by
// SymbolID. The binary-carry, multi-level layout this replaced was built to
// let snapshots alias old runs instead of copying them; single ownership
// forbids that alias once destruction actually releases a run (two owners of
// one buffer means a double-free), so شارك_مواضع_رموز_لتدفق has always had to
// deep-copy regardless of layout. A flat run gets the same O(n) copy cost in
// one allocation instead of across O(log n) separate level buffers (and
// without the carry-merge bookkeeping), which is strictly less to allocate
// and copy for the same content.
عام نوع فهرس_مواضع_رموز_تدفق = {
    المواضع: متجه ربط_موضع_رمز_تدفق
};

عام نوع حالة_تدفق_سلامة = {
    المحليات: متجه حالة_محلي,
    مواضع_الرموز: فهرس_مواضع_رموز_تدفق,
    معرف_الاستعارة_التالي: طبيعي
};

// A move whose source is borrowed storage: a dereference, a projection through a
// reference, or a borrowed-view local. الرمز is the view local when there is one.
عام نوع سياق_نقل_من_مرجع = {
    الرمز: اختياري معرف_رمز,
    الموضع: نطاق
};

عام نوع سياق_استخدام_بعد_النقل = {
    الرمز: معرف_رمز,
    أصل_النقل: اختياري نطاق,
    الاستخدام: اختياري نطاق
};

عام نوع خطأ_تدفق_سلامة =
    | محلي_مفقود بنوع معرف_رمز
    | محلي_مكرر بنوع معرف_رمز
    | نوع_محلي_غير_صالح بنوع (معرف_رمز, معرف_نوع)
    // The local and, when known, the assignment that writes it.
    | إسناد_إلى_غير_متغير بنوع (معرف_رمز, اختياري نطاق)
    | استخدام_قبل_التهيئة بنوع معرف_رمز
    | استخدام_بعد_النقل بنوع سياق_استخدام_بعد_النقل
    | استخدام_بعد_التحرير بنوع معرف_رمز
    | نقل_غير_صالح بنوع معرف_رمز
    | نقل_من_مرجع بنوع سياق_نقل_من_مرجع
    | تحرير_مكرر بنوع معرف_رمز
    // The value and, when known, the release that names it.
    | تحرير_غير_مملوك بنوع (معرف_رمز, اختياري نطاق)
    | تعارض_استعارة بنوع (معرف_رمز, نوع_استعارة)
    | معرف_استعارة_غير_صالح بنوع معرف_استعارة
    | دمج_غير_صالح بنوع معرف_رمز
    | هروب_غير_صالح بنوع معرف_رمز
    | ربط_نمط_بلا_رمز بنوع معرف_نمط
    | ربط_نمط_بلا_نوع بنوع معرف_نمط
    | خطأ_ذاكرة بنوع خطأ_ذاكرة_نوع
;

عام عرف خطأ_دمج_تدفق(الرمز: معرف_رمز): خطأ_تدفق_سلامة {
    أرجع خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز);
}

عام عرف خطأ_ربط_نمط_بلا_رمز_للتدفق(النمط: معرف_نمط): خطأ_تدفق_سلامة {
    أرجع خطأ_تدفق_سلامة.ربط_نمط_بلا_رمز(النمط);
}

عام عرف خطأ_ربط_نمط_بلا_نوع_للتدفق(النمط: معرف_نمط): خطأ_تدفق_سلامة {
    أرجع خطأ_تدفق_سلامة.ربط_نمط_بلا_نوع(النمط);
}

عام عرف حالة_تدفق_سلامة_جديدة(): حالة_تدفق_سلامة {
    دع المحليات: متجه حالة_محلي = [];
    دع المواضع: متجه ربط_موضع_رمز_تدفق = [];
    دع مواضع_الرموز: فهرس_مواضع_رموز_تدفق = { المواضع: المواضع };
    دع الحالة: حالة_تدفق_سلامة = {
        المحليات: المحليات,
        مواضع_الرموز: مواضع_الرموز,
        معرف_الاستعارة_التالي: 0
    };
    أرجع الحالة;
}

عام عرف شارك_مواضع_رموز_لتدفق(
    المصدر: &فهرس_مواضع_رموز_تدفق
): فهرس_مواضع_رموز_تدفق {
    أرجع انسخ_مملوكا_فهرس_مواضع_رموز_تدفق(المصدر);
}

عرف أضف_موضع_رمز_لتدفق(
    المصدر: &فهرس_مواضع_رموز_تدفق,
    الرمز: معرف_رمز,
    الموضع: طبيعي
): فهرس_مواضع_رموز_تدفق {
    // One binary search for the insertion point, then one copy of the run
    // with the new binding spliced in at its sorted position.
    دع العدد: طبيعي = الطول((*المصدر).المواضع) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = العدد;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        إذا ((*المصدر).المواضع[الوسط].الرمز.القيمة < الرمز.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    دع المواضع: متغير متجه ربط_موضع_رمز_تدفق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < البداية) {
        ألحق(المواضع, (*المصدر).المواضع[ف]);
        ف := ف + 1;
    }
    دع الجديد: ربط_موضع_رمز_تدفق = { الرمز: الرمز, الموضع: الموضع };
    ألحق(المواضع, الجديد);
    طالما (ف < العدد) {
        ألحق(المواضع, (*المصدر).المواضع[ف]);
        ف := ف + 1;
    }
    دع الناتج: فهرس_مواضع_رموز_تدفق = { المواضع: المواضع };
    أرجع الناتج;
}

// Reuse the canonical immutable SymbolID index for both live-state lookups and
// lexical-scope checkpoints; a lookup must not copy the local-state vector.
عرف موضع_رمز_في_طبقات_تدفق(
    المواضع: &فهرس_مواضع_رموز_تدفق,
    الرمز: معرف_رمز
): اختياري طبيعي {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول((*المواضع).المواضع) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        دع الموجود: معرف_رمز = (*المواضع).المواضع[الوسط].الرمز;
        إذا (الموجود.القيمة == الرمز.القيمة) {
            أرجع اختياري.موجود((*المواضع).المواضع[الوسط].الموضع);
        };
        إذا (الموجود.القيمة < الرمز.القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع اختياري.لا_شيء();
}

عام عرف موضع_محلي(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): اختياري طبيعي {
    أرجع موضع_رمز_في_طبقات_تدفق(&(*الحالة).مواضع_الرموز, الرمز);
}

عام نوع حالة_استعارات_محلي_مقروء =
    | بلا
    | مشتركة
    | حصرية
;

عام نوع أصول_محلي_مقروء = {
    العدد: طبيعي
};

عام نوع عرض_محلي_مقروء = {
    الموضع: طبيعي,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: حالة_قيمة_محلية,
    أصل_النقل: اختياري نطاق,
    الاستعارات: حالة_استعارات_محلي_مقروء,
    الأصول: أصول_محلي_مقروء,
    عرض_مستعار: منطقي
};

عرف صنف_استعارات_محلي_مقروء(الاستعارات: &حالة_استعارات_محلي): حالة_استعارات_محلي_مقروء {
    طابق *الاستعارات مع
    | حالة_استعارات_محلي.بلا -> {
        أرجع حالة_استعارات_محلي_مقروء.بلا();
    }
    | حالة_استعارات_محلي.مشتركة(_) -> {
        أرجع حالة_استعارات_محلي_مقروء.مشتركة();
    }
    | حالة_استعارات_محلي.حصرية(_) -> {
        أرجع حالة_استعارات_محلي_مقروء.حصرية();
    };
}

عام عرف محلي_عند(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): اختياري عرض_محلي_مقروء {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الفهرس) -> {
        دع قيمة_الحالة: حالة_تدفق_سلامة = *الحالة;
        دع مرجع_المحلي: &حالة_محلي = &قيمة_الحالة.المحليات[الفهرس];
        دع المحلي: حالة_محلي = *مرجع_المحلي;
        دع مرجع_الاستعارات: &حالة_استعارات_محلي = &المحلي.الاستعارات;
        دع صنف_الاستعارات: حالة_استعارات_محلي_مقروء = صنف_استعارات_محلي_مقروء(مرجع_الاستعارات);
        دع عدد_الأصول: طبيعي = الطول(المحلي.الأصول) مثل طبيعي;
        دع عرض_الأصول: أصول_محلي_مقروء = {
            العدد: عدد_الأصول
        };
        دع العرض: عرض_محلي_مقروء = {
            الموضع: الفهرس,
            الرمز: المحلي.الرمز,
            النوع: المحلي.النوع,
            القيمة: المحلي.القيمة,
            أصل_النقل: المحلي.أصل_النقل,
            الاستعارات: صنف_الاستعارات,
            الأصول: عرض_الأصول,
            عرض_مستعار: المحلي.عرض_مستعار
        };
        أرجع اختياري.موجود(العرض);
    };
}

عام عرف أصل_محلي_مقروء_عند(
    الحالة: &حالة_تدفق_سلامة,
    المحلي: عرض_محلي_مقروء,
    الفهرس: طبيعي
): أصل_استعارة {
    دع قيمة_الحالة: حالة_تدفق_سلامة = *الحالة;
    دع مرجع_المحلي: &حالة_محلي = &قيمة_الحالة.المحليات[المحلي.الموضع];
    دع قيمة_المحلي: حالة_محلي = *مرجع_المحلي;
    أرجع قيمة_المحلي.الأصول[الفهرس];
}

عرف له_استعارة_نشطة(المحلي: &حالة_محلي): منطقي {
    دع القيمة: حالة_محلي = *المحلي;
    طابق القيمة.الاستعارات مع
    | حالة_استعارات_محلي.بلا -> {
        أرجع خطأ;
    }
    | حالة_استعارات_محلي.مشتركة(الاستعارات) -> {
        أرجع (الطول(الاستعارات) مثل طبيعي) > 0;
    }
    | حالة_استعارات_محلي.حصرية(الاستعارة) -> {
        أرجع صواب;
    };
}

عرف انسخ_قيمة_محلي_لتدفق(المحلي: &حالة_محلي): حالة_محلي {
    أرجع انسخ_مملوكا_حالة_محلي(المحلي);
}

عام عرف أضف_محليا(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: حالة_قيمة_محلية,
    الأصول: متجه أصل_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.موجود(الفهرس) -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مكرر(الرمز));
    }
    | اختياري.لا_شيء -> {
    };

    طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ));
    }
    | نتيجة.نجح(_) -> {
    };

    دع حالة_الاستعارات: حالة_استعارات_محلي = حالة_استعارات_محلي.بلا();
    دع بلا_أصل_نقل: اختياري نطاق = اختياري.لا_شيء();
    دع المحلي: حالة_محلي = {
        الرمز: الرمز,
        النوع: النوع,
        القيمة: القيمة,
        أصل_النقل: بلا_أصل_نقل,
        الاستعارات: حالة_الاستعارات,
        الأصول: الأصول,
        عرض_مستعار: خطأ
    };
    دع الموضع: طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    ألحق((*الحالة).المحليات, المحلي);
    (*الحالة).مواضع_الرموز := أضف_موضع_رمز_لتدفق(
        &(*الحالة).مواضع_الرموز, الرمز, الموضع
    );
    أرجع نتيجة.نجح(صواب);
}

// The carriers of every borrow currently held on الرمز.
عام عرف حوامل_استعارات_محلي(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): متجه اختياري معرف_رمز {
    دع الناتج: متغير متجه اختياري معرف_رمز = [];
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الفهرس) -> {
        طابق (*الحالة).المحليات[الفهرس].الاستعارات مع
        | حالة_استعارات_محلي.بلا -> { }
        | حالة_استعارات_محلي.مشتركة(القائمة) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(القائمة) مثل طبيعي)) {
                ألحق(الناتج, القائمة[ف].الحامل);
                ف := ف + 1;
            }
        }
        | حالة_استعارات_محلي.حصرية(الاستعارة) -> { ألحق(الناتج, الاستعارة.الحامل); };
    };
    أرجع الناتج;
}

// Ends a borrowed view because the storage it reads was written: the view is
// no longer usable (a later use reports use after move at النطاق), like a
// Rust reference whose borrow ends at the conflicting write (NLL).
عام عرف أنه_عرضا_مستعارا(
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    النطاق: نطاق
): منطقي {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الفهرس) -> {
        إذا (!(*الحالة).المحليات[الفهرس].عرض_مستعار) { أرجع خطأ; };
        (*الحالة).المحليات[الفهرس].القيمة := حالة_قيمة_محلية.منقولة();
        (*الحالة).المحليات[الفهرس].أصل_النقل := اختياري.موجود(النطاق);
    };
    دع أنهى: منطقي = انه_استعارات_حامل(الحالة, الرمز);
    أرجع صواب;
}

// Ends a reference that reads through a reference local because the storage
// behind that reference was written or mutably reborrowed (NLL-style): a later
// use of the holder reports use after move at النطاق. False when the holder is
// not a local of this function.
عام عرف أنه_حامل_استعارة_مرجع(
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    النطاق: نطاق
): منطقي {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الفهرس) -> {
        (*الحالة).المحليات[الفهرس].القيمة := حالة_قيمة_محلية.منقولة();
        (*الحالة).المحليات[الفهرس].أصل_النقل := اختياري.موجود(النطاق);
    };
    دع أنهى: منطقي = انه_استعارات_حامل(الحالة, الرمز);
    أرجع صواب;
}

// Marks an initialized local as a borrowed view (see حالة_محلي.عرض_مستعار).
عام عرف اجعل_محليا_عرضا_مستعارا(
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز)); }
    | اختياري.موجود(الفهرس) -> {
        (*الحالة).المحليات[الفهرس].عرض_مستعار := صواب;
        أرجع نتيجة.نجح(صواب);
    };
}

عام عرف تحقق_استخدام_محلي_عند(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الاستخدام: اختياري نطاق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق محلي_عند(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختياري.موجود(المحلي) -> {
        طابق المحلي.القيمة مع
        | حالة_قيمة_محلية.مهيأة -> {
            طابق المحلي.الاستعارات مع
            | حالة_استعارات_محلي_مقروء.حصرية -> {
                أرجع نتيجة.خطأ(
                    خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.مشتركة())
                );
            }
            | _ -> {
                أرجع نتيجة.نجح(صواب);
            };
        }
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز));
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز));
        }
        | حالة_قيمة_محلية.منقولة -> {
            دع السياق: سياق_استخدام_بعد_النقل = {
                الرمز: الرمز,
                أصل_النقل: المحلي.أصل_النقل,
                الاستخدام: الاستخدام
            };
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            دع السياق: سياق_استخدام_بعد_النقل = {
                الرمز: الرمز,
                أصل_النقل: المحلي.أصل_النقل,
                الاستخدام: الاستخدام
            };
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
        }
        | حالة_قيمة_محلية.محررة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_التحرير(الرمز));
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_التحرير(الرمز));
        };
    };
}

عام عرف تحقق_استخدام_محلي(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): نتيجة منطقي, خطأ_تدفق_سلامة {
    أرجع تحقق_استخدام_محلي_عند(الحالة, الرمز, اختياري.لا_شيء());
}

// Storage-relocating or mutating operations require exclusive access to the owner.
// This does not change initialization/ownership state; it only validates the current borrow state.
عام عرف تحقق_تغيير_محلي(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق تحقق_استخدام_محلي(الحالة, الرمز) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختياري.موجود(الفهرس) -> {
        دع قيمة_الحالة: حالة_تدفق_سلامة = *الحالة;
        دع مرجع_المحلي: &حالة_محلي = &قيمة_الحالة.المحليات[الفهرس];
        إذا (له_استعارة_نشطة(مرجع_المحلي)) {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.حصرية())
            );
        };
        أرجع نتيجة.نجح(صواب);
    };
}

عام عرف هيئ_محليا(
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الأصول: متجه أصل_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختياري.موجود(الفهرس) -> {
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&(*الحالة).المحليات[الفهرس]);
        إذا (له_استعارة_نشطة(&المحلي)) {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.حصرية())
            );
        };
        المحلي.القيمة := حالة_قيمة_محلية.مهيأة();
        دع بلا_أصل_نقل: اختياري نطاق = اختياري.لا_شيء();
        المحلي.أصل_النقل := بلا_أصل_نقل;
        المحلي.الأصول := الأصول;
        (*الحالة).المحليات[الفهرس] := المحلي;

        أرجع نتيجة.نجح(صواب);
    };
}

عرف هل_نوع_محلي_متغير(
    سجل_الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق أزل_غلاف_متغير(سجل_الأنواع, النوع) مع
    | اختياري.موجود(الأساس) -> { أرجع الأساس.القيمة != النوع.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Assignment legality is flow-sensitive: first initialization is legal for an immutable local,
// while a later assignment requires the canonical mutable Type wrapper. The actual state
// transition remains owned by هيئ_محليا.
عام عرف أسند_محليا(
    سجل_الأنواع: &سجل_أنواع,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الأصول: متجه أصل_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختياري.موجود(الفهرس) -> {
        دع قيمة_الحالة: حالة_تدفق_سلامة = *الحالة;
        دع مرجع_المحلي: &حالة_محلي = &قيمة_الحالة.المحليات[الفهرس];
        دع المحلي: حالة_محلي = *مرجع_المحلي;
        دع هي_تهيئة_أولى: متغير منطقي = خطأ;
        طابق المحلي.القيمة مع
        | حالة_قيمة_محلية.غير_مهيأة -> { هي_تهيئة_أولى := صواب; }
        | _ -> { };
        إذا (!هي_تهيئة_أولى
            && !هل_نوع_محلي_متغير(سجل_الأنواع, المحلي.النوع)) {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(الرمز, اختياري.لا_شيء()));
        };
    };
    أرجع هيئ_محليا(الحالة, الرمز, الأصول);
}

عرف له_أصل_استعارة_حصري(المحلي: &حالة_محلي): منطقي {
    دع القيمة: حالة_محلي = *المحلي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة.الأصول) مثل طبيعي)) {
        طابق القيمة.الأصول[ف] مع
        | أصل_استعارة.محلي(_, نوع_استعارة.حصرية) -> { أرجع صواب; }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The boolean success value reports whether the source value was consumed.
// Owned values and exclusive-reference carriers are affine; ordinary/shared
// borrowed values remain copyable. The caller uses this fact to transfer the
// carrier's active borrow without duplicating a second ownership machine.
عام عرف انقل_محليا(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    النطاق: نطاق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق تحقق_استخدام_محلي_عند(الحالة, الرمز, اختياري.موجود(النطاق)) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(_) -> { };

    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختياري.موجود(الفهرس) -> {
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&(*الحالة).المحليات[الفهرس]);
        إذا (له_استعارة_نشطة(&المحلي)) {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.حصرية())
            );
        };
        طابق حقائق_ذاكرة_نوع_مطلوبة(
            سياق_الذاكرة, المحلي.النوع
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ));
        }
        | نتيجة.نجح(الحقائق) -> {
            دع يستهلك: متغير منطقي = خطأ;
            طابق الحقائق.الصنف مع
            | صنف_ذاكرة.مملوك -> { يستهلك := صواب; }
            | صنف_ذاكرة.مستعار -> {
                إذا (الحقائق.يحتوي_استعارة_حصرية
                    || له_أصل_استعارة_حصري(&المحلي)) {
                    يستهلك := صواب;
                };
            }
            | صنف_ذاكرة.عادي -> { };

            إذا (!يستهلك) {
                أرجع نتيجة.نجح(خطأ);
            };
            طابق الحقائق.الصنف مع
            | صنف_ذاكرة.مملوك -> {
                إذا (المحلي.عرض_مستعار) {
                    دع السياق: سياق_نقل_من_مرجع = {
                        الرمز: اختياري.موجود(الرمز),
                        الموضع: النطاق
                    };
                    أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.نقل_من_مرجع(السياق));
                };
            }
            | _ -> { };

            المحلي.القيمة := حالة_قيمة_محلية.منقولة();
            دع أصل_النقل: اختياري نطاق = اختياري.موجود(النطاق);
            المحلي.أصل_النقل := أصل_النقل;
            دع أصول_فارغة_للنقل: متجه أصل_استعارة = [];
            المحلي.الأصول := أصول_فارغة_للنقل;
            (*الحالة).المحليات[الفهرس] := المحلي;

            أرجع نتيجة.نجح(صواب);
        };
    };
}

عام عرف حرر_محليا(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    النطاق: نطاق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختياري.موجود(الفهرس) -> {
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&(*الحالة).المحليات[الفهرس]);
        طابق المحلي.القيمة مع
        | حالة_قيمة_محلية.محررة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تحرير_مكرر(الرمز));
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تحرير_مكرر(الرمز));
        }
        | حالة_قيمة_محلية.منقولة -> {
            دع الاستخدام: اختياري نطاق = اختياري.موجود(النطاق);
            دع السياق: سياق_استخدام_بعد_النقل = {
                الرمز: الرمز,
                أصل_النقل: المحلي.أصل_النقل,
                الاستخدام: الاستخدام
            };
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            دع الاستخدام: اختياري نطاق = اختياري.موجود(النطاق);
            دع السياق: سياق_استخدام_بعد_النقل = {
                الرمز: الرمز,
                أصل_النقل: المحلي.أصل_النقل,
                الاستخدام: الاستخدام
            };
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
        }
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز));
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز));
        }
        | حالة_قيمة_محلية.مهيأة -> {
        };

        إذا (له_استعارة_نشطة(&المحلي)) {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.حصرية())
            );
        };
        طابق حقائق_ذاكرة_نوع_مطلوبة(
            سياق_الذاكرة, المحلي.النوع
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ));
        }
        | نتيجة.نجح(الحقائق) -> {
            إذا (!الحقائق.يتطلب_تحريرا) {
                أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز, اختياري.موجود(النطاق)));
            };
        };
        المحلي.القيمة := حالة_قيمة_محلية.محررة();
        دع أصول_فارغة_للتحرير: متجه أصل_استعارة = [];
        المحلي.الأصول := أصول_فارغة_للتحرير;
        (*الحالة).المحليات[الفهرس] := المحلي;

        أرجع نتيجة.نجح(صواب);
    };
}

عرف هو_حامل_استعارة(الاستعارة: &استعارة_نشطة, الحامل: معرف_رمز): منطقي {
    دع القيمة: استعارة_نشطة = *الاستعارة;
    طابق القيمة.الحامل مع
    | اختياري.موجود(الرمز) -> { أرجع معرفا_رمز_متساويان(الرمز, الحامل); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف بدون_استعارات_حامل(
    الاستعارات: &متجه استعارة_نشطة,
    الحامل: معرف_رمز
): متجه استعارة_نشطة {
    دع المصدر: متجه استعارة_نشطة = *الاستعارات;
    دع الناتج: متغير متجه استعارة_نشطة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        دع مرجع_القيمة: &استعارة_نشطة = &المصدر[ف];
        إذا (!هو_حامل_استعارة(مرجع_القيمة, الحامل)) {
            دع القيمة: استعارة_نشطة = انسخ_مملوكا_استعارة_نشطة(مرجع_القيمة);
            ألحق(الناتج, القيمة);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أضف_حامل_تدفق_مرتبا(
    الحوامل: &متغير متجه معرف_رمز,
    الحامل: معرف_رمز
): فراغ {
    دع الموضع: متغير طبيعي = 0;
    طالما (
        الموضع < (الطول(*الحوامل) مثل طبيعي)
        && (*الحوامل)[الموضع].القيمة < الحامل.القيمة
    ) {
        الموضع := الموضع + 1;
    }
    ألحق(*الحوامل, الحامل);
    دع ف: متغير طبيعي = الطول(*الحوامل) مثل طبيعي;
    ف := ف - 1;
    طالما (ف > الموضع) {
        دع السابق: طبيعي = ف - 1;
        (*الحوامل)[ف] := (*الحوامل)[السابق];
        ف := السابق;
    }
    (*الحوامل)[الموضع] := الحامل;
}

عرف رتب_حوامل_تدفق(الحوامل: &متجه معرف_رمز): متجه معرف_رمز {
    دع الناتج: متغير متجه معرف_رمز = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحوامل) مثل طبيعي)) {
        أضف_حامل_تدفق_مرتبا(&متغير الناتج, (*الحوامل)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف هو_حامل_ضمن_قائمة(
    الاستعارة: &استعارة_نشطة,
    الحوامل_المرتبة: &متجه معرف_رمز
): منطقي {
    طابق (*الاستعارة).الحامل مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الحامل) -> {
        دع البداية: متغير طبيعي = 0;
        دع النهاية: متغير طبيعي = الطول(*الحوامل_المرتبة) مثل طبيعي;
        طالما (البداية < النهاية) {
            دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
            دع الموجود: معرف_رمز = (*الحوامل_المرتبة)[الوسط];
            إذا (الموجود.القيمة == الحامل.القيمة) { أرجع صواب; };
            إذا (الموجود.القيمة < الحامل.القيمة) { البداية := الوسط + 1; }
            وإلا { النهاية := الوسط; };
        }
        أرجع خطأ;
    };
}

عرف بدون_استعارات_حوامل(
    الاستعارات: &متجه استعارة_نشطة,
    الحوامل_المرتبة: &متجه معرف_رمز
): متجه استعارة_نشطة {
    دع المصدر: متجه استعارة_نشطة = *الاستعارات;
    دع الناتج: متغير متجه استعارة_نشطة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        دع مرجع_القيمة: &استعارة_نشطة = &المصدر[ف];
        إذا (!هو_حامل_ضمن_قائمة(مرجع_القيمة, الحوامل_المرتبة)) {
            دع القيمة: استعارة_نشطة = انسخ_مملوكا_استعارة_نشطة(مرجع_القيمة);
            ألحق(الناتج, القيمة);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Scope exit batches departing carriers so owner locals are scanned once. One
// sorted carrier view makes each borrow membership lookup logarithmic.
عرف انه_استعارات_حوامل(
    الحالة: &متغير حالة_تدفق_سلامة,
    الحوامل: &متجه معرف_رمز
): منطقي {
    إذا ((الطول(*الحوامل) مثل طبيعي) == 0) { أرجع صواب; };
    دع الحوامل_المرتبة: متجه معرف_رمز = رتب_حوامل_تدفق(الحوامل);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&(*الحالة).المحليات[ف]);
        طابق المحلي.الاستعارات مع
        | حالة_استعارات_محلي.بلا -> { }
        | حالة_استعارات_محلي.مشتركة(القائمة) -> {
            دع الباقية: متجه استعارة_نشطة = بدون_استعارات_حوامل(&القائمة, &الحوامل_المرتبة);
            إذا ((الطول(الباقية) مثل طبيعي) == 0) {
                المحلي.الاستعارات := حالة_استعارات_محلي.بلا();
            } وإلا {
                المحلي.الاستعارات := حالة_استعارات_محلي.مشتركة(الباقية);
            };
        }
        | حالة_استعارات_محلي.حصرية(الاستعارة) -> {
            إذا (هو_حامل_ضمن_قائمة(&الاستعارة, &الحوامل_المرتبة)) {
                المحلي.الاستعارات := حالة_استعارات_محلي.بلا();
            };
        };
        (*الحالة).المحليات[ف] := المحلي;
        ف := ف + 1;
    }
    أرجع صواب;
}

// Borrow lifetime follows the local that carries the reference/view. Scope exit or
// replacement of that carrier ends only its own borrow facts; owner identity remains canonical.
عام عرف انه_استعارات_حامل(
    الحالة: &متغير حالة_تدفق_سلامة,
    الحامل: معرف_رمز
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&(*الحالة).المحليات[ف]);
        طابق المحلي.الاستعارات مع
        | حالة_استعارات_محلي.بلا -> { }
        | حالة_استعارات_محلي.مشتركة(القائمة) -> {
            دع الباقية: متجه استعارة_نشطة = بدون_استعارات_حامل(&القائمة, الحامل);
            إذا ((الطول(الباقية) مثل طبيعي) == 0) {
                المحلي.الاستعارات := حالة_استعارات_محلي.بلا();
            } وإلا {
                المحلي.الاستعارات := حالة_استعارات_محلي.مشتركة(الباقية);
            };
        }
        | حالة_استعارات_محلي.حصرية(الاستعارة) -> {
            إذا (هو_حامل_استعارة(&الاستعارة, الحامل)) {
                المحلي.الاستعارات := حالة_استعارات_محلي.بلا();
            };
        };
        (*الحالة).المحليات[ف] := المحلي;
        ف := ف + 1;
    }
    أرجع صواب;
}

// Provenance may be attached by assignments/calls/aggregate construction without copying Type structure.
عام عرف عين_أصول_محلي(
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الأصول: متجه أصل_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختياري.موجود(الفهرس) -> {
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&(*الحالة).المحليات[الفهرس]);
        المحلي.الأصول := الأصول;
        (*الحالة).المحليات[الفهرس] := المحلي;
        أرجع نتيجة.نجح(صواب);
    };
}

// SSF branch/loop analysis needs an independent local table, but immutable
// nested borrow/provenance vectors may be shared. Mutating operations already
// replace or explicitly copy the nested value they change, so snapshots copy
// O(locals) descriptors instead of recursively duplicating all borrow history.
عرف انسخ_أصول_تدفق(الأصول: &متجه أصل_استعارة): متجه أصل_استعارة {
    دع المصدر: متجه أصل_استعارة = *الأصول;
    دع الناتج: متغير متجه أصل_استعارة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        دع الأصل: أصل_استعارة = المصدر[ف];
        ألحق(الناتج, الأصل);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف انسخ_استعارة_نشطة_لتدفق(الاستعارة: &استعارة_نشطة): استعارة_نشطة {
    دع المصدر: استعارة_نشطة = *الاستعارة;
    دع الأصول: متجه أصل_استعارة = انسخ_أصول_تدفق(&المصدر.الأصول);
    دع الناتج: استعارة_نشطة = {
        المعرف: المصدر.المعرف,
        المالك: المصدر.المالك,
        الحامل: المصدر.الحامل,
        النوع: المصدر.النوع,
        الأصول: الأصول
    };
    أرجع الناتج;
}

عرف انسخ_حالة_استعارات_لتدفق(الاستعارات: &حالة_استعارات_محلي): حالة_استعارات_محلي {
    طابق *الاستعارات مع
    | حالة_استعارات_محلي.بلا -> {
        أرجع حالة_استعارات_محلي.بلا();
    }
    | حالة_استعارات_محلي.مشتركة(القيم) -> {
        دع المصدر: متجه استعارة_نشطة = القيم;
        دع الناتج: متغير متجه استعارة_نشطة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصدر) مثل طبيعي)) {
            دع النسخة: استعارة_نشطة = انسخ_استعارة_نشطة_لتدفق(&المصدر[ف]);
            ألحق(الناتج, النسخة);
            ف := ف + 1;
        }
        أرجع حالة_استعارات_محلي.مشتركة(الناتج);
    }
    | حالة_استعارات_محلي.حصرية(القيمة) -> {
        دع النسخة: استعارة_نشطة = انسخ_استعارة_نشطة_لتدفق(&القيمة);
        أرجع حالة_استعارات_محلي.حصرية(النسخة);
    };
}

عام عرف انسخ_استعارات_مشتركة_لتدفق(
    الاستعارات: &حالة_استعارات_محلي
): اختياري متجه استعارة_نشطة {
    طابق *الاستعارات مع
    | حالة_استعارات_محلي.مشتركة(القيم) -> {
        دع المصدر: متجه استعارة_نشطة = القيم;
        دع الناتج: متغير متجه استعارة_نشطة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصدر) مثل طبيعي)) {
            دع النسخة: استعارة_نشطة = انسخ_استعارة_نشطة_لتدفق(&المصدر[ف]);
            ألحق(الناتج, النسخة);
            ف := ف + 1;
        }
        أرجع اختياري.موجود(الناتج);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف انسخ_محليا_لتدفق(المحلي: &حالة_محلي): حالة_محلي {
    // Nested borrow/provenance vectors are immutable between mutations. Mutation
    // paths replace them or explicitly copy before append/remove, so snapshots
    // share descriptors without violating branch isolation.
    أرجع انسخ_مملوكا_حالة_محلي(المحلي);
}

عام عرف انسخ_حالة_تدفق_سلامة(الحالة: &حالة_تدفق_سلامة): حالة_تدفق_سلامة {
    دع المصدر: حالة_تدفق_سلامة = *الحالة;
    دع المحليات: متغير متجه حالة_محلي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر.المحليات) مثل طبيعي)) {
        دع مرجع_المحلي: &حالة_محلي = &المصدر.المحليات[ف];
        دع المحلي: حالة_محلي = انسخ_محليا_لتدفق(مرجع_المحلي);
        ألحق(المحليات, المحلي);
        ف := ف + 1;
    }
    // The mapping is immutable for this lexical version, so snapshots share the
    // 24-byte vector descriptor. New locals fork a fresh mapping in أضف_محليا.
    دع مواضع_الرموز: فهرس_مواضع_رموز_تدفق = شارك_مواضع_رموز_لتدفق(&المصدر.مواضع_الرموز);
    دع الناتج: حالة_تدفق_سلامة = {
        المحليات: المحليات,
        مواضع_الرموز: مواضع_الرموز,
        معرف_الاستعارة_التالي: المصدر.معرف_الاستعارة_التالي
    };
    أرجع الناتج;
}

// Scope exit keeps the current flow facts only for Symbols that were visible at
// scope entry. Identity is canonical Symbol identity; spelling is never consulted.
عام عرف احصر_حالة_تدفق_إلى_المرئي_عند_الدخول(
    الحالة: &حالة_تدفق_سلامة,
    عند_الدخول: &حالة_تدفق_سلامة
): نتيجة حالة_تدفق_سلامة, خطأ_تدفق_سلامة {
    // Read only from the incoming branch. Do not clone its entire local vector
    // just to discard the departing locals at this match-arm boundary.
    دع المرئية: حالة_تدفق_سلامة = *عند_الدخول;

    // End borrows carried only by locals that leave this lexical scope. Gather
    // carriers first, then scan owner locals once.
    دع الحوامل_المغادرة: متغير متجه معرف_رمز = [];
    دع ج: متغير طبيعي = 0;
    طالما (ج < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        دع الرمز_الحالي: معرف_رمز = (*الحالة).المحليات[ج].الرمز;
        طابق موضع_محلي(&المرئية, الرمز_الحالي) مع
        | اختياري.لا_شيء -> { ألحق(الحوامل_المغادرة, الرمز_الحالي); }
        | اختياري.موجود(_) -> { };
        ج := ج + 1;
    }
    دع المحليات: متغير متجه حالة_محلي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المرئية.المحليات) مثل طبيعي)) {
        دع الرمز: معرف_رمز = المرئية.المحليات[ف].الرمز;
        طابق موضع_محلي(الحالة, الرمز) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز));
        }
        | اختياري.موجود(الموضع) -> {
            دع المحلي: حالة_محلي = انسخ_محليا_لتدفق(&(*الحالة).المحليات[الموضع]);
            ألحق(المحليات, المحلي);
        };
        ف := ف + 1;
    }
    دع مواضع_الرموز: فهرس_مواضع_رموز_تدفق = شارك_مواضع_رموز_لتدفق(&المرئية.مواضع_الرموز);
    دع الناتج: متغير حالة_تدفق_سلامة = {
        المحليات: المحليات,
        مواضع_الرموز: مواضع_الرموز,
        معرف_الاستعارة_التالي: (*الحالة).معرف_الاستعارة_التالي
    };
    // Release departing carriers on the private surviving state only. This
    // preserves the original branch snapshot for subsequent CFG arms/merges.
    دع انتهت_الاستعارات: منطقي = انه_استعارات_حوامل(&متغير الناتج, &الحوامل_المغادرة);
    أرجع نتيجة.نجح(الناتج);
}

// An ordinary lexical scope appends locals; its entry prefix keeps stable
// SymbolIDs and slots even when nested branches update their flow facts.
// Keep only that prefix, and end borrows whose carriers leave this scope.
// CFG/match-arm isolation continues using the full-state snapshot path above.
عام عرف احصر_حالة_تدفق_كتلة_إلى_الدخول(
    الحالة: &حالة_تدفق_سلامة,
    عدد_محليات_الدخول: طبيعي,
    مواضع_الدخول: &فهرس_مواضع_رموز_تدفق
): نتيجة حالة_تدفق_سلامة, خطأ_تدفق_سلامة {
    دع المصدر: حالة_تدفق_سلامة = *الحالة;
    // Most nested lexical blocks introduce no locals. The incoming local vector
    // already represents exactly the entry-visible prefix; returning it avoids
    // materializing a second copy solely to close an empty lexical boundary.
    // Retain the same SymbolID/slot check used by the filtering path below.
    إذا ((الطول(المصدر.المحليات) مثل طبيعي) == عدد_محليات_الدخول) {
        دع م: متغير طبيعي = 0;
        طالما (م < عدد_محليات_الدخول) {
            دع الرمز: معرف_رمز = المصدر.المحليات[م].الرمز;
            طابق موضع_رمز_في_طبقات_تدفق(مواضع_الدخول, الرمز) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز));
            }
            | اختياري.موجود(الموضع) -> {
                إذا (الموضع != م) {
                    أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز));
                };
            };
            م := م + 1;
        }
        // Restore the canonical entry mapping even when an inner CFG fork
        // finished with an equivalent but distinct index descriptor.
        دع الناتج: متغير حالة_تدفق_سلامة = انسخ_مملوكا_حالة_تدفق_سلامة(الحالة);
        الناتج.مواضع_الرموز := شارك_مواضع_رموز_لتدفق(مواضع_الدخول);
        أرجع نتيجة.نجح(الناتج);
    };
    دع المحليات: متغير متجه حالة_محلي = [];
    دع الحوامل_المغادرة: متغير متجه معرف_رمز = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر.المحليات) مثل طبيعي)) {
        دع الرمز: معرف_رمز = المصدر.المحليات[ف].الرمز;
        إذا (ف < عدد_محليات_الدخول) {
            طابق موضع_رمز_في_طبقات_تدفق(مواضع_الدخول, الرمز) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز));
            }
            | اختياري.موجود(الموضع) -> {
                إذا (الموضع != ف) {
                    أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز));
                };
            };
            دع المحلي: حالة_محلي = انسخ_محليا_لتدفق(&المصدر.المحليات[ف]);
            ألحق(المحليات, المحلي);
        } وإلا {
            ألحق(الحوامل_المغادرة, الرمز);
        };
        ف := ف + 1;
    }
    دع مواضع_الرموز: فهرس_مواضع_رموز_تدفق = شارك_مواضع_رموز_لتدفق(مواضع_الدخول);
    دع الناتج: متغير حالة_تدفق_سلامة = {
        المحليات: المحليات,
        مواضع_الرموز: مواضع_الرموز,
        معرف_الاستعارة_التالي: المصدر.معرف_الاستعارة_التالي
    };
    دع انتهت_الاستعارات: منطقي = انه_استعارات_حوامل(&متغير الناتج, &الحوامل_المغادرة);
    أرجع نتيجة.نجح(الناتج);
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_فهرس_مواضع_رموز_تدفق(القيمة: &فهرس_مواضع_رموز_تدفق): فهرس_مواضع_رموز_تدفق {
    دع الناتج: فهرس_مواضع_رموز_تدفق = {
        المواضع: انسخ_مملوكا_متجه_ربط_موضع_رمز_تدفق(&(*القيمة).المواضع)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_ربط_موضع_رمز_تدفق(القيمة: &متجه ربط_موضع_رمز_تدفق): متجه ربط_موضع_رمز_تدفق {
    دع الناتج: متغير متجه ربط_موضع_رمز_تدفق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حالة_محلي(القيمة: &حالة_محلي): حالة_محلي {
    دع الناتج: حالة_محلي = {
        الرمز: (*القيمة).الرمز,
        النوع: (*القيمة).النوع,
        القيمة: (*القيمة).القيمة,
        أصل_النقل: (*القيمة).أصل_النقل,
        الاستعارات: انسخ_مملوكا_حالة_استعارات_محلي(&(*القيمة).الاستعارات),
        الأصول: انسخ_مملوكا_متجه_أصل_استعارة(&(*القيمة).الأصول),
        عرض_مستعار: (*القيمة).عرض_مستعار
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حالة_استعارات_محلي(القيمة: &حالة_استعارات_محلي): حالة_استعارات_محلي {
    طابق *القيمة مع
    | حالة_استعارات_محلي.بلا -> { أرجع حالة_استعارات_محلي.بلا(); }
    | حالة_استعارات_محلي.مشتركة(ح0) -> { أرجع حالة_استعارات_محلي.مشتركة(انسخ_مملوكا_متجه_استعارة_نشطة(&ح0)); }
    | حالة_استعارات_محلي.حصرية(ح0) -> { أرجع حالة_استعارات_محلي.حصرية(انسخ_مملوكا_استعارة_نشطة(&ح0)); };
}

عام عرف انسخ_مملوكا_متجه_استعارة_نشطة(القيمة: &متجه استعارة_نشطة): متجه استعارة_نشطة {
    دع الناتج: متغير متجه استعارة_نشطة = [];
