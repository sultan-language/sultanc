استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.compatibility;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.memory.memory_model;
استورد compiler.frontend.memory.semantic_pipeline;
استورد compiler.frontend.pattern.pattern_model;
استورد compiler.source.span;

استورد compiler.frontend.types.type_context;
// SSF owns only flow-sensitive availability. Static ownership class remains Memory-owned.
عام نوع حالة_قيمة_محلية =
    | غير_مهيأة
    | مهيأة
    | منقولة
    | محررة
    | ربما_غير_مهيأة
    | ربما_منقولة
    | ربما_محررة
;

عام نوع معرف_استعارة = {
    المالك: معرف_رمز,
    القيمة: غير_موقع
};

عام عرف معرف_استعارة_من(المالك: معرف_رمز, القيمة: غير_موقع): معرف_استعارة {
    دع المعرف: معرف_استعارة = { المالك: المالك, القيمة: القيمة };
    أرجع المعرف;
}

عام نوع نوع_استعارة =
    | مشتركة
    | حصرية
;

عرف نوعا_استعارة_متساويان(أ: نوع_استعارة, ب: نوع_استعارة): منطقي {
    طابق أ مع
    | نوع_استعارة.مشتركة -> {
        طابق ب مع
        | نوع_استعارة.مشتركة -> { أرجع صواب; }
        | نوع_استعارة.حصرية -> { أرجع خطأ; };
    }
    | نوع_استعارة.حصرية -> {
        طابق ب مع
        | نوع_استعارة.مشتركة -> { أرجع خطأ; }
        | نوع_استعارة.حصرية -> { أرجع صواب; };
    };
}

// Provenance records the storage root and, for a local root, the exact borrow
// mode carried by that view. This lets aggregates transfer mutable/shared view
// facts without reconstructing their fields or inventing a second state machine.
عام نوع أصل_استعارة =
    | محلي بنوع (معرف_رمز, نوع_استعارة)
    | معامل بنوع معرف_رمز
    | خارجي
;

عام عرف أصلان_متساويان(أ: أصل_استعارة, ب: أصل_استعارة): منطقي {
    طابق أ مع
    | أصل_استعارة.محلي(رمز_أ, نوع_أ) -> {
        طابق ب مع
        | أصل_استعارة.محلي(رمز_ب, نوع_ب) -> {
            أرجع معرفا_رمز_متساويان(رمز_أ, رمز_ب)
                && نوعا_استعارة_متساويان(نوع_أ, نوع_ب);
        }
        | _ -> { أرجع خطأ; };
    }
    | أصل_استعارة.معامل(رمز_أ) -> {
        طابق ب مع
        | أصل_استعارة.معامل(رمز_ب) -> {
            أرجع معرفا_رمز_متساويان(رمز_أ, رمز_ب);
        }
        | _ -> { أرجع خطأ; };
    }
    | أصل_استعارة.خارجي -> {
        طابق ب مع
        | أصل_استعارة.خارجي -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عام نوع استعارة_نشطة = {
    المعرف: معرف_استعارة,
    المالك: معرف_رمز,
    الحامل: اختيار معرف_رمز,
    النوع: نوع_استعارة,
    الأصول: متجه أصل_استعارة
};

// A local permits either many shared borrows or exactly one exclusive borrow.
عام نوع حالة_استعارات_محلي =
    | بلا
    | مشتركة بنوع متجه استعارة_نشطة
    | حصرية بنوع استعارة_نشطة
;

// Type ID is a reference to Type-owned semantics. No Memory classification is cached here.
عام نوع حالة_محلي = {
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: حالة_قيمة_محلية,
    أصل_النقل: اختيار نطاق,
    الاستعارات: حالة_استعارات_محلي,
    الأصول: متجه أصل_استعارة
};

عام نوع حالة_تدفق_سلامة = {
    المحليات: متجه حالة_محلي,
    // Dense SymbolID -> local slot index. Flow queries never rescan the local table.
    مواضع_الرموز: متجه اختيار غير_موقع,
    معرف_الاستعارة_التالي: غير_موقع
};

عام نوع سياق_استخدام_بعد_النقل = {
    الرمز: معرف_رمز,
    أصل_النقل: اختيار نطاق,
    الاستخدام: اختيار نطاق
};

عام نوع خطأ_تدفق_سلامة =
    | محلي_مفقود بنوع معرف_رمز
    | محلي_مكرر بنوع معرف_رمز
    | نوع_محلي_غير_صالح بنوع (معرف_رمز, معرف_نوع)
    | إسناد_إلى_غير_متغير بنوع معرف_رمز
    | استخدام_قبل_التهيئة بنوع معرف_رمز
    | استخدام_بعد_النقل بنوع سياق_استخدام_بعد_النقل
    | استخدام_بعد_التحرير بنوع معرف_رمز
    | نقل_غير_صالح بنوع معرف_رمز
    | تحرير_مكرر بنوع معرف_رمز
    | تحرير_غير_مملوك بنوع معرف_رمز
    | تعارض_استعارة بنوع (معرف_رمز, نوع_استعارة)
    | معرف_استعارة_غير_صالح بنوع معرف_استعارة
    | دمج_غير_صالح بنوع معرف_رمز
    | هروب_غير_صالح بنوع معرف_رمز
    | ربط_نمط_بلا_رمز بنوع معرف_نمط
    | ربط_نمط_بلا_نوع بنوع معرف_نمط
    | خطأ_ذاكرة بنوع خطأ_ذاكرة_نوع
;

عام عرف خطأ_دمج_تدفق(الرمز: معرف_رمز): خطأ_تدفق_سلامة {
    أرجع خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز);
}

عام عرف خطأ_ربط_نمط_بلا_رمز_للتدفق(النمط: معرف_نمط): خطأ_تدفق_سلامة {
    أرجع خطأ_تدفق_سلامة.ربط_نمط_بلا_رمز(النمط);
}

عام عرف خطأ_ربط_نمط_بلا_نوع_للتدفق(النمط: معرف_نمط): خطأ_تدفق_سلامة {
    أرجع خطأ_تدفق_سلامة.ربط_نمط_بلا_نوع(النمط);
}

عام عرف حالة_تدفق_سلامة_جديدة(): حالة_تدفق_سلامة {
    دع المحليات: متجه حالة_محلي = [];
    دع مواضع_الرموز: متجه اختيار غير_موقع = [];
    دع الحالة: حالة_تدفق_سلامة = {
        المحليات: المحليات,
        مواضع_الرموز: مواضع_الرموز,
        معرف_الاستعارة_التالي: 0
    };
    أرجع الحالة;
}

عرف تأكد_سعة_فهرس_محليات_لتدفق(
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): فراغ {
    دع القيمة: متغير حالة_تدفق_سلامة = *الحالة;
    بينما ((الطول(القيمة.مواضع_الرموز) مثل غير_موقع) <= الرمز.القيمة) {
        ألحق(القيمة.مواضع_الرموز, اختيار.لا_شيء());
    }
    *الحالة := القيمة;
}

عام عرف موضع_محلي(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): اختيار غير_موقع {
    دع القيمة: حالة_تدفق_سلامة = *الحالة;
    لو (الرمز.القيمة >= (الطول(القيمة.مواضع_الرموز) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع القيمة.مواضع_الرموز[الرمز.القيمة];
}

عام نوع حالة_استعارات_محلي_مقروء =
    | بلا
    | مشتركة
    | حصرية
;

عام نوع أصول_محلي_مقروء = {
    العدد: غير_موقع
};

عام نوع عرض_محلي_مقروء = {
    الموضع: غير_موقع,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: حالة_قيمة_محلية,
    أصل_النقل: اختيار نطاق,
    الاستعارات: حالة_استعارات_محلي_مقروء,
    الأصول: أصول_محلي_مقروء
};

عرف صنف_استعارات_محلي_مقروء(الاستعارات: &حالة_استعارات_محلي): حالة_استعارات_محلي_مقروء {
    طابق *الاستعارات مع
    | حالة_استعارات_محلي.بلا -> {
        أرجع حالة_استعارات_محلي_مقروء.بلا();
    }
    | حالة_استعارات_محلي.مشتركة(_) -> {
        أرجع حالة_استعارات_محلي_مقروء.مشتركة();
    }
    | حالة_استعارات_محلي.حصرية(_) -> {
        أرجع حالة_استعارات_محلي_مقروء.حصرية();
    };
}

عام عرف محلي_عند(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): اختيار عرض_محلي_مقروء {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الفهرس) -> {
        دع قيمة_الحالة: حالة_تدفق_سلامة = *الحالة;
        دع مرجع_المحلي: &حالة_محلي = &قيمة_الحالة.المحليات[الفهرس];
        دع المحلي: حالة_محلي = *مرجع_المحلي;
        دع مرجع_الاستعارات: &حالة_استعارات_محلي = &المحلي.الاستعارات;
        دع صنف_الاستعارات: حالة_استعارات_محلي_مقروء = صنف_استعارات_محلي_مقروء(مرجع_الاستعارات);
        دع عدد_الأصول: غير_موقع = الطول(المحلي.الأصول) مثل غير_موقع;
        دع عرض_الأصول: أصول_محلي_مقروء = {
            العدد: عدد_الأصول
        };
        دع العرض: عرض_محلي_مقروء = {
            الموضع: الفهرس,
            الرمز: المحلي.الرمز,
            النوع: المحلي.النوع,
            القيمة: المحلي.القيمة,
            أصل_النقل: المحلي.أصل_النقل,
            الاستعارات: صنف_الاستعارات,
            الأصول: عرض_الأصول
        };
        أرجع اختيار.بعض(العرض);
    };
}

عام عرف أصل_محلي_مقروء_عند(
    الحالة: &حالة_تدفق_سلامة,
    المحلي: عرض_محلي_مقروء,
    الفهرس: غير_موقع
): أصل_استعارة {
    دع قيمة_الحالة: حالة_تدفق_سلامة = *الحالة;
    دع مرجع_المحلي: &حالة_محلي = &قيمة_الحالة.المحليات[المحلي.الموضع];
    دع قيمة_المحلي: حالة_محلي = *مرجع_المحلي;
    أرجع قيمة_المحلي.الأصول[الفهرس];
}

عرف له_استعارة_نشطة(المحلي: &حالة_محلي): منطقي {
    دع القيمة: حالة_محلي = *المحلي;
    طابق القيمة.الاستعارات مع
    | حالة_استعارات_محلي.بلا -> {
        أرجع خطأ;
    }
    | حالة_استعارات_محلي.مشتركة(الاستعارات) -> {
        أرجع (الطول(الاستعارات) مثل غير_موقع) > 0;
    }
    | حالة_استعارات_محلي.حصرية(الاستعارة) -> {
        أرجع صواب;
    };
}

عرف انسخ_قيمة_محلي_لتدفق(المحلي: &حالة_محلي): حالة_محلي {
    أرجع *المحلي;
}

عام عرف أضف_محليا(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: حالة_قيمة_محلية,
    الأصول: متجه أصل_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختيار.بعض(الفهرس) -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مكرر(الرمز));
    }
    | اختيار.لا_شيء -> {
    };

    طابق حقائق_ذاكرة_نوع_مطلوبة(سياق_الذاكرة, النوع) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ));
    }
    | نتيجة.نجح(_) -> {
    };

    دع حالة_الاستعارات: حالة_استعارات_محلي = حالة_استعارات_محلي.بلا();
    دع بلا_أصل_نقل: اختيار نطاق = اختيار.لا_شيء();
    دع المحلي: حالة_محلي = {
        الرمز: الرمز,
        النوع: النوع,
        القيمة: القيمة,
        أصل_النقل: بلا_أصل_نقل,
        الاستعارات: حالة_الاستعارات,
        الأصول: الأصول
    };
    دع قيمة_الحالة: متغير حالة_تدفق_سلامة = *الحالة;
    دع الموضع: غير_موقع = الطول(قيمة_الحالة.المحليات) مثل غير_موقع;
    ألحق(قيمة_الحالة.المحليات, المحلي);
    *الحالة := قيمة_الحالة;
    تأكد_سعة_فهرس_محليات_لتدفق(الحالة, الرمز);
    دع حالة_الفهرس: متغير حالة_تدفق_سلامة = *الحالة;
    حالة_الفهرس.مواضع_الرموز[الرمز.القيمة] := اختيار.بعض(الموضع);
    *الحالة := حالة_الفهرس;
    أرجع نتيجة.نجح(صواب);
}

عام عرف تحقق_استخدام_محلي_عند(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الاستخدام: اختيار نطاق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق محلي_عند(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختيار.بعض(المحلي) -> {
        طابق المحلي.القيمة مع
        | حالة_قيمة_محلية.مهيأة -> {
            طابق المحلي.الاستعارات مع
            | حالة_استعارات_محلي_مقروء.حصرية -> {
                أرجع نتيجة.خطأ(
                    خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.مشتركة())
                );
            }
            | _ -> {
                أرجع نتيجة.نجح(صواب);
            };
        }
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز));
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز));
        }
        | حالة_قيمة_محلية.منقولة -> {
            دع السياق: سياق_استخدام_بعد_النقل = {
                الرمز: الرمز,
                أصل_النقل: المحلي.أصل_النقل,
                الاستخدام: الاستخدام
            };
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            دع السياق: سياق_استخدام_بعد_النقل = {
                الرمز: الرمز,
                أصل_النقل: المحلي.أصل_النقل,
                الاستخدام: الاستخدام
            };
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
        }
        | حالة_قيمة_محلية.محررة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_التحرير(الرمز));
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_التحرير(الرمز));
        };
    };
}

عام عرف تحقق_استخدام_محلي(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): نتيجة منطقي, خطأ_تدفق_سلامة {
    أرجع تحقق_استخدام_محلي_عند(الحالة, الرمز, اختيار.لا_شيء());
}

// Storage-relocating or mutating operations require exclusive access to the owner.
// This does not change initialization/ownership state; it only validates the current borrow state.
عام عرف تحقق_تغيير_محلي(
    الحالة: &حالة_تدفق_سلامة,
    الرمز: معرف_رمز
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق تحقق_استخدام_محلي(الحالة, الرمز) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختيار.بعض(الفهرس) -> {
        دع قيمة_الحالة: حالة_تدفق_سلامة = *الحالة;
        دع مرجع_المحلي: &حالة_محلي = &قيمة_الحالة.المحليات[الفهرس];
        لو (له_استعارة_نشطة(مرجع_المحلي)) {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.حصرية())
            );
        };
        أرجع نتيجة.نجح(صواب);
    };
}

عام عرف هيئ_محليا(
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الأصول: متجه أصل_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختيار.بعض(الفهرس) -> {
        دع قيمة_الحالة: متغير حالة_تدفق_سلامة = *الحالة;
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&قيمة_الحالة.المحليات[الفهرس]);
        لو (له_استعارة_نشطة(&المحلي)) {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.حصرية())
            );
        };
        المحلي.القيمة := حالة_قيمة_محلية.مهيأة();
        دع بلا_أصل_نقل: اختيار نطاق = اختيار.لا_شيء();
        المحلي.أصل_النقل := بلا_أصل_نقل;
        المحلي.الأصول := الأصول;
        قيمة_الحالة.المحليات[الفهرس] := المحلي;
        *الحالة := قيمة_الحالة;
        أرجع نتيجة.نجح(صواب);
    };
}

عرف هل_نوع_محلي_متغير(
    سجل_الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق أزل_غلاف_متغير(سجل_الأنواع, النوع) مع
    | اختيار.بعض(الأساس) -> { أرجع الأساس.القيمة != النوع.القيمة; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

// Assignment legality is flow-sensitive: first initialization is legal for an immutable local,
// while a later assignment requires the canonical mutable Type wrapper. The actual state
// transition remains owned by هيئ_محليا.
عام عرف أسند_محليا(
    سجل_الأنواع: &سجل_أنواع,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الأصول: متجه أصل_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختيار.بعض(الفهرس) -> {
        دع قيمة_الحالة: حالة_تدفق_سلامة = *الحالة;
        دع مرجع_المحلي: &حالة_محلي = &قيمة_الحالة.المحليات[الفهرس];
        دع المحلي: حالة_محلي = *مرجع_المحلي;
        دع هي_تهيئة_أولى: متغير منطقي = خطأ;
        طابق المحلي.القيمة مع
        | حالة_قيمة_محلية.غير_مهيأة -> { هي_تهيئة_أولى := صواب; }
        | _ -> { };
        لو (!هي_تهيئة_أولى
            && !هل_نوع_محلي_متغير(سجل_الأنواع, المحلي.النوع)) {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(الرمز));
        };
    };
    أرجع هيئ_محليا(الحالة, الرمز, الأصول);
}

عرف له_أصل_استعارة_حصري(المحلي: &حالة_محلي): منطقي {
    دع القيمة: حالة_محلي = *المحلي;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.الأصول) مثل غير_موقع)) {
        طابق القيمة.الأصول[ف] مع
        | أصل_استعارة.محلي(_, نوع_استعارة.حصرية) -> { أرجع صواب; }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The boolean success value reports whether the source value was consumed.
// Owned values and exclusive-reference carriers are affine; ordinary/shared
// borrowed values remain copyable. The caller uses this fact to transfer the
// carrier's active borrow without duplicating a second ownership machine.
عام عرف انقل_محليا(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    النطاق: نطاق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق تحقق_استخدام_محلي_عند(الحالة, الرمز, اختيار.بعض(النطاق)) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(_) -> { };

    طابق موضع_محلي(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختيار.بعض(الفهرس) -> {
        دع قيمة_الحالة: متغير حالة_تدفق_سلامة = *الحالة;
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&قيمة_الحالة.المحليات[الفهرس]);
        لو (له_استعارة_نشطة(&المحلي)) {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.حصرية())
            );
        };
        طابق حقائق_ذاكرة_نوع_مطلوبة(
            سياق_الذاكرة, المحلي.النوع
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ));
        }
        | نتيجة.نجح(الحقائق) -> {
            دع يستهلك: متغير منطقي = خطأ;
            طابق الحقائق.الصنف مع
            | صنف_ذاكرة.مملوك -> { يستهلك := صواب; }
            | صنف_ذاكرة.مستعار -> {
                لو (الحقائق.يحتوي_استعارة_حصرية
                    || له_أصل_استعارة_حصري(&المحلي)) {
                    يستهلك := صواب;
                };
            }
            | صنف_ذاكرة.عادي -> { };

            لو (!يستهلك) {
                أرجع نتيجة.نجح(خطأ);
            };

            المحلي.القيمة := حالة_قيمة_محلية.منقولة();
            دع أصل_النقل: اختيار نطاق = اختيار.بعض(النطاق);
            المحلي.أصل_النقل := أصل_النقل;
            دع أصول_فارغة_للنقل: متجه أصل_استعارة = [];
            المحلي.الأصول := أصول_فارغة_للنقل;
            قيمة_الحالة.المحليات[الفهرس] := المحلي;
            *الحالة := قيمة_الحالة;
            أرجع نتيجة.نجح(صواب);
        };
    };
}

عام عرف حرر_محليا(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    النطاق: نطاق
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختيار.بعض(الفهرس) -> {
        دع قيمة_الحالة: متغير حالة_تدفق_سلامة = *الحالة;
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&قيمة_الحالة.المحليات[الفهرس]);
        طابق المحلي.القيمة مع
        | حالة_قيمة_محلية.محررة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تحرير_مكرر(الرمز));
        }
        | حالة_قيمة_محلية.ربما_محررة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تحرير_مكرر(الرمز));
        }
        | حالة_قيمة_محلية.منقولة -> {
            دع الاستخدام: اختيار نطاق = اختيار.بعض(النطاق);
            دع السياق: سياق_استخدام_بعد_النقل = {
                الرمز: الرمز,
                أصل_النقل: المحلي.أصل_النقل,
                الاستخدام: الاستخدام
            };
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
        }
        | حالة_قيمة_محلية.ربما_منقولة -> {
            دع الاستخدام: اختيار نطاق = اختيار.بعض(النطاق);
            دع السياق: سياق_استخدام_بعد_النقل = {
                الرمز: الرمز,
                أصل_النقل: المحلي.أصل_النقل,
                الاستخدام: الاستخدام
            };
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
        }
        | حالة_قيمة_محلية.غير_مهيأة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز));
        }
        | حالة_قيمة_محلية.ربما_غير_مهيأة -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز));
        }
        | حالة_قيمة_محلية.مهيأة -> {
        };

        لو (له_استعارة_نشطة(&المحلي)) {
            أرجع نتيجة.خطأ(
                خطأ_تدفق_سلامة.تعارض_استعارة(الرمز, نوع_استعارة.حصرية())
            );
        };
        طابق حقائق_ذاكرة_نوع_مطلوبة(
            سياق_الذاكرة, المحلي.النوع
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.خطأ_ذاكرة(الخطأ));
        }
        | نتيجة.نجح(الحقائق) -> {
            لو (!الحقائق.يتطلب_تحريرا) {
                أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز));
            };
        };
        المحلي.القيمة := حالة_قيمة_محلية.محررة();
        دع أصول_فارغة_للتحرير: متجه أصل_استعارة = [];
        المحلي.الأصول := أصول_فارغة_للتحرير;
        قيمة_الحالة.المحليات[الفهرس] := المحلي;
        *الحالة := قيمة_الحالة;
        أرجع نتيجة.نجح(صواب);
    };
}

عرف هو_حامل_استعارة(الاستعارة: &استعارة_نشطة, الحامل: معرف_رمز): منطقي {
    دع القيمة: استعارة_نشطة = *الاستعارة;
    طابق القيمة.الحامل مع
    | اختيار.بعض(الرمز) -> { أرجع معرفا_رمز_متساويان(الرمز, الحامل); }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف بدون_استعارات_حامل(
    الاستعارات: &متجه استعارة_نشطة,
    الحامل: معرف_رمز
): متجه استعارة_نشطة {
    دع المصدر: متجه استعارة_نشطة = *الاستعارات;
    دع الناتج: متغير متجه استعارة_نشطة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع مرجع_القيمة: &استعارة_نشطة = &المصدر[ف];
        لو (!هو_حامل_استعارة(مرجع_القيمة, الحامل)) {
            دع القيمة: استعارة_نشطة = *مرجع_القيمة;
            ألحق(الناتج, القيمة);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Borrow lifetime follows the local that carries the reference/view. Scope exit or
// replacement of that carrier ends only its own borrow facts; owner identity remains canonical.
عام عرف انه_استعارات_حامل(
    الحالة: &متغير حالة_تدفق_سلامة,
    الحامل: معرف_رمز
): منطقي {
    دع قيمة_الحالة: متغير حالة_تدفق_سلامة = *الحالة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(قيمة_الحالة.المحليات) مثل غير_موقع)) {
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&قيمة_الحالة.المحليات[ف]);
        طابق المحلي.الاستعارات مع
        | حالة_استعارات_محلي.بلا -> { }
        | حالة_استعارات_محلي.مشتركة(القائمة) -> {
            دع الباقية: متجه استعارة_نشطة = بدون_استعارات_حامل(&القائمة, الحامل);
            لو ((الطول(الباقية) مثل غير_موقع) == 0) {
                المحلي.الاستعارات := حالة_استعارات_محلي.بلا();
            } وإلا {
                المحلي.الاستعارات := حالة_استعارات_محلي.مشتركة(الباقية);
            };
        }
        | حالة_استعارات_محلي.حصرية(الاستعارة) -> {
            لو (هو_حامل_استعارة(&الاستعارة, الحامل)) {
                المحلي.الاستعارات := حالة_استعارات_محلي.بلا();
            };
        };
        قيمة_الحالة.المحليات[ف] := المحلي;
        ف := ف + 1;
    }
    *الحالة := قيمة_الحالة;
    أرجع صواب;
}

// Provenance may be attached by assignments/calls/aggregate construction without copying Type structure.
عام عرف عين_أصول_محلي(
    الحالة: &متغير حالة_تدفق_سلامة,
    الرمز: معرف_رمز,
    الأصول: متجه أصل_استعارة
): نتيجة منطقي, خطأ_تدفق_سلامة {
    طابق موضع_محلي(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.محلي_مفقود(الرمز));
    }
    | اختيار.بعض(الفهرس) -> {
        دع قيمة_الحالة: متغير حالة_تدفق_سلامة = *الحالة;
        دع المحلي: متغير حالة_محلي = انسخ_قيمة_محلي_لتدفق(&قيمة_الحالة.المحليات[الفهرس]);
        المحلي.الأصول := الأصول;
        قيمة_الحالة.المحليات[الفهرس] := المحلي;
        *الحالة := قيمة_الحالة;
        أرجع نتيجة.نجح(صواب);
    };
}

// SSF branch/loop analysis needs an independent local table, but immutable
// nested borrow/provenance vectors may be shared. Mutating operations already
// replace or explicitly copy the nested value they change, so snapshots copy
// O(locals) descriptors instead of recursively duplicating all borrow history.
عرف انسخ_أصول_تدفق(الأصول: &متجه أصل_استعارة): متجه أصل_استعارة {
    دع المصدر: متجه أصل_استعارة = *الأصول;
    دع الناتج: متغير متجه أصل_استعارة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع الأصل: أصل_استعارة = المصدر[ف];
        ألحق(الناتج, الأصل);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف انسخ_استعارة_نشطة_لتدفق(الاستعارة: &استعارة_نشطة): استعارة_نشطة {
    دع المصدر: استعارة_نشطة = *الاستعارة;
    دع الأصول: متجه أصل_استعارة = انسخ_أصول_تدفق(&المصدر.الأصول);
    دع الناتج: استعارة_نشطة = {
        المعرف: المصدر.المعرف,
        المالك: المصدر.المالك,
        الحامل: المصدر.الحامل,
        النوع: المصدر.النوع,
        الأصول: الأصول
    };
    أرجع الناتج;
}

عرف انسخ_حالة_استعارات_لتدفق(الاستعارات: &حالة_استعارات_محلي): حالة_استعارات_محلي {
    طابق *الاستعارات مع
    | حالة_استعارات_محلي.بلا -> {
        أرجع حالة_استعارات_محلي.بلا();
    }
    | حالة_استعارات_محلي.مشتركة(القيم) -> {
        دع المصدر: متجه استعارة_نشطة = القيم;
        دع الناتج: متغير متجه استعارة_نشطة = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
            دع النسخة: استعارة_نشطة = انسخ_استعارة_نشطة_لتدفق(&المصدر[ف]);
            ألحق(الناتج, النسخة);
            ف := ف + 1;
        }
        أرجع حالة_استعارات_محلي.مشتركة(الناتج);
    }
    | حالة_استعارات_محلي.حصرية(القيمة) -> {
        دع النسخة: استعارة_نشطة = انسخ_استعارة_نشطة_لتدفق(&القيمة);
        أرجع حالة_استعارات_محلي.حصرية(النسخة);
    };
}

عام عرف انسخ_استعارات_مشتركة_لتدفق(
    الاستعارات: &حالة_استعارات_محلي
): اختيار متجه استعارة_نشطة {
    طابق *الاستعارات مع
    | حالة_استعارات_محلي.مشتركة(القيم) -> {
        دع المصدر: متجه استعارة_نشطة = القيم;
        دع الناتج: متغير متجه استعارة_نشطة = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
            دع النسخة: استعارة_نشطة = انسخ_استعارة_نشطة_لتدفق(&المصدر[ف]);
            ألحق(الناتج, النسخة);
            ف := ف + 1;
        }
        أرجع اختيار.بعض(الناتج);
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف انسخ_محليا_لتدفق(المحلي: &حالة_محلي): حالة_محلي {
    دع المصدر: حالة_محلي = *المحلي;
    دع الاستعارات: حالة_استعارات_محلي = انسخ_حالة_استعارات_لتدفق(&المصدر.الاستعارات);
    دع الأصول: متجه أصل_استعارة = انسخ_أصول_تدفق(&المصدر.الأصول);
    دع الناتج: حالة_محلي = {
        الرمز: المصدر.الرمز,
        النوع: المصدر.النوع,
        القيمة: المصدر.القيمة,
        أصل_النقل: المصدر.أصل_النقل,
        الاستعارات: الاستعارات,
        الأصول: الأصول
    };
    أرجع الناتج;
}

عام عرف ابن_فهرس_محليات_لتدفق(المحليات: &متجه حالة_محلي): متجه اختيار غير_موقع {
    دع المصدر: متجه حالة_محلي = *المحليات;
    دع الفهرس: متغير متجه اختيار غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع مرجع_المحلي: &حالة_محلي = &المصدر[ف];
        دع المحلي: حالة_محلي = *مرجع_المحلي;
        دع الرمز: معرف_رمز = المحلي.الرمز;
        بينما ((الطول(الفهرس) مثل غير_موقع) <= الرمز.القيمة) {
            ألحق(الفهرس, اختيار.لا_شيء());
        }
        الفهرس[الرمز.القيمة] := اختيار.بعض(ف);
        ف := ف + 1;
    }
    أرجع الفهرس;
}

عام عرف انسخ_حالة_تدفق_سلامة(الحالة: &حالة_تدفق_سلامة): حالة_تدفق_سلامة {
    دع المصدر: حالة_تدفق_سلامة = *الحالة;
    دع المحليات: متغير متجه حالة_محلي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر.المحليات) مثل غير_موقع)) {
        دع مرجع_المحلي: &حالة_محلي = &المصدر.المحليات[ف];
        دع المحلي: حالة_محلي = انسخ_محليا_لتدفق(مرجع_المحلي);
        ألحق(المحليات, المحلي);
        ف := ف + 1;
    }
    دع مواضع_الرموز: متجه اختيار غير_موقع = ابن_فهرس_محليات_لتدفق(&المحليات);
    دع الناتج: حالة_تدفق_سلامة = {
        المحليات: المحليات,
        مواضع_الرموز: مواضع_الرموز,
        معرف_الاستعارة_التالي: المصدر.معرف_الاستعارة_التالي
    };
    أرجع الناتج;
}

// Scope exit keeps the current flow facts only for Symbols that were visible at
// scope entry. Identity is canonical Symbol identity; spelling is never consulted.
عام عرف احصر_حالة_تدفق_إلى_المرئي_عند_الدخول(
    الحالة: &حالة_تدفق_سلامة,
    عند_الدخول: &حالة_تدفق_سلامة
): نتيجة حالة_تدفق_سلامة, خطأ_تدفق_سلامة {
    دع الحالية: متغير حالة_تدفق_سلامة = انسخ_حالة_تدفق_سلامة(الحالة);
    دع المرئية: حالة_تدفق_سلامة = *عند_الدخول;

    // End borrows carried only by locals that leave this lexical scope before
    // projecting the surviving owner states.
    دع ج: متغير غير_موقع = 0;
    بينما (ج < (الطول(الحالية.المحليات) مثل غير_موقع)) {
        دع الرمز_الحالي: معرف_رمز = الحالية.المحليات[ج].الرمز;
        طابق موضع_محلي(&المرئية, الرمز_الحالي) مع
        | اختيار.لا_شيء -> { دع انتهت: منطقي = انه_استعارات_حامل(&متغير الحالية, الرمز_الحالي); }
        | اختيار.بعض(_) -> { };
        ج := ج + 1;
    }

    دع المحليات: متغير متجه حالة_محلي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المرئية.المحليات) مثل غير_موقع)) {
        دع الرمز: معرف_رمز = المرئية.المحليات[ف].الرمز;
        طابق موضع_محلي(&الحالية, الرمز) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز));
        }
        | اختيار.بعض(الموضع) -> {
            دع المحلي: حالة_محلي = انسخ_محليا_لتدفق(&الحالية.المحليات[الموضع]);
            ألحق(المحليات, المحلي);
        };
        ف := ف + 1;
    }
    دع مواضع_الرموز: متجه اختيار غير_موقع = ابن_فهرس_محليات_لتدفق(&المحليات);
    دع الناتج: حالة_تدفق_سلامة = {
        المحليات: المحليات,
        مواضع_الرموز: مواضع_الرموز,
        معرف_الاستعارة_التالي: الحالية.معرف_الاستعارة_التالي
    };
    أرجع نتيجة.نجح(الناتج);
}
