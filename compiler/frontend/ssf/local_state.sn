}

عام عرف انسخ_مملوكا_متجه_حالة_محلي(القيمة: &متجه حالة_محلي): متجه حالة_محلي {
    دع الناتج: متغير متجه حالة_محلي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
