استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.مجلد;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.بايتات.مقارنة;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.source.span;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.token_registry;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.source_provider;

// Module spellings. A folder's root file declares spellings of the folder's
// direct children, by name as on disk (a NAME.sn file or a NAME folder):
//
//   module io { ar: دخ, fr: entree_sortie, es: entrada_salida };
//   وحدة نصوص_مثال { en: sample };
//
// A folder's root file is FOLDER/FOLDER.sn; a package's source root has the
// root file SOURCE_ROOT/PACKAGE.sn (std: library/std/std.sn). Only a root
// file may hold `module` declarations.
//
// A declaration may also re-export another library's module or folder as one
// of the folder's children, as std does for parts of core:
//
//   module compare = core.text.compare { ar: مقارنة };
//   module json = alloc.json { ar: جيسون };
//
// The target is a library the declaring one sees (std sees alloc and core,
// alloc sees core, core only itself) and the canonical names below it. The
// child must not exist in the folder: one path, one module. Resolution
// follows the re-export into the target library, so `std.text.compare` is
// the module of library/core/text/compare.sn, with core's ModuleKey: one
// file, one module identity. Nothing else reaches into another library: a
// path a root file does not re-export is a path of the importer's library
// only.
//
// An import path is canonicalized component by component before it is
// resolved: in `المكتبة.دخ.print`, the root spelling المكتبة names std (the
// logical environment), std.sn maps دخ to io, and io/io.sn may map print;
// a name no root file maps stays as written. A spelling is one more name of
// one module, never a second module identity. Each root file is read once,
// for its `module` lines only, and kept in ذاكرة_تهجئات_الوحدات, which a
// loader owns for its compilation; incremental analysis can keep it.

عام نوع تهجئة_ابن_وحدة = {
    التهجئة: متجه ط8,
    الابن: متجه ط8,
    // The language key the spelling is declared under (`ar`, `fr`, ...).
    اللغة: متجه ط8
};

// `module NAME = LIBRARY.a.b;`: the child NAME is the module (or folder)
// a/b of LIBRARY. النطاق is NAME's, in the root file.
عام نوع إعادة_تصدير_وحدة = {
    الابن: متجه ط8,
    المكتبة: متجه ط8,
    المسار: متجه متجه ط8,
    النطاق: نطاق
};

عام نوع صنف_خطأ_تهجئة_وحدة =
    // `module x` and the folder has no x.sn and no x/.
    | ابن_غير_موجود
    // `module x = ...;` and the folder has its own x.sn or x/.
    | إعادة_تصدير_تحجب_ابنا
    // The re-export's library is not one the declaring library sees, or it
    // has no source root.
    | هدف_إعادة_تصدير_غير_متاح
    // Following re-exports did not end (a chain longer than any layering).
    | دورة_إعادة_تصدير
    // One spelling for two children, or a spelling that is another child's name.
    | تهجئة_مشتركة
    // A reserved word of the language as a spelling.
    | كلمة_محجوزة
;

// النطاق is in the root file, registered in the SourceMap for the diagnostic.
عام نوع خطأ_تهجئة_وحدة = {
    الصنف: صنف_خطأ_تهجئة_وحدة,
    النطاق: نطاق
};

// The spellings and re-exports one root file declares. The text is kept for
// a diagnostic, which registers it once (معرف_المصدر).
عام نوع تهجئات_مجلد = {
    ملف_الجذر: نص,
    التهجئات: متجه تهجئة_ابن_وحدة,
    إعادات_التصدير: متجه إعادة_تصدير_وحدة,
    الخطأ: اختياري خطأ_تهجئة_وحدة,
    المحتوى: نص,
    معرف_المصدر: اختياري طبيعي
};

عام نوع ذاكرة_تهجئات_الوحدات = {
    المجلدات: متجه تهجئات_مجلد
};

عام عرف ذاكرة_تهجئات_وحدات_جديدة(): ذاكرة_تهجئات_الوحدات {
    ليكن المجلدات: متجه تهجئات_مجلد = [];
    ليكن الذاكرة: ذاكرة_تهجئات_الوحدات = { المجلدات: المجلدات };
    أرجع الذاكرة;
}

عرف بايتات_نطاق_رمز(المحتوى: &نص, النطاق: نطاق): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = النطاق.البداية.البايت مثل طبيعي;
    ليكن النهاية: طبيعي = النطاق.النهاية.البايت مثل طبيعي;
    طالما (ف < النهاية && ف < (الطول(*المحتوى) مثل طبيعي)) {
        ألحق(الناتج, (*المحتوى)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// A NAME.sn file or a NAME folder in المجلد.
عرف ابن_موجود_في_مجلد(المجلد: &نص, الاسم: &متجه ط8): منطقي {
    ليكن اسم_النص: نص = من_بايتات(الاسم);
    ليكن الدليل: نص = صل_المسار(المجلد, &اسم_النص);
    طابق حاول_مسار_دليل(&الدليل) مع
    | نتيجة.نجح(صواب) -> { أرجع صواب; }
    | _ -> { };
    ليكن بايتات_الملف: متغير متجه ط8 = انسخ_بايتات(الاسم);
    ألحق_بايتات_نص(&متغير بايتات_الملف, «.sn»);
    ليكن اسم_الملف: نص = من_بايتات(&بايتات_الملف);
    ليكن الملف: نص = صل_المسار(المجلد, &اسم_الملف);
    طابق حاول_مسار_ملف(&الملف) مع
    | نتيجة.نجح(موجود) -> { أرجع موجود; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف هل_اسم_تصريح_وحدة(النوع: رمز): منطقي {
    أرجع النوع == رمز.معرف() || هل_كلمة_محجوزة(النوع);
}

عرف خطأ_تهجئة_عند(الصنف: صنف_خطأ_تهجئة_وحدة, النطاق: نطاق): اختياري خطأ_تهجئة_وحدة {
    ليكن الخطأ: خطأ_تهجئة_وحدة = { الصنف: الصنف, النطاق: النطاق };
    أرجع اختياري.موجود(الخطأ);
}

// The child a spelling already names in التهجئات, if any.
عرف ابن_تهجئة(التهجئات: &متجه تهجئة_ابن_وحدة, التهجئة: &متجه ط8): اختياري متجه ط8 {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التهجئات) مثل طبيعي)) {
        إذا (متجها_بايتات_متساويان(&(*التهجئات)[ف].التهجئة, التهجئة)) {
            أرجع اختياري.موجود(انسخ_بايتات(&(*التهجئات)[ف].الابن));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The spellings, re-exports and the first error of the `module`
// declarations in الرموز, checked against المجلد. A declaration the parser
// would reject is left to the parser: reading stops there without an error.
عرف اقرأ_تهجئات_رموز(
    المجلد: &نص,
    المحتوى: &نص,
    الرموز: &متجه رمز_مصدر,
    التهجئات: &متغير متجه تهجئة_ابن_وحدة,
    إعادات_التصدير: &متغير متجه إعادة_تصدير_وحدة
): اختياري خطأ_تهجئة_وحدة {
    ليكن الخطأ: متغير اختياري خطأ_تهجئة_وحدة = اختياري.لا_شيء();
    ليكن العدد: طبيعي = الطول(*الرموز) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر && ف < العدد) {
        إذا ((*الرموز)[ف].النوع != رمز.تصريح_وحدة()) {
            ف := ف + 1;
        } وإلا إذا (ف + 2 >= العدد || !هل_اسم_تصريح_وحدة((*الرموز)[ف + 1].النوع)) {
            مستمر := خطأ;
        } وإلا {
            ليكن نطاق_الابن: نطاق = (*الرموز)[ف + 1].النطاق;
            ليكن الابن: متجه ط8 = بايتات_نطاق_رمز(المحتوى, نطاق_الابن);
            ف := ف + 2;
            ليكن معاد: منطقي = (*الرموز)[ف].النوع == رمز.فاصل_تعريف();
            إذا (معاد) {
                // LIBRARY.a.b: the library and at least one name below it.
                ف := ف + 1;
                ليكن الأجزاء: متغير متجه متجه ط8 = [];
                إذا (ف < العدد && هل_اسم_تصريح_وحدة((*الرموز)[ف].النوع)) {
                    ألحق(الأجزاء, بايتات_نطاق_رمز(المحتوى, (*الرموز)[ف].النطاق));
                    ف := ف + 1;
                    طالما (ف + 1 < العدد && (*الرموز)[ف].النوع == رمز.نقطة()
                        && هل_اسم_تصريح_وحدة((*الرموز)[ف + 1].النوع)) {
                        ألحق(الأجزاء, بايتات_نطاق_رمز(المحتوى, (*الرموز)[ف + 1].النطاق));
                        ف := ف + 2;
                    }
                };
                إذا ((الطول(الأجزاء) مثل طبيعي) < 2) {
                    مستمر := خطأ;
                } وإلا إذا (ابن_موجود_في_مجلد(المجلد, &الابن)) {
                    الخطأ := خطأ_تهجئة_عند(صنف_خطأ_تهجئة_وحدة.إعادة_تصدير_تحجب_ابنا(), نطاق_الابن);
                    مستمر := خطأ;
                } وإلا {
                    ليكن المسار: متغير متجه متجه ط8 = [];
                    ليكن ج: متغير طبيعي = 1;
                    طالما (ج < (الطول(الأجزاء) مثل طبيعي)) {
                        ألحق(المسار, انسخ_بايتات(&الأجزاء[ج]));
                        ج := ج + 1;
                    }
                    ليكن الجديدة: إعادة_تصدير_وحدة = {
                        الابن: انسخ_بايتات(&الابن),
                        المكتبة: انسخ_بايتات(&الأجزاء[0]),
                        المسار: المسار,
                        النطاق: نطاق_الابن
                    };
                    ألحق(*إعادات_التصدير, الجديدة);
                };
            } وإلا إذا (!ابن_موجود_في_مجلد(المجلد, &الابن)) {
                الخطأ := خطأ_تهجئة_عند(صنف_خطأ_تهجئة_وحدة.ابن_غير_موجود(), نطاق_الابن);
                مستمر := خطأ;
            };
            إذا (مستمر) {
                إذا (معاد && ف < العدد && (*الرموز)[ف].النوع == رمز.فاصلة_منقوطة()) {
                    ف := ف + 1;
                } وإلا إذا (ف < العدد && (*الرموز)[ف].النوع == رمز.معقوف_يسار()) {
                    ف := ف + 1;
                } وإلا {
                    مستمر := خطأ;
                };
            };
            // lang `:` spelling, separated by `,`, up to `}`.
            طالما (مستمر && ف < العدد && (*الرموز)[ف].النوع != رمز.معقوف_يمين()
                && (*الرموز)[ف].النوع != رمز.تصريح_وحدة()) {
                إذا (ف + 2 >= العدد
                    || (*الرموز)[ف].النوع != رمز.معرف()
                    || (*الرموز)[ف + 1].النوع != رمز.نقطتان()
                    || !هل_اسم_تصريح_وحدة((*الرموز)[ف + 2].النوع)) {
                    مستمر := خطأ;
                } وإلا {
                    ليكن نطاق_التهجئة: نطاق = (*الرموز)[ف + 2].النطاق;
                    ليكن التهجئة: متجه ط8 = بايتات_نطاق_رمز(المحتوى, نطاق_التهجئة);
                    إذا (هل_كلمة_محجوزة((*الرموز)[ف + 2].النوع)) {
                        الخطأ := خطأ_تهجئة_عند(صنف_خطأ_تهجئة_وحدة.كلمة_محجوزة(), نطاق_التهجئة);
                        مستمر := خطأ;
                    } وإلا إذا (!متجها_بايتات_متساويان(&التهجئة, &الابن)) {
                        ليكن مشتركة: متغير منطقي = ابن_موجود_في_مجلد(المجلد, &التهجئة);
                        طابق ابن_تهجئة(التهجئات, &التهجئة) مع
                        | اختياري.موجود(السابق) -> {
                            إذا (!متجها_بايتات_متساويان(&السابق, &الابن)) { مشتركة := صواب; };
                        }
                        | اختياري.لا_شيء -> {
                            ليكن اللغة: متجه ط8 = بايتات_نطاق_رمز(المحتوى, (*الرموز)[ف].النطاق);
                            ليكن الجديدة: تهجئة_ابن_وحدة = {
                                التهجئة: انسخ_بايتات(&التهجئة), الابن: انسخ_بايتات(&الابن), اللغة: اللغة
                            };
                            ألحق(*التهجئات, الجديدة);
                        };
                        إذا (مشتركة) {
                            الخطأ := خطأ_تهجئة_عند(صنف_خطأ_تهجئة_وحدة.تهجئة_مشتركة(), نطاق_التهجئة);
                            مستمر := خطأ;
                        };
                    };
                    ف := ف + 3;
                    إذا (ف < العدد && (*الرموز)[ف].النوع == رمز.فاصلة()) { ف := ف + 1; };
                };
            }
        };
    }
    أرجع الخطأ;
}

// The `module` declarations of a root file, read once (تهجئات_مجلد_مخزنة).
عام عرف اقرأ_تهجئات_ملف_جذر(
    المجلد: &نص,
    ملف_الجذر: &نص,
    المحتوى: &نص
): تهجئات_مجلد {
    ليكن التهجئات: متغير متجه تهجئة_ابن_وحدة = [];
    ليكن إعادات_التصدير: متغير متجه إعادة_تصدير_وحدة = [];
    ليكن الخطأ: متغير اختياري خطأ_تهجئة_وحدة = اختياري.لا_شيء();
    ليكن المصدر: مصدر = مصدر_جديد(0, انسخ_نص(ملف_الجذر), انسخ_نص(المحتوى));
    طابق حلل_معجميا(&المصدر) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        الخطأ := اقرأ_تهجئات_رموز(
            المجلد, المحتوى, &السلسلة.الرموز, &متغير التهجئات, &متغير إعادات_التصدير
        );
    };
    // Kept for an error found now or while a re-export is followed.
    ليكن المحتوى_المحفوظ: متغير نص = «»;
    إذا ((الطول(إعادات_التصدير) مثل طبيعي) > 0) { المحتوى_المحفوظ := انسخ_نص(المحتوى); };
    طابق الخطأ مع
    | اختياري.موجود(_) -> { المحتوى_المحفوظ := انسخ_نص(المحتوى); }
    | اختياري.لا_شيء -> { };
    ليكن الناتج: تهجئات_مجلد = {
        ملف_الجذر: انسخ_نص(ملف_الجذر),
        التهجئات: التهجئات,
        إعادات_التصدير: إعادات_التصدير,
        الخطأ: الخطأ,
        المحتوى: المحتوى_المحفوظ,
        معرف_المصدر: اختياري.لا_شيء()
    };
    أرجع الناتج;
}

// The text of a root file: an open editor's text first, else the file; none
// when there is no such file.
عام عرف نص_ملف_جذر(البيئة: &بيئة_وحدات_منطقية, المسار: &نص): اختياري نص {
    ليكن التراكب: نتيجة_محتوى_تراكب_مصدر = محتوى_تراكب_مصدر(&(*البيئة).مزود_المصادر, المسار);
    إذا (التراكب.موجود) { أرجع اختياري.موجود(انسخ_نص(&التراكب.المحتوى)); };
    طابق حاول_مسار_ملف(المسار) مع
    | نتيجة.نجح(صواب) -> { }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.نجح(النص) -> { أرجع اختياري.موجود(النص); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// The cached spellings of the folder whose root file is ملف_الجذر, read on
// first use. The result is its position in الذاكرة.
عرف تهجئات_مجلد_مخزنة(
    الذاكرة: &متغير ذاكرة_تهجئات_الوحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المجلد: &نص,
    ملف_الجذر: &نص
): طبيعي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).المجلدات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الذاكرة).المجلدات[ف].ملف_الجذر, ملف_الجذر)) { أرجع ف; };
        ف := ف + 1;
    }
    ليكن المدخل: تهجئات_مجلد;
    طابق نص_ملف_جذر(البيئة, ملف_الجذر) مع
    | اختياري.موجود(المحتوى) -> {
        المدخل := اقرأ_تهجئات_ملف_جذر(المجلد, ملف_الجذر, &المحتوى);
    }
    | اختياري.لا_شيء -> {
        ليكن بلا_تهجئات: متجه تهجئة_ابن_وحدة = [];
        ليكن بلا_إعادات: متجه إعادة_تصدير_وحدة = [];
        ليكن الفارغ: تهجئات_مجلد = {
            ملف_الجذر: انسخ_نص(ملف_الجذر), التهجئات: بلا_تهجئات, إعادات_التصدير: بلا_إعادات,
            الخطأ: اختياري.لا_شيء(),
            المحتوى: «», معرف_المصدر: اختياري.لا_شيء()
        };
        المدخل := الفارغ;
    };
    ألحق((*الذاكرة).المجلدات, المدخل);
    أرجع (الطول((*الذاكرة).المجلدات) مثل طبيعي) - 1;
}

// The error of a cached root file, its text registered in the SourceMap once
// so the diagnostic points into it.
عرف خطأ_مجلد_مسجل(
    الذاكرة: &متغير ذاكرة_تهجئات_الوحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    الموضع: طبيعي
): اختياري خطأ_تهجئة_وحدة {
    ليكن الخطأ: خطأ_تهجئة_وحدة;
    طابق (*الذاكرة).المجلدات[الموضع].الخطأ مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الخطأ := القيمة; };
    ليكن المعرف: طبيعي;
    طابق (*الذاكرة).المجلدات[الموضع].معرف_المصدر مع
    | اختياري.موجود(القيمة) -> { المعرف := القيمة; }
    | اختياري.لا_شيء -> {
        المعرف := أضف_مصدر_إلى_خريطة(
            سياق_المصادر,
            انسخ_نص(&(*الذاكرة).المجلدات[الموضع].ملف_الجذر),
            انسخ_نص(&(*الذاكرة).المجلدات[الموضع].المحتوى)
        );
        (*الذاكرة).المجلدات[الموضع].معرف_المصدر := اختياري.موجود(المعرف);
    };
    ليكن البداية: موضع = { المصدر: المعرف مثل ط32, البايت: الخطأ.النطاق.البداية.البايت };
    ليكن النهاية: موضع = { المصدر: المعرف مثل ط32, البايت: الخطأ.النطاق.النهاية.البايت };
    ليكن المسجل: خطأ_تهجئة_وحدة = { الصنف: الخطأ.الصنف, النطاق: نطاق_بين(البداية, النهاية) };
    أرجع اختياري.موجود(المسجل);
}

عرف أجزاء_مرجع(المرجع: &متجه ط8): متجه متجه ط8 {
    ليكن الأجزاء: متغير متجه متجه ط8 = [];
    ليكن الجزء: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف <= (الطول(*المرجع) مثل طبيعي)) {
        إذا (ف == (الطول(*المرجع) مثل طبيعي) || (*المرجع)[ف] == 0x2F) {
            ألحق(الأجزاء, الجزء);
            ليكن فارغ: متجه ط8 = [];
            الجزء := فارغ;
        } وإلا {
            ألحق(الجزء, (*المرجع)[ف]);
        };
        ف := ف + 1;
    }
    أرجع الأجزاء;
}

عرف ينتهي_بامتداد_سلطان(الجزء: &متجه ط8): منطقي {
    ليكن الامتداد: متجه ط8 = بايتات_من_نص(«.sn»);
    أرجع (الطول(*الجزء) مثل طبيعي) > 3 && تنتهي_البايتات_بـ(الجزء, &الامتداد);
}

عرف بلا_امتداد_سلطان(الجزء: &متجه ط8): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف + 3 < (الطول(*الجزء) مثل طبيعي)) {
        ألحق(الناتج, (*الجزء)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The root file of a package's source root, or none for a root without a
// package name (a standalone file's directory).
عرف ملف_جذر_الحزمة(البيئة: &بيئة_وحدات_منطقية, الجذر: معرف_جذر_مكتبة, جذر_المصدر: &نص): اختياري نص {
    طابق اسم_حزمة_لجذر(البيئة, الجذر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        ليكن البايتات: متغير متجه ط8 = انسخ_بايتات(&الاسم);
        ألحق_بايتات_نص(&متغير البايتات, «.sn»);
        ليكن الملف: نص = من_بايتات(&البايتات);
        أرجع اختياري.موجود(صل_المسار(جذر_المصدر, &الملف));
    };
}

عرف ملف_جذر_مجلد(المجلد: &نص, الاسم: &متجه ط8): نص {
    ليكن البايتات: متغير متجه ط8 = انسخ_بايتات(الاسم);
    ألحق_بايتات_نص(&متغير البايتات, «.sn»);
    ليكن الملف: نص = من_بايتات(&البايتات);
    أرجع صل_المسار(المجلد, &الملف);
}

// An error at النطاق of the root file cached at الموضع, its text registered
// in the SourceMap once (as خطأ_مجلد_مسجل).
عرف خطأ_في_مجلد_مسجل(
    الذاكرة: &متغير ذاكرة_تهجئات_الوحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    الموضع: طبيعي,
    الصنف: صنف_خطأ_تهجئة_وحدة,
    النطاق: نطاق
): خطأ_تهجئة_وحدة {
    ليكن المعرف: طبيعي;
    طابق (*الذاكرة).المجلدات[الموضع].معرف_المصدر مع
    | اختياري.موجود(القيمة) -> { المعرف := القيمة; }
    | اختياري.لا_شيء -> {
        المعرف := أضف_مصدر_إلى_خريطة(
            سياق_المصادر,
            انسخ_نص(&(*الذاكرة).المجلدات[الموضع].ملف_الجذر),
            انسخ_نص(&(*الذاكرة).المجلدات[الموضع].المحتوى)
        );
        (*الذاكرة).المجلدات[الموضع].معرف_المصدر := اختياري.موجود(المعرف);
    };
    ليكن البداية: موضع = { المصدر: المعرف مثل ط32, البايت: النطاق.البداية.البايت };
    ليكن النهاية: موضع = { المصدر: المعرف مثل ط32, البايت: النطاق.النهاية.البايت };
    ليكن الخطأ: خطأ_تهجئة_وحدة = { الصنف: الصنف, النطاق: نطاق_بين(البداية, النهاية) };
    أرجع الخطأ;
}

// The library a re-export written in a root file of المصرّحة names: المصرّحة
// itself or a library beneath it, by package name or by a root name
// المصرّحة sees (`core`, `الأساس`). Any other library is not visible.
عام عرف مكتبة_إعادة_تصدير(
    البيئة: &بيئة_وحدات_منطقية,
    المصرّحة: معرف_جذر_مكتبة,
    الاسم: &متجه ط8
): اختياري معرف_جذر_مكتبة {
    ليكن المرشحة: متغير متجه معرف_جذر_مكتبة = [المصرّحة];
    ليكن السفلى: متجه معرف_جذر_مكتبة = مكتبات_سفلى(البيئة, المصرّحة);
    ليكن س: متغير طبيعي = 0;
    طالما (س < (الطول(السفلى) مثل طبيعي)) { ألحق(المرشحة, السفلى[س]); س := س + 1; }
    ليكن الحل: اختياري حل_اسم_جذر_مكتبة = حل_اسم_جذر_مفصل(البيئة, المصرّحة, الاسم);
    س := 0;
    طالما (س < (الطول(المرشحة) مثل طبيعي)) {
        طابق اسم_حزمة_لجذر(البيئة, المرشحة[س]) مع
        | اختياري.موجود(اسم_الحزمة) -> {
            إذا (متجها_بايتات_متساويان(&اسم_الحزمة, الاسم)) { أرجع اختياري.موجود(المرشحة[س]); };
        }
        | اختياري.لا_شيء -> { };
        طابق الحل مع
        | اختياري.موجود(القيمة) -> {
            إذا (معرفا_جذر_مكتبة_متساويان(القيمة.الجذر, المرشحة[س])) { أرجع اختياري.موجود(المرشحة[س]); };
        }
        | اختياري.لا_شيء -> { };
        س := س + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A reference with its spellings replaced by canonical names and its
// re-exports followed. الجذر is the library a re-export led to; المرجع is
// then the path below that library's source root. Without one, المرجع is
// the reference as the importer wrote it, canonical, root name included.
عام نوع مرجع_مقنن_بالتهجئات = {
    المرجع: متجه ط8,
    الجذر: اختياري معرف_جذر_مكتبة
};

عرف مرجع_مقنن_كما_هو(المرجع: &متجه ط8): مرجع_مقنن_بالتهجئات {
    ليكن الناتج: مرجع_مقنن_بالتهجئات = { المرجع: انسخ_بايتات(المرجع), الجذر: اختياري.لا_شيء() };
    أرجع الناتج;
}

عرف انسخ_إعادة_تصدير(القيمة: &إعادة_تصدير_وحدة): إعادة_تصدير_وحدة {
    ليكن المسار: متغير متجه متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة).المسار) مثل طبيعي)) { ألحق(المسار, انسخ_بايتات(&(*القيمة).المسار[ف])); ف := ف + 1; }
    ليكن الناتج: إعادة_تصدير_وحدة = {
        الابن: انسخ_بايتات(&(*القيمة).الابن),
        المكتبة: انسخ_بايتات(&(*القيمة).المكتبة),
        المسار: المسار,
        النطاق: (*القيمة).النطاق
    };
    أرجع الناتج;
}

// Longer than any chain the layering allows (std -> alloc -> core).
عرف حد_إعادات_التصدير(): طبيعي { أرجع 32; }

// Walks الأجزاء from البداية in the library الجذر, folder by folder, as
// written: each component is replaced by the child its spelling names in
// the folder's root file, and a child the root file re-exports continues in
// the re-exported library, at the re-exported path, with the components
// after it. Only the root files of the library being walked are read.
عرف امش_مسار_بالتهجئات(
    الذاكرة: &متغير ذاكرة_تهجئات_الوحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    البيئة: &بيئة_وحدات_منطقية,
    الجذر_الأول: معرف_جذر_مكتبة,
    الأجزاء_الأولى: متجه متجه ط8,
    البداية: طبيعي,
    بامتداد: منطقي,
    المرجع: &متجه ط8
): نتيجة مرجع_مقنن_بالتهجئات, خطأ_تهجئة_وحدة {
    ليكن الجذر: متغير معرف_جذر_مكتبة = الجذر_الأول;
    ليكن الأجزاء: متغير متجه متجه ط8 = الأجزاء_الأولى;
    ليكن المجلد: متغير نص;
    طابق جذر_مصدر_لمعرف(البيئة, الجذر) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(مرجع_مقنن_كما_هو(المرجع)); }
    | اختياري.موجود(القيمة) -> { المجلد := القيمة; };
    ليكن ملف_الجذر: متغير اختياري نص = ملف_جذر_الحزمة(البيئة, الجذر, &المجلد);
    ليكن تغير: متغير منطقي = خطأ;
    ليكن محول: متغير منطقي = خطأ;
    ليكن القفزات: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
        ليكن إعادة: متغير اختياري إعادة_تصدير_وحدة = اختياري.لا_شيء();
        ليكن موضع_الإعادة: متغير طبيعي = 0;
        طابق ملف_الجذر مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الملف) -> {
            ليكن الموضع: طبيعي = تهجئات_مجلد_مخزنة(الذاكرة, البيئة, &المجلد, &الملف);
            طابق خطأ_مجلد_مسجل(الذاكرة, سياق_المصادر, الموضع) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق ابن_تهجئة(&(*الذاكرة).المجلدات[الموضع].التهجئات, &الأجزاء[ف]) مع
            | اختياري.موجود(الابن) -> { الأجزاء[ف] := الابن; تغير := صواب; }
            | اختياري.لا_شيء -> { };
            ليكن ر: متغير طبيعي = 0;
            طالما (ر < (الطول((*الذاكرة).المجلدات[الموضع].إعادات_التصدير) مثل طبيعي)) {
                إذا (متجها_بايتات_متساويان(&(*الذاكرة).المجلدات[الموضع].إعادات_التصدير[ر].الابن, &الأجزاء[ف])) {
                    إعادة := اختياري.موجود(انسخ_إعادة_تصدير(&(*الذاكرة).المجلدات[الموضع].إعادات_التصدير[ر]));
                    موضع_الإعادة := الموضع;
                };
                ر := ر + 1;
            }
        };
        طابق إعادة مع
        | اختياري.موجود(القيمة) -> {
            القفزات := القفزات + 1;
            إذا (القفزات > حد_إعادات_التصدير()) {
                أرجع نتيجة.خطأ(خطأ_في_مجلد_مسجل(
                    الذاكرة, سياق_المصادر, موضع_الإعادة, صنف_خطأ_تهجئة_وحدة.دورة_إعادة_تصدير(), القيمة.النطاق
                ));
            };
            ليكن الهدف: معرف_جذر_مكتبة;
            طابق مكتبة_إعادة_تصدير(البيئة, الجذر, &القيمة.المكتبة) مع
            | اختياري.موجود(المكتبة) -> { الهدف := المكتبة; }
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_في_مجلد_مسجل(
                    الذاكرة, سياق_المصادر, موضع_الإعادة, صنف_خطأ_تهجئة_وحدة.هدف_إعادة_تصدير_غير_متاح(), القيمة.النطاق
                ));
            };
            طابق جذر_مصدر_لمعرف(البيئة, الهدف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_في_مجلد_مسجل(
                    الذاكرة, سياق_المصادر, موضع_الإعادة, صنف_خطأ_تهجئة_وحدة.هدف_إعادة_تصدير_غير_متاح(), القيمة.النطاق
                ));
            }
            | اختياري.موجود(جذر_المصدر) -> { المجلد := جذر_المصدر; };
            ليكن التالية: متغير متجه متجه ط8 = [];
            ليكن ج: متغير طبيعي = 0;
            طالما (ج < (الطول(القيمة.المسار) مثل طبيعي)) { ألحق(التالية, انسخ_بايتات(&القيمة.المسار[ج])); ج := ج + 1; }
            ج := ف + 1;
            طالما (ج < (الطول(الأجزاء) مثل طبيعي)) { ألحق(التالية, انسخ_بايتات(&الأجزاء[ج])); ج := ج + 1; }
            الأجزاء := التالية;
            الجذر := الهدف;
            ملف_الجذر := ملف_جذر_الحزمة(البيئة, الجذر, &المجلد);
            تغير := صواب;
            محول := صواب;
            ف := 0;
        }
        | اختياري.لا_شيء -> {
            ليكن اسم_الجزء: نص = من_بايتات(&الأجزاء[ف]);
            المجلد := صل_المسار(&المجلد, &اسم_الجزء);
            ملف_الجذر := اختياري.موجود(ملف_جذر_مجلد(&المجلد, &الأجزاء[ف]));
            ف := ف + 1;
        };
    }
    إذا (!تغير) { أرجع نتيجة.نجح(مرجع_مقنن_كما_هو(المرجع)); };
    ليكن الناتج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
        إذا (ف > 0) { ألحق(الناتج, 0x2F); };
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول(الأجزاء[ف]) مثل طبيعي)) {
            ألحق(الناتج, الأجزاء[ف][ح]);
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    إذا (بامتداد) { ألحق_بايتات_نص(&متغير الناتج, «.sn»); };
    ليكن الجذر_الناتج: متغير اختياري معرف_جذر_مكتبة = اختياري.لا_شيء();
    إذا (محول) { الجذر_الناتج := اختياري.موجود(الجذر); };
    ليكن المقنن: مرجع_مقنن_بالتهجئات = { المرجع: الناتج, الجذر: الجذر_الناتج };
    أرجع نتيجة.نجح(المقنن);
}

// المرجع (a named import reference, `/`-separated, ending in `.sn` or not)
// with every spelling replaced by its canonical name and every re-export
// followed (امش_مسار_بالتهجئات). The first component stays when it names a
// library root (std, a dependency); the components after it are looked up
// from that root's source root. Unbound, every component is looked up from
// the importer's own source root.
عام عرف قنن_مرجع_بالتهجئات(
    الذاكرة: &متغير ذاكرة_تهجئات_الوحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: &مفتاح_وحدة_مقنن,
    المرجع: &متجه ط8
): نتيجة مرجع_مقنن_بالتهجئات, خطأ_تهجئة_وحدة {
    طابق صنف_مرجع_استيراد(المرجع) مع
    | تصنيف_مرجع_استيراد.جذر_مسمى -> { }
    | _ -> { أرجع نتيجة.نجح(مرجع_مقنن_كما_هو(المرجع)); };
    ليكن الأجزاء: متغير متجه متجه ط8 = أجزاء_مرجع(المرجع);
    ليكن العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
    ليكن بامتداد: منطقي = ينتهي_بامتداد_سلطان(&الأجزاء[العدد - 1]);
    إذا (بامتداد) {
        ليكن الأخير: متجه ط8 = بلا_امتداد_سلطان(&الأجزاء[العدد - 1]);
        الأجزاء[العدد - 1] := الأخير;
    };
    ليكن الجذر: متغير معرف_جذر_مكتبة = (*المستورد).الجذر;
    ليكن البداية: متغير طبيعي = 0;
    طابق حل_اسم_جذر_مفصل(البيئة, (*المستورد).الجذر, &الأجزاء[0]) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الحل) -> {
        إذا (الحل.يستهلك_التهجئة || !معرفا_جذر_مكتبة_متساويان(الحل.الجذر, (*المستورد).الجذر)) {
            الجذر := الحل.الجذر;
            البداية := 1;
        };
    };
    أرجع امش_مسار_بالتهجئات(
        الذاكرة, سياق_المصادر, البيئة, الجذر, الأجزاء, البداية, بامتداد, المرجع
    );
}

// The library and path that own the module path المسار (`a/b/c.sn`, canonical
// names) of the library الجذر, after the re-exports on it: for a module the
// compiler itself needs (driver/compiler_driver.sn). Without a re-export on
// it, the path is الجذر's.
عام عرف مالك_مسار_معاد_تصديره(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة,
    المسار: &متجه ط8
): معرف_جذر_مكتبة {
    ليكن الذاكرة: متغير ذاكرة_تهجئات_الوحدات = ذاكرة_تهجئات_وحدات_جديدة();
    ليكن المصادر: متغير خريطة_مصادر = خريطة_مصادر_جديدة();
    ليكن الأجزاء: متغير متجه متجه ط8 = أجزاء_مرجع(المسار);
    ليكن العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
    ليكن بامتداد: منطقي = ينتهي_بامتداد_سلطان(&الأجزاء[العدد - 1]);
    إذا (بامتداد) {
        ليكن الأخير: متجه ط8 = بلا_امتداد_سلطان(&الأجزاء[العدد - 1]);
        الأجزاء[العدد - 1] := الأخير;
    };
    طابق امش_مسار_بالتهجئات(&متغير الذاكرة, &متغير المصادر, البيئة, الجذر, الأجزاء, 0, بامتداد, المسار) مع
    | نتيجة.نجح(المقنن) -> {
        طابق المقنن.الجذر مع
        | اختياري.موجود(المالك) -> { أرجع المالك; }
        | اختياري.لا_شيء -> { أرجع الجذر; };
    }
    | نتيجة.خطأ(_) -> { أرجع الجذر; };
}

// The modules a folder's root file re-exports, each with the key of the
// library that owns it (std.text's compare is core's text/compare.sn): the
// selective import `from std.text import contains;` sees them as members of
// the folder, with the folder's own files (source_locator.sn). A re-exported
// folder is not a member, as a subfolder is not.
عام عرف أعضاء_معاد_تصديرها_في_مجلد(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة,
    مسار_المجلد: &متجه ط8
): متجه مفتاح_وحدة_مقنن {
    ليكن الناتج: متغير متجه مفتاح_وحدة_مقنن = [];
    ليكن المجلد: متغير نص;
    طابق جذر_مصدر_لمعرف(البيئة, الجذر) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(القيمة) -> { المجلد := القيمة; };
    ليكن ملف_الجذر: متغير اختياري نص = ملف_جذر_الحزمة(البيئة, الجذر, &المجلد);
    إذا ((الطول(*مسار_المجلد) مثل طبيعي) > 0) {
        ليكن أجزاء_المجلد: متجه متجه ط8 = أجزاء_مرجع(مسار_المجلد);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(أجزاء_المجلد) مثل طبيعي)) {
            ليكن اسم_الجزء: نص = من_بايتات(&أجزاء_المجلد[ف]);
            المجلد := صل_المسار(&المجلد, &اسم_الجزء);
            ملف_الجذر := اختياري.موجود(ملف_جذر_مجلد(&المجلد, &أجزاء_المجلد[ف]));
            ف := ف + 1;
        }
    };
    ليكن الملف: نص;
    طابق ملف_الجذر مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(القيمة) -> { الملف := القيمة; };
    ليكن المحتوى: نص;
    طابق نص_ملف_جذر(البيئة, &الملف) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(القيمة) -> { المحتوى := القيمة; };
    ليكن المقروء: تهجئات_مجلد = اقرأ_تهجئات_ملف_جذر(&المجلد, &الملف, &المحتوى);
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول(المقروء.إعادات_التصدير) مثل طبيعي)) {
        ليكن المسار: متغير متجه ط8 = انسخ_بايتات(مسار_المجلد);
        إذا ((الطول(المسار) مثل طبيعي) > 0) { ألحق(المسار, 0x2F); };
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول(المقروء.إعادات_التصدير[ر].الابن) مثل طبيعي)) {
            ألحق(المسار, المقروء.إعادات_التصدير[ر].الابن[ح]);
            ح := ح + 1;
        }
        ألحق_بايتات_نص(&متغير المسار, «.sn»);
        ليكن الذاكرة: متغير ذاكرة_تهجئات_الوحدات = ذاكرة_تهجئات_وحدات_جديدة();
        ليكن المصادر: متغير خريطة_مصادر = خريطة_مصادر_جديدة();
        ليكن الأجزاء: متغير متجه متجه ط8 = أجزاء_مرجع(&المسار);
        ليكن العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
        ليكن الأخير: متجه ط8 = بلا_امتداد_سلطان(&الأجزاء[العدد - 1]);
        الأجزاء[العدد - 1] := الأخير;
        طابق امش_مسار_بالتهجئات(&متغير الذاكرة, &متغير المصادر, البيئة, الجذر, الأجزاء, 0, صواب, &المسار) مع
        | نتيجة.نجح(المقنن) -> {
            طابق المقنن.الجذر مع
            | اختياري.موجود(المالك) -> {
                طابق قنن_مسار_وحدة_منطقي(&المقنن.المرجع) مع
                | نتيجة_مسار_وحدة_منطقي.صالح(المنطقي) -> {
                    إذا (ملف_وحدة_في_جذر(البيئة, المالك, &المنطقي)) {
                        ألحق(الناتج, مفتاح_وحدة_مقنن_من(المالك, المنطقي));
                    };
                }
                | نتيجة_مسار_وحدة_منطقي.غير_صالح -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | نتيجة.خطأ(_) -> { };
        ر := ر + 1;
    }
    أرجع الناتج;
}

// Whether the module المفتاح is a root file: FOLDER/FOLDER.sn, or the
// package root file PACKAGE.sn directly in its source root.
عام عرف وحدة_ملف_جذر(البيئة: &بيئة_وحدات_منطقية, المفتاح: &مفتاح_وحدة_مقنن): منطقي {
    ليكن الأجزاء: &متجه جزء_مسار_وحدة_منطقي = &(*المفتاح).المسار.الأجزاء;
    ليكن العدد: طبيعي = الطول(*الأجزاء) مثل طبيعي;
    إذا (العدد == 0) { أرجع خطأ; };
    ليكن المتوقع: متغير متجه ط8 = [];
    إذا (العدد == 1) {
        طابق اسم_حزمة_لجذر(البيئة, (*المفتاح).الجذر) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الاسم) -> { المتوقع := الاسم; };
    } وإلا {
        المتوقع := انسخ_بايتات(&(*الأجزاء)[العدد - 2].البايتات);
    };
    ألحق_بايتات_نص(&متغير المتوقع, «.sn»);
    أرجع متجها_بايتات_متساويان(&(*الأجزاء)[العدد - 1].البايتات, &المتوقع);
}

// The root file of the folder that holds the module المفتاح, where its
// `module` declarations belong; none for a standalone file's directory.
عام عرف ملف_جذر_مجلد_الوحدة(البيئة: &بيئة_وحدات_منطقية, المفتاح: &مفتاح_وحدة_مقنن): اختياري نص {
    ليكن الأجزاء: &متجه جزء_مسار_وحدة_منطقي = &(*المفتاح).المسار.الأجزاء;
    ليكن العدد: طبيعي = الطول(*الأجزاء) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    ليكن المجلد: متغير نص;
    طابق جذر_مصدر_لمعرف(البيئة, (*المفتاح).الجذر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { المجلد := القيمة; };
    إذا (العدد == 1) { أرجع ملف_جذر_الحزمة(البيئة, (*المفتاح).الجذر, &المجلد); };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف + 1 < العدد) {
        ليكن الاسم: نص = من_بايتات(&(*الأجزاء)[ف].البايتات);
        المجلد := صل_المسار(&المجلد, &الاسم);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(ملف_جذر_مجلد(&المجلد, &(*الأجزاء)[العدد - 2].البايتات));
}
