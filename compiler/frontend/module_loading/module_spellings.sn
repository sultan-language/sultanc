استورد std.fs.path;
استورد std.fs.directory;
استورد std.fs.read_file;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.bytes.compare;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.source.span;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.token_registry;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.source_provider;

// Module spellings. A folder's root file declares spellings of the folder's
// direct children, by name as on disk (a NAME.sn file or a NAME folder):
//
//   module io { ar: دخ, fr: entree_sortie, es: entrada_salida };
//   وحدة نصوص_مثال { en: sample };
//
// A folder's root file is FOLDER/FOLDER.sn; a package's source root has the
// root file SOURCE_ROOT/PACKAGE.sn (std: library/std/std.sn). Only a root
// file may hold `module` declarations.
//
// An import path is canonicalized component by component before it is
// resolved: in `المكتبة.دخ.print`, the root spelling المكتبة names std (the
// logical environment), std.sn maps دخ to io, and io/io.sn may map print;
// a name no root file maps stays as written. A spelling is one more name of
// one module, never a second module identity. Each root file is read once,
// for its `module` lines only, and kept in ذاكرة_تهجئات_الوحدات, which a
// loader owns for its compilation; incremental analysis can keep it.

عام نوع تهجئة_ابن_وحدة = {
    التهجئة: متجه ط8,
    الابن: متجه ط8
};

عام نوع صنف_خطأ_تهجئة_وحدة =
    // `module x` and the folder has no x.sn and no x/.
    | ابن_غير_موجود
    // One spelling for two children, or a spelling that is another child's name.
    | تهجئة_مشتركة
    // A reserved word of the language as a spelling.
    | كلمة_محجوزة
;

// النطاق is in the root file, registered in the SourceMap for the diagnostic.
عام نوع خطأ_تهجئة_وحدة = {
    الصنف: صنف_خطأ_تهجئة_وحدة,
    النطاق: نطاق
};

// The spellings one root file declares. The text is kept only with an
// error, until the diagnostic registers it once (معرف_المصدر).
عام نوع تهجئات_مجلد = {
    ملف_الجذر: نص,
    التهجئات: متجه تهجئة_ابن_وحدة,
    الخطأ: اختياري خطأ_تهجئة_وحدة,
    المحتوى: نص,
    معرف_المصدر: اختياري طبيعي
};

عام نوع ذاكرة_تهجئات_الوحدات = {
    المجلدات: متجه تهجئات_مجلد
};

عام عرف ذاكرة_تهجئات_وحدات_جديدة(): ذاكرة_تهجئات_الوحدات {
    دع المجلدات: متجه تهجئات_مجلد = [];
    دع الذاكرة: ذاكرة_تهجئات_الوحدات = { المجلدات: المجلدات };
    أرجع الذاكرة;
}

عرف بايتات_نطاق_رمز(المحتوى: &نص, النطاق: نطاق): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = النطاق.البداية.البايت مثل طبيعي;
    دع النهاية: طبيعي = النطاق.النهاية.البايت مثل طبيعي;
    طالما (ف < النهاية && ف < (الطول(*المحتوى) مثل طبيعي)) {
        ألحق(الناتج, (*المحتوى)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// A NAME.sn file or a NAME folder in المجلد.
عرف ابن_موجود_في_مجلد(المجلد: &نص, الاسم: &متجه ط8): منطقي {
    دع اسم_النص: نص = من_بايتات(الاسم);
    دع الدليل: نص = صل_المسار(المجلد, &اسم_النص);
    طابق حاول_مسار_دليل(&الدليل) مع
    | نتيجة.نجح(صواب) -> { أرجع صواب; }
    | _ -> { };
    دع بايتات_الملف: متغير متجه ط8 = انسخ_بايتات(الاسم);
    ألحق_بايتات_نص(&متغير بايتات_الملف, «.sn»);
    دع اسم_الملف: نص = من_بايتات(&بايتات_الملف);
    دع الملف: نص = صل_المسار(المجلد, &اسم_الملف);
    طابق حاول_مسار_ملف(&الملف) مع
    | نتيجة.نجح(موجود) -> { أرجع موجود; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف هل_اسم_تصريح_وحدة(النوع: رمز): منطقي {
    أرجع النوع == رمز.معرف() || هل_كلمة_محجوزة(النوع);
}

عرف خطأ_تهجئة_عند(الصنف: صنف_خطأ_تهجئة_وحدة, النطاق: نطاق): اختياري خطأ_تهجئة_وحدة {
    دع الخطأ: خطأ_تهجئة_وحدة = { الصنف: الصنف, النطاق: النطاق };
    أرجع اختياري.موجود(الخطأ);
}

// The child a spelling already names in التهجئات, if any.
عرف ابن_تهجئة(التهجئات: &متجه تهجئة_ابن_وحدة, التهجئة: &متجه ط8): اختياري متجه ط8 {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التهجئات) مثل طبيعي)) {
        إذا (متجها_بايتات_متساويان(&(*التهجئات)[ف].التهجئة, التهجئة)) {
            أرجع اختياري.موجود(انسخ_بايتات(&(*التهجئات)[ف].الابن));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The spellings and the first error of the `module` declarations in الرموز,
// checked against المجلد. A declaration the parser would reject is left to
// the parser: reading stops there without an error.
عرف اقرأ_تهجئات_رموز(
    المجلد: &نص,
    المحتوى: &نص,
    الرموز: &متجه رمز_مصدر,
    التهجئات: &متغير متجه تهجئة_ابن_وحدة
): اختياري خطأ_تهجئة_وحدة {
    دع الخطأ: متغير اختياري خطأ_تهجئة_وحدة = اختياري.لا_شيء();
    دع العدد: طبيعي = الطول(*الرموز) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر && ف < العدد) {
        إذا ((*الرموز)[ف].النوع != رمز.تصريح_وحدة()) {
            ف := ف + 1;
        } وإلا إذا (ف + 2 >= العدد
            || !هل_اسم_تصريح_وحدة((*الرموز)[ف + 1].النوع)
            || (*الرموز)[ف + 2].النوع != رمز.معقوف_يسار()) {
            مستمر := خطأ;
        } وإلا {
            دع نطاق_الابن: نطاق = (*الرموز)[ف + 1].النطاق;
            دع الابن: متجه ط8 = بايتات_نطاق_رمز(المحتوى, نطاق_الابن);
            إذا (!ابن_موجود_في_مجلد(المجلد, &الابن)) {
                الخطأ := خطأ_تهجئة_عند(صنف_خطأ_تهجئة_وحدة.ابن_غير_موجود(), نطاق_الابن);
                مستمر := خطأ;
            };
            ف := ف + 3;
            // lang `:` spelling, separated by `,`.
            طالما (مستمر && ف < العدد && (*الرموز)[ف].النوع != رمز.معقوف_يمين()) {
                إذا (ف + 2 >= العدد
                    || (*الرموز)[ف].النوع != رمز.معرف()
                    || (*الرموز)[ف + 1].النوع != رمز.نقطتان()
                    || !هل_اسم_تصريح_وحدة((*الرموز)[ف + 2].النوع)) {
                    مستمر := خطأ;
                } وإلا {
                    دع نطاق_التهجئة: نطاق = (*الرموز)[ف + 2].النطاق;
                    دع التهجئة: متجه ط8 = بايتات_نطاق_رمز(المحتوى, نطاق_التهجئة);
                    إذا (هل_كلمة_محجوزة((*الرموز)[ف + 2].النوع)) {
                        الخطأ := خطأ_تهجئة_عند(صنف_خطأ_تهجئة_وحدة.كلمة_محجوزة(), نطاق_التهجئة);
                        مستمر := خطأ;
                    } وإلا إذا (!متجها_بايتات_متساويان(&التهجئة, &الابن)) {
                        دع مشتركة: متغير منطقي = ابن_موجود_في_مجلد(المجلد, &التهجئة);
                        طابق ابن_تهجئة(التهجئات, &التهجئة) مع
                        | اختياري.موجود(السابق) -> {
                            إذا (!متجها_بايتات_متساويان(&السابق, &الابن)) { مشتركة := صواب; };
                        }
                        | اختياري.لا_شيء -> {
                            دع الجديدة: تهجئة_ابن_وحدة = {
                                التهجئة: انسخ_بايتات(&التهجئة), الابن: انسخ_بايتات(&الابن)
                            };
                            ألحق(*التهجئات, الجديدة);
                        };
                        إذا (مشتركة) {
                            الخطأ := خطأ_تهجئة_عند(صنف_خطأ_تهجئة_وحدة.تهجئة_مشتركة(), نطاق_التهجئة);
                            مستمر := خطأ;
                        };
                    };
                    ف := ف + 3;
                    إذا (ف < العدد && (*الرموز)[ف].النوع == رمز.فاصلة()) { ف := ف + 1; };
                };
            }
        };
    }
    أرجع الخطأ;
}

// The `module` declarations of a root file, read once (تهجئات_مجلد_مخزنة).
عام عرف اقرأ_تهجئات_ملف_جذر(
    المجلد: &نص,
    ملف_الجذر: &نص,
    المحتوى: &نص
): تهجئات_مجلد {
    دع التهجئات: متغير متجه تهجئة_ابن_وحدة = [];
    دع الخطأ: متغير اختياري خطأ_تهجئة_وحدة = اختياري.لا_شيء();
    دع المصدر: مصدر = مصدر_جديد(0, انسخ_نص(ملف_الجذر), انسخ_نص(المحتوى));
    طابق حلل_معجميا(&المصدر) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        الخطأ := اقرأ_تهجئات_رموز(المجلد, المحتوى, &السلسلة.الرموز, &متغير التهجئات);
    };
    دع المحتوى_المحفوظ: متغير نص = «»;
    طابق الخطأ مع
    | اختياري.موجود(_) -> { المحتوى_المحفوظ := انسخ_نص(المحتوى); }
    | اختياري.لا_شيء -> { };
    دع الناتج: تهجئات_مجلد = {
        ملف_الجذر: انسخ_نص(ملف_الجذر),
        التهجئات: التهجئات,
        الخطأ: الخطأ,
        المحتوى: المحتوى_المحفوظ,
        معرف_المصدر: اختياري.لا_شيء()
    };
    أرجع الناتج;
}

// The text of a root file: an open editor's text first, else the file; none
// when there is no such file.
عرف نص_ملف_جذر(البيئة: &بيئة_وحدات_منطقية, المسار: &نص): اختياري نص {
    دع التراكب: نتيجة_محتوى_تراكب_مصدر = محتوى_تراكب_مصدر(&(*البيئة).مزود_المصادر, المسار);
    إذا (التراكب.موجود) { أرجع اختياري.موجود(انسخ_نص(&التراكب.المحتوى)); };
    طابق حاول_مسار_ملف(المسار) مع
    | نتيجة.نجح(صواب) -> { }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.نجح(النص) -> { أرجع اختياري.موجود(النص); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// The cached spellings of the folder whose root file is ملف_الجذر, read on
// first use. The result is its position in الذاكرة.
عرف تهجئات_مجلد_مخزنة(
    الذاكرة: &متغير ذاكرة_تهجئات_الوحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المجلد: &نص,
    ملف_الجذر: &نص
): طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).المجلدات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الذاكرة).المجلدات[ف].ملف_الجذر, ملف_الجذر)) { أرجع ف; };
        ف := ف + 1;
    }
    دع المدخل: تهجئات_مجلد;
    طابق نص_ملف_جذر(البيئة, ملف_الجذر) مع
    | اختياري.موجود(المحتوى) -> {
        المدخل := اقرأ_تهجئات_ملف_جذر(المجلد, ملف_الجذر, &المحتوى);
    }
    | اختياري.لا_شيء -> {
        دع بلا_تهجئات: متجه تهجئة_ابن_وحدة = [];
        دع الفارغ: تهجئات_مجلد = {
            ملف_الجذر: انسخ_نص(ملف_الجذر), التهجئات: بلا_تهجئات, الخطأ: اختياري.لا_شيء(),
            المحتوى: «», معرف_المصدر: اختياري.لا_شيء()
        };
        المدخل := الفارغ;
    };
    ألحق((*الذاكرة).المجلدات, المدخل);
    أرجع (الطول((*الذاكرة).المجلدات) مثل طبيعي) - 1;
}

// The error of a cached root file, its text registered in the SourceMap once
// so the diagnostic points into it.
عرف خطأ_مجلد_مسجل(
    الذاكرة: &متغير ذاكرة_تهجئات_الوحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    الموضع: طبيعي
): اختياري خطأ_تهجئة_وحدة {
    دع الخطأ: خطأ_تهجئة_وحدة;
    طابق (*الذاكرة).المجلدات[الموضع].الخطأ مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الخطأ := القيمة; };
    دع المعرف: طبيعي;
    طابق (*الذاكرة).المجلدات[الموضع].معرف_المصدر مع
    | اختياري.موجود(القيمة) -> { المعرف := القيمة; }
    | اختياري.لا_شيء -> {
        المعرف := أضف_مصدر_إلى_خريطة(
            سياق_المصادر,
            انسخ_نص(&(*الذاكرة).المجلدات[الموضع].ملف_الجذر),
            انسخ_نص(&(*الذاكرة).المجلدات[الموضع].المحتوى)
        );
        (*الذاكرة).المجلدات[الموضع].معرف_المصدر := اختياري.موجود(المعرف);
    };
    دع البداية: موضع = { المصدر: المعرف مثل ط32, البايت: الخطأ.النطاق.البداية.البايت };
    دع النهاية: موضع = { المصدر: المعرف مثل ط32, البايت: الخطأ.النطاق.النهاية.البايت };
    دع المسجل: خطأ_تهجئة_وحدة = { الصنف: الخطأ.الصنف, النطاق: نطاق_بين(البداية, النهاية) };
    أرجع اختياري.موجود(المسجل);
}

عرف أجزاء_مرجع(المرجع: &متجه ط8): متجه متجه ط8 {
    دع الأجزاء: متغير متجه متجه ط8 = [];
    دع الجزء: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف <= (الطول(*المرجع) مثل طبيعي)) {
        إذا (ف == (الطول(*المرجع) مثل طبيعي) || (*المرجع)[ف] == 0x2F) {
            ألحق(الأجزاء, الجزء);
            دع فارغ: متجه ط8 = [];
            الجزء := فارغ;
        } وإلا {
            ألحق(الجزء, (*المرجع)[ف]);
        };
        ف := ف + 1;
    }
    أرجع الأجزاء;
}

عرف ينتهي_بامتداد_سلطان(الجزء: &متجه ط8): منطقي {
    دع الامتداد: متجه ط8 = بايتات_من_نص(«.sn»);
    أرجع (الطول(*الجزء) مثل طبيعي) > 3 && تنتهي_البايتات_بـ(الجزء, &الامتداد);
}

عرف بلا_امتداد_سلطان(الجزء: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف + 3 < (الطول(*الجزء) مثل طبيعي)) {
        ألحق(الناتج, (*الجزء)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The root file of a package's source root, or none for a root without a
// package name (a standalone file's directory).
عرف ملف_جذر_الحزمة(البيئة: &بيئة_وحدات_منطقية, الجذر: معرف_جذر_مكتبة, جذر_المصدر: &نص): اختياري نص {
    طابق اسم_حزمة_لجذر(البيئة, الجذر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        دع البايتات: متغير متجه ط8 = انسخ_بايتات(&الاسم);
        ألحق_بايتات_نص(&متغير البايتات, «.sn»);
        دع الملف: نص = من_بايتات(&البايتات);
        أرجع اختياري.موجود(صل_المسار(جذر_المصدر, &الملف));
    };
}

عرف ملف_جذر_مجلد(المجلد: &نص, الاسم: &متجه ط8): نص {
    دع البايتات: متغير متجه ط8 = انسخ_بايتات(الاسم);
    ألحق_بايتات_نص(&متغير البايتات, «.sn»);
    دع الملف: نص = من_بايتات(&البايتات);
    أرجع صل_المسار(المجلد, &الملف);
}

// المرجع (a named import reference, `/`-separated, ending in `.sn` or not)
// with every spelling replaced by its canonical name. The first component
// stays when it names a library root (std, a dependency); the components
// after it are looked up from that root's source root. Unbound, every
// component is looked up from the importer's own source root.
عام عرف قنن_مرجع_بالتهجئات(
    الذاكرة: &متغير ذاكرة_تهجئات_الوحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: &مفتاح_وحدة_مقنن,
    المرجع: &متجه ط8
): نتيجة متجه ط8, خطأ_تهجئة_وحدة {
    طابق صنف_مرجع_استيراد(المرجع) مع
    | تصنيف_مرجع_استيراد.جذر_مسمى -> { }
    | _ -> { أرجع نتيجة.نجح(انسخ_بايتات(المرجع)); };
    دع الأجزاء: متغير متجه متجه ط8 = أجزاء_مرجع(المرجع);
    دع العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
    دع بامتداد: منطقي = ينتهي_بامتداد_سلطان(&الأجزاء[العدد - 1]);
    إذا (بامتداد) {
        دع الأخير: متجه ط8 = بلا_امتداد_سلطان(&الأجزاء[العدد - 1]);
        الأجزاء[العدد - 1] := الأخير;
    };

    دع الجذر: متغير معرف_جذر_مكتبة = (*المستورد).الجذر;
    دع البداية: متغير طبيعي = 0;
    طابق حل_اسم_جذر_مفصل(البيئة, (*المستورد).الجذر, &الأجزاء[0]) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الحل) -> {
        إذا (الحل.يستهلك_التهجئة || !معرفا_جذر_مكتبة_متساويان(الحل.الجذر, (*المستورد).الجذر)) {
            الجذر := الحل.الجذر;
            البداية := 1;
        };
    };
    دع المجلد: متغير نص;
    طابق جذر_مصدر_لمعرف(البيئة, الجذر) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(انسخ_بايتات(المرجع)); }
    | اختياري.موجود(القيمة) -> { المجلد := القيمة; };
    دع ملف_الجذر: متغير اختياري نص = ملف_جذر_الحزمة(البيئة, الجذر, &المجلد);
    دع تغير: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < العدد) {
        طابق ملف_الجذر مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الملف) -> {
            دع الموضع: طبيعي = تهجئات_مجلد_مخزنة(الذاكرة, البيئة, &المجلد, &الملف);
            طابق خطأ_مجلد_مسجل(الذاكرة, سياق_المصادر, الموضع) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق ابن_تهجئة(&(*الذاكرة).المجلدات[الموضع].التهجئات, &الأجزاء[ف]) مع
            | اختياري.موجود(الابن) -> { الأجزاء[ف] := الابن; تغير := صواب; }
            | اختياري.لا_شيء -> { };
        };
        دع اسم_الجزء: نص = من_بايتات(&الأجزاء[ف]);
        دع التالي: نص = صل_المسار(&المجلد, &اسم_الجزء);
        ملف_الجذر := اختياري.موجود(ملف_جذر_مجلد(&التالي, &الأجزاء[ف]));
        المجلد := التالي;
        ف := ف + 1;
    }
    إذا (!تغير) { أرجع نتيجة.نجح(انسخ_بايتات(المرجع)); };
    دع الناتج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < العدد) {
        إذا (ف > 0) { ألحق(الناتج, 0x2F); };
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(الأجزاء[ف]) مثل طبيعي)) {
            ألحق(الناتج, الأجزاء[ف][ح]);
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    إذا (بامتداد) { ألحق_بايتات_نص(&متغير الناتج, «.sn»); };
    أرجع نتيجة.نجح(الناتج);
}

// Whether the module المفتاح is a root file: FOLDER/FOLDER.sn, or the
// package root file PACKAGE.sn directly in its source root.
عام عرف وحدة_ملف_جذر(البيئة: &بيئة_وحدات_منطقية, المفتاح: &مفتاح_وحدة_مقنن): منطقي {
    دع الأجزاء: &متجه جزء_مسار_وحدة_منطقي = &(*المفتاح).المسار.الأجزاء;
    دع العدد: طبيعي = الطول(*الأجزاء) مثل طبيعي;
    إذا (العدد == 0) { أرجع خطأ; };
    دع المتوقع: متغير متجه ط8 = [];
    إذا (العدد == 1) {
        طابق اسم_حزمة_لجذر(البيئة, (*المفتاح).الجذر) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الاسم) -> { المتوقع := الاسم; };
    } وإلا {
        المتوقع := انسخ_بايتات(&(*الأجزاء)[العدد - 2].البايتات);
    };
    ألحق_بايتات_نص(&متغير المتوقع, «.sn»);
    أرجع متجها_بايتات_متساويان(&(*الأجزاء)[العدد - 1].البايتات, &المتوقع);
}

// The root file of the folder that holds the module المفتاح, where its
// `module` declarations belong; none for a standalone file's directory.
عام عرف ملف_جذر_مجلد_الوحدة(البيئة: &بيئة_وحدات_منطقية, المفتاح: &مفتاح_وحدة_مقنن): اختياري نص {
    دع الأجزاء: &متجه جزء_مسار_وحدة_منطقي = &(*المفتاح).المسار.الأجزاء;
    دع العدد: طبيعي = الطول(*الأجزاء) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع المجلد: متغير نص;
    طابق جذر_مصدر_لمعرف(البيئة, (*المفتاح).الجذر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { المجلد := القيمة; };
    إذا (العدد == 1) { أرجع ملف_جذر_الحزمة(البيئة, (*المفتاح).الجذر, &المجلد); };
    دع ف: متغير طبيعي = 0;
    طالما (ف + 1 < العدد) {
        دع الاسم: نص = من_بايتات(&(*الأجزاء)[ف].البايتات);
        المجلد := صل_المسار(&المجلد, &الاسم);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(ملف_جذر_مجلد(&المجلد, &(*الأجزاء)[العدد - 2].البايتات));
}
