استورد std.text.from_bytes;
استورد std.text.compare;
// Canonical source-content provider. Physical source identity remains the
// registered source path; an active overlay changes only the bytes supplied
// to the existing frontend pipeline.
عام نوع تراكب_مصدر = {
    المسار: نص,
    المحتوى: نص,
    نشط: منطقي
};

عام نوع مزود_مصادر = {
    التراكبات: متجه تراكب_مصدر
};

عام نوع نتيجة_محتوى_تراكب_مصدر = {
    موجود: منطقي,
    المحتوى: نص
};

عام عرف مزود_مصادر_جديد(): مزود_مصادر {
    دع التراكبات: متجه تراكب_مصدر = [];
    دع المزود: مزود_مصادر = { التراكبات: التراكبات };
    أرجع المزود;
}


عام عرف موضع_تراكب_مصدر(
    المزود: &مزود_مصادر,
    المسار: &نص
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المزود).التراكبات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*المزود).التراكبات[ف].المسار, المسار)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Replaces bytes for the same canonical physical source path. It does not
// allocate a second SourceID or Module identity.
عام عرف ضع_تراكب_مصدر(
    المزود: &متغير مزود_مصادر,
    المسار: نص,
    المحتوى: نص
): فراغ {
    طابق موضع_تراكب_مصدر(المزود, &المسار) مع
    | اختياري.موجود(الفهرس) -> {
        دع التراكب: تراكب_مصدر = {
            المسار: المسار,
            المحتوى: المحتوى,
            نشط: صواب
        };
        (*المزود).التراكبات[الفهرس] := التراكب;
    }
    | اختياري.لا_شيء -> {
        دع التراكب: تراكب_مصدر = {
            المسار: المسار,
            المحتوى: المحتوى,
            نشط: صواب
        };
        ألحق((*المزود).التراكبات, التراكب);
    };
}

عام عرف أزل_تراكب_مصدر(
    المزود: &متغير مزود_مصادر,
    المسار: &نص
): منطقي {
    طابق موضع_تراكب_مصدر(المزود, المسار) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الفهرس) -> {
        (*المزود).التراكبات[الفهرس].نشط := خطأ;
        أرجع صواب;
    };
}

عام عرف محتوى_تراكب_مصدر(
    المزود: &مزود_مصادر,
    المسار: &نص
): نتيجة_محتوى_تراكب_مصدر {
    طابق موضع_تراكب_مصدر(المزود, المسار) مع
    | اختياري.لا_شيء -> {
        دع النتيجة: نتيجة_محتوى_تراكب_مصدر = { موجود: خطأ, المحتوى: «» };
        أرجع النتيجة;
    }
    | اختياري.موجود(الفهرس) -> {
        إذا (!(*المزود).التراكبات[الفهرس].نشط) {
            دع النتيجة: نتيجة_محتوى_تراكب_مصدر = { موجود: خطأ, المحتوى: «» };
            أرجع النتيجة;
        };
        دع مرجع_المحتوى: &نص = &(*المزود).التراكبات[الفهرس].المحتوى;
        دع المحتوى: نص = انسخ_نص(مرجع_المحتوى);
        دع النتيجة: نتيجة_محتوى_تراكب_مصدر = { موجود: صواب, المحتوى: المحتوى };
        أرجع النتيجة;
    };
}
