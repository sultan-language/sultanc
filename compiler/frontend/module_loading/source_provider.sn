استورد std.text.compare;
// Canonical source-content provider. Physical source identity remains the
// registered source path; an active overlay changes only the bytes supplied
// to the existing frontend pipeline.
عام نوع تراكب_مصدر = {
    المسار: نص,
    المحتوى: نص,
    نشط: منطقي
};

عام نوع مزود_مصادر = {
    التراكبات: متجه تراكب_مصدر
};

عام نوع نتيجة_محتوى_تراكب_مصدر = {
    موجود: منطقي,
    المحتوى: نص
};

عام عرف مزود_مصادر_جديد(): مزود_مصادر {
    دع التراكبات: متجه تراكب_مصدر = [];
    دع المزود: مزود_مصادر = { التراكبات: التراكبات };
    أرجع المزود;
}

عرف موضع_تراكب_مصدر(
    المزود: &مزود_مصادر,
    المسار: &نص
): اختيار غير_موقع {
    دع الحالة: مزود_مصادر = *المزود;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.التراكبات) مثل غير_موقع)) {
        لو (نصان_متساويان(&الحالة.التراكبات[ف].المسار, المسار)) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

// Replaces bytes for the same canonical physical source path. It does not
// allocate a second SourceID or Module identity.
عام عرف ضع_تراكب_مصدر(
    المزود: &متغير مزود_مصادر,
    المسار: نص,
    المحتوى: نص
): فراغ {
    دع الحالة: متغير مزود_مصادر = *المزود;
    طابق موضع_تراكب_مصدر(&الحالة, &المسار) مع
    | اختيار.بعض(الفهرس) -> {
        دع التراكب: تراكب_مصدر = {
            المسار: المسار,
            المحتوى: المحتوى,
            نشط: صواب
        };
        الحالة.التراكبات[الفهرس] := التراكب;
    }
    | اختيار.لا_شيء -> {
        دع التراكب: تراكب_مصدر = {
            المسار: المسار,
            المحتوى: المحتوى,
            نشط: صواب
        };
        ألحق(الحالة.التراكبات, التراكب);
    };
    *المزود := الحالة;
}

عام عرف أزل_تراكب_مصدر(
    المزود: &متغير مزود_مصادر,
    المسار: &نص
): منطقي {
    دع الحالة: متغير مزود_مصادر = *المزود;
    طابق موضع_تراكب_مصدر(&الحالة, المسار) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الفهرس) -> {
        الحالة.التراكبات[الفهرس].نشط := خطأ;
        *المزود := الحالة;
        أرجع صواب;
    };
}

عام عرف محتوى_تراكب_مصدر(
    المزود: &مزود_مصادر,
    المسار: &نص
): نتيجة_محتوى_تراكب_مصدر {
    طابق موضع_تراكب_مصدر(المزود, المسار) مع
    | اختيار.لا_شيء -> {
        دع النتيجة: نتيجة_محتوى_تراكب_مصدر = { موجود: خطأ, المحتوى: «» };
        أرجع النتيجة;
    }
    | اختيار.بعض(الفهرس) -> {
        دع الحالة: مزود_مصادر = *المزود;
        لو (!الحالة.التراكبات[الفهرس].نشط) {
            دع النتيجة: نتيجة_محتوى_تراكب_مصدر = { موجود: خطأ, المحتوى: «» };
            أرجع النتيجة;
        };
        دع مرجع_المحتوى: &نص = &الحالة.التراكبات[الفهرس].المحتوى;
        دع المحتوى: نص = *مرجع_المحتوى;
        دع النتيجة: نتيجة_محتوى_تراكب_مصدر = { موجود: صواب, المحتوى: المحتوى };
        أرجع النتيجة;
    };
}
