استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.library_root_identity;

// Package metadata is supplied by Driver package configuration. This owner only
// adapts validated textual spellings into the canonical logical environment.
// It does not own std names, source membership, or intrinsic authorization.
عام عرف بايتات_نص_بيانات_وحدة(النص: &نص): متجه غ8 {
    دع الأصل: نص = *النص;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأصل) مثل غير_موقع)) {
        ألحق(الناتج, الأصل[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف سجل_تهجئة_جذر_معلنة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    الجذر_الهدف: معرف_جذر_مكتبة,
    التهجئة: &نص,
    تستهلك_التهجئة: منطقي
): منطقي {
    دع البايتات: متجه غ8 = بايتات_نص_بيانات_وحدة(التهجئة);
    لو (تستهلك_التهجئة) {
        طابق أضف_ربط_اسم_جذر_مستهلك(
            البيئة, الجذر_المرئي, البايتات, الجذر_الهدف
        ) مع
        | نتيجة_ربط_جذر.أضيف -> { أرجع صواب; }
        | نتيجة_ربط_جذر.موجود -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
    طابق أضف_ربط_اسم_جذر(
        البيئة, الجذر_المرئي, البايتات, الجذر_الهدف
    ) مع
    | نتيجة_ربط_جذر.أضيف -> { أرجع صواب; }
    | نتيجة_ربط_جذر.موجود -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف سجل_تهجئة_حزمة_معلنة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_الهدف: معرف_جذر_مكتبة,
    المسار_المقنن: &نص,
    المسار_المرئي: &نص
): منطقي {
    دع بايتات_مقننة: متجه غ8 = بايتات_نص_بيانات_وحدة(المسار_المقنن);
    دع بايتات_مرئية: متجه غ8 = بايتات_نص_بيانات_وحدة(المسار_المرئي);
    أرجع أضف_ربط_اسم_حزمة(
        البيئة, الجذر_الهدف, بايتات_مرئية, بايتات_مقننة
    );
}
