استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.module_paths;
استورد std.text.from_bytes;
// Canonical built-in Module metadata. Driver supplies compilation inputs only;
// this owner records package membership and semantic intrinsic capability.
عرف بايتات_نص_بيانات_وحدة(النص: &نص): متجه غ8 {
    دع الأصل: نص = *النص;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأصل) مثل غير_موقع)) {
        ألحق(الناتج, الأصل[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف بايتات_مسار_عضو_حزمة(المجال: نص, الملف: نص): متجه غ8 {
    دع الناتج: متغير متجه غ8 = بايتات_نص_بيانات_وحدة(&المجال);
    ألحق(الناتج, 0x2F);
    دع بايتات_الملف: متجه غ8 = بايتات_نص_بيانات_وحدة(&الملف);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(بايتات_الملف) مثل غير_موقع)) {
        ألحق(الناتج, بايتات_الملف[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف جزء_منطقي_يساوي_نصا_في_بيانات_وحدة(
    الجزء: &جزء_مسار_وحدة_منطقي,
    المطلوب: نص
): منطقي {
    دع القيمة: جزء_مسار_وحدة_منطقي = *الجزء;
    دع النص: نص = المطلوب;
    لو ((الطول(القيمة.البايتات) مثل غير_موقع) != (الطول(النص) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.البايتات) مثل غير_موقع)) {
        لو (القيمة.البايتات[ف] != النص[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف مسار_وحدة_مضمنة_يساوي_ثلاثة(
    المسار: &مسار_وحدة_منطقي,
    أ: نص, ب: نص, ج: نص
): منطقي {
    دع القيمة: مسار_وحدة_منطقي = *المسار;
    لو ((الطول(القيمة.الأجزاء) مثل غير_موقع) != 3) { أرجع خطأ; };
    أرجع جزء_منطقي_يساوي_نصا_في_بيانات_وحدة(&القيمة.الأجزاء[0], أ)
        && جزء_منطقي_يساوي_نصا_في_بيانات_وحدة(&القيمة.الأجزاء[1], ب)
        && جزء_منطقي_يساوي_نصا_في_بيانات_وحدة(&القيمة.الأجزاء[2], ج);
}

عرف مسار_وحدة_مضمنة_يساوي_اثنين(
    المسار: &مسار_وحدة_منطقي,
    أ: نص, ب: نص
): منطقي {
    دع القيمة: مسار_وحدة_منطقي = *المسار;
    لو ((الطول(القيمة.الأجزاء) مثل غير_موقع) != 2) { أرجع خطأ; };
    أرجع جزء_منطقي_يساوي_نصا_في_بيانات_وحدة(&القيمة.الأجزاء[0], أ)
        && جزء_منطقي_يساوي_نصا_في_بيانات_وحدة(&القيمة.الأجزاء[1], ب);
}

عام عرف وحدة_مشروع_مضمنة_تسمح_بجسر_بدائي(
    المفتاح: &مفتاح_وحدة_مقنن
): منطقي {
    دع القيمة: مفتاح_وحدة_مقنن = *المفتاح;
    دع المسار: &مسار_وحدة_منطقي = &القيمة.المسار;
    لو (مسار_وحدة_مضمنة_يساوي_ثلاثة(المسار, «compiler», «runtime», «host_service_adapter.sn»)) { أرجع صواب; };
    لو (مسار_وحدة_مضمنة_يساوي_اثنين(المسار, «bootstrap», «finalize_stage1.sn»)) { أرجع صواب; };
    أرجع خطأ;
}

// Canonical semantic capability query. Registered package members carry their
// metadata in the logical environment; project modules are identified by their
// canonical logical ModuleKey, never by physical source paths.
عام عرف وحدة_مقننة_تسمح_بجسر_بدائي_داخلي(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): منطقي {
    لو (مفتاح_وحدة_يسمح_بجسر_بدائي_داخلي(البيئة, المفتاح)) {
        أرجع صواب;
    };
    أرجع وحدة_مشروع_مضمنة_تسمح_بجسر_بدائي(المفتاح);
}

عام عرف أضف_موقع_مصدر_وحدة_مضمنة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    مسار_ملف_المصدر: نص
): نتيجة_تسجيل_موقع_مصدر {
    دع النتيجة: نتيجة_تسجيل_موقع_مصدر = أضف_موقع_مصدر_وحدة(
        البيئة, المفتاح, مسار_ملف_المصدر
    );
    لو (وحدة_مشروع_مضمنة_تسمح_بجسر_بدائي(المفتاح)) {
        أضف_سماح_جسر_بدائي_داخلي(البيئة, المفتاح);
    };
    أرجع النتيجة;
}

عرف سجل_عضو_حزمة_قياسية(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_القياسي: معرف_جذر_مكتبة,
    المجال: &نص,
    الملف: نص,
    يسمح_بجسر_بدائي_داخلي: منطقي
): منطقي {
    دع قيمة_المجال: نص = *المجال;
    دع البايتات: متجه غ8 = بايتات_مسار_عضو_حزمة(قيمة_المجال, الملف);
    طابق قنن_مسار_وحدة_منطقي(&البايتات) مع
    | نتيجة_مسار_وحدة_منطقي.غير_صالح -> { أرجع خطأ; }
    | نتيجة_مسار_وحدة_منطقي.صالح(المسار) -> {
        دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(الجذر_القياسي, المسار);
        لو (يسمح_بجسر_بدائي_داخلي && !أضف_سماح_جسر_بدائي_داخلي(البيئة, &المفتاح)) {
            أرجع خطأ;
        };
        دع مسار_الحزمة: متجه غ8 = بايتات_نص_بيانات_وحدة(المجال);
        أرجع أضف_عضو_حزمة(البيئة, الجذر_القياسي, مسار_الحزمة, &المفتاح);
    };
}

عرف سجل_تهجئة_حزمة_قياسية(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_القياسي: معرف_جذر_مكتبة,
    المجال_المقنن: &نص,
    المجال_المرئي: &نص,
    الملف: نص
): منطقي {
    دع قيمة_المجال_المقنن: نص = *المجال_المقنن;
    دع بايتات_المفتاح: متجه غ8 = بايتات_مسار_عضو_حزمة(قيمة_المجال_المقنن, الملف);
    طابق قنن_مسار_وحدة_منطقي(&بايتات_المفتاح) مع
    | نتيجة_مسار_وحدة_منطقي.غير_صالح -> { أرجع خطأ; }
    | نتيجة_مسار_وحدة_منطقي.صالح(المسار) -> {
        دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(الجذر_القياسي, المسار);
        دع مسار_الحزمة_المرئي: متجه غ8 = بايتات_نص_بيانات_وحدة(المجال_المرئي);
        أرجع أضف_عضو_حزمة(البيئة, الجذر_القياسي, مسار_الحزمة_المرئي, &المفتاح);
    };
}

عام عرف سجل_مكتبة_سلطان_القياسية(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    مسار_جذر_المصدر: &نص
): منطقي {
    دع الجذر_القياسي: معرف_جذر_مكتبة = خصص_جذر_مكتبة(البيئة);
    طابق أضف_جذر_مصدر(البيئة, الجذر_القياسي, مسار_جذر_المصدر) مع
    | نتيجة_تسجيل_جذر_مصدر.أضيف -> { }
    | نتيجة_تسجيل_جذر_مصدر.موجود -> { }
    | _ -> { أرجع خطأ; };

    // Source spellings are aliases of one canonical std RootID.
    دع اسم_الجذر_الإنجليزي: نص = «std»;
    دع تهجئة_الجذر_الإنجليزية: متجه غ8 = بايتات_نص_بيانات_وحدة(&اسم_الجذر_الإنجليزي);
    طابق أضف_ربط_اسم_جذر(البيئة, الجذر_المرئي, تهجئة_الجذر_الإنجليزية, الجذر_القياسي) مع
    | نتيجة_ربط_جذر.أضيف -> { }
    | نتيجة_ربط_جذر.موجود -> { }
    | _ -> { أرجع خطأ; };

    دع اسم_الجذر_العربي: نص = «المكتبة»;
    دع تهجئة_الجذر_العربية: متجه غ8 = بايتات_نص_بيانات_وحدة(&اسم_الجذر_العربي);
    طابق أضف_ربط_اسم_جذر(البيئة, الجذر_المرئي, تهجئة_الجذر_العربية, الجذر_القياسي) مع
    | نتيجة_ربط_جذر.أضيف -> { }
    | نتيجة_ربط_جذر.موجود -> { }
    | _ -> { أرجع خطأ; };

    // Canonical ModuleKeys retain the stable English physical/logical package
    // paths. Arabic package spellings below are additional source aliases to
    // these exact same keys, never a second module graph.
    دع مجال_الإدخال_والإخراج: نص = «io»;
    دع مجال_الملفات: نص = «fs»;
    دع مجال_العملية: نص = «process»;
    دع مجال_النص: نص = «text»;
    دع مجال_الحروف: نص = «chars»;
    دع مجال_البايتات: نص = «bytes»;
    دع مجال_الترميز: نص = «encoding»;
    دع مجال_المجموعات: نص = «collections»;
    دع مجال_جسون: نص = «json»;
    دع مجال_العنوان_الموحد: نص = «uri»;
    دع مجال_الذاكرة: نص = «memory»;
    دع مجال_البيئة: نص = «env»;
    دع مجال_الوقت: نص = «time»;
    دع مجال_التشفير: نص = «crypto»;

    دع تهجئة_الإدخال_والإخراج_العربية: نص = «دخ»;
    دع تهجئة_الملفات_العربية: نص = «ملفات»;
    دع تهجئة_النص_العربية: نص = «نصوص»;
    دع تهجئة_الحروف_العربية: نص = «حروف»;
    دع تهجئة_البايتات_العربية: نص = «بايتات»;
    دع تهجئة_الترميز_العربية: نص = «ترميز»;
    دع تهجئة_الذاكرة_العربية: نص = «ذاكرة»;

    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الإدخال_والإخراج, «print.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الإدخال_والإخراج, «println.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الإدخال_والإخراج, «read_line.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الإدخال_والإخراج, «buffered_writer.sn», خطأ)) { أرجع خطأ; };

    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الملفات, «read_file.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الملفات, «write_file.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الملفات, «write_bytes.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الملفات, «path.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الملفات, «directory.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الملفات, «handle.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الملفات, «error.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الملفات, «mutation.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الملفات, «metadata.sn», صواب)) { أرجع خطأ; };

    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_العملية, «argument_count.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_العملية, «argument.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_العملية, «arguments.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_العملية, «exit.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_العملية, «child.sn», صواب)) { أرجع خطأ; };

    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_النص, «compare.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_النص, «range.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_النص, «from_bytes.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_النص, «search.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_النص, «substring.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_النص, «transform.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_النص, «number.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_النص, «format.sn», خطأ)) { أرجع خطأ; };

    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الحروف, «ascii.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الحروف, «unicode.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_البايتات, «compare.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_البايتات, «range.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الترميز, «utf8.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الترميز, «positions.sn», خطأ)) { أرجع خطأ; };

    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_المجموعات, «map.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_المجموعات, «set.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_المجموعات, «text_index_map.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_جسون, «value.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_جسون, «parse.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_جسون, «stringify.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_العنوان_الموحد, «uri.sn», خطأ)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الذاكرة, «system.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_البيئة, «environment.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_الوقت, «time.sn», صواب)) { أرجع خطأ; };
    لو (!سجل_عضو_حزمة_قياسية(البيئة, الجذر_القياسي, &مجال_التشفير, «sha256.sn», خطأ)) { أرجع خطأ; };

    // Bilingual package spellings point to the already-registered canonical
    // ModuleKeys. The process namespace intentionally has no Arabic spelling yet.
