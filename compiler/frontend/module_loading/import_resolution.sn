استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.logical_environment;

عام نوع خطأ_حل_استيراد =
    | مرجع_غير_صالح
    | جذر_غير_معلن
    | هروب_من_الجذر
    | مسار_منطقي_غير_صالح
    | تعارض_مسار_عام
;

عام نوع نتيجة_حل_استيراد =
    | محلول بنوع مفتاح_وحدة_مقنن
    | خطأ بنوع خطأ_حل_استيراد
;

عام عرف حل_استيراد_نسبي(
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: &مفتاح_وحدة_مقنن,
    المرجع: &متجه غ8
): نتيجة_حل_استيراد {
    دع أصل_المستورد: مفتاح_وحدة_مقنن = *المستورد;
    طابق حل_مسار_استيراد_نسبي(&أصل_المستورد.المسار, المرجع) مع
    | نتيجة_مسار_استيراد_نسبي.هروب_من_الجذر -> {
        أرجع نتيجة_حل_استيراد.خطأ(خطأ_حل_استيراد.هروب_من_الجذر());
    }
    | نتيجة_مسار_استيراد_نسبي.غير_صالح -> {
        أرجع نتيجة_حل_استيراد.خطأ(خطأ_حل_استيراد.مرجع_غير_صالح());
    }
    | نتيجة_مسار_استيراد_نسبي.صالح(المسار) -> {
        // A relative spelling may point at a module already registered under a
        // different canonical library root (for example a std package member).
        // Public-path aliases canonicalize identity before any source is loaded.
        دع المسار_العام: متجه غ8 = بايتات_مسار_وحدة_منطقي(&المسار);
        طابق حل_مسار_عام_مسجل(
            البيئة, أصل_المستورد.الجذر, &المسار_العام
        ) مع
        | اختيار.بعض(المقنن) -> {
            أرجع نتيجة_حل_استيراد.محلول(المقنن);
        }
        | اختيار.لا_شيء -> { };

        دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
            أصل_المستورد.الجذر,
            المسار
        );
        أرجع نتيجة_حل_استيراد.محلول(المفتاح);
    };
}

عام عرف حل_استيراد_بجذر_مسمى(
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: &مفتاح_وحدة_مقنن,
    المرجع: &متجه غ8
): نتيجة_حل_استيراد {
    دع أصل_المستورد: مفتاح_وحدة_مقنن = *المستورد;
    دع الجذر_الهدف: متغير اختيار معرف_جذر_مكتبة = اختيار.لا_شيء();
    طابق أول_جزء_مرجع_استيراد(المرجع) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_حل_استيراد.خطأ(خطأ_حل_استيراد.مرجع_غير_صالح());
    }
    | اختيار.بعض(الجزء) -> {
        الجذر_الهدف := حل_اسم_جذر(
            البيئة,
            أصل_المستورد.الجذر,
            &الجزء.البايتات
        );
    };

    دع الجذر: متغير معرف_جذر_مكتبة = أصل_المستورد.الجذر;
    طابق الجذر_الهدف مع
    | اختيار.لا_شيء -> {
        // Unbound dotted roots are project-module paths under the importer's
        // own configured source root. Registered library names (for example
        // `std`) still redirect to their independent RootID above.
        الجذر := أصل_المستورد.الجذر;
    }
    | اختيار.بعض(المعرف) -> {
        الجذر := المعرف;
    };

    طابق حل_مسار_عام_مسجل(البيئة, أصل_المستورد.الجذر, المرجع) مع
    | اختيار.بعض(المفتاح) -> {
        لو (!معرفا_جذر_مكتبة_متساويان(المفتاح.الجذر, الجذر)) {
            أرجع نتيجة_حل_استيراد.خطأ(خطأ_حل_استيراد.تعارض_مسار_عام());
        };
        أرجع نتيجة_حل_استيراد.محلول(المفتاح);
    }
    | اختيار.لا_شيء -> {
    };

    // A root spelling may name the importer's own logical root (for example
    // `compiler.frontend.lexer.token`). In that case the root spelling is part
    // of the canonical project path, so preserve the full reference. External
    // library roots (for example `std`) use the path after the root spelling.
    لو (معرفا_جذر_مكتبة_متساويان(الجذر, أصل_المستورد.الجذر)) {
        طابق قنن_مسار_وحدة_منطقي(المرجع) مع
        | نتيجة_مسار_وحدة_منطقي.غير_صالح -> {
            أرجع نتيجة_حل_استيراد.خطأ(خطأ_حل_استيراد.مسار_منطقي_غير_صالح());
        }
        | نتيجة_مسار_وحدة_منطقي.صالح(المسار) -> {
            دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(الجذر, المسار);
            أرجع نتيجة_حل_استيراد.محلول(المفتاح);
        };
    };

    طابق باقي_مرجع_بعد_الجذر(المرجع) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_حل_استيراد.خطأ(خطأ_حل_استيراد.مرجع_غير_صالح());
    }
    | اختيار.بعض(الباقي) -> {
        طابق قنن_مسار_وحدة_منطقي(&الباقي) مع
        | نتيجة_مسار_وحدة_منطقي.غير_صالح -> {
            أرجع نتيجة_حل_استيراد.خطأ(خطأ_حل_استيراد.مسار_منطقي_غير_صالح());
        }
        | نتيجة_مسار_وحدة_منطقي.صالح(المسار) -> {
            دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
                الجذر,
                المسار
            );
            أرجع نتيجة_حل_استيراد.محلول(المفتاح);
        };
    };
}

// Classification is deterministic: only ./ and ../ are relative. Every other
// valid non-absolute spelling is a named-root import. Missing roots fail here;
// there is no reinterpretation against the importer directory.
عام عرف حل_مرجع_استيراد(
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: &مفتاح_وحدة_مقنن,
    المرجع: &متجه غ8
): نتيجة_حل_استيراد {
    طابق صنف_مرجع_استيراد(المرجع) مع
    | تصنيف_مرجع_استيراد.غير_صالح -> {
        أرجع نتيجة_حل_استيراد.خطأ(خطأ_حل_استيراد.مرجع_غير_صالح());
    }
    | تصنيف_مرجع_استيراد.نسبي -> {
        أرجع حل_استيراد_نسبي(البيئة, المستورد, المرجع);
    }
    | تصنيف_مرجع_استيراد.جذر_مسمى -> {
        أرجع حل_استيراد_بجذر_مسمى(البيئة, المستورد, المرجع);
    };
}
