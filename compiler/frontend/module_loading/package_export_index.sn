استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.source_locator;
استورد compiler.frontend.identifier_identity;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.lexer.result;
استورد compiler.frontend.parser.parser;
استورد compiler.frontend.parser.result;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.name;
استورد compiler.source.source_file;
استورد std.bytes.compare;

// Package export discovery is a Module-owned pre-semantic index. It parses
// demand-discovered package members through the canonical lexer/parser and records
// only declaration spellings plus the canonical owner ModuleKey. The loader caches
// physical membership per canonical package and this index per discovered member
// set. Name remains the sole owner of symbol identity, visibility, aliases, and
// ambiguity.
عام نوع ربط_تصدير_عضو_حزمة = {
    الهوية: متجه غ8,
    المفتاح: مفتاح_وحدة_مقنن,
    علني: منطقي
};

عام نوع فهرس_تصديرات_حزمة = {
    الأعضاء: متجه مفتاح_وحدة_مقنن,
    التصديرات: متجه ربط_تصدير_عضو_حزمة
};

عام نوع نتيجة_بناء_فهرس_تصديرات_حزمة =
    | مكتمل بنوع فهرس_تصديرات_حزمة
    | غير_مكتمل
;

عرف انسخ_نص_فهرس_تصدير_حزمة(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عرف هويتان_متساويتان_لفهرس_حزمة(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    أرجع متجها_بايتات_متساويان(أ, ب);
}

عرف أضف_تصدير_عضو_حزمة(
    التصديرات: &متغير متجه ربط_تصدير_عضو_حزمة,
    الهوية: متجه غ8,
    المفتاح: &مفتاح_وحدة_مقنن,
    علني: منطقي
): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*التصديرات) مثل غير_موقع)) {
        دع مرجع_القديم: &ربط_تصدير_عضو_حزمة = &(*التصديرات)[ف];
        لو (
            هويتان_متساويتان_لفهرس_حزمة(&(*مرجع_القديم).الهوية, &الهوية)
            && مفتاحا_وحدة_متساويان(&(*مرجع_القديم).المفتاح, المفتاح)
            && (*مرجع_القديم).علني == علني
        ) { أرجع; };
        ف := ف + 1;
    }
    دع المفتاح_المخزن: مفتاح_وحدة_مقنن = انسخ_مفتاح_وحدة_مقنن(المفتاح);
    دع الربط: ربط_تصدير_عضو_حزمة = {
        الهوية: الهوية,
        المفتاح: المفتاح_المخزن,
        علني: علني
    };
    ألحق(*التصديرات, الربط);
}

عرف هوية_اسم_عضو_حزمة(المصدر: &مصدر, الاسم: &اسم): متجه غ8 {
    أرجع انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى,
        (*الاسم).النطاق.البداية.البايت,
        (*الاسم).النطاق.النهاية.البايت
    );
}

عرف اجمع_تصديرات_شجرة_عضو_حزمة(
    التصديرات: &متغير متجه ربط_تصدير_عضو_حزمة,
    المفتاح: &مفتاح_وحدة_مقنن,
    المصدر: &مصدر,
    الشجرة: &وحدة_مصدر
): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الشجرة).العناصر) مثل غير_موقع)) {
        طابق (*الشجرة).العناصر[ف] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            دع الهوية: متجه غ8 = هوية_اسم_عضو_حزمة(المصدر, &الدالة.الاسم);
            أضف_تصدير_عضو_حزمة(التصديرات, الهوية, المفتاح, الدالة.علني);
            دع ب: متغير غير_موقع = 0;
            بينما (ب < (الطول(الدالة.الأسماء_البديلة) مثل غير_موقع)) {
                دع هوية_البديل: متجه غ8 = هوية_اسم_عضو_حزمة(
                    المصدر, &الدالة.الأسماء_البديلة[ب]
                );
                أضف_تصدير_عضو_حزمة(
                    التصديرات, هوية_البديل, المفتاح, الدالة.علني
                );
                ب := ب + 1;
            }
        }
        | عنصر_وحدة.نوع(التصريح) -> {
            دع الهوية: متجه غ8 = هوية_اسم_عضو_حزمة(المصدر, &التصريح.الاسم);
            أضف_تصدير_عضو_حزمة(التصديرات, الهوية, المفتاح, التصريح.علني);
        }
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            دع الهوية: متجه غ8 = هوية_اسم_عضو_حزمة(المصدر, &التصريح.الاسم);
            أضف_تصدير_عضو_حزمة(التصديرات, الهوية, المفتاح, التصريح.علني);
        }
        | عنصر_وحدة.تجميع(_, _) -> { };
        ف := ف + 1;
    }

    // Only aliases in the module root participate in `from package import name`.
    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول((*الشجرة).مرادفات_الأسماء) مثل غير_موقع)) {
        دع المرادف: &تصريح_مرادف_اسم = &(*الشجرة).مرادفات_الأسماء[م];
        طابق (*المرادف).أب_الوجهة مع
        | اختيار.لا_شيء -> {
            دع الهوية: متجه غ8 = هوية_اسم_عضو_حزمة(المصدر, &(*المرادف).الاسم);
            أضف_تصدير_عضو_حزمة(
                التصديرات, الهوية, المفتاح, (*المرادف).علني
            );
        }
        | اختيار.بعض(_) -> { };
        م := م + 1;
    }
}

عام عرف ابن_فهرس_تصديرات_حزمة(
    البيئة: &بيئة_وحدات_منطقية,
    الأعضاء: &متجه مفتاح_وحدة_مقنن
): نتيجة_بناء_فهرس_تصديرات_حزمة {
    دع التصديرات: متغير متجه ربط_تصدير_عضو_حزمة = [];
    دع نسخ_الأعضاء: متغير متجه مفتاح_وحدة_مقنن = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأعضاء) مثل غير_موقع)) {
        دع المفتاح: &مفتاح_وحدة_مقنن = &(*الأعضاء)[ف];
        طابق حدد_مصدر_وحدة(البيئة, المفتاح) مع
        | نتيجة_تحديد_مصدر.خطأ(_) -> {
            أرجع نتيجة_بناء_فهرس_تصديرات_حزمة.غير_مكتمل();
        }
        | نتيجة_تحديد_مصدر.موجود(المحدد) -> {
            دع مسار_المصدر: نص = انسخ_نص_فهرس_تصدير_حزمة(&المحدد.مسار_ملف_المصدر);
            دع محتوى_المصدر: نص = انسخ_نص_فهرس_تصدير_حزمة(&المحدد.المحتوى);
            دع المصدر: مصدر = مصدر_جديد(0, مسار_المصدر, محتوى_المصدر);
            طابق حلل_معجميا(&المصدر) مع
            | نتيجة_تحليل_معجمي.مرفوض(_) -> {
                أرجع نتيجة_بناء_فهرس_تصديرات_حزمة.غير_مكتمل();
            }
            | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
                طابق حلل_الرموز(&المصدر, &السلسلة.الرموز) مع
                | نتيجة_تحليل.شجرة(الشجرة) -> {
                    اجمع_تصديرات_شجرة_عضو_حزمة(
                        &متغير التصديرات, المفتاح, &المصدر, &الشجرة
                    );
                }
                | _ -> {
                    أرجع نتيجة_بناء_فهرس_تصديرات_حزمة.غير_مكتمل();
                };
            };
        };
        ألحق(نسخ_الأعضاء, انسخ_مفتاح_وحدة_مقنن(المفتاح));
        ف := ف + 1;
    }
    دع الفهرس: فهرس_تصديرات_حزمة = {
        الأعضاء: نسخ_الأعضاء,
        التصديرات: التصديرات
    };
    أرجع نتيجة_بناء_فهرس_تصديرات_حزمة.مكتمل(الفهرس);
}

عام عرف فهرس_تصديرات_حزمة_لنفس_الأعضاء(
    الفهرس: &فهرس_تصديرات_حزمة,
    الأعضاء: &متجه مفتاح_وحدة_مقنن
): منطقي {
    لو (الطول((*الفهرس).الأعضاء) != الطول(*الأعضاء)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأعضاء) مثل غير_موقع)) {
        لو (!مفتاحا_وحدة_متساويان(&(*الفهرس).الأعضاء[ف], &(*الأعضاء)[ف])) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أضف_مفتاح_عضو_فريدا(
    الناتج: &متغير متجه مفتاح_وحدة_مقنن,
    المفتاح: &مفتاح_وحدة_مقنن
): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الناتج) مثل غير_موقع)) {
        لو (مفتاحا_وحدة_متساويان(&(*الناتج)[ف], المفتاح)) { أرجع; };
        ف := ف + 1;
    }
    ألحق(*الناتج, انسخ_مفتاح_وحدة_مقنن(المفتاح));
}

// Both public and private declarations select their owning module. Name later
// decides whether the selected spelling is visible and diagnoses private or
// ambiguous exports using canonical Symbols, never this discovery index.
عام عرف أعضاء_حزمة_مرشحون_لهوية(
    الفهرس: &فهرس_تصديرات_حزمة,
    الهوية: &متجه غ8
): متجه مفتاح_وحدة_مقنن {
    دع الناتج: متغير متجه مفتاح_وحدة_مقنن = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الفهرس).التصديرات) مثل غير_موقع)) {
        دع المرجع: &ربط_تصدير_عضو_حزمة = &(*الفهرس).التصديرات[ف];
        لو (هويتان_متساويتان_لفهرس_حزمة(&(*المرجع).الهوية, الهوية)) {
            أضف_مفتاح_عضو_فريدا(&متغير الناتج, &(*المرجع).المفتاح);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}
