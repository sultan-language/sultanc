استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.module_metadata;
استورد compiler.frontend.module_loading.import_resolution;
استورد compiler.frontend.module_loading.source_locator;
استورد compiler.frontend.identifier_identity;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.context;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.source.source;
استورد compiler.frontend.source.source_identity;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.unit;
استورد std.text.compare;
استورد std.text.from_bytes;
// Loader owns the one-to-one Canonical Module Key -> dense Module ID binding.
// Physical source location is retained only as downstream source metadata.
عام نوع وحدة_مصدر_محملة = {
    المفتاح: مفتاح_وحدة_مقنن,
    مسار_ملف_المصدر: نص,
    المصدر: مصدر,
    الوحدة: معرف_وحدة
};

عام نوع مدخل_فهرس_وحدة_محملة = {
    الهاش: غير_موقع,
    الوحدة: معرف_وحدة
};

عام نوع محمل_وحدات = {
    المحملة: متجه وحدة_مصدر_محملة,
    فهرس_المفاتيح: متجه اختيار مدخل_فهرس_وحدة_محملة
};

عام نوع خطأ_تحميل_وحدة =
    | مصدر_غير_موجود
    | مصدر_غير_مقروء
    | مرجع_غير_صالح
    | جذر_غير_معلن
    | هروب_من_الجذر
    | مسار_منطقي_غير_صالح
    | تعارض_مسار_عام
    | مصدر_وحدة_متعارض
    | وحدة_مستوردة_غير_محملة
    | دورة_استيراد
    | رسم_وحدات_مرفوض
    | تصدير_انتقائي_مفقود
;

عام نوع نتيجة_تحميل_وحدة =
    | محملة بنوع وحدة_مصدر_محملة
    | خطأ بنوع خطأ_تحميل_وحدة
;

عام نوع خطأ_تحميل_استيرادات = {
    الفهرس: غير_موقع,
    الخطأ: خطأ_تحميل_وحدة
};

عام نوع نتيجة_تحميل_استيرادات =
    | محملة بنوع متجه معرف_وحدة
    | خطأ بنوع خطأ_تحميل_استيرادات
;

عرف خطأ_استيراد_عند(الفهرس: غير_موقع, الخطأ: خطأ_تحميل_وحدة): خطأ_تحميل_استيرادات {
    دع الناتج: خطأ_تحميل_استيرادات = { الفهرس: الفهرس, الخطأ: الخطأ };
    أرجع الناتج;
}

عام نوع نتيجة_مرجع_استيراد =
    | صالح بنوع متجه غ8
    | غير_صالح
;

عام عرف محمل_وحدات_جديد(): محمل_وحدات {
    دع المحملة: متجه وحدة_مصدر_محملة = [];
    دع فهرس_المفاتيح: متجه اختيار مدخل_فهرس_وحدة_محملة = [];
    دع المحمل: محمل_وحدات = {
        المحملة: المحملة,
        فهرس_المفاتيح: فهرس_المفاتيح
    };
    أرجع المحمل;
}

عرف انسخ_وحدة_مصدر_محملة(
    الوحدة: &وحدة_مصدر_محملة
): وحدة_مصدر_محملة {
    دع النسخة: وحدة_مصدر_محملة = *الوحدة;
    أرجع النسخة;
}

عرف امزج_هاش_مفتاح_وحدة(الهاش: غير_موقع, القيمة: غير_موقع): غير_موقع {
    أرجع ((الهاش * 257) + (القيمة % 1048573)) % 1048573;
}

عرف هاش_مفتاح_وحدة_محملة(المفتاح: &مفتاح_وحدة_مقنن): غير_موقع {
    دع القيمة: مفتاح_وحدة_مقنن = *المفتاح;
    دع الهاش: متغير غير_موقع = امزج_هاش_مفتاح_وحدة(1, القيمة.الجذر.القيمة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.المسار.الأجزاء) مثل غير_موقع)) {
        دع مرجع_الجزء: &جزء_مسار_وحدة_منطقي = &القيمة.المسار.الأجزاء[ف];
        دع الجزء: جزء_مسار_وحدة_منطقي = *مرجع_الجزء;
        الهاش := امزج_هاش_مفتاح_وحدة(
            الهاش, الطول(الجزء.البايتات) مثل غير_موقع
        );
        دع ح: متغير غير_موقع = 0;
        بينما (ح < (الطول(الجزء.البايتات) مثل غير_موقع)) {
            الهاش := امزج_هاش_مفتاح_وحدة(
                الهاش, الجزء.البايتات[ح] مثل غير_موقع
            );
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع الهاش;
}

عرف ابن_فهرس_مفاتيح_وحدات_فارغا(
    السعة: غير_موقع
): متجه اختيار مدخل_فهرس_وحدة_محملة {
    دع الناتج: متغير متجه اختيار مدخل_فهرس_وحدة_محملة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) {
        ألحق(الناتج, اختيار.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أدرج_مدخل_فهرس_وحدة_محملة(
    الفهرس: &متغير متجه اختيار مدخل_فهرس_وحدة_محملة,
    المدخل: مدخل_فهرس_وحدة_محملة
): فراغ {
    دع الحالة: متغير متجه اختيار مدخل_فهرس_وحدة_محملة = *الفهرس;
    دع السعة: غير_موقع = الطول(الحالة) مثل غير_موقع;
    لو (السعة == 0) { أرجع; };
    دع الموضع: متغير غير_موقع = المدخل.الهاش % السعة;
    بينما (صواب) {
        طابق الحالة[الموضع] مع
        | اختيار.لا_شيء -> {
            الحالة[الموضع] := اختيار.بعض(المدخل);
            *الفهرس := الحالة;
            أرجع;
        }
        | اختيار.بعض(_) -> {
            الموضع := (الموضع + 1) % السعة;
        };
    }
}

عرف تأكد_سعة_فهرس_مفاتيح_الوحدات(المحمل: &متغير محمل_وحدات): فراغ {
    دع الحالة: متغير محمل_وحدات = *المحمل;
    دع العدد: غير_موقع = الطول(الحالة.المحملة) مثل غير_موقع;
    دع القديمة: غير_موقع = الطول(الحالة.فهرس_المفاتيح) مثل غير_موقع;
    دع تحتاج: متغير منطقي = القديمة == 0;
    لو (!تحتاج) {
        تحتاج := (العدد * 3) >= (القديمة * 2);
    };
    لو (!تحتاج) { أرجع; };
    دع الجديدة: متغير غير_موقع = 16;
    لو (القديمة > 0) { الجديدة := القديمة * 2; };
    دع الفهرس_الجديد: متغير متجه اختيار مدخل_فهرس_وحدة_محملة =
        ابن_فهرس_مفاتيح_وحدات_فارغا(الجديدة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < القديمة) {
        طابق الحالة.فهرس_المفاتيح[ف] مع
        | اختيار.بعض(المدخل) -> {
            أدرج_مدخل_فهرس_وحدة_محملة(&متغير الفهرس_الجديد, المدخل);
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    الحالة.فهرس_المفاتيح := الفهرس_الجديد;
    *المحمل := الحالة;
}

عرف سجل_مفتاح_وحدة_محملة(
    المحمل: &متغير محمل_وحدات,
    المفتاح: &مفتاح_وحدة_مقنن,
    الوحدة: معرف_وحدة
): فراغ {
    تأكد_سعة_فهرس_مفاتيح_الوحدات(المحمل);
    دع الحالة: متغير محمل_وحدات = *المحمل;
    دع الهاش: غير_موقع = هاش_مفتاح_وحدة_محملة(المفتاح);
    دع المدخل: مدخل_فهرس_وحدة_محملة = {
        الهاش: الهاش,
        الوحدة: الوحدة
    };
    أدرج_مدخل_فهرس_وحدة_محملة(&متغير الحالة.فهرس_المفاتيح, المدخل);
    *المحمل := الحالة;
}

عام عرف وحدة_محملة_بالمفتاح(
    المحمل: &محمل_وحدات,
    المفتاح: &مفتاح_وحدة_مقنن
): اختيار وحدة_مصدر_محملة {
    دع الحالة: محمل_وحدات = *المحمل;
    دع السعة: غير_موقع = الطول(الحالة.فهرس_المفاتيح) مثل غير_موقع;
    لو (السعة == 0) { أرجع اختيار.لا_شيء(); };
    دع الهاش: غير_موقع = هاش_مفتاح_وحدة_محملة(المفتاح);
    دع الموضع: متغير غير_موقع = الهاش % السعة;
    دع المفحوص: متغير غير_موقع = 0;
    بينما (المفحوص < السعة) {
        طابق الحالة.فهرس_المفاتيح[الموضع] مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المدخل) -> {
            لو (المدخل.الهاش == الهاش
                && المدخل.الوحدة.القيمة < (الطول(الحالة.المحملة) مثل غير_موقع)) {
                دع المرجع: &وحدة_مصدر_محملة = &الحالة.المحملة[المدخل.الوحدة.القيمة];
                دع الوحدة: وحدة_مصدر_محملة = انسخ_وحدة_مصدر_محملة(المرجع);
                لو (مفتاحا_وحدة_متساويان(&الوحدة.المفتاح, المفتاح)) {
                    أرجع اختيار.بعض(الوحدة);
                };
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف وحدة_محملة_بالمعرف(
    المحمل: &محمل_وحدات,
    المعرف: معرف_وحدة
): اختيار وحدة_مصدر_محملة {
    دع الحالة: محمل_وحدات = *المحمل;
    // Module IDs are allocated densely immediately before append by this loader.
    لو (المعرف.القيمة >= (الطول(الحالة.المحملة) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(انسخ_وحدة_مصدر_محملة(&الحالة.المحملة[المعرف.القيمة]));
}

// Loader owns the loaded SourceID -> physical source-name association.
// Diagnostics can consume the returned text without assuming SourceID == ModuleID.
عام عرف اسم_مصدر_محمل_بالمعرف(
    المحمل: &محمل_وحدات,
    معرف_المصدر: غير_موقع
): اختيار نص {
    دع الحالة: محمل_وحدات = *المحمل;
    // Source IDs are allocated exactly once by this loader immediately before the
    // corresponding loaded-module append, so SourceID is the dense source-table index.
    لو (معرف_المصدر >= (الطول(الحالة.المحملة) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع المرجع: &وحدة_مصدر_محملة = &الحالة.المحملة[معرف_المصدر];
    دع الوحدة: وحدة_مصدر_محملة = انسخ_وحدة_مصدر_محملة(المرجع);
    لو (الوحدة.المصدر.المعرف != معرف_المصدر) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الاسم: &نص = &الوحدة.المصدر.الاسم;
    دع الاسم: نص = *مرجع_الاسم;
    أرجع اختيار.بعض(الاسم);
}

// Source text stays owned by the loader/source layer. Diagnostics requests only
// the display line containing an already-canonical source span; it does not
// reconstruct source identity or coordinates.
عام عرف مقتطف_مصدر_محمل_لنطاق(
    المحمل: &محمل_وحدات,
    النطاق: &نطاق
): اختيار نص {
    دع الحالة: محمل_وحدات = *المحمل;
    دع حدود: نطاق = *النطاق;
    دع معرف_المصدر: غير_موقع = حدود.البداية.المصدر;
    لو (معرف_المصدر >= (الطول(الحالة.المحملة) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع المرجع: &وحدة_مصدر_محملة = &الحالة.المحملة[معرف_المصدر];
    دع الوحدة: وحدة_مصدر_محملة = انسخ_وحدة_مصدر_محملة(المرجع);
    لو (الوحدة.المصدر.المعرف != معرف_المصدر) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_المحتوى: &نص = &الوحدة.المصدر.المحتوى;
    دع المحتوى: نص = *مرجع_المحتوى;
    دع العدد: غير_موقع = الطول(المحتوى) مثل غير_موقع;
    لو (حدود.البداية.البايت > العدد) {
        أرجع اختيار.لا_شيء();
    };
    دع البداية: متغير غير_موقع = حدود.البداية.البايت;
    دع ابحث_للخلف: متغير منطقي = صواب;
    بينما (ابحث_للخلف && (البداية > 0)) {
        دع موضع_السابق: غير_موقع = البداية - 1;
        دع السابق: غ8 = المحتوى[موضع_السابق];
        لو ((السابق == 0x0A) || (السابق == 0x0D)) {
            ابحث_للخلف := خطأ;
        } وإلا {
            البداية := موضع_السابق;
        };
    }
    دع النهاية: متغير غير_موقع = حدود.البداية.البايت;
    دع ابحث_للأمام: متغير منطقي = صواب;
    بينما (ابحث_للأمام && (النهاية < العدد)) {
        دع الحالي: غ8 = المحتوى[النهاية];
        لو ((الحالي == 0x0A) || (الحالي == 0x0D)) {
            ابحث_للأمام := خطأ;
        } وإلا {
            النهاية := النهاية + 1;
        };
    }
    دع البايتات: متغير متجه غ8 = [];
    دع ح: متغير غير_موقع = البداية;
    بينما (ح < النهاية) {
        ألحق(البايتات, المحتوى[ح]);
        ح := ح + 1;
    }
    أرجع اختيار.بعض(من_بايتات(&البايتات));
}

عرف خطأ_تحميل_من_تحديد(
    الخطأ: خطأ_تحديد_مصدر
): خطأ_تحميل_وحدة {
    طابق الخطأ مع
    | خطأ_تحديد_مصدر.غير_موجود -> {
        أرجع خطأ_تحميل_وحدة.مصدر_غير_موجود();
    }
    | خطأ_تحديد_مصدر.غير_مقروء -> {
        أرجع خطأ_تحميل_وحدة.مصدر_غير_مقروء();
    };
}

عرف خطأ_تحميل_من_حل(
    الخطأ: خطأ_حل_استيراد
): خطأ_تحميل_وحدة {
    طابق الخطأ مع
    | خطأ_حل_استيراد.مرجع_غير_صالح -> {
        أرجع خطأ_تحميل_وحدة.مرجع_غير_صالح();
    }
    | خطأ_حل_استيراد.جذر_غير_معلن -> {
        أرجع خطأ_تحميل_وحدة.جذر_غير_معلن();
    }
    | خطأ_حل_استيراد.هروب_من_الجذر -> {
        أرجع خطأ_تحميل_وحدة.هروب_من_الجذر();
    }
    | خطأ_حل_استيراد.مسار_منطقي_غير_صالح -> {
        أرجع خطأ_تحميل_وحدة.مسار_منطقي_غير_صالح();
    }
    | خطأ_حل_استيراد.تعارض_مسار_عام -> {
        أرجع خطأ_تحميل_وحدة.تعارض_مسار_عام();
    };
}

عرف اربط_مصدر_بوحدة(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير سياق_هوية_مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المحدد: مصدر_محدد
): نتيجة_تحميل_وحدة {
    طابق وحدة_محملة_بالمفتاح(المحمل, &المحدد.المفتاح) مع
    | اختيار.بعض(القديمة) -> {
        // Canonical ModuleKey already identifies the loaded source. Do not reread/compare it.
        أرجع نتيجة_تحميل_وحدة.محملة(القديمة);
    }
    | اختيار.لا_شيء -> {
    };

    دع حالة_المحمل: متغير محمل_وحدات = *المحمل;
    دع معرف_الوحدة: معرف_وحدة = خصص_معرف_وحدة(الرسم);
    دع الجذر: معرف_نطاق = نطاق_جذري(سياق_الأسماء, معرف_الوحدة);
    دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &المحدد.المفتاح;
    دع المفتاح: مفتاح_وحدة_مقنن = *مرجع_المفتاح;
    دع مرجع_مسار_المصدر: &نص = &المحدد.مسار_ملف_المصدر;
    دع مسار_المصدر: نص = *مرجع_مسار_المصدر;
    دع مسار_المحملة: نص = *مرجع_مسار_المصدر;
    دع مرجع_محتوى_المصدر: &نص = &المحدد.المحتوى;
    دع محتوى_المصدر: نص = *مرجع_محتوى_المصدر;
    دع المصدر: مصدر = أنشئ_مصدر_بهوية(
        سياق_المصادر,
        مسار_المصدر,
        محتوى_المصدر
    );
    دع بداية_المصدر: موضع = {
        المصدر: المصدر.المعرف,
        البايت: 0,
        السطر: 1,
        العمود: 0
    };
    دع نهاية_المصدر: موضع = {
        المصدر: المصدر.المعرف,
        البايت: المصدر.الطول,
        السطر: 1,
        العمود: 0
    };
    دع نطاق_المصدر: نطاق = نطاق_بين(بداية_المصدر, نهاية_المصدر);
    ضع_نطاق_مصدر_لنطاق(سياق_الأسماء, الجذر, نطاق_المصدر);
    دع يسمح_بجسر_بدائي_داخلي: منطقي = وحدة_مقننة_تسمح_بجسر_بدائي_داخلي(البيئة, &المفتاح);
    دع الدلالية: وحدة_دلالية = {
        المعرف: معرف_الوحدة,
        النطاق_الجذري: الجذر,
        معرف_المصدر: المصدر.المعرف,
        يسمح_بجسر_بدائي_داخلي: يسمح_بجسر_بدائي_داخلي
    };
    أضف_وحدة_للرسم(الرسم, الدلالية);

    دع المحملة: وحدة_مصدر_محملة = {
        المفتاح: المفتاح,
        مسار_ملف_المصدر: مسار_المحملة,
        المصدر: المصدر,
        الوحدة: معرف_الوحدة
    };
    ألحق(
        حالة_المحمل.المحملة,
        انسخ_وحدة_مصدر_محملة(&المحملة)
    );
    *المحمل := حالة_المحمل;
    سجل_مفتاح_وحدة_محملة(المحمل, &المحملة.المفتاح, معرف_الوحدة);
    أرجع نتيجة_تحميل_وحدة.محملة(المحملة);
}

عام عرف حمل_وحدة_جذر(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير سياق_هوية_مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): نتيجة_تحميل_وحدة {
    طابق حدد_مصدر_وحدة(البيئة, المفتاح) مع
    | نتيجة_تحديد_مصدر.خطأ(الخطأ) -> {
        أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_من_تحديد(الخطأ));
    }
    | نتيجة_تحديد_مصدر.موجود(المحدد) -> {
        أرجع اربط_مصدر_بوحدة(
            المحمل,
            سياق_المصادر,
            سياق_الأسماء,
            الرسم,
            البيئة,
            المحدد
        );
    };
}

عرف انسخ_مرجعا_من_نطاق(
    المصدر: &مصدر,
    النطاق: نطاق
): نتيجة_مرجع_استيراد {
    دع الأصل: مصدر = *المصدر;
    لو (
        (النطاق.البداية.المصدر != الأصل.المعرف)
        || (النطاق.النهاية.المصدر != الأصل.المعرف)
        || (النطاق.النهاية.البايت < النطاق.البداية.البايت)
        || (النطاق.النهاية.البايت > الأصل.الطول)
    ) {
        أرجع نتيجة_مرجع_استيراد.غير_صالح();
    };
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = النطاق.البداية.البايت;
    بينما (ف < النطاق.النهاية.البايت) {
        ألحق(البايتات, الأصل.المحتوى[ف]);
        ف := ف + 1;
    }
    لو (!مرجع_استيراد_صالح(&البايتات)) {
        أرجع نتيجة_مرجع_استيراد.غير_صالح();
    };
    أرجع نتيجة_مرجع_استيراد.صالح(البايتات);
}

عرف مرجع_مسار_استيراد_مسمى_كبايتات(
    المصدر: &مصدر,
    المسار: &متجه اسم
): نتيجة_مرجع_استيراد {
    دع الأجزاء: متجه اسم = *المسار;
    لو ((الطول(الأجزاء) مثل غير_موقع) < 2) {
        أرجع نتيجة_مرجع_استيراد.غير_صالح();
    };
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأجزاء) مثل غير_موقع)) {
        لو (ف > 0) { ألحق(البايتات, 0x2F); };
        طابق انسخ_مرجعا_من_نطاق(المصدر, الأجزاء[ف].النطاق) مع
        | نتيجة_مرجع_استيراد.غير_صالح -> {
            أرجع نتيجة_مرجع_استيراد.غير_صالح();
        }
        | نتيجة_مرجع_استيراد.صالح(الجزء) -> {
            دع ح: متغير غير_موقع = 0;
            بينما (ح < (الطول(الجزء) مثل غير_موقع)) {
                ألحق(البايتات, الجزء[ح]);
                ح := ح + 1;
            }
        };
        ف := ف + 1;
    }
    ألحق(البايتات, 0x2E);
    ألحق(البايتات, 0x73);
    ألحق(البايتات, 0x6E);
    لو (!مرجع_استيراد_صالح(&البايتات)) {
        أرجع نتيجة_مرجع_استيراد.غير_صالح();
    };
    أرجع نتيجة_مرجع_استيراد.صالح(البايتات);
}

عام عرف مرجع_الاستيراد_كبايتات(
    المصدر: &مصدر,
    الاستيراد: &استيراد
): نتيجة_مرجع_استيراد {
    دع الأصل: مصدر = *المصدر;
    دع القيمة: استيراد = *الاستيراد;
    طابق القيمة مع
    | استيراد.اسم(النطاق, المسار, _) -> {
        لو (
            (النطاق.البداية.المصدر != الأصل.المعرف)
            || (النطاق.النهاية.المصدر != الأصل.المعرف)
        ) {
            أرجع نتيجة_مرجع_استيراد.غير_صالح();
        };
        أرجع مرجع_مسار_استيراد_مسمى_كبايتات(&الأصل, &المسار);
    }
    | استيراد.نص(النطاق, البايتات, _) -> {
        لو (
            (النطاق.البداية.المصدر != الأصل.المعرف)
            || (النطاق.النهاية.المصدر != الأصل.المعرف)
            || (النطاق.النهاية.البايت < النطاق.البداية.البايت)
            || (النطاق.النهاية.البايت > الأصل.الطول)
            || !مرجع_استيراد_صالح(&البايتات)
        ) {
            أرجع نتيجة_مرجع_استيراد.غير_صالح();
        };
        أرجع نتيجة_مرجع_استيراد.صالح(البايتات);
    }
    | استيراد.انتقائي(_, المسار, _) -> {
        دع البايتات: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المسار) مثل غير_موقع)) {
            لو (ف > 0) { ألحق(البايتات, 0x2F); };
            طابق انسخ_مرجعا_من_نطاق(&الأصل, المسار[ف].النطاق) مع
            | نتيجة_مرجع_استيراد.غير_صالح -> { أرجع نتيجة_مرجع_استيراد.غير_صالح(); }
            | نتيجة_مرجع_استيراد.صالح(الجزء) -> {
                دع ح: متغير غير_موقع = 0;
                بينما (ح < (الطول(الجزء) مثل غير_موقع)) {
                    ألحق(البايتات, الجزء[ح]);
                    ح := ح + 1;
                }
            };
            ف := ف + 1;
        }
        لو (!مرجع_استيراد_صالح(&البايتات)) { أرجع نتيجة_مرجع_استيراد.غير_صالح(); };
        أرجع نتيجة_مرجع_استيراد.صالح(البايتات);
    };
}

عرف أضف_حافة_محملة(
    الرسم: &متغير رسم_وحدات,
    المستورد: معرف_وحدة,
    المستورد_منه: معرف_وحدة,
    المصدر: &مصدر,
    المرادف: اختيار اسم,
    الوحدة: وحدة_مصدر_محملة
): نتيجة_تحميل_وحدة {
    طابق المرادف مع
    | اختيار.لا_شيء -> {
        أضف_استيرادا(الرسم, المستورد, المستورد_منه);
    }
    | اختيار.بعض(الاسم) -> {
        دع الأصل: مصدر = *المصدر;
        لو (
            (الاسم.النطاق.البداية.المصدر != الأصل.المعرف)
            || (الاسم.النطاق.النهاية.المصدر != الأصل.المعرف)
            || (الاسم.النطاق.النهاية.البايت < الاسم.النطاق.البداية.البايت)
            || (الاسم.النطاق.النهاية.البايت > الأصل.الطول)
            || !هوية_معرف_لها_محتوى_في_شريحة(
                &الأصل.المحتوى,
                الاسم.النطاق.البداية.البايت,
                الاسم.النطاق.النهاية.البايت
            )
        ) {
            أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_وحدة.مرجع_غير_صالح());
        };
        دع الهوية: متجه غ8 = انسخ_هوية_معرف_من_شريحة(
            &الأصل.المحتوى,
            الاسم.النطاق.البداية.البايت,
            الاسم.النطاق.النهاية.البايت
        );
        دع الربط: مرادف_استيراد_وحدة = { الهوية: الهوية, النطاق: الاسم.النطاق };
        أضف_استيرادا_مسمى(الرسم, المستورد, المستورد_منه, الربط);
    };
    أرجع نتيجة_تحميل_وحدة.محملة(الوحدة);
}

عرف اسم_استيراد_انتقائي_من_اسم(
    المصدر: &مصدر,
    الاسم: &اسم
): اختيار اسم_استيراد_انتقائي {
    دع الأصل: مصدر = *المصدر;
    دع القيمة: اسم = *الاسم;
    لو (
        (القيمة.النطاق.البداية.المصدر != الأصل.المعرف)
        || (القيمة.النطاق.النهاية.المصدر != الأصل.المعرف)
        || (القيمة.النطاق.النهاية.البايت < القيمة.النطاق.البداية.البايت)
        || (القيمة.النطاق.النهاية.البايت > الأصل.الطول)
        || !هوية_معرف_لها_محتوى_في_شريحة(
            &الأصل.المحتوى,
            القيمة.النطاق.البداية.البايت,
            القيمة.النطاق.النهاية.البايت
        )
    ) {
        أرجع اختيار.لا_شيء();
    };
    دع الهوية: متجه غ8 = انسخ_هوية_معرف_من_شريحة(
        &الأصل.المحتوى,
        القيمة.النطاق.البداية.البايت,
        القيمة.النطاق.النهاية.البايت
    );
    دع الناتج: اسم_استيراد_انتقائي = { الهوية: الهوية, النطاق: القيمة.النطاق };
    أرجع اختيار.بعض(الناتج);
}

عرف اربط_مصدر_بمفتاح_استيراد(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير سياق_هوية_مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): نتيجة_تحميل_وحدة {
    طابق حدد_مصدر_وحدة(البيئة, المفتاح) مع
    | نتيجة_تحديد_مصدر.خطأ(الخطأ) -> { أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_من_تحديد(الخطأ)); }
    | نتيجة_تحديد_مصدر.موجود(المحدد) -> {
        أرجع اربط_مصدر_بوحدة(المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المحدد);
    };
}

عرف حمل_استيرادا_انتقائيا(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير سياق_هوية_مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: معرف_وحدة,
    الاستيراد: &استيراد
): نتيجة_تحميل_استيرادات {
    دع النتائج: متغير متجه معرف_وحدة = [];
    طابق وحدة_محملة_بالمعرف(المحمل, المستورد) مع
    | اختيار.لا_شيء -> {
        دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة());
        أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
    }
    | اختيار.بعض(الوحدة_المستوردة) -> {
        دع قيمة_الاستيراد: استيراد = *الاستيراد;
        طابق قيمة_الاستيراد مع
        | استيراد.انتقائي(_, _, الأسماء) -> {
            دع مرجع_الحزمة: متجه غ8;
            طابق مرجع_الاستيراد_كبايتات(&الوحدة_المستوردة.المصدر, الاستيراد) مع
            | نتيجة_مرجع_استيراد.غير_صالح -> {
                دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, خطأ_تحميل_وحدة.مرجع_غير_صالح());
                أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
            }
            | نتيجة_مرجع_استيراد.صالح(القيمة) -> { مرجع_الحزمة := القيمة; };

            دع أعضاء_الحزمة: متجه مفتاح_وحدة_مقنن = أعضاء_حزمة_منطقية(
                البيئة, الوحدة_المستوردة.المفتاح.الجذر, &مرجع_الحزمة
            );
            لو ((الطول(أعضاء_الحزمة) مثل غير_موقع) != 0) {
                دع القيود: متغير متجه اسم_استيراد_انتقائي = [];
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(الأسماء) مثل غير_موقع)) {
                    طابق اسم_استيراد_انتقائي_من_اسم(&الوحدة_المستوردة.المصدر, &الأسماء[ف]) مع
                    | اختيار.لا_شيء -> {
                        دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(ف, خطأ_تحميل_وحدة.مرجع_غير_صالح());
                        أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                    }
                    | اختيار.بعض(القيد) -> { ألحق(القيود, القيد); };
                    ف := ف + 1;
                }

                دع ع: متغير غير_موقع = 0;
                بينما (ع < (الطول(أعضاء_الحزمة) مثل غير_موقع)) {
                    دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &أعضاء_الحزمة[ع];
                    دع المفتاح: مفتاح_وحدة_مقنن = انسخ_مفتاح_وحدة_مقنن(مرجع_المفتاح);
                    طابق اربط_مصدر_بمفتاح_استيراد(
                        المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, &المفتاح
                    ) مع
                    | نتيجة_تحميل_وحدة.خطأ(السبب) -> {
                        دع الخطأ: خطأ_تحميل_استيرادات = { الفهرس: ع, الخطأ: السبب };
                        أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                    }
                    | نتيجة_تحميل_وحدة.محملة(الهدف) -> {
                        أضف_استيرادا_انتقائيا(الرسم, المستورد, الهدف.الوحدة, &القيود);
                        ألحق(النتائج, الهدف.الوحدة);
                    };
                    ع := ع + 1;
                }
                أرجع نتيجة_تحميل_استيرادات.محملة(النتائج);
            };

            // Ordinary module selective import: resolve one source module, then
            // Name validates and exposes only the explicitly selected declarations.
            طابق حل_مرجع_استيراد(
                البيئة, &الوحدة_المستوردة.المفتاح, &مرجع_الحزمة
            ) مع
            | نتيجة_حل_استيراد.خطأ(الخطأ) -> {
                دع السبب: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, خطأ_تحميل_من_حل(الخطأ));
                أرجع نتيجة_تحميل_استيرادات.خطأ(السبب);
            }
            | نتيجة_حل_استيراد.محلول(المفتاح) -> {
                طابق حدد_مصدر_وحدة(البيئة, &المفتاح) مع
                | نتيجة_تحديد_مصدر.خطأ(الخطأ) -> {
                    دع السبب: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, خطأ_تحميل_من_تحديد(الخطأ));
                    أرجع نتيجة_تحميل_استيرادات.خطأ(السبب);
                }
                | نتيجة_تحديد_مصدر.موجود(المصدر_المحدد) -> {
                    طابق اربط_مصدر_بوحدة(
                        المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المصدر_المحدد
                    ) مع
                    | نتيجة_تحميل_وحدة.خطأ(السبب) -> {
                        دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, السبب);
                        أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                    }
                    | نتيجة_تحميل_وحدة.محملة(الهدف) -> {
                        دع القيود: متغير متجه اسم_استيراد_انتقائي = [];
                        دع ف: متغير غير_موقع = 0;
                        بينما (ف < (الطول(الأسماء) مثل غير_موقع)) {
                            طابق اسم_استيراد_انتقائي_من_اسم(&الوحدة_المستوردة.المصدر, &الأسماء[ف]) مع
                            | اختيار.لا_شيء -> {
                                دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(ف, خطأ_تحميل_وحدة.مرجع_غير_صالح());
                                أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                            }
                            | اختيار.بعض(القيد) -> { ألحق(القيود, القيد); };
                            ف := ف + 1;
                        }
                        أضف_استيرادا_انتقائيا(الرسم, المستورد, الهدف.الوحدة, &القيود);
                        ألحق(النتائج, الهدف.الوحدة);
                        أرجع نتيجة_تحميل_استيرادات.محملة(النتائج);
                    };
                };
            };
        }
        | _ -> {
            دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, خطأ_تحميل_وحدة.مرجع_غير_صالح());
            أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
        };
    };
}

عرف حل_استيراد_بحسب_البنية(
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: &مفتاح_وحدة_مقنن,
    الاستيراد: &استيراد,
    المرجع: &متجه غ8
): نتيجة_حل_استيراد {
    دع القيمة: استيراد = *الاستيراد;
    طابق القيمة مع
    | استيراد.نص(_, _, _) -> {
        أرجع حل_استيراد_نسبي(البيئة, المستورد, المرجع);
    }
    | استيراد.اسم(_, _, _) -> {
        أرجع حل_استيراد_بجذر_مسمى(البيئة, المستورد, المرجع);
    }
    | استيراد.انتقائي(_, _, _) -> {
        أرجع حل_مرجع_استيراد(البيئة, المستورد, المرجع);
    };
}

عام عرف حمل_استيرادا(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير سياق_هوية_مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: معرف_وحدة,
    الاستيراد: &استيراد
): نتيجة_تحميل_وحدة {
    طابق وحدة_محملة_بالمعرف(المحمل, المستورد) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تحميل_وحدة.خطأ(
            خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة()
        );
    }
    | اختيار.بعض(الوحدة_المستوردة) -> {
        طابق مرجع_الاستيراد_كبايتات(&الوحدة_المستوردة.المصدر, الاستيراد) مع
        | نتيجة_مرجع_استيراد.غير_صالح -> {
            أرجع نتيجة_تحميل_وحدة.خطأ(
                خطأ_تحميل_وحدة.مرجع_غير_صالح()
            );
        }
        | نتيجة_مرجع_استيراد.صالح(البايتات) -> {
            طابق حل_استيراد_بحسب_البنية(
                البيئة,
                &الوحدة_المستوردة.المفتاح,
                الاستيراد,
                &البايتات
            ) مع
            | نتيجة_حل_استيراد.خطأ(الخطأ) -> {
                أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_من_حل(الخطأ));
            }
            | نتيجة_حل_استيراد.محلول(المفتاح) -> {
                طابق حدد_مصدر_وحدة(البيئة, &المفتاح) مع
                | نتيجة_تحديد_مصدر.خطأ(الخطأ) -> {
                    أرجع نتيجة_تحميل_وحدة.خطأ(
                        خطأ_تحميل_من_تحديد(الخطأ)
                    );
                }
                | نتيجة_تحديد_مصدر.موجود(المحدد) -> {
                    طابق اربط_مصدر_بوحدة(
                        المحمل,
                        سياق_المصادر,
                        سياق_الأسماء,
                        الرسم,
                        البيئة,
                        المحدد
                    ) مع
                    | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
                        أرجع نتيجة_تحميل_وحدة.خطأ(الخطأ);
                    }
                    | نتيجة_تحميل_وحدة.محملة(الهدف) -> {
                        دع قيمة_الاستيراد: استيراد = *الاستيراد;
                        طابق قيمة_الاستيراد مع
                        | استيراد.اسم(_, _, المرادف) -> {
                            أرجع أضف_حافة_محملة(
                                الرسم, المستورد, الهدف.الوحدة, &الوحدة_المستوردة.المصدر, المرادف, الهدف
                            );
                        }
                        | استيراد.نص(_, _, المرادف) -> {
                            أرجع أضف_حافة_محملة(
                                الرسم, المستورد, الهدف.الوحدة, &الوحدة_المستوردة.المصدر, المرادف, الهدف
                            );
                        }
                        | استيراد.انتقائي(_, _, _) -> {
                            أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_وحدة.مرجع_غير_صالح());
                        };
                    };
                };
            };
        };
    };
}

عام عرف حمل_استيرادات_مباشرة(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير سياق_هوية_مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: معرف_وحدة,
    الوحدة_المحللة: &وحدة_مصدر
): نتيجة_تحميل_استيرادات {
    طابق وحدة_محملة_بالمعرف(المحمل, المستورد) مع
    | اختيار.لا_شيء -> {
        دع سبب: خطأ_تحميل_وحدة = خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة();
        دع الخطأ: خطأ_تحميل_استيرادات = {
            الفهرس: 0,
            الخطأ: سبب
        };
        أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
    }
    | اختيار.بعض(المحملة) -> {
        دع الوحدة_النحوية: وحدة_مصدر = *الوحدة_المحللة;
        لو (الوحدة_النحوية.المصدر.المعرف != المحملة.المصدر.المعرف) {
            دع سبب: خطأ_تحميل_وحدة = خطأ_تحميل_وحدة.مصدر_وحدة_متعارض();
            دع الخطأ: خطأ_تحميل_استيرادات = {
                الفهرس: 0,
                الخطأ: سبب
            };
            أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
        };
        دع النتائج: متغير متجه معرف_وحدة = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الوحدة_النحوية.الاستيرادات) مثل غير_موقع)) {
            دع مرجع_الاستيراد: &استيراد = &الوحدة_النحوية.الاستيرادات[ف];
            دع قيمة_الاستيراد: استيراد = *مرجع_الاستيراد;
            طابق قيمة_الاستيراد مع
            | استيراد.انتقائي(_, _, _) -> {
                طابق حمل_استيرادا_انتقائيا(
                    المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المستورد, مرجع_الاستيراد
                ) مع
                | نتيجة_تحميل_استيرادات.خطأ(الخطأ) -> {
                    دع السبب: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(ف, الخطأ.الخطأ);
                    أرجع نتيجة_تحميل_استيرادات.خطأ(السبب);
                }
                | نتيجة_تحميل_استيرادات.محملة(المعرفات) -> {
                    دع ح: متغير غير_موقع = 0;
                    بينما (ح < (الطول(المعرفات) مثل غير_موقع)) {
                        ألحق(النتائج, المعرفات[ح]);
                        ح := ح + 1;
                    }
                };
            }
            | _ -> {
                طابق حمل_استيرادا(
                    المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المستورد, مرجع_الاستيراد
                ) مع
                | نتيجة_تحميل_وحدة.خطأ(سبب) -> {
                    دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(ف, سبب);
                    أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                }
                | نتيجة_تحميل_وحدة.محملة(الهدف) -> { ألحق(النتائج, الهدف.الوحدة); };
            };
            ف := ف + 1;
        }
        أرجع نتيجة_تحميل_استيرادات.محملة(النتائج);
    };
}
