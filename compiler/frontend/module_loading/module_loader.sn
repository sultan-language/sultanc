استورد compiler.backend.target.target_model;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.import_resolution;
استورد compiler.frontend.module_loading.source_locator;
استورد compiler.frontend.module_loading.package_export_index;
استورد compiler.frontend.identifier_identity;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.name_context;
استورد compiler.frontend.names.modules;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.unit;
استورد std.text.compare;
استورد std.text.from_bytes;
// Loader owns the one-to-one Canonical Module Key -> dense Module ID binding.
// Physical source location is retained only as downstream source metadata.
عام نوع وحدة_مصدر_محملة = {
    المفتاح: مفتاح_وحدة_مقنن,
    مسار_ملف_المصدر: نص,
    معرف_المصدر: طبيعي,
    الوحدة: معرف_وحدة
};

عام نوع مدخل_فهرس_وحدة_محملة = {
    الهاش: طبيعي,
    الوحدة: معرف_وحدة
};

عام نوع حزمة_مصدر_مكتشفة = {
    المفتاح: مفتاح_وحدة_مقنن,
    الأعضاء: متجه مفتاح_وحدة_مقنن
};

عام نوع محمل_وحدات = {
    // Resolved target facts come from Driver, not the compilation host.
    // The loader owns no target registry and never changes the target identity.
    الهدف: اختياري واصف_هدف,
    المحملة: متجه وحدة_مصدر_محملة,
    فهرس_المفاتيح: متجه اختياري مدخل_فهرس_وحدة_محملة,
    النشطة: متجه منطقي,
    // Physical package discovery is cached by canonical package ModuleKey for
    // this loader/compilation lifecycle. A new compilation gets a new loader,
    // so added/removed source members cannot persist as stale compiler state.
    الحزم_المكتشفة: متجه حزمة_مصدر_مكتشفة,
    // Package export discovery is cached per canonical member set for this
    // loader lifecycle. The cache stores declaration spellings only; Name owns
    // canonical Symbols and final visibility/ambiguity decisions.
    فهارس_تصديرات_الحزم: متجه فهرس_تصديرات_حزمة
};

عام نوع خطأ_تحميل_وحدة =
    | مصدر_غير_موجود
    | مصدر_غير_مقروء
    | مرجع_غير_صالح
    | جذر_غير_معلن
    | هروب_من_الجذر
    | مسار_منطقي_غير_صالح
    | تعارض_مسار_عام
    | مصدر_وحدة_متعارض
    | وحدة_مستوردة_غير_محملة
    | دورة_استيراد
    | رسم_وحدات_مرفوض
    | تصدير_انتقائي_مفقود
;

عام نوع نتيجة_تحميل_وحدة =
    | محملة بنوع وحدة_مصدر_محملة
    | خطأ بنوع خطأ_تحميل_وحدة
;

عام نوع خطأ_تحميل_استيرادات = {
    الفهرس: طبيعي,
    الخطأ: خطأ_تحميل_وحدة
};

عام نوع نتيجة_تحميل_استيرادات =
    | محملة بنوع متجه معرف_وحدة
    | خطأ بنوع خطأ_تحميل_استيرادات
;

عرف خطأ_استيراد_عند(الفهرس: طبيعي, الخطأ: خطأ_تحميل_وحدة): خطأ_تحميل_استيرادات {
    دع الناتج: خطأ_تحميل_استيرادات = { الفهرس: الفهرس, الخطأ: الخطأ };
    أرجع الناتج;
}

عام نوع نتيجة_مرجع_استيراد =
    | صالح بنوع متجه ط8
    | غير_صالح
;

عام عرف محمل_وحدات_جديد(): محمل_وحدات {
    دع المحملة: متجه وحدة_مصدر_محملة = [];
    دع فهرس_المفاتيح: متجه اختياري مدخل_فهرس_وحدة_محملة = [];
    دع النشطة: متجه منطقي = [];
    دع الحزم_المكتشفة: متجه حزمة_مصدر_مكتشفة = [];
    دع فهارس_تصديرات_الحزم: متجه فهرس_تصديرات_حزمة = [];
    دع المحمل: محمل_وحدات = {
        الهدف: اختياري.لا_شيء(),
        المحملة: المحملة,
        فهرس_المفاتيح: فهرس_المفاتيح,
        النشطة: النشطة,
        الحزم_المكتشفة: الحزم_المكتشفة,
        فهارس_تصديرات_الحزم: فهارس_تصديرات_الحزم
    };
    أرجع المحمل;
}

// Set once before parsing/import/export indexing. A project analysis without
// a selected target intentionally retains the neutral discovery behavior.
عام عرف حدد_هدف_محمل_وحدات(
    المحمل: &متغير محمل_وحدات,
    الهدف: اختياري واصف_هدف
): فراغ {
    (*المحمل).الهدف := الهدف;
}

عرف انسخ_وحدة_مصدر_محملة(
    الوحدة: &وحدة_مصدر_محملة
): وحدة_مصدر_محملة {
    دع النسخة: وحدة_مصدر_محملة = انسخ_مملوكا_وحدة_مصدر_محملة(الوحدة);
    أرجع النسخة;
}

عرف انسخ_أعضاء_حزمة_مكتشفة(
    الأعضاء: &متجه مفتاح_وحدة_مقنن
): متجه مفتاح_وحدة_مقنن {
    دع الناتج: متغير متجه مفتاح_وحدة_مقنن = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأعضاء) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مفتاح_وحدة_مقنن(&(*الأعضاء)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف موضع_حزمة_مصدر_مكتشفة(
    المحمل: &محمل_وحدات,
    المفتاح: &مفتاح_وحدة_مقنن
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المحمل).الحزم_المكتشفة) مثل طبيعي)) {
        لو (مفتاحا_وحدة_متساويان(&(*المحمل).الحزم_المكتشفة[ف].المفتاح, المفتاح)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ضمن_أعضاء_حزمة_مصدر_محمل(
    المحمل: &متغير محمل_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    مفتاح_الحزمة: &مفتاح_وحدة_مقنن
): نتيجة_اكتشاف_أعضاء_حزمة {
    طابق موضع_حزمة_مصدر_مكتشفة(المحمل, مفتاح_الحزمة) مع
    | اختياري.موجود(الموضع) -> {
        دع الأعضاء: متجه مفتاح_وحدة_مقنن = انسخ_أعضاء_حزمة_مكتشفة(
            &(*المحمل).الحزم_المكتشفة[الموضع].الأعضاء
        );
        أرجع نتيجة_اكتشاف_أعضاء_حزمة.موجودة(الأعضاء);
    }
    | اختياري.لا_شيء -> { };

    طابق اكتشف_أعضاء_حزمة_مصدر_لهدف(
        البيئة, مفتاح_الحزمة, &(*المحمل).الهدف
    ) مع
    | نتيجة_اكتشاف_أعضاء_حزمة.ليست_حزمة -> {
        أرجع نتيجة_اكتشاف_أعضاء_حزمة.ليست_حزمة();
    }
    | نتيجة_اكتشاف_أعضاء_حزمة.غير_مقروءة -> {
        أرجع نتيجة_اكتشاف_أعضاء_حزمة.غير_مقروءة();
    }
    | نتيجة_اكتشاف_أعضاء_حزمة.موجودة(الأعضاء) -> {
        دع نسخة_المفتاح: مفتاح_وحدة_مقنن = انسخ_مفتاح_وحدة_مقنن(مفتاح_الحزمة);
        دع نسخة_الأعضاء: متجه مفتاح_وحدة_مقنن = انسخ_أعضاء_حزمة_مكتشفة(&الأعضاء);
        دع الحزمة: حزمة_مصدر_مكتشفة = {
            المفتاح: نسخة_المفتاح,
            الأعضاء: نسخة_الأعضاء
        };
        ألحق((*المحمل).الحزم_المكتشفة, الحزمة);
        أرجع نتيجة_اكتشاف_أعضاء_حزمة.موجودة(الأعضاء);
    };
}

عرف موضع_فهرس_تصديرات_حزمة_محمل(
    المحمل: &محمل_وحدات,
    الأعضاء: &متجه مفتاح_وحدة_مقنن
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المحمل).فهارس_تصديرات_الحزم) مثل طبيعي)) {
        لو (فهرس_تصديرات_حزمة_لنفس_الأعضاء(
            &(*المحمل).فهارس_تصديرات_الحزم[ف], الأعضاء
        )) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ضمن_فهرس_تصديرات_حزمة_محمل(
    المحمل: &متغير محمل_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    الأعضاء: &متجه مفتاح_وحدة_مقنن
): اختياري طبيعي {
    طابق موضع_فهرس_تصديرات_حزمة_محمل(المحمل, الأعضاء) مع
    | اختياري.موجود(الموضع) -> { أرجع اختياري.موجود(الموضع); }
    | اختياري.لا_شيء -> { };
    طابق ابن_فهرس_تصديرات_حزمة(البيئة, الأعضاء, &(*المحمل).الهدف) مع
    | نتيجة_بناء_فهرس_تصديرات_حزمة.غير_مكتمل -> {
        // Discovery failure falls back to the historical all-member path so a
        // malformed/missing package member cannot silently change diagnostics.
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_بناء_فهرس_تصديرات_حزمة.مكتمل(الفهرس) -> {
        دع الموضع: طبيعي = الطول((*المحمل).فهارس_تصديرات_الحزم) مثل طبيعي;
        ألحق((*المحمل).فهارس_تصديرات_الحزم, الفهرس);
        أرجع اختياري.موجود(الموضع);
    };
}

عرف امزج_هاش_مفتاح_وحدة(الهاش: طبيعي, القيمة: طبيعي): طبيعي {
    أرجع ((الهاش * 257) + (القيمة % 1048573)) % 1048573;
}

عرف هاش_مفتاح_وحدة_محملة(المفتاح: &مفتاح_وحدة_مقنن): طبيعي {
    دع الهاش: متغير طبيعي = امزج_هاش_مفتاح_وحدة(1, (*المفتاح).الجذر.القيمة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المفتاح).المسار.الأجزاء) مثل طبيعي)) {
        دع مرجع_الجزء: &جزء_مسار_وحدة_منطقي = &(*المفتاح).المسار.الأجزاء[ف];
        الهاش := امزج_هاش_مفتاح_وحدة(
            الهاش, الطول((*مرجع_الجزء).البايتات) مثل طبيعي
        );
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*مرجع_الجزء).البايتات) مثل طبيعي)) {
            الهاش := امزج_هاش_مفتاح_وحدة(
                الهاش, (*مرجع_الجزء).البايتات[ح] مثل طبيعي
            );
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع الهاش;
}

عرف ابن_فهرس_مفاتيح_وحدات_فارغا(
    السعة: طبيعي
): متجه اختياري مدخل_فهرس_وحدة_محملة {
    دع الناتج: متغير متجه اختياري مدخل_فهرس_وحدة_محملة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) {
        ألحق(الناتج, اختياري.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف موضع_إدراج_مدخل_فهرس_وحدة_محملة(
    الفهرس: &متجه اختياري مدخل_فهرس_وحدة_محملة,
    الهاش: طبيعي
): اختياري طبيعي {
    دع السعة: طبيعي = الطول(*الفهرس) مثل طبيعي;
    لو (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الموضع: متغير طبيعي = الهاش % السعة;
    طالما (صواب) {
        طابق (*الفهرس)[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(الموضع); }
        | اختياري.موجود(_) -> { الموضع := (الموضع + 1) % السعة; };
    }
    أرجع اختياري.لا_شيء();
}

عرف أدرج_مدخل_فهرس_وحدة_محملة(
    الفهرس: &متغير متجه اختياري مدخل_فهرس_وحدة_محملة,
    المدخل: مدخل_فهرس_وحدة_محملة
): فراغ {
    طابق موضع_إدراج_مدخل_فهرس_وحدة_محملة(الفهرس, المدخل.الهاش) مع
    | اختياري.موجود(الموضع) -> { (*الفهرس)[الموضع] := اختياري.موجود(المدخل); }
    | اختياري.لا_شيء -> { };
}

عرف تأكد_سعة_فهرس_مفاتيح_الوحدات(المحمل: &متغير محمل_وحدات): فراغ {
    دع العدد: طبيعي = الطول((*المحمل).المحملة) مثل طبيعي;
    دع القديمة: طبيعي = الطول((*المحمل).فهرس_المفاتيح) مثل طبيعي;
    دع تحتاج: متغير منطقي = القديمة == 0;
    لو (!تحتاج) {
        تحتاج := (العدد * 3) >= (القديمة * 2);
    };
    لو (!تحتاج) { أرجع; };
    دع الجديدة: متغير طبيعي = 16;
    لو (القديمة > 0) { الجديدة := القديمة * 2; };
    دع الفهرس_الجديد: متغير متجه اختياري مدخل_فهرس_وحدة_محملة =
        ابن_فهرس_مفاتيح_وحدات_فارغا(الجديدة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < القديمة) {
        طابق (*المحمل).فهرس_المفاتيح[ف] مع
        | اختياري.موجود(المدخل) -> {
            أدرج_مدخل_فهرس_وحدة_محملة(&متغير الفهرس_الجديد, المدخل);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    (*المحمل).فهرس_المفاتيح := الفهرس_الجديد;
}

عرف سجل_مفتاح_وحدة_محملة(
    المحمل: &متغير محمل_وحدات,
    المفتاح: &مفتاح_وحدة_مقنن,
    الوحدة: معرف_وحدة
): فراغ {
    تأكد_سعة_فهرس_مفاتيح_الوحدات(المحمل);
    دع الهاش: طبيعي = هاش_مفتاح_وحدة_محملة(المفتاح);
    دع المدخل: مدخل_فهرس_وحدة_محملة = {
        الهاش: الهاش,
        الوحدة: الوحدة
    };
    طابق موضع_إدراج_مدخل_فهرس_وحدة_محملة(&(*المحمل).فهرس_المفاتيح, الهاش) مع
    | اختياري.موجود(الموضع) -> { (*المحمل).فهرس_المفاتيح[الموضع] := اختياري.موجود(المدخل); }
    | اختياري.لا_شيء -> { };
}

عام عرف وحدة_محملة_بالمفتاح(
    المحمل: &محمل_وحدات,
    المفتاح: &مفتاح_وحدة_مقنن
): اختياري وحدة_مصدر_محملة {
    دع السعة: طبيعي = الطول((*المحمل).فهرس_المفاتيح) مثل طبيعي;
    لو (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_مفتاح_وحدة_محملة(المفتاح);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        طابق (*المحمل).فهرس_المفاتيح[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المدخل) -> {
            لو (المدخل.الهاش == الهاش
                && المدخل.الوحدة.القيمة < (الطول((*المحمل).المحملة) مثل طبيعي)) {
                دع المرجع: &وحدة_مصدر_محملة = &(*المحمل).المحملة[المدخل.الوحدة.القيمة];
                دع الوحدة: وحدة_مصدر_محملة = انسخ_وحدة_مصدر_محملة(المرجع);
                لو (مفتاحا_وحدة_متساويان(&الوحدة.المفتاح, المفتاح)) {
                    أرجع اختياري.موجود(الوحدة);
                };
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف وحدة_محملة_بالمعرف(
    المحمل: &محمل_وحدات,
    المعرف: معرف_وحدة
): اختياري وحدة_مصدر_محملة {
    // Module IDs are allocated densely immediately before append by this loader.
    لو (المعرف.القيمة >= (الطول((*المحمل).المحملة) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(انسخ_وحدة_مصدر_محملة(&(*المحمل).المحملة[المعرف.القيمة]));
}

// Frontend parsing needs only the canonical SourceID.  Returning the scalar ID
// avoids copying a loaded module/source buffer merely to lex its contents.
عام عرف معرف_مصدر_وحدة_محملة_بالمعرف(
    المحمل: &محمل_وحدات,
    المعرف: معرف_وحدة
): اختياري طبيعي {
    لو (المعرف.القيمة >= (الطول((*المحمل).المحملة) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*المحمل).المحملة[المعرف.القيمة].معرف_المصدر);
}

// Import traversal state belongs to the loader lifecycle. The frontend marks a
// parsed module active while its direct-import closure is being traversed; edge
// creation can then reject a back-edge in constant time at the actual import.
عام عرف ابدأ_تحميل_استيرادات_وحدة(
    المحمل: &متغير محمل_وحدات,
    المعرف: معرف_وحدة
): منطقي {
    لو (المعرف.القيمة >= (الطول((*المحمل).النشطة) مثل طبيعي)) { أرجع خطأ; };
    لو ((*المحمل).النشطة[المعرف.القيمة]) { أرجع خطأ; };
    (*المحمل).النشطة[المعرف.القيمة] := صواب;
    أرجع صواب;
}

عام عرف انه_تحميل_استيرادات_وحدة(
    المحمل: &متغير محمل_وحدات,
    المعرف: معرف_وحدة
): فراغ {
    لو (المعرف.القيمة < (الطول((*المحمل).النشطة) مثل طبيعي)) {
        (*المحمل).النشطة[المعرف.القيمة] := خطأ;
    };
}

عرف وحدة_نشطة_في_تحميل_الاستيرادات(
    المحمل: &محمل_وحدات,
    المعرف: معرف_وحدة
): منطقي {
    لو (المعرف.القيمة >= (الطول((*المحمل).النشطة) مثل طبيعي)) { أرجع خطأ; };
    أرجع (*المحمل).النشطة[المعرف.القيمة];
}

// Canonical source lookup for frontend consumers that need source text or derived coordinates.
// SourceMap is the sole source-buffer owner; the loader stores only SourceID.
عام عرف مصدر_محمل_بالمعرف(
    الخريطة: &خريطة_مصادر,
    معرف_المصدر: طبيعي
): اختياري مصدر {
    لو (معرف_المصدر >= (الطول((*الخريطة).المصادر) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع المصدر: &مصدر = &(*الخريطة).المصادر[معرف_المصدر];
    لو ((*المصدر).المعرف != معرف_المصدر) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_مملوكا_مصدر(المصدر));
}

عام عرف اسم_مصدر_محمل_بالمعرف(
    الخريطة: &خريطة_مصادر,
    معرف_المصدر: طبيعي
): اختياري نص {
    أرجع اسم_مصدر_من_الخريطة(الخريطة, معرف_المصدر);
}

عام عرف مقتطف_مصدر_محمل_لنطاق(
    الخريطة: &خريطة_مصادر,
    النطاق: &نطاق
): اختياري نص {
    أرجع مقتطف_من_الخريطة(الخريطة, النطاق);
}

عرف خطأ_تحميل_من_تحديد(
    الخطأ: خطأ_تحديد_مصدر
): خطأ_تحميل_وحدة {
    طابق الخطأ مع
    | خطأ_تحديد_مصدر.غير_موجود -> {
        أرجع خطأ_تحميل_وحدة.مصدر_غير_موجود();
    }
    | خطأ_تحديد_مصدر.غير_مقروء -> {
        أرجع خطأ_تحميل_وحدة.مصدر_غير_مقروء();
    };
}

عرف خطأ_تحميل_من_حل(
    الخطأ: خطأ_حل_استيراد
): خطأ_تحميل_وحدة {
    طابق الخطأ مع
    | خطأ_حل_استيراد.مرجع_غير_صالح -> {
        أرجع خطأ_تحميل_وحدة.مرجع_غير_صالح();
    }
    | خطأ_حل_استيراد.جذر_غير_معلن -> {
        أرجع خطأ_تحميل_وحدة.جذر_غير_معلن();
    }
    | خطأ_حل_استيراد.هروب_من_الجذر -> {
        أرجع خطأ_تحميل_وحدة.هروب_من_الجذر();
    }
    | خطأ_حل_استيراد.مسار_منطقي_غير_صالح -> {
        أرجع خطأ_تحميل_وحدة.مسار_منطقي_غير_صالح();
    }
    | خطأ_حل_استيراد.تعارض_مسار_عام -> {
        أرجع خطأ_تحميل_وحدة.تعارض_مسار_عام();
    };
}

عرف اربط_مصدر_بوحدة(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المحدد: مصدر_محدد
): نتيجة_تحميل_وحدة {
    طابق وحدة_محملة_بالمفتاح(المحمل, &المحدد.المفتاح) مع
    | اختياري.موجود(القديمة) -> {
        // Canonical ModuleKey already identifies the loaded source. Do not reread/compare it.
        أرجع نتيجة_تحميل_وحدة.محملة(القديمة);
    }
    | اختياري.لا_شيء -> {
    };

    دع معرف_الوحدة: معرف_وحدة = خصص_معرف_وحدة(الرسم);
    دع الجذر: معرف_نطاق = نطاق_جذري(سياق_الأسماء, معرف_الوحدة);
    دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &المحدد.المفتاح;
    دع المفتاح: مفتاح_وحدة_مقنن = انسخ_مملوكا_مفتاح_وحدة_مقنن(مرجع_المفتاح);
    دع مرجع_مسار_المصدر: &نص = &المحدد.مسار_ملف_المصدر;
    دع مسار_المصدر: نص = انسخ_نص(مرجع_مسار_المصدر);
    دع مسار_المحملة: نص = انسخ_نص(مرجع_مسار_المصدر);
    دع مرجع_محتوى_المصدر: &نص = &المحدد.المحتوى;
    دع محتوى_المصدر: نص = انسخ_نص(مرجع_محتوى_المصدر);
    دع معرف_المصدر: طبيعي = أضف_مصدر_إلى_خريطة(
        سياق_المصادر,
        مسار_المصدر,
        محتوى_المصدر
    );
    دع المصدر: &مصدر = &(*سياق_المصادر).المصادر[معرف_المصدر];
    دع بداية_المصدر: موضع = {
        المصدر: معرف_المصدر,
        البايت: 0
    };
    دع طول_المصدر: طبيعي = (*المصدر).الطول;
    دع نهاية_المصدر: موضع = {
        المصدر: معرف_المصدر,
        البايت: طول_المصدر
    };
    دع نطاق_المصدر: نطاق = نطاق_بين(بداية_المصدر, نهاية_المصدر);
    ضع_نطاق_مصدر_لنطاق(سياق_الأسماء, الجذر, نطاق_المصدر);
    دع الدلالية: وحدة_دلالية = {
        المعرف: معرف_الوحدة,
        النطاق_الجذري: الجذر,
        معرف_المصدر: معرف_المصدر
    };
    أضف_وحدة_للرسم(الرسم, الدلالية);

    دع المحملة: وحدة_مصدر_محملة = {
        المفتاح: المفتاح,
        مسار_ملف_المصدر: مسار_المحملة,
        معرف_المصدر: معرف_المصدر,
        الوحدة: معرف_الوحدة
    };
    ألحق(
        (*المحمل).المحملة,
        انسخ_وحدة_مصدر_محملة(&المحملة)
    );
    ألحق((*المحمل).النشطة, خطأ);
    سجل_مفتاح_وحدة_محملة(المحمل, &المحملة.المفتاح, معرف_الوحدة);
    أرجع نتيجة_تحميل_وحدة.محملة(المحملة);
}

عام عرف حمل_وحدة_جذر(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): نتيجة_تحميل_وحدة {
    طابق حدد_مصدر_وحدة_لهدف(البيئة, المفتاح, &(*المحمل).الهدف) مع
    | نتيجة_تحديد_مصدر.خطأ(الخطأ) -> {
        أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_من_تحديد(الخطأ));
    }
    | نتيجة_تحديد_مصدر.موجود(المحدد) -> {
        أرجع اربط_مصدر_بوحدة(
            المحمل,
            سياق_المصادر,
            سياق_الأسماء,
            الرسم,
            البيئة,
            المحدد
        );
    };
}

عرف انسخ_مرجعا_من_نطاق(
    المصدر: &مصدر,
    النطاق: نطاق
): نتيجة_مرجع_استيراد {
    لو (
        (النطاق.البداية.المصدر != (*المصدر).المعرف)
        || (النطاق.النهاية.المصدر != (*المصدر).المعرف)
        || (النطاق.النهاية.البايت < النطاق.البداية.البايت)
        || (النطاق.النهاية.البايت > (*المصدر).الطول)
    ) {
        أرجع نتيجة_مرجع_استيراد.غير_صالح();
    };
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = النطاق.البداية.البايت;
    طالما (ف < النطاق.النهاية.البايت) {
        ألحق(البايتات, (*المصدر).المحتوى[ف]);
        ف := ف + 1;
    }
    لو (!مرجع_استيراد_صالح(&البايتات)) {
        أرجع نتيجة_مرجع_استيراد.غير_صالح();
    };
    أرجع نتيجة_مرجع_استيراد.صالح(البايتات);
}

عرف مرجع_مسار_استيراد_مسمى_كبايتات(
    المصدر: &مصدر,
    المسار: &متجه اسم
): نتيجة_مرجع_استيراد {
    لو ((الطول(*المسار) مثل طبيعي) < 2) {
        أرجع نتيجة_مرجع_استيراد.غير_صالح();
    };
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المسار) مثل طبيعي)) {
        لو (ف > 0) { ألحق(البايتات, 0x2F); };
        طابق انسخ_مرجعا_من_نطاق(المصدر, (*المسار)[ف].النطاق) مع
        | نتيجة_مرجع_استيراد.غير_صالح -> {
            أرجع نتيجة_مرجع_استيراد.غير_صالح();
        }
        | نتيجة_مرجع_استيراد.صالح(الجزء) -> {
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول(الجزء) مثل طبيعي)) {
                ألحق(البايتات, الجزء[ح]);
                ح := ح + 1;
            }
        };
        ف := ف + 1;
    }
    ألحق_بايتات_نص(&متغير البايتات, «.sn»);
    لو (!مرجع_استيراد_صالح(&البايتات)) {
        أرجع نتيجة_مرجع_استيراد.غير_صالح();
    };
    أرجع نتيجة_مرجع_استيراد.صالح(البايتات);
}

عام عرف مرجع_الاستيراد_كبايتات(
    المصدر: &مصدر,
    الاستيراد: &استيراد
): نتيجة_مرجع_استيراد {
    طابق *الاستيراد مع
    | استيراد.اسم(النطاق, المسار, _) -> {
        لو (
            (النطاق.البداية.المصدر != (*المصدر).المعرف)
            || (النطاق.النهاية.المصدر != (*المصدر).المعرف)
        ) {
            أرجع نتيجة_مرجع_استيراد.غير_صالح();
        };
        أرجع مرجع_مسار_استيراد_مسمى_كبايتات(المصدر, &المسار);
    }
    | استيراد.نص(النطاق, البايتات, _) -> {
        لو (
            (النطاق.البداية.المصدر != (*المصدر).المعرف)
            || (النطاق.النهاية.المصدر != (*المصدر).المعرف)
            || (النطاق.النهاية.البايت < النطاق.البداية.البايت)
            || (النطاق.النهاية.البايت > (*المصدر).الطول)
            || !مرجع_استيراد_صالح(&البايتات)
        ) {
            أرجع نتيجة_مرجع_استيراد.غير_صالح();
        };
        أرجع نتيجة_مرجع_استيراد.صالح(انسخ_بايتات(&البايتات));
    }
    | استيراد.انتقائي(_, المسار, _) -> {
        دع البايتات: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المسار) مثل طبيعي)) {
            لو (ف > 0) { ألحق(البايتات, 0x2F); };
            طابق انسخ_مرجعا_من_نطاق(المصدر, المسار[ف].النطاق) مع
            | نتيجة_مرجع_استيراد.غير_صالح -> { أرجع نتيجة_مرجع_استيراد.غير_صالح(); }
            | نتيجة_مرجع_استيراد.صالح(الجزء) -> {
                دع ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الجزء) مثل طبيعي)) {
                    ألحق(البايتات, الجزء[ح]);
                    ح := ح + 1;
                }
            };
            ف := ف + 1;
        }
        لو (!مرجع_استيراد_صالح(&البايتات)) { أرجع نتيجة_مرجع_استيراد.غير_صالح(); };
        أرجع نتيجة_مرجع_استيراد.صالح(البايتات);
    };
}

عرف إضافة_استيراد_تصنع_دورة(
    المحمل: &محمل_وحدات,
    المستورد_منه: معرف_وحدة
): منطقي {
    أرجع وحدة_نشطة_في_تحميل_الاستيرادات(المحمل, المستورد_منه);
}

عرف أضف_حافة_محملة(
    المحمل: &محمل_وحدات,
    الرسم: &متغير رسم_وحدات,
    المستورد: معرف_وحدة,
    المستورد_منه: معرف_وحدة,
    المصدر: &مصدر,
    المرادف: اختياري اسم,
    الوحدة: وحدة_مصدر_محملة
): نتيجة_تحميل_وحدة {
    طابق المرادف مع
    | اختياري.لا_شيء -> {
        لو (إضافة_استيراد_تصنع_دورة(المحمل, المستورد_منه)) {
            أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_وحدة.دورة_استيراد());
        };
        أضف_استيرادا(الرسم, المستورد, المستورد_منه);
    }
    | اختياري.موجود(الاسم) -> {
        لو (
            (الاسم.النطاق.البداية.المصدر != (*المصدر).المعرف)
            || (الاسم.النطاق.النهاية.المصدر != (*المصدر).المعرف)
            || (الاسم.النطاق.النهاية.البايت < الاسم.النطاق.البداية.البايت)
            || (الاسم.النطاق.النهاية.البايت > (*المصدر).الطول)
            || !هوية_معرف_لها_محتوى_في_شريحة(
                &(*المصدر).المحتوى,
                الاسم.النطاق.البداية.البايت,
                الاسم.النطاق.النهاية.البايت
            )
        ) {
            أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_وحدة.مرجع_غير_صالح());
        };
        دع الهوية: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
            &(*المصدر).المحتوى,
            الاسم.النطاق.البداية.البايت,
            الاسم.النطاق.النهاية.البايت
        );
        دع الربط: مرادف_استيراد_وحدة = { الهوية: الهوية, النطاق: الاسم.النطاق };
        لو (إضافة_استيراد_تصنع_دورة(المحمل, المستورد_منه)) {
            أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_وحدة.دورة_استيراد());
        };
        أضف_استيرادا_مسمى(الرسم, المستورد, المستورد_منه, الربط);
    };
    أرجع نتيجة_تحميل_وحدة.محملة(الوحدة);
}

عرف اسم_استيراد_انتقائي_من_اسم(
    المصدر: &مصدر,
    الاسم: &اسم
): اختياري اسم_استيراد_انتقائي {
    لو (
        ((*الاسم).النطاق.البداية.المصدر != (*المصدر).المعرف)
        || ((*الاسم).النطاق.النهاية.المصدر != (*المصدر).المعرف)
        || ((*الاسم).النطاق.النهاية.البايت < (*الاسم).النطاق.البداية.البايت)
        || ((*الاسم).النطاق.النهاية.البايت > (*المصدر).الطول)
        || !هوية_معرف_لها_محتوى_في_شريحة(
            &(*المصدر).المحتوى,
            (*الاسم).النطاق.البداية.البايت,
            (*الاسم).النطاق.النهاية.البايت
        )
    ) {
        أرجع اختياري.لا_شيء();
    };
    دع الهوية: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى,
        (*الاسم).النطاق.البداية.البايت,
        (*الاسم).النطاق.النهاية.البايت
    );
    دع النطاق: نطاق = (*الاسم).النطاق;
    دع الناتج: اسم_استيراد_انتقائي = { الهوية: الهوية, النطاق: النطاق };
    أرجع اختياري.موجود(الناتج);
}

عرف اربط_مصدر_بمفتاح_استيراد(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): نتيجة_تحميل_وحدة {
    // A ModuleKey that is already loaded identifies its source: return it
    // before the source is located and read again. Previously every import
    // re-read (and re-checked) the imported file before the loader noticed
    // the key was loaded; a self-build opened each module about seven times.
    طابق وحدة_محملة_بالمفتاح(المحمل, المفتاح) مع
    | اختياري.موجود(القديمة) -> { أرجع نتيجة_تحميل_وحدة.محملة(القديمة); }
    | اختياري.لا_شيء -> { };
    طابق حدد_مصدر_وحدة_لهدف(البيئة, المفتاح, &(*المحمل).الهدف) مع
    | نتيجة_تحديد_مصدر.خطأ(الخطأ) -> { أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_من_تحديد(الخطأ)); }
    | نتيجة_تحديد_مصدر.موجود(المحدد) -> {
        أرجع اربط_مصدر_بوحدة(المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المحدد);
    };
}

عرف حمل_استيرادا_انتقائيا(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: معرف_وحدة,
    الاستيراد: &استيراد
): نتيجة_تحميل_استيرادات {
    دع النتائج: متغير متجه معرف_وحدة = [];
    طابق وحدة_محملة_بالمعرف(المحمل, المستورد) مع
    | اختياري.لا_شيء -> {
        دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة());
        أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
    }
    | اختياري.موجود(الوحدة_المستوردة) -> {
        دع المصدر_المستورد: &مصدر = &(*سياق_المصادر).المصادر[الوحدة_المستوردة.معرف_المصدر];
        طابق *الاستيراد مع
        | استيراد.انتقائي(_, _, الأسماء) -> {
            دع مرجع_الحزمة: متجه ط8;
            طابق مرجع_الاستيراد_كبايتات(المصدر_المستورد, الاستيراد) مع
            | نتيجة_مرجع_استيراد.غير_صالح -> {
                دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, خطأ_تحميل_وحدة.مرجع_غير_صالح());
                أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
            }
            | نتيجة_مرجع_استيراد.صالح(القيمة) -> { مرجع_الحزمة := القيمة; };

            // Resolve the requested package to one canonical RootID/ModuleKey,
            // then discover its immediate .sn members from the configured source
            // root. No compiler-owned std filename inventory participates here.
            طابق حل_مرجع_استيراد(
                البيئة, &الوحدة_المستوردة.المفتاح, &مرجع_الحزمة
            ) مع
            | نتيجة_حل_استيراد.خطأ(_) -> {
                // Preserve the ordinary-module diagnostic path below.
            }
            | نتيجة_حل_استيراد.محلول(مفتاح_الحزمة) -> {
                طابق ضمن_أعضاء_حزمة_مصدر_محمل(المحمل, البيئة, &مفتاح_الحزمة) مع
                | نتيجة_اكتشاف_أعضاء_حزمة.ليست_حزمة -> {
                    // Not a directory package; fall through to ordinary module
                    // selective import resolution below.
                }
                | نتيجة_اكتشاف_أعضاء_حزمة.غير_مقروءة -> {
                    دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(
                        0, خطأ_تحميل_وحدة.مصدر_غير_مقروء()
                    );
                    أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                }
                | نتيجة_اكتشاف_أعضاء_حزمة.موجودة(أعضاء_الحزمة) -> {
                    دع القيود: متغير متجه اسم_استيراد_انتقائي = [];
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
                        طابق اسم_استيراد_انتقائي_من_اسم(المصدر_المستورد, &الأسماء[ف]) مع
                        | اختياري.لا_شيء -> {
                            دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(ف, خطأ_تحميل_وحدة.مرجع_غير_صالح());
                            أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                        }
                        | اختياري.موجود(القيد) -> { ألحق(القيود, القيد); };
                        ف := ف + 1;
                    }

                    لو ((الطول(أعضاء_الحزمة) مثل طبيعي) == 0) {
                        دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(
                            0, خطأ_تحميل_وحدة.تصدير_انتقائي_مفقود()
                        );
                        أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                    };

                    // Build the declaration-owner index once from discovered
                    // canonical members. Name remains the visibility/ambiguity
                    // authority after the selected dependency closure is loaded.
                    دع أعضاء_التحميل: متغير متجه مفتاح_وحدة_مقنن = [];
                    طابق ضمن_فهرس_تصديرات_حزمة_محمل(المحمل, البيئة, &أعضاء_الحزمة) مع
                    | اختياري.لا_شيء -> {
                        // If a member cannot be parsed for discovery, preserve
                        // semantic diagnostics by loading all discovered members.
                        دع ك: متغير طبيعي = 0;
                        طالما (ك < (الطول(أعضاء_الحزمة) مثل طبيعي)) {
                            ألحق(أعضاء_التحميل, انسخ_مفتاح_وحدة_مقنن(&أعضاء_الحزمة[ك]));
                            ك := ك + 1;
                        }
                    }
                    | اختياري.موجود(موضع_الفهرس) -> {
                        دع المحددة: متغير متجه مفتاح_وحدة_مقنن = [];
                        دع ق: متغير طبيعي = 0;
                        طالما (ق < (الطول(القيود) مثل طبيعي)) {
                            دع المرشحون: متجه مفتاح_وحدة_مقنن = أعضاء_حزمة_مرشحون_لهوية(
                                &(*المحمل).فهارس_تصديرات_الحزم[موضع_الفهرس],
                                &القيود[ق].الهوية
                            );
                            دع م: متغير طبيعي = 0;
                            طالما (م < (الطول(المرشحون) مثل طبيعي)) {
                                دع موجود: متغير منطقي = خطأ;
                                دع س: متغير طبيعي = 0;
                                طالما (س < (الطول(المحددة) مثل طبيعي)) {
                                    لو (مفتاحا_وحدة_متساويان(&المحددة[س], &المرشحون[م])) {
                                        موجود := صواب;
                                    };
                                    س := س + 1;
                                }
                                لو (!موجود) {
                                    ألحق(المحددة, انسخ_مفتاح_وحدة_مقنن(&المرشحون[م]));
                                };
                                م := م + 1;
                            }
                            ق := ق + 1;
                        }
                        // Keep one discovered member as a validation anchor if
                        // every requested spelling is absent. Name then emits the
                        // canonical missing-export diagnostic.
                        لو ((الطول(المحددة) مثل طبيعي) == 0) {
                            ألحق(المحددة, انسخ_مفتاح_وحدة_مقنن(&أعضاء_الحزمة[0]));
                        };
                        أعضاء_التحميل := المحددة;
                    };

                    دع ع: متغير طبيعي = 0;
                    طالما (ع < (الطول(أعضاء_التحميل) مثل طبيعي)) {
                        دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &أعضاء_التحميل[ع];
                        دع المفتاح: مفتاح_وحدة_مقنن = انسخ_مفتاح_وحدة_مقنن(مرجع_المفتاح);
                        طابق اربط_مصدر_بمفتاح_استيراد(
                            المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, &المفتاح
                        ) مع
                        | نتيجة_تحميل_وحدة.خطأ(السبب) -> {
                            دع الخطأ: خطأ_تحميل_استيرادات = { الفهرس: ع, الخطأ: السبب };
                            أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                        }
                        | نتيجة_تحميل_وحدة.محملة(الهدف) -> {
                            لو (إضافة_استيراد_تصنع_دورة(المحمل, الهدف.الوحدة)) {
                                دع الخطأ: خطأ_تحميل_استيرادات = {
                                    الفهرس: ع,
                                    الخطأ: خطأ_تحميل_وحدة.دورة_استيراد()
                                };
                                أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                            };
                            أضف_استيرادا_انتقائيا(الرسم, المستورد, الهدف.الوحدة, &القيود);
                            ألحق(النتائج, الهدف.الوحدة);
                        };
                        ع := ع + 1;
                    }
                    أرجع نتيجة_تحميل_استيرادات.محملة(النتائج);
                };
            };

            // Ordinary module selective import: resolve one source module, then
            // Name validates and exposes only the explicitly selected declarations.
            طابق حل_مرجع_استيراد(
                البيئة, &الوحدة_المستوردة.المفتاح, &مرجع_الحزمة
            ) مع
            | نتيجة_حل_استيراد.خطأ(الخطأ) -> {
                دع السبب: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, خطأ_تحميل_من_حل(الخطأ));
                أرجع نتيجة_تحميل_استيرادات.خطأ(السبب);
            }
            | نتيجة_حل_استيراد.محلول(المفتاح) -> {
                    طابق اربط_مصدر_بمفتاح_استيراد(
                        المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, &المفتاح
                    ) مع
                    | نتيجة_تحميل_وحدة.خطأ(السبب) -> {
                        دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, السبب);
                        أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                    }
                    | نتيجة_تحميل_وحدة.محملة(الهدف) -> {
                        // The load appended to the source table; re-borrow the importer.
                        دع مصدر_المستورد_الحالي: &مصدر = &(*سياق_المصادر).المصادر[الوحدة_المستوردة.معرف_المصدر];
                        دع القيود: متغير متجه اسم_استيراد_انتقائي = [];
                        دع ف: متغير طبيعي = 0;
                        طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
                            طابق اسم_استيراد_انتقائي_من_اسم(مصدر_المستورد_الحالي, &الأسماء[ف]) مع
                            | اختياري.لا_شيء -> {
                                دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(ف, خطأ_تحميل_وحدة.مرجع_غير_صالح());
                                أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                            }
                            | اختياري.موجود(القيد) -> { ألحق(القيود, القيد); };
                            ف := ف + 1;
                        }
                        لو (إضافة_استيراد_تصنع_دورة(المحمل, الهدف.الوحدة)) {
                            دع الخطأ: خطأ_تحميل_استيرادات = {
                                الفهرس: 0,
                                الخطأ: خطأ_تحميل_وحدة.دورة_استيراد()
                            };
                            أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                        };
                        أضف_استيرادا_انتقائيا(الرسم, المستورد, الهدف.الوحدة, &القيود);
                        ألحق(النتائج, الهدف.الوحدة);
                        أرجع نتيجة_تحميل_استيرادات.محملة(النتائج);
                    };
            };
        }
        | _ -> {
            دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(0, خطأ_تحميل_وحدة.مرجع_غير_صالح());
            أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
        };
    };
}

عرف حل_استيراد_بحسب_البنية(
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: &مفتاح_وحدة_مقنن,
    الاستيراد: &استيراد,
    المرجع: &متجه ط8
): نتيجة_حل_استيراد {
    طابق *الاستيراد مع
    | استيراد.نص(_, _, _) -> {
        أرجع حل_استيراد_نسبي(البيئة, المستورد, المرجع);
    }
    | استيراد.اسم(_, _, _) -> {
        أرجع حل_استيراد_بجذر_مسمى(البيئة, المستورد, المرجع);
    }
    | استيراد.انتقائي(_, _, _) -> {
        أرجع حل_مرجع_استيراد(البيئة, المستورد, المرجع);
    };
}

عام عرف حمل_استيرادا(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: معرف_وحدة,
    الاستيراد: &استيراد
): نتيجة_تحميل_وحدة {
    طابق وحدة_محملة_بالمعرف(المحمل, المستورد) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحميل_وحدة.خطأ(
            خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة()
        );
    }
    | اختياري.موجود(الوحدة_المستوردة) -> {
        دع المصدر_المستورد: &مصدر = &(*سياق_المصادر).المصادر[الوحدة_المستوردة.معرف_المصدر];
        طابق مرجع_الاستيراد_كبايتات(المصدر_المستورد, الاستيراد) مع
        | نتيجة_مرجع_استيراد.غير_صالح -> {
            أرجع نتيجة_تحميل_وحدة.خطأ(
                خطأ_تحميل_وحدة.مرجع_غير_صالح()
            );
        }
        | نتيجة_مرجع_استيراد.صالح(البايتات) -> {
            طابق حل_استيراد_بحسب_البنية(
                البيئة,
                &الوحدة_المستوردة.المفتاح,
                الاستيراد,
                &البايتات
            ) مع
            | نتيجة_حل_استيراد.خطأ(الخطأ) -> {
                أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_من_حل(الخطأ));
            }
            | نتيجة_حل_استيراد.محلول(المفتاح) -> {
                    طابق اربط_مصدر_بمفتاح_استيراد(
                        المحمل,
                        سياق_المصادر,
                        سياق_الأسماء,
                        الرسم,
                        البيئة,
                        &المفتاح
                    ) مع
                    | نتيجة_تحميل_وحدة.خطأ(الخطأ) -> {
                        أرجع نتيجة_تحميل_وحدة.خطأ(الخطأ);
                    }
                    | نتيجة_تحميل_وحدة.محملة(الهدف) -> {
                        // Loading the target appends to the source table, so a
                        // reference taken before the load may no longer be valid.
                        دع مصدر_المستورد_الحالي: &مصدر = &(*سياق_المصادر).المصادر[الوحدة_المستوردة.معرف_المصدر];
                        طابق *الاستيراد مع
                        | استيراد.اسم(_, _, المرادف) -> {
                            أرجع أضف_حافة_محملة(
                                المحمل, الرسم, المستورد, الهدف.الوحدة, مصدر_المستورد_الحالي, المرادف, الهدف
                            );
                        }
                        | استيراد.نص(_, _, المرادف) -> {
                            أرجع أضف_حافة_محملة(
                                المحمل, الرسم, المستورد, الهدف.الوحدة, مصدر_المستورد_الحالي, المرادف, الهدف
                            );
                        }
                        | استيراد.انتقائي(_, _, _) -> {
                            أرجع نتيجة_تحميل_وحدة.خطأ(خطأ_تحميل_وحدة.مرجع_غير_صالح());
                        };
                    };
            };
        };
    };
}

عام عرف حمل_استيرادات_مباشرة(
    المحمل: &متغير محمل_وحدات,
    سياق_المصادر: &متغير خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &متغير رسم_وحدات,
    البيئة: &بيئة_وحدات_منطقية,
    المستورد: معرف_وحدة,
    الوحدة_المحللة: &وحدة_مصدر
): نتيجة_تحميل_استيرادات {
    طابق وحدة_محملة_بالمعرف(المحمل, المستورد) مع
    | اختياري.لا_شيء -> {
        دع سبب: خطأ_تحميل_وحدة = خطأ_تحميل_وحدة.وحدة_مستوردة_غير_محملة();
        دع الخطأ: خطأ_تحميل_استيرادات = {
            الفهرس: 0,
            الخطأ: سبب
        };
        أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
    }
    | اختياري.موجود(المحملة) -> {
        لو ((*الوحدة_المحللة).معرف_المصدر != المحملة.معرف_المصدر) {
            دع سبب: خطأ_تحميل_وحدة = خطأ_تحميل_وحدة.مصدر_وحدة_متعارض();
            دع الخطأ: خطأ_تحميل_استيرادات = {
                الفهرس: 0,
                الخطأ: سبب
            };
            أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
        };
        دع النتائج: متغير متجه معرف_وحدة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الوحدة_المحللة).الاستيرادات) مثل طبيعي)) {
            دع مرجع_الاستيراد: &استيراد = &(*الوحدة_المحللة).الاستيرادات[ف];
            طابق *مرجع_الاستيراد مع
            | استيراد.انتقائي(_, _, _) -> {
                طابق حمل_استيرادا_انتقائيا(
                    المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المستورد, مرجع_الاستيراد
                ) مع
                | نتيجة_تحميل_استيرادات.خطأ(الخطأ) -> {
                    دع السبب: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(ف, الخطأ.الخطأ);
                    أرجع نتيجة_تحميل_استيرادات.خطأ(السبب);
                }
                | نتيجة_تحميل_استيرادات.محملة(المعرفات) -> {
                    دع ح: متغير طبيعي = 0;
                    طالما (ح < (الطول(المعرفات) مثل طبيعي)) {
                        ألحق(النتائج, المعرفات[ح]);
                        ح := ح + 1;
                    }
                };
            }
            | _ -> {
                طابق حمل_استيرادا(
                    المحمل, سياق_المصادر, سياق_الأسماء, الرسم, البيئة, المستورد, مرجع_الاستيراد
                ) مع
                | نتيجة_تحميل_وحدة.خطأ(سبب) -> {
                    دع الخطأ: خطأ_تحميل_استيرادات = خطأ_استيراد_عند(ف, سبب);
                    أرجع نتيجة_تحميل_استيرادات.خطأ(الخطأ);
                }
                | نتيجة_تحميل_وحدة.محملة(الهدف) -> { ألحق(النتائج, الهدف.الوحدة); };
            };
            ف := ف + 1;
        }
        أرجع نتيجة_تحميل_استيرادات.محملة(النتائج);
    };
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_وحدة_مصدر_محملة(القيمة: &وحدة_مصدر_محملة): وحدة_مصدر_محملة {
    دع الناتج: وحدة_مصدر_محملة = {
        المفتاح: انسخ_مملوكا_مفتاح_وحدة_مقنن(&(*القيمة).المفتاح),
        مسار_ملف_المصدر: انسخ_نص(&(*القيمة).مسار_ملف_المصدر),
        معرف_المصدر: (*القيمة).معرف_المصدر,
        الوحدة: (*القيمة).الوحدة
    };
    أرجع الناتج;
}
