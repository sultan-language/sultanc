استورد std.bytes.compare;
استورد std.bytes.range;
// Logical module paths are language-level identities. They never contain a
// filesystem-root bit and are never derived from a physical source location.
عام نوع جزء_مسار_وحدة_منطقي = {
    البايتات: متجه غ8
};

عام نوع مسار_وحدة_منطقي = {
    الأجزاء: متجه جزء_مسار_وحدة_منطقي
};

عام نوع نتيجة_مسار_وحدة_منطقي =
    | صالح بنوع مسار_وحدة_منطقي
    | غير_صالح
;

عام نوع تصنيف_مرجع_استيراد =
    | نسبي
    | جذر_مسمى
    | غير_صالح
;

عام نوع نتيجة_مسار_استيراد_نسبي =
    | صالح بنوع مسار_وحدة_منطقي
    | هروب_من_الجذر
    | غير_صالح
;

عرف انسخ_جزءا_منطقيا(
    البايتات: &متجه غ8,
    البداية: غير_موقع,
    النهاية: غير_موقع
): جزء_مسار_وحدة_منطقي {
    دع العدد: غير_موقع = النهاية - البداية;
    طابق انسخ_نطاق_بايتات(البايتات, البداية, العدد) مع
    | اختيار.بعض(النسخة) -> {
        دع الجزء: جزء_مسار_وحدة_منطقي = { البايتات: النسخة };
        أرجع الجزء;
    }
    | اختيار.لا_شيء -> {
        دع الفارغة: متجه غ8 = [];
        دع الجزء: جزء_مسار_وحدة_منطقي = { البايتات: الفارغة };
        أرجع الجزء;
    };
}

عام عرف جزء_منطقي_نقطة(الجزء: &جزء_مسار_وحدة_منطقي): منطقي {
    دع القيمة: جزء_مسار_وحدة_منطقي = *الجزء;
    أرجع ((الطول(القيمة.البايتات) مثل غير_موقع) == 1)
        && (القيمة.البايتات[0] == 0x2E);
}

عام عرف جزء_منطقي_نقطتان(الجزء: &جزء_مسار_وحدة_منطقي): منطقي {
    دع القيمة: جزء_مسار_وحدة_منطقي = *الجزء;
    أرجع ((الطول(القيمة.البايتات) مثل غير_موقع) == 2)
        && (القيمة.البايتات[0] == 0x2E)
        && (القيمة.البايتات[1] == 0x2E);
}

عرف انسخ_أجزاء_منطقية(
    الأصل: &متجه جزء_مسار_وحدة_منطقي
): متجه جزء_مسار_وحدة_منطقي {
    دع القيم: متجه جزء_مسار_وحدة_منطقي = *الأصل;
    دع الناتج: متغير متجه جزء_مسار_وحدة_منطقي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع المرجع: &جزء_مسار_وحدة_منطقي = &القيم[ف];
        دع القيمة: جزء_مسار_وحدة_منطقي = *المرجع;
        دع العدد: غير_موقع = الطول(القيمة.البايتات) مثل غير_موقع;
        ألحق(الناتج, انسخ_جزءا_منطقيا(&القيمة.البايتات, 0, العدد));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف احذف_آخر_جزء_منطقي(
    الأصل: &متجه جزء_مسار_وحدة_منطقي
): متجه جزء_مسار_وحدة_منطقي {
    دع القيم: متجه جزء_مسار_وحدة_منطقي = *الأصل;
    دع الناتج: متغير متجه جزء_مسار_وحدة_منطقي = [];
    دع العدد: غير_موقع = الطول(القيم) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما ((ف + 1) < العدد) {
        دع المرجع: &جزء_مسار_وحدة_منطقي = &القيم[ف];
        دع القيمة: جزء_مسار_وحدة_منطقي = *المرجع;
        دع طول_الجزء: غير_موقع = الطول(القيمة.البايتات) مثل غير_موقع;
        ألحق(الناتج, انسخ_جزءا_منطقيا(&القيمة.البايتات, 0, طول_الجزء));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مسار_وحدة_منطقي(
    المسار: &مسار_وحدة_منطقي
): مسار_وحدة_منطقي {
    دع الأصل: مسار_وحدة_منطقي = *المسار;
    دع الأجزاء: متجه جزء_مسار_وحدة_منطقي = انسخ_أجزاء_منطقية(&الأصل.الأجزاء);
    دع النسخة: مسار_وحدة_منطقي = { الأجزاء: الأجزاء };
    أرجع النسخة;
}

عام عرف بايتات_مسار_وحدة_منطقي(
    المسار: &مسار_وحدة_منطقي
): متجه غ8 {
    دع القيمة: مسار_وحدة_منطقي = *المسار;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.الأجزاء) مثل غير_موقع)) {
        لو (ف > 0) { ألحق(الناتج, 0x2F); };
        دع مرجع_الجزء: &جزء_مسار_وحدة_منطقي = &القيمة.الأجزاء[ف];
        دع الجزء: جزء_مسار_وحدة_منطقي = *مرجع_الجزء;
        دع ح: متغير غير_موقع = 0;
        بينما (ح < (الطول(الجزء.البايتات) مثل غير_موقع)) {
            ألحق(الناتج, الجزء.البايتات[ح]);
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف مسار_وحدة_منطقي_فارغ(): مسار_وحدة_منطقي {
    دع الأجزاء: متجه جزء_مسار_وحدة_منطقي = [];
    دع المسار: مسار_وحدة_منطقي = { الأجزاء: الأجزاء };
    أرجع المسار;
}

عام عرف مسارا_وحدة_منطقيان_متساويان(
    الأول: &مسار_وحدة_منطقي,
    الثاني: &مسار_وحدة_منطقي
): منطقي {
    دع أ: مسار_وحدة_منطقي = *الأول;
    دع ب: مسار_وحدة_منطقي = *الثاني;
    لو (الطول(أ.الأجزاء) != الطول(ب.الأجزاء)) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أ.الأجزاء) مثل غير_موقع)) {
        لو (!متجها_بايتات_متساويان(&أ.الأجزاء[ف].البايتات, &ب.الأجزاء[ف].البايتات)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف مرجع_استيراد_صالح(المرجع: &متجه غ8): منطقي {
    دع الأصل: متجه غ8 = *المرجع;
    دع العدد: غير_موقع = الطول(الأصل) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع خطأ;
    };
    لو (الأصل[0] == 0x2F) {
        أرجع خطأ;
    };
    دع الأخير: غير_موقع = العدد - 1;
    لو (الأصل[الأخير] == 0x2F) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (الأصل[ف] == 0) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف صنف_مرجع_استيراد(
    المرجع: &متجه غ8
): تصنيف_مرجع_استيراد {
    لو (!مرجع_استيراد_صالح(المرجع)) {
        أرجع تصنيف_مرجع_استيراد.غير_صالح();
    };
    دع الأصل: متجه غ8 = *المرجع;
    دع العدد: غير_موقع = الطول(الأصل) مثل غير_موقع;
    لو (
        (العدد >= 2)
        && (الأصل[0] == 0x2E)
        && (الأصل[1] == 0x2F)
    ) {
        أرجع تصنيف_مرجع_استيراد.نسبي();
    };
    لو (
        (العدد >= 3)
        && (الأصل[0] == 0x2E)
        && (الأصل[1] == 0x2E)
        && (الأصل[2] == 0x2F)
    ) {
        أرجع تصنيف_مرجع_استيراد.نسبي();
    };
    أرجع تصنيف_مرجع_استيراد.جذر_مسمى();
}

عام عرف أول_جزء_مرجع_استيراد(
    المرجع: &متجه غ8
): اختيار جزء_مسار_وحدة_منطقي {
    لو (!مرجع_استيراد_صالح(المرجع)) {
        أرجع اختيار.لا_شيء();
    };
    دع الأصل: متجه غ8 = *المرجع;
    دع العدد: غير_موقع = الطول(الأصل) مثل غير_موقع;
    دع النهاية: متغير غير_موقع = 0;
    بينما ((النهاية < العدد) && (الأصل[النهاية] != 0x2F)) {
        النهاية := النهاية + 1;
    }
    لو (النهاية == 0) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(انسخ_جزءا_منطقيا(&الأصل, 0, النهاية));
}

عام عرف باقي_مرجع_بعد_الجذر(
    المرجع: &متجه غ8
): اختيار متجه غ8 {
    لو (!مرجع_استيراد_صالح(المرجع)) {
        أرجع اختيار.لا_شيء();
    };
    دع الأصل: متجه غ8 = *المرجع;
    دع العدد: غير_موقع = الطول(الأصل) مثل غير_موقع;
    دع الفاصل: متغير غير_موقع = 0;
    بينما ((الفاصل < العدد) && (الأصل[الفاصل] != 0x2F)) {
        الفاصل := الفاصل + 1;
    }
    لو (الفاصل == العدد) {
        دع الفارغة: متجه غ8 = [];
        أرجع اختيار.بعض(الفارغة);
    };
    دع البداية: غير_موقع = الفاصل + 1;
    طابق انسخ_نطاق_بايتات(&الأصل, البداية, العدد - البداية) مع
    | اختيار.بعض(الباقي) -> {
        أرجع اختيار.بعض(الباقي);
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف قنن_مسار_وحدة_منطقي(
    البايتات: &متجه غ8
): نتيجة_مسار_وحدة_منطقي {
    دع الأصل: متجه غ8 = *البايتات;
    دع العدد: غير_موقع = الطول(الأصل) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع نتيجة_مسار_وحدة_منطقي.صالح(مسار_وحدة_منطقي_فارغ());
    };
    دع فهرس_الأخير: غير_موقع = العدد - 1;
    لو ((الأصل[0] == 0x2F) || (الأصل[فهرس_الأخير] == 0x2F)) {
        أرجع نتيجة_مسار_وحدة_منطقي.غير_صالح();
    };

    دع الأجزاء: متغير متجه جزء_مسار_وحدة_منطقي = [];
    دع البداية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف <= العدد) {
        دع نهاية_جزء: متغير منطقي = ف == العدد;
        لو (!نهاية_جزء) {
            نهاية_جزء := الأصل[ف] == 0x2F;
        };
        لو (نهاية_جزء) {
            لو (ف == البداية) {
                أرجع نتيجة_مسار_وحدة_منطقي.غير_صالح();
            };
            دع الجزء: جزء_مسار_وحدة_منطقي = انسخ_جزءا_منطقيا(&الأصل, البداية, ف);
            لو (جزء_منطقي_نقطة(&الجزء) || جزء_منطقي_نقطتان(&الجزء)) {
                أرجع نتيجة_مسار_وحدة_منطقي.غير_صالح();
            };
            ألحق(الأجزاء, الجزء);
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    دع المسار: مسار_وحدة_منطقي = { الأجزاء: الأجزاء };
    أرجع نتيجة_مسار_وحدة_منطقي.صالح(المسار);
}

عام عرف مجلد_مسار_وحدة_منطقي(
    المسار: &مسار_وحدة_منطقي
): مسار_وحدة_منطقي {
    دع الأصل: مسار_وحدة_منطقي = *المسار;
    دع الأجزاء: متجه جزء_مسار_وحدة_منطقي = احذف_آخر_جزء_منطقي(&الأصل.الأجزاء);
    دع الناتج: مسار_وحدة_منطقي = { الأجزاء: الأجزاء };
    أرجع الناتج;
}

عام عرف حل_مسار_استيراد_نسبي(
    المستورد: &مسار_وحدة_منطقي,
    المرجع: &متجه غ8
): نتيجة_مسار_استيراد_نسبي {
    لو (!مرجع_استيراد_صالح(المرجع)) {
        أرجع نتيجة_مسار_استيراد_نسبي.غير_صالح();
    };

    دع الأصل: متجه غ8 = *المرجع;
    دع العدد: غير_موقع = الطول(الأصل) مثل غير_موقع;
    دع المجلد: مسار_وحدة_منطقي = مجلد_مسار_وحدة_منطقي(المستورد);
    دع الأجزاء: متغير متجه جزء_مسار_وحدة_منطقي = انسخ_أجزاء_منطقية(&المجلد.الأجزاء);
    دع البداية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;

    بينما (ف <= العدد) {
        دع نهاية_جزء: متغير منطقي = ف == العدد;
        لو (!نهاية_جزء) {
            نهاية_جزء := الأصل[ف] == 0x2F;
        };
        لو (نهاية_جزء) {
            لو (ف == البداية) {
                أرجع نتيجة_مسار_استيراد_نسبي.غير_صالح();
            };
            دع الجزء: جزء_مسار_وحدة_منطقي = انسخ_جزءا_منطقيا(&الأصل, البداية, ف);
            لو (جزء_منطقي_نقطة(&الجزء)) {
            } وإلا لو (جزء_منطقي_نقطتان(&الجزء)) {
                لو ((الطول(الأجزاء) مثل غير_موقع) == 0) {
                    أرجع نتيجة_مسار_استيراد_نسبي.هروب_من_الجذر();
                };
                الأجزاء := احذف_آخر_جزء_منطقي(&الأجزاء);
            } وإلا {
                ألحق(الأجزاء, الجزء);
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }

    لو ((الطول(الأجزاء) مثل غير_موقع) == 0) {
        أرجع نتيجة_مسار_استيراد_نسبي.غير_صالح();
    };
    دع المسار: مسار_وحدة_منطقي = { الأجزاء: الأجزاء };
    أرجع نتيجة_مسار_استيراد_نسبي.صالح(المسار);
}
