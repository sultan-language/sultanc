استورد std.text.from_bytes;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.source_provider;
استورد std.bytes.compare;
استورد std.text.compare;
// Canonical Module Key is RootID + normalized logical module path only.
عام نوع مفتاح_وحدة_مقنن = {
    الجذر: معرف_جذر_مكتبة,
    المسار: مسار_وحدة_منطقي
};

عام عرف مفتاح_وحدة_مقنن_من(
    الجذر: معرف_جذر_مكتبة,
    المسار: مسار_وحدة_منطقي
): مفتاح_وحدة_مقنن {
    دع المفتاح: مفتاح_وحدة_مقنن = {
        الجذر: الجذر,
        المسار: المسار
    };
    أرجع المفتاح;
}

عام عرف انسخ_مفتاح_وحدة_مقنن(
    المفتاح: &مفتاح_وحدة_مقنن
): مفتاح_وحدة_مقنن {
    دع المسار: مسار_وحدة_منطقي = انسخ_مسار_وحدة_منطقي(&(*المفتاح).المسار);
    أرجع مفتاح_وحدة_مقنن_من((*المفتاح).الجذر, المسار);
}

عام عرف مفتاحا_وحدة_متساويان(
    الأول: &مفتاح_وحدة_مقنن,
    الثاني: &مفتاح_وحدة_مقنن
): منطقي {
    أرجع معرفا_جذر_مكتبة_متساويان((*الأول).الجذر, (*الثاني).الجذر)
        && مسارا_وحدة_منطقيان_متساويان(&(*الأول).المسار, &(*الثاني).المسار);
}

// A resolved logical environment is explicit input to Frontend. It contains
// dependency visibility, root/package spelling aliases, exact source overrides,
// and configured source roots. Physical package discovery is demand-driven in
// the source layer and is never encoded as a compiler-owned member inventory.
عام نوع ربط_اسم_جذر_مكتبة = {
    الجذر_المرئي: معرف_جذر_مكتبة,
    التهجئة: متجه ط8,
    الجذر_الهدف: معرف_جذر_مكتبة,
    يستهلك_التهجئة: منطقي
};

عام نوع حل_اسم_جذر_مكتبة = {
    الجذر: معرف_جذر_مكتبة,
    يستهلك_التهجئة: منطقي
};

// Physical source roots are configuration metadata attached to logical RootIDs.
// Root identity itself remains filesystem-independent.
عام نوع ربط_مسار_وحدة_عام = {
    الجذر_المرئي: معرف_جذر_مكتبة,
    المسار_العام: متجه ط8,
    المفتاح: مفتاح_وحدة_مقنن
};

عام نوع موقع_مصدر_وحدة = {
    المفتاح: مفتاح_وحدة_مقنن,
    مسار_ملف_المصدر: نص
};

// The canonical name of the package a root holds. Its root file is
// <source root>/<name>.sn, where the package declares the spellings of its
// top-level modules (module_spellings.sn). A root without one (a standalone
// file's directory) has no package root file.
عام نوع اسم_حزمة_جذر = {
    الجذر: معرف_جذر_مكتبة,
    الاسم: متجه ط8
};

عام نوع بيئة_وحدات_منطقية = {
    معرف_الجذر_التالي: طبيعي,
    // Designated exclusively by Driver after registering the actual STD source root.
    // Package names and import bindings cannot modify this authority.
    جذر_قياسي_موثوق: اختياري معرف_جذر_مكتبة,
    الجذور: متجه معرف_جذر_مكتبة,
    روابط_الجذور: متجه ربط_اسم_جذر_مكتبة,
    جذور_المصادر: متجه معرف_جذر_مكتبة,
    مسارات_جذور_المصادر: متجه نص,
    المسارات_العامة: متجه ربط_مسار_وحدة_عام,
    مواقع_المصادر: متجه موقع_مصدر_وحدة,
    أسماء_الحزم: متجه اسم_حزمة_جذر,
    مزود_المصادر: مزود_مصادر
};

عام نوع نتيجة_ربط_جذر =
    | أضيف
    | موجود
    | تعارض
    | جذر_مجهول
    | تهجئة_غير_صالحة
;

عام نوع نتيجة_ربط_مسار_عام =
    | أضيف
    | موجود
    | تعارض
    | جذر_مجهول
    | مسار_غير_صالح
    | جذر_غير_مطابق
;

عام نوع نتيجة_تسجيل_جذر_مصدر =
    | أضيف
    | موجود
    | تعارض
    | جذر_مجهول
;

عام نوع نتيجة_تسجيل_موقع_مصدر =
    | أضيف
    | موجود
    | تعارض
    | جذر_مجهول
;

عام عرف بيئة_وحدات_منطقية_جديدة(): بيئة_وحدات_منطقية {
    دع الجذور: متجه معرف_جذر_مكتبة = [];
    دع روابط_الجذور: متجه ربط_اسم_جذر_مكتبة = [];
    دع جذور_المصادر: متجه معرف_جذر_مكتبة = [];
    دع مسارات_جذور_المصادر: متجه نص = [];
    دع المسارات_العامة: متجه ربط_مسار_وحدة_عام = [];
    دع مواقع_المصادر: متجه موقع_مصدر_وحدة = [];
    دع أسماء_الحزم: متجه اسم_حزمة_جذر = [];
    دع مزود_المصادر: مزود_مصادر = مزود_مصادر_جديد();
    دع البيئة: بيئة_وحدات_منطقية = {
        معرف_الجذر_التالي: 0,
        جذر_قياسي_موثوق: اختياري.لا_شيء(),
        الجذور: الجذور,
        روابط_الجذور: روابط_الجذور,
        جذور_المصادر: جذور_المصادر,
        مسارات_جذور_المصادر: مسارات_جذور_المصادر,
        المسارات_العامة: المسارات_العامة,
        مواقع_المصادر: مواقع_المصادر,
        أسماء_الحزم: أسماء_الحزم,
        مزود_المصادر: مزود_المصادر
    };
    أرجع البيئة;
}

// Only the package-environment owner calls this after recording the actual
// standard-library [lib] root. It never derives trust from a package spelling.
// A second distinct root is a configuration error, not an authority override.
عام عرف عيّن_جذر_قياسي_موثوق(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة
): منطقي {
    إذا (!جذر_مكتبة_مسجل(البيئة, الجذر)) { أرجع خطأ; };
    طابق جذر_مصدر_لمعرف(البيئة, الجذر) مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    طابق (*البيئة).جذر_قياسي_موثوق مع
    | اختياري.موجود(السابق) -> {
        أرجع معرفا_جذر_مكتبة_متساويان(السابق, الجذر);
    }
    | اختياري.لا_شيء -> {
        (*البيئة).جذر_قياسي_موثوق := اختياري.موجود(الجذر);
        أرجع صواب;
    };
}

// Authentication consumers compare canonical ModuleKey roots with this value;
// neither import aliases nor manifest names can manufacture it.
عام عرف جذر_قياسي_موثوق_لبيئة(
    البيئة: &بيئة_وحدات_منطقية
): اختياري معرف_جذر_مكتبة {
    أرجع (*البيئة).جذر_قياسي_موثوق;
}

عام عرف خصص_جذر_مكتبة(
    البيئة: &متغير بيئة_وحدات_منطقية
): معرف_جذر_مكتبة {
    دع المعرف: معرف_جذر_مكتبة = معرف_جذر_مكتبة_من((*البيئة).معرف_الجذر_التالي);
    (*البيئة).معرف_الجذر_التالي := (*البيئة).معرف_الجذر_التالي + 1;
    ألحق((*البيئة).الجذور, المعرف);
    أرجع المعرف;
}

عام عرف جذر_مكتبة_مسجل(
    البيئة: &بيئة_وحدات_منطقية,
    المعرف: معرف_جذر_مكتبة
): منطقي {
    // Root IDs are allocated densely by this owner. Do not rescan the root vector.
    أرجع المعرف.القيمة < (الطول((*البيئة).الجذور) مثل طبيعي);
}

عرف تهجئة_جذر_صالحة(التهجئة: &متجه ط8): منطقي {
    دع الأصل: متجه ط8 = انسخ_بايتات(التهجئة);
    دع العدد: طبيعي = الطول(الأصل) مثل طبيعي;
    إذا (العدد == 0) {
        أرجع خطأ;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا ((الأصل[ف] == 0) || (الأصل[ف] == 0x2F)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    دع الجزء: جزء_مسار_وحدة_منطقي = { البايتات: الأصل };
    أرجع !جزء_منطقي_نقطة(&الجزء) && !جزء_منطقي_نقطتان(&الجزء);
}

عام عرف أضف_جذر_مصدر(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة,
    مسار_الدليل: &نص
): نتيجة_تسجيل_جذر_مصدر {
    إذا (!جذر_مكتبة_مسجل(البيئة, الجذر)) {
        أرجع نتيجة_تسجيل_جذر_مصدر.جذر_مجهول();
    };
    // One directory is one root: a second root over the same directory
    // would give each of its files two module names.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).جذور_المصادر) مثل طبيعي)) {
        دع مرجع_المسار: &نص = &(*البيئة).مسارات_جذور_المصادر[ف];
        دع نفس_المسار: منطقي = نصان_متساويان(مرجع_المسار, مسار_الدليل);
        إذا (معرفا_جذر_مكتبة_متساويان((*البيئة).جذور_المصادر[ف], الجذر)) {
            إذا (نفس_المسار) {
                أرجع نتيجة_تسجيل_جذر_مصدر.موجود();
            };
            أرجع نتيجة_تسجيل_جذر_مصدر.تعارض();
        };
        إذا (نفس_المسار) { أرجع نتيجة_تسجيل_جذر_مصدر.تعارض(); };
        ف := ف + 1;
    }
    ألحق((*البيئة).جذور_المصادر, الجذر);
    دع قيمة_المسار: نص = انسخ_نص(مسار_الدليل);
    ألحق((*البيئة).مسارات_جذور_المصادر, قيمة_المسار);
    أرجع نتيجة_تسجيل_جذر_مصدر.أضيف();
}

عام عرف جذر_مصدر_لمعرف(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة
): اختياري نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).جذور_المصادر) مثل طبيعي)) {
        إذا (معرفا_جذر_مكتبة_متساويان((*البيئة).جذور_المصادر[ف], الجذر)) {
            دع مرجع_المسار: &نص = &(*البيئة).مسارات_جذور_المصادر[ف];
            دع المسار: نص = انسخ_نص(مرجع_المسار);
            أرجع اختياري.موجود(المسار);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف أضف_ربط_اسم_جذر_بسياسة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    التهجئة: متجه ط8,
    الجذر_الهدف: معرف_جذر_مكتبة,
    يستهلك_التهجئة: منطقي
): نتيجة_ربط_جذر {
    إذا (
        !جذر_مكتبة_مسجل(البيئة, الجذر_المرئي)
        || !جذر_مكتبة_مسجل(البيئة, الجذر_الهدف)
    ) {
        أرجع نتيجة_ربط_جذر.جذر_مجهول();
    };
    إذا (!تهجئة_جذر_صالحة(&التهجئة)) {
        أرجع نتيجة_ربط_جذر.تهجئة_غير_صالحة();
    };

    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).روابط_الجذور) مثل طبيعي)) {
        دع مرجع_الربط: &ربط_اسم_جذر_مكتبة = &(*البيئة).روابط_الجذور[ف];
        إذا (
            معرفا_جذر_مكتبة_متساويان((*مرجع_الربط).الجذر_المرئي, الجذر_المرئي)
            && متجها_بايتات_متساويان(&(*مرجع_الربط).التهجئة, &التهجئة)
        ) {
            إذا (
                معرفا_جذر_مكتبة_متساويان((*مرجع_الربط).الجذر_الهدف, الجذر_الهدف)
                && ((*مرجع_الربط).يستهلك_التهجئة == يستهلك_التهجئة)
            ) {
                أرجع نتيجة_ربط_جذر.موجود();
            };
            أرجع نتيجة_ربط_جذر.تعارض();
        };
        ف := ف + 1;
    }

    دع الربط: ربط_اسم_جذر_مكتبة = {
        الجذر_المرئي: الجذر_المرئي,
        التهجئة: التهجئة,
        الجذر_الهدف: الجذر_الهدف,
        يستهلك_التهجئة: يستهلك_التهجئة
    };
    ألحق((*البيئة).روابط_الجذور, الربط);
    أرجع نتيجة_ربط_جذر.أضيف();
}


عام عرف أضف_ربط_اسم_جذر(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    التهجئة: متجه ط8,
    الجذر_الهدف: معرف_جذر_مكتبة
): نتيجة_ربط_جذر {
    أرجع أضف_ربط_اسم_جذر_بسياسة(
        البيئة, الجذر_المرئي, التهجئة, الجذر_الهدف, خطأ
    );
}

عام عرف أضف_ربط_اسم_جذر_مستهلك(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    التهجئة: متجه ط8,
    الجذر_الهدف: معرف_جذر_مكتبة
): نتيجة_ربط_جذر {
    أرجع أضف_ربط_اسم_جذر_بسياسة(
        البيئة, الجذر_المرئي, التهجئة, الجذر_الهدف, صواب
    );
}

عام عرف حل_اسم_جذر_مفصل(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    التهجئة: &متجه ط8
): اختياري حل_اسم_جذر_مكتبة {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).روابط_الجذور) مثل طبيعي)) {
        دع مرجع_الربط: &ربط_اسم_جذر_مكتبة = &(*البيئة).روابط_الجذور[ف];
        إذا (
            معرفا_جذر_مكتبة_متساويان((*مرجع_الربط).الجذر_المرئي, الجذر_المرئي)
            && متجها_بايتات_متساويان(&(*مرجع_الربط).التهجئة, التهجئة)
        ) {
            دع النتيجة: حل_اسم_جذر_مكتبة = {
                الجذر: (*مرجع_الربط).الجذر_الهدف,
                يستهلك_التهجئة: (*مرجع_الربط).يستهلك_التهجئة
            };
            أرجع اختياري.موجود(النتيجة);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف حل_اسم_جذر(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    التهجئة: &متجه ط8
): اختياري معرف_جذر_مكتبة {
    طابق حل_اسم_جذر_مفصل(البيئة, الجذر_المرئي, التهجئة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الحل) -> { أرجع اختياري.موجود(الحل.الجذر); };
}

عام عرف أضف_مسارا_عاما_لوحدة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    المسار_العام: متجه ط8,
    المفتاح: &مفتاح_وحدة_مقنن
): نتيجة_ربط_مسار_عام {
    // Driver source setup already canonicalized this path and its root exactly once.
    // This owner records the fact; it does not replay path/root/duplicate validation.
    دع قيمة_المفتاح: مفتاح_وحدة_مقنن = انسخ_مملوكا_مفتاح_وحدة_مقنن(المفتاح);
    دع الربط: ربط_مسار_وحدة_عام = {
        الجذر_المرئي: الجذر_المرئي,
        المسار_العام: المسار_العام,
        المفتاح: قيمة_المفتاح
    };
    ألحق((*البيئة).المسارات_العامة, الربط);
    أرجع نتيجة_ربط_مسار_عام.أضيف();
}

عام عرف حل_مسار_عام_مسجل(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    المسار_العام: &متجه ط8
): اختياري مفتاح_وحدة_مقنن {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).المسارات_العامة) مثل طبيعي)) {
        دع مرجع_الربط: &ربط_مسار_وحدة_عام = &(*البيئة).المسارات_العامة[ف];
        إذا (
            معرفا_جذر_مكتبة_متساويان((*مرجع_الربط).الجذر_المرئي, الجذر_المرئي)
            && متجها_بايتات_متساويان(&(*مرجع_الربط).المسار_العام, المسار_العام)
        ) {
            دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &(*مرجع_الربط).المفتاح;
            دع المفتاح: مفتاح_وحدة_مقنن = انسخ_مملوكا_مفتاح_وحدة_مقنن(مرجع_المفتاح);
            أرجع اختياري.موجود(المفتاح);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف أضف_موقع_مصدر_وحدة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    مسار_ملف_المصدر: نص
): نتيجة_تسجيل_موقع_مصدر {
    // Direct source setup owns uniqueness/canonicalization. Record once, no duplicate scan.
    دع قيمة_المفتاح: مفتاح_وحدة_مقنن = انسخ_مملوكا_مفتاح_وحدة_مقنن(المفتاح);
    دع الموقع: موقع_مصدر_وحدة = {
        المفتاح: قيمة_المفتاح,
        مسار_ملف_المصدر: مسار_ملف_المصدر
    };
    ألحق((*البيئة).مواقع_المصادر, الموقع);
    أرجع نتيجة_تسجيل_موقع_مصدر.أضيف();
}

عام عرف موقع_مصدر_لمفتاح(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): اختياري نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).مواقع_المصادر) مثل طبيعي)) {
        دع مرجع_الموقع: &موقع_مصدر_وحدة = &(*البيئة).مواقع_المصادر[ف];
        إذا (مفتاحا_وحدة_متساويان(&(*مرجع_الموقع).المفتاح, المفتاح)) {
            دع مرجع_المسار: &نص = &(*مرجع_الموقع).مسار_ملف_المصدر;
            دع المسار: نص = انسخ_نص(مرجع_المسار);
            أرجع اختياري.موجود(المسار);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Records the package name of a root once; a second, different name is
// refused.
عام عرف عيّن_اسم_حزمة_جذر(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة,
    الاسم: متجه ط8
): منطقي {
    إذا (!جذر_مكتبة_مسجل(البيئة, الجذر)) { أرجع خطأ; };
    إذا ((الطول(الاسم) مثل طبيعي) == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).أسماء_الحزم) مثل طبيعي)) {
        دع مرجع_السجل: &اسم_حزمة_جذر = &(*البيئة).أسماء_الحزم[ف];
        إذا (معرفا_جذر_مكتبة_متساويان((*مرجع_السجل).الجذر, الجذر)) {
            أرجع متجها_بايتات_متساويان(&(*مرجع_السجل).الاسم, &الاسم);
        };
        ف := ف + 1;
    }
    دع السجل: اسم_حزمة_جذر = { الجذر: الجذر, الاسم: الاسم };
    ألحق((*البيئة).أسماء_الحزم, السجل);
    أرجع صواب;
}

عام عرف اسم_حزمة_لجذر(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة
): اختياري متجه ط8 {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).أسماء_الحزم) مثل طبيعي)) {
        دع مرجع_السجل: &اسم_حزمة_جذر = &(*البيئة).أسماء_الحزم[ف];
        إذا (معرفا_جذر_مكتبة_متساويان((*مرجع_السجل).الجذر, الجذر)) {
            أرجع اختياري.موجود(انسخ_بايتات(&(*مرجع_السجل).الاسم));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Source overlays are content overrides only; canonical module/source location
// identity remains owned by this environment and the source layer.
عام عرف ضع_تراكب_مصدر_في_البيئة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    المسار: نص,
    المحتوى: نص
): فراغ {
    طابق موضع_تراكب_مصدر(&(*البيئة).مزود_المصادر, &المسار) مع
    | اختياري.موجود(الفهرس) -> {
        دع التراكب: تراكب_مصدر = {
            المسار: المسار,
            المحتوى: المحتوى,
            نشط: صواب
        };
        (*البيئة).مزود_المصادر.التراكبات[الفهرس] := التراكب;
    }
    | اختياري.لا_شيء -> {
        دع التراكب: تراكب_مصدر = {
            المسار: المسار,
            المحتوى: المحتوى,
            نشط: صواب
        };
        ألحق((*البيئة).مزود_المصادر.التراكبات, التراكب);
    };
}

عام عرف أزل_تراكب_مصدر_من_البيئة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    المسار: &نص
): منطقي {
    طابق موضع_تراكب_مصدر(&(*البيئة).مزود_المصادر, المسار) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الفهرس) -> {
        (*البيئة).مزود_المصادر.التراكبات[الفهرس].نشط := خطأ;
        أرجع صواب;
    };
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_مفتاح_وحدة_مقنن(القيمة: &مفتاح_وحدة_مقنن): مفتاح_وحدة_مقنن {
    دع الناتج: مفتاح_وحدة_مقنن = {
        الجذر: (*القيمة).الجذر,
        المسار: انسخ_مملوكا_مسار_وحدة_منطقي(&(*القيمة).المسار)
    };
    أرجع الناتج;
}
