استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.source_provider;
استورد std.bytes.compare;
استورد std.text.compare;
// Canonical Module Key is RootID + normalized logical module path only.
عام نوع مفتاح_وحدة_مقنن = {
    الجذر: معرف_جذر_مكتبة,
    المسار: مسار_وحدة_منطقي
};

عام عرف مفتاح_وحدة_مقنن_من(
    الجذر: معرف_جذر_مكتبة,
    المسار: مسار_وحدة_منطقي
): مفتاح_وحدة_مقنن {
    دع المفتاح: مفتاح_وحدة_مقنن = {
        الجذر: الجذر,
        المسار: المسار
    };
    أرجع المفتاح;
}

عام عرف انسخ_مفتاح_وحدة_مقنن(
    المفتاح: &مفتاح_وحدة_مقنن
): مفتاح_وحدة_مقنن {
    دع الأصل: مفتاح_وحدة_مقنن = *المفتاح;
    دع المسار: مسار_وحدة_منطقي = انسخ_مسار_وحدة_منطقي(&الأصل.المسار);
    أرجع مفتاح_وحدة_مقنن_من(الأصل.الجذر, المسار);
}

عام عرف مفتاحا_وحدة_متساويان(
    الأول: &مفتاح_وحدة_مقنن,
    الثاني: &مفتاح_وحدة_مقنن
): منطقي {
    دع أ: مفتاح_وحدة_مقنن = *الأول;
    دع ب: مفتاح_وحدة_مقنن = *الثاني;
    أرجع معرفا_جذر_مكتبة_متساويان(أ.الجذر, ب.الجذر)
        && مسارا_وحدة_منطقيان_متساويان(&أ.المسار, &ب.المسار);
}

// A resolved logical environment is explicit input to Frontend. It contains
// dependency visibility, public aliases, exact source overrides, and configured
// source roots. It does not scan package directories or discover libraries.
عام نوع ربط_اسم_جذر_مكتبة = {
    الجذر_المرئي: معرف_جذر_مكتبة,
    التهجئة: متجه غ8,
    الجذر_الهدف: معرف_جذر_مكتبة
};

// Physical source roots are configuration metadata attached to logical RootIDs.
// Root identity itself remains filesystem-independent.
عام نوع ربط_مسار_وحدة_عام = {
    الجذر_المرئي: معرف_جذر_مكتبة,
    المسار_العام: متجه غ8,
    المفتاح: مفتاح_وحدة_مقنن
};

عام نوع موقع_مصدر_وحدة = {
    المفتاح: مفتاح_وحدة_مقنن,
    مسار_ملف_المصدر: نص
};

// Package metadata owns only constituent semantic modules. Public declaration
// spellings remain owned by Name after each constituent module is loaded.
عام نوع ربط_عضو_حزمة = {
    الجذر_الهدف: معرف_جذر_مكتبة,
    مسار_الحزمة: متجه غ8,
    المفتاح: مفتاح_وحدة_مقنن
};

عام نوع بيئة_وحدات_منطقية = {
    معرف_الجذر_التالي: غير_موقع,
    الجذور: متجه معرف_جذر_مكتبة,
    روابط_الجذور: متجه ربط_اسم_جذر_مكتبة,
    جذور_المصادر: متجه معرف_جذر_مكتبة,
    مسارات_جذور_المصادر: متجه نص,
    المسارات_العامة: متجه ربط_مسار_وحدة_عام,
    مواقع_المصادر: متجه موقع_مصدر_وحدة,
    مفاتيح_الجسر_البدائي_الداخلي: متجه مفتاح_وحدة_مقنن,
    أعضاء_الحزم: متجه ربط_عضو_حزمة,
    مزود_المصادر: مزود_مصادر
};

عام نوع نتيجة_ربط_جذر =
    | أضيف
    | موجود
    | تعارض
    | جذر_مجهول
    | تهجئة_غير_صالحة
;

عام نوع نتيجة_ربط_مسار_عام =
    | أضيف
    | موجود
    | تعارض
    | جذر_مجهول
    | مسار_غير_صالح
    | جذر_غير_مطابق
;

عام نوع نتيجة_تسجيل_جذر_مصدر =
    | أضيف
    | موجود
    | تعارض
    | جذر_مجهول
;

عام نوع نتيجة_تسجيل_موقع_مصدر =
    | أضيف
    | موجود
    | تعارض
    | جذر_مجهول
;

عام عرف بيئة_وحدات_منطقية_جديدة(): بيئة_وحدات_منطقية {
    دع الجذور: متجه معرف_جذر_مكتبة = [];
    دع روابط_الجذور: متجه ربط_اسم_جذر_مكتبة = [];
    دع جذور_المصادر: متجه معرف_جذر_مكتبة = [];
    دع مسارات_جذور_المصادر: متجه نص = [];
    دع المسارات_العامة: متجه ربط_مسار_وحدة_عام = [];
    دع مواقع_المصادر: متجه موقع_مصدر_وحدة = [];
    دع مفاتيح_الجسر_البدائي_الداخلي: متجه مفتاح_وحدة_مقنن = [];
    دع أعضاء_الحزم: متجه ربط_عضو_حزمة = [];
    دع مزود_المصادر: مزود_مصادر = مزود_مصادر_جديد();
    دع البيئة: بيئة_وحدات_منطقية = {
        معرف_الجذر_التالي: 0,
        الجذور: الجذور,
        روابط_الجذور: روابط_الجذور,
        جذور_المصادر: جذور_المصادر,
        مسارات_جذور_المصادر: مسارات_جذور_المصادر,
        المسارات_العامة: المسارات_العامة,
        مواقع_المصادر: مواقع_المصادر,
        مفاتيح_الجسر_البدائي_الداخلي: مفاتيح_الجسر_البدائي_الداخلي,
        أعضاء_الحزم: أعضاء_الحزم,
        مزود_المصادر: مزود_المصادر
    };
    أرجع البيئة;
}

عام عرف خصص_جذر_مكتبة(
    البيئة: &متغير بيئة_وحدات_منطقية
): معرف_جذر_مكتبة {
    دع الحالة: متغير بيئة_وحدات_منطقية = *البيئة;
    دع المعرف: معرف_جذر_مكتبة = معرف_جذر_مكتبة_من(الحالة.معرف_الجذر_التالي);
    الحالة.معرف_الجذر_التالي := الحالة.معرف_الجذر_التالي + 1;
    ألحق(الحالة.الجذور, المعرف);
    *البيئة := الحالة;
    أرجع المعرف;
}

عام عرف جذر_مكتبة_مسجل(
    البيئة: &بيئة_وحدات_منطقية,
    المعرف: معرف_جذر_مكتبة
): منطقي {
    دع الحالة: بيئة_وحدات_منطقية = *البيئة;
    // Root IDs are allocated densely by this owner. Do not rescan the root vector.
    أرجع المعرف.القيمة < (الطول(الحالة.الجذور) مثل غير_موقع);
}

عرف تهجئة_جذر_صالحة(التهجئة: &متجه غ8): منطقي {
    دع الأصل: متجه غ8 = *التهجئة;
    دع العدد: غير_موقع = الطول(الأصل) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو ((الأصل[ف] == 0) || (الأصل[ف] == 0x2F)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    دع الجزء: جزء_مسار_وحدة_منطقي = { البايتات: الأصل };
    أرجع !جزء_منطقي_نقطة(&الجزء) && !جزء_منطقي_نقطتان(&الجزء);
}

عام عرف أضف_جذر_مصدر(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة,
    مسار_الدليل: &نص
): نتيجة_تسجيل_جذر_مصدر {
    لو (!جذر_مكتبة_مسجل(البيئة, الجذر)) {
        أرجع نتيجة_تسجيل_جذر_مصدر.جذر_مجهول();
    };
    دع الحالة: متغير بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.جذور_المصادر) مثل غير_موقع)) {
        لو (معرفا_جذر_مكتبة_متساويان(الحالة.جذور_المصادر[ف], الجذر)) {
            دع مرجع_المسار: &نص = &الحالة.مسارات_جذور_المصادر[ف];
            دع المسار_المسجل: نص = *مرجع_المسار;
            لو (نصان_متساويان(&المسار_المسجل, مسار_الدليل)) {
                أرجع نتيجة_تسجيل_جذر_مصدر.موجود();
            };
            أرجع نتيجة_تسجيل_جذر_مصدر.تعارض();
        };
        ف := ف + 1;
    }
    ألحق(الحالة.جذور_المصادر, الجذر);
    دع قيمة_المسار: نص = *مسار_الدليل;
    ألحق(الحالة.مسارات_جذور_المصادر, قيمة_المسار);
    *البيئة := الحالة;
    أرجع نتيجة_تسجيل_جذر_مصدر.أضيف();
}

عام عرف جذر_مصدر_لمعرف(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة
): اختيار نص {
    دع الحالة: بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.جذور_المصادر) مثل غير_موقع)) {
        لو (معرفا_جذر_مكتبة_متساويان(الحالة.جذور_المصادر[ف], الجذر)) {
            دع مرجع_المسار: &نص = &الحالة.مسارات_جذور_المصادر[ف];
            دع المسار: نص = *مرجع_المسار;
            أرجع اختيار.بعض(المسار);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف أضف_ربط_اسم_جذر(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    التهجئة: متجه غ8,
    الجذر_الهدف: معرف_جذر_مكتبة
): نتيجة_ربط_جذر {
    لو (
        !جذر_مكتبة_مسجل(البيئة, الجذر_المرئي)
        || !جذر_مكتبة_مسجل(البيئة, الجذر_الهدف)
    ) {
        أرجع نتيجة_ربط_جذر.جذر_مجهول();
    };
    لو (!تهجئة_جذر_صالحة(&التهجئة)) {
        أرجع نتيجة_ربط_جذر.تهجئة_غير_صالحة();
    };

    دع الحالة: متغير بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.روابط_الجذور) مثل غير_موقع)) {
        دع مرجع_الربط: &ربط_اسم_جذر_مكتبة = &الحالة.روابط_الجذور[ف];
        دع الربط: ربط_اسم_جذر_مكتبة = *مرجع_الربط;
        لو (
            معرفا_جذر_مكتبة_متساويان(الربط.الجذر_المرئي, الجذر_المرئي)
            && متجها_بايتات_متساويان(&الربط.التهجئة, &التهجئة)
        ) {
            لو (معرفا_جذر_مكتبة_متساويان(الربط.الجذر_الهدف, الجذر_الهدف)) {
                أرجع نتيجة_ربط_جذر.موجود();
            };
            أرجع نتيجة_ربط_جذر.تعارض();
        };
        ف := ف + 1;
    }

    دع الربط: ربط_اسم_جذر_مكتبة = {
        الجذر_المرئي: الجذر_المرئي,
        التهجئة: التهجئة,
        الجذر_الهدف: الجذر_الهدف
    };
    ألحق(الحالة.روابط_الجذور, الربط);
    *البيئة := الحالة;
    أرجع نتيجة_ربط_جذر.أضيف();
}

عام عرف حل_اسم_جذر(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    التهجئة: &متجه غ8
): اختيار معرف_جذر_مكتبة {
    دع الحالة: بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.روابط_الجذور) مثل غير_موقع)) {
        دع مرجع_الربط: &ربط_اسم_جذر_مكتبة = &الحالة.روابط_الجذور[ف];
        دع الربط: ربط_اسم_جذر_مكتبة = *مرجع_الربط;
        لو (
            معرفا_جذر_مكتبة_متساويان(الربط.الجذر_المرئي, الجذر_المرئي)
            && متجها_بايتات_متساويان(&الربط.التهجئة, التهجئة)
        ) {
            أرجع اختيار.بعض(الربط.الجذر_الهدف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف أضف_مسارا_عاما_لوحدة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    المسار_العام: متجه غ8,
    المفتاح: &مفتاح_وحدة_مقنن
): نتيجة_ربط_مسار_عام {
    // Driver source setup already canonicalized this path and its root exactly once.
    // This owner records the fact; it does not replay path/root/duplicate validation.
    دع الحالة: متغير بيئة_وحدات_منطقية = *البيئة;
    دع قيمة_المفتاح: مفتاح_وحدة_مقنن = *المفتاح;
    دع الربط: ربط_مسار_وحدة_عام = {
        الجذر_المرئي: الجذر_المرئي,
        المسار_العام: المسار_العام,
        المفتاح: قيمة_المفتاح
    };
    ألحق(الحالة.المسارات_العامة, الربط);
    *البيئة := الحالة;
    أرجع نتيجة_ربط_مسار_عام.أضيف();
}

عام عرف حل_مسار_عام_مسجل(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    المسار_العام: &متجه غ8
): اختيار مفتاح_وحدة_مقنن {
    دع الحالة: بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.المسارات_العامة) مثل غير_موقع)) {
        دع مرجع_الربط: &ربط_مسار_وحدة_عام = &الحالة.المسارات_العامة[ف];
        دع الربط: ربط_مسار_وحدة_عام = *مرجع_الربط;
        لو (
            معرفا_جذر_مكتبة_متساويان(الربط.الجذر_المرئي, الجذر_المرئي)
            && متجها_بايتات_متساويان(&الربط.المسار_العام, المسار_العام)
        ) {
            دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &الربط.المفتاح;
            دع المفتاح: مفتاح_وحدة_مقنن = *مرجع_المفتاح;
            أرجع اختيار.بعض(المفتاح);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف أضف_موقع_مصدر_وحدة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    مسار_ملف_المصدر: نص
): نتيجة_تسجيل_موقع_مصدر {
    // Direct source setup owns uniqueness/canonicalization. Record once, no duplicate scan.
    دع الحالة: متغير بيئة_وحدات_منطقية = *البيئة;
    دع قيمة_المفتاح: مفتاح_وحدة_مقنن = *المفتاح;
    دع الموقع: موقع_مصدر_وحدة = {
        المفتاح: قيمة_المفتاح,
        مسار_ملف_المصدر: مسار_ملف_المصدر
    };
    ألحق(الحالة.مواقع_المصادر, الموقع);
    *البيئة := الحالة;
    أرجع نتيجة_تسجيل_موقع_مصدر.أضيف();
}

عام عرف موقع_مصدر_لمفتاح(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): اختيار نص {
    دع الحالة: بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.مواقع_المصادر) مثل غير_موقع)) {
        دع مرجع_الموقع: &موقع_مصدر_وحدة = &الحالة.مواقع_المصادر[ف];
        دع الموقع: موقع_مصدر_وحدة = *مرجع_الموقع;
        لو (مفتاحا_وحدة_متساويان(&الموقع.المفتاح, المفتاح)) {
            دع مرجع_المسار: &نص = &الموقع.مسار_ملف_المصدر;
            دع المسار: نص = *مرجع_المسار;
            أرجع اختيار.بعض(المسار);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف أضف_سماح_جسر_بدائي_داخلي(
    البيئة: &متغير بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): منطقي {
    دع الحالة: متغير بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.مفاتيح_الجسر_البدائي_الداخلي) مثل غير_موقع)) {
        لو (مفتاحا_وحدة_متساويان(&الحالة.مفاتيح_الجسر_البدائي_الداخلي[ف], المفتاح)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    ألحق(الحالة.مفاتيح_الجسر_البدائي_الداخلي, انسخ_مفتاح_وحدة_مقنن(المفتاح));
    *البيئة := الحالة;
    أرجع صواب;
}

عام عرف مفتاح_وحدة_يسمح_بجسر_بدائي_داخلي(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): منطقي {
    دع الحالة: بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.مفاتيح_الجسر_البدائي_الداخلي) مثل غير_موقع)) {
        لو (مفتاحا_وحدة_متساويان(&الحالة.مفاتيح_الجسر_البدائي_الداخلي[ف], المفتاح)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف أضف_عضو_حزمة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_الهدف: معرف_جذر_مكتبة,
    مسار_الحزمة: متجه غ8,
    المفتاح: &مفتاح_وحدة_مقنن
): منطقي {
    لو (!جذر_مكتبة_مسجل(البيئة, الجذر_الهدف)) { أرجع خطأ; };
    دع الحالة: متغير بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.أعضاء_الحزم) مثل غير_موقع)) {
        دع مرجع_القديم: &ربط_عضو_حزمة = &الحالة.أعضاء_الحزم[ف];
        دع القديم: ربط_عضو_حزمة = *مرجع_القديم;
        لو (
            معرفا_جذر_مكتبة_متساويان(القديم.الجذر_الهدف, الجذر_الهدف)
            && متجها_بايتات_متساويان(&القديم.مسار_الحزمة, &مسار_الحزمة)
            && مفتاحا_وحدة_متساويان(&القديم.المفتاح, المفتاح)
        ) { أرجع صواب; };
        ف := ف + 1;
    }
    دع قيمة_المفتاح: مفتاح_وحدة_مقنن = *المفتاح;
    دع الربط: ربط_عضو_حزمة = {
        الجذر_الهدف: الجذر_الهدف,
        مسار_الحزمة: مسار_الحزمة,
        المفتاح: قيمة_المفتاح
    };
    ألحق(الحالة.أعضاء_الحزم, الربط);
    *البيئة := الحالة;
    أرجع صواب;
}

عام عرف أعضاء_حزمة_منطقية(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    مرجع_الحزمة: &متجه غ8
): متجه مفتاح_وحدة_مقنن {
    دع الناتج: متغير متجه مفتاح_وحدة_مقنن = [];
    دع جزء_الجذر: جزء_مسار_وحدة_منطقي;
    طابق أول_جزء_مرجع_استيراد(مرجع_الحزمة) مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(القيمة) -> { جزء_الجذر := القيمة; };
    دع الجذر_الهدف: معرف_جذر_مكتبة;
    طابق حل_اسم_جذر(البيئة, الجذر_المرئي, &جزء_الجذر.البايتات) مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(القيمة) -> { الجذر_الهدف := القيمة; };
    دع باقي_المسار: متجه غ8;
    طابق باقي_مرجع_بعد_الجذر(مرجع_الحزمة) مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(القيمة) -> { باقي_المسار := القيمة; };

    دع الحالة: بيئة_وحدات_منطقية = *البيئة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.أعضاء_الحزم) مثل غير_موقع)) {
        دع مرجع_الربط: &ربط_عضو_حزمة = &الحالة.أعضاء_الحزم[ف];
        دع الربط: ربط_عضو_حزمة = *مرجع_الربط;
        لو (
            معرفا_جذر_مكتبة_متساويان(الربط.الجذر_الهدف, الجذر_الهدف)
            && متجها_بايتات_متساويان(&الربط.مسار_الحزمة, &باقي_المسار)
        ) {
            ألحق(الناتج, انسخ_مفتاح_وحدة_مقنن(&الربط.المفتاح));
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف حزمة_منطقية_مسجلة(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    مرجع_الحزمة: &متجه غ8
): منطقي {
    دع الأعضاء: متجه مفتاح_وحدة_مقنن = أعضاء_حزمة_منطقية(
        البيئة, الجذر_المرئي, مرجع_الحزمة
    );
    أرجع (الطول(الأعضاء) مثل غير_موقع) != 0;
}

// Source overlays are content overrides only; canonical module/source location
// identity remains owned by this environment and the source layer.
عام عرف ضع_تراكب_مصدر_في_البيئة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    المسار: نص,
    المحتوى: نص
): فراغ {
    دع الحالة: متغير بيئة_وحدات_منطقية = *البيئة;
    ضع_تراكب_مصدر(&متغير الحالة.مزود_المصادر, المسار, المحتوى);
    *البيئة := الحالة;
}

عام عرف أزل_تراكب_مصدر_من_البيئة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    المسار: &نص
): منطقي {
    دع الحالة: متغير بيئة_وحدات_منطقية = *البيئة;
    دع أزيل: منطقي = أزل_تراكب_مصدر(&متغير الحالة.مزود_المصادر, المسار);
    *البيئة := الحالة;
    أرجع أزيل;
}
