// Library-root identity is logical. Filesystem paths, public spellings, languages,
// and package versions are deliberately absent from this representation.
عام نوع معرف_جذر_مكتبة = {
    القيمة: غير_موقع
};

عام عرف معرف_جذر_مكتبة_من(القيمة: غير_موقع): معرف_جذر_مكتبة {
    دع المعرف: معرف_جذر_مكتبة = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرفا_جذر_مكتبة_متساويان(
    الأول: معرف_جذر_مكتبة,
    الثاني: معرف_جذر_مكتبة
): منطقي {
    أرجع !(الأول.القيمة < الثاني.القيمة)
        && !(الثاني.القيمة < الأول.القيمة);
}
