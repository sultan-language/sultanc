استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.source_provider;
استورد std.fs.read_file;
استورد std.fs.path;
استورد std.text.from_bytes;
// Source location is downstream metadata. A Canonical Module Key resolves either
// through an exact configured source or deterministically under its configured
// source root. Frontend never searches directories to guess a module.
عام نوع مصدر_محدد = {
    المفتاح: مفتاح_وحدة_مقنن,
    مسار_ملف_المصدر: نص,
    المحتوى: نص
};

عام نوع خطأ_تحديد_مصدر =
    | غير_موجود
    | غير_مقروء
;

عام نوع نتيجة_تحديد_مصدر =
    | موجود بنوع مصدر_محدد
    | خطأ بنوع خطأ_تحديد_مصدر
;


عرف اقرأ_محتوى_مصدر(
    البيئة: &بيئة_وحدات_منطقية,
    المسار: &نص
): نتيجة نص, عدد {
    دع الحالة: بيئة_وحدات_منطقية = *البيئة;
    دع التراكب: نتيجة_محتوى_تراكب_مصدر = محتوى_تراكب_مصدر(&الحالة.مزود_المصادر, المسار);
    لو (التراكب.موجود) {
        دع مرجع_المحتوى: &نص = &التراكب.المحتوى;
        أرجع نتيجة.نجح(*مرجع_المحتوى);
    };
    أرجع اقرأ_الملف(المسار);
}


عرف مسار_مصدر_مشتق_من_الجذر(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): اختيار نص {
    دع القيمة: مفتاح_وحدة_مقنن = *المفتاح;
    طابق جذر_مصدر_لمعرف(البيئة, القيمة.الجذر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(جذر_المصدر) -> {
        دع البايتات: متجه غ8 = بايتات_مسار_وحدة_منطقي(&القيمة.المسار);
        لو ((الطول(البايتات) مثل غير_موقع) == 0) {
            أرجع اختيار.لا_شيء();
        };
        دع المسار_المنطقي: نص = من_بايتات(&البايتات);
        دع المسار: نص = صل_المسار(&جذر_المصدر, &المسار_المنطقي);
        أرجع اختيار.بعض(المسار);
    };
}

عام عرف حدد_مصدر_وحدة(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): نتيجة_تحديد_مصدر {
    دع المسار_المحدد: متغير اختيار نص = موقع_مصدر_لمفتاح(البيئة, المفتاح);
    دع مشتق: متغير منطقي = خطأ;
    طابق المسار_المحدد مع
    | اختيار.لا_شيء -> {
        المسار_المحدد := مسار_مصدر_مشتق_من_الجذر(البيئة, المفتاح);
        مشتق := صواب;
    }
    | اختيار.بعض(_) -> { };

    طابق المسار_المحدد مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تحديد_مصدر.خطأ(خطأ_تحديد_مصدر.غير_موجود());
    }
    | اختيار.بعض(المسار) -> {
        دع القراءة: نتيجة نص, عدد = اقرأ_محتوى_مصدر(البيئة, &المسار);
        طابق القراءة مع
        | نتيجة.خطأ(_) -> {
            لو (مشتق) {
                أرجع نتيجة_تحديد_مصدر.خطأ(خطأ_تحديد_مصدر.غير_موجود());
            };
            أرجع نتيجة_تحديد_مصدر.خطأ(خطأ_تحديد_مصدر.غير_مقروء());
        }
        | نتيجة.نجح(المحتوى) -> {
            دع الهوية: مفتاح_وحدة_مقنن = *المفتاح;
            دع المصدر: مصدر_محدد = {
                المفتاح: الهوية,
                مسار_ملف_المصدر: المسار,
                المحتوى: المحتوى
            };
            أرجع نتيجة_تحديد_مصدر.موجود(المصدر);
        };
    };
}
