// Source location is downstream metadata. A Canonical Module Key resolves either
// through an exact configured source or deterministically under its configured
// source root. Direct module lookup never searches directories; package discovery
// enumerates only the explicitly requested directory and its immediate .sn files.
عام نوع مصدر_محدد = {
    المفتاح: مفتاح_وحدة_مقنن,
    مسار_ملف_المصدر: نص,
    المحتوى: نص
};

عام نوع خطأ_تحديد_مصدر =
    | غير_موجود
    | غير_مقروء
;

عام نوع نتيجة_تحديد_مصدر =
    | موجود بنوع مصدر_محدد
    | خطأ بنوع خطأ_تحديد_مصدر
;

عام نوع نتيجة_اكتشاف_أعضاء_حزمة =
    | ليست_حزمة
    | غير_مقروءة
    | موجودة بنوع متجه مفتاح_وحدة_مقنن
;


عرف اقرأ_محتوى_مصدر(
    البيئة: &بيئة_وحدات_منطقية,
    المسار: &نص
): نتيجة نص, عدد {
    دع التراكب: نتيجة_محتوى_تراكب_مصدر = محتوى_تراكب_مصدر(&(*البيئة).مزود_المصادر, المسار);
    لو (التراكب.موجود) {
        دع مرجع_المحتوى: &نص = &التراكب.المحتوى;
        أرجع نتيجة.نجح(انسخ_نص(مرجع_المحتوى));
    };
    أرجع اقرأ_الملف(المسار);
}


عرف مسار_مصدر_مشتق_من_الجذر(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): اختياري نص {
    دع القيمة: مفتاح_وحدة_مقنن = *المفتاح;
    طابق جذر_مصدر_لمعرف(البيئة, القيمة.الجذر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(جذر_المصدر) -> {
        دع البايتات: متجه ط8 = بايتات_مسار_وحدة_منطقي(&القيمة.المسار);
        لو ((الطول(البايتات) مثل طبيعي) == 0) {
            أرجع اختياري.لا_شيء();
        };
        دع المسار_المنطقي: نص = من_بايتات(&البايتات);
        دع المسار: نص = صل_المسار(&جذر_المصدر, &المسار_المنطقي);
        أرجع اختياري.موجود(المسار);
    };
}

عرف مسار_دليل_حزمة_مشتق_من_الجذر(
    البيئة: &بيئة_وحدات_منطقية,
    مفتاح_الحزمة: &مفتاح_وحدة_مقنن
): اختياري نص {
    طابق جذر_مصدر_لمعرف(البيئة, (*مفتاح_الحزمة).الجذر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(جذر_المصدر) -> {
        دع البايتات: متجه ط8 = بايتات_مسار_وحدة_منطقي(&(*مفتاح_الحزمة).المسار);
        لو ((الطول(البايتات) مثل طبيعي) == 0) {
            أرجع اختياري.موجود(جذر_المصدر);
        };
        دع المسار_المنطقي: نص = من_بايتات(&البايتات);
        أرجع اختياري.موجود(صل_المسار(&جذر_المصدر, &المسار_المنطقي));
    };
}


// Deterministic package-member ordering belongs to source discovery. Keep it
// local so Module loading does not pull the generic collections sort package
// into the bootstrap compiler merely to order file names.
عرف رتب_أسماء_أعضاء_حزمة(الأسماء: &متغير متجه نص): فراغ {
    دع العدد: طبيعي = الطول(*الأسماء) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الأصغر: متغير طبيعي = ف;
        دع م: متغير طبيعي = ف + (1 مثل طبيعي);
        طالما (م < العدد) {
            دع نتيجة_المقارنة: عدد = قارن_نصين_معجميا(&(*الأسماء)[م], &(*الأسماء)[الأصغر]);
            لو (نتيجة_المقارنة < 0) { الأصغر := م; };
            م := م + (1 مثل طبيعي);
        }
        لو (الأصغر != ف) { بدّل((*الأسماء)[ف], (*الأسماء)[الأصغر]); };
        ف := ف + (1 مثل طبيعي);
    }
}

عرف بايتات_مسار_عضو_حزمة_مكتشف(
    الحزمة: &مسار_وحدة_منطقي,
    الملف: &نص
): متجه ط8 {
    دع الناتج: متغير متجه ط8 = بايتات_مسار_وحدة_منطقي(الحزمة);
    لو ((الطول(الناتج) مثل طبيعي) != 0) { ألحق(الناتج, 0x2F); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الملف) مثل طبيعي)) {
        ألحق(الناتج, (*الملف)[ف]);
        ف := ف + (1 مثل طبيعي);
    }
    أرجع الناتج;
}

// Discover only immediate .sn members of the requested physical package.
// A file consisting entirely of inactive top-level target guards has no
// declarations or imports for this target. Filter it at the canonical Module
// discovery boundary, before a package member can enter Name resolution.
// Ordinary empty files and invalid sources remain visible, preserving their
// canonical ModuleKey and the normal frontend diagnostics. Only the parser's
// already-defined conditional grammar determines target applicability.
//
// Only a file whose first token is `لو` can consist entirely of target
// guards, so the first token alone decides every other file: it is scanned
// with the lexer's own next-token entry, and the whole file is tokenized and
// parsed only for a leading guard. Previously every located module was fully
// tokenized here (and re-read from disk) before the loader tokenized and
// parsed it again, doubling lexing work and the retained token storage.
عرف محتوى_مصدر_نشط_للهدف(
    مسار_الملف: &نص,
    المحتوى: &نص,
    الهدف: &اختياري واصف_هدف
): منطقي {
    طابق *الهدف مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(_) -> { };
    دع المصدر: مصدر = مصدر_جديد(0, انسخ_نص(مسار_الملف), انسخ_نص(المحتوى));
    طابق الرمز_التالي(&المصدر, بداية_المؤشر()) مع
    | نتيجة_رمز.مرفوض(_) -> { أرجع صواب; }
    | نتيجة_رمز.ناجح(_, الأول) -> {
        لو (الأول.النوع != رمز.لو()) { أرجع صواب; };
    };
    طابق حلل_معجميا(&المصدر) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { أرجع صواب; }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        طابق حلل_الرموز_لهدف(&المصدر, &السلسلة.الرموز, الهدف) مع
        | نتيجة_تحليل.شجرة(الشجرة) -> {
            أرجع الطول(الشجرة.العناصر) != 0
                || الطول(الشجرة.الاستيرادات) != 0
                || الطول(الشجرة.مرادفات_الأسماء) != 0;
        }
        | _ -> { أرجع صواب; };
    };
}

عرف عضو_مصدر_نشط_للهدف(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    الهدف: &اختياري واصف_هدف
): منطقي {
    طابق *الهدف مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(_) -> { };
    طابق حدد_مصدر_وحدة(البيئة, المفتاح) مع
    | نتيجة_تحديد_مصدر.خطأ(_) -> { أرجع صواب; }
    | نتيجة_تحديد_مصدر.موجود(المحدد) -> {
        أرجع محتوى_مصدر_نشط_للهدف(
            &المحدد.مسار_ملف_المصدر, &المحدد.المحتوى, الهدف
        );
    };
}

// Subdirectories remain distinct packages and are never flattened. Names are
// sorted before ModuleKeys are formed so export discovery is deterministic.
عام عرف اكتشف_أعضاء_حزمة_مصدر_لهدف(
    البيئة: &بيئة_وحدات_منطقية,
    مفتاح_الحزمة: &مفتاح_وحدة_مقنن,
    الهدف: &اختياري واصف_هدف
): نتيجة_اكتشاف_أعضاء_حزمة {
    دع مسار_الحزمة: نص;
    طابق مسار_دليل_حزمة_مشتق_من_الجذر(البيئة, مفتاح_الحزمة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_اكتشاف_أعضاء_حزمة.ليست_حزمة(); }
    | اختياري.موجود(المسار) -> { مسار_الحزمة := المسار; };

    طابق حاول_مسار_دليل(&مسار_الحزمة) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة_اكتشاف_أعضاء_حزمة.غير_مقروءة(); }
    | نتيجة.نجح(هو_دليل) -> {
        لو (!هو_دليل) { أرجع نتيجة_اكتشاف_أعضاء_حزمة.ليست_حزمة(); };
    };

    دع الأسماء: متغير متجه نص = [];
    طابق اقرأ_مدخلات_الدليل(&مسار_الحزمة) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة_اكتشاف_أعضاء_حزمة.غير_مقروءة(); }
    | نتيجة.نجح(المدخلات) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المدخلات) مثل طبيعي)) {
            دع مرجع_المدخل: &مدخل_دليل = &المدخلات[ف];
            دع مرجع_الاسم: &نص = &(*مرجع_المدخل).الاسم;
            طابق (*مرجع_المدخل).النوع مع
            | نوع_مدخل_دليل.ملف -> {
                لو (هو_مسار_مصدر_سلطان(مرجع_الاسم)) {
                    دع الاسم: نص = انسخ_نص(مرجع_الاسم);
                    ألحق(الأسماء, الاسم);
                };
            }
            | _ -> { };
            ف := ف + (1 مثل طبيعي);
        }
    };

    رتب_أسماء_أعضاء_حزمة(&متغير الأسماء);
    دع الأعضاء: متغير متجه مفتاح_وحدة_مقنن = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
        دع بايتات_المسار: متجه ط8 = بايتات_مسار_عضو_حزمة_مكتشف(
            &(*مفتاح_الحزمة).المسار, &الأسماء[ف]
        );
        طابق قنن_مسار_وحدة_منطقي(&بايتات_المسار) مع
        | نتيجة_مسار_وحدة_منطقي.غير_صالح -> {
            // Directory entries cannot contain path separators; an invalid
            // logical member name is therefore ignored as a non-module file.
        }
        | نتيجة_مسار_وحدة_منطقي.صالح(المسار) -> {
            دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
                (*مفتاح_الحزمة).الجذر, المسار
            );
            لو (عضو_مصدر_نشط_للهدف(البيئة, &المفتاح, الهدف)) {
                ألحق(الأعضاء, المفتاح);
            };
        };
        ف := ف + (1 مثل طبيعي);
    }
    أرجع نتيجة_اكتشاف_أعضاء_حزمة.موجودة(الأعضاء);
}

// Neutral discovery remains the public compatibility entry for tooling that
// intentionally does not select a compilation target.
عام عرف اكتشف_أعضاء_حزمة_مصدر(
    البيئة: &بيئة_وحدات_منطقية,
    مفتاح_الحزمة: &مفتاح_وحدة_مقنن
): نتيجة_اكتشاف_أعضاء_حزمة {
    دع الهدف: اختياري واصف_هدف = اختياري.لا_شيء();
    أرجع اكتشف_أعضاء_حزمة_مصدر_لهدف(البيئة, مفتاح_الحزمة, &الهدف);
}

عام عرف حدد_مصدر_وحدة(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن
): نتيجة_تحديد_مصدر {
    دع المسار_المحدد: متغير اختياري نص = موقع_مصدر_لمفتاح(البيئة, المفتاح);
    دع مشتق: متغير منطقي = خطأ;
    طابق المسار_المحدد مع
    | اختياري.لا_شيء -> {
        المسار_المحدد := مسار_مصدر_مشتق_من_الجذر(البيئة, المفتاح);
        مشتق := صواب;
    }
    | اختياري.موجود(_) -> { };

    طابق المسار_المحدد مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحديد_مصدر.خطأ(خطأ_تحديد_مصدر.غير_موجود());
    }
    | اختياري.موجود(المسار) -> {
        دع القراءة: نتيجة نص, عدد = اقرأ_محتوى_مصدر(البيئة, &المسار);
        طابق القراءة مع
        | نتيجة.خطأ(_) -> {
            لو (مشتق) {
                أرجع نتيجة_تحديد_مصدر.خطأ(خطأ_تحديد_مصدر.غير_موجود());
            };
            أرجع نتيجة_تحديد_مصدر.خطأ(خطأ_تحديد_مصدر.غير_مقروء());
        }
        | نتيجة.نجح(المحتوى) -> {
            دع الهوية: مفتاح_وحدة_مقنن = انسخ_مملوكا_مفتاح_وحدة_مقنن(المفتاح);
            دع المصدر: مصدر_محدد = {
                المفتاح: الهوية,
                مسار_ملف_المصدر: المسار,
                المحتوى: المحتوى
            };
            أرجع نتيجة_تحديد_مصدر.موجود(المصدر);
        };
    };
}

// Direct imports must obey the same target inclusion decision as package
// discovery. A file inactive for the requested target has no loadable Module
// identity for that compilation; it cannot bypass the filter by exact path.
// The source is located (and read) once; its target activity is decided
// from that same content. Previously the file was read twice.
عام عرف حدد_مصدر_وحدة_لهدف(
    البيئة: &بيئة_وحدات_منطقية,
    المفتاح: &مفتاح_وحدة_مقنن,
    الهدف: &اختياري واصف_هدف
): نتيجة_تحديد_مصدر {
    طابق حدد_مصدر_وحدة(البيئة, المفتاح) مع
    | نتيجة_تحديد_مصدر.خطأ(الخطأ) -> {
        // As before, an unlocatable source is reported by the locator itself.
        أرجع نتيجة_تحديد_مصدر.خطأ(الخطأ);
    }
    | نتيجة_تحديد_مصدر.موجود(المحدد) -> {
        لو (!محتوى_مصدر_نشط_للهدف(
            &المحدد.مسار_ملف_المصدر, &المحدد.المحتوى, الهدف
        )) {
            أرجع نتيجة_تحديد_مصدر.خطأ(خطأ_تحديد_مصدر.غير_موجود());
        };
        أرجع نتيجة_تحديد_مصدر.موجود(المحدد);
    };
}
