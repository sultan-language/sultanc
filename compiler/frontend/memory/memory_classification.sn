    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(الحقائق) -> {
        أرجع نتيجة.نجح(الحقائق.يحتوي_مستعارا);
    };
}

عام عرف يحتوي_استعارة_حصرية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): نتيجة منطقي, خطأ_ذاكرة_نوع {
    طابق حلل_ذاكرة_نوع(سجل_الأنواع, المعرف) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(الحقائق) -> {
        أرجع نتيجة.نجح(الحقائق.يحتوي_استعارة_حصرية);
    };
}
