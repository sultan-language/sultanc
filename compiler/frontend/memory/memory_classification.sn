استورد compiler.frontend.memory.memory_model;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.builtins_generated;

استورد compiler.frontend.types.type_context;
// Memory consumes only Type-owned semantic-shape queries. It never reads Type registry storage directly.
عرف حقائق_عادية(): حقائق_ذاكرة_نوع {
    دع الصنف: صنف_ذاكرة = صنف_ذاكرة.عادي();
    دع الحقائق: حقائق_ذاكرة_نوع = {
        الصنف: الصنف,
        يتطلب_تحريرا: خطأ,
        يحتوي_مملوكا: خطأ,
        يحتوي_مستعارا: خطأ,
        يحتوي_استعارة_حصرية: خطأ
    };
    أرجع الحقائق;
}

عرف حقائق_مملوكة(): حقائق_ذاكرة_نوع {
    دع الصنف: صنف_ذاكرة = صنف_ذاكرة.مملوك();
    دع الحقائق: حقائق_ذاكرة_نوع = {
        الصنف: الصنف,
        يتطلب_تحريرا: صواب,
        يحتوي_مملوكا: صواب,
        يحتوي_مستعارا: خطأ,
        يحتوي_استعارة_حصرية: خطأ
    };
    أرجع الحقائق;
}

عرف حقائق_مملوكة_بمحتوى_مستعار(
    يستعير: منطقي,
    يستعير_حصريا: منطقي
): حقائق_ذاكرة_نوع {
    دع الصنف: صنف_ذاكرة = صنف_ذاكرة.مملوك();
    دع الحقائق: حقائق_ذاكرة_نوع = {
        الصنف: الصنف,
        يتطلب_تحريرا: صواب,
        يحتوي_مملوكا: صواب,
        يحتوي_مستعارا: يستعير,
        يحتوي_استعارة_حصرية: يستعير_حصريا
    };
    أرجع الحقائق;
}

عرف حقائق_مستعارة(حصرية: منطقي): حقائق_ذاكرة_نوع {
    دع الصنف: صنف_ذاكرة = صنف_ذاكرة.مستعار();
    دع الحقائق: حقائق_ذاكرة_نوع = {
        الصنف: الصنف,
        يتطلب_تحريرا: خطأ,
        يحتوي_مملوكا: خطأ,
        يحتوي_مستعارا: صواب,
        يحتوي_استعارة_حصرية: حصرية
    };
    أرجع الحقائق;
}

عرف دمج_حقائق_محتوى(
    الحالية: حقائق_ذاكرة_نوع,
    الابن: حقائق_ذاكرة_نوع
): حقائق_ذاكرة_نوع {
    دع يملك: منطقي = الحالية.يحتوي_مملوكا
        || الابن.يتطلب_تحريرا
        || الابن.يحتوي_مملوكا;
    دع يستعير: منطقي = الحالية.يحتوي_مستعارا
        || الابن.يحتوي_مستعارا;
    دع يستعير_حصريا: منطقي = الحالية.يحتوي_استعارة_حصرية
        || الابن.يحتوي_استعارة_حصرية;
    دع الصنف: متغير صنف_ذاكرة = صنف_ذاكرة.عادي();
    إذا (يملك) {
        الصنف := صنف_ذاكرة.مملوك();
    } وإلا إذا (يستعير) {
        الصنف := صنف_ذاكرة.مستعار();
    };
    دع الحقائق: حقائق_ذاكرة_نوع = {
        الصنف: الصنف,
        يتطلب_تحريرا: يملك,
        يحتوي_مملوكا: يملك,
        يحتوي_مستعارا: يستعير,
        يحتوي_استعارة_حصرية: يستعير_حصريا
    };
    أرجع الحقائق;
}

عرف تأكد_سعة_الأنواع_النشطة(
    الأنواع_النشطة: &متغير متجه منطقي,
    المعرف: معرف_نوع
): فراغ {
    طالما ((الطول(*الأنواع_النشطة) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) {
        ألحق(*الأنواع_النشطة, خطأ);
    }
}

عرف تأكد_سعة_مخزن_حقائق_الذاكرة(
    المخزن: &متغير متجه اختياري حقائق_ذاكرة_نوع,
    المعرف: معرف_نوع
): فراغ {
    طالما ((الطول(*المخزن) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) {
        ألحق(*المخزن, اختياري.لا_شيء());
    }
}

عرف حلل_عناصر_صف(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الأنواع_النشطة: &متغير متجه منطقي,
    المخزن: &متغير متجه اختياري حقائق_ذاكرة_نوع,
    اعتمد_على_دورة: &متغير منطقي
): نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع {
    طابق عدد_عناصر_صف_دلالي(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(المعرف));
    }
    | اختياري.موجود(العدد) -> {
        دع الحقائق: متغير حقائق_ذاكرة_نوع = حقائق_عادية();
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_عنصر_صف_دلالي_عند(سجل_الأنواع, المعرف, ف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(
                    خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(المعرف)
                );
            }
            | اختياري.موجود(نوع_الابن) -> {
                دع نتيجة_الابن: نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع =
                    حلل_نوع_ذاكريا_عوديا(سجل_الأنواع, نوع_الابن, الأنواع_النشطة, المخزن, اعتمد_على_دورة);
                طابق نتيجة_الابن مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع نتيجة.خطأ(الخطأ);
                }
                | نتيجة.نجح(حقائق_الابن) -> {
                    الحقائق := دمج_حقائق_محتوى(الحقائق, حقائق_الابن);
                };
            };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(الحقائق);
    };
}

عرف حلل_حقول_سجل(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الأنواع_النشطة: &متغير متجه منطقي,
    المخزن: &متغير متجه اختياري حقائق_ذاكرة_نوع,
    اعتمد_على_دورة: &متغير منطقي
): نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع {
    طابق عدد_حقول_سجل_دلالي(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_نوع.بنية_سجل_غير_متاحة(المعرف));
    }
    | اختياري.موجود(العدد) -> {
        دع الحقائق: متغير حقائق_ذاكرة_نوع = حقائق_عادية();
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_حقل_سجل_دلالي_عند(سجل_الأنواع, المعرف, ف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(
                    خطأ_ذاكرة_نوع.حقل_سجل_غير_متاح(المعرف, ف)
                );
            }
            | اختياري.موجود(نوع_الابن) -> {
                دع نتيجة_الابن: نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع =
                    حلل_نوع_ذاكريا_عوديا(سجل_الأنواع, نوع_الابن, الأنواع_النشطة, المخزن, اعتمد_على_دورة);
                طابق نتيجة_الابن مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع نتيجة.خطأ(الخطأ);
                }
                | نتيجة.نجح(حقائق_الابن) -> {
                    الحقائق := دمج_حقائق_محتوى(الحقائق, حقائق_الابن);
                };
            };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(الحقائق);
    };
}

// Ordinary enums, Option, and Result all use the same canonical Type constructor contract.
عرف حلل_حمولات_نوع_موسوم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الأنواع_النشطة: &متغير متجه منطقي,
    المخزن: &متغير متجه اختياري حقائق_ذاكرة_نوع,
    اعتمد_على_دورة: &متغير منطقي
): نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع {
    طابق عدد_منشئات_نوع_دلالي(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(
            خطأ_ذاكرة_نوع.بنية_نوع_موسوم_غير_متاحة(المعرف)
        );
    }
    | اختياري.موجود(عدد_المنشئات) -> {
        دع الحقائق: متغير حقائق_ذاكرة_نوع = حقائق_عادية();
        دع م: متغير طبيعي = 0;
        طالما (م < عدد_المنشئات) {
            طابق عدد_حمولات_منشئ_دلالي_عند(سجل_الأنواع, المعرف, م) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(
                    خطأ_ذاكرة_نوع.منشئ_نوع_غير_متاح(المعرف, م)
                );
            }
            | اختياري.موجود(عدد_الحمولات) -> {
                دع ح: متغير طبيعي = 0;
                طالما (ح < عدد_الحمولات) {
                    طابق نوع_حمولة_منشئ_دلالي_عند(سجل_الأنواع, المعرف, م, ح) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة.خطأ(
                            خطأ_ذاكرة_نوع.حمولة_منشئ_غير_متاحة(
                                المعرف,
                                م,
                                ح
                            )
                        );
                    }
                    | اختياري.موجود(نوع_الابن) -> {
                        دع نتيجة_الابن: نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع =
                            حلل_نوع_ذاكريا_عوديا(
                                سجل_الأنواع,
                                نوع_الابن,
                                الأنواع_النشطة,
                                المخزن,
                                اعتمد_على_دورة
                            );
                        طابق نتيجة_الابن مع
                        | نتيجة.خطأ(الخطأ) -> {
                            أرجع نتيجة.خطأ(الخطأ);
                        }
                        | نتيجة.نجح(حقائق_الابن) -> {
                            الحقائق := دمج_حقائق_محتوى(
                                الحقائق,
                                حقائق_الابن
                            );
                        };
                    };
                    ح := ح + 1;
                }
            };
            م := م + 1;
        }
        أرجع نتيجة.نجح(الحقائق);
    };
}

// Analyze one already-active type. Recursive children re-enter through
// `حلل_نوع_ذاكريا_عوديا`, which owns cycle detection and active-state lifetime.
عرف حلل_نوع_ذاكريا_نشطا(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الأنواع_النشطة: &متغير متجه منطقي,
    المخزن: &متغير متجه اختياري حقائق_ذاكرة_نوع,
    اعتمد_على_دورة: &متغير منطقي
): نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع {
    طابق وصف_شكل_نوع_دلالي_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_نوع.معرف_نوع_غير_صالح(المعرف));
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.معامل_نوع -> {
            // An unconstrained generic parameter may instantiate to an owning type.
            // Generic templates are therefore checked conservatively before concrete
            // substitution; unresolved type parameters must not reach representation.
            أرجع نتيجة.نجح(حقائق_مملوكة());
        }
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.نص -> {
                أرجع نتيجة.نجح(حقائق_مملوكة());
            }
            | _ -> {
                أرجع نتيجة.نجح(حقائق_عادية());
            };
        }
        | صنف_شكل_نوع_دلالي.صف -> {
            أرجع حلل_عناصر_صف(سجل_الأنواع, المعرف, الأنواع_النشطة, المخزن, اعتمد_على_دورة);
        }
        | صنف_شكل_نوع_دلالي.سجل -> {
            أرجع حلل_حقول_سجل(سجل_الأنواع, المعرف, الأنواع_النشطة, المخزن, اعتمد_على_دورة);
        }
        | صنف_شكل_نوع_دلالي.تعداد -> {
            أرجع حلل_حمولات_نوع_موسوم(
                سجل_الأنواع,
                المعرف,
                الأنواع_النشطة,
                المخزن,
                اعتمد_على_دورة
            );
        }
        | صنف_شكل_نوع_دلالي.صندوق -> {
            طابق نوع_حمولة_صندوق_دلالي(سجل_الأنواع, المعرف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(المعرف));
            }
            | اختياري.موجود(الحمولة) -> {
                طابق حلل_نوع_ذاكريا_عوديا(سجل_الأنواع, الحمولة, الأنواع_النشطة, المخزن, اعتمد_على_دورة) مع
                | نتيجة.خطأ(خطأ_ذاكرة_نوع.دورة_ملكية_نوع(_)) -> {
                    *اعتمد_على_دورة := صواب;
                    // Owning indirection closes a layout/ownership cycle. The back-edge
                    // contributes no new view fact; siblings still participate normally.
                    أرجع نتيجة.نجح(حقائق_مملوكة());
                }
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(حقائق_الحمولة) -> {
                    أرجع نتيجة.نجح(
                        حقائق_مملوكة_بمحتوى_مستعار(
                            حقائق_الحمولة.يحتوي_مستعارا,
                            حقائق_الحمولة.يحتوي_استعارة_حصرية
                        )
                    );
                };
            };
        }
        | صنف_شكل_نوع_دلالي.اختيار -> {
            أرجع حلل_حمولات_نوع_موسوم(
                سجل_الأنواع,
                المعرف,
                الأنواع_النشطة,
                المخزن,
                اعتمد_على_دورة
            );
        }
        | صنف_شكل_نوع_دلالي.نتيجة -> {
            أرجع حلل_حمولات_نوع_موسوم(
                سجل_الأنواع,
                المعرف,
                الأنواع_النشطة,
                المخزن,
                اعتمد_على_دورة
            );
        }
        | صنف_شكل_نوع_دلالي.دالة -> {
            أرجع نتيجة.نجح(حقائق_عادية());
        }
        // An opaque type owns and borrows nothing the compiler can see; no
        // value of it exists (only `*T`, which is plain).
        | صنف_شكل_نوع_دلالي.معتم -> {
            أرجع نتيجة.نجح(حقائق_عادية());
        }
        | صنف_شكل_نوع_دلالي.مؤشر -> {
            أرجع نتيجة.نجح(حقائق_عادية());
        }
        | صنف_شكل_نوع_دلالي.مرجع -> {
            طابق نوع_داخل_مرجع_متغير_دلالي(سجل_الأنواع, المعرف) مع
            | اختياري.موجود(_) -> { أرجع نتيجة.نجح(حقائق_مستعارة(صواب)); }
            | اختياري.لا_شيء -> { أرجع نتيجة.نجح(حقائق_مستعارة(خطأ)); };
        }
        | صنف_شكل_نوع_دلالي.شريحة -> {
            أرجع نتيجة.نجح(حقائق_مستعارة(خطأ));
        }
        | صنف_شكل_نوع_دلالي.متجه -> {
            طابق نوع_عنصر_متجه_دلالي(سجل_الأنواع, المعرف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_ذاكرة_نوع.شكل_نوع_غير_متوقع(المعرف));
            }
            | اختياري.موجود(العنصر) -> {
                طابق حلل_نوع_ذاكريا_عوديا(سجل_الأنواع, العنصر, الأنواع_النشطة, المخزن, اعتمد_على_دورة) مع
                | نتيجة.خطأ(خطأ_ذاكرة_نوع.دورة_ملكية_نوع(_)) -> {
                    *اعتمد_على_دورة := صواب;
                    أرجع نتيجة.نجح(حقائق_مملوكة());
                }
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(حقائق_العنصر) -> {
                    أرجع نتيجة.نجح(
                        حقائق_مملوكة_بمحتوى_مستعار(
                            حقائق_العنصر.يحتوي_مستعارا,
                            حقائق_العنصر.يحتوي_استعارة_حصرية
                        )
                    );
                };
            };
        };
    };
}

// Sole recursive owner for static ownership containment. The previous
// implementation copied the complete ancestry vector at every recursion step.
// Cycle semantics only need active-membership, so retain one dense TypeID-indexed
// active state and clear the entry when the recursive frame exits.
عرف حلل_نوع_ذاكريا_عوديا(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الأنواع_النشطة: &متغير متجه منطقي,
    المخزن: &متغير متجه اختياري حقائق_ذاكرة_نوع,
    اعتمد_على_دورة: &متغير منطقي
): نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع {
    تأكد_سعة_الأنواع_النشطة(الأنواع_النشطة, المعرف);
    تأكد_سعة_مخزن_حقائق_الذاكرة(المخزن, المعرف);
    إذا ((*الأنواع_النشطة)[المعرف.القيمة]) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_نوع.دورة_ملكية_نوع(المعرف));
    };
    طابق (*المخزن)[المعرف.القيمة] مع
    | اختياري.موجود(الحقائق) -> { أرجع نتيجة.نجح(الحقائق); }
    | اختياري.لا_شيء -> { };
    (*الأنواع_النشطة)[المعرف.القيمة] := صواب;

    دع النتيجة: نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع =
        حلل_نوع_ذاكريا_نشطا(سجل_الأنواع, المعرف, الأنواع_النشطة, المخزن, اعتمد_على_دورة);

    (*الأنواع_النشطة)[المعرف.القيمة] := خطأ;
    أرجع النتيجة;
}

عام عرف حلل_ذاكرة_نوع_بمخزن(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الأنواع_النشطة: &متغير متجه منطقي,
    المخزن: &متغير متجه اختياري حقائق_ذاكرة_نوع
): نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع {
    دع اعتمد_على_دورة: متغير منطقي = خطأ;
    دع النتيجة: نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع =
        حلل_نوع_ذاكريا_عوديا(
            سجل_الأنواع,
            المعرف,
            الأنواع_النشطة,
            المخزن,
            &متغير اعتمد_على_دورة
        );
    طابق النتيجة مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الحقائق) -> {
        إذا (!اعتمد_على_دورة) {
            تأكد_سعة_مخزن_حقائق_الذاكرة(المخزن, المعرف);
            (*المخزن)[المعرف.القيمة] := اختياري.موجود(الحقائق);
        };
        أرجع نتيجة.نجح(الحقائق);
    };
}

عام عرف حلل_ذاكرة_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع {
    دع الأنواع_النشطة: متغير متجه منطقي = [];
    دع المخزن: متغير متجه اختياري حقائق_ذاكرة_نوع = [];
    أرجع حلل_ذاكرة_نوع_بمخزن(
        سجل_الأنواع,
        المعرف,
        &متغير الأنواع_النشطة,
        &متغير المخزن
    );
}

عام عرف تصنيف_ذاكرة_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): نتيجة صنف_ذاكرة, خطأ_ذاكرة_نوع {
    طابق حلل_ذاكرة_نوع(سجل_الأنواع, المعرف) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(الحقائق) -> {
        أرجع نتيجة.نجح(الحقائق.الصنف);
    };
}

عام عرف يتطلب_تحرير(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): نتيجة منطقي, خطأ_ذاكرة_نوع {
    طابق حلل_ذاكرة_نوع(سجل_الأنواع, المعرف) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(الحقائق) -> {
        أرجع نتيجة.نجح(الحقائق.يتطلب_تحريرا);
    };
}

عام عرف يحتوي_مملوكا(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): نتيجة منطقي, خطأ_ذاكرة_نوع {
    طابق حلل_ذاكرة_نوع(سجل_الأنواع, المعرف) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(الحقائق) -> {
        أرجع نتيجة.نجح(الحقائق.يحتوي_مملوكا);
    };
}

عام عرف يحتوي_مستعارا(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): نتيجة منطقي, خطأ_ذاكرة_نوع {
