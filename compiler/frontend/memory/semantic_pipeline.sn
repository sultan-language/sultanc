استورد compiler.frontend.memory.memory_model;
استورد compiler.frontend.memory.memory_classification;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_identity;

استورد compiler.frontend.types.type_context;
عام نوع ربط_ذاكرة_نوع = {
    النوع: معرف_نوع,
    الحقائق: حقائق_ذاكرة_نوع
};

عام نوع سياق_ذاكرة_وحدة = {
    الأنواع: متجه ربط_ذاكرة_نوع
};

عام نوع نتيجة_ذاكرة_وحدة =
    | مكتملة بنوع سياق_ذاكرة_وحدة
    | مرفوضة بنوع خطأ_ذاكرة_نوع
;

عام عرف ابن_ذاكرة_وحدة(سجل_الأنواع: &سجل_أنواع): نتيجة_ذاكرة_وحدة {
    دع الروابط: متغير متجه ربط_ذاكرة_نوع = [];
    // One active-state buffer is reused for every root. Completed analyses are
    // cached only when they did not depend on a caught recursive back-edge, so
    // recursive ownership semantics and diagnostics remain exactly path-sensitive.
    دع الأنواع_النشطة: متغير متجه منطقي = [];
    دع المخزن: متغير متجه اختياري حقائق_ذاكرة_نوع = [];
    دع عدد_الأنواع: طبيعي = الطول((*سجل_الأنواع).الأنواع) مثل طبيعي;
    دع ت: متغير طبيعي = 0;
    طالما (ت < عدد_الأنواع) {
        ألحق(الأنواع_النشطة, خطأ);
        ألحق(المخزن, اختياري.لا_شيء());
        ت := ت + 1;
    }
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأنواع) {
        دع النوع: معرف_نوع = معرف_نوع_من(ف);
        طابق حلل_ذاكرة_نوع_بمخزن(
            سجل_الأنواع,
            النوع,
            &متغير الأنواع_النشطة,
            &متغير المخزن
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_ذاكرة_وحدة.مرفوضة(الخطأ);
        }
        | نتيجة.نجح(الحقائق) -> {
            دع الربط: ربط_ذاكرة_نوع = { النوع: النوع, الحقائق: الحقائق };
            ألحق(الروابط, الربط);
        };
        ف := ف + 1;
    }
    دع السياق: سياق_ذاكرة_وحدة = { الأنواع: الروابط };
    أرجع نتيجة_ذاكرة_وحدة.مكتملة(السياق);
}

عام عرف حقائق_ذاكرة_نوع_عند(
    السياق: &سياق_ذاكرة_وحدة, النوع: معرف_نوع
): اختياري حقائق_ذاكرة_نوع {
    دع ف: طبيعي = النوع.القيمة;
    إذا (ف >= (الطول((*السياق).الأنواع) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الربط: &ربط_ذاكرة_نوع = &(*السياق).الأنواع[ف];
    إذا (!معرفا_نوع_متساويان((*مرجع_الربط).النوع, النوع)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*مرجع_الربط).الحقائق);
}

// Memory builds this table in exact TypeID order. Consumers that require a fact
// use the indexed table instead of re-running recursive Type classification.
عام عرف حقائق_ذاكرة_نوع_مطلوبة(
    السياق: &سياق_ذاكرة_وحدة, النوع: معرف_نوع
): نتيجة حقائق_ذاكرة_نوع, خطأ_ذاكرة_نوع {
    طابق حقائق_ذاكرة_نوع_عند(السياق, النوع) مع
    | اختياري.موجود(الحقائق) -> { أرجع نتيجة.نجح(الحقائق); }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_نوع.معرف_نوع_غير_صالح(النوع));
    };
}

// Gives a generic Type parameter an inferred plain bound (SSF owns the
// inference; docs/en/reference/ownership.md). Inside its template the
// parameter is then copied by reading it, and SSF rejects every instantiation
// with an owning Type. Returns whether the bound is new.
عام عرف قيد_معامل_نوع_عاديا(
    السياق: &متغير سياق_ذاكرة_وحدة, النوع: معرف_نوع
): منطقي {
    دع ف: طبيعي = النوع.القيمة;
    إذا (ف >= (الطول((*السياق).الأنواع) مثل طبيعي)) { أرجع خطأ; };
    إذا (!معرفا_نوع_متساويان((*السياق).الأنواع[ف].النوع, النوع)) { أرجع خطأ; };
    إذا (!(*السياق).الأنواع[ف].الحقائق.يتطلب_تحريرا) { أرجع خطأ; };
    دع الصنف: صنف_ذاكرة = صنف_ذاكرة.عادي();
    دع الحقائق: حقائق_ذاكرة_نوع = {
        الصنف: الصنف,
        يتطلب_تحريرا: خطأ,
        يحتوي_مملوكا: خطأ,
        يحتوي_مستعارا: خطأ,
        يحتوي_استعارة_حصرية: خطأ
    };
    (*السياق).الأنواع[ف].الحقائق := الحقائق;
    أرجع صواب;
}
