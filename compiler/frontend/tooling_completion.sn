// Completion at the cursor for editors (the language server). The compiler
// knows the answer; the tool filters by the typed prefix, ranks and draws.
//
// The line at the cursor is unfinished, so the source usually does not parse.
// Completion therefore runs in two steps, the way IDE engines treat an
// unfinished statement:
//
//   1. رقع_مصدر_للإكمال(&النص, البايت) reads the text before the cursor and
//      returns a رقعة_إكمال: the lexical context (a name, `path.`, a receiver
//      expression before `.`, a Type position, a record literal's field, a
//      match arm, a call argument, an import path, or nothing inside a
//      string, comment or number), the start of the word being typed, the
//      dotted path or the expression before it, and النص: the same source
//      with the unfinished statement removed and open braces closed. Every
//      byte before the statement is unchanged, so the statement's start
//      (البايت) sees the same scope the cursor does.
//   2. The tool analyses النص as the source's unsaved buffer (the usual
//      tooling request), then asks:
//        * إكمال_عند_رقعة_واجهة(&الواجهة, المصدر, &الرقعة) for names in scope,
//          members of a value's type, constructors of a type, Types, the
//          fields of a record literal, the cases of a match and call
//          arguments; the expressions the statement names (a receiver, a
//          callee, a scrutinee) are typed from the analysis of the names they
//          start with;
//        * إكمال_مسار_بيئة(&البيئة, &الرقعة) for import paths and module paths
//          (`import std.`, `std.io.`), which need the module environment.
//
// Candidates are not filtered by the prefix. Names in scope are the bindings
// visible at the statement, so another module's private names never appear.
// A candidate's نص_الإدراج is what the editor inserts: الاسم, except for a
// constructor, which is called in a value position (`Red()`, `Circle(`) and
// written by name in a pattern (`| Color.Red`); عدد_الحمولات and في_نمط say
// which.

عام نوع سياق_إكمال =
    // A bare identifier: every name visible at the cursor.
    | اسم
    // `expr.`: the members of the expression's type.
    | عضو_قيمة
    // `Type.`: the constructors of the type.
    | عضو_نوع
    // `a.b.` in an expression naming modules: the children of module a.b.
    | مسار_وحدة
    // `import a.` / `استورد أ.` / `from a.`: the child modules of a.
    | مسار_استيراد
    // Inside a string, a comment or a number.
    | لا_شيء
    // A Type position (`let x: |`, a parameter's, a field's or a result's
    // Type): the Types in scope and the builtin Types, no values.
    | موضع_نوع
    // A field name in a record literal of a known Type (`let o: Inner = { |`):
    // the fields not yet written.
    | حقل_سجل
    // An arm of a match on a value of a known Type (`match c with | |`): the
    // cases no arm covers yet.
    | حالة_مطابقة
    // An argument of a call (`area(|`, `area(a, |`): the names in scope, those
    // whose Type fits the parameter first.
    | معامل_استدعاء
;

عام نوع صنف_مرشح =
    | تصريح بنوع نوع_تصريح
    | حقل
    | وحدة
    | محلي
    | معامل
    // A builtin Type (`int`, `string`, `vector`, ...).
    | نوع_مدمج
    // A builtin constructor (`option.some`, `result.ok`, ...).
    | منشئ_مدمج
    // A match arm's pattern (`Color.Red`, `option.some(_)`).
    | نمط_حالة
;

عام نوع مرشح_إكمال = {
    // As declared (Arabic or English), or a module spelling; a pattern for
    // نمط_حالة.
    الاسم: نص,
    الرمز: اختياري معرف_رمز,
    الصنف: صنف_مرشح,
    // A field's or a value's Type.
    النوع: اختياري معرف_نوع,
    // 0 a local, 1 a parameter, 2 this module, 3 imported, 4 std.
    البعد: طبيعي,
    // A module spelling: the language it is declared under (`ar`, `fr`, ...)
    // and the canonical module it names. None for a canonical module name and
    // for every other candidate.
    اللغة: اختياري نص,
    الأصلي: اختياري نص,
    // The candidate's Type fits the Type the context expects (a call
    // argument's parameter); such candidates come first.
    يلائم_المتوقع: منطقي,
    // A constructor (an enum's after `Type.`, a builtin one after `option.`
    // or `result.`, a match arm's case): the number of payloads it takes.
    // None for every other candidate.
    عدد_الحمولات: اختياري طبيعي,
    // The candidate is offered where a pattern is written (`| Color.`, a
    // match arm's case): a constructor is matched there, not called.
    في_نمط: منطقي,
    // The text the editor inserts. A constructor in a value position is a
    // call (`Color.Red` alone is SULTANC-NAME-CONSTRUCTOR-NOT-CALLED): `Red()`
    // without payloads, `Circle(` with them, whose arguments the author
    // writes. In a pattern position a constructor inserts its name (`Red`),
    // a match arm's case its pattern (`Color.Red`, `option.some(_)`). Every
    // other candidate inserts الاسم.
    نص_الإدراج: نص
};

عام نوع نتيجة_إكمال_أدوات = {
    السياق: سياق_إكمال,
    // The start of the word being typed, in the original text: the prefix the
    // tool replaces runs from here to the cursor.
    بداية_الكلمة: طبيعي,
    المرشحات: متجه مرشح_إكمال,
    // The Type the context expects: the record of حقل_سجل, the scrutinee's
    // of حالة_مطابقة, the parameter's of معامل_استدعاء. None otherwise.
    النوع_المتوقع: اختياري معرف_نوع
};

عام نوع رقعة_إكمال = {
    السياق: سياق_إكمال,
    بداية_الكلمة: طبيعي,
    // The components before the word: `p` for `p.x|`, `std`, `io` for
    // `std.io.|`; for حقل_سجل, the fields leading to a nested literal
    // (`inner` for `let o: Outer = { inner: { |`). Empty for a bare name.
    المسار: متجه نص,
    // The text to analyse, and the byte in it where the removed statement
    // started (the scope query position).
    النص: نص,
    البايت: طبيعي,
    // The expression the context is about, as written: the receiver before
    // `.` when it is not a dotted path of names (`make()`, `(*r)`,
    // `arr[0]`; المسار is then empty), the callee of معامل_استدعاء, the
    // scrutinee of حالة_مطابقة. Empty otherwise.
    التعبير: نص,
    // حقل_سجل: the Type the `let` declares (`Inner`).
    النوع_المكتوب: نص,
    // معامل_استدعاء: the argument's position (0 for `area(|`).
    ترتيب_المعامل: طبيعي,
    // What is already written: the field names of the record literal
    // (حقل_سجل), the arms' patterns (حالة_مطابقة).
    المكتوبة: متجه نص,
    // The source's keywords are English: builtin names are spelled in English.
    إنجليزية: منطقي,
    // The dotted path is written in a match arm's pattern (`| Color.`,
    // `| Shape.Tinted(Color.`): its constructors are matched, not called.
    في_نمط: منطقي
};

// ---- Step 1: the text before the cursor ----------------------------------------

// Lexical state of a forward scan (only `//` comments; `"…"` with escapes;
// nestable `«…»`).
نوع حالة_مسح_إكمال = {
    في_تعليق: منطقي,
    في_نص_مزدوج: منطقي,
    عمق_الأقواس_المزخرفة: طبيعي
};

// A bracket open at the cursor.
نوع قوس_مفتوح_إكمال = {
    البايت: ط8,
    الموضع: طبيعي,
    // The start of the statement when the bracket opened.
    بداية_العبارة: طبيعي,
    // 0 a bracket in an expression (a record literal's `{` too), 1 a block,
    // 2 the body of a match arm or a closure (`-> {`).
    الصنف: ط8
};

عرف بايت_عند_إكمال(النص: &نص, الموضع: طبيعي): ط8 {
    إذا (الموضع >= (الطول(*النص) مثل طبيعي)) { أرجع 0; };
    أرجع (*النص)[الموضع];
}

// `«` is C2 AB and `»` is C2 BB in UTF-8.
عرف قوس_مزخرف_فاتح_عند(النص: &نص, الموضع: طبيعي): منطقي {
    أرجع بايت_عند_إكمال(النص, الموضع) == 0xC2 && بايت_عند_إكمال(النص, الموضع + 1) == 0xAB;
}

عرف قوس_مزخرف_غالق_عند(النص: &نص, الموضع: طبيعي): منطقي {
    أرجع بايت_عند_إكمال(النص, الموضع) == 0xC2 && بايت_عند_إكمال(النص, الموضع + 1) == 0xBB;
}

// Advances the scan over one byte position; returns how many bytes it took.
عرف تقدم_مسح_إكمال(النص: &نص, الموضع: طبيعي, الحالة: &متغير حالة_مسح_إكمال): طبيعي {
    ليكن البايت: ط8 = بايت_عند_إكمال(النص, الموضع);
    إذا ((*الحالة).في_تعليق) {
        إذا (البايت == 0x0A) { (*الحالة).في_تعليق := خطأ; };
        أرجع 1;
    };
    إذا ((*الحالة).في_نص_مزدوج) {
        إذا (البايت == 0x5C) { أرجع 2; };
        إذا (البايت == 0x22) { (*الحالة).في_نص_مزدوج := خطأ; };
        أرجع 1;
    };
    إذا ((*الحالة).عمق_الأقواس_المزخرفة > 0) {
        إذا (قوس_مزخرف_فاتح_عند(النص, الموضع)) {
            (*الحالة).عمق_الأقواس_المزخرفة := (*الحالة).عمق_الأقواس_المزخرفة + 1;
            أرجع 2;
        };
        إذا (قوس_مزخرف_غالق_عند(النص, الموضع)) {
            (*الحالة).عمق_الأقواس_المزخرفة := (*الحالة).عمق_الأقواس_المزخرفة - 1;
            أرجع 2;
        };
        أرجع 1;
    };
    إذا (البايت == 0x2F && بايت_عند_إكمال(النص, الموضع + 1) == 0x2F) {
        (*الحالة).في_تعليق := صواب;
        أرجع 2;
    };
    إذا (البايت == 0x22) { (*الحالة).في_نص_مزدوج := صواب; أرجع 1; };
    إذا (قوس_مزخرف_فاتح_عند(النص, الموضع)) {
        (*الحالة).عمق_الأقواس_المزخرفة := 1;
        أرجع 2;
    };
    أرجع 1;
}

عرف حالة_عادية_إكمال(الحالة: &حالة_مسح_إكمال): منطقي {
    أرجع !(*الحالة).في_تعليق && !(*الحالة).في_نص_مزدوج && (*الحالة).عمق_الأقواس_المزخرفة == 0;
}

عرف حالة_مسح_أولى_إكمال(): حالة_مسح_إكمال {
    ليكن الحالة: حالة_مسح_إكمال = { في_تعليق: خطأ, في_نص_مزدوج: خطأ, عمق_الأقواس_المزخرفة: 0 };
    أرجع الحالة;
}

// The start of the UTF-8 character that ends right before الموضع.
عرف بداية_محرف_سابق(النص: &نص, الموضع: طبيعي): طبيعي {
    ليكن ف: متغير طبيعي = الموضع;
    إذا (ف == 0) { أرجع 0; };
    ف := ف - 1;
    طالما (ف > 0 && (بايت_عند_إكمال(النص, ف) & 0xC0) == 0x80) { ف := ف - 1; }
    أرجع ف;
}

عرف محرف_معرف_عند(النص: &نص, الموضع: طبيعي): منطقي {
    ليكن البايت: ط8 = بايت_عند_إكمال(النص, الموضع);
    إذا (البايت < 0x80) {
        أرجع (البايت >= 0x30 && البايت <= 0x39) || (البايت >= 0x41 && البايت <= 0x5A)
            || (البايت >= 0x61 && البايت <= 0x7A) || البايت == 0x5F;
    };
    إذا (قوس_مزخرف_فاتح_عند(النص, الموضع) || قوس_مزخرف_غالق_عند(النص, الموضع)) { أرجع خطأ; };
    ليكن المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, الموضع);
    إذا (!المفكوك.صالح) { أرجع خطأ; };
    أرجع تتمة_معرف(المفكوك.القيمة);
}

// The start of the identifier that ends at النهاية (النهاية when none).
عرف بداية_معرف_قبل(النص: &نص, النهاية: طبيعي): طبيعي {
    ليكن البداية: متغير طبيعي = النهاية;
    طالما (البداية > 0) {
        ليكن السابق: طبيعي = بداية_محرف_سابق(النص, البداية);
        إذا (!محرف_معرف_عند(النص, السابق)) { أرجع البداية; };
        البداية := السابق;
    }
    أرجع البداية;
}

// The end of the identifier that starts at البداية.
عرف نهاية_معرف_بعد(النص: &نص, البداية: طبيعي): طبيعي {
    ليكن ف: متغير طبيعي = البداية;
    ليكن الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    طالما (ف < الطول_الكلي && محرف_معرف_عند(النص, ف)) {
        ليكن البايت: ط8 = بايت_عند_إكمال(النص, ف);
        إذا (البايت < 0x80) { ف := ف + 1; }
        وإلا {
            ليكن المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, ف);
            ف := ف + المفكوك.العرض;
        };
    }
    أرجع ف;
}

عرف نص_بين(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < النهاية && ف < (الطول(*النص) مثل طبيعي)) {
        ألحق(البايتات, (*النص)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف فراغ_عند(البايت: ط8): منطقي {
    أرجع البايت == 0x20 || البايت == 0x09 || البايت == 0x0A || البايت == 0x0D;
}

// The text between البداية and النهاية without the blanks around it.
عرف نص_مقصوص_بين(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    ليكن ب: متغير طبيعي = البداية;
    ليكن ن: متغير طبيعي = النهاية;
    طالما (ب < ن && فراغ_عند(بايت_عند_إكمال(النص, ب))) { ب := ب + 1; }
    طالما (ن > ب && فراغ_عند(بايت_عند_إكمال(النص, ن - 1))) { ن := ن - 1; }
    أرجع نص_بين(النص, ب, ن);
}

// The last byte before الموضع (from الحد on) that is not blank.
عرف آخر_غير_فراغ_قبل(النص: &نص, الموضع: طبيعي, الحد: طبيعي): اختياري طبيعي {
    ليكن ف: متغير طبيعي = الموضع;
    طالما (ف > الحد) {
        ف := ف - 1;
        إذا (!فراغ_عند(بايت_عند_إكمال(النص, ف))) { أرجع اختياري.موجود(ف); };
    }
    أرجع اختياري.لا_شيء();
}

// The first word of the statement that starts at البداية.
عرف أول_كلمة_بعد(النص: &نص, البداية: طبيعي, الحد: طبيعي): نص {
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < الحد && فراغ_عند(بايت_عند_إكمال(النص, ف))) { ف := ف + 1; }
    ليكن النهاية: طبيعي = نهاية_معرف_بعد(النص, ف);
    إذا (النهاية > الحد) { أرجع نص_بين(النص, ف, الحد); };
    أرجع نص_بين(النص, ف, النهاية);
}

// Where the first word of the statement that starts at البداية ends.
عرف نهاية_أول_كلمة(النص: &نص, البداية: طبيعي, الحد: طبيعي): طبيعي {
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < الحد && فراغ_عند(بايت_عند_إكمال(النص, ف))) { ف := ف + 1; }
    ليكن النهاية: طبيعي = نهاية_معرف_بعد(النص, ف);
    إذا (النهاية > الحد) { أرجع الحد; };
    أرجع النهاية;
}

// Where الكلمة first appears as a whole word between البداية and الحد.
عرف موضع_كلمة_بين(النص: &نص, البداية: طبيعي, الحد: طبيعي, الكلمة: &نص): اختياري طبيعي {
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < الحد) {
        إذا (محرف_معرف_عند(النص, ف)) {
            ليكن النهاية: طبيعي = نهاية_معرف_بعد(النص, ف);
            ليكن المقطع: نص = نص_بين(النص, ف, النهاية);
            إذا (نصان_متساويان(&المقطع, الكلمة)) { أرجع اختياري.موجود(ف); };
            ف := النهاية;
        } وإلا {
            ف := ف + 1;
        };
    }
    أرجع اختياري.لا_شيء();
}

// Whether الكلمة appears as a whole word between البداية and الحد.
عرف كلمة_بين(النص: &نص, البداية: طبيعي, الحد: طبيعي, الكلمة: &نص): منطقي {
    طابق موضع_كلمة_بين(النص, البداية, الحد, الكلمة) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف كلمة_استيراد(الكلمة: &نص): منطقي {
    أرجع نصان_متساويان(الكلمة, &«import») || نصان_متساويان(الكلمة, &«استورد»);
}

عرف كلمة_من(الكلمة: &نص): منطقي {
    أرجع نصان_متساويان(الكلمة, &«from») || نصان_متساويان(الكلمة, &«من»);
}

عرف كلمة_دع(الكلمة: &نص): منطقي {
    أرجع نصان_متساويان(الكلمة, &«let») || نصان_متساويان(الكلمة, &«ليكن»);
}

عرف كلمة_مطابقة(الكلمة: &نص): منطقي {
    أرجع نصان_متساويان(الكلمة, &«match») || نصان_متساويان(الكلمة, &«طابق»);
}

// A declaration of a function or a Type (`def`, `type`, after `public` too):
// its `:`s are followed by Types.
عرف عبارة_تصريح_إكمال(النص: &نص, البداية: طبيعي, الحد: طبيعي, الأولى: &نص): منطقي {
    إذا (نصان_متساويان(الأولى, &«def») || نصان_متساويان(الأولى, &«عرف»)
        || نصان_متساويان(الأولى, &«type») || نصان_متساويان(الأولى, &«نوع»)) {
        أرجع صواب;
    };
    إذا (نصان_متساويان(الأولى, &«public») || نصان_متساويان(الأولى, &«عام»)) {
        أرجع كلمة_بين(النص, البداية, الحد, &«def») || كلمة_بين(النص, البداية, الحد, &«عرف»)
            || كلمة_بين(النص, البداية, الحد, &«type») || كلمة_بين(النص, البداية, الحد, &«نوع»);
    };
    أرجع خطأ;
}

// The kind of the `{` at الموضع (قوس_مفتوح_إكمال.الصنف): after `=`, `(`,
// `,`, `[`, `:` or `return` it opens a record literal, after `->` a match
// arm's or a closure's body, otherwise a block.
عرف صنف_معقوف_إكمال(النص: &نص, الموضع: طبيعي): ط8 {
    طابق آخر_غير_فراغ_قبل(النص, الموضع, 0) مع
    | اختياري.لا_شيء -> { أرجع 1; }
    | اختياري.موجود(السابق) -> {
        ليكن البايت: ط8 = بايت_عند_إكمال(النص, السابق);
        إذا (البايت == 0x3D || البايت == 0x28 || البايت == 0x2C || البايت == 0x5B || البايت == 0x3A) {
            أرجع 0;
        };
        إذا (البايت == 0x3E && السابق > 0 && بايت_عند_إكمال(النص, السابق - 1) == 0x2D) { أرجع 2; };
        ليكن الكلمة: نص = نص_بين(النص, بداية_معرف_قبل(النص, السابق + 1), السابق + 1);
        إذا (نصان_متساويان(&الكلمة, &«return») || نصان_متساويان(&الكلمة, &«أرجع»)) { أرجع 0; };
        أرجع 1;
    };
}

// The opening bracket that the one at الغالق closes, from الحد on.
عرف فاتح_مطابق_قبل(النص: &نص, الغالق: طبيعي, الحد: طبيعي): اختياري طبيعي {
    ليكن العمق: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = الغالق + 1;
    طالما (ف > الحد) {
        ف := ف - 1;
        ليكن البايت: ط8 = بايت_عند_إكمال(النص, ف);
        إذا (البايت == 0x29 || البايت == 0x5D || البايت == 0x7D) { العمق := العمق + 1; };
        إذا (البايت == 0x28 || البايت == 0x5B || البايت == 0x7B) {
            إذا (العمق == 0) { أرجع اختياري.لا_شيء(); };
            العمق := العمق - 1;
            إذا (العمق == 0) { أرجع اختياري.موجود(ف); };
        };
    }
    أرجع اختياري.لا_شيء();
}

// Right after the bracket that closes the one at الفاتح.
عرف بعد_غالق_مطابق(النص: &نص, الفاتح: طبيعي): طبيعي {
    ليكن الحالة: متغير حالة_مسح_إكمال = حالة_مسح_أولى_إكمال();
    ليكن العمق: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = الفاتح;
    ليكن الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    طالما (ف < الطول_الكلي) {
        إذا (حالة_عادية_إكمال(&الحالة)) {
            ليكن البايت: ط8 = بايت_عند_إكمال(النص, ف);
            إذا (البايت == 0x28 || البايت == 0x5B || البايت == 0x7B) { العمق := العمق + 1; };
            إذا (البايت == 0x29 || البايت == 0x5D || البايت == 0x7D) {
                إذا (العمق > 0) { العمق := العمق - 1; };
                إذا (العمق == 0) { أرجع ف + 1; };
            };
        };
        ف := ف + تقدم_مسح_إكمال(النص, ف, &متغير الحالة);
    }
    أرجع الطول_الكلي;
}

// The start of the receiver expression that ends at النهاية (a `.` follows
// it), from الحد on: names joined by `.`, each maybe followed by calls and
// indexes, or a bracketed expression (`make().inner`, `(*r)`, `arr[0]`).
// النهاية when there is none.
عرف بداية_مستقبل_قبل(النص: &نص, النهاية: طبيعي, الحد: طبيعي): طبيعي {
    ليكن ف: متغير طبيعي = النهاية;
    ليكن بعد_نقطة: متغير منطقي = خطأ;
    طالما (ف > الحد) {
        ليكن البايت: ط8 = بايت_عند_إكمال(النص, ف - 1);
        إذا (البايت == 0x29 || البايت == 0x5D) {
            طابق فاتح_مطابق_قبل(النص, ف - 1, الحد) مع
            | اختياري.لا_شيء -> { أرجع النهاية; }
            | اختياري.موجود(الفاتح) -> { ف := الفاتح; };
            بعد_نقطة := خطأ;
        } وإلا {
            ليكن البداية: طبيعي = بداية_معرف_قبل(النص, ف);
            إذا (البداية == ف || البداية < الحد) {
                إذا (بعد_نقطة) { أرجع النهاية; };
                أرجع ف;
            };
            ف := البداية;
            إذا (ف > الحد && بايت_عند_إكمال(النص, ف - 1) == 0x2E) {
                ف := ف - 1;
                بعد_نقطة := صواب;
            } وإلا {
                أرجع ف;
            };
        };
    }
    إذا (بعد_نقطة) { أرجع النهاية; };
    أرجع ف;
}

// The names followed by `:` at the top of a record literal between البداية
// and الحد: the fields already written.
عرف حقول_مكتوبة_إكمال(النص: &نص, البداية: طبيعي, الحد: طبيعي): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن الحالة: متغير حالة_مسح_إكمال = حالة_مسح_أولى_إكمال();
    ليكن العمق: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < الحد) {
        ليكن يتقدم: متغير منطقي = صواب;
        إذا (حالة_عادية_إكمال(&الحالة)) {
            ليكن البايت: ط8 = بايت_عند_إكمال(النص, ف);
            إذا (البايت == 0x28 || البايت == 0x5B || البايت == 0x7B) { العمق := العمق + 1; };
            إذا ((البايت == 0x29 || البايت == 0x5D || البايت == 0x7D) && العمق > 0) { العمق := العمق - 1; };
            إذا (العمق == 0 && محرف_معرف_عند(النص, ف)) {
                ليكن النهاية: طبيعي = نهاية_معرف_بعد(النص, ف);
                ليكن ب: متغير طبيعي = النهاية;
                طالما (ب < الحد && فراغ_عند(بايت_عند_إكمال(النص, ب))) { ب := ب + 1; }
                إذا (ب < الحد && بايت_عند_إكمال(النص, ب) == 0x3A && بايت_عند_إكمال(النص, ب + 1) != 0x3D) {
                    ألحق(الناتج, نص_بين(النص, ف, النهاية));
                };
                ف := النهاية;
                يتقدم := خطأ;
            };
        };
        إذا (يتقدم) { ف := ف + تقدم_مسح_إكمال(النص, ف, &متغير الحالة); };
    }
    أرجع الناتج;
}

// A pattern as written, without its payload (`Shape.Pair` for
// `Shape.Pair(_, _)`), when it is not empty.
عرف ألحق_نمطا_مكتوبا(النص: &نص, البداية: طبيعي, النهاية: طبيعي, الناتج: &متغير متجه نص): فراغ {
    ليكن النمط: نص = نص_مقصوص_بين(النص, البداية, النهاية);
    إذا ((الطول(النمط) مثل طبيعي) > 0) { ألحق(*الناتج, النمط); };
}

// The patterns of the arms written between البداية (after `with`) and الحد:
// each `| pattern ->`, an or-pattern's alternatives each on its own.
عرف أنماط_مكتوبة_إكمال(النص: &نص, البداية: طبيعي, الحد: طبيعي): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن الحالة: متغير حالة_مسح_إكمال = حالة_مسح_أولى_إكمال();
    ليكن العمق: متغير طبيعي = 0;
    ليكن في_نمط: متغير منطقي = خطأ;
    ليكن بداية_النمط: متغير طبيعي = البداية;
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < الحد) {
        إذا (حالة_عادية_إكمال(&الحالة)) {
            ليكن البايت: ط8 = بايت_عند_إكمال(النص, ف);
            إذا (البايت == 0x28 || البايت == 0x5B || البايت == 0x7B) {
                إذا (العمق == 0 && في_نمط) {
                    ألحق_نمطا_مكتوبا(النص, بداية_النمط, ف, &متغير الناتج);
                    في_نمط := خطأ;
                };
                العمق := العمق + 1;
            };
            إذا ((البايت == 0x29 || البايت == 0x5D || البايت == 0x7D) && العمق > 0) { العمق := العمق - 1; };
            إذا (العمق == 0 && البايت == 0x7C) {
                إذا (في_نمط) { ألحق_نمطا_مكتوبا(النص, بداية_النمط, ف, &متغير الناتج); };
                في_نمط := صواب;
                بداية_النمط := ف + 1;
            };
            إذا (العمق == 0 && البايت == 0x2D && بايت_عند_إكمال(النص, ف + 1) == 0x3E) {
                إذا (في_نمط) { ألحق_نمطا_مكتوبا(النص, بداية_النمط, ف, &متغير الناتج); };
                في_نمط := خطأ;
            };
        };
        ف := ف + تقدم_مسح_إكمال(النص, ف, &متغير الحالة);
    }
    إذا (في_نمط) { ألحق_نمطا_مكتوبا(النص, بداية_النمط, الحد, &متغير الناتج); };
    أرجع الناتج;
}

// The `,`s at the top of the bracket that opens at الفاتح, up to الحد: the
// argument's position.
عرف فواصل_قبل_إكمال(النص: &نص, الفاتح: طبيعي, الحد: طبيعي): طبيعي {
    ليكن العدد: متغير طبيعي = 0;
    ليكن الحالة: متغير حالة_مسح_إكمال = حالة_مسح_أولى_إكمال();
    ليكن العمق: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = الفاتح + 1;
    طالما (ف < الحد) {
        إذا (حالة_عادية_إكمال(&الحالة)) {
            ليكن البايت: ط8 = بايت_عند_إكمال(النص, ف);
            إذا (البايت == 0x28 || البايت == 0x5B || البايت == 0x7B) { العمق := العمق + 1; };
            إذا ((البايت == 0x29 || البايت == 0x5D || البايت == 0x7D) && العمق > 0) { العمق := العمق - 1; };
            إذا (البايت == 0x2C && العمق == 0) { العدد := العدد + 1; };
        };
        ف := ف + تقدم_مسح_إكمال(النص, ف, &متغير الحالة);
    }
    أرجع العدد;
}

// Where the statement the cursor is in ends, scanning from البداية with the
// statement's brackets المفتوحة still open (their closers, outermost first):
// after its `;` outside braces, at a closing bracket that closes an enclosing
// one (not included), or at the end. A closer of another kind than the
// innermost open bracket's means that bracket was never closed: the
// enclosing one closes there.
عرف نهاية_العبارة_بعد(النص: &نص, البداية: طبيعي, المفتوحة: &متجه ط8): طبيعي {
    ليكن الحالة: متغير حالة_مسح_إكمال = حالة_مسح_أولى_إكمال();
    ليكن المكدس: متغير متجه ط8 = [];
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول(*المفتوحة) مثل طبيعي)) { ألحق(المكدس, (*المفتوحة)[ر]); ر := ر + 1; }
    ليكن العمق: متغير طبيعي = الطول(المكدس) مثل طبيعي;
    ليكن ف: متغير طبيعي = البداية;
    ليكن الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    طالما (ف < الطول_الكلي) {
        إذا (حالة_عادية_إكمال(&الحالة)) {
            ليكن البايت: ط8 = بايت_عند_إكمال(النص, ف);
            إذا (البايت == 0x3B) {
                إذا (العمق == 0) { أرجع ف + 1; };
                إذا (المكدس[العمق - 1] != 0x7D) { أرجع ف + 1; };
            };
            ليكن الغالق: متغير ط8 = 0;
            إذا (البايت == 0x28) { الغالق := 0x29; };
            إذا (البايت == 0x5B) { الغالق := 0x5D; };
            إذا (البايت == 0x7B) { الغالق := 0x7D; };
            إذا (الغالق != 0) {
                إذا (العمق < (الطول(المكدس) مثل طبيعي)) { المكدس[العمق] := الغالق; }
                وإلا { ألحق(المكدس, الغالق); };
                العمق := العمق + 1;
            };
            إذا (البايت == 0x29 || البايت == 0x5D || البايت == 0x7D) {
                إذا (العمق == 0) { أرجع ف; };
                إذا (المكدس[العمق - 1] != البايت) { أرجع ف; };
                العمق := العمق - 1;
            };
        };
        ف := ف + تقدم_مسح_إكمال(النص, ف, &متغير الحالة);
    }
    أرجع الطول_الكلي;
}

// The closers for the brackets left open in النص, innermost first.
عرف أغلق_الأقواس_المفتوحة(النص: &متغير متجه ط8): فراغ {
    ليكن المؤقت: نص = من_بايتات(النص);
    // A stack: the first العمق entries are the open brackets' closers.
    ليكن المفتوحة: متغير متجه ط8 = [];
    ليكن العمق: متغير طبيعي = 0;
    ليكن الحالة: متغير حالة_مسح_إكمال = حالة_مسح_أولى_إكمال();
    ليكن ف: متغير طبيعي = 0;
    ليكن الطول_الكلي: طبيعي = الطول(المؤقت) مثل طبيعي;
    طالما (ف < الطول_الكلي) {
        إذا (حالة_عادية_إكمال(&الحالة)) {
            ليكن البايت: ط8 = بايت_عند_إكمال(&المؤقت, ف);
            ليكن الغالق: متغير ط8 = 0;
            إذا (البايت == 0x28) { الغالق := 0x29; };
            إذا (البايت == 0x5B) { الغالق := 0x5D; };
            إذا (البايت == 0x7B) { الغالق := 0x7D; };
            إذا (الغالق != 0) {
                إذا (العمق < (الطول(المفتوحة) مثل طبيعي)) { المفتوحة[العمق] := الغالق; }
                وإلا { ألحق(المفتوحة, الغالق); };
                العمق := العمق + 1;
            };
            إذا ((البايت == 0x29 || البايت == 0x5D || البايت == 0x7D) && العمق > 0) {
                العمق := العمق - 1;
            };
        };
        ف := ف + تقدم_مسح_إكمال(&المؤقت, ف, &متغير الحالة);
    }
    ألحق(*النص, 0x0A);
    طالما (العمق > 0) {
        العمق := العمق - 1;
        ألحق(*النص, المفتوحة[العمق]);
        ألحق(*النص, 0x0A);
    }
}

// The dotted path right after the first word (`from`) of a statement.
عرف مسار_بعد_من(النص: &نص, البداية: طبيعي, الحد: طبيعي): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < الحد && فراغ_عند(بايت_عند_إكمال(النص, ف))) { ف := ف + 1; }
    ف := نهاية_معرف_بعد(النص, ف);
    طالما (ف < الحد && فراغ_عند(بايت_عند_إكمال(النص, ف))) { ف := ف + 1; }
    ليكن تابع: متغير منطقي = صواب;
    طالما (تابع && ف < الحد) {
        ليكن النهاية: طبيعي = نهاية_معرف_بعد(النص, ف);
        إذا (النهاية == ف) { تابع := خطأ; }
        وإلا {
            ألحق(الناتج, نص_بين(النص, ف, النهاية));
            ف := النهاية;
            إذا (ف < الحد && بايت_عند_إكمال(النص, ف) == 0x2E) { ف := ف + 1; } وإلا { تابع := خطأ; };
        };
    }
    أرجع الناتج;
}

// A record literal of the Type a `let` declares (`let o: Inner = { |`, or a
// literal nested in a field of it: `let o: Outer = { inner: { |`), with the
// cursor where a field name goes. داخل holds the statement's open brackets,
// outermost first; the written Type, the fields leading to the innermost
// literal and the fields it already has are returned through the last three.
عرف سياق_حقل_سجل_إكمال(
    النص: &نص,
    بداية_العبارة: طبيعي,
    بداية_الكلمة: طبيعي,
    داخل: &متجه قوس_مفتوح_إكمال,
    النوع_المكتوب: &متغير نص,
    المسار: &متغير متجه نص,
    المكتوبة: &متغير متجه نص
): منطقي {
    ليكن العدد: طبيعي = الطول(*داخل) مثل طبيعي;
    إذا (العدد == 0) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا ((*داخل)[ف].البايت != 0x7B || (*داخل)[ف].الصنف != 0) { أرجع خطأ; };
        ف := ف + 1;
    }
    // `let NAME: TYPE = {`
    ليكن الأول: طبيعي = (*داخل)[0].الموضع;
    ليكن المساواة: متغير طبيعي = 0;
    طابق آخر_غير_فراغ_قبل(النص, الأول, بداية_العبارة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(السابق) -> {
        إذا (بايت_عند_إكمال(النص, السابق) != 0x3D) { أرجع خطأ; };
        المساواة := السابق;
    };
    ليكن النقطتان: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن م: متغير طبيعي = بداية_العبارة;
    طالما (م < المساواة) {
        إذا (بايت_عند_إكمال(النص, م) == 0x3A) {
            النقطتان := اختياري.موجود(م);
            م := المساواة;
        } وإلا {
            م := م + 1;
        };
    }
    طابق النقطتان مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الموضع) -> {
        *النوع_المكتوب := نص_مقصوص_بين(النص, الموضع + 1, المساواة);
    };
    // Each nested `{` follows `field:`.
    ف := 1;
    طالما (ف < العدد) {
        طابق آخر_غير_فراغ_قبل(النص, (*داخل)[ف].الموضع, (*داخل)[ف - 1].الموضع + 1) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(السابق) -> {
            إذا (بايت_عند_إكمال(النص, السابق) != 0x3A) { أرجع خطأ; };
            طابق آخر_غير_فراغ_قبل(النص, السابق, (*داخل)[ف - 1].الموضع + 1) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(نهاية_الاسم) -> {
                ليكن بداية_الاسم: طبيعي = بداية_معرف_قبل(النص, نهاية_الاسم + 1);
                إذا (بداية_الاسم > نهاية_الاسم) { أرجع خطأ; };
                ألحق(*المسار, نص_بين(النص, بداية_الاسم, نهاية_الاسم + 1));
            };
        };
        ف := ف + 1;
    }
    *المكتوبة := حقول_مكتوبة_إكمال(النص, (*داخل)[العدد - 1].الموضع + 1, بداية_الكلمة);
    أرجع صواب;
}

// Whether البداية is in a match arm's pattern: the statement is a match, a
// `|` (not `||`) follows its `with` (`مع`), and no `->` comes between the
// last such `|` and البداية (`| Color.`, `| Shape.Tinted(Color.`, but not
// `| Color.Red -> { let c: Color = Color.`).
عرف موضع_نمط_إكمال(النص: &نص, بداية_العبارة: طبيعي, البداية: طبيعي, الأولى: &نص): منطقي {
    إذا (!كلمة_مطابقة(الأولى)) { أرجع خطأ; };
    ليكن موضع_مع: متغير اختياري طبيعي = موضع_كلمة_بين(النص, بداية_العبارة, البداية, &«with»);
    إذا (نصان_متساويان(الأولى, &«طابق»)) {
        موضع_مع := موضع_كلمة_بين(النص, بداية_العبارة, البداية, &«مع»);
    };
    طابق موضع_مع مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الموضع) -> {
        ليكن في_نمط: متغير منطقي = خطأ;
        ليكن ف: متغير طبيعي = الموضع;
        طالما (ف < البداية) {
            ليكن البايت: ط8 = بايت_عند_إكمال(النص, ف);
            إذا (البايت == 0x7C) {
                ليكن قبله: منطقي = ف > 0 && بايت_عند_إكمال(النص, ف - 1) == 0x7C;
                ليكن بعده: منطقي = ف + 1 < البداية && بايت_عند_إكمال(النص, ف + 1) == 0x7C;
                إذا (!قبله && !بعده) { في_نمط := صواب; };
            };
            إذا (البايت == 0x2D && ف + 1 < البداية && بايت_عند_إكمال(النص, ف + 1) == 0x3E) {
                في_نمط := خطأ;
            };
            ف := ف + 1;
        }
        أرجع في_نمط;
    };
}

عام عرف رقع_مصدر_للإكمال(النص: &نص, البايت: طبيعي): رقعة_إكمال {
    ليكن الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن المؤشر: متغير طبيعي = البايت;
    إذا (المؤشر > الطول_الكلي) { المؤشر := الطول_الكلي; };
    // Scan to the cursor: the lexical state there, the start of the statement
    // the cursor is in and the brackets open at the cursor (outside strings
    // and comments). A statement starts after `;` and at a block's `{` and
    // `}`; a record literal's braces and a match arm's body (`-> { … }`)
    // leave the statement around them going on.
    ليكن الحالة: متغير حالة_مسح_إكمال = حالة_مسح_أولى_إكمال();
    ليكن بداية_العبارة: متغير طبيعي = 0;
    ليكن المفتوحة: متغير متجه قوس_مفتوح_إكمال = [];
    ليكن العمق: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < المؤشر) {
        إذا (حالة_عادية_إكمال(&الحالة)) {
            ليكن البايت_الحالي: ط8 = بايت_عند_إكمال(النص, ف);
            إذا (البايت_الحالي == 0x3B) { بداية_العبارة := ف + 1; };
            إذا (البايت_الحالي == 0x28 || البايت_الحالي == 0x5B || البايت_الحالي == 0x7B) {
                ليكن الصنف: متغير ط8 = 0;
                إذا (البايت_الحالي == 0x7B) { الصنف := صنف_معقوف_إكمال(النص, ف); };
                ليكن القوس: قوس_مفتوح_إكمال = {
                    البايت: البايت_الحالي, الموضع: ف, بداية_العبارة: بداية_العبارة, الصنف: الصنف
                };
                إذا (العمق < (الطول(المفتوحة) مثل طبيعي)) { المفتوحة[العمق] := القوس; }
                وإلا { ألحق(المفتوحة, القوس); };
                العمق := العمق + 1;
                إذا (الصنف != 0) { بداية_العبارة := ف + 1; };
            };
            إذا (البايت_الحالي == 0x29 || البايت_الحالي == 0x5D || البايت_الحالي == 0x7D) {
                إذا (العمق > 0) {
                    العمق := العمق - 1;
                    ليكن صنف_المغلق: ط8 = المفتوحة[العمق].الصنف;
                    إذا (صنف_المغلق == 1) { بداية_العبارة := ف + 1; };
                    إذا (صنف_المغلق == 2) { بداية_العبارة := المفتوحة[العمق].بداية_العبارة; };
                } وإلا {
                    إذا (البايت_الحالي == 0x7D) { بداية_العبارة := ف + 1; };
                };
            };
        };
        ف := ف + تقدم_مسح_إكمال(النص, ف, &متغير الحالة);
    }
    ليكن بداية_الكلمة: طبيعي = بداية_معرف_قبل(النص, المؤشر);
    ليكن المسار: متغير متجه نص = [];
    ليكن الأصل: نص = انسخ_نص(النص);
    ليكن إنجليزية: منطقي = شفرة_بسطح_إنجليزي(النص);
    ليكن الفارغة: رقعة_إكمال = {
        السياق: سياق_إكمال.لا_شيء(),
        بداية_الكلمة: بداية_الكلمة,
        المسار: [],
        النص: الأصل,
        البايت: المؤشر,
        التعبير: «»,
        النوع_المكتوب: «»,
        ترتيب_المعامل: 0,
        المكتوبة: [],
        إنجليزية: إنجليزية,
        في_نمط: خطأ
    };
    إذا (!حالة_عادية_إكمال(&الحالة)) { أرجع الفارغة; };
    // A number being typed.
    ليكن أول_بايت: ط8 = بايت_عند_إكمال(النص, بداية_الكلمة);
    إذا (بداية_الكلمة < المؤشر && أول_بايت >= 0x30 && أول_بايت <= 0x39) { أرجع الفارغة; };
    // The brackets open in the statement, outermost first.
    ليكن داخل_العبارة: متغير متجه قوس_مفتوح_إكمال = [];
    ليكن ق: متغير طبيعي = 0;
    طالما (ق < العمق) {
        إذا (المفتوحة[ق].الموضع >= بداية_العبارة) {
            ليكن النسخة: قوس_مفتوح_إكمال = {
                البايت: المفتوحة[ق].البايت,
                الموضع: المفتوحة[ق].الموضع,
                بداية_العبارة: المفتوحة[ق].بداية_العبارة,
                الصنف: المفتوحة[ق].الصنف
            };
            ألحق(داخل_العبارة, النسخة);
        };
        ق := ق + 1;
    }
    // The dotted path before the word: identifiers joined by `.`; or the
    // whole receiver expression when a call, an index or brackets end it.
    ليكن بداية_المسار: متغير طبيعي = بداية_الكلمة;
    ليكن مسار_صالح: متغير منطقي = صواب;
    ليكن التعبير: متغير نص = «»;
    ليكن المقلوب: متغير متجه نص = [];
    طالما (بداية_المسار > 0 && بايت_عند_إكمال(النص, بداية_المسار - 1) == 0x2E && مسار_صالح
        && (الطول(التعبير) مثل طبيعي) == 0) {
        ليكن النهاية: طبيعي = بداية_المسار - 1;
        ليكن البداية: طبيعي = بداية_معرف_قبل(النص, النهاية);
        إذا (البداية == النهاية) {
            // `make().`, `(*r).`, `arr[0].`, `make().inner.`
            ليكن بداية_المستقبل: طبيعي = بداية_مستقبل_قبل(النص, النهاية, بداية_العبارة);
            إذا (بداية_المستقبل < النهاية) {
                التعبير := نص_بين(النص, بداية_المستقبل, بداية_الكلمة - 1);
                بداية_المسار := بداية_المستقبل;
            } وإلا {
                مسار_صالح := خطأ;
            };
        } وإلا {
            ألحق(المقلوب, نص_بين(النص, البداية, النهاية));
            بداية_المسار := البداية;
        };
    }
    إذا (!مسار_صالح) { أرجع الفارغة; };
    إذا ((الطول(التعبير) مثل طبيعي) == 0) {
        ليكن ر: متغير طبيعي = الطول(المقلوب) مثل طبيعي;
        طالما (ر > 0) {
            ر := ر - 1;
            ألحق(المسار, انسخ_نص(&المقلوب[ر]));
        }
    };
    // An import statement: its path, or (after `import` in a `from`
    // statement) the names of the module.
    ليكن الأولى: نص = أول_كلمة_بعد(النص, بداية_العبارة, بداية_المسار);
    ليكن السياق: متغير سياق_إكمال = سياق_إكمال.اسم();
    إذا ((الطول(المسار) مثل طبيعي) > 0 || (الطول(التعبير) مثل طبيعي) > 0) {
        السياق := سياق_إكمال.عضو_قيمة();
    };
    إذا (كلمة_استيراد(&الأولى)) {
        السياق := سياق_إكمال.مسار_استيراد();
    } وإلا إذا (كلمة_من(&الأولى)) {
        إذا (كلمة_بين(النص, بداية_العبارة, بداية_المسار, &«import»)
            || كلمة_بين(النص, بداية_العبارة, بداية_المسار, &«استورد»)) {
            // `from a.b import |`: the path is the module after `from`.
            السياق := سياق_إكمال.مسار_وحدة();
            المسار := مسار_بعد_من(النص, بداية_العبارة, بداية_المسار);
        } وإلا {
            السياق := سياق_إكمال.مسار_استيراد();
        };
    };
    // `| Color.`: the path is in a match arm's pattern.
    ليكن في_نمط: منطقي = (الطول(المسار) مثل طبيعي) > 0
        && موضع_نمط_إكمال(النص, بداية_العبارة, بداية_المسار, &الأولى);
    // A bare name: the place in the statement may say more.
    ليكن النوع_المكتوب: متغير نص = «»;
    ليكن ترتيب_المعامل: متغير طبيعي = 0;
    ليكن المكتوبة: متغير متجه نص = [];
    إذا (السياق == سياق_إكمال.اسم()) {
        ليكن موضع_السابق: متغير طبيعي = 0;
        ليكن البايت_السابق: متغير ط8 = 0;
        طابق آخر_غير_فراغ_قبل(النص, بداية_الكلمة, بداية_العبارة) مع
        | اختياري.موجود(السابق) -> {
            موضع_السابق := السابق;
            البايت_السابق := بايت_عند_إكمال(النص, السابق);
        }
        | اختياري.لا_شيء -> { };
        ليكن عدد_الداخل: طبيعي = الطول(داخل_العبارة) مثل طبيعي;
        إذا (كلمة_مطابقة(&الأولى) && البايت_السابق == 0x7C) {
            // `match c with | |`: the scrutinee between `match` and `with`.
            ليكن موضع_مع: متغير اختياري طبيعي = موضع_كلمة_بين(النص, بداية_العبارة, بداية_الكلمة, &«with»);
            إذا (نصان_متساويان(&الأولى, &«طابق»)) {
                موضع_مع := موضع_كلمة_بين(النص, بداية_العبارة, بداية_الكلمة, &«مع»);
            };
            طابق موضع_مع مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الموضع) -> {
                السياق := سياق_إكمال.حالة_مطابقة();
                التعبير := نص_مقصوص_بين(النص, نهاية_أول_كلمة(النص, بداية_العبارة, الموضع), الموضع);
                المكتوبة := أنماط_مكتوبة_إكمال(النص, نهاية_معرف_بعد(النص, الموضع), بداية_الكلمة);
            };
        } وإلا إذا (البايت_السابق == 0x3A && بايت_عند_إكمال(النص, موضع_السابق + 1) != 0x3D
            && (موضع_السابق == 0 || بايت_عند_إكمال(النص, موضع_السابق - 1) != 0x3A)) {
            // `let x: |` before `=` and outside brackets; a parameter's, a
            // result's or a field's Type in a declaration.
            ليكن في_دع: منطقي = كلمة_دع(&الأولى) && عدد_الداخل == 0;
            ليكن بلا_مساواة: متغير منطقي = صواب;
            ليكن ي: متغير طبيعي = بداية_العبارة;
            طالما (ي < موضع_السابق) {
                إذا (بايت_عند_إكمال(النص, ي) == 0x3D) { بلا_مساواة := خطأ; };
                ي := ي + 1;
            }
            إذا ((في_دع && بلا_مساواة) || عبارة_تصريح_إكمال(النص, بداية_العبارة, موضع_السابق, &الأولى)) {
                السياق := سياق_إكمال.موضع_نوع();
            };
        } وإلا إذا (عدد_الداخل > 0) {
            ليكن الأعمق: طبيعي = داخل_العبارة[عدد_الداخل - 1].الموضع;
            ليكن بايت_الأعمق: ط8 = داخل_العبارة[عدد_الداخل - 1].البايت;
            ليكن بداية_عنصر: منطقي = موضع_السابق == الأعمق || البايت_السابق == 0x2C;
            إذا (بايت_الأعمق == 0x7B && بداية_عنصر) {
                إذا (سياق_حقل_سجل_إكمال(
                    النص, بداية_العبارة, بداية_الكلمة, &داخل_العبارة,
                    &متغير النوع_المكتوب, &متغير المسار, &متغير المكتوبة
                )) {
                    السياق := سياق_إكمال.حقل_سجل();
                } وإلا {
                    المسار := [];
                    المكتوبة := [];
                    النوع_المكتوب := «»;
                };
            };
            إذا (بايت_الأعمق == 0x28 && بداية_عنصر
                && !عبارة_تصريح_إكمال(النص, بداية_العبارة, الأعمق, &الأولى)) {
                // `area(|`, `area(a, |`: the callee right before `(`.
                ليكن بداية_المستدعى: طبيعي = بداية_مستقبل_قبل(النص, الأعمق, بداية_العبارة);
                إذا (بداية_المستدعى < الأعمق) {
                    السياق := سياق_إكمال.معامل_استدعاء();
                    التعبير := نص_بين(النص, بداية_المستدعى, الأعمق);
                    ترتيب_المعامل := فواصل_قبل_إكمال(النص, الأعمق, بداية_الكلمة);
                };
            };
        };
    };
    // The text without the statement, with its open brackets closed.
    ليكن الغوالق: متغير متجه ط8 = [];
    ليكن غ: متغير طبيعي = 0;
    طالما (غ < (الطول(داخل_العبارة) مثل طبيعي)) {
        ليكن الفاتح: ط8 = داخل_العبارة[غ].البايت;
        إذا (الفاتح == 0x28) { ألحق(الغوالق, 0x29); };
        إذا (الفاتح == 0x5B) { ألحق(الغوالق, 0x5D); };
        إذا (الفاتح == 0x7B) { ألحق(الغوالق, 0x7D); };
        غ := غ + 1;
    }
    ليكن نهاية_الكلمة: طبيعي = نهاية_معرف_بعد(النص, المؤشر);
    ليكن النهاية: طبيعي = نهاية_العبارة_بعد(النص, نهاية_الكلمة, &الغوالق);
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن م: متغير طبيعي = 0;
    طالما (م < بداية_العبارة) { ألحق(البايتات, (*النص)[م]); م := م + 1; }
    م := النهاية;
    طالما (م < الطول_الكلي) { ألحق(البايتات, (*النص)[م]); م := م + 1; }
    أغلق_الأقواس_المفتوحة(&متغير البايتات);
    ليكن الرقعة: رقعة_إكمال = {
        السياق: السياق,
        بداية_الكلمة: بداية_الكلمة,
        المسار: المسار,
        النص: من_بايتات(&البايتات),
        البايت: بداية_العبارة,
        التعبير: التعبير,
        النوع_المكتوب: النوع_المكتوب,
        ترتيب_المعامل: ترتيب_المعامل,
        المكتوبة: المكتوبة,
        إنجليزية: إنجليزية,
        في_نمط: في_نمط
    };
    أرجع الرقعة;
}

// ---- Step 2: names and members from the analysis --------------------------------

عرف نص_اسم_إكمال(الأسماء: &سياق_استعلامات_أسماء, الاسم: معرف_اسم): نص {
    إذا ((الاسم.القيمة مثل طبيعي) >= (الطول((*الأسماء).الأسماء) مثل طبيعي)) { أرجع «»; };
    ليكن المكتوبة: &متجه ط8 = &(*الأسماء).الأسماء[الاسم.القيمة].المكتوبة;
    أرجع من_بايتات(المكتوبة);
}

// The name as written or its identity spelling equals النص.
عرف اسم_يطابق_نصا(الأسماء: &سياق_استعلامات_أسماء, الاسم: معرف_اسم, النص: &نص): منطقي {
    إذا ((الاسم.القيمة مثل طبيعي) >= (الطول((*الأسماء).الأسماء) مثل طبيعي)) { أرجع خطأ; };
    ليكن المكتوبة: نص = من_بايتات(&(*الأسماء).الأسماء[الاسم.القيمة].المكتوبة);
    إذا (نصان_متساويان(&المكتوبة, النص)) { أرجع صواب; };
    ليكن الهوية: نص = من_بايتات(&(*الأسماء).الأسماء[الاسم.القيمة].البايتات);
    أرجع نصان_متساويان(&الهوية, النص);
}

عرف وحدة_رمز_إكمال(الأسماء: &سياق_استعلامات_أسماء, الرمز: معرف_رمز): اختياري معرف_وحدة {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*الأسماء).الرموز) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    ليكن النطاق: معرف_نطاق = (*الأسماء).الرموز[الرمز.القيمة].النطاق_المالك;
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*الأسماء).النطاقات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الأسماء).النطاقات[النطاق.القيمة].الوحدة);
}

// 0 a local, 1 a parameter, 2 this module, 3 imported, 4 std (a source under
// a `std` folder).
عرف بعد_رمز_إكمال(
    الواجهة: &نتيجة_واجهة_وحدة,
    الأسماء: &سياق_استعلامات_أسماء,
    الرمز: معرف_رمز,
    وحدة_الموضع: اختياري معرف_وحدة
): طبيعي {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*الأسماء).الرموز) مثل طبيعي)) { أرجع 3; };
    طابق (*الأسماء).الرموز[الرمز.القيمة].النوع مع
    | نوع_تصريح.ربط_محلي -> { أرجع 0; }
    | نوع_تصريح.معامل -> { أرجع 1; }
    | _ -> { };
    طابق وحدة_رمز_إكمال(الأسماء, الرمز) مع
    | اختياري.موجود(الوحدة) -> {
        طابق وحدة_الموضع مع
        | اختياري.موجود(الموضع) -> {
            إذا (معرفا_وحدة_متساويان(الوحدة, الموضع)) { أرجع 2; };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    ليكن المصدر: طبيعي = (*الأسماء).الرموز[الرمز.القيمة].نطاق_الاسم.البداية.المصدر مثل طبيعي;
    طابق اسم_مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختياري.موجود(الاسم) -> {
        إذا (يحتوي_نصا(&الاسم, &«/std/») || يبدأ_بـ(&الاسم, &«std/»)) { أرجع 4; };
    }
    | اختياري.لا_شيء -> { };
    أرجع 3;
}

عرف صنف_رمز_إكمال(النوع: نوع_تصريح): صنف_مرشح {
    طابق النوع مع
    | نوع_تصريح.ربط_محلي -> { أرجع صنف_مرشح.محلي(); }
    | نوع_تصريح.معامل -> { أرجع صنف_مرشح.معامل(); }
    | _ -> { أرجع صنف_مرشح.تصريح(النوع); };
}

عرف رمز_نوع_إكمال(النوع: نوع_تصريح): منطقي {
    طابق النوع مع
    | نوع_تصريح.سجل -> { أرجع صواب; }
    | نوع_تصريح.تعداد -> { أرجع صواب; }
    | نوع_تصريح.مرادف_نوع -> { أرجع صواب; }
    | نوع_تصريح.معتم -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف مرشح_رمز_إكمال(
    الواجهة: &نتيجة_واجهة_وحدة,
    الأسماء: &سياق_استعلامات_أسماء,
    الرمز: معرف_رمز,
    وحدة_الموضع: اختياري معرف_وحدة
): مرشح_إكمال {
    ليكن الاسم: نص = نص_اسم_إكمال(الأسماء, (*الأسماء).الرموز[الرمز.القيمة].الاسم);
    ليكن الصنف: صنف_مرشح = صنف_رمز_إكمال((*الأسماء).الرموز[الرمز.القيمة].النوع);
    ليكن النوع: اختياري معرف_نوع = نوع_رمز_دلالي_عند(&(*الواجهة).سياقات_الأنواع.أنواع_الرموز, الرمز);
    ليكن البعد: طبيعي = بعد_رمز_إكمال(الواجهة, الأسماء, الرمز, وحدة_الموضع);
    ليكن الإدراج: نص = انسخ_نص(&الاسم);
    ليكن المرشح: مرشح_إكمال = {
        الاسم: الاسم, الرمز: اختياري.موجود(الرمز), الصنف: الصنف, النوع: النوع, البعد: البعد,
        اللغة: اختياري.لا_شيء(), الأصلي: اختياري.لا_شيء(), يلائم_المتوقع: خطأ,
        عدد_الحمولات: اختياري.لا_شيء(), في_نمط: خطأ, نص_الإدراج: الإدراج
    };
    أرجع المرشح;
}

// A candidate the analysis has no Symbol for (a builtin Type or constructor,
// a match arm's pattern).
عرف مرشح_بلا_رمز_إكمال(
    الاسم: نص,
    الرمز: اختياري معرف_رمز,
    الصنف: صنف_مرشح,
    النوع: اختياري معرف_نوع,
    البعد: طبيعي
): مرشح_إكمال {
    ليكن الإدراج: نص = انسخ_نص(&الاسم);
    ليكن المرشح: مرشح_إكمال = {
        الاسم: الاسم, الرمز: الرمز, الصنف: الصنف, النوع: النوع, البعد: البعد,
        اللغة: اختياري.لا_شيء(), الأصلي: اختياري.لا_شيء(), يلائم_المتوقع: خطأ,
        عدد_الحمولات: اختياري.لا_شيء(), في_نمط: خطأ, نص_الإدراج: الإدراج
    };
    أرجع المرشح;
}

// Through references to the Type they refer to.
عرف نوع_بلا_مراجع_إكمال(الأنواع: &سجل_أنواع, النوع: معرف_نوع): معرف_نوع {
    ليكن الحالي: متغير معرف_نوع = النوع;
    ليكن العمق: متغير طبيعي = 0;
    طالما (العمق < 8) {
        طابق نوع_داخل_مرجع_دلالي(الأنواع, الحالي) مع
        | اختياري.موجود(الداخل) -> { الحالي := الداخل; }
        | اختياري.لا_شيء -> {
            طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, الحالي) مع
            | اختياري.موجود(الداخل) -> { الحالي := الداخل; }
            | اختياري.لا_شيء -> { أرجع الحالي; };
        };
        العمق := العمق + 1;
    }
    أرجع الحالي;
}

// A value's Type through references and without `mutable`.
عرف نوع_قيمة_إكمال(الأنواع: &سجل_أنواع, النوع: معرف_نوع): معرف_نوع {
    ليكن بلا_مراجع: معرف_نوع = نوع_بلا_مراجع_إكمال(الأنواع, النوع);
    طابق معرف_نوع_أساس_عند(الأنواع, بلا_مراجع) مع
    | اختياري.موجود(الأساس) -> { أرجع الأساس; }
    | اختياري.لا_شيء -> { أرجع بلا_مراجع; };
}

// What `*` of a value of النوع reads: a reference's or a pointer's target.
عرف نوع_مشار_إليه_إكمال(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري معرف_نوع {
    طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(الداخل); }
    | اختياري.لا_شيء -> { };
    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(الداخل); }
    | اختياري.لا_شيء -> { };
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(الداخل) -> { أرجع اختياري.موجود(الداخل); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// The Type of the field named الاسم of a record Type.
عرف نوع_حقل_بالنص_إكمال(
    الأنواع: &سجل_أنواع,
    الأسماء: &سياق_استعلامات_أسماء,
    النوع: معرف_نوع,
    الاسم: &نص
): اختياري معرف_نوع {
    طابق عدد_حقول_سجل(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(العدد) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق حقل_سجل_عند(الأنواع, النوع, ف) مع
            | اختياري.موجود(الحقل) -> {
                إذا (اسم_يطابق_نصا(الأسماء, الحقل.الاسم, الاسم)) { أرجع اختياري.موجود(الحقل.النوع); };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

// Whether a field is among the names written (as written or by identity).
عرف حقل_مكتوب_إكمال(الأسماء: &سياق_استعلامات_أسماء, الاسم: معرف_اسم, المكتوبة: &متجه نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المكتوبة) مثل طبيعي)) {
        إذا (اسم_يطابق_نصا(الأسماء, الاسم, &(*المكتوبة)[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// A record Type's fields, in declaration order, but those in المكتوبة.
عرف أضف_حقول_ناقصة_إكمال(
    الأنواع: &سجل_أنواع,
    الأسماء: &سياق_استعلامات_أسماء,
    النوع: معرف_نوع,
    المكتوبة: &متجه نص,
    الناتج: &متغير متجه مرشح_إكمال
): فراغ {
    طابق عدد_حقول_سجل(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(العدد) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق حقل_سجل_عند(الأنواع, النوع, ف) مع
            | اختياري.موجود(الحقل) -> {
                إذا (!حقل_مكتوب_إكمال(الأسماء, الحقل.الاسم, المكتوبة)) {
                    ألحق(*الناتج, مرشح_بلا_رمز_إكمال(
                        نص_اسم_إكمال(الأسماء, الحقل.الاسم), اختياري.لا_شيء(), صنف_مرشح.حقل(),
                        اختياري.موجود(الحقل.النوع), 2
                    ));
                };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
    };
}

// A record Type's fields, in declaration order.
عرف أضف_حقول_إكمال(
    الأنواع: &سجل_أنواع,
    الأسماء: &سياق_استعلامات_أسماء,
    النوع: معرف_نوع,
    الناتج: &متغير متجه مرشح_إكمال
): فراغ {
    ليكن بلا_مكتوبة: متجه نص = [];
    أضف_حقول_ناقصة_إكمال(الأنواع, الأسماء, النوع, &بلا_مكتوبة, الناتج);
}

// What a constructor candidate inserts: a call in a value position (`Red()`
// without payloads, `Circle(` with them), its name in a pattern position.
عرف نص_إدراج_منشئ_إكمال(الاسم: &نص, عدد_الحمولات: طبيعي, في_نمط: منطقي): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(الاسم));
    إذا (!في_نمط) {
        ألحق(البايتات, 0x28);
        إذا (عدد_الحمولات == 0) { ألحق(البايتات, 0x29); };
    };
    أرجع من_بايتات(&البايتات);
}

// A constructor candidate with its payload count and the text it inserts.
عرف مرشح_منشئ_إكمال(المرشح: مرشح_إكمال, عدد_الحمولات: طبيعي, في_نمط: منطقي): مرشح_إكمال {
    ليكن الإدراج: نص = نص_إدراج_منشئ_إكمال(&المرشح.الاسم, عدد_الحمولات, في_نمط);
    ليكن الناتج: متغير مرشح_إكمال = المرشح;
    الناتج.عدد_الحمولات := اختياري.موجود(عدد_الحمولات);
    الناتج.في_نمط := في_نمط;
    الناتج.نص_الإدراج := الإدراج;
    أرجع الناتج;
}

// The payload count of the enum constructor Symbol الرمز of the enum Symbol
// المالك; 0 when the analysis has no Type for it.
عرف عدد_حمولات_منشئ_إكمال(الأنواع: &سجل_أنواع, المالك: معرف_رمز, الرمز: معرف_رمز): طبيعي {
    طابق معرف_نوع_مسمى_عند(&(*الأنواع).المسماة, المالك) مع
    | اختياري.لا_شيء -> { أرجع 0; }
    | اختياري.موجود(النوع) -> {
        طابق ابحث_منشئ_نوع(الأنواع, النوع, هوية_منشئ_نوع.تعداد(الرمز)) مع
        | اختياري.موجود(المنشئ) -> { أرجع الطول(المنشئ.الحمولات) مثل طبيعي; }
        | اختياري.لا_شيء -> { أرجع 0; };
    };
}

// The payload count of a builtin constructor: `some`, `ok` and `err` take
// one, `none` none.
عرف عدد_حمولات_منشئ_مدمج_إكمال(الهوية: هوية_منشئ_نوع): طبيعي {
    طابق الهوية مع
    | هوية_منشئ_نوع.اختيار_لا_شيء -> { أرجع 0; }
    | _ -> { أرجع 1; };
}

// The constructors of an enum Symbol, in declaration order, each with its
// payload count; في_نمط when they are written in a match arm's pattern.
عرف أضف_منشئات_إكمال(
    الواجهة: &نتيجة_واجهة_وحدة,
    الأسماء: &سياق_استعلامات_أسماء,
    المالك: معرف_رمز,
    وحدة_الموضع: اختياري معرف_وحدة,
    في_نمط: منطقي,
    الناتج: &متغير متجه مرشح_إكمال
): فراغ {
    ليكن الأنواع: &سجل_أنواع = &(*الواجهة).سياقات_الأنواع.الأنواع;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الأسماء).الرموز) مثل طبيعي)) {
        ليكن منشئ: منطقي = (*الأسماء).الرموز[ف].النوع == نوع_تصريح.منشئ_تعداد();
        إذا (منشئ) {
            طابق (*الأسماء).الرموز[ف].المالك مع
            | اختياري.موجود(الأب) -> {
                إذا (معرفا_رمز_متساويان(الأب, المالك)) {
                    ليكن الرمز: معرف_رمز = (*الأسماء).الرموز[ف].المعرف;
                    ليكن العدد: طبيعي = عدد_حمولات_منشئ_إكمال(الأنواع, المالك, الرمز);
                    ألحق(*الناتج, مرشح_منشئ_إكمال(
                        مرشح_رمز_إكمال(الواجهة, الأسماء, الرمز, وحدة_الموضع), العدد, في_نمط
                    ));
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
}

// The builtin constructors `option.` and `result.` name (`option`,
// `اختياري`, `result`, `نتيجة`); none for another name.
عرف منشئات_مدمجة_إكمال(الاسم: &نص): متجه هوية_منشئ_نوع {
    ليكن اختياري_إنجليزي: نص = تهجئة_عرض_اختياري_مدمجة_إنجليزية();
    ليكن اختياري_عربي: نص = تهجئة_عرض_اختياري_مدمجة();
    ليكن نتيجة_إنجليزية: نص = تهجئة_عرض_نتيجة_مدمجة_إنجليزية();
    ليكن نتيجة_عربية: نص = تهجئة_عرض_نتيجة_مدمجة();
    إذا (نصان_متساويان(الاسم, &اختياري_إنجليزي) || نصان_متساويان(الاسم, &اختياري_عربي)
        || نصان_متساويان(الاسم, &«اختيار»)) {
        ليكن الاختيار: متجه هوية_منشئ_نوع = [هوية_منشئ_نوع.اختيار_بعض(), هوية_منشئ_نوع.اختيار_لا_شيء()];
        أرجع الاختيار;
    };
    إذا (نصان_متساويان(الاسم, &نتيجة_إنجليزية) || نصان_متساويان(الاسم, &نتيجة_عربية)) {
        ليكن النتيجة: متجه هوية_منشئ_نوع = [هوية_منشئ_نوع.نتيجة_نجاح(), هوية_منشئ_نوع.نتيجة_خطأ()];
        أرجع النتيجة;
    };
    ليكن بلا: متجه هوية_منشئ_نوع = [];
    أرجع بلا;
}

عرف لغة_رقعة_إكمال(الرقعة: &رقعة_إكمال): لغة_تشخيص {
    إذا ((*الرقعة).إنجليزية) { أرجع لغة_تشخيص.الإنجليزية(); };
    أرجع لغة_تشخيص.العربية();
}

// The builtin Types a Type position offers, in the registry's order.
عرف أنواع_بدائية_إكمال(): متجه نوع_بدائي_مقنن {
    ليكن الناتج: متجه نوع_بدائي_مقنن = [
        نوع_بدائي_مقنن.أي(), نوع_بدائي_مقنن.منطقي(), نوع_بدائي_مقنن.نص(), نوع_بدائي_مقنن.حرف(),
        نوع_بدائي_مقنن.عدد(), نوع_بدائي_مقنن.طبيعي(), نوع_بدائي_مقنن.فراغ(),
        نوع_بدائي_مقنن.ص8(), نوع_بدائي_مقنن.ص16(), نوع_بدائي_مقنن.ص32(), نوع_بدائي_مقنن.ص64(),
        نوع_بدائي_مقنن.ط8(), نوع_بدائي_مقنن.ط16(), نوع_بدائي_مقنن.ط32(), نوع_بدائي_مقنن.ط64(),
        نوع_بدائي_مقنن.ع32(), نوع_بدائي_مقنن.ع64()
    ];
    أرجع الناتج;
}

// A Type position: the Types in scope (declarations and Type parameters),
// then the builtin Types spelled in the source's language.
عرف أضف_أنواع_إكمال(
    الواجهة: &نتيجة_واجهة_وحدة,
    الأسماء: &سياق_استعلامات_أسماء,
    المرئية: &متجه ربط_اسم_نطاق,
    وحدة_الموضع: اختياري معرف_وحدة,
    إنجليزية: منطقي,
    الناتج: &متغير متجه مرشح_إكمال
): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المرئية) مثل طبيعي)) {
        ليكن الرمز: معرف_رمز = (*المرئية)[ف].الرمز;
        إذا ((الرمز.القيمة مثل طبيعي) < (الطول((*الأسماء).الرموز) مثل طبيعي)) {
            إذا (هل_نوع_تصريح_في_حيز((*الأسماء).الرموز[الرمز.القيمة].النوع, حيز_اسم.نوع())) {
                ألحق(*الناتج, مرشح_رمز_إكمال(الواجهة, الأسماء, الرمز, وحدة_الموضع));
            };
        };
        ف := ف + 1;
    }
    ليكن الأنواع: &سجل_أنواع = &(*الواجهة).سياقات_الأنواع.الأنواع;
    ليكن البدائية: متجه نوع_بدائي_مقنن = أنواع_بدائية_إكمال();
    ليكن ب: متغير طبيعي = 0;
    طالما (ب < (الطول(البدائية) مثل طبيعي)) {
        ليكن الاسم: متغير نص = تهجئة_عرض_نوع_بدائي(البدائية[ب]);
        إذا (إنجليزية) { الاسم := تهجئة_عرض_نوع_بدائي_إنجليزية(البدائية[ب]); };
        ألحق(*الناتج, مرشح_بلا_رمز_إكمال(
            الاسم, اختياري.لا_شيء(), صنف_مرشح.نوع_مدمج(),
            معرف_نوع_بدائي_دلالي(الأنواع, البدائية[ب]), 4
        ));
        ب := ب + 1;
    }
    ليكن الحاويات: متغير متجه نص = [
        تهجئة_عرض_متجه_مدمجة(), تهجئة_عرض_اختياري_مدمجة(), تهجئة_عرض_نتيجة_مدمجة()
    ];
    إذا (إنجليزية) {
        الحاويات := [
            تهجئة_عرض_متجه_مدمجة_إنجليزية(), تهجئة_عرض_اختياري_مدمجة_إنجليزية(),
            تهجئة_عرض_نتيجة_مدمجة_إنجليزية()
        ];
    };
    ليكن ح: متغير طبيعي = 0;
    طالما (ح < (الطول(الحاويات) مثل طبيعي)) {
        ألحق(*الناتج, مرشح_بلا_رمز_إكمال(
            انسخ_نص(&الحاويات[ح]), اختياري.لا_شيء(), صنف_مرشح.نوع_مدمج(), اختياري.لا_شيء(), 4
        ));
        ح := ح + 1;
    }
}

// The Symbol the first visible binding named الاسم binds.
عرف رمز_مرئي_إكمال(
    الأسماء: &سياق_استعلامات_أسماء,
    المرئية: &متجه ربط_اسم_نطاق,
    الاسم: &نص
): اختياري معرف_رمز {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المرئية) مثل طبيعي)) {
        إذا (اسم_يطابق_نصا(الأسماء, (*المرئية)[ف].الاسم, الاسم)) {
            ليكن الرمز: معرف_رمز = (*المرئية)[ف].الرمز;
            إذا ((الرمز.القيمة مثل طبيعي) < (الطول((*الأسماء).الرموز) مثل طبيعي)) {
                أرجع اختياري.موجود(الرمز);
            };
            أرجع اختياري.لا_شيء();
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The Type of a value named الاسم in scope (not of a Type).
عرف نوع_اسم_مرئي_إكمال(
    الواجهة: &نتيجة_واجهة_وحدة,
    الأسماء: &سياق_استعلامات_أسماء,
    المرئية: &متجه ربط_اسم_نطاق,
    الاسم: &نص
): اختياري معرف_نوع {
    طابق رمز_مرئي_إكمال(الأسماء, المرئية, الاسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الرمز) -> {
        إذا (رمز_نوع_إكمال((*الأسماء).الرموز[الرمز.القيمة].النوع)) { أرجع اختياري.لا_شيء(); };
        أرجع نوع_رمز_دلالي_عند(&(*الواجهة).سياقات_الأنواع.أنواع_الرموز, الرمز);
    };
}

عرف تخطى_فراغ_إكمال(النص: &نص, الموضع: &متغير طبيعي): فراغ {
    طالما (*الموضع < (الطول(*النص) مثل طبيعي) && فراغ_عند(بايت_عند_إكمال(النص, *الموضع))) {
        *الموضع := *الموضع + 1;
    }
}

// The Type of the expression written at الموضع of النص (a receiver, a
// callee, a scrutinee), from the analysis: a name's Type, then each field's,
// call result's and element's, through `*` and `&` and brackets
// (`make().inner`, `(*r)`, `arr[0]`). None when a part has no known Type (a
// generic call's result, a literal, a name not in scope). الموضع ends after
// the expression.
عرف نوع_تعبير_مكتوب_إكمال(
    الواجهة: &نتيجة_واجهة_وحدة,
    الأسماء: &سياق_استعلامات_أسماء,
    المرئية: &متجه ربط_اسم_نطاق,
    النص: &نص,
    الموضع: &متغير طبيعي,
    العمق: طبيعي
): اختياري معرف_نوع {
    إذا (العمق > 32) { أرجع اختياري.لا_شيء(); };
    ليكن الأنواع: &سجل_أنواع = &(*الواجهة).سياقات_الأنواع.الأنواع;
    تخطى_فراغ_إكمال(النص, الموضع);
    ليكن الأول: ط8 = بايت_عند_إكمال(النص, *الموضع);
    إذا (الأول == 0x2A) {
        *الموضع := *الموضع + 1;
        طابق نوع_تعبير_مكتوب_إكمال(الواجهة, الأسماء, المرئية, النص, الموضع, العمق + 1) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الداخل) -> { أرجع نوع_مشار_إليه_إكمال(الأنواع, الداخل); };
    };
    إذا (الأول == 0x26) {
        // `&e` and `&mutable e` have e's members.
        *الموضع := *الموضع + 1;
        تخطى_فراغ_إكمال(النص, الموضع);
        ليكن نهاية_الكلمة: طبيعي = نهاية_معرف_بعد(النص, *الموضع);
        ليكن الكلمة: نص = نص_بين(النص, *الموضع, نهاية_الكلمة);
        إذا (نصان_متساويان(&الكلمة, &«mutable») || نصان_متساويان(&الكلمة, &«متغير»)) {
            *الموضع := نهاية_الكلمة;
        };
        أرجع نوع_تعبير_مكتوب_إكمال(الواجهة, الأسماء, المرئية, النص, الموضع, العمق + 1);
    };
    ليكن البدء: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    إذا (الأول == 0x28) {
        *الموضع := *الموضع + 1;
        البدء := نوع_تعبير_مكتوب_إكمال(الواجهة, الأسماء, المرئية, النص, الموضع, العمق + 1);
        تخطى_فراغ_إكمال(النص, الموضع);
        إذا (بايت_عند_إكمال(النص, *الموضع) != 0x29) { أرجع اختياري.لا_شيء(); };
        *الموضع := *الموضع + 1;
    } وإلا {
        ليكن نهاية_الاسم: طبيعي = نهاية_معرف_بعد(النص, *الموضع);
        إذا (نهاية_الاسم == *الموضع) { أرجع اختياري.لا_شيء(); };
        ليكن الاسم: نص = نص_بين(النص, *الموضع, نهاية_الاسم);
        *الموضع := نهاية_الاسم;
        البدء := نوع_اسم_مرئي_إكمال(الواجهة, الأسماء, المرئية, &الاسم);
    };
    طابق البدء مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(نوع_البدء) -> {
        ليكن الحالي: متغير معرف_نوع = نوع_البدء;
        طالما (صواب) {
            ليكن التالي: ط8 = بايت_عند_إكمال(النص, *الموضع);
            ليكن الداخل: معرف_نوع = نوع_قيمة_إكمال(الأنواع, الحالي);
            إذا (التالي == 0x2E) {
                *الموضع := *الموضع + 1;
                ليكن نهاية_الحقل: طبيعي = نهاية_معرف_بعد(النص, *الموضع);
                إذا (نهاية_الحقل == *الموضع) { أرجع اختياري.لا_شيء(); };
                ليكن الحقل: نص = نص_بين(النص, *الموضع, نهاية_الحقل);
                *الموضع := نهاية_الحقل;
                طابق نوع_حقل_بالنص_إكمال(الأنواع, الأسماء, الداخل, &الحقل) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(نوع_الحقل) -> { الحالي := نوع_الحقل; };
            } وإلا إذا (التالي == 0x28) {
                *الموضع := بعد_غالق_مطابق(النص, *الموضع);
                طابق نوع_ناتج_دالة_دلالي(الأنواع, الداخل) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(الناتج) -> { الحالي := الناتج; };
            } وإلا إذا (التالي == 0x5B) {
                *الموضع := بعد_غالق_مطابق(النص, *الموضع);
                طابق نوع_عنصر_تسلسل_دلالي(الأنواع, الداخل) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(العنصر) -> { الحالي := العنصر; };
            } وإلا {
                أرجع اختياري.موجود(الحالي);
            };
        }
        أرجع اختياري.موجود(الحالي);
    };
}

// The Type of the whole expression النص; none when text follows it.
عرف نوع_نص_تعبير_إكمال(
    الواجهة: &نتيجة_واجهة_وحدة,
    الأسماء: &سياق_استعلامات_أسماء,
    المرئية: &متجه ربط_اسم_نطاق,
    النص: &نص
): اختياري معرف_نوع {
    ليكن الموضع: متغير طبيعي = 0;
    ليكن النوع: اختياري معرف_نوع = نوع_تعبير_مكتوب_إكمال(الواجهة, الأسماء, المرئية, النص, &متغير الموضع, 0);
    تخطى_فراغ_إكمال(النص, &متغير الموضع);
    إذا (الموضع < (الطول(*النص) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع النوع;
}

// A record literal's Type: the Type the `let` writes (`Inner`, a dotted
// `geo.Point` by its last name, `Pair<int>` by its name), then the Type of
// each field on المسار.
عرف نوع_سجل_مكتوب_إكمال(
    الواجهة: &نتيجة_واجهة_وحدة,
    الأسماء: &سياق_استعلامات_أسماء,
    المرئية: &متجه ربط_اسم_نطاق,
    الرقعة: &رقعة_إكمال
): اختياري معرف_نوع {
    ليكن المكتوب: &نص = &(*الرقعة).النوع_المكتوب;
    ليكن ف: متغير طبيعي = 0;
    ليكن الاسم: متغير نص = «»;
    ليكن تابع: متغير منطقي = صواب;
    طالما (تابع) {
        تخطى_فراغ_إكمال(المكتوب, &متغير ف);
        ليكن النهاية: طبيعي = نهاية_معرف_بعد(المكتوب, ف);
        إذا (النهاية == ف) { تابع := خطأ; }
        وإلا {
            الاسم := نص_بين(المكتوب, ف, النهاية);
            ف := النهاية;
            إذا (بايت_عند_إكمال(المكتوب, ف) == 0x2E) { ف := ف + 1; } وإلا { تابع := خطأ; };
        };
    }
    طابق رمز_مرئي_إكمال(الأسماء, المرئية, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الرمز) -> {
        إذا (!رمز_نوع_إكمال((*الأسماء).الرموز[الرمز.القيمة].النوع)) { أرجع اختياري.لا_شيء(); };
        ليكن الأنواع: &سجل_أنواع = &(*الواجهة).سياقات_الأنواع.الأنواع;
        طابق معرف_نوع_مسمى_عند(&(*الأنواع).المسماة, الرمز) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(نوع_الرمز) -> {
            ليكن الحالي: متغير معرف_نوع = نوع_الرمز;
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول((*الرقعة).المسار) مثل طبيعي)) {
                طابق نوع_حقل_بالنص_إكمال(الأنواع, الأسماء, نوع_قيمة_إكمال(الأنواع, الحالي), &(*الرقعة).المسار[م]) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(نوع_الحقل) -> { الحالي := نوع_الحقل; };
                م := م + 1;
            }
            أرجع اختياري.موجود(نوع_قيمة_إكمال(الأنواع, الحالي));
        };
    };
}

// The pattern without its payload, and its last name (`Red` for
// `Color.Red`).
عرف رأس_نمط_إكمال(النمط: &نص): نص {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النمط) مثل طبيعي) && بايت_عند_إكمال(النمط, ف) != 0x28) { ف := ف + 1; }
    أرجع نص_مقصوص_بين(النمط, 0, ف);
}

عرف آخر_اسم_إكمال(النص: &نص): نص {
    ليكن النهاية: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن ف: متغير طبيعي = النهاية;
    طالما (ف > 0 && بايت_عند_إكمال(النص, ف - 1) != 0x2E) { ف := ف - 1; }
    أرجع نص_بين(النص, ف, النهاية);
}

// Whether an arm already covers the case at الترتيب: a written pattern names
// it (in either language, with or without its Type), or is `_`.
عرف حالة_مغطاة_إكمال(
    الأنواع: &سجل_أنواع,
    الأسماء: &سياق_استعلامات_أسماء,
    النوع: معرف_نوع,
    الترتيب: طبيعي,
    المكتوبة: &متجه نص
): منطقي {
    ليكن اللغات: متجه لغة_تشخيص = [لغة_تشخيص.الإنجليزية(), لغة_تشخيص.العربية()];
    ليكن ل: متغير طبيعي = 0;
    طالما (ل < (الطول(اللغات) مثل طبيعي)) {
        طابق تهجئة_حالة_نمط_بلغة(الأنواع, &(*الأسماء).الأسماء, &(*الأسماء).الرموز, اللغات[ل], النوع, الترتيب) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الحالة) -> {
            ليكن الرأس: نص = رأس_نمط_إكمال(&الحالة);
            ليكن الأخير: نص = آخر_اسم_إكمال(&الرأس);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(*المكتوبة) مثل طبيعي)) {
                ليكن المكتوب: نص = رأس_نمط_إكمال(&(*المكتوبة)[ف]);
                إذا (نصان_متساويان(&المكتوب, &الرأس) || نصان_متساويان(&المكتوب, &الأخير)) { أرجع صواب; };
                ف := ف + 1;
            }
        };
        ل := ل + 1;
    }
    أرجع خطأ;
}

// The enum constructor Symbol of the case at الترتيب; none for a builtin case.
عرف رمز_حالة_إكمال(الأنواع: &سجل_أنواع, النوع: معرف_نوع, الترتيب: طبيعي): اختياري معرف_رمز {
    طابق منشئ_نوع_عند(الأنواع, النوع, الترتيب) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المنشئ) -> {
        طابق المنشئ.الهوية مع
        | هوية_منشئ_نوع.تعداد(الرمز) -> { أرجع اختياري.موجود(الرمز); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// The cases of a match on النوع that no written arm covers, in declaration
// order, as an arm writes them in the source's language (`Color.Red`,
// `option.some(_)`, `true`). Nothing after a `_` arm.
عرف أضف_حالات_ناقصة_إكمال(
    الواجهة: &نتيجة_واجهة_وحدة,
    الأسماء: &سياق_استعلامات_أسماء,
    النوع: معرف_نوع,
    الرقعة: &رقعة_إكمال,
    الناتج: &متغير متجه مرشح_إكمال
): فراغ {
    ليكن الأنواع: &سجل_أنواع = &(*الواجهة).سياقات_الأنواع.الأنواع;
    ليكن المكتوبة: &متجه نص = &(*الرقعة).المكتوبة;
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول(*المكتوبة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*المكتوبة)[م], &«_»)) { أرجع; };
        م := م + 1;
    }
    // A boolean has two cases and no constructors.
    ليكن العدد: متغير طبيعي = 2;
    طابق عدد_منشئات_نوع(الأنواع, النوع) مع
    | اختياري.موجود(عدد_المنشئات) -> { العدد := عدد_المنشئات; }
    | اختياري.لا_شيء -> { };
    ليكن اللغة: لغة_تشخيص = لغة_رقعة_إكمال(الرقعة);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق تهجئة_حالة_نمط_بلغة(الأنواع, &(*الأسماء).الأسماء, &(*الأسماء).الرموز, اللغة, النوع, ف) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الحالة) -> {
            إذا (!حالة_مغطاة_إكمال(الأنواع, الأسماء, النوع, ف, المكتوبة)) {
                // A pattern inserts itself; a boolean case has no payloads.
                ليكن المرشح: متغير مرشح_إكمال = مرشح_بلا_رمز_إكمال(
                    الحالة, رمز_حالة_إكمال(الأنواع, النوع, ف), صنف_مرشح.نمط_حالة(),
                    اختياري.موجود(النوع), 2
                );
                المرشح.في_نمط := صواب;
                طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, النوع, ف) مع
                | اختياري.موجود(عدد_الحمولات) -> { المرشح.عدد_الحمولات := اختياري.موجود(عدد_الحمولات); }
                | اختياري.لا_شيء -> { };
                ألحق(*الناتج, المرشح);
            };
        };
        ف := ف + 1;
    }
}

// The candidates whose Type fits المتوقع first, each group in its order.
عرف قدم_الملائمة_إكمال(
    الأنواع: &سجل_أنواع,
    المرشحات: &متجه مرشح_إكمال,
    المتوقع: معرف_نوع
): متجه مرشح_إكمال {
    ليكن الملائمة: متغير متجه مرشح_إكمال = [];
    ليكن الباقية: متغير متجه مرشح_إكمال = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المرشحات) مثل طبيعي)) {
        ليكن المرشح: متغير مرشح_إكمال = انسخ_مرشح_إكمال(&(*المرشحات)[ف]);
        ليكن يلائم: متغير منطقي = خطأ;
        طابق (*المرشحات)[ف].النوع مع
        | اختياري.موجود(النوع) -> { يلائم := نوعان_متوافقان(الأنواع, النوع, المتوقع); }
        | اختياري.لا_شيء -> { };
        المرشح.يلائم_المتوقع := يلائم;
        إذا (يلائم) { ألحق(الملائمة, المرشح); } وإلا { ألحق(الباقية, المرشح); };
        ف := ف + 1;
    }
    ليكن ب: متغير طبيعي = 0;
    طالما (ب < (الطول(الباقية) مثل طبيعي)) {
        ألحق(الملائمة, انسخ_مرشح_إكمال(&الباقية[ب]));
        ب := ب + 1;
    }
    أرجع الملائمة;
}

عرف نتيجة_إكمال_بمتوقع(
    السياق: سياق_إكمال,
    البداية: طبيعي,
    المرشحات: متجه مرشح_إكمال,
    المتوقع: اختياري معرف_نوع
): نتيجة_إكمال_أدوات {
    ليكن الناتج: نتيجة_إكمال_أدوات = {
        السياق: السياق, بداية_الكلمة: البداية, المرشحات: المرشحات, النوع_المتوقع: المتوقع
    };
    أرجع الناتج;
}

عرف نتيجة_إكمال_فارغة(السياق: سياق_إكمال, البداية: طبيعي): نتيجة_إكمال_أدوات {
    ليكن بلا: متجه مرشح_إكمال = [];
    أرجع نتيجة_إكمال_بمتوقع(السياق, البداية, بلا, اختياري.لا_شيء());
}

عرف نتيجة_إكمال(السياق: سياق_إكمال, البداية: طبيعي, المرشحات: متجه مرشح_إكمال): نتيجة_إكمال_أدوات {
    أرجع نتيجة_إكمال_بمتوقع(السياق, البداية, المرشحات, اختياري.لا_شيء());
}

// Names in scope (اسم), members of a value's Type (عضو_قيمة), constructors
// of a Type (عضو_نوع), Types (موضع_نوع), the missing fields of a record
// literal (حقل_سجل), the missing cases of a match (حالة_مطابقة) and call
// arguments (معامل_استدعاء) at the patched statement. For a path whose first
// name is neither a value nor a Type (nor `option` or `result`), the result
// is مسار_وحدة with no candidates: the tool then asks إكمال_مسار_بيئة.
عام عرف إكمال_عند_رقعة_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    الرقعة: &رقعة_إكمال
): نتيجة_إكمال_أدوات {
    ليكن البداية: طبيعي = (*الرقعة).بداية_الكلمة;
    ليكن السياق: سياق_إكمال = (*الرقعة).السياق;
    طابق السياق مع
    | سياق_إكمال.اسم -> { }
    | سياق_إكمال.عضو_قيمة -> { }
    | سياق_إكمال.موضع_نوع -> { }
    | سياق_إكمال.حقل_سجل -> { }
    | سياق_إكمال.حالة_مطابقة -> { }
    | سياق_إكمال.معامل_استدعاء -> { }
    | _ -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); };
    ليكن مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    ليكن المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); }
    | اختياري.موجود(الأسماء) -> {
        ليكن البايت: طبيعي = (*الرقعة).البايت;
        ليكن وحدة_الموضع: متغير اختياري معرف_وحدة = اختياري.لا_شيء();
        طابق نطاق_دلالي_عند_استعلام(&الأسماء, المصدر, البايت) مع
        | اختياري.موجود(النطاق) -> {
            إذا ((النطاق.القيمة مثل طبيعي) < (الطول(الأسماء.النطاقات) مثل طبيعي)) {
                وحدة_الموضع := اختياري.موجود(الأسماء.النطاقات[النطاق.القيمة].الوحدة);
            };
        }
        | اختياري.لا_شيء -> { };
        ليكن المرئية: متجه ربط_اسم_نطاق = روابط_مرئية_عند_استعلام(&الأسماء, المصدر, البايت);
        ليكن الأنواع: &سجل_أنواع = &(*الواجهة).سياقات_الأنواع.الأنواع;
        ليكن الناتج: متغير متجه مرشح_إكمال = [];
        إذا (السياق == سياق_إكمال.اسم() || السياق == سياق_إكمال.معامل_استدعاء()) {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المرئية) مثل طبيعي)) {
                ليكن الرمز: معرف_رمز = المرئية[ف].الرمز;
                إذا ((الرمز.القيمة مثل طبيعي) < (الطول(الأسماء.الرموز) مثل طبيعي)) {
                    ألحق(الناتج, مرشح_رمز_إكمال(الواجهة, &الأسماء, الرمز, وحدة_الموضع));
                };
                ف := ف + 1;
            }
            إذا (السياق == سياق_إكمال.اسم()) { أرجع نتيجة_إكمال(السياق, البداية, الناتج); };
            // `area(|`: the parameter's Type, from the callee's.
            طابق نوع_نص_تعبير_إكمال(الواجهة, &الأسماء, &المرئية, &(*الرقعة).التعبير) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(نوع_المستدعى) -> {
                طابق نوع_معامل_دالة_دلالي_عند(
                    الأنواع, نوع_قيمة_إكمال(الأنواع, نوع_المستدعى), (*الرقعة).ترتيب_المعامل
                ) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(المتوقع) -> {
                    ليكن المرتبة: متجه مرشح_إكمال = قدم_الملائمة_إكمال(الأنواع, &الناتج, المتوقع);
                    أرجع نتيجة_إكمال_بمتوقع(السياق, البداية, المرتبة, اختياري.موجود(المتوقع));
                };
            };
            أرجع نتيجة_إكمال(السياق, البداية, الناتج);
        };
        إذا (السياق == سياق_إكمال.موضع_نوع()) {
            أضف_أنواع_إكمال(الواجهة, &الأسماء, &المرئية, وحدة_الموضع, (*الرقعة).إنجليزية, &متغير الناتج);
            أرجع نتيجة_إكمال(السياق, البداية, الناتج);
        };
        إذا (السياق == سياق_إكمال.حقل_سجل()) {
            طابق نوع_سجل_مكتوب_إكمال(الواجهة, &الأسماء, &المرئية, الرقعة) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); }
            | اختياري.موجود(نوع_السجل) -> {
                أضف_حقول_ناقصة_إكمال(الأنواع, &الأسماء, نوع_السجل, &(*الرقعة).المكتوبة, &متغير الناتج);
                أرجع نتيجة_إكمال_بمتوقع(السياق, البداية, الناتج, اختياري.موجود(نوع_السجل));
            };
        };
        إذا (السياق == سياق_إكمال.حالة_مطابقة()) {
            طابق نوع_نص_تعبير_إكمال(الواجهة, &الأسماء, &المرئية, &(*الرقعة).التعبير) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); }
            | اختياري.موجود(نوع_المميز) -> {
                ليكن المميز: معرف_نوع = نوع_قيمة_إكمال(الأنواع, نوع_المميز);
                أضف_حالات_ناقصة_إكمال(الواجهة, &الأسماء, المميز, الرقعة, &متغير الناتج);
                أرجع نتيجة_إكمال_بمتوقع(السياق, البداية, الناتج, اختياري.موجود(المميز));
            };
        };
        // `make().`, `(*r).`, `arr[0].`: the members of the receiver's Type.
        إذا ((الطول((*الرقعة).التعبير) مثل طبيعي) > 0) {
            طابق نوع_نص_تعبير_إكمال(الواجهة, &الأسماء, &المرئية, &(*الرقعة).التعبير) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); }
            | اختياري.موجود(نوع_المستقبل) -> {
                أضف_حقول_إكمال(الأنواع, &الأسماء, نوع_قيمة_إكمال(الأنواع, نوع_المستقبل), &متغير الناتج);
                أرجع نتيجة_إكمال(السياق, البداية, الناتج);
            };
        };
        // `a.b.c.`: the first name, then fields.
        إذا ((الطول((*الرقعة).المسار) مثل طبيعي) == 0) { أرجع نتيجة_إكمال_فارغة(السياق, البداية); };
        ليكن الأول: &نص = &(*الرقعة).المسار[0];
        ليكن الموجود: متغير اختياري معرف_رمز = اختياري.لا_شيء();
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المرئية) مثل طبيعي)) {
            إذا (اسم_يطابق_نصا(&الأسماء, المرئية[ف].الاسم, الأول)) {
                الموجود := اختياري.موجود(المرئية[ف].الرمز);
                ف := الطول(المرئية) مثل طبيعي;
            } وإلا {
                ف := ف + 1;
            };
        }
        طابق الموجود مع
        | اختياري.لا_شيء -> {
            // `option.`, `result.`: the builtin constructors, spelled in the
            // source's language.
            إذا ((الطول((*الرقعة).المسار) مثل طبيعي) == 1) {
                ليكن المنشئات: متجه هوية_منشئ_نوع = منشئات_مدمجة_إكمال(الأول);
                إذا ((الطول(المنشئات) مثل طبيعي) > 0) {
                    ليكن اللغة: لغة_تشخيص = لغة_رقعة_إكمال(الرقعة);
                    ليكن م: متغير طبيعي = 0;
                    طالما (م < (الطول(المنشئات) مثل طبيعي)) {
                        طابق تهجئة_منشئ_مدمج_بلغة(المنشئات[م], اللغة) مع
                        | اختياري.موجود(الاسم) -> {
                            ألحق(الناتج, مرشح_منشئ_إكمال(
                                مرشح_بلا_رمز_إكمال(
                                    الاسم, اختياري.لا_شيء(), صنف_مرشح.منشئ_مدمج(), اختياري.لا_شيء(), 4
                                ),
                                عدد_حمولات_منشئ_مدمج_إكمال(المنشئات[م]), (*الرقعة).في_نمط
                            ));
                        }
                        | اختياري.لا_شيء -> { };
                        م := م + 1;
                    }
                    أرجع نتيجة_إكمال(سياق_إكمال.عضو_نوع(), البداية, الناتج);
                };
            };
            // Not a value or a Type in scope: a module path.
            أرجع نتيجة_إكمال_فارغة(سياق_إكمال.مسار_وحدة(), البداية);
        }
        | اختياري.موجود(الرمز) -> {
            إذا ((الرمز.القيمة مثل طبيعي) >= (الطول(الأسماء.الرموز) مثل طبيعي)) {
                أرجع نتيجة_إكمال_فارغة(السياق, البداية);
            };
            ليكن نوع_التصريح: نوع_تصريح = الأسماء.الرموز[الرمز.القيمة].النوع;
            إذا (رمز_نوع_إكمال(نوع_التصريح)) {
                إذا ((الطول((*الرقعة).المسار) مثل طبيعي) == 1) {
                    أضف_منشئات_إكمال(
                        الواجهة, &الأسماء, الرمز, وحدة_الموضع, (*الرقعة).في_نمط, &متغير الناتج
                    );
                };
                أرجع نتيجة_إكمال(سياق_إكمال.عضو_نوع(), البداية, الناتج);
            };
            طابق نوع_رمز_دلالي_عند(&(*الواجهة).سياقات_الأنواع.أنواع_الرموز, الرمز) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); }
            | اختياري.موجود(نوع_القيمة) -> {
                ليكن الحالي: متغير معرف_نوع = نوع_بلا_مراجع_إكمال(الأنواع, نوع_القيمة);
                ليكن م: متغير طبيعي = 1;
                طالما (م < (الطول((*الرقعة).المسار) مثل طبيعي)) {
                    طابق نوع_حقل_بالنص_إكمال(الأنواع, &الأسماء, الحالي, &(*الرقعة).المسار[م]) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); }
                    | اختياري.موجود(نوع_الحقل) -> { الحالي := نوع_بلا_مراجع_إكمال(الأنواع, نوع_الحقل); };
                    م := م + 1;
                }
                أضف_حقول_إكمال(الأنواع, &الأسماء, الحالي, &متغير الناتج);
                أرجع نتيجة_إكمال(السياق, البداية, الناتج);
            };
        };
    };
}

// ---- Step 3: import paths and module paths --------------------------------------

عرف مرشح_وحدة_إكمال(الاسم: نص, البعد: طبيعي): مرشح_إكمال {
    ليكن الإدراج: نص = انسخ_نص(&الاسم);
    ليكن المرشح: مرشح_إكمال = {
        الاسم: الاسم, الرمز: اختياري.لا_شيء(), الصنف: صنف_مرشح.وحدة(), النوع: اختياري.لا_شيء(), البعد: البعد,
        اللغة: اختياري.لا_شيء(), الأصلي: اختياري.لا_شيء(), يلائم_المتوقع: خطأ,
        عدد_الحمولات: اختياري.لا_شيء(), في_نمط: خطأ, نص_الإدراج: الإدراج
    };
    أرجع المرشح;
}

// Orders module candidates by name (directory order is not stable).
عرف رتب_مرشحات_إكمال(المرشحات: &متغير متجه مرشح_إكمال): فراغ {
    ليكن العدد: طبيعي = الطول(*المرشحات) مثل طبيعي;
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        ليكن م: متغير طبيعي = ف;
        طالما (م > 0 && قارن_نصين_معجميا(&(*المرشحات)[م - 1].الاسم, &(*المرشحات)[م].الاسم) > 0) {
            ليكن السابق: مرشح_إكمال = انسخ_مرشح_إكمال(&(*المرشحات)[م - 1]);
            ليكن الحالي: مرشح_إكمال = انسخ_مرشح_إكمال(&(*المرشحات)[م]);
            (*المرشحات)[م - 1] := الحالي;
            (*المرشحات)[م] := السابق;
            م := م - 1;
        }
        ف := ف + 1;
    }
}

عرف انسخ_اختيار_نص_إكمال(القيمة: &اختياري نص): اختياري نص {
    طابق *القيمة مع
    | اختياري.موجود(النص) -> { أرجع اختياري.موجود(انسخ_نص(&النص)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف انسخ_مرشح_إكمال(المرشح: &مرشح_إكمال): مرشح_إكمال {
    ليكن النسخة: مرشح_إكمال = {
        الاسم: انسخ_نص(&(*المرشح).الاسم),
        الرمز: (*المرشح).الرمز,
        الصنف: (*المرشح).الصنف,
        النوع: (*المرشح).النوع,
        البعد: (*المرشح).البعد,
        اللغة: انسخ_اختيار_نص_إكمال(&(*المرشح).اللغة),
        الأصلي: انسخ_اختيار_نص_إكمال(&(*المرشح).الأصلي),
        يلائم_المتوقع: (*المرشح).يلائم_المتوقع,
        عدد_الحمولات: (*المرشح).عدد_الحمولات,
        في_نمط: (*المرشح).في_نمط,
        نص_الإدراج: انسخ_نص(&(*المرشح).نص_الإدراج)
    };
    أرجع النسخة;
}

عرف مرشحات_تحوي_اسما(المرشحات: &متجه مرشح_إكمال, الاسم: &نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المرشحات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*المرشحات)[ف].الاسم, الاسم)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// A folder's `module` spellings, from its root file FOLDER/FOLDER.sn.
// The `module` declarations of المجلد's root file (FOLDER/FOLDER.sn): its
// spellings and its re-exports. None when the folder has no root file.
عرف ملف_جذر_مجلد_إكمال(المجلد: &نص): اختياري تهجئات_مجلد {
    طابق اسم_الملف(المجلد) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        // FOLDER.sn
        ليكن اسم_الجذر: متغير متجه ط8 = [];
        ليكن ب: متغير طبيعي = 0;
        طالما (ب < (الطول(الاسم) مثل طبيعي)) { ألحق(اسم_الجذر, الاسم[ب]); ب := ب + 1; }
        ألحق(اسم_الجذر, 0x2E); ألحق(اسم_الجذر, 0x73); ألحق(اسم_الجذر, 0x6E);
        ليكن اسم_الجذر_نصا: نص = من_بايتات(&اسم_الجذر);
        ليكن ملف_الجذر: نص = صل_المسار(المجلد, &اسم_الجذر_نصا);
        طابق اقرأ_الملف(&ملف_الجذر) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(المحتوى) -> {
            أرجع اختياري.موجود(اقرأ_تهجئات_ملف_جذر(المجلد, &ملف_الجذر, &المحتوى));
        };
    };
}

عرف تهجئات_مجلد_إكمال(المجلد: &نص): متجه تهجئة_ابن_وحدة {
    ليكن بلا: متجه تهجئة_ابن_وحدة = [];
    طابق ملف_جذر_مجلد_إكمال(المجلد) مع
    | اختياري.لا_شيء -> { أرجع بلا; }
    | اختياري.موجود(الجذر) -> { أرجع الجذر.التهجئات; };
}

// The children المجلد's root file re-exports from another library
// (`module compare = core.text.compare;`).
عرف إعادات_مجلد_إكمال(المجلد: &نص): متجه إعادة_تصدير_وحدة {
    ليكن بلا: متجه إعادة_تصدير_وحدة = [];
    طابق ملف_جذر_مجلد_إكمال(المجلد) مع
    | اختياري.لا_شيء -> { أرجع بلا; }
    | اختياري.موجود(الجذر) -> { أرجع الجذر.إعادات_التصدير; };
}

// The folder a re-exported child of المجلد names, in the library the
// re-export leads to: the child by its name or a spelling, followed into the
// target library's source root at the re-exported path. None when the child
// is not re-exported, its library is not visible, or it names a module file.
عرف مجلد_معاد_إكمال(
    البيئة: &بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة,
    المجلد: &نص,
    الجزء: &نص
): اختياري جذر_مسمى_إكمال {
    // A spelling names its canonical child.
    ليكن الابن: متغير نص = انسخ_نص(الجزء);
    ليكن التهجئات: متجه تهجئة_ابن_وحدة = تهجئات_مجلد_إكمال(المجلد);
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < (الطول(التهجئات) مثل طبيعي)) {
        ليكن التهجئة: نص = من_بايتات(&التهجئات[ت].التهجئة);
        إذا (نصان_متساويان(&التهجئة, الجزء)) { الابن := من_بايتات(&التهجئات[ت].الابن); };
        ت := ت + 1;
    }
    ليكن الإعادات: متجه إعادة_تصدير_وحدة = إعادات_مجلد_إكمال(المجلد);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الإعادات) مثل طبيعي)) {
        ليكن اسم_الإعادة: نص = من_بايتات(&الإعادات[ف].الابن);
        إذا (نصان_متساويان(&اسم_الإعادة, &الابن)) {
            طابق مكتبة_إعادة_تصدير(البيئة, الجذر, &الإعادات[ف].المكتبة) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الهدف) -> {
                طابق جذر_مصدر_لمعرف(البيئة, الهدف) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(الدليل) -> {
                    ليكن المسار: متغير نص = الدليل;
                    ليكن م: متغير طبيعي = 0;
                    طالما (م < (الطول(الإعادات[ف].المسار) مثل طبيعي)) {
                        ليكن الجزء_الهدف: نص = من_بايتات(&الإعادات[ف].المسار[م]);
                        المسار := صل_المسار(&المسار, &الجزء_الهدف);
                        م := م + 1;
                    }
                    طابق حاول_مسار_دليل(&المسار) مع
                    | نتيجة.نجح(صواب) -> {
                        ليكن المسمى: جذر_مسمى_إكمال = { الدليل: المسار, الجذر: الهدف };
                        أرجع اختياري.موجود(المسمى);
                    }
                    | _ -> { أرجع اختياري.لا_شيء(); };
                };
            };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The folder a child of المجلد names (its name or a spelling); none when the
// child is a module file or does not exist.
عرف مجلد_ابن_إكمال(المجلد: &نص, الجزء: &نص): اختياري نص {
    ليكن المباشر: نص = صل_المسار(المجلد, الجزء);
    طابق حاول_مسار_دليل(&المباشر) مع
    | نتيجة.نجح(صواب) -> { أرجع اختياري.موجود(المباشر); }
    | _ -> { };
    ليكن التهجئات: متجه تهجئة_ابن_وحدة = تهجئات_مجلد_إكمال(المجلد);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(التهجئات) مثل طبيعي)) {
        ليكن التهجئة: نص = من_بايتات(&التهجئات[ف].التهجئة);
        إذا (نصان_متساويان(&التهجئة, الجزء)) {
            ليكن الابن: نص = من_بايتات(&التهجئات[ف].الابن);
            ليكن المسار: نص = صل_المسار(المجلد, &الابن);
            طابق حاول_مسار_دليل(&المسار) مع
            | نتيجة.نجح(صواب) -> { أرجع اختياري.موجود(المسار); }
            | _ -> { أرجع اختياري.لا_شيء(); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

نوع جذر_مسمى_إكمال = {
    الدليل: نص,
    الجذر: معرف_جذر_مكتبة
};

// The folder a library root name (std, المكتبة, a dependency) stands for.
عرف مجلد_جذر_إكمال(البيئة: &بيئة_وحدات_منطقية, الاسم: &نص): اختياري جذر_مسمى_إكمال {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيئة).روابط_الجذور) مثل طبيعي)) {
        ليكن التهجئة: نص = من_بايتات(&(*البيئة).روابط_الجذور[ف].التهجئة);
        إذا (نصان_متساويان(&التهجئة, الاسم)) {
            ليكن الهدف: معرف_جذر_مكتبة = (*البيئة).روابط_الجذور[ف].الجذر_الهدف;
            طابق جذر_مصدر_لمعرف(البيئة, الهدف) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الدليل) -> {
                إذا ((*البيئة).روابط_الجذور[ف].يستهلك_التهجئة) {
                    ليكن المسمى: جذر_مسمى_إكمال = { الدليل: الدليل, الجذر: الهدف };
                    أرجع اختياري.موجود(المسمى);
                };
                ليكن الأعمق: نص = صل_المسار(&الدليل, الاسم);
                ليكن المسمى_الأعمق: جذر_مسمى_إكمال = { الدليل: الأعمق, الجذر: الهدف };
                أرجع اختياري.موجود(المسمى_الأعمق);
            };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Import paths (مسار_استيراد) and module paths in expressions (مسار_وحدة): the
// child modules and folders of the path before the word, with their `module`
// spellings; for an empty path, the library root names. The candidates are
// modules (صنف_مرشح.وحدة), البعد 4 under std and 3 elsewhere.
عام عرف إكمال_مسار_بيئة(
    البيئة: &بيئة_وحدات_منطقية,
    الرقعة: &رقعة_إكمال
): نتيجة_إكمال_أدوات {
    ليكن البداية: طبيعي = (*الرقعة).بداية_الكلمة;
    ليكن السياق: سياق_إكمال = (*الرقعة).السياق;
    ليكن الناتج: متغير متجه مرشح_إكمال = [];
    طابق السياق مع
    | سياق_إكمال.مسار_استيراد -> { }
    | سياق_إكمال.مسار_وحدة -> { }
    | سياق_إكمال.عضو_قيمة -> { }
    | _ -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); };
    ليكن العدد: طبيعي = الطول((*الرقعة).المسار) مثل طبيعي;
    ليكن القياسي: اختياري معرف_جذر_مكتبة = جذر_قياسي_موثوق_لبيئة(البيئة);
    إذا (العدد == 0) {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*البيئة).روابط_الجذور) مثل طبيعي)) {
            ليكن التهجئة: نص = من_بايتات(&(*البيئة).روابط_الجذور[ف].التهجئة);
            إذا (!مرشحات_تحوي_اسما(&الناتج, &التهجئة)) {
                ألحق(الناتج, مرشح_وحدة_إكمال(التهجئة, 3));
            };
            ف := ف + 1;
        }
        ليكن النتيجة: نتيجة_إكمال_أدوات = نتيجة_إكمال(السياق, البداية, الناتج);
        أرجع النتيجة;
    };
    طابق مجلد_جذر_إكمال(البيئة, &(*الرقعة).المسار[0]) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); }
    | اختياري.موجود(المسمى) -> {
        ليكن دليل_الجذر: نص = انسخ_نص(&المسمى.الدليل);
        ليكن الجذر: معرف_جذر_مكتبة = المسمى.الجذر;
        ليكن البعد: متغير طبيعي = 3;
        طابق القياسي مع
        | اختياري.موجود(المعرف) -> {
            إذا (معرفا_جذر_مكتبة_متساويان(المعرف, الجذر)) { البعد := 4; };
        }
        | اختياري.لا_شيء -> { };
        ليكن المجلد: متغير نص = دليل_الجذر;
        // The library the walk is in: a re-exported folder continues in the
        // re-export's library.
        ليكن مكتبة_المجلد: متغير معرف_جذر_مكتبة = الجذر;
        ليكن م: متغير طبيعي = 1;
        طالما (م < العدد) {
            طابق مجلد_ابن_إكمال(&المجلد, &(*الرقعة).المسار[م]) مع
            | اختياري.موجود(الابن) -> { المجلد := الابن; }
            | اختياري.لا_شيء -> {
                طابق مجلد_معاد_إكمال(البيئة, مكتبة_المجلد, &المجلد, &(*الرقعة).المسار[م]) مع
                | اختياري.لا_شيء -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); }
                | اختياري.موجود(المعاد) -> {
                    المجلد := انسخ_نص(&المعاد.الدليل);
                    مكتبة_المجلد := المعاد.الجذر;
                };
            };
            م := م + 1;
        }
        طابق اقرأ_مدخلات_الدليل(&المجلد) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة_إكمال_فارغة(السياق, البداية); }
        | نتيجة.نجح(المدخلات) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المدخلات) مثل طبيعي)) {
                ليكن الاسم: &نص = &المدخلات[ف].الاسم;
                ليكن مخفي: منطقي = يبدأ_بـ(الاسم, &«.»);
                طابق المدخلات[ف].النوع مع
                | نوع_مدخل_دليل.دليل -> {
                    إذا (!مخفي && !مرشحات_تحوي_اسما(&الناتج, الاسم)) {
                        ألحق(الناتج, مرشح_وحدة_إكمال(انسخ_نص(الاسم), البعد));
                    };
                }
                | نوع_مدخل_دليل.ملف -> {
                    إذا (!مخفي && ينتهي_بـ(الاسم, &«.sn»)) {
                        ليكن الطول_الكلي: طبيعي = الطول(*الاسم) مثل طبيعي;
                        ليكن القاعدة: نص = نص_بين(الاسم, 0, الطول_الكلي - 3);
                        إذا (!مرشحات_تحوي_اسما(&الناتج, &القاعدة)) {
                            ألحق(الناتج, مرشح_وحدة_إكمال(القاعدة, البعد));
                        };
                    };
                }
                | _ -> { };
                ف := ف + 1;
            }
        };
        // Children the root file re-exports from another library.
        ليكن الإعادات: متجه إعادة_تصدير_وحدة = إعادات_مجلد_إكمال(&المجلد);
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < (الطول(الإعادات) مثل طبيعي)) {
            ليكن المعاد: نص = من_بايتات(&الإعادات[ر].الابن);
            إذا (!مرشحات_تحوي_اسما(&الناتج, &المعاد)) {
                ألحق(الناتج, مرشح_وحدة_إكمال(المعاد, البعد));
            };
            ر := ر + 1;
        }
        ليكن التهجئات: متجه تهجئة_ابن_وحدة = تهجئات_مجلد_إكمال(&المجلد);
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول(التهجئات) مثل طبيعي)) {
            ليكن التهجئة: نص = من_بايتات(&التهجئات[ت].التهجئة);
            إذا (!مرشحات_تحوي_اسما(&الناتج, &التهجئة)) {
                ليكن المرشح: متغير مرشح_إكمال = مرشح_وحدة_إكمال(التهجئة, البعد);
                المرشح.اللغة := اختياري.موجود(من_بايتات(&التهجئات[ت].اللغة));
                المرشح.الأصلي := اختياري.موجود(من_بايتات(&التهجئات[ت].الابن));
                ألحق(الناتج, المرشح);
            };
            ت := ت + 1;
        }
        رتب_مرشحات_إكمال(&متغير الناتج);
        ليكن النتيجة: نتيجة_إكمال_أدوات = نتيجة_إكمال(السياق, البداية, الناتج);
        أرجع النتيجة;
    };
}
