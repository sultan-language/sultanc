استورد المكتبة.ترميز.يوتيف8;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.بايتات.مقارنة;
استورد المكتبة.ملفات.مسار;
