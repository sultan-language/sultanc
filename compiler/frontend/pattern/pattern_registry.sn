استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.names.identifiers;

// السجل يحدد عقد Pattern الدلالية ومعرفاتها الثابتة.
عام نوع سجل_أنماط = {
    الأنماط: متجه نمط_دلالي
};

عام عرف سجل_أنماط_جديد(): سجل_أنماط {
    دع الأنماط: متجه نمط_دلالي = [];
    دع السجل: سجل_أنماط = { الأنماط: الأنماط };
    أرجع السجل;
}

عام عرف سجل_نمطا(السجل: &متغير سجل_أنماط, النمط: نمط_دلالي): معرف_نمط {
    دع الحالة: متغير سجل_أنماط = *السجل;
    دع المعرف: معرف_نمط = معرف_نمط_من(الطول(الحالة.الأنماط) مثل غير_موقع);
    ألحق(الحالة.الأنماط, النمط);
    *السجل := الحالة;
    أرجع المعرف;
}

عام عرف نمط_عند(السجل: &سجل_أنماط, المعرف: معرف_نمط): اختيار نمط_دلالي {
    دع الحالة: سجل_أنماط = *السجل;
    لو (المعرف.القيمة >= (الطول(الحالة.الأنماط) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_النمط: &نمط_دلالي = &الحالة.الأنماط[المعرف.القيمة];
    دع النمط: نمط_دلالي = *مرجع_النمط;
    أرجع اختيار.بعض(النمط);
}

عام عرف نطاق_نمط_عند(السجل: &سجل_أنماط, المعرف: معرف_نمط): اختيار نطاق {
    دع الموجود: اختيار نمط_دلالي = نمط_عند(السجل, المعرف);
    طابق الموجود مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النمط) -> {
        طابق النمط مع
        | نمط_دلالي.بدل(النطاق) -> {
            أرجع اختيار.بعض(النطاق);
        }
        | نمط_دلالي.ربط(النطاق, الاسم) -> {
            أرجع اختيار.بعض(النطاق);
        }
        | نمط_دلالي.صف(النطاق, العناصر) -> {
            أرجع اختيار.بعض(النطاق);
        }
        | نمط_دلالي.سجل(النطاق, الحقول) -> {
            أرجع اختيار.بعض(النطاق);
        }
        | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
            أرجع اختيار.بعض(النطاق);
        };
    };
}

// ربط exact بين نطاق AST الأصلي وهوية Pattern الدلالية. لا يعيد بناء أو تحليل النمط.
عام عرف معرف_نمط_عند_نطاق(السجل: &سجل_أنماط, النطاق: نطاق): اختيار معرف_نمط {
    دع الحالة: سجل_أنماط = *السجل;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الأنماط) مثل غير_موقع)) {
        دع المعرف: معرف_نمط = معرف_نمط_من(ف);
        طابق نطاق_نمط_عند(&الحالة, المعرف) مع
        | اختيار.بعض(نطاق_مسجل) -> {
            لو (نطاقان_متساويان(نطاق_مسجل, النطاق)) {
                أرجع اختيار.بعض(المعرف);
            };
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}
