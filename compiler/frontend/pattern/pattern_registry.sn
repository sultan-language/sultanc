استورد compiler.frontend.pattern.pattern_model;
استورد compiler.source.span;
استورد compiler.frontend.names.identifiers;

// السجل يحدد عقد Pattern الدلالية ومعرفاتها الثابتة.
عام نوع مدخل_فهرس_نمط = {
    الهاش: غير_موقع,
    النطاق: نطاق,
    المعرف: معرف_نمط
};

عام نوع سجل_أنماط = {
    الأنماط: متجه نمط_دلالي,
    فهرس_النطاقات: متجه اختيار مدخل_فهرس_نمط
};

عام عرف سجل_أنماط_جديد(): سجل_أنماط {
    دع الأنماط: متجه نمط_دلالي = [];
    دع الفهرس: متجه اختيار مدخل_فهرس_نمط = [];
    دع السجل: سجل_أنماط = { الأنماط: الأنماط, فهرس_النطاقات: الفهرس };
    أرجع السجل;
}

عرف نطاق_نمط_دلالي(النمط: &نمط_دلالي): نطاق {
    طابق *النمط مع
    | نمط_دلالي.بدل(النطاق) -> { أرجع النطاق; }
    | نمط_دلالي.ربط(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.حرفي(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.مدى(النطاق, _, _) -> { أرجع النطاق; }
    | نمط_دلالي.بدائل(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.صف(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.سجل(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.منشئ(النطاق, _, _) -> { أرجع النطاق; };
}

عرف امزج_هاش_نمط(الهاش: غير_موقع, القيمة: غير_موقع): غير_موقع {
    أرجع ((الهاش * 257) + (القيمة % 1048573)) % 1048573;
}

عرف هاش_نطاق_نمط(النطاق: نطاق): غير_موقع {
    دع الهاش: متغير غير_موقع = امزج_هاش_نمط(1, النطاق.البداية.المصدر);
    الهاش := امزج_هاش_نمط(الهاش, النطاق.البداية.البايت);
    الهاش := امزج_هاش_نمط(الهاش, النطاق.النهاية.المصدر);
    الهاش := امزج_هاش_نمط(الهاش, النطاق.النهاية.البايت);
    أرجع الهاش;
}

عرف ابن_فهرس_أنماط_فارغا(السعة: غير_موقع): متجه اختيار مدخل_فهرس_نمط {
    دع الناتج: متغير متجه اختيار مدخل_فهرس_نمط = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) { ألحق(الناتج, اختيار.لا_شيء()); ف := ف + 1; }
    أرجع الناتج;
}

عرف موضع_إدراج_فهرس_نمط(
    الفهرس: &متجه اختيار مدخل_فهرس_نمط,
    النطاق: نطاق
): اختيار غير_موقع {
    دع السعة: غير_موقع = الطول(*الفهرس) مثل غير_موقع;
    لو (السعة == 0) { أرجع اختيار.لا_شيء(); };
    دع الهاش: غير_موقع = هاش_نطاق_نمط(النطاق);
    دع الموضع: متغير غير_موقع = الهاش % السعة;
    دع المفحوص: متغير غير_موقع = 0;
    بينما (المفحوص < السعة) {
        طابق (*الفهرس)[الموضع] مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(الموضع); }
        | اختيار.بعض(المدخل) -> {
            لو (المدخل.الهاش == الهاش && نطاقان_متساويان(المدخل.النطاق, النطاق)) {
                أرجع اختيار.بعض(الموضع);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أدرج_فهرس_نمط(الفهرس: &متغير متجه اختيار مدخل_فهرس_نمط, المدخل: مدخل_فهرس_نمط): فراغ {
    طابق موضع_إدراج_فهرس_نمط(الفهرس, المدخل.النطاق) مع
    | اختيار.بعض(الموضع) -> {
        طابق (*الفهرس)[الموضع] مع
        | اختيار.لا_شيء -> { (*الفهرس)[الموضع] := اختيار.بعض(المدخل); }
        | اختيار.بعض(_) -> { };
    }
    | اختيار.لا_شيء -> { };
}

عرف أدرج_فهرس_نمط_في_السجل(السجل: &متغير سجل_أنماط, المدخل: مدخل_فهرس_نمط): فراغ {
    طابق موضع_إدراج_فهرس_نمط(&(*السجل).فهرس_النطاقات, المدخل.النطاق) مع
    | اختيار.بعض(الموضع) -> {
        طابق (*السجل).فهرس_النطاقات[الموضع] مع
        | اختيار.لا_شيء -> { (*السجل).فهرس_النطاقات[الموضع] := اختيار.بعض(المدخل); }
        | اختيار.بعض(_) -> { };
    }
    | اختيار.لا_شيء -> { };
}

عرف تأكد_سعة_فهرس_أنماط(السجل: &متغير سجل_أنماط): فراغ {
    دع العدد: غير_موقع = الطول((*السجل).الأنماط) مثل غير_موقع;
    دع القديمة: غير_موقع = الطول((*السجل).فهرس_النطاقات) مثل غير_موقع;
    دع تحتاج: متغير منطقي = القديمة == 0;
    لو (!تحتاج) { تحتاج := (العدد * 3) >= (القديمة * 2); };
    لو (!تحتاج) { أرجع; };
    دع الجديدة: متغير غير_موقع = 16;
    لو (القديمة > 0) { الجديدة := القديمة * 2; };
    دع الفهرس_الجديد: متغير متجه اختيار مدخل_فهرس_نمط = ابن_فهرس_أنماط_فارغا(الجديدة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < القديمة) {
        طابق (*السجل).فهرس_النطاقات[ف] مع
        | اختيار.بعض(المدخل) -> { أدرج_فهرس_نمط(&متغير الفهرس_الجديد, المدخل); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    (*السجل).فهرس_النطاقات := الفهرس_الجديد;
}

عرف سجل_فهرس_نمط(السجل: &متغير سجل_أنماط, المعرف: معرف_نمط, النطاق: نطاق): فراغ {
    تأكد_سعة_فهرس_أنماط(السجل);
    دع الهاش: غير_موقع = هاش_نطاق_نمط(النطاق);
    دع المدخل: مدخل_فهرس_نمط = { الهاش: الهاش, النطاق: النطاق, المعرف: المعرف };
    أدرج_فهرس_نمط_في_السجل(السجل, المدخل);
}

عرف معرف_نمط_مفهرس(السجل: &سجل_أنماط, النطاق: نطاق): اختيار معرف_نمط {
    دع السعة: غير_موقع = الطول((*السجل).فهرس_النطاقات) مثل غير_موقع;
    لو (السعة == 0) { أرجع اختيار.لا_شيء(); };
    دع الهاش: غير_موقع = هاش_نطاق_نمط(النطاق);
    دع الموضع: متغير غير_موقع = الهاش % السعة;
    دع المفحوص: متغير غير_موقع = 0;
    بينما (المفحوص < السعة) {
        طابق (*السجل).فهرس_النطاقات[الموضع] مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المدخل) -> {
            لو (المدخل.الهاش == الهاش && نطاقان_متساويان(المدخل.النطاق, النطاق)) {
                أرجع اختيار.بعض(المدخل.المعرف);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف سجل_نمطا(السجل: &متغير سجل_أنماط, النمط: نمط_دلالي): معرف_نمط {
    دع المعرف: معرف_نمط = معرف_نمط_من(الطول((*السجل).الأنماط) مثل غير_موقع);
    دع النطاق: نطاق = نطاق_نمط_دلالي(&النمط);
    ألحق((*السجل).الأنماط, النمط);
    سجل_فهرس_نمط(السجل, المعرف, النطاق);
    أرجع المعرف;
}

عام عرف نمط_عند(السجل: &سجل_أنماط, المعرف: معرف_نمط): اختيار نمط_دلالي {
    لو (المعرف.القيمة >= (الطول((*السجل).الأنماط) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_النمط: &نمط_دلالي = &(*السجل).الأنماط[المعرف.القيمة];
    دع النمط: نمط_دلالي = *مرجع_النمط;
    أرجع اختيار.بعض(النمط);
}

عام عرف نطاق_نمط_عند(السجل: &سجل_أنماط, المعرف: معرف_نمط): اختيار نطاق {
    لو (المعرف.القيمة >= (الطول((*السجل).الأنماط) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(نطاق_نمط_دلالي(&(*السجل).الأنماط[المعرف.القيمة]));
}

// ربط exact بين نطاق AST الأصلي وهوية Pattern الدلالية. لا يعيد بناء أو تحليل النمط.
عام عرف معرف_نمط_عند_نطاق(السجل: &سجل_أنماط, النطاق: نطاق): اختيار معرف_نمط {
    أرجع معرف_نمط_مفهرس(السجل, النطاق);
}
