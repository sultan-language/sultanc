استورد compiler.frontend.pattern.pattern_model;
استورد compiler.source.span;
استورد compiler.frontend.names.identifiers;

// السجل يحدد عقد Pattern الدلالية ومعرفاتها الثابتة.
// الهاش is below 1048573 (امزج_هاش_نمط reduces modulo it), so it is 32-bit;
عام نوع مدخل_فهرس_نمط = {
    الهاش: ط32,
    النطاق: نطاق,
    المعرف: معرف_نمط
};

عام نوع سجل_أنماط = {
    الأنماط: متجه نمط_دلالي,
    فهرس_النطاقات: متجه اختياري مدخل_فهرس_نمط
};

عام عرف سجل_أنماط_جديد(): سجل_أنماط {
    دع الأنماط: متجه نمط_دلالي = [];
    دع الفهرس: متجه اختياري مدخل_فهرس_نمط = [];
    دع السجل: سجل_أنماط = { الأنماط: الأنماط, فهرس_النطاقات: الفهرس };
    أرجع السجل;
}

عرف نطاق_نمط_دلالي(النمط: &نمط_دلالي): نطاق {
    طابق *النمط مع
    | نمط_دلالي.بدل(النطاق) -> { أرجع النطاق; }
    | نمط_دلالي.ربط(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.حرفي(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.مدى(النطاق, _, _) -> { أرجع النطاق; }
    | نمط_دلالي.بدائل(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.صف(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.سجل(النطاق, _) -> { أرجع النطاق; }
    | نمط_دلالي.منشئ(النطاق, _, _) -> { أرجع النطاق; };
}

عرف امزج_هاش_نمط(الهاش: طبيعي, القيمة: طبيعي): طبيعي {
    أرجع ((الهاش * 257) + (القيمة % 1048573)) % 1048573;
}

عرف هاش_نطاق_نمط(النطاق: نطاق): طبيعي {
    دع الهاش: متغير طبيعي = امزج_هاش_نمط(1, النطاق.البداية.المصدر);
    الهاش := امزج_هاش_نمط(الهاش, النطاق.البداية.البايت);
    الهاش := امزج_هاش_نمط(الهاش, النطاق.النهاية.المصدر);
    الهاش := امزج_هاش_نمط(الهاش, النطاق.النهاية.البايت);
    أرجع الهاش;
}

عرف ابن_فهرس_أنماط_فارغا(السعة: طبيعي): متجه اختياري مدخل_فهرس_نمط {
    دع الناتج: متغير متجه اختياري مدخل_فهرس_نمط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الناتج, اختياري.لا_شيء()); ف := ف + 1; }
    أرجع الناتج;
}

عرف موضع_إدراج_فهرس_نمط(
    الفهرس: &متجه اختياري مدخل_فهرس_نمط,
    النطاق: نطاق
): اختياري طبيعي {
    دع السعة: طبيعي = الطول(*الفهرس) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_نطاق_نمط(النطاق);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        طابق (*الفهرس)[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(الموضع); }
        | اختياري.موجود(المدخل) -> {
            إذا ((المدخل.الهاش مثل طبيعي) == الهاش && نطاقان_متساويان(المدخل.النطاق, النطاق)) {
                أرجع اختياري.موجود(الموضع);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أدرج_فهرس_نمط(الفهرس: &متغير متجه اختياري مدخل_فهرس_نمط, المدخل: مدخل_فهرس_نمط): فراغ {
    طابق موضع_إدراج_فهرس_نمط(الفهرس, المدخل.النطاق) مع
    | اختياري.موجود(الموضع) -> {
        طابق (*الفهرس)[الموضع] مع
        | اختياري.لا_شيء -> { (*الفهرس)[الموضع] := اختياري.موجود(المدخل); }
        | اختياري.موجود(_) -> { };
    }
    | اختياري.لا_شيء -> { };
}

عرف أدرج_فهرس_نمط_في_السجل(السجل: &متغير سجل_أنماط, المدخل: مدخل_فهرس_نمط): فراغ {
    طابق موضع_إدراج_فهرس_نمط(&(*السجل).فهرس_النطاقات, المدخل.النطاق) مع
    | اختياري.موجود(الموضع) -> {
        طابق (*السجل).فهرس_النطاقات[الموضع] مع
        | اختياري.لا_شيء -> { (*السجل).فهرس_النطاقات[الموضع] := اختياري.موجود(المدخل); }
        | اختياري.موجود(_) -> { };
    }
    | اختياري.لا_شيء -> { };
}

عرف تأكد_سعة_فهرس_أنماط(السجل: &متغير سجل_أنماط): فراغ {
    دع العدد: طبيعي = الطول((*السجل).الأنماط) مثل طبيعي;
    دع القديمة: طبيعي = الطول((*السجل).فهرس_النطاقات) مثل طبيعي;
    دع تحتاج: متغير منطقي = القديمة == 0;
    إذا (!تحتاج) { تحتاج := (العدد * 3) >= (القديمة * 2); };
    إذا (!تحتاج) { أرجع; };
    دع الجديدة: متغير طبيعي = 16;
    إذا (القديمة > 0) { الجديدة := القديمة * 2; };
    دع الفهرس_الجديد: متغير متجه اختياري مدخل_فهرس_نمط = ابن_فهرس_أنماط_فارغا(الجديدة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < القديمة) {
        طابق (*السجل).فهرس_النطاقات[ف] مع
        | اختياري.موجود(المدخل) -> { أدرج_فهرس_نمط(&متغير الفهرس_الجديد, المدخل); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    (*السجل).فهرس_النطاقات := الفهرس_الجديد;
}

عرف سجل_فهرس_نمط(السجل: &متغير سجل_أنماط, المعرف: معرف_نمط, النطاق: نطاق): فراغ {
    تأكد_سعة_فهرس_أنماط(السجل);
    دع الهاش: طبيعي = هاش_نطاق_نمط(النطاق);
    دع المدخل: مدخل_فهرس_نمط = { الهاش: الهاش مثل ط32, النطاق: النطاق, المعرف: المعرف };
    أدرج_فهرس_نمط_في_السجل(السجل, المدخل);
}

عرف معرف_نمط_مفهرس(السجل: &سجل_أنماط, النطاق: نطاق): اختياري معرف_نمط {
    دع السعة: طبيعي = الطول((*السجل).فهرس_النطاقات) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_نطاق_نمط(النطاق);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        طابق (*السجل).فهرس_النطاقات[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المدخل) -> {
            إذا ((المدخل.الهاش مثل طبيعي) == الهاش && نطاقان_متساويان(المدخل.النطاق, النطاق)) {
                أرجع اختياري.موجود(المدخل.المعرف);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف سجل_نمطا(السجل: &متغير سجل_أنماط, النمط: نمط_دلالي): معرف_نمط {
    دع المعرف: معرف_نمط = معرف_نمط_من(الطول((*السجل).الأنماط) مثل طبيعي);
    دع النطاق: نطاق = نطاق_نمط_دلالي(&النمط);
    ألحق((*السجل).الأنماط, النمط);
    سجل_فهرس_نمط(السجل, المعرف, النطاق);
    أرجع المعرف;
}

عام عرف نمط_عند(السجل: &سجل_أنماط, المعرف: معرف_نمط): اختياري نمط_دلالي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*السجل).الأنماط) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_النمط: &نمط_دلالي = &(*السجل).الأنماط[المعرف.القيمة];
    دع النمط: نمط_دلالي = انسخ_مملوكا_نمط_دلالي(مرجع_النمط);
    أرجع اختياري.موجود(النمط);
}

عام عرف نطاق_نمط_عند(السجل: &سجل_أنماط, المعرف: معرف_نمط): اختياري نطاق {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*السجل).الأنماط) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(نطاق_نمط_دلالي(&(*السجل).الأنماط[المعرف.القيمة]));
}

// ربط exact بين نطاق AST الأصلي وهوية Pattern الدلالية. لا يعيد بناء أو تحليل النمط.
عام عرف معرف_نمط_عند_نطاق(السجل: &سجل_أنماط, النطاق: نطاق): اختياري معرف_نمط {
    أرجع معرف_نمط_مفهرس(السجل, النطاق);
}
