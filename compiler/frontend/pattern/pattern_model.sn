استورد std.text.from_bytes;
استورد compiler.source.span;
استورد compiler.frontend.names.identifiers;

// معرف النمط الدلالي هو فهرس ثابت داخل سجل Pattern ولا يحمل AST أو source.
// 32-bit: made only by معرف_نمط_من, which checks it (ط32_متحقق).
عام نوع معرف_نمط = {
    القيمة: ط32
};

عام عرف معرف_نمط_من(القيمة: طبيعي): معرف_نمط {
    دع المعرف: معرف_نمط = { القيمة: ط32_متحقق(القيمة) };
    أرجع المعرف;
}

عام عرف معرفا_نمط_متساويان(أ: معرف_نمط, ب: معرف_نمط): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

// حقل السجل يجمع هويته الدلالية ونمطه ونطاقه في سجل واحد متماسك.
عام نوع حقل_نمط_دلالي = {
    الاسم: معرف_اسم,
    نطاق_الاسم: نطاق,
    النمط: معرف_نمط,
    النطاق: نطاق
};

// هذه مرجعية أسماء مقننة فقط. حل الرموز ملك Name، والتحقق البنيوي يستهلك Type عبر طبقة التكامل.
عام نوع مرجع_منشئ_نمط = {
    النوع: معرف_اسم,
    نطاق_النوع: نطاق,
    المنشئ: معرف_اسم,
    نطاق_المنشئ: نطاق
};

// القيمة الحرفية الدلالية ملك Pattern ولا تحتفظ بعقدة AST.
عام نوع قيمة_نمط_حرفي =
    | منطقي بنوع منطقي
    | عدد بنوع عدد
    | عدد_طبيعي بنوع طبيعي
    | حرف بنوع ط32
    | نص بنوع متجه ط8
;

// التمثيل الدلالي لا ينسخ Source ولا AST؛ العلاقات العودية تستخدم معرفات Pattern ثابتة.
عام نوع نمط_دلالي =
    | بدل بنوع نطاق
    | ربط بنوع (نطاق, معرف_اسم)
    | حرفي بنوع (نطاق, قيمة_نمط_حرفي)
    | مدى بنوع (نطاق, قيمة_نمط_حرفي, قيمة_نمط_حرفي)
    | بدائل بنوع (نطاق, متجه معرف_نمط)
    | صف بنوع (نطاق, متجه معرف_نمط)
    | سجل بنوع (نطاق, متجه حقل_نمط_دلالي)
    | منشئ بنوع (نطاق, مرجع_منشئ_نمط, متجه معرف_نمط)
;

عام نوع ربط_نمط = {
    الاسم: معرف_اسم,
    النمط: معرف_نمط,
    النطاق: نطاق
};

عام نوع خطأ_بناء_نمط =
    | مصدر_غير_متطابق بنوع نطاق
    | نطاق_خارج_المصدر بنوع نطاق
    | هوية_اسم_مفقودة بنوع نطاق
    | تابع_غير_صالح بنوع معرف_نمط
    | حرفي_غير_مدعوم بنوع نطاق
;

عام نوع نتيجة_بناء_نمط =
    | مبني بنوع معرف_نمط
    | مرفوض بنوع خطأ_بناء_نمط
;

عام نوع خطأ_نمط =
    | معرف_غير_صالح بنوع معرف_نمط
    | ربط_مكرر بنوع (معرف_اسم, ربط_نمط, ربط_نمط)
;

// لا يدعي Pattern اكتمال صحة البنية التي تحتاج حقائق aggregate من Type.
عام نوع حالة_تحقق_نوع_نمط =
    | مكتمل_دون_نوع
    | يتطلب_دلالات_نوع
;

عام نوع حكم_عدم_دحض_نمط =
    | غير_قابل_للدحض
    | يتطلب_دلالات_نوع
;

عام نوع تحليل_نمط = {
    الروابط: متجه ربط_نمط,
    التحقق_النوعي: حالة_تحقق_نوع_نمط,
    عدم_الدحض: حكم_عدم_دحض_نمط
};

عام نوع نتيجة_تحليل_نمط =
    | محلل بنوع تحليل_نمط
    | مرفوض بنوع خطأ_نمط
;

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_نمط_دلالي(القيمة: &نمط_دلالي): نمط_دلالي {
    طابق *القيمة مع
    | نمط_دلالي.بدل(ح0) -> { أرجع نمط_دلالي.بدل(ح0); }
    | نمط_دلالي.ربط(ح0, ح1) -> { أرجع نمط_دلالي.ربط(ح0, ح1); }
    | نمط_دلالي.حرفي(ح0, ح1) -> { أرجع نمط_دلالي.حرفي(ح0, انسخ_مملوكا_قيمة_نمط_حرفي(&ح1)); }
    | نمط_دلالي.مدى(ح0, ح1, ح2) -> { أرجع نمط_دلالي.مدى(ح0, انسخ_مملوكا_قيمة_نمط_حرفي(&ح1), انسخ_مملوكا_قيمة_نمط_حرفي(&ح2)); }
    | نمط_دلالي.بدائل(ح0, ح1) -> { أرجع نمط_دلالي.بدائل(ح0, انسخ_مملوكا_متجه_معرف_نمط(&ح1)); }
    | نمط_دلالي.صف(ح0, ح1) -> { أرجع نمط_دلالي.صف(ح0, انسخ_مملوكا_متجه_معرف_نمط(&ح1)); }
    | نمط_دلالي.سجل(ح0, ح1) -> { أرجع نمط_دلالي.سجل(ح0, انسخ_مملوكا_متجه_حقل_نمط_دلالي(&ح1)); }
    | نمط_دلالي.منشئ(ح0, ح1, ح2) -> { أرجع نمط_دلالي.منشئ(ح0, ح1, انسخ_مملوكا_متجه_معرف_نمط(&ح2)); };
}

عام عرف انسخ_مملوكا_قيمة_نمط_حرفي(القيمة: &قيمة_نمط_حرفي): قيمة_نمط_حرفي {
    طابق *القيمة مع
    | قيمة_نمط_حرفي.منطقي(ح0) -> { أرجع قيمة_نمط_حرفي.منطقي(ح0); }
    | قيمة_نمط_حرفي.عدد(ح0) -> { أرجع قيمة_نمط_حرفي.عدد(ح0); }
    | قيمة_نمط_حرفي.عدد_طبيعي(ح0) -> { أرجع قيمة_نمط_حرفي.عدد_طبيعي(ح0); }
    | قيمة_نمط_حرفي.حرف(ح0) -> { أرجع قيمة_نمط_حرفي.حرف(ح0); }
    | قيمة_نمط_حرفي.نص(ح0) -> { أرجع قيمة_نمط_حرفي.نص(انسخ_بايتات(&ح0)); };
}

عام عرف انسخ_مملوكا_متجه_معرف_نمط(القيمة: &متجه معرف_نمط): متجه معرف_نمط {
    دع الناتج: متغير متجه معرف_نمط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_حقل_نمط_دلالي(القيمة: &متجه حقل_نمط_دلالي): متجه حقل_نمط_دلالي {
    دع الناتج: متغير متجه حقل_نمط_دلالي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_ربط_نمط(القيمة: &متجه ربط_نمط): متجه ربط_نمط {
    دع الناتج: متغير متجه ربط_نمط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
