استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.names.identifiers;

// معرف النمط الدلالي هو فهرس ثابت داخل سجل Pattern ولا يحمل AST أو source.
عام نوع معرف_نمط = {
    القيمة: غير_موقع
};

عام عرف معرف_نمط_من(القيمة: غير_موقع): معرف_نمط {
    دع المعرف: معرف_نمط = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرفا_نمط_متساويان(أ: معرف_نمط, ب: معرف_نمط): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

// حقل السجل يجمع هويته الدلالية ونمطه ونطاقه في سجل واحد متماسك.
عام نوع حقل_نمط_دلالي = {
    الاسم: معرف_اسم,
    نطاق_الاسم: نطاق,
    النمط: معرف_نمط,
    النطاق: نطاق
};

// هذه مرجعية أسماء مقننة فقط. حل الرموز ملك Name، والتحقق البنيوي يستهلك Type عبر طبقة التكامل.
عام نوع مرجع_منشئ_نمط = {
    النوع: معرف_اسم,
    نطاق_النوع: نطاق,
    المنشئ: معرف_اسم,
    نطاق_المنشئ: نطاق
};

// التمثيل الدلالي لا ينسخ Source ولا AST؛ العلاقات العودية تستخدم معرفات Pattern ثابتة.
عام نوع نمط_دلالي =
    | بدل بنوع نطاق
    | ربط بنوع (نطاق, معرف_اسم)
    | صف بنوع (نطاق, متجه معرف_نمط)
    | سجل بنوع (نطاق, متجه حقل_نمط_دلالي)
    | منشئ بنوع (نطاق, مرجع_منشئ_نمط, متجه معرف_نمط)
;

عام نوع ربط_نمط = {
    الاسم: معرف_اسم,
    النمط: معرف_نمط,
    النطاق: نطاق
};

عام نوع خطأ_بناء_نمط =
    | مصدر_غير_متطابق بنوع نطاق
    | نطاق_خارج_المصدر بنوع نطاق
    | هوية_اسم_مفقودة بنوع نطاق
    | تابع_غير_صالح بنوع معرف_نمط
;

عام نوع نتيجة_بناء_نمط =
    | مبني بنوع معرف_نمط
    | مرفوض بنوع خطأ_بناء_نمط
;

عام نوع خطأ_نمط =
    | معرف_غير_صالح بنوع معرف_نمط
    | ربط_مكرر بنوع (معرف_اسم, ربط_نمط, ربط_نمط)
;

// لا يدعي Pattern اكتمال صحة البنية التي تحتاج حقائق aggregate من Type.
عام نوع حالة_تحقق_نوع_نمط =
    | مكتمل_دون_نوع
    | يتطلب_دلالات_نوع
;

عام نوع حكم_عدم_دحض_نمط =
    | غير_قابل_للدحض
    | يتطلب_دلالات_نوع
;

عام نوع تحليل_نمط = {
    الروابط: متجه ربط_نمط,
    التحقق_النوعي: حالة_تحقق_نوع_نمط,
    عدم_الدحض: حكم_عدم_دحض_نمط
};

عام نوع نتيجة_تحليل_نمط =
    | محلل بنوع تحليل_نمط
    | مرفوض بنوع خطأ_نمط
;
