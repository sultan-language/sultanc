عام نوع سياق_أنماط_وحدة = {
    الأنماط: سجل_أنماط,
    التحققات: متجه ربط_تحقق_نمط_وحدة
};

عام نوع خطأ_أنماط_وحدة =
    | بناء بنوع خطأ_بناء_نمط
    | نوعي بنوع خطأ_تكامل_نوع_نمط
;

عام نوع نتيجة_أنماط_وحدة =
    | مكتملة بنوع سياق_أنماط_وحدة
    | مرفوضة بنوع خطأ_أنماط_وحدة
;

عرف ابن_كتلة_أنماط_وحدة(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    الروابط: &سياق_روابط_أسماء,
    تكامل_النوع: &سياق_تكامل_نوع_نمط_وحدة,
    سجل_الأنماط: &متغير سجل_أنماط,
    التحققات: &متغير متجه ربط_تحقق_نمط_وحدة
): اختيار خطأ_أنماط_وحدة {
    دع القيمة: كتلة_عبارات = *الكتلة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.العبارات) مثل غير_موقع)) {
        دع العبارة: عبارة = *القيمة.العبارات[ف];
        طابق العبارة مع
        | عبارة.طابق(_, المميز, الأذرع) -> {
            دع نطاق_المميز: نطاق = نطاق_تعبير(&المميز);
            دع ذ: متغير غير_موقع = 0;
            بينما (ذ < (الطول(الأذرع) مثل غير_موقع)) {
                طابق ابن_نمطا(سجل_الأنماط, الروابط, المصدر, &الأذرع[ذ].النمط) مع
                | نتيجة_بناء_نمط.مرفوض(الخطأ) -> {
                    أرجع اختيار.بعض(خطأ_أنماط_وحدة.بناء(الخطأ));
                }
                | نتيجة_بناء_نمط.مبني(الجذر) -> {
                    طابق تحقق_ذراع_نمط_نوعيا(
                        تكامل_النوع, سجل_الأنماط, سياق_الأسماء, الروابط,
                        الجذر, نطاق_المميز
                    ) مع
                    | نتيجة_تكامل_ذراع_نمط.مرفوضة(الخطأ) -> {
                        أرجع اختيار.بعض(خطأ_أنماط_وحدة.نوعي(الخطأ));
                    }
                    | نتيجة_تكامل_ذراع_نمط.مكتملة(الربط) -> {
                        دع حالة_التحققات: متغير متجه ربط_تحقق_نمط_وحدة = *التحققات;
                        ألحق(حالة_التحققات, الربط);
                        *التحققات := حالة_التحققات;
                    };
                };
                طابق ابن_كتلة_أنماط_وحدة(
                    &الأذرع[ذ].الجسم, سياق_الأسماء, المصدر, الروابط, تكامل_النوع,
                    سجل_الأنماط, التحققات
                ) مع
                | اختيار.بعض(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | اختيار.لا_شيء -> { };
                ذ := ذ + 1;
            }
        }
        | عبارة.لكل(_, _, _, _, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            تكامل_النوع, سجل_الأنماط,
                التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
        | عبارة.بينما(_, _, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            تكامل_النوع, سجل_الأنماط,
                التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
        | عبارة.لو(_, _, أ, ب) -> {
            طابق ابن_كتلة_أنماط_وحدة(&أ, سياق_الأسماء, المصدر, الروابط, تكامل_النوع, سجل_الأنماط,
                التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { };
            طابق ب مع
        | اختيار.بعض(ج) -> { طابق ابن_كتلة_أنماط_وحدة(&ج, سياق_الأسماء, المصدر, الروابط,
                تكامل_النوع, سجل_الأنماط,
                    التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
        | _ -> { };
        }
        | عبارة.غير_آمن(_, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            تكامل_النوع, سجل_الأنماط,
                التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ابن_أنماط_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متجه سياق_روابط_أسماء,
    تكامل_النوع: &سياق_تكامل_نوع_نمط
): نتيجة_أنماط_وحدة {
    دع سجل_الأنماط: متغير سجل_أنماط = سجل_أنماط_جديد();
    دع التحققات: متغير متجه ربط_تحقق_نمط_وحدة = [];
    دع القيم: متجه وحدة_مصدر = *الوحدات;
    دع روابط_القيم: متجه سياق_روابط_أسماء = *الروابط;
    دع و: متغير غير_موقع = 0;
    بينما (و < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &القيم[و];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &روابط_القيم[و];
        دع تكامل_نوع_الوحدة: سياق_تكامل_نوع_نمط_وحدة =
            سياق_تكامل_نوع_نمط_لوحدة(تكامل_النوع, و);
        دع الأصل: وحدة_مصدر = *مرجع_الوحدة;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأصل.العناصر) مثل غير_موقع)) {
            طابق الأصل.العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                طابق الدالة.الجسم مع
                | اختيار.بعض(الجسم) -> {
                    طابق ابن_كتلة_أنماط_وحدة(
                        &الجسم, سياق_الأسماء, &الأصل.المصدر, روابط_الوحدة, &تكامل_نوع_الوحدة,
                        &متغير سجل_الأنماط, &متغير التحققات
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_أنماط_وحدة.مرفوضة(الخطأ); }
                    | اختيار.لا_شيء -> { };
                }
                | اختيار.لا_شيء -> { };
            }
            | _ -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    دع الناتج: سياق_أنماط_وحدة = {
        الأنماط: سجل_الأنماط,
        التحققات: التحققات
    };
    أرجع نتيجة_أنماط_وحدة.مكتملة(الناتج);
}

عام عرف ابن_أنماط_وحدة(
    الوحدة: &وحدة_مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    تكامل_النوع: &سياق_تكامل_نوع_نمط
): نتيجة_أنماط_وحدة {
    دع الوحدات: متغير متجه وحدة_مصدر = [];
    دع روابط_الوحدات: متغير متجه سياق_روابط_أسماء = [];
    دع الأصل: وحدة_مصدر = *الوحدة;
    دع روابط_الوحدة: سياق_روابط_أسماء = *الروابط;
    ألحق(الوحدات, الأصل);
    ألحق(روابط_الوحدات, روابط_الوحدة);
    أرجع ابن_أنماط_وحدات(&الوحدات, سياق_الأسماء, &روابط_الوحدات, تكامل_النوع);
}
