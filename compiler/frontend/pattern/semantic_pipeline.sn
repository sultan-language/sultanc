عام نوع سياق_أنماط_وحدة = {
    الأنماط: سجل_أنماط,
    التحققات: متجه ربط_تحقق_نمط_وحدة
};

عام نوع خطأ_أنماط_وحدة =
    | بناء بنوع خطأ_بناء_نمط
    | نوعي بنوع خطأ_تكامل_نوع_نمط
    // Some value of the scrutinee matches no arm (span of the match).
    | غير_شامل بنوع نطاق
;

عام نوع نتيجة_أنماط_وحدة =
    | مكتملة بنوع سياق_أنماط_وحدة
    | مرفوضة بنوع خطأ_أنماط_وحدة
    // The cancellation token was set (checked before each module).
    | ملغاة
;

عرف ابن_كتلة_أنماط_وحدة(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سجل_الأنماط: &متغير سجل_أنماط,
    التحققات: &متغير متجه ربط_تحقق_نمط_وحدة,
    التحذيرات: &متغير متجه نطاق
): اختياري خطأ_أنماط_وحدة {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكتلة).العبارات) مثل طبيعي)) {
        طابق *(*الكتلة).العبارات[ف] مع
        | عبارة.طابق(نطاق_المطابقة, المميز, الأذرع) -> {
            دع نطاق_المميز: نطاق = نطاق_تعبير(&المميز);
            دع جذور_الأذرع: متغير متجه معرف_نمط = [];
            دع مواضع_الأذرع: متغير متجه طبيعي = [];
            دع ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
                طابق ابن_نمطا(سجل_الأنماط, الروابط, المصدر, &الأذرع[ذ].النمط) مع
                | نتيجة_بناء_نمط.مرفوض(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_أنماط_وحدة.بناء(الخطأ));
                }
                | نتيجة_بناء_نمط.مبني(الجذر) -> {
                    طابق تحقق_ذراع_نمط_نوعيا(
                        الأنواع, أنواع_التعبيرات, سجل_الأنماط, سياق_الأسماء, الروابط,
                        الجذر, نطاق_المميز
                    ) مع
                    | نتيجة_تكامل_ذراع_نمط.مرفوضة(الخطأ) -> {
                        أرجع اختياري.موجود(خطأ_أنماط_وحدة.نوعي(الخطأ));
                    }
                    | نتيجة_تكامل_ذراع_نمط.مكتملة(الربط) -> {
                        ألحق(جذور_الأذرع, الجذر);
                        ألحق(مواضع_الأذرع, الطول(*التحققات) مثل طبيعي);
                        ألحق(*التحققات, الربط);
                    };
                };
                طابق ابن_كتلة_أنماط_وحدة(
                    &الأذرع[ذ].الجسم, سياق_الأسماء, المصدر, الروابط, الأنواع, أنواع_التعبيرات,
                    سجل_الأنماط, التحققات, التحذيرات
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                ذ := ذ + 1;
            }
            دع التحليل: تحليل_أذرع_مطابقة = حلل_أذرع_مطابقة(
                &جذور_الأذرع, &مواضع_الأذرع, سجل_الأنماط, التحققات, الأنواع
            );
            طابق التحليل.الشمول مع
            | حكم_شمول_مطابقة.شاملة -> { }
            | _ -> { أرجع اختياري.موجود(خطأ_أنماط_وحدة.غير_شامل(نطاق_المطابقة)); };
            // An arm an earlier arm already covers is reported, not rejected.
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول(التحليل.غير_القابلة_للوصول) مثل طبيعي)) {
                ألحق(*التحذيرات, نطاق_نمط(&الأذرع[التحليل.غير_القابلة_للوصول[ت]].النمط));
                ت := ت + 1;
            }
        }
        | عبارة.لكل(_, _, _, _, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                التحققات, التحذيرات) مع
        | اختياري.موجود(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { }; }
        | عبارة.طالما(_, _, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                التحققات, التحذيرات) مع
        | اختياري.موجود(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { }; }
        | عبارة.إذا(_, _, أ, ب) -> {
            طابق ابن_كتلة_أنماط_وحدة(&أ, سياق_الأسماء, المصدر, الروابط, الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                التحققات, التحذيرات) مع
        | اختياري.موجود(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { };
            طابق ب مع
        | اختياري.موجود(ج) -> { طابق ابن_كتلة_أنماط_وحدة(&ج, سياق_الأسماء, المصدر, الروابط,
                الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                    التحققات, التحذيرات) مع
        | اختياري.موجود(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { }; }
        | _ -> { };
        }
        | عبارة.وقت_الترجمة(_, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            الأنواع, أنواع_التعبيرات, سجل_الأنماط, التحققات, التحذيرات) مع
            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
            | _ -> { }; }
        | عبارة.إسناد_وقت_الترجمة(_, _, الجسم, _) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            الأنواع, أنواع_التعبيرات, سجل_الأنماط, التحققات, التحذيرات) مع
            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
            | _ -> { }; }
        | عبارة.غير_آمن(_, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                التحققات, التحذيرات) مع
        | اختياري.موجود(خ) -> {
            أرجع اختياري.موجود(خ);
        }
        | _ -> { }; }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ابن_أنماط_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    خريطة_المصادر: &خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متجه سياق_روابط_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    // Spans of the arms an earlier arm already covers (warnings).
    التحذيرات: &متغير متجه نطاق,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_أنماط_وحدة {
    دع سجل_الأنماط: متغير سجل_أنماط = سجل_أنماط_جديد();
    دع التحققات: متغير متجه ربط_تحقق_نمط_وحدة = [];
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي)) {
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_أنماط_وحدة.ملغاة(); };
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[و];
        دع معرف_المصدر: طبيعي = (*مرجع_الوحدة).معرف_المصدر;
        دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*الروابط)[و];
        دع أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
            طابق (*مرجع_الوحدة).العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                طابق الدالة.الجسم مع
                | اختياري.موجود(الجسم) -> {
                    طابق ابن_كتلة_أنماط_وحدة(
                        &الجسم, سياق_الأسماء, مرجع_المصدر, روابط_الوحدة, الأنواع, أنواع_تعبيرات_الوحدة,
                        &متغير سجل_الأنماط, &متغير التحققات, التحذيرات
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_أنماط_وحدة.مرفوضة(الخطأ); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    دع الناتج: سياق_أنماط_وحدة = {
        الأنماط: سجل_الأنماط,
        التحققات: التحققات
    };
    أرجع نتيجة_أنماط_وحدة.مكتملة(الناتج);
}

عام عرف ابن_أنماط_وحدة(
    الوحدة: &وحدة_مصدر,
    المصدر: &مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): نتيجة_أنماط_وحدة {
    دع سجل_الأنماط: متغير سجل_أنماط = سجل_أنماط_جديد();
    دع التحذيرات: متغير متجه نطاق = [];
    دع التحققات: متغير متجه ربط_تحقق_نمط_وحدة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
        طابق (*الوحدة).العناصر[ف] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            طابق الدالة.الجسم مع
            | اختياري.موجود(الجسم) -> {
                طابق ابن_كتلة_أنماط_وحدة(
                    &الجسم, سياق_الأسماء, المصدر, الروابط, الأنواع, أنواع_التعبيرات,
                    &متغير سجل_الأنماط, &متغير التحققات, &متغير التحذيرات
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع نتيجة_أنماط_وحدة.مرفوضة(الخطأ); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    دع الناتج: سياق_أنماط_وحدة = { الأنماط: سجل_الأنماط, التحققات: التحققات };
    أرجع نتيجة_أنماط_وحدة.مكتملة(الناتج);
}
