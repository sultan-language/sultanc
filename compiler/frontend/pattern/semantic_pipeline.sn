عام نوع سياق_أنماط_وحدة = {
    الأنماط: سجل_أنماط,
    التحققات: متجه ربط_تحقق_نمط_وحدة
};

عام نوع خطأ_أنماط_وحدة =
    | بناء بنوع خطأ_بناء_نمط
    | نوعي بنوع خطأ_تكامل_نوع_نمط
;

عام نوع نتيجة_أنماط_وحدة =
    | مكتملة بنوع سياق_أنماط_وحدة
    | مرفوضة بنوع خطأ_أنماط_وحدة
;

عرف ابن_كتلة_أنماط_وحدة(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سجل_الأنماط: &متغير سجل_أنماط,
    التحققات: &متغير متجه ربط_تحقق_نمط_وحدة
): اختيار خطأ_أنماط_وحدة {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الكتلة).العبارات) مثل غير_موقع)) {
        طابق *(*الكتلة).العبارات[ف] مع
        | عبارة.طابق(_, المميز, الأذرع) -> {
            دع نطاق_المميز: نطاق = نطاق_تعبير(&المميز);
            دع ذ: متغير غير_موقع = 0;
            بينما (ذ < (الطول(الأذرع) مثل غير_موقع)) {
                طابق ابن_نمطا(سجل_الأنماط, الروابط, المصدر, &الأذرع[ذ].النمط) مع
                | نتيجة_بناء_نمط.مرفوض(الخطأ) -> {
                    أرجع اختيار.بعض(خطأ_أنماط_وحدة.بناء(الخطأ));
                }
                | نتيجة_بناء_نمط.مبني(الجذر) -> {
                    طابق تحقق_ذراع_نمط_نوعيا(
                        الأنواع, أنواع_التعبيرات, سجل_الأنماط, سياق_الأسماء, الروابط,
                        الجذر, نطاق_المميز
                    ) مع
                    | نتيجة_تكامل_ذراع_نمط.مرفوضة(الخطأ) -> {
                        أرجع اختيار.بعض(خطأ_أنماط_وحدة.نوعي(الخطأ));
                    }
                    | نتيجة_تكامل_ذراع_نمط.مكتملة(الربط) -> {
                        ألحق(*التحققات, الربط);
                    };
                };
                طابق ابن_كتلة_أنماط_وحدة(
                    &الأذرع[ذ].الجسم, سياق_الأسماء, المصدر, الروابط, الأنواع, أنواع_التعبيرات,
                    سجل_الأنماط, التحققات
                ) مع
                | اختيار.بعض(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | اختيار.لا_شيء -> { };
                ذ := ذ + 1;
            }
        }
        | عبارة.لكل(_, _, _, _, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
        | عبارة.بينما(_, _, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
        | عبارة.لو(_, _, أ, ب) -> {
            طابق ابن_كتلة_أنماط_وحدة(&أ, سياق_الأسماء, المصدر, الروابط, الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { };
            طابق ب مع
        | اختيار.بعض(ج) -> { طابق ابن_كتلة_أنماط_وحدة(&ج, سياق_الأسماء, المصدر, الروابط,
                الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                    التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
        | _ -> { };
        }
        | عبارة.غير_آمن(_, الجسم) -> { طابق ابن_كتلة_أنماط_وحدة(&الجسم, سياق_الأسماء, المصدر, الروابط,
            الأنواع, أنواع_التعبيرات, سجل_الأنماط,
                التحققات) مع
        | اختيار.بعض(خ) -> {
            أرجع اختيار.بعض(خ);
        }
        | _ -> { }; }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ابن_أنماط_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    خريطة_المصادر: &خريطة_مصادر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متجه سياق_روابط_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات
): نتيجة_أنماط_وحدة {
    دع سجل_الأنماط: متغير سجل_أنماط = سجل_أنماط_جديد();
    دع التحققات: متغير متجه ربط_تحقق_نمط_وحدة = [];
    دع و: متغير غير_موقع = 0;
    بينما (و < (الطول(*الوحدات) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[و];
        دع معرف_المصدر: غير_موقع = (*مرجع_الوحدة).معرف_المصدر;
        دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*الروابط)[و];
        دع أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول((*مرجع_الوحدة).العناصر) مثل غير_موقع)) {
            طابق (*مرجع_الوحدة).العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                طابق الدالة.الجسم مع
                | اختيار.بعض(الجسم) -> {
                    طابق ابن_كتلة_أنماط_وحدة(
                        &الجسم, سياق_الأسماء, مرجع_المصدر, روابط_الوحدة, الأنواع, أنواع_تعبيرات_الوحدة,
                        &متغير سجل_الأنماط, &متغير التحققات
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_أنماط_وحدة.مرفوضة(الخطأ); }
                    | اختيار.لا_شيء -> { };
                }
                | اختيار.لا_شيء -> { };
            }
            | _ -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    دع الناتج: سياق_أنماط_وحدة = {
        الأنماط: سجل_الأنماط,
        التحققات: التحققات
    };
    أرجع نتيجة_أنماط_وحدة.مكتملة(الناتج);
}

عام عرف ابن_أنماط_وحدة(
    الوحدة: &وحدة_مصدر,
    المصدر: &مصدر,
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): نتيجة_أنماط_وحدة {
    دع سجل_الأنماط: متغير سجل_أنماط = سجل_أنماط_جديد();
    دع التحققات: متغير متجه ربط_تحقق_نمط_وحدة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الوحدة).العناصر) مثل غير_موقع)) {
        طابق (*الوحدة).العناصر[ف] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            طابق الدالة.الجسم مع
            | اختيار.بعض(الجسم) -> {
                طابق ابن_كتلة_أنماط_وحدة(
                    &الجسم, سياق_الأسماء, المصدر, الروابط, الأنواع, أنواع_التعبيرات,
                    &متغير سجل_الأنماط, &متغير التحققات
                ) مع
                | اختيار.بعض(الخطأ) -> { أرجع نتيجة_أنماط_وحدة.مرفوضة(الخطأ); }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    دع الناتج: سياق_أنماط_وحدة = { الأنماط: سجل_الأنماط, التحققات: التحققات };
    أرجع نتيجة_أنماط_وحدة.مكتملة(الناتج);
}
