استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.pattern_registry;
استورد compiler.frontend.pattern.pattern_analysis;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.compatibility;
استورد compiler.frontend.types.expression_types;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.context;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.types.type_context;
عرف هل_نوع_سجل_دلاليا_للنمط( سجل_الأنواع: &سجل_أنواع, النوع: معرف_نوع ): منطقي {
    طابق عدد_حقول_سجل_دلالي(سجل_الأنواع, النوع) مع
    | اختيار.بعض(العدد) -> {
        أرجع صواب; }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }; }
عرف هل_نوع_موسوم_دلاليا_للنمط( سجل_الأنواع: &سجل_أنواع, النوع: معرف_نوع ): منطقي {
    طابق عدد_منشئات_نوع_دلالي(سجل_الأنواع, النوع) مع
    | اختيار.بعض(العدد) -> {
        أرجع صواب; }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }; }
// Compatibility projection for downstream consumers that still accept the old constructor list.
// Pattern does not store this vector; it is derived from the canonical typed facts below.
عام نوع حل_منشئ_نمط = { النمط: معرف_نمط, النوع: معرف_نوع, الهوية: هوية_منشئ_نوع };
// Singular Pattern typed fact. TypeID and optional constructor identity for one PatternID live together.
عام نوع نوع_عقدة_نمط = {
    النمط: معرف_نمط,
    النوع: معرف_نوع,
    المنشئ: اختيار هوية_منشئ_نوع
};
عام نوع خطأ_تحقق_نمط_نوعي =
    | خطأ_نمط_أساسي بنوع خطأ_نمط
    | معرف_نوع_غير_صالح بنوع (معرف_نمط, معرف_نوع, نطاق)
    | نوع_غير_ملائم_للنمط بنوع (معرف_نمط, معرف_نوع, نطاق)
    | عدد_عناصر_صف_غير_متطابق بنوع (معرف_نمط, غير_موقع, غير_موقع, نطاق)
    | نوع_عنصر_صف_مفقود بنوع (معرف_نمط, غير_موقع, معرف_نوع, نطاق)
    | حقل_نمط_مكرر بنوع (معرف_نمط, معرف_اسم, نطاق, نطاق)
    | حقل_سجل_غير_موجود بنوع (معرف_نمط, معرف_اسم, معرف_نوع, نطاق)
    | حل_منشئ_مفقود بنوع (معرف_نمط, معرف_اسم, نطاق)
    | حل_منشئ_مكرر بنوع (معرف_نمط, نطاق)
    | نوع_منشئ_غير_متطابق بنوع (معرف_نمط, معرف_نوع, معرف_نوع, نطاق)
    | منشئ_ليس_للنوع بنوع (معرف_نمط, هوية_منشئ_نوع, معرف_نوع, نطاق)
    | اسم_منشئ_غير_متطابق بنوع (معرف_نمط, معرف_اسم, معرف_اسم, نطاق)
    | عدد_حمولات_منشئ_غير_متطابق بنوع (معرف_نمط, غير_موقع, غير_موقع, نطاق)
    | نوع_حمولة_منشئ_مفقود بنوع (معرف_نمط, غير_موقع, نطاق)
    | تعارض_نوع_عقدة بنوع (معرف_نمط, معرف_نوع, معرف_نوع, نطاق)
;
عام نوع تحقق_نمط_نوعي = {
    الجذر: معرف_نمط,
    الروابط: متجه ربط_نمط,
    أنواع_العقد: متجه نوع_عقدة_نمط,
    غير_قابل_للدحض: منطقي
};
عام نوع نتيجة_تحقق_نمط_نوعي =
    | صالح بنوع تحقق_نمط_نوعي
    | مرفوض بنوع خطأ_تحقق_نمط_نوعي
;
عام نوع نتيجة_عدم_دحض_نمط =
    | حكم بنوع منطقي
    | مرفوض بنوع خطأ_تحقق_نمط_نوعي
;
عام عرف حل_منشئ_نمط_من(
    النمط: معرف_نمط, النوع: معرف_نوع, الهوية: هوية_منشئ_نوع): حل_منشئ_نمط {
    دع الحل: حل_منشئ_نمط = { النمط: النمط, النوع: النوع, الهوية: الهوية };
    أرجع الحل; }
عرف أضف_نوع_عقدة(
    الأنواع: &متغير متجه نوع_عقدة_نمط,
    النمط: معرف_نمط,
    النوع: معرف_نوع,
    النطاق: نطاق
): اختيار خطأ_تحقق_نمط_نوعي {
    دع الحالة: متغير متجه نوع_عقدة_نمط = *الأنواع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        لو (معرفا_نمط_متساويان(الحالة[ف].النمط, النمط)) {
            لو (!معرفا_نوع_متساويان(الحالة[ف].النوع, النوع)) {
                أرجع اختيار.بعض(
                    خطأ_تحقق_نمط_نوعي.تعارض_نوع_عقدة(
                        النمط, الحالة[ف].النوع, النوع, النطاق
                    )
                );
            };
            أرجع اختيار.لا_شيء();
        };
        ف := ف + 1;
    }
    دع بلا_منشئ: اختيار هوية_منشئ_نوع = اختيار.لا_شيء();
    دع الحقيقة: نوع_عقدة_نمط = { النمط: النمط, النوع: النوع, المنشئ: بلا_منشئ };
    ألحق(الحالة, الحقيقة);
    *الأنواع := الحالة;
    أرجع اختيار.لا_شيء();
}

عرف أضف_منشئ_عقدة(
    الأنواع: &متغير متجه نوع_عقدة_نمط,
    النمط: معرف_نمط,
    النوع: معرف_نوع,
    الهوية: هوية_منشئ_نوع,
    النطاق: نطاق
): اختيار خطأ_تحقق_نمط_نوعي {
    دع الحالة: متغير متجه نوع_عقدة_نمط = *الأنواع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        لو (معرفا_نمط_متساويان(الحالة[ف].النمط, النمط)) {
            لو (!معرفا_نوع_متساويان(الحالة[ف].النوع, النوع)) {
                أرجع اختيار.بعض(
                    خطأ_تحقق_نمط_نوعي.تعارض_نوع_عقدة(
                        النمط, الحالة[ف].النوع, النوع, النطاق
                    )
                );
            };
            طابق الحالة[ف].المنشئ مع
            | اختيار.بعض(_) -> {
                أرجع اختيار.بعض(خطأ_تحقق_نمط_نوعي.حل_منشئ_مكرر(النمط, النطاق));
            }
            | اختيار.لا_شيء -> {
                الحالة[ف].المنشئ := اختيار.بعض(الهوية);
                *الأنواع := الحالة;
                أرجع اختيار.لا_شيء();
            };
        };
        ف := ف + 1;
    }
    دع المنشئ: اختيار هوية_منشئ_نوع = اختيار.بعض(الهوية);
    دع الحقيقة: نوع_عقدة_نمط = { النمط: النمط, النوع: النوع, المنشئ: المنشئ };
    ألحق(الحالة, الحقيقة);
    *الأنواع := الحالة;
    أرجع اختيار.لا_شيء();
}

عرف ابحث_حقيقة_نمط(
    الأنواع: &متجه نوع_عقدة_نمط,
    النمط: معرف_نمط
): اختيار نوع_عقدة_نمط {
    دع القيم: متجه نوع_عقدة_نمط = *الأنواع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (معرفا_نمط_متساويان(القيم[ف].النمط, النمط)) {
            أرجع اختيار.بعض(القيم[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ابحث_حل_منشئ(
    الأنواع: &متجه نوع_عقدة_نمط,
    النمط: معرف_نمط,
    الاسم: معرف_اسم,
    النطاق: نطاق
): نتيجة حل_منشئ_نمط, خطأ_تحقق_نمط_نوعي {
    طابق ابحث_حقيقة_نمط(الأنواع, النمط) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تحقق_نمط_نوعي.حل_منشئ_مفقود(النمط, الاسم, النطاق));
    }
    | اختيار.بعض(الحقيقة) -> {
        طابق الحقيقة.المنشئ مع
        | اختيار.بعض(الهوية) -> {
            أرجع نتيجة.نجح(حل_منشئ_نمط_من(الحقيقة.النمط, الحقيقة.النوع, الهوية));
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_تحقق_نمط_نوعي.حل_منشئ_مفقود(النمط, الاسم, النطاق));
        };
    };
}
عرف حقل_مكرر_قبل( الحقول: &متجه حقل_نمط_دلالي, الفهرس: غير_موقع ): اختيار نطاق { دع القيم: متجه حقل_نمط_دلالي = *الحقول;
    دع الحالي: حقل_نمط_دلالي = القيم[الفهرس];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الفهرس) {
        لو (معرفا_اسم_متساويان(القيم[ف].الاسم, الحالي.الاسم)) {
            أرجع اختيار.بعض(القيم[ف].نطاق_الاسم);
        };
        ف := ف + 1; }
    أرجع اختيار.لا_شيء(); }
عرف تحقق_عقدة_نوعيا(سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, النمط: معرف_نمط,
    النوع: معرف_نوع, أنواع_العقد: &متغير متجه نوع_عقدة_نمط ): نتيجة منطقي, خطأ_تحقق_نمط_نوعي {
    دع الموجود: اختيار نمط_دلالي = نمط_عند(سجل_الأنماط, النمط);
    طابق الموجود مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.خطأ_نمط_أساسي(خطأ_نمط.معرف_غير_صالح(النمط)) ); }
    | اختيار.بعض(القيمة) -> {
        دع النطاق: اختيار نطاق = نطاق_نمط_عند(سجل_الأنماط, النمط);
        طابق النطاق مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.خطأ_نمط_أساسي(خطأ_نمط.معرف_غير_صالح(النمط)) ); }
        | اختيار.بعض(نطاق_النمط) -> {
            لو (!معرف_نوع_دلالي_صالح(سجل_الأنواع, النوع)) {
                أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.معرف_نوع_غير_صالح(النمط, النوع, نطاق_النمط) );
            };
            طابق أضف_نوع_عقدة(أنواع_العقد, النمط, النوع, نطاق_النمط) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع نتيجة.خطأ(الخطأ); }
            | اختيار.لا_شيء -> { };
            طابق القيمة مع
            | نمط_دلالي.بدل(س) -> {
                أرجع نتيجة.نجح(صواب); }
            | نمط_دلالي.ربط(س, الاسم) -> {
                أرجع نتيجة.نجح(صواب); }
            | نمط_دلالي.صف(س, العناصر) -> {
                طابق عدد_عناصر_صف_دلالي(سجل_الأنواع, النوع) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س) ); }
                | اختيار.بعض(العدد) -> {
                    دع عدد_النمط: غير_موقع = الطول(العناصر) مثل غير_موقع;
                    لو (العدد != عدد_النمط) {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.عدد_عناصر_صف_غير_متطابق( النمط, العدد, عدد_النمط, س ) );
                    };
                    دع الكل: متغير منطقي = صواب;
                    دع ف: متغير غير_موقع = 0;
                    بينما (ف < العدد) {
                        طابق نوع_عنصر_صف_دلالي_عند(سجل_الأنواع, النوع, ف) مع
                        | اختيار.لا_شيء -> {
                            أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_عنصر_صف_مفقود( النمط, ف, النوع, س ) ); }
                        | اختيار.بعض(نوع_الابن) -> {دع نتيجة_الابن: نتيجة منطقي, خطأ_تحقق_نمط_نوعي= تحقق_عقدة_نوعيا(
                                سجل_الأنماط, سجل_الأنواع, العناصر[ف], نوع_الابن, أنواع_العقد );
                            طابق نتيجة_الابن مع
                            | نتيجة.خطأ(الخطأ) -> {
                                أرجع نتيجة.خطأ(الخطأ); }
                            | نتيجة.نجح(غير_قابل) -> {
                                الكل := الكل && غير_قابل;
                            };
                        };
                        ف := ف + 1; }
                    أرجع نتيجة.نجح(الكل);
                }; }
            | نمط_دلالي.سجل(س, الحقول) -> {
                لو (!هل_نوع_سجل_دلاليا_للنمط(سجل_الأنواع, النوع)) {
                    أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س) );
                };
                دع الكل: متغير منطقي = صواب;
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(الحقول) مثل غير_موقع)) {
                    دع الحقل: حقل_نمط_دلالي = الحقول[ف];
                    طابق حقل_مكرر_قبل(&الحقول, ف) مع
                    | اختيار.بعض(الأول) -> {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.حقل_نمط_مكرر( النمط, الحقل.الاسم, الأول, الحقل.نطاق_الاسم ) );
                    }
                    | اختيار.لا_شيء -> { };
                    طابق نوع_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, النوع, الحقل.الاسم) مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.حقل_سجل_غير_موجود( النمط, الحقل.الاسم, النوع, الحقل.نطاق_الاسم
                        ) ); }
                    | اختيار.بعض(نوع_الابن) -> {
                        دع نتيجة_الابن: نتيجة منطقي, خطأ_تحقق_نمط_نوعي = تحقق_عقدة_نوعيا(
                            سجل_الأنماط, سجل_الأنواع, الحقل.النمط, نوع_الابن, أنواع_العقد );
                        طابق نتيجة_الابن مع
                        | نتيجة.خطأ(الخطأ) -> {
                            أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(غير_قابل) -> {
                            الكل := الكل && غير_قابل;
                        };
                    };
                    ف := ف + 1; }
                أرجع نتيجة.نجح(الكل); }
            | نمط_دلالي.منشئ(س, المرجع, الحمولات) -> {
                لو (!هل_نوع_موسوم_دلاليا_للنمط(سجل_الأنواع, النوع)) {
                    أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س) );
                };
                دع الحل_نتيجة: نتيجة حل_منشئ_نمط, خطأ_تحقق_نمط_نوعي = ابحث_حل_منشئ(
                    أنواع_العقد, النمط, المرجع.المنشئ, المرجع.نطاق_المنشئ );
                طابق الحل_نتيجة مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الحل) -> {
                    لو (!نوعان_متوافقان(سجل_الأنواع, الحل.النوع, النوع)) {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_منشئ_غير_متطابق(
                            النمط, الحل.النوع, النوع, المرجع.نطاق_النوع ) );
                    };
                    طابق وصف_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, النوع, الحل.الهوية) مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.منشئ_ليس_للنوع( النمط, الحل.الهوية, النوع, المرجع.نطاق_المنشئ
                        ) ); }
                    | اختيار.بعض(وصف_المنشئ) -> {
                        طابق اسم_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, النوع, الحل.الهوية) مع
                        | اختيار.بعض(اسم_النوع) -> {
                            لو (!معرفا_اسم_متساويان(اسم_النوع, المرجع.المنشئ)) {
                                أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.اسم_منشئ_غير_متطابق(
                                    النمط, المرجع.المنشئ, اسم_النوع, المرجع.نطاق_المنشئ ) );
                            }; }
                        | اختيار.لا_شيء -> { };
                        دع عدد_النوع: غير_موقع = وصف_المنشئ.عدد_الحمولات;
                        دع عدد_النمط: غير_موقع = الطول(الحمولات) مثل غير_موقع;
                        لو (عدد_النوع != عدد_النمط) {
                            أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.عدد_حمولات_منشئ_غير_متطابق( النمط, عدد_النوع, عدد_النمط, س
                            ) );
                        };
                        دع الكل: متغير منطقي = صواب;
                        دع ف: متغير غير_موقع = 0;
                        بينما (ف < عدد_النوع) {
                            طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(سجل_الأنواع, النوع, الحل.الهوية, ف) مع
                            | اختيار.لا_شيء -> {
                                أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_حمولة_منشئ_مفقود( النمط, ف, س ) ); }
                            | اختيار.بعض(نوع_الابن) -> {
                                دع نتيجة_الابن: نتيجة منطقي, خطأ_تحقق_نمط_نوعي = تحقق_عقدة_نوعيا(
                                    سجل_الأنماط, سجل_الأنواع, الحمولات[ف], نوع_الابن, أنواع_العقد );
                                طابق نتيجة_الابن مع
                                | نتيجة.خطأ(الخطأ) -> {
                                    أرجع نتيجة.خطأ(الخطأ); }
                                | نتيجة.نجح(غير_قابل) -> {
                                    الكل := الكل && غير_قابل;
                                };
                            };
                            ف := ف + 1; }
                        طابق عدد_منشئات_نوع_دلالي(سجل_الأنواع, النوع) مع
                        | اختيار.لا_شيء -> {
                            أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س) ); }
                        | اختيار.بعض(عدد_المنشئات) -> {
                            أرجع نتيجة.نجح((عدد_المنشئات == 1) && الكل);
                        };
                    };
                };
            };
        };
    }; }
عام عرف تحقق_نمط_مع_نوع(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, النمط: معرف_نمط, النوع: معرف_نوع
): نتيجة_تحقق_نمط_نوعي { طابق حلل_نمطا_دلاليا(سجل_الأنماط, النمط) مع
    | نتيجة_تحليل_نمط.مرفوض(الخطأ) -> {
        أرجع نتيجة_تحقق_نمط_نوعي.مرفوض( خطأ_تحقق_نمط_نوعي.خطأ_نمط_أساسي(الخطأ) ); }
    | نتيجة_تحليل_نمط.محلل(التحليل) -> {
        دع أنواع_العقد: متغير متجه نوع_عقدة_نمط = *حقائق_الأنماط;
        دع الحكم: نتيجة منطقي, خطأ_تحقق_نمط_نوعي = تحقق_عقدة_نوعيا(
            سجل_الأنماط, سجل_الأنواع, النمط, النوع, &متغير أنواع_العقد );
        طابق الحكم مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_تحقق_نمط_نوعي.مرفوض(الخطأ); }
        | نتيجة.نجح(غير_قابل) -> {
            دع مرجع_الروابط: &متجه ربط_نمط = &التحليل.الروابط;
            دع روابط_النتيجة: متجه ربط_نمط = *مرجع_الروابط;
            دع الناتج: تحقق_نمط_نوعي = { الجذر: النمط, الروابط: روابط_النتيجة, أنواع_العقد: أنواع_العقد, غير_قابل_للدحض: غير_قابل };
            أرجع نتيجة_تحقق_نمط_نوعي.صالح(الناتج);
        };
    }; }
عام عرف هل_نمط_غير_قابل_للدحض_مع_نوع(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, النمط: معرف_نمط, النوع: معرف_نوع
): نتيجة_عدم_دحض_نمط { طابق تحقق_نمط_مع_نوع( سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, النمط, النوع ) مع
    | نتيجة_تحقق_نمط_نوعي.مرفوض(الخطأ) -> {
        أرجع نتيجة_عدم_دحض_نمط.مرفوض(الخطأ); }
    | نتيجة_تحقق_نمط_نوعي.صالح(التحقق) -> {
        أرجع نتيجة_عدم_دحض_نمط.حكم(التحقق.غير_قابل_للدحض);
    }; }
عام عرف نوع_عقدة_نمط_عند(التحقق: &تحقق_نمط_نوعي, النمط: معرف_نمط): اختيار معرف_نوع { دع القيمة: تحقق_نمط_نوعي = *التحقق;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.أنواع_العقد) مثل غير_موقع)) {
        لو (معرفا_نمط_متساويان(القيمة.أنواع_العقد[ف].النمط, النمط)) {
            أرجع اختيار.بعض(القيمة.أنواع_العقد[ف].النوع);
        };
        ف := ف + 1; }
    أرجع اختيار.لا_شيء(); }
عام نوع صنف_نمط_متحقق =
    | بدل
    | ربط
    | صف
    | سجل
    | منشئ
;
عام عرف صنف_نمط_متحقق_عند(سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط): اختيار صنف_نمط_متحقق {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | نمط_دلالي.بدل(س) -> {
            أرجع اختيار.بعض(صنف_نمط_متحقق.بدل()); }
        | نمط_دلالي.ربط(س, ا) -> {
            أرجع اختيار.بعض(صنف_نمط_متحقق.ربط()); }
        | نمط_دلالي.صف(س, ع) -> {
            أرجع اختيار.بعض(صنف_نمط_متحقق.صف()); }
        | نمط_دلالي.سجل(س, ح) -> {
            أرجع اختيار.بعض(صنف_نمط_متحقق.سجل()); }
            | نمط_دلالي.منشئ(س, م, ح) -> { أرجع اختيار.بعض(صنف_نمط_متحقق.منشئ());
        };
    }; }
عام عرف نوع_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختيار معرف_نوع {
    طابق تحقق_نمط_مع_نوع(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر) مع
    | نتيجة_تحقق_نمط_نوعي.مرفوض(الخطأ) -> {
        أرجع اختيار.لا_شيء(); }
        | نتيجة_تحقق_نمط_نوعي.صالح(التحقق) -> { أرجع نوع_عقدة_نمط_عند(&التحقق, النمط);
    }; }
عام عرف رمز_ربط_نمط_متحقق_عند( سجل_الأنماط: &سجل_أنماط, روابط_الأسماء: &سياق_روابط_أسماء, النمط: معرف_نمط
): اختيار معرف_رمز { طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختيار.بعض(نمط_دلالي.ربط(النطاق, الاسم)) -> {
        أرجع رمز_اسم_محلول_عند(روابط_الأسماء, النطاق); }
        | _ -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف هوية_منشئ_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختيار هوية_منشئ_نوع {
    طابق نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        طابق ابحث_حقيقة_نمط(حقائق_الأنماط, النمط) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الحقيقة) -> { أرجع الحقيقة.المنشئ; };
    }; }
عام عرف ترتيب_منشئ_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختيار غير_موقع {
    طابق نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        طابق هوية_منشئ_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الهوية) -> {
            أرجع ترتيب_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, النوع, الهوية);
        };
    }; }
عام عرف عدد_حمولات_منشئ_نمط_متحقق_عند(سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط): اختيار غير_موقع {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختيار.بعض(نمط_دلالي.منشئ(س, م, الحمولات)) -> {
        أرجع اختيار.بعض(الطول(الحمولات) مثل غير_موقع); }
        | _ -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف نمط_حمولة_منشئ_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: غير_موقع): اختيار معرف_نمط { طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختيار.بعض(نمط_دلالي.منشئ(س, م, الحمولات)) -> {
            لو (الفهرس >= (الطول(الحمولات) مثل غير_موقع)) { أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(الحمولات[الفهرس]); }
        | _ -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف نوع_حمولة_منشئ_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط, الفهرس: غير_موقع ): اختيار معرف_نوع {
    طابق نمط_حمولة_منشئ_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختيار.بعض(الابن) -> {
        أرجع نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, الابن); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف عدد_عناصر_صف_نمط_متحقق_عند(سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط): اختيار غير_موقع {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختيار.بعض(نمط_دلالي.صف(س, العناصر)) -> {
        أرجع اختيار.بعض(الطول(العناصر) مثل غير_موقع); }
        | _ -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف نمط_عنصر_صف_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: غير_موقع): اختيار معرف_نمط { طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختيار.بعض(نمط_دلالي.صف(س, العناصر)) -> {
            لو (الفهرس >= (الطول(العناصر) مثل غير_موقع)) { أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(العناصر[الفهرس]); }
        | _ -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف نوع_عنصر_صف_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط, الفهرس: غير_موقع ): اختيار معرف_نوع {
    طابق نمط_عنصر_صف_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختيار.بعض(الابن) -> {
        أرجع نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, الابن); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف عدد_حقول_سجل_نمط_متحقق_عند(سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط): اختيار غير_موقع {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختيار.بعض(نمط_دلالي.سجل(س, الحقول)) -> {
        أرجع اختيار.بعض(الطول(الحقول) مثل غير_موقع); }
        | _ -> { أرجع اختيار.لا_شيء();
    }; }
عرف حقل_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: غير_موقع): اختيار حقل_نمط_دلالي {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختيار.بعض(نمط_دلالي.سجل(س, الحقول)) -> {
            لو (الفهرس >= (الطول(الحقول) مثل غير_موقع)) { أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(الحقول[الفهرس]); }
        | _ -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف هوية_حقل_سجل_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: غير_موقع): اختيار معرف_اسم {
    طابق حقل_نمط_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختيار.بعض(الحقل) -> {
        أرجع اختيار.بعض(الحقل.الاسم); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف نمط_حقل_سجل_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: غير_موقع): اختيار معرف_نمط {
    طابق حقل_نمط_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختيار.بعض(الحقل) -> {
        أرجع اختيار.بعض(الحقل.النمط); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف ترتيب_حقل_سجل_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط, فهرس_النمط: غير_موقع ): اختيار غير_موقع {
    طابق نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        طابق هوية_حقل_سجل_نمط_متحقق_عند(سجل_الأنماط, النمط, فهرس_النمط) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> {
            أرجع ترتيب_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, النوع, الاسم);
        };
    }; }
عام عرف نوع_حقل_سجل_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط, الفهرس: غير_موقع ): اختيار معرف_نوع {
    طابق نمط_حقل_سجل_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختيار.بعض(الابن) -> {
        أرجع نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, الابن); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء();
    }; }
عام عرف هل_نمط_متحقق_غير_قابل_للدحض_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختيار منطقي {
    طابق نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        طابق هل_نمط_غير_قابل_للدحض_مع_نوع(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, النمط, النوع) مع
        | نتيجة_عدم_دحض_نمط.حكم(الحكم) -> {
            أرجع اختيار.بعض(الحكم); }
            | نتيجة_عدم_دحض_نمط.مرفوض(الخطأ) -> { أرجع اختيار.لا_شيء();
        };
    }; }
عام عرف هل_نمط_متحقق_قابل_للدحض_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختيار منطقي {
    طابق هل_نمط_متحقق_غير_قابل_للدحض_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختيار.بعض(الحكم) -> {
        أرجع اختيار.بعض(!الحكم); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء();
    }; }

// Pattern's only whole-unit bridge to Type. The orchestration layer receives this
// opaque Pattern-side integration contract and never imports Type implementation/query modules.
عام نوع سياق_تكامل_نوع_نمط = {
    سجل_الأنواع: سجل_أنواع,
    أنواع_التعبيرات: متجه سياق_أنواع_تعبيرات
};

عام نوع سياق_تكامل_نوع_نمط_وحدة = {
    سجل_الأنواع: سجل_أنواع,
    أنواع_التعبيرات: سياق_أنواع_تعبيرات
};

عام عرف سياق_تكامل_نوع_نمط_من(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات
): سياق_تكامل_نوع_نمط {
    دع سجل: سجل_أنواع = *الأنواع;
    دع التعبيرات: متجه سياق_أنواع_تعبيرات = *أنواع_التعبيرات;
    دع الناتج: سياق_تكامل_نوع_نمط = { سجل_الأنواع: سجل, أنواع_التعبيرات: التعبيرات };
    أرجع الناتج;
}

عام عرف سياق_تكامل_نوع_نمط_لوحدة(
    التكامل: &سياق_تكامل_نوع_نمط,
    الفهرس: غير_موقع
): سياق_تكامل_نوع_نمط_وحدة {
    دع الحالة: سياق_تكامل_نوع_نمط = *التكامل;
    دع مرجع_السجل: &سجل_أنواع = &الحالة.سجل_الأنواع;
    دع سجل: سجل_أنواع = *مرجع_السجل;
    دع مرجع_التعبيرات: &سياق_أنواع_تعبيرات = &الحالة.أنواع_التعبيرات[الفهرس];
    دع التعبيرات: سياق_أنواع_تعبيرات = *مرجع_التعبيرات;
    دع الناتج: سياق_تكامل_نوع_نمط_وحدة = { سجل_الأنواع: سجل, أنواع_التعبيرات: التعبيرات };
    أرجع الناتج;
}

عام نوع خطأ_تكامل_نوع_نمط =
    | نوع_مميز_مفقود بنوع نطاق
    | ربط_منشئ_مفقود بنوع نطاق
    | منشئ_غير_دلالي بنوع نطاق
    | تحقق بنوع نطاق
;

عام نوع ربط_تحقق_نمط_وحدة = {
    التحقق: تحقق_نمط_نوعي
};

عام نوع نتيجة_تكامل_ذراع_نمط =
    | مكتملة بنوع ربط_تحقق_نمط_وحدة
    | مرفوضة بنوع خطأ_تكامل_نوع_نمط
;

عرف ابن_حلول_منشئات_نمط_نوعيا(
    السجل: &سجل_أنماط,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    النمط: معرف_نمط,
    النوع: معرف_نوع,
    الحقائق: &متغير متجه نوع_عقدة_نمط
): اختيار خطأ_تكامل_نوع_نمط {
    طابق نمط_عند(السجل, النمط) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(القيمة) -> {
        طابق نطاق_نمط_عند(السجل, النمط) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_تكامل_نوع_نمط.تحقق(نطاق_فارغ()));
        }
        | اختيار.بعض(نطاق_العقدة) -> {
            طابق أضف_نوع_عقدة(الحقائق, النمط, النوع, نطاق_العقدة) مع
            | اختيار.بعض(_) -> {
                أرجع اختيار.بعض(خطأ_تكامل_نوع_نمط.تحقق(نطاق_العقدة));
            }
            | اختيار.لا_شيء -> { };
        };
        طابق القيمة مع
        | نمط_دلالي.بدل(_) -> { }
        | نمط_دلالي.ربط(_, _) -> { }
        | نمط_دلالي.صف(_, العناصر) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف) مع
                | اختيار.بعض(نوع_الابن) -> {
                    طابق ابن_حلول_منشئات_نمط_نوعيا(السجل, سياق_الأسماء, الأنواع, الروابط, العناصر[ف], نوع_الابن, الحقائق) مع
                    | اختيار.بعض(الخطأ) -> {
                        أرجع اختيار.بعض(الخطأ);
                    }
                    | اختيار.لا_شيء -> { };
                }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }
        }
        | نمط_دلالي.سجل(_, الحقول) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحقول) مثل غير_موقع)) {
                طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, النوع, الحقول[ف].الاسم) مع
                | اختيار.بعض(نوع_الابن) -> {
                    طابق ابن_حلول_منشئات_نمط_نوعيا(السجل, سياق_الأسماء, الأنواع, الروابط, الحقول[ف].النمط, نوع_الابن, الحقائق) مع
                    | اختيار.بعض(الخطأ) -> {
                        أرجع اختيار.بعض(الخطأ);
                    }
                    | اختيار.لا_شيء -> { };
                }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }
        }
        | نمط_دلالي.منشئ(_, المرجع, الحمولات) -> {
            // Builtin Option/Result constructors have canonical Type identities but no
            // declaration Symbols. Resolve them first against the expected semantic Type;
            // named enums retain the existing Symbol -> Type constructor identity path.
            دع هوية_مختارة: متغير اختيار هوية_منشئ_نوع = هوية_منشئ_مدمج_دلالية_بالأسماء(
                سياق_الأسماء, الأنواع, النوع, المرجع.النوع, المرجع.المنشئ
            );
            طابق هوية_مختارة مع
            | اختيار.بعض(_) -> { }
            | اختيار.لا_شيء -> {
                طابق رمز_اسم_محلول_عند(الروابط, المرجع.نطاق_المنشئ) مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.بعض(
                        خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(المرجع.نطاق_المنشئ)
                    );
                }
                | اختيار.بعض(الرمز) -> {
                    طابق هوية_منشئ_تعداد_دلالية_بالرمز(الأنواع, النوع, الرمز) مع
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.بعض(
                            خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(المرجع.نطاق_المنشئ)
                        );
                    }
                    | اختيار.بعض(الهوية) -> {
                        هوية_مختارة := اختيار.بعض(الهوية);
                    };
                };
            };

            طابق هوية_مختارة مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(
                    خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(المرجع.نطاق_المنشئ)
                );
            }
            | اختيار.بعض(الهوية) -> {
                طابق أضف_منشئ_عقدة(الحقائق, النمط, النوع, الهوية, المرجع.نطاق_المنشئ) مع
                | اختيار.بعض(_) -> {
                    أرجع اختيار.بعض(خطأ_تكامل_نوع_نمط.تحقق(المرجع.نطاق_المنشئ));
                }
                | اختيار.لا_شيء -> { };
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(الحمولات) مثل غير_موقع)) {
                    طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع, الهوية, ف) مع
                    | اختيار.بعض(نوع_الابن) -> {
                        طابق ابن_حلول_منشئات_نمط_نوعيا(
                            السجل, سياق_الأسماء, الأنواع, الروابط,
                            الحمولات[ف], نوع_الابن, الحقائق
                        ) مع
                        | اختيار.بعض(الخطأ) -> {
                            أرجع اختيار.بعض(الخطأ);
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> { };
                    ف := ف + 1;
                }
            };
        };
        أرجع اختيار.لا_شيء();
    };
}

عام عرف تحقق_ذراع_نمط_نوعيا(
    التكامل: &سياق_تكامل_نوع_نمط_وحدة,
    السجل: &سجل_أنماط,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الجذر: معرف_نمط,
    نطاق_المميز: نطاق
): نتيجة_تكامل_ذراع_نمط {
    دع الحالة: سياق_تكامل_نوع_نمط_وحدة = *التكامل;
    طابق نوع_تعبير_عند(&الحالة.أنواع_التعبيرات, نطاق_المميز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تكامل_ذراع_نمط.مرفوضة(خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(نطاق_المميز));
    }
    | اختيار.بعض(نوع_المميز) -> {
        دع حقائق_الأنماط: متغير متجه نوع_عقدة_نمط = [];
        طابق ابن_حلول_منشئات_نمط_نوعيا(
            السجل, سياق_الأسماء, &الحالة.سجل_الأنواع, الروابط,
            الجذر, نوع_المميز, &متغير حقائق_الأنماط
        ) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_تكامل_ذراع_نمط.مرفوضة(الخطأ);
        }
        | اختيار.لا_شيء -> { };
        طابق تحقق_نمط_مع_نوع(
            السجل, &الحالة.سجل_الأنواع, &حقائق_الأنماط, الجذر, نوع_المميز
        ) مع
        | نتيجة_تحقق_نمط_نوعي.مرفوض(الخطأ) -> {
            طابق نطاق_نمط_عند(السجل, الجذر) مع
            | اختيار.بعض(نطاق_النمط) -> {
                أرجع نتيجة_تكامل_ذراع_نمط.مرفوضة(خطأ_تكامل_نوع_نمط.تحقق(نطاق_النمط));
            }
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تكامل_ذراع_نمط.مرفوضة(خطأ_تكامل_نوع_نمط.تحقق(نطاق_المميز));
            };
        }
        | نتيجة_تحقق_نمط_نوعي.صالح(التحقق) -> {
            دع الربط: ربط_تحقق_نمط_وحدة = { التحقق: التحقق };
            أرجع نتيجة_تكامل_ذراع_نمط.مكتملة(الربط);
        };
    };
}

// Type-validation exposes only the stable index of a whole-unit Pattern verification record.
// Consumers borrow the stored verification in place instead of moving its owned vectors.
عام عرف فهرس_تحقق_ربط_نمط_وحدة_عند(
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الجذر: معرف_نمط
): اختيار غير_موقع {
    دع الحالة: متجه ربط_تحقق_نمط_وحدة = *التحققات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        لو (معرفا_نمط_متساويان(الحالة[ف].التحقق.الجذر, الجذر)) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

// Downstream consumers use the verification that Pattern already produced.
// These queries never rerun Pattern type validation.
عام عرف هوية_منشئ_نمط_محلولة_عند(
    التحقق: &تحقق_نمط_نوعي,
    النمط: معرف_نمط
): اختيار هوية_منشئ_نوع {
    دع القيمة: تحقق_نمط_نوعي = *التحقق;
    طابق ابحث_حقيقة_نمط(&القيمة.أنواع_العقد, النمط) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الحقيقة) -> { أرجع الحقيقة.المنشئ; };
}

// Legacy downstream view only. Canonical ownership remains in each stored verification.
// This projection is rebuilt from the singular Pattern typed facts and is never stored by Frontend.
عام عرف حلول_منشئات_من_تحققات(
    التحققات: &متجه ربط_تحقق_نمط_وحدة
): متجه حل_منشئ_نمط {
    دع القيم: متجه ربط_تحقق_نمط_وحدة = *التحققات;
    دع الناتج: متغير متجه حل_منشئ_نمط = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_التحقق: &تحقق_نمط_نوعي = &القيم[ف].التحقق;
        دع التحقق: تحقق_نمط_نوعي = *مرجع_التحقق;
        دع ح: متغير غير_موقع = 0;
        بينما (ح < (الطول(التحقق.أنواع_العقد) مثل غير_موقع)) {
            دع الحقيقة: نوع_عقدة_نمط = التحقق.أنواع_العقد[ح];
            طابق الحقيقة.المنشئ مع
            | اختيار.بعض(الهوية) -> {
                ألحق(الناتج, حل_منشئ_نمط_من(الحقيقة.النمط, الحقيقة.النوع, الهوية));
            }
            | اختيار.لا_شيء -> { };
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف ترتيب_منشئ_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنواع: &سجل_أنواع,
    الحلول: &متجه حل_منشئ_نمط,
    النمط: معرف_نمط
): اختيار غير_موقع {
    دع القيمة: تحقق_نمط_نوعي = *التحقق;
    طابق ابحث_حقيقة_نمط(&القيمة.أنواع_العقد, النمط) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الحقيقة) -> {
        طابق الحقيقة.المنشئ مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الهوية) -> {
            أرجع ترتيب_منشئ_نوع_دلالي_بالهوية(
                سجل_الأنواع, الحقيقة.النوع, الهوية
            );
        };
    };
}

عام عرف نوع_حمولة_منشئ_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    النمط: معرف_نمط,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    طابق نمط_حمولة_منشئ_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختيار.بعض(الابن) -> { أرجع نوع_عقدة_نمط_عند(التحقق, الابن); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عام عرف ترتيب_حقل_سجل_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    سجل_الأنواع: &سجل_أنواع,
    النمط: معرف_نمط,
    فهرس_النمط: غير_موقع
): اختيار غير_موقع {
    طابق نوع_عقدة_نمط_عند(التحقق, النمط) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النوع) -> {
        طابق هوية_حقل_سجل_نمط_متحقق_عند(سجل_الأنماط, النمط, فهرس_النمط) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الاسم) -> {
            أرجع ترتيب_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, النوع, الاسم);
        };
    };
}

عام عرف نوع_حقل_سجل_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    النمط: معرف_نمط,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    طابق نمط_حقل_سجل_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختيار.بعض(الابن) -> { أرجع نوع_عقدة_نمط_عند(التحقق, الابن); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عام عرف نوع_عنصر_صف_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    النمط: معرف_نمط,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    طابق نمط_عنصر_صف_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختيار.بعض(الابن) -> { أرجع نوع_عقدة_نمط_عند(التحقق, الابن); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}
