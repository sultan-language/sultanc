عرف هل_نوع_سجل_دلاليا_للنمط( سجل_الأنواع: &سجل_أنواع, النوع: معرف_نوع ): منطقي {
    طابق عدد_حقول_سجل_دلالي(سجل_الأنواع, النوع) مع
    | اختياري.موجود(العدد) -> {
        أرجع صواب; }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }; }
عرف هل_نوع_موسوم_دلاليا_للنمط( سجل_الأنواع: &سجل_أنواع, النوع: معرف_نوع ): منطقي {
    طابق عدد_منشئات_نوع_دلالي(سجل_الأنواع, النوع) مع
    | اختياري.موجود(العدد) -> {
        أرجع صواب; }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }; }

عرف هل_نوع_بدائي_يساوي_للنمط(
    سجل_الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المتوقع: نوع_بدائي_مقنن
): منطقي {
    طابق أزل_غلاف_متغير(سجل_الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق وصف_شكل_نوع_دلالي_عند(سجل_الأنواع, الأساس) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الوصف) -> {
            طابق الوصف.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع البدائي == المتوقع; }
            | _ -> { أرجع خطأ; };
        };
    };
}

عرف هل_حرفي_يلائم_نوع_نمط(
    سجل_الأنواع: &سجل_أنواع,
    الحرفي: &قيمة_نمط_حرفي,
    النوع: معرف_نوع
): منطقي {
    دع القيمة: قيمة_نمط_حرفي = *الحرفي;
    طابق القيمة مع
    | قيمة_نمط_حرفي.عدد(العدد) -> {
        أرجع هل_عدد_صحيح_يلائم(سجل_الأنواع, العدد, النوع);
    }
    | قيمة_نمط_حرفي.عدد_طبيعي(العدد) -> {
        أرجع هل_عدد_صحيح_طبيعي_يلائم(سجل_الأنواع, العدد, النوع);
    }
    | قيمة_نمط_حرفي.منطقي(_) -> {
        أرجع هل_نوع_بدائي_يساوي_للنمط(سجل_الأنواع, النوع, نوع_بدائي_مقنن.منطقي());
    }
    | قيمة_نمط_حرفي.حرف(_) -> {
        أرجع هل_نوع_بدائي_يساوي_للنمط(سجل_الأنواع, النوع, نوع_بدائي_مقنن.حرف());
    }
    | قيمة_نمط_حرفي.نص(_) -> {
        أرجع هل_نوع_بدائي_يساوي_للنمط(سجل_الأنواع, النوع, نوع_بدائي_مقنن.نص());
    };
}

عرف هل_حدا_مدى_صالحان(
    الأدنى: &قيمة_نمط_حرفي,
    الأعلى: &قيمة_نمط_حرفي
): منطقي {
    طابق *الأدنى مع
    | قيمة_نمط_حرفي.عدد(أ) -> {
        طابق *الأعلى مع
        | قيمة_نمط_حرفي.عدد(ب) -> { أرجع أ <= ب; }
        | قيمة_نمط_حرفي.عدد_طبيعي(ب) -> {
            لو (أ < 0) { أرجع صواب; };
            أرجع (أ مثل طبيعي) <= ب;
        }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.عدد_طبيعي(أ) -> {
        طابق *الأعلى مع
        | قيمة_نمط_حرفي.عدد_طبيعي(ب) -> { أرجع أ <= ب; }
        | قيمة_نمط_حرفي.عدد(ب) -> {
            لو (ب < 0) { أرجع خطأ; };
            أرجع أ <= (ب مثل طبيعي);
        }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.حرف(أ) -> {
        طابق *الأعلى مع
        | قيمة_نمط_حرفي.حرف(ب) -> { أرجع أ <= ب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// Compatibility projection for downstream consumers that still accept the old constructor list.
// Pattern does not store this vector; it is derived from the canonical typed facts below.
عام نوع حل_منشئ_نمط = { النمط: معرف_نمط, النوع: معرف_نوع, الهوية: هوية_منشئ_نوع };
// Singular Pattern typed fact. TypeID and optional constructor identity for one PatternID live together.
عام نوع نوع_عقدة_نمط = {
    النمط: معرف_نمط,
    النوع: معرف_نوع,
    المنشئ: اختياري هوية_منشئ_نوع
};
عام نوع خطأ_تحقق_نمط_نوعي =
    | خطأ_نمط_أساسي بنوع خطأ_نمط
    | معرف_نوع_غير_صالح بنوع (معرف_نمط, معرف_نوع, نطاق)
    | نوع_غير_ملائم_للنمط بنوع (معرف_نمط, معرف_نوع, نطاق)
    | عدد_عناصر_صف_غير_متطابق بنوع (معرف_نمط, طبيعي, طبيعي, نطاق)
    | نوع_عنصر_صف_مفقود بنوع (معرف_نمط, طبيعي, معرف_نوع, نطاق)
    | حقل_نمط_مكرر بنوع (معرف_نمط, معرف_اسم, نطاق, نطاق)
    | حقل_سجل_غير_موجود بنوع (معرف_نمط, معرف_اسم, معرف_نوع, نطاق)
    | حل_منشئ_مفقود بنوع (معرف_نمط, معرف_اسم, نطاق)
    | حل_منشئ_مكرر بنوع (معرف_نمط, نطاق)
    | نوع_منشئ_غير_متطابق بنوع (معرف_نمط, معرف_نوع, معرف_نوع, نطاق)
    | منشئ_ليس_للنوع بنوع (معرف_نمط, هوية_منشئ_نوع, معرف_نوع, نطاق)
    | اسم_منشئ_غير_متطابق بنوع (معرف_نمط, معرف_اسم, معرف_اسم, نطاق)
    | عدد_حمولات_منشئ_غير_متطابق بنوع (معرف_نمط, طبيعي, طبيعي, نطاق)
    | نوع_حمولة_منشئ_مفقود بنوع (معرف_نمط, طبيعي, نطاق)
    | تعارض_نوع_عقدة بنوع (معرف_نمط, معرف_نوع, معرف_نوع, نطاق)
;
عام نوع تحقق_نمط_نوعي = {
    الجذر: معرف_نمط,
    الروابط: متجه ربط_نمط,
    أنواع_العقد: متجه نوع_عقدة_نمط,
    غير_قابل_للدحض: منطقي
};
عام نوع نتيجة_تحقق_نمط_نوعي =
    | صالح بنوع تحقق_نمط_نوعي
    | مرفوض بنوع خطأ_تحقق_نمط_نوعي
;
عام نوع نتيجة_عدم_دحض_نمط =
    | حكم بنوع منطقي
    | مرفوض بنوع خطأ_تحقق_نمط_نوعي
;
عام عرف حل_منشئ_نمط_من(
    النمط: معرف_نمط, النوع: معرف_نوع, الهوية: هوية_منشئ_نوع): حل_منشئ_نمط {
    دع الحل: حل_منشئ_نمط = { النمط: النمط, النوع: النوع, الهوية: الهوية };
    أرجع الحل; }
عرف أضف_نوع_عقدة(
    الأنواع: &متغير متجه نوع_عقدة_نمط,
    النمط: معرف_نمط,
    النوع: معرف_نوع,
    النطاق: نطاق
): اختياري خطأ_تحقق_نمط_نوعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأنواع) مثل طبيعي)) {
        لو (معرفا_نمط_متساويان((*الأنواع)[ف].النمط, النمط)) {
            لو (!معرفا_نوع_متساويان((*الأنواع)[ف].النوع, النوع)) {
                أرجع اختياري.موجود(
                    خطأ_تحقق_نمط_نوعي.تعارض_نوع_عقدة(
                        النمط, (*الأنواع)[ف].النوع, النوع, النطاق
                    )
                );
            };
            أرجع اختياري.لا_شيء();
        };
        ف := ف + 1;
    }
    دع بلا_منشئ: اختياري هوية_منشئ_نوع = اختياري.لا_شيء();
    دع الحقيقة: نوع_عقدة_نمط = { النمط: النمط, النوع: النوع, المنشئ: بلا_منشئ };
    ألحق(*الأنواع, الحقيقة);
    أرجع اختياري.لا_شيء();
}

عرف أضف_منشئ_عقدة(
    الأنواع: &متغير متجه نوع_عقدة_نمط,
    النمط: معرف_نمط,
    النوع: معرف_نوع,
    الهوية: هوية_منشئ_نوع,
    النطاق: نطاق
): اختياري خطأ_تحقق_نمط_نوعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأنواع) مثل طبيعي)) {
        لو (معرفا_نمط_متساويان((*الأنواع)[ف].النمط, النمط)) {
            لو (!معرفا_نوع_متساويان((*الأنواع)[ف].النوع, النوع)) {
                أرجع اختياري.موجود(
                    خطأ_تحقق_نمط_نوعي.تعارض_نوع_عقدة(
                        النمط, (*الأنواع)[ف].النوع, النوع, النطاق
                    )
                );
            };
            طابق (*الأنواع)[ف].المنشئ مع
            | اختياري.موجود(_) -> {
                أرجع اختياري.موجود(خطأ_تحقق_نمط_نوعي.حل_منشئ_مكرر(النمط, النطاق));
            }
            | اختياري.لا_شيء -> {
                (*الأنواع)[ف].المنشئ := اختياري.موجود(الهوية);
                أرجع اختياري.لا_شيء();
            };
        };
        ف := ف + 1;
    }
    دع المنشئ: اختياري هوية_منشئ_نوع = اختياري.موجود(الهوية);
    دع الحقيقة: نوع_عقدة_نمط = { النمط: النمط, النوع: النوع, المنشئ: المنشئ };
    ألحق(*الأنواع, الحقيقة);
    أرجع اختياري.لا_شيء();
}

عرف ابحث_حقيقة_نمط(
    الأنواع: &متجه نوع_عقدة_نمط,
    النمط: معرف_نمط
): اختياري نوع_عقدة_نمط {
    دع القيم: متجه نوع_عقدة_نمط = *الأنواع;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        لو (معرفا_نمط_متساويان(القيم[ف].النمط, النمط)) {
            أرجع اختياري.موجود(القيم[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابحث_حل_منشئ(
    الأنواع: &متجه نوع_عقدة_نمط,
    النمط: معرف_نمط,
    الاسم: معرف_اسم,
    النطاق: نطاق
): نتيجة حل_منشئ_نمط, خطأ_تحقق_نمط_نوعي {
    طابق ابحث_حقيقة_نمط(الأنواع, النمط) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_تحقق_نمط_نوعي.حل_منشئ_مفقود(النمط, الاسم, النطاق));
    }
    | اختياري.موجود(الحقيقة) -> {
        طابق الحقيقة.المنشئ مع
        | اختياري.موجود(الهوية) -> {
            أرجع نتيجة.نجح(حل_منشئ_نمط_من(الحقيقة.النمط, الحقيقة.النوع, الهوية));
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_تحقق_نمط_نوعي.حل_منشئ_مفقود(النمط, الاسم, النطاق));
        };
    };
}
عرف حقل_مكرر_قبل( الحقول: &متجه حقل_نمط_دلالي, الفهرس: طبيعي ): اختياري نطاق { دع القيم: متجه حقل_نمط_دلالي = *الحقول;
    دع الحالي: حقل_نمط_دلالي = القيم[الفهرس];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الفهرس) {
        لو (معرفا_اسم_متساويان(القيم[ف].الاسم, الحالي.الاسم)) {
            أرجع اختياري.موجود(القيم[ف].نطاق_الاسم);
        };
        ف := ف + 1; }
    أرجع اختياري.لا_شيء(); }
عرف تحقق_عقدة_نوعيا(سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, النمط: معرف_نمط,
    النوع: معرف_نوع, أنواع_العقد: &متغير متجه نوع_عقدة_نمط ): نتيجة منطقي, خطأ_تحقق_نمط_نوعي {
    دع الموجود: اختياري نمط_دلالي = نمط_عند(سجل_الأنماط, النمط);
    طابق الموجود مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.خطأ_نمط_أساسي(خطأ_نمط.معرف_غير_صالح(النمط)) ); }
    | اختياري.موجود(القيمة) -> {
        دع النطاق: اختياري نطاق = نطاق_نمط_عند(سجل_الأنماط, النمط);
        طابق النطاق مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.خطأ_نمط_أساسي(خطأ_نمط.معرف_غير_صالح(النمط)) ); }
        | اختياري.موجود(نطاق_النمط) -> {
            لو (!معرف_نوع_دلالي_صالح(سجل_الأنواع, النوع)) {
                أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.معرف_نوع_غير_صالح(النمط, النوع, نطاق_النمط) );
            };
            طابق أضف_نوع_عقدة(أنواع_العقد, النمط, النوع, نطاق_النمط) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع نتيجة.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق القيمة مع
            | نمط_دلالي.بدل(س) -> {
                أرجع نتيجة.نجح(صواب); }
            | نمط_دلالي.ربط(س, الاسم) -> {
                أرجع نتيجة.نجح(صواب); }
            | نمط_دلالي.حرفي(س, الحرفي) -> {
                لو (!هل_حرفي_يلائم_نوع_نمط(سجل_الأنواع, &الحرفي, النوع)) {
                    أرجع نتيجة.خطأ(
                        خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س)
                    );
                };
                أرجع نتيجة.نجح(خطأ);
            }
            | نمط_دلالي.مدى(س, الأدنى, الأعلى) -> {
                لو (!هل_حرفي_يلائم_نوع_نمط(سجل_الأنواع, &الأدنى, النوع)
                    || !هل_حرفي_يلائم_نوع_نمط(سجل_الأنواع, &الأعلى, النوع)
                    || !هل_حدا_مدى_صالحان(&الأدنى, &الأعلى)) {
                    أرجع نتيجة.خطأ(
                        خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س)
                    );
                };
                أرجع نتيجة.نجح(خطأ);
            }
            | نمط_دلالي.بدائل(س, البدائل) -> {
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(البدائل) مثل طبيعي)) {
                    طابق تحقق_عقدة_نوعيا(
                        سجل_الأنماط, سجل_الأنواع, البدائل[ف], النوع, أنواع_العقد
                    ) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                    ف := ف + 1;
                }
                أرجع نتيجة.نجح(خطأ);
            }
            | نمط_دلالي.صف(س, العناصر) -> {
                طابق عدد_عناصر_صف_دلالي(سجل_الأنواع, النوع) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س) ); }
                | اختياري.موجود(العدد) -> {
                    دع عدد_النمط: طبيعي = الطول(العناصر) مثل طبيعي;
                    لو (العدد != عدد_النمط) {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.عدد_عناصر_صف_غير_متطابق( النمط, العدد, عدد_النمط, س ) );
                    };
                    دع الكل: متغير منطقي = صواب;
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < العدد) {
                        طابق نوع_عنصر_صف_دلالي_عند(سجل_الأنواع, النوع, ف) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_عنصر_صف_مفقود( النمط, ف, النوع, س ) ); }
                        | اختياري.موجود(نوع_الابن) -> {دع نتيجة_الابن: نتيجة منطقي, خطأ_تحقق_نمط_نوعي= تحقق_عقدة_نوعيا(
                                سجل_الأنماط, سجل_الأنواع, العناصر[ف], نوع_الابن, أنواع_العقد );
                            طابق نتيجة_الابن مع
                            | نتيجة.خطأ(الخطأ) -> {
                                أرجع نتيجة.خطأ(الخطأ); }
                            | نتيجة.نجح(غير_قابل) -> {
                                الكل := الكل && غير_قابل;
                            };
                        };
                        ف := ف + 1; }
                    أرجع نتيجة.نجح(الكل);
                }; }
            | نمط_دلالي.سجل(س, الحقول) -> {
                لو (!هل_نوع_سجل_دلاليا_للنمط(سجل_الأنواع, النوع)) {
                    أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س) );
                };
                دع الكل: متغير منطقي = صواب;
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الحقول) مثل طبيعي)) {
                    دع الحقل: حقل_نمط_دلالي = الحقول[ف];
                    طابق حقل_مكرر_قبل(&الحقول, ف) مع
                    | اختياري.موجود(الأول) -> {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.حقل_نمط_مكرر( النمط, الحقل.الاسم, الأول, الحقل.نطاق_الاسم ) );
                    }
                    | اختياري.لا_شيء -> { };
                    طابق نوع_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, النوع, الحقل.الاسم) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.حقل_سجل_غير_موجود( النمط, الحقل.الاسم, النوع, الحقل.نطاق_الاسم
                        ) ); }
                    | اختياري.موجود(نوع_الابن) -> {
                        دع نتيجة_الابن: نتيجة منطقي, خطأ_تحقق_نمط_نوعي = تحقق_عقدة_نوعيا(
                            سجل_الأنماط, سجل_الأنواع, الحقل.النمط, نوع_الابن, أنواع_العقد );
                        طابق نتيجة_الابن مع
                        | نتيجة.خطأ(الخطأ) -> {
                            أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(غير_قابل) -> {
                            الكل := الكل && غير_قابل;
                        };
                    };
                    ف := ف + 1; }
                أرجع نتيجة.نجح(الكل); }
            | نمط_دلالي.منشئ(س, المرجع, الحمولات) -> {
                لو (!هل_نوع_موسوم_دلاليا_للنمط(سجل_الأنواع, النوع)) {
                    أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س) );
                };
                دع الحل_نتيجة: نتيجة حل_منشئ_نمط, خطأ_تحقق_نمط_نوعي = ابحث_حل_منشئ(
                    أنواع_العقد, النمط, المرجع.المنشئ, المرجع.نطاق_المنشئ );
                طابق الحل_نتيجة مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الحل) -> {
                    لو (!نوعان_متوافقان(سجل_الأنواع, الحل.النوع, النوع)) {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_منشئ_غير_متطابق(
                            النمط, الحل.النوع, النوع, المرجع.نطاق_النوع ) );
                    };
                    طابق وصف_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, النوع, الحل.الهوية) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.منشئ_ليس_للنوع( النمط, الحل.الهوية, النوع, المرجع.نطاق_المنشئ
                        ) ); }
                    | اختياري.موجود(وصف_المنشئ) -> {
                        // The constructor identity was resolved from its Symbol (or, for
                        // option/result, from its canonical name), so the spelling is not
                        // compared again: a constructor alias such as
                        // `exit_status.exited` names `حالة_إنهاء.خرج` by another name.
                        دع عدد_النوع: طبيعي = وصف_المنشئ.عدد_الحمولات;
                        دع عدد_النمط: طبيعي = الطول(الحمولات) مثل طبيعي;
                        لو (عدد_النوع != عدد_النمط) {
                            أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.عدد_حمولات_منشئ_غير_متطابق( النمط, عدد_النوع, عدد_النمط, س
                            ) );
                        };
                        دع الكل: متغير منطقي = صواب;
                        دع ف: متغير طبيعي = 0;
                        طالما (ف < عدد_النوع) {
                            طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(سجل_الأنواع, النوع, الحل.الهوية, ف) مع
                            | اختياري.لا_شيء -> {
                                أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_حمولة_منشئ_مفقود( النمط, ف, س ) ); }
                            | اختياري.موجود(نوع_الابن) -> {
                                دع نتيجة_الابن: نتيجة منطقي, خطأ_تحقق_نمط_نوعي = تحقق_عقدة_نوعيا(
                                    سجل_الأنماط, سجل_الأنواع, الحمولات[ف], نوع_الابن, أنواع_العقد );
                                طابق نتيجة_الابن مع
                                | نتيجة.خطأ(الخطأ) -> {
                                    أرجع نتيجة.خطأ(الخطأ); }
                                | نتيجة.نجح(غير_قابل) -> {
                                    الكل := الكل && غير_قابل;
                                };
                            };
                            ف := ف + 1; }
                        طابق عدد_منشئات_نوع_دلالي(سجل_الأنواع, النوع) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة.خطأ( خطأ_تحقق_نمط_نوعي.نوع_غير_ملائم_للنمط(النمط, النوع, س) ); }
                        | اختياري.موجود(عدد_المنشئات) -> {
                            أرجع نتيجة.نجح((عدد_المنشئات == 1) && الكل);
                        };
                    };
                };
            };
        };
    }; }
عام عرف تحقق_نمط_مع_نوع(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, النمط: معرف_نمط, النوع: معرف_نوع
): نتيجة_تحقق_نمط_نوعي { طابق حلل_نمطا_دلاليا(سجل_الأنماط, النمط) مع
    | نتيجة_تحليل_نمط.مرفوض(الخطأ) -> {
        أرجع نتيجة_تحقق_نمط_نوعي.مرفوض( خطأ_تحقق_نمط_نوعي.خطأ_نمط_أساسي(الخطأ) ); }
    | نتيجة_تحليل_نمط.محلل(التحليل) -> {
        دع أنواع_العقد: متغير متجه نوع_عقدة_نمط = انسخ_مملوكا_متجه_نوع_عقدة_نمط(حقائق_الأنماط);
        دع الحكم: نتيجة منطقي, خطأ_تحقق_نمط_نوعي = تحقق_عقدة_نوعيا(
            سجل_الأنماط, سجل_الأنواع, النمط, النوع, &متغير أنواع_العقد );
        طابق الحكم مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_تحقق_نمط_نوعي.مرفوض(الخطأ); }
        | نتيجة.نجح(غير_قابل) -> {
            دع مرجع_الروابط: &متجه ربط_نمط = &التحليل.الروابط;
            دع روابط_النتيجة: متجه ربط_نمط = انسخ_مملوكا_متجه_ربط_نمط(مرجع_الروابط);
            دع الناتج: تحقق_نمط_نوعي = { الجذر: النمط, الروابط: روابط_النتيجة, أنواع_العقد: أنواع_العقد, غير_قابل_للدحض: غير_قابل };
            أرجع نتيجة_تحقق_نمط_نوعي.صالح(الناتج);
        };
    }; }
عام عرف هل_نمط_غير_قابل_للدحض_مع_نوع(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, النمط: معرف_نمط, النوع: معرف_نوع
): نتيجة_عدم_دحض_نمط { طابق تحقق_نمط_مع_نوع( سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, النمط, النوع ) مع
    | نتيجة_تحقق_نمط_نوعي.مرفوض(الخطأ) -> {
        أرجع نتيجة_عدم_دحض_نمط.مرفوض(الخطأ); }
    | نتيجة_تحقق_نمط_نوعي.صالح(التحقق) -> {
        أرجع نتيجة_عدم_دحض_نمط.حكم(التحقق.غير_قابل_للدحض);
    }; }
عام عرف نوع_عقدة_نمط_عند(التحقق: &تحقق_نمط_نوعي, النمط: معرف_نمط): اختياري معرف_نوع { دع القيمة: تحقق_نمط_نوعي = *التحقق;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة.أنواع_العقد) مثل طبيعي)) {
        لو (معرفا_نمط_متساويان(القيمة.أنواع_العقد[ف].النمط, النمط)) {
            أرجع اختياري.موجود(القيمة.أنواع_العقد[ف].النوع);
        };
        ف := ف + 1; }
    أرجع اختياري.لا_شيء(); }
عام نوع صنف_نمط_متحقق =
    | بدل
    | ربط
    | حرفي
    | مدى
    | بدائل
    | صف
    | سجل
    | منشئ
;
عام عرف صنف_نمط_متحقق_عند(سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط): اختياري صنف_نمط_متحقق {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | نمط_دلالي.بدل(س) -> {
            أرجع اختياري.موجود(صنف_نمط_متحقق.بدل()); }
        | نمط_دلالي.ربط(س, ا) -> {
            أرجع اختياري.موجود(صنف_نمط_متحقق.ربط()); }
        | نمط_دلالي.حرفي(_, _) -> {
            أرجع اختياري.موجود(صنف_نمط_متحقق.حرفي()); }
        | نمط_دلالي.مدى(_, _, _) -> {
            أرجع اختياري.موجود(صنف_نمط_متحقق.مدى()); }
        | نمط_دلالي.بدائل(_, _) -> {
            أرجع اختياري.موجود(صنف_نمط_متحقق.بدائل()); }
        | نمط_دلالي.صف(س, ع) -> {
            أرجع اختياري.موجود(صنف_نمط_متحقق.صف()); }
        | نمط_دلالي.سجل(س, ح) -> {
            أرجع اختياري.موجود(صنف_نمط_متحقق.سجل()); }
            | نمط_دلالي.منشئ(س, م, ح) -> { أرجع اختياري.موجود(صنف_نمط_متحقق.منشئ());
        };
    }; }
عام عرف نوع_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختياري معرف_نوع {
    طابق تحقق_نمط_مع_نوع(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر) مع
    | نتيجة_تحقق_نمط_نوعي.مرفوض(الخطأ) -> {
        أرجع اختياري.لا_شيء(); }
        | نتيجة_تحقق_نمط_نوعي.صالح(التحقق) -> { أرجع نوع_عقدة_نمط_عند(&التحقق, النمط);
    }; }
عام عرف رمز_ربط_نمط_متحقق_عند( سجل_الأنماط: &سجل_أنماط, روابط_الأسماء: &سياق_روابط_أسماء, النمط: معرف_نمط
): اختياري معرف_رمز { طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.موجود(نمط_دلالي.ربط(النطاق, الاسم)) -> {
        أرجع رمز_اسم_محلول_عند(روابط_الأسماء, النطاق); }
        | _ -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف هوية_منشئ_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختياري هوية_منشئ_نوع {
    طابق نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        طابق ابحث_حقيقة_نمط(حقائق_الأنماط, النمط) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الحقيقة) -> { أرجع الحقيقة.المنشئ; };
    }; }
عام عرف ترتيب_منشئ_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختياري طبيعي {
    طابق نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        طابق هوية_منشئ_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الهوية) -> {
            أرجع ترتيب_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, النوع, الهوية);
        };
    }; }
عام عرف عدد_حمولات_منشئ_نمط_متحقق_عند(سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط): اختياري طبيعي {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.موجود(نمط_دلالي.منشئ(س, م, الحمولات)) -> {
        أرجع اختياري.موجود(الطول(الحمولات) مثل طبيعي); }
        | _ -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف نمط_حمولة_منشئ_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: طبيعي): اختياري معرف_نمط { طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.موجود(نمط_دلالي.منشئ(س, م, الحمولات)) -> {
            لو (الفهرس >= (الطول(الحمولات) مثل طبيعي)) { أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(الحمولات[الفهرس]); }
        | _ -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف نوع_حمولة_منشئ_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط, الفهرس: طبيعي ): اختياري معرف_نوع {
    طابق نمط_حمولة_منشئ_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختياري.موجود(الابن) -> {
        أرجع نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, الابن); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف عدد_عناصر_صف_نمط_متحقق_عند(سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط): اختياري طبيعي {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.موجود(نمط_دلالي.صف(س, العناصر)) -> {
        أرجع اختياري.موجود(الطول(العناصر) مثل طبيعي); }
        | _ -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف نمط_عنصر_صف_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: طبيعي): اختياري معرف_نمط { طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.موجود(نمط_دلالي.صف(س, العناصر)) -> {
            لو (الفهرس >= (الطول(العناصر) مثل طبيعي)) { أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(العناصر[الفهرس]); }
        | _ -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف نوع_عنصر_صف_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط, الفهرس: طبيعي ): اختياري معرف_نوع {
    طابق نمط_عنصر_صف_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختياري.موجود(الابن) -> {
        أرجع نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, الابن); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف عدد_حقول_سجل_نمط_متحقق_عند(سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط): اختياري طبيعي {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.موجود(نمط_دلالي.سجل(س, الحقول)) -> {
        أرجع اختياري.موجود(الطول(الحقول) مثل طبيعي); }
        | _ -> { أرجع اختياري.لا_شيء();
    }; }
عرف حقل_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: طبيعي): اختياري حقل_نمط_دلالي {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.موجود(نمط_دلالي.سجل(س, الحقول)) -> {
            لو (الفهرس >= (الطول(الحقول) مثل طبيعي)) { أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(الحقول[الفهرس]); }
        | _ -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف هوية_حقل_سجل_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: طبيعي): اختياري معرف_اسم {
    طابق حقل_نمط_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختياري.موجود(الحقل) -> {
        أرجع اختياري.موجود(الحقل.الاسم); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف نمط_حقل_سجل_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, النمط: معرف_نمط, الفهرس: طبيعي): اختياري معرف_نمط {
    طابق حقل_نمط_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختياري.موجود(الحقل) -> {
        أرجع اختياري.موجود(الحقل.النمط); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف ترتيب_حقل_سجل_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط, فهرس_النمط: طبيعي ): اختياري طبيعي {
    طابق نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        طابق هوية_حقل_سجل_نمط_متحقق_عند(سجل_الأنماط, النمط, فهرس_النمط) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الاسم) -> {
            أرجع ترتيب_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, النوع, الاسم);
        };
    }; }
عام عرف نوع_حقل_سجل_نمط_متحقق_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط, الفهرس: طبيعي ): اختياري معرف_نوع {
    طابق نمط_حقل_سجل_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختياري.موجود(الابن) -> {
        أرجع نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, الابن); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء();
    }; }
عام عرف هل_نمط_متحقق_غير_قابل_للدحض_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختياري منطقي {
    طابق نوع_نمط_متحقق_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        طابق هل_نمط_غير_قابل_للدحض_مع_نوع(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, النمط, النوع) مع
        | نتيجة_عدم_دحض_نمط.حكم(الحكم) -> {
            أرجع اختياري.موجود(الحكم); }
            | نتيجة_عدم_دحض_نمط.مرفوض(الخطأ) -> { أرجع اختياري.لا_شيء();
        };
    }; }
عام عرف هل_نمط_متحقق_قابل_للدحض_عند(
    سجل_الأنماط: &سجل_أنماط, سجل_الأنواع: &سجل_أنواع, حقائق_الأنماط: &متجه نوع_عقدة_نمط, الجذر: معرف_نمط,
    نوع_الجذر: معرف_نوع, النمط: معرف_نمط ): اختياري منطقي {
    طابق هل_نمط_متحقق_غير_قابل_للدحض_عند(سجل_الأنماط, سجل_الأنواع, حقائق_الأنماط, الجذر, نوع_الجذر, النمط) مع
    | اختياري.موجود(الحكم) -> {
        أرجع اختياري.موجود(!الحكم); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء();
    }; }

// Pattern borrows canonical Type state directly; no phase-local Type integration copy.
عام نوع خطأ_تكامل_نوع_نمط =
    | نوع_مميز_مفقود بنوع نطاق
    | ربط_منشئ_مفقود بنوع نطاق
    | منشئ_غير_دلالي بنوع نطاق
    | تحقق بنوع نطاق
;

عام نوع ربط_تحقق_نمط_وحدة = {
    التحقق: تحقق_نمط_نوعي
};

عام نوع نتيجة_تكامل_ذراع_نمط =
    | مكتملة بنوع ربط_تحقق_نمط_وحدة
    | مرفوضة بنوع خطأ_تكامل_نوع_نمط
;

عرف ابن_حلول_منشئات_نمط_نوعيا(
    السجل: &سجل_أنماط,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    النمط: معرف_نمط,
    النوع: معرف_نوع,
    الحقائق: &متغير متجه نوع_عقدة_نمط
): اختياري خطأ_تكامل_نوع_نمط {
    طابق نمط_عند(السجل, النمط) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(القيمة) -> {
        طابق نطاق_نمط_عند(السجل, النمط) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_تكامل_نوع_نمط.تحقق(نطاق_فارغ()));
        }
        | اختياري.موجود(نطاق_العقدة) -> {
            طابق أضف_نوع_عقدة(الحقائق, النمط, النوع, نطاق_العقدة) مع
            | اختياري.موجود(_) -> {
                أرجع اختياري.موجود(خطأ_تكامل_نوع_نمط.تحقق(نطاق_العقدة));
            }
            | اختياري.لا_شيء -> { };
        };
        طابق القيمة مع
        | نمط_دلالي.بدل(_) -> { }
        | نمط_دلالي.ربط(_, _) -> { }
        | نمط_دلالي.حرفي(_, _) -> { }
        | نمط_دلالي.مدى(_, _, _) -> { }
        | نمط_دلالي.بدائل(_, البدائل) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(البدائل) مثل طبيعي)) {
                طابق ابن_حلول_منشئات_نمط_نوعيا(
                    السجل, سياق_الأسماء, الأنواع, الروابط, البدائل[ف], النوع, الحقائق
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
        }
        | نمط_دلالي.صف(_, العناصر) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(العناصر) مثل طبيعي)) {
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف) مع
                | اختياري.موجود(نوع_الابن) -> {
                    طابق ابن_حلول_منشئات_نمط_نوعيا(السجل, سياق_الأسماء, الأنواع, الروابط, العناصر[ف], نوع_الابن, الحقائق) مع
                    | اختياري.موجود(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
        }
        | نمط_دلالي.سجل(_, الحقول) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحقول) مثل طبيعي)) {
                طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, النوع, الحقول[ف].الاسم) مع
                | اختياري.موجود(نوع_الابن) -> {
                    طابق ابن_حلول_منشئات_نمط_نوعيا(السجل, سياق_الأسماء, الأنواع, الروابط, الحقول[ف].النمط, نوع_الابن, الحقائق) مع
                    | اختياري.موجود(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
        }
        | نمط_دلالي.منشئ(_, المرجع, الحمولات) -> {
            // Builtin Option/Result constructors have canonical Type identities but no
            // declaration Symbols. Resolve them first against the expected semantic Type;
            // named enums retain the existing Symbol -> Type constructor identity path.
            دع هوية_مختارة: متغير اختياري هوية_منشئ_نوع = هوية_منشئ_مدمج_دلالية_بالأسماء(
                سياق_الأسماء, الأنواع, النوع, المرجع.النوع, المرجع.المنشئ
            );
            طابق هوية_مختارة مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> {
                طابق رمز_اسم_محلول_عند(الروابط, المرجع.نطاق_المنشئ) مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(
                        خطأ_تكامل_نوع_نمط.ربط_منشئ_مفقود(المرجع.نطاق_المنشئ)
                    );
                }
                | اختياري.موجود(الرمز) -> {
                    طابق هوية_منشئ_تعداد_دلالية_بالرمز(الأنواع, النوع, الرمز) مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.موجود(
                            خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(المرجع.نطاق_المنشئ)
                        );
                    }
                    | اختياري.موجود(الهوية) -> {
                        هوية_مختارة := اختياري.موجود(الهوية);
                    };
                };
            };

            طابق هوية_مختارة مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(
                    خطأ_تكامل_نوع_نمط.منشئ_غير_دلالي(المرجع.نطاق_المنشئ)
                );
            }
            | اختياري.موجود(الهوية) -> {
                طابق أضف_منشئ_عقدة(الحقائق, النمط, النوع, الهوية, المرجع.نطاق_المنشئ) مع
                | اختياري.موجود(_) -> {
                    أرجع اختياري.موجود(خطأ_تكامل_نوع_نمط.تحقق(المرجع.نطاق_المنشئ));
                }
                | اختياري.لا_شيء -> { };
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الحمولات) مثل طبيعي)) {
                    طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع, الهوية, ف) مع
                    | اختياري.موجود(نوع_الابن) -> {
                        طابق ابن_حلول_منشئات_نمط_نوعيا(
                            السجل, سياق_الأسماء, الأنواع, الروابط,
                            الحمولات[ف], نوع_الابن, الحقائق
                        ) مع
                        | اختياري.موجود(الخطأ) -> {
                            أرجع اختياري.موجود(الخطأ);
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    ف := ف + 1;
                }
            };
        };
        أرجع اختياري.لا_شيء();
    };
}

عام عرف تحقق_ذراع_نمط_نوعيا(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    السجل: &سجل_أنماط,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    الجذر: معرف_نمط,
    نطاق_المميز: نطاق
): نتيجة_تكامل_ذراع_نمط {
    طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_المميز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تكامل_ذراع_نمط.مرفوضة(خطأ_تكامل_نوع_نمط.نوع_مميز_مفقود(نطاق_المميز));
    }
    | اختياري.موجود(نوع_المميز) -> {
        دع حقائق_الأنماط: متغير متجه نوع_عقدة_نمط = [];
        طابق ابن_حلول_منشئات_نمط_نوعيا(
            السجل, سياق_الأسماء, الأنواع, الروابط,
            الجذر, نوع_المميز, &متغير حقائق_الأنماط
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_تكامل_ذراع_نمط.مرفوضة(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        طابق تحقق_نمط_مع_نوع(
            السجل, الأنواع, &حقائق_الأنماط, الجذر, نوع_المميز
        ) مع
        | نتيجة_تحقق_نمط_نوعي.مرفوض(الخطأ) -> {
            طابق نطاق_نمط_عند(السجل, الجذر) مع
            | اختياري.موجود(نطاق_النمط) -> {
                أرجع نتيجة_تكامل_ذراع_نمط.مرفوضة(خطأ_تكامل_نوع_نمط.تحقق(نطاق_النمط));
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تكامل_ذراع_نمط.مرفوضة(خطأ_تكامل_نوع_نمط.تحقق(نطاق_المميز));
            };
        }
        | نتيجة_تحقق_نمط_نوعي.صالح(التحقق) -> {
            دع الربط: ربط_تحقق_نمط_وحدة = { التحقق: التحقق };
            أرجع نتيجة_تكامل_ذراع_نمط.مكتملة(الربط);
        };
    };
}

// Type-validation exposes only the stable index of a whole-unit Pattern verification record.
// Consumers borrow the stored verification in place instead of moving its owned vectors.
//
// Records are appended as arms are verified, and Pattern IDs are allocated in
// that same order, so roots normally increase with the index: a binary search
// answers in O(log n). A vector built in another order (for example a
// remapped monomorphized copy) is still answered exactly by the linear scan
// when the search misses. Previously every query scanned linearly, which was
// the single most expensive frontend operation of a compiler self-build.
عام عرف فهرس_تحقق_ربط_نمط_وحدة_عند(
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الجذر: معرف_نمط
): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*التحققات) مثل طبيعي;
    دع الأدنى: متغير طبيعي = 0;
    دع الأعلى: متغير طبيعي = العدد;
    طالما (الأدنى < الأعلى) {
        دع الأوسط: طبيعي = الأدنى + (الأعلى - الأدنى) / 2;
        دع قيمة_الأوسط: طبيعي = (*التحققات)[الأوسط].التحقق.الجذر.القيمة;
        لو (قيمة_الأوسط == الجذر.القيمة) {
            أرجع اختياري.موجود(الأوسط);
        };
        لو (قيمة_الأوسط < الجذر.القيمة) {
            الأدنى := الأوسط + 1;
        } وإلا {
            الأعلى := الأوسط;
        };
    }
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        لو ((*التحققات)[ف].التحقق.الجذر.القيمة == الجذر.القيمة) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Downstream consumers use the verification that Pattern already produced.
// These queries never rerun Pattern type validation.
عام عرف هوية_منشئ_نمط_محلولة_عند(
    التحقق: &تحقق_نمط_نوعي,
    النمط: معرف_نمط
): اختياري هوية_منشئ_نوع {
    دع القيمة: تحقق_نمط_نوعي = *التحقق;
    طابق ابحث_حقيقة_نمط(&القيمة.أنواع_العقد, النمط) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الحقيقة) -> { أرجع الحقيقة.المنشئ; };
}

// Legacy downstream view only. Canonical ownership remains in each stored verification.
// This projection is rebuilt from the singular Pattern typed facts and is never stored by Frontend.
عام عرف حلول_منشئات_من_تحققات(
    التحققات: &متجه ربط_تحقق_نمط_وحدة
): متجه حل_منشئ_نمط {
    دع القيم: متجه ربط_تحقق_نمط_وحدة = *التحققات;
    دع الناتج: متغير متجه حل_منشئ_نمط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        دع مرجع_التحقق: &تحقق_نمط_نوعي = &القيم[ف].التحقق;
        دع التحقق: تحقق_نمط_نوعي = *مرجع_التحقق;
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(التحقق.أنواع_العقد) مثل طبيعي)) {
            دع الحقيقة: نوع_عقدة_نمط = التحقق.أنواع_العقد[ح];
            طابق الحقيقة.المنشئ مع
            | اختياري.موجود(الهوية) -> {
                ألحق(الناتج, حل_منشئ_نمط_من(الحقيقة.النمط, الحقيقة.النوع, الهوية));
            }
            | اختياري.لا_شيء -> { };
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف ترتيب_منشئ_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنواع: &سجل_أنواع,
    الحلول: &متجه حل_منشئ_نمط,
    النمط: معرف_نمط
): اختياري طبيعي {
    دع القيمة: تحقق_نمط_نوعي = *التحقق;
    طابق ابحث_حقيقة_نمط(&القيمة.أنواع_العقد, النمط) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الحقيقة) -> {
        طابق الحقيقة.المنشئ مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الهوية) -> {
            أرجع ترتيب_منشئ_نوع_دلالي_بالهوية(
                سجل_الأنواع, الحقيقة.النوع, الهوية
            );
        };
    };
}

عام عرف نوع_حمولة_منشئ_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    النمط: معرف_نمط,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    طابق نمط_حمولة_منشئ_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختياري.موجود(الابن) -> { أرجع نوع_عقدة_نمط_عند(التحقق, الابن); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف ترتيب_حقل_سجل_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    سجل_الأنواع: &سجل_أنواع,
    النمط: معرف_نمط,
    فهرس_النمط: طبيعي
): اختياري طبيعي {
    طابق نوع_عقدة_نمط_عند(التحقق, النمط) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        طابق هوية_حقل_سجل_نمط_متحقق_عند(سجل_الأنماط, النمط, فهرس_النمط) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الاسم) -> {
            أرجع ترتيب_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, النوع, الاسم);
        };
    };
}

عام عرف نوع_حقل_سجل_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    النمط: معرف_نمط,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    طابق نمط_حقل_سجل_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختياري.موجود(الابن) -> { أرجع نوع_عقدة_نمط_عند(التحقق, الابن); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف نوع_عنصر_صف_نمط_من_تحقق_عند(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    النمط: معرف_نمط,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    طابق نمط_عنصر_صف_متحقق_عند(سجل_الأنماط, النمط, الفهرس) مع
    | اختياري.موجود(الابن) -> { أرجع نوع_عقدة_نمط_عند(التحقق, الابن); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_نوع_عقدة_نمط(القيمة: &متجه نوع_عقدة_نمط): متجه نوع_عقدة_نمط {
    دع الناتج: متغير متجه نوع_عقدة_نمط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The resolved constructor of one checked pattern node, when it has one.
عام عرف منشئ_عقدة_نمط_عند(التحقق: &تحقق_نمط_نوعي, النمط: معرف_نمط): اختياري هوية_منشئ_نوع {
    طابق ابحث_حقيقة_نمط(&(*التحقق).أنواع_العقد, النمط) مع
    | اختياري.موجود(الحقيقة) -> { أرجع الحقيقة.المنشئ; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}
