استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.pattern_registry;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.source.scope;

عرف ابحث_عن_ربط(الروابط: &متجه ربط_نمط, الاسم: معرف_اسم): اختيار ربط_نمط {
    دع القيم: متجه ربط_نمط = *الروابط;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (معرفا_اسم_متساويان(القيم[ف].الاسم, الاسم)) {
            أرجع اختيار.بعض(القيم[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أضف_ربطا(
    الروابط: &متغير متجه ربط_نمط,
    الربط: ربط_نمط
): اختيار خطأ_نمط {
    دع الموجود: اختيار ربط_نمط = ابحث_عن_ربط(الروابط, الربط.الاسم);
    طابق الموجود مع
    | اختيار.بعض(الأول) -> {
        أرجع اختيار.بعض(خطأ_نمط.ربط_مكرر(الربط.الاسم, الأول, الربط));
    }
    | اختيار.لا_شيء -> {
    };
    دع الحالة: متغير متجه ربط_نمط = *الروابط;
    ألحق(الحالة, الربط);
    *الروابط := الحالة;
    أرجع اختيار.لا_شيء();
}

// هذا هو الاجتياز العودي الوحيد المسؤول عن استخراج روابط Pattern وكشف تكرارها.
عرف اجمع_روابط_من(
    السجل: &سجل_أنماط,
    المعرف: معرف_نمط,
    الروابط: &متغير متجه ربط_نمط
): اختيار خطأ_نمط {
    دع الموجود: اختيار نمط_دلالي = نمط_عند(السجل, المعرف);
    طابق الموجود مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_نمط.معرف_غير_صالح(المعرف));
    }
    | اختيار.بعض(النمط) -> {
        طابق النمط مع
        | نمط_دلالي.بدل(النطاق) -> {
            أرجع اختيار.لا_شيء();
        }
        | نمط_دلالي.ربط(النطاق, الاسم) -> {
            دع الربط: ربط_نمط = {
                الاسم: الاسم,
                النمط: المعرف,
                النطاق: النطاق
            };
            أرجع أضف_ربطا(الروابط, الربط);
        }
        | نمط_دلالي.صف(النطاق, العناصر) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
                دع الخطأ: اختيار خطأ_نمط = اجمع_روابط_من(السجل, العناصر[ف], الروابط);
                طابق الخطأ مع
                | اختيار.بعض(القيمة) -> {
                    أرجع اختيار.بعض(القيمة);
                }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختيار.لا_شيء();
        }
        | نمط_دلالي.سجل(النطاق, الحقول) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحقول) مثل غير_موقع)) {
                دع الخطأ: اختيار خطأ_نمط = اجمع_روابط_من(
                    السجل, الحقول[ف].النمط, الروابط
                );
                طابق الخطأ مع
                | اختيار.بعض(القيمة) -> {
                    أرجع اختيار.بعض(القيمة);
                }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختيار.لا_شيء();
        }
        | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحمولات) مثل غير_موقع)) {
                دع الخطأ: اختيار خطأ_نمط = اجمع_روابط_من(
                    السجل, الحمولات[ف], الروابط
                );
                طابق الخطأ مع
                | اختيار.بعض(القيمة) -> {
                    أرجع اختيار.بعض(القيمة);
                }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختيار.لا_شيء();
        };
    };
}

عرف صنف_اعتماد_النوع(النمط: &نمط_دلالي): حالة_تحقق_نوع_نمط {
    دع القيمة: نمط_دلالي = *النمط;
    طابق القيمة مع
    | نمط_دلالي.بدل(النطاق) -> {
        أرجع حالة_تحقق_نوع_نمط.مكتمل_دون_نوع();
    }
    | نمط_دلالي.ربط(النطاق, الاسم) -> {
        أرجع حالة_تحقق_نوع_نمط.مكتمل_دون_نوع();
    }
    | نمط_دلالي.صف(النطاق, العناصر) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.سجل(النطاق, الحقول) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    };
}

عرف صنف_عدم_الدحض(النمط: &نمط_دلالي): حكم_عدم_دحض_نمط {
    دع القيمة: نمط_دلالي = *النمط;
    طابق القيمة مع
    | نمط_دلالي.بدل(النطاق) -> {
        أرجع حكم_عدم_دحض_نمط.غير_قابل_للدحض();
    }
    | نمط_دلالي.ربط(النطاق, الاسم) -> {
        أرجع حكم_عدم_دحض_نمط.غير_قابل_للدحض();
    }
    | نمط_دلالي.صف(النطاق, العناصر) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.سجل(النطاق, الحقول) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    };
}

// التحليل يملك استخراج الروابط واتساقها فقط؛ لا يحل الرموز ولا يفحص aggregate Type.
عام عرف حلل_نمطا_دلاليا(السجل: &سجل_أنماط, المعرف: معرف_نمط): نتيجة_تحليل_نمط {
    دع الموجود: اختيار نمط_دلالي = نمط_عند(السجل, المعرف);
    طابق الموجود مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تحليل_نمط.مرفوض(خطأ_نمط.معرف_غير_صالح(المعرف));
    }
    | اختيار.بعض(النمط) -> {
        دع الروابط: متغير متجه ربط_نمط = [];
        دع الخطأ: اختيار خطأ_نمط = اجمع_روابط_من(السجل, المعرف, &متغير الروابط);
        طابق الخطأ مع
        | اختيار.بعض(القيمة) -> {
            أرجع نتيجة_تحليل_نمط.مرفوض(القيمة);
        }
        | اختيار.لا_شيء -> {
            دع التحقق_النوعي: حالة_تحقق_نوع_نمط = صنف_اعتماد_النوع(&النمط);
            دع عدم_الدحض: حكم_عدم_دحض_نمط = صنف_عدم_الدحض(&النمط);
            دع التحليل: تحليل_نمط = {
                الروابط: الروابط,
                التحقق_النوعي: التحقق_النوعي,
                عدم_الدحض: عدم_الدحض
            };
            أرجع نتيجة_تحليل_نمط.محلل(التحليل);
        };
    };
}
