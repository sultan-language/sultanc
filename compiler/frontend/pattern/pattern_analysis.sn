استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.pattern_registry;
استورد compiler.frontend.names.identifiers;
استورد compiler.source.span;

عرف ابحث_عن_ربط(الروابط: &متجه ربط_نمط, الاسم: معرف_اسم): اختياري ربط_نمط {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الروابط) مثل طبيعي)) {
        لو (معرفا_اسم_متساويان((*الروابط)[ف].الاسم, الاسم)) {
            أرجع اختياري.موجود((*الروابط)[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أضف_ربطا(
    الروابط: &متغير متجه ربط_نمط,
    الربط: ربط_نمط
): اختياري خطأ_نمط {
    دع الموجود: اختياري ربط_نمط = ابحث_عن_ربط(الروابط, الربط.الاسم);
    طابق الموجود مع
    | اختياري.موجود(الأول) -> {
        أرجع اختياري.موجود(خطأ_نمط.ربط_مكرر(الربط.الاسم, الأول, الربط));
    }
    | اختياري.لا_شيء -> {
    };
    ألحق(*الروابط, الربط);
    أرجع اختياري.لا_شيء();
}

// هذا هو الاجتياز العودي الوحيد المسؤول عن استخراج روابط Pattern وكشف تكرارها.
عرف اجمع_روابط_من(
    السجل: &سجل_أنماط,
    المعرف: معرف_نمط,
    الروابط: &متغير متجه ربط_نمط
): اختياري خطأ_نمط {
    دع الموجود: اختياري نمط_دلالي = نمط_عند(السجل, المعرف);
    طابق الموجود مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_نمط.معرف_غير_صالح(المعرف));
    }
    | اختياري.موجود(النمط) -> {
        طابق النمط مع
        | نمط_دلالي.بدل(النطاق) -> {
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.حرفي(_, _) -> {
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.مدى(_, _, _) -> {
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.بدائل(_, البدائل) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(البدائل) مثل طبيعي)) {
                طابق اجمع_روابط_من(السجل, البدائل[ف], الروابط) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.ربط(النطاق, الاسم) -> {
            دع الربط: ربط_نمط = {
                الاسم: الاسم,
                النمط: المعرف,
                النطاق: النطاق
            };
            أرجع أضف_ربطا(الروابط, الربط);
        }
        | نمط_دلالي.صف(النطاق, العناصر) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(العناصر) مثل طبيعي)) {
                دع الخطأ: اختياري خطأ_نمط = اجمع_روابط_من(السجل, العناصر[ف], الروابط);
                طابق الخطأ مع
                | اختياري.موجود(القيمة) -> {
                    أرجع اختياري.موجود(القيمة);
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.سجل(النطاق, الحقول) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحقول) مثل طبيعي)) {
                دع الخطأ: اختياري خطأ_نمط = اجمع_روابط_من(
                    السجل, الحقول[ف].النمط, الروابط
                );
                طابق الخطأ مع
                | اختياري.موجود(القيمة) -> {
                    أرجع اختياري.موجود(القيمة);
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحمولات) مثل طبيعي)) {
                دع الخطأ: اختياري خطأ_نمط = اجمع_روابط_من(
                    السجل, الحمولات[ف], الروابط
                );
                طابق الخطأ مع
                | اختياري.موجود(القيمة) -> {
                    أرجع اختياري.موجود(القيمة);
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف صنف_اعتماد_النوع(النمط: &نمط_دلالي): حالة_تحقق_نوع_نمط {
    طابق *النمط مع
    | نمط_دلالي.بدل(النطاق) -> {
        أرجع حالة_تحقق_نوع_نمط.مكتمل_دون_نوع();
    }
    | نمط_دلالي.ربط(النطاق, الاسم) -> {
        أرجع حالة_تحقق_نوع_نمط.مكتمل_دون_نوع();
    }
    | نمط_دلالي.حرفي(_, _) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.مدى(_, _, _) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.بدائل(_, _) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.صف(النطاق, العناصر) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.سجل(النطاق, الحقول) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    };
}

عرف صنف_عدم_الدحض(النمط: &نمط_دلالي): حكم_عدم_دحض_نمط {
    طابق *النمط مع
    | نمط_دلالي.بدل(النطاق) -> {
        أرجع حكم_عدم_دحض_نمط.غير_قابل_للدحض();
    }
    | نمط_دلالي.ربط(النطاق, الاسم) -> {
        أرجع حكم_عدم_دحض_نمط.غير_قابل_للدحض();
    }
    | نمط_دلالي.حرفي(_, _) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.مدى(_, _, _) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.بدائل(_, _) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.صف(النطاق, العناصر) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.سجل(النطاق, الحقول) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    };
}

// التحليل يملك استخراج الروابط واتساقها فقط؛ لا يحل الرموز ولا يفحص aggregate Type.
عام عرف حلل_نمطا_دلاليا(السجل: &سجل_أنماط, المعرف: معرف_نمط): نتيجة_تحليل_نمط {
    دع الموجود: اختياري نمط_دلالي = نمط_عند(السجل, المعرف);
    طابق الموجود مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحليل_نمط.مرفوض(خطأ_نمط.معرف_غير_صالح(المعرف));
    }
    | اختياري.موجود(النمط) -> {
        دع الروابط: متغير متجه ربط_نمط = [];
        دع الخطأ: اختياري خطأ_نمط = اجمع_روابط_من(السجل, المعرف, &متغير الروابط);
        طابق الخطأ مع
        | اختياري.موجود(القيمة) -> {
            أرجع نتيجة_تحليل_نمط.مرفوض(القيمة);
        }
        | اختياري.لا_شيء -> {
            دع التحقق_النوعي: حالة_تحقق_نوع_نمط = صنف_اعتماد_النوع(&النمط);
            دع عدم_الدحض: حكم_عدم_دحض_نمط = صنف_عدم_الدحض(&النمط);
            دع التحليل: تحليل_نمط = {
                الروابط: الروابط,
                التحقق_النوعي: التحقق_النوعي,
                عدم_الدحض: عدم_الدحض
            };
            أرجع نتيجة_تحليل_نمط.محلل(التحليل);
        };
    };
}
