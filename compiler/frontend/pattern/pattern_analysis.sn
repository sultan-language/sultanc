استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.pattern_registry;
استورد compiler.frontend.names.identifiers;
استورد compiler.source.span;

عرف ابحث_عن_ربط(الروابط: &متجه ربط_نمط, الاسم: معرف_اسم): اختياري ربط_نمط {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الروابط) مثل طبيعي)) {
        إذا (معرفا_اسم_متساويان((*الروابط)[ف].الاسم, الاسم)) {
            أرجع اختياري.موجود((*الروابط)[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أضف_ربطا(
    الروابط: &متغير متجه ربط_نمط,
    الربط: ربط_نمط
): اختياري خطأ_نمط {
    ليكن الموجود: اختياري ربط_نمط = ابحث_عن_ربط(الروابط, الربط.الاسم);
    طابق الموجود مع
    | اختياري.موجود(الأول) -> {
        أرجع اختياري.موجود(خطأ_نمط.ربط_مكرر(الربط.الاسم, الأول, الربط));
    }
    | اختياري.لا_شيء -> {
    };
    ألحق(*الروابط, الربط);
    أرجع اختياري.لا_شيء();
}

// هذا هو الاجتياز العودي الوحيد المسؤول عن استخراج روابط Pattern وكشف تكرارها.
عرف اجمع_روابط_من(
    السجل: &سجل_أنماط,
    المعرف: معرف_نمط,
    الروابط: &متغير متجه ربط_نمط
): اختياري خطأ_نمط {
    ليكن الموجود: اختياري نمط_دلالي = نمط_عند(السجل, المعرف);
    طابق الموجود مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_نمط.معرف_غير_صالح(المعرف));
    }
    | اختياري.موجود(النمط) -> {
        طابق النمط مع
        | نمط_دلالي.بدل(النطاق) -> {
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.حرفي(_, _) -> {
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.مدى(_, _, _) -> {
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.بدائل(_, البدائل) -> {
            // Every alternative binds the names the first one does (checked
            // with their Types, type_validation.sn, اختلاف_بدائل_نمط_في): the
            // first stands for them all.
            إذا ((الطول(البدائل) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
            أرجع اجمع_روابط_من(السجل, البدائل[0], الروابط);
        }
        | نمط_دلالي.ربط(النطاق, الاسم) -> {
            ليكن الربط: ربط_نمط = {
                الاسم: الاسم,
                النمط: المعرف,
                النطاق: النطاق
            };
            أرجع أضف_ربطا(الروابط, الربط);
        }
        | نمط_دلالي.صف(النطاق, العناصر) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(العناصر) مثل طبيعي)) {
                ليكن الخطأ: اختياري خطأ_نمط = اجمع_روابط_من(السجل, العناصر[ف], الروابط);
                طابق الخطأ مع
                | اختياري.موجود(القيمة) -> {
                    أرجع اختياري.موجود(القيمة);
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.سجل(النطاق, الحقول) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحقول) مثل طبيعي)) {
                ليكن الخطأ: اختياري خطأ_نمط = اجمع_روابط_من(
                    السجل, الحقول[ف].النمط, الروابط
                );
                طابق الخطأ مع
                | اختياري.موجود(القيمة) -> {
                    أرجع اختياري.موجود(القيمة);
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحمولات) مثل طبيعي)) {
                ليكن الخطأ: اختياري خطأ_نمط = اجمع_روابط_من(
                    السجل, الحمولات[ف], الروابط
                );
                طابق الخطأ مع
                | اختياري.موجود(القيمة) -> {
                    أرجع اختياري.موجود(القيمة);
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.مستعار(_, الداخل, الربط) -> {
            طابق اجمع_روابط_من(السجل, الداخل, الروابط) مع
            | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
            | اختياري.لا_شيء -> { };
            أرجع اجمع_روابط_من(السجل, الربط, الروابط);
        }
        | نمط_دلالي.تسلسل(_, _, _, _) -> {
            ليكن الأبناء: متجه معرف_نمط = أبناء_نمط_دلالي(&النمط);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الأبناء) مثل طبيعي)) {
                طابق اجمع_روابط_من(السجل, الأبناء[ف], الروابط) مع
                | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف صنف_اعتماد_النوع(النمط: &نمط_دلالي): حالة_تحقق_نوع_نمط {
    طابق *النمط مع
    | نمط_دلالي.بدل(النطاق) -> {
        أرجع حالة_تحقق_نوع_نمط.مكتمل_دون_نوع();
    }
    | نمط_دلالي.ربط(النطاق, الاسم) -> {
        أرجع حالة_تحقق_نوع_نمط.مكتمل_دون_نوع();
    }
    | نمط_دلالي.حرفي(_, _) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.مدى(_, _, _) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.بدائل(_, _) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.صف(النطاق, العناصر) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.سجل(النطاق, الحقول) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.مستعار(_, _, _) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.تسلسل(_, _, _, _) -> {
        أرجع حالة_تحقق_نوع_نمط.يتطلب_دلالات_نوع();
    };
}

عرف صنف_عدم_الدحض(النمط: &نمط_دلالي): حكم_عدم_دحض_نمط {
    طابق *النمط مع
    | نمط_دلالي.بدل(النطاق) -> {
        أرجع حكم_عدم_دحض_نمط.غير_قابل_للدحض();
    }
    | نمط_دلالي.ربط(النطاق, الاسم) -> {
        أرجع حكم_عدم_دحض_نمط.غير_قابل_للدحض();
    }
    | نمط_دلالي.حرفي(_, _) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.مدى(_, _, _) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.بدائل(_, _) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.صف(النطاق, العناصر) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.سجل(النطاق, الحقول) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.منشئ(النطاق, المرجع, الحمولات) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.مستعار(_, _, _) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    }
    | نمط_دلالي.تسلسل(_, _, _, _) -> {
        أرجع حكم_عدم_دحض_نمط.يتطلب_دلالات_نوع();
    };
}

// The sub-patterns of one pattern node, in source order (every alternative
// of an or-pattern).
عام عرف أبناء_نمط_دلالي(النمط: &نمط_دلالي): متجه معرف_نمط {
    ليكن الناتج: متغير متجه معرف_نمط = [];
    طابق *النمط مع
    | نمط_دلالي.بدائل(_, البدائل) -> { الناتج := انسخ_مملوكا_متجه_معرف_نمط(&البدائل); }
    | نمط_دلالي.صف(_, العناصر) -> { الناتج := انسخ_مملوكا_متجه_معرف_نمط(&العناصر); }
    | نمط_دلالي.منشئ(_, _, الحمولات) -> { الناتج := انسخ_مملوكا_متجه_معرف_نمط(&الحمولات); }
    | نمط_دلالي.مستعار(_, الداخل, الربط) -> { ألحق(الناتج, الداخل); ألحق(الناتج, الربط); }
    | نمط_دلالي.تسلسل(_, السابقة, البقية, اللاحقة) -> {
        الناتج := انسخ_مملوكا_متجه_معرف_نمط(&السابقة);
        طابق البقية مع
        | اختياري.موجود(المعرف) -> { ألحق(الناتج, المعرف); }
        | اختياري.لا_شيء -> { };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(اللاحقة) مثل طبيعي)) { ألحق(الناتج, اللاحقة[ف]); ف := ف + 1; }
    }
    | نمط_دلالي.سجل(_, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            ألحق(الناتج, الحقول[ف].النمط);
            ف := ف + 1;
        }
    }
    | _ -> { };
    أرجع الناتج;
}

// The names one pattern binds, in source order (an or-pattern's are its first
// alternative's), or nothing when the pattern is not well formed.
عام عرف روابط_نمط_دلالي(السجل: &سجل_أنماط, المعرف: معرف_نمط): اختياري متجه ربط_نمط {
    ليكن الروابط: متغير متجه ربط_نمط = [];
    طابق اجمع_روابط_من(السجل, المعرف, &متغير الروابط) مع
    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(الروابط); };
}

// التحليل يملك استخراج الروابط واتساقها فقط؛ لا يحل الرموز ولا يفحص aggregate Type.
عام عرف حلل_نمطا_دلاليا(السجل: &سجل_أنماط, المعرف: معرف_نمط): نتيجة_تحليل_نمط {
    ليكن الموجود: اختياري نمط_دلالي = نمط_عند(السجل, المعرف);
    طابق الموجود مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحليل_نمط.مرفوض(خطأ_نمط.معرف_غير_صالح(المعرف));
    }
    | اختياري.موجود(النمط) -> {
        ليكن الروابط: متغير متجه ربط_نمط = [];
        ليكن الخطأ: اختياري خطأ_نمط = اجمع_روابط_من(السجل, المعرف, &متغير الروابط);
        طابق الخطأ مع
        | اختياري.موجود(القيمة) -> {
            أرجع نتيجة_تحليل_نمط.مرفوض(القيمة);
        }
        | اختياري.لا_شيء -> {
            ليكن التحقق_النوعي: حالة_تحقق_نوع_نمط = صنف_اعتماد_النوع(&النمط);
            ليكن عدم_الدحض: حكم_عدم_دحض_نمط = صنف_عدم_الدحض(&النمط);
            ليكن التحليل: تحليل_نمط = {
                الروابط: الروابط,
                التحقق_النوعي: التحقق_النوعي,
                عدم_الدحض: عدم_الدحض
            };
            أرجع نتيجة_تحليل_نمط.محلل(التحليل);
        };
    };
}
