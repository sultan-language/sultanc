استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.pattern_registry;
استورد compiler.frontend.pattern.type_validation;
استورد compiler.frontend.pattern.pattern_analysis;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.builtins_generated;

// Match analysis is the classic usefulness check over a pattern matrix (Maranget,
// "Warnings for pattern matching"). Rows are arms, columns are sub-values with
// their Types. A pattern vector is useful against a matrix when some value
// matches it and no row of the matrix:
//   - the match is exhaustive when the all-wildcard vector is not useful
//     against all arms;
//   - an arm is unreachable when it is not useful against the arms before it.
// The check fails closed: when a fact is missing (an unresolved constructor or
// Type, or the work budget runs out) the answer is "unknown". An unknown answer
// never proves a match exhaustive and never reports an arm unreachable.

// A matrix cell: a wildcard (also a binding), or a pattern node of the arm whose
// type check is at the given position of the unit's checks.
عام نوع خلية_شمول =
    | بدل
    | نمط بنوع (معرف_نمط, طبيعي)
;

نوع حكم_فائدة_شمول =
    | مفيد
    | غير_مفيد
    | مجهول
;

عام نوع حكم_شمول_مطابقة =
    | شاملة
    | غير_شاملة
    // Some fact the check needs is missing; the match is not proven exhaustive.
    | غير_مثبتة
;

عام نوع تحليل_أذرع_مطابقة = {
    الشمول: حكم_شمول_مطابقة,
    // Indices of the arms an earlier arm already covers.
    غير_القابلة_للوصول: متجه طبيعي,
    // The alternatives of a reachable arm's or-pattern that the earlier arms
    // and the arm's earlier alternatives already cover (redundant
    // sub-patterns, reported like unreachable arms).
    البدائل_غير_القابلة_للوصول: متجه معرف_نمط,
    // A match that is not exhaustive over a scrutinee with a closed set of
    // cases (an enumeration, an option, a result, a boolean): the ordinals
    // of the cases some value of which no arm covers (a boolean's: 0 false,
    // 1 true), for the diagnostic and its fix. Empty when the set is open (a
    // number, a text) or a fact is missing.
    الناقصة: متجه طبيعي,
    // A match over a vector or slice that is not exhaustive: the shortest
    // shape no arm covers (`[_, _]`, or `[_, _, rest _]` for every longer
    // length too), for the diagnostic and its fix.
    الشكل_الناقص: اختياري شكل_تسلسل_ناقص,
    // The scrutinee's Type, when known.
    نوع_المميز: اختياري معرف_نوع
};

// A vector or slice shape: العدد elements, and with مفتوح any more after them.
عام نوع شكل_تسلسل_ناقص = {
    العدد: طبيعي,
    مفتوح: منطقي
};

// Kinds of integer-like columns whose values are ordered.
نوع صنف_مجال_شمول =
    | موقعة
    | طبيعية
    | محارف
;

نوع صنف_عمود_شمول =
    | منشئات بنوع طبيعي
    | منطقي
    | سجل بنوع طبيعي
    | صف بنوع طبيعي
    // Ordered values in [الأدنى, الأعلى], kept as offset unsigned numbers.
    | مجالات بنوع (ط64, ط64, صنف_مجال_شمول)
    // A vector or slice: one shape per length.
    | تسلسل
    | مفتوح
;

// An inclusive interval of offset values; a wildcard head covers the domain.
نوع مجال_شمول = {
    الأدنى: ط64,
    الأعلى: ط64,
    بدل: منطقي,
    فارغ: منطقي
};

// Work budget of one question, in matrix rows visited.
ليكن حد_خطوات_شمول: طبيعي = 4000 * 1000;

عرف انسخ_صف_شمول(الصف: &متجه خلية_شمول, البداية: طبيعي): متجه خلية_شمول {
    ليكن الناتج: متغير متجه خلية_شمول = [];
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < (الطول(*الصف) مثل طبيعي)) {
        ألحق(الناتج, (*الصف)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Appends the cells of a row after the first `البداية` to a new row.
عرف ألحق_ذيل_صف_شمول(الوجهة: &متغير متجه خلية_شمول, الصف: [] خلية_شمول, البداية: طبيعي): فراغ {
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < (الطول(الصف) مثل طبيعي)) {
        ألحق(*الوجهة, الصف[ف]);
        ف := ف + 1;
    }
}

// The pattern an `as` names (its own pattern), for coverage.
عرف انزع_الاستعارة_شمول(المعرف: معرف_نمط, السجل: &سجل_أنماط): معرف_نمط {
    ليكن الحالي: متغير معرف_نمط = المعرف;
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < 64) {
        طابق نمط_عند(السجل, الحالي) مع
        | اختياري.موجود(نمط_دلالي.مستعار(_, الداخل, _)) -> { الحالي := الداخل; }
        | _ -> { أرجع الحالي; };
        ع := ع + 1;
    }
    أرجع الحالي;
}

// Bindings and wildcards are the same cell for coverage; an `as` covers what
// its pattern does.
عرف خلية_من_نمط_شمول(المعرف: معرف_نمط, الموضع: طبيعي, السجل: &سجل_أنماط): خلية_شمول {
    ليكن النمط: معرف_نمط = انزع_الاستعارة_شمول(المعرف, السجل);
    طابق نمط_عند(السجل, النمط) مع
    | اختياري.موجود(نمط_دلالي.بدل(_)) -> { أرجع خلية_شمول.بدل(); }
    | اختياري.موجود(نمط_دلالي.ربط(_, _)) -> { أرجع خلية_شمول.بدل(); }
    | _ -> { أرجع خلية_شمول.نمط(النمط, الموضع); };
}

عرف خلية_بدل_شمول(الخلية: خلية_شمول): منطقي {
    طابق الخلية مع
    | خلية_شمول.بدل -> { أرجع صواب; }
    | خلية_شمول.نمط(_, _) -> { أرجع خطأ; };
}

عرف صف_بدل_شمول(الصف: &متجه خلية_شمول): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الصف) مثل طبيعي)) {
        إذا (!خلية_بدل_شمول((*الصف)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// A reference column is matched through to its target.
عرف نوع_عمود_مقنن_شمول(الأنواع: &سجل_أنواع, النوع: معرف_نوع): معرف_نوع {
    ليكن الحالي: متغير معرف_نوع = النوع;
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < 16) {
        طابق نوع_داخل_مرجع_دلالي(الأنواع, الحالي) مع
        | اختياري.موجود(الداخل) -> { الحالي := الداخل; }
        | اختياري.لا_شيء -> { أرجع الحالي; };
        ع := ع + 1;
    }
    أرجع الحالي;
}

// 2^63: signed values are offset by it so that every domain orders as unsigned.
عرف إزاحة_موقع_شمول(): ط64 {
    ليكن النصف: ط64 = 9223372036854775807;
    أرجع النصف + 1;
}

عرف قوة_اثنين_شمول(الأس: طبيعي): ط64 {
    ليكن الناتج: متغير ط64 = 1;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الأس) { الناتج := الناتج * 2; ف := ف + 1; }
    أرجع الناتج;
}

عرف صنف_مجال_موقع_شمول(البتات: طبيعي): صنف_عمود_شمول {
    ليكن النصف: ط64 = قوة_اثنين_شمول(البتات - 1);
    ليكن الإزاحة: ط64 = إزاحة_موقع_شمول();
    أرجع صنف_عمود_شمول.مجالات(الإزاحة - النصف, الإزاحة + (النصف - 1), صنف_مجال_شمول.موقعة());
}

عرف صنف_مجال_طبيعي_شمول(البتات: طبيعي): صنف_عمود_شمول {
    ليكن النصف: ط64 = قوة_اثنين_شمول(البتات - 1);
    ليكن الأدنى: ط64 = 0;
    أرجع صنف_عمود_شمول.مجالات(الأدنى, (النصف - 1) + النصف, صنف_مجال_شمول.طبيعية());
}

// Integer columns: language-sized integers take the widest domain, which never
// proves a match exhaustive that a narrower domain would not.
عرف صنف_عمود_بدائي_شمول(البدائي: نوع_بدائي_مقنن): صنف_عمود_شمول {
    طابق البدائي مع
    | نوع_بدائي_مقنن.منطقي -> { أرجع صنف_عمود_شمول.منطقي(); }
    | نوع_بدائي_مقنن.ص8 -> { أرجع صنف_مجال_موقع_شمول(8); }
    | نوع_بدائي_مقنن.ص16 -> { أرجع صنف_مجال_موقع_شمول(16); }
    | نوع_بدائي_مقنن.ص32 -> { أرجع صنف_مجال_موقع_شمول(32); }
    | نوع_بدائي_مقنن.ص64 -> { أرجع صنف_مجال_موقع_شمول(64); }
    | نوع_بدائي_مقنن.عدد -> { أرجع صنف_مجال_موقع_شمول(64); }
    | نوع_بدائي_مقنن.ط8 -> { أرجع صنف_مجال_طبيعي_شمول(8); }
    | نوع_بدائي_مقنن.ط16 -> { أرجع صنف_مجال_طبيعي_شمول(16); }
    | نوع_بدائي_مقنن.ط32 -> { أرجع صنف_مجال_طبيعي_شمول(32); }
    | نوع_بدائي_مقنن.ط64 -> { أرجع صنف_مجال_طبيعي_شمول(64); }
    | نوع_بدائي_مقنن.طبيعي -> { أرجع صنف_مجال_طبيعي_شمول(64); }
    | نوع_بدائي_مقنن.حرف -> {
        ليكن الأدنى: ط64 = 0;
        ليكن الأعلى: ط64 = 1114111;
        أرجع صنف_عمود_شمول.مجالات(الأدنى, الأعلى, صنف_مجال_شمول.محارف());
    }
    | _ -> { أرجع صنف_عمود_شمول.مفتوح(); };
}

عرف صنف_عمود_شمول_لنوع(الأنواع: &سجل_أنواع, النوع: معرف_نوع): صنف_عمود_شمول {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.تعداد -> {
            طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.منشئات(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | صنف_شكل_نوع_دلالي.اختيار -> {
            طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.منشئات(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | صنف_شكل_نوع_دلالي.نتيجة -> {
            طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.منشئات(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع صنف_عمود_بدائي_شمول(البدائي);
        }
        | صنف_شكل_نوع_دلالي.سجل -> {
            طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.سجل(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | صنف_شكل_نوع_دلالي.صف -> {
            طابق عدد_عناصر_صف_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.صف(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | صنف_شكل_نوع_دلالي.متجه -> { أرجع صنف_عمود_شمول.تسلسل(); }
        | صنف_شكل_نوع_دلالي.شريحة -> { أرجع صنف_عمود_شمول.تسلسل(); }
        | _ -> { أرجع صنف_عمود_شمول.مفتوح(); };
    };
}

// Rows whose first cell is an or-pattern become one row per alternative.
عرف وسع_بدائل_رأس_شمول(
    الصفوف: &متجه متجه خلية_شمول, السجل: &سجل_أنماط, مجهول: &متغير منطقي
): متجه متجه خلية_شمول {
    ليكن العمل: متغير متجه متجه خلية_شمول = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الصفوف) مثل طبيعي)) {
        ألحق(العمل, انسخ_صف_شمول(&(*الصفوف)[ف], 0));
        ف := ف + 1;
    }
    ليكن الناتج: متغير متجه متجه خلية_شمول = [];
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول(العمل) مثل طبيعي)) {
        إذا ((الطول(العمل) مثل طبيعي) > 100000) { *مجهول := صواب; أرجع الناتج; };
        ليكن وسع: متغير منطقي = خطأ;
        طابق العمل[م][0] مع
        | خلية_شمول.نمط(المعرف, الموضع) -> {
            طابق نمط_عند(السجل, المعرف) مع
            | اختياري.موجود(نمط_دلالي.بدائل(_, البدائل)) -> {
                ليكن ب: متغير طبيعي = 0;
                طالما (ب < (الطول(البدائل) مثل طبيعي)) {
                    ليكن الجديد: متغير متجه خلية_شمول = [];
                    ألحق(الجديد, خلية_من_نمط_شمول(البدائل[ب], الموضع, السجل));
                    ألحق_ذيل_صف_شمول(&متغير الجديد, العمل[م], 1);
                    ألحق(العمل, الجديد);
                    ب := ب + 1;
                }
                وسع := صواب;
            }
            | _ -> { };
        }
        | خلية_شمول.بدل -> { };
        إذا (!وسع) { ألحق(الناتج, انسخ_صف_شمول(&العمل[م], 0)); };
        م := م + 1;
    }
    أرجع الناتج;
}

// Position (constructor ordinal) of a constructor or boolean head cell. لا_شيء
// for a wildcard; a head this check cannot classify sets `مجهول`.
عرف ترتيب_رأس_شمول(
    الخلية: خلية_شمول, السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الأنواع: &سجل_أنواع, صنف_العمود: &صنف_عمود_شمول, مجهول: &متغير منطقي
): اختياري طبيعي {
    طابق الخلية مع
    | خلية_شمول.بدل -> { أرجع اختياري.لا_شيء(); }
    | خلية_شمول.نمط(المعرف, الموضع) -> {
        إذا (الموضع >= (الطول(*التحققات) مثل طبيعي)) { *مجهول := صواب; أرجع اختياري.لا_شيء(); };
        ليكن التحقق: &تحقق_نمط_نوعي = &(*التحققات)[الموضع].التحقق;
        طابق نمط_عند(السجل, المعرف) مع
        | اختياري.موجود(نمط_دلالي.منشئ(_, _, _)) -> {
            طابق نوع_عقدة_نمط_عند(التحقق, المعرف) مع
            | اختياري.موجود(نوع_العقدة) -> {
                طابق منشئ_عقدة_نمط_عند(التحقق, المعرف) مع
                | اختياري.موجود(الهوية) -> {
                    طابق ترتيب_منشئ_نوع_دلالي_بالهوية(الأنواع, نوع_عمود_مقنن_شمول(الأنواع, نوع_العقدة), الهوية) مع
                    | اختياري.موجود(الترتيب) -> { أرجع اختياري.موجود(الترتيب); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.موجود(نمط_دلالي.حرفي(_, قيمة_نمط_حرفي.منطقي(القيمة))) -> {
            طابق *صنف_العمود مع
            | صنف_عمود_شمول.منطقي -> {
                إذا (القيمة) { أرجع اختياري.موجود(1); };
                أرجع اختياري.موجود(0);
            }
            | _ -> { };
        }
        | _ -> { };
        *مجهول := صواب;
        أرجع اختياري.لا_شيء();
    };
}

// Sub-patterns of a head cell specialized to a constructor (or the single
// record/tuple shape), as `العدد` cells in declared order.
عرف أبناء_رأس_شمول(
    الخلية: خلية_شمول, العدد: طبيعي, النوع: معرف_نوع,
    السجل: &سجل_أنماط, الأنواع: &سجل_أنواع, مجهول: &متغير منطقي
): متجه خلية_شمول {
    ليكن الناتج: متغير متجه خلية_شمول = [];
    ليكن ف: متغير طبيعي = 0;
    احجز_سعة(الناتج, العدد);
    طالما (ف < العدد) { ألحق(الناتج, خلية_شمول.بدل()); ف := ف + 1; }
    طابق الخلية مع
    | خلية_شمول.بدل -> { أرجع الناتج; }
    | خلية_شمول.نمط(المعرف, الموضع) -> {
        طابق نمط_عند(السجل, المعرف) مع
        | اختياري.موجود(نمط_دلالي.منشئ(_, _, الحمولات)) -> {
            إذا ((الطول(الحمولات) مثل طبيعي) != العدد) { *مجهول := صواب; أرجع الناتج; };
            ليكن ح: متغير طبيعي = 0;
            طالما (ح < العدد) {
                الناتج[ح] := خلية_من_نمط_شمول(الحمولات[ح], الموضع, السجل);
                ح := ح + 1;
            }
        }
        | اختياري.موجود(نمط_دلالي.صف(_, العناصر)) -> {
            إذا ((الطول(العناصر) مثل طبيعي) != العدد) { *مجهول := صواب; أرجع الناتج; };
            ليكن ح: متغير طبيعي = 0;
            طالما (ح < العدد) {
                الناتج[ح] := خلية_من_نمط_شمول(العناصر[ح], الموضع, السجل);
                ح := ح + 1;
            }
        }
        | اختياري.موجود(نمط_دلالي.سجل(_, الحقول)) -> {
            ليكن ح: متغير طبيعي = 0;
            طالما (ح < (الطول(الحقول) مثل طبيعي)) {
                طابق ترتيب_حقل_سجل_دلالي_بالاسم(الأنواع, النوع, الحقول[ح].الاسم) مع
                | اختياري.موجود(الترتيب) -> {
                    إذا (الترتيب < العدد) {
                        الناتج[الترتيب] := خلية_من_نمط_شمول(الحقول[ح].النمط, الموضع, السجل);
                    } وإلا { *مجهول := صواب; };
                }
                | اختياري.لا_شيء -> { *مجهول := صواب; };
                ح := ح + 1;
            }
        }
        | اختياري.موجود(نمط_دلالي.حرفي(_, _)) -> { }
        | _ -> { *مجهول := صواب; };
        أرجع الناتج;
    };
}

// The rows whose head is a wildcard, without their head (the default matrix).
عرف مصفوفة_افتراضية_شمول(الصفوف: &متجه متجه خلية_شمول): متجه متجه خلية_شمول {
    ليكن الناتج: متغير متجه متجه خلية_شمول = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الصفوف) مثل طبيعي)) {
        إذا (خلية_بدل_شمول((*الصفوف)[ف][0])) { ألحق(الناتج, انسخ_صف_شمول(&(*الصفوف)[ف], 1)); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ادمج_حكمي_شمول(الحكم: حكم_فائدة_شمول, مجهول: &متغير منطقي): منطقي {
    طابق الحكم مع
    | حكم_فائدة_شمول.مفيد -> { أرجع صواب; }
    | حكم_فائدة_شمول.مجهول -> { *مجهول := صواب; أرجع خطأ; }
    | حكم_فائدة_شمول.غير_مفيد -> { أرجع خطأ; };
}

// Offset value of a literal in an ordered column; `صالح` is cleared when the
// literal does not belong to the column.
عرف قيمة_مجال_شمول(القيمة: &قيمة_نمط_حرفي, الصنف: صنف_مجال_شمول, صالح: &متغير منطقي): ط64 {
    ليكن صفر: ط64 = 0;
    طابق *القيمة مع
    | قيمة_نمط_حرفي.عدد(ق) -> {
        طابق الصنف مع
        | صنف_مجال_شمول.موقعة -> {
            إذا (ق >= 0) { أرجع (ق مثل ط64) + إزاحة_موقع_شمول(); };
            أرجع ((ق + 9223372036854775807) + 1) مثل ط64;
        }
        | _ -> {
            إذا (ق < 0) { *صالح := خطأ; أرجع صفر; };
            أرجع ق مثل ط64;
        };
    }
    | قيمة_نمط_حرفي.عدد_طبيعي(ق) -> {
        طابق الصنف مع
        | صنف_مجال_شمول.موقعة -> {
            إذا ((ق مثل ط64) > (9223372036854775807 مثل ط64)) { *صالح := خطأ; أرجع صفر; };
            أرجع (ق مثل ط64) + إزاحة_موقع_شمول();
        }
        | _ -> { أرجع ق مثل ط64; };
    }
    | قيمة_نمط_حرفي.حرف(ق) -> {
        طابق الصنف مع
        | صنف_مجال_شمول.محارف -> { أرجع ق مثل ط64; }
        | _ -> { *صالح := خطأ; أرجع صفر; };
    }
    | _ -> { *صالح := خطأ; أرجع صفر; };
}

// The interval a head cell covers inside [الأدنى, الأعلى].
عرف مجال_رأس_شمول(
    الخلية: خلية_شمول, السجل: &سجل_أنماط, الأدنى: ط64, الأعلى: ط64,
    الصنف: صنف_مجال_شمول, مجهول: &متغير منطقي
): مجال_شمول {
    ليكن الكامل: مجال_شمول = { الأدنى: الأدنى, الأعلى: الأعلى, بدل: صواب, فارغ: خطأ };
    طابق الخلية مع
    | خلية_شمول.بدل -> { أرجع الكامل; }
    | خلية_شمول.نمط(المعرف, _) -> {
        ليكن صالح: متغير منطقي = صواب;
        ليكن أ: متغير ط64 = الأدنى;
        ليكن ب: متغير ط64 = الأعلى;
        طابق نمط_عند(السجل, المعرف) مع
        | اختياري.موجود(نمط_دلالي.حرفي(_, الحرفي)) -> {
            أ := قيمة_مجال_شمول(&الحرفي, الصنف, &متغير صالح);
            ب := أ;
        }
        // An open end reaches the end of the domain.
        | اختياري.موجود(نمط_دلالي.مدى(_, الحد_الأدنى, الحد_الأعلى)) -> {
            طابق الحد_الأدنى مع
            | اختياري.موجود(الحد) -> { أ := قيمة_مجال_شمول(&الحد, الصنف, &متغير صالح); }
            | اختياري.لا_شيء -> { };
            طابق الحد_الأعلى مع
            | اختياري.موجود(الحد) -> { ب := قيمة_مجال_شمول(&الحد, الصنف, &متغير صالح); }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { صالح := خطأ; };
        إذا (!صالح) { *مجهول := صواب; أرجع الكامل; };
        إذا (أ < الأدنى) { أ := الأدنى; };
        إذا (ب > الأعلى) { ب := الأعلى; };
        ليكن الناتج: مجال_شمول = { الأدنى: أ, الأعلى: ب, بدل: خطأ, فارغ: أ > ب };
        أرجع الناتج;
    };
}

عرف رتب_قيم_شمول(القيم: متجه ط64): متجه ط64 {
    ليكن الناتج: متغير متجه ط64 = القيم;
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < (الطول(الناتج) مثل طبيعي)) {
        ليكن القيمة: ط64 = الناتج[ف];
        ليكن م: متغير طبيعي = ف;
        طالما (م > 0 && الناتج[م - 1] > القيمة) {
            الناتج[م] := الناتج[م - 1];
            م := م - 1;
        }
        الناتج[م] := القيمة;
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Usefulness of a vector whose head is an interval [أ, ب] of an ordered column.
// The interval is split at every bound of the rows' intervals; each piece is
// either inside or outside each row's interval.
عرف فائدة_مجالات_شمول(
    الصفوف: &متجه متجه خلية_شمول, المجالات: &متجه مجال_شمول,
    أ: ط64, ب: ط64, رأس_بدل: منطقي,
    بقية_السؤال: [] خلية_شمول, بقية_الأعمدة: [] اختياري معرف_نوع,
    السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة, الأنواع: &سجل_أنواع,
    العمق: طبيعي, الخطوات: &متغير طبيعي
): حكم_فائدة_شمول {
    ليكن النقاط: متغير متجه ط64 = [];
    ألحق(النقاط, أ);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المجالات) مثل طبيعي)) {
        ليكن المجال: مجال_شمول = (*المجالات)[ف];
        إذا (!المجال.بدل && !المجال.فارغ) {
            إذا (المجال.الأدنى > أ && المجال.الأدنى <= ب) { ألحق(النقاط, المجال.الأدنى); };
            إذا (المجال.الأعلى >= أ && المجال.الأعلى < ب) { ألحق(النقاط, المجال.الأعلى + 1); };
        };
        ف := ف + 1;
    }
    *الخطوات := *الخطوات + (الطول(النقاط) مثل طبيعي);
    ليكن المرتبة: متجه ط64 = رتب_قيم_شمول(النقاط);
    // Whether each piece is covered by some row that is not a wildcard.
    ليكن البدايات: متغير متجه ط64 = [];
    ليكن ن: متغير طبيعي = 0;
    طالما (ن < (الطول(المرتبة) مثل طبيعي)) {
        إذا (ن == 0 || المرتبة[ن] != المرتبة[ن - 1]) { ألحق(البدايات, المرتبة[ن]); };
        ن := ن + 1;
    }
    ليكن عدد_القطع: طبيعي = الطول(البدايات) مثل طبيعي;
    ليكن المغطاة: متغير متجه منطقي = [];
    ليكن ق: متغير طبيعي = 0;
    ليكن كلها_مغطاة: متغير منطقي = صواب;
    طالما (ق < عدد_القطع) {
        ليكن البداية: ط64 = البدايات[ق];
        ليكن النهاية: متغير ط64 = ب;
        إذا (ق + 1 < عدد_القطع) { النهاية := البدايات[ق + 1] - 1; };
        ليكن مغطاة: متغير منطقي = خطأ;
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < (الطول(*المجالات) مثل طبيعي) && !مغطاة) {
            ليكن المجال: مجال_شمول = (*المجالات)[ر];
            إذا (!المجال.بدل && !المجال.فارغ && المجال.الأدنى <= البداية && النهاية <= المجال.الأعلى) {
                مغطاة := صواب;
            };
            ر := ر + 1;
        }
        *الخطوات := *الخطوات + (الطول(*المجالات) مثل طبيعي);
        إذا (*الخطوات > حد_خطوات_شمول) { أرجع حكم_فائدة_شمول.مجهول(); };
        ألحق(المغطاة, مغطاة);
        إذا (!مغطاة) { كلها_مغطاة := خطأ; };
        ق := ق + 1;
    }
    // A piece no row names is matched only by the wildcard rows. For a wildcard
    // head that alone decides the answer (the default-matrix shortcut).
    ليكن حكم_الافتراضية: متغير اختياري حكم_فائدة_شمول = اختياري.لا_شيء();
    إذا (!كلها_مغطاة) {
        ليكن الافتراضية: متجه متجه خلية_شمول = مصفوفة_افتراضية_شمول(الصفوف);
        ليكن الحكم: حكم_فائدة_شمول = فائدة_شمول(
            &الافتراضية, بقية_السؤال, بقية_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات
        );
        إذا (رأس_بدل) { أرجع الحكم; };
        حكم_الافتراضية := اختياري.موجود(الحكم);
    };
    ليكن مجهول: متغير منطقي = خطأ;
    ق := 0;
    طالما (ق < عدد_القطع) {
        ليكن البداية: ط64 = البدايات[ق];
        ليكن النهاية: متغير ط64 = ب;
        إذا (ق + 1 < عدد_القطع) { النهاية := البدايات[ق + 1] - 1; };
        إذا (المغطاة[ق]) {
            ليكن المخصصة: متغير متجه متجه خلية_شمول = [];
            ليكن ر: متغير طبيعي = 0;
            طالما (ر < (الطول(*المجالات) مثل طبيعي)) {
                ليكن المجال: مجال_شمول = (*المجالات)[ر];
                إذا (المجال.بدل || (!المجال.فارغ && المجال.الأدنى <= البداية && النهاية <= المجال.الأعلى)) {
                    ألحق(المخصصة, انسخ_صف_شمول(&(*الصفوف)[ر], 1));
                };
                ر := ر + 1;
            }
            إذا (ادمج_حكمي_شمول(فائدة_شمول(
                &المخصصة, بقية_السؤال, بقية_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات
            ), &متغير مجهول)) { أرجع حكم_فائدة_شمول.مفيد(); };
        } وإلا {
            طابق حكم_الافتراضية مع
            | اختياري.موجود(الحكم) -> {
                إذا (ادمج_حكمي_شمول(الحكم, &متغير مجهول)) { أرجع حكم_فائدة_شمول.مفيد(); };
            }
            | اختياري.لا_شيء -> { };
        };
        ق := ق + 1;
    }
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    أرجع حكم_فائدة_شمول.غير_مفيد();
}

عرف حرفيان_متساويان_شمول(أ: &قيمة_نمط_حرفي, ب: &قيمة_نمط_حرفي): منطقي {
    طابق *أ مع
    | قيمة_نمط_حرفي.نص(النص_أ) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.نص(النص_ب) -> {
            إذا (الطول(النص_أ) != الطول(النص_ب)) { أرجع خطأ; };
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(النص_أ) مثل طبيعي)) {
                إذا (النص_أ[ف] != النص_ب[ف]) { أرجع خطأ; };
                ف := ف + 1;
            }
            أرجع صواب;
        }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.عدد(س) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.عدد(ص) -> { أرجع س == ص; }
        | قيمة_نمط_حرفي.عدد_طبيعي(ص) -> { أرجع س >= 0 && (س مثل طبيعي) == ص; }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.عدد_طبيعي(س) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.عدد_طبيعي(ص) -> { أرجع س == ص; }
        | قيمة_نمط_حرفي.عدد(ص) -> { أرجع ص >= 0 && (ص مثل طبيعي) == س; }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.حرف(س) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.حرف(ص) -> { أرجع س == ص; }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.منطقي(س) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.منطقي(ص) -> { أرجع س == ص; }
        | _ -> { أرجع خطأ; };
    };
}

// A column whose values are not enumerated (text, ...): only equal literals and
// wildcards match a literal, and a wildcard head is decided by the wildcard rows.
عرف فائدة_مفتوحة_شمول(
    الصفوف: &متجه متجه خلية_شمول, السؤال: [] خلية_شمول,
    بقية_الأعمدة: [] اختياري معرف_نوع,
    السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة, الأنواع: &سجل_أنواع,
    العمق: طبيعي, الخطوات: &متغير طبيعي
): حكم_فائدة_شمول {
    ليكن بقية_السؤال: [] خلية_شمول = السؤال[1..];
    طابق السؤال[0] مع
    | خلية_شمول.بدل -> {
        ليكن الافتراضية: متجه متجه خلية_شمول = مصفوفة_افتراضية_شمول(الصفوف);
        أرجع فائدة_شمول(&الافتراضية, بقية_السؤال, بقية_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
    }
    | خلية_شمول.نمط(معرف_السؤال, _) -> {
        طابق نمط_عند(السجل, معرف_السؤال) مع
        | اختياري.موجود(نمط_دلالي.حرفي(_, حرفي_السؤال)) -> {
            ليكن المخصصة: متغير متجه متجه خلية_شمول = [];
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(*الصفوف) مثل طبيعي)) {
                طابق (*الصفوف)[ف][0] مع
                | خلية_شمول.بدل -> { ألحق(المخصصة, انسخ_صف_شمول(&(*الصفوف)[ف], 1)); }
                | خلية_شمول.نمط(المعرف, _) -> {
                    طابق نمط_عند(السجل, المعرف) مع
                    | اختياري.موجود(نمط_دلالي.حرفي(_, الحرفي)) -> {
                        إذا (حرفيان_متساويان_شمول(&الحرفي, &حرفي_السؤال)) {
                            ألحق(المخصصة, انسخ_صف_شمول(&(*الصفوف)[ف], 1));
                        };
                    }
                    | _ -> { أرجع حكم_فائدة_شمول.مجهول(); };
                };
                ف := ف + 1;
            }
            أرجع فائدة_شمول(&المخصصة, بقية_السؤال, بقية_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
        }
        | _ -> { أرجع حكم_فائدة_شمول.مجهول(); };
    };
}

// Usefulness of the vector specialized to constructor `م` (ordinal) of a
// closed column.
عرف فائدة_منشئ_شمول(
    الصفوف: &متجه متجه خلية_شمول, الترتيبات: &متجه طبيعي, عدد_المنشئات: طبيعي,
    م: طبيعي, السؤال: [] خلية_شمول, الصنف: &صنف_عمود_شمول, نوع_الرأس: معرف_نوع,
    بقية_الأعمدة: [] اختياري معرف_نوع,
    السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة, الأنواع: &سجل_أنواع,
    العمق: طبيعي, الخطوات: &متغير طبيعي
): حكم_فائدة_شمول {
    ليكن عدد_الحمولات: متغير طبيعي = 0;
    ليكن أنواع_المنشئ: متغير متجه اختياري معرف_نوع = [];
    طابق *الصنف مع
    | صنف_عمود_شمول.منشئات(_) -> {
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, نوع_الرأس, م) مع
        | اختياري.موجود(العدد) -> { عدد_الحمولات := العدد; }
        | اختياري.لا_شيء -> { أرجع حكم_فائدة_شمول.مجهول(); };
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < عدد_الحمولات) {
            ألحق(أنواع_المنشئ, نوع_حمولة_منشئ_دلالي_عند(الأنواع, نوع_الرأس, م, ح));
            ح := ح + 1;
        }
    }
    | _ -> { };
    ألحق_أنواع_شمول(&متغير أنواع_المنشئ, بقية_الأعمدة);
    ليكن مجهول: متغير منطقي = خطأ;
    ليكن المخصصة: متغير متجه متجه خلية_شمول = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الصفوف) مثل طبيعي)) {
        ليكن ترتيب_الصف: طبيعي = (*الترتيبات)[ف];
        إذا (ترتيب_الصف == م || ترتيب_الصف == عدد_المنشئات) {
            ليكن الصف: متغير متجه خلية_شمول = أبناء_رأس_شمول(
                (*الصفوف)[ف][0], عدد_الحمولات, نوع_الرأس, السجل, الأنواع, &متغير مجهول
            );
            ألحق_ذيل_صف_شمول(&متغير الصف, (*الصفوف)[ف], 1);
            ألحق(المخصصة, الصف);
        };
        ف := ف + 1;
    }
    ليكن السؤال_المخصص: متغير متجه خلية_شمول = أبناء_رأس_شمول(
        السؤال[0], عدد_الحمولات, نوع_الرأس, السجل, الأنواع, &متغير مجهول
    );
    ألحق_ذيل_صف_شمول(&متغير السؤال_المخصص, السؤال, 1);
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    أرجع فائدة_شمول(&المخصصة, السؤال_المخصص, أنواع_المنشئ, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
}

عرف ألحق_أنواع_شمول(الوجهة: &متغير متجه اختياري معرف_نوع, المصدر: [] اختياري معرف_نوع): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        ألحق(*الوجهة, المصدر[ف]);
        ف := ف + 1;
    }
}

// The head of a vector or slice column: a wildcard, or a sequence pattern
// with its elements before the rest, whether it has a rest, and its elements
// after it.
نوع رأس_تسلسل_شمول = {
    بدل: منطقي,
    السابقة: متجه معرف_نمط,
    له_بقية: منطقي,
    اللاحقة: متجه معرف_نمط,
    الموضع: طبيعي
};

عرف رأس_تسلسل_من_خلية_شمول(
    الخلية: خلية_شمول, السجل: &سجل_أنماط, مجهول: &متغير منطقي
): رأس_تسلسل_شمول {
    ليكن بلا_عناصر: متجه معرف_نمط = [];
    ليكن بلا_لاحقة: متجه معرف_نمط = [];
    ليكن البدل: رأس_تسلسل_شمول = {
        بدل: صواب, السابقة: بلا_عناصر, له_بقية: صواب, اللاحقة: بلا_لاحقة, الموضع: 0
    };
    طابق الخلية مع
    | خلية_شمول.بدل -> { أرجع البدل; }
    | خلية_شمول.نمط(المعرف, الموضع) -> {
        طابق نمط_عند(السجل, المعرف) مع
        | اختياري.موجود(نمط_دلالي.تسلسل(_, السابقة, البقية, اللاحقة)) -> {
            ليكن له_بقية: متغير منطقي = خطأ;
            طابق البقية مع
            | اختياري.موجود(_) -> { له_بقية := صواب; }
            | اختياري.لا_شيء -> { };
            ليكن الرأس: رأس_تسلسل_شمول = {
                بدل: خطأ, السابقة: انسخ_مملوكا_متجه_معرف_نمط(&السابقة), له_بقية: له_بقية,
                اللاحقة: انسخ_مملوكا_متجه_معرف_نمط(&اللاحقة), الموضع: الموضع
            };
            أرجع الرأس;
        }
        | _ -> { *مجهول := صواب; أرجع البدل; };
    };
}

// The shortest length from which on every length matches the head alike:
// past its fixed length, or its elements around the rest.
عرف حد_رأس_تسلسل_شمول(الرأس: &رأس_تسلسل_شمول): طبيعي {
    إذا ((*الرأس).بدل) { أرجع 0; };
    ليكن العدد: طبيعي = (الطول((*الرأس).السابقة) مثل طبيعي) + (الطول((*الرأس).اللاحقة) مثل طبيعي);
    إذا ((*الرأس).له_بقية) { أرجع العدد; };
    أرجع العدد + 1;
}

// The cells of a sequence head at length الطول (the last length, الحد,
// stands for every length from it on), or nothing when no value of that
// length matches it.
عرف خصص_رأس_تسلسل_شمول(
    الرأس: &رأس_تسلسل_شمول, المطلوب: طبيعي, السجل: &سجل_أنماط
): اختياري متجه خلية_شمول {
    ليكن الناتج: متغير متجه خلية_شمول = [];
    إذا ((*الرأس).بدل) {
        ليكن ف: متغير طبيعي = 0;
        احجز_سعة(الناتج, المطلوب);
        طالما (ف < المطلوب) { ألحق(الناتج, خلية_شمول.بدل()); ف := ف + 1; }
        أرجع اختياري.موجود(الناتج);
    };
    ليكن السابقة: طبيعي = الطول((*الرأس).السابقة) مثل طبيعي;
    ليكن اللاحقة: طبيعي = الطول((*الرأس).اللاحقة) مثل طبيعي;
    إذا (!(*الرأس).له_بقية && السابقة + اللاحقة != المطلوب) { أرجع اختياري.لا_شيء(); };
    إذا (السابقة + اللاحقة > المطلوب) { أرجع اختياري.لا_شيء(); };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < السابقة) {
        ألحق(الناتج, خلية_من_نمط_شمول((*الرأس).السابقة[ف], (*الرأس).الموضع, السجل));
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (المطلوب - السابقة - اللاحقة)) { ألحق(الناتج, خلية_شمول.بدل()); ف := ف + 1; }
    ف := 0;
    طالما (ف < اللاحقة) {
        ألحق(الناتج, خلية_من_نمط_شمول((*الرأس).اللاحقة[ف], (*الرأس).الموضع, السجل));
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// A vector or slice column: a value of each length is a tuple of that many
// elements. Lengths from the bound الحد on, past every fixed length and every
// prefix and suffix, are matched alike, so lengths 0 to الحد are asked, the
// last standing for all longer ones (`[]` and `[_, rest _]` cover every vector).
عرف فائدة_تسلسل_شمول(
    الصفوف: &متجه متجه خلية_شمول, السؤال: [] خلية_شمول, نوع_الرأس: معرف_نوع,
    بقية_الأنواع: [] اختياري معرف_نوع,
    السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة, الأنواع: &سجل_أنواع,
    العمق: طبيعي, الخطوات: &متغير طبيعي
): حكم_فائدة_شمول {
    ليكن مجهول: متغير منطقي = خطأ;
    ليكن الرؤوس: متغير متجه رأس_تسلسل_شمول = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الصفوف) مثل طبيعي)) {
        ألحق(الرؤوس, رأس_تسلسل_من_خلية_شمول((*الصفوف)[ف][0], السجل, &متغير مجهول));
        ف := ف + 1;
    }
    ليكن رأس_السؤال: رأس_تسلسل_شمول = رأس_تسلسل_من_خلية_شمول(السؤال[0], السجل, &متغير مجهول);
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    ليكن نوع_العنصر: اختياري معرف_نوع = نوع_عنصر_تسلسل_دلالي(الأنواع, نوع_الرأس);
    ليكن الحد: متغير طبيعي = حد_رأس_تسلسل_شمول(&رأس_السؤال);
    ف := 0;
    طالما (ف < (الطول(الرؤوس) مثل طبيعي)) {
        ليكن حد_الصف: طبيعي = حد_رأس_تسلسل_شمول(&الرؤوس[ف]);
        إذا (حد_الصف > الحد) { الحد := حد_الصف; };
        ف := ف + 1;
    }
    إذا (الحد > 64) { أرجع حكم_فائدة_شمول.مجهول(); };
    ليكن الطول_الحالي: متغير طبيعي = 0;
    طالما (الطول_الحالي <= الحد) {
        طابق خصص_رأس_تسلسل_شمول(&رأس_السؤال, الطول_الحالي, السجل) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(خلايا_السؤال) -> {
            ليكن السؤال_المخصص: متغير متجه خلية_شمول = خلايا_السؤال;
            ألحق_ذيل_صف_شمول(&متغير السؤال_المخصص, السؤال, 1);
            ليكن المخصصة: متغير متجه متجه خلية_شمول = [];
            ليكن ر: متغير طبيعي = 0;
            طالما (ر < (الطول(الرؤوس) مثل طبيعي)) {
                طابق خصص_رأس_تسلسل_شمول(&الرؤوس[ر], الطول_الحالي, السجل) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الخلايا) -> {
                    ليكن الصف: متغير متجه خلية_شمول = الخلايا;
                    ألحق_ذيل_صف_شمول(&متغير الصف, (*الصفوف)[ر], 1);
                    ألحق(المخصصة, الصف);
                };
                ر := ر + 1;
            }
            ليكن الأعمدة: متغير متجه اختياري معرف_نوع = [];
            ليكن ع: متغير طبيعي = 0;
            احجز_سعة(الأعمدة, الطول_الحالي);
            طالما (ع < الطول_الحالي) { ألحق(الأعمدة, نوع_العنصر); ع := ع + 1; }
            ألحق_أنواع_شمول(&متغير الأعمدة, بقية_الأنواع);
            إذا (ادمج_حكمي_شمول(فائدة_شمول(
                &المخصصة, السؤال_المخصص, الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات
            ), &متغير مجهول)) { أرجع حكم_فائدة_شمول.مفيد(); };
        };
        الطول_الحالي := الطول_الحالي + 1;
    }
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    أرجع حكم_فائدة_شمول.غير_مفيد();
}

// Whether some value matches `السؤال` and no row of `الصفوف_الخام`.
عرف فائدة_شمول(
    الصفوف_الخام: &متجه متجه خلية_شمول,
    السؤال: [] خلية_شمول,
    الأنواع_الأعمدة: [] اختياري معرف_نوع,
    السجل: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الأنواع: &سجل_أنواع,
    العمق: طبيعي,
    الخطوات: &متغير طبيعي
): حكم_فائدة_شمول {
    إذا ((الطول(*الصفوف_الخام) مثل طبيعي) == 0) { أرجع حكم_فائدة_شمول.مفيد(); };
    إذا ((الطول(السؤال) مثل طبيعي) == 0) { أرجع حكم_فائدة_شمول.غير_مفيد(); };
    *الخطوات := *الخطوات + (الطول(*الصفوف_الخام) مثل طبيعي) + 1;
    إذا (*الخطوات > حد_خطوات_شمول || العمق > 2000) { أرجع حكم_فائدة_شمول.مجهول(); };
    إذا ((الطول(الأنواع_الأعمدة) مثل طبيعي) != (الطول(السؤال) مثل طبيعي)) {
        أرجع حكم_فائدة_شمول.مجهول();
    };
    // A row of wildcards (a catch-all arm) covers every value.
    ليكن خ: متغير طبيعي = 0;
    طالما (خ < (الطول(*الصفوف_الخام) مثل طبيعي)) {
        إذا (صف_بدل_شمول(&(*الصفوف_الخام)[خ])) { أرجع حكم_فائدة_شمول.غير_مفيد(); };
        خ := خ + 1;
    }
    // The question and its Types past the head column: views, not copies.
    ليكن بقية_الأنواع: [] اختياري معرف_نوع = الأنواع_الأعمدة[1..];
    ليكن بقية_السؤال: [] خلية_شمول = السؤال[1..];
    // An or-pattern at the head of the vector is useful when one alternative is.
    ليكن مجهول: متغير منطقي = خطأ;
    طابق السؤال[0] مع
    | خلية_شمول.نمط(المعرف, الموضع) -> {
        طابق نمط_عند(السجل, المعرف) مع
        | اختياري.موجود(نمط_دلالي.بدائل(_, البدائل)) -> {
            ليكن ب: متغير طبيعي = 0;
            طالما (ب < (الطول(البدائل) مثل طبيعي)) {
                ليكن البديل: متغير متجه خلية_شمول = [];
                ألحق(البديل, خلية_من_نمط_شمول(البدائل[ب], الموضع, السجل));
                ألحق_ذيل_صف_شمول(&متغير البديل, السؤال, 1);
                إذا (ادمج_حكمي_شمول(فائدة_شمول(
                    الصفوف_الخام, البديل, الأنواع_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات
                ), &متغير مجهول)) { أرجع حكم_فائدة_شمول.مفيد(); };
                ب := ب + 1;
            }
            إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
            أرجع حكم_فائدة_شمول.غير_مفيد();
        }
        | _ -> { };
    }
    | خلية_شمول.بدل -> { };
    ليكن الصفوف: متجه متجه خلية_شمول = وسع_بدائل_رأس_شمول(الصفوف_الخام, السجل, &متغير مجهول);
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    // A column of wildcards only needs no Type: drop it.
    ليكن رأس_السؤال_بدل: منطقي = خلية_بدل_شمول(السؤال[0]);
    إذا (رأس_السؤال_بدل) {
        ليكن كلها_بدل: متغير منطقي = صواب;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الصفوف) مثل طبيعي) && كلها_بدل) {
            إذا (!خلية_بدل_شمول(الصفوف[ف][0])) { كلها_بدل := خطأ; };
            ف := ف + 1;
        }
        إذا (كلها_بدل) {
            ليكن الافتراضية: متجه متجه خلية_شمول = مصفوفة_افتراضية_شمول(&الصفوف);
            أرجع فائدة_شمول(&الافتراضية, بقية_السؤال, بقية_الأنواع, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
        };
    };
    ليكن نوع_الرأس: معرف_نوع;
    طابق الأنواع_الأعمدة[0] مع
    | اختياري.موجود(النوع) -> { نوع_الرأس := نوع_عمود_مقنن_شمول(الأنواع, النوع); }
    | اختياري.لا_شيء -> { أرجع حكم_فائدة_شمول.مجهول(); };
    ليكن الصنف: صنف_عمود_شمول = صنف_عمود_شمول_لنوع(الأنواع, نوع_الرأس);

    ليكن عدد_المنشئات: متغير طبيعي = 0;
    ليكن حجم_واحد: متغير طبيعي = 0;
    ليكن واحد: متغير منطقي = خطأ;
    طابق الصنف مع
    | صنف_عمود_شمول.منشئات(العدد) -> { عدد_المنشئات := العدد; }
    | صنف_عمود_شمول.منطقي -> { عدد_المنشئات := 2; }
    | صنف_عمود_شمول.سجل(العدد) -> { واحد := صواب; حجم_واحد := العدد; }
    | صنف_عمود_شمول.صف(العدد) -> { واحد := صواب; حجم_واحد := العدد; }
    | صنف_عمود_شمول.مجالات(الأدنى, الأعلى, صنف_المجال) -> {
        ليكن المجالات: متغير متجه مجال_شمول = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الصفوف) مثل طبيعي)) {
            ألحق(المجالات, مجال_رأس_شمول(الصفوف[ف][0], السجل, الأدنى, الأعلى, صنف_المجال, &متغير مجهول));
            ف := ف + 1;
        }
        ليكن مجال_السؤال: مجال_شمول = مجال_رأس_شمول(
            السؤال[0], السجل, الأدنى, الأعلى, صنف_المجال, &متغير مجهول
        );
        إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
        // A literal outside the column's values matches nothing.
        إذا (مجال_السؤال.فارغ) { أرجع حكم_فائدة_شمول.غير_مفيد(); };
        أرجع فائدة_مجالات_شمول(
            &الصفوف, &المجالات, مجال_السؤال.الأدنى, مجال_السؤال.الأعلى, مجال_السؤال.بدل,
            بقية_السؤال, بقية_الأنواع, السجل, التحققات, الأنواع, العمق, الخطوات
        );
    }
    | صنف_عمود_شمول.تسلسل -> {
        أرجع فائدة_تسلسل_شمول(
            &الصفوف, السؤال, نوع_الرأس, بقية_الأنواع, السجل, التحققات, الأنواع, العمق, الخطوات
        );
    }
    | صنف_عمود_شمول.مفتوح -> {
        أرجع فائدة_مفتوحة_شمول(
            &الصفوف, السؤال, بقية_الأنواع, السجل, التحققات, الأنواع, العمق, الخطوات
        );
    };

    // A record or tuple has exactly one shape: expand it in place.
    إذا (واحد) {
        ليكن المصفوفة: متغير متجه متجه خلية_شمول = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الصفوف) مثل طبيعي)) {
            ليكن الصف: متغير متجه خلية_شمول = أبناء_رأس_شمول(
                الصفوف[ف][0], حجم_واحد, نوع_الرأس, السجل, الأنواع, &متغير مجهول
            );
            ألحق_ذيل_صف_شمول(&متغير الصف, الصفوف[ف], 1);
            ألحق(المصفوفة, الصف);
            ف := ف + 1;
        }
        ليكن السؤال_الموسع: متغير متجه خلية_شمول = أبناء_رأس_شمول(
            السؤال[0], حجم_واحد, نوع_الرأس, السجل, الأنواع, &متغير مجهول
        );
        ألحق_ذيل_صف_شمول(&متغير السؤال_الموسع, السؤال, 1);
        إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
        ليكن الأنواع_الجديدة: متغير متجه اختياري معرف_نوع = [];
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < حجم_واحد) {
            طابق الصنف مع
            | صنف_عمود_شمول.سجل(_) -> {
                ألحق(الأنواع_الجديدة, نوع_حقل_سجل_دلالي_عند(الأنواع, نوع_الرأس, ع));
            }
            | _ -> {
                ألحق(الأنواع_الجديدة, نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الرأس, ع));
            };
            ع := ع + 1;
        }
        ألحق_أنواع_شمول(&متغير الأنواع_الجديدة, بقية_الأنواع);
        أرجع فائدة_شمول(&المصفوفة, السؤال_الموسع, الأنواع_الجديدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
    };

    // A closed set of constructors. Each row's head constructor is found once
    // (a wildcard head is marked with عدد_المنشئات).
    ليكن الترتيبات: متغير متجه طبيعي = [];
    ليكن الموجودة: متغير متجه منطقي = [];
    ليكن م: متغير طبيعي = 0;
    احجز_سعة(الموجودة, عدد_المنشئات);
    طالما (م < عدد_المنشئات) { ألحق(الموجودة, خطأ); م := م + 1; }
    ليكن عدد_الموجودة: متغير طبيعي = 0;
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الصفوف) مثل طبيعي)) {
        طابق ترتيب_رأس_شمول(الصفوف[ر][0], السجل, التحققات, الأنواع, &الصنف, &متغير مجهول) مع
        | اختياري.موجود(الترتيب) -> {
            إذا (الترتيب >= عدد_المنشئات) { أرجع حكم_فائدة_شمول.مجهول(); };
            ألحق(الترتيبات, الترتيب);
            إذا (!الموجودة[الترتيب]) { الموجودة[الترتيب] := صواب; عدد_الموجودة := عدد_الموجودة + 1; };
        }
        | اختياري.لا_شيء -> { ألحق(الترتيبات, عدد_المنشئات); };
        ر := ر + 1;
    }
    ليكن ترتيب_السؤال: اختياري طبيعي = ترتيب_رأس_شمول(
        السؤال[0], السجل, التحققات, الأنواع, &الصنف, &متغير مجهول
    );
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    طابق ترتيب_السؤال مع
    | اختياري.موجود(الترتيب) -> {
        إذا (الترتيب >= عدد_المنشئات) { أرجع حكم_فائدة_شمول.مجهول(); };
        أرجع فائدة_منشئ_شمول(
            &الصفوف, &الترتيبات, عدد_المنشئات, الترتيب, السؤال, &الصنف, نوع_الرأس,
            بقية_الأنواع, السجل, التحققات, الأنواع, العمق, الخطوات
        );
    }
    | اختياري.لا_شيء -> { };
    // A wildcard head: when some constructor is named by no row, only the
    // wildcard rows can cover it (the default-matrix shortcut).
    إذا (عدد_الموجودة < عدد_المنشئات) {
        ليكن الافتراضية: متجه متجه خلية_شمول = مصفوفة_افتراضية_شمول(&الصفوف);
        أرجع فائدة_شمول(&الافتراضية, بقية_السؤال, بقية_الأنواع, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
    };
    م := 0;
    طالما (م < عدد_المنشئات) {
        إذا (ادمج_حكمي_شمول(فائدة_منشئ_شمول(
            &الصفوف, &الترتيبات, عدد_المنشئات, م, السؤال, &الصنف, نوع_الرأس,
            بقية_الأنواع, السجل, التحققات, الأنواع, العمق, الخطوات
        ), &متغير مجهول)) { أرجع حكم_فائدة_شمول.مفيد(); };
        م := م + 1;
    }
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    أرجع حكم_فائدة_شمول.غير_مفيد();
}

// The alternatives of the or-patterns nested in a reachable arm's pattern
// (below its root, which حلل_أذرع_مطابقة checks against the earlier arms)
// that the earlier alternatives of the same or-pattern cover: whatever the
// rest of the pattern, the value at that place matches an earlier
// alternative first. The check is that of one column, of the or-pattern's
// Type. It does not ask whether the earlier arms cover an alternative nested
// in a pattern (`| option.some(1) -> … | option.some(1 | 2) -> …`): only
// the alternatives at an arm's root are checked against the earlier arms.
// The subtrees of المستثناة (alternatives already reported) are skipped.
عرف ألحق_بدائل_داخلية_زائدة_شمول(
    النمط: معرف_نمط,
    الجذر: منطقي,
    الموضع: طبيعي,
    المستثناة: &متجه معرف_نمط,
    السجل: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الأنواع: &سجل_أنواع,
    الناتج: &متغير متجه معرف_نمط
): فراغ {
    ليكن س: متغير طبيعي = 0;
    طالما (س < (الطول(*المستثناة) مثل طبيعي)) {
        إذا ((*المستثناة)[س].القيمة == النمط.القيمة) { أرجع; };
        س := س + 1;
    }
    ليكن الدلالي: نمط_دلالي;
    طابق نمط_عند(السجل, النمط) مع
    | اختياري.موجود(القيمة) -> { الدلالي := القيمة; }
    | اختياري.لا_شيء -> { أرجع; };
    ليكن الأبناء: متجه معرف_نمط = أبناء_نمط_دلالي(&الدلالي);
    طابق الدلالي مع
    | نمط_دلالي.بدائل(_, البدائل) -> {
        إذا (!الجذر && الموضع < (الطول(*التحققات) مثل طبيعي)) {
            ليكن الأعمدة: متغير متجه اختياري معرف_نوع = [];
            ألحق(الأعمدة, نوع_عقدة_نمط_عند(&(*التحققات)[الموضع].التحقق, النمط));
            ليكن السابقة: متغير متجه متجه خلية_شمول = [];
            ليكن ب: متغير طبيعي = 0;
            طالما (ب < (الطول(البدائل) مثل طبيعي)) {
                ليكن خلية_البديل: خلية_شمول = خلية_من_نمط_شمول(البدائل[ب], الموضع, السجل);
                إذا (ب > 0) {
                    ليكن السؤال: متغير متجه خلية_شمول = [];
                    ألحق(السؤال, خلية_البديل);
                    ليكن الخطوات: متغير طبيعي = 0;
                    طابق فائدة_شمول(&السابقة, السؤال, الأعمدة, السجل, التحققات, الأنواع, 0, &متغير الخطوات) مع
                    | حكم_فائدة_شمول.غير_مفيد -> { ألحق(*الناتج, البدائل[ب]); }
                    | _ -> { };
                };
                ليكن الصف: متغير متجه خلية_شمول = [];
                ألحق(الصف, خلية_البديل);
                ألحق(السابقة, الصف);
                ب := ب + 1;
            }
        };
    }
    | _ -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأبناء) مثل طبيعي)) {
        // A reported alternative's own subtree is not checked again.
        ليكن مبلغ: متغير منطقي = خطأ;
        ليكن ن: متغير طبيعي = 0;
        طالما (ن < (الطول(*الناتج) مثل طبيعي)) {
            إذا ((*الناتج)[ن].القيمة == الأبناء[ف].القيمة) { مبلغ := صواب; };
            ن := ن + 1;
        }
        إذا (!مبلغ) {
            ألحق_بدائل_داخلية_زائدة_شمول(
                الأبناء[ف], خطأ, الموضع, المستثناة, السجل, التحققات, الأنواع, الناتج
            );
        };
        ف := ف + 1;
    }
}

// Exhaustiveness and unreachable arms of one match (root pattern and position
// of its type check, per arm, and whether the arm has a guard). A guarded arm
// covers nothing: its guard may fail, so it counts toward neither
// exhaustiveness nor the coverage of the arms after it; it is still reported
// when the arms before it cover its pattern.
عام عرف حلل_أذرع_مطابقة(
    الجذور: &متجه معرف_نمط,
    مواضع_التحققات: &متجه طبيعي,
    المحروسة: &متجه منطقي,
    السجل: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الأنواع: &سجل_أنواع
): تحليل_أذرع_مطابقة {
    ليكن غير_القابلة: متغير متجه طبيعي = [];
    ليكن عدد_الأذرع: طبيعي = الطول(*الجذور) مثل طبيعي;
    إذا (عدد_الأذرع == 0) {
        ليكن بلا_ناقصة: متجه طبيعي = [];
        ليكن بلا_بدائل: متجه معرف_نمط = [];
        ليكن الفارغ: تحليل_أذرع_مطابقة = {
            الشمول: حكم_شمول_مطابقة.شاملة(), غير_القابلة_للوصول: غير_القابلة,
            البدائل_غير_القابلة_للوصول: بلا_بدائل,
            الناقصة: بلا_ناقصة, الشكل_الناقص: اختياري.لا_شيء(), نوع_المميز: اختياري.لا_شيء()
        };
        أرجع الفارغ;
    };
    ليكن الموضع_الأول: طبيعي = (*مواضع_التحققات)[0];
    ليكن نوع_المميز: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    إذا (الموضع_الأول < (الطول(*التحققات) مثل طبيعي)) {
        نوع_المميز := نوع_عقدة_نمط_عند(&(*التحققات)[الموضع_الأول].التحقق, (*الجذور)[0]);
    };
    ليكن الأعمدة: متغير متجه اختياري معرف_نوع = [];
    ألحق(الأعمدة, نوع_المميز);

    // Head constructor of each arm when the scrutinee has a closed set of
    // constructors: the common long match over an enumeration is then decided
    // per arm by counting, without building a matrix.
    ليكن الصنف: متغير صنف_عمود_شمول = صنف_عمود_شمول.مفتوح();
    ليكن عدد_المنشئات: متغير طبيعي = 0;
    طابق نوع_المميز مع
    | اختياري.موجود(النوع) -> {
        الصنف := صنف_عمود_شمول_لنوع(الأنواع, نوع_عمود_مقنن_شمول(الأنواع, النوع));
        طابق الصنف مع
        | صنف_عمود_شمول.منشئات(العدد) -> { عدد_المنشئات := العدد; }
        | صنف_عمود_شمول.منطقي -> { عدد_المنشئات := 2; }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    ليكن الخلايا: متغير متجه خلية_شمول = [];
    // Per arm: ordinal, عدد_المنشئات for a wildcard, عدد_المنشئات + 1 otherwise.
    ليكن الترتيبات: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأذرع) {
        ليكن الخلية: خلية_شمول = خلية_من_نمط_شمول((*الجذور)[ف], (*مواضع_التحققات)[ف], السجل);
        ألحق(الخلايا, الخلية);
        ليكن الترتيب: متغير طبيعي = عدد_المنشئات + 1;
        إذا (خلية_بدل_شمول(الخلية)) {
            الترتيب := عدد_المنشئات;
        } وإلا إذا (عدد_المنشئات > 0) {
            ليكن مجهول_الرأس: متغير منطقي = خطأ;
            طابق ترتيب_رأس_شمول(الخلية, السجل, التحققات, الأنواع, &الصنف, &متغير مجهول_الرأس) مع
            | اختياري.موجود(ت) -> { إذا (!مجهول_الرأس && ت < عدد_المنشئات) { الترتيب := ت; }; }
            | اختياري.لا_شيء -> { };
        };
        ألحق(الترتيبات, الترتيب);
        ف := ف + 1;
    }

    ليكن لكل_منشئ: متغير متجه طبيعي = [];
    ليكن م: متغير طبيعي = 0;
    احجز_سعة(لكل_منشئ, عدد_المنشئات);
    طالما (م < عدد_المنشئات) { ألحق(لكل_منشئ, 0); م := م + 1; }
    ليكن يوجد_بدل: متغير منطقي = خطأ;
    ليكن عدد_المركبة: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < عدد_الأذرع) {
        ليكن الترتيب: طبيعي = الترتيبات[ف];
        إذا (ف > 0) {
            // The first arm naming a constructor is reachable.
            ليكن أول_منشئ: منطقي = الترتيب < عدد_المنشئات && عدد_المركبة == 0 && لكل_منشئ[الترتيب] == 0;
            إذا (يوجد_بدل) {
                ألحق(غير_القابلة, ف);
            } وإلا إذا (!أول_منشئ) {
                ليكن السابقة: متغير متجه متجه خلية_شمول = [];
                ليكن س: متغير طبيعي = 0;
                طالما (س < ف) {
                    إذا (!(*المحروسة)[س]
                        && (الترتيب >= عدد_المنشئات || عدد_المركبة > 0 || الترتيبات[س] == الترتيب)) {
                        ليكن الصف: متغير متجه خلية_شمول = [];
                        ألحق(الصف, الخلايا[س]);
                        ألحق(السابقة, الصف);
                    };
                    س := س + 1;
                }
                ليكن السؤال: متغير متجه خلية_شمول = [];
                ألحق(السؤال, الخلايا[ف]);
                ليكن الخطوات: متغير طبيعي = 0;
                طابق فائدة_شمول(&السابقة, السؤال, الأعمدة, السجل, التحققات, الأنواع, 0, &متغير الخطوات) مع
                | حكم_فائدة_شمول.غير_مفيد -> { ألحق(غير_القابلة, ف); }
                | _ -> { };
            };
        };
        إذا ((*المحروسة)[ف]) {
        } وإلا إذا (الترتيب == عدد_المنشئات) {
            يوجد_بدل := صواب;
        } وإلا إذا (الترتيب < عدد_المنشئات) {
            لكل_منشئ[الترتيب] := لكل_منشئ[الترتيب] + 1;
        } وإلا {
            عدد_المركبة := عدد_المركبة + 1;
        };
        ف := ف + 1;
    }

    // The alternatives of each reachable arm's or-pattern: one is redundant
    // when the earlier arms and the arm's earlier alternatives cover it.
    ليكن البدائل_الزائدة: متغير متجه معرف_نمط = [];
    ف := 0;
    طالما (ف < عدد_الأذرع) {
        ليكن غير_قابل: متغير منطقي = خطأ;
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول(غير_القابلة) مثل طبيعي)) {
            إذا (غير_القابلة[ت] == ف) { غير_قابل := صواب; };
            ت := ت + 1;
        }
        إذا (!غير_قابل) {
            طابق نمط_عند(السجل, انزع_الاستعارة_شمول((*الجذور)[ف], السجل)) مع
            | اختياري.موجود(نمط_دلالي.بدائل(_, البدائل)) -> {
                ليكن السابقة: متغير متجه متجه خلية_شمول = [];
                ليكن س: متغير طبيعي = 0;
                طالما (س < ف) {
                    إذا (!(*المحروسة)[س]) {
                        ليكن الصف: متغير متجه خلية_شمول = [];
                        ألحق(الصف, الخلايا[س]);
                        ألحق(السابقة, الصف);
                    };
                    س := س + 1;
                }
                ليكن ب: متغير طبيعي = 0;
                طالما (ب < (الطول(البدائل) مثل طبيعي)) {
                    ليكن خلية_البديل: خلية_شمول = خلية_من_نمط_شمول(
                        البدائل[ب], (*مواضع_التحققات)[ف], السجل
                    );
                    ليكن السؤال: متغير متجه خلية_شمول = [];
                    ألحق(السؤال, خلية_البديل);
                    ليكن الخطوات: متغير طبيعي = 0;
                    طابق فائدة_شمول(&السابقة, السؤال, الأعمدة, السجل, التحققات, الأنواع, 0, &متغير الخطوات) مع
                    | حكم_فائدة_شمول.غير_مفيد -> { ألحق(البدائل_الزائدة, البدائل[ب]); }
                    | _ -> { };
                    ليكن الصف: متغير متجه خلية_شمول = [];
                    ألحق(الصف, خلية_البديل);
                    ألحق(السابقة, الصف);
                    ب := ب + 1;
                }
            }
            | _ -> { };
            // An or-pattern nested in the arm's pattern: an alternative its
            // earlier alternatives cover is redundant.
            ليكن الداخلية: متغير متجه معرف_نمط = [];
            ألحق_بدائل_داخلية_زائدة_شمول(
                انزع_الاستعارة_شمول((*الجذور)[ف], السجل), صواب, (*مواضع_التحققات)[ف], &البدائل_الزائدة,
                السجل, التحققات, الأنواع, &متغير الداخلية
            );
            ليكن د: متغير طبيعي = 0;
            طالما (د < (الطول(الداخلية) مثل طبيعي)) { ألحق(البدائل_الزائدة, الداخلية[د]); د := د + 1; }
        };
        ف := ف + 1;
    }

    ليكن الشمول: متغير حكم_شمول_مطابقة = حكم_شمول_مطابقة.شاملة();
    // The cells of the arms without a guard.
    ليكن الخلايا_المغطية: متغير متجه خلية_شمول = [];
    ف := 0;
    طالما (ف < عدد_الأذرع) {
        إذا (!(*المحروسة)[ف]) { ألحق(الخلايا_المغطية, الخلايا[ف]); };
        ف := ف + 1;
    }
    إذا (!يوجد_بدل) {
        ليكن الصفوف: متغير متجه متجه خلية_شمول = [];
        ف := 0;
        طالما (ف < (الطول(الخلايا_المغطية) مثل طبيعي)) {
            ليكن الصف: متغير متجه خلية_شمول = [];
            ألحق(الصف, الخلايا_المغطية[ف]);
            ألحق(الصفوف, الصف);
            ف := ف + 1;
        }
        ليكن السؤال: متغير متجه خلية_شمول = [];
        ألحق(السؤال, خلية_شمول.بدل());
        ليكن الخطوات: متغير طبيعي = 0;
        طابق فائدة_شمول(&الصفوف, السؤال, الأعمدة, السجل, التحققات, الأنواع, 0, &متغير الخطوات) مع
        | حكم_فائدة_شمول.مفيد -> { الشمول := حكم_شمول_مطابقة.غير_شاملة(); }
        | حكم_فائدة_شمول.مجهول -> { الشمول := حكم_شمول_مطابقة.غير_مثبتة(); }
        | حكم_فائدة_شمول.غير_مفيد -> { };
    };
    ليكن الناقصة: متغير متجه طبيعي = [];
    ليكن الشكل_الناقص: متغير اختياري شكل_تسلسل_ناقص = اختياري.لا_شيء();
    طابق الشمول مع
    | حكم_شمول_مطابقة.غير_شاملة -> {
        طابق نوع_المميز مع
        | اختياري.موجود(النوع) -> {
            إذا (عدد_المنشئات > 0) {
                الناقصة := منشئات_ناقصة_شمول(
                    &الخلايا_المغطية, عدد_المنشئات, &الصنف, نوع_عمود_مقنن_شمول(الأنواع, النوع),
                    السجل, التحققات, الأنواع
                );
            };
            طابق الصنف مع
            | صنف_عمود_شمول.تسلسل -> {
                الشكل_الناقص := شكل_تسلسل_ناقص_شمول(
                    &الخلايا_المغطية, نوع_عمود_مقنن_شمول(الأنواع, النوع), السجل, التحققات, الأنواع
                );
            }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    // The scrutinee's Type, read through references as its column is.
    ليكن نوع_المميز_المقنن: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق نوع_المميز مع
    | اختياري.موجود(النوع) -> { نوع_المميز_المقنن := اختياري.موجود(نوع_عمود_مقنن_شمول(الأنواع, النوع)); }
    | اختياري.لا_شيء -> { };
    ليكن الناتج: تحليل_أذرع_مطابقة = {
        الشمول: الشمول, غير_القابلة_للوصول: غير_القابلة,
        البدائل_غير_القابلة_للوصول: البدائل_الزائدة,
        الناقصة: الناقصة, الشكل_الناقص: الشكل_الناقص, نوع_المميز: نوع_المميز_المقنن
    };
    أرجع الناتج;
}

// The shortest vector or slice shape that no arm (الخلايا, the arms without
// a guard) covers: each length up to the bound past every arm's fixed
// length and elements around its rest is asked as a vector of that many
// wildcards; the bound stands for every longer length too (مفتوح).
عرف شكل_تسلسل_ناقص_شمول(
    الخلايا: &متجه خلية_شمول, نوع_المميز: معرف_نوع,
    السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة, الأنواع: &سجل_أنواع
): اختياري شكل_تسلسل_ناقص {
    ليكن مجهول: متغير منطقي = خطأ;
    ليكن الخام: متغير متجه متجه خلية_شمول = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الخلايا) مثل طبيعي)) {
        ليكن الصف: متغير متجه خلية_شمول = [];
        ألحق(الصف, (*الخلايا)[ف]);
        ألحق(الخام, الصف);
        ف := ف + 1;
    }
    ليكن الصفوف: متجه متجه خلية_شمول = وسع_بدائل_رأس_شمول(&الخام, السجل, &متغير مجهول);
    ليكن الرؤوس: متغير متجه رأس_تسلسل_شمول = [];
    ليكن الحد: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول(الصفوف) مثل طبيعي)) {
        ليكن الرأس: رأس_تسلسل_شمول = رأس_تسلسل_من_خلية_شمول(الصفوف[ف][0], السجل, &متغير مجهول);
        ليكن حد_الصف: طبيعي = حد_رأس_تسلسل_شمول(&الرأس);
        إذا (حد_الصف > الحد) { الحد := حد_الصف; };
        ألحق(الرؤوس, الرأس);
        ف := ف + 1;
    }
    إذا (مجهول || الحد > 64) { أرجع اختياري.لا_شيء(); };
    ليكن نوع_العنصر: اختياري معرف_نوع = نوع_عنصر_تسلسل_دلالي(الأنواع, نوع_المميز);
    ليكن المطلوب: متغير طبيعي = 0;
    طالما (المطلوب <= الحد) {
        ليكن المخصصة: متغير متجه متجه خلية_شمول = [];
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < (الطول(الرؤوس) مثل طبيعي)) {
            طابق خصص_رأس_تسلسل_شمول(&الرؤوس[ر], المطلوب, السجل) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الخلايا_المخصصة) -> { ألحق(المخصصة, الخلايا_المخصصة); };
            ر := ر + 1;
        }
        ليكن السؤال: متغير متجه خلية_شمول = [];
        ليكن الأعمدة: متغير متجه اختياري معرف_نوع = [];
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < المطلوب) {
            ألحق(السؤال, خلية_شمول.بدل());
            ألحق(الأعمدة, نوع_العنصر);
            ع := ع + 1;
        }
        ليكن الخطوات: متغير طبيعي = 0;
        طابق فائدة_شمول(&المخصصة, السؤال, الأعمدة, السجل, التحققات, الأنواع, 0, &متغير الخطوات) مع
        | حكم_فائدة_شمول.مفيد -> {
            ليكن الشكل: شكل_تسلسل_ناقص = { العدد: المطلوب, مفتوح: المطلوب == الحد };
            أرجع اختياري.موجود(الشكل);
        }
        | _ -> { };
        المطلوب := المطلوب + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The head cases (constructor ordinals, or a boolean's 0 and 1) some value
// of which no arm covers: each is asked as the matrix specialized to it,
// the cases the diagnostic names. Empty when an arm's head cannot be
// classified or a question has no answer.
عرف منشئات_ناقصة_شمول(
    الخلايا: &متجه خلية_شمول,
    عدد_المنشئات: طبيعي,
    الصنف: &صنف_عمود_شمول,
    نوع_الرأس: معرف_نوع,
    السجل: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الأنواع: &سجل_أنواع
): متجه طبيعي {
    ليكن الناتج: متغير متجه طبيعي = [];
    ليكن بلا_ناقصة: متجه طبيعي = [];
    ليكن الصفوف: متغير متجه متجه خلية_شمول = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الخلايا) مثل طبيعي)) {
        ليكن الصف: متغير متجه خلية_شمول = [];
        ألحق(الصف, (*الخلايا)[ف]);
        ألحق(الصفوف, الصف);
        ف := ف + 1;
    }
    ليكن مجهول: متغير منطقي = خطأ;
    ليكن الموسعة: متجه متجه خلية_شمول = وسع_بدائل_رأس_شمول(&الصفوف, السجل, &متغير مجهول);
    إذا (مجهول) { أرجع بلا_ناقصة; };
    ليكن الترتيبات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(الموسعة) مثل طبيعي)) {
        ليكن الخلية: خلية_شمول = الموسعة[ف][0];
        إذا (خلية_بدل_شمول(الخلية)) {
            ألحق(الترتيبات, عدد_المنشئات);
        } وإلا {
            طابق ترتيب_رأس_شمول(الخلية, السجل, التحققات, الأنواع, الصنف, &متغير مجهول) مع
            | اختياري.موجود(ت) -> {
                إذا (ت >= عدد_المنشئات) { أرجع بلا_ناقصة; };
                ألحق(الترتيبات, ت);
            }
            | اختياري.لا_شيء -> { أرجع بلا_ناقصة; };
        };
        إذا (مجهول) { أرجع بلا_ناقصة; };
        ف := ف + 1;
    }
    ليكن بلا_أعمدة: متجه اختياري معرف_نوع = [];
    ليكن م: متغير طبيعي = 0;
    طالما (م < عدد_المنشئات) {
        ليكن السؤال: متغير متجه خلية_شمول = [];
        ألحق(السؤال, خلية_شمول.بدل());
        ليكن الخطوات: متغير طبيعي = 0;
        طابق فائدة_منشئ_شمول(
            &الموسعة, &الترتيبات, عدد_المنشئات, م, السؤال, الصنف, نوع_الرأس, بلا_أعمدة,
            السجل, التحققات, الأنواع, 0, &متغير الخطوات
        ) مع
        | حكم_فائدة_شمول.مفيد -> { ألحق(الناتج, م); }
        | حكم_فائدة_شمول.غير_مفيد -> { }
        | حكم_فائدة_شمول.مجهول -> { أرجع بلا_ناقصة; };
        م := م + 1;
    }
    أرجع الناتج;
}
