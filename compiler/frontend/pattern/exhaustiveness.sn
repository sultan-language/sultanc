استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.pattern_registry;
استورد compiler.frontend.pattern.type_validation;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.builtins_generated;

// Match analysis is the classic usefulness check over a pattern matrix (Maranget,
// "Warnings for pattern matching"). Rows are arms, columns are sub-values with
// their Types. A pattern vector is useful against a matrix when some value
// matches it and no row of the matrix:
//   - the match is exhaustive when the all-wildcard vector is not useful
//     against all arms;
//   - an arm is unreachable when it is not useful against the arms before it.
// The check fails closed: when a fact is missing (an unresolved constructor or
// Type, or the work budget runs out) the answer is "unknown". An unknown answer
// never proves a match exhaustive and never reports an arm unreachable.

// A matrix cell: a wildcard (also a binding), or a pattern node of the arm whose
// type check is at the given position of the unit's checks.
عام نوع خلية_شمول =
    | بدل
    | نمط بنوع (معرف_نمط, طبيعي)
;

نوع حكم_فائدة_شمول =
    | مفيد
    | غير_مفيد
    | مجهول
;

عام نوع حكم_شمول_مطابقة =
    | شاملة
    | غير_شاملة
    // Some fact the check needs is missing; the match is not proven exhaustive.
    | غير_مثبتة
;

عام نوع تحليل_أذرع_مطابقة = {
    الشمول: حكم_شمول_مطابقة,
    // Indices of the arms an earlier arm already covers.
    غير_القابلة_للوصول: متجه طبيعي
};

// Kinds of integer-like columns whose values are ordered.
نوع صنف_مجال_شمول =
    | موقعة
    | طبيعية
    | محارف
;

نوع صنف_عمود_شمول =
    | منشئات بنوع طبيعي
    | منطقي
    | سجل بنوع طبيعي
    | صف بنوع طبيعي
    // Ordered values in [الأدنى, الأعلى], kept as offset unsigned numbers.
    | مجالات بنوع (ط64, ط64, صنف_مجال_شمول)
    | مفتوح
;

// An inclusive interval of offset values; a wildcard head covers the domain.
نوع مجال_شمول = {
    الأدنى: ط64,
    الأعلى: ط64,
    بدل: منطقي,
    فارغ: منطقي
};

// Work budget of one question, in matrix rows visited.
دع حد_خطوات_شمول: طبيعي = 4000 * 1000;

عرف انسخ_صف_شمول(الصف: &متجه خلية_شمول, البداية: طبيعي): متجه خلية_شمول {
    دع الناتج: متغير متجه خلية_شمول = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < (الطول(*الصف) مثل طبيعي)) {
        ألحق(الناتج, (*الصف)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف انسخ_أنواع_شمول(الأنواع_الأعمدة: &متجه اختياري معرف_نوع, البداية: طبيعي): متجه اختياري معرف_نوع {
    دع الناتج: متغير متجه اختياري معرف_نوع = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < (الطول(*الأنواع_الأعمدة) مثل طبيعي)) {
        ألحق(الناتج, (*الأنواع_الأعمدة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Appends the cells of a row after the first `البداية` to a new row.
عرف ألحق_ذيل_صف_شمول(الوجهة: &متغير متجه خلية_شمول, الصف: &متجه خلية_شمول, البداية: طبيعي): فراغ {
    دع ف: متغير طبيعي = البداية;
    طالما (ف < (الطول(*الصف) مثل طبيعي)) {
        ألحق(*الوجهة, (*الصف)[ف]);
        ف := ف + 1;
    }
}

// Bindings and wildcards are the same cell for coverage.
عرف خلية_من_نمط_شمول(المعرف: معرف_نمط, الموضع: طبيعي, السجل: &سجل_أنماط): خلية_شمول {
    طابق نمط_عند(السجل, المعرف) مع
    | اختياري.موجود(نمط_دلالي.بدل(_)) -> { أرجع خلية_شمول.بدل(); }
    | اختياري.موجود(نمط_دلالي.ربط(_, _)) -> { أرجع خلية_شمول.بدل(); }
    | _ -> { أرجع خلية_شمول.نمط(المعرف, الموضع); };
}

عرف خلية_بدل_شمول(الخلية: خلية_شمول): منطقي {
    طابق الخلية مع
    | خلية_شمول.بدل -> { أرجع صواب; }
    | خلية_شمول.نمط(_, _) -> { أرجع خطأ; };
}

عرف صف_بدل_شمول(الصف: &متجه خلية_شمول): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الصف) مثل طبيعي)) {
        إذا (!خلية_بدل_شمول((*الصف)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// A reference column is matched through to its target.
عرف نوع_عمود_مقنن_شمول(الأنواع: &سجل_أنواع, النوع: معرف_نوع): معرف_نوع {
    دع الحالي: متغير معرف_نوع = النوع;
    دع ع: متغير طبيعي = 0;
    طالما (ع < 16) {
        طابق نوع_داخل_مرجع_دلالي(الأنواع, الحالي) مع
        | اختياري.موجود(الداخل) -> { الحالي := الداخل; }
        | اختياري.لا_شيء -> { أرجع الحالي; };
        ع := ع + 1;
    }
    أرجع الحالي;
}

// 2^63: signed values are offset by it so that every domain orders as unsigned.
عرف إزاحة_موقع_شمول(): ط64 {
    دع النصف: ط64 = 9223372036854775807;
    أرجع النصف + 1;
}

عرف قوة_اثنين_شمول(الأس: طبيعي): ط64 {
    دع الناتج: متغير ط64 = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الأس) { الناتج := الناتج * 2; ف := ف + 1; }
    أرجع الناتج;
}

عرف صنف_مجال_موقع_شمول(البتات: طبيعي): صنف_عمود_شمول {
    دع النصف: ط64 = قوة_اثنين_شمول(البتات - 1);
    دع الإزاحة: ط64 = إزاحة_موقع_شمول();
    أرجع صنف_عمود_شمول.مجالات(الإزاحة - النصف, الإزاحة + (النصف - 1), صنف_مجال_شمول.موقعة());
}

عرف صنف_مجال_طبيعي_شمول(البتات: طبيعي): صنف_عمود_شمول {
    دع النصف: ط64 = قوة_اثنين_شمول(البتات - 1);
    دع الأدنى: ط64 = 0;
    أرجع صنف_عمود_شمول.مجالات(الأدنى, (النصف - 1) + النصف, صنف_مجال_شمول.طبيعية());
}

// Integer columns: language-sized integers take the widest domain, which never
// proves a match exhaustive that a narrower domain would not.
عرف صنف_عمود_بدائي_شمول(البدائي: نوع_بدائي_مقنن): صنف_عمود_شمول {
    طابق البدائي مع
    | نوع_بدائي_مقنن.منطقي -> { أرجع صنف_عمود_شمول.منطقي(); }
    | نوع_بدائي_مقنن.ص8 -> { أرجع صنف_مجال_موقع_شمول(8); }
    | نوع_بدائي_مقنن.ص16 -> { أرجع صنف_مجال_موقع_شمول(16); }
    | نوع_بدائي_مقنن.ص32 -> { أرجع صنف_مجال_موقع_شمول(32); }
    | نوع_بدائي_مقنن.ص64 -> { أرجع صنف_مجال_موقع_شمول(64); }
    | نوع_بدائي_مقنن.عدد -> { أرجع صنف_مجال_موقع_شمول(64); }
    | نوع_بدائي_مقنن.ط8 -> { أرجع صنف_مجال_طبيعي_شمول(8); }
    | نوع_بدائي_مقنن.ط16 -> { أرجع صنف_مجال_طبيعي_شمول(16); }
    | نوع_بدائي_مقنن.ط32 -> { أرجع صنف_مجال_طبيعي_شمول(32); }
    | نوع_بدائي_مقنن.ط64 -> { أرجع صنف_مجال_طبيعي_شمول(64); }
    | نوع_بدائي_مقنن.طبيعي -> { أرجع صنف_مجال_طبيعي_شمول(64); }
    | نوع_بدائي_مقنن.حرف -> {
        دع الأدنى: ط64 = 0;
        دع الأعلى: ط64 = 1114111;
        أرجع صنف_عمود_شمول.مجالات(الأدنى, الأعلى, صنف_مجال_شمول.محارف());
    }
    | _ -> { أرجع صنف_عمود_شمول.مفتوح(); };
}

عرف صنف_عمود_شمول_لنوع(الأنواع: &سجل_أنواع, النوع: معرف_نوع): صنف_عمود_شمول {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.تعداد -> {
            طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.منشئات(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | صنف_شكل_نوع_دلالي.اختيار -> {
            طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.منشئات(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | صنف_شكل_نوع_دلالي.نتيجة -> {
            طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.منشئات(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع صنف_عمود_بدائي_شمول(البدائي);
        }
        | صنف_شكل_نوع_دلالي.سجل -> {
            طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.سجل(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | صنف_شكل_نوع_دلالي.صف -> {
            طابق عدد_عناصر_صف_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العدد) -> { أرجع صنف_عمود_شمول.صف(العدد); }
            | اختياري.لا_شيء -> { أرجع صنف_عمود_شمول.مفتوح(); };
        }
        | _ -> { أرجع صنف_عمود_شمول.مفتوح(); };
    };
}

// Rows whose first cell is an or-pattern become one row per alternative.
عرف وسع_بدائل_رأس_شمول(
    الصفوف: &متجه متجه خلية_شمول, السجل: &سجل_أنماط, مجهول: &متغير منطقي
): متجه متجه خلية_شمول {
    دع العمل: متغير متجه متجه خلية_شمول = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الصفوف) مثل طبيعي)) {
        ألحق(العمل, انسخ_صف_شمول(&(*الصفوف)[ف], 0));
        ف := ف + 1;
    }
    دع الناتج: متغير متجه متجه خلية_شمول = [];
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(العمل) مثل طبيعي)) {
        إذا ((الطول(العمل) مثل طبيعي) > 100000) { *مجهول := صواب; أرجع الناتج; };
        دع وسع: متغير منطقي = خطأ;
        طابق العمل[م][0] مع
        | خلية_شمول.نمط(المعرف, الموضع) -> {
            طابق نمط_عند(السجل, المعرف) مع
            | اختياري.موجود(نمط_دلالي.بدائل(_, البدائل)) -> {
                دع ب: متغير طبيعي = 0;
                طالما (ب < (الطول(البدائل) مثل طبيعي)) {
                    دع الجديد: متغير متجه خلية_شمول = [];
                    ألحق(الجديد, خلية_من_نمط_شمول(البدائل[ب], الموضع, السجل));
                    ألحق_ذيل_صف_شمول(&متغير الجديد, &العمل[م], 1);
                    ألحق(العمل, الجديد);
                    ب := ب + 1;
                }
                وسع := صواب;
            }
            | _ -> { };
        }
        | خلية_شمول.بدل -> { };
        إذا (!وسع) { ألحق(الناتج, انسخ_صف_شمول(&العمل[م], 0)); };
        م := م + 1;
    }
    أرجع الناتج;
}

// Position (constructor ordinal) of a constructor or boolean head cell. لا_شيء
// for a wildcard; a head this check cannot classify sets `مجهول`.
عرف ترتيب_رأس_شمول(
    الخلية: خلية_شمول, السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الأنواع: &سجل_أنواع, صنف_العمود: &صنف_عمود_شمول, مجهول: &متغير منطقي
): اختياري طبيعي {
    طابق الخلية مع
    | خلية_شمول.بدل -> { أرجع اختياري.لا_شيء(); }
    | خلية_شمول.نمط(المعرف, الموضع) -> {
        إذا (الموضع >= (الطول(*التحققات) مثل طبيعي)) { *مجهول := صواب; أرجع اختياري.لا_شيء(); };
        دع التحقق: &تحقق_نمط_نوعي = &(*التحققات)[الموضع].التحقق;
        طابق نمط_عند(السجل, المعرف) مع
        | اختياري.موجود(نمط_دلالي.منشئ(_, _, _)) -> {
            طابق نوع_عقدة_نمط_عند(التحقق, المعرف) مع
            | اختياري.موجود(نوع_العقدة) -> {
                طابق منشئ_عقدة_نمط_عند(التحقق, المعرف) مع
                | اختياري.موجود(الهوية) -> {
                    طابق ترتيب_منشئ_نوع_دلالي_بالهوية(الأنواع, نوع_عمود_مقنن_شمول(الأنواع, نوع_العقدة), الهوية) مع
                    | اختياري.موجود(الترتيب) -> { أرجع اختياري.موجود(الترتيب); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.موجود(نمط_دلالي.حرفي(_, قيمة_نمط_حرفي.منطقي(القيمة))) -> {
            طابق *صنف_العمود مع
            | صنف_عمود_شمول.منطقي -> {
                إذا (القيمة) { أرجع اختياري.موجود(1); };
                أرجع اختياري.موجود(0);
            }
            | _ -> { };
        }
        | _ -> { };
        *مجهول := صواب;
        أرجع اختياري.لا_شيء();
    };
}

// Sub-patterns of a head cell specialized to a constructor (or the single
// record/tuple shape), as `العدد` cells in declared order.
عرف أبناء_رأس_شمول(
    الخلية: خلية_شمول, العدد: طبيعي, النوع: معرف_نوع,
    السجل: &سجل_أنماط, الأنواع: &سجل_أنواع, مجهول: &متغير منطقي
): متجه خلية_شمول {
    دع الناتج: متغير متجه خلية_شمول = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الناتج, خلية_شمول.بدل()); ف := ف + 1; }
    طابق الخلية مع
    | خلية_شمول.بدل -> { أرجع الناتج; }
    | خلية_شمول.نمط(المعرف, الموضع) -> {
        طابق نمط_عند(السجل, المعرف) مع
        | اختياري.موجود(نمط_دلالي.منشئ(_, _, الحمولات)) -> {
            إذا ((الطول(الحمولات) مثل طبيعي) != العدد) { *مجهول := صواب; أرجع الناتج; };
            دع ح: متغير طبيعي = 0;
            طالما (ح < العدد) {
                الناتج[ح] := خلية_من_نمط_شمول(الحمولات[ح], الموضع, السجل);
                ح := ح + 1;
            }
        }
        | اختياري.موجود(نمط_دلالي.صف(_, العناصر)) -> {
            إذا ((الطول(العناصر) مثل طبيعي) != العدد) { *مجهول := صواب; أرجع الناتج; };
            دع ح: متغير طبيعي = 0;
            طالما (ح < العدد) {
                الناتج[ح] := خلية_من_نمط_شمول(العناصر[ح], الموضع, السجل);
                ح := ح + 1;
            }
        }
        | اختياري.موجود(نمط_دلالي.سجل(_, الحقول)) -> {
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول(الحقول) مثل طبيعي)) {
                طابق ترتيب_حقل_سجل_دلالي_بالاسم(الأنواع, النوع, الحقول[ح].الاسم) مع
                | اختياري.موجود(الترتيب) -> {
                    إذا (الترتيب < العدد) {
                        الناتج[الترتيب] := خلية_من_نمط_شمول(الحقول[ح].النمط, الموضع, السجل);
                    } وإلا { *مجهول := صواب; };
                }
                | اختياري.لا_شيء -> { *مجهول := صواب; };
                ح := ح + 1;
            }
        }
        | اختياري.موجود(نمط_دلالي.حرفي(_, _)) -> { }
        | _ -> { *مجهول := صواب; };
        أرجع الناتج;
    };
}

// The rows whose head is a wildcard, without their head (the default matrix).
عرف مصفوفة_افتراضية_شمول(الصفوف: &متجه متجه خلية_شمول): متجه متجه خلية_شمول {
    دع الناتج: متغير متجه متجه خلية_شمول = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الصفوف) مثل طبيعي)) {
        إذا (خلية_بدل_شمول((*الصفوف)[ف][0])) { ألحق(الناتج, انسخ_صف_شمول(&(*الصفوف)[ف], 1)); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ادمج_حكمي_شمول(الحكم: حكم_فائدة_شمول, مجهول: &متغير منطقي): منطقي {
    طابق الحكم مع
    | حكم_فائدة_شمول.مفيد -> { أرجع صواب; }
    | حكم_فائدة_شمول.مجهول -> { *مجهول := صواب; أرجع خطأ; }
    | حكم_فائدة_شمول.غير_مفيد -> { أرجع خطأ; };
}

// Offset value of a literal in an ordered column; `صالح` is cleared when the
// literal does not belong to the column.
عرف قيمة_مجال_شمول(القيمة: &قيمة_نمط_حرفي, الصنف: صنف_مجال_شمول, صالح: &متغير منطقي): ط64 {
    دع صفر: ط64 = 0;
    طابق *القيمة مع
    | قيمة_نمط_حرفي.عدد(ق) -> {
        طابق الصنف مع
        | صنف_مجال_شمول.موقعة -> {
            إذا (ق >= 0) { أرجع (ق مثل ط64) + إزاحة_موقع_شمول(); };
            أرجع ((ق + 9223372036854775807) + 1) مثل ط64;
        }
        | _ -> {
            إذا (ق < 0) { *صالح := خطأ; أرجع صفر; };
            أرجع ق مثل ط64;
        };
    }
    | قيمة_نمط_حرفي.عدد_طبيعي(ق) -> {
        طابق الصنف مع
        | صنف_مجال_شمول.موقعة -> {
            إذا ((ق مثل ط64) > (9223372036854775807 مثل ط64)) { *صالح := خطأ; أرجع صفر; };
            أرجع (ق مثل ط64) + إزاحة_موقع_شمول();
        }
        | _ -> { أرجع ق مثل ط64; };
    }
    | قيمة_نمط_حرفي.حرف(ق) -> {
        طابق الصنف مع
        | صنف_مجال_شمول.محارف -> { أرجع ق مثل ط64; }
        | _ -> { *صالح := خطأ; أرجع صفر; };
    }
    | _ -> { *صالح := خطأ; أرجع صفر; };
}

// The interval a head cell covers inside [الأدنى, الأعلى].
عرف مجال_رأس_شمول(
    الخلية: خلية_شمول, السجل: &سجل_أنماط, الأدنى: ط64, الأعلى: ط64,
    الصنف: صنف_مجال_شمول, مجهول: &متغير منطقي
): مجال_شمول {
    دع الكامل: مجال_شمول = { الأدنى: الأدنى, الأعلى: الأعلى, بدل: صواب, فارغ: خطأ };
    طابق الخلية مع
    | خلية_شمول.بدل -> { أرجع الكامل; }
    | خلية_شمول.نمط(المعرف, _) -> {
        دع صالح: متغير منطقي = صواب;
        دع أ: متغير ط64 = الأدنى;
        دع ب: متغير ط64 = الأعلى;
        طابق نمط_عند(السجل, المعرف) مع
        | اختياري.موجود(نمط_دلالي.حرفي(_, الحرفي)) -> {
            أ := قيمة_مجال_شمول(&الحرفي, الصنف, &متغير صالح);
            ب := أ;
        }
        | اختياري.موجود(نمط_دلالي.مدى(_, الحد_الأدنى, الحد_الأعلى)) -> {
            أ := قيمة_مجال_شمول(&الحد_الأدنى, الصنف, &متغير صالح);
            ب := قيمة_مجال_شمول(&الحد_الأعلى, الصنف, &متغير صالح);
        }
        | _ -> { صالح := خطأ; };
        إذا (!صالح) { *مجهول := صواب; أرجع الكامل; };
        إذا (أ < الأدنى) { أ := الأدنى; };
        إذا (ب > الأعلى) { ب := الأعلى; };
        دع الناتج: مجال_شمول = { الأدنى: أ, الأعلى: ب, بدل: خطأ, فارغ: أ > ب };
        أرجع الناتج;
    };
}

عرف رتب_قيم_شمول(القيم: متجه ط64): متجه ط64 {
    دع الناتج: متغير متجه ط64 = القيم;
    دع ف: متغير طبيعي = 1;
    طالما (ف < (الطول(الناتج) مثل طبيعي)) {
        دع القيمة: ط64 = الناتج[ف];
        دع م: متغير طبيعي = ف;
        طالما (م > 0 && الناتج[م - 1] > القيمة) {
            الناتج[م] := الناتج[م - 1];
            م := م - 1;
        }
        الناتج[م] := القيمة;
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Usefulness of a vector whose head is an interval [أ, ب] of an ordered column.
// The interval is split at every bound of the rows' intervals; each piece is
// either inside or outside each row's interval.
عرف فائدة_مجالات_شمول(
    الصفوف: &متجه متجه خلية_شمول, المجالات: &متجه مجال_شمول,
    أ: ط64, ب: ط64, رأس_بدل: منطقي,
    بقية_السؤال: &متجه خلية_شمول, بقية_الأعمدة: &متجه اختياري معرف_نوع,
    السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة, الأنواع: &سجل_أنواع,
    العمق: طبيعي, الخطوات: &متغير طبيعي
): حكم_فائدة_شمول {
    دع النقاط: متغير متجه ط64 = [];
    ألحق(النقاط, أ);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المجالات) مثل طبيعي)) {
        دع المجال: مجال_شمول = (*المجالات)[ف];
        إذا (!المجال.بدل && !المجال.فارغ) {
            إذا (المجال.الأدنى > أ && المجال.الأدنى <= ب) { ألحق(النقاط, المجال.الأدنى); };
            إذا (المجال.الأعلى >= أ && المجال.الأعلى < ب) { ألحق(النقاط, المجال.الأعلى + 1); };
        };
        ف := ف + 1;
    }
    *الخطوات := *الخطوات + (الطول(النقاط) مثل طبيعي);
    دع المرتبة: متجه ط64 = رتب_قيم_شمول(النقاط);
    // Whether each piece is covered by some row that is not a wildcard.
    دع البدايات: متغير متجه ط64 = [];
    دع ن: متغير طبيعي = 0;
    طالما (ن < (الطول(المرتبة) مثل طبيعي)) {
        إذا (ن == 0 || المرتبة[ن] != المرتبة[ن - 1]) { ألحق(البدايات, المرتبة[ن]); };
        ن := ن + 1;
    }
    دع عدد_القطع: طبيعي = الطول(البدايات) مثل طبيعي;
    دع المغطاة: متغير متجه منطقي = [];
    دع ق: متغير طبيعي = 0;
    دع كلها_مغطاة: متغير منطقي = صواب;
    طالما (ق < عدد_القطع) {
        دع البداية: ط64 = البدايات[ق];
        دع النهاية: متغير ط64 = ب;
        إذا (ق + 1 < عدد_القطع) { النهاية := البدايات[ق + 1] - 1; };
        دع مغطاة: متغير منطقي = خطأ;
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(*المجالات) مثل طبيعي) && !مغطاة) {
            دع المجال: مجال_شمول = (*المجالات)[ر];
            إذا (!المجال.بدل && !المجال.فارغ && المجال.الأدنى <= البداية && النهاية <= المجال.الأعلى) {
                مغطاة := صواب;
            };
            ر := ر + 1;
        }
        *الخطوات := *الخطوات + (الطول(*المجالات) مثل طبيعي);
        إذا (*الخطوات > حد_خطوات_شمول) { أرجع حكم_فائدة_شمول.مجهول(); };
        ألحق(المغطاة, مغطاة);
        إذا (!مغطاة) { كلها_مغطاة := خطأ; };
        ق := ق + 1;
    }
    // A piece no row names is matched only by the wildcard rows. For a wildcard
    // head that alone decides the answer (the default-matrix shortcut).
    دع حكم_الافتراضية: متغير اختياري حكم_فائدة_شمول = اختياري.لا_شيء();
    إذا (!كلها_مغطاة) {
        دع الافتراضية: متجه متجه خلية_شمول = مصفوفة_افتراضية_شمول(الصفوف);
        دع الحكم: حكم_فائدة_شمول = فائدة_شمول(
            &الافتراضية, بقية_السؤال, بقية_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات
        );
        إذا (رأس_بدل) { أرجع الحكم; };
        حكم_الافتراضية := اختياري.موجود(الحكم);
    };
    دع مجهول: متغير منطقي = خطأ;
    ق := 0;
    طالما (ق < عدد_القطع) {
        دع البداية: ط64 = البدايات[ق];
        دع النهاية: متغير ط64 = ب;
        إذا (ق + 1 < عدد_القطع) { النهاية := البدايات[ق + 1] - 1; };
        إذا (المغطاة[ق]) {
            دع المخصصة: متغير متجه متجه خلية_شمول = [];
            دع ر: متغير طبيعي = 0;
            طالما (ر < (الطول(*المجالات) مثل طبيعي)) {
                دع المجال: مجال_شمول = (*المجالات)[ر];
                إذا (المجال.بدل || (!المجال.فارغ && المجال.الأدنى <= البداية && النهاية <= المجال.الأعلى)) {
                    ألحق(المخصصة, انسخ_صف_شمول(&(*الصفوف)[ر], 1));
                };
                ر := ر + 1;
            }
            إذا (ادمج_حكمي_شمول(فائدة_شمول(
                &المخصصة, بقية_السؤال, بقية_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات
            ), &متغير مجهول)) { أرجع حكم_فائدة_شمول.مفيد(); };
        } وإلا {
            طابق حكم_الافتراضية مع
            | اختياري.موجود(الحكم) -> {
                إذا (ادمج_حكمي_شمول(الحكم, &متغير مجهول)) { أرجع حكم_فائدة_شمول.مفيد(); };
            }
            | اختياري.لا_شيء -> { };
        };
        ق := ق + 1;
    }
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    أرجع حكم_فائدة_شمول.غير_مفيد();
}

عرف حرفيان_متساويان_شمول(أ: &قيمة_نمط_حرفي, ب: &قيمة_نمط_حرفي): منطقي {
    طابق *أ مع
    | قيمة_نمط_حرفي.نص(النص_أ) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.نص(النص_ب) -> {
            إذا (الطول(النص_أ) != الطول(النص_ب)) { أرجع خطأ; };
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(النص_أ) مثل طبيعي)) {
                إذا (النص_أ[ف] != النص_ب[ف]) { أرجع خطأ; };
                ف := ف + 1;
            }
            أرجع صواب;
        }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.عدد(س) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.عدد(ص) -> { أرجع س == ص; }
        | قيمة_نمط_حرفي.عدد_طبيعي(ص) -> { أرجع س >= 0 && (س مثل طبيعي) == ص; }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.عدد_طبيعي(س) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.عدد_طبيعي(ص) -> { أرجع س == ص; }
        | قيمة_نمط_حرفي.عدد(ص) -> { أرجع ص >= 0 && (ص مثل طبيعي) == س; }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.حرف(س) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.حرف(ص) -> { أرجع س == ص; }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_نمط_حرفي.منطقي(س) -> {
        طابق *ب مع
        | قيمة_نمط_حرفي.منطقي(ص) -> { أرجع س == ص; }
        | _ -> { أرجع خطأ; };
    };
}

// A column whose values are not enumerated (text, ...): only equal literals and
// wildcards match a literal, and a wildcard head is decided by the wildcard rows.
عرف فائدة_مفتوحة_شمول(
    الصفوف: &متجه متجه خلية_شمول, السؤال: &متجه خلية_شمول,
    بقية_الأعمدة: &متجه اختياري معرف_نوع,
    السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة, الأنواع: &سجل_أنواع,
    العمق: طبيعي, الخطوات: &متغير طبيعي
): حكم_فائدة_شمول {
    دع بقية_السؤال: متجه خلية_شمول = انسخ_صف_شمول(السؤال, 1);
    طابق (*السؤال)[0] مع
    | خلية_شمول.بدل -> {
        دع الافتراضية: متجه متجه خلية_شمول = مصفوفة_افتراضية_شمول(الصفوف);
        أرجع فائدة_شمول(&الافتراضية, &بقية_السؤال, بقية_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
    }
    | خلية_شمول.نمط(معرف_السؤال, _) -> {
        طابق نمط_عند(السجل, معرف_السؤال) مع
        | اختياري.موجود(نمط_دلالي.حرفي(_, حرفي_السؤال)) -> {
            دع المخصصة: متغير متجه متجه خلية_شمول = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(*الصفوف) مثل طبيعي)) {
                طابق (*الصفوف)[ف][0] مع
                | خلية_شمول.بدل -> { ألحق(المخصصة, انسخ_صف_شمول(&(*الصفوف)[ف], 1)); }
                | خلية_شمول.نمط(المعرف, _) -> {
                    طابق نمط_عند(السجل, المعرف) مع
                    | اختياري.موجود(نمط_دلالي.حرفي(_, الحرفي)) -> {
                        إذا (حرفيان_متساويان_شمول(&الحرفي, &حرفي_السؤال)) {
                            ألحق(المخصصة, انسخ_صف_شمول(&(*الصفوف)[ف], 1));
                        };
                    }
                    | _ -> { أرجع حكم_فائدة_شمول.مجهول(); };
                };
                ف := ف + 1;
            }
            أرجع فائدة_شمول(&المخصصة, &بقية_السؤال, بقية_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
        }
        | _ -> { أرجع حكم_فائدة_شمول.مجهول(); };
    };
}

// Usefulness of the vector specialized to constructor `م` (ordinal) of a
// closed column.
عرف فائدة_منشئ_شمول(
    الصفوف: &متجه متجه خلية_شمول, الترتيبات: &متجه طبيعي, عدد_المنشئات: طبيعي,
    م: طبيعي, السؤال: &متجه خلية_شمول, الصنف: &صنف_عمود_شمول, نوع_الرأس: معرف_نوع,
    بقية_الأعمدة: &متجه اختياري معرف_نوع,
    السجل: &سجل_أنماط, التحققات: &متجه ربط_تحقق_نمط_وحدة, الأنواع: &سجل_أنواع,
    العمق: طبيعي, الخطوات: &متغير طبيعي
): حكم_فائدة_شمول {
    دع عدد_الحمولات: متغير طبيعي = 0;
    دع أنواع_المنشئ: متغير متجه اختياري معرف_نوع = [];
    طابق *الصنف مع
    | صنف_عمود_شمول.منشئات(_) -> {
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, نوع_الرأس, م) مع
        | اختياري.موجود(العدد) -> { عدد_الحمولات := العدد; }
        | اختياري.لا_شيء -> { أرجع حكم_فائدة_شمول.مجهول(); };
        دع ح: متغير طبيعي = 0;
        طالما (ح < عدد_الحمولات) {
            ألحق(أنواع_المنشئ, نوع_حمولة_منشئ_دلالي_عند(الأنواع, نوع_الرأس, م, ح));
            ح := ح + 1;
        }
    }
    | _ -> { };
    ألحق_أنواع_شمول(&متغير أنواع_المنشئ, بقية_الأعمدة);
    دع مجهول: متغير منطقي = خطأ;
    دع المخصصة: متغير متجه متجه خلية_شمول = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الصفوف) مثل طبيعي)) {
        دع ترتيب_الصف: طبيعي = (*الترتيبات)[ف];
        إذا (ترتيب_الصف == م || ترتيب_الصف == عدد_المنشئات) {
            دع الصف: متغير متجه خلية_شمول = أبناء_رأس_شمول(
                (*الصفوف)[ف][0], عدد_الحمولات, نوع_الرأس, السجل, الأنواع, &متغير مجهول
            );
            ألحق_ذيل_صف_شمول(&متغير الصف, &(*الصفوف)[ف], 1);
            ألحق(المخصصة, الصف);
        };
        ف := ف + 1;
    }
    دع السؤال_المخصص: متغير متجه خلية_شمول = أبناء_رأس_شمول(
        (*السؤال)[0], عدد_الحمولات, نوع_الرأس, السجل, الأنواع, &متغير مجهول
    );
    ألحق_ذيل_صف_شمول(&متغير السؤال_المخصص, السؤال, 1);
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    أرجع فائدة_شمول(&المخصصة, &السؤال_المخصص, &أنواع_المنشئ, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
}

عرف ألحق_أنواع_شمول(الوجهة: &متغير متجه اختياري معرف_نوع, المصدر: &متجه اختياري معرف_نوع): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(*الوجهة, (*المصدر)[ف]);
        ف := ف + 1;
    }
}

// Whether some value matches `السؤال` and no row of `الصفوف_الخام`.
عرف فائدة_شمول(
    الصفوف_الخام: &متجه متجه خلية_شمول,
    السؤال: &متجه خلية_شمول,
    الأنواع_الأعمدة: &متجه اختياري معرف_نوع,
    السجل: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الأنواع: &سجل_أنواع,
    العمق: طبيعي,
    الخطوات: &متغير طبيعي
): حكم_فائدة_شمول {
    إذا ((الطول(*الصفوف_الخام) مثل طبيعي) == 0) { أرجع حكم_فائدة_شمول.مفيد(); };
    إذا ((الطول(*السؤال) مثل طبيعي) == 0) { أرجع حكم_فائدة_شمول.غير_مفيد(); };
    *الخطوات := *الخطوات + (الطول(*الصفوف_الخام) مثل طبيعي) + 1;
    إذا (*الخطوات > حد_خطوات_شمول || العمق > 2000) { أرجع حكم_فائدة_شمول.مجهول(); };
    إذا ((الطول(*الأنواع_الأعمدة) مثل طبيعي) != (الطول(*السؤال) مثل طبيعي)) {
        أرجع حكم_فائدة_شمول.مجهول();
    };
    // A row of wildcards (a catch-all arm) covers every value.
    دع خ: متغير طبيعي = 0;
    طالما (خ < (الطول(*الصفوف_الخام) مثل طبيعي)) {
        إذا (صف_بدل_شمول(&(*الصفوف_الخام)[خ])) { أرجع حكم_فائدة_شمول.غير_مفيد(); };
        خ := خ + 1;
    }
    دع بقية_الأنواع: متجه اختياري معرف_نوع = انسخ_أنواع_شمول(الأنواع_الأعمدة, 1);
    دع بقية_السؤال: متجه خلية_شمول = انسخ_صف_شمول(السؤال, 1);
    // An or-pattern at the head of the vector is useful when one alternative is.
    دع مجهول: متغير منطقي = خطأ;
    طابق (*السؤال)[0] مع
    | خلية_شمول.نمط(المعرف, الموضع) -> {
        طابق نمط_عند(السجل, المعرف) مع
        | اختياري.موجود(نمط_دلالي.بدائل(_, البدائل)) -> {
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(البدائل) مثل طبيعي)) {
                دع البديل: متغير متجه خلية_شمول = [];
                ألحق(البديل, خلية_من_نمط_شمول(البدائل[ب], الموضع, السجل));
                ألحق_ذيل_صف_شمول(&متغير البديل, السؤال, 1);
                إذا (ادمج_حكمي_شمول(فائدة_شمول(
                    الصفوف_الخام, &البديل, الأنواع_الأعمدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات
                ), &متغير مجهول)) { أرجع حكم_فائدة_شمول.مفيد(); };
                ب := ب + 1;
            }
            إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
            أرجع حكم_فائدة_شمول.غير_مفيد();
        }
        | _ -> { };
    }
    | خلية_شمول.بدل -> { };
    دع الصفوف: متجه متجه خلية_شمول = وسع_بدائل_رأس_شمول(الصفوف_الخام, السجل, &متغير مجهول);
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    // A column of wildcards only needs no Type: drop it.
    دع رأس_السؤال_بدل: منطقي = خلية_بدل_شمول((*السؤال)[0]);
    إذا (رأس_السؤال_بدل) {
        دع كلها_بدل: متغير منطقي = صواب;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الصفوف) مثل طبيعي) && كلها_بدل) {
            إذا (!خلية_بدل_شمول(الصفوف[ف][0])) { كلها_بدل := خطأ; };
            ف := ف + 1;
        }
        إذا (كلها_بدل) {
            دع الافتراضية: متجه متجه خلية_شمول = مصفوفة_افتراضية_شمول(&الصفوف);
            أرجع فائدة_شمول(&الافتراضية, &بقية_السؤال, &بقية_الأنواع, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
        };
    };
    دع نوع_الرأس: معرف_نوع;
    طابق (*الأنواع_الأعمدة)[0] مع
    | اختياري.موجود(النوع) -> { نوع_الرأس := نوع_عمود_مقنن_شمول(الأنواع, النوع); }
    | اختياري.لا_شيء -> { أرجع حكم_فائدة_شمول.مجهول(); };
    دع الصنف: صنف_عمود_شمول = صنف_عمود_شمول_لنوع(الأنواع, نوع_الرأس);

    دع عدد_المنشئات: متغير طبيعي = 0;
    دع حجم_واحد: متغير طبيعي = 0;
    دع واحد: متغير منطقي = خطأ;
    طابق الصنف مع
    | صنف_عمود_شمول.منشئات(العدد) -> { عدد_المنشئات := العدد; }
    | صنف_عمود_شمول.منطقي -> { عدد_المنشئات := 2; }
    | صنف_عمود_شمول.سجل(العدد) -> { واحد := صواب; حجم_واحد := العدد; }
    | صنف_عمود_شمول.صف(العدد) -> { واحد := صواب; حجم_واحد := العدد; }
    | صنف_عمود_شمول.مجالات(الأدنى, الأعلى, صنف_المجال) -> {
        دع المجالات: متغير متجه مجال_شمول = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الصفوف) مثل طبيعي)) {
            ألحق(المجالات, مجال_رأس_شمول(الصفوف[ف][0], السجل, الأدنى, الأعلى, صنف_المجال, &متغير مجهول));
            ف := ف + 1;
        }
        دع مجال_السؤال: مجال_شمول = مجال_رأس_شمول(
            (*السؤال)[0], السجل, الأدنى, الأعلى, صنف_المجال, &متغير مجهول
        );
        إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
        // A literal outside the column's values matches nothing.
        إذا (مجال_السؤال.فارغ) { أرجع حكم_فائدة_شمول.غير_مفيد(); };
        أرجع فائدة_مجالات_شمول(
            &الصفوف, &المجالات, مجال_السؤال.الأدنى, مجال_السؤال.الأعلى, مجال_السؤال.بدل,
            &بقية_السؤال, &بقية_الأنواع, السجل, التحققات, الأنواع, العمق, الخطوات
        );
    }
    | صنف_عمود_شمول.مفتوح -> {
        أرجع فائدة_مفتوحة_شمول(
            &الصفوف, السؤال, &بقية_الأنواع, السجل, التحققات, الأنواع, العمق, الخطوات
        );
    };

    // A record or tuple has exactly one shape: expand it in place.
    إذا (واحد) {
        دع المصفوفة: متغير متجه متجه خلية_شمول = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الصفوف) مثل طبيعي)) {
            دع الصف: متغير متجه خلية_شمول = أبناء_رأس_شمول(
                الصفوف[ف][0], حجم_واحد, نوع_الرأس, السجل, الأنواع, &متغير مجهول
            );
            ألحق_ذيل_صف_شمول(&متغير الصف, &الصفوف[ف], 1);
            ألحق(المصفوفة, الصف);
            ف := ف + 1;
        }
        دع السؤال_الموسع: متغير متجه خلية_شمول = أبناء_رأس_شمول(
            (*السؤال)[0], حجم_واحد, نوع_الرأس, السجل, الأنواع, &متغير مجهول
        );
        ألحق_ذيل_صف_شمول(&متغير السؤال_الموسع, السؤال, 1);
        إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
        دع الأنواع_الجديدة: متغير متجه اختياري معرف_نوع = [];
        دع ع: متغير طبيعي = 0;
        طالما (ع < حجم_واحد) {
            طابق الصنف مع
            | صنف_عمود_شمول.سجل(_) -> {
                ألحق(الأنواع_الجديدة, نوع_حقل_سجل_دلالي_عند(الأنواع, نوع_الرأس, ع));
            }
            | _ -> {
                ألحق(الأنواع_الجديدة, نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الرأس, ع));
            };
            ع := ع + 1;
        }
        ألحق_أنواع_شمول(&متغير الأنواع_الجديدة, &بقية_الأنواع);
        أرجع فائدة_شمول(&المصفوفة, &السؤال_الموسع, &الأنواع_الجديدة, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
    };

    // A closed set of constructors. Each row's head constructor is found once
    // (a wildcard head is marked with عدد_المنشئات).
    دع الترتيبات: متغير متجه طبيعي = [];
    دع الموجودة: متغير متجه منطقي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المنشئات) { ألحق(الموجودة, خطأ); م := م + 1; }
    دع عدد_الموجودة: متغير طبيعي = 0;
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الصفوف) مثل طبيعي)) {
        طابق ترتيب_رأس_شمول(الصفوف[ر][0], السجل, التحققات, الأنواع, &الصنف, &متغير مجهول) مع
        | اختياري.موجود(الترتيب) -> {
            إذا (الترتيب >= عدد_المنشئات) { أرجع حكم_فائدة_شمول.مجهول(); };
            ألحق(الترتيبات, الترتيب);
            إذا (!الموجودة[الترتيب]) { الموجودة[الترتيب] := صواب; عدد_الموجودة := عدد_الموجودة + 1; };
        }
        | اختياري.لا_شيء -> { ألحق(الترتيبات, عدد_المنشئات); };
        ر := ر + 1;
    }
    دع ترتيب_السؤال: اختياري طبيعي = ترتيب_رأس_شمول(
        (*السؤال)[0], السجل, التحققات, الأنواع, &الصنف, &متغير مجهول
    );
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    طابق ترتيب_السؤال مع
    | اختياري.موجود(الترتيب) -> {
        إذا (الترتيب >= عدد_المنشئات) { أرجع حكم_فائدة_شمول.مجهول(); };
        أرجع فائدة_منشئ_شمول(
            &الصفوف, &الترتيبات, عدد_المنشئات, الترتيب, السؤال, &الصنف, نوع_الرأس,
            &بقية_الأنواع, السجل, التحققات, الأنواع, العمق, الخطوات
        );
    }
    | اختياري.لا_شيء -> { };
    // A wildcard head: when some constructor is named by no row, only the
    // wildcard rows can cover it (the default-matrix shortcut).
    إذا (عدد_الموجودة < عدد_المنشئات) {
        دع الافتراضية: متجه متجه خلية_شمول = مصفوفة_افتراضية_شمول(&الصفوف);
        أرجع فائدة_شمول(&الافتراضية, &بقية_السؤال, &بقية_الأنواع, السجل, التحققات, الأنواع, العمق + 1, الخطوات);
    };
    م := 0;
    طالما (م < عدد_المنشئات) {
        إذا (ادمج_حكمي_شمول(فائدة_منشئ_شمول(
            &الصفوف, &الترتيبات, عدد_المنشئات, م, السؤال, &الصنف, نوع_الرأس,
            &بقية_الأنواع, السجل, التحققات, الأنواع, العمق, الخطوات
        ), &متغير مجهول)) { أرجع حكم_فائدة_شمول.مفيد(); };
        م := م + 1;
    }
    إذا (مجهول) { أرجع حكم_فائدة_شمول.مجهول(); };
    أرجع حكم_فائدة_شمول.غير_مفيد();
}

// Exhaustiveness and unreachable arms of one match (root pattern and position
// of its type check, per arm).
عام عرف حلل_أذرع_مطابقة(
    الجذور: &متجه معرف_نمط,
    مواضع_التحققات: &متجه طبيعي,
    السجل: &سجل_أنماط,
    التحققات: &متجه ربط_تحقق_نمط_وحدة,
    الأنواع: &سجل_أنواع
): تحليل_أذرع_مطابقة {
    دع غير_القابلة: متغير متجه طبيعي = [];
    دع عدد_الأذرع: طبيعي = الطول(*الجذور) مثل طبيعي;
    إذا (عدد_الأذرع == 0) {
        دع الفارغ: تحليل_أذرع_مطابقة = { الشمول: حكم_شمول_مطابقة.شاملة(), غير_القابلة_للوصول: غير_القابلة };
        أرجع الفارغ;
    };
    دع الموضع_الأول: طبيعي = (*مواضع_التحققات)[0];
    دع نوع_المميز: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    إذا (الموضع_الأول < (الطول(*التحققات) مثل طبيعي)) {
        نوع_المميز := نوع_عقدة_نمط_عند(&(*التحققات)[الموضع_الأول].التحقق, (*الجذور)[0]);
    };
    دع الأعمدة: متغير متجه اختياري معرف_نوع = [];
    ألحق(الأعمدة, نوع_المميز);

    // Head constructor of each arm when the scrutinee has a closed set of
    // constructors: the common long match over an enumeration is then decided
    // per arm by counting, without building a matrix.
    دع الصنف: متغير صنف_عمود_شمول = صنف_عمود_شمول.مفتوح();
    دع عدد_المنشئات: متغير طبيعي = 0;
    طابق نوع_المميز مع
    | اختياري.موجود(النوع) -> {
        الصنف := صنف_عمود_شمول_لنوع(الأنواع, نوع_عمود_مقنن_شمول(الأنواع, النوع));
        طابق الصنف مع
        | صنف_عمود_شمول.منشئات(العدد) -> { عدد_المنشئات := العدد; }
        | صنف_عمود_شمول.منطقي -> { عدد_المنشئات := 2; }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    دع الخلايا: متغير متجه خلية_شمول = [];
    // Per arm: ordinal, عدد_المنشئات for a wildcard, عدد_المنشئات + 1 otherwise.
    دع الترتيبات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأذرع) {
        دع الخلية: خلية_شمول = خلية_من_نمط_شمول((*الجذور)[ف], (*مواضع_التحققات)[ف], السجل);
        ألحق(الخلايا, الخلية);
        دع الترتيب: متغير طبيعي = عدد_المنشئات + 1;
        إذا (خلية_بدل_شمول(الخلية)) {
            الترتيب := عدد_المنشئات;
        } وإلا إذا (عدد_المنشئات > 0) {
            دع مجهول_الرأس: متغير منطقي = خطأ;
            طابق ترتيب_رأس_شمول(الخلية, السجل, التحققات, الأنواع, &الصنف, &متغير مجهول_الرأس) مع
            | اختياري.موجود(ت) -> { إذا (!مجهول_الرأس && ت < عدد_المنشئات) { الترتيب := ت; }; }
            | اختياري.لا_شيء -> { };
        };
        ألحق(الترتيبات, الترتيب);
        ف := ف + 1;
    }

    دع لكل_منشئ: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المنشئات) { ألحق(لكل_منشئ, 0); م := م + 1; }
    دع يوجد_بدل: متغير منطقي = خطأ;
    دع عدد_المركبة: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < عدد_الأذرع) {
        دع الترتيب: طبيعي = الترتيبات[ف];
        إذا (ف > 0) {
            // The first arm naming a constructor is reachable.
            دع أول_منشئ: منطقي = الترتيب < عدد_المنشئات && عدد_المركبة == 0 && لكل_منشئ[الترتيب] == 0;
            إذا (يوجد_بدل) {
                ألحق(غير_القابلة, ف);
            } وإلا إذا (!أول_منشئ) {
                دع السابقة: متغير متجه متجه خلية_شمول = [];
                دع س: متغير طبيعي = 0;
                طالما (س < ف) {
                    إذا (الترتيب >= عدد_المنشئات || عدد_المركبة > 0 || الترتيبات[س] == الترتيب) {
                        دع الصف: متغير متجه خلية_شمول = [];
                        ألحق(الصف, الخلايا[س]);
                        ألحق(السابقة, الصف);
                    };
                    س := س + 1;
                }
                دع السؤال: متغير متجه خلية_شمول = [];
                ألحق(السؤال, الخلايا[ف]);
                دع الخطوات: متغير طبيعي = 0;
                طابق فائدة_شمول(&السابقة, &السؤال, &الأعمدة, السجل, التحققات, الأنواع, 0, &متغير الخطوات) مع
                | حكم_فائدة_شمول.غير_مفيد -> { ألحق(غير_القابلة, ف); }
                | _ -> { };
            };
        };
        إذا (الترتيب == عدد_المنشئات) {
            يوجد_بدل := صواب;
        } وإلا إذا (الترتيب < عدد_المنشئات) {
            لكل_منشئ[الترتيب] := لكل_منشئ[الترتيب] + 1;
        } وإلا {
            عدد_المركبة := عدد_المركبة + 1;
        };
        ف := ف + 1;
    }

    دع الشمول: متغير حكم_شمول_مطابقة = حكم_شمول_مطابقة.شاملة();
    إذا (!يوجد_بدل) {
        دع الصفوف: متغير متجه متجه خلية_شمول = [];
        ف := 0;
        طالما (ف < عدد_الأذرع) {
            دع الصف: متغير متجه خلية_شمول = [];
            ألحق(الصف, الخلايا[ف]);
            ألحق(الصفوف, الصف);
            ف := ف + 1;
        }
        دع السؤال: متغير متجه خلية_شمول = [];
        ألحق(السؤال, خلية_شمول.بدل());
        دع الخطوات: متغير طبيعي = 0;
        طابق فائدة_شمول(&الصفوف, &السؤال, &الأعمدة, السجل, التحققات, الأنواع, 0, &متغير الخطوات) مع
        | حكم_فائدة_شمول.مفيد -> { الشمول := حكم_شمول_مطابقة.غير_شاملة(); }
        | حكم_فائدة_شمول.مجهول -> { الشمول := حكم_شمول_مطابقة.غير_مثبتة(); }
        | حكم_فائدة_شمول.غير_مفيد -> { };
    };
    دع الناتج: تحليل_أذرع_مطابقة = { الشمول: الشمول, غير_القابلة_للوصول: غير_القابلة };
    أرجع الناتج;
}
