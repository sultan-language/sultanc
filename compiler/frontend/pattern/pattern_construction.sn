استورد std.text.from_bytes;
استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.pattern_registry;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.patterns;
استورد compiler.frontend.ast.literals;
استورد compiler.frontend.ast.statements;
استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.resolved_bindings;

عرف نطاق_صالح_للبناء(المصدر: &مصدر, النطاق: نطاق): اختياري خطأ_بناء_نمط {
    إذا (((النطاق.البداية.المصدر مثل طبيعي) != (*المصدر).المعرف) || ((النطاق.النهاية.المصدر مثل طبيعي) != (*المصدر).المعرف)) {
        أرجع اختياري.موجود(خطأ_بناء_نمط.مصدر_غير_متطابق(النطاق));
    };
    إذا ((النطاق.النهاية.البايت < النطاق.البداية.البايت) ||
        ((النطاق.النهاية.البايت مثل طبيعي) > (*المصدر).الطول)) {
        أرجع اختياري.موجود(خطأ_بناء_نمط.نطاق_خارج_المصدر(النطاق));
    };
    أرجع اختياري.لا_شيء();
}

عرف هوية_اسم_نمط(
    الروابط: &سياق_روابط_أسماء,
    المصدر: &مصدر,
    الاسم: اسم
): نتيجة معرف_اسم, خطأ_بناء_نمط {
    دع الخطأ: اختياري خطأ_بناء_نمط = نطاق_صالح_للبناء(المصدر, الاسم.النطاق);
    طابق الخطأ مع
    | اختياري.موجود(القيمة) -> {
        أرجع نتيجة.خطأ(القيمة);
    }
    | اختياري.لا_شيء -> {
    };
    طابق معرف_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
    | اختياري.موجود(المعرف) -> {
        أرجع نتيجة.نجح(المعرف);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بناء_نمط.هوية_اسم_مفقودة(الاسم.النطاق));
    };
}


عرف قنن_قيمة_نمط_حرفي(الحرفي: &حرفي): اختياري قيمة_نمط_حرفي {
    دع القيمة: حرفي = *الحرفي;
    طابق القيمة مع
    | حرفي.منطقي(الحقيقة) -> { أرجع اختياري.موجود(قيمة_نمط_حرفي.منطقي(الحقيقة)); }
    | حرفي.عدد(العدد) -> { أرجع اختياري.موجود(قيمة_نمط_حرفي.عدد(العدد)); }
    | حرفي.عدد_طبيعي(العدد) -> { أرجع اختياري.موجود(قيمة_نمط_حرفي.عدد_طبيعي(العدد)); }
    | حرفي.حرف(المحرف) -> { أرجع اختياري.موجود(قيمة_نمط_حرفي.حرف(المحرف)); }
    | حرفي.نص(البايتات) -> { أرجع اختياري.موجود(قيمة_نمط_حرفي.نص(انسخ_بايتات(&البايتات))); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف ابن_نمط_دلالي(
    السجل: &متغير سجل_أنماط,
    الروابط: &سياق_روابط_أسماء,
    المصدر: &مصدر,
    النمط: &نمط
): نتيجة_بناء_نمط {
    دع القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.بدل(النطاق) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        دع المعرف: معرف_نمط = سجل_نمطا(السجل, نمط_دلالي.بدل(النطاق));
        أرجع نتيجة_بناء_نمط.مبني(المعرف);
    }
    | نمط.حرفي(النطاق, الحرفي) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        طابق قنن_قيمة_نمط_حرفي(&الحرفي) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_بناء_نمط.مرفوض(خطأ_بناء_نمط.حرفي_غير_مدعوم(النطاق));
        }
        | اختياري.موجود(القيمة_الحرفية) -> {
            دع المعرف: معرف_نمط = سجل_نمطا(
                السجل, نمط_دلالي.حرفي(النطاق, القيمة_الحرفية)
            );
            أرجع نتيجة_بناء_نمط.مبني(المعرف);
        };
    }
    | نمط.مدى(النطاق, الأدنى, الأعلى) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_نمط.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        دع حد_أدنى: قيمة_نمط_حرفي;
        دع حد_أعلى: قيمة_نمط_حرفي;
        طابق قنن_قيمة_نمط_حرفي(&الأدنى) مع
        | اختياري.موجود(القيمة) -> { حد_أدنى := القيمة; }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_بناء_نمط.مرفوض(خطأ_بناء_نمط.حرفي_غير_مدعوم(النطاق));
        };
        طابق قنن_قيمة_نمط_حرفي(&الأعلى) مع
        | اختياري.موجود(القيمة) -> { حد_أعلى := القيمة; }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_بناء_نمط.مرفوض(خطأ_بناء_نمط.حرفي_غير_مدعوم(النطاق));
        };
        دع المعرف: معرف_نمط = سجل_نمطا(
            السجل, نمط_دلالي.مدى(النطاق, حد_أدنى, حد_أعلى)
        );
        أرجع نتيجة_بناء_نمط.مبني(المعرف);
    }
    | نمط.بدائل(النطاق, البدائل) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_نمط.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        دع الأبناء: متغير متجه معرف_نمط = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البدائل) مثل طبيعي)) {
            طابق ابن_نمط_دلالي(السجل, الروابط, المصدر, &البدائل[ف]) مع
            | نتيجة_بناء_نمط.مبني(المعرف) -> { ألحق(الأبناء, المعرف); }
            | نتيجة_بناء_نمط.مرفوض(الخطأ) -> { أرجع نتيجة_بناء_نمط.مرفوض(الخطأ); };
            ف := ف + 1;
        }
        دع المعرف: معرف_نمط = سجل_نمطا(السجل, نمط_دلالي.بدائل(النطاق, الأبناء));
        أرجع نتيجة_بناء_نمط.مبني(المعرف);
    }
    | نمط.ربط(النطاق, الاسم) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        دع اسم_مقنن: نتيجة معرف_اسم, خطأ_بناء_نمط = هوية_اسم_نمط(الروابط, المصدر, الاسم);
        طابق اسم_مقنن مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | نتيجة.نجح(هوية) -> {
            دع المعرف: معرف_نمط = سجل_نمطا(السجل, نمط_دلالي.ربط(النطاق, هوية));
            أرجع نتيجة_بناء_نمط.مبني(المعرف);
        };
    }
    | نمط.صف(النطاق, العناصر) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        دع الأبناء: متغير متجه معرف_نمط = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            دع الابن: نتيجة_بناء_نمط = ابن_نمط_دلالي(السجل, الروابط, المصدر, &العناصر[ف]);
            طابق الابن مع
            | نتيجة_بناء_نمط.مرفوض(الخطأ) -> {
                أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
            }
            | نتيجة_بناء_نمط.مبني(المعرف) -> {
                ألحق(الأبناء, المعرف);
            };
            ف := ف + 1;
        }
        دع المعرف: معرف_نمط = سجل_نمطا(السجل, نمط_دلالي.صف(النطاق, الأبناء));
        أرجع نتيجة_بناء_نمط.مبني(المعرف);
    }
    | نمط.سجل(النطاق, الحقول) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        دع الدلالية: متغير متجه حقل_نمط_دلالي = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            دع مرجع_الحقل: &حقل_نمط = &الحقول[ف];
            دع الحقل: حقل_نمط = *مرجع_الحقل;
            دع اسم_مقنن: نتيجة معرف_اسم, خطأ_بناء_نمط = هوية_اسم_نمط(
                الروابط, المصدر, الحقل.الاسم
            );
            طابق اسم_مقنن مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
            }
            | نتيجة.نجح(هوية) -> {
                دع الابن: نتيجة_بناء_نمط = ابن_نمط_دلالي(
                    السجل, الروابط, المصدر, &الحقل.النمط
                );
                طابق الابن مع
                | نتيجة_بناء_نمط.مرفوض(الخطأ) -> {
                    أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
                }
                | نتيجة_بناء_نمط.مبني(معرف_الابن) -> {
                    دع نطاق_الابن: اختياري نطاق = نطاق_نمط_عند(السجل, معرف_الابن);
                    طابق نطاق_الابن مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_بناء_نمط.مرفوض(
                            خطأ_بناء_نمط.تابع_غير_صالح(معرف_الابن)
                        );
                    }
                    | اختياري.موجود(نطاق_القيمة) -> {
                        دع نطاق_الحقل: نطاق = دمج_نطاق(الحقل.الاسم.النطاق, نطاق_القيمة);
                        دع سجل_الحقل: حقل_نمط_دلالي = {
                            الاسم: هوية,
                            نطاق_الاسم: الحقل.الاسم.النطاق,
                            النمط: معرف_الابن,
                            النطاق: نطاق_الحقل
                        };
                        ألحق(الدلالية, سجل_الحقل);
                    };
                };
            };
            ف := ف + 1;
        }
        دع المعرف: معرف_نمط = سجل_نمطا(السجل, نمط_دلالي.سجل(النطاق, الدلالية));
        أرجع نتيجة_بناء_نمط.مبني(المعرف);
    }
    | نمط.منشئ(النطاق, النوع, المنشئ, الحمولات) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        دع هوية_النوع: نتيجة معرف_اسم, خطأ_بناء_نمط = هوية_اسم_نمط(
            الروابط, المصدر, النوع
        );
        دع هوية_المنشئ: نتيجة معرف_اسم, خطأ_بناء_نمط = هوية_اسم_نمط(
            الروابط, المصدر, المنشئ
        );
        طابق هوية_النوع مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | نتيجة.نجح(النوع_المقنن) -> {
            طابق هوية_المنشئ مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
            }
            | نتيجة.نجح(المنشئ_المقنن) -> {
                دع الأبناء: متغير متجه معرف_نمط = [];
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الحمولات) مثل طبيعي)) {
                    دع الابن: نتيجة_بناء_نمط = ابن_نمط_دلالي(
                        السجل, الروابط, المصدر, &الحمولات[ف]
                    );
                    طابق الابن مع
                    | نتيجة_بناء_نمط.مرفوض(الخطأ) -> {
                        أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
                    }
                    | نتيجة_بناء_نمط.مبني(المعرف) -> {
                        ألحق(الأبناء, المعرف);
                    };
                    ف := ف + 1;
                }
                دع المرجع: مرجع_منشئ_نمط = {
                    النوع: النوع_المقنن,
                    نطاق_النوع: النوع.النطاق,
                    المنشئ: المنشئ_المقنن,
                    نطاق_المنشئ: المنشئ.النطاق
                };
                دع المعرف: معرف_نمط = سجل_نمطا(
                    السجل, نمط_دلالي.منشئ(النطاق, المرجع, الأبناء)
                );
                أرجع نتيجة_بناء_نمط.مبني(المعرف);
            };
        };
    };
}

// نقطة البناء الوحيدة من AST إلى Pattern الدلالي. لا يجري هنا أي تحقق aggregate من Type.
عام عرف ابن_نمطا(
    السجل: &متغير سجل_أنماط,
    الروابط: &سياق_روابط_أسماء,
    المصدر: &مصدر,
    النمط: &نمط
): نتيجة_بناء_نمط {
    أرجع ابن_نمط_دلالي(السجل, الروابط, المصدر, النمط);
}

// يستخرج فقط هوية نطاق نمط AST عند حد البناء/الربط؛ لا يجري أي تحليل Pattern هنا.
عرف نطاق_نمط_تركيبي(النمط: &نمط): نطاق {
    أرجع نطاق_نمط(النمط);
}

// الربط المقنن من نمط AST الموجود إلى معرف Pattern الدلالي الذي سبق بناؤه.
// هذه دالة lookup فقط: لا تعيد البناء ولا التحليل ولا التحقق النوعي.
عام عرف معرف_نمط_تركيبي_عند(السجل: &سجل_أنماط, النمط: &نمط): اختياري معرف_نمط {
    أرجع معرف_نمط_عند_نطاق(السجل, نطاق_نمط_تركيبي(النمط));
}

// العقد الضيق الذي يحتاجه خفض match: كل ذراع يعطي مباشرة معرف Pattern الجذر المقنن.
عام عرف معرف_نمط_ذراع_مطابقة_عند(السجل: &سجل_أنماط, الذراع: &ذراع_مطابقة): اختياري معرف_نمط {
    دع القيمة: ذراع_مطابقة = *الذراع;
    أرجع معرف_نمط_تركيبي_عند(السجل, &القيمة.النمط);
}
