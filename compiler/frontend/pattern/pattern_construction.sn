استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.pattern_registry;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.patterns;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.source.source;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.resolved_bindings;

عرف نطاق_صالح_للبناء(المصدر: &مصدر, النطاق: نطاق): اختيار خطأ_بناء_نمط {
    دع الأصل: مصدر = *المصدر;
    لو ((النطاق.البداية.المصدر != الأصل.المعرف) || (النطاق.النهاية.المصدر != الأصل.المعرف)) {
        أرجع اختيار.بعض(خطأ_بناء_نمط.مصدر_غير_متطابق(النطاق));
    };
    لو ((النطاق.النهاية.البايت < النطاق.البداية.البايت) ||
        (النطاق.النهاية.البايت > الأصل.الطول)) {
        أرجع اختيار.بعض(خطأ_بناء_نمط.نطاق_خارج_المصدر(النطاق));
    };
    أرجع اختيار.لا_شيء();
}

عرف هوية_اسم_نمط(
    الروابط: &سياق_روابط_أسماء,
    المصدر: &مصدر,
    الاسم: اسم
): نتيجة معرف_اسم, خطأ_بناء_نمط {
    دع الخطأ: اختيار خطأ_بناء_نمط = نطاق_صالح_للبناء(المصدر, الاسم.النطاق);
    طابق الخطأ مع
    | اختيار.بعض(القيمة) -> {
        أرجع نتيجة.خطأ(القيمة);
    }
    | اختيار.لا_شيء -> {
    };
    طابق معرف_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
    | اختيار.بعض(المعرف) -> {
        أرجع نتيجة.نجح(المعرف);
    }
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بناء_نمط.هوية_اسم_مفقودة(الاسم.النطاق));
    };
}

عرف ابن_نمط_دلالي(
    السجل: &متغير سجل_أنماط,
    الروابط: &سياق_روابط_أسماء,
    المصدر: &مصدر,
    النمط: &نمط
): نتيجة_بناء_نمط {
    دع القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.بدل(النطاق) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختيار.لا_شيء -> { };
        دع المعرف: معرف_نمط = سجل_نمطا(السجل, نمط_دلالي.بدل(النطاق));
        أرجع نتيجة_بناء_نمط.مبني(المعرف);
    }
    | نمط.ربط(النطاق, الاسم) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختيار.لا_شيء -> { };
        دع اسم_مقنن: نتيجة معرف_اسم, خطأ_بناء_نمط = هوية_اسم_نمط(الروابط, المصدر, الاسم);
        طابق اسم_مقنن مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | نتيجة.نجح(هوية) -> {
            دع المعرف: معرف_نمط = سجل_نمطا(السجل, نمط_دلالي.ربط(النطاق, هوية));
            أرجع نتيجة_بناء_نمط.مبني(المعرف);
        };
    }
    | نمط.صف(النطاق, العناصر) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختيار.لا_شيء -> { };
        دع الأبناء: متغير متجه معرف_نمط = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
            دع الابن: نتيجة_بناء_نمط = ابن_نمط_دلالي(السجل, الروابط, المصدر, &العناصر[ف]);
            طابق الابن مع
            | نتيجة_بناء_نمط.مرفوض(الخطأ) -> {
                أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
            }
            | نتيجة_بناء_نمط.مبني(المعرف) -> {
                ألحق(الأبناء, المعرف);
            };
            ف := ف + 1;
        }
        دع المعرف: معرف_نمط = سجل_نمطا(السجل, نمط_دلالي.صف(النطاق, الأبناء));
        أرجع نتيجة_بناء_نمط.مبني(المعرف);
    }
    | نمط.سجل(النطاق, الحقول) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختيار.لا_شيء -> { };
        دع الدلالية: متغير متجه حقل_نمط_دلالي = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحقول) مثل غير_موقع)) {
            دع مرجع_الحقل: &حقل_نمط = &الحقول[ف];
            دع الحقل: حقل_نمط = *مرجع_الحقل;
            دع اسم_مقنن: نتيجة معرف_اسم, خطأ_بناء_نمط = هوية_اسم_نمط(
                الروابط, المصدر, الحقل.الاسم
            );
            طابق اسم_مقنن مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
            }
            | نتيجة.نجح(هوية) -> {
                دع الابن: نتيجة_بناء_نمط = ابن_نمط_دلالي(
                    السجل, الروابط, المصدر, &الحقل.النمط
                );
                طابق الابن مع
                | نتيجة_بناء_نمط.مرفوض(الخطأ) -> {
                    أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
                }
                | نتيجة_بناء_نمط.مبني(معرف_الابن) -> {
                    دع نطاق_الابن: اختيار نطاق = نطاق_نمط_عند(السجل, معرف_الابن);
                    طابق نطاق_الابن مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_بناء_نمط.مرفوض(
                            خطأ_بناء_نمط.تابع_غير_صالح(معرف_الابن)
                        );
                    }
                    | اختيار.بعض(نطاق_القيمة) -> {
                        دع نطاق_الحقل: نطاق = دمج_نطاق(الحقل.الاسم.النطاق, نطاق_القيمة);
                        دع سجل_الحقل: حقل_نمط_دلالي = {
                            الاسم: هوية,
                            نطاق_الاسم: الحقل.الاسم.النطاق,
                            النمط: معرف_الابن,
                            النطاق: نطاق_الحقل
                        };
                        ألحق(الدلالية, سجل_الحقل);
                    };
                };
            };
            ف := ف + 1;
        }
        دع المعرف: معرف_نمط = سجل_نمطا(السجل, نمط_دلالي.سجل(النطاق, الدلالية));
        أرجع نتيجة_بناء_نمط.مبني(المعرف);
    }
    | نمط.منشئ(النطاق, النوع, المنشئ, الحمولات) -> {
        طابق نطاق_صالح_للبناء(المصدر, النطاق) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | اختيار.لا_شيء -> { };
        دع هوية_النوع: نتيجة معرف_اسم, خطأ_بناء_نمط = هوية_اسم_نمط(
            الروابط, المصدر, النوع
        );
        دع هوية_المنشئ: نتيجة معرف_اسم, خطأ_بناء_نمط = هوية_اسم_نمط(
            الروابط, المصدر, المنشئ
        );
        طابق هوية_النوع مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
        }
        | نتيجة.نجح(النوع_المقنن) -> {
            طابق هوية_المنشئ مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
            }
            | نتيجة.نجح(المنشئ_المقنن) -> {
                دع الأبناء: متغير متجه معرف_نمط = [];
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(الحمولات) مثل غير_موقع)) {
                    دع الابن: نتيجة_بناء_نمط = ابن_نمط_دلالي(
                        السجل, الروابط, المصدر, &الحمولات[ف]
                    );
                    طابق الابن مع
                    | نتيجة_بناء_نمط.مرفوض(الخطأ) -> {
                        أرجع نتيجة_بناء_نمط.مرفوض(الخطأ);
                    }
                    | نتيجة_بناء_نمط.مبني(المعرف) -> {
                        ألحق(الأبناء, المعرف);
                    };
                    ف := ف + 1;
                }
                دع المرجع: مرجع_منشئ_نمط = {
                    النوع: النوع_المقنن,
                    نطاق_النوع: النوع.النطاق,
                    المنشئ: المنشئ_المقنن,
                    نطاق_المنشئ: المنشئ.النطاق
                };
                دع المعرف: معرف_نمط = سجل_نمطا(
                    السجل, نمط_دلالي.منشئ(النطاق, المرجع, الأبناء)
                );
                أرجع نتيجة_بناء_نمط.مبني(المعرف);
            };
        };
    };
}

// نقطة البناء الوحيدة من AST إلى Pattern الدلالي. لا يجري هنا أي تحقق aggregate من Type.
عام عرف ابن_نمطا(
    السجل: &متغير سجل_أنماط,
    الروابط: &سياق_روابط_أسماء,
    المصدر: &مصدر,
    النمط: &نمط
): نتيجة_بناء_نمط {
    أرجع ابن_نمط_دلالي(السجل, الروابط, المصدر, النمط);
}

// يستخرج فقط هوية نطاق نمط AST عند حد البناء/الربط؛ لا يجري أي تحليل Pattern هنا.
عرف نطاق_نمط_تركيبي(النمط: &نمط): نطاق {
    أرجع نطاق_نمط(النمط);
}

// الربط المقنن من نمط AST الموجود إلى معرف Pattern الدلالي الذي سبق بناؤه.
// هذه دالة lookup فقط: لا تعيد البناء ولا التحليل ولا التحقق النوعي.
عام عرف معرف_نمط_تركيبي_عند(السجل: &سجل_أنماط, النمط: &نمط): اختيار معرف_نمط {
    أرجع معرف_نمط_عند_نطاق(السجل, نطاق_نمط_تركيبي(النمط));
}

// العقد الضيق الذي يحتاجه خفض match: كل ذراع يعطي مباشرة معرف Pattern الجذر المقنن.
عام عرف معرف_نمط_ذراع_مطابقة_عند(السجل: &سجل_أنماط, الذراع: &ذراع_مطابقة): اختيار معرف_نمط {
    دع القيمة: ذراع_مطابقة = *الذراع;
    أرجع معرف_نمط_تركيبي_عند(السجل, &القيمة.النمط);
}
