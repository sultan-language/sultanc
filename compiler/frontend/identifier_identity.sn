    دع موضع_المصدر: متغير طبيعي = البداية;
    دع موضع_الهوية: متغير طبيعي = 0;
    طالما (موضع_المصدر < النهاية) {
        دع مفكوك_المصدر: ط64 = فك_هوية_معرف_سريع(النص, موضع_المصدر, النهاية);
        إذا (مفكوك_المصدر == 0) {
            أرجع خطأ;
        };
