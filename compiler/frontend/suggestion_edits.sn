استورد std.text.from_bytes;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.token_identity;
استورد compiler.frontend.module_loading.module_loader;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.compatibility;
استورد compiler.frontend.types.tooling_queries;
استورد compiler.frontend.types.builtins_generated;

// Structured suggestions with edits, made only from facts the frontend has
// (docs/en/reference/diagnostics.md, "Suggestions and fixes"):
//   - `mutable` for a `let` binding that is written to;
//   - the `import` of a std module that declares an unknown name public;
//   - `&`, `*` or an explicit `as` conversion when the expected and the
//     found Type say exactly which one fits.
// Every edit is checked against the source bytes before it is offered, and
// its keywords are written in the source's own surface (English or Arabic).

// ---- Source access ----

عرف مصدر_موجود(المحمل: &خريطة_مصادر, المعرف: طبيعي): منطقي {
    أرجع المعرف < (الطول((*المحمل).المصادر) مثل طبيعي)
        && (*المحمل).المصادر[المعرف].المعرف == المعرف;
}

عرف بايت_معرف(البايت: ط8): منطقي {
    أرجع (البايت >= 0x30 && البايت <= 0x39) || (البايت >= 0x41 && البايت <= 0x5A)
        || (البايت >= 0x61 && البايت <= 0x7A) || البايت == 0x5F || البايت >= 0x80;
}

عرف بايت_فراغ_سطر(البايت: ط8): منطقي {
    أرجع البايت == 0x20 || البايت == 0x09;
}

// Whether النص[ف..] begins with الكلمة as a whole word.
عرف كلمة_عند(النص: &نص, ف: طبيعي, الكلمة: &نص): منطقي {
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    دع ك: طبيعي = الطول(*الكلمة) مثل طبيعي;
    إذا (ك == 0 || ف + ك > ن) { أرجع خطأ; };
    دع ي: متغير طبيعي = 0;
    طالما (ي < ك) {
        إذا ((*النص)[ف + ي] != (*الكلمة)[ي]) { أرجع خطأ; };
        ي := ي + 1;
    }
    إذا (ف > 0 && بايت_معرف((*النص)[ف - 1])) { أرجع خطأ; };
    إذا (ف + ك < ن && بايت_معرف((*النص)[ف + ك])) { أرجع خطأ; };
    أرجع صواب;
}

// The spelling of a keyword in a surface.
عرف تهجئة_كلمة(الرمز: رمز, إنجليزي: منطقي): نص {
    إذا (إنجليزي) { أرجع تهجئة_عرض_رمز_إنجليزية(الرمز); };
    أرجع تهجئة_عرض_رمز_عربية(الرمز);
}

// The start of the first line that holds code (not blank, not a `//`
// comment), or the end of the text.
عرف بداية_أول_سطر_شفرة(النص: &نص): طبيعي {
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع البداية: طبيعي = ف;
        دع ي: متغير طبيعي = ف;
        طالما (ي < ن && بايت_فراغ_سطر((*النص)[ي])) { ي := ي + 1; }
        دع فارغ: منطقي = ي >= ن || (*النص)[ي] == 0x0A || (*النص)[ي] == 0x0D;
        دع تعليق: منطقي = ي + 1 < ن && (*النص)[ي] == 0x2F && (*النص)[ي + 1] == 0x2F;
        إذا (!فارغ && !تعليق) { أرجع البداية; };
        طالما (ي < ن && (*النص)[ي] != 0x0A) { ي := ي + 1; }
        ف := ي + 1;
    }
    أرجع ن;
}

// Whether the source's keywords are English: its first code line starts
// with an ASCII letter (a keyword: `import`, `def`, `type`, ...), not an
// Arabic one (`استورد`, `عرف`, `نوع`, ...).
عام عرف شفرة_بسطح_إنجليزي(النص: &نص): منطقي {
    دع ف: متغير طبيعي = بداية_أول_سطر_شفرة(النص);
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    طالما (ف < ن && بايت_فراغ_سطر((*النص)[ف])) { ف := ف + 1; }
    إذا (ف >= ن) { أرجع صواب; };
    دع ب: ط8 = (*النص)[ف];
    أرجع (ب >= 0x41 && ب <= 0x5A) || (ب >= 0x61 && ب <= 0x7A);
}

// A zero-width span at بايت of a source, for an insertion, with the line it
// is on as its snippet.
عرف مصدر_إدراج(المحمل: &خريطة_مصادر, المعرف: طبيعي, البايت: طبيعي): اختياري نطاق_مصدر_تشخيص {
    دع الموضع: موضع = { المصدر: المعرف مثل ط32, البايت: البايت مثل ط32 };
    دع النطاق: نطاق = نطاق_بين(الموضع, الموضع);
    دع المقتطف: اختياري نص = مقتطف_مصدر_محمل_لنطاق(المحمل, &النطاق);
    أرجع نطاق_مصدر_تشخيص_من_خريطة(النطاق, المحمل, المعرف, المقتطف);
}

// ---- `mutable` for a `let` that is written to ----

// The declaration span of a `let` binding (the statement `let name: Type =
// ...`, or its name alone): the byte where its Type begins, after `:`, when
// the binding is a `let` without `mutable`; none otherwise (a parameter, a
// pattern binding, ...). إنجليزي says whether the `let` is spelled in English.
عرف موضع_نوع_ربط_دع(النص: &نص, نطاق_التصريح: نطاق, إنجليزي: &متغير منطقي): اختياري طبيعي {
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    دع البداية: طبيعي = نطاق_التصريح.البداية.البايت مثل طبيعي;
    دع النهاية: طبيعي = نطاق_التصريح.النهاية.البايت مثل طبيعي;
    إذا (البداية >= النهاية || النهاية > ن) { أرجع اختياري.لا_شيء(); };
    دع دع_إنجليزية: نص = تهجئة_عرض_رمز_إنجليزية(رمز.دع());
    دع دع_عربية: نص = تهجئة_عرض_رمز_عربية(رمز.دع());
    دع ك_إ: طبيعي = الطول(دع_إنجليزية) مثل طبيعي;
    دع ك_ع: طبيعي = الطول(دع_عربية) مثل طبيعي;
    // The end of the name.
    دع ف: متغير طبيعي = 0;
    إذا (كلمة_عند(النص, البداية, &دع_إنجليزية) || كلمة_عند(النص, البداية, &دع_عربية)) {
        // The span starts with the `let` keyword: the name follows it.
        *إنجليزي := كلمة_عند(النص, البداية, &دع_إنجليزية);
        ف := البداية + ك_ع;
        إذا (*إنجليزي) { ف := البداية + ك_إ; };
        طالما (ف < ن && بايت_فراغ_سطر((*النص)[ف])) { ف := ف + 1; }
        دع بداية_الاسم: طبيعي = ف;
        طالما (ف < ن && بايت_معرف((*النص)[ف])) { ف := ف + 1; }
        إذا (ف == بداية_الاسم) { أرجع اختياري.لا_شيء(); };
    } وإلا {
        // The span is the name: the `let` keyword is before it.
        دع ق: متغير طبيعي = البداية;
        طالما (ق > 0 && بايت_فراغ_سطر((*النص)[ق - 1])) { ق := ق - 1; }
        إذا (ق >= ك_إ && كلمة_عند(النص, ق - ك_إ, &دع_إنجليزية)) {
            *إنجليزي := صواب;
        } وإلا إذا (ق >= ك_ع && كلمة_عند(النص, ق - ك_ع, &دع_عربية)) {
            *إنجليزي := خطأ;
        } وإلا {
            أرجع اختياري.لا_شيء();
        };
        ف := النهاية;
    };
    // `:` and the Type after the name.
    طالما (ف < ن && بايت_فراغ_سطر((*النص)[ف])) { ف := ف + 1; }
    إذا (ف >= ن || (*النص)[ف] != 0x3A) { أرجع اختياري.لا_شيء(); };
    ف := ف + 1;
    طالما (ف < ن && بايت_فراغ_سطر((*النص)[ف])) { ف := ف + 1; }
    إذا (ف >= ن || (*النص)[ف] == 0x0A || (*النص)[ف] == 0x3D) { أرجع اختياري.لا_شيء(); };
    دع متغير_إنجليزية: نص = تهجئة_عرض_رمز_إنجليزية(رمز.متغير());
    دع متغير_عربية: نص = تهجئة_عرض_رمز_عربية(رمز.متغير());
    إذا (كلمة_عند(النص, ف, &متغير_إنجليزية) || كلمة_عند(النص, ف, &متغير_عربية)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(ف);
}

// A write to an immutable `let` binding: insert `mutable ` before its Type.
// Machine-applicable: the binding becomes mutable and nothing else changes.
عام عرف أضف_إصلاح_اجعل_ربطا_متغيرا(
    التشخيص: &متغير تشخيص,
    المحمل: &خريطة_مصادر,
    نطاق_التصريح: نطاق
): منطقي {
    دع المعرف: طبيعي = نطاق_التصريح.البداية.المصدر مثل طبيعي;
    إذا (!مصدر_موجود(المحمل, المعرف)) { أرجع خطأ; };
    دع إنجليزي: متغير منطقي = صواب;
    دع الموضع: متغير طبيعي = 0;
    طابق موضع_نوع_ربط_دع(&(*المحمل).المصادر[المعرف].المحتوى, نطاق_التصريح, &متغير إنجليزي) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(ف) -> { الموضع := ف; };
    طابق مصدر_إدراج(المحمل, المعرف, الموضع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المصدر) -> {
        دع الباني: متغير متجه ط8 = [];
        ألحق_بايتات_نص(&متغير الباني, تهجئة_كلمة(رمز.متغير(), إنجليزي));
        ألحق(الباني, 0x20);
        دع بلا_حجج: متجه حجة_تشخيص = [];
        دع أ: منطقي = أضف_مساعدة(التشخيص, مفتاح_صياغة.مساعدة_اجعل_التصريح_متغيرا(), بلا_حجج);
        أرجع أضف_إصلاحا(
            التشخيص, المصدر, الباني مثل نص, قابلية_تطبيق_إصلاح.آلي(),
            مفتاح_صياغة.مساعدة_اجعل_التصريح_متغيرا()
        );
    };
}

// ---- The `import` of a std module ----

// Where an `import` line goes: after the last import line at the top of the
// file, or before its first code line when it has none. Also whether the
// file's keywords are English and whether a newline must come first (the
// last import ends the file without one).
عرف موضع_إدراج_استيراد(النص: &نص, إنجليزي: &متغير منطقي, سطر_جديد_قبل: &متغير منطقي, بلا_استيراد: &متغير منطقي): طبيعي {
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    دع الإنجليزية: نص = تهجئة_عرض_رمز_إنجليزية(رمز.استيراد());
    دع العربية: نص = تهجئة_عرض_رمز_عربية(رمز.استيراد());
    دع بعد_آخر_استيراد: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع أول_شفرة: متغير طبيعي = ن;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع البداية: طبيعي = ف;
        دع ي: متغير طبيعي = ف;
        طالما (ي < ن && بايت_فراغ_سطر((*النص)[ي])) { ي := ي + 1; }
        دع فارغ: منطقي = ي >= ن || (*النص)[ي] == 0x0A || (*النص)[ي] == 0x0D;
        دع تعليق: منطقي = ي + 1 < ن && (*النص)[ي] == 0x2F && (*النص)[ي + 1] == 0x2F;
        دع استيراد_إنجليزي: منطقي = !فارغ && !تعليق && كلمة_عند(النص, ي, &الإنجليزية);
        دع استيراد_عربي: منطقي = !فارغ && !تعليق && كلمة_عند(النص, ي, &العربية);
        إذا (!فارغ && !تعليق && !استيراد_إنجليزي && !استيراد_عربي) {
            أول_شفرة := البداية;
            ف := ن;
        } وإلا {
            طالما (ي < ن && (*النص)[ي] != 0x0A) { ي := ي + 1; }
            إذا (استيراد_إنجليزي || استيراد_عربي) {
                *إنجليزي := استيراد_إنجليزي;
                إذا (ي < ن) { بعد_آخر_استيراد := اختياري.موجود(ي + 1); }
                وإلا { بعد_آخر_استيراد := اختياري.موجود(ن); };
            };
            ف := ي + 1;
        };
    }
    طابق بعد_آخر_استيراد مع
    | اختياري.موجود(الموضع) -> {
        *بلا_استيراد := خطأ;
        *سطر_جديد_قبل := الموضع == ن && ن > 0 && (*النص)[ن - 1] != 0x0A;
        أرجع الموضع;
    }
    | اختياري.لا_شيء -> {
        *بلا_استيراد := صواب;
        *سطر_جديد_قبل := خطأ;
        *إنجليزي := شفرة_بسطح_إنجليزي(النص);
        أرجع أول_شفرة;
    };
}

// The fix that imports المسار (a logical module path such as
// `std.io.writer`) into the source of النطاق. Machine-applicable when it is
// the only std module that declares the name, else maybe-incorrect.
عام عرف أضف_إصلاح_استيراد_وحدة(
    التشخيص: &متغير تشخيص,
    المحمل: &خريطة_مصادر,
    النطاق: نطاق,
    المسار: &نص,
    وحيد: منطقي
): منطقي {
    دع المعرف: طبيعي = النطاق.البداية.المصدر مثل طبيعي;
    إذا (!مصدر_موجود(المحمل, المعرف) || (الطول(*المسار) مثل طبيعي) == 0) { أرجع خطأ; };
    دع إنجليزي: متغير منطقي = صواب;
    دع سطر_قبل: متغير منطقي = خطأ;
    دع بلا_استيراد: متغير منطقي = خطأ;
    دع الموضع: طبيعي = موضع_إدراج_استيراد(
        &(*المحمل).المصادر[المعرف].المحتوى, &متغير إنجليزي, &متغير سطر_قبل, &متغير بلا_استيراد
    );
    طابق مصدر_إدراج(المحمل, المعرف, الموضع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المصدر) -> {
        دع الباني: متغير متجه ط8 = [];
        إذا (سطر_قبل) { ألحق(الباني, 0x0A); };
        ألحق_بايتات_نص(&متغير الباني, تهجئة_كلمة(رمز.استيراد(), إنجليزي));
        ألحق(الباني, 0x20);
        ألحق_بايتات_نص(&متغير الباني, انسخ_نص(المسار));
        ألحق(الباني, 0x3B);
        ألحق(الباني, 0x0A);
        إذا (بلا_استيراد) { ألحق(الباني, 0x0A); };
        دع القابلية: متغير قابلية_تطبيق_إصلاح = قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح();
        إذا (وحيد) { القابلية := قابلية_تطبيق_إصلاح.آلي(); };
        أرجع أضف_إصلاحا(
            التشخيص, المصدر, الباني مثل نص, القابلية,
            مفتاح_صياغة.مساعدة_استورد_وحدة_تصرح_بالاسم()
        );
    };
}

// ---- `&`, `*` and `as` for a Type mismatch ----

// Whether the bytes of a span are one place written as a name path
// (`name`, `record.field`), on one line.
عرف مسار_اسم_بسيط(النص: &نص, البداية: طبيعي, النهاية: طبيعي): منطقي {
    إذا (البداية >= النهاية || النهاية > (الطول(*النص) مثل طبيعي)) { أرجع خطأ; };
    دع الأول: ط8 = (*النص)[البداية];
    إذا (الأول >= 0x30 && الأول <= 0x39) { أرجع خطأ; };
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع ب: ط8 = (*النص)[ف];
        إذا (!بايت_معرف(ب) && ب != 0x2E) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع (*النص)[النهاية - 1] != 0x2E;
}

// Whether the bytes of a span can be one expression: one line, no `;`, `{`
// or `}`, and balanced parentheses and brackets.
عرف تعبير_على_سطر(النص: &نص, البداية: طبيعي, النهاية: طبيعي): منطقي {
    إذا (البداية >= النهاية || النهاية > (الطول(*النص) مثل طبيعي)) { أرجع خطأ; };
    دع العمق: متغير طبيعي = 0;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب == 0x0A || ب == 0x0D || ب == 0x3B || ب == 0x7B || ب == 0x7D) { أرجع خطأ; };
        إذا (ب == 0x28 || ب == 0x5B) { العمق := العمق + 1; };
        إذا (ب == 0x29 || ب == 0x5D) {
            إذا (العمق == 0) { أرجع خطأ; };
            العمق := العمق - 1;
        };
        ف := ف + 1;
    }
    أرجع العمق == 0;
}

// Whether a call or a name (`f(x)`, `a.b`, `name`): no operator outside
// parentheses, so `(x as T)` needs no inner parentheses.
عرف تعبير_بلا_عامل(النص: &نص, البداية: طبيعي, النهاية: طبيعي): منطقي {
    دع العمق: متغير طبيعي = 0;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب == 0x28 || ب == 0x5B) { العمق := العمق + 1; }
        وإلا إذا (ب == 0x29 || ب == 0x5D) { إذا (العمق > 0) { العمق := العمق - 1; }; }
        وإلا إذا (العمق == 0 && !بايت_معرف(ب) && ب != 0x2E) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف نوع_مقنن_عند(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري نوع_مقنن {
    إذا ((النوع.القيمة مثل طبيعي) >= (الطول((*الأنواع).الأنواع) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_مملوكا_نوع_مقنن(&(*الأنواع).الأنواع[النوع.القيمة]));
}

عرف بدائي_عند(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري نوع_بدائي_مقنن {
    طابق نوع_مقنن_عند(الأنواع, النوع) مع
    | اختياري.موجود(نوع_مقنن.بدائي(البدائي)) -> { أرجع اختياري.موجود(البدائي); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف بدائي_عددي(البدائي: نوع_بدائي_مقنن): منطقي {
    طابق صنف_النوع_البدائي(البدائي) مع
    | صنف_نوع_بدائي.عدد_موقع -> { أرجع صواب; }
    | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> { أرجع صواب; }
    | صنف_نوع_بدائي.عشري -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether every value of the integer Type الأصل is a value of the integer
// Type الغاية: a wider Type that keeps the sign, or a wider signed one.
عرف تحويل_صحيح_يحفظ_القيمة(الأصل: نوع_بدائي_مقنن, الغاية: نوع_بدائي_مقنن): منطقي {
    دع صنف_من: صنف_نوع_بدائي = صنف_النوع_البدائي(الأصل);
    دع صنف_إلى: صنف_نوع_بدائي = صنف_النوع_البدائي(الغاية);
    دع بتات_من: طبيعي = بتات_نوع_بدائي(الأصل);
    دع بتات_إلى: طبيعي = بتات_نوع_بدائي(الغاية);
    إذا (بتات_من == 0 || بتات_إلى == 0) { أرجع خطأ; };
    إذا (صنف_من == صنف_نوع_بدائي.عدد_صحيح_طبيعي() && صنف_إلى == صنف_نوع_بدائي.عدد_صحيح_طبيعي()) { أرجع بتات_إلى >= بتات_من; };
    إذا (صنف_من == صنف_نوع_بدائي.عدد_موقع() && صنف_إلى == صنف_نوع_بدائي.عدد_موقع()) { أرجع بتات_إلى >= بتات_من; };
    إذا (صنف_من == صنف_نوع_بدائي.عدد_صحيح_طبيعي() && صنف_إلى == صنف_نوع_بدائي.عدد_موقع()) { أرجع بتات_إلى > بتات_من; };
    أرجع خطأ;
}

// The fix for a value of Type الموجود where الأنواع expects المتوقع, at the
// expression span النطاق: `&value` when a reference to the value's Type is
// expected, `*value` when the value is a reference to the expected Type, and
// `(value as T)` when the two are numbers an explicit conversion joins. None
// when the Types do not say which edit fits or the span is not an expression
// those edits can wrap.
عام عرف أضف_إصلاح_تحويل_نوع(
    التشخيص: &متغير تشخيص,
    المحمل: &خريطة_مصادر,
    الأنواع: &سجل_أنواع,
    الأسماء: &متجه اسم_مقنن,
    الرموز: &متجه رمز_دلالي,
    النطاق: نطاق,
    المتوقع: معرف_نوع,
    الموجود: معرف_نوع
): منطقي {
    دع المعرف: طبيعي = النطاق.البداية.المصدر مثل طبيعي;
    إذا (!مصدر_موجود(المحمل, المعرف) || النطاق.النهاية.المصدر != النطاق.البداية.المصدر) { أرجع خطأ; };
    دع النص: &نص = &(*المحمل).المصادر[المعرف].المحتوى;
    دع البداية: طبيعي = النطاق.البداية.البايت مثل طبيعي;
    دع النهاية: طبيعي = النطاق.النهاية.البايت مثل طبيعي;
    إذا (!تعبير_على_سطر(النص, البداية, النهاية)) { أرجع خطأ; };
    دع إنجليزي: منطقي = شفرة_بسطح_إنجليزي(النص);
    دع متوقع_أساس: متغير معرف_نوع = المتوقع;
    طابق أزل_غلاف_متغير(الأنواع, المتوقع) مع
    | اختياري.موجود(الأساس) -> { متوقع_أساس := الأساس; }
    | اختياري.لا_شيء -> { };
    دع موجود_أساس: متغير معرف_نوع = الموجود;
    طابق أزل_غلاف_متغير(الأنواع, الموجود) مع
    | اختياري.موجود(الأساس) -> { موجود_أساس := الأساس; }
    | اختياري.لا_شيء -> { };
    دع بسيط: منطقي = مسار_اسم_بسيط(النص, البداية, النهاية);

    // A reference to the value's Type is expected: borrow the place.
    طابق نوع_مقنن_عند(الأنواع, متوقع_أساس) مع
    | اختياري.موجود(نوع_مقنن.مرجع(الداخل, قابل_للتغيير)) -> {
        إذا (بسيط && نوعان_متوافقان(الأنواع, موجود_أساس, الداخل)) {
            دع الباني: متغير متجه ط8 = [];
            ألحق(الباني, 0x26);
            إذا (قابل_للتغيير) {
                ألحق_بايتات_نص(&متغير الباني, تهجئة_كلمة(رمز.متغير(), إنجليزي));
                ألحق(الباني, 0x20);
            };
            أرجع أضف_إصلاح_بادئة(التشخيص, المحمل, المعرف, البداية, الباني مثل نص,
                قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح(), مفتاح_صياغة.مساعدة_استعر_القيمة());
        };
        أرجع خطأ;
    }
    | _ -> { };

    // The value is a reference to the expected Type: read through it. A
    // number, boolean or character is copied out, so the edit is exact.
    طابق نوع_مقنن_عند(الأنواع, موجود_أساس) مع
    | اختياري.موجود(نوع_مقنن.مرجع(الداخل, _)) -> {
        إذا (بسيط && نوعان_متوافقان(الأنواع, الداخل, متوقع_أساس)) {
            دع القابلية: متغير قابلية_تطبيق_إصلاح = قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح();
            طابق بدائي_عند(الأنواع, متوقع_أساس) مع
            | اختياري.موجود(البدائي) -> {
                طابق صنف_النوع_البدائي(البدائي) مع
                | صنف_نوع_بدائي.نص -> { }
                | صنف_نوع_بدائي.غير_معروف -> { }
                | صنف_نوع_بدائي.فراغ -> { }
                | _ -> { القابلية := قابلية_تطبيق_إصلاح.آلي(); };
            }
            | اختياري.لا_شيء -> { };
            أرجع أضف_إصلاح_بادئة(التشخيص, المحمل, المعرف, البداية, «*»,
                القابلية, مفتاح_صياغة.مساعدة_اقرأ_القيمة_عبر_المرجع());
        };
        أرجع خطأ;
    }
    | _ -> { };

    // Two numbers an explicit conversion joins.
    طابق بدائي_عند(الأنواع, موجود_أساس) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(بدائي_الموجود) -> {
        طابق بدائي_عند(الأنواع, متوقع_أساس) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(بدائي_المتوقع) -> {
            إذا (!بدائي_عددي(بدائي_الموجود) || !بدائي_عددي(بدائي_المتوقع)) { أرجع خطأ; };
            طابق صنف_تحويل_بين(الأنواع, موجود_أساس, متوقع_أساس) مع
            | صنف_تحويل_نوع.صريح_آمن -> { }
            | _ -> { أرجع خطأ; };
            دع اللغة: متغير لغة_تشخيص = لغة_تشخيص.العربية();
            إذا (إنجليزي) { اللغة := لغة_تشخيص.الإنجليزية(); };
            طابق تهجئة_نوع_بلغة(الأنواع, الأسماء, الرموز, اللغة, متوقع_أساس) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(اسم_النوع) -> {
                دع بلا_عامل: منطقي = تعبير_بلا_عامل(النص, البداية, النهاية);
                دع الافتتاح: متغير متجه ط8 = [];
                ألحق(الافتتاح, 0x28);
                إذا (!بلا_عامل) { ألحق(الافتتاح, 0x28); };
                دع الختام: متغير متجه ط8 = [];
                إذا (!بلا_عامل) { ألحق(الختام, 0x29); };
                ألحق(الختام, 0x20);
                ألحق_بايتات_نص(&متغير الختام, تهجئة_كلمة(رمز.تحويل_نوع(), إنجليزي));
                ألحق(الختام, 0x20);
                ألحق_بايتات_نص(&متغير الختام, اسم_النوع);
                ألحق(الختام, 0x29);
                دع القابلية: متغير قابلية_تطبيق_إصلاح = قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح();
                إذا (تحويل_صحيح_يحفظ_القيمة(بدائي_الموجود, بدائي_المتوقع)) {
                    القابلية := قابلية_تطبيق_إصلاح.آلي();
                };
                طابق مصدر_إدراج(المحمل, المعرف, البداية) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(مصدر_البداية) -> {
                    طابق مصدر_إدراج(المحمل, المعرف, النهاية) مع
                    | اختياري.لا_شيء -> { أرجع خطأ; }
                    | اختياري.موجود(مصدر_النهاية) -> {
                        دع بلا_حجج: متجه حجة_تشخيص = [];
                        دع أ: منطقي = أضف_مساعدة(التشخيص, مفتاح_صياغة.مساعدة_حول_القيمة_صراحة(), بلا_حجج);
                        أرجع أضف_إصلاحا_مركبا_من_تعديلين(
                            التشخيص, مصدر_البداية, الافتتاح مثل نص, مصدر_النهاية, الختام مثل نص,
                            القابلية, مفتاح_صياغة.مساعدة_حول_القيمة_صراحة()
                        );
                    };
                };
            };
        };
    };
}

// A help and a fix that inserts البادئة before the expression at البداية.
عرف أضف_إصلاح_بادئة(
    التشخيص: &متغير تشخيص,
    المحمل: &خريطة_مصادر,
    المعرف: طبيعي,
    البداية: طبيعي,
    البادئة: نص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
): منطقي {
    طابق مصدر_إدراج(المحمل, المعرف, البداية) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المصدر) -> {
        دع بلا_حجج: متجه حجة_تشخيص = [];
        دع أ: منطقي = أضف_مساعدة(التشخيص, المفتاح, بلا_حجج);
        أرجع أضف_إصلاحا(التشخيص, المصدر, البادئة, القابلية, المفتاح);
    };
}
