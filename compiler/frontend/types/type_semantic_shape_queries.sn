استورد compiler.frontend.types.type_context;
// Derived read-only queries for representation consumers.
// The canonical Type registry remains the only storage owner; Name identities never leave this contract.
عام عرف وصف_شكل_نوع_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري وصف_شكل_نوع_دلالي {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.بدائي(البدائي);
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.معامل_نوع(_) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.معامل_نوع();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.صف(العناصر) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.صف();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.صندوق();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.اختيار(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.اختيار();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.نتيجة();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.دالة();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, _) -> {
            طابق الشكل مع
            | شكل_نوع_مسمى.سجل -> {
                دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.سجل();
                دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
                أرجع اختياري.موجود(الوصف);
            }
            | شكل_نوع_مسمى.تعداد -> {
                دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.تعداد();
                دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
                أرجع اختياري.موجود(الوصف);
            };
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.مؤشر();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.مرجع(الداخل, المتغير) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.مرجع();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.شريحة();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.متجه(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.متجه();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.متغير(الداخل) -> {
            أرجع وصف_شكل_نوع_دلالي_عند(سجل_الأنواع, الداخل);
        };
    };
}

عام عرف عدد_عناصر_صف_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري طبيعي {
    أرجع عدد_عناصر_صف(سجل_الأنواع, المعرف);
}

عام عرف نوع_عنصر_صف_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    أرجع عنصر_صف_عند(سجل_الأنواع, المعرف, الفهرس);
}

عام عرف عدد_حقول_سجل_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري طبيعي {
    أرجع عدد_حقول_سجل(سجل_الأنواع, المعرف);
}

عام عرف نوع_حقل_سجل_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    طابق حقل_سجل_عند(سجل_الأنواع, المعرف, الفهرس) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الحقل) -> {
        أرجع اختياري.موجود(نوع_حقل_سجل(&الحقل));
    };
}

عام عرف عدد_منشئات_نوع_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري طبيعي {
    أرجع عدد_منشئات_نوع(سجل_الأنواع, المعرف);
}

عام عرف عدد_حمولات_منشئ_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    فهرس_المنشئ: طبيعي
): اختياري طبيعي {
    طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, فهرس_المنشئ) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(المنشئ) -> {
        أرجع اختياري.موجود(عدد_حمولات_منشئ(&المنشئ));
    };
}

عام عرف نوع_حمولة_منشئ_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    فهرس_المنشئ: طبيعي,
    فهرس_الحمولة: طبيعي
): اختياري معرف_نوع {
    طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, فهرس_المنشئ) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(المنشئ) -> {
        أرجع حمولة_منشئ_عند(&المنشئ, فهرس_الحمولة);
    };
}

عام عرف نوع_داخل_مرجع_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.مرجع(الداخل, المتغير) -> {
            لو (المتغير) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف نوع_داخل_مرجع_متغير_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.مرجع(الداخل, المتغير) -> {
            لو (!المتغير) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// The element of a runtime sequence: a vector or a slice view (same layout).
// Ownership queries keep using نوع_عنصر_متجه_دلالي: a slice owns nothing.
عام عرف نوع_عنصر_تسلسل_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق نوع_عنصر_متجه_دلالي(سجل_الأنواع, المعرف) مع
    | اختياري.موجود(العنصر) -> { أرجع اختياري.موجود(العنصر); }
    | اختياري.لا_شيء -> { أرجع نوع_عنصر_شريحة_دلالي(سجل_الأنواع, المعرف); };
}

عام عرف نوع_عنصر_متجه_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.متجه(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف نوع_حمولة_صندوق_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
