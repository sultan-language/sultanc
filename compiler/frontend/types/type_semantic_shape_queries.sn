// Resolve a canonical field Name identity to its declaration-order semantic facts.
// No spelling lookup and no physical layout information are involved.
عام عرف وصف_حقل_سجل_دلالي_بالاسم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختيار وصف_حقل_سجل_دلالي {
    طابق عدد_حقول_سجل(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(العدد) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            طابق حقل_سجل_عند(سجل_الأنواع, المعرف, ف) مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            }
            | اختيار.بعض(الحقل) -> {
                لو (معرفا_اسم_متساويان(الحقل.الاسم, الاسم)) {
                    دع نوع_الحقل: معرف_نوع = نوع_حقل_سجل(&الحقل);
                    دع الوصف: وصف_حقل_سجل_دلالي = {
                        الترتيب: ف,
                        النوع: نوع_الحقل
                    };
                    أرجع اختيار.بعض(الوصف);
                };
            };
            ف := ف + 1;
        }
        أرجع اختيار.لا_شيء();
    };
}

عام عرف ترتيب_حقل_سجل_دلالي_بالاسم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختيار غير_موقع {
    طابق وصف_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, المعرف, الاسم) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الوصف) -> {
        أرجع اختيار.بعض(الوصف.الترتيب);
    };
}

عام عرف نوع_حقل_سجل_دلالي_بالاسم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختيار معرف_نوع {
    طابق وصف_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, المعرف, الاسم) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الوصف) -> {
        أرجع اختيار.بعض(الوصف.النوع);
    };
}

// Resolve canonical constructor identity to semantic constructor order and payload count.
// Payload Types are queried by index below, without copying registry-owned vectors.
// The registry implementation covers named enums and builtin Option/Result forms.
عام عرف وصف_منشئ_نوع_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختيار وصف_منشئ_نوع_دلالي {
    طابق ترتيب_منشئ_نوع(سجل_الأنواع, المعرف, الهوية) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الترتيب) -> {
        طابق عدد_حمولات_منشئ_دلالي_عند(سجل_الأنواع, المعرف, الترتيب) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(عدد_الحمولات) -> {
            دع الوصف: وصف_منشئ_نوع_دلالي = {
                الترتيب: الترتيب,
                عدد_الحمولات: عدد_الحمولات
            };
            أرجع اختيار.بعض(الوصف);
        };
    };
}

عام عرف ترتيب_منشئ_نوع_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختيار غير_موقع {
    طابق وصف_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, المعرف, الهوية) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الوصف) -> {
        أرجع اختيار.بعض(الوصف.الترتيب);
    };
}

عام عرف عدد_حمولات_منشئ_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
