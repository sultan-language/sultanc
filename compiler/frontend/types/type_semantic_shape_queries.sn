        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// Resolve a canonical field Name identity to its declaration-order semantic facts.
// No spelling lookup and no physical layout information are involved.
عام عرف وصف_حقل_سجل_دلالي_بالاسم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختياري وصف_حقل_سجل_دلالي {
    طابق عدد_حقول_سجل(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(العدد) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق حقل_سجل_عند(سجل_الأنواع, المعرف, ف) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(الحقل) -> {
                لو (معرفا_اسم_متساويان(الحقل.الاسم, الاسم)) {
                    دع نوع_الحقل: معرف_نوع = نوع_حقل_سجل(&الحقل);
                    دع الوصف: وصف_حقل_سجل_دلالي = {
                        الترتيب: ف,
                        النوع: نوع_الحقل
                    };
                    أرجع اختياري.موجود(الوصف);
                };
            };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

عام عرف ترتيب_حقل_سجل_دلالي_بالاسم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختياري طبيعي {
    طابق وصف_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, المعرف, الاسم) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف.الترتيب);
    };
}

عام عرف نوع_حقل_سجل_دلالي_بالاسم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختياري معرف_نوع {
    طابق وصف_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, المعرف, الاسم) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف.النوع);
    };
}

// Resolve canonical constructor identity to semantic constructor order and payload count.
// Payload Types are queried by index below, without copying registry-owned vectors.
// The registry implementation covers named enums and builtin Option/Result forms.
عام عرف وصف_منشئ_نوع_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري وصف_منشئ_نوع_دلالي {
    طابق ترتيب_منشئ_نوع(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الترتيب) -> {
        طابق عدد_حمولات_منشئ_دلالي_عند(سجل_الأنواع, المعرف, الترتيب) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(عدد_الحمولات) -> {
            دع الوصف: وصف_منشئ_نوع_دلالي = {
                الترتيب: الترتيب,
                عدد_الحمولات: عدد_الحمولات
            };
            أرجع اختياري.موجود(الوصف);
        };
    };
}

عام عرف ترتيب_منشئ_نوع_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري طبيعي {
    طابق وصف_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف.الترتيب);
    };
}

عام عرف عدد_حمولات_منشئ_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري طبيعي {
    طابق وصف_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف.عدد_الحمولات);
    };
}

عام عرف نوع_حمولة_منشئ_دلالي_بالهوية_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع,
    فهرس_الحمولة: طبيعي
): اختياري معرف_نوع {
    طابق وصف_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع نوع_حمولة_منشئ_دلالي_عند(سجل_الأنواع, المعرف, الوصف.الترتيب, فهرس_الحمولة);
    };
}

// Public semantic-query facade for Pattern and other read-only consumers.
// Registry storage remains private to Type; callers receive canonical semantic facts only.
عام عرف معرف_نوع_دلالي_صالح(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): منطقي {
    أرجع معرف_نوع_صالح(سجل_الأنواع, المعرف);
}

عام عرف اسم_منشئ_نوع_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري معرف_اسم {
    طابق ترتيب_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الترتيب) -> {
        طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, الترتيب) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(المنشئ) -> {
            أرجع المنشئ.الاسم;
        };
    };
}

// Narrow canonical queries required by lowering. They expose scalar Type identities only.
عام عرف عدد_معاملات_دالة_دلالية(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع
): اختياري طبيعي {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_4) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_4.القيمة] مع
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
        أرجع اختياري.موجود(الطول(المعاملات) مثل طبيعي);
    }
        | _ -> {
        أرجع اختياري.لا_شيء();
    };
    };
}

عام عرف نوع_معامل_دالة_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع, الفهرس: طبيعي
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_5) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_5.القيمة] مع
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
        لو (الفهرس >= (الطول(المعاملات) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(المعاملات[الفهرس]);
    }
        | _ -> {
        أرجع اختياري.لا_شيء();
    };
    };
}

عام عرف نوع_ناتج_دالة_دلالي(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_6) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_6.القيمة] مع
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
        أرجع اختياري.موجود(الناتج);
    }
        | _ -> {
        أرجع اختياري.لا_شيء();
    };
    };
}

عام عرف نوع_عنصر_شريحة_دلالي(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_7) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_7.القيمة] مع
        | نوع_مقنن.شريحة(الداخل) -> {
        أرجع اختياري.موجود(الداخل);
    }
        | _ -> {
        أرجع اختياري.لا_شيء();
    };
    };
}

// Named enum constructor identity is derived from the canonical Name Symbol, never spelling.
عام عرف هوية_منشئ_تعداد_دلالية_بالرمز(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع, الرمز: معرف_رمز
): اختياري هوية_منشئ_نوع {
    طابق عدد_منشئات_نوع_دلالي(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(العدد) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, ف) مع
            | اختياري.موجود(المنشئ) -> {
                طابق المنشئ.الهوية مع
                | هوية_منشئ_نوع.تعداد(رمز_المنشئ) -> {
                    لو (معرفا_رمز_متساويان(رمز_المنشئ, الرمز)) {
                        أرجع اختياري.موجود(المنشئ.الهوية);
                    };
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

// Read an already-canonical primitive Type identity without interning or mutating Type state.
عام عرف معرف_نوع_بدائي_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    البدائي: نوع_بدائي_مقنن
): اختياري معرف_نوع {
    // Primitive Type IDs are seeded in the canonical generated order by TypeRegistry.
    دع _حالة_الأنواع: &سجل_أنواع = سجل_الأنواع;
    أرجع اختياري.موجود(معرف_نوع_من(رقم_نوع_بدائي(البدائي)));
}


// Source-facing resolution for contextual Option/Result constructors.  The spelling
// aliases stop at this Type integration boundary; the returned identity is the
// canonical Type-owned constructor identity consumed by Pattern/MSIR.
عام عرف هوية_منشئ_مدمج_دلالية_بالأسماء(
    سياق_الأسماء: &سياق_أسماء,
    سجل_الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    اسم_النوع: معرف_اسم,
    اسم_المنشئ: معرف_اسم
): اختياري هوية_منشئ_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_8) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_8.القيمة] مع
        | نوع_مقنن.اختيار(_) -> {
        لو (!اسم_اختيار_مدمج(سياق_الأسماء, اسم_النوع)) {
            أرجع اختياري.لا_شيء();
        };
        لو (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «لا_شيء»)
            || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «none»)
            || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «None»)) {
            أرجع اختياري.موجود(هوية_منشئ_نوع.اختيار_لا_شيء());
        };
        // موجود is the canonical Arabic spelling; بعض is its deprecated alias
        // for one release (the frontend warns at each use).
        لو (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «موجود»)
            || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «بعض»)
            || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «some»)
            || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «Some»)) {
            أرجع اختياري.موجود(هوية_منشئ_نوع.اختيار_بعض());
        };
        أرجع اختياري.لا_شيء();
    }
        | نوع_مقنن.نتيجة(_, _) -> {
        لو (!اسم_نتيجة_مدمجة(سياق_الأسماء, اسم_النوع)) {
            أرجع اختياري.لا_شيء();
        };
        لو (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «نجح»)
            || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «ok»)
            || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «Ok»)) {
            أرجع اختياري.موجود(هوية_منشئ_نوع.نتيجة_نجاح());
        };
        لو (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «خطأ»)
            || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «err»)
            || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «Err»)) {
            أرجع اختياري.موجود(هوية_منشئ_نوع.نتيجة_خطأ());
        };
        أرجع اختياري.لا_شيء();
    }
        | _ -> {
        أرجع اختياري.لا_شيء();
    };
    };
}

// Only fixed-width primitive Types have target-independent byte sizes.
// Pointer-sized primitives, aggregates, strings and vectors require Target/Layout.
عام عرف حجم_نوع_بدائي_ثابت_بالبايتات(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري طبيعي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مرجع_النوع_9) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_9.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
        طابق البدائي مع
        | نوع_بدائي_مقنن.ص8 -> { أرجع اختياري.موجود(1); }
        | نوع_بدائي_مقنن.ط8 -> { أرجع اختياري.موجود(1); }
        | نوع_بدائي_مقنن.ص16 -> { أرجع اختياري.موجود(2); }
        | نوع_بدائي_مقنن.ط16 -> { أرجع اختياري.موجود(2); }
        | نوع_بدائي_مقنن.ص32 -> { أرجع اختياري.موجود(4); }
        | نوع_بدائي_مقنن.ط32 -> { أرجع اختياري.موجود(4); }
        | نوع_بدائي_مقنن.ع32 -> { أرجع اختياري.موجود(4); }
        | نوع_بدائي_مقنن.ص64 -> { أرجع اختياري.موجود(8); }
        | نوع_بدائي_مقنن.ط64 -> { أرجع اختياري.موجود(8); }
        | نوع_بدائي_مقنن.ع64 -> { أرجع اختياري.موجود(8); }
        | _ -> { };
    }
        | _ -> { };
    };
    أرجع اختياري.لا_شيء();
}
