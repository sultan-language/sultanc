استورد compiler.frontend.types.type_context;
// Derived read-only queries for representation consumers.
// The canonical Type registry remains the only storage owner; Name identities never leave this contract.
عام عرف وصف_شكل_نوع_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار وصف_شكل_نوع_دلالي {
    طابق نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.بدائي(البدائي) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.بدائي(البدائي);
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.معامل_نوع(_) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.معامل_نوع();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.صف(العناصر) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.صف();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.صندوق();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.اختيار(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.اختيار();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.نتيجة();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.دالة();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, _) -> {
            طابق الشكل مع
            | شكل_نوع_مسمى.سجل -> {
                دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.سجل();
                دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
                أرجع اختيار.بعض(الوصف);
            }
            | شكل_نوع_مسمى.تعداد -> {
                دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.تعداد();
                دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
                أرجع اختيار.بعض(الوصف);
            };
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.مؤشر();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.مرجع(الداخل, المتغير) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.مرجع();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.شريحة();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.متجه(الداخل) -> {
            دع الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.متجه();
            دع الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختيار.بعض(الوصف);
        }
        | نوع_مقنن.متغير(الداخل) -> {
            أرجع وصف_شكل_نوع_دلالي_عند(سجل_الأنواع, الداخل);
        };
    };
}

عام عرف عدد_عناصر_صف_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار غير_موقع {
    أرجع عدد_عناصر_صف(سجل_الأنواع, المعرف);
}

عام عرف نوع_عنصر_صف_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    أرجع عنصر_صف_عند(سجل_الأنواع, المعرف, الفهرس);
}

عام عرف عدد_حقول_سجل_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار غير_موقع {
    أرجع عدد_حقول_سجل(سجل_الأنواع, المعرف);
}

عام عرف نوع_حقل_سجل_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    طابق حقل_سجل_عند(سجل_الأنواع, المعرف, الفهرس) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الحقل) -> {
        أرجع اختيار.بعض(نوع_حقل_سجل(&الحقل));
    };
}

عام عرف عدد_منشئات_نوع_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار غير_موقع {
