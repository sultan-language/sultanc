استورد compiler.frontend.types.type_context;
// Derived read-only queries for representation consumers.
// The canonical Type registry remains the only storage owner; Name identities never leave this contract.
عام عرف وصف_شكل_نوع_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري وصف_شكل_نوع_دلالي {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.بدائي(البدائي);
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.معامل_نوع(_) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.معامل_نوع();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.صف(العناصر) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.صف();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.صندوق();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.اختيار(الداخل) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.اختيار();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.نتيجة();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.دالة();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, _) -> {
            طابق الشكل مع
            | شكل_نوع_مسمى.سجل -> {
                ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.سجل();
                ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
                أرجع اختياري.موجود(الوصف);
            }
            | شكل_نوع_مسمى.تعداد -> {
                ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.تعداد();
                ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
                أرجع اختياري.موجود(الوصف);
            }
            | شكل_نوع_مسمى.معتم -> {
                ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.معتم();
                ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
                أرجع اختياري.موجود(الوصف);
            };
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.مؤشر();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.مرجع(الداخل, المتغير) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.مرجع();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.شريحة();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.متجه(الداخل) -> {
            ليكن الصنف: صنف_شكل_نوع_دلالي = صنف_شكل_نوع_دلالي.متجه();
            ليكن الوصف: وصف_شكل_نوع_دلالي = { المعرف: المعرف, الصنف: الصنف };
            أرجع اختياري.موجود(الوصف);
        }
        | نوع_مقنن.متغير(الداخل) -> {
            أرجع وصف_شكل_نوع_دلالي_عند(سجل_الأنواع, الداخل);
        };
    };
}

عام عرف عدد_عناصر_صف_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري طبيعي {
    أرجع عدد_عناصر_صف(سجل_الأنواع, المعرف);
}

عام عرف نوع_عنصر_صف_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    أرجع عنصر_صف_عند(سجل_الأنواع, المعرف, الفهرس);
}

عام عرف عدد_حقول_سجل_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري طبيعي {
    أرجع عدد_حقول_سجل(سجل_الأنواع, المعرف);
}

عام عرف نوع_حقل_سجل_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    طابق حقل_سجل_عند(سجل_الأنواع, المعرف, الفهرس) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الحقل) -> {
        أرجع اختياري.موجود(نوع_حقل_سجل(&الحقل));
    };
}

عام عرف عدد_منشئات_نوع_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري طبيعي {
    أرجع عدد_منشئات_نوع(سجل_الأنواع, المعرف);
}

عام عرف عدد_حمولات_منشئ_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    فهرس_المنشئ: طبيعي
): اختياري طبيعي {
    طابق حقيقة_منشئ_نوع_عند(سجل_الأنواع, المعرف, فهرس_المنشئ, 0) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الحقيقة) -> {
        أرجع اختياري.موجود(الحقيقة.عدد_الحمولات);
    };
}

عام عرف نوع_حمولة_منشئ_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    فهرس_المنشئ: طبيعي,
    فهرس_الحمولة: طبيعي
): اختياري معرف_نوع {
    طابق حقيقة_منشئ_نوع_عند(سجل_الأنواع, المعرف, فهرس_المنشئ, فهرس_الحمولة) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الحقيقة) -> {
        أرجع الحقيقة.الحمولة;
    };
}

عام عرف نوع_داخل_مرجع_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.مرجع(الداخل, المتغير) -> {
            إذا (المتغير) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف نوع_داخل_مرجع_متغير_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.مرجع(الداخل, المتغير) -> {
            إذا (!المتغير) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// The slice Type of العنصر, when one is interned (a named rest of a vector
// pattern is typed with it by Type).
عام عرف نوع_شريحة_دلالي_موجود(
    سجل_الأنواع: &سجل_أنواع,
    العنصر: معرف_نوع
): اختياري معرف_نوع {
    أرجع معرف_نوع_شريحة_مقنن_موجود(سجل_الأنواع, العنصر);
}

// The element of a runtime sequence: a vector or a slice view (same layout).
// Ownership queries keep using نوع_عنصر_متجه_دلالي: a slice owns nothing.
عام عرف نوع_عنصر_تسلسل_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق نوع_عنصر_متجه_دلالي(سجل_الأنواع, المعرف) مع
    | اختياري.موجود(العنصر) -> { أرجع اختياري.موجود(العنصر); }
    | اختياري.لا_شيء -> { أرجع نوع_عنصر_شريحة_دلالي(سجل_الأنواع, المعرف); };
}

// Whether المعرف is `&string`, a shared reference to text. Its value is a
// text header (data, length, capacity) with the layout of every sequence,
// not the address of one: a borrow of a whole text (`&s`) and a borrow of
// part of it (`&s[a..b]`) are the same kind of value, read-only, owning
// nothing. Native code and LLVM hold it by the address of its storage, as
// every aggregate, so `&s` is the address of s's own header and `*r` the
// storage of r's header (docs/en/reference/type-system.md, "Text slices").
// `&mutable string` stays the address of the text.
عام عرف هل_مرجع_نص_مشترك_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): منطقي {
    طابق نوع_داخل_مرجع_دلالي(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الداخل) -> {
        طابق معرف_نوع_أساس_عند(سجل_الأنواع, الداخل) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الأساس) -> {
            طابق (*سجل_الأنواع).الأنواع[الأساس.القيمة] مع
            | نوع_مقنن.بدائي(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.نص(); }
            | _ -> { أرجع خطأ; };
        };
    };
}

// The element Type of a subslice (مقطع_تسلسل) whose result has Type
// المعرف: a slice's element, and for `&string` (a slice of text) its bytes.
عام عرف نوع_عنصر_مقطع_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق نوع_عنصر_تسلسل_دلالي(سجل_الأنواع, المعرف) مع
    | اختياري.موجود(العنصر) -> { أرجع اختياري.موجود(العنصر); }
    | اختياري.لا_شيء -> { };
    إذا (هل_مرجع_نص_مشترك_دلالي(سجل_الأنواع, المعرف)) {
        أرجع معرف_نوع_بدائي_دلالي(سجل_الأنواع, نوع_بدائي_مقنن.ط8());
    };
    أرجع اختياري.لا_شيء();
}

عام عرف نوع_عنصر_متجه_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.متجه(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف نوع_حمولة_صندوق_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// Resolve a canonical field Name identity to its declaration-order semantic facts.
// No spelling lookup and no physical layout information are involved.
عام عرف وصف_حقل_سجل_دلالي_بالاسم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختياري وصف_حقل_سجل_دلالي {
    // The definition is found once and its fields are searched in place.
    طابق موضع_حقل_سجل_بالاسم(سجل_الأنواع, المعرف, الاسم) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الموضع) -> {
        ليكن الوصف: وصف_حقل_سجل_دلالي = {
            الترتيب: الموضع.الترتيب,
            النوع: الموضع.النوع
        };
        أرجع اختياري.موجود(الوصف);
    };
}

عام عرف ترتيب_حقل_سجل_دلالي_بالاسم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختياري طبيعي {
    طابق وصف_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, المعرف, الاسم) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف.الترتيب);
    };
}

عام عرف نوع_حقل_سجل_دلالي_بالاسم(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختياري معرف_نوع {
    طابق وصف_حقل_سجل_دلالي_بالاسم(سجل_الأنواع, المعرف, الاسم) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف.النوع);
    };
}

// Resolve canonical constructor identity to semantic constructor order and payload count.
// Payload Types are queried by index below, without copying registry-owned vectors.
// The registry implementation covers named enums and builtin Option/Result forms.
عام عرف وصف_منشئ_نوع_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري وصف_منشئ_نوع_دلالي {
    طابق ترتيب_منشئ_نوع(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الترتيب) -> {
        طابق عدد_حمولات_منشئ_دلالي_عند(سجل_الأنواع, المعرف, الترتيب) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(عدد_الحمولات) -> {
            ليكن الوصف: وصف_منشئ_نوع_دلالي = {
                الترتيب: الترتيب,
                عدد_الحمولات: عدد_الحمولات
            };
            أرجع اختياري.موجود(الوصف);
        };
    };
}

عام عرف ترتيب_منشئ_نوع_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري طبيعي {
    طابق وصف_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف.الترتيب);
    };
}

عام عرف عدد_حمولات_منشئ_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري طبيعي {
    طابق وصف_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف.عدد_الحمولات);
    };
}

عام عرف نوع_حمولة_منشئ_دلالي_بالهوية_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع,
    فهرس_الحمولة: طبيعي
): اختياري معرف_نوع {
    طابق وصف_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الوصف) -> {
        أرجع نوع_حمولة_منشئ_دلالي_عند(سجل_الأنواع, المعرف, الوصف.الترتيب, فهرس_الحمولة);
    };
}

// Public semantic-query facade for Pattern and other read-only consumers.
// Registry storage remains private to Type; callers receive canonical semantic facts only.
عام عرف معرف_نوع_دلالي_صالح(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): منطقي {
    أرجع معرف_نوع_صالح(سجل_الأنواع, المعرف);
}

عام عرف اسم_منشئ_نوع_دلالي_بالهوية(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري معرف_اسم {
    طابق ترتيب_منشئ_نوع_دلالي_بالهوية(سجل_الأنواع, المعرف, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الترتيب) -> {
        طابق حقيقة_منشئ_نوع_عند(سجل_الأنواع, المعرف, الترتيب, 0) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(الحقيقة) -> {
            أرجع الحقيقة.الاسم;
        };
    };
}

// Narrow canonical queries required by lowering. They expose scalar Type identities only.
عام عرف عدد_معاملات_دالة_دلالية(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع
): اختياري طبيعي {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_4) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_4.القيمة] مع
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            أرجع اختياري.موجود(الطول(المعاملات) مثل طبيعي);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف نوع_معامل_دالة_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع, الفهرس: طبيعي
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_5) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_5.القيمة] مع
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            إذا (الفهرس >= (الطول(المعاملات) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(المعاملات[الفهرس]);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف نوع_ناتج_دالة_دلالي(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_6) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_6.القيمة] مع
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            أرجع اختياري.موجود(الناتج);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف نوع_عنصر_شريحة_دلالي(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_7) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_7.القيمة] مع
        | نوع_مقنن.شريحة(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// Named enum constructor identity is derived from the canonical Name Symbol, never spelling.
عام عرف هوية_منشئ_تعداد_دلالية_بالرمز(
    سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع, الرمز: معرف_رمز
): اختياري هوية_منشئ_نوع {
    أرجع هوية_منشئ_تعداد_بالرمز_عند(سجل_الأنواع, المعرف, الرمز);
}

// Read an already-canonical primitive Type identity without interning or mutating Type state.
عام عرف معرف_نوع_بدائي_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    البدائي: نوع_بدائي_مقنن
): اختياري معرف_نوع {
    // Primitive Type IDs are seeded in the canonical generated order by TypeRegistry.
    ليكن _حالة_الأنواع: &سجل_أنواع = سجل_الأنواع;
    أرجع اختياري.موجود(معرف_نوع_من(رقم_نوع_بدائي(البدائي)));
}

// Source-facing resolution for contextual Option/Result constructors.  The spelling
// aliases stop at this Type integration boundary; the returned identity is the
// canonical Type-owned constructor identity consumed by Pattern/MSIR.
عام عرف هوية_منشئ_مدمج_دلالية_بالأسماء(
    سياق_الأسماء: &سياق_أسماء,
    سجل_الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    اسم_النوع: معرف_اسم,
    اسم_المنشئ: معرف_اسم
): اختياري هوية_منشئ_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(مرجع_النوع_8) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_8.القيمة] مع
        | نوع_مقنن.اختيار(_) -> {
            إذا (!اسم_اختيار_مدمج(سياق_الأسماء, اسم_النوع)) {
                أرجع اختياري.لا_شيء();
            };
            إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «لا_شيء»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «none»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «None»)) {
                أرجع اختياري.موجود(هوية_منشئ_نوع.اختيار_لا_شيء());
            };
            // موجود is the canonical Arabic spelling; بعض is its deprecated alias
            // for one release (the frontend warns at each use).
            إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «موجود»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «بعض»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «some»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «Some»)) {
                أرجع اختياري.موجود(هوية_منشئ_نوع.اختيار_بعض());
            };
            أرجع اختياري.لا_شيء();
        }
        | نوع_مقنن.نتيجة(_, _) -> {
            إذا (!اسم_نتيجة_مدمجة(سياق_الأسماء, اسم_النوع)) {
                أرجع اختياري.لا_شيء();
            };
            إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «نجح»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «ok»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «Ok»)) {
                أرجع اختياري.موجود(هوية_منشئ_نوع.نتيجة_نجاح());
            };
            إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «خطأ»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «err»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, اسم_المنشئ, «Err»)) {
                أرجع اختياري.موجود(هوية_منشئ_نوع.نتيجة_خطأ());
            };
            أرجع اختياري.لا_شيء();
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// Only fixed-width primitive Types have target-independent byte sizes.
// Pointer-sized primitives, aggregates, strings and vectors require Target/Layout.
عام عرف حجم_نوع_بدائي_ثابت_بالبايتات(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري طبيعي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مرجع_النوع_9) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_9.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.ص8 -> { أرجع اختياري.موجود(1); }
            | نوع_بدائي_مقنن.ط8 -> { أرجع اختياري.موجود(1); }
            | نوع_بدائي_مقنن.ص16 -> { أرجع اختياري.موجود(2); }
            | نوع_بدائي_مقنن.ط16 -> { أرجع اختياري.موجود(2); }
            | نوع_بدائي_مقنن.ص32 -> { أرجع اختياري.موجود(4); }
            | نوع_بدائي_مقنن.ط32 -> { أرجع اختياري.موجود(4); }
            | نوع_بدائي_مقنن.ع32 -> { أرجع اختياري.موجود(4); }
            | نوع_بدائي_مقنن.ص64 -> { أرجع اختياري.موجود(8); }
            | نوع_بدائي_مقنن.ط64 -> { أرجع اختياري.موجود(8); }
            | نوع_بدائي_مقنن.ع64 -> { أرجع اختياري.موجود(8); }
            | _ -> { };
        }
        | _ -> { };
    };
    أرجع اختياري.لا_شيء();
}
