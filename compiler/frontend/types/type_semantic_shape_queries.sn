}

عام عرف عدد_حمولات_منشئ_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    فهرس_المنشئ: غير_موقع
): اختيار غير_موقع {
    طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, فهرس_المنشئ) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(المنشئ) -> {
        أرجع اختيار.بعض(عدد_حمولات_منشئ(&المنشئ));
    };
}

عام عرف نوع_حمولة_منشئ_دلالي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    فهرس_المنشئ: غير_موقع,
    فهرس_الحمولة: غير_موقع
): اختيار معرف_نوع {
    طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, فهرس_المنشئ) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(المنشئ) -> {
        أرجع حمولة_منشئ_عند(&المنشئ, فهرس_الحمولة);
    };
}

عام عرف نوع_داخل_مرجع_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار معرف_نوع {
    طابق نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.مرجع(الداخل, المتغير) -> {
            لو (المتغير) {
                أرجع اختيار.لا_شيء();
            };
            أرجع اختيار.بعض(الداخل);
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}

عام عرف نوع_داخل_مرجع_متغير_دلالي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار معرف_نوع {
    طابق نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.مرجع(الداخل, المتغير) -> {
            لو (!المتغير) {
                أرجع اختيار.لا_شيء();
            };
            أرجع اختيار.بعض(الداخل);
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}

