استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.contextual_names_generated;
استورد compiler.frontend.names.context;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.token_identity;
استورد std.text.from_bytes;
عرف ألحق_نص_عرض_نوع(الناتج: &متغير متجه غ8, النص: &نص): فراغ {
    دع القيمة: نص = *النص;
    دع البايتات: متغير متجه غ8 = *الناتج;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    *الناتج := البايتات;
}

عرف ألحق_فاصل_عرض_نوع(الناتج: &متغير متجه غ8): فراغ {
    دع الفاصل: نص = «, »;
    ألحق_نص_عرض_نوع(الناتج, &الفاصل);
}

عرف ألحق_اسم_رمز_نوع(
    الأسماء: &سياق_استعلامات_أسماء,
    الرمز: معرف_رمز,
    الناتج: &متغير متجه غ8
): منطقي {
    طابق رمز_دلالي_عند_استعلام(الأسماء, الرمز) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الحقيقة) -> {
        طابق اسم_مقنن_عند_استعلام(الأسماء, الحقيقة.الاسم) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(الاسم) -> {
            دع مرجع_البايتات: &متجه غ8 = &الاسم.البايتات;
            دع البايتات: متجه غ8 = *مرجع_البايتات;
            دع الحالة: متغير متجه غ8 = *الناتج;
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(البايتات) مثل غير_موقع)) {
                ألحق(الحالة, البايتات[ف]);
                ف := ف + 1;
            }
            *الناتج := الحالة;
            أرجع صواب;
        };
    };
}

عرف ألحق_نوع_مقنن_للعرض(
    الأنواع: &سجل_أنواع,
    الأسماء: &سياق_استعلامات_أسماء,
    المعرف: معرف_نوع,
    العمق: غير_موقع,
    الناتج: &متغير متجه غ8
): منطقي {
    لو (العمق > 64) { أرجع خطأ; };
    دع الحالة: سجل_أنواع = *الأنواع;
    لو (المعرف.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع)) { أرجع خطأ; };
    دع مرجع_النوع: &نوع_مقنن = &الحالة.الأنواع[المعرف.القيمة];
    دع النوع: نوع_مقنن = *مرجع_النوع;
    طابق النوع مع
    | نوع_مقنن.بدائي(البدائي) -> {
        دع النص: نص = تهجئة_عرض_نوع_بدائي(البدائي);
        ألحق_نص_عرض_نوع(الناتج, &النص);
        أرجع صواب;
    }
    | نوع_مقنن.معامل_نوع(الرمز) -> {
        أرجع ألحق_اسم_رمز_نوع(الأسماء, الرمز, الناتج);
    }
    | نوع_مقنن.صف(العناصر) -> {
        دع افتح: نص = تهجئة_عرض_رمز_عربية(رمز.قوس_يسار());
        دع أغلق: نص = تهجئة_عرض_رمز_عربية(رمز.قوس_يمين());
        ألحق_نص_عرض_نوع(الناتج, &افتح);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
            لو (ف > 0) { ألحق_فاصل_عرض_نوع(الناتج); };
            لو (!ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, العناصر[ف], العمق + 1, الناتج)) { أرجع خطأ; };
            ف := ف + 1;
        }
        ألحق_نص_عرض_نوع(الناتج, &أغلق);
        أرجع صواب;
    }
    | نوع_مقنن.صندوق(الداخل) -> {
        دع السابقة: نص = تهجئة_عرض_رمز_عربية(رمز.صندوق());
        دع مسافة: نص = « »;
        ألحق_نص_عرض_نوع(الناتج, &السابقة);
        ألحق_نص_عرض_نوع(الناتج, &مسافة);
        أرجع ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الداخل, العمق + 1, الناتج);
    }
    | نوع_مقنن.اختيار(الداخل) -> {
        دع السابقة: نص = تهجئة_عرض_اختيار_مدمجة();
        دع مسافة: نص = « »;
        ألحق_نص_عرض_نوع(الناتج, &السابقة);
        ألحق_نص_عرض_نوع(الناتج, &مسافة);
        أرجع ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الداخل, العمق + 1, الناتج);
    }
    | نوع_مقنن.نتيجة(النجاح, الفشل) -> {
        دع السابقة: نص = تهجئة_عرض_نتيجة_مدمجة();
        دع مسافة: نص = « »;
        ألحق_نص_عرض_نوع(الناتج, &السابقة);
        ألحق_نص_عرض_نوع(الناتج, &مسافة);
        لو (!ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, النجاح, العمق + 1, الناتج)) { أرجع خطأ; };
        ألحق_فاصل_عرض_نوع(الناتج);
        أرجع ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الفشل, العمق + 1, الناتج);
    }
    | نوع_مقنن.دالة(المعاملات, الناتج_الدالة) -> {
        دع السابقة: نص = تهجئة_عرض_رمز_عربية(رمز.نوع_دالة());
        دع افتح: نص = تهجئة_عرض_رمز_عربية(رمز.قوس_يسار());
        دع أغلق: نص = تهجئة_عرض_رمز_عربية(رمز.قوس_يمين());
        دع نقطتان: نص = تهجئة_عرض_رمز_عربية(رمز.نقطتان());
        دع مسافة: نص = « »;
        ألحق_نص_عرض_نوع(الناتج, &السابقة);
        ألحق_نص_عرض_نوع(الناتج, &افتح);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المعاملات) مثل غير_موقع)) {
            لو (ف > 0) { ألحق_فاصل_عرض_نوع(الناتج); };
            لو (!ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, المعاملات[ف], العمق + 1, الناتج)) { أرجع خطأ; };
            ف := ف + 1;
        }
        ألحق_نص_عرض_نوع(الناتج, &أغلق);
        ألحق_نص_عرض_نوع(الناتج, &نقطتان);
        ألحق_نص_عرض_نوع(الناتج, &مسافة);
        أرجع ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الناتج_الدالة, العمق + 1, الناتج);
    }
    | نوع_مقنن.مسمى(الرمز, _, الحجج) -> {
        لو (!ألحق_اسم_رمز_نوع(الأسماء, الرمز, الناتج)) { أرجع خطأ; };
        لو ((الطول(الحجج) مثل غير_موقع) == 0) { أرجع صواب; };
        دع افتح: نص = «<»;
        دع أغلق: نص = «>»;
        ألحق_نص_عرض_نوع(الناتج, &افتح);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
            لو (ف > 0) { ألحق_فاصل_عرض_نوع(الناتج); };
            لو (!ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الحجج[ف], العمق + 1, الناتج)) { أرجع خطأ; };
            ف := ف + 1;
        }
        ألحق_نص_عرض_نوع(الناتج, &أغلق);
        أرجع صواب;
    }
    | نوع_مقنن.مؤشر(الداخل) -> {
        دع السابقة: نص = تهجئة_عرض_رمز_عربية(رمز.نجمة());
        ألحق_نص_عرض_نوع(الناتج, &السابقة);
        أرجع ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الداخل, العمق + 1, الناتج);
    }
    | نوع_مقنن.مرجع(الداخل, متغير_المرجع) -> {
        دع المرجع: نص = تهجئة_عرض_رمز_عربية(رمز.و_بتي());
        ألحق_نص_عرض_نوع(الناتج, &المرجع);
        لو (متغير_المرجع) {
            دع نص_متغير: نص = تهجئة_عرض_رمز_عربية(رمز.متغير());
            دع مسافة: نص = « »;
            ألحق_نص_عرض_نوع(الناتج, &نص_متغير);
            ألحق_نص_عرض_نوع(الناتج, &مسافة);
        };
        أرجع ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الداخل, العمق + 1, الناتج);
    }
    | نوع_مقنن.شريحة(الداخل) -> {
        دع السابقة: نص = تهجئة_عرض_رمز_عربية(رمز.شريحة());
        دع مسافة: نص = « »;
        ألحق_نص_عرض_نوع(الناتج, &السابقة);
        ألحق_نص_عرض_نوع(الناتج, &مسافة);
        أرجع ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الداخل, العمق + 1, الناتج);
    }
    | نوع_مقنن.متجه(الداخل) -> {
        دع السابقة: نص = تهجئة_عرض_متجه_مدمجة();
        دع مسافة: نص = « »;
        ألحق_نص_عرض_نوع(الناتج, &السابقة);
        ألحق_نص_عرض_نوع(الناتج, &مسافة);
        أرجع ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الداخل, العمق + 1, الناتج);
    }
    | نوع_مقنن.متغير(الداخل) -> {
        دع السابقة: نص = تهجئة_عرض_رمز_عربية(رمز.متغير());
        دع مسافة: نص = « »;
        ألحق_نص_عرض_نوع(الناتج, &السابقة);
        ألحق_نص_عرض_نوع(الناتج, &مسافة);
        أرجع ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, الداخل, العمق + 1, الناتج);
    };
}

عام عرف تهجئة_عرض_نوع_دلالي(
    الأنواع: &سجل_أنواع,
    الأسماء: &سياق_استعلامات_أسماء,
    المعرف: معرف_نوع
): اختيار نص {
    دع البايتات: متغير متجه غ8 = [];
    لو (!ألحق_نوع_مقنن_للعرض(الأنواع, الأسماء, المعرف, 0, &متغير البايتات)) {
        أرجع اختيار.لا_شيء();
    };
    دع النص: نص = من_بايتات(&البايتات);
    أرجع اختيار.بعض(النص);
}
