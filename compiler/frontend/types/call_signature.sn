استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.compatibility;
استورد compiler.frontend.names.identifiers;

// Canonical function-call signature validation operates only on canonical Type IDs.
// Generic inference binds semantic Type-parameter identities to concrete argument Types,
// then validates the instantiated signature through the same compatibility owner.
عام نوع خطأ_توقيع_استدعاء =
    | غير_قابل_للاستدعاء
    | عدد_حجج_غير_مطابق بنوع (طبيعي, طبيعي)
    | نوع_حجة_غير_مطابق بنوع (طبيعي, معرف_نوع, معرف_نوع)
;

عام نوع نتيجة_توقيع_استدعاء =
    | صالح بنوع (معرف_نوع, متجه ربط_استبدال_نوع)
    | مرفوض بنوع خطأ_توقيع_استدعاء
;

عرف حجة_معامل_نوع_مستنتجة(
    الاستبدالات: &متجه ربط_استبدال_نوع,
    المعامل: معرف_رمز
): اختياري معرف_نوع {
    دع القيم: متجه ربط_استبدال_نوع = *الاستبدالات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        لو (معرفا_رمز_متساويان(القيم[ف].المعامل, المعامل)) {
            أرجع اختياري.موجود(القيم[ف].الحجة);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف استنتج_من_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المتوقع: معرف_نوع,
    الموجود: معرف_نوع,
    الاستبدالات: &متغير متجه ربط_استبدال_نوع
): منطقي {
    // Concrete subtrees do not participate in generic inference. Preserve the
    // ordinary-call conversion policy and let the canonical compatibility pass below
    // validate them after any surrounding type parameters have been substituted.
    لو (!هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, المتوقع)) {
        أرجع صواب;
    };
    طابق معرف_نوع_موجود_عند(سجل_الأنواع, المتوقع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القالب) -> {
        طابق (*سجل_الأنواع).الأنواع[القالب.القيمة] مع
        | نوع_مقنن.معامل_نوع(المعامل) -> {
            // A value read from a mutable local or place has the Type of its
            // value: the parameter binds to `T`, not to `mutable T`.
            دع القيمة: متغير معرف_نوع = الموجود;
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.موجود(الأساس) -> {
                طابق (*سجل_الأنواع).الأنواع[الأساس.القيمة] مع
                | نوع_مقنن.متغير(الداخل) -> { القيمة := الداخل; }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
            طابق حجة_معامل_نوع_مستنتجة(الاستبدالات, المعامل) مع
            | اختياري.موجود(السابقة) -> { أرجع معرفا_نوع_متساويان(السابقة, القيمة); }
            | اختياري.لا_شيء -> {
                دع الربط: ربط_استبدال_نوع = { المعامل: المعامل, الحجة: القيمة };
                ألحق(*الاستبدالات, الربط);
                أرجع صواب;
            };
        }
        | نوع_مقنن.صف(المتوقعة) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_1) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_1.القيمة] مع
                | نوع_مقنن.صف(الفعلية) -> {
                لو (الطول(المتوقعة) != الطول(الفعلية)) { أرجع خطأ; };
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(المتوقعة) مثل طبيعي)) {
                    لو (!استنتج_من_نوع(سجل_الأنواع, المتوقعة[ف], الفعلية[ف], الاستبدالات)) { أرجع خطأ; };
                    ف := ف + 1;
                }
                أرجع صواب;
            }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_2) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_2.القيمة] مع
                | نوع_مقنن.صندوق(الفعلية) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.اختيار(الداخل) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_3) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_3.القيمة] مع
                | نوع_مقنن.اختيار(الفعلية) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_4) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_4.القيمة] مع
                | نوع_مقنن.نتيجة(ج, د) -> {
                أرجع استنتج_من_نوع(سجل_الأنواع, أ, ج, الاستبدالات)
                    && استنتج_من_نوع(سجل_الأنواع, ب, د, الاستبدالات);
            }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_5) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_5.القيمة] مع
                | نوع_مقنن.دالة(الفعلية, الناتج_الفعلي) -> {
                لو (الطول(المعاملات) != الطول(الفعلية)) { أرجع خطأ; };
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
                    لو (!استنتج_من_نوع(سجل_الأنواع, المعاملات[ف], الفعلية[ف], الاستبدالات)) { أرجع خطأ; };
                    ف := ف + 1;
                }
                أرجع استنتج_من_نوع(سجل_الأنواع, الناتج, الناتج_الفعلي, الاستبدالات);
            }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, الحجج) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_6) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_6.القيمة] مع
                | نوع_مقنن.مسمى(الرمز_الفعلي, الشكل_الفعلي, الحجج_الفعلية) -> {
                لو (!معرفا_رمز_متساويان(الرمز, الرمز_الفعلي) || الطول(الحجج) != الطول(الحجج_الفعلية)) { أرجع خطأ; };
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                    لو (!استنتج_من_نوع(سجل_الأنواع, الحجج[ف], الحجج_الفعلية[ف], الاستبدالات)) { أرجع خطأ; };
                    ف := ف + 1;
                }
                أرجع صواب;
            }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_7) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_7.القيمة] مع
                | نوع_مقنن.مؤشر(الفعلية) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.مرجع(الداخل, _) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_8) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_8.القيمة] مع
                | نوع_مقنن.مرجع(الفعلية, _) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            // A (mutable) vector argument is viewed as the slice parameter.
            طابق أزل_غلاف_متغير(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_9) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_9.القيمة] مع
                | نوع_مقنن.شريحة(الفعلية) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
                // A vector argument is viewed as the slice parameter.
                | نوع_مقنن.متجه(الفعلية) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.متجه(الداخل) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_10) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_10.القيمة] مع
                | نوع_مقنن.متجه(الفعلية) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.متغير(الداخل) -> {
            طابق معرف_نوع_موجود_عند(سجل_الأنواع, الموجود) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_11) -> {
                طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_11.القيمة] مع
                | نوع_مقنن.متغير(الفعلية) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
                | _ -> { أرجع خطأ; };
            };
        }
        | نوع_مقنن.بدائي(_) -> { أرجع صواب; };
    };
}

عام عرف أضف_استبدالات_من_معامل_استدعاء(
    سجل_الأنواع: &سجل_أنواع,
    النوع_المتوقع: معرف_نوع,
    النوع_الموجود: معرف_نوع,
    الاستبدالات: &متغير متجه ربط_استبدال_نوع
): منطقي {
    أرجع استنتج_من_نوع(
        سجل_الأنواع, النوع_المتوقع, النوع_الموجود, الاستبدالات
    );
}

عام عرف استنتج_استبدالات_ناتج_استدعاء(
    سجل_الأنواع: &متغير سجل_أنواع,
    نوع_المستدعى: معرف_نوع,
    النوع_المتوقع: معرف_نوع
): متجه ربط_استبدال_نوع {
    دع الاستبدالات: متغير متجه ربط_استبدال_نوع = [];
    دع المتوقع_الأساس: متغير معرف_نوع = النوع_المتوقع;
    طابق أزل_غلاف_متغير(سجل_الأنواع, النوع_المتوقع) مع
    | اختياري.موجود(الأساس) -> { المتوقع_الأساس := الأساس; }
    | اختياري.لا_شيء -> { };
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, نوع_المستدعى) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مرجع_النوع_10) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_10.القيمة] مع
        | نوع_مقنن.دالة(_, الناتج) -> {
        لو (!استنتج_من_نوع(سجل_الأنواع, الناتج, المتوقع_الأساس, &متغير الاستبدالات)) {
            دع الفارغة: متجه ربط_استبدال_نوع = [];
            أرجع الفارغة;
        };
    }
        | _ -> { };
    };
    أرجع الاستبدالات;
}

عام عرف تحقق_توقيع_استدعاء_باستبدالات(
    سجل_الأنواع: &متغير سجل_أنواع,
    نوع_المستدعى: معرف_نوع,
    أنواع_الحجج: &متجه معرف_نوع,
    الاستبدالات_الأولية: &متجه ربط_استبدال_نوع
): نتيجة_توقيع_استدعاء {
    دع الفعلية: متجه معرف_نوع = *أنواع_الحجج;
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, نوع_المستدعى) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_توقيع_استدعاء.مرفوض(خطأ_توقيع_استدعاء.غير_قابل_للاستدعاء()); }
    | اختياري.موجود(مرجع_النوع_11) -> {
        طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_11.القيمة] مع
        | نوع_مقنن.دالة(المعاملات_المستعارة, الناتج) -> {
        // Inference interns Types (mutating the registry): copy the signature.
        دع المعاملات: متجه معرف_نوع = انسخ_مملوكا_متجه_معرف_نوع(&المعاملات_المستعارة);
        دع المتوقع: طبيعي = الطول(المعاملات) مثل طبيعي;
        دع الموجود: طبيعي = الطول(الفعلية) مثل طبيعي;
        لو (الموجود != المتوقع) {
            أرجع نتيجة_توقيع_استدعاء.مرفوض(خطأ_توقيع_استدعاء.عدد_حجج_غير_مطابق(المتوقع, الموجود));
        };
        دع الاستبدالات: متغير متجه ربط_استبدال_نوع = انسخ_مملوكا_متجه_ربط_استبدال_نوع(الاستبدالات_الأولية);
        دع ف: متغير طبيعي = 0;
        طالما (ف < المتوقع) {
            لو (!استنتج_من_نوع(سجل_الأنواع, المعاملات[ف], الفعلية[ف], &متغير الاستبدالات)) {
                أرجع نتيجة_توقيع_استدعاء.مرفوض(
                    خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(ف, المعاملات[ف], الفعلية[ف])
                );
            };
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < المتوقع) {
            دع نوع_المتوقع: معرف_نوع = استبدل_نوعا(سجل_الأنواع, المعاملات[ف], &الاستبدالات);
            دع نوع_الموجود: معرف_نوع = الفعلية[ف];
            لو (!هل_تحويل_ضمني_آمن(سجل_الأنواع, نوع_الموجود, نوع_المتوقع)
                && !هل_عرض_متجه_كشريحة(سجل_الأنواع, نوع_الموجود, نوع_المتوقع)) {
                أرجع نتيجة_توقيع_استدعاء.مرفوض(
                    خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(ف, نوع_المتوقع, نوع_الموجود)
                );
            };
            ف := ف + 1;
        }
        دع الناتج_المقنن: معرف_نوع = استبدل_نوعا(سجل_الأنواع, الناتج, &الاستبدالات);
        أرجع نتيجة_توقيع_استدعاء.صالح(الناتج_المقنن, الاستبدالات);
    }
        | _ -> { أرجع نتيجة_توقيع_استدعاء.مرفوض(خطأ_توقيع_استدعاء.غير_قابل_للاستدعاء()); };
    };
}

عام عرف تحقق_توقيع_استدعاء(
    سجل_الأنواع: &متغير سجل_أنواع,
    نوع_المستدعى: معرف_نوع,
    أنواع_الحجج: &متجه معرف_نوع
): نتيجة_توقيع_استدعاء {
    دع الاستبدالات: متجه ربط_استبدال_نوع = [];
    أرجع تحقق_توقيع_استدعاء_باستبدالات(
        سجل_الأنواع, نوع_المستدعى, أنواع_الحجج, &الاستبدالات
    );
}
