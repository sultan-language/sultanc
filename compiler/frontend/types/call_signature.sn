استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.compatibility;
استورد compiler.frontend.names.identifiers;

// Canonical function-call signature validation operates only on canonical Type IDs.
// Generic inference binds semantic Type-parameter identities to concrete argument Types,
// then validates the instantiated signature through the same compatibility owner.
عام نوع خطأ_توقيع_استدعاء =
    | غير_قابل_للاستدعاء
    | عدد_حجج_غير_مطابق بنوع (غير_موقع, غير_موقع)
    | نوع_حجة_غير_مطابق بنوع (غير_موقع, معرف_نوع, معرف_نوع)
;

عام نوع نتيجة_توقيع_استدعاء =
    | صالح بنوع (معرف_نوع, متجه ربط_استبدال_نوع)
    | مرفوض بنوع خطأ_توقيع_استدعاء
;

عرف حجة_معامل_نوع_مستنتجة(
    الاستبدالات: &متجه ربط_استبدال_نوع,
    المعامل: معرف_رمز
): اختيار معرف_نوع {
    دع القيم: متجه ربط_استبدال_نوع = *الاستبدالات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (معرفا_رمز_متساويان(القيم[ف].المعامل, المعامل)) {
            أرجع اختيار.بعض(القيم[ف].الحجة);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف استنتج_من_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المتوقع: معرف_نوع,
    الموجود: معرف_نوع,
    الاستبدالات: &متغير متجه ربط_استبدال_نوع
): منطقي {
    // Concrete subtrees do not participate in generic inference. Preserve the
    // ordinary-call conversion policy and let the canonical compatibility pass below
    // validate them after any surrounding type parameters have been substituted.
    لو (!هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, المتوقع)) {
        أرجع صواب;
    };
    طابق نوع_مقنن_خام_عند(سجل_الأنواع, المتوقع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القالب) -> {
        طابق القالب مع
        | نوع_مقنن.معامل_نوع(المعامل) -> {
            طابق حجة_معامل_نوع_مستنتجة(الاستبدالات, المعامل) مع
            | اختيار.بعض(السابقة) -> { أرجع معرفا_نوع_متساويان(السابقة, الموجود); }
            | اختيار.لا_شيء -> {
                دع الربط: ربط_استبدال_نوع = { المعامل: المعامل, الحجة: الموجود };
                دع الحالة: متغير متجه ربط_استبدال_نوع = *الاستبدالات;
                ألحق(الحالة, الربط);
                *الاستبدالات := الحالة;
                أرجع صواب;
            };
        }
        | نوع_مقنن.صف(المتوقعة) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.صف(الفعلية)) -> {
                لو (الطول(المتوقعة) != الطول(الفعلية)) { أرجع خطأ; };
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(المتوقعة) مثل غير_موقع)) {
                    لو (!استنتج_من_نوع(سجل_الأنواع, المتوقعة[ف], الفعلية[ف], الاستبدالات)) { أرجع خطأ; };
                    ف := ف + 1;
                }
                أرجع صواب;
            }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.صندوق(الفعلية)) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.اختيار(الداخل) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.اختيار(الفعلية)) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.نتيجة(ج, د)) -> {
                أرجع استنتج_من_نوع(سجل_الأنواع, أ, ج, الاستبدالات)
                    && استنتج_من_نوع(سجل_الأنواع, ب, د, الاستبدالات);
            }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.دالة(الفعلية, الناتج_الفعلي)) -> {
                لو (الطول(المعاملات) != الطول(الفعلية)) { أرجع خطأ; };
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(المعاملات) مثل غير_موقع)) {
                    لو (!استنتج_من_نوع(سجل_الأنواع, المعاملات[ف], الفعلية[ف], الاستبدالات)) { أرجع خطأ; };
                    ف := ف + 1;
                }
                أرجع استنتج_من_نوع(سجل_الأنواع, الناتج, الناتج_الفعلي, الاستبدالات);
            }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, الحجج) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.مسمى(الرمز_الفعلي, الشكل_الفعلي, الحجج_الفعلية)) -> {
                لو (!معرفا_رمز_متساويان(الرمز, الرمز_الفعلي) || الطول(الحجج) != الطول(الحجج_الفعلية)) { أرجع خطأ; };
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
                    لو (!استنتج_من_نوع(سجل_الأنواع, الحجج[ف], الحجج_الفعلية[ف], الاستبدالات)) { أرجع خطأ; };
                    ف := ف + 1;
                }
                أرجع صواب;
            }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.مؤشر(الفعلية)) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.مرجع(الداخل, _) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.مرجع(الفعلية, _)) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.شريحة(الفعلية)) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.متجه(الداخل) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.متجه(الفعلية)) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.متغير(الداخل) -> {
            طابق نوع_مقنن_خام_عند(سجل_الأنواع, الموجود) مع
            | اختيار.بعض(نوع_مقنن.متغير(الفعلية)) -> { أرجع استنتج_من_نوع(سجل_الأنواع, الداخل, الفعلية, الاستبدالات); }
            | _ -> { أرجع خطأ; };
        }
        | نوع_مقنن.بدائي(_) -> { أرجع صواب; };
    };
}

عام عرف أضف_استبدالات_من_معامل_استدعاء(
    سجل_الأنواع: &سجل_أنواع,
    النوع_المتوقع: معرف_نوع,
    النوع_الموجود: معرف_نوع,
    الاستبدالات: &متغير متجه ربط_استبدال_نوع
): منطقي {
    أرجع استنتج_من_نوع(
        سجل_الأنواع, النوع_المتوقع, النوع_الموجود, الاستبدالات
    );
}

عام عرف استنتج_استبدالات_ناتج_استدعاء(
    سجل_الأنواع: &متغير سجل_أنواع,
    نوع_المستدعى: معرف_نوع,
    النوع_المتوقع: معرف_نوع
): متجه ربط_استبدال_نوع {
    دع الاستبدالات: متغير متجه ربط_استبدال_نوع = [];
    دع المتوقع_الأساس: متغير معرف_نوع = النوع_المتوقع;
    طابق أزل_غلاف_متغير(سجل_الأنواع, النوع_المتوقع) مع
    | اختيار.بعض(الأساس) -> { المتوقع_الأساس := الأساس; }
    | اختيار.لا_شيء -> { };
    طابق نوع_أساس_عند(سجل_الأنواع, نوع_المستدعى) مع
    | اختيار.بعض(نوع_مقنن.دالة(_, الناتج)) -> {
        لو (!استنتج_من_نوع(سجل_الأنواع, الناتج, المتوقع_الأساس, &متغير الاستبدالات)) {
            دع الفارغة: متجه ربط_استبدال_نوع = [];
            أرجع الفارغة;
        };
    }
    | _ -> { };
    أرجع الاستبدالات;
}

عام عرف تحقق_توقيع_استدعاء_باستبدالات(
    سجل_الأنواع: &متغير سجل_أنواع,
    نوع_المستدعى: معرف_نوع,
    أنواع_الحجج: &متجه معرف_نوع,
    الاستبدالات_الأولية: &متجه ربط_استبدال_نوع
): نتيجة_توقيع_استدعاء {
    دع الفعلية: متجه معرف_نوع = *أنواع_الحجج;
    طابق نوع_أساس_عند(سجل_الأنواع, نوع_المستدعى) مع
    | اختيار.بعض(نوع_مقنن.دالة(المعاملات, الناتج)) -> {
        دع المتوقع: غير_موقع = الطول(المعاملات) مثل غير_موقع;
        دع الموجود: غير_موقع = الطول(الفعلية) مثل غير_موقع;
        لو (الموجود != المتوقع) {
            أرجع نتيجة_توقيع_استدعاء.مرفوض(خطأ_توقيع_استدعاء.عدد_حجج_غير_مطابق(المتوقع, الموجود));
        };
        دع الاستبدالات: متغير متجه ربط_استبدال_نوع = *الاستبدالات_الأولية;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < المتوقع) {
            لو (!استنتج_من_نوع(سجل_الأنواع, المعاملات[ف], الفعلية[ف], &متغير الاستبدالات)) {
                أرجع نتيجة_توقيع_استدعاء.مرفوض(
                    خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(ف, المعاملات[ف], الفعلية[ف])
                );
            };
            ف := ف + 1;
        }
        ف := 0;
        بينما (ف < المتوقع) {
            دع نوع_المتوقع: معرف_نوع = استبدل_نوعا(سجل_الأنواع, المعاملات[ف], &الاستبدالات);
            دع نوع_الموجود: معرف_نوع = الفعلية[ف];
            لو (!هل_تحويل_ضمني_آمن(سجل_الأنواع, نوع_الموجود, نوع_المتوقع)) {
                أرجع نتيجة_توقيع_استدعاء.مرفوض(
                    خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(ف, نوع_المتوقع, نوع_الموجود)
                );
            };
            ف := ف + 1;
        }
        دع الناتج_المقنن: معرف_نوع = استبدل_نوعا(سجل_الأنواع, الناتج, &الاستبدالات);
        أرجع نتيجة_توقيع_استدعاء.صالح(الناتج_المقنن, الاستبدالات);
    }
    | _ -> { أرجع نتيجة_توقيع_استدعاء.مرفوض(خطأ_توقيع_استدعاء.غير_قابل_للاستدعاء()); };
}

عام عرف تحقق_توقيع_استدعاء(
    سجل_الأنواع: &متغير سجل_أنواع,
    نوع_المستدعى: معرف_نوع,
    أنواع_الحجج: &متجه معرف_نوع
): نتيجة_توقيع_استدعاء {
    دع الاستبدالات: متجه ربط_استبدال_نوع = [];
    أرجع تحقق_توقيع_استدعاء_باستبدالات(
        سجل_الأنواع, نوع_المستدعى, أنواع_الحجج, &الاستبدالات
    );
}
