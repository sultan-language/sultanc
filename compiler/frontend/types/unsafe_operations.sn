// Operations that bypass memory safety need an explicit unsafe scope
// (`غير_آمن { ... }`, SULTAN_SAFETY_FLOW.md "Unsafe operations"): dereferencing
// or indexing a raw pointer, converting a raw pointer to a reference, and an
// inline assembly statement, a raw kernel call (بدائي_نداء_نواة_خام) or a
// thread clone (بدائي_استنسخ_خيط_نواة), a closure rebuilt from an address,
// which takes unchecked pointers, lengths and handles past every typed OS
// interface. The first such operation outside an unsafe scope is reported at
// its own span. Extern functions are not gated: an operation is not unsafe
// merely because it reaches the OS (std's typed OS APIs stay safe to call;
// their implementations hold the unsafe scopes).

عرف نوع_مؤشر_خام_للأمان(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// The integer literal 0 written directly before `as`: not parenthesized
// (parentheses leave no node, so the byte after the literal decides).
عرف هل_صفر_حرفي_مجرد(التعبير: &تعبير, المحتوى: &نص): منطقي {
    طابق *التعبير مع
    | تعبير.حرفي(النطاق, حرفي.عدد(القيمة)) -> {
        إذا (القيمة != 0) { أرجع خطأ; };
        أرجع !يليه_قوس_إغلاق(المحتوى, النطاق.النهاية.البايت مثل طبيعي);
    }
    | تعبير.حرفي(النطاق, حرفي.عدد_طبيعي(القيمة)) -> {
        إذا (القيمة != 0) { أرجع خطأ; };
        أرجع !يليه_قوس_إغلاق(المحتوى, النطاق.النهاية.البايت مثل طبيعي);
    }
    | _ -> { أرجع خطأ; };
}

عرف يليه_قوس_إغلاق(المحتوى: &نص, الموضع: طبيعي): منطقي {
    دع ف: متغير طبيعي = الموضع;
    دع الطول_الكلي: طبيعي = الطول(*المحتوى) مثل طبيعي;
    طالما (ف < الطول_الكلي) {
        دع البايت: ط8 = (*المحتوى)[ف];
        إذا (البايت == (0x29 مثل ط8)) { أرجع صواب; };
        إذا (البايت != (0x20 مثل ط8) && البايت != (0x09 مثل ط8) && البايت != (0x0A مثل ط8) && البايت != (0x0D مثل ط8)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف افحص_تعبيرات_للأمان(
    التعبيرات: &متجه تعبير, الأنواع: &سجل_أنواع, أنواع_التعبيرات: &سياق_أنواع_تعبيرات, الخام: &متجه نطاق, المحتوى: &نص, آمن: منطقي
): اختياري نطاق {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التعبيرات) مثل طبيعي)) {
        طابق افحص_تعبيرا_للأمان(&(*التعبيرات)[ف], الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// `آمن` is true outside any unsafe scope, where the checks apply.
عرف افحص_تعبيرا_للأمان(
    التعبير: &تعبير, الأنواع: &سجل_أنواع, أنواع_التعبيرات: &سياق_أنواع_تعبيرات, الخام: &متجه نطاق, المحتوى: &نص, آمن: منطقي
): اختياري نطاق {
    طابق *التعبير مع
    | تعبير.فك_موضع(النطاق, الداخل) -> {
        إذا (آمن) {
            طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&(*الداخل))) مع
            | اختياري.موجود(النوع) -> {
                إذا (نوع_مؤشر_خام_للأمان(الأنواع, النوع)) { أرجع اختياري.موجود(النطاق); };
            }
            | اختياري.لا_شيء -> { };
        };
        أرجع افحص_تعبيرا_للأمان(&(*الداخل), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | تعبير.حقل(_, الأصل, _) -> { أرجع افحص_تعبيرا_للأمان(&(*الأصل), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
    | تعبير.فهرس(النطاق, الأصل, الفهرس) -> {
        // `p[i]` on a raw pointer reads or writes memory the pointer only claims.
        إذا (آمن) {
            طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&(*الأصل))) مع
            | اختياري.موجود(النوع) -> {
                إذا (نوع_مؤشر_خام_للأمان(الأنواع, النوع)) { أرجع اختياري.موجود(النطاق); };
            }
            | اختياري.لا_شيء -> { };
        };
        طابق افحص_تعبيرا_للأمان(&(*الأصل), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        أرجع افحص_تعبيرا_للأمان(&(*الفهرس), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | تعبير.ثنائي(_, _, الأيسر, الأيمن) -> {
        طابق افحص_تعبيرا_للأمان(&(*الأيسر), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        أرجع افحص_تعبيرا_للأمان(&(*الأيمن), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | تعبير.أحادي(النطاق, العامل, الداخل) -> {
        إذا (آمن && (العامل == عامل_أحادي.فك())) {
            طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&(*الداخل))) مع
            | اختياري.موجود(النوع) -> {
                إذا (نوع_مؤشر_خام_للأمان(الأنواع, النوع)) { أرجع اختياري.موجود(النطاق); };
            }
            | اختياري.لا_شيء -> { };
        };
        أرجع افحص_تعبيرا_للأمان(&(*الداخل), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | تعبير.استدعاء(نطاق_الاستدعاء, المستدعى, الحجج) -> {
        إذا (آمن && نطاق_في_قائمة_للأمان(الخام, نطاق_تعبير(&(*المستدعى)))) { أرجع اختياري.موجود(نطاق_الاستدعاء); };
        طابق افحص_تعبيرا_للأمان(&(*المستدعى), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        أرجع افحص_تعبيرات_للأمان(&الحجج, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | تعبير.تحويل(النطاق, الداخل, _) -> {
        // A conversion the type rules class as unsafe (`p as &T` from a raw
        // pointer, `w as *T`, `*A as *B`, `*T as *mutable T`). The bare
        // literal `0 as *T` (null) is exempt; `(0)` and named constants are not.
        إذا (آمن && !هل_صفر_حرفي_مجرد(&(*الداخل), المحتوى)) {
            طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&(*الداخل))) مع
            | اختياري.موجود(المصدر) -> {
                طابق نوع_تعبير_عند(أنواع_التعبيرات, النطاق) مع
                | اختياري.موجود(الهدف) -> {
                    طابق صنف_تحويل_بين(الأنواع, المصدر, الهدف) مع
                    | صنف_تحويل_نوع.يتطلب_غير_آمن -> { أرجع اختياري.موجود(النطاق); }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        };
        أرجع افحص_تعبيرا_للأمان(&(*الداخل), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | تعبير.وقت_الترجمة(_, الداخل) -> { أرجع افحص_تعبيرا_للأمان(&(*الداخل), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
    | تعبير.تسلسل_وقت_الترجمة(_, العناصر) -> { أرجع افحص_تعبيرات_للأمان(&العناصر, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
    | تعبير.حرفي_متجه(_, العناصر) -> { أرجع افحص_تعبيرات_للأمان(&العناصر, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            طابق افحص_تعبيرا_للأمان(&الحقول[ف].القيمة, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
            | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    // A closure body is its own function: an enclosing unsafe scope does not cover it.
    | تعبير.إغلاق(_, _, _, الجسم) -> { أرجع افحص_تعبيرا_للأمان(&(*الجسم), الأنواع, أنواع_التعبيرات, الخام, المحتوى, صواب); }
    // A writable global that is not a scalar (see عوالم_متغيرة_غير_سلمية_في_وحدة).
    | تعبير.اسم(النطاق, _) -> {
        إذا (آمن && نطاق_في_قائمة_للأمان(الخام, النطاق)) { أرجع اختياري.موجود(النطاق); };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف افحص_كتلة_للأمان(
    الكتلة: &كتلة_عبارات, الأنواع: &سجل_أنواع, أنواع_التعبيرات: &سياق_أنواع_تعبيرات, الخام: &متجه نطاق, المحتوى: &نص, آمن: منطقي
): اختياري نطاق {
    دع العبارات: &متجه صندوق عبارة = &(*الكتلة).العبارات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العبارات) مثل طبيعي)) {
        طابق افحص_عبارة_للأمان(&(*(*العبارات)[ف]), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف افحص_تعبيرين_للأمان(
    الأول: &تعبير, الثاني: &تعبير, الأنواع: &سجل_أنواع, أنواع_التعبيرات: &سياق_أنواع_تعبيرات, الخام: &متجه نطاق, المحتوى: &نص, آمن: منطقي
): اختياري نطاق {
    طابق افحص_تعبيرا_للأمان(الأول, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
    | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
    | اختياري.لا_شيء -> { };
    أرجع افحص_تعبيرا_للأمان(الثاني, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
}

عرف افحص_عبارة_للأمان(
    العبارة: &عبارة, الأنواع: &سجل_أنواع, أنواع_التعبيرات: &سياق_أنواع_تعبيرات, الخام: &متجه نطاق, المحتوى: &نص, آمن: منطقي
): اختياري نطاق {
    طابق *العبارة مع
    | عبارة.تهيئة_سجل(_, الهدف, الحقول) -> {
        طابق افحص_تعبيرا_للأمان(&الهدف, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            طابق افحص_تعبيرا_للأمان(&الحقول[ف].القيمة, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
            | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | عبارة.تهيئة_صف(_, الهدف, القيم) -> {
        طابق افحص_تعبيرا_للأمان(&الهدف, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        أرجع افحص_تعبيرات_للأمان(&القيم, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | عبارة.تهيئة_متجه(_, الهدف, القيم) -> {
        طابق افحص_تعبيرا_للأمان(&الهدف, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        أرجع افحص_تعبيرات_للأمان(&القيم, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | عبارة.تهيئة_نص(_, الهدف, _) -> { أرجع افحص_تعبيرا_للأمان(&الهدف, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
    | عبارة.تهيئة_صندوق(_, الهدف, القيمة) -> { أرجع افحص_تعبيرين_للأمان(&الهدف, &القيمة, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
    | عبارة.نسخ(_, الهدف, القيمة) -> { أرجع افحص_تعبيرين_للأمان(&الهدف, &القيمة, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
    | عبارة.استدعاء(_, التعبير) -> { أرجع افحص_تعبيرا_للأمان(&التعبير, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
    | عبارة.طالما(_, الشرط, الجسم) -> {
        طابق افحص_تعبيرا_للأمان(&الشرط, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        أرجع افحص_كتلة_للأمان(&الجسم, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | عبارة.لكل(_, البداية, الشرط, الخطوة, الجسم) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البداية) مثل طبيعي)) {
            طابق افحص_عبارة_للأمان(&(*البداية[ف]), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
            | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        طابق افحص_تعبيرا_للأمان(&الشرط, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        طابق افحص_عبارة_للأمان(&(*الخطوة), الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        أرجع افحص_كتلة_للأمان(&الجسم, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | عبارة.إذا(_, الشرط, الأولى, الثانية) -> {
        طابق افحص_تعبيرا_للأمان(&الشرط, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        طابق افحص_كتلة_للأمان(&الأولى, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        طابق الثانية مع
        | اختياري.موجود(البديلة) -> { أرجع افحص_كتلة_للأمان(&البديلة, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | عبارة.طابق(_, المميز, الأذرع) -> {
        طابق افحص_تعبيرا_للأمان(&المميز, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأذرع) مثل طبيعي)) {
            طابق افحص_كتلة_للأمان(&الأذرع[ف].الجسم, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
            | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | عبارة.أرجع(_, القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(التعبير) -> { أرجع افحص_تعبيرا_للأمان(&التعبير, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | عبارة.تجميع(النطاق, _) -> {
        إذا (آمن) { أرجع اختياري.موجود(النطاق); };
        أرجع اختياري.لا_شيء();
    }
    | عبارة.غير_آمن(_, الجسم) -> { أرجع افحص_كتلة_للأمان(&الجسم, الأنواع, أنواع_التعبيرات, الخام, المحتوى, خطأ); }
    | عبارة.وقت_الترجمة(_, الجسم) -> { أرجع افحص_كتلة_للأمان(&الجسم, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن); }
    | عبارة.إسناد_وقت_الترجمة(_, الهدف, الجسم, الناتج) -> {
        طابق افحص_تعبيرين_للأمان(&الهدف, &الناتج, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        أرجع افحص_كتلة_للأمان(&الجسم, الأنواع, أنواع_التعبيرات, الخام, المحتوى, آمن);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف نطاق_في_قائمة_للأمان(القائمة: &متجه نطاق, النطاق: نطاق): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (نطاقان_متساويان((*القائمة)[ف], النطاق)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The name occurrences that resolve to the raw kernel-call primitive (the
// callee spans of its calls; the primitive is not a value, so every
// occurrence is a call's callee).
عرف نداءات_نواة_خام_في_وحدة(
    الروابط: &سياق_روابط_أسماء, سياق_الأسماء: &سياق_أسماء
): متجه نطاق {
    دع الناتج: متغير متجه نطاق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الروابط).الظهورات) مثل طبيعي)) {
        طابق (*الروابط).الظهورات[ف].الرمز مع
        | اختياري.موجود(الرمز) -> {
            طابق هوية_بدائي_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختياري.موجود(الهوية) -> {
                طابق الهوية مع
                | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                    ألحق(الناتج, (*الروابط).الظهورات[ف].النطاق);
                }
                // A thread clone runs code on a stack the caller supplies, and
                // a closure rebuilt from an address claims an environment.
                | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> {
                    ألحق(الناتج, (*الروابط).الظهورات[ف].النطاق);
                }
                | هوية_بدائي_مترجم.دالة_من_عنوان -> {
                    ألحق(الناتج, (*الروابط).الظهورات[ف].النطاق);
                }
                // A C call at an address trusts the address and its signature.
                | هوية_بدائي_مترجم.نداء_عنوان_سي -> {
                    ألحق(الناتج, (*الروابط).الظهورات[ف].النطاق);
                }
                // A leaked box yields a never-reclaimed, freely aliased raw
                // pointer; its creation is gated like other raw-pointer work.
                | هوية_بدائي_مترجم.سرب_قيمة -> {
                    ألحق(الناتج, (*الروابط).الظهورات[ف].النطاق);
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The uses of writable globals whose Type is not a scalar (a vector, text, a
// record, ...), as Rust's `static mut`: any function may change such a global
// while another one holds a reference into it (an append can move its
// buffer), which SSF, tracking locals, cannot see. Every use is therefore an
// unsafe operation; a writable scalar global (a counter, a flag, a word) is
// read and written by value and stays safe.
عرف عوالم_متغيرة_غير_سلمية_في_وحدة(
    الروابط: &سياق_روابط_أسماء, سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع, أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): متجه نطاق {
    دع الناتج: متغير متجه نطاق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الروابط).الظهورات) مثل طبيعي)) {
        طابق (*الروابط).الظهورات[ف].الرمز مع
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختياري.موجود(نوع_تصريح.قيمة_عليا) -> {
                طابق نوع_تعبير_عند(أنواع_التعبيرات, (*الروابط).الظهورات[ف].النطاق) مع
                | اختياري.موجود(النوع) -> {
                    إذا (عالمي_متغير_غير_سلمي_للأمان(الأنواع, النوع)) {
                        ألحق(الناتج, (*الروابط).الظهورات[ف].النطاق);
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف عالمي_متغير_غير_سلمي_للأمان(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    دع الداخل: معرف_نوع;
    طابق أزل_غلاف_متغير(الأنواع, النوع) مع
    | اختياري.موجود(القيمة) -> { الداخل := القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    إذا (معرفا_نوع_متساويان(الداخل, النوع)) { أرجع خطأ; };
    إذا (نوع_مؤشر_خام_للأمان(الأنواع, الداخل)) { أرجع خطأ; };
    طابق نوع_بدائي_عند_للأمان(الأنواع, الداخل) مع
    | اختياري.موجود(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.نص(); }
    | اختياري.لا_شيء -> { أرجع صواب; };
}

عرف نوع_بدائي_عند_للأمان(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري نوع_بدائي_مقنن {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> { أرجع اختياري.موجود(البدائي); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// The first unsafe operation outside an unsafe scope, in unit order.
عام عرف أول_عملية_غير_آمنة_في_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    الروابط: &متجه سياق_روابط_أسماء,
    سياق_الأسماء: &سياق_أسماء,
    المصادر: &خريطة_مصادر
): اختياري نطاق {
    دع بلا_محتوى: نص = «»;
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي) && و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        دع العناصر: &متجه عنصر_وحدة = &(*الوحدات)[و].العناصر;
        دع معرف_المصدر: طبيعي = (*الوحدات)[و].معرف_المصدر;
        دع محتوى_الوحدة: متغير &نص = &بلا_محتوى;
        إذا (معرف_المصدر < (الطول((*المصادر).المصادر) مثل طبيعي)) {
            محتوى_الوحدة := &(*المصادر).المصادر[معرف_المصدر].المحتوى;
        };
        دع أنواع_الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع خام_الوحدة: متغير متجه نطاق = [];
        إذا (و < (الطول(*الروابط) مثل طبيعي)) {
            خام_الوحدة := نداءات_نواة_خام_في_وحدة(&(*الروابط)[و], سياق_الأسماء);
            دع العوالم: متجه نطاق = عوالم_متغيرة_غير_سلمية_في_وحدة(
                &(*الروابط)[و], سياق_الأسماء, الأنواع, أنواع_الوحدة
            );
            دع ع_عالمي: متغير طبيعي = 0;
            طالما (ع_عالمي < (الطول(العوالم) مثل طبيعي)) { ألحق(خام_الوحدة, العوالم[ع_عالمي]); ع_عالمي := ع_عالمي + 1; }
        };
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول(*العناصر) مثل طبيعي)) {
            طابق (*العناصر)[ع] مع
            | عنصر_وحدة.دالة(التصريح) -> {
                طابق التصريح.الجسم مع
                | اختياري.موجود(الجسم) -> {
                    طابق افحص_كتلة_للأمان(&الجسم, الأنواع, أنواع_الوحدة, &خام_الوحدة, محتوى_الوحدة, صواب) مع
                    | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | عنصر_وحدة.قيمة_عليا(التصريح) -> {
                طابق التصريح.التهيئة مع
                | تهيئة_قيمة_عليا.تعبير(التعبير) -> {
                    طابق افحص_تعبيرا_للأمان(&التعبير, الأنواع, أنواع_الوحدة, &خام_الوحدة, محتوى_الوحدة, صواب) مع
                    | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
                    | اختياري.لا_شيء -> { };
                }
                | تهيئة_قيمة_عليا.متجه(القيم) -> {
                    طابق افحص_تعبيرات_للأمان(&القيم, الأنواع, أنواع_الوحدة, &خام_الوحدة, محتوى_الوحدة, صواب) مع
                    | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            }
            | _ -> { };
            ع := ع + 1;
        }
        و := و + 1;
    }
    أرجع اختياري.لا_شيء();
}
