استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.compatibility;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_semantic_contract;
استورد compiler.frontend.memory.memory_classification;

// Frontend Type owns exact language-Type legality for compiler primitive calls.
// Runtime owns primitive identity, broad arity/result/effect contracts, and service mapping.
عام نوع خطأ_استدعاء_بدائي =
    | عدد_حجج_غير_مطابق بنوع (طبيعي, طبيعي)
    | نوع_حجة_غير_مطابق بنوع (طبيعي, معرف_نوع, معرف_نوع)
    | نوع_حجة_غير_صالح بنوع (طبيعي, معرف_نوع)
    | دلالة_مصدرية_غير_متاحة
;

// Canonical primitive argument/result Type legality lives here in the Type owner.
// Runtime supplies only primitive identity and broad arity/result/effect categories.
عام نوع أنواع_استدعاء_بدائي_مقننة = {
    النص: معرف_نوع,
    العدد: معرف_نوع,
    عدد_ط32: معرف_نوع,
    عدد_ط64: معرف_نوع,
    عائم_ع32: معرف_نوع,
    عائم_ع64: معرف_نوع,
    عدد_طبيعي: معرف_نوع
};

عام نوع نتيجة_استدعاء_بدائي =
    | صالح بنوع فئة_ناتج_بدائي
    | مرفوض بنوع خطأ_استدعاء_بدائي
;

عرف تحقق_حجة_مطابقة(
    الأنواع: &سجل_أنواع,
    الفهرس: طبيعي,
    الموجود: معرف_نوع,
    المتوقع: معرف_نوع,
    يتطلب_تطابقا_مقننا: منطقي
): اختياري خطأ_استدعاء_بدائي {
    دع مطابق: متغير منطقي = هل_تحويل_ضمني_آمن(الأنواع, الموجود, المتوقع);
    لو (يتطلب_تطابقا_مقننا) {
        مطابق := معرفا_نوع_متساويان(الموجود, المتوقع);
    };
    لو (!مطابق) {
        أرجع اختياري.موجود(
            خطأ_استدعاء_بدائي.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود)
        );
    };
    أرجع اختياري.لا_شيء();
}

عرف عنصر_متجه_عند(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مرجع_النوع_22) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_22.القيمة] مع
        | نوع_مقنن.متجه(العنصر) -> { أرجع اختياري.موجود(العنصر); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف هل_نص_أو_متجه(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    النص: معرف_نوع,
    يتطلب_تطابقا_مقننا: منطقي
): منطقي {
    دع مطابق_النص: متغير منطقي = نوعان_متوافقان(الأنواع, النوع, النص);
    لو (يتطلب_تطابقا_مقننا) {
        مطابق_النص := معرفا_نوع_متساويان(النوع, النص);
    };
    لو (مطابق_النص) {
        أرجع صواب;
    };
    طابق عنصر_متجه_عند(الأنواع, النوع) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { };
    // A slice view has a length like the sequence it views.
    طابق نوع_عنصر_شريحة_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف هل_عنصر_متجه_مطابق(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المتوقع: معرف_نوع,
    يتطلب_تطابقا_مقننا: منطقي
): منطقي {
    طابق عنصر_متجه_عند(الأنواع, النوع) مع
    | اختياري.موجود(العنصر) -> {
        لو (يتطلب_تطابقا_مقننا) {
            أرجع معرفا_نوع_متساويان(العنصر, المتوقع);
        };
        أرجع نوعان_متوافقان(الأنواع, العنصر, المتوقع);
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف هل_مرجع_لبدائي_انعكاس(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(مرجع_النوع_23) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_23.القيمة] مع
        | نوع_مقنن.مرجع(_, _) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// Read the already-canonical primitive Type IDs without creating Type state.
عام عرف أنواع_استدعاء_بدائي_مقننة_من_سجل(
    الأنواع: &سجل_أنواع
): اختياري أنواع_استدعاء_بدائي_مقننة {
    دع النص: متغير معرف_نوع = معرف_نوع_من(0);
    دع العدد: متغير معرف_نوع = معرف_نوع_من(0);
    دع عدد_ط32: متغير معرف_نوع = معرف_نوع_من(0);
    دع عدد_ط64: متغير معرف_نوع = معرف_نوع_من(0);
    دع عائم_ع32: متغير معرف_نوع = معرف_نوع_من(0);
    دع عائم_ع64: متغير معرف_نوع = معرف_نوع_من(0);
    دع عدد_طبيعي: متغير معرف_نوع = معرف_نوع_من(0);
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.طبيعي()) مع
    | اختياري.موجود(المعرف) -> { عدد_طبيعي := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.نص()) مع
    | اختياري.موجود(المعرف) -> { النص := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(المعرف) -> { العدد := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
    | اختياري.موجود(المعرف) -> { عدد_ط32 := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
    | اختياري.موجود(المعرف) -> { عدد_ط64 := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ع32()) مع
    | اختياري.موجود(المعرف) -> { عائم_ع32 := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ع64()) مع
    | اختياري.موجود(المعرف) -> { عائم_ع64 := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع الناتج: أنواع_استدعاء_بدائي_مقننة = {
        النص: النص,
        العدد: العدد,
        عدد_ط32: عدد_ط32,
        عدد_ط64: عدد_ط64,
        عائم_ع32: عائم_ع32,
        عائم_ع64: عائم_ع64,
        عدد_طبيعي: عدد_طبيعي
    };
    أرجع اختياري.موجود(الناتج);
}

// The Type a reference argument refers to (atomics read and write it).
عرف هدف_مرجع_لبدائي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مرجع(الداخل, _) -> { أرجع اختياري.موجود(الداخل); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// An atomic primitive's first operand: a reference (mutable unless the
// primitive only loads) to a 32- or 64-bit integer, or to a pointer-sized
// one (عدد / طبيعي), the widths every backend has an atomic instruction for.
عرف هل_مرجع_ذري_لبدائي(الأنواع: &سجل_أنواع, النوع: معرف_نوع, للقراءة_فقط: منطقي): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مرجع(الداخل, متغير_المرجع) -> {
            لو (!متغير_المرجع && !للقراءة_فقط) { أرجع خطأ; };
            طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, الداخل) مع
            | اختياري.موجود(الحجم) -> {
                لو (!هل_نوع_صحيح_لبدائي_ملتف(الأنواع, الداخل)) { أرجع خطأ; };
                أرجع الحجم == 4 || الحجم == 8;
            }
            | اختياري.لا_شيء -> {
                طابق معرف_نوع_أساس_عند(الأنواع, الداخل) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(أساس_الداخل) -> {
                    طابق (*الأنواع).الأنواع[أساس_الداخل.القيمة] مع
                    | نوع_مقنن.بدائي(البدائي) -> {
                        أرجع البدائي == نوع_بدائي_مقنن.عدد() || البدائي == نوع_بدائي_مقنن.طبيعي();
                    }
                    | _ -> { أرجع خطأ; };
                };
            };
        }
        | _ -> { أرجع خطأ; };
    };
}

// The payload Type of a box argument.
عرف حمولة_صندوق_لبدائي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.صندوق(الداخل) -> { أرجع اختياري.موجود(الداخل); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// Whether a Type is a function Type (a closure value).
عرف هل_نوع_دالة_لبدائي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.دالة(_, _) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// A machine-word operand of the thread clone: an unsigned 64-bit integer or
// a raw pointer.
عرف هل_وسيطة_نواة_لبدائي(الأنواع: &سجل_أنواع, الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة, النوع: معرف_نوع): منطقي {
    لو (نوعان_متوافقان(الأنواع, النوع, (*الأنواع_المقننة).عدد_ط64)) { أرجع صواب; };
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// Contextual positions expose an exact Type only when the primitive contract determines
// one uniquely. Polymorphic container positions remain relational and are checked below.
عام عرف نوع_حجة_بدائية_متوقعة(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الهوية: هوية_بدائي_مترجم,
    الفهرس: طبيعي,
    أنواع_الحجج_السابقة: &متجه معرف_نوع
): اختياري معرف_نوع {
    دع القيم: أنواع_استدعاء_بدائي_مقننة = *الأنواع_المقننة;
    دع السابقة: متجه معرف_نوع = *أنواع_الحجج_السابقة;
    طابق الهوية مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> {
        // Kernel number is fixed. Each machine-word argument may be an
        // unsigned integer or a raw pointer; constrain it relationally below.
        لو (الفهرس == 0) { أرجع اختياري.موجود(القيم.عدد_ط64); };
    }
    | هوية_بدائي_مترجم.بتات_ع64 -> { لو (الفهرس == 0) { أرجع اختياري.موجود(القيم.عائم_ع64); }; }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { لو (الفهرس == 0) { أرجع اختياري.موجود(القيم.عدد_ط64); }; }
    | هوية_بدائي_مترجم.بتات_ع32 -> { لو (الفهرس == 0) { أرجع اختياري.موجود(القيم.عائم_ع32); }; }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { لو (الفهرس == 0) { أرجع اختياري.موجود(القيم.عدد_ط32); }; }
    // Linear-memory operands are all u32 (wasm32 addresses, lengths, words).
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> { أرجع اختياري.موجود(القيم.عدد_ط32); }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> { أرجع اختياري.موجود(القيم.عدد_ط32); }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> { أرجع اختياري.موجود(القيم.عدد_ط32); }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> { أرجع اختياري.موجود(القيم.عدد_ط32); }
    // Machine-memory operands are u64 (64-bit addresses and words).
    | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> { أرجع اختياري.موجود(القيم.عدد_ط64); }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> { أرجع اختياري.موجود(القيم.عدد_ط64); }
    // Truncate takes the new length as a طبيعي (Rust's usize); the glue's
    // length store takes the length's own Type.
    | هوية_بدائي_مترجم.اقتطاع_متجه -> { لو (الفهرس == 1) { أرجع اختياري.موجود(القيم.عدد_طبيعي); }; }
    // Reserve takes the additional count as a طبيعي (Rust's usize).
    | هوية_بدائي_مترجم.حجز_سعة_متجه -> { لو (الفهرس == 1) { أرجع اختياري.موجود(القيم.عدد_طبيعي); }; }
    | هوية_بدائي_مترجم.ضبط_طول_متجه -> { لو (الفهرس == 1) { أرجع اختياري.موجود(القيم.العدد); }; }
    | هوية_بدائي_مترجم.إلحاق -> {
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) {
            أرجع عنصر_متجه_عند(الأنواع, السابقة[0]);
        };
    }
    | هوية_بدائي_مترجم.جمع_ملتف -> {
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع اختياري.موجود(السابقة[0]); };
    }
    | هوية_بدائي_مترجم.طرح_ملتف -> {
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع اختياري.موجود(السابقة[0]); };
    }
    | هوية_بدائي_مترجم.ضرب_ملتف -> {
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع اختياري.موجود(السابقة[0]); };
    }
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> {
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع اختياري.موجود(السابقة[0]); };
    }
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> {
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع اختياري.موجود(السابقة[0]); };
    }
    // Every operand of a float operation has the first operand's Type.
    | هوية_بدائي_مترجم.عملية_عائمة(_) -> {
        لو ((الفهرس >= 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع اختياري.موجود(السابقة[0]); };
    }
    // Atomics: the value operands have the referenced integer's Type; the
    // memory orderings are u32 codes.
    | هوية_بدائي_مترجم.ذري_حمل -> { لو (الفهرس == 1) { أرجع اختياري.موجود(القيم.عدد_ط32); }; }
    | هوية_بدائي_مترجم.ذري_خزن -> {
        لو (الفهرس == 2) { أرجع اختياري.موجود(القيم.عدد_ط32); };
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع هدف_مرجع_لبدائي(الأنواع, السابقة[0]); };
    }
    | هوية_بدائي_مترجم.ذري_تبديل -> {
        لو (الفهرس == 2) { أرجع اختياري.موجود(القيم.عدد_ط32); };
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع هدف_مرجع_لبدائي(الأنواع, السابقة[0]); };
    }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> {
        لو (الفهرس == 2) { أرجع اختياري.موجود(القيم.عدد_ط32); };
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع هدف_مرجع_لبدائي(الأنواع, السابقة[0]); };
    }
    | هوية_بدائي_مترجم.ذري_جلب_و -> {
        لو (الفهرس == 2) { أرجع اختياري.موجود(القيم.عدد_ط32); };
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع هدف_مرجع_لبدائي(الأنواع, السابقة[0]); };
    }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> {
        لو (الفهرس == 2) { أرجع اختياري.موجود(القيم.عدد_ط32); };
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع هدف_مرجع_لبدائي(الأنواع, السابقة[0]); };
    }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> {
        لو (الفهرس == 2) { أرجع اختياري.موجود(القيم.عدد_ط32); };
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع هدف_مرجع_لبدائي(الأنواع, السابقة[0]); };
    }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> {
        لو (الفهرس >= 3) { أرجع اختياري.موجود(القيم.عدد_ط32); };
        لو ((الفهرس >= 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) { أرجع هدف_مرجع_لبدائي(الأنواع, السابقة[0]); };
    }
    | هوية_بدائي_مترجم.سياج_ذاكرة -> { أرجع اختياري.موجود(القيم.عدد_ط32); }
    | هوية_بدائي_مترجم.دالة_من_عنوان -> { أرجع اختياري.موجود(القيم.عدد_ط64); }
    | هوية_بدائي_مترجم.مدخل_سي_لدالة -> { أرجع اختياري.موجود(القيم.عدد_ط64); }
    | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> { لو (الفهرس == 0) { أرجع اختياري.موجود(القيم.عدد_ط64); }; }
    // The C call at an address: the address and eight integer words are
    // ط64, the eight float words ع64; the result witness (0) is checked below.
    | هوية_بدائي_مترجم.نداء_عنوان_سي -> {
        لو (الفهرس >= 1 && الفهرس <= 9) { أرجع اختياري.موجود(القيم.عدد_ط64); };
        لو (الفهرس >= 10) { أرجع اختياري.موجود(القيم.عائم_ع64); };
    }
    // The compile-time failure message is text.
    | هوية_بدائي_مترجم.فشل_وقت_الترجمة -> { لو (الفهرس == 0) { أرجع اختياري.موجود(القيم.النص); }; }
    | هوية_بدائي_مترجم.تبديل_موضعين -> {
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل طبيعي) >= 1)) {
            أرجع اختياري.موجود(السابقة[0]);
        };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// The operands of the wrapping arithmetic primitives: an integer Type
// (signed or unsigned, any width), as Rust's wrapping_* methods.
عرف هل_نوع_صحيح_لبدائي_ملتف(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق أزل_غلاف_متغير(الأنواع, النوع) مع
    | اختياري.موجود(المعرف) -> {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
        | اختياري.موجود(الوصف) -> {
            طابق الوصف.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
                أرجع الصنف == صنف_نوع_بدائي.عدد_موقع() || الصنف == صنف_نوع_بدائي.عدد_صحيح_طبيعي();
            }
            | _ -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The operands of the float operations: f32 or f64.
عرف هل_نوع_عائم_لبدائي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق أزل_غلاف_متغير(الأنواع, النوع) مع
    | اختياري.موجود(المعرف) -> {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
        | اختياري.موجود(الوصف) -> {
            طابق الوصف.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري();
            }
            | _ -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف تحقق_استدعاء_بدائي_داخلي(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الهوية: هوية_بدائي_مترجم,
    أنواع_الحجج: &متجه معرف_نوع,
    يتطلب_تطابقا_مقننا: منطقي
): نتيجة_استدعاء_بدائي {
    دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(الهوية);
    دع الفعلية: متجه معرف_نوع = *أنواع_الحجج;
    دع القيم: أنواع_استدعاء_بدائي_مقننة = *الأنواع_المقننة;
    دع الموجود: طبيعي = الطول(الفعلية) مثل طبيعي;
    لو (الموجود != العقد.عدد_الحجج) {
        أرجع نتيجة_استدعاء_بدائي.مرفوض(
            خطأ_استدعاء_بدائي.عدد_حجج_غير_مطابق(العقد.عدد_الحجج, الموجود)
        );
    };

    // Fixed/contextual expected Types are owned once by نوع_حجة_بدائية_متوقعة.
    دع السابقة: متغير متجه معرف_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الموجود) {
        طابق نوع_حجة_بدائية_متوقعة(الأنواع, الأنواع_المقننة, الهوية, ف, &السابقة) مع
        | اختياري.موجود(المتوقع) -> {
            طابق تحقق_حجة_مطابقة(
                الأنواع, ف, الفعلية[ف], المتوقع, يتطلب_تطابقا_مقننا
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_استدعاء_بدائي.مرفوض(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        ألحق(السابقة, الفعلية[ف]);
        ف := ف + 1;
    }

    // Only genuinely polymorphic/structural relations remain here.
    طابق الهوية مع
    | هوية_بدائي_مترجم.نداء_عنوان_سي -> {
        // The result witness names the C result class: ط64 or ع64.
        لو (!نوعان_متوافقان(الأنواع, الفعلية[0], القيم.عدد_ط64)
            && !نوعان_متوافقان(الأنواع, الفعلية[0], القيم.عائم_ع64)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.نداء_نواة_خام -> {
        دع موضع: متغير طبيعي = 1;
        طالما (موضع < 7) {
            // A mutable binding of ط64 (`متغير ط64`) is the same machine word.
            لو (!نوعان_متوافقان(الأنواع, الفعلية[موضع], القيم.عدد_ط64)) {
                طابق معرف_نوع_أساس_عند(الأنواع, الفعلية[موضع]) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_استدعاء_بدائي.مرفوض(
                        خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(موضع, الفعلية[موضع])
                    );
                }
                | اختياري.موجود(مرجع_النوع_24) -> {
                    طابق (*الأنواع).الأنواع[مرجع_النوع_24.القيمة] مع
                    | نوع_مقنن.مؤشر(_) -> { }
                    | نوع_مقنن.مرجع(العنصر, _) -> {
                    // A borrowed fixed-width scalar can be lowered into a
                    // provenance-bearing raw pointer. No arbitrary integer or
                    // borrowed aggregate gains a buffer contract this way.
                    طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, العنصر) مع
                    | اختياري.موجود(_) -> { }
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_استدعاء_بدائي.مرفوض(
                            خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(موضع, الفعلية[موضع])
                        );
                    };
                }
                    | _ -> {
                    أرجع نتيجة_استدعاء_بدائي.مرفوض(
                        خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(موضع, الفعلية[موضع])
                    );
                };
                };
            };
            موضع := موضع + 1;
        }
    }
    // Reflection reads the type a reference refers to; any type may be
    // referenced, so only the reference shape is required.
    | هوية_بدائي_مترجم.حجم_النوع -> {
        لو (!هل_مرجع_لبدائي_انعكاس(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.محاذاة_النوع -> {
        لو (!هل_مرجع_لبدائي_انعكاس(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> {
        لو (!هل_مرجع_لبدائي_انعكاس(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> {
        لو (!هل_مرجع_لبدائي_انعكاس(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.عملية_عائمة(_) -> {
        لو (!هل_نوع_عائم_لبدائي(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
        دع موضع_المعامل: متغير طبيعي = 1;
        طالما (موضع_المعامل < (الطول(الفعلية) مثل طبيعي)) {
            طابق تحقق_حجة_مطابقة(الأنواع, موضع_المعامل, الفعلية[موضع_المعامل], الفعلية[0], صواب) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_استدعاء_بدائي.مرفوض(الخطأ); }
            | اختياري.لا_شيء -> { };
            موضع_المعامل := موضع_المعامل + 1;
        }
    }
    | هوية_بدائي_مترجم.جمع_ملتف -> {
        لو (!هل_نوع_صحيح_لبدائي_ملتف(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.طرح_ملتف -> {
        لو (!هل_نوع_صحيح_لبدائي_ملتف(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ضرب_ملتف -> {
        لو (!هل_نوع_صحيح_لبدائي_ملتف(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> {
        لو (!هل_نوع_صحيح_لبدائي_ملتف(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> {
        لو (!هل_نوع_صحيح_لبدائي_ملتف(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ذري_حمل -> {
        لو (!هل_مرجع_ذري_لبدائي(الأنواع, الفعلية[0], صواب)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ذري_خزن -> {
        لو (!هل_مرجع_ذري_لبدائي(الأنواع, الفعلية[0], صواب)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ذري_تبديل -> {
        لو (!هل_مرجع_ذري_لبدائي(الأنواع, الفعلية[0], صواب)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> {
        لو (!هل_مرجع_ذري_لبدائي(الأنواع, الفعلية[0], صواب)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> {
        لو (!هل_مرجع_ذري_لبدائي(الأنواع, الفعلية[0], صواب)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ذري_جلب_و -> {
        لو (!هل_مرجع_ذري_لبدائي(الأنواع, الفعلية[0], صواب)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> {
        لو (!هل_مرجع_ذري_لبدائي(الأنواع, الفعلية[0], صواب)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> {
        لو (!هل_مرجع_ذري_لبدائي(الأنواع, الفعلية[0], صواب)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.عنوان_دالة -> {
        لو (!هل_نوع_دالة_لبدائي(الأنواع, الفعلية[0])) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    // Leaking takes a box (its cell is never freed).
    | هوية_بدائي_مترجم.سرب_قيمة -> {
        طابق حمولة_صندوق_لبدائي(الأنواع, الفعلية[0]) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> {
        دع موضع_الخيط: متغير طبيعي = 1;
        طالما (موضع_الخيط < 7) {
            لو (!هل_وسيطة_نواة_لبدائي(الأنواع, الأنواع_المقننة, الفعلية[موضع_الخيط])) {
                أرجع نتيجة_استدعاء_بدائي.مرفوض(
                    خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(موضع_الخيط, الفعلية[موضع_الخيط])
                );
            };
            موضع_الخيط := موضع_الخيط + 1;
        }
    }
    | هوية_بدائي_مترجم.طول -> {
        لو (!هل_نص_أو_متجه(الأنواع, الفعلية[0], القيم.النص, يتطلب_تطابقا_مقننا)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
            );
        };
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        طابق عنصر_متجه_عند(الأنواع, الفعلية[0]) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
            );
        };
    }
    | هوية_بدائي_مترجم.إزالة_الأخير -> {
        طابق عنصر_متجه_عند(الأنواع, الفعلية[0]) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.اقتطاع_متجه -> {
        طابق عنصر_متجه_عند(الأنواع, الفعلية[0]) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.سعة_متجه -> {
        طابق عنصر_متجه_عند(الأنواع, الفعلية[0]) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.حجز_سعة_متجه -> {
        طابق عنصر_متجه_عند(الأنواع, الفعلية[0]) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.ضبط_طول_متجه -> {
        طابق عنصر_متجه_عند(الأنواع, الفعلية[0]) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0]));
        };
    }
    | هوية_بدائي_مترجم.استنساخ -> {
        // The argument is a reference; the copy is a value of its target Type.
        // A Type holding an exclusive reference cannot be duplicated.
        طابق معرف_نوع_أساس_عند(الأنواع, الفعلية[0]) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
            );
        }
        | اختياري.موجود(مرجع_النوع_25) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_25.القيمة] مع
            | نوع_مقنن.مرجع(الداخل, _) -> {
            دع حصرية: متغير منطقي = صواب;
            طابق يحتوي_استعارة_حصرية(الأنواع, الداخل) مع
            | نتيجة.نجح(القيمة) -> { حصرية := القيمة; }
            | نتيجة.خطأ(_) -> { };
            لو (حصرية) {
                أرجع نتيجة_استدعاء_بدائي.مرفوض(
                    خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
                );
            };
        }
            | _ -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
            );
        };
        };
    }
    | هوية_بدائي_مترجم.تحرير -> {
        // Memory owns the static "does this Type carry a release obligation?" fact.
        // Source Type consumes only that fact; flow-sensitive legality remains SSF-owned.
        // Verified MSIR does not reconstruct Frontend ownership state.
        لو (!يتطلب_تطابقا_مقننا) {
            طابق يتطلب_تحرير(الأنواع, الفعلية[0]) مع
            | نتيجة.خطأ(_) -> {
                أرجع نتيجة_استدعاء_بدائي.مرفوض(
                    خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
                );
            }
            | نتيجة.نجح(مطلوب) -> {
                لو (!مطلوب) {
                    أرجع نتيجة_استدعاء_بدائي.مرفوض(
                        خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
                    );
                };
            };
        };
    }
    | _ -> { };

    أرجع نتيجة_استدعاء_بدائي.صالح(العقد.فئة_الناتج);
}

// Source typing accepts safe implicit conversions; lowering materializes them explicitly.
عام عرف تحقق_استدعاء_بدائي(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الهوية: هوية_بدائي_مترجم,
    أنواع_الحجج: &متجه معرف_نوع
): نتيجة_استدعاء_بدائي {
    أرجع تحقق_استدعاء_بدائي_داخلي(
        الأنواع, الأنواع_المقننة, الهوية, أنواع_الحجج, خطأ
    );
}

// Verified MSIR must already contain the canonical post-conversion argument TypeIDs.
عام عرف تحقق_استدعاء_بدائي_مقنن(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الهوية: هوية_بدائي_مترجم,
    أنواع_الحجج: &متجه معرف_نوع
): نتيجة_استدعاء_بدائي {
    أرجع تحقق_استدعاء_بدائي_داخلي(
        الأنواع, الأنواع_المقننة, الهوية, أنواع_الحجج, صواب
    );
}

// Exact Type materialization for Runtime's broad result category remains Type-owned.
عام عرف قنن_نوع_ناتج_استدعاء_بدائي(
    الأنواع: &متغير سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الفئة: فئة_ناتج_بدائي
): معرف_نوع {
    دع المعروفة: أنواع_استدعاء_بدائي_مقننة = *الأنواع_المقننة;
    طابق الفئة مع
    | فئة_ناتج_بدائي.بلا_قيمة -> {
        أرجع قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
    }
    | فئة_ناتج_بدائي.عدد_صحيح -> { أرجع المعروفة.العدد; }
    | فئة_ناتج_بدائي.ط32 -> { أرجع المعروفة.عدد_ط32; }
    | فئة_ناتج_بدائي.ط64 -> { أرجع المعروفة.عدد_ط64; }
    | فئة_ناتج_بدائي.ع32 -> { أرجع المعروفة.عائم_ع32; }
    | فئة_ناتج_بدائي.ع64 -> { أرجع المعروفة.عائم_ع64; }
    | فئة_ناتج_بدائي.نص -> { أرجع المعروفة.النص; }
    // Argument-dependent: the caller resolves it from the argument Types
    // (نوع_ناتج_استدعاء_بدائي_من_الحجج); never reached for a valid call.
    | فئة_ناتج_بدائي.قيمة_المرجع -> {
        أرجع قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
    }
    | فئة_ناتج_بدائي.قيمة_الحجة -> {
        أرجع قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
    }
    // Argument-dependent: قنن_نوع_ناتج_بدائي_بالحجج interns it.
    | فئة_ناتج_بدائي.اختياري_عنصر_المتجه -> {
        أرجع قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
    }
    | فئة_ناتج_بدائي.منطقي -> {
        أرجع قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.منطقي());
    }
    // Argument-dependent: قنن_نوع_ناتج_بدائي_بالحجج interns it.
    | فئة_ناتج_بدائي.مؤشر_إلى_الحجة -> {
        أرجع قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
    }
    | فئة_ناتج_بدائي.دالة_بلا_معاملات -> {
        دع بلا_معاملات: متجه معرف_نوع = [];
        دع الفراغ: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
        أرجع قنن_نوعا(الأنواع, نوع_مقنن.دالة(بلا_معاملات, الفراغ));
    }
;
}

// The result Type a primitive builds from its arguments' Types (pop's
// `option T`), interned; لا_شيء for every other result category.
عام عرف قنن_نوع_ناتج_بدائي_بالحجج(
    الأنواع: &متغير سجل_أنواع,
    الفئة: فئة_ناتج_بدائي,
    أنواع_الحجج: &متجه معرف_نوع
): اختياري معرف_نوع {
    طابق الفئة مع
    | فئة_ناتج_بدائي.اختياري_عنصر_المتجه -> {
        لو ((الطول(*أنواع_الحجج) مثل طبيعي) < 1) { أرجع اختياري.لا_شيء(); };
        طابق عنصر_متجه_عند(الأنواع, (*أنواع_الحجج)[0]) مع
        | اختياري.موجود(العنصر) -> { أرجع اختياري.موجود(قنن_نوعا(الأنواع, نوع_مقنن.اختيار(العنصر))); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | فئة_ناتج_بدائي.مؤشر_إلى_الحجة -> {
        لو ((الطول(*أنواع_الحجج) مثل طبيعي) < 1) { أرجع اختياري.لا_شيء(); };
        طابق حمولة_صندوق_لبدائي(الأنواع, (*أنواع_الحجج)[0]) مع
        | اختياري.موجود(الحمولة) -> {
            دع المتغير: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.متغير(الحمولة));
            أرجع اختياري.موجود(قنن_نوعا(الأنواع, نوع_مقنن.مؤشر(المتغير)));
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The exact result Type of a primitive whose result depends on its arguments.
عام عرف نوع_ناتج_استدعاء_بدائي_من_الحجج(
    الأنواع: &سجل_أنواع,
    الفئة: فئة_ناتج_بدائي,
    أنواع_الحجج: &متجه معرف_نوع
): اختياري معرف_نوع {
    طابق الفئة مع
    | فئة_ناتج_بدائي.قيمة_الحجة -> {
        لو ((الطول(*أنواع_الحجج) مثل طبيعي) < 1) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود((*أنواع_الحجج)[0]);
    }
    | فئة_ناتج_بدائي.اختياري_عنصر_المتجه -> {
        لو ((الطول(*أنواع_الحجج) مثل طبيعي) < 1) { أرجع اختياري.لا_شيء(); };
        طابق عنصر_متجه_عند(الأنواع, (*أنواع_الحجج)[0]) مع
        | اختياري.موجود(العنصر) -> { أرجع معرف_نوع_اختيار_مقنن_موجود(الأنواع, العنصر); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | فئة_ناتج_بدائي.قيمة_المرجع -> {
        لو ((الطول(*أنواع_الحجج) مثل طبيعي) < 1) { أرجع اختياري.لا_شيء(); };
        طابق معرف_نوع_أساس_عند(الأنواع, (*أنواع_الحجج)[0]) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(مرجع_النوع_26) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_26.القيمة] مع
            | نوع_مقنن.مرجع(الداخل, _) -> { أرجع اختياري.موجود(الداخل); }
            | _ -> { أرجع اختياري.لا_شيء(); };
        };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Read-only counterpart used by MSIR verification; it never interns or mutates Type state.
عام عرف هل_نوع_ناتج_استدعاء_بدائي_مقنن(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الفئة: فئة_ناتج_بدائي,
    النوع: معرف_نوع
): منطقي {
    دع المعروفة: أنواع_استدعاء_بدائي_مقننة = *الأنواع_المقننة;
    طابق الفئة مع
    | فئة_ناتج_بدائي.بلا_قيمة -> { أرجع خطأ; }
    | فئة_ناتج_بدائي.عدد_صحيح -> {
        أرجع معرفا_نوع_متساويان(النوع, المعروفة.العدد);
    }
    | فئة_ناتج_بدائي.ط32 -> { أرجع معرفا_نوع_متساويان(النوع, المعروفة.عدد_ط32); }
    | فئة_ناتج_بدائي.ط64 -> { أرجع معرفا_نوع_متساويان(النوع, المعروفة.عدد_ط64); }
    | فئة_ناتج_بدائي.ع32 -> { أرجع معرفا_نوع_متساويان(النوع, المعروفة.عائم_ع32); }
    | فئة_ناتج_بدائي.ع64 -> { أرجع معرفا_نوع_متساويان(النوع, المعروفة.عائم_ع64); }
    | فئة_ناتج_بدائي.نص -> { أرجع معرفا_نوع_متساويان(النوع, المعروفة.النص); }
    // Clone never reaches MSIR verification (lowering replaces it with glue);
    // the atomics do, and read an integer (their operand is checked above).
    | فئة_ناتج_بدائي.قيمة_المرجع -> { أرجع هل_نوع_صحيح_لبدائي_ملتف(الأنواع, النوع); }
    // Only the C call at an address reaches MSIR with this category (the
    // wrapping primitives are lowered to arithmetic): its witness's Type.
    | فئة_ناتج_بدائي.قيمة_الحجة -> {
        أرجع معرفا_نوع_متساويان(النوع, المعروفة.عدد_ط64) || معرفا_نوع_متساويان(النوع, المعروفة.عائم_ع64);
    }
    // Pop never reaches MSIR verification: the glue pass replaces it.
    | فئة_ناتج_بدائي.اختياري_عنصر_المتجه -> { أرجع خطأ; }
    // A leaked box's payload pointer (the argument is checked above).
    | فئة_ناتج_بدائي.مؤشر_إلى_الحجة -> {
        طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الأساس) -> {
            طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
            | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        };
    }
    | فئة_ناتج_بدائي.منطقي -> {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
        | اختياري.موجود(المنطق) -> { أرجع معرفا_نوع_متساويان(النوع, المنطق); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | فئة_ناتج_بدائي.دالة_بلا_معاملات -> {
        طابق عدد_معاملات_دالة_دلالية(الأنواع, النوع) مع
        | اختياري.موجود(العدد) -> { أرجع العدد == 0; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
;
}
