استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.compatibility;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_semantic_contract;
استورد compiler.frontend.memory.memory_classification;

// Frontend Type owns exact language-Type legality for compiler primitive calls.
// Runtime owns primitive identity, broad arity/result/effect contracts, and service mapping.
عام نوع خطأ_استدعاء_بدائي =
    | عدد_حجج_غير_مطابق بنوع (غير_موقع, غير_موقع)
    | نوع_حجة_غير_مطابق بنوع (غير_موقع, معرف_نوع, معرف_نوع)
    | نوع_حجة_غير_صالح بنوع (غير_موقع, معرف_نوع)
    | دلالة_مصدرية_غير_متاحة
;

// Canonical primitive argument/result Type legality lives here in the Type owner.
// Runtime supplies only primitive identity and broad arity/result/effect categories.
عام نوع أنواع_استدعاء_بدائي_مقننة = {
    النص: معرف_نوع,
    العدد: معرف_نوع,
    البايت: معرف_نوع
};

عام نوع نتيجة_استدعاء_بدائي =
    | صالح بنوع فئة_ناتج_بدائي
    | مرفوض بنوع خطأ_استدعاء_بدائي
;

عرف تحقق_حجة_مطابقة(
    الأنواع: &سجل_أنواع,
    الفهرس: غير_موقع,
    الموجود: معرف_نوع,
    المتوقع: معرف_نوع,
    يتطلب_تطابقا_مقننا: منطقي
): اختيار خطأ_استدعاء_بدائي {
    دع مطابق: متغير منطقي = هل_تحويل_ضمني_آمن(الأنواع, الموجود, المتوقع);
    لو (يتطلب_تطابقا_مقننا) {
        مطابق := معرفا_نوع_متساويان(الموجود, المتوقع);
    };
    لو (!مطابق) {
        أرجع اختيار.بعض(
            خطأ_استدعاء_بدائي.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود)
        );
    };
    أرجع اختيار.لا_شيء();
}

عرف عنصر_متجه_عند(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختيار معرف_نوع {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.بعض(نوع_مقنن.متجه(العنصر)) -> { أرجع اختيار.بعض(العنصر); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف هل_نص_أو_متجه(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    النص: معرف_نوع,
    يتطلب_تطابقا_مقننا: منطقي
): منطقي {
    دع مطابق_النص: متغير منطقي = نوعان_متوافقان(الأنواع, النوع, النص);
    لو (يتطلب_تطابقا_مقننا) {
        مطابق_النص := معرفا_نوع_متساويان(النوع, النص);
    };
    لو (مطابق_النص) {
        أرجع صواب;
    };
    طابق عنصر_متجه_عند(الأنواع, النوع) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف هل_عنصر_متجه_مطابق(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المتوقع: معرف_نوع,
    يتطلب_تطابقا_مقننا: منطقي
): منطقي {
    طابق عنصر_متجه_عند(الأنواع, النوع) مع
    | اختيار.بعض(العنصر) -> {
        لو (يتطلب_تطابقا_مقننا) {
            أرجع معرفا_نوع_متساويان(العنصر, المتوقع);
        };
        أرجع نوعان_متوافقان(الأنواع, العنصر, المتوقع);
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

// Read the already-canonical primitive Type IDs without creating Type state.
عام عرف أنواع_استدعاء_بدائي_مقننة_من_سجل(
    الأنواع: &سجل_أنواع
): اختيار أنواع_استدعاء_بدائي_مقننة {
    دع النص: متغير معرف_نوع = معرف_نوع_من(0);
    دع العدد: متغير معرف_نوع = معرف_نوع_من(0);
    دع البايت: متغير معرف_نوع = معرف_نوع_من(0);
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.نص()) مع
    | اختيار.بعض(المعرف) -> { النص := المعرف; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختيار.بعض(المعرف) -> { العدد := المعرف; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.غ8()) مع
    | اختيار.بعض(المعرف) -> { البايت := المعرف; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    دع الناتج: أنواع_استدعاء_بدائي_مقننة = {
        النص: النص,
        العدد: العدد,
        البايت: البايت
    };
    أرجع اختيار.بعض(الناتج);
}

// Contextual positions expose an exact Type only when the primitive contract determines
// one uniquely. Polymorphic container positions remain relational and are checked below.
عام عرف نوع_حجة_بدائية_متوقعة(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الهوية: هوية_بدائي_مترجم,
    الفهرس: غير_موقع,
    أنواع_الحجج_السابقة: &متجه معرف_نوع
): اختيار معرف_نوع {
    دع القيم: أنواع_استدعاء_بدائي_مقننة = *الأنواع_المقننة;
    دع السابقة: متجه معرف_نوع = *أنواع_الحجج_السابقة;
    طابق الهوية مع
    | هوية_بدائي_مترجم.إلحاق -> {
        لو ((الفهرس == 1) && ((الطول(السابقة) مثل غير_موقع) >= 1)) {
            أرجع عنصر_متجه_عند(الأنواع, السابقة[0]);
        };
    }
    | هوية_بدائي_مترجم.فتح_ملف_للقراءة -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.قراءة_بايت_ملف -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> {
        لو ((الفهرس == 0) || (الفهرس == 2) || (الفهرس == 3)) { أرجع اختيار.بعض(القيم.العدد); };
    }
    | هوية_بدائي_مترجم.إنشاء_ملف_للكتابة -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.كتابة_مقطع_ملف -> {
        لو ((الفهرس == 0) || (الفهرس == 2) || (الفهرس == 3)) { أرجع اختيار.بعض(القيم.العدد); };
    }
    | هوية_بدائي_مترجم.إغلاق_ملف -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.فتح_دليل -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.قراءة_مدخل_دليل -> {
        لو ((الفهرس == 0) || (الفهرس == 2) || (الفهرس == 3)) { أرجع اختيار.بعض(القيم.العدد); };
    }
    | هوية_بدائي_مترجم.إغلاق_دليل -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.قراءة_بايت_الدخل_القياسي -> { }
    | هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي -> {
        لو ((الفهرس == 1) || (الفهرس == 2)) { أرجع اختيار.بعض(القيم.العدد); };
    }
    | هوية_بدائي_مترجم.كتابة_بايتات_تنفيذية -> {
        لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); };
    }
    | هوية_بدائي_مترجم.كتابة_الخرج_القياسي -> {
        لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); };
    }
    | هوية_بدائي_مترجم.كتابة_الخطأ_القياسي -> {
        لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); };
    }
    | هوية_بدائي_مترجم.الوصول_إلى_وسيط -> {
        لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); };
    }
    | هوية_بدائي_مترجم.خروج_العملية -> {
        لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); };
    }
    | هوية_بدائي_مترجم.تصنيف_خطأ_نظام -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.إنشاء_دليل -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.إزالة_ملف -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.إزالة_دليل -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.إعادة_تسمية -> { لو ((الفهرس == 0) || (الفهرس == 1)) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.نوع_مسار -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.حجم_مسار -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.وقت_تعديل_مسار -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.فتح_مقبض_ملف_للقراءة -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.إنشاء_مقبض_ملف_للكتابة -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.قراءة_مقطع_مقبض_ملف -> { لو ((الفهرس == 0) || (الفهرس == 2) || (الفهرس == 3)) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.كتابة_مقطع_مقبض_ملف -> { لو ((الفهرس == 0) || (الفهرس == 2) || (الفهرس == 3)) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.إغلاق_مقبض_ملف -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.تحريك_مقبض_ملف -> { أرجع اختيار.بعض(القيم.العدد); }
    | هوية_بدائي_مترجم.موضع_مقبض_ملف -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.مزامنة_مقبض_ملف -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.وقت_رتيب_نانو -> { }
    | هوية_بدائي_مترجم.وقت_نظام_نانو -> { }
    | هوية_بدائي_مترجم.نوم_نانو -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.طول_متغير_بيئة -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.قراءة_متغير_بيئة -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; لو ((الفهرس == 2) || (الفهرس == 3)) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.دليل_العمل -> { لو ((الفهرس == 1) || (الفهرس == 2)) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.الدليل_المؤقت -> { لو ((الفهرس == 1) || (الفهرس == 2)) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.تشغيل_عملية -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.النص); }; }
    | هوية_بدائي_مترجم.انتظار_عملية -> { لو (الفهرس == 0) { أرجع اختيار.بعض(القيم.العدد); }; }
    | هوية_بدائي_مترجم.حجم_صفحة_النظام -> { }
    | هوية_بدائي_مترجم.خريطة_ذاكرة_النظام -> { أرجع اختيار.بعض(القيم.العدد); }
    | هوية_بدائي_مترجم.إلغاء_خريطة_ذاكرة_النظام -> { أرجع اختيار.بعض(القيم.العدد); }
    | هوية_بدائي_مترجم.حماية_ذاكرة_النظام -> { أرجع اختيار.بعض(القيم.العدد); }
    | هوية_بدائي_مترجم.قفل_ذاكرة_النظام -> { أرجع اختيار.بعض(القيم.العدد); }
    | هوية_بدائي_مترجم.إلغاء_قفل_ذاكرة_النظام -> { أرجع اختيار.بعض(القيم.العدد); }
    | هوية_بدائي_مترجم.نصيحة_ذاكرة_النظام -> { أرجع اختيار.بعض(القيم.العدد); }
    | _ -> { };
    أرجع اختيار.لا_شيء();
}

عرف تحقق_استدعاء_بدائي_داخلي(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الهوية: هوية_بدائي_مترجم,
    أنواع_الحجج: &متجه معرف_نوع,
    يتطلب_تطابقا_مقننا: منطقي
): نتيجة_استدعاء_بدائي {
    دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(الهوية);
    دع الفعلية: متجه معرف_نوع = *أنواع_الحجج;
    دع القيم: أنواع_استدعاء_بدائي_مقننة = *الأنواع_المقننة;
    دع الموجود: غير_موقع = الطول(الفعلية) مثل غير_موقع;
    لو (الموجود != العقد.عدد_الحجج) {
        أرجع نتيجة_استدعاء_بدائي.مرفوض(
            خطأ_استدعاء_بدائي.عدد_حجج_غير_مطابق(العقد.عدد_الحجج, الموجود)
        );
    };

    // Fixed/contextual expected Types are owned once by نوع_حجة_بدائية_متوقعة.
    دع السابقة: متغير متجه معرف_نوع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الموجود) {
        طابق نوع_حجة_بدائية_متوقعة(الأنواع, الأنواع_المقننة, الهوية, ف, &السابقة) مع
        | اختيار.بعض(المتوقع) -> {
            طابق تحقق_حجة_مطابقة(
                الأنواع, ف, الفعلية[ف], المتوقع, يتطلب_تطابقا_مقننا
            ) مع
            | اختيار.بعض(الخطأ) -> { أرجع نتيجة_استدعاء_بدائي.مرفوض(الخطأ); }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
        ألحق(السابقة, الفعلية[ف]);
        ف := ف + 1;
    }

    // Only genuinely polymorphic/structural relations remain here.
    طابق الهوية مع
    | هوية_بدائي_مترجم.طول -> {
        لو (!هل_نص_أو_متجه(الأنواع, الفعلية[0], القيم.النص, يتطلب_تطابقا_مقننا)) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
            );
        };
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        طابق عنصر_متجه_عند(الأنواع, الفعلية[0]) مع
        | اختيار.بعض(_) -> { }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
            );
        };
    }
    | هوية_بدائي_مترجم.تحرير -> {
        // Memory owns the static "does this Type carry a release obligation?" fact.
        // Source Type consumes only that fact; flow-sensitive legality remains SSF-owned.
        // Verified MSIR does not reconstruct Frontend ownership state.
        لو (!يتطلب_تطابقا_مقننا) {
            طابق يتطلب_تحرير(الأنواع, الفعلية[0]) مع
            | نتيجة.خطأ(_) -> {
                أرجع نتيجة_استدعاء_بدائي.مرفوض(
                    خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
                );
            }
            | نتيجة.نجح(مطلوب) -> {
                لو (!مطلوب) {
                    أرجع نتيجة_استدعاء_بدائي.مرفوض(
                        خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
                    );
                };
            };
        };
    }
    | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> {
        لو (!هل_عنصر_متجه_مطابق(
            الأنواع, الفعلية[1], القيم.البايت, يتطلب_تطابقا_مقننا
        )) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(1, الفعلية[1])
            );
        };
    }
    | هوية_بدائي_مترجم.قراءة_مدخل_دليل -> {
        لو (!هل_عنصر_متجه_مطابق(
            الأنواع, الفعلية[1], القيم.البايت, يتطلب_تطابقا_مقننا
        )) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(1, الفعلية[1])
            );
        };
    }
    | هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي -> {
        لو (!هل_عنصر_متجه_مطابق(
            الأنواع, الفعلية[0], القيم.البايت, يتطلب_تطابقا_مقننا
        )) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
            );
        };
    }
    | هوية_بدائي_مترجم.كتابة_مقطع_ملف -> {
        لو (!هل_عنصر_متجه_مطابق(
            الأنواع, الفعلية[1], القيم.البايت, يتطلب_تطابقا_مقننا
        )) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(1, الفعلية[1])
            );
        };
    }
    | هوية_بدائي_مترجم.كتابة_بايتات_تنفيذية -> {
        لو (!هل_عنصر_متجه_مطابق(
            الأنواع, الفعلية[1], القيم.البايت, يتطلب_تطابقا_مقننا
        )) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(1, الفعلية[1])
            );
        };
    }
    | هوية_بدائي_مترجم.نص_من_بايتات -> {
        لو (!هل_عنصر_متجه_مطابق(
            الأنواع, الفعلية[0], القيم.البايت, يتطلب_تطابقا_مقننا
        )) {
            أرجع نتيجة_استدعاء_بدائي.مرفوض(
                خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])
            );
        };
    }
    | هوية_بدائي_مترجم.قراءة_مقطع_مقبض_ملف -> {
        لو (!هل_عنصر_متجه_مطابق(الأنواع, الفعلية[1], القيم.البايت, يتطلب_تطابقا_مقننا)) { أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(1, الفعلية[1])); };
    }
    | هوية_بدائي_مترجم.كتابة_مقطع_مقبض_ملف -> {
        لو (!هل_عنصر_متجه_مطابق(الأنواع, الفعلية[1], القيم.البايت, يتطلب_تطابقا_مقننا)) { أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(1, الفعلية[1])); };
    }
    | هوية_بدائي_مترجم.قراءة_متغير_بيئة -> {
        لو (!هل_عنصر_متجه_مطابق(الأنواع, الفعلية[1], القيم.البايت, يتطلب_تطابقا_مقننا)) { أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(1, الفعلية[1])); };
    }
    | هوية_بدائي_مترجم.دليل_العمل -> {
        لو (!هل_عنصر_متجه_مطابق(الأنواع, الفعلية[0], القيم.البايت, يتطلب_تطابقا_مقننا)) { أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])); };
    }
    | هوية_بدائي_مترجم.الدليل_المؤقت -> {
        لو (!هل_عنصر_متجه_مطابق(الأنواع, الفعلية[0], القيم.البايت, يتطلب_تطابقا_مقننا)) { أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(0, الفعلية[0])); };
    }
    | هوية_بدائي_مترجم.تشغيل_عملية -> {
        لو (!هل_عنصر_متجه_مطابق(الأنواع, الفعلية[1], القيم.النص, يتطلب_تطابقا_مقننا)) { أرجع نتيجة_استدعاء_بدائي.مرفوض(خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(1, الفعلية[1])); };
    }
    | _ -> { };

    أرجع نتيجة_استدعاء_بدائي.صالح(العقد.فئة_الناتج);
}

// Source typing accepts safe implicit conversions; lowering materializes them explicitly.
عام عرف تحقق_استدعاء_بدائي(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الهوية: هوية_بدائي_مترجم,
    أنواع_الحجج: &متجه معرف_نوع
): نتيجة_استدعاء_بدائي {
    أرجع تحقق_استدعاء_بدائي_داخلي(
        الأنواع, الأنواع_المقننة, الهوية, أنواع_الحجج, خطأ
    );
}

// Verified MSIR must already contain the canonical post-conversion argument TypeIDs.
عام عرف تحقق_استدعاء_بدائي_مقنن(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الهوية: هوية_بدائي_مترجم,
    أنواع_الحجج: &متجه معرف_نوع
): نتيجة_استدعاء_بدائي {
    أرجع تحقق_استدعاء_بدائي_داخلي(
        الأنواع, الأنواع_المقننة, الهوية, أنواع_الحجج, صواب
    );
}

// Exact Type materialization for Runtime's broad result category remains Type-owned.
عام عرف قنن_نوع_ناتج_استدعاء_بدائي(
    الأنواع: &متغير سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الفئة: فئة_ناتج_بدائي
): معرف_نوع {
    دع المعروفة: أنواع_استدعاء_بدائي_مقننة = *الأنواع_المقننة;
    طابق الفئة مع
    | فئة_ناتج_بدائي.بلا_قيمة -> {
        أرجع قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
    }
    | فئة_ناتج_بدائي.عدد_صحيح -> { أرجع المعروفة.العدد; }
    | فئة_ناتج_بدائي.نص -> { أرجع المعروفة.النص; }
    | فئة_ناتج_بدائي.نتيجة_نص_بخطأ_عددي -> {
        أرجع قنن_نوعا(الأنواع, نوع_مقنن.نتيجة(المعروفة.النص, المعروفة.العدد));
    }
    | فئة_ناتج_بدائي.نتيجة_عدد_بخطأ_عددي -> {
        أرجع قنن_نوعا(الأنواع, نوع_مقنن.نتيجة(المعروفة.العدد, المعروفة.العدد));
    };
}

// Read-only counterpart used by MSIR verification; it never interns or mutates Type state.
عام عرف هل_نوع_ناتج_استدعاء_بدائي_مقنن(
    الأنواع: &سجل_أنواع,
    الأنواع_المقننة: &أنواع_استدعاء_بدائي_مقننة,
    الفئة: فئة_ناتج_بدائي,
    النوع: معرف_نوع
): منطقي {
    دع المعروفة: أنواع_استدعاء_بدائي_مقننة = *الأنواع_المقننة;
    طابق الفئة مع
    | فئة_ناتج_بدائي.بلا_قيمة -> { أرجع خطأ; }
    | فئة_ناتج_بدائي.عدد_صحيح -> {
        أرجع معرفا_نوع_متساويان(النوع, المعروفة.العدد);
    }
    | فئة_ناتج_بدائي.نص -> {
        أرجع معرفا_نوع_متساويان(النوع, المعروفة.النص);
    }
    | فئة_ناتج_بدائي.نتيجة_نص_بخطأ_عددي -> {
        طابق نوع_أساس_عند(الأنواع, النوع) مع
        | اختيار.بعض(نوع_مقنن.نتيجة(النجاح, الخطأ)) -> {
            أرجع معرفا_نوع_متساويان(النجاح, المعروفة.النص)
                && معرفا_نوع_متساويان(الخطأ, المعروفة.العدد);
        }
        | _ -> { أرجع خطأ; };
    }
    | فئة_ناتج_بدائي.نتيجة_عدد_بخطأ_عددي -> {
        طابق نوع_أساس_عند(الأنواع, النوع) مع
        | اختيار.بعض(نوع_مقنن.نتيجة(النجاح, الخطأ)) -> {
            أرجع معرفا_نوع_متساويان(النجاح, المعروفة.العدد)
                && معرفا_نوع_متساويان(الخطأ, المعروفة.العدد);
        }
        | _ -> { أرجع خطأ; };
    };
}
