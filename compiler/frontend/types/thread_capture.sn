استورد compiler.runtime.primitive_identity;

// The spawn capture check (docs/en/reference/type-system.md, "Thread capture rules"),
// Rust's `F: Send` bound on std::thread::spawn. A closure handed to another
// thread may not capture:
//
// 1. a raw pointer (Rust's *const T / *mut T are !Send), unless the call
//    that hands it over sits inside `غير_آمن`, where the programmer vouches
//    for the pointee's synchronization;
// 2. a borrowed reference or a slice (it would outlive the spawning frame:
//    Rust's 'static bound);
// 3. a non-atomic shared value: a writable module variable, which every
//    thread reads and writes without synchronization (Rust's `static mut`,
//    whose every access is unsafe). Shared state goes through an atomic, a
//    Mutex or an Arc (std.sync).
//
// Which calls hand a closure to another thread is not a list of names: the
// function-Typed parameters of a function that calls a closure-address
// intrinsic (بدائي_عنوان_دالة, بدائي_مدخل_سي_لدالة, which give a closure to
// a new thread: std.thread's spawn, on every OS) are "sending", and so is a
// parameter forwarded to a sending parameter of another function. The facts
// propagate to a fixpoint.
// Then every call that passes a closure literal to a sending parameter has
// its captures checked. A closure passed through a variable is not
// inspected (its captures are not part of its Type); captured closures are
// opaque, as their reference counts are atomic.
//
// Types are walked through records, enums, tuples, options, results,
// vectors and boxes; function values and Type parameters end the walk.

عام نوع صنف_انتهاك_التقاط_خيط =
    | مؤشر_خام
    | مرجع_مستعار
    | مشترك_غير_ذري
;

عام نوع انتهاك_التقاط_خيط = {
    النطاق: نطاق,
    الصنف: صنف_انتهاك_التقاط_خيط,
    الرمز: معرف_رمز,
    النوع: اختياري معرف_نوع
};

// One argument of a recorded call: a parameter of the enclosing function
// passed as is, a closure literal, or anything else.
نوع حجة_نداء_خيطي =
    | معامل بنوع طبيعي
    | إغلاق بنوع نطاق
    | أخرى
;

نوع نداء_خيطي = {
    الوحدة: طبيعي,
    // Index of the enclosing function in دوال_خيطية, or none at the top level
    // and inside closures.
    الدالة: اختياري طبيعي,
    المستدعى: اختياري طبيعي,
    بدائي_مرسل: منطقي,
    الحجج: متجه حجة_نداء_خيطي,
    في_غير_آمن: منطقي
};

نوع دالة_خيطية = {
    المعاملات: متجه نطاق,
    // Whether each parameter has a function Type (only those can be sent).
    الدالية: متجه منطقي,
    المرسلة: متجه منطقي
};

نوع سياق_فحص_خيطي = {
    الدوال: متجه دالة_خيطية,
    // Symbol -> 1 + index into الدوال (0: not a function with a body),
    // checked into 32 bits where it is written.
    دالة_الرمز: متجه ط32,
    النداءات: متجه نداء_خيطي,
    // Spans of the unsafe blocks seen inside closure bodies.
    كتل_غير_آمنة: متجه نطاق,
    // The Symbols of the closure-address intrinsics.
    البدائيات_المرسلة: متجه معرف_رمز
};

عرف نطاق_يحتوي_خيطي(الخارجي: نطاق, الداخلي: نطاق): منطقي {
    أرجع نطاق_يحتوي_نطاقا(الخارجي, الداخلي);
}

// The Symbols of the closure-address intrinsics (looked up once, so each
// name occurrence is compared with two Symbols, not the primitive table).
عرف رموز_البدائيات_المرسلة(سياق_الأسماء: &سياق_أسماء): متجه معرف_رمز {
    دع الناتج: متغير متجه معرف_رمز = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*سياق_الأسماء).هويات_البدائيات) مثل طبيعي)) {
        دع الربط: ربط_رمز_بدائي_مترجم = (*سياق_الأسماء).هويات_البدائيات[ف];
        طابق الربط.الهوية مع
        | هوية_بدائي_مترجم.عنوان_دالة -> { ألحق(الناتج, الربط.الرمز); }
        | هوية_بدائي_مترجم.مدخل_سي_لدالة -> { ألحق(الناتج, الربط.الرمز); }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف هل_رمز_بدائي_مرسل(البدائيات: &متجه معرف_رمز, الرمز: معرف_رمز): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البدائيات) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*البدائيات)[ف], الرمز)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Whether any name in the program resolves to a closure-address intrinsic:
// without one no closure ever reaches another thread and the check is free.
عرف يوجد_بدائي_مرسل(الروابط: &متجه سياق_روابط_أسماء, البدائيات: &متجه معرف_رمز): منطقي {
    إذا (الطول(*البدائيات) == 0) { أرجع خطأ; };
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الروابط) مثل طبيعي)) {
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*الروابط)[و];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*روابط_الوحدة).الظهورات) مثل طبيعي)) {
            طابق (*روابط_الوحدة).الظهورات[ف].الرمز مع
            | اختياري.موجود(الرمز) -> {
                إذا (هل_رمز_بدائي_مرسل(البدائيات, الرمز)) { أرجع صواب; };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    أرجع خطأ;
}

// Record every function with a body: its parameter name spans and its
// symbol, so a call's callee Symbol finds its function in one step.
عرف اجمع_دوال_خيطية(
    الوحدات: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    سياق_الأسماء: &سياق_أسماء,
    السياق: &متغير سياق_فحص_خيطي
): فراغ {
    دع عدد_الرموز: طبيعي = الطول((*سياق_الأسماء).الرموز) مثل طبيعي;
    دع ر: متغير طبيعي = 0;
    طالما (ر < عدد_الرموز) { ألحق((*السياق).دالة_الرمز, 0); ر := ر + 1; }
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي) && و < (الطول(*الروابط) مثل طبيعي)) {
        دع العناصر: &متجه عنصر_وحدة = &(*الوحدات)[و].العناصر;
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول(*العناصر) مثل طبيعي)) {
            طابق (*العناصر)[ع] مع
            | عنصر_وحدة.دالة(التصريح) -> {
                طابق رمز_اسم_محلول_عند(&(*الروابط)[و], التصريح.الاسم.النطاق) مع
                | اختياري.موجود(الرمز) -> {
                    إذا ((الرمز.القيمة مثل طبيعي) < عدد_الرموز) {
                        دع المعاملات: متغير متجه نطاق = [];
                        دع الدالية: متغير متجه منطقي = [];
                        دع المرسلة: متغير متجه منطقي = [];
                        دع م: متغير طبيعي = 0;
                        طالما (م < (الطول(التصريح.المعاملات) مثل طبيعي)) {
                            ألحق(المعاملات, التصريح.المعاملات[م].الاسم.النطاق);
                            طابق التصريح.المعاملات[م].النوع مع
                            | نوع_تركيبي.دالة(_, _, _) -> { ألحق(الدالية, صواب); }
                            | _ -> { ألحق(الدالية, خطأ); };
                            ألحق(المرسلة, خطأ);
                            م := م + 1;
                        }
                        دع الدالة: دالة_خيطية = { المعاملات: المعاملات, الدالية: الدالية, المرسلة: المرسلة };
                        ألحق((*السياق).الدوال, الدالة);
                        (*السياق).دالة_الرمز[الرمز.القيمة] := ط32_متحقق(الطول((*السياق).الدوال) مثل طبيعي);
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ع := ع + 1;
        }
        و := و + 1;
    }
}

// The parameter of the enclosing function an argument names, if it is one.
عرف معامل_حجة_خيطي(
    الحجة: &تعبير,
    الروابط: &سياق_روابط_أسماء,
    سياق_الأسماء: &سياق_أسماء,
    السياق: &سياق_فحص_خيطي,
    الدالة: اختياري طبيعي
): اختياري طبيعي {
    دع فهرس_الدالة: طبيعي;
    طابق الدالة مع
    | اختياري.موجود(القيمة) -> { فهرس_الدالة := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق *الحجة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
            طابق (*سياق_الأسماء).الرموز[الرمز.القيمة].النوع مع
            | نوع_تصريح.معامل -> {
                دع نطاق_الاسم: نطاق = (*سياق_الأسماء).الرموز[الرمز.القيمة].نطاق_الاسم;
                دع المعاملات: &متجه نطاق = &(*السياق).الدوال[فهرس_الدالة].المعاملات;
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(*المعاملات) مثل طبيعي)) {
                    إذا (نطاقان_متساويان((*المعاملات)[م], نطاق_الاسم)) { أرجع اختياري.موجود(م); };
                    م := م + 1;
                }
                أرجع اختياري.لا_شيء();
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف سجل_نداء_خيطي(
    الوحدة: طبيعي,
    نطاق_الاستدعاء: نطاق,
    المستدعى: &تعبير,
    الحجج: &متجه تعبير,
    الروابط: &سياق_روابط_أسماء,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سياق_الأسماء: &سياق_أسماء,
    السياق: &متغير سياق_فحص_خيطي,
    الدالة: اختياري طبيعي,
    داخل_غير_آمن: منطقي
): فراغ {
    دع بدائي: متغير منطقي = خطأ;
    دع رمز_المستدعى: متغير اختياري معرف_رمز = رمز_مستدعى_استدعاء_عند(أنواع_التعبيرات, نطاق_الاستدعاء);
    دع المستدعى_الفعلي: تعبير = مستدعى_بلا_حجج_نوع(المستدعى);
    طابق المستدعى_الفعلي مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            إذا (هل_رمز_بدائي_مرسل(&(*السياق).البدائيات_المرسلة, الرمز)) { بدائي := صواب; };
            رمز_المستدعى := اختياري.موجود(الرمز);
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    دع المستدعى_الدالة: متغير اختياري طبيعي = اختياري.لا_شيء();
    طابق رمز_المستدعى مع
    | اختياري.موجود(الرمز) -> {
        إذا ((الرمز.القيمة مثل طبيعي) < (الطول((*السياق).دالة_الرمز) مثل طبيعي)) {
            دع الموضع: طبيعي = (*السياق).دالة_الرمز[الرمز.القيمة];
            إذا (الموضع > 0) { المستدعى_الدالة := اختياري.موجود(الموضع - 1); };
        };
    }
    | اختياري.لا_شيء -> { };
    إذا (!بدائي) {
        طابق المستدعى_الدالة مع
        | اختياري.لا_شيء -> { أرجع; }
        | اختياري.موجود(_) -> { };
    };
    دع حجج_النداء: متغير متجه حجة_نداء_خيطي = [];
    دع مهم: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحجج) مثل طبيعي)) {
        دع الحجة: &تعبير = &(*الحجج)[ف];
        طابق *الحجة مع
        | تعبير.إغلاق(نطاق_الإغلاق, _, _, _) -> {
            ألحق(حجج_النداء, حجة_نداء_خيطي.إغلاق(نطاق_الإغلاق));
            مهم := صواب;
        }
        | _ -> {
            طابق معامل_حجة_خيطي(الحجة, الروابط, سياق_الأسماء, السياق, الدالة) مع
            | اختياري.موجود(الموضع) -> {
                ألحق(حجج_النداء, حجة_نداء_خيطي.معامل(الموضع));
                مهم := صواب;
            }
            | اختياري.لا_شيء -> { ألحق(حجج_النداء, حجة_نداء_خيطي.أخرى()); };
        };
        ف := ف + 1;
    }
    // A function that hands a closure to another thread itself (it calls a
    // closure-address intrinsic) sends its function-Typed parameters: the
    // closure may reach the intrinsic through a box or a wrapper closure, as
    // in std.thread's spawn.
    إذا (بدائي) {
        طابق الدالة مع
        | اختياري.موجود(فهرس_الدالة) -> {
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول((*السياق).الدوال[فهرس_الدالة].الدالية) مثل طبيعي)) {
                إذا ((*السياق).الدوال[فهرس_الدالة].الدالية[م]) {
                    (*السياق).الدوال[فهرس_الدالة].المرسلة[م] := صواب;
                };
                م := م + 1;
            }
        }
        | اختياري.لا_شيء -> { };
    };
    إذا (!مهم) { أرجع; };
    دع النداء: نداء_خيطي = {
        الوحدة: الوحدة, الدالة: الدالة, المستدعى: المستدعى_الدالة, بدائي_مرسل: بدائي,
        الحجج: حجج_النداء, في_غير_آمن: داخل_غير_آمن
    };
    ألحق((*السياق).النداءات, النداء);
}

عرف امش_تعبيرات_خيطية(
    التعبيرات: &متجه تعبير,
    الوحدة: طبيعي,
    الروابط: &سياق_روابط_أسماء,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سياق_الأسماء: &سياق_أسماء,
    السياق: &متغير سياق_فحص_خيطي,
    الدالة: اختياري طبيعي,
    داخل_غير_آمن: منطقي,
    في_إغلاق: منطقي
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التعبيرات) مثل طبيعي)) {
        امش_تعبيرا_خيطيا(&(*التعبيرات)[ف], الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        ف := ف + 1;
    }
}

عرف امش_تعبيرا_خيطيا(
    التعبير: &تعبير,
    الوحدة: طبيعي,
    الروابط: &سياق_روابط_أسماء,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سياق_الأسماء: &سياق_أسماء,
    السياق: &متغير سياق_فحص_خيطي,
    الدالة: اختياري طبيعي,
    داخل_غير_آمن: منطقي,
    في_إغلاق: منطقي
): فراغ {
    طابق *التعبير مع
    | تعبير.حقل(_, الأصل, _) -> {
        امش_تعبيرا_خيطيا(&(*الأصل), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        امش_تعبيرا_خيطيا(&(*الأصل), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_تعبيرا_خيطيا(&(*الفهرس), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.فك_موضع(_, الداخل) -> {
        امش_تعبيرا_خيطيا(&(*الداخل), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.ثنائي(_, _, الأيسر, الأيمن) -> {
        امش_تعبيرا_خيطيا(&(*الأيسر), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_تعبيرا_خيطيا(&(*الأيمن), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.أحادي(_, _, الداخل) -> {
        امش_تعبيرا_خيطيا(&(*الداخل), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.استدعاء(نطاق_الاستدعاء, المستدعى, الحجج) -> {
        سجل_نداء_خيطي(
            الوحدة, نطاق_الاستدعاء, &(*المستدعى), &الحجج, الروابط, أنواع_التعبيرات, سياق_الأسماء,
            السياق, الدالة, داخل_غير_آمن
        );
        امش_تعبيرا_خيطيا(&(*المستدعى), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_تعبيرات_خيطية(&الحجج, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        امش_تعبيرا_خيطيا(&(*الداخل), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.وقت_الترجمة(_, الداخل) -> {
        امش_تعبيرا_خيطيا(&(*الداخل), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.تسلسل_وقت_الترجمة(_, العناصر) -> {
        امش_تعبيرات_خيطية(&العناصر, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.حرفي_متجه(_, العناصر) -> {
        امش_تعبيرات_خيطية(&العناصر, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            امش_تعبيرا_خيطيا(&الحقول[ف].القيمة, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
            ف := ف + 1;
        }
    }
    // A closure body is its own function: an enclosing unsafe scope does not
    // cover it, and its names are not the enclosing function's parameters.
    | تعبير.إغلاق(_, _, _, الجسم) -> {
        دع بلا_دالة: اختياري طبيعي = اختياري.لا_شيء();
        امش_تعبيرا_خيطيا(&(*الجسم), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, بلا_دالة, خطأ, صواب);
    }
    | _ -> { };
}

عرف امش_كتلة_خيطية(
    الكتلة: &كتلة_عبارات,
    الوحدة: طبيعي,
    الروابط: &سياق_روابط_أسماء,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سياق_الأسماء: &سياق_أسماء,
    السياق: &متغير سياق_فحص_خيطي,
    الدالة: اختياري طبيعي,
    داخل_غير_آمن: منطقي,
    في_إغلاق: منطقي
): فراغ {
    دع العبارات: &متجه صندوق عبارة = &(*الكتلة).العبارات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العبارات) مثل طبيعي)) {
        امش_عبارة_خيطية(&(*(*العبارات)[ف]), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        ف := ف + 1;
    }
}

عرف امش_عبارة_خيطية(
    العبارة: &عبارة,
    الوحدة: طبيعي,
    الروابط: &سياق_روابط_أسماء,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    سياق_الأسماء: &سياق_أسماء,
    السياق: &متغير سياق_فحص_خيطي,
    الدالة: اختياري طبيعي,
    داخل_غير_آمن: منطقي,
    في_إغلاق: منطقي
): فراغ {
    طابق *العبارة مع
    | عبارة.تهيئة_سجل(_, الهدف, الحقول) -> {
        امش_تعبيرا_خيطيا(&الهدف, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            امش_تعبيرا_خيطيا(&الحقول[ف].القيمة, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
            ف := ف + 1;
        }
    }
    | عبارة.تهيئة_صف(_, الهدف, القيم) -> {
        امش_تعبيرا_خيطيا(&الهدف, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_تعبيرات_خيطية(&القيم, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | عبارة.تهيئة_متجه(_, الهدف, القيم) -> {
        امش_تعبيرا_خيطيا(&الهدف, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_تعبيرات_خيطية(&القيم, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | عبارة.تهيئة_صندوق(_, الهدف, القيمة) -> {
        امش_تعبيرا_خيطيا(&الهدف, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_تعبيرا_خيطيا(&القيمة, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | عبارة.نسخ(_, الهدف, القيمة) -> {
        امش_تعبيرا_خيطيا(&الهدف, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_تعبيرا_خيطيا(&القيمة, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | عبارة.استدعاء(_, التعبير) -> {
        امش_تعبيرا_خيطيا(&التعبير, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | عبارة.طالما(_, الشرط, الجسم) -> {
        امش_تعبيرا_خيطيا(&الشرط, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_كتلة_خيطية(&الجسم, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | عبارة.لكل(_, البداية, الشرط, الخطوة, الجسم) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البداية) مثل طبيعي)) {
            امش_عبارة_خيطية(&(*البداية[ف]), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
            ف := ف + 1;
        }
        امش_تعبيرا_خيطيا(&الشرط, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_عبارة_خيطية(&(*الخطوة), الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_كتلة_خيطية(&الجسم, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
    }
    | عبارة.إذا(_, الشرط, الأولى, الثانية) -> {
        امش_تعبيرا_خيطيا(&الشرط, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        امش_كتلة_خيطية(&الأولى, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        طابق الثانية مع
        | اختياري.موجود(البديلة) -> {
            امش_كتلة_خيطية(&البديلة, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        }
        | اختياري.لا_شيء -> { };
    }
    | عبارة.طابق(_, المميز, الأذرع) -> {
        امش_تعبيرا_خيطيا(&المميز, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأذرع) مثل طبيعي)) {
            امش_كتلة_خيطية(&الأذرع[ف].الجسم, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
            ف := ف + 1;
        }
    }
    | عبارة.أرجع(_, القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(التعبير) -> {
            امش_تعبيرا_خيطيا(&التعبير, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, داخل_غير_آمن, في_إغلاق);
        }
        | اختياري.لا_شيء -> { };
    }
    | عبارة.غير_آمن(النطاق, الجسم) -> {
        إذا (في_إغلاق) { ألحق((*السياق).كتل_غير_آمنة, النطاق); };
        امش_كتلة_خيطية(&الجسم, الوحدة, الروابط, أنواع_التعبيرات, سياق_الأسماء, السياق, الدالة, صواب, في_إغلاق);
    }
    | _ -> { };
}

// Sending parameters to a fixpoint: a parameter passed to a closure-address
// intrinsic, or to a sending parameter of another function.
عرف انشر_المعاملات_المرسلة(السياق: &متغير سياق_فحص_خيطي): فراغ {
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        // Read every call first, then mark: the calls are only read.
        دع دوال_للضبط: متغير متجه طبيعي = [];
        دع معاملات_للضبط: متغير متجه طبيعي = [];
        جد_معاملات_مرسلة(السياق, &متغير دوال_للضبط, &متغير معاملات_للضبط);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(دوال_للضبط) مثل طبيعي)) {
            دع الدالة: طبيعي = دوال_للضبط[ف];
            دع الموضع: طبيعي = معاملات_للضبط[ف];
            إذا (!(*السياق).الدوال[الدالة].المرسلة[الموضع]) {
                (*السياق).الدوال[الدالة].المرسلة[الموضع] := صواب;
                تغير := صواب;
            };
            ف := ف + 1;
        }
    }
}

عرف جد_معاملات_مرسلة(
    السياق: &سياق_فحص_خيطي, الدوال: &متغير متجه طبيعي, المعاملات: &متغير متجه طبيعي
): فراغ {
    دع ن: متغير طبيعي = 0;
    طالما (ن < (الطول((*السياق).النداءات) مثل طبيعي)) {
        دع النداء: &نداء_خيطي = &(*السياق).النداءات[ن];
        طابق (*النداء).الدالة مع
        | اختياري.موجود(المتصلة) -> {
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول((*النداء).الحجج) مثل طبيعي)) {
                طابق (*النداء).الحجج[ح] مع
                | حجة_نداء_خيطي.معامل(الموضع) -> {
                    دع مرسلة: متغير منطقي = (*النداء).بدائي_مرسل;
                    طابق (*النداء).المستدعى مع
                    | اختياري.موجود(المستدعاة) -> {
                        إذا (ح < (الطول((*السياق).الدوال[المستدعاة].المرسلة) مثل طبيعي)) {
                            إذا ((*السياق).الدوال[المستدعاة].المرسلة[ح]) { مرسلة := صواب; };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    إذا (مرسلة && الموضع < (الطول((*السياق).الدوال[المتصلة].المرسلة) مثل طبيعي)) {
                        ألحق(*الدوال, المتصلة);
                        ألحق(*المعاملات, الموضع);
                    };
                }
                | _ -> { };
                ح := ح + 1;
            }
        }
        | اختياري.لا_شيء -> { };
        ن := ن + 1;
    }
}

// What a captured Type holds that may not reach another thread.
نوع حالة_نوع_خيطي =
    | آمن
    | فيه_مؤشر
    | فيه_مرجع
;

عرف ادمج_حالة_نوع_خيطي(الأولى: حالة_نوع_خيطي, الثانية: حالة_نوع_خيطي): حالة_نوع_خيطي {
    طابق الأولى مع
    | حالة_نوع_خيطي.فيه_مرجع -> { أرجع الأولى; }
    | _ -> { };
    طابق الثانية مع
    | حالة_نوع_خيطي.آمن -> { أرجع الأولى; }
    | _ -> { أرجع الثانية; };
}

عرف صنف_نوع_خيطي(الأنواع: &سجل_أنواع, النوع: معرف_نوع, الجارية: &متغير متجه طبيعي): حالة_نوع_خيطي {
    // A Type already being walked closes a recursive Type: no new fact.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الجارية) مثل طبيعي)) {
        إذا ((*الجارية)[ف] == (النوع.القيمة مثل طبيعي)) { أرجع حالة_نوع_خيطي.آمن(); };
        ف := ف + 1;
    }
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع حالة_نوع_خيطي.آمن(); }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.مؤشر -> { أرجع حالة_نوع_خيطي.فيه_مؤشر(); }
        | صنف_شكل_نوع_دلالي.مرجع -> { أرجع حالة_نوع_خيطي.فيه_مرجع(); }
        | صنف_شكل_نوع_دلالي.شريحة -> { أرجع حالة_نوع_خيطي.فيه_مرجع(); }
        | صنف_شكل_نوع_دلالي.صندوق -> {
            طابق نوع_حمولة_صندوق_دلالي(الأنواع, الوصف.المعرف) مع
            | اختياري.موجود(الحمولة) -> { أرجع صنف_ابن_نوع_خيطي(الأنواع, النوع, الحمولة, الجارية); }
            | اختياري.لا_شيء -> { أرجع حالة_نوع_خيطي.آمن(); };
        }
        | صنف_شكل_نوع_دلالي.متجه -> {
            طابق نوع_عنصر_متجه_دلالي(الأنواع, الوصف.المعرف) مع
            | اختياري.موجود(العنصر) -> { أرجع صنف_ابن_نوع_خيطي(الأنواع, النوع, العنصر, الجارية); }
            | اختياري.لا_شيء -> { أرجع حالة_نوع_خيطي.آمن(); };
        }
        | صنف_شكل_نوع_دلالي.صف -> {
            دع الحالة: متغير حالة_نوع_خيطي = حالة_نوع_خيطي.آمن();
            طابق عدد_عناصر_صف_دلالي(الأنواع, الوصف.المعرف) مع
            | اختياري.موجود(العدد) -> {
                دع ع: متغير طبيعي = 0;
                طالما (ع < العدد) {
                    طابق نوع_عنصر_صف_دلالي_عند(الأنواع, الوصف.المعرف, ع) مع
                    | اختياري.موجود(الابن) -> {
                        الحالة := ادمج_حالة_نوع_خيطي(الحالة, صنف_ابن_نوع_خيطي(الأنواع, النوع, الابن, الجارية));
                    }
                    | اختياري.لا_شيء -> { };
                    ع := ع + 1;
                }
            }
            | اختياري.لا_شيء -> { };
            أرجع الحالة;
        }
        | صنف_شكل_نوع_دلالي.سجل -> {
            دع الحالة: متغير حالة_نوع_خيطي = حالة_نوع_خيطي.آمن();
            طابق عدد_حقول_سجل_دلالي(الأنواع, الوصف.المعرف) مع
            | اختياري.موجود(العدد) -> {
                دع ع: متغير طبيعي = 0;
                طالما (ع < العدد) {
                    طابق نوع_حقل_سجل_دلالي_عند(الأنواع, الوصف.المعرف, ع) مع
                    | اختياري.موجود(الابن) -> {
                        الحالة := ادمج_حالة_نوع_خيطي(الحالة, صنف_ابن_نوع_خيطي(الأنواع, النوع, الابن, الجارية));
                    }
                    | اختياري.لا_شيء -> { };
                    ع := ع + 1;
                }
            }
            | اختياري.لا_شيء -> { };
            أرجع الحالة;
        }
        | صنف_شكل_نوع_دلالي.تعداد -> { أرجع صنف_حمولات_نوع_خيطي(الأنواع, النوع, الوصف.المعرف, الجارية); }
        | صنف_شكل_نوع_دلالي.اختيار -> { أرجع صنف_حمولات_نوع_خيطي(الأنواع, النوع, الوصف.المعرف, الجارية); }
        | صنف_شكل_نوع_دلالي.نتيجة -> { أرجع صنف_حمولات_نوع_خيطي(الأنواع, النوع, الوصف.المعرف, الجارية); }
        | _ -> { أرجع حالة_نوع_خيطي.آمن(); };
    };
}

عرف صنف_ابن_نوع_خيطي(
    الأنواع: &سجل_أنواع, الأب: معرف_نوع, الابن: معرف_نوع, الجارية: &متغير متجه طبيعي
): حالة_نوع_خيطي {
    ألحق(*الجارية, الأب.القيمة);
    دع الحالة: حالة_نوع_خيطي = صنف_نوع_خيطي(الأنواع, الابن, الجارية);
    دع المحذوف: اختياري طبيعي = أزل_الأخير(*الجارية);
    أرجع الحالة;
}

عرف صنف_حمولات_نوع_خيطي(
    الأنواع: &سجل_أنواع, النوع: معرف_نوع, المعرف: معرف_نوع, الجارية: &متغير متجه طبيعي
): حالة_نوع_خيطي {
    دع الحالة: متغير حالة_نوع_خيطي = حالة_نوع_خيطي.آمن();
    طابق عدد_منشئات_نوع_دلالي(الأنواع, المعرف) مع
    | اختياري.موجود(عدد_المنشئات) -> {
        دع م: متغير طبيعي = 0;
        طالما (م < عدد_المنشئات) {
            طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, المعرف, م) مع
            | اختياري.موجود(عدد_الحمولات) -> {
                دع ح: متغير طبيعي = 0;
                طالما (ح < عدد_الحمولات) {
                    طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, المعرف, م, ح) مع
                    | اختياري.موجود(الابن) -> {
                        الحالة := ادمج_حالة_نوع_خيطي(الحالة, صنف_ابن_نوع_خيطي(الأنواع, النوع, الابن, الجارية));
                    }
                    | اختياري.لا_شيء -> { };
                    ح := ح + 1;
                }
            }
            | اختياري.لا_شيء -> { };
            م := م + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    أرجع الحالة;
}

// The first use of الرمز inside the closure, for the diagnostic's span.
عرف أول_استخدام_في_نطاق(الروابط: &سياق_روابط_أسماء, الرمز: معرف_رمز, الإغلاق: نطاق): نطاق {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الروابط).الظهورات) مثل طبيعي)) {
        طابق (*الروابط).الظهورات[ف].الرمز مع
        | اختياري.موجود(الآخر) -> {
            إذا (معرفا_رمز_متساويان(الآخر, الرمز)
                && نطاق_يحتوي_خيطي(الإغلاق, (*الروابط).الظهورات[ف].النطاق)) {
                أرجع (*الروابط).الظهورات[ف].النطاق;
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الإغلاق;
}

// Rule 3: a writable module variable named in the closure body, outside an
// unsafe block of that body.
عرف أول_عالمي_متغير_في_إغلاق(
    الروابط: &سياق_روابط_أسماء,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    السياق: &سياق_فحص_خيطي,
    الإغلاق: نطاق
): اختياري انتهاك_التقاط_خيط {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الروابط).الظهورات) مثل طبيعي)) {
        دع نطاق_الظهور: نطاق = (*الروابط).الظهورات[ف].النطاق;
        طابق (*الروابط).الظهورات[ف].الرمز مع
        | اختياري.موجود(الرمز) -> {
            إذا (نطاق_يحتوي_خيطي(الإغلاق, نطاق_الظهور)) {
                طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
                | اختياري.موجود(نوع_تصريح.قيمة_عليا) -> {
                    طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_الظهور) مع
                    | اختياري.موجود(النوع) -> {
                        طابق أزل_غلاف_متغير(الأنواع, النوع) مع
                        | اختياري.موجود(الداخل) -> {
                            إذا (!معرفا_نوع_متساويان(الداخل, النوع)
                                && !ظهور_في_كتلة_غير_آمنة(السياق, الإغلاق, نطاق_الظهور)) {
                                دع الانتهاك: انتهاك_التقاط_خيط = {
                                    النطاق: نطاق_الظهور, الصنف: صنف_انتهاك_التقاط_خيط.مشترك_غير_ذري(),
                                    الرمز: الرمز, النوع: اختياري.موجود(الداخل)
                                };
                                أرجع اختياري.موجود(الانتهاك);
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ظهور_في_كتلة_غير_آمنة(السياق: &سياق_فحص_خيطي, الإغلاق: نطاق, الظهور: نطاق): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).كتل_غير_آمنة) مثل طبيعي)) {
        دع الكتلة: نطاق = (*السياق).كتل_غير_آمنة[ف];
        إذا (نطاق_يحتوي_خيطي(الإغلاق, الكتلة) && نطاق_يحتوي_خيطي(الكتلة, الظهور)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Check one closure literal handed to another thread.
عرف افحص_إغلاق_مرسل(
    الإغلاق: نطاق,
    في_غير_آمن: منطقي,
    الروابط: &سياق_روابط_أسماء,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    أنواع_الرموز: &سياق_أنواع_رموز,
    السياق: &سياق_فحص_خيطي
): اختياري انتهاك_التقاط_خيط {
    طابق التقاطات_إغلاق_عند(أنواع_التعبيرات, الإغلاق) مع
    | اختياري.موجود(الالتقاطات) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الالتقاطات) مثل طبيعي)) {
            دع الرمز: معرف_رمز = الالتقاطات[ف];
            إذا ((الرمز.القيمة مثل طبيعي) < (الطول((*أنواع_الرموز).الأنواع) مثل طبيعي)) {
                طابق (*أنواع_الرموز).الأنواع[الرمز.القيمة] مع
                | اختياري.موجود(النوع) -> {
                    دع الجارية: متغير متجه طبيعي = [];
                    دع الصنف: متغير اختياري صنف_انتهاك_التقاط_خيط = اختياري.لا_شيء();
                    طابق صنف_نوع_خيطي(الأنواع, النوع, &متغير الجارية) مع
                    | حالة_نوع_خيطي.فيه_مرجع -> { الصنف := اختياري.موجود(صنف_انتهاك_التقاط_خيط.مرجع_مستعار()); }
                    | حالة_نوع_خيطي.فيه_مؤشر -> {
                        إذا (!في_غير_آمن) { الصنف := اختياري.موجود(صنف_انتهاك_التقاط_خيط.مؤشر_خام()); };
                    }
                    | حالة_نوع_خيطي.آمن -> { };
                    طابق الصنف مع
                    | اختياري.موجود(الفئة) -> {
                        دع الانتهاك: انتهاك_التقاط_خيط = {
                            النطاق: أول_استخدام_في_نطاق(الروابط, الرمز, الإغلاق), الصنف: الفئة,
                            الرمز: الرمز, النوع: اختياري.موجود(النوع)
                        };
                        أرجع اختياري.موجود(الانتهاك);
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            };
            ف := ف + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    أرجع أول_عالمي_متغير_في_إغلاق(الروابط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, السياق, الإغلاق);
}

// The first closure literal handed to another thread that captures what it
// may not, in unit order.
عام عرف أول_انتهاك_التقاط_خيط_في_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    أنواع_الرموز: &سياق_أنواع_رموز,
    الروابط: &متجه سياق_روابط_أسماء,
    سياق_الأسماء: &سياق_أسماء
): اختياري انتهاك_التقاط_خيط {
    دع البدائيات: متجه معرف_رمز = رموز_البدائيات_المرسلة(سياق_الأسماء);
    إذا (!يوجد_بدائي_مرسل(الروابط, &البدائيات)) { أرجع اختياري.لا_شيء(); };
    دع بلا_دوال: متجه دالة_خيطية = [];
    دع بلا_رموز: متجه ط32 = [];
    دع بلا_نداءات: متجه نداء_خيطي = [];
    دع بلا_كتل: متجه نطاق = [];
    دع السياق: متغير سياق_فحص_خيطي = {
        الدوال: بلا_دوال, دالة_الرمز: بلا_رموز, النداءات: بلا_نداءات, كتل_غير_آمنة: بلا_كتل,
        البدائيات_المرسلة: البدائيات
    };
    اجمع_دوال_خيطية(الوحدات, الروابط, سياق_الأسماء, &متغير السياق);
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي) && و < (الطول(*أنواع_التعبيرات) مثل طبيعي) && و < (الطول(*الروابط) مثل طبيعي)) {
        دع العناصر: &متجه عنصر_وحدة = &(*الوحدات)[و].العناصر;
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول(*العناصر) مثل طبيعي)) {
            طابق (*العناصر)[ع] مع
            | عنصر_وحدة.دالة(التصريح) -> {
                طابق التصريح.الجسم مع
                | اختياري.موجود(الجسم) -> {
                    دع الدالة: متغير اختياري طبيعي = اختياري.لا_شيء();
                    طابق رمز_اسم_محلول_عند(&(*الروابط)[و], التصريح.الاسم.النطاق) مع
                    | اختياري.موجود(الرمز) -> {
                        إذا ((الرمز.القيمة مثل طبيعي) < (الطول(السياق.دالة_الرمز) مثل طبيعي)) {
                            دع الموضع: طبيعي = السياق.دالة_الرمز[الرمز.القيمة];
                            إذا (الموضع > 0) { الدالة := اختياري.موجود(الموضع - 1); };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    امش_كتلة_خيطية(
                        &الجسم, و, &(*الروابط)[و], &(*أنواع_التعبيرات)[و], سياق_الأسماء, &متغير السياق,
                        الدالة, خطأ, خطأ
                    );
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ع := ع + 1;
        }
        و := و + 1;
    }
    انشر_المعاملات_المرسلة(&متغير السياق);
    دع ن: متغير طبيعي = 0;
    طالما (ن < (الطول(السياق.النداءات) مثل طبيعي)) {
        دع النداء: &نداء_خيطي = &السياق.النداءات[ن];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*النداء).الحجج) مثل طبيعي)) {
            طابق (*النداء).الحجج[ح] مع
            | حجة_نداء_خيطي.إغلاق(نطاق_الإغلاق) -> {
                دع مرسلة: متغير منطقي = (*النداء).بدائي_مرسل;
                طابق (*النداء).المستدعى مع
                | اختياري.موجود(المستدعاة) -> {
                    إذا (ح < (الطول(السياق.الدوال[المستدعاة].المرسلة) مثل طبيعي)) {
                        إذا (السياق.الدوال[المستدعاة].المرسلة[ح]) { مرسلة := صواب; };
                    };
                }
                | اختياري.لا_شيء -> { };
                إذا (مرسلة) {
                    دع الوحدة: طبيعي = (*النداء).الوحدة;
                    طابق افحص_إغلاق_مرسل(
                        نطاق_الإغلاق, (*النداء).في_غير_آمن, &(*الروابط)[الوحدة], سياق_الأسماء, الأنواع,
                        &(*أنواع_التعبيرات)[الوحدة], أنواع_الرموز, &السياق
                    ) مع
                    | اختياري.موجود(الانتهاك) -> { أرجع اختياري.موجود(الانتهاك); }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
            ح := ح + 1;
        }
        ن := ن + 1;
    }
    أرجع اختياري.لا_شيء();
}
