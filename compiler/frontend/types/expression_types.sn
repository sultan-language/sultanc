        (*السياق).فهرس_الإغلاقات := أعد_بناء_فهرس_نطاق_تعبير(&(*السياق).فهرس_الإغلاقات, المطلوبة);
    };
    دع الهاش: غير_موقع = هاش_نطاق_تعبير(النطاق);
    دع المدخل: مدخل_فهرس_نطاق_تعبير = { الهاش: الهاش, النطاق: النطاق, الموضع: الموضع };
    طابق موضع_إدراج_فهرس_نطاق_تعبير(&(*السياق).فهرس_الإغلاقات, النطاق) مع
    | اختيار.بعض(الموقع) -> {
        طابق (*السياق).فهرس_الإغلاقات[الموقع] مع
        | اختيار.لا_شيء -> { (*السياق).فهرس_الإغلاقات[الموقع] := اختيار.بعض(المدخل); }
        | اختيار.بعض(_) -> { };
    }
    | اختيار.لا_شيء -> { };
}

عام عرف سياق_أنواع_تعبيرات_جديد(): سياق_أنواع_تعبيرات {
    دع الحقائق: متجه حقيقة_تعبير_نوعية = [];
    دع الاستدعاءات: متجه حقيقة_استدعاء_نوعية = [];
    دع الإغلاقات: متجه حقيقة_إغلاق_نوعية = [];
    دع فهرس_الحقائق: متجه اختيار مدخل_فهرس_نطاق_تعبير = [];
    دع فهرس_المنشئات: متجه اختيار مدخل_فهرس_نطاق_تعبير = [];
    دع فهرس_الاستدعاءات: متجه اختيار مدخل_فهرس_نطاق_تعبير = [];
    دع فهرس_الإغلاقات: متجه اختيار مدخل_فهرس_نطاق_تعبير = [];
    دع السياق: سياق_أنواع_تعبيرات = {
        الحقائق: الحقائق,
        الاستدعاءات: الاستدعاءات,
        الإغلاقات: الإغلاقات,
        فهرس_الحقائق: فهرس_الحقائق,
        فهرس_المنشئات: فهرس_المنشئات,
        فهرس_الاستدعاءات: فهرس_الاستدعاءات,
        فهرس_الإغلاقات: فهرس_الإغلاقات
    };
    أرجع السياق;
}

عام عرف سياق_أنواع_تعبيرات_من_حقائق(
    الحقائق: متجه حقيقة_تعبير_نوعية,
    الاستدعاءات: متجه حقيقة_استدعاء_نوعية,
    الإغلاقات: متجه حقيقة_إغلاق_نوعية
): سياق_أنواع_تعبيرات {
    دع السياق: متغير سياق_أنواع_تعبيرات = سياق_أنواع_تعبيرات_جديد();
    السياق.الحقائق := الحقائق;
    السياق.الاستدعاءات := الاستدعاءات;
    السياق.الإغلاقات := الإغلاقات;

    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(السياق.الحقائق) مثل غير_موقع)) {
        سجل_نطاق_تعبير_في_فهرس(&متغير السياق.فهرس_الحقائق, ف + 1, السياق.الحقائق[ف].النطاق, ف);
        طابق السياق.الحقائق[ف].نطاق_المنشئ مع
        | اختيار.بعض(نطاق_المنشئ) -> {
            سجل_نطاق_تعبير_في_فهرس(&متغير السياق.فهرس_المنشئات, ف + 1, نطاق_المنشئ, ف);
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(السياق.الاستدعاءات) مثل غير_موقع)) {
        سجل_نطاق_تعبير_في_فهرس(&متغير السياق.فهرس_الاستدعاءات, ف + 1, السياق.الاستدعاءات[ف].النطاق, ف);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(السياق.الإغلاقات) مثل غير_موقع)) {
        سجل_نطاق_تعبير_في_فهرس(&متغير السياق.فهرس_الإغلاقات, ف + 1, السياق.الإغلاقات[ف].النطاق, ف);
        ف := ف + 1;
    }
    أرجع السياق;
}


عام عرف أضف_حقيقة_إغلاق(
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    الالتقاطات: متجه معرف_رمز
): فراغ {
    دع الحقيقة: حقيقة_إغلاق_نوعية = { النطاق: النطاق, الالتقاطات: الالتقاطات };
    دع الموضع: غير_موقع = الطول((*السياق).الإغلاقات) مثل غير_موقع;
    ألحق((*السياق).الإغلاقات, الحقيقة);
    سجل_إغلاق_تعبير_في_الفهرس(السياق, الموضع + 1, النطاق, الموضع);
}

عام عرف التقاطات_إغلاق_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختيار متجه معرف_رمز {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_الإغلاقات, النطاق) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        لو (الموضع >= (الطول((*السياق).الإغلاقات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
        دع الناتج: متغير متجه معرف_رمز = [];
        دع ح: متغير غير_موقع = 0;
        بينما (ح < (الطول((*السياق).الإغلاقات[الموضع].الالتقاطات) مثل غير_موقع)) {
            ألحق(الناتج, (*السياق).الإغلاقات[الموضع].الالتقاطات[ح]);
            ح := ح + 1;
        }
        أرجع اختيار.بعض(الناتج);
    };
}

عام عرف أضف_استدعاء_نوعيا(
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    نوع_المستدعى: معرف_نوع,
    الرمز: اختيار معرف_رمز,
    نطاقات_الحجج: متجه نطاق,
    استبدالات_النوع: متجه ربط_استبدال_نوع
): فراغ {
    دع الحقيقة: حقيقة_استدعاء_نوعية = {
        النطاق: النطاق,
        نوع_المستدعى: نوع_المستدعى,
        الرمز: الرمز,
        نطاقات_الحجج: نطاقات_الحجج,
        استبدالات_النوع: استبدالات_النوع
    };
    دع الموضع: غير_موقع = الطول((*السياق).الاستدعاءات) مثل غير_موقع;
    ألحق((*السياق).الاستدعاءات, الحقيقة);
    سجل_استدعاء_تعبير_في_الفهرس(السياق, الموضع + 1, النطاق, الموضع);
}

عام عرف استبدالات_نوع_استدعاء_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختيار متجه ربط_استبدال_نوع {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_الاستدعاءات, النطاق) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        لو (الموضع >= (الطول((*السياق).الاستدعاءات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
        دع الناتج: متغير متجه ربط_استبدال_نوع = [];
        دع ي: متغير غير_موقع = 0;
        بينما (ي < (الطول((*السياق).الاستدعاءات[الموضع].استبدالات_النوع) مثل غير_موقع)) {
            ألحق(الناتج, (*السياق).الاستدعاءات[الموضع].استبدالات_النوع[ي]);
            ي := ي + 1;
        }
        أرجع اختيار.بعض(الناتج);
    };
}

عرف حجة_نشطة_لاستدعاء_عند_بايت(
    الحقيقة: &حقيقة_استدعاء_نوعية,
    المصدر: غير_موقع,
    البايت: غير_موقع
): غير_موقع {
    دع العدد: غير_موقع = الطول((*الحقيقة).نطاقات_الحجج) مثل غير_موقع;
    لو (العدد == 0) { أرجع 0; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع النطاق: نطاق = (*الحقيقة).نطاقات_الحجج[ف];
        لو (نطاق_يحتوي_بايتا(النطاق, المصدر, البايت)) { أرجع ف; };
        لو ((النطاق.البداية.المصدر == المصدر) && (البايت < النطاق.البداية.البايت)) {
            أرجع ف;
        };
        ف := ف + 1;
    }
    أرجع العدد - 1;
}

// Type-owned call-site query. Nested calls choose the narrowest containing call.
عام عرف استدعاء_عند_بايت(
    السياق: &سياق_أنواع_تعبيرات,
    المصدر: غير_موقع,
    البايت: غير_موقع
): اختيار استعلام_استدعاء_دلالي {
    دع الأفضل: متغير اختيار استعلام_استدعاء_دلالي = اختيار.لا_شيء();
    دع أفضل_طول: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*السياق).الاستدعاءات) مثل غير_موقع)) {
        دع مرجع_الحقيقة: &حقيقة_استدعاء_نوعية = &(*السياق).الاستدعاءات[ف];
        لو (نطاق_يحتوي_بايتا((*مرجع_الحقيقة).النطاق, المصدر, البايت)) {
            دع طول_الحالي: غير_موقع = طول_نطاق_بالبايت((*مرجع_الحقيقة).النطاق);
            دع اختر: متغير منطقي = خطأ;
            طابق الأفضل مع
            | اختيار.لا_شيء -> { اختر := صواب; }
            | اختيار.بعض(_) -> { لو (طول_الحالي < أفضل_طول) { اختر := صواب; }; };
            لو (اختر) {
                دع الحجة_النشطة: غير_موقع = حجة_نشطة_لاستدعاء_عند_بايت(
                    مرجع_الحقيقة, المصدر, البايت
                );
                دع نطاق_الاستدعاء: نطاق = (*مرجع_الحقيقة).النطاق;
                دع نوع_المستدعى: معرف_نوع = (*مرجع_الحقيقة).نوع_المستدعى;
                دع رمز_المستدعى: اختيار معرف_رمز = (*مرجع_الحقيقة).الرمز;
                دع الاستعلام: استعلام_استدعاء_دلالي = {
                    النطاق: نطاق_الاستدعاء,
                    نوع_المستدعى: نوع_المستدعى,
                    الرمز: رمز_المستدعى,
                    الحجة_النشطة: الحجة_النشطة
                };
                الأفضل := اختيار.بعض(الاستعلام);
                أفضل_طول := طول_الحالي;
            };
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}

عام عرف أضف_نوع_تعبير(
    سجل_الأنواع: &سجل_أنواع,
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    النوع: معرف_نوع
): منطقي {
    دع بلا_نطاق_منشئ: اختيار نطاق = اختيار.لا_شيء();
    دع بلا_منشئ: اختيار هوية_منشئ_نوع = اختيار.لا_شيء();
    دع الحقيقة: حقيقة_تعبير_نوعية = {
        النطاق: النطاق,
        النوع: النوع,
        نطاق_المنشئ: بلا_نطاق_منشئ,
        المنشئ: بلا_منشئ
    };
    دع الموضع: غير_موقع = الطول((*السياق).الحقائق) مثل غير_موقع;
    ألحق((*السياق).الحقائق, الحقيقة);
    سجل_حقيقة_تعبير_في_الفهرس(السياق, الموضع + 1, النطاق, الموضع);
    أرجع صواب;
}

// Constructor calls/field occurrences are recorded atomically with their already-known TypeID.
// The constructor source span is retained only as the lookup identity used by lowering.
عام عرف أضف_نوع_تعبير_بمنشئ(
    سجل_الأنواع: &سجل_أنواع,
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    النوع: معرف_نوع,
    نطاق_المنشئ: نطاق,
    الهوية: هوية_منشئ_نوع
): منطقي {
    دع نطاق_منشئ: اختيار نطاق = اختيار.بعض(نطاق_المنشئ);
    دع منشئ: اختيار هوية_منشئ_نوع = اختيار.بعض(الهوية);
    دع الحقيقة: حقيقة_تعبير_نوعية = {
        النطاق: النطاق,
        النوع: النوع,
        نطاق_المنشئ: نطاق_منشئ,
        المنشئ: منشئ
    };
    دع الموضع: غير_موقع = الطول((*السياق).الحقائق) مثل غير_موقع;
    ألحق((*السياق).الحقائق, الحقيقة);
    سجل_حقيقة_تعبير_في_الفهرس(السياق, الموضع + 1, النطاق, الموضع);
    سجل_منشئ_تعبير_في_الفهرس(السياق, الموضع + 1, نطاق_المنشئ, الموضع);
    أرجع صواب;
}

عام عرف نوع_تعبير_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختيار معرف_نوع {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_الحقائق, النطاق) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        لو (الموضع >= (الطول((*السياق).الحقائق) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض((*السياق).الحقائق[الموضع].النوع);
    };
}

عام عرف هوية_منشئ_تعبير_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختيار هوية_منشئ_نوع {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_المنشئات, النطاق) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        لو (الموضع >= (الطول((*السياق).الحقائق) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
        أرجع (*السياق).الحقائق[الموضع].المنشئ;
    };
}

// Type-owned point query. Nested expressions choose the narrowest typed expression.
عام عرف نوع_تعبير_عند_بايت(
    السياق: &سياق_أنواع_تعبيرات,
    المصدر: غير_موقع,
    البايت: غير_موقع
): اختيار معرف_نوع {
    دع الأفضل: متغير اختيار معرف_نوع = اختيار.لا_شيء();
    دع أفضل_طول: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*السياق).الحقائق) مثل غير_موقع)) {
        دع مرجع_الحقيقة: &حقيقة_تعبير_نوعية = &(*السياق).الحقائق[ف];
        لو (نطاق_يحتوي_بايتا((*مرجع_الحقيقة).النطاق, المصدر, البايت)) {
            دع طول_الحالي: غير_موقع = طول_نطاق_بالبايت((*مرجع_الحقيقة).النطاق);
            دع اختر: متغير منطقي = خطأ;
            طابق الأفضل مع
            | اختيار.لا_شيء -> { اختر := صواب; }
            | اختيار.بعض(_) -> { لو (طول_الحالي < أفضل_طول) { اختر := صواب; }; };
            لو (اختر) {
                الأفضل := اختيار.بعض((*مرجع_الحقيقة).النوع);
                أفضل_طول := طول_الحالي;
            };
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}
