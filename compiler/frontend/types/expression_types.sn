        (*السياق).فهرس_الاستدعاءات := أعد_بناء_فهرس_نطاق_تعبير(&(*السياق).فهرس_الاستدعاءات, المطلوبة);
    };
    دع الهاش: غير_موقع = هاش_نطاق_تعبير(النطاق);
