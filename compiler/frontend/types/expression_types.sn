استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.names.identifiers;
استورد compiler.source.span;

استورد compiler.frontend.types.type_context;
// Type owns one semantic fact per typed expression occurrence.  Constructor identity,
// when present, belongs to that same typed occurrence rather than a parallel span table.
عام نوع حقيقة_تعبير_نوعية = {
    النطاق: نطاق,
    النوع: معرف_نوع,
    نطاق_المنشئ: اختياري نطاق,
    المنشئ: اختياري هوية_منشئ_نوع
};

عام نوع حقيقة_إغلاق_نوعية = {
    النطاق: نطاق,
    الالتقاطات: متجه معرف_رمز
};

عام نوع حقيقة_استدعاء_نوعية = {
    النطاق: نطاق,
    نوع_المستدعى: معرف_نوع,
    الرمز: اختياري معرف_رمز,
    نطاقات_الحجج: متجه نطاق,
    استبدالات_النوع: متجه ربط_استبدال_نوع
};

// A cast between a raw pointer and a 32-bit integer (`p as u32`, `w as *T`):
// an address word only on a target with 32-bit pointers. The Type pass is
// target-neutral, so it records each such cast; the frontend checks them
// against the selected target once the Types are built.
عام نوع حقيقة_تحويل_عنوان_32 = {
    النطاق: نطاق,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
};

عام نوع استعلام_استدعاء_دلالي = {
    النطاق: نطاق,
    نوع_المستدعى: معرف_نوع,
    الرمز: اختياري معرف_رمز,
    الحجة_النشطة: طبيعي
};

// Index cells hold a 1-based canonical fact position; zero denotes empty.
// A position is 32-bit, checked where a cell is written (ط32_متحقق).
// This avoids retaining per-cell hash, span, and option-tag metadata.
نوع صنف_فهرس_نطاق_تعبير =
    | حقائق
    | منشئات
    | استدعاءات
    | إغلاقات
;

عام نوع سياق_أنواع_تعبيرات = {
    الحقائق: متجه حقيقة_تعبير_نوعية,
    الاستدعاءات: متجه حقيقة_استدعاء_نوعية,
    الإغلاقات: متجه حقيقة_إغلاق_نوعية,
    فهرس_الحقائق: متجه ط32,
    فهرس_المنشئات: متجه ط32,
    فهرس_الاستدعاءات: متجه ط32,
    فهرس_الإغلاقات: متجه ط32,
    تحويلات_عنوان_32: متجه حقيقة_تحويل_عنوان_32
};


عرف امزج_هاش_نطاق_تعبير(الهاش: طبيعي, القيمة: طبيعي): طبيعي {
    أرجع ((الهاش * 257) + (القيمة % 1048573)) % 1048573;
}

عرف هاش_نطاق_تعبير(النطاق: نطاق): طبيعي {
    دع الهاش: متغير طبيعي = امزج_هاش_نطاق_تعبير(1, النطاق.البداية.المصدر);
    الهاش := امزج_هاش_نطاق_تعبير(الهاش, النطاق.البداية.البايت);
    الهاش := امزج_هاش_نطاق_تعبير(الهاش, النطاق.النهاية.المصدر);
    الهاش := امزج_هاش_نطاق_تعبير(الهاش, النطاق.النهاية.البايت);
    أرجع الهاش;
}

عرف ابن_فهرس_نطاقات_تعبير_فارغا(السعة: طبيعي): متجه ط32 {
    دع الناتج: متغير متجه ط32 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الناتج, 0); ف := ف + 1; }
    أرجع الناتج;
}

// Resolve an index slot against its sole canonical span owner. Keeping the
// full span in every hash cell used to duplicate four machine words per slot.
عرف نطاق_مدخل_فهرس_تعبير(
    السياق: &سياق_أنواع_تعبيرات,
    الصنف: صنف_فهرس_نطاق_تعبير,
    الموضع: طبيعي
): اختياري نطاق {
    طابق الصنف مع
    | صنف_فهرس_نطاق_تعبير.حقائق -> {
        إذا (الموضع < (الطول((*السياق).الحقائق) مثل طبيعي)) {
            أرجع اختياري.موجود((*السياق).الحقائق[الموضع].النطاق);
        };
    }
    | صنف_فهرس_نطاق_تعبير.منشئات -> {
        إذا (الموضع < (الطول((*السياق).الحقائق) مثل طبيعي)) {
            أرجع (*السياق).الحقائق[الموضع].نطاق_المنشئ;
        };
    }
    | صنف_فهرس_نطاق_تعبير.استدعاءات -> {
        إذا (الموضع < (الطول((*السياق).الاستدعاءات) مثل طبيعي)) {
            أرجع اختياري.موجود((*السياق).الاستدعاءات[الموضع].النطاق);
        };
    }
    | صنف_فهرس_نطاق_تعبير.إغلاقات -> {
        إذا (الموضع < (الطول((*السياق).الإغلاقات) مثل طبيعي)) {
            أرجع اختياري.موجود((*السياق).الإغلاقات[الموضع].النطاق);
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف موضع_إدراج_فهرس_نطاق_تعبير(
    الفهرس: &متجه ط32,
    السياق: &سياق_أنواع_تعبيرات,
    الصنف: صنف_فهرس_نطاق_تعبير,
    النطاق: نطاق
): اختياري طبيعي {
    دع السعة: طبيعي = الطول(*الفهرس) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_نطاق_تعبير(النطاق);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        دع المسجل: طبيعي = (*الفهرس)[الموضع];
        إذا (المسجل == 0) { أرجع اختياري.موجود(الموضع); };
        طابق نطاق_مدخل_فهرس_تعبير(السياق, الصنف, المسجل - 1) مع
        | اختياري.موجود(نطاق_مسجل) -> {
            إذا (نطاقان_متساويان(نطاق_مسجل, النطاق)) {
                أرجع اختياري.موجود(الموضع);
            };
        }
        | اختياري.لا_شيء -> { };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أدرج_فهرس_نطاق_تعبير(
    الفهرس: &متغير متجه ط32,
    السياق: &سياق_أنواع_تعبيرات,
    الصنف: صنف_فهرس_نطاق_تعبير,
    النطاق: نطاق,
    الموضع_الحقيقي: طبيعي
): فراغ {
    طابق موضع_إدراج_فهرس_نطاق_تعبير(الفهرس, السياق, الصنف, النطاق) مع
    | اختياري.موجود(الموضع) -> {
        إذا ((*الفهرس)[الموضع] == 0) {
            (*الفهرس)[الموضع] := ط32_متحقق(الموضع_الحقيقي + 1);
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف موضع_نطاق_تعبير_مفهرس(
    الفهرس: &متجه ط32,
    السياق: &سياق_أنواع_تعبيرات,
    الصنف: صنف_فهرس_نطاق_تعبير,
    النطاق: نطاق
): اختياري طبيعي {
    دع السعة: طبيعي = الطول(*الفهرس) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_نطاق_تعبير(النطاق);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        دع المسجل: طبيعي = (*الفهرس)[الموضع];
        إذا (المسجل == 0) { أرجع اختياري.لا_شيء(); };
        طابق نطاق_مدخل_فهرس_تعبير(السياق, الصنف, المسجل - 1) مع
        | اختياري.موجود(نطاق_مسجل) -> {
            إذا (نطاقان_متساويان(نطاق_مسجل, النطاق)) {
                أرجع اختياري.موجود(المسجل - 1);
            };
        }
        | اختياري.لا_شيء -> { };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أعد_بناء_فهرس_نطاق_تعبير(
    القديم: &متجه ط32,
    السياق: &سياق_أنواع_تعبيرات,
    الصنف: صنف_فهرس_نطاق_تعبير,
    السعة: طبيعي
): متجه ط32 {
    دع الجديد: متغير متجه ط32 = ابن_فهرس_نطاقات_تعبير_فارغا(السعة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القديم) مثل طبيعي)) {
        دع المسجل: طبيعي = (*القديم)[ف];
        إذا (المسجل != 0) {
            طابق نطاق_مدخل_فهرس_تعبير(السياق, الصنف, المسجل - 1) مع
            | اختياري.موجود(النطاق) -> {
                أدرج_فهرس_نطاق_تعبير(&متغير الجديد, السياق, الصنف, النطاق, المسجل - 1);
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع الجديد;
}

عرف سعة_فهرس_نطاق_تعبير_مطلوبة(القديمة: طبيعي, العدد: طبيعي): طبيعي {
    دع تحتاج: متغير منطقي = القديمة == 0;
    إذا (!تحتاج) { تحتاج := (العدد * 3) >= (القديمة * 2); };
    إذا (!تحتاج) { أرجع القديمة; };
    إذا (القديمة == 0) { أرجع 16; };
    أرجع القديمة * 2;
}

عرف سجل_حقيقة_تعبير_في_الفهرس(
    السياق: &متغير سياق_أنواع_تعبيرات,
    العدد: طبيعي,
    النطاق: نطاق,
    الموضع: طبيعي
): فراغ {
    دع القديمة: طبيعي = الطول((*السياق).فهرس_الحقائق) مثل طبيعي;
    دع المطلوبة: طبيعي = سعة_فهرس_نطاق_تعبير_مطلوبة(القديمة, العدد);
    إذا (المطلوبة != القديمة) {
        دع المعاد: متجه ط32 = أعد_بناء_فهرس_نطاق_تعبير(
            &(*السياق).فهرس_الحقائق, السياق,
            صنف_فهرس_نطاق_تعبير.حقائق(), المطلوبة
        );
        (*السياق).فهرس_الحقائق := المعاد;
    };
    دع المدخل: ط32 = ط32_متحقق(الموضع + 1);
    طابق موضع_إدراج_فهرس_نطاق_تعبير(
        &(*السياق).فهرس_الحقائق, السياق, صنف_فهرس_نطاق_تعبير.حقائق(), النطاق
    ) مع
    | اختياري.موجود(الموقع) -> {
        إذا ((*السياق).فهرس_الحقائق[الموقع] == 0) {
            (*السياق).فهرس_الحقائق[الموقع] := المدخل;
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف سجل_منشئ_تعبير_في_الفهرس(
    السياق: &متغير سياق_أنواع_تعبيرات,
    العدد: طبيعي,
    النطاق: نطاق,
    الموضع: طبيعي
): فراغ {
    دع القديمة: طبيعي = الطول((*السياق).فهرس_المنشئات) مثل طبيعي;
    دع المطلوبة: طبيعي = سعة_فهرس_نطاق_تعبير_مطلوبة(القديمة, العدد);
    إذا (المطلوبة != القديمة) {
        دع المعاد: متجه ط32 = أعد_بناء_فهرس_نطاق_تعبير(
            &(*السياق).فهرس_المنشئات, السياق,
            صنف_فهرس_نطاق_تعبير.منشئات(), المطلوبة
        );
        (*السياق).فهرس_المنشئات := المعاد;
    };
    دع المدخل: ط32 = ط32_متحقق(الموضع + 1);
    طابق موضع_إدراج_فهرس_نطاق_تعبير(
        &(*السياق).فهرس_المنشئات, السياق, صنف_فهرس_نطاق_تعبير.منشئات(), النطاق
    ) مع
    | اختياري.موجود(الموقع) -> {
        إذا ((*السياق).فهرس_المنشئات[الموقع] == 0) {
            (*السياق).فهرس_المنشئات[الموقع] := المدخل;
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف سجل_استدعاء_تعبير_في_الفهرس(
    السياق: &متغير سياق_أنواع_تعبيرات,
    العدد: طبيعي,
    النطاق: نطاق,
    الموضع: طبيعي
): فراغ {
    دع القديمة: طبيعي = الطول((*السياق).فهرس_الاستدعاءات) مثل طبيعي;
    دع المطلوبة: طبيعي = سعة_فهرس_نطاق_تعبير_مطلوبة(القديمة, العدد);
    إذا (المطلوبة != القديمة) {
        دع المعاد: متجه ط32 = أعد_بناء_فهرس_نطاق_تعبير(
            &(*السياق).فهرس_الاستدعاءات, السياق,
            صنف_فهرس_نطاق_تعبير.استدعاءات(), المطلوبة
        );
        (*السياق).فهرس_الاستدعاءات := المعاد;
    };
    دع المدخل: ط32 = ط32_متحقق(الموضع + 1);
    طابق موضع_إدراج_فهرس_نطاق_تعبير(
        &(*السياق).فهرس_الاستدعاءات, السياق, صنف_فهرس_نطاق_تعبير.استدعاءات(), النطاق
    ) مع
    | اختياري.موجود(الموقع) -> {
        إذا ((*السياق).فهرس_الاستدعاءات[الموقع] == 0) {
            (*السياق).فهرس_الاستدعاءات[الموقع] := المدخل;
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف سجل_إغلاق_تعبير_في_الفهرس(
    السياق: &متغير سياق_أنواع_تعبيرات,
    العدد: طبيعي,
    النطاق: نطاق,
    الموضع: طبيعي
): فراغ {
    دع القديمة: طبيعي = الطول((*السياق).فهرس_الإغلاقات) مثل طبيعي;
    دع المطلوبة: طبيعي = سعة_فهرس_نطاق_تعبير_مطلوبة(القديمة, العدد);
    إذا (المطلوبة != القديمة) {
        دع المعاد: متجه ط32 = أعد_بناء_فهرس_نطاق_تعبير(
            &(*السياق).فهرس_الإغلاقات, السياق,
            صنف_فهرس_نطاق_تعبير.إغلاقات(), المطلوبة
        );
        (*السياق).فهرس_الإغلاقات := المعاد;
    };
    دع المدخل: ط32 = ط32_متحقق(الموضع + 1);
    طابق موضع_إدراج_فهرس_نطاق_تعبير(
        &(*السياق).فهرس_الإغلاقات, السياق, صنف_فهرس_نطاق_تعبير.إغلاقات(), النطاق
    ) مع
    | اختياري.موجود(الموقع) -> {
        إذا ((*السياق).فهرس_الإغلاقات[الموقع] == 0) {
            (*السياق).فهرس_الإغلاقات[الموقع] := المدخل;
        };
    }
    | اختياري.لا_شيء -> { };
}

عام عرف سياق_أنواع_تعبيرات_جديد(): سياق_أنواع_تعبيرات {
    دع الحقائق: متجه حقيقة_تعبير_نوعية = [];
    دع الاستدعاءات: متجه حقيقة_استدعاء_نوعية = [];
    دع الإغلاقات: متجه حقيقة_إغلاق_نوعية = [];
    دع فهرس_الحقائق: متجه ط32 = [];
    دع فهرس_المنشئات: متجه ط32 = [];
    دع فهرس_الاستدعاءات: متجه ط32 = [];
    دع فهرس_الإغلاقات: متجه ط32 = [];
    دع تحويلات_عنوان_32: متجه حقيقة_تحويل_عنوان_32 = [];
    دع السياق: سياق_أنواع_تعبيرات = {
        الحقائق: الحقائق,
        الاستدعاءات: الاستدعاءات,
        الإغلاقات: الإغلاقات,
        فهرس_الحقائق: فهرس_الحقائق,
        فهرس_المنشئات: فهرس_المنشئات,
        فهرس_الاستدعاءات: فهرس_الاستدعاءات,
        فهرس_الإغلاقات: فهرس_الإغلاقات,
        تحويلات_عنوان_32: تحويلات_عنوان_32
    };
    أرجع السياق;
}

عام عرف أضف_تحويل_عنوان_32(
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): فراغ {
    دع الحقيقة: حقيقة_تحويل_عنوان_32 = { النطاق: النطاق, المصدر: المصدر, الهدف: الهدف };
    ألحق((*السياق).تحويلات_عنوان_32, الحقيقة);
}

عام عرف سياق_أنواع_تعبيرات_من_حقائق(
    الحقائق: متجه حقيقة_تعبير_نوعية,
    الاستدعاءات: متجه حقيقة_استدعاء_نوعية,
    الإغلاقات: متجه حقيقة_إغلاق_نوعية
): سياق_أنواع_تعبيرات {
    دع السياق: متغير سياق_أنواع_تعبيرات = سياق_أنواع_تعبيرات_جديد();
    السياق.الحقائق := الحقائق;
    السياق.الاستدعاءات := الاستدعاءات;
    السياق.الإغلاقات := الإغلاقات;

    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(السياق.الحقائق) مثل طبيعي)) {
        سجل_حقيقة_تعبير_في_الفهرس(&متغير السياق, ف + 1, السياق.الحقائق[ف].النطاق, ف);
        طابق السياق.الحقائق[ف].نطاق_المنشئ مع
        | اختياري.موجود(نطاق_المنشئ) -> {
            سجل_منشئ_تعبير_في_الفهرس(&متغير السياق, ف + 1, نطاق_المنشئ, ف);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(السياق.الاستدعاءات) مثل طبيعي)) {
        سجل_استدعاء_تعبير_في_الفهرس(&متغير السياق, ف + 1, السياق.الاستدعاءات[ف].النطاق, ف);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(السياق.الإغلاقات) مثل طبيعي)) {
        سجل_إغلاق_تعبير_في_الفهرس(&متغير السياق, ف + 1, السياق.الإغلاقات[ف].النطاق, ف);
        ف := ف + 1;
    }
    أرجع السياق;
}


عام عرف أضف_حقيقة_إغلاق(
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    الالتقاطات: متجه معرف_رمز
): فراغ {
    دع الحقيقة: حقيقة_إغلاق_نوعية = { النطاق: النطاق, الالتقاطات: الالتقاطات };
    دع الموضع: طبيعي = الطول((*السياق).الإغلاقات) مثل طبيعي;
    ألحق((*السياق).الإغلاقات, الحقيقة);
    سجل_إغلاق_تعبير_في_الفهرس(السياق, الموضع + 1, النطاق, الموضع);
}

عام عرف التقاطات_إغلاق_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختياري متجه معرف_رمز {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_الإغلاقات, السياق, صنف_فهرس_نطاق_تعبير.إغلاقات(), النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع >= (الطول((*السياق).الإغلاقات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        دع الناتج: متغير متجه معرف_رمز = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*السياق).الإغلاقات[الموضع].الالتقاطات) مثل طبيعي)) {
            ألحق(الناتج, (*السياق).الإغلاقات[الموضع].الالتقاطات[ح]);
            ح := ح + 1;
        }
        أرجع اختياري.موجود(الناتج);
    };
}

عام عرف أضف_استدعاء_نوعيا(
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    نوع_المستدعى: معرف_نوع,
    الرمز: اختياري معرف_رمز,
    نطاقات_الحجج: متجه نطاق,
    استبدالات_النوع: متجه ربط_استبدال_نوع
): فراغ {
    دع الحقيقة: حقيقة_استدعاء_نوعية = {
        النطاق: النطاق,
        نوع_المستدعى: نوع_المستدعى,
        الرمز: الرمز,
        نطاقات_الحجج: نطاقات_الحجج,
        استبدالات_النوع: استبدالات_النوع
    };
    دع الموضع: طبيعي = الطول((*السياق).الاستدعاءات) مثل طبيعي;
    ألحق((*السياق).الاستدعاءات, الحقيقة);
    سجل_استدعاء_تعبير_في_الفهرس(السياق, الموضع + 1, النطاق, الموضع);
}

عام عرف استبدالات_نوع_استدعاء_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختياري متجه ربط_استبدال_نوع {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_الاستدعاءات, السياق, صنف_فهرس_نطاق_تعبير.استدعاءات(), النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع >= (الطول((*السياق).الاستدعاءات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        دع الناتج: متغير متجه ربط_استبدال_نوع = [];
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول((*السياق).الاستدعاءات[الموضع].استبدالات_النوع) مثل طبيعي)) {
            ألحق(الناتج, (*السياق).الاستدعاءات[الموضع].استبدالات_النوع[ي]);
            ي := ي + 1;
        }
        أرجع اختياري.موجود(الناتج);
    };
}

// The Type of the callee of the call at النطاق.
عام عرف نوع_مستدعى_استدعاء_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختياري معرف_نوع {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_الاستدعاءات, السياق, صنف_فهرس_نطاق_تعبير.استدعاءات(), النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع >= (الطول((*السياق).الاستدعاءات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود((*السياق).الاستدعاءات[الموضع].نوع_المستدعى);
    };
}

// The Symbol the call at النطاق resolved its callee to, when it names one.
عام عرف رمز_مستدعى_استدعاء_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختياري معرف_رمز {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_الاستدعاءات, السياق, صنف_فهرس_نطاق_تعبير.استدعاءات(), النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع >= (الطول((*السياق).الاستدعاءات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع (*السياق).الاستدعاءات[الموضع].الرمز;
    };
}

عرف حجة_نشطة_لاستدعاء_عند_بايت(
    الحقيقة: &حقيقة_استدعاء_نوعية,
    المصدر: طبيعي,
    البايت: طبيعي
): طبيعي {
    دع العدد: طبيعي = الطول((*الحقيقة).نطاقات_الحجج) مثل طبيعي;
    إذا (العدد == 0) { أرجع 0; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع النطاق: نطاق = (*الحقيقة).نطاقات_الحجج[ف];
        إذا (نطاق_يحتوي_بايتا(النطاق, المصدر, البايت)) { أرجع ف; };
        إذا (((النطاق.البداية.المصدر مثل طبيعي) == المصدر) && (البايت < (النطاق.البداية.البايت مثل طبيعي))) {
            أرجع ف;
        };
        ف := ف + 1;
    }
    أرجع العدد - 1;
}

// Type-owned call-site query. Nested calls choose the narrowest containing call.
عام عرف استدعاء_عند_بايت(
    السياق: &سياق_أنواع_تعبيرات,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري استعلام_استدعاء_دلالي {
    دع الأفضل: متغير اختياري استعلام_استدعاء_دلالي = اختياري.لا_شيء();
    دع أفضل_طول: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الاستدعاءات) مثل طبيعي)) {
        دع مرجع_الحقيقة: &حقيقة_استدعاء_نوعية = &(*السياق).الاستدعاءات[ف];
        إذا (نطاق_يحتوي_بايتا((*مرجع_الحقيقة).النطاق, المصدر, البايت)) {
            دع طول_الحالي: طبيعي = طول_نطاق_بالبايت((*مرجع_الحقيقة).النطاق);
            دع اختر: متغير منطقي = خطأ;
            طابق الأفضل مع
            | اختياري.لا_شيء -> { اختر := صواب; }
            | اختياري.موجود(_) -> { إذا (طول_الحالي < أفضل_طول) { اختر := صواب; }; };
            إذا (اختر) {
                دع الحجة_النشطة: طبيعي = حجة_نشطة_لاستدعاء_عند_بايت(
                    مرجع_الحقيقة, المصدر, البايت
                );
                دع نطاق_الاستدعاء: نطاق = (*مرجع_الحقيقة).النطاق;
                دع نوع_المستدعى: معرف_نوع = (*مرجع_الحقيقة).نوع_المستدعى;
                دع رمز_المستدعى: اختياري معرف_رمز = (*مرجع_الحقيقة).الرمز;
                دع الاستعلام: استعلام_استدعاء_دلالي = {
                    النطاق: نطاق_الاستدعاء,
                    نوع_المستدعى: نوع_المستدعى,
                    الرمز: رمز_المستدعى,
                    الحجة_النشطة: الحجة_النشطة
                };
                الأفضل := اختياري.موجود(الاستعلام);
                أفضل_طول := طول_الحالي;
            };
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}

عام عرف أضف_نوع_تعبير(
    سجل_الأنواع: &سجل_أنواع,
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    النوع: معرف_نوع
): منطقي {
    دع بلا_نطاق_منشئ: اختياري نطاق = اختياري.لا_شيء();
    دع بلا_منشئ: اختياري هوية_منشئ_نوع = اختياري.لا_شيء();
    دع الحقيقة: حقيقة_تعبير_نوعية = {
        النطاق: النطاق,
        النوع: النوع,
        نطاق_المنشئ: بلا_نطاق_منشئ,
        المنشئ: بلا_منشئ
    };
    دع الموضع: طبيعي = الطول((*السياق).الحقائق) مثل طبيعي;
    ألحق((*السياق).الحقائق, الحقيقة);
    سجل_حقيقة_تعبير_في_الفهرس(السياق, الموضع + 1, النطاق, الموضع);
    أرجع صواب;
}

// Constructor calls/field occurrences are recorded atomically with their already-known TypeID.
// The constructor source span is retained only as the lookup identity used by lowering.
عام عرف أضف_نوع_تعبير_بمنشئ(
    سجل_الأنواع: &سجل_أنواع,
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    النوع: معرف_نوع,
    نطاق_المنشئ: نطاق,
    الهوية: هوية_منشئ_نوع
): منطقي {
    دع نطاق_منشئ: اختياري نطاق = اختياري.موجود(نطاق_المنشئ);
    دع منشئ: اختياري هوية_منشئ_نوع = اختياري.موجود(الهوية);
    دع الحقيقة: حقيقة_تعبير_نوعية = {
        النطاق: النطاق,
        النوع: النوع,
        نطاق_المنشئ: نطاق_منشئ,
        المنشئ: منشئ
    };
    دع الموضع: طبيعي = الطول((*السياق).الحقائق) مثل طبيعي;
    ألحق((*السياق).الحقائق, الحقيقة);
    سجل_حقيقة_تعبير_في_الفهرس(السياق, الموضع + 1, النطاق, الموضع);
    سجل_منشئ_تعبير_في_الفهرس(السياق, الموضع + 1, نطاق_المنشئ, الموضع);
    أرجع صواب;
}

عام عرف نوع_تعبير_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختياري معرف_نوع {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_الحقائق, السياق, صنف_فهرس_نطاق_تعبير.حقائق(), النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع >= (الطول((*السياق).الحقائق) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود((*السياق).الحقائق[الموضع].النوع);
    };
}

عام عرف هوية_منشئ_تعبير_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختياري هوية_منشئ_نوع {
    طابق موضع_نطاق_تعبير_مفهرس(&(*السياق).فهرس_المنشئات, السياق, صنف_فهرس_نطاق_تعبير.منشئات(), النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع >= (الطول((*السياق).الحقائق) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع (*السياق).الحقائق[الموضع].المنشئ;
    };
}

// Type-owned point query. Nested expressions choose the narrowest typed expression.
عام عرف نوع_تعبير_عند_بايت(
    السياق: &سياق_أنواع_تعبيرات,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري معرف_نوع {
    دع الأفضل: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    دع أفضل_طول: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الحقائق) مثل طبيعي)) {
        دع مرجع_الحقيقة: &حقيقة_تعبير_نوعية = &(*السياق).الحقائق[ف];
        إذا (نطاق_يحتوي_بايتا((*مرجع_الحقيقة).النطاق, المصدر, البايت)) {
            دع طول_الحالي: طبيعي = طول_نطاق_بالبايت((*مرجع_الحقيقة).النطاق);
            دع اختر: متغير منطقي = خطأ;
            طابق الأفضل مع
            | اختياري.لا_شيء -> { اختر := صواب; }
            | اختياري.موجود(_) -> { إذا (طول_الحالي < أفضل_طول) { اختر := صواب; }; };
            إذا (اختر) {
                الأفضل := اختياري.موجود((*مرجع_الحقيقة).النوع);
                أفضل_طول := طول_الحالي;
            };
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}
