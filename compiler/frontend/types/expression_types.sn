استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;

استورد compiler.frontend.types.type_context;
// Type owns one semantic fact per typed expression occurrence.  Constructor identity,
// when present, belongs to that same typed occurrence rather than a parallel span table.
عام نوع حقيقة_تعبير_نوعية = {
    النطاق: نطاق,
    النوع: معرف_نوع,
    نطاق_المنشئ: اختيار نطاق,
    المنشئ: اختيار هوية_منشئ_نوع
};

عام نوع حقيقة_استدعاء_نوعية = {
    النطاق: نطاق,
    نوع_المستدعى: معرف_نوع,
    الرمز: اختيار معرف_رمز,
    نطاقات_الحجج: متجه نطاق,
    استبدالات_النوع: متجه ربط_استبدال_نوع
};

عام نوع استعلام_استدعاء_دلالي = {
    النطاق: نطاق,
    نوع_المستدعى: معرف_نوع,
    الرمز: اختيار معرف_رمز,
    الحجة_النشطة: غير_موقع
};

عام نوع سياق_أنواع_تعبيرات = {
    الحقائق: متجه حقيقة_تعبير_نوعية,
    الاستدعاءات: متجه حقيقة_استدعاء_نوعية
};


عرف نطاق_تعبير_نوعي_أصغر(أ: نطاق, ب: نطاق): منطقي {
    لو (أ.البداية.المصدر != ب.البداية.المصدر) {
        أرجع أ.البداية.المصدر < ب.البداية.المصدر;
    };
    لو (أ.البداية.البايت != ب.البداية.البايت) {
        أرجع أ.البداية.البايت < ب.البداية.البايت;
    };
    لو (أ.النهاية.المصدر != ب.النهاية.المصدر) {
        أرجع أ.النهاية.المصدر < ب.النهاية.المصدر;
    };
    أرجع أ.النهاية.البايت < ب.النهاية.البايت;
}

عرف موضع_إدراج_حقيقة_تعبير(
    الحقائق: &متجه حقيقة_تعبير_نوعية,
    النطاق: نطاق
): غير_موقع {
    دع الحالة: متجه حقيقة_تعبير_نوعية = *الحقائق;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(الحالة) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        لو (!نطاق_تعبير_نوعي_أصغر(النطاق, الحالة[الوسط].النطاق)) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عرف أدرج_حقيقة_تعبير_مرتبة(
    الحقائق: &متغير متجه حقيقة_تعبير_نوعية,
    الحقيقة: حقيقة_تعبير_نوعية
): فراغ {
    دع الحالة: متغير متجه حقيقة_تعبير_نوعية = *الحقائق;
    دع الموضع: غير_موقع = موضع_إدراج_حقيقة_تعبير(&الحالة, الحقيقة.النطاق);
    ألحق(الحالة, الحقيقة);
    دع ف: متغير غير_موقع = الطول(الحالة) مثل غير_موقع;
    ف := ف - 1;
    بينما (ف > الموضع) {
        دع السابق: متغير غير_موقع = ف;
        السابق := السابق - 1;
        الحالة[ف] := الحالة[السابق];
        ف := السابق;
    }
    الحالة[الموضع] := الحقيقة;
    *الحقائق := الحالة;
}

عرف موضع_حقيقة_تعبير_أولى(
    الحقائق: &متجه حقيقة_تعبير_نوعية,
    النطاق: نطاق
): غير_موقع {
    دع الحالة: متجه حقيقة_تعبير_نوعية = *الحقائق;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(الحالة) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        لو (نطاق_تعبير_نوعي_أصغر(الحالة[الوسط].النطاق, النطاق)) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع البداية;
}

عام عرف سياق_أنواع_تعبيرات_جديد(): سياق_أنواع_تعبيرات {
    دع الحقائق: متجه حقيقة_تعبير_نوعية = [];
    دع الاستدعاءات: متجه حقيقة_استدعاء_نوعية = [];
    دع السياق: سياق_أنواع_تعبيرات = {
        الحقائق: الحقائق,
        الاستدعاءات: الاستدعاءات
    };
    أرجع السياق;
}

عام عرف أضف_استدعاء_نوعيا(
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    نوع_المستدعى: معرف_نوع,
    الرمز: اختيار معرف_رمز,
    نطاقات_الحجج: متجه نطاق,
    استبدالات_النوع: متجه ربط_استبدال_نوع
): فراغ {
    دع الحالة: متغير سياق_أنواع_تعبيرات = *السياق;
    دع الحقيقة: حقيقة_استدعاء_نوعية = {
        النطاق: النطاق,
        نوع_المستدعى: نوع_المستدعى,
        الرمز: الرمز,
        نطاقات_الحجج: نطاقات_الحجج,
        استبدالات_النوع: استبدالات_النوع
    };
    ألحق(الحالة.الاستدعاءات, الحقيقة);
    *السياق := الحالة;
}

عام عرف استبدالات_نوع_استدعاء_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختيار متجه ربط_استبدال_نوع {
    دع الحالة: سياق_أنواع_تعبيرات = *السياق;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الاستدعاءات) مثل غير_موقع)) {
        دع مرجع_الحقيقة: &حقيقة_استدعاء_نوعية = &الحالة.الاستدعاءات[ف];
        دع الحقيقة: حقيقة_استدعاء_نوعية = *مرجع_الحقيقة;
        لو (نطاقان_متساويان(الحقيقة.النطاق, النطاق)) {
            دع الناتج: متغير متجه ربط_استبدال_نوع = [];
            دع ي: متغير غير_موقع = 0;
            بينما (ي < (الطول(الحقيقة.استبدالات_النوع) مثل غير_موقع)) {
                ألحق(الناتج, الحقيقة.استبدالات_النوع[ي]);
                ي := ي + 1;
            }
            أرجع اختيار.بعض(الناتج);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف حجة_نشطة_لاستدعاء_عند_بايت(
    الحقيقة: &حقيقة_استدعاء_نوعية,
    المصدر: غير_موقع,
    البايت: غير_موقع
): غير_موقع {
    دع القيمة: حقيقة_استدعاء_نوعية = *الحقيقة;
    دع مرجع_الحجج: &متجه نطاق = &القيمة.نطاقات_الحجج;
    دع الحجج: متجه نطاق = *مرجع_الحجج;
    دع العدد: غير_موقع = الطول(الحجج) مثل غير_موقع;
    لو (العدد == 0) { أرجع 0; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع النطاق: نطاق = الحجج[ف];
        لو (نطاق_يحتوي_بايتا(النطاق, المصدر, البايت)) { أرجع ف; };
        لو ((النطاق.البداية.المصدر == المصدر) && (البايت < النطاق.البداية.البايت)) {
            أرجع ف;
        };
        ف := ف + 1;
    }
    أرجع العدد - 1;
}

// Type-owned call-site query. Nested calls choose the narrowest containing call.
عام عرف استدعاء_عند_بايت(
    السياق: &سياق_أنواع_تعبيرات,
    المصدر: غير_موقع,
    البايت: غير_موقع
): اختيار استعلام_استدعاء_دلالي {
    دع الحالة: سياق_أنواع_تعبيرات = *السياق;
    دع الأفضل: متغير اختيار استعلام_استدعاء_دلالي = اختيار.لا_شيء();
    دع أفضل_طول: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الاستدعاءات) مثل غير_موقع)) {
        دع مرجع_الحقيقة: &حقيقة_استدعاء_نوعية = &الحالة.الاستدعاءات[ف];
        دع الحقيقة: حقيقة_استدعاء_نوعية = *مرجع_الحقيقة;
        لو (نطاق_يحتوي_بايتا(الحقيقة.النطاق, المصدر, البايت)) {
            دع طول_الحالي: غير_موقع = طول_نطاق_بالبايت(الحقيقة.النطاق);
            دع اختر: متغير منطقي = خطأ;
            طابق الأفضل مع
            | اختيار.لا_شيء -> { اختر := صواب; }
            | اختيار.بعض(_) -> { لو (طول_الحالي < أفضل_طول) { اختر := صواب; }; };
            لو (اختر) {
                دع الحجة_النشطة: غير_موقع = حجة_نشطة_لاستدعاء_عند_بايت(
                    &الحقيقة, المصدر, البايت
                );
                دع الاستعلام: استعلام_استدعاء_دلالي = {
                    النطاق: الحقيقة.النطاق,
                    نوع_المستدعى: الحقيقة.نوع_المستدعى,
                    الرمز: الحقيقة.الرمز,
                    الحجة_النشطة: الحجة_النشطة
                };
                الأفضل := اختيار.بعض(الاستعلام);
                أفضل_طول := طول_الحالي;
            };
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}

عام عرف أضف_نوع_تعبير(
    سجل_الأنواع: &سجل_أنواع,
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    النوع: معرف_نوع
): منطقي {
    دع الحالة: متغير سياق_أنواع_تعبيرات = *السياق;
    دع بلا_نطاق_منشئ: اختيار نطاق = اختيار.لا_شيء();
    دع بلا_منشئ: اختيار هوية_منشئ_نوع = اختيار.لا_شيء();
    دع الحقيقة: حقيقة_تعبير_نوعية = {
        النطاق: النطاق,
        النوع: النوع,
        نطاق_المنشئ: بلا_نطاق_منشئ,
        المنشئ: بلا_منشئ
    };
    أدرج_حقيقة_تعبير_مرتبة(&متغير الحالة.الحقائق, الحقيقة);
    *السياق := الحالة;
    أرجع صواب;
}

// Constructor calls/field occurrences are recorded atomically with their already-known TypeID.
// The constructor source span is retained only as the lookup identity used by lowering.
عام عرف أضف_نوع_تعبير_بمنشئ(
    سجل_الأنواع: &سجل_أنواع,
    السياق: &متغير سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    النوع: معرف_نوع,
    نطاق_المنشئ: نطاق,
    الهوية: هوية_منشئ_نوع
): منطقي {
    دع الحالة: متغير سياق_أنواع_تعبيرات = *السياق;
    دع نطاق_منشئ: اختيار نطاق = اختيار.بعض(نطاق_المنشئ);
    دع منشئ: اختيار هوية_منشئ_نوع = اختيار.بعض(الهوية);
    دع الحقيقة: حقيقة_تعبير_نوعية = {
        النطاق: النطاق,
        النوع: النوع,
        نطاق_المنشئ: نطاق_منشئ,
        المنشئ: منشئ
    };
    أدرج_حقيقة_تعبير_مرتبة(&متغير الحالة.الحقائق, الحقيقة);
    *السياق := الحالة;
    أرجع صواب;
}

عام عرف نوع_تعبير_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختيار معرف_نوع {
    دع الحالة: سياق_أنواع_تعبيرات = *السياق;
    دع ف: غير_موقع = موضع_حقيقة_تعبير_أولى(&الحالة.الحقائق, النطاق);
    لو (ف >= (الطول(الحالة.الحقائق) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع الحقيقة: حقيقة_تعبير_نوعية = الحالة.الحقائق[ف];
    لو (نطاقان_متساويان(الحقيقة.النطاق, النطاق)) {
        أرجع اختيار.بعض(الحقيقة.النوع);
    };
    أرجع اختيار.لا_شيء();
}

عام عرف هوية_منشئ_تعبير_عند(
    السياق: &سياق_أنواع_تعبيرات,
    النطاق: نطاق
): اختيار هوية_منشئ_نوع {
    دع الحالة: سياق_أنواع_تعبيرات = *السياق;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الحقائق) مثل غير_موقع)) {
        دع الحقيقة: حقيقة_تعبير_نوعية = الحالة.الحقائق[ف];
        طابق الحقيقة.نطاق_المنشئ مع
        | اختيار.بعض(نطاق_القيمة) -> {
            لو (نطاقان_متساويان(نطاق_القيمة, النطاق)) {
                أرجع الحقيقة.المنشئ;
            };
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

// Type-owned point query. Nested expressions choose the narrowest typed expression.
عام عرف نوع_تعبير_عند_بايت(
    السياق: &سياق_أنواع_تعبيرات,
    المصدر: غير_موقع,
    البايت: غير_موقع
): اختيار معرف_نوع {
    دع الحالة: سياق_أنواع_تعبيرات = *السياق;
    دع الأفضل: متغير اختيار معرف_نوع = اختيار.لا_شيء();
    دع أفضل_طول: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الحقائق) مثل غير_موقع)) {
        دع الحقيقة: حقيقة_تعبير_نوعية = الحالة.الحقائق[ف];
        لو (نطاق_يحتوي_بايتا(الحقيقة.النطاق, المصدر, البايت)) {
            دع طول_الحالي: غير_موقع = طول_نطاق_بالبايت(الحقيقة.النطاق);
            دع اختر: متغير منطقي = خطأ;
            طابق الأفضل مع
            | اختيار.لا_شيء -> { اختر := صواب; }
            | اختيار.بعض(_) -> { لو (طول_الحالي < أفضل_طول) { اختر := صواب; }; };
            لو (اختر) {
                الأفضل := اختيار.بعض(الحقيقة.النوع);
                أفضل_طول := طول_الحالي;
            };
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}
