        | اختيار.بعض(_) -> { };
    }
    | اختيار.لا_شيء -> { };
}

عرف سجل_إغلاق_تعبير_في_الفهرس(
    السياق: &متغير سياق_أنواع_تعبيرات,
    العدد: غير_موقع,
    النطاق: نطاق,
    الموضع: غير_موقع
