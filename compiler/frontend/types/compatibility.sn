استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.names.identifiers;

استورد compiler.frontend.types.type_context;
// Compatibility and conversion policy operates only on canonical Type IDs.
// Parsing spellings and target ABI/layout are deliberately outside this layer.
عرف نوع_بدائي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري نوع_بدائي_مقنن {
    لو (المعرف.القيمة >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    طابق (*سجل_الأنواع).الأنواع[المعرف.القيمة] مع
    | نوع_مقنن.بدائي(البدائي) -> {
        أرجع اختياري.موجود(البدائي);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف هل_غلاف_نوع_متغير(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    لو (المعرف.القيمة >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)) { أرجع خطأ; };
    طابق (*سجل_الأنواع).الأنواع[المعرف.القيمة] مع
    | نوع_مقنن.متغير(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف أزل_غلاف_متغير(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    دع الحالي: متغير معرف_نوع = المعرف;
    طالما (صواب) {
        لو (الحالي.القيمة >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        طابق (*سجل_الأنواع).الأنواع[الحالي.القيمة] مع
        | نوع_مقنن.متغير(الداخل) -> {
            الحالي := الداخل;
        }
        | _ -> {
            أرجع اختياري.موجود(الحالي);
        };
    }
    أرجع اختياري.لا_شيء();
}

عام عرف نوعان_متوافقان(
    سجل_الأنواع: &سجل_أنواع,
    اليسار: معرف_نوع,
    اليمين: معرف_نوع
): منطقي {
    دع أ: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, اليسار);
    دع ب: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, اليمين);
    طابق أ مع
    | اختياري.موجود(معرف_أ) -> {
        طابق ب مع
        | اختياري.موجود(معرف_ب) -> {
            أرجع معرفا_نوع_متساويان(معرف_أ, معرف_ب);
        }
        | اختياري.لا_شيء -> {
            أرجع خطأ;
        };
    }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    };
}

عرف صنف_تحويل_عددي(
    المصدر: نوع_بدائي_مقنن,
    الهدف: نوع_بدائي_مقنن
): صنف_تحويل_نوع {
    دع صنف_المصدر: صنف_نوع_بدائي = صنف_النوع_البدائي(المصدر);
    دع صنف_الهدف: صنف_نوع_بدائي = صنف_النوع_البدائي(الهدف);
    دع بتات_المصدر: طبيعي = بتات_نوع_بدائي(المصدر);
    دع بتات_الهدف: طبيعي = بتات_نوع_بدائي(الهدف);

    طابق صنف_المصدر مع
    | صنف_نوع_بدائي.عدد_موقع -> {
        طابق صنف_الهدف مع
        | صنف_نوع_بدائي.عدد_موقع -> {
            لو (بتات_الهدف >= بتات_المصدر) {
                أرجع صنف_تحويل_نوع.ضمني_آمن();
            };
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | _ -> {
            أرجع صنف_تحويل_نوع.غير_صالح();
        };
    }
    | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
        طابق صنف_الهدف مع
        | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
            لو (بتات_الهدف >= بتات_المصدر) {
                أرجع صنف_تحويل_نوع.ضمني_آمن();
            };
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | صنف_نوع_بدائي.عدد_موقع -> {
            لو (بتات_الهدف > بتات_المصدر) {
                أرجع صنف_تحويل_نوع.ضمني_آمن();
            };
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | _ -> {
            أرجع صنف_تحويل_نوع.غير_صالح();
        };
    }
    | صنف_نوع_بدائي.حرف -> {
        طابق صنف_الهدف مع
        | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
            لو (بتات_الهدف >= 32) {
                أرجع صنف_تحويل_نوع.ضمني_آمن();
            };
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | _ -> {
            أرجع صنف_تحويل_نوع.غير_صالح();
        };
    }
    | _ -> {
        أرجع صنف_تحويل_نوع.غير_صالح();
    };
}

عرف تفسير_صحيح_من_بدائي(النوع: نوع_بدائي_مقنن): اختياري تفسير_صحيح_دلالي {
    طابق صنف_النوع_البدائي(النوع) مع
    | صنف_نوع_بدائي.عدد_موقع -> {
        أرجع اختياري.موجود(تفسير_صحيح_دلالي.موقع());
    }
    | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
        أرجع اختياري.موجود(تفسير_صحيح_دلالي.طبيعي());
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف وصف_تحويل_صحيح_بين(
    سجل_الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): اختياري وصف_تحويل_صحيح_دلالي {
    دع مصدر_أساس: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, المصدر);
    دع هدف_أساس: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, الهدف);
    طابق مصدر_أساس مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(معرف_المصدر) -> {
        طابق هدف_أساس مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        }
        | اختياري.موجود(معرف_الهدف) -> {
            طابق نوع_بدائي_عند(سجل_الأنواع, معرف_المصدر) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(بدائي_المصدر) -> {
                طابق نوع_بدائي_عند(سجل_الأنواع, معرف_الهدف) مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(بدائي_الهدف) -> {
                    طابق تفسير_صحيح_من_بدائي(بدائي_المصدر) مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.لا_شيء();
                    }
                    | اختياري.موجود(تفسير_المصدر) -> {
                        طابق تفسير_صحيح_من_بدائي(بدائي_الهدف) مع
                        | اختياري.لا_شيء -> {
                            أرجع اختياري.لا_شيء();
                        }
                        | اختياري.موجود(تفسير_الهدف) -> {
                            دع بتات_المصدر: طبيعي = بتات_نوع_بدائي(بدائي_المصدر);
                            دع بتات_الهدف: طبيعي = بتات_نوع_بدائي(بدائي_الهدف);
                            دع التغيير: متغير تغيير_عرض_صحيح_دلالي = تغيير_عرض_صحيح_دلالي.حفظ();
                            لو (بتات_الهدف > بتات_المصدر) {
                                طابق تفسير_المصدر مع
                                | تفسير_صحيح_دلالي.موقع -> {
                                    التغيير := تغيير_عرض_صحيح_دلالي.توسيع_بإشارة();
                                }
                                | تفسير_صحيح_دلالي.طبيعي -> {
                                    التغيير := تغيير_عرض_صحيح_دلالي.توسيع_صفري();
                                };
                            } وإلا لو (بتات_الهدف < بتات_المصدر) {
                                التغيير := تغيير_عرض_صحيح_دلالي.اقتطاع();
                            };
                            دع الوصف: وصف_تحويل_صحيح_دلالي = {
                                المصدر: معرف_المصدر,
                                الهدف: معرف_الهدف,
                                تغيير_العرض: التغيير,
                                تفسير_الهدف: تفسير_الهدف
                            };
                            أرجع اختياري.موجود(الوصف);
                        };
                    };
                };
            };
        };
    };
}

// Ownership-preserving transfer of a byte vector into the canonical owned text header.
// An explicit cast is a move in SSF; this cannot borrow or alias the source buffer.
عام عرف هل_نقل_متجه_بايتات_إلى_نص(
    سجل_الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): منطقي {
    دع أساس_المصدر: معرف_نوع;
    طابق أزل_غلاف_متغير(سجل_الأنواع, المصدر) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { أساس_المصدر := القيمة; };
    دع أساس_الهدف: معرف_نوع;
    طابق أزل_غلاف_متغير(سجل_الأنواع, الهدف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { أساس_الهدف := القيمة; };
    طابق نوع_بدائي_عند(سجل_الأنواع, أساس_الهدف) مع
    | اختياري.موجود(نوع_بدائي_مقنن.نص) -> { }
    | _ -> { أرجع خطأ; };
    لو (أساس_المصدر.القيمة >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)) {
        أرجع خطأ;
    };
    طابق (*سجل_الأنواع).الأنواع[أساس_المصدر.القيمة] مع
    | نوع_مقنن.متجه(العنصر) -> {
        طابق نوع_بدائي_عند(سجل_الأنواع, العنصر) مع
        | اختياري.موجود(نوع_بدائي_مقنن.ط8) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// `x as T` between two scalar Types (bool, char, integers, floats, text):
// whether no conversion joins them. Allowed: identity, integer <-> integer,
// float <-> integer and float <-> float (Rust's numeric `as`), char ->
// an unsigned integer of at least 32 bits, and u8 -> char. A Type that is
// not scalar is left to lowering (references, pointers, byte vectors).
عام عرف تحويل_سلمي_مرفوض(
    سجل_الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): منطقي {
    دع بدائي_المصدر: نوع_بدائي_مقنن;
    طابق أزل_غلاف_متغير(سجل_الأنواع, المصدر) مع
    | اختياري.موجود(المعرف) -> {
        طابق نوع_بدائي_عند(سجل_الأنواع, المعرف) مع
        | اختياري.موجود(البدائي) -> { بدائي_المصدر := البدائي; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع بدائي_الهدف: نوع_بدائي_مقنن;
    طابق أزل_غلاف_متغير(سجل_الأنواع, الهدف) مع
    | اختياري.موجود(المعرف) -> {
        طابق نوع_بدائي_عند(سجل_الأنواع, المعرف) مع
        | اختياري.موجود(البدائي) -> { بدائي_الهدف := البدائي; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    لو (بدائي_المصدر == بدائي_الهدف) { أرجع خطأ; };
    دع صنف_المصدر: صنف_نوع_بدائي = صنف_النوع_البدائي(بدائي_المصدر);
    دع صنف_الهدف: صنف_نوع_بدائي = صنف_النوع_البدائي(بدائي_الهدف);
    دع مصدر_رقمي: منطقي = صنف_المصدر == صنف_نوع_بدائي.عدد_موقع()
        || صنف_المصدر == صنف_نوع_بدائي.عدد_صحيح_طبيعي() || صنف_المصدر == صنف_نوع_بدائي.عشري();
    دع هدف_رقمي: منطقي = صنف_الهدف == صنف_نوع_بدائي.عدد_موقع()
        || صنف_الهدف == صنف_نوع_بدائي.عدد_صحيح_طبيعي() || صنف_الهدف == صنف_نوع_بدائي.عشري();
    لو (مصدر_رقمي && هدف_رقمي) { أرجع خطأ; };
    لو (صنف_المصدر == صنف_نوع_بدائي.حرف() && صنف_الهدف == صنف_نوع_بدائي.عدد_صحيح_طبيعي()
        && بتات_نوع_بدائي(بدائي_الهدف) >= 32) { أرجع خطأ; };
    لو (صنف_الهدف == صنف_نوع_بدائي.حرف() && صنف_المصدر == صنف_نوع_بدائي.عدد_صحيح_طبيعي()
        && بتات_نوع_بدائي(بدائي_المصدر) == 8) { أرجع خطأ; };
    // `any` and `void` are not scalar values; lowering reports them.
    لو (صنف_المصدر == صنف_نوع_بدائي.غير_معروف() || صنف_الهدف == صنف_نوع_بدائي.غير_معروف()
        || صنف_المصدر == صنف_نوع_بدائي.فراغ() || صنف_الهدف == صنف_نوع_بدائي.فراغ()) { أرجع خطأ; };
    أرجع صواب;
}

عام عرف صنف_تحويل_بين(
    سجل_الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): صنف_تحويل_نوع {
    لو (نوعان_متوافقان(سجل_الأنواع, المصدر, الهدف)) {
        أرجع صنف_تحويل_نوع.ضمني_آمن();
    };
    لو (هل_نقل_متجه_بايتات_إلى_نص(سجل_الأنواع, المصدر, الهدف)) {
        أرجع صنف_تحويل_نوع.صريح_آمن();
    };

    دع مصدر_أساس: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, المصدر);
    دع هدف_أساس: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, الهدف);
    طابق مصدر_أساس مع
    | اختياري.لا_شيء -> {
        أرجع صنف_تحويل_نوع.غير_صالح();
    }
    | اختياري.موجود(معرف_المصدر) -> {
        طابق هدف_أساس مع
        | اختياري.لا_شيء -> {
            أرجع صنف_تحويل_نوع.غير_صالح();
        }
        | اختياري.موجود(معرف_الهدف) -> {
            لو ((معرف_المصدر.القيمة >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي))
                || (معرف_الهدف.القيمة >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي))) {
                أرجع صنف_تحويل_نوع.غير_صالح();
            };
            طابق (*سجل_الأنواع).الأنواع[معرف_المصدر.القيمة] مع
            | نوع_مقنن.مرجع(داخل_المصدر, مرجع_متغير) -> {
                طابق (*سجل_الأنواع).الأنواع[معرف_الهدف.القيمة] مع
                | نوع_مقنن.مؤشر(داخل_الهدف) -> {
                    لو (!نوعان_متوافقان(سجل_الأنواع, داخل_المصدر, داخل_الهدف)) {
                        أرجع صنف_تحويل_نوع.غير_صالح();
                    };
                    طابق (*سجل_الأنواع).الأنواع[داخل_الهدف.القيمة] مع
                    | نوع_مقنن.متغير(س) -> {
                        لو (!مرجع_متغير) {
                            أرجع صنف_تحويل_نوع.غير_صالح();
                        };
                    }
                    | _ -> { };
                    أرجع صنف_تحويل_نوع.ضمني_آمن();
                }
                | نوع_مقنن.مرجع(داخل_الهدف, هدف_متغير) -> {
                    لو (!نوعان_متوافقان(سجل_الأنواع, داخل_المصدر, داخل_الهدف)) {
                        أرجع صنف_تحويل_نوع.غير_صالح();
                    };
                    لو (مرجع_متغير && !هدف_متغير) {
                        أرجع صنف_تحويل_نوع.ضمني_آمن();
                    };
                    لو (!مرجع_متغير && هدف_متغير) {
                        أرجع صنف_تحويل_نوع.غير_صالح();
                    };
                    أرجع صنف_تحويل_نوع.غير_صالح();
                }
                | _ -> { };
            }
            | نوع_مقنن.مؤشر(داخل_المصدر) -> {
                طابق (*سجل_الأنواع).الأنواع[معرف_الهدف.القيمة] مع
                | نوع_مقنن.مرجع(داخل_الهدف, هدف_متغير) -> {
                    لو (نوعان_متوافقان(سجل_الأنواع, داخل_المصدر, داخل_الهدف)) {
                        أرجع صنف_تحويل_نوع.يتطلب_غير_آمن();
                    };
                    أرجع صنف_تحويل_نوع.غير_صالح();
                }
                | _ -> { };
            }
            | _ -> { };

            دع بدائي_المصدر: اختياري نوع_بدائي_مقنن = نوع_بدائي_عند(سجل_الأنواع, معرف_المصدر);
            دع بدائي_الهدف: اختياري نوع_بدائي_مقنن = نوع_بدائي_عند(سجل_الأنواع, معرف_الهدف);
            طابق بدائي_المصدر مع
            | اختياري.موجود(أ) -> {
                طابق بدائي_الهدف مع
                | اختياري.موجود(ب) -> {
                    أرجع صنف_تحويل_عددي(أ, ب);
                }
                | اختياري.لا_شيء -> {
                    أرجع صنف_تحويل_نوع.غير_صالح();
                };
            }
            | اختياري.لا_شيء -> {
                أرجع صنف_تحويل_نوع.غير_صالح();
            };
        };
    };
}

// A vector seen as a slice of the same elements (`vector T` where `[] T` is
// expected): the slice views the vector's buffer, which the vector keeps
// owning. Slices share the vector layout, so the view is a copy of the
// vector header.
عام عرف هل_عرض_متجه_كشريحة(
    سجل_الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): منطقي {
    دع مصدر_أساس: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, المصدر);
    دع هدف_أساس: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, الهدف);
    دع عنصر_المصدر: معرف_نوع;
    طابق مصدر_أساس مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المعرف) -> {
        لو (المعرف.القيمة >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)) { أرجع خطأ; };
        طابق (*سجل_الأنواع).الأنواع[المعرف.القيمة] مع
        | نوع_مقنن.متجه(العنصر) -> { عنصر_المصدر := العنصر; }
        | _ -> { أرجع خطأ; };
    };
    طابق هدف_أساس مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المعرف) -> {
        لو (المعرف.القيمة >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)) { أرجع خطأ; };
        طابق (*سجل_الأنواع).الأنواع[المعرف.القيمة] مع
        | نوع_مقنن.شريحة(العنصر) -> { أرجع نوعان_متوافقان(سجل_الأنواع, عنصر_المصدر, العنصر); }
        | _ -> { أرجع خطأ; };
    };
}

عام عرف هل_تحويل_ضمني_آمن(
    سجل_الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): منطقي {
    طابق صنف_تحويل_بين(سجل_الأنواع, المصدر, الهدف) مع
    | صنف_تحويل_نوع.ضمني_آمن -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف هل_عدد_صحيح_يلائم(
    سجل_الأنواع: &سجل_أنواع,
    القيمة: عدد,
    الهدف: معرف_نوع
): منطقي {
    دع الأساس: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, الهدف);
    طابق الأساس مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(المعرف) -> {
        دع البدائي: اختياري نوع_بدائي_مقنن = نوع_بدائي_عند(سجل_الأنواع, المعرف);
        طابق البدائي مع
        | اختياري.لا_شيء -> {
            أرجع خطأ;
        }
        | اختياري.موجود(النوع) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(النوع);
            دع البتات: طبيعي = بتات_نوع_بدائي(النوع);
            طابق الصنف مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                لو (البتات == 8) {
                    أرجع (القيمة >= -128) && (القيمة <= 127);
                };
                لو (البتات == 16) {
                    أرجع (القيمة >= -32768) && (القيمة <= 32767);
                };
                لو (البتات == 32) {
                    أرجع (القيمة >= -2147483648) && (القيمة <= 2147483647);
                };
                لو (البتات == 64) {
                    أرجع صواب;
                };
                أرجع خطأ;
            }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
                لو (القيمة < 0) {
                    أرجع خطأ;
                };
                لو (البتات == 8) {
                    أرجع القيمة <= 255;
                };
                لو (البتات == 16) {
                    أرجع القيمة <= 65535;
                };
                لو (البتات == 32) {
                    أرجع القيمة <= 4294967295;
                };
                لو (البتات == 64) {
                    أرجع صواب;
                };
                أرجع خطأ;
            }
            | _ -> {
                أرجع خطأ;
            };
        };
    };
}

عام عرف هل_عدد_صحيح_طبيعي_يلائم(
    سجل_الأنواع: &سجل_أنواع,
    القيمة: طبيعي,
    الهدف: معرف_نوع
): منطقي {
    دع الأساس: اختياري معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, الهدف);
    طابق الأساس مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المعرف) -> {
        طابق نوع_بدائي_عند(سجل_الأنواع, المعرف) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(النوع) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(النوع);
            دع البتات: طبيعي = بتات_نوع_بدائي(النوع);
            طابق الصنف مع
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
                لو (البتات == 8) { أرجع القيمة <= 255; };
                لو (البتات == 16) { أرجع القيمة <= 65535; };
                لو (البتات == 32) { أرجع القيمة <= 4294967295; };
                لو (البتات == 64) { أرجع صواب; };
                أرجع خطأ;
            }
            | صنف_نوع_بدائي.عدد_موقع -> {
                لو (البتات == 8) { أرجع القيمة <= 127; };
                لو (البتات == 16) { أرجع القيمة <= 32767; };
                لو (البتات == 32) { أرجع القيمة <= 2147483647; };
                لو (البتات == 64) {
                    أرجع القيمة <= (9223372036854775807 مثل طبيعي);
                };
                أرجع خطأ;
            }
            | _ -> { أرجع خطأ; };
        };
    };
}
