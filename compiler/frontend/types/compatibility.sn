استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.names.identifiers;

استورد compiler.frontend.types.type_context;
// Compatibility and conversion policy operates only on canonical Type IDs.
// Parsing spellings and target ABI/layout are deliberately outside this layer.
عرف نوع_بدائي_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار نوع_بدائي_مقنن {
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    لو (المعرف.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_النوع: &نوع_مقنن = &الحالة.الأنواع[المعرف.القيمة];
    دع النوع: نوع_مقنن = *مرجع_النوع;
    طابق النوع مع
    | نوع_مقنن.بدائي(البدائي) -> {
        أرجع اختيار.بعض(البدائي);
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف أزل_غلاف_متغير(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار معرف_نوع {
    دع الحالي: متغير معرف_نوع = المعرف;
    بينما (صواب) {
        دع الحالة: سجل_أنواع = *سجل_الأنواع;
        لو (الحالي.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        دع مرجع_النوع: &نوع_مقنن = &الحالة.الأنواع[الحالي.القيمة];
        دع النوع: نوع_مقنن = *مرجع_النوع;
        طابق النوع مع
        | نوع_مقنن.متغير(الداخل) -> {
            الحالي := الداخل;
        }
        | _ -> {
            أرجع اختيار.بعض(الحالي);
        };
    }
    أرجع اختيار.لا_شيء();
}

عام عرف نوعان_متوافقان(
    سجل_الأنواع: &سجل_أنواع,
    اليسار: معرف_نوع,
    اليمين: معرف_نوع
): منطقي {
    دع أ: اختيار معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, اليسار);
    دع ب: اختيار معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, اليمين);
    طابق أ مع
    | اختيار.بعض(معرف_أ) -> {
        طابق ب مع
        | اختيار.بعض(معرف_ب) -> {
            أرجع معرفا_نوع_متساويان(معرف_أ, معرف_ب);
        }
        | اختيار.لا_شيء -> {
            أرجع خطأ;
        };
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

عرف صنف_تحويل_عددي(
    المصدر: نوع_بدائي_مقنن,
    الهدف: نوع_بدائي_مقنن
): صنف_تحويل_نوع {
    دع صنف_المصدر: صنف_نوع_بدائي = صنف_النوع_البدائي(المصدر);
    دع صنف_الهدف: صنف_نوع_بدائي = صنف_النوع_البدائي(الهدف);
    دع بتات_المصدر: غير_موقع = بتات_نوع_بدائي(المصدر);
    دع بتات_الهدف: غير_موقع = بتات_نوع_بدائي(الهدف);

    طابق صنف_المصدر مع
    | صنف_نوع_بدائي.عدد_موقع -> {
        طابق صنف_الهدف مع
        | صنف_نوع_بدائي.عدد_موقع -> {
            لو (بتات_الهدف >= بتات_المصدر) {
                أرجع صنف_تحويل_نوع.ضمني_آمن();
            };
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | _ -> {
            أرجع صنف_تحويل_نوع.غير_صالح();
        };
    }
    | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
        طابق صنف_الهدف مع
        | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
            لو (بتات_الهدف >= بتات_المصدر) {
                أرجع صنف_تحويل_نوع.ضمني_آمن();
            };
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | صنف_نوع_بدائي.عدد_موقع -> {
            لو (بتات_الهدف > بتات_المصدر) {
                أرجع صنف_تحويل_نوع.ضمني_آمن();
            };
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | _ -> {
            أرجع صنف_تحويل_نوع.غير_صالح();
        };
    }
    | صنف_نوع_بدائي.حرف -> {
        طابق صنف_الهدف مع
        | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
            لو (بتات_الهدف >= 32) {
                أرجع صنف_تحويل_نوع.ضمني_آمن();
            };
            أرجع صنف_تحويل_نوع.صريح_آمن();
        }
        | _ -> {
            أرجع صنف_تحويل_نوع.غير_صالح();
        };
    }
    | _ -> {
        أرجع صنف_تحويل_نوع.غير_صالح();
    };
}

عرف تفسير_صحيح_من_بدائي(النوع: نوع_بدائي_مقنن): اختيار تفسير_صحيح_دلالي {
    طابق صنف_النوع_البدائي(النوع) مع
    | صنف_نوع_بدائي.عدد_موقع -> {
        أرجع اختيار.بعض(تفسير_صحيح_دلالي.موقع());
    }
    | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
        أرجع اختيار.بعض(تفسير_صحيح_دلالي.غير_موقع());
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف وصف_تحويل_صحيح_بين(
    سجل_الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): اختيار وصف_تحويل_صحيح_دلالي {
    دع مصدر_أساس: اختيار معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, المصدر);
    دع هدف_أساس: اختيار معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, الهدف);
    طابق مصدر_أساس مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(معرف_المصدر) -> {
        طابق هدف_أساس مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        }
        | اختيار.بعض(معرف_الهدف) -> {
            طابق نوع_بدائي_عند(سجل_الأنواع, معرف_المصدر) مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            }
            | اختيار.بعض(بدائي_المصدر) -> {
                طابق نوع_بدائي_عند(سجل_الأنواع, معرف_الهدف) مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.لا_شيء();
                }
                | اختيار.بعض(بدائي_الهدف) -> {
                    طابق تفسير_صحيح_من_بدائي(بدائي_المصدر) مع
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.لا_شيء();
                    }
                    | اختيار.بعض(تفسير_المصدر) -> {
                        طابق تفسير_صحيح_من_بدائي(بدائي_الهدف) مع
                        | اختيار.لا_شيء -> {
                            أرجع اختيار.لا_شيء();
                        }
                        | اختيار.بعض(تفسير_الهدف) -> {
                            دع بتات_المصدر: غير_موقع = بتات_نوع_بدائي(بدائي_المصدر);
                            دع بتات_الهدف: غير_موقع = بتات_نوع_بدائي(بدائي_الهدف);
                            دع التغيير: متغير تغيير_عرض_صحيح_دلالي = تغيير_عرض_صحيح_دلالي.حفظ();
                            لو (بتات_الهدف > بتات_المصدر) {
                                طابق تفسير_المصدر مع
                                | تفسير_صحيح_دلالي.موقع -> {
                                    التغيير := تغيير_عرض_صحيح_دلالي.توسيع_بإشارة();
                                }
                                | تفسير_صحيح_دلالي.غير_موقع -> {
                                    التغيير := تغيير_عرض_صحيح_دلالي.توسيع_صفري();
                                };
                            } وإلا لو (بتات_الهدف < بتات_المصدر) {
                                التغيير := تغيير_عرض_صحيح_دلالي.اقتطاع();
                            };
                            دع الوصف: وصف_تحويل_صحيح_دلالي = {
                                المصدر: معرف_المصدر,
                                الهدف: معرف_الهدف,
                                تغيير_العرض: التغيير,
                                تفسير_الهدف: تفسير_الهدف
                            };
                            أرجع اختيار.بعض(الوصف);
                        };
                    };
                };
            };
        };
    };
}

عام عرف صنف_تحويل_بين(
    سجل_الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): صنف_تحويل_نوع {
    لو (نوعان_متوافقان(سجل_الأنواع, المصدر, الهدف)) {
        أرجع صنف_تحويل_نوع.ضمني_آمن();
    };

    دع مصدر_أساس: اختيار معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, المصدر);
    دع هدف_أساس: اختيار معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, الهدف);
    طابق مصدر_أساس مع
    | اختيار.لا_شيء -> {
        أرجع صنف_تحويل_نوع.غير_صالح();
    }
    | اختيار.بعض(معرف_المصدر) -> {
        طابق هدف_أساس مع
        | اختيار.لا_شيء -> {
            أرجع صنف_تحويل_نوع.غير_صالح();
        }
        | اختيار.بعض(معرف_الهدف) -> {
            دع الحالة: سجل_أنواع = *سجل_الأنواع;
            لو ((معرف_المصدر.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع))
                || (معرف_الهدف.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع))) {
                أرجع صنف_تحويل_نوع.غير_صالح();
            };
            دع مرجع_المصدر: &نوع_مقنن = &الحالة.الأنواع[معرف_المصدر.القيمة];
            دع مرجع_الهدف: &نوع_مقنن = &الحالة.الأنواع[معرف_الهدف.القيمة];
            دع نوع_المصدر: نوع_مقنن = *مرجع_المصدر;
            دع نوع_الهدف: نوع_مقنن = *مرجع_الهدف;

            طابق نوع_المصدر مع
            | نوع_مقنن.مرجع(داخل_المصدر, مرجع_متغير) -> {
                طابق نوع_الهدف مع
                | نوع_مقنن.مؤشر(داخل_الهدف) -> {
                    لو (!نوعان_متوافقان(سجل_الأنواع, داخل_المصدر, داخل_الهدف)) {
                        أرجع صنف_تحويل_نوع.غير_صالح();
                    };
                    دع هدف_الداخل: سجل_أنواع = *سجل_الأنواع;
                    دع مرجع_داخل_الهدف: &نوع_مقنن = &هدف_الداخل.الأنواع[داخل_الهدف.القيمة];
                    دع نوع_داخل_الهدف: نوع_مقنن = *مرجع_داخل_الهدف;
                    طابق نوع_داخل_الهدف مع
                    | نوع_مقنن.متغير(س) -> {
                        لو (!مرجع_متغير) {
                            أرجع صنف_تحويل_نوع.غير_صالح();
                        };
                    }
                    | _ -> { };
                    أرجع صنف_تحويل_نوع.ضمني_آمن();
                }
                | نوع_مقنن.مرجع(داخل_الهدف, هدف_متغير) -> {
                    لو (!نوعان_متوافقان(سجل_الأنواع, داخل_المصدر, داخل_الهدف)) {
                        أرجع صنف_تحويل_نوع.غير_صالح();
                    };
                    لو (مرجع_متغير && !هدف_متغير) {
                        أرجع صنف_تحويل_نوع.ضمني_آمن();
                    };
                    لو (!مرجع_متغير && هدف_متغير) {
                        أرجع صنف_تحويل_نوع.غير_صالح();
                    };
                    أرجع صنف_تحويل_نوع.غير_صالح();
                }
                | _ -> { };
            }
            | نوع_مقنن.مؤشر(داخل_المصدر) -> {
                طابق نوع_الهدف مع
                | نوع_مقنن.مرجع(داخل_الهدف, هدف_متغير) -> {
                    لو (نوعان_متوافقان(سجل_الأنواع, داخل_المصدر, داخل_الهدف)) {
                        أرجع صنف_تحويل_نوع.يتطلب_غير_آمن();
                    };
                    أرجع صنف_تحويل_نوع.غير_صالح();
                }
                | _ -> { };
            }
            | _ -> { };

            دع بدائي_المصدر: اختيار نوع_بدائي_مقنن = نوع_بدائي_عند(سجل_الأنواع, معرف_المصدر);
            دع بدائي_الهدف: اختيار نوع_بدائي_مقنن = نوع_بدائي_عند(سجل_الأنواع, معرف_الهدف);
            طابق بدائي_المصدر مع
            | اختيار.بعض(أ) -> {
                طابق بدائي_الهدف مع
                | اختيار.بعض(ب) -> {
                    أرجع صنف_تحويل_عددي(أ, ب);
                }
                | اختيار.لا_شيء -> {
                    أرجع صنف_تحويل_نوع.غير_صالح();
                };
            }
            | اختيار.لا_شيء -> {
                أرجع صنف_تحويل_نوع.غير_صالح();
            };
        };
    };
}

عام عرف هل_تحويل_ضمني_آمن(
    سجل_الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الهدف: معرف_نوع
): منطقي {
    طابق صنف_تحويل_بين(سجل_الأنواع, المصدر, الهدف) مع
    | صنف_تحويل_نوع.ضمني_آمن -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف هل_عدد_صحيح_يلائم(
    سجل_الأنواع: &سجل_أنواع,
    القيمة: عدد,
    الهدف: معرف_نوع
): منطقي {
    دع الأساس: اختيار معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, الهدف);
    طابق الأساس مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(المعرف) -> {
        دع البدائي: اختيار نوع_بدائي_مقنن = نوع_بدائي_عند(سجل_الأنواع, المعرف);
        طابق البدائي مع
        | اختيار.لا_شيء -> {
            أرجع خطأ;
        }
        | اختيار.بعض(النوع) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(النوع);
            دع البتات: غير_موقع = بتات_نوع_بدائي(النوع);
            طابق الصنف مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                لو (البتات == 8) {
                    أرجع (القيمة >= -128) && (القيمة <= 127);
                };
                لو (البتات == 16) {
                    أرجع (القيمة >= -32768) && (القيمة <= 32767);
                };
                لو (البتات == 32) {
                    أرجع (القيمة >= -2147483648) && (القيمة <= 2147483647);
                };
                لو (البتات == 64) {
                    أرجع صواب;
                };
                أرجع خطأ;
            }
            | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
                لو (القيمة < 0) {
                    أرجع خطأ;
                };
                لو (البتات == 8) {
                    أرجع القيمة <= 255;
                };
                لو (البتات == 16) {
                    أرجع القيمة <= 65535;
                };
                لو (البتات == 32) {
                    أرجع القيمة <= 4294967295;
                };
                لو (البتات == 64) {
                    أرجع صواب;
                };
                أرجع خطأ;
            }
            | _ -> {
                أرجع خطأ;
            };
        };
    };
}

عام عرف هل_عدد_صحيح_غير_موقع_يلائم(
    سجل_الأنواع: &سجل_أنواع,
    القيمة: غير_موقع,
    الهدف: معرف_نوع
): منطقي {
    دع الأساس: اختيار معرف_نوع = أزل_غلاف_متغير(سجل_الأنواع, الهدف);
    طابق الأساس مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المعرف) -> {
        طابق نوع_بدائي_عند(سجل_الأنواع, المعرف) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(النوع) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(النوع);
            دع البتات: غير_موقع = بتات_نوع_بدائي(النوع);
            طابق الصنف مع
            | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
                لو (البتات == 8) { أرجع القيمة <= 255; };
                لو (البتات == 16) { أرجع القيمة <= 65535; };
                لو (البتات == 32) { أرجع القيمة <= 4294967295; };
                لو (البتات == 64) { أرجع صواب; };
                أرجع خطأ;
            }
            | صنف_نوع_بدائي.عدد_موقع -> {
                لو (البتات == 8) { أرجع القيمة <= 127; };
                لو (البتات == 16) { أرجع القيمة <= 32767; };
                لو (البتات == 32) { أرجع القيمة <= 2147483647; };
                لو (البتات == 64) {
                    أرجع القيمة <= (9223372036854775807 مثل غير_موقع);
                };
                أرجع خطأ;
            }
            | _ -> { أرجع خطأ; };
        };
    };
}
