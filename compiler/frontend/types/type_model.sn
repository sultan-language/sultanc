استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.names.identifiers;

// This model owns semantic Type shape, not canonical identity storage or physical layout.
// Struct semantic fields are one coherent value: canonical Name identity + Type identity.
// No physical layout fact belongs here.
عام نوع حقل_سجل_دلالي = {
    الاسم: معرف_اسم,
    النوع: معرف_نوع
};

// Constructor identity is semantic. Named enum constructors use the Symbol identity
// supplied by Name System; builtin tagged types use canonical Type-owned identities.
عام نوع هوية_منشئ_نوع =
    | اختيار_لا_شيء
    | اختيار_بعض
    | نتيجة_نجاح
    | نتيجة_خطأ
    | تعداد بنوع معرف_رمز
;

// One coherent constructor value owns identity, semantic name when Name supplies one,
// and the ordered payload Type IDs. It contains no physical tag or payload layout.
عام نوع منشئ_نوع_دلالي = {
    الهوية: هوية_منشئ_نوع,
    الاسم: اختياري معرف_اسم,
    الحمولات: متجه معرف_نوع
};

عام نوع شكل_نوع_مسمى =
    | سجل
    | تعداد
;

// Canonical semantic type model. It contains no English/Arabic spelling.
// Bilingual spelling is normalized by the lexer before this layer.
عام نوع نوع_مقنن =
    | بدائي بنوع نوع_بدائي_مقنن
    | صف بنوع متجه معرف_نوع
    | صندوق بنوع معرف_نوع
    | اختيار بنوع معرف_نوع
    | نتيجة بنوع (معرف_نوع, معرف_نوع)
    | دالة بنوع (متجه معرف_نوع, معرف_نوع)
    | معامل_نوع بنوع معرف_رمز
    | مسمى بنوع (معرف_رمز, شكل_نوع_مسمى, متجه معرف_نوع)
    | مؤشر بنوع معرف_نوع
    | مرجع بنوع (معرف_نوع, منطقي)
    | شريحة بنوع معرف_نوع
    | متجه بنوع معرف_نوع
    | متغير بنوع معرف_نوع
;

// Named aggregate semantic structure lives with its single named Type binding.
// Aliases store no structure and point directly at the canonical target Type ID.
عام نوع تعريف_نوع_مسمى =
    | مرادف
    | سجل بنوع متجه حقل_سجل_دلالي
    | تعداد بنوع متجه منشئ_نوع_دلالي
;

عام نوع ربط_نوع_مسمى = {
    الرمز: معرف_رمز,
    المعرف: معرف_نوع,
    معاملات_النوع: متجه معرف_رمز,
    التعريف: تعريف_نوع_مسمى
};

عام نوع ربط_استبدال_نوع = {
    المعامل: معرف_رمز,
    الحجة: معرف_نوع
};

عام نوع نتيجة_حل_نوع =
    | موجود بنوع معرف_نوع
    | مفقود
    | معاملات_غير_مدعومة
    | غير_صالح
;

عام نوع صنف_تحويل_نوع =
    | غير_صالح
    | ضمني_آمن
    | صريح_آمن
    | يتطلب_غير_آمن
;

// Canonical target-neutral integer conversion meaning. Width transformation is
// separate from the semantic signedness interpretation of the target Type.
عام نوع تغيير_عرض_صحيح_دلالي =
    | حفظ
    | توسيع_صفري
    | توسيع_بإشارة
    | اقتطاع
;

عام نوع تفسير_صحيح_دلالي =
    | موقع
    | طبيعي
;

عام نوع وصف_تحويل_صحيح_دلالي = {
    المصدر: معرف_نوع,
    الهدف: معرف_نوع,
    تغيير_العرض: تغيير_عرض_صحيح_دلالي,
    تفسير_الهدف: تفسير_صحيح_دلالي
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_نوع_مقنن(القيمة: &نوع_مقنن): نوع_مقنن {
    طابق *القيمة مع
    | نوع_مقنن.بدائي(ح0) -> { أرجع نوع_مقنن.بدائي(ح0); }
    | نوع_مقنن.صف(ح0) -> { أرجع نوع_مقنن.صف(انسخ_مملوكا_متجه_معرف_نوع(&ح0)); }
    | نوع_مقنن.صندوق(ح0) -> { أرجع نوع_مقنن.صندوق(ح0); }
    | نوع_مقنن.اختيار(ح0) -> { أرجع نوع_مقنن.اختيار(ح0); }
    | نوع_مقنن.نتيجة(ح0, ح1) -> { أرجع نوع_مقنن.نتيجة(ح0, ح1); }
    | نوع_مقنن.دالة(ح0, ح1) -> { أرجع نوع_مقنن.دالة(انسخ_مملوكا_متجه_معرف_نوع(&ح0), ح1); }
    | نوع_مقنن.معامل_نوع(ح0) -> { أرجع نوع_مقنن.معامل_نوع(ح0); }
    | نوع_مقنن.مسمى(ح0, ح1, ح2) -> { أرجع نوع_مقنن.مسمى(ح0, ح1, انسخ_مملوكا_متجه_معرف_نوع(&ح2)); }
    | نوع_مقنن.مؤشر(ح0) -> { أرجع نوع_مقنن.مؤشر(ح0); }
    | نوع_مقنن.مرجع(ح0, ح1) -> { أرجع نوع_مقنن.مرجع(ح0, ح1); }
    | نوع_مقنن.شريحة(ح0) -> { أرجع نوع_مقنن.شريحة(ح0); }
    | نوع_مقنن.متجه(ح0) -> { أرجع نوع_مقنن.متجه(ح0); }
    | نوع_مقنن.متغير(ح0) -> { أرجع نوع_مقنن.متغير(ح0); };
}

عام عرف انسخ_مملوكا_ربط_نوع_مسمى(القيمة: &ربط_نوع_مسمى): ربط_نوع_مسمى {
    دع الناتج: ربط_نوع_مسمى = {
        الرمز: (*القيمة).الرمز,
        المعرف: (*القيمة).المعرف,
        معاملات_النوع: انسخ_مملوكا_متجه_معرف_رمز(&(*القيمة).معاملات_النوع),
        التعريف: انسخ_مملوكا_تعريف_نوع_مسمى(&(*القيمة).التعريف)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تعريف_نوع_مسمى(القيمة: &تعريف_نوع_مسمى): تعريف_نوع_مسمى {
    طابق *القيمة مع
    | تعريف_نوع_مسمى.مرادف -> { أرجع تعريف_نوع_مسمى.مرادف(); }
    | تعريف_نوع_مسمى.سجل(ح0) -> { أرجع تعريف_نوع_مسمى.سجل(انسخ_مملوكا_متجه_حقل_سجل_دلالي(&ح0)); }
    | تعريف_نوع_مسمى.تعداد(ح0) -> { أرجع تعريف_نوع_مسمى.تعداد(انسخ_مملوكا_متجه_منشئ_نوع_دلالي(&ح0)); };
}

عام عرف انسخ_مملوكا_متجه_حقل_سجل_دلالي(القيمة: &متجه حقل_سجل_دلالي): متجه حقل_سجل_دلالي {
    دع الناتج: متغير متجه حقل_سجل_دلالي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_منشئ_نوع_دلالي(القيمة: &متجه منشئ_نوع_دلالي): متجه منشئ_نوع_دلالي {
    دع الناتج: متغير متجه منشئ_نوع_دلالي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_منشئ_نوع_دلالي(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_منشئ_نوع_دلالي(القيمة: &منشئ_نوع_دلالي): منشئ_نوع_دلالي {
    دع الناتج: منشئ_نوع_دلالي = {
        الهوية: (*القيمة).الهوية,
        الاسم: (*القيمة).الاسم,
        الحمولات: انسخ_مملوكا_متجه_معرف_نوع(&(*القيمة).الحمولات)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_ربط_استبدال_نوع(القيمة: &متجه ربط_استبدال_نوع): متجه ربط_استبدال_نوع {
    دع الناتج: متغير متجه ربط_استبدال_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
