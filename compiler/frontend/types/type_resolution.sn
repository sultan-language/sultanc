عرف بدائي_من_آلة(النوع: نوع_آلة): نوع_بدائي_مقنن {
    طابق النوع مع
    | نوع_آلة.ص8 -> {
        أرجع نوع_بدائي_مقنن.ص8();
    }
    | نوع_آلة.ص16 -> {
        أرجع نوع_بدائي_مقنن.ص16();
    }
    | نوع_آلة.ص32 -> {
        أرجع نوع_بدائي_مقنن.ص32();
    }
    | نوع_آلة.ص64 -> {
        أرجع نوع_بدائي_مقنن.ص64();
    }
    | نوع_آلة.غ8 -> {
        أرجع نوع_بدائي_مقنن.غ8();
    }
    | نوع_آلة.غ16 -> {
        أرجع نوع_بدائي_مقنن.غ16();
    }
    | نوع_آلة.غ32 -> {
        أرجع نوع_بدائي_مقنن.غ32();
    }
    | نوع_آلة.غ64 -> {
        أرجع نوع_بدائي_مقنن.غ64();
    }
    | نوع_آلة.ع32 -> {
        أرجع نوع_بدائي_مقنن.ع32();
    }
    | نوع_آلة.ع64 -> {
        أرجع نوع_بدائي_مقنن.ع64();
    };
}

عام عرف قنن_نوع_تركيبي(
    سجل_الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    النوع: &نوع_تركيبي
): نتيجة_حل_نوع {
    دع القيمة: نوع_تركيبي = *النوع;
    طابق القيمة مع
    | نوع_تركيبي.أي(س) -> {
        أرجع نتيجة_حل_نوع.موجود(قنن_نوعا_بدائيا(سجل_الأنواع, نوع_بدائي_مقنن.أي()));
    }
    | نوع_تركيبي.منطقي(س) -> {
        أرجع نتيجة_حل_نوع.موجود(قنن_نوعا_بدائيا(سجل_الأنواع, نوع_بدائي_مقنن.منطقي()));
    }
    | نوع_تركيبي.آلة(س, آلة) -> {
        أرجع نتيجة_حل_نوع.موجود(قنن_نوعا_بدائيا(سجل_الأنواع, بدائي_من_آلة(آلة)));
    }
    | نوع_تركيبي.عدد(س) -> {
        أرجع نتيجة_حل_نوع.موجود(قنن_نوعا_بدائيا(سجل_الأنواع, نوع_بدائي_مقنن.عدد()));
    }
    | نوع_تركيبي.غير_موقع(س) -> {
        أرجع نتيجة_حل_نوع.موجود(قنن_نوعا_بدائيا(سجل_الأنواع, نوع_بدائي_مقنن.غير_موقع()));
    }
    | نوع_تركيبي.حرف(س) -> {
        أرجع نتيجة_حل_نوع.موجود(قنن_نوعا_بدائيا(سجل_الأنواع, نوع_بدائي_مقنن.حرف()));
    }
    | نوع_تركيبي.نص(س) -> {
        أرجع نتيجة_حل_نوع.موجود(قنن_نوعا_بدائيا(سجل_الأنواع, نوع_بدائي_مقنن.نص()));
    }
    | نوع_تركيبي.فراغ(س) -> {
        أرجع نتيجة_حل_نوع.موجود(قنن_نوعا_بدائيا(سجل_الأنواع, نوع_بدائي_مقنن.فراغ()));
    }
    | نوع_تركيبي.صف(س, العناصر) -> {
        دع المعرفات: متغير متجه معرف_نوع = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
            دع نتيجة_العنصر: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &العناصر[ف]);
            طابق نتيجة_العنصر مع
            | نتيجة_حل_نوع.موجود(المعرف) -> {
                ألحق(المعرفات, المعرف);
            }
            | نتيجة_حل_نوع.مفقود -> {
                أرجع نتيجة_حل_نوع.مفقود();
            }
            | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
                أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
            }
            | نتيجة_حل_نوع.غير_صالح -> {
                أرجع نتيجة_حل_نوع.غير_صالح();
            };
            ف := ف + 1;
        }
        دع المقنن: نوع_مقنن = نوع_مقنن.صف(المعرفات);
        أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, المقنن));
    }
    | نوع_تركيبي.صندوق(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع النتيجة: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &قيمة_الداخل);
        طابق النتيجة مع
        | نتيجة_حل_نوع.موجود(المعرف) -> {
            أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, نوع_مقنن.صندوق(المعرف)));
        }
        | نتيجة_حل_نوع.مفقود -> {
            أرجع نتيجة_حل_نوع.مفقود();
        }
        | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        }
        | نتيجة_حل_نوع.غير_صالح -> {
            أرجع نتيجة_حل_نوع.غير_صالح();
        };
    }
    | نوع_تركيبي.اختيار(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع النتيجة: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &قيمة_الداخل);
        طابق النتيجة مع
        | نتيجة_حل_نوع.موجود(المعرف) -> {
            أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, نوع_مقنن.اختيار(المعرف)));
        }
        | نتيجة_حل_نوع.مفقود -> {
            أرجع نتيجة_حل_نوع.مفقود();
        }
        | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        }
        | نتيجة_حل_نوع.غير_صالح -> {
            أرجع نتيجة_حل_نوع.غير_صالح();
        };
    }
    | نوع_تركيبي.مؤشر(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع النتيجة: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &قيمة_الداخل);
        طابق النتيجة مع
        | نتيجة_حل_نوع.موجود(المعرف) -> {
            أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, نوع_مقنن.مؤشر(المعرف)));
        }
        | نتيجة_حل_نوع.مفقود -> {
            أرجع نتيجة_حل_نوع.مفقود();
        }
        | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        }
        | نتيجة_حل_نوع.غير_صالح -> {
            أرجع نتيجة_حل_نوع.غير_صالح();
        };
    }
    | نوع_تركيبي.مرجع(س, الداخل) -> {
        دع قيمة: نوع_تركيبي = *الداخل;
        طابق قيمة مع
        | نوع_تركيبي.متغير(س2, داخل_متغير) -> {
            دع الأساس: نوع_تركيبي = *داخل_متغير;
            دع النتيجة: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &الأساس);
            طابق النتيجة مع
            | نتيجة_حل_نوع.موجود(المعرف) -> {
                أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, نوع_مقنن.مرجع(المعرف, صواب)));
            }
            | نتيجة_حل_نوع.مفقود -> {
                أرجع نتيجة_حل_نوع.مفقود();
            }
            | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
                أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
            }
            | نتيجة_حل_نوع.غير_صالح -> {
                أرجع نتيجة_حل_نوع.غير_صالح();
            };
        }
        | _ -> {
            دع النتيجة: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &قيمة);
            طابق النتيجة مع
            | نتيجة_حل_نوع.موجود(المعرف) -> {
                أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, نوع_مقنن.مرجع(المعرف, خطأ)));
            }
            | نتيجة_حل_نوع.مفقود -> {
                أرجع نتيجة_حل_نوع.مفقود();
            }
            | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
                أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
            }
            | نتيجة_حل_نوع.غير_صالح -> {
                أرجع نتيجة_حل_نوع.غير_صالح();
            };
        };
    }
    | نوع_تركيبي.شريحة(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع النتيجة: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &قيمة_الداخل);
        طابق النتيجة مع
        | نتيجة_حل_نوع.موجود(المعرف) -> {
            أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, نوع_مقنن.شريحة(المعرف)));
        }
        | نتيجة_حل_نوع.مفقود -> {
            أرجع نتيجة_حل_نوع.مفقود();
        }
        | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        }
        | نتيجة_حل_نوع.غير_صالح -> {
            أرجع نتيجة_حل_نوع.غير_صالح();
        };
    }
    | نوع_تركيبي.متجه(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع النتيجة: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &قيمة_الداخل);
        طابق النتيجة مع
        | نتيجة_حل_نوع.موجود(المعرف) -> {
            أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, نوع_مقنن.متجه(المعرف)));
        }
        | نتيجة_حل_نوع.مفقود -> {
            أرجع نتيجة_حل_نوع.مفقود();
        }
        | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        }
        | نتيجة_حل_نوع.غير_صالح -> {
            أرجع نتيجة_حل_نوع.غير_صالح();
        };
    }
    | نوع_تركيبي.متغير(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع النتيجة: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &قيمة_الداخل);
        طابق النتيجة مع
        | نتيجة_حل_نوع.موجود(المعرف) -> {
            أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, نوع_مقنن.متغير(المعرف)));
        }
        | نتيجة_حل_نوع.مفقود -> {
            أرجع نتيجة_حل_نوع.مفقود();
        }
        | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        }
        | نتيجة_حل_نوع.غير_صالح -> {
            أرجع نتيجة_حل_نوع.غير_صالح();
        };
    }
    | نوع_تركيبي.نتيجة(س, الناجح, الفشل) -> {
        دع أ: نوع_تركيبي = *الناجح;
        دع ب: نوع_تركيبي = *الفشل;
        دع نتيجة_أ: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &أ);
        دع نتيجة_ب: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &ب);
        طابق نتيجة_أ مع
        | نتيجة_حل_نوع.موجود(معرف_أ) -> {
            طابق نتيجة_ب مع
            | نتيجة_حل_نوع.موجود(معرف_ب) -> {
                دع المقنن: نوع_مقنن = نوع_مقنن.نتيجة(معرف_أ, معرف_ب);
                أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, المقنن));
            }
            | نتيجة_حل_نوع.مفقود -> {
                أرجع نتيجة_حل_نوع.مفقود();
            }
            | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
                أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
            }
            | نتيجة_حل_نوع.غير_صالح -> {
                أرجع نتيجة_حل_نوع.غير_صالح();
            };
        }
        | نتيجة_حل_نوع.مفقود -> {
            أرجع نتيجة_حل_نوع.مفقود();
        }
        | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        }
        | نتيجة_حل_نوع.غير_صالح -> {
            أرجع نتيجة_حل_نوع.غير_صالح();
        };
    }
    | نوع_تركيبي.دالة(س, المعاملات, الناتج) -> {
        دع معرفات: متغير متجه معرف_نوع = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المعاملات) مثل غير_موقع)) {
            دع نتيجة_المعامل: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &المعاملات[ف]);
            طابق نتيجة_المعامل مع
            | نتيجة_حل_نوع.موجود(المعرف) -> {
                ألحق(معرفات, المعرف);
            }
            | نتيجة_حل_نوع.مفقود -> {
                أرجع نتيجة_حل_نوع.مفقود();
            }
            | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
                أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
            }
            | نتيجة_حل_نوع.غير_صالح -> {
                أرجع نتيجة_حل_نوع.غير_صالح();
            };
            ف := ف + 1;
        }
        دع نوع_الناتج: نوع_تركيبي = *الناتج;
        دع نتيجة_الناتج: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &نوع_الناتج);
        طابق نتيجة_الناتج مع
        | نتيجة_حل_نوع.موجود(معرف_الناتج) -> {
            دع المقنن: نوع_مقنن = نوع_مقنن.دالة(معرفات, معرف_الناتج);
            أرجع نتيجة_حل_نوع.موجود(قنن_نوعا(سجل_الأنواع, المقنن));
        }
        | نتيجة_حل_نوع.مفقود -> {
            أرجع نتيجة_حل_نوع.مفقود();
        }
        | نتيجة_حل_نوع.معاملات_غير_مدعومة -> {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        }
        | نتيجة_حل_نوع.غير_صالح -> {
            أرجع نتيجة_حل_نوع.غير_صالح();
        };
    }
    | نوع_تركيبي.مسمى(س, الاسم, الحجج) -> {
        دع الرمز: اختيار معرف_رمز = رمز_اسم_محلول_عند(الروابط, الاسم.النطاق);
        طابق الرمز مع
        | اختيار.بعض(المعرف) -> {
            طابق نوع_معامل_مسجل_عند(سجل_الأنواع, المعرف) مع
            | اختيار.بعض(نوع_المعامل) -> {
                لو (الطول(الحجج) != 0) { أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة(); };
                أرجع نتيجة_حل_نوع.موجود(نوع_المعامل);
            }
            | اختيار.لا_شيء -> {
                دع حجج_مقننة: متغير متجه معرف_نوع = [];
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
                    دع نتيجة_الحجة: نتيجة_حل_نوع = قنن_نوع_تركيبي(سجل_الأنواع, الروابط, &الحجج[ف]);
                    طابق نتيجة_الحجة مع
                    | نتيجة_حل_نوع.موجود(نوع_الحجة) -> { ألحق(حجج_مقننة, نوع_الحجة); }
                    | نتيجة_حل_نوع.مفقود -> { أرجع نتيجة_حل_نوع.مفقود(); }
                    | نتيجة_حل_نوع.معاملات_غير_مدعومة -> { أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة(); }
                    | نتيجة_حل_نوع.غير_صالح -> { أرجع نتيجة_حل_نوع.غير_صالح(); };
                    ف := ف + 1;
                }
                أرجع حل_نوع_مسمى_بحجج(سجل_الأنواع, المعرف, حجج_مقننة);
            };
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_حل_نوع.مفقود();
        };
    };
}
