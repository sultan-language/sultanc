استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.names.identifiers;

استورد compiler.frontend.types.type_context;

عرف امزج_هاش_نوع(الهاش: طبيعي, القيمة: طبيعي): طبيعي {
    أرجع ((الهاش * 257) + (القيمة % 1048573)) % 1048573;
}

عرف امزج_متجه_معرفات_نوع(الهاش: طبيعي, القيم: &متجه معرف_نوع): طبيعي {
    دع قيمة_التجزئة: متغير طبيعي = امزج_هاش_نوع(الهاش, الطول(*القيم) مثل طبيعي);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        قيمة_التجزئة := امزج_هاش_نوع(قيمة_التجزئة, (*القيم)[ف].القيمة);
        ف := ف + 1;
    }
    أرجع قيمة_التجزئة;
}

عرف هاش_نوع_مقنن(النوع: &نوع_مقنن): طبيعي {
    طابق *النوع مع
    | نوع_مقنن.بدائي(البدائي) -> {
        دع قيمة_التجزئة: طبيعي = امزج_هاش_نوع(1, رقم_نوع_بدائي(البدائي));
        أرجع قيمة_التجزئة;
    }
    | نوع_مقنن.صف(العناصر) -> {
        أرجع امزج_متجه_معرفات_نوع(2, &العناصر);
    }
    | نوع_مقنن.صندوق(الداخل) -> { أرجع امزج_هاش_نوع(3, الداخل.القيمة); }
    | نوع_مقنن.اختيار(الداخل) -> { أرجع امزج_هاش_نوع(4, الداخل.القيمة); }
    | نوع_مقنن.نتيجة(النجاح, الفشل) -> {
        دع قيمة_التجزئة: متغير طبيعي = امزج_هاش_نوع(5, النجاح.القيمة);
        قيمة_التجزئة := امزج_هاش_نوع(قيمة_التجزئة, الفشل.القيمة);
        أرجع قيمة_التجزئة;
    }
    | نوع_مقنن.دالة(المعاملات, الناتج) -> {
        دع قيمة_التجزئة: متغير طبيعي = امزج_متجه_معرفات_نوع(6, &المعاملات);
        قيمة_التجزئة := امزج_هاش_نوع(قيمة_التجزئة, الناتج.القيمة);
        أرجع قيمة_التجزئة;
    }
    | نوع_مقنن.معامل_نوع(الرمز) -> {
        أرجع امزج_هاش_نوع(7, الرمز.القيمة);
    }
    | نوع_مقنن.مسمى(الرمز, الشكل, الحجج) -> {
        دع قيمة_التجزئة: متغير طبيعي = امزج_هاش_نوع(8, الرمز.القيمة);
        طابق الشكل مع
        | شكل_نوع_مسمى.سجل -> { قيمة_التجزئة := امزج_هاش_نوع(قيمة_التجزئة, 1); }
        | شكل_نوع_مسمى.تعداد -> { قيمة_التجزئة := امزج_هاش_نوع(قيمة_التجزئة, 2); }
        | شكل_نوع_مسمى.معتم -> { قيمة_التجزئة := امزج_هاش_نوع(قيمة_التجزئة, 3); };
        قيمة_التجزئة := امزج_متجه_معرفات_نوع(قيمة_التجزئة, &الحجج);
        أرجع قيمة_التجزئة;
    }
    | نوع_مقنن.مؤشر(الداخل) -> { أرجع امزج_هاش_نوع(9, الداخل.القيمة); }
    | نوع_مقنن.مرجع(الداخل, متغير_المرجع) -> {
        دع قيمة_التجزئة: متغير طبيعي = امزج_هاش_نوع(10, الداخل.القيمة);
        إذا (متغير_المرجع) { قيمة_التجزئة := امزج_هاش_نوع(قيمة_التجزئة, 1); } وإلا { قيمة_التجزئة := امزج_هاش_نوع(قيمة_التجزئة, 0); };
        أرجع قيمة_التجزئة;
    }
    | نوع_مقنن.شريحة(الداخل) -> { أرجع امزج_هاش_نوع(11, الداخل.القيمة); }
    | نوع_مقنن.متجه(الداخل) -> { أرجع امزج_هاش_نوع(12, الداخل.القيمة); }
    | نوع_مقنن.متغير(الداخل) -> { أرجع امزج_هاش_نوع(13, الداخل.القيمة); };
}

عرف ابن_فهرس_أنواع_فارغا(السعة: طبيعي): متجه اختياري مدخل_فهرس_نوع {
    دع الناتج: متغير متجه اختياري مدخل_فهرس_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) {
        ألحق(الناتج, اختياري.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أدرج_مدخل_فهرس_نوع(
    الفهرس: &متغير متجه اختياري مدخل_فهرس_نوع,
    المدخل: مدخل_فهرس_نوع
): فراغ {
    دع السعة: طبيعي = الطول(*الفهرس) مثل طبيعي;
    إذا (السعة == 0) { أرجع; };
    دع الموضع: متغير طبيعي = (المدخل.الهاش مثل طبيعي) % السعة;
    طالما (صواب) {
        طابق (*الفهرس)[الموضع] مع
        | اختياري.لا_شيء -> {
            (*الفهرس)[الموضع] := اختياري.موجود(المدخل);
            أرجع;
        }
        | اختياري.موجود(_) -> { الموضع := (الموضع + 1) % السعة; };
    }
}

عرف أدرج_مدخل_فهرس_سجل_الأنواع(
    سجل_الأنواع: &متغير سجل_أنواع,
    المدخل: مدخل_فهرس_نوع
): فراغ {
    دع السعة: طبيعي = الطول((*سجل_الأنواع).فهرس_الأنواع) مثل طبيعي;
    إذا (السعة == 0) { أرجع; };
    دع الموضع: متغير طبيعي = (المدخل.الهاش مثل طبيعي) % السعة;
    طالما (صواب) {
        طابق (*سجل_الأنواع).فهرس_الأنواع[الموضع] مع
        | اختياري.لا_شيء -> {
            (*سجل_الأنواع).فهرس_الأنواع[الموضع] := اختياري.موجود(المدخل);
            أرجع;
        }
        | اختياري.موجود(_) -> { الموضع := (الموضع + 1) % السعة; };
    }
}

عرف تأكد_سعة_فهرس_الأنواع(سجل_الأنواع: &متغير سجل_أنواع): فراغ {
    دع العدد: طبيعي = الطول((*سجل_الأنواع).الأنواع) مثل طبيعي;
    دع القديمة: طبيعي = الطول((*سجل_الأنواع).فهرس_الأنواع) مثل طبيعي;
    دع تحتاج: متغير منطقي = القديمة == 0;
    إذا (!تحتاج) {
        تحتاج := (العدد * 3) >= (القديمة * 2);
    };
    إذا (!تحتاج) { أرجع; };
    دع الجديدة: متغير طبيعي = 32;
    إذا (القديمة > 0) { الجديدة := القديمة * 2; };
    دع الفهرس_الجديد: متغير متجه اختياري مدخل_فهرس_نوع = ابن_فهرس_أنواع_فارغا(الجديدة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < القديمة) {
        طابق (*سجل_الأنواع).فهرس_الأنواع[ف] مع
        | اختياري.موجود(المدخل) -> { أدرج_مدخل_فهرس_نوع(&متغير الفهرس_الجديد, المدخل); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    (*سجل_الأنواع).فهرس_الأنواع := الفهرس_الجديد;
}
عام عرف سجل_أنواع_جديد(): سجل_أنواع {
    // Primitive Type identity is fixed by builtins_generated.sn. Seed those canonical
    // identities once so primitive use never re-interns by scanning the registry.
    دع الأنواع: متغير متجه نوع_مقنن = [];
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.أي()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.منطقي()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.نص()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.حرف()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.عدد()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.طبيعي()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.فراغ()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص8()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص16()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص32()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص64()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ط8()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ط16()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ط32()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ط64()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ع32()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ع64()));
    دع المسماة: متجه اختياري ربط_نوع_مسمى = [];
    دع مثيلات_المسماة: متجه اختياري تعريف_نوع_مسمى = [];
    دع معاملات_النوع: متجه اختياري معرف_نوع = [];
    دع تصنيفات_ملكية: متجه ط8 = [];
    دع فهرس_الأنواع: متغير متجه اختياري مدخل_فهرس_نوع = ابن_فهرس_أنواع_فارغا(32);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأنواع) مثل طبيعي)) {
        دع المعرف: معرف_نوع = معرف_نوع_من(ف);
        دع الهاش: طبيعي = هاش_نوع_مقنن(&الأنواع[ف]);
        دع المدخل: مدخل_فهرس_نوع = { الهاش: الهاش مثل ط32, المعرف: المعرف };
        أدرج_مدخل_فهرس_نوع(&متغير فهرس_الأنواع, المدخل);
        ف := ف + 1;
    }
    دع سجل_الأنواع: سجل_أنواع = {
        الأنواع: الأنواع,
        فهرس_الأنواع: فهرس_الأنواع,
        المسماة: المسماة,
        مثيلات_المسماة: مثيلات_المسماة,
        معاملات_النوع: معاملات_النوع,
        تصنيفات_ملكية_مسير: تصنيفات_ملكية
    };
    أرجع سجل_الأنواع;
}

// The number of registered TypeIDs.
عام عرف عدد_الأنواع_المسجلة(سجل_الأنواع: &سجل_أنواع): طبيعي {
    أرجع الطول((*سجل_الأنواع).الأنواع) مثل طبيعي;
}

// MSIR lowering's cached ownership class of a Type (type_context.sn); 0 when
// it was not computed.
عام عرف تصنيف_ملكية_مسير_عند(سجل_الأنواع: &سجل_أنواع, النوع: معرف_نوع): ط8 {
    إذا ((النوع.القيمة مثل طبيعي) >= (الطول((*سجل_الأنواع).تصنيفات_ملكية_مسير) مثل طبيعي)) { أرجع 0; };
    أرجع (*سجل_الأنواع).تصنيفات_ملكية_مسير[النوع.القيمة];
}

عام عرف امسح_تصنيفات_ملكية_مسير(سجل_الأنواع: &متغير سجل_أنواع): فراغ {
    دع الفارغة: متجه ط8 = [];
    (*سجل_الأنواع).تصنيفات_ملكية_مسير := الفارغة;
}

// Caches the class of the next unclassified TypeID.
عام عرف ألحق_تصنيف_ملكية_مسير(سجل_الأنواع: &متغير سجل_أنواع, الصنف: ط8): فراغ {
    ألحق((*سجل_الأنواع).تصنيفات_ملكية_مسير, الصنف);
}

عرف متجه_معرفات_متساو(أ: &متجه معرف_نوع, ب: &متجه معرف_نوع): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) {
        أرجع خطأ;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا (!معرفا_نوع_متساويان((*أ)[ف], (*ب)[ف])) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف رقم_شكل_نوع_مسمى(الشكل: شكل_نوع_مسمى): طبيعي {
    طابق الشكل مع
    | شكل_نوع_مسمى.سجل -> { أرجع 1; }
    | شكل_نوع_مسمى.تعداد -> { أرجع 2; }
    | شكل_نوع_مسمى.معتم -> { أرجع 3; };
}

عرف هل_شكل_نوع_مسمى_معتم(الشكل: شكل_نوع_مسمى): منطقي {
    طابق الشكل مع
    | شكل_نوع_مسمى.سجل -> { أرجع خطأ; }
    | شكل_نوع_مسمى.تعداد -> { أرجع خطأ; }
    | شكل_نوع_مسمى.معتم -> { أرجع صواب; };
}

عرف شكلان_مسميان_متساويان(أ: شكل_نوع_مسمى, ب: شكل_نوع_مسمى): منطقي {
    أرجع رقم_شكل_نوع_مسمى(أ) == رقم_شكل_نوع_مسمى(ب);
}

عرف نوعان_متساويان(أ: &نوع_مقنن, ب: &نوع_مقنن): منطقي {
    طابق *أ مع
    | نوع_مقنن.بدائي(أ_نوع) -> {
        طابق *ب مع
        | نوع_مقنن.بدائي(ب_نوع) -> {
            أرجع رقم_نوع_بدائي(أ_نوع) == رقم_نوع_بدائي(ب_نوع);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.صف(أ_عناصر) -> {
        طابق *ب مع
        | نوع_مقنن.صف(ب_عناصر) -> {
            أرجع متجه_معرفات_متساو(&أ_عناصر, &ب_عناصر);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.صندوق(أ_داخل) -> {
        طابق *ب مع
        | نوع_مقنن.صندوق(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.اختيار(أ_داخل) -> {
        طابق *ب مع
        | نوع_مقنن.اختيار(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.نتيجة(أ_نجاح, أ_فشل) -> {
        طابق *ب مع
        | نوع_مقنن.نتيجة(ب_نجاح, ب_فشل) -> {
            أرجع معرفا_نوع_متساويان(أ_نجاح, ب_نجاح) && معرفا_نوع_متساويان(أ_فشل, ب_فشل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.دالة(أ_معاملات, أ_ناتج) -> {
        طابق *ب مع
        | نوع_مقنن.دالة(ب_معاملات, ب_ناتج) -> {
            أرجع متجه_معرفات_متساو(&أ_معاملات, &ب_معاملات)
                && معرفا_نوع_متساويان(أ_ناتج, ب_ناتج);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.معامل_نوع(أ_رمز) -> {
        طابق *ب مع
        | نوع_مقنن.معامل_نوع(ب_رمز) -> {
            أرجع معرفا_رمز_متساويان(أ_رمز, ب_رمز);
        }
        | _ -> { أرجع خطأ; };
    }
    | نوع_مقنن.مسمى(أ_رمز, أ_شكل, أ_حجج) -> {
        طابق *ب مع
        | نوع_مقنن.مسمى(ب_رمز, ب_شكل, ب_حجج) -> {
            أرجع معرفا_رمز_متساويان(أ_رمز, ب_رمز)
                && شكلان_مسميان_متساويان(أ_شكل, ب_شكل)
                && متجه_معرفات_متساو(&أ_حجج, &ب_حجج);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.مؤشر(أ_داخل) -> {
        طابق *ب مع
        | نوع_مقنن.مؤشر(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.مرجع(أ_داخل, أ_متغير) -> {
        طابق *ب مع
        | نوع_مقنن.مرجع(ب_داخل, ب_متغير) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل) && (أ_متغير == ب_متغير);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.شريحة(أ_داخل) -> {
        طابق *ب مع
        | نوع_مقنن.شريحة(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.متجه(أ_داخل) -> {
        طابق *ب مع
        | نوع_مقنن.متجه(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.متغير(أ_داخل) -> {
        طابق *ب مع
        | نوع_مقنن.متغير(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف ابحث_عن_نوع_مقنن(
    سجل_الأنواع: &سجل_أنواع,
    النوع: &نوع_مقنن,
    الهاش: طبيعي
): اختياري معرف_نوع {
    دع السعة: طبيعي = الطول((*سجل_الأنواع).فهرس_الأنواع) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        طابق (*سجل_الأنواع).فهرس_الأنواع[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المدخل) -> {
            إذا ((المدخل.الهاش مثل طبيعي) == الهاش
                && (المدخل.المعرف.القيمة مثل طبيعي) < (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)
                && نوعان_متساويان(&(*سجل_الأنواع).الأنواع[المدخل.المعرف.القيمة], النوع)) {
                أرجع اختياري.موجود(المدخل.المعرف);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف قنن_نوعا(سجل_الأنواع: &متغير سجل_أنواع, النوع: نوع_مقنن): معرف_نوع {
    دع الهاش: طبيعي = هاش_نوع_مقنن(&النوع);
    طابق ابحث_عن_نوع_مقنن(سجل_الأنواع, &النوع, الهاش) مع
    | اختياري.موجود(المعرف) -> { أرجع المعرف; }
    | اختياري.لا_شيء -> { };

    // A slice views a vector of the same elements (a slice literal builds
    // one), so the vector Type exists wherever the slice Type does.
    دع عنصر_الشريحة: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق النوع مع
    | نوع_مقنن.شريحة(العنصر) -> { عنصر_الشريحة := اختياري.موجود(العنصر); }
    | _ -> { };
    دع المعرف: معرف_نوع = معرف_نوع_من(الطول((*سجل_الأنواع).الأنواع) مثل طبيعي);
    ألحق((*سجل_الأنواع).الأنواع, النوع);
    تأكد_سعة_فهرس_الأنواع(سجل_الأنواع);
    دع المدخل: مدخل_فهرس_نوع = { الهاش: الهاش مثل ط32, المعرف: المعرف };
    أدرج_مدخل_فهرس_سجل_الأنواع(سجل_الأنواع, المدخل);
    طابق عنصر_الشريحة مع
    | اختياري.موجود(العنصر) -> {
        دع المتجه: معرف_نوع = قنن_نوعا(سجل_الأنواع, نوع_مقنن.متجه(العنصر));
    }
    | اختياري.لا_شيء -> { };
    أرجع المعرف;
}

// The vector Type a slice of العنصر views (interned with the slice Type).
عام عرف معرف_نوع_متجه_مقنن_موجود(
    سجل_الأنواع: &سجل_أنواع,
    العنصر: معرف_نوع
): اختياري معرف_نوع {
    دع النوع: نوع_مقنن = نوع_مقنن.متجه(العنصر);
    أرجع ابحث_عن_نوع_مقنن(سجل_الأنواع, &النوع, هاش_نوع_مقنن(&النوع));
}

عام عرف قنن_نوعا_بدائيا(
    سجل_الأنواع: &متغير سجل_أنواع,
    النوع: نوع_بدائي_مقنن
): معرف_نوع {
    // سجل_أنواع_جديد seeds primitives in the generated canonical ordinal order.
    أرجع معرف_نوع_من(رقم_نوع_بدائي(النوع));
}

عام عرف معرف_نوع_مغلف_متغير_موجود(
    سجل_الأنواع: &سجل_أنواع,
    العنصر: معرف_نوع
): اختياري معرف_نوع {
    دع النوع: نوع_مقنن = نوع_مقنن.متغير(العنصر);
    أرجع ابحث_عن_نوع_مقنن(سجل_الأنواع, &النوع, هاش_نوع_مقنن(&النوع));
}

// The option Type of العنصر, when frontend typing interned it (a pop result).
عام عرف معرف_نوع_اختيار_مقنن_موجود(
    سجل_الأنواع: &سجل_أنواع,
    العنصر: معرف_نوع
): اختياري معرف_نوع {
    دع النوع: نوع_مقنن = نوع_مقنن.اختيار(العنصر);
    أرجع ابحث_عن_نوع_مقنن(سجل_الأنواع, &النوع, هاش_نوع_مقنن(&النوع));
}

// Lookup is read-only: frontend typing has already interned the pointer ABI Type.
عام عرف معرف_نوع_مؤشر_مقنن_موجود(
    سجل_الأنواع: &سجل_أنواع,
    العنصر: معرف_نوع
): اختياري معرف_نوع {
    دع النوع: نوع_مقنن = نوع_مقنن.مؤشر(العنصر);
    أرجع ابحث_عن_نوع_مقنن(سجل_الأنواع, &النوع, هاش_نوع_مقنن(&النوع));
}

عام عرف معرف_نوع_صالح(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع (المعرف.القيمة مثل طبيعي) < (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي);
}

عام عرف سجل_معامل_نوع(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز
): معرف_نوع {
    إذا ((الرمز.القيمة مثل طبيعي) < (الطول((*سجل_الأنواع).معاملات_النوع) مثل طبيعي)) {
        طابق (*سجل_الأنواع).معاملات_النوع[الرمز.القيمة] مع
        | اختياري.موجود(المعرف) -> { أرجع المعرف; }
        | اختياري.لا_شيء -> { };
    };
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, نوع_مقنن.معامل_نوع(الرمز));
    طالما ((الطول((*سجل_الأنواع).معاملات_النوع) مثل طبيعي) <= (الرمز.القيمة مثل طبيعي)) {
        ألحق((*سجل_الأنواع).معاملات_النوع, اختياري.لا_شيء());
    }
    (*سجل_الأنواع).معاملات_النوع[الرمز.القيمة] := اختياري.موجود(المعرف);
    أرجع المعرف;
}

عام عرف نوع_معامل_مسجل_عند(
    سجل_الأنواع: &سجل_أنواع,
    الرمز: معرف_رمز
): اختياري معرف_نوع {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*سجل_الأنواع).معاملات_النوع) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع (*سجل_الأنواع).معاملات_النوع[الرمز.القيمة];
}

عام عرف معرف_نوع_مسمى_عند(
    المسماة: &متجه اختياري ربط_نوع_مسمى,
    الرمز: معرف_رمز
): اختياري معرف_نوع {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول(*المسماة) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الخانة: &اختياري ربط_نوع_مسمى = &(*المسماة)[الرمز.القيمة];
    طابق *مرجع_الخانة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الربط) -> { أرجع اختياري.موجود(الربط.المعرف); };
}

عام عرف ربط_نوع_مسمى_عند(
    سجل_الأنواع: &سجل_أنواع,
    الرمز: معرف_رمز
): اختياري ربط_نوع_مسمى {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*سجل_الأنواع).المسماة) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    // An independent copy: callers instantiate generics and mutate the registry
    // while using it. Read-only queries borrow slots in place instead.
    طابق (*سجل_الأنواع).المسماة[الرمز.القيمة] مع
    | اختياري.موجود(الربط) -> { أرجع اختياري.موجود(انسخ_مملوكا_ربط_نوع_مسمى(&الربط)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// The number of declared Type parameters of a named Type template.
عرف عدد_معاملات_نوع_مسمى(
    سجل_الأنواع: &سجل_أنواع,
    الرمز: معرف_رمز
): اختياري طبيعي {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*سجل_الأنواع).المسماة) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    طابق (*سجل_الأنواع).المسماة[الرمز.القيمة] مع
    | اختياري.موجود(الربط) -> { أرجع اختياري.موجود(الطول(الربط.معاملات_النوع) مثل طبيعي); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف انسخ_معاملات_نوع_مسمى(
    سجل_الأنواع: &سجل_أنواع,
    الرمز: معرف_رمز
): متجه معرف_رمز {
    دع الناتج: متغير متجه معرف_رمز = [];
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*سجل_الأنواع).المسماة) مثل طبيعي)) { أرجع الناتج; };
    دع مرجع_الخانة: &اختياري ربط_نوع_مسمى = &(*سجل_الأنواع).المسماة[الرمز.القيمة];
    طابق *مرجع_الخانة مع
    | اختياري.موجود(الربط) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الربط.معاملات_النوع) مثل طبيعي)) {
            ألحق(الناتج, الربط.معاملات_النوع[ف]);
            ف := ف + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    أرجع الناتج;
}

عرف أضف_ربط_نوع_مسمى(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    المعرف: معرف_نوع,
    معاملات_النوع: متجه معرف_رمز,
    التعريف: تعريف_نوع_مسمى
): منطقي {
    طالما ((الطول((*سجل_الأنواع).المسماة) مثل طبيعي) <= (الرمز.القيمة مثل طبيعي)) {
        ألحق((*سجل_الأنواع).المسماة, اختياري.لا_شيء());
    }
    طابق معرف_نوع_مسمى_عند(&(*سجل_الأنواع).المسماة, الرمز) مع
    | اختياري.موجود(_) -> {
        أرجع خطأ;
    }
    | اختياري.لا_شيء -> { };
    دع الربط: ربط_نوع_مسمى = {
        الرمز: الرمز,
        المعرف: المعرف,
        معاملات_النوع: معاملات_النوع,
        التعريف: التعريف
    };
    (*سجل_الأنواع).المسماة[الرمز.القيمة] := اختياري.موجود(الربط);
    أرجع صواب;
}

عام عرف أضف_مرادف_نوع(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    الهدف: معرف_نوع
): منطقي {
    إذا (!معرف_نوع_صالح(سجل_الأنواع, الهدف)) {
        أرجع خطأ;
    };
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.مرادف();
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, الهدف, معاملات_النوع, التعريف);
}

عرف معرفات_معاملات_نوع(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعاملات: &متجه معرف_رمز
): متجه معرف_نوع {
    دع الناتج: متغير متجه معرف_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعاملات) مثل طبيعي)) {
        ألحق(الناتج, سجل_معامل_نوع(سجل_الأنواع, (*المعاملات)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أضف_مرادف_نوع_بمعاملات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    معاملات_النوع: متجه معرف_رمز,
    الهدف: معرف_نوع
): منطقي {
    إذا (!معرف_نوع_صالح(سجل_الأنواع, الهدف)) { أرجع خطأ; };
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.مرادف();
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, الهدف, معاملات_النوع, التعريف);
}

عام عرف أضف_سجل_نوع_بمعاملات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    معاملات_النوع: متجه معرف_رمز
): منطقي {
    دع حجج_القالب: متجه معرف_نوع = معرفات_معاملات_نوع(سجل_الأنواع, &معاملات_النوع);
    دع النوع: نوع_مقنن = نوع_مقنن.مسمى(الرمز, شكل_نوع_مسمى.سجل(), حجج_القالب);
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, النوع);
    دع الحقول: متجه حقل_سجل_دلالي = [];
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.سجل(الحقول);
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, المعرف, معاملات_النوع, التعريف);
}

عام عرف أضف_تعداد_نوع_بمعاملات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    معاملات_النوع: متجه معرف_رمز
): منطقي {
    دع حجج_القالب: متجه معرف_نوع = معرفات_معاملات_نوع(سجل_الأنواع, &معاملات_النوع);
    دع النوع: نوع_مقنن = نوع_مقنن.مسمى(الرمز, شكل_نوع_مسمى.تعداد(), حجج_القالب);
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, النوع);
    دع المنشئات: متجه منشئ_نوع_دلالي = [];
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.تعداد(المنشئات);
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, المعرف, معاملات_النوع, التعريف);
}

عام عرف أضف_سجل_نوع_بحقول(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    الحقول: متجه حقل_سجل_دلالي
): منطقي {
    دع الشكل: شكل_نوع_مسمى = شكل_نوع_مسمى.سجل();
    دع الحجج: متجه معرف_نوع = [];
    دع النوع: نوع_مقنن = نوع_مقنن.مسمى(الرمز, الشكل, الحجج);
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, النوع);
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.سجل(الحقول);
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, المعرف, معاملات_النوع, التعريف);
}

عام عرف أضف_سجل_نوع(سجل_الأنواع: &متغير سجل_أنواع, الرمز: معرف_رمز): منطقي {
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_سجل_نوع_بمعاملات(سجل_الأنواع, الرمز, معاملات_النوع);
}

عام عرف أضف_تعداد_نوع_بمنشئات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    المنشئات: متجه منشئ_نوع_دلالي
): منطقي {
    دع الشكل: شكل_نوع_مسمى = شكل_نوع_مسمى.تعداد();
    دع الحجج: متجه معرف_نوع = [];
    دع النوع: نوع_مقنن = نوع_مقنن.مسمى(الرمز, الشكل, الحجج);
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, النوع);
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.تعداد(المنشئات);
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, المعرف, معاملات_النوع, التعريف);
}

عام عرف أضف_تعداد_نوع(سجل_الأنواع: &متغير سجل_أنواع, الرمز: معرف_رمز): منطقي {
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_تعداد_نوع_بمعاملات(سجل_الأنواع, الرمز, معاملات_النوع);
}

// An opaque named type (`type T = opaque;`): nominal identity of its own
// Symbol, complete at declaration (nothing is filled in later), never generic.
عام عرف أضف_معتم_نوع(سجل_الأنواع: &متغير سجل_أنواع, الرمز: معرف_رمز): منطقي {
    دع الحجج: متجه معرف_نوع = [];
    دع النوع: نوع_مقنن = نوع_مقنن.مسمى(الرمز, شكل_نوع_مسمى.معتم(), الحجج);
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, النوع);
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.معتم();
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, المعرف, معاملات_النوع, التعريف);
}

// Where a Type uses an opaque type other than as the pointee of a raw
// pointer: the opaque Type found, and whether it stands as a type argument
// of a generic named type (`G<T>`) rather than as a value.
عام نوع استعمال_معتم_ممنوع = {
    المعتم: معرف_نوع,
    حجة_نوع: منطقي
};

عرف استعمال_معتم_في_متجه(
    سجل_الأنواع: &سجل_أنواع,
    الأنواع: &متجه معرف_نوع,
    المزارة: &متغير متجه معرف_نوع
): اختياري استعمال_معتم_ممنوع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأنواع) مثل طبيعي)) {
        طابق استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, (*الأنواع)[ف], المزارة) مع
        | اختياري.موجود(الاستعمال) -> { أرجع اختياري.موجود(الاستعمال); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// An instance of a generic named type with an opaque type argument is valid
// while its members (record fields, constructor payloads) hold that type only
// behind pointers. The members are those of the canonical instance
// definition, already substituted. المزارة guards recursion through `*G<T>`.
عرف استعمال_معتم_في_أعضاء_مثيل(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    المزارة: &متغير متجه معرف_نوع
): اختياري استعمال_معتم_ممنوع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المزارة) مثل طبيعي)) {
        إذا (معرفا_نوع_متساويان((*المزارة)[ف], المعرف)) { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    ألحق(*المزارة, المعرف);
    طابق عدد_حقول_سجل(سجل_الأنواع, المعرف) مع
    | اختياري.موجود(عدد_الحقول) -> {
        ف := 0;
        طالما (ف < عدد_الحقول) {
            طابق حقل_سجل_عند(سجل_الأنواع, المعرف, ف) مع
            | اختياري.موجود(الحقل) -> {
                طابق استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الحقل.النوع, المزارة) مع
                | اختياري.موجود(الاستعمال) -> { أرجع اختياري.موجود(الاستعمال); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    طابق عدد_منشئات_نوع(سجل_الأنواع, المعرف) مع
    | اختياري.موجود(عدد_المنشئات) -> {
        ف := 0;
        طالما (ف < عدد_المنشئات) {
            طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, ف) مع
            | اختياري.موجود(المنشئ) -> {
                طابق استعمال_معتم_في_متجه(سجل_الأنواع, &المنشئ.الحمولات, المزارة) مع
                | اختياري.موجود(الاستعمال) -> { أرجع اختياري.موجود(الاستعمال); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عرف استعمال_معتم_في_نوع_داخلي(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    المزارة: &متغير متجه معرف_نوع
): اختياري استعمال_معتم_ممنوع {
    طابق معرف_نوع_موجود_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.بدائي(_) -> { أرجع اختياري.لا_شيء(); }
        | نوع_مقنن.معامل_نوع(_) -> { أرجع اختياري.لا_شيء(); }
        | نوع_مقنن.صف(العناصر) -> { أرجع استعمال_معتم_في_متجه(سجل_الأنواع, &العناصر, المزارة); }
        | نوع_مقنن.صندوق(الداخل) -> { أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الداخل, المزارة); }
        | نوع_مقنن.اختيار(الداخل) -> { أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الداخل, المزارة); }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            طابق استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, أ, المزارة) مع
            | اختياري.موجود(الاستعمال) -> { أرجع اختياري.موجود(الاستعمال); }
            | اختياري.لا_شيء -> { };
            أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, ب, المزارة);
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            طابق استعمال_معتم_في_متجه(سجل_الأنواع, &المعاملات, المزارة) مع
            | اختياري.موجود(الاستعمال) -> { أرجع اختياري.موجود(الاستعمال); }
            | اختياري.لا_شيء -> { };
            أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الناتج, المزارة);
        }
        | نوع_مقنن.مسمى(_, الشكل, الحجج) -> {
            إذا (هل_شكل_نوع_مسمى_معتم(الشكل)) {
                دع الاستعمال: استعمال_معتم_ممنوع = { المعتم: المعرف, حجة_نوع: خطأ };
                أرجع اختياري.موجود(الاستعمال);
            };
            دع بحجة_معتمة: متغير اختياري معرف_نوع = اختياري.لا_شيء();
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                إذا (هل_نوع_معتم(سجل_الأنواع, الحجج[ف])) {
                    بحجة_معتمة := معرف_نوع_أساس_عند(سجل_الأنواع, الحجج[ف]);
                } وإلا {
                    طابق استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الحجج[ف], المزارة) مع
                    | اختياري.موجود(الاستعمال) -> { أرجع اختياري.موجود(الاستعمال); }
                    | اختياري.لا_شيء -> { };
                };
                ف := ف + 1;
            }
            طابق بحجة_معتمة مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المعتم) -> {
                طابق استعمال_معتم_في_أعضاء_مثيل(سجل_الأنواع, المعرف, المزارة) مع
                | اختياري.موجود(الاستعمال) -> {
                    دع الحجة: استعمال_معتم_ممنوع = { المعتم: الاستعمال.المعتم, حجة_نوع: صواب };
                    أرجع اختياري.موجود(الحجة);
                }
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            };
        }
        // The one allowed place: `*T` and `*mutable T`.
        | نوع_مقنن.مؤشر(الداخل) -> {
            إذا (هل_نوع_معتم(سجل_الأنواع, الداخل)) { أرجع اختياري.لا_شيء(); };
            أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الداخل, المزارة);
        }
        | نوع_مقنن.مرجع(الداخل, _) -> { أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الداخل, المزارة); }
        | نوع_مقنن.شريحة(الداخل) -> { أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الداخل, المزارة); }
        | نوع_مقنن.متجه(الداخل) -> { أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الداخل, المزارة); }
        | نوع_مقنن.متغير(الداخل) -> { أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, الداخل, المزارة); };
    };
}

// An opaque type has no value representation: it may appear in a Type only
// directly behind `*` / `*mutable`. Anything else (a value, an element, a
// reference, a function parameter or result) is reported, and so is a generic
// named instance whose members hold an opaque argument by value. Record
// fields of non-generic types are not walked: each field's own written Type
// was checked where the record was declared.
عام عرف استعمال_معتم_ممنوع_في_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري استعمال_معتم_ممنوع {
    دع المزارة: متغير متجه معرف_نوع = [];
    أرجع استعمال_معتم_في_نوع_داخلي(سجل_الأنواع, المعرف, &متغير المزارة);
}

// Whether a Type mentions an opaque type anywhere, behind pointers included.
عام عرف يحوي_نوعا_معتما(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق معرف_نوع_موجود_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.بدائي(_) -> { أرجع خطأ; }
        | نوع_مقنن.معامل_نوع(_) -> { أرجع خطأ; }
        | نوع_مقنن.صف(العناصر) -> { أرجع يحوي_معتما_في_متجه(سجل_الأنواع, &العناصر); }
        | نوع_مقنن.صندوق(الداخل) -> { أرجع يحوي_نوعا_معتما(سجل_الأنواع, الداخل); }
        | نوع_مقنن.اختيار(الداخل) -> { أرجع يحوي_نوعا_معتما(سجل_الأنواع, الداخل); }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            أرجع يحوي_نوعا_معتما(سجل_الأنواع, أ) || يحوي_نوعا_معتما(سجل_الأنواع, ب);
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            أرجع يحوي_معتما_في_متجه(سجل_الأنواع, &المعاملات) || يحوي_نوعا_معتما(سجل_الأنواع, الناتج);
        }
        | نوع_مقنن.مسمى(_, الشكل, الحجج) -> {
            أرجع هل_شكل_نوع_مسمى_معتم(الشكل) || يحوي_معتما_في_متجه(سجل_الأنواع, &الحجج);
        }
        | نوع_مقنن.مؤشر(الداخل) -> { أرجع يحوي_نوعا_معتما(سجل_الأنواع, الداخل); }
        | نوع_مقنن.مرجع(الداخل, _) -> { أرجع يحوي_نوعا_معتما(سجل_الأنواع, الداخل); }
        | نوع_مقنن.شريحة(الداخل) -> { أرجع يحوي_نوعا_معتما(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متجه(الداخل) -> { أرجع يحوي_نوعا_معتما(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متغير(الداخل) -> { أرجع يحوي_نوعا_معتما(سجل_الأنواع, الداخل); };
    };
}

عرف يحوي_معتما_في_متجه(سجل_الأنواع: &سجل_أنواع, الأنواع: &متجه معرف_نوع): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأنواع) مثل طبيعي)) {
        إذا (يحوي_نوعا_معتما(سجل_الأنواع, (*الأنواع)[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The opaque type a raw pointer or reference points at (`*T`, `*mutable T`,
// `&T`), if it points at one.
عام عرف معتم_خلف_مؤشر(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> {
        طابق (*سجل_الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(الداخل) -> {
            إذا (هل_نوع_معتم(سجل_الأنواع, الداخل)) { أرجع معرف_نوع_أساس_عند(سجل_الأنواع, الداخل); };
            أرجع اختياري.لا_شيء();
        }
        | نوع_مقنن.مرجع(الداخل, _) -> {
            إذا (هل_نوع_معتم(سجل_الأنواع, الداخل)) { أرجع معرف_نوع_أساس_عند(سجل_الأنواع, الداخل); };
            أرجع اختياري.لا_شيء();
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// Whether a Type (through `mutable` wrappers) is an opaque named type.
عام عرف هل_نوع_معتم(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*سجل_الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مسمى(_, الشكل, _) -> { أرجع هل_شكل_نوع_مسمى_معتم(الشكل); }
        | _ -> { أرجع خطأ; };
    };
}

// Completes a previously declared named record in place. The empty declaration is
// used only to make recursive semantic Type identity available before member Types
// are resolved; this mutates the canonical binding rather than creating a second registry.
عام عرف أكمل_سجل_نوع_بحقول(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    الحقول: متجه حقل_سجل_دلالي
): منطقي {
    طابق معرف_نوع_مسمى_عند(&(*سجل_الأنواع).المسماة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المعرف) -> {
        دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.سجل(الحقول);
        دع معاملات_النوع: متجه معرف_رمز = انسخ_معاملات_نوع_مسمى(سجل_الأنواع, الرمز);
        دع الربط: ربط_نوع_مسمى = {
            الرمز: الرمز,
            المعرف: المعرف,
            معاملات_النوع: معاملات_النوع,
            التعريف: التعريف
        };
        (*سجل_الأنواع).المسماة[الرمز.القيمة] := اختياري.موجود(الربط);
        أرجع صواب;
    };
}

عام عرف أكمل_تعداد_نوع_بمنشئات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    المنشئات: متجه منشئ_نوع_دلالي
): منطقي {
    طابق معرف_نوع_مسمى_عند(&(*سجل_الأنواع).المسماة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المعرف) -> {
        دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.تعداد(المنشئات);
        دع معاملات_النوع: متجه معرف_رمز = انسخ_معاملات_نوع_مسمى(سجل_الأنواع, الرمز);
        دع الربط: ربط_نوع_مسمى = {
            الرمز: الرمز,
            المعرف: المعرف,
            معاملات_النوع: معاملات_النوع,
            التعريف: التعريف
        };
        (*سجل_الأنواع).المسماة[الرمز.القيمة] := اختياري.موجود(الربط);
        أرجع صواب;
    };
}

عام عرف حل_نوع_مسمى(سجل_الأنواع: &متغير سجل_أنواع, الرمز: معرف_رمز): نتيجة_حل_نوع {
    طابق معرف_نوع_مسمى_عند(&(*سجل_الأنواع).المسماة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_حل_نوع.مفقود(); }
    | اختياري.موجود(المعرف) -> { أرجع نتيجة_حل_نوع.موجود(المعرف); };
}

عام عرف هل_نوع_يحوي_معامل_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): منطقي {
    طابق معرف_نوع_موجود_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.معامل_نوع(_) -> { أرجع صواب; }
        | نوع_مقنن.صف(العناصر) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(العناصر) مثل طبيعي)) {
                إذا (هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, العناصر[ف])) { أرجع صواب; };
                ف := ف + 1;
            }
            أرجع خطأ;
        }
        | نوع_مقنن.صندوق(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.اختيار(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, أ) || هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, ب);
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
                إذا (هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, المعاملات[ف])) { أرجع صواب; };
                ف := ف + 1;
            }
            أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الناتج);
        }
        | نوع_مقنن.مسمى(_, _, الحجج) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                إذا (هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الحجج[ف])) { أرجع صواب; };
                ف := ف + 1;
            }
            أرجع خطأ;
        }
        | نوع_مقنن.مؤشر(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.مرجع(الداخل, _) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.شريحة(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متجه(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متغير(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.بدائي(_) -> { أرجع خطأ; };
    };
}

عرف حجة_استبدال_نوع_عند(
    الاستبدالات: &متجه ربط_استبدال_نوع,
    المعامل: معرف_رمز
): اختياري معرف_نوع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاستبدالات) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*الاستبدالات)[ف].المعامل, المعامل)) {
            أرجع اختياري.موجود((*الاستبدالات)[ف].الحجة);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The Type parameter Symbol of a parameter Type, read in place.
عام عرف رمز_معامل_نوع_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_رمز {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    طابق (*سجل_الأنواع).الأنواع[المعرف.القيمة] مع
    | نوع_مقنن.معامل_نوع(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The TypeID itself when it names a registered Type. Readers then match the
// registry slot in place (Stage0 cannot return references, so accessors hand
// out identities and callers borrow the slot themselves).
عام عرف معرف_نوع_موجود_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(المعرف);
}

عرف استبدل_نوعا_خام(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعرف: معرف_نوع,
    الاستبدالات: &متجه ربط_استبدال_نوع
): معرف_نوع {
    طابق معرف_نوع_موجود_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع المعرف; }
    | اختياري.موجود(النوع) -> {
        // The registry grows below (interning, instantiation): match a copy.
        طابق انسخ_مملوكا_نوع_مقنن(&(*سجل_الأنواع).الأنواع[النوع.القيمة]) مع
        | نوع_مقنن.بدائي(_) -> { أرجع المعرف; }
        | نوع_مقنن.معامل_نوع(الرمز) -> {
            طابق حجة_استبدال_نوع_عند(الاستبدالات, الرمز) مع
            | اختياري.موجود(الحجة) -> { أرجع الحجة; }
            | اختياري.لا_شيء -> { أرجع المعرف; };
        }
        | نوع_مقنن.صف(العناصر) -> {
            دع الجديدة: متغير متجه معرف_نوع = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(العناصر) مثل طبيعي)) {
                ألحق(الجديدة, استبدل_نوعا_خام(سجل_الأنواع, العناصر[ف], الاستبدالات));
                ف := ف + 1;
            }
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.صف(الجديدة));
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.صندوق(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.اختيار(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.اختيار(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.نتيجة(النجاح, الفشل) -> {
            دع أ: معرف_نوع = استبدل_نوعا_خام(سجل_الأنواع, النجاح, الاستبدالات);
            دع ب: معرف_نوع = استبدل_نوعا_خام(سجل_الأنواع, الفشل, الاستبدالات);
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.نتيجة(أ, ب));
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            دع الجديدة: متغير متجه معرف_نوع = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
                ألحق(الجديدة, استبدل_نوعا_خام(سجل_الأنواع, المعاملات[ف], الاستبدالات));
                ف := ف + 1;
            }
            دع الناتج_الجديد: معرف_نوع = استبدل_نوعا_خام(سجل_الأنواع, الناتج, الاستبدالات);
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.دالة(الجديدة, الناتج_الجديد));
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, الحجج) -> {
            دع الجديدة: متغير متجه معرف_نوع = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                ألحق(الجديدة, استبدل_نوعا_خام(سجل_الأنواع, الحجج[ف], الاستبدالات));
                ف := ف + 1;
            }
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.مسمى(الرمز, الشكل, الجديدة));
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.مؤشر(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.مرجع(الداخل, متغير_المرجع) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.مرجع(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات), متغير_المرجع));
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.شريحة(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.متجه(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.متجه(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.متغير(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.متغير(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        };
    };
}

عرف ابن_استبدالات_نوع(
    المعاملات: &متجه معرف_رمز,
    الحجج: &متجه معرف_نوع
): متجه ربط_استبدال_نوع {
    دع الناتج: متغير متجه ربط_استبدال_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعاملات) مثل طبيعي)) {
        دع المعامل: معرف_رمز = (*المعاملات)[ف];
        دع الحجة: معرف_نوع = (*الحجج)[ف];
        دع الربط: ربط_استبدال_نوع = { المعامل: المعامل, الحجة: الحجة };
        ألحق(الناتج, الربط);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف مثيل_نوع_مسمى_موجود(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): منطقي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*سجل_الأنواع).مثيلات_المسماة) مثل طبيعي)) {
        أرجع خطأ;
    };
    طابق (*سجل_الأنواع).مثيلات_المسماة[المعرف.القيمة] مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف ضع_تعريف_مثيل_نوع_مسمى(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعرف: معرف_نوع,
    التعريف: تعريف_نوع_مسمى
): فراغ {
    طالما ((الطول((*سجل_الأنواع).مثيلات_المسماة) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) {
        ألحق((*سجل_الأنواع).مثيلات_المسماة, اختياري.لا_شيء());
    }
    (*سجل_الأنواع).مثيلات_المسماة[المعرف.القيمة] := اختياري.موجود(التعريف);
}

عرف ضمن_مثيلات_نوع_داخل(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعرف: معرف_نوع
): منطقي {
    طابق معرف_نوع_موجود_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(النوع) -> {
        // The registry grows below (interning, instantiation): match a copy.
        طابق انسخ_مملوكا_نوع_مقنن(&(*سجل_الأنواع).الأنواع[النوع.القيمة]) مع
        | نوع_مقنن.بدائي(_) -> { أرجع صواب; }
        | نوع_مقنن.معامل_نوع(_) -> { أرجع صواب; }
        | نوع_مقنن.صف(العناصر) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(العناصر) مثل طبيعي)) {
                إذا (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, العناصر[ف])) { أرجع خطأ; };
                ف := ف + 1;
            }
            أرجع صواب;
        }
        | نوع_مقنن.صندوق(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.اختيار(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, أ)
                && ضمن_مثيلات_نوع_داخل(سجل_الأنواع, ب);
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
                إذا (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, المعاملات[ف])) { أرجع خطأ; };
                ف := ف + 1;
            }
            أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الناتج);
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, الحجج_المستعارة) -> {
            // The registry is mutated below (instantiation): read the view now.
            دع الحجج: متجه معرف_نوع = انسخ_مملوكا_متجه_معرف_نوع(&الحجج_المستعارة);
            طابق عدد_معاملات_نوع_مسمى(سجل_الأنواع, الرمز) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(عدد_المعاملات) -> {
                إذا (عدد_المعاملات == 0) { أرجع صواب; };
                إذا (عدد_المعاملات != (الطول(الحجج) مثل طبيعي)) { أرجع خطأ; };
            };
            إذا (مثيل_نوع_مسمى_موجود(سجل_الأنواع, المعرف)) { أرجع صواب; };
            طابق ربط_نوع_مسمى_عند(سجل_الأنواع, الرمز) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(الربط) -> {

                طابق الربط.التعريف مع
                | تعريف_نوع_مسمى.مرادف -> { أرجع صواب; }
                | تعريف_نوع_مسمى.سجل(_) -> {
                    دع فارغ: متجه حقل_سجل_دلالي = [];
                    ضع_تعريف_مثيل_نوع_مسمى(
                        سجل_الأنواع, المعرف, تعريف_نوع_مسمى.سجل(فارغ)
                    );
                }
                | تعريف_نوع_مسمى.تعداد(_) -> {
                    دع فارغ: متجه منشئ_نوع_دلالي = [];
                    ضع_تعريف_مثيل_نوع_مسمى(
                        سجل_الأنواع, المعرف, تعريف_نوع_مسمى.تعداد(فارغ)
                    );
                }
                // An opaque type has no members to substitute.
                | تعريف_نوع_مسمى.معتم -> {
                    ضع_تعريف_مثيل_نوع_مسمى(سجل_الأنواع, المعرف, تعريف_نوع_مسمى.معتم());
                    أرجع صواب;
                };

                دع الاستبدالات: متجه ربط_استبدال_نوع = ابن_استبدالات_نوع(
                    &الربط.معاملات_النوع, &الحجج
                );
                طابق الربط.التعريف مع
                | تعريف_نوع_مسمى.مرادف -> { أرجع صواب; }
                | تعريف_نوع_مسمى.سجل(حقول_القالب) -> {
                    دع الحقول: متغير متجه حقل_سجل_دلالي = [];
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < (الطول(حقول_القالب) مثل طبيعي)) {
                        دع نوع_الحقل: معرف_نوع = استبدل_نوعا_خام(
                            سجل_الأنواع, حقول_القالب[ف].النوع, &الاستبدالات
                        );
                        إذا (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, نوع_الحقل)) { أرجع خطأ; };
                        دع الحقل: حقل_سجل_دلالي = {
                            الاسم: حقول_القالب[ف].الاسم,
                            النوع: نوع_الحقل
                        };
                        ألحق(الحقول, الحقل);
                        ف := ف + 1;
                    }
                    ضع_تعريف_مثيل_نوع_مسمى(
                        سجل_الأنواع, المعرف, تعريف_نوع_مسمى.سجل(الحقول)
                    );
                    أرجع صواب;
                }
                | تعريف_نوع_مسمى.تعداد(منشئات_القالب) -> {
                    دع المنشئات: متغير متجه منشئ_نوع_دلالي = [];
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < (الطول(منشئات_القالب) مثل طبيعي)) {
                        دع الحمولات: متغير متجه معرف_نوع = [];
                        دع ح: متغير طبيعي = 0;
                        طالما (ح < (الطول(منشئات_القالب[ف].الحمولات) مثل طبيعي)) {
                            دع نوع_الحمولة: معرف_نوع = استبدل_نوعا_خام(
                                سجل_الأنواع, منشئات_القالب[ف].الحمولات[ح], &الاستبدالات
                            );
                            إذا (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, نوع_الحمولة)) { أرجع خطأ; };
                            ألحق(الحمولات, نوع_الحمولة);
                            ح := ح + 1;
                        }
                        دع المنشئ: منشئ_نوع_دلالي = {
                            الهوية: منشئات_القالب[ف].الهوية,
                            الاسم: منشئات_القالب[ف].الاسم,
                            الحمولات: الحمولات
                        };
                        ألحق(المنشئات, المنشئ);
                        ف := ف + 1;
                    }
                    ضع_تعريف_مثيل_نوع_مسمى(
                        سجل_الأنواع, المعرف, تعريف_نوع_مسمى.تعداد(المنشئات)
                    );
                    أرجع صواب;
                }
                | تعريف_نوع_مسمى.معتم -> { أرجع صواب; };
            };
        }
        | نوع_مقنن.مؤشر(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.مرجع(الداخل, _) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.شريحة(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متجه(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متغير(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); };
    };
}

عام عرف استبدل_نوعا(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعرف: معرف_نوع,
    الاستبدالات: &متجه ربط_استبدال_نوع
): معرف_نوع {
    دع الناتج: معرف_نوع = استبدل_نوعا_خام(سجل_الأنواع, المعرف, الاستبدالات);
    ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الناتج);
    أرجع الناتج;
}

عام عرف أعد_بناء_مثيلات_أنواع_مسماة(
    سجل_الأنواع: &متغير سجل_أنواع
): منطقي {
    دع فارغة: متجه اختياري تعريف_نوع_مسمى = [];
    (*سجل_الأنواع).مثيلات_المسماة := فارغة;

    دع ف: متغير طبيعي = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        إذا (ف >= (الطول((*سجل_الأنواع).الأنواع) مثل طبيعي)) {
            مستمر := خطأ;
        } وإلا {
            طابق (*سجل_الأنواع).الأنواع[ف] مع
            | نوع_مقنن.مسمى(_, _, _) -> {
                إذا (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, معرف_نوع_من(ف))) {
                    أرجع خطأ;
                };
            }
            | _ -> { };
            ف := ف + 1;
        };
    }
    أرجع صواب;
}

عام عرف حل_نوع_مسمى_بحجج(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    الحجج: متجه معرف_نوع
): نتيجة_حل_نوع {
    // Non-generic names resolve without touching the template definition.
    طابق عدد_معاملات_نوع_مسمى(سجل_الأنواع, الرمز) مع
    | اختياري.موجود(عدد_المعاملات) -> {
        إذا (عدد_المعاملات == 0) {
            إذا ((الطول(الحجج) مثل طبيعي) != 0) { أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة(); };
            طابق معرف_نوع_مسمى_عند(&(*سجل_الأنواع).المسماة, الرمز) مع
            | اختياري.موجود(المعرف) -> { أرجع نتيجة_حل_نوع.موجود(المعرف); }
            | اختياري.لا_شيء -> { أرجع نتيجة_حل_نوع.مفقود(); };
        };
    }
    | اختياري.لا_شيء -> { };
    طابق ربط_نوع_مسمى_عند(سجل_الأنواع, الرمز) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_حل_نوع.مفقود(); }
    | اختياري.موجود(الربط) -> {
        إذا (الطول(الربط.معاملات_النوع) != الطول(الحجج)) {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        };
        إذا (الطول(الربط.معاملات_النوع) == 0) {
            أرجع نتيجة_حل_نوع.موجود(الربط.المعرف);
        };
        طابق الربط.التعريف مع
        | تعريف_نوع_مسمى.مرادف -> {
            دع الاستبدالات: متجه ربط_استبدال_نوع = ابن_استبدالات_نوع(&الربط.معاملات_النوع, &الحجج);
            أرجع نتيجة_حل_نوع.موجود(استبدل_نوعا(سجل_الأنواع, الربط.المعرف, &الاستبدالات));
        }
        | تعريف_نوع_مسمى.سجل(_) -> {
            دع المعرف: معرف_نوع = قنن_نوعا(
                سجل_الأنواع, نوع_مقنن.مسمى(الرمز, شكل_نوع_مسمى.سجل(), الحجج)
            );
            إذا (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, المعرف)) {
                أرجع نتيجة_حل_نوع.غير_صالح();
            };
            أرجع نتيجة_حل_نوع.موجود(المعرف);
        }
        | تعريف_نوع_مسمى.تعداد(_) -> {
            دع المعرف: معرف_نوع = قنن_نوعا(
                سجل_الأنواع, نوع_مقنن.مسمى(الرمز, شكل_نوع_مسمى.تعداد(), الحجج)
            );
            إذا (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, المعرف)) {
                أرجع نتيجة_حل_نوع.غير_صالح();
            };
            أرجع نتيجة_حل_نوع.موجود(المعرف);
        }
        // Never generic: the zero-parameter path above already answered.
        | تعريف_نوع_مسمى.معتم -> {
            أرجع نتيجة_حل_نوع.موجود(الربط.المعرف);
        };
    };
}

عام عرف عدد_عناصر_صف(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري طبيعي {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.صف(العناصر) -> {
            أرجع اختياري.موجود(الطول(العناصر) مثل طبيعي);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف عنصر_صف_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.صف(العناصر) -> {
            إذا (الفهرس >= (الطول(العناصر) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            أرجع اختياري.موجود(العناصر[الفهرس]);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف معرف_نوع_أساس_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري معرف_نوع {
    دع الحالي: متغير معرف_نوع = المعرف;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق معرف_نوع_موجود_عند(سجل_الأنواع, الحالي) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(مرجع_النوع_1) -> {
            طابق (*سجل_الأنواع).الأنواع[مرجع_النوع_1.القيمة] مع
            | نوع_مقنن.متغير(الداخل) -> { الحالي := الداخل; }
            | _ -> { مستمر := خطأ; };
        };
    }
    أرجع اختياري.موجود(الحالي);
}

// Where the structural definition of a named Type is stored: the template
// slot (by Symbol) or the substituted instance slot (by TypeID). Queries read
// the definition in place through this handle instead of copying it.
نوع موضع_تعريف_بنية =
    | قالب بنوع طبيعي
    | مثيل بنوع طبيعي
;

عرف موضع_تعريف_بنية_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري موضع_تعريف_بنية {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(معرف_الأساس) -> {
        دع الرمز: متغير اختياري معرف_رمز = اختياري.لا_شيء();
        طابق معرف_نوع_موجود_عند(سجل_الأنواع, معرف_الأساس) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(النوع) -> {
            طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
            | نوع_مقنن.مسمى(رمز_النوع, _, _) -> { الرمز := اختياري.موجود(رمز_النوع); }
            | _ -> { };
        };
        طابق الرمز مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(رمز_القالب) -> {
            طابق عدد_معاملات_نوع_مسمى(سجل_الأنواع, رمز_القالب) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(عدد_المعاملات) -> {
                إذا (عدد_المعاملات > 0 && مثيل_نوع_مسمى_موجود(سجل_الأنواع, معرف_الأساس)) {
                    أرجع اختياري.موجود(موضع_تعريف_بنية.مثيل(معرف_الأساس.القيمة));
                };
                أرجع اختياري.موجود(موضع_تعريف_بنية.قالب(رمز_القالب.القيمة));
            };
        };
    };
}

// Facts of one structural definition, computed from a borrowed definition.
نوع حقيقة_تعريف_بنية = {
    سجل: منطقي,
    تعداد: منطقي,
    العدد: طبيعي,
    الحقل: اختياري حقل_سجل_دلالي
};

// Reads one fact of a definition: kind and member count, plus the field at
// الفهرس (or named الاسم when it is present).
عرف حقيقة_من_تعريف_بنية(
    التعريف: &تعريف_نوع_مسمى,
    الفهرس: طبيعي,
    الاسم: اختياري معرف_اسم
): حقيقة_تعريف_بنية {
    طابق *التعريف مع
    | تعريف_نوع_مسمى.سجل(الحقول) -> {
        دع الحقل: متغير اختياري حقل_سجل_دلالي = اختياري.لا_شيء();
        طابق الاسم مع
        | اختياري.موجود(المطلوب) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحقول) مثل طبيعي)) {
                إذا (معرفا_اسم_متساويان(الحقول[ف].الاسم, المطلوب)) {
                    الحقل := اختياري.موجود(الحقول[ف]);
                    ف := الطول(الحقول) مثل طبيعي;
                } وإلا { ف := ف + 1; };
            }
        }
        | اختياري.لا_شيء -> {
            إذا (الفهرس < (الطول(الحقول) مثل طبيعي)) { الحقل := اختياري.موجود(الحقول[الفهرس]); };
        };
        دع الناتج: حقيقة_تعريف_بنية = {
            سجل: صواب, تعداد: خطأ, العدد: الطول(الحقول) مثل طبيعي, الحقل: الحقل
        };
        أرجع الناتج;
    }
    | تعريف_نوع_مسمى.تعداد(المنشئات) -> {
        دع الناتج: حقيقة_تعريف_بنية = {
            سجل: خطأ, تعداد: صواب, العدد: الطول(المنشئات) مثل طبيعي, الحقل: اختياري.لا_شيء()
        };
        أرجع الناتج;
    }
    | تعريف_نوع_مسمى.مرادف -> {
        دع الناتج: حقيقة_تعريف_بنية = {
            سجل: خطأ, تعداد: خطأ, العدد: 0, الحقل: اختياري.لا_شيء()
        };
        أرجع الناتج;
    }
    // Neither a record nor an enum: no fields, no constructors.
    | تعريف_نوع_مسمى.معتم -> {
        دع الناتج: حقيقة_تعريف_بنية = {
            سجل: خطأ, تعداد: خطأ, العدد: 0, الحقل: اختياري.لا_شيء()
        };
        أرجع الناتج;
    };
}

عرف حقيقة_بنية_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي,
    الاسم: اختياري معرف_اسم
): اختياري حقيقة_تعريف_بنية {
    طابق موضع_تعريف_بنية_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الموضع) -> {
        طابق الموضع مع
        | موضع_تعريف_بنية.قالب(الخانة) -> {
            طابق (*سجل_الأنواع).المسماة[الخانة] مع
            | اختياري.موجود(الربط) -> {
                أرجع اختياري.موجود(حقيقة_من_تعريف_بنية(&الربط.التعريف, الفهرس, الاسم));
            }
            | اختياري.لا_شيء -> { };
        }
        | موضع_تعريف_بنية.مثيل(الخانة) -> {
            طابق (*سجل_الأنواع).مثيلات_المسماة[الخانة] مع
            | اختياري.موجود(التعريف) -> {
                أرجع اختياري.موجود(حقيقة_من_تعريف_بنية(&التعريف, الفهرس, الاسم));
            }
            | اختياري.لا_شيء -> { };
        };
    };
    أرجع اختياري.لا_شيء();
}

// An independent copy of enum constructor الفهرس of a borrowed definition.
عرف منشئ_من_تعريف_بنية(التعريف: &تعريف_نوع_مسمى, الفهرس: طبيعي): اختياري منشئ_نوع_دلالي {
    طابق *التعريف مع
    | تعريف_نوع_مسمى.تعداد(المنشئات) -> {
        إذا (الفهرس >= (الطول(المنشئات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(انسخ_مملوكا_منشئ_نوع_دلالي(&المنشئات[الفهرس]));
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف هل_نوع_سجل(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق حقيقة_بنية_عند(سجل_الأنواع, المعرف, 0, اختياري.لا_شيء()) مع
    | اختياري.موجود(الحقيقة) -> { أرجع الحقيقة.سجل; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام عرف عدد_حقول_سجل(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري طبيعي {
    طابق حقيقة_بنية_عند(سجل_الأنواع, المعرف, 0, اختياري.لا_شيء()) مع
    | اختياري.موجود(الحقيقة) -> {
        إذا (الحقيقة.سجل) { أرجع اختياري.موجود(الحقيقة.العدد); };
        أرجع اختياري.لا_شيء();
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف حقل_سجل_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي
): اختياري حقل_سجل_دلالي {
    طابق حقيقة_بنية_عند(سجل_الأنواع, المعرف, الفهرس, اختياري.لا_شيء()) مع
    | اختياري.موجود(الحقيقة) -> { أرجع الحقيقة.الحقل; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف ابحث_حقل_سجل(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختياري حقل_سجل_دلالي {
    طابق حقيقة_بنية_عند(سجل_الأنواع, المعرف, 0, اختياري.موجود(الاسم)) مع
    | اختياري.موجود(الحقيقة) -> { أرجع الحقيقة.الحقل; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف نوع_حقل_سجل(الحقل: &حقل_سجل_دلالي): معرف_نوع {
    دع القيمة: حقل_سجل_دلالي = *الحقل;
    أرجع القيمة.النوع;
}

عرف هويتان_لمنشئ_متساويتان(أ: هوية_منشئ_نوع, ب: هوية_منشئ_نوع): منطقي {
    طابق أ مع
    | هوية_منشئ_نوع.اختيار_لا_شيء -> {
        طابق ب مع
        | هوية_منشئ_نوع.اختيار_لا_شيء -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | هوية_منشئ_نوع.اختيار_بعض -> {
        طابق ب مع
        | هوية_منشئ_نوع.اختيار_بعض -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | هوية_منشئ_نوع.نتيجة_نجاح -> {
        طابق ب مع
        | هوية_منشئ_نوع.نتيجة_نجاح -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | هوية_منشئ_نوع.نتيجة_خطأ -> {
        طابق ب مع
        | هوية_منشئ_نوع.نتيجة_خطأ -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | هوية_منشئ_نوع.تعداد(رمز_أ) -> {
        طابق ب مع
        | هوية_منشئ_نوع.تعداد(رمز_ب) -> {
            أرجع معرفا_رمز_متساويان(رمز_أ, رمز_ب);
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف منشئ_تعداد_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي
): اختياري منشئ_نوع_دلالي {
    طابق موضع_تعريف_بنية_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الموضع) -> {
        طابق الموضع مع
        | موضع_تعريف_بنية.قالب(الخانة) -> {
            طابق (*سجل_الأنواع).المسماة[الخانة] مع
            | اختياري.موجود(الربط) -> { أرجع منشئ_من_تعريف_بنية(&الربط.التعريف, الفهرس); }
            | اختياري.لا_شيء -> { };
        }
        | موضع_تعريف_بنية.مثيل(الخانة) -> {
            طابق (*سجل_الأنواع).مثيلات_المسماة[الخانة] مع
            | اختياري.موجود(التعريف) -> { أرجع منشئ_من_تعريف_بنية(&التعريف, الفهرس); }
            | اختياري.لا_شيء -> { };
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف منشئ_مدمج_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي
): اختياري منشئ_نوع_دلالي {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.اختيار(الداخل) -> {
            دع بلا_اسم: اختياري معرف_اسم = اختياري.لا_شيء();
            إذا (الفهرس == 0) {
                دع الحمولات: متجه معرف_نوع = [];
                دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.اختيار_لا_شيء();
                دع المنشئ: منشئ_نوع_دلالي = {
                    الهوية: الهوية,
                    الاسم: بلا_اسم,
                    الحمولات: الحمولات
                };
                أرجع اختياري.موجود(المنشئ);
            };
            إذا (الفهرس == 1) {
                دع الحمولات: متجه معرف_نوع = [الداخل];
                دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.اختيار_بعض();
                دع المنشئ: منشئ_نوع_دلالي = {
                    الهوية: الهوية,
                    الاسم: بلا_اسم,
                    الحمولات: الحمولات
                };
                أرجع اختياري.موجود(المنشئ);
            };
            أرجع اختياري.لا_شيء();
        }
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            دع بلا_اسم: اختياري معرف_اسم = اختياري.لا_شيء();
            إذا (الفهرس == 0) {
                دع الحمولات: متجه معرف_نوع = [النجاح];
                دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.نتيجة_نجاح();
                دع المنشئ: منشئ_نوع_دلالي = {
                    الهوية: الهوية,
                    الاسم: بلا_اسم,
                    الحمولات: الحمولات
                };
                أرجع اختياري.موجود(المنشئ);
            };
            إذا (الفهرس == 1) {
                دع الحمولات: متجه معرف_نوع = [الخطأ];
                دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.نتيجة_خطأ();
                دع المنشئ: منشئ_نوع_دلالي = {
                    الهوية: الهوية,
                    الاسم: بلا_اسم,
                    الحمولات: الحمولات
                };
                أرجع اختياري.موجود(المنشئ);
            };
            أرجع اختياري.لا_شيء();
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف هل_نوع_موسوم(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.اختيار(الداخل) -> {
            أرجع صواب;
        }
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            أرجع صواب;
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, _) -> {
            طابق الشكل مع
            | شكل_نوع_مسمى.تعداد -> {
                أرجع صواب;
            }
            | شكل_نوع_مسمى.سجل -> {
                أرجع خطأ;
            }
            | شكل_نوع_مسمى.معتم -> {
                أرجع خطأ;
            };
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    };
}

عام عرف عدد_منشئات_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري طبيعي {
    طابق حقيقة_بنية_عند(سجل_الأنواع, المعرف, 0, اختياري.لا_شيء()) مع
    | اختياري.موجود(الحقيقة) -> {
        إذا (الحقيقة.تعداد) { أرجع اختياري.موجود(الحقيقة.العدد); };
    }
    | اختياري.لا_شيء -> { };
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختياري.موجود(النوع) -> {
        طابق (*سجل_الأنواع).الأنواع[النوع.القيمة] مع
        | نوع_مقنن.اختيار(الداخل) -> {
            أرجع اختياري.موجود(2);
        }
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            أرجع اختياري.موجود(2);
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عام عرف منشئ_نوع_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: طبيعي
): اختياري منشئ_نوع_دلالي {
    طابق منشئ_تعداد_عند(سجل_الأنواع, المعرف, الفهرس) مع
    | اختياري.موجود(المنشئ) -> {
        أرجع اختياري.موجود(المنشئ);
    }
    | اختياري.لا_شيء -> {
        أرجع منشئ_مدمج_عند(سجل_الأنواع, المعرف, الفهرس);
    };
}

عام عرف ابحث_منشئ_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري منشئ_نوع_دلالي {
    طابق عدد_منشئات_نوع(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(العدد) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, ف) مع
            | اختياري.موجود(المنشئ) -> {
                إذا (هويتان_لمنشئ_متساويتان(المنشئ.الهوية, الهوية)) {
                    أرجع اختياري.موجود(المنشئ);
                };
            }
            | اختياري.لا_شيء -> {
            };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

عام عرف ترتيب_منشئ_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختياري طبيعي {
    طابق عدد_منشئات_نوع(سجل_الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(العدد) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, ف) مع
            | اختياري.موجود(المنشئ) -> {
                إذا (هويتان_لمنشئ_متساويتان(المنشئ.الهوية, الهوية)) {
                    أرجع اختياري.موجود(ف);
                };
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

عام عرف عدد_حمولات_منشئ(المنشئ: &منشئ_نوع_دلالي): طبيعي {
    دع القيمة: منشئ_نوع_دلالي = *المنشئ;
    أرجع الطول(القيمة.الحمولات) مثل طبيعي;
}

عام عرف حمولة_منشئ_عند(
    المنشئ: &منشئ_نوع_دلالي,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    دع القيمة: منشئ_نوع_دلالي = *المنشئ;
    إذا (الفهرس >= (الطول(القيمة.الحمولات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(القيمة.الحمولات[الفهرس]);
}
