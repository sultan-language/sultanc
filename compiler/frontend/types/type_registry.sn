استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.names.identifiers;

استورد compiler.frontend.types.type_context;

عرف امزج_هاش_نوع(الهاش: غير_موقع, القيمة: غير_موقع): غير_موقع {
    أرجع ((الهاش * 257) + (القيمة % 1048573)) % 1048573;
}

عرف امزج_متجه_معرفات_نوع(الهاش: غير_موقع, القيم: &متجه معرف_نوع): غير_موقع {
    دع v: متجه معرف_نوع = *القيم;
    دع h: متغير غير_موقع = امزج_هاش_نوع(الهاش, الطول(v) مثل غير_موقع);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(v) مثل غير_موقع)) {
        h := امزج_هاش_نوع(h, v[ف].القيمة);
        ف := ف + 1;
    }
    أرجع h;
}

عرف هاش_نوع_مقنن(النوع: &نوع_مقنن): غير_موقع {
    دع القيمة: نوع_مقنن = *النوع;
    طابق القيمة مع
    | نوع_مقنن.بدائي(البدائي) -> {
        دع h: غير_موقع = امزج_هاش_نوع(1, رقم_نوع_بدائي(البدائي));
        أرجع h;
    }
    | نوع_مقنن.صف(العناصر) -> {
        أرجع امزج_متجه_معرفات_نوع(2, &العناصر);
    }
    | نوع_مقنن.صندوق(الداخل) -> { أرجع امزج_هاش_نوع(3, الداخل.القيمة); }
    | نوع_مقنن.اختيار(الداخل) -> { أرجع امزج_هاش_نوع(4, الداخل.القيمة); }
    | نوع_مقنن.نتيجة(النجاح, الفشل) -> {
        دع h: متغير غير_موقع = امزج_هاش_نوع(5, النجاح.القيمة);
        h := امزج_هاش_نوع(h, الفشل.القيمة);
        أرجع h;
    }
    | نوع_مقنن.دالة(المعاملات, الناتج) -> {
        دع h: متغير غير_موقع = امزج_متجه_معرفات_نوع(6, &المعاملات);
        h := امزج_هاش_نوع(h, الناتج.القيمة);
        أرجع h;
    }
    | نوع_مقنن.معامل_نوع(الرمز) -> {
        أرجع امزج_هاش_نوع(7, الرمز.القيمة);
    }
    | نوع_مقنن.مسمى(الرمز, الشكل, الحجج) -> {
        دع h: متغير غير_موقع = امزج_هاش_نوع(8, الرمز.القيمة);
        طابق الشكل مع
        | شكل_نوع_مسمى.سجل -> { h := امزج_هاش_نوع(h, 1); }
        | شكل_نوع_مسمى.تعداد -> { h := امزج_هاش_نوع(h, 2); };
        h := امزج_متجه_معرفات_نوع(h, &الحجج);
        أرجع h;
    }
    | نوع_مقنن.مؤشر(الداخل) -> { أرجع امزج_هاش_نوع(9, الداخل.القيمة); }
    | نوع_مقنن.مرجع(الداخل, متغير_المرجع) -> {
        دع h: متغير غير_موقع = امزج_هاش_نوع(10, الداخل.القيمة);
        لو (متغير_المرجع) { h := امزج_هاش_نوع(h, 1); } وإلا { h := امزج_هاش_نوع(h, 0); };
        أرجع h;
    }
    | نوع_مقنن.شريحة(الداخل) -> { أرجع امزج_هاش_نوع(11, الداخل.القيمة); }
    | نوع_مقنن.متجه(الداخل) -> { أرجع امزج_هاش_نوع(12, الداخل.القيمة); }
    | نوع_مقنن.متغير(الداخل) -> { أرجع امزج_هاش_نوع(13, الداخل.القيمة); };
}

عرف ابن_فهرس_أنواع_فارغا(السعة: غير_موقع): متجه اختيار مدخل_فهرس_نوع {
    دع الناتج: متغير متجه اختيار مدخل_فهرس_نوع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) {
        ألحق(الناتج, اختيار.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أدرج_مدخل_فهرس_نوع(
    الفهرس: &متغير متجه اختيار مدخل_فهرس_نوع,
    المدخل: مدخل_فهرس_نوع
): فراغ {
    دع الحالة: متغير متجه اختيار مدخل_فهرس_نوع = *الفهرس;
    دع السعة: غير_موقع = الطول(الحالة) مثل غير_موقع;
    لو (السعة == 0) { أرجع; };
    دع الموضع: متغير غير_موقع = المدخل.الهاش % السعة;
    بينما (صواب) {
        طابق الحالة[الموضع] مع
        | اختيار.لا_شيء -> {
            الحالة[الموضع] := اختيار.بعض(المدخل);
            *الفهرس := الحالة;
            أرجع;
        }
        | اختيار.بعض(_) -> { الموضع := (الموضع + 1) % السعة; };
    }
}

عرف تأكد_سعة_فهرس_الأنواع(سجل_الأنواع: &متغير سجل_أنواع): فراغ {
    دع الحالة: متغير سجل_أنواع = *سجل_الأنواع;
    دع العدد: غير_موقع = الطول(الحالة.الأنواع) مثل غير_موقع;
    دع القديمة: غير_موقع = الطول(الحالة.فهرس_الأنواع) مثل غير_موقع;
    دع تحتاج: متغير منطقي = القديمة == 0;
    لو (!تحتاج) {
        تحتاج := (العدد * 3) >= (القديمة * 2);
    };
    لو (!تحتاج) { أرجع; };
    دع الجديدة: متغير غير_موقع = 32;
    لو (القديمة > 0) { الجديدة := القديمة * 2; };
    دع الفهرس_الجديد: متغير متجه اختيار مدخل_فهرس_نوع = ابن_فهرس_أنواع_فارغا(الجديدة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < القديمة) {
        طابق الحالة.فهرس_الأنواع[ف] مع
        | اختيار.بعض(المدخل) -> { أدرج_مدخل_فهرس_نوع(&متغير الفهرس_الجديد, المدخل); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    الحالة.فهرس_الأنواع := الفهرس_الجديد;
    *سجل_الأنواع := الحالة;
}
عام عرف سجل_أنواع_جديد(): سجل_أنواع {
    // Primitive Type identity is fixed by builtins_generated.sn. Seed those canonical
    // identities once so primitive use never re-interns by scanning the registry.
    دع الأنواع: متغير متجه نوع_مقنن = [];
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.أي()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.منطقي()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.نص()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.حرف()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.عدد()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.غير_موقع()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.فراغ()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص8()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص16()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص32()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص64()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.غ8()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.غ16()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.غ32()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.غ64()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ع32()));
    ألحق(الأنواع, نوع_مقنن.بدائي(نوع_بدائي_مقنن.ع64()));
    دع المسماة: متجه اختيار ربط_نوع_مسمى = [];
    دع مثيلات_المسماة: متجه اختيار تعريف_نوع_مسمى = [];
    دع معاملات_النوع: متجه اختيار معرف_نوع = [];
    دع فهرس_الأنواع: متغير متجه اختيار مدخل_فهرس_نوع = ابن_فهرس_أنواع_فارغا(32);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأنواع) مثل غير_موقع)) {
        دع المعرف: معرف_نوع = معرف_نوع_من(ف);
        دع الهاش: غير_موقع = هاش_نوع_مقنن(&الأنواع[ف]);
        دع المدخل: مدخل_فهرس_نوع = { الهاش: الهاش, المعرف: المعرف };
        أدرج_مدخل_فهرس_نوع(&متغير فهرس_الأنواع, المدخل);
        ف := ف + 1;
    }
    دع سجل_الأنواع: سجل_أنواع = {
        الأنواع: الأنواع,
        فهرس_الأنواع: فهرس_الأنواع,
        المسماة: المسماة,
        مثيلات_المسماة: مثيلات_المسماة,
        معاملات_النوع: معاملات_النوع
    };
    أرجع سجل_الأنواع;
}

عرف متجه_معرفات_متساو(أ: &متجه معرف_نوع, ب: &متجه معرف_نوع): منطقي {
    دع اليسار: متجه معرف_نوع = *أ;
    دع اليمين: متجه معرف_نوع = *ب;
    لو (الطول(اليسار) != الطول(اليمين)) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(اليسار) مثل غير_موقع)) {
        لو (!معرفا_نوع_متساويان(اليسار[ف], اليمين[ف])) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف شكلان_مسميان_متساويان(أ: شكل_نوع_مسمى, ب: شكل_نوع_مسمى): منطقي {
    طابق أ مع
    | شكل_نوع_مسمى.سجل -> {
        طابق ب مع
        | شكل_نوع_مسمى.سجل -> {
            أرجع صواب;
        }
        | شكل_نوع_مسمى.تعداد -> {
            أرجع خطأ;
        };
    }
    | شكل_نوع_مسمى.تعداد -> {
        طابق ب مع
        | شكل_نوع_مسمى.تعداد -> {
            أرجع صواب;
        }
        | شكل_نوع_مسمى.سجل -> {
            أرجع خطأ;
        };
    };
}

عرف نوعان_متساويان(أ: &نوع_مقنن, ب: &نوع_مقنن): منطقي {
    دع اليسار: نوع_مقنن = *أ;
    دع اليمين: نوع_مقنن = *ب;
    طابق اليسار مع
    | نوع_مقنن.بدائي(أ_نوع) -> {
        طابق اليمين مع
        | نوع_مقنن.بدائي(ب_نوع) -> {
            أرجع رقم_نوع_بدائي(أ_نوع) == رقم_نوع_بدائي(ب_نوع);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.صف(أ_عناصر) -> {
        طابق اليمين مع
        | نوع_مقنن.صف(ب_عناصر) -> {
            أرجع متجه_معرفات_متساو(&أ_عناصر, &ب_عناصر);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.صندوق(أ_داخل) -> {
        طابق اليمين مع
        | نوع_مقنن.صندوق(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.اختيار(أ_داخل) -> {
        طابق اليمين مع
        | نوع_مقنن.اختيار(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.نتيجة(أ_نجاح, أ_فشل) -> {
        طابق اليمين مع
        | نوع_مقنن.نتيجة(ب_نجاح, ب_فشل) -> {
            أرجع معرفا_نوع_متساويان(أ_نجاح, ب_نجاح) && معرفا_نوع_متساويان(أ_فشل, ب_فشل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.دالة(أ_معاملات, أ_ناتج) -> {
        طابق اليمين مع
        | نوع_مقنن.دالة(ب_معاملات, ب_ناتج) -> {
            أرجع متجه_معرفات_متساو(&أ_معاملات, &ب_معاملات)
                && معرفا_نوع_متساويان(أ_ناتج, ب_ناتج);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.معامل_نوع(أ_رمز) -> {
        طابق اليمين مع
        | نوع_مقنن.معامل_نوع(ب_رمز) -> {
            أرجع معرفا_رمز_متساويان(أ_رمز, ب_رمز);
        }
        | _ -> { أرجع خطأ; };
    }
    | نوع_مقنن.مسمى(أ_رمز, أ_شكل, أ_حجج) -> {
        طابق اليمين مع
        | نوع_مقنن.مسمى(ب_رمز, ب_شكل, ب_حجج) -> {
            أرجع معرفا_رمز_متساويان(أ_رمز, ب_رمز)
                && شكلان_مسميان_متساويان(أ_شكل, ب_شكل)
                && متجه_معرفات_متساو(&أ_حجج, &ب_حجج);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.مؤشر(أ_داخل) -> {
        طابق اليمين مع
        | نوع_مقنن.مؤشر(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.مرجع(أ_داخل, أ_متغير) -> {
        طابق اليمين مع
        | نوع_مقنن.مرجع(ب_داخل, ب_متغير) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل) && (أ_متغير == ب_متغير);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.شريحة(أ_داخل) -> {
        طابق اليمين مع
        | نوع_مقنن.شريحة(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.متجه(أ_داخل) -> {
        طابق اليمين مع
        | نوع_مقنن.متجه(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | نوع_مقنن.متغير(أ_داخل) -> {
        طابق اليمين مع
        | نوع_مقنن.متغير(ب_داخل) -> {
            أرجع معرفا_نوع_متساويان(أ_داخل, ب_داخل);
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف ابحث_عن_نوع_مقنن(
    سجل_الأنواع: &سجل_أنواع,
    النوع: &نوع_مقنن,
    الهاش: غير_موقع
): اختيار معرف_نوع {
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    دع السعة: غير_موقع = الطول(الحالة.فهرس_الأنواع) مثل غير_موقع;
    لو (السعة == 0) { أرجع اختيار.لا_شيء(); };
    دع الموضع: متغير غير_موقع = الهاش % السعة;
    دع المفحوص: متغير غير_موقع = 0;
    بينما (المفحوص < السعة) {
        طابق الحالة.فهرس_الأنواع[الموضع] مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المدخل) -> {
            لو (المدخل.الهاش == الهاش
                && المدخل.المعرف.القيمة < (الطول(الحالة.الأنواع) مثل غير_موقع)
                && نوعان_متساويان(&الحالة.الأنواع[المدخل.المعرف.القيمة], النوع)) {
                أرجع اختيار.بعض(المدخل.المعرف);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف قنن_نوعا(سجل_الأنواع: &متغير سجل_أنواع, النوع: نوع_مقنن): معرف_نوع {
    دع الهاش: غير_موقع = هاش_نوع_مقنن(&النوع);
    طابق ابحث_عن_نوع_مقنن(سجل_الأنواع, &النوع, الهاش) مع
    | اختيار.بعض(المعرف) -> { أرجع المعرف; }
    | اختيار.لا_شيء -> { };

    دع الحالة: متغير سجل_أنواع = *سجل_الأنواع;
    دع المعرف: معرف_نوع = معرف_نوع_من(الطول(الحالة.الأنواع) مثل غير_موقع);
    ألحق(الحالة.الأنواع, النوع);
    *سجل_الأنواع := الحالة;
    تأكد_سعة_فهرس_الأنواع(سجل_الأنواع);
    دع محدثة: متغير سجل_أنواع = *سجل_الأنواع;
    دع المدخل: مدخل_فهرس_نوع = { الهاش: الهاش, المعرف: المعرف };
    أدرج_مدخل_فهرس_نوع(&متغير محدثة.فهرس_الأنواع, المدخل);
    *سجل_الأنواع := محدثة;
    أرجع المعرف;
}

عام عرف قنن_نوعا_بدائيا(
    سجل_الأنواع: &متغير سجل_أنواع,
    النوع: نوع_بدائي_مقنن
): معرف_نوع {
    // سجل_أنواع_جديد seeds primitives in the generated canonical ordinal order.
    أرجع معرف_نوع_من(رقم_نوع_بدائي(النوع));
}

عام عرف معرف_نوع_صالح(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    أرجع المعرف.القيمة < (الطول(الحالة.الأنواع) مثل غير_موقع);
}

عام عرف سجل_معامل_نوع(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز
): معرف_نوع {
    دع الحالة_الأولى: سجل_أنواع = *سجل_الأنواع;
    لو (الرمز.القيمة < (الطول(الحالة_الأولى.معاملات_النوع) مثل غير_موقع)) {
        طابق الحالة_الأولى.معاملات_النوع[الرمز.القيمة] مع
        | اختيار.بعض(المعرف) -> { أرجع المعرف; }
        | اختيار.لا_شيء -> { };
    };
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, نوع_مقنن.معامل_نوع(الرمز));
    دع الحالة: متغير سجل_أنواع = *سجل_الأنواع;
    بينما ((الطول(الحالة.معاملات_النوع) مثل غير_موقع) <= الرمز.القيمة) {
        ألحق(الحالة.معاملات_النوع, اختيار.لا_شيء());
    }
    الحالة.معاملات_النوع[الرمز.القيمة] := اختيار.بعض(المعرف);
    *سجل_الأنواع := الحالة;
    أرجع المعرف;
}

عام عرف نوع_معامل_مسجل_عند(
    سجل_الأنواع: &سجل_أنواع,
    الرمز: معرف_رمز
): اختيار معرف_نوع {
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    لو (الرمز.القيمة >= (الطول(الحالة.معاملات_النوع) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع الحالة.معاملات_النوع[الرمز.القيمة];
}

عام عرف معرف_نوع_مسمى_عند(
    المسماة: &متجه اختيار ربط_نوع_مسمى,
    الرمز: معرف_رمز
): اختيار معرف_نوع {
    دع الحالة: متجه اختيار ربط_نوع_مسمى = *المسماة;
    لو (الرمز.القيمة >= (الطول(الحالة) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الخانة: &اختيار ربط_نوع_مسمى = &الحالة[الرمز.القيمة];
    طابق *مرجع_الخانة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الربط) -> { أرجع اختيار.بعض(الربط.المعرف); };
}

عام عرف ربط_نوع_مسمى_عند(
    سجل_الأنواع: &سجل_أنواع,
    الرمز: معرف_رمز
): اختيار ربط_نوع_مسمى {
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    لو (الرمز.القيمة >= (الطول(الحالة.المسماة) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الخانة: &اختيار ربط_نوع_مسمى = &الحالة.المسماة[الرمز.القيمة];
    أرجع *مرجع_الخانة;
}

عرف انسخ_معاملات_نوع_مسمى(
    سجل_الأنواع: &سجل_أنواع,
    الرمز: معرف_رمز
): متجه معرف_رمز {
    دع الناتج: متغير متجه معرف_رمز = [];
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    لو (الرمز.القيمة >= (الطول(الحالة.المسماة) مثل غير_موقع)) { أرجع الناتج; };
    دع مرجع_الخانة: &اختيار ربط_نوع_مسمى = &الحالة.المسماة[الرمز.القيمة];
    طابق *مرجع_الخانة مع
    | اختيار.بعض(الربط) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الربط.معاملات_النوع) مثل غير_موقع)) {
            ألحق(الناتج, الربط.معاملات_النوع[ف]);
            ف := ف + 1;
        }
    }
    | اختيار.لا_شيء -> { };
    أرجع الناتج;
}

عرف أضف_ربط_نوع_مسمى(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    المعرف: معرف_نوع,
    معاملات_النوع: متجه معرف_رمز,
    التعريف: تعريف_نوع_مسمى
): منطقي {
    دع الحالة: متغير سجل_أنواع = *سجل_الأنواع;
    بينما ((الطول(الحالة.المسماة) مثل غير_موقع) <= الرمز.القيمة) {
        ألحق(الحالة.المسماة, اختيار.لا_شيء());
    }
    طابق معرف_نوع_مسمى_عند(&الحالة.المسماة, الرمز) مع
    | اختيار.بعض(_) -> { أرجع خطأ; }
    | اختيار.لا_شيء -> { };
    دع الربط: ربط_نوع_مسمى = {
        الرمز: الرمز,
        المعرف: المعرف,
        معاملات_النوع: معاملات_النوع,
        التعريف: التعريف
    };
    الحالة.المسماة[الرمز.القيمة] := اختيار.بعض(الربط);
    *سجل_الأنواع := الحالة;
    أرجع صواب;
}

عام عرف أضف_مرادف_نوع(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    الهدف: معرف_نوع
): منطقي {
    لو (!معرف_نوع_صالح(سجل_الأنواع, الهدف)) {
        أرجع خطأ;
    };
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.مرادف();
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, الهدف, معاملات_النوع, التعريف);
}

عرف معرفات_معاملات_نوع(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعاملات: &متجه معرف_رمز
): متجه معرف_نوع {
    دع القيم: متجه معرف_رمز = *المعاملات;
    دع الناتج: متغير متجه معرف_نوع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        ألحق(الناتج, سجل_معامل_نوع(سجل_الأنواع, القيم[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أضف_مرادف_نوع_بمعاملات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    معاملات_النوع: متجه معرف_رمز,
    الهدف: معرف_نوع
): منطقي {
    لو (!معرف_نوع_صالح(سجل_الأنواع, الهدف)) { أرجع خطأ; };
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.مرادف();
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, الهدف, معاملات_النوع, التعريف);
}

عام عرف أضف_سجل_نوع_بمعاملات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    معاملات_النوع: متجه معرف_رمز
): منطقي {
    دع حجج_القالب: متجه معرف_نوع = معرفات_معاملات_نوع(سجل_الأنواع, &معاملات_النوع);
    دع النوع: نوع_مقنن = نوع_مقنن.مسمى(الرمز, شكل_نوع_مسمى.سجل(), حجج_القالب);
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, النوع);
    دع الحقول: متجه حقل_سجل_دلالي = [];
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.سجل(الحقول);
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, المعرف, معاملات_النوع, التعريف);
}

عام عرف أضف_تعداد_نوع_بمعاملات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    معاملات_النوع: متجه معرف_رمز
): منطقي {
    دع حجج_القالب: متجه معرف_نوع = معرفات_معاملات_نوع(سجل_الأنواع, &معاملات_النوع);
    دع النوع: نوع_مقنن = نوع_مقنن.مسمى(الرمز, شكل_نوع_مسمى.تعداد(), حجج_القالب);
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, النوع);
    دع المنشئات: متجه منشئ_نوع_دلالي = [];
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.تعداد(المنشئات);
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, المعرف, معاملات_النوع, التعريف);
}

عام عرف أضف_سجل_نوع_بحقول(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    الحقول: متجه حقل_سجل_دلالي
): منطقي {
    دع الشكل: شكل_نوع_مسمى = شكل_نوع_مسمى.سجل();
    دع الحجج: متجه معرف_نوع = [];
    دع النوع: نوع_مقنن = نوع_مقنن.مسمى(الرمز, الشكل, الحجج);
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, النوع);
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.سجل(الحقول);
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, المعرف, معاملات_النوع, التعريف);
}

عام عرف أضف_سجل_نوع(سجل_الأنواع: &متغير سجل_أنواع, الرمز: معرف_رمز): منطقي {
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_سجل_نوع_بمعاملات(سجل_الأنواع, الرمز, معاملات_النوع);
}

عام عرف أضف_تعداد_نوع_بمنشئات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    المنشئات: متجه منشئ_نوع_دلالي
): منطقي {
    دع الشكل: شكل_نوع_مسمى = شكل_نوع_مسمى.تعداد();
    دع الحجج: متجه معرف_نوع = [];
    دع النوع: نوع_مقنن = نوع_مقنن.مسمى(الرمز, الشكل, الحجج);
    دع المعرف: معرف_نوع = قنن_نوعا(سجل_الأنواع, النوع);
    دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.تعداد(المنشئات);
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_ربط_نوع_مسمى(سجل_الأنواع, الرمز, المعرف, معاملات_النوع, التعريف);
}

عام عرف أضف_تعداد_نوع(سجل_الأنواع: &متغير سجل_أنواع, الرمز: معرف_رمز): منطقي {
    دع معاملات_النوع: متجه معرف_رمز = [];
    أرجع أضف_تعداد_نوع_بمعاملات(سجل_الأنواع, الرمز, معاملات_النوع);
}

// Completes a previously declared named record in place. The empty declaration is
// used only to make recursive semantic Type identity available before member Types
// are resolved; this mutates the canonical binding rather than creating a second registry.
عام عرف أكمل_سجل_نوع_بحقول(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    الحقول: متجه حقل_سجل_دلالي
): منطقي {
    دع الحالة: متغير سجل_أنواع = *سجل_الأنواع;
    طابق معرف_نوع_مسمى_عند(&الحالة.المسماة, الرمز) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المعرف) -> {
        دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.سجل(الحقول);
        دع معاملات_النوع: متجه معرف_رمز = انسخ_معاملات_نوع_مسمى(&الحالة, الرمز);
        دع الربط: ربط_نوع_مسمى = {
            الرمز: الرمز,
            المعرف: المعرف,
            معاملات_النوع: معاملات_النوع,
            التعريف: التعريف
        };
        الحالة.المسماة[الرمز.القيمة] := اختيار.بعض(الربط);
        *سجل_الأنواع := الحالة;
        أرجع صواب;
    };
}

عام عرف أكمل_تعداد_نوع_بمنشئات(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    المنشئات: متجه منشئ_نوع_دلالي
): منطقي {
    دع الحالة: متغير سجل_أنواع = *سجل_الأنواع;
    طابق معرف_نوع_مسمى_عند(&الحالة.المسماة, الرمز) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المعرف) -> {
        دع التعريف: تعريف_نوع_مسمى = تعريف_نوع_مسمى.تعداد(المنشئات);
        دع معاملات_النوع: متجه معرف_رمز = انسخ_معاملات_نوع_مسمى(&الحالة, الرمز);
        دع الربط: ربط_نوع_مسمى = {
            الرمز: الرمز,
            المعرف: المعرف,
            معاملات_النوع: معاملات_النوع,
            التعريف: التعريف
        };
        الحالة.المسماة[الرمز.القيمة] := اختيار.بعض(الربط);
        *سجل_الأنواع := الحالة;
        أرجع صواب;
    };
}

عام عرف حل_نوع_مسمى(سجل_الأنواع: &متغير سجل_أنواع, الرمز: معرف_رمز): نتيجة_حل_نوع {
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    طابق معرف_نوع_مسمى_عند(&الحالة.المسماة, الرمز) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_حل_نوع.مفقود(); }
    | اختيار.بعض(المعرف) -> { أرجع نتيجة_حل_نوع.موجود(المعرف); };
}

عام عرف هل_نوع_يحوي_معامل_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): منطقي {
    طابق نوع_مقنن_خام_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.معامل_نوع(_) -> { أرجع صواب; }
        | نوع_مقنن.صف(العناصر) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
                لو (هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, العناصر[ف])) { أرجع صواب; };
                ف := ف + 1;
            }
            أرجع خطأ;
        }
        | نوع_مقنن.صندوق(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.اختيار(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, أ) || هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, ب);
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(المعاملات) مثل غير_موقع)) {
                لو (هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, المعاملات[ف])) { أرجع صواب; };
                ف := ف + 1;
            }
            أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الناتج);
        }
        | نوع_مقنن.مسمى(_, _, الحجج) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
                لو (هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الحجج[ف])) { أرجع صواب; };
                ف := ف + 1;
            }
            أرجع خطأ;
        }
        | نوع_مقنن.مؤشر(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.مرجع(الداخل, _) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.شريحة(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متجه(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متغير(الداخل) -> { أرجع هل_نوع_يحوي_معامل_نوع(سجل_الأنواع, الداخل); }
        | نوع_مقنن.بدائي(_) -> { أرجع خطأ; };
    };
}

عرف حجة_استبدال_نوع_عند(
    الاستبدالات: &متجه ربط_استبدال_نوع,
    المعامل: معرف_رمز
): اختيار معرف_نوع {
    دع القيم: متجه ربط_استبدال_نوع = *الاستبدالات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (معرفا_رمز_متساويان(القيم[ف].المعامل, المعامل)) {
            أرجع اختيار.بعض(القيم[ف].الحجة);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف نوع_مقنن_خام_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار نوع_مقنن {
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    لو (المعرف.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع المرجع: &نوع_مقنن = &الحالة.الأنواع[المعرف.القيمة];
    أرجع اختيار.بعض(*المرجع);
}

عرف استبدل_نوعا_خام(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعرف: معرف_نوع,
    الاستبدالات: &متجه ربط_استبدال_نوع
): معرف_نوع {
    طابق نوع_مقنن_خام_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> { أرجع المعرف; }
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.بدائي(_) -> { أرجع المعرف; }
        | نوع_مقنن.معامل_نوع(الرمز) -> {
            طابق حجة_استبدال_نوع_عند(الاستبدالات, الرمز) مع
            | اختيار.بعض(الحجة) -> { أرجع الحجة; }
            | اختيار.لا_شيء -> { أرجع المعرف; };
        }
        | نوع_مقنن.صف(العناصر) -> {
            دع الجديدة: متغير متجه معرف_نوع = [];
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
                ألحق(الجديدة, استبدل_نوعا_خام(سجل_الأنواع, العناصر[ف], الاستبدالات));
                ف := ف + 1;
            }
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.صف(الجديدة));
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.صندوق(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.اختيار(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.اختيار(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.نتيجة(النجاح, الفشل) -> {
            دع أ: معرف_نوع = استبدل_نوعا_خام(سجل_الأنواع, النجاح, الاستبدالات);
            دع ب: معرف_نوع = استبدل_نوعا_خام(سجل_الأنواع, الفشل, الاستبدالات);
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.نتيجة(أ, ب));
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            دع الجديدة: متغير متجه معرف_نوع = [];
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(المعاملات) مثل غير_موقع)) {
                ألحق(الجديدة, استبدل_نوعا_خام(سجل_الأنواع, المعاملات[ف], الاستبدالات));
                ف := ف + 1;
            }
            دع الناتج_الجديد: معرف_نوع = استبدل_نوعا_خام(سجل_الأنواع, الناتج, الاستبدالات);
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.دالة(الجديدة, الناتج_الجديد));
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, الحجج) -> {
            دع الجديدة: متغير متجه معرف_نوع = [];
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
                ألحق(الجديدة, استبدل_نوعا_خام(سجل_الأنواع, الحجج[ف], الاستبدالات));
                ف := ف + 1;
            }
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.مسمى(الرمز, الشكل, الجديدة));
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.مؤشر(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.مرجع(الداخل, متغير_المرجع) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.مرجع(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات), متغير_المرجع));
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.شريحة(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.متجه(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.متجه(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        }
        | نوع_مقنن.متغير(الداخل) -> {
            أرجع قنن_نوعا(سجل_الأنواع, نوع_مقنن.متغير(استبدل_نوعا_خام(سجل_الأنواع, الداخل, الاستبدالات)));
        };
    };
}

عرف ابن_استبدالات_نوع(
    المعاملات: &متجه معرف_رمز,
    الحجج: &متجه معرف_نوع
): متجه ربط_استبدال_نوع {
    دع م: متجه معرف_رمز = *المعاملات;
    دع ح: متجه معرف_نوع = *الحجج;
    دع الناتج: متغير متجه ربط_استبدال_نوع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(م) مثل غير_موقع)) {
        دع الربط: ربط_استبدال_نوع = { المعامل: م[ف], الحجة: ح[ف] };
        ألحق(الناتج, الربط);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف تعريف_مثيل_نوع_مسمى_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار تعريف_نوع_مسمى {
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    لو (المعرف.القيمة >= (الطول(الحالة.مثيلات_المسماة) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الخانة: &اختيار تعريف_نوع_مسمى = &الحالة.مثيلات_المسماة[المعرف.القيمة];
    أرجع *مرجع_الخانة;
}

عرف ضع_تعريف_مثيل_نوع_مسمى(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعرف: معرف_نوع,
    التعريف: تعريف_نوع_مسمى
): فراغ {
    دع الحالة: متغير سجل_أنواع = *سجل_الأنواع;
    بينما ((الطول(الحالة.مثيلات_المسماة) مثل غير_موقع) <= المعرف.القيمة) {
        ألحق(الحالة.مثيلات_المسماة, اختيار.لا_شيء());
    }
    الحالة.مثيلات_المسماة[المعرف.القيمة] := اختيار.بعض(التعريف);
    *سجل_الأنواع := الحالة;
}

عرف ضمن_مثيلات_نوع_داخل(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعرف: معرف_نوع
): منطقي {
    طابق نوع_مقنن_خام_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.بدائي(_) -> { أرجع صواب; }
        | نوع_مقنن.معامل_نوع(_) -> { أرجع صواب; }
        | نوع_مقنن.صف(العناصر) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
                لو (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, العناصر[ف])) { أرجع خطأ; };
                ف := ف + 1;
            }
            أرجع صواب;
        }
        | نوع_مقنن.صندوق(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.اختيار(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, أ)
                && ضمن_مثيلات_نوع_داخل(سجل_الأنواع, ب);
        }
        | نوع_مقنن.دالة(المعاملات, الناتج) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(المعاملات) مثل غير_موقع)) {
                لو (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, المعاملات[ف])) { أرجع خطأ; };
                ف := ف + 1;
            }
            أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الناتج);
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, الحجج) -> {
            طابق ربط_نوع_مسمى_عند(سجل_الأنواع, الرمز) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(الربط) -> {
                لو (الطول(الربط.معاملات_النوع) == 0) { أرجع صواب; };
                لو (الطول(الربط.معاملات_النوع) != الطول(الحجج)) { أرجع خطأ; };
                طابق تعريف_مثيل_نوع_مسمى_عند(سجل_الأنواع, المعرف) مع
                | اختيار.بعض(_) -> { أرجع صواب; }
                | اختيار.لا_شيء -> { };

                طابق الربط.التعريف مع
                | تعريف_نوع_مسمى.مرادف -> { أرجع صواب; }
                | تعريف_نوع_مسمى.سجل(_) -> {
                    دع فارغ: متجه حقل_سجل_دلالي = [];
                    ضع_تعريف_مثيل_نوع_مسمى(
                        سجل_الأنواع, المعرف, تعريف_نوع_مسمى.سجل(فارغ)
                    );
                }
                | تعريف_نوع_مسمى.تعداد(_) -> {
                    دع فارغ: متجه منشئ_نوع_دلالي = [];
                    ضع_تعريف_مثيل_نوع_مسمى(
                        سجل_الأنواع, المعرف, تعريف_نوع_مسمى.تعداد(فارغ)
                    );
                };

                دع الاستبدالات: متجه ربط_استبدال_نوع = ابن_استبدالات_نوع(
                    &الربط.معاملات_النوع, &الحجج
                );
                طابق الربط.التعريف مع
                | تعريف_نوع_مسمى.مرادف -> { أرجع صواب; }
                | تعريف_نوع_مسمى.سجل(حقول_القالب) -> {
                    دع الحقول: متغير متجه حقل_سجل_دلالي = [];
                    دع ف: متغير غير_موقع = 0;
                    بينما (ف < (الطول(حقول_القالب) مثل غير_موقع)) {
                        دع نوع_الحقل: معرف_نوع = استبدل_نوعا_خام(
                            سجل_الأنواع, حقول_القالب[ف].النوع, &الاستبدالات
                        );
                        لو (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, نوع_الحقل)) { أرجع خطأ; };
                        دع الحقل: حقل_سجل_دلالي = {
                            الاسم: حقول_القالب[ف].الاسم,
                            النوع: نوع_الحقل
                        };
                        ألحق(الحقول, الحقل);
                        ف := ف + 1;
                    }
                    ضع_تعريف_مثيل_نوع_مسمى(
                        سجل_الأنواع, المعرف, تعريف_نوع_مسمى.سجل(الحقول)
                    );
                    أرجع صواب;
                }
                | تعريف_نوع_مسمى.تعداد(منشئات_القالب) -> {
                    دع المنشئات: متغير متجه منشئ_نوع_دلالي = [];
                    دع ف: متغير غير_موقع = 0;
                    بينما (ف < (الطول(منشئات_القالب) مثل غير_موقع)) {
                        دع الحمولات: متغير متجه معرف_نوع = [];
                        دع ح: متغير غير_موقع = 0;
                        بينما (ح < (الطول(منشئات_القالب[ف].الحمولات) مثل غير_موقع)) {
                            دع نوع_الحمولة: معرف_نوع = استبدل_نوعا_خام(
                                سجل_الأنواع, منشئات_القالب[ف].الحمولات[ح], &الاستبدالات
                            );
                            لو (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, نوع_الحمولة)) { أرجع خطأ; };
                            ألحق(الحمولات, نوع_الحمولة);
                            ح := ح + 1;
                        }
                        دع المنشئ: منشئ_نوع_دلالي = {
                            الهوية: منشئات_القالب[ف].الهوية,
                            الاسم: منشئات_القالب[ف].الاسم,
                            الحمولات: الحمولات
                        };
                        ألحق(المنشئات, المنشئ);
                        ف := ف + 1;
                    }
                    ضع_تعريف_مثيل_نوع_مسمى(
                        سجل_الأنواع, المعرف, تعريف_نوع_مسمى.تعداد(المنشئات)
                    );
                    أرجع صواب;
                };
            };
        }
        | نوع_مقنن.مؤشر(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.مرجع(الداخل, _) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.شريحة(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متجه(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); }
        | نوع_مقنن.متغير(الداخل) -> { أرجع ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الداخل); };
    };
}

عام عرف استبدل_نوعا(
    سجل_الأنواع: &متغير سجل_أنواع,
    المعرف: معرف_نوع,
    الاستبدالات: &متجه ربط_استبدال_نوع
): معرف_نوع {
    دع الناتج: معرف_نوع = استبدل_نوعا_خام(سجل_الأنواع, المعرف, الاستبدالات);
    ضمن_مثيلات_نوع_داخل(سجل_الأنواع, الناتج);
    أرجع الناتج;
}

عام عرف أعد_بناء_مثيلات_أنواع_مسماة(
    سجل_الأنواع: &متغير سجل_أنواع
): منطقي {
    دع الحالة_الأولى: متغير سجل_أنواع = *سجل_الأنواع;
    دع فارغة: متجه اختيار تعريف_نوع_مسمى = [];
    الحالة_الأولى.مثيلات_المسماة := فارغة;
    *سجل_الأنواع := الحالة_الأولى;

    دع ف: متغير غير_موقع = 0;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع الحالة: سجل_أنواع = *سجل_الأنواع;
        لو (ف >= (الطول(الحالة.الأنواع) مثل غير_موقع)) {
            مستمر := خطأ;
        } وإلا {
            طابق الحالة.الأنواع[ف] مع
            | نوع_مقنن.مسمى(_, _, _) -> {
                لو (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, معرف_نوع_من(ف))) {
                    أرجع خطأ;
                };
            }
            | _ -> { };
            ف := ف + 1;
        };
    }
    أرجع صواب;
}

عام عرف حل_نوع_مسمى_بحجج(
    سجل_الأنواع: &متغير سجل_أنواع,
    الرمز: معرف_رمز,
    الحجج: متجه معرف_نوع
): نتيجة_حل_نوع {
    طابق ربط_نوع_مسمى_عند(سجل_الأنواع, الرمز) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_حل_نوع.مفقود(); }
    | اختيار.بعض(الربط) -> {
        لو (الطول(الربط.معاملات_النوع) != الطول(الحجج)) {
            أرجع نتيجة_حل_نوع.معاملات_غير_مدعومة();
        };
        لو (الطول(الربط.معاملات_النوع) == 0) {
            أرجع نتيجة_حل_نوع.موجود(الربط.المعرف);
        };
        طابق الربط.التعريف مع
        | تعريف_نوع_مسمى.مرادف -> {
            دع الاستبدالات: متجه ربط_استبدال_نوع = ابن_استبدالات_نوع(&الربط.معاملات_النوع, &الحجج);
            أرجع نتيجة_حل_نوع.موجود(استبدل_نوعا(سجل_الأنواع, الربط.المعرف, &الاستبدالات));
        }
        | تعريف_نوع_مسمى.سجل(_) -> {
            دع المعرف: معرف_نوع = قنن_نوعا(
                سجل_الأنواع, نوع_مقنن.مسمى(الرمز, شكل_نوع_مسمى.سجل(), الحجج)
            );
            لو (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, المعرف)) {
                أرجع نتيجة_حل_نوع.غير_صالح();
            };
            أرجع نتيجة_حل_نوع.موجود(المعرف);
        }
        | تعريف_نوع_مسمى.تعداد(_) -> {
            دع المعرف: معرف_نوع = قنن_نوعا(
                سجل_الأنواع, نوع_مقنن.مسمى(الرمز, شكل_نوع_مسمى.تعداد(), الحجج)
            );
            لو (!ضمن_مثيلات_نوع_داخل(سجل_الأنواع, المعرف)) {
                أرجع نتيجة_حل_نوع.غير_صالح();
            };
            أرجع نتيجة_حل_نوع.موجود(المعرف);
        };
    };
}

عام عرف نوع_أساس_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار نوع_مقنن {
    دع الحالة: سجل_أنواع = *سجل_الأنواع;
    لو (المعرف.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_النوع: &نوع_مقنن = &الحالة.الأنواع[المعرف.القيمة];
    دع النوع: نوع_مقنن = *مرجع_النوع;
    طابق النوع مع
    | نوع_مقنن.متغير(الداخل) -> {
        أرجع نوع_أساس_عند(سجل_الأنواع, الداخل);
    }
    | _ -> {
        أرجع اختيار.بعض(النوع);
    };
}

عام عرف عدد_عناصر_صف(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار غير_موقع {
    طابق نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.صف(العناصر) -> {
            أرجع اختيار.بعض(الطول(العناصر) مثل غير_موقع);
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}

عام عرف عنصر_صف_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    طابق نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.صف(العناصر) -> {
            لو (الفهرس >= (الطول(العناصر) مثل غير_موقع)) {
                أرجع اختيار.لا_شيء();
            };
            أرجع اختيار.بعض(العناصر[الفهرس]);
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}

عرف معرف_نوع_أساس_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار معرف_نوع {
    دع الحالي: متغير معرف_نوع = المعرف;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        طابق نوع_مقنن_خام_عند(سجل_الأنواع, الحالي) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(نوع_مقنن.متغير(الداخل)) -> { الحالي := الداخل; }
        | اختيار.بعض(_) -> { مستمر := خطأ; };
    }
    أرجع اختيار.بعض(الحالي);
}

عرف ربط_بنية_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار ربط_نوع_مسمى {
    طابق معرف_نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(معرف_الأساس) -> {
        طابق نوع_مقنن_خام_عند(سجل_الأنواع, معرف_الأساس) مع
        | اختيار.بعض(نوع_مقنن.مسمى(الرمز, _, _)) -> {
            طابق ربط_نوع_مسمى_عند(سجل_الأنواع, الرمز) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القالب) -> {
                لو (الطول(القالب.معاملات_النوع) > 0) {
                    طابق تعريف_مثيل_نوع_مسمى_عند(سجل_الأنواع, معرف_الأساس) مع
                    | اختيار.بعض(التعريف) -> {
                        دع بلا_معاملات: متجه معرف_رمز = [];
                        دع المثيل: ربط_نوع_مسمى = {
                            الرمز: الرمز,
                            المعرف: معرف_الأساس,
                            معاملات_النوع: بلا_معاملات,
                            التعريف: التعريف
                        };
                        أرجع اختيار.بعض(المثيل);
                    }
                    | اختيار.لا_شيء -> { };
                };
                أرجع اختيار.بعض(القالب);
            };
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف هل_نوع_سجل(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق ربط_بنية_عند(سجل_الأنواع, المعرف) مع
    | اختيار.بعض(الربط) -> {
        طابق الربط.التعريف مع
        | تعريف_نوع_مسمى.سجل(الحقول) -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

عام عرف عدد_حقول_سجل(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار غير_موقع {
    طابق ربط_بنية_عند(سجل_الأنواع, المعرف) مع
    | اختيار.بعض(الربط) -> {
        طابق الربط.التعريف مع
        | تعريف_نوع_مسمى.سجل(الحقول) -> {
            أرجع اختيار.بعض(الطول(الحقول) مثل غير_موقع);
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف حقل_سجل_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: غير_موقع
): اختيار حقل_سجل_دلالي {
    طابق ربط_بنية_عند(سجل_الأنواع, المعرف) مع
    | اختيار.بعض(الربط) -> {
        طابق الربط.التعريف مع
        | تعريف_نوع_مسمى.سجل(الحقول) -> {
            لو (الفهرس >= (الطول(الحقول) مثل غير_موقع)) {
                أرجع اختيار.لا_شيء();
            };
            أرجع اختيار.بعض(الحقول[الفهرس]);
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف ابحث_حقل_سجل(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الاسم: معرف_اسم
): اختيار حقل_سجل_دلالي {
    طابق ربط_بنية_عند(سجل_الأنواع, المعرف) مع
    | اختيار.بعض(الربط) -> {
        طابق الربط.التعريف مع
        | تعريف_نوع_مسمى.سجل(الحقول) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحقول) مثل غير_موقع)) {
                لو (معرفا_اسم_متساويان(الحقول[ف].الاسم, الاسم)) {
                    أرجع اختيار.بعض(الحقول[ف]);
                };
                ف := ف + 1;
            }
            أرجع اختيار.لا_شيء();
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف نوع_حقل_سجل(الحقل: &حقل_سجل_دلالي): معرف_نوع {
    دع القيمة: حقل_سجل_دلالي = *الحقل;
    أرجع القيمة.النوع;
}

عرف هويتان_لمنشئ_متساويتان(أ: هوية_منشئ_نوع, ب: هوية_منشئ_نوع): منطقي {
    طابق أ مع
    | هوية_منشئ_نوع.اختيار_لا_شيء -> {
        طابق ب مع
        | هوية_منشئ_نوع.اختيار_لا_شيء -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | هوية_منشئ_نوع.اختيار_بعض -> {
        طابق ب مع
        | هوية_منشئ_نوع.اختيار_بعض -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | هوية_منشئ_نوع.نتيجة_نجاح -> {
        طابق ب مع
        | هوية_منشئ_نوع.نتيجة_نجاح -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | هوية_منشئ_نوع.نتيجة_خطأ -> {
        طابق ب مع
        | هوية_منشئ_نوع.نتيجة_خطأ -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | هوية_منشئ_نوع.تعداد(رمز_أ) -> {
        طابق ب مع
        | هوية_منشئ_نوع.تعداد(رمز_ب) -> {
            أرجع معرفا_رمز_متساويان(رمز_أ, رمز_ب);
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف منشئ_تعداد_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: غير_موقع
): اختيار منشئ_نوع_دلالي {
    طابق ربط_بنية_عند(سجل_الأنواع, المعرف) مع
    | اختيار.بعض(الربط) -> {
        طابق الربط.التعريف مع
        | تعريف_نوع_مسمى.تعداد(المنشئات) -> {
            لو (الفهرس >= (الطول(المنشئات) مثل غير_موقع)) {
                أرجع اختيار.لا_شيء();
            };
            دع مرجع_المنشئ: &منشئ_نوع_دلالي = &المنشئات[الفهرس];
            دع المنشئ: منشئ_نوع_دلالي = *مرجع_المنشئ;
            أرجع اختيار.بعض(المنشئ);
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف منشئ_مدمج_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: غير_موقع
): اختيار منشئ_نوع_دلالي {
    طابق نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.اختيار(الداخل) -> {
            دع بلا_اسم: اختيار معرف_اسم = اختيار.لا_شيء();
            لو (الفهرس == 0) {
                دع الحمولات: متجه معرف_نوع = [];
                دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.اختيار_لا_شيء();
                دع المنشئ: منشئ_نوع_دلالي = {
                    الهوية: الهوية,
                    الاسم: بلا_اسم,
                    الحمولات: الحمولات
                };
                أرجع اختيار.بعض(المنشئ);
            };
            لو (الفهرس == 1) {
                دع الحمولات: متجه معرف_نوع = [الداخل];
                دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.اختيار_بعض();
                دع المنشئ: منشئ_نوع_دلالي = {
                    الهوية: الهوية,
                    الاسم: بلا_اسم,
                    الحمولات: الحمولات
                };
                أرجع اختيار.بعض(المنشئ);
            };
            أرجع اختيار.لا_شيء();
        }
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            دع بلا_اسم: اختيار معرف_اسم = اختيار.لا_شيء();
            لو (الفهرس == 0) {
                دع الحمولات: متجه معرف_نوع = [النجاح];
                دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.نتيجة_نجاح();
                دع المنشئ: منشئ_نوع_دلالي = {
                    الهوية: الهوية,
                    الاسم: بلا_اسم,
                    الحمولات: الحمولات
                };
                أرجع اختيار.بعض(المنشئ);
            };
            لو (الفهرس == 1) {
                دع الحمولات: متجه معرف_نوع = [الخطأ];
                دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.نتيجة_خطأ();
                دع المنشئ: منشئ_نوع_دلالي = {
                    الهوية: الهوية,
                    الاسم: بلا_اسم,
                    الحمولات: الحمولات
                };
                أرجع اختيار.بعض(المنشئ);
            };
            أرجع اختيار.لا_شيء();
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}

عام عرف هل_نوع_موسوم(سجل_الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.اختيار(الداخل) -> {
            أرجع صواب;
        }
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            أرجع صواب;
        }
        | نوع_مقنن.مسمى(الرمز, الشكل, _) -> {
            طابق الشكل مع
            | شكل_نوع_مسمى.تعداد -> {
                أرجع صواب;
            }
            | شكل_نوع_مسمى.سجل -> {
                أرجع خطأ;
            };
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

عام عرف عدد_منشئات_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار غير_موقع {
    طابق ربط_بنية_عند(سجل_الأنواع, المعرف) مع
    | اختيار.بعض(الربط) -> {
        طابق الربط.التعريف مع
        | تعريف_نوع_مسمى.تعداد(المنشئات) -> {
            أرجع اختيار.بعض(الطول(المنشئات) مثل غير_موقع);
        }
        | _ -> {
        };
    }
    | اختيار.لا_شيء -> {
    };
    طابق نوع_أساس_عند(سجل_الأنواع, المعرف) مع
    | اختيار.بعض(النوع) -> {
        طابق النوع مع
        | نوع_مقنن.اختيار(الداخل) -> {
            أرجع اختيار.بعض(2);
        }
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            أرجع اختيار.بعض(2);
        }
        | _ -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع اختيار.لا_شيء();
}

عام عرف منشئ_نوع_عند(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الفهرس: غير_موقع
): اختيار منشئ_نوع_دلالي {
    طابق منشئ_تعداد_عند(سجل_الأنواع, المعرف, الفهرس) مع
    | اختيار.بعض(المنشئ) -> {
        أرجع اختيار.بعض(المنشئ);
    }
    | اختيار.لا_شيء -> {
        أرجع منشئ_مدمج_عند(سجل_الأنواع, المعرف, الفهرس);
    };
}

عام عرف ابحث_منشئ_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختيار منشئ_نوع_دلالي {
    طابق عدد_منشئات_نوع(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(العدد) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, ف) مع
            | اختيار.بعض(المنشئ) -> {
                لو (هويتان_لمنشئ_متساويتان(المنشئ.الهوية, الهوية)) {
                    أرجع اختيار.بعض(المنشئ);
                };
            }
            | اختيار.لا_شيء -> {
            };
            ف := ف + 1;
        }
        أرجع اختيار.لا_شيء();
    };
}

عام عرف ترتيب_منشئ_نوع(
    سجل_الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    الهوية: هوية_منشئ_نوع
): اختيار غير_موقع {
    طابق عدد_منشئات_نوع(سجل_الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(العدد) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            طابق منشئ_نوع_عند(سجل_الأنواع, المعرف, ف) مع
            | اختيار.بعض(المنشئ) -> {
                لو (هويتان_لمنشئ_متساويتان(المنشئ.الهوية, الهوية)) {
                    أرجع اختيار.بعض(ف);
                };
            }
            | اختيار.لا_شيء -> {
                أرجع اختيار.لا_شيء();
            };
            ف := ف + 1;
        }
        أرجع اختيار.لا_شيء();
    };
}

عام عرف عدد_حمولات_منشئ(المنشئ: &منشئ_نوع_دلالي): غير_موقع {
    دع القيمة: منشئ_نوع_دلالي = *المنشئ;
    أرجع الطول(القيمة.الحمولات) مثل غير_موقع;
}

عام عرف حمولة_منشئ_عند(
    المنشئ: &منشئ_نوع_دلالي,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    دع القيمة: منشئ_نوع_دلالي = *المنشئ;
    لو (الفهرس >= (الطول(القيمة.الحمولات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(القيمة.الحمولات[الفهرس]);
}
