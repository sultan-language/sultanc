استورد compiler.frontend.types.type_context;
// Canonical Type pipeline result consumed by the real driver. It contains exactly
// the three Type-owned contexts expected by semantic lowering.
// Canonical declaration/signature Symbol -> Type facts are Type-owned and survive the
// whole-unit pass. Downstream consumers query this table; they never re-resolve AST Type syntax.
عام نوع سياق_أنواع_رموز = {
    // SymbolID is already a dense canonical identity. Type owns one direct slot per Symbol;
    // no secondary Symbol→Type fact list is searched during expression inference.
    الأنواع: متجه اختياري معرف_نوع,
    // Per Symbol: the length of an immutable local initialized from a text or
    // vector literal, for constant-index bounds checks.
    الأطوال_المعروفة: متجه اختياري طبيعي,
    // The declared type parameters of each generic function, in order, for
    // explicit type arguments (`f<A, B>(..)`).
    معاملات_الدوال: متجه معاملات_نوع_دالة_مسجلة
};

عام نوع معاملات_نوع_دالة_مسجلة = {
    الرمز: معرف_رمز,
    المعاملات: متجه معرف_رمز
};

عام نوع علاقة_هرم_نوع = {
    النوع_الفرعي: معرف_رمز,
    النوع_العلوي: معرف_رمز
};

عام نوع سياقات_أنواع_وحدة = {
    الأنواع: سجل_أنواع,
    أنواع_التعبيرات: متجه سياق_أنواع_تعبيرات,
    أنواع_الرموز: سياق_أنواع_رموز,
    علاقات_هرم_الأنواع: متجه علاقة_هرم_نوع
};

عام نوع خطأ_بناء_سياقات_أنواع =
    | ربط_اسم_مفقود بنوع نطاق
    | هوية_اسم_مفقودة بنوع نطاق
    | نوع_غير_محلول بنوع نطاق
    | تعريف_نوع_غير_صالح بنوع نطاق
    | نوع_رمز_مفقود بنوع (معرف_رمز, نطاق)
    // A type-table invariant failed (always a compiler bug); which one.
    | نوع_تعبير_غير_مدعوم بنوع (نطاق, ثابت_أنواع_مكسور)
    | سمة_تصريح_غير_مدعومة بنوع نطاق
    | حقل_سجل_غير_معروف بنوع نطاق
    | نمط_غير_صالح بنوع نطاق
    | عدد_حجج_استدعاء_غير_مطابق بنوع (نطاق, طبيعي, طبيعي)
    // A constructor pattern binding another number of payloads than the
    // constructor carries: (pattern, carried, bound).
    | عدد_حمولات_نمط_غير_مطابق بنوع (نطاق, طبيعي, طبيعي)
    | نوع_حجة_استدعاء_غير_مطابق بنوع (نطاق, طبيعي, معرف_نوع, معرف_نوع)
    | نوع_إرجاع_غير_مطابق بنوع (نطاق, معرف_نوع, معرف_نوع)
    | عدد_حجج_بدائية_غير_مطابق بنوع (نطاق, هوية_بدائي_مترجم, طبيعي, طبيعي)
    | نوع_حجة_بدائية_غير_مطابق بنوع (نطاق, هوية_بدائي_مترجم, طبيعي, معرف_نوع, معرف_نوع)
    | نوع_حجة_بدائية_غير_صالح بنوع (نطاق, هوية_بدائي_مترجم, طبيعي, معرف_نوع)
    | دلالة_بدائي_غير_متاحة بنوع (نطاق, هوية_بدائي_مترجم)
    | تعبير_غير_قابل_للاستدعاء بنوع (نطاق, معرف_نوع)
    // User type errors. The context names the rule that was broken; the
    // expected and found Types are attached when they are known.
    | أنواع_غير_متوافقة بنوع (نطاق, سياق_عدم_توافق_نوع, اختياري معرف_نوع, اختياري معرف_نوع)
    | أخذ_عنوان_غير_موضع بنوع نطاق
    | كتابة_إلى_غير_قابل_للتغيير بنوع نطاق
    | إسناد_إلى_غير_موضع بنوع نطاق
    // The literal's span and, when known, the first field it leaves out.
    | حقل_سجل_مفقود بنوع (نطاق, اختياري معرف_اسم)
    // The repeated field name and its first occurrence.
    | حقل_سجل_مكرر بنوع (نطاق, نطاق)
    | فك_غير_مؤشر بنوع (نطاق, معرف_نوع)
    // The index and the tuple's element count.
    | فهرس_صف_خارج_الحدود بنوع (نطاق, طبيعي, طبيعي)
    // A constant index and the known length of a text or vector local.
    | فهرس_خارج_طول_معروف بنوع (نطاق, طبيعي, طبيعي)
    | قفز_خارج_حلقة بنوع نطاق
    // An opaque type used where it has no meaning: which use, and the
    // opaque Type. The span is the written type, the operation, or (for a
    // field) the field name as written.
    | استعمال_نوع_معتم بنوع (نطاق, صنف_استعمال_معتم, معرف_نوع)
    // A generic call whose instantiated signature holds an opaque type
    // argument by value: the call, the generic's name, the opaque Type.
    | معتم_في_توقيع_مثيل بنوع (نطاق, اختياري نطاق, معرف_نوع)
;

// The rule an opaque-type error breaks. The diagnostic adapter maps each one
// to its identity; no wording lives here.
عام نوع صنف_استعمال_معتم =
    // A value of it: local, field, payload, parameter, result, global,
    // cast target, reference, element of a container.
    | بالقيمة
    // A type argument: `f<T>(...)`, a generic call inferring T, `G<T>`.
    | حجة_نوع
    // `*p` where p: *T, inside unsafe too.
    | فك
    // `p.f` where p: *T (or a T place).
    | حقل
    // `p[i]` where p: *T: pointer arithmetic by the element size.
    | فهرسة
;

// Which typing rule a mismatched-types error breaks. The diagnostic adapter
// maps each one to a typed reason; no wording lives here.
// The type-table invariant an internal type error reports. A user mistake is
// never one of these: it has its own error with expected/found types.
عام نوع ثابت_أنواع_مكسور =
    | تسجيل_نوع_تعبير
    | تسجيل_نوع_منشئ
    | نوع_حمولة_منشئ
    | نوع_عنصر_صف
    | حجة_بلا_نوع
;

عام نوع سياق_عدم_توافق_نوع =
    | طرفا_عامل_مختلفان
    | عامل_يتطلب_منطقيا
    | عامل_يتطلب_عددا
    | عامل_يتطلب_عددا_صحيحا
    | شرط_غير_منطقي
    | قيمة_لا_تطابق_الوجهة
    | فهرس_ليس_عددا_صحيحا
    | نوع_غير_قابل_للفهرسة
    | فهرس_صف_غير_ثابت
    | عدد_عناصر_صف
    | فارغ_بلا_مؤشر
    | حرفي_لا_يناسب_الوجهة
    | عدد_حرفي_خارج_المدى
    // `x as T` between two scalar types that no conversion joins.
    | تحويل_غير_صالح
    // Unary minus on a value of an unsigned integer type (Rust's E0600).
    | سالب_عدد_طبيعي
;

عام نوع نتيجة_بناء_سياقات_أنواع =
    | مبنية بنوع سياقات_أنواع_وحدة
    | مرفوضة بنوع (خطأ_بناء_سياقات_أنواع, سجل_أنواع)
    // The cancellation token was set (checked before each module's bodies).
    | ملغاة
;

عام عرف سياق_أنواع_رموز_جديد(): سياق_أنواع_رموز {
    دع الأنواع: متجه اختياري معرف_نوع = [];
    دع الأطوال: متجه اختياري طبيعي = [];
    دع معاملات_الدوال: متجه معاملات_نوع_دالة_مسجلة = [];
    دع السياق: سياق_أنواع_رموز = {
        الأنواع: الأنواع, الأطوال_المعروفة: الأطوال, معاملات_الدوال: معاملات_الدوال
    };
    أرجع السياق;
}

عرف أضف_نوع_رمز(
    السياق: &متغير سياق_أنواع_رموز,
    الرمز: معرف_رمز,
    النوع: معرف_نوع
): منطقي {
    طالما ((الطول((*السياق).الأنواع) مثل طبيعي) <= (الرمز.القيمة مثل طبيعي)) {
        ألحق((*السياق).الأنواع, اختياري.لا_شيء());
    }
    (*السياق).الأنواع[الرمز.القيمة] := اختياري.موجود(النوع);
    أرجع صواب;
}

عرف سجل_طول_معروف_لرمز(
    السياق: &متغير سياق_أنواع_رموز,
    الرمز: معرف_رمز,
    العدد: طبيعي
): فراغ {
    طالما ((الطول((*السياق).الأطوال_المعروفة) مثل طبيعي) <= (الرمز.القيمة مثل طبيعي)) {
        ألحق((*السياق).الأطوال_المعروفة, اختياري.لا_شيء());
    }
    (*السياق).الأطوال_المعروفة[الرمز.القيمة] := اختياري.موجود(العدد);
}

عرف طول_معروف_لرمز(
    السياق: &سياق_أنواع_رموز,
    الرمز: معرف_رمز
): اختياري طبيعي {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*السياق).الأطوال_المعروفة) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع (*السياق).الأطوال_المعروفة[الرمز.القيمة];
}

// A local declared without `mutable` and initialized from a literal keeps the
// literal's length: record it when the initialized place is such a local.
عرف سجل_طول_تهيئة_حرفية(
    الوجهة: &تعبير,
    نوع_الوجهة: معرف_نوع,
    العدد: طبيعي,
    المصرح_السابق: اختياري معرف_رمز,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): فراغ {
    إذا (هل_نوع_مغلف_بمتغير(الأنواع, نوع_الوجهة)) { أرجع; };
    دع المصرح: معرف_رمز;
    طابق المصرح_السابق مع
    | اختياري.موجود(الرمز) -> { المصرح := الرمز; }
    | اختياري.لا_شيء -> { أرجع; };
    طابق *الوجهة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            // Only the initializer of the declaration: a later assignment of a
            // deferred local may take another length on another path.
            إذا (الرمز.القيمة == المصرح.القيمة) { سجل_طول_معروف_لرمز(أنواع_الرموز, الرمز, العدد); };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
}

// The local a declaration statement declares.
عرف رمز_تصريح_عبارة(العبارة: &عبارة, الروابط: &سياق_روابط_أسماء): اختياري معرف_رمز {
    طابق *العبارة مع
    | عبارة.تصريح_متغير(_, الاسم, _) -> { أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The known length of an indexed local, when it has one.
عرف طول_معروف_لتعبير(
    التعبير: &تعبير,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &سياق_أنواع_رموز
): اختياري طبيعي {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> { أرجع طول_معروف_لرمز(أنواع_الرموز, الرمز); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف نوع_رمز_دلالي_عند(
    السياق: &سياق_أنواع_رموز,
    الرمز: معرف_رمز
): اختياري معرف_نوع {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*السياق).الأنواع) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع (*السياق).الأنواع[الرمز.القيمة];
}




عرف نطاق_نوع_تركيبي_داخلي(النوع: &نوع_تركيبي): نطاق {
    أرجع نطاق_نوع_تركيبي(النوع);
}

عرف رمز_اسم_مطلوب_للنوع(
    الروابط: &سياق_روابط_أسماء,
    الاسم: &اسم
): نتيجة معرف_رمز, خطأ_بناء_سياقات_أنواع {
    دع القيمة: اسم = *الاسم;
    طابق رمز_اسم_محلول_عند(الروابط, القيمة.النطاق) مع
    | اختياري.موجود(الرمز) -> {
        أرجع نتيجة.نجح(الرمز);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود(القيمة.النطاق));
    };
}

عرف هوية_اسم_مطلوبة_للنوع(
    الروابط: &سياق_روابط_أسماء,
    الاسم: &اسم
): نتيجة معرف_اسم, خطأ_بناء_سياقات_أنواع {
    دع القيمة: اسم = *الاسم;
    طابق معرف_اسم_محلول_عند(الروابط, القيمة.النطاق) مع
    | اختياري.موجود(الهوية) -> {
        أرجع نتيجة.نجح(الهوية);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.هوية_اسم_مفقودة(القيمة.النطاق));
    };
}

// Type owns canonical Symbol -> Type facts. Pattern owns semantic Pattern validation,
// while bindings introduced by a source pattern are ordinary Name Symbols consumed by
// expressions in that arm. These narrow helpers seed only those Symbol Type facts from
// the already-known discriminant Type; Pattern validates the structure independently.
عرف اربط_نوع_رمز_نمط_ربط(
    الاسم: &اسم,
    النوع: معرف_نوع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع القيمة: اسم = *الاسم;
    طابق رمز_اسم_محلول_عند(الروابط, القيمة.النطاق) مع
    | اختياري.موجود(الرمز) -> {
        أرجع أضف_نوع_رمز(أنواع_الرموز, الرمز, النوع);
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف اربط_أنواع_رموز_نمط_صف(
    العناصر: &متجه نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        دع نوع_الابن: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف) مع
        | اختياري.موجود(الموجود) -> { نوع_الابن := الموجود; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        إذا (!اربط_أنواع_رموز_نمط_تركيبي(
            &(*العناصر)[ف], نوع_الابن, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اربط_أنواع_رموز_نمط_سجل(
    الحقول: &متجه حقل_نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحقول) مثل طبيعي)) {
        دع قيمة_الاسم: اسم = (*الحقول)[ف].الاسم;
        دع هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
        طابق معرف_اسم_محلول_عند(الروابط, قيمة_الاسم.النطاق) مع
        | اختياري.موجود(الهوية) -> { هوية_الحقل := الهوية; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        دع نوع_الابن: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, النوع, هوية_الحقل) مع
        | اختياري.موجود(الموجود) -> { نوع_الابن := الموجود; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        إذا (!اربط_أنواع_رموز_نمط_تركيبي(
            &(*الحقول)[ف].النمط, نوع_الابن, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف هوية_منشئ_مسمى_للنوع(
    اسم_النوع: &اسم,
    اسم_المنشئ: &اسم,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء
): اختياري هوية_منشئ_نوع {
    دع قيمة_اسم_النوع: اسم = *اسم_النوع;
    دع قيمة_اسم_المنشئ: اسم = *اسم_المنشئ;
    دع هوية_اسم_النوع: متغير معرف_اسم = معرف_اسم_من(0);
    دع هوية_اسم_المنشئ: متغير معرف_اسم = معرف_اسم_من(0);
    طابق معرف_اسم_محلول_عند(الروابط, قيمة_اسم_النوع.النطاق) مع
    | اختياري.موجود(الهوية) -> { هوية_اسم_النوع := الهوية; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق معرف_اسم_محلول_عند(الروابط, قيمة_اسم_المنشئ.النطاق) مع
    | اختياري.موجود(الهوية) -> { هوية_اسم_المنشئ := الهوية; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };

    طابق هوية_منشئ_مدمج_دلالية_بالأسماء(
        سياق_الأسماء, الأنواع, النوع, هوية_اسم_النوع, هوية_اسم_المنشئ
    ) مع
    | اختياري.موجود(الهوية) -> { أرجع اختياري.موجود(الهوية); }
    | اختياري.لا_شيء -> { };

    طابق رمز_اسم_محلول_عند(الروابط, قيمة_اسم_المنشئ.النطاق) مع
    | اختياري.موجود(رمز_المنشئ) -> {
        أرجع هوية_منشئ_تعداد_دلالية_بالرمز(الأنواع, النوع, رمز_المنشئ);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف اربط_أنواع_رموز_حمولات_منشئ(
    الحمولات: &متجه نمط,
    النوع: معرف_نوع,
    الهوية: هوية_منشئ_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحمولات) مثل طبيعي)) {
        دع نوع_الابن: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع, الهوية, ف) مع
        | اختياري.موجود(الموجود) -> { نوع_الابن := الموجود; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        إذا (!اربط_أنواع_رموز_نمط_تركيبي(
            &(*الحمولات)[ف], نوع_الابن, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The first constructor pattern, at any depth, whose payload count differs
// from its constructor's: why a pattern failed to bind, said precisely.
عام نوع مخالفة_حمولات_نمط = {
    النطاق: نطاق,
    المتوقع: طبيعي,
    الموجود: طبيعي
};

عرف مخالفة_حمولات_نمط_في(
    النمط: &نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء
): اختياري مخالفة_حمولات_نمط {
    دع القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.منشئ(_, اسم_النوع, اسم_المنشئ, الحمولات) -> {
        طابق هوية_منشئ_مسمى_للنوع(&اسم_النوع, &اسم_المنشئ, النوع, سياق_الأسماء, الأنواع, الروابط) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الهوية) -> {
            طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, النوع, الهوية) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الوصف) -> {
                دع العدد: طبيعي = الطول(الحمولات) مثل طبيعي;
                إذا (العدد != الوصف.عدد_الحمولات) {
                    دع المخالفة: مخالفة_حمولات_نمط = {
                        النطاق: نطاق_نمط(النمط),
                        المتوقع: الوصف.عدد_الحمولات,
                        الموجود: العدد
                    };
                    أرجع اختياري.موجود(المخالفة);
                };
                دع ف: متغير طبيعي = 0;
                طالما (ف < العدد) {
                    طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع, الهوية, ف) مع
                    | اختياري.موجود(نوع_الحمولة) -> {
                        طابق مخالفة_حمولات_نمط_في(&الحمولات[ف], نوع_الحمولة, سياق_الأسماء, الأنواع, الروابط) مع
                        | اختياري.موجود(الداخلية) -> { أرجع اختياري.موجود(الداخلية); }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    ف := ف + 1;
                }
                أرجع اختياري.لا_شيء();
            };
        };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف اربط_أنواع_رموز_نمط_منشئ(
    اسم_النوع: &اسم,
    اسم_المنشئ: &اسم,
    الحمولات: &متجه نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    طابق هوية_منشئ_مسمى_للنوع(
        اسم_النوع, اسم_المنشئ, النوع, سياق_الأسماء, الأنواع, الروابط
    ) مع
    | اختياري.موجود(الهوية) -> {
        أرجع اربط_أنواع_رموز_حمولات_منشئ(
            الحمولات, النوع, الهوية, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف اربط_أنواع_رموز_نمط_تركيبي(
    النمط: &نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.بدل(_) -> { أرجع صواب; }
    | نمط.ربط(_, الاسم) -> {
        أرجع اربط_نوع_رمز_نمط_ربط(&الاسم, النوع, الروابط, أنواع_الرموز);
    }
    | نمط.حرفي(_, _) -> { أرجع صواب; }
    | نمط.مدى(_, _, _) -> { أرجع صواب; }
    | نمط.بدائل(_, _) -> { أرجع صواب; }
    | نمط.صف(_, العناصر) -> {
        أرجع اربط_أنواع_رموز_نمط_صف(
            &العناصر, النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | نمط.سجل(_, الحقول) -> {
        أرجع اربط_أنواع_رموز_نمط_سجل(
            &الحقول, النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | نمط.منشئ(_, اسم_النوع, اسم_المنشئ, الحمولات) -> {
        أرجع اربط_أنواع_رموز_نمط_منشئ(
            &اسم_النوع, &اسم_المنشئ, &الحمولات, النوع,
            سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    };
}

عرف رموز_معاملات_نوع_معلنة(
    المعاملات: &متجه اسم,
    الروابط: &سياق_روابط_أسماء
): اختياري متجه معرف_رمز {
    دع الناتج: متغير متجه معرف_رمز = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعاملات) مثل طبيعي)) {
        طابق رمز_اسم_محلول_عند(الروابط, (*المعاملات)[ف].النطاق) مع
        | اختياري.موجود(الرمز) -> { ألحق(الناتج, الرمز); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

عرف سجل_قائمة_معاملات_نوع(
    المعاملات: &متجه اسم,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(*المعاملات) مثل طبيعي)) {
        طابق رمز_اسم_محلول_عند(الروابط, (*المعاملات)[م].النطاق) مع
        | اختياري.موجود(الرمز) -> {
            دع النوع: معرف_نوع = سجل_معامل_نوع(الأنواع, الرمز);
            إذا (!أضف_نوع_رمز(أنواع_الرموز, الرمز, النوع)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح((*المعاملات)[م].النطاق));
            };
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود((*المعاملات)[م].النطاق));
        };
        م := م + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف سجل_معاملات_نوع_العناصر(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        طابق (*العناصر)[ف] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            طابق سجل_قائمة_معاملات_نوع(&الدالة.معاملات_النوع, الروابط, الأنواع, أنواع_الرموز) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            إذا ((الطول(الدالة.معاملات_النوع) مثل طبيعي) > 0) {
                طابق رمز_اسم_محلول_عند(الروابط, الدالة.الاسم.النطاق) مع
                | اختياري.موجود(رمز_الدالة) -> {
                    طابق رموز_معاملات_نوع_معلنة(&الدالة.معاملات_النوع, الروابط) مع
                    | اختياري.موجود(الرموز) -> {
                        دع المسجلة: معاملات_نوع_دالة_مسجلة = { الرمز: رمز_الدالة, المعاملات: الرموز };
                        ألحق((*أنواع_الرموز).معاملات_الدوال, المسجلة);
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | عنصر_وحدة.نوع(التصريح) -> {
            طابق سجل_قائمة_معاملات_نوع(&التصريح.معاملات_النوع, الروابط, الأنواع, أنواع_الرموز) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أعلن_التراكيب_المسماة(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع
): اختياري خطأ_بناء_سياقات_أنواع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        دع مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.نوع(التصريح) -> {
            طابق التصريح.الشكل مع
            | شكل_تصريح_نوع.سجل(_) -> {
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(الرمز) -> {
                    طابق رموز_معاملات_نوع_معلنة(&التصريح.معاملات_النوع, الروابط) مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    }
                    | اختياري.موجود(معاملات_النوع) -> {
                        إذا (!أضف_سجل_نوع_بمعاملات(الأنواع, الرمز, معاملات_النوع)) {
                            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                        };
                    };
                };
            }
            | شكل_تصريح_نوع.تعداد(_) -> {
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(الرمز) -> {
                    طابق رموز_معاملات_نوع_معلنة(&التصريح.معاملات_النوع, الروابط) مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    }
                    | اختياري.موجود(معاملات_النوع) -> {
                        إذا (!أضف_تعداد_نوع_بمعاملات(الأنواع, الرمز, معاملات_النوع)) {
                            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                        };
                    };
                };
            }
            // Complete at declaration: no members are filled in later. An
            // opaque type takes no type parameters.
            | شكل_تصريح_نوع.معتم(_) -> {
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(الرمز) -> {
                    إذا ((الطول(التصريح.معاملات_النوع) مثل طبيعي) != 0) {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    };
                    إذا (!أضف_معتم_نوع(الأنواع, الرمز)) {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    };
                };
            }
            | شكل_تصريح_نوع.مرادف(_) -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أكمل_المرادفات(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    علاقات_الهرم: &متغير متجه علاقة_هرم_نوع
): اختياري خطأ_بناء_سياقات_أنواع {
    دع مكتملة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ألحق(مكتملة, خطأ);
        ف := ف + 1;
    }
    دع جولة: متغير طبيعي = 0;
    طالما (جولة < (الطول(*العناصر) مثل طبيعي)) {
        دع تقدم: متغير منطقي = خطأ;
        ف := 0;
        طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
            إذا (!مكتملة[ف]) {
                دع مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
                دع العنصر: عنصر_وحدة = *مرجع_العنصر;
                طابق العنصر مع
                | عنصر_وحدة.نوع(التصريح) -> {
                    طابق التصريح.الشكل مع
                    | شكل_تصريح_نوع.مرادف(الهدف) -> {
                        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الهدف) مع
                        | نتيجة_حل_نوع.موجود(نوع_الهدف) -> {
                            // An alias of an opaque type is that same type.
                            إذا (!هل_نوع_معتم(الأنواع, نوع_الهدف)) {
                                طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, نوع_الهدف, نطاق_نوع_تركيبي_داخلي(&الهدف)) مع
                                | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                                | اختياري.لا_شيء -> { };
                            };
                            طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                            | نتيجة.خطأ(الخطأ) -> {
                                أرجع اختياري.موجود(الخطأ);
                            }
                            | نتيجة.نجح(الرمز) -> {
                                طابق الهدف مع
                                | نوع_تركيبي.مسمى(_, اسم_الهدف, _) -> {
                                    طابق رمز_اسم_محلول_عند(الروابط, اسم_الهدف.النطاق) مع
                                    | اختياري.موجود(رمز_الهدف) -> {
                                        دع العلاقة: علاقة_هرم_نوع = {
                                            النوع_الفرعي: الرمز,
                                            النوع_العلوي: رمز_الهدف
                                        };
                                        ألحق(*علاقات_الهرم, العلاقة);
                                    }
                                    | اختياري.لا_شيء -> { };
                                }
                                | _ -> { };
                                طابق رموز_معاملات_نوع_معلنة(&التصريح.معاملات_النوع, الروابط) مع
                                | اختياري.لا_شيء -> {
                                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                                }
                                | اختياري.موجود(معاملات_النوع) -> {
                                    إذا (!أضف_مرادف_نوع_بمعاملات(الأنواع, الرمز, معاملات_النوع, نوع_الهدف)) {
                                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                                    };
                                };
                                مكتملة[ف] := صواب;
                                تقدم := صواب;
                            };
                        }
                        | نتيجة_حل_نوع.مفقود -> { }
                        | _ -> {
                            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&الهدف)));
                        };
                    }
                    | _ -> {
                        مكتملة[ف] := صواب;
                    };
                }
                | _ -> {
                    مكتملة[ف] := صواب;
                };
            };
            ف := ف + 1;
        }
        إذا (!تقدم) {
            جولة := الطول(*العناصر) مثل طبيعي;
        }
        وإلا {
            جولة := جولة + 1;
        };
    }
    ف := 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        إذا (!مكتملة[ف]) {
            دع مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
            دع العنصر: عنصر_وحدة = *مرجع_العنصر;
            طابق العنصر مع
            | عنصر_وحدة.نوع(التصريح) -> {
                طابق التصريح.الشكل مع
                | شكل_تصريح_نوع.مرادف(الهدف) -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&الهدف)));
                }
                | _ -> { };
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أكمل_التراكيب_المسماة(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        دع مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.نوع(التصريح) -> {
            طابق التصريح.الشكل مع
            | شكل_تصريح_نوع.سجل(الحقول_النحوية) -> {
                دع الرمز: متغير معرف_رمز = معرف_رمز_من(0);
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(القيمة_رمز) -> {
                    الرمز := القيمة_رمز;
                };
                دع الحقول: متغير متجه حقل_سجل_دلالي = [];
                دع ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الحقول_النحوية) مثل طبيعي)) {
                    دع نوع_الحقل: متغير معرف_نوع = معرف_نوع_من(0);
                    طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الحقول_النحوية[ح].النوع) مع
                    | نتيجة_حل_نوع.موجود(المعرف) -> {
                        طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, المعرف, نطاق_نوع_تركيبي_داخلي(&الحقول_النحوية[ح].النوع)) مع
                        | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                        | اختياري.لا_شيء -> { };
                        نوع_الحقل := المعرف;
                    }
                    | _ -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                            نطاق_نوع_تركيبي_داخلي(&الحقول_النحوية[ح].النوع)
                        ));
                    };
                    طابق هوية_اسم_مطلوبة_للنوع(الروابط, &الحقول_النحوية[ح].الاسم) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | نتيجة.نجح(هوية_الحقل) -> {
                        دع الحقل: حقل_سجل_دلالي = { الاسم: هوية_الحقل, النوع: نوع_الحقل };
                        ألحق(الحقول, الحقل);
                    };
                    ح := ح + 1;
                }
                إذا (!أكمل_سجل_نوع_بحقول(الأنواع, الرمز, الحقول)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
            }
            | شكل_تصريح_نوع.تعداد(المنشئات_النحوية) -> {
                دع رمز_التعداد: متغير معرف_رمز = معرف_رمز_من(0);
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(القيمة_رمز) -> {
                    رمز_التعداد := القيمة_رمز;
                };
                دع نوع_التعداد: متغير معرف_نوع = معرف_نوع_من(0);
                طابق حل_نوع_مسمى(الأنواع, رمز_التعداد) مع
                | نتيجة_حل_نوع.موجود(المعرف) -> {
                    نوع_التعداد := المعرف;
                }
                | _ -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
                دع المنشئات: متغير متجه منشئ_نوع_دلالي = [];
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(المنشئات_النحوية) مثل طبيعي)) {
                    دع رمز_المنشئ: متغير معرف_رمز = معرف_رمز_من(0);
                    طابق رمز_اسم_مطلوب_للنوع(الروابط, &المنشئات_النحوية[م].الاسم) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | نتيجة.نجح(القيمة_رمز) -> {
                        رمز_المنشئ := القيمة_رمز;
                    };
                    دع اسم_المنشئ: متغير معرف_اسم = معرف_اسم_من(0);
                    طابق هوية_اسم_مطلوبة_للنوع(الروابط, &المنشئات_النحوية[م].الاسم) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | نتيجة.نجح(الهوية) -> {
                        اسم_المنشئ := الهوية;
                    };
                    دع الحمولات: متغير متجه معرف_نوع = [];
                    دع أنواع_المعاملات: متغير متجه معرف_نوع = [];
                    دع ح: متغير طبيعي = 0;
                    طالما (ح < (الطول(المنشئات_النحوية[م].الحمولات) مثل طبيعي)) {
                        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &المنشئات_النحوية[م].الحمولات[ح]) مع
                        | نتيجة_حل_نوع.موجود(المعرف) -> {
                            طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, المعرف, نطاق_نوع_تركيبي_داخلي(&المنشئات_النحوية[م].الحمولات[ح])) مع
                            | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                            | اختياري.لا_شيء -> { };
                            ألحق(الحمولات, المعرف);
                            ألحق(أنواع_المعاملات, المعرف);
                        }
                        | _ -> {
                            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                                نطاق_نوع_تركيبي_داخلي(&المنشئات_النحوية[م].الحمولات[ح])
                            ));
                        };
                        ح := ح + 1;
                    }
                    دع الهوية_الدلالية: هوية_منشئ_نوع = هوية_منشئ_نوع.تعداد(رمز_المنشئ);
                    دع الاسم_الدلالي: اختياري معرف_اسم = اختياري.موجود(اسم_المنشئ);
                    دع المنشئ: منشئ_نوع_دلالي = {
                        الهوية: الهوية_الدلالية,
                        الاسم: الاسم_الدلالي,
                        الحمولات: الحمولات
                    };
                    ألحق(المنشئات, المنشئ);
                    دع نوع_الدالة: معرف_نوع = قنن_نوعا(
                        الأنواع,
                        نوع_مقنن.دالة(أنواع_المعاملات, نوع_التعداد)
                    );
                    إذا (!أضف_نوع_رمز(أنواع_الرموز, رمز_المنشئ, نوع_الدالة)) {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(المنشئات_النحوية[م].الاسم.النطاق));
                    };
                    م := م + 1;
                }
                إذا (!أكمل_تعداد_نوع_بمنشئات(الأنواع, رمز_التعداد, المنشئات)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
            }
            // Registered complete by أعلن_التراكيب_المسماة: no members.
            | شكل_تصريح_نوع.معتم(_) -> { }
            | شكل_تصريح_نوع.مرادف(_) -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

نوع نتيجة_نوع_تعبير_داخلية =
    | موجود بنوع معرف_نوع
    | خطأ بنوع خطأ_بناء_سياقات_أنواع
;

عرف خطأ_أنواع_غير_متوافقة(
    النطاق: نطاق,
    السياق: سياق_عدم_توافق_نوع,
    المتوقع: معرف_نوع,
    الموجود: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
        النطاق, السياق, اختياري.موجود(المتوقع), اختياري.موجود(الموجود)
    ));
}

// The opaque-type error of a written Type (docs/en/reference/type-system.md,
// "Opaque types"), at the span of that written Type.
عرف خطأ_معتم_في_نوع_مكتوب(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    النطاق: نطاق
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق استعمال_معتم_ممنوع_في_نوع(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاستعمال) -> {
        إذا (الاستعمال.حجة_نوع) {
            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
                النطاق, صنف_استعمال_معتم.حجة_نوع(), الاستعمال.المعتم
            ));
        };
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
            النطاق, صنف_استعمال_معتم.بالقيمة(), الاستعمال.المعتم
        ));
    };
}

// A written type argument may be an opaque type itself: whether the generic
// can take it is decided on the instance (its signature at the call, its
// body by monomorphization). Any other use of an opaque type in it is
// checked as a written type.
عرف خطأ_معتم_في_حجة_نوع(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    النطاق: نطاق
): اختياري خطأ_بناء_سياقات_أنواع {
    إذا (هل_نوع_معتم(الأنواع, النوع)) { أرجع اختياري.لا_شيء(); };
    أرجع خطأ_معتم_في_نوع_مكتوب(الأنواع, النوع, النطاق);
}

عرف هل_مؤشر_خام_دلالي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_نوع_صحيح_32_دلالي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.ط32) -> { أرجع صواب; }
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص32) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// The first cast between a raw pointer and a 32-bit integer on a target
// whose pointers are not 32 bits wide: there the address word is 64 bits.
عام عرف أول_تحويل_عنوان_32_مرفوض(
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    عرض_المؤشر_بالبتات: طبيعي
): اختياري خطأ_بناء_سياقات_أنواع {
    إذا (عرض_المؤشر_بالبتات == 32) { أرجع اختياري.لا_شيء(); };
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        دع السياق: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        إذا ((الطول((*السياق).تحويلات_عنوان_32) مثل طبيعي) > 0) {
            دع الحقيقة: حقيقة_تحويل_عنوان_32 = (*السياق).تحويلات_عنوان_32[0];
            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                الحقيقة.النطاق, سياق_عدم_توافق_نوع.تحويل_غير_صالح(),
                اختياري.موجود(الحقيقة.الهدف), اختياري.موجود(الحقيقة.المصدر)
            ));
        };
        و := و + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A generic call whose type arguments bind an opaque type: the instantiated
// signature must pass and return the type only behind pointers, or the
// caller would hold a value of it. The related location is the generic's
// declaration. Its body is checked per instance by monomorphization
// (أول_استعمال_معتم_في_مثيل, compiler/msir/lowering/monomorphization.sn).
عرف خطأ_معتم_في_توقيع_مثيل(
    الأنواع: &متغير سجل_أنواع,
    سياق_الأسماء: &سياق_أسماء,
    نوع_المستدعى: معرف_نوع,
    الاستبدالات: &متجه ربط_استبدال_نوع,
    رمز_المستدعى: اختياري معرف_رمز,
    النطاق: نطاق
): اختياري خطأ_بناء_سياقات_أنواع {
    دع فيها_معتم: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاستبدالات) مثل طبيعي)) {
        إذا (يحوي_نوعا_معتما(الأنواع, (*الاستبدالات)[ف].الحجة)) { فيها_معتم := صواب; };
        ف := ف + 1;
    }
    إذا (!فيها_معتم) { أرجع اختياري.لا_شيء(); };
    دع المخصص: معرف_نوع = استبدل_نوعا(الأنواع, نوع_المستدعى, الاستبدالات);
    طابق استعمال_معتم_ممنوع_في_نوع(الأنواع, المخصص) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاستعمال) -> {
        دع المرتبط: متغير اختياري نطاق = اختياري.لا_شيء();
        طابق رمز_المستدعى مع
        | اختياري.موجود(الرمز) -> {
            إذا ((الرمز.القيمة مثل طبيعي) < (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
                المرتبط := اختياري.موجود((*سياق_الأسماء).الرموز[الرمز.القيمة].نطاق_الاسم);
            };
        }
        | اختياري.لا_شيء -> { };
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.معتم_في_توقيع_مثيل(
            النطاق, المرتبط, الاستعمال.المعتم
        ));
    };
}

// `*p` where p points at an opaque type, inside unsafe too.
عرف خطأ_فك_معتم(
    الأنواع: &سجل_أنواع,
    نوع_المؤشر: معرف_نوع,
    النطاق: نطاق
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق معتم_خلف_مؤشر(الأنواع, نوع_المؤشر) مع
    | اختياري.موجود(المعتم) -> {
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
            النطاق, صنف_استعمال_معتم.فك(), المعتم
        ));
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف خطأ_نوع_موجود_غير_مناسب(
    النطاق: نطاق,
    السياق: سياق_عدم_توافق_نوع,
    الموجود: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
        النطاق, السياق, اختياري.لا_شيء(), اختياري.موجود(الموجود)
    ));
}

// `&&` and `||`: points at the first operand that is not bool.
عرف خطأ_طرف_عامل_منطقي(
    الأنواع: &متغير سجل_أنواع,
    اليسار: &تعبير,
    نوع_اليسار: معرف_نوع,
    اليمين: &تعبير,
    نوع_اليمين: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    دع نوع_المنطقي: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
    إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_اليسار)) {
        أرجع خطأ_أنواع_غير_متوافقة(
            نطاق_تعبير(اليسار), سياق_عدم_توافق_نوع.عامل_يتطلب_منطقيا(),
            نوع_المنطقي, نوع_اليسار
        );
    };
    أرجع خطأ_أنواع_غير_متوافقة(
        نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.عامل_يتطلب_منطقيا(),
        نوع_المنطقي, نوع_اليمين
    );
}

عرف هل_نوع_عددي_للعامل(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    أرجع هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع) || هل_نوع_عشري_دلالي(الأنواع, النوع);
}

// Arithmetic and bitwise operators: a non-numeric operand first, then
// operands of different Types, then a float operand of an integer-only operator.
عرف خطأ_طرف_عامل_عددي(
    الأنواع: &متغير سجل_أنواع,
    التعبير: &تعبير,
    اليسار: &تعبير,
    نوع_اليسار: معرف_نوع,
    اليمين: &تعبير,
    نوع_اليمين: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    إذا (!هل_نوع_عددي_للعامل(الأنواع, نوع_اليسار)) {
        أرجع خطأ_نوع_موجود_غير_مناسب(
            نطاق_تعبير(اليسار), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا(), نوع_اليسار
        );
    };
    إذا (!هل_نوع_عددي_للعامل(الأنواع, نوع_اليمين)) {
        أرجع خطأ_نوع_موجود_غير_مناسب(
            نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا(), نوع_اليمين
        );
    };
    إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) {
        أرجع خطأ_أنواع_غير_متوافقة(
            نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(),
            نوع_اليسار, نوع_اليمين
        );
    };
    أرجع خطأ_نوع_موجود_غير_مناسب(
        نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا_صحيحا(), نوع_اليسار
    );
}

عرف نوع_بدائي_للخط(
    الأنواع: &متغير سجل_أنواع,
    البدائي: نوع_بدائي_مقنن
): معرف_نوع {
    أرجع قنن_نوعا_بدائيا(الأنواع, البدائي);
}

عرف ابن_أنواع_استدعاء_بدائي_مقننة(
    الأنواع: &متغير سجل_أنواع
): أنواع_استدعاء_بدائي_مقننة {
    دع النص: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
    دع العدد: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.عدد());
    دع عدد_ط32: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ط32());
    دع عدد_ط64: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ط64());
    دع عائم_ع32: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ع32());
    دع عائم_ع64: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ع64());
    دع عدد_طبيعي: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.طبيعي());
    دع القيم: أنواع_استدعاء_بدائي_مقننة = {
        النص: النص,
        العدد: العدد,
        عدد_ط32: عدد_ط32,
        عدد_ط64: عدد_ط64,
        عائم_ع32: عائم_ع32,
        عائم_ع64: عائم_ع64,
        عدد_طبيعي: عدد_طبيعي
    };
    أرجع القيم;
}

عرف نوع_حرفي_داخلي(
    الأنواع: &متغير سجل_أنواع,
    الحرفي: &حرفي
): معرف_نوع {
    دع القيمة: حرفي = *الحرفي;
    طابق القيمة مع
    | حرفي.منطقي(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
    }
    | حرفي.عدد(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.عدد());
    }
    | حرفي.عدد_طبيعي(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ط64());
    }
    | حرفي.عدد_عشري(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ع64());
    }
    | حرفي.حرف(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.حرف());
    }
    | حرفي.نص(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
    }
    | حرفي.غير_معرف -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.أي());
    };
}

عرف نوع_فك_داخلي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.مرجع(الداخل, _) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف نوع_عنصر_فهرسة_داخلي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.متجه(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.نص) -> {
            أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط8());
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف سجل_نوع_تعبير_داخلي(
    الأنواع: &سجل_أنواع,
    السياق: &متغير سياق_أنواع_تعبيرات,
    التعبير: &تعبير,
    النوع: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    إذا (!أضف_نوع_تعبير(الأنواع, السياق, نطاق_تعبير(التعبير), النوع)) {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير())
        );
    };
    أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع);
}

نوع قيمة_عدد_صحيح_سياقية =
    | موقع بنوع عدد
    | طبيعي بنوع طبيعي
;

عرف قيمة_عدد_صحيح_سياقية_لتعبير(التعبير: &تعبير): اختياري قيمة_عدد_صحيح_سياقية {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, حرفي.عدد(العدد)) -> {
        أرجع اختياري.موجود(قيمة_عدد_صحيح_سياقية.موقع(العدد));
    }
    | تعبير.حرفي(_, حرفي.عدد_طبيعي(العدد)) -> {
        أرجع اختياري.موجود(قيمة_عدد_صحيح_سياقية.طبيعي(العدد));
    }
    | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الداخل) مع
        | اختياري.موجود(القيمة_السياقية) -> {
            طابق القيمة_السياقية مع
            | قيمة_عدد_صحيح_سياقية.موقع(العدد) -> {
                // -(-MIN) has no signed value: negating the minimum would
                // overflow here, in the checker. It is no contextual
                // literal, so it gets its ordinary range check instead.
                إذا (العدد == (-9223372036854775807 - 1)) { أرجع اختياري.لا_شيء(); };
                أرجع اختياري.موجود(قيمة_عدد_صحيح_سياقية.موقع(0 - العدد));
            }
            | قيمة_عدد_صحيح_سياقية.طبيعي(_) -> {
                أرجع اختياري.لا_شيء();
            };
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف سجل_نوع_عدد_صحيح_سياقي(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    التعبير: &تعبير,
    النوع: معرف_نوع
): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, حرفي.عدد(_)) -> {
        أرجع أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع);
    }
    | تعبير.حرفي(_, حرفي.عدد_طبيعي(_)) -> {
        أرجع أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع);
    }
    | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        إذا (!سجل_نوع_عدد_صحيح_سياقي(الأنواع, أنواع_التعبيرات, &الداخل, النوع)) {
            أرجع خطأ;
        };
        أرجع أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع);
    }
    | _ -> {
        أرجع خطأ;
    };
}

نوع موضع_توقع_نوع =
    | مفهرس بنوع طبيعي
    | بدائي بنوع (هوية_بدائي_مترجم, طبيعي)
    | إرجاع
    // A declared or assigned destination: let, :=, record field, tuple,
    // vector or box element.
    | تهيئة
    // An operand typed against the other operand or the operator's result.
    | طرف_عامل
;

عرف هل_موضع_حجة(الموضع: موضع_توقع_نوع): منطقي {
    طابق الموضع مع
    | موضع_توقع_نوع.مفهرس(_) -> { أرجع صواب; }
    | موضع_توقع_نوع.بدائي(_, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف خطأ_عدم_توافق_نوع_متوقع(
    الموضع: موضع_توقع_نوع,
    النطاق: نطاق,
    المتوقع: معرف_نوع,
    الموجود: معرف_نوع
): خطأ_بناء_سياقات_أنواع {
    طابق الموضع مع
    | موضع_توقع_نوع.مفهرس(الفهرس) -> {
        أرجع خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
            النطاق, الفهرس, المتوقع, الموجود
        );
    }
    | موضع_توقع_نوع.بدائي(البدائي, الفهرس) -> {
        أرجع خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_مطابق(
            النطاق, البدائي, الفهرس, المتوقع, الموجود
        );
    }
    | موضع_توقع_نوع.إرجاع -> {
        أرجع خطأ_بناء_سياقات_أنواع.نوع_إرجاع_غير_مطابق(
            النطاق, المتوقع, الموجود
        );
    }
    | موضع_توقع_نوع.تهيئة -> {
        أرجع خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            النطاق, سياق_عدم_توافق_نوع.قيمة_لا_تطابق_الوجهة(),
            اختياري.موجود(المتوقع), اختياري.موجود(الموجود)
        );
    }
    | موضع_توقع_نوع.طرف_عامل -> {
        أرجع خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            النطاق, سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(),
            اختياري.موجود(المتوقع), اختياري.موجود(الموجود)
        );
    };
}

// An unsigned integer Type (طبيعي, ط8 … ط64).
عرف هل_نوع_عدد_طبيعي_دلالي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المرجع) -> {
        طابق (*الأنواع).الأنواع[المرجع.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عدد_صحيح_طبيعي();
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_نوع_عدد_صحيح_سياقي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(مرجع_النوع_12) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_12.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
        طابق صنف_النوع_البدائي(البدائي) مع
        | صنف_نوع_بدائي.عدد_موقع -> {
            أرجع صواب;
        }
        | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
        | _ -> {
        أرجع خطأ;
    };
    };
}

عرف هل_نوع_عشري_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(مرجع_النوع_13) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_13.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
        أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري();
    }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_عامل_ثنائي_ينتج_عشريا(العامل: عامل_ثنائي): منطقي {
    طابق العامل مع
    | عامل_ثنائي.جمع -> { أرجع صواب; }
    | عامل_ثنائي.طرح -> { أرجع صواب; }
    | عامل_ثنائي.ضرب -> { أرجع صواب; }
    | عامل_ثنائي.قسمة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_عشري_سياقي(التعبير: &تعبير): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, حرفي.عدد_عشري(_)) -> { أرجع صواب; }
    | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        أرجع هل_تعبير_عشري_سياقي(&الداخل);
    }
    | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
        إذا (!هل_عامل_ثنائي_ينتج_عشريا(العامل)) { أرجع خطأ; };
        دع اليسار: تعبير = *اليسار_المملوك;
        دع اليمين: تعبير = *اليمين_المملوك;
        أرجع هل_تعبير_عشري_سياقي(&اليسار) && هل_تعبير_عشري_سياقي(&اليمين);
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_نوع_منطقي_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(مرجع_النوع_14) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_14.القيمة] مع
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.منطقي) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_نوع_فراغ_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(مرجع_النوع_15) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_15.القيمة] مع
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.فراغ) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_نوع_مغلف_بمتغير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    إذا ((النوع.القيمة مثل طبيعي) >= (الطول((*الأنواع).الأنواع) مثل طبيعي)) { أرجع خطأ; };
    دع مرجع_النوع: &نوع_مقنن = &(*الأنواع).الأنواع[النوع.القيمة];
    طابق *مرجع_النوع مع
    | نوع_مقنن.متغير(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف هل_تعبير_موضع_دلالي(التعبير: &تعبير): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, _) -> { أرجع صواب; }
    | تعبير.حقل(_, _, _) -> { أرجع صواب; }
    | تعبير.فهرس(_, _, _) -> { أرجع صواب; }
    | تعبير.فك_موضع(_, _) -> { أرجع صواب; }
    | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_فهرسة_دلالي(التعبير: &تعبير): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.فهرس(_, _, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether a record value is stored directly (not behind a reference,
// pointer or box, and not wrapped as mutable).
عرف هل_سجل_مباشر_غير_متغير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    إذا (هل_نوع_مغلف_بمتغير(الأنواع, النوع)) { أرجع خطأ; };
    إذا ((النوع.القيمة مثل طبيعي) >= (الطول((*الأنواع).الأنواع) مثل طبيعي)) { أرجع خطأ; };
    طابق (*الأنواع).الأنواع[النوع.القيمة] مع
    | نوع_مقنن.مسمى(_, شكل_نوع_مسمى.سجل, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// `a.b := v` where every step is a record stored in place and the root `a`
// is a local or parameter declared without `mutable`.
عرف هل_حقل_جذره_غير_قابل_للتغيير(
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حقل(_, الأساس_المملوك, _) -> {
        دع الأساس: تعبير = *الأساس_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختياري.موجود(نوع_الأساس) -> {
            إذا (!هل_سجل_مباشر_غير_متغير(الأنواع, نوع_الأساس)) { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
        طابق الأساس مع
        | تعبير.اسم(_, _) -> { أرجع صواب; }
        | تعبير.حقل(_, _, _) -> {
            أرجع هل_حقل_جذره_غير_قابل_للتغيير(&الأساس, الأنواع, أنواع_التعبيرات);
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_موضع_قابل_للتغيير(
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, _) -> {
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير)) مع
        | اختياري.موجود(النوع) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, النوع); }
        | _ -> { أرجع خطأ; };
    }
    | تعبير.حقل(_, الأساس_المملوك, _) -> {
        دع الأساس: تعبير = *الأساس_المملوك;
        أرجع هل_موضع_قابل_للتغيير(&الأساس, الأنواع, أنواع_التعبيرات);
    }
    | تعبير.فهرس(_, الأساس_المملوك, _) -> {
        دع الأساس: تعبير = *الأساس_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختياري.موجود(نوع_الأساس) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, نوع_الأساس) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(مرجع_النوع_16) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_16.القيمة] مع
                | نوع_مقنن.بدائي(نوع_بدائي_مقنن.نص) -> { أرجع خطأ; }
                | _ -> { };
            };
        }
        | _ -> { أرجع خطأ; };
        إذا (هل_موضع_قابل_للتغيير(&الأساس, الأنواع, أنواع_التعبيرات)) { أرجع صواب; };
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختياري.موجود(نوع_الأساس) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, نوع_الأساس) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_17) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_17.القيمة] مع
                | نوع_مقنن.مؤشر(الداخل) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, الداخل); }
                | _ -> { أرجع خطأ; };
            };
        }
        | _ -> { أرجع خطأ; };
    }
    | تعبير.فك_موضع(_, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الداخل)) مع
        | اختياري.موجود(نوع_الداخل) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, نوع_الداخل) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_18) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_18.القيمة] مع
                | نوع_مقنن.مرجع(_, متغير_المرجع) -> { أرجع متغير_المرجع; }
                | نوع_مقنن.مؤشر(نوع_العنصر) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_العنصر); }
                | نوع_مقنن.صندوق(نوع_الصندوق) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_الصندوق); }
                | _ -> { أرجع خطأ; };
            };
        }
        | _ -> { أرجع خطأ; };
    }
    | تعبير.أحادي(_, عامل_أحادي.فك, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الداخل)) مع
        | اختياري.موجود(نوع_الداخل) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, نوع_الداخل) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_19) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_19.القيمة] مع
                | نوع_مقنن.مرجع(_, متغير_المرجع) -> { أرجع متغير_المرجع; }
                | نوع_مقنن.مؤشر(نوع_العنصر) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_العنصر); }
                | نوع_مقنن.صندوق(نوع_الصندوق) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_الصندوق); }
                | _ -> { أرجع خطأ; };
            };
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل: عامل_ثنائي): منطقي {
    طابق العامل مع
    | عامل_ثنائي.أو_بتي -> { أرجع صواب; }
    | عامل_ثنائي.أو_حصري -> { أرجع صواب; }
    | عامل_ثنائي.و_بتي -> { أرجع صواب; }
    | عامل_ثنائي.إزاحة_يسرى -> { أرجع صواب; }
    | عامل_ثنائي.إزاحة_يمنى -> { أرجع صواب; }
    | عامل_ثنائي.إزاحة_حسابية_يمنى -> { أرجع صواب; }
    | عامل_ثنائي.جمع -> { أرجع صواب; }
    | عامل_ثنائي.طرح -> { أرجع صواب; }
    | عامل_ثنائي.ضرب -> { أرجع صواب; }
    | عامل_ثنائي.قسمة -> { أرجع صواب; }
    | عامل_ثنائي.باقي -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف انسخ_تعبير_سياقي_عند(القيم: &متجه تعبير, الموضع: طبيعي): تعبير {
    دع المرجع: &تعبير = &(*القيم)[الموضع];
    أرجع انسخ_مملوكا_تعبير(المرجع);
}

عرف هل_تعبير_عدد_صحيح_سياقي(التعبير: &تعبير): منطقي {
    دع الانتظار: متغير متجه تعبير = [];
    ألحق(الانتظار, انسخ_مملوكا_تعبير(التعبير));
    دع الموضع: متغير طبيعي = 0;

    طالما (الموضع < (الطول(الانتظار) مثل طبيعي)) {
        دع القيمة: تعبير = انسخ_تعبير_سياقي_عند(&الانتظار, الموضع);
        الموضع := الموضع + 1;
        طابق القيمة مع
        | تعبير.حرفي(_, حرفي.عدد(_)) -> { }
        | تعبير.حرفي(_, حرفي.عدد_طبيعي(_)) -> { }
        | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
            ألحق(الانتظار, *الداخل_المملوك);
        }
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            إذا (!هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل)) {
                أرجع خطأ;
            };
            ألحق(الانتظار, *اليسار_المملوك);
            ألحق(الانتظار, *اليمين_المملوك);
        }
        | _ -> {
            أرجع خطأ;
        };
    }

    أرجع صواب;
}

// Explicit type arguments of a call (`f<A, B>(..)`): each declared type
// parameter of the callee is bound to its argument, in order, ahead of
// inference from the arguments and the expected result.
عرف استبدالات_حجج_نوع_صريحة_داخلي(
    المستدعى: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة متجه ربط_استبدال_نوع, خطأ_بناء_سياقات_أنواع {
    دع الناتج: متغير متجه ربط_استبدال_نوع = [];
    طابق *المستدعى مع
    | تعبير.حجج_نوع(النطاق, الداخل, الحجج) -> {
        دع المعاملات: متغير متجه معرف_رمز = [];
        طابق رمز_مستدعى_محلول_للنوع(سياق_الأسماء, الروابط, &(*الداخل)) مع
        | اختياري.موجود(الرمز) -> {
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول((*أنواع_الرموز).معاملات_الدوال) مثل طبيعي)) {
                إذا ((*أنواع_الرموز).معاملات_الدوال[م].الرمز.القيمة == الرمز.القيمة) {
                    المعاملات := انسخ_مملوكا_متجه_معرف_رمز(&(*أنواع_الرموز).معاملات_الدوال[م].المعاملات);
                };
                م := م + 1;
            }
        }
        | اختياري.لا_شيء -> { };
        إذا (الطول(المعاملات) != الطول(الحجج)) {
            أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                النطاق, الطول(المعاملات) مثل طبيعي, الطول(الحجج) مثل طبيعي
            ));
        };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الحجج[ف]) مع
            | نتيجة_حل_نوع.موجود(النوع) -> {
                طابق خطأ_معتم_في_حجة_نوع(الأنواع, النوع, نطاق_نوع_تركيبي_داخلي(&الحجج[ف])) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة.خطأ(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                دع الربط: ربط_استبدال_نوع = { المعامل: المعاملات[ف], الحجة: النوع };
                ألحق(الناتج, الربط);
            }
            | _ -> {
                أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&الحجج[ف])));
            };
            ف := ف + 1;
        }
    }
    | _ -> { };
    أرجع نتيجة.نجح(الناتج);
}

عرف رمز_مستدعى_محلول_للنوع(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    المستدعى: &تعبير
): اختياري معرف_رمز {
    دع القيمة: تعبير = *المستدعى;
    دع الرمز: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> {
        الرمز := رمز_اسم_محلول_عند(الروابط, الاسم.النطاق);
    }
    | تعبير.حقل(_, _, الاسم) -> {
        الرمز := رمز_اسم_محلول_عند(الروابط, الاسم.النطاق);
    }
    | _ -> { };
    طابق الرمز مع
    | اختياري.موجود(المعرف) -> {
        طابق نوع_رمز_عند(سياق_الأسماء, المعرف) مع
        | اختياري.موجود(نوع_تصريح.دالة) -> { أرجع اختياري.موجود(المعرف); }
        | اختياري.موجود(نوع_تصريح.دالة_خارجية) -> { أرجع اختياري.موجود(المعرف); }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عرف ابن_نوع_استدعاء_عادي_بتوقع_داخلي(
    التعبير: &تعبير,
    المستدعى_المكتوب: &تعبير,
    الحجج: &متجه تعبير,
    النوع_المتوقع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    دع المستدعى_الفعلي: تعبير = مستدعى_بلا_حجج_نوع(المستدعى_المكتوب);
    دع المستدعى: &تعبير = &المستدعى_الفعلي;
    دع الاستبدالات_الصريحة: متغير متجه ربط_استبدال_نوع = [];
    طابق استبدالات_حجج_نوع_صريحة_داخلي(
        المستدعى_المكتوب, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
    | نتيجة.نجح(القيم) -> { الاستبدالات_الصريحة := القيم; };
    دع نوع_المستدعى: متغير معرف_نوع = معرف_نوع_من(0);
    طابق ابن_نوع_تعبير_داخلي(
        المستدعى, سياق_الأسماء, الأنواع,
        أنواع_التعبيرات, الروابط, أنواع_الرموز
    ) مع
    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
    }
    | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
        نوع_المستدعى := النوع;
    };

    دع الاستبدالات_الأولية: متجه ربط_استبدال_نوع = استنتج_استبدالات_ناتج_استدعاء(
        الأنواع, نوع_المستدعى, النوع_المتوقع
    );
    دع الاستبدالات_الحالية: متغير متجه ربط_استبدال_نوع = الاستبدالات_الصريحة;
    دع ص: متغير طبيعي = 0;
    طالما (ص < (الطول(الاستبدالات_الأولية) مثل طبيعي)) {
        ألحق(الاستبدالات_الحالية, الاستبدالات_الأولية[ص]);
        ص := ص + 1;
    }
    دع يسمح_بمؤقت: منطقي = يسمح_بعنوان_مؤقت_داخلي(الأنواع, نوع_المستدعى);
    دع أنواع_الحجج: متغير متجه معرف_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحجج) مثل طبيعي)) {
        دع نتيجة_الحجة: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&(*الحجج)[ف]), ثابت_أنواع_مكسور.حجة_بلا_نوع())
        );
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
        | اختياري.موجود(المتوقع_الخام) -> {
            دع المتوقع: معرف_نوع = استبدل_نوعا(
                الأنواع, المتوقع_الخام, &الاستبدالات_الحالية
            );
            دع توقع_الحجة: متغير اختياري معرف_نوع = اختياري.موجود(المتوقع);
            إذا (هل_نوع_يحوي_معامل_نوع(الأنواع, المتوقع)) { توقع_الحجة := اختياري.لا_شيء(); };
            نتيجة_الحجة := ابن_نوع_حجة_داخلي(
                &(*الحجج)[ف], توقع_الحجة, ف, يسمح_بمؤقت, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        }
        | اختياري.لا_شيء -> {
            دع بلا_توقع: اختياري معرف_نوع = اختياري.لا_شيء();
            نتيجة_الحجة := ابن_نوع_حجة_داخلي(
                &(*الحجج)[ف], بلا_توقع, ف, يسمح_بمؤقت, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        };
        طابق نتيجة_الحجة مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            ألحق(أنواع_الحجج, النوع);
            طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
            | اختياري.موجود(المتوقع_الخام) -> {
                إذا (!أضف_استبدالات_من_معامل_استدعاء(
                    الأنواع, المتوقع_الخام, النوع, &متغير الاستبدالات_الحالية
                )) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                            نطاق_تعبير(&(*الحجج)[ف]), ف, المتوقع_الخام, النوع
                        )
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }

    طابق تحقق_توقيع_استدعاء_باستبدالات(
        الأنواع, نوع_المستدعى, &أنواع_الحجج, &الاستبدالات_الحالية
    ) مع
    | نتيجة_توقيع_استدعاء.صالح(الناتج, استبدالات_النوع) -> {
        طابق خطأ_معتم_في_توقيع_مثيل(
            الأنواع, سياق_الأسماء, نوع_المستدعى, &استبدالات_النوع,
            رمز_مستدعى_محلول_للنوع(سياق_الأسماء, الروابط, المستدعى), نطاق_تعبير(التعبير)
        ) مع
        | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
        | اختياري.لا_شيء -> { };
        دع نطاقات_الحجج: متغير متجه نطاق = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(*الحجج) مثل طبيعي)) {
            ألحق(نطاقات_الحجج, نطاق_تعبير(&(*الحجج)[ح]));
            ح := ح + 1;
        }
        دع رمز_الاستدعاء: اختياري معرف_رمز = رمز_مستدعى_محلول_للنوع(
            سياق_الأسماء, الروابط, المستدعى
        );
        أضف_استدعاء_نوعيا(
            أنواع_التعبيرات, نطاق_تعبير(التعبير), نوع_المستدعى,
            رمز_الاستدعاء, نطاقات_الحجج, استبدالات_النوع
        );
        أرجع سجل_نوع_تعبير_داخلي(
            الأنواع, أنواع_التعبيرات, التعبير, الناتج
        );
    }
    | نتيجة_توقيع_استدعاء.مرفوض(خطأ_التوقيع) -> {
        طابق خطأ_التوقيع مع
        | خطأ_توقيع_استدعاء.غير_قابل_للاستدعاء -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(
                    نطاق_تعبير(التعبير), نوع_المستدعى
                )
            );
        }
        | خطأ_توقيع_استدعاء.عدد_حجج_غير_مطابق(المتوقع, الموجود) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                    نطاق_تعبير(التعبير), المتوقع, الموجود
                )
            );
        }
        | خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                    نطاق_تعبير(&(*الحجج)[الفهرس]), الفهرس, المتوقع, الموجود
                )
            );
        };
    };
}

// Null-pointer literal is a contextual, unbound name occurrence, never a
// reserved keyword. Existing declarations named الفارغ retain their identity.
عرف هل_مؤشر_فارغ_سياقي(
    التعبير: &تعبير, الروابط: &سياق_روابط_أسماء
): منطقي {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        أرجع هل_ظهور_مؤشر_فارغ_سياقي(الروابط, الاسم.النطاق);
    }
    | _ -> { أرجع خطأ; };
}

// Types the elements of a vector literal expression from البداية on against
// نوع_العنصر and records نوع_المتجه as the literal's Type.
عرف ابن_نوع_حرفي_متجه_داخلي(
    التعبير: &تعبير,
    نوع_المتجه: معرف_نوع,
    نوع_العنصر: معرف_نوع,
    البداية: طبيعي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    طابق *التعبير مع
    | تعبير.حرفي_متجه(_, العناصر) -> {
        دع ع: متغير طبيعي = البداية;
        طالما (ع < (الطول(العناصر) مثل طبيعي)) {
            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                &العناصر[ع], نوع_العنصر, موضع_توقع_نوع.تهيئة(), سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | _ -> { };
            ع := ع + 1;
        }
    }
    | _ -> { };
    أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_المتجه);
}

// Whether values of النوع can hold no reference, raw pointer, slice or
// closure: a borrow passed into a call cannot come back out in its result.
// المزارة breaks cycles through recursive named Types.
عرف هل_نوع_خال_من_المراجع_داخلي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المزارة: &متغير متجه معرف_نوع
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المزارة) مثل طبيعي)) {
        إذا ((*المزارة)[ف].القيمة == النوع.القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    ألحق((*المزارة), النوع);
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.بدائي(_) -> { أرجع صواب; }
        | نوع_مقنن.صف(العناصر) -> {
            دع ع: متغير طبيعي = 0;
            طالما (ع < (الطول(العناصر) مثل طبيعي)) {
                إذا (!هل_نوع_خال_من_المراجع_داخلي(الأنواع, العناصر[ع], المزارة)) { أرجع خطأ; };
                ع := ع + 1;
            }
            أرجع صواب;
        }
        | نوع_مقنن.صندوق(الداخل) -> { أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, الداخل, المزارة); }
        | نوع_مقنن.اختيار(الداخل) -> { أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, الداخل, المزارة); }
        | نوع_مقنن.متجه(الداخل) -> { أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, الداخل, المزارة); }
        | نوع_مقنن.متغير(الداخل) -> { أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, الداخل, المزارة); }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            إذا (!هل_نوع_خال_من_المراجع_داخلي(الأنواع, أ, المزارة)) { أرجع خطأ; };
            أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, ب, المزارة);
        }
        | نوع_مقنن.مسمى(_, _, _) -> {
            طابق عدد_حقول_سجل_دلالي(الأنواع, الأساس) مع
            | اختياري.موجود(عدد_الحقول) -> {
                دع ح: متغير طبيعي = 0;
                طالما (ح < عدد_الحقول) {
                    طابق نوع_حقل_سجل_دلالي_عند(الأنواع, الأساس, ح) مع
                    | اختياري.موجود(نوع_الحقل) -> {
                        إذا (!هل_نوع_خال_من_المراجع_داخلي(الأنواع, نوع_الحقل, المزارة)) { أرجع خطأ; };
                    }
                    | اختياري.لا_شيء -> { أرجع خطأ; };
                    ح := ح + 1;
                }
                أرجع صواب;
            }
            | اختياري.لا_شيء -> { };
            طابق عدد_منشئات_نوع_دلالي(الأنواع, الأساس) مع
            | اختياري.موجود(عدد_المنشئات) -> {
                دع م: متغير طبيعي = 0;
                طالما (م < عدد_المنشئات) {
                    دع عدد_الحمولات: متغير طبيعي = 0;
                    طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, الأساس, م) مع
                    | اختياري.موجود(العدد) -> { عدد_الحمولات := العدد; }
                    | اختياري.لا_شيء -> { أرجع خطأ; };
                    دع ح: متغير طبيعي = 0;
                    طالما (ح < عدد_الحمولات) {
                        طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, الأساس, م, ح) مع
                        | اختياري.موجود(نوع_الحمولة) -> {
                            إذا (!هل_نوع_خال_من_المراجع_داخلي(الأنواع, نوع_الحمولة, المزارة)) { أرجع خطأ; };
                        }
                        | اختياري.لا_شيء -> { أرجع خطأ; };
                        ح := ح + 1;
                    }
                    م := م + 1;
                }
                أرجع صواب;
            }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}

// Whether a call through نوع_المستدعى may take `&e` of a value that is not a
// place (a literal, a call result): the temporary lives to the end of the
// enclosing block, and a result that can hold no reference cannot carry the
// borrow past it.
عرف يسمح_بعنوان_مؤقت_داخلي(الأنواع: &سجل_أنواع, نوع_المستدعى: معرف_نوع): منطقي {
    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_المستدعى) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الناتج) -> {
        دع المزارة: متغير متجه معرف_نوع = [];
        أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, الناتج, &متغير المزارة);
    };
}

عرف هل_عنوان_مؤقت_دلالي(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.أحادي(_, العامل, الداخل) -> {
        إذا (العامل != عامل_أحادي.عنوان()) { أرجع خطأ; };
        أرجع !هل_تعبير_موضع_دلالي(&(*الداخل));
    }
    | _ -> { أرجع خطأ; };
}

// Types `&e` of a temporary as a call argument: e is typed against the
// referenced Type of a shared-reference expectation (or on its own) and the
// argument has Type `&T`.
عرف ابن_نوع_عنوان_مؤقت_داخلي(
    التعبير: &تعبير,
    المتوقع: اختياري معرف_نوع,
    الموضع: موضع_توقع_نوع,
    يسمح: منطقي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    طابق *التعبير مع
    | تعبير.أحادي(_, _, الداخل_المملوك) -> {
        دع الداخل: &تعبير = &(*الداخل_المملوك);
        إذا (!يسمح) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(الداخل)));
        };
        دع نوع_الهدف: متغير اختياري معرف_نوع = اختياري.لا_شيء();
        طابق المتوقع مع
        | اختياري.موجود(م) -> { نوع_الهدف := نوع_داخل_مرجع_دلالي(الأنواع, م); }
        | اختياري.لا_شيء -> { };
        دع نتيجة_الداخل: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(الداخل))
        );
        طابق نوع_الهدف مع
        | اختياري.موجود(الهدف) -> {
            نتيجة_الداخل := ابن_نوع_تعبير_بتوقع_داخلي(
                الداخل, الهدف, موضع_توقع_نوع.تهيئة(), سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        }
        | اختياري.لا_شيء -> {
            نتيجة_الداخل := ابن_نوع_تعبير_داخلي(
                الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        };
        طابق نتيجة_الداخل مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الداخل) -> {
            دع نوع_المرجع_الأساس: متغير معرف_نوع = نوع_الداخل;
            طابق أزل_غلاف_متغير(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(الأساس) -> { نوع_المرجع_الأساس := الأساس; }
            | اختياري.لا_شيء -> { };
            دع نوع_المرجع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_المرجع_الأساس, خطأ));
            طابق المتوقع مع
            | اختياري.موجود(م) -> {
                إذا (!نوعان_متوافقان(الأنواع, م, نوع_المرجع)) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_عدم_توافق_نوع_متوقع(الموضع, نطاق_تعبير(التعبير), م, نوع_المرجع)
                    );
                };
            }
            | اختياري.لا_شيء -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_المرجع);
        };
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(التعبير)));
}

// A call argument typed against its parameter, or on its own when the
// parameter's Type is still generic (المتوقع none).
عرف ابن_نوع_حجة_داخلي(
    الحجة: &تعبير,
    المتوقع: اختياري معرف_نوع,
    الفهرس: طبيعي,
    يسمح_بمؤقت: منطقي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    إذا (هل_عنوان_مؤقت_دلالي(الحجة)) {
        أرجع ابن_نوع_عنوان_مؤقت_داخلي(
            الحجة, المتوقع, موضع_توقع_نوع.مفهرس(الفهرس), يسمح_بمؤقت, سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    };
    طابق المتوقع مع
    | اختياري.موجود(م) -> {
        أرجع ابن_نوع_تعبير_بتوقع_داخلي(
            الحجة, م, موضع_توقع_نوع.مفهرس(الفهرس), سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    }
    | اختياري.لا_شيء -> {
        أرجع ابن_نوع_تعبير_داخلي(
            الحجة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    };
}

// Types a record literal's fields against the record Type نوع_الوجهة: each
// field is known, written once, and typed against its declared Type; none
// is left out. Shared by `let r: T = {..};` and the record literal expression.
عرف افحص_حقول_سجل_داخلي(
    نطاق_الوجهة: نطاق,
    نوع_الوجهة: معرف_نوع,
    الحقول: &متجه حقل_تهيئة,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    دع عدد_الحقول_المتوقع: متغير طبيعي = 0;
    طابق عدد_حقول_سجل_دلالي(الأنواع, نوع_الوجهة) مع
    | اختياري.موجود(المتوقع) -> { عدد_الحقول_المتوقع := المتوقع; }
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            نطاق_الوجهة, سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
            اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
        ));
    };
    دع هويات_الحقول: متغير متجه معرف_اسم = [];
    دع نطاقات_الحقول: متغير متجه نطاق = [];
    دع ح: متغير طبيعي = 0;
    طالما (ح < (الطول(*الحقول) مثل طبيعي)) {
        دع نوع_الحقل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق هوية_اسم_مطلوبة_للنوع(الروابط, &(*الحقول)[ح].الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(هوية_الحقل) -> {
            دع هـ: متغير طبيعي = 0;
            طالما (هـ < (الطول(هويات_الحقول) مثل طبيعي)) {
                إذا (معرفا_اسم_متساويان(هويات_الحقول[هـ], هوية_الحقل)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.حقل_سجل_مكرر(
                        (*الحقول)[ح].الاسم.النطاق, نطاقات_الحقول[هـ]
                    ));
                };
                هـ := هـ + 1;
            }
            ألحق(هويات_الحقول, هوية_الحقل);
            ألحق(نطاقات_الحقول, (*الحقول)[ح].الاسم.النطاق);
            طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, نوع_الوجهة, هوية_الحقل) مع
            | اختياري.موجود(النوع) -> {
                نوع_الحقل := النوع;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(
                    خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف((*الحقول)[ح].الاسم.النطاق)
                );
            };
        };
        طابق ابن_نوع_تعبير_متوقع_داخلي(
            &(*الحقول)[ح].القيمة, نوع_الحقل, ح, سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        ) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | _ -> { };
        ح := ح + 1;
    }
    // Every written field is known and distinct, so a short count
    // means a field was left out: name the first one.
    إذا ((الطول(*الحقول) مثل طبيعي) != عدد_الحقول_المتوقع) {
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.حقل_سجل_مفقود(
            نطاق_الوجهة,
            أول_حقل_سجل_مفقود(الأنواع, نوع_الوجهة, عدد_الحقول_المتوقع, &هويات_الحقول)
        ));
    };
    أرجع اختياري.لا_شيء();
}

عرف ابن_نوع_تعبير_بتوقع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    الموضع: موضع_توقع_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    // Null never acquires a reference Type. It requires an exact raw-pointer
    // expectation and is not an integer literal or a declaration.
    إذا (هل_مؤشر_فارغ_سياقي(التعبير, الروابط)) {
        طابق معرف_نوع_أساس_عند(الأنواع, النوع_المتوقع) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.فارغ_بلا_مؤشر(),
                    اختياري.موجود(النوع_المتوقع), اختياري.لا_شيء()
                )
            );
        }
        | اختياري.موجود(مرجع_النوع_20) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_20.القيمة] مع
            | نوع_مقنن.مؤشر(_) -> {
            أرجع سجل_نوع_تعبير_داخلي(
                الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع
            );
        }
            | _ -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.فارغ_بلا_مؤشر(),
                اختياري.موجود(النوع_المتوقع), اختياري.لا_شيء()
            ));
        };
        };
    };
    // A vector literal takes its element Type from a vector context, as the
    // initializer statement does; another context types it on its own and
    // the ordinary compatibility check below reports a mismatch.
    طابق *التعبير مع
    | تعبير.حرفي_متجه(_, _) -> {
        طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع_المتوقع) مع
        | اختياري.موجود(نوع_العنصر) -> {
            أرجع ابن_نوع_حرفي_متجه_داخلي(
                التعبير, النوع_المتوقع, نوع_العنصر, 0, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        }
        | اختياري.لا_شيء -> { };
    }
    // A record literal takes its Type from a record context; any other
    // context has no Type to give it.
    | تعبير.حرفي_سجل(النطاق, الحقول) -> {
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع_المتوقع) مع
        | اختياري.موجود(_) -> {
            طابق افحص_حقول_سجل_داخلي(
                النطاق, النوع_المتوقع, &الحقول, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                النطاق, سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                اختياري.موجود(النوع_المتوقع), اختياري.لا_شيء()
            ));
        };
    }
    | _ -> { };
    // Option/Result constructors are context-typed. Name records their source identities
    // without inventing Symbols; Type resolves them against the expected tagged Type.
    دع قيمة_متوقعة: تعبير = *التعبير;
    طابق قيمة_متوقعة مع
    | تعبير.استدعاء(_, المستدعى_المملوك, الحجج_المضمنة) -> {
        دع المستدعى_المضمن: تعبير = *المستدعى_المملوك;
        طابق المستدعى_المضمن مع
        | تعبير.حقل(_, الأصل_المملوك, اسم_المنشئ) -> {
            دع الأصل_المضمن: تعبير = *الأصل_المملوك;
            طابق الأصل_المضمن مع
            | تعبير.اسم(_, اسم_النوع) -> {
                طابق معرف_اسم_محلول_عند(الروابط, اسم_النوع.النطاق) مع
                    | اختياري.موجود(هوية_اسم_النوع) -> {
                        طابق معرف_اسم_محلول_عند(الروابط, اسم_المنشئ.النطاق) مع
                        | اختياري.موجود(هوية_اسم_المنشئ) -> {
                            طابق هوية_منشئ_مسمى_للنوع(
                                &اسم_النوع, &اسم_المنشئ, النوع_المتوقع,
                                سياق_الأسماء, الأنواع, الروابط
                            ) مع
                            | اختياري.موجود(هوية_المنشئ) -> {
                                طابق وصف_منشئ_نوع_دلالي_بالهوية(
                                    الأنواع, النوع_المتوقع, هوية_المنشئ
                                ) مع
                                | اختياري.موجود(الوصف) -> {
                                    دع عدد_الحجج: طبيعي = الطول(الحجج_المضمنة) مثل طبيعي;
                                    إذا (عدد_الحجج != الوصف.عدد_الحمولات) {
                                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                            خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                                                نطاق_تعبير(التعبير), الوصف.عدد_الحمولات, عدد_الحجج
                                            )
                                        );
                                    };
                                    دع ف_حمولة: متغير طبيعي = 0;
                                    طالما (ف_حمولة < الوصف.عدد_الحمولات) {
                                        طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(
                                            الأنواع, النوع_المتوقع, هوية_المنشئ, ف_حمولة
                                        ) مع
                                        | اختياري.موجود(نوع_الحمولة) -> {
                                            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                                                &الحجج_المضمنة[ف_حمولة], نوع_الحمولة,
                                                موضع_توقع_نوع.مفهرس(ف_حمولة), سياق_الأسماء,
                                                الأنواع, أنواع_التعبيرات,
                                                الروابط, أنواع_الرموز
                                            ) مع
                                            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                                                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
                                            }
                                            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                                        }
                                        | اختياري.لا_شيء -> {
                                            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                                خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                                                    نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.نوع_حمولة_منشئ()
                                                )
                                            );
                                        };
                                        ف_حمولة := ف_حمولة + 1;
                                    }
                                    إذا (!أضف_نوع_تعبير_بمنشئ(
                                        الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير),
                                        النوع_المتوقع, اسم_المنشئ.النطاق, هوية_المنشئ
                                    )) {
                                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                                                نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_منشئ()
                                            )
                                        );
                                    };
                                    أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع_المتوقع);
                                }
                                | اختياري.لا_شيء -> { };
                            }
                            | اختياري.لا_شيء -> { };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        }
        | _ -> { };
    }
    | _ -> { };

    // Ordinary generic calls may infer type parameters from the expected result Type.
    // Primitive calls retain their identity-owned semantic path below.
    دع قيمة_استدعاء_متوقعة: تعبير = *التعبير;
    طابق قيمة_استدعاء_متوقعة مع
    | تعبير.استدعاء(_, المستدعى_المملوك_المتوقع, الحجج_المتوقعة) -> {
        دع المستدعى_المتوقع: تعبير = *المستدعى_المملوك_المتوقع;
        دع استدعاء_عام: متغير منطقي = خطأ;
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&المستدعى_المتوقع)) مع
        | اختياري.موجود(رمز_المستدعى) -> {
            طابق هوية_بدائي_رمز_عند(سياق_الأسماء, رمز_المستدعى) مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> {
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, رمز_المستدعى) مع
                | اختياري.موجود(نوع_المستدعى) -> {
                    استدعاء_عام := هل_نوع_يحوي_معامل_نوع(الأنواع, نوع_المستدعى);
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        إذا (استدعاء_عام) {
            أرجع ابن_نوع_استدعاء_عادي_بتوقع_داخلي(
                التعبير, &المستدعى_المتوقع, &الحجج_المتوقعة, النوع_المتوقع,
                سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        };
    }
    | _ -> { };

    إذا (هل_نوع_عشري_دلالي(الأنواع, النوع_المتوقع) && هل_تعبير_عشري_سياقي(التعبير)) {
        دع قيمة_عشرية: تعبير = *التعبير;
        طابق قيمة_عشرية مع
        | تعبير.حرفي(_, حرفي.عدد_عشري(_)) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
            دع الداخل: تعبير = *الداخل_المملوك;
            طابق ابن_نوع_تعبير_بتوقع_داخلي(&الداخل, النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            إذا (!هل_عامل_ثنائي_ينتج_عشريا(العامل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.قيمة_لا_تطابق_الوجهة(),
                    اختياري.موجود(النوع_المتوقع), اختياري.لا_شيء()
                ));
            };
            دع اليسار: تعبير = *اليسار_المملوك;
            دع اليمين: تعبير = *اليمين_المملوك;
            طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            // The left operand has the expected Type: a right operand of another
            // Type is an operand mismatch, not a mismatch of the expectation.
            طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, النوع_المتوقع, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | _ -> { };
    };

    إذا (هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع_المتوقع)) {
        دع قيمة_التعبير: تعبير = *التعبير;
        طابق قيمة_التعبير مع
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            إذا (هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل)) {
                دع اليسار: تعبير = *اليسار_المملوك;
                دع اليمين: تعبير = *اليمين_المملوك;
                طابق ابن_نوع_تعبير_بتوقع_داخلي(
                    &اليسار, النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع,
                    أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
                }
                | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                // The left operand has the expected Type: a right operand of
                // another Type is an operand mismatch (`return a + b` with a
                // bool `b` names the operands, not the return Type).
                طابق ابن_نوع_تعبير_بتوقع_داخلي(
                    &اليمين, النوع_المتوقع, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع,
                    أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
                }
                | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                أرجع سجل_نوع_تعبير_داخلي(
                    الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع
                );
            };
        }
        | _ -> { };
    };

    طابق قيمة_عدد_صحيح_سياقية_لتعبير(التعبير) مع
    | اختياري.موجود(القيمة) -> {
        دع يلائم: متغير منطقي = خطأ;
        طابق القيمة مع
        | قيمة_عدد_صحيح_سياقية.موقع(العدد) -> {
            يلائم := هل_عدد_صحيح_يلائم(الأنواع, العدد, النوع_المتوقع);
        }
        | قيمة_عدد_صحيح_سياقية.طبيعي(العدد) -> {
            يلائم := هل_عدد_صحيح_طبيعي_يلائم(الأنواع, العدد, النوع_المتوقع);
        };
        إذا (!يلائم) {
            دع نوع_العدد: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.عدد());
            // An integer destination: the literal's value, not its kind, is
            // wrong. A call argument keeps its argument-position diagnostic.
            إذا (هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع_المتوقع) && !هل_موضع_حجة(الموضع)) {
                أرجع خطأ_أنواع_غير_متوافقة(
                    نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.عدد_حرفي_خارج_المدى(),
                    النوع_المتوقع, نوع_العدد
                );
            };
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_عدم_توافق_نوع_متوقع(
                    الموضع, نطاق_تعبير(التعبير), النوع_المتوقع, نوع_العدد
                )
            );
        };
        إذا (!سجل_نوع_عدد_صحيح_سياقي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع)) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير())
            );
        };
        أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع_المتوقع);
    }
    | اختياري.لا_شيء -> { };

    طابق ابن_نوع_تعبير_داخلي(
        التعبير, سياق_الأسماء, الأنواع,
        أنواع_التعبيرات, الروابط, أنواع_الرموز
    ) مع
    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
    }
    | نتيجة_نوع_تعبير_داخلية.موجود(النوع_الموجود) -> {
        // A vector is viewed as an expected slice, except as a returned
        // value: a function's local vector does not outlive its return.
        دع عرض_شريحة: متغير منطقي = هل_عرض_متجه_كشريحة(الأنواع, النوع_الموجود, النوع_المتوقع);
        طابق الموضع مع
        | موضع_توقع_نوع.إرجاع -> { عرض_شريحة := خطأ; }
        | _ -> { };
        إذا (!هل_تحويل_ضمني_آمن(الأنواع, النوع_الموجود, النوع_المتوقع) && !عرض_شريحة) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_عدم_توافق_نوع_متوقع(
                    الموضع, نطاق_تعبير(التعبير), النوع_المتوقع, النوع_الموجود
                )
            );
        };
        أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع_الموجود);
    };
}

عرف ابن_نوع_تعبير_متوقع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    فهرس_المصدر: طبيعي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    أرجع ابن_نوع_تعبير_بتوقع_داخلي(
        التعبير, النوع_المتوقع, موضع_توقع_نوع.تهيئة(),
        سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    );
}

عرف ابن_نوع_تعبير_إرجاع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    أرجع ابن_نوع_تعبير_بتوقع_داخلي(
        التعبير, النوع_المتوقع, موضع_توقع_نوع.إرجاع(),
        سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    );
}

عرف هل_رمز_ضمن_قائمة_إغلاق(
    الرموز: &متجه معرف_رمز,
    الرمز: معرف_رمز
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*الرموز)[ف], الرمز)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف أضف_التقاط_إغلاق(
    الالتقاطات: &متغير متجه معرف_رمز,
    الرمز: معرف_رمز
): فراغ {
    إذا (!هل_رمز_ضمن_قائمة_إغلاق(الالتقاطات, الرمز)) { ألحق(*الالتقاطات, الرمز); };
}

عرف اجمع_التقاطات_إغلاق(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    المستثناة: &متجه معرف_رمز,
    الالتقاطات: &متغير متجه معرف_رمز
): فراغ {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, _) -> { }
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            إذا (!هل_رمز_ضمن_قائمة_إغلاق(المستثناة, الرمز)) {
                طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
                | اختياري.موجود(نوع_تصريح.معامل) -> { أضف_التقاط_إغلاق(الالتقاطات, الرمز); }
                | اختياري.موجود(نوع_تصريح.ربط_محلي) -> { أضف_التقاط_إغلاق(الالتقاطات, الرمز); }
                | _ -> { };
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | تعبير.حقل(_, الأصل, _) -> {
        دع أ: تعبير = *الأصل;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        دع أ: تعبير = *الأصل; دع ب: تعبير = *الفهرس;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        اجمع_التقاطات_إغلاق(&ب, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.فك_موضع(_, الأصل) -> {
        دع أ: تعبير = *الأصل;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.ثنائي(_, _, اليسار, اليمين) -> {
        دع أ: تعبير = *اليسار; دع ب: تعبير = *اليمين;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        اجمع_التقاطات_إغلاق(&ب, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.أحادي(_, _, الأصل) -> {
        دع أ: تعبير = *الأصل;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.استدعاء(_, الدالة, الحجج) -> {
        دع د: تعبير = *الدالة;
        اجمع_التقاطات_إغلاق(&د, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&الحجج[ف], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.تحويل(_, الأصل, _) -> {
        دع أ: تعبير = *الأصل;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.وقت_الترجمة(_, المملوك) -> {
        دع الداخل: تعبير = *المملوك;
        اجمع_التقاطات_إغلاق(&الداخل, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.تسلسل_وقت_الترجمة(_, التعابير) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&التعابير[ف], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_متجه(_, التعابير) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&التعابير[ف], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&الحقول[ف].القيمة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.حجج_نوع(_, الداخل, _) -> {
        دع د: تعبير = *الداخل;
        اجمع_التقاطات_إغلاق(&د, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.إغلاق(_, المعاملات, _, الجسم) -> {
        دع مستثناة_متداخلة: متغير متجه معرف_رمز = انسخ_مملوكا_متجه_معرف_رمز(المستثناة);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
            طابق رمز_اسم_محلول_عند(الروابط, المعاملات[ف].الاسم.النطاق) مع
            | اختياري.موجود(الرمز) -> { ألحق(مستثناة_متداخلة, الرمز); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        دع ج: تعبير = *الجسم;
        اجمع_التقاطات_إغلاق(&ج, سياق_الأسماء, الروابط, &مستثناة_متداخلة, الالتقاطات);
    };
}

عرف ابن_نوع_تعبير_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, الحرفي) -> {
        دع النوع: معرف_نوع = نوع_حرفي_داخلي(الأنواع, &الحرفي);
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_مطلوب_للنوع(الروابط, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة.نجح(الرمز) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
            | اختياري.موجود(النوع) -> {
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(الرمز, الاسم.النطاق));
            };
        };
    }
    | تعبير.حقل(_, الأساس_المملوك, الاسم) -> {
        // Name decides whether this field-shaped occurrence is a constructor. Type consumes
        // that Symbol before typing the syntactic qualifier, so no spelling-based type lookup occurs.
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(رمز_العضو) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, رمز_العضو) مع
            | اختياري.موجود(نوع_العضو) -> {
                طابق نوع_رمز_عند(سياق_الأسماء, رمز_العضو) مع
                | اختياري.موجود(نوع_تصريح.منشئ_تعداد) -> {
                    دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.تعداد(رمز_العضو);
                    إذا (!أضف_نوع_تعبير_بمنشئ(
                        الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير),
                        نوع_العضو, الاسم.النطاق, الهوية
                    )) {
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_منشئ())
                        );
                    };
                    أرجع نتيجة_نوع_تعبير_داخلية.موجود(نوع_العضو);
                }
                | _ -> {
                    أرجع سجل_نوع_تعبير_داخلي(
                        الأنواع, أنواع_التعبيرات, التعبير, نوع_العضو
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        دع الأساس: تعبير = *الأساس_المملوك;
        دع نوع_الأساس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الأساس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            نوع_الأساس := النوع;
        };
        طابق هوية_اسم_مطلوبة_للنوع(الروابط, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة.نجح(هوية_الحقل) -> {
            // An opaque type has no fields, behind a pointer or not.
            دع معتم_الأساس: متغير اختياري معرف_نوع = معتم_خلف_مؤشر(الأنواع, نوع_الأساس);
            إذا (هل_نوع_معتم(الأنواع, نوع_الأساس)) { معتم_الأساس := معرف_نوع_أساس_عند(الأنواع, نوع_الأساس); };
            طابق معتم_الأساس مع
            | اختياري.موجود(المعتم) -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
                    الاسم.النطاق, صنف_استعمال_معتم.حقل(), المعتم
                ));
            }
            | اختياري.لا_شيء -> { };
            طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, نوع_الأساس, هوية_الحقل) مع
            | اختياري.موجود(نوع_الحقل) -> {
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الحقل);
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف(الاسم.النطاق)
                );
            };
        };
    }
    | تعبير.فهرس(_, الأساس_المملوك, الفهرس_المملوك) -> {
        دع الأساس: تعبير = *الأساس_المملوك;
        دع الفهرس: تعبير = *الفهرس_المملوك;
        دع نوع_الأساس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الأساس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            نوع_الأساس := النوع;
        };
        // `p[i]` steps by the element size, which an opaque type lacks.
        طابق معتم_خلف_مؤشر(الأنواع, نوع_الأساس) مع
        | اختياري.موجود(المعتم) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
                نطاق_تعبير(التعبير), صنف_استعمال_معتم.فهرسة(), المعتم
            ));
        }
        | اختياري.لا_شيء -> { };
        دع نوع_الفهرس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الفهرس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الفهرس := النوع; };
        إذا (!هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_الفهرس)) {
            أرجع خطأ_نوع_موجود_غير_مناسب(
                نطاق_تعبير(&الفهرس), سياق_عدم_توافق_نوع.فهرس_ليس_عددا_صحيحا(), نوع_الفهرس
            );
        };

        طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الأساس) مع
        | اختياري.موجود(عدد_العناصر) -> {
            طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الفهرس) مع
            | اختياري.لا_شيء -> {
                أرجع خطأ_نوع_موجود_غير_مناسب(
                    نطاق_تعبير(&الفهرس), سياق_عدم_توافق_نوع.فهرس_صف_غير_ثابت(), نوع_الأساس
                );
            }
            | اختياري.موجود(القيمة_السياقية) -> {
                دع فهرس_العنصر: متغير طبيعي = 0;
                طابق القيمة_السياقية مع
                | قيمة_عدد_صحيح_سياقية.موقع(الموضع) -> {
                    إذا (الموضع < 0) {
                        أرجع خطأ_نوع_موجود_غير_مناسب(
                            نطاق_تعبير(&الفهرس), سياق_عدم_توافق_نوع.فهرس_صف_غير_ثابت(), نوع_الأساس
                        );
                    };
                    فهرس_العنصر := الموضع مثل طبيعي;
                }
                | قيمة_عدد_صحيح_سياقية.طبيعي(الموضع) -> {
                    فهرس_العنصر := الموضع;
                };
                إذا (فهرس_العنصر >= عدد_العناصر) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.فهرس_صف_خارج_الحدود(
                            نطاق_تعبير(&الفهرس), فهرس_العنصر, عدد_العناصر
                        )
                    );
                };
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الأساس, فهرس_العنصر) مع
                | اختياري.موجود(نوع_العنصر) -> {
                    أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_العنصر);
                }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.نوع_عنصر_صف())
                    );
                };
            };
        }
        | اختياري.لا_شيء -> { };

        // A constant index into a local of known length is checked here.
        طابق طول_معروف_لتعبير(&الأساس, الروابط, أنواع_الرموز) مع
        | اختياري.موجود(الطول_المعروف) -> {
            طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الفهرس) مع
            | اختياري.موجود(القيمة_الثابتة) -> {
                دع خارج: متغير منطقي = خطأ;
                دع الموضع_الثابت: متغير طبيعي = 0;
                طابق القيمة_الثابتة مع
                | قيمة_عدد_صحيح_سياقية.طبيعي(الموضع) -> {
                    الموضع_الثابت := الموضع;
                    خارج := الموضع >= الطول_المعروف;
                }
                | قيمة_عدد_صحيح_سياقية.موقع(الموضع) -> {
                    إذا (الموضع >= 0) {
                        الموضع_الثابت := الموضع مثل طبيعي;
                        خارج := الموضع_الثابت >= الطول_المعروف;
                    };
                };
                إذا (خارج) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.فهرس_خارج_طول_معروف(
                            نطاق_تعبير(&الفهرس), الموضع_الثابت, الطول_المعروف
                        )
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };

        طابق نوع_عنصر_فهرسة_داخلي(الأنواع, نوع_الأساس) مع
        | اختياري.موجود(نوع_العنصر) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_العنصر);
        }
        | اختياري.لا_شيء -> {
            أرجع خطأ_نوع_موجود_غير_مناسب(
                نطاق_تعبير(&الأساس), سياق_عدم_توافق_نوع.نوع_غير_قابل_للفهرسة(), نوع_الأساس
            );
        };
    }
    | تعبير.فك_موضع(_, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الداخل) -> {
            طابق خطأ_فك_معتم(الأنواع, نوع_الداخل, نطاق_تعبير(التعبير)) مع
            | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
            | اختياري.لا_شيء -> { };
            طابق نوع_فك_داخلي(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(النوع) -> {
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.فك_غير_مؤشر(نطاق_تعبير(التعبير), نوع_الداخل)
                );
            };
        };
    }
    | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
        دع اليسار: تعبير = *اليسار_المملوك;
        دع اليمين: تعبير = *اليمين_المملوك;
        دع نوع_اليسار: متغير معرف_نوع = معرف_نوع_من(0);
        دع نوع_اليمين: متغير معرف_نوع = معرف_نوع_من(0);
        دع اليسار_سياقي: منطقي = هل_تعبير_عدد_صحيح_سياقي(&اليسار);
        دع اليمين_سياقي: منطقي = هل_تعبير_عدد_صحيح_سياقي(&اليمين);
        دع اليسار_عشري_سياقي: منطقي = هل_تعبير_عشري_سياقي(&اليسار);
        دع اليمين_عشري_سياقي: منطقي = هل_تعبير_عشري_سياقي(&اليمين);
        دع اليسار_فارغ: منطقي = هل_مؤشر_فارغ_سياقي(&اليسار, الروابط);
        دع اليمين_فارغ: منطقي = هل_مؤشر_فارغ_سياقي(&اليمين, الروابط);
        إذا ((اليسار_فارغ || اليمين_فارغ)
            && (العامل == عامل_ثنائي.يساوي() || العامل == عامل_ثنائي.لا_يساوي())) {
            // An unbound null needs the other's concrete raw-pointer Type.
            // Two nulls have no Type; neither reference nor integer inference is allowed.
            إذا (اليسار_فارغ && اليمين_فارغ) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.فارغ_بلا_مؤشر(),
                    اختياري.لا_شيء(), اختياري.لا_شيء()
                ));
            };
            إذا (اليسار_فارغ) {
                طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, نوع_اليمين, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, نوع_اليسار, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            };
        } وإلا إذا (اليسار_عشري_سياقي && !اليمين_عشري_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            إذا (هل_نوع_عشري_دلالي(الأنواع, نوع_اليمين)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, نوع_اليمين, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            };
        } وإلا إذا (اليمين_عشري_سياقي && !اليسار_عشري_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            إذا (هل_نوع_عشري_دلالي(الأنواع, نوع_اليسار)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, نوع_اليسار, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            };
        } وإلا إذا (اليسار_سياقي && !اليمين_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            إذا (هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليمين)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, نوع_اليمين, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            };
        } وإلا إذا (اليمين_سياقي && !اليسار_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            إذا (هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليسار)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, نوع_اليسار, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            };
        } وإلا {
            طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
        };

        طابق العامل مع
        | عامل_ثنائي.أو -> {
            إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_اليسار) || !هل_نوع_منطقي_دلالي(الأنواع, نوع_اليمين)) {
                أرجع خطأ_طرف_عامل_منطقي(الأنواع, &اليسار, نوع_اليسار, &اليمين, نوع_اليمين);
            };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.و -> {
            إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_اليسار) || !هل_نوع_منطقي_دلالي(الأنواع, نوع_اليمين)) {
                أرجع خطأ_طرف_عامل_منطقي(الأنواع, &اليسار, نوع_اليسار, &اليمين, نوع_اليمين);
            };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.يساوي -> {
            إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(&اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.لا_يساوي -> {
            إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(&اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.أصغر -> {
            إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(&اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.أصغر_أو_يساوي -> {
            إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(&اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.أكبر_أو_يساوي -> {
            إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(&اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.أكبر -> {
            إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(&اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | _ -> {
            دع صحيحان: منطقي = هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليسار) && هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليمين);
            دع عشريان: منطقي = هل_نوع_عشري_دلالي(الأنواع, نوع_اليسار) && هل_نوع_عشري_دلالي(الأنواع, نوع_اليمين) && هل_عامل_ثنائي_ينتج_عشريا(العامل);
            إذا ((!صحيحان && !عشريان) || !نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) {
                أرجع خطأ_طرف_عامل_عددي(
                    الأنواع, التعبير, &اليسار, نوع_اليسار, &اليمين, نوع_اليمين
                );
            };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_اليسار);
        };
    }
    | تعبير.أحادي(_, العامل, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        دع نوع_الداخل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الداخل := النوع; };
        طابق العامل مع
        | عامل_أحادي.نفي -> {
            إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الداخل)) {
                دع نوع_منطقي_متوقع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
                أرجع خطأ_أنواع_غير_متوافقة(
                    نطاق_تعبير(&الداخل), سياق_عدم_توافق_نوع.عامل_يتطلب_منطقيا(),
                    نوع_منطقي_متوقع, نوع_الداخل
                );
            };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_أحادي.متمم -> {
            إذا (!هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_الداخل)) {
                أرجع خطأ_نوع_موجود_غير_مناسب(
                    نطاق_تعبير(&الداخل), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا_صحيحا(), نوع_الداخل
                );
            };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الداخل);
        }
        | عامل_أحادي.سالب -> {
            إذا (!هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_الداخل) && !هل_نوع_عشري_دلالي(الأنواع, نوع_الداخل)) {
                أرجع خطأ_نوع_موجود_غير_مناسب(
                    نطاق_تعبير(&الداخل), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا(), نوع_الداخل
                );
            };
            // An unsigned value has no negation (Rust's E0600). The one
            // negated literal that fits an unsigned Type is `-0`.
            إذا (هل_نوع_عدد_طبيعي_دلالي(الأنواع, نوع_الداخل)) {
                دع صفر_سالب: متغير منطقي = خطأ;
                طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الداخل) مع
                | اختياري.موجود(قيمة_عدد_صحيح_سياقية.موقع(العدد)) -> { صفر_سالب := العدد == 0; }
                | اختياري.موجود(قيمة_عدد_صحيح_سياقية.طبيعي(العدد)) -> { صفر_سالب := العدد == 0; }
                | اختياري.لا_شيء -> { };
                إذا (!صفر_سالب) {
                    أرجع خطأ_نوع_موجود_غير_مناسب(
                        نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.سالب_عدد_طبيعي(), نوع_الداخل
                    );
                };
            };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الداخل);
        }
        | عامل_أحادي.فك -> {
            طابق خطأ_فك_معتم(الأنواع, نوع_الداخل, نطاق_تعبير(التعبير)) مع
            | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
            | اختياري.لا_شيء -> { };
            طابق نوع_فك_داخلي(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(النوع) -> { أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع); }
            | اختياري.لا_شيء -> { };
        }
        | عامل_أحادي.عنوان -> {
            إذا (!هل_تعبير_موضع_دلالي(&الداخل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(&الداخل)));
            };
            دع نوع_المرجع: متغير معرف_نوع = نوع_الداخل;
            طابق أزل_غلاف_متغير(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(الأساس) -> { نوع_المرجع := الأساس; }
            | اختياري.لا_شيء -> { };
            دع النوع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_المرجع, خطأ));
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_أحادي.عنوان_متغير -> {
            إذا (!هل_تعبير_موضع_دلالي(&الداخل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(&الداخل)));
            };
            إذا (!هل_موضع_قابل_للتغيير(&الداخل, الأنواع, أنواع_التعبيرات)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(&الداخل)));
            };
            دع نوع_المرجع: متغير معرف_نوع = نوع_الداخل;
            طابق أزل_غلاف_متغير(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(الأساس) -> { نوع_المرجع := الأساس; }
            | اختياري.لا_شيء -> { };
            دع النوع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_المرجع, صواب));
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_أحادي.انتشار -> {
            // The propagation expansion replaces every `؟` statement before
            // name resolution (frontend/desugar/propagation.sn).
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
            ));
        };
        // Only dereference falls through: its operand is not a pointer or reference.
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.فك_غير_مؤشر(نطاق_تعبير(التعبير), نوع_الداخل)
        );
    }
    | تعبير.استدعاء(_, المستدعى_المملوك, الحجج) -> {
        دع المستدعى: تعبير = مستدعى_بلا_حجج_نوع(&(*المستدعى_المملوك));
        دع هوية_البدائي: متغير اختياري هوية_بدائي_مترجم = اختياري.لا_شيء();
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&المستدعى)) مع
        | اختياري.موجود(رمز_المستدعى) -> {
            هوية_البدائي := هوية_بدائي_رمز_عند(سياق_الأسماء, رمز_المستدعى);
        }
        | اختياري.لا_شيء -> { };

        طابق هوية_البدائي مع
        | اختياري.موجود(الهوية) -> {
            // Primitive Symbols intentionally do not receive fake monomorphic function Types.
            // Their exact language-Type legality is dispatched by canonical primitive identity.
            دع أنواع_الحجج: متغير متجه معرف_نوع = [];
            دع أنواع_البدائي: أنواع_استدعاء_بدائي_مقننة =
                ابن_أنواع_استدعاء_بدائي_مقننة(الأنواع);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                دع نتيجة_الحجة: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الحجج[ف]), ثابت_أنواع_مكسور.حجة_بلا_نوع())
                );
                طابق نوع_حجة_بدائية_متوقعة(الأنواع, &أنواع_البدائي, الهوية, ف, &أنواع_الحجج) مع
                | اختياري.موجود(المتوقع) -> {
                    نتيجة_الحجة := ابن_نوع_تعبير_بتوقع_داخلي(
                        &الحجج[ف], المتوقع, موضع_توقع_نوع.بدائي(الهوية, ف), سياق_الأسماء,
                        الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                }
                | اختياري.لا_شيء -> {
                    نتيجة_الحجة := ابن_نوع_تعبير_داخلي(
                        &الحجج[ف], سياق_الأسماء, الأنواع,
                        أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                };
                طابق نتيجة_الحجة مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { ألحق(أنواع_الحجج, النوع); };
                ف := ف + 1;
            }

            // Canonicalize the reference-to-pointer ABI Type while Type still
            // owns its registry. Lowering is read-only and must never invent an
            // unregistered pointer Type during MSIR emission.
            طابق الهوية مع
            | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                دع فهرس_ذاكرة: متغير طبيعي = 1;
                طالما (فهرس_ذاكرة < (الطول(أنواع_الحجج) مثل طبيعي)) {
                    طابق معرف_نوع_أساس_عند(الأنواع, أنواع_الحجج[فهرس_ذاكرة]) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(مرجع_النوع_21) -> {
                        طابق (*الأنواع).الأنواع[مرجع_النوع_21.القيمة] مع
                        | نوع_مقنن.مرجع(الداخل, مرجع_متغير) -> {
                        طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, الداخل) مع
                        | اختياري.موجود(_) -> {
                            دع عنصر_المؤشر: متغير معرف_نوع = الداخل;
                            إذا (مرجع_متغير) {
                                عنصر_المؤشر := قنن_نوعا(
                                    الأنواع, نوع_مقنن.متغير(الداخل)
                                );
                            };
                            دع معرف_مؤشر_الاستدعاء: معرف_نوع = قنن_نوعا(
                                الأنواع, نوع_مقنن.مؤشر(عنصر_المؤشر)
                            );
                        }
                        | اختياري.لا_شيء -> { };
                    }
                        | _ -> { };
                    };
                    فهرس_ذاكرة := فهرس_ذاكرة + 1;
                }
            }
            | _ -> { };

            // Primitive Type rules own semantic container/value compatibility only.
            // Append, pop and truncate mutate their first argument, so reuse the
            // canonical place-legality path here instead of encoding mutability
            // into the vector's semantic Type.
            دع يعدل_الحجة_الأولى: متغير منطقي = خطأ;
            طابق الهوية مع
            | هوية_بدائي_مترجم.إلحاق -> { يعدل_الحجة_الأولى := صواب; }
            | هوية_بدائي_مترجم.إزالة_الأخير -> { يعدل_الحجة_الأولى := صواب; }
            | هوية_بدائي_مترجم.اقتطاع_متجه -> { يعدل_الحجة_الأولى := صواب; }
            | هوية_بدائي_مترجم.حجز_سعة_متجه -> { يعدل_الحجة_الأولى := صواب; }
            | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> { يعدل_الحجة_الأولى := صواب; }
            | _ -> { };
            إذا (يعدل_الحجة_الأولى) {
                إذا ((الطول(الحجج) مثل طبيعي) >= 1) {
                    إذا (!هل_تعبير_موضع_دلالي(&الحجج[0])
                        || !هل_موضع_قابل_للتغيير(&الحجج[0], الأنواع, أنواع_التعبيرات)) {
                        دع الموجود: معرف_نوع = أنواع_الحجج[0];
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                                نطاق_تعبير(&الحجج[0]), الهوية, 0, الموجود
                            )
                        );
                    };
                };
            };
            طابق الهوية مع
            | هوية_بدائي_مترجم.تبديل_موضعين -> {
                دع ف_الموضع: متغير طبيعي = 0;
                طالما (ف_الموضع < (الطول(الحجج) مثل طبيعي)) {
                    إذا (!هل_تعبير_موضع_دلالي(&الحجج[ف_الموضع])
                        || !هل_موضع_قابل_للتغيير(&الحجج[ف_الموضع], الأنواع, أنواع_التعبيرات)) {
                        دع الموجود: معرف_نوع = أنواع_الحجج[ف_الموضع];
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                                نطاق_تعبير(&الحجج[ف_الموضع]), الهوية, ف_الموضع, الموجود
                            )
                        );
                    };
                    ف_الموضع := ف_الموضع + 1;
                }
            }
            | _ -> { };

            طابق تحقق_استدعاء_بدائي(
                الأنواع, &أنواع_البدائي, الهوية, &أنواع_الحجج
            ) مع
            | نتيجة_استدعاء_بدائي.صالح(فئة_الناتج) -> {
                دع الناتج: متغير معرف_نوع = قنن_نوع_ناتج_استدعاء_بدائي(
                    الأنواع, &أنواع_البدائي, فئة_الناتج
                );
                طابق نوع_ناتج_استدعاء_بدائي_من_الحجج(الأنواع, فئة_الناتج, &أنواع_الحجج) مع
                | اختياري.موجود(المعرف) -> { الناتج := المعرف; }
                | اختياري.لا_شيء -> { };
                طابق قنن_نوع_ناتج_بدائي_بالحجج(الأنواع, فئة_الناتج, &أنواع_الحجج) مع
                | اختياري.موجود(المعرف) -> { الناتج := المعرف; }
                | اختياري.لا_شيء -> { };
                أرجع سجل_نوع_تعبير_داخلي(
                    الأنواع, أنواع_التعبيرات, التعبير, الناتج
                );
            }
            | نتيجة_استدعاء_بدائي.مرفوض(خطأ_البدائي) -> {
                طابق خطأ_البدائي مع
                | خطأ_استدعاء_بدائي.عدد_حجج_غير_مطابق(المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.عدد_حجج_بدائية_غير_مطابق(
                            نطاق_تعبير(التعبير), الهوية, المتوقع, الموجود
                        )
                    );
                }
                | خطأ_استدعاء_بدائي.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_مطابق(
                            نطاق_تعبير(&الحجج[الفهرس]), الهوية, الفهرس, المتوقع, الموجود
                        )
                    );
                }
                | خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(الفهرس, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                            نطاق_تعبير(&الحجج[الفهرس]), الهوية, الفهرس, الموجود
                        )
                    );
                }
                | خطأ_استدعاء_بدائي.دلالة_مصدرية_غير_متاحة -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.دلالة_بدائي_غير_متاحة(
                            نطاق_تعبير(التعبير), الهوية
                        )
                    );
                };
            };
        }
        | اختياري.لا_شيء -> {
            // Ordinary calls retain the canonical function-Type validation path unchanged.
            دع نوع_المستدعى: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(
                &المستدعى, سياق_الأسماء, الأنواع,
                أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_المستدعى := النوع;
            };

            دع استدعاء_عام: منطقي = هل_نوع_يحوي_معامل_نوع(الأنواع, نوع_المستدعى);
            دع يسمح_بمؤقت: منطقي = يسمح_بعنوان_مؤقت_داخلي(الأنواع, نوع_المستدعى);
            دع الاستبدالات_الحالية: متغير متجه ربط_استبدال_نوع = [];
            طابق استبدالات_حجج_نوع_صريحة_داخلي(
                &(*المستدعى_المملوك), سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة.نجح(القيم) -> { الاستبدالات_الحالية := القيم; };
            دع أنواع_الحجج: متغير متجه معرف_نوع = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                دع نتيجة_الحجة: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الحجج[ف]), ثابت_أنواع_مكسور.حجة_بلا_نوع())
                );
                طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
                | اختياري.موجود(المتوقع_الخام) -> {
                    دع توقع_الحجة: متغير اختياري معرف_نوع = اختياري.موجود(المتوقع_الخام);
                    إذا (استدعاء_عام) {
                        دع المتوقع: معرف_نوع = استبدل_نوعا(
                            الأنواع, المتوقع_الخام, &الاستبدالات_الحالية
                        );
                        توقع_الحجة := اختياري.موجود(المتوقع);
                        إذا (هل_نوع_يحوي_معامل_نوع(الأنواع, المتوقع)) { توقع_الحجة := اختياري.لا_شيء(); };
                    };
                    نتيجة_الحجة := ابن_نوع_حجة_داخلي(
                        &الحجج[ف], توقع_الحجة, ف, يسمح_بمؤقت, سياق_الأسماء,
                        الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                }
                | اختياري.لا_شيء -> {
                    دع بلا_توقع: اختياري معرف_نوع = اختياري.لا_شيء();
                    نتيجة_الحجة := ابن_نوع_حجة_داخلي(
                        &الحجج[ف], بلا_توقع, ف, يسمح_بمؤقت, سياق_الأسماء,
                        الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                };
                طابق نتيجة_الحجة مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                    ألحق(أنواع_الحجج, النوع);
                    إذا (استدعاء_عام) {
                        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
                        | اختياري.موجود(المتوقع_الخام) -> {
                            إذا (!أضف_استبدالات_من_معامل_استدعاء(
                                الأنواع, المتوقع_الخام, النوع, &متغير الاستبدالات_الحالية
                            )) {
                                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                    خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                                        نطاق_تعبير(&الحجج[ف]), ف, المتوقع_الخام, النوع
                                    )
                                );
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    };
                };
                ف := ف + 1;
            }

            طابق تحقق_توقيع_استدعاء_باستبدالات(
                الأنواع, نوع_المستدعى, &أنواع_الحجج, &الاستبدالات_الحالية
            ) مع
            | نتيجة_توقيع_استدعاء.صالح(الناتج, استبدالات_النوع) -> {
                طابق خطأ_معتم_في_توقيع_مثيل(
                    الأنواع, سياق_الأسماء, نوع_المستدعى, &استبدالات_النوع,
                    رمز_مستدعى_محلول_للنوع(سياق_الأسماء, الروابط, &المستدعى), نطاق_تعبير(التعبير)
                ) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                دع نطاقات_الحجج: متغير متجه نطاق = [];
                دع ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الحجج) مثل طبيعي)) {
                    ألحق(نطاقات_الحجج, نطاق_تعبير(&الحجج[ح]));
                    ح := ح + 1;
                }
                دع رمز_الاستدعاء: اختياري معرف_رمز = رمز_مستدعى_محلول_للنوع(
                    سياق_الأسماء, الروابط, &المستدعى
                );
                أضف_استدعاء_نوعيا(
                    أنواع_التعبيرات, نطاق_تعبير(التعبير), نوع_المستدعى,
                    رمز_الاستدعاء, نطاقات_الحجج, استبدالات_النوع
                );
                أرجع سجل_نوع_تعبير_داخلي(
                    الأنواع, أنواع_التعبيرات, التعبير, الناتج
                );
            }
            | نتيجة_توقيع_استدعاء.مرفوض(خطأ_التوقيع) -> {
                طابق خطأ_التوقيع مع
                | خطأ_توقيع_استدعاء.غير_قابل_للاستدعاء -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(
                            نطاق_تعبير(التعبير), نوع_المستدعى
                        )
                    );
                }
                | خطأ_توقيع_استدعاء.عدد_حجج_غير_مطابق(المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                            نطاق_تعبير(التعبير), المتوقع, الموجود
                        )
                    );
                }
                | خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                            نطاق_تعبير(&الحجج[الفهرس]), الفهرس, المتوقع, الموجود
                        )
                    );
                };
            };
        };
    }
    | تعبير.وقت_الترجمة(_, المملوك) -> {
        دع الداخل: تعبير = *المملوك;
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        };
    }
    // Explicit type arguments are read where the call is typed; the callee
    // itself (same span) is typed as written.
    | تعبير.حجج_نوع(_, الداخل_المملوك, _) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        أرجع ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    // A record literal has no Type of its own: it needs a record context.
    | تعبير.حرفي_سجل(النطاق, _) -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            النطاق, سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
            اختياري.لا_شيء(), اختياري.لا_شيء()
        ));
    }
    // Without a context Type the first element gives the element Type
    // (`[1, 2]` is a vector of int); `[]` needs a context.
    | تعبير.حرفي_متجه(النطاق, العناصر) -> {
        إذا ((الطول(العناصر) مثل طبيعي) == 0) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                النطاق, سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                اختياري.لا_شيء(), اختياري.لا_شيء()
            ));
        };
        دع نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&العناصر[0], سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_العنصر := النوع; };
        دع نوع_المتجه: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.متجه(نوع_العنصر));
        أرجع ابن_نوع_حرفي_متجه_داخلي(
            التعبير, نوع_المتجه, نوع_العنصر, 1, سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    }
    | تعبير.تسلسل_وقت_الترجمة(_, التعابير) -> {
        دع الناتج: متغير اختياري معرف_نوع = اختياري.لا_شيء();
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            طابق ابن_نوع_تعبير_داخلي(&التعابير[ف], سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { الناتج := اختياري.موجود(النوع); };
            ف := ف + 1;
        }
        طابق الناتج مع
        | اختياري.موجود(النوع) -> { أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع); }
        | اختياري.لا_شيء -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(نطاق_تعبير(التعبير), معرف_نوع_من(0))); };
    }
    | تعبير.إغلاق(النطاق, المعاملات, الناتج_التركيبي, الجسم_المملوك) -> {
        دع أنواع_المعاملات: متغير متجه معرف_نوع = [];
        دع رموز_المعاملات: متغير متجه معرف_رمز = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
            دع مرجع_المعامل: &معامل_إغلاق = &المعاملات[ف];
            دع المعامل: معامل_إغلاق = *مرجع_المعامل;
            دع نوع_المعامل: معرف_نوع;
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &المعامل.النوع) مع
            | نتيجة_حل_نوع.موجود(المعرف) -> { نوع_المعامل := المعرف; }
            | _ -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&المعامل.النوع))); };
            طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, نوع_المعامل, نطاق_نوع_تركيبي_داخلي(&المعامل.النوع)) مع
            | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
            | اختياري.لا_شيء -> { };
            دع رمز_المعامل: معرف_رمز;
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &المعامل.الاسم) مع
            | نتيجة.نجح(الرمز) -> { رمز_المعامل := الرمز; }
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); };
            إذا (!أضف_نوع_رمز(أنواع_الرموز, رمز_المعامل, نوع_المعامل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(المعامل.النطاق));
            };
            ألحق(أنواع_المعاملات, نوع_المعامل);
            ألحق(رموز_المعاملات, رمز_المعامل);
            ف := ف + 1;
        }
        دع نوع_الناتج: معرف_نوع;
        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &(*الناتج_التركيبي)) مع
        | نتيجة_حل_نوع.موجود(المعرف) -> { نوع_الناتج := المعرف; }
        | _ -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&(*الناتج_التركيبي)))); };
        طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, نوع_الناتج, نطاق_نوع_تركيبي_داخلي(&(*الناتج_التركيبي))) مع
        | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
        | اختياري.لا_شيء -> { };
        دع الجسم: تعبير = *الجسم_المملوك;
        طابق ابن_نوع_تعبير_بتوقع_داخلي(
            &الجسم, نوع_الناتج, موضع_توقع_نوع.إرجاع(), سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        ) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
        دع الالتقاطات: متغير متجه معرف_رمز = [];
        اجمع_التقاطات_إغلاق(&الجسم, سياق_الأسماء, الروابط, &رموز_المعاملات, &متغير الالتقاطات);
        أضف_حقيقة_إغلاق(أنواع_التعبيرات, النطاق, الالتقاطات);
        دع نوع_الإغلاق: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.دالة(أنواع_المعاملات, نوع_الناتج));
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الإغلاق);
    }
    | تعبير.تحويل(النطاق_الكلي, الداخل_المملوك, الهدف) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        دع نوع_المصدر: متغير اختياري معرف_نوع = اختياري.لا_شيء();
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_المصدر := اختياري.موجود(النوع); };
        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &(*الهدف)) مع
        | نتيجة_حل_نوع.موجود(نوع_الهدف) -> {
            طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, نوع_الهدف, نطاق_نوع_تركيبي_داخلي(&(*الهدف))) مع
            | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
            | اختياري.لا_شيء -> { };
            // Casts between two scalar Types are checked here (docs/en/reference/type-system.md,
            // "Numeric casts"); other shapes are checked where they are lowered.
            طابق نوع_المصدر مع
            | اختياري.موجود(المصدر) -> {
                إذا (تحويل_سلمي_مرفوض(الأنواع, المصدر, نوع_الهدف)) {
                    أرجع خطأ_أنواع_غير_متوافقة(
                        النطاق_الكلي, سياق_عدم_توافق_نوع.تحويل_غير_صالح(), نوع_الهدف, المصدر
                    );
                };
                // A 32-bit address word is checked against the target later.
                إذا ((هل_مؤشر_خام_دلالي(الأنواع, المصدر) && هل_نوع_صحيح_32_دلالي(الأنواع, نوع_الهدف))
                    || (هل_نوع_صحيح_32_دلالي(الأنواع, المصدر) && هل_مؤشر_خام_دلالي(الأنواع, نوع_الهدف))) {
                    أضف_تحويل_عنوان_32(أنواع_التعبيرات, النطاق_الكلي, المصدر, نوع_الهدف);
                };
            }
            | اختياري.لا_شيء -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الهدف);
        }
        | _ -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&(*الهدف)))
            );
        };
    };
}

عرف ابن_تواقيع_الدوال_داخلية(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        دع مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            دع أنواع_المعاملات: متغير متجه معرف_نوع = [];
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(الدالة.المعاملات) مثل طبيعي)) {
                دع مرجع_المعامل: &معامل = &الدالة.المعاملات[م];
                دع المعامل: معامل = *مرجع_المعامل;
                دع نوع_المعامل: متغير معرف_نوع = معرف_نوع_من(0);
                طابق قنن_نوع_تركيبي(الأنواع, الروابط, &المعامل.النوع) مع
                | نتيجة_حل_نوع.موجود(النوع) -> {
                    طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, النوع, نطاق_نوع_تركيبي_داخلي(&المعامل.النوع)) مع
                    | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                    | اختياري.لا_شيء -> { };
                    نوع_المعامل := النوع;
                }
                | _ -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                        نطاق_نوع_تركيبي_داخلي(&المعامل.النوع)
                    ));
                };
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &المعامل.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(رمز_المعامل) -> {
                    إذا (!أضف_نوع_رمز(أنواع_الرموز, رمز_المعامل, نوع_المعامل)) {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(المعامل.النطاق));
                    };
                };
                ألحق(أنواع_المعاملات, نوع_المعامل);
                م := م + 1;
            }
            دع نوع_الناتج: متغير معرف_نوع = معرف_نوع_من(0);
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الدالة.الناتج) مع
            | نتيجة_حل_نوع.موجود(النوع) -> {
                طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, النوع, نطاق_نوع_تركيبي_داخلي(&الدالة.الناتج)) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                نوع_الناتج := النوع;
            }
            | _ -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                    نطاق_نوع_تركيبي_داخلي(&الدالة.الناتج)
                ));
            };
            دع نوع_الدالة: معرف_نوع = قنن_نوعا(
                الأنواع,
                نوع_مقنن.دالة(أنواع_المعاملات, نوع_الناتج)
            );
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &الدالة.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة.نجح(رمز_الدالة) -> {
                إذا (!أضف_نوع_رمز(أنواع_الرموز, رمز_الدالة, نوع_الدالة)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(الدالة.النطاق));
                };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_أنواع_قيم_عليا_داخلية(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        دع مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            دع نوع_القيمة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &التصريح.النوع) مع
            | نتيجة_حل_نوع.موجود(النوع) -> {
                طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, النوع, نطاق_نوع_تركيبي_داخلي(&التصريح.النوع)) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                نوع_القيمة := النوع;
            }
            | _ -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                    نطاق_نوع_تركيبي_داخلي(&التصريح.النوع)
                ));
            };
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة.نجح(الرمز) -> {
                إذا (!أضف_نوع_رمز(أنواع_الرموز, الرمز, نوع_القيمة)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_تهيئات_قيم_عليا_داخلية(
    العناصر: &متجه عنصر_وحدة,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        دع مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            دع نوع_التصريح: متغير معرف_نوع = معرف_نوع_من(0);
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة.نجح(الرمز) -> {
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                | اختياري.موجود(النوع) -> { نوع_التصريح := النوع; }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(
                        الرمز, التصريح.الاسم.النطاق
                    ));
                };
            };
            دع نوع_التهيئة: متغير معرف_نوع = نوع_التصريح;
            طابق أزل_غلاف_متغير(الأنواع, نوع_التصريح) مع
            | اختياري.موجود(الأساس) -> { نوع_التهيئة := الأساس; }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
            };
            طابق التصريح.التهيئة مع
            | تهيئة_قيمة_عليا.خارجية(_) -> { }
            | تهيئة_قيمة_عليا.تعبير(التعبير) -> {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(
                    &التعبير, نوع_التهيئة, موضع_توقع_نوع.تهيئة(),
                    سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            }
            | تهيئة_قيمة_عليا.متجه(العناصر) -> {
                دع نوع_العنصر: معرف_نوع;
                طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_التهيئة) مع
                | اختياري.موجود(المعرف) -> { نوع_العنصر := المعرف; }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
                دع فهرس_العنصر: متغير طبيعي = 0;
                طالما (فهرس_العنصر < (الطول(العناصر) مثل طبيعي)) {
                    طابق ابن_نوع_تعبير_متوقع_داخلي(
                        &العناصر[فهرس_العنصر], نوع_العنصر, فهرس_العنصر,
                        سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    ) مع
                    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                    فهرس_العنصر := فهرس_العنصر + 1;
                }
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The first `break` or `continue` that no loop of the same function encloses.
// A compile-time block is a function of its own.
// A closure body is an expression, never a statement block, so loop control
// cannot appear inside a closure (the parser rejects it); a loop around the
// closure is therefore never taken for the closure's own loop.
عرف أول_قفز_خارج_حلقة(الكتلة: &كتلة_عبارات, في_حلقة: منطقي): اختياري نطاق {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكتلة).العبارات) مثل طبيعي)) {
        دع مرجع_الصندوق: &صندوق عبارة = &(*الكتلة).العبارات[ف];
        دع العبارة: عبارة = **مرجع_الصندوق;
        دع الموجود: متغير اختياري نطاق = اختياري.لا_شيء();
        طابق العبارة مع
        | عبارة.اخرج_من_حلقة(النطاق) -> {
            إذا (!في_حلقة) { الموجود := اختياري.موجود(النطاق); };
        }
        | عبارة.تابع_حلقة(النطاق) -> {
            إذا (!في_حلقة) { الموجود := اختياري.موجود(النطاق); };
        }
        | عبارة.طالما(_, _, الجسم) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, صواب); }
        | عبارة.لكل(_, _, _, _, الجسم) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, صواب); }
        | عبارة.إذا(_, _, عند_الصواب, عند_الخطأ) -> {
            الموجود := أول_قفز_خارج_حلقة(&عند_الصواب, في_حلقة);
            طابق الموجود مع
            | اختياري.لا_شيء -> {
                طابق عند_الخطأ مع
                | اختياري.موجود(الكتلة_الأخرى) -> { الموجود := أول_قفز_خارج_حلقة(&الكتلة_الأخرى, في_حلقة); }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        }
        | عبارة.طابق(_, _, الأذرع) -> {
            دع ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
                طابق الموجود مع
                | اختياري.لا_شيء -> { الموجود := أول_قفز_خارج_حلقة(&الأذرع[ذ].الجسم, في_حلقة); }
                | _ -> { };
                ذ := ذ + 1;
            }
        }
        | عبارة.غير_آمن(_, الجسم) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, في_حلقة); }
        | عبارة.وقت_الترجمة(_, الجسم) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, خطأ); }
        | عبارة.إسناد_وقت_الترجمة(_, _, الجسم, _) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, خطأ); }
        | _ -> { };
        طابق الموجود مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف خطأ_شرط_غير_منطقي(
    الأنواع: &متغير سجل_أنواع,
    الشرط: &تعبير,
    نوع_الشرط: معرف_نوع
): خطأ_بناء_سياقات_أنواع {
    دع نوع_المنطقي: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
    أرجع خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
        نطاق_تعبير(الشرط), سياق_عدم_توافق_نوع.شرط_غير_منطقي(),
        اختياري.موجود(نوع_المنطقي), اختياري.موجود(نوع_الشرط)
    );
}

// The first declared field of a record Type that a literal does not write.
عرف أول_حقل_سجل_مفقود(
    الأنواع: &سجل_أنواع,
    نوع_السجل: معرف_نوع,
    عدد_الحقول: طبيعي,
    المكتوبة: &متجه معرف_اسم
): اختياري معرف_اسم {
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الحقول) {
        طابق حقل_سجل_عند(الأنواع, نوع_السجل, ف) مع
        | اختياري.موجود(الحقل) -> {
            دع موجود: متغير منطقي = خطأ;
            دع هـ: متغير طبيعي = 0;
            طالما (هـ < (الطول(*المكتوبة) مثل طبيعي)) {
                إذا (معرفا_اسم_متساويان((*المكتوبة)[هـ], الحقل.الاسم)) { موجود := صواب; };
                هـ := هـ + 1;
            }
            إذا (!موجود) { أرجع اختياري.موجود(الحقل.الاسم); };
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_كتلة_أنواع_داخلية(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز,
    نوع_الناتج_المتوقع: معرف_نوع
): اختياري خطأ_بناء_سياقات_أنواع {
    دع القيمة: كتلة_عبارات = *الكتلة;
    دع ف: متغير طبيعي = 0;
    // The local the previous statement declared: its initializer follows it.
    دع آخر_مصرح: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    طالما (ف < (الطول(القيمة.العبارات) مثل طبيعي)) {
        دع مرجع_الصندوق: &صندوق عبارة = &القيمة.العبارات[ف];
        دع العبارة: عبارة = **مرجع_الصندوق;
        دع المصرح_السابق: اختياري معرف_رمز = آخر_مصرح;
        آخر_مصرح := رمز_تصريح_عبارة(&العبارة, الروابط);
        طابق العبارة مع
        | عبارة.تصريح_متغير(النطاق, الاسم, النوع_التركيبي) -> {
            دع النوع: متغير معرف_نوع = معرف_نوع_من(0);
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &النوع_التركيبي) مع
            | نتيجة_حل_نوع.موجود(المعرف) -> {
                طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, المعرف, نطاق_نوع_تركيبي_داخلي(&النوع_التركيبي)) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                النوع := المعرف;
            }
            | _ -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                    نطاق_نوع_تركيبي_داخلي(&النوع_التركيبي)
                ));
            };
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &الاسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة.نجح(الرمز) -> {
                إذا (!أضف_نوع_رمز(أنواع_الرموز, الرمز, النوع)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(النطاق));
                };
            };
        }
        | عبارة.تهيئة_سجل(_, الوجهة, الحقول) -> {
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            طابق افحص_حقول_سجل_داخلي(
                نطاق_تعبير(&الوجهة), نوع_الوجهة, &الحقول, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.تهيئة_صف(_, الوجهة, العناصر) -> {
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الوجهة) مع
            | اختياري.موجود(المتوقع) -> {
                إذا ((الطول(العناصر) مثل طبيعي) != المتوقع) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                        نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.عدد_عناصر_صف(),
                        اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
                    ));
                };
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                    اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
                ));
            };
            دع ع: متغير طبيعي = 0;
            طالما (ع < (الطول(العناصر) مثل طبيعي)) {
                دع نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الوجهة, ع) مع
                | اختياري.موجود(النوع) -> {
                    نوع_العنصر := النوع;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(
                        خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&العناصر[ع]), ثابت_أنواع_مكسور.نوع_عنصر_صف())
                    );
                };
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &العناصر[ع], نوع_العنصر, ع, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | _ -> { };
                ع := ع + 1;
            }
        }
        | عبارة.تهيئة_متجه(_, الوجهة, العناصر) -> {
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            دع نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
            طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_الوجهة) مع
            | اختياري.موجود(النوع) -> {
                نوع_العنصر := النوع;
            }
            | اختياري.لا_شيء -> {
                // A slice view initialized from a literal views that literal.
                طابق نوع_عنصر_شريحة_دلالي(الأنواع, نوع_الوجهة) مع
                | اختياري.موجود(النوع) -> { نوع_العنصر := النوع; }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                        نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                        اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
                    ));
                };
            };
            دع ع: متغير طبيعي = 0;
            طالما (ع < (الطول(العناصر) مثل طبيعي)) {
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &العناصر[ع], نوع_العنصر, ع, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | _ -> { };
                ع := ع + 1;
            }
            سجل_طول_تهيئة_حرفية(
                &الوجهة, نوع_الوجهة, الطول(العناصر) مثل طبيعي, المصرح_السابق,
                الأنواع, الروابط, أنواع_الرموز
            );
        }
        | عبارة.تهيئة_نص(_, الوجهة, بايتات_النص) -> {
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الوجهة) -> {
                دع نوع_النص: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
                إذا (!نوعان_متوافقان(الأنواع, نوع_الوجهة, نوع_النص)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                        نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.قيمة_لا_تطابق_الوجهة(),
                        اختياري.موجود(نوع_الوجهة), اختياري.موجود(نوع_النص)
                    ));
                };
                // Text indexes bytes: the literal's byte count is its length.
                سجل_طول_تهيئة_حرفية(
                    &الوجهة, نوع_الوجهة, الطول(بايتات_النص) مثل طبيعي, المصرح_السابق,
                    الأنواع, الروابط, أنواع_الرموز
                );
            };
        }
        | عبارة.تهيئة_صندوق(_, الوجهة, الحمولة) -> {
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            طابق نوع_حمولة_صندوق_دلالي(الأنواع, نوع_الوجهة) مع
            | اختياري.موجود(نوع_الحمولة) -> {
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &الحمولة, نوع_الحمولة, 0, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                    اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
                ));
            };
        }
        | عبارة.نسخ(_, الوجهة, المصدر) -> {
            إذا (!هل_تعبير_موضع_دلالي(&الوجهة)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.إسناد_إلى_غير_موضع(نطاق_تعبير(&الوجهة)));
            };
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الوجهة := النوع; };
            إذا (هل_تعبير_فهرسة_دلالي(&الوجهة)
                && !هل_موضع_قابل_للتغيير(&الوجهة, الأنواع, أنواع_التعبيرات)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(&الوجهة)));
            };
            إذا (هل_حقل_جذره_غير_قابل_للتغيير(&الوجهة, الأنواع, أنواع_التعبيرات)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(&الوجهة)));
            };
            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                &المصدر, نوع_الوجهة, موضع_توقع_نوع.تهيئة(), سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | _ -> { };
            // `let t: string = "..."` initializes from a text literal.
            طابق المصدر مع
            | تعبير.حرفي(_, حرفي.نص(بايتات_المصدر)) -> {
                سجل_طول_تهيئة_حرفية(
                    &الوجهة, نوع_الوجهة, الطول(بايتات_المصدر) مثل طبيعي, المصرح_السابق,
                    الأنواع, الروابط, أنواع_الرموز
                );
            }
            | _ -> { };
        }
        | عبارة.استدعاء(_, التعبير) -> {
            طابق ابن_نوع_تعبير_داخلي(&التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | _ -> { };
        }
        | عبارة.لكل(النطاق, البداية, الشرط, الخطوة, الجسم) -> {
            دع كتلة_البداية: كتلة_عبارات = { النطاق: النطاق, العبارات: انسخ_مملوكا_متجه_صندوق_عبارة(&البداية) };
            طابق ابن_كتلة_أنواع_داخلية(&كتلة_البداية, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق ابن_نوع_تعبير_داخلي(&الشرط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الشرط) -> {
                إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الشرط)) {
                    أرجع اختياري.موجود(خطأ_شرط_غير_منطقي(الأنواع, &الشرط, نوع_الشرط));
                };
            };
            دع نسخة_الخطوة: صندوق عبارة = انسخ_مملوكا_صندوق_عبارة(&الخطوة);
            دع قائمة_الخطوة: متجه صندوق عبارة = [نسخة_الخطوة];
            دع كتلة_الخطوة: كتلة_عبارات = { النطاق: النطاق, العبارات: قائمة_الخطوة };
            طابق ابن_كتلة_أنواع_داخلية(&كتلة_الخطوة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق ابن_كتلة_أنواع_داخلية(&الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.اخرج_من_حلقة(_) -> { }
        | عبارة.تابع_حلقة(_) -> { }
        | عبارة.طالما(_, الشرط, الجسم) -> {
            طابق ابن_نوع_تعبير_داخلي(&الشرط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الشرط) -> {
                إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الشرط)) {
                    أرجع اختياري.موجود(خطأ_شرط_غير_منطقي(الأنواع, &الشرط, نوع_الشرط));
                };
            };
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.إذا(_, الشرط, عند_الصواب, عند_الخطأ) -> {
            طابق ابن_نوع_تعبير_داخلي(&الشرط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الشرط) -> {
                إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الشرط)) {
                    أرجع اختياري.موجود(خطأ_شرط_غير_منطقي(الأنواع, &الشرط, نوع_الشرط));
                };
            };
            طابق ابن_كتلة_أنواع_داخلية(
                &عند_الصواب, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
            طابق عند_الخطأ مع
            | اختياري.موجود(الكتلة_الأخرى) -> {
                طابق ابن_كتلة_أنواع_داخلية(
                    &الكتلة_الأخرى, سياق_الأسماء,
                    الأنواع,
                    أنواع_التعبيرات,
                    الروابط,
                    أنواع_الرموز,
                    نوع_الناتج_المتوقع
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.طابق(_, المميز, الأذرع) -> {
            دع نوع_المميز: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&المميز, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_المميز := النوع;
            };
            دع ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
                إذا (!اربط_أنواع_رموز_نمط_تركيبي(
                    &الأذرع[ذ].النمط, نوع_المميز, سياق_الأسماء, الأنواع,
                    الروابط, أنواع_الرموز
                )) {
                    طابق مخالفة_حمولات_نمط_في(
                        &الأذرع[ذ].النمط, نوع_المميز, سياق_الأسماء, الأنواع, الروابط
                    ) مع
                    | اختياري.موجود(المخالفة) -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.عدد_حمولات_نمط_غير_مطابق(
                            المخالفة.النطاق, المخالفة.المتوقع, المخالفة.الموجود
                        ));
                    }
                    | اختياري.لا_شيء -> { };
                    أرجع اختياري.موجود(
                        خطأ_بناء_سياقات_أنواع.نمط_غير_صالح(نطاق_نمط(&الأذرع[ذ].النمط))
                    );
                };
                طابق ابن_كتلة_أنواع_داخلية(
                    &الأذرع[ذ].الجسم, سياق_الأسماء,
                    الأنواع,
                    أنواع_التعبيرات,
                    الروابط,
                    أنواع_الرموز,
                    نوع_الناتج_المتوقع
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                ذ := ذ + 1;
            }
        }
        | عبارة.أرجع(نطاق_الإرجاع, القيمة_الراجعة) -> {
            طابق القيمة_الراجعة مع
            | اختياري.موجود(التعبير) -> {
                طابق ابن_نوع_تعبير_إرجاع_داخلي(
                    &التعبير, نوع_الناتج_المتوقع, سياق_الأسماء, الأنواع,
                    أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> {
                // A bare return gives no value to a function that returns one.
                دع نوع_الفراغ: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
                إذا (!نوعان_متوافقان(الأنواع, نوع_الناتج_المتوقع, نوع_الفراغ)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_إرجاع_غير_مطابق(
                        نطاق_الإرجاع, نوع_الناتج_المتوقع, نوع_الفراغ
                    ));
                };
            };
        }
        | عبارة.تجميع(_, _) -> { }
        | عبارة.وقت_الترجمة(_, الجسم) -> {
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات,
                الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.إسناد_وقت_الترجمة(_, الوجهة, الجسم, الناتج) -> {
            إذا (!هل_تعبير_موضع_دلالي(&الوجهة)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.إسناد_إلى_غير_موضع(نطاق_تعبير(&الوجهة)));
            };
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الوجهة := النوع; };
            // The block is the body of its own compile-time function, which
            // returns no value: a `return` inside cannot leave the enclosing
            // function.
            دع نوع_الفراغ: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات,
                الروابط, أنواع_الرموز, نوع_الفراغ
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                &الناتج, نوع_الوجهة, موضع_توقع_نوع.تهيئة(), سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | _ -> { };
        }
        | عبارة.غير_آمن(_, الجسم) -> {
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_أجسام_الدوال_داخلية(
    العناصر: &متجه عنصر_وحدة,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        دع مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            دع نوع_الناتج: متغير معرف_نوع = معرف_نوع_من(0);
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &الدالة.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة.نجح(رمز_الدالة) -> {
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, رمز_الدالة) مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(رمز_الدالة, الدالة.الاسم.النطاق));
                }
                | اختياري.موجود(نوع_الدالة) -> {
                    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة) مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(الدالة.النطاق));
                    }
                    | اختياري.موجود(النوع) -> {
                        نوع_الناتج := النوع;
                    };
                };
            };
            طابق الدالة.الجسم مع
            | اختياري.موجود(الجسم) -> {
                طابق أول_قفز_خارج_حلقة(&الجسم, خطأ) مع
                | اختياري.موجود(نطاق_القفز) -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.قفز_خارج_حلقة(نطاق_القفز));
                }
                | اختياري.لا_شيء -> { };
                طابق ابن_كتلة_أنواع_داخلية(
                    &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}


عام عرف ابن_سياقات_أنواع_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_سياقات_أنواع {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع أنواع_تعبيرات_الوحدات: متغير متجه سياق_أنواع_تعبيرات = [];
    دع علاقات_هرم_الأنواع: متغير متجه علاقة_هرم_نوع = [];
    دع أنواع_الرموز: متغير سياق_أنواع_رموز = سياق_أنواع_رموز_جديد();
    دع ف: متغير طبيعي = 0;

    // No decorator may disappear during lowering. Until the verified-MSIR
    // declaration transformation is available, annotations are rejected at
    // their own span, including on types and global declarations.
    دع موضع_السمة: متغير طبيعي = 0;
    طالما (موضع_السمة < (الطول(*الوحدات) مثل طبيعي)) {
        دع العناصر_ذات_السمات: &متجه عنصر_وحدة = &(*الوحدات)[موضع_السمة].العناصر;
        دع موضع_التصريح: متغير طبيعي = 0;
        طالما (موضع_التصريح < (الطول(*العناصر_ذات_السمات) مثل طبيعي)) {
            طابق (*العناصر_ذات_السمات)[موضع_التصريح] مع
            | عنصر_وحدة.دالة(التصريح) -> {
                إذا ((الطول(التصريح.السمات) مثل طبيعي) > 0) {
                    أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(
                        خطأ_بناء_سياقات_أنواع.سمة_تصريح_غير_مدعومة(التصريح.السمات[0].النطاق), الأنواع
                    );
                };
            }
            | عنصر_وحدة.نوع(التصريح) -> {
                إذا ((الطول(التصريح.السمات) مثل طبيعي) > 0) {
                    أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(
                        خطأ_بناء_سياقات_أنواع.سمة_تصريح_غير_مدعومة(التصريح.السمات[0].النطاق), الأنواع
                    );
                };
            }
            | عنصر_وحدة.قيمة_عليا(التصريح) -> {
                إذا ((الطول(التصريح.السمات) مثل طبيعي) > 0) {
                    أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(
                        خطأ_بناء_سياقات_أنواع.سمة_تصريح_غير_مدعومة(التصريح.السمات[0].النطاق), الأنواع
                    );
                };
            }
            | _ -> { };
            موضع_التصريح := موضع_التصريح + 1;
        }
        موضع_السمة := موضع_السمة + 1;
    }

    // Register all generic Type parameters before resolving any declaration/signature Type syntax.
    ف := 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        دع قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق سجل_معاملات_نوع_العناصر(
            &(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Named Type syntax consumes each module's canonical Name bindings directly.
    // Every named aggregate is declared before any module completes a cross-module shape.
    ف := 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        دع قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق أعلن_التراكيب_المسماة(&(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        دع قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق أكمل_المرادفات(&(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير علاقات_هرم_الأنواع) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        دع قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق أكمل_التراكيب_المسماة(
            &(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Generic aggregate instances may have been interned while another template was
    // still an empty forward declaration. Rebuild their concrete semantic shapes once
    // every named template is complete, before function signatures/bodies consume them.
    إذا (!أعد_بناء_مثيلات_أنواع_مسماة(&متغير الأنواع)) {
        أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(
            خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(نطاق_فارغ()), الأنواع
        );
    };

    // Function signatures for all modules precede all bodies so calls are graph-order independent.
    ف := 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        دع قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق ابن_تواقيع_الدوال_داخلية(
            &(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Top-level value Types are registered for every module before any initializer/body
    // expression is typed, preserving graph-order independence just like function signatures.
    ف := 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        دع قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق ابن_أنواع_قيم_عليا_داخلية(
            &(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        دع قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_سياقات_أنواع.ملغاة(); };
        دع أنواع_تعبيرات_الوحدة: متغير سياق_أنواع_تعبيرات = سياق_أنواع_تعبيرات_جديد();
        طابق ابن_تهيئات_قيم_عليا_داخلية(
            &(*قيمة_الوحدة).العناصر, سياق_الأسماء, &متغير الأنواع, &متغير أنواع_تعبيرات_الوحدة,
            روابط_الوحدة, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        طابق ابن_أجسام_الدوال_داخلية(
            &(*قيمة_الوحدة).العناصر, سياق_الأسماء, &متغير الأنواع, &متغير أنواع_تعبيرات_الوحدة,
            روابط_الوحدة, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ألحق(أنواع_تعبيرات_الوحدات, أنواع_تعبيرات_الوحدة);
        ف := ف + 1;
    }

    دع الناتج: سياقات_أنواع_وحدة = {
        الأنواع: الأنواع,
        أنواع_التعبيرات: أنواع_تعبيرات_الوحدات,
        أنواع_الرموز: أنواع_الرموز,
        علاقات_هرم_الأنواع: علاقات_هرم_الأنواع
    };
    أرجع نتيجة_بناء_سياقات_أنواع.مبنية(الناتج);
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

