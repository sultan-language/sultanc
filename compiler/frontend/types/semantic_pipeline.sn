استورد compiler.frontend.types.type_context;
// Canonical Type pipeline result consumed by the real driver. It contains exactly
// the three Type-owned contexts expected by semantic lowering.
// Canonical declaration/signature Symbol -> Type facts are Type-owned and survive the
// whole-unit pass. Downstream consumers query this table; they never re-resolve AST Type syntax.
عام نوع سياق_أنواع_رموز = {
    // SymbolID is already a dense canonical identity. Type owns one direct slot per Symbol;
    // no secondary Symbol→Type fact list is searched during expression inference.
    الأنواع: متجه اختيار معرف_نوع
};

عام نوع علاقة_هرم_نوع = {
    النوع_الفرعي: معرف_رمز,
    النوع_العلوي: معرف_رمز
};

عام نوع سياقات_أنواع_وحدة = {
    الأنواع: سجل_أنواع,
    أنواع_التعبيرات: متجه سياق_أنواع_تعبيرات,
    أنواع_الرموز: سياق_أنواع_رموز,
    علاقات_هرم_الأنواع: متجه علاقة_هرم_نوع
};

عام نوع خطأ_بناء_سياقات_أنواع =
    | ربط_اسم_مفقود بنوع نطاق
    | هوية_اسم_مفقودة بنوع نطاق
    | نوع_غير_محلول بنوع نطاق
    | تعريف_نوع_غير_صالح بنوع نطاق
    | نوع_رمز_مفقود بنوع (معرف_رمز, نطاق)
    | نوع_تعبير_غير_مدعوم بنوع نطاق
    | حقل_سجل_غير_معروف بنوع نطاق
    | نمط_غير_صالح بنوع نطاق
    | عدد_حجج_استدعاء_غير_مطابق بنوع (نطاق, غير_موقع, غير_موقع)
    | نوع_حجة_استدعاء_غير_مطابق بنوع (نطاق, غير_موقع, معرف_نوع, معرف_نوع)
    | نوع_إرجاع_غير_مطابق بنوع (نطاق, معرف_نوع, معرف_نوع)
    | عدد_حجج_بدائية_غير_مطابق بنوع (نطاق, هوية_بدائي_مترجم, غير_موقع, غير_موقع)
    | نوع_حجة_بدائية_غير_مطابق بنوع (نطاق, هوية_بدائي_مترجم, غير_موقع, معرف_نوع, معرف_نوع)
    | نوع_حجة_بدائية_غير_صالح بنوع (نطاق, هوية_بدائي_مترجم, غير_موقع, معرف_نوع)
    | دلالة_بدائي_غير_متاحة بنوع (نطاق, هوية_بدائي_مترجم)
    | تعبير_غير_قابل_للاستدعاء بنوع (نطاق, معرف_نوع)
;

عام نوع نتيجة_بناء_سياقات_أنواع =
    | مبنية بنوع سياقات_أنواع_وحدة
    | مرفوضة بنوع خطأ_بناء_سياقات_أنواع
;

عام عرف سياق_أنواع_رموز_جديد(): سياق_أنواع_رموز {
    دع الأنواع: متجه اختيار معرف_نوع = [];
    دع السياق: سياق_أنواع_رموز = { الأنواع: الأنواع };
    أرجع السياق;
}

عرف أضف_نوع_رمز(
    السياق: &متغير سياق_أنواع_رموز,
    الرمز: معرف_رمز,
    النوع: معرف_نوع
): منطقي {
    دع الحالة: متغير سياق_أنواع_رموز = *السياق;
    بينما ((الطول(الحالة.الأنواع) مثل غير_موقع) <= الرمز.القيمة) {
        ألحق(الحالة.الأنواع, اختيار.لا_شيء());
    }
    الحالة.الأنواع[الرمز.القيمة] := اختيار.بعض(النوع);
    *السياق := الحالة;
    أرجع صواب;
}

عام عرف نوع_رمز_دلالي_عند(
    السياق: &سياق_أنواع_رموز,
    الرمز: معرف_رمز
): اختيار معرف_نوع {
    دع الحالة: سياق_أنواع_رموز = *السياق;
    لو (الرمز.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع الحالة.الأنواع[الرمز.القيمة];
}




عرف نطاق_نوع_تركيبي_داخلي(النوع: &نوع_تركيبي): نطاق {
    دع القيمة: نوع_تركيبي = *النوع;
    طابق القيمة مع
    | نوع_تركيبي.أي(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.منطقي(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.آلة(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.عدد(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.غير_موقع(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.حرف(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.نص(س) -> {
        أرجع س;
    }
    | نوع_تركيبي.صف(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.صندوق(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.اختيار(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.نتيجة(س, _, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.دالة(س, _, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.مسمى(س, _, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.مؤشر(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.مرجع(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.شريحة(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.متجه(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.متغير(س, _) -> {
        أرجع س;
    }
    | نوع_تركيبي.فراغ(س) -> {
        أرجع س;
    };
}

عرف رمز_اسم_مطلوب_للنوع(
    الروابط: &سياق_روابط_أسماء,
    الاسم: &اسم
): نتيجة معرف_رمز, خطأ_بناء_سياقات_أنواع {
    دع القيمة: اسم = *الاسم;
    طابق رمز_اسم_محلول_عند(الروابط, القيمة.النطاق) مع
    | اختيار.بعض(الرمز) -> {
        أرجع نتيجة.نجح(الرمز);
    }
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود(القيمة.النطاق));
    };
}

عرف هوية_اسم_مطلوبة_للنوع(
    الروابط: &سياق_روابط_أسماء,
    الاسم: &اسم
): نتيجة معرف_اسم, خطأ_بناء_سياقات_أنواع {
    دع القيمة: اسم = *الاسم;
    طابق معرف_اسم_محلول_عند(الروابط, القيمة.النطاق) مع
    | اختيار.بعض(الهوية) -> {
        أرجع نتيجة.نجح(الهوية);
    }
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.هوية_اسم_مفقودة(القيمة.النطاق));
    };
}

// Type owns canonical Symbol -> Type facts. Pattern owns semantic Pattern validation,
// while bindings introduced by a source pattern are ordinary Name Symbols consumed by
// expressions in that arm. These narrow helpers seed only those Symbol Type facts from
// the already-known discriminant Type; Pattern validates the structure independently.
عرف اربط_نوع_رمز_نمط_ربط(
    الاسم: &اسم,
    النوع: معرف_نوع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع القيمة: اسم = *الاسم;
    طابق رمز_اسم_محلول_عند(الروابط, القيمة.النطاق) مع
    | اختيار.بعض(الرمز) -> {
        أرجع أضف_نوع_رمز(أنواع_الرموز, الرمز, النوع);
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف اربط_أنواع_رموز_نمط_صف(
    العناصر: &متجه نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع القيم: متجه نمط = *العناصر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع نوع_الابن: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف) مع
        | اختيار.بعض(الموجود) -> { نوع_الابن := الموجود; }
        | اختيار.لا_شيء -> { أرجع خطأ; };
        لو (!اربط_أنواع_رموز_نمط_تركيبي(
            &القيم[ف], نوع_الابن, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اربط_أنواع_رموز_نمط_سجل(
    الحقول: &متجه حقل_نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع القيم: متجه حقل_نمط = *الحقول;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع قيمة_الاسم: اسم = القيم[ف].الاسم;
        دع هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
        طابق معرف_اسم_محلول_عند(الروابط, قيمة_الاسم.النطاق) مع
        | اختيار.بعض(الهوية) -> { هوية_الحقل := الهوية; }
        | اختيار.لا_شيء -> { أرجع خطأ; };
        دع نوع_الابن: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, النوع, هوية_الحقل) مع
        | اختيار.بعض(الموجود) -> { نوع_الابن := الموجود; }
        | اختيار.لا_شيء -> { أرجع خطأ; };
        لو (!اربط_أنواع_رموز_نمط_تركيبي(
            &القيم[ف].النمط, نوع_الابن, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف هوية_منشئ_مسمى_للنوع(
    اسم_النوع: &اسم,
    اسم_المنشئ: &اسم,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء
): اختيار هوية_منشئ_نوع {
    دع قيمة_اسم_النوع: اسم = *اسم_النوع;
    دع قيمة_اسم_المنشئ: اسم = *اسم_المنشئ;
    دع هوية_اسم_النوع: متغير معرف_اسم = معرف_اسم_من(0);
    دع هوية_اسم_المنشئ: متغير معرف_اسم = معرف_اسم_من(0);
    طابق معرف_اسم_محلول_عند(الروابط, قيمة_اسم_النوع.النطاق) مع
    | اختيار.بعض(الهوية) -> { هوية_اسم_النوع := الهوية; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    طابق معرف_اسم_محلول_عند(الروابط, قيمة_اسم_المنشئ.النطاق) مع
    | اختيار.بعض(الهوية) -> { هوية_اسم_المنشئ := الهوية; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };

    طابق هوية_منشئ_مدمج_دلالية_بالأسماء(
        سياق_الأسماء, الأنواع, النوع, هوية_اسم_النوع, هوية_اسم_المنشئ
    ) مع
    | اختيار.بعض(الهوية) -> { أرجع اختيار.بعض(الهوية); }
    | اختيار.لا_شيء -> { };

    طابق رمز_اسم_محلول_عند(الروابط, قيمة_اسم_المنشئ.النطاق) مع
    | اختيار.بعض(رمز_المنشئ) -> {
        أرجع هوية_منشئ_تعداد_دلالية_بالرمز(الأنواع, النوع, رمز_المنشئ);
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عرف اربط_أنواع_رموز_حمولات_منشئ(
    الحمولات: &متجه نمط,
    النوع: معرف_نوع,
    الهوية: هوية_منشئ_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع القيم: متجه نمط = *الحمولات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع نوع_الابن: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع, الهوية, ف) مع
        | اختيار.بعض(الموجود) -> { نوع_الابن := الموجود; }
        | اختيار.لا_شيء -> { أرجع خطأ; };
        لو (!اربط_أنواع_رموز_نمط_تركيبي(
            &القيم[ف], نوع_الابن, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اربط_أنواع_رموز_نمط_منشئ(
    اسم_النوع: &اسم,
    اسم_المنشئ: &اسم,
    الحمولات: &متجه نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    طابق هوية_منشئ_مسمى_للنوع(
        اسم_النوع, اسم_المنشئ, النوع, سياق_الأسماء, الأنواع, الروابط
    ) مع
    | اختيار.بعض(الهوية) -> {
        أرجع اربط_أنواع_رموز_حمولات_منشئ(
            الحمولات, النوع, الهوية, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف اربط_أنواع_رموز_نمط_تركيبي(
    النمط: &نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    دع القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.بدل(_) -> { أرجع صواب; }
    | نمط.ربط(_, الاسم) -> {
        أرجع اربط_نوع_رمز_نمط_ربط(&الاسم, النوع, الروابط, أنواع_الرموز);
    }
    | نمط.صف(_, العناصر) -> {
        أرجع اربط_أنواع_رموز_نمط_صف(
            &العناصر, النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | نمط.سجل(_, الحقول) -> {
        أرجع اربط_أنواع_رموز_نمط_سجل(
            &الحقول, النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | نمط.منشئ(_, اسم_النوع, اسم_المنشئ, الحمولات) -> {
        أرجع اربط_أنواع_رموز_نمط_منشئ(
            &اسم_النوع, &اسم_المنشئ, &الحمولات, النوع,
            سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    };
}

عرف رموز_معاملات_نوع_معلنة(
    المعاملات: &متجه اسم,
    الروابط: &سياق_روابط_أسماء
): اختيار متجه معرف_رمز {
    دع القيم: متجه اسم = *المعاملات;
    دع الناتج: متغير متجه معرف_رمز = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        طابق رمز_اسم_محلول_عند(الروابط, القيم[ف].النطاق) مع
        | اختيار.بعض(الرمز) -> { ألحق(الناتج, الرمز); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف سجل_قائمة_معاملات_نوع(
    المعاملات: &متجه اسم,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختيار خطأ_بناء_سياقات_أنواع {
    دع القيم: متجه اسم = *المعاملات;
    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول(القيم) مثل غير_موقع)) {
        طابق رمز_اسم_محلول_عند(الروابط, القيم[م].النطاق) مع
        | اختيار.بعض(الرمز) -> {
            دع النوع: معرف_نوع = سجل_معامل_نوع(الأنواع, الرمز);
            لو (!أضف_نوع_رمز(أنواع_الرموز, الرمز, النوع)) {
                أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(القيم[م].النطاق));
            };
        }
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود(القيم[م].النطاق));
        };
        م := م + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف سجل_معاملات_نوع_العناصر(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختيار خطأ_بناء_سياقات_أنواع {
    دع القيم: متجه عنصر_وحدة = *العناصر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_العنصر: &عنصر_وحدة = &القيم[ف];
        طابق *مرجع_العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            طابق سجل_قائمة_معاملات_نوع(&الدالة.معاملات_النوع, الروابط, الأنواع, أنواع_الرموز) مع
            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | اختيار.لا_شيء -> { };
        }
        | عنصر_وحدة.نوع(التصريح) -> {
            طابق سجل_قائمة_معاملات_نوع(&التصريح.معاملات_النوع, الروابط, الأنواع, أنواع_الرموز) مع
            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | اختيار.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أعلن_التراكيب_المسماة(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع
): اختيار خطأ_بناء_سياقات_أنواع {
    دع القيم: متجه عنصر_وحدة = *العناصر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_العنصر: &عنصر_وحدة = &القيم[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.نوع(التصريح) -> {
            طابق التصريح.الشكل مع
            | شكل_تصريح_نوع.سجل(_) -> {
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | نتيجة.نجح(الرمز) -> {
                    طابق رموز_معاملات_نوع_معلنة(&التصريح.معاملات_النوع, الروابط) مع
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    }
                    | اختيار.بعض(معاملات_النوع) -> {
                        لو (!أضف_سجل_نوع_بمعاملات(الأنواع, الرمز, معاملات_النوع)) {
                            أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                        };
                    };
                };
            }
            | شكل_تصريح_نوع.تعداد(_) -> {
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | نتيجة.نجح(الرمز) -> {
                    طابق رموز_معاملات_نوع_معلنة(&التصريح.معاملات_النوع, الروابط) مع
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    }
                    | اختيار.بعض(معاملات_النوع) -> {
                        لو (!أضف_تعداد_نوع_بمعاملات(الأنواع, الرمز, معاملات_النوع)) {
                            أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                        };
                    };
                };
            }
            | شكل_تصريح_نوع.مرادف(_) -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أكمل_المرادفات(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    علاقات_الهرم: &متغير متجه علاقة_هرم_نوع
): اختيار خطأ_بناء_سياقات_أنواع {
    دع القيم: متجه عنصر_وحدة = *العناصر;
    دع مكتملة: متغير متجه منطقي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        ألحق(مكتملة, خطأ);
        ف := ف + 1;
    }
    دع جولة: متغير غير_موقع = 0;
    بينما (جولة < (الطول(القيم) مثل غير_موقع)) {
        دع تقدم: متغير منطقي = خطأ;
        ف := 0;
        بينما (ف < (الطول(القيم) مثل غير_موقع)) {
            لو (!مكتملة[ف]) {
                دع مرجع_العنصر: &عنصر_وحدة = &القيم[ف];
                دع العنصر: عنصر_وحدة = *مرجع_العنصر;
                طابق العنصر مع
                | عنصر_وحدة.نوع(التصريح) -> {
                    طابق التصريح.الشكل مع
                    | شكل_تصريح_نوع.مرادف(الهدف) -> {
                        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الهدف) مع
                        | نتيجة_حل_نوع.موجود(نوع_الهدف) -> {
                            طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                            | نتيجة.خطأ(الخطأ) -> {
                                أرجع اختيار.بعض(الخطأ);
                            }
                            | نتيجة.نجح(الرمز) -> {
                                طابق الهدف مع
                                | نوع_تركيبي.مسمى(_, اسم_الهدف, _) -> {
                                    طابق رمز_اسم_محلول_عند(الروابط, اسم_الهدف.النطاق) مع
                                    | اختيار.بعض(رمز_الهدف) -> {
                                        دع العلاقة: علاقة_هرم_نوع = {
                                            النوع_الفرعي: الرمز,
                                            النوع_العلوي: رمز_الهدف
                                        };
                                        دع حالة_العلاقات: متغير متجه علاقة_هرم_نوع = *علاقات_الهرم;
                                        ألحق(حالة_العلاقات, العلاقة);
                                        *علاقات_الهرم := حالة_العلاقات;
                                    }
                                    | اختيار.لا_شيء -> { };
                                }
                                | _ -> { };
                                طابق رموز_معاملات_نوع_معلنة(&التصريح.معاملات_النوع, الروابط) مع
                                | اختيار.لا_شيء -> {
                                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                                }
                                | اختيار.بعض(معاملات_النوع) -> {
                                    لو (!أضف_مرادف_نوع_بمعاملات(الأنواع, الرمز, معاملات_النوع, نوع_الهدف)) {
                                        أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                                    };
                                };
                                مكتملة[ف] := صواب;
                                تقدم := صواب;
                            };
                        }
                        | نتيجة_حل_نوع.مفقود -> { }
                        | _ -> {
                            أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&الهدف)));
                        };
                    }
                    | _ -> {
                        مكتملة[ف] := صواب;
                    };
                }
                | _ -> {
                    مكتملة[ف] := صواب;
                };
            };
            ف := ف + 1;
        }
        لو (!تقدم) {
            جولة := الطول(القيم) مثل غير_موقع;
        }
        وإلا {
            جولة := جولة + 1;
        };
    }
    ف := 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (!مكتملة[ف]) {
            دع مرجع_العنصر: &عنصر_وحدة = &القيم[ف];
            دع العنصر: عنصر_وحدة = *مرجع_العنصر;
            طابق العنصر مع
            | عنصر_وحدة.نوع(التصريح) -> {
                طابق التصريح.الشكل مع
                | شكل_تصريح_نوع.مرادف(الهدف) -> {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&الهدف)));
                }
                | _ -> { };
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أكمل_التراكيب_المسماة(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختيار خطأ_بناء_سياقات_أنواع {
    دع القيم: متجه عنصر_وحدة = *العناصر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_العنصر: &عنصر_وحدة = &القيم[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.نوع(التصريح) -> {
            طابق التصريح.الشكل مع
            | شكل_تصريح_نوع.سجل(الحقول_النحوية) -> {
                دع الرمز: متغير معرف_رمز = معرف_رمز_من(0);
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | نتيجة.نجح(القيمة_رمز) -> {
                    الرمز := القيمة_رمز;
                };
                دع الحقول: متغير متجه حقل_سجل_دلالي = [];
                دع ح: متغير غير_موقع = 0;
                بينما (ح < (الطول(الحقول_النحوية) مثل غير_موقع)) {
                    دع نوع_الحقل: متغير معرف_نوع = معرف_نوع_من(0);
                    طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الحقول_النحوية[ح].النوع) مع
                    | نتيجة_حل_نوع.موجود(المعرف) -> {
                        نوع_الحقل := المعرف;
                    }
                    | _ -> {
                        أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                            نطاق_نوع_تركيبي_داخلي(&الحقول_النحوية[ح].النوع)
                        ));
                    };
                    طابق هوية_اسم_مطلوبة_للنوع(الروابط, &الحقول_النحوية[ح].الاسم) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختيار.بعض(الخطأ);
                    }
                    | نتيجة.نجح(هوية_الحقل) -> {
                        دع الحقل: حقل_سجل_دلالي = { الاسم: هوية_الحقل, النوع: نوع_الحقل };
                        ألحق(الحقول, الحقل);
                    };
                    ح := ح + 1;
                }
                لو (!أكمل_سجل_نوع_بحقول(الأنواع, الرمز, الحقول)) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
            }
            | شكل_تصريح_نوع.تعداد(المنشئات_النحوية) -> {
                دع رمز_التعداد: متغير معرف_رمز = معرف_رمز_من(0);
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | نتيجة.نجح(القيمة_رمز) -> {
                    رمز_التعداد := القيمة_رمز;
                };
                دع نوع_التعداد: متغير معرف_نوع = معرف_نوع_من(0);
                طابق حل_نوع_مسمى(الأنواع, رمز_التعداد) مع
                | نتيجة_حل_نوع.موجود(المعرف) -> {
                    نوع_التعداد := المعرف;
                }
                | _ -> {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
                دع المنشئات: متغير متجه منشئ_نوع_دلالي = [];
                دع م: متغير غير_موقع = 0;
                بينما (م < (الطول(المنشئات_النحوية) مثل غير_موقع)) {
                    دع رمز_المنشئ: متغير معرف_رمز = معرف_رمز_من(0);
                    طابق رمز_اسم_مطلوب_للنوع(الروابط, &المنشئات_النحوية[م].الاسم) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختيار.بعض(الخطأ);
                    }
                    | نتيجة.نجح(القيمة_رمز) -> {
                        رمز_المنشئ := القيمة_رمز;
                    };
                    دع اسم_المنشئ: متغير معرف_اسم = معرف_اسم_من(0);
                    طابق هوية_اسم_مطلوبة_للنوع(الروابط, &المنشئات_النحوية[م].الاسم) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختيار.بعض(الخطأ);
                    }
                    | نتيجة.نجح(الهوية) -> {
                        اسم_المنشئ := الهوية;
                    };
                    دع الحمولات: متغير متجه معرف_نوع = [];
                    دع أنواع_المعاملات: متغير متجه معرف_نوع = [];
                    دع ح: متغير غير_موقع = 0;
                    بينما (ح < (الطول(المنشئات_النحوية[م].الحمولات) مثل غير_موقع)) {
                        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &المنشئات_النحوية[م].الحمولات[ح]) مع
                        | نتيجة_حل_نوع.موجود(المعرف) -> {
                            ألحق(الحمولات, المعرف);
                            ألحق(أنواع_المعاملات, المعرف);
                        }
                        | _ -> {
                            أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                                نطاق_نوع_تركيبي_داخلي(&المنشئات_النحوية[م].الحمولات[ح])
                            ));
                        };
                        ح := ح + 1;
                    }
                    دع الهوية_الدلالية: هوية_منشئ_نوع = هوية_منشئ_نوع.تعداد(رمز_المنشئ);
                    دع الاسم_الدلالي: اختيار معرف_اسم = اختيار.بعض(اسم_المنشئ);
                    دع المنشئ: منشئ_نوع_دلالي = {
                        الهوية: الهوية_الدلالية,
                        الاسم: الاسم_الدلالي,
                        الحمولات: الحمولات
                    };
                    ألحق(المنشئات, المنشئ);
                    دع نوع_الدالة: معرف_نوع = قنن_نوعا(
                        الأنواع,
                        نوع_مقنن.دالة(أنواع_المعاملات, نوع_التعداد)
                    );
                    لو (!أضف_نوع_رمز(أنواع_الرموز, رمز_المنشئ, نوع_الدالة)) {
                        أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(المنشئات_النحوية[م].الاسم.النطاق));
                    };
                    م := م + 1;
                }
                لو (!أكمل_تعداد_نوع_بمنشئات(الأنواع, رمز_التعداد, المنشئات)) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
            }
            | شكل_تصريح_نوع.مرادف(_) -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

نوع نتيجة_نوع_تعبير_داخلية =
    | موجود بنوع معرف_نوع
    | خطأ بنوع خطأ_بناء_سياقات_أنواع
;

عرف نوع_بدائي_للخط(
    الأنواع: &متغير سجل_أنواع,
    البدائي: نوع_بدائي_مقنن
): معرف_نوع {
    أرجع قنن_نوعا_بدائيا(الأنواع, البدائي);
}

عرف ابن_أنواع_استدعاء_بدائي_مقننة(
    الأنواع: &متغير سجل_أنواع
): أنواع_استدعاء_بدائي_مقننة {
    دع النص: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
    دع العدد: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.عدد());
    دع البايت: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.غ8());
    دع القيم: أنواع_استدعاء_بدائي_مقننة = {
        النص: النص,
        العدد: العدد,
        البايت: البايت
    };
    أرجع القيم;
}

عرف نوع_حرفي_داخلي(
    الأنواع: &متغير سجل_أنواع,
    الحرفي: &حرفي
): معرف_نوع {
    دع القيمة: حرفي = *الحرفي;
    طابق القيمة مع
    | حرفي.منطقي(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
    }
    | حرفي.عدد(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.عدد());
    }
    | حرفي.عدد_غير_موقع(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.غ64());
    }
    | حرفي.عدد_عشري(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ع64());
    }
    | حرفي.حرف(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.حرف());
    }
    | حرفي.نص(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
    }
    | حرفي.غير_معرف -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.أي());
    };
}

عرف نوع_فك_داخلي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختيار معرف_نوع {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الأساس) -> {
        طابق الأساس مع
        | نوع_مقنن.مؤشر(الداخل) -> {
            أرجع اختيار.بعض(الداخل);
        }
        | نوع_مقنن.مرجع(الداخل, _) -> {
            أرجع اختيار.بعض(الداخل);
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع اختيار.بعض(الداخل);
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}

عرف نوع_عنصر_فهرسة_داخلي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختيار معرف_نوع {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الأساس) -> {
        طابق الأساس مع
        | نوع_مقنن.متجه(الداخل) -> {
            أرجع اختيار.بعض(الداخل);
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            أرجع اختيار.بعض(الداخل);
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            أرجع اختيار.بعض(الداخل);
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع اختيار.بعض(الداخل);
        }
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.نص) -> {
            أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.غ8());
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}

عرف سجل_نوع_تعبير_داخلي(
    الأنواع: &سجل_أنواع,
    السياق: &متغير سياق_أنواع_تعبيرات,
    التعبير: &تعبير,
    النوع: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    لو (!أضف_نوع_تعبير(الأنواع, السياق, نطاق_تعبير(التعبير), النوع)) {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
        );
    };
    أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع);
}

نوع قيمة_عدد_صحيح_سياقية =
    | موقع بنوع عدد
    | غير_موقع بنوع غير_موقع
;

عرف قيمة_عدد_صحيح_سياقية_لتعبير(التعبير: &تعبير): اختيار قيمة_عدد_صحيح_سياقية {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, حرفي.عدد(العدد)) -> {
        أرجع اختيار.بعض(قيمة_عدد_صحيح_سياقية.موقع(العدد));
    }
    | تعبير.حرفي(_, حرفي.عدد_غير_موقع(العدد)) -> {
        أرجع اختيار.بعض(قيمة_عدد_صحيح_سياقية.غير_موقع(العدد));
    }
    | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الداخل) مع
        | اختيار.بعض(القيمة_السياقية) -> {
            طابق القيمة_السياقية مع
            | قيمة_عدد_صحيح_سياقية.موقع(العدد) -> {
                أرجع اختيار.بعض(قيمة_عدد_صحيح_سياقية.موقع(0 - العدد));
            }
            | قيمة_عدد_صحيح_سياقية.غير_موقع(_) -> {
                أرجع اختيار.لا_شيء();
            };
        }
        | اختيار.لا_شيء -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف سجل_نوع_عدد_صحيح_سياقي(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    التعبير: &تعبير,
    النوع: معرف_نوع
): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, حرفي.عدد(_)) -> {
        أرجع أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع);
    }
    | تعبير.حرفي(_, حرفي.عدد_غير_موقع(_)) -> {
        أرجع أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع);
    }
    | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        لو (!سجل_نوع_عدد_صحيح_سياقي(الأنواع, أنواع_التعبيرات, &الداخل, النوع)) {
            أرجع خطأ;
        };
        أرجع أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع);
    }
    | _ -> {
        أرجع خطأ;
    };
}

نوع موضع_توقع_نوع =
    | مفهرس بنوع غير_موقع
    | بدائي بنوع (هوية_بدائي_مترجم, غير_موقع)
    | إرجاع
;

عرف خطأ_عدم_توافق_نوع_متوقع(
    الموضع: موضع_توقع_نوع,
    النطاق: نطاق,
    المتوقع: معرف_نوع,
    الموجود: معرف_نوع
): خطأ_بناء_سياقات_أنواع {
    طابق الموضع مع
    | موضع_توقع_نوع.مفهرس(الفهرس) -> {
        أرجع خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
            النطاق, الفهرس, المتوقع, الموجود
        );
    }
    | موضع_توقع_نوع.بدائي(البدائي, الفهرس) -> {
        أرجع خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_مطابق(
            النطاق, البدائي, الفهرس, المتوقع, الموجود
        );
    }
    | موضع_توقع_نوع.إرجاع -> {
        أرجع خطأ_بناء_سياقات_أنواع.نوع_إرجاع_غير_مطابق(
            النطاق, المتوقع, الموجود
        );
    };
}

عرف هل_نوع_عدد_صحيح_سياقي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(نوع_مقنن.بدائي(البدائي)) -> {
        طابق صنف_النوع_البدائي(البدائي) مع
        | صنف_نوع_بدائي.عدد_موقع -> {
            أرجع صواب;
        }
        | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | اختيار.بعض(_) -> {
        أرجع خطأ;
    };
}

عرف هل_نوع_عشري_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.بعض(نوع_مقنن.بدائي(البدائي)) -> {
        أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري();
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_عامل_ثنائي_ينتج_عشريا(العامل: عامل_ثنائي): منطقي {
    طابق العامل مع
    | عامل_ثنائي.جمع -> { أرجع صواب; }
    | عامل_ثنائي.طرح -> { أرجع صواب; }
    | عامل_ثنائي.ضرب -> { أرجع صواب; }
    | عامل_ثنائي.قسمة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_عشري_سياقي(التعبير: &تعبير): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, حرفي.عدد_عشري(_)) -> { أرجع صواب; }
    | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        أرجع هل_تعبير_عشري_سياقي(&الداخل);
    }
    | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
        لو (!هل_عامل_ثنائي_ينتج_عشريا(العامل)) { أرجع خطأ; };
        دع اليسار: تعبير = *اليسار_المملوك;
        دع اليمين: تعبير = *اليمين_المملوك;
        أرجع هل_تعبير_عشري_سياقي(&اليسار) && هل_تعبير_عشري_سياقي(&اليمين);
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_نوع_منطقي_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.بعض(نوع_مقنن.بدائي(نوع_بدائي_مقنن.منطقي)) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_نوع_فراغ_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.بعض(نوع_مقنن.بدائي(نوع_بدائي_مقنن.فراغ)) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_نوع_مغلف_بمتغير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    دع الحالة: سجل_أنواع = *الأنواع;
    لو (النوع.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع)) { أرجع خطأ; };
    دع مرجع_النوع: &نوع_مقنن = &الحالة.الأنواع[النوع.القيمة];
    طابق *مرجع_النوع مع
    | نوع_مقنن.متغير(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_موضع_دلالي(التعبير: &تعبير): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, _) -> { أرجع صواب; }
    | تعبير.حقل(_, _, _) -> { أرجع صواب; }
    | تعبير.فهرس(_, _, _) -> { أرجع صواب; }
    | تعبير.فك_موضع(_, _) -> { أرجع صواب; }
    | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_فهرسة_دلالي(التعبير: &تعبير): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.فهرس(_, _, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_موضع_قابل_للتغيير(
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): منطقي {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, _) -> {
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير)) مع
        | اختيار.بعض(النوع) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, النوع); }
        | _ -> { أرجع خطأ; };
    }
    | تعبير.حقل(_, الأساس_المملوك, _) -> {
        دع الأساس: تعبير = *الأساس_المملوك;
        أرجع هل_موضع_قابل_للتغيير(&الأساس, الأنواع, أنواع_التعبيرات);
    }
    | تعبير.فهرس(_, الأساس_المملوك, _) -> {
        دع الأساس: تعبير = *الأساس_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختيار.بعض(نوع_الأساس) -> {
            طابق نوع_أساس_عند(الأنواع, نوع_الأساس) مع
            | اختيار.بعض(نوع_مقنن.بدائي(نوع_بدائي_مقنن.نص)) -> { أرجع خطأ; }
            | _ -> { };
        }
        | _ -> { أرجع خطأ; };
        لو (هل_موضع_قابل_للتغيير(&الأساس, الأنواع, أنواع_التعبيرات)) { أرجع صواب; };
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختيار.بعض(نوع_الأساس) -> {
            طابق نوع_أساس_عند(الأنواع, نوع_الأساس) مع
            | اختيار.بعض(نوع_مقنن.مؤشر(الداخل)) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, الداخل); }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    }
    | تعبير.فك_موضع(_, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الداخل)) مع
        | اختيار.بعض(نوع_الداخل) -> {
            طابق نوع_أساس_عند(الأنواع, نوع_الداخل) مع
            | اختيار.بعض(نوع_مقنن.مرجع(_, متغير_المرجع)) -> { أرجع متغير_المرجع; }
            | اختيار.بعض(نوع_مقنن.مؤشر(نوع_العنصر)) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_العنصر); }
            | اختيار.بعض(نوع_مقنن.صندوق(نوع_الصندوق)) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_الصندوق); }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    }
    | تعبير.أحادي(_, عامل_أحادي.فك, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الداخل)) مع
        | اختيار.بعض(نوع_الداخل) -> {
            طابق نوع_أساس_عند(الأنواع, نوع_الداخل) مع
            | اختيار.بعض(نوع_مقنن.مرجع(_, متغير_المرجع)) -> { أرجع متغير_المرجع; }
            | اختيار.بعض(نوع_مقنن.مؤشر(نوع_العنصر)) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_العنصر); }
            | اختيار.بعض(نوع_مقنن.صندوق(نوع_الصندوق)) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_الصندوق); }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل: عامل_ثنائي): منطقي {
    طابق العامل مع
    | عامل_ثنائي.أو_بتي -> { أرجع صواب; }
    | عامل_ثنائي.أو_حصري -> { أرجع صواب; }
    | عامل_ثنائي.و_بتي -> { أرجع صواب; }
    | عامل_ثنائي.إزاحة_يسرى -> { أرجع صواب; }
    | عامل_ثنائي.إزاحة_يمنى -> { أرجع صواب; }
    | عامل_ثنائي.إزاحة_حسابية_يمنى -> { أرجع صواب; }
    | عامل_ثنائي.جمع -> { أرجع صواب; }
    | عامل_ثنائي.طرح -> { أرجع صواب; }
    | عامل_ثنائي.ضرب -> { أرجع صواب; }
    | عامل_ثنائي.قسمة -> { أرجع صواب; }
    | عامل_ثنائي.باقي -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف انسخ_تعبير_سياقي_عند(القيم: &متجه تعبير, الموضع: غير_موقع): تعبير {
    دع الحالة: متجه تعبير = *القيم;
    دع المرجع: &تعبير = &الحالة[الموضع];
    أرجع *المرجع;
}

عرف هل_تعبير_عدد_صحيح_سياقي(التعبير: &تعبير): منطقي {
    دع الانتظار: متغير متجه تعبير = [];
    ألحق(الانتظار, *التعبير);
    دع الموضع: متغير غير_موقع = 0;

    بينما (الموضع < (الطول(الانتظار) مثل غير_موقع)) {
        دع القيمة: تعبير = انسخ_تعبير_سياقي_عند(&الانتظار, الموضع);
        الموضع := الموضع + 1;
        طابق القيمة مع
        | تعبير.حرفي(_, حرفي.عدد(_)) -> { }
        | تعبير.حرفي(_, حرفي.عدد_غير_موقع(_)) -> { }
        | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
            ألحق(الانتظار, *الداخل_المملوك);
        }
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            لو (!هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل)) {
                أرجع خطأ;
            };
            ألحق(الانتظار, *اليسار_المملوك);
            ألحق(الانتظار, *اليمين_المملوك);
        }
        | _ -> {
            أرجع خطأ;
        };
    }

    أرجع صواب;
}

عرف رمز_مستدعى_محلول_للنوع(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    المستدعى: &تعبير
): اختيار معرف_رمز {
    دع القيمة: تعبير = *المستدعى;
    دع الرمز: متغير اختيار معرف_رمز = اختيار.لا_شيء();
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> {
        الرمز := رمز_اسم_محلول_عند(الروابط, الاسم.النطاق);
    }
    | تعبير.حقل(_, _, الاسم) -> {
        الرمز := رمز_اسم_محلول_عند(الروابط, الاسم.النطاق);
    }
    | _ -> { };
    طابق الرمز مع
    | اختيار.بعض(المعرف) -> {
        طابق نوع_رمز_عند(سياق_الأسماء, المعرف) مع
        | اختيار.بعض(نوع_تصريح.دالة) -> { أرجع اختيار.بعض(المعرف); }
        | اختيار.بعض(نوع_تصريح.دالة_خارجية) -> { أرجع اختيار.بعض(المعرف); }
        | _ -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع اختيار.لا_شيء();
}

عرف ابن_نوع_استدعاء_عادي_بتوقع_داخلي(
    التعبير: &تعبير,
    المستدعى: &تعبير,
    الحجج: &متجه تعبير,
    النوع_المتوقع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    دع قيم_الحجج: متجه تعبير = *الحجج;
    دع نوع_المستدعى: متغير معرف_نوع = معرف_نوع_من(0);
    طابق ابن_نوع_تعبير_داخلي(
        المستدعى, سياق_الأسماء, الأنواع,
        أنواع_التعبيرات, الروابط, أنواع_الرموز
    ) مع
    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
    }
    | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
        نوع_المستدعى := النوع;
    };

    دع الاستبدالات_الأولية: متجه ربط_استبدال_نوع = استنتج_استبدالات_ناتج_استدعاء(
        الأنواع, نوع_المستدعى, النوع_المتوقع
    );
    دع الاستبدالات_الحالية: متغير متجه ربط_استبدال_نوع = الاستبدالات_الأولية;
    دع أنواع_الحجج: متغير متجه معرف_نوع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(قيم_الحجج) مثل غير_موقع)) {
        دع نتيجة_الحجة: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&قيم_الحجج[ف]))
        );
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
        | اختيار.بعض(المتوقع_الخام) -> {
            دع المتوقع: معرف_نوع = استبدل_نوعا(
                الأنواع, المتوقع_الخام, &الاستبدالات_الحالية
            );
            لو (هل_نوع_يحوي_معامل_نوع(الأنواع, المتوقع)) {
                نتيجة_الحجة := ابن_نوع_تعبير_داخلي(
                    &قيم_الحجج[ف], سياق_الأسماء, الأنواع,
                    أنواع_التعبيرات, الروابط, أنواع_الرموز
                );
            } وإلا {
                نتيجة_الحجة := ابن_نوع_تعبير_بتوقع_داخلي(
                    &قيم_الحجج[ف], المتوقع, موضع_توقع_نوع.مفهرس(ف), سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                );
            };
        }
        | اختيار.لا_شيء -> {
            نتيجة_الحجة := ابن_نوع_تعبير_داخلي(
                &قيم_الحجج[ف], سياق_الأسماء, الأنواع,
                أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        };
        طابق نتيجة_الحجة مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            ألحق(أنواع_الحجج, النوع);
            طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
            | اختيار.بعض(المتوقع_الخام) -> {
                لو (!أضف_استبدالات_من_معامل_استدعاء(
                    الأنواع, المتوقع_الخام, النوع, &متغير الاستبدالات_الحالية
                )) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                            نطاق_تعبير(&قيم_الحجج[ف]), ف, المتوقع_الخام, النوع
                        )
                    );
                };
            }
            | اختيار.لا_شيء -> { };
        };
        ف := ف + 1;
    }

    طابق تحقق_توقيع_استدعاء_باستبدالات(
        الأنواع, نوع_المستدعى, &أنواع_الحجج, &الاستبدالات_الحالية
    ) مع
    | نتيجة_توقيع_استدعاء.صالح(الناتج, استبدالات_النوع) -> {
        دع نطاقات_الحجج: متغير متجه نطاق = [];
        دع ح: متغير غير_موقع = 0;
        بينما (ح < (الطول(قيم_الحجج) مثل غير_موقع)) {
            ألحق(نطاقات_الحجج, نطاق_تعبير(&قيم_الحجج[ح]));
            ح := ح + 1;
        }
        دع رمز_الاستدعاء: اختيار معرف_رمز = رمز_مستدعى_محلول_للنوع(
            سياق_الأسماء, الروابط, المستدعى
        );
        أضف_استدعاء_نوعيا(
            أنواع_التعبيرات, نطاق_تعبير(التعبير), نوع_المستدعى,
            رمز_الاستدعاء, نطاقات_الحجج, استبدالات_النوع
        );
        أرجع سجل_نوع_تعبير_داخلي(
            الأنواع, أنواع_التعبيرات, التعبير, الناتج
        );
    }
    | نتيجة_توقيع_استدعاء.مرفوض(خطأ_التوقيع) -> {
        طابق خطأ_التوقيع مع
        | خطأ_توقيع_استدعاء.غير_قابل_للاستدعاء -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(
                    نطاق_تعبير(التعبير), نوع_المستدعى
                )
            );
        }
        | خطأ_توقيع_استدعاء.عدد_حجج_غير_مطابق(المتوقع, الموجود) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                    نطاق_تعبير(التعبير), المتوقع, الموجود
                )
            );
        }
        | خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                    نطاق_تعبير(&قيم_الحجج[الفهرس]), الفهرس, المتوقع, الموجود
                )
            );
        };
    };
}

عرف ابن_نوع_تعبير_بتوقع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    الموضع: موضع_توقع_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    // Option/Result constructors are context-typed. Name records their source identities
    // without inventing Symbols; Type resolves them against the expected tagged Type.
    دع قيمة_متوقعة: تعبير = *التعبير;
    طابق قيمة_متوقعة مع
    | تعبير.استدعاء(_, المستدعى_المملوك, الحجج_المضمنة) -> {
        دع المستدعى_المضمن: تعبير = *المستدعى_المملوك;
        طابق المستدعى_المضمن مع
        | تعبير.حقل(_, الأصل_المملوك, اسم_المنشئ) -> {
            دع الأصل_المضمن: تعبير = *الأصل_المملوك;
            طابق الأصل_المضمن مع
            | تعبير.اسم(_, اسم_النوع) -> {
                طابق معرف_اسم_محلول_عند(الروابط, اسم_النوع.النطاق) مع
                    | اختيار.بعض(هوية_اسم_النوع) -> {
                        طابق معرف_اسم_محلول_عند(الروابط, اسم_المنشئ.النطاق) مع
                        | اختيار.بعض(هوية_اسم_المنشئ) -> {
                            طابق هوية_منشئ_مسمى_للنوع(
                                &اسم_النوع, &اسم_المنشئ, النوع_المتوقع,
                                سياق_الأسماء, الأنواع, الروابط
                            ) مع
                            | اختيار.بعض(هوية_المنشئ) -> {
                                طابق وصف_منشئ_نوع_دلالي_بالهوية(
                                    الأنواع, النوع_المتوقع, هوية_المنشئ
                                ) مع
                                | اختيار.بعض(الوصف) -> {
                                    دع عدد_الحجج: غير_موقع = الطول(الحجج_المضمنة) مثل غير_موقع;
                                    لو (عدد_الحجج != الوصف.عدد_الحمولات) {
                                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                            خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                                                نطاق_تعبير(التعبير), الوصف.عدد_الحمولات, عدد_الحجج
                                            )
                                        );
                                    };
                                    دع ف_حمولة: متغير غير_موقع = 0;
                                    بينما (ف_حمولة < الوصف.عدد_الحمولات) {
                                        طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(
                                            الأنواع, النوع_المتوقع, هوية_المنشئ, ف_حمولة
                                        ) مع
                                        | اختيار.بعض(نوع_الحمولة) -> {
                                            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                                                &الحجج_المضمنة[ف_حمولة], نوع_الحمولة,
                                                موضع_توقع_نوع.مفهرس(ف_حمولة), سياق_الأسماء,
                                                الأنواع, أنواع_التعبيرات,
                                                الروابط, أنواع_الرموز
                                            ) مع
                                            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                                                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
                                            }
                                            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                                        }
                                        | اختيار.لا_شيء -> {
                                            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                                خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                                                    نطاق_تعبير(التعبير)
                                                )
                                            );
                                        };
                                        ف_حمولة := ف_حمولة + 1;
                                    }
                                    لو (!أضف_نوع_تعبير_بمنشئ(
                                        الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير),
                                        النوع_المتوقع, اسم_المنشئ.النطاق, هوية_المنشئ
                                    )) {
                                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                                                نطاق_تعبير(التعبير)
                                            )
                                        );
                                    };
                                    أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع_المتوقع);
                                }
                                | اختيار.لا_شيء -> { };
                            }
                            | اختيار.لا_شيء -> { };
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> { };
            }
            | _ -> { };
        }
        | _ -> { };
    }
    | _ -> { };

    // Ordinary generic calls may infer type parameters from the expected result Type.
    // Primitive calls retain their identity-owned semantic path below.
    دع قيمة_استدعاء_متوقعة: تعبير = *التعبير;
    طابق قيمة_استدعاء_متوقعة مع
    | تعبير.استدعاء(_, المستدعى_المملوك_المتوقع, الحجج_المتوقعة) -> {
        دع المستدعى_المتوقع: تعبير = *المستدعى_المملوك_المتوقع;
        دع استدعاء_عام: متغير منطقي = خطأ;
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&المستدعى_المتوقع)) مع
        | اختيار.بعض(رمز_المستدعى) -> {
            طابق هوية_بدائي_رمز_عند(سياق_الأسماء, رمز_المستدعى) مع
            | اختيار.بعض(_) -> { }
            | اختيار.لا_شيء -> {
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, رمز_المستدعى) مع
                | اختيار.بعض(نوع_المستدعى) -> {
                    استدعاء_عام := هل_نوع_يحوي_معامل_نوع(الأنواع, نوع_المستدعى);
                }
                | اختيار.لا_شيء -> { };
            };
        }
        | اختيار.لا_شيء -> { };
        لو (استدعاء_عام) {
            أرجع ابن_نوع_استدعاء_عادي_بتوقع_داخلي(
                التعبير, &المستدعى_المتوقع, &الحجج_المتوقعة, النوع_المتوقع,
                سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        };
    }
    | _ -> { };

    لو (هل_نوع_عشري_دلالي(الأنواع, النوع_المتوقع) && هل_تعبير_عشري_سياقي(التعبير)) {
        دع قيمة_عشرية: تعبير = *التعبير;
        طابق قيمة_عشرية مع
        | تعبير.حرفي(_, حرفي.عدد_عشري(_)) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
            دع الداخل: تعبير = *الداخل_المملوك;
            طابق ابن_نوع_تعبير_بتوقع_داخلي(&الداخل, النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            لو (!هل_عامل_ثنائي_ينتج_عشريا(العامل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
            };
            دع اليسار: تعبير = *اليسار_المملوك;
            دع اليمين: تعبير = *اليمين_المملوك;
            طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | _ -> { };
    };

    لو (هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع_المتوقع)) {
        دع قيمة_التعبير: تعبير = *التعبير;
        طابق قيمة_التعبير مع
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            لو (هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل)) {
                دع اليسار: تعبير = *اليسار_المملوك;
                دع اليمين: تعبير = *اليمين_المملوك;
                طابق ابن_نوع_تعبير_بتوقع_داخلي(
                    &اليسار, النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع,
                    أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
                }
                | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                طابق ابن_نوع_تعبير_بتوقع_داخلي(
                    &اليمين, النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع,
                    أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
                }
                | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                أرجع سجل_نوع_تعبير_داخلي(
                    الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع
                );
            };
        }
        | _ -> { };
    };

    طابق قيمة_عدد_صحيح_سياقية_لتعبير(التعبير) مع
    | اختيار.بعض(القيمة) -> {
        دع يلائم: متغير منطقي = خطأ;
        طابق القيمة مع
        | قيمة_عدد_صحيح_سياقية.موقع(العدد) -> {
            يلائم := هل_عدد_صحيح_يلائم(الأنواع, العدد, النوع_المتوقع);
        }
        | قيمة_عدد_صحيح_سياقية.غير_موقع(العدد) -> {
            يلائم := هل_عدد_صحيح_غير_موقع_يلائم(الأنواع, العدد, النوع_المتوقع);
        };
        لو (!يلائم) {
            دع نوع_العدد: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.عدد());
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_عدم_توافق_نوع_متوقع(
                    الموضع, نطاق_تعبير(التعبير), النوع_المتوقع, نوع_العدد
                )
            );
        };
        لو (!سجل_نوع_عدد_صحيح_سياقي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع)) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
            );
        };
        أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع_المتوقع);
    }
    | اختيار.لا_شيء -> { };

    طابق ابن_نوع_تعبير_داخلي(
        التعبير, سياق_الأسماء, الأنواع,
        أنواع_التعبيرات, الروابط, أنواع_الرموز
    ) مع
    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
    }
    | نتيجة_نوع_تعبير_داخلية.موجود(النوع_الموجود) -> {
        لو (!هل_تحويل_ضمني_آمن(الأنواع, النوع_الموجود, النوع_المتوقع)) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_عدم_توافق_نوع_متوقع(
                    الموضع, نطاق_تعبير(التعبير), النوع_المتوقع, النوع_الموجود
                )
            );
        };
        أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع_الموجود);
    };
}

عرف ابن_نوع_تعبير_متوقع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    فهرس_المصدر: غير_موقع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    أرجع ابن_نوع_تعبير_بتوقع_داخلي(
        التعبير, النوع_المتوقع, موضع_توقع_نوع.مفهرس(فهرس_المصدر),
        سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    );
}

عرف ابن_نوع_تعبير_إرجاع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    أرجع ابن_نوع_تعبير_بتوقع_داخلي(
        التعبير, النوع_المتوقع, موضع_توقع_نوع.إرجاع(),
        سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    );
}

عرف ابن_نوع_تعبير_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, الحرفي) -> {
        دع النوع: معرف_نوع = نوع_حرفي_داخلي(الأنواع, &الحرفي);
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_مطلوب_للنوع(الروابط, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة.نجح(الرمز) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
            | اختيار.بعض(النوع) -> {
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
            }
            | اختيار.لا_شيء -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(الرمز, الاسم.النطاق));
            };
        };
    }
    | تعبير.حقل(_, الأساس_المملوك, الاسم) -> {
        // Name decides whether this field-shaped occurrence is a constructor. Type consumes
        // that Symbol before typing the syntactic qualifier, so no spelling-based type lookup occurs.
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختيار.بعض(رمز_العضو) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, رمز_العضو) مع
            | اختيار.بعض(نوع_العضو) -> {
                طابق نوع_رمز_عند(سياق_الأسماء, رمز_العضو) مع
                | اختيار.بعض(نوع_تصريح.منشئ_تعداد) -> {
                    دع الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.تعداد(رمز_العضو);
                    لو (!أضف_نوع_تعبير_بمنشئ(
                        الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير),
                        نوع_العضو, الاسم.النطاق, الهوية
                    )) {
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
                        );
                    };
                    أرجع نتيجة_نوع_تعبير_داخلية.موجود(نوع_العضو);
                }
                | _ -> {
                    أرجع سجل_نوع_تعبير_داخلي(
                        الأنواع, أنواع_التعبيرات, التعبير, نوع_العضو
                    );
                };
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
        دع الأساس: تعبير = *الأساس_المملوك;
        دع نوع_الأساس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الأساس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            نوع_الأساس := النوع;
        };
        طابق هوية_اسم_مطلوبة_للنوع(الروابط, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة.نجح(هوية_الحقل) -> {
            طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, نوع_الأساس, هوية_الحقل) مع
            | اختيار.بعض(نوع_الحقل) -> {
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الحقل);
            }
            | اختيار.لا_شيء -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف(الاسم.النطاق)
                );
            };
        };
    }
    | تعبير.فهرس(_, الأساس_المملوك, الفهرس_المملوك) -> {
        دع الأساس: تعبير = *الأساس_المملوك;
        دع الفهرس: تعبير = *الفهرس_المملوك;
        دع نوع_الأساس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الأساس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            نوع_الأساس := النوع;
        };
        دع نوع_الفهرس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الفهرس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الفهرس := النوع; };
        لو (!هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_الفهرس)) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الفهرس))
            );
        };

        طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الأساس) مع
        | اختيار.بعض(عدد_العناصر) -> {
            طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الفهرس) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
                );
            }
            | اختيار.بعض(القيمة_السياقية) -> {
                دع فهرس_العنصر: متغير غير_موقع = 0;
                طابق القيمة_السياقية مع
                | قيمة_عدد_صحيح_سياقية.موقع(الموضع) -> {
                    لو (الموضع < 0) {
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
                        );
                    };
                    فهرس_العنصر := الموضع مثل غير_موقع;
                }
                | قيمة_عدد_صحيح_سياقية.غير_موقع(الموضع) -> {
                    فهرس_العنصر := الموضع;
                };
                لو (فهرس_العنصر >= عدد_العناصر) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
                    );
                };
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الأساس, فهرس_العنصر) مع
                | اختيار.بعض(نوع_العنصر) -> {
                    أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_العنصر);
                }
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
                    );
                };
            };
        }
        | اختيار.لا_شيء -> { };

        طابق نوع_عنصر_فهرسة_داخلي(الأنواع, نوع_الأساس) مع
        | اختيار.بعض(نوع_العنصر) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_العنصر);
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
            );
        };
    }
    | تعبير.فك_موضع(_, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الداخل) -> {
            طابق نوع_فك_داخلي(الأنواع, نوع_الداخل) مع
            | اختيار.بعض(النوع) -> {
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
            }
            | اختيار.لا_شيء -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
                );
            };
        };
    }
    | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
        دع اليسار: تعبير = *اليسار_المملوك;
        دع اليمين: تعبير = *اليمين_المملوك;
        دع نوع_اليسار: متغير معرف_نوع = معرف_نوع_من(0);
        دع نوع_اليمين: متغير معرف_نوع = معرف_نوع_من(0);
        دع اليسار_سياقي: منطقي = هل_تعبير_عدد_صحيح_سياقي(&اليسار);
        دع اليمين_سياقي: منطقي = هل_تعبير_عدد_صحيح_سياقي(&اليمين);
        دع اليسار_عشري_سياقي: منطقي = هل_تعبير_عشري_سياقي(&اليسار);
        دع اليمين_عشري_سياقي: منطقي = هل_تعبير_عشري_سياقي(&اليمين);

        لو (اليسار_عشري_سياقي && !اليمين_عشري_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            لو (هل_نوع_عشري_دلالي(الأنواع, نوع_اليمين)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, نوع_اليمين, موضع_توقع_نوع.مفهرس(0), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            };
        } وإلا لو (اليمين_عشري_سياقي && !اليسار_عشري_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            لو (هل_نوع_عشري_دلالي(الأنواع, نوع_اليسار)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, نوع_اليسار, موضع_توقع_نوع.مفهرس(1), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            };
        } وإلا لو (اليسار_سياقي && !اليمين_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            لو (هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليمين)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, نوع_اليمين, موضع_توقع_نوع.مفهرس(0), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            };
        } وإلا لو (اليمين_سياقي && !اليسار_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            لو (هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليسار)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, نوع_اليسار, موضع_توقع_نوع.مفهرس(1), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            };
        } وإلا {
            طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
        };

        طابق العامل مع
        | عامل_ثنائي.أو -> {
            لو (!هل_نوع_منطقي_دلالي(الأنواع, نوع_اليسار) || !هل_نوع_منطقي_دلالي(الأنواع, نوع_اليمين)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
            };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.و -> {
            لو (!هل_نوع_منطقي_دلالي(الأنواع, نوع_اليسار) || !هل_نوع_منطقي_دلالي(الأنواع, نوع_اليمين)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
            };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.يساوي -> {
            لو (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.لا_يساوي -> {
            لو (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.أصغر -> {
            لو (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.أصغر_أو_يساوي -> {
            لو (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.أكبر_أو_يساوي -> {
            لو (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_ثنائي.أكبر -> {
            لو (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))); };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | _ -> {
            دع صحيحان: منطقي = هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليسار) && هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليمين);
            دع عشريان: منطقي = هل_نوع_عشري_دلالي(الأنواع, نوع_اليسار) && هل_نوع_عشري_دلالي(الأنواع, نوع_اليمين) && هل_عامل_ثنائي_ينتج_عشريا(العامل);
            لو ((!صحيحان && !عشريان) || !نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
            };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_اليسار);
        };
    }
    | تعبير.أحادي(_, العامل, الداخل_المملوك) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        دع نوع_الداخل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الداخل := النوع; };
        طابق العامل مع
        | عامل_أحادي.نفي -> {
            لو (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الداخل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
            };
            دع النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_أحادي.متمم -> {
            لو (!هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_الداخل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
            };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الداخل);
        }
        | عامل_أحادي.سالب -> {
            لو (!هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_الداخل) && !هل_نوع_عشري_دلالي(الأنواع, نوع_الداخل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
            };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الداخل);
        }
        | عامل_أحادي.فك -> {
            طابق نوع_فك_داخلي(الأنواع, نوع_الداخل) مع
            | اختيار.بعض(النوع) -> { أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع); }
            | اختيار.لا_شيء -> { };
        }
        | عامل_أحادي.عنوان -> {
            لو (!هل_تعبير_موضع_دلالي(&الداخل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
            };
            دع نوع_المرجع: متغير معرف_نوع = نوع_الداخل;
            طابق أزل_غلاف_متغير(الأنواع, نوع_الداخل) مع
            | اختيار.بعض(الأساس) -> { نوع_المرجع := الأساس; }
            | اختيار.لا_شيء -> { };
            دع النوع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_المرجع, خطأ));
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_أحادي.عنوان_متغير -> {
            لو (!هل_تعبير_موضع_دلالي(&الداخل) || !هل_موضع_قابل_للتغيير(&الداخل, الأنواع, أنواع_التعبيرات)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
            };
            دع نوع_المرجع: متغير معرف_نوع = نوع_الداخل;
            طابق أزل_غلاف_متغير(الأنواع, نوع_الداخل) مع
            | اختيار.بعض(الأساس) -> { نوع_المرجع := الأساس; }
            | اختيار.لا_شيء -> { };
            دع النوع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_المرجع, صواب));
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        };
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
        );
    }
    | تعبير.استدعاء(_, المستدعى_المملوك, الحجج) -> {
        دع المستدعى: تعبير = *المستدعى_المملوك;
        دع هوية_البدائي: متغير اختيار هوية_بدائي_مترجم = اختيار.لا_شيء();
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&المستدعى)) مع
        | اختيار.بعض(رمز_المستدعى) -> {
            هوية_البدائي := هوية_بدائي_رمز_عند(سياق_الأسماء, رمز_المستدعى);
        }
        | اختيار.لا_شيء -> { };

        طابق هوية_البدائي مع
        | اختيار.بعض(الهوية) -> {
            // Primitive Symbols intentionally do not receive fake monomorphic function Types.
            // Their exact language-Type legality is dispatched by canonical primitive identity.
            دع أنواع_الحجج: متغير متجه معرف_نوع = [];
            دع أنواع_البدائي: أنواع_استدعاء_بدائي_مقننة =
                ابن_أنواع_استدعاء_بدائي_مقننة(الأنواع);
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
                دع نتيجة_الحجة: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الحجج[ف]))
                );
                طابق نوع_حجة_بدائية_متوقعة(الأنواع, &أنواع_البدائي, الهوية, ف, &أنواع_الحجج) مع
                | اختيار.بعض(المتوقع) -> {
                    نتيجة_الحجة := ابن_نوع_تعبير_بتوقع_داخلي(
                        &الحجج[ف], المتوقع, موضع_توقع_نوع.بدائي(الهوية, ف), سياق_الأسماء,
                        الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                }
                | اختيار.لا_شيء -> {
                    نتيجة_الحجة := ابن_نوع_تعبير_داخلي(
                        &الحجج[ف], سياق_الأسماء, الأنواع,
                        أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                };
                طابق نتيجة_الحجة مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { ألحق(أنواع_الحجج, النوع); };
                ف := ف + 1;
            }

            // Primitive Type rules own semantic container/value compatibility only.
            // Append mutates its first argument, so reuse the canonical place-legality
            // path here instead of encoding mutability into the vector's semantic Type.
            طابق الهوية مع
            | هوية_بدائي_مترجم.إلحاق -> {
                لو ((الطول(الحجج) مثل غير_موقع) >= 1) {
                    لو (!هل_تعبير_موضع_دلالي(&الحجج[0])
                        || !هل_موضع_قابل_للتغيير(&الحجج[0], الأنواع, أنواع_التعبيرات)) {
                        دع الموجود: معرف_نوع = أنواع_الحجج[0];
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                                نطاق_تعبير(&الحجج[0]), الهوية, 0, الموجود
                            )
                        );
                    };
                };
            }
            | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> {
                لو ((الطول(الحجج) مثل غير_موقع) >= 2) {
                    لو (!هل_تعبير_موضع_دلالي(&الحجج[1])
                        || !هل_موضع_قابل_للتغيير(&الحجج[1], الأنواع, أنواع_التعبيرات)) {
                        دع الموجود: معرف_نوع = أنواع_الحجج[1];
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                                نطاق_تعبير(&الحجج[1]), الهوية, 1, الموجود
                            )
                        );
                    };
                };
            }
            | هوية_بدائي_مترجم.قراءة_مدخل_دليل -> {
                لو ((الطول(الحجج) مثل غير_موقع) >= 2) {
                    لو (!هل_تعبير_موضع_دلالي(&الحجج[1])
                        || !هل_موضع_قابل_للتغيير(&الحجج[1], الأنواع, أنواع_التعبيرات)) {
                        دع الموجود: معرف_نوع = أنواع_الحجج[1];
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                                نطاق_تعبير(&الحجج[1]), الهوية, 1, الموجود
                            )
                        );
                    };
                };
            }
            | هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي -> {
                لو ((الطول(الحجج) مثل غير_موقع) >= 1) {
                    لو (!هل_تعبير_موضع_دلالي(&الحجج[0])
                        || !هل_موضع_قابل_للتغيير(&الحجج[0], الأنواع, أنواع_التعبيرات)) {
                        دع الموجود: معرف_نوع = أنواع_الحجج[0];
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                                نطاق_تعبير(&الحجج[0]), الهوية, 0, الموجود
                            )
                        );
                    };
                };
            }
            | _ -> { };

            طابق تحقق_استدعاء_بدائي(
                الأنواع, &أنواع_البدائي, الهوية, &أنواع_الحجج
            ) مع
            | نتيجة_استدعاء_بدائي.صالح(فئة_الناتج) -> {
                دع الناتج: معرف_نوع = قنن_نوع_ناتج_استدعاء_بدائي(
                    الأنواع, &أنواع_البدائي, فئة_الناتج
                );
                أرجع سجل_نوع_تعبير_داخلي(
                    الأنواع, أنواع_التعبيرات, التعبير, الناتج
                );
            }
            | نتيجة_استدعاء_بدائي.مرفوض(خطأ_البدائي) -> {
                طابق خطأ_البدائي مع
                | خطأ_استدعاء_بدائي.عدد_حجج_غير_مطابق(المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.عدد_حجج_بدائية_غير_مطابق(
                            نطاق_تعبير(التعبير), الهوية, المتوقع, الموجود
                        )
                    );
                }
                | خطأ_استدعاء_بدائي.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_مطابق(
                            نطاق_تعبير(&الحجج[الفهرس]), الهوية, الفهرس, المتوقع, الموجود
                        )
                    );
                }
                | خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(الفهرس, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                            نطاق_تعبير(&الحجج[الفهرس]), الهوية, الفهرس, الموجود
                        )
                    );
                }
                | خطأ_استدعاء_بدائي.دلالة_مصدرية_غير_متاحة -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.دلالة_بدائي_غير_متاحة(
                            نطاق_تعبير(التعبير), الهوية
                        )
                    );
                };
            };
        }
        | اختيار.لا_شيء -> {
            // Ordinary calls retain the canonical function-Type validation path unchanged.
            دع نوع_المستدعى: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(
                &المستدعى, سياق_الأسماء, الأنواع,
                أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_المستدعى := النوع;
            };

            دع استدعاء_عام: منطقي = هل_نوع_يحوي_معامل_نوع(الأنواع, نوع_المستدعى);
            دع الاستبدالات_الحالية: متغير متجه ربط_استبدال_نوع = [];
            دع أنواع_الحجج: متغير متجه معرف_نوع = [];
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
                دع نتيجة_الحجة: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الحجج[ف]))
                );
                طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
                | اختيار.بعض(المتوقع_الخام) -> {
                    لو (استدعاء_عام) {
                        دع المتوقع: معرف_نوع = استبدل_نوعا(
                            الأنواع, المتوقع_الخام, &الاستبدالات_الحالية
                        );
                        لو (هل_نوع_يحوي_معامل_نوع(الأنواع, المتوقع)) {
                            نتيجة_الحجة := ابن_نوع_تعبير_داخلي(
                                &الحجج[ف], سياق_الأسماء, الأنواع,
                                أنواع_التعبيرات, الروابط, أنواع_الرموز
                            );
                        } وإلا {
                            نتيجة_الحجة := ابن_نوع_تعبير_بتوقع_داخلي(
                                &الحجج[ف], المتوقع, موضع_توقع_نوع.مفهرس(ف), سياق_الأسماء,
                                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                            );
                        };
                    } وإلا {
                        نتيجة_الحجة := ابن_نوع_تعبير_بتوقع_داخلي(
                            &الحجج[ف], المتوقع_الخام, موضع_توقع_نوع.مفهرس(ف), سياق_الأسماء,
                            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                        );
                    };
                }
                | اختيار.لا_شيء -> {
                    نتيجة_الحجة := ابن_نوع_تعبير_داخلي(
                        &الحجج[ف], سياق_الأسماء, الأنواع,
                        أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                };
                طابق نتيجة_الحجة مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                    ألحق(أنواع_الحجج, النوع);
                    لو (استدعاء_عام) {
                        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
                        | اختيار.بعض(المتوقع_الخام) -> {
                            لو (!أضف_استبدالات_من_معامل_استدعاء(
                                الأنواع, المتوقع_الخام, النوع, &متغير الاستبدالات_الحالية
                            )) {
                                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                    خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                                        نطاق_تعبير(&الحجج[ف]), ف, المتوقع_الخام, النوع
                                    )
                                );
                            };
                        }
                        | اختيار.لا_شيء -> { };
                    };
                };
                ف := ف + 1;
            }

            طابق تحقق_توقيع_استدعاء_باستبدالات(
                الأنواع, نوع_المستدعى, &أنواع_الحجج, &الاستبدالات_الحالية
            ) مع
            | نتيجة_توقيع_استدعاء.صالح(الناتج, استبدالات_النوع) -> {
                دع نطاقات_الحجج: متغير متجه نطاق = [];
                دع ح: متغير غير_موقع = 0;
                بينما (ح < (الطول(الحجج) مثل غير_موقع)) {
                    ألحق(نطاقات_الحجج, نطاق_تعبير(&الحجج[ح]));
                    ح := ح + 1;
                }
                دع رمز_الاستدعاء: اختيار معرف_رمز = رمز_مستدعى_محلول_للنوع(
                    سياق_الأسماء, الروابط, &المستدعى
                );
                أضف_استدعاء_نوعيا(
                    أنواع_التعبيرات, نطاق_تعبير(التعبير), نوع_المستدعى,
                    رمز_الاستدعاء, نطاقات_الحجج, استبدالات_النوع
                );
                أرجع سجل_نوع_تعبير_داخلي(
                    الأنواع, أنواع_التعبيرات, التعبير, الناتج
                );
            }
            | نتيجة_توقيع_استدعاء.مرفوض(خطأ_التوقيع) -> {
                طابق خطأ_التوقيع مع
                | خطأ_توقيع_استدعاء.غير_قابل_للاستدعاء -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(
                            نطاق_تعبير(التعبير), نوع_المستدعى
                        )
                    );
                }
                | خطأ_توقيع_استدعاء.عدد_حجج_غير_مطابق(المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                            نطاق_تعبير(التعبير), المتوقع, الموجود
                        )
                    );
                }
                | خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                            نطاق_تعبير(&الحجج[الفهرس]), الفهرس, المتوقع, الموجود
                        )
                    );
                };
            };
        };
    }
    | تعبير.تحويل(_, الداخل_المملوك, الهدف) -> {
        دع الداخل: تعبير = *الداخل_المملوك;
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الهدف) مع
        | نتيجة_حل_نوع.موجود(نوع_الهدف) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الهدف);
        }
        | _ -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&الهدف))
            );
        };
    };
}

عرف ابن_تواقيع_الدوال_داخلية(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختيار خطأ_بناء_سياقات_أنواع {
    دع القيم: متجه عنصر_وحدة = *العناصر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_العنصر: &عنصر_وحدة = &القيم[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            دع أنواع_المعاملات: متغير متجه معرف_نوع = [];
            دع م: متغير غير_موقع = 0;
            بينما (م < (الطول(الدالة.المعاملات) مثل غير_موقع)) {
                دع مرجع_المعامل: &معامل = &الدالة.المعاملات[م];
                دع المعامل: معامل = *مرجع_المعامل;
                دع نوع_المعامل: متغير معرف_نوع = معرف_نوع_من(0);
                طابق قنن_نوع_تركيبي(الأنواع, الروابط, &المعامل.النوع) مع
                | نتيجة_حل_نوع.موجود(النوع) -> {
                    نوع_المعامل := النوع;
                }
                | _ -> {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                        نطاق_نوع_تركيبي_داخلي(&المعامل.النوع)
                    ));
                };
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &المعامل.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | نتيجة.نجح(رمز_المعامل) -> {
                    لو (!أضف_نوع_رمز(أنواع_الرموز, رمز_المعامل, نوع_المعامل)) {
                        أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(المعامل.النطاق));
                    };
                };
                ألحق(أنواع_المعاملات, نوع_المعامل);
                م := م + 1;
            }
            دع نوع_الناتج: متغير معرف_نوع = معرف_نوع_من(0);
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الدالة.الناتج) مع
            | نتيجة_حل_نوع.موجود(النوع) -> {
                نوع_الناتج := النوع;
            }
            | _ -> {
                أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                    نطاق_نوع_تركيبي_داخلي(&الدالة.الناتج)
                ));
            };
            دع نوع_الدالة: معرف_نوع = قنن_نوعا(
                الأنواع,
                نوع_مقنن.دالة(أنواع_المعاملات, نوع_الناتج)
            );
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &الدالة.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة.نجح(رمز_الدالة) -> {
                لو (!أضف_نوع_رمز(أنواع_الرموز, رمز_الدالة, نوع_الدالة)) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(الدالة.النطاق));
                };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ابن_كتلة_أنواع_داخلية(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز,
    نوع_الناتج_المتوقع: معرف_نوع
): اختيار خطأ_بناء_سياقات_أنواع {
    دع القيمة: كتلة_عبارات = *الكتلة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.العبارات) مثل غير_موقع)) {
        دع مرجع_الصندوق: &صندوق عبارة = &القيمة.العبارات[ف];
        دع العبارة: عبارة = **مرجع_الصندوق;
        طابق العبارة مع
        | عبارة.تصريح_متغير(النطاق, الاسم, النوع_التركيبي) -> {
            دع النوع: متغير معرف_نوع = معرف_نوع_من(0);
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &النوع_التركيبي) مع
            | نتيجة_حل_نوع.موجود(المعرف) -> {
                النوع := المعرف;
            }
            | _ -> {
                أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                    نطاق_نوع_تركيبي_داخلي(&النوع_التركيبي)
                ));
            };
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &الاسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة.نجح(الرمز) -> {
                لو (!أضف_نوع_رمز(أنواع_الرموز, الرمز, النوع)) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(النطاق));
                };
            };
        }
        | عبارة.تهيئة_سجل(_, الوجهة, الحقول) -> {
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            طابق عدد_حقول_سجل_دلالي(الأنواع, نوع_الوجهة) مع
            | اختيار.بعض(المتوقع) -> {
                لو ((الطول(الحقول) مثل غير_موقع) != المتوقع) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الوجهة)));
                };
            }
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الوجهة)));
            };
            دع هويات_الحقول: متغير متجه معرف_اسم = [];
            دع ح: متغير غير_موقع = 0;
            بينما (ح < (الطول(الحقول) مثل غير_موقع)) {
                دع نوع_الحقل: متغير معرف_نوع = معرف_نوع_من(0);
                طابق هوية_اسم_مطلوبة_للنوع(الروابط, &الحقول[ح].الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | نتيجة.نجح(هوية_الحقل) -> {
                    دع هـ: متغير غير_موقع = 0;
                    بينما (هـ < (الطول(هويات_الحقول) مثل غير_موقع)) {
                        لو (معرفا_اسم_متساويان(هويات_الحقول[هـ], هوية_الحقل)) {
                            أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الحقول[ح].القيمة)));
                        };
                        هـ := هـ + 1;
                    }
                    ألحق(هويات_الحقول, هوية_الحقل);
                    طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, نوع_الوجهة, هوية_الحقل) مع
                    | اختيار.بعض(النوع) -> {
                        نوع_الحقل := النوع;
                    }
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.بعض(
                            خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف(الحقول[ح].الاسم.النطاق)
                        );
                    };
                };
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &الحقول[ح].القيمة, نوع_الحقل, ح, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | _ -> { };
                ح := ح + 1;
            }
        }
        | عبارة.تهيئة_صف(_, الوجهة, العناصر) -> {
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الوجهة) مع
            | اختيار.بعض(المتوقع) -> {
                لو ((الطول(العناصر) مثل غير_موقع) != المتوقع) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الوجهة)));
                };
            }
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الوجهة)));
            };
            دع ع: متغير غير_موقع = 0;
            بينما (ع < (الطول(العناصر) مثل غير_موقع)) {
                دع نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الوجهة, ع) مع
                | اختيار.بعض(النوع) -> {
                    نوع_العنصر := النوع;
                }
                | اختيار.لا_شيء -> {
                    أرجع اختيار.بعض(
                        خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&العناصر[ع]))
                    );
                };
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &العناصر[ع], نوع_العنصر, ع, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | _ -> { };
                ع := ع + 1;
            }
        }
        | عبارة.تهيئة_متجه(_, الوجهة, العناصر) -> {
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            دع نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
            طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_الوجهة) مع
            | اختيار.بعض(النوع) -> {
                نوع_العنصر := النوع;
            }
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الوجهة))
                );
            };
            دع ع: متغير غير_موقع = 0;
            بينما (ع < (الطول(العناصر) مثل غير_موقع)) {
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &العناصر[ع], نوع_العنصر, ع, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | _ -> { };
                ع := ع + 1;
            }
        }
        | عبارة.تهيئة_نص(_, الوجهة, _) -> {
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الوجهة) -> {
                دع نوع_النص: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
                لو (!نوعان_متوافقان(الأنواع, نوع_الوجهة, نوع_النص)) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الوجهة)));
                };
            };
        }
        | عبارة.تهيئة_صندوق(_, الوجهة, الحمولة) -> {
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            طابق نوع_حمولة_صندوق_دلالي(الأنواع, نوع_الوجهة) مع
            | اختيار.بعض(نوع_الحمولة) -> {
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &الحمولة, نوع_الحمولة, 0, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | _ -> { };
            }
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الوجهة))
                );
            };
        }
        | عبارة.نسخ(_, الوجهة, المصدر) -> {
            لو (!هل_تعبير_موضع_دلالي(&الوجهة)) {
                أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الوجهة)));
            };
            دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الوجهة := النوع; };
            لو (هل_تعبير_فهرسة_دلالي(&الوجهة)
                && !هل_موضع_قابل_للتغيير(&الوجهة, الأنواع, أنواع_التعبيرات)) {
                أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الوجهة)));
            };
            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                &المصدر, نوع_الوجهة, موضع_توقع_نوع.مفهرس(0), سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | _ -> { };
        }
        | عبارة.استدعاء(_, التعبير) -> {
            طابق ابن_نوع_تعبير_داخلي(&التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | _ -> { };
        }
        | عبارة.لكل(النطاق, البداية, الشرط, الخطوة, الجسم) -> {
            دع كتلة_البداية: كتلة_عبارات = { النطاق: النطاق, العبارات: البداية };
            طابق ابن_كتلة_أنواع_داخلية(&كتلة_البداية, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع) مع
            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | اختيار.لا_شيء -> { };
            طابق ابن_نوع_تعبير_داخلي(&الشرط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الشرط) -> {
                لو (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الشرط)) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الشرط)));
                };
            };
            دع قائمة_الخطوة: متجه صندوق عبارة = [الخطوة];
            دع كتلة_الخطوة: كتلة_عبارات = { النطاق: النطاق, العبارات: قائمة_الخطوة };
            طابق ابن_كتلة_أنواع_داخلية(&كتلة_الخطوة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع) مع
            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | اختيار.لا_شيء -> { };
            طابق ابن_كتلة_أنواع_داخلية(&الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع) مع
            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | اختيار.لا_شيء -> { };
        }
        | عبارة.اخرج_من_حلقة(_) -> { }
        | عبارة.تابع_حلقة(_) -> { }
        | عبارة.بينما(_, الشرط, الجسم) -> {
            طابق ابن_نوع_تعبير_داخلي(&الشرط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الشرط) -> {
                لو (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الشرط)) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الشرط)));
                };
            };
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | اختيار.لا_شيء -> { };
        }
        | عبارة.لو(_, الشرط, عند_الصواب, عند_الخطأ) -> {
            طابق ابن_نوع_تعبير_داخلي(&الشرط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الشرط) -> {
                لو (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الشرط)) {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الشرط)));
                };
            };
            طابق ابن_كتلة_أنواع_داخلية(
                &عند_الصواب, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | اختيار.لا_شيء -> { };
            طابق عند_الخطأ مع
            | اختيار.بعض(الكتلة_الأخرى) -> {
                طابق ابن_كتلة_أنواع_داخلية(
                    &الكتلة_الأخرى, سياق_الأسماء,
                    الأنواع,
                    أنواع_التعبيرات,
                    الروابط,
                    أنواع_الرموز,
                    نوع_الناتج_المتوقع
                ) مع
                | اختيار.بعض(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | عبارة.طابق(_, المميز, الأذرع) -> {
            دع نوع_المميز: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&المميز, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_المميز := النوع;
            };
            دع ذ: متغير غير_موقع = 0;
            بينما (ذ < (الطول(الأذرع) مثل غير_موقع)) {
                لو (!اربط_أنواع_رموز_نمط_تركيبي(
                    &الأذرع[ذ].النمط, نوع_المميز, سياق_الأسماء, الأنواع,
                    الروابط, أنواع_الرموز
                )) {
                    أرجع اختيار.بعض(
                        خطأ_بناء_سياقات_أنواع.نمط_غير_صالح(نطاق_نمط(&الأذرع[ذ].النمط))
                    );
                };
                طابق ابن_كتلة_أنواع_داخلية(
                    &الأذرع[ذ].الجسم, سياق_الأسماء,
                    الأنواع,
                    أنواع_التعبيرات,
                    الروابط,
                    أنواع_الرموز,
                    نوع_الناتج_المتوقع
                ) مع
                | اختيار.بعض(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | اختيار.لا_شيء -> { };
                ذ := ذ + 1;
            }
        }
        | عبارة.أرجع(_, القيمة_الراجعة) -> {
            طابق القيمة_الراجعة مع
            | اختيار.بعض(التعبير) -> {
                طابق ابن_نوع_تعبير_إرجاع_داخلي(
                    &التعبير, نوع_الناتج_المتوقع, سياق_الأسماء, الأنواع,
                    أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | _ -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | عبارة.تجميع(_, _) -> { }
        | عبارة.غير_آمن(_, الجسم) -> {
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | اختيار.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ابن_أجسام_الدوال_داخلية(
    العناصر: &متجه عنصر_وحدة,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختيار خطأ_بناء_سياقات_أنواع {
    دع القيم: متجه عنصر_وحدة = *العناصر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_العنصر: &عنصر_وحدة = &القيم[ف];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            دع نوع_الناتج: متغير معرف_نوع = معرف_نوع_من(0);
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &الدالة.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة.نجح(رمز_الدالة) -> {
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, رمز_الدالة) مع
                | اختيار.لا_شيء -> {
                    أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(رمز_الدالة, الدالة.الاسم.النطاق));
                }
                | اختيار.بعض(نوع_الدالة) -> {
                    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة) مع
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.بعض(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(الدالة.النطاق));
                    }
                    | اختيار.بعض(النوع) -> {
                        نوع_الناتج := النوع;
                    };
                };
            };
            طابق الدالة.الجسم مع
            | اختيار.بعض(الجسم) -> {
                طابق ابن_كتلة_أنواع_داخلية(
                    &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج
                ) مع
                | اختيار.بعض(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}


عام عرف ابن_سياقات_أنواع_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    روابط_الأسماء: &متجه سياق_روابط_أسماء
): نتيجة_بناء_سياقات_أنواع {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع أنواع_تعبيرات_الوحدات: متغير متجه سياق_أنواع_تعبيرات = [];
    دع علاقات_هرم_الأنواع: متغير متجه علاقة_هرم_نوع = [];
    دع أنواع_الرموز: متغير سياق_أنواع_رموز = سياق_أنواع_رموز_جديد();
    دع القيم: متجه وحدة_مصدر = *الوحدات;
    دع روابط_القيم: متجه سياق_روابط_أسماء = *روابط_الأسماء;
    دع ف: متغير غير_موقع = 0;

    // Register all generic Type parameters before resolving any declaration/signature Type syntax.
    ف := 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &القيم[ف];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &روابط_القيم[ف];
        دع الأصل: وحدة_مصدر = *مرجع_الوحدة;
        طابق سجل_معاملات_نوع_العناصر(
            &الأصل.العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    // Named Type syntax consumes each module's canonical Name bindings directly.
    // Every named aggregate is declared before any module completes a cross-module shape.
    ف := 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &القيم[ف];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &روابط_القيم[ف];
        دع الأصل: وحدة_مصدر = *مرجع_الوحدة;
        طابق أعلن_التراكيب_المسماة(&الأصل.العناصر, روابط_الوحدة, &متغير الأنواع) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &القيم[ف];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &روابط_القيم[ف];
        دع الأصل: وحدة_مصدر = *مرجع_الوحدة;
        طابق أكمل_المرادفات(&الأصل.العناصر, روابط_الوحدة, &متغير الأنواع, &متغير علاقات_هرم_الأنواع) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &القيم[ف];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &روابط_القيم[ف];
        دع الأصل: وحدة_مصدر = *مرجع_الوحدة;
        طابق أكمل_التراكيب_المسماة(
            &الأصل.العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    // Generic aggregate instances may have been interned while another template was
    // still an empty forward declaration. Rebuild their concrete semantic shapes once
    // every named template is complete, before function signatures/bodies consume them.
    لو (!أعد_بناء_مثيلات_أنواع_مسماة(&متغير الأنواع)) {
        أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(
            خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(نطاق_فارغ())
        );
    };

    // Function signatures for all modules precede all bodies so calls are graph-order independent.
    ف := 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &القيم[ف];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &روابط_القيم[ف];
        دع الأصل: وحدة_مصدر = *مرجع_الوحدة;
        طابق ابن_تواقيع_الدوال_داخلية(
            &الأصل.العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &القيم[ف];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &روابط_القيم[ف];
        دع الأصل: وحدة_مصدر = *مرجع_الوحدة;
        دع أنواع_تعبيرات_الوحدة: متغير سياق_أنواع_تعبيرات = سياق_أنواع_تعبيرات_جديد();
        طابق ابن_أجسام_الدوال_داخلية(
            &الأصل.العناصر, سياق_الأسماء, &متغير الأنواع, &متغير أنواع_تعبيرات_الوحدة,
            روابط_الوحدة, &متغير أنواع_الرموز
        ) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ); }
        | اختيار.لا_شيء -> { };
        ألحق(أنواع_تعبيرات_الوحدات, أنواع_تعبيرات_الوحدة);
        ف := ف + 1;
    }

    دع الناتج: سياقات_أنواع_وحدة = {
        الأنواع: الأنواع,
        أنواع_التعبيرات: أنواع_تعبيرات_الوحدات,
        أنواع_الرموز: أنواع_الرموز,
        علاقات_هرم_الأنواع: علاقات_هرم_الأنواع
    };
    أرجع نتيجة_بناء_سياقات_أنواع.مبنية(الناتج);
}

عام عرف ابن_سياقات_أنواع_وحدة(
    الوحدة: &وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    روابط_الأسماء: &سياق_روابط_أسماء
): نتيجة_بناء_سياقات_أنواع {
    دع الوحدات: متغير متجه وحدة_مصدر = [];
    دع روابط_الوحدات: متغير متجه سياق_روابط_أسماء = [];
    دع الأصل: وحدة_مصدر = *الوحدة;
    دع روابط_الوحدة: سياق_روابط_أسماء = *روابط_الأسماء;
    ألحق(الوحدات, الأصل);
    ألحق(روابط_الوحدات, روابط_الوحدة);
    أرجع ابن_سياقات_أنواع_وحدات(&الوحدات, سياق_الأسماء, &روابط_الوحدات);
}
