استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.contextual_names_generated;
// Canonical Type pipeline result consumed by the real driver. It contains exactly
// the three Type-owned contexts expected by semantic lowering.
// Canonical declaration/signature Symbol -> Type facts are Type-owned and survive the
// whole-unit pass. Downstream consumers query this table; they never re-resolve AST Type syntax.
عام نوع سياق_أنواع_رموز = {
    // SymbolID is already a dense canonical identity. Type owns one direct slot per Symbol;
    // no secondary Symbol→Type fact list is searched during expression inference.
    الأنواع: متجه اختياري معرف_نوع,
    // Per Symbol: the length of an immutable local initialized from a text or
    // vector literal, for constant-index bounds checks.
    الأطوال_المعروفة: متجه اختياري طبيعي,
    // The declared type parameters of each generic function, in order, for
    // explicit type arguments (`f<A, B>(..)`).
    معاملات_الدوال: متجه معاملات_نوع_دالة_مسجلة,
    // Per Symbol: a function marked `@@track_caller` (its last parameter, a
    // source location, is filled at each call: يتتبع_المستدعي).
    يتتبع_المستدعي: متجه منطقي,
    // The return Type of the code being typed (its function, closure or
    // compile-time block), for a `return` in an arm of a match expression,
    // which is typed with the expression and not as a statement of the body.
    نوع_الإرجاع_الجاري: معرف_نوع
};

عام نوع معاملات_نوع_دالة_مسجلة = {
    الرمز: معرف_رمز,
    المعاملات: متجه معرف_رمز
};

عام نوع علاقة_هرم_نوع = {
    النوع_الفرعي: معرف_رمز,
    النوع_العلوي: معرف_رمز
};

عام نوع سياقات_أنواع_وحدة = {
    الأنواع: سجل_أنواع,
    أنواع_التعبيرات: متجه سياق_أنواع_تعبيرات,
    أنواع_الرموز: سياق_أنواع_رموز,
    علاقات_هرم_الأنواع: متجه علاقة_هرم_نوع
};

عام نوع خطأ_بناء_سياقات_أنواع =
    | ربط_اسم_مفقود بنوع نطاق
    | هوية_اسم_مفقودة بنوع نطاق
    | نوع_غير_محلول بنوع نطاق
    | تعريف_نوع_غير_صالح بنوع نطاق
    | نوع_رمز_مفقود بنوع (معرف_رمز, نطاق)
    // A built-in (append, length, ...) read as a value: it has no value
    // type and is only called. The user's error, not a missing fact.
    | بدائي_غير_مستدعى بنوع نطاق
    // A type-table invariant failed (always a compiler bug); which one.
    | نوع_تعبير_غير_مدعوم بنوع (نطاق, ثابت_أنواع_مكسور)
    | سمة_تصريح_غير_مدعومة بنوع نطاق
    // `@@track_caller` on a function that is generic, external, has
    // compile-time parameters, or whose last parameter is no source location.
    | توقيع_يتتبع_المستدعي_غير_صالح بنوع نطاق
    // A `@@c_abi` function without a body, with type or compile-time
    // parameters, or with a parameter or result C has no form for.
    | استعمال_اتفاقية_سي_غير_صالح بنوع نطاق
    // A call of a track-caller function that passes its location argument.
    | حجة_موقع_المستدعي_صريحة بنوع نطاق
    | حقل_سجل_غير_معروف بنوع نطاق
    | نمط_غير_صالح بنوع نطاق
    | عدد_حجج_استدعاء_غير_مطابق بنوع (نطاق, طبيعي, طبيعي)
    // A constructor pattern binding another number of payloads than the
    // constructor carries: (pattern, carried, bound).
    | عدد_حمولات_نمط_غير_مطابق بنوع (نطاق, طبيعي, طبيعي)
    | نوع_حجة_استدعاء_غير_مطابق بنوع (نطاق, طبيعي, معرف_نوع, معرف_نوع)
    | نوع_إرجاع_غير_مطابق بنوع (نطاق, معرف_نوع, معرف_نوع)
    | عدد_حجج_بدائية_غير_مطابق بنوع (نطاق, هوية_بدائي_مترجم, طبيعي, طبيعي)
    | نوع_حجة_بدائية_غير_مطابق بنوع (نطاق, هوية_بدائي_مترجم, طبيعي, معرف_نوع, معرف_نوع)
    | نوع_حجة_بدائية_غير_صالح بنوع (نطاق, هوية_بدائي_مترجم, طبيعي, معرف_نوع)
    | دلالة_بدائي_غير_متاحة بنوع (نطاق, هوية_بدائي_مترجم)
    | تعبير_غير_قابل_للاستدعاء بنوع (نطاق, معرف_نوع)
    // User type errors. The context names the rule that was broken; the
    // expected and found Types are attached when they are known.
    | أنواع_غير_متوافقة بنوع (نطاق, سياق_عدم_توافق_نوع, اختياري معرف_نوع, اختياري معرف_نوع)
    | أخذ_عنوان_غير_موضع بنوع نطاق
    | كتابة_إلى_غير_قابل_للتغيير بنوع نطاق
    // A vector or slice given to a `mutable [] T` without `&mutable`.
    | عرض_بلا_علامة بنوع نطاق
    | إسناد_إلى_غير_موضع بنوع نطاق
    // The literal's span and, when known, the first field it leaves out.
    | حقل_سجل_مفقود بنوع (نطاق, اختياري معرف_اسم)
    // The repeated field name and its first occurrence.
    | حقل_سجل_مكرر بنوع (نطاق, نطاق)
    | فك_غير_مؤشر بنوع (نطاق, معرف_نوع)
    // A binary operator its operand Type does not define (`a > b` on records,
    // `a == b` on vectors): the operation, the operator, the operand Type.
    | عامل_غير_معرف بنوع (نطاق, عامل_ثنائي, معرف_نوع)
    // The index and the tuple's element count.
    | فهرس_صف_خارج_الحدود بنوع (نطاق, طبيعي, طبيعي)
    // A constant index and the known length of a text or vector local.
    | فهرس_خارج_طول_معروف بنوع (نطاق, طبيعي, طبيعي)
    | قفز_خارج_حلقة بنوع نطاق
    // A match expression none of whose arms gives a value: the match.
    | مطابقة_تعبيرية_بلا_قيمة بنوع نطاق
    // The same for an `if` used as a value.
    | إذا_تعبيرية_بلا_قيمة بنوع نطاق
    // A tuple `let` whose written Type is not a tuple of one element for each
    // name, at every level of its pattern: the written Type.
    | ربط_صف_بنوع_غير_مطابق بنوع نطاق
    // A tuple `let` whose written Type makes a name (or the whole tuple)
    // `mutable`, other than a writable view `mutable [] T`: the written Type.
    | ربط_صف_قابل_للتغيير بنوع نطاق
    // A bare `none`, `ok(x)` or `err(e)` where nothing gives it its option or
    // result Type (no expected Type): the constructor as written.
    | منشئ_تمهيدي_بلا_نوع بنوع نطاق
    // A slice of text not written `&s[a..b]`: `&mutable s[a..b]` (a slice of
    // text is read-only) or `s[a..b]` without `&`. The slice as written.
    | مقطع_نص_غير_صالح بنوع نطاق
    // An opaque type used where it has no meaning: which use, and the
    // opaque Type. The span is the written type, the operation, or (for a
    // field) the field name as written.
    | استعمال_نوع_معتم بنوع (نطاق, صنف_استعمال_معتم, معرف_نوع)
    // A generic call whose instantiated signature holds an opaque type
    // argument by value: the call, the generic's name, the opaque Type.
    | معتم_في_توقيع_مثيل بنوع (نطاق, اختياري نطاق, معرف_نوع)
;

// The rule an opaque-type error breaks. The diagnostic adapter maps each one
// to its identity; no wording lives here.
عام نوع صنف_استعمال_معتم =
    // A value of it: local, field, payload, parameter, result, global,
    // cast target, reference, element of a container.
    | بالقيمة
    // A type argument: `f<T>(...)`, a generic call inferring T, `G<T>`.
    | حجة_نوع
    // `*p` where p: *T, inside unsafe too.
    | فك
    // `p.f` where p: *T (or a T place).
    | حقل
    // `p[i]` where p: *T: pointer arithmetic by the element size.
    | فهرسة
;

// Which typing rule a mismatched-types error breaks. The diagnostic adapter
// maps each one to a typed reason; no wording lives here.
// The type-table invariant an internal type error reports. A user mistake is
// never one of these: it has its own error with expected/found types.
عام نوع ثابت_أنواع_مكسور =
    | تسجيل_نوع_تعبير
    | تسجيل_نوع_منشئ
    | نوع_حمولة_منشئ
    | نوع_عنصر_صف
    | حجة_بلا_نوع
;

عام نوع سياق_عدم_توافق_نوع =
    | طرفا_عامل_مختلفان
    | عامل_يتطلب_منطقيا
    | عامل_يتطلب_عددا
    | عامل_يتطلب_عددا_صحيحا
    | شرط_غير_منطقي
    | قيمة_لا_تطابق_الوجهة
    | فهرس_ليس_عددا_صحيحا
    | نوع_غير_قابل_للفهرسة
    | فهرس_صف_غير_ثابت
    | عدد_عناصر_صف
    | فارغ_بلا_مؤشر
    | حرفي_لا_يناسب_الوجهة
    | عدد_حرفي_خارج_المدى
    // `x as T` between two scalar types that no conversion joins.
    | تحويل_غير_صالح
    // Unary minus on a value of an unsigned integer type.
    | سالب_عدد_طبيعي
    // An arm of a match expression gives a value of another Type than its
    // first arm (expected: the first arm's Type).
    | أذرع_مطابقة_مختلفة
    // The branches of an `if` used as a value.
    | فروع_إذا_مختلفة
;

عام نوع نتيجة_بناء_سياقات_أنواع =
    | مبنية بنوع سياقات_أنواع_وحدة
    | مرفوضة بنوع (خطأ_بناء_سياقات_أنواع, سجل_أنواع)
    // The cancellation token was set (checked before each module's bodies).
    | ملغاة
;

عام عرف سياق_أنواع_رموز_جديد(): سياق_أنواع_رموز {
    ليكن الأنواع: متجه اختياري معرف_نوع = [];
    ليكن الأطوال: متجه اختياري طبيعي = [];
    ليكن معاملات_الدوال: متجه معاملات_نوع_دالة_مسجلة = [];
    ليكن المتتبعة: متجه منطقي = [];
    ليكن السياق: سياق_أنواع_رموز = {
        الأنواع: الأنواع, الأطوال_المعروفة: الأطوال, معاملات_الدوال: معاملات_الدوال,
        يتتبع_المستدعي: المتتبعة, نوع_الإرجاع_الجاري: معرف_نوع_من(0)
    };
    أرجع السياق;
}

عرف أضف_نوع_رمز(
    السياق: &متغير سياق_أنواع_رموز,
    الرمز: معرف_رمز,
    النوع: معرف_نوع
): منطقي {
    طالما ((الطول((*السياق).الأنواع) مثل طبيعي) <= (الرمز.القيمة مثل طبيعي)) {
        ألحق((*السياق).الأنواع, اختياري.لا_شيء());
    }
    (*السياق).الأنواع[الرمز.القيمة] := اختياري.موجود(النوع);
    أرجع صواب;
}

// `@@track_caller` (`@@يتتبع_المستدعي`): the
// function's last parameter is a std.debug.location `موقع_مصدر` (a
// reference to the file's path, a line and a column, a plain record), and a
// call passes every argument but that one. Calls and uses see the function's
// Type without it (نوع_رمز_لتعبير_داخلي): a direct call gets the place of the
// call, or inside another marked function the location that function
// received; a function value gets its definition's place (MSIR lowering,
// msir/lowering/caller_location.sn). Its own Symbol keeps the full Type.
// Whether C has a form for a parameter (or, with ناتج, a result) of the
// Type: an integer, floating point or boolean scalar, or a raw pointer; void
// as a result. Text, vectors, records, references and function values have
// none.
عرف نوع_بصيغة_سي(الأنواع: &سجل_أنواع, النوع: معرف_نوع, ناتج: منطقي): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
        | نوع_مقنن.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.فراغ -> { أرجع ناتج; }
            | نوع_بدائي_مقنن.أي -> { أرجع خطأ; }
            | نوع_بدائي_مقنن.نص -> { أرجع خطأ; }
            | _ -> { أرجع صواب; };
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف علم_يتتبع_المستدعي(السياق: &متغير سياق_أنواع_رموز, الرمز: معرف_رمز): فراغ {
    طالما ((الطول((*السياق).يتتبع_المستدعي) مثل طبيعي) <= (الرمز.القيمة مثل طبيعي)) {
        ألحق((*السياق).يتتبع_المستدعي, خطأ);
    }
    (*السياق).يتتبع_المستدعي[الرمز.القيمة] := صواب;
}

عام عرف رمز_يتتبع_المستدعي(السياق: &سياق_أنواع_رموز, الرمز: معرف_رمز): منطقي {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*السياق).يتتبع_المستدعي) مثل طبيعي)) { أرجع خطأ; };
    أرجع (*السياق).يتتبع_المستدعي[الرمز.القيمة];
}

// The Type a use of the Symbol has: a marked function's without its last
// parameter.
عرف نوع_رمز_لتعبير_داخلي(
    الأنواع: &متغير سجل_أنواع, السياق: &سياق_أنواع_رموز, الرمز: معرف_رمز, النوع: معرف_نوع
): معرف_نوع {
    إذا (!رمز_يتتبع_المستدعي(السياق, الرمز)) { أرجع النوع; };
    طابق عدد_معاملات_دالة_دلالية(الأنواع, النوع) مع
    | اختياري.موجود(العدد) -> {
        إذا (العدد == 0) { أرجع النوع; };
        ليكن المعاملات: متغير متجه معرف_نوع = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف + 1 < العدد) {
            طابق نوع_معامل_دالة_دلالي_عند(الأنواع, النوع, ف) مع
            | اختياري.موجود(المعامل) -> { ألحق(المعاملات, المعامل); }
            | اختياري.لا_شيء -> { أرجع النوع; };
            ف := ف + 1;
        }
        طابق نوع_ناتج_دالة_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(الناتج) -> { أرجع قنن_نوعا(الأنواع, نوع_مقنن.دالة(المعاملات, الناتج)); }
        | اختياري.لا_شيء -> { أرجع النوع; };
    }
    | اختياري.لا_شيء -> { أرجع النوع; };
}

// Whether a Type has the shape of std.debug.location's `موقع_مصدر`: a record
// of a shared reference to text, then two `طبيعي` (line and column), the
// value lowering builds at a call.
عام عرف نوع_موقع_مصدر_دلالي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(العدد) -> { إذا (العدد != 3) { أرجع خطأ; }; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن النص: معرف_نوع = معرف_نوع_من(رقم_نوع_بدائي(نوع_بدائي_مقنن.نص()));
    ليكن الطبيعي: معرف_نوع = معرف_نوع_من(رقم_نوع_بدائي(نوع_بدائي_مقنن.طبيعي()));
    طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, 0) مع
    | اختياري.موجود(الملف) -> {
        طابق نوع_داخل_مرجع_دلالي(الأنواع, الملف) مع
        | اختياري.موجود(الداخل) -> { إذا (!معرفا_نوع_متساويان(الداخل, النص)) { أرجع خطأ; }; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < 3) {
        طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف) مع
        | اختياري.موجود(الحقل) -> { إذا (!معرفا_نوع_متساويان(الحقل, الطبيعي)) { أرجع خطأ; }; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف سجل_طول_معروف_لرمز(
    السياق: &متغير سياق_أنواع_رموز,
    الرمز: معرف_رمز,
    العدد: طبيعي
): فراغ {
    طالما ((الطول((*السياق).الأطوال_المعروفة) مثل طبيعي) <= (الرمز.القيمة مثل طبيعي)) {
        ألحق((*السياق).الأطوال_المعروفة, اختياري.لا_شيء());
    }
    (*السياق).الأطوال_المعروفة[الرمز.القيمة] := اختياري.موجود(العدد);
}

عرف طول_معروف_لرمز(
    السياق: &سياق_أنواع_رموز,
    الرمز: معرف_رمز
): اختياري طبيعي {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*السياق).الأطوال_المعروفة) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع (*السياق).الأطوال_المعروفة[الرمز.القيمة];
}

// A local declared without `mutable` and initialized from a literal keeps the
// literal's length: record it when the initialized place is such a local.
عرف سجل_طول_تهيئة_حرفية(
    الوجهة: &تعبير,
    نوع_الوجهة: معرف_نوع,
    العدد: طبيعي,
    المصرح_السابق: اختياري معرف_رمز,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): فراغ {
    إذا (هل_نوع_مغلف_بمتغير(الأنواع, نوع_الوجهة)) { أرجع; };
    ليكن المصرح: معرف_رمز;
    طابق المصرح_السابق مع
    | اختياري.موجود(الرمز) -> { المصرح := الرمز; }
    | اختياري.لا_شيء -> { أرجع; };
    طابق *الوجهة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            // Only the initializer of the declaration: a later assignment of a
            // deferred local may take another length on another path.
            إذا (الرمز.القيمة == المصرح.القيمة) { سجل_طول_معروف_لرمز(أنواع_الرموز, الرمز, العدد); };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
}

// The local a declaration statement declares.
عرف رمز_تصريح_عبارة(العبارة: &عبارة, الروابط: &سياق_روابط_أسماء): اختياري معرف_رمز {
    طابق *العبارة مع
    | عبارة.تصريح_متغير(_, الاسم, _) -> { أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The known length of an indexed local, when it has one.
عرف طول_معروف_لتعبير(
    التعبير: &تعبير,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &سياق_أنواع_رموز
): اختياري طبيعي {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> { أرجع طول_معروف_لرمز(أنواع_الرموز, الرمز); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف نوع_رمز_دلالي_عند(
    السياق: &سياق_أنواع_رموز,
    الرمز: معرف_رمز
): اختياري معرف_نوع {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*السياق).الأنواع) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع (*السياق).الأنواع[الرمز.القيمة];
}

عرف نطاق_نوع_تركيبي_داخلي(النوع: &نوع_تركيبي): نطاق {
    أرجع نطاق_نوع_تركيبي(النوع);
}

عرف رمز_اسم_مطلوب_للنوع(
    الروابط: &سياق_روابط_أسماء,
    الاسم: &اسم
): نتيجة معرف_رمز, خطأ_بناء_سياقات_أنواع {
    ليكن القيمة: اسم = *الاسم;
    طابق رمز_اسم_محلول_عند(الروابط, القيمة.النطاق) مع
    | اختياري.موجود(الرمز) -> {
        أرجع نتيجة.نجح(الرمز);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود(القيمة.النطاق));
    };
}

عرف هوية_اسم_مطلوبة_للنوع(
    الروابط: &سياق_روابط_أسماء,
    الاسم: &اسم
): نتيجة معرف_اسم, خطأ_بناء_سياقات_أنواع {
    ليكن القيمة: اسم = *الاسم;
    طابق معرف_اسم_محلول_عند(الروابط, القيمة.النطاق) مع
    | اختياري.موجود(الهوية) -> {
        أرجع نتيجة.نجح(الهوية);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.هوية_اسم_مفقودة(القيمة.النطاق));
    };
}

// Type owns canonical Symbol -> Type facts. Pattern owns semantic Pattern validation,
// while bindings introduced by a source pattern are ordinary Name Symbols consumed by
// expressions in that arm. These narrow helpers seed only those Symbol Type facts from
// the already-known discriminant Type; Pattern validates the structure independently.
عرف اربط_نوع_رمز_نمط_ربط(
    الاسم: &اسم,
    النوع: معرف_نوع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    ليكن القيمة: اسم = *الاسم;
    طابق رمز_اسم_محلول_عند(الروابط, القيمة.النطاق) مع
    | اختياري.موجود(الرمز) -> {
        أرجع أضف_نوع_رمز(أنواع_الرموز, الرمز, النوع);
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف اربط_أنواع_رموز_نمط_صف(
    العناصر: &متجه نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ليكن نوع_الابن: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف) مع
        | اختياري.موجود(الموجود) -> { نوع_الابن := الموجود; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        إذا (!اربط_أنواع_رموز_نمط_تركيبي(
            &(*العناصر)[ف], نوع_الابن, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اربط_أنواع_رموز_نمط_سجل(
    الحقول: &متجه حقل_نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحقول) مثل طبيعي)) {
        ليكن قيمة_الاسم: اسم = (*الحقول)[ف].الاسم;
        ليكن هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
        طابق معرف_اسم_محلول_عند(الروابط, قيمة_الاسم.النطاق) مع
        | اختياري.موجود(الهوية) -> { هوية_الحقل := الهوية; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ليكن نوع_الابن: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, النوع, هوية_الحقل) مع
        | اختياري.موجود(الموجود) -> { نوع_الابن := الموجود; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        إذا (!اربط_أنواع_رموز_نمط_تركيبي(
            &(*الحقول)[ف].النمط, نوع_الابن, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف هوية_منشئ_مسمى_للنوع(
    اسم_النوع: &اسم,
    اسم_المنشئ: &اسم,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء
): اختياري هوية_منشئ_نوع {
    ليكن قيمة_اسم_النوع: اسم = *اسم_النوع;
    ليكن قيمة_اسم_المنشئ: اسم = *اسم_المنشئ;
    ليكن هوية_اسم_النوع: متغير معرف_اسم = معرف_اسم_من(0);
    ليكن هوية_اسم_المنشئ: متغير معرف_اسم = معرف_اسم_من(0);
    طابق معرف_اسم_محلول_عند(الروابط, قيمة_اسم_النوع.النطاق) مع
    | اختياري.موجود(الهوية) -> { هوية_اسم_النوع := الهوية; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق معرف_اسم_محلول_عند(الروابط, قيمة_اسم_المنشئ.النطاق) مع
    | اختياري.موجود(الهوية) -> { هوية_اسم_المنشئ := الهوية; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };

    طابق هوية_منشئ_مدمج_دلالية_بالأسماء(
        سياق_الأسماء, الأنواع, النوع, هوية_اسم_النوع, هوية_اسم_المنشئ
    ) مع
    | اختياري.موجود(الهوية) -> { أرجع اختياري.موجود(الهوية); }
    | اختياري.لا_شيء -> { };

    طابق رمز_اسم_محلول_عند(الروابط, قيمة_اسم_المنشئ.النطاق) مع
    | اختياري.موجود(رمز_المنشئ) -> {
        أرجع هوية_منشئ_تعداد_دلالية_بالرمز(الأنواع, النوع, رمز_المنشئ);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف اربط_أنواع_رموز_حمولات_منشئ(
    الحمولات: &متجه نمط,
    النوع: معرف_نوع,
    الهوية: هوية_منشئ_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحمولات) مثل طبيعي)) {
        ليكن نوع_الابن: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع, الهوية, ف) مع
        | اختياري.موجود(الموجود) -> { نوع_الابن := الموجود; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        إذا (!اربط_أنواع_رموز_نمط_تركيبي(
            &(*الحمولات)[ف], نوع_الابن, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The first constructor pattern, at any depth, whose payload count differs
// from its constructor's: why a pattern failed to bind, said precisely.
عام نوع مخالفة_حمولات_نمط = {
    النطاق: نطاق,
    المتوقع: طبيعي,
    الموجود: طبيعي
};

عرف مخالفة_حمولات_نمط_في(
    النمط: &نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء
): اختياري مخالفة_حمولات_نمط {
    ليكن القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.منشئ(_, اسم_النوع, اسم_المنشئ, الحمولات) -> {
        طابق هوية_منشئ_مسمى_للنوع(&اسم_النوع, &اسم_المنشئ, النوع, سياق_الأسماء, الأنواع, الروابط) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الهوية) -> {
            طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, النوع, الهوية) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الوصف) -> {
                ليكن العدد: طبيعي = الطول(الحمولات) مثل طبيعي;
                إذا (العدد != الوصف.عدد_الحمولات) {
                    ليكن المخالفة: مخالفة_حمولات_نمط = {
                        النطاق: نطاق_نمط(النمط),
                        المتوقع: الوصف.عدد_الحمولات,
                        الموجود: العدد
                    };
                    أرجع اختياري.موجود(المخالفة);
                };
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < العدد) {
                    طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع, الهوية, ف) مع
                    | اختياري.موجود(نوع_الحمولة) -> {
                        طابق مخالفة_حمولات_نمط_في(&الحمولات[ف], نوع_الحمولة, سياق_الأسماء, الأنواع, الروابط) مع
                        | اختياري.موجود(الداخلية) -> { أرجع اختياري.موجود(الداخلية); }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    ف := ف + 1;
                }
                أرجع اختياري.لا_شيء();
            };
        };
    }
    | نمط.بدائل(_, البدائل) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البدائل) مثل طبيعي)) {
            طابق مخالفة_حمولات_نمط_في(&البدائل[ف], النوع, سياق_الأسماء, الأنواع, الروابط) مع
            | اختياري.موجود(الداخلية) -> { أرجع اختياري.موجود(الداخلية); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | نمط.مستعار(_, الداخل, _) -> {
        أرجع مخالفة_حمولات_نمط_في(&(*الداخل), النوع, سياق_الأسماء, الأنواع, الروابط);
    }
    | نمط.تسلسل(_, السابقة, _, اللاحقة) -> {
        طابق نوع_عنصر_تسلسل_دلالي(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنصر) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(السابقة) مثل طبيعي)) {
                طابق مخالفة_حمولات_نمط_في(&السابقة[ف], العنصر, سياق_الأسماء, الأنواع, الروابط) مع
                | اختياري.موجود(الداخلية) -> { أرجع اختياري.موجود(الداخلية); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            ف := 0;
            طالما (ف < (الطول(اللاحقة) مثل طبيعي)) {
                طابق مخالفة_حمولات_نمط_في(&اللاحقة[ف], العنصر, سياق_الأسماء, الأنواع, الروابط) مع
                | اختياري.موجود(الداخلية) -> { أرجع اختياري.موجود(الداخلية); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف اربط_أنواع_رموز_نمط_منشئ(
    اسم_النوع: &اسم,
    اسم_المنشئ: &اسم,
    الحمولات: &متجه نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    طابق هوية_منشئ_مسمى_للنوع(
        اسم_النوع, اسم_المنشئ, النوع, سياق_الأسماء, الأنواع, الروابط
    ) مع
    | اختياري.موجود(الهوية) -> {
        أرجع اربط_أنواع_رموز_حمولات_منشئ(
            الحمولات, النوع, الهوية, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف اربط_أنواع_رموز_نمط_تركيبي(
    النمط: &نمط,
    النوع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): منطقي {
    ليكن القيمة: نمط = *النمط;
    طابق القيمة مع
    | نمط.بدل(_) -> { أرجع صواب; }
    | نمط.ربط(_, الاسم) -> {
        أرجع اربط_نوع_رمز_نمط_ربط(&الاسم, النوع, الروابط, أنواع_الرموز);
    }
    | نمط.حرفي(_, _) -> { أرجع صواب; }
    | نمط.مدى(_, _, _) -> { أرجع صواب; }
    | نمط.بدائل(_, البدائل) -> {
        // Every alternative is matched against the same Type. The first is
        // bound last, so a name the alternatives share keeps the first one's
        // Type for the arm; Pattern reports alternatives that disagree.
        ليكن العدد: طبيعي = الطول(البدائل) مثل طبيعي;
        ليكن ف: متغير طبيعي = 1;
        طالما (ف < العدد) {
            إذا (!اربط_أنواع_رموز_نمط_تركيبي(
                &البدائل[ف], النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
            )) { أرجع خطأ; };
            ف := ف + 1;
        }
        إذا (العدد == 0) { أرجع صواب; };
        أرجع اربط_أنواع_رموز_نمط_تركيبي(
            &البدائل[0], النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | نمط.صف(_, العناصر) -> {
        أرجع اربط_أنواع_رموز_نمط_صف(
            &العناصر, النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | نمط.سجل(_, الحقول) -> {
        أرجع اربط_أنواع_رموز_نمط_سجل(
            &الحقول, النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | نمط.منشئ(_, اسم_النوع, اسم_المنشئ, الحمولات) -> {
        أرجع اربط_أنواع_رموز_نمط_منشئ(
            &اسم_النوع, &اسم_المنشئ, &الحمولات, النوع,
            سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        );
    }
    | نمط.تسلسل(_, السابقة, البقية, اللاحقة) -> {
        // The elements have the vector's (or slice's) element Type; a named
        // rest is a slice of them.
        ليكن العنصر: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_عنصر_تسلسل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(الموجود) -> { العنصر := الموجود; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(السابقة) مثل طبيعي)) {
            إذا (!اربط_أنواع_رموز_نمط_تركيبي(
                &السابقة[ف], العنصر, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
            )) { أرجع خطأ; };
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول(اللاحقة) مثل طبيعي)) {
            إذا (!اربط_أنواع_رموز_نمط_تركيبي(
                &اللاحقة[ف], العنصر, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
            )) { أرجع خطأ; };
            ف := ف + 1;
        }
        إذا ((الطول(البقية) مثل طبيعي) > 0) {
            ليكن الشريحة: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.شريحة(العنصر));
            إذا (!اربط_أنواع_رموز_نمط_تركيبي(
                &البقية[0], الشريحة, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
            )) { أرجع خطأ; };
        };
        أرجع صواب;
    }
    | نمط.مستعار(_, الداخل, الاسم) -> {
        // The name has the Type of the whole value.
        إذا (!اربط_أنواع_رموز_نمط_تركيبي(
            &(*الداخل), النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
        )) { أرجع خطأ; };
        أرجع اربط_نوع_رمز_نمط_ربط(&الاسم, النوع, الروابط, أنواع_الرموز);
    };
}

// `match &mutable v with` (`طابق &متغير م مع`): the patterns match v itself, a
// vector or slice the program may write, and only a named rest is writable
// (اجعل_بقايا_نمط_قابلة_للكتابة); elements bound out of it stay read-only
// values. The scrutinee is typed as v (its span records v's Type), and
// lowering reads v in place (msir/lowering/statements.sn). Any other
// scrutinee is typed as it is.
عرف ابن_نوع_مميز_داخلي(
    المميز: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    طابق *المميز مع
    | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, صندوق_الداخل) -> {
        ليكن الداخل: &تعبير = &(*صندوق_الداخل);
        إذا (هل_تعبير_موضع_دلالي(الداخل)) {
            طابق ابن_نوع_تعبير_داخلي(الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                طابق نوع_عنصر_مقطع_داخلي(الأنواع, النوع) مع
                | اختياري.موجود(_) -> {
                    إذا (!هل_موضع_قابل_للتغيير(الداخل, الأنواع, أنواع_التعبيرات)) {
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(الداخل))
                        );
                    };
                    أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, المميز, النوع);
                }
                | اختياري.لا_شيء -> { };
            };
        };
    }
    | _ -> { };
    أرجع ابن_نوع_تعبير_داخلي(المميز, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
}

// Whether the scrutinee is `&mutable v` of a vector or slice (ابن_نوع_مميز_داخلي).
عام عرف هل_مميز_قابل_للكتابة(المميز: &تعبير): منطقي {
    طابق *المميز مع
    | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether the scrutinee is a call of `split_mutable`.
عرف هل_مميز_قسمة_داخلي(المميز: &تعبير, سياق_الأسماء: &سياق_أسماء, الروابط: &سياق_روابط_أسماء): منطقي {
    طابق *المميز مع
    | تعبير.استدعاء(_, صندوق_المستدعى, _) -> {
        أرجع هل_قسمة_قابلة_للتعديل_داخلي(&(*صندوق_المستدعى), سياق_الأسماء, الروابط);
    }
    | _ -> { أرجع خطأ; };
}

// The names a match binds the two halves of `split_mutable` to (`(left,
// right)`, also under `as` or in alternatives): each is a `mutable [] T`, a
// writable view of its half.
عرف اجعل_نصفي_قسمة_قابلين_للكتابة(
    النمط: &نمط,
    الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): فراغ {
    ليكن الأبناء: متغير متجه نمط = [];
    طابق *النمط مع
    | نمط.صف(_, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            طابق العناصر[ف] مع
            | نمط.ربط(_, الاسم) -> {
                طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
                | اختياري.موجود(الرمز) -> {
                    طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                    | اختياري.موجود(نوع_الشريحة) -> {
                        إذا (!هل_نوع_مغلف_بمتغير(الأنواع, نوع_الشريحة)) {
                            ليكن القابل: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.متغير(نوع_الشريحة));
                            ليكن أضيف: منطقي = أضف_نوع_رمز(أنواع_الرموز, الرمز, القابل);
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ف := ف + 1;
        }
    }
    | نمط.بدائل(_, البدائل) -> { الأبناء := انسخ_مملوكا_متجه_نمط(&البدائل); }
    | نمط.مستعار(_, الداخل, _) -> { ألحق(الأبناء, انسخ_مملوكا_نمط(&(*الداخل))); }
    | _ -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأبناء) مثل طبيعي)) {
        اجعل_نصفي_قسمة_قابلين_للكتابة(&الأبناء[ف], الأنواع, الروابط, أنواع_الرموز);
        ف := ف + 1;
    }
}

// A tuple `let` (ذراع_مطابقة.نوع_ليكن), `let (a, (b, _)): (A, (B, C)) = e;`:
// the Type is written, and its shape is the pattern's (the parser kept the
// pattern to a tuple of names, `_` and nested tuples). 0 when it fits; 1
// when the Type, or a part of it that a nested tuple takes apart, is no
// tuple with one element for each part of the pattern; 2 when it, or a
// name's element, is `mutable` and no writable view `mutable [] T`.
عرف مخالفة_نوع_ربط_صف(النمط: &نمط, النوع: معرف_نوع, الأنواع: &سجل_أنواع): ط32 {
    طابق *النمط مع
    | نمط.صف(_, العناصر) -> {
        إذا (هل_نوع_مغلف_بمتغير(الأنواع, النوع)) { أرجع 2; };
        ليكن العدد: متغير طبيعي = 0;
        طابق عدد_عناصر_صف_دلالي(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع 1; }
        | اختياري.موجود(ع) -> { العدد := ع; };
        إذا (العدد != (الطول(العناصر) مثل طبيعي)) { أرجع 1; };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف) مع
            | اختياري.لا_شيء -> { أرجع 1; }
            | اختياري.موجود(العنصر) -> {
                ليكن المخالفة: ط32 = مخالفة_نوع_ربط_صف(&العناصر[ف], العنصر, الأنواع);
                إذا (المخالفة != 0) { أرجع المخالفة; };
            };
            ف := ف + 1;
        }
        أرجع 0;
    }
    | نمط.ربط(_, _) -> {
        إذا (!هل_نوع_مغلف_بمتغير(الأنواع, النوع)) { أرجع 0; };
        طابق نوع_عنصر_شريحة_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(_) -> { أرجع 0; }
        | اختياري.لا_شيء -> { أرجع 2; };
    }
    | _ -> { أرجع 0; };
}

// Whether the pair `split_mutable` gives (plain slices, الموجود) fits the
// Type a tuple `let` wrote for it (المكتوب): element by element, nested
// tuples included, the same Types with or without `mutable`. The halves are
// the writable views `mutable [] T` the Type may name, or read-only views.
عرف ربط_صف_يقبل_قسمة(المكتوب: معرف_نوع, الموجود: معرف_نوع, الأنواع: &سجل_أنواع): منطقي {
    طابق عدد_عناصر_صف_دلالي(الأنواع, المكتوب) مع
    | اختياري.لا_شيء -> { أرجع نوعان_متوافقان(الأنواع, المكتوب, الموجود); }
    | اختياري.موجود(العدد) -> {
        طابق عدد_عناصر_صف_دلالي(الأنواع, الموجود) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(عدد_الموجود) -> {
            إذا (عدد_الموجود != العدد) { أرجع خطأ; };
        };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_عنصر_صف_دلالي_عند(الأنواع, المكتوب, ف) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(عنصر_المكتوب) -> {
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, الموجود, ف) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(عنصر_الموجود) -> {
                    إذا (!ربط_صف_يقبل_قسمة(عنصر_المكتوب, عنصر_الموجود, الأنواع)) { أرجع خطأ; };
                };
            };
            ف := ف + 1;
        }
        أرجع صواب;
    };
}

// The types of a tuple `let`, the match `match e with | (a, b) -> { … }`
// whose only arm carries the written Type (parser/statements.sn,
// مطابقة_ربط_صف): the Type fits the pattern (مخالفة_نوع_ربط_صف); the value
// is typed against it, as a `let` initializer is (a tuple literal takes its
// element Types from it, and a writable view in it needs `&mutable`), except
// the pair of `split_mutable`, whose halves fit any Type that names them
// with or without `mutable` (ربط_صف_يقبل_قسمة); and each name is given its
// element of the written Type, not of the value's: `mutable [] T` is a
// writable view, `[] T` a read-only one.
عرف ابن_أنواع_ربط_صف_داخلي(
    النمط: &نمط,
    المكتوب: &نوع_تركيبي,
    المميز: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن نطاق_النوع: نطاق = نطاق_نوع_تركيبي_داخلي(المكتوب);
    ليكن النوع: متغير معرف_نوع = معرف_نوع_من(0);
    طابق قنن_نوع_تركيبي(الأنواع, الروابط, المكتوب) مع
    | نتيجة_حل_نوع.موجود(المعرف) -> {
        طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, المعرف, نطاق_النوع) مع
        | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
        | اختياري.لا_شيء -> { };
        النوع := المعرف;
    }
    | _ -> { أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_النوع)); };
    ليكن المخالفة: ط32 = مخالفة_نوع_ربط_صف(النمط, النوع, الأنواع);
    إذا (المخالفة == 1) {
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.ربط_صف_بنوع_غير_مطابق(نطاق_النوع));
    };
    إذا (المخالفة == 2) {
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.ربط_صف_قابل_للتغيير(نطاق_النوع));
    };
    إذا (هل_مميز_قسمة_داخلي(المميز, سياق_الأسماء, الروابط)) {
        ليكن نوع_القيمة: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_مميز_داخلي(المميز, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(الموجود) -> { نوع_القيمة := الموجود; };
        إذا (!ربط_صف_يقبل_قسمة(النوع, نوع_القيمة, الأنواع)) {
            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                نطاق_تعبير(المميز), سياق_عدم_توافق_نوع.قيمة_لا_تطابق_الوجهة(),
                اختياري.موجود(النوع), اختياري.موجود(نوع_القيمة)
            ));
        };
    } وإلا {
        طابق ابن_نوع_تعبير_بتوقع_داخلي(
            المميز, النوع, موضع_توقع_نوع.تهيئة(), سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        ) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | _ -> { };
    };
    إذا (!اربط_أنواع_رموز_نمط_تركيبي(النمط, النوع, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز)) {
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.ربط_صف_بنوع_غير_مطابق(نطاق_النوع));
    };
    أرجع اختياري.لا_شيء();
}

// The named rests (`rest name`) of a pattern under `match &mutable v`: each
// is a `mutable [] T`, a writable view of v's elements, so writing through
// it changes v. The other bindings keep their Types: read-only values.
عرف اجعل_بقايا_نمط_قابلة_للكتابة(
    النمط: &نمط,
    الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): فراغ {
    ليكن الأبناء: متغير متجه نمط = [];
    طابق *النمط مع
    | نمط.تسلسل(_, السابقة, البقية, اللاحقة) -> {
        إذا ((الطول(البقية) مثل طبيعي) > 0) {
            طابق البقية[0] مع
            | نمط.ربط(_, الاسم) -> {
                طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
                | اختياري.موجود(الرمز) -> {
                    طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                    | اختياري.موجود(نوع_الشريحة) -> {
                        إذا (!هل_نوع_مغلف_بمتغير(الأنواع, نوع_الشريحة)) {
                            ليكن القابل: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.متغير(نوع_الشريحة));
                            ليكن أضيف: منطقي = أضف_نوع_رمز(أنواع_الرموز, الرمز, القابل);
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        };
    }
    | نمط.بدائل(_, البدائل) -> { الأبناء := انسخ_مملوكا_متجه_نمط(&البدائل); }
    | نمط.مستعار(_, الداخل, _) -> { ألحق(الأبناء, انسخ_مملوكا_نمط(&(*الداخل))); }
    | _ -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأبناء) مثل طبيعي)) {
        اجعل_بقايا_نمط_قابلة_للكتابة(&الأبناء[ف], الأنواع, الروابط, أنواع_الرموز);
        ف := ف + 1;
    }
}

عرف رموز_معاملات_نوع_معلنة(
    المعاملات: &متجه اسم,
    الروابط: &سياق_روابط_أسماء
): اختياري متجه معرف_رمز {
    ليكن الناتج: متغير متجه معرف_رمز = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعاملات) مثل طبيعي)) {
        طابق رمز_اسم_محلول_عند(الروابط, (*المعاملات)[ف].النطاق) مع
        | اختياري.موجود(الرمز) -> { ألحق(الناتج, الرمز); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

عرف سجل_قائمة_معاملات_نوع(
    المعاملات: &متجه اسم,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول(*المعاملات) مثل طبيعي)) {
        طابق رمز_اسم_محلول_عند(الروابط, (*المعاملات)[م].النطاق) مع
        | اختياري.موجود(الرمز) -> {
            ليكن النوع: معرف_نوع = سجل_معامل_نوع(الأنواع, الرمز);
            إذا (!أضف_نوع_رمز(أنواع_الرموز, الرمز, النوع)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح((*المعاملات)[م].النطاق));
            };
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.ربط_اسم_مفقود((*المعاملات)[م].النطاق));
        };
        م := م + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف سجل_معاملات_نوع_العناصر(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        طابق (*العناصر)[ف] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            طابق سجل_قائمة_معاملات_نوع(&الدالة.معاملات_النوع, الروابط, الأنواع, أنواع_الرموز) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            إذا ((الطول(الدالة.معاملات_النوع) مثل طبيعي) > 0) {
                طابق رمز_اسم_محلول_عند(الروابط, الدالة.الاسم.النطاق) مع
                | اختياري.موجود(رمز_الدالة) -> {
                    طابق رموز_معاملات_نوع_معلنة(&الدالة.معاملات_النوع, الروابط) مع
                    | اختياري.موجود(الرموز) -> {
                        ليكن المسجلة: معاملات_نوع_دالة_مسجلة = { الرمز: رمز_الدالة, المعاملات: الرموز };
                        ألحق((*أنواع_الرموز).معاملات_الدوال, المسجلة);
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | عنصر_وحدة.نوع(التصريح) -> {
            طابق سجل_قائمة_معاملات_نوع(&التصريح.معاملات_النوع, الروابط, الأنواع, أنواع_الرموز) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أعلن_التراكيب_المسماة(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ليكن مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        ليكن العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.نوع(التصريح) -> {
            طابق التصريح.الشكل مع
            | شكل_تصريح_نوع.سجل(_) -> {
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(الرمز) -> {
                    طابق رموز_معاملات_نوع_معلنة(&التصريح.معاملات_النوع, الروابط) مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    }
                    | اختياري.موجود(معاملات_النوع) -> {
                        إذا (!أضف_سجل_نوع_بمعاملات(الأنواع, الرمز, معاملات_النوع)) {
                            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                        };
                    };
                };
            }
            | شكل_تصريح_نوع.تعداد(_) -> {
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(الرمز) -> {
                    طابق رموز_معاملات_نوع_معلنة(&التصريح.معاملات_النوع, الروابط) مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    }
                    | اختياري.موجود(معاملات_النوع) -> {
                        إذا (!أضف_تعداد_نوع_بمعاملات(الأنواع, الرمز, معاملات_النوع)) {
                            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                        };
                    };
                };
            }
            // Complete at declaration: no members are filled in later. An
            // opaque type takes no type parameters.
            | شكل_تصريح_نوع.معتم(_) -> {
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(الرمز) -> {
                    إذا ((الطول(التصريح.معاملات_النوع) مثل طبيعي) != 0) {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    };
                    إذا (!أضف_معتم_نوع(الأنواع, الرمز)) {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                    };
                };
            }
            | شكل_تصريح_نوع.مرادف(_) -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أكمل_المرادفات(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    علاقات_الهرم: &متغير متجه علاقة_هرم_نوع
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن مكتملة: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ألحق(مكتملة, خطأ);
        ف := ف + 1;
    }
    ليكن جولة: متغير طبيعي = 0;
    طالما (جولة < (الطول(*العناصر) مثل طبيعي)) {
        ليكن تقدم: متغير منطقي = خطأ;
        ف := 0;
        طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
            إذا (!مكتملة[ف]) {
                ليكن مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
                ليكن العنصر: عنصر_وحدة = *مرجع_العنصر;
                طابق العنصر مع
                | عنصر_وحدة.نوع(التصريح) -> {
                    طابق التصريح.الشكل مع
                    | شكل_تصريح_نوع.مرادف(الهدف) -> {
                        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الهدف) مع
                        | نتيجة_حل_نوع.موجود(نوع_الهدف) -> {
                            // An alias of an opaque type is that same type.
                            إذا (!هل_نوع_معتم(الأنواع, نوع_الهدف)) {
                                طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, نوع_الهدف, نطاق_نوع_تركيبي_داخلي(&الهدف)) مع
                                | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                                | اختياري.لا_شيء -> { };
                            };
                            طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                            | نتيجة.خطأ(الخطأ) -> {
                                أرجع اختياري.موجود(الخطأ);
                            }
                            | نتيجة.نجح(الرمز) -> {
                                طابق الهدف مع
                                | نوع_تركيبي.مسمى(_, اسم_الهدف, _) -> {
                                    طابق رمز_اسم_محلول_عند(الروابط, اسم_الهدف.النطاق) مع
                                    | اختياري.موجود(رمز_الهدف) -> {
                                        ليكن العلاقة: علاقة_هرم_نوع = {
                                            النوع_الفرعي: الرمز,
                                            النوع_العلوي: رمز_الهدف
                                        };
                                        ألحق(*علاقات_الهرم, العلاقة);
                                    }
                                    | اختياري.لا_شيء -> { };
                                }
                                | _ -> { };
                                طابق رموز_معاملات_نوع_معلنة(&التصريح.معاملات_النوع, الروابط) مع
                                | اختياري.لا_شيء -> {
                                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                                }
                                | اختياري.موجود(معاملات_النوع) -> {
                                    إذا (!أضف_مرادف_نوع_بمعاملات(الأنواع, الرمز, معاملات_النوع, نوع_الهدف)) {
                                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                                    };
                                };
                                مكتملة[ف] := صواب;
                                تقدم := صواب;
                            };
                        }
                        | نتيجة_حل_نوع.مفقود -> { }
                        | _ -> {
                            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&الهدف)));
                        };
                    }
                    | _ -> {
                        مكتملة[ف] := صواب;
                    };
                }
                | _ -> {
                    مكتملة[ف] := صواب;
                };
            };
            ف := ف + 1;
        }
        إذا (!تقدم) {
            جولة := الطول(*العناصر) مثل طبيعي;
        }
        وإلا {
            جولة := جولة + 1;
        };
    }
    ف := 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        إذا (!مكتملة[ف]) {
            ليكن مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
            ليكن العنصر: عنصر_وحدة = *مرجع_العنصر;
            طابق العنصر مع
            | عنصر_وحدة.نوع(التصريح) -> {
                طابق التصريح.الشكل مع
                | شكل_تصريح_نوع.مرادف(الهدف) -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&الهدف)));
                }
                | _ -> { };
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أكمل_التراكيب_المسماة(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ليكن مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        ليكن العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.نوع(التصريح) -> {
            طابق التصريح.الشكل مع
            | شكل_تصريح_نوع.سجل(الحقول_النحوية) -> {
                ليكن الرمز: متغير معرف_رمز = معرف_رمز_من(0);
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(القيمة_رمز) -> {
                    الرمز := القيمة_رمز;
                };
                ليكن الحقول: متغير متجه حقل_سجل_دلالي = [];
                ليكن ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الحقول_النحوية) مثل طبيعي)) {
                    ليكن نوع_الحقل: متغير معرف_نوع = معرف_نوع_من(0);
                    طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الحقول_النحوية[ح].النوع) مع
                    | نتيجة_حل_نوع.موجود(المعرف) -> {
                        طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, المعرف, نطاق_نوع_تركيبي_داخلي(&الحقول_النحوية[ح].النوع)) مع
                        | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                        | اختياري.لا_شيء -> { };
                        نوع_الحقل := المعرف;
                    }
                    | _ -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                            نطاق_نوع_تركيبي_داخلي(&الحقول_النحوية[ح].النوع)
                        ));
                    };
                    طابق هوية_اسم_مطلوبة_للنوع(الروابط, &الحقول_النحوية[ح].الاسم) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | نتيجة.نجح(هوية_الحقل) -> {
                        ليكن الحقل: حقل_سجل_دلالي = { الاسم: هوية_الحقل, النوع: نوع_الحقل };
                        ألحق(الحقول, الحقل);
                    };
                    ح := ح + 1;
                }
                إذا (!أكمل_سجل_نوع_بحقول(الأنواع, الرمز, الحقول)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
            }
            | شكل_تصريح_نوع.تعداد(المنشئات_النحوية) -> {
                ليكن رمز_التعداد: متغير معرف_رمز = معرف_رمز_من(0);
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(القيمة_رمز) -> {
                    رمز_التعداد := القيمة_رمز;
                };
                ليكن نوع_التعداد: متغير معرف_نوع = معرف_نوع_من(0);
                طابق حل_نوع_مسمى(الأنواع, رمز_التعداد) مع
                | نتيجة_حل_نوع.موجود(المعرف) -> {
                    نوع_التعداد := المعرف;
                }
                | _ -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
                ليكن المنشئات: متغير متجه منشئ_نوع_دلالي = [];
                ليكن م: متغير طبيعي = 0;
                طالما (م < (الطول(المنشئات_النحوية) مثل طبيعي)) {
                    ليكن رمز_المنشئ: متغير معرف_رمز = معرف_رمز_من(0);
                    طابق رمز_اسم_مطلوب_للنوع(الروابط, &المنشئات_النحوية[م].الاسم) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | نتيجة.نجح(القيمة_رمز) -> {
                        رمز_المنشئ := القيمة_رمز;
                    };
                    ليكن اسم_المنشئ: متغير معرف_اسم = معرف_اسم_من(0);
                    طابق هوية_اسم_مطلوبة_للنوع(الروابط, &المنشئات_النحوية[م].الاسم) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | نتيجة.نجح(الهوية) -> {
                        اسم_المنشئ := الهوية;
                    };
                    ليكن الحمولات: متغير متجه معرف_نوع = [];
                    ليكن أنواع_المعاملات: متغير متجه معرف_نوع = [];
                    ليكن ح: متغير طبيعي = 0;
                    طالما (ح < (الطول(المنشئات_النحوية[م].الحمولات) مثل طبيعي)) {
                        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &المنشئات_النحوية[م].الحمولات[ح]) مع
                        | نتيجة_حل_نوع.موجود(المعرف) -> {
                            طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, المعرف, نطاق_نوع_تركيبي_داخلي(&المنشئات_النحوية[م].الحمولات[ح])) مع
                            | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                            | اختياري.لا_شيء -> { };
                            ألحق(الحمولات, المعرف);
                            ألحق(أنواع_المعاملات, المعرف);
                        }
                        | _ -> {
                            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                                نطاق_نوع_تركيبي_داخلي(&المنشئات_النحوية[م].الحمولات[ح])
                            ));
                        };
                        ح := ح + 1;
                    }
                    ليكن الهوية_الدلالية: هوية_منشئ_نوع = هوية_منشئ_نوع.تعداد(رمز_المنشئ);
                    ليكن الاسم_الدلالي: اختياري معرف_اسم = اختياري.موجود(اسم_المنشئ);
                    ليكن المنشئ: منشئ_نوع_دلالي = {
                        الهوية: الهوية_الدلالية,
                        الاسم: الاسم_الدلالي,
                        الحمولات: الحمولات
                    };
                    ألحق(المنشئات, المنشئ);
                    ليكن نوع_الدالة: معرف_نوع = قنن_نوعا(
                        الأنواع,
                        نوع_مقنن.دالة(أنواع_المعاملات, نوع_التعداد)
                    );
                    إذا (!أضف_نوع_رمز(أنواع_الرموز, رمز_المنشئ, نوع_الدالة)) {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(المنشئات_النحوية[م].الاسم.النطاق));
                    };
                    م := م + 1;
                }
                إذا (!أكمل_تعداد_نوع_بمنشئات(الأنواع, رمز_التعداد, المنشئات)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
            }
            // Registered complete by أعلن_التراكيب_المسماة: no members.
            | شكل_تصريح_نوع.معتم(_) -> { }
            | شكل_تصريح_نوع.مرادف(_) -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

نوع نتيجة_نوع_تعبير_داخلية =
    | موجود بنوع معرف_نوع
    | خطأ بنوع خطأ_بناء_سياقات_أنواع
;

عرف خطأ_أنواع_غير_متوافقة(
    النطاق: نطاق,
    السياق: سياق_عدم_توافق_نوع,
    المتوقع: معرف_نوع,
    الموجود: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
        النطاق, السياق, اختياري.موجود(المتوقع), اختياري.موجود(الموجود)
    ));
}

// The opaque-type error of a written Type (docs/en/reference/type-system.md,
// "Opaque types"), at the span of that written Type.
عرف خطأ_معتم_في_نوع_مكتوب(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    النطاق: نطاق
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق استعمال_معتم_ممنوع_في_نوع(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاستعمال) -> {
        إذا (الاستعمال.حجة_نوع) {
            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
                النطاق, صنف_استعمال_معتم.حجة_نوع(), الاستعمال.المعتم
            ));
        };
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
            النطاق, صنف_استعمال_معتم.بالقيمة(), الاستعمال.المعتم
        ));
    };
}

// A written type argument may be an opaque type itself: whether the generic
// can take it is decided on the instance (its signature at the call, its
// body by monomorphization). Any other use of an opaque type in it is
// checked as a written type.
عرف خطأ_معتم_في_حجة_نوع(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    النطاق: نطاق
): اختياري خطأ_بناء_سياقات_أنواع {
    إذا (هل_نوع_معتم(الأنواع, النوع)) { أرجع اختياري.لا_شيء(); };
    أرجع خطأ_معتم_في_نوع_مكتوب(الأنواع, النوع, النطاق);
}

عرف هل_مؤشر_خام_دلالي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_نوع_صحيح_32_دلالي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.ط32) -> { أرجع صواب; }
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.ص32) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// The first cast between a raw pointer and a 32-bit integer on a target
// whose pointers are not 32 bits wide: there the address word is 64 bits.
عام عرف أول_تحويل_عنوان_32_مرفوض(
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    عرض_المؤشر_بالبتات: طبيعي
): اختياري خطأ_بناء_سياقات_أنواع {
    إذا (عرض_المؤشر_بالبتات == 32) { أرجع اختياري.لا_شيء(); };
    ليكن و: متغير طبيعي = 0;
    طالما (و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        ليكن السياق: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        إذا ((الطول((*السياق).تحويلات_عنوان_32) مثل طبيعي) > 0) {
            ليكن الحقيقة: حقيقة_تحويل_عنوان_32 = (*السياق).تحويلات_عنوان_32[0];
            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                الحقيقة.النطاق, سياق_عدم_توافق_نوع.تحويل_غير_صالح(),
                اختياري.موجود(الحقيقة.الهدف), اختياري.موجود(الحقيقة.المصدر)
            ));
        };
        و := و + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A generic call whose type arguments bind an opaque type: the instantiated
// signature must pass and return the type only behind pointers, or the
// caller would hold a value of it. The related location is the generic's
// declaration. Its body is checked per instance by monomorphization
// (أول_استعمال_معتم_في_مثيل, compiler/msir/lowering/monomorphization.sn).
عرف خطأ_معتم_في_توقيع_مثيل(
    الأنواع: &متغير سجل_أنواع,
    سياق_الأسماء: &سياق_أسماء,
    نوع_المستدعى: معرف_نوع,
    الاستبدالات: &متجه ربط_استبدال_نوع,
    رمز_المستدعى: اختياري معرف_رمز,
    النطاق: نطاق
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن فيها_معتم: متغير منطقي = خطأ;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاستبدالات) مثل طبيعي)) {
        إذا (يحوي_نوعا_معتما(الأنواع, (*الاستبدالات)[ف].الحجة)) { فيها_معتم := صواب; };
        ف := ف + 1;
    }
    إذا (!فيها_معتم) { أرجع اختياري.لا_شيء(); };
    ليكن المخصص: معرف_نوع = استبدل_نوعا(الأنواع, نوع_المستدعى, الاستبدالات);
    طابق استعمال_معتم_ممنوع_في_نوع(الأنواع, المخصص) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاستعمال) -> {
        ليكن المرتبط: متغير اختياري نطاق = اختياري.لا_شيء();
        طابق رمز_المستدعى مع
        | اختياري.موجود(الرمز) -> {
            إذا ((الرمز.القيمة مثل طبيعي) < (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
                المرتبط := اختياري.موجود((*سياق_الأسماء).الرموز[الرمز.القيمة].نطاق_الاسم);
            };
        }
        | اختياري.لا_شيء -> { };
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.معتم_في_توقيع_مثيل(
            النطاق, المرتبط, الاستعمال.المعتم
        ));
    };
}

// `*p` where p points at an opaque type, inside unsafe too.
عرف خطأ_فك_معتم(
    الأنواع: &سجل_أنواع,
    نوع_المؤشر: معرف_نوع,
    النطاق: نطاق
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق معتم_خلف_مؤشر(الأنواع, نوع_المؤشر) مع
    | اختياري.موجود(المعتم) -> {
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
            النطاق, صنف_استعمال_معتم.فك(), المعتم
        ));
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف خطأ_نوع_موجود_غير_مناسب(
    النطاق: نطاق,
    السياق: سياق_عدم_توافق_نوع,
    الموجود: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
        النطاق, السياق, اختياري.لا_شيء(), اختياري.موجود(الموجود)
    ));
}

// The Type a shared or mutable reference refers to (its `mutable` wrapper
// aside), for a field read through it.
عرف داخل_مرجع_لحقل(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مرجع(الداخل, _) -> { أرجع اختياري.موجود(الداخل); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// Whether a field read through references may be written: every reference
// level on the way is `&mutable`.
عرف مرجع_حقل_قابل_للكتابة(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري منطقي {
    ليكن الحالي: متغير معرف_نوع = النوع;
    ليكن وجد_مرجعا: متغير منطقي = خطأ;
    ليكن العمق: متغير طبيعي = 0;
    طالما (العمق < 16) {
        طابق معرف_نوع_أساس_عند(الأنواع, الحالي) مع
        | اختياري.لا_شيء -> { العمق := 16; }
        | اختياري.موجود(الأساس) -> {
            طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
            | نوع_مقنن.مرجع(الداخل, متغير_المرجع) -> {
                إذا (!متغير_المرجع) { أرجع اختياري.موجود(خطأ); };
                وجد_مرجعا := صواب;
                الحالي := الداخل;
            }
            | _ -> { العمق := 16; };
        };
        العمق := العمق + 1;
    }
    إذا (!وجد_مرجعا) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(صواب);
}

// An operator its operands' Type does not define: the whole operation, the
// operator and the Type without the `mutable` of its storage.
عرف خطأ_عامل_غير_معرف(
    الأنواع: &سجل_أنواع,
    التعبير: &تعبير,
    العامل: عامل_ثنائي,
    النوع: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    ليكن الأساس: متغير معرف_نوع = النوع;
    طابق أزل_غلاف_متغير(الأنواع, النوع) مع
    | اختياري.موجود(القيمة) -> { الأساس := القيمة; }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.عامل_غير_معرف(
        نطاق_تعبير(التعبير), العامل, الأساس
    ));
}

// `&&` and `||`: points at the first operand that is not bool.
عرف خطأ_طرف_عامل_منطقي(
    الأنواع: &متغير سجل_أنواع,
    اليسار: &تعبير,
    نوع_اليسار: معرف_نوع,
    اليمين: &تعبير,
    نوع_اليمين: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    ليكن نوع_المنطقي: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
    إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_اليسار)) {
        أرجع خطأ_أنواع_غير_متوافقة(
            نطاق_تعبير(اليسار), سياق_عدم_توافق_نوع.عامل_يتطلب_منطقيا(),
            نوع_المنطقي, نوع_اليسار
        );
    };
    أرجع خطأ_أنواع_غير_متوافقة(
        نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.عامل_يتطلب_منطقيا(),
        نوع_المنطقي, نوع_اليمين
    );
}

عرف هل_نوع_عددي_للعامل(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    أرجع هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع) || هل_نوع_عشري_دلالي(الأنواع, النوع);
}

// Arithmetic and bitwise operators: a non-numeric operand first, then
// operands of different Types, then a float operand of an integer-only operator.
عرف خطأ_طرف_عامل_عددي(
    الأنواع: &متغير سجل_أنواع,
    التعبير: &تعبير,
    اليسار: &تعبير,
    نوع_اليسار: معرف_نوع,
    اليمين: &تعبير,
    نوع_اليمين: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    إذا (!هل_نوع_عددي_للعامل(الأنواع, نوع_اليسار)) {
        أرجع خطأ_نوع_موجود_غير_مناسب(
            نطاق_تعبير(اليسار), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا(), نوع_اليسار
        );
    };
    إذا (!هل_نوع_عددي_للعامل(الأنواع, نوع_اليمين)) {
        أرجع خطأ_نوع_موجود_غير_مناسب(
            نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا(), نوع_اليمين
        );
    };
    إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) {
        أرجع خطأ_أنواع_غير_متوافقة(
            نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(),
            نوع_اليسار, نوع_اليمين
        );
    };
    أرجع خطأ_نوع_موجود_غير_مناسب(
        نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا_صحيحا(), نوع_اليسار
    );
}

عرف نوع_بدائي_للخط(
    الأنواع: &متغير سجل_أنواع,
    البدائي: نوع_بدائي_مقنن
): معرف_نوع {
    أرجع قنن_نوعا_بدائيا(الأنواع, البدائي);
}

عرف ابن_أنواع_استدعاء_بدائي_مقننة(
    الأنواع: &متغير سجل_أنواع
): أنواع_استدعاء_بدائي_مقننة {
    ليكن النص: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
    ليكن العدد: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.عدد());
    ليكن عدد_ط32: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ط32());
    ليكن عدد_ط64: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ط64());
    ليكن عائم_ع32: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ع32());
    ليكن عائم_ع64: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ع64());
    ليكن عدد_طبيعي: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.طبيعي());
    ليكن القيم: أنواع_استدعاء_بدائي_مقننة = {
        النص: النص,
        العدد: العدد,
        عدد_ط32: عدد_ط32,
        عدد_ط64: عدد_ط64,
        عائم_ع32: عائم_ع32,
        عائم_ع64: عائم_ع64,
        عدد_طبيعي: عدد_طبيعي
    };
    أرجع القيم;
}

عرف نوع_حرفي_داخلي(
    الأنواع: &متغير سجل_أنواع,
    الحرفي: &حرفي
): معرف_نوع {
    ليكن القيمة: حرفي = *الحرفي;
    طابق القيمة مع
    | حرفي.منطقي(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
    }
    | حرفي.عدد(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.عدد());
    }
    | حرفي.عدد_طبيعي(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ط64());
    }
    | حرفي.عدد_عشري(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.ع64());
    }
    | حرفي.حرف(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.حرف());
    }
    | حرفي.نص(_) -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
    }
    | حرفي.غير_معرف -> {
        أرجع نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.أي());
    };
}

عرف نوع_فك_داخلي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.مرجع(الداخل, _) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف نوع_عنصر_فهرسة_داخلي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.متجه(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.شريحة(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.مؤشر(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.صندوق(الداخل) -> {
            أرجع اختياري.موجود(الداخل);
        }
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.نص) -> {
            أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط8());
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف سجل_نوع_تعبير_داخلي(
    الأنواع: &سجل_أنواع,
    السياق: &متغير سياق_أنواع_تعبيرات,
    التعبير: &تعبير,
    النوع: معرف_نوع
): نتيجة_نوع_تعبير_داخلية {
    إذا (!أضف_نوع_تعبير(الأنواع, السياق, نطاق_تعبير(التعبير), النوع)) {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير())
        );
    };
    أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع);
}

نوع قيمة_عدد_صحيح_سياقية =
    | موقع بنوع عدد
    | طبيعي بنوع طبيعي
;

عرف قيمة_عدد_صحيح_سياقية_لتعبير(التعبير: &تعبير): اختياري قيمة_عدد_صحيح_سياقية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, حرفي.عدد(العدد)) -> {
        أرجع اختياري.موجود(قيمة_عدد_صحيح_سياقية.موقع(العدد));
    }
    | تعبير.حرفي(_, حرفي.عدد_طبيعي(العدد)) -> {
        أرجع اختياري.موجود(قيمة_عدد_صحيح_سياقية.طبيعي(العدد));
    }
    | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
        ليكن الداخل: تعبير = *الداخل_المملوك;
        طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الداخل) مع
        | اختياري.موجود(القيمة_السياقية) -> {
            طابق القيمة_السياقية مع
            | قيمة_عدد_صحيح_سياقية.موقع(العدد) -> {
                // -(-MIN) has no signed value: negating the minimum would
                // overflow here, in the checker. It is no contextual
                // literal, so it gets its ordinary range check instead.
                إذا (العدد == (-9223372036854775807 - 1)) { أرجع اختياري.لا_شيء(); };
                أرجع اختياري.موجود(قيمة_عدد_صحيح_سياقية.موقع(0 - العدد));
            }
            | قيمة_عدد_صحيح_سياقية.طبيعي(_) -> {
                أرجع اختياري.لا_شيء();
            };
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف سجل_نوع_عدد_صحيح_سياقي(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    التعبير: &تعبير,
    النوع: معرف_نوع
): منطقي {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, حرفي.عدد(_)) -> {
        أرجع أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع);
    }
    | تعبير.حرفي(_, حرفي.عدد_طبيعي(_)) -> {
        أرجع أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع);
    }
    | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
        ليكن الداخل: تعبير = *الداخل_المملوك;
        إذا (!سجل_نوع_عدد_صحيح_سياقي(الأنواع, أنواع_التعبيرات, &الداخل, النوع)) {
            أرجع خطأ;
        };
        أرجع أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع);
    }
    | _ -> {
        أرجع خطأ;
    };
}

نوع موضع_توقع_نوع =
    | مفهرس بنوع طبيعي
    | بدائي بنوع (هوية_بدائي_مترجم, طبيعي)
    | إرجاع
    // A declared or assigned destination: let, :=, record field, tuple,
    // vector or box element.
    | تهيئة
    // An operand typed against the other operand or the operator's result.
    | طرف_عامل
    // The value of an arm of a match expression without a context Type,
    // typed against the value of its first arm that gives one.
    | ذراع_مطابقة
    | فرع_إذا
;

عرف هل_موضع_حجة(الموضع: موضع_توقع_نوع): منطقي {
    طابق الموضع مع
    | موضع_توقع_نوع.مفهرس(_) -> { أرجع صواب; }
    | موضع_توقع_نوع.بدائي(_, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف خطأ_عدم_توافق_نوع_متوقع(
    الموضع: موضع_توقع_نوع,
    النطاق: نطاق,
    المتوقع: معرف_نوع,
    الموجود: معرف_نوع
): خطأ_بناء_سياقات_أنواع {
    طابق الموضع مع
    | موضع_توقع_نوع.مفهرس(الفهرس) -> {
        أرجع خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
            النطاق, الفهرس, المتوقع, الموجود
        );
    }
    | موضع_توقع_نوع.بدائي(البدائي, الفهرس) -> {
        أرجع خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_مطابق(
            النطاق, البدائي, الفهرس, المتوقع, الموجود
        );
    }
    | موضع_توقع_نوع.إرجاع -> {
        أرجع خطأ_بناء_سياقات_أنواع.نوع_إرجاع_غير_مطابق(
            النطاق, المتوقع, الموجود
        );
    }
    | موضع_توقع_نوع.تهيئة -> {
        أرجع خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            النطاق, سياق_عدم_توافق_نوع.قيمة_لا_تطابق_الوجهة(),
            اختياري.موجود(المتوقع), اختياري.موجود(الموجود)
        );
    }
    | موضع_توقع_نوع.طرف_عامل -> {
        أرجع خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            النطاق, سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(),
            اختياري.موجود(المتوقع), اختياري.موجود(الموجود)
        );
    }
    | موضع_توقع_نوع.ذراع_مطابقة -> {
        أرجع خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            النطاق, سياق_عدم_توافق_نوع.أذرع_مطابقة_مختلفة(),
            اختياري.موجود(المتوقع), اختياري.موجود(الموجود)
        );
    }
    | موضع_توقع_نوع.فرع_إذا -> {
        أرجع خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            النطاق, سياق_عدم_توافق_نوع.فروع_إذا_مختلفة(),
            اختياري.موجود(المتوقع), اختياري.موجود(الموجود)
        );
    };
}

// An unsigned integer Type (طبيعي, ط8 … ط64).
عرف هل_نوع_عدد_طبيعي_دلالي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المرجع) -> {
        طابق (*الأنواع).الأنواع[المرجع.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عدد_صحيح_طبيعي();
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_نوع_عدد_صحيح_سياقي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(مرجع_النوع_12) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_12.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            طابق صنف_النوع_البدائي(البدائي) مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                أرجع صواب;
            }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
                أرجع صواب;
            }
            | _ -> {
                أرجع خطأ;
            };
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف هل_نوع_عشري_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(مرجع_النوع_13) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_13.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري();
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_عامل_ثنائي_ينتج_عشريا(العامل: عامل_ثنائي): منطقي {
    طابق العامل مع
    | عامل_ثنائي.جمع -> { أرجع صواب; }
    | عامل_ثنائي.طرح -> { أرجع صواب; }
    | عامل_ثنائي.ضرب -> { أرجع صواب; }
    | عامل_ثنائي.قسمة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether an expression is made of float literals only (with `-` and the
// operators that give a float). A worklist of references: no recursion
// however long a chain it holds.
عرف هل_تعبير_عشري_سياقي(التعبير: &تعبير): منطقي {
    // Raw pointers, not references: Stage0 has no lifetime for a vector of
    // references (bootstrap/src/semantic/body_initializer_check_vector_init.c).
    // Each points into the tree التعبير borrows, which outlives this walk.
    ليكن الانتظار: متغير متجه *تعبير = [];
    غير_آمن { ألحق(الانتظار, التعبير مثل *تعبير); };
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(الانتظار) مثل طبيعي)) {
        ليكن مؤشر_الحالي: *تعبير = الانتظار[الموضع];
        ليكن الحالي: &تعبير;
        غير_آمن { الحالي := &(*مؤشر_الحالي); };
        الموضع := الموضع + 1;
        طابق *الحالي مع
        | تعبير.حرفي(_, حرفي.عدد_عشري(_)) -> { }
        | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
            ليكن مرجع_الداخل_المملوك: &تعبير = &(*الداخل_المملوك);
            غير_آمن { ألحق(الانتظار, مرجع_الداخل_المملوك مثل *تعبير); };
        }
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            إذا (!هل_عامل_ثنائي_ينتج_عشريا(العامل)) { أرجع خطأ; };
            ليكن مرجع_اليسار_المملوك: &تعبير = &(*اليسار_المملوك);
            غير_آمن { ألحق(الانتظار, مرجع_اليسار_المملوك مثل *تعبير); };
            ليكن مرجع_اليمين_المملوك: &تعبير = &(*اليمين_المملوك);
            غير_آمن { ألحق(الانتظار, مرجع_اليمين_المملوك مثل *تعبير); };
        }
        | _ -> { أرجع خطأ; };
    }
    أرجع صواب;
}

عرف هل_نوع_منطقي_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(مرجع_النوع_14) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_14.القيمة] مع
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.منطقي) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_نوع_فراغ_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(مرجع_النوع_15) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_15.القيمة] مع
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.فراغ) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_نوع_مغلف_بمتغير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    إذا ((النوع.القيمة مثل طبيعي) >= (الطول((*الأنواع).الأنواع) مثل طبيعي)) { أرجع خطأ; };
    ليكن مرجع_النوع: &نوع_مقنن = &(*الأنواع).الأنواع[النوع.القيمة];
    طابق *مرجع_النوع مع
    | نوع_مقنن.متغير(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether the binary operator العامل is defined for operands of Type النوع
// (its `mutable` wrapper aside). Equality (`==`, `!=`) compares integers,
// floats, booleans, characters, text (by content, as std's texts_equal),
// raw pointers (by address) and enums without payloads (by constructor).
// Ordering (`<`, `<=`, `>`, `>=`) compares integers, floats and characters.
// `&&` and `||` take booleans; arithmetic takes numbers, bitwise operators
// and shifts integers. A Type that still holds a type parameter is checked
// when the generic is instantiated (MSIR lowering, عامل_غير_معرف_لنوع).
عام عرف هل_عامل_ثنائي_معرف_للنوع(
    الأنواع: &سجل_أنواع,
    العامل: عامل_ثنائي,
    النوع_المكتوب: معرف_نوع
): منطقي {
    إذا (هل_نوع_يحوي_معامل_نوع(الأنواع, النوع_المكتوب)) { أرجع صواب; };
    ليكن النوع: متغير معرف_نوع = النوع_المكتوب;
    طابق أزل_غلاف_متغير(الأنواع, النوع_المكتوب) مع
    | اختياري.موجود(الأساس) -> { النوع := الأساس; }
    | اختياري.لا_شيء -> { };
    ليكن عددي_صحيح: منطقي = هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع);
    ليكن عددي_عشري: منطقي = هل_نوع_عشري_دلالي(الأنواع, النوع);
    ليكن محرفي: منطقي = هل_نوع_بدائي_دلالي(الأنواع, النوع, نوع_بدائي_مقنن.حرف());
    طابق العامل مع
    | عامل_ثنائي.و -> { أرجع هل_نوع_منطقي_دلالي(الأنواع, النوع); }
    | عامل_ثنائي.أو -> { أرجع هل_نوع_منطقي_دلالي(الأنواع, النوع); }
    | عامل_ثنائي.يساوي -> { أرجع هل_نوع_يقبل_المساواة(الأنواع, النوع); }
    | عامل_ثنائي.لا_يساوي -> { أرجع هل_نوع_يقبل_المساواة(الأنواع, النوع); }
    | عامل_ثنائي.أصغر -> { أرجع عددي_صحيح || عددي_عشري || محرفي; }
    | عامل_ثنائي.أصغر_أو_يساوي -> { أرجع عددي_صحيح || عددي_عشري || محرفي; }
    | عامل_ثنائي.أكبر -> { أرجع عددي_صحيح || عددي_عشري || محرفي; }
    | عامل_ثنائي.أكبر_أو_يساوي -> { أرجع عددي_صحيح || عددي_عشري || محرفي; }
    | _ -> { أرجع عددي_صحيح || (عددي_عشري && هل_عامل_ثنائي_ينتج_عشريا(العامل)); };
}

عرف هل_نوع_بدائي_دلالي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    البدائي: نوع_بدائي_مقنن
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.بدائي(الموجود) -> { أرجع الموجود == البدائي; }
        | _ -> { أرجع خطأ; };
    };
}

// The Types `==` and `!=` compare (هل_عامل_ثنائي_معرف_للنوع).
عام عرف هل_نوع_يقبل_المساواة(الأنواع: &سجل_أنواع, النوع_المكتوب: معرف_نوع): منطقي {
    ليكن النوع: متغير معرف_نوع = النوع_المكتوب;
    طابق أزل_غلاف_متغير(الأنواع, النوع_المكتوب) مع
    | اختياري.موجود(الأساس) -> { النوع := الأساس; }
    | اختياري.لا_شيء -> { };
    إذا (هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع) || هل_نوع_عشري_دلالي(الأنواع, النوع)) { أرجع صواب; };
    إذا (هل_نوع_منطقي_دلالي(الأنواع, النوع)) { أرجع صواب; };
    إذا (هل_نوع_بدائي_دلالي(الأنواع, النوع, نوع_بدائي_مقنن.حرف())) { أرجع صواب; };
    إذا (هل_نوع_بدائي_دلالي(الأنواع, النوع, نوع_بدائي_مقنن.نص())) { أرجع صواب; };
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
        | _ -> { };
    };
    إذا (!هل_نوع_موسوم(الأنواع, النوع)) { أرجع خطأ; };
    ليكن العدد: متغير طبيعي = 0;
    طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(القيمة) -> { العدد := القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, النوع, ف) مع
        | اختياري.موجود(عدد_الحمولات) -> {
            إذا (عدد_الحمولات != 0) { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف هل_تعبير_موضع_دلالي(التعبير: &تعبير): منطقي {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, _) -> { أرجع صواب; }
    | تعبير.حقل(_, _, _) -> { أرجع صواب; }
    | تعبير.فهرس(_, _, _) -> { أرجع صواب; }
    | تعبير.فك_موضع(_, _) -> { أرجع صواب; }
    | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_مقطع_دلالي(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.مقطع(_, _, _, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف هل_تعبير_فهرسة_دلالي(التعبير: &تعبير): منطقي {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.فهرس(_, _, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether a record value is stored directly (not behind a reference,
// pointer or box, and not wrapped as mutable).
عرف هل_سجل_مباشر_غير_متغير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    إذا (هل_نوع_مغلف_بمتغير(الأنواع, النوع)) { أرجع خطأ; };
    إذا ((النوع.القيمة مثل طبيعي) >= (الطول((*الأنواع).الأنواع) مثل طبيعي)) { أرجع خطأ; };
    طابق (*الأنواع).الأنواع[النوع.القيمة] مع
    | نوع_مقنن.مسمى(_, شكل_نوع_مسمى.سجل, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// `a.b := v` where every step is a record stored in place and the root `a`
// is a local or parameter declared without `mutable`.
عرف هل_حقل_جذره_غير_قابل_للتغيير(
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): منطقي {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حقل(_, الأساس_المملوك, _) -> {
        ليكن الأساس: تعبير = *الأساس_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختياري.موجود(نوع_الأساس) -> {
            إذا (!هل_سجل_مباشر_غير_متغير(الأنواع, نوع_الأساس)) { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
        طابق الأساس مع
        | تعبير.اسم(_, _) -> { أرجع صواب; }
        | تعبير.حقل(_, _, _) -> {
            أرجع هل_حقل_جذره_غير_قابل_للتغيير(&الأساس, الأنواع, أنواع_التعبيرات);
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// Whether a field place is reached through a shared reference: `(*r).f`
// (or `r.f`, which means it) with `r: &T`, at any depth of fields. A write
// there is a write to an immutable place, as only `&mutable` writes through.
عرف هل_حقل_عبر_مرجع_مشترك(
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): منطقي {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حقل(_, الأساس_المملوك, _) -> {
        ليكن الأساس: تعبير = *الأساس_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختياري.موجود(نوع_الأساس) -> {
            إذا (هل_مرجع_مشترك_دلالي(الأنواع, نوع_الأساس)) { أرجع صواب; };
        }
        | _ -> { };
        طابق الأساس مع
        | تعبير.فك_موضع(_, الداخل_المملوك) -> {
            ليكن الداخل: تعبير = *الداخل_المملوك;
            طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الداخل)) مع
            | اختياري.موجود(نوع_الداخل) -> { أرجع هل_مرجع_مشترك_دلالي(الأنواع, نوع_الداخل); }
            | _ -> { أرجع خطأ; };
        }
        | تعبير.أحادي(_, عامل_أحادي.فك, الداخل_المملوك) -> {
            ليكن الداخل: تعبير = *الداخل_المملوك;
            طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الداخل)) مع
            | اختياري.موجود(نوع_الداخل) -> { أرجع هل_مرجع_مشترك_دلالي(الأنواع, نوع_الداخل); }
            | _ -> { أرجع خطأ; };
        }
        | تعبير.حقل(_, _, _) -> { أرجع هل_حقل_عبر_مرجع_مشترك(&الأساس, الأنواع, أنواع_التعبيرات); }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// Whether النوع is a shared reference `&T` (not `&mutable T`).
عرف هل_مرجع_مشترك_دلالي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مرجع(_, متغير_المرجع) -> { أرجع !متغير_المرجع; }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_موضع_قابل_للتغيير(
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): منطقي {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, _) -> {
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير)) مع
        | اختياري.موجود(النوع) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, النوع); }
        | _ -> { أرجع خطأ; };
    }
    | تعبير.حقل(_, الأساس_المملوك, _) -> {
        ليكن الأساس: تعبير = *الأساس_المملوك;
        // `r.f` through references (`(*r).f`) is writable when every
        // reference on the way is `&mutable`.
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختياري.موجود(نوع_الأساس) -> {
            طابق مرجع_حقل_قابل_للكتابة(الأنواع, نوع_الأساس) مع
            | اختياري.موجود(قابل) -> { أرجع قابل; }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        أرجع هل_موضع_قابل_للتغيير(&الأساس, الأنواع, أنواع_التعبيرات);
    }
    | تعبير.فهرس(_, الأساس_المملوك, _) -> {
        ليكن الأساس: تعبير = *الأساس_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختياري.موجود(نوع_الأساس) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, نوع_الأساس) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(مرجع_النوع_16) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_16.القيمة] مع
                | نوع_مقنن.بدائي(نوع_بدائي_مقنن.نص) -> { أرجع خطأ; }
                | _ -> { };
            };
        }
        | _ -> { أرجع خطأ; };
        // An element of a writable view (`mutable [] T`), wherever the view
        // is held: a local, a parameter, a pattern's binding.
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختياري.موجود(نوع_الأساس) -> {
            إذا (هل_نوع_مغلف_بمتغير(الأنواع, نوع_الأساس)) {
                طابق معرف_نوع_أساس_عند(الأنواع, نوع_الأساس) مع
                | اختياري.موجود(الداخل) -> {
                    طابق (*الأنواع).الأنواع[الداخل.القيمة] مع
                    | نوع_مقنن.شريحة(_) -> { أرجع صواب; }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | _ -> { };
        إذا (هل_موضع_قابل_للتغيير(&الأساس, الأنواع, أنواع_التعبيرات)) { أرجع صواب; };
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الأساس)) مع
        | اختياري.موجود(نوع_الأساس) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, نوع_الأساس) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_17) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_17.القيمة] مع
                | نوع_مقنن.مؤشر(الداخل) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, الداخل); }
                | _ -> { أرجع خطأ; };
            };
        }
        | _ -> { أرجع خطأ; };
    }
    | تعبير.فك_موضع(_, الداخل_المملوك) -> {
        ليكن الداخل: تعبير = *الداخل_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الداخل)) مع
        | اختياري.موجود(نوع_الداخل) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, نوع_الداخل) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_18) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_18.القيمة] مع
                | نوع_مقنن.مرجع(_, متغير_المرجع) -> { أرجع متغير_المرجع; }
                | نوع_مقنن.مؤشر(نوع_العنصر) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_العنصر); }
                | نوع_مقنن.صندوق(نوع_الصندوق) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_الصندوق); }
                | _ -> { أرجع خطأ; };
            };
        }
        | _ -> { أرجع خطأ; };
    }
    | تعبير.أحادي(_, عامل_أحادي.فك, الداخل_المملوك) -> {
        ليكن الداخل: تعبير = *الداخل_المملوك;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&الداخل)) مع
        | اختياري.موجود(نوع_الداخل) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, نوع_الداخل) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(مرجع_النوع_19) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_19.القيمة] مع
                | نوع_مقنن.مرجع(_, متغير_المرجع) -> { أرجع متغير_المرجع; }
                | نوع_مقنن.مؤشر(نوع_العنصر) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_العنصر); }
                | نوع_مقنن.صندوق(نوع_الصندوق) -> { أرجع هل_نوع_مغلف_بمتغير(الأنواع, نوع_الصندوق); }
                | _ -> { أرجع خطأ; };
            };
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل: عامل_ثنائي): منطقي {
    طابق العامل مع
    | عامل_ثنائي.أو_بتي -> { أرجع صواب; }
    | عامل_ثنائي.أو_حصري -> { أرجع صواب; }
    | عامل_ثنائي.و_بتي -> { أرجع صواب; }
    | عامل_ثنائي.إزاحة_يسرى -> { أرجع صواب; }
    | عامل_ثنائي.إزاحة_يمنى -> { أرجع صواب; }
    | عامل_ثنائي.إزاحة_حسابية_يمنى -> { أرجع صواب; }
    | عامل_ثنائي.جمع -> { أرجع صواب; }
    | عامل_ثنائي.طرح -> { أرجع صواب; }
    | عامل_ثنائي.ضرب -> { أرجع صواب; }
    | عامل_ثنائي.قسمة -> { أرجع صواب; }
    | عامل_ثنائي.باقي -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether an expression is made of integer literals only (with `-` and the
// operators that give an integer): it then takes its Type from its context.
// A worklist of references into the expression: no copy of it, and no
// recursion however long a chain it holds (previously each step copied the
// whole subtree, recursively).
عرف هل_تعبير_عدد_صحيح_سياقي(التعبير: &تعبير): منطقي {
    // Raw pointers, not references: Stage0 has no lifetime for a vector of
    // references (bootstrap/src/semantic/body_initializer_check_vector_init.c).
    // Each points into the tree التعبير borrows, which outlives this walk.
    ليكن الانتظار: متغير متجه *تعبير = [];
    غير_آمن { ألحق(الانتظار, التعبير مثل *تعبير); };
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(الانتظار) مثل طبيعي)) {
        ليكن مؤشر_الحالي: *تعبير = الانتظار[الموضع];
        ليكن الحالي: &تعبير;
        غير_آمن { الحالي := &(*مؤشر_الحالي); };
        الموضع := الموضع + 1;
        طابق *الحالي مع
        | تعبير.حرفي(_, حرفي.عدد(_)) -> { }
        | تعبير.حرفي(_, حرفي.عدد_طبيعي(_)) -> { }
        | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
            ليكن مرجع_الداخل_المملوك: &تعبير = &(*الداخل_المملوك);
            غير_آمن { ألحق(الانتظار, مرجع_الداخل_المملوك مثل *تعبير); };
        }
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            إذا (!هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل)) {
                أرجع خطأ;
            };
            ليكن مرجع_اليسار_المملوك: &تعبير = &(*اليسار_المملوك);
            غير_آمن { ألحق(الانتظار, مرجع_اليسار_المملوك مثل *تعبير); };
            ليكن مرجع_اليمين_المملوك: &تعبير = &(*اليمين_المملوك);
            غير_آمن { ألحق(الانتظار, مرجع_اليمين_المملوك مثل *تعبير); };
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    أرجع صواب;
}

// Explicit type arguments of a call (`f<A, B>(..)`): each declared type
// parameter of the callee is bound to its argument, in order, ahead of
// inference from the arguments and the expected result.
عرف استبدالات_حجج_نوع_صريحة_داخلي(
    المستدعى: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة متجه ربط_استبدال_نوع, خطأ_بناء_سياقات_أنواع {
    ليكن الناتج: متغير متجه ربط_استبدال_نوع = [];
    طابق *المستدعى مع
    | تعبير.حجج_نوع(النطاق, الداخل, الحجج) -> {
        ليكن المعاملات: متغير متجه معرف_رمز = [];
        طابق رمز_مستدعى_محلول_للنوع(سياق_الأسماء, الروابط, &(*الداخل)) مع
        | اختياري.موجود(الرمز) -> {
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول((*أنواع_الرموز).معاملات_الدوال) مثل طبيعي)) {
                إذا ((*أنواع_الرموز).معاملات_الدوال[م].الرمز.القيمة == الرمز.القيمة) {
                    المعاملات := انسخ_مملوكا_متجه_معرف_رمز(&(*أنواع_الرموز).معاملات_الدوال[م].المعاملات);
                };
                م := م + 1;
            }
        }
        | اختياري.لا_شيء -> { };
        إذا (الطول(المعاملات) != الطول(الحجج)) {
            أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                النطاق, الطول(المعاملات) مثل طبيعي, الطول(الحجج) مثل طبيعي
            ));
        };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الحجج[ف]) مع
            | نتيجة_حل_نوع.موجود(النوع) -> {
                طابق خطأ_معتم_في_حجة_نوع(الأنواع, النوع, نطاق_نوع_تركيبي_داخلي(&الحجج[ف])) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة.خطأ(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                ليكن الربط: ربط_استبدال_نوع = { المعامل: المعاملات[ف], الحجة: النوع };
                ألحق(الناتج, الربط);
            }
            | _ -> {
                أرجع نتيجة.خطأ(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&الحجج[ف])));
            };
            ف := ف + 1;
        }
    }
    | _ -> { };
    أرجع نتيجة.نجح(الناتج);
}

عرف رمز_مستدعى_محلول_للنوع(
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    المستدعى: &تعبير
): اختياري معرف_رمز {
    ليكن القيمة: تعبير = *المستدعى;
    ليكن الرمز: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> {
        الرمز := رمز_اسم_محلول_عند(الروابط, الاسم.النطاق);
    }
    | تعبير.حقل(_, _, الاسم) -> {
        الرمز := رمز_اسم_محلول_عند(الروابط, الاسم.النطاق);
    }
    | _ -> { };
    طابق الرمز مع
    | اختياري.موجود(المعرف) -> {
        طابق نوع_رمز_عند(سياق_الأسماء, المعرف) مع
        | اختياري.موجود(نوع_تصريح.دالة) -> { أرجع اختياري.موجود(المعرف); }
        | اختياري.موجود(نوع_تصريح.دالة_خارجية) -> { أرجع اختياري.موجود(المعرف); }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// A call of a track-caller function that passes the location itself: one
// argument more than its use Type takes (the location is the call's own).
عرف خطأ_حجة_موقع_صريحة_داخلي(
    أنواع_الرموز: &سياق_أنواع_رموز,
    الرمز: اختياري معرف_رمز,
    المتوقع: طبيعي,
    الموجود: طبيعي,
    الحجج: &متجه تعبير
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق الرمز مع
    | اختياري.موجود(المستدعى) -> {
        إذا (رمز_يتتبع_المستدعي(أنواع_الرموز, المستدعى) && الموجود == المتوقع + 1
            && الموجود <= (الطول(*الحجج) مثل طبيعي)) {
            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.حجة_موقع_المستدعي_صريحة(
                نطاق_تعبير(&(*الحجج)[الموجود - 1])
            ));
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عرف ابن_نوع_استدعاء_عادي_بتوقع_داخلي(
    التعبير: &تعبير,
    المستدعى_المكتوب: &تعبير,
    الحجج: &متجه تعبير,
    النوع_المتوقع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن المستدعى_الفعلي: تعبير = مستدعى_بلا_حجج_نوع(المستدعى_المكتوب);
    ليكن المستدعى: &تعبير = &المستدعى_الفعلي;
    ليكن الاستبدالات_الصريحة: متغير متجه ربط_استبدال_نوع = [];
    طابق استبدالات_حجج_نوع_صريحة_داخلي(
        المستدعى_المكتوب, سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
    | نتيجة.نجح(القيم) -> { الاستبدالات_الصريحة := القيم; };
    ليكن نوع_المستدعى: متغير معرف_نوع = معرف_نوع_من(0);
    طابق ابن_نوع_تعبير_داخلي(
        المستدعى, سياق_الأسماء, الأنواع,
        أنواع_التعبيرات, الروابط, أنواع_الرموز
    ) مع
    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
    }
    | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
        نوع_المستدعى := النوع;
    };

    ليكن الاستبدالات_الأولية: متجه ربط_استبدال_نوع = استنتج_استبدالات_ناتج_استدعاء(
        الأنواع, نوع_المستدعى, النوع_المتوقع
    );
    ليكن الاستبدالات_الحالية: متغير متجه ربط_استبدال_نوع = الاستبدالات_الصريحة;
    ليكن ص: متغير طبيعي = 0;
    طالما (ص < (الطول(الاستبدالات_الأولية) مثل طبيعي)) {
        ألحق(الاستبدالات_الحالية, الاستبدالات_الأولية[ص]);
        ص := ص + 1;
    }
    ليكن يسمح_بمؤقت: منطقي = يسمح_بعنوان_مؤقت_داخلي(الأنواع, نوع_المستدعى);
    ليكن أنواع_الحجج: متغير متجه معرف_نوع = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحجج) مثل طبيعي)) {
        ليكن نتيجة_الحجة: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&(*الحجج)[ف]), ثابت_أنواع_مكسور.حجة_بلا_نوع())
        );
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
        | اختياري.موجود(المتوقع_الخام) -> {
            ليكن المتوقع: معرف_نوع = استبدل_نوعا(
                الأنواع, المتوقع_الخام, &الاستبدالات_الحالية
            );
            ليكن توقع_الحجة: متغير اختياري معرف_نوع = اختياري.موجود(المتوقع);
            إذا (هل_نوع_يحوي_معامل_نوع(الأنواع, المتوقع)) { توقع_الحجة := اختياري.لا_شيء(); };
            نتيجة_الحجة := ابن_نوع_حجة_داخلي(
                &(*الحجج)[ف], توقع_الحجة, ف, يسمح_بمؤقت, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        }
        | اختياري.لا_شيء -> {
            ليكن بلا_توقع: اختياري معرف_نوع = اختياري.لا_شيء();
            نتيجة_الحجة := ابن_نوع_حجة_داخلي(
                &(*الحجج)[ف], بلا_توقع, ف, يسمح_بمؤقت, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        };
        طابق نتيجة_الحجة مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            ألحق(أنواع_الحجج, النوع);
            طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
            | اختياري.موجود(المتوقع_الخام) -> {
                إذا (!أضف_استبدالات_من_معامل_استدعاء(
                    الأنواع, المتوقع_الخام, النوع, &متغير الاستبدالات_الحالية
                )) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                            نطاق_تعبير(&(*الحجج)[ف]), ف, المتوقع_الخام, النوع
                        )
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }

    طابق تحقق_توقيع_استدعاء_باستبدالات(
        الأنواع, نوع_المستدعى, &أنواع_الحجج, &الاستبدالات_الحالية
    ) مع
    | نتيجة_توقيع_استدعاء.صالح(الناتج, استبدالات_النوع) -> {
        طابق خطأ_معتم_في_توقيع_مثيل(
            الأنواع, سياق_الأسماء, نوع_المستدعى, &استبدالات_النوع,
            رمز_مستدعى_محلول_للنوع(سياق_الأسماء, الروابط, المستدعى), نطاق_تعبير(التعبير)
        ) مع
        | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
        | اختياري.لا_شيء -> { };
        ليكن نطاقات_الحجج: متغير متجه نطاق = [];
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول(*الحجج) مثل طبيعي)) {
            ألحق(نطاقات_الحجج, نطاق_تعبير(&(*الحجج)[ح]));
            ح := ح + 1;
        }
        ليكن رمز_الاستدعاء: اختياري معرف_رمز = رمز_مستدعى_محلول_للنوع(
            سياق_الأسماء, الروابط, المستدعى
        );
        أضف_استدعاء_نوعيا(
            أنواع_التعبيرات, نطاق_تعبير(التعبير), نوع_المستدعى,
            رمز_الاستدعاء, نطاقات_الحجج, استبدالات_النوع
        );
        أرجع سجل_نوع_تعبير_داخلي(
            الأنواع, أنواع_التعبيرات, التعبير, الناتج
        );
    }
    | نتيجة_توقيع_استدعاء.مرفوض(خطأ_التوقيع) -> {
        طابق خطأ_التوقيع مع
        | خطأ_توقيع_استدعاء.غير_قابل_للاستدعاء -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(
                    نطاق_تعبير(التعبير), نوع_المستدعى
                )
            );
        }
        | خطأ_توقيع_استدعاء.عدد_حجج_غير_مطابق(المتوقع, الموجود) -> {
            طابق خطأ_حجة_موقع_صريحة_داخلي(
                أنواع_الرموز, رمز_مستدعى_محلول_للنوع(سياق_الأسماء, الروابط, المستدعى), المتوقع, الموجود, الحجج
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                    نطاق_تعبير(التعبير), المتوقع, الموجود
                )
            );
        }
        | خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                    نطاق_تعبير(&(*الحجج)[الفهرس]), الفهرس, المتوقع, الموجود
                )
            );
        };
    };
}

// Null-pointer literal is a contextual, unbound name occurrence, never a
// reserved keyword. Existing declarations named الفارغ retain their identity.
عرف هل_مؤشر_فارغ_سياقي(
    التعبير: &تعبير, الروابط: &سياق_روابط_أسماء
): منطقي {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        أرجع هل_ظهور_مؤشر_فارغ_سياقي(الروابط, الاسم.النطاق);
    }
    | _ -> { أرجع خطأ; };
}

// Types the elements of a vector literal expression from البداية on against
// نوع_العنصر and records نوع_المتجه as the literal's Type.
عرف ابن_نوع_حرفي_متجه_داخلي(
    التعبير: &تعبير,
    نوع_المتجه: معرف_نوع,
    نوع_العنصر: معرف_نوع,
    البداية: طبيعي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    طابق *التعبير مع
    | تعبير.حرفي_متجه(_, العناصر) -> {
        ليكن ع: متغير طبيعي = البداية;
        طالما (ع < (الطول(العناصر) مثل طبيعي)) {
            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                &العناصر[ع], نوع_العنصر, موضع_توقع_نوع.تهيئة(), سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | _ -> { };
            ع := ع + 1;
        }
    }
    | _ -> { };
    أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_المتجه);
}

// Whether values of النوع can hold no reference, raw pointer, slice or
// closure: a borrow passed into a call cannot come back out in its result.
// المزارة breaks cycles through recursive named Types.
عرف هل_نوع_خال_من_المراجع_داخلي(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المزارة: &متغير متجه معرف_نوع
): منطقي {
    // A Type already known to be free of references (هل_نوع_خال_من_المراجع_مخبأ_داخلي).
    إذا (خلو_مراجع_نوع_عند(الأنواع, النوع) == 1) { أرجع صواب; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المزارة) مثل طبيعي)) {
        إذا ((*المزارة)[ف].القيمة == النوع.القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    ألحق((*المزارة), النوع);
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.بدائي(_) -> { أرجع صواب; }
        | نوع_مقنن.صف(العناصر) -> {
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(العناصر) مثل طبيعي)) {
                إذا (!هل_نوع_خال_من_المراجع_داخلي(الأنواع, العناصر[ع], المزارة)) { أرجع خطأ; };
                ع := ع + 1;
            }
            أرجع صواب;
        }
        | نوع_مقنن.صندوق(الداخل) -> { أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, الداخل, المزارة); }
        | نوع_مقنن.اختيار(الداخل) -> { أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, الداخل, المزارة); }
        | نوع_مقنن.متجه(الداخل) -> { أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, الداخل, المزارة); }
        | نوع_مقنن.متغير(الداخل) -> { أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, الداخل, المزارة); }
        | نوع_مقنن.نتيجة(أ, ب) -> {
            إذا (!هل_نوع_خال_من_المراجع_داخلي(الأنواع, أ, المزارة)) { أرجع خطأ; };
            أرجع هل_نوع_خال_من_المراجع_داخلي(الأنواع, ب, المزارة);
        }
        | نوع_مقنن.مسمى(_, _, _) -> {
            طابق عدد_حقول_سجل_دلالي(الأنواع, الأساس) مع
            | اختياري.موجود(عدد_الحقول) -> {
                ليكن ح: متغير طبيعي = 0;
                طالما (ح < عدد_الحقول) {
                    طابق نوع_حقل_سجل_دلالي_عند(الأنواع, الأساس, ح) مع
                    | اختياري.موجود(نوع_الحقل) -> {
                        إذا (!هل_نوع_خال_من_المراجع_داخلي(الأنواع, نوع_الحقل, المزارة)) { أرجع خطأ; };
                    }
                    | اختياري.لا_شيء -> { أرجع خطأ; };
                    ح := ح + 1;
                }
                أرجع صواب;
            }
            | اختياري.لا_شيء -> { };
            طابق عدد_منشئات_نوع_دلالي(الأنواع, الأساس) مع
            | اختياري.موجود(عدد_المنشئات) -> {
                ليكن م: متغير طبيعي = 0;
                طالما (م < عدد_المنشئات) {
                    ليكن عدد_الحمولات: متغير طبيعي = 0;
                    طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, الأساس, م) مع
                    | اختياري.موجود(العدد) -> { عدد_الحمولات := العدد; }
                    | اختياري.لا_شيء -> { أرجع خطأ; };
                    ليكن ح: متغير طبيعي = 0;
                    طالما (ح < عدد_الحمولات) {
                        طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, الأساس, م, ح) مع
                        | اختياري.موجود(نوع_الحمولة) -> {
                            إذا (!هل_نوع_خال_من_المراجع_داخلي(الأنواع, نوع_الحمولة, المزارة)) { أرجع خطأ; };
                        }
                        | اختياري.لا_شيء -> { أرجع خطأ; };
                        ح := ح + 1;
                    }
                    م := م + 1;
                }
                أرجع صواب;
            }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}

// هل_نوع_خال_من_المراجع_داخلي from a fresh walk, with the answer kept in the
// registry. When the Type is free of references, every Type the walk reached
// is too (each holds only Types reachable from it), so all are marked; a
// "may hold one" is not kept, since a generic instance defined later can
// change it.
عرف هل_نوع_خال_من_المراجع_مخبأ_داخلي(الأنواع: &متغير سجل_أنواع, النوع: معرف_نوع): منطقي {
    إذا (خلو_مراجع_نوع_عند(الأنواع, النوع) == 1) { أرجع صواب; };
    ليكن المزارة: متغير متجه معرف_نوع = [];
    ليكن الخالي: منطقي = هل_نوع_خال_من_المراجع_داخلي(الأنواع, النوع, &متغير المزارة);
    إذا (الخالي) {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المزارة) مثل طبيعي)) {
            ضع_خلو_مراجع_نوع(الأنواع, المزارة[ف], 1);
            ف := ف + 1;
        }
    };
    أرجع الخالي;
}

// Whether a call through نوع_المستدعى may take `&e` of a value that is not a
// place (a literal, a call result): the temporary lives to the end of the
// enclosing block, and a result that can hold no reference cannot carry the
// borrow past it.
عرف يسمح_بعنوان_مؤقت_داخلي(الأنواع: &متغير سجل_أنواع, نوع_المستدعى: معرف_نوع): منطقي {
    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_المستدعى) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الناتج) -> {
        أرجع هل_نوع_خال_من_المراجع_مخبأ_داخلي(الأنواع, الناتج);
    };
}

// `string` when النوع is `&string` (a shared reference to text).
عرف نوع_نص_مرجع_مشترك(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري معرف_نوع {
    طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(الداخل) -> {
        إذا (هل_نوع_بدائي_دلالي(الأنواع, الداخل, نوع_بدائي_مقنن.نص())) {
            أرجع اختياري.موجود(الداخل);
        };
        أرجع اختياري.لا_شيء();
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// `&e` or `&mutable e` as written.
عرف هل_تعبير_عنوان_دلالي(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.أحادي(_, العامل, _) -> {
        أرجع العامل == عامل_أحادي.عنوان() || العامل == عامل_أحادي.عنوان_متغير();
    }
    | _ -> { أرجع خطأ; };
}

// A literal as an operand of `&`: an integer, float, bool, char or text
// literal, or a negated numeric literal.
عرف هل_حرفي_لعنوان_دلالي(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.حرفي(_, _) -> { أرجع صواب; }
    | تعبير.أحادي(_, العامل, الداخل) -> {
        إذا (العامل != عامل_أحادي.سالب()) { أرجع خطأ; };
        طابق *الداخل مع
        | تعبير.حرفي(_, _) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// `&` of a literal (`&20`, `&"total"`): in every expression position it is
// a temporary that lives to the end of the enclosing statement.
عرف هل_عنوان_حرفي_دلالي(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.أحادي(_, العامل, الداخل) -> {
        إذا (العامل != عامل_أحادي.عنوان()) { أرجع خطأ; };
        أرجع هل_حرفي_لعنوان_دلالي(&(*الداخل));
    }
    | _ -> { أرجع خطأ; };
}

// The literal of the first `&literal` whose borrow the value of التعبير may
// carry. Its temporary ends with the statement, so a value kept past the
// statement (a binding, an assignment, an initializer, a returned value)
// must not hold it. A value whose Type holds no reference carries none.
عرف أول_عنوان_حرفي_محمول(
    التعبير: &تعبير,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): اختياري نطاق {
    طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير)) مع
    | اختياري.موجود(النوع) -> {
        إذا (هل_نوع_خال_من_المراجع_مخبأ_داخلي(الأنواع, النوع)) { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { };
    طابق *التعبير مع
    | تعبير.أحادي(_, العامل, الداخل) -> {
        إذا (العامل == عامل_أحادي.عنوان() && هل_حرفي_لعنوان_دلالي(&(*الداخل))) {
            أرجع اختياري.موجود(نطاق_تعبير(&(*الداخل)));
        };
        أرجع اختياري.لا_شيء();
    }
    | تعبير.استدعاء(_, _, الحجج) -> { أرجع أول_عنوان_حرفي_محمول_في(&الحجج, الأنواع, أنواع_التعبيرات); }
    | تعبير.حرفي_متجه(_, العناصر) -> { أرجع أول_عنوان_حرفي_محمول_في(&العناصر, الأنواع, أنواع_التعبيرات); }
    | تعبير.حرفي_صف(_, العناصر) -> { أرجع أول_عنوان_حرفي_محمول_في(&العناصر, الأنواع, أنواع_التعبيرات); }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            طابق أول_عنوان_حرفي_محمول(&الحقول[ف].القيمة, الأنواع, أنواع_التعبيرات) مع
            | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | تعبير.تحويل(_, الداخل, _) -> { أرجع أول_عنوان_حرفي_محمول(&(*الداخل), الأنواع, أنواع_التعبيرات); }
    | تعبير.مطابقة(_, المطابقة) -> {
        ليكن ق: متغير طبيعي = 0;
        طالما (ق < (الطول((*المطابقة).القيم) مثل طبيعي)) {
            طابق (*المطابقة).القيم[ق] مع
            | اختياري.موجود(القيمة) -> {
                طابق أول_عنوان_حرفي_محمول(&القيمة, الأنواع, أنواع_التعبيرات) مع
                | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            ق := ق + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف أول_عنوان_حرفي_محمول_في(
    التعابير: &متجه تعبير,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): اختياري نطاق {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التعابير) مثل طبيعي)) {
        طابق أول_عنوان_حرفي_محمول(&(*التعابير)[ف], الأنواع, أنواع_التعبيرات) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The kept value of a statement must not borrow a literal's temporary.
عرف خطأ_عنوان_حرفي_محمول(
    التعبير: &تعبير,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق أول_عنوان_حرفي_محمول(التعبير, الأنواع, أنواع_التعبيرات) مع
    | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(النطاق)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف خطأ_عنوان_حرفي_محمول_في(
    التعابير: &متجه تعبير,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق أول_عنوان_حرفي_محمول_في(التعابير, الأنواع, أنواع_التعبيرات) مع
    | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(النطاق)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// A slice is no temporary: `&s[a..b]` of text is a `&string` that borrows s
// (ابن_نوع_مقطع_نص_داخلي).
عرف هل_عنوان_مؤقت_دلالي(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.أحادي(_, العامل, الداخل) -> {
        إذا (العامل != عامل_أحادي.عنوان()) { أرجع خطأ; };
        إذا (هل_تعبير_مقطع_دلالي(&(*الداخل))) { أرجع خطأ; };
        أرجع !هل_تعبير_موضع_دلالي(&(*الداخل));
    }
    | _ -> { أرجع خطأ; };
}

// Types `&e` of a temporary as a call argument: e is typed against the
// referenced Type of a shared-reference expectation (or on its own) and the
// argument has Type `&T`.
عرف ابن_نوع_عنوان_مؤقت_داخلي(
    التعبير: &تعبير,
    المتوقع: اختياري معرف_نوع,
    الموضع: موضع_توقع_نوع,
    يسمح: منطقي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    طابق *التعبير مع
    | تعبير.أحادي(_, _, الداخل_المملوك) -> {
        ليكن الداخل: &تعبير = &(*الداخل_المملوك);
        إذا (!يسمح) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(الداخل)));
        };
        ليكن نوع_الهدف: متغير اختياري معرف_نوع = اختياري.لا_شيء();
        طابق المتوقع مع
        | اختياري.موجود(م) -> { نوع_الهدف := نوع_داخل_مرجع_دلالي(الأنواع, م); }
        | اختياري.لا_شيء -> { };
        ليكن نتيجة_الداخل: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(الداخل))
        );
        طابق نوع_الهدف مع
        | اختياري.موجود(الهدف) -> {
            نتيجة_الداخل := ابن_نوع_تعبير_بتوقع_داخلي(
                الداخل, الهدف, موضع_توقع_نوع.تهيئة(), سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        }
        | اختياري.لا_شيء -> {
            نتيجة_الداخل := ابن_نوع_تعبير_داخلي(
                الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        };
        طابق نتيجة_الداخل مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الداخل) -> {
            ليكن نوع_المرجع_الأساس: متغير معرف_نوع = نوع_الداخل;
            طابق أزل_غلاف_متغير(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(الأساس) -> { نوع_المرجع_الأساس := الأساس; }
            | اختياري.لا_شيء -> { };
            ليكن نوع_المرجع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_المرجع_الأساس, خطأ));
            طابق المتوقع مع
            | اختياري.موجود(م) -> {
                إذا (!نوعان_متوافقان(الأنواع, م, نوع_المرجع)) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_عدم_توافق_نوع_متوقع(الموضع, نطاق_تعبير(التعبير), م, نوع_المرجع)
                    );
                };
            }
            | اختياري.لا_شيء -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_المرجع);
        };
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(التعبير)));
}

// A call argument typed against its parameter, or on its own when the
// parameter's Type is still generic (المتوقع none).
عرف ابن_نوع_حجة_داخلي(
    الحجة: &تعبير,
    المتوقع: اختياري معرف_نوع,
    الفهرس: طبيعي,
    يسمح_بمؤقت: منطقي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    // `&` of a literal is allowed whatever the call returns: its temporary
    // lives to the end of the statement, and a kept value that could carry
    // the borrow past it is rejected there (أول_عنوان_حرفي_محمول). Another
    // temporary needs a result that holds no reference.
    إذا (هل_عنوان_مؤقت_دلالي(الحجة)) {
        أرجع ابن_نوع_عنوان_مؤقت_داخلي(
            الحجة, المتوقع, موضع_توقع_نوع.مفهرس(الفهرس),
            يسمح_بمؤقت || هل_عنوان_حرفي_دلالي(الحجة), سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    };
    // A text argument (a place or a literal, or any other `string` value)
    // for a `&string` parameter is borrowed for the call, as if written
    // `&arg`. Only text: no other
    // Type is borrowed implicitly. The frontend writes the `&` out before
    // the later phases (frontend/desugar/implicit_places.sn).
    طابق المتوقع مع
    | اختياري.موجود(م) -> {
        طابق نوع_نص_مرجع_مشترك(الأنواع, م) مع
        | اختياري.موجود(نوع_النص) -> {
            إذا (!هل_تعبير_عنوان_دلالي(الحجة)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(
                    الحجة, نوع_النص, موضع_توقع_نوع.مفهرس(الفهرس), سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.موجود(_) -> {
                    أضف_موضع_ضمني(أنواع_التعبيرات, نطاق_تعبير(الحجة), 1, 1);
                    أرجع نتيجة_نوع_تعبير_داخلية.موجود(م);
                }
                | نتيجة_نوع_تعبير_داخلية.خطأ(_) -> { };
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    طابق المتوقع مع
    | اختياري.موجود(م) -> {
        أرجع ابن_نوع_تعبير_بتوقع_داخلي(
            الحجة, م, موضع_توقع_نوع.مفهرس(الفهرس), سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    }
    | اختياري.لا_شيء -> {
        أرجع ابن_نوع_تعبير_داخلي(
            الحجة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    };
}

// Types a record literal's fields against the record Type نوع_الوجهة: each
// field is known, written once, and typed against its declared Type; none
// is left out. Shared by `let r: T = {..};` and the record literal expression.
عرف افحص_حقول_سجل_داخلي(
    نطاق_الوجهة: نطاق,
    نوع_الوجهة: معرف_نوع,
    الحقول: &متجه حقل_تهيئة,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن عدد_الحقول_المتوقع: متغير طبيعي = 0;
    طابق عدد_حقول_سجل_دلالي(الأنواع, نوع_الوجهة) مع
    | اختياري.موجود(المتوقع) -> { عدد_الحقول_المتوقع := المتوقع; }
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            نطاق_الوجهة, سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
            اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
        ));
    };
    ليكن هويات_الحقول: متغير متجه معرف_اسم = [];
    ليكن نطاقات_الحقول: متغير متجه نطاق = [];
    ليكن ح: متغير طبيعي = 0;
    طالما (ح < (الطول(*الحقول) مثل طبيعي)) {
        ليكن نوع_الحقل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق هوية_اسم_مطلوبة_للنوع(الروابط, &(*الحقول)[ح].الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(هوية_الحقل) -> {
            ليكن هـ: متغير طبيعي = 0;
            طالما (هـ < (الطول(هويات_الحقول) مثل طبيعي)) {
                إذا (معرفا_اسم_متساويان(هويات_الحقول[هـ], هوية_الحقل)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.حقل_سجل_مكرر(
                        (*الحقول)[ح].الاسم.النطاق, نطاقات_الحقول[هـ]
                    ));
                };
                هـ := هـ + 1;
            }
            ألحق(هويات_الحقول, هوية_الحقل);
            ألحق(نطاقات_الحقول, (*الحقول)[ح].الاسم.النطاق);
            طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, نوع_الوجهة, هوية_الحقل) مع
            | اختياري.موجود(النوع) -> {
                نوع_الحقل := النوع;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(
                    خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف((*الحقول)[ح].الاسم.النطاق)
                );
            };
        };
        طابق ابن_نوع_تعبير_متوقع_داخلي(
            &(*الحقول)[ح].القيمة, نوع_الحقل, ح, سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        ) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | _ -> { };
        ح := ح + 1;
    }
    // Every written field is known and distinct, so a short count
    // means a field was left out: name the first one.
    إذا ((الطول(*الحقول) مثل طبيعي) != عدد_الحقول_المتوقع) {
        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.حقل_سجل_مفقود(
            نطاق_الوجهة,
            أول_حقل_سجل_مفقود(الأنواع, نوع_الوجهة, عدد_الحقول_المتوقع, &هويات_الحقول)
        ));
    };
    أرجع اختياري.لا_شيء();
}

// A left-nested chain of integer operators (عشري خطأ) or of float-literal
// operators (عشري صواب) typed against an expected integer or float Type: the
// innermost left operand is typed with the expectation in the chain's
// position, then each right operand, from the innermost node out, as an
// operand, and each node records the expected Type. That is the order of the
// recursion through ابن_نوع_تعبير_بتوقع_داخلي, with a loop: a chain of
// thousands of operands overflowed the stack before.
عرف ابن_نوع_سلسلة_بتوقع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    الموضع: موضع_توقع_نوع,
    عشري: منطقي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    // Raw pointers, not references: Stage0 has no lifetime for a vector of
    // references (bootstrap/src/semantic/body_initializer_check_vector_init.c).
    // Each points into the tree التعبير borrows, which outlives this walk.
    ليكن العقد: متغير متجه *تعبير = [];
    غير_آمن { ألحق(العقد, التعبير مثل *تعبير); };
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        مستمر := خطأ;
        ليكن مؤشر_الأخير: *تعبير = العقد[(الطول(العقد) مثل طبيعي) - 1];
        ليكن الأخير: &تعبير;
        غير_آمن { الأخير := &(*مؤشر_الأخير); };
        طابق *الأخير مع
        | تعبير.ثنائي(_, _, صندوق_اليسار, _) -> {
            ليكن اليسار: &تعبير = &(*صندوق_اليسار);
            طابق *اليسار مع
            | تعبير.ثنائي(_, العامل, _, _) -> {
                إذا (عشري || هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل)) {
                    غير_آمن { ألحق(العقد, اليسار مثل *تعبير); };
                    مستمر := صواب;
                };
            }
            | _ -> { };
        }
        | _ -> { };
    }
    ليكن ف: متغير طبيعي = الطول(العقد) مثل طبيعي;
    ليكن مؤشر_العقدة_4: *تعبير = العقد[ف - 1];
    ليكن العقدة_4: &تعبير;
    غير_آمن { العقدة_4 := &(*مؤشر_العقدة_4); };
    طابق *العقدة_4 مع
    | تعبير.ثنائي(_, _, صندوق_اليسار, _) -> {
        طابق ابن_نوع_تعبير_بتوقع_داخلي(&(*صندوق_اليسار), النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
    }
    | _ -> { };
    ليكن الناتج: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.موجود(النوع_المتوقع);
    طالما (ف > 0) {
        ف := ف - 1;
        ليكن مؤشر_العقدة_5: *تعبير = العقد[ف];
        ليكن العقدة_5: &تعبير;
        غير_آمن { العقدة_5 := &(*مؤشر_العقدة_5); };
        طابق *العقدة_5 مع
        | تعبير.ثنائي(_, _, _, صندوق_اليمين) -> {
            طابق ابن_نوع_تعبير_بتوقع_داخلي(&(*صندوق_اليمين), النوع_المتوقع, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            الناتج := سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, العقدة_5, النوع_المتوقع);
            طابق الناتج مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
        }
        | _ -> { };
    }
    أرجع الناتج;
}

// `&mutable v` where a `mutable [] T` is expected (a parameter, a local, an
// assignment) with v a vector or a slice of T: a writable view of all of v,
// as `&mutable v[..]` writes it. The expression is recorded as that implicit
// slice (موضع_ضمني of kind 2) and rewritten to it before the later phases
// (frontend/desugar/implicit_places.sn). v must be a place the program may
// write. None when the expression is no such borrow or nothing such is
// expected.
عرف ابن_نوع_عرض_قابل_للكتابة_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري نتيجة_نوع_تعبير_داخلية {
    إذا (!هل_نوع_مغلف_بمتغير(الأنواع, النوع_المتوقع)) { أرجع اختياري.لا_شيء(); };
    ليكن عنصر_المتوقع: متغير معرف_نوع = النوع_المتوقع;
    طابق معرف_نوع_أساس_عند(الأنواع, النوع_المتوقع) مع
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.شريحة(العنصر) -> { عنصر_المتوقع := العنصر; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق *التعبير مع
    | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, صندوق_الداخل) -> {
        ليكن الداخل: &تعبير = &(*صندوق_الداخل);
        طابق *الداخل مع
        | تعبير.مقطع(_, _, _, _) -> { أرجع اختياري.لا_شيء(); }
        | _ -> { };
        إذا (!هل_تعبير_موضع_دلالي(الداخل)) { أرجع اختياري.لا_شيء(); };
        ليكن نوع_الداخل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ)); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الداخل := النوع; };
        طابق نوع_عنصر_مقطع_داخلي(الأنواع, نوع_الداخل) مع
        | اختياري.موجود(العنصر) -> {
            إذا (!نوعان_متوافقان(الأنواع, العنصر, عنصر_المتوقع)) { أرجع اختياري.لا_شيء(); };
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        إذا (!هل_موضع_قابل_للتغيير(الداخل, الأنواع, أنواع_التعبيرات)) {
            أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(الداخل))
            ));
        };
        أضف_موضع_ضمني(أنواع_التعبيرات, نطاق_تعبير(التعبير), 2, 0);
        أرجع اختياري.موجود(سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع));
    }
    | _ -> { };
    // A vector or slice place, or a slice `v[a..b]`, given without `&mutable`
    // is a read-only view: `SULTANC-MUTABILITY-VIEW-WITHOUT-MUTABLE`, whose
    // fix writes `&mutable` before it. A literal or a call result (a buffer
    // of its own) stays accepted.
    إذا (!هل_تعبير_موضع_دلالي(التعبير) && !هل_تعبير_مقطع_دلالي(التعبير)) { أرجع اختياري.لا_شيء(); };
    طابق ابن_نوع_تعبير_داخلي(التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ)); }
    | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
        // A writable view already (a `mutable [] T` local or parameter) is
        // passed on as it is.
        إذا (هل_نوع_مغلف_بمتغير(الأنواع, النوع) && !هل_تعبير_مقطع_دلالي(التعبير)) {
            طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
            | اختياري.موجود(الأساس) -> {
                طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
                | نوع_مقنن.شريحة(_) -> { أرجع اختياري.لا_شيء(); }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
        };
        طابق نوع_عنصر_مقطع_داخلي(الأنواع, النوع) مع
        | اختياري.موجود(العنصر) -> {
            إذا (!نوعان_متوافقان(الأنواع, العنصر, عنصر_المتوقع)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.عرض_بلا_علامة(نطاق_تعبير(التعبير))
            ));
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
}

// The constructor a bare prelude name stands for where النوع_المتوقع is
// expected: option's `some`/`موجود` and `none`/`لا_شيء`, result's `ok`/`نجح`
// and `err`/`خطأ`. None when a declaration in scope has the name (it
// shadows the prelude: Name bound it to its Symbol), or when the expected
// Type is not the constructor's.
عام عرف هوية_منشئ_تمهيدي_للنوع(
    الاسم: &اسم,
    النوع_المتوقع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &سجل_أنواع,
    الروابط: &سياق_روابط_أسماء
): اختياري هوية_منشئ_نوع {
    طابق رمز_اسم_محلول_عند(الروابط, (*الاسم).النطاق) مع
    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
    | اختياري.لا_شيء -> { };
    ليكن الهوية: متغير معرف_اسم = معرف_اسم_من(0);
    طابق معرف_اسم_محلول_عند(الروابط, (*الاسم).النطاق) مع
    | اختياري.موجود(القيمة) -> { الهوية := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق معرف_نوع_أساس_عند(الأنواع, النوع_المتوقع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.اختيار(_) -> {
            إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «some»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «موجود»)) {
                أرجع اختياري.موجود(هوية_منشئ_نوع.اختيار_بعض());
            };
            إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «none»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «لا_شيء»)) {
                أرجع اختياري.موجود(هوية_منشئ_نوع.اختيار_لا_شيء());
            };
        }
        | نوع_مقنن.نتيجة(_, _) -> {
            إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «ok»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «نجح»)) {
                أرجع اختياري.موجود(هوية_منشئ_نوع.نتيجة_نجاح());
            };
            إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «err»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «خطأ»)) {
                أرجع اختياري.موجود(هوية_منشئ_نوع.نتيجة_خطأ());
            };
        }
        | _ -> { };
    };
    أرجع اختياري.لا_شيء();
}

// Which bare prelude constructor a name with no Symbol spells: 1 `some`
// (`موجود`), 2 `none` (`لا_شيء`), 3 `ok` (`نجح`), 4 `err` (`خطأ`); 0 for any
// other name.
عرف صنف_منشئ_تمهيدي_مجرد(
    الاسم: &اسم,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء
): ط32 {
    طابق رمز_اسم_محلول_عند(الروابط, (*الاسم).النطاق) مع
    | اختياري.موجود(_) -> { أرجع 0; }
    | اختياري.لا_شيء -> { };
    ليكن الهوية: متغير معرف_اسم = معرف_اسم_من(0);
    طابق معرف_اسم_محلول_عند(الروابط, (*الاسم).النطاق) مع
    | اختياري.موجود(القيمة) -> { الهوية := القيمة; }
    | اختياري.لا_شيء -> { أرجع 0; };
    إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «some»)
        || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «موجود»)) { أرجع 1; };
    إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «none»)
        || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «لا_شيء»)) { أرجع 2; };
    إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «ok»)
        || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «نجح»)) { أرجع 3; };
    إذا (اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «err»)
        || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «خطأ»)) { أرجع 4; };
    أرجع 0;
}

// A bare prelude constructor where no Type is expected (a match's
// scrutinee, an operand): `some(x)` is the option of its argument's Type,
// which it says itself; `none`, `ok(x)` and `err(e)` leave their option or
// result Type unknown (منشئ_تمهيدي_بلا_نوع). Nothing for any other
// expression.
عرف ابن_نوع_منشئ_تمهيدي_بلا_توقع_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري نتيجة_نوع_تعبير_داخلية {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        إذا (صنف_منشئ_تمهيدي_مجرد(&الاسم, سياق_الأسماء, الروابط) == 0) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.منشئ_تمهيدي_بلا_نوع(نطاق_تعبير(التعبير))
        ));
    }
    | تعبير.استدعاء(_, صندوق_المستدعى, الحجج) -> {
        طابق *صندوق_المستدعى مع
        | تعبير.اسم(_, الاسم) -> {
            ليكن الصنف: ط32 = صنف_منشئ_تمهيدي_مجرد(&الاسم, سياق_الأسماء, الروابط);
            إذا (الصنف == 0) { أرجع اختياري.لا_شيء(); };
            إذا (الصنف != 1) {
                أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.منشئ_تمهيدي_بلا_نوع(نطاق_تعبير(التعبير))
                ));
            };
            إذا ((الطول(الحجج) مثل طبيعي) != 1) {
                أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                        نطاق_تعبير(التعبير), 1, الطول(الحجج) مثل طبيعي
                    )
                ));
            };
            ليكن نوع_الحمولة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الحجج[0], سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ));
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الحمولة := النوع; };
            طابق أزل_غلاف_متغير(الأنواع, نوع_الحمولة) مع
            | اختياري.موجود(الأساس) -> { نوع_الحمولة := الأساس; }
            | اختياري.لا_شيء -> { };
            ليكن نوع_الاختيار: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.اختيار(نوع_الحمولة));
            إذا (!أضف_نوع_تعبير_بمنشئ(
                الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), نوع_الاختيار, الاسم.النطاق,
                هوية_منشئ_نوع.اختيار_بعض()
            )) {
                أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                    نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_منشئ()
                )));
            };
            أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.موجود(نوع_الاختيار));
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// `some(x)`, `ok(x)`, `err(e)` and `none` (also `none()`) written bare where
// an option or a result is expected: typed as the qualified constructor is
// (`option.some(x)`), the constructor recorded at the name for lowering.
// `none` alone is the one bare form without `()`.
عرف ابن_نوع_منشئ_تمهيدي_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري نتيجة_نوع_تعبير_داخلية {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق هوية_منشئ_تمهيدي_للنوع(&الاسم, النوع_المتوقع, سياق_الأسماء, الأنواع, الروابط) مع
        | اختياري.موجود(الهوية) -> {
            طابق الهوية مع
            | هوية_منشئ_نوع.اختيار_لا_شيء -> { }
            | _ -> { أرجع اختياري.لا_شيء(); };
            إذا (!أضف_نوع_تعبير_بمنشئ(
                الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع_المتوقع, الاسم.النطاق, الهوية
            )) {
                أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                    نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_منشئ()
                )));
            };
            أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.موجود(النوع_المتوقع));
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | تعبير.استدعاء(_, صندوق_المستدعى, الحجج) -> {
        طابق *صندوق_المستدعى مع
        | تعبير.اسم(_, الاسم) -> {
            طابق هوية_منشئ_تمهيدي_للنوع(&الاسم, النوع_المتوقع, سياق_الأسماء, الأنواع, الروابط) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الهوية) -> {
                طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, النوع_المتوقع, الهوية) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(الوصف) -> {
                    ليكن عدد_الحجج: طبيعي = الطول(الحجج) مثل طبيعي;
                    إذا (عدد_الحجج != الوصف.عدد_الحمولات) {
                        أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                                نطاق_تعبير(التعبير), الوصف.عدد_الحمولات, عدد_الحجج
                            )
                        ));
                    };
                    ليكن ف: متغير طبيعي = 0;
                    طالما (ف < الوصف.عدد_الحمولات) {
                        طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع_المتوقع, الهوية, ف) مع
                        | اختياري.موجود(نوع_الحمولة) -> {
                            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                                &الحجج[ف], نوع_الحمولة, موضع_توقع_نوع.مفهرس(ف), سياق_الأسماء,
                                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                            ) مع
                            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                                أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ));
                            }
                            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                        }
                        | اختياري.لا_شيء -> {
                            أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                                نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.نوع_حمولة_منشئ()
                            )));
                        };
                        ف := ف + 1;
                    }
                    إذا (!أضف_نوع_تعبير_بمنشئ(
                        الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير), النوع_المتوقع, الاسم.النطاق, الهوية
                    )) {
                        أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                            نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_منشئ()
                        )));
                    };
                    أرجع اختياري.موجود(نتيجة_نوع_تعبير_داخلية.موجود(النوع_المتوقع));
                };
            };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف ابن_نوع_تعبير_بتوقع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    الموضع: موضع_توقع_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    طابق ابن_نوع_عرض_قابل_للكتابة_داخلي(
        التعبير, النوع_المتوقع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    ) مع
    | اختياري.موجود(الناتج) -> { أرجع الناتج; }
    | اختياري.لا_شيء -> { };
    // A match expression gives its arms the expectation.
    طابق *التعبير مع
    | تعبير.مطابقة(_, _) -> {
        أرجع ابن_نوع_مطابقة_تعبيرية_داخلي(
            التعبير, اختياري.موجود(النوع_المتوقع), الموضع, سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    }
    | _ -> { };
    // Null never acquires a reference Type. It requires an exact raw-pointer
    // expectation and is not an integer literal or a declaration.
    إذا (هل_مؤشر_فارغ_سياقي(التعبير, الروابط)) {
        طابق معرف_نوع_أساس_عند(الأنواع, النوع_المتوقع) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.فارغ_بلا_مؤشر(),
                    اختياري.موجود(النوع_المتوقع), اختياري.لا_شيء()
                )
            );
        }
        | اختياري.موجود(مرجع_النوع_20) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_20.القيمة] مع
            | نوع_مقنن.مؤشر(_) -> {
                أرجع سجل_نوع_تعبير_داخلي(
                    الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع
                );
            }
            | _ -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.فارغ_بلا_مؤشر(),
                    اختياري.موجود(النوع_المتوقع), اختياري.لا_شيء()
                ));
            };
        };
    };
    // `&` of a literal in any position: a temporary typed against the
    // referenced Type of a reference expectation.
    إذا (هل_عنوان_حرفي_دلالي(التعبير)) {
        أرجع ابن_نوع_عنوان_مؤقت_داخلي(
            التعبير, اختياري.موجود(النوع_المتوقع), الموضع, صواب, سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    };
    // A vector literal takes its element Type from a vector context, as the
    // initializer statement does; another context types it on its own and
    // the ordinary compatibility check below reports a mismatch.
    طابق *التعبير مع
    | تعبير.حرفي_متجه(_, _) -> {
        طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع_المتوقع) مع
        | اختياري.موجود(نوع_العنصر) -> {
            أرجع ابن_نوع_حرفي_متجه_داخلي(
                التعبير, النوع_المتوقع, نوع_العنصر, 0, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        }
        | اختياري.لا_شيء -> { };
    }
    // A record literal takes its Type from a record context; any other
    // context has no Type to give it.
    | تعبير.حرفي_سجل(النطاق, الحقول) -> {
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع_المتوقع) مع
        | اختياري.موجود(_) -> {
            طابق افحص_حقول_سجل_داخلي(
                النطاق, النوع_المتوقع, &الحقول, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                النطاق, سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                اختياري.موجود(النوع_المتوقع), اختياري.لا_شيء()
            ));
        };
    }
    // A tuple literal takes its element Types from a tuple context; another
    // context types it on its own and the ordinary compatibility check
    // below reports a mismatch.
    | تعبير.حرفي_صف(النطاق, العناصر) -> {
        طابق عدد_عناصر_صف_دلالي(الأنواع, النوع_المتوقع) مع
        | اختياري.موجود(العدد) -> {
            إذا ((الطول(العناصر) مثل طبيعي) != العدد) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    النطاق, سياق_عدم_توافق_نوع.عدد_عناصر_صف(),
                    اختياري.موجود(النوع_المتوقع), اختياري.لا_شيء()
                ));
            };
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < العدد) {
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع_المتوقع, ع) مع
                | اختياري.موجود(نوع_العنصر) -> {
                    طابق ابن_نوع_تعبير_بتوقع_داخلي(
                        &العناصر[ع], نوع_العنصر, الموضع, سياق_الأسماء,
                        الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    ) مع
                    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                        نطاق_تعبير(&العناصر[ع]), ثابت_أنواع_مكسور.نوع_عنصر_صف()
                    ));
                };
                ع := ع + 1;
            }
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    // A bare prelude constructor (`some(x)`, `none`, `ok(x)`, `err(e)`).
    طابق ابن_نوع_منشئ_تمهيدي_داخلي(
        التعبير, النوع_المتوقع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    ) مع
    | اختياري.موجود(الناتج) -> { أرجع الناتج; }
    | اختياري.لا_شيء -> { };
    // Option/Result constructors are context-typed. Name records their source identities
    // without inventing Symbols; Type resolves them against the expected tagged Type.
    ليكن قيمة_متوقعة: تعبير = *التعبير;
    طابق قيمة_متوقعة مع
    | تعبير.استدعاء(_, المستدعى_المملوك, الحجج_المضمنة) -> {
        ليكن المستدعى_المضمن: تعبير = *المستدعى_المملوك;
        طابق المستدعى_المضمن مع
        | تعبير.حقل(_, الأصل_المملوك, اسم_المنشئ) -> {
            ليكن الأصل_المضمن: تعبير = *الأصل_المملوك;
            طابق الأصل_المضمن مع
            | تعبير.اسم(_, اسم_النوع) -> {
                طابق معرف_اسم_محلول_عند(الروابط, اسم_النوع.النطاق) مع
                | اختياري.موجود(هوية_اسم_النوع) -> {
                    طابق معرف_اسم_محلول_عند(الروابط, اسم_المنشئ.النطاق) مع
                    | اختياري.موجود(هوية_اسم_المنشئ) -> {
                        طابق هوية_منشئ_مسمى_للنوع(
                            &اسم_النوع, &اسم_المنشئ, النوع_المتوقع,
                            سياق_الأسماء, الأنواع, الروابط
                        ) مع
                        | اختياري.موجود(هوية_المنشئ) -> {
                            طابق وصف_منشئ_نوع_دلالي_بالهوية(
                                الأنواع, النوع_المتوقع, هوية_المنشئ
                            ) مع
                            | اختياري.موجود(الوصف) -> {
                                ليكن عدد_الحجج: طبيعي = الطول(الحجج_المضمنة) مثل طبيعي;
                                إذا (عدد_الحجج != الوصف.عدد_الحمولات) {
                                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                        خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                                            نطاق_تعبير(التعبير), الوصف.عدد_الحمولات, عدد_الحجج
                                        )
                                    );
                                };
                                ليكن ف_حمولة: متغير طبيعي = 0;
                                طالما (ف_حمولة < الوصف.عدد_الحمولات) {
                                    طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(
                                        الأنواع, النوع_المتوقع, هوية_المنشئ, ف_حمولة
                                    ) مع
                                    | اختياري.موجود(نوع_الحمولة) -> {
                                        طابق ابن_نوع_تعبير_بتوقع_داخلي(
                                            &الحجج_المضمنة[ف_حمولة], نوع_الحمولة,
                                            موضع_توقع_نوع.مفهرس(ف_حمولة), سياق_الأسماء,
                                            الأنواع, أنواع_التعبيرات,
                                            الروابط, أنواع_الرموز
                                        ) مع
                                        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                                            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
                                        }
                                        | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                                    }
                                    | اختياري.لا_شيء -> {
                                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                                                نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.نوع_حمولة_منشئ()
                                            )
                                        );
                                    };
                                    ف_حمولة := ف_حمولة + 1;
                                }
                                إذا (!أضف_نوع_تعبير_بمنشئ(
                                    الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير),
                                    النوع_المتوقع, اسم_المنشئ.النطاق, هوية_المنشئ
                                )) {
                                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                        خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                                            نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_منشئ()
                                        )
                                    );
                                };
                                أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع_المتوقع);
                            }
                            | اختياري.لا_شيء -> { };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        }
        | _ -> { };
    }
    | _ -> { };

    // Ordinary generic calls may infer type parameters from the expected result Type.
    // Primitive calls retain their identity-owned semantic path below.
    ليكن قيمة_استدعاء_متوقعة: تعبير = *التعبير;
    طابق قيمة_استدعاء_متوقعة مع
    | تعبير.استدعاء(_, المستدعى_المملوك_المتوقع, الحجج_المتوقعة) -> {
        ليكن المستدعى_المتوقع: تعبير = *المستدعى_المملوك_المتوقع;
        ليكن استدعاء_عام: متغير منطقي = خطأ;
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&المستدعى_المتوقع)) مع
        | اختياري.موجود(رمز_المستدعى) -> {
            طابق هوية_بدائي_رمز_عند(سياق_الأسماء, رمز_المستدعى) مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> {
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, رمز_المستدعى) مع
                | اختياري.موجود(نوع_المستدعى) -> {
                    استدعاء_عام := هل_نوع_يحوي_معامل_نوع(الأنواع, نوع_المستدعى);
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        إذا (استدعاء_عام) {
            طابق ابن_نوع_استدعاء_عادي_بتوقع_داخلي(
                التعبير, &المستدعى_المتوقع, &الحجج_المتوقعة, النوع_المتوقع,
                سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الناتج) -> {
                // The inferred result meets the destination as any other
                // value does (below): `let n: int = remove_at(...)` whose
                // result is `option int` is a mismatch at the initializer.
                ليكن عرض_شريحة_عام: متغير منطقي = هل_عرض_متجه_كشريحة(الأنواع, نوع_الناتج, النوع_المتوقع);
                طابق الموضع مع
                | موضع_توقع_نوع.إرجاع -> { عرض_شريحة_عام := خطأ; }
                | _ -> { };
                إذا (!هل_نوع_يحوي_معامل_نوع(الأنواع, نوع_الناتج)
                    && !هل_تحويل_ضمني_آمن(الأنواع, نوع_الناتج, النوع_المتوقع) && !عرض_شريحة_عام) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_عدم_توافق_نوع_متوقع(
                            الموضع, نطاق_تعبير(التعبير), النوع_المتوقع, نوع_الناتج
                        )
                    );
                };
                أرجع نتيجة_نوع_تعبير_داخلية.موجود(نوع_الناتج);
            };
        };
    }
    | _ -> { };

    إذا (هل_نوع_عشري_دلالي(الأنواع, النوع_المتوقع) && هل_تعبير_عشري_سياقي(التعبير)) {
        ليكن قيمة_عشرية: تعبير = *التعبير;
        طابق قيمة_عشرية مع
        | تعبير.حرفي(_, حرفي.عدد_عشري(_)) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | تعبير.أحادي(_, عامل_أحادي.سالب, الداخل_المملوك) -> {
            ليكن الداخل: تعبير = *الداخل_المملوك;
            طابق ابن_نوع_تعبير_بتوقع_داخلي(&الداخل, النوع_المتوقع, الموضع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع);
        }
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            إذا (!هل_عامل_ثنائي_ينتج_عشريا(العامل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.قيمة_لا_تطابق_الوجهة(),
                    اختياري.موجود(النوع_المتوقع), اختياري.لا_شيء()
                ));
            };
            // Every binary node under a float-literal expression gives a float:
            // the chain is typed with a loop (ابن_نوع_سلسلة_بتوقع_داخلي).
            أرجع ابن_نوع_سلسلة_بتوقع_داخلي(
                التعبير, النوع_المتوقع, الموضع, صواب, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        }
        | _ -> { };
    };

    إذا (هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع_المتوقع)) {
        ليكن قيمة_التعبير: تعبير = *التعبير;
        طابق قيمة_التعبير مع
        | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
            إذا (هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل)) {
                // The left operand has the expected Type: a right operand of
                // another Type is an operand mismatch (`return a + b` with a
                // bool `b` names the operands, not the return Type). A chain
                // of such operators is typed with a loop.
                أرجع ابن_نوع_سلسلة_بتوقع_داخلي(
                    التعبير, النوع_المتوقع, الموضع, خطأ, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                );
            };
        }
        | _ -> { };
    };

    طابق قيمة_عدد_صحيح_سياقية_لتعبير(التعبير) مع
    | اختياري.موجود(القيمة) -> {
        ليكن يلائم: متغير منطقي = خطأ;
        طابق القيمة مع
        | قيمة_عدد_صحيح_سياقية.موقع(العدد) -> {
            يلائم := هل_عدد_صحيح_يلائم(الأنواع, العدد, النوع_المتوقع);
        }
        | قيمة_عدد_صحيح_سياقية.طبيعي(العدد) -> {
            يلائم := هل_عدد_صحيح_طبيعي_يلائم(الأنواع, العدد, النوع_المتوقع);
        };
        إذا (!يلائم) {
            ليكن نوع_العدد: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.عدد());
            // An integer destination: the literal's value, not its kind, is
            // wrong. A call argument keeps its argument-position diagnostic.
            إذا (هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع_المتوقع) && !هل_موضع_حجة(الموضع)) {
                أرجع خطأ_أنواع_غير_متوافقة(
                    نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.عدد_حرفي_خارج_المدى(),
                    النوع_المتوقع, نوع_العدد
                );
            };
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_عدم_توافق_نوع_متوقع(
                    الموضع, نطاق_تعبير(التعبير), النوع_المتوقع, نوع_العدد
                )
            );
        };
        إذا (!سجل_نوع_عدد_صحيح_سياقي(الأنواع, أنواع_التعبيرات, التعبير, النوع_المتوقع)) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير())
            );
        };
        أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع_المتوقع);
    }
    | اختياري.لا_شيء -> { };

    طابق ابن_نوع_تعبير_داخلي(
        التعبير, سياق_الأسماء, الأنواع,
        أنواع_التعبيرات, الروابط, أنواع_الرموز
    ) مع
    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
    }
    | نتيجة_نوع_تعبير_داخلية.موجود(النوع_الموجود) -> {
        // A vector is viewed as an expected slice, except as a returned
        // value: a function's local vector does not outlive its return.
        ليكن عرض_شريحة: متغير منطقي = هل_عرض_متجه_كشريحة(الأنواع, النوع_الموجود, النوع_المتوقع);
        طابق الموضع مع
        | موضع_توقع_نوع.إرجاع -> { عرض_شريحة := خطأ; }
        | _ -> { };
        إذا (!هل_تحويل_ضمني_آمن(الأنواع, النوع_الموجود, النوع_المتوقع) && !عرض_شريحة) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_عدم_توافق_نوع_متوقع(
                    الموضع, نطاق_تعبير(التعبير), النوع_المتوقع, النوع_الموجود
                )
            );
        };
        أرجع نتيجة_نوع_تعبير_داخلية.موجود(النوع_الموجود);
    };
}

عرف ابن_نوع_تعبير_متوقع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    فهرس_المصدر: طبيعي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    أرجع ابن_نوع_تعبير_بتوقع_داخلي(
        التعبير, النوع_المتوقع, موضع_توقع_نوع.تهيئة(),
        سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    );
}

عرف ابن_نوع_تعبير_إرجاع_داخلي(
    التعبير: &تعبير,
    النوع_المتوقع: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    أرجع ابن_نوع_تعبير_بتوقع_داخلي(
        التعبير, النوع_المتوقع, موضع_توقع_نوع.إرجاع(),
        سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    );
}

عرف هل_رمز_ضمن_قائمة_إغلاق(
    الرموز: &متجه معرف_رمز,
    الرمز: معرف_رمز
): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*الرموز)[ف], الرمز)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف أضف_التقاط_إغلاق(
    الالتقاطات: &متغير متجه معرف_رمز,
    الرمز: معرف_رمز
): فراغ {
    إذا (!هل_رمز_ضمن_قائمة_إغلاق(الالتقاطات, الرمز)) { ألحق(*الالتقاطات, الرمز); };
}

عرف اجمع_التقاطات_إغلاق(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    المستثناة: &متجه معرف_رمز,
    الالتقاطات: &متغير متجه معرف_رمز
): فراغ {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, _) -> { }
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            إذا (!هل_رمز_ضمن_قائمة_إغلاق(المستثناة, الرمز)) {
                طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
                | اختياري.موجود(نوع_تصريح.معامل) -> { أضف_التقاط_إغلاق(الالتقاطات, الرمز); }
                | اختياري.موجود(نوع_تصريح.ربط_محلي) -> { أضف_التقاط_إغلاق(الالتقاطات, الرمز); }
                | _ -> { };
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | تعبير.حقل(_, الأصل, _) -> {
        ليكن أ: تعبير = *الأصل;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        ليكن أ: تعبير = *الأصل; ليكن ب: تعبير = *الفهرس;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        اجمع_التقاطات_إغلاق(&ب, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.مقطع(_, الأصل, الأدنى, الأعلى) -> {
        ليكن أ: تعبير = *الأصل;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        ليكن الحدود: متجه تعبير = حدود_مقطع(&الأدنى, &الأعلى);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحدود) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&الحدود[ف], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.فك_موضع(_, الأصل) -> {
        ليكن أ: تعبير = *الأصل;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.ثنائي(_, _, اليسار, اليمين) -> {
        ليكن أ: تعبير = *اليسار; ليكن ب: تعبير = *اليمين;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        اجمع_التقاطات_إغلاق(&ب, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.أحادي(_, _, الأصل) -> {
        ليكن أ: تعبير = *الأصل;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.استدعاء(_, الدالة, الحجج) -> {
        ليكن د: تعبير = *الدالة;
        اجمع_التقاطات_إغلاق(&د, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&الحجج[ف], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.تحويل(_, الأصل, _) -> {
        ليكن أ: تعبير = *الأصل;
        اجمع_التقاطات_إغلاق(&أ, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.وقت_الترجمة(_, المملوك) -> {
        ليكن الداخل: تعبير = *المملوك;
        اجمع_التقاطات_إغلاق(&الداخل, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.تسلسل_وقت_الترجمة(_, التعابير) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&التعابير[ف], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_متجه(_, التعابير) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&التعابير[ف], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_صف(_, التعابير) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&التعابير[ف], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            اجمع_التقاطات_إغلاق(&الحقول[ف].القيمة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ف := ف + 1;
        }
    }
    | تعبير.حجج_نوع(_, الداخل, _) -> {
        ليكن د: تعبير = *الداخل;
        اجمع_التقاطات_إغلاق(&د, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
    }
    | تعبير.إغلاق(_, المعاملات, _, الجسم) -> {
        ليكن مستثناة_متداخلة: متغير متجه معرف_رمز = انسخ_مملوكا_متجه_معرف_رمز(المستثناة);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
            طابق رمز_اسم_محلول_عند(الروابط, المعاملات[ف].الاسم.النطاق) مع
            | اختياري.موجود(الرمز) -> { ألحق(مستثناة_متداخلة, الرمز); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        ليكن ج: تعبير = *الجسم;
        اجمع_التقاطات_إغلاق(&ج, سياق_الأسماء, الروابط, &مستثناة_متداخلة, الالتقاطات);
    }
    // The locals a match expression uses, but those it declares itself (its
    // patterns' names and the locals of its arms).
    | تعبير.مطابقة(النطاق, المطابقة) -> {
        ليكن الداخلية: متغير متجه معرف_رمز = [];
        ليكن العبارة: عبارة = عبارة_مطابقة_تعبيرية(النطاق, &(*المطابقة));
        ليكن صندوق_العبارة: صندوق عبارة = صندوق العبارة;
        ليكن العبارات: متجه صندوق عبارة = [صندوق_العبارة];
        ليكن الكتلة: كتلة_عبارات = { النطاق: النطاق, العبارات: العبارات };
        اجمع_التقاطات_كتلة_إغلاق(&الكتلة, سياق_الأسماء, الروابط, المستثناة, &متغير الداخلية);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الداخلية) مثل طبيعي)) {
            ليكن داخلي: متغير منطقي = خطأ;
            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, الداخلية[ف]) مع
            | اختياري.موجود(نطاق_التصريح) -> { داخلي := نطاق_يحتوي_نطاقا(النطاق, نطاق_التصريح); }
            | اختياري.لا_شيء -> { };
            إذا (!داخلي) { أضف_التقاط_إغلاق(الالتقاطات, الداخلية[ف]); };
            ف := ف + 1;
        }
    };
}

// The captures of the statements of a block in a closure body (an arm of a
// match expression there): its statements' expressions and blocks.
عرف اجمع_التقاطات_كتلة_إغلاق(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء,
    المستثناة: &متجه معرف_رمز,
    الالتقاطات: &متغير متجه معرف_رمز
): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكتلة).العبارات) مثل طبيعي)) {
        ليكن العبارة: عبارة = *(*الكتلة).العبارات[ف];
        طابق العبارة مع
        | عبارة.تهيئة_سجل(_, الوجهة, الحقول) -> {
            اجمع_التقاطات_إغلاق(&الوجهة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ليكن ح: متغير طبيعي = 0;
            طالما (ح < (الطول(الحقول) مثل طبيعي)) {
                اجمع_التقاطات_إغلاق(&الحقول[ح].القيمة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
                ح := ح + 1;
            }
        }
        | عبارة.تهيئة_صف(_, الوجهة, العناصر) -> {
            اجمع_التقاطات_إغلاق(&الوجهة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(العناصر) مثل طبيعي)) {
                اجمع_التقاطات_إغلاق(&العناصر[ع], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
                ع := ع + 1;
            }
        }
        | عبارة.تهيئة_متجه(_, الوجهة, العناصر) -> {
            اجمع_التقاطات_إغلاق(&الوجهة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(العناصر) مثل طبيعي)) {
                اجمع_التقاطات_إغلاق(&العناصر[ع], سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
                ع := ع + 1;
            }
        }
        | عبارة.تهيئة_نص(_, الوجهة, _) -> {
            اجمع_التقاطات_إغلاق(&الوجهة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        }
        | عبارة.تهيئة_صندوق(_, الوجهة, الحمولة) -> {
            اجمع_التقاطات_إغلاق(&الوجهة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            اجمع_التقاطات_إغلاق(&الحمولة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        }
        | عبارة.نسخ(_, الوجهة, المصدر) -> {
            اجمع_التقاطات_إغلاق(&الوجهة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            اجمع_التقاطات_إغلاق(&المصدر, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        }
        | عبارة.استدعاء(_, التعبير) -> {
            اجمع_التقاطات_إغلاق(&التعبير, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        }
        | عبارة.طالما(_, الشرط, الجسم) -> {
            اجمع_التقاطات_إغلاق(&الشرط, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            اجمع_التقاطات_كتلة_إغلاق(&الجسم, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        }
        | عبارة.لكل(النطاق, البداية, الشرط, الخطوة, الجسم) -> {
            ليكن كتلة_البداية: كتلة_عبارات = { النطاق: النطاق, العبارات: انسخ_مملوكا_متجه_صندوق_عبارة(&البداية) };
            اجمع_التقاطات_كتلة_إغلاق(&كتلة_البداية, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            اجمع_التقاطات_إغلاق(&الشرط, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ليكن نسخة_الخطوة: صندوق عبارة = انسخ_مملوكا_صندوق_عبارة(&الخطوة);
            ليكن قائمة_الخطوة: متجه صندوق عبارة = [نسخة_الخطوة];
            ليكن كتلة_الخطوة: كتلة_عبارات = { النطاق: النطاق, العبارات: قائمة_الخطوة };
            اجمع_التقاطات_كتلة_إغلاق(&كتلة_الخطوة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            اجمع_التقاطات_كتلة_إغلاق(&الجسم, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        }
        | عبارة.إذا(_, الشرط, الأولى, الثانية) -> {
            اجمع_التقاطات_إغلاق(&الشرط, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            اجمع_التقاطات_كتلة_إغلاق(&الأولى, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            طابق الثانية مع
            | اختياري.موجود(البديلة) -> {
                اجمع_التقاطات_كتلة_إغلاق(&البديلة, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.طابق(_, المميز, الأذرع) -> {
            اجمع_التقاطات_إغلاق(&المميز, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            ليكن ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
                طابق الأذرع[ذ].الحارس مع
                | اختياري.موجود(الحارس) -> {
                    اجمع_التقاطات_إغلاق(&الحارس, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
                }
                | اختياري.لا_شيء -> { };
                اجمع_التقاطات_كتلة_إغلاق(&الأذرع[ذ].الجسم, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
                ذ := ذ + 1;
            }
        }
        | عبارة.أرجع(_, القيمة) -> {
            طابق القيمة مع
            | اختياري.موجود(التعبير) -> {
                اجمع_التقاطات_إغلاق(&التعبير, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.غير_آمن(_, الجسم) -> {
            اجمع_التقاطات_كتلة_إغلاق(&الجسم, سياق_الأسماء, الروابط, المستثناة, الالتقاطات);
        }
        | _ -> { };
        ف := ف + 1;
    }
}

عرف ابن_نوع_تعبير_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(_, الحرفي) -> {
        ليكن النوع: معرف_نوع = نوع_حرفي_داخلي(الأنواع, &الحرفي);
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | تعبير.اسم(_, الاسم) -> {
        طابق ابن_نوع_منشئ_تمهيدي_بلا_توقع_داخلي(
            التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        ) مع
        | اختياري.موجود(الناتج) -> { أرجع الناتج; }
        | اختياري.لا_شيء -> { };
        طابق رمز_اسم_مطلوب_للنوع(الروابط, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة.نجح(الرمز) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
            | اختياري.موجود(النوع) -> {
                ليكن نوع_الاستعمال: معرف_نوع = نوع_رمز_لتعبير_داخلي(الأنواع, أنواع_الرموز, الرمز, النوع);
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الاستعمال);
            }
            | اختياري.لا_شيء -> {
                طابق هوية_بدائي_رمز_عند(سياق_الأسماء, الرمز) مع
                | اختياري.موجود(_) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.بدائي_غير_مستدعى(الاسم.النطاق));
                }
                | اختياري.لا_شيء -> { };
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(الرمز, الاسم.النطاق));
            };
        };
    }
    | تعبير.حقل(_, _, _) -> {
        أرجع ابن_نوع_تعبير_حقل_داخلي(التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    | تعبير.فهرس(_, _, _) -> {
        أرجع ابن_نوع_تعبير_فهرس_داخلي(التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    | تعبير.مقطع(_, _, _, _) -> {
        أرجع ابن_نوع_تعبير_مقطع_داخلي(التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    | تعبير.فك_موضع(_, الداخل_المملوك) -> {
        ليكن الداخل: تعبير = *الداخل_المملوك;
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الداخل) -> {
            طابق خطأ_فك_معتم(الأنواع, نوع_الداخل, نطاق_تعبير(التعبير)) مع
            | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
            | اختياري.لا_شيء -> { };
            طابق نوع_فك_داخلي(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(النوع) -> {
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.فك_غير_مؤشر(نطاق_تعبير(التعبير), نوع_الداخل)
                );
            };
        };
    }
    | تعبير.ثنائي(_, _, _, _) -> {
        أرجع ابن_نوع_تعبير_ثنائي_داخلي(التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    | تعبير.أحادي(_, _, _) -> {
        أرجع ابن_نوع_تعبير_أحادي_داخلي(التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    | تعبير.استدعاء(_, _, _) -> {
        أرجع ابن_نوع_تعبير_استدعاء_داخلي(التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    | تعبير.وقت_الترجمة(_, المملوك) -> {
        ليكن الداخل: تعبير = *المملوك;
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        };
    }
    // Explicit type arguments are read where the call is typed; the callee
    // itself (same span) is typed as written.
    | تعبير.حجج_نوع(_, الداخل_المملوك, _) -> {
        ليكن الداخل: تعبير = *الداخل_المملوك;
        أرجع ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    // Without a context Type each element gives its own Type: `(1, true)`
    // is an `(int, bool)`.
    | تعبير.حرفي_صف(_, العناصر) -> {
        ليكن أنواع_العناصر: متغير متجه معرف_نوع = [];
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول(العناصر) مثل طبيعي)) {
            طابق ابن_نوع_تعبير_داخلي(&العناصر[ع], سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                ليكن نوع_العنصر: متغير معرف_نوع = النوع;
                طابق أزل_غلاف_متغير(الأنواع, النوع) مع
                | اختياري.موجود(الأساس) -> { نوع_العنصر := الأساس; }
                | اختياري.لا_شيء -> { };
                ألحق(أنواع_العناصر, نوع_العنصر);
            };
            ع := ع + 1;
        }
        ليكن نوع_الصف: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.صف(أنواع_العناصر));
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الصف);
    }
    // A record literal has no Type of its own: it needs a record context.
    | تعبير.حرفي_سجل(النطاق, _) -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
            النطاق, سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
            اختياري.لا_شيء(), اختياري.لا_شيء()
        ));
    }
    // Without a context Type the first element gives the element Type
    // (`[1, 2]` is a vector of int); `[]` needs a context.
    | تعبير.حرفي_متجه(النطاق, العناصر) -> {
        إذا ((الطول(العناصر) مثل طبيعي) == 0) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                النطاق, سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                اختياري.لا_شيء(), اختياري.لا_شيء()
            ));
        };
        ليكن نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&العناصر[0], سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_العنصر := النوع; };
        ليكن نوع_المتجه: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.متجه(نوع_العنصر));
        أرجع ابن_نوع_حرفي_متجه_داخلي(
            التعبير, نوع_المتجه, نوع_العنصر, 1, سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    }
    | تعبير.تسلسل_وقت_الترجمة(_, التعابير) -> {
        ليكن الناتج: متغير اختياري معرف_نوع = اختياري.لا_شيء();
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            طابق ابن_نوع_تعبير_داخلي(&التعابير[ف], سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { الناتج := اختياري.موجود(النوع); };
            ف := ف + 1;
        }
        طابق الناتج مع
        | اختياري.موجود(النوع) -> { أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع); }
        | اختياري.لا_شيء -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(نطاق_تعبير(التعبير), معرف_نوع_من(0))); };
    }
    | تعبير.إغلاق(_, _, _, _) -> {
        أرجع ابن_نوع_تعبير_إغلاق_داخلي(التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    | تعبير.تحويل(_, _, _) -> {
        أرجع ابن_نوع_تعبير_تحويل_داخلي(التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز);
    }
    | تعبير.مطابقة(_, _) -> {
        أرجع ابن_نوع_مطابقة_تعبيرية_داخلي(
            التعبير, اختياري.لا_شيء(), موضع_توقع_نوع.ذراع_مطابقة(), سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    };
}

// The `حقل` arm of ابن_نوع_تعبير_داخلي, in a function of its own so
// that its locals occupy the stack only while it runs: every nested
// expression recurses through ابن_نوع_تعبير_داخلي, whose frame held the
// locals of all its arms at once (13-22 KB a level).
عرف ابن_نوع_تعبير_حقل_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حقل(_, الأساس_المملوك, الاسم) -> {
        // Name decides whether this field-shaped occurrence is a constructor. Type consumes
        // that Symbol before typing the syntactic qualifier, so no spelling-based type lookup occurs.
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(رمز_العضو) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, رمز_العضو) مع
            | اختياري.موجود(نوع_العضو) -> {
                طابق نوع_رمز_عند(سياق_الأسماء, رمز_العضو) مع
                | اختياري.موجود(نوع_تصريح.منشئ_تعداد) -> {
                    ليكن الهوية: هوية_منشئ_نوع = هوية_منشئ_نوع.تعداد(رمز_العضو);
                    إذا (!أضف_نوع_تعبير_بمنشئ(
                        الأنواع, أنواع_التعبيرات, نطاق_تعبير(التعبير),
                        نوع_العضو, الاسم.النطاق, الهوية
                    )) {
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_منشئ())
                        );
                    };
                    أرجع نتيجة_نوع_تعبير_داخلية.موجود(نوع_العضو);
                }
                | _ -> {
                    ليكن نوع_الاستعمال: معرف_نوع = نوع_رمز_لتعبير_داخلي(الأنواع, أنواع_الرموز, رمز_العضو, نوع_العضو);
                    أرجع سجل_نوع_تعبير_داخلي(
                        الأنواع, أنواع_التعبيرات, التعبير, نوع_الاستعمال
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        ليكن الأساس: تعبير = *الأساس_المملوك;
        ليكن نوع_الأساس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الأساس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            نوع_الأساس := النوع;
        };
        طابق هوية_اسم_مطلوبة_للنوع(الروابط, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة.نجح(هوية_الحقل) -> {
            // `r.f` through a reference reads `(*r).f`:
            // each reference level (`&&T` twice) is dereferenced, and the
            // frontend writes the dereferences out before the later phases
            // (frontend/desugar/implicit_places.sn), so ownership and
            // lowering see `(*r).f`.
            ليكن مستويات_الفك: متغير طبيعي = 0;
            ليكن يتابع_الفك: متغير منطقي = صواب;
            طالما (يتابع_الفك && مستويات_الفك < 16) {
                طابق داخل_مرجع_لحقل(الأنواع, نوع_الأساس) مع
                | اختياري.موجود(الداخل) -> {
                    نوع_الأساس := الداخل;
                    مستويات_الفك := مستويات_الفك + 1;
                }
                | اختياري.لا_شيء -> { يتابع_الفك := خطأ; };
            }
            إذا (مستويات_الفك > 0) {
                طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, نوع_الأساس, هوية_الحقل) مع
                | اختياري.موجود(_) -> {
                    أضف_موضع_ضمني(أنواع_التعبيرات, نطاق_تعبير(&الأساس), 0, مستويات_الفك);
                }
                | اختياري.لا_شيء -> { };
            };
            // An opaque type has no fields, behind a pointer or not.
            ليكن معتم_الأساس: متغير اختياري معرف_نوع = معتم_خلف_مؤشر(الأنواع, نوع_الأساس);
            إذا (هل_نوع_معتم(الأنواع, نوع_الأساس)) { معتم_الأساس := معرف_نوع_أساس_عند(الأنواع, نوع_الأساس); };
            طابق معتم_الأساس مع
            | اختياري.موجود(المعتم) -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
                    الاسم.النطاق, صنف_استعمال_معتم.حقل(), المعتم
                ));
            }
            | اختياري.لا_شيء -> { };
            طابق نوع_حقل_سجل_دلالي_بالاسم(الأنواع, نوع_الأساس, هوية_الحقل) مع
            | اختياري.موجود(نوع_الحقل) -> {
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الحقل);
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.حقل_سجل_غير_معروف(الاسم.النطاق)
                );
            };
        };
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// The `فهرس` arm of ابن_نوع_تعبير_داخلي, in a function of its own so
// that its locals occupy the stack only while it runs: every nested
// expression recurses through ابن_نوع_تعبير_داخلي, whose frame held the
// locals of all its arms at once (13-22 KB a level).
عرف ابن_نوع_تعبير_فهرس_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.فهرس(_, الأساس_المملوك, الفهرس_المملوك) -> {
        ليكن الأساس: تعبير = *الأساس_المملوك;
        ليكن الفهرس: تعبير = *الفهرس_المملوك;
        ليكن نوع_الأساس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الأساس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
            نوع_الأساس := النوع;
        };
        // `p[i]` steps by the element size, which an opaque type lacks.
        طابق معتم_خلف_مؤشر(الأنواع, نوع_الأساس) مع
        | اختياري.موجود(المعتم) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.استعمال_نوع_معتم(
                نطاق_تعبير(التعبير), صنف_استعمال_معتم.فهرسة(), المعتم
            ));
        }
        | اختياري.لا_شيء -> { };
        ليكن نوع_الفهرس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&الفهرس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الفهرس := النوع; };
        إذا (!هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_الفهرس)) {
            أرجع خطأ_نوع_موجود_غير_مناسب(
                نطاق_تعبير(&الفهرس), سياق_عدم_توافق_نوع.فهرس_ليس_عددا_صحيحا(), نوع_الفهرس
            );
        };

        طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الأساس) مع
        | اختياري.موجود(عدد_العناصر) -> {
            طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الفهرس) مع
            | اختياري.لا_شيء -> {
                أرجع خطأ_نوع_موجود_غير_مناسب(
                    نطاق_تعبير(&الفهرس), سياق_عدم_توافق_نوع.فهرس_صف_غير_ثابت(), نوع_الأساس
                );
            }
            | اختياري.موجود(القيمة_السياقية) -> {
                ليكن فهرس_العنصر: متغير طبيعي = 0;
                طابق القيمة_السياقية مع
                | قيمة_عدد_صحيح_سياقية.موقع(الموضع) -> {
                    إذا (الموضع < 0) {
                        أرجع خطأ_نوع_موجود_غير_مناسب(
                            نطاق_تعبير(&الفهرس), سياق_عدم_توافق_نوع.فهرس_صف_غير_ثابت(), نوع_الأساس
                        );
                    };
                    فهرس_العنصر := الموضع مثل طبيعي;
                }
                | قيمة_عدد_صحيح_سياقية.طبيعي(الموضع) -> {
                    فهرس_العنصر := الموضع;
                };
                إذا (فهرس_العنصر >= عدد_العناصر) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.فهرس_صف_خارج_الحدود(
                            نطاق_تعبير(&الفهرس), فهرس_العنصر, عدد_العناصر
                        )
                    );
                };
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الأساس, فهرس_العنصر) مع
                | اختياري.موجود(نوع_العنصر) -> {
                    أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_العنصر);
                }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.نوع_عنصر_صف())
                    );
                };
            };
        }
        | اختياري.لا_شيء -> { };

        // A constant index into a local of known length is checked here.
        طابق طول_معروف_لتعبير(&الأساس, الروابط, أنواع_الرموز) مع
        | اختياري.موجود(الطول_المعروف) -> {
            طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الفهرس) مع
            | اختياري.موجود(القيمة_الثابتة) -> {
                ليكن خارج: متغير منطقي = خطأ;
                ليكن الموضع_الثابت: متغير طبيعي = 0;
                طابق القيمة_الثابتة مع
                | قيمة_عدد_صحيح_سياقية.طبيعي(الموضع) -> {
                    الموضع_الثابت := الموضع;
                    خارج := الموضع >= الطول_المعروف;
                }
                | قيمة_عدد_صحيح_سياقية.موقع(الموضع) -> {
                    إذا (الموضع >= 0) {
                        الموضع_الثابت := الموضع مثل طبيعي;
                        خارج := الموضع_الثابت >= الطول_المعروف;
                    };
                };
                إذا (خارج) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.فهرس_خارج_طول_معروف(
                            نطاق_تعبير(&الفهرس), الموضع_الثابت, الطول_المعروف
                        )
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };

        طابق نوع_عنصر_فهرسة_داخلي(الأنواع, نوع_الأساس) مع
        | اختياري.موجود(نوع_العنصر) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_العنصر);
        }
        | اختياري.لا_شيء -> {
            أرجع خطأ_نوع_موجود_غير_مناسب(
                نطاق_تعبير(&الأساس), سياق_عدم_توافق_نوع.نوع_غير_قابل_للفهرسة(), نوع_الأساس
            );
        };
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// `v[a..b]`, `v[a..]`, `v[..b]`, `v[..]`: a `[] T` that views the elements a
// through b of the vector or slice v, both ends included (an open end is the
// first or the last element), without a copy. v must be a place (the view
// borrows it; a temporary would be gone before the view). The bounds are
// integers; `v[a..a - 1]` is the empty slice. A constant upper bound past a
// local of known length is reported here, as for an index; the other bounds
// are checked when the program runs.
عرف ابن_نوع_تعبير_مقطع_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    طابق *التعبير مع
    | تعبير.مقطع(_, صندوق_الأساس, _, _) -> {
        ليكن نوع_الأساس: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(&(*صندوق_الأساس), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الأساس := النوع; };
        // A slice of text is only borrowed, `&s[a..b]` (ابن_نوع_مقطع_نص_داخلي).
        طابق مستويات_مقطع_نص_داخلي(الأنواع, نوع_الأساس) مع
        | اختياري.موجود(_) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.مقطع_نص_غير_صالح(نطاق_تعبير(التعبير)));
        }
        | اختياري.لا_شيء -> { };
        أرجع أكمل_نوع_تعبير_مقطع_داخلي(
            التعبير, نوع_الأساس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        );
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// The rest of `v[a..b]` once v is typed (its Type نوع_الأساس).
عرف أكمل_نوع_تعبير_مقطع_داخلي(
    التعبير: &تعبير,
    نوع_الأساس: معرف_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    طابق *التعبير مع
    | تعبير.مقطع(_, صندوق_الأساس, الأدنى, الأعلى) -> {
        ليكن الأساس: &تعبير = &(*صندوق_الأساس);
        ليكن نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_عنصر_مقطع_داخلي(الأنواع, نوع_الأساس) مع
        | اختياري.موجود(العنصر) -> { نوع_العنصر := العنصر; }
        | اختياري.لا_شيء -> {
            أرجع خطأ_نوع_موجود_غير_مناسب(
                نطاق_تعبير(الأساس), سياق_عدم_توافق_نوع.نوع_غير_قابل_للفهرسة(), نوع_الأساس
            );
        };
        إذا (!هل_تعبير_موضع_دلالي(الأساس)) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(الأساس)));
        };
        طابق الأدنى مع
        | اختياري.موجود(الحد) -> {
            طابق خطأ_حد_مقطع_داخلي(&(*الحد), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        طابق الأعلى مع
        | اختياري.موجود(الحد) -> {
            طابق خطأ_حد_مقطع_داخلي(&(*الحد), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            // A constant upper bound past a local of known length, as for `v[i]`.
            طابق خطأ_حد_أعلى_ثابت_داخلي(الأساس, &(*الحد), الروابط, أنواع_الرموز) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        ليكن نوع_الشريحة: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.شريحة(نوع_العنصر));
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الشريحة);
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// The number of references a slice's base is read through when it is text:
// 0 for a text place (`s[a..b]`), 1 for a `&string` or `&mutable string`
// (`r[a..b]` reads `(*r)[a..b]`), and so on. None for any other base.
عرف مستويات_مقطع_نص_داخلي(الأنواع: &سجل_أنواع, نوع_الأساس: معرف_نوع): اختياري طبيعي {
    ليكن النوع: متغير معرف_نوع = نوع_الأساس;
    ليكن المستويات: متغير طبيعي = 0;
    طالما (المستويات < 16) {
        إذا (هل_نوع_بدائي_دلالي(الأنواع, النوع, نوع_بدائي_مقنن.نص())) { أرجع اختياري.موجود(المستويات); };
        طابق داخل_مرجع_لحقل(الأنواع, النوع) مع
        | اختياري.موجود(الداخل) -> {
            النوع := الداخل;
            المستويات := المستويات + 1;
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    أرجع اختياري.لا_شيء();
}

// `&s[a..b]` (التعبير) of a text place s (الداخل is `s[a..b]`, s of Type
// نوع_الأساس, reached through المستويات references): a `&string` viewing
// the bytes a through b of s, both included, with no copy; `&s[a..]`,
// `&s[..b]` and `&s[..]` as for a vector. The bounds are integers, byte
// offsets each on a character's boundary, checked when the program runs
// (msir/lowering/places.sn); a constant end past a text local of known
// length is reported here, as for an index. A base reached through a
// reference is read through it (`&r[a..b]` is `&(*r)[a..b]`, written out by
// frontend/desugar/implicit_places.sn). A slice of text is read-only:
// writing into it could cut a character in two, so `&mutable s[a..b]` is
// SULTANC-TYPE-TEXT-SLICE.
عرف ابن_نوع_مقطع_نص_داخلي(
    التعبير: &تعبير,
    الداخل: &تعبير,
    المستويات: طبيعي,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    طابق *التعبير مع
    | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, _) -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.مقطع_نص_غير_صالح(نطاق_تعبير(التعبير)));
    }
    | _ -> { };
    طابق *الداخل مع
    | تعبير.مقطع(_, صندوق_الأساس, الأدنى, الأعلى) -> {
        ليكن الأساس: &تعبير = &(*صندوق_الأساس);
        إذا (المستويات == 0 && !هل_تعبير_موضع_دلالي(الأساس)) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(الأساس)));
        };
        طابق الأدنى مع
        | اختياري.موجود(الحد) -> {
            طابق خطأ_حد_مقطع_داخلي(&(*الحد), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        طابق الأعلى مع
        | اختياري.موجود(الحد) -> {
            طابق خطأ_حد_مقطع_داخلي(&(*الحد), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            إذا (المستويات == 0) {
                طابق خطأ_حد_أعلى_ثابت_داخلي(الأساس, &(*الحد), الروابط, أنواع_الرموز) مع
                | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        إذا (المستويات > 0) {
            أضف_موضع_ضمني(أنواع_التعبيرات, نطاق_تعبير(الأساس), 0, المستويات);
        };
        ليكن نوع_النص: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
        طابق سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, الداخل, نوع_النص) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
        ليكن نوع_المقطع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_النص, خطأ));
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_المقطع);
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// A constant upper bound of a slice of a local of known length that is past
// its last element, reported as the same index `v[i]` would be.
عرف خطأ_حد_أعلى_ثابت_داخلي(
    الأساس: &تعبير,
    الحد: &تعبير,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق طول_معروف_لتعبير(الأساس, الروابط, أنواع_الرموز) مع
    | اختياري.موجود(الطول_المعروف) -> {
        طابق قيمة_عدد_صحيح_سياقية_لتعبير(الحد) مع
        | اختياري.موجود(قيمة_عدد_صحيح_سياقية.طبيعي(الموضع)) -> {
            إذا (الموضع >= الطول_المعروف) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.فهرس_خارج_طول_معروف(
                    نطاق_تعبير(الحد), الموضع, الطول_المعروف
                ));
            };
        }
        | اختياري.موجود(قيمة_عدد_صحيح_سياقية.موقع(الموضع)) -> {
            إذا (الموضع >= 0 && (الموضع مثل طبيعي) >= الطول_المعروف) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.فهرس_خارج_طول_معروف(
                    نطاق_تعبير(الحد), الموضع مثل طبيعي, الطول_المعروف
                ));
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// The element Type of a slice's vector or slice (`vector T`, `[] T`, also
// `mutable`); nothing else is sliced.
عرف نوع_عنصر_مقطع_داخلي(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.متجه(العنصر) -> { أرجع اختياري.موجود(العنصر); }
        | نوع_مقنن.شريحة(العنصر) -> { أرجع اختياري.موجود(العنصر); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// A bound of a slice: an integer, as an index is.
عرف خطأ_حد_مقطع_داخلي(
    الحد: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق ابن_نوع_تعبير_داخلي(الحد, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
        إذا (!هل_نوع_عدد_صحيح_سياقي(الأنواع, النوع)) {
            أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                نطاق_تعبير(الحد), سياق_عدم_توافق_نوع.فهرس_ليس_عددا_صحيحا(),
                اختياري.لا_شيء(), اختياري.موجود(النوع)
            ));
        };
    };
    أرجع اختياري.لا_شيء();
}

// The `ثنائي` arm of ابن_نوع_تعبير_داخلي, in a function of its own so
// that its locals occupy the stack only while it runs: every nested
// expression recurses through ابن_نوع_تعبير_داخلي, whose frame held the
// locals of all its arms at once (13-22 KB a level).
// A binary expression and the left-nested chain under it (`((a + b) + c)`).
// A node whose Type rules type its left operand first, and without an
// expectation from the right one, is typed in a loop: from the innermost such
// run out, each node takes the Type of the node inside it as its left Type,
// then types its right operand and checks its operator, as the recursion
// does. The first node of the chain that types its right operand first
// (`1 + 2 + x`, where the literals take `x`'s Type) is typed as one by
// ابن_نوع_تعبير_ثنائي_مفرد_داخلي. Whether each node is made of literals only
// is computed once, from the innermost node out. A chain of thousands of
// operands overflowed the stack before.
عرف ابن_نوع_تعبير_ثنائي_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    // Raw pointers, not references: Stage0 has no lifetime for a vector of
    // references (bootstrap/src/semantic/body_initializer_check_vector_init.c).
    // Each points into the tree التعبير borrows, which outlives this walk.
    ليكن العقد: متغير متجه *تعبير = [];
    غير_آمن { ألحق(العقد, التعبير مثل *تعبير); };
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        مستمر := خطأ;
        ليكن مؤشر_الأخير: *تعبير = العقد[(الطول(العقد) مثل طبيعي) - 1];
        ليكن الأخير: &تعبير;
        غير_آمن { الأخير := &(*مؤشر_الأخير); };
        طابق *الأخير مع
        | تعبير.ثنائي(_, _, صندوق_اليسار, _) -> {
            ليكن اليسار: &تعبير = &(*صندوق_اليسار);
            طابق *اليسار مع
            | تعبير.ثنائي(_, _, _, _) -> {
                غير_آمن { ألحق(العقد, اليسار مثل *تعبير); };
                مستمر := صواب;
            }
            | _ -> { };
        }
        | _ -> { };
    }
    ليكن العدد: طبيعي = الطول(العقد) مثل طبيعي;
    // Whether each node, as an expression, is made of integer or float
    // literals only (هل_تعبير_عدد_صحيح_سياقي, هل_تعبير_عشري_سياقي).
    ليكن صحيح_سياقي: متغير متجه منطقي = [];
    ليكن عشري_سياقي: متغير متجه منطقي = [];
    ليكن م: متغير طبيعي = 0;
    طالما (م < العدد) {
        ألحق(صحيح_سياقي, خطأ);
        ألحق(عشري_سياقي, خطأ);
        م := م + 1;
    }
    م := العدد;
    طالما (م > 0) {
        م := م - 1;
        ليكن مؤشر_العقدة_7: *تعبير = العقد[م];
        ليكن العقدة_7: &تعبير;
        غير_آمن { العقدة_7 := &(*مؤشر_العقدة_7); };
        طابق *العقدة_7 مع
        | تعبير.ثنائي(_, العامل, صندوق_اليسار, صندوق_اليمين) -> {
            ليكن يسار_صحيح: متغير منطقي = خطأ;
            ليكن يسار_عشري: متغير منطقي = خطأ;
            إذا (م + 1 < العدد) {
                يسار_صحيح := صحيح_سياقي[م + 1];
                يسار_عشري := عشري_سياقي[م + 1];
            } وإلا {
                يسار_صحيح := هل_تعبير_عدد_صحيح_سياقي(&(*صندوق_اليسار));
                يسار_عشري := هل_تعبير_عشري_سياقي(&(*صندوق_اليسار));
            };
            صحيح_سياقي[م] := هل_عامل_ثنائي_ينتج_عددا_صحيحا(العامل) && يسار_صحيح
                && هل_تعبير_عدد_صحيح_سياقي(&(*صندوق_اليمين));
            عشري_سياقي[م] := هل_عامل_ثنائي_ينتج_عشريا(العامل) && يسار_عشري
                && هل_تعبير_عشري_سياقي(&(*صندوق_اليمين));
        }
        | _ -> { };
    }
    // The outermost nodes that type their left operand first, with no
    // expectation from the right one (ابن_نوع_تعبير_ثنائي_مفرد_داخلي's cases
    // with a binary left operand, which is never null).
    ليكن الأول_المفرد: متغير طبيعي = 0;
    ليكن يتسلسل: متغير منطقي = صواب;
    طالما (يتسلسل && الأول_المفرد + 1 < العدد) {
        ليكن مؤشر_العقدة_8: *تعبير = العقد[الأول_المفرد];
        ليكن العقدة_8: &تعبير;
        غير_آمن { العقدة_8 := &(*مؤشر_العقدة_8); };
        طابق *العقدة_8 مع
        | تعبير.ثنائي(_, العامل, _, صندوق_اليمين) -> {
            ليكن يسار_صحيح: منطقي = صحيح_سياقي[الأول_المفرد + 1];
            ليكن يسار_عشري: منطقي = عشري_سياقي[الأول_المفرد + 1];
            ليكن يمين_صحيح: منطقي = هل_تعبير_عدد_صحيح_سياقي(&(*صندوق_اليمين));
            ليكن يمين_عشري: منطقي = هل_تعبير_عشري_سياقي(&(*صندوق_اليمين));
            ليكن يمين_فارغ: منطقي = هل_مؤشر_فارغ_سياقي(&(*صندوق_اليمين), الروابط);
            ليكن مساواة: منطقي = العامل == عامل_ثنائي.يساوي() || العامل == عامل_ثنائي.لا_يساوي();
            إذا (!(يمين_فارغ && مساواة)) {
                إذا (يسار_عشري && !يمين_عشري) { يتسلسل := خطأ; };
                إذا (يتسلسل && !(يمين_عشري && !يسار_عشري) && يسار_صحيح && !يمين_صحيح) {
                    يتسلسل := خطأ;
                };
            };
        }
        | _ -> { يتسلسل := خطأ; };
        إذا (يتسلسل) { الأول_المفرد := الأول_المفرد + 1; };
    }
    ليكن مؤشر_المفرد: *تعبير = العقد[الأول_المفرد];
    ليكن المفرد: &تعبير;
    غير_آمن { المفرد := &(*مؤشر_المفرد); };
    ليكن الناتج: متغير نتيجة_نوع_تعبير_داخلية = ابن_نوع_تعبير_ثنائي_مفرد_داخلي(
        المفرد, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    );
    ليكن ف: متغير طبيعي = الأول_المفرد;
    طالما (ف > 0) {
        ف := ف - 1;
        ليكن نوع_اليسار: معرف_نوع;
        طابق الناتج مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
        ليكن مؤشر_العقدة_9: *تعبير = العقد[ف];
        ليكن العقدة_9: &تعبير;
        غير_آمن { العقدة_9 := &(*مؤشر_العقدة_9); };
        طابق *العقدة_9 مع
        | تعبير.ثنائي(_, العامل, صندوق_اليسار, صندوق_اليمين) -> {
            ليكن اليسار: &تعبير = &(*صندوق_اليسار);
            ليكن اليمين: &تعبير = &(*صندوق_اليمين);
            ليكن يسار_صحيح: منطقي = صحيح_سياقي[ف + 1];
            ليكن يسار_عشري: منطقي = عشري_سياقي[ف + 1];
            ليكن يمين_صحيح: منطقي = هل_تعبير_عدد_صحيح_سياقي(اليمين);
            ليكن يمين_عشري: منطقي = هل_تعبير_عشري_سياقي(اليمين);
            ليكن يمين_فارغ: منطقي = هل_مؤشر_فارغ_سياقي(اليمين, الروابط);
            ليكن مساواة: منطقي = العامل == عامل_ثنائي.يساوي() || العامل == عامل_ثنائي.لا_يساوي();
            // The right operand takes the left Type as its expectation where
            // the single-node rules do: a null against a pointer, a float or
            // integer literal against a float or integer left operand.
            ليكن بتوقع: متغير منطقي = خطأ;
            إذا (يمين_فارغ && مساواة) {
                بتوقع := صواب;
            } وإلا إذا (يمين_عشري && !يسار_عشري) {
                بتوقع := هل_نوع_عشري_دلالي(الأنواع, نوع_اليسار);
            } وإلا إذا (يمين_صحيح && !يسار_صحيح) {
                بتوقع := هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليسار);
            };
            ليكن نوع_اليمين: معرف_نوع;
            إذا (بتوقع) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(اليمين, نوع_اليسار, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            };
            الناتج := أكمل_نوع_ثنائي_داخلي(
                العقدة_9, العامل, اليسار, نوع_اليسار, اليمين, نوع_اليمين, الأنواع, أنواع_التعبيرات
            );
        }
        | _ -> { };
    }
    أرجع الناتج;
}

عرف ابن_نوع_تعبير_ثنائي_مفرد_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.ثنائي(_, العامل, اليسار_المملوك, اليمين_المملوك) -> {
        ليكن اليسار: تعبير = *اليسار_المملوك;
        ليكن اليمين: تعبير = *اليمين_المملوك;
        ليكن نوع_اليسار: متغير معرف_نوع = معرف_نوع_من(0);
        ليكن نوع_اليمين: متغير معرف_نوع = معرف_نوع_من(0);
        ليكن اليسار_سياقي: منطقي = هل_تعبير_عدد_صحيح_سياقي(&اليسار);
        ليكن اليمين_سياقي: منطقي = هل_تعبير_عدد_صحيح_سياقي(&اليمين);
        ليكن اليسار_عشري_سياقي: منطقي = هل_تعبير_عشري_سياقي(&اليسار);
        ليكن اليمين_عشري_سياقي: منطقي = هل_تعبير_عشري_سياقي(&اليمين);
        ليكن اليسار_فارغ: منطقي = هل_مؤشر_فارغ_سياقي(&اليسار, الروابط);
        ليكن اليمين_فارغ: منطقي = هل_مؤشر_فارغ_سياقي(&اليمين, الروابط);
        إذا ((اليسار_فارغ || اليمين_فارغ)
            && (العامل == عامل_ثنائي.يساوي() || العامل == عامل_ثنائي.لا_يساوي())) {
            // An unbound null needs the other's concrete raw-pointer Type.
            // Two nulls have no Type; neither reference nor integer inference is allowed.
            إذا (اليسار_فارغ && اليمين_فارغ) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.فارغ_بلا_مؤشر(),
                    اختياري.لا_شيء(), اختياري.لا_شيء()
                ));
            };
            إذا (اليسار_فارغ) {
                طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, نوع_اليمين, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, نوع_اليسار, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            };
        } وإلا إذا (اليسار_عشري_سياقي && !اليمين_عشري_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            إذا (هل_نوع_عشري_دلالي(الأنواع, نوع_اليمين)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, نوع_اليمين, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            };
        } وإلا إذا (اليمين_عشري_سياقي && !اليسار_عشري_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            إذا (هل_نوع_عشري_دلالي(الأنواع, نوع_اليسار)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, نوع_اليسار, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            };
        } وإلا إذا (اليسار_سياقي && !اليمين_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            إذا (هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليمين)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليسار, نوع_اليمين, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            };
        } وإلا إذا (اليمين_سياقي && !اليسار_سياقي) {
            طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            إذا (هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليسار)) {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(&اليمين, نوع_اليسار, موضع_توقع_نوع.طرف_عامل(), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            } وإلا {
                طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
            };
        } وإلا {
            طابق ابن_نوع_تعبير_داخلي(&اليسار, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليسار := النوع; };
            طابق ابن_نوع_تعبير_داخلي(&اليمين, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_اليمين := النوع; };
        };

        أرجع أكمل_نوع_ثنائي_داخلي(
            التعبير, العامل, &اليسار, نوع_اليسار, &اليمين, نوع_اليمين, الأنواع, أنواع_التعبيرات
        );
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// The operator check and the recorded Type of a binary node once both
// operands are typed (نوع_اليسار, نوع_اليمين).
عرف أكمل_نوع_ثنائي_داخلي(
    التعبير: &تعبير,
    العامل: عامل_ثنائي,
    اليسار: &تعبير,
    نوع_اليسار: معرف_نوع,
    اليمين: &تعبير,
    نوع_اليمين: معرف_نوع,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات
): نتيجة_نوع_تعبير_داخلية {
    // `==` and `!=` of text read a `&string` operand (a slice of text, or a
    // borrow of all of one) through its references: `w == "let"` compares
    // `*w`, byte by byte, with no copy. The frontend writes the dereferences
    // out (frontend/desugar/implicit_places.sn).
    إذا (العامل == عامل_ثنائي.يساوي() || العامل == عامل_ثنائي.لا_يساوي()) {
        طابق مستويات_مقطع_نص_داخلي(الأنواع, نوع_اليسار) مع
        | اختياري.موجود(مستويات_اليسار) -> {
            طابق مستويات_مقطع_نص_داخلي(الأنواع, نوع_اليمين) مع
            | اختياري.موجود(مستويات_اليمين) -> {
                إذا (مستويات_اليسار > 0 || مستويات_اليمين > 0) {
                    إذا (مستويات_اليسار > 0) {
                        أضف_موضع_ضمني(أنواع_التعبيرات, نطاق_تعبير(اليسار), 0, مستويات_اليسار);
                    };
                    إذا (مستويات_اليمين > 0) {
                        أضف_موضع_ضمني(أنواع_التعبيرات, نطاق_تعبير(اليمين), 0, مستويات_اليمين);
                    };
                    ليكن نوع_المقارنة: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
                    أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_المقارنة);
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    };
    طابق العامل مع
    | عامل_ثنائي.أو -> {
        إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_اليسار) || !هل_نوع_منطقي_دلالي(الأنواع, نوع_اليمين)) {
            أرجع خطأ_طرف_عامل_منطقي(الأنواع, اليسار, نوع_اليسار, اليمين, نوع_اليمين);
        };
        ليكن النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | عامل_ثنائي.و -> {
        إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_اليسار) || !هل_نوع_منطقي_دلالي(الأنواع, نوع_اليمين)) {
            أرجع خطأ_طرف_عامل_منطقي(الأنواع, اليسار, نوع_اليسار, اليمين, نوع_اليمين);
        };
        ليكن النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | عامل_ثنائي.يساوي -> {
        إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
        إذا (!هل_عامل_ثنائي_معرف_للنوع(الأنواع, العامل, نوع_اليسار)) { أرجع خطأ_عامل_غير_معرف(الأنواع, التعبير, العامل, نوع_اليسار); };
        ليكن النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | عامل_ثنائي.لا_يساوي -> {
        إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
        إذا (!هل_عامل_ثنائي_معرف_للنوع(الأنواع, العامل, نوع_اليسار)) { أرجع خطأ_عامل_غير_معرف(الأنواع, التعبير, العامل, نوع_اليسار); };
        ليكن النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | عامل_ثنائي.أصغر -> {
        إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
        إذا (!هل_عامل_ثنائي_معرف_للنوع(الأنواع, العامل, نوع_اليسار)) { أرجع خطأ_عامل_غير_معرف(الأنواع, التعبير, العامل, نوع_اليسار); };
        ليكن النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | عامل_ثنائي.أصغر_أو_يساوي -> {
        إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
        إذا (!هل_عامل_ثنائي_معرف_للنوع(الأنواع, العامل, نوع_اليسار)) { أرجع خطأ_عامل_غير_معرف(الأنواع, التعبير, العامل, نوع_اليسار); };
        ليكن النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | عامل_ثنائي.أكبر_أو_يساوي -> {
        إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
        إذا (!هل_عامل_ثنائي_معرف_للنوع(الأنواع, العامل, نوع_اليسار)) { أرجع خطأ_عامل_غير_معرف(الأنواع, التعبير, العامل, نوع_اليسار); };
        ليكن النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | عامل_ثنائي.أكبر -> {
        إذا (!نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) { أرجع خطأ_أنواع_غير_متوافقة(نطاق_تعبير(اليمين), سياق_عدم_توافق_نوع.طرفا_عامل_مختلفان(), نوع_اليسار, نوع_اليمين); };
        إذا (!هل_عامل_ثنائي_معرف_للنوع(الأنواع, العامل, نوع_اليسار)) { أرجع خطأ_عامل_غير_معرف(الأنواع, التعبير, العامل, نوع_اليسار); };
        ليكن النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي()); أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
    }
    | _ -> {
        ليكن صحيحان: منطقي = هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليسار) && هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_اليمين);
        ليكن عشريان: منطقي = هل_نوع_عشري_دلالي(الأنواع, نوع_اليسار) && هل_نوع_عشري_دلالي(الأنواع, نوع_اليمين) && هل_عامل_ثنائي_ينتج_عشريا(العامل);
        إذا ((!صحيحان && !عشريان) || !نوعان_متوافقان(الأنواع, نوع_اليسار, نوع_اليمين)) {
            أرجع خطأ_طرف_عامل_عددي(
                الأنواع, التعبير, اليسار, نوع_اليسار, اليمين, نوع_اليمين
            );
        };
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_اليسار);
    };
}

// The `أحادي` arm of ابن_نوع_تعبير_داخلي, in a function of its own so
// that its locals occupy the stack only while it runs: every nested
// expression recurses through ابن_نوع_تعبير_داخلي, whose frame held the
// locals of all its arms at once (13-22 KB a level).
عرف ابن_نوع_تعبير_أحادي_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.أحادي(_, العامل, الداخل_المملوك) -> {
        ليكن الداخل: تعبير = *الداخل_المملوك;
        ليكن نوع_الداخل: متغير معرف_نوع = معرف_نوع_من(0);
        ليكن مرجع_الداخل: &تعبير = &الداخل;
        طابق *مرجع_الداخل مع
        // `&s[a..b]` of text is a `&string` (ابن_نوع_مقطع_نص_داخلي); any
        // other slice is typed as `v[a..b]` alone is. The base is typed once.
        | تعبير.مقطع(_, صندوق_الأساس, _, _) -> {
            ليكن نوع_الأساس: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&(*صندوق_الأساس), سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الأساس := النوع; };
            طابق مستويات_مقطع_نص_داخلي(الأنواع, نوع_الأساس) مع
            | اختياري.موجود(المستويات) -> {
                إذا (العامل == عامل_أحادي.عنوان() || العامل == عامل_أحادي.عنوان_متغير()) {
                    أرجع ابن_نوع_مقطع_نص_داخلي(
                        التعبير, &الداخل, المستويات, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                };
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.مقطع_نص_غير_صالح(نطاق_تعبير(&الداخل)));
            }
            | اختياري.لا_شيء -> { };
            طابق أكمل_نوع_تعبير_مقطع_داخلي(
                &الداخل, نوع_الأساس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الداخل := النوع; };
        }
        | _ -> {
            طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الداخل := النوع; };
        };
        طابق العامل مع
        | عامل_أحادي.نفي -> {
            إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الداخل)) {
                ليكن نوع_منطقي_متوقع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
                أرجع خطأ_أنواع_غير_متوافقة(
                    نطاق_تعبير(&الداخل), سياق_عدم_توافق_نوع.عامل_يتطلب_منطقيا(),
                    نوع_منطقي_متوقع, نوع_الداخل
                );
            };
            ليكن النوع: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_أحادي.متمم -> {
            إذا (!هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_الداخل)) {
                أرجع خطأ_نوع_موجود_غير_مناسب(
                    نطاق_تعبير(&الداخل), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا_صحيحا(), نوع_الداخل
                );
            };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الداخل);
        }
        | عامل_أحادي.سالب -> {
            إذا (!هل_نوع_عدد_صحيح_سياقي(الأنواع, نوع_الداخل) && !هل_نوع_عشري_دلالي(الأنواع, نوع_الداخل)) {
                أرجع خطأ_نوع_موجود_غير_مناسب(
                    نطاق_تعبير(&الداخل), سياق_عدم_توافق_نوع.عامل_يتطلب_عددا(), نوع_الداخل
                );
            };
            // An unsigned value has no negation. The one
            // negated literal that fits an unsigned Type is `-0`.
            إذا (هل_نوع_عدد_طبيعي_دلالي(الأنواع, نوع_الداخل)) {
                ليكن صفر_سالب: متغير منطقي = خطأ;
                طابق قيمة_عدد_صحيح_سياقية_لتعبير(&الداخل) مع
                | اختياري.موجود(قيمة_عدد_صحيح_سياقية.موقع(العدد)) -> { صفر_سالب := العدد == 0; }
                | اختياري.موجود(قيمة_عدد_صحيح_سياقية.طبيعي(العدد)) -> { صفر_سالب := العدد == 0; }
                | اختياري.لا_شيء -> { };
                إذا (!صفر_سالب) {
                    أرجع خطأ_نوع_موجود_غير_مناسب(
                        نطاق_تعبير(التعبير), سياق_عدم_توافق_نوع.سالب_عدد_طبيعي(), نوع_الداخل
                    );
                };
            };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الداخل);
        }
        | عامل_أحادي.فك -> {
            طابق خطأ_فك_معتم(الأنواع, نوع_الداخل, نطاق_تعبير(التعبير)) مع
            | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
            | اختياري.لا_شيء -> { };
            طابق نوع_فك_داخلي(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(النوع) -> { أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع); }
            | اختياري.لا_شيء -> { };
        }
        | عامل_أحادي.عنوان -> {
            إذا (هل_حرفي_لعنوان_دلالي(&الداخل)) {
                ليكن بلا_توقع: اختياري معرف_نوع = اختياري.لا_شيء();
                أرجع ابن_نوع_عنوان_مؤقت_داخلي(
                    التعبير, بلا_توقع, موضع_توقع_نوع.تهيئة(), صواب, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                );
            };
            إذا (!هل_تعبير_موضع_دلالي(&الداخل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(&الداخل)));
            };
            ليكن نوع_المرجع: متغير معرف_نوع = نوع_الداخل;
            طابق أزل_غلاف_متغير(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(الأساس) -> { نوع_المرجع := الأساس; }
            | اختياري.لا_شيء -> { };
            ليكن النوع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_المرجع, خطأ));
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_أحادي.عنوان_متغير -> {
            // `&mutable v[a..b]`: a writable view of the elements, a
            // `mutable [] T`; v must be a place the program may write.
            طابق الداخل مع
            | تعبير.مقطع(_, صندوق_الأساس, _, _) -> {
                إذا (!هل_موضع_قابل_للتغيير(&(*صندوق_الأساس), الأنواع, أنواع_التعبيرات)) {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(&(*صندوق_الأساس)))
                    );
                };
                ليكن نوع_العرض: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.متغير(نوع_الداخل));
                أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_العرض);
            }
            | _ -> { };
            إذا (!هل_تعبير_موضع_دلالي(&الداخل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.أخذ_عنوان_غير_موضع(نطاق_تعبير(&الداخل)));
            };
            إذا (!هل_موضع_قابل_للتغيير(&الداخل, الأنواع, أنواع_التعبيرات)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(&الداخل)));
            };
            ليكن نوع_المرجع: متغير معرف_نوع = نوع_الداخل;
            طابق أزل_غلاف_متغير(الأنواع, نوع_الداخل) مع
            | اختياري.موجود(الأساس) -> { نوع_المرجع := الأساس; }
            | اختياري.لا_شيء -> { };
            ليكن النوع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_المرجع, صواب));
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | عامل_أحادي.انتشار -> {
            // The propagation expansion replaces every `؟` statement before
            // name resolution (frontend/desugar/propagation.sn).
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
            ));
        };
        // Only dereference falls through: its operand is not a pointer or reference.
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
            خطأ_بناء_سياقات_أنواع.فك_غير_مؤشر(نطاق_تعبير(التعبير), نوع_الداخل)
        );
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// The `استدعاء` arm of ابن_نوع_تعبير_داخلي, in a function of its own so
// that its locals occupy the stack only while it runs: every nested
// expression recurses through ابن_نوع_تعبير_داخلي, whose frame held the
// locals of all its arms at once (13-22 KB a level).
// Whether the callee is the compiler's `split_mutable` (`اقسم_قابلا_للتعديل`):
// that name with no declaration in scope (a declaration shadows it).
عام عرف هل_قسمة_قابلة_للتعديل_داخلي(
    المستدعى: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الروابط: &سياق_روابط_أسماء
): منطقي {
    طابق *المستدعى مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(_) -> { أرجع خطأ; }
        | اختياري.لا_شيء -> { };
        طابق معرف_اسم_محلول_عند(الروابط, الاسم.النطاق) مع
        | اختياري.موجود(الهوية) -> {
            أرجع اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «split_mutable»)
                || اسم_مقنن_يطابق_نصا_سياقيا(سياق_الأسماء, الهوية, «اقسم_قابلا_للتعديل»);
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// `split_mutable(&mutable v, i)`: v (a vector or slice the program may write)
// split at i into two writable views: the elements before i, and those from
// i on. The pair is taken apart by a match, `match split_mutable(&mutable v,
// i) with | (left, right) -> { … }`, whose two names are `mutable [] T`. The pair borrows v exclusively, as
// `&mutable v` does: v is not used while either half is; the halves are
// apart and do not conflict with each other. The split index is an integer
// with 0 <= i <= length, checked when the program runs (a vector the program
// may write has no length known here). Lowering builds the two halves with
// the checked subslice (msir/lowering/places.sn).
عرف ابن_نوع_قسمة_قابلة_للتعديل_داخلي(
    التعبير: &تعبير,
    الحجج: &متجه تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن العدد: طبيعي = الطول(*الحجج) مثل طبيعي;
    إذا (العدد != 2) {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
            نطاق_تعبير(التعبير), 2, العدد
        ));
    };
    ليكن الأولى: &تعبير = &(*الحجج)[0];
    ليكن الموضع: متغير اختياري صندوق تعبير = اختياري.لا_شيء();
    طابق *الأولى مع
    | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, صندوق_الداخل) -> {
        إذا (هل_تعبير_موضع_دلالي(&(*صندوق_الداخل))) {
            ليكن النسخة: تعبير = انسخ_مملوكا_تعبير(&(*صندوق_الداخل));
            ليكن الصندوق: صندوق تعبير = صندوق النسخة;
            الموضع := اختياري.موجود(الصندوق);
        };
    }
    | _ -> { };
    // The vector is asked for with `&mutable`.
    طابق الموضع مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.عرض_بلا_علامة(نطاق_تعبير(الأولى)));
    }
    | اختياري.موجود(الصندوق) -> {
        ليكن المكان: &تعبير = &(*الصندوق);
        ليكن نوع_المكان: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_تعبير_داخلي(المكان, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_المكان := النوع; };
        ليكن نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_عنصر_مقطع_داخلي(الأنواع, نوع_المكان) مع
        | اختياري.موجود(العنصر) -> { نوع_العنصر := العنصر; }
        | اختياري.لا_شيء -> {
            أرجع خطأ_نوع_موجود_غير_مناسب(
                نطاق_تعبير(المكان), سياق_عدم_توافق_نوع.نوع_غير_قابل_للفهرسة(), نوع_المكان
            );
        };
        إذا (!هل_موضع_قابل_للتغيير(المكان, الأنواع, أنواع_التعبيرات)) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(المكان)));
        };
        ليكن الموقع: &تعبير = &(*الحجج)[1];
        طابق خطأ_حد_مقطع_داخلي(الموقع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ليكن نوع_الشريحة: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.شريحة(نوع_العنصر));
        ليكن نوع_العرض: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.متغير(نوع_الشريحة));
        إذا (!أضف_نوع_تعبير(الأنواع, أنواع_التعبيرات, نطاق_تعبير(الأولى), نوع_العرض)) {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
                نطاق_تعبير(الأولى), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
            ));
        };
        // The pair's Type holds plain slices (a value's representation);
        // the names a match binds the halves to are the writable views
        // (اجعل_نصفي_قسمة_قابلين_للكتابة).
        ليكن العناصر: متجه معرف_نوع = [نوع_الشريحة, نوع_الشريحة];
        ليكن نوع_الزوج: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.صف(العناصر));
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الزوج);
    };
}

عرف ابن_نوع_تعبير_استدعاء_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.استدعاء(_, المستدعى_المملوك, الحجج) -> {
        ليكن المستدعى: تعبير = مستدعى_بلا_حجج_نوع(&(*المستدعى_المملوك));
        إذا (هل_قسمة_قابلة_للتعديل_داخلي(&المستدعى, سياق_الأسماء, الروابط)) {
            أرجع ابن_نوع_قسمة_قابلة_للتعديل_داخلي(
                التعبير, &الحجج, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            );
        };
        طابق ابن_نوع_منشئ_تمهيدي_بلا_توقع_داخلي(
            التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        ) مع
        | اختياري.موجود(الناتج) -> { أرجع الناتج; }
        | اختياري.لا_شيء -> { };
        ليكن هوية_البدائي: متغير اختياري هوية_بدائي_مترجم = اختياري.لا_شيء();
        طابق رمز_اسم_محلول_عند(الروابط, نطاق_تعبير(&المستدعى)) مع
        | اختياري.موجود(رمز_المستدعى) -> {
            هوية_البدائي := هوية_بدائي_رمز_عند(سياق_الأسماء, رمز_المستدعى);
        }
        | اختياري.لا_شيء -> { };

        طابق هوية_البدائي مع
        | اختياري.موجود(الهوية) -> {
            // Primitive Symbols intentionally do not receive fake monomorphic function Types.
            // Their exact language-Type legality is dispatched by canonical primitive identity.
            ليكن أنواع_الحجج: متغير متجه معرف_نوع = [];
            ليكن أنواع_البدائي: أنواع_استدعاء_بدائي_مقننة =
                ابن_أنواع_استدعاء_بدائي_مقننة(الأنواع);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                ليكن نتيجة_الحجة: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الحجج[ف]), ثابت_أنواع_مكسور.حجة_بلا_نوع())
                );
                طابق نوع_حجة_بدائية_متوقعة(الأنواع, &أنواع_البدائي, الهوية, ف, &أنواع_الحجج) مع
                | اختياري.موجود(المتوقع) -> {
                    نتيجة_الحجة := ابن_نوع_تعبير_بتوقع_داخلي(
                        &الحجج[ف], المتوقع, موضع_توقع_نوع.بدائي(الهوية, ف), سياق_الأسماء,
                        الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                }
                | اختياري.لا_شيء -> {
                    نتيجة_الحجة := ابن_نوع_تعبير_داخلي(
                        &الحجج[ف], سياق_الأسماء, الأنواع,
                        أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                };
                طابق نتيجة_الحجة مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { ألحق(أنواع_الحجج, النوع); };
                ف := ف + 1;
            }

            // Canonicalize the reference-to-pointer ABI Type while Type still
            // owns its registry. Lowering is read-only and must never invent an
            // unregistered pointer Type during MSIR emission.
            طابق الهوية مع
            | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                ليكن فهرس_ذاكرة: متغير طبيعي = 1;
                طالما (فهرس_ذاكرة < (الطول(أنواع_الحجج) مثل طبيعي)) {
                    طابق معرف_نوع_أساس_عند(الأنواع, أنواع_الحجج[فهرس_ذاكرة]) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(مرجع_النوع_21) -> {
                        طابق (*الأنواع).الأنواع[مرجع_النوع_21.القيمة] مع
                        | نوع_مقنن.مرجع(الداخل, مرجع_متغير) -> {
                            طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, الداخل) مع
                            | اختياري.موجود(_) -> {
                                ليكن عنصر_المؤشر: متغير معرف_نوع = الداخل;
                                إذا (مرجع_متغير) {
                                    عنصر_المؤشر := قنن_نوعا(
                                        الأنواع, نوع_مقنن.متغير(الداخل)
                                    );
                                };
                                ليكن معرف_مؤشر_الاستدعاء: معرف_نوع = قنن_نوعا(
                                    الأنواع, نوع_مقنن.مؤشر(عنصر_المؤشر)
                                );
                            }
                            | اختياري.لا_شيء -> { };
                        }
                        | _ -> { };
                    };
                    فهرس_ذاكرة := فهرس_ذاكرة + 1;
                }
            }
            | _ -> { };

            // Primitive Type rules own semantic container/value compatibility only.
            // Append, pop and truncate mutate their first argument, so reuse the
            // canonical place-legality path here instead of encoding mutability
            // into the vector's semantic Type.
            ليكن يعدل_الحجة_الأولى: متغير منطقي = خطأ;
            طابق الهوية مع
            | هوية_بدائي_مترجم.إلحاق -> { يعدل_الحجة_الأولى := صواب; }
            | هوية_بدائي_مترجم.إزالة_الأخير -> { يعدل_الحجة_الأولى := صواب; }
            | هوية_بدائي_مترجم.اقتطاع_متجه -> { يعدل_الحجة_الأولى := صواب; }
            | هوية_بدائي_مترجم.حجز_سعة_متجه -> { يعدل_الحجة_الأولى := صواب; }
            | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> { يعدل_الحجة_الأولى := صواب; }
            | _ -> { };
            إذا (يعدل_الحجة_الأولى) {
                إذا ((الطول(الحجج) مثل طبيعي) >= 1) {
                    إذا (!هل_تعبير_موضع_دلالي(&الحجج[0])
                        || !هل_موضع_قابل_للتغيير(&الحجج[0], الأنواع, أنواع_التعبيرات)) {
                        ليكن الموجود: معرف_نوع = أنواع_الحجج[0];
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                                نطاق_تعبير(&الحجج[0]), الهوية, 0, الموجود
                            )
                        );
                    };
                };
            };
            طابق الهوية مع
            | هوية_بدائي_مترجم.تبديل_موضعين -> {
                ليكن ف_الموضع: متغير طبيعي = 0;
                طالما (ف_الموضع < (الطول(الحجج) مثل طبيعي)) {
                    إذا (!هل_تعبير_موضع_دلالي(&الحجج[ف_الموضع])
                        || !هل_موضع_قابل_للتغيير(&الحجج[ف_الموضع], الأنواع, أنواع_التعبيرات)) {
                        ليكن الموجود: معرف_نوع = أنواع_الحجج[ف_الموضع];
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                            خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                                نطاق_تعبير(&الحجج[ف_الموضع]), الهوية, ف_الموضع, الموجود
                            )
                        );
                    };
                    ف_الموضع := ف_الموضع + 1;
                }
            }
            | _ -> { };

            طابق تحقق_استدعاء_بدائي(
                الأنواع, &أنواع_البدائي, الهوية, &أنواع_الحجج
            ) مع
            | نتيجة_استدعاء_بدائي.صالح(فئة_الناتج) -> {
                ليكن الناتج: متغير معرف_نوع = قنن_نوع_ناتج_استدعاء_بدائي(
                    الأنواع, &أنواع_البدائي, فئة_الناتج
                );
                طابق نوع_ناتج_استدعاء_بدائي_من_الحجج(الأنواع, فئة_الناتج, &أنواع_الحجج) مع
                | اختياري.موجود(المعرف) -> { الناتج := المعرف; }
                | اختياري.لا_شيء -> { };
                طابق قنن_نوع_ناتج_بدائي_بالحجج(الأنواع, فئة_الناتج, &أنواع_الحجج) مع
                | اختياري.موجود(المعرف) -> { الناتج := المعرف; }
                | اختياري.لا_شيء -> { };
                أرجع سجل_نوع_تعبير_داخلي(
                    الأنواع, أنواع_التعبيرات, التعبير, الناتج
                );
            }
            | نتيجة_استدعاء_بدائي.مرفوض(خطأ_البدائي) -> {
                طابق خطأ_البدائي مع
                | خطأ_استدعاء_بدائي.عدد_حجج_غير_مطابق(المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.عدد_حجج_بدائية_غير_مطابق(
                            نطاق_تعبير(التعبير), الهوية, المتوقع, الموجود
                        )
                    );
                }
                | خطأ_استدعاء_بدائي.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_مطابق(
                            نطاق_تعبير(&الحجج[الفهرس]), الهوية, الفهرس, المتوقع, الموجود
                        )
                    );
                }
                | خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(الفهرس, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_بدائية_غير_صالح(
                            نطاق_تعبير(&الحجج[الفهرس]), الهوية, الفهرس, الموجود
                        )
                    );
                }
                | خطأ_استدعاء_بدائي.دلالة_مصدرية_غير_متاحة -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.دلالة_بدائي_غير_متاحة(
                            نطاق_تعبير(التعبير), الهوية
                        )
                    );
                };
            };
        }
        | اختياري.لا_شيء -> {
            // Ordinary calls retain the canonical function-Type validation path unchanged.
            ليكن نوع_المستدعى: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(
                &المستدعى, سياق_الأسماء, الأنواع,
                أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_المستدعى := النوع;
            };

            ليكن استدعاء_عام: منطقي = هل_نوع_يحوي_معامل_نوع(الأنواع, نوع_المستدعى);
            ليكن يسمح_بمؤقت: منطقي = يسمح_بعنوان_مؤقت_داخلي(الأنواع, نوع_المستدعى);
            ليكن الاستبدالات_الحالية: متغير متجه ربط_استبدال_نوع = [];
            طابق استبدالات_حجج_نوع_صريحة_داخلي(
                &(*المستدعى_المملوك), سياق_الأسماء, الأنواع, الروابط, أنواع_الرموز
            ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | نتيجة.نجح(القيم) -> { الاستبدالات_الحالية := القيم; };
            ليكن أنواع_الحجج: متغير متجه معرف_نوع = [];
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                ليكن نتيجة_الحجة: متغير نتيجة_نوع_تعبير_داخلية = نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&الحجج[ف]), ثابت_أنواع_مكسور.حجة_بلا_نوع())
                );
                طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
                | اختياري.موجود(المتوقع_الخام) -> {
                    ليكن توقع_الحجة: متغير اختياري معرف_نوع = اختياري.موجود(المتوقع_الخام);
                    إذا (استدعاء_عام) {
                        ليكن المتوقع: معرف_نوع = استبدل_نوعا(
                            الأنواع, المتوقع_الخام, &الاستبدالات_الحالية
                        );
                        توقع_الحجة := اختياري.موجود(المتوقع);
                        إذا (هل_نوع_يحوي_معامل_نوع(الأنواع, المتوقع)) { توقع_الحجة := اختياري.لا_شيء(); };
                    };
                    نتيجة_الحجة := ابن_نوع_حجة_داخلي(
                        &الحجج[ف], توقع_الحجة, ف, يسمح_بمؤقت, سياق_الأسماء,
                        الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                }
                | اختياري.لا_شيء -> {
                    ليكن بلا_توقع: اختياري معرف_نوع = اختياري.لا_شيء();
                    نتيجة_الحجة := ابن_نوع_حجة_داخلي(
                        &الحجج[ف], بلا_توقع, ف, يسمح_بمؤقت, سياق_الأسماء,
                        الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    );
                };
                طابق نتيجة_الحجة مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                    ألحق(أنواع_الحجج, النوع);
                    إذا (استدعاء_عام) {
                        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
                        | اختياري.موجود(المتوقع_الخام) -> {
                            إذا (!أضف_استبدالات_من_معامل_استدعاء(
                                الأنواع, المتوقع_الخام, النوع, &متغير الاستبدالات_الحالية
                            )) {
                                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                                    خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                                        نطاق_تعبير(&الحجج[ف]), ف, المتوقع_الخام, النوع
                                    )
                                );
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    };
                };
                ف := ف + 1;
            }

            طابق تحقق_توقيع_استدعاء_باستبدالات(
                الأنواع, نوع_المستدعى, &أنواع_الحجج, &الاستبدالات_الحالية
            ) مع
            | نتيجة_توقيع_استدعاء.صالح(الناتج, استبدالات_النوع) -> {
                طابق خطأ_معتم_في_توقيع_مثيل(
                    الأنواع, سياق_الأسماء, نوع_المستدعى, &استبدالات_النوع,
                    رمز_مستدعى_محلول_للنوع(سياق_الأسماء, الروابط, &المستدعى), نطاق_تعبير(التعبير)
                ) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                ليكن نطاقات_الحجج: متغير متجه نطاق = [];
                ليكن ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الحجج) مثل طبيعي)) {
                    ألحق(نطاقات_الحجج, نطاق_تعبير(&الحجج[ح]));
                    ح := ح + 1;
                }
                ليكن رمز_الاستدعاء: اختياري معرف_رمز = رمز_مستدعى_محلول_للنوع(
                    سياق_الأسماء, الروابط, &المستدعى
                );
                أضف_استدعاء_نوعيا(
                    أنواع_التعبيرات, نطاق_تعبير(التعبير), نوع_المستدعى,
                    رمز_الاستدعاء, نطاقات_الحجج, استبدالات_النوع
                );
                أرجع سجل_نوع_تعبير_داخلي(
                    الأنواع, أنواع_التعبيرات, التعبير, الناتج
                );
            }
            | نتيجة_توقيع_استدعاء.مرفوض(خطأ_التوقيع) -> {
                طابق خطأ_التوقيع مع
                | خطأ_توقيع_استدعاء.غير_قابل_للاستدعاء -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.تعبير_غير_قابل_للاستدعاء(
                            نطاق_تعبير(التعبير), نوع_المستدعى
                        )
                    );
                }
                | خطأ_توقيع_استدعاء.عدد_حجج_غير_مطابق(المتوقع, الموجود) -> {
                    طابق خطأ_حجة_موقع_صريحة_داخلي(
                        أنواع_الرموز, رمز_مستدعى_محلول_للنوع(سياق_الأسماء, الروابط, &المستدعى), المتوقع, الموجود, &الحجج
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                    | اختياري.لا_شيء -> { };
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.عدد_حجج_استدعاء_غير_مطابق(
                            نطاق_تعبير(التعبير), المتوقع, الموجود
                        )
                    );
                }
                | خطأ_توقيع_استدعاء.نوع_حجة_غير_مطابق(الفهرس, المتوقع, الموجود) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                        خطأ_بناء_سياقات_أنواع.نوع_حجة_استدعاء_غير_مطابق(
                            نطاق_تعبير(&الحجج[الفهرس]), الفهرس, المتوقع, الموجود
                        )
                    );
                };
            };
        };
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// The `إغلاق` arm of ابن_نوع_تعبير_داخلي, in a function of its own so
// that its locals occupy the stack only while it runs: every nested
// expression recurses through ابن_نوع_تعبير_داخلي, whose frame held the
// locals of all its arms at once (13-22 KB a level).
عرف ابن_نوع_تعبير_إغلاق_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.إغلاق(النطاق, المعاملات, الناتج_التركيبي, الجسم_المملوك) -> {
        ليكن أنواع_المعاملات: متغير متجه معرف_نوع = [];
        ليكن رموز_المعاملات: متغير متجه معرف_رمز = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
            ليكن مرجع_المعامل: &معامل_إغلاق = &المعاملات[ف];
            ليكن المعامل: معامل_إغلاق = *مرجع_المعامل;
            ليكن نوع_المعامل: معرف_نوع;
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &المعامل.النوع) مع
            | نتيجة_حل_نوع.موجود(المعرف) -> { نوع_المعامل := المعرف; }
            | _ -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&المعامل.النوع))); };
            طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, نوع_المعامل, نطاق_نوع_تركيبي_داخلي(&المعامل.النوع)) مع
            | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
            | اختياري.لا_شيء -> { };
            ليكن رمز_المعامل: معرف_رمز;
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &المعامل.الاسم) مع
            | نتيجة.نجح(الرمز) -> { رمز_المعامل := الرمز; }
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); };
            إذا (!أضف_نوع_رمز(أنواع_الرموز, رمز_المعامل, نوع_المعامل)) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(المعامل.النطاق));
            };
            ألحق(أنواع_المعاملات, نوع_المعامل);
            ألحق(رموز_المعاملات, رمز_المعامل);
            ف := ف + 1;
        }
        ليكن نوع_الناتج: معرف_نوع;
        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &(*الناتج_التركيبي)) مع
        | نتيجة_حل_نوع.موجود(المعرف) -> { نوع_الناتج := المعرف; }
        | _ -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&(*الناتج_التركيبي)))); };
        طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, نوع_الناتج, نطاق_نوع_تركيبي_داخلي(&(*الناتج_التركيبي))) مع
        | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
        | اختياري.لا_شيء -> { };
        ليكن الجسم: تعبير = *الجسم_المملوك;
        // A `return` in a match expression of the body leaves the closure.
        ليكن إرجاع_المحيط: معرف_نوع = (*أنواع_الرموز).نوع_الإرجاع_الجاري;
        (*أنواع_الرموز).نوع_الإرجاع_الجاري := نوع_الناتج;
        طابق ابن_نوع_تعبير_بتوقع_داخلي(
            &الجسم, نوع_الناتج, موضع_توقع_نوع.إرجاع(), سياق_الأسماء,
            الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        ) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
        (*أنواع_الرموز).نوع_الإرجاع_الجاري := إرجاع_المحيط;
        ليكن الالتقاطات: متغير متجه معرف_رمز = [];
        اجمع_التقاطات_إغلاق(&الجسم, سياق_الأسماء, الروابط, &رموز_المعاملات, &متغير الالتقاطات);
        أضف_حقيقة_إغلاق(أنواع_التعبيرات, النطاق, الالتقاطات);
        ليكن نوع_الإغلاق: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.دالة(أنواع_المعاملات, نوع_الناتج));
        أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الإغلاق);
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// A match expression (docs/en/book/ch06-02-match.md, "A match that gives a
// value"), in a function of its own like the other arms of
// ابن_نوع_تعبير_داخلي. The scrutinee is typed, each pattern binds its names
// against the scrutinee's Type as in the match statement, each body is typed
// as a block (a `return` in it against the return Type of the code around
// it), and each value against the match's Type: the context's when it has
// one (المتوقع; a mismatch is the context's own, at the value), else the Type
// of the first value (a later value of another Type is
// أذرع_مطابقة_مختلفة, at that value). One arm at least gives a value. The
// match's Type is recorded at its span.
عرف ابن_نوع_مطابقة_تعبيرية_داخلي(
    التعبير: &تعبير,
    المتوقع: اختياري معرف_نوع,
    الموضع: موضع_توقع_نوع,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.مطابقة(النطاق, المطابقة) -> {
        ليكن نوع_المميز: متغير معرف_نوع = معرف_نوع_من(0);
        طابق ابن_نوع_مميز_داخلي(
            &(*المطابقة).المميز, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
        ) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_المميز := النوع; };
        ليكن نوع_الإرجاع: معرف_نوع = (*أنواع_الرموز).نوع_الإرجاع_الجاري;
        ليكن نوع_المطابقة: متغير اختياري معرف_نوع = المتوقع;
        ليكن موضع_القيم: متغير موضع_توقع_نوع = الموضع;
        ليكن لها_قيمة: متغير منطقي = خطأ;
        ليكن ذ: متغير طبيعي = 0;
        طالما (ذ < (الطول((*المطابقة).الأذرع) مثل طبيعي)) {
            إذا (!اربط_أنواع_رموز_نمط_تركيبي(
                &(*المطابقة).الأذرع[ذ].النمط, نوع_المميز, سياق_الأسماء, الأنواع,
                الروابط, أنواع_الرموز
            )) {
                طابق مخالفة_حمولات_نمط_في(
                    &(*المطابقة).الأذرع[ذ].النمط, نوع_المميز, سياق_الأسماء, الأنواع, الروابط
                ) مع
                | اختياري.موجود(المخالفة) -> {
                    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.عدد_حمولات_نمط_غير_مطابق(
                        المخالفة.النطاق, المخالفة.المتوقع, المخالفة.الموجود
                    ));
                }
                | اختياري.لا_شيء -> { };
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                    خطأ_بناء_سياقات_أنواع.نمط_غير_صالح(نطاق_نمط(&(*المطابقة).الأذرع[ذ].النمط))
                );
            };
            إذا (هل_مميز_قابل_للكتابة(&(*المطابقة).المميز)) {
                اجعل_بقايا_نمط_قابلة_للكتابة(&(*المطابقة).الأذرع[ذ].النمط, الأنواع, الروابط, أنواع_الرموز);
            };
            إذا (هل_مميز_قسمة_داخلي(&(*المطابقة).المميز, سياق_الأسماء, الروابط)) {
                اجعل_نصفي_قسمة_قابلين_للكتابة(&(*المطابقة).الأذرع[ذ].النمط, الأنواع, الروابط, أنواع_الرموز);
            };
            // A guard is a condition over the pattern's bindings, as in the
            // match statement.
            ليكن مرجع_الحارس: &اختياري تعبير = &(*المطابقة).الأذرع[ذ].الحارس;
            طابق *مرجع_الحارس مع
            | اختياري.موجود(الحارس) -> {
                طابق ابن_نوع_تعبير_داخلي(&الحارس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الحارس) -> {
                    إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الحارس)) {
                        أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_شرط_غير_منطقي(الأنواع, &الحارس, نوع_الحارس));
                    };
                };
            }
            | اختياري.لا_شيء -> { };
            طابق ابن_كتلة_أنواع_داخلية(
                &(*المطابقة).الأذرع[ذ].الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات,
                الروابط, أنواع_الرموز, نوع_الإرجاع
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
            | اختياري.لا_شيء -> { };
            (*أنواع_الرموز).نوع_الإرجاع_الجاري := نوع_الإرجاع;
            ليكن مرجع_قيمة_الذراع: &اختياري تعبير = &(*المطابقة).القيم[ذ];
            طابق *مرجع_قيمة_الذراع مع
            | اختياري.موجود(قيمة_الذراع) -> {
                لها_قيمة := صواب;
                طابق نوع_المطابقة مع
                | اختياري.موجود(نوع_القيم) -> {
                    طابق ابن_نوع_تعبير_بتوقع_داخلي(
                        &قيمة_الذراع, نوع_القيم, موضع_القيم, سياق_الأسماء,
                        الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    ) مع
                    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                    | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                }
                | اختياري.لا_شيء -> {
                    طابق ابن_نوع_تعبير_داخلي(
                        &قيمة_الذراع, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    ) مع
                    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ); }
                    | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                        // A value of the match is no place: a mutable
                        // local's Type gives its value's.
                        ليكن نوع_الأولى: متغير معرف_نوع = النوع;
                        طابق أزل_غلاف_متغير(الأنواع, النوع) مع
                        | اختياري.موجود(الأساس) -> { نوع_الأولى := الأساس; }
                        | اختياري.لا_شيء -> { };
                        نوع_المطابقة := اختياري.موجود(نوع_الأولى);
                        موضع_القيم := موضع_توقع_نوع.ذراع_مطابقة();
                        إذا ((*المطابقة).من_إذا) { موضع_القيم := موضع_توقع_نوع.فرع_إذا(); };
                    };
                };
            }
            | اختياري.لا_شيء -> { };
            ذ := ذ + 1;
        }
        إذا (!لها_قيمة) {
            إذا ((*المطابقة).من_إذا) {
                أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.إذا_تعبيرية_بلا_قيمة(النطاق));
            };
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.مطابقة_تعبيرية_بلا_قيمة(النطاق));
        };
        طابق نوع_المطابقة مع
        | اختياري.موجود(النوع) -> {
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, النوع);
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}

// The `تحويل` arm of ابن_نوع_تعبير_داخلي, in a function of its own so
// that its locals occupy the stack only while it runs: every nested
// expression recurses through ابن_نوع_تعبير_داخلي, whose frame held the
// locals of all its arms at once (13-22 KB a level).
عرف ابن_نوع_تعبير_تحويل_داخلي(
    التعبير: &تعبير,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): نتيجة_نوع_تعبير_داخلية {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.تحويل(النطاق_الكلي, الداخل_المملوك, الهدف) -> {
        ليكن الداخل: تعبير = *الداخل_المملوك;
        ليكن نوع_المصدر: متغير اختياري معرف_نوع = اختياري.لا_شيء();
        طابق ابن_نوع_تعبير_داخلي(&الداخل, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
        | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ);
        }
        | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_المصدر := اختياري.موجود(النوع); };
        طابق قنن_نوع_تركيبي(الأنواع, الروابط, &(*الهدف)) مع
        | نتيجة_حل_نوع.موجود(نوع_الهدف) -> {
            طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, نوع_الهدف, نطاق_نوع_تركيبي_داخلي(&(*الهدف))) مع
            | اختياري.موجود(خطأ_المعتم) -> { أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_المعتم); }
            | اختياري.لا_شيء -> { };
            // Casts between two scalar Types are checked here (docs/en/reference/type-system.md,
            // "Numeric casts"); other shapes are checked where they are lowered.
            طابق نوع_المصدر مع
            | اختياري.موجود(المصدر) -> {
                إذا (تحويل_سلمي_مرفوض(الأنواع, المصدر, نوع_الهدف)) {
                    أرجع خطأ_أنواع_غير_متوافقة(
                        النطاق_الكلي, سياق_عدم_توافق_نوع.تحويل_غير_صالح(), نوع_الهدف, المصدر
                    );
                };
                // A 32-bit address word is checked against the target later.
                إذا ((هل_مؤشر_خام_دلالي(الأنواع, المصدر) && هل_نوع_صحيح_32_دلالي(الأنواع, نوع_الهدف))
                    || (هل_نوع_صحيح_32_دلالي(الأنواع, المصدر) && هل_مؤشر_خام_دلالي(الأنواع, نوع_الهدف))) {
                    أضف_تحويل_عنوان_32(أنواع_التعبيرات, النطاق_الكلي, المصدر, نوع_الهدف);
                };
            }
            | اختياري.لا_شيء -> { };
            أرجع سجل_نوع_تعبير_داخلي(الأنواع, أنواع_التعبيرات, التعبير, نوع_الهدف);
        }
        | _ -> {
            أرجع نتيجة_نوع_تعبير_داخلية.خطأ(
                خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(نطاق_نوع_تركيبي_داخلي(&(*الهدف)))
            );
        };
    }
    | _ -> { };
    أرجع نتيجة_نوع_تعبير_داخلية.خطأ(خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(
        نطاق_تعبير(التعبير), ثابت_أنواع_مكسور.تسجيل_نوع_تعبير()
    ));
}


عرف ابن_تواقيع_الدوال_داخلية(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ليكن مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        ليكن العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            ليكن أنواع_المعاملات: متغير متجه معرف_نوع = [];
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(الدالة.المعاملات) مثل طبيعي)) {
                ليكن مرجع_المعامل: &معامل = &الدالة.المعاملات[م];
                ليكن المعامل: معامل = *مرجع_المعامل;
                ليكن نوع_المعامل: متغير معرف_نوع = معرف_نوع_من(0);
                طابق قنن_نوع_تركيبي(الأنواع, الروابط, &المعامل.النوع) مع
                | نتيجة_حل_نوع.موجود(النوع) -> {
                    طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, النوع, نطاق_نوع_تركيبي_داخلي(&المعامل.النوع)) مع
                    | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                    | اختياري.لا_شيء -> { };
                    نوع_المعامل := النوع;
                }
                | _ -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                        نطاق_نوع_تركيبي_داخلي(&المعامل.النوع)
                    ));
                };
                طابق رمز_اسم_مطلوب_للنوع(الروابط, &المعامل.الاسم) مع
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة.نجح(رمز_المعامل) -> {
                    إذا (!أضف_نوع_رمز(أنواع_الرموز, رمز_المعامل, نوع_المعامل)) {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(المعامل.النطاق));
                    };
                };
                ألحق(أنواع_المعاملات, نوع_المعامل);
                م := م + 1;
            }
            ليكن نوع_الناتج: متغير معرف_نوع = معرف_نوع_من(0);
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &الدالة.الناتج) مع
            | نتيجة_حل_نوع.موجود(النوع) -> {
                طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, النوع, نطاق_نوع_تركيبي_داخلي(&الدالة.الناتج)) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                نوع_الناتج := النوع;
            }
            | _ -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                    نطاق_نوع_تركيبي_داخلي(&الدالة.الناتج)
                ));
            };
            // A track-caller function: an ordinary function (a body, no type
            // or compile-time parameters) whose last parameter is a location.
            إذا (الدالة.يتتبع_المستدعي) {
                ليكن العدد: طبيعي = الطول(أنواع_المعاملات) مثل طبيعي;
                ليكن صالحة: متغير منطقي = العدد > 0
                    && (الطول(الدالة.معاملات_النوع) مثل طبيعي) == 0;
                طابق الدالة.الجسم مع
                | اختياري.لا_شيء -> { صالحة := خطأ; }
                | اختياري.موجود(_) -> { };
                ليكن م_تتبع: متغير طبيعي = 0;
                طالما (صالحة && م_تتبع < العدد) {
                    إذا (الدالة.المعاملات[م_تتبع].مطلوب_مسبقا) { صالحة := خطأ; };
                    م_تتبع := م_تتبع + 1;
                }
                إذا (صالحة) { صالحة := نوع_موقع_مصدر_دلالي(الأنواع, أنواع_المعاملات[العدد - 1]); };
                إذا (!صالحة) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.توقيع_يتتبع_المستدعي_غير_صالح(الدالة.الاسم.النطاق));
                };
            };
            // A `@@c_abi` function (C calling convention): an ordinary function
            // whose parameters and result C can pass in registers or on the
            // stack: integers, floating point, booleans, raw pointers.
            إذا (الدالة.اتفاقية_سي) {
                ليكن صالحة_سي: متغير منطقي = (الطول(الدالة.معاملات_النوع) مثل طبيعي) == 0;
                طابق الدالة.الجسم مع
                | اختياري.لا_شيء -> { صالحة_سي := خطأ; }
                | اختياري.موجود(_) -> { };
                ليكن م_سي: متغير طبيعي = 0;
                طالما (صالحة_سي && م_سي < (الطول(أنواع_المعاملات) مثل طبيعي)) {
                    إذا (الدالة.المعاملات[م_سي].مطلوب_مسبقا || !نوع_بصيغة_سي(الأنواع, أنواع_المعاملات[م_سي], خطأ)) {
                        صالحة_سي := خطأ;
                    };
                    م_سي := م_سي + 1;
                }
                إذا (صالحة_سي) { صالحة_سي := نوع_بصيغة_سي(الأنواع, نوع_الناتج, صواب); };
                إذا (!صالحة_سي) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.استعمال_اتفاقية_سي_غير_صالح(الدالة.الاسم.النطاق));
                };
            };
            ليكن نوع_الدالة: معرف_نوع = قنن_نوعا(
                الأنواع,
                نوع_مقنن.دالة(أنواع_المعاملات, نوع_الناتج)
            );
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &الدالة.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة.نجح(رمز_الدالة) -> {
                إذا (!أضف_نوع_رمز(أنواع_الرموز, رمز_الدالة, نوع_الدالة)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(الدالة.النطاق));
                };
                إذا (الدالة.يتتبع_المستدعي) { علم_يتتبع_المستدعي(أنواع_الرموز, رمز_الدالة); };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_أنواع_قيم_عليا_داخلية(
    العناصر: &متجه عنصر_وحدة,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ليكن مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        ليكن العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            ليكن نوع_القيمة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &التصريح.النوع) مع
            | نتيجة_حل_نوع.موجود(النوع) -> {
                طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, النوع, نطاق_نوع_تركيبي_داخلي(&التصريح.النوع)) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                نوع_القيمة := النوع;
            }
            | _ -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                    نطاق_نوع_تركيبي_داخلي(&التصريح.النوع)
                ));
            };
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة.نجح(الرمز) -> {
                إذا (!أضف_نوع_رمز(أنواع_الرموز, الرمز, نوع_القيمة)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_تهيئات_قيم_عليا_داخلية(
    العناصر: &متجه عنصر_وحدة,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ليكن مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        ليكن العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            ليكن نوع_التصريح: متغير معرف_نوع = معرف_نوع_من(0);
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &التصريح.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة.نجح(الرمز) -> {
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                | اختياري.موجود(النوع) -> { نوع_التصريح := النوع; }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(
                        الرمز, التصريح.الاسم.النطاق
                    ));
                };
            };
            ليكن نوع_التهيئة: متغير معرف_نوع = نوع_التصريح;
            طابق أزل_غلاف_متغير(الأنواع, نوع_التصريح) مع
            | اختياري.موجود(الأساس) -> { نوع_التهيئة := الأساس; }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
            };
            طابق التصريح.التهيئة مع
            | تهيئة_قيمة_عليا.خارجية(_) -> { }
            | تهيئة_قيمة_عليا.تعبير(التعبير) -> {
                طابق ابن_نوع_تعبير_بتوقع_داخلي(
                    &التعبير, نوع_التهيئة, موضع_توقع_نوع.تهيئة(),
                    سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
            }
            | تهيئة_قيمة_عليا.متجه(العناصر) -> {
                ليكن نوع_العنصر: معرف_نوع;
                طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_التهيئة) مع
                | اختياري.موجود(المعرف) -> { نوع_العنصر := المعرف; }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(التصريح.النطاق));
                };
                ليكن فهرس_العنصر: متغير طبيعي = 0;
                طالما (فهرس_العنصر < (الطول(العناصر) مثل طبيعي)) {
                    طابق ابن_نوع_تعبير_متوقع_داخلي(
                        &العناصر[فهرس_العنصر], نوع_العنصر, فهرس_العنصر,
                        سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                    ) مع
                    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | نتيجة_نوع_تعبير_داخلية.موجود(_) -> { };
                    فهرس_العنصر := فهرس_العنصر + 1;
                }
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The first `break` or `continue` that no loop of the same function encloses.
// A compile-time block is a function of its own.
// A closure body is an expression, never a statement block, so loop control
// cannot appear inside a closure (the parser rejects it); a loop around the
// closure is therefore never taken for the closure's own loop.
عرف أول_قفز_خارج_حلقة(الكتلة: &كتلة_عبارات, في_حلقة: منطقي): اختياري نطاق {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكتلة).العبارات) مثل طبيعي)) {
        ليكن مرجع_الصندوق: &صندوق عبارة = &(*الكتلة).العبارات[ف];
        ليكن العبارة: عبارة = **مرجع_الصندوق;
        ليكن الموجود: متغير اختياري نطاق = اختياري.لا_شيء();
        طابق العبارة مع
        | عبارة.اخرج_من_حلقة(النطاق) -> {
            إذا (!في_حلقة) { الموجود := اختياري.موجود(النطاق); };
        }
        | عبارة.تابع_حلقة(النطاق) -> {
            إذا (!في_حلقة) { الموجود := اختياري.موجود(النطاق); };
        }
        | عبارة.طالما(_, _, الجسم) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, صواب); }
        | عبارة.لكل(_, _, _, _, الجسم) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, صواب); }
        | عبارة.إذا(_, _, عند_الصواب, عند_الخطأ) -> {
            الموجود := أول_قفز_خارج_حلقة(&عند_الصواب, في_حلقة);
            طابق الموجود مع
            | اختياري.لا_شيء -> {
                طابق عند_الخطأ مع
                | اختياري.موجود(الكتلة_الأخرى) -> { الموجود := أول_قفز_خارج_حلقة(&الكتلة_الأخرى, في_حلقة); }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        }
        | عبارة.طابق(_, _, الأذرع) -> {
            ليكن ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
                طابق الموجود مع
                | اختياري.لا_شيء -> { الموجود := أول_قفز_خارج_حلقة(&الأذرع[ذ].الجسم, في_حلقة); }
                | _ -> { };
                ذ := ذ + 1;
            }
        }
        | عبارة.غير_آمن(_, الجسم) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, في_حلقة); }
        | عبارة.وقت_الترجمة(_, الجسم) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, خطأ); }
        | عبارة.إسناد_وقت_الترجمة(_, _, الجسم, _) -> { الموجود := أول_قفز_خارج_حلقة(&الجسم, خطأ); }
        | _ -> { };
        طابق الموجود مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        // The arms of the statement's match expressions: in the statement's
        // loop context, and outside any loop in a closure's body.
        طابق أول_قفز_في_مطابقات_تعبيرية(&العبارة, في_حلقة) مع
        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أول_قفز_في_مطابقات_تعبيرية(العبارة: &عبارة, في_حلقة: منطقي): اختياري نطاق {
    ليكن المباشرة: متجه تعبير = مطابقات_تعبيرية_متداخلة_عبارة(العبارة, خطأ);
    ليكن الكل: متجه تعبير = مطابقات_تعبيرية_متداخلة_عبارة(العبارة, صواب);
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول(الكل) مثل طبيعي)) {
        // One outside every closure keeps the statement's loop context.
        ليكن في_حلقتها: متغير منطقي = خطأ;
        ليكن د: متغير طبيعي = 0;
        طالما (د < (الطول(المباشرة) مثل طبيعي)) {
            إذا (نطاقان_متساويان(نطاق_تعبير(&المباشرة[د]), نطاق_تعبير(&الكل[م]))) { في_حلقتها := في_حلقة; };
            د := د + 1;
        }
        ليكن مرجع_المطابقة: &تعبير = &الكل[م];
        طابق *مرجع_المطابقة مع
        | تعبير.مطابقة(_, المطابقة) -> {
            ليكن ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول((*المطابقة).الأذرع) مثل طبيعي)) {
                طابق أول_قفز_خارج_حلقة(&(*المطابقة).الأذرع[ذ].الجسم, في_حلقتها) مع
                | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
                | اختياري.لا_شيء -> { };
                ذ := ذ + 1;
            }
        }
        | _ -> { };
        م := م + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف خطأ_شرط_غير_منطقي(
    الأنواع: &متغير سجل_أنواع,
    الشرط: &تعبير,
    نوع_الشرط: معرف_نوع
): خطأ_بناء_سياقات_أنواع {
    ليكن نوع_المنطقي: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.منطقي());
    أرجع خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
        نطاق_تعبير(الشرط), سياق_عدم_توافق_نوع.شرط_غير_منطقي(),
        اختياري.موجود(نوع_المنطقي), اختياري.موجود(نوع_الشرط)
    );
}

// The first declared field of a record Type that a literal does not write.
عرف أول_حقل_سجل_مفقود(
    الأنواع: &سجل_أنواع,
    نوع_السجل: معرف_نوع,
    عدد_الحقول: طبيعي,
    المكتوبة: &متجه معرف_اسم
): اختياري معرف_اسم {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_الحقول) {
        طابق حقل_سجل_عند(الأنواع, نوع_السجل, ف) مع
        | اختياري.موجود(الحقل) -> {
            ليكن موجود: متغير منطقي = خطأ;
            ليكن هـ: متغير طبيعي = 0;
            طالما (هـ < (الطول(*المكتوبة) مثل طبيعي)) {
                إذا (معرفا_اسم_متساويان((*المكتوبة)[هـ], الحقل.الاسم)) { موجود := صواب; };
                هـ := هـ + 1;
            }
            إذا (!موجود) { أرجع اختياري.موجود(الحقل.الاسم); };
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_كتلة_أنواع_داخلية(
    الكتلة: &كتلة_عبارات,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز,
    نوع_الناتج_المتوقع: معرف_نوع
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن القيمة: كتلة_عبارات = *الكتلة;
    ليكن ف: متغير طبيعي = 0;
    // The local the previous statement declared: its initializer follows it.
    ليكن آخر_مصرح: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    طالما (ف < (الطول(القيمة.العبارات) مثل طبيعي)) {
        ليكن مرجع_الصندوق: &صندوق عبارة = &القيمة.العبارات[ف];
        ليكن العبارة: عبارة = **مرجع_الصندوق;
        // A match expression in the statement types the arms' `return`s
        // against this block's return Type.
        (*أنواع_الرموز).نوع_الإرجاع_الجاري := نوع_الناتج_المتوقع;
        ليكن المصرح_السابق: اختياري معرف_رمز = آخر_مصرح;
        آخر_مصرح := رمز_تصريح_عبارة(&العبارة, الروابط);
        طابق العبارة مع
        | عبارة.تصريح_متغير(النطاق, الاسم, النوع_التركيبي) -> {
            ليكن النوع: متغير معرف_نوع = معرف_نوع_من(0);
            طابق قنن_نوع_تركيبي(الأنواع, الروابط, &النوع_التركيبي) مع
            | نتيجة_حل_نوع.موجود(المعرف) -> {
                طابق خطأ_معتم_في_نوع_مكتوب(الأنواع, المعرف, نطاق_نوع_تركيبي_داخلي(&النوع_التركيبي)) مع
                | اختياري.موجود(خطأ_المعتم) -> { أرجع اختياري.موجود(خطأ_المعتم); }
                | اختياري.لا_شيء -> { };
                النوع := المعرف;
            }
            | _ -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_غير_محلول(
                    نطاق_نوع_تركيبي_داخلي(&النوع_التركيبي)
                ));
            };
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &الاسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة.نجح(الرمز) -> {
                إذا (!أضف_نوع_رمز(أنواع_الرموز, الرمز, النوع)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(النطاق));
                };
            };
        }
        | عبارة.تهيئة_سجل(_, الوجهة, الحقول) -> {
            ليكن نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            طابق افحص_حقول_سجل_داخلي(
                نطاق_تعبير(&الوجهة), نوع_الوجهة, &الحقول, سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.تهيئة_صف(_, الوجهة, العناصر) -> {
            ليكن نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الوجهة) مع
            | اختياري.موجود(المتوقع) -> {
                إذا ((الطول(العناصر) مثل طبيعي) != المتوقع) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                        نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.عدد_عناصر_صف(),
                        اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
                    ));
                };
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                    اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
                ));
            };
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(العناصر) مثل طبيعي)) {
                ليكن نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
                طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الوجهة, ع) مع
                | اختياري.موجود(النوع) -> {
                    نوع_العنصر := النوع;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(
                        خطأ_بناء_سياقات_أنواع.نوع_تعبير_غير_مدعوم(نطاق_تعبير(&العناصر[ع]), ثابت_أنواع_مكسور.نوع_عنصر_صف())
                    );
                };
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &العناصر[ع], نوع_العنصر, ع, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | _ -> { };
                ع := ع + 1;
            }
        }
        | عبارة.تهيئة_متجه(_, الوجهة, العناصر) -> {
            ليكن نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            ليكن نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
            طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_الوجهة) مع
            | اختياري.موجود(النوع) -> {
                نوع_العنصر := النوع;
            }
            | اختياري.لا_شيء -> {
                // A slice view initialized from a literal views that literal.
                طابق نوع_عنصر_شريحة_دلالي(الأنواع, نوع_الوجهة) مع
                | اختياري.موجود(النوع) -> { نوع_العنصر := النوع; }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                        نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                        اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
                    ));
                };
            };
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(العناصر) مثل طبيعي)) {
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &العناصر[ع], نوع_العنصر, ع, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | _ -> { };
                ع := ع + 1;
            }
            سجل_طول_تهيئة_حرفية(
                &الوجهة, نوع_الوجهة, الطول(العناصر) مثل طبيعي, المصرح_السابق,
                الأنواع, الروابط, أنواع_الرموز
            );
        }
        | عبارة.تهيئة_نص(_, الوجهة, بايتات_النص) -> {
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الوجهة) -> {
                ليكن نوع_النص: معرف_نوع = نوع_بدائي_للخط(الأنواع, نوع_بدائي_مقنن.نص());
                إذا (!نوعان_متوافقان(الأنواع, نوع_الوجهة, نوع_النص)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                        نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.قيمة_لا_تطابق_الوجهة(),
                        اختياري.موجود(نوع_الوجهة), اختياري.موجود(نوع_النص)
                    ));
                };
                // Text indexes bytes: the literal's byte count is its length.
                سجل_طول_تهيئة_حرفية(
                    &الوجهة, نوع_الوجهة, الطول(بايتات_النص) مثل طبيعي, المصرح_السابق,
                    الأنواع, الروابط, أنواع_الرموز
                );
            };
        }
        | عبارة.تهيئة_صندوق(_, الوجهة, الحمولة) -> {
            ليكن نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                نوع_الوجهة := النوع;
            };
            طابق نوع_حمولة_صندوق_دلالي(الأنواع, نوع_الوجهة) مع
            | اختياري.موجود(نوع_الحمولة) -> {
                طابق ابن_نوع_تعبير_متوقع_داخلي(
                    &الحمولة, نوع_الحمولة, 0, سياق_الأسماء,
                    الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.أنواع_غير_متوافقة(
                    نطاق_تعبير(&الوجهة), سياق_عدم_توافق_نوع.حرفي_لا_يناسب_الوجهة(),
                    اختياري.موجود(نوع_الوجهة), اختياري.لا_شيء()
                ));
            };
        }
        | عبارة.نسخ(_, الوجهة, المصدر) -> {
            إذا (!هل_تعبير_موضع_دلالي(&الوجهة)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.إسناد_إلى_غير_موضع(نطاق_تعبير(&الوجهة)));
            };
            ليكن نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الوجهة := النوع; };
            إذا (هل_تعبير_فهرسة_دلالي(&الوجهة)
                && !هل_موضع_قابل_للتغيير(&الوجهة, الأنواع, أنواع_التعبيرات)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(&الوجهة)));
            };
            إذا (هل_حقل_جذره_غير_قابل_للتغيير(&الوجهة, الأنواع, أنواع_التعبيرات)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(&الوجهة)));
            };
            إذا (هل_حقل_عبر_مرجع_مشترك(&الوجهة, الأنواع, أنواع_التعبيرات)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.كتابة_إلى_غير_قابل_للتغيير(نطاق_تعبير(&الوجهة)));
            };
            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                &المصدر, نوع_الوجهة, موضع_توقع_نوع.تهيئة(), سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | _ -> { };
            طابق خطأ_عنوان_حرفي_محمول(&المصدر, الأنواع, أنواع_التعبيرات) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            // `let t: string = "..."` initializes from a text literal.
            طابق المصدر مع
            | تعبير.حرفي(_, حرفي.نص(بايتات_المصدر)) -> {
                سجل_طول_تهيئة_حرفية(
                    &الوجهة, نوع_الوجهة, الطول(بايتات_المصدر) مثل طبيعي, المصرح_السابق,
                    الأنواع, الروابط, أنواع_الرموز
                );
            }
            | _ -> { };
        }
        | عبارة.استدعاء(_, التعبير) -> {
            طابق ابن_نوع_تعبير_داخلي(&التعبير, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | _ -> { };
        }
        | عبارة.لكل(النطاق, البداية, الشرط, الخطوة, الجسم) -> {
            ليكن كتلة_البداية: كتلة_عبارات = { النطاق: النطاق, العبارات: انسخ_مملوكا_متجه_صندوق_عبارة(&البداية) };
            طابق ابن_كتلة_أنواع_داخلية(&كتلة_البداية, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق ابن_نوع_تعبير_داخلي(&الشرط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الشرط) -> {
                إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الشرط)) {
                    أرجع اختياري.موجود(خطأ_شرط_غير_منطقي(الأنواع, &الشرط, نوع_الشرط));
                };
            };
            ليكن نسخة_الخطوة: صندوق عبارة = انسخ_مملوكا_صندوق_عبارة(&الخطوة);
            ليكن قائمة_الخطوة: متجه صندوق عبارة = [نسخة_الخطوة];
            ليكن كتلة_الخطوة: كتلة_عبارات = { النطاق: النطاق, العبارات: قائمة_الخطوة };
            طابق ابن_كتلة_أنواع_داخلية(&كتلة_الخطوة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق ابن_كتلة_أنواع_داخلية(&الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.اخرج_من_حلقة(_) -> { }
        | عبارة.تابع_حلقة(_) -> { }
        | عبارة.طالما(_, الشرط, الجسم) -> {
            طابق ابن_نوع_تعبير_داخلي(&الشرط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الشرط) -> {
                إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الشرط)) {
                    أرجع اختياري.موجود(خطأ_شرط_غير_منطقي(الأنواع, &الشرط, نوع_الشرط));
                };
            };
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.إذا(_, الشرط, عند_الصواب, عند_الخطأ) -> {
            طابق ابن_نوع_تعبير_داخلي(&الشرط, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الشرط) -> {
                إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الشرط)) {
                    أرجع اختياري.موجود(خطأ_شرط_غير_منطقي(الأنواع, &الشرط, نوع_الشرط));
                };
            };
            طابق ابن_كتلة_أنواع_داخلية(
                &عند_الصواب, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
            طابق عند_الخطأ مع
            | اختياري.موجود(الكتلة_الأخرى) -> {
                طابق ابن_كتلة_أنواع_داخلية(
                    &الكتلة_الأخرى, سياق_الأسماء,
                    الأنواع,
                    أنواع_التعبيرات,
                    الروابط,
                    أنواع_الرموز,
                    نوع_الناتج_المتوقع
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.طابق(_, المميز, الأذرع) -> {
            // A tuple `let`: its one arm carries the written Type.
            ليكن ربط_صف: متغير منطقي = خطأ;
            إذا ((الطول(الأذرع) مثل طبيعي) == 1) {
                طابق الأذرع[0].نوع_ليكن مع
                | اختياري.موجود(المكتوب) -> {
                    ربط_صف := صواب;
                    طابق ابن_أنواع_ربط_صف_داخلي(
                        &الأذرع[0].النمط, &المكتوب, &المميز, سياق_الأسماء, الأنواع,
                        أنواع_التعبيرات, الروابط, أنواع_الرموز
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                    طابق ابن_كتلة_أنواع_داخلية(
                        &الأذرع[0].الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات,
                        الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            };
            ليكن نوع_المميز: متغير معرف_نوع = معرف_نوع_من(0);
            إذا (!ربط_صف) {
                طابق ابن_نوع_مميز_داخلي(&المميز, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> {
                    نوع_المميز := النوع;
                };
            };
            ليكن ذ: متغير طبيعي = 0;
            إذا (ربط_صف) { ذ := الطول(الأذرع) مثل طبيعي; };
            طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
                إذا (!اربط_أنواع_رموز_نمط_تركيبي(
                    &الأذرع[ذ].النمط, نوع_المميز, سياق_الأسماء, الأنواع,
                    الروابط, أنواع_الرموز
                )) {
                    طابق مخالفة_حمولات_نمط_في(
                        &الأذرع[ذ].النمط, نوع_المميز, سياق_الأسماء, الأنواع, الروابط
                    ) مع
                    | اختياري.موجود(المخالفة) -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.عدد_حمولات_نمط_غير_مطابق(
                            المخالفة.النطاق, المخالفة.المتوقع, المخالفة.الموجود
                        ));
                    }
                    | اختياري.لا_شيء -> { };
                    أرجع اختياري.موجود(
                        خطأ_بناء_سياقات_أنواع.نمط_غير_صالح(نطاق_نمط(&الأذرع[ذ].النمط))
                    );
                };
                إذا (هل_مميز_قابل_للكتابة(&المميز)) {
                    اجعل_بقايا_نمط_قابلة_للكتابة(&الأذرع[ذ].النمط, الأنواع, الروابط, أنواع_الرموز);
                };
                إذا (هل_مميز_قسمة_داخلي(&المميز, سياق_الأسماء, الروابط)) {
                    اجعل_نصفي_قسمة_قابلين_للكتابة(&الأذرع[ذ].النمط, الأنواع, الروابط, أنواع_الرموز);
                };
                // A guard is a condition over the pattern's bindings.
                طابق الأذرع[ذ].الحارس مع
                | اختياري.موجود(الحارس) -> {
                    طابق ابن_نوع_تعبير_داخلي(&الحارس, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
                    | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | نتيجة_نوع_تعبير_داخلية.موجود(نوع_الحارس) -> {
                        إذا (!هل_نوع_منطقي_دلالي(الأنواع, نوع_الحارس)) {
                            أرجع اختياري.موجود(خطأ_شرط_غير_منطقي(الأنواع, &الحارس, نوع_الحارس));
                        };
                    };
                }
                | اختياري.لا_شيء -> { };
                طابق ابن_كتلة_أنواع_داخلية(
                    &الأذرع[ذ].الجسم, سياق_الأسماء,
                    الأنواع,
                    أنواع_التعبيرات,
                    الروابط,
                    أنواع_الرموز,
                    نوع_الناتج_المتوقع
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                ذ := ذ + 1;
            }
        }
        | عبارة.أرجع(نطاق_الإرجاع, القيمة_الراجعة) -> {
            طابق القيمة_الراجعة مع
            | اختياري.موجود(التعبير) -> {
                طابق ابن_نوع_تعبير_إرجاع_داخلي(
                    &التعبير, نوع_الناتج_المتوقع, سياق_الأسماء, الأنواع,
                    أنواع_التعبيرات, الروابط, أنواع_الرموز
                ) مع
                | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | _ -> { };
                طابق خطأ_عنوان_حرفي_محمول(&التعبير, الأنواع, أنواع_التعبيرات) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> {
                // A bare return gives no value to a function that returns one.
                ليكن نوع_الفراغ: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
                إذا (!نوعان_متوافقان(الأنواع, نوع_الناتج_المتوقع, نوع_الفراغ)) {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_إرجاع_غير_مطابق(
                        نطاق_الإرجاع, نوع_الناتج_المتوقع, نوع_الفراغ
                    ));
                };
            };
        }
        | عبارة.تجميع(_, _) -> { }
        | عبارة.وقت_الترجمة(_, الجسم) -> {
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات,
                الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.إسناد_وقت_الترجمة(_, الوجهة, الجسم, الناتج) -> {
            إذا (!هل_تعبير_موضع_دلالي(&الوجهة)) {
                أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.إسناد_إلى_غير_موضع(نطاق_تعبير(&الوجهة)));
            };
            ليكن نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق ابن_نوع_تعبير_داخلي(&الوجهة, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_نوع_تعبير_داخلية.موجود(النوع) -> { نوع_الوجهة := النوع; };
            // The block is the body of its own compile-time function, which
            // returns no value: a `return` inside cannot leave the enclosing
            // function.
            ليكن نوع_الفراغ: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات,
                الروابط, أنواع_الرموز, نوع_الفراغ
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق ابن_نوع_تعبير_بتوقع_داخلي(
                &الناتج, نوع_الوجهة, موضع_توقع_نوع.تهيئة(), سياق_الأسماء,
                الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
            ) مع
            | نتيجة_نوع_تعبير_داخلية.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | _ -> { };
        }
        | عبارة.غير_آمن(_, الجسم) -> {
            طابق ابن_كتلة_أنواع_داخلية(
                &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج_المتوقع
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        };
        // An initializer's members are kept past the statement: none may
        // borrow a literal's temporary.
        طابق خطأ_عنوان_حرفي_في_تهيئة(&(*(*مرجع_الصندوق)), الأنواع, أنواع_التعبيرات) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف خطأ_عنوان_حرفي_في_تهيئة(
    العبارة: &عبارة,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق *العبارة مع
    | عبارة.تهيئة_سجل(_, _, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            طابق خطأ_عنوان_حرفي_محمول(&الحقول[ف].القيمة, الأنواع, أنواع_التعبيرات) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | عبارة.تهيئة_صف(_, _, العناصر) -> { أرجع خطأ_عنوان_حرفي_محمول_في(&العناصر, الأنواع, أنواع_التعبيرات); }
    | عبارة.تهيئة_متجه(_, _, العناصر) -> { أرجع خطأ_عنوان_حرفي_محمول_في(&العناصر, الأنواع, أنواع_التعبيرات); }
    | عبارة.تهيئة_صندوق(_, _, الحمولة) -> { أرجع خطأ_عنوان_حرفي_محمول(&الحمولة, الأنواع, أنواع_التعبيرات); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف ابن_أجسام_الدوال_داخلية(
    العناصر: &متجه عنصر_وحدة,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ليكن مرجع_العنصر: &عنصر_وحدة = &(*العناصر)[ف];
        ليكن العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            ليكن نوع_الناتج: متغير معرف_نوع = معرف_نوع_من(0);
            طابق رمز_اسم_مطلوب_للنوع(الروابط, &الدالة.الاسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة.نجح(رمز_الدالة) -> {
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, رمز_الدالة) مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.نوع_رمز_مفقود(رمز_الدالة, الدالة.الاسم.النطاق));
                }
                | اختياري.موجود(نوع_الدالة) -> {
                    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة) مع
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(الدالة.النطاق));
                    }
                    | اختياري.موجود(النوع) -> {
                        نوع_الناتج := النوع;
                    };
                };
            };
            طابق الدالة.الجسم مع
            | اختياري.موجود(الجسم) -> {
                طابق أول_قفز_خارج_حلقة(&الجسم, خطأ) مع
                | اختياري.موجود(نطاق_القفز) -> {
                    أرجع اختياري.موجود(خطأ_بناء_سياقات_أنواع.قفز_خارج_حلقة(نطاق_القفز));
                }
                | اختياري.لا_شيء -> { };
                طابق ابن_كتلة_أنواع_داخلية(
                    &الجسم, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز, نوع_الناتج
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Types one module's top-level initializers and function bodies again, into a
// new expression context, against the Type facts of a whole analysed state
// (its registry and its Symbols' Types, which already hold every signature):
// the last sweep of ابن_سياقات_أنواع_وحدات_داخلية for that module alone. An
// incremental tooling session re-checks an edited module's bodies this way
// when no declaration changed (semantic_pipeline.sn, افحص_أجسام_وحدة_في_حالة).
عام عرف اكتب_أنواع_أجسام_وحدة_للأدوات(
    العناصر: &متجه عنصر_وحدة,
    سياق_الأسماء: &سياق_أسماء,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متغير سياق_أنواع_تعبيرات,
    الروابط: &سياق_روابط_أسماء,
    أنواع_الرموز: &متغير سياق_أنواع_رموز
): اختياري خطأ_بناء_سياقات_أنواع {
    طابق ابن_تهيئات_قيم_عليا_داخلية(
        العناصر, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    أرجع ابن_أجسام_الدوال_داخلية(
        العناصر, سياق_الأسماء, الأنواع, أنواع_التعبيرات, الروابط, أنواع_الرموز
    );
}

// Forgets the Types (and known lengths) of the Symbols from الأول on: the
// locals an incremental re-check binds, before each typing attempt, so a
// body set aside keeps no Type from an earlier attempt.
عام عرف انس_أنواع_رموز_من(أنواع_الرموز: &متغير سياق_أنواع_رموز, الأول: طبيعي): فراغ {
    ليكن ف: متغير طبيعي = الأول;
    طالما (ف < (الطول((*أنواع_الرموز).الأنواع) مثل طبيعي)) {
        (*أنواع_الرموز).الأنواع[ف] := اختياري.لا_شيء();
        ف := ف + 1;
    }
    ف := الأول;
    طالما (ف < (الطول((*أنواع_الرموز).الأطوال_المعروفة) مثل طبيعي)) {
        (*أنواع_الرموز).الأطوال_المعروفة[ف] := اختياري.لا_شيء();
        ف := ف + 1;
    }
}

عام عرف ابن_سياقات_أنواع_وحدات(
    الوحدات: &متجه وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_سياقات_أنواع {
    أرجع ابن_سياقات_أنواع_وحدات_من(
        سياقات_أنواع_وحدة_فارغة(), 0, الوحدات, سياق_الأسماء, روابط_الأسماء, الإلغاء
    );
}

// The Type facts of no module yet.
عام عرف سياقات_أنواع_وحدة_فارغة(): سياقات_أنواع_وحدة {
    ليكن أنواع_التعبيرات: متجه سياق_أنواع_تعبيرات = [];
    ليكن العلاقات: متجه علاقة_هرم_نوع = [];
    ليكن الفارغة: سياقات_أنواع_وحدة = {
        الأنواع: سجل_أنواع_جديد(),
        أنواع_التعبيرات: أنواع_التعبيرات,
        أنواع_الرموز: سياق_أنواع_رموز_جديد(),
        علاقات_هرم_الأنواع: العلاقات
    };
    أرجع الفارغة;
}

// Types the modules from البداية on, continuing the Type facts of the modules
// before it (الأساس, built by this function for those modules). A module
// before البداية never imports a later one, so every sweep below covers only
// the new modules. Incremental tooling analysis (incremental_analysis.sn)
// keeps الأساس between requests.
عام عرف ابن_سياقات_أنواع_وحدات_من(
    الأساس: سياقات_أنواع_وحدة,
    البداية: طبيعي,
    الوحدات: &متجه وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_سياقات_أنواع {
    طابق الأساس مع
    | {
        الأنواع: الأنواع_الأساس,
        أنواع_التعبيرات: تعبيرات_الأساس,
        أنواع_الرموز: رموز_الأساس,
        علاقات_هرم_الأنواع: علاقات_الأساس
    } -> {
        أرجع ابن_سياقات_أنواع_وحدات_داخلية(
            الأنواع_الأساس, تعبيرات_الأساس, رموز_الأساس, علاقات_الأساس, البداية,
            الوحدات, سياق_الأسماء, روابط_الأسماء, الإلغاء
        );
    };
}

عرف ابن_سياقات_أنواع_وحدات_داخلية(
    الأنواع_الأساس: سجل_أنواع,
    تعبيرات_الأساس: متجه سياق_أنواع_تعبيرات,
    رموز_الأساس: سياق_أنواع_رموز,
    علاقات_الأساس: متجه علاقة_هرم_نوع,
    البداية: طبيعي,
    الوحدات: &متجه وحدة_مصدر,
    سياق_الأسماء: &سياق_أسماء,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    الإلغاء: &حالة_إلغاء_واجهة
): نتيجة_بناء_سياقات_أنواع {
    ليكن الأنواع: متغير سجل_أنواع = الأنواع_الأساس;
    ليكن أنواع_تعبيرات_الوحدات: متغير متجه سياق_أنواع_تعبيرات = تعبيرات_الأساس;
    ليكن علاقات_هرم_الأنواع: متغير متجه علاقة_هرم_نوع = علاقات_الأساس;
    ليكن أنواع_الرموز: متغير سياق_أنواع_رموز = رموز_الأساس;
    ليكن ف: متغير طبيعي = البداية;

    // No decorator may disappear during lowering. Until the verified-MSIR
    // declaration transformation is available, annotations are rejected at
    // their own span, including on types and global declarations.
    ليكن موضع_السمة: متغير طبيعي = البداية;
    طالما (موضع_السمة < (الطول(*الوحدات) مثل طبيعي)) {
        ليكن العناصر_ذات_السمات: &متجه عنصر_وحدة = &(*الوحدات)[موضع_السمة].العناصر;
        ليكن موضع_التصريح: متغير طبيعي = 0;
        طالما (موضع_التصريح < (الطول(*العناصر_ذات_السمات) مثل طبيعي)) {
            طابق (*العناصر_ذات_السمات)[موضع_التصريح] مع
            | عنصر_وحدة.دالة(التصريح) -> {
                إذا ((الطول(التصريح.السمات) مثل طبيعي) > 0) {
                    أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(
                        خطأ_بناء_سياقات_أنواع.سمة_تصريح_غير_مدعومة(التصريح.السمات[0].النطاق), الأنواع
                    );
                };
            }
            | عنصر_وحدة.نوع(التصريح) -> {
                إذا ((الطول(التصريح.السمات) مثل طبيعي) > 0) {
                    أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(
                        خطأ_بناء_سياقات_أنواع.سمة_تصريح_غير_مدعومة(التصريح.السمات[0].النطاق), الأنواع
                    );
                };
            }
            | عنصر_وحدة.قيمة_عليا(التصريح) -> {
                إذا ((الطول(التصريح.السمات) مثل طبيعي) > 0) {
                    أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(
                        خطأ_بناء_سياقات_أنواع.سمة_تصريح_غير_مدعومة(التصريح.السمات[0].النطاق), الأنواع
                    );
                };
            }
            | _ -> { };
            موضع_التصريح := موضع_التصريح + 1;
        }
        موضع_السمة := موضع_السمة + 1;
    }

    // Register all generic Type parameters before resolving any declaration/signature Type syntax.
    ف := البداية;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ليكن مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        ليكن قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        ليكن روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق سجل_معاملات_نوع_العناصر(
            &(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Named Type syntax consumes each module's canonical Name bindings directly.
    // Every named aggregate is declared before any module completes a cross-module shape.
    ف := البداية;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ليكن مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        ليكن قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        ليكن روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق أعلن_التراكيب_المسماة(&(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := البداية;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ليكن مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        ليكن قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        ليكن روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق أكمل_المرادفات(&(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير علاقات_هرم_الأنواع) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := البداية;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ليكن مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        ليكن قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        ليكن روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق أكمل_التراكيب_المسماة(
            &(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Generic aggregate instances may have been interned while another template was
    // still an empty forward declaration. Rebuild their concrete semantic shapes once
    // every named template is complete, before function signatures/bodies consume them.
    إذا (!أعد_بناء_مثيلات_أنواع_مسماة(&متغير الأنواع)) {
        أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(
            خطأ_بناء_سياقات_أنواع.تعريف_نوع_غير_صالح(نطاق_فارغ()), الأنواع
        );
    };

    // Function signatures for all modules precede all bodies so calls are graph-order independent.
    ف := البداية;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ليكن مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        ليكن قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        ليكن روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق ابن_تواقيع_الدوال_داخلية(
            &(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Top-level value Types are registered for every module before any initializer/body
    // expression is typed, preserving graph-order independence just like function signatures.
    ف := البداية;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ليكن مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        ليكن قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        ليكن روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        طابق ابن_أنواع_قيم_عليا_داخلية(
            &(*قيمة_الوحدة).العناصر, روابط_الوحدة, &متغير الأنواع, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := البداية;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ليكن مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[ف];
        ليكن قيمة_الوحدة: &وحدة_مصدر = مرجع_الوحدة;
        ليكن روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[ف];
        إذا (هل_واجهة_ملغاة(الإلغاء)) { أرجع نتيجة_بناء_سياقات_أنواع.ملغاة(); };
        ليكن أنواع_تعبيرات_الوحدة: متغير سياق_أنواع_تعبيرات = سياق_أنواع_تعبيرات_جديد();
        طابق ابن_تهيئات_قيم_عليا_داخلية(
            &(*قيمة_الوحدة).العناصر, سياق_الأسماء, &متغير الأنواع, &متغير أنواع_تعبيرات_الوحدة,
            روابط_الوحدة, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        طابق ابن_أجسام_الدوال_داخلية(
            &(*قيمة_الوحدة).العناصر, سياق_الأسماء, &متغير الأنواع, &متغير أنواع_تعبيرات_الوحدة,
            روابط_الوحدة, &متغير أنواع_الرموز
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_بناء_سياقات_أنواع.مرفوضة(الخطأ, الأنواع); }
        | اختياري.لا_شيء -> { };
        ألحق(أنواع_تعبيرات_الوحدات, أنواع_تعبيرات_الوحدة);
        ف := ف + 1;
    }

    ليكن الناتج: سياقات_أنواع_وحدة = {
        الأنواع: الأنواع,
        أنواع_التعبيرات: أنواع_تعبيرات_الوحدات,
        أنواع_الرموز: أنواع_الرموز,
        علاقات_هرم_الأنواع: علاقات_هرم_الأنواع
    };
    أرجع نتيجة_بناء_سياقات_أنواع.مبنية(الناتج);
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).
