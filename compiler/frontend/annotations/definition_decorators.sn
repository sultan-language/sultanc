استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.backend.target.target_model;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.parser.parser;
استورد compiler.frontend.parser.result;
استورد المكتبة.نصوص.من_بايتات;

// Definition-time decorators (Nahr item 22), which register a function when
// the program starts: `@@d(a1, ..., ak) def f` keeps f as
// written and generates
//
//   def مسجل_تعريف__<source>_<n>__f(): void { d(a1, ..., ak, f); }
//
// and the program's entry calls every such function once, before its own
// body, in the order the modules were loaded and the declarations appear
// (msir/semantic_lowering.sn, شغل_مسجلات_التعريف_مسير). The decorator is any
// function taking the arguments and the function value and returning
// nothing: a library's route table, a test registry, a command list
// (`@@get("/users")` adds the handler to a router's global table). Call-time
// decorators (`@d`) still wrap f; the function value passed here is the
// wrapped f.
//
// Like call-time decorators, the expansion is source text appended after the
// unit's text and parsed by the ordinary parser. A function that is generic,
// external or has compile-time parameters is left as written, and its
// annotation is reported as unsupported (SULTANC-ANNOTATION-UNSUPPORTED).

عرف ألحق_نطاق_لمسجل(الناتج: &متغير متجه ط8, الأصل: &متجه ط8, النطاق: نطاق): فراغ {
    ليكن ف: متغير طبيعي = النطاق.البداية.البايت;
    طالما (ف < (النطاق.النهاية.البايت مثل طبيعي) && ف < (الطول(*الأصل) مثل طبيعي)) {
        ألحق(*الناتج, (*الأصل)[ف]);
        ف := ف + 1;
    }
}

عرف ألحق_عددا_لمسجل(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    إذا (القيمة >= 10) { ألحق_عددا_لمسجل(الناتج, القيمة / 10); };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل ط8);
}

// The reserved prefix of a registration function's name.
عام عرف بادئة_مسجل_تعريف(): نص { أرجع «مسجل_تعريف__»; }

عرف دالة_بمسجلات_تعريف(الدالة: &تصريح_دالة): منطقي {
    إذا ((الطول((*الدالة).معاملات_النوع) مثل طبيعي) != 0) { أرجع خطأ; };
    طابق (*الدالة).الجسم مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        إذا ((*الدالة).المعاملات[ف].مطلوب_مسبقا) { أرجع خطأ; };
        ف := ف + 1;
    }
    ليكن س: متغير طبيعي = 0;
    طالما (س < (الطول((*الدالة).السمات) مثل طبيعي)) {
        إذا ((*الدالة).السمات[س].عند_التعريف) { أرجع صواب; };
        س := س + 1;
    }
    أرجع خطأ;
}

// `@@test` / `@@اختبار` marks a test (`sultanc test`, compiler/test_mode/):
// one built-in attribute with two spellings, no arguments. It is not a
// definition-time decorator (no function named test is called): the
// annotation leaves the declaration here, before registration and the type
// phase, so an ordinary build compiles the function as any other, never runs
// it and emits it only if something reaches it. Test mode finds the marked
// declarations by parsing the module's text with the same parser
// (test_mode/discovery.sn) and validates them there.
عام عرف سمة_اختبار(الأصل: &متجه ط8, السمة: &سمة_تصريح): منطقي {
    إذا (!(*السمة).عند_التعريف || (الطول((*السمة).المسار) مثل طبيعي) != 1
        || (الطول((*السمة).الحجج) مثل طبيعي) != 0) { أرجع خطأ; };
    ليكن النطاق: نطاق = (*السمة).المسار[0].النطاق;
    أرجع نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «test») || نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «اختبار»);
}

// `@@track_caller` / `@@يتتبع_المستدعي` marks a function whose last
// parameter is a std.debug.location source location that each call fills
// with its own place: one built-in attribute,
// no arguments. It leaves the declaration here and sets يتتبع_المستدعي; the
// Type pass checks the signature and the calls (types/semantic_pipeline.sn)
// and lowering passes the location (msir/lowering/caller_location.sn).
عام عرف سمة_يتتبع_المستدعي(الأصل: &متجه ط8, السمة: &سمة_تصريح): منطقي {
    إذا (!(*السمة).عند_التعريف || (الطول((*السمة).المسار) مثل طبيعي) != 1
        || (الطول((*السمة).الحجج) مثل طبيعي) != 0) { أرجع خطأ; };
    ليكن النطاق: نطاق = (*السمة).المسار[0].النطاق;
    أرجع نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «track_caller»)
        || نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «يتتبع_المستدعي»);
}

// `@@panic_handler` / `@@معالج_الانهيار` marks the program's panic handler,
// one built-in attribute, no arguments. The
// function takes the message (نص) and never returns; core's إنهيار calls it
// (msir/semantic_lowering.sn, اربط_معالج_الانهيار_مسير). std's,
// std.process.panic_handler, is bound by name; a program's own replaces it.
عام عرف سمة_معالج_الانهيار(الأصل: &متجه ط8, السمة: &سمة_تصريح): منطقي {
    إذا (!(*السمة).عند_التعريف || (الطول((*السمة).المسار) مثل طبيعي) != 1
        || (الطول((*السمة).الحجج) مثل طبيعي) != 0) { أرجع خطأ; };
    ليكن النطاق: نطاق = (*السمة).المسار[0].النطاق;
    أرجع نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «panic_handler»)
        || نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «معالج_الانهيار»);
}

// `@@c_abi` / `@@اصطلاح_سي` compiles the function with the C calling
// convention (Jisr gives every translated C function that convention): one
// built-in attribute, no arguments. C calls
// such a function directly at its address (بدائي_عنوان_دالة_سي), as a
// callback such as a qsort comparator or a window procedure.
عام عرف سمة_اتفاقية_سي(الأصل: &متجه ط8, السمة: &سمة_تصريح): منطقي {
    إذا (!(*السمة).عند_التعريف || (الطول((*السمة).المسار) مثل طبيعي) != 1
        || (الطول((*السمة).الحجج) مثل طبيعي) != 0) { أرجع خطأ; };
    ليكن النطاق: نطاق = (*السمة).المسار[0].النطاق;
    أرجع نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «c_abi»)
        || نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «اصطلاح_سي»);
}

// `@@global_alloc`, `@@global_realloc`, `@@global_dealloc` (`@@تخصيص_عام`,
// `@@إعادة_تخصيص_عام`, `@@تحرير_عام`) mark the global allocator's three
// entry points (library/core/memory/allocator.sn), the allocate, reallocate
// and release functions generated code calls: one built-in attribute each, no arguments. The
// result is the entry point (1, 2, 3), or 0. std's are std.os.
// allocation_cache's; a program that marks its own replaces them.
عام عرف دور_سمة_المخصص(الأصل: &متجه ط8, السمة: &سمة_تصريح): ط8 {
    إذا (!(*السمة).عند_التعريف || (الطول((*السمة).المسار) مثل طبيعي) != 1
        || (الطول((*السمة).الحجج) مثل طبيعي) != 0) { أرجع 0; };
    ليكن النطاق: نطاق = (*السمة).المسار[0].النطاق;
    إذا (نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «global_alloc»)
        || نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «تخصيص_عام»)) { أرجع 1; };
    إذا (نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «global_realloc»)
        || نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «إعادة_تخصيص_عام»)) { أرجع 2; };
    إذا (نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «global_dealloc»)
        || نطاق_يساوي_نصا_لمسجل(الأصل, النطاق, «تحرير_عام»)) { أرجع 3; };
    أرجع 0;
}

عرف سمات_دالة_بلا_مدمجة(
    الأصل: &متجه ط8, السمات: &متجه سمة_تصريح, اختبار: &متغير منطقي, يتتبع: &متغير منطقي,
    معالج: &متغير منطقي, دور: &متغير ط8, اتفاقية: &متغير منطقي
): متجه سمة_تصريح {
    ليكن الباقية: متغير متجه سمة_تصريح = [];
    ليكن س: متغير طبيعي = 0;
    طالما (س < (الطول(*السمات) مثل طبيعي)) {
        إذا (سمة_اختبار(الأصل, &(*السمات)[س])) {
            *اختبار := صواب;
        } وإلا إذا (سمة_يتتبع_المستدعي(الأصل, &(*السمات)[س])) {
            *يتتبع := صواب;
        } وإلا إذا (سمة_معالج_الانهيار(الأصل, &(*السمات)[س])) {
            *معالج := صواب;
        } وإلا إذا (سمة_اتفاقية_سي(الأصل, &(*السمات)[س])) {
            *اتفاقية := صواب;
        } وإلا إذا (دور_سمة_المخصص(الأصل, &(*السمات)[س]) != 0) {
            // Two entry points on one function: 255, which binds none
            // and is reported (msir/semantic_lowering.sn).
            إذا (*دور != 0) { *دور := 255; } وإلا { *دور := دور_سمة_المخصص(الأصل, &(*السمات)[س]); };
        } وإلا {
            ألحق(الباقية, انسخ_مملوكا_سمة_تصريح(&(*السمات)[س]));
        };
        س := س + 1;
    }
    أرجع الباقية;
}

عرف نطاق_يساوي_نصا_لمسجل(الأصل: &متجه ط8, النطاق: نطاق, المطلوب: نص): منطقي {
    ليكن البداية: طبيعي = النطاق.البداية.البايت مثل طبيعي;
    ليكن النهاية: طبيعي = النطاق.النهاية.البايت مثل طبيعي;
    ليكن الطول_المطلوب: طبيعي = الطول(المطلوب) مثل طبيعي;
    إذا (النهاية < البداية || النهاية - البداية != الطول_المطلوب
        || النهاية > (الطول(*الأصل) مثل طبيعي)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الطول_المطلوب) {
        إذا ((*الأصل)[البداية + ف] != المطلوب[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف سمات_بلا_اختبار(الأصل: &متجه ط8, السمات: &متجه سمة_تصريح, اختبار: &متغير منطقي): متجه سمة_تصريح {
    ليكن الباقية: متغير متجه سمة_تصريح = [];
    ليكن س: متغير طبيعي = 0;
    طالما (س < (الطول(*السمات) مثل طبيعي)) {
        إذا (سمة_اختبار(الأصل, &(*السمات)[س])) {
            *اختبار := صواب;
        } وإلا {
            ألحق(الباقية, انسخ_مملوكا_سمة_تصريح(&(*السمات)[س]));
        };
        س := س + 1;
    }
    أرجع الباقية;
}

// Removes the test annotations of one unit's declarations (functions, types
// and module values: test mode reports the misplaced ones), and the
// track-caller annotations of its functions (elsewhere one stays and is
// reported as unsupported).
عرف اطرح_سمات_الاختبار_وحدة(الشجرة: &متغير وحدة_مصدر, الأصل: &متجه ط8): فراغ {
    ليكن الجديدة: متغير متجه عنصر_وحدة = [];
    ليكن يوجد: متغير منطقي = خطأ;
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        ليكن مرجع_العنصر: &عنصر_وحدة = &(*الشجرة).العناصر[ع];
        ليكن النسخة: متغير عنصر_وحدة = انسخ_مملوكا_عنصر_وحدة(مرجع_العنصر);
        طابق النسخة مع
        | عنصر_وحدة.دالة(الدالة) -> {
            ليكن المعدلة: متغير تصريح_دالة = انسخ_مملوكا_تصريح_دالة(&الدالة);
            ليكن يتتبع: متغير منطقي = خطأ;
            ليكن معالج: متغير منطقي = خطأ;
            ليكن دور: متغير ط8 = 0;
            ليكن اتفاقية: متغير منطقي = خطأ;
            المعدلة.السمات := سمات_دالة_بلا_مدمجة(
                الأصل, &الدالة.السمات, &متغير يوجد, &متغير يتتبع, &متغير معالج, &متغير دور, &متغير اتفاقية
            );
            إذا (اتفاقية) {
                المعدلة.اتفاقية_سي := صواب;
                يوجد := صواب;
            };
            إذا (دور != 0) {
                المعدلة.دور_المخصص := دور;
                يوجد := صواب;
            };
            إذا (يتتبع) {
                المعدلة.يتتبع_المستدعي := صواب;
                يوجد := صواب;
            };
            إذا (معالج) {
                المعدلة.معالج_الانهيار := صواب;
                يوجد := صواب;
            };
            ألحق(الجديدة, عنصر_وحدة.دالة(المعدلة));
        }
        | عنصر_وحدة.نوع(التصريح) -> {
            ليكن المعدل: متغير تصريح_نوع = انسخ_مملوكا_تصريح_نوع(&التصريح);
            المعدل.السمات := سمات_بلا_اختبار(الأصل, &التصريح.السمات, &متغير يوجد);
            ألحق(الجديدة, عنصر_وحدة.نوع(المعدل));
        }
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            ليكن المعدلة: متغير تصريح_قيمة_عليا = انسخ_مملوكا_تصريح_قيمة_عليا(&التصريح);
            المعدلة.السمات := سمات_بلا_اختبار(الأصل, &التصريح.السمات, &متغير يوجد);
            ألحق(الجديدة, عنصر_وحدة.قيمة_عليا(المعدلة));
        }
        | _ -> { ألحق(الجديدة, النسخة); };
        ع := ع + 1;
    }
    إذا (يوجد) { (*الشجرة).العناصر := الجديدة; };
}

// Whether any declaration of the unit has a `@@` annotation (so the cheap
// common case, none, copies nothing).
عرف يحتوي_سمة_تعريف_وحدة(الشجرة: &وحدة_مصدر): منطقي {
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> { إذا (سمات_تعريف_فيها(&الدالة.السمات)) { أرجع صواب; }; }
        | عنصر_وحدة.نوع(التصريح) -> { إذا (سمات_تعريف_فيها(&التصريح.السمات)) { أرجع صواب; }; }
        | عنصر_وحدة.قيمة_عليا(التصريح) -> { إذا (سمات_تعريف_فيها(&التصريح.السمات)) { أرجع صواب; }; }
        | _ -> { };
        ع := ع + 1;
    }
    أرجع خطأ;
}

عرف سمات_تعريف_فيها(السمات: &متجه سمة_تصريح): منطقي {
    ليكن س: متغير طبيعي = 0;
    طالما (س < (الطول(*السمات) مثل طبيعي)) {
        إذا ((*السمات)[س].عند_التعريف) { أرجع صواب; };
        س := س + 1;
    }
    أرجع خطأ;
}

// Generates the registration functions of one unit and removes the
// definition-time annotations they consumed. Returns خطأ only when the
// generated text fails to lex or parse (a compiler fault).
عام عرف وسع_مسجلات_تعريف_وحدة(
    الشجرة: &متغير وحدة_مصدر,
    سياق_المصادر: &متغير خريطة_مصادر,
    المصدر: &مصدر,
    الهدف: &اختياري واصف_هدف
): منطقي {
    // Test annotations first: they register nothing.
    ليكن مرجع_محتوى_الاختبار: &نص = &(*المصدر).المحتوى;
    إذا (يحتوي_سمة_تعريف_وحدة(الشجرة)) {
        ليكن أصل_الاختبار: متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_محتوى_الاختبار));
        اطرح_سمات_الاختبار_وحدة(الشجرة, &أصل_الاختبار);
    };
    ليكن يوجد: متغير منطقي = خطأ;
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> { إذا (دالة_بمسجلات_تعريف(&الدالة)) { يوجد := صواب; }; }
        | _ -> { };
        ع := ع + 1;
    }
    إذا (!يوجد) { أرجع صواب; };

    ليكن مرجع_المحتوى: &نص = &(*المصدر).المحتوى;
    ليكن الأصل: متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_المحتوى));
    ليكن المولد: متغير متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_المحتوى));
    ألحق_بايتات_نص(&متغير المولد, "\n// SultanC definition-time decorators (frontend/annotations/definition_decorators.sn)\n");
    ليكن بداية_المولد: طبيعي = الطول(المولد) مثل طبيعي;
    ليكن الرقم: متغير طبيعي = 0;
    ع := 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            إذا (دالة_بمسجلات_تعريف(&الدالة)) {
                ليكن س: متغير طبيعي = 0;
                طالما (س < (الطول(الدالة.السمات) مثل طبيعي)) {
                    ليكن السمة: &سمة_تصريح = &الدالة.السمات[س];
                    إذا ((*السمة).عند_التعريف) {
                        ألحق_بايتات_نص(&متغير المولد, «عرف »);
                        ألحق_بايتات_نص(&متغير المولد, بادئة_مسجل_تعريف());
                        ألحق_عددا_لمسجل(&متغير المولد, (*المصدر).المعرف);
                        ألحق_بايتات_نص(&متغير المولد, «_»);
                        ألحق_عددا_لمسجل(&متغير المولد, الرقم);
                        ألحق_بايتات_نص(&متغير المولد, «__»);
                        ألحق_نطاق_لمسجل(&متغير المولد, &الأصل, الدالة.الاسم.النطاق);
                        ألحق_بايتات_نص(&متغير المولد, "(): فراغ {\n    ");
                        ليكن م: متغير طبيعي = 0;
                        طالما (م < (الطول((*السمة).المسار) مثل طبيعي)) {
                            إذا (م > 0) { ألحق_بايتات_نص(&متغير المولد, «.»); };
                            ألحق_نطاق_لمسجل(&متغير المولد, &الأصل, (*السمة).المسار[م].النطاق);
                            م := م + 1;
                        }
                        ألحق_بايتات_نص(&متغير المولد, «(»);
                        ليكن ح: متغير طبيعي = 0;
                        طالما (ح < (الطول((*السمة).الحجج) مثل طبيعي)) {
                            ألحق_نطاق_لمسجل(&متغير المولد, &الأصل, نطاق_تعبير(&(*السمة).الحجج[ح]));
                            ألحق_بايتات_نص(&متغير المولد, «, »);
                            ح := ح + 1;
                        }
                        ألحق_نطاق_لمسجل(&متغير المولد, &الأصل, الدالة.الاسم.النطاق);
                        ألحق_بايتات_نص(&متغير المولد, ");\n}\n");
                        الرقم := الرقم + 1;
                    };
                    س := س + 1;
                }
            };
        }
        | _ -> { };
        ع := ع + 1;
    }

    ليكن مرجع_الاسم: &نص = &(*المصدر).الاسم;
    ليكن الممدد: مصدر = مصدر_جديد((*المصدر).المعرف, انسخ_نص(مرجع_الاسم), من_بايتات(&المولد));
    ليكن الرموز_المولدة: متغير متجه رمز_مصدر = [];
    طابق حلل_معجميا(&الممدد) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { أرجع خطأ; }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < (الطول(السلسلة.الرموز) مثل طبيعي)) {
            إذا ((السلسلة.الرموز[ر].النطاق.البداية.البايت مثل طبيعي) >= بداية_المولد) {
                ليكن مرجع_الرمز: &رمز_مصدر = &السلسلة.الرموز[ر];
                ألحق(الرموز_المولدة, انسخ_مملوكا_رمز_مصدر(مرجع_الرمز));
            };
            ر := ر + 1;
        }
    };
    ليكن المولدة: متغير متجه عنصر_وحدة = [];
    طابق حلل_الرموز_لهدف(&الممدد, &الرموز_المولدة, الهدف) مع
    | نتيجة_تحليل.شجرة(الوحدة) -> {
        ليكن الوحدة_المولدة: متغير وحدة_مصدر = الوحدة;
        بدّل(المولدة, الوحدة_المولدة.العناصر);
    }
    | _ -> { أرجع خطأ; };

    // The consumed annotations leave their functions; the registration
    // functions follow the unit's own items.
    ليكن الجديدة: متغير متجه عنصر_وحدة = [];
    ع := 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        ليكن مرجع_العنصر: &عنصر_وحدة = &(*الشجرة).العناصر[ع];
        ليكن النسخة: متغير عنصر_وحدة = انسخ_مملوكا_عنصر_وحدة(مرجع_العنصر);
        طابق النسخة مع
        | عنصر_وحدة.دالة(الدالة) -> {
            إذا (دالة_بمسجلات_تعريف(&الدالة)) {
                ليكن المعدلة: متغير تصريح_دالة = انسخ_مملوكا_تصريح_دالة(&الدالة);
                ليكن الباقية: متغير متجه سمة_تصريح = [];
                ليكن س: متغير طبيعي = 0;
                طالما (س < (الطول(الدالة.السمات) مثل طبيعي)) {
                    إذا (!الدالة.السمات[س].عند_التعريف) {
                        ألحق(الباقية, انسخ_مملوكا_سمة_تصريح(&الدالة.السمات[س]));
                    };
                    س := س + 1;
                }
                المعدلة.السمات := الباقية;
                ألحق(الجديدة, عنصر_وحدة.دالة(المعدلة));
            } وإلا {
                ألحق(الجديدة, عنصر_وحدة.دالة(الدالة));
            };
        }
        | _ -> { ألحق(الجديدة, النسخة); };
        ع := ع + 1;
    }
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول(المولدة) مثل طبيعي)) {
        ليكن مرجع_المولد: &عنصر_وحدة = &المولدة[م];
        ألحق(الجديدة, انسخ_مملوكا_عنصر_وحدة(مرجع_المولد));
        م := م + 1;
    }
    (*الشجرة).العناصر := الجديدة;
    أرجع مدد_محتوى_مصدر_في_خريطة(سياق_المصادر, (*المصدر).المعرف, من_بايتات(&المولد));
}
