// Definition-time decorators (Nahr item 22), as Python's decorators that
// register a function and Go's init: `@@d(a1, ..., ak) def f` keeps f as
// written and generates
//
//   def مسجل_تعريف__<source>_<n>__f(): void { d(a1, ..., ak, f); }
//
// and the program's entry calls every such function once, before its own
// body, in the order the modules were loaded and the declarations appear
// (msir/semantic_lowering.sn, شغل_مسجلات_التعريف_مسير). The decorator is any
// function taking the arguments and the function value and returning
// nothing: a library's route table, a test registry, a command list
// (`@@get("/users")` adds the handler to a router's global table). Call-time
// decorators (`@d`) still wrap f; the function value passed here is the
// wrapped f.
//
// Like call-time decorators, the expansion is source text appended after the
// unit's text and parsed by the ordinary parser. A function that is generic,
// external or has compile-time parameters is left as written, and its
// annotation is reported as unsupported (SULTANC-ANNOTATION-UNSUPPORTED).

عرف ألحق_نطاق_لمسجل(الناتج: &متغير متجه ط8, الأصل: &متجه ط8, النطاق: نطاق): فراغ {
    دع ف: متغير طبيعي = النطاق.البداية.البايت;
    طالما (ف < (النطاق.النهاية.البايت مثل طبيعي) && ف < (الطول(*الأصل) مثل طبيعي)) {
        ألحق(*الناتج, (*الأصل)[ف]);
        ف := ف + 1;
    }
}

عرف ألحق_عددا_لمسجل(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    إذا (القيمة >= 10) { ألحق_عددا_لمسجل(الناتج, القيمة / 10); };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل ط8);
}

// The reserved prefix of a registration function's name.
عام عرف بادئة_مسجل_تعريف(): نص { أرجع «مسجل_تعريف__»; }

عرف دالة_بمسجلات_تعريف(الدالة: &تصريح_دالة): منطقي {
    إذا ((الطول((*الدالة).معاملات_النوع) مثل طبيعي) != 0) { أرجع خطأ; };
    طابق (*الدالة).الجسم مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        إذا ((*الدالة).المعاملات[ف].مطلوب_مسبقا) { أرجع خطأ; };
        ف := ف + 1;
    }
    دع س: متغير طبيعي = 0;
    طالما (س < (الطول((*الدالة).السمات) مثل طبيعي)) {
        إذا ((*الدالة).السمات[س].عند_التعريف) { أرجع صواب; };
        س := س + 1;
    }
    أرجع خطأ;
}

// Generates the registration functions of one unit and removes the
// definition-time annotations they consumed. Returns خطأ only when the
// generated text fails to lex or parse (a compiler fault).
عام عرف وسع_مسجلات_تعريف_وحدة(
    الشجرة: &متغير وحدة_مصدر,
    سياق_المصادر: &متغير خريطة_مصادر,
    المصدر: &مصدر,
    الهدف: &اختياري واصف_هدف
): منطقي {
    دع يوجد: متغير منطقي = خطأ;
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> { إذا (دالة_بمسجلات_تعريف(&الدالة)) { يوجد := صواب; }; }
        | _ -> { };
        ع := ع + 1;
    }
    إذا (!يوجد) { أرجع صواب; };

    دع مرجع_المحتوى: &نص = &(*المصدر).المحتوى;
    دع الأصل: متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_المحتوى));
    دع المولد: متغير متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_المحتوى));
    ألحق_بايتات_نص(&متغير المولد, "\n// SultanC definition-time decorators (frontend/annotations/definition_decorators.sn)\n");
    دع بداية_المولد: طبيعي = الطول(المولد) مثل طبيعي;
    دع الرقم: متغير طبيعي = 0;
    ع := 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            إذا (دالة_بمسجلات_تعريف(&الدالة)) {
                دع س: متغير طبيعي = 0;
                طالما (س < (الطول(الدالة.السمات) مثل طبيعي)) {
                    دع السمة: &سمة_تصريح = &الدالة.السمات[س];
                    إذا ((*السمة).عند_التعريف) {
                        ألحق_بايتات_نص(&متغير المولد, «عرف »);
                        ألحق_بايتات_نص(&متغير المولد, بادئة_مسجل_تعريف());
                        ألحق_عددا_لمسجل(&متغير المولد, (*المصدر).المعرف);
                        ألحق_بايتات_نص(&متغير المولد, «_»);
                        ألحق_عددا_لمسجل(&متغير المولد, الرقم);
                        ألحق_بايتات_نص(&متغير المولد, «__»);
                        ألحق_نطاق_لمسجل(&متغير المولد, &الأصل, الدالة.الاسم.النطاق);
                        ألحق_بايتات_نص(&متغير المولد, "(): فراغ {\n    ");
                        دع م: متغير طبيعي = 0;
                        طالما (م < (الطول((*السمة).المسار) مثل طبيعي)) {
                            إذا (م > 0) { ألحق_بايتات_نص(&متغير المولد, «.»); };
                            ألحق_نطاق_لمسجل(&متغير المولد, &الأصل, (*السمة).المسار[م].النطاق);
                            م := م + 1;
                        }
                        ألحق_بايتات_نص(&متغير المولد, «(»);
                        دع ح: متغير طبيعي = 0;
                        طالما (ح < (الطول((*السمة).الحجج) مثل طبيعي)) {
                            ألحق_نطاق_لمسجل(&متغير المولد, &الأصل, نطاق_تعبير(&(*السمة).الحجج[ح]));
                            ألحق_بايتات_نص(&متغير المولد, «, »);
                            ح := ح + 1;
                        }
                        ألحق_نطاق_لمسجل(&متغير المولد, &الأصل, الدالة.الاسم.النطاق);
                        ألحق_بايتات_نص(&متغير المولد, ");\n}\n");
                        الرقم := الرقم + 1;
                    };
                    س := س + 1;
                }
            };
        }
        | _ -> { };
        ع := ع + 1;
    }

    دع مرجع_الاسم: &نص = &(*المصدر).الاسم;
    دع الممدد: مصدر = مصدر_جديد((*المصدر).المعرف, انسخ_نص(مرجع_الاسم), من_بايتات(&المولد));
    دع الرموز_المولدة: متغير متجه رمز_مصدر = [];
    طابق حلل_معجميا(&الممدد) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { أرجع خطأ; }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(السلسلة.الرموز) مثل طبيعي)) {
            إذا ((السلسلة.الرموز[ر].النطاق.البداية.البايت مثل طبيعي) >= بداية_المولد) {
                دع مرجع_الرمز: &رمز_مصدر = &السلسلة.الرموز[ر];
                ألحق(الرموز_المولدة, انسخ_مملوكا_رمز_مصدر(مرجع_الرمز));
            };
            ر := ر + 1;
        }
    };
    دع المولدة: متغير متجه عنصر_وحدة = [];
    طابق حلل_الرموز_لهدف(&الممدد, &الرموز_المولدة, الهدف) مع
    | نتيجة_تحليل.شجرة(الوحدة) -> {
        دع الوحدة_المولدة: متغير وحدة_مصدر = الوحدة;
        بدّل(المولدة, الوحدة_المولدة.العناصر);
    }
    | _ -> { أرجع خطأ; };

    // The consumed annotations leave their functions; the registration
    // functions follow the unit's own items.
    دع الجديدة: متغير متجه عنصر_وحدة = [];
    ع := 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        دع مرجع_العنصر: &عنصر_وحدة = &(*الشجرة).العناصر[ع];
        دع النسخة: متغير عنصر_وحدة = انسخ_مملوكا_عنصر_وحدة(مرجع_العنصر);
        طابق النسخة مع
        | عنصر_وحدة.دالة(الدالة) -> {
            إذا (دالة_بمسجلات_تعريف(&الدالة)) {
                دع المعدلة: متغير تصريح_دالة = انسخ_مملوكا_تصريح_دالة(&الدالة);
                دع الباقية: متغير متجه سمة_تصريح = [];
                دع س: متغير طبيعي = 0;
                طالما (س < (الطول(الدالة.السمات) مثل طبيعي)) {
                    إذا (!الدالة.السمات[س].عند_التعريف) {
                        ألحق(الباقية, انسخ_مملوكا_سمة_تصريح(&الدالة.السمات[س]));
                    };
                    س := س + 1;
                }
                المعدلة.السمات := الباقية;
                ألحق(الجديدة, عنصر_وحدة.دالة(المعدلة));
            } وإلا {
                ألحق(الجديدة, عنصر_وحدة.دالة(الدالة));
            };
        }
        | _ -> { ألحق(الجديدة, النسخة); };
        ع := ع + 1;
    }
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(المولدة) مثل طبيعي)) {
        دع مرجع_المولد: &عنصر_وحدة = &المولدة[م];
        ألحق(الجديدة, انسخ_مملوكا_عنصر_وحدة(مرجع_المولد));
        م := م + 1;
    }
    (*الشجرة).العناصر := الجديدة;
    أرجع مدد_محتوى_مصدر_في_خريطة(سياق_المصادر, (*المصدر).المعرف, من_بايتات(&المولد));
}
