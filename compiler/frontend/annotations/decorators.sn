استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.backend.target.target_model;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.parser.parser;
استورد compiler.frontend.parser.result;
استورد std.text.from_bytes;

// Function decorators (AT-01..AT-04). A decorator is an ordinary function
// applied to the decorated function at its definition, as in Python
// (`@d def f` binds f to d applied to f), but resolved and type-checked
// statically and with the decorated function passed as a value:
//
//   @d(a1, ..., ak) def f(x1: T1, ..., xn: Tn): R { body }
//
// defines the original function under a hidden name H and binds f to
//
//   def f(y1: T1, ..., yn: Tn): R { return d(a1, ..., ak, H, y1, ..., yn); }
//
// (no `return` for a void R). With several decorators the one nearest the
// declaration applies first: `@a @b def f` binds f to a applied to (b applied
// to f). The decorator is resolved like any call target (a plain or a
// namespaced name), and the call is checked like any call: d's parameters
// must accept the decorator arguments, a function value of the decorated
// function's type `fn(T1, ..., Tn): R`, and the same arguments, and d must
// return R. Ownership and borrows of the arguments follow the decorated
// function's own parameter types. Declaring d's function parameter `comptime`
// makes every application a compile-time specialization of d with a direct
// function value (driver/compile_time.sn), where d may also validate its
// compile-time arguments (comptime blocks, std.meta.reflect, compile_error).
//
// The expansion is source text: the wrappers are generated as SultanC text
// appended after the unit's own text in the source map and parsed by the
// ordinary parser, so every generated name and expression has its own source
// position and every later phase sees ordinary declarations. The original
// declaration keeps its own positions; only its name is the hidden one.
// Decorator arguments are evaluated at each call of f, in the wrapper (whose
// parameters have generated names, so they never capture an argument's names).
//
// Not expanded, and so rejected by the type phase as SULTANC-ANNOTATION-
// UNSUPPORTED: annotations on types and module values, and on functions that
// are external (no body), generic, or have compile-time parameters.
// Registration-style processing (routes, tests, caches) is not compiler
// behaviour; libraries express it through such decorators or ordinary code.

عرف ألحق_نطاق_مصدر_لمزخرف(
    الناتج: &متغير متجه غ8,
    الأصل: &متجه غ8,
    النطاق: نطاق
): فراغ {
    دع ف: متغير غير_موقع = النطاق.البداية.البايت;
    بينما (ف < النطاق.النهاية.البايت && ف < (الطول(*الأصل) مثل غير_موقع)) {
        ألحق(*الناتج, (*الأصل)[ف]);
        ف := ف + 1;
    }
}

عرف ألحق_عددا_لمزخرف(الناتج: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    لو (القيمة >= 10) { ألحق_عددا_لمزخرف(الناتج, القيمة / 10); };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل غ8);
}

// The hidden name of decorator layer الطبقة of a function (layer 0 is the
// public name itself): letters of the function's own name after a reserved
// prefix, so it is an ordinary identifier no source declares.
عرف ألحق_اسما_مخفيا_لمزخرف(
    الناتج: &متغير متجه غ8,
    الأصل: &متجه غ8,
    الدالة: &تصريح_دالة,
    الطبقة: غير_موقع
): فراغ {
    ألحق_بايتات_نص(الناتج, «مزخرف__»);
    ألحق_عددا_لمزخرف(الناتج, الطبقة);
    ألحق_بايتات_نص(الناتج, «__»);
    ألحق_نطاق_مصدر_لمزخرف(الناتج, الأصل, (*الدالة).الاسم.النطاق);
}

عرف دالة_مزخرفة_قابلة_للتوسيع(الدالة: &تصريح_دالة): منطقي {
    لو ((الطول((*الدالة).السمات) مثل غير_موقع) == 0) { أرجع خطأ; };
    لو ((الطول((*الدالة).معاملات_النوع) مثل غير_موقع) != 0) { أرجع خطأ; };
    طابق (*الدالة).الجسم مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(_) -> { };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الدالة).المعاملات) مثل غير_موقع)) {
        لو ((*الدالة).المعاملات[ف].مطلوب_مسبقا) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ناتج_دالة_فراغ_لمزخرف(الدالة: &تصريح_دالة): منطقي {
    طابق (*الدالة).الناتج مع
    | نوع_تركيبي.فراغ(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف ألحق_اسم_معامل_مولد(الناتج: &متغير متجه غ8, الفهرس: غير_موقع): فراغ {
    ألحق_بايتات_نص(الناتج, «معامل_مزخرف__»);
    ألحق_عددا_لمزخرف(الناتج, الفهرس);
}

// One decorator layer: `def <name>(<params>): <R> { [return] <d>(<args>, <inner>, <params>); }`.
عرف ألحق_طبقة_مزخرف(
    الناتج: &متغير متجه غ8,
    الأصل: &متجه غ8,
    الدالة: &تصريح_دالة,
    الطبقة: غير_موقع
): فراغ {
    دع السمة: &سمة_تصريح = &(*الدالة).السمات[الطبقة];
    ألحق_بايتات_نص(الناتج, «عرف »);
    لو (الطبقة == 0) {
        ألحق_نطاق_مصدر_لمزخرف(الناتج, الأصل, (*الدالة).الاسم.النطاق);
    } وإلا {
        ألحق_اسما_مخفيا_لمزخرف(الناتج, الأصل, الدالة, الطبقة);
    };
    ألحق_بايتات_نص(الناتج, «(»);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الدالة).المعاملات) مثل غير_موقع)) {
        لو (ف > 0) { ألحق_بايتات_نص(الناتج, «, »); };
        ألحق_اسم_معامل_مولد(الناتج, ف);
        ألحق_بايتات_نص(الناتج, «: »);
        ألحق_نطاق_مصدر_لمزخرف(
            الناتج, الأصل, نطاق_نوع_تركيبي(&(*الدالة).المعاملات[ف].النوع)
        );
        ف := ف + 1;
    }
    ألحق_بايتات_نص(الناتج, «): »);
    دع فراغ_الناتج: منطقي = ناتج_دالة_فراغ_لمزخرف(الدالة);
    لو (فراغ_الناتج) {
        ألحق_بايتات_نص(الناتج, «فراغ»);
    } وإلا {
        ألحق_نطاق_مصدر_لمزخرف(الناتج, الأصل, نطاق_نوع_تركيبي(&(*الدالة).الناتج));
    };
    ألحق_بايتات_نص(الناتج, " {\n    ");
    لو (!فراغ_الناتج) { ألحق_بايتات_نص(الناتج, «أرجع »); };
    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول((*السمة).المسار) مثل غير_موقع)) {
        لو (م > 0) { ألحق_بايتات_نص(الناتج, «.»); };
        ألحق_نطاق_مصدر_لمزخرف(الناتج, الأصل, (*السمة).المسار[م].النطاق);
        م := م + 1;
    }
    ألحق_بايتات_نص(الناتج, «(»);
    دع ح: متغير غير_موقع = 0;
    بينما (ح < (الطول((*السمة).الحجج) مثل غير_موقع)) {
        ألحق_نطاق_مصدر_لمزخرف(الناتج, الأصل, نطاق_تعبير(&(*السمة).الحجج[ح]));
        ألحق_بايتات_نص(الناتج, «, »);
        ح := ح + 1;
    }
    ألحق_اسما_مخفيا_لمزخرف(الناتج, الأصل, الدالة, الطبقة + 1);
    ف := 0;
    بينما (ف < (الطول((*الدالة).المعاملات) مثل غير_موقع)) {
        ألحق_بايتات_نص(الناتج, «, »);
        ألحق_اسم_معامل_مولد(الناتج, ف);
        ف := ف + 1;
    }
    ألحق_بايتات_نص(الناتج, ");\n}\n");
}

// Expands every decorated function of one parsed unit. Returns خطأ only when
// the generated text fails to lex or parse, which is a compiler fault: it is
// built from already-parsed source pieces.
عام عرف وسع_مزخرفات_وحدة(
    الشجرة: &متغير وحدة_مصدر,
    سياق_المصادر: &متغير خريطة_مصادر,
    المصدر: &مصدر,
    الهدف: &اختيار واصف_هدف
): منطقي {
    دع يوجد: متغير منطقي = خطأ;
    دع ع: متغير غير_موقع = 0;
    بينما (ع < (الطول((*الشجرة).العناصر) مثل غير_موقع)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            لو (دالة_مزخرفة_قابلة_للتوسيع(&الدالة)) { يوجد := صواب; };
        }
        | _ -> { };
        ع := ع + 1;
    }
    لو (!يوجد) { أرجع صواب; };

    دع مرجع_المحتوى: &نص = &(*المصدر).المحتوى;
    دع الأصل: متجه غ8 = بايتات_من_نص(*مرجع_المحتوى);
    دع المولد: متغير متجه غ8 = بايتات_من_نص(*مرجع_المحتوى);
    ألحق_بايتات_نص(&متغير المولد, "\n// SultanC decorator expansion (frontend/annotations/decorators.sn)\n");
    دع بداية_المولد: غير_موقع = الطول(المولد) مثل غير_موقع;
    // The declaration name of each expanded original: its hidden innermost
    // name, written once in a comment so that it has a source position.
    دع أسماء_الأصول: متغير متجه نطاق = [];
    ع := 0;
    بينما (ع < (الطول((*الشجرة).العناصر) مثل غير_موقع)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            لو (دالة_مزخرفة_قابلة_للتوسيع(&الدالة)) {
                دع عدد_الطبقات: غير_موقع = الطول(الدالة.السمات) مثل غير_موقع;
                ألحق_بايتات_نص(&متغير المولد, «// »);
                دع البداية: غير_موقع = الطول(المولد) مثل غير_موقع;
                ألحق_اسما_مخفيا_لمزخرف(&متغير المولد, &الأصل, &الدالة, عدد_الطبقات);
                دع النهاية: غير_موقع = الطول(المولد) مثل غير_موقع;
                ألحق_بايتات_نص(&متغير المولد, "\n");
                دع موضع_البداية: موضع = { المصدر: (*المصدر).المعرف, البايت: البداية };
                دع موضع_النهاية: موضع = { المصدر: (*المصدر).المعرف, البايت: النهاية };
                ألحق(أسماء_الأصول, نطاق_بين(موضع_البداية, موضع_النهاية));
                دع ط: متغير غير_موقع = 0;
                بينما (ط < عدد_الطبقات) {
                    ألحق_طبقة_مزخرف(&متغير المولد, &الأصل, &الدالة, ط);
                    ط := ط + 1;
                }
            };
        }
        | _ -> { };
        ع := ع + 1;
    }

    دع مرجع_الاسم: &نص = &(*المصدر).الاسم;
    دع الممدد: مصدر = مصدر_جديد(
        (*المصدر).المعرف, *مرجع_الاسم, من_بايتات(&المولد)
    );
    دع الرموز_المولدة: متغير متجه رمز_مصدر = [];
    طابق حلل_معجميا(&الممدد) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { أرجع خطأ; }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        دع ر: متغير غير_موقع = 0;
        بينما (ر < (الطول(السلسلة.الرموز) مثل غير_موقع)) {
            لو (السلسلة.الرموز[ر].النطاق.البداية.البايت >= بداية_المولد) {
                دع مرجع_الرمز: &رمز_مصدر = &السلسلة.الرموز[ر];
                ألحق(الرموز_المولدة, *مرجع_الرمز);
            };
            ر := ر + 1;
        }
    };
    دع المولدة: متغير متجه عنصر_وحدة = [];
    طابق حلل_الرموز_لهدف(&الممدد, &الرموز_المولدة, الهدف) مع
    | نتيجة_تحليل.شجرة(الوحدة) -> {
        دع الوحدة_المولدة: متغير وحدة_مصدر = الوحدة;
        بدّل(المولدة, الوحدة_المولدة.العناصر);
    }
    | _ -> { أرجع خطأ; };

    // Splice: each expanded original (renamed, private, without its
    // annotations and aliases) is followed by its layers; layer 0 takes the
    // public name, visibility and aliases.
    دع الجديدة: متغير متجه عنصر_وحدة = [];
    دع التالية: متغير غير_موقع = 0;
    دع رقم_الأصل: متغير غير_موقع = 0;
    ع := 0;
    بينما (ع < (الطول((*الشجرة).العناصر) مثل غير_موقع)) {
        دع موسع: متغير منطقي = خطأ;
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            لو (دالة_مزخرفة_قابلة_للتوسيع(&الدالة)) {
                موسع := صواب;
                دع عدد_الطبقات: غير_موقع = الطول(الدالة.السمات) مثل غير_موقع;
                لو (رقم_الأصل >= (الطول(أسماء_الأصول) مثل غير_موقع)
                    || التالية + عدد_الطبقات > (الطول(المولدة) مثل غير_موقع)) {
                    أرجع خطأ;
                };
                دع الأصلية: متغير تصريح_دالة = الدالة;
                دع اسم_مخفي: اسم = {
                    النطاق: أسماء_الأصول[رقم_الأصل],
                    الصنف: صنف_اسم_تركيبي.عادي()
                };
                دع العلنية: منطقي = الأصلية.علني;
                دع بلا_سمات: متجه سمة_تصريح = [];
                دع البدائل: متغير متجه اسم = [];
                بدّل(الأصلية.الأسماء_البديلة, البدائل);
                الأصلية.الاسم := اسم_مخفي;
                الأصلية.السمات := بلا_سمات;
                الأصلية.علني := خطأ;
                ألحق(الجديدة, عنصر_وحدة.دالة(الأصلية));
                دع ط: متغير غير_موقع = 0;
                بينما (ط < عدد_الطبقات) {
                    طابق المولدة[التالية + ط] مع
                    | عنصر_وحدة.دالة(الطبقة) -> {
                        دع الطبقة_المعدلة: متغير تصريح_دالة = الطبقة;
                        لو (ط == 0) {
                            الطبقة_المعدلة.علني := العلنية;
                            بدّل(الطبقة_المعدلة.الأسماء_البديلة, البدائل);
                        };
                        ألحق(الجديدة, عنصر_وحدة.دالة(الطبقة_المعدلة));
                    }
                    | _ -> { أرجع خطأ; };
                    ط := ط + 1;
                }
                التالية := التالية + عدد_الطبقات;
                رقم_الأصل := رقم_الأصل + 1;
            };
        }
        | _ -> { };
        لو (!موسع) {
            دع مرجع_العنصر: &عنصر_وحدة = &(*الشجرة).العناصر[ع];
            ألحق(الجديدة, *مرجع_العنصر);
        };
        ع := ع + 1;
    }
    (*الشجرة).العناصر := الجديدة;
    أرجع مدد_محتوى_مصدر_في_خريطة(سياق_المصادر, (*المصدر).المعرف, من_بايتات(&المولد));
}
