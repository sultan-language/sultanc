استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.backend.target.target_model;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.parser.parser;
استورد compiler.frontend.parser.result;
استورد std.text.from_bytes;

// Derived JSON (Nahr item 23): compile-time reflection over a declaration,
// as serde's derive. `@@json` (`@@جسون`) on a record or enum type T
// generates, from the declaration's own fields and constructors:
//
//   ألحق_جسون__T(out: &mutable vector u8, value: &T): void   (append)
//   جسون__T(value: &T): string                         to_json__T
//   من_جسون__T(text: &string): result T, string        from_json__T
//   من_قيمة_جسون__T(doc, value, path): result T, string
//   مخطط_جسون__T(): vector json_schema_field            json_schema__T
//
// Field types are read from their syntax: integers, unsigned integers,
// floats, bool, char (as its code), string, another `@@json` type, vectors
// and options of these. Any other field type encodes as null and fails to
// decode. The generated text uses std.json.derive and is appended after the
// unit, as the other source expansions are; the annotation is consumed.

عرف ألحق_نطاق_مشتق(الناتج: &متغير متجه ط8, الأصل: &متجه ط8, النطاق: نطاق): فراغ {
    دع ف: متغير طبيعي = النطاق.البداية.البايت;
    طالما (ف < (النطاق.النهاية.البايت مثل طبيعي) && ف < (الطول(*الأصل) مثل طبيعي)) {
        ألحق(*الناتج, (*الأصل)[ف]);
        ف := ف + 1;
    }
}

عرف ألحق_بايتات_مشتق(الناتج: &متغير متجه ط8, المصدر: &متجه ط8): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) { ألحق(*الناتج, (*المصدر)[ف]); ف := ف + 1; }
}

عرف ألحق_عدد_مشتق(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    إذا (القيمة >= 10) { ألحق_عدد_مشتق(الناتج, القيمة / 10); };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل ط8);
}

عرف نطاق_يساوي_مشتق(الأصل: &متجه ط8, النطاق: نطاق, النص: نص): منطقي {
    دع المطلوب: نص = النص;
    دع الطول_المطلوب: طبيعي = الطول(المطلوب) مثل طبيعي;
    إذا (((النطاق.النهاية.البايت - النطاق.البداية.البايت) مثل طبيعي) != الطول_المطلوب) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_المطلوب) {
        إذا ((*الأصل)[(النطاق.البداية.البايت مثل طبيعي) + ف] != المطلوب[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف سمة_جسون(الأصل: &متجه ط8, السمة: &سمة_تصريح): منطقي {
    إذا ((الطول((*السمة).المسار) مثل طبيعي) != 1 || (الطول((*السمة).الحجج) مثل طبيعي) != 0) { أرجع خطأ; };
    دع النطاق: نطاق = (*السمة).المسار[0].النطاق;
    أرجع نطاق_يساوي_مشتق(الأصل, النطاق, «جسون») || نطاق_يساوي_مشتق(الأصل, النطاق, «json»);
}

عرف نوع_مشتق_جسون(الأصل: &متجه ط8, التصريح: &تصريح_نوع): منطقي {
    إذا ((الطول((*التصريح).معاملات_النوع) مثل طبيعي) != 0) { أرجع خطأ; };
    طابق (*التصريح).الشكل مع
    | شكل_تصريح_نوع.مرادف(_) -> { أرجع خطأ; }
    // No fields or constructors to encode.
    | شكل_تصريح_نوع.معتم(_) -> { أرجع خطأ; }
    | _ -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التصريح).السمات) مثل طبيعي)) {
        إذا (سمة_جسون(الأصل, &(*التصريح).السمات[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Kinds of a field's syntax: 1 integer, 2 unsigned, 3 float, 4 bool,
// 5 string, 6 named, 7 vector, 8 option, 9 char, 0 unsupported.
عرف صنف_نوع_مشتق(النوع: &نوع_تركيبي): طبيعي {
    طابق *النوع مع
    | نوع_تركيبي.عدد(_) -> { أرجع 1; }
    | نوع_تركيبي.طبيعي(_) -> { أرجع 2; }
    | نوع_تركيبي.منطقي(_) -> { أرجع 4; }
    | نوع_تركيبي.نص(_) -> { أرجع 5; }
    | نوع_تركيبي.حرف(_) -> { أرجع 9; }
    | نوع_تركيبي.آلة(_, الآلة) -> {
        طابق الآلة مع
        | نوع_آلة.ص8 -> { أرجع 1; }
        | نوع_آلة.ص16 -> { أرجع 1; }
        | نوع_آلة.ص32 -> { أرجع 1; }
        | نوع_آلة.ص64 -> { أرجع 1; }
        | نوع_آلة.ع32 -> { أرجع 3; }
        | نوع_آلة.ع64 -> { أرجع 3; }
        | _ -> { أرجع 2; };
    }
    | نوع_تركيبي.مسمى(_, _, الحجج) -> {
        إذا ((الطول(الحجج) مثل طبيعي) == 0) { أرجع 6; };
        أرجع 0;
    }
    | نوع_تركيبي.متجه(_, _) -> { أرجع 7; }
    | نوع_تركيبي.اختيار(_, _) -> { أرجع 8; }
    | _ -> { أرجع 0; };
}

عرف داخل_نوع_مشتق(النوع: &نوع_تركيبي): نوع_تركيبي {
    طابق *النوع مع
    | نوع_تركيبي.متجه(_, الداخل) -> { أرجع انسخ_مملوكا_نوع_تركيبي(&(*الداخل)); }
    | نوع_تركيبي.اختيار(_, الداخل) -> { أرجع انسخ_مملوكا_نوع_تركيبي(&(*الداخل)); }
    | _ -> { أرجع انسخ_مملوكا_نوع_تركيبي(النوع); };
}

عرف اسم_نوع_مسمى_مشتق(النوع: &نوع_تركيبي): نطاق {
    طابق *النوع مع
    | نوع_تركيبي.مسمى(_, الاسم, _) -> { أرجع الاسم.النطاق; }
    | _ -> { أرجع نطاق_نوع_تركيبي(النوع); };
}

عرف ن(الناتج: &متغير متجه ط8, النص: نص): فراغ { ألحق_بايتات_نص(الناتج, النص); }

// Statements appending the JSON of the place X (text) of type النوع.
عرف ألحق_ترميز_مشتق(الناتج: &متغير متجه ط8, الأصل: &متجه ط8, النوع: &نوع_تركيبي, X: &متجه ط8, العمق: طبيعي): فراغ {
    دع الصنف: طبيعي = صنف_نوع_مشتق(النوع);
    إذا (الصنف == 1) { ن(الناتج, "ألحق_جسون_عدد(الناتج, ("); ألحق_بايتات_مشتق(الناتج, X); ن(الناتج, ") مثل عدد);\n"); أرجع; };
    إذا (الصنف == 2 || الصنف == 9) { ن(الناتج, "ألحق_جسون_طبيعي(الناتج, ("); ألحق_بايتات_مشتق(الناتج, X); ن(الناتج, ") مثل طبيعي);\n"); أرجع; };
    إذا (الصنف == 3) { ن(الناتج, "ألحق_جسون_عشري(الناتج, ("); ألحق_بايتات_مشتق(الناتج, X); ن(الناتج, ") مثل ع64);\n"); أرجع; };
    إذا (الصنف == 4) { ن(الناتج, "ألحق_جسون_منطقي(الناتج, "); ألحق_بايتات_مشتق(الناتج, X); ن(الناتج, ");\n"); أرجع; };
    إذا (الصنف == 5) { ن(الناتج, "ألحق_جسون_نص(الناتج, &"); ألحق_بايتات_مشتق(الناتج, X); ن(الناتج, ");\n"); أرجع; };
    إذا (الصنف == 6) {
        ن(الناتج, "ألحق_جسون__"); ألحق_نطاق_مشتق(الناتج, الأصل, اسم_نوع_مسمى_مشتق(النوع));
        ن(الناتج, "(الناتج, &"); ألحق_بايتات_مشتق(الناتج, X); ن(الناتج, ");\n"); أرجع;
    };
    إذا (الصنف == 7) {
        دع الداخل: نوع_تركيبي = داخل_نوع_مشتق(النوع);
        دع ع: متغير متجه ط8 = [];
        ن(&متغير ع, "مشتق__ع"); ألحق_عدد_مشتق(&متغير ع, العمق);
        ن(الناتج, "إذا (صواب) {\nدع "); ألحق_بايتات_مشتق(الناتج, &ع); ن(الناتج, ": متغير طبيعي = 0;\nألحق_بايت_جسون(الناتج, 0x5B مثل ط8);\nطالما (");
        ألحق_بايتات_مشتق(الناتج, &ع); ن(الناتج, " < (الطول("); ألحق_بايتات_مشتق(الناتج, X); ن(الناتج, ") مثل طبيعي)) {\nإذا (");
        ألحق_بايتات_مشتق(الناتج, &ع); ن(الناتج, " > 0) { ألحق_بايت_جسون(الناتج, 0x2C مثل ط8); };\n");
        دع العنصر: متغير متجه ط8 = [];
        ألحق_بايتات_مشتق(&متغير العنصر, X); ن(&متغير العنصر, "["); ألحق_بايتات_مشتق(&متغير العنصر, &ع); ن(&متغير العنصر, "]");
        ألحق_ترميز_مشتق(الناتج, الأصل, &الداخل, &العنصر, العمق + 1);
        ألحق_بايتات_مشتق(الناتج, &ع); ن(الناتج, " := "); ألحق_بايتات_مشتق(الناتج, &ع); ن(الناتج, " + 1;\n}\nألحق_بايت_جسون(الناتج, 0x5D مثل ط8);\n};\n");
        أرجع;
    };
    إذا (الصنف == 8) {
        دع الداخل: نوع_تركيبي = داخل_نوع_مشتق(النوع);
        دع ق: متغير متجه ط8 = [];
        ن(&متغير ق, "مشتق__ق"); ألحق_عدد_مشتق(&متغير ق, العمق);
        ن(الناتج, "طابق "); ألحق_بايتات_مشتق(الناتج, X); ن(الناتج, " مع\n| اختياري.موجود(");
        ألحق_بايتات_مشتق(الناتج, &ق); ن(الناتج, ") -> {\n");
        ألحق_ترميز_مشتق(الناتج, الأصل, &الداخل, &ق, العمق + 1);
        ن(الناتج, "}\n| اختياري.لا_شيء -> { ألحق_جسون_عدم(الناتج); };\n");
        أرجع;
    };
    ن(الناتج, "ألحق_جسون_عدم(الناتج);\n");
}

// Statements decoding the JSON value V (an expression of type &json_value)
// at path P (an expression of type &string) into the deferred local R.
عرف ألحق_فك_مشتق(الناتج: &متغير متجه ط8, الأصل: &متجه ط8, النوع: &نوع_تركيبي, V: &متجه ط8, P: &متجه ط8, R: &متجه ط8, العمق: طبيعي): فراغ {
    دع الصنف: طبيعي = صنف_نوع_مشتق(النوع);
    دع ق: متغير متجه ط8 = [];
    ن(&متغير ق, "مشتق__ق"); ألحق_عدد_مشتق(&متغير ق, العمق);
    إذا (الصنف >= 1 && الصنف <= 6 || الصنف == 9) {
        ن(الناتج, "طابق ");
        إذا (الصنف == 1) { ن(الناتج, "عدد_من_جسون"); }
        وإلا إذا (الصنف == 2 || الصنف == 9) { ن(الناتج, "طبيعي_من_جسون"); }
        وإلا إذا (الصنف == 3) { ن(الناتج, "عشري_من_جسون"); }
        وإلا إذا (الصنف == 4) { ن(الناتج, "منطقي_من_جسون"); }
        وإلا إذا (الصنف == 5) { ن(الناتج, "نص_من_جسون"); }
        وإلا { ن(الناتج, "من_قيمة_جسون__"); ألحق_نطاق_مشتق(الناتج, الأصل, اسم_نوع_مسمى_مشتق(النوع)); };
        ن(الناتج, "(الوثيقة, "); ألحق_بايتات_مشتق(الناتج, V);
        ن(الناتج, ", "); ألحق_بايتات_مشتق(الناتج, P); ن(الناتج, ") مع\n| نتيجة.خطأ(مشتق__خ) -> { أرجع نتيجة.خطأ(مشتق__خ); }\n| نتيجة.نجح(");
        ألحق_بايتات_مشتق(الناتج, &ق); ن(الناتج, ") -> { ");
        ألحق_بايتات_مشتق(الناتج, R); ن(الناتج, " := ");
        إذا (الصنف == 1 || الصنف == 2 || الصنف == 3 || الصنف == 9) {
            ن(الناتج, "("); ألحق_بايتات_مشتق(الناتج, &ق); ن(الناتج, ") مثل ");
            ألحق_نطاق_مشتق(الناتج, الأصل, نطاق_نوع_تركيبي(النوع));
        } وإلا {
            ألحق_بايتات_مشتق(الناتج, &ق);
        };
        ن(الناتج, "; };\n");
        أرجع;
    };
    إذا (الصنف == 7) {
        دع الداخل: نوع_تركيبي = داخل_نوع_مشتق(النوع);
        دع ع: متغير متجه ط8 = []; ن(&متغير ع, "مشتق__ع"); ألحق_عدد_مشتق(&متغير ع, العمق);
        دع م: متغير متجه ط8 = []; ن(&متغير م, "مشتق__م"); ألحق_عدد_مشتق(&متغير م, العمق);
        دع ف: متغير متجه ط8 = []; ن(&متغير ف, "مشتق__ف"); ألحق_عدد_مشتق(&متغير ف, العمق);
        دع ر: متغير متجه ط8 = []; ن(&متغير ر, "مشتق__ر"); ألحق_عدد_مشتق(&متغير ر, العمق);
        ن(الناتج, "طابق عناصر_جسون(الوثيقة, "); ألحق_بايتات_مشتق(الناتج, V);
        ن(الناتج, ", "); ألحق_بايتات_مشتق(الناتج, P);
        ن(الناتج, ") مع\n| نتيجة.خطأ(مشتق__خ) -> { أرجع نتيجة.خطأ(مشتق__خ); }\n| نتيجة.نجح("); ألحق_بايتات_مشتق(الناتج, &ع);
        ن(الناتج, ") -> {\nدع "); ألحق_بايتات_مشتق(الناتج, &م); ن(الناتج, ": متغير ");
        ألحق_نطاق_مشتق(الناتج, الأصل, نطاق_نوع_تركيبي(النوع)); ن(الناتج, " = [];\nدع ");
        ألحق_بايتات_مشتق(الناتج, &ف); ن(الناتج, ": متغير طبيعي = 0;\nطالما (");
        ألحق_بايتات_مشتق(الناتج, &ف); ن(الناتج, " < (الطول("); ألحق_بايتات_مشتق(الناتج, &ع);
        ن(الناتج, ") مثل طبيعي)) {\nدع "); ألحق_بايتات_مشتق(الناتج, &ر); ن(الناتج, ": ");
        ألحق_نطاق_مشتق(الناتج, الأصل, نطاق_نوع_تركيبي(&الداخل)); ن(الناتج, ";\n");
        دع العنصر: متغير متجه ط8 = []; ن(&متغير العنصر, "&"); ألحق_بايتات_مشتق(&متغير العنصر, &ع); ن(&متغير العنصر, "["); ألحق_بايتات_مشتق(&متغير العنصر, &ف); ن(&متغير العنصر, "]");
        دع المسار: متغير متجه ط8 = []; ن(&متغير المسار, "&مسار_عنصر_جسون("); ألحق_بايتات_مشتق(&متغير المسار, P); ن(&متغير المسار, ", "); ألحق_بايتات_مشتق(&متغير المسار, &ف); ن(&متغير المسار, ")");
        ألحق_فك_مشتق(الناتج, الأصل, &الداخل, &العنصر, &المسار, &ر, العمق + 1);
        ن(الناتج, "ألحق("); ألحق_بايتات_مشتق(الناتج, &م); ن(الناتج, ", "); ألحق_بايتات_مشتق(الناتج, &ر);
        ن(الناتج, ");\n"); ألحق_بايتات_مشتق(الناتج, &ف); ن(الناتج, " := "); ألحق_بايتات_مشتق(الناتج, &ف);
        ن(الناتج, " + 1;\n}\n"); ألحق_بايتات_مشتق(الناتج, R); ن(الناتج, " := "); ألحق_بايتات_مشتق(الناتج, &م);
        ن(الناتج, ";\n};\n");
        أرجع;
    };
    إذا (الصنف == 8) {
        دع الداخل: نوع_تركيبي = داخل_نوع_مشتق(النوع);
        دع ر: متغير متجه ط8 = []; ن(&متغير ر, "مشتق__ر"); ألحق_عدد_مشتق(&متغير ر, العمق);
        ن(الناتج, "إذا (هل_عدم_جسون("); ألحق_بايتات_مشتق(الناتج, V); ن(الناتج, ")) { ");
        ألحق_بايتات_مشتق(الناتج, R); ن(الناتج, " := اختياري.لا_شيء(); } وإلا {\nدع ");
        ألحق_بايتات_مشتق(الناتج, &ر); ن(الناتج, ": "); ألحق_نطاق_مشتق(الناتج, الأصل, نطاق_نوع_تركيبي(&الداخل)); ن(الناتج, ";\n");
        ألحق_فك_مشتق(الناتج, الأصل, &الداخل, V, P, &ر, العمق + 1);
        ألحق_بايتات_مشتق(الناتج, R); ن(الناتج, " := اختياري.موجود("); ألحق_بايتات_مشتق(الناتج, &ر); ن(الناتج, ");\n};\n");
        أرجع;
    };
    ن(الناتج, "أرجع نتيجة.خطأ(\"unsupported field type\");\n");
}

عرف ألحق_نوع_مخطط_مشتق(الناتج: &متغير متجه ط8, الأصل: &متجه ط8, النوع: &نوع_تركيبي): فراغ {
    دع الصنف: طبيعي = صنف_نوع_مشتق(النوع);
    إذا (الصنف == 8) { دع الداخل: نوع_تركيبي = داخل_نوع_مشتق(النوع); ألحق_نوع_مخطط_مشتق(الناتج, الأصل, &الداخل); أرجع; };
    إذا (الصنف == 1 || الصنف == 2 || الصنف == 9) { ن(الناتج, "\"integer\", \"\""); أرجع; };
    إذا (الصنف == 3) { ن(الناتج, "\"number\", \"\""); أرجع; };
    إذا (الصنف == 4) { ن(الناتج, "\"boolean\", \"\""); أرجع; };
    إذا (الصنف == 5) { ن(الناتج, "\"string\", \"\""); أرجع; };
    إذا (الصنف == 6) { ن(الناتج, "\"object\", \""); ألحق_نطاق_مشتق(الناتج, الأصل, اسم_نوع_مسمى_مشتق(النوع)); ن(الناتج, "\""); أرجع; };
    إذا (الصنف == 7) { ن(الناتج, "\"array\", \""); ألحق_نطاق_مشتق(الناتج, الأصل, نطاق_نوع_تركيبي(النوع)); ن(الناتج, "\""); أرجع; };
    ن(الناتج, "\"null\", \"\"");
}

عرف ألحق_اسم_مشتق(الناتج: &متغير متجه ط8, البادئة: نص, الأصل: &متجه ط8, التصريح: &تصريح_نوع): فراغ {
    ن(الناتج, البادئة);
    ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق);
}

عرف ألحق_رأس_دالة_مشتقة(الناتج: &متغير متجه ط8, التصريح: &تصريح_نوع): فراغ {
    إذا ((*التصريح).علني) { ن(الناتج, "عام "); };
    ن(الناتج, "عرف ");
}

// The functions of one derived type.
عرف ألحق_اشتقاق_جسون(الناتج: &متغير متجه ط8, الأصل: &متجه ط8, التصريح: &تصريح_نوع): فراغ {
    // Encoder.
    ألحق_رأس_دالة_مشتقة(الناتج, التصريح);
    ألحق_اسم_مشتق(الناتج, «ألحق_جسون__», الأصل, التصريح);
    ن(الناتج, "(الناتج: &متغير متجه ط8, القيمة: &"); ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق); ن(الناتج, "): فراغ {\n");
    طابق (*التصريح).الشكل مع
    | شكل_تصريح_نوع.سجل(الحقول) -> {
        ن(الناتج, "ألحق_بايت_جسون(الناتج, 0x7B مثل ط8);\n");
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            ن(الناتج, "ألحق_مفتاح_جسون(الناتج, &\""); ألحق_نطاق_مشتق(الناتج, الأصل, الحقول[ف].الاسم.النطاق);
            إذا (ف == 0) { ن(الناتج, "\", صواب);\n"); } وإلا { ن(الناتج, "\", خطأ);\n"); };
            دع X: متغير متجه ط8 = []; ن(&متغير X, "(*القيمة)."); ألحق_نطاق_مشتق(&متغير X, الأصل, الحقول[ف].الاسم.النطاق);
            ألحق_ترميز_مشتق(الناتج, الأصل, &الحقول[ف].النوع, &X, 0);
            ف := ف + 1;
        }
        ن(الناتج, "ألحق_بايت_جسون(الناتج, 0x7D مثل ط8);\n");
    }
    | شكل_تصريح_نوع.تعداد(المنشئات) -> {
        ن(الناتج, "طابق *القيمة مع\n");
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(المنشئات) مثل طبيعي)) {
            ن(الناتج, "| "); ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق); ن(الناتج, "."); ألحق_نطاق_مشتق(الناتج, الأصل, المنشئات[م].الاسم.النطاق);
            دع العدد: طبيعي = الطول(المنشئات[م].الحمولات) مثل طبيعي;
            إذا (العدد == 0) {
                ن(الناتج, " -> { ألحق_جسون_نص(الناتج, &\""); ألحق_نطاق_مشتق(الناتج, الأصل, المنشئات[م].الاسم.النطاق); ن(الناتج, "\"); }\n");
            } وإلا {
                ن(الناتج, "(");
                دع ح: متغير طبيعي = 0;
                طالما (ح < العدد) { إذا (ح > 0) { ن(الناتج, ", "); }; ن(الناتج, "مشتق__ح"); ألحق_عدد_مشتق(الناتج, ح); ح := ح + 1; }
                ن(الناتج, ") -> {\nألحق_بايت_جسون(الناتج, 0x7B مثل ط8);\nألحق_مفتاح_جسون(الناتج, &\"tag\", صواب);\nألحق_جسون_نص(الناتج, &\"");
                ألحق_نطاق_مشتق(الناتج, الأصل, المنشئات[م].الاسم.النطاق);
                ن(الناتج, "\");\nألحق_مفتاح_جسون(الناتج, &\"values\", خطأ);\nألحق_بايت_جسون(الناتج, 0x5B مثل ط8);\n");
                ح := 0;
                طالما (ح < العدد) {
                    إذا (ح > 0) { ن(الناتج, "ألحق_بايت_جسون(الناتج, 0x2C مثل ط8);\n"); };
                    دع X: متغير متجه ط8 = []; ن(&متغير X, "مشتق__ح"); ألحق_عدد_مشتق(&متغير X, ح);
                    ألحق_ترميز_مشتق(الناتج, الأصل, &المنشئات[م].الحمولات[ح], &X, 1);
                    ح := ح + 1;
                }
                ن(الناتج, "ألحق_بايت_جسون(الناتج, 0x5D مثل ط8);\nألحق_بايت_جسون(الناتج, 0x7D مثل ط8);\n}\n");
            };
            م := م + 1;
        }
        ن(الناتج, ";\n");
    }
    | _ -> { };
    ن(الناتج, "}\n");

    // Encoding to text.
    ألحق_رأس_دالة_مشتقة(الناتج, التصريح); ألحق_اسم_مشتق(الناتج, «جسون__», الأصل, التصريح);
    ن(الناتج, "(القيمة: &"); ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق);
    ن(الناتج, "): نص {\nدع الناتج: متغير متجه ط8 = [];\n"); ألحق_اسم_مشتق(الناتج, «ألحق_جسون__», الأصل, التصريح);
    ن(الناتج, "(&متغير الناتج, القيمة);\nأرجع الناتج مثل نص;\n}\n");

    // Decoder from a parsed value.
    ألحق_رأس_دالة_مشتقة(الناتج, التصريح); ألحق_اسم_مشتق(الناتج, «من_قيمة_جسون__», الأصل, التصريح);
    ن(الناتج, "(الوثيقة: &وثيقة_جسون, القيمة: &قيمة_جسون, المسار: &نص): نتيجة ");
    ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق); ن(الناتج, ", نص {\n");
    طابق (*التصريح).الشكل مع
    | شكل_تصريح_نوع.سجل(الحقول) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            دع R: متغير متجه ط8 = []; ن(&متغير R, "مشتق__حقل"); ألحق_عدد_مشتق(&متغير R, ف);
            ن(الناتج, "دع "); ألحق_بايتات_مشتق(الناتج, &R); ن(الناتج, ": ");
            ألحق_نطاق_مشتق(الناتج, الأصل, نطاق_نوع_تركيبي(&الحقول[ف].النوع)); ن(الناتج, ";\n");
            دع المفتاح: متغير متجه ط8 = []; ن(&متغير المفتاح, "&\""); ألحق_نطاق_مشتق(&متغير المفتاح, الأصل, الحقول[ف].الاسم.النطاق); ن(&متغير المفتاح, "\"");
            دع P: متغير متجه ط8 = []; ن(&متغير P, "&مسار_حقل_جسون(المسار, "); ألحق_بايتات_مشتق(&متغير P, &المفتاح); ن(&متغير P, ")");
            إذا (صنف_نوع_مشتق(&الحقول[ف].النوع) == 8) {
                دع الداخل: نوع_تركيبي = داخل_نوع_مشتق(&الحقول[ف].النوع);
                ن(الناتج, "طابق عضو_اختياري_جسون(الوثيقة, القيمة, "); ألحق_بايتات_مشتق(الناتج, &المفتاح);
                ن(الناتج, ", المسار) مع\n| نتيجة.خطأ(مشتق__خ) -> { أرجع نتيجة.خطأ(مشتق__خ); }\n| نتيجة.نجح(اختياري.لا_شيء) -> { ");
                ألحق_بايتات_مشتق(الناتج, &R); ن(الناتج, " := اختياري.لا_شيء(); }\n| نتيجة.نجح(اختياري.موجود(مشتق__عضو)) -> {\nدع مشتق__داخل: ");
                ألحق_نطاق_مشتق(الناتج, الأصل, نطاق_نوع_تركيبي(&الداخل)); ن(الناتج, ";\n");
                دع V: متغير متجه ط8 = []; ن(&متغير V, "&مشتق__عضو");
                دع الداخلي: متغير متجه ط8 = []; ن(&متغير الداخلي, "مشتق__داخل");
                ألحق_فك_مشتق(الناتج, الأصل, &الداخل, &V, &P, &الداخلي, 1);
                ألحق_بايتات_مشتق(الناتج, &R); ن(الناتج, " := اختياري.موجود(مشتق__داخل);\n};\n");
            } وإلا {
                ن(الناتج, "طابق عضو_جسون(الوثيقة, القيمة, "); ألحق_بايتات_مشتق(الناتج, &المفتاح);
                ن(الناتج, ", المسار) مع\n| نتيجة.خطأ(مشتق__خ) -> { أرجع نتيجة.خطأ(مشتق__خ); }\n| نتيجة.نجح(مشتق__عضو) -> {\n");
                دع V: متغير متجه ط8 = []; ن(&متغير V, "&مشتق__عضو");
                ألحق_فك_مشتق(الناتج, الأصل, &الحقول[ف].النوع, &V, &P, &R, 1);
                ن(الناتج, "};\n");
            };
            ف := ف + 1;
        }
        ن(الناتج, "دع مشتق__الناتج: "); ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق); ن(الناتج, " = {\n");
        ف := 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            إذا (ف > 0) { ن(الناتج, ",\n"); };
            ألحق_نطاق_مشتق(الناتج, الأصل, الحقول[ف].الاسم.النطاق); ن(الناتج, ": مشتق__حقل"); ألحق_عدد_مشتق(الناتج, ف);
            ف := ف + 1;
        }
        ن(الناتج, "\n};\nأرجع نتيجة.نجح(مشتق__الناتج);\n");
    }
    | شكل_تصريح_نوع.تعداد(المنشئات) -> {
        ن(الناتج, "دع مشتق__وسم: نص;\nطابق وسم_جسون(الوثيقة, القيمة, المسار) مع\n| نتيجة.خطأ(مشتق__خ) -> { أرجع نتيجة.خطأ(مشتق__خ); }\n| نتيجة.نجح(و) -> { مشتق__وسم := و; };\n");
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(المنشئات) مثل طبيعي)) {
            ن(الناتج, "إذا (نصان_متساويان(&مشتق__وسم, &\""); ألحق_نطاق_مشتق(الناتج, الأصل, المنشئات[م].الاسم.النطاق); ن(الناتج, "\")) {\n");
            دع العدد: طبيعي = الطول(المنشئات[م].الحمولات) مثل طبيعي;
            إذا (العدد > 0) {
                ن(الناتج, "دع مشتق__قيم: متجه قيمة_جسون;\nطابق عضو_جسون(الوثيقة, القيمة, &\"values\", المسار) مع\n| نتيجة.خطأ(مشتق__خ) -> { أرجع نتيجة.خطأ(مشتق__خ); }\n| نتيجة.نجح(مشتق__ع) -> {\n");
                ن(الناتج, "طابق عناصر_جسون(الوثيقة, &مشتق__ع, المسار) مع\n| نتيجة.خطأ(مشتق__خ) -> { أرجع نتيجة.خطأ(مشتق__خ); }\n| نتيجة.نجح(مشتق__ك) -> { مشتق__قيم := مشتق__ك; };\n};\n");
                ن(الناتج, "إذا ((الطول(مشتق__قيم) مثل طبيعي) != "); ألحق_عدد_مشتق(الناتج, العدد);
                ن(الناتج, ") { أرجع نتيجة.خطأ(\"wrong number of values\"); };\n");
                دع ح: متغير طبيعي = 0;
                طالما (ح < العدد) {
                    دع R: متغير متجه ط8 = []; ن(&متغير R, "مشتق__ح"); ألحق_عدد_مشتق(&متغير R, ح);
                    ن(الناتج, "دع "); ألحق_بايتات_مشتق(الناتج, &R); ن(الناتج, ": ");
                    ألحق_نطاق_مشتق(الناتج, الأصل, نطاق_نوع_تركيبي(&المنشئات[م].الحمولات[ح])); ن(الناتج, ";\n");
                    دع V: متغير متجه ط8 = []; ن(&متغير V, "&مشتق__قيم["); ألحق_عدد_مشتق(&متغير V, ح); ن(&متغير V, "]");
                    دع P: متغير متجه ط8 = []; ن(&متغير P, "&مسار_عنصر_جسون(المسار, "); ألحق_عدد_مشتق(&متغير P, ح); ن(&متغير P, ")");
                    ألحق_فك_مشتق(الناتج, الأصل, &المنشئات[م].الحمولات[ح], &V, &P, &R, 1);
                    ح := ح + 1;
                }
            };
            ن(الناتج, "أرجع نتيجة.نجح("); ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق); ن(الناتج, ".");
            ألحق_نطاق_مشتق(الناتج, الأصل, المنشئات[م].الاسم.النطاق); ن(الناتج, "(");
            دع ح2: متغير طبيعي = 0;
            طالما (ح2 < العدد) { إذا (ح2 > 0) { ن(الناتج, ", "); }; ن(الناتج, "مشتق__ح"); ألحق_عدد_مشتق(الناتج, ح2); ح2 := ح2 + 1; }
            ن(الناتج, "));\n};\n");
            م := م + 1;
        }
        ن(الناتج, "أرجع نتيجة.خطأ(خطأ_وسم_جسون(المسار, &مشتق__وسم));\n");
    }
    | _ -> { };
    ن(الناتج, "}\n");

    // Decoder from text.
    ألحق_رأس_دالة_مشتقة(الناتج, التصريح); ألحق_اسم_مشتق(الناتج, «من_جسون__», الأصل, التصريح);
    ن(الناتج, "(النص: &نص): نتيجة "); ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق);
    ن(الناتج, ", نص {\nطابق حلل_وثيقة_جسون_مشتقة(النص) مع\n| نتيجة.خطأ(مشتق__خ) -> { أرجع نتيجة.خطأ(مشتق__خ); }\n| نتيجة.نجح(مشتق__و) -> {\nدع مشتق__ج: قيمة_جسون = جذر_وثيقة_جسون(&مشتق__و);\nأرجع ");
    ألحق_اسم_مشتق(الناتج, «من_قيمة_جسون__», الأصل, التصريح); ن(الناتج, "(&مشتق__و, &مشتق__ج, &\"\");\n};\n}\n");

    // Schema.
    ألحق_رأس_دالة_مشتقة(الناتج, التصريح); ألحق_اسم_مشتق(الناتج, «مخطط_جسون__», الأصل, التصريح);
    ن(الناتج, "(): متجه حقل_مخطط_جسون {\nدع الناتج: متغير متجه حقل_مخطط_جسون = [];\n");
    طابق (*التصريح).الشكل مع
    | شكل_تصريح_نوع.سجل(الحقول) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            ن(الناتج, "ألحق(الناتج, حقل_مخطط(\""); ألحق_نطاق_مشتق(الناتج, الأصل, الحقول[ف].الاسم.النطاق); ن(الناتج, "\", ");
            ألحق_نوع_مخطط_مشتق(الناتج, الأصل, &الحقول[ف].النوع);
            إذا (صنف_نوع_مشتق(&الحقول[ف].النوع) == 8) { ن(الناتج, ", خطأ));\n"); } وإلا { ن(الناتج, ", صواب));\n"); };
            ف := ف + 1;
        }
    }
    | شكل_تصريح_نوع.تعداد(المنشئات) -> {
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(المنشئات) مثل طبيعي)) {
            ن(الناتج, "ألحق(الناتج, حقل_مخطط(\""); ألحق_نطاق_مشتق(الناتج, الأصل, المنشئات[م].الاسم.النطاق);
            ن(الناتج, "\", \"tag\", \"\", صواب));\n");
            م := م + 1;
        }
    }
    | _ -> { };
    ن(الناتج, "أرجع الناتج;\n}\n");

    // English names.
    إذا ((*التصريح).علني) { ن(الناتج, "عام "); }; ن(الناتج, "مرادف to_json__"); ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق); ن(الناتج, " = "); ألحق_اسم_مشتق(الناتج, «جسون__», الأصل, التصريح); ن(الناتج, ";\n");
    إذا ((*التصريح).علني) { ن(الناتج, "عام "); }; ن(الناتج, "مرادف from_json__"); ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق); ن(الناتج, " = "); ألحق_اسم_مشتق(الناتج, «من_جسون__», الأصل, التصريح); ن(الناتج, ";\n");
    إذا ((*التصريح).علني) { ن(الناتج, "عام "); }; ن(الناتج, "مرادف json_schema__"); ألحق_نطاق_مشتق(الناتج, الأصل, (*التصريح).الاسم.النطاق); ن(الناتج, " = "); ألحق_اسم_مشتق(الناتج, «مخطط_جسون__», الأصل, التصريح); ن(الناتج, ";\n");
}

عرف انسخ_استيراد_مشتق(القيمة: &استيراد): استيراد {
    طابق *القيمة مع
    | استيراد.انتقائي(س, المسار, الأسماء) -> {
        أرجع استيراد.انتقائي(س, انسخ_مملوكا_متجه_اسم(&المسار), انسخ_مملوكا_متجه_اسم(&الأسماء));
    }
    | استيراد.اسم(س, المسار, البديل) -> {
        أرجع استيراد.اسم(س, انسخ_مملوكا_متجه_اسم(&المسار), البديل);
    }
    | استيراد.نص(س, البايتات, البديل) -> {
        أرجع استيراد.نص(س, انسخ_بايتات(&البايتات), البديل);
    };
}

عام عرف وسع_اشتقاق_جسون_وحدة(
    الشجرة: &متغير وحدة_مصدر,
    سياق_المصادر: &متغير خريطة_مصادر,
    المصدر: &مصدر,
    الهدف: &اختياري واصف_هدف
): منطقي {
    دع مرجع_المحتوى: &نص = &(*المصدر).المحتوى;
    دع الأصل: متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_المحتوى));
    دع يوجد: متغير منطقي = خطأ;
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.نوع(التصريح) -> { إذا (نوع_مشتق_جسون(&الأصل, &التصريح)) { يوجد := صواب; }; }
        | _ -> { };
        ع := ع + 1;
    }
    إذا (!يوجد) { أرجع صواب; };
    دع المولد: متغير متجه ط8 = بايتات_من_نص(انسخ_نص(مرجع_المحتوى));
    ألحق_بايتات_نص(&متغير المولد, "\n// SultanC derived JSON (frontend/annotations/json_derive.sn)\n");
    دع بداية_المولد: طبيعي = الطول(المولد) مثل طبيعي;
    ألحق_بايتات_نص(&متغير المولد, "استورد std.json.derive;\nاستورد std.json.value;\nاستورد std.text.compare;\n");
    ع := 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.نوع(التصريح) -> {
            إذا (نوع_مشتق_جسون(&الأصل, &التصريح)) { ألحق_اشتقاق_جسون(&متغير المولد, &الأصل, &التصريح); };
        }
        | _ -> { };
        ع := ع + 1;
    }
    دع مرجع_الاسم: &نص = &(*المصدر).الاسم;
    دع الممدد: مصدر = مصدر_جديد((*المصدر).المعرف, انسخ_نص(مرجع_الاسم), من_بايتات(&المولد));
    دع الرموز_المولدة: متغير متجه رمز_مصدر = [];
    طابق حلل_معجميا(&الممدد) مع
    | نتيجة_تحليل_معجمي.مرفوض(_) -> { أرجع خطأ; }
    | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(السلسلة.الرموز) مثل طبيعي)) {
            إذا ((السلسلة.الرموز[ر].النطاق.البداية.البايت مثل طبيعي) >= بداية_المولد) {
                دع مرجع_الرمز: &رمز_مصدر = &السلسلة.الرموز[ر];
                ألحق(الرموز_المولدة, انسخ_مملوكا_رمز_مصدر(مرجع_الرمز));
            };
            ر := ر + 1;
        }
    };
    دع المولدة: متغير وحدة_مصدر;
    طابق حلل_الرموز_لهدف(&الممدد, &الرموز_المولدة, الهدف) مع
    | نتيجة_تحليل.شجرة(الوحدة) -> { المولدة := الوحدة; }
    | _ -> { أرجع خطأ; };
    // Consume the annotation; append the generated imports and items.
    دع الجديدة: متغير متجه عنصر_وحدة = [];
    ع := 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        دع مرجع_العنصر: &عنصر_وحدة = &(*الشجرة).العناصر[ع];
        دع النسخة: متغير عنصر_وحدة = انسخ_مملوكا_عنصر_وحدة(مرجع_العنصر);
        طابق النسخة مع
        | عنصر_وحدة.نوع(التصريح) -> {
            دع المعدل: متغير تصريح_نوع = انسخ_مملوكا_تصريح_نوع(&التصريح);
            دع الباقية: متغير متجه سمة_تصريح = [];
            دع س: متغير طبيعي = 0;
            طالما (س < (الطول(التصريح.السمات) مثل طبيعي)) {
                إذا (!(نوع_مشتق_جسون(&الأصل, &التصريح) && سمة_جسون(&الأصل, &التصريح.السمات[س]))) {
                    ألحق(الباقية, انسخ_مملوكا_سمة_تصريح(&التصريح.السمات[س]));
                };
                س := س + 1;
            }
            المعدل.السمات := الباقية;
            ألحق(الجديدة, عنصر_وحدة.نوع(المعدل));
        }
        | _ -> { ألحق(الجديدة, النسخة); };
        ع := ع + 1;
    }
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(المولدة.العناصر) مثل طبيعي)) {
        دع مرجع_المولد: &عنصر_وحدة = &المولدة.العناصر[م];
        ألحق(الجديدة, انسخ_مملوكا_عنصر_وحدة(مرجع_المولد));
        م := م + 1;
    }
    (*الشجرة).العناصر := الجديدة;
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول(المولدة.مرادفات_الأسماء) مثل طبيعي)) {
        دع مرجع_المرادف: &تصريح_مرادف_اسم = &المولدة.مرادفات_الأسماء[ر];
        دع المرادف: تصريح_مرادف_اسم = *مرجع_المرادف;
        ألحق((*الشجرة).مرادفات_الأسماء, المرادف);
        ر := ر + 1;
    }
    دع س: متغير طبيعي = 0;
    طالما (س < (الطول(المولدة.الاستيرادات) مثل طبيعي)) {
        دع مرجع_الاستيراد: &استيراد = &المولدة.الاستيرادات[س];
        ألحق((*الشجرة).الاستيرادات, انسخ_استيراد_مشتق(مرجع_الاستيراد));
        س := س + 1;
    }
    أرجع مدد_محتوى_مصدر_في_خريطة(سياق_المصادر, (*المصدر).المعرف, من_بايتات(&المولد));
}

// ---- Fields `@@json` cannot derive ----
// A field type outside the derivable kinds (صنف_نوع_مشتق 0: a named type with
// type arguments, a tuple, a reference, a function, ...) is rejected when the
// module is compiled, at the field type, instead of encoding it as JSON null
// and failing to decode it at run time.

عرف نطاق_نوع_غير_قابل_للاشتقاق(النوع: &نوع_تركيبي): اختياري نطاق {
    دع الصنف: طبيعي = صنف_نوع_مشتق(النوع);
    إذا (الصنف == 0) { أرجع اختياري.موجود(نطاق_نوع_تركيبي(النوع)); };
    إذا (الصنف == 7 || الصنف == 8) {
        دع الداخل: نوع_تركيبي = داخل_نوع_مشتق(النوع);
        أرجع نطاق_نوع_غير_قابل_للاشتقاق(&الداخل);
    };
    أرجع اختياري.لا_شيء();
}

// The first field type of a `@@json` type of the module that cannot be
// derived, in source order, or none.
عام عرف أول_نوع_حقل_جسون_غير_قابل_للاشتقاق(الشجرة: &وحدة_مصدر, المصدر: &مصدر): اختياري نطاق {
    دع الأصل: متجه ط8 = بايتات_من_نص(انسخ_نص(&(*المصدر).المحتوى));
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الشجرة).العناصر) مثل طبيعي)) {
        طابق (*الشجرة).العناصر[ع] مع
        | عنصر_وحدة.نوع(التصريح) -> {
            إذا (نوع_مشتق_جسون(&الأصل, &التصريح)) {
                طابق التصريح.الشكل مع
                | شكل_تصريح_نوع.سجل(الحقول) -> {
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < (الطول(الحقول) مثل طبيعي)) {
                        طابق نطاق_نوع_غير_قابل_للاشتقاق(&الحقول[ف].النوع) مع
                        | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
                        | اختياري.لا_شيء -> { };
                        ف := ف + 1;
                    }
                }
                | شكل_تصريح_نوع.تعداد(المنشئات) -> {
                    دع م: متغير طبيعي = 0;
                    طالما (م < (الطول(المنشئات) مثل طبيعي)) {
                        دع ح: متغير طبيعي = 0;
                        طالما (ح < (الطول(المنشئات[م].الحمولات) مثل طبيعي)) {
                            طابق نطاق_نوع_غير_قابل_للاشتقاق(&المنشئات[م].الحمولات[ح]) مع
                            | اختياري.موجود(النطاق) -> { أرجع اختياري.موجود(النطاق); }
                            | اختياري.لا_شيء -> { };
                            ح := ح + 1;
                        }
                        م := م + 1;
                    }
                }
                | _ -> { };
            };
        }
        | _ -> { };
        ع := ع + 1;
    }
    أرجع اختياري.لا_شيء();
}
