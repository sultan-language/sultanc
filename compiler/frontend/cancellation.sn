// Cooperative frontend cancellation owned by the compiler boundary.
// The LSP/runtime may request cancellation; semantic phases only observe this
// canonical token at deterministic checkpoints and never know protocol request IDs.
عام نوع حالة_إلغاء_واجهة = {
    ملغاة: منطقي
};

عام عرف حالة_إلغاء_واجهة_جديدة(): حالة_إلغاء_واجهة {
    دع الحالة: حالة_إلغاء_واجهة = { ملغاة: خطأ };
    أرجع الحالة;
}

عام عرف اطلب_إلغاء_واجهة(الحالة: &متغير حالة_إلغاء_واجهة): فراغ {
    دع الحالية: متغير حالة_إلغاء_واجهة = *الحالة;
    الحالية.ملغاة := صواب;
    *الحالة := الحالية;
}

عام عرف هل_واجهة_ملغاة(الحالة: &حالة_إلغاء_واجهة): منطقي {
    دع الحالية: حالة_إلغاء_واجهة = *الحالة;
    أرجع الحالية.ملغاة;
}
