استورد compiler.source.span;
استورد std.process.panic;

// 32-bit: the identities are vector positions; every one is made by
// معرف_نطاق_من / معرف_اسم_من / معرف_رمز_من, which checks it (ط32_متحقق, compiler/source/span.sn).
عام نوع معرف_نطاق = {
    القيمة: ط32
};

// هوية الاسم المقنن منفصلة عن موضع ظهوره في أي مصدر.
عام نوع معرف_اسم = {
    القيمة: ط32
};

عام نوع معرف_رمز = {
    القيمة: ط32
};

عام عرف معرف_نطاق_من(القيمة: طبيعي): معرف_نطاق {
    دع المعرف: معرف_نطاق = { القيمة: ط32_متحقق(القيمة) };
    أرجع المعرف;
}

عام عرف معرف_اسم_من(القيمة: طبيعي): معرف_اسم {
    دع المعرف: معرف_اسم = { القيمة: ط32_متحقق(القيمة) };
    أرجع المعرف;
}

عام عرف معرف_رمز_من(القيمة: طبيعي): معرف_رمز {
    دع المعرف: معرف_رمز = { القيمة: ط32_متحقق(القيمة) };
    أرجع المعرف;
}

// Symbol IDs from 0xF0000000 up name locals that MSIR lowering makes for
// itself (msir/lowering/drops.sn); Name allocates its Symbols below them
// (معرف_رمز_مسمى_من), so the two never meet.
عرف بداية_رموز_مركبة(): طبيعي { أرجع 0xF0000000; }

// A Symbol the Name system allocates: below the synthetic range.
عام عرف معرف_رمز_مسمى_من(القيمة: طبيعي): معرف_رمز {
    إذا (القيمة >= بداية_رموز_مركبة()) {
        إنهيار(«SultanC: the program declares more than 0xF0000000 Symbols»);
    };
    أرجع معرف_رمز_من(القيمة);
}

// The synthetic Symbol numbered الترتيب (from 0): a value past 2^32 - 1 stops
// the compiler in ط32_متحقق.
عام عرف معرف_رمز_مركب_من(الترتيب: طبيعي): معرف_رمز {
    أرجع معرف_رمز_من(بداية_رموز_مركبة() + الترتيب);
}

عام عرف معرفا_اسم_متساويان(أ: معرف_اسم, ب: معرف_اسم): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف معرفا_رمز_متساويان(أ: معرف_رمز, ب: معرف_رمز): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف معرفا_نطاق_متساويان(أ: معرف_نطاق, ب: معرف_نطاق): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_معرف_رمز(القيمة: &متجه معرف_رمز): متجه معرف_رمز {
    دع الناتج: متغير متجه معرف_رمز = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
