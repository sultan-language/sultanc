عام نوع معرف_نطاق = {
    القيمة: غير_موقع
};

// هوية الاسم المقنن منفصلة عن موضع ظهوره في أي مصدر.
عام نوع معرف_اسم = {
    القيمة: غير_موقع
};

عام نوع معرف_رمز = {
    القيمة: غير_موقع
};

عام عرف معرف_نطاق_من(القيمة: غير_موقع): معرف_نطاق {
    دع المعرف: معرف_نطاق = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرف_اسم_من(القيمة: غير_موقع): معرف_اسم {
    دع المعرف: معرف_اسم = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرف_رمز_من(القيمة: غير_موقع): معرف_رمز {
    دع المعرف: معرف_رمز = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرفا_اسم_متساويان(أ: معرف_اسم, ب: معرف_اسم): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف معرفا_رمز_متساويان(أ: معرف_رمز, ب: معرف_رمز): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف معرفا_نطاق_متساويان(أ: معرف_نطاق, ب: معرف_نطاق): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}
