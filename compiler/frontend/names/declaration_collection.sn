استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.name_context;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.names.primitive_registry;
استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.patterns;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.unit;

// Stable declaration handle over the existing AST owner. SymbolID remains the
// canonical semantic identity; the handle only locates the original unit/item.
عام نوع مقبض_تصريح = {
    موضع_الوحدة: طبيعي,
    موضع_العنصر: طبيعي
};

عام نوع فهرس_تصريحات = {
    بالرمز: متجه اختياري مقبض_تصريح
};

عرف ضمن_سعة_فهرس_تصريحات(
    الفهرس: &متغير فهرس_تصريحات,
    الرمز: معرف_رمز
): فراغ {
    طالما ((الطول((*الفهرس).بالرمز) مثل طبيعي) <= (الرمز.القيمة مثل طبيعي)) {
        ألحق((*الفهرس).بالرمز, اختياري.لا_شيء());
    }
}

عرف سجل_مقبض_تصريح(
    الفهرس: &متغير فهرس_تصريحات,
    الروابط: &سياق_روابط_أسماء,
    النطاق: نطاق,
    موضع_الوحدة: طبيعي,
    موضع_العنصر: طبيعي
): فراغ {
    طابق رمز_اسم_محلول_عند(الروابط, النطاق) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الرمز) -> {
        ضمن_سعة_فهرس_تصريحات(الفهرس, الرمز);
        طابق (*الفهرس).بالرمز[الرمز.القيمة] مع
        | اختياري.لا_شيء -> {
            ليكن المقبض: مقبض_تصريح = {
                موضع_الوحدة: موضع_الوحدة,
                موضع_العنصر: موضع_العنصر
            };
            (*الفهرس).بالرمز[الرمز.القيمة] := اختياري.موجود(المقبض);
        }
        | اختياري.موجود(_) -> { };
    };
}

عام عرف ابن_فهرس_تصريحات(
    الوحدات: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء
): فهرس_تصريحات {
    ليكن بالرمز: متجه اختياري مقبض_تصريح = [];
    ليكن الفهرس: متغير فهرس_تصريحات = { بالرمز: بالرمز };
    ليكن موضع_الوحدة: متغير طبيعي = 0;
    طالما (موضع_الوحدة < (الطول(*الوحدات) مثل طبيعي)) {
        إذا (موضع_الوحدة >= (الطول(*الروابط) مثل طبيعي)) {
            أرجع الفهرس;
        };
        ليكن مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[موضع_الوحدة];
        ليكن روابط_الوحدة: &سياق_روابط_أسماء = &(*الروابط)[موضع_الوحدة];
        ليكن موضع_العنصر: متغير طبيعي = 0;
        طالما (موضع_العنصر < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
            طابق (*مرجع_الوحدة).العناصر[موضع_العنصر] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                سجل_مقبض_تصريح(
                    &متغير الفهرس, روابط_الوحدة, الدالة.الاسم.النطاق,
                    موضع_الوحدة, موضع_العنصر
                );
            }
            | عنصر_وحدة.نوع(التصريح) -> {
                سجل_مقبض_تصريح(
                    &متغير الفهرس, روابط_الوحدة, التصريح.الاسم.النطاق,
                    موضع_الوحدة, موضع_العنصر
                );
            }
            | عنصر_وحدة.قيمة_عليا(التصريح) -> {
                سجل_مقبض_تصريح(
                    &متغير الفهرس, روابط_الوحدة, التصريح.الاسم.النطاق,
                    موضع_الوحدة, موضع_العنصر
                );
            }
            | عنصر_وحدة.تجميع(_, _) -> { };
            موضع_العنصر := موضع_العنصر + 1;
        }
        موضع_الوحدة := موضع_الوحدة + 1;
    }
    أرجع الفهرس;
}

عام عرف مقبض_تصريح_عند(
    الفهرس: &فهرس_تصريحات,
    الرمز: معرف_رمز
): اختياري مقبض_تصريح {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*الفهرس).بالرمز) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع (*الفهرس).بالرمز[الرمز.القيمة];
}

عام نوع تكرار_تصريح = {
    الموجود: معرف_رمز,
    النطاق: نطاق
};

عام نوع جدول_تصريحات = {
    الوحدة: وحدة_دلالية,
    الرموز: متجه معرف_رمز,
    المكررات: متجه تكرار_تصريح,
    الأهداف_المفقودة: متجه نطاق,
    الأهداف_الخاصة: متجه نطاق,
    تعارضات_الربط: متجه نطاق,
    مرادفات_أب_غير_مطابق: متجه نطاق
};

عرف أضف_تصريحا_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق,
    نطاق_التصريح: نطاق,
    النوع: نوع_تصريح,
    علني: منطقي
): نتيجة_إضافة {
    طابق حل_رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم) مع
    | اختياري.موجود(البدائي) -> {
        أرجع نتيجة_إضافة.مكرر(البدائي, نطاق_التصريح);
    }
    | اختياري.لا_شيء -> { };
    أرجع أضف_رمزا_مصدريا(
        سياق_الأسماء, النطاق, المصدر, نطاق_الاسم, نطاق_التصريح, النوع, علني
    );
}

عرف أضف_اسما_بديلا_لتصريح_مصدري(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق,
    الرمز: معرف_رمز
): نتيجة_إضافة {
    طابق حل_رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم) مع
    | اختياري.موجود(البدائي) -> {
        أرجع نتيجة_إضافة.مكرر(البدائي, نطاق_الاسم);
    }
    | اختياري.لا_شيء -> { };
    أرجع أضف_اسما_بديلا_مصدريا(سياق_الأسماء, النطاق, المصدر, نطاق_الاسم, الرمز);
}

// Program-entry source spellings are consumed exactly once inside Name ownership.
// Arabic `الرئيسية` and English `main` both resolve to the same public semantic fact:
// the already-canonical declaration Symbol. Downstream phases never inspect source text.
عرف رمز_دالة_جذرية_بتهجئة(
    سياق_الأسماء: &سياق_أسماء,
    الجدول: &جدول_تصريحات,
    التهجئة: &نص
): اختياري معرف_رمز {
    طابق هوية_اسم_لنص_إن_وجد(سياق_الأسماء, التهجئة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(هوية_الاسم) -> {
        ليكن القيمة: جدول_تصريحات = *الجدول;
        ليكن الجذر: معرف_نطاق = معرف_نطاق_من(القيمة.الوحدة.النطاق_الجذري.القيمة);
        طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, هوية_الاسم) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختياري.موجود(النوع) -> {
                إذا (النوع == نوع_تصريح.دالة()) { أرجع اختياري.موجود(الرمز); };
            }
            | اختياري.لا_شيء -> { };
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف رمز_بدء_البرنامج_من_تصريحات(
    سياق_الأسماء: &سياق_أسماء,
    الجدول: &جدول_تصريحات
): اختياري معرف_رمز {
    ليكن العربية: نص = «الرئيسية»;
    طابق رمز_دالة_جذرية_بتهجئة(سياق_الأسماء, الجدول, &العربية) مع
    | اختياري.موجود(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | اختياري.لا_شيء -> { };

    ليكن الإنجليزية: نص = «main»;
    أرجع رمز_دالة_جذرية_بتهجئة(سياق_الأسماء, الجدول, &الإنجليزية);
}

عام عرف نوع_دالة_مجمعة(الدالة: &تصريح_دالة): نوع_تصريح {
    ليكن القيمة: تصريح_دالة = *الدالة;
    طابق القيمة.الجسم مع
    | اختياري.لا_شيء -> {
        أرجع نوع_تصريح.دالة_خارجية();
    }
    | اختياري.موجود(الكتلة) -> {
        أرجع نوع_تصريح.دالة();
    };
}

عام عرف نوع_نوع_مجمع(التصريح: &تصريح_نوع): نوع_تصريح {
    ليكن القيمة: تصريح_نوع = *التصريح;
    طابق القيمة.الشكل مع
    | شكل_تصريح_نوع.مرادف(ت) -> {
        أرجع نوع_تصريح.مرادف_نوع();
    }
    | شكل_تصريح_نوع.سجل(ح) -> {
        أرجع نوع_تصريح.سجل();
    }
    | شكل_تصريح_نوع.تعداد(م) -> {
        أرجع نوع_تصريح.تعداد();
    }
    | شكل_تصريح_نوع.معتم(_) -> {
        أرجع نوع_تصريح.معتم();
    };
}

عام عرف اجمع_تصريحات_الوحدة(
    سياق_الأسماء: &متغير سياق_أسماء,
    الوحدة_الدلالية: &وحدة_دلالية,
    الوحدة_النحوية: &وحدة_مصدر,
    المصدر: &مصدر
): جدول_تصريحات {
    ليكن الوحدة: وحدة_دلالية = *الوحدة_الدلالية;
    ليكن الوحدة_المصدرية: وحدة_مصدر = *الوحدة_النحوية;
    ليكن مرجع_المصدر: &مصدر = المصدر;
    ليكن الجذر: معرف_نطاق = معرف_نطاق_من(الوحدة.النطاق_الجذري.القيمة);
    ليكن المقبولة: متغير متجه معرف_رمز = [];
    ليكن المرفوضة: متغير متجه تكرار_تصريح = [];
    ليكن الأهداف_المفقودة: متغير متجه نطاق = [];
    ليكن الأهداف_الخاصة: متغير متجه نطاق = [];
    ليكن تعارضات_الربط: متغير متجه نطاق = [];
    ليكن مرادفات_أب_غير_مطابق: متغير متجه نطاق = [];
    ليكن الفهرس: متغير طبيعي = 0;

    طالما (الفهرس < (الطول(الوحدة_المصدرية.العناصر) مثل طبيعي)) {
        ليكن مرجع_العنصر: &عنصر_وحدة = &الوحدة_المصدرية.العناصر[الفهرس];
        طابق *مرجع_العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            ليكن النتيجة: نتيجة_إضافة = أضف_تصريحا_مصدريا(
                سياق_الأسماء,
                الجذر,
                مرجع_المصدر,
                الدالة.الاسم.النطاق,
                الدالة.النطاق,
                نوع_دالة_مجمعة(&الدالة),
                الدالة.علني
            );
            طابق النتيجة مع
            | نتيجة_إضافة.أضيف(المعرف) -> {
                ألحق(المقبولة, المعرف);
                ليكن فهرس_البديل: متغير طبيعي = 0;
                طالما (فهرس_البديل < (الطول(الدالة.الأسماء_البديلة) مثل طبيعي)) {
                    ليكن البديل: اسم = الدالة.الأسماء_البديلة[فهرس_البديل];
                    ليكن نتيجة_البديل: نتيجة_إضافة = أضف_اسما_بديلا_لتصريح_مصدري(
                        سياق_الأسماء,
                        الجذر,
                        مرجع_المصدر,
                        البديل.النطاق,
                        المعرف
                    );
                    طابق نتيجة_البديل مع
                    | نتيجة_إضافة.أضيف(نفس_المعرف) -> {
                    }
                    | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                        ليكن تكرار_البديل: تكرار_تصريح = {
                            الموجود: الموجود,
                            النطاق: نطاق_الجديد
                        };
                        ألحق(المرفوضة, تكرار_البديل);
                    };
                    فهرس_البديل := فهرس_البديل + 1;
                }
            }
            | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                ليكن التكرار: تكرار_تصريح = {
                    الموجود: الموجود,
                    النطاق: نطاق_الجديد
                };
                ألحق(المرفوضة, التكرار);
            };
        }
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            ليكن النتيجة: نتيجة_إضافة = أضف_تصريحا_مصدريا(
                سياق_الأسماء,
                الجذر,
                مرجع_المصدر,
                التصريح.الاسم.النطاق,
                التصريح.النطاق,
                نوع_تصريح.قيمة_عليا(),
                التصريح.علني
            );
            طابق النتيجة مع
            | نتيجة_إضافة.أضيف(المعرف) -> { ألحق(المقبولة, المعرف); }
            | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                ليكن التكرار: تكرار_تصريح = { الموجود: الموجود, النطاق: نطاق_الجديد };
                ألحق(المرفوضة, التكرار);
            };
        }
        | عنصر_وحدة.نوع(التصريح) -> {
            ليكن النتيجة: نتيجة_إضافة = أضف_تصريحا_مصدريا(
                سياق_الأسماء,
                الجذر,
                مرجع_المصدر,
                التصريح.الاسم.النطاق,
                التصريح.النطاق,
                نوع_نوع_مجمع(&التصريح),
                التصريح.علني
            );
            طابق النتيجة مع
            | نتيجة_إضافة.أضيف(المعرف) -> {
                ألحق(المقبولة, المعرف);
                طابق التصريح.الشكل مع
                | شكل_تصريح_نوع.تعداد(المنشئات) -> {
                    ليكن فهرس_المنشئ: متغير طبيعي = 0;
                    طالما (فهرس_المنشئ < (الطول(المنشئات) مثل طبيعي)) {
                        ليكن مرجع_المنشئ: &منشئ_نوع = &المنشئات[فهرس_المنشئ];
                        ليكن المنشئ: منشئ_نوع = *مرجع_المنشئ;
                        ليكن نطاق_الاسم: نطاق = المنشئ.الاسم.النطاق;
                        ليكن نتيجة_المنشئ: نتيجة_إضافة = أضف_رمزا_تابعا_مصدريا(
                            سياق_الأسماء,
                            الجذر,
                            المعرف,
                            مرجع_المصدر,
                            نطاق_الاسم,
                            نطاق_الاسم,
                            نوع_تصريح.منشئ_تعداد(),
                            التصريح.علني
                        );
                        طابق نتيجة_المنشئ مع
                        | نتيجة_إضافة.أضيف(معرف_المنشئ) -> {
                            ألحق(المقبولة, معرف_المنشئ);
                        }
                        | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                            ليكن تكرار_المنشئ: تكرار_تصريح = {
                                الموجود: الموجود,
                                النطاق: نطاق_الجديد
                            };
                            ألحق(المرفوضة, تكرار_المنشئ);
                        };
                        فهرس_المنشئ := فهرس_المنشئ + 1;
                    }
                }
                | شكل_تصريح_نوع.مرادف(ت) -> {
                }
                | شكل_تصريح_نوع.سجل(ح) -> {
                }
                | شكل_تصريح_نوع.معتم(_) -> {
                };
            }
            | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                ليكن التكرار: تكرار_تصريح = {
                    الموجود: الموجود,
                    النطاق: نطاق_الجديد
                };
                ألحق(المرفوضة, التكرار);
            };
        }
        | عنصر_وحدة.تجميع(نطاق_تجميع, تعليمات) -> {
        };
        الفهرس := الفهرس + 1;
    }

    ليكن فهرس_المرادف: متغير طبيعي = 0;
    طالما (فهرس_المرادف < (الطول(الوحدة_المصدرية.مرادفات_الأسماء) مثل طبيعي)) {
        ليكن التصريح: تصريح_مرادف_اسم = الوحدة_المصدرية.مرادفات_الأسماء[فهرس_المرادف];
        طابق التصريح.أب_الوجهة مع
        | اختياري.لا_شيء -> {
            طابق التصريح.أب_الهدف مع
            | اختياري.موجود(أب_الهدف) -> {
                // `عام مرادف NAME = IMPORT.NAME;` re-exports a name of the module that
                // IMPORT (an `as` import) names. It is bound once every module's
                // declarations exist (اربط_مرادفات_إعادة_التصدير, names/semantic_pipeline.sn).
                إذا (!التصريح.علني) {
                    ألحق(مرادفات_أب_غير_مطابق, أب_الهدف.النطاق);
                };
            }
            | اختياري.لا_شيء -> {
                ليكن هوية_الهدف: معرف_اسم = قنن_اسما_مصدريا(
                    سياق_الأسماء, مرجع_المصدر, التصريح.الهدف.النطاق
                );
                ليكن رمز_الهدف_المحلي: اختياري معرف_رمز = حل_هدف_مرادف_غير_مؤهل(
                    سياق_الأسماء, الجذر, هوية_الهدف, التصريح.علني
                );
                طابق رمز_الهدف_المحلي مع
                | اختياري.لا_شيء -> {
                    ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                }
                | اختياري.موجود(رمز_الهدف) -> {
                    طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, رمز_الهدف) مع
                    | اختياري.لا_شيء -> {
                        ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                    }
                    | اختياري.موجود(نطاق_الهدف) -> {
                        إذا (نطاق_الهدف.البداية.البايت >= التصريح.الاسم.النطاق.البداية.البايت) {
                            ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                        } وإلا {
                            ليكن هوية_المرادف: معرف_اسم = قنن_اسما_مصدريا(
                                سياق_الأسماء, مرجع_المصدر, التصريح.الاسم.النطاق
                            );
                            إذا (معرفا_اسم_متساويان(هوية_المرادف, هوية_الهدف)) {
                                ليكن التكرار: تكرار_تصريح = {
                                    الموجود: رمز_الهدف,
                                    النطاق: التصريح.الاسم.النطاق
                                };
                                ألحق(المرفوضة, التكرار);
                            } وإلا {
                                طابق علنية_رمز_عند(سياق_الأسماء, رمز_الهدف) مع
                                | اختياري.موجود(علني) -> {
                                    // Preserve existing alias visibility: public aliases target public
                                    // symbols and private aliases target private symbols, including intrinsics.
                                    إذا ((التصريح.علني && علني) || (!التصريح.علني && !علني)) {
                                        ليكن نتيجة_المرادف: نتيجة_إضافة = أضف_اسما_بديلا_لتصريح_مصدري(
                                            سياق_الأسماء,
                                            الجذر,
                                            مرجع_المصدر,
                                            التصريح.الاسم.النطاق,
                                            رمز_الهدف
                                        );
                                        طابق نتيجة_المرادف مع
                                        | نتيجة_إضافة.أضيف(نفس_الرمز) -> {
                                            إذا (!معرفا_رمز_متساويان(نفس_الرمز, رمز_الهدف)) {
                                                ليكن التكرار: تكرار_تصريح = {
                                                    الموجود: نفس_الرمز,
                                                    النطاق: التصريح.الاسم.النطاق
                                                };
                                                ألحق(المرفوضة, التكرار);
                                            };
                                        }
                                        | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                                            ليكن التكرار: تكرار_تصريح = {
                                                الموجود: الموجود,
                                                النطاق: نطاق_الجديد
                                            };
                                            ألحق(المرفوضة, التكرار);
                                        };
                                    } وإلا {
                                        ألحق(الأهداف_الخاصة, التصريح.الهدف.النطاق);
                                    };
                                }
                                | اختياري.لا_شيء -> {
                                    ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                };
                            };
                        };
                    };
                };
            };
        }
        | اختياري.موجود(أب_الوجهة) -> {
            طابق التصريح.أب_الهدف مع
            | اختياري.لا_شيء -> {
                ألحق(مرادفات_أب_غير_مطابق, التصريح.الهدف.النطاق);
            }
            | اختياري.موجود(أب_الهدف) -> {
                ليكن هوية_أب_الوجهة: معرف_اسم = قنن_اسما_مصدريا(
                    سياق_الأسماء, مرجع_المصدر, أب_الوجهة.النطاق
                );
                ليكن هوية_أب_الهدف: معرف_اسم = قنن_اسما_مصدريا(
                    سياق_الأسماء, مرجع_المصدر, أب_الهدف.النطاق
                );
                طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, هوية_أب_الوجهة) مع
                | اختياري.لا_شيء -> {
                    ألحق(الأهداف_المفقودة, أب_الوجهة.النطاق);
                }
                | اختياري.موجود(رمز_أب_الوجهة) -> {
                    طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, هوية_أب_الهدف) مع
                    | اختياري.لا_شيء -> {
                        ألحق(الأهداف_المفقودة, أب_الهدف.النطاق);
                    }
                    | اختياري.موجود(رمز_أب_الهدف) -> {
                        إذا (!معرفا_رمز_متساويان(رمز_أب_الوجهة, رمز_أب_الهدف)) {
                            ألحق(مرادفات_أب_غير_مطابق, أب_الهدف.النطاق);
                        } وإلا {
                            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, رمز_أب_الهدف) مع
                            | اختياري.لا_شيء -> {
                                ألحق(الأهداف_المفقودة, أب_الهدف.النطاق);
                            }
                            | اختياري.موجود(نطاق_الأب) -> {
                                إذا (نطاق_الأب.البداية.البايت >= التصريح.الاسم.النطاق.البداية.البايت) {
                                    ألحق(الأهداف_المفقودة, أب_الهدف.النطاق);
                                } وإلا {
                                    طابق علنية_رمز_عند(سياق_الأسماء, رمز_أب_الهدف) مع
                                    | اختياري.لا_شيء -> {
                                        ألحق(الأهداف_المفقودة, أب_الهدف.النطاق);
                                    }
                                    | اختياري.موجود(علنية_الأب) -> {
                                        إذا (التصريح.علني && !علنية_الأب) {
                                            ألحق(الأهداف_الخاصة, أب_الهدف.النطاق);
                                        } وإلا {
                                            ليكن هوية_الهدف: معرف_اسم = قنن_اسما_مصدريا(
                                                سياق_الأسماء, مرجع_المصدر, التصريح.الهدف.النطاق
                                            );
                                            طابق ابحث_رمزا_تابعا_بهوية(
                                                سياق_الأسماء, رمز_أب_الهدف, هوية_الهدف
                                            ) مع
                                            | اختياري.لا_شيء -> {
                                                ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                            }
                                            | اختياري.موجود(رمز_الهدف) -> {
                                                طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, رمز_الهدف) مع
                                                | اختياري.لا_شيء -> {
                                                    ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                                }
                                                | اختياري.موجود(نطاق_الهدف) -> {
                                                    إذا (
                                                        نطاق_الهدف.البداية.البايت
                                                        >= التصريح.الاسم.النطاق.البداية.البايت
                                                    ) {
                                                        ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                                    } وإلا {
                                                        طابق علنية_رمز_عند(سياق_الأسماء, رمز_الهدف) مع
                                                        | اختياري.لا_شيء -> {
                                                            ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                                        }
                                                        | اختياري.موجود(علنية_الهدف) -> {
                                                            إذا (التصريح.علني && !علنية_الهدف) {
                                                                ألحق(الأهداف_الخاصة, التصريح.الهدف.النطاق);
                                                            } وإلا {
                                                                ليكن هوية_المرادف: معرف_اسم = قنن_اسما_مصدريا(
                                                                    سياق_الأسماء,
                                                                    مرجع_المصدر,
                                                                    التصريح.الاسم.النطاق
                                                                );
                                                                إذا (معرفا_اسم_متساويان(هوية_المرادف, هوية_الهدف)) {
                                                                    ليكن التكرار: تكرار_تصريح = {
                                                                        الموجود: رمز_الهدف,
                                                                        النطاق: التصريح.الاسم.النطاق
                                                                    };
                                                                    ألحق(المرفوضة, التكرار);
                                                                } وإلا {
                                                                    ليكن نتيجة_المرادف: نتيجة_إضافة =
                                                                        أضف_اسما_بديلا_تابعا_مصدريا(
                                                                            سياق_الأسماء,
                                                                            رمز_أب_الوجهة,
                                                                            مرجع_المصدر,
                                                                            التصريح.الاسم.النطاق,
                                                                            رمز_الهدف
                                                                        );
                                                                    طابق نتيجة_المرادف مع
                                                                    | نتيجة_إضافة.أضيف(نفس_الرمز) -> {
                                                                        إذا (!معرفا_رمز_متساويان(نفس_الرمز, رمز_الهدف)) {
                                                                            ألحق(تعارضات_الربط, التصريح.الاسم.النطاق);
                                                                        };
                                                                    }
                                                                    | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                                                                        ليكن التكرار: تكرار_تصريح = {
                                                                            الموجود: الموجود,
                                                                            النطاق: نطاق_الجديد
                                                                        };
                                                                        ألحق(المرفوضة, التكرار);
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
        فهرس_المرادف := فهرس_المرادف + 1;
    }

    ليكن الجدول: جدول_تصريحات = {
        الوحدة: الوحدة,
        الرموز: المقبولة,
        المكررات: المرفوضة,
        الأهداف_المفقودة: الأهداف_المفقودة,
        الأهداف_الخاصة: الأهداف_الخاصة,
        تعارضات_الربط: تعارضات_الربط,
        مرادفات_أب_غير_مطابق: مرادفات_أب_غير_مطابق
    };
    أرجع الجدول;
}
