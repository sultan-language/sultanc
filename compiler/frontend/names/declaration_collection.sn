عام نوع تكرار_تصريح = {
    الموجود: معرف_رمز,
    النطاق: نطاق
};

عام نوع جدول_تصريحات = {
    الوحدة: وحدة_دلالية,
    الرموز: متجه معرف_رمز,
    المكررات: متجه تكرار_تصريح,
    الأهداف_المفقودة: متجه نطاق,
    الأهداف_الخاصة: متجه نطاق,
    تعارضات_الربط: متجه نطاق
};


عرف أضف_تصريحا_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق,
    نطاق_التصريح: نطاق,
    النوع: نوع_تصريح,
    علني: منطقي
): نتيجة_إضافة {
    طابق حل_رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم) مع
    | اختيار.بعض(البدائي) -> {
        أرجع نتيجة_إضافة.مكرر(البدائي, نطاق_التصريح);
    }
    | اختيار.لا_شيء -> { };
    أرجع أضف_رمزا_مصدريا(
        سياق_الأسماء, النطاق, المصدر, نطاق_الاسم, نطاق_التصريح, النوع, علني
    );
}

عرف أضف_اسما_بديلا_لتصريح_مصدري(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق,
    الرمز: معرف_رمز
): نتيجة_إضافة {
    طابق حل_رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم) مع
    | اختيار.بعض(البدائي) -> {
        أرجع نتيجة_إضافة.مكرر(البدائي, نطاق_الاسم);
    }
    | اختيار.لا_شيء -> { };
    أرجع أضف_اسما_بديلا_مصدريا(سياق_الأسماء, النطاق, المصدر, نطاق_الاسم, الرمز);
}

// Program-entry source spellings are consumed exactly once inside Name ownership.
// Arabic `القلعة` and English `main` both resolve to the same public semantic fact:
// the already-canonical declaration Symbol. Downstream phases never inspect source text.
عرف رمز_دالة_جذرية_بتهجئة(
    سياق_الأسماء: &سياق_أسماء,
    الجدول: &جدول_تصريحات,
    التهجئة: &نص
): اختيار معرف_رمز {
    طابق هوية_اسم_لنص_إن_وجد(سياق_الأسماء, التهجئة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(هوية_الاسم) -> {
        دع القيمة: جدول_تصريحات = *الجدول;
        دع الجذر: معرف_نطاق = معرف_نطاق_من(القيمة.الوحدة.النطاق_الجذري.القيمة);
        طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, هوية_الاسم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الرمز) -> {
            طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
            | اختيار.بعض(النوع) -> {
                لو (النوع == نوع_تصريح.دالة()) { أرجع اختيار.بعض(الرمز); };
            }
            | اختيار.لا_شيء -> { };
            أرجع اختيار.لا_شيء();
        };
    };
}

عام عرف رمز_بدء_البرنامج_من_تصريحات(
    سياق_الأسماء: &سياق_أسماء,
    الجدول: &جدول_تصريحات
): اختيار معرف_رمز {
    دع العربية: نص = «القلعة»;
    طابق رمز_دالة_جذرية_بتهجئة(سياق_الأسماء, الجدول, &العربية) مع
    | اختيار.بعض(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | اختيار.لا_شيء -> { };

    دع الإنجليزية: نص = «main»;
    أرجع رمز_دالة_جذرية_بتهجئة(سياق_الأسماء, الجدول, &الإنجليزية);
}

عام عرف نوع_دالة_مجمعة(الدالة: &تصريح_دالة): نوع_تصريح {
    دع القيمة: تصريح_دالة = *الدالة;
    طابق القيمة.الجسم مع
    | اختيار.لا_شيء -> {
        أرجع نوع_تصريح.دالة_خارجية();
    }
    | اختيار.بعض(الكتلة) -> {
        أرجع نوع_تصريح.دالة();
    };
}

عام عرف نوع_نوع_مجمع(التصريح: &تصريح_نوع): نوع_تصريح {
    دع القيمة: تصريح_نوع = *التصريح;
    طابق القيمة.الشكل مع
    | شكل_تصريح_نوع.مرادف(ت) -> {
        أرجع نوع_تصريح.مرادف_نوع();
    }
    | شكل_تصريح_نوع.سجل(ح) -> {
        أرجع نوع_تصريح.سجل();
    }
    | شكل_تصريح_نوع.تعداد(م) -> {
        أرجع نوع_تصريح.تعداد();
    };
}

عام عرف اجمع_تصريحات_الوحدة(
    سياق_الأسماء: &متغير سياق_أسماء,
    الوحدة_الدلالية: &وحدة_دلالية,
    الوحدة_النحوية: &وحدة_مصدر
): جدول_تصريحات {
    دع الوحدة_المصدرية: وحدة_مصدر = *الوحدة_النحوية;
    دع مرجع_المصدر: &مصدر = &الوحدة_المصدرية.المصدر;
    دع الوحدة: وحدة_دلالية = *الوحدة_الدلالية;
    دع الجذر: معرف_نطاق = معرف_نطاق_من(الوحدة.النطاق_الجذري.القيمة);
    دع المقبولة: متغير متجه معرف_رمز = [];
    دع المرفوضة: متغير متجه تكرار_تصريح = [];
    دع الأهداف_المفقودة: متغير متجه نطاق = [];
    دع الأهداف_الخاصة: متغير متجه نطاق = [];
    دع تعارضات_الربط: متغير متجه نطاق = [];
    دع الفهرس: متغير غير_موقع = 0;

    بينما (الفهرس < (الطول(الوحدة_المصدرية.العناصر) مثل غير_موقع)) {
        دع مرجع_العنصر: &عنصر_وحدة = &الوحدة_المصدرية.العناصر[الفهرس];
        دع العنصر: عنصر_وحدة = *مرجع_العنصر;
        طابق العنصر مع
        | عنصر_وحدة.دالة(الدالة) -> {
            دع النتيجة: نتيجة_إضافة = أضف_تصريحا_مصدريا(
                سياق_الأسماء,
                الجذر,
                مرجع_المصدر,
                الدالة.الاسم.النطاق,
                الدالة.النطاق,
                نوع_دالة_مجمعة(&الدالة),
                الدالة.علني
            );
            طابق النتيجة مع
            | نتيجة_إضافة.أضيف(المعرف) -> {
                ألحق(المقبولة, المعرف);
                دع فهرس_البديل: متغير غير_موقع = 0;
                بينما (فهرس_البديل < (الطول(الدالة.الأسماء_البديلة) مثل غير_موقع)) {
                    دع البديل: اسم = الدالة.الأسماء_البديلة[فهرس_البديل];
                    دع نتيجة_البديل: نتيجة_إضافة = أضف_اسما_بديلا_لتصريح_مصدري(
                        سياق_الأسماء,
                        الجذر,
                        مرجع_المصدر,
                        البديل.النطاق,
                        المعرف
                    );
                    طابق نتيجة_البديل مع
                    | نتيجة_إضافة.أضيف(نفس_المعرف) -> {
                    }
                    | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                        دع تكرار_البديل: تكرار_تصريح = {
                            الموجود: الموجود,
                            النطاق: نطاق_الجديد
                        };
                        ألحق(المرفوضة, تكرار_البديل);
                    };
                    فهرس_البديل := فهرس_البديل + 1;
                }
            }
            | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                دع التكرار: تكرار_تصريح = {
                    الموجود: الموجود,
                    النطاق: نطاق_الجديد
                };
                ألحق(المرفوضة, التكرار);
            };
        }
        | عنصر_وحدة.نوع(التصريح) -> {
            دع النتيجة: نتيجة_إضافة = أضف_تصريحا_مصدريا(
                سياق_الأسماء,
                الجذر,
                مرجع_المصدر,
                التصريح.الاسم.النطاق,
                التصريح.النطاق,
                نوع_نوع_مجمع(&التصريح),
                التصريح.علني
            );
            طابق النتيجة مع
            | نتيجة_إضافة.أضيف(المعرف) -> {
                ألحق(المقبولة, المعرف);
                طابق التصريح.الشكل مع
                | شكل_تصريح_نوع.تعداد(المنشئات) -> {
                    دع فهرس_المنشئ: متغير غير_موقع = 0;
                    بينما (فهرس_المنشئ < (الطول(المنشئات) مثل غير_موقع)) {
                        دع مرجع_المنشئ: &منشئ_نوع = &المنشئات[فهرس_المنشئ];
                        دع المنشئ: منشئ_نوع = *مرجع_المنشئ;
                        دع نطاق_الاسم: نطاق = المنشئ.الاسم.النطاق;
                        دع نتيجة_المنشئ: نتيجة_إضافة = أضف_رمزا_تابعا_مصدريا(
                            سياق_الأسماء,
                            الجذر,
                            المعرف,
                            مرجع_المصدر,
                            نطاق_الاسم,
                            نطاق_الاسم,
                            نوع_تصريح.منشئ_تعداد(),
                            التصريح.علني
                        );
                        طابق نتيجة_المنشئ مع
                        | نتيجة_إضافة.أضيف(معرف_المنشئ) -> {
                            ألحق(المقبولة, معرف_المنشئ);
                        }
                        | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                            دع تكرار_المنشئ: تكرار_تصريح = {
                                الموجود: الموجود,
                                النطاق: نطاق_الجديد
                            };
                            ألحق(المرفوضة, تكرار_المنشئ);
                        };
                        فهرس_المنشئ := فهرس_المنشئ + 1;
                    }
                }
                | شكل_تصريح_نوع.مرادف(ت) -> {
                }
                | شكل_تصريح_نوع.سجل(ح) -> {
                };
            }
            | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                دع التكرار: تكرار_تصريح = {
                    الموجود: الموجود,
                    النطاق: نطاق_الجديد
                };
                ألحق(المرفوضة, التكرار);
            };
        }
        | عنصر_وحدة.تجميع(نطاق_تجميع, تعليمات) -> {
        };
        الفهرس := الفهرس + 1;
    }

    دع فهرس_المرادف: متغير غير_موقع = 0;
    بينما (فهرس_المرادف < (الطول(الوحدة_المصدرية.مرادفات_الأسماء) مثل غير_موقع)) {
        دع التصريح: تصريح_مرادف_اسم = الوحدة_المصدرية.مرادفات_الأسماء[فهرس_المرادف];
        طابق التصريح.أب_الوجهة مع
        | اختيار.لا_شيء -> {
            طابق التصريح.أب_الهدف مع
            | اختيار.بعض(أب_الهدف) -> {
                ألحق(تعارضات_الربط, أب_الهدف.النطاق);
            }
            | اختيار.لا_شيء -> {
                دع هوية_الهدف: معرف_اسم = قنن_اسما_مصدريا(
                    سياق_الأسماء, مرجع_المصدر, التصريح.الهدف.النطاق
                );
                دع رمز_الهدف_المحلي: متغير اختيار معرف_رمز = اختيار.لا_شيء();
                لو (التصريح.علني) {
                    رمز_الهدف_المحلي := ابحث_محليا_بهوية(
                        سياق_الأسماء, الجذر, هوية_الهدف
                    );
                } وإلا لو (وحدة_تسمح_بجسر_بدائي_داخلي(&الوحدة)) {
                    // Private intrinsic aliases are a Module capability, not general source syntax.
                    رمز_الهدف_المحلي := حل_رمز_بدائي_بهوية(سياق_الأسماء, هوية_الهدف);
                };
                طابق رمز_الهدف_المحلي مع
                | اختيار.لا_شيء -> {
                    ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                }
                | اختيار.بعض(رمز_الهدف) -> {
                    طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, رمز_الهدف) مع
                    | اختيار.لا_شيء -> {
                        ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                    }
                    | اختيار.بعض(نطاق_الهدف) -> {
                        لو (نطاق_الهدف.البداية.البايت >= التصريح.الاسم.النطاق.البداية.البايت) {
                            ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                        } وإلا {
                            دع هوية_المرادف: معرف_اسم = قنن_اسما_مصدريا(
                                سياق_الأسماء, مرجع_المصدر, التصريح.الاسم.النطاق
                            );
                            لو (معرفا_اسم_متساويان(هوية_المرادف, هوية_الهدف)) {
                                دع التكرار: تكرار_تصريح = {
                                    الموجود: رمز_الهدف,
                                    النطاق: التصريح.الاسم.النطاق
                                };
                                ألحق(المرفوضة, التكرار);
                            } وإلا {
                                طابق علنية_رمز_عند(سياق_الأسماء, رمز_الهدف) مع
                                | اختيار.بعض(علني) -> {
                                    // Public aliases may only re-export public ordinary symbols.
                                    // Private aliases may only reach hidden primitive symbols; those
                                    // symbols themselves remain private to imported modules.
                                    لو ((التصريح.علني && علني) || (!التصريح.علني && !علني)) {
                                        دع نتيجة_المرادف: نتيجة_إضافة = أضف_اسما_بديلا_لتصريح_مصدري(
                                            سياق_الأسماء,
                                            الجذر,
                                            مرجع_المصدر,
                                            التصريح.الاسم.النطاق,
                                            رمز_الهدف
                                        );
                                        طابق نتيجة_المرادف مع
                                        | نتيجة_إضافة.أضيف(نفس_الرمز) -> {
                                            لو (!معرفا_رمز_متساويان(نفس_الرمز, رمز_الهدف)) {
                                                دع التكرار: تكرار_تصريح = {
                                                    الموجود: نفس_الرمز,
                                                    النطاق: التصريح.الاسم.النطاق
                                                };
                                                ألحق(المرفوضة, التكرار);
                                            };
                                        }
                                        | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                                            دع التكرار: تكرار_تصريح = {
                                                الموجود: الموجود,
                                                النطاق: نطاق_الجديد
                                            };
                                            ألحق(المرفوضة, التكرار);
                                        };
                                    } وإلا {
                                        ألحق(الأهداف_الخاصة, التصريح.الهدف.النطاق);
                                    };
                                }
                                | اختيار.لا_شيء -> {
                                    ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                };
                            };
                        };
                    };
                };
            };
        }
        | اختيار.بعض(أب_الوجهة) -> {
            طابق التصريح.أب_الهدف مع
            | اختيار.لا_شيء -> {
                ألحق(تعارضات_الربط, التصريح.الهدف.النطاق);
            }
            | اختيار.بعض(أب_الهدف) -> {
                دع هوية_أب_الوجهة: معرف_اسم = قنن_اسما_مصدريا(
                    سياق_الأسماء, مرجع_المصدر, أب_الوجهة.النطاق
                );
                دع هوية_أب_الهدف: معرف_اسم = قنن_اسما_مصدريا(
                    سياق_الأسماء, مرجع_المصدر, أب_الهدف.النطاق
                );
                طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, هوية_أب_الوجهة) مع
                | اختيار.لا_شيء -> {
                    ألحق(الأهداف_المفقودة, أب_الوجهة.النطاق);
                }
                | اختيار.بعض(رمز_أب_الوجهة) -> {
                    طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, هوية_أب_الهدف) مع
                    | اختيار.لا_شيء -> {
                        ألحق(الأهداف_المفقودة, أب_الهدف.النطاق);
                    }
                    | اختيار.بعض(رمز_أب_الهدف) -> {
                        لو (!معرفا_رمز_متساويان(رمز_أب_الوجهة, رمز_أب_الهدف)) {
                            ألحق(تعارضات_الربط, أب_الهدف.النطاق);
                        } وإلا {
                            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, رمز_أب_الهدف) مع
                            | اختيار.لا_شيء -> {
                                ألحق(الأهداف_المفقودة, أب_الهدف.النطاق);
                            }
                            | اختيار.بعض(نطاق_الأب) -> {
                                لو (نطاق_الأب.البداية.البايت >= التصريح.الاسم.النطاق.البداية.البايت) {
                                    ألحق(الأهداف_المفقودة, أب_الهدف.النطاق);
                                } وإلا {
                                    طابق علنية_رمز_عند(سياق_الأسماء, رمز_أب_الهدف) مع
                                    | اختيار.لا_شيء -> {
                                        ألحق(الأهداف_المفقودة, أب_الهدف.النطاق);
                                    }
                                    | اختيار.بعض(علنية_الأب) -> {
                                        لو (التصريح.علني && !علنية_الأب) {
                                            ألحق(الأهداف_الخاصة, أب_الهدف.النطاق);
                                        } وإلا {
                                            دع هوية_الهدف: معرف_اسم = قنن_اسما_مصدريا(
                                                سياق_الأسماء, مرجع_المصدر, التصريح.الهدف.النطاق
                                            );
                                            طابق ابحث_رمزا_تابعا_بهوية(
                                                سياق_الأسماء, رمز_أب_الهدف, هوية_الهدف
                                            ) مع
                                            | اختيار.لا_شيء -> {
                                                ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                            }
                                            | اختيار.بعض(رمز_الهدف) -> {
                                                طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, رمز_الهدف) مع
                                                | اختيار.لا_شيء -> {
                                                    ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                                }
                                                | اختيار.بعض(نطاق_الهدف) -> {
                                                    لو (
                                                        نطاق_الهدف.البداية.البايت
                                                        >= التصريح.الاسم.النطاق.البداية.البايت
                                                    ) {
                                                        ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                                    } وإلا {
                                                        طابق علنية_رمز_عند(سياق_الأسماء, رمز_الهدف) مع
                                                        | اختيار.لا_شيء -> {
                                                            ألحق(الأهداف_المفقودة, التصريح.الهدف.النطاق);
                                                        }
                                                        | اختيار.بعض(علنية_الهدف) -> {
                                                            لو (التصريح.علني && !علنية_الهدف) {
                                                                ألحق(الأهداف_الخاصة, التصريح.الهدف.النطاق);
                                                            } وإلا {
                                                                دع هوية_المرادف: معرف_اسم = قنن_اسما_مصدريا(
                                                                    سياق_الأسماء,
                                                                    مرجع_المصدر,
                                                                    التصريح.الاسم.النطاق
                                                                );
                                                                لو (معرفا_اسم_متساويان(هوية_المرادف, هوية_الهدف)) {
                                                                    دع التكرار: تكرار_تصريح = {
                                                                        الموجود: رمز_الهدف,
                                                                        النطاق: التصريح.الاسم.النطاق
                                                                    };
                                                                    ألحق(المرفوضة, التكرار);
                                                                } وإلا {
                                                                    دع نتيجة_المرادف: نتيجة_إضافة =
                                                                        أضف_اسما_بديلا_تابعا_مصدريا(
                                                                        سياق_الأسماء,
                                                                        رمز_أب_الوجهة,
                                                                        مرجع_المصدر,
                                                                        التصريح.الاسم.النطاق,
                                                                        رمز_الهدف
                                                                    );
                                                                    طابق نتيجة_المرادف مع
                                                                    | نتيجة_إضافة.أضيف(نفس_الرمز) -> {
                                                                        لو (!معرفا_رمز_متساويان(نفس_الرمز, رمز_الهدف)) {
                                                                            ألحق(تعارضات_الربط, التصريح.الاسم.النطاق);
                                                                        };
                                                                    }
                                                                    | نتيجة_إضافة.مكرر(الموجود, نطاق_الجديد) -> {
                                                                        دع التكرار: تكرار_تصريح = {
                                                                            الموجود: الموجود,
                                                                            النطاق: نطاق_الجديد
                                                                        };
                                                                        ألحق(المرفوضة, التكرار);
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
        فهرس_المرادف := فهرس_المرادف + 1;
    }

    دع الجدول: جدول_تصريحات = {
        الوحدة: الوحدة,
        الرموز: المقبولة,
        المكررات: المرفوضة,
        الأهداف_المفقودة: الأهداف_المفقودة,
        الأهداف_الخاصة: الأهداف_الخاصة,
        تعارضات_الربط: تعارضات_الربط
    };
    أرجع الجدول;
}
