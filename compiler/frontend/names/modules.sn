استورد المكتبة.نصوص.من_بايتات;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.name_context;
استورد compiler.source.span;

// Module graph owns dense Module IDs and the exact semantics of each direct
// import edge. Selective imports carry only the source names explicitly exposed
// to the importing scope; Name consumes this fact without reconstructing syntax.
عام نوع وحدة_دلالية = {
    المعرف: معرف_وحدة,
    النطاق_الجذري: معرف_نطاق,
    معرف_المصدر: طبيعي
};

عام نوع اسم_استيراد_انتقائي = {
    الهوية: متجه ط8,
    النطاق: نطاق
};

عام نوع مرادف_استيراد_وحدة = {
    الهوية: متجه ط8,
    النطاق: نطاق
};

عام نوع سياسة_استيراد_وحدة =
    | كامل
    | مسمى بنوع مرادف_استيراد_وحدة
    | انتقائي بنوع متجه اسم_استيراد_انتقائي
;

عام نوع حافة_استيراد_وحدة = {
    الوحدة: معرف_وحدة,
    السياسة: سياسة_استيراد_وحدة
};

// تعيد_التصدير: a module generated from a C import (compiler/jisr). C
// imports share the declarations they have in common: one declares a type
// or a prototype and the others import it (a plain quoted import of that
// C module) instead of declaring it again, so the declaration and its type
// are one. Such a module's public names include those of the C modules it
// imports plainly, as if declared there (C's own view: a header includes
// another), so an importer of only one of them still sees them.
نوع وحدة_في_رسم = {
    الدلالية: وحدة_دلالية,
    الاستيرادات: متجه حافة_استيراد_وحدة,
    تعيد_التصدير: منطقي
};

عام نوع رسم_وحدات = {
    معرف_الوحدة_التالي: طبيعي,
    الوحدات: متجه وحدة_في_رسم
};

عام عرف رسم_وحدات_جديد(): رسم_وحدات {
    ليكن الوحدات: متجه وحدة_في_رسم = [];
    ليكن الرسم: رسم_وحدات = {
        معرف_الوحدة_التالي: 0,
        الوحدات: الوحدات
    };
    أرجع الرسم;
}

عام عرف خصص_معرف_وحدة(الرسم: &متغير رسم_وحدات): معرف_وحدة {
    ليكن المعرف: معرف_وحدة = معرف_وحدة_من((*الرسم).معرف_الوحدة_التالي);
    (*الرسم).معرف_الوحدة_التالي := (*الرسم).معرف_الوحدة_التالي + 1;
    أرجع المعرف;
}

عام عرف وحدة_في_الرسم(
    الرسم: &رسم_وحدات,
    المعرف: معرف_وحدة
): اختياري وحدة_دلالية {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*الرسم).الوحدات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*الرسم).الوحدات[المعرف.القيمة].الدلالية);
}

عام عرف أضف_وحدة_للرسم(
    الرسم: &متغير رسم_وحدات,
    الوحدة: وحدة_دلالية
): فراغ {
    ليكن الاستيرادات: متجه حافة_استيراد_وحدة = [];
    ليكن المسجلة: وحدة_في_رسم = {
        الدلالية: الوحدة,
        الاستيرادات: الاستيرادات,
        تعيد_التصدير: خطأ
    };
    ألحق((*الرسم).الوحدات, المسجلة);
}

// Marks a module generated from a C import (see وحدة_في_رسم).
عام عرف علم_وحدة_سي_في_الرسم(الرسم: &متغير رسم_وحدات, المعرف: معرف_وحدة): فراغ {
    إذا ((المعرف.القيمة مثل طبيعي) < (الطول((*الرسم).الوحدات) مثل طبيعي)) {
        (*الرسم).الوحدات[المعرف.القيمة].تعيد_التصدير := صواب;
    };
}

عام عرف وحدة_سي_في_الرسم(الرسم: &رسم_وحدات, المعرف: معرف_وحدة): منطقي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*الرسم).الوحدات) مثل طبيعي)) { أرجع خطأ; };
    أرجع (*الرسم).الوحدات[المعرف.القيمة].تعيد_التصدير;
}

عام عرف أضف_استيرادا(
    الرسم: &متغير رسم_وحدات,
    المستورد: معرف_وحدة,
    المستورد_منه: معرف_وحدة
): فراغ {
    ليكن السياسة: سياسة_استيراد_وحدة = سياسة_استيراد_وحدة.كامل();
    ليكن الحافة: حافة_استيراد_وحدة = {
        الوحدة: المستورد_منه,
        السياسة: السياسة
    };
    ألحق((*الرسم).الوحدات[المستورد.القيمة].الاستيرادات, الحافة);
}

عام عرف أضف_استيرادا_مسمى(
    الرسم: &متغير رسم_وحدات,
    المستورد: معرف_وحدة,
    المستورد_منه: معرف_وحدة,
    المرادف: مرادف_استيراد_وحدة
): فراغ {
    ليكن السياسة: سياسة_استيراد_وحدة = سياسة_استيراد_وحدة.مسمى(المرادف);
    ليكن الحافة: حافة_استيراد_وحدة = {
        الوحدة: المستورد_منه,
        السياسة: السياسة
    };
    ألحق((*الرسم).الوحدات[المستورد.القيمة].الاستيرادات, الحافة);
}

عام عرف أضف_استيرادا_انتقائيا(
    الرسم: &متغير رسم_وحدات,
    المستورد: معرف_وحدة,
    المستورد_منه: معرف_وحدة,
    الأسماء: &متجه اسم_استيراد_انتقائي
): فراغ {
    ليكن نسخة_الأسماء: متجه اسم_استيراد_انتقائي = انسخ_مملوكا_متجه_اسم_استيراد_انتقائي(الأسماء);
    ليكن السياسة: سياسة_استيراد_وحدة = سياسة_استيراد_وحدة.انتقائي(نسخة_الأسماء);
    ليكن الحافة: حافة_استيراد_وحدة = {
        الوحدة: المستورد_منه,
        السياسة: السياسة
    };
    ألحق((*الرسم).الوحدات[المستورد.القيمة].الاستيرادات, الحافة);
}

عام عرف عدد_استيرادات_الوحدة(
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة
): طبيعي {
    أرجع الطول((*الرسم).الوحدات[الوحدة.القيمة].الاستيرادات) مثل طبيعي;
}

عام عرف حافة_استيراد_الوحدة_عند(
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الفهرس: طبيعي
): حافة_استيراد_وحدة {
    ليكن مرجع_الحافة: &حافة_استيراد_وحدة = &(*الرسم).الوحدات[الوحدة.القيمة].الاستيرادات[الفهرس];
    ليكن الحافة: حافة_استيراد_وحدة = انسخ_مملوكا_حافة_استيراد_وحدة(مرجع_الحافة);
    أرجع الحافة;
}

عام عرف استيراد_الوحدة_عند(
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الفهرس: طبيعي
): معرف_وحدة {
    ليكن الحافة: حافة_استيراد_وحدة = حافة_استيراد_الوحدة_عند(الرسم, الوحدة, الفهرس);
    أرجع الحافة.الوحدة;
}

// The spans a module's import edges carry (an alias, each selected name), in
// edge order, and the same edges with other spans in that order: an
// incremental tooling session moves them when an edit shifts the text around
// unchanged imports (incremental_analysis.sn).
عام عرف نطاقات_استيرادات_وحدة_في_الرسم(الرسم: &رسم_وحدات, الوحدة: معرف_وحدة): متجه نطاق {
    ليكن الناتج: متغير متجه نطاق = [];
    إذا ((الوحدة.القيمة مثل طبيعي) >= (الطول((*الرسم).الوحدات) مثل طبيعي)) { أرجع الناتج; };
    ليكن الحواف: &متجه حافة_استيراد_وحدة = &(*الرسم).الوحدات[الوحدة.القيمة].الاستيرادات;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحواف) مثل طبيعي)) {
        طابق (*الحواف)[ف].السياسة مع
        | سياسة_استيراد_وحدة.كامل -> { }
        | سياسة_استيراد_وحدة.مسمى(المرادف) -> { ألحق(الناتج, المرادف.النطاق); }
        | سياسة_استيراد_وحدة.انتقائي(الأسماء) -> {
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(الأسماء) مثل طبيعي)) { ألحق(الناتج, الأسماء[م].النطاق); م := م + 1; }
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف ضع_نطاقات_استيرادات_وحدة_في_الرسم(
    الرسم: &متغير رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاقات: &متجه نطاق
): منطقي {
    إذا ((الوحدة.القيمة مثل طبيعي) >= (الطول((*الرسم).الوحدات) مثل طبيعي)) { أرجع خطأ; };
    ليكن الجديدة: متغير متجه حافة_استيراد_وحدة = [];
    ليكن التالي: متغير طبيعي = 0;
    ليكن العدد: طبيعي = الطول((*الرسم).الوحدات[الوحدة.القيمة].الاستيرادات) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن الحافة: متغير حافة_استيراد_وحدة = انسخ_مملوكا_حافة_استيراد_وحدة(
            &(*الرسم).الوحدات[الوحدة.القيمة].الاستيرادات[ف]
        );
        طابق (*الرسم).الوحدات[الوحدة.القيمة].الاستيرادات[ف].السياسة مع
        | سياسة_استيراد_وحدة.كامل -> { }
        | سياسة_استيراد_وحدة.مسمى(المرادف) -> {
            إذا (التالي >= (الطول(*النطاقات) مثل طبيعي)) { أرجع خطأ; };
            ليكن الجديد: مرادف_استيراد_وحدة = {
                الهوية: انسخ_بايتات(&المرادف.الهوية), النطاق: (*النطاقات)[التالي]
            };
            التالي := التالي + 1;
            الحافة.السياسة := سياسة_استيراد_وحدة.مسمى(الجديد);
        }
        | سياسة_استيراد_وحدة.انتقائي(الأسماء) -> {
            ليكن المنقولة: متغير متجه اسم_استيراد_انتقائي = [];
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(الأسماء) مثل طبيعي)) {
                إذا (التالي >= (الطول(*النطاقات) مثل طبيعي)) { أرجع خطأ; };
                ليكن الاسم: اسم_استيراد_انتقائي = {
                    الهوية: انسخ_بايتات(&الأسماء[م].الهوية), النطاق: (*النطاقات)[التالي]
                };
                ألحق(المنقولة, الاسم);
                التالي := التالي + 1;
                م := م + 1;
            }
            الحافة.السياسة := سياسة_استيراد_وحدة.انتقائي(المنقولة);
        };
        ألحق(الجديدة, الحافة);
        ف := ف + 1;
    }
    إذا (التالي != (الطول(*النطاقات) مثل طبيعي)) { أرجع خطأ; };
    (*الرسم).الوحدات[الوحدة.القيمة].الاستيرادات := الجديدة;
    أرجع صواب;
}

عام عرف الوحدات_الدلالية_للرسم(الرسم: &رسم_وحدات): متجه وحدة_دلالية {
    ليكن الناتج: متغير متجه وحدة_دلالية = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الرسم).الوحدات) مثل طبيعي)) {
        ألحق(الناتج, (*الرسم).الوحدات[ف].الدلالية);
        ف := ف + 1;
    }
    أرجع الناتج;
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_اسم_استيراد_انتقائي(القيمة: &متجه اسم_استيراد_انتقائي): متجه اسم_استيراد_انتقائي {
    ليكن الناتج: متغير متجه اسم_استيراد_انتقائي = [];
    احجز_سعة(الناتج, الطول(*القيمة) مثل طبيعي);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_اسم_استيراد_انتقائي(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_اسم_استيراد_انتقائي(القيمة: &اسم_استيراد_انتقائي): اسم_استيراد_انتقائي {
    ليكن الناتج: اسم_استيراد_انتقائي = {
        الهوية: انسخ_بايتات(&(*القيمة).الهوية),
        النطاق: (*القيمة).النطاق
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حافة_استيراد_وحدة(القيمة: &حافة_استيراد_وحدة): حافة_استيراد_وحدة {
    ليكن الناتج: حافة_استيراد_وحدة = {
        الوحدة: (*القيمة).الوحدة,
        السياسة: انسخ_مملوكا_سياسة_استيراد_وحدة(&(*القيمة).السياسة)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_سياسة_استيراد_وحدة(القيمة: &سياسة_استيراد_وحدة): سياسة_استيراد_وحدة {
    طابق *القيمة مع
    | سياسة_استيراد_وحدة.كامل -> { أرجع سياسة_استيراد_وحدة.كامل(); }
    | سياسة_استيراد_وحدة.مسمى(ح0) -> { أرجع سياسة_استيراد_وحدة.مسمى(انسخ_مملوكا_مرادف_استيراد_وحدة(&ح0)); }
    | سياسة_استيراد_وحدة.انتقائي(ح0) -> { أرجع سياسة_استيراد_وحدة.انتقائي(انسخ_مملوكا_متجه_اسم_استيراد_انتقائي(&ح0)); };
}

عام عرف انسخ_مملوكا_مرادف_استيراد_وحدة(القيمة: &مرادف_استيراد_وحدة): مرادف_استيراد_وحدة {
    ليكن الناتج: مرادف_استيراد_وحدة = {
        الهوية: انسخ_بايتات(&(*القيمة).الهوية),
        النطاق: (*القيمة).النطاق
    };
    أرجع الناتج;
}
