استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.context;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;

// Module graph owns dense Module IDs and the exact semantics of each direct
// import edge. Selective imports carry only the source names explicitly exposed
// to the importing scope; Name consumes this fact without reconstructing syntax.
عام نوع وحدة_دلالية = {
    المعرف: معرف_وحدة,
    النطاق_الجذري: معرف_نطاق,
    معرف_المصدر: غير_موقع,
    يسمح_بجسر_بدائي_داخلي: منطقي
};

عام نوع اسم_استيراد_انتقائي = {
    الهوية: متجه غ8,
    النطاق: نطاق
};

عام نوع مرادف_استيراد_وحدة = {
    الهوية: متجه غ8,
    النطاق: نطاق
};

عام نوع سياسة_استيراد_وحدة =
    | كامل
    | مسمى بنوع مرادف_استيراد_وحدة
    | انتقائي بنوع متجه اسم_استيراد_انتقائي
;

عام نوع حافة_استيراد_وحدة = {
    الوحدة: معرف_وحدة,
    السياسة: سياسة_استيراد_وحدة
};

نوع وحدة_في_رسم = {
    الدلالية: وحدة_دلالية,
    الاستيرادات: متجه حافة_استيراد_وحدة
};

عام نوع رسم_وحدات = {
    معرف_الوحدة_التالي: غير_موقع,
    الوحدات: متجه وحدة_في_رسم
};

عام عرف رسم_وحدات_جديد(): رسم_وحدات {
    دع الوحدات: متجه وحدة_في_رسم = [];
    دع الرسم: رسم_وحدات = {
        معرف_الوحدة_التالي: 0,
        الوحدات: الوحدات
    };
    أرجع الرسم;
}

عام عرف خصص_معرف_وحدة(الرسم: &متغير رسم_وحدات): معرف_وحدة {
    دع الحالة: متغير رسم_وحدات = *الرسم;
    دع المعرف: معرف_وحدة = معرف_وحدة_من(الحالة.معرف_الوحدة_التالي);
    الحالة.معرف_الوحدة_التالي := الحالة.معرف_الوحدة_التالي + 1;
    *الرسم := الحالة;
    أرجع المعرف;
}

عام عرف وحدة_تسمح_بجسر_بدائي_داخلي(الوحدة: &وحدة_دلالية): منطقي {
    دع القيمة: وحدة_دلالية = *الوحدة;
    أرجع القيمة.يسمح_بجسر_بدائي_داخلي;
}

عام عرف وحدة_في_الرسم(
    الرسم: &رسم_وحدات,
    المعرف: معرف_وحدة
): اختيار وحدة_دلالية {
    دع الحالة: رسم_وحدات = *الرسم;
    لو (المعرف.القيمة >= (الطول(الحالة.الوحدات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(الحالة.الوحدات[المعرف.القيمة].الدلالية);
}

عام عرف أضف_وحدة_للرسم(
    الرسم: &متغير رسم_وحدات,
    الوحدة: وحدة_دلالية
): فراغ {
    دع الحالة: متغير رسم_وحدات = *الرسم;
    دع الاستيرادات: متجه حافة_استيراد_وحدة = [];
    دع المسجلة: وحدة_في_رسم = {
        الدلالية: الوحدة,
        الاستيرادات: الاستيرادات
    };
    ألحق(الحالة.الوحدات, المسجلة);
    *الرسم := الحالة;
}

عام عرف أضف_استيرادا(
    الرسم: &متغير رسم_وحدات,
    المستورد: معرف_وحدة,
    المستورد_منه: معرف_وحدة
): فراغ {
    دع الحالة: متغير رسم_وحدات = *الرسم;
    دع السياسة: سياسة_استيراد_وحدة = سياسة_استيراد_وحدة.كامل();
    دع الحافة: حافة_استيراد_وحدة = {
        الوحدة: المستورد_منه,
        السياسة: السياسة
    };
    ألحق(الحالة.الوحدات[المستورد.القيمة].الاستيرادات, الحافة);
    *الرسم := الحالة;
}

عام عرف أضف_استيرادا_مسمى(
    الرسم: &متغير رسم_وحدات,
    المستورد: معرف_وحدة,
    المستورد_منه: معرف_وحدة,
    المرادف: مرادف_استيراد_وحدة
): فراغ {
    دع الحالة: متغير رسم_وحدات = *الرسم;
    دع السياسة: سياسة_استيراد_وحدة = سياسة_استيراد_وحدة.مسمى(المرادف);
    دع الحافة: حافة_استيراد_وحدة = {
        الوحدة: المستورد_منه,
        السياسة: السياسة
    };
    ألحق(الحالة.الوحدات[المستورد.القيمة].الاستيرادات, الحافة);
    *الرسم := الحالة;
}

عام عرف أضف_استيرادا_انتقائيا(
    الرسم: &متغير رسم_وحدات,
    المستورد: معرف_وحدة,
    المستورد_منه: معرف_وحدة,
    الأسماء: &متجه اسم_استيراد_انتقائي
): فراغ {
    دع الحالة: متغير رسم_وحدات = *الرسم;
    دع نسخة_الأسماء: متجه اسم_استيراد_انتقائي = *الأسماء;
    دع السياسة: سياسة_استيراد_وحدة = سياسة_استيراد_وحدة.انتقائي(نسخة_الأسماء);
    دع الحافة: حافة_استيراد_وحدة = {
        الوحدة: المستورد_منه,
        السياسة: السياسة
    };
    ألحق(الحالة.الوحدات[المستورد.القيمة].الاستيرادات, الحافة);
    *الرسم := الحالة;
}

عام عرف عدد_استيرادات_الوحدة(
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة
): غير_موقع {
    دع الحالة: رسم_وحدات = *الرسم;
    أرجع الطول(الحالة.الوحدات[الوحدة.القيمة].الاستيرادات) مثل غير_موقع;
}

عام عرف حافة_استيراد_الوحدة_عند(
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الفهرس: غير_موقع
): حافة_استيراد_وحدة {
    دع الحالة: رسم_وحدات = *الرسم;
    دع مرجع_الحافة: &حافة_استيراد_وحدة = &الحالة.الوحدات[الوحدة.القيمة].الاستيرادات[الفهرس];
    دع الحافة: حافة_استيراد_وحدة = *مرجع_الحافة;
    أرجع الحافة;
}

عام عرف استيراد_الوحدة_عند(
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الفهرس: غير_موقع
): معرف_وحدة {
    دع الحافة: حافة_استيراد_وحدة = حافة_استيراد_الوحدة_عند(الرسم, الوحدة, الفهرس);
    أرجع الحافة.الوحدة;
}
