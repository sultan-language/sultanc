استورد compiler.frontend.ast.operators;
استورد compiler.frontend.ast.literals;
استورد compiler.frontend.source.source;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.identifier_identity;
استورد compiler.frontend.type_name_surface_generated;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.context;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.names.declaration_collection;
استورد compiler.frontend.names.primitive_registry;
استورد compiler.frontend.names.name_resolution;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.types;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.patterns;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.unit;

// Parsed-source Name result. All stored facts remain Name/Module identities only.
عام نوع دلالة_أسماء_وحدة = {
    الوحدة: معرف_وحدة,
    التصريحات: جدول_تصريحات,
    الروابط: سياق_روابط_أسماء
};

عام نوع نتيجة_دلالة_أسماء_وحدة =
    | مكتملة بنوع دلالة_أسماء_وحدة
    | وحدة_مجهولة
    | مصدر_غير_مطابق
    | تصريح_مكرر بنوع نطاق
    | اسم_مفقود بنوع نطاق
    | اسم_خاص بنوع نطاق
    | اسم_غامض بنوع نطاق
    | تعارض_ربط بنوع نطاق
;

// Graph-level Name processing separates declaration registration from use resolution.
// This lets every canonical module publish its Symbols before any importer resolves names.
عام نوع نتيجة_جمع_تصريحات_أسماء_وحدة =
    | مكتملة بنوع جدول_تصريحات
    | وحدة_مجهولة
    | مصدر_غير_مطابق
    | تصريح_مكرر بنوع (معرف_رمز, نطاق)
    | اسم_مفقود بنوع نطاق
    | اسم_خاص بنوع نطاق
    | تعارض_ربط بنوع نطاق
;

نوع خطأ_ربط_أسماء =
    | لا_خطأ
    | تصريح_مكرر بنوع نطاق
    | اسم_مفقود بنوع نطاق
    | اسم_خاص بنوع نطاق
    | اسم_غامض بنوع نطاق
    | تعارض_ربط بنوع نطاق
;

عرف هل_خطأ_ربط_أسماء(الخطأ: خطأ_ربط_أسماء): منطقي {
    طابق الخطأ مع
    | خطأ_ربط_أسماء.لا_خطأ -> {
        أرجع خطأ;
    }
    | _ -> {
        أرجع صواب;
    };
}

عرف نتيجة_خطأ(الخطأ: خطأ_ربط_أسماء): نتيجة_دلالة_أسماء_وحدة {
    طابق الخطأ مع
    | خطأ_ربط_أسماء.تصريح_مكرر(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.تصريح_مكرر(س);
    }
    | خطأ_ربط_أسماء.اسم_مفقود(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_مفقود(س);
    }
    | خطأ_ربط_أسماء.اسم_خاص(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_خاص(س);
    }
    | خطأ_ربط_أسماء.اسم_غامض(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_غامض(س);
    }
    | خطأ_ربط_أسماء.تعارض_ربط(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.تعارض_ربط(س);
    }
    | خطأ_ربط_أسماء.لا_خطأ -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة();
    };
}

عرف اربط_ظهور_مرئي_في_حيز(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الاسم: &اسم,
    الحيز: حيز_اسم
): خطأ_ربط_أسماء {
    دع الظهور: اسم = *الاسم;
    دع الأصل_المصدر: مصدر = *المصدر;
    دع الهوية: متجه غ8 = انسخ_هوية_معرف_من_شريحة(
        &الأصل_المصدر.المحتوى,
        الظهور.النطاق.البداية.البايت,
        الظهور.النطاق.النهاية.البايت
    );
    طابق حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, &الهوية, الحيز
    ) مع
    | نتيجة_حل_ظهور_اسم.موجود(الرمز) -> {
        طابق اسم_رمز_عند(سياق_الأسماء, الرمز) مع
        | اختيار.لا_شيء -> {
            أرجع خطأ_ربط_أسماء.اسم_مفقود(الظهور.النطاق);
        }
        | اختيار.بعض(هوية_الاسم) -> {
            لو (!أضف_ظهور_اسم_محلول(
                الروابط, الظهور.النطاق, هوية_الاسم, الرمز
            )) {
                أرجع خطأ_ربط_أسماء.تعارض_ربط(الظهور.النطاق);
            };
        };
        أرجع خطأ_ربط_أسماء.لا_خطأ();
    }
    | نتيجة_حل_ظهور_اسم.خاص -> {
        أرجع خطأ_ربط_أسماء.اسم_خاص(الظهور.النطاق);
    }
    | نتيجة_حل_ظهور_اسم.غامض -> {
        أرجع خطأ_ربط_أسماء.اسم_غامض(الظهور.النطاق);
    }
    | نتيجة_حل_ظهور_اسم.مفقود -> {
        أرجع خطأ_ربط_أسماء.اسم_مفقود(الظهور.النطاق);
    };
}

عرف اربط_ظهور_قيمة_مرئي(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الاسم: &اسم
): خطأ_ربط_أسماء {
    أرجع اربط_ظهور_مرئي_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, الاسم, حيز_اسم.قيمة()
    );
}

عرف اربط_ظهور_نوع_مرئي(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الاسم: &اسم
): خطأ_ربط_أسماء {
    أرجع اربط_ظهور_مرئي_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, الاسم, حيز_اسم.نوع()
    );
}

عرف اربط_نوعا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النوع: &نوع_تركيبي
): خطأ_ربط_أسماء {
    دع ت: نوع_تركيبي = *النوع;
    طابق ت مع
    | نوع_تركيبي.مسمى(س, الاسم, الحجج) -> {
        دع خطأ_الاسم: خطأ_ربط_أسماء = اربط_ظهور_نوع_مرئي(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الاسم
        );
        لو (هل_خطأ_ربط_أسماء(خطأ_الاسم)) {
            أرجع خطأ_الاسم;
        };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
            دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الحجج[ف]
            );
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | نوع_تركيبي.صف(س, العناصر) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
            دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &العناصر[ف]
            );
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | نوع_تركيبي.صندوق(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.اختيار(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.مؤشر(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.مرجع(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.شريحة(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.متجه(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.متغير(س, الداخل) -> {
        دع قيمة_الداخل: نوع_تركيبي = *الداخل;
        دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.نتيجة(س, أ, ب) -> {
        دع قيمة_أ: نوع_تركيبي = *أ;
        دع خطأ_أ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_أ);
        لو (هل_خطأ_ربط_أسماء(خطأ_أ)) {
            أرجع خطأ_أ;
        };
        دع قيمة_ب: نوع_تركيبي = *ب;
        دع خطأ_ب: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_ب);
        لو (هل_خطأ_ربط_أسماء(خطأ_ب)) {
            أرجع خطأ_ب;
        };
    }
    | نوع_تركيبي.دالة(س, المعاملات, الناتج) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المعاملات) مثل غير_موقع)) {
            دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &المعاملات[ف]
            );
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
        دع قيمة_الناتج: نوع_تركيبي = *الناتج;
        دع خطأ_الناتج: خطأ_ربط_أسماء = اربط_نوعا(
            سياق_الأسماء,
            الرسم,
            الوحدة,
            النطاق_الحالي,
            الروابط,
            المصدر,
            &قيمة_الناتج
        );
        لو (هل_خطأ_ربط_أسماء(خطأ_الناتج)) {
            أرجع خطأ_الناتج;
        };
    }
    | نوع_تركيبي.أي(س) -> { }
    | نوع_تركيبي.منطقي(س) -> { }
    | نوع_تركيبي.آلة(س, أ) -> { }
    | نوع_تركيبي.عدد(س) -> { }
    | نوع_تركيبي.غير_موقع(س) -> { }
    | نوع_تركيبي.حرف(س) -> { }
    | نوع_تركيبي.نص(س) -> { }
    | نوع_تركيبي.فراغ(س) -> { };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف هل_اسم_نوع_موسوم_مدمج(المصدر: &مصدر, الاسم: &اسم): منطقي {
    دع القيمة: اسم = *الاسم;
    طابق صنف_اسم_نوع_سياقي_في_نطاق(المصدر, القيمة.النطاق) مع
    | صنف_اسم_نوع_سياقي.اختيار -> { أرجع صواب; }
    | صنف_اسم_نوع_سياقي.نتيجة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Enum-constructor call qualifiers are Type-position names in Stage0 semantics.
// Probe that interpretation without binding the qualifier as a value; ordinary field
// access falls back to normal value binding when no constructor exists.
عرف حاول_اربط_منشئ_مستدعى(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    المستدعى: &تعبير
): منطقي {
    دع القيمة: تعبير = *المستدعى;
    طابق القيمة مع
    | تعبير.حقل(_, الأصل, الحقل) -> {
        دع قيمة_الأصل: تعبير = *الأصل;
        طابق قيمة_الأصل مع
        | تعبير.اسم(_, اسم_النوع) -> {
            لو (هل_اسم_نوع_موسوم_مدمج(المصدر, &اسم_النوع)) {
                قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_النوع.النطاق);
                قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الحقل.النطاق);
                أرجع صواب;
            };
            دع الأصل_المصدر: مصدر = *المصدر;
            دع هوية_النوع: متجه غ8 = انسخ_هوية_معرف_من_شريحة(
                &الأصل_المصدر.المحتوى,
                اسم_النوع.النطاق.البداية.البايت,
                اسم_النوع.النطاق.النهاية.البايت
            );
            طابق حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, &هوية_النوع, حيز_اسم.نوع()
            ) مع
            | نتيجة_حل_ظهور_اسم.موجود(رمز_النوع) -> {
                طابق حل_واربط_منشئ_مسمى(
                    سياق_الأسماء, الروابط, المصدر, الحقل.النطاق, رمز_النوع
                ) مع
                | اختيار.بعض(_) -> {
                    طابق اسم_رمز_عند(سياق_الأسماء, رمز_النوع) مع
                    | اختيار.بعض(اسم_مقنن) -> {
                        أرجع أضف_ظهور_اسم_محلول(
                            الروابط, اسم_النوع.النطاق, اسم_مقنن, رمز_النوع
                        );
                    }
                    | اختيار.لا_شيء -> { أرجع خطأ; };
                }
                | اختيار.لا_شيء -> { };
            }
            | _ -> { };
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع خطأ;
}

عرف حاول_اربط_عضو_استيراد_مسمى(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    المرادف: &اسم,
    العضو: &اسم,
    الحيز: حيز_اسم
): اختيار خطأ_ربط_أسماء {
    دع الأصل: مصدر = *المصدر;
    دع اسم_المرادف: اسم = *المرادف;
    دع اسم_العضو: اسم = *العضو;
    دع هوية_المرادف: متجه غ8 = انسخ_هوية_معرف_من_شريحة(
        &الأصل.المحتوى, اسم_المرادف.النطاق.البداية.البايت, اسم_المرادف.النطاق.النهاية.البايت
    );
    دع هوية_العضو: متجه غ8 = انسخ_هوية_معرف_من_شريحة(
        &الأصل.المحتوى, اسم_العضو.النطاق.البداية.البايت, اسم_العضو.النطاق.النهاية.البايت
    );
    طابق حل_عضو_استيراد_مسمى_ببايتات_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, &هوية_المرادف, &هوية_العضو, الحيز
    ) مع
    | نتيجة_حل_عضو_استيراد_مسمى.ليس_مرادفا -> { أرجع اختيار.لا_شيء(); }
    | نتيجة_حل_عضو_استيراد_مسمى.موجود(الرمز) -> {
        قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_المرادف.النطاق);
        طابق اسم_رمز_عند(سياق_الأسماء, الرمز) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_ربط_أسماء.اسم_مفقود(اسم_العضو.النطاق));
        }
        | اختيار.بعض(هوية_الاسم) -> {
            لو (!أضف_ظهور_اسم_محلول(الروابط, اسم_العضو.النطاق, هوية_الاسم, الرمز)) {
                أرجع اختيار.بعض(خطأ_ربط_أسماء.تعارض_ربط(اسم_العضو.النطاق));
            };
        };
        أرجع اختيار.بعض(خطأ_ربط_أسماء.لا_خطأ());
    }
    | نتيجة_حل_عضو_استيراد_مسمى.خاص -> {
        قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_المرادف.النطاق);
        أرجع اختيار.بعض(خطأ_ربط_أسماء.اسم_خاص(اسم_العضو.النطاق));
    }
    | نتيجة_حل_عضو_استيراد_مسمى.غامض -> {
        قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_المرادف.النطاق);
        أرجع اختيار.بعض(خطأ_ربط_أسماء.اسم_غامض(اسم_العضو.النطاق));
    }
    | نتيجة_حل_عضو_استيراد_مسمى.مفقود -> {
        قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_المرادف.النطاق);
        أرجع اختيار.بعض(خطأ_ربط_أسماء.اسم_مفقود(اسم_العضو.النطاق));
    };
}

عرف اربط_تعبيرا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    التعبير: &تعبير
): خطأ_ربط_أسماء {
    دع ت: تعبير = *التعبير;
    طابق ت مع
    | تعبير.حرفي(س, ح) -> { }
    | تعبير.اسم(س, الاسم) -> {
        أرجع اربط_ظهور_قيمة_مرئي(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الاسم
        );
    }
    | تعبير.حقل(س, الأصل, الحقل) -> {
        دع قيمة_الأصل: تعبير = *الأصل;
        طابق قيمة_الأصل مع
        | تعبير.اسم(_, اسم_المرادف) -> {
            طابق حاول_اربط_عضو_استيراد_مسمى(
                سياق_الأسماء, الرسم, الوحدة, الروابط, المصدر, &اسم_المرادف, &الحقل, حيز_اسم.قيمة()
            ) مع
            | اختيار.بعض(نتيجة_الربط) -> { أرجع نتيجة_الربط; }
            | اختيار.لا_شيء -> { };
        }
        | _ -> { };
        دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الأصل);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
        دع ربط_منشئ: متغير منطقي = خطأ;
        طابق قيمة_الأصل مع
        | تعبير.اسم(سأ, اسم_النوع) -> {
            طابق رمز_اسم_محلول_عند(الروابط, اسم_النوع.النطاق) مع
            | اختيار.بعض(رمز_النوع) -> {
                طابق حل_واربط_منشئ_مسمى(
                    سياق_الأسماء, الروابط, المصدر, الحقل.النطاق, رمز_النوع
                ) مع
                | اختيار.بعض(رمز_المنشئ) -> { ربط_منشئ := صواب; }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | تعبير.حرفي(سأ, حأ) -> { }
        | تعبير.حقل(سأ, أأ, حأ) -> { }
        | تعبير.فهرس(سأ, أأ, بأ) -> { }
        | تعبير.فك_موضع(سأ, أأ) -> { }
        | تعبير.ثنائي(سأ, عأ, أأ, بأ) -> { }
        | تعبير.أحادي(سأ, عأ, أأ) -> { }
        | تعبير.استدعاء(سأ, أأ, بأ) -> { }
        | تعبير.تحويل(سأ, أأ, بأ) -> { };
        لو (!ربط_منشئ) {
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الحقل.النطاق);
        };
    }
    | تعبير.فهرس(س, الأصل, الفهرس) -> {
        دع قيمة_الأصل: تعبير = *الأصل;
        دع قيمة_الفهرس: تعبير = *الفهرس;
        دع خطأ_أ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الأصل);
        لو (هل_خطأ_ربط_أسماء(خطأ_أ)) {
            أرجع خطأ_أ;
        };
        دع خطأ_ب: خطأ_ربط_أسماء = اربط_تعبيرا(
            سياق_الأسماء,
            الرسم,
            الوحدة,
            النطاق_الحالي,
            الروابط,
            المصدر,
            &قيمة_الفهرس
        );
        لو (هل_خطأ_ربط_أسماء(خطأ_ب)) {
            أرجع خطأ_ب;
        };
    }
    | تعبير.فك_موضع(س, الأصل) -> {
        دع قيمة_الأصل: تعبير = *الأصل;
        دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الأصل);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | تعبير.ثنائي(س, ع, أ, ب) -> {
        دع قيمة_أ: تعبير = *أ;
        دع قيمة_ب: تعبير = *ب;
        دع خطأ_أ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_أ);
        لو (هل_خطأ_ربط_أسماء(خطأ_أ)) {
            أرجع خطأ_أ;
        };
        دع خطأ_ب: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_ب);
        لو (هل_خطأ_ربط_أسماء(خطأ_ب)) {
            أرجع خطأ_ب;
        };
    }
    | تعبير.أحادي(س, ع, أ) -> {
        دع قيمة_أ: تعبير = *أ;
        دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_أ);
        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | تعبير.استدعاء(س, الدالة, الحجج) -> {
        دع قيمة_الدالة: تعبير = *الدالة;
        لو (!حاول_اربط_منشئ_مستدعى(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الدالة
        )) {
            دع خطأ_الدالة: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &قيمة_الدالة
            );
            لو (هل_خطأ_ربط_أسماء(خطأ_الدالة)) {
                أرجع خطأ_الدالة;
            };
        };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
            دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &الحجج[ف]
            );
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | تعبير.تحويل(س, الأصل, النوع) -> {
        دع قيمة_الأصل: تعبير = *الأصل;
        دع خطأ_الأصل: خطأ_ربط_أسماء = اربط_تعبيرا(
            سياق_الأسماء,
            الرسم,
            الوحدة,
            النطاق_الحالي,
            الروابط,
            المصدر,
            &قيمة_الأصل
        );
        لو (هل_خطأ_ربط_أسماء(خطأ_الأصل)) {
            أرجع خطأ_الأصل;
        };
        دع خطأ_النوع: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &النوع);
        لو (هل_خطأ_ربط_أسماء(خطأ_النوع)) {
            أرجع خطأ_النوع;
        };
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف سجل_محليا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النطاق_الحالي: معرف_نطاق,
    الاسم: &اسم,
    نطاق_التصريح: نطاق,
    النوع: نوع_تصريح
): خطأ_ربط_أسماء {
    دع ا: اسم = *الاسم;
    طابق أضف_رمزا_مصدريا(سياق_الأسماء, النطاق_الحالي, المصدر, ا.النطاق, نطاق_التصريح, النوع, خطأ) مع
    | نتيجة_إضافة.مكرر(الموجود, النطاق) -> {
        أرجع خطأ_ربط_أسماء.تصريح_مكرر(النطاق);
    }
    | نتيجة_إضافة.أضيف(الرمز) -> {
        طابق اسم_رمز_عند(سياق_الأسماء, الرمز) مع
        | اختيار.بعض(الهوية) -> {
            لو (!أضف_ظهور_اسم_محلول(الروابط, ا.النطاق, الهوية, الرمز)) {
                أرجع خطأ_ربط_أسماء.تعارض_ربط(ا.النطاق);
            };
        }
        | اختيار.لا_شيء -> {
            أرجع خطأ_ربط_أسماء.تعارض_ربط(ا.النطاق);
        };
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف اربط_نمطا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النمط: &نمط
): خطأ_ربط_أسماء {
    دع ن: نمط = *النمط;
    طابق ن مع
    | نمط.بدل(س) -> { }
    | نمط.ربط(س, الاسم) -> {
        أرجع سجل_محليا(سياق_الأسماء, الروابط, المصدر, النطاق_الحالي, &الاسم, س, نوع_تصريح.ربط_محلي());
    }
    | نمط.منشئ(س, النوع, المنشئ, الحمولات) -> {
        لو (هل_اسم_نوع_موسوم_مدمج(المصدر, &النوع)) {
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, النوع.النطاق);
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, المنشئ.النطاق);
        }
        وإلا {
            دع خطأ_النوع: خطأ_ربط_أسماء = اربط_ظهور_نوع_مرئي(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &النوع
            );
            لو (هل_خطأ_ربط_أسماء(خطأ_النوع)) {
                أرجع خطأ_النوع;
            };
            طابق رمز_اسم_محلول_عند(الروابط, النوع.النطاق) مع
            | اختيار.بعض(رمز_النوع) -> {
                طابق حل_واربط_منشئ_مسمى(سياق_الأسماء, الروابط, المصدر, المنشئ.النطاق, رمز_النوع) مع
                | اختيار.بعض(رمز_المنشئ) -> { }
                | اختيار.لا_شيء -> {
                    أرجع خطأ_ربط_أسماء.اسم_مفقود(المنشئ.النطاق);
                };
            }
            | اختيار.لا_شيء -> {
                أرجع خطأ_ربط_أسماء.اسم_مفقود(النوع.النطاق);
            };
        };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحمولات) مثل غير_موقع)) {
            دع الخطأ: خطأ_ربط_أسماء = اربط_نمطا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &الحمولات[ف]
            );
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | نمط.صف(س, العناصر) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
            دع الخطأ: خطأ_ربط_أسماء = اربط_نمطا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &العناصر[ف]
            );
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | نمط.سجل(س, الحقول) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحقول) مثل غير_موقع)) {
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الحقول[ف].الاسم.النطاق);
            دع الخطأ: خطأ_ربط_أسماء = اربط_نمطا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &الحقول[ف].النمط
            );
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف اربط_كتلة(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الكتلة: &كتلة_عبارات,
    أنشئ_نطاقا: منطقي
): خطأ_ربط_أسماء {
    دع ك: كتلة_عبارات = *الكتلة;
    دع نطاق_الكتلة: متغير معرف_نطاق = النطاق_الحالي;
    لو (أنشئ_نطاقا) {
        نطاق_الكتلة := نطاق_ابن_بمصدر(سياق_الأسماء, النطاق_الحالي, ك.النطاق);
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ك.العبارات) مثل غير_موقع)) {
        دع ع: عبارة = *ك.العبارات[ف];
        طابق ع مع
        | عبارة.تصريح_متغير(س, الاسم, النوع) -> {
            دع خطأ_النوع: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &النوع);
            لو (هل_خطأ_ربط_أسماء(خطأ_النوع)) {
                أرجع خطأ_النوع;
            };
            دع خطأ_الاسم: خطأ_ربط_أسماء = سجل_محليا(
                سياق_الأسماء,
                الروابط,
                المصدر,
                نطاق_الكتلة,
                &الاسم,
                س,
                نوع_تصريح.ربط_محلي()
            );
            لو (هل_خطأ_ربط_أسماء(خطأ_الاسم)) {
                أرجع خطأ_الاسم;
            };
        }
        | عبارة.تهيئة_سجل(س, الهدف, الحقول) -> {
            دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            دع ه: متغير غير_موقع = 0;
            بينما (ه < (الطول(الحقول) مثل غير_موقع)) {
                قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الحقول[ه].الاسم.النطاق);
                دع خطأ_القيمة: خطأ_ربط_أسماء = اربط_تعبيرا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &الحقول[ه].القيمة
                );
                لو (هل_خطأ_ربط_أسماء(خطأ_القيمة)) {
                    أرجع خطأ_القيمة;
                };
                ه := ه + 1;
            }
        }
        | عبارة.تهيئة_صف(س, الهدف, العناصر) -> {
            دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            دع ه: متغير غير_موقع = 0;
            بينما (ه < (الطول(العناصر) مثل غير_موقع)) {
                دع خ: خطأ_ربط_أسماء = اربط_تعبيرا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &العناصر[ه]
                );
                لو (هل_خطأ_ربط_أسماء(خ)) {
                    أرجع خ;
                };
                ه := ه + 1;
            }
        }
        | عبارة.تهيئة_متجه(س, الهدف, العناصر) -> {
            دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            دع ه: متغير غير_موقع = 0;
            بينما (ه < (الطول(العناصر) مثل غير_موقع)) {
                دع خ: خطأ_ربط_أسماء = اربط_تعبيرا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &العناصر[ه]
                );
                لو (هل_خطأ_ربط_أسماء(خ)) {
                    أرجع خ;
                };
                ه := ه + 1;
            }
        }
        | عبارة.تهيئة_نص(س, الهدف, بايتات) -> {
            دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
        }
        | عبارة.تهيئة_صندوق(س, الهدف, القيمة) -> {
            دع خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            لو (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            دع خ2: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &القيمة);
            لو (هل_خطأ_ربط_أسماء(خ2)) {
                أرجع خ2;
            };
        }
        | عبارة.نسخ(س, الهدف, القيمة) -> {
            دع خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            لو (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            دع خ2: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &القيمة);
            لو (هل_خطأ_ربط_أسماء(خ2)) {
                أرجع خ2;
            };
        }
        | عبارة.استدعاء(س, التعبير) -> {
            دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &التعبير);
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
        }
        | عبارة.لكل(س, البداية, الشرط, الخطوة, الجسم) -> {
            دع نطاق_الحلقة: معرف_نطاق = نطاق_ابن_بمصدر(سياق_الأسماء, نطاق_الكتلة, س);
            دع كتلة_البداية: كتلة_عبارات = { النطاق: س, العبارات: البداية };
            دع خ0: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الحلقة, الروابط, المصدر, &كتلة_البداية, خطأ);
            لو (هل_خطأ_ربط_أسماء(خ0)) { أرجع خ0; };
            دع خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الحلقة, الروابط, المصدر, &الشرط);
            لو (هل_خطأ_ربط_أسماء(خ1)) { أرجع خ1; };
            دع قائمة_الخطوة: متجه صندوق عبارة = [الخطوة];
            دع كتلة_الخطوة: كتلة_عبارات = { النطاق: س, العبارات: قائمة_الخطوة };
            دع خ2: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الحلقة, الروابط, المصدر, &كتلة_الخطوة, خطأ);
            لو (هل_خطأ_ربط_أسماء(خ2)) { أرجع خ2; };
            دع خ3: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الحلقة, الروابط, المصدر, &الجسم, صواب);
            لو (هل_خطأ_ربط_أسماء(خ3)) { أرجع خ3; };
        }
        | عبارة.اخرج_من_حلقة(_) -> { }
        | عبارة.تابع_حلقة(_) -> { }
        | عبارة.بينما(س, الشرط, الجسم) -> {
            دع خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الشرط);
            لو (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            دع خ2: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الجسم, صواب);
            لو (هل_خطأ_ربط_أسماء(خ2)) {
                أرجع خ2;
            };
        }
        | عبارة.لو(س, الشرط, نعم, لا) -> {
            دع خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الشرط);
            لو (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            دع خ2: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &نعم, صواب);
            لو (هل_خطأ_ربط_أسماء(خ2)) {
                أرجع خ2;
            };
            طابق لا مع | اختيار.بعض(بديل) -> {
                دع خ3: خطأ_ربط_أسماء = اربط_كتلة(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &بديل,
                    صواب
                );
                لو (هل_خطأ_ربط_أسماء(خ3)) {
                    أرجع خ3;
                };
            } | اختيار.لا_شيء -> {
            };
        }
        | عبارة.طابق(س, القيمة, الأذرع) -> {
            دع خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &القيمة);
            لو (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            دع ه: متغير غير_موقع = 0;
            بينما (ه < (الطول(الأذرع) مثل غير_موقع)) {
                دع نطاق_الذراع: معرف_نطاق = نطاق_ابن_بمصدر(سياق_الأسماء, نطاق_الكتلة, الأذرع[ه].الجسم.النطاق);
                دع خ2: خطأ_ربط_أسماء = اربط_نمطا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الذراع,
                    الروابط,
                    المصدر,
                    &الأذرع[ه].النمط
                );
                لو (هل_خطأ_ربط_أسماء(خ2)) {
                    أرجع خ2;
                };
                دع خ3: خطأ_ربط_أسماء = اربط_كتلة(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الذراع,
                    الروابط,
                    المصدر,
                    &الأذرع[ه].الجسم,
                    خطأ
                );
                لو (هل_خطأ_ربط_أسماء(خ3)) {
                    أرجع خ3;
                };
                ه := ه + 1;
            }
        }
        | عبارة.أرجع(س, القيمة) -> {
            طابق القيمة مع | اختيار.بعض(تعبير_الرجوع) -> {
                دع الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &تعبير_الرجوع
                );
                لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                    أرجع الخطأ;
                };
            } | اختيار.لا_شيء -> {
            };
        }
        | عبارة.تجميع(س, ب) -> { }
        | عبارة.غير_آمن(س, الجسم) -> {
            دع الخطأ: خطأ_ربط_أسماء = اربط_كتلة(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                نطاق_الكتلة,
                الروابط,
                المصدر,
                &الجسم,
                صواب
            );
            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
        };
        ف := ف + 1;
    }
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف اربط_تصريح_علوي(
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الجذر: معرف_نطاق,
    الاسم: &اسم
): خطأ_ربط_أسماء {
    دع ا: اسم = *الاسم;
    دع الهوية: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, ا.النطاق);
    طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, الهوية) مع
    | اختيار.بعض(الرمز) -> {
        لو (!أضف_ظهور_اسم_محلول(الروابط, ا.النطاق, الهوية, الرمز)) {
            أرجع خطأ_ربط_أسماء.تعارض_ربط(ا.النطاق);
        };
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ_ربط_أسماء.اسم_مفقود(ا.النطاق);
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف اربط_مرادف_اسم_علويا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الجذر: معرف_نطاق,
    يسمح_بجسر_بدائي_داخلي: منطقي,
    التصريح: &تصريح_مرادف_اسم
): خطأ_ربط_أسماء {
    دع القيمة: تصريح_مرادف_اسم = *التصريح;
    طابق القيمة.أب_الوجهة مع
    | اختيار.لا_شيء -> {
        طابق القيمة.أب_الهدف مع
        | اختيار.بعض(أب_الهدف) -> {
            أرجع خطأ_ربط_أسماء.تعارض_ربط(أب_الهدف.النطاق);
        }
        | اختيار.لا_شيء -> {
            دع خطأ_الهدف: متغير خطأ_ربط_أسماء = خطأ_ربط_أسماء.لا_خطأ();
            لو (!القيمة.علني && يسمح_بجسر_بدائي_داخلي) {
                دع هوية_الهدف: معرف_اسم = قنن_اسما_مصدريا(
                    سياق_الأسماء, المصدر, القيمة.الهدف.النطاق
                );
                طابق حل_رمز_بدائي_بهوية(سياق_الأسماء, هوية_الهدف) مع
                | اختيار.بعض(رمز_الهدف_البدائي) -> {
                    لو (!أضف_ظهور_اسم_محلول(
                        الروابط,
                        القيمة.الهدف.النطاق,
                        هوية_الهدف,
                        رمز_الهدف_البدائي
                    )) {
                        أرجع خطأ_ربط_أسماء.تعارض_ربط(القيمة.الهدف.النطاق);
                    };
                }
                | اختيار.لا_شيء -> {
                    خطأ_الهدف := خطأ_ربط_أسماء.اسم_مفقود(القيمة.الهدف.النطاق);
                };
            } وإلا {
                خطأ_الهدف := اربط_تصريح_علوي(
                    سياق_الأسماء, الروابط, المصدر, الجذر, &القيمة.الهدف
                );
            };
            لو (هل_خطأ_ربط_أسماء(خطأ_الهدف)) {
                أرجع خطأ_الهدف;
            };
            دع خطأ_المرادف: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                سياق_الأسماء, الروابط, المصدر, الجذر, &القيمة.الاسم
            );
            لو (هل_خطأ_ربط_أسماء(خطأ_المرادف)) {
                أرجع خطأ_المرادف;
            };
            طابق رمز_اسم_محلول_عند(الروابط, القيمة.الهدف.النطاق) مع
            | اختيار.لا_شيء -> {
                أرجع خطأ_ربط_أسماء.اسم_مفقود(القيمة.الهدف.النطاق);
            }
            | اختيار.بعض(رمز_الهدف) -> {
                طابق رمز_اسم_محلول_عند(الروابط, القيمة.الاسم.النطاق) مع
                | اختيار.لا_شيء -> {
                    أرجع خطأ_ربط_أسماء.اسم_مفقود(القيمة.الاسم.النطاق);
                }
                | اختيار.بعض(رمز_المرادف) -> {
                    لو (!معرفا_رمز_متساويان(رمز_الهدف, رمز_المرادف)) {
                        أرجع خطأ_ربط_أسماء.تعارض_ربط(القيمة.الاسم.النطاق);
                    };
                };
            };
        };
    }
    | اختيار.بعض(أب_الوجهة) -> {
        طابق القيمة.أب_الهدف مع
        | اختيار.لا_شيء -> {
            أرجع خطأ_ربط_أسماء.تعارض_ربط(القيمة.الهدف.النطاق);
        }
        | اختيار.بعض(أب_الهدف) -> {
            دع خطأ_أب_الوجهة: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                سياق_الأسماء, الروابط, المصدر, الجذر, &أب_الوجهة
            );
            لو (هل_خطأ_ربط_أسماء(خطأ_أب_الوجهة)) {
                أرجع خطأ_أب_الوجهة;
            };
            دع خطأ_أب_الهدف: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                سياق_الأسماء, الروابط, المصدر, الجذر, &أب_الهدف
            );
            لو (هل_خطأ_ربط_أسماء(خطأ_أب_الهدف)) {
                أرجع خطأ_أب_الهدف;
            };
            طابق رمز_اسم_محلول_عند(الروابط, أب_الوجهة.النطاق) مع
            | اختيار.لا_شيء -> {
                أرجع خطأ_ربط_أسماء.اسم_مفقود(أب_الوجهة.النطاق);
            }
            | اختيار.بعض(رمز_أب_الوجهة) -> {
                طابق رمز_اسم_محلول_عند(الروابط, أب_الهدف.النطاق) مع
                | اختيار.لا_شيء -> {
                    أرجع خطأ_ربط_أسماء.اسم_مفقود(أب_الهدف.النطاق);
                }
                | اختيار.بعض(رمز_أب_الهدف) -> {
                    لو (!معرفا_رمز_متساويان(رمز_أب_الوجهة, رمز_أب_الهدف)) {
                        أرجع خطأ_ربط_أسماء.تعارض_ربط(أب_الهدف.النطاق);
                    };
                    طابق حل_واربط_منشئ_مسمى(
                        سياق_الأسماء,
                        الروابط,
                        المصدر,
                        القيمة.الهدف.النطاق,
                        رمز_أب_الهدف
                    ) مع
                    | اختيار.لا_شيء -> {
                        أرجع خطأ_ربط_أسماء.اسم_مفقود(القيمة.الهدف.النطاق);
                    }
                    | اختيار.بعض(رمز_الهدف) -> {
                        طابق حل_واربط_منشئ_مسمى(
                            سياق_الأسماء,
                            الروابط,
                            المصدر,
                            القيمة.الاسم.النطاق,
                            رمز_أب_الوجهة
                        ) مع
                        | اختيار.لا_شيء -> {
                            أرجع خطأ_ربط_أسماء.اسم_مفقود(القيمة.الاسم.النطاق);
                        }
                        | اختيار.بعض(رمز_المرادف) -> {
                            لو (!معرفا_رمز_متساويان(رمز_الهدف, رمز_المرادف)) {
                                أرجع خطأ_ربط_أسماء.تعارض_ربط(القيمة.الاسم.النطاق);
                            };
                        };
                    };
                };
            };
        };
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عام عرف اجمع_تصريحات_أسماء_وحدة(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الوحدة_النحوية: &وحدة_مصدر
): نتيجة_جمع_تصريحات_أسماء_وحدة {
    طابق وحدة_في_الرسم(الرسم, الوحدة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.وحدة_مجهولة();
    }
    | اختيار.بعض(الدلالية) -> {
        دع المصدرية: وحدة_مصدر = *الوحدة_النحوية;
        لو (الدلالية.معرف_المصدر != المصدرية.المصدر.المعرف) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.مصدر_غير_مطابق();
        };
        دع التصريحات: جدول_تصريحات = اجمع_تصريحات_الوحدة(
            سياق_الأسماء, &الدلالية, الوحدة_النحوية
        );
        لو ((الطول(التصريحات.المكررات) مثل غير_موقع) != 0) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.تصريح_مكرر(
                التصريحات.المكررات[0].الموجود,
                التصريحات.المكررات[0].النطاق
            );
        };
        لو ((الطول(التصريحات.الأهداف_المفقودة) مثل غير_موقع) != 0) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_مفقود(
                التصريحات.الأهداف_المفقودة[0]
            );
        };
        لو ((الطول(التصريحات.الأهداف_الخاصة) مثل غير_موقع) != 0) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_خاص(
                التصريحات.الأهداف_الخاصة[0]
            );
        };
        لو ((الطول(التصريحات.تعارضات_الربط) مثل غير_موقع) != 0) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.تعارض_ربط(
                التصريحات.تعارضات_الربط[0]
            );
        };
        أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.مكتملة(التصريحات);
    };
}

عام عرف ابن_دلالة_أسماء_وحدة_من_تصريحات(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الوحدة_النحوية: &وحدة_مصدر,
    التصريحات_المجمعة: &جدول_تصريحات
): نتيجة_دلالة_أسماء_وحدة {
    طابق وحدة_في_الرسم(الرسم, الوحدة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة();
    }
    | اختيار.بعض(الدلالية) -> {
        دع المصدرية: وحدة_مصدر = *الوحدة_النحوية;
        لو (الدلالية.معرف_المصدر != المصدرية.المصدر.المعرف) {
            أرجع نتيجة_دلالة_أسماء_وحدة.مصدر_غير_مطابق();
        };
        دع التصريحات: جدول_تصريحات = *التصريحات_المجمعة;
        لو (!معرفا_وحدة_متساويان(التصريحات.الوحدة.المعرف, الوحدة)) {
            أرجع نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة();
        };
        لو (التصريحات.الوحدة.معرف_المصدر != المصدرية.المصدر.المعرف) {
            أرجع نتيجة_دلالة_أسماء_وحدة.مصدر_غير_مطابق();
        };
        دع روابط_الوحدة: متغير سياق_روابط_أسماء = سياق_روابط_أسماء_جديد();
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المصدرية.العناصر) مثل غير_موقع)) {
            دع مرجع_العنصر: &عنصر_وحدة = &المصدرية.العناصر[ف];
            دع العنصر: عنصر_وحدة = *مرجع_العنصر;
            طابق العنصر مع
            | عنصر_وحدة.دالة(الدالة) -> {
                دع خطأ_العلوي: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                    سياق_الأسماء,
                    &متغير روابط_الوحدة,
                    &المصدرية.المصدر,
                    الدلالية.النطاق_الجذري,
                    &الدالة.الاسم
                );
                لو (هل_خطأ_ربط_أسماء(خطأ_العلوي)) {
                    أرجع نتيجة_خطأ(خطأ_العلوي);
                };
                دع فهرس_البديل: متغير غير_موقع = 0;
                بينما (فهرس_البديل < (الطول(الدالة.الأسماء_البديلة) مثل غير_موقع)) {
                    دع خطأ_البديل: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                        سياق_الأسماء,
                        &متغير روابط_الوحدة,
                        &المصدرية.المصدر,
                        الدلالية.النطاق_الجذري,
                        &الدالة.الأسماء_البديلة[فهرس_البديل]
                    );
                    لو (هل_خطأ_ربط_أسماء(خطأ_البديل)) {
                        أرجع نتيجة_خطأ(خطأ_البديل);
                    };
                    فهرس_البديل := فهرس_البديل + 1;
                }
                دع نطاق_الدالة: معرف_نطاق = نطاق_ابن_بمصدر(سياق_الأسماء, الدلالية.النطاق_الجذري, الدالة.النطاق);
                دع ط: متغير غير_موقع = 0;
                بينما (ط < (الطول(الدالة.معاملات_النوع) مثل غير_موقع)) {
                    دع خطأ_معامل_النوع: خطأ_ربط_أسماء = سجل_محليا(
                        سياق_الأسماء,
                        &متغير روابط_الوحدة,
                        &المصدرية.المصدر,
                        نطاق_الدالة,
                        &الدالة.معاملات_النوع[ط],
                        الدالة.معاملات_النوع[ط].النطاق,
                        نوع_تصريح.معامل_نوع()
                    );
                    لو (هل_خطأ_ربط_أسماء(خطأ_معامل_النوع)) {
                        أرجع نتيجة_خطأ(خطأ_معامل_النوع);
                    };
                    ط := ط + 1;
                }
                دع ه: متغير غير_موقع = 0;
                بينما (ه < (الطول(الدالة.المعاملات) مثل غير_موقع)) {
                    دع خ1: خطأ_ربط_أسماء = اربط_نوعا(
                        سياق_الأسماء,
                        الرسم,
                        الوحدة,
                        نطاق_الدالة,
                        &متغير روابط_الوحدة,
                        &المصدرية.المصدر,
                        &الدالة.المعاملات[ه].النوع
                    );
                    لو (هل_خطأ_ربط_أسماء(خ1)) {
                        أرجع نتيجة_خطأ(خ1);
                    };
                    دع خ2: خطأ_ربط_أسماء = سجل_محليا(
                        سياق_الأسماء,
                        &متغير روابط_الوحدة,
                        &المصدرية.المصدر,
                        نطاق_الدالة,
                        &الدالة.المعاملات[ه].الاسم,
                        الدالة.المعاملات[ه].النطاق,
                        نوع_تصريح.معامل()
                    );
                    لو (هل_خطأ_ربط_أسماء(خ2)) {
                        أرجع نتيجة_خطأ(خ2);
                    };
                    ه := ه + 1;
                }
                دع خطأ_الناتج: خطأ_ربط_أسماء = اربط_نوعا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الدالة,
                    &متغير روابط_الوحدة,
                    &المصدرية.المصدر,
                    &الدالة.الناتج
                );
                لو (هل_خطأ_ربط_أسماء(خطأ_الناتج)) {
                    أرجع نتيجة_خطأ(خطأ_الناتج);
                };
                طابق الدالة.الجسم مع | اختيار.بعض(الجسم) -> {
                    دع خطأ_الجسم: خطأ_ربط_أسماء = اربط_كتلة(
                        سياق_الأسماء,
                        الرسم,
                        الوحدة,
                        نطاق_الدالة,
                        &متغير روابط_الوحدة,
                        &المصدرية.المصدر,
                        &الجسم,
                        خطأ
                    );
                    لو (هل_خطأ_ربط_أسماء(خطأ_الجسم)) {
                        أرجع نتيجة_خطأ(خطأ_الجسم);
                    };
                } | اختيار.لا_شيء -> {
                };
            }
            | عنصر_وحدة.نوع(التصريح) -> {
                دع خطأ_العلوي: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                    سياق_الأسماء,
                    &متغير روابط_الوحدة,
                    &المصدرية.المصدر,
                    الدلالية.النطاق_الجذري,
                    &التصريح.الاسم
                );
                لو (هل_خطأ_ربط_أسماء(خطأ_العلوي)) {
                    أرجع نتيجة_خطأ(خطأ_العلوي);
                };
                دع نطاق_النوع: معرف_نطاق = نطاق_ابن_بمصدر(
                    سياق_الأسماء, الدلالية.النطاق_الجذري, التصريح.النطاق
                );
                دع ط: متغير غير_موقع = 0;
                بينما (ط < (الطول(التصريح.معاملات_النوع) مثل غير_موقع)) {
                    دع خطأ_معامل_النوع: خطأ_ربط_أسماء = سجل_محليا(
                        سياق_الأسماء,
                        &متغير روابط_الوحدة,
                        &المصدرية.المصدر,
                        نطاق_النوع,
                        &التصريح.معاملات_النوع[ط],
                        التصريح.معاملات_النوع[ط].النطاق,
                        نوع_تصريح.معامل_نوع()
                    );
                    لو (هل_خطأ_ربط_أسماء(خطأ_معامل_النوع)) {
                        أرجع نتيجة_خطأ(خطأ_معامل_النوع);
                    };
                    ط := ط + 1;
                }
                طابق التصريح.الشكل مع
                | شكل_تصريح_نوع.مرادف(النوع) -> {
                    دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                        سياق_الأسماء,
                        الرسم,
                        الوحدة,
                        نطاق_النوع,
                        &متغير روابط_الوحدة,
                        &المصدرية.المصدر,
                        &النوع
                    );
                    لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                        أرجع نتيجة_خطأ(الخطأ);
                    };
                }
                | شكل_تصريح_نوع.سجل(الحقول) -> {
                    دع ه: متغير غير_موقع = 0;
                    بينما (ه < (الطول(الحقول) مثل غير_موقع)) {
                        قنن_واربط_ظهور_اسم(سياق_الأسماء, &متغير روابط_الوحدة, &المصدرية.المصدر, الحقول[ه].الاسم.النطاق);
                        دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                            سياق_الأسماء,
                            الرسم,
                            الوحدة,
                            نطاق_النوع,
                            &متغير روابط_الوحدة,
                            &المصدرية.المصدر,
                            &الحقول[ه].النوع
                        );
                        لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                            أرجع نتيجة_خطأ(الخطأ);
                        };
                        ه := ه + 1;
                    }
                }
                | شكل_تصريح_نوع.تعداد(المنشئات) -> {
                    دع رمز_التعداد: متغير معرف_رمز = معرف_رمز_من(0);
                    طابق رمز_اسم_محلول_عند(&روابط_الوحدة, التصريح.الاسم.النطاق) مع
                    | اختيار.بعض(الرمز) -> { رمز_التعداد := الرمز; }
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_خطأ(خطأ_ربط_أسماء.اسم_مفقود(التصريح.الاسم.النطاق));
                    };
                    دع ه: متغير غير_موقع = 0;
                    بينما (ه < (الطول(المنشئات) مثل غير_موقع)) {
                        طابق حل_واربط_منشئ_مسمى(
                            سياق_الأسماء,
                            &متغير روابط_الوحدة,
                            &المصدرية.المصدر,
                            المنشئات[ه].الاسم.النطاق,
                            رمز_التعداد
                        ) مع
                        | اختيار.بعض(_) -> { }
                        | اختيار.لا_شيء -> {
                            أرجع نتيجة_خطأ(خطأ_ربط_أسماء.اسم_مفقود(المنشئات[ه].الاسم.النطاق));
                        };
                        دع ج: متغير غير_موقع = 0;
                        بينما (ج < (الطول(المنشئات[ه].الحمولات) مثل غير_موقع)) {
                            دع الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                                سياق_الأسماء,
                                الرسم,
                                الوحدة,
                                نطاق_النوع,
                                &متغير روابط_الوحدة,
                                &المصدرية.المصدر,
                                &المنشئات[ه].الحمولات[ج]
                            );
                            لو (هل_خطأ_ربط_أسماء(الخطأ)) {
                                أرجع نتيجة_خطأ(الخطأ);
                            };
                            ج := ج + 1;
                        } ه := ه + 1;
                    }
                };
            }
            | عنصر_وحدة.تجميع(س, ب) -> { };
            ف := ف + 1;
        }
        دع يسمح_بجسر_بدائي_داخلي: منطقي = وحدة_تسمح_بجسر_بدائي_داخلي(&الدلالية);
        دع فهرس_المرادف: متغير غير_موقع = 0;
        بينما (فهرس_المرادف < (الطول(المصدرية.مرادفات_الأسماء) مثل غير_موقع)) {
            دع التصريح: &تصريح_مرادف_اسم = &المصدرية.مرادفات_الأسماء[فهرس_المرادف];
            دع خطأ_المرادف: خطأ_ربط_أسماء = اربط_مرادف_اسم_علويا(
                سياق_الأسماء,
                &متغير روابط_الوحدة,
                &المصدرية.المصدر,
                الدلالية.النطاق_الجذري,
                يسمح_بجسر_بدائي_داخلي,
                التصريح
            );
            لو (هل_خطأ_ربط_أسماء(خطأ_المرادف)) {
                أرجع نتيجة_خطأ(خطأ_المرادف);
            };
            فهرس_المرادف := فهرس_المرادف + 1;
        }
        دع الناتج: دلالة_أسماء_وحدة = { الوحدة: الوحدة, التصريحات: التصريحات, الروابط: روابط_الوحدة };
        أرجع نتيجة_دلالة_أسماء_وحدة.مكتملة(الناتج);
     };
}

// Compatibility entry for single-module callers: collect once, then resolve.
عام عرف ابن_دلالة_أسماء_وحدة(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الوحدة_النحوية: &وحدة_مصدر
): نتيجة_دلالة_أسماء_وحدة {
    طابق اجمع_تصريحات_أسماء_وحدة(
        سياق_الأسماء, الرسم, الوحدة, الوحدة_النحوية
    ) مع
    | نتيجة_جمع_تصريحات_أسماء_وحدة.مكتملة(التصريحات) -> {
        أرجع ابن_دلالة_أسماء_وحدة_من_تصريحات(
            سياق_الأسماء, الرسم, الوحدة, الوحدة_النحوية, &التصريحات
        );
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.وحدة_مجهولة -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة();
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.مصدر_غير_مطابق -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.مصدر_غير_مطابق();
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.تصريح_مكرر(_, النطاق) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.تصريح_مكرر(النطاق);
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_مفقود(النطاق) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_مفقود(النطاق);
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_خاص(النطاق) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_خاص(النطاق);
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.تعارض_ربط(النطاق) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.تعارض_ربط(النطاق);
    };
}
