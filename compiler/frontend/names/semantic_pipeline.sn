استورد compiler.frontend.names.suggestions;
استورد المكتبة.نصوص.من_بايتات;

// Parsed-source Name result. All stored facts remain Name/Module identities only.
عام نوع دلالة_أسماء_وحدة = {
    الوحدة: معرف_وحدة,
    الروابط: سياق_روابط_أسماء
};

عام نوع نتيجة_دلالة_أسماء_وحدة =
    | مكتملة بنوع دلالة_أسماء_وحدة
    | وحدة_مجهولة
    | مصدر_غير_مطابق
    // The earlier Symbol and the repeated declaration.
    | تصريح_مكرر بنوع (معرف_رمز, نطاق)
    | اسم_مفقود بنوع نطاق
    | اسم_خاص بنوع نطاق
    | اسم_غامض بنوع نطاق
    | تعارض_ربط بنوع نطاق
    // `مرادف A.v = T.v` whose A is not an alias of T (or a variant alias
    // with only one qualified side): a user error, not an internal one.
    | مرادف_أب_غير_مطابق بنوع نطاق
    | معتم_يحجب_نوعا_مرئيا بنوع نطاق
    // Every unknown name of the module, in source order (resolved_bindings.sn).
    | أسماء_مفقودة بنوع متجه اسم_مفقود_مؤجل
    // The pass bound the whole module and only these names were unknown: the
    // binding context is complete except for those occurrences, which stay
    // unbound. A compilation rejects it like أسماء_مفقودة; a tooling request
    // keeps the module and sets aside the declarations that use those names.
    | أسماء_مفقودة_مربوطة بنوع (متجه اسم_مفقود_مؤجل, دلالة_أسماء_وحدة)
;

// Graph-level Name processing separates declaration registration from use resolution.
// This lets every canonical module publish its Symbols before any importer resolves names.
عام نوع نتيجة_جمع_تصريحات_أسماء_وحدة =
    | مكتملة بنوع جدول_تصريحات
    | وحدة_مجهولة
    | مصدر_غير_مطابق
    | تصريح_مكرر بنوع (معرف_رمز, نطاق)
    | اسم_مفقود بنوع نطاق
    | اسم_خاص بنوع نطاق
    | تعارض_ربط بنوع نطاق
    | مرادف_أب_غير_مطابق بنوع نطاق
;

نوع خطأ_ربط_أسماء =
    | لا_خطأ
    | تصريح_مكرر بنوع (معرف_رمز, نطاق)
    | اسم_مفقود بنوع نطاق
    | اسم_خاص بنوع نطاق
    | اسم_غامض بنوع نطاق
    | تعارض_ربط بنوع نطاق
    | مرادف_أب_غير_مطابق بنوع نطاق
    // `type X = opaque;` where a type named opaque/معتم is visible: the
    // declaration would silently stop aliasing it. The span is the word.
    | معتم_يحجب_نوعا_مرئيا بنوع نطاق
;

عرف هل_خطأ_ربط_أسماء(الخطأ: خطأ_ربط_أسماء): منطقي {
    طابق الخطأ مع
    | خطأ_ربط_أسماء.لا_خطأ -> {
        أرجع خطأ;
    }
    | _ -> {
        أرجع صواب;
    };
}

عرف نتيجة_خطأ(الخطأ: خطأ_ربط_أسماء): نتيجة_دلالة_أسماء_وحدة {
    طابق الخطأ مع
    | خطأ_ربط_أسماء.تصريح_مكرر(الموجود, س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.تصريح_مكرر(الموجود, س);
    }
    | خطأ_ربط_أسماء.اسم_مفقود(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_مفقود(س);
    }
    | خطأ_ربط_أسماء.اسم_خاص(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_خاص(س);
    }
    | خطأ_ربط_أسماء.اسم_غامض(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_غامض(س);
    }
    | خطأ_ربط_أسماء.تعارض_ربط(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.تعارض_ربط(س);
    }
    | خطأ_ربط_أسماء.مرادف_أب_غير_مطابق(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.مرادف_أب_غير_مطابق(س);
    }
    | خطأ_ربط_أسماء.معتم_يحجب_نوعا_مرئيا(س) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.معتم_يحجب_نوعا_مرئيا(س);
    }
    | خطأ_ربط_أسماء.لا_خطأ -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة();
    };
}

عرف انسخ_أسماء_مفقودة_مؤجلة(القيمة: &متجه اسم_مفقود_مؤجل): متجه اسم_مفقود_مؤجل {
    ليكن الناتج: متغير متجه اسم_مفقود_مؤجل = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ليكن الوحدات: متغير متجه معرف_وحدة = [];
        ليكن و: متغير طبيعي = 0;
        طالما (و < (الطول((*القيمة)[ف].الوحدات_المصرحة) مثل طبيعي)) {
            ألحق(الوحدات, (*القيمة)[ف].الوحدات_المصرحة[و]);
            و := و + 1;
        }
        ليكن المفقود: اسم_مفقود_مؤجل = {
            النطاق: (*القيمة)[ف].النطاق,
            الاقتراح: انسخ_اختيار_نص(&(*القيمة)[ف].الاقتراح),
            الوحدات_المصرحة: الوحدات,
            المنشئ_غير_المستدعى: (*القيمة)[ف].المنشئ_غير_المستدعى
        };
        ألحق(الناتج, المفقود);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The result of a module whose binding stopped at الخطأ. When unknown names
// were deferred before it, they are the result (the first of them is the
// error the pass stopped at before deferral existed), and الخطأ is added
// when it is another unknown name; any other later error may follow from an
// unbound name and is not reported.
عرف نتيجة_خطأ_مع_المؤجلة(
    الخطأ: خطأ_ربط_أسماء,
    الروابط: &متغير سياق_روابط_أسماء
): نتيجة_دلالة_أسماء_وحدة {
    إذا ((الطول((*الروابط).الأسماء_المفقودة) مثل طبيعي) == 0) { أرجع نتيجة_خطأ(الخطأ); };
    طابق الخطأ مع
    | خطأ_ربط_أسماء.اسم_مفقود(س) -> {
        ليكن بلا_وحدات: متجه معرف_وحدة = [];
        ليكن المفقود: اسم_مفقود_مؤجل = {
            النطاق: س, الاقتراح: اختياري.لا_شيء(), الوحدات_المصرحة: بلا_وحدات,
            المنشئ_غير_المستدعى: اختياري.لا_شيء()
        };
        سجل_اسما_مفقودا_مؤجلا(الروابط, المفقود);
    }
    | _ -> { };
    أرجع نتيجة_دلالة_أسماء_وحدة.أسماء_مفقودة(انسخ_أسماء_مفقودة_مؤجلة(&(*الروابط).الأسماء_المفقودة));
}

// Records an unknown value name with its evidence (names/suggestions.sn).
عرف أجل_اسما_مفقودا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النطاق: نطاق
): فراغ {
    ليكن الهوية: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى, النطاق.البداية.البايت, النطاق.النهاية.البايت
    );
    ليكن الاقتراح: اختياري نص = اقترح_اسما_مرئيا(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, &الهوية, حيز_اسم.قيمة(),
        &(*المصدر).المحتوى, النطاق.البداية.البايت مثل طبيعي
    );
    ليكن الوحدات: متجه معرف_وحدة = وحدات_تصرح_بالاسم_علنا(
        سياق_الأسماء, الرسم, الوحدة, &الهوية, حيز_اسم.قيمة()
    );
    ليكن المفقود: اسم_مفقود_مؤجل = {
        النطاق: النطاق, الاقتراح: الاقتراح, الوحدات_المصرحة: الوحدات,
        المنشئ_غير_المستدعى: اختياري.لا_شيء()
    };
    سجل_اسما_مفقودا_مؤجلا(الروابط, المفقود);
}

عرف اربط_ظهور_مرئي_في_حيز(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الاسم: &اسم,
    الحيز: حيز_اسم
): خطأ_ربط_أسماء {
    ليكن الظهور: اسم = *الاسم;
    ليكن الهوية: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى,
        الظهور.النطاق.البداية.البايت,
        الظهور.النطاق.النهاية.البايت
    );
    طابق حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, &الهوية, الحيز
    ) مع
    | نتيجة_حل_ظهور_اسم.موجود(الرمز) -> {
        طابق اسم_رمز_عند(سياق_الأسماء, الرمز) مع
        | اختياري.لا_شيء -> {
            أرجع خطأ_ربط_أسماء.اسم_مفقود(الظهور.النطاق);
        }
        | اختياري.موجود(هوية_الاسم) -> {
            إذا (!أضف_ظهور_اسم_محلول(
                الروابط, الظهور.النطاق, هوية_الاسم, الرمز
            )) {
                أرجع خطأ_ربط_أسماء.تعارض_ربط(الظهور.النطاق);
            };
        };
        أرجع خطأ_ربط_أسماء.لا_خطأ();
    }
    | نتيجة_حل_ظهور_اسم.خاص -> {
        أرجع خطأ_ربط_أسماء.اسم_خاص(الظهور.النطاق);
    }
    | نتيجة_حل_ظهور_اسم.غامض -> {
        أرجع خطأ_ربط_أسماء.اسم_غامض(الظهور.النطاق);
    }
    | نتيجة_حل_ظهور_اسم.مفقود -> {
        أرجع خطأ_ربط_أسماء.اسم_مفقود(الظهور.النطاق);
    };
}

عرف اربط_ظهور_قيمة_مرئي(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الاسم: &اسم
): خطأ_ربط_أسماء {
    أرجع اربط_ظهور_مرئي_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, الاسم, حيز_اسم.قيمة()
    );
}

عرف اربط_ظهور_نوع_مرئي(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الاسم: &اسم
): خطأ_ربط_أسماء {
    أرجع اربط_ظهور_مرئي_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, الاسم, حيز_اسم.نوع()
    );
}

عرف اربط_نوعا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النوع: &نوع_تركيبي
): خطأ_ربط_أسماء {
    ليكن ت: نوع_تركيبي = *النوع;
    طابق ت مع
    | نوع_تركيبي.مسمى(س, الاسم, الحجج) -> {
        ليكن خطأ_الاسم: خطأ_ربط_أسماء = اربط_ظهور_نوع_مرئي(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الاسم
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_الاسم)) {
            أرجع خطأ_الاسم;
        };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الحجج[ف]
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | نوع_تركيبي.صف(س, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &العناصر[ف]
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | نوع_تركيبي.صندوق(س, الداخل) -> {
        ليكن قيمة_الداخل: نوع_تركيبي = *الداخل;
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.اختيار(س, الداخل) -> {
        سجل_نوع_سياقي_مهجور(الروابط, المصدر, س);
        ليكن قيمة_الداخل: نوع_تركيبي = *الداخل;
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.مؤشر(س, الداخل) -> {
        ليكن قيمة_الداخل: نوع_تركيبي = *الداخل;
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.مرجع(س, الداخل) -> {
        ليكن قيمة_الداخل: نوع_تركيبي = *الداخل;
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.شريحة(س, الداخل) -> {
        ليكن قيمة_الداخل: نوع_تركيبي = *الداخل;
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.متجه(س, الداخل) -> {
        ليكن قيمة_الداخل: نوع_تركيبي = *الداخل;
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.متغير(س, الداخل) -> {
        ليكن قيمة_الداخل: نوع_تركيبي = *الداخل;
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | نوع_تركيبي.نتيجة(س, أ, ب) -> {
        ليكن قيمة_أ: نوع_تركيبي = *أ;
        ليكن خطأ_أ: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_أ);
        إذا (هل_خطأ_ربط_أسماء(خطأ_أ)) {
            أرجع خطأ_أ;
        };
        ليكن قيمة_ب: نوع_تركيبي = *ب;
        ليكن خطأ_ب: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_ب);
        إذا (هل_خطأ_ربط_أسماء(خطأ_ب)) {
            أرجع خطأ_ب;
        };
    }
    | نوع_تركيبي.دالة(س, المعاملات, الناتج) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &المعاملات[ف]
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
        ليكن قيمة_الناتج: نوع_تركيبي = *الناتج;
        ليكن خطأ_الناتج: خطأ_ربط_أسماء = اربط_نوعا(
            سياق_الأسماء,
            الرسم,
            الوحدة,
            النطاق_الحالي,
            الروابط,
            المصدر,
            &قيمة_الناتج
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_الناتج)) {
            أرجع خطأ_الناتج;
        };
    }
    | نوع_تركيبي.أي(س) -> { }
    | نوع_تركيبي.منطقي(س) -> { }
    | نوع_تركيبي.آلة(س, أ) -> { }
    | نوع_تركيبي.عدد(س) -> { }
    | نوع_تركيبي.طبيعي(س) -> { }
    | نوع_تركيبي.حرف(س) -> { }
    | نوع_تركيبي.نص(س) -> { }
    | نوع_تركيبي.فراغ(س) -> { };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

// The end of the identifier that starts at البداية.
عرف نهاية_معرف_عند(النص: &نص, البداية: طبيعي): طبيعي {
    ليكن الحد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن الموضع: متغير طبيعي = البداية;
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر && الموضع < الحد) {
        ليكن المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, الموضع);
        إذا (!المفكوك.صالح || !تتمة_معرف(المفكوك.القيمة)) {
            مستمر := خطأ;
        } وإلا {
            الموضع := الموضع + المفكوك.العرض;
        };
    }
    أرجع الموضع;
}

// A contextual Type name written in a deprecated spelling (type_registry.def,
// SULTANC__TYPE_CONTEXTUAL_DEPRECATED__): one warning at the name.
عرف سجل_اسم_نوع_مهجور(
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    البداية: طبيعي,
    النهاية: طبيعي,
    معرف_المصدر: طبيعي
): فراغ {
    ليكن الأصل: مصدر = *المصدر;
    إذا (معرف_المصدر == الأصل.المعرف) {
        طابق تهجئة_مهجورة_لاسم_نوع_سياقي(&الأصل.المحتوى, البداية, النهاية) مع
        | اختياري.موجود({ القديمة: القديمة, الجديدة: الجديدة }) -> {
            ليكن من_موضع: موضع = { المصدر: (معرف_المصدر مثل ط32), البايت: (البداية مثل ط32) };
            ليكن إلى_موضع: موضع = { المصدر: (معرف_المصدر مثل ط32), البايت: (النهاية مثل ط32) };
            سجل_تهجئة_مهجورة(الروابط, نطاق_بين(من_موضع, إلى_موضع), القديمة, الجديدة);
        }
        | اختياري.لا_شيء -> { };
    };
}

// A Type node's span starts at its name: the Option Type `اختياري T`, here
// written in its deprecated spelling `اختيار T`.
عرف سجل_نوع_سياقي_مهجور(
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النطاق: نطاق
): فراغ {
    ليكن الأصل: مصدر = *المصدر;
    إذا ((النطاق.البداية.المصدر مثل طبيعي) == الأصل.المعرف) {
        ليكن النهاية: طبيعي = نهاية_معرف_عند(&الأصل.المحتوى, النطاق.البداية.البايت);
        سجل_اسم_نوع_مهجور(
            الروابط, المصدر, النطاق.البداية.البايت, النهاية, النطاق.البداية.المصدر
        );
    };
}

// A builtin tagged constructor `النوع.المنشئ`: the deprecated Option type name
// (اختيار) and the deprecated Option constructor بعض (now موجود) each warn
// once. The constructor spellings are matched in
// compiler/frontend/types/type_semantic_shape_queries.sn.
عرف سجل_منشئ_مدمج_مهجور(
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    نطاق_النوع: نطاق,
    نطاق_المنشئ: نطاق
): فراغ {
    سجل_اسم_نوع_مهجور(
        الروابط, المصدر, نطاق_النوع.البداية.البايت, نطاق_النوع.النهاية.البايت,
        نطاق_النوع.البداية.المصدر
    );
    ليكن الأصل: مصدر = *المصدر;
    إذا ((نطاق_المنشئ.البداية.المصدر مثل طبيعي) == الأصل.المعرف) {
        طابق صنف_اسم_نوع_سياقي_في_نطاق(المصدر, نطاق_النوع) مع
        | صنف_اسم_نوع_سياقي.اختياري -> {
            إذا (تطابق_هوية_معرف_وشريحة(
                &الأصل.المحتوى, نطاق_المنشئ.البداية.البايت, نطاق_المنشئ.النهاية.البايت, «بعض»
            )) {
                سجل_تهجئة_مهجورة(الروابط, نطاق_المنشئ, «بعض», «موجود»);
            };
        }
        | _ -> { };
    };
}

// The spellings of the prelude constructors, usable bare: option's `some`
// and `none` (`موجود`, `لا_شيء`) and result's `ok` and `err` (`نجح`, `خطأ`).
عام عرف هل_تهجئة_منشئ_تمهيدي(الهوية: &متجه ط8): منطقي {
    ليكن التهجئات: متجه نص = [«some», «none», «ok», «err», «موجود», «لا_شيء», «نجح», «خطأ»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(التهجئات) مثل طبيعي)) {
        إذا (تطابق_هوية_بايتات_ونص(الهوية, &التهجئات[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// `split_mutable` (`اقسم_قابلا_للتعديل`): the compiler's own function that
// splits a writable vector or slice into two writable views
// (types/semantic_pipeline.sn, ابن_نوع_قسمة_قابلة_للتعديل_داخلي). A
// declaration of the same name shadows it.
عام عرف هل_تهجئة_قسمة_قابلة_للتعديل(الهوية: &متجه ط8): منطقي {
    ليكن الإنجليزية: نص = «split_mutable»;
    ليكن العربية: نص = «اقسم_قابلا_للتعديل»;
    أرجع تطابق_هوية_بايتات_ونص(الهوية, &الإنجليزية) || تطابق_هوية_بايتات_ونص(الهوية, &العربية);
}

// Whether a bare prelude constructor is one of result's (`ok`, `err`, `نجح`,
// `خطأ`) rather than option's.
عام عرف هل_تهجئة_منشئ_تمهيدي_للنتيجة(الهوية: &متجه ط8): منطقي {
    ليكن التهجئات: متجه نص = [«ok», «err», «نجح», «خطأ»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(التهجئات) مثل طبيعي)) {
        إذا (تطابق_هوية_بايتات_ونص(الهوية, &التهجئات[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف هل_اسم_نوع_موسوم_مدمج(المصدر: &مصدر, الاسم: &اسم): منطقي {
    ليكن القيمة: اسم = *الاسم;
    طابق صنف_اسم_نوع_سياقي_في_نطاق(المصدر, القيمة.النطاق) مع
    | صنف_اسم_نوع_سياقي.اختياري -> { أرجع صواب; }
    | صنف_اسم_نوع_سياقي.نتيجة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Enum-constructor call qualifiers are Type-position names in Stage0 semantics.
// Probe that interpretation without binding the qualifier as a value; ordinary field
// access falls back to normal value binding when no constructor exists.
عرف حاول_اربط_منشئ_مستدعى(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    المستدعى: &تعبير
): منطقي {
    ليكن القيمة: تعبير = *المستدعى;
    طابق القيمة مع
    | تعبير.حقل(_, الأصل, الحقل) -> {
        ليكن قيمة_الأصل: تعبير = *الأصل;
        طابق قيمة_الأصل مع
        | تعبير.اسم(_, اسم_النوع) -> {
            إذا (هل_اسم_نوع_موسوم_مدمج(المصدر, &اسم_النوع)) {
                قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_النوع.النطاق);
                قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الحقل.النطاق);
                سجل_منشئ_مدمج_مهجور(الروابط, المصدر, اسم_النوع.النطاق, الحقل.النطاق);
                أرجع صواب;
            };
            ليكن هوية_النوع: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
                &(*المصدر).المحتوى,
                اسم_النوع.النطاق.البداية.البايت,
                اسم_النوع.النطاق.النهاية.البايت
            );
            طابق حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, &هوية_النوع, حيز_اسم.نوع()
            ) مع
            | نتيجة_حل_ظهور_اسم.موجود(رمز_النوع) -> {
                طابق حل_واربط_منشئ_مسمى(
                    سياق_الأسماء, الروابط, المصدر, الحقل.النطاق, رمز_النوع
                ) مع
                | اختياري.موجود(_) -> {
                    طابق اسم_رمز_عند(سياق_الأسماء, رمز_النوع) مع
                    | اختياري.موجود(اسم_مقنن) -> {
                        أرجع أضف_ظهور_اسم_محلول(
                            الروابط, اسم_النوع.النطاق, اسم_مقنن, رمز_النوع
                        );
                    }
                    | اختياري.لا_شيء -> { أرجع خطأ; };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع خطأ;
}

// `Enum.missing(...)` whose qualifier names an enum Type and no value: the
// constructor is unknown, not the Type (which value binding would report).
عرف نطاق_منشئ_مستدعى_مجهول(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    المصدر: &مصدر,
    المستدعى: &تعبير
): اختياري نطاق {
    ليكن القيمة: تعبير = *المستدعى;
    طابق القيمة مع
    | تعبير.حقل(_, الأصل, الحقل) -> {
        ليكن قيمة_الأصل: تعبير = *الأصل;
        طابق قيمة_الأصل مع
        | تعبير.اسم(_, اسم_النوع) -> {
            ليكن هوية_النوع: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
                &(*المصدر).المحتوى,
                اسم_النوع.النطاق.البداية.البايت,
                اسم_النوع.النطاق.النهاية.البايت
            );
            طابق حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, &هوية_النوع, حيز_اسم.قيمة()
            ) مع
            | نتيجة_حل_ظهور_اسم.موجود(_) -> { أرجع اختياري.لا_شيء(); }
            | _ -> { };
            طابق حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, &هوية_النوع, حيز_اسم.نوع()
            ) مع
            | نتيجة_حل_ظهور_اسم.موجود(رمز_النوع) -> {
                طابق نوع_رمز_عند(سياق_الأسماء, رمز_النوع) مع
                | اختياري.موجود(نوع_تصريح.تعداد) -> { أرجع اختياري.موجود(الحقل.النطاق); }
                | _ -> { };
            }
            | _ -> { };
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

عرف حاول_اربط_عضو_استيراد_مسمى(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    المرادف: &اسم,
    العضو: &اسم,
    الحيز: حيز_اسم
): اختياري خطأ_ربط_أسماء {
    ليكن اسم_المرادف: اسم = *المرادف;
    ليكن اسم_العضو: اسم = *العضو;
    ليكن هوية_المرادف: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى, اسم_المرادف.النطاق.البداية.البايت, اسم_المرادف.النطاق.النهاية.البايت
    );
    ليكن هوية_العضو: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى, اسم_العضو.النطاق.البداية.البايت, اسم_العضو.النطاق.النهاية.البايت
    );
    طابق حل_عضو_استيراد_مسمى_ببايتات_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, &هوية_المرادف, &هوية_العضو, الحيز
    ) مع
    | نتيجة_حل_عضو_استيراد_مسمى.ليس_مرادفا -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_عضو_استيراد_مسمى.موجود(الرمز) -> {
        قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_المرادف.النطاق);
        طابق اسم_رمز_عند(سياق_الأسماء, الرمز) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_ربط_أسماء.اسم_مفقود(اسم_العضو.النطاق));
        }
        | اختياري.موجود(هوية_الاسم) -> {
            إذا (!أضف_ظهور_اسم_محلول(الروابط, اسم_العضو.النطاق, هوية_الاسم, الرمز)) {
                أرجع اختياري.موجود(خطأ_ربط_أسماء.تعارض_ربط(اسم_العضو.النطاق));
            };
        };
        أرجع اختياري.موجود(خطأ_ربط_أسماء.لا_خطأ());
    }
    | نتيجة_حل_عضو_استيراد_مسمى.خاص -> {
        قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_المرادف.النطاق);
        أرجع اختياري.موجود(خطأ_ربط_أسماء.اسم_خاص(اسم_العضو.النطاق));
    }
    | نتيجة_حل_عضو_استيراد_مسمى.غامض -> {
        قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_المرادف.النطاق);
        أرجع اختياري.موجود(خطأ_ربط_أسماء.اسم_غامض(اسم_العضو.النطاق));
    }
    | نتيجة_حل_عضو_استيراد_مسمى.مفقود -> {
        قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, اسم_المرادف.النطاق);
        أرجع اختياري.موجود(خطأ_ربط_أسماء.اسم_مفقود(اسم_العضو.النطاق));
    };
}

// `Enum.Ctor` read as a value instead of called (`Color.Red` for
// `Color.Red()`): the qualifier names no value here and an enum Type that
// declares the constructor. Both names are bound (to the Type and to the
// constructor, so tooling still knows them), and the occurrence is deferred
// like an unknown name: a compilation rejects the module
// (SULTANC-NAME-CONSTRUCTOR-NOT-CALLED), and a tooling request sets aside the
// declaration that holds it. False when the expression is no such read.
عرف أجل_منشئا_غير_مستدعى(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    نطاق_التعبير: نطاق,
    اسم_النوع: &اسم,
    الحقل: &اسم
): منطقي {
    ليكن النوع_المكتوب: اسم = *اسم_النوع;
    ليكن المنشئ_المكتوب: اسم = *الحقل;
    ليكن هوية_النوع: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى,
        النوع_المكتوب.النطاق.البداية.البايت,
        النوع_المكتوب.النطاق.النهاية.البايت
    );
    // A value of that name wins: `x.f` stays a field read.
    طابق حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, &هوية_النوع, حيز_اسم.قيمة()
    ) مع
    | نتيجة_حل_ظهور_اسم.مفقود -> { }
    | _ -> { أرجع خطأ; };
    طابق حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, &هوية_النوع, حيز_اسم.نوع()
    ) مع
    | نتيجة_حل_ظهور_اسم.موجود(رمز_النوع) -> {
        طابق نوع_رمز_عند(سياق_الأسماء, رمز_النوع) مع
        | اختياري.موجود(نوع_تصريح.تعداد) -> { }
        | _ -> { أرجع خطأ; };
        طابق حل_واربط_منشئ_مسمى(
            سياق_الأسماء, الروابط, المصدر, المنشئ_المكتوب.النطاق, رمز_النوع
        ) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(رمز_المنشئ) -> {
            طابق اسم_رمز_عند(سياق_الأسماء, رمز_النوع) مع
            | اختياري.موجود(اسم_مقنن) -> {
                ليكن ربط_النوع: منطقي = أضف_ظهور_اسم_محلول(
                    الروابط, النوع_المكتوب.النطاق, اسم_مقنن, رمز_النوع
                );
            }
            | اختياري.لا_شيء -> { };
            ليكن تصريح_المنشئ: متغير نطاق = المنشئ_المكتوب.النطاق;
            طابق نطاق_تصريح_رمز_عند(سياق_الأسماء, رمز_المنشئ) مع
            | اختياري.موجود(نطاق_التصريح) -> { تصريح_المنشئ := نطاق_التصريح; }
            | اختياري.لا_شيء -> { };
            ليكن المنشئ: منشئ_غير_مستدعى_مؤجل = {
                نطاق_النوع: النوع_المكتوب.النطاق,
                نطاق_المنشئ: المنشئ_المكتوب.النطاق,
                تصريح_المنشئ: تصريح_المنشئ
            };
            ليكن بلا_وحدات: متجه معرف_وحدة = [];
            ليكن المفقود: اسم_مفقود_مؤجل = {
                النطاق: نطاق_التعبير, الاقتراح: اختياري.لا_شيء(), الوحدات_المصرحة: بلا_وحدات,
                المنشئ_غير_المستدعى: اختياري.موجود(المنشئ)
            };
            سجل_اسما_مفقودا_مؤجلا(الروابط, المفقود);
            أرجع صواب;
        };
    }
    | _ -> { أرجع خطأ; };
}

// A binary expression and the left-nested chain under it (`((a + b) + c)`):
// the innermost left operand is bound first, then each right operand from
// the innermost node out, the order of the recursion, with a loop. Each node
// is borrowed from the one before it. A chain of thousands of operands
// overflowed the stack before.
عرف اربط_سلسلة_ثنائية(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    التعبير: &تعبير
): خطأ_ربط_أسماء {
    // Raw pointers, not references: Stage0 has no lifetime for a vector of
    // references (bootstrap/src/semantic/body_initializer_check_vector_init.c).
    // Each points into the tree التعبير borrows, which outlives this walk.
    ليكن العقد: متغير متجه *تعبير = [];
    غير_آمن { ألحق(العقد, التعبير مثل *تعبير); };
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        مستمر := خطأ;
        ليكن مؤشر_الأخير: *تعبير = العقد[(الطول(العقد) مثل طبيعي) - 1];
        ليكن الأخير: &تعبير;
        غير_آمن { الأخير := &(*مؤشر_الأخير); };
        طابق *الأخير مع
        | تعبير.ثنائي(_, _, صندوق_اليسار, _) -> {
            ليكن اليسار: &تعبير = &(*صندوق_اليسار);
            طابق *اليسار مع
            | تعبير.ثنائي(_, _, _, _) -> {
                غير_آمن { ألحق(العقد, اليسار مثل *تعبير); };
                مستمر := صواب;
            }
            | _ -> { };
        }
        | _ -> { };
    }
    ليكن ف: متغير طبيعي = الطول(العقد) مثل طبيعي;
    ليكن مؤشر_العقدة_2: *تعبير = العقد[ف - 1];
    ليكن العقدة_2: &تعبير;
    غير_آمن { العقدة_2 := &(*مؤشر_العقدة_2); };
    طابق *العقدة_2 مع
    | تعبير.ثنائي(_, _, صندوق_اليسار, _) -> {
        ليكن خطأ_اليسار: خطأ_ربط_أسماء = اربط_تعبيرا(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &(*صندوق_اليسار)
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_اليسار)) { أرجع خطأ_اليسار; };
    }
    | _ -> { };
    طالما (ف > 0) {
        ف := ف - 1;
        ليكن مؤشر_العقدة_3: *تعبير = العقد[ف];
        ليكن العقدة_3: &تعبير;
        غير_آمن { العقدة_3 := &(*مؤشر_العقدة_3); };
        طابق *العقدة_3 مع
        | تعبير.ثنائي(_, _, _, صندوق_اليمين) -> {
            ليكن خطأ_اليمين: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &(*صندوق_اليمين)
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_اليمين)) { أرجع خطأ_اليمين; };
        }
        | _ -> { };
    }
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف اربط_تعبيرا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    التعبير: &تعبير
): خطأ_ربط_أسماء {
    ليكن ت: تعبير = *التعبير;
    طابق ت مع
    | تعبير.حرفي(س, ح) -> { }
    | تعبير.اسم(س, الاسم) -> {
        ليكن الربط: خطأ_ربط_أسماء = اربط_ظهور_قيمة_مرئي(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الاسم
        );
        // An existing declaration always wins. Only an otherwise missing value
        // occurrence may be contextually typed as the raw null pointer literal.
        طابق الربط مع
        | خطأ_ربط_أسماء.اسم_مفقود(_) -> {
            ليكن الهوية: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
                &(*المصدر).المحتوى, الاسم.النطاق.البداية.البايت,
                الاسم.النطاق.النهاية.البايت
            );
            ليكن التهجئة: نص = «الفارغ»;
            إذا (تطابق_هوية_بايتات_ونص(&الهوية, &التهجئة)) {
                قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الاسم.النطاق);
                إذا (وسم_ظهور_مؤشر_فارغ_سياقي(الروابط, الاسم.النطاق)) {
                    أرجع خطأ_ربط_أسماء.لا_خطأ();
                };
            };
            // A prelude constructor written bare (`some(x)`, `none`, `ok(x)`,
            // `err(e)`; `موجود`, `لا_شيء`, `نجح`, `خطأ`) that no declaration in
            // scope shadows: its spelling is recorded without a Symbol, and
            // Type resolves it against the expected option or result Type.
            إذا (هل_تهجئة_منشئ_تمهيدي(&الهوية) || هل_تهجئة_قسمة_قابلة_للتعديل(&الهوية)) {
                قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الاسم.النطاق);
                أرجع خطأ_ربط_أسماء.لا_خطأ();
            };
            // Deferred: binding goes on so that every unknown name of the
            // module is reported, each with its own evidence.
            أجل_اسما_مفقودا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, الاسم.النطاق
            );
            أرجع خطأ_ربط_أسماء.لا_خطأ();
        }
        | _ -> { };
        أرجع الربط;
    }
    | تعبير.حقل(س, الأصل, الحقل) -> {
        ليكن قيمة_الأصل: تعبير = *الأصل;
        طابق قيمة_الأصل مع
        | تعبير.اسم(_, اسم_المرادف) -> {
            طابق حاول_اربط_عضو_استيراد_مسمى(
                سياق_الأسماء, الرسم, الوحدة, الروابط, المصدر, &اسم_المرادف, &الحقل, حيز_اسم.قيمة()
            ) مع
            | اختياري.موجود(نتيجة_الربط) -> { أرجع نتيجة_الربط; }
            | اختياري.لا_شيء -> { };
            // `Enum.Ctor` without its call (a call's callee is bound by
            // حاول_اربط_منشئ_مستدعى and never reaches here).
            إذا (أجل_منشئا_غير_مستدعى(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, س, &اسم_المرادف, &الحقل
            )) {
                أرجع خطأ_ربط_أسماء.لا_خطأ();
            };
        }
        | _ -> { };
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الأصل);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
        ليكن ربط_منشئ: متغير منطقي = خطأ;
        طابق قيمة_الأصل مع
        | تعبير.اسم(سأ, اسم_النوع) -> {
            طابق رمز_اسم_محلول_عند(الروابط, اسم_النوع.النطاق) مع
            | اختياري.موجود(رمز_النوع) -> {
                طابق حل_واربط_منشئ_مسمى(
                    سياق_الأسماء, الروابط, المصدر, الحقل.النطاق, رمز_النوع
                ) مع
                | اختياري.موجود(رمز_المنشئ) -> { ربط_منشئ := صواب; }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | تعبير.حرفي(سأ, حأ) -> { }
        | تعبير.حقل(سأ, أأ, حأ) -> { }
        | تعبير.فهرس(سأ, أأ, بأ) -> { }
        | تعبير.مقطع(_, _, _, _) -> { }
        | تعبير.فك_موضع(سأ, أأ) -> { }
        | تعبير.ثنائي(سأ, عأ, أأ, بأ) -> { }
        | تعبير.أحادي(سأ, عأ, أأ) -> { }
        | تعبير.استدعاء(سأ, أأ, بأ) -> { }
        | تعبير.تحويل(سأ, أأ, بأ) -> { }
        | تعبير.وقت_الترجمة(_, _) -> { }
        | تعبير.تسلسل_وقت_الترجمة(_, _) -> { }
        | تعبير.حرفي_متجه(_, _) -> { }
        | تعبير.حرفي_سجل(_, _) -> { }
        | تعبير.حرفي_صف(_, _) -> { }
        | تعبير.حجج_نوع(_, _, _) -> { }
        | تعبير.مطابقة(_, _) -> { }
        | تعبير.إغلاق(سأ, مأ, نأ, جأ) -> { };
        إذا (!ربط_منشئ) {
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الحقل.النطاق);
        };
    }
    | تعبير.فهرس(س, الأصل, الفهرس) -> {
        ليكن قيمة_الأصل: تعبير = *الأصل;
        ليكن قيمة_الفهرس: تعبير = *الفهرس;
        ليكن خطأ_أ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الأصل);
        إذا (هل_خطأ_ربط_أسماء(خطأ_أ)) {
            أرجع خطأ_أ;
        };
        ليكن خطأ_ب: خطأ_ربط_أسماء = اربط_تعبيرا(
            سياق_الأسماء,
            الرسم,
            الوحدة,
            النطاق_الحالي,
            الروابط,
            المصدر,
            &قيمة_الفهرس
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_ب)) {
            أرجع خطأ_ب;
        };
    }
    | تعبير.مقطع(_, الأصل, الأدنى, الأعلى) -> {
        ليكن قيمة_الأصل: تعبير = *الأصل;
        ليكن خطأ_الأصل: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الأصل);
        إذا (هل_خطأ_ربط_أسماء(خطأ_الأصل)) { أرجع خطأ_الأصل; };
        ليكن الحدود: متجه تعبير = حدود_مقطع(&الأدنى, &الأعلى);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحدود) مثل طبيعي)) {
            ليكن خطأ_الحد: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الحدود[ف]);
            إذا (هل_خطأ_ربط_أسماء(خطأ_الحد)) { أرجع خطأ_الحد; };
            ف := ف + 1;
        }
    }
    | تعبير.فك_موضع(س, الأصل) -> {
        ليكن قيمة_الأصل: تعبير = *الأصل;
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الأصل);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | تعبير.ثنائي(_, _, _, _) -> {
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_سلسلة_ثنائية(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, التعبير
        );
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | تعبير.أحادي(س, ع, أ) -> {
        ليكن قيمة_أ: تعبير = *أ;
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_أ);
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
    }
    | تعبير.استدعاء(س, الدالة, الحجج) -> {
        ليكن قيمة_الدالة: تعبير = *الدالة;
        إذا (!حاول_اربط_منشئ_مستدعى(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الدالة
        )) {
            طابق نطاق_منشئ_مستدعى_مجهول(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, المصدر, &قيمة_الدالة
            ) مع
            | اختياري.موجود(نطاق_المنشئ) -> { أرجع خطأ_ربط_أسماء.اسم_مفقود(نطاق_المنشئ); }
            | اختياري.لا_شيء -> { };
            ليكن خطأ_الدالة: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &قيمة_الدالة
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_الدالة)) {
                أرجع خطأ_الدالة;
            };
        };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &الحجج[ف]
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | تعبير.تحويل(س, الأصل, النوع) -> {
        ليكن قيمة_الأصل: تعبير = *الأصل;
        ليكن خطأ_الأصل: خطأ_ربط_أسماء = اربط_تعبيرا(
            سياق_الأسماء,
            الرسم,
            الوحدة,
            النطاق_الحالي,
            الروابط,
            المصدر,
            &قيمة_الأصل
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_الأصل)) {
            أرجع خطأ_الأصل;
        };
        ليكن خطأ_النوع: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &(*النوع));
        إذا (هل_خطأ_ربط_أسماء(خطأ_النوع)) {
            أرجع خطأ_النوع;
        };
    }
    | تعبير.وقت_الترجمة(_, المملوك) -> {
        ليكن الداخل: تعبير = *المملوك;
        أرجع اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الداخل);
    }
    | تعبير.تسلسل_وقت_الترجمة(_, التعابير) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &التعابير[ف]
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع الخطأ; };
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_متجه(_, التعابير) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &التعابير[ف]
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع الخطأ; };
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_صف(_, التعابير) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &التعابير[ف]
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع الخطأ; };
            ف := ف + 1;
        }
    }
    | تعبير.حجج_نوع(_, الداخل, الأنواع) -> {
        ليكن قيمة_الداخل: تعبير = *الداخل;
        ليكن خطأ_الداخل: خطأ_ربط_أسماء = اربط_تعبيرا(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &قيمة_الداخل
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_الداخل)) { أرجع خطأ_الداخل; };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأنواع) مثل طبيعي)) {
            ليكن خطأ_النوع: خطأ_ربط_أسماء = اربط_نوعا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الأنواع[ف]
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_النوع)) { أرجع خطأ_النوع; };
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الحقول[ف].الاسم.النطاق);
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الحقول[ف].القيمة
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع الخطأ; };
            ف := ف + 1;
        }
    }
    | تعبير.إغلاق(س, المعاملات, الناتج, الجسم_المملوك) -> {
        ليكن نطاق_الإغلاق: معرف_نطاق = نطاق_ابن_بمصدر(سياق_الأسماء, النطاق_الحالي, س);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
            ليكن مرجع_المعامل: &معامل_إغلاق = &المعاملات[ف];
            ليكن المعامل: معامل_إغلاق = *مرجع_المعامل;
            ليكن خطأ_النوع: خطأ_ربط_أسماء = اربط_نوعا(
                سياق_الأسماء, الرسم, الوحدة, نطاق_الإغلاق, الروابط, المصدر, &المعامل.النوع
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_النوع)) { أرجع خطأ_النوع; };
            ليكن خطأ_الاسم: خطأ_ربط_أسماء = سجل_محليا(
                سياق_الأسماء, الروابط, المصدر, نطاق_الإغلاق,
                &المعامل.الاسم, المعامل.النطاق, نوع_تصريح.معامل()
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_الاسم)) { أرجع خطأ_الاسم; };
            ف := ف + 1;
        }
        ليكن خطأ_الناتج: خطأ_ربط_أسماء = اربط_نوعا(
            سياق_الأسماء, الرسم, الوحدة, نطاق_الإغلاق, الروابط, المصدر, &(*الناتج)
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_الناتج)) { أرجع خطأ_الناتج; };
        ليكن الجسم: تعبير = *الجسم_المملوك;
        ليكن خطأ_الجسم: خطأ_ربط_أسماء = اربط_تعبيرا(
            سياق_الأسماء, الرسم, الوحدة, نطاق_الإغلاق, الروابط, المصدر, &الجسم
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_الجسم)) { أرجع خطأ_الجسم; };
    }
    // A match expression binds as the match statement it extends: each arm
    // a scope of its own, holding the pattern's names, the body and the value.
    | تعبير.مطابقة(س, المطابقة) -> {
        ليكن العبارة: عبارة = عبارة_مطابقة_تعبيرية(س, &(*المطابقة));
        ليكن الصندوق: صندوق عبارة = صندوق العبارة;
        ليكن العبارات: متجه صندوق عبارة = [الصندوق];
        ليكن الكتلة: كتلة_عبارات = { النطاق: س, العبارات: العبارات };
        ليكن خطأ_المطابقة: خطأ_ربط_أسماء = اربط_كتلة(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &الكتلة, خطأ
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_المطابقة)) { أرجع خطأ_المطابقة; };
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف سجل_محليا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النطاق_الحالي: معرف_نطاق,
    الاسم: &اسم,
    نطاق_التصريح: نطاق,
    النوع: نوع_تصريح
): خطأ_ربط_أسماء {
    ليكن ا: اسم = *الاسم;
    طابق أضف_رمزا_مصدريا(سياق_الأسماء, النطاق_الحالي, المصدر, ا.النطاق, نطاق_التصريح, النوع, خطأ) مع
    | نتيجة_إضافة.مكرر(الموجود, النطاق) -> {
        أرجع خطأ_ربط_أسماء.تصريح_مكرر(الموجود, النطاق);
    }
    | نتيجة_إضافة.أضيف(الرمز) -> {
        طابق اسم_رمز_عند(سياق_الأسماء, الرمز) مع
        | اختياري.موجود(الهوية) -> {
            إذا (!أضف_ظهور_اسم_محلول(الروابط, ا.النطاق, الهوية, الرمز)) {
                أرجع خطأ_ربط_أسماء.تعارض_ربط(ا.النطاق);
            };
        }
        | اختياري.لا_شيء -> {
            أرجع خطأ_ربط_أسماء.تعارض_ربط(ا.النطاق);
        };
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

// Annotation names and arguments use ordinary Name resolution, including
// imported module members. No shadow registry or textual symbol lookup.
عرف اربط_سمات_تصريح(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    السمات: &متجه سمة_تصريح
): خطأ_ربط_أسماء {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السمات) مثل طبيعي)) {
        ليكن السمة: &سمة_تصريح = &(*السمات)[ف];
        إذا ((الطول((*السمة).المسار) مثل طبيعي) == 0) {
            أرجع خطأ_ربط_أسماء.اسم_مفقود((*السمة).النطاق);
        };
        ليكن الأول: اسم = (*السمة).المسار[0];
        ليكن التعبير: متغير تعبير = تعبير.اسم(الأول.النطاق, الأول);
        ليكن م: متغير طبيعي = 1;
        طالما (م < (الطول((*السمة).المسار) مثل طبيعي)) {
            ليكن العضو: اسم = (*السمة).المسار[م];
            ليكن النطاق: نطاق = دمج_نطاق(نطاق_تعبير(&التعبير), العضو.النطاق);
            ليكن الأصل: صندوق تعبير = صندوق التعبير;
            التعبير := تعبير.حقل(النطاق, الأصل, العضو);
            م := م + 1;
        }
        ليكن خطأ_السمة: خطأ_ربط_أسماء = اربط_تعبيرا(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي,
            الروابط, المصدر, &التعبير
        );
        إذا (هل_خطأ_ربط_أسماء(خطأ_السمة)) { أرجع خطأ_السمة; };
        م := 0;
        طالما (م < (الطول((*السمة).الحجج) مثل طبيعي)) {
            ليكن خطأ_الحجة: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي,
                الروابط, المصدر, &(*السمة).الحجج[م]
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_الحجة)) { أرجع خطأ_الحجة; };
            م := م + 1;
        }
        ف := ف + 1;
    }
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

// A name bound by a pattern. In an alternative after the first of an
// or-pattern (لاحق) the name is the one the first alternative declared in the
// arm's scope: the occurrence resolves to that Symbol. A name the first
// alternative does not bind is declared anew; the Pattern check then reports
// that the alternatives bind different names (type_validation.sn).
عرف اربط_اسم_نمط(
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النطاق_الحالي: معرف_نطاق,
    الاسم: &اسم,
    س: نطاق,
    لاحق: منطقي
): خطأ_ربط_أسماء {
    إذا (لاحق) {
        ليكن الهوية: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, (*الاسم).النطاق);
        طابق ابحث_محليا_بهوية(سياق_الأسماء, النطاق_الحالي, الهوية) مع
        | اختياري.موجود(الرمز) -> {
            إذا (!أضف_ظهور_اسم_محلول(الروابط, (*الاسم).النطاق, الهوية, الرمز)) {
                أرجع خطأ_ربط_أسماء.تعارض_ربط((*الاسم).النطاق);
            };
            أرجع خطأ_ربط_أسماء.لا_خطأ();
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع سجل_محليا(سياق_الأسماء, الروابط, المصدر, النطاق_الحالي, الاسم, س, نوع_تصريح.ربط_محلي());
}

عرف اربط_نمطا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النمط: &نمط
): خطأ_ربط_أسماء {
    أرجع اربط_نمطا_في(
        سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, النمط, خطأ
    );
}

عرف اربط_نمطا_في(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النمط: &نمط,
    لاحق: منطقي
): خطأ_ربط_أسماء {
    ليكن ن: نمط = *النمط;
    طابق ن مع
    | نمط.بدل(س) -> { }
    | نمط.حرفي(_, _) -> { }
    | نمط.مدى(_, _, _) -> { }
    | نمط.بدائل(_, البدائل) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البدائل) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نمطا_في(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر,
                &البدائل[ف], لاحق || ف > 0
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | نمط.ربط(س, الاسم) -> {
        أرجع اربط_اسم_نمط(سياق_الأسماء, الروابط, المصدر, النطاق_الحالي, &الاسم, س, لاحق);
    }
    | نمط.تسلسل(س, السابقة, البقية, اللاحقة) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(السابقة) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نمطا_في(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &السابقة[ف], لاحق
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع الخطأ; };
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول(البقية) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نمطا_في(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &البقية[ف], لاحق
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع الخطأ; };
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول(اللاحقة) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نمطا_في(
                سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &اللاحقة[ف], لاحق
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع الخطأ; };
            ف := ف + 1;
        }
    }
    | نمط.مستعار(س, الداخل, الاسم) -> {
        ليكن الخطأ: خطأ_ربط_أسماء = اربط_نمطا_في(
            سياق_الأسماء, الرسم, الوحدة, النطاق_الحالي, الروابط, المصدر, &(*الداخل), لاحق
        );
        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
            أرجع الخطأ;
        };
        أرجع اربط_اسم_نمط(
            سياق_الأسماء, الروابط, المصدر, النطاق_الحالي, &الاسم, الاسم.النطاق, لاحق
        );
    }
    | نمط.منشئ(س, النوع, المنشئ, الحمولات) -> {
        // A prelude constructor written bare (`some(x)`, `none`): its implied
        // Type name stands for `option` or `result`.
        إذا (النوع.الصنف == صنف_اسم_تركيبي.منشئ_تمهيدي()) {
            ليكن هوية_المنشئ: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
                &(*المصدر).المحتوى, المنشئ.النطاق.البداية.البايت, المنشئ.النطاق.النهاية.البايت
            );
            ليكن اسم_النوع: متغير نص = «option»;
            إذا (هل_تهجئة_منشئ_تمهيدي_للنتيجة(&هوية_المنشئ)) { اسم_النوع := «result»; };
            ليكن هوية_النوع: معرف_اسم = قنن_اسما_نصيا(سياق_الأسماء, &اسم_النوع);
            ليكن أضيف: منطقي = أضف_هوية_اسم_محلولة(الروابط, النوع.النطاق, هوية_النوع);
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, المنشئ.النطاق);
        } وإلا إذا (هل_اسم_نوع_موسوم_مدمج(المصدر, &النوع)) {
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, النوع.النطاق);
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, المنشئ.النطاق);
            سجل_منشئ_مدمج_مهجور(الروابط, المصدر, النوع.النطاق, المنشئ.النطاق);
        }
        وإلا {
            ليكن خطأ_النوع: خطأ_ربط_أسماء = اربط_ظهور_نوع_مرئي(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &النوع
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_النوع)) {
                أرجع خطأ_النوع;
            };
            طابق رمز_اسم_محلول_عند(الروابط, النوع.النطاق) مع
            | اختياري.موجود(رمز_النوع) -> {
                طابق حل_واربط_منشئ_مسمى(سياق_الأسماء, الروابط, المصدر, المنشئ.النطاق, رمز_النوع) مع
                | اختياري.موجود(رمز_المنشئ) -> { }
                | اختياري.لا_شيء -> {
                    أرجع خطأ_ربط_أسماء.اسم_مفقود(المنشئ.النطاق);
                };
            }
            | اختياري.لا_شيء -> {
                أرجع خطأ_ربط_أسماء.اسم_مفقود(النوع.النطاق);
            };
        };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحمولات) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نمطا_في(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &الحمولات[ف],
                لاحق
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | نمط.صف(س, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نمطا_في(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &العناصر[ف],
                لاحق
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    }
    | نمط.سجل(س, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            // `{ width }`: the field's name is the binding's occurrence, which
            // the binding resolves (with the same canonical name).
            ليكن مختصر: متغير منطقي = خطأ;
            طابق الحقول[ف].النمط مع
            | نمط.ربط(نطاق_الربط, _) -> {
                مختصر := نطاقان_متساويان(نطاق_الربط, الحقول[ف].الاسم.النطاق);
            }
            | _ -> { };
            إذا (!مختصر) {
                قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الحقول[ف].الاسم.النطاق);
            };
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نمطا_في(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                النطاق_الحالي,
                الروابط,
                المصدر,
                &الحقول[ف].النمط,
                لاحق
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ف := ف + 1;
        }
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف اربط_كتلة(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    النطاق_الحالي: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الكتلة: &كتلة_عبارات,
    أنشئ_نطاقا: منطقي
): خطأ_ربط_أسماء {
    ليكن ك: كتلة_عبارات = *الكتلة;
    ليكن نطاق_الكتلة: متغير معرف_نطاق = النطاق_الحالي;
    إذا (أنشئ_نطاقا) {
        نطاق_الكتلة := نطاق_ابن_بمصدر(سياق_الأسماء, النطاق_الحالي, ك.النطاق);
    };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ك.العبارات) مثل طبيعي)) {
        ليكن ع: عبارة = *ك.العبارات[ف];
        طابق ع مع
        | عبارة.تصريح_متغير(س, الاسم, النوع) -> {
            ليكن خطأ_النوع: خطأ_ربط_أسماء = اربط_نوعا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &النوع);
            إذا (هل_خطأ_ربط_أسماء(خطأ_النوع)) {
                أرجع خطأ_النوع;
            };
            ليكن خطأ_الاسم: خطأ_ربط_أسماء = سجل_محليا(
                سياق_الأسماء,
                الروابط,
                المصدر,
                نطاق_الكتلة,
                &الاسم,
                س,
                نوع_تصريح.ربط_محلي()
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_الاسم)) {
                أرجع خطأ_الاسم;
            };
        }
        | عبارة.تهيئة_سجل(س, الهدف, الحقول) -> {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ليكن ه: متغير طبيعي = 0;
            طالما (ه < (الطول(الحقول) مثل طبيعي)) {
                قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, الحقول[ه].الاسم.النطاق);
                ليكن خطأ_القيمة: خطأ_ربط_أسماء = اربط_تعبيرا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &الحقول[ه].القيمة
                );
                إذا (هل_خطأ_ربط_أسماء(خطأ_القيمة)) {
                    أرجع خطأ_القيمة;
                };
                ه := ه + 1;
            }
        }
        | عبارة.تهيئة_صف(س, الهدف, العناصر) -> {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ليكن ه: متغير طبيعي = 0;
            طالما (ه < (الطول(العناصر) مثل طبيعي)) {
                ليكن خ: خطأ_ربط_أسماء = اربط_تعبيرا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &العناصر[ه]
                );
                إذا (هل_خطأ_ربط_أسماء(خ)) {
                    أرجع خ;
                };
                ه := ه + 1;
            }
        }
        | عبارة.تهيئة_متجه(س, الهدف, العناصر) -> {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
            ليكن ه: متغير طبيعي = 0;
            طالما (ه < (الطول(العناصر) مثل طبيعي)) {
                ليكن خ: خطأ_ربط_أسماء = اربط_تعبيرا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &العناصر[ه]
                );
                إذا (هل_خطأ_ربط_أسماء(خ)) {
                    أرجع خ;
                };
                ه := ه + 1;
            }
        }
        | عبارة.تهيئة_نص(س, الهدف, بايتات) -> {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
        }
        | عبارة.تهيئة_صندوق(س, الهدف, القيمة) -> {
            ليكن خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            إذا (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            ليكن خ2: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &القيمة);
            إذا (هل_خطأ_ربط_أسماء(خ2)) {
                أرجع خ2;
            };
        }
        | عبارة.نسخ(س, الهدف, القيمة) -> {
            ليكن خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الهدف);
            إذا (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            ليكن خ2: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &القيمة);
            إذا (هل_خطأ_ربط_أسماء(خ2)) {
                أرجع خ2;
            };
        }
        | عبارة.استدعاء(س, التعبير) -> {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &التعبير);
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
        }
        | عبارة.لكل(س, البداية, الشرط, الخطوة, الجسم) -> {
            ليكن نطاق_الحلقة: معرف_نطاق = نطاق_ابن_بمصدر(سياق_الأسماء, نطاق_الكتلة, س);
            ليكن كتلة_البداية: كتلة_عبارات = { النطاق: س, العبارات: انسخ_مملوكا_متجه_صندوق_عبارة(&البداية) };
            ليكن خ0: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الحلقة, الروابط, المصدر, &كتلة_البداية, خطأ);
            إذا (هل_خطأ_ربط_أسماء(خ0)) { أرجع خ0; };
            ليكن خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الحلقة, الروابط, المصدر, &الشرط);
            إذا (هل_خطأ_ربط_أسماء(خ1)) { أرجع خ1; };
            ليكن نسخة_الخطوة: صندوق عبارة = انسخ_مملوكا_صندوق_عبارة(&الخطوة);
            ليكن قائمة_الخطوة: متجه صندوق عبارة = [نسخة_الخطوة];
            ليكن كتلة_الخطوة: كتلة_عبارات = { النطاق: س, العبارات: قائمة_الخطوة };
            ليكن خ2: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الحلقة, الروابط, المصدر, &كتلة_الخطوة, خطأ);
            إذا (هل_خطأ_ربط_أسماء(خ2)) { أرجع خ2; };
            ليكن خ3: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الحلقة, الروابط, المصدر, &الجسم, صواب);
            إذا (هل_خطأ_ربط_أسماء(خ3)) { أرجع خ3; };
        }
        | عبارة.اخرج_من_حلقة(_) -> { }
        | عبارة.تابع_حلقة(_) -> { }
        | عبارة.طالما(س, الشرط, الجسم) -> {
            ليكن خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الشرط);
            إذا (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            ليكن خ2: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الجسم, صواب);
            إذا (هل_خطأ_ربط_أسماء(خ2)) {
                أرجع خ2;
            };
        }
        | عبارة.إذا(س, الشرط, نعم, لا) -> {
            ليكن خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الشرط);
            إذا (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            ليكن خ2: خطأ_ربط_أسماء = اربط_كتلة(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &نعم, صواب);
            إذا (هل_خطأ_ربط_أسماء(خ2)) {
                أرجع خ2;
            };
            طابق لا مع | اختياري.موجود(بديل) -> {
                ليكن خ3: خطأ_ربط_أسماء = اربط_كتلة(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &بديل,
                    صواب
                );
                إذا (هل_خطأ_ربط_أسماء(خ3)) {
                    أرجع خ3;
                };
            } | اختياري.لا_شيء -> {
            };
        }
        | عبارة.طابق(س, القيمة, الأذرع) -> {
            ليكن خ1: خطأ_ربط_أسماء = اربط_تعبيرا(سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &القيمة);
            إذا (هل_خطأ_ربط_أسماء(خ1)) {
                أرجع خ1;
            };
            ليكن ه: متغير طبيعي = 0;
            طالما (ه < (الطول(الأذرع) مثل طبيعي)) {
                // The Type a tuple `let` wrote names Types where it stands.
                طابق الأذرع[ه].نوع_ليكن مع
                | اختياري.موجود(نوع_الربط) -> {
                    ليكن خ_النوع: خطأ_ربط_أسماء = اربط_نوعا(
                        سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &نوع_الربط
                    );
                    إذا (هل_خطأ_ربط_أسماء(خ_النوع)) {
                        أرجع خ_النوع;
                    };
                }
                | اختياري.لا_شيء -> { };
                ليكن نطاق_الذراع: معرف_نطاق = نطاق_ابن_بمصدر(سياق_الأسماء, نطاق_الكتلة, الأذرع[ه].الجسم.النطاق);
                ليكن خ2: خطأ_ربط_أسماء = اربط_نمطا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الذراع,
                    الروابط,
                    المصدر,
                    &الأذرع[ه].النمط
                );
                إذا (هل_خطأ_ربط_أسماء(خ2)) {
                    أرجع خ2;
                };
                // The guard sees the pattern's bindings.
                طابق الأذرع[ه].الحارس مع
                | اختياري.موجود(الحارس) -> {
                    ليكن خ_الحارس: خطأ_ربط_أسماء = اربط_تعبيرا(
                        سياق_الأسماء, الرسم, الوحدة, نطاق_الذراع, الروابط, المصدر, &الحارس
                    );
                    إذا (هل_خطأ_ربط_أسماء(خ_الحارس)) {
                        أرجع خ_الحارس;
                    };
                }
                | اختياري.لا_شيء -> { };
                ليكن خ3: خطأ_ربط_أسماء = اربط_كتلة(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الذراع,
                    الروابط,
                    المصدر,
                    &الأذرع[ه].الجسم,
                    خطأ
                );
                إذا (هل_خطأ_ربط_أسماء(خ3)) {
                    أرجع خ3;
                };
                ه := ه + 1;
            }
        }
        | عبارة.أرجع(س, القيمة) -> {
            طابق القيمة مع | اختياري.موجود(تعبير_الرجوع) -> {
                ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الكتلة,
                    الروابط,
                    المصدر,
                    &تعبير_الرجوع
                );
                إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                    أرجع الخطأ;
                };
            } | اختياري.لا_شيء -> {
            };
        }
        | عبارة.تجميع(س, ب) -> { }
        | عبارة.وقت_الترجمة(_, الجسم) -> {
            // A comptime statement executes in an independent MSIR frame.
            // Its lexical parent is the canonical unit scope, not the runtime
            // function scope: capturing a runtime local would otherwise make
            // lowering fail with a misleading compiler-internal error.
            ليكن نطاق_الجذر: متغير معرف_نطاق = نطاق_الكتلة;
            ليكن استمر: متغير منطقي = صواب;
            طالما (استمر) {
                طابق (*سياق_الأسماء).النطاقات[نطاق_الجذر.القيمة].الأب مع
                | اختياري.موجود(الأب) -> { نطاق_الجذر := الأب; }
                | اختياري.لا_شيء -> { استمر := خطأ; };
            }
            ليكن نطاق_المسبق: معرف_نطاق = نطاق_ابن_بمصدر(
                سياق_الأسماء, نطاق_الجذر, الجسم.النطاق
            );
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_كتلة(
                سياق_الأسماء, الرسم, الوحدة, نطاق_المسبق,
                الروابط, المصدر, &الجسم, خطأ
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع الخطأ; };
        }
        | عبارة.إسناد_وقت_الترجمة(_, الوجهة, الجسم, الناتج) -> {
            // As a comptime statement: an independent frame whose lexical
            // parent is the unit scope. The result sees the block's locals;
            // the destination is an ordinary place of the runtime scope.
            ليكن نطاق_الجذر: متغير معرف_نطاق = نطاق_الكتلة;
            ليكن استمر: متغير منطقي = صواب;
            طالما (استمر) {
                طابق (*سياق_الأسماء).النطاقات[نطاق_الجذر.القيمة].الأب مع
                | اختياري.موجود(الأب) -> { نطاق_الجذر := الأب; }
                | اختياري.لا_شيء -> { استمر := خطأ; };
            }
            ليكن نطاق_المسبق: معرف_نطاق = نطاق_ابن_بمصدر(
                سياق_الأسماء, نطاق_الجذر, الجسم.النطاق
            );
            ليكن خطأ_الجسم: خطأ_ربط_أسماء = اربط_كتلة(
                سياق_الأسماء, الرسم, الوحدة, نطاق_المسبق,
                الروابط, المصدر, &الجسم, خطأ
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_الجسم)) { أرجع خطأ_الجسم; };
            ليكن خطأ_الناتج: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء, الرسم, الوحدة, نطاق_المسبق, الروابط, المصدر, &الناتج
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_الناتج)) { أرجع خطأ_الناتج; };
            ليكن خطأ_الوجهة: خطأ_ربط_أسماء = اربط_تعبيرا(
                سياق_الأسماء, الرسم, الوحدة, نطاق_الكتلة, الروابط, المصدر, &الوجهة
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_الوجهة)) { أرجع خطأ_الوجهة; };
        }
        | عبارة.غير_آمن(س, الجسم) -> {
            ليكن الخطأ: خطأ_ربط_أسماء = اربط_كتلة(
                سياق_الأسماء,
                الرسم,
                الوحدة,
                نطاق_الكتلة,
                الروابط,
                المصدر,
                &الجسم,
                صواب
            );
            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                أرجع الخطأ;
            };
        };
        ف := ف + 1;
    }
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف اربط_تصريح_علوي(
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الجذر: معرف_نطاق,
    الاسم: &اسم
): خطأ_ربط_أسماء {
    ليكن ا: اسم = *الاسم;
    ليكن الهوية: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, ا.النطاق);
    طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, الهوية) مع
    | اختياري.موجود(الرمز) -> {
        إذا (!أضف_ظهور_اسم_محلول(الروابط, ا.النطاق, الهوية, الرمز)) {
            أرجع خطأ_ربط_أسماء.تعارض_ربط(ا.النطاق);
        };
    }
    | اختياري.لا_شيء -> {
        أرجع خطأ_ربط_أسماء.اسم_مفقود(ا.النطاق);
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عرف اربط_مرادف_اسم_علويا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الجذر: معرف_نطاق,
    التصريح: &تصريح_مرادف_اسم
): خطأ_ربط_أسماء {
    ليكن القيمة: تصريح_مرادف_اسم = *التصريح;
    طابق القيمة.أب_الوجهة مع
    | اختياري.لا_شيء -> {
        طابق القيمة.أب_الهدف مع
        | اختياري.موجود(أب_الهدف) -> {
            إذا (!القيمة.علني) {
                أرجع خطأ_ربط_أسماء.مرادف_أب_غير_مطابق(أب_الهدف.النطاق);
            };
            // A re-export: اربط_مرادفات_إعادة_التصدير bound NAME in the root to
            // the imported Symbol; IMPORT names the `as` import, and the target
            // is that same Symbol.
            قنن_واربط_ظهور_اسم(سياق_الأسماء, الروابط, المصدر, أب_الهدف.النطاق);
            ليكن خطأ_المعاد: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                سياق_الأسماء, الروابط, المصدر, الجذر, &القيمة.الاسم
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_المعاد)) {
                أرجع خطأ_المعاد;
            };
            طابق رمز_اسم_محلول_عند(الروابط, القيمة.الاسم.النطاق) مع
            | اختياري.لا_شيء -> {
                أرجع خطأ_ربط_أسماء.اسم_مفقود(القيمة.الاسم.النطاق);
            }
            | اختياري.موجود(رمز_المعاد) -> {
                ليكن هوية_المعاد: معرف_اسم = قنن_اسما_مصدريا(
                    سياق_الأسماء, المصدر, القيمة.الهدف.النطاق
                );
                إذا (!أضف_ظهور_اسم_محلول(
                    الروابط, القيمة.الهدف.النطاق, هوية_المعاد, رمز_المعاد
                )) {
                    أرجع خطأ_ربط_أسماء.تعارض_ربط(القيمة.الهدف.النطاق);
                };
            };
        }
        | اختياري.لا_شيء -> {
            ليكن خطأ_الهدف: متغير خطأ_ربط_أسماء = خطأ_ربط_أسماء.لا_خطأ();
            ليكن هوية_الهدف: معرف_اسم = قنن_اسما_مصدريا(
                سياق_الأسماء, المصدر, القيمة.الهدف.النطاق
            );
            طابق حل_هدف_مرادف_غير_مؤهل(
                سياق_الأسماء, الجذر, هوية_الهدف, القيمة.علني
            ) مع
            | اختياري.موجود(رمز_الهدف) -> {
                إذا (!أضف_ظهور_اسم_محلول(
                    الروابط,
                    القيمة.الهدف.النطاق,
                    هوية_الهدف,
                    رمز_الهدف
                )) {
                    أرجع خطأ_ربط_أسماء.تعارض_ربط(القيمة.الهدف.النطاق);
                };
            }
            | اختياري.لا_شيء -> {
                خطأ_الهدف := خطأ_ربط_أسماء.اسم_مفقود(القيمة.الهدف.النطاق);
            };
            إذا (هل_خطأ_ربط_أسماء(خطأ_الهدف)) {
                أرجع خطأ_الهدف;
            };
            ليكن خطأ_المرادف: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                سياق_الأسماء, الروابط, المصدر, الجذر, &القيمة.الاسم
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_المرادف)) {
                أرجع خطأ_المرادف;
            };
            طابق رمز_اسم_محلول_عند(الروابط, القيمة.الهدف.النطاق) مع
            | اختياري.لا_شيء -> {
                أرجع خطأ_ربط_أسماء.اسم_مفقود(القيمة.الهدف.النطاق);
            }
            | اختياري.موجود(رمز_الهدف) -> {
                طابق رمز_اسم_محلول_عند(الروابط, القيمة.الاسم.النطاق) مع
                | اختياري.لا_شيء -> {
                    أرجع خطأ_ربط_أسماء.اسم_مفقود(القيمة.الاسم.النطاق);
                }
                | اختياري.موجود(رمز_المرادف) -> {
                    إذا (!معرفا_رمز_متساويان(رمز_الهدف, رمز_المرادف)) {
                        أرجع خطأ_ربط_أسماء.تعارض_ربط(القيمة.الاسم.النطاق);
                    };
                };
            };
        };
    }
    | اختياري.موجود(أب_الوجهة) -> {
        طابق القيمة.أب_الهدف مع
        | اختياري.لا_شيء -> {
            أرجع خطأ_ربط_أسماء.مرادف_أب_غير_مطابق(القيمة.الهدف.النطاق);
        }
        | اختياري.موجود(أب_الهدف) -> {
            ليكن خطأ_أب_الوجهة: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                سياق_الأسماء, الروابط, المصدر, الجذر, &أب_الوجهة
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_أب_الوجهة)) {
                أرجع خطأ_أب_الوجهة;
            };
            ليكن خطأ_أب_الهدف: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                سياق_الأسماء, الروابط, المصدر, الجذر, &أب_الهدف
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_أب_الهدف)) {
                أرجع خطأ_أب_الهدف;
            };
            طابق رمز_اسم_محلول_عند(الروابط, أب_الوجهة.النطاق) مع
            | اختياري.لا_شيء -> {
                أرجع خطأ_ربط_أسماء.اسم_مفقود(أب_الوجهة.النطاق);
            }
            | اختياري.موجود(رمز_أب_الوجهة) -> {
                طابق رمز_اسم_محلول_عند(الروابط, أب_الهدف.النطاق) مع
                | اختياري.لا_شيء -> {
                    أرجع خطأ_ربط_أسماء.اسم_مفقود(أب_الهدف.النطاق);
                }
                | اختياري.موجود(رمز_أب_الهدف) -> {
                    إذا (!معرفا_رمز_متساويان(رمز_أب_الوجهة, رمز_أب_الهدف)) {
                        أرجع خطأ_ربط_أسماء.مرادف_أب_غير_مطابق(أب_الهدف.النطاق);
                    };
                    طابق حل_واربط_منشئ_مسمى(
                        سياق_الأسماء,
                        الروابط,
                        المصدر,
                        القيمة.الهدف.النطاق,
                        رمز_أب_الهدف
                    ) مع
                    | اختياري.لا_شيء -> {
                        أرجع خطأ_ربط_أسماء.اسم_مفقود(القيمة.الهدف.النطاق);
                    }
                    | اختياري.موجود(رمز_الهدف) -> {
                        طابق حل_واربط_منشئ_مسمى(
                            سياق_الأسماء,
                            الروابط,
                            المصدر,
                            القيمة.الاسم.النطاق,
                            رمز_أب_الوجهة
                        ) مع
                        | اختياري.لا_شيء -> {
                            أرجع خطأ_ربط_أسماء.اسم_مفقود(القيمة.الاسم.النطاق);
                        }
                        | اختياري.موجود(رمز_المرادف) -> {
                            إذا (!معرفا_رمز_متساويان(رمز_الهدف, رمز_المرادف)) {
                                أرجع خطأ_ربط_أسماء.تعارض_ربط(القيمة.الاسم.النطاق);
                            };
                        };
                    };
                };
            };
        };
    };
    أرجع خطأ_ربط_أسماء.لا_خطأ();
}

عام عرف اجمع_تصريحات_أسماء_وحدة(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الوحدة_النحوية: &وحدة_مصدر,
    المصدر: &مصدر
): نتيجة_جمع_تصريحات_أسماء_وحدة {
    طابق وحدة_في_الرسم(الرسم, الوحدة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.وحدة_مجهولة();
    }
    | اختياري.موجود(الدلالية) -> {
        إذا (الدلالية.معرف_المصدر != (*الوحدة_النحوية).معرف_المصدر) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.مصدر_غير_مطابق();
        };
        ليكن التصريحات: جدول_تصريحات = اجمع_تصريحات_الوحدة(
            سياق_الأسماء, &الدلالية, الوحدة_النحوية, المصدر
        );
        إذا ((الطول(التصريحات.المكررات) مثل طبيعي) != 0) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.تصريح_مكرر(
                التصريحات.المكررات[0].الموجود,
                التصريحات.المكررات[0].النطاق
            );
        };
        إذا ((الطول(التصريحات.الأهداف_المفقودة) مثل طبيعي) != 0) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_مفقود(
                التصريحات.الأهداف_المفقودة[0]
            );
        };
        إذا ((الطول(التصريحات.الأهداف_الخاصة) مثل طبيعي) != 0) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_خاص(
                التصريحات.الأهداف_الخاصة[0]
            );
        };
        إذا ((الطول(التصريحات.مرادفات_أب_غير_مطابق) مثل طبيعي) != 0) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.مرادف_أب_غير_مطابق(
                التصريحات.مرادفات_أب_غير_مطابق[0]
            );
        };
        إذا ((الطول(التصريحات.تعارضات_الربط) مثل طبيعي) != 0) {
            أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.تعارض_ربط(
                التصريحات.تعارضات_الربط[0]
            );
        };
        أرجع نتيجة_جمع_تصريحات_أسماء_وحدة.مكتملة(التصريحات);
    };
}

// A public alias whose target is a member of an `as` import,
// `عام مرادف NAME = IMPORT.NAME;`, re-exports that member: NAME is bound in the module's root to the
// imported module's own Symbol, so importers of this module and this module's
// own code see one function, type or value. It runs once every module's
// declarations exist (the target is another module's) and before any
// importer resolves a use, so the target is a name the imported module
// declares or aliases itself, never one it re-exports in turn.
عام نوع نتيجة_ربط_إعادة_تصدير =
    | مكتملة
    | تصريح_مكرر بنوع (معرف_رمز, نطاق)
    | اسم_مفقود بنوع نطاق
    | اسم_خاص بنوع نطاق
    | اسم_غامض بنوع نطاق
;

عرف اربط_مرادف_إعادة_تصدير(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الجذر: معرف_نطاق,
    المصدر: &مصدر,
    التصريح: &تصريح_مرادف_اسم,
    أب_الهدف: &اسم
): نتيجة_ربط_إعادة_تصدير {
    ليكن القيمة: تصريح_مرادف_اسم = *التصريح;
    ليكن الأب: اسم = *أب_الهدف;
    ليكن هوية_المرادف: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى, الأب.النطاق.البداية.البايت, الأب.النطاق.النهاية.البايت
    );
    ليكن هوية_العضو: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى, القيمة.الهدف.النطاق.البداية.البايت, القيمة.الهدف.النطاق.النهاية.البايت
    );
    طابق حل_عضو_استيراد_مسمى_ببايتات_في_حيز(
        سياق_الأسماء, الرسم, الوحدة, &هوية_المرادف, &هوية_العضو, حيز_اسم.الكل()
    ) مع
    | نتيجة_حل_عضو_استيراد_مسمى.موجود(الرمز) -> {
        طابق أضف_اسما_بديلا_مصدريا(
            سياق_الأسماء, الجذر, المصدر, القيمة.الاسم.النطاق, الرمز
        ) مع
        | نتيجة_إضافة.أضيف(_) -> { أرجع نتيجة_ربط_إعادة_تصدير.مكتملة(); }
        | نتيجة_إضافة.مكرر(الموجود, نطاق_المكرر) -> {
            // The same re-export declared twice binds one Symbol.
            إذا (معرفا_رمز_متساويان(الموجود, الرمز)) {
                أرجع نتيجة_ربط_إعادة_تصدير.مكتملة();
            };
            أرجع نتيجة_ربط_إعادة_تصدير.تصريح_مكرر(الموجود, نطاق_المكرر);
        };
    }
    | نتيجة_حل_عضو_استيراد_مسمى.خاص -> {
        أرجع نتيجة_ربط_إعادة_تصدير.اسم_خاص(القيمة.الهدف.النطاق);
    }
    | نتيجة_حل_عضو_استيراد_مسمى.غامض -> {
        أرجع نتيجة_ربط_إعادة_تصدير.اسم_غامض(القيمة.الهدف.النطاق);
    }
    | نتيجة_حل_عضو_استيراد_مسمى.مفقود -> {
        أرجع نتيجة_ربط_إعادة_تصدير.اسم_مفقود(القيمة.الهدف.النطاق);
    }
    // IMPORT is not the name of an `as` import of this module.
    | نتيجة_حل_عضو_استيراد_مسمى.ليس_مرادفا -> {
        أرجع نتيجة_ربط_إعادة_تصدير.اسم_مفقود(الأب.النطاق);
    };
}

عام عرف اربط_مرادفات_إعادة_التصدير(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الوحدة_النحوية: &وحدة_مصدر,
    المصدر: &مصدر
): نتيجة_ربط_إعادة_تصدير {
    طابق وحدة_في_الرسم(الرسم, الوحدة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_ربط_إعادة_تصدير.مكتملة(); }
    | اختياري.موجود(الدلالية) -> {
        ليكن م: متغير طبيعي = 0;
        طالما (م < (الطول((*الوحدة_النحوية).مرادفات_الأسماء) مثل طبيعي)) {
            ليكن التصريح: تصريح_مرادف_اسم = (*الوحدة_النحوية).مرادفات_الأسماء[م];
            إذا (التصريح.علني && اختياري_اسم_غائب(&التصريح.أب_الوجهة)) {
                طابق التصريح.أب_الهدف مع
                | اختياري.موجود(أب_الهدف) -> {
                    ليكن النتيجة: نتيجة_ربط_إعادة_تصدير = اربط_مرادف_إعادة_تصدير(
                        سياق_الأسماء, الرسم, الوحدة, الدلالية.النطاق_الجذري, المصدر,
                        &التصريح, &أب_الهدف
                    );
                    إذا (!ربط_إعادة_تصدير_مكتمل(&النتيجة)) { أرجع النتيجة; };
                }
                | اختياري.لا_شيء -> { };
            };
            م := م + 1;
        }
        أرجع نتيجة_ربط_إعادة_تصدير.مكتملة();
    };
}

عرف اختياري_اسم_غائب(القيمة: &اختياري اسم): منطقي {
    طابق *القيمة مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(_) -> { أرجع خطأ; };
}

عام عرف ربط_إعادة_تصدير_مكتمل(النتيجة: &نتيجة_ربط_إعادة_تصدير): منطقي {
    طابق *النتيجة مع
    | نتيجة_ربط_إعادة_تصدير.مكتملة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف ابن_دلالة_أسماء_وحدة_من_تصريحات(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الوحدة_النحوية: &وحدة_مصدر,
    المصدر: &مصدر,
    التصريحات_المجمعة: &جدول_تصريحات
): نتيجة_دلالة_أسماء_وحدة {
    طابق وحدة_في_الرسم(الرسم, الوحدة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة();
    }
    | اختياري.موجود(الدلالية) -> {
        إذا (الدلالية.معرف_المصدر != (*الوحدة_النحوية).معرف_المصدر) {
            أرجع نتيجة_دلالة_أسماء_وحدة.مصدر_غير_مطابق();
        };
        إذا (!معرفا_وحدة_متساويان((*التصريحات_المجمعة).الوحدة.المعرف, الوحدة)) {
            أرجع نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة();
        };
        إذا ((*التصريحات_المجمعة).الوحدة.معرف_المصدر != (*الوحدة_النحوية).معرف_المصدر) {
            أرجع نتيجة_دلالة_أسماء_وحدة.مصدر_غير_مطابق();
        };
        ليكن روابط_الوحدة: متغير سياق_روابط_أسماء = سياق_روابط_أسماء_جديد();
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الوحدة_النحوية).العناصر) مثل طبيعي)) {
            ليكن مرجع_العنصر: &عنصر_وحدة = &(*الوحدة_النحوية).العناصر[ف];
            ليكن العنصر: عنصر_وحدة = *مرجع_العنصر;
            طابق العنصر مع
            | عنصر_وحدة.دالة(الدالة) -> {
                ليكن خطأ_العلوي: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                    سياق_الأسماء,
                    &متغير روابط_الوحدة,
                    المصدر,
                    الدلالية.النطاق_الجذري,
                    &الدالة.الاسم
                );
                إذا (هل_خطأ_ربط_أسماء(خطأ_العلوي)) {
                    أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_العلوي, &متغير روابط_الوحدة);
                };
                ليكن خطأ_السمات: خطأ_ربط_أسماء = اربط_سمات_تصريح(
                    سياق_الأسماء, الرسم, الوحدة, الدلالية.النطاق_الجذري,
                    &متغير روابط_الوحدة, المصدر, &الدالة.السمات
                );
                إذا (هل_خطأ_ربط_أسماء(خطأ_السمات)) { أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_السمات, &متغير روابط_الوحدة); };

                ليكن فهرس_البديل: متغير طبيعي = 0;
                طالما (فهرس_البديل < (الطول(الدالة.الأسماء_البديلة) مثل طبيعي)) {
                    ليكن خطأ_البديل: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                        سياق_الأسماء,
                        &متغير روابط_الوحدة,
                        المصدر,
                        الدلالية.النطاق_الجذري,
                        &الدالة.الأسماء_البديلة[فهرس_البديل]
                    );
                    إذا (هل_خطأ_ربط_أسماء(خطأ_البديل)) {
                        أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_البديل, &متغير روابط_الوحدة);
                    };
                    فهرس_البديل := فهرس_البديل + 1;
                }
                ليكن نطاق_الدالة: معرف_نطاق = نطاق_ابن_بمصدر(سياق_الأسماء, الدلالية.النطاق_الجذري, الدالة.النطاق);
                ليكن ط: متغير طبيعي = 0;
                طالما (ط < (الطول(الدالة.معاملات_النوع) مثل طبيعي)) {
                    ليكن خطأ_معامل_النوع: خطأ_ربط_أسماء = سجل_محليا(
                        سياق_الأسماء,
                        &متغير روابط_الوحدة,
                        المصدر,
                        نطاق_الدالة,
                        &الدالة.معاملات_النوع[ط],
                        الدالة.معاملات_النوع[ط].النطاق,
                        نوع_تصريح.معامل_نوع()
                    );
                    إذا (هل_خطأ_ربط_أسماء(خطأ_معامل_النوع)) {
                        أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_معامل_النوع, &متغير روابط_الوحدة);
                    };
                    ط := ط + 1;
                }
                ليكن ه: متغير طبيعي = 0;
                طالما (ه < (الطول(الدالة.المعاملات) مثل طبيعي)) {
                    ليكن خ1: خطأ_ربط_أسماء = اربط_نوعا(
                        سياق_الأسماء,
                        الرسم,
                        الوحدة,
                        نطاق_الدالة,
                        &متغير روابط_الوحدة,
                        المصدر,
                        &الدالة.المعاملات[ه].النوع
                    );
                    إذا (هل_خطأ_ربط_أسماء(خ1)) {
                        أرجع نتيجة_خطأ_مع_المؤجلة(خ1, &متغير روابط_الوحدة);
                    };
                    ليكن خ2: خطأ_ربط_أسماء = سجل_محليا(
                        سياق_الأسماء,
                        &متغير روابط_الوحدة,
                        المصدر,
                        نطاق_الدالة,
                        &الدالة.المعاملات[ه].الاسم,
                        الدالة.المعاملات[ه].النطاق,
                        نوع_تصريح.معامل()
                    );
                    إذا (هل_خطأ_ربط_أسماء(خ2)) {
                        أرجع نتيجة_خطأ_مع_المؤجلة(خ2, &متغير روابط_الوحدة);
                    };
                    ه := ه + 1;
                }
                ليكن خطأ_الناتج: خطأ_ربط_أسماء = اربط_نوعا(
                    سياق_الأسماء,
                    الرسم,
                    الوحدة,
                    نطاق_الدالة,
                    &متغير روابط_الوحدة,
                    المصدر,
                    &الدالة.الناتج
                );
                إذا (هل_خطأ_ربط_أسماء(خطأ_الناتج)) {
                    أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_الناتج, &متغير روابط_الوحدة);
                };
                طابق الدالة.الجسم مع | اختياري.موجود(الجسم) -> {
                    ليكن خطأ_الجسم: خطأ_ربط_أسماء = اربط_كتلة(
                        سياق_الأسماء,
                        الرسم,
                        الوحدة,
                        نطاق_الدالة,
                        &متغير روابط_الوحدة,
                        المصدر,
                        &الجسم,
                        خطأ
                    );
                    إذا (هل_خطأ_ربط_أسماء(خطأ_الجسم)) {
                        أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_الجسم, &متغير روابط_الوحدة);
                    };
                } | اختياري.لا_شيء -> {
                };
            }
            | عنصر_وحدة.قيمة_عليا(التصريح) -> {
                ليكن خطأ_العلوي: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                    سياق_الأسماء,
                    &متغير روابط_الوحدة,
                    المصدر,
                    الدلالية.النطاق_الجذري,
                    &التصريح.الاسم
                );
                إذا (هل_خطأ_ربط_أسماء(خطأ_العلوي)) { أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_العلوي, &متغير روابط_الوحدة); };
                ليكن خطأ_السمات: خطأ_ربط_أسماء = اربط_سمات_تصريح(
                    سياق_الأسماء, الرسم, الوحدة, الدلالية.النطاق_الجذري,
                    &متغير روابط_الوحدة, المصدر, &التصريح.السمات
                );
                إذا (هل_خطأ_ربط_أسماء(خطأ_السمات)) { أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_السمات, &متغير روابط_الوحدة); };

                ليكن خطأ_النوع: خطأ_ربط_أسماء = اربط_نوعا(
                    سياق_الأسماء, الرسم, الوحدة, الدلالية.النطاق_الجذري,
                    &متغير روابط_الوحدة, المصدر, &التصريح.النوع
                );
                إذا (هل_خطأ_ربط_أسماء(خطأ_النوع)) { أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_النوع, &متغير روابط_الوحدة); };
                طابق التصريح.التهيئة مع
                | تهيئة_قيمة_عليا.خارجية(_) -> { }
                | تهيئة_قيمة_عليا.تعبير(التعبير) -> {
                    ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                        سياق_الأسماء, الرسم, الوحدة, الدلالية.النطاق_الجذري,
                        &متغير روابط_الوحدة, المصدر, &التعبير
                    );
                    إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع نتيجة_خطأ_مع_المؤجلة(الخطأ, &متغير روابط_الوحدة); };
                }
                | تهيئة_قيمة_عليا.متجه(العناصر) -> {
                    ليكن فهرس_العنصر: متغير طبيعي = 0;
                    طالما (فهرس_العنصر < (الطول(العناصر) مثل طبيعي)) {
                        ليكن الخطأ: خطأ_ربط_أسماء = اربط_تعبيرا(
                            سياق_الأسماء, الرسم, الوحدة, الدلالية.النطاق_الجذري,
                            &متغير روابط_الوحدة, المصدر, &العناصر[فهرس_العنصر]
                        );
                        إذا (هل_خطأ_ربط_أسماء(الخطأ)) { أرجع نتيجة_خطأ_مع_المؤجلة(الخطأ, &متغير روابط_الوحدة); };
                        فهرس_العنصر := فهرس_العنصر + 1;
                    }
                };
            }
            | عنصر_وحدة.نوع(التصريح) -> {
                ليكن خطأ_العلوي: خطأ_ربط_أسماء = اربط_تصريح_علوي(
                    سياق_الأسماء,
                    &متغير روابط_الوحدة,
                    المصدر,
                    الدلالية.النطاق_الجذري,
                    &التصريح.الاسم
                );
                إذا (هل_خطأ_ربط_أسماء(خطأ_العلوي)) {
                    أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_العلوي, &متغير روابط_الوحدة);
                };
                ليكن خطأ_السمات: خطأ_ربط_أسماء = اربط_سمات_تصريح(
                    سياق_الأسماء, الرسم, الوحدة, الدلالية.النطاق_الجذري,
                    &متغير روابط_الوحدة, المصدر, &التصريح.السمات
                );
                إذا (هل_خطأ_ربط_أسماء(خطأ_السمات)) { أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_السمات, &متغير روابط_الوحدة); };

                ليكن نطاق_النوع: معرف_نطاق = نطاق_ابن_بمصدر(
                    سياق_الأسماء, الدلالية.النطاق_الجذري, التصريح.النطاق
                );
                ليكن ط: متغير طبيعي = 0;
                طالما (ط < (الطول(التصريح.معاملات_النوع) مثل طبيعي)) {
                    ليكن خطأ_معامل_النوع: خطأ_ربط_أسماء = سجل_محليا(
                        سياق_الأسماء,
                        &متغير روابط_الوحدة,
                        المصدر,
                        نطاق_النوع,
                        &التصريح.معاملات_النوع[ط],
                        التصريح.معاملات_النوع[ط].النطاق,
                        نوع_تصريح.معامل_نوع()
                    );
                    إذا (هل_خطأ_ربط_أسماء(خطأ_معامل_النوع)) {
                        أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_معامل_النوع, &متغير روابط_الوحدة);
                    };
                    ط := ط + 1;
                }
                طابق التصريح.الشكل مع
                | شكل_تصريح_نوع.مرادف(النوع) -> {
                    ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                        سياق_الأسماء,
                        الرسم,
                        الوحدة,
                        نطاق_النوع,
                        &متغير روابط_الوحدة,
                        المصدر,
                        &النوع
                    );
                    إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                        أرجع نتيجة_خطأ_مع_المؤجلة(الخطأ, &متغير روابط_الوحدة);
                    };
                }
                | شكل_تصريح_نوع.سجل(الحقول) -> {
                    ليكن ه: متغير طبيعي = 0;
                    طالما (ه < (الطول(الحقول) مثل طبيعي)) {
                        قنن_واربط_ظهور_اسم(سياق_الأسماء, &متغير روابط_الوحدة, المصدر, الحقول[ه].الاسم.النطاق);
                        ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                            سياق_الأسماء,
                            الرسم,
                            الوحدة,
                            نطاق_النوع,
                            &متغير روابط_الوحدة,
                            المصدر,
                            &الحقول[ه].النوع
                        );
                        إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                            أرجع نتيجة_خطأ_مع_المؤجلة(الخطأ, &متغير روابط_الوحدة);
                        };
                        ه := ه + 1;
                    }
                }
                | شكل_تصريح_نوع.تعداد(المنشئات) -> {
                    ليكن رمز_التعداد: متغير معرف_رمز = معرف_رمز_من(0);
                    طابق رمز_اسم_محلول_عند(&روابط_الوحدة, التصريح.الاسم.النطاق) مع
                    | اختياري.موجود(الرمز) -> { رمز_التعداد := الرمز; }
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_ربط_أسماء.اسم_مفقود(التصريح.الاسم.النطاق), &متغير روابط_الوحدة);
                    };
                    ليكن ه: متغير طبيعي = 0;
                    طالما (ه < (الطول(المنشئات) مثل طبيعي)) {
                        طابق حل_واربط_منشئ_مسمى(
                            سياق_الأسماء,
                            &متغير روابط_الوحدة,
                            المصدر,
                            المنشئات[ه].الاسم.النطاق,
                            رمز_التعداد
                        ) مع
                        | اختياري.موجود(_) -> { }
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_ربط_أسماء.اسم_مفقود(المنشئات[ه].الاسم.النطاق), &متغير روابط_الوحدة);
                        };
                        ليكن ج: متغير طبيعي = 0;
                        طالما (ج < (الطول(المنشئات[ه].الحمولات) مثل طبيعي)) {
                            ليكن الخطأ: خطأ_ربط_أسماء = اربط_نوعا(
                                سياق_الأسماء,
                                الرسم,
                                الوحدة,
                                نطاق_النوع,
                                &متغير روابط_الوحدة,
                                المصدر,
                                &المنشئات[ه].الحمولات[ج]
                            );
                            إذا (هل_خطأ_ربط_أسماء(الخطأ)) {
                                أرجع نتيجة_خطأ_مع_المؤجلة(الخطأ, &متغير روابط_الوحدة);
                            };
                            ج := ج + 1;
                        } ه := ه + 1;
                    }
                }
                // No fields, constructors or target type to bind. The
                // contextual word must not hide a visible type of that name,
                // which this declaration used to alias.
                | شكل_تصريح_نوع.معتم(نطاق_الكلمة) -> {
                    ليكن هوية_الكلمة: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
                        &(*المصدر).المحتوى, نطاق_الكلمة.البداية.البايت, نطاق_الكلمة.النهاية.البايت
                    );
                    طابق حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
                        سياق_الأسماء, الرسم, الوحدة, نطاق_النوع, &هوية_الكلمة, حيز_اسم.نوع()
                    ) مع
                    | نتيجة_حل_ظهور_اسم.موجود(_) -> {
                        أرجع نتيجة_خطأ_مع_المؤجلة(
                            خطأ_ربط_أسماء.معتم_يحجب_نوعا_مرئيا(نطاق_الكلمة), &متغير روابط_الوحدة
                        );
                    }
                    | نتيجة_حل_ظهور_اسم.غامض -> {
                        أرجع نتيجة_خطأ_مع_المؤجلة(
                            خطأ_ربط_أسماء.معتم_يحجب_نوعا_مرئيا(نطاق_الكلمة), &متغير روابط_الوحدة
                        );
                    }
                    // Not visible here: the word declares the opaque type.
                    | نتيجة_حل_ظهور_اسم.خاص -> { }
                    | نتيجة_حل_ظهور_اسم.مفقود -> { };
                };
            }
            | عنصر_وحدة.تجميع(س, ب) -> { };
            ف := ف + 1;
        }
        ليكن فهرس_المرادف: متغير طبيعي = 0;
        طالما (فهرس_المرادف < (الطول((*الوحدة_النحوية).مرادفات_الأسماء) مثل طبيعي)) {
            ليكن التصريح: &تصريح_مرادف_اسم = &(*الوحدة_النحوية).مرادفات_الأسماء[فهرس_المرادف];
            ليكن خطأ_المرادف: خطأ_ربط_أسماء = اربط_مرادف_اسم_علويا(
                سياق_الأسماء,
                &متغير روابط_الوحدة,
                المصدر,
                الدلالية.النطاق_الجذري,
                التصريح
            );
            إذا (هل_خطأ_ربط_أسماء(خطأ_المرادف)) {
                أرجع نتيجة_خطأ_مع_المؤجلة(خطأ_المرادف, &متغير روابط_الوحدة);
            };
            فهرس_المرادف := فهرس_المرادف + 1;
        }
        إذا ((الطول(روابط_الوحدة.الأسماء_المفقودة) مثل طبيعي) > 0) {
            ليكن المفقودة: متجه اسم_مفقود_مؤجل = انسخ_أسماء_مفقودة_مؤجلة(&روابط_الوحدة.الأسماء_المفقودة);
            ليكن المربوطة: دلالة_أسماء_وحدة = { الوحدة: الوحدة, الروابط: روابط_الوحدة };
            أرجع نتيجة_دلالة_أسماء_وحدة.أسماء_مفقودة_مربوطة(المفقودة, المربوطة);
        };
        ليكن الناتج: دلالة_أسماء_وحدة = { الوحدة: الوحدة, الروابط: روابط_الوحدة };
        أرجع نتيجة_دلالة_أسماء_وحدة.مكتملة(الناتج);
    };
}

// Binds one function body in the function's own scope نطاق_الدالة, as
// ابن_دلالة_أسماء_وحدة_من_تصريحات binds it after the signature: its locals
// are declared in that scope and its occurrences recorded in الروابط, in
// source order. An incremental tooling session re-binds the bodies of an
// edited module this way (semantic_pipeline.sn, افحص_أجسام_وحدة_في_حالة).
// False when the body has an error that fails the module's binding.
عام عرف اربط_جسم_دالة_للأدوات(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    نطاق_الدالة: معرف_نطاق,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    الجسم: &كتلة_عبارات
): منطقي {
    ليكن الخطأ: خطأ_ربط_أسماء = اربط_كتلة(
        سياق_الأسماء, الرسم, الوحدة, نطاق_الدالة, الروابط, المصدر, الجسم, خطأ
    );
    أرجع !هل_خطأ_ربط_أسماء(الخطأ);
}

// Compatibility entry for single-module callers: collect once, then resolve.
عام عرف ابن_دلالة_أسماء_وحدة(
    سياق_الأسماء: &متغير سياق_أسماء,
    الرسم: &رسم_وحدات,
    الوحدة: معرف_وحدة,
    الوحدة_النحوية: &وحدة_مصدر,
    المصدر: &مصدر
): نتيجة_دلالة_أسماء_وحدة {
    طابق اجمع_تصريحات_أسماء_وحدة(
        سياق_الأسماء, الرسم, الوحدة, الوحدة_النحوية, المصدر
    ) مع
    | نتيجة_جمع_تصريحات_أسماء_وحدة.مكتملة(التصريحات) -> {
        طابق اربط_مرادفات_إعادة_التصدير(
            سياق_الأسماء, الرسم, الوحدة, الوحدة_النحوية, المصدر
        ) مع
        | نتيجة_ربط_إعادة_تصدير.مكتملة -> { }
        | نتيجة_ربط_إعادة_تصدير.تصريح_مكرر(الموجود, النطاق) -> {
            أرجع نتيجة_دلالة_أسماء_وحدة.تصريح_مكرر(الموجود, النطاق);
        }
        | نتيجة_ربط_إعادة_تصدير.اسم_مفقود(النطاق) -> {
            أرجع نتيجة_دلالة_أسماء_وحدة.اسم_مفقود(النطاق);
        }
        | نتيجة_ربط_إعادة_تصدير.اسم_خاص(النطاق) -> {
            أرجع نتيجة_دلالة_أسماء_وحدة.اسم_خاص(النطاق);
        }
        | نتيجة_ربط_إعادة_تصدير.اسم_غامض(النطاق) -> {
            أرجع نتيجة_دلالة_أسماء_وحدة.اسم_غامض(النطاق);
        };
        أرجع ابن_دلالة_أسماء_وحدة_من_تصريحات(
            سياق_الأسماء, الرسم, الوحدة, الوحدة_النحوية, المصدر, &التصريحات
        );
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.وحدة_مجهولة -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.وحدة_مجهولة();
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.مصدر_غير_مطابق -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.مصدر_غير_مطابق();
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.تصريح_مكرر(الموجود, النطاق) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.تصريح_مكرر(الموجود, النطاق);
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_مفقود(النطاق) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_مفقود(النطاق);
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.اسم_خاص(النطاق) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.اسم_خاص(النطاق);
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.تعارض_ربط(النطاق) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.تعارض_ربط(النطاق);
    }
    | نتيجة_جمع_تصريحات_أسماء_وحدة.مرادف_أب_غير_مطابق(النطاق) -> {
        أرجع نتيجة_دلالة_أسماء_وحدة.مرادف_أب_غير_مطابق(النطاق);
    };
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).
