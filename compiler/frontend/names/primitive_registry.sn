استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.name_context;
استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.runtime.primitive_identity;

// Frontend owns source-spelling -> primitive Symbol binding only.
// Runtime owns primitive semantic identities and primitive -> runtime-service mapping.
عرف سجل_بدائيا_واحدا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق_المالك: معرف_نطاق,
    الاسم_الأساسي: نص,
    الاسم_البديل: نص,
    الهوية: هوية_بدائي_مترجم
): منطقي {
    دع الرمز: متغير معرف_رمز = معرف_رمز_من(0);
    طابق أضف_رمزا_بدائيا(
        سياق_الأسماء, النطاق_المالك, الاسم_الأساسي, الهوية
    ) مع
    | نتيجة_إضافة.أضيف(المعرف) -> {
        الرمز := المعرف;
    }
    | نتيجة_إضافة.مكرر(الموجود, _) -> {
        الرمز := الموجود;
    };

    طابق أضف_اسما_بدائيا(سياق_الأسماء, الاسم_البديل, الرمز) مع
    | نتيجة_إضافة.أضيف(نفس_الرمز) -> {
        أرجع معرفا_رمز_متساويان(نفس_الرمز, الرمز);
    }
    | نتيجة_إضافة.مكرر(الموجود, _) -> {
        أرجع معرفا_رمز_متساويان(الموجود, الرمز);
    };
}

عام عرف سجل_بدائيات_المترجم(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق_المالك: معرف_نطاق
): منطقي {
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «الطول», «length», هوية_بدائي_مترجم.طول())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «ألحق», «append», هوية_بدائي_مترجم.إلحاق())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدّل», «swap», هوية_بدائي_مترجم.تبديل_موضعين())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «حرر», «release», هوية_بدائي_مترجم.تحرير())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_معمارية_المضيف», «بدائي_معمارية_المضيف», هوية_بدائي_مترجم.معمارية_المضيف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_منصة_المضيف», «بدائي_منصة_المضيف», هوية_بدائي_مترجم.منصة_المضيف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_بيئة_المضيف», «بدائي_بيئة_المضيف», هوية_بدائي_مترجم.بيئة_المضيف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_بتات_ع64», «بدائي_بتات_ع64», هوية_بدائي_مترجم.بتات_ع64())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_ع64_من_بتات», «بدائي_ع64_من_بتات», هوية_بدائي_مترجم.ع64_من_بتات())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_بتات_ع32», «بدائي_بتات_ع32», هوية_بدائي_مترجم.بتات_ع32())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_ع32_من_بتات», «بدائي_ع32_من_بتات», هوية_بدائي_مترجم.ع32_من_بتات())) { أرجع خطأ; };
    أرجع صواب;
}

عام عرف حل_رمز_بدائي_بهوية(
    سياق_الأسماء: &سياق_أسماء,
    الاسم: معرف_اسم
): اختيار معرف_رمز {
    أرجع ابحث_رمزا_بدائيا_بهوية(سياق_الأسماء, الاسم);
}

// Unqualified aliases preserve ordinary lexical binding first. Only a private
// alias whose ordinary target is absent may bind a registered compiler intrinsic.
// Primitive spelling alone never creates a symbol; the registry is authoritative.
عام عرف حل_هدف_مرادف_غير_مؤهل(
    سياق_الأسماء: &سياق_أسماء,
    الجذر: معرف_نطاق,
    الاسم: معرف_اسم,
    علني: منطقي
): اختيار معرف_رمز {
    طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, الاسم) مع
    | اختيار.بعض(الرمز) -> { أرجع اختيار.بعض(الرمز); }
    | اختيار.لا_شيء -> { };

    لو (!علني) {
        أرجع حل_رمز_بدائي_بهوية(سياق_الأسماء, الاسم);
    };
    أرجع اختيار.لا_شيء();
}

عام عرف حل_رمز_بدائي_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق
): اختيار معرف_رمز {
    دع الاسم: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم);
    أرجع حل_رمز_بدائي_بهوية(سياق_الأسماء, الاسم);
}

// Only retained language/compiler intrinsics are registered here. Migrated runtime
// services use ordinary typed extern declarations and never bind through primitive
// source-name resolution.
عام عرف بدائي_مباشر_مصدريا(الهوية: هوية_بدائي_مترجم): منطقي {
    طابق الهوية مع
    | هوية_بدائي_مترجم.طول -> { أرجع صواب; }
    | هوية_بدائي_مترجم.إلحاق -> { أرجع صواب; }
    | هوية_بدائي_مترجم.تبديل_موضعين -> { أرجع صواب; }
    | هوية_بدائي_مترجم.تحرير -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف رمز_بدائي_مباشر_مصدريا(
    سياق_الأسماء: &سياق_أسماء,
    الرمز: معرف_رمز
): منطقي {
    طابق هوية_بدائي_رمز_عند(سياق_الأسماء, الرمز) مع
    | اختيار.بعض(الهوية) -> { أرجع بدائي_مباشر_مصدريا(الهوية); }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام عرف حل_رمز_بدائي_مباشر_ببايتات(
    سياق_الأسماء: &سياق_أسماء,
    الهوية: &متجه غ8
): اختيار معرف_رمز {
    طابق ابحث_بدائيا_ببايتات(سياق_الأسماء, الهوية) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الرمز) -> {
        لو (رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, الرمز)) {
            أرجع اختيار.بعض(الرمز);
        };
        أرجع اختيار.لا_شيء();
    };
}

عام عرف حل_رمز_بدائي_مباشر_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق
): اختيار معرف_رمز {
    طابق حل_رمز_بدائي_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الرمز) -> {
        لو (رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, الرمز)) {
            أرجع اختيار.بعض(الرمز);
        };
        أرجع اختيار.لا_شيء();
    };
}
