    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_ذري_جلب_و», «بدائي_ذري_جلب_و», هوية_بدائي_مترجم.ذري_جلب_و())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_ذري_جلب_أو», «بدائي_ذري_جلب_أو», هوية_بدائي_مترجم.ذري_جلب_أو())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_ذري_جلب_أو_حصري», «بدائي_ذري_جلب_أو_حصري», هوية_بدائي_مترجم.ذري_جلب_أو_حصري())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_سياج_ذاكرة», «بدائي_سياج_ذاكرة», هوية_بدائي_مترجم.سياج_ذاكرة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_سرب_قيمة», «بدائي_سرب_قيمة», هوية_بدائي_مترجم.سرب_قيمة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_عنوان_دالة», «بدائي_عنوان_دالة», هوية_بدائي_مترجم.عنوان_دالة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_دالة_من_عنوان», «بدائي_دالة_من_عنوان», هوية_بدائي_مترجم.دالة_من_عنوان())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_مدخل_سي_لدالة», «بدائي_مدخل_سي_لدالة», هوية_بدائي_مترجم.مدخل_سي_لدالة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_استنسخ_خيط_نواة», «بدائي_استنسخ_خيط_نواة», هوية_بدائي_مترجم.استنساخ_خيط_نواة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_نداء_عنوان_سي», «raw_c_call», هوية_بدائي_مترجم.نداء_عنوان_سي())) { أرجع خطأ; };
    أرجع صواب;
}

عام عرف حل_رمز_بدائي_بهوية(
    سياق_الأسماء: &سياق_أسماء,
    الاسم: معرف_اسم
): اختياري معرف_رمز {
    أرجع ابحث_رمزا_بدائيا_بهوية(سياق_الأسماء, الاسم);
}

// Unqualified aliases preserve ordinary lexical binding first. Only a private
// alias whose ordinary target is absent may bind a registered compiler intrinsic.
// Primitive spelling alone never creates a symbol; the registry is authoritative.
عام عرف حل_هدف_مرادف_غير_مؤهل(
    سياق_الأسماء: &سياق_أسماء,
    الجذر: معرف_نطاق,
    الاسم: معرف_اسم,
    علني: منطقي
): اختياري معرف_رمز {
    طابق ابحث_محليا_بهوية(سياق_الأسماء, الجذر, الاسم) مع
    | اختياري.موجود(الرمز) -> { أرجع اختياري.موجود(الرمز); }
    | اختياري.لا_شيء -> { };

    لو (!علني) {
        أرجع حل_رمز_بدائي_بهوية(سياق_الأسماء, الاسم);
    };
    أرجع اختياري.لا_شيء();
}

عام عرف حل_رمز_بدائي_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق
): اختياري معرف_رمز {
    دع الاسم: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم);
    أرجع حل_رمز_بدائي_بهوية(سياق_الأسماء, الاسم);
}

// Only retained language/compiler intrinsics are registered here. Migrated runtime
// services use ordinary typed extern declarations and never bind through primitive
// source-name resolution.
عام عرف بدائي_مباشر_مصدريا(الهوية: هوية_بدائي_مترجم): منطقي {
    طابق الهوية مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> { أرجع صواب; }
    | هوية_بدائي_مترجم.طول -> { أرجع صواب; }
    | هوية_بدائي_مترجم.إلحاق -> { أرجع صواب; }
    | هوية_بدائي_مترجم.إزالة_الأخير -> { أرجع صواب; }
    | هوية_بدائي_مترجم.اقتطاع_متجه -> { أرجع صواب; }
    | هوية_بدائي_مترجم.سعة_متجه -> { أرجع صواب; }
    | هوية_بدائي_مترجم.حجز_سعة_متجه -> { أرجع صواب; }
    | هوية_بدائي_مترجم.تبديل_موضعين -> { أرجع صواب; }
    | هوية_بدائي_مترجم.تحرير -> { أرجع صواب; }
    | هوية_بدائي_مترجم.استنساخ -> { أرجع صواب; }
    // Compile-time reflection and evaluation-failure intrinsics: folded or
    // trapped by the compiler, never bound to a runtime service.
    | هوية_بدائي_مترجم.حجم_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.محاذاة_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.فشل_وقت_الترجمة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف رمز_بدائي_مباشر_مصدريا(
    سياق_الأسماء: &سياق_أسماء,
    الرمز: معرف_رمز
): منطقي {
    طابق هوية_بدائي_رمز_عند(سياق_الأسماء, الرمز) مع
    | اختياري.موجود(الهوية) -> { أرجع بدائي_مباشر_مصدريا(الهوية); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام عرف حل_رمز_بدائي_مباشر_ببايتات(
    سياق_الأسماء: &سياق_أسماء,
    الهوية: &متجه ط8
): اختياري معرف_رمز {
    طابق ابحث_بدائيا_ببايتات(سياق_الأسماء, الهوية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الرمز) -> {
        لو (رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, الرمز)) {
            أرجع اختياري.موجود(الرمز);
        };
        أرجع اختياري.لا_شيء();
    };
}

عام عرف حل_رمز_بدائي_مباشر_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق
): اختياري معرف_رمز {
    طابق حل_رمز_بدائي_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الرمز) -> {
        لو (رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, الرمز)) {
            أرجع اختياري.موجود(الرمز);
        };
        أرجع اختياري.لا_شيء();
    };
}
