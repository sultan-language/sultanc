    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_بيئة_المضيف», «بدائي_بيئة_المضيف», هوية_بدائي_مترجم.بيئة_المضيف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_عدد_الوسائط», «بدائي_عدد_الوسائط», هوية_بدائي_مترجم.عدد_الوسائط())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_الوسيط», «بدائي_الوسيط», هوية_بدائي_مترجم.الوصول_إلى_وسيط())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_خروج», «بدائي_خروج», هوية_بدائي_مترجم.خروج_العملية())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_نص_من_بايتات», «بدائي_نص_من_بايتات», هوية_بدائي_مترجم.نص_من_بايتات())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_تصنيف_خطأ_نظام», «بدائي_تصنيف_خطأ_نظام», هوية_بدائي_مترجم.تصنيف_خطأ_نظام())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إنشاء_دليل», «بدائي_إنشاء_دليل», هوية_بدائي_مترجم.إنشاء_دليل())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إزالة_ملف», «بدائي_إزالة_ملف», هوية_بدائي_مترجم.إزالة_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إزالة_دليل», «بدائي_إزالة_دليل», هوية_بدائي_مترجم.إزالة_دليل())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إعادة_تسمية», «بدائي_إعادة_تسمية», هوية_بدائي_مترجم.إعادة_تسمية())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_نوع_مسار», «بدائي_نوع_مسار», هوية_بدائي_مترجم.نوع_مسار())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_حجم_مسار», «بدائي_حجم_مسار», هوية_بدائي_مترجم.حجم_مسار())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_وقت_تعديل_مسار», «بدائي_وقت_تعديل_مسار», هوية_بدائي_مترجم.وقت_تعديل_مسار())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_فتح_مقبض_ملف_للقراءة», «بدائي_فتح_مقبض_ملف_للقراءة», هوية_بدائي_مترجم.فتح_مقبض_ملف_للقراءة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إنشاء_مقبض_ملف_للكتابة», «بدائي_إنشاء_مقبض_ملف_للكتابة», هوية_بدائي_مترجم.إنشاء_مقبض_ملف_للكتابة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قراءة_مقطع_مقبض_ملف», «بدائي_قراءة_مقطع_مقبض_ملف», هوية_بدائي_مترجم.قراءة_مقطع_مقبض_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_كتابة_مقطع_مقبض_ملف», «بدائي_كتابة_مقطع_مقبض_ملف», هوية_بدائي_مترجم.كتابة_مقطع_مقبض_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إغلاق_مقبض_ملف», «بدائي_إغلاق_مقبض_ملف», هوية_بدائي_مترجم.إغلاق_مقبض_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_تحريك_مقبض_ملف», «بدائي_تحريك_مقبض_ملف», هوية_بدائي_مترجم.تحريك_مقبض_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_موضع_مقبض_ملف», «بدائي_موضع_مقبض_ملف», هوية_بدائي_مترجم.موضع_مقبض_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_مزامنة_مقبض_ملف», «بدائي_مزامنة_مقبض_ملف», هوية_بدائي_مترجم.مزامنة_مقبض_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_وقت_رتيب_نانو», «بدائي_وقت_رتيب_نانو», هوية_بدائي_مترجم.وقت_رتيب_نانو())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_وقت_نظام_نانو», «بدائي_وقت_نظام_نانو», هوية_بدائي_مترجم.وقت_نظام_نانو())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_نوم_نانو», «بدائي_نوم_نانو», هوية_بدائي_مترجم.نوم_نانو())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_طول_متغير_بيئة», «بدائي_طول_متغير_بيئة», هوية_بدائي_مترجم.طول_متغير_بيئة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قراءة_متغير_بيئة», «بدائي_قراءة_متغير_بيئة», هوية_بدائي_مترجم.قراءة_متغير_بيئة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_دليل_العمل», «بدائي_دليل_العمل», هوية_بدائي_مترجم.دليل_العمل())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_الدليل_المؤقت», «بدائي_الدليل_المؤقت», هوية_بدائي_مترجم.الدليل_المؤقت())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_تشغيل_عملية», «بدائي_تشغيل_عملية», هوية_بدائي_مترجم.تشغيل_عملية())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_انتظار_عملية», «بدائي_انتظار_عملية», هوية_بدائي_مترجم.انتظار_عملية())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_حجم_صفحة_النظام», «بدائي_حجم_صفحة_النظام», هوية_بدائي_مترجم.حجم_صفحة_النظام())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_خريطة_ذاكرة_النظام», «بدائي_خريطة_ذاكرة_النظام», هوية_بدائي_مترجم.خريطة_ذاكرة_النظام())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إلغاء_خريطة_ذاكرة_النظام», «بدائي_إلغاء_خريطة_ذاكرة_النظام», هوية_بدائي_مترجم.إلغاء_خريطة_ذاكرة_النظام())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_حماية_ذاكرة_النظام», «بدائي_حماية_ذاكرة_النظام», هوية_بدائي_مترجم.حماية_ذاكرة_النظام())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قفل_ذاكرة_النظام», «بدائي_قفل_ذاكرة_النظام», هوية_بدائي_مترجم.قفل_ذاكرة_النظام())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إلغاء_قفل_ذاكرة_النظام», «بدائي_إلغاء_قفل_ذاكرة_النظام», هوية_بدائي_مترجم.إلغاء_قفل_ذاكرة_النظام())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_نصيحة_ذاكرة_النظام», «بدائي_نصيحة_ذاكرة_النظام», هوية_بدائي_مترجم.نصيحة_ذاكرة_النظام())) { أرجع خطأ; };
    أرجع صواب;
}

عام عرف حل_رمز_بدائي_بهوية(
    سياق_الأسماء: &سياق_أسماء,
    الاسم: معرف_اسم
): اختيار معرف_رمز {
    أرجع ابحث_رمزا_بدائيا_بهوية(سياق_الأسماء, الاسم);
}

عام عرف حل_رمز_بدائي_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق
): اختيار معرف_رمز {
    دع الاسم: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم);
    أرجع حل_رمز_بدائي_بهوية(سياق_الأسماء, الاسم);
}

// Only irreducible language/compiler semantics remain directly source-callable.
// Runtime/service primitives stay registered by identity so trusted private aliases
// can bind them, but ordinary Name resolution must not expose them.
عام عرف بدائي_مباشر_مصدريا(الهوية: هوية_بدائي_مترجم): منطقي {
    طابق الهوية مع
    | هوية_بدائي_مترجم.طول -> { أرجع صواب; }
    | هوية_بدائي_مترجم.إلحاق -> { أرجع صواب; }
    | هوية_بدائي_مترجم.تحرير -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف رمز_بدائي_مباشر_مصدريا(
    سياق_الأسماء: &سياق_أسماء,
    الرمز: معرف_رمز
): منطقي {
    طابق هوية_بدائي_رمز_عند(سياق_الأسماء, الرمز) مع
    | اختيار.بعض(الهوية) -> { أرجع بدائي_مباشر_مصدريا(الهوية); }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام عرف حل_رمز_بدائي_مباشر_ببايتات(
    سياق_الأسماء: &سياق_أسماء,
    الهوية: &متجه غ8
): اختيار معرف_رمز {
    طابق ابحث_بدائيا_ببايتات(سياق_الأسماء, الهوية) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الرمز) -> {
        لو (رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, الرمز)) {
            أرجع اختيار.بعض(الرمز);
        };
        أرجع اختيار.لا_شيء();
    };
}

عام عرف حل_رمز_بدائي_مباشر_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق
): اختيار معرف_رمز {
    طابق حل_رمز_بدائي_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الرمز) -> {
        لو (رمز_بدائي_مباشر_مصدريا(سياق_الأسماء, الرمز)) {
            أرجع اختيار.بعض(الرمز);
        };
        أرجع اختيار.لا_شيء();
    };
}
