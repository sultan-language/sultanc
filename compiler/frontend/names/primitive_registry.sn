    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_اكتب_الذاكرة_الخطية», «بدائي_اكتب_الذاكرة_الخطية», هوية_بدائي_مترجم.كتابة_ذاكرة_خطية())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_انسخ_الذاكرة_الخطية», «بدائي_انسخ_الذاكرة_الخطية», هوية_بدائي_مترجم.نسخ_ذاكرة_خطية())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قاعدة_الكومة_الخطية», «بدائي_قاعدة_الكومة_الخطية», هوية_بدائي_مترجم.قاعدة_كومة_خطية())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_اقرأ_ذاكرة_الآلة», «بدائي_اقرأ_ذاكرة_الآلة», هوية_بدائي_مترجم.قراءة_ذاكرة_آلة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_اكتب_ذاكرة_الآلة», «بدائي_اكتب_ذاكرة_الآلة», هوية_بدائي_مترجم.كتابة_ذاكرة_آلة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_حجم_النوع», «بدائي_حجم_النوع», هوية_بدائي_مترجم.حجم_النوع())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_محاذاة_النوع», «بدائي_محاذاة_النوع», هوية_بدائي_مترجم.محاذاة_النوع())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_عدد_حقول_النوع», «بدائي_عدد_حقول_النوع», هوية_بدائي_مترجم.عدد_حقول_النوع())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_عدد_منشئات_النوع», «بدائي_عدد_منشئات_النوع», هوية_بدائي_مترجم.عدد_منشئات_النوع())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_فشل_وقت_الترجمة», «بدائي_فشل_وقت_الترجمة», هوية_بدائي_مترجم.فشل_وقت_الترجمة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_جذر_تربيعي_عائم», «بدائي_جذر_تربيعي_عائم», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.جذر_تربيعي()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قيمة_مطلقة_عائمة», «بدائي_قيمة_مطلقة_عائمة», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.قيمة_مطلقة()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_أرضية_عائمة», «بدائي_أرضية_عائمة», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.أرضية()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_سقف_عائم», «بدائي_سقف_عائم», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.سقف()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_بتر_عائم», «بدائي_بتر_عائم», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.بتر()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_تقريب_زوجي_عائم», «بدائي_تقريب_زوجي_عائم», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.تقريب_زوجي()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_أدنى_عائم», «بدائي_أدنى_عائم», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.أدنى()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_أقصى_عائم», «بدائي_أقصى_عائم», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.أقصى()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_نسخ_إشارة_عائمة», «بدائي_نسخ_إشارة_عائمة», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.نسخ_إشارة()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_ضرب_جمع_مدمج_عائم», «بدائي_ضرب_جمع_مدمج_عائم», هوية_بدائي_مترجم.عملية_عائمة(عملية_عائمة_بدائية.ضرب_جمع_مدمج()))) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_ذري_حمل», «بدائي_ذري_حمل», هوية_بدائي_مترجم.ذري_حمل())) { أرجع خطأ; };
