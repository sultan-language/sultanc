استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.context;
استورد compiler.frontend.source.source;
استورد compiler.frontend.source.scope;
استورد compiler.runtime.primitive_identity;

// Frontend owns source-spelling -> primitive Symbol binding only.
// Runtime owns primitive semantic identities and primitive -> runtime-service mapping.
عرف سجل_بدائيا_واحدا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق_المالك: معرف_نطاق,
    الاسم_الأساسي: نص,
    الاسم_البديل: نص,
    الهوية: هوية_بدائي_مترجم
): منطقي {
    دع الرمز: متغير معرف_رمز = معرف_رمز_من(0);
    طابق أضف_رمزا_بدائيا(
        سياق_الأسماء, النطاق_المالك, الاسم_الأساسي, الهوية
    ) مع
    | نتيجة_إضافة.أضيف(المعرف) -> {
        الرمز := المعرف;
    }
    | نتيجة_إضافة.مكرر(الموجود, _) -> {
        الرمز := الموجود;
    };

    طابق أضف_اسما_بدائيا(سياق_الأسماء, الاسم_البديل, الرمز) مع
    | نتيجة_إضافة.أضيف(نفس_الرمز) -> {
        أرجع معرفا_رمز_متساويان(نفس_الرمز, الرمز);
    }
    | نتيجة_إضافة.مكرر(الموجود, _) -> {
        أرجع معرفا_رمز_متساويان(الموجود, الرمز);
    };
}

عام عرف سجل_بدائيات_المترجم(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق_المالك: معرف_نطاق
): منطقي {
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «الطول», «length», هوية_بدائي_مترجم.طول())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «ألحق», «append», هوية_بدائي_مترجم.إلحاق())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «حرر», «release», هوية_بدائي_مترجم.تحرير())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_فتح_ملف_للقراءة», «بدائي_فتح_ملف_للقراءة», هوية_بدائي_مترجم.فتح_ملف_للقراءة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قراءة_بايت_ملف», «بدائي_قراءة_بايت_ملف», هوية_بدائي_مترجم.قراءة_بايت_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قراءة_مقطع_ملف», «بدائي_قراءة_مقطع_ملف», هوية_بدائي_مترجم.قراءة_مقطع_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إنشاء_ملف_للكتابة», «بدائي_إنشاء_ملف_للكتابة», هوية_بدائي_مترجم.إنشاء_ملف_للكتابة())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_كتابة_مقطع_ملف», «بدائي_كتابة_مقطع_ملف», هوية_بدائي_مترجم.كتابة_مقطع_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إغلاق_ملف», «بدائي_إغلاق_ملف», هوية_بدائي_مترجم.إغلاق_ملف())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_فتح_دليل», «بدائي_فتح_دليل», هوية_بدائي_مترجم.فتح_دليل())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قراءة_مدخل_دليل», «بدائي_قراءة_مدخل_دليل», هوية_بدائي_مترجم.قراءة_مدخل_دليل())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_إغلاق_دليل», «بدائي_إغلاق_دليل», هوية_بدائي_مترجم.إغلاق_دليل())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قراءة_بايت_دخل», «بدائي_قراءة_بايت_دخل», هوية_بدائي_مترجم.قراءة_بايت_الدخل_القياسي())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_قراءة_مقطع_دخل», «بدائي_قراءة_مقطع_دخل», هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_كتابة_بايتات_تنفيذية», «بدائي_كتابة_بايتات_تنفيذية», هوية_بدائي_مترجم.كتابة_بايتات_تنفيذية())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_كتابة_خرج», «بدائي_كتابة_خرج», هوية_بدائي_مترجم.كتابة_الخرج_القياسي())) { أرجع خطأ; };
    لو (!سجل_بدائيا_واحدا(سياق_الأسماء, النطاق_المالك, «بدائي_كتابة_خطأ», «بدائي_كتابة_خطأ», هوية_بدائي_مترجم.كتابة_الخطأ_القياسي())) { أرجع خطأ; };
