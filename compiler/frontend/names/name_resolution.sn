استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.context;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.names.primitive_registry;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;

// Parsed source occurrences already have normalized identifier bytes. Resolve those bytes
// directly against lexical/import bindings instead of globally interning the occurrence first.
عام نوع نتيجة_حل_ظهور_اسم =
    | موجود بنوع معرف_رمز
    | خاص
    | غامض
    | مفقود
;

عرف بايتات_استيراد_متساوية(الأول: &متجه غ8, الثاني: &متجه غ8): منطقي {
    دع أ: متجه غ8 = *الأول;
    دع ب: متجه غ8 = *الثاني;
    لو (الطول(أ) != الطول(ب)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أ) مثل غير_موقع)) {
        لو (أ[ف] != ب[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف حافة_تسمح_باسم(الحافة: &حافة_استيراد_وحدة, الهوية: &متجه غ8): منطقي {
    دع القيمة: حافة_استيراد_وحدة = *الحافة;
    طابق القيمة.السياسة مع
    | سياسة_استيراد_وحدة.كامل -> { أرجع صواب; }
    | سياسة_استيراد_وحدة.مسمى(_) -> { أرجع خطأ; }
    | سياسة_استيراد_وحدة.انتقائي(الأسماء) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأسماء) مثل غير_موقع)) {
            لو (بايتات_استيراد_متساوية(&الأسماء[ف].الهوية, الهوية)) { أرجع صواب; };
            ف := ف + 1;
        }
        أرجع خطأ;
    };
}

عام نوع نتيجة_تحقق_استيراد_انتقائي =
    | صالح
    | اسم_مفقود بنوع نطاق
    | اسم_خاص بنوع نطاق
    | اسم_غامض بنوع نطاق
;

عام نوع نتيجة_حل_عضو_استيراد_مسمى =
    | ليس_مرادفا
    | موجود بنوع معرف_رمز
    | خاص
    | غامض
    | مفقود
;

عام عرف حل_عضو_استيراد_مسمى_ببايتات_في_حيز(
    سياق_الأسماء: &سياق_أسماء,
    الرسم: &رسم_وحدات,
    من_الوحدة: معرف_وحدة,
    هوية_المرادف: &متجه غ8,
    هوية_العضو: &متجه غ8,
    الحيز: حيز_اسم
): نتيجة_حل_عضو_استيراد_مسمى {
    دع المطابقة_العامة: متغير اختيار معرف_رمز = اختيار.لا_شيء();
    دع وجدت_مرادفا: متغير منطقي = خطأ;
    دع وجدت_خاصا: متغير منطقي = خطأ;
    طابق وحدة_في_الرسم(الرسم, من_الوحدة) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_حل_عضو_استيراد_مسمى.ليس_مرادفا(); }
    | اختيار.بعض(_) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < عدد_استيرادات_الوحدة(الرسم, من_الوحدة)) {
            دع الحافة: حافة_استيراد_وحدة = حافة_استيراد_الوحدة_عند(الرسم, من_الوحدة, ف);
            طابق الحافة.السياسة مع
            | سياسة_استيراد_وحدة.مسمى(المرادف) -> {
                لو (بايتات_استيراد_متساوية(&المرادف.الهوية, هوية_المرادف)) {
                    وجدت_مرادفا := صواب;
                    طابق وحدة_في_الرسم(الرسم, الحافة.الوحدة) مع
                    | اختيار.بعض(المستوردة) -> {
                        طابق ابحث_محليا_ببايتات_في_حيز(
                            سياق_الأسماء, المستوردة.النطاق_الجذري, هوية_العضو, الحيز
                        ) مع
                        | اختيار.بعض(الرمز) -> {
                            طابق علنية_رمز_عند(سياق_الأسماء, الرمز) مع
                            | اختيار.بعض(علني) -> {
                                لو (علني) {
                                    طابق المطابقة_العامة مع
                                    | اختيار.لا_شيء -> { المطابقة_العامة := اختيار.بعض(الرمز); }
                                    | اختيار.بعض(قديم) -> {
                                        لو (!معرفا_رمز_متساويان(قديم, الرمز)) {
                                            أرجع نتيجة_حل_عضو_استيراد_مسمى.غامض();
                                        };
                                    };
                                } وإلا { وجدت_خاصا := صواب; };
                            }
                            | اختيار.لا_شيء -> { };
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> { };
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
    };
    طابق المطابقة_العامة مع
    | اختيار.بعض(الرمز) -> { أرجع نتيجة_حل_عضو_استيراد_مسمى.موجود(الرمز); }
    | اختيار.لا_شيء -> { };
    لو (وجدت_خاصا) { أرجع نتيجة_حل_عضو_استيراد_مسمى.خاص(); };
    لو (وجدت_مرادفا) { أرجع نتيجة_حل_عضو_استيراد_مسمى.مفقود(); };
    أرجع نتيجة_حل_عضو_استيراد_مسمى.ليس_مرادفا();
}


عرف حل_مستورد_مباشر_ببايتات_في_حيز(
    سياق_الأسماء: &سياق_أسماء,
    الرسم: &رسم_وحدات,
    من_الوحدة: معرف_وحدة,
    الهوية: &متجه غ8,
    الحيز: حيز_اسم
): نتيجة_حل_ظهور_اسم {
    دع المطابقة_العامة: متغير اختيار معرف_رمز = اختيار.لا_شيء();
    دع وجدت_خاصا: متغير منطقي = خطأ;
    طابق وحدة_في_الرسم(الرسم, من_الوحدة) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_حل_ظهور_اسم.مفقود(); }
    | اختيار.بعض(المالكة) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < عدد_استيرادات_الوحدة(الرسم, من_الوحدة)) {
            دع الحافة: حافة_استيراد_وحدة = حافة_استيراد_الوحدة_عند(الرسم, من_الوحدة, ف);
            لو (حافة_تسمح_باسم(&الحافة, الهوية)) {
            طابق وحدة_في_الرسم(الرسم, الحافة.الوحدة) مع
            | اختيار.بعض(المستوردة) -> {
                طابق ابحث_محليا_ببايتات_في_حيز(
                    سياق_الأسماء, المستوردة.النطاق_الجذري, الهوية, الحيز
                ) مع
                | اختيار.بعض(الرمز) -> {
                    طابق علنية_رمز_عند(سياق_الأسماء, الرمز) مع
                    | اختيار.بعض(علني) -> {
                        لو (علني) {
                            طابق المطابقة_العامة مع
                            | اختيار.لا_شيء -> { المطابقة_العامة := اختيار.بعض(الرمز); }
                            | اختيار.بعض(قديم) -> {
                                لو (!معرفا_رمز_متساويان(قديم, الرمز)) {
                                    أرجع نتيجة_حل_ظهور_اسم.غامض();
                                };
                            };
                        } وإلا { وجدت_خاصا := صواب; };
                    }
                    | اختيار.لا_شيء -> { };
                }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
            };
            ف := ف + 1;
        }
    };
    طابق المطابقة_العامة مع
    | اختيار.بعض(الرمز) -> { أرجع نتيجة_حل_ظهور_اسم.موجود(الرمز); }
    | اختيار.لا_شيء -> { };
    لو (وجدت_خاصا) { أرجع نتيجة_حل_ظهور_اسم.خاص(); };
    أرجع نتيجة_حل_ظهور_اسم.مفقود();
}

عام عرف تحقق_استيرادات_انتقائية(
    سياق_الأسماء: &سياق_أسماء,
    الرسم: &رسم_وحدات,
    من_الوحدة: معرف_وحدة
): نتيجة_تحقق_استيراد_انتقائي {
    // Package imports can span several constituent modules. Validate each selected
    // spelling through the same direct-import Name resolver used by source names.
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_استيرادات_الوحدة(الرسم, من_الوحدة)) {
        دع الحافة: حافة_استيراد_وحدة = حافة_استيراد_الوحدة_عند(الرسم, من_الوحدة, ف);
        طابق الحافة.السياسة مع
        | سياسة_استيراد_وحدة.كامل -> { }
        | سياسة_استيراد_وحدة.مسمى(_) -> { }
        | سياسة_استيراد_وحدة.انتقائي(الأسماء) -> {
            دع ن: متغير غير_موقع = 0;
            بينما (ن < (الطول(الأسماء) مثل غير_موقع)) {
                طابق حل_مستورد_مباشر_ببايتات_في_حيز(
                    سياق_الأسماء, الرسم, من_الوحدة, &الأسماء[ن].الهوية, حيز_اسم.الكل()
                ) مع
                | نتيجة_حل_ظهور_اسم.موجود(_) -> { }
                | نتيجة_حل_ظهور_اسم.خاص -> {
                    أرجع نتيجة_تحقق_استيراد_انتقائي.اسم_خاص(الأسماء[ن].النطاق);
                }
                | نتيجة_حل_ظهور_اسم.غامض -> {
                    أرجع نتيجة_تحقق_استيراد_انتقائي.اسم_غامض(الأسماء[ن].النطاق);
                }
                | نتيجة_حل_ظهور_اسم.مفقود -> {
                    أرجع نتيجة_تحقق_استيراد_انتقائي.اسم_مفقود(الأسماء[ن].النطاق);
                };
                ن := ن + 1;
            }
        };
        ف := ف + 1;
    }
    أرجع نتيجة_تحقق_استيراد_انتقائي.صالح();
}

عام عرف حل_ظهور_اسم_مرئي_ببايتات_في_حيز(
    سياق_الأسماء: &سياق_أسماء,
    الرسم: &رسم_وحدات,
    من_الوحدة: معرف_وحدة,
    البداية: معرف_نطاق,
    الهوية: &متجه غ8,
    الحيز: حيز_اسم
): نتيجة_حل_ظهور_اسم {
    طابق ابحث_من_ببايتات_في_حيز(سياق_الأسماء, البداية, الهوية, الحيز) مع
    | اختيار.بعض(الرمز) -> {
        أرجع نتيجة_حل_ظهور_اسم.موجود(الرمز);
    }
    | اختيار.لا_شيء -> { };

    طابق الحيز مع
    | حيز_اسم.الكل -> {
        طابق حل_رمز_بدائي_مباشر_ببايتات(سياق_الأسماء, الهوية) مع
        | اختيار.بعض(الرمز) -> { أرجع نتيجة_حل_ظهور_اسم.موجود(الرمز); }
        | اختيار.لا_شيء -> { };
    }
    | حيز_اسم.قيمة -> {
        طابق حل_رمز_بدائي_مباشر_ببايتات(سياق_الأسماء, الهوية) مع
        | اختيار.بعض(الرمز) -> { أرجع نتيجة_حل_ظهور_اسم.موجود(الرمز); }
        | اختيار.لا_شيء -> { };
    }
    | حيز_اسم.نوع -> { };

    أرجع حل_مستورد_مباشر_ببايتات_في_حيز(
        سياق_الأسماء, الرسم, من_الوحدة, الهوية, الحيز
    );
}
