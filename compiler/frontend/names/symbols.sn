استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;

عام نوع نوع_تصريح =
    | دالة
    | دالة_خارجية
    | مرادف_نوع
    | سجل
    | تعداد
    | منشئ_تعداد
    | معامل_نوع
    | معامل
    | ربط_محلي
;

// Name identity remains unified, but lookup is contextual: syntactic Type positions
// consume only type declarations while value positions consume callable/local/value declarations.
عام نوع حيز_اسم =
    | الكل
    | قيمة
    | نوع
;

عام عرف هل_نوع_تصريح_في_حيز(النوع: نوع_تصريح, الحيز: حيز_اسم): منطقي {
    طابق الحيز مع
    | حيز_اسم.الكل -> { أرجع صواب; }
    | حيز_اسم.نوع -> {
        طابق النوع مع
        | نوع_تصريح.مرادف_نوع -> { أرجع صواب; }
        | نوع_تصريح.سجل -> { أرجع صواب; }
        | نوع_تصريح.تعداد -> { أرجع صواب; }
        | نوع_تصريح.معامل_نوع -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | حيز_اسم.قيمة -> {
        طابق النوع مع
        | نوع_تصريح.مرادف_نوع -> { أرجع خطأ; }
        | نوع_تصريح.سجل -> { أرجع خطأ; }
        | نوع_تصريح.تعداد -> { أرجع خطأ; }
        | نوع_تصريح.معامل_نوع -> { أرجع خطأ; }
        | _ -> { أرجع صواب; };
    };
}

// الاسم المقنن يملك نسخة واحدة من بايتات الهوية داخل Name System.
عام نوع اسم_مقنن = {
    المعرف: معرف_اسم,
    البايتات: متجه غ8
};

// الرمز لا يملك مصدرا. يحتفظ بهوية الاسم وبنطاق الظهور الذي يتضمن معرف المصدر.
عام نوع رمز_دلالي = {
    المعرف: معرف_رمز,
    الاسم: معرف_اسم,
    نطاق_الاسم: نطاق,
    نطاق_التصريح: نطاق,
    النطاق_المالك: معرف_نطاق,
    المالك: اختيار معرف_رمز,
    النوع: نوع_تصريح,
    علني: منطقي
};

عام نوع نتيجة_إضافة =
    | أضيف بنوع معرف_رمز
    | مكرر بنوع (
        معرف_رمز,
        نطاق
    )
;
