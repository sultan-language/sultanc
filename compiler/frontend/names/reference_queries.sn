استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.name_context;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.identifier_identity;

// Read-only reference facts for refactoring tools. Everything here is a view
// over the canonical results a tooling Frontend request keeps: the AST trees,
// Name's resolved occurrences and its compact Symbol facts. Nothing is
// re-parsed or re-resolved, and nothing runs unless a tool calls it.

// What a resolved occurrence does with its Symbol. A write is an assignment
// or initialization of a place rooted at the name (`x := ..`, `x.f := ..`,
// `x[i] := ..`); a borrow is `&x` / `&mutable x` of such a place; a call is the
// callee name of a call. Moves are SSF facts and are added by the Frontend
// facade (compiler/frontend/tooling_queries.sn), which owns access to them.
عام نوع دور_مرجع =
    | تصريح
    | قراءة
    | كتابة
    | نقل
    | استعارة
    | استعارة_متغيرة
    | استدعاء
;

// A role met while walking the AST: the name span it applies to.
عام نوع حدث_دور_اسم = {
    النطاق: نطاق,
    الدور: دور_مرجع
};

// One reference of a Symbol. الاسم is the Name identity Name recorded for the
// occurrence; تهجئة_بديلة is set when the occurrence is spelled otherwise than
// the Symbol's declared name (an alias, a bilingual spelling of the same Symbol).
عام نوع مرجع_رمز_دلالي = {
    النطاق: نطاق,
    الاسم: معرف_اسم,
    الدور: دور_مرجع,
    تهجئة_بديلة: منطقي
};

عرف ألحق_حدث_دور(الأحداث: &متغير متجه حدث_دور_اسم, النطاق: نطاق, الدور: دور_مرجع): فراغ {
    دع الحدث: حدث_دور_اسم = { النطاق: النطاق, الدور: الدور };
    ألحق(*الأحداث, الحدث);
}

// The name a place expression is rooted at: `x`, `x.f`, `x[i]`, `x.f[i].g`.
// A place reached through a dereference is not rooted at a name.
عرف جذر_موضع_مرجع(التعبير: &تعبير): اختياري نطاق {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> { أرجع اختياري.موجود(الاسم.النطاق); }
    | تعبير.حقل(_, الأصل, _) -> { أرجع جذر_موضع_مرجع(&(*الأصل)); }
    | تعبير.فهرس(_, الأصل, _) -> { أرجع جذر_موضع_مرجع(&(*الأصل)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف اجمع_أدوار_تعبيرات(التعبيرات: &متجه تعبير, الأحداث: &متغير متجه حدث_دور_اسم): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التعبيرات) مثل طبيعي)) {
        اجمع_أدوار_تعبير(&(*التعبيرات)[ف], الأحداث);
        ف := ف + 1;
    }
}

عرف ألحق_دور_مستدعى(المستدعى: &تعبير, الأحداث: &متغير متجه حدث_دور_اسم): فراغ {
    طابق *المستدعى مع
    | تعبير.اسم(_, الاسم) -> { ألحق_حدث_دور(الأحداث, الاسم.النطاق, دور_مرجع.استدعاء()); }
    | تعبير.حجج_نوع(_, الداخل, _) -> { ألحق_دور_مستدعى(&(*الداخل), الأحداث); }
    | _ -> { };
}

عرف اجمع_أدوار_تعبير(التعبير: &تعبير, الأحداث: &متغير متجه حدث_دور_اسم): فراغ {
    طابق *التعبير مع
    | تعبير.حقل(_, الأصل, _) -> { اجمع_أدوار_تعبير(&(*الأصل), الأحداث); }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        اجمع_أدوار_تعبير(&(*الأصل), الأحداث);
        اجمع_أدوار_تعبير(&(*الفهرس), الأحداث);
    }
    | تعبير.فك_موضع(_, الداخل) -> { اجمع_أدوار_تعبير(&(*الداخل), الأحداث); }
    | تعبير.ثنائي(_, _, الأيسر, الأيمن) -> {
        اجمع_أدوار_تعبير(&(*الأيسر), الأحداث);
        اجمع_أدوار_تعبير(&(*الأيمن), الأحداث);
    }
    | تعبير.أحادي(_, العامل, الداخل) -> {
        إذا (العامل == عامل_أحادي.عنوان()) {
            طابق جذر_موضع_مرجع(&(*الداخل)) مع
            | اختياري.موجود(الجذر) -> { ألحق_حدث_دور(الأحداث, الجذر, دور_مرجع.استعارة()); }
            | اختياري.لا_شيء -> { };
        };
        إذا (العامل == عامل_أحادي.عنوان_متغير()) {
            طابق جذر_موضع_مرجع(&(*الداخل)) مع
            | اختياري.موجود(الجذر) -> { ألحق_حدث_دور(الأحداث, الجذر, دور_مرجع.استعارة_متغيرة()); }
            | اختياري.لا_شيء -> { };
        };
        اجمع_أدوار_تعبير(&(*الداخل), الأحداث);
    }
    | تعبير.استدعاء(_, المستدعى, الحجج) -> {
        ألحق_دور_مستدعى(&(*المستدعى), الأحداث);
        اجمع_أدوار_تعبير(&(*المستدعى), الأحداث);
        اجمع_أدوار_تعبيرات(&الحجج, الأحداث);
    }
    | تعبير.تحويل(_, الداخل, _) -> { اجمع_أدوار_تعبير(&(*الداخل), الأحداث); }
    | تعبير.وقت_الترجمة(_, الداخل) -> { اجمع_أدوار_تعبير(&(*الداخل), الأحداث); }
    | تعبير.تسلسل_وقت_الترجمة(_, العناصر) -> { اجمع_أدوار_تعبيرات(&العناصر, الأحداث); }
    | تعبير.إغلاق(_, _, _, الجسم) -> { اجمع_أدوار_تعبير(&(*الجسم), الأحداث); }
    | تعبير.حرفي_متجه(_, العناصر) -> { اجمع_أدوار_تعبيرات(&العناصر, الأحداث); }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            اجمع_أدوار_تعبير(&الحقول[ف].القيمة, الأحداث);
            ف := ف + 1;
        }
    }
    | تعبير.حجج_نوع(_, الداخل, _) -> { اجمع_أدوار_تعبير(&(*الداخل), الأحداث); }
    | _ -> { };
}

// The target of an assignment or initialization: its root is written, and the
// expressions inside it (indices) are read.
عرف اجمع_أدوار_هدف(الهدف: &تعبير, الأحداث: &متغير متجه حدث_دور_اسم): فراغ {
    طابق جذر_موضع_مرجع(الهدف) مع
    | اختياري.موجود(الجذر) -> { ألحق_حدث_دور(الأحداث, الجذر, دور_مرجع.كتابة()); }
    | اختياري.لا_شيء -> { };
    اجمع_أدوار_تعبير(الهدف, الأحداث);
}

عرف اجمع_أدوار_كتلة(الكتلة: &كتلة_عبارات, الأحداث: &متغير متجه حدث_دور_اسم): فراغ {
    دع العبارات: &متجه صندوق عبارة = &(*الكتلة).العبارات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العبارات) مثل طبيعي)) {
        اجمع_أدوار_عبارة(&(*(*العبارات)[ف]), الأحداث);
        ف := ف + 1;
    }
}

عرف اجمع_أدوار_عبارة(العبارة: &عبارة, الأحداث: &متغير متجه حدث_دور_اسم): فراغ {
    طابق *العبارة مع
    | عبارة.تهيئة_سجل(_, الهدف, الحقول) -> {
        اجمع_أدوار_هدف(&الهدف, الأحداث);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            اجمع_أدوار_تعبير(&الحقول[ف].القيمة, الأحداث);
            ف := ف + 1;
        }
    }
    | عبارة.تهيئة_صف(_, الهدف, القيم) -> {
        اجمع_أدوار_هدف(&الهدف, الأحداث);
        اجمع_أدوار_تعبيرات(&القيم, الأحداث);
    }
    | عبارة.تهيئة_متجه(_, الهدف, القيم) -> {
        اجمع_أدوار_هدف(&الهدف, الأحداث);
        اجمع_أدوار_تعبيرات(&القيم, الأحداث);
    }
    | عبارة.تهيئة_نص(_, الهدف, _) -> { اجمع_أدوار_هدف(&الهدف, الأحداث); }
    | عبارة.تهيئة_صندوق(_, الهدف, القيمة) -> {
        اجمع_أدوار_هدف(&الهدف, الأحداث);
        اجمع_أدوار_تعبير(&القيمة, الأحداث);
    }
    | عبارة.نسخ(_, الهدف, القيمة) -> {
        اجمع_أدوار_هدف(&الهدف, الأحداث);
        اجمع_أدوار_تعبير(&القيمة, الأحداث);
    }
    | عبارة.استدعاء(_, التعبير) -> { اجمع_أدوار_تعبير(&التعبير, الأحداث); }
    | عبارة.طالما(_, الشرط, الجسم) -> {
        اجمع_أدوار_تعبير(&الشرط, الأحداث);
        اجمع_أدوار_كتلة(&الجسم, الأحداث);
    }
    | عبارة.لكل(_, البداية, الشرط, الخطوة, الجسم) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البداية) مثل طبيعي)) {
            اجمع_أدوار_عبارة(&(*البداية[ف]), الأحداث);
            ف := ف + 1;
        }
        اجمع_أدوار_تعبير(&الشرط, الأحداث);
        اجمع_أدوار_عبارة(&(*الخطوة), الأحداث);
        اجمع_أدوار_كتلة(&الجسم, الأحداث);
    }
    | عبارة.إذا(_, الشرط, الأولى, الثانية) -> {
        اجمع_أدوار_تعبير(&الشرط, الأحداث);
        اجمع_أدوار_كتلة(&الأولى, الأحداث);
        طابق الثانية مع
        | اختياري.موجود(البديلة) -> { اجمع_أدوار_كتلة(&البديلة, الأحداث); }
        | اختياري.لا_شيء -> { };
    }
    | عبارة.طابق(_, المميز, الأذرع) -> {
        اجمع_أدوار_تعبير(&المميز, الأحداث);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأذرع) مثل طبيعي)) {
            اجمع_أدوار_كتلة(&الأذرع[ف].الجسم, الأحداث);
            ف := ف + 1;
        }
    }
    | عبارة.أرجع(_, القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(التعبير) -> { اجمع_أدوار_تعبير(&التعبير, الأحداث); }
        | اختياري.لا_شيء -> { };
    }
    | عبارة.غير_آمن(_, الجسم) -> { اجمع_أدوار_كتلة(&الجسم, الأحداث); }
    | عبارة.وقت_الترجمة(_, الجسم) -> { اجمع_أدوار_كتلة(&الجسم, الأحداث); }
    | عبارة.إسناد_وقت_الترجمة(_, الهدف, الجسم, الناتج) -> {
        اجمع_أدوار_هدف(&الهدف, الأحداث);
        اجمع_أدوار_كتلة(&الجسم, الأحداث);
        اجمع_أدوار_تعبير(&الناتج, الأحداث);
    }
    | _ -> { };
}

// Role events of one function declaration: alternate declared spellings are
// declarations; the body contributes writes, borrows and calls.
عام عرف اجمع_أدوار_دالة(الدالة: &تصريح_دالة, الأحداث: &متغير متجه حدث_دور_اسم): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).الأسماء_البديلة) مثل طبيعي)) {
        ألحق_حدث_دور(الأحداث, (*الدالة).الأسماء_البديلة[ف].النطاق, دور_مرجع.تصريح());
        ف := ف + 1;
    }
    طابق (*الدالة).الجسم مع
    | اختياري.موجود(الجسم) -> { اجمع_أدوار_كتلة(&الجسم, الأحداث); }
    | اختياري.لا_شيء -> { };
}

// Role events of a whole module tree, in source order of the walk.
عام عرف أحداث_أدوار_وحدة(الشجرة: &وحدة_مصدر): متجه حدث_دور_اسم {
    دع الأحداث: متغير متجه حدث_دور_اسم = [];
    دع العناصر: &متجه عنصر_وحدة = &(*الشجرة).العناصر;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        طابق (*العناصر)[ف] مع
        | عنصر_وحدة.دالة(التصريح) -> { اجمع_أدوار_دالة(&التصريح, &متغير الأحداث); }
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            طابق التصريح.التهيئة مع
            | تهيئة_قيمة_عليا.تعبير(التعبير) -> { اجمع_أدوار_تعبير(&التعبير, &متغير الأحداث); }
            | تهيئة_قيمة_عليا.متجه(القيم) -> { اجمع_أدوار_تعبيرات(&القيم, &متغير الأحداث); }
            | _ -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    // A standalone name alias (`عرف ب = أ;` forms) declares another spelling.
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*الشجرة).مرادفات_الأسماء) مثل طبيعي)) {
        ألحق_حدث_دور(&متغير الأحداث, (*الشجرة).مرادفات_الأسماء[م].الاسم.النطاق, دور_مرجع.تصريح());
        م := م + 1;
    }
    أرجع الأحداث;
}

// Precedence when several events name one span: declaration, write, mutable
// borrow, borrow, call.
عرف رتبة_دور_مرجع(الدور: دور_مرجع): طبيعي {
    طابق الدور مع
    | دور_مرجع.تصريح -> { أرجع 6; }
    | دور_مرجع.كتابة -> { أرجع 5; }
    | دور_مرجع.استعارة_متغيرة -> { أرجع 4; }
    | دور_مرجع.استعارة -> { أرجع 3; }
    | دور_مرجع.استدعاء -> { أرجع 2; }
    | دور_مرجع.نقل -> { أرجع 1; }
    | دور_مرجع.قراءة -> { أرجع 0; };
}

// The role of one resolved occurrence of الرمز, from the role events of its
// module. The declaration is the Symbol's own name span.
عام عرف دور_ظهور_رمز(
    الرمز: &رمز_دلالي,
    النطاق: نطاق,
    الأحداث: &متجه حدث_دور_اسم
): دور_مرجع {
    إذا (نطاقان_متساويان(النطاق, (*الرمز).نطاق_الاسم)) { أرجع دور_مرجع.تصريح(); };
    دع الأفضل: متغير دور_مرجع = دور_مرجع.قراءة();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأحداث) مثل طبيعي)) {
        دع الحدث: حدث_دور_اسم = (*الأحداث)[ف];
        إذا (نطاقان_متساويان(الحدث.النطاق, النطاق)
            && رتبة_دور_مرجع(الحدث.الدور) > رتبة_دور_مرجع(الأفضل)) {
            الأفضل := الحدث.الدور;
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}

عرف مرجع_مسجل_بنطاق(المراجع: &متجه مرجع_رمز_دلالي, النطاق: نطاق): منطقي {
    دع ف: متغير طبيعي = الطول(*المراجع) مثل طبيعي;
    // Duplicates of one occurrence are recorded next to each other.
    دع الحد: طبيعي = 4;
    دع ك: متغير طبيعي = 0;
    طالما (ف > 0 && ك < الحد) {
        ف := ف - 1;
        إذا (نطاقان_متساويان((*المراجع)[ف].النطاق, النطاق)) { أرجع صواب; };
        ك := ك + 1;
    }
    أرجع خطأ;
}

// The identifier identity spelled at a span of the SourceMap (empty when the
// span is not inside one source).
عام عرف هوية_مكتوبة_عند(الخريطة: &خريطة_مصادر, النطاق: نطاق): متجه ط8 {
    دع المصدر: طبيعي = النطاق.البداية.المصدر مثل طبيعي;
    إذا (المصدر >= (الطول((*الخريطة).المصادر) مثل طبيعي)
        || النطاق.النهاية.المصدر != النطاق.البداية.المصدر
        || النطاق.النهاية.البايت < النطاق.البداية.البايت) {
        دع فارغة: متجه ط8 = [];
        أرجع فارغة;
    };
    دع مرجع_المصدر: &مصدر = &(*الخريطة).المصادر[المصدر];
    إذا ((النطاق.النهاية.البايت مثل طبيعي) > (الطول((*مرجع_المصدر).المحتوى) مثل طبيعي)) {
        دع فارغة: متجه ط8 = [];
        أرجع فارغة;
    };
    أرجع انسخ_هوية_معرف_من_شريحة(
        &(*مرجع_المصدر).المحتوى, النطاق.البداية.البايت مثل طبيعي, النطاق.النهاية.البايت مثل طبيعي
    );
}

// Every reference of الرمز across the analysed modules, with its role. Trees
// and binding contexts are aligned by module position (Frontend result).
عام عرف مراجع_رمز_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    الوحدات: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    الخريطة: &خريطة_مصادر,
    الرمز: معرف_رمز
): متجه مرجع_رمز_دلالي {
    دع الناتج: متغير متجه مرجع_رمز_دلالي = [];
    دع الحقيقة: رمز_دلالي;
    طابق رمز_دلالي_عند_استعلام(السياق, الرمز) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(القيمة) -> { الحقيقة := القيمة; };
    // The identity of the declared name, as spelled at the declaration.
    دع الهوية_المصرحة: متجه ط8 = هوية_مكتوبة_عند(الخريطة, الحقيقة.نطاق_الاسم);
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الروابط) مثل طبيعي) && و < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الروابط: &سياق_روابط_أسماء = &(*الروابط)[و];
        دع الأحداث: متغير متجه حدث_دور_اسم = [];
        دع الأحداث_جاهزة: متغير منطقي = خطأ;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_الروابط).الظهورات) مثل طبيعي)) {
            دع الظهور: ظهور_اسم_محلول = (*مرجع_الروابط).الظهورات[ف];
            طابق الظهور.الرمز مع
            | اختياري.موجود(المعرف) -> {
                // A `let` name is recorded once as the declaration and once as
                // its initialization target: one reference per span.
                إذا (معرفا_رمز_متساويان(المعرف, الرمز) && !مرجع_مسجل_بنطاق(&الناتج, الظهور.النطاق)) {
                    إذا (!الأحداث_جاهزة) {
                        الأحداث := أحداث_أدوار_وحدة(&(*الوحدات)[و]);
                        الأحداث_جاهزة := صواب;
                    };
                    دع المكتوبة: متجه ط8 = هوية_مكتوبة_عند(الخريطة, الظهور.النطاق);
                    دع المرجع: مرجع_رمز_دلالي = {
                        النطاق: الظهور.النطاق,
                        الاسم: الظهور.الاسم,
                        الدور: دور_ظهور_رمز(&الحقيقة, الظهور.النطاق, &الأحداث),
                        تهجئة_بديلة: !هويتان_معرفيتان_متساويتان(&المكتوبة, &الهوية_المصرحة)
                    };
                    ألحق(الناتج, المرجع);
                };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    أرجع الناتج;
}

// ---- Other-target declarations ------------------------------------------------
// SultanC has no traits, interfaces or impl blocks. The one "same declaration,
// several implementations" relation it has is target-conditional code: a
// top-level declaration that other `if (target...)` branches declare again.
// The parser keeps the name spans of those left-out declarations
// (وحدة_مصدر.المستبعدة_للهدف); this returns the ones that spell the same
// identifier as the selected declaration's name.
عام عرف تصريحات_لأهداف_أخرى_في_وحدة(
    المصدر: &مصدر,
    الشجرة: &وحدة_مصدر,
    نطاق_الاسم: نطاق
): متجه نطاق {
    دع الناتج: متغير متجه نطاق = [];
    إذا ((نطاق_الاسم.البداية.المصدر مثل طبيعي) != (*المصدر).المعرف) { أرجع الناتج; };
    دع الطول_الكلي: طبيعي = الطول((*المصدر).المحتوى) مثل طبيعي;
    إذا ((نطاق_الاسم.النهاية.البايت مثل طبيعي) > الطول_الكلي) { أرجع الناتج; };
    دع الهوية: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى, نطاق_الاسم.البداية.البايت مثل طبيعي, نطاق_الاسم.النهاية.البايت مثل طبيعي
    );
    إذا ((الطول(الهوية) مثل طبيعي) == 0) { أرجع الناتج; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الشجرة).المستبعدة_للهدف) مثل طبيعي)) {
        دع المرشح: نطاق = (*الشجرة).المستبعدة_للهدف[ف];
        إذا ((المرشح.البداية.المصدر مثل طبيعي) == (*المصدر).المعرف
            && (المرشح.النهاية.البايت مثل طبيعي) <= الطول_الكلي) {
            دع هوية_المرشح: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
                &(*المصدر).المحتوى, المرشح.البداية.البايت مثل طبيعي, المرشح.النهاية.البايت مثل طبيعي
            );
            إذا (هويتان_معرفيتان_متساويتان(&هوية_المرشح, &الهوية)) { ألحق(الناتج, المرشح); };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// ---- Local initializers (inline variable) --------------------------------------
// `دع س: T = تعبير;` is the declaration statement followed by an initialization
// whose target is the same name occurrence. نطاق_التهيئة is the initializer
// expression for a plain value initialization; an aggregate literal
// initialization (record, tuple, vector, text, box) has none.
عام نوع تهيئة_ربط_محلي = {
    نطاق_التصريح: نطاق,
    نطاق_التهيئة: اختياري نطاق
};

عرف هدف_اسم_بنطاق(الهدف: &تعبير, نطاق_الاسم: نطاق): منطقي {
    طابق *الهدف مع
    | تعبير.اسم(_, الاسم) -> { أرجع نطاقان_متساويان(الاسم.النطاق, نطاق_الاسم); }
    | _ -> { أرجع خطأ; };
}

// What the statement after a declaration says about its initialization.
نوع تهيئة_تالية =
    | لا_تهيئة
    | قيمة بنوع نطاق
    | تركيب
;

عرف تهيئة_العبارة_التالية(العبارة: &عبارة, نطاق_الاسم: نطاق): تهيئة_تالية {
    طابق *العبارة مع
    | عبارة.نسخ(_, الهدف, القيمة) -> {
        إذا (هدف_اسم_بنطاق(&الهدف, نطاق_الاسم)) { أرجع تهيئة_تالية.قيمة(نطاق_تعبير(&القيمة)); };
    }
    | عبارة.تهيئة_سجل(_, الهدف, _) -> { إذا (هدف_اسم_بنطاق(&الهدف, نطاق_الاسم)) { أرجع تهيئة_تالية.تركيب(); }; }
    | عبارة.تهيئة_صف(_, الهدف, _) -> { إذا (هدف_اسم_بنطاق(&الهدف, نطاق_الاسم)) { أرجع تهيئة_تالية.تركيب(); }; }
    | عبارة.تهيئة_متجه(_, الهدف, _) -> { إذا (هدف_اسم_بنطاق(&الهدف, نطاق_الاسم)) { أرجع تهيئة_تالية.تركيب(); }; }
    | عبارة.تهيئة_نص(_, الهدف, _) -> { إذا (هدف_اسم_بنطاق(&الهدف, نطاق_الاسم)) { أرجع تهيئة_تالية.تركيب(); }; }
    | عبارة.تهيئة_صندوق(_, الهدف, _) -> { إذا (هدف_اسم_بنطاق(&الهدف, نطاق_الاسم)) { أرجع تهيئة_تالية.تركيب(); }; }
    | عبارة.إسناد_وقت_الترجمة(_, الهدف, _, _) -> { إذا (هدف_اسم_بنطاق(&الهدف, نطاق_الاسم)) { أرجع تهيئة_تالية.تركيب(); }; }
    | _ -> { };
    أرجع تهيئة_تالية.لا_تهيئة();
}

// The blocks a statement owns, searched in place (no block is copied).
عرف ابحث_تهيئة_في_أبناء_عبارة(العبارة: &عبارة, نطاق_الاسم: نطاق): اختياري تهيئة_ربط_محلي {
    طابق *العبارة مع
    | عبارة.طالما(_, _, الجسم) -> { أرجع ابحث_تهيئة_في_كتلة(&الجسم, نطاق_الاسم); }
    | عبارة.لكل(_, البداية, _, _, الجسم) -> {
        دع ف: متغير طبيعي = 0;
        دع العدد: طبيعي = الطول(البداية) مثل طبيعي;
        طالما (ف < العدد) {
            دع العبارة_الأولى: &عبارة = &(*البداية[ف]);
            طابق *العبارة_الأولى مع
            | عبارة.تصريح_متغير(س, الاسم, _) -> {
                إذا (نطاقان_متساويان(الاسم.النطاق, نطاق_الاسم)) {
                    دع التهيئة: متغير اختياري نطاق = اختياري.لا_شيء();
                    إذا (ف + 1 < العدد) {
                        طابق تهيئة_العبارة_التالية(&(*البداية[ف + 1]), نطاق_الاسم) مع
                        | تهيئة_تالية.قيمة(القيمة) -> { التهيئة := اختياري.موجود(القيمة); }
                        | _ -> { };
                    };
                    دع الناتج: تهيئة_ربط_محلي = { نطاق_التصريح: س, نطاق_التهيئة: التهيئة };
                    أرجع اختياري.موجود(الناتج);
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع ابحث_تهيئة_في_كتلة(&الجسم, نطاق_الاسم);
    }
    | عبارة.إذا(_, _, الأولى, الثانية) -> {
        طابق ابحث_تهيئة_في_كتلة(&الأولى, نطاق_الاسم) مع
        | اختياري.موجود(الناتج) -> { أرجع اختياري.موجود(الناتج); }
        | اختياري.لا_شيء -> { };
        طابق الثانية مع
        | اختياري.موجود(البديلة) -> { أرجع ابحث_تهيئة_في_كتلة(&البديلة, نطاق_الاسم); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | عبارة.طابق(_, _, الأذرع) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأذرع) مثل طبيعي)) {
            طابق ابحث_تهيئة_في_كتلة(&الأذرع[ف].الجسم, نطاق_الاسم) مع
            | اختياري.موجود(الناتج) -> { أرجع اختياري.موجود(الناتج); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | عبارة.غير_آمن(_, الجسم) -> { أرجع ابحث_تهيئة_في_كتلة(&الجسم, نطاق_الاسم); }
    | عبارة.وقت_الترجمة(_, الجسم) -> { أرجع ابحث_تهيئة_في_كتلة(&الجسم, نطاق_الاسم); }
    | عبارة.إسناد_وقت_الترجمة(_, _, الجسم, _) -> { أرجع ابحث_تهيئة_في_كتلة(&الجسم, نطاق_الاسم); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف ابحث_تهيئة_في_كتلة(الكتلة: &كتلة_عبارات, نطاق_الاسم: نطاق): اختياري تهيئة_ربط_محلي {
    دع العبارات: &متجه صندوق عبارة = &(*الكتلة).العبارات;
    دع العدد: طبيعي = الطول(*العبارات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع العبارة: &عبارة = &(*(*العبارات)[ف]);
        إذا (نطاق_يحتوي_نطاقا(نطاق_عبارة(العبارة), نطاق_الاسم)) {
            طابق *العبارة مع
            | عبارة.تصريح_متغير(س, الاسم, _) -> {
                إذا (نطاقان_متساويان(الاسم.النطاق, نطاق_الاسم)) {
                    دع التهيئة: متغير اختياري نطاق = اختياري.لا_شيء();
                    إذا (ف + 1 < العدد) {
                        طابق تهيئة_العبارة_التالية(&(*(*العبارات)[ف + 1]), نطاق_الاسم) مع
                        | تهيئة_تالية.قيمة(القيمة) -> { التهيئة := اختياري.موجود(القيمة); }
                        | _ -> { };
                    };
                    دع الناتج: تهيئة_ربط_محلي = { نطاق_التصريح: س, نطاق_التهيئة: التهيئة };
                    أرجع اختياري.موجود(الناتج);
                };
            }
            | _ -> { };
            طابق ابحث_تهيئة_في_أبناء_عبارة(العبارة, نطاق_الاسم) مع
            | اختياري.موجود(الناتج) -> { أرجع اختياري.موجود(الناتج); }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف تهيئة_ربط_محلي_في_وحدة(
    الشجرة: &وحدة_مصدر,
    نطاق_الاسم: نطاق
): اختياري تهيئة_ربط_محلي {
    دع العناصر: &متجه عنصر_وحدة = &(*الشجرة).العناصر;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        طابق (*العناصر)[ف] مع
        | عنصر_وحدة.دالة(التصريح) -> {
            إذا (نطاق_يحتوي_نطاقا(التصريح.النطاق, نطاق_الاسم)) {
                طابق التصريح.الجسم مع
                | اختياري.موجود(الجسم) -> { أرجع ابحث_تهيئة_في_كتلة(&الجسم, نطاق_الاسم); }
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}
