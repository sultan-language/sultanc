// Module owns the representation and canonical equality of Module IDs.
عام نوع معرف_وحدة = {
    القيمة: طبيعي
};

عام عرف معرف_وحدة_من(القيمة: طبيعي): معرف_وحدة {
    دع المعرف: معرف_وحدة = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرفا_وحدة_متساويان(أ: معرف_وحدة, ب: معرف_وحدة): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}
