استورد compiler.source.span;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.name_context;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.names.reference_queries;

// ---- Extract function -----------------------------------------------------------
// A read-only view for the "extract function" refactoring: a source range
// inside one function body, aligned to whole statements of one block, and the
// locals the extracted statements share with the rest of the function. Locals
// are the function's own parameters and local bindings (closure parameters
// included). Types, mutability and moves are attached by the Frontend facade
// (compiler/frontend/tooling_queries.sn) from the Type and SSF results.

عام نوع رفض_استخراج_دالة =
    | خارج_دالة
    | غير_محاذ_للعبارات
;

// In المدخلات: a local declared before the range and used inside it; its uses
// inside are الاستخدامات, and مستخدم_بعد tells whether the function uses it
// again after the range. In المخرجات: a local declared inside the range and
// used after it; الاستخدامات are those later uses.
عام نوع متغير_مستخرج = {
    الرمز: معرف_رمز,
    الاسم: معرف_اسم,
    النوع_المصرح: نوع_تصريح,
    مقروء: منطقي,
    مكتوب: منطقي,
    مستعار: منطقي,
    مستعار_متغيرا: منطقي,
    مستخدم_بعد: منطقي,
    الاستخدامات: متجه نطاق
};

// يحوي_إرجاع: a `return` inside the range. يحوي_قفزا_خارجيا: a `break` or
// `continue` whose loop is outside the range.
عام نوع تحليل_استخراج_دالة = {
    نطاق_الدالة: نطاق,
    نطاق_العبارات: نطاق,
    المدخلات: متجه متغير_مستخرج,
    المخرجات: متجه متغير_مستخرج,
    يحوي_إرجاع: منطقي,
    يحوي_قفزا_خارجيا: منطقي
};

عام نوع نتيجة_تحليل_استخراج_دالة =
    | جاهز بنوع تحليل_استخراج_دالة
    | مرفوض بنوع رفض_استخراج_دالة
;

نوع اختيار_عبارات = {
    النطاق: نطاق,
    إرجاع: منطقي,
    قفز: منطقي
};

نوع حالة_تدفق_مستخرج = {
    إرجاع: منطقي,
    قفز: منطقي
};

عرف افحص_تدفق_كتلة(الكتلة: &كتلة_عبارات, العمق: طبيعي, الحالة: &متغير حالة_تدفق_مستخرج): فراغ {
    دع العبارات: &متجه صندوق عبارة = &(*الكتلة).العبارات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العبارات) مثل طبيعي)) {
        افحص_تدفق_عبارة(&(*(*العبارات)[ف]), العمق, الحالة);
        ف := ف + 1;
    }
}

عرف افحص_تدفق_عبارة(العبارة: &عبارة, العمق: طبيعي, الحالة: &متغير حالة_تدفق_مستخرج): فراغ {
    طابق *العبارة مع
    | عبارة.أرجع(_, _) -> { (*الحالة).إرجاع := صواب; }
    | عبارة.اخرج_من_حلقة(_) -> { إذا (العمق == 0) { (*الحالة).قفز := صواب; }; }
    | عبارة.تابع_حلقة(_) -> { إذا (العمق == 0) { (*الحالة).قفز := صواب; }; }
    | عبارة.طالما(_, _, الجسم) -> { افحص_تدفق_كتلة(&الجسم, العمق + 1, الحالة); }
    | عبارة.لكل(_, _, _, _, الجسم) -> { افحص_تدفق_كتلة(&الجسم, العمق + 1, الحالة); }
    | عبارة.إذا(_, _, الأولى, الثانية) -> {
        افحص_تدفق_كتلة(&الأولى, العمق, الحالة);
        طابق الثانية مع
        | اختياري.موجود(البديلة) -> { افحص_تدفق_كتلة(&البديلة, العمق, الحالة); }
        | اختياري.لا_شيء -> { };
    }
    | عبارة.طابق(_, _, الأذرع) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأذرع) مثل طبيعي)) {
            افحص_تدفق_كتلة(&الأذرع[ف].الجسم, العمق, الحالة);
            ف := ف + 1;
        }
    }
    | عبارة.غير_آمن(_, الجسم) -> { افحص_تدفق_كتلة(&الجسم, العمق, الحالة); }
    | عبارة.وقت_الترجمة(_, الجسم) -> { افحص_تدفق_كتلة(&الجسم, العمق, الحالة); }
    | عبارة.إسناد_وقت_الترجمة(_, _, الجسم, _) -> { افحص_تدفق_كتلة(&الجسم, العمق, الحالة); }
    | _ -> { };
}

عرف اختر_في_كتلة_محتوية(الكتلة: &كتلة_عبارات, المدى: نطاق): اختياري اختيار_عبارات {
    إذا (!نطاق_يحتوي_نطاقا((*الكتلة).النطاق, المدى)) { أرجع اختياري.لا_شيء(); };
    أرجع اختر_عبارات_كتلة(الكتلة, المدى);
}

عرف اختر_في_أبناء_عبارة(العبارة: &عبارة, المدى: نطاق): اختياري اختيار_عبارات {
    طابق *العبارة مع
    | عبارة.طالما(_, _, الجسم) -> { أرجع اختر_في_كتلة_محتوية(&الجسم, المدى); }
    | عبارة.لكل(_, _, _, _, الجسم) -> { أرجع اختر_في_كتلة_محتوية(&الجسم, المدى); }
    | عبارة.إذا(_, _, الأولى, الثانية) -> {
        طابق اختر_في_كتلة_محتوية(&الأولى, المدى) مع
        | اختياري.موجود(الناتج) -> { أرجع اختياري.موجود(الناتج); }
        | اختياري.لا_شيء -> { };
        طابق الثانية مع
        | اختياري.موجود(البديلة) -> { أرجع اختر_في_كتلة_محتوية(&البديلة, المدى); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | عبارة.طابق(_, _, الأذرع) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأذرع) مثل طبيعي)) {
            طابق اختر_في_كتلة_محتوية(&الأذرع[ف].الجسم, المدى) مع
            | اختياري.موجود(الناتج) -> { أرجع اختياري.موجود(الناتج); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | عبارة.غير_آمن(_, الجسم) -> { أرجع اختر_في_كتلة_محتوية(&الجسم, المدى); }
    | عبارة.وقت_الترجمة(_, الجسم) -> { أرجع اختر_في_كتلة_محتوية(&الجسم, المدى); }
    | عبارة.إسناد_وقت_الترجمة(_, _, الجسم, _) -> { أرجع اختر_في_كتلة_محتوية(&الجسم, المدى); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The statements of the innermost block that the range covers whole. A range
// that cuts a statement is aligned only when it lies inside one block of that
// statement; otherwise it is not statement-aligned. (A `let` with an
// initializer is two AST statements with one span; they count as one.)
عرف اختر_عبارات_كتلة(الكتلة: &كتلة_عبارات, المدى: نطاق): اختياري اختيار_عبارات {
    دع العبارات: &متجه صندوق عبارة = &(*الكتلة).العبارات;
    دع العدد: طبيعي = الطول(*العبارات) مثل طبيعي;
    دع البداية: ط32 = المدى.البداية.البايت;
    دع النهاية: ط32 = المدى.النهاية.البايت;
    دع الأول: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع الأخير: متغير طبيعي = 0;
    دع كلها_داخل: متغير منطقي = صواب;
    دع نطاق_واحد: متغير منطقي = صواب;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع النطاق: نطاق = نطاق_عبارة(&(*(*العبارات)[ف]));
        إذا (النطاق.البداية.البايت < النهاية && النطاق.النهاية.البايت > البداية) {
            طابق الأول مع
            | اختياري.لا_شيء -> { الأول := اختياري.موجود(ف); }
            | اختياري.موجود(الموضع) -> {
                إذا (!نطاقان_متساويان(النطاق, نطاق_عبارة(&(*(*العبارات)[الموضع])))) { نطاق_واحد := خطأ; };
            };
            الأخير := ف;
            إذا (!((البداية <= النطاق.البداية.البايت) && (النطاق.النهاية.البايت <= النهاية))) { كلها_داخل := خطأ; };
        };
        ف := ف + 1;
    }
    دع أول_موضع: متغير طبيعي = 0;
    طابق الأول مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> { أول_موضع := الموضع; };
    إذا (!كلها_داخل) {
        إذا (!نطاق_واحد) { أرجع اختياري.لا_شيء(); };
        أرجع اختر_في_أبناء_عبارة(&(*(*العبارات)[أول_موضع]), المدى);
    };
    دع الحالة: متغير حالة_تدفق_مستخرج = { إرجاع: خطأ, قفز: خطأ };
    دع ك: متغير طبيعي = أول_موضع;
    طالما (ك <= الأخير) {
        افحص_تدفق_عبارة(&(*(*العبارات)[ك]), 0, &متغير الحالة);
        ك := ك + 1;
    }
    دع الناتج: اختيار_عبارات = {
        النطاق: دمج_نطاق(نطاق_عبارة(&(*(*العبارات)[أول_موضع])), نطاق_عبارة(&(*(*العبارات)[الأخير]))),
        إرجاع: الحالة.إرجاع,
        قفز: الحالة.قفز
    };
    أرجع اختياري.موجود(الناتج);
}

// One use of a local met while scanning the function's occurrences.
// القسم: 0 a use inside the range of a local declared before it, 1 a use after
// the range of a local declared inside it, 2 a use after the range of a local
// declared before it.
نوع استخدام_مستخرج = {
    الرمز: معرف_رمز,
    الاسم: معرف_اسم,
    النوع_المصرح: نوع_تصريح,
    النطاق: نطاق,
    الدور: دور_مرجع,
    القسم: طبيعي
};

عرف رمز_في_قائمة_مستخرجة(القائمة: &متجه معرف_رمز, الرمز: معرف_رمز): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*القائمة)[ف], الرمز)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Groups the uses of one section by Symbol, in order of first use. قسم_الحياة
// is the section whose uses make مستخدم_بعد true.
عرف جمع_متغيرات_مستخرجة(
    الاستخدامات: &متجه استخدام_مستخرج, القسم: طبيعي, قسم_الحياة: طبيعي
): متجه متغير_مستخرج {
    دع الناتج: متغير متجه متغير_مستخرج = [];
    دع المرئية: متغير متجه معرف_رمز = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاستخدامات) مثل طبيعي)) {
        دع الأول: استخدام_مستخرج = (*الاستخدامات)[ف];
        إذا (الأول.القسم == القسم && !رمز_في_قائمة_مستخرجة(&المرئية, الأول.الرمز)) {
            ألحق(المرئية, الأول.الرمز);
            دع مقروء: متغير منطقي = خطأ;
            دع مكتوب: متغير منطقي = خطأ;
            دع مستعار: متغير منطقي = خطأ;
            دع مستعار_متغيرا: متغير منطقي = خطأ;
            دع مستخدم_بعد: متغير منطقي = القسم == 1;
            دع النطاقات: متغير متجه نطاق = [];
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول(*الاستخدامات) مثل طبيعي)) {
                دع الاستخدام: استخدام_مستخرج = (*الاستخدامات)[ك];
                إذا (معرفا_رمز_متساويان(الاستخدام.الرمز, الأول.الرمز)) {
                    إذا (الاستخدام.القسم == قسم_الحياة) { مستخدم_بعد := صواب; };
                    إذا (الاستخدام.القسم == القسم) {
                        ألحق(النطاقات, الاستخدام.النطاق);
                        طابق الاستخدام.الدور مع
                        | دور_مرجع.كتابة -> { مكتوب := صواب; }
                        | دور_مرجع.استعارة -> { مستعار := صواب; }
                        | دور_مرجع.استعارة_متغيرة -> { مستعار_متغيرا := صواب; }
                        | _ -> { مقروء := صواب; };
                    };
                };
                ك := ك + 1;
            }
            دع المتغير: متغير_مستخرج = {
                الرمز: الأول.الرمز,
                الاسم: الأول.الاسم,
                النوع_المصرح: الأول.النوع_المصرح,
                مقروء: مقروء,
                مكتوب: مكتوب,
                مستعار: مستعار,
                مستعار_متغيرا: مستعار_متغيرا,
                مستخدم_بعد: مستخدم_بعد,
                الاستخدامات: النطاقات
            };
            ألحق(الناتج, المتغير);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف رمز_محلي_مستخرج(النوع: نوع_تصريح): منطقي {
    طابق النوع مع
    | نوع_تصريح.ربط_محلي -> { أرجع صواب; }
    | نوع_تصريح.معامل -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// المدى is a range of one source (the module tree's own). The function is the
// top-level function whose body contains it.
عام عرف حلل_استخراج_دالة_في_وحدة(
    السياق: &سياق_استعلامات_أسماء,
    الشجرة: &وحدة_مصدر,
    الروابط: &سياق_روابط_أسماء,
    المدى: نطاق
): نتيجة_تحليل_استخراج_دالة {
    دع العناصر: &متجه عنصر_وحدة = &(*الشجرة).العناصر;
    دع موجودة: متغير منطقي = خطأ;
    دع نطاق_الدالة: متغير نطاق = نطاق_فارغ();
    دع الاختيار: متغير اختياري اختيار_عبارات = اختياري.لا_شيء();
    دع الأحداث: متغير متجه حدث_دور_اسم = [];
    دع ف: متغير طبيعي = 0;
    طالما ((ف < (الطول(*العناصر) مثل طبيعي)) && !موجودة) {
        طابق (*العناصر)[ف] مع
        | عنصر_وحدة.دالة(التصريح) -> {
            طابق التصريح.الجسم مع
            | اختياري.موجود(الجسم) -> {
                إذا (نطاق_يحتوي_نطاقا(الجسم.النطاق, المدى)) {
                    موجودة := صواب;
                    نطاق_الدالة := التصريح.النطاق;
                    الاختيار := اختر_عبارات_كتلة(&الجسم, المدى);
                    اجمع_أدوار_دالة(&التصريح, &متغير الأحداث);
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    إذا (!موجودة) { أرجع نتيجة_تحليل_استخراج_دالة.مرفوض(رفض_استخراج_دالة.خارج_دالة()); };
    دع المختار: متغير اختيار_عبارات = { النطاق: نطاق_فارغ(), إرجاع: خطأ, قفز: خطأ };
    طابق الاختيار مع
    | اختياري.لا_شيء -> { أرجع نتيجة_تحليل_استخراج_دالة.مرفوض(رفض_استخراج_دالة.غير_محاذ_للعبارات()); }
    | اختياري.موجود(القيمة) -> { المختار := القيمة; };

    دع الاستخدامات: متغير متجه استخدام_مستخرج = [];
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*الروابط).الظهورات) مثل طبيعي)) {
        دع الظهور: ظهور_اسم_محلول = (*الروابط).الظهورات[م];
        طابق الظهور.الرمز مع
        | اختياري.موجود(المعرف) -> {
            إذا (نطاق_يحتوي_نطاقا(نطاق_الدالة, الظهور.النطاق)) {
                طابق رمز_دلالي_عند_استعلام(السياق, المعرف) مع
                | اختياري.موجود(الحقيقة) -> {
                    إذا (رمز_محلي_مستخرج(الحقيقة.النوع)
                        && نطاق_يحتوي_نطاقا(نطاق_الدالة, الحقيقة.نطاق_الاسم)
                        && !نطاقان_متساويان(الظهور.النطاق, الحقيقة.نطاق_الاسم)) {
                        دع مصرح_داخله: منطقي = نطاق_يحتوي_نطاقا(المختار.النطاق, الحقيقة.نطاق_الاسم);
                        دع داخله: منطقي = نطاق_يحتوي_نطاقا(المختار.النطاق, الظهور.النطاق);
                        دع بعده: منطقي = الظهور.النطاق.البداية.البايت >= المختار.النطاق.النهاية.البايت;
                        دع القسم: متغير طبيعي = 3;
                        إذا (داخله && !مصرح_داخله) { القسم := 0; };
                        إذا (بعده && مصرح_داخله) { القسم := 1; };
                        إذا (بعده && !مصرح_داخله) { القسم := 2; };
                        إذا (القسم < 3) {
                            دع الاستخدام: استخدام_مستخرج = {
                                الرمز: المعرف,
                                الاسم: الحقيقة.الاسم,
                                النوع_المصرح: الحقيقة.النوع,
                                النطاق: الظهور.النطاق,
                                الدور: دور_ظهور_رمز(&الحقيقة, الظهور.النطاق, &الأحداث),
                                القسم: القسم
                            };
                            ألحق(الاستخدامات, الاستخدام);
                        };
                    };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        م := م + 1;
    }
    دع التحليل: تحليل_استخراج_دالة = {
        نطاق_الدالة: نطاق_الدالة,
        نطاق_العبارات: المختار.النطاق,
        المدخلات: جمع_متغيرات_مستخرجة(&الاستخدامات, 0, 2),
        المخرجات: جمع_متغيرات_مستخرجة(&الاستخدامات, 1, 1),
        يحوي_إرجاع: المختار.إرجاع,
        يحوي_قفزا_خارجيا: المختار.قفز
    };
    أرجع نتيجة_تحليل_استخراج_دالة.جاهز(التحليل);
}
