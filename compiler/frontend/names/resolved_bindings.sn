استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.name_context;
استورد compiler.source.source_file;
استورد compiler.source.span;

// Name owns one canonical semantic fact per source-name occurrence.
// NameID is always present; SymbolID is present only for occurrences that resolve to a Symbol.
عام نوع ظهور_اسم_محلول = {
    النطاق: نطاق,
    الاسم: معرف_اسم,
    الرمز: اختياري معرف_رمز,
    // Authenticated only by the Name pass for the exact unbound الفارغ occurrence.
    مؤشر_فارغ_سياقي: منطقي
};

عام نوع مدخل_فهرس_ظهور_اسم = {
    الهاش: طبيعي,
    النطاق: نطاق,
    الموضع: طبيعي
};

// A deprecated spelling met while binding: the contextual Option type name
// (اختيار) or its constructor (بعض). The frontend warns once per such token
// (SULTANC-SYNTAX-DEPRECATED-SPELLING); keyword spellings warn after lexing.
عام نوع تهجئة_مهجورة_مربوطة = {
    النطاق: نطاق,
    القديمة: نص,
    الجديدة: نص
};

عام نوع سياق_روابط_أسماء = {
    الظهورات: متجه ظهور_اسم_محلول,
    فهرس_النطاقات: متجه اختياري مدخل_فهرس_ظهور_اسم,
    التهجئات_المهجورة: متجه تهجئة_مهجورة_مربوطة
};


عرف امزج_هاش_نطاق_اسم(الهاش: طبيعي, القيمة: طبيعي): طبيعي {
    أرجع ((الهاش * 257) + (القيمة % 1048573)) % 1048573;
}

عرف هاش_نطاق_اسم(النطاق: نطاق): طبيعي {
    دع الهاش: متغير طبيعي = امزج_هاش_نطاق_اسم(1, النطاق.البداية.المصدر);
    الهاش := امزج_هاش_نطاق_اسم(الهاش, النطاق.البداية.البايت);
    الهاش := امزج_هاش_نطاق_اسم(الهاش, النطاق.النهاية.المصدر);
    الهاش := امزج_هاش_نطاق_اسم(الهاش, النطاق.النهاية.البايت);
    أرجع الهاش;
}

عرف ابن_فهرس_نطاقات_أسماء_فارغا(السعة: طبيعي): متجه اختياري مدخل_فهرس_ظهور_اسم {
    دع الناتج: متغير متجه اختياري مدخل_فهرس_ظهور_اسم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الناتج, اختياري.لا_شيء()); ف := ف + 1; }
    أرجع الناتج;
}

عرف موضع_إدراج_فهرس_ظهور_اسم(
    الفهرس: &متجه اختياري مدخل_فهرس_ظهور_اسم,
    النطاق: نطاق
): اختياري طبيعي {
    دع السعة: طبيعي = الطول(*الفهرس) مثل طبيعي;
    لو (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_نطاق_اسم(النطاق);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        طابق (*الفهرس)[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(الموضع); }
        | اختياري.موجود(المدخل) -> {
            لو (المدخل.الهاش == الهاش && نطاقان_متساويان(المدخل.النطاق, النطاق)) {
                أرجع اختياري.موجود(الموضع);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أدرج_فهرس_ظهور_اسم(
    الفهرس: &متغير متجه اختياري مدخل_فهرس_ظهور_اسم,
    المدخل: مدخل_فهرس_ظهور_اسم
): فراغ {
    طابق موضع_إدراج_فهرس_ظهور_اسم(الفهرس, المدخل.النطاق) مع
    | اختياري.موجود(الموضع) -> {
        طابق (*الفهرس)[الموضع] مع
        | اختياري.لا_شيء -> { (*الفهرس)[الموضع] := اختياري.موجود(المدخل); }
        | اختياري.موجود(_) -> { };
    }
    | اختياري.لا_شيء -> { };
}

عرف سجل_فهرس_ظهور_اسم(
    السياق: &متغير سياق_روابط_أسماء,
    المدخل: مدخل_فهرس_ظهور_اسم
): فراغ {
    طابق موضع_إدراج_فهرس_ظهور_اسم(&(*السياق).فهرس_النطاقات, المدخل.النطاق) مع
    | اختياري.موجود(الموضع) -> {
        طابق (*السياق).فهرس_النطاقات[الموضع] مع
        | اختياري.لا_شيء -> { (*السياق).فهرس_النطاقات[الموضع] := اختياري.موجود(المدخل); }
        | اختياري.موجود(_) -> { };
    }
    | اختياري.لا_شيء -> { };
}

عرف تأكد_سعة_فهرس_ظهور_اسم(السياق: &متغير سياق_روابط_أسماء): فراغ {
    دع العدد: طبيعي = الطول((*السياق).الظهورات) مثل طبيعي;
    دع القديمة: طبيعي = الطول((*السياق).فهرس_النطاقات) مثل طبيعي;
    دع تحتاج: متغير منطقي = القديمة == 0;
    لو (!تحتاج) { تحتاج := (العدد * 3) >= (القديمة * 2); };
    لو (!تحتاج) { أرجع; };
    دع الجديدة: متغير طبيعي = 16;
    لو (القديمة > 0) { الجديدة := القديمة * 2; };
    دع الفهرس_الجديد: متغير متجه اختياري مدخل_فهرس_ظهور_اسم =
        ابن_فهرس_نطاقات_أسماء_فارغا(الجديدة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < القديمة) {
        طابق (*السياق).فهرس_النطاقات[ف] مع
        | اختياري.موجود(المدخل) -> { أدرج_فهرس_ظهور_اسم(&متغير الفهرس_الجديد, المدخل); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    (*السياق).فهرس_النطاقات := الفهرس_الجديد;
}

عرف موضع_ظهور_اسم_مفهرس(
    السياق: &سياق_روابط_أسماء,
    النطاق: نطاق
): اختياري طبيعي {
    دع السعة: طبيعي = الطول((*السياق).فهرس_النطاقات) مثل طبيعي;
    لو (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_نطاق_اسم(النطاق);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        طابق (*السياق).فهرس_النطاقات[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المدخل) -> {
            لو (المدخل.الهاش == الهاش && نطاقان_متساويان(المدخل.النطاق, النطاق)) {
                أرجع اختياري.موجود(المدخل.الموضع);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف سياق_روابط_أسماء_جديد(): سياق_روابط_أسماء {
    دع الظهورات: متجه ظهور_اسم_محلول = [];
    دع الفهرس: متجه اختياري مدخل_فهرس_ظهور_اسم = [];
    دع المهجورة: متجه تهجئة_مهجورة_مربوطة = [];
    دع السياق: سياق_روابط_أسماء = {
        الظهورات: الظهورات, فهرس_النطاقات: الفهرس, التهجئات_المهجورة: المهجورة
    };
    أرجع السياق;
}

عام عرف سجل_تهجئة_مهجورة(
    السياق: &متغير سياق_روابط_أسماء,
    النطاق: نطاق,
    القديمة: نص,
    الجديدة: نص
): فراغ {
    دع المدخل: تهجئة_مهجورة_مربوطة = { النطاق: النطاق, القديمة: القديمة, الجديدة: الجديدة };
    ألحق((*السياق).التهجئات_المهجورة, المدخل);
}

// Name-only occurrences include record-field identities and compiler-known tagged names.
عام عرف أضف_هوية_اسم_محلولة(
    السياق: &متغير سياق_روابط_أسماء,
    النطاق: نطاق,
    الاسم: معرف_اسم
): منطقي {
    دع بدون_رمز: اختياري معرف_رمز = اختياري.لا_شيء();
    دع الظهور: ظهور_اسم_محلول = {
        النطاق: النطاق,
        الاسم: الاسم,
        الرمز: بدون_رمز,
        مؤشر_فارغ_سياقي: خطأ
    };
    دع الموضع: طبيعي = الطول((*السياق).الظهورات) مثل طبيعي;
    ألحق((*السياق).الظهورات, الظهور);
    تأكد_سعة_فهرس_ظهور_اسم(السياق);
    دع الهاش: طبيعي = هاش_نطاق_اسم(النطاق);
    دع المدخل: مدخل_فهرس_ظهور_اسم = {
        الهاش: الهاش,
        النطاق: النطاق,
        الموضع: الموضع
    };
    سجل_فهرس_ظهور_اسم(السياق, المدخل);
    أرجع صواب;
}

// Resolved Symbol occurrences are stored once with both canonical identities.
عام عرف أضف_ظهور_اسم_محلول(
    السياق: &متغير سياق_روابط_أسماء,
    النطاق: نطاق,
    الاسم: معرف_اسم,
    الرمز: معرف_رمز
): منطقي {
    دع رمز_محلول: اختياري معرف_رمز = اختياري.موجود(الرمز);
    دع الظهور: ظهور_اسم_محلول = {
        النطاق: النطاق,
        الاسم: الاسم,
        الرمز: رمز_محلول,
        مؤشر_فارغ_سياقي: خطأ
    };
    دع الموضع: طبيعي = الطول((*السياق).الظهورات) مثل طبيعي;
    ألحق((*السياق).الظهورات, الظهور);
    تأكد_سعة_فهرس_ظهور_اسم(السياق);
    دع الهاش: طبيعي = هاش_نطاق_اسم(النطاق);
    دع المدخل: مدخل_فهرس_ظهور_اسم = {
        الهاش: الهاش,
        النطاق: النطاق,
        الموضع: الموضع
    };
    سجل_فهرس_ظهور_اسم(السياق, المدخل);
    أرجع صواب;
}

// Source occurrence -> canonical Name identity. Callers hand Name the exact AST occurrence span;
// later layers read the ID and never reconstruct field identity from text.
عام عرف قنن_واربط_ظهور_اسم(
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    النطاق: نطاق
): معرف_اسم {
    دع الاسم: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, النطاق);
    أضف_هوية_اسم_محلولة(الروابط, النطاق, الاسم);
    أرجع الاسم;
}

// Canonical named-constructor occurrence binding. The constructor declaration is already
// a Name-owned child Symbol of its enum; no constructor tag or payload Type is computed here.
عام عرف حل_واربط_منشئ_مسمى(
    سياق_الأسماء: &متغير سياق_أسماء,
    الروابط: &متغير سياق_روابط_أسماء,
    المصدر: &مصدر,
    نطاق_المنشئ: نطاق,
    رمز_النوع: معرف_رمز
): اختياري معرف_رمز {
    دع اسم_المنشئ: معرف_اسم = قنن_اسما_مصدريا(
        سياق_الأسماء, المصدر, نطاق_المنشئ
    );
    طابق ابحث_رمزا_تابعا_بهوية(سياق_الأسماء, رمز_النوع, اسم_المنشئ) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الرمز) -> {
        طابق نوع_رمز_عند(سياق_الأسماء, الرمز) مع
        | اختياري.موجود(النوع) -> {
            لو (النوع == نوع_تصريح.منشئ_تعداد()) {
                لو (أضف_ظهور_اسم_محلول(
                    الروابط, نطاق_المنشئ, اسم_المنشئ, الرمز
                )) {
                    أرجع اختياري.موجود(الرمز);
                };
            };
        }
        | اختياري.لا_شيء -> { };
        أرجع اختياري.لا_شيء();
    };
}

عام عرف ظهور_اسم_محلول_عند(
    السياق: &سياق_روابط_أسماء,
    النطاق: نطاق
): اختياري ظهور_اسم_محلول {
    طابق موضع_ظهور_اسم_مفهرس(السياق, النطاق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        لو (الموضع >= (الطول((*السياق).الظهورات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود((*السياق).الظهورات[الموضع]);
    };
}

عام عرف رمز_اسم_محلول_عند(
    السياق: &سياق_روابط_أسماء,
    النطاق: نطاق
): اختياري معرف_رمز {
    طابق ظهور_اسم_محلول_عند(السياق, النطاق) مع
    | اختياري.موجود(الظهور) -> { أرجع الظهور.الرمز; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// Mark the exact previously interned, unbound Name occurrence. This is a
// semantic authentication fact, not an alternative representation of null.
عام عرف وسم_ظهور_مؤشر_فارغ_سياقي(
    السياق: &متغير سياق_روابط_أسماء, النطاق: نطاق
): منطقي {
    طابق موضع_ظهور_اسم_مفهرس(السياق, النطاق) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الموضع) -> {
        لو (الموضع >= (الطول((*السياق).الظهورات) مثل طبيعي)) { أرجع خطأ; };
        طابق (*السياق).الظهورات[الموضع].الرمز مع
        | اختياري.موجود(_) -> { أرجع خطأ; }
        | اختياري.لا_شيء -> {
            (*السياق).الظهورات[الموضع].مؤشر_فارغ_سياقي := صواب;
            أرجع صواب;
        };
    };
}

// MSIR and Type consume this same Name-authenticated occurrence fact.
عام عرف هل_ظهور_مؤشر_فارغ_سياقي(
    السياق: &سياق_روابط_أسماء, النطاق: نطاق
): منطقي {
    طابق ظهور_اسم_محلول_عند(السياق, النطاق) مع
    | اختياري.موجود(الظهور) -> {
        طابق الظهور.الرمز مع
        | اختياري.موجود(_) -> { أرجع خطأ; }
        | اختياري.لا_شيء -> { أرجع الظهور.مؤشر_فارغ_سياقي; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام عرف معرف_اسم_محلول_عند(
    السياق: &سياق_روابط_أسماء,
    النطاق: نطاق
): اختياري معرف_اسم {
    طابق ظهور_اسم_محلول_عند(السياق, النطاق) مع
    | اختياري.موجود(الظهور) -> { أرجع اختياري.موجود(الظهور.الاسم); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// Canonical Name point query for tooling and other compiler consumers.
// If facts overlap, the narrowest source occurrence wins. For an identical span,
// prefer the resolved Symbol occurrence over a Name-only occurrence.
عام عرف ظهور_اسم_محلول_عند_بايت(
    السياق: &سياق_روابط_أسماء,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري ظهور_اسم_محلول {
    دع الأفضل: متغير اختياري ظهور_اسم_محلول = اختياري.لا_شيء();
    دع أفضل_طول: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الظهورات) مثل طبيعي)) {
        دع الظهور: ظهور_اسم_محلول = (*السياق).الظهورات[ف];
        لو (نطاق_يحتوي_بايتا(الظهور.النطاق, المصدر, البايت)) {
            دع طول_الحالي: طبيعي = طول_نطاق_بالبايت(الظهور.النطاق);
            دع اختر: متغير منطقي = خطأ;
            طابق الأفضل مع
            | اختياري.لا_شيء -> { اختر := صواب; }
            | اختياري.موجود(السابق) -> {
                لو (طول_الحالي < أفضل_طول) {
                    اختر := صواب;
                } وإلا لو (طول_الحالي == أفضل_طول && نطاقان_متساويان(الظهور.النطاق, السابق.النطاق)) {
                    طابق السابق.الرمز مع
                    | اختياري.لا_شيء -> {
                        طابق الظهور.الرمز مع
                        | اختياري.موجود(_) -> { اختر := صواب; }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.موجود(_) -> { };
                };
            };
            لو (اختر) {
                الأفضل := اختياري.موجود(الظهور);
                أفضل_طول := طول_الحالي;
            };
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}

عام عرف رمز_اسم_محلول_عند_بايت(
    السياق: &سياق_روابط_أسماء,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري معرف_رمز {
    طابق ظهور_اسم_محلول_عند_بايت(السياق, المصدر, البايت) مع
    | اختياري.موجود(الظهور) -> { أرجع الظهور.الرمز; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}
