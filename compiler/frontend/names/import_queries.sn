استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.scopes;
استورد compiler.frontend.names.name_context;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.identifier_identity;

// ---- Import relations -------------------------------------------------------------
// The module graph dies at the Frontend boundary. A tooling request keeps its
// direct import edges in this light form: two module identities, the import
// statement and the spans of the alias and selected names. No AST node and no
// second graph is kept; the edges are read once from the canonical graph.

عام نوع صنف_استيراد_وحدة =
    | كامل
    | مسمى
    | انتقائي
;

// نطاق_العبارة: the import statement in the importing source. نطاق_المرادف:
// the `as` name of an aliased import. الأسماء_الانتقائية: the selected names of
// a selective import. يعيد_التصدير: the imported module is a C import module
// whose public names include those of the C modules it imports plainly.
عام نوع علاقة_استيراد_وحدة = {
    المستورد: معرف_وحدة,
    المستورد_منه: معرف_وحدة,
    مصدر_المستورد: طبيعي,
    مصدر_المستورد_منه: طبيعي,
    الصنف: صنف_استيراد_وحدة,
    نطاق_العبارة: اختياري نطاق,
    نطاق_المرادف: اختياري نطاق,
    الأسماء_الانتقائية: متجه نطاق,
    يعيد_التصدير: منطقي
};

عرف نطاق_عبارة_استيراد(الاستيراد: &استيراد): نطاق {
    طابق *الاستيراد مع
    | استيراد.اسم(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.نص(النطاق, _, _) -> { أرجع النطاق; }
    | استيراد.انتقائي(النطاق, _, _) -> { أرجع النطاق; };
}

عرف استيراد_انتقائي_نحويا(الاستيراد: &استيراد): منطقي {
    طابق *الاستيراد مع
    | استيراد.انتقائي(_, _, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف موضع_شجرة_مصدر(الأشجار: &متجه وحدة_مصدر, المصدر: طبيعي): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأشجار) مثل طبيعي)) {
        إذا ((*الأشجار)[ف].معرف_المصدر == المصدر) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف مصدر_وحدة_دلالية(الوحدات: &متجه وحدة_دلالية, الوحدة: معرف_وحدة): طبيعي {
    إذا ((الوحدة.القيمة مثل طبيعي) < (الطول(*الوحدات) مثل طبيعي)) {
        أرجع (*الوحدات)[الوحدة.القيمة].معرف_المصدر;
    };
    أرجع 0;
}

عرف نطاق_في_قائمة_استيراد(القائمة: &متجه نطاق, النطاق: نطاق): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (نطاقان_متساويان((*القائمة)[ف], النطاق)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The graph's edges of every module, matched to the import statements of its
// tree. The loader adds edges statement by statement: one edge for a plain or
// aliased import, one or more for a selective import (one per module of a
// package), whose selected names lie inside that statement. A statement a
// tooling request could not load (الفاشلة, its statement span) has no edge.
عام عرف استخلص_علاقات_استيراد(
    الرسم: &رسم_وحدات,
    الأشجار: &متجه وحدة_مصدر,
    الفاشلة: &متجه نطاق
): متجه علاقة_استيراد_وحدة {
    دع الناتج: متغير متجه علاقة_استيراد_وحدة = [];
    دع الوحدات: متجه وحدة_دلالية = الوحدات_الدلالية_للرسم(الرسم);
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(الوحدات) مثل طبيعي)) {
        دع المستورد: معرف_وحدة = الوحدات[م].المعرف;
        دع مصدر_المستورد: طبيعي = الوحدات[م].معرف_المصدر;
        دع عدد_الحواف: طبيعي = عدد_استيرادات_الوحدة(الرسم, المستورد);
        دع موضع_الشجرة: اختياري طبيعي = موضع_شجرة_مصدر(الأشجار, مصدر_المستورد);
        دع العبارة: متغير طبيعي = 0;
        دع ح: متغير طبيعي = 0;
        طالما (ح < عدد_الحواف) {
            دع الحافة: حافة_استيراد_وحدة = حافة_استيراد_الوحدة_عند(الرسم, المستورد, ح);
            دع نطاق_العبارة: متغير اختياري نطاق = اختياري.لا_شيء();
            دع نطاق_المرادف: متغير اختياري نطاق = اختياري.لا_شيء();
            دع الأسماء: متغير متجه نطاق = [];
            دع الصنف: متغير صنف_استيراد_وحدة = صنف_استيراد_وحدة.كامل();
            طابق الحافة.السياسة مع
            | سياسة_استيراد_وحدة.كامل -> { }
            | سياسة_استيراد_وحدة.مسمى(المرادف) -> {
                الصنف := صنف_استيراد_وحدة.مسمى();
                نطاق_المرادف := اختياري.موجود(المرادف.النطاق);
            }
            | سياسة_استيراد_وحدة.انتقائي(المحددة) -> {
                الصنف := صنف_استيراد_وحدة.انتقائي();
                دع ك: متغير طبيعي = 0;
                طالما (ك < (الطول(المحددة) مثل طبيعي)) {
                    ألحق(الأسماء, المحددة[ك].النطاق);
                    ك := ك + 1;
                }
            };
            طابق موضع_الشجرة مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(ش) -> {
                دع الاستيرادات: &متجه استيراد = &(*الأشجار)[ش].الاستيرادات;
                دع انتقائية: منطقي = الصنف == صنف_استيراد_وحدة.انتقائي();
                // A further edge of the previous selective statement stays on it.
                إذا (انتقائية && العبارة > 0 && (الطول(الأسماء) مثل طبيعي) > 0) {
                    دع السابقة: نطاق = نطاق_عبارة_استيراد(&(*الاستيرادات)[العبارة - 1]);
                    إذا (استيراد_انتقائي_نحويا(&(*الاستيرادات)[العبارة - 1])
                        && نطاق_يحتوي_نطاقا(السابقة, الأسماء[0])) {
                        نطاق_العبارة := اختياري.موجود(السابقة);
                    };
                };
                طابق نطاق_العبارة مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> {
                    طالما (العبارة < (الطول(*الاستيرادات) مثل طبيعي)
                        && نطاق_في_قائمة_استيراد(الفاشلة, نطاق_عبارة_استيراد(&(*الاستيرادات)[العبارة]))) {
                        العبارة := العبارة + 1;
                    }
                    إذا (العبارة < (الطول(*الاستيرادات) مثل طبيعي)
                        && استيراد_انتقائي_نحويا(&(*الاستيرادات)[العبارة]) == انتقائية) {
                        نطاق_العبارة := اختياري.موجود(نطاق_عبارة_استيراد(&(*الاستيرادات)[العبارة]));
                        العبارة := العبارة + 1;
                    };
                };
            };
            دع العلاقة: علاقة_استيراد_وحدة = {
                المستورد: المستورد,
                المستورد_منه: الحافة.الوحدة,
                مصدر_المستورد: مصدر_المستورد,
                مصدر_المستورد_منه: مصدر_وحدة_دلالية(&الوحدات, الحافة.الوحدة),
                الصنف: الصنف,
                نطاق_العبارة: نطاق_العبارة,
                نطاق_المرادف: نطاق_المرادف,
                الأسماء_الانتقائية: الأسماء,
                يعيد_التصدير: وحدة_سي_في_الرسم(الرسم, الحافة.الوحدة)
            };
            ألحق(الناتج, العلاقة);
            ح := ح + 1;
        }
        م := م + 1;
    }
    أرجع الناتج;
}

// Kept only for tooling requests; a compilation keeps no import relations.
عام عرف علاقات_استيراد_للأدوات(
    الرسم: &رسم_وحدات,
    الأشجار: &متجه وحدة_مصدر,
    احتفظ_بحقائق_الأدوات: منطقي,
    الفاشلة: &متجه نطاق
): متجه علاقة_استيراد_وحدة {
    إذا (!احتفظ_بحقائق_الأدوات) {
        دع فارغة: متجه علاقة_استيراد_وحدة = [];
        أرجع فارغة;
    };
    أرجع استخلص_علاقات_استيراد(الرسم, الأشجار, الفاشلة);
}

// ---- Unused imports ---------------------------------------------------------------
// An import is used when a name occurrence of the importing module resolves to
// a Symbol the imported module provides: one it binds at module level
// (declared there, or an alias it declares) or one declared in it, and, for a
// C import module that re-exports, the same of the modules it imports plainly.
// A Symbol reached through two imports counts for both, so an import is never
// reported unused while it may be needed. A second import of the same module
// in the same form is a duplicate. A selective import whose statement is used
// can still select names nothing uses.

عام نوع استيراد_غير_مستخدم = {
    العلاقة: طبيعي,
    نطاق_العبارة: اختياري نطاق,
    مصدر_المستورد_منه: طبيعي,
    غير_مستخدم: منطقي,
    مكرر: منطقي,
    الأسماء_غير_المستخدمة: متجه نطاق
};

عرف وحدة_نطاق_للاستيراد(السياق: &سياق_استعلامات_أسماء, النطاق: معرف_نطاق): اختياري طبيعي {
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*السياق).النطاقات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*السياق).النطاقات[النطاق.القيمة].الوحدة.القيمة مثل طبيعي);
}

// The modules an import of الوحدة provides Symbols of: itself, and through
// re-exporting C modules the modules they import plainly.
عرف وحدات_مقدمة_باستيراد(
    العلاقات: &متجه علاقة_استيراد_وحدة,
    الوحدة: معرف_وحدة,
    يعيد_التصدير: منطقي
): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [الوحدة.القيمة مثل طبيعي];
    إذا (!يعيد_التصدير) { أرجع الناتج; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الناتج) مثل طبيعي)) {
        دع الحالية: طبيعي = الناتج[ف];
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(*العلاقات) مثل طبيعي)) {
            دع العلاقة: &علاقة_استيراد_وحدة = &(*العلاقات)[ك];
            إذا (((*العلاقة).المستورد.القيمة مثل طبيعي) == الحالية
                && (*العلاقة).الصنف == صنف_استيراد_وحدة.كامل()
                && (*العلاقة).يعيد_التصدير) {
                دع التالية: طبيعي = (*العلاقة).المستورد_منه.القيمة مثل طبيعي;
                دع موجودة: متغير منطقي = خطأ;
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(الناتج) مثل طبيعي)) {
                    إذا (الناتج[م] == التالية) { موجودة := صواب; };
                    م := م + 1;
                }
                إذا (!موجودة) { ألحق(الناتج, التالية); };
            };
            ك := ك + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف قائمة_تحوي_طبيعيا(القائمة: &متجه طبيعي, القيمة: طبيعي): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا ((*القائمة)[ف] == القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف بايتات_متساوية_استيراد(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Whether a module provides a used Symbol, optionally only under the name
// identity الهوية (a selected name).
عرف وحدات_تقدم_مستخدما(
    السياق: &سياق_استعلامات_أسماء,
    الوحدات_الدلالية: &متجه وحدة_دلالية,
    المقدمة: &متجه طبيعي,
    الرموز_المستخدمة: &متجه منطقي,
    الوحدات_المستخدمة: &متجه منطقي,
    بهوية: منطقي,
    الهوية: &متجه ط8
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المقدمة) مثل طبيعي)) {
        دع الوحدة: طبيعي = (*المقدمة)[ف];
        إذا (!بهوية && الوحدة < (الطول(*الوحدات_المستخدمة) مثل طبيعي) && (*الوحدات_المستخدمة)[الوحدة]) {
            أرجع صواب;
        };
        إذا (الوحدة < (الطول(*الوحدات_الدلالية) مثل طبيعي)) {
            دع الجذر: معرف_نطاق = (*الوحدات_الدلالية)[الوحدة].النطاق_الجذري;
            إذا ((الجذر.القيمة مثل طبيعي) < (الطول((*السياق).النطاقات) مثل طبيعي)) {
                دع مرجع_النطاق: &نطاق_أسماء = &(*السياق).النطاقات[الجذر.القيمة];
                دع ك: متغير طبيعي = 0;
                طالما (ك < (الطول((*مرجع_النطاق).الروابط) مثل طبيعي)) {
                    دع الربط: ربط_اسم_نطاق = (*مرجع_النطاق).الروابط[ك];
                    إذا ((الربط.الرمز.القيمة مثل طبيعي) < (الطول(*الرموز_المستخدمة) مثل طبيعي)
                        && (*الرموز_المستخدمة)[الربط.الرمز.القيمة]) {
                        إذا (!بهوية) { أرجع صواب; };
                        إذا ((الربط.الاسم.القيمة مثل طبيعي) < (الطول((*السياق).الأسماء) مثل طبيعي)
                            && بايتات_متساوية_استيراد(&(*السياق).الأسماء[الربط.الاسم.القيمة].البايتات, الهوية)) {
                            أرجع صواب;
                        };
                    };
                    ك := ك + 1;
                }
            };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The unused and duplicate imports of the module of source المصدر. الروابط is
// that module's binding context and المحتوى its source text.
عام عرف استيرادات_غير_مستخدمة_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    الوحدات_الدلالية: &متجه وحدة_دلالية,
    العلاقات: &متجه علاقة_استيراد_وحدة,
    الروابط: &سياق_روابط_أسماء,
    المصدر: &مصدر
): متجه استيراد_غير_مستخدم {
    دع الناتج: متغير متجه استيراد_غير_مستخدم = [];
    دع الرموز_المستخدمة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الرموز) مثل طبيعي)) { ألحق(الرموز_المستخدمة, خطأ); ف := ف + 1; }
    دع الوحدات_المستخدمة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < (الطول(*الوحدات_الدلالية) مثل طبيعي)) { ألحق(الوحدات_المستخدمة, خطأ); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*الروابط).الظهورات) مثل طبيعي)) {
        طابق (*الروابط).الظهورات[ف].الرمز مع
        | اختياري.موجود(الرمز) -> {
            إذا ((الرمز.القيمة مثل طبيعي) < (الطول(الرموز_المستخدمة) مثل طبيعي)) {
                الرموز_المستخدمة[الرمز.القيمة] := صواب;
                طابق وحدة_نطاق_للاستيراد(السياق, (*السياق).الرموز[الرمز.القيمة].النطاق_المالك) مع
                | اختياري.موجود(الوحدة) -> {
                    إذا (الوحدة < (الطول(الوحدات_المستخدمة) مثل طبيعي)) { الوحدات_المستخدمة[الوحدة] := صواب; };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    دع بلا_هوية: متجه ط8 = [];
    ف := 0;
    طالما (ف < (الطول(*العلاقات) مثل طبيعي)) {
        دع العلاقة: &علاقة_استيراد_وحدة = &(*العلاقات)[ف];
        إذا ((*العلاقة).مصدر_المستورد == (*المصدر).المعرف) {
            // An earlier statement importing the same module the same way.
            دع مكرر: متغير منطقي = خطأ;
            دع ك: متغير طبيعي = 0;
            طالما (ك < ف) {
                دع السابقة: &علاقة_استيراد_وحدة = &(*العلاقات)[ك];
                إذا ((*السابقة).مصدر_المستورد == (*المصدر).المعرف
                    && معرفا_وحدة_متساويان((*السابقة).المستورد_منه, (*العلاقة).المستورد_منه)
                    && (*السابقة).الصنف == صنف_استيراد_وحدة.كامل()
                    && (*العلاقة).الصنف == صنف_استيراد_وحدة.كامل()) {
                    مكرر := صواب;
                };
                ك := ك + 1;
            }
            دع المقدمة: متجه طبيعي = وحدات_مقدمة_باستيراد(
                العلاقات, (*العلاقة).المستورد_منه, (*العلاقة).يعيد_التصدير
            );
            دع مستخدم: منطقي = وحدات_تقدم_مستخدما(
                السياق, الوحدات_الدلالية, &المقدمة, &الرموز_المستخدمة, &الوحدات_المستخدمة, خطأ, &بلا_هوية
            );
            دع الأسماء_غير_المستخدمة: متغير متجه نطاق = [];
            إذا (مستخدم && (*العلاقة).الصنف == صنف_استيراد_وحدة.انتقائي()) {
                دع س: متغير طبيعي = 0;
                طالما (س < (الطول((*العلاقة).الأسماء_الانتقائية) مثل طبيعي)) {
                    دع الاسم: نطاق = (*العلاقة).الأسماء_الانتقائية[س];
                    دع الهوية: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
                        &(*المصدر).المحتوى, الاسم.البداية.البايت مثل طبيعي, الاسم.النهاية.البايت مثل طبيعي
                    );
                    إذا (!وحدات_تقدم_مستخدما(
                        السياق, الوحدات_الدلالية, &المقدمة, &الرموز_المستخدمة, &الوحدات_المستخدمة, صواب, &الهوية
                    )) {
                        ألحق(الأسماء_غير_المستخدمة, الاسم);
                    };
                    س := س + 1;
                }
            };
            إذا (!مستخدم || مكرر || (الطول(الأسماء_غير_المستخدمة) مثل طبيعي) > 0) {
                دع المدخل: استيراد_غير_مستخدم = {
                    العلاقة: ف,
                    نطاق_العبارة: (*العلاقة).نطاق_العبارة,
                    مصدر_المستورد_منه: (*العلاقة).مصدر_المستورد_منه,
                    غير_مستخدم: !مستخدم,
                    مكرر: مكرر,
                    الأسماء_غير_المستخدمة: الأسماء_غير_المستخدمة
                };
                ألحق(الناتج, المدخل);
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// An independent copy of one relation, for query results.
عام عرف انسخ_علاقة_استيراد_وحدة(القيمة: &علاقة_استيراد_وحدة): علاقة_استيراد_وحدة {
    دع الأسماء: متغير متجه نطاق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة).الأسماء_الانتقائية) مثل طبيعي)) {
        ألحق(الأسماء, (*القيمة).الأسماء_الانتقائية[ف]);
        ف := ف + 1;
    }
    دع الناتج: علاقة_استيراد_وحدة = {
        المستورد: (*القيمة).المستورد,
        المستورد_منه: (*القيمة).المستورد_منه,
        مصدر_المستورد: (*القيمة).مصدر_المستورد,
        مصدر_المستورد_منه: (*القيمة).مصدر_المستورد_منه,
        الصنف: (*القيمة).الصنف,
        نطاق_العبارة: (*القيمة).نطاق_العبارة,
        نطاق_المرادف: (*القيمة).نطاق_المرادف,
        الأسماء_الانتقائية: الأسماء,
        يعيد_التصدير: (*القيمة).يعيد_التصدير
    };
    أرجع الناتج;
}

// The relations whose importing source (المستوردة صواب) or imported source
// (خطأ) is المصدر.
عام عرف علاقات_استيراد_لمصدر(
    العلاقات: &متجه علاقة_استيراد_وحدة,
    المصدر: طبيعي,
    المستوردة: منطقي
): متجه علاقة_استيراد_وحدة {
    دع الناتج: متغير متجه علاقة_استيراد_وحدة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العلاقات) مثل طبيعي)) {
        دع العلاقة: &علاقة_استيراد_وحدة = &(*العلاقات)[ف];
        دع الطرف: متغير طبيعي = (*العلاقة).مصدر_المستورد_منه;
        إذا (المستوردة) { الطرف := (*العلاقة).مصدر_المستورد; };
        إذا (الطرف == المصدر) { ألحق(الناتج, انسخ_علاقة_استيراد_وحدة(العلاقة)); };
        ف := ف + 1;
    }
    أرجع الناتج;
}
