استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.scopes;
استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.identifier_identity;
استورد compiler.runtime.primitive_identity;

// ربط اسم تابع داخل فضاء أسماء رمز مالك. يمكن لعدة أسماء أن تشير إلى نفس الرمز التابع.
عام نوع ربط_اسم_تابع = {
    المالك: معرف_رمز,
    الاسم: معرف_اسم,
    الرمز: معرف_رمز
};

// ربط التهجئة المصدرية للبدائي لا يملك هوية تشغيلية؛ الرمز وحده هو الهوية الدلالية.
عام نوع ربط_اسم_بدائي_مترجم = {
    الاسم: معرف_اسم,
    الرمز: معرف_رمز
};

// حقيقة دلالية واحدة لكل رمز بدائي. Runtime هو مالك نوع الهوية نفسه.
عام نوع ربط_رمز_بدائي_مترجم = {
    الرمز: معرف_رمز,
    الهوية: هوية_بدائي_مترجم
};

// Open-addressed index of child bindings by (owner Symbol, canonical name):
// الموضع is the binding's position in الروابط_التابعة, which stays the one
// owner of the bindings. Previously every child lookup scanned all child
// bindings of the program (the costliest Name query of a self-build).
// الهاش is a 32-bit hash (هاش_ربط_تابع); الموضع is a position in
// الروابط_التابعة, checked where the entry is made.
عام نوع مدخل_فهرس_ربط_تابع = {
    الهاش: ط32,
    الموضع: ط32
};

// الهاش is below 1048573 (هاش_هوية_معرف_بايتات reduces modulo it).
عام نوع مدخل_فهرس_اسم = {
    الهاش: ط32,
    الاسم: معرف_اسم
};

// Name System هو صاحب الحقيقة الوحيد لهويات الأسماء المقننة. الرموز لا تنسخ مصدرها.
// Compact persistent Name facts for semantic-query consumers. The full Name context
// remains phase-local; tooling requests retain only canonical Symbol facts.
عام نوع سياق_استعلامات_أسماء = {
    النطاقات: متجه نطاق_أسماء,
    الأسماء: متجه اسم_مقنن,
    الرموز: متجه رمز_دلالي,
    الروابط_التابعة: متجه ربط_اسم_تابع
};

عام نوع سياق_أسماء = {
    النطاق_التالي: طبيعي,
    الاسم_التالي: طبيعي,
    الرمز_التالي: طبيعي,
    النطاقات: متجه نطاق_أسماء,
    الأسماء: متجه اسم_مقنن,
    فهرس_الأسماء: متجه اختياري مدخل_فهرس_اسم,
    الرموز: متجه رمز_دلالي,
    الروابط_التابعة: متجه ربط_اسم_تابع,
    فهرس_الروابط_التابعة: متجه اختياري مدخل_فهرس_ربط_تابع,
    أسماء_البدائيات: متجه ربط_اسم_بدائي_مترجم,
    هويات_البدائيات: متجه ربط_رمز_بدائي_مترجم
};

عام عرف سياق_أسماء_جديد(): سياق_أسماء {
    دع النطاقات: متجه نطاق_أسماء = [];
    دع الأسماء: متجه اسم_مقنن = [];
    دع فهرس_الأسماء: متجه اختياري مدخل_فهرس_اسم = [];
    دع الرموز: متجه رمز_دلالي = [];
    دع الروابط_التابعة: متجه ربط_اسم_تابع = [];
    دع فهرس_الروابط_التابعة: متجه اختياري مدخل_فهرس_ربط_تابع = [];
    دع أسماء_البدائيات: متجه ربط_اسم_بدائي_مترجم = [];
    دع هويات_البدائيات: متجه ربط_رمز_بدائي_مترجم = [];
    دع سياق_الأسماء: سياق_أسماء = {
        النطاق_التالي: 0,
        الاسم_التالي: 0,
        الرمز_التالي: 0,
        النطاقات: النطاقات,
        الأسماء: الأسماء,
        فهرس_الأسماء: فهرس_الأسماء,
        الرموز: الرموز,
        الروابط_التابعة: الروابط_التابعة,
        فهرس_الروابط_التابعة: فهرس_الروابط_التابعة,
        أسماء_البدائيات: أسماء_البدائيات,
        هويات_البدائيات: هويات_البدائيات
    };
    أرجع سياق_الأسماء;
}

عرف أضف_نطاقا(
    سياق_الأسماء: &متغير سياق_أسماء,
    الوحدة: معرف_وحدة,
    الأب: اختياري معرف_نطاق
): معرف_نطاق {
    دع المعرف: معرف_نطاق = معرف_نطاق_من((*سياق_الأسماء).النطاق_التالي);
    دع الرموز: متجه معرف_رمز = [];
    دع الروابط: متجه ربط_اسم_نطاق = [];
    دع بلا_نطاق_مصدر: اختياري نطاق = اختياري.لا_شيء();
    دع النطاق: نطاق_أسماء = {
        المعرف: المعرف,
        الأب: الأب,
        الوحدة: الوحدة,
        نطاق_المصدر: بلا_نطاق_مصدر,
        الرموز: الرموز,
        الروابط: الروابط
    };
    ألحق((*سياق_الأسماء).النطاقات, النطاق);
    (*سياق_الأسماء).النطاق_التالي := (*سياق_الأسماء).النطاق_التالي + 1;
    أرجع المعرف;
}

عام عرف نطاق_جذري(
    سياق_الأسماء: &متغير سياق_أسماء,
    الوحدة: معرف_وحدة
): معرف_نطاق {
    أرجع أضف_نطاقا(سياق_الأسماء, الوحدة, اختياري.لا_شيء());
}

عام عرف نطاق_ابن(
    سياق_الأسماء: &متغير سياق_أسماء,
    الأب: معرف_نطاق
): معرف_نطاق {
    دع الوحدة: معرف_وحدة = (*سياق_الأسماء).النطاقات[الأب.القيمة].الوحدة;
    أرجع أضف_نطاقا(سياق_الأسماء, الوحدة, اختياري.موجود(الأب));
}

// Source containment is a canonical Name fact used by tooling to locate the
// active lexical scope without reconstructing scopes from syntax.
عام عرف ضع_نطاق_مصدر_لنطاق(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    نطاق_المصدر: نطاق
): فراغ {
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).النطاقات) مثل طبيعي)) { أرجع; };
    (*سياق_الأسماء).النطاقات[النطاق.القيمة].نطاق_المصدر := اختياري.موجود(نطاق_المصدر);
}

عام عرف نطاق_ابن_بمصدر(
    سياق_الأسماء: &متغير سياق_أسماء,
    الأب: معرف_نطاق,
    نطاق_المصدر: نطاق
): معرف_نطاق {
    دع المعرف: معرف_نطاق = نطاق_ابن(سياق_الأسماء, الأب);
    ضع_نطاق_مصدر_لنطاق(سياق_الأسماء, المعرف, نطاق_المصدر);
    أرجع المعرف;
}

عرف ابن_فهرس_أسماء_فارغا(السعة: طبيعي): متجه اختياري مدخل_فهرس_اسم {
    دع الناتج: متغير متجه اختياري مدخل_فهرس_اسم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) {
        ألحق(الناتج, اختياري.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف موضع_إدراج_مدخل_فهرس_اسم(
    الفهرس: &متجه اختياري مدخل_فهرس_اسم,
    الهاش: طبيعي
): اختياري طبيعي {
    دع السعة: طبيعي = الطول(*الفهرس) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الموضع: متغير طبيعي = الهاش % السعة;
    طالما (صواب) {
        طابق (*الفهرس)[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(الموضع); }
        | اختياري.موجود(_) -> { الموضع := (الموضع + 1) % السعة; };
    }
    أرجع اختياري.لا_شيء();
}

عرف أدرج_مدخل_فهرس_اسم(
    الفهرس: &متغير متجه اختياري مدخل_فهرس_اسم,
    المدخل: مدخل_فهرس_اسم
): فراغ {
    طابق موضع_إدراج_مدخل_فهرس_اسم(الفهرس, المدخل.الهاش) مع
    | اختياري.موجود(الموضع) -> { (*الفهرس)[الموضع] := اختياري.موجود(المدخل); }
    | اختياري.لا_شيء -> { };
}

عرف تأكد_سعة_فهرس_الأسماء(سياق_الأسماء: &متغير سياق_أسماء): فراغ {
    دع العدد: طبيعي = الطول((*سياق_الأسماء).الأسماء) مثل طبيعي;
    دع القديمة: طبيعي = الطول((*سياق_الأسماء).فهرس_الأسماء) مثل طبيعي;
    دع تحتاج: متغير منطقي = القديمة == 0;
    إذا (!تحتاج) {
        تحتاج := (العدد * 3) >= (القديمة * 2);
    };
    إذا (!تحتاج) { أرجع; };
    دع الجديدة: متغير طبيعي = 16;
    إذا (القديمة > 0) { الجديدة := القديمة * 2; };
    دع الفهرس_الجديد: متغير متجه اختياري مدخل_فهرس_اسم = ابن_فهرس_أسماء_فارغا(الجديدة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < القديمة) {
        طابق (*سياق_الأسماء).فهرس_الأسماء[ف] مع
        | اختياري.موجود(المدخل) -> {
            أدرج_مدخل_فهرس_اسم(&متغير الفهرس_الجديد, المدخل);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    (*سياق_الأسماء).فهرس_الأسماء := الفهرس_الجديد;
}

// Reduced modulo the largest 32-bit prime, so the index stores it in 32 bits.
عرف هاش_ربط_تابع(المالك: معرف_رمز, الاسم: معرف_اسم): طبيعي {
    أرجع (((المالك.القيمة مثل طبيعي) * 1000003) + (الاسم.القيمة مثل طبيعي)) % 4294967291;
}

عرف موضع_إدراج_مدخل_فهرس_ربط_تابع(
    الفهرس: &متجه اختياري مدخل_فهرس_ربط_تابع,
    الهاش: طبيعي
): اختياري طبيعي {
    دع السعة: طبيعي = الطول(*الفهرس) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الموضع: متغير طبيعي = الهاش % السعة;
    طالما (صواب) {
        طابق (*الفهرس)[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(الموضع); }
        | اختياري.موجود(_) -> { الموضع := (الموضع + 1) % السعة; };
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_فهرس_روابط_تابعة_فارغا(السعة: طبيعي): متجه اختياري مدخل_فهرس_ربط_تابع {
    دع الناتج: متغير متجه اختياري مدخل_فهرس_ربط_تابع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) {
        ألحق(الناتج, اختياري.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Appends one child binding and indexes it. The only writer of
// الروابط_التابعة, so the index always covers every binding.
عرف ألحق_ربطا_تابعا(سياق_الأسماء: &متغير سياق_أسماء, الربط: ربط_اسم_تابع): فراغ {
    دع العدد: طبيعي = الطول((*سياق_الأسماء).الروابط_التابعة) مثل طبيعي;
    دع القديمة: طبيعي = الطول((*سياق_الأسماء).فهرس_الروابط_التابعة) مثل طبيعي;
    إذا (القديمة == 0 || ((العدد + 1) * 3) >= (القديمة * 2)) {
        دع الجديدة: متغير طبيعي = 64;
        إذا (القديمة > 0) { الجديدة := القديمة * 2; };
        دع الفهرس_الجديد: متغير متجه اختياري مدخل_فهرس_ربط_تابع = ابن_فهرس_روابط_تابعة_فارغا(الجديدة);
        دع ف: متغير طبيعي = 0;
        طالما (ف < القديمة) {
            طابق (*سياق_الأسماء).فهرس_الروابط_التابعة[ف] مع
            | اختياري.موجود(المدخل) -> {
                طابق موضع_إدراج_مدخل_فهرس_ربط_تابع(&الفهرس_الجديد, المدخل.الهاش) مع
                | اختياري.موجود(الموضع) -> { الفهرس_الجديد[الموضع] := اختياري.موجود(المدخل); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        (*سياق_الأسماء).فهرس_الروابط_التابعة := الفهرس_الجديد;
    };
    دع المدخل: مدخل_فهرس_ربط_تابع = {
        الهاش: هاش_ربط_تابع(الربط.المالك, الربط.الاسم) مثل ط32,
        الموضع: ط32_متحقق(العدد)
    };
    طابق موضع_إدراج_مدخل_فهرس_ربط_تابع(&(*سياق_الأسماء).فهرس_الروابط_التابعة, المدخل.الهاش) مع
    | اختياري.موجود(الموضع) -> { (*سياق_الأسماء).فهرس_الروابط_التابعة[الموضع] := اختياري.موجود(المدخل); }
    | اختياري.لا_شيء -> { };
    ألحق((*سياق_الأسماء).الروابط_التابعة, الربط);
}

عرف ابحث_عن_هوية(
    سياق_الأسماء: &سياق_أسماء,
    الهوية: &متجه ط8
): اختياري معرف_اسم {
    دع السعة: طبيعي = الطول((*سياق_الأسماء).فهرس_الأسماء) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_هوية_معرف_بايتات(الهوية);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        طابق (*سياق_الأسماء).فهرس_الأسماء[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المدخل) -> {
            إذا ((المدخل.الهاش مثل طبيعي) == الهاش
                && (المدخل.الاسم.القيمة مثل طبيعي) < (الطول((*سياق_الأسماء).الأسماء) مثل طبيعي)
                && هويتان_معرفيتان_متساويتان(&(*سياق_الأسماء).الأسماء[المدخل.الاسم.القيمة].البايتات, الهوية)) {
                أرجع اختياري.موجود(المدخل.الاسم);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابحث_عن_هوية_في_شريحة(
    سياق_الأسماء: &سياق_أسماء,
    المصدر: &نص,
    البداية: طبيعي,
    النهاية: طبيعي
): اختياري معرف_اسم {
    دع السعة: طبيعي = الطول((*سياق_الأسماء).فهرس_الأسماء) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_هوية_معرف_في_شريحة(المصدر, البداية, النهاية);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        طابق (*سياق_الأسماء).فهرس_الأسماء[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المدخل) -> {
            إذا ((المدخل.الهاش مثل طبيعي) == الهاش
                && (المدخل.الاسم.القيمة مثل طبيعي) < (الطول((*سياق_الأسماء).الأسماء) مثل طبيعي)
                && تطابق_هوية_بايتات_وشريحة(
                    &(*سياق_الأسماء).الأسماء[المدخل.الاسم.القيمة].البايتات,
                    المصدر, البداية, النهاية
                )) {
                أرجع اختياري.موجود(المدخل.الاسم);
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Generic read-only text -> canonical Name identity lookup. Primitive classification
// remains identity-based after registration; this query does not know primitive spellings.
عام عرف هوية_اسم_لنص_إن_وجد(
    سياق_الأسماء: &سياق_أسماء,
    النص: &نص
): اختياري معرف_اسم {
    دع النهاية: طبيعي = الطول(*النص) مثل طبيعي;
    أرجع ابحث_عن_هوية_في_شريحة(سياق_الأسماء, النص, 0, النهاية);
}

عرف سجل_اسما(سياق_الأسماء: &متغير سياق_أسماء, البايتات: متجه ط8, المكتوبة: متجه ط8): معرف_اسم {
    دع الهاش: طبيعي = هاش_هوية_معرف_بايتات(&البايتات);
    دع المعرف: معرف_اسم = معرف_اسم_من((*سياق_الأسماء).الاسم_التالي);
    دع الاسم: اسم_مقنن = { المعرف: المعرف, البايتات: البايتات, المكتوبة: المكتوبة };
    ألحق((*سياق_الأسماء).الأسماء, الاسم);
    (*سياق_الأسماء).الاسم_التالي := (*سياق_الأسماء).الاسم_التالي + 1;
    تأكد_سعة_فهرس_الأسماء(سياق_الأسماء);
    دع المدخل: مدخل_فهرس_اسم = { الهاش: الهاش مثل ط32, الاسم: المعرف };
    طابق موضع_إدراج_مدخل_فهرس_اسم(&(*سياق_الأسماء).فهرس_الأسماء, الهاش) مع
    | اختياري.موجود(الموضع) -> { (*سياق_الأسماء).فهرس_الأسماء[الموضع] := اختياري.موجود(المدخل); }
    | اختياري.لا_شيء -> { };
    أرجع المعرف;
}

عرف قنن_اسما_نصيا(سياق_الأسماء: &متغير سياق_أسماء, النص: &نص): معرف_اسم {
    دع النهاية: طبيعي = الطول(*النص) مثل طبيعي;
    دع الموجود: اختياري معرف_اسم = ابحث_عن_هوية_في_شريحة(سياق_الأسماء, النص, 0, النهاية);
    طابق الموجود مع
    | اختياري.موجود(المعرف) -> { أرجع المعرف; }
    | اختياري.لا_شيء -> { };
    دع البايتات: متجه ط8 = انسخ_هوية_معرف_من_نص(النص);
    دع المكتوبة: متجه ط8 = انسخ_تهجئة_معرف_من_شريحة(النص, 0, النهاية);
    أرجع سجل_اسما(سياق_الأسماء, البايتات, المكتوبة);
}

عام عرف قنن_اسما_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    المصدر: &مصدر,
    النطاق: نطاق
): معرف_اسم {
    دع الموجود: اختياري معرف_اسم = ابحث_عن_هوية_في_شريحة(
        سياق_الأسماء,
        &(*المصدر).المحتوى,
        النطاق.البداية.البايت,
        النطاق.النهاية.البايت
    );
    طابق الموجود مع
    | اختياري.موجود(المعرف) -> { أرجع المعرف; }
    | اختياري.لا_شيء -> { };
    دع البايتات: متجه ط8 = انسخ_هوية_معرف_من_شريحة(
        &(*المصدر).المحتوى,
        النطاق.البداية.البايت,
        النطاق.النهاية.البايت
    );
    دع المكتوبة: متجه ط8 = انسخ_تهجئة_معرف_من_شريحة(
        &(*المصدر).المحتوى,
        النطاق.البداية.البايت,
        النطاق.النهاية.البايت
    );
    أرجع سجل_اسما(سياق_الأسماء, البايتات, المكتوبة);
}

عام عرف ابحث_محليا_بهوية(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق,
    الاسم: معرف_اسم
): اختياري معرف_رمز {
    أرجع ابحث_محليا_بهوية_في_حيز(
        سياق_الأسماء, النطاق, الاسم, حيز_اسم.الكل()
    );
}

عام عرف ابحث_محليا(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق,
    الاسم: &نص
): اختياري معرف_رمز {
    دع النهاية: طبيعي = الطول(*الاسم) مثل طبيعي;
    دع هوية: اختياري معرف_اسم = ابحث_عن_هوية_في_شريحة(سياق_الأسماء, الاسم, 0, النهاية);
    طابق هوية مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(المعرف) -> {
        أرجع ابحث_محليا_بهوية(سياق_الأسماء, النطاق, المعرف);
    };
}

عرف ابحث_من(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق,
    الاسم: &نص
): اختياري معرف_رمز {
    دع المحلي: اختياري معرف_رمز = ابحث_محليا(سياق_الأسماء, النطاق, الاسم);
    طابق المحلي مع
    | اختياري.موجود(المعرف) -> {
        أرجع اختياري.موجود(المعرف);
    }
    | اختياري.لا_شيء -> {
    };
    دع مرجع_سجل_النطاق: &نطاق_أسماء = &(*سياق_الأسماء).النطاقات[النطاق.القيمة];
    طابق (*مرجع_سجل_النطاق).الأب مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأب) -> {
        أرجع ابحث_من(سياق_الأسماء, الأب, الاسم);
    };
}

عام عرف ابحث(
    سياق_الأسماء: &سياق_أسماء,
    البداية: معرف_نطاق,
    الاسم: &نص
): اختياري معرف_رمز {
    أرجع ابحث_من(سياق_الأسماء, البداية, الاسم);
}

// Identity-preserving lexical lookup for already-canonical source occurrences.
عام عرف ابحث_من_بهوية(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق,
    الاسم: معرف_اسم
): اختياري معرف_رمز {
    أرجع ابحث_من_بهوية_في_حيز(
        سياق_الأسماء, النطاق, الاسم, حيز_اسم.الكل()
    );
}

// Context-filtered lexical lookup. A same-spelling binding in the other contextual
// namespace does not shadow the requested declaration class.
عام عرف ابحث_محليا_بهوية_في_حيز(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق,
    الاسم: معرف_اسم,
    الحيز: حيز_اسم
): اختياري معرف_رمز {
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).النطاقات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_النطاق: &نطاق_أسماء = &(*سياق_الأسماء).النطاقات[النطاق.القيمة];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*مرجع_النطاق).الروابط) مثل طبيعي)) {
        دع الربط: ربط_اسم_نطاق = (*مرجع_النطاق).الروابط[ف];
        إذا (معرفا_اسم_متساويان(الربط.الاسم, الاسم)) {
            طابق نوع_رمز_عند(سياق_الأسماء, الربط.الرمز) مع
            | اختياري.موجود(النوع) -> {
                إذا (هل_نوع_تصريح_في_حيز(النوع, الحيز)) {
                    أرجع اختياري.موجود(الربط.الرمز);
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ابحث_محليا_ببايتات_في_حيز(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق,
    الهوية: &متجه ط8,
    الحيز: حيز_اسم
): اختياري معرف_رمز {
    // The global Name interner already owns the byte -> NameID hash index.
    // Query it read-only, then resolve the canonical identity in the lexical scope;
    // do not re-compare the same spelling against every binding in the scope.
    طابق ابحث_عن_هوية(سياق_الأسماء, الهوية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        أرجع ابحث_محليا_بهوية_في_حيز(سياق_الأسماء, النطاق, الاسم, الحيز);
    };
}

عام عرف ابحث_من_ببايتات_في_حيز(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق,
    الهوية: &متجه ط8,
    الحيز: حيز_اسم
): اختياري معرف_رمز {
    طابق ابحث_محليا_ببايتات_في_حيز(سياق_الأسماء, النطاق, الهوية, الحيز) مع
    | اختياري.موجود(الرمز) -> {
        أرجع اختياري.موجود(الرمز);
    }
    | اختياري.لا_شيء -> { };
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).النطاقات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    طابق (*سياق_الأسماء).النطاقات[النطاق.القيمة].الأب مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأب) -> {
        أرجع ابحث_من_ببايتات_في_حيز(سياق_الأسماء, الأب, الهوية, الحيز);
    };
}

عام عرف ابحث_بدائيا_ببايتات(
    سياق_الأسماء: &سياق_أسماء,
    الهوية: &متجه ط8
): اختياري معرف_رمز {
    طابق ابحث_عن_هوية(سياق_الأسماء, الهوية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        أرجع ابحث_رمزا_بدائيا_بهوية(سياق_الأسماء, الاسم);
    };
}

عام عرف ابحث_من_بهوية_في_حيز(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق,
    الاسم: معرف_اسم,
    الحيز: حيز_اسم
): اختياري معرف_رمز {
    طابق ابحث_محليا_بهوية_في_حيز(سياق_الأسماء, النطاق, الاسم, الحيز) مع
    | اختياري.موجود(المعرف) -> {
        أرجع اختياري.موجود(المعرف);
    }
    | اختياري.لا_شيء -> { };
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).النطاقات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    طابق (*سياق_الأسماء).النطاقات[النطاق.القيمة].الأب مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأب) -> {
        أرجع ابحث_من_بهوية_في_حيز(سياق_الأسماء, الأب, الاسم, الحيز);
    };
}

عرف خصص_رمزا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    الاسم: معرف_اسم,
    نطاق_الاسم: نطاق,
    نطاق_التصريح: نطاق,
    المالك: اختياري معرف_رمز,
    النوع: نوع_تصريح,
    علني: منطقي,
    داخل_النطاق: منطقي
): معرف_رمز {
    دع المعرف: معرف_رمز = معرف_رمز_مسمى_من((*سياق_الأسماء).الرمز_التالي);
    دع الرمز: رمز_دلالي = {
        المعرف: المعرف,
        الاسم: الاسم,
        نطاق_الاسم: نطاق_الاسم,
        نطاق_التصريح: نطاق_التصريح,
        النطاق_المالك: النطاق,
        المالك: المالك,
        النوع: النوع,
        علني: علني
    };
    ألحق((*سياق_الأسماء).الرموز, الرمز);
    إذا (داخل_النطاق) {
        دع الربط: ربط_اسم_نطاق = { الاسم: الاسم, الرمز: المعرف };
        ألحق((*سياق_الأسماء).النطاقات[النطاق.القيمة].الرموز, المعرف);
        ألحق((*سياق_الأسماء).النطاقات[النطاق.القيمة].الروابط, الربط);
    };
    (*سياق_الأسماء).الرمز_التالي := (*سياق_الأسماء).الرمز_التالي + 1;
    أرجع المعرف;
}

عام عرف أضف_رمزا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    الاسم: نص,
    نطاق_التصريح: نطاق,
    النوع: نوع_تصريح,
    علني: منطقي
): نتيجة_إضافة {
    دع الهوية: معرف_اسم = قنن_اسما_نصيا(سياق_الأسماء, &الاسم);
    دع الموجود: اختياري معرف_رمز = ابحث_محليا_بهوية(سياق_الأسماء, النطاق, الهوية);
    طابق الموجود مع
    | اختياري.موجود(المعرف) -> {
        أرجع نتيجة_إضافة.مكرر(المعرف, نطاق_التصريح);
    }
    | اختياري.لا_شيء -> {
    };
    دع المعرف: معرف_رمز = خصص_رمزا(
        سياق_الأسماء, النطاق, الهوية, نطاق_التصريح, نطاق_التصريح,
        اختياري.لا_شيء(), النوع, علني, صواب
    );
    أرجع نتيجة_إضافة.أضيف(المعرف);
}

عام عرف أضف_رمزا_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق,
    نطاق_التصريح: نطاق,
    النوع: نوع_تصريح,
    علني: منطقي
): نتيجة_إضافة {
    دع الهوية: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم);
    دع الموجود: اختياري معرف_رمز = ابحث_محليا_بهوية(سياق_الأسماء, النطاق, الهوية);
    طابق الموجود مع
    | اختياري.موجود(المعرف) -> {
        أرجع نتيجة_إضافة.مكرر(المعرف, نطاق_التصريح);
    }
    | اختياري.لا_شيء -> {
    };
    دع المعرف: معرف_رمز = خصص_رمزا(
        سياق_الأسماء, النطاق, الهوية, نطاق_الاسم, نطاق_التصريح,
        اختياري.لا_شيء(), النوع, علني, صواب
    );
    أرجع نتيجة_إضافة.أضيف(المعرف);
}

// يسجل تهجئة إضافية للرمز نفسه داخل سجل أسماء النطاق المقنن.
// لا ينشئ رمزاً جديداً ولا يكرر هوية التصريح.
عام عرف أضف_اسما_بديلا_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق,
    الرمز: معرف_رمز
): نتيجة_إضافة {
    دع الهوية: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم);
    دع الموجود: اختياري معرف_رمز = ابحث_محليا_بهوية(سياق_الأسماء, النطاق, الهوية);
    طابق الموجود مع
    | اختياري.موجود(المعرف) -> {
        أرجع نتيجة_إضافة.مكرر(المعرف, نطاق_الاسم);
    }
    | اختياري.لا_شيء -> {
    };
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
        أرجع نتيجة_إضافة.مكرر(الرمز, نطاق_الاسم);
    };
    دع الربط: ربط_اسم_نطاق = { الاسم: الهوية, الرمز: الرمز };
    ألحق((*سياق_الأسماء).النطاقات[النطاق.القيمة].الروابط, الربط);
    أرجع نتيجة_إضافة.أضيف(الرمز);
}

عام عرف أضف_رمزا_تابعا_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق: معرف_نطاق,
    المالك: معرف_رمز,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق,
    نطاق_التصريح: نطاق,
    النوع: نوع_تصريح,
    علني: منطقي
): نتيجة_إضافة {
    دع الهوية: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم);
    طابق ابحث_رمزا_تابعا_بهوية(سياق_الأسماء, المالك, الهوية) مع
    | اختياري.موجود(الموجود) -> {
        أرجع نتيجة_إضافة.مكرر(الموجود, نطاق_التصريح);
    }
    | اختياري.لا_شيء -> { };
    دع المعرف: معرف_رمز = خصص_رمزا(
        سياق_الأسماء, النطاق, الهوية, نطاق_الاسم, نطاق_التصريح,
        اختياري.موجود(المالك), النوع, علني, خطأ
    );
    دع الربط: ربط_اسم_تابع = { المالك: المالك, الاسم: الهوية, الرمز: المعرف };
    ألحق_ربطا_تابعا(سياق_الأسماء, الربط);
    أرجع نتيجة_إضافة.أضيف(المعرف);
}

// يضيف تهجئة أخرى إلى فضاء أسماء المالك نفسه مع الحفاظ على هوية الرمز التابع.
عام عرف أضف_اسما_بديلا_تابعا_مصدريا(
    سياق_الأسماء: &متغير سياق_أسماء,
    المالك: معرف_رمز,
    المصدر: &مصدر,
    نطاق_الاسم: نطاق,
    الرمز: معرف_رمز
): نتيجة_إضافة {
    دع الهوية: معرف_اسم = قنن_اسما_مصدريا(سياق_الأسماء, المصدر, نطاق_الاسم);
    طابق ابحث_رمزا_تابعا_بهوية(سياق_الأسماء, المالك, الهوية) مع
    | اختياري.موجود(الموجود) -> {
        أرجع نتيجة_إضافة.مكرر(الموجود, نطاق_الاسم);
    }
    | اختياري.لا_شيء -> { };
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
        أرجع نتيجة_إضافة.مكرر(الرمز, نطاق_الاسم);
    };
    دع رمز_الابن: رمز_دلالي = (*سياق_الأسماء).الرموز[الرمز.القيمة];
    طابق رمز_الابن.المالك مع
    | اختياري.موجود(مالك_الرمز) -> {
        إذا (!معرفا_رمز_متساويان(مالك_الرمز, المالك)) {
            أرجع نتيجة_إضافة.مكرر(الرمز, نطاق_الاسم);
        };
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_إضافة.مكرر(الرمز, نطاق_الاسم);
    };
    دع الربط: ربط_اسم_تابع = { المالك: المالك, الاسم: الهوية, الرمز: الرمز };
    ألحق_ربطا_تابعا(سياق_الأسماء, الربط);
    أرجع نتيجة_إضافة.أضيف(الرمز);
}

// Read-only canonical child-symbol lookup. Parent Symbol identity owns the child namespace.
عام عرف ابحث_رمزا_تابعا_بهوية(
    سياق_الأسماء: &سياق_أسماء,
    المالك: معرف_رمز,
    الاسم: معرف_اسم
): اختياري معرف_رمز {
    دع السعة: طبيعي = الطول((*سياق_الأسماء).فهرس_الروابط_التابعة) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع الهاش: طبيعي = هاش_ربط_تابع(المالك, الاسم);
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        طابق (*سياق_الأسماء).فهرس_الروابط_التابعة[الموضع] مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المدخل) -> {
            إذا ((المدخل.الهاش مثل طبيعي) == الهاش) {
                دع الربط: &ربط_اسم_تابع = &(*سياق_الأسماء).الروابط_التابعة[المدخل.الموضع];
                إذا (معرفا_رمز_متساويان((*الربط).المالك, المالك) &&
                    معرفا_اسم_متساويان((*الربط).الاسم, الاسم)) {
                    أرجع اختياري.موجود((*الربط).الرمز);
                };
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف اسم_رمز_عند(
    سياق_الأسماء: &سياق_أسماء,
    المعرف: معرف_رمز
): اختياري معرف_اسم {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*سياق_الأسماء).الرموز[المعرف.القيمة].الاسم);
}

عام عرف نوع_رمز_عند(
    سياق_الأسماء: &سياق_أسماء,
    المعرف: معرف_رمز
): اختياري نوع_تصريح {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*سياق_الأسماء).الرموز[المعرف.القيمة].النوع);
}

عام عرف نطاق_تصريح_رمز_عند(
    سياق_الأسماء: &سياق_أسماء,
    المعرف: معرف_رمز
): اختياري نطاق {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*سياق_الأسماء).الرموز[المعرف.القيمة].نطاق_التصريح);
}

// Read-only scope queries keep scope storage owned by Name System.
عام عرف وحدة_نطاق_عند(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق
): اختياري معرف_وحدة {
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).النطاقات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*سياق_الأسماء).النطاقات[النطاق.القيمة].الوحدة);
}

عام عرف عدد_رموز_نطاق(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق
): اختياري طبيعي {
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).النطاقات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(
        الطول((*سياق_الأسماء).النطاقات[النطاق.القيمة].الرموز) مثل طبيعي
    );
}

عام عرف رمز_نطاق_عند(
    سياق_الأسماء: &سياق_أسماء,
    النطاق: معرف_نطاق,
    الفهرس: طبيعي
): اختياري معرف_رمز {
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).النطاقات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    إذا (الفهرس >= (الطول((*سياق_الأسماء).النطاقات[النطاق.القيمة].الرموز) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*سياق_الأسماء).النطاقات[النطاق.القيمة].الرموز[الفهرس]);
}

// Checked visibility accessor keeps symbol representation owned by Name System.
عام عرف علنية_رمز_عند(
    سياق_الأسماء: &سياق_أسماء,
    المعرف: معرف_رمز
): اختياري منطقي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*سياق_الأسماء).الرموز[المعرف.القيمة].علني);
}

// Primitive registry storage is global to one Name context, not to one source module.
// Source spelling ownership remains in primitive_registry.sn.
عام عرف ابحث_رمزا_بدائيا_بهوية(
    سياق_الأسماء: &سياق_أسماء,
    الاسم: معرف_اسم
): اختياري معرف_رمز {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*سياق_الأسماء).أسماء_البدائيات) مثل طبيعي)) {
        دع الربط: ربط_اسم_بدائي_مترجم = (*سياق_الأسماء).أسماء_البدائيات[ف];
        إذا (معرفا_اسم_متساويان(الربط.الاسم, الاسم)) {
            أرجع اختياري.موجود(الربط.الرمز);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف أضف_رمزا_بدائيا(
    سياق_الأسماء: &متغير سياق_أسماء,
    النطاق_المالك: معرف_نطاق,
    التهجئة: نص,
    الهوية: هوية_بدائي_مترجم
): نتيجة_إضافة {
    دع الاسم: معرف_اسم = قنن_اسما_نصيا(سياق_الأسماء, &التهجئة);
    طابق ابحث_رمزا_بدائيا_بهوية(سياق_الأسماء, الاسم) مع
    | اختياري.موجود(الموجود) -> {
        أرجع نتيجة_إضافة.مكرر(الموجود, نطاق_فارغ());
    }
    | اختياري.لا_شيء -> { };

    دع الفارغ: نطاق = نطاق_فارغ();
    دع الرمز: معرف_رمز = خصص_رمزا(
        سياق_الأسماء,
        النطاق_المالك,
        الاسم,
        الفارغ,
        الفارغ,
        اختياري.لا_شيء(),
        نوع_تصريح.دالة_خارجية(),
        خطأ,
        خطأ
    );
    دع ربط_الاسم: ربط_اسم_بدائي_مترجم = { الاسم: الاسم, الرمز: الرمز };
    دع ربط_الهوية: ربط_رمز_بدائي_مترجم = { الرمز: الرمز, الهوية: الهوية };
    ألحق((*سياق_الأسماء).أسماء_البدائيات, ربط_الاسم);
    ألحق((*سياق_الأسماء).هويات_البدائيات, ربط_الهوية);
    أرجع نتيجة_إضافة.أضيف(الرمز);
}

عام عرف أضف_اسما_بدائيا(
    سياق_الأسماء: &متغير سياق_أسماء,
    التهجئة: نص,
    الرمز: معرف_رمز
): نتيجة_إضافة {
    دع الاسم: معرف_اسم = قنن_اسما_نصيا(سياق_الأسماء, &التهجئة);
    طابق ابحث_رمزا_بدائيا_بهوية(سياق_الأسماء, الاسم) مع
    | اختياري.موجود(الموجود) -> {
        أرجع نتيجة_إضافة.مكرر(الموجود, نطاق_فارغ());
    }
    | اختياري.لا_شيء -> { };

    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*سياق_الأسماء).الرموز) مثل طبيعي)) {
        أرجع نتيجة_إضافة.مكرر(الرمز, نطاق_فارغ());
    };
    دع ربط_الاسم: ربط_اسم_بدائي_مترجم = { الاسم: الاسم, الرمز: الرمز };
    ألحق((*سياق_الأسماء).أسماء_البدائيات, ربط_الاسم);
    أرجع نتيجة_إضافة.أضيف(الرمز);
}


// Canonical read-only Symbol -> Runtime-owned primitive identity query.
// Source spellings are confined to primitive_registry.sn registration. The
// compact binding table may outlive the larger Name context at phase boundaries.
عام عرف هوية_بدائي_في_روابط_رموز(
    الروابط: &متجه ربط_رمز_بدائي_مترجم,
    الرمز: معرف_رمز
): اختياري هوية_بدائي_مترجم {
    // The table is in ascending symbol order (أضف_رمزا_بدائيا appends each
    // binding as its symbol is allocated): a range check, then a binary
    // search. Most queried symbols are source symbols, after the range.
    دع العدد: طبيعي = الطول(*الروابط) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع المطلوب: طبيعي = الرمز.القيمة;
    إذا (المطلوب < ((*الروابط)[0].الرمز.القيمة مثل طبيعي) || المطلوب > ((*الروابط)[العدد - 1].الرمز.القيمة مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع الأدنى: متغير طبيعي = 0;
    دع الأعلى: متغير طبيعي = العدد;
    طالما (الأدنى < الأعلى) {
        دع الوسط: طبيعي = الأدنى + (الأعلى - الأدنى) / 2;
        دع القيمة: طبيعي = (*الروابط)[الوسط].الرمز.القيمة;
        إذا (القيمة == المطلوب) { أرجع اختياري.موجود((*الروابط)[الوسط].الهوية); };
        إذا (القيمة < المطلوب) { الأدنى := الوسط + 1; } وإلا { الأعلى := الوسط; };
    }
    أرجع اختياري.لا_شيء();
}

عام عرف هوية_بدائي_رمز_عند(
    سياق_الأسماء: &سياق_أسماء,
    الرمز: معرف_رمز
): اختياري هوية_بدائي_مترجم {
    أرجع هوية_بدائي_في_روابط_رموز(&(*سياق_الأسماء).هويات_البدائيات, الرمز);
}

عام نوع حقائق_أسماء_مستمرة = {
    هويات_البدائيات: متجه ربط_رمز_بدائي_مترجم,
    استعلامات: اختياري سياق_استعلامات_أسماء
};

// Name owns these vectors until the semantic pipeline is complete.  At the
// phase boundary ownership is transferred once; no second Name database is copied.
عام عرف استخلص_حقائق_أسماء_مستمرة(
    السياق: سياق_أسماء,
    احتفظ_بحقائق_الأدوات: منطقي
): حقائق_أسماء_مستمرة {
    طابق السياق مع
    | {
        النطاق_التالي: _, الاسم_التالي: _, الرمز_التالي: _,
        النطاقات: النطاقات, الأسماء: الأسماء, فهرس_الأسماء: _,
        الرموز: الرموز, الروابط_التابعة: الروابط_التابعة,
        فهرس_الروابط_التابعة: _,
        أسماء_البدائيات: _, هويات_البدائيات: هويات_البدائيات
    } -> {
        دع الاستعلامات: متغير اختياري سياق_استعلامات_أسماء = اختياري.لا_شيء();
        إذا (احتفظ_بحقائق_الأدوات) {
            دع السياق_المستمر: سياق_استعلامات_أسماء = {
                النطاقات: النطاقات,
                الأسماء: الأسماء,
                الرموز: الرموز,
                الروابط_التابعة: الروابط_التابعة
            };
            الاستعلامات := اختياري.موجود(السياق_المستمر);
        };
        دع الناتج: حقائق_أسماء_مستمرة = {
            هويات_البدائيات: هويات_البدائيات,
            استعلامات: الاستعلامات
        };
        أرجع الناتج;
    };
}

عام عرف رمز_دلالي_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    الرمز: معرف_رمز
): اختياري رمز_دلالي {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*السياق).الرموز) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع الحقيقة: رمز_دلالي = (*السياق).الرموز[الرمز.القيمة];
    إذا (!معرفا_رمز_متساويان(الحقيقة.المعرف, الرمز)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(الحقيقة);
}


عام عرف اسم_مقنن_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    الاسم: معرف_اسم
): اختياري اسم_مقنن {
    إذا ((الاسم.القيمة مثل طبيعي) >= (الطول((*السياق).الأسماء) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الحقيقة: &اسم_مقنن = &(*السياق).الأسماء[الاسم.القيمة];
    دع الحقيقة: اسم_مقنن = انسخ_مملوكا_اسم_مقنن(مرجع_الحقيقة);
    إذا (!معرفا_اسم_متساويان(الحقيقة.المعرف, الاسم)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(الحقيقة);
}

عام عرف نطاق_دلالي_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري معرف_نطاق {
    دع موجود: متغير منطقي = خطأ;
    دع الأفضل: متغير معرف_نطاق = معرف_نطاق_من(0);
    دع أفضل_طول: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).النطاقات) مثل طبيعي)) {
        دع مرجع_النطاق: &نطاق_أسماء = &(*السياق).النطاقات[ف];
        طابق (*مرجع_النطاق).نطاق_المصدر مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المدى) -> {
            إذا (نطاق_يحتوي_بايتا(المدى, المصدر, البايت)) {
                دع الطول_الحالي: طبيعي = طول_نطاق_بالبايت(المدى);
                إذا ((!موجود) || (الطول_الحالي <= أفضل_طول)) {
                    موجود := صواب;
                    الأفضل := (*مرجع_النطاق).المعرف;
                    أفضل_طول := الطول_الحالي;
                };
            };
        };
        ف := ف + 1;
    }
    إذا (!موجود) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الأفضل);
}

عرف قائمة_مرئية_تحوي_اسما(
    الروابط: &متجه ربط_اسم_نطاق,
    الاسم: معرف_اسم
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الروابط) مثل طبيعي)) {
        إذا (معرفا_اسم_متساويان((*الروابط)[ف].الاسم, الاسم)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Returns lexical bindings in resolution order: nearest scope first, with
// shadowed Name identities omitted. This is a general Name query, not LSP state.
عام عرف روابط_مرئية_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    المصدر: طبيعي,
    البايت: طبيعي
): متجه ربط_اسم_نطاق {
    دع الناتج: متغير متجه ربط_اسم_نطاق = [];
    دع الحالي: متغير معرف_نطاق = معرف_نطاق_من(0);
    طابق نطاق_دلالي_عند_استعلام(السياق, المصدر, البايت) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(المعرف) -> { الحالي := المعرف; };
    دع تابع: متغير منطقي = صواب;
    طالما (تابع) {
        إذا ((الحالي.القيمة مثل طبيعي) >= (الطول((*السياق).النطاقات) مثل طبيعي)) { أرجع الناتج; };
        دع مرجع_النطاق: &نطاق_أسماء = &(*السياق).النطاقات[الحالي.القيمة];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_النطاق).الروابط) مثل طبيعي)) {
            دع الربط: ربط_اسم_نطاق = (*مرجع_النطاق).الروابط[ف];
            إذا (!قائمة_مرئية_تحوي_اسما(&الناتج, الربط.الاسم)) {
                ألحق(الناتج, الربط);
            };
            ف := ف + 1;
        }
        طابق (*مرجع_النطاق).الأب مع
        | اختياري.لا_شيء -> { تابع := خطأ; }
        | اختياري.موجود(الأب) -> { الحالي := الأب; };
    }
    أرجع الناتج;
}

عام عرف اسم_مقنن_لنص_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    النص: &نص
): اختياري معرف_اسم {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الأسماء) مثل طبيعي)) {
        دع مرجع_الاسم: &اسم_مقنن = &(*السياق).الأسماء[ف];
        إذا (تطابق_هوية_بايتات_ونص(&(*مرجع_الاسم).البايتات, النص)) {
            أرجع اختياري.موجود((*مرجع_الاسم).المعرف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ربط_محلي_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    النطاق: معرف_نطاق,
    الاسم: معرف_اسم
): اختياري معرف_رمز {
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*السياق).النطاقات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_النطاق: &نطاق_أسماء = &(*السياق).النطاقات[النطاق.القيمة];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*مرجع_النطاق).الروابط) مثل طبيعي)) {
        دع الربط: ربط_اسم_نطاق = (*مرجع_النطاق).الروابط[ف];
        إذا (معرفا_اسم_متساويان(الربط.الاسم, الاسم)) {
            أرجع اختياري.موجود(الربط.الرمز);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}
