استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.names.name_context;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.scopes;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.lexer.identifier_queries;
استورد compiler.source.span;
استورد compiler.source.source_map;
استورد compiler.frontend.names.reference_queries;
استورد compiler.frontend.identifier_identity;

// Rename policy is Name-owned. A selected surface NameID is renamed without
// collapsing bilingual/alternate spellings that resolve to the same SymbolID.
عام نوع مالك_ربط_إعادة_تسمية =
    | نطاق بنوع معرف_نطاق
    | رمز بنوع معرف_رمز
;

عام نوع هدف_إعادة_تسمية_دلالي = {
    الرمز: معرف_رمز,
    الاسم: معرف_اسم,
    المالك: مالك_ربط_إعادة_تسمية
};

عام نوع رفض_إعادة_تسمية_دلالي =
    | لا_هدف
    | رمز_غير_قابل_لإعادة_التسمية
    | تهجئة_غير_صالحة
    | تعارض_اسم
;

عام نوع نتيجة_تحضير_إعادة_تسمية_دلالية =
    | جاهز بنوع هدف_إعادة_تسمية_دلالي
    | مرفوض بنوع رفض_إعادة_تسمية_دلالي
;

عام نوع خطة_إعادة_تسمية_دلالية = {
    الهدف: هدف_إعادة_تسمية_دلالي,
    النطاقات: متجه نطاق
};

عام نوع نتيجة_خطة_إعادة_تسمية_دلالية =
    | جاهزة بنوع خطة_إعادة_تسمية_دلالية
    | مرفوضة بنوع رفض_إعادة_تسمية_دلالي
;

عرف نطاق_يحوي_ربط_هدف(
    السياق: &سياق_استعلامات_أسماء,
    النطاق: معرف_نطاق,
    الاسم: معرف_اسم,
    الرمز: معرف_رمز
): منطقي {
    دع قيمة_السياق: سياق_استعلامات_أسماء = *السياق;
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول(قيمة_السياق.النطاقات) مثل طبيعي)) { أرجع خطأ; };
    دع مرجع_القيمة: &نطاق_أسماء = &قيمة_السياق.النطاقات[النطاق.القيمة];
    دع القيمة: نطاق_أسماء = *مرجع_القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة.الروابط) مثل طبيعي)) {
        دع الربط: ربط_اسم_نطاق = القيمة.الروابط[ف];
        إذا (معرفا_اسم_متساويان(الربط.الاسم, الاسم)
            && معرفا_رمز_متساويان(الربط.الرمز, الرمز)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف مالك_ربط_سطحي(
    السياق: &سياق_استعلامات_أسماء,
    الظهور: &ظهور_اسم_محلول,
    الرمز: رمز_دلالي
): اختياري مالك_ربط_إعادة_تسمية {
    دع قيمة_السياق: سياق_استعلامات_أسماء = *السياق;
    دع ظ: ظهور_اسم_محلول = *الظهور;
    طابق الرمز.المالك مع
    | اختياري.موجود(المالك) -> {
        دع الناتج: مالك_ربط_إعادة_تسمية = مالك_ربط_إعادة_تسمية.رمز(المالك);
        أرجع اختياري.موجود(الناتج);
    }
    | اختياري.لا_شيء -> { };

    دع الحالي: متغير معرف_نطاق = الرمز.النطاق_المالك;
    طابق نطاق_دلالي_عند_استعلام(
        السياق, ظ.النطاق.البداية.المصدر, ظ.النطاق.البداية.البايت
    ) مع
    | اختياري.موجود(المعرف) -> { الحالي := المعرف; }
    | اختياري.لا_شيء -> { };

    دع تابع: متغير منطقي = صواب;
    طالما (تابع) {
        إذا (نطاق_يحوي_ربط_هدف(السياق, الحالي, ظ.الاسم, الرمز.المعرف)) {
            دع الناتج: مالك_ربط_إعادة_تسمية = مالك_ربط_إعادة_تسمية.نطاق(الحالي);
            أرجع اختياري.موجود(الناتج);
        };
        إذا ((الحالي.القيمة مثل طبيعي) >= (الطول(قيمة_السياق.النطاقات) مثل طبيعي)) { تابع := خطأ; }
        وإلا {
            طابق قيمة_السياق.النطاقات[الحالي.القيمة].الأب مع
            | اختياري.لا_شيء -> { تابع := خطأ; }
            | اختياري.موجود(الأب) -> { الحالي := الأب; };
        };
    }

    // An imported/reference occurrence may resolve to a top-level symbol whose
    // declaring binding is not part of the use-site lexical ancestry. Name owns
    // that binding through the symbol's canonical declaration scope, so use it
    // rather than rejecting a valid cross-module rename target.
    إذا (نطاق_يحوي_ربط_هدف(
        السياق, الرمز.النطاق_المالك, ظ.الاسم, الرمز.المعرف
    )) {
        دع الناتج: مالك_ربط_إعادة_تسمية =
            مالك_ربط_إعادة_تسمية.نطاق(الرمز.النطاق_المالك);
        أرجع اختياري.موجود(الناتج);
    };

    أرجع اختياري.لا_شيء();
}

عام عرف حضر_إعادة_تسمية_دلالية(
    السياق: &سياق_استعلامات_أسماء,
    الظهور: &ظهور_اسم_محلول
): نتيجة_تحضير_إعادة_تسمية_دلالية {
    دع ظ: ظهور_اسم_محلول = *الظهور;
    دع معرف: متغير معرف_رمز = معرف_رمز_من(0);
    طابق ظ.الرمز مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختياري.موجود(القيمة) -> { معرف := القيمة; };

    دع معرف_صفر: معرف_رمز = معرف_رمز_من(0);
    دع اسم_صفر: معرف_اسم = معرف_اسم_من(0);
    دع نطاق_صفر: نطاق = نطاق_فارغ();
    دع نطاق_مالك_صفر: معرف_نطاق = معرف_نطاق_من(0);
    دع بلا_مالك: اختياري معرف_رمز = اختياري.لا_شيء();
    دع نوع_محلي: نوع_تصريح = نوع_تصريح.ربط_محلي();
    دع الحقيقة: متغير رمز_دلالي = {
        المعرف: معرف_صفر,
        الاسم: اسم_صفر,
        نطاق_الاسم: نطاق_صفر,
        نطاق_التصريح: نطاق_صفر,
        النطاق_المالك: نطاق_مالك_صفر,
        المالك: بلا_مالك,
        النوع: نوع_محلي,
        علني: خطأ
    };
    طابق رمز_دلالي_عند_استعلام(السياق, معرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختياري.موجود(القيمة) -> { الحقيقة := القيمة; };

    إذا (طول_نطاق_بالبايت(الحقيقة.نطاق_الاسم) == 0) {
        أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(
            رفض_إعادة_تسمية_دلالي.رمز_غير_قابل_لإعادة_التسمية()
        );
    };

    طابق مالك_ربط_سطحي(السياق, &ظ, الحقيقة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(رفض_إعادة_تسمية_دلالي.لا_هدف());
    }
    | اختياري.موجود(المالك) -> {
        دع الهدف: هدف_إعادة_تسمية_دلالي = {
            الرمز: معرف,
            الاسم: ظ.الاسم,
            المالك: المالك
        };
        أرجع نتيجة_تحضير_إعادة_تسمية_دلالية.جاهز(الهدف);
    };
}

عرف تعارض_إعادة_تسمية(
    السياق: &سياق_استعلامات_أسماء,
    الهدف: &هدف_إعادة_تسمية_دلالي,
    الاسم_الجديد: معرف_اسم
): منطقي {
    دع قيمة_السياق: سياق_استعلامات_أسماء = *السياق;
    دع ه: هدف_إعادة_تسمية_دلالي = *الهدف;
    إذا (معرفا_اسم_متساويان(ه.الاسم, الاسم_الجديد)) { أرجع خطأ; };
    طابق ه.المالك مع
    | مالك_ربط_إعادة_تسمية.نطاق(النطاق) -> {
        طابق ربط_محلي_عند_استعلام(السياق, النطاق, الاسم_الجديد) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الرمز) -> { أرجع !معرفا_رمز_متساويان(الرمز, ه.الرمز); };
    }
    | مالك_ربط_إعادة_تسمية.رمز(المالك) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(قيمة_السياق.الروابط_التابعة) مثل طبيعي)) {
            دع الربط: ربط_اسم_تابع = قيمة_السياق.الروابط_التابعة[ف];
            إذا (معرفا_رمز_متساويان(الربط.المالك, المالك)
                && معرفا_اسم_متساويان(الربط.الاسم, الاسم_الجديد)
                && !معرفا_رمز_متساويان(الربط.الرمز, ه.الرمز)) {
                أرجع صواب;
            };
            ف := ف + 1;
        }
        أرجع خطأ;
    };
}

عام عرف خطط_إعادة_تسمية_دلالية(
    السياق: &سياق_استعلامات_أسماء,
    الهدف: هدف_إعادة_تسمية_دلالي,
    الاسم_الجديد: &نص,
    الروابط: &متجه سياق_روابط_أسماء
): نتيجة_خطة_إعادة_تسمية_دلالية {
    إذا (!تهجئة_معرف_مصدر_صالحة(الاسم_الجديد)) {
        أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(
            رفض_إعادة_تسمية_دلالي.تهجئة_غير_صالحة()
        );
    };

    طابق اسم_مقنن_لنص_عند_استعلام(السياق, الاسم_الجديد) مع
    | اختياري.موجود(الهوية) -> {
        إذا (تعارض_إعادة_تسمية(السياق, &الهدف, الهوية)) {
            أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(
                رفض_إعادة_تسمية_دلالي.تعارض_اسم()
            );
        };
        // A rename that would make any existing use resolve differently
        // (captured by an inner binding, capturing another Symbol's uses, or
        // colliding with an imported name) is a name conflict too.
        دع التعارضات: متجه تعارض_إعادة_تسمية_دلالي = تعارضات_إعادة_تسمية_دلالية(
            السياق, &الهدف, الهوية, الروابط
        );
        إذا ((الطول(التعارضات) مثل طبيعي) > 0) {
            أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(
                رفض_إعادة_تسمية_دلالي.تعارض_اسم()
            );
        };
    }
    | اختياري.لا_شيء -> { };

    دع النطاقات: متغير متجه نطاق = [];
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الروابط) مثل طبيعي)) {
        دع مرجع_روابط: &سياق_روابط_أسماء = &(*الروابط)[و];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_روابط).الظهورات) مثل طبيعي)) {
            دع مرجع_الظهور: &ظهور_اسم_محلول = &(*مرجع_روابط).الظهورات[ف];
            دع الظهور: ظهور_اسم_محلول = *مرجع_الظهور;
            إذا (معرفا_اسم_متساويان(الظهور.الاسم, الهدف.الاسم)) {
                طابق الظهور.الرمز مع
                | اختياري.موجود(الرمز) -> {
                    // A `let` name is recorded as its declaration and as its
                    // initialization target: one edit per span.
                    دع العدد: طبيعي = الطول(النطاقات) مثل طبيعي;
                    دع مكرر: متغير منطقي = خطأ;
                    إذا (العدد > 0) { مكرر := نطاقان_متساويان(النطاقات[العدد - 1], الظهور.النطاق); };
                    إذا (معرفا_رمز_متساويان(الرمز, الهدف.الرمز) && !مكرر) {
                        ألحق(النطاقات, الظهور.النطاق);
                    };
                }
                | اختياري.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        و := و + 1;
    }

    إذا ((الطول(النطاقات) مثل طبيعي) == 0) {
        أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
    };
    دع الخطة: خطة_إعادة_تسمية_دلالية = { الهدف: الهدف, النطاقات: النطاقات };
    أرجع نتيجة_خطة_إعادة_تسمية_دلالية.جاهزة(الخطة);
}

// The rename plan over the SourceMap: like خطط_إعادة_تسمية_دلالية, but an
// occurrence is edited only when it is spelled like the selected one
// (المكتوبة, its identifier identity). Name records an alias's uses under the
// Symbol's own Name, so the spelling, not the NameID, keeps an `alias` or a
// bilingual spelling untouched.
عام عرف خطط_إعادة_تسمية_دلالية_بمصادر(
    السياق: &سياق_استعلامات_أسماء,
    الهدف: هدف_إعادة_تسمية_دلالي,
    الاسم_الجديد: &نص,
    الروابط: &متجه سياق_روابط_أسماء,
    الخريطة: &خريطة_مصادر,
    المكتوبة: &متجه ط8
): نتيجة_خطة_إعادة_تسمية_دلالية {
    طابق خطط_إعادة_تسمية_دلالية(السياق, الهدف, الاسم_الجديد, الروابط) مع
    | نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(السبب) -> { أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(السبب); }
    | نتيجة_خطة_إعادة_تسمية_دلالية.جاهزة(الخطة) -> {
        // Every occurrence of the Symbol spelled like the selected one, whatever
        // Name identity Name recorded for it.
        دع النطاقات: متغير متجه نطاق = [];
        دع و: متغير طبيعي = 0;
        طالما (و < (الطول(*الروابط) مثل طبيعي)) {
            دع مرجع_روابط: &سياق_روابط_أسماء = &(*الروابط)[و];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*مرجع_روابط).الظهورات) مثل طبيعي)) {
                دع الظهور: ظهور_اسم_محلول = (*مرجع_روابط).الظهورات[ف];
                طابق الظهور.الرمز مع
                | اختياري.موجود(الرمز) -> {
                    دع العدد: طبيعي = الطول(النطاقات) مثل طبيعي;
                    دع مكرر: متغير منطقي = خطأ;
                    إذا (العدد > 0) { مكرر := نطاقان_متساويان(النطاقات[العدد - 1], الظهور.النطاق); };
                    إذا (معرفا_رمز_متساويان(الرمز, الخطة.الهدف.الرمز) && !مكرر) {
                        دع هوية_النطاق: متجه ط8 = هوية_مكتوبة_عند(الخريطة, الظهور.النطاق);
                        إذا (هويتان_معرفيتان_متساويتان(&هوية_النطاق, المكتوبة)) { ألحق(النطاقات, الظهور.النطاق); };
                    };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            و := و + 1;
        }
        إذا ((الطول(النطاقات) مثل طبيعي) == 0) {
            أرجع نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(رفض_إعادة_تسمية_دلالي.لا_هدف());
        };
        دع المصفاة: خطة_إعادة_تسمية_دلالية = { الهدف: الخطة.الهدف, النطاقات: النطاقات };
        أرجع نتيجة_خطة_إعادة_تسمية_دلالية.جاهزة(المصفاة);
    };
}

// Canonical semantic classification for tooling consumers. Name owns the
// declaration kind and the resolved occurrence-to-Symbol relation; consumers
// must not recreate this classification from source spelling.
عام نوع ظهور_مصنف_دلاليا = {
    النطاق: نطاق,
    الرمز: معرف_رمز,
    النوع: نوع_تصريح,
    تصريح: منطقي
};

عرف نطاقا_اسم_متساويان(أ: نطاق, ب: نطاق): منطقي {
    أرجع أ.البداية.المصدر == ب.البداية.المصدر
        && أ.البداية.البايت == ب.البداية.البايت
        && أ.النهاية.المصدر == ب.النهاية.المصدر
        && أ.النهاية.البايت == ب.النهاية.البايت;
}

عام عرف صنف_ظهورات_مصدر_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    الروابط: &سياق_روابط_أسماء,
    المصدر: طبيعي
): متجه ظهور_مصنف_دلاليا {
    دع الناتج: متغير متجه ظهور_مصنف_دلاليا = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الروابط).الظهورات) مثل طبيعي)) {
        دع مرجع_الظهور: &ظهور_اسم_محلول = &(*الروابط).الظهورات[ف];
        دع الظهور: ظهور_اسم_محلول = *مرجع_الظهور;
        إذا ((الظهور.النطاق.البداية.المصدر مثل طبيعي) == المصدر) {
            طابق الظهور.الرمز مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المعرف) -> {
                طابق رمز_دلالي_عند_استعلام(السياق, المعرف) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الرمز) -> {
                    دع هل_تصريح: منطقي = نطاقا_اسم_متساويان(الظهور.النطاق, الرمز.نطاق_الاسم);
                    دع مصنف: ظهور_مصنف_دلاليا = {
                        النطاق: الظهور.النطاق,
                        الرمز: المعرف,
                        النوع: الرمز.النوع,
                        تصريح: هل_تصريح
                    };
                    ألحق(الناتج, مصنف);
                };
            };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Canonical symbol enumeration is retained with the compact Name tooling
// snapshot. Source filtering is by the symbol's canonical declaration span.
عام عرف رموز_مصدر_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    المصدر: طبيعي
): متجه رمز_دلالي {
    دع قيمة_السياق: سياق_استعلامات_أسماء = *السياق;
    دع الناتج: متغير متجه رمز_دلالي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(قيمة_السياق.الرموز) مثل طبيعي)) {
        دع مرجع_الرمز: &رمز_دلالي = &قيمة_السياق.الرموز[ف];
        دع الرمز: رمز_دلالي = *مرجع_الرمز;
        إذا (طول_نطاق_بالبايت(الرمز.نطاق_الاسم) > 0
            && (الرمز.نطاق_الاسم.البداية.المصدر مثل طبيعي) == المصدر) {
            ألحق(الناتج, الرمز);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف كل_الرموز_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء
): متجه رمز_دلالي {
    دع قيمة_السياق: سياق_استعلامات_أسماء = *السياق;
    دع الناتج: متغير متجه رمز_دلالي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(قيمة_السياق.الرموز) مثل طبيعي)) {
        دع مرجع_الرمز: &رمز_دلالي = &قيمة_السياق.الرموز[ف];
        دع الرمز: رمز_دلالي = *مرجع_الرمز;
        إذا (طول_نطاق_بالبايت(الرمز.نطاق_الاسم) > 0) { ألحق(الناتج, الرمز); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Returns the canonical function Symbol whose declaration range contains the
// source point. Name owns declaration extents and declaration kinds, so callers
// such as tooling do not reconstruct function ownership from syntax.
عام عرف رمز_دالة_حاوية_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء,
    المصدر: طبيعي,
    البايت: طبيعي
): اختياري معرف_رمز {
    دع قيمة_السياق: سياق_استعلامات_أسماء = *السياق;
    دع الأفضل: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    دع أفضل_طول: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(قيمة_السياق.الرموز) مثل طبيعي)) {
        دع مرجع_الرمز: &رمز_دلالي = &قيمة_السياق.الرموز[ف];
        دع الرمز: رمز_دلالي = *مرجع_الرمز;
        دع هل_دالة: منطقي = الرمز.النوع == نوع_تصريح.دالة();
        إذا (هل_دالة && نطاق_يحتوي_بايتا(الرمز.نطاق_التصريح, المصدر, البايت)) {
            دع طول_الحالي: طبيعي = طول_نطاق_بالبايت(الرمز.نطاق_التصريح);
            دع اختر: متغير منطقي = خطأ;
            طابق الأفضل مع
            | اختياري.لا_شيء -> { اختر := صواب; }
            | اختياري.موجود(_) -> { إذا (طول_الحالي < أفضل_طول) { اختر := صواب; }; };
            إذا (اختر) {
                الأفضل := اختياري.موجود(الرمز.المعرف);
                أفضل_طول := طول_الحالي;
            };
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}

// ---- Rename safety --------------------------------------------------------------
// A rename keeps every resolution as it was. Name binds lexically and in
// order (a local is visible after its declaration, an inner binding shadows an
// outer one), so a new spelling changes resolution when:
//   نفس_النطاق    the binding scope (or the owner's member namespace) already
//                 binds the new name;
//   التقاط_داخلي  a use of the target lies under a nearer binding of the new
//                 name, which would capture it;
//   التقاط_خارجي  a use of another Symbol spelled with the new name lies in the
//                 target's region with no nearer binding, so the renamed
//                 target would capture it;
//   تعارض_وحدة    a public top-level target is used by a module that already
//                 reaches another module's Symbol by the new name.
// Value and type names are looked up in their own namespaces (حيز_اسم), so a
// binding of the other namespace is no conflict.
عام نوع نوع_تعارض_إعادة_تسمية =
    | نفس_النطاق
    | التقاط_داخلي
    | التقاط_خارجي
    | تعارض_وحدة
;

// النطاق: the occurrence or declaration where resolution would change;
// الرمز_الآخر: the other Symbol involved.
عام نوع تعارض_إعادة_تسمية_دلالي = {
    النوع: نوع_تعارض_إعادة_تسمية,
    النطاق: نطاق,
    الرمز_الآخر: اختياري معرف_رمز
};

// Spanned scopes grouped by SourceID (a counting sort of the scope table) and
// the module root scope of every source, built once per rename query.
نوع فهرس_نطاقات_المصادر = {
    الإزاحات: متجه طبيعي,
    النطاقات: متجه طبيعي,
    الجذور: متجه طبيعي
};

عرف جذر_نطاق_استعلام(السياق: &سياق_استعلامات_أسماء, النطاق: معرف_نطاق): معرف_نطاق {
    دع الحالي: متغير معرف_نطاق = النطاق;
    دع الحد: طبيعي = الطول((*السياق).النطاقات) مثل طبيعي;
    دع الخطوات: متغير طبيعي = 0;
    طالما (الخطوات <= الحد) {
        إذا ((الحالي.القيمة مثل طبيعي) >= الحد) { أرجع الحالي; };
        طابق (*السياق).النطاقات[الحالي.القيمة].الأب مع
        | اختياري.لا_شيء -> { أرجع الحالي; }
        | اختياري.موجود(الأب) -> { الحالي := الأب; };
        الخطوات := الخطوات + 1;
    }
    أرجع الحالي;
}

عرف ابن_فهرس_نطاقات_المصادر(السياق: &سياق_استعلامات_أسماء): فهرس_نطاقات_المصادر {
    دع عدد_النطاقات: طبيعي = الطول((*السياق).النطاقات) مثل طبيعي;
    دع عدد_المصادر: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_النطاقات) {
        طابق (*السياق).النطاقات[ف].نطاق_المصدر مع
        | اختياري.موجود(المدى) -> {
            إذا ((المدى.البداية.المصدر مثل طبيعي) + 1 > عدد_المصادر) { عدد_المصادر := (المدى.البداية.المصدر مثل طبيعي) + 1; };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع عدد_الرموز: طبيعي = الطول((*السياق).الرموز) مثل طبيعي;
    ف := 0;
    طالما (ف < عدد_الرموز) {
        دع مصدر_الرمز: طبيعي = (*السياق).الرموز[ف].نطاق_الاسم.البداية.المصدر مثل طبيعي;
        إذا (مصدر_الرمز + 1 > عدد_المصادر) { عدد_المصادر := مصدر_الرمز + 1; };
        ف := ف + 1;
    }
    دع الإزاحات: متغير متجه طبيعي = [];
    دع الجذور: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف <= عدد_المصادر) {
        ألحق(الإزاحات, 0);
        ألحق(الجذور, 0);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < عدد_النطاقات) {
        طابق (*السياق).النطاقات[ف].نطاق_المصدر مع
        | اختياري.موجود(المدى) -> {
            دع م: طبيعي = المدى.البداية.المصدر مثل طبيعي;
            الإزاحات[م + 1] := الإزاحات[م + 1] + 1;
            إذا (الجذور[م] == 0) {
                الجذور[م] := (جذر_نطاق_استعلام(السياق, (*السياق).النطاقات[ف].المعرف).القيمة مثل طبيعي) + 1;
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    // A source with no spanned scope (declarations only): its root is the
    // binding scope of a top-level Symbol it declares.
    ف := 0;
    طالما (ف < عدد_الرموز) {
        دع الرمز: رمز_دلالي = (*السياق).الرموز[ف];
        دع م: طبيعي = الرمز.نطاق_الاسم.البداية.المصدر مثل طبيعي;
        إذا (طول_نطاق_بالبايت(الرمز.نطاق_الاسم) > 0 && الجذور[م] == 0
            && (الرمز.النطاق_المالك.القيمة مثل طبيعي) < عدد_النطاقات) {
            طابق (*السياق).النطاقات[الرمز.النطاق_المالك.القيمة].الأب مع
            | اختياري.لا_شيء -> { الجذور[م] := (الرمز.النطاق_المالك.القيمة مثل طبيعي) + 1; }
            | اختياري.موجود(_) -> { };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < عدد_المصادر) {
        الإزاحات[ف + 1] := الإزاحات[ف + 1] + الإزاحات[ف];
        ف := ف + 1;
    }
    دع المؤشرات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف <= عدد_المصادر) {
        ألحق(المؤشرات, الإزاحات[ف]);
        ف := ف + 1;
    }
    دع النطاقات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_النطاقات) {
        ألحق(النطاقات, 0);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < عدد_النطاقات) {
        طابق (*السياق).النطاقات[ف].نطاق_المصدر مع
        | اختياري.موجود(المدى) -> {
            دع م: طبيعي = المدى.البداية.المصدر مثل طبيعي;
            النطاقات[المؤشرات[م]] := ف;
            المؤشرات[م] := المؤشرات[م] + 1;
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع الفهرس: فهرس_نطاقات_المصادر = {
        الإزاحات: الإزاحات,
        النطاقات: النطاقات,
        الجذور: الجذور
    };
    أرجع الفهرس;
}

// The lexical scopes at a source point, innermost first, ending at the
// module root scope.
عرف سلسلة_نطاقات_عند(
    السياق: &سياق_استعلامات_أسماء,
    الفهرس: &فهرس_نطاقات_المصادر,
    المصدر: طبيعي,
    البايت: طبيعي
): متجه معرف_نطاق {
    دع الناتج: متغير متجه معرف_نطاق = [];
    إذا (المصدر + 1 >= (الطول((*الفهرس).الإزاحات) مثل طبيعي)) { أرجع الناتج; };
    دع موجود: متغير منطقي = خطأ;
    دع الأفضل: متغير طبيعي = 0;
    دع أفضل_طول: متغير طبيعي = 0;
    دع ف: متغير طبيعي = (*الفهرس).الإزاحات[المصدر];
    دع النهاية: طبيعي = (*الفهرس).الإزاحات[المصدر + 1];
    طالما (ف < النهاية) {
        دع النطاق: طبيعي = (*الفهرس).النطاقات[ف];
        طابق (*السياق).النطاقات[النطاق].نطاق_المصدر مع
        | اختياري.موجود(المدى) -> {
            إذا (نطاق_يحتوي_بايتا(المدى, المصدر, البايت)) {
                دع الطول_الحالي: طبيعي = طول_نطاق_بالبايت(المدى);
                إذا ((!موجود) || (الطول_الحالي <= أفضل_طول)) {
                    موجود := صواب;
                    الأفضل := النطاق;
                    أفضل_طول := الطول_الحالي;
                };
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع الحالي: متغير معرف_نطاق = معرف_نطاق_من(0);
    إذا (موجود) { الحالي := معرف_نطاق_من(الأفضل); }
    وإلا {
        دع الجذر: طبيعي = (*الفهرس).الجذور[المصدر];
        إذا (الجذر == 0) { أرجع الناتج; };
        الحالي := معرف_نطاق_من(الجذر - 1);
    };
    دع الحد: طبيعي = الطول((*السياق).النطاقات) مثل طبيعي;
    دع تابع: متغير منطقي = صواب;
    طالما (تابع && (الطول(الناتج) مثل طبيعي) <= الحد) {
        ألحق(الناتج, الحالي);
        طابق (*السياق).النطاقات[الحالي.القيمة].الأب مع
        | اختياري.لا_شيء -> { تابع := خطأ; }
        | اختياري.موجود(الأب) -> { الحالي := الأب; };
    }
    أرجع الناتج;
}

عرف حيز_تصريحين_مشترك(أ: نوع_تصريح, ب: نوع_تصريح): منطقي {
    أرجع هل_نوع_تصريح_في_حيز(أ, حيز_اسم.نوع()) == هل_نوع_تصريح_في_حيز(ب, حيز_اسم.نوع());
}

// Whether a Symbol bound in a scope on the chain is visible at a use: a local
// binding only after its declaration.
عرف رمز_مرئي_عند_ظهور(الرمز: &رمز_دلالي, الظهور: نطاق): منطقي {
    إذا ((*الرمز).النوع == نوع_تصريح.ربط_محلي()
        && (*الرمز).نطاق_الاسم.البداية.المصدر == الظهور.البداية.المصدر
        && (*الرمز).نطاق_الاسم.البداية.البايت > الظهور.البداية.البايت) {
        أرجع خطأ;
    };
    أرجع صواب;
}

// A Symbol other than المستثنى that النطاق binds to الاسم, of the same namespace
// as النوع and visible at الظهور.
عرف ربط_مرئي_في_نطاق(
    السياق: &سياق_استعلامات_أسماء,
    النطاق: معرف_نطاق,
    الاسم: معرف_اسم,
    المستثنى: معرف_رمز,
    النوع: نوع_تصريح,
    الظهور: نطاق
): اختياري معرف_رمز {
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*السياق).النطاقات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع مرجع_النطاق: &نطاق_أسماء = &(*السياق).النطاقات[النطاق.القيمة];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*مرجع_النطاق).الروابط) مثل طبيعي)) {
        دع الربط: ربط_اسم_نطاق = (*مرجع_النطاق).الروابط[ف];
        إذا (معرفا_اسم_متساويان(الربط.الاسم, الاسم) && !معرفا_رمز_متساويان(الربط.الرمز, المستثنى)) {
            طابق رمز_دلالي_عند_استعلام(السياق, الربط.الرمز) مع
            | اختياري.موجود(الحقيقة) -> {
                إذا (حيز_تصريحين_مشترك(الحقيقة.النوع, النوع) && رمز_مرئي_عند_ظهور(&الحقيقة, الظهور)) {
                    أرجع اختياري.موجود(الربط.الرمز);
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف وحدة_نطاق_استعلام(السياق: &سياق_استعلامات_أسماء, النطاق: معرف_نطاق): اختياري طبيعي {
    إذا ((النطاق.القيمة مثل طبيعي) >= (الطول((*السياق).النطاقات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*السياق).النطاقات[النطاق.القيمة].الوحدة.القيمة مثل طبيعي);
}

عرف ألحق_تعارض_إعادة_تسمية(
    الناتج: &متغير متجه تعارض_إعادة_تسمية_دلالي,
    النوع: نوع_تعارض_إعادة_تسمية,
    النطاق: نطاق,
    الآخر: اختياري معرف_رمز
): فراغ {
    دع التعارض: تعارض_إعادة_تسمية_دلالي = { النوع: النوع, النطاق: النطاق, الرمز_الآخر: الآخر };
    ألحق(*الناتج, التعارض);
}

عام عرف تعارضات_إعادة_تسمية_دلالية(
    السياق: &سياق_استعلامات_أسماء,
    الهدف: &هدف_إعادة_تسمية_دلالي,
    الاسم_الجديد: معرف_اسم,
    الروابط: &متجه سياق_روابط_أسماء
): متجه تعارض_إعادة_تسمية_دلالي {
    دع الناتج: متغير متجه تعارض_إعادة_تسمية_دلالي = [];
    دع ه: هدف_إعادة_تسمية_دلالي = *الهدف;
    إذا (معرفا_اسم_متساويان(ه.الاسم, الاسم_الجديد)) { أرجع الناتج; };
    دع الحقيقة: رمز_دلالي;
    طابق رمز_دلالي_عند_استعلام(السياق, ه.الرمز) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(القيمة) -> { الحقيقة := القيمة; };

    دع نطاق_الربط: متغير معرف_نطاق = معرف_نطاق_من(0);
    طابق ه.المالك مع
    | مالك_ربط_إعادة_تسمية.رمز(المالك) -> {
        // A member (an enum constructor) is looked up through its owner only.
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*السياق).الروابط_التابعة) مثل طبيعي)) {
            دع الربط: ربط_اسم_تابع = (*السياق).الروابط_التابعة[ف];
            إذا (معرفا_رمز_متساويان(الربط.المالك, المالك)
                && معرفا_اسم_متساويان(الربط.الاسم, الاسم_الجديد)
                && !معرفا_رمز_متساويان(الربط.الرمز, ه.الرمز)) {
                طابق رمز_دلالي_عند_استعلام(السياق, الربط.الرمز) مع
                | اختياري.موجود(الآخر) -> {
                    ألحق_تعارض_إعادة_تسمية(&متغير الناتج, نوع_تعارض_إعادة_تسمية.نفس_النطاق(), الآخر.نطاق_الاسم, اختياري.موجود(الربط.الرمز));
                }
                | اختياري.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    }
    | مالك_ربط_إعادة_تسمية.نطاق(النطاق) -> { نطاق_الربط := النطاق; };

    طابق ربط_محلي_عند_استعلام(السياق, نطاق_الربط, الاسم_الجديد) مع
    | اختياري.موجود(الآخر) -> {
        إذا (!معرفا_رمز_متساويان(الآخر, ه.الرمز)) {
            طابق رمز_دلالي_عند_استعلام(السياق, الآخر) مع
            | اختياري.موجود(حقيقة_الآخر) -> {
                ألحق_تعارض_إعادة_تسمية(&متغير الناتج, نوع_تعارض_إعادة_تسمية.نفس_النطاق(), حقيقة_الآخر.نطاق_الاسم, اختياري.موجود(الآخر));
            }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> { };

    دع الفهرس: فهرس_نطاقات_المصادر = ابن_فهرس_نطاقات_المصادر(السياق);
    دع وحدة_الهدف: متغير طبيعي = 0;
    طابق وحدة_نطاق_استعلام(السياق, نطاق_الربط) مع
    | اختياري.موجود(القيمة) -> { وحدة_الهدف := القيمة; }
    | اختياري.لا_شيء -> { أرجع الناتج; };
    دع نطاق_جذري: منطقي = معرفا_نطاق_متساويان(جذر_نطاق_استعلام(السياق, نطاق_الربط), نطاق_الربط);
    دع علني_أعلى: منطقي = الحقيقة.علني && نطاق_جذري;

    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الروابط) مثل طبيعي)) {
        دع مرجع_الروابط: &سياق_روابط_أسماء = &(*الروابط)[و];
        دع عدد_الظهورات: طبيعي = الطول((*مرجع_الروابط).الظهورات) مثل طبيعي;
        // The module of this binding context, and whether it uses anything the
        // target's module declares (it imports that module).
        دع وحدة_الشجرة: متغير اختياري طبيعي = اختياري.لا_شيء();
        دع يستخدم_وحدة_الهدف: متغير منطقي = خطأ;
        إذا (علني_أعلى && عدد_الظهورات > 0) {
            دع أول_مصدر: طبيعي = (*مرجع_الروابط).الظهورات[0].النطاق.البداية.المصدر مثل طبيعي;
            إذا (أول_مصدر < (الطول(الفهرس.الجذور) مثل طبيعي) && الفهرس.الجذور[أول_مصدر] != 0) {
                وحدة_الشجرة := وحدة_نطاق_استعلام(السياق, معرف_نطاق_من(الفهرس.الجذور[أول_مصدر] - 1));
            };
            دع ف: متغير طبيعي = 0;
            طالما (ف < عدد_الظهورات && !يستخدم_وحدة_الهدف) {
                طابق (*مرجع_الروابط).الظهورات[ف].الرمز مع
                | اختياري.موجود(المعرف) -> {
                    طابق رمز_دلالي_عند_استعلام(السياق, المعرف) مع
                    | اختياري.موجود(الحقيقة_المستخدمة) -> {
                        طابق وحدة_نطاق_استعلام(السياق, الحقيقة_المستخدمة.النطاق_المالك) مع
                        | اختياري.موجود(القيمة) -> { إذا (القيمة == وحدة_الهدف) { يستخدم_وحدة_الهدف := صواب; }; }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
        };
        دع وحدة_أخرى: متغير منطقي = خطأ;
        طابق وحدة_الشجرة مع
        | اختياري.موجود(القيمة) -> { وحدة_أخرى := القيمة != وحدة_الهدف; }
        | اختياري.لا_شيء -> { };

        دع ف: متغير طبيعي = 0;
        طالما (ف < عدد_الظهورات) {
            دع الظهور: ظهور_اسم_محلول = (*مرجع_الروابط).الظهورات[ف];
            طابق الظهور.الرمز مع
            | اختياري.موجود(المعرف) -> {
                دع المصدر: طبيعي = الظهور.النطاق.البداية.المصدر مثل طبيعي;
                دع البايت: طبيعي = الظهور.النطاق.البداية.البايت مثل طبيعي;
                إذا (معرفا_رمز_متساويان(المعرف, ه.الرمز)
                    && معرفا_اسم_متساويان(الظهور.الاسم, ه.الاسم)
                    && !نطاقان_متساويان(الظهور.النطاق, الحقيقة.نطاق_الاسم)) {
                    // Inner capture: a nearer scope binds the new name.
                    دع السلسلة: متجه معرف_نطاق = سلسلة_نطاقات_عند(السياق, &الفهرس, المصدر, البايت);
                    دع ك: متغير طبيعي = 0;
                    دع تابع: متغير منطقي = صواب;
                    طالما (تابع && ك < (الطول(السلسلة) مثل طبيعي)) {
                        إذا (معرفا_نطاق_متساويان(السلسلة[ك], نطاق_الربط)) { تابع := خطأ; }
                        وإلا {
                            طابق ربط_مرئي_في_نطاق(
                                السياق, السلسلة[ك], الاسم_الجديد, ه.الرمز, الحقيقة.النوع, الظهور.النطاق
                            ) مع
                            | اختياري.موجود(الآخر) -> {
                                ألحق_تعارض_إعادة_تسمية(&متغير الناتج, نوع_تعارض_إعادة_تسمية.التقاط_داخلي(), الظهور.النطاق, اختياري.موجود(الآخر));
                                تابع := خطأ;
                            }
                            | اختياري.لا_شيء -> { };
                        };
                        ك := ك + 1;
                    }
                } وإلا إذا (معرفا_اسم_متساويان(الظهور.الاسم, الاسم_الجديد)
                    && !معرفا_رمز_متساويان(المعرف, ه.الرمز)) {
                    طابق رمز_دلالي_عند_استعلام(السياق, المعرف) مع
                    | اختياري.موجود(الآخر) -> {
                        دع مرشح: منطقي = !نطاقان_متساويان(الظهور.النطاق, الآخر.نطاق_الاسم)
                            && حيز_تصريحين_مشترك(الآخر.النوع, الحقيقة.النوع);
                        دع بلا_مالك: متغير منطقي = صواب;
                        طابق الآخر.المالك مع
                        | اختياري.موجود(_) -> { بلا_مالك := خطأ; }
                        | اختياري.لا_شيء -> { };
                        إذا (مرشح && بلا_مالك) {
                            // Outer capture: the use reaches the target's binding
                            // scope before any nearer binding of the new name.
                            إذا (رمز_مرئي_عند_ظهور(&الحقيقة, الظهور.النطاق)) {
                                دع السلسلة: متجه معرف_نطاق = سلسلة_نطاقات_عند(السياق, &الفهرس, المصدر, البايت);
                                دع ك: متغير طبيعي = 0;
                                دع تابع: متغير منطقي = صواب;
                                طالما (تابع && ك < (الطول(السلسلة) مثل طبيعي)) {
                                    إذا (معرفا_نطاق_متساويان(السلسلة[ك], نطاق_الربط)) {
                                        ألحق_تعارض_إعادة_تسمية(&متغير الناتج, نوع_تعارض_إعادة_تسمية.التقاط_خارجي(), الظهور.النطاق, اختياري.موجود(المعرف));
                                        تابع := خطأ;
                                    } وإلا {
                                        طابق ربط_مرئي_في_نطاق(
                                            السياق, السلسلة[ك], الاسم_الجديد, ه.الرمز, الحقيقة.النوع, الظهور.النطاق
                                        ) مع
                                        | اختياري.موجود(_) -> { تابع := خطأ; }
                                        | اختياري.لا_شيء -> { };
                                    };
                                    ك := ك + 1;
                                }
                            };
                            // Module collision: an importing module already
                            // reaches another module's Symbol by the new name.
                            إذا (وحدة_أخرى && يستخدم_وحدة_الهدف) {
                                طابق وحدة_نطاق_استعلام(السياق, الآخر.النطاق_المالك) مع
                                | اختياري.موجود(وحدة_الآخر) -> {
                                    دع وحدة_هذه: متغير طبيعي = وحدة_الهدف;
                                    طابق وحدة_الشجرة مع
                                    | اختياري.موجود(القيمة) -> { وحدة_هذه := القيمة; }
                                    | اختياري.لا_شيء -> { };
                                    إذا (وحدة_الآخر != وحدة_هذه) {
                                        ألحق_تعارض_إعادة_تسمية(&متغير الناتج, نوع_تعارض_إعادة_تسمية.تعارض_وحدة(), الظهور.النطاق, اختياري.موجود(المعرف));
                                    };
                                }
                                | اختياري.لا_شيء -> { };
                            };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    أرجع الناتج;
}

// ---- Workspace symbols ----------------------------------------------------------
// Module-level declarations (functions, external functions, type aliases,
// records, enums and their constructors, module values) with the module that
// declares them and, for a constructor, its enum. Parameters and locals are
// not listed.
عام نوع رمز_أعلى_دلالي = {
    الرمز: رمز_دلالي,
    الحاوية: اختياري معرف_رمز,
    الوحدة: معرف_وحدة
};

عرف نوع_تصريح_أعلى(النوع: نوع_تصريح): منطقي {
    طابق النوع مع
    | نوع_تصريح.معامل -> { أرجع خطأ; }
    | نوع_تصريح.معامل_نوع -> { أرجع خطأ; }
    | نوع_تصريح.ربط_محلي -> { أرجع خطأ; }
    | _ -> { أرجع صواب; };
}

عام عرف رموز_عليا_عند_استعلام(
    السياق: &سياق_استعلامات_أسماء
): متجه رمز_أعلى_دلالي {
    دع الناتج: متغير متجه رمز_أعلى_دلالي = [];
    دع عدد_النطاقات: طبيعي = الطول((*السياق).النطاقات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الرموز) مثل طبيعي)) {
        دع الرمز: رمز_دلالي = (*السياق).الرموز[ف];
        إذا (طول_نطاق_بالبايت(الرمز.نطاق_الاسم) > 0 && نوع_تصريح_أعلى(الرمز.النوع)
            && (الرمز.النطاق_المالك.القيمة مثل طبيعي) < عدد_النطاقات) {
            دع العنصر: رمز_أعلى_دلالي = {
                الرمز: الرمز,
                الحاوية: الرمز.المالك,
                الوحدة: (*السياق).النطاقات[الرمز.النطاق_المالك.القيمة].الوحدة
            };
            ألحق(الناتج, العنصر);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}
