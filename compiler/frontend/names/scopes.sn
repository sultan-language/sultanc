// ربط الاسم داخل النطاق يشير إلى الرمز المقنن نفسه؛ الاسم البديل لا يخصص رمزا جديدا.
عام نوع ربط_اسم_نطاق = {
    الاسم: معرف_اسم,
    الرمز: معرف_رمز
};

عام نوع نطاق_أسماء = {
    المعرف: معرف_نطاق,
    الأب: اختيار معرف_نطاق,
    الوحدة: معرف_وحدة,
    نطاق_المصدر: اختيار نطاق,
    الرموز: متجه معرف_رمز,
    الروابط: متجه ربط_اسم_نطاق
};
