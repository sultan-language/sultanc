// Refactoring queries over one tooling Frontend result (نتيجة_واجهة_وحدة built
// with احتفظ_بحقائق_الأدوات). This module only composes facts the canonical
// layers already own: Name (Symbols, scopes, resolved occurrences), the AST
// trees, Type (Symbol and expression Types), SSF (moves) and the SourceMap
// (positions). It holds no state, copies no owner and is imported by no
// compiler phase, so a compilation that does not call it pays nothing.

// ---- Positions ------------------------------------------------------------------
// A source position as editors count it: the 0-based line, the column in UTF-8
// bytes and the column in UTF-16 code units (LSP). Arabic letters are two
// UTF-8 bytes and one UTF-16 unit; letters outside the BMP are four and two.
عام نوع موضع_أداة = {
    السطر: طبيعي,
    العمود_بايت: طبيعي,
    العمود_يوتيف16: طبيعي
};

عام نوع مدى_أداة = {
    المصدر: طبيعي,
    البداية: موضع_أداة,
    النهاية: موضع_أداة
};

نوع فهرس_سطور_مصدر_أداة = {
    المصدر: طبيعي,
    الفهرس: فهرس_سطور
};

عرف موضع_أداة_عند(المصدر: &مصدر, الفهرس: &فهرس_سطور, البايت: طبيعي): اختياري موضع_أداة {
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(&(*المصدر).المحتوى, الفهرس, البايت) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> {
        طابق بداية_السطر(الفهرس, الموضع.السطر) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(البداية) -> {
            دع الناتج: موضع_أداة = {
                السطر: الموضع.السطر,
                العمود_بايت: البايت - البداية,
                العمود_يوتيف16: الموضع.العمود
            };
            أرجع اختياري.موجود(الناتج);
        };
    };
}

// Editor ranges of canonical spans. Each source's line index is built once for
// the whole batch; a span outside the SourceMap has none.
عام عرف مديات_أداة_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    النطاقات: &متجه نطاق
): متجه اختياري مدى_أداة {
    دع الناتج: متغير متجه اختياري مدى_أداة = [];
    دع الفهارس: متغير متجه فهرس_سطور_مصدر_أداة = [];
    دع الخريطة: &خريطة_مصادر = &(*الواجهة).خريطة_المصادر;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النطاقات) مثل طبيعي)) {
        دع النطاق: نطاق = (*النطاقات)[ف];
        دع المصدر: طبيعي = النطاق.البداية.المصدر مثل طبيعي;
        دع المدى: متغير اختياري مدى_أداة = اختياري.لا_شيء();
        إذا (المصدر < (الطول((*الخريطة).المصادر) مثل طبيعي)
            && (*الخريطة).المصادر[المصدر].المعرف == المصدر
            && النطاق.النهاية.المصدر == النطاق.البداية.المصدر) {
            دع موضع_الفهرس: متغير اختياري طبيعي = اختياري.لا_شيء();
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول(الفهارس) مثل طبيعي)) {
                إذا (الفهارس[ك].المصدر == المصدر) { موضع_الفهرس := اختياري.موجود(ك); };
                ك := ك + 1;
            }
            دع موضع: متغير طبيعي = 0;
            طابق موضع_الفهرس مع
            | اختياري.موجود(القيمة) -> { موضع := القيمة; }
            | اختياري.لا_شيء -> {
                دع الجديد: فهرس_سطور_مصدر_أداة = {
                    المصدر: المصدر,
                    الفهرس: ابن_فهرس_السطور(&(*الخريطة).المصادر[المصدر].المحتوى)
                };
                موضع := الطول(الفهارس) مثل طبيعي;
                ألحق(الفهارس, الجديد);
            };
            دع مرجع_المصدر: &مصدر = &(*الخريطة).المصادر[المصدر];
            دع مرجع_الفهرس: &فهرس_سطور = &الفهارس[موضع].الفهرس;
            طابق موضع_أداة_عند(مرجع_المصدر, مرجع_الفهرس, النطاق.البداية.البايت مثل طبيعي) مع
            | اختياري.موجود(البداية) -> {
                طابق موضع_أداة_عند(مرجع_المصدر, مرجع_الفهرس, النطاق.النهاية.البايت مثل طبيعي) مع
                | اختياري.موجود(النهاية) -> {
                    دع القيمة: مدى_أداة = { المصدر: المصدر, البداية: البداية, النهاية: النهاية };
                    المدى := اختياري.موجود(القيمة);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        };
        ألحق(الناتج, المدى);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف مدى_أداة_واجهة(الواجهة: &نتيجة_واجهة_وحدة, النطاق: نطاق): اختياري مدى_أداة {
    دع النطاقات: متجه نطاق = [النطاق];
    دع المديات: متجه اختياري مدى_أداة = مديات_أداة_واجهة(الواجهة, &النطاقات);
    أرجع المديات[0];
}

// ---- Module lookup ----------------------------------------------------------------

// The position of a source's module in the result's aligned vectors (trees,
// binding contexts, expression Types).
عام عرف موضع_وحدة_مصدر_واجهة(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        إذا ((*الواجهة).الوحدات[ف].معرف_المصدر == المصدر) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف نطاق_مدى_واجهة(المصدر: طبيعي, البداية: طبيعي, النهاية: طبيعي): نطاق {
    أرجع نطاق_بين(موضع_من(المصدر, البداية), موضع_من(المصدر, النهاية));
}

// ---- References -----------------------------------------------------------------

// Every reference of الرمز with its role. Moves are SSF's: a read that SSF
// proves moves the local's value out is reported as نقل.
عام عرف مراجع_رمز_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه مرجع_رمز_دلالي {
    دع الناتج: متغير متجه مرجع_رمز_دلالي = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> {
        دع المراجع: متجه مرجع_رمز_دلالي = مراجع_رمز_عند_استعلام(
            &الأسماء, &(*الواجهة).الوحدات, &(*الواجهة).روابط_الأسماء,
            &(*الواجهة).خريطة_المصادر, الرمز
        );
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المراجع) مثل طبيعي)) {
            دع المرجع: مرجع_رمز_دلالي = المراجع[ف];
            إذا (المرجع.الدور == دور_مرجع.قراءة()
                && هل_نقل_ملكية(&(*الواجهة).حقائق_الملكية, &المرجع.النطاق)) {
                دع المنقول: مرجع_رمز_دلالي = {
                    النطاق: المرجع.النطاق,
                    الاسم: المرجع.الاسم,
                    الدور: دور_مرجع.نقل(),
                    تهجئة_بديلة: المرجع.تهجئة_بديلة
                };
                ألحق(الناتج, المنقول);
            } وإلا {
                ألحق(الناتج, المرجع);
            };
            ف := ف + 1;
        }
        أرجع الناتج;
    };
}

// ---- Rename safety --------------------------------------------------------------

// Why renaming the occurrence at (المصدر, البايت) to الاسم_الجديد would change
// resolution, one entry per affected occurrence. Empty when the rename is safe
// or has no target; خطط_إعادة_تسمية_واجهة rejects with تعارض_اسم whenever this
// is not empty.
عام عرف تعارضات_إعادة_تسمية_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البايت: طبيعي,
    الاسم_الجديد: &نص
): متجه تعارض_إعادة_تسمية_دلالي {
    دع الناتج: متجه تعارض_إعادة_تسمية_دلالي = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> {
        طابق ظهور_اسم_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(الظهور) -> {
            طابق حضر_إعادة_تسمية_دلالية(&الأسماء, &الظهور) مع
            | نتيجة_تحضير_إعادة_تسمية_دلالية.مرفوض(_) -> { أرجع الناتج; }
            | نتيجة_تحضير_إعادة_تسمية_دلالية.جاهز(الهدف) -> {
                طابق اسم_مقنن_لنص_عند_استعلام(&الأسماء, الاسم_الجديد) مع
                | اختياري.لا_شيء -> { أرجع الناتج; }
                | اختياري.موجود(الهوية) -> {
                    أرجع تعارضات_إعادة_تسمية_دلالية(
                        &الأسماء, &الهدف, الهوية, &(*الواجهة).روابط_الأسماء
                    );
                };
            };
        };
    };
}

// ---- Workspace symbols ----------------------------------------------------------

عام عرف رموز_عليا_واجهة(الواجهة: &نتيجة_واجهة_وحدة): متجه رمز_أعلى_دلالي {
    دع الناتج: متجه رمز_أعلى_دلالي = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> { أرجع رموز_عليا_عند_استعلام(&الأسماء); };
}

// ---- Other-target declarations (go to implementation) ---------------------------

// The declarations of the same top-level name in the module's other target
// branches (`if (target...)`), as name spans. SultanC has no traits or
// interfaces; this, the type-alias relation (أنواع_عليا_لرمز_واجهة) and the
// constructor-to-enum owner (رمز_دلالي.المالك) are its declaration relations.
عام عرف تصريحات_لأهداف_أخرى_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): متجه نطاق {
    دع الناتج: متجه نطاق = [];
    طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الحقيقة) -> {
        دع المصدر: طبيعي = الحقيقة.نطاق_الاسم.البداية.المصدر مثل طبيعي;
        طابق موضع_وحدة_مصدر_واجهة(الواجهة, المصدر) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(الموضع) -> {
            دع الخريطة: &خريطة_مصادر = &(*الواجهة).خريطة_المصادر;
            إذا (المصدر >= (الطول((*الخريطة).المصادر) مثل طبيعي)) { أرجع الناتج; };
            أرجع تصريحات_لأهداف_أخرى_في_وحدة(
                &(*الخريطة).المصادر[المصدر], &(*الواجهة).الوحدات[الموضع], الحقيقة.نطاق_الاسم
            );
        };
    };
}

// ---- Types for refactorings -------------------------------------------------------

// The Type of the expression whose span is exactly [البداية, النهاية) of the
// source: nothing when the range is not one typed expression (extract variable).
عام عرف نوع_تعبير_بمدى_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي
): اختياري معرف_نوع {
    طابق موضع_وحدة_مصدر_واجهة(الواجهة, المصدر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع >= (الطول((*الواجهة).سياقات_الأنواع.أنواع_التعبيرات) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        أرجع نوع_تعبير_عند(
            &(*الواجهة).سياقات_الأنواع.أنواع_التعبيرات[الموضع],
            نطاق_مدى_واجهة(المصدر, البداية, النهاية)
        );
    };
}

// Whether a Symbol's declared Type is writable (`mutable T`).
عام عرف رمز_قابل_للتغيير_واجهة(الواجهة: &نتيجة_واجهة_وحدة, الرمز: معرف_رمز): منطقي {
    طابق نوع_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(النوع) -> {
        طابق أزل_غلاف_متغير(&(*الواجهة).سياقات_الأنواع.الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الداخل) -> { أرجع !معرفا_نوع_متساويان(الداخل, النوع); };
    };
}

// ---- Inline variable --------------------------------------------------------------

// A local's declaration statement, its initializer expression (a plain value
// initialization), whether it is writable and how many references write it or
// borrow it mutably. Inlining is sound only for an immutable local with an
// initializer and no writes.
عام نوع معلومات_تضمين_محلي = {
    نطاق_التصريح: نطاق,
    نطاق_التهيئة: اختياري نطاق,
    قابل_للتغيير: منطقي,
    عدد_الكتابات: طبيعي
};

عام عرف معلومات_تضمين_محلي_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    الرمز: معرف_رمز
): اختياري معلومات_تضمين_محلي {
    طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الحقيقة) -> {
        إذا (الحقيقة.النوع != نوع_تصريح.ربط_محلي()) { أرجع اختياري.لا_شيء(); };
        دع المصدر: طبيعي = الحقيقة.نطاق_الاسم.البداية.المصدر مثل طبيعي;
        طابق موضع_وحدة_مصدر_واجهة(الواجهة, المصدر) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الموضع) -> {
            طابق تهيئة_ربط_محلي_في_وحدة(&(*الواجهة).الوحدات[الموضع], الحقيقة.نطاق_الاسم) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(التهيئة) -> {
                دع المراجع: متجه مرجع_رمز_دلالي = مراجع_رمز_واجهة(الواجهة, الرمز);
                دع الكتابات: متغير طبيعي = 0;
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(المراجع) مثل طبيعي)) {
                    طابق المراجع[ف].الدور مع
                    | دور_مرجع.كتابة -> { الكتابات := الكتابات + 1; }
                    | دور_مرجع.استعارة_متغيرة -> { الكتابات := الكتابات + 1; }
                    | _ -> { };
                    ف := ف + 1;
                }
                دع الناتج: معلومات_تضمين_محلي = {
                    نطاق_التصريح: التهيئة.نطاق_التصريح,
                    نطاق_التهيئة: التهيئة.نطاق_التهيئة,
                    قابل_للتغيير: رمز_قابل_للتغيير_واجهة(الواجهة, الرمز),
                    عدد_الكتابات: الكتابات
                };
                أرجع اختياري.موجود(الناتج);
            };
        };
    };
}

// ---- Extract function -------------------------------------------------------------

// A shared local with its Type (as declared, `mutable T` included), whether it
// is writable, and whether one of its uses in the section moves it (SSF).
عام نوع متغير_استخراج_واجهة = {
    الرمز: معرف_رمز,
    الاسم: معرف_اسم,
    النوع_المصرح: نوع_تصريح,
    النوع: اختياري معرف_نوع,
    قابل_للتغيير: منطقي,
    مقروء: منطقي,
    مكتوب: منطقي,
    منقول: منطقي,
    مستعار: منطقي,
    مستعار_متغيرا: منطقي,
    مستخدم_بعد: منطقي,
    الاستخدامات: متجه نطاق
};

عام نوع استخراج_دالة_واجهة = {
    الدالة: اختياري معرف_رمز,
    نطاق_الدالة: نطاق,
    نطاق_العبارات: نطاق,
    المدخلات: متجه متغير_استخراج_واجهة,
    المخرجات: متجه متغير_استخراج_واجهة,
    يحوي_إرجاع: منطقي,
    يحوي_قفزا_خارجيا: منطقي
};

عام نوع نتيجة_استخراج_دالة_واجهة =
    | جاهز بنوع استخراج_دالة_واجهة
    | مرفوض بنوع رفض_استخراج_دالة
;

عرف متغيرات_استخراج_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المتغيرات: &متجه متغير_مستخرج
): متجه متغير_استخراج_واجهة {
    دع الناتج: متغير متجه متغير_استخراج_واجهة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المتغيرات) مثل طبيعي)) {
        دع الأصل: &متغير_مستخرج = &(*المتغيرات)[ف];
        دع الاستخدامات: متغير متجه نطاق = [];
        دع منقول: متغير منطقي = خطأ;
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الأصل).الاستخدامات) مثل طبيعي)) {
            دع النطاق: نطاق = (*الأصل).الاستخدامات[ك];
            إذا (هل_نقل_ملكية(&(*الواجهة).حقائق_الملكية, &النطاق)) { منقول := صواب; };
            ألحق(الاستخدامات, النطاق);
            ك := ك + 1;
        }
        دع المتغير: متغير_استخراج_واجهة = {
            الرمز: (*الأصل).الرمز,
            الاسم: (*الأصل).الاسم,
            النوع_المصرح: (*الأصل).النوع_المصرح,
            النوع: نوع_رمز_واجهة(الواجهة, (*الأصل).الرمز),
            قابل_للتغيير: رمز_قابل_للتغيير_واجهة(الواجهة, (*الأصل).الرمز),
            مقروء: (*الأصل).مقروء,
            مكتوب: (*الأصل).مكتوب,
            منقول: منقول,
            مستعار: (*الأصل).مستعار,
            مستعار_متغيرا: (*الأصل).مستعار_متغيرا,
            مستخدم_بعد: (*الأصل).مستخدم_بعد,
            الاستخدامات: الاستخدامات
        };
        ألحق(الناتج, المتغير);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The statements a range [البداية, النهاية) of a source selects inside a
// function body, and the locals they share with the rest of the function.
عام عرف حلل_استخراج_دالة_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي
): نتيجة_استخراج_دالة_واجهة {
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع نتيجة_استخراج_دالة_واجهة.مرفوض(رفض_استخراج_دالة.خارج_دالة()); }
    | اختياري.موجود(الأسماء) -> {
        طابق موضع_وحدة_مصدر_واجهة(الواجهة, المصدر) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استخراج_دالة_واجهة.مرفوض(رفض_استخراج_دالة.خارج_دالة()); }
        | اختياري.موجود(الموضع) -> {
            إذا (الموضع >= (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
                أرجع نتيجة_استخراج_دالة_واجهة.مرفوض(رفض_استخراج_دالة.خارج_دالة());
            };
            طابق حلل_استخراج_دالة_في_وحدة(
                &الأسماء, &(*الواجهة).الوحدات[الموضع], &(*الواجهة).روابط_الأسماء[الموضع],
                نطاق_مدى_واجهة(المصدر, البداية, النهاية)
            ) مع
            | نتيجة_تحليل_استخراج_دالة.مرفوض(السبب) -> { أرجع نتيجة_استخراج_دالة_واجهة.مرفوض(السبب); }
            | نتيجة_تحليل_استخراج_دالة.جاهز(التحليل) -> {
                دع الدالة: اختياري معرف_رمز = رمز_دالة_حاوية_عند_استعلام(
                    &الأسماء, المصدر, التحليل.نطاق_العبارات.البداية.البايت مثل طبيعي
                );
                دع الناتج: استخراج_دالة_واجهة = {
                    الدالة: الدالة,
                    نطاق_الدالة: التحليل.نطاق_الدالة,
                    نطاق_العبارات: التحليل.نطاق_العبارات,
                    المدخلات: متغيرات_استخراج_واجهة(الواجهة, &التحليل.المدخلات),
                    المخرجات: متغيرات_استخراج_واجهة(الواجهة, &التحليل.المخرجات),
                    يحوي_إرجاع: التحليل.يحوي_إرجاع,
                    يحوي_قفزا_خارجيا: التحليل.يحوي_قفزا_خارجيا
                };
                أرجع نتيجة_استخراج_دالة_واجهة.جاهز(الناتج);
            };
        };
    };
}

// ---- Imports ----------------------------------------------------------------------

// The import statements of a source (its direct import edges), or, with
// المستوردة خطأ, the edges of the modules that import it.
عام عرف علاقات_استيراد_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    المستوردة: منطقي
): متجه علاقة_استيراد_وحدة {
    أرجع علاقات_استيراد_لمصدر(&(*الواجهة).حقائق_الأدوات.علاقات_الاستيراد, المصدر, المستوردة);
}

// Imports of a source that nothing resolves through, duplicates, and the
// selected names a used selective import does not need (organize imports).
عام عرف استيرادات_غير_مستخدمة_واجهة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي
): متجه استيراد_غير_مستخدم {
    دع الناتج: متجه استيراد_غير_مستخدم = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الأسماء) -> {
        طابق موضع_وحدة_مصدر_واجهة(الواجهة, المصدر) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(الموضع) -> {
            دع الخريطة: &خريطة_مصادر = &(*الواجهة).خريطة_المصادر;
            إذا (الموضع >= (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)
                || المصدر >= (الطول((*الخريطة).المصادر) مثل طبيعي)) {
                أرجع الناتج;
            };
            أرجع استيرادات_غير_مستخدمة_عند_استعلام(
                &الأسماء, &(*الواجهة).الوحدات_الدلالية, &(*الواجهة).حقائق_الأدوات.علاقات_الاستيراد,
                &(*الواجهة).روابط_الأسماء[الموضع], &(*الخريطة).المصادر[المصدر]
            );
        };
    };
}

// ---- Completeness -----------------------------------------------------------------

// Whether a source's Name facts and Type facts are complete in this result. A
// tooling request returns a result even when a module cannot be bound or a
// later phase stops; queries over the missing facts then answer nothing.
عام عرف اكتمال_مصدر_واجهة(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي): اكتمال_مصدر_أدوات {
    أرجع اكتمال_مصدر_في_حقائق(&(*الواجهة).حقائق_الأدوات, المصدر);
}

// ---- Extract function: the LSP's plan shape ----------------------------------------
// A ready plan for the "extract function" refactoring, over the detailed
// analysis above (حلل_استخراج_دالة_واجهة) or, for one whole expression, over
// its exact-range Type. المدخلات are passed by value, المستعارة_متغيرة by
// `&mutable` (written or mutably borrowed inside and used after), المخرجات are
// declared inside and used after (returned). نوع_القيمة is the Type of the
// selected expression when the range is one.

عام نوع متغير_استخراج = {
    الرمز: معرف_رمز,
    الاسم: معرف_اسم,
    النوع: اختياري معرف_نوع
};

عام نوع خطة_استخراج = {
    المدخلات: متجه متغير_استخراج,
    المخرجات: متجه متغير_استخراج,
    المستعارة_متغيرة: متجه متغير_استخراج,
    نوع_القيمة: اختياري معرف_نوع
};

// ليس_عبارات_أو_تعبيرا: the range is neither whole statements of one block nor
// one whole expression. قفز_خارج_المدى: a `return`, or a `break`/`continue`
// whose loop is outside the range. نقل_ثم_استعمال_بعد: a local the range
// moves is used after it. خارج_دالة: the range is not inside a function body.
عام نوع سبب_رفض_استخراج =
    | ليس_عبارات_أو_تعبيرا
    | قفز_خارج_المدى
    | نقل_ثم_استعمال_بعد
    | خارج_دالة
;

عام نوع نتيجة_حلل_استخراج =
    | صالح بنوع خطة_استخراج
    | غير_صالح بنوع سبب_رفض_استخراج
;

عرف متغير_استخراج_من(الأصل: &متغير_استخراج_واجهة): متغير_استخراج {
    دع الناتج: متغير_استخراج = {
        الرمز: (*الأصل).الرمز,
        الاسم: (*الأصل).الاسم,
        النوع: (*الأصل).النوع
    };
    أرجع الناتج;
}

عرف رمز_في_متغيرات_استخراج(القائمة: &متجه متغير_استخراج, الرمز: معرف_رمز): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*القائمة)[ف].الرمز, الرمز)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// One whole expression: the function's locals it uses are its inputs; those
// it borrows mutably (`&mutable x`) are passed by `&mutable`.
عرف خطة_استخراج_تعبير(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    المدى: نطاق,
    النوع: معرف_نوع
): نتيجة_حلل_استخراج {
    دع المدخلات: متغير متجه متغير_استخراج = [];
    دع المستعارة: متغير متجه متغير_استخراج = [];
    دع بلا_مخرجات: متجه متغير_استخراج = [];
    دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &(*الواجهة).استعلامات_الأسماء;
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.خارج_دالة()); }
    | اختياري.موجود(الأسماء) -> {
        دع نطاق_الدالة: متغير نطاق = نطاق_فارغ();
        طابق رمز_دالة_حاوية_عند_استعلام(&الأسماء, المصدر, المدى.البداية.البايت مثل طبيعي) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.خارج_دالة()); }
        | اختياري.موجود(الدالة) -> {
            طابق رمز_دلالي_عند_استعلام(&الأسماء, الدالة) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.خارج_دالة()); }
            | اختياري.موجود(الحقيقة) -> { نطاق_الدالة := الحقيقة.نطاق_التصريح; };
        };
        طابق موضع_وحدة_مصدر_واجهة(الواجهة, المصدر) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.خارج_دالة()); }
        | اختياري.موجود(الموضع) -> {
            إذا (الموضع >= (الطول((*الواجهة).روابط_الأسماء) مثل طبيعي)) {
                أرجع نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.خارج_دالة());
            };
            دع الأحداث: متجه حدث_دور_اسم = أحداث_أدوار_وحدة(&(*الواجهة).الوحدات[الموضع]);
            دع الروابط: &سياق_روابط_أسماء = &(*الواجهة).روابط_الأسماء[الموضع];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الروابط).الظهورات) مثل طبيعي)) {
                دع الظهور: ظهور_اسم_محلول = (*الروابط).الظهورات[ف];
                طابق الظهور.الرمز مع
                | اختياري.موجود(المعرف) -> {
                    إذا (نطاق_يحتوي_نطاقا(المدى, الظهور.النطاق)) {
                        طابق رمز_دلالي_عند_استعلام(&الأسماء, المعرف) مع
                        | اختياري.موجود(الحقيقة) -> {
                            دع محلي: منطقي = (الحقيقة.النوع == نوع_تصريح.ربط_محلي()
                                || الحقيقة.النوع == نوع_تصريح.معامل())
                                && نطاق_يحتوي_نطاقا(نطاق_الدالة, الحقيقة.نطاق_الاسم)
                                && !نطاق_يحتوي_نطاقا(المدى, الحقيقة.نطاق_الاسم);
                            إذا (محلي && !رمز_في_متغيرات_استخراج(&المدخلات, المعرف)
                                && !رمز_في_متغيرات_استخراج(&المستعارة, المعرف)) {
                                دع المتغير: متغير_استخراج = {
                                    الرمز: المعرف,
                                    الاسم: الحقيقة.الاسم,
                                    النوع: نوع_رمز_واجهة(الواجهة, المعرف)
                                };
                                إذا (دور_ظهور_رمز(&الحقيقة, الظهور.النطاق, &الأحداث) == دور_مرجع.استعارة_متغيرة()) {
                                    ألحق(المستعارة, المتغير);
                                } وإلا {
                                    ألحق(المدخلات, المتغير);
                                };
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
        };
    };
    دع الخطة: خطة_استخراج = {
        المدخلات: المدخلات,
        المخرجات: بلا_مخرجات,
        المستعارة_متغيرة: المستعارة,
        نوع_القيمة: اختياري.موجود(النوع)
    };
    أرجع نتيجة_حلل_استخراج.صالح(الخطة);
}

// The plan for extracting [البداية, النهاية) of a source into a function: one
// whole expression, or whole statements of one block.
عام عرف حلل_استخراج_دالة(
    الواجهة: &نتيجة_واجهة_وحدة,
    المصدر: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي
): نتيجة_حلل_استخراج {
    طابق نوع_تعبير_بمدى_واجهة(الواجهة, المصدر, البداية, النهاية) مع
    | اختياري.موجود(النوع) -> {
        أرجع خطة_استخراج_تعبير(الواجهة, المصدر, نطاق_مدى_واجهة(المصدر, البداية, النهاية), النوع);
    }
    | اختياري.لا_شيء -> { };
    طابق حلل_استخراج_دالة_واجهة(الواجهة, المصدر, البداية, النهاية) مع
    | نتيجة_استخراج_دالة_واجهة.مرفوض(رفض_استخراج_دالة.خارج_دالة) -> {
        أرجع نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.خارج_دالة());
    }
    | نتيجة_استخراج_دالة_واجهة.مرفوض(_) -> {
        أرجع نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.ليس_عبارات_أو_تعبيرا());
    }
    | نتيجة_استخراج_دالة_واجهة.جاهز(التحليل) -> {
        إذا (التحليل.يحوي_إرجاع || التحليل.يحوي_قفزا_خارجيا) {
            أرجع نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.قفز_خارج_المدى());
        };
        دع المدخلات: متغير متجه متغير_استخراج = [];
        دع المستعارة: متغير متجه متغير_استخراج = [];
        دع المخرجات: متغير متجه متغير_استخراج = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التحليل.المدخلات) مثل طبيعي)) {
            دع الأصل: &متغير_استخراج_واجهة = &التحليل.المدخلات[ف];
            إذا ((*الأصل).منقول && (*الأصل).مستخدم_بعد) {
                أرجع نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.نقل_ثم_استعمال_بعد());
            };
            إذا (((*الأصل).مكتوب || (*الأصل).مستعار_متغيرا) && (*الأصل).مستخدم_بعد) {
                ألحق(المستعارة, متغير_استخراج_من(الأصل));
            } وإلا {
                ألحق(المدخلات, متغير_استخراج_من(الأصل));
            };
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول(التحليل.المخرجات) مثل طبيعي)) {
            ألحق(المخرجات, متغير_استخراج_من(&التحليل.المخرجات[ف]));
            ف := ف + 1;
        }
        دع الخطة: خطة_استخراج = {
            المدخلات: المدخلات,
            المخرجات: المخرجات,
            المستعارة_متغيرة: المستعارة,
            نوع_القيمة: اختياري.لا_شيء()
        };
        أرجع نتيجة_حلل_استخراج.صالح(الخطة);
    };
}
