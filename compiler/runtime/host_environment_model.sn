// Runtime owns the neutral identity of the environment in which the current
// SultanC executable runs. Target maps these facts to registered Target descriptors;
// Driver never guesses architecture/OS defaults.

عام نوع هوية_معمارية_مضيف =
    | ذراع_أربعة_وستون
    | إكس_ستة_وثمانون_أربعة_وستون
    | ويب_أسمبلي_اثنان_وثلاثون
    | ويب_أسمبلي_أربعة_وستون
;

عام نوع هوية_منصة_مضيف =
    | داروين
    | لينكس
    | واسي
    | متصفح
    | ويندوز
    | غير_محددة
;

عام نوع هوية_بيئة_مضيف =
    | غير_محددة
    | جنو
    | مسل
    | إم_إس_في_سي
;

عام نوع وصف_بيئة_مضيف = {
    المعمارية: هوية_معمارية_مضيف,
    المنصة: هوية_منصة_مضيف,
    البيئة: هوية_بيئة_مضيف
};

// Numeric values are the private primitive ABI between compiler/runtime semantics
// and bootstrap/native code generation. Consumers use these helpers, never literals.
عام عرف رمز_معمارية_مضيف(الهوية: هوية_معمارية_مضيف): عدد {
    طابق الهوية مع
    | هوية_معمارية_مضيف.ذراع_أربعة_وستون -> { أرجع 1; }
    | هوية_معمارية_مضيف.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع 2; }
    | هوية_معمارية_مضيف.ويب_أسمبلي_اثنان_وثلاثون -> { أرجع 3; }
    | هوية_معمارية_مضيف.ويب_أسمبلي_أربعة_وستون -> { أرجع 4; };
}

عام عرف رمز_منصة_مضيف(الهوية: هوية_منصة_مضيف): عدد {
    طابق الهوية مع
    | هوية_منصة_مضيف.داروين -> { أرجع 1; }
    | هوية_منصة_مضيف.لينكس -> { أرجع 2; }
    | هوية_منصة_مضيف.واسي -> { أرجع 3; }
    | هوية_منصة_مضيف.متصفح -> { أرجع 4; }
    | هوية_منصة_مضيف.ويندوز -> { أرجع 5; }
    | هوية_منصة_مضيف.غير_محددة -> { أرجع 0; };
}

عام عرف رمز_بيئة_مضيف(الهوية: هوية_بيئة_مضيف): عدد {
    طابق الهوية مع
    | هوية_بيئة_مضيف.غير_محددة -> { أرجع 0; }
    | هوية_بيئة_مضيف.جنو -> { أرجع 1; }
    | هوية_بيئة_مضيف.مسل -> { أرجع 2; }
    | هوية_بيئة_مضيف.إم_إس_في_سي -> { أرجع 3; };
}

عام عرف معمارية_مضيف_من_رمز(الرمز: عدد): اختياري هوية_معمارية_مضيف {
    لو (الرمز == 1) { أرجع اختياري.موجود(هوية_معمارية_مضيف.ذراع_أربعة_وستون()); };
    لو (الرمز == 2) { أرجع اختياري.موجود(هوية_معمارية_مضيف.إكس_ستة_وثمانون_أربعة_وستون()); };
    لو (الرمز == 3) { أرجع اختياري.موجود(هوية_معمارية_مضيف.ويب_أسمبلي_اثنان_وثلاثون()); };
    لو (الرمز == 4) { أرجع اختياري.موجود(هوية_معمارية_مضيف.ويب_أسمبلي_أربعة_وستون()); };
    أرجع اختياري.لا_شيء();
}

عام عرف منصة_مضيف_من_رمز(الرمز: عدد): اختياري هوية_منصة_مضيف {
    لو (الرمز == 1) { أرجع اختياري.موجود(هوية_منصة_مضيف.داروين()); };
    لو (الرمز == 2) { أرجع اختياري.موجود(هوية_منصة_مضيف.لينكس()); };
    لو (الرمز == 3) { أرجع اختياري.موجود(هوية_منصة_مضيف.واسي()); };
    لو (الرمز == 4) { أرجع اختياري.موجود(هوية_منصة_مضيف.متصفح()); };
    لو (الرمز == 5) { أرجع اختياري.موجود(هوية_منصة_مضيف.ويندوز()); };
    لو (الرمز == 0) { أرجع اختياري.موجود(هوية_منصة_مضيف.غير_محددة()); };
    أرجع اختياري.لا_شيء();
}

عام عرف بيئة_مضيف_من_رمز(الرمز: عدد): اختياري هوية_بيئة_مضيف {
    لو (الرمز == 0) { أرجع اختياري.موجود(هوية_بيئة_مضيف.غير_محددة()); };
    لو (الرمز == 1) { أرجع اختياري.موجود(هوية_بيئة_مضيف.جنو()); };
    لو (الرمز == 2) { أرجع اختياري.موجود(هوية_بيئة_مضيف.مسل()); };
    لو (الرمز == 3) { أرجع اختياري.موجود(هوية_بيئة_مضيف.إم_إس_في_سي()); };
    أرجع اختياري.لا_شيء();
}

// Current execution-host queries remain genuine compiler intrinsics.
// This model owns decoding them into the neutral host-environment identity.
مرادف استعلم_معمارية_المضيف_بدائيا = بدائي_معمارية_المضيف;
مرادف استعلم_منصة_المضيف_بدائيا = بدائي_منصة_المضيف;
مرادف استعلم_بيئة_المضيف_بدائيا = بدائي_بيئة_المضيف;

عام عرف رمز_معمارية_المضيف_الحالية(): عدد {
    أرجع استعلم_معمارية_المضيف_بدائيا();
}

عام عرف رمز_منصة_المضيف_الحالية(): عدد {
    أرجع استعلم_منصة_المضيف_بدائيا();
}

عام عرف رمز_بيئة_المضيف_الحالية(): عدد {
    أرجع استعلم_بيئة_المضيف_بدائيا();
}

عام عرف وصف_بيئة_المضيف_الحالية(): اختياري وصف_بيئة_مضيف {
    طابق معمارية_مضيف_من_رمز(رمز_معمارية_المضيف_الحالية()) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعمارية) -> {
        طابق منصة_مضيف_من_رمز(رمز_منصة_المضيف_الحالية()) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المنصة) -> {
            طابق بيئة_مضيف_من_رمز(رمز_بيئة_المضيف_الحالية()) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(البيئة) -> {
                دع الوصف: وصف_بيئة_مضيف = {
                    المعمارية: المعمارية,
                    المنصة: المنصة,
                    البيئة: البيئة
                };
                أرجع اختياري.موجود(الوصف);
            };
        };
    };
}
