// Runtime owns the neutral identity of the environment in which the current
// SultanC executable runs. Target maps these facts to registered Target descriptors;
// Driver never guesses architecture/OS defaults.

عام نوع هوية_معمارية_مضيف =
    | ذراع_أربعة_وستون
    | إكس_ستة_وثمانون_أربعة_وستون
;

عام نوع هوية_منصة_مضيف =
    | داروين
    | لينكس
;

عام نوع هوية_بيئة_مضيف =
    | غير_محددة
    | جنو
    | مسل
;

عام نوع وصف_بيئة_مضيف = {
    المعمارية: هوية_معمارية_مضيف,
    المنصة: هوية_منصة_مضيف,
    البيئة: هوية_بيئة_مضيف
};

// Numeric values are the private primitive ABI between compiler/runtime semantics
// and bootstrap/native code generation. Consumers use these helpers, never literals.
عام عرف رمز_معمارية_مضيف(الهوية: هوية_معمارية_مضيف): عدد {
    طابق الهوية مع
    | هوية_معمارية_مضيف.ذراع_أربعة_وستون -> { أرجع 1; }
    | هوية_معمارية_مضيف.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع 2; };
}

عام عرف رمز_منصة_مضيف(الهوية: هوية_منصة_مضيف): عدد {
    طابق الهوية مع
    | هوية_منصة_مضيف.داروين -> { أرجع 1; }
    | هوية_منصة_مضيف.لينكس -> { أرجع 2; };
}

عام عرف رمز_بيئة_مضيف(الهوية: هوية_بيئة_مضيف): عدد {
    طابق الهوية مع
    | هوية_بيئة_مضيف.غير_محددة -> { أرجع 0; }
    | هوية_بيئة_مضيف.جنو -> { أرجع 1; }
    | هوية_بيئة_مضيف.مسل -> { أرجع 2; };
}

عام عرف معمارية_مضيف_من_رمز(الرمز: عدد): اختيار هوية_معمارية_مضيف {
    لو (الرمز == 1) { أرجع اختيار.بعض(هوية_معمارية_مضيف.ذراع_أربعة_وستون()); };
    لو (الرمز == 2) { أرجع اختيار.بعض(هوية_معمارية_مضيف.إكس_ستة_وثمانون_أربعة_وستون()); };
    أرجع اختيار.لا_شيء();
}

عام عرف منصة_مضيف_من_رمز(الرمز: عدد): اختيار هوية_منصة_مضيف {
    لو (الرمز == 1) { أرجع اختيار.بعض(هوية_منصة_مضيف.داروين()); };
    لو (الرمز == 2) { أرجع اختيار.بعض(هوية_منصة_مضيف.لينكس()); };
    أرجع اختيار.لا_شيء();
}

عام عرف بيئة_مضيف_من_رمز(الرمز: عدد): اختيار هوية_بيئة_مضيف {
    لو (الرمز == 0) { أرجع اختيار.بعض(هوية_بيئة_مضيف.غير_محددة()); };
    لو (الرمز == 1) { أرجع اختيار.بعض(هوية_بيئة_مضيف.جنو()); };
    لو (الرمز == 2) { أرجع اختيار.بعض(هوية_بيئة_مضيف.مسل()); };
    أرجع اختيار.لا_شيء();
}
