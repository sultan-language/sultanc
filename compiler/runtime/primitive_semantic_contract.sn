استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_runtime_mapping;

// فئات دلالية واسعة فقط؛ لا تعيد بناء نظام الأنواع المملوك للواجهة الأمامية.
عام نوع فئة_ناتج_بدائي =
    | بلا_قيمة
    | عدد_صحيح
    | غ32
    | غ64
    | ع32
    | ع64
    | نص
    | نتيجة_نص_بخطأ_عددي
    | نتيجة_عدد_بخطأ_عددي
;

عام نوع سلوك_عودة_بدائي =
    | يعود_طبيعيا
    | لا_يعود_طبيعيا
;

عام نوع تصنيف_أثر_بدائي =
    | نقي
    | تعديل_قيمة
    | حالة_ذاكرة
    | إدخال_إخراج
    | مراقبة_بيئة_العملية
    | تحكم_العملية
;

عام نوع عقد_دلالي_بدائي = {
    عدد_الحجج: غير_موقع,
    سلوك_العودة: سلوك_عودة_بدائي,
    فئة_الناتج: فئة_ناتج_بدائي,
    الأثر: تصنيف_أثر_بدائي,
    قد_تخصص: منطقي,
    قد_تفشل: منطقي,
    فئة_الخفض: فئة_خفض_بدائي
};

عرف أنشئ_عقد_دلالي_بدائي(
    العدد: غير_موقع,
    العودة: سلوك_عودة_بدائي,
    الناتج: فئة_ناتج_بدائي,
    الأثر: تصنيف_أثر_بدائي,
    قد_تخصص: منطقي,
    قد_تفشل: منطقي,
    الخفض: فئة_خفض_بدائي
): عقد_دلالي_بدائي {
    دع العقد: عقد_دلالي_بدائي = {
        عدد_الحجج: العدد,
        سلوك_العودة: العودة,
        فئة_الناتج: الناتج,
        الأثر: الأثر,
        قد_تخصص: قد_تخصص,
        قد_تفشل: قد_تفشل,
        فئة_الخفض: الخفض
    };
    أرجع العقد;
}

// عقد اللغة المرئية مقننة بهوية البدائي فقط ولا تحتوي تهجئات مصدرية أو
// حقائق منصة أو هويات أنواع من الواجهة الأمامية.
عام عرف العقد_الدلالي_للبدائي(البدائي: هوية_بدائي_مترجم): عقد_دلالي_بدائي {
    دع الخفض: فئة_خفض_بدائي = فئة_خفض_للبدائي(البدائي);
    طابق البدائي مع
    | هوية_بدائي_مترجم.طول -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.عدد_صحيح(),
            تصنيف_أثر_بدائي.نقي(),
            خطأ,
            خطأ,
            الخفض
        );
    }
    // ماديّة نص تحفظ بايتات المصدر كما هي في تخزين مستقل مملوك للناتج.
    // لا تحقق UTF-8 ولا فك ترميز ولا تطبيع Unicode ولا تحويل محلي.
    | هوية_بدائي_مترجم.بتات_ع64 -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.غ64(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ع64_من_بتات -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.ع64(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.بتات_ع32 -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.غ32(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ع32_من_بتات -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.ع32(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.نص_من_بايتات -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.نص(),
            تصنيف_أثر_بدائي.حالة_ذاكرة(),
            صواب,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            2,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.بلا_قيمة(),
            تصنيف_أثر_بدائي.تعديل_قيمة(),
            صواب,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.تبديل_موضعين -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            2,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.بلا_قيمة(),
            تصنيف_أثر_بدائي.تعديل_قيمة(),
            خطأ,
            خطأ,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.تحرير -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.بلا_قيمة(),
            تصنيف_أثر_بدائي.حالة_ذاكرة(),
            خطأ,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.فتح_ملف_للقراءة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), صواب, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.قراءة_بايت_ملف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(4, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.إنشاء_ملف_للكتابة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), صواب, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.كتابة_مقطع_ملف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(4, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.إغلاق_ملف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.فتح_دليل -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), صواب, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.قراءة_مدخل_دليل -> {
        أرجع أنشئ_عقد_دلالي_بدائي(4, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.إغلاق_دليل -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.قراءة_بايت_الدخل_القياسي -> {
        أرجع أنشئ_عقد_دلالي_بدائي(0, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي -> {
        أرجع أنشئ_عقد_دلالي_بدائي(3, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.كتابة_بايتات_تنفيذية -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            2,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.نتيجة_عدد_بخطأ_عددي(),
            تصنيف_أثر_بدائي.إدخال_إخراج(),
            صواب,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.كتابة_الخرج_القياسي -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.عدد_صحيح(),
            تصنيف_أثر_بدائي.إدخال_إخراج(),
            خطأ,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.كتابة_الخطأ_القياسي -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.عدد_صحيح(),
            تصنيف_أثر_بدائي.إدخال_إخراج(),
            خطأ,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.معمارية_المضيف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(0, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.مراقبة_بيئة_العملية(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.منصة_المضيف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(0, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.مراقبة_بيئة_العملية(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.بيئة_المضيف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(0, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.مراقبة_بيئة_العملية(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.عدد_الوسائط -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            0,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.عدد_صحيح(),
            تصنيف_أثر_بدائي.مراقبة_بيئة_العملية(),
            خطأ,
            خطأ,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.الوصول_إلى_وسيط -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            سلوك_عودة_بدائي.يعود_طبيعيا(),
            فئة_ناتج_بدائي.نص(),
            تصنيف_أثر_بدائي.مراقبة_بيئة_العملية(),
            خطأ,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.خروج_العملية -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            سلوك_عودة_بدائي.لا_يعود_طبيعيا(),
            فئة_ناتج_بدائي.بلا_قيمة(),
            تصنيف_أثر_بدائي.تحكم_العملية(),
            خطأ,
            خطأ,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.تصنيف_خطأ_نظام -> { أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض); }
    | هوية_بدائي_مترجم.إنشاء_دليل -> { أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض); }
    | هوية_بدائي_مترجم.إزالة_ملف -> { أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض); }
