    | هوية_بدائي_مترجم.قراءة_مقطع_مقبض_ملف -> { أرجع أنشئ_عقد_دلالي_بدائي(4, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض); }
