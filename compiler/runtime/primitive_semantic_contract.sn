    | هوية_بدائي_مترجم.وقت_تعديل_مسار -> { أرجع أنشئ_عقد_دلالي_بدائي(1, سلوك_عودة_بدائي.يعود_طبيعيا(), فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.إدخال_إخراج(), خطأ, صواب, الخفض); }
