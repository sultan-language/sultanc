استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_runtime_mapping;

// Broad semantic categories only; exact Type legality remains Frontend-owned.
عام نوع فئة_ناتج_بدائي =
    | بلا_قيمة
    | عدد_صحيح
    | ط32
    | ط64
    | ع32
    | ع64
    // Canonical text.
    | نص
    // The Type the first (reference) argument refers to.
    | قيمة_المرجع
    // The Type of the first argument itself.
    | قيمة_الحجة
    | منطقي
    // A function Type `() -> ()`.
    | دالة_بلا_معاملات
    // `option T` for the element Type T of the first argument's vector.
    | اختياري_عنصر_المتجه
    // A raw mutable pointer to the payload of the first (box) argument.
    | مؤشر_إلى_الحجة
;

عام نوع تصنيف_أثر_بدائي =
    | نقي
    | تعديل_قيمة
    | حالة_ذاكرة
    | مراقبة_بيئة_العملية
;

عام نوع عقد_دلالي_بدائي = {
    عدد_الحجج: طبيعي,
    فئة_الناتج: فئة_ناتج_بدائي,
    الأثر: تصنيف_أثر_بدائي,
    قد_تخصص: منطقي,
    قد_تفشل: منطقي,
    فئة_الخفض: فئة_خفض_بدائي
};

عرف أنشئ_عقد_دلالي_بدائي(
    العدد: طبيعي,
    الناتج: فئة_ناتج_بدائي,
    الأثر: تصنيف_أثر_بدائي,
    قد_تخصص: منطقي,
    قد_تفشل: منطقي,
    الخفض: فئة_خفض_بدائي
): عقد_دلالي_بدائي {
    دع العقد: عقد_دلالي_بدائي = {
        عدد_الحجج: العدد,
        فئة_الناتج: الناتج,
        الأثر: الأثر,
        قد_تخصص: قد_تخصص,
        قد_تفشل: قد_تفشل,
        فئة_الخفض: الخفض
    };
    أرجع العقد;
}

// The language-visible contract is keyed only by genuine compiler primitive identity.
عام عرف العقد_الدلالي_للبدائي(البدائي: هوية_بدائي_مترجم): عقد_دلالي_بدائي {
    دع الخفض: فئة_خفض_بدائي = فئة_خفض_للبدائي(البدائي);
    طابق البدائي مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> {
        // Kernel entry is observable even if the return value is unused.
        أرجع أنشئ_عقد_دلالي_بدائي(7, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.طول -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            فئة_ناتج_بدائي.عدد_صحيح(),
            تصنيف_أثر_بدائي.نقي(),
            خطأ,
            خطأ,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.بتات_ع64 -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ع64_من_بتات -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ع64(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.بتات_ع32 -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط32(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ع32_من_بتات -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ع32(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.جمع_ملتف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.قيمة_الحجة(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.طرح_ملتف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.قيمة_الحجة(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ضرب_ملتف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.قيمة_الحجة(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.قيمة_الحجة(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.قيمة_الحجة(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
        // memory.grow: page delta in, previous page count (or u32 max) out.
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط32(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط32(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
        أرجع أنشئ_عقد_دلالي_بدائي(3, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
        // The linker-defined __heap_base address: a link-time constant.
        أرجع أنشئ_عقد_دلالي_بدائي(0, فئة_ناتج_بدائي.ط32(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            2,
            فئة_ناتج_بدائي.بلا_قيمة(),
            تصنيف_أثر_بدائي.تعديل_قيمة(),
            صواب,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.تبديل_موضعين -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            2,
            فئة_ناتج_بدائي.بلا_قيمة(),
            تصنيف_أثر_بدائي.تعديل_قيمة(),
            خطأ,
            خطأ,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.استنساخ -> {
        // Allocates the copy's storage; allocation failure traps.
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            فئة_ناتج_بدائي.قيمة_المرجع(),
            تصنيف_أثر_بدائي.حالة_ذاكرة(),
            صواب,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.تحرير -> {
        أرجع أنشئ_عقد_دلالي_بدائي(
            1,
            فئة_ناتج_بدائي.بلا_قيمة(),
            تصنيف_أثر_بدائي.حالة_ذاكرة(),
            خطأ,
            صواب,
            الخفض
        );
    }
    | هوية_بدائي_مترجم.معمارية_المضيف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(0, فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.مراقبة_بيئة_العملية(), خطأ, خطأ, الخفض);
    }
    // Reflection: one reference argument, a u64 fact, pure.
    | هوية_بدائي_مترجم.حجم_النوع -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.محاذاة_النوع -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    // A compile-time failure has no other effect; it always fails.
    | هوية_بدائي_مترجم.فشل_وقت_الترجمة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.نقي(), خطأ, صواب, الخفض);
    }
    // Changes only the evaluation's own instruction budget.
    | هوية_بدائي_مترجم.ميزانية_وقت_الترجمة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.منصة_المضيف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(0, فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.مراقبة_بيئة_العملية(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.بيئة_المضيف -> {
        أرجع أنشئ_عقد_دلالي_بدائي(0, فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.مراقبة_بيئة_العملية(), خطأ, خطأ, الخفض);
    }
    // A copy of a value holding closures; it may allocate (clone glue).
    | هوية_بدائي_مترجم.احتفاظ_بقيمة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.قيمة_الحجة(), تصنيف_أثر_بدائي.حالة_ذاكرة(), صواب, صواب, الخفض);
    }
    | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.منطقي(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.دالة_بلا_معاملات(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    // Pop moves the last element out (none when empty); truncate drops the
    // elements past its length. Both write the vector they are given and
    // keep its buffer; neither allocates or fails.
    | هوية_بدائي_مترجم.إزالة_الأخير -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.اختياري_عنصر_المتجه(), تصنيف_أثر_بدائي.تعديل_قيمة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.اقتطاع_متجه -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.تعديل_قيمة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ضبط_طول_متجه -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.تعديل_قيمة(), خطأ, خطأ, الخفض);
    }
    // Capacity reads the header, as length does (an int, as Go's cap).
    | هوية_بدائي_مترجم.سعة_متجه -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.عدد_صحيح(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    // Reserve writes the vector it is given and may allocate, as append.
    | هوية_بدائي_مترجم.حجز_سعة_متجه -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.تعديل_قيمة(), صواب, صواب, الخفض);
    }
    // Extend writes the vector it is given, may allocate, and traps on a
    // range past the source's end.
    | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> {
        أرجع أنشئ_عقد_دلالي_بدائي(4, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.تعديل_قيمة(), صواب, صواب, الخفض);
    }
    // IEEE operations: operands and result of the first argument's float Type.
    | هوية_بدائي_مترجم.عملية_عائمة(العملية) -> {
        أرجع أنشئ_عقد_دلالي_بدائي(عدد_معاملات_عملية_عائمة(العملية), فئة_ناتج_بدائي.قيمة_الحجة(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    // Thread support (docs/en/reference/concurrency.md).
    | هوية_بدائي_مترجم.ذري_حمل -> {
        أرجع أنشئ_عقد_دلالي_بدائي(2, فئة_ناتج_بدائي.قيمة_المرجع(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ذري_خزن -> {
        أرجع أنشئ_عقد_دلالي_بدائي(3, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ذري_تبديل -> {
        أرجع أنشئ_عقد_دلالي_بدائي(3, فئة_ناتج_بدائي.قيمة_المرجع(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> {
        أرجع أنشئ_عقد_دلالي_بدائي(5, فئة_ناتج_بدائي.قيمة_المرجع(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> {
        أرجع أنشئ_عقد_دلالي_بدائي(3, فئة_ناتج_بدائي.قيمة_المرجع(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ذري_جلب_و -> {
        أرجع أنشئ_عقد_دلالي_بدائي(3, فئة_ناتج_بدائي.قيمة_المرجع(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> {
        أرجع أنشئ_عقد_دلالي_بدائي(3, فئة_ناتج_بدائي.قيمة_المرجع(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> {
        أرجع أنشئ_عقد_دلالي_بدائي(3, فئة_ناتج_بدائي.قيمة_المرجع(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.سياج_ذاكرة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.بلا_قيمة(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.سرب_قيمة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.مؤشر_إلى_الحجة(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.عنوان_دالة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.دالة_من_عنوان -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.دالة_بلا_معاملات(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.مدخل_سي_لدالة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(1, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.نقي(), خطأ, خطأ, الخفض);
    }
    | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> {
        أرجع أنشئ_عقد_دلالي_بدائي(7, فئة_ناتج_بدائي.ط64(), تصنيف_أثر_بدائي.حالة_ذاكرة(), خطأ, صواب, الخفض);
    }
    // The C function may read, write and allocate any memory.
    | هوية_بدائي_مترجم.نداء_عنوان_سي -> {
        أرجع أنشئ_عقد_دلالي_بدائي(18, فئة_ناتج_بدائي.قيمة_الحجة(), تصنيف_أثر_بدائي.حالة_ذاكرة(), صواب, صواب, الخفض);
    }
    ;
}

// Target-neutral whole-call memory semantics. Platform STD owns the ABI rule;
// the Frontend alone translates authenticated source operations into this shape.
عام نوع اتجاه_وصول_بدائي =
    | قراءة
    | كتابة
    | قراءة_وكتابة
;
عام نوع حد_وصول_بدائي =
    | وسيطة بنوع طبيعي
    | ثابت بنوع طبيعي
    | سلسلة_صفرية
;
عام نوع دور_وسيطة_بدائي =
    | عدد
    | غير_مستخدم
    | مخزن بنوع (اتجاه_وصول_بدائي, حد_وصول_بدائي);
عام نوع نسخ_نتيجة_بدائي =
    | بلا_نسخ
    | عدد_بايتات_النتيجة
    | كامل_عند_النجاح
    | كامل_عند_المقاطعة;
عام نوع توقيع_نداء_بدائي = {
    الأدوار: متجه دور_وسيطة_بدائي,
    النسخ: نسخ_نتيجة_بدائي
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_توقيع_نداء_بدائي(القيمة: &توقيع_نداء_بدائي): توقيع_نداء_بدائي {
    دع الناتج: توقيع_نداء_بدائي = {
        الأدوار: انسخ_مملوكا_متجه_دور_وسيطة_بدائي(&(*القيمة).الأدوار),
        النسخ: (*القيمة).النسخ
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_دور_وسيطة_بدائي(القيمة: &متجه دور_وسيطة_بدائي): متجه دور_وسيطة_بدائي {
    دع الناتج: متغير متجه دور_وسيطة_بدائي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
