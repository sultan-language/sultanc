// Runtime adapter binds only the irreducible host-service intrinsics it owns.
استورد compiler.runtime.host_environment_model;
مرادف افتح_ملف_للقراءة_بدائيا = بدائي_فتح_ملف_للقراءة;
مرادف اقرأ_بايت_ملف_بدائيا = بدائي_قراءة_بايت_ملف;
مرادف اقرأ_مقطع_ملف_بدائيا = بدائي_قراءة_مقطع_ملف;
مرادف أنشئ_ملف_للكتابة_بدائيا = بدائي_إنشاء_ملف_للكتابة;
مرادف اكتب_مقطع_ملف_بدائيا = بدائي_كتابة_مقطع_ملف;
مرادف أغلق_ملف_بدائيا = بدائي_إغلاق_ملف;
مرادف افتح_دليل_بدائيا = بدائي_فتح_دليل;
مرادف اقرأ_مدخل_دليل_بدائيا = بدائي_قراءة_مدخل_دليل;
مرادف أغلق_دليل_بدائيا = بدائي_إغلاق_دليل;
مرادف اقرأ_بايت_دخل_بدائيا = بدائي_قراءة_بايت_دخل;
مرادف اقرأ_مقطع_دخل_بدائيا = بدائي_قراءة_مقطع_دخل;
مرادف اكتب_خرج_بدائيا = بدائي_كتابة_خرج;
مرادف اكتب_خطأ_بدائيا = بدائي_كتابة_خطأ;
مرادف اكتب_تنفيذيا_بدائيا = بدائي_كتابة_بايتات_تنفيذية;
مرادف نص_من_بايتات_بدائيا = بدائي_نص_من_بايتات;
مرادف معمارية_المضيف_بدائيا = بدائي_معمارية_المضيف;
مرادف منصة_المضيف_بدائيا = بدائي_منصة_المضيف;
مرادف بيئة_المضيف_بدائيا = بدائي_بيئة_المضيف;
مرادف نوع_مسار_بدائيا = بدائي_نوع_مسار;
مرادف حجم_مسار_بدائيا = بدائي_حجم_مسار;
مرادف وقت_تعديل_مسار_بدائيا = بدائي_وقت_تعديل_مسار;

عام عرف رمز_معمارية_المضيف_الحالية(): عدد {
    أرجع معمارية_المضيف_بدائيا();
}

عام عرف رمز_منصة_المضيف_الحالية(): عدد {
    أرجع منصة_المضيف_بدائيا();
}

عام عرف رمز_بيئة_المضيف_الحالية(): عدد {
    أرجع بيئة_المضيف_بدائيا();
}

عام عرف وصف_بيئة_المضيف_الحالية(): اختيار وصف_بيئة_مضيف {
    طابق معمارية_مضيف_من_رمز(رمز_معمارية_المضيف_الحالية()) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المعمارية) -> {
        طابق منصة_مضيف_من_رمز(رمز_منصة_المضيف_الحالية()) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المنصة) -> {
            طابق بيئة_مضيف_من_رمز(رمز_بيئة_المضيف_الحالية()) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(البيئة) -> {
                دع الوصف: وصف_بيئة_مضيف = {
                    المعمارية: المعمارية,
                    المنصة: المنصة,
                    البيئة: البيئة
                };
                أرجع اختيار.بعض(الوصف);
            };
        };
    };
}

// تكييف Runtime المحايد للمنصة بين الحمولات البايتية المقننة
// وبدائيات المضيف الحالية التي تتطلب نصا. لا يملك هذا الملف تمثيل نص
// أو سياسة ترميز أو تفاصيل منصة.

عرف انسخ_نصا_إلى_بايتات(النص: &نص): متجه غ8 {
    دع الأصل: نص = *النص;
    دع الناتج: متغير متجه غ8 = [];
    دع العدد: غير_موقع = الطول(الأصل) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, الأصل[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف افتح_ملف_مضيف_للقراءة_من_بايتات(المسار: &متجه غ8): عدد {
    دع النص: نص = نص_من_بايتات_بدائيا(*المسار);
    أرجع افتح_ملف_للقراءة_بدائيا(النص);
}

عام عرف أنشئ_ملف_مضيف_للكتابة_من_بايتات(المسار: &متجه غ8): عدد {
    دع النص: نص = نص_من_بايتات_بدائيا(*المسار);
    أرجع أنشئ_ملف_للكتابة_بدائيا(النص);
}

عام عرف نوع_مسار_مضيف_من_بايتات(المسار: &متجه غ8): عدد {
    دع النص: نص = نص_من_بايتات_بدائيا(*المسار);
    أرجع نوع_مسار_بدائيا(النص);
}

عام عرف حجم_مسار_مضيف_من_بايتات(المسار: &متجه غ8): عدد {
    دع النص: نص = نص_من_بايتات_بدائيا(*المسار);
    أرجع حجم_مسار_بدائيا(النص);
}

عام عرف وقت_تعديل_مسار_مضيف_من_بايتات(المسار: &متجه غ8): عدد {
    دع النص: نص = نص_من_بايتات_بدائيا(*المسار);
    أرجع وقت_تعديل_مسار_بدائيا(النص);
}

عام عرف اقرأ_بايت_ملف_مضيف(الواصف: عدد): عدد {
    أرجع اقرأ_بايت_ملف_بدائيا(الواصف);
}

عام عرف اقرأ_مقطع_ملف_مضيف(
    الواصف: عدد,
    المحتوى: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): عدد {
    أرجع اقرأ_مقطع_ملف_بدائيا(الواصف, *المحتوى, الإزاحة, العدد);
}

عام عرف اكتب_مقطع_ملف_مضيف(
    الواصف: عدد,
    المحتوى: &متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): عدد {
    أرجع اكتب_مقطع_ملف_بدائيا(الواصف, *المحتوى, الإزاحة, العدد);
}

عام عرف أغلق_ملف_مضيف(الواصف: عدد): عدد {
    أرجع أغلق_ملف_بدائيا(الواصف);
}

عام عرف افتح_دليل_مضيف_من_بايتات(المسار: &متجه غ8): عدد {
    دع النص: نص = نص_من_بايتات_بدائيا(*المسار);
    أرجع افتح_دليل_بدائيا(النص);
}

عام عرف اقرأ_مدخل_دليل_مضيف(
    المقبض: عدد,
    المحتوى: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): عدد {
    أرجع اقرأ_مدخل_دليل_بدائيا(المقبض, *المحتوى, الإزاحة, العدد);
}

عام عرف أغلق_دليل_مضيف(المقبض: عدد): عدد {
    أرجع أغلق_دليل_بدائيا(المقبض);
}

عام عرف اقرأ_بايت_دخل_مضيف(): عدد {
    أرجع اقرأ_بايت_دخل_بدائيا();
}

عام عرف اقرأ_مقطع_دخل_مضيف(
    المحتوى: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): عدد {
    أرجع اقرأ_مقطع_دخل_بدائيا(*المحتوى, الإزاحة, العدد);
}

عام عرف اكتب_بايتات_تنفيذية_مضيف(
    المسار: &نص,
    المحتوى: &متجه غ8
): نتيجة عدد, عدد {
    أرجع اكتب_تنفيذيا_بدائيا(*المسار, *المحتوى);
}

عام عرف اكتب_بايتات_تنفيذية_مضيف_من_بايتات(
    المسار: &متجه غ8,
    المحتوى: &متجه غ8
): نتيجة عدد, عدد {
    دع مسار_المضيف: نص = نص_من_بايتات_بدائيا(*المسار);
    أرجع اكتب_بايتات_تنفيذية_مضيف(&مسار_المضيف, المحتوى);
}

عام عرف اكتب_خرج_مضيف_من_بايتات(
    المحتوى: &متجه غ8
): عدد {
    دع النص: نص = نص_من_بايتات_بدائيا(*المحتوى);
    أرجع اكتب_خرج_بدائيا(النص);
}

عام عرف اكتب_خطأ_مضيف(المحتوى: نص): عدد {
    أرجع اكتب_خطأ_بدائيا(المحتوى);
}

عام عرف اكتب_خطأ_مضيف_من_بايتات(
    المحتوى: &متجه غ8
): عدد {
    دع النص: نص = نص_من_بايتات_بدائيا(*المحتوى);
    أرجع اكتب_خطأ_مضيف(النص);
}
