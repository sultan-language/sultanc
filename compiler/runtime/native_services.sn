// Compiler-owned native runtime surface for operating-system facilities that are
// lowered by Target/runtime providers. This module owns no OS policy itself.
// It is intentionally not imported by compiler/main so Stage0 does not need the
// newer intrinsic spellings while bootstrapping the compiler.

مرادف املأ_عشوائية_آمنة_بدائيا = بدائي_عشوائية_آمنة;
مرادف أنشئ_مقبسا_بدائيا = بدائي_إنشاء_مقبس;
مرادف اتصل_بمقبس_بدائيا = بدائي_اتصال_مقبس;
مرادف اربط_مقبسا_بدائيا = بدائي_ربط_مقبس;
مرادف استمع_لمقبس_بدائيا = بدائي_استماع_مقبس;
مرادف اقبل_مقبسا_بدائيا = بدائي_قبول_مقبس;
مرادف أرسل_عبر_مقبس_بدائيا = بدائي_إرسال_مقبس;
مرادف استقبل_عبر_مقبس_بدائيا = بدائي_استقبال_مقبس;
مرادف أوقف_مقبسا_بدائيا = بدائي_إيقاف_مقبس;
مرادف أغلق_مقبسا_بدائيا = بدائي_إغلاق_مقبس;
مرادف رمز_عنوان_مقبس_بدائيا = بدائي_ترميز_عنوان_مقبس;
مرادف اضبط_مقبسا_غير_حاصر_بدائيا = بدائي_ضبط_مقبس_غير_حاصر;
مرادف اضبط_خيار_مقبس_بدائيا = بدائي_ضبط_خيار_مقبس;
مرادف أنشئ_جلسة_تي_إل_إس_بدائيا = بدائي_إنشاء_جلسة_تي_إل_إس;
مرادف اضبط_اسم_نظير_تي_إل_إس_بدائيا = بدائي_ضبط_اسم_نظير_تي_إل_إس;
مرادف اضبط_تحقق_تي_إل_إس_بدائيا = بدائي_ضبط_تحقق_تي_إل_إس;
مرادف اضبط_هوية_خادم_تي_إل_إس_بدائيا = بدائي_ضبط_هوية_خادم_تي_إل_إس;
مرادف اضبط_جذور_ثقة_تي_إل_إس_بدائيا = بدائي_ضبط_جذور_ثقة_تي_إل_إس;
مرادف صافح_تي_إل_إس_بدائيا = بدائي_مصافحة_تي_إل_إس;
مرادف اقرأ_تي_إل_إس_بدائيا = بدائي_قراءة_تي_إل_إس;
مرادف اكتب_تي_إل_إس_بدائيا = بدائي_كتابة_تي_إل_إس;
مرادف أغلق_جلسة_تي_إل_إس_بدائيا = بدائي_إغلاق_جلسة_تي_إل_إس;
مرادف أنشئ_حلقة_أحداث_بدائيا = بدائي_إنشاء_حلقة_أحداث;
مرادف تحكم_بحلقة_أحداث_بدائيا = بدائي_تحكم_حلقة_أحداث;
مرادف انتظر_حلقة_أحداث_بدائيا = بدائي_انتظار_حلقة_أحداث;
مرادف أغلق_حلقة_أحداث_بدائيا = بدائي_إغلاق_حلقة_أحداث;
مرادف حل_اسم_مضيف_بدائيا = بدائي_حل_اسم_مضيف;
مرادف إنشاء_خيط_بدائيا = بدائي_إنشاء_خيط;
مرادف انتظار_خيط_بدائيا = بدائي_انتظار_خيط;
مرادف إنشاء_قفل_تبادلي_بدائيا = بدائي_إنشاء_قفل_تبادلي;
مرادف تدمير_قفل_تبادلي_بدائيا = بدائي_تدمير_قفل_تبادلي;
مرادف قفل_تبادلي_بدائيا = بدائي_قفل_تبادلي;
مرادف فتح_قفل_تبادلي_بدائيا = بدائي_فتح_قفل_تبادلي;
مرادف إنشاء_شرط_بدائيا = بدائي_إنشاء_شرط;
مرادف تدمير_شرط_بدائيا = بدائي_تدمير_شرط;
مرادف انتظار_شرط_بدائيا = بدائي_انتظار_شرط;
مرادف إشارة_شرط_بدائيا = بدائي_إشارة_شرط;
مرادف بث_شرط_بدائيا = بدائي_بث_شرط;

عام عرف املأ_عشوائية_آمنة(
    المحتوى: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): عدد {
    أرجع املأ_عشوائية_آمنة_بدائيا(*المحتوى, الإزاحة, العدد);
}

عام عرف أنشئ_مقبسا(المجال: عدد, النوع: عدد, البروتوكول: عدد): عدد {
    أرجع أنشئ_مقبسا_بدائيا(المجال, النوع, البروتوكول);
}

عام عرف اتصل_بمقبس(
    المقبس: عدد,
    العنوان: &متجه غ8,
    طول_العنوان: عدد
): عدد {
    أرجع اتصل_بمقبس_بدائيا(المقبس, *العنوان, طول_العنوان);
}

عام عرف اربط_مقبسا(
    المقبس: عدد,
    العنوان: &متجه غ8,
    طول_العنوان: عدد
): عدد {
    أرجع اربط_مقبسا_بدائيا(المقبس, *العنوان, طول_العنوان);
}

عام عرف استمع_لمقبس(المقبس: عدد, التراكم: عدد): عدد {
    أرجع استمع_لمقبس_بدائيا(المقبس, التراكم);
}

عام عرف اقبل_مقبسا(المقبس: عدد): عدد {
    أرجع اقبل_مقبسا_بدائيا(المقبس);
}

عام عرف أرسل_عبر_مقبس(
    المقبس: عدد,
    المحتوى: &متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): عدد {
    أرجع أرسل_عبر_مقبس_بدائيا(المقبس, *المحتوى, الإزاحة, العدد);
}

عام عرف استقبل_عبر_مقبس(
    المقبس: عدد,
    المحتوى: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): عدد {
    أرجع استقبل_عبر_مقبس_بدائيا(المقبس, *المحتوى, الإزاحة, العدد);
}

عام عرف أوقف_مقبسا(المقبس: عدد, الاتجاه: عدد): عدد {
    أرجع أوقف_مقبسا_بدائيا(المقبس, الاتجاه);
}

عام عرف أغلق_مقبسا(المقبس: عدد): عدد {
    أرجع أغلق_مقبسا_بدائيا(المقبس);
}

// `العائلة` is normalized: 4 = IPv4, 6 = IPv6. The Target provider owns
// AF_* values and native sockaddr layout, including Darwin's length byte.
عام عرف رمز_عنوان_مقبس(
    العائلة: عدد,
    المنفذ: عدد,
    العنوان: &متجه غ8,
    الخارج: &متغير متجه غ8
): عدد {
    أرجع رمز_عنوان_مقبس_بدائيا(العائلة, المنفذ, *العنوان, *الخارج);
}

عام عرف اضبط_مقبسا_غير_حاصر(المقبس: عدد, مفعل: عدد): عدد {
    أرجع اضبط_مقبسا_غير_حاصر_بدائيا(المقبس, مفعل);
}

// Normalized socket-option IDs are compiler/runtime ABI, not OS constants:
// 1 TCP_NODELAY, 2 SO_REUSEADDR, 3 SO_KEEPALIVE, 4 IPv4 TTL,
// 5 IPv6 unicast hops, 6 receive buffer, 7 send buffer.
عام عرف اضبط_خيار_مقبس(المقبس: عدد, الخيار: عدد, القيمة: عدد): عدد {
    أرجع اضبط_خيار_مقبس_بدائيا(المقبس, الخيار, القيمة);
}

// TLS remains a low-level runtime provider here. Public configuration,
// certificate, stream, and policy types remain owned by the standard library.
عام عرف أنشئ_جلسة_تي_إل_إس(الدور: عدد, المقبس: عدد): عدد {
    أرجع أنشئ_جلسة_تي_إل_إس_بدائيا(الدور, المقبس);
}

عام عرف اضبط_اسم_نظير_تي_إل_إس(الجلسة: عدد, الاسم: &متجه غ8): عدد {
    أرجع اضبط_اسم_نظير_تي_إل_إس_بدائيا(الجلسة, *الاسم);
}

عام عرف اضبط_تحقق_تي_إل_إس(الجلسة: عدد, مفعّل: عدد): عدد {
    أرجع اضبط_تحقق_تي_إل_إس_بدائيا(الجلسة, مفعّل);
}

// Portable server identity input is PKCS#12 bytes plus a UTF-8 password.
// Certificate/private-key mechanics remain Target-owned.
عام عرف اضبط_هوية_خادم_تي_إل_إس(
    الجلسة: عدد,
    الهوية: &متجه غ8,
    كلمة_المرور: &متجه غ8
): عدد {
    أرجع اضبط_هوية_خادم_تي_إل_إس_بدائيا(الجلسة, *الهوية, *كلمة_المرور);
}

// Portable trust bundle: repeated [u32 big-endian DER-length][DER certificate].
// Platform trust-store/certificate objects never cross this runtime boundary.
عام عرف اضبط_جذور_ثقة_تي_إل_إس(الجلسة: عدد, الجذور: &متجه غ8): عدد {
    أرجع اضبط_جذور_ثقة_تي_إل_إس_بدائيا(الجلسة, *الجذور);
}

عام عرف صافح_تي_إل_إس(الجلسة: عدد): عدد {
    أرجع صافح_تي_إل_إس_بدائيا(الجلسة);
}

عام عرف اقرأ_تي_إل_إس(الجلسة: عدد, المحتوى: &متغير متجه غ8, الإزاحة: عدد, العدد: عدد): عدد {
    أرجع اقرأ_تي_إل_إس_بدائيا(الجلسة, *المحتوى, الإزاحة, العدد);
}

عام عرف اكتب_تي_إل_إس(الجلسة: عدد, المحتوى: &متجه غ8, الإزاحة: عدد, العدد: عدد): عدد {
    أرجع اكتب_تي_إل_إس_بدائيا(الجلسة, *المحتوى, الإزاحة, العدد);
}

عام عرف أغلق_جلسة_تي_إل_إس(الجلسة: عدد): عدد {
    أرجع أغلق_جلسة_تي_إل_إس_بدائيا(الجلسة);
}

عام عرف أنشئ_حلقة_أحداث(): عدد {
    أرجع أنشئ_حلقة_أحداث_بدائيا();
}

عام عرف تحكم_بحلقة_أحداث(
    الحلقة: عدد,
    العملية: عدد,
    الواصف: عدد,
    الأحداث: عدد
): عدد {
    أرجع تحكم_بحلقة_أحداث_بدائيا(الحلقة, العملية, الواصف, الأحداث);
}

عام عرف انتظر_حلقة_أحداث(الحلقة: عدد, المهلة_ملي: عدد): عدد {
    أرجع انتظر_حلقة_أحداث_بدائيا(الحلقة, المهلة_ملي);
}

عام عرف أغلق_حلقة_أحداث(الحلقة: عدد): عدد {
    أرجع أغلق_حلقة_أحداث_بدائيا(الحلقة);
}

// Writes one portable DNS result into `المحتوى`: byte 0 family (4/6), byte 1 address length,
// bytes 2..3 network-order port, then 4/16 address bytes. Returns 8/20 or a negative error.
عام عرف حل_اسم_مضيف(
    الاسم_الصفري: &متجه غ8,
    العائلة: عدد,
    نوع_مقبس: عدد,
    البروتوكول: عدد,
    المحتوى: &متغير متجه غ8
): عدد {
    أرجع حل_اسم_مضيف_بدائيا(*الاسم_الصفري, العائلة, نوع_مقبس, البروتوكول, *المحتوى);
}

// Threads and synchronization use opaque integer handles. Platform ABI details
// and synchronization-object storage remain Target-provider ownership.
عام عرف أنشئ_خيطا(البداية: fn(عدد): عدد, السياق: عدد): عدد {
    أرجع إنشاء_خيط_بدائيا(البداية, السياق);
}

عام عرف انتظر_خيطا(الخيط: عدد): عدد {
    أرجع انتظار_خيط_بدائيا(الخيط);
}

عام عرف أنشئ_قفلا_تبادليا(): عدد { أرجع إنشاء_قفل_تبادلي_بدائيا(); }
عام عرف دمر_قفلا_تبادليا(القفل: عدد): عدد { أرجع تدمير_قفل_تبادلي_بدائيا(القفل); }
عام عرف اقفل_تبادليا(القفل: عدد): عدد { أرجع قفل_تبادلي_بدائيا(القفل); }
عام عرف افتح_قفلا_تبادليا(القفل: عدد): عدد { أرجع فتح_قفل_تبادلي_بدائيا(القفل); }
عام عرف أنشئ_شرطا(): عدد { أرجع إنشاء_شرط_بدائيا(); }
عام عرف دمر_شرطا(الشرط: عدد): عدد { أرجع تدمير_شرط_بدائيا(الشرط); }
عام عرف انتظر_شرطا(الشرط: عدد, القفل: عدد): عدد { أرجع انتظار_شرط_بدائيا(الشرط, القفل); }
عام عرف أشر_لشرط(الشرط: عدد): عدد { أرجع إشارة_شرط_بدائيا(الشرط); }
عام عرف ابث_شرطا(الشرط: عدد): عدد { أرجع بث_شرط_بدائيا(الشرط); }
