    }
    | هوية_خدمة_تشغيل.فتح_ملف -> {
        أرجع أنشئ_عقد_خدمة_تشغيل(1, 2, فئة_ناتج_خدمة_تشغيل.عدد_صحيح(), صواب, خطأ);
    }
