استورد compiler.runtime.service_identity;

// Abstract result category; it carries no target ABI or memory-layout detail.
عام نوع فئة_ناتج_خدمة_تشغيل =
    | بلا_قيمة
    | مرجع_ذاكرة
;

عام نوع عقد_خدمة_تشغيل = {
    أقل_عدد_حجج: غير_موقع,
    أكبر_عدد_حجج: غير_موقع,
    فئة_الناتج: فئة_ناتج_خدمة_تشغيل,
    قد_تفشل: منطقي,
    قد_تخصص: منطقي
};

عرف أنشئ_عقد_خدمة_تشغيل(
    الأقل: غير_موقع,
    الأكبر: غير_موقع,
    الناتج: فئة_ناتج_خدمة_تشغيل,
    قد_تفشل: منطقي,
    قد_تخصص: منطقي
): عقد_خدمة_تشغيل {
    دع العقد: عقد_خدمة_تشغيل = {
        أقل_عدد_حجج: الأقل,
        أكبر_عدد_حجج: الأكبر,
        فئة_الناتج: الناتج,
        قد_تفشل: قد_تفشل,
        قد_تخصص: قد_تخصص
    };
    أرجع العقد;
}

// These contracts describe compiler-internal allocator services only.
عام عرف عقد_خدمة_تشغيل_للهوية(الخدمة: هوية_خدمة_تشغيل): عقد_خدمة_تشغيل {
    طابق الخدمة مع
    | هوية_خدمة_تشغيل.تخصيص -> {
        أرجع أنشئ_عقد_خدمة_تشغيل(1, 2, فئة_ناتج_خدمة_تشغيل.مرجع_ذاكرة(), صواب, صواب);
    }
    | هوية_خدمة_تشغيل.إعادة_تخصيص -> {
        أرجع أنشئ_عقد_خدمة_تشغيل(3, 4, فئة_ناتج_خدمة_تشغيل.مرجع_ذاكرة(), صواب, صواب);
    }
    | هوية_خدمة_تشغيل.تحرير -> {
        أرجع أنشئ_عقد_خدمة_تشغيل(2, 2, فئة_ناتج_خدمة_تشغيل.بلا_قيمة(), صواب, خطأ);
    };
}
