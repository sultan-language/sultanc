    | هوية_خدمة_تشغيل.إنشاء_دليل -> { أرجع أنشئ_عقد_خدمة_تشغيل(1, 1, فئة_ناتج_خدمة_تشغيل.عدد_صحيح(), صواب, خطأ); }
