عرف اسما_تشغيل_متساويان(الأيسر: &متجه غ8, الأيمن: &متجه غ8): منطقي {
    لو ((الطول(*الأيسر) مثل غير_موقع) != (الطول(*الأيمن) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأيسر) مثل غير_موقع)) {
        لو ((*الأيسر)[ف] != (*الأيمن)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

