}

عام عرف هويتا_بدائي_مترجم_متساويتان(أ: هوية_بدائي_مترجم, ب: هوية_بدائي_مترجم): منطقي {
    طابق أ مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> { طابق ب مع | هوية_بدائي_مترجم.نداء_نواة_خام -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | هوية_بدائي_مترجم.طول -> { طابق ب مع | هوية_بدائي_مترجم.طول -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | هوية_بدائي_مترجم.إلحاق -> { طابق ب مع | هوية_بدائي_مترجم.إلحاق -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | هوية_بدائي_مترجم.تبديل_موضعين -> { طابق ب مع | هوية_بدائي_مترجم.تبديل_موضعين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
