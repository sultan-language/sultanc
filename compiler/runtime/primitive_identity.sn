// الهوية الدلالية المقننة للبدائيات التي يوفرها المترجم.
// هذه القيم ليست تهجئات مصدرية ولا تعرف شيئا عن المرادفات اللغوية.
عام نوع هوية_بدائي_مترجم =
    | طول
    | إلحاق
    | تبديل_موضعين
    | تحرير
    | معمارية_المضيف
    | منصة_المضيف
    | بيئة_المضيف
    | نداء_نواة_خام
    | بتات_ع64
    | ع64_من_بتات
    | بتات_ع32
    | ع32_من_بتات
    // WebAssembly linear-memory machine operations (wasm targets only). They
    // address the module's single linear memory by u32 offset, which is the
    // WebAssembly memory model itself; std's wasm allocation provider is
    // their consumer. Other targets reject them at backend selection.
    | نمو_ذاكرة_خطية
    | قراءة_ذاكرة_خطية
    | كتابة_ذاكرة_خطية
    | نسخ_ذاكرة_خطية
    | قاعدة_كومة_خطية
    // Flat machine memory of a 64-bit native process: a u64 word load/store at
    // a u64 address. std's allocation provider is their consumer on native
    // 64-bit targets; wasm and 32-bit targets reject them at backend selection.
    | قراءة_ذاكرة_آلة
    | كتابة_ذاكرة_آلة
    // Compile-time facts of the compiling toolchain (runtime/toolchain_facts.sn):
    // the libLLVM major version (u32) and library path (text). MSIR lowering
    // folds every call into a constant; no backend or interpreter sees them.
    | إصدار_إل_إل_في_إم_للأداة
    | مكتبة_إل_إل_في_إم_للأداة
;

عام عرف انسخ_هوية_بدائي_مترجم(الهوية: هوية_بدائي_مترجم): هوية_بدائي_مترجم {
    طابق الهوية مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> { أرجع هوية_بدائي_مترجم.نداء_نواة_خام(); }
    | هوية_بدائي_مترجم.طول -> { أرجع هوية_بدائي_مترجم.طول(); }
    | هوية_بدائي_مترجم.إلحاق -> { أرجع هوية_بدائي_مترجم.إلحاق(); }
    | هوية_بدائي_مترجم.تبديل_موضعين -> { أرجع هوية_بدائي_مترجم.تبديل_موضعين(); }
    | هوية_بدائي_مترجم.تحرير -> { أرجع هوية_بدائي_مترجم.تحرير(); }
    | هوية_بدائي_مترجم.معمارية_المضيف -> { أرجع هوية_بدائي_مترجم.معمارية_المضيف(); }
    | هوية_بدائي_مترجم.منصة_المضيف -> { أرجع هوية_بدائي_مترجم.منصة_المضيف(); }
    | هوية_بدائي_مترجم.بيئة_المضيف -> { أرجع هوية_بدائي_مترجم.بيئة_المضيف(); }
    | هوية_بدائي_مترجم.بتات_ع64 -> { أرجع هوية_بدائي_مترجم.بتات_ع64(); }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { أرجع هوية_بدائي_مترجم.ع64_من_بتات(); }
    | هوية_بدائي_مترجم.بتات_ع32 -> { أرجع هوية_بدائي_مترجم.بتات_ع32(); }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { أرجع هوية_بدائي_مترجم.ع32_من_بتات(); }
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> { أرجع هوية_بدائي_مترجم.نمو_ذاكرة_خطية(); }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> { أرجع هوية_بدائي_مترجم.قراءة_ذاكرة_خطية(); }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> { أرجع هوية_بدائي_مترجم.كتابة_ذاكرة_خطية(); }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> { أرجع هوية_بدائي_مترجم.نسخ_ذاكرة_خطية(); }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> { أرجع هوية_بدائي_مترجم.قاعدة_كومة_خطية(); }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> { أرجع هوية_بدائي_مترجم.قراءة_ذاكرة_آلة(); }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> { أرجع هوية_بدائي_مترجم.كتابة_ذاكرة_آلة(); }
    | هوية_بدائي_مترجم.إصدار_إل_إل_في_إم_للأداة -> { أرجع هوية_بدائي_مترجم.إصدار_إل_إل_في_إم_للأداة(); }
    | هوية_بدائي_مترجم.مكتبة_إل_إل_في_إم_للأداة -> { أرجع هوية_بدائي_مترجم.مكتبة_إل_إل_في_إم_للأداة(); }
    ;
}

