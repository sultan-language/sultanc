استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.service_identity;

// Describes semantic lowering shape, not source-call syntax.
عام نوع فئة_خفض_بدائي =
    | جوهري
    | خدمة_مكيفة
    | تركيب_خدمات
;

// Canonical relation between a genuine compiler primitive and Runtime.
عام نوع علاقة_بدائي_بالتشغيل =
    | جوهري
    | خدمة_مكيفة بنوع هوية_خدمة_تشغيل
    | تركيب_خدمات
;

عام عرف علاقة_تشغيل_للبدائي(البدائي: هوية_بدائي_مترجم): علاقة_بدائي_بالتشغيل {
    طابق البدائي مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.طول -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.بتات_ع64 -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.بتات_ع32 -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.جمع_ملتف -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.طرح_ملتف -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ضرب_ملتف -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.معمارية_المضيف -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.منصة_المضيف -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.بيئة_المضيف -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.حجم_النوع -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.محاذاة_النوع -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.فشل_وقت_الترجمة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.إلحاق -> { أرجع علاقة_بدائي_بالتشغيل.تركيب_خدمات(); }
    | هوية_بدائي_مترجم.استنساخ -> {
        // Clone lowers to MSIR clone glue: ordinary calls, loads and appends.
        أرجع علاقة_بدائي_بالتشغيل.جوهري();
    }
    | هوية_بدائي_مترجم.تبديل_موضعين -> {
        // Place exchange lowers entirely to verified MSIR load/store operations.
        أرجع علاقة_بدائي_بالتشغيل.جوهري();
    }
    | هوية_بدائي_مترجم.تحرير -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.تحرير());
    }
    // Copy glue (ownership_glue.sn) and closure-environment machine operations.
    | هوية_بدائي_مترجم.احتفاظ_بقيمة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    // Pop and truncate lower to MSIR glue; the length store is a header write.
    | هوية_بدائي_مترجم.إزالة_الأخير -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.اقتطاع_متجه -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ضبط_طول_متجه -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.سعة_متجه -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    // Reserve reallocates through the same storage services as append.
    | هوية_بدائي_مترجم.حجز_سعة_متجه -> { أرجع علاقة_بدائي_بالتشغيل.تركيب_خدمات(); }
    | هوية_بدائي_مترجم.عملية_عائمة(_) -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    // Thread support: atomics and thread entry are machine operations.
    | هوية_بدائي_مترجم.ذري_حمل -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ذري_خزن -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ذري_تبديل -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ذري_جلب_و -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.سياج_ذاكرة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.سرب_قيمة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.عنوان_دالة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.دالة_من_عنوان -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.مدخل_سي_لدالة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); }
    | هوية_بدائي_مترجم.نداء_عنوان_سي -> { أرجع علاقة_بدائي_بالتشغيل.جوهري(); };
}

عام عرف فئة_خفض_للبدائي(البدائي: هوية_بدائي_مترجم): فئة_خفض_بدائي {
    طابق علاقة_تشغيل_للبدائي(البدائي) مع
    | علاقة_بدائي_بالتشغيل.جوهري -> { أرجع فئة_خفض_بدائي.جوهري(); }
    | علاقة_بدائي_بالتشغيل.خدمة_مكيفة(_) -> { أرجع فئة_خفض_بدائي.خدمة_مكيفة(); }
    | علاقة_بدائي_بالتشغيل.تركيب_خدمات -> { أرجع فئة_خفض_بدائي.تركيب_خدمات(); };
}
