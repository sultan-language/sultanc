استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.service_identity;

// تصف هذه الفئة شكل الخفض الدلالي للبدائي، لا شكل نداء المصدر.
عام نوع فئة_خفض_بدائي =
    | جوهري
    | خدمة_مطابقة
    | خدمة_مكيفة
    | تركيب_خدمات
;

// العلاقة المقننة بين معنى البدائي وخدمات وقت التشغيل.
// الخدمة المطابقة تحفظ شكل الحجج والناتج الدلالي، بينما الخدمة المكيفة
// تحتاج تحويلا للحجج أو الناتج. تركيب الخدمات لا يختزل إلى خدمة واحدة.
عام نوع علاقة_بدائي_بالتشغيل =
    | جوهري
    | خدمة_مطابقة بنوع هوية_خدمة_تشغيل
    | خدمة_مكيفة بنوع هوية_خدمة_تشغيل
    | تركيب_خدمات
;

عام عرف علاقة_تشغيل_للبدائي(البدائي: هوية_بدائي_مترجم): علاقة_بدائي_بالتشغيل {
    طابق البدائي مع
    | هوية_بدائي_مترجم.طول -> {
        أرجع علاقة_بدائي_بالتشغيل.جوهري();
    }
    | هوية_بدائي_مترجم.نص_من_بايتات -> {
        أرجع علاقة_بدائي_بالتشغيل.جوهري();
    }
    | هوية_بدائي_مترجم.معمارية_المضيف -> {
        أرجع علاقة_بدائي_بالتشغيل.جوهري();
    }
    | هوية_بدائي_مترجم.منصة_المضيف -> {
        أرجع علاقة_بدائي_بالتشغيل.جوهري();
    }
    | هوية_بدائي_مترجم.بيئة_المضيف -> {
        أرجع علاقة_بدائي_بالتشغيل.جوهري();
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        أرجع علاقة_بدائي_بالتشغيل.تركيب_خدمات();
    }
    | هوية_بدائي_مترجم.تحرير -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.تحرير());
    }
    | هوية_بدائي_مترجم.فتح_ملف_للقراءة -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.فتح_ملف());
    }
    | هوية_بدائي_مترجم.قراءة_بايت_ملف -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.قراءة_ملف());
    }
    | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.قراءة_ملف());
    }
    | هوية_بدائي_مترجم.إنشاء_ملف_للكتابة -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.إنشاء_ملف());
    }
    | هوية_بدائي_مترجم.كتابة_مقطع_ملف -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.كتابة_ملف());
    }
    | هوية_بدائي_مترجم.إغلاق_ملف -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.إغلاق_ملف());
    }
    | هوية_بدائي_مترجم.فتح_دليل -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.فتح_دليل());
    }
    | هوية_بدائي_مترجم.قراءة_مدخل_دليل -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.قراءة_مدخل_دليل());
    }
    | هوية_بدائي_مترجم.إغلاق_دليل -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.إغلاق_دليل());
    }
    | هوية_بدائي_مترجم.قراءة_بايت_الدخل_القياسي -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.قراءة_الدخل_القياسي());
    }
    | هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.قراءة_الدخل_القياسي());
    }
    | هوية_بدائي_مترجم.كتابة_بايتات_تنفيذية -> {
        أرجع علاقة_بدائي_بالتشغيل.تركيب_خدمات();
    }
    | هوية_بدائي_مترجم.كتابة_الخرج_القياسي -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.كتابة_الخرج_القياسي());
    }
    | هوية_بدائي_مترجم.كتابة_الخطأ_القياسي -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.كتابة_الخطأ_القياسي());
    }
    | هوية_بدائي_مترجم.عدد_الوسائط -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.عدد_الوسائط());
    }
    | هوية_بدائي_مترجم.الوصول_إلى_وسيط -> {
        // خدمة الوصول إلى وسيط تملك المعنى المحايد للمنصة؛ تحويل مرجع
        // الذاكرة إلى قيمة نص هو تكييف Runtime وليس تركيب سياسة في Target.
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مكيفة(هوية_خدمة_تشغيل.الوصول_إلى_وسيط());
    }
    | هوية_بدائي_مترجم.خروج_العملية -> {
        أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.خروج_العملية());
    }
    | هوية_بدائي_مترجم.تصنيف_خطأ_نظام -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.تصنيف_خطأ_نظام()); }
    | هوية_بدائي_مترجم.إنشاء_دليل -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.إنشاء_دليل()); }
    | هوية_بدائي_مترجم.إزالة_ملف -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.إزالة_ملف()); }
    | هوية_بدائي_مترجم.إزالة_دليل -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.إزالة_دليل()); }
    | هوية_بدائي_مترجم.إعادة_تسمية -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.إعادة_تسمية()); }
    | هوية_بدائي_مترجم.نوع_مسار -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.نوع_مسار()); }
    | هوية_بدائي_مترجم.حجم_مسار -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.حجم_مسار()); }
    | هوية_بدائي_مترجم.وقت_تعديل_مسار -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.وقت_تعديل_مسار()); }
    | هوية_بدائي_مترجم.فتح_مقبض_ملف_للقراءة -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.فتح_مقبض_ملف_للقراءة()); }
    | هوية_بدائي_مترجم.إنشاء_مقبض_ملف_للكتابة -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.إنشاء_مقبض_ملف_للكتابة()); }
    | هوية_بدائي_مترجم.قراءة_مقطع_مقبض_ملف -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.قراءة_مقطع_مقبض_ملف()); }
    | هوية_بدائي_مترجم.كتابة_مقطع_مقبض_ملف -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.كتابة_مقطع_مقبض_ملف()); }
    | هوية_بدائي_مترجم.إغلاق_مقبض_ملف -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.إغلاق_مقبض_ملف()); }
    | هوية_بدائي_مترجم.تحريك_مقبض_ملف -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.تحريك_مقبض_ملف()); }
    | هوية_بدائي_مترجم.موضع_مقبض_ملف -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.موضع_مقبض_ملف()); }
    | هوية_بدائي_مترجم.مزامنة_مقبض_ملف -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.مزامنة_مقبض_ملف()); }
    | هوية_بدائي_مترجم.وقت_رتيب_نانو -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.وقت_رتيب_نانو()); }
    | هوية_بدائي_مترجم.وقت_نظام_نانو -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.وقت_نظام_نانو()); }
    | هوية_بدائي_مترجم.نوم_نانو -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.نوم_نانو()); }
    | هوية_بدائي_مترجم.طول_متغير_بيئة -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.طول_متغير_بيئة()); }
    | هوية_بدائي_مترجم.قراءة_متغير_بيئة -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.قراءة_متغير_بيئة()); }
    | هوية_بدائي_مترجم.دليل_العمل -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.دليل_العمل()); }
    | هوية_بدائي_مترجم.الدليل_المؤقت -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.الدليل_المؤقت()); }
    | هوية_بدائي_مترجم.تشغيل_عملية -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.تشغيل_عملية()); }
    | هوية_بدائي_مترجم.انتظار_عملية -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.انتظار_عملية()); }
    | هوية_بدائي_مترجم.حجم_صفحة_النظام -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.حجم_صفحة_النظام()); }
    | هوية_بدائي_مترجم.خريطة_ذاكرة_النظام -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.خريطة_ذاكرة_النظام()); }
    | هوية_بدائي_مترجم.إلغاء_خريطة_ذاكرة_النظام -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.إلغاء_خريطة_ذاكرة_النظام()); }
    | هوية_بدائي_مترجم.حماية_ذاكرة_النظام -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.حماية_ذاكرة_النظام()); }
    | هوية_بدائي_مترجم.قفل_ذاكرة_النظام -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.قفل_ذاكرة_النظام()); }
    | هوية_بدائي_مترجم.إلغاء_قفل_ذاكرة_النظام -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.إلغاء_قفل_ذاكرة_النظام()); }
    | هوية_بدائي_مترجم.نصيحة_ذاكرة_النظام -> { أرجع علاقة_بدائي_بالتشغيل.خدمة_مطابقة(هوية_خدمة_تشغيل.نصيحة_ذاكرة_النظام()); }
    ;
}

عام عرف فئة_خفض_للبدائي(البدائي: هوية_بدائي_مترجم): فئة_خفض_بدائي {
    طابق علاقة_تشغيل_للبدائي(البدائي) مع
    | علاقة_بدائي_بالتشغيل.جوهري -> {
        أرجع فئة_خفض_بدائي.جوهري();
    }
    | علاقة_بدائي_بالتشغيل.خدمة_مطابقة(_) -> {
        أرجع فئة_خفض_بدائي.خدمة_مطابقة();
    }
    | علاقة_بدائي_بالتشغيل.خدمة_مكيفة(_) -> {
        أرجع فئة_خفض_بدائي.خدمة_مكيفة();
    }
    | علاقة_بدائي_بالتشغيل.تركيب_خدمات -> {
        أرجع فئة_خفض_بدائي.تركيب_خدمات();
    };
}

// يعيد خدمة واحدة فقط عندما تكون علاقة البدائي بخدمة واحدة مقننة، سواء
// كانت مطابقة للشكل الدلالي أو تحتاج تكييفا. الجوهري والتركيب يعيدان لا_شيء.
عام عرف حل_خدمة_تشغيل_للبدائي(
    البدائي: هوية_بدائي_مترجم
): اختيار هوية_خدمة_تشغيل {
    طابق علاقة_تشغيل_للبدائي(البدائي) مع
    | علاقة_بدائي_بالتشغيل.خدمة_مطابقة(الخدمة) -> {
        أرجع اختيار.بعض(الخدمة);
    }
    | علاقة_بدائي_بالتشغيل.خدمة_مكيفة(الخدمة) -> {
        أرجع اختيار.بعض(الخدمة);
    }
    | علاقة_بدائي_بالتشغيل.جوهري -> {
        أرجع اختيار.لا_شيء();
    }
    | علاقة_بدائي_بالتشغيل.تركيب_خدمات -> {
        أرجع اختيار.لا_شيء();
    };
}
