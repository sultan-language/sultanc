استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.lexer.trivia;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.parser.parser;
استورد compiler.frontend.parser.result;
استورد compiler.backend.target.target_model;
استورد compiler.format.layout;
استورد std.text.from_bytes;

// The formatter's check of its own output, run on every formatting: the
// formatted text is lexed again by the canonical lexer and must hold the same
// tokens (kinds and exact bytes, so the same payloads), the same comments
// and marks byte for byte and in order, and it must parse. Only then is the
// output used; otherwise the formatter reports an internal error and writes
// nothing.

عرف بايتات_متساوية(
    أ: &نص,
    بداية_أ: طبيعي,
    نهاية_أ: طبيعي,
    ب: &نص,
    بداية_ب: طبيعي,
    نهاية_ب: طبيعي
): منطقي {
    إذا (نهاية_أ - بداية_أ != نهاية_ب - بداية_ب) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (بداية_أ + ف < نهاية_أ) {
        إذا ((*أ)[بداية_أ + ف] != (*ب)[بداية_ب + ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// المصدر is the source formatted, العناصر its elements (عناصر_مصدر) and
// الناتج the formatted text, parsed for الهدف as the source was.
عام عرف تحقق_من_ناتج_التنسيق(
    المصدر: &مصدر,
    العناصر: &متجه عنصر_تنسيق,
    الناتج: &متجه ط8,
    الهدف: &اختياري واصف_هدف
): منطقي {
    دع المنسق: مصدر = مصدر_جديد((*المصدر).المعرف, انسخ_نص(&(*المصدر).الاسم), من_بايتات(الناتج));
    طابق حلل_معجميا_مع_التوافه(&المنسق) مع
    | نتيجة_تحليل_معجمي_بتوافه.مرفوض(_) -> { أرجع خطأ; }
    | نتيجة_تحليل_معجمي_بتوافه.سلسلة(السلسلة) -> {
        دع الأصل: &نص = &(*المصدر).المحتوى;
        دع الجديد: &نص = &المنسق.المحتوى;
        دع عدد_العناصر: طبيعي = الطول(*العناصر) مثل طبيعي;
        دع عدد_الرموز: طبيعي = الطول(السلسلة.الرموز) مثل طبيعي;
        دع عدد_التوافه: طبيعي = الطول(السلسلة.التوافه) مثل طبيعي;
        دع ر: متغير طبيعي = 0;
        دع ت: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < عدد_العناصر) {
            دع العنصر: عنصر_تنسيق = (*العناصر)[ف];
            إذا (العنصر.الصنف == صنف_عنصر_تنسيق.رمز_عنصر()) {
                إذا (ر >= عدد_الرموز) { أرجع خطأ; };
                دع الرمز: &رمز_مصدر = &السلسلة.الرموز[ر];
                إذا ((*الرمز).النوع != العنصر.النوع) { أرجع خطأ; };
                إذا (!بايتات_متساوية(
                    الأصل, العنصر.البداية, العنصر.النهاية,
                    الجديد, (*الرمز).النطاق.البداية.البايت مثل طبيعي, (*الرمز).النطاق.النهاية.البايت مثل طبيعي
                )) {
                    أرجع خطأ;
                };
                ر := ر + 1;
            } وإلا {
                إذا (ت >= عدد_التوافه) { أرجع خطأ; };
                دع التافهة: تافهة_مصدر = السلسلة.التوافه[ت];
                دع تعليق: منطقي = التافهة.الصنف == صنف_تافهة.تعليق_سطر();
                إذا (تعليق != (العنصر.الصنف == صنف_عنصر_تنسيق.تعليق_عنصر())) { أرجع خطأ; };
                إذا (!بايتات_متساوية(
                    الأصل, العنصر.البداية, العنصر.النهاية,
                    الجديد, التافهة.النطاق.البداية.البايت مثل طبيعي, التافهة.النطاق.النهاية.البايت مثل طبيعي
                )) {
                    أرجع خطأ;
                };
                ت := ت + 1;
            };
            ف := ف + 1;
        }
        // Exactly the end of file is left, and no other trivia.
        إذا (ر + 1 != عدد_الرموز || ت != عدد_التوافه) { أرجع خطأ; };
        طابق حلل_الرموز_لهدف(&المنسق, &السلسلة.الرموز, الهدف) مع
        | نتيجة_تحليل.شجرة(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}
