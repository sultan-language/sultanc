استورد compiler.source.source_file;
استورد compiler.source.span;
استورد compiler.frontend.lexer.token;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.lexer.trivia;
استورد compiler.frontend.lexer.token_registry;
استورد compiler.frontend.identifier_identity;

// The canonical layout of SultanC source. It moves whitespace only: every
// token, comment and direction mark is copied byte for byte, in order, and the
// author's line breaks are kept. What the layout decides is the indentation
// of each line, the spacing between two elements on one line, and the blank
// lines (at most one in a row, none at the start or the end of the file).
// docs/en/reference/formatter.md states the rules.

// One element of the source as the layout places it: a token, a comment or a
// direction mark (trivia.sn), with the whitespace the author wrote before it.
عام نوع صنف_عنصر_تنسيق =
    | رمز_عنصر
    | تعليق_عنصر
    | علامة_عنصر
;

عام نوع عنصر_تنسيق = {
    الصنف: صنف_عنصر_تنسيق,
    // The token kind; نهاية_الملف for a comment or a mark.
    النوع: رمز,
    // The element's bytes in the source. A comment ends before its trailing
    // spaces, which are whitespace.
    البداية: طبيعي,
    النهاية: طبيعي,
    // Line breaks (LF bytes) in the whitespace before the element.
    الأسطر_قبله: طبيعي,
    // Whitespace bytes before the element on its own line.
    الفراغ_قبله: طبيعي,
    // An identifier, or a keyword written right after `.` (a member or a
    // constructor named by a keyword spelling).
    اسم: منطقي
};

// The formatted bytes, and where each element starts in them.
عام نوع ترتيب_مصدر = {
    البايتات: متجه ط8,
    المواضع: متجه طبيعي
};

عرف بايت_مسافة(البايت: ط8): منطقي {
    أرجع البايت == 0x20 || البايت == 0x09 || البايت == 0x0D;
}

// The elements of a lexed source in source order: its tokens (without the end
// of file) merged with its trivia.
عام عرف عناصر_مصدر(
    المصدر: &مصدر,
    الرموز: &متجه رمز_مصدر,
    التوافه: &متجه تافهة_مصدر
): متجه عنصر_تنسيق {
    دع الناتج: متغير متجه عنصر_تنسيق = [];
    دع عدد_الرموز: طبيعي = الطول(*الرموز) مثل طبيعي;
    دع عدد_التوافه: طبيعي = الطول(*التوافه) مثل طبيعي;
    دع ر: متغير طبيعي = 0;
    دع ت: متغير طبيعي = 0;
    دع نهاية_السابق: متغير طبيعي = 0;
    دع النوع_السابق: متغير رمز = رمز.نهاية_الملف();
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع بقي_رمز: منطقي = ر < عدد_الرموز && (*الرموز)[ر].النوع != رمز.نهاية_الملف();
        دع بقيت_تافهة: منطقي = ت < عدد_التوافه;
        إذا (!بقي_رمز && !بقيت_تافهة) {
            مستمر := خطأ;
        } وإلا {
            دع خذ_تافهة: منطقي = بقيت_تافهة
                && (!بقي_رمز
                    || (*التوافه)[ت].النطاق.البداية.البايت < (*الرموز)[ر].النطاق.البداية.البايت);
            دع الصنف: متغير صنف_عنصر_تنسيق = صنف_عنصر_تنسيق.رمز_عنصر();
            دع النوع: متغير رمز = رمز.نهاية_الملف();
            دع البداية: متغير طبيعي = 0;
            دع النهاية: متغير طبيعي = 0;
            إذا (خذ_تافهة) {
                دع التافهة: تافهة_مصدر = (*التوافه)[ت];
                البداية := التافهة.النطاق.البداية.البايت مثل طبيعي;
                النهاية := التافهة.النطاق.النهاية.البايت مثل طبيعي;
                طابق التافهة.الصنف مع
                | صنف_تافهة.تعليق_سطر -> {
                    الصنف := صنف_عنصر_تنسيق.تعليق_عنصر();
                    طالما (النهاية > البداية && بايت_مسافة(بايت_المصدر(المصدر, النهاية - 1))) {
                        النهاية := النهاية - 1;
                    }
                }
                | _ -> { الصنف := صنف_عنصر_تنسيق.علامة_عنصر(); };
                ت := ت + 1;
            } وإلا {
                النوع := (*الرموز)[ر].النوع;
                البداية := (*الرموز)[ر].النطاق.البداية.البايت مثل طبيعي;
                النهاية := (*الرموز)[ر].النطاق.النهاية.البايت مثل طبيعي;
                ر := ر + 1;
            };
            دع الأسطر: متغير طبيعي = 0;
            دع الفراغ: متغير طبيعي = 0;
            دع ف: متغير طبيعي = نهاية_السابق;
            طالما (ف < البداية) {
                إذا (بايت_المصدر(المصدر, ف) == 0x0A) {
                    الأسطر := الأسطر + 1;
                    الفراغ := 0;
                } وإلا {
                    الفراغ := الفراغ + 1;
                };
                ف := ف + 1;
            }
            دع اسم: منطقي = النوع == رمز.معرف()
                || (هل_كلمة_محجوزة(النوع) && النوع_السابق == رمز.نقطة());
            دع العنصر: عنصر_تنسيق = {
                الصنف: الصنف,
                النوع: النوع,
                البداية: البداية,
                النهاية: النهاية,
                الأسطر_قبله: الأسطر,
                الفراغ_قبله: الفراغ,
                اسم: اسم
            };
            ألحق(الناتج, العنصر);
            نهاية_السابق := النهاية;
            إذا (!خذ_تافهة) { النوع_السابق := النوع; };
        };
    }
    أرجع الناتج;
}

// ---- token classes of the spacing policy ----
// These are layout decisions over token kinds (where a space goes), not a
// second lexical classification: token_registry.sn owns what each kind is.

// Type and value keywords: a token of one of these kinds ends an operand, and
// `طبيعي(` is a conversion call.
عرف كلمة_قيمة(النوع: رمز): منطقي {
    طابق النوع مع
    | رمز.أي_نوع -> { أرجع صواب; }
    | رمز.منطقي -> { أرجع صواب; }
    | رمز.نص -> { أرجع صواب; }
    | رمز.حرف -> { أرجع صواب; }
    | رمز.عدد -> { أرجع صواب; }
    | رمز.طبيعي -> { أرجع صواب; }
    | رمز.عدد_عائم -> { أرجع صواب; }
    | رمز.فراغ -> { أرجع صواب; }
    | رمز.ص8 -> { أرجع صواب; }
    | رمز.ص16 -> { أرجع صواب; }
    | رمز.ص32 -> { أرجع صواب; }
    | رمز.ص64 -> { أرجع صواب; }
    | رمز.ط8 -> { أرجع صواب; }
    | رمز.ط16 -> { أرجع صواب; }
    | رمز.ط32 -> { أرجع صواب; }
    | رمز.ط64 -> { أرجع صواب; }
    | رمز.ع32 -> { أرجع صواب; }
    | رمز.ع64 -> { أرجع صواب; }
    | رمز.حرفي_منطقي -> { أرجع صواب; }
    | رمز.غير_معرف -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف ينهي_معاملا(العنصر: &عنصر_تنسيق): منطقي {
    دع النوع: رمز = (*العنصر).النوع;
    إذا ((*العنصر).اسم || كلمة_قيمة(النوع)) { أرجع صواب; };
    أرجع النوع == رمز.حرفي_عدد_صحيح() || النوع == رمز.حرفي_عدد_عشري()
        || النوع == رمز.حرفي_نص() || النوع == رمز.حرفي_حرف()
        || النوع == رمز.شرطة_سفلية_مرقمة() || النوع == رمز.شرطة_سفلية()
        || النوع == رمز.قوس_يمين() || النوع == رمز.قوس_مربع_يمين()
        || النوع == رمز.استفهام();
}

// What may stand right before the `(` of a call.
عرف مستدعى(العنصر: &عنصر_تنسيق): منطقي {
    دع النوع: رمز = (*العنصر).النوع;
    إذا ((*العنصر).اسم || كلمة_قيمة(النوع)) { أرجع صواب; };
    أرجع النوع == رمز.نوع_دالة() || النوع == رمز.صندوق() || النوع == رمز.تجميع()
        || النوع == رمز.وقت_الترجمة() || النوع == رمز.شريحة()
        || النوع == رمز.قوس_يمين() || النوع == رمز.قوس_مربع_يمين()
        || النوع == رمز.علامة_سمة();
}

عرف فاتح(النوع: رمز): منطقي {
    أرجع النوع == رمز.قوس_يسار() || النوع == رمز.قوس_مربع_يسار() || النوع == رمز.معقوف_يسار();
}

عرف غالق(النوع: رمز): منطقي {
    أرجع النوع == رمز.قوس_يمين() || النوع == رمز.قوس_مربع_يمين() || النوع == رمز.معقوف_يمين();
}

عرف بادئة_محتملة(النوع: رمز): منطقي {
    أرجع النوع == رمز.طرح() || النوع == رمز.نجمة() || النوع == رمز.و_بتي();
}

// `<`, `>`, `>>` and `>>>` bracket type arguments or compare and shift; the
// tokens alone do not tell which, so the author's spacing stays.
عرف زاوية_ملتبسة(النوع: رمز): منطقي {
    أرجع النوع == رمز.أصغر() || النوع == رمز.أكبر()
        || النوع == رمز.إزاحة_يمنى() || النوع == رمز.إزاحة_حسابية_يمنى();
}

// The next token after the element at الفهرس, or none.
عرف فهرس_الرمز_التالي(العناصر: &متجه عنصر_تنسيق, الفهرس: طبيعي): اختياري طبيعي {
    دع ف: متغير طبيعي = الفهرس + 1;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        إذا ((*العناصر)[ف].الصنف == صنف_عنصر_تنسيق.رمز_عنصر()) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A `<` or `>` before a number, `-` or `!` compares.
عرف مقارنة_مؤكدة(العناصر: &متجه عنصر_تنسيق, الفهرس: طبيعي): منطقي {
    دع النوع: رمز = (*العناصر)[الفهرس].النوع;
    إذا (النوع != رمز.أصغر() && النوع != رمز.أكبر()) { أرجع خطأ; };
    طابق فهرس_الرمز_التالي(العناصر, الفهرس) مع
    | اختياري.موجود(ت) -> {
        دع التالي: رمز = (*العناصر)[ت].النوع;
        أرجع التالي == رمز.حرفي_عدد_صحيح() || التالي == رمز.حرفي_عدد_عشري()
            || التالي == رمز.طرح() || التالي == رمز.نفي();
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Spaces (0 or 1) between the tokens أ and ب on one line. السابق is the token
// before أ, if any.
عرف مسافة_بين(
    العناصر: &متجه عنصر_تنسيق,
    السابق: اختياري طبيعي,
    أ: طبيعي,
    ب: طبيعي
): طبيعي {
    دع الأول: عنصر_تنسيق = (*العناصر)[أ];
    دع الثاني: عنصر_تنسيق = (*العناصر)[ب];
    دع يسار: رمز = الأول.النوع;
    دع يمين: رمز = الثاني.النوع;
    إذا (يمين == رمز.فاصلة() || يمين == رمز.فاصلة_منقوطة() || يمين == رمز.قوس_يمين()
        || يمين == رمز.قوس_مربع_يمين() || يمين == رمز.نقطة() || يمين == رمز.نقطتان()
        || يمين == رمز.استفهام()) {
        أرجع 0;
    };
    إذا (يسار == رمز.قوس_يسار() || يسار == رمز.قوس_مربع_يسار() || يسار == رمز.نقطة()
        || يسار == رمز.علامة_سمة() || يسار == رمز.نفي() || يسار == رمز.متمم()) {
        أرجع 0;
    };
    إذا (يسار == رمز.فاصلة() || يسار == رمز.فاصلة_منقوطة() || يسار == رمز.نقطتان()) {
        أرجع 1;
    };
    إذا (يسار == رمز.معقوف_يسار() || يمين == رمز.معقوف_يسار()
        || يسار == رمز.معقوف_يمين() || يمين == رمز.معقوف_يمين()) {
        أرجع 1;
    };
    إذا (بادئة_محتملة(يسار)) {
        دع بعد_معامل: متغير منطقي = خطأ;
        طابق السابق مع
        | اختياري.موجود(س) -> { بعد_معامل := ينهي_معاملا(&(*العناصر)[س]); }
        | اختياري.لا_شيء -> { };
        إذا (!بعد_معامل) { أرجع 0; };
        // Written as a prefix after an operand (a type such as `متجه *ط8`).
        إذا (الأول.الأسطر_قبله == 0 && الأول.الفراغ_قبله > 0 && الثاني.الفراغ_قبله == 0) {
            أرجع 0;
        };
    };
    إذا (بادئة_محتملة(يمين) && الثاني.الفراغ_قبله > 0) {
        طابق فهرس_الرمز_التالي(العناصر, ب) مع
        | اختياري.موجود(ت) -> {
            إذا ((*العناصر)[ت].الأسطر_قبله == 0 && (*العناصر)[ت].الفراغ_قبله == 0) { أرجع 1; };
        }
        | اختياري.لا_شيء -> { };
    };
    إذا (مقارنة_مؤكدة(العناصر, أ) || مقارنة_مؤكدة(العناصر, ب)) { أرجع 1; };
    إذا (زاوية_ملتبسة(يسار) || زاوية_ملتبسة(يمين)) {
        إذا (الثاني.الفراغ_قبله > 0) { أرجع 1; };
        أرجع 0;
    };
    إذا (يمين == رمز.قوس_يسار()) {
        إذا (مستدعى(&الأول)) { أرجع 0; };
        أرجع 1;
    };
    إذا (يمين == رمز.قوس_مربع_يسار()) {
        إذا (ينهي_معاملا(&الأول)) { أرجع 0; };
        أرجع 1;
    };
    أرجع 1;
}

// ---- module declarations ----

// A module declaration of a folder's root file, `module io { ar: دخ };` /
// `وحدة io { ar: دخ };`: at the top level, the keyword `module` / `وحدة`
// starting a declaration, then a name and `{`. Its layout is one line per
// declaration: the declaration starts its own line, its tokens are joined on
// that line (single spaces, as everywhere: `{ ar: دخ, fr: entree_sortie }`),
// and what follows its `;` starts a new line. A comment inside it keeps its
// line.
عرف بداية_تصريح_وحدة(المصدر: &مصدر, العناصر: &متجه عنصر_تنسيق, الفهرس: طبيعي): منطقي {
    دع العنصر: عنصر_تنسيق = (*العناصر)[الفهرس];
    // `module` / `وحدة` is a reserved word (token تصريح_وحدة).
    إذا (العنصر.النوع != رمز.تصريح_وحدة()) { أرجع خطأ; };
    طابق فهرس_الرمز_التالي(العناصر, الفهرس) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الاسم) -> {
        إذا ((*العناصر)[الاسم].النوع != رمز.معرف()) { أرجع خطأ; };
        طابق فهرس_الرمز_التالي(العناصر, الاسم) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الفاتح) -> { أرجع (*العناصر)[الفاتح].النوع == رمز.معقوف_يسار(); };
    };
}

// ---- indentation ----

// An open bracket and the indentation of the lines inside it. حالة_المطابقة
// follows the statement being read directly in it: 0 none, 1 after `طابق`,
// 2 after its `مع` (the match arms).
نوع إطار_تنسيق = {
    الفاتح: رمز,
    المحتوى: طبيعي,
    حالة_المطابقة: طبيعي
};

نوع حالة_ترتيب = {
    الأطر: متجه إطار_تنسيق,
    // The last token placed, and the one before it.
    الأخير: اختياري طبيعي,
    قبل_الأخير: اختياري طبيعي,
    // The first token of the current line and of the line before it.
    أول_السطر: اختياري طبيعي,
    أول_السطر_السابق: اختياري طبيعي,
    مسافة_السطر: طبيعي
};

عرف إطار_معقوف(الإطار: &إطار_تنسيق): منطقي {
    أرجع (*الإطار).الفاتح == رمز.معقوف_يسار();
}

// The indentation level of a line whose first token is at الفهرس.
عرف مسافة_سطر_رمز(
    العناصر: &متجه عنصر_تنسيق,
    الحالة: &حالة_ترتيب,
    الفهرس: طبيعي
): طبيعي {
    دع عدد_الأطر: طبيعي = الطول((*الحالة).الأطر) مثل طبيعي;
    دع الإطار: إطار_تنسيق = (*الحالة).الأطر[عدد_الأطر - 1];
    دع النوع: رمز = (*العناصر)[الفهرس].النوع;
    إذا (غالق(النوع) && عدد_الأطر > 1) { أرجع الإطار.المحتوى - 1; };
    دع الأساس: طبيعي = الإطار.المحتوى;
    إذا (!إطار_معقوف(&الإطار)) { أرجع الأساس; };
    طابق (*الحالة).الأخير مع
    | اختياري.لا_شيء -> { أرجع الأساس; }
    | اختياري.موجود(أ) -> {
        دع الأخير: رمز = (*العناصر)[أ].النوع;
        إذا (الأخير == رمز.فاصلة_منقوطة() || الأخير == رمز.معقوف_يسار() || الأخير == رمز.معقوف_يمين()) {
            أرجع الأساس;
        };
        إذا (الأخير == رمز.فاصلة() && عدد_الأطر > 1) { أرجع الأساس; };
    };
    طابق (*الحالة).أول_السطر_السابق مع
    | اختياري.موجود(س) -> {
        إذا ((*العناصر)[س].النوع == رمز.علامة_سمة()) { أرجع الأساس; };
    }
    | اختياري.لا_شيء -> { };
    إذا (النوع == رمز.فاصلة_منقوطة()) { أرجع الأساس; };
    إذا (النوع == رمز.أو_بتي() && الإطار.حالة_المطابقة == 2) { أرجع الأساس; };
    أرجع الأساس + 1;
}

// After placing the token at الفهرس: brackets, and the match state.
عرف تقدم_بعد_رمز(
    العناصر: &متجه عنصر_تنسيق,
    الحالة: &متغير حالة_ترتيب,
    الفهرس: طبيعي
): فراغ {
    دع النوع: رمز = (*العناصر)[الفهرس].النوع;
    دع عدد_الأطر: طبيعي = الطول((*الحالة).الأطر) مثل طبيعي;
    دع الأعلى: طبيعي = عدد_الأطر - 1;
    إذا (فاتح(النوع)) {
        دع المحتوى: متغير طبيعي = (*الحالة).مسافة_السطر + 1;
        إذا (النوع == رمز.معقوف_يسار() && إطار_معقوف(&(*الحالة).الأطر[الأعلى])) {
            // A block or record opened in a block: one level inside its
            // statement, even from a continuation line.
            المحتوى := (*الحالة).الأطر[الأعلى].المحتوى + 1;
        };
        دع الإطار: إطار_تنسيق = { الفاتح: النوع, المحتوى: المحتوى, حالة_المطابقة: 0 };
        ألحق((*الحالة).الأطر, الإطار);
    } وإلا إذا (غالق(النوع)) {
        إذا (عدد_الأطر > 1) {
            دع المغلق: اختياري إطار_تنسيق = أزل_الأخير((*الحالة).الأطر);
        };
    } وإلا إذا (النوع == رمز.فاصلة_منقوطة()) {
        (*الحالة).الأطر[الأعلى].حالة_المطابقة := 0;
    } وإلا إذا ((النوع == رمز.طابق() || النوع == رمز.مع()) && !(*العناصر)[الفهرس].اسم) {
        دع بعد_عمود: متغير منطقي = خطأ;
        طابق (*الحالة).الأخير مع
        | اختياري.موجود(أ) -> { بعد_عمود := (*العناصر)[أ].النوع == رمز.أو_بتي(); }
        | اختياري.لا_شيء -> { };
        إذا (!بعد_عمود) {
            دع الحالية: طبيعي = (*الحالة).الأطر[الأعلى].حالة_المطابقة;
            إذا (النوع == رمز.طابق() && الحالية == 0) {
                (*الحالة).الأطر[الأعلى].حالة_المطابقة := 1;
            };
            إذا (النوع == رمز.مع() && الحالية == 1) {
                (*الحالة).الأطر[الأعلى].حالة_المطابقة := 2;
            };
        };
    };
    (*الحالة).قبل_الأخير := (*الحالة).الأخير;
    (*الحالة).الأخير := اختياري.موجود(الفهرس);
}

عرف اكتب_مسافات(الناتج: &متغير متجه ط8, العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(*الناتج, 0x20 مثل ط8);
        ف := ف + 1;
    }
}

عرف اكتب_عنصرا(
    الناتج: &متغير متجه ط8,
    المواضع: &متغير متجه طبيعي,
    المصدر: &مصدر,
    العنصر: &عنصر_تنسيق
): فراغ {
    ألحق(*المواضع, الطول(*الناتج) مثل طبيعي);
    ألحق_من(*الناتج, &(*المصدر).المحتوى, (*العنصر).البداية, (*العنصر).النهاية - (*العنصر).البداية);
}

// The canonical layout of the elements of المصدر (عناصر_مصدر).
عام عرف رتب_عناصر(المصدر: &مصدر, العناصر: &متجه عنصر_تنسيق): ترتيب_مصدر {
    دع الناتج: متغير متجه ط8 = [];
    احجز_سعة(الناتج, (*المصدر).الطول + 64);
    دع المواضع: متغير متجه طبيعي = [];
    دع الأطر: متجه إطار_تنسيق = [];
    دع الحالة: متغير حالة_ترتيب = {
        الأطر: الأطر,
        الأخير: اختياري.لا_شيء(),
        قبل_الأخير: اختياري.لا_شيء(),
        أول_السطر: اختياري.لا_شيء(),
        أول_السطر_السابق: اختياري.لا_شيء(),
        مسافة_السطر: 0
    };
    دع الأعلى: إطار_تنسيق = { الفاتح: رمز.معقوف_يسار(), المحتوى: 0, حالة_المطابقة: 0 };
    ألحق(الحالة.الأطر, الأعلى);
    دع العدد: طبيعي = الطول(*العناصر) مثل طبيعي;
    // Line breaks carried from a mark moved to the end of the line before it.
    دع أسطر_محمولة: متغير طبيعي = 0;
    // The previous element was a comment: the next starts a new line.
    دع بعد_تعليق: متغير منطقي = خطأ;
    // Marks waiting to be written right before the next element.
    دع علامات_معلقة: متغير متجه طبيعي = [];
    // Inside a module declaration, and right after one (بداية_تصريح_وحدة).
    دع في_تصريح_وحدة: متغير منطقي = خطأ;
    دع بعد_تصريح_وحدة: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع العنصر: عنصر_تنسيق = (*العناصر)[ف];
        دع الأسطر: متغير طبيعي = العنصر.الأسطر_قبله + أسطر_محمولة;
        إذا (العنصر.الصنف == صنف_عنصر_تنسيق.علامة_عنصر()) {
            // A mark stays with the element that follows it on its line, or
            // else at the end of the line before it.
            دع يليه_على_سطره: منطقي = ف + 1 < العدد && (*العناصر)[ف + 1].الأسطر_قبله == 0;
            إذا (يليه_على_سطره) {
                ألحق(علامات_معلقة, ف);
            } وإلا {
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(علامات_معلقة) مثل طبيعي)) {
                    اكتب_عنصرا(&متغير الناتج, &متغير المواضع, المصدر, &(*العناصر)[علامات_معلقة[م]]);
                    م := م + 1;
                }
                دع لا_علامات: متجه طبيعي = [];
                علامات_معلقة := لا_علامات;
                اكتب_عنصرا(&متغير الناتج, &متغير المواضع, المصدر, &العنصر);
            };
            أسطر_محمولة := الأسطر;
        } وإلا {
            أسطر_محمولة := 0;
            دع رمز_هنا: منطقي = العنصر.الصنف == صنف_عنصر_تنسيق.رمز_عنصر();
            إذا (بعد_تصريح_وحدة) {
                // A comment after the `;` stays on its line; anything else
                // starts the next one.
                إذا (رمز_هنا && الأسطر == 0) { الأسطر := 1; };
                بعد_تصريح_وحدة := خطأ;
            };
            إذا (رمز_هنا && في_تصريح_وحدة && !بعد_تعليق) { الأسطر := 0; };
            إذا (رمز_هنا && !في_تصريح_وحدة && الطول(الحالة.الأطر) == 1) {
                دع بداية_عبارة: متغير منطقي = صواب;
                طابق الحالة.الأخير مع
                | اختياري.موجود(أ) -> {
                    دع الأخير: رمز = (*العناصر)[أ].النوع;
                    بداية_عبارة := الأخير == رمز.فاصلة_منقوطة() || الأخير == رمز.معقوف_يمين();
                }
                | اختياري.لا_شيء -> { };
                إذا (بداية_عبارة && بداية_تصريح_وحدة(المصدر, العناصر, ف)) {
                    في_تصريح_وحدة := صواب;
                    إذا (الأسطر == 0) { الأسطر := 1; };
                };
            };
            إذا (بعد_تعليق && الأسطر == 0) { الأسطر := 1; };
            دع أول_الملف: منطقي = الطول(الناتج) == 0 && الطول(علامات_معلقة) == 0;
            إذا (أول_الملف) { الأسطر := 0; };
            إذا (الأسطر > 0) {
                ألحق(الناتج, 0x0A مثل ط8);
                إذا (الأسطر > 1) { ألحق(الناتج, 0x0A مثل ط8); };
            };
            دع بداية_سطر: منطقي = الأسطر > 0 || أول_الملف;
            إذا (العنصر.الصنف == صنف_عنصر_تنسيق.تعليق_عنصر()) {
                إذا (بداية_سطر) {
                    دع المسافة: متغير طبيعي = 0;
                    طابق فهرس_الرمز_التالي(العناصر, ف) مع
                    | اختياري.موجود(ت) -> {
                        إذا (غالق((*العناصر)[ت].النوع) && الطول(الحالة.الأطر) > 1) {
                            دع عدد_الأطر: طبيعي = الطول(الحالة.الأطر) مثل طبيعي;
                            المسافة := الحالة.الأطر[عدد_الأطر - 1].المحتوى;
                        } وإلا {
                            المسافة := مسافة_سطر_رمز(العناصر, &الحالة, ت);
                        };
                    }
                    | اختياري.لا_شيء -> {
                        دع عدد_الأطر: طبيعي = الطول(الحالة.الأطر) مثل طبيعي;
                        المسافة := الحالة.الأطر[عدد_الأطر - 1].المحتوى;
                    };
                    اكتب_مسافات(&متغير الناتج, المسافة * 4);
                } وإلا {
                    // A trailing comment keeps the spaces before it (aligned
                    // tables), at least one.
                    دع الفراغ: متغير طبيعي = العنصر.الفراغ_قبله;
                    إذا (الفراغ == 0) { الفراغ := 1; };
                    اكتب_مسافات(&متغير الناتج, الفراغ);
                };
                بعد_تعليق := صواب;
            } وإلا {
                إذا (بداية_سطر) {
                    دع المسافة: طبيعي = مسافة_سطر_رمز(العناصر, &الحالة, ف);
                    اكتب_مسافات(&متغير الناتج, المسافة * 4);
                    الحالة.مسافة_السطر := المسافة;
                    الحالة.أول_السطر_السابق := الحالة.أول_السطر;
                    الحالة.أول_السطر := اختياري.موجود(ف);
                } وإلا {
                    طابق الحالة.الأخير مع
                    | اختياري.موجود(أ) -> {
                        اكتب_مسافات(&متغير الناتج, مسافة_بين(العناصر, الحالة.قبل_الأخير, أ, ف));
                    }
                    | اختياري.لا_شيء -> { };
                };
                بعد_تعليق := خطأ;
            };
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(علامات_معلقة) مثل طبيعي)) {
                اكتب_عنصرا(&متغير الناتج, &متغير المواضع, المصدر, &(*العناصر)[علامات_معلقة[م]]);
                م := م + 1;
            }
            دع لا_علامات: متجه طبيعي = [];
            علامات_معلقة := لا_علامات;
            اكتب_عنصرا(&متغير الناتج, &متغير المواضع, المصدر, &العنصر);
            إذا (العنصر.الصنف == صنف_عنصر_تنسيق.رمز_عنصر()) {
                تقدم_بعد_رمز(العناصر, &متغير الحالة, ف);
                إذا (في_تصريح_وحدة && العنصر.النوع == رمز.فاصلة_منقوطة() && الطول(الحالة.الأطر) == 1) {
                    في_تصريح_وحدة := خطأ;
                    بعد_تصريح_وحدة := صواب;
                };
            };
        };
        ف := ف + 1;
    }
    إذا (الطول(الناتج) > 0) { ألحق(الناتج, 0x0A مثل ط8); };
    دع الترتيب: ترتيب_مصدر = { البايتات: الناتج, المواضع: المواضع };
    أرجع الترتيب;
}
