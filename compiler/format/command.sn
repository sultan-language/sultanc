// `sultanc fmt`: formats files in place, or standard input to standard
// output. The driver parses the command line into طلب_تنسيق and renders the
// diagnostics of the result; the formatting itself is format.sn.

// المسارات: files, directories (their `.sn` files, recursively) or `-` for
// standard input; no path means standard input. فحص_فقط (`--check`) writes
// nothing and reports each file the formatter would change.
عام نوع طلب_تنسيق = {
    المسارات: متجه نص,
    فحص_فقط: منطقي
};

عام نوع نتيجة_أمر_تنسيق =
    // Every input is formatted (and, without --check, written).
    | منسقة
    // --check: some inputs are not formatted; one diagnostic per input.
    | تحتاج_تنسيقا بنوع مجموعة_تشخيصات
    // An input could not be read, parsed or written. Inputs that failed are
    // left as they were.
    | فشلت بنوع مجموعة_تشخيصات
;

عرف تشخيص_بمسار(المعرف: معرف_تشخيص, المسار: &نص): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختياري.لا_شيء());
    دع أضف_مسار: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), انسخ_نص(المسار));
    أرجع التشخيص;
}

عرف أصدر_تشخيص_مسار(المجموعة: &متغير مجموعة_تشخيصات, المعرف: معرف_تشخيص, المسار: &نص): فراغ {
    دع التشخيص: تشخيص = تشخيص_بمسار(المعرف, المسار);
    أصدر_تشخيصا(المجموعة, &التشخيص);
}

عرف أصدر_فشل_كتابة(المجموعة: &متغير مجموعة_تشخيصات, المسار: &نص): فراغ {
    دع التشخيص: متغير تشخيص = تشخيص_بمسار(معرف_تشخيص.فشل_كتابة_مخرج_مترجم(), المسار);
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «output-write»);
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إخراج_كتابة_فشل());
    أصدر_تشخيصا(المجموعة, &التشخيص);
}

// SULTANC-FMT-UNFORMATTED at the first place the formatter would change.
عرف أصدر_غير_منسق(
    المجموعة: &متغير مجموعة_تشخيصات,
    المسار: &نص,
    النص: &نص,
    الأول: &تعديل_تنسيق
): فراغ {
    دع الخريطة: متغير خريطة_مصادر = خريطة_مصادر_جديدة();
    دع المعرف: طبيعي = أضف_مصدر_إلى_خريطة(&متغير الخريطة, انسخ_نص(المسار), انسخ_نص(النص));
    دع البداية: موضع = { المصدر: المعرف مثل ط32, البايت: (*الأول).البداية مثل ط32 };
    دع النهاية: موضع = { المصدر: المعرف مثل ط32, البايت: (*الأول).النهاية مثل ط32 };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.ملف_غير_منسق(), مصدر_تشخيص_من_نطاق_محمل(&الخريطة, نطاق_بين(البداية, النهاية))
    );
    دع أضف_مسار: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), انسخ_نص(المسار));
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_المساعدة: منطقي = أضف_مساعدة(&متغير التشخيص, مفتاح_صياغة.مساعدة_نسق_الملف(), بلا_حجج);
    أصدر_تشخيصا(المجموعة, &التشخيص);
}

عرف طبق_التعديلات(النص: &نص, التعديلات: &متجه تعديل_تنسيق): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    احجز_سعة(الناتج, الطول(*النص) مثل طبيعي);
    دع الموضع: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التعديلات) مثل طبيعي)) {
        دع التعديل: &تعديل_تنسيق = &(*التعديلات)[ف];
        ألحق_من(الناتج, النص, الموضع, (*التعديل).البداية - الموضع);
        ألحق_من(الناتج, &(*التعديل).النص, 0, الطول((*التعديل).النص) مثل طبيعي);
        الموضع := (*التعديل).النهاية;
        ف := ف + 1;
    }
    ألحق_من(الناتج, النص, الموضع, (الطول(*النص) مثل طبيعي) - الموضع);
    أرجع الناتج;
}

// Formats one input. Returns خطأ when it failed or, with --check, is not
// formatted; the reason is in المجموعة.
عرف نسق_مدخلا(
    المسار: &نص,
    النص: &نص,
    من_الدخل: منطقي,
    فحص_فقط: منطقي,
    المجموعة: &متغير مجموعة_تشخيصات,
    غير_منسق: &متغير منطقي
): منطقي {
    طابق تعديلات_تنسيق_نص(المسار, النص) مع
    | نتيجة_تعديلات_تنسيق.مرفوضة(التشخيصات) -> {
        ادمج_مجموعة_تشخيصات(المجموعة, &التشخيصات);
        أرجع خطأ;
    }
    | نتيجة_تعديلات_تنسيق.تعديلات(التعديلات) -> {
        دع منسق_مسبقا: منطقي = الطول(التعديلات) == 0;
        إذا (فحص_فقط) {
            إذا (!منسق_مسبقا) {
                أصدر_غير_منسق(المجموعة, المسار, النص, &التعديلات[0]);
                *غير_منسق := صواب;
            };
            أرجع صواب;
        };
        دع الناتج: متجه ط8 = طبق_التعديلات(النص, &التعديلات);
        إذا (من_الدخل) {
            طابق اكتب_بايتات_خرج(&الناتج) مع
            | نتيجة.نجح(_) -> { أرجع صواب; }
            | نتيجة.خطأ(_) -> {
                أصدر_فشل_كتابة(المجموعة, المسار);
                أرجع خطأ;
            };
        };
        إذا (منسق_مسبقا) { أرجع صواب; };
        // Write beside the file, then rename over it: an interrupted write
        // never leaves a partial source.
        دع المؤقت: نص = ضم_نصين_تنسيق(المسار, «.fmt-tmp»);
        طابق اكتب_البايتات(&المؤقت, &الناتج) مع
        | نتيجة.خطأ(_) -> {
            دع تجاهل: نتيجة عدد, عدد = أزل_ملفا(&المؤقت);
            أصدر_فشل_كتابة(المجموعة, المسار);
            أرجع خطأ;
        }
        | نتيجة.نجح(_) -> { };
        طابق أعد_تسمية(&المؤقت, المسار) مع
        | نتيجة.خطأ(_) -> {
            دع تجاهل: نتيجة عدد, عدد = أزل_ملفا(&المؤقت);
            أصدر_فشل_كتابة(المجموعة, المسار);
            أرجع خطأ;
        }
        | نتيجة.نجح(_) -> { أرجع صواب; };
    };
}

عرف ضم_نصين_تنسيق(الأول: &نص, الثاني: نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    ألحق_من(البايتات, الأول, 0, الطول(*الأول) مثل طبيعي);
    ألحق_بايتات_نص(&متغير البايتات, الثاني);
    أرجع البايتات مثل نص;
}

عرف ينتهي_بلاحقة_سن(المسار: &نص): منطقي {
    دع العدد: طبيعي = الطول(*المسار) مثل طبيعي;
    إذا (العدد < 3) { أرجع خطأ; };
    أرجع (*المسار)[العدد - 3] == 0x2E && (*المسار)[العدد - 2] == 0x73 && (*المسار)[العدد - 1] == 0x6E;
}

عرف اقرأ_الدخل_كله(): اختياري نص {
    دع البايتات: متغير متجه ط8 = [];
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق اقرأ_حتى(65536) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(المقروء) -> {
            إذا (المقروء.نهاية_المدخل) {
                مستمر := خطأ;
            } وإلا {
                ألحق_من(البايتات, &المقروء.البايتات, 0, الطول(المقروء.البايتات) مثل طبيعي);
            };
        };
    }
    أرجع اختياري.موجود(البايتات مثل نص);
}

// The files named by المسار: itself, or the `.sn` files under a directory in
// path order. A missing path is reported and yields none.
عرف ملفات_مسار(المسار: &نص, المجموعة: &متغير مجموعة_تشخيصات): متجه نص {
    دع الناتج: متغير متجه نص = [];
    طابق حاول_نوع_المسار(المسار) مع
    | نتيجة.خطأ(_) -> {
        أصدر_تشخيص_مسار(المجموعة, معرف_تشخيص.ملف_إدخال_مفقود(), المسار);
    }
    | نتيجة.نجح(نوع_مسار.دليل) -> {
        طابق اجتز_الشجرة(المسار) مع
        | نتيجة.خطأ(_) -> {
            أصدر_تشخيص_مسار(المجموعة, معرف_تشخيص.وحدة_مصدر_غير_مقروءة(), المسار);
        }
        | نتيجة.نجح(المداخل) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المداخل) مثل طبيعي)) {
                إذا (المداخل[ف].النوع == نوع_مدخل_دليل.ملف() && ينتهي_بلاحقة_سن(&المداخل[ف].المسار)) {
                    ألحق(الناتج, انسخ_نص(&المداخل[ف].المسار));
                };
                ف := ف + 1;
            }
            رتب_نصوص(&متغير الناتج);
        };
    }
    | نتيجة.نجح(_) -> {
        ألحق(الناتج, انسخ_نص(المسار));
    };
    أرجع الناتج;
}

عام عرف نفذ_أمر_التنسيق(الطلب: &طلب_تنسيق): نتيجة_أمر_تنسيق {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع فشل: متغير منطقي = خطأ;
    دع غير_منسق: متغير منطقي = خطأ;
    دع المسارات: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الطلب).المسارات) مثل طبيعي)) {
        ألحق(المسارات, انسخ_نص(&(*الطلب).المسارات[ف]));
        ف := ف + 1;
    }
    إذا (الطول(المسارات) == 0) { ألحق(المسارات, «-»); };
    ف := 0;
    طالما (ف < (الطول(المسارات) مثل طبيعي)) {
        دع المسار: نص = انسخ_نص(&المسارات[ف]);
        دع الشرطة: نص = «-»;
        إذا (نصان_متساويان(&المسار, &الشرطة)) {
            دع اسم_الدخل: نص = «<stdin>»;
            طابق اقرأ_الدخل_كله() مع
            | اختياري.لا_شيء -> {
                أصدر_تشخيص_مسار(&متغير المجموعة, معرف_تشخيص.وحدة_مصدر_غير_مقروءة(), &اسم_الدخل);
                فشل := صواب;
            }
            | اختياري.موجود(النص) -> {
                إذا (!نسق_مدخلا(&اسم_الدخل, &النص, صواب, (*الطلب).فحص_فقط, &متغير المجموعة, &متغير غير_منسق)) {
                    فشل := صواب;
                };
            };
        } وإلا {
            دع عدد_قبل: طبيعي = الطول(المجموعة.التشخيصات) مثل طبيعي;
            دع الملفات: متجه نص = ملفات_مسار(&المسار, &متغير المجموعة);
            إذا ((الطول(المجموعة.التشخيصات) مثل طبيعي) > عدد_قبل) { فشل := صواب; };
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(الملفات) مثل طبيعي)) {
                دع الملف: &نص = &الملفات[م];
                طابق اقرأ_الملف(الملف) مع
                | نتيجة.خطأ(_) -> {
                    أصدر_تشخيص_مسار(&متغير المجموعة, معرف_تشخيص.وحدة_مصدر_غير_مقروءة(), الملف);
                    فشل := صواب;
                }
                | نتيجة.نجح(النص) -> {
                    إذا (!نسق_مدخلا(الملف, &النص, خطأ, (*الطلب).فحص_فقط, &متغير المجموعة, &متغير غير_منسق)) {
                        فشل := صواب;
                    };
                };
                م := م + 1;
            }
        };
        ف := ف + 1;
    }
    إذا (فشل) { أرجع نتيجة_أمر_تنسيق.فشلت(المجموعة); };
    إذا (غير_منسق) { أرجع نتيجة_أمر_تنسيق.تحتاج_تنسيقا(المجموعة); };
    أرجع نتيجة_أمر_تنسيق.منسقة();
}
