// The canonical SultanC formatter: source text in, formatted text (or the
// edits that make it) out. The compiler's `fmt` command and the language
// server both call it. A source that does not lex or parse is rejected with
// the diagnostics `check` reports for it, and nothing is produced. Every
// result passes the self-check of verify.sn first.

عام نوع نتيجة_تنسيق =
    | منسق بنوع نص
    | مرفوض بنوع مجموعة_تشخيصات
;

عام نوع نتيجة_تعديلات_تنسيق =
    | تعديلات بنوع متجه تعديل_تنسيق
    | مرفوضة بنوع مجموعة_تشخيصات
;

نوع تنسيق_مكتمل = {
    الخريطة: خريطة_مصادر,
    العناصر: متجه عنصر_تنسيق,
    الترتيب: ترتيب_مصدر
};

نوع نتيجة_تنسيق_داخلية =
    | مكتمل بنوع تنسيق_مكتمل
    | رفض بنوع مجموعة_تشخيصات
;

عرف تشخيصات_خلل_المنسق(المسار: &نص): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.فشل_مترجم_داخلي(), اختياري.لا_شيء());
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «formatter»);
    دع أضف_مسار: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), انسخ_نص(المسار));
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_مساعدة_خلل: منطقي = أضف_مساعدة(
        &متغير التشخيص, مفتاح_صياغة.مساعدة_أبلغ_عن_خلل_المترجم(), بلا_حجج
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// The target a source is parsed for. A top-level platform guard
// (`إذا (نظام == …) { … }`) needs one to parse; both of its arms are parsed
// whatever it selects, so any registered target checks the same syntax. The
// host's, else the first registered.
عرف هدف_التحليل(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.محلول(الواصف) -> { أرجع اختياري.موجود(الواصف); }
    | نتيجة_حل_هدف.غير_مسجل -> { };
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    إذا (الطول(الأهداف) == 0) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_مملوكا_واصف_هدف(&الأهداف[0]));
}

عرف نسق_داخليا(المسار: &نص, النص: &نص): نتيجة_تنسيق_داخلية {
    دع الخريطة: متغير خريطة_مصادر = خريطة_مصادر_جديدة();
    دع المعرف: طبيعي = أضف_مصدر_إلى_خريطة(&متغير الخريطة, انسخ_نص(المسار), انسخ_نص(النص));
    دع المصدر: مصدر = انسخ_مملوكا_مصدر(&الخريطة.المصادر[المعرف]);
    طابق حلل_معجميا_مع_التوافه(&المصدر) مع
    | نتيجة_تحليل_معجمي_بتوافه.مرفوض(الخطأ) -> {
        أرجع نتيجة_تنسيق_داخلية.رفض(
            تشخيصات_رفض_مصدر_واجهة(خطأ_واجهة_وحدة.معجم(الخطأ), &الخريطة)
        );
    }
    | نتيجة_تحليل_معجمي_بتوافه.سلسلة(السلسلة) -> {
        دع الهدف: اختياري واصف_هدف = هدف_التحليل();
        طابق حلل_الرموز_لهدف(&المصدر, &السلسلة.الرموز, &الهدف) مع
        | نتيجة_تحليل.مرفوض(الخطأ) -> {
            أرجع نتيجة_تنسيق_داخلية.رفض(
                تشخيصات_رفض_مصدر_واجهة(خطأ_واجهة_وحدة.نحو(الخطأ), &الخريطة)
            );
        }
        | نتيجة_تحليل.خلل_داخلي -> {
            أرجع نتيجة_تنسيق_داخلية.رفض(
                تشخيصات_رفض_مصدر_واجهة(خطأ_واجهة_وحدة.خلل_نحوي_داخلي(), &الخريطة)
            );
        }
        | نتيجة_تحليل.شجرة(_) -> { };
        دع العناصر: متجه عنصر_تنسيق = عناصر_مصدر(&المصدر, &السلسلة.الرموز, &السلسلة.التوافه);
        دع الترتيب: ترتيب_مصدر = رتب_عناصر(&المصدر, &العناصر);
        إذا (!تحقق_من_ناتج_التنسيق(&المصدر, &العناصر, &الترتيب.البايتات, &الهدف)) {
            أرجع نتيجة_تنسيق_داخلية.رفض(تشخيصات_خلل_المنسق(المسار));
        };
        دع المكتمل: تنسيق_مكتمل = {
            الخريطة: الخريطة,
            العناصر: العناصر,
            الترتيب: الترتيب
        };
        أرجع نتيجة_تنسيق_داخلية.مكتمل(المكتمل);
    };
}

// The formatted text of النص. المسار names the source in diagnostics.
عام عرف نسق_نص_مصدر(المسار: &نص, النص: &نص): نتيجة_تنسيق {
    طابق نسق_داخليا(المسار, النص) مع
    | نتيجة_تنسيق_داخلية.رفض(التشخيصات) -> { أرجع نتيجة_تنسيق.مرفوض(التشخيصات); }
    | نتيجة_تنسيق_داخلية.مكتمل(المكتمل) -> {
        أرجع نتيجة_تنسيق.منسق(من_بايتات(&المكتمل.الترتيب.البايتات));
    };
}

عرف تعديلات_في_مدى(المسار: &نص, النص: &نص, بداية_المدى: طبيعي, نهاية_المدى: طبيعي): نتيجة_تعديلات_تنسيق {
    طابق نسق_داخليا(المسار, النص) مع
    | نتيجة_تنسيق_داخلية.رفض(التشخيصات) -> { أرجع نتيجة_تعديلات_تنسيق.مرفوضة(التشخيصات); }
    | نتيجة_تنسيق_داخلية.مكتمل(المكتمل) -> {
        دع التعديلات: متجه تعديل_تنسيق = تعديلات_ترتيب(
            &المكتمل.الخريطة.المصادر[0], &المكتمل.العناصر, &المكتمل.الترتيب, بداية_المدى, نهاية_المدى
        );
        أرجع نتيجة_تعديلات_تنسيق.تعديلات(التعديلات);
    };
}

// The edits that format النص: UTF-8 byte offsets into النص, in order and
// non-overlapping. No edit means the text is already formatted.
عام عرف تعديلات_تنسيق_نص(المسار: &نص, النص: &نص): نتيجة_تعديلات_تنسيق {
    أرجع تعديلات_في_مدى(المسار, النص, 0, الطول(*النص) مثل طبيعي);
}

// The edits of تعديلات_تنسيق_نص that touch the byte range [البداية, النهاية]
// of النص. The layout of a line depends on the whole file, so a range is
// formatted exactly as the whole file formats it.
عام عرف تعديلات_تنسيق_مدى(
    المسار: &نص,
    النص: &نص,
    البداية: طبيعي,
    النهاية: طبيعي
): نتيجة_تعديلات_تنسيق {
    أرجع تعديلات_في_مدى(المسار, النص, البداية, النهاية);
}
