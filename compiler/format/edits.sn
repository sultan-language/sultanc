استورد compiler.source.source_file;
استورد compiler.format.layout;

// Text edits from a source to its formatted text. The layout copies every
// element (token, comment, mark) unchanged and in order, so the two texts
// differ only in the whitespace between consecutive elements, before the
// first and after the last. Each such gap that changed is one edit: exact,
// non-overlapping and in source order.

// Replace the source bytes [البداية, النهاية) with النص. Offsets are UTF-8
// byte offsets into the source text.
عام نوع تعديل_تنسيق = {
    البداية: طبيعي,
    النهاية: طبيعي,
    النص: نص
};

عرف مدى_متساو(
    القديم: &نص,
    بداية_القديم: طبيعي,
    نهاية_القديم: طبيعي,
    الجديد: &متجه ط8,
    بداية_الجديد: طبيعي,
    نهاية_الجديد: طبيعي
): منطقي {
    إذا (نهاية_القديم - بداية_القديم != نهاية_الجديد - بداية_الجديد) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (بداية_القديم + ف < نهاية_القديم) {
        إذا ((*القديم)[بداية_القديم + ف] != (*الجديد)[بداية_الجديد + ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أضف_تعديل_فجوة(
    التعديلات: &متغير متجه تعديل_تنسيق,
    القديم: &نص,
    بداية_القديم: طبيعي,
    نهاية_القديم: طبيعي,
    الجديد: &متجه ط8,
    بداية_الجديد: طبيعي,
    نهاية_الجديد: طبيعي,
    بداية_المدى: طبيعي,
    نهاية_المدى: طبيعي
): فراغ {
    // Only gaps that touch the requested range [بداية_المدى, نهاية_المدى].
    إذا (نهاية_القديم < بداية_المدى || بداية_القديم > نهاية_المدى) { أرجع; };
    إذا (مدى_متساو(القديم, بداية_القديم, نهاية_القديم, الجديد, بداية_الجديد, نهاية_الجديد)) { أرجع; };
    دع البايتات: متغير متجه ط8 = [];
    ألحق_من(البايتات, الجديد, بداية_الجديد, نهاية_الجديد - بداية_الجديد);
    دع التعديل: تعديل_تنسيق = {
        البداية: بداية_القديم,
        النهاية: نهاية_القديم,
        النص: البايتات مثل نص
    };
    ألحق(*التعديلات, التعديل);
}

// The edits that turn المصدر into الترتيب, limited to the gaps that touch the
// byte range [بداية_المدى, نهاية_المدى] of the source.
عام عرف تعديلات_ترتيب(
    المصدر: &مصدر,
    العناصر: &متجه عنصر_تنسيق,
    الترتيب: &ترتيب_مصدر,
    بداية_المدى: طبيعي,
    نهاية_المدى: طبيعي
): متجه تعديل_تنسيق {
    دع الناتج: متغير متجه تعديل_تنسيق = [];
    دع القديم: &نص = &(*المصدر).المحتوى;
    دع الجديد: &متجه ط8 = &(*الترتيب).البايتات;
    دع طول_القديم: طبيعي = (*المصدر).الطول;
    دع طول_الجديد: طبيعي = الطول(*الجديد) مثل طبيعي;
    دع العدد: طبيعي = الطول(*العناصر) مثل طبيعي;
    دع نهاية_قديمة: متغير طبيعي = 0;
    دع نهاية_جديدة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع بداية_قديمة: طبيعي = (*العناصر)[ف].البداية;
        دع بداية_جديدة: طبيعي = (*الترتيب).المواضع[ف];
        أضف_تعديل_فجوة(
            &متغير الناتج, القديم, نهاية_قديمة, بداية_قديمة, الجديد, نهاية_جديدة, بداية_جديدة, بداية_المدى, نهاية_المدى
        );
        دع طول_العنصر: طبيعي = (*العناصر)[ف].النهاية - بداية_قديمة;
        نهاية_قديمة := بداية_قديمة + طول_العنصر;
        نهاية_جديدة := بداية_جديدة + طول_العنصر;
        ف := ف + 1;
    }
    أضف_تعديل_فجوة(
        &متغير الناتج, القديم, نهاية_قديمة, طول_القديم, الجديد, نهاية_جديدة, طول_الجديد, بداية_المدى, نهاية_المدى
    );
    أرجع الناتج;
}
