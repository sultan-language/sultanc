استورد compiler.source.source_file;
استورد compiler.format.layout;

// Text edits from a source to its formatted text. The layout copies every
// element (token, comment, mark) in order, unchanged but for a comma, which it
// spells in the source's language, so the two texts differ in the whitespace
// between consecutive elements, before the first and after the last, and in
// the commas. Each such gap or comma that changed is one edit: exact,
// non-overlapping and in source order.

// Replace the source bytes [البداية, النهاية) with النص. Offsets are UTF-8
// byte offsets into the source text.
عام نوع تعديل_تنسيق = {
    البداية: طبيعي,
    النهاية: طبيعي,
    النص: نص
};

عرف مدى_متساو(
    القديم: &نص,
    بداية_القديم: طبيعي,
    نهاية_القديم: طبيعي,
    الجديد: &متجه ط8,
    بداية_الجديد: طبيعي,
    نهاية_الجديد: طبيعي
): منطقي {
    إذا (نهاية_القديم - بداية_القديم != نهاية_الجديد - بداية_الجديد) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (بداية_القديم + ف < نهاية_القديم) {
        إذا ((*القديم)[بداية_القديم + ف] != (*الجديد)[بداية_الجديد + ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أضف_تعديل_فجوة(
    التعديلات: &متغير متجه تعديل_تنسيق,
    القديم: &نص,
    بداية_القديم: طبيعي,
    نهاية_القديم: طبيعي,
    الجديد: &متجه ط8,
    بداية_الجديد: طبيعي,
    نهاية_الجديد: طبيعي,
    بداية_المدى: طبيعي,
    نهاية_المدى: طبيعي
): فراغ {
    // Only gaps that touch the requested range [بداية_المدى, نهاية_المدى].
    إذا (نهاية_القديم < بداية_المدى || بداية_القديم > نهاية_المدى) { أرجع; };
    إذا (مدى_متساو(القديم, بداية_القديم, نهاية_القديم, الجديد, بداية_الجديد, نهاية_الجديد)) { أرجع; };
    ليكن البايتات: متغير متجه ط8 = [];
    ألحق_من(البايتات, الجديد, بداية_الجديد, نهاية_الجديد - بداية_الجديد);
    ليكن التعديل: تعديل_تنسيق = {
        البداية: بداية_القديم,
        النهاية: نهاية_القديم,
        النص: البايتات مثل نص
    };
    ألحق(*التعديلات, التعديل);
}

// The edits that turn المصدر into الترتيب, limited to the gaps that touch the
// byte range [بداية_المدى, نهاية_المدى] of the source.
عام عرف تعديلات_ترتيب(
    المصدر: &مصدر,
    العناصر: &متجه عنصر_تنسيق,
    الترتيب: &ترتيب_مصدر,
    بداية_المدى: طبيعي,
    نهاية_المدى: طبيعي
): متجه تعديل_تنسيق {
    ليكن الناتج: متغير متجه تعديل_تنسيق = [];
    ليكن القديم: &نص = &(*المصدر).المحتوى;
    ليكن الجديد: &متجه ط8 = &(*الترتيب).البايتات;
    ليكن طول_القديم: طبيعي = (*المصدر).الطول;
    ليكن طول_الجديد: طبيعي = الطول(*الجديد) مثل طبيعي;
    ليكن العدد: طبيعي = الطول(*العناصر) مثل طبيعي;
    ليكن نهاية_قديمة: متغير طبيعي = 0;
    ليكن نهاية_جديدة: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن بداية_قديمة: طبيعي = (*العناصر)[ف].البداية;
        ليكن بداية_جديدة: طبيعي = (*الترتيب).المواضع[ف];
        أضف_تعديل_فجوة(
            &متغير الناتج, القديم, نهاية_قديمة, بداية_قديمة, الجديد, نهاية_جديدة, بداية_جديدة, بداية_المدى, نهاية_المدى
        );
        نهاية_قديمة := (*العناصر)[ف].النهاية;
        نهاية_جديدة := (*الترتيب).النهايات[ف];
        // A comma spelled anew.
        أضف_تعديل_فجوة(
            &متغير الناتج, القديم, بداية_قديمة, نهاية_قديمة, الجديد, بداية_جديدة, نهاية_جديدة, بداية_المدى, نهاية_المدى
        );
        ف := ف + 1;
    }
    أضف_تعديل_فجوة(
        &متغير الناتج, القديم, نهاية_قديمة, طول_القديم, الجديد, نهاية_جديدة, طول_الجديد, بداية_المدى, نهاية_المدى
    );
    أرجع الناتج;
}
