            دع ت: منطقي = توقع_جسر(م, ك.ك_while, «while»);
            دع الشرط: طبيعي = شرط_ب_جسر(م, ش);
            دع ت2: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            أرجع ع_جديدة_جسر(ش, 5, الشرط + 1, الجسم + 1, 0, 0, 0, الرمز);
        };
        إذا (ي == ك.ك_for) {
            تقدم_جسر(م);
            دع ت: منطقي = توقع_جسر(م, ك.ك_lparen, «(»);
            افتح_نطاقا_جسر(م);
            دع البدء: متغير طبيعي = 0;
            إذا (بداية_تصريح_محلي_جسر(م)) {
                دع العناصر: متغير متجه طبيعي = [];
                حلل_تصريحا_محليا_ب_جسر(م, ش, &متغير العناصر);
                دع البداية: طبيعي = قائمة_جسر(ش, &العناصر);
                البدء := ع_جديدة_جسر(ش, 7, البداية, الطول(العناصر) مثل طبيعي, 0, 0, 0, الرمز) + 1;
            } وإلا {
                إذا (!عند_جسر(م, ك.ك_semi)) {
                    دع ق: طبيعي = حلل_تعبيرا_ب_جسر(م, ش);
                    البدء := ع_جديدة_جسر(ش, 1, ق + 1, 0, 0, 0, 0, الرمز) + 1;
                };
                دع ت2: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            };
            دع الشرط: متغير طبيعي = 0;
            إذا (!عند_جسر(م, ك.ك_semi)) { الشرط := قيمة_ت_جسر(م, ش, حلل_تعبيرا_ب_جسر(م, ش)) + 1; };
            دع ت3: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            دع الخطوة: متغير طبيعي = 0;
            إذا (!عند_جسر(م, ك.ك_rparen)) { الخطوة := حلل_تعبيرا_ب_جسر(م, ش) + 1; };
            دع ت4: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
            (*ش).عمق_الحلقات := (*ش).عمق_الحلقات + 1;
            دع الجسم: طبيعي = حلل_عبارة_ب_جسر(م, ش);
            (*ش).عمق_الحلقات := (*ش).عمق_الحلقات - 1;
            أغلق_نطاقا_جسر(م);
            أرجع ع_جديدة_جسر(ش, 6, الشرط, الجسم + 1, الخطوة, البدء, 0, الرمز);
        };
        إذا (ي == ك.ك_switch) {
            تقدم_جسر(م);
            دع القيمة_ت: طبيعي = شرط_ب_جسر(م, ش);
            إذا (!صحيح_ن_جسر(م, (*ش).التعابير[القيمة_ت].النوع)) {
                شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_قيمة_تبديل_غير_صحيحة());
            };
            دع المرقى: طبيعي = رقي_ت_جسر(م, ش, القيمة_ت);
            (*ش).عمق_التبديل := (*ش).عمق_التبديل + 1;
            دع الجسم: طبيعي = حلل_عبارة_ب_جسر(م, ش);
            (*ش).عمق_التبديل := (*ش).عمق_التبديل - 1;
            أرجع ع_جديدة_جسر(ش, 12, المرقى + 1, الجسم + 1, 0, 0, 0, الرمز);
        };
        إذا (ي == ك.ك_goto) {
            تقدم_جسر(م);
            إذا (اقبل_جسر(م, ك.ك_star)) {
                // A computed goto: أ is the address (a label's, `&&label`).
                دع الهدف: طبيعي = قيمة_ت_جسر(م, ش, حلل_تعبيرا_ب_جسر(م, ش));
                إذا (!مؤشر_ن_جسر(م, (*ش).التعابير[الهدف].النوع)) {
                    شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_قفز_محسوب_بلا_مؤشر());
                };
                دع ت: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
                (*ش).فيها_قفز := صواب;
                أرجع ع_جديدة_جسر(ش, 10, الهدف + 1, 0, 0, 0, 0, الرمز);
            };
            دع الاسم: طبيعي = رمز_م_جسر(م).المعرف;
            تقدم_جسر(م);
            دع ت: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            (*ش).فيها_قفز := صواب;
            دع اللافتة: طبيعي = لافتة_ب_جسر(ش, الاسم);
            أرجع ع_جديدة_جسر(ش, 10, 0, 0, 0, 0, اللافتة مثل ط64, الرمز);
        };
        إذا (ي == ك.ك_continue || ي == ك.ك_break) {
            تقدم_جسر(م);
            دع ت: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            إذا (ي == ك.ك_continue) {
                إذا ((*ش).عمق_الحلقات == 0) {
                    شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_استمرار_خارج_حلقة());
                };
                أرجع ع_جديدة_جسر(ش, 9, 0, 0, 0, 0, 0, الرمز);
            };
            إذا ((*ش).عمق_الحلقات == 0 && (*ش).عمق_التبديل == 0) {
                شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_كسر_خارج_حلقة());
            };
            أرجع ع_جديدة_جسر(ش, 8, 0, 0, 0, 0, 0, الرمز);
        };
        إذا (ي == ك.ك_return) {
            تقدم_جسر(م);
            دع ق: متغير طبيعي = 0;
            إذا (!عند_جسر(م, ك.ك_semi)) {
                دع ت: طبيعي = حلل_تعبيرا_ب_جسر(م, ش);
                دع نوع_الدالة: طبيعي = (*م).الكيانات[(*ش).الدالة].النوع;
                دع ناتج_الدالة: طبيعي = (*م).ج.الأنواع[نوع_الدالة].الأساس;
                إذا ((*م).ج.الأنواع[ناتج_الدالة].الصنف == 1) {
                    ق := ت + 1;
                } وإلا {
                    ق := لإسناد_ت_جسر(م, ش, ت, ناتج_الدالة) + 1;
                };
            };
            دع ت2: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            أرجع ع_جديدة_جسر(ش, 2, ق, 0, 0, 0, 0, الرمز);
        };
        إذا (ي == ك.ك_case) {
            تقدم_جسر(م);
            دع الأول: قيمة_جسر = قيم_ثابتا_جسر(م);
            دع الأخير: متغير قيمة_جسر = الأول;
            إذا (اقبل_جسر(م, ك.ك_ellipsis)) { الأخير := قيم_ثابتا_جسر(م); };
            دع ت: منطقي = توقع_جسر(م, ك.ك_colon, «:»);
            إذا (!الأول.ثابت || !الأخير.ثابت) {
                شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_وسم_حالة_غير_ثابت());
            };
            إذا ((*ش).عمق_التبديل == 0) {
                شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_حالة_خارج_تبديل());
            };
            دع الداخلي: متغير طبيعي = 0;
            إذا (!عند_جسر(م, ك.ك_rbrace)) { الداخلي := حلل_عبارة_ب_جسر(م, ش) + 1; };
            دع ف: طبيعي = ع_جديدة_جسر(ش, 13, الداخلي, 0, 0, 0, الأول.البتات, الرمز);
            (*ش).العبارات[ف].القيمة2 := الأخير.البتات;
            أرجع ف;
        };
        إذا (ي == ك.ك_default && عند_بعد_جسر(م, 1, ك.ك_colon)) {
            تقدم_جسر(م);
            تقدم_جسر(م);
            إذا ((*ش).عمق_التبديل == 0) {
                شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_افتراضي_خارج_تبديل());
            };
            دع الداخلي: متغير طبيعي = 0;
            إذا (!عند_جسر(م, ك.ك_rbrace)) { الداخلي := حلل_عبارة_ب_جسر(م, ش) + 1; };
            أرجع ع_جديدة_جسر(ش, 14, الداخلي, 0, 0, 0, 0, الرمز);
        };
        إذا (ي == ك.ك___asm__ || ي == ك.ك___asm || ي == ك.ك_asm) {
            شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_عبارة_تجميع());
            تقدم_جسر(م);
            طالما (رمز_م_جسر(م).الصنف == 1 && !عند_جسر(م, ك.ك_lparen)) { تقدم_جسر(م); }
            إذا (عند_جسر(م, ك.ك_lparen)) { تخط_متوازن_م_جسر(م); };
            دع ت: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            أرجع ع_جديدة_جسر(ش, 16, 0, 0, 0, 0, 0, الرمز);
        };
        إذا (عند_بعد_جسر(م, 1, ك.ك_colon) && !هو_نوع_مسمى_جسر(م, ي)) {
            // A label.
            تقدم_جسر(م);
            تقدم_جسر(م);
            حلل_سمات_بلا_تسمية_جسر(م);
            دع اللافتة: طبيعي = لافتة_ب_جسر(ش, ي);
            إذا ((*ش).المعرفة[اللافتة]) {
                شخص_م_رمز_جسر(م, سبب_تشخيص.سبب_سي_إعادة_تعريف_لافتة(), &ر, اسم_م_جسر(م, ي));
            };
            (*ش).المعرفة[اللافتة] := صواب;
            دع الداخلي: متغير طبيعي = 0;
            إذا (!عند_جسر(م, ك.ك_rbrace)) {
                // C23 allows a declaration after a label.
                إذا (بداية_تصريح_محلي_جسر(م)) {
                    دع العناصر: متغير متجه طبيعي = [];
                    حلل_تصريحا_محليا_ب_جسر(م, ش, &متغير العناصر);
                    دع البداية: طبيعي = قائمة_جسر(ش, &العناصر);
                    الداخلي := ع_جديدة_جسر(ش, 7, البداية, الطول(العناصر) مثل طبيعي, 0, 0, 0, الرمز) + 1;
                } وإلا {
                    الداخلي := حلل_عبارة_ب_جسر(م, ش) + 1;
                };
            };
            أرجع ع_جديدة_جسر(ش, 11, الداخلي, 0, 0, 0, اللافتة مثل ط64, الرمز);
        };
    };
    دع ق: طبيعي = حلل_تعبيرا_ب_جسر(م, ش);
    إذا (!توقع_جسر(م, ك.ك_semi, «;»)) { زامن_جسر(م); };
    أرجع ع_جديدة_جسر(ش, 1, ق + 1, 0, 0, 0, 0, الرمز);
}

// ---- definitions ----

// Compiles the definition التعريف (parser.sn): a function body or a
// file-scope object's initializer, into the tree.
عام عرف حلل_تعريفا_ب_جسر(م: &متغير محلل_جسر, ش: &متغير شجرة_جسر, التعريف: &تعريف_جسر): فراغ {
    دع الكيان: كيان_سي_جسر = (*م).الكيانات[(*التعريف).الكيان];
    إذا ((*التعريف).الصنف == 1) { حلل_دالة_ب_جسر(م, ش, التعريف); أرجع; };
    // A file-scope object: one per entity (a later definition with an
    // initializer replaces a tentative one).
    طالما ((الطول((*ش).عام_الكيان) مثل طبيعي) <= (*التعريف).الكيان) { ألحق((*ش).عام_الكيان, 0); }
    دع الموجود: طبيعي = (*ش).عام_الكيان[(*التعريف).الكيان];
    إذا (الموجود != 0 && (*التعريف).الصنف == 3) { أرجع; };
    دع النوع_ن: متغير طبيعي = الكيان.النوع;
    دع البداية: طبيعي = الطول((*ش).المهيئات) مثل طبيعي;
    إذا ((*التعريف).الصنف == 2) {
        دع المحفوظ: طبيعي = (*م).الموضع;
        (*م).الموضع := (*التعريف).البداية;
        (*م).في_جسم := صواب;
        النوع_ن := حلل_مهيئا_ب_جسر(م, ش, الكيان.النوع, 0);
        (*م).في_جسم := خطأ;
        (*م).الموضع := المحفوظ;
        (*م).الكيانات[(*التعريف).الكيان].النوع := النوع_ن;
    } وإلا إذا ((*م).ج.الأنواع[النوع_ن].الصنف == 6 && (*م).ج.الأنواع[النوع_ن].مجهول_العدد) {
        // A tentative definition of an array of unknown size has one element.
        النوع_ن := مصفوفة_من_جسر(&متغير (*م).ج, (*م).ج.الأنواع[النوع_ن].الأساس, 1, خطأ);
    };
    دع العدد: طبيعي = (الطول((*ش).المهيئات) مثل طبيعي) - البداية;
    دع العام: عام_جسم_جسر = {
        الكيان: (*التعريف).الكيان + 1, الاسم: الكيان.الاسم, النوع: النوع_ن, بداية_المهيئ: البداية, عدد_المهيئ: العدد,
        ساكن: الكيان.ساكن, الدالة: 0, خيطي: الكيان.خيطي
    };
    إذا (الموجود != 0) {
        (*ش).العوام[الموجود - 1] := العام;
        أرجع;
    };
    ألحق((*ش).العوام, العام);
    (*ش).عام_الكيان[(*التعريف).الكيان] := الطول((*ش).العوام) مثل طبيعي;
}

عرف حلل_دالة_ب_جسر(م: &متغير محلل_جسر, ش: &متغير شجرة_جسر, التعريف: &تعريف_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع الكيان: كيان_سي_جسر = (*م).الكيانات[(*التعريف).الكيان];
    دع نوع_الدالة: نوع_سي_جسر = (*م).ج.الأنواع[الكيان.النوع];
    دع المحفوظ: طبيعي = (*م).الموضع;
    (*ش).الدالة := (*التعريف).الكيان;
    دع فارغ_ل: متجه طبيعي = [];
    (*ش).اللافتات := فارغ_ل;
    دع فارغ_م: متجه منطقي = [];
    (*ش).المعرفة := فارغ_م;
    (*ش).فيها_قفز := خطأ;
    (*ش).عمق_الحلقات := 0;
    (*ش).عمق_التبديل := 0;
    دع بداية_المحليات: طبيعي = الطول((*ش).المحليات) مثل طبيعي;
    (*ش).بداية_المحليات := بداية_المحليات;
    (*م).في_جسم := صواب;
    افتح_نطاقا_جسر(م);
    // The parameters: their names from the declarator's list.
    (*م).الموضع := (*التعريف).موضع_الاسم + 1;
    طالما (عند_جسر(م, ك.ك___attribute__) || عند_جسر(م, ك.ك___attribute)) { حلل_سمات_بلا_تسمية_جسر(م); }
    دع عدد_المعاملات: متغير طبيعي = 0;
    إذا (نوع_الدالة.قائمة_معرفات) {
        شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_تعريف_قديم());
    } وإلا إذا (اقبل_جسر(م, ك.ك_lparen) && !عند_جسر(م, ك.ك_rparen)
        && !(عند_جسر(م, ك.ك_void) && عند_بعد_جسر(م, 1, ك.ك_rparen))) {
        طالما (!نهاية_جسر(م) && !عند_جسر(م, ك.ك_ellipsis)) {
            دع الرمز_م: رمز_جسر = رمز_م_جسر(م);
            دع المواصفات: مواصفات_جسر = حلل_مواصفات_جسر(م);
            دع المصرح: مصرح_جسر = حلل_مصرحا_جسر(م, المواصفات.النوع);
            دع النوع_م: طبيعي = اختر_ط_ب_جسر(عدد_المعاملات < نوع_الدالة.عدد_المعطيات,
                (*م).ج.المعطيات[نوع_الدالة.بداية_المعطيات + اختر_ط_ب_جسر(عدد_المعاملات < نوع_الدالة.عدد_المعطيات, عدد_المعاملات, 0)],
                عدل_معطى_جسر(م, المصرح.النوع));
            دع الموقع: رمز_جسر = رمز_جسر_من(1, المصرح.الاسم, المصرح.الملف, المصرح.السطر, المصرح.العمود, 0);
            دع ف: طبيعي = أضف_محليا_جسر(م, ش, المصرح.الاسم, النوع_م, صواب, &الموقع);
            عدد_المعاملات := عدد_المعاملات + 1;
            إذا (!اقبل_جسر(م, ك.ك_comma)) { اخرج_من_حلقة; };
        }
    };
    // The body.
    (*م).الموضع := (*التعريف).البداية;
    دع عدد_الدوال: طبيعي = الطول((*ش).الدوال) مثل طبيعي;
    دع الجسم: طبيعي = حلل_كتلة_ب_جسر(م, ش);
    أغلق_نطاقا_جسر(م);
    (*م).في_جسم := خطأ;
    (*م).الموضع := المحفوظ;
    // Every label used is defined.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*ش).اللافتات) مثل طبيعي)) {
        إذا (!(*ش).المعرفة[ف]) {
            دع اسم_ل: نص = اسم_م_جسر(م, (*ش).اللافتات[ف]);
            دع ر: رمز_جسر = (*م).الرموز[(*التعريف).البداية];
            شخص_م_رمز_جسر(م, سبب_تشخيص.سبب_سي_لافتة_غير_معرفة(), &ر, اسم_ل);
        };
        ف := ف + 1;
    }
    دع الدالة: دالة_جسم_جسر = {
        الكيان: (*التعريف).الكيان, الجسم: الجسم + 1, بداية_المحليات: بداية_المحليات,
        عدد_المحليات: (الطول((*ش).المحليات) مثل طبيعي) - بداية_المحليات, عدد_المعاملات: عدد_المعاملات,
        عدد_اللافتات: الطول((*ش).اللافتات) مثل طبيعي, فيها_قفز: (*ش).فيها_قفز,
        متغيرة: نوع_الدالة.متغير_المعاملات, الاسم: الكيان.الاسم
    };
    ألحق((*ش).الدوال, الدالة);
}

