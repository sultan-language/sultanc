// Jisr (جسر), SultanC's C frontend: the C declarations of an imported
// header or .c file, for one target, as a SultanC module.
//
//   lexer.sn        phases 1-3: tokens with file, line and column
//   preprocessor.sn #include, macros, conditionals, pragmas
//   headers.sn      the compiler-provided headers (<stddef.h>, <stdarg.h>...)
//   target.sn       the C data model and predefined macros of the target
//   parser.sn       declarations, types, constant expressions
//   types.sn        C types and record layout
//   emit.sn         the SultanC module
//
// The include search is the target's: $SULTANC_C_SYSROOT when set, the
// host's system directories when the target is the host, a target
// sysroot or multiarch directory when one is installed; else the host's
// headers are read under the target's predefined macros and data model,
// with a warning in the module (SULTANC-C-HOST-HEADERS).
استورد std.text.compare;
استورد std.env.system;
استورد std.fs.metadata;
استورد std.fs.path;
استورد std.text.transform;
استورد std.text.search;
استورد std.text.from_bytes;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.foreign_c;
استورد compiler.jisr.core;
استورد compiler.jisr.target;
استورد compiler.jisr.preprocessor;
استورد compiler.jisr.parser;
استورد compiler.jisr.emit;
استورد compiler.jisr.lower;

عرف دليل_موجود_جسر(المسار: &نص): منطقي {
    طابق حاول_نوع_المسار(المسار) مع
    | نتيجة.نجح(نوع_مسار.دليل) -> { أرجع صواب; }
    | نتيجة.نجح(نوع_مسار.وصلة_رمزية) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}


عرف متغير_بيئة_جسر(الاسم: نص): اختياري نص {
    طابق متغير_بيئة_النظام(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        إذا ((الطول(القيمة) مثل طبيعي) > 0) { أرجع اختياري.موجود(القيمة); };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The user include directories ($SULTANC_C_INCLUDE, ':'-separated).
عام عرف أدلة_المستخدم_جسر(): متجه نص {
    طابق متغير_بيئة_جسر(«SULTANC_C_INCLUDE») مع
    | اختياري.موجود(القيمة) -> {
        // An empty entry of the list names no directory.
        دع الفاصل: نص = «:»;
        دع الأجزاء: متجه نص = قسم_النص(&القيمة, &الفاصل);
        دع الأدلة: متغير متجه نص = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
            إذا (!نص_فارغ(&الأجزاء[ف])) { ألحق(الأدلة, انسخ_نص(&الأجزاء[ف])); };
            ف := ف + 1;
        }
        أرجع الأدلة;
    }
    | اختياري.لا_شيء -> {
        دع لا_شيء_ن: متجه نص = [];
        أرجع لا_شيء_ن;
    };
}

عرف هدف_المضيف_جسر(الهدف: &واصف_هدف): منطقي {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.محلول(المضيف) -> { أرجع معرفا_هدف_متساويان(المضيف.المعرف, (*الهدف).المعرف); }
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع خطأ; };
}

// The system include directories of a target ("<jisr>" for the builtin
// headers) and whether they are the host's stand-ins for a target whose
// own headers are not installed.
عام نوع أدلة_نظام_جسر = { الأدلة: متجه نص, بديلة: منطقي };

عرف ألحق_إن_وجد_جسر(الأدلة: &متغير متجه نص, الدليل: نص): فراغ {
    إذا (دليل_موجود_جسر(&الدليل)) { ألحق(*الأدلة, الدليل); };
}

عرف أدلة_جذر_جسر(الجذر: &نص, النموذج: &نموذج_سي_جسر): متجه نص {
    دع الأدلة: متغير متجه نص = [];
    ألحق_إن_وجد_جسر(&متغير الأدلة, صل_نصين(الجذر, &«/usr/local/include»));
    ألحق(الأدلة, «<jisr>»);
    إذا ((الطول((*النموذج).المتعدد) مثل طبيعي) > 0) {
        ألحق_إن_وجد_جسر(&متغير الأدلة, صل_ثلاثة_نصوص(الجذر, &«/usr/include/», &(*النموذج).المتعدد));
    };
    ألحق_إن_وجد_جسر(&متغير الأدلة, صل_نصين(الجذر, &«/usr/include»));
    ألحق_إن_وجد_جسر(&متغير الأدلة, صل_نصين(الجذر, &«/include»));
    أرجع الأدلة;
}

عام عرف أدلة_النظام_جسر(الهدف: &واصف_هدف, النموذج: &نموذج_سي_جسر): أدلة_نظام_جسر {
    طابق متغير_بيئة_جسر(«SULTANC_C_SYSROOT») مع
    | اختياري.موجود(الجذر) -> {
        دع الناتج: أدلة_نظام_جسر = { الأدلة: أدلة_جذر_جسر(&الجذر, النموذج), بديلة: خطأ };
        أرجع الناتج;
    }
    | اختياري.لا_شيء -> { };
    دع المضيف: منطقي = هدف_المضيف_جسر(الهدف);
    دع الأدلة: متغير متجه نص = [];
    إذا ((*النموذج).داروين) {
        دع حزم: متجه نص = [«/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk»,
            «/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk»];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(حزم) مثل طبيعي)) {
            دع الدليل: نص = صل_نصين(&حزم[ف], &«/usr/include»);
            إذا (دليل_موجود_جسر(&الدليل)) {
                ألحق_إن_وجد_جسر(&متغير الأدلة, «/usr/local/include»);
                ألحق_إن_وجد_جسر(&متغير الأدلة, «/opt/homebrew/include»);
                ألحق(الأدلة, «<jisr>»);
                ألحق(الأدلة, الدليل);
                دع الناتج: أدلة_نظام_جسر = { الأدلة: الأدلة, بديلة: خطأ };
                أرجع الناتج;
            };
            ف := ف + 1;
        }
    } وإلا إذا (المضيف) {
        دع الجذر: نص = «»;
        دع الناتج: أدلة_نظام_جسر = { الأدلة: أدلة_جذر_جسر(&الجذر, النموذج), بديلة: خطأ };
        أرجع الناتج;
    } وإلا إذا ((الطول((*النموذج).المتعدد) مثل طبيعي) > 0) {
        // A Debian-style cross sysroot or a multiarch directory.
        دع المتعدد: نص = صل_نصين(&«/usr/include/», &(*النموذج).المتعدد);
        إذا (دليل_موجود_جسر(&المتعدد)) {
            دع الجذر: نص = «»;
            دع الناتج: أدلة_نظام_جسر = { الأدلة: أدلة_جذر_جسر(&الجذر, النموذج), بديلة: خطأ };
            أرجع الناتج;
        };
        دع العابر: نص = صل_نصين(&«/usr/», &(*النموذج).المتعدد);
        دع دليل_العابر: نص = صل_نصين(&العابر, &«/include»);
        إذا (دليل_موجود_جسر(&دليل_العابر)) {
            ألحق(الأدلة, «<jisr>»);
            ألحق(الأدلة, صل_نصين(&العابر, &«/include»));
            دع الناتج: أدلة_نظام_جسر = { الأدلة: الأدلة, بديلة: خطأ };
            أرجع الناتج;
        };
    };
    // No headers of this target: the host's, flagged.
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.محلول(المضيف) -> {
        دع نموذج_المضيف: نموذج_سي_جسر = نموذج_سي_من_هدف_جسر(&المضيف);
        إذا (نموذج_المضيف.داروين) {
            دع الناتج: متغير أدلة_نظام_جسر = أدلة_النظام_جسر(&المضيف, &نموذج_المضيف);
            الناتج.بديلة := صواب;
            أرجع الناتج;
        };
        دع الجذر: نص = «»;
        دع الناتج: أدلة_نظام_جسر = { الأدلة: أدلة_جذر_جسر(&الجذر, &نموذج_المضيف), بديلة: صواب };
        أرجع الناتج;
    }
    | نتيجة_حل_هدف.غير_مسجل -> { };
    ألحق(الأدلة, «<jisr>»);
    دع الناتج: أدلة_نظام_جسر = { الأدلة: الأدلة, بديلة: صواب };
    أرجع الناتج;
}

// The SultanC module of the C file الملف (an existing path) for الهدف.
// الجذر is the directory whose headers' declarations are written (the
// file's own directory, or the include directory a header was found in);
// وحدة: a .c whose function definitions are compiled and linked. With
// المسبق, the text is الملف already preprocessed by a C compiler
// (`cc -E -dD`) and only parsed here.
عام عرف ترجم_جسر(الملف: &نص, الجذر: &نص, وحدة_ترجمة: منطقي, الهدف: &واصف_هدف, المسبق: اختياري نص): نتيجة نص, عدد {
    دع النموذج: نموذج_سي_جسر = نموذج_سي_من_هدف_جسر(الهدف);
    دع البحث: متغير متجه نص = [];
    // The file's own directory is searched first (as `-I`), unless the
    // file is a system header: a system directory is not a user one (GCC
    // ignores -I of one), and <signal.h> from sys/signal.h must not find
    // sys/signal.h itself.
    دع دليل_الملف: نص = دليل_مسار_جسر(الملف);
    دع نظامي: متغير منطقي = يبدأ_بـ(الملف, &«<jisr>/»);
    دع الأدلة_أولا: أدلة_نظام_جسر = أدلة_النظام_جسر(الهدف, &النموذج);
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(الأدلة_أولا.الأدلة) مثل طبيعي)) {
        دع الدليل_ن: &نص = &الأدلة_أولا.الأدلة[ي];
        إذا (نصان_متساويان(الدليل_ن, &دليل_الملف)) { نظامي := صواب; };
        دع البادئة: نص = صل_نصين(الدليل_ن, &«/»);
        إذا (يبدأ_بـ(&دليل_الملف, &البادئة)) { نظامي := صواب; };
        ي := ي + 1;
    }
    إذا (!نظامي) { ألحق(البحث, دليل_الملف); };
    دع المستخدم: متجه نص = أدلة_المستخدم_جسر();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المستخدم) مثل طبيعي)) { ألحق(البحث, انسخ_نص(&المستخدم[ف])); ف := ف + 1; }
    دع عدد_المستخدم: طبيعي = الطول(البحث) مثل طبيعي;
    دع النظام: متغير أدلة_نظام_جسر = أدلة_النظام_جسر(الهدف, &النموذج);
    // Without the target's own headers: the host's stand in when the host
    // has the target's data model; inside them the host's predefined
    // macros apply (they select the host's bits/ headers), everywhere else
    // the target's. Otherwise only the freestanding headers are available.
    دع المسبقة: متغير نص = ماكروهات_معرفة_مسبقا_جسر(&النموذج);
    دع مسبقة_المضيف: متغير نص = «»;
    دع التحذير: متغير ط8 = 0;
    إذا (النظام.بديلة) {
        طابق حل_هدف_المضيف_المسجل() مع
        | نتيجة_حل_هدف.محلول(المضيف) -> {
            دع نموذج_المضيف: نموذج_سي_جسر = نموذج_سي_من_هدف_جسر(&المضيف);
            إذا (نموذج_المضيف.عرض_المؤشر == النموذج.عرض_المؤشر && نموذج_المضيف.عرض_الطويل == النموذج.عرض_الطويل
                && نموذج_المضيف.عرض_الصحيح == النموذج.عرض_الصحيح && نموذج_المضيف.كبير_النهاية == النموذج.كبير_النهاية) {
                مسبقة_المضيف := ماكروهات_معرفة_مسبقا_جسر(&نموذج_المضيف);
                التحذير := 1;
            } وإلا {
                دع المدمجة: متجه نص = [«<jisr>»];
                النظام.الأدلة := المدمجة;
                التحذير := 2;
            };
        }
        | نتيجة_حل_هدف.غير_مسجل -> { التحذير := 2; };
    };
    ف := 0;
    طالما (ف < (الطول(النظام.الأدلة) مثل طبيعي)) { ألحق(البحث, انسخ_نص(&النظام.الأدلة[ف])); ف := ف + 1; }
    دع مسبق: منطقي = طابق_اختيارا_جسر(&المسبق);
    دع ع: متغير معالج_جسر = معالج_جسر_جديد(البحث, عدد_المستخدم, انسخ_نص(الجذر), انسخ_نص(الملف), مسبق);
    اضبط_أسماء_الهدف_جسر(&متغير ع, أسماء_معمارية_جسر(&النموذج), أسماء_منصة_جسر(&النموذج),
        أسماء_مورد_جسر(&النموذج), أسماء_بيئة_جسر(&النموذج));
    طابق المسبق مع
    | اختياري.موجود(النص) -> {
        دع الفهرس: طبيعي = أضف_ملفا_نصيا_جسر(&متغير ع, «<preprocessed>», &النص);
        عالج_نصا_جسر(&متغير ع, الفهرس);
    }
    | اختياري.لا_شيء -> {
        إذا (التحذير == 1) {
            // Search entries are 1 + the directory's index: the system
            // directories' entries start at عدد_المستخدم + 1.
            اضبط_بديل_المضيف_جسر(&متغير ع, عدد_المستخدم + 1, &مسبقة_المضيف, &المسبقة);
        } وإلا {
            دع الفهرس: طبيعي = أضف_ملفا_نصيا_جسر(&متغير ع, «<built-in>», &المسبقة);
            عالج_نصا_جسر(&متغير ع, الفهرس);
        };
        إذا (!ادخل_الرئيسي_جسر(&متغير ع, الملف)) { أرجع نتيجة.خطأ(2); };
        عالج_جسر(&متغير ع);
    };
    إذا (التحذير != 0) {
        دع السبب: متغير سبب_تشخيص = سبب_تشخيص.سبب_سي_ترويسات_المضيف();
        إذا (التحذير != 1) { السبب := سبب_تشخيص.سبب_سي_بلا_ترويسات_نظام(); };
        دع ت: متغير تشخيص_جسر = تشخيص_جسر_بلا_موقع(السبب);
        أضف_هدف_سي(&متغير ت.السجل, انسخ_نص(&النموذج.التهجئة));
        أضف_تشخيص_جسر(&متغير ع.التشخيصات, ت);
    };
    دع م: متغير محلل_جسر = محلل_جسر_جديد(ع, النموذج);
    // A .c file is compiled by Jisr (lower.sn) unless the system C compiler
    // was selected for it (SULTANC_C_COMPILER=cc, translate.sn).
    دع يترجم: منطقي = وحدة_ترجمة && !مترجم_سي_خارجي_جسر();
    م.ترجمة_الأجسام := يترجم;
    م.محجوزة_مكتوبة := !نظامي;
    حلل_الوحدة_جسر(&متغير م);
    إذا (يترجم) { أرجع نتيجة.نجح(اكتب_وحدة_مترجمة_جسر(&متغير م, الملف)); };
    أرجع نتيجة.نجح(اكتب_وحدة_جسر(&متغير م, الملف, وحدة_ترجمة));
}

// Whether SULTANC_C_COMPILER selects the system C compiler (`cc`) for the
// function bodies of an imported .c; unset or `jisr`, Jisr compiles them.
عام عرف مترجم_سي_خارجي_جسر(): منطقي {
    طابق متغير_بيئة_جسر(«SULTANC_C_COMPILER») مع
    | اختياري.موجود(القيمة) -> {
        دع ن: طبيعي = الطول(القيمة) مثل طبيعي;
        أرجع ن == 2 && القيمة[0] == 0x63 && القيمة[1] == 0x63;
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}


عرف طابق_اختيارا_جسر(القيمة: &اختياري نص): منطقي {
    طابق *القيمة مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Names of the target for Clang's __is_target_arch/_os/_vendor/_environment.
عرف أسماء_معمارية_جسر(النموذج: &نموذج_سي_جسر): نص {
    دع ع: هوية_معمارية = (*النموذج).هوية_المعمارية;
    إذا (ع == هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون()) { أرجع «x86_64»; };
    إذا (ع == هوية_معمارية.ذراع_أربعة_وستون()) { أرجع «arm64 aarch64»; };
    إذا (ع == هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون()) { أرجع «i386 i686 x86»; };
    إذا (ع == هوية_معمارية.ذراع_سبعة()) { أرجع «arm armv7 armv7a»; };
    إذا (ع == هوية_معمارية.رايسك_في_أربعة_وستون()) { أرجع «riscv64»; };
    إذا (ع == هوية_معمارية.رايسك_في_اثنان_وثلاثون()) { أرجع «riscv32»; };
    إذا (ع == هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون()) { أرجع «wasm32»; };
    إذا (ع == هوية_معمارية.ويب_أسمبلي_أربعة_وستون()) { أرجع «wasm64»; };
    إذا (ع == هوية_معمارية.باور_بي_سي_أربعة_وستون()) { أرجع «powerpc64le ppc64le»; };
    إذا (ع == هوية_معمارية.سيستم_زد()) { أرجع «s390x systemz»; };
    إذا (ع == هوية_معمارية.لونغ_آرتش_أربعة_وستون()) { أرجع «loongarch64»; };
    إذا (ع == هوية_معمارية.ميبس_أربعة_وستون()) { أرجع «mips64el»; };
    أرجع «»;
}

عرف أسماء_منصة_جسر(النموذج: &نموذج_سي_جسر): نص {
    إذا ((*النموذج).داروين) { أرجع «macos macosx darwin»; };
    إذا ((*النموذج).أندرويد) { أرجع «linux android»; };
    إذا ((*النموذج).لينكس) { أرجع «linux»; };
    إذا ((*النموذج).ويندوز) { أرجع «windows win32»; };
    إذا ((*النموذج).فري_بي_إس_دي) { أرجع «freebsd»; };
    إذا ((*النموذج).واسي) { أرجع «wasi»; };
    أرجع «»;
}

عرف أسماء_مورد_جسر(النموذج: &نموذج_سي_جسر): نص {
    إذا ((*النموذج).داروين) { أرجع «apple»; };
    إذا ((*النموذج).ويندوز) { أرجع «pc»; };
    أرجع «unknown»;
}

عرف أسماء_بيئة_جسر(النموذج: &نموذج_سي_جسر): نص {
    إذا ((*النموذج).إم_إس_في_سي) { أرجع «msvc»; };
    إذا ((*النموذج).أندرويد) { أرجع «android»; };
    إذا ((*النموذج).لينكس) { أرجع «gnu»; };
    أرجع «»;
}
