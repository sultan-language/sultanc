// C literals: integer constants (C17 6.4.4.1, with C23 binary and digit
// separators), floating constants (recognized, kept as spelled), character
// constants and string literals (escape sequences decoded to bytes).
استورد std.text.from_bytes;
استورد std.math.wrapping;
استورد std.chars.ascii;
استورد std.encoding.utf8;
استورد std.unicode.scalar;
استورد compiler.jisr.core;

عام نوع عدد_حرفي_جسر = {
    القيمة: ط64,
    // A u/U suffix.
    بلا_إشارة: منطقي,
    // 0 none, 1 l/L, 2 ll/LL.
    الطول_المحدد: ط8,
    // Decimal (no 0x / 0b / leading 0).
    عشري: منطقي,
    // The value did not fit 64 bits.
    فائض: منطقي,
    صالح: منطقي
};

عام عرف حلل_عدد_صحيح_جسر(النص: &نص): عدد_حرفي_جسر {
    دع الناتج: متغير عدد_حرفي_جسر = {
        القيمة: 0, بلا_إشارة: خطأ, الطول_المحدد: 0, عشري: صواب, فائض: خطأ, صالح: خطأ
    };
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (ن == 0) { أرجع الناتج; };
    دع ف: متغير طبيعي = 0;
    دع الأساس: متغير ط64 = 10;
    إذا (ن >= 2 && (*النص)[0] == 0x30 && ((*النص)[1] == 0x78 || (*النص)[1] == 0x58)) { الأساس := 16; ف := 2; الناتج.عشري := خطأ; }
    وإلا إذا (ن >= 2 && (*النص)[0] == 0x30 && ((*النص)[1] == 0x62 || (*النص)[1] == 0x42)) { الأساس := 2; ف := 2; الناتج.عشري := خطأ; }
    وإلا إذا ((*النص)[0] == 0x30) { الأساس := 8; الناتج.عشري := خطأ; };
    دع أرقام: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب == 0x27) { ف := ف + 1; تابع_حلقة; };
        // The digit's value in bases up to 36 (std.chars.ascii; -1: none).
        دع الرقم_ع: عدد = قيمة_رقم_أسكي(ب);
        إذا (الرقم_ع < 0 || (الرقم_ع مثل ط64) >= الأساس) { اخرج_من_حلقة; };
        دع الرقم: ط64 = الرقم_ع مثل ط64;
        // Overflow check: value * base + digit must stay below 2^64.
        إذا (الناتج.القيمة > (0xFFFFFFFFFFFFFFFF - الرقم) / الأساس) { الناتج.فائض := صواب; };
        الناتج.القيمة := جمع_ط64_ملتف(ضرب_ط64_ملتف(الناتج.القيمة, الأساس), الرقم);
        أرقام := أرقام + 1;
        ف := ف + 1;
    }
    إذا (أرقام == 0 && الأساس != 8) { أرجع الناتج; };
    // Suffixes: u, l, ll in either order and case; C23 wb is not a type here.
    طالما (ف < ن) {
        دع ب: ط8 = (*النص)[ف];
        إذا ((ب == 0x75 || ب == 0x55) && !الناتج.بلا_إشارة) {
            الناتج.بلا_إشارة := صواب;
            ف := ف + 1;
        } وإلا إذا ((ب == 0x6C || ب == 0x4C) && الناتج.الطول_المحدد == 0) {
            إذا (ف + 1 < ن && (*النص)[ف + 1] == ب) { الناتج.الطول_المحدد := 2; ف := ف + 2; }
            وإلا { الناتج.الطول_المحدد := 1; ف := ف + 1; };
        } وإلا {
            أرجع الناتج;
        };
    }
    الناتج.صالح := صواب;
    أرجع الناتج;
}

// A floating constant (a pp-number with a '.', an exponent or a hex
// mantissa with p): its value spelled as a SultanC f64 literal, when the
// spelling has one (decimal digits, '.', e and sign). عرض: 32 with f/F,
// 128 for long double (l/L: the target decides its form), 64 otherwise;
// none for hex floats.
عام نوع عائم_حرفي_جسر = { صالح: منطقي, النص: نص, العرض: طبيعي };

عام عرف حلل_عائم_جسر(النص: &نص): عائم_حرفي_جسر {
    دع الفشل: عائم_حرفي_جسر = { صالح: خطأ, النص: «», العرض: 64 };
    دع ن: متغير طبيعي = الطول(*النص) مثل طبيعي;
    إذا (ن == 0) { أرجع الفشل; };
    إذا (ن >= 2 && (*النص)[0] == 0x30 && ((*النص)[1] == 0x78 || (*النص)[1] == 0x58)) { أرجع الفشل; };
    دع العرض: متغير طبيعي = 64;
    دع الأخير: ط8 = (*النص)[ن - 1];
    إذا (الأخير == 0x66 || الأخير == 0x46) { العرض := 32; ن := ن - 1; }
    وإلا إذا (الأخير == 0x6C || الأخير == 0x4C) { العرض := 128; ن := ن - 1; };
    دع البايتات: متغير متجه ط8 = [];
    دع نقطة: متغير منطقي = خطأ;
    دع أس: متغير منطقي = خطأ;
    دع أرقام_قبل: متغير طبيعي = 0;
    دع أرقام_بعد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع ب: ط8 = (*النص)[ف];
        إذا (رقم_عشري(ب)) {
            إذا (نقطة || أس) { أرقام_بعد := أرقام_بعد + 1; } وإلا { أرقام_قبل := أرقام_قبل + 1; };
            ألحق(البايتات, ب);
        } وإلا إذا (ب == 0x2E && !نقطة && !أس) {
            // SultanC wants a digit on both sides of the point.
            إذا (أرقام_قبل == 0) { ألحق(البايتات, 0x30); };
            ألحق(البايتات, ب);
            نقطة := صواب;
            إذا (ف + 1 >= ن || !رقم_عشري((*النص)[ف + 1])) { ألحق(البايتات, 0x30); };
        } وإلا إذا ((ب == 0x65 || ب == 0x45) && !أس) {
            إذا (!نقطة) { ألحق(البايتات, 0x2E); ألحق(البايتات, 0x30); };
            ألحق(البايتات, 0x65);
            أس := صواب;
        } وإلا إذا ((ب == 0x2B || ب == 0x2D) && أس && ف > 0 && ((*النص)[ف - 1] == 0x65 || (*النص)[ف - 1] == 0x45)) {
            ألحق(البايتات, ب);
        } وإلا إذا (ب == 0x27) {
        } وإلا {
            أرجع الفشل;
        };
        ف := ف + 1;
    }
    إذا (!نقطة && !أس) { أرجع الفشل; };
    دع الناتج: عائم_حرفي_جسر = { صالح: صواب, النص: البايتات مثل نص, العرض: العرض };
    أرجع الناتج;
}

// Decoding of literal contents. البادئة: 0 none or u8, 1 L, 2 u, 3 U.
// السبب when it fails: 1 a malformed escape sequence, 2 a universal
// character name that names no allowed character (C17 6.4.3: a surrogate,
// above U+10FFFF, or below U+00A0 other than $ @ `), 3 bytes that are not
// UTF-8 (std.encoding.utf8: overlong, surrogate, above U+10FFFF, truncated
// or a stray continuation byte); الموضع is the byte of the spelling where it
// was found and القيمة the code point of a rejected universal name.
عام نوع حرفي_مفكوك_جسر = {
    صالح: منطقي,
    البادئة: ط8,
    // Code units: bytes for plain and u8 literals; Unicode scalar values for
    // L, u and U ones (وحدات_عريضة_جسر makes UTF-16 units of them), with
    // octal and hexadecimal escapes as the units they write.
    الوحدات: متجه ط64,
    السبب: ط8,
    الموضع: طبيعي,
    القيمة: ط64
};

عرف بادئة_جسر(النص: &نص): طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي) && (*النص)[ف] != 0x22 && (*النص)[ف] != 0x27) { ف := ف + 1; }
    أرجع ف;
}

// Whether a universal character name may name code point ق (C17 6.4.3p2).
عام عرف اسم_محرف_عام_مسموح_جسر(ق: ط64): منطقي {
    إذا (ق > 0xFFFFFFFF || !قيمة_يونيكود_قياسية_صالحة(ق مثل ط32)) { أرجع خطأ; };
    أرجع ق >= 0xA0 || ق == 0x24 || ق == 0x40 || ق == 0x60;
}

عرف فشل_حرفي_جسر(البادئة: ط8, السبب: ط8, الموضع: طبيعي, القيمة: ط64): حرفي_مفكوك_جسر {
    دع لا_وحدات: متجه ط64 = [];
    دع الناتج: حرفي_مفكوك_جسر = { صالح: خطأ, البادئة: البادئة, الوحدات: لا_وحدات, السبب: السبب, الموضع: الموضع, القيمة: القيمة };
    أرجع الناتج;
}

// The code units of a string literal or character constant spelling.
عام عرف فك_حرفي_جسر(النص: &نص): حرفي_مفكوك_جسر {
    دع الوحدات: متغير متجه ط64 = [];
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    دع بداية: طبيعي = بادئة_جسر(النص);
    دع البادئة: متغير ط8 = 0;
    إذا (بداية == 1 && (*النص)[0] == 0x4C) { البادئة := 1; };
    إذا (بداية == 1 && (*النص)[0] == 0x75) { البادئة := 2; };
    إذا (بداية == 1 && (*النص)[0] == 0x55) { البادئة := 3; };
    إذا (ن < بداية + 2) { أرجع فشل_حرفي_جسر(البادئة, 1, 0, 0); };
    دع ف: متغير طبيعي = بداية + 1;
    طالما (ف + 1 < ن) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب != 0x5C) {
            إذا (محرف_أسكي(ب)) {
                ألحق(الوحدات, ب مثل ط64);
                ف := ف + 1;
                تابع_حلقة;
            };
            // A character beyond ASCII: its UTF-8 bytes, validated; a wide
            // literal holds the scalar value.
            دع المحرف: فك_يوتيف8 = فك_محرف_يوتيف8(النص, ف);
            إذا (!المحرف.صالح || ف + المحرف.العرض > ن - 1) { أرجع فشل_حرفي_جسر(البادئة, 3, ف, 0); };
            إذا (البادئة == 0) {
                دع ي: متغير طبيعي = 0;
                طالما (ي < المحرف.العرض) { ألحق(الوحدات, (*النص)[ف + ي] مثل ط64); ي := ي + 1; }
            } وإلا {
                ألحق(الوحدات, المحرف.القيمة مثل ط64);
            };
            ف := ف + المحرف.العرض;
            تابع_حلقة;
        };
        دع بداية_الهروب: طبيعي = ف;
        ف := ف + 1;
        إذا (ف + 1 > ن - 1) { أرجع فشل_حرفي_جسر(البادئة, 1, بداية_الهروب, 0); };
        دع ت: ط8 = (*النص)[ف];
        ف := ف + 1;
        إذا (ت == 0x6E) { ألحق(الوحدات, 10); }
        وإلا إذا (ت == 0x74) { ألحق(الوحدات, 9); }
        وإلا إذا (ت == 0x72) { ألحق(الوحدات, 13); }
        وإلا إذا (ت == 0x61) { ألحق(الوحدات, 7); }
        وإلا إذا (ت == 0x62) { ألحق(الوحدات, 8); }
        وإلا إذا (ت == 0x66) { ألحق(الوحدات, 12); }
        وإلا إذا (ت == 0x76) { ألحق(الوحدات, 11); }
        وإلا إذا (ت == 0x65) { ألحق(الوحدات, 27); }
        وإلا إذا (ت == 0x5C || ت == 0x27 || ت == 0x22 || ت == 0x3F) { ألحق(الوحدات, ت مثل ط64); }
        وإلا إذا (رقم_ثماني(ت)) {
            // An octal escape: one to three octal digits (std.chars.ascii).
            دع القيمة: متغير ط64 = قيمة_رقم_أسكي(ت) مثل ط64;
            دع ك: متغير طبيعي = 1;
            طالما (ك < 3 && ف + 1 < ن && رقم_ثماني((*النص)[ف])) {
                القيمة := القيمة * 8 + (قيمة_رقم_أسكي((*النص)[ف]) مثل ط64);
                ف := ف + 1;
                ك := ك + 1;
            }
            ألحق(الوحدات, القيمة);
        } وإلا إذا (ت == 0x78) {
            دع القيمة: متغير ط64 = 0;
            دع أرقام: متغير طبيعي = 0;
            طالما (ف + 1 < ن && رقم_سداسي((*النص)[ف])) {
                القيمة := جمع_ط64_ملتف(ضرب_ط64_ملتف(القيمة, 16), قيمة_سداسية((*النص)[ف]) مثل ط64);
                ف := ف + 1;
                أرقام := أرقام + 1;
            }
            إذا (أرقام == 0) { أرجع فشل_حرفي_جسر(البادئة, 1, بداية_الهروب, 0); };
            ألحق(الوحدات, القيمة);
        } وإلا إذا (ت == 0x75 || ت == 0x55) {
            // \u hhhh and \U hhhhhhhh: exactly four or eight digits.
            دع الحد: طبيعي = اختر_طبيعيا_ح_جسر(ت == 0x75, 4, 8);
            دع القيمة: متغير ط64 = 0;
            دع أرقام: متغير طبيعي = 0;
            طالما (أرقام < الحد && ف + 1 < ن && رقم_سداسي((*النص)[ف])) {
                القيمة := القيمة * 16 + (قيمة_سداسية((*النص)[ف]) مثل ط64);
                ف := ف + 1;
                أرقام := أرقام + 1;
            }
            إذا (أرقام != الحد) { أرجع فشل_حرفي_جسر(البادئة, 1, بداية_الهروب, 0); };
            إذا (!اسم_محرف_عام_مسموح_جسر(القيمة)) { أرجع فشل_حرفي_جسر(البادئة, 2, بداية_الهروب, القيمة); };
            إذا (البادئة == 0) {
                // In a narrow literal: the UTF-8 bytes (std.encoding.utf8).
                دع البايتات: متجه ط8 = [];
                طابق ألحق_محرف_يوتيف8(البايتات, القيمة مثل ط32) مع
                | نتيجة_ترميز_يوتيف8.مشفر(المشفر) -> {
                    دع ي: متغير طبيعي = 0;
                    طالما (ي < (الطول(المشفر) مثل طبيعي)) { ألحق(الوحدات, المشفر[ي] مثل ط64); ي := ي + 1; }
                }
                | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> { أرجع فشل_حرفي_جسر(البادئة, 2, بداية_الهروب, القيمة); };
            } وإلا {
                ألحق(الوحدات, القيمة);
            };
        } وإلا {
            أرجع فشل_حرفي_جسر(البادئة, 1, بداية_الهروب, 0);
        };
    }
    دع الناتج: حرفي_مفكوك_جسر = { صالح: صواب, البادئة: البادئة, الوحدات: الوحدات, السبب: 0, الموضع: 0, القيمة: 0 };
    أرجع الناتج;
}

عرف اختر_طبيعيا_ح_جسر(الشرط: منطقي, أ: طبيعي, ب: طبيعي): طبيعي {
    إذا (الشرط) { أرجع أ; };
    أرجع ب;
}

// The code units of a wide literal's scalar values for units of العرض
// bits: UTF-16 (a surrogate pair above U+FFFF) for 16, the values else.
// Escaped units (\x, octal) are not characters and are kept.
عام عرف وحدات_عريضة_جسر(القيم: &متجه ط64, العرض: طبيعي): متجه ط64 {
    دع الناتج: متغير متجه ط64 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        دع ق: ط64 = (*القيم)[ف];
        إذا (العرض == 16 && ق > 0xFFFF && ق <= 0x10FFFF) {
            دع ب: ط64 = ق - 0x10000;
            ألحق(الناتج, 0xD800 + (ب >> 10));
            ألحق(الناتج, 0xDC00 + (ب & 0x3FF));
        } وإلا {
            ألحق(الناتج, ق);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The value of a character constant: a plain one is an int built from its
// bytes (each converted through char's signedness for a single byte), a
// prefixed one is its unit.
عام نوع حرف_حرفي_جسر = { صالح: منطقي, القيمة: ط64, البادئة: ط8 };

عام عرف حلل_حرف_جسر(النص: &نص, الحرف_موقع: منطقي): حرف_حرفي_جسر {
    دع المفكوك: حرفي_مفكوك_جسر = فك_حرفي_جسر(النص);
    دع الفشل: حرف_حرفي_جسر = { صالح: خطأ, القيمة: 0, البادئة: 0 };
    إذا (!المفكوك.صالح || (الطول(المفكوك.الوحدات) مثل طبيعي) == 0) { أرجع الفشل; };
    إذا (المفكوك.البادئة != 0) {
        دع الناتج: حرف_حرفي_جسر = { صالح: صواب, القيمة: المفكوك.الوحدات[0], البادئة: المفكوك.البادئة };
        أرجع الناتج;
    };
    إذا ((الطول(المفكوك.الوحدات) مثل طبيعي) == 1) {
        دع ق: متغير ط64 = المفكوك.الوحدات[0] & 0xFF;
        إذا (الحرف_موقع && ق >= 0x80) { ق := ق | 0xFFFFFFFFFFFFFF00; };
        دع الناتج: حرف_حرفي_جسر = { صالح: صواب, القيمة: ق, البادئة: 0 };
        أرجع الناتج;
    };
    // Multi-character constant (implementation-defined): GCC's big-endian
    // packing into an int.
    دع ق: متغير ط64 = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المفكوك.الوحدات) مثل طبيعي)) {
        ق := ((ق << 8) | (المفكوك.الوحدات[ف] & 0xFF)) & 0xFFFFFFFF;
        ف := ف + 1;
    }
    إذا ((ق & 0x80000000) != 0) { ق := ق | 0xFFFFFFFF00000000; };
    دع الناتج: حرف_حرفي_جسر = { صالح: صواب, القيمة: ق, البادئة: 0 };
    أرجع الناتج;
}
