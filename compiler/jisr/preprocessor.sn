// The C preprocessor of Jisr (C17 6.10, with the GNU and Clang extensions
// system headers rely on): #include with "" and <> search and
// #include_next, object-like and function-like macros with # and ##,
// __VA_ARGS__, __VA_OPT__ and GNU's `, ## __VA_ARGS__`, conditional
// inclusion with defined, __has_include, __has_attribute and the other
// feature tests, #pragma once and pack, _Pragma, include guards, and the
// predefined macros of the target (target.sn) and of the language
// (__FILE__, __LINE__, __COUNTER__).
//
// Expansion follows Prosser's algorithm, as Clang and chibicc implement the
// standard's rescanning rule: every token carries a hide set, the macros
// whose expansion produced it; a macro is not expanded inside its own hide
// set. Expansions are pushed onto a pending stack read before the file, so
// rescanning with the rest of the file (a function-like macro whose
// arguments follow its expansion) needs no list splicing.
//
// A second mode reads text a C compiler already preprocessed (`cc -E -dD`,
// selected explicitly with SULTANC_C_PREPROCESSOR=cc): line markers name
// the file of what follows, #define lines fill the macro table, and the
// text is not expanded again.
استورد std.text.search;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.foreign_c;
استورد std.chars.ascii;
استورد std.encoding.utf8;
استورد std.text.transform;
استورد std.text.radix;
استورد std.text.from_bytes;
استورد std.text.number;
استورد std.text.compare;
استورد std.fs.metadata;
استورد std.fs.read_file;
استورد std.fs.path;
استورد std.math.wrapping;
استورد std.encoding.hex;
استورد std.unicode.code_point_text;
استورد std.text.substring;
استورد compiler.jisr.core;
استورد compiler.jisr.lexer;
استورد compiler.jisr.literals;
استورد compiler.jisr.headers;

عام نوع ملف_جسر = {
    المسار: نص,
    الدليل: نص,
    // 1 + the index of the search directory the file was found in; 0 when
    // it was found next to its includer or named directly.
    مدخل_البحث: طبيعي,
    // A file whose declarations the import writes (the imported file and
    // the headers under its root).
    عائلي: منطقي,
    مرة_واحدة: منطقي,
    مدخول: منطقي,
    مقطع: منطقي,
    // The macro of an include guard spanning the whole file, else 0.
    الحارس: طبيعي,
    الرموز: متجه رمز_جسر,
    // The first #include of the file: the including file (+ 1, 0 for the
    // imported file and the driver's text) and the directive's name token
    // (for a diagnostic's include chain).
    المضمن_من: طبيعي,
    موقع_التضمين: رمز_جسر
};

// المدمج: 0 an ordinary macro; 1 __FILE__, 2 __LINE__, 3 __COUNTER__,
// 4 __INCLUDE_LEVEL__, 5 __BASE_FILE__, 6 __DATE__, 7 __TIME__,
// 8 __TIMESTAMP__, 9 _Pragma; 20 and above the operators of #if
// (__has_include, ...), which are never expanded in text.
عام نوع ماكرو_جسر = {
    الاسم: طبيعي,
    دالي: منطقي,
    متغير_المعاملات: منطقي,
    المعاملات: متجه طبيعي,
    الجسم: متجه رمز_جسر,
    المدمج: ط8,
    الملف: طبيعي,
    السطر: طبيعي,
    العمود: طبيعي
};

نوع إطار_جسر = {
    الملف: طبيعي,
    الموضع: طبيعي,
    عمق_الشروط: طبيعي,
    // Preprocessed input: the file and line a line marker named.
    ملف_العلامة: طبيعي,
    سطر_العلامة: طبيعي,
    رقم_العلامة: طبيعي
};

نوع شرط_جسر = { مأخوذ: منطقي, في_وإلا: منطقي, الملف: طبيعي, السطر: طبيعي, العمود: طبيعي };

// Interned spellings the preprocessor compares against.
عام نوع كلمات_معالج_جسر = {
    ك_define: طبيعي, ك_undef: طبيعي, ك_include: طبيعي, ك_include_next: طبيعي, ك_import: طبيعي,
    ك_if: طبيعي, ك_ifdef: طبيعي, ك_ifndef: طبيعي, ك_elif: طبيعي, ك_elifdef: طبيعي, ك_elifndef: طبيعي,
    ك_else: طبيعي, ك_endif: طبيعي, ك_error: طبيعي, ك_warning: طبيعي, ك_pragma: طبيعي, ك_line: طبيعي,
    ك_ident: طبيعي, ك_sccs: طبيعي, ك_assert: طبيعي, ك_unassert: طبيعي, ك_embed: طبيعي,
    ك_defined: طبيعي, ك_once: طبيعي, ك_pack: طبيعي, ك_push: طبيعي, ك_pop: طبيعي,
    ك_push_macro: طبيعي, ك_pop_macro: طبيعي, ك_va_args: طبيعي, ك_va_opt: طبيعي,
    ك_true: طبيعي, ك_false: طبيعي,
    ك_hash: طبيعي, ك_hashhash: طبيعي, ك_lparen: طبيعي, ك_rparen: طبيعي, ك_comma: طبيعي,
    ك_lt: طبيعي, ك_gt: طبيعي, ك_ellipsis: طبيعي, ك_question: طبيعي, ك_colon: طبيعي
};

عام نوع معالج_جسر = {
    المخزن: مخزن_جسر,
    ك: كلمات_معالج_جسر,
    الملفات: متجه ملف_جسر,
    الماكروهات: متجه ماكرو_جسر,
    // Spelling id -> 1 + macro index (0: not defined).
    ماكرو_المعرف: متجه طبيعي,
    المخفيات: متجه عقدة_مخفية_جسر,
    الإطارات: متجه إطار_جسر,
    الشروط: متجه شرط_جسر,
    المعلقة: متجه رمز_جسر,
    الناتج: متجه رمز_جسر,
    التشخيصات: متجه تشخيص_جسر,
    // Include search: البحث[0, عدد_المستخدم) are the -I directories, the
    // rest the system directories ("<jisr>" names the builtin headers).
    البحث: متجه نص,
    عدد_المستخدم: طبيعي,
    الجذر: نص,
    الرئيسي: نص,
    العداد: طبيعي,
    // Reading from the files (false while expanding an isolated list).
    من_الملفات: منطقي,
    // Expanding a #if line: the operands of defined and __has_* stay.
    وضع_الشرط: منطقي,
    // The input is preprocessed text (cc -E -dD).
    مسبق: منطقي,
    // push_macro/pop_macro: name ids and saved macro entries (1 + index).
    المحفوظة_أسماء: متجه طبيعي,
    المحفوظة_قيم: متجه طبيعي,
    // Clang's target tests in #if (__is_target_arch(arm64), ...): the names
    // each one accepts for the target, space-separated.
    أسماء_المعمارية: نص,
    أسماء_المنصة: نص,
    أسماء_المورد: نص,
    أسماء_البيئة: نص,
    // Host headers standing in for a target's (jisr.sn): the predefined
    // macros that differ between the two, as (id, 1 + macro or 0) pairs of
    // each side; the host's apply only inside those headers, from the
    // search entry أول_بديل on (0: no stand-ins).
    ماكروهات_المضيف: متجه طبيعي,
    ماكروهات_الهدف: متجه طبيعي,
    أول_بديل: طبيعي,
    منظور_المضيف: منطقي
};

عرف ع_جسر(م: &متغير مخزن_جسر, النص: نص): طبيعي { أرجع اعزل_نص_جسر(م, &النص); }

عرف كلمات_معالج_جديدة_جسر(م: &متغير مخزن_جسر): كلمات_معالج_جسر {
    دع الناتج: كلمات_معالج_جسر = {
        ك_define: ع_جسر(م, «define»), ك_undef: ع_جسر(م, «undef»), ك_include: ع_جسر(م, «include»),
        ك_include_next: ع_جسر(م, «include_next»), ك_import: ع_جسر(م, «import»),
        ك_if: ع_جسر(م, «if»), ك_ifdef: ع_جسر(م, «ifdef»), ك_ifndef: ع_جسر(م, «ifndef»),
        ك_elif: ع_جسر(م, «elif»), ك_elifdef: ع_جسر(م, «elifdef»), ك_elifndef: ع_جسر(م, «elifndef»),
        ك_else: ع_جسر(م, «else»), ك_endif: ع_جسر(م, «endif»), ك_error: ع_جسر(م, «error»),
        ك_warning: ع_جسر(م, «warning»), ك_pragma: ع_جسر(م, «pragma»), ك_line: ع_جسر(م, «line»),
        ك_ident: ع_جسر(م, «ident»), ك_sccs: ع_جسر(م, «sccs»), ك_assert: ع_جسر(م, «assert»), ك_embed: ع_جسر(م, «embed»),
        ك_unassert: ع_جسر(م, «unassert»), ك_defined: ع_جسر(م, «defined»), ك_once: ع_جسر(م, «once»),
        ك_pack: ع_جسر(م, «pack»), ك_push: ع_جسر(م, «push»), ك_pop: ع_جسر(م, «pop»),
        ك_push_macro: ع_جسر(م, «push_macro»), ك_pop_macro: ع_جسر(م, «pop_macro»),
        ك_va_args: ع_جسر(م, «__VA_ARGS__»), ك_va_opt: ع_جسر(م, «__VA_OPT__»),
        ك_true: ع_جسر(م, «true»), ك_false: ع_جسر(م, «false»),
        ك_hash: ع_جسر(م, «#»), ك_hashhash: ع_جسر(م, «##»), ك_lparen: ع_جسر(م, «(»),
        ك_rparen: ع_جسر(م, «)»), ك_comma: ع_جسر(م, «,»), ك_lt: ع_جسر(م, «<»), ك_gt: ع_جسر(م, «>»),
        ك_ellipsis: ع_جسر(م, «...»), ك_question: ع_جسر(م, «?»), ك_colon: ع_جسر(م, «:»)
    };
    أرجع الناتج;
}

// A preprocessor over the include search البحث (the first عدد_المستخدم
// entries are user directories), writing the declarations of files under
// الجذر.
عام عرف معالج_جسر_جديد(البحث: متجه نص, عدد_المستخدم: طبيعي, الجذر: نص, الرئيسي: نص, مسبق: منطقي): معالج_جسر {
    دع المخزن: متغير مخزن_جسر = مخزن_جسر_جديد();
    دع ك: كلمات_معالج_جسر = كلمات_معالج_جديدة_جسر(&متغير المخزن);
    دع الملفات: متجه ملف_جسر = [];
    دع الماكروهات: متجه ماكرو_جسر = [];
    دع ماكرو_المعرف: متجه طبيعي = [];
    دع الإطارات: متجه إطار_جسر = [];
    دع الشروط: متجه شرط_جسر = [];
    دع المعلقة: متجه رمز_جسر = [];
    دع الناتج_ر: متجه رمز_جسر = [];
    دع التشخيصات: متجه تشخيص_جسر = [];
    دع المحفوظة_أسماء: متجه طبيعي = [];
    دع المحفوظة_قيم: متجه طبيعي = [];
    دع ماكروهات_المضيف: متجه طبيعي = [];
    دع ماكروهات_الهدف: متجه طبيعي = [];
    دع الناتج: متغير معالج_جسر = {
        المخزن: المخزن, ك: ك, الملفات: الملفات, الماكروهات: الماكروهات,
        ماكرو_المعرف: ماكرو_المعرف, المخفيات: مخفيات_جسر_جديدة(), الإطارات: الإطارات,
        الشروط: الشروط, المعلقة: المعلقة, الناتج: الناتج_ر, التشخيصات: التشخيصات,
        البحث: البحث, عدد_المستخدم: عدد_المستخدم, الجذر: الجذر, الرئيسي: الرئيسي,
        العداد: 0, من_الملفات: صواب, وضع_الشرط: خطأ, مسبق: مسبق,
        المحفوظة_أسماء: المحفوظة_أسماء, المحفوظة_قيم: المحفوظة_قيم,
        أسماء_المعمارية: «», أسماء_المنصة: «», أسماء_المورد: «», أسماء_البيئة: «»,
        ماكروهات_المضيف: ماكروهات_المضيف, ماكروهات_الهدف: ماكروهات_الهدف, أول_بديل: 0, منظور_المضيف: خطأ
    };
    // File 0 is the predefined text, "<built-in>".
    دع لا_رموز: متجه رمز_جسر = [];
    دع المدمج: ملف_جسر = {
        المسار: «<built-in>», الدليل: «.», مدخل_البحث: 0, عائلي: خطأ, مرة_واحدة: خطأ, مدخول: خطأ,
        مقطع: صواب, الحارس: 0, الرموز: لا_رموز, المضمن_من: 0, موقع_التضمين: رمز_نهاية_جسر()
    };
    ألحق(الناتج.الملفات, المدمج);
    عرف_مدمجات_جسر(&متغير الناتج);
    أرجع الناتج;
}

// ---- diagnostics ----

// A diagnostic of reason السبب at token الرمز (its file, line, column and
// length); facts are added to it before شخص_ت_جسر records it.
عرف تشخيص_ع_جسر(ع: &معالج_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر): تشخيص_جسر {
    دع الملف: نص = انسخ_نص(&(*ع).الملفات[(*الرمز).الملف].المسار);
    دع الناتج: متغير تشخيص_جسر = تشخيص_جسر_في(السبب, &الملف, (*الرمز).السطر, (*الرمز).العمود, (*الرمز).الطول);
    الناتج.الملف_ف := (*الرمز).الملف + 1;
    أرجع الناتج;
}

عرف شخص_ت_جسر(ع: &متغير معالج_جسر, التشخيص: تشخيص_جسر): فراغ {
    أضف_تشخيص_جسر(&متغير (*ع).التشخيصات, التشخيص);
}

عرف شخص_جسر(ع: &متغير معالج_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر): فراغ {
    شخص_ت_جسر(ع, تشخيص_ع_جسر(ع, السبب, الرمز));
}

// With the identifier or macro name الاسم as written (الرمز).
عرف شخص_رمز_جسر(ع: &متغير معالج_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر, الاسم: نص): فراغ {
    دع ت: متغير تشخيص_جسر = تشخيص_ع_جسر(ع, السبب, الرمز);
    أضف_رمز_سي(&متغير ت.السجل, الاسم);
    شخص_ت_جسر(ع, ت);
}

// With a literal text (القيمة): #error's message, a pasted spelling, bytes.
عرف شخص_قيمة_جسر(ع: &متغير معالج_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر, القيمة: نص): فراغ {
    دع ت: متغير تشخيص_جسر = تشخيص_ع_جسر(ع, السبب, الرمز);
    أضف_قيمة_سي(&متغير ت.السجل, القيمة);
    شخص_ت_جسر(ع, ت);
}

// With an include path as written (المسار).
عرف شخص_مسار_جسر(ع: &متغير معالج_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر, المسار: نص): فراغ {
    دع ت: متغير تشخيص_جسر = تشخيص_ع_جسر(ع, السبب, الرمز);
    أضف_مسار_سي(&متغير ت.السجل, المسار);
    شخص_ت_جسر(ع, ت);
}

// The #include sites that brought file الملف_ف (index + 1) in, innermost
// first (the first #include of each file).
عام عرف سلسلة_تضمين_جسر(ع: &معالج_جسر, الملف_ف: طبيعي): متجه موقع_سي {
    دع الناتج: متغير متجه موقع_سي = [];
    دع الحالي: متغير طبيعي = الملف_ف;
    دع العمق: متغير طبيعي = 0;
    طالما (الحالي > 0 && الحالي <= (الطول((*ع).الملفات) مثل طبيعي) && العمق < 200) {
        دع الملف: &ملف_جسر = &(*ع).الملفات[الحالي - 1];
        إذا ((*الملف).المضمن_من == 0) { اخرج_من_حلقة; };
        دع الموقع: رمز_جسر = (*الملف).موقع_التضمين;
        دع المضمن: نص = انسخ_نص(&(*ع).الملفات[(*الملف).المضمن_من - 1].المسار);
        ألحق(الناتج, موقع_سي_جديد(المضمن, الموقع.السطر, الموقع.العمود, الموقع.الطول, «»));
        الحالي := (*الملف).المضمن_من;
        العمق := العمق + 1;
    }
    أرجع الناتج;
}

عرف اسم_جسر(ع: &معالج_جسر, المعرف: طبيعي): نص { أرجع نص_معرف_جسر(&(*ع).المخزن, المعرف); }

// ---- the macro table ----

عرف ماكرو_لمعرف_جسر(ع: &معالج_جسر, المعرف: طبيعي): طبيعي {
    إذا (المعرف >= (الطول((*ع).ماكرو_المعرف) مثل طبيعي)) { أرجع 0; };
    أرجع (*ع).ماكرو_المعرف[المعرف];
}

عرف اضبط_ماكرو_جسر(ع: &متغير معالج_جسر, المعرف: طبيعي, القيمة: طبيعي): فراغ {
    طالما ((الطول((*ع).ماكرو_المعرف) مثل طبيعي) <= المعرف) { ألحق((*ع).ماكرو_المعرف, 0); }
    (*ع).ماكرو_المعرف[المعرف] := القيمة;
}

عام عرف ماكرو_معرف_جسر(ع: &معالج_جسر, المعرف: طبيعي): منطقي { أرجع ماكرو_لمعرف_جسر(ع, المعرف) != 0; }

عرف أضف_ماكرو_مدمجا_جسر(ع: &متغير معالج_جسر, الاسم: نص, المدمج: ط8, دالي: منطقي): فراغ {
    دع المعرف: طبيعي = اعزل_نص_جسر(&متغير (*ع).المخزن, &الاسم);
    دع المعاملات: متجه طبيعي = [];
    دع الجسم: متجه رمز_جسر = [];
    دع الماكرو: ماكرو_جسر = {
        الاسم: المعرف, دالي: دالي, متغير_المعاملات: خطأ, المعاملات: المعاملات, الجسم: الجسم,
        المدمج: المدمج, الملف: 0, السطر: 0, العمود: 0
    };
    ألحق((*ع).الماكروهات, الماكرو);
    اضبط_ماكرو_جسر(ع, المعرف, الطول((*ع).الماكروهات) مثل طبيعي);
}

عرف عرف_مدمجات_جسر(ع: &متغير معالج_جسر): فراغ {
    أضف_ماكرو_مدمجا_جسر(ع, «__FILE__», 1, خطأ);
    أضف_ماكرو_مدمجا_جسر(ع, «__LINE__», 2, خطأ);
    أضف_ماكرو_مدمجا_جسر(ع, «__COUNTER__», 3, خطأ);
    أضف_ماكرو_مدمجا_جسر(ع, «__INCLUDE_LEVEL__», 4, خطأ);
    أضف_ماكرو_مدمجا_جسر(ع, «__BASE_FILE__», 5, خطأ);
    أضف_ماكرو_مدمجا_جسر(ع, «__DATE__», 6, خطأ);
    أضف_ماكرو_مدمجا_جسر(ع, «__TIME__», 7, خطأ);
    أضف_ماكرو_مدمجا_جسر(ع, «__TIMESTAMP__», 8, خطأ);
    أضف_ماكرو_مدمجا_جسر(ع, «_Pragma», 9, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_include», 20, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_include_next», 21, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_attribute», 22, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_builtin», 23, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_feature», 24, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_extension», 25, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_c_attribute», 26, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_cpp_attribute», 27, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_declspec_attribute», 28, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_warning», 29, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__is_identifier», 30, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__is_target_arch», 31, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__is_target_vendor», 32, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__is_target_os», 33, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__is_target_environment», 34, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__has_embed», 35, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__is_target_variant_os», 35, صواب);
    أضف_ماكرو_مدمجا_جسر(ع, «__is_target_variant_environment», 36, صواب);
}

// ---- files ----

عرف ملف_موجود_جسر(المسار: &نص): منطقي {
    طابق حاول_نوع_المسار(المسار) مع
    | نتيجة.نجح(نوع_مسار.ملف) -> { أرجع صواب; }
    | نتيجة.نجح(نوع_مسار.وصلة_رمزية) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether المسار is under the family root (or is the imported file).
عرف عائلي_جسر(ع: &معالج_جسر, المسار: &نص): منطقي {
    إذا (نصان_متساويان(المسار, &(*ع).الرئيسي)) { أرجع صواب; };
    // The builtin headers are the compiler's part of the system headers:
    // written for an import of a system header, not of a project's.
    إذا (يبدأ_بـ(المسار, &«<jisr>/»)) {
        دع ف: متغير طبيعي = (*ع).عدد_المستخدم;
        طالما (ف < (الطول((*ع).البحث) مثل طبيعي)) {
            إذا (نصان_متساويان(&(*ع).البحث[ف], &(*ع).الجذر)) { أرجع صواب; };
            ف := ف + 1;
        }
        أرجع خطأ;
    };
    دع الجذر: &نص = &(*ع).الجذر;
    دع ن: طبيعي = الطول(*الجذر) مثل طبيعي;
    إذا (ن == 0 || (الطول(*المسار) مثل طبيعي) <= ن + 1) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        إذا ((*المسار)[ف] != (*الجذر)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع (*المسار)[ن] == 0x2F || (ن == 1 && (*الجذر)[0] == 0x2F);
}

// The index of the file at المسار, lexed on first use; none when it
// cannot be read.
عرف افتح_ملف_جسر(ع: &متغير معالج_جسر, المسار: &نص, مدخل_البحث: طبيعي): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*ع).الملفات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*ع).الملفات[ف].المسار, المسار)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    دع المحتوى: متغير نص = «»;
    إذا (يبدأ_بـ(المسار, &«<jisr>/»)) {
        دع الاسم: متغير نص = «»;
        إذا ((الطول(*المسار) مثل طبيعي) > (7)) {
            طابق مقطع_نص(المسار, 7, (الطول(*المسار) مثل طبيعي) - (7)) مع
            | اختياري.موجود(المقطع_ن) -> { الاسم := المقطع_ن; }
            | اختياري.لا_شيء -> { الاسم := «»; };
        };
        طابق رأس_مدمج_جسر(&الاسم) مع
        | اختياري.موجود(النص) -> { المحتوى := النص; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    } وإلا {
        طابق اقرأ_الملف(المسار) مع
        | نتيجة.نجح(النص) -> { المحتوى := النص; }
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    };
    دع الفهرس: طبيعي = الطول((*ع).الملفات) مثل طبيعي;
    دع الرموز: متغير متجه رمز_جسر = [];
    اقطع_جسر(&متغير (*ع).المخزن, &المحتوى, الفهرس, المسار, &متغير الرموز, &متغير (*ع).التشخيصات);
    دع العائلي: منطقي = عائلي_جسر(ع, المسار);
    دع الملف: ملف_جسر = {
        المسار: انسخ_نص(المسار), الدليل: دليل_مسار_جسر(المسار), مدخل_البحث: مدخل_البحث,
        عائلي: العائلي, مرة_واحدة: خطأ, مدخول: خطأ, مقطع: صواب, الحارس: 0, الرموز: الرموز,
        المضمن_من: 0, موقع_التضمين: رمز_نهاية_جسر()
    };
    ألحق((*ع).الملفات, الملف);
    (*ع).الملفات[الفهرس].الحارس := حارس_ملف_جسر(ع, الفهرس);
    أرجع اختياري.موجود(الفهرس);
}

// Text the driver supplies as a file (the predefined macros).
عام عرف أضف_ملفا_نصيا_جسر(ع: &متغير معالج_جسر, المسار: نص, المحتوى: &نص): طبيعي {
    دع الفهرس: طبيعي = الطول((*ع).الملفات) مثل طبيعي;
    دع الرموز: متغير متجه رمز_جسر = [];
    اقطع_جسر(&متغير (*ع).المخزن, المحتوى, الفهرس, &المسار, &متغير الرموز, &متغير (*ع).التشخيصات);
    دع الملف: ملف_جسر = {
        المسار: المسار, الدليل: «.», مدخل_البحث: 0, عائلي: خطأ, مرة_واحدة: خطأ, مدخول: خطأ,
        مقطع: صواب, الحارس: 0, الرموز: الرموز, المضمن_من: 0, موقع_التضمين: رمز_نهاية_جسر()
    };
    ألحق((*ع).الملفات, الملف);
    أرجع الفهرس;
}

عرف رمز_ملف_جسر(ع: &معالج_جسر, الملف: طبيعي, الموضع: طبيعي): رمز_جسر {
    أرجع (*ع).الملفات[الملف].الرموز[الموضع];
}

عرف عدد_رموز_ملف_جسر(ع: &معالج_جسر, الملف: طبيعي): طبيعي {
    أرجع الطول((*ع).الملفات[الملف].الرموز) مثل طبيعي;
}

// The end of the directive line starting at البداية (the index of the
// next token that starts a line).
عرف نهاية_سطر_جسر(ع: &معالج_جسر, الملف: طبيعي, البداية: طبيعي): طبيعي {
    دع ن: طبيعي = عدد_رموز_ملف_جسر(ع, الملف);
    دع ف: متغير طبيعي = البداية + 1;
    طالما (ف < ن && ((*ع).الملفات[الملف].الرموز[ف].الأعلام & 1) == 0) { ف := ف + 1; }
    أرجع ف;
}

عرف توجيه_عند_جسر(ع: &معالج_جسر, الملف: طبيعي, ف: طبيعي): منطقي {
    دع ر: رمز_جسر = رمز_ملف_جسر(ع, الملف, ف);
    أرجع ر.الصنف == 5 && ر.المعرف == (*ع).ك.ك_hash && (ر.الأعلام & 1) != 0;
}

// The guard macro of a file shaped `#ifndef X ... #endif` (or
// `#if !defined X`) with nothing outside, else 0.
عرف حارس_ملف_جسر(ع: &معالج_جسر, الملف: طبيعي): طبيعي {
    دع ن: طبيعي = عدد_رموز_ملف_جسر(ع, الملف);
    إذا (ن < 4 || !توجيه_عند_جسر(ع, الملف, 0)) { أرجع 0; };
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    دع الاسم: متغير طبيعي = 0;
    دع أول: رمز_جسر = رمز_ملف_جسر(ع, الملف, 1);
    إذا (أول.المعرف == ك.ك_ifndef && رمز_ملف_جسر(ع, الملف, 2).الصنف == 1) {
        الاسم := رمز_ملف_جسر(ع, الملف, 2).المعرف;
    } وإلا إذا (أول.المعرف == ك.ك_if && ن > 5 && رمز_ملف_جسر(ع, الملف, 2).المعرف == اعزل_علامة_ثابتة_جسر(ع, 0x21)
        && رمز_ملف_جسر(ع, الملف, 3).المعرف == ك.ك_defined) {
        دع ت: رمز_جسر = رمز_ملف_جسر(ع, الملف, 4);
        إذا (ت.الصنف == 1) { الاسم := ت.المعرف; }
        وإلا إذا (ت.المعرف == ك.ك_lparen && رمز_ملف_جسر(ع, الملف, 5).الصنف == 1) { الاسم := رمز_ملف_جسر(ع, الملف, 5).المعرف; };
    };
    إذا (الاسم == 0) { أرجع 0; };
    // The #if line must be the only one at depth 0 until the last #endif.
    دع العمق: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        إذا (توجيه_عند_جسر(ع, الملف, ف) && ف + 1 < ن) {
            دع م: طبيعي = رمز_ملف_جسر(ع, الملف, ف + 1).المعرف;
            دع النهاية: طبيعي = نهاية_سطر_جسر(ع, الملف, ف);
            إذا (م == ك.ك_if || م == ك.ك_ifdef || م == ك.ك_ifndef) { العمق := العمق + 1; }
            وإلا إذا (م == ك.ك_endif) {
                إذا (العمق == 0) { أرجع 0; };
                العمق := العمق - 1;
                إذا (العمق == 0) { إذا (النهاية == ن) { أرجع الاسم; }; أرجع 0; };
            } وإلا إذا ((م == ك.ك_else || م == ك.ك_elif || م == ك.ك_elifdef || م == ك.ك_elifndef) && العمق == 1) {
                أرجع 0;
            };
            ف := النهاية;
            تابع_حلقة;
        };
        إذا (العمق == 0) { أرجع 0; };
        ف := ف + 1;
    }
    أرجع 0;
}

عرف اعزل_علامة_ثابتة_جسر(ع: &معالج_جسر, البايت: ط8): طبيعي {
    دع البايتات: متجه ط8 = [البايت];
    دع النص: نص = البايتات مثل نص;
    أرجع ابحث_نص_جسر(&(*ع).المخزن, &النص);
}

// ---- reading tokens ----

// The next token of the input before expansion: the pending stack, then
// (when reading from the files) the current file, whose directives are
// carried out here. عبر: whether the end of a file may be crossed (not
// while collecting a macro call's arguments).
عرف رمز_خام_جسر(ع: &متغير معالج_جسر, عبر: منطقي): رمز_جسر {
    طالما (صواب) {
        دع ن_م: طبيعي = الطول((*ع).المعلقة) مثل طبيعي;
        إذا (ن_م > 0) {
            دع الرمز: رمز_جسر = (*ع).المعلقة[ن_م - 1];
            دع المحذوف: اختياري رمز_جسر = أزل_الأخير((*ع).المعلقة);
            أرجع الرمز;
        };
        إذا (!(*ع).من_الملفات) { أرجع رمز_نهاية_جسر(); };
        دع ن_إ: طبيعي = الطول((*ع).الإطارات) مثل طبيعي;
        إذا (ن_إ == 0) { أرجع رمز_نهاية_جسر(); };
        دع الإطار: إطار_جسر = (*ع).الإطارات[ن_إ - 1];
        إذا (الإطار.الموضع >= عدد_رموز_ملف_جسر(ع, الإطار.الملف)) {
            إذا (!عبر) { أرجع رمز_نهاية_جسر(); };
            أنه_ملفا_جسر(ع);
            تابع_حلقة;
        };
        دع الرمز: متغير رمز_جسر = رمز_ملف_جسر(ع, الإطار.الملف, الإطار.الموضع);
        إذا (الرمز.الصنف == 5 && الرمز.المعرف == (*ع).ك.ك_hash && (الرمز.الأعلام & 1) != 0) {
            // Also inside a macro call's arguments (a GNU extension).
            نفذ_توجيها_جسر(ع);
            تابع_حلقة;
        };
        (*ع).الإطارات[ن_إ - 1].الموضع := الإطار.الموضع + 1;
        إذا ((*ع).مسبق && الإطار.ملف_العلامة != 0) {
            الرمز.الملف := الإطار.ملف_العلامة;
            إذا (الرمز.السطر > الإطار.سطر_العلامة) {
                الرمز.السطر := الإطار.رقم_العلامة + (الرمز.السطر - الإطار.سطر_العلامة - 1);
            };
        };
        أرجع الرمز;
    }
    أرجع رمز_نهاية_جسر();
}

عرف أنه_ملفا_جسر(ع: &متغير معالج_جسر): فراغ {
    دع ن_إ: طبيعي = الطول((*ع).الإطارات) مثل طبيعي;
    دع الإطار: إطار_جسر = (*ع).الإطارات[ن_إ - 1];
    طالما ((الطول((*ع).الشروط) مثل طبيعي) > الإطار.عمق_الشروط) {
        دع ن_ش: طبيعي = الطول((*ع).الشروط) مثل طبيعي;
        دع الشرط: شرط_جسر = (*ع).الشروط[ن_ش - 1];
        دع الملف: نص = انسخ_نص(&(*ع).الملفات[الشرط.الملف].المسار);
        دع ت: متغير تشخيص_جسر = تشخيص_جسر_في(سبب_تشخيص.سبب_سي_شرطي_غير_منته(), &الملف, الشرط.السطر, الشرط.العمود, 0);
        ت.الملف_ف := الشرط.الملف + 1;
        أضف_تشخيص_جسر(&متغير (*ع).التشخيصات, ت);
        دع المحذوف: اختياري شرط_جسر = أزل_الأخير((*ع).الشروط);
    }
    دع المحذوف_إ: اختياري إطار_جسر = أزل_الأخير((*ع).الإطارات);
    طابق_المنظور_جسر(ع);
}

عرف ادفع_معلقا_جسر(ع: &متغير معالج_جسر, الرمز: رمز_جسر): فراغ { ألحق((*ع).المعلقة, الرمز); }

// Pushes الرموز so that its first token is read next.
عرف ادفع_قائمة_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر): فراغ {
    دع ف: متغير طبيعي = الطول(*الرموز) مثل طبيعي;
    طالما (ف > 0) {
        ف := ف - 1;
        ألحق((*ع).المعلقة, (*الرموز)[ف]);
    }
}

عرف هو_علامة_جسر(الرمز: &رمز_جسر, المعرف: طبيعي): منطقي {
    أرجع (*الرمز).الصنف == 5 && (*الرمز).المعرف == المعرف;
}

// ---- expansion ----

// The next fully macro-expanded token.
عرف رمز_موسع_جسر(ع: &متغير معالج_جسر): رمز_جسر {
    طالما (صواب) {
        دع الرمز: متغير رمز_جسر = رمز_خام_جسر(ع, صواب);
        إذا (الرمز.الصنف != 1 || (الرمز.الأعلام & 4) != 0 || (*ع).مسبق) { أرجع الرمز; };
        دع رقم: طبيعي = ماكرو_لمعرف_جسر(ع, الرمز.المعرف);
        إذا (رقم == 0) { أرجع الرمز; };
        دع الماكرو: طبيعي = رقم - 1;
        إذا ((*ع).وضع_الشرط && الرمز.المعرف == (*ع).ك.ك_defined) {
            احم_معامل_جسر(ع);
            أرجع الرمز;
        };
        إذا (تحوي_مخفية_جسر(&(*ع).المخفيات, الرمز.المخفية, الماكرو)) {
            الرمز.الأعلام := الرمز.الأعلام | 4;
            أرجع الرمز;
        };
        دع المدمج: ط8 = (*ع).الماكروهات[الماكرو].المدمج;
        إذا (المدمج >= 20) {
            إذا ((*ع).وضع_الشرط) { احم_معامل_جسر(ع); };
            أرجع الرمز;
        };
        إذا (المدمج == 9) {
            نفذ_براغما_مشغلا_جسر(ع, &الرمز);
            تابع_حلقة;
        };
        إذا (المدمج > 0) {
            أرجع رمز_مدمج_جسر(ع, &الرمز, المدمج);
        };
        إذا (!(*ع).الماكروهات[الماكرو].دالي) {
            دع الحجج: متجه رمز_جسر = [];
            دع الحدود: متجه طبيعي = [];
            دع المخفية: طبيعي = أضف_مخفية_جسر(&متغير (*ع).المخفيات, الرمز.المخفية, الماكرو);
            دع التوسيع: متجه رمز_جسر = عوض_جسر(ع, الماكرو, &الحجج, &الحدود, المخفية, &الرمز);
            ادفع_قائمة_جسر(ع, &التوسيع);
            تابع_حلقة;
        };
        // A function-like macro is called only when '(' follows.
        دع التالي: رمز_جسر = رمز_خام_جسر(ع, خطأ);
        إذا (!هو_علامة_جسر(&التالي, (*ع).ك.ك_lparen)) {
            إذا (التالي.الصنف != 0) { ادفع_معلقا_جسر(ع, التالي); };
            أرجع الرمز;
        };
        دع الحجج: متغير متجه رمز_جسر = [];
        دع الحدود: متغير متجه طبيعي = [];
        دع الإغلاق: رمز_جسر = اجمع_حججا_جسر(ع, الماكرو, &متغير الحجج, &متغير الحدود);
        إذا (الإغلاق.الصنف == 0) {
            شخص_رمز_جسر(ع, سبب_تشخيص.سبب_سي_نداء_ماكرو_غير_منته(), &الرمز, اسم_جسر(ع, الرمز.المعرف));
            أرجع الرمز;
        };
        إذا (!تحقق_عدد_الحجج_جسر(ع, الماكرو, &متغير الحدود, &الرمز)) { تابع_حلقة; };
        دع المشتركة: طبيعي = تقاطع_مخفية_جسر(&متغير (*ع).المخفيات, الرمز.المخفية, الإغلاق.المخفية);
        دع المخفية: طبيعي = أضف_مخفية_جسر(&متغير (*ع).المخفيات, المشتركة, الماكرو);
        دع التوسيع: متجه رمز_جسر = عوض_جسر(ع, الماكرو, &الحجج, &الحدود, المخفية, &الرمز);
        ادفع_قائمة_جسر(ع, &التوسيع);
    }
    أرجع رمز_نهاية_جسر();
}

// In a #if line: the operand of defined / __has_include (an identifier or
// a parenthesized group) is kept from expansion.
عرف احم_معامل_جسر(ع: &متغير معالج_جسر): فراغ {
    دع المحمية: متغير متجه رمز_جسر = [];
    دع التالي: متغير رمز_جسر = رمز_خام_جسر(ع, خطأ);
    إذا (هو_علامة_جسر(&التالي, (*ع).ك.ك_lparen)) {
        ألحق(المحمية, التالي);
        دع العمق: متغير طبيعي = 1;
        طالما (العمق > 0) {
            دع ر: متغير رمز_جسر = رمز_خام_جسر(ع, خطأ);
            إذا (ر.الصنف == 0) { اخرج_من_حلقة; };
            إذا (هو_علامة_جسر(&ر, (*ع).ك.ك_lparen)) { العمق := العمق + 1; };
            إذا (هو_علامة_جسر(&ر, (*ع).ك.ك_rparen)) { العمق := العمق - 1; };
            ر.الأعلام := ر.الأعلام | 4;
            ألحق(المحمية, ر);
        }
    } وإلا إذا (التالي.الصنف != 0) {
        التالي.الأعلام := التالي.الأعلام | 4;
        ألحق(المحمية, التالي);
    };
    ادفع_قائمة_جسر(ع, &المحمية);
}

// The arguments of a call whose '(' was read: tokens of all arguments in
// الحجج, each argument's start in الحدود (plus a final end). The result is
// the closing ')', or an end token when the list is unterminated.
عرف اجمع_حججا_جسر(ع: &متغير معالج_جسر, الماكرو: طبيعي, الحجج: &متغير متجه رمز_جسر, الحدود: &متغير متجه طبيعي): رمز_جسر {
    دع متغير_ع: منطقي = (*ع).الماكروهات[الماكرو].متغير_المعاملات;
    دع عدد_المعاملات: طبيعي = الطول((*ع).الماكروهات[الماكرو].المعاملات) مثل طبيعي;
    دع العمق: متغير طبيعي = 0;
    ألحق(*الحدود, 0);
    طالما (صواب) {
        دع الرمز: متغير رمز_جسر = رمز_خام_جسر(ع, خطأ);
        إذا (الرمز.الصنف == 0) { أرجع الرمز; };
        إذا (هو_علامة_جسر(&الرمز, (*ع).ك.ك_lparen)) { العمق := العمق + 1; }
        وإلا إذا (هو_علامة_جسر(&الرمز, (*ع).ك.ك_rparen)) {
            إذا (العمق == 0) {
                ألحق(*الحدود, الطول(*الحجج) مثل طبيعي);
                أرجع الرمز;
            };
            العمق := العمق - 1;
        } وإلا إذا (هو_علامة_جسر(&الرمز, (*ع).ك.ك_comma) && العمق == 0) {
            // The commas of the variadic part belong to __VA_ARGS__.
            دع المجموعة: طبيعي = الطول(*الحدود) مثل طبيعي;
            إذا (!(متغير_ع && المجموعة >= عدد_المعاملات)) {
                ألحق(*الحدود, الطول(*الحجج) مثل طبيعي);
                تابع_حلقة;
            };
        };
        // A line break inside the arguments is white space.
        إذا ((الرمز.الأعلام & 1) != 0) { الرمز.الأعلام := (الرمز.الأعلام & 0xFE) | 2; };
        ألحق(*الحجج, الرمز);
    }
    أرجع رمز_نهاية_جسر();
}

عرف تحقق_عدد_الحجج_جسر(ع: &متغير معالج_جسر, الماكرو: طبيعي, الحدود: &متغير متجه طبيعي, الرمز: &رمز_جسر): منطقي {
    دع المعطى: طبيعي = (الطول(*الحدود) مثل طبيعي) - 1;
    دع المعاملات: طبيعي = الطول((*ع).الماكروهات[الماكرو].المعاملات) مثل طبيعي;
    دع متغير_ع: منطقي = (*ع).الماكروهات[الماكرو].متغير_المعاملات;
    // `f()` is one empty argument: right for a macro of no parameter.
    إذا (المعاملات == 0 && المعطى == 1 && (*الحدود)[0] == (*الحدود)[1]) {
        اقتطع(*الحدود, 1);
        أرجع صواب;
    };
    إذا (المعطى == المعاملات) { أرجع صواب; };
    إذا (متغير_ع && المعطى + 1 == المعاملات) {
        // An omitted variadic part: an empty __VA_ARGS__.
        دع الأخير: طبيعي = (*الحدود)[المعطى];
        ألحق(*الحدود, الأخير);
        أرجع صواب;
    };
    دع ت: متغير تشخيص_جسر = تشخيص_ع_جسر(ع, سبب_تشخيص.سبب_سي_عدد_حجج_ماكرو(), الرمز);
    أضف_رمز_سي(&متغير ت.السجل, اسم_جسر(ع, (*الرمز).المعرف));
    أضف_عددين_سي(&متغير ت.السجل, المعاملات, المعطى);
    شخص_ت_جسر(ع, ت);
    أرجع خطأ;
}

// The index of parameter المعرف of the macro, or none.
عرف معامل_ماكرو_جسر(ع: &معالج_جسر, الماكرو: طبيعي, المعرف: طبيعي): اختياري طبيعي {
    دع المعاملات: &متجه طبيعي = &(*ع).الماكروهات[الماكرو].المعاملات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعاملات) مثل طبيعي)) {
        إذا ((*المعاملات)[ف] == المعرف) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف حجة_جسر(الحجج: &متجه رمز_جسر, الحدود: &متجه طبيعي, ف: طبيعي): متجه رمز_جسر {
    دع الناتج: متغير متجه رمز_جسر = [];
    دع ك: متغير طبيعي = (*الحدود)[ف];
    طالما (ك < (*الحدود)[ف + 1]) { ألحق(الناتج, (*الحجج)[ك]); ك := ك + 1; }
    أرجع الناتج;
}

// Fully expands a token list on its own (a macro argument, a #if line).
عام عرف وسع_معزولا_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر): متجه رمز_جسر {
    دع المحفوظة: متغير متجه رمز_جسر = [];
    بدّل(المحفوظة, (*ع).المعلقة);
    دع من_الملفات: منطقي = (*ع).من_الملفات;
    (*ع).من_الملفات := خطأ;
    ادفع_قائمة_جسر(ع, الرموز);
    دع الناتج: متغير متجه رمز_جسر = [];
    طالما (صواب) {
        دع الرمز: رمز_جسر = رمز_موسع_جسر(ع);
        إذا (الرمز.الصنف == 0) { اخرج_من_حلقة; };
        ألحق(الناتج, الرمز);
    }
    بدّل(المحفوظة, (*ع).المعلقة);
    (*ع).من_الملفات := من_الملفات;
    أرجع الناتج;
}

// The replacement list of a macro with its arguments substituted, # and
// ## applied, placemarkers removed, every token in المخفية and at the
// call's location.
عرف عوض_جسر(
    ع: &متغير معالج_جسر,
    الماكرو: طبيعي,
    الحجج: &متجه رمز_جسر,
    الحدود: &متجه طبيعي,
    المخفية: طبيعي,
    الاستدعاء: &رمز_جسر
): متجه رمز_جسر {
    دع الجسم: متجه رمز_جسر = جسم_ماكرو_جسر(ع, الماكرو);
    دع الناتج: متغير متجه رمز_جسر = [];
    عوض_مدى_جسر(ع, الماكرو, &الجسم, 0, الطول(الجسم) مثل طبيعي, الحجج, الحدود, &متغير الناتج);
    دع النهائي: متغير متجه رمز_جسر = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الناتج) مثل طبيعي)) {
        دع الرمز: متغير رمز_جسر = الناتج[ف];
        ف := ف + 1;
        إذا (الرمز.الصنف == 6) { تابع_حلقة; };
        الرمز.المخفية := اتحاد_مخفية_جسر(&متغير (*ع).المخفيات, الرمز.المخفية, المخفية);
        الرمز.الملف := (*الاستدعاء).الملف;
        الرمز.السطر := (*الاستدعاء).السطر;
        الرمز.العمود := (*الاستدعاء).العمود;
        إذا ((الطول(النهائي) مثل طبيعي) == 0) {
            الرمز.الأعلام := (الرمز.الأعلام & 0xFC) | ((*الاستدعاء).الأعلام & 3);
        } وإلا {
            الرمز.الأعلام := الرمز.الأعلام & 0xFE;
        };
        ألحق(النهائي, الرمز);
    }
    أرجع النهائي;
}

// Substitutes the body range [البداية, النهاية) into الناتج.
عرف عوض_مدى_جسر(
    ع: &متغير معالج_جسر,
    الماكرو: طبيعي,
    الجسم: &متجه رمز_جسر,
    البداية: طبيعي,
    النهاية: طبيعي,
    الحجج: &متجه رمز_جسر,
    الحدود: &متجه طبيعي,
    الناتج: &متغير متجه رمز_جسر
): فراغ {
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    دع دالي: منطقي = (*ع).الماكروهات[الماكرو].دالي;
    دع لصق: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع الرمز: رمز_جسر = (*الجسم)[ف];
        // ## between two operands (never first or last: checked at #define).
        إذا (هو_علامة_جسر(&الرمز, ك.ك_hashhash) && ف > البداية && ف + 1 < النهاية) {
            لصق := صواب;
            ف := ف + 1;
            تابع_حلقة;
        };
        دع القطعة: متغير متجه رمز_جسر = [];
        دع حجة_متغيرة_فارغة: متغير منطقي = خطأ;
        دع من_المتغيرة: متغير منطقي = خطأ;
        دع التالي_لصق: منطقي = ف + 1 < النهاية && هو_علامة_جسر(&(*الجسم)[ف + 1], ك.ك_hashhash);
        إذا (دالي && هو_علامة_جسر(&الرمز, ك.ك_hash) && ف + 1 < النهاية && (*الجسم)[ف + 1].الصنف == 1) {
            طابق معامل_ماكرو_جسر(ع, الماكرو, (*الجسم)[ف + 1].المعرف) مع
            | اختياري.موجود(م) -> {
                دع الحجة: متجه رمز_جسر = حجة_جسر(الحجج, الحدود, م);
                ألحق(القطعة, حول_إلى_نص_جسر(ع, &الحجة, &الرمز));
                ف := ف + 2;
            }
            | اختياري.لا_شيء -> {
                ألحق(القطعة, الرمز);
                ف := ف + 1;
            };
        } وإلا إذا (دالي && الرمز.الصنف == 1 && الرمز.المعرف == ك.ك_va_opt && (*ع).الماكروهات[الماكرو].متغير_المعاملات
            && ف + 1 < النهاية && هو_علامة_جسر(&(*الجسم)[ف + 1], ك.ك_lparen)) {
            // __VA_OPT__(content): the content when __VA_ARGS__ has tokens.
            دع العمق: متغير طبيعي = 0;
            دع ي: متغير طبيعي = ف + 1;
            طالما (ي < النهاية) {
                إذا (هو_علامة_جسر(&(*الجسم)[ي], ك.ك_lparen)) { العمق := العمق + 1; };
                إذا (هو_علامة_جسر(&(*الجسم)[ي], ك.ك_rparen)) {
                    العمق := العمق - 1;
                    إذا (العمق == 0) { اخرج_من_حلقة; };
                };
                ي := ي + 1;
            }
            دع الأخيرة: طبيعي = (الطول(*الحدود) مثل طبيعي) - 2;
            إذا ((*الحدود)[الأخيرة + 1] > (*الحدود)[الأخيرة]) {
                عوض_مدى_جسر(ع, الماكرو, الجسم, ف + 2, ي, الحجج, الحدود, &متغير القطعة);
            };
            ف := ي + 1;
        } وإلا إذا (دالي && الرمز.الصنف == 1) {
            طابق معامل_ماكرو_جسر(ع, الماكرو, الرمز.المعرف) مع
            | اختياري.موجود(م) -> {
                دع الحجة: متجه رمز_جسر = حجة_جسر(الحجج, الحدود, م);
                إذا (لصق || التالي_لصق) {
                    القطعة := الحجة;
                } وإلا {
                    القطعة := وسع_معزولا_جسر(ع, &الحجة);
                };
                // The variadic parameter: __VA_ARGS__ or GNU's named `args...`.
                دع متغيرة: منطقي = (*ع).الماكروهات[الماكرو].متغير_المعاملات
                    && م + 1 == (الطول((*ع).الماكروهات[الماكرو].المعاملات) مثل طبيعي);
                إذا (متغيرة) { من_المتغيرة := صواب; };
                إذا ((الطول(القطعة) مثل طبيعي) == 0 && متغيرة) { حجة_متغيرة_فارغة := صواب; };
                إذا ((الطول(القطعة) مثل طبيعي) > 0) {
                    // The argument's first token takes the parameter's spacing.
                    القطعة[0].الأعلام := (القطعة[0].الأعلام & 0xFC) | (الرمز.الأعلام & 2);
                };
            }
            | اختياري.لا_شيء -> { ألحق(القطعة, الرمز); };
            ف := ف + 1;
        } وإلا {
            ألحق(القطعة, الرمز);
            ف := ف + 1;
        };
        إذا (لصق) {
            لصق := خطأ;
            دع ن: طبيعي = الطول(*الناتج) مثل طبيعي;
            إذا ((الطول(القطعة) مثل طبيعي) == 0) {
                // GNU: `, ## __VA_ARGS__` drops the comma when it is empty.
                إذا (حجة_متغيرة_فارغة && ن > 0 && هو_علامة_جسر(&(*الناتج)[ن - 1], ك.ك_comma)) {
                    دع المحذوف: اختياري رمز_جسر = أزل_الأخير(*الناتج);
                };
                تابع_حلقة;
            };
            إذا (ن == 0 || (*الناتج)[ن - 1].الصنف == 6) {
                إذا (ن > 0) { دع المحذوف: اختياري رمز_جسر = أزل_الأخير(*الناتج); };
                ألحق_كل_جسر(الناتج, &القطعة);
                تابع_حلقة;
            };
            // GNU: `, ## __VA_ARGS__` with arguments keeps both, unpasted.
            إذا (من_المتغيرة && هو_علامة_جسر(&(*الناتج)[ن - 1], ك.ك_comma)) {
                ألحق_كل_جسر(الناتج, &القطعة);
                تابع_حلقة;
            };
            دع اليسار: رمز_جسر = (*الناتج)[ن - 1];
            دع المحذوف: اختياري رمز_جسر = أزل_الأخير(*الناتج);
            دع الملصق: متجه رمز_جسر = الصق_جسر(ع, &اليسار, &القطعة[0]);
            ألحق_كل_جسر(الناتج, &الملصق);
            دع ي: متغير طبيعي = 1;
            طالما (ي < (الطول(القطعة) مثل طبيعي)) { ألحق(*الناتج, القطعة[ي]); ي := ي + 1; }
            تابع_حلقة;
        };
        إذا ((الطول(القطعة) مثل طبيعي) == 0 && التالي_لصق) {
            // A placemarker, so that ## has an operand.
            ألحق(*الناتج, رمز_جسر_من(6, 0, 0, 0, 0, 0));
            تابع_حلقة;
        };
        ألحق_كل_جسر(الناتج, &القطعة);
    }
}

// A copy of a macro's replacement list.
عرف جسم_ماكرو_جسر(ع: &معالج_جسر, الماكرو: طبيعي): متجه رمز_جسر {
    دع الناتج: متغير متجه رمز_جسر = [];
    ألحق_كل_جسر(&متغير الناتج, &(*ع).الماكروهات[الماكرو].الجسم);
    أرجع الناتج;
}

عرف ألحق_كل_جسر(الهدف: &متغير متجه رمز_جسر, المصدر: &متجه رمز_جسر): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) { ألحق(*الهدف, (*المصدر)[ف]); ف := ف + 1; }
}

// # applied to an argument: one string literal of its spelling.
عرف حول_إلى_نص_جسر(ع: &متغير معالج_جسر, الحجة: &متجه رمز_جسر, الموقع: &رمز_جسر): رمز_جسر {
    دع البايتات: متغير متجه ط8 = [0x22];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحجة) مثل طبيعي)) {
        دع الرمز: رمز_جسر = (*الحجة)[ف];
        إذا (ف > 0 && (الرمز.الأعلام & 3) != 0) { ألحق(البايتات, 0x20); };
        دع حرفي: منطقي = الرمز.الصنف == 3 || الرمز.الصنف == 4;
        دع ن: طبيعي = طول_معرف_جسر(&(*ع).المخزن, الرمز.المعرف);
        دع ك: متغير طبيعي = 0;
        طالما (ك < ن) {
            دع ب: ط8 = بايت_معرف_جسر(&(*ع).المخزن, الرمز.المعرف, ك);
            إذا (حرفي && (ب == 0x22 || ب == 0x5C)) { ألحق(البايتات, 0x5C); };
            ألحق(البايتات, ب);
            ك := ك + 1;
        }
        ف := ف + 1;
    }
    ألحق(البايتات, 0x22);
    دع المعرف: طبيعي = اعزل_بايتات_جسر(&متغير (*ع).المخزن, &البايتات);
    أرجع رمز_جسر_من(3, المعرف, (*الموقع).الملف, (*الموقع).السطر, (*الموقع).العمود, (*الموقع).الأعلام & 2);
}

// ## of two tokens: their spellings joined and lexed again; one token when
// the result is one, else both (with an error).
عرف الصق_جسر(ع: &متغير معالج_جسر, اليسار: &رمز_جسر, اليمين: &رمز_جسر): متجه رمز_جسر {
    دع البايتات: متغير متجه ط8 = [];
    ألحق_معرف_جسر(&(*ع).المخزن, (*اليسار).المعرف, &متغير البايتات);
    ألحق_معرف_جسر(&(*ع).المخزن, (*اليمين).المعرف, &متغير البايتات);
    دع النص: نص = البايتات مثل نص;
    دع الرموز: متغير متجه رمز_جسر = [];
    دع تشخيصات: متغير متجه تشخيص_جسر = [];
    دع المسار: نص = «»;
    اقطع_جسر(&متغير (*ع).المخزن, &النص, (*اليسار).الملف, &المسار, &متغير الرموز, &متغير تشخيصات);
    دع الناتج: متغير متجه رمز_جسر = [];
    إذا ((الطول(الرموز) مثل طبيعي) == 1) {
        دع الرمز: متغير رمز_جسر = الرموز[0];
        الرمز.الملف := (*اليسار).الملف;
        الرمز.السطر := (*اليسار).السطر;
        الرمز.العمود := (*اليسار).العمود;
        الرمز.الأعلام := (*اليسار).الأعلام;
        الرمز.المخفية := (*اليسار).المخفية;
        ألحق(الناتج, الرمز);
        أرجع الناتج;
    };
    إذا ((الطول(الرموز) مثل طبيعي) == 0) { أرجع الناتج; };
    شخص_قيمة_جسر(ع, سبب_تشخيص.سبب_سي_لصق_غير_صالح(), اليسار, النص);
    ألحق(الناتج, *اليسار);
    ألحق(الناتج, *اليمين);
    أرجع الناتج;
}

// __FILE__, __LINE__ and the other builtin macros.
عرف رمز_مدمج_جسر(ع: &متغير معالج_جسر, الرمز: &رمز_جسر, المدمج: ط8): رمز_جسر {
    دع الصنف: متغير ط8 = 3;
    دع النص: متغير نص = «»;
    إذا (المدمج == 1 || المدمج == 5) {
        دع المسار: متغير نص = انسخ_نص(&(*ع).الملفات[(*الرمز).الملف].المسار);
        إذا (المدمج == 5) { المسار := انسخ_نص(&(*ع).الرئيسي); };
        دع البايتات: متغير متجه ط8 = [0x22];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المسار) مثل طبيعي)) {
            إذا (المسار[ف] == 0x22 || المسار[ف] == 0x5C) { ألحق(البايتات, 0x5C); };
            ألحق(البايتات, المسار[ف]);
            ف := ف + 1;
        }
        ألحق(البايتات, 0x22);
        النص := البايتات مثل نص;
    } وإلا إذا (المدمج == 2) {
        الصنف := 2;
        النص := طبيعي_إلى_نص((*الرمز).السطر);
    } وإلا إذا (المدمج == 3) {
        الصنف := 2;
        النص := طبيعي_إلى_نص((*ع).العداد);
        (*ع).العداد := (*ع).العداد + 1;
    } وإلا إذا (المدمج == 4) {
        الصنف := 2;
        دع العمق: طبيعي = الطول((*ع).الإطارات) مثل طبيعي;
        إذا (العمق > 0) { النص := طبيعي_إلى_نص(العمق - 1); } وإلا { النص := «0»; };
    } وإلا إذا (المدمج == 6) {
        النص := «"Jan  1 1970"»;
    } وإلا إذا (المدمج == 7) {
        النص := «"00:00:00"»;
    } وإلا {
        النص := «"Thu Jan  1 00:00:00 1970"»;
    };
    دع المعرف: طبيعي = اعزل_نص_جسر(&متغير (*ع).المخزن, &النص);
    دع الناتج: متغير رمز_جسر = *الرمز;
    الناتج.الصنف := الصنف;
    الناتج.المعرف := المعرف;
    أرجع الناتج;
}

// _Pragma("..."): the string's contents are a #pragma line.
عرف نفذ_براغما_مشغلا_جسر(ع: &متغير معالج_جسر, الرمز: &رمز_جسر): فراغ {
    دع الفتح: رمز_جسر = رمز_موسع_جسر(ع);
    دع النص_ر: رمز_جسر = رمز_موسع_جسر(ع);
    دع الإغلاق: رمز_جسر = رمز_موسع_جسر(ع);
    إذا (!هو_علامة_جسر(&الفتح, (*ع).ك.ك_lparen) || النص_ر.الصنف != 3 || !هو_علامة_جسر(&الإغلاق, (*ع).ك.ك_rparen)) {
        شخص_جسر(ع, سبب_تشخيص.سبب_سي_عامل_براغما_غير_صالح(), الرمز);
        أرجع;
    };
    دع الحرفي: نص = اسم_جسر(ع, النص_ر.المعرف);
    دع المفكوك: حرفي_مفكوك_جسر = فك_حرفي_جسر(&الحرفي);
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المفكوك.الوحدات) مثل طبيعي)) { ألحق(البايتات, (المفكوك.الوحدات[ف] & 0xFF) مثل ط8); ف := ف + 1; }
    دع النص: نص = البايتات مثل نص;
    دع الرموز: متغير متجه رمز_جسر = [];
    دع المسار: نص = «»;
    اقطع_جسر(&متغير (*ع).المخزن, &النص, (*الرمز).الملف, &المسار, &متغير الرموز, &متغير (*ع).التشخيصات);
    نفذ_براغما_جسر(ع, &الرموز, 0, الطول(الرموز) مثل طبيعي, الرمز);
}

// ---- directives ----

// The directive at the current file position (its '#').
عرف نفذ_توجيها_جسر(ع: &متغير معالج_جسر): فراغ {
    دع ن_إ: طبيعي = الطول((*ع).الإطارات) مثل طبيعي;
    دع الإطار: إطار_جسر = (*ع).الإطارات[ن_إ - 1];
    دع الملف: طبيعي = الإطار.الملف;
    دع البداية: طبيعي = الإطار.الموضع;
    دع النهاية: طبيعي = نهاية_سطر_جسر(ع, الملف, البداية);
    (*ع).الإطارات[ن_إ - 1].الموضع := النهاية;
    دع الرموز: متغير متجه رمز_جسر = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع الرمز: متغير رمز_جسر = رمز_ملف_جسر(ع, الملف, ف);
        // Preprocessed text: a #define belongs to the file of the last line
        // marker.
        إذا ((*ع).مسبق && الإطار.ملف_العلامة != 0) {
            الرمز.الملف := الإطار.ملف_العلامة;
            إذا (الرمز.السطر > الإطار.سطر_العلامة) {
                الرمز.السطر := الإطار.رقم_العلامة + (الرمز.السطر - الإطار.سطر_العلامة - 1);
            };
        };
        ألحق(الرموز, الرمز);
        ف := ف + 1;
    }
    إذا ((الطول(الرموز) مثل طبيعي) < 2) { أرجع; };
    دع الاسم: رمز_جسر = الرموز[1];
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    دع ن: طبيعي = الطول(الرموز) مثل طبيعي;
    إذا (الاسم.الصنف == 2) {
        // `# 33 "file" flags` (a line marker of preprocessed text).
        إذا ((*ع).مسبق && ن >= 3 && الرموز[2].الصنف == 3) {
            علامة_سطر_جسر(ع, &الرموز, ن_إ - 1, رمز_ملف_جسر(ع, الملف, البداية).السطر);
        };
        أرجع;
    };
    إذا (الاسم.الصنف != 1) {
        شخص_جسر(ع, سبب_تشخيص.سبب_سي_توجيه_غير_صالح(), &الاسم);
        أرجع;
    };
    دع م: طبيعي = الاسم.المعرف;
    إذا (م == ك.ك_define) { عرف_ماكرو_جسر(ع, &الرموز); أرجع; };
    إذا (م == ك.ك_undef) {
        إذا (ن >= 3 && الرموز[2].الصنف == 1) {
            إذا (الرموز[2].المعرف == ك.ك_defined) {
                شخص_جسر(ع, سبب_تشخيص.سبب_سي_إلغاء_تعريف_المعرف_المحجوز(), &الرموز[2]);
                أرجع;
            };
            اضبط_ماكرو_جسر(ع, الرموز[2].المعرف, 0);
        } وإلا {
            شخص_جسر(ع, سبب_تشخيص.سبب_سي_اسم_ماكرو_ليس_معرفا(), &الاسم);
        };
        أرجع;
    };
    إذا (م == ك.ك_embed) {
        إذا ((*ع).مسبق) { أرجع; };
        ضمن_بيانات_جسر(ع, &الرموز);
        أرجع;
    };
    إذا (م == ك.ك_include || م == ك.ك_include_next || م == ك.ك_import) {
        إذا ((*ع).مسبق) { أرجع; };
        ضمن_جسر(ع, &الرموز, م == ك.ك_include_next, م == ك.ك_import);
        أرجع;
    };
    إذا (م == ك.ك_if || م == ك.ك_ifdef || م == ك.ك_ifndef) {
        دع القيمة: منطقي = قيم_شرط_توجيه_جسر(ع, &الرموز);
        دع الشرط: شرط_جسر = { مأخوذ: القيمة, في_وإلا: خطأ, الملف: الاسم.الملف, السطر: الاسم.السطر, العمود: الاسم.العمود };
        ألحق((*ع).الشروط, الشرط);
        إذا (!القيمة) { تخط_إلى_فرع_جسر(ع); };
        أرجع;
    };
    إذا (م == ك.ك_elif || م == ك.ك_elifdef || م == ك.ك_elifndef || م == ك.ك_else) {
        // The group before was taken: the rest of the conditional is skipped.
        إذا ((الطول((*ع).الشروط) مثل طبيعي) <= الإطار.عمق_الشروط) {
            شخص_جسر(ع, سبب_تشخيص.سبب_سي_وإلا_بلا_إذا(), &الاسم);
            أرجع;
        };
        إذا (م == ك.ك_else) {
            دع ن_ش: طبيعي = الطول((*ع).الشروط) مثل طبيعي;
            إذا ((*ع).الشروط[ن_ش - 1].في_وإلا) {
                شخص_جسر(ع, سبب_تشخيص.سبب_سي_وإلا_بعد_وإلا(), &الاسم);
            };
            (*ع).الشروط[ن_ش - 1].في_وإلا := صواب;
        };
        تخط_إلى_النهاية_جسر(ع);
        أرجع;
    };
    إذا (م == ك.ك_endif) {
        إذا ((الطول((*ع).الشروط) مثل طبيعي) <= الإطار.عمق_الشروط) {
            شخص_جسر(ع, سبب_تشخيص.سبب_سي_نهاية_بلا_إذا(), &الاسم);
            أرجع;
        };
        دع المحذوف: اختياري شرط_جسر = أزل_الأخير((*ع).الشروط);
        أرجع;
    };
    إذا (م == ك.ك_error || م == ك.ك_warning) {
        دع الرسالة: نص = نص_رموز_جسر(ع, &الرموز, 2, ن);
        إذا (م == ك.ك_error) {
            شخص_قيمة_جسر(ع, سبب_تشخيص.سبب_سي_توجيه_خطأ(), &الاسم, الرسالة);
        } وإلا {
            شخص_قيمة_جسر(ع, سبب_تشخيص.سبب_سي_توجيه_تحذير(), &الاسم, الرسالة);
        };
        أرجع;
    };
    إذا (م == ك.ك_pragma) {
        نفذ_براغما_جسر(ع, &الرموز, 2, ن, &الاسم);
        أرجع;
    };
    إذا (م == ك.ك_line || م == ك.ك_ident || م == ك.ك_sccs || م == ك.ك_assert || م == ك.ك_unassert) { أرجع; };
    شخص_رمز_جسر(ع, سبب_تشخيص.سبب_سي_توجيه_غير_صالح(), &الاسم, اسم_جسر(ع, م));
}

// The spelling of tokens [البداية, النهاية) with single spaces.
عرف نص_رموز_جسر(ع: &معالج_جسر, الرموز: &متجه رمز_جسر, البداية: طبيعي, النهاية: طبيعي): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        إذا (ف > البداية && ((*الرموز)[ف].الأعلام & 2) != 0) { ألحق(البايتات, 0x20); };
        ألحق_معرف_جسر(&(*ع).المخزن, (*الرموز)[ف].المعرف, &متغير البايتات);
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

عرف علامة_سطر_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر, الإطار: طبيعي, السطر_الفعلي: طبيعي): فراغ {
    دع نص_الرقم: نص = نص_معرف_جسر(&(*ع).المخزن, (*الرموز)[1].المعرف);
    دع الرقم: عدد_حرفي_جسر = حلل_عدد_صحيح_جسر(&نص_الرقم);
    دع الحرفي: نص = نص_معرف_جسر(&(*ع).المخزن, (*الرموز)[2].المعرف);
    دع المفكوك: حرفي_مفكوك_جسر = فك_حرفي_جسر(&الحرفي);
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المفكوك.الوحدات) مثل طبيعي)) { ألحق(البايتات, (المفكوك.الوحدات[ف] & 0xFF) مثل ط8); ف := ف + 1; }
    دع المسار: نص = البايتات مثل نص;
    // The file of a marker is registered without being read.
    دع الفهرس: متغير طبيعي = 0;
    دع وجد: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < (الطول((*ع).الملفات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*ع).الملفات[ف].المسار, &المسار)) { الفهرس := ف; وجد := صواب; اخرج_من_حلقة; };
        ف := ف + 1;
    }
    إذا (!وجد) {
        الفهرس := الطول((*ع).الملفات) مثل طبيعي;
        دع لا_رموز: متجه رمز_جسر = [];
        دع العائلي: منطقي = عائلي_جسر(ع, &المسار);
        دع الملف: ملف_جسر = {
            المسار: انسخ_نص(&المسار), الدليل: دليل_مسار_جسر(&المسار), مدخل_البحث: 0, عائلي: العائلي,
            مرة_واحدة: خطأ, مدخول: خطأ, مقطع: خطأ, الحارس: 0, الرموز: لا_رموز,
            المضمن_من: 0, موقع_التضمين: رمز_نهاية_جسر()
        };
        ألحق((*ع).الملفات, الملف);
    };
    (*ع).الإطارات[الإطار].ملف_العلامة := الفهرس;
    (*ع).الإطارات[الإطار].سطر_العلامة := السطر_الفعلي;
    (*ع).الإطارات[الإطار].رقم_العلامة := الرقم.القيمة مثل طبيعي;
}

// #define NAME replacement / #define NAME(params) replacement.
عرف عرف_ماكرو_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر): فراغ {
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    دع ن: طبيعي = الطول(*الرموز) مثل طبيعي;
    إذا (ن < 3 || (*الرموز)[2].الصنف != 1) {
        شخص_جسر(ع, سبب_تشخيص.سبب_سي_اسم_ماكرو_ليس_معرفا(), &(*الرموز)[1]);
        أرجع;
    };
    دع الاسم: رمز_جسر = (*الرموز)[2];
    إذا (الاسم.المعرف == ك.ك_defined) {
        شخص_جسر(ع, سبب_تشخيص.سبب_سي_المعرف_المحجوز_اسم_ماكرو(), &الاسم);
        أرجع;
    };
    دع دالي: متغير منطقي = خطأ;
    دع متغير_ع: متغير منطقي = خطأ;
    دع المعاملات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 3;
    إذا (ف < ن && هو_علامة_جسر(&(*الرموز)[ف], ك.ك_lparen) && ((*الرموز)[ف].الأعلام & 2) == 0) {
        دالي := صواب;
        ف := ف + 1;
        دع صحيح: متغير منطقي = خطأ;
        إذا (ف < ن && هو_علامة_جسر(&(*الرموز)[ف], ك.ك_rparen)) {
            ف := ف + 1;
            صحيح := صواب;
        } وإلا {
            طالما (ف < ن) {
                دع ر: رمز_جسر = (*الرموز)[ف];
                إذا (هو_علامة_جسر(&ر, ك.ك_ellipsis)) {
                    ألحق(المعاملات, ك.ك_va_args);
                    متغير_ع := صواب;
                    ف := ف + 1;
                } وإلا إذا (ر.الصنف == 1) {
                    طابق فهرس_معرف_جسر(&المعاملات, ر.المعرف) مع
                    | اختياري.موجود(_) -> {
                        شخص_رمز_جسر(ع, سبب_تشخيص.سبب_سي_معامل_ماكرو_مكرر(), &ر, اسم_جسر(ع, ر.المعرف));
                        أرجع;
                    }
                    | اختياري.لا_شيء -> { };
                    ألحق(المعاملات, ر.المعرف);
                    ف := ف + 1;
                    // GNU named variadic parameter: `args...`.
                    إذا (ف < ن && هو_علامة_جسر(&(*الرموز)[ف], ك.ك_ellipsis)) { متغير_ع := صواب; ف := ف + 1; };
                } وإلا {
                    اخرج_من_حلقة;
                };
                إذا (ف < ن && هو_علامة_جسر(&(*الرموز)[ف], ك.ك_rparen)) { ف := ف + 1; صحيح := صواب; اخرج_من_حلقة; };
                إذا (متغير_ع || ف >= ن || !هو_علامة_جسر(&(*الرموز)[ف], ك.ك_comma)) { اخرج_من_حلقة; };
                ف := ف + 1;
            }
        };
        إذا (!صحيح) {
            شخص_رمز_جسر(ع, سبب_تشخيص.سبب_سي_معاملات_ماكرو_غير_صالحة(), &الاسم, اسم_جسر(ع, الاسم.المعرف));
            أرجع;
        };
    };
    دع الجسم: متغير متجه رمز_جسر = [];
    دع أول: متغير منطقي = صواب;
    طالما (ف < ن) {
        دع ر: متغير رمز_جسر = (*الرموز)[ف];
        ر.الأعلام := ر.الأعلام & 0xFE;
        إذا (أول) { ر.الأعلام := ر.الأعلام & 0xFD; أول := خطأ; };
        ألحق(الجسم, ر);
        ف := ف + 1;
    }
    دع ن_ج: طبيعي = الطول(الجسم) مثل طبيعي;
    إذا (ن_ج > 0 && (هو_علامة_جسر(&الجسم[0], ك.ك_hashhash) || هو_علامة_جسر(&الجسم[ن_ج - 1], ك.ك_hashhash))) {
        شخص_جسر(ع, سبب_تشخيص.سبب_سي_لصق_في_طرف(), &الاسم);
        أرجع;
    };
    إذا (دالي) {
        دع ي: متغير طبيعي = 0;
        طالما (ي < ن_ج) {
            إذا (هو_علامة_جسر(&الجسم[ي], ك.ك_hash)) {
                دع صالح: منطقي = ي + 1 < ن_ج && الجسم[ي + 1].الصنف == 1 && يحوي_معرفا_جسر(&المعاملات, الجسم[ي + 1].المعرف);
                إذا (!صالح) {
                    شخص_جسر(ع, سبب_تشخيص.سبب_سي_تنصيص_بلا_معامل(), &الجسم[ي]);
                    أرجع;
                };
            };
            ي := ي + 1;
        }
    };
    دع الماكرو: ماكرو_جسر = {
        الاسم: الاسم.المعرف, دالي: دالي, متغير_المعاملات: متغير_ع, المعاملات: المعاملات, الجسم: الجسم,
        المدمج: 0, الملف: الاسم.الملف, السطر: الاسم.السطر, العمود: الاسم.العمود
    };
    ألحق((*ع).الماكروهات, الماكرو);
    اضبط_ماكرو_جسر(ع, الاسم.المعرف, الطول((*ع).الماكروهات) مثل طبيعي);
}

عرف يحوي_معرفا_جسر(القائمة: &متجه طبيعي, المعرف: طبيعي): منطقي {
    طابق فهرس_معرف_جسر(القائمة, المعرف) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف فهرس_معرف_جسر(القائمة: &متجه طبيعي, المعرف: طبيعي): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا ((*القائمة)[ف] == المعرف) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// #include "x" / <x> / MACRO.
عرف ضمن_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر, التالي: منطقي, مرة: منطقي): فراغ {
    دع ن: طبيعي = الطول(*الرموز) مثل طبيعي;
    دع الموقع: رمز_جسر = (*الرموز)[1];
    دع الخطوط: متغير متجه رمز_جسر = [];
    دع ف: متغير طبيعي = 2;
    طالما (ف < ن) { ألحق(الخطوط, (*الرموز)[ف]); ف := ف + 1; }
    إذا ((الطول(الخطوط) مثل طبيعي) > 0 && الخطوط[0].الصنف == 1) {
        الخطوط := وسع_معزولا_جسر(ع, &الخطوط);
    };
    دع الاسم: متغير نص = «»;
    دع مقتبس: متغير منطقي = خطأ;
    طابق اسم_ترويسة_جسر(ع, &الخطوط, &متغير مقتبس) مع
    | اختياري.موجود(القيمة) -> { الاسم := القيمة; }
    | اختياري.لا_شيء -> {
        شخص_جسر(ع, سبب_تشخيص.سبب_سي_تضمين_بصيغة_خاطئة(), &الموقع);
        أرجع;
    };
    إذا ((الطول((*ع).الإطارات) مثل طبيعي) >= 200) {
        شخص_جسر(ع, سبب_تشخيص.سبب_سي_تضمين_عميق(), &الموقع);
        أرجع;
    };
    دع الحالي: طبيعي = الموقع.الملف;
    طابق حل_تضمين_جسر(ع, &الاسم, مقتبس, التالي, الحالي) مع
    | اختياري.لا_شيء -> {
        // `#include <iostream>`: a C++ standard header (no extension).
        إذا (!مقتبس && !يحتوي_نصا(&الاسم, &«.») && !يحتوي_نصا(&الاسم, &«/»)) {
            شخص_مسار_جسر(ع, سبب_تشخيص.سبب_سي_ترويسة_سي_بلس_مفقودة(), &الموقع, انسخ_نص(&الاسم));
        } وإلا {
            شخص_مسار_جسر(ع, سبب_تشخيص.سبب_سي_ملف_تضمين_مفقود(), &الموقع, الاسم);
        };
    }
    | اختياري.موجود(الفهرس) -> {
        إذا (مرة) { (*ع).الملفات[الفهرس].مرة_واحدة := صواب; };
        إذا ((*ع).الملفات[الفهرس].المضمن_من == 0 && الفهرس != الحالي) {
            (*ع).الملفات[الفهرس].المضمن_من := الحالي + 1;
            (*ع).الملفات[الفهرس].موقع_التضمين := الموقع;
        };
        ادخل_ملفا_جسر(ع, الفهرس);
    };
}

// Enters file الفهرس unless #pragma once or its include guard skips it.
عام عرف ادخل_ملفا_جسر(ع: &متغير معالج_جسر, الفهرس: طبيعي): فراغ {
    إذا ((*ع).الملفات[الفهرس].مرة_واحدة && (*ع).الملفات[الفهرس].مدخول) { أرجع; };
    دع الحارس: طبيعي = (*ع).الملفات[الفهرس].الحارس;
    إذا (الحارس != 0 && ماكرو_معرف_جسر(ع, الحارس)) { أرجع; };
    (*ع).الملفات[الفهرس].مدخول := صواب;
    دع الإطار: إطار_جسر = {
        الملف: الفهرس, الموضع: 0, عمق_الشروط: الطول((*ع).الشروط) مثل طبيعي,
        ملف_العلامة: 0, سطر_العلامة: 0, رقم_العلامة: 0
    };
    ألحق((*ع).الإطارات, الإطار);
    طابق_المنظور_جسر(ع);
}

// Whether file الفهرس is a host header standing in for the target's.
عرف ملف_بديل_جسر(ع: &معالج_جسر, الفهرس: طبيعي): منطقي {
    إذا ((*ع).أول_بديل == 0) { أرجع خطأ; };
    دع المدخل: طبيعي = (*ع).الملفات[الفهرس].مدخل_البحث;
    إذا (المدخل == 0 || المدخل < (*ع).أول_بديل) { أرجع خطأ; };
    // The builtin headers belong to the target's view.
    أرجع !يبدأ_بـ(&(*ع).البحث[المدخل - 1], &«<jisr>»);
}

// Applies the host's or the target's predefined macros for the current
// file (a stand-in host header or not; a builtin header keeps the view).
عرف طابق_المنظور_جسر(ع: &متغير معالج_جسر): فراغ {
    إذا ((*ع).أول_بديل == 0) { أرجع; };
    دع ن: طبيعي = الطول((*ع).الإطارات) مثل طبيعي;
    إذا (ن == 0) { أرجع; };
    دع الملف: طبيعي = (*ع).الإطارات[ن - 1].الملف;
    إذا (يبدأ_بـ(&(*ع).الملفات[الملف].المسار, &«<jisr>/»)) { أرجع; };
    دع المضيف: منطقي = ملف_بديل_جسر(ع, الملف);
    إذا (المضيف == (*ع).منظور_المضيف) { أرجع; };
    (*ع).منظور_المضيف := المضيف;
    دع ف: متغير طبيعي = 0;
    طالما (ف + 1 < (الطول((*ع).ماكروهات_المضيف) مثل طبيعي)) {
        إذا (المضيف) {
            اضبط_ماكرو_جسر(ع, (*ع).ماكروهات_المضيف[ف], (*ع).ماكروهات_المضيف[ف + 1]);
        } وإلا {
            اضبط_ماكرو_جسر(ع, (*ع).ماكروهات_الهدف[ف], (*ع).ماكروهات_الهدف[ف + 1]);
        };
        ف := ف + 2;
    }
}

// Host headers stand in for the target's from search entry أول_بديل on:
// المضيف and الهدف are the predefined macros of each (as source text).
عام عرف اضبط_بديل_المضيف_جسر(ع: &متغير معالج_جسر, أول_بديل: طبيعي, المضيف: &نص, الهدف: &نص): فراغ {
    دع قبل: متجه طبيعي = نسخة_طبيعيات_جسر(&(*ع).ماكرو_المعرف);
    دع ف_مضيف: طبيعي = أضف_ملفا_نصيا_جسر(ع, «<host built-in>», المضيف);
    عالج_نصا_جسر(ع, ف_مضيف);
    دع لقطة_المضيف: متجه طبيعي = نسخة_طبيعيات_جسر(&(*ع).ماكرو_المعرف);
    (*ع).ماكرو_المعرف := نسخة_طبيعيات_جسر(&قبل);
    دع ف_هدف: طبيعي = أضف_ملفا_نصيا_جسر(ع, «<built-in>», الهدف);
    عالج_نصا_جسر(ع, ف_هدف);
    دع ن: متغير طبيعي = الطول(لقطة_المضيف) مثل طبيعي;
    إذا ((الطول((*ع).ماكرو_المعرف) مثل طبيعي) > ن) { ن := الطول((*ع).ماكرو_المعرف) مثل طبيعي; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع أ: طبيعي = قيمة_في_جسر(&لقطة_المضيف, ف);
        دع ب: طبيعي = قيمة_في_جسر(&(*ع).ماكرو_المعرف, ف);
        إذا (أ != ب && !جسمان_متساويان_جسر(ع, أ, ب)) {
            ألحق((*ع).ماكروهات_المضيف, ف);
            ألحق((*ع).ماكروهات_المضيف, أ);
            ألحق((*ع).ماكروهات_الهدف, ف);
            ألحق((*ع).ماكروهات_الهدف, ب);
        };
        ف := ف + 1;
    }
    (*ع).أول_بديل := أول_بديل;
    (*ع).منظور_المضيف := خطأ;
}

عرف قيمة_في_جسر(القائمة: &متجه طبيعي, ف: طبيعي): طبيعي {
    إذا (ف >= (الطول(*القائمة) مثل طبيعي)) { أرجع 0; };
    أرجع (*القائمة)[ف];
}

عرف نسخة_طبيعيات_جسر(القائمة: &متجه طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) { ألحق(الناتج, (*القائمة)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

// Whether two macro entries (1 + index, 0 none) have the same replacement.
عرف جسمان_متساويان_جسر(ع: &معالج_جسر, أ: طبيعي, ب: طبيعي): منطقي {
    إذا (أ == 0 || ب == 0) { أرجع أ == ب; };
    دع م1: &ماكرو_جسر = &(*ع).الماكروهات[أ - 1];
    دع م2: &ماكرو_جسر = &(*ع).الماكروهات[ب - 1];
    إذا ((*م1).دالي != (*م2).دالي || (الطول((*م1).الجسم) مثل طبيعي) != (الطول((*م2).الجسم) مثل طبيعي)) { أرجع خطأ; };
    إذا ((الطول((*م1).المعاملات) مثل طبيعي) != (الطول((*م2).المعاملات) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*م1).الجسم) مثل طبيعي)) {
        إذا ((*م1).الجسم[ف].المعرف != (*م2).الجسم[ف].المعرف) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The search entry a file was found in.
عرف مدخل_بحث_جسر(ع: &معالج_جسر, الفهرس: طبيعي): طبيعي {
    أرجع (*ع).الملفات[الفهرس].مدخل_البحث;
}

// The header name of an #include line: a string literal, or <...> rebuilt
// from its tokens.
عرف اسم_ترويسة_جسر(ع: &معالج_جسر, الرموز: &متجه رمز_جسر, مقتبس: &متغير منطقي): اختياري نص {
    دع ن: طبيعي = الطول(*الرموز) مثل طبيعي;
    إذا (ن == 0) { أرجع اختياري.لا_شيء(); };
    إذا ((*الرموز)[0].الصنف == 3) {
        دع النص: نص = نص_معرف_جسر(&(*ع).المخزن, (*الرموز)[0].المعرف);
        إذا ((الطول(النص) مثل طبيعي) < 2 || النص[0] != 0x22) { أرجع اختياري.لا_شيء(); };
        *مقتبس := صواب;
        أرجع مقطع_نص(&النص, 1, (الطول(النص) مثل طبيعي) - 2);
    };
    إذا (هو_علامة_جسر(&(*الرموز)[0], (*ع).ك.ك_lt)) {
        دع البايتات: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 1;
        طالما (ف < ن && !هو_علامة_جسر(&(*الرموز)[ف], (*ع).ك.ك_gt)) {
            إذا (ف > 1 && ((*الرموز)[ف].الأعلام & 2) != 0) { ألحق(البايتات, 0x20); };
            ألحق_معرف_جسر(&(*ع).المخزن, (*الرموز)[ف].المعرف, &متغير البايتات);
            ف := ف + 1;
        }
        إذا (ف >= ن) { أرجع اختياري.لا_شيء(); };
        *مقتبس := خطأ;
        أرجع اختياري.موجود(البايتات مثل نص);
    };
    أرجع اختياري.لا_شيء();
}

// The file an #include names: next to the including file for "x", then
// the search directories (after the including file's own for
// #include_next). The result is a file index.
عرف حل_تضمين_جسر(ع: &متغير معالج_جسر, الاسم: &نص, مقتبس: منطقي, التالي: منطقي, الحالي: طبيعي): اختياري طبيعي {
    إذا ((الطول(*الاسم) مثل طبيعي) > 0 && (*الاسم)[0] == 0x2F) {
        إذا (ملف_موجود_جسر(الاسم)) { أرجع افتح_ملف_جسر(ع, الاسم, 0); };
        أرجع اختياري.لا_شيء();
    };
    دع البداية: متغير طبيعي = 0;
    إذا (التالي) {
        البداية := مدخل_بحث_جسر(ع, الحالي);
    } وإلا إذا (مقتبس && !يبدأ_بـ(&(*ع).الملفات[الحالي].المسار, &«<»)) {
        دع المرشح: نص = صل_المسار(&(*ع).الملفات[الحالي].الدليل, الاسم);
        إذا (ملف_موجود_جسر(&المرشح)) {
            دع المدخل: طبيعي = مدخل_بحث_جسر(ع, الحالي);
            أرجع افتح_ملف_جسر(ع, &المرشح, المدخل);
        };
    };
    دع ف: متغير طبيعي = البداية;
    طالما (ف < (الطول((*ع).البحث) مثل طبيعي)) {
        دع الدليل: نص = انسخ_نص(&(*ع).البحث[ف]);
        إذا (يبدأ_بـ(&الدليل, &«<jisr>»)) {
            طابق رأس_مدمج_جسر(الاسم) مع
            | اختياري.موجود(_) -> {
                دع المسار: نص = صل_نصين(&«<jisr>/», الاسم);
                أرجع افتح_ملف_جسر(ع, &المسار, ف + 1);
            }
            | اختياري.لا_شيء -> { };
        } وإلا {
            دع المرشح: نص = صل_المسار(&الدليل, الاسم);
            إذا (ملف_موجود_جسر(&المرشح)) { أرجع افتح_ملف_جسر(ع, &المرشح, ف + 1); };
        };
        ف := ف + 1;
    }
    // #include_next past the last directory from a C library header that
    // expects the compiler's own header after it (glibc's <limits.h>): the
    // builtin one, which a compiler searches before the system directories.
    إذا (التالي && !يبدأ_بـ(&(*ع).الملفات[الحالي].المسار, &«<jisr>/»)) {
        طابق رأس_مدمج_جسر(الاسم) مع
        | اختياري.موجود(_) -> {
            دع ي: متغير طبيعي = 0;
            طالما (ي < (الطول((*ع).البحث) مثل طبيعي)) {
                إذا (يبدأ_بـ(&(*ع).البحث[ي], &«<jisr>»)) {
                    دع المسار: نص = صل_نصين(&«<jisr>/», الاسم);
                    أرجع افتح_ملف_جسر(ع, &المسار, ي + 1);
                };
                ي := ي + 1;
            }
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع اختياري.لا_شيء();
}


// ---- #embed (C23) ----

// The path of the resource an #embed names: next to the current file for
// "x", then the search directories; none when it is not found.
عرف حل_مسار_بيانات_جسر(ع: &معالج_جسر, الاسم: &نص, مقتبس: منطقي, الحالي: طبيعي): اختياري نص {
    إذا ((الطول(*الاسم) مثل طبيعي) > 0 && (*الاسم)[0] == 0x2F) {
        إذا (ملف_موجود_جسر(الاسم)) { أرجع اختياري.موجود(انسخ_نص(الاسم)); };
        أرجع اختياري.لا_شيء();
    };
    إذا (مقتبس && !يبدأ_بـ(&(*ع).الملفات[الحالي].المسار, &«<»)) {
        دع المرشح: نص = صل_المسار(&(*ع).الملفات[الحالي].الدليل, الاسم);
        إذا (ملف_موجود_جسر(&المرشح)) { أرجع اختياري.موجود(المرشح); };
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*ع).البحث) مثل طبيعي)) {
        إذا (!يبدأ_بـ(&(*ع).البحث[ف], &«<jisr>»)) {
            دع المرشح: نص = صل_المسار(&(*ع).البحث[ف], الاسم);
            إذا (ملف_موجود_جسر(&المرشح)) { أرجع اختياري.موجود(المرشح); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// An #embed's resource and parameters.
نوع بيانات_مضمنة_جسر = {
    وجد: منطقي,
    البايتات: متجه ط8,
    البادئة: متجه رمز_جسر,
    اللاحقة: متجه رمز_جسر,
    إن_فارغ: متجه رمز_جسر
};

// Reads the resource and the parameters (limit, prefix, suffix, if_empty,
// with or without __ around them) of an #embed or __has_embed operand.
عرف اقرأ_بيانات_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر, الحالي: طبيعي, الموقع: &رمز_جسر, مشخص: منطقي): بيانات_مضمنة_جسر {
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    دع فارغة: متجه ط8 = [];
    دع ف1: متجه رمز_جسر = [];
    دع ف2: متجه رمز_جسر = [];
    دع ف3: متجه رمز_جسر = [];
    دع الناتج: متغير بيانات_مضمنة_جسر = { وجد: خطأ, البايتات: فارغة, البادئة: ف1, اللاحقة: ف2, إن_فارغ: ف3 };
    دع الخطوط: متغير متجه رمز_جسر = انسخ_رموزا_جسر(الرموز);
    إذا ((الطول(الخطوط) مثل طبيعي) > 0 && الخطوط[0].الصنف == 1) {
        الخطوط := وسع_معزولا_جسر(ع, &الخطوط);
    };
    دع مقتبس: متغير منطقي = خطأ;
    دع الاسم: متغير نص = «»;
    طابق اسم_ترويسة_جسر(ع, &الخطوط, &متغير مقتبس) مع
    | اختياري.موجود(القيمة) -> { الاسم := القيمة; }
    | اختياري.لا_شيء -> {
        إذا (مشخص) {
            شخص_جسر(ع, سبب_تشخيص.سبب_سي_إدراج_بصيغة_خاطئة(), الموقع);
        };
        أرجع الناتج;
    };
    // The parameters follow the resource name.
    دع ف: متغير طبيعي = 1;
    إذا (!مقتبس) {
        ف := 0;
        طالما (ف < (الطول(الخطوط) مثل طبيعي) && !هو_علامة_جسر(&الخطوط[ف], ك.ك_gt)) { ف := ف + 1; }
        ف := ف + 1;
    };
    دع الحد: متغير طبيعي = 0xFFFFFFFFFFFFFFFF;
    دع ن: طبيعي = الطول(الخطوط) مثل طبيعي;
    طالما (ف < ن) {
        دع المعامل: رمز_جسر = الخطوط[ف];
        إذا (المعامل.الصنف != 1) {
            إذا (مشخص) {
                شخص_جسر(ع, سبب_تشخيص.سبب_سي_معامل_تضمين_مفقود(), &المعامل);
            };
            اخرج_من_حلقة;
        };
        دع الاسم_م: نص = بلا_شرطات_جسر(اسم_جسر(ع, المعامل.المعرف));
        ف := ف + 1;
        // The balanced tokens of its (...) clause.
        دع الحجة: متغير متجه رمز_جسر = [];
        إذا (ف < ن && هو_علامة_جسر(&الخطوط[ف], ك.ك_lparen)) {
            دع العمق: متغير طبيعي = 1;
            ف := ف + 1;
            طالما (ف < ن) {
                إذا (هو_علامة_جسر(&الخطوط[ف], ك.ك_lparen)) { العمق := العمق + 1; };
                إذا (هو_علامة_جسر(&الخطوط[ف], ك.ك_rparen)) {
                    العمق := العمق - 1;
                    إذا (العمق == 0) { اخرج_من_حلقة; };
                };
                ألحق(الحجة, الخطوط[ف]);
                ف := ف + 1;
            }
            ف := ف + 1;
        };
        إذا (نصان_متساويان(&الاسم_م, &«limit»)) {
            إذا ((الطول(الحجة) مثل طبيعي) > 0) {
                دع المقيم: متغير مقيم_شرط_جسر = { الموضع: 0, فشل: خطأ, مقيم: صواب };
                (*ع).وضع_الشرط := صواب;
                دع الموسعة: متجه رمز_جسر = وسع_معزولا_جسر(ع, &الحجة);
                (*ع).وضع_الشرط := خطأ;
                دع القيمة: قيمة_شرط_جسر = قيم_شرطي_جسر(ع, &الموسعة, &متغير المقيم, &المعامل);
                إذا (!المقيم.فشل) { الحد := القيمة.البتات مثل طبيعي; };
            };
        } وإلا إذا (نصان_متساويان(&الاسم_م, &«prefix»)) { الناتج.البادئة := الحجة; }
        وإلا إذا (نصان_متساويان(&الاسم_م, &«suffix»)) { الناتج.اللاحقة := الحجة; }
        وإلا إذا (نصان_متساويان(&الاسم_م, &«if_empty»)) { الناتج.إن_فارغ := الحجة; }
        وإلا إذا (مشخص) {
            شخص_رمز_جسر(ع, سبب_تشخيص.سبب_سي_معامل_تضمين_مجهول(), &المعامل, انسخ_نص(&الاسم_م));
        };
    }
    طابق حل_مسار_بيانات_جسر(ع, &الاسم, مقتبس, الحالي) مع
    | اختياري.لا_شيء -> {
        إذا (مشخص) {
            شخص_مسار_جسر(ع, سبب_تشخيص.سبب_سي_ملف_تضمين_مفقود(), الموقع, انسخ_نص(&الاسم));
        };
    }
    | اختياري.موجود(المسار) -> {
        طابق اقرأ_الملف(&المسار) مع
        | نتيجة.خطأ(_) -> {
            إذا (مشخص) {
                شخص_مسار_جسر(ع, سبب_تشخيص.سبب_سي_ملف_تضمين_غير_مقروء(), الموقع, انسخ_نص(&الاسم));
            };
        }
        | نتيجة.نجح(المحتوى) -> {
            الناتج.وجد := صواب;
            دع البايتات: متغير متجه ط8 = [];
            دع ي: متغير طبيعي = 0;
            طالما (ي < (الطول(المحتوى) مثل طبيعي) && ي < الحد) { ألحق(البايتات, المحتوى[ي]); ي := ي + 1; }
            الناتج.البايتات := البايتات;
        };
    };
    أرجع الناتج;
}

عرف انسخ_رموزا_جسر(الرموز: &متجه رمز_جسر): متجه رمز_جسر {
    دع الناتج: متغير متجه رمز_جسر = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) { ألحق(الناتج, (*الرموز)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

// `__limit__` -> `limit`.
عرف بلا_شرطات_جسر(الاسم: نص): نص {
    دع ن: طبيعي = الطول(الاسم) مثل طبيعي;
    إذا (ن > 4 && الاسم[0] == 0x5F && الاسم[1] == 0x5F && الاسم[ن - 1] == 0x5F && الاسم[ن - 2] == 0x5F) {
        إذا ((ن - 2) > (2)) {
            طابق مقطع_نص(&الاسم, 2, (ن - 2) - (2)) مع
            | اختياري.موجود(المقطع_ن) -> { أرجع المقطع_ن; }
            | اختياري.لا_شيء -> { };
        };
        أرجع «»;
    };
    أرجع الاسم;
}


// __has_embed: 0 not found, 1 found with data, 2 found and empty.
عرف حال_بيانات_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر, الحالي: طبيعي): طبيعي {
    إذا ((الطول(*الرموز) مثل طبيعي) == 0) { أرجع 0; };
    دع الموقع: رمز_جسر = (*الرموز)[0];
    دع البيانات: بيانات_مضمنة_جسر = اقرأ_بيانات_جسر(ع, الرموز, الحالي, &الموقع, خطأ);
    إذا (!البيانات.وجد) { أرجع 0; };
    إذا ((الطول(البيانات.البايتات) مثل طبيعي) == 0) { أرجع 2; };
    أرجع 1;
}

// #embed: the resource's bytes as a comma-separated list of integer
// constants, between the prefix and suffix tokens (or the if_empty tokens
// when it is empty), read as a file of their own.
عرف ضمن_بيانات_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر): فراغ {
    دع الموقع: رمز_جسر = (*الرموز)[1];
    دع الخطوط: متغير متجه رمز_جسر = [];
    دع ف: متغير طبيعي = 2;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) { ألحق(الخطوط, (*الرموز)[ف]); ف := ف + 1; }
    دع البيانات: بيانات_مضمنة_جسر = اقرأ_بيانات_جسر(ع, &الخطوط, الموقع.الملف, &الموقع, صواب);
    إذا (!البيانات.وجد) { أرجع; };
    دع النص: متغير متجه ط8 = [];
    دع ن: طبيعي = الطول(البيانات.البايتات) مثل طبيعي;
    إذا (ن == 0) {
        ألحق_رموزا_نصا_جسر(ع, &البيانات.إن_فارغ, &متغير النص);
    } وإلا {
        ألحق_رموزا_نصا_جسر(ع, &البيانات.البادئة, &متغير النص);
        ألحق(النص, 0x20);
        ف := 0;
        طالما (ف < ن) {
            إذا (ف > 0) { ألحق(النص, 0x2C); };
            إذا (ف % 32 == 31) { ألحق(النص, 10); };
            ألحق_بايتات_نص(&متغير النص, طبيعي_إلى_نص(البيانات.البايتات[ف] مثل طبيعي));
            ف := ف + 1;
        }
        ألحق(النص, 0x20);
        ألحق_رموزا_نصا_جسر(ع, &البيانات.اللاحقة, &متغير النص);
    };
    ألحق(النص, 10);
    دع المحتوى: نص = النص مثل نص;
    دع المسار: نص = صل_ثلاثة_نصوص(&«<embed:», &(*ع).الملفات[الموقع.الملف].المسار, &«>»);
    دع الفهرس: طبيعي = أضف_ملفا_نصيا_جسر(ع, المسار, &المحتوى);
    ادخل_ملفا_جسر(ع, الفهرس);
}

// The spellings of الرموز, separated by spaces.
عرف ألحق_رموزا_نصا_جسر(ع: &معالج_جسر, الرموز: &متجه رمز_جسر, الهدف: &متغير متجه ط8): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        ألحق(*الهدف, 0x20);
        ألحق_معرف_جسر(&(*ع).المخزن, (*الرموز)[ف].المعرف, الهدف);
        ف := ف + 1;
    }
}

// Whether the header named by tokens would be found (__has_include).
عرف يوجد_تضمين_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر, التالي: منطقي, الحالي: طبيعي): منطقي {
    دع مقتبس: متغير منطقي = خطأ;
    طابق اسم_ترويسة_جسر(ع, الرموز, &متغير مقتبس) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الاسم) -> {
        طابق حل_تضمين_جسر(ع, &الاسم, مقتبس, التالي, الحالي) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    };
}

// #pragma: once, pack, push_macro / pop_macro; others are ignored.
عرف نفذ_براغما_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر, البداية: طبيعي, النهاية: طبيعي, الموقع: &رمز_جسر): فراغ {
    إذا (البداية >= النهاية) { أرجع; };
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    دع الأول: رمز_جسر = (*الرموز)[البداية];
    إذا (الأول.المعرف == ك.ك_once) {
        دع ن_إ: طبيعي = الطول((*ع).الإطارات) مثل طبيعي;
        إذا (ن_إ > 0) {
            دع الملف: طبيعي = (*ع).الإطارات[ن_إ - 1].الملف;
            (*ع).الملفات[الملف].مرة_واحدة := صواب;
        };
        أرجع;
    };
    إذا (الأول.المعرف == ك.ك_pack) {
        // pack(push[, n]) / pack(pop) / pack(n) / pack(): a marker token.
        دع العملية: متغير طبيعي = 0;
        دع القيمة: متغير طبيعي = 0;
        دع ف: متغير طبيعي = البداية + 1;
        طالما (ف < النهاية) {
            دع ر: رمز_جسر = (*الرموز)[ف];
            إذا (ر.الصنف == 1 && ر.المعرف == ك.ك_push) { العملية := 1; القيمة := 0xFFFF; }
            وإلا إذا (ر.الصنف == 1 && ر.المعرف == ك.ك_pop) { العملية := 2; }
            وإلا إذا (ر.الصنف == 2) {
                دع نص_العدد: نص = نص_معرف_جسر(&(*ع).المخزن, ر.المعرف);
                دع العدد: عدد_حرفي_جسر = حلل_عدد_صحيح_جسر(&نص_العدد);
                القيمة := العدد.القيمة مثل طبيعي;
            };
            ف := ف + 1;
        }
        دع العلامة: متغير رمز_جسر = *الموقع;
        العلامة.الصنف := 8;
        العلامة.المعرف := القيمة;
        العلامة.المخفية := العملية;
        ألحق((*ع).الناتج, العلامة);
        أرجع;
    };
    إذا ((الأول.المعرف == ك.ك_push_macro || الأول.المعرف == ك.ك_pop_macro) && البداية + 3 < النهاية
        && (*الرموز)[البداية + 2].الصنف == 3) {
        دع الحرفي: نص = نص_معرف_جسر(&(*ع).المخزن, (*الرموز)[البداية + 2].المعرف);
        دع الاسم_ن: متغير نص = «»;
        إذا (((الطول(الحرفي) مثل طبيعي) - 1) > (1)) {
            طابق مقطع_نص(&الحرفي, 1, ((الطول(الحرفي) مثل طبيعي) - 1) - (1)) مع
            | اختياري.موجود(المقطع_ن) -> { الاسم_ن := المقطع_ن; }
            | اختياري.لا_شيء -> { الاسم_ن := «»; };
        };
        دع الاسم: طبيعي = اعزل_نص_جسر(&متغير (*ع).المخزن, &الاسم_ن);
        إذا (الأول.المعرف == ك.ك_push_macro) {
            ألحق((*ع).المحفوظة_أسماء, الاسم);
            ألحق((*ع).المحفوظة_قيم, ماكرو_لمعرف_جسر(ع, الاسم));
        } وإلا {
            دع ف: متغير طبيعي = الطول((*ع).المحفوظة_أسماء) مثل طبيعي;
            طالما (ف > 0) {
                ف := ف - 1;
                إذا ((*ع).المحفوظة_أسماء[ف] == الاسم) {
                    دع القيمة: طبيعي = (*ع).المحفوظة_قيم[ف];
                    اضبط_ماكرو_جسر(ع, الاسم, القيمة);
                    (*ع).المحفوظة_أسماء[ف] := 0;
                    اخرج_من_حلقة;
                };
            }
        };
    };
}

// ---- conditional inclusion ----

// The value of an #if / #ifdef / #ifndef / #elif* line.
عرف قيم_شرط_توجيه_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر): منطقي {
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    دع ن: طبيعي = الطول(*الرموز) مثل طبيعي;
    دع م: طبيعي = (*الرموز)[1].المعرف;
    إذا (م == ك.ك_ifdef || م == ك.ك_ifndef || م == ك.ك_elifdef || م == ك.ك_elifndef) {
        إذا (ن < 3 || (*الرموز)[2].الصنف != 1) {
            شخص_جسر(ع, سبب_تشخيص.سبب_سي_اسم_ماكرو_ليس_معرفا(), &(*الرموز)[1]);
            أرجع خطأ;
        };
        دع معرف: منطقي = ماكرو_معرف_جسر(ع, (*الرموز)[2].المعرف);
        إذا (م == ك.ك_ifdef || م == ك.ك_elifdef) { أرجع معرف; };
        أرجع !معرف;
    };
    دع الخطوط: متغير متجه رمز_جسر = [];
    دع ف: متغير طبيعي = 2;
    طالما (ف < ن) { ألحق(الخطوط, (*الرموز)[ف]); ف := ف + 1; }
    إذا ((الطول(الخطوط) مثل طبيعي) == 0) {
        شخص_جسر(ع, سبب_تشخيص.سبب_سي_شرط_بلا_تعبير(), &(*الرموز)[1]);
        أرجع خطأ;
    };
    أرجع قيم_سطر_شرط_جسر(ع, &الخطوط, &(*الرموز)[1]);
}

عرف قيم_سطر_شرط_جسر(ع: &متغير معالج_جسر, الخطوط: &متجه رمز_جسر, الموقع: &رمز_جسر): منطقي {
    دع الأولى: متجه رمز_جسر = اختصر_معاملات_شرط_جسر(ع, الخطوط);
    (*ع).وضع_الشرط := صواب;
    دع الموسعة: متجه رمز_جسر = وسع_معزولا_جسر(ع, &الأولى);
    (*ع).وضع_الشرط := خطأ;
    دع النهائية: متجه رمز_جسر = اختصر_معاملات_شرط_جسر(ع, &الموسعة);
    دع المقيم: متغير مقيم_شرط_جسر = { الموضع: 0, فشل: خطأ, مقيم: صواب };
    دع القيمة: قيمة_شرط_جسر = قيم_شرطي_جسر(ع, &النهائية, &متغير المقيم, الموقع);
    إذا (!المقيم.فشل && المقيم.الموضع < (الطول(النهائية) مثل طبيعي)) {
        المقيم.فشل := صواب;
        شخص_رمز_جسر(ع, سبب_تشخيص.سبب_سي_رمز_في_شرط(), &النهائية[المقيم.الموضع], اسم_جسر(ع, النهائية[المقيم.الموضع].المعرف));
    };
    إذا (المقيم.فشل) { أرجع خطأ; };
    أرجع القيمة.البتات != 0;
}

عرف رمز_رقم_جسر(ع: &متغير معالج_جسر, القيمة: منطقي, الموقع: &رمز_جسر): رمز_جسر {
    دع النص: متغير نص = «0»;
    إذا (القيمة) { النص := «1»; };
    دع الناتج: متغير رمز_جسر = *الموقع;
    الناتج.الصنف := 2;
    الناتج.المعرف := اعزل_نص_جسر(&متغير (*ع).المخزن, &النص);
    الناتج.الأعلام := الناتج.الأعلام | 4;
    أرجع الناتج;
}

// defined X, defined(X), __has_include(...), __has_attribute(x), ... ->
// 1 or 0.
عرف اختصر_معاملات_شرط_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر): متجه رمز_جسر {
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    دع الناتج: متغير متجه رمز_جسر = [];
    دع ن: طبيعي = الطول(*الرموز) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع الرمز: رمز_جسر = (*الرموز)[ف];
        إذا (الرمز.الصنف == 1 && الرمز.المعرف == ك.ك_defined) {
            دع الاسم: متغير طبيعي = 0;
            إذا (ف + 1 < ن && (*الرموز)[ف + 1].الصنف == 1) { الاسم := (*الرموز)[ف + 1].المعرف; ف := ف + 2; }
            وإلا إذا (ف + 3 < ن && هو_علامة_جسر(&(*الرموز)[ف + 1], ك.ك_lparen) && (*الرموز)[ف + 2].الصنف == 1
                && هو_علامة_جسر(&(*الرموز)[ف + 3], ك.ك_rparen)) {
                الاسم := (*الرموز)[ف + 2].المعرف;
                ف := ف + 4;
            } وإلا {
                شخص_جسر(ع, سبب_تشخيص.سبب_سي_المعرف_المحجوز_بلا_معرف(), &الرمز);
                ف := ف + 1;
                تابع_حلقة;
            };
            ألحق(الناتج, رمز_رقم_جسر(ع, ماكرو_معرف_جسر(ع, الاسم), &الرمز));
            تابع_حلقة;
        };
        دع رقم: طبيعي = ماكرو_لمعرف_جسر(ع, الرمز.المعرف);
        إذا (الرمز.الصنف == 1 && رقم != 0 && (*ع).الماكروهات[رقم - 1].المدمج >= 20
            && ف + 1 < ن && هو_علامة_جسر(&(*الرموز)[ف + 1], ك.ك_lparen)) {
            دع المدمج: ط8 = (*ع).الماكروهات[رقم - 1].المدمج;
            دع العمق: متغير طبيعي = 0;
            دع ي: متغير طبيعي = ف + 1;
            دع المعامل: متغير متجه رمز_جسر = [];
            طالما (ي < ن) {
                إذا (هو_علامة_جسر(&(*الرموز)[ي], ك.ك_lparen)) { العمق := العمق + 1; };
                إذا (هو_علامة_جسر(&(*الرموز)[ي], ك.ك_rparen)) {
                    العمق := العمق - 1;
                    إذا (العمق == 0) { اخرج_من_حلقة; };
                };
                إذا (ي > ف + 1) { ألحق(المعامل, (*الرموز)[ي]); };
                ي := ي + 1;
            }
            ف := ي + 1;
            دع القيمة: متغير منطقي = خطأ;
            إذا (المدمج == 35) {
                // __has_embed: 0 not found, 1 found, 2 found and empty.
                دع الحال: طبيعي = حال_بيانات_جسر(ع, &المعامل, الرمز.الملف);
                دع الرقم_ر: متغير رمز_جسر = رمز_رقم_جسر(ع, الحال != 0, &الرمز);
                إذا (الحال == 2) {
                    دع اثنان: نص = «2»;
                    الرقم_ر.المعرف := اعزل_نص_جسر(&متغير (*ع).المخزن, &اثنان);
                };
                ألحق(الناتج, الرقم_ر);
                تابع_حلقة;
            };
            إذا (المدمج == 20 || المدمج == 21) {
                القيمة := يوجد_تضمين_جسر(ع, &المعامل, المدمج == 21, الرمز.الملف);
            } وإلا إذا ((الطول(المعامل) مثل طبيعي) > 0) {
                القيمة := ميزة_مدعومة_جسر(ع, المدمج, المعامل[0].المعرف);
            };
            ألحق(الناتج, رمز_رقم_جسر(ع, القيمة, &الرمز));
            تابع_حلقة;
        };
        ألحق(الناتج, الرمز);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The attributes and builtins Jisr understands (layout attributes are
// honored; others are parsed and ignored, so they are reported absent and
// headers fall back to their portable spellings).
عرف ميزة_مدعومة_جسر(ع: &معالج_جسر, المدمج: ط8, المعرف: طبيعي): منطقي {
    دع الاسم: نص = نص_معرف_جسر(&(*ع).المخزن, المعرف);
    إذا (المدمج == 22) {
        دع الأسماء: متجه نص = [«aligned», «__aligned__», «packed», «__packed__», «mode», «__mode__»];
        أرجع نص_في_جسر(&الاسم, &الأسماء);
    };
    إذا (المدمج == 23) {
        دع الأسماء: متجه نص = [«__builtin_offsetof», «__builtin_va_list», «__builtin_va_arg», «__builtin_va_start»,
            «__builtin_va_end», «__builtin_va_copy», «__is_target_arch», «__is_target_vendor», «__is_target_os»,
            «__is_target_environment», «__is_target_variant_os», «__is_target_variant_environment»];
        أرجع نص_في_جسر(&الاسم, &الأسماء);
    };
    إذا (المدمج == 30) { أرجع صواب; };
    إذا (المدمج == 31) { أرجع اسم_في_قائمة_جسر(&(*ع).أسماء_المعمارية, &الاسم); };
    إذا (المدمج == 32) { أرجع اسم_في_قائمة_جسر(&(*ع).أسماء_المورد, &الاسم); };
    إذا (المدمج == 33) { أرجع اسم_في_قائمة_جسر(&(*ع).أسماء_المنصة, &الاسم); };
    إذا (المدمج == 34) { أرجع اسم_في_قائمة_جسر(&(*ع).أسماء_البيئة, &الاسم); };
    أرجع خطأ;
}

عرف نص_في_جسر(النص: &نص, القائمة: &متجه نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (نصان_متساويان(النص, &(*القائمة)[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// #if arithmetic is in intmax_t / uintmax_t (C17 6.10.1p4).
نوع قيمة_شرط_جسر = { البتات: ط64, بلا_إشارة: منطقي };
نوع مقيم_شرط_جسر = { الموضع: طبيعي, فشل: منطقي, مقيم: منطقي };

عرف قيمة_شرط_من_جسر(البتات: ط64, بلا_إشارة: منطقي): قيمة_شرط_جسر {
    دع الناتج: قيمة_شرط_جسر = { البتات: البتات, بلا_إشارة: بلا_إشارة };
    أرجع الناتج;
}

// The first failure of an #if expression: its reason, with the token as
// written (الرمز) or a constant's text (القيمة) when not "".
عرف فشل_شرط_جسر(ع: &متغير معالج_جسر, م: &متغير مقيم_شرط_جسر, الموقع: &رمز_جسر, السبب: سبب_تشخيص,
    الرمز_ن: نص, القيمة: نص): قيمة_شرط_جسر {
    إذا (!(*م).فشل) {
        دع ت: متغير تشخيص_جسر = تشخيص_ع_جسر(ع, السبب, الموقع);
        إذا ((الطول(الرمز_ن) مثل طبيعي) > 0) { أضف_رمز_سي(&متغير ت.السجل, الرمز_ن); };
        إذا ((الطول(القيمة) مثل طبيعي) > 0) { أضف_قيمة_سي(&متغير ت.السجل, القيمة); };
        شخص_ت_جسر(ع, ت);
    };
    (*م).فشل := صواب;
    أرجع قيمة_شرط_من_جسر(0, خطأ);
}

عرف رمز_شرط_جسر(الرموز: &متجه رمز_جسر, م: &مقيم_شرط_جسر): رمز_جسر {
    إذا ((*م).الموضع >= (الطول(*الرموز) مثل طبيعي)) { أرجع رمز_نهاية_جسر(); };
    أرجع (*الرموز)[(*م).الموضع];
}

عرف علامة_شرط_جسر(الرموز: &متجه رمز_جسر, م: &مقيم_شرط_جسر, المعرف: طبيعي): منطقي {
    دع الرمز: رمز_جسر = رمز_شرط_جسر(الرموز, م);
    أرجع هو_علامة_جسر(&الرمز, المعرف);
}

عرف قيم_شرطي_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر, م: &متغير مقيم_شرط_جسر, الموقع: &رمز_جسر): قيمة_شرط_جسر {
    دع الشرط: قيمة_شرط_جسر = قيم_ثنائي_شرط_جسر(ع, الرموز, م, الموقع, 1);
    دع التالي: رمز_جسر = رمز_شرط_جسر(الرموز, م);
    إذا ((*م).فشل || !هو_علامة_جسر(&التالي, (*ع).ك.ك_question)) { أرجع الشرط; };
    (*م).الموضع := (*م).الموضع + 1;
    دع المقيم: منطقي = (*م).مقيم;
    (*م).مقيم := المقيم && الشرط.البتات != 0;
    دع أ: قيمة_شرط_جسر = قيم_شرطي_جسر(ع, الرموز, م, الموقع);
    دع النقطتان: رمز_جسر = رمز_شرط_جسر(الرموز, م);
    إذا (!هو_علامة_جسر(&النقطتان, (*ع).ك.ك_colon)) {
        (*م).مقيم := المقيم;
        أرجع فشل_شرط_جسر(ع, م, الموقع, سبب_تشخيص.سبب_سي_نقطتان_مفقودتان_في_شرط(), «», «»);
    };
    (*م).الموضع := (*م).الموضع + 1;
    (*م).مقيم := المقيم && الشرط.البتات == 0;
    دع ب: قيمة_شرط_جسر = قيم_شرطي_جسر(ع, الرموز, م, الموقع);
    (*م).مقيم := المقيم;
    دع بلا: منطقي = أ.بلا_إشارة || ب.بلا_إشارة;
    إذا (الشرط.البتات != 0) { أرجع قيمة_شرط_من_جسر(أ.البتات, بلا); };
    أرجع قيمة_شرط_من_جسر(ب.البتات, بلا);
}

عرف أسبقية_شرط_جسر(ع: &متغير معالج_جسر, الرمز: &رمز_جسر): طبيعي {
    إذا ((*الرمز).الصنف != 5) { أرجع 0; };
    دع س: نص = نص_معرف_جسر(&(*ع).المخزن, (*الرمز).المعرف);
    دع ن: طبيعي = الطول(س) مثل طبيعي;
    إذا (ن == 1) {
        دع ب: ط8 = س[0];
        إذا (ب == 0x2A || ب == 0x2F || ب == 0x25) { أرجع 10; };
        إذا (ب == 0x2B || ب == 0x2D) { أرجع 9; };
        إذا (ب == 0x3C || ب == 0x3E) { أرجع 7; };
        إذا (ب == 0x26) { أرجع 5; };
        إذا (ب == 0x5E) { أرجع 4; };
        إذا (ب == 0x7C) { أرجع 3; };
        إذا (ب == 0x2C) { أرجع 0; };
        أرجع 0;
    };
    إذا (ن == 2) {
        دع أ: ط8 = س[0];
        دع ب: ط8 = س[1];
        إذا ((أ == 0x3C && ب == 0x3C) || (أ == 0x3E && ب == 0x3E)) { أرجع 8; };
        إذا ((أ == 0x3C || أ == 0x3E) && ب == 0x3D) { أرجع 7; };
        إذا ((أ == 0x3D || أ == 0x21) && ب == 0x3D) { أرجع 6; };
        إذا (أ == 0x26 && ب == 0x26) { أرجع 2; };
        إذا (أ == 0x7C && ب == 0x7C) { أرجع 1; };
    };
    أرجع 0;
}

عرف قيم_ثنائي_شرط_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر, م: &متغير مقيم_شرط_جسر, الموقع: &رمز_جسر, الحد: طبيعي): قيمة_شرط_جسر {
    دع اليسار: متغير قيمة_شرط_جسر = قيم_أحادي_شرط_جسر(ع, الرموز, م, الموقع);
    طالما (!(*م).فشل) {
        دع المعامل: رمز_جسر = رمز_شرط_جسر(الرموز, م);
        دع الأسبقية: طبيعي = أسبقية_شرط_جسر(ع, &المعامل);
        إذا (الأسبقية == 0 || الأسبقية < الحد) { اخرج_من_حلقة; };
        (*م).الموضع := (*م).الموضع + 1;
        دع س: نص = نص_معرف_جسر(&(*ع).المخزن, المعامل.المعرف);
        دع المقيم: منطقي = (*م).مقيم;
        // && and || evaluate their right operand only when it decides.
        إذا (الأسبقية == 2) { (*م).مقيم := المقيم && اليسار.البتات != 0; };
        إذا (الأسبقية == 1) { (*م).مقيم := المقيم && اليسار.البتات == 0; };
        دع اليمين: قيمة_شرط_جسر = قيم_ثنائي_شرط_جسر(ع, الرموز, م, الموقع, الأسبقية + 1);
        (*م).مقيم := المقيم;
        اليسار := طبق_شرطا_جسر(ع, &س, اليسار, اليمين, م, &المعامل);
    }
    أرجع اليسار;
}

عرف سالب_جسر(ق: ط64): منطقي { أرجع (ق & 0x8000000000000000) != 0; }

عرف أصغر_شرط_جسر(أ: قيمة_شرط_جسر, ب: قيمة_شرط_جسر): منطقي {
    إذا (أ.بلا_إشارة || ب.بلا_إشارة) { أرجع أ.البتات < ب.البتات; };
    أرجع (أ.البتات ^ 0x8000000000000000) < (ب.البتات ^ 0x8000000000000000);
}

عرف منطق_شرط_جسر(ق: منطقي): قيمة_شرط_جسر {
    إذا (ق) { أرجع قيمة_شرط_من_جسر(1, خطأ); };
    أرجع قيمة_شرط_من_جسر(0, خطأ);
}

عرف طبق_شرطا_جسر(ع: &متغير معالج_جسر, س: &نص, أ: قيمة_شرط_جسر, ب: قيمة_شرط_جسر, م: &متغير مقيم_شرط_جسر, الموقع: &رمز_جسر): قيمة_شرط_جسر {
    دع بلا: منطقي = أ.بلا_إشارة || ب.بلا_إشارة;
    دع ن: طبيعي = الطول(*س) مثل طبيعي;
    دع ح: ط8 = (*س)[0];
    إذا (ن == 1) {
        إذا (ح == 0x2B) { أرجع قيمة_شرط_من_جسر(جمع_ط64_ملتف(أ.البتات, ب.البتات), بلا); };
        إذا (ح == 0x2D) { أرجع قيمة_شرط_من_جسر(طرح_ط64_ملتف(أ.البتات, ب.البتات), بلا); };
        إذا (ح == 0x2A) { أرجع قيمة_شرط_من_جسر(ضرب_ط64_ملتف(أ.البتات, ب.البتات), بلا); };
        إذا (ح == 0x2F || ح == 0x25) {
            إذا (ب.البتات == 0) {
                إذا (!(*م).مقيم) { أرجع قيمة_شرط_من_جسر(0, بلا); };
                أرجع فشل_شرط_جسر(ع, م, الموقع, سبب_تشخيص.سبب_سي_قسمة_على_صفر_في_شرط(), «», «»);
            };
            أرجع قيمة_شرط_من_جسر(اقسم_جسر(أ.البتات, ب.البتات, بلا, ح == 0x25), بلا);
        };
        إذا (ح == 0x3C) { أرجع منطق_شرط_جسر(أصغر_شرط_جسر(أ, ب)); };
        إذا (ح == 0x3E) { أرجع منطق_شرط_جسر(أصغر_شرط_جسر(ب, أ)); };
        إذا (ح == 0x26) { أرجع قيمة_شرط_من_جسر(أ.البتات & ب.البتات, بلا); };
        إذا (ح == 0x7C) { أرجع قيمة_شرط_من_جسر(أ.البتات | ب.البتات, بلا); };
        إذا (ح == 0x5E) { أرجع قيمة_شرط_من_جسر(أ.البتات ^ ب.البتات, بلا); };
    };
    دع ث: ط8 = (*س)[1];
    إذا (ح == 0x3C && ث == 0x3C) {
        إذا (ب.البتات >= 64) { أرجع قيمة_شرط_من_جسر(0, أ.بلا_إشارة); };
        أرجع قيمة_شرط_من_جسر(إزاحة_يسرى_ط64_ملتفة(أ.البتات, ب.البتات مثل ط32), أ.بلا_إشارة);
    };
    إذا (ح == 0x3E && ث == 0x3E) {
        إذا (ب.البتات >= 64) { أرجع قيمة_شرط_من_جسر(0, أ.بلا_إشارة); };
        إذا (!أ.بلا_إشارة && سالب_جسر(أ.البتات)) { أرجع قيمة_شرط_من_جسر(~((~أ.البتات) >> ب.البتات), خطأ); };
        أرجع قيمة_شرط_من_جسر(أ.البتات >> ب.البتات, أ.بلا_إشارة);
    };
    إذا (ح == 0x3C) { أرجع منطق_شرط_جسر(!أصغر_شرط_جسر(ب, أ)); };
    إذا (ح == 0x3E) { أرجع منطق_شرط_جسر(!أصغر_شرط_جسر(أ, ب)); };
    إذا (ح == 0x3D) { أرجع منطق_شرط_جسر(أ.البتات == ب.البتات); };
    إذا (ح == 0x21) { أرجع منطق_شرط_جسر(أ.البتات != ب.البتات); };
    إذا (ح == 0x26) { أرجع منطق_شرط_جسر(أ.البتات != 0 && ب.البتات != 0); };
    أرجع منطق_شرط_جسر(أ.البتات != 0 || ب.البتات != 0);
}

// Truncating division and remainder of 64-bit words.
عام عرف اقسم_جسر(أ: ط64, ب: ط64, بلا_إشارة: منطقي, باق: منطقي): ط64 {
    إذا (بلا_إشارة) {
        إذا (باق) { أرجع أ % ب; };
        أرجع أ / ب;
    };
    دع سالب_أ: منطقي = سالب_جسر(أ);
    دع سالب_ب: منطقي = سالب_جسر(ب);
    دع م_أ: متغير ط64 = أ;
    دع م_ب: متغير ط64 = ب;
    إذا (سالب_أ) { م_أ := طرح_ط64_ملتف(0, م_أ); };
    إذا (سالب_ب) { م_ب := طرح_ط64_ملتف(0, م_ب); };
    إذا (باق) {
        دع الباقي: ط64 = م_أ % م_ب;
        إذا (سالب_أ) { أرجع طرح_ط64_ملتف(0, الباقي); };
        أرجع الباقي;
    };
    دع الخارج: ط64 = م_أ / م_ب;
    إذا (سالب_أ != سالب_ب) { أرجع طرح_ط64_ملتف(0, الخارج); };
    أرجع الخارج;
}

عرف قيم_أحادي_شرط_جسر(ع: &متغير معالج_جسر, الرموز: &متجه رمز_جسر, م: &متغير مقيم_شرط_جسر, الموقع: &رمز_جسر): قيمة_شرط_جسر {
    دع الرمز: رمز_جسر = رمز_شرط_جسر(الرموز, م);
    إذا (الرمز.الصنف == 0) {
        أرجع فشل_شرط_جسر(ع, م, الموقع, سبب_تشخيص.سبب_سي_معامل_مفقود_في_شرط(), «», «»);
    };
    (*م).الموضع := (*م).الموضع + 1;
    إذا (الرمز.الصنف == 5) {
        دع س: نص = نص_معرف_جسر(&(*ع).المخزن, الرمز.المعرف);
        إذا ((الطول(س) مثل طبيعي) == 1) {
            دع ح: ط8 = س[0];
            إذا (ح == 0x28) {
                دع ق: قيمة_شرط_جسر = قيم_شرطي_جسر(ع, الرموز, م, الموقع);
                // The comma operator inside parentheses.
                طالما (!(*م).فشل && علامة_شرط_جسر(الرموز, م, (*ع).ك.ك_comma)) {
                    (*م).الموضع := (*م).الموضع + 1;
                    دع التالي: قيمة_شرط_جسر = قيم_شرطي_جسر(ع, الرموز, م, الموقع);
                    إذا (!(*م).فشل && علامة_شرط_جسر(الرموز, م, (*ع).ك.ك_rparen)) {
                        (*م).الموضع := (*م).الموضع + 1;
                        أرجع التالي;
                    };
                }
                إذا (!علامة_شرط_جسر(الرموز, م, (*ع).ك.ك_rparen)) {
                    أرجع فشل_شرط_جسر(ع, م, &الرمز, سبب_تشخيص.سبب_سي_قوس_مفقود_في_شرط(), «», «»);
                };
                (*م).الموضع := (*م).الموضع + 1;
                أرجع ق;
            };
            إذا (ح == 0x2D) {
                دع ق: قيمة_شرط_جسر = قيم_أحادي_شرط_جسر(ع, الرموز, م, الموقع);
                أرجع قيمة_شرط_من_جسر(طرح_ط64_ملتف(0, ق.البتات), ق.بلا_إشارة);
            };
            إذا (ح == 0x2B) { أرجع قيم_أحادي_شرط_جسر(ع, الرموز, م, الموقع); };
            إذا (ح == 0x7E) {
                دع ق: قيمة_شرط_جسر = قيم_أحادي_شرط_جسر(ع, الرموز, م, الموقع);
                أرجع قيمة_شرط_من_جسر(~ق.البتات, ق.بلا_إشارة);
            };
            إذا (ح == 0x21) {
                دع ق: قيمة_شرط_جسر = قيم_أحادي_شرط_جسر(ع, الرموز, م, الموقع);
                أرجع منطق_شرط_جسر(ق.البتات == 0);
            };
        };
        أرجع فشل_شرط_جسر(ع, م, &الرمز, سبب_تشخيص.سبب_سي_رمز_في_شرط(), س, «»);
    };
    إذا (الرمز.الصنف == 2) {
        دع النص: نص = نص_معرف_جسر(&(*ع).المخزن, الرمز.المعرف);
        دع العدد: عدد_حرفي_جسر = حلل_عدد_صحيح_جسر(&النص);
        إذا (!العدد.صالح) {
            أرجع فشل_شرط_جسر(ع, م, &الرمز, سبب_تشخيص.سبب_سي_ثابت_صحيح_في_شرط(), «», النص);
        };
        // A value beyond intmax_t is a uintmax_t.
        أرجع قيمة_شرط_من_جسر(العدد.القيمة, العدد.بلا_إشارة || سالب_جسر(العدد.القيمة));
    };
    إذا (الرمز.الصنف == 4) {
        دع النص: نص = نص_معرف_جسر(&(*ع).المخزن, الرمز.المعرف);
        دع الحرف: حرف_حرفي_جسر = حلل_حرف_جسر(&النص, صواب);
        إذا (!الحرف.صالح) {
            أرجع فشل_شرط_جسر(ع, م, &الرمز, سبب_تشخيص.سبب_سي_ثابت_حرفي_في_شرط(), «», انسخ_نص(&النص));
        };
        أرجع قيمة_شرط_من_جسر(الحرف.القيمة, خطأ);
    };
    إذا (الرمز.الصنف == 1) {
        // An identifier left after expansion is 0 (true and false are C23's).
        إذا (الرمز.المعرف == (*ع).ك.ك_true) { أرجع قيمة_شرط_من_جسر(1, خطأ); };
        أرجع قيمة_شرط_من_جسر(0, خطأ);
    };
    أرجع فشل_شرط_جسر(ع, م, &الرمز, سبب_تشخيص.سبب_سي_رمز_في_شرط(), نص_معرف_جسر(&(*ع).المخزن, الرمز.المعرف), «»);
}

// Skips a group whose condition was false: to the next #elif that holds,
// to #else, or past #endif.
عرف تخط_إلى_فرع_جسر(ع: &متغير معالج_جسر): فراغ {
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    طالما (صواب) {
        دع م: طبيعي = تخط_مجموعة_جسر(ع);
        دع ن_ش: طبيعي = الطول((*ع).الشروط) مثل طبيعي;
        إذا (م == 0) { أرجع; };
        // The directive line is at the frame position.
        دع ن_إ: طبيعي = الطول((*ع).الإطارات) مثل طبيعي;
        دع الإطار: إطار_جسر = (*ع).الإطارات[ن_إ - 1];
        دع النهاية: طبيعي = نهاية_سطر_جسر(ع, الإطار.الملف, الإطار.الموضع);
        دع الرموز: متغير متجه رمز_جسر = [];
        دع ف: متغير طبيعي = الإطار.الموضع;
        طالما (ف < النهاية) { ألحق(الرموز, رمز_ملف_جسر(ع, الإطار.الملف, ف)); ف := ف + 1; }
        (*ع).الإطارات[ن_إ - 1].الموضع := النهاية;
        إذا (م == ك.ك_endif) {
            دع المحذوف: اختياري شرط_جسر = أزل_الأخير((*ع).الشروط);
            أرجع;
        };
        إذا (م == ك.ك_else) {
            (*ع).الشروط[ن_ش - 1].في_وإلا := صواب;
            إذا (!(*ع).الشروط[ن_ش - 1].مأخوذ) { (*ع).الشروط[ن_ش - 1].مأخوذ := صواب; أرجع; };
            تابع_حلقة;
        };
        // #elif / #elifdef / #elifndef.
        إذا ((*ع).الشروط[ن_ش - 1].في_وإلا) {
            شخص_جسر(ع, سبب_تشخيص.سبب_سي_وإلا_إذا_بعد_وإلا(), &الرموز[1]);
            تابع_حلقة;
        };
        إذا ((*ع).الشروط[ن_ش - 1].مأخوذ) { تابع_حلقة; };
        إذا (قيم_شرط_توجيه_جسر(ع, &الرموز)) {
            (*ع).الشروط[ن_ش - 1].مأخوذ := صواب;
            أرجع;
        };
    }
}

// Skips the rest of a conditional whose taken group just ended.
عرف تخط_إلى_النهاية_جسر(ع: &متغير معالج_جسر): فراغ {
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    طالما (صواب) {
        دع م: طبيعي = تخط_مجموعة_جسر(ع);
        إذا (م == 0) { أرجع; };
        دع ن_إ: طبيعي = الطول((*ع).الإطارات) مثل طبيعي;
        دع الإطار: إطار_جسر = (*ع).الإطارات[ن_إ - 1];
        (*ع).الإطارات[ن_إ - 1].الموضع := نهاية_سطر_جسر(ع, الإطار.الملف, الإطار.الموضع);
        إذا (م == ك.ك_endif) {
            دع المحذوف: اختياري شرط_جسر = أزل_الأخير((*ع).الشروط);
            أرجع;
        };
    }
}

// Advances over a skipped group to the next directive of the same
// conditional (#elif*, #else, #endif), leaving the position at its '#';
// returns the directive's name id, or 0 at the end of the file (an
// unterminated conditional, reported when the file ends).
عرف تخط_مجموعة_جسر(ع: &متغير معالج_جسر): طبيعي {
    دع ك: كلمات_معالج_جسر = (*ع).ك;
    دع ن_إ: طبيعي = الطول((*ع).الإطارات) مثل طبيعي;
    دع الملف: طبيعي = (*ع).الإطارات[ن_إ - 1].الملف;
    دع ن: طبيعي = عدد_رموز_ملف_جسر(ع, الملف);
    دع ف: متغير طبيعي = (*ع).الإطارات[ن_إ - 1].الموضع;
    دع العمق: متغير طبيعي = 0;
    طالما (ف < ن) {
        إذا (توجيه_عند_جسر(ع, الملف, ف) && ف + 1 < ن) {
            دع ر: رمز_جسر = رمز_ملف_جسر(ع, الملف, ف + 1);
            إذا ((ر.الأعلام & 1) == 0) {
                دع م: طبيعي = ر.المعرف;
                إذا (م == ك.ك_if || م == ك.ك_ifdef || م == ك.ك_ifndef) {
                    العمق := العمق + 1;
                } وإلا إذا (م == ك.ك_endif) {
                    إذا (العمق == 0) { (*ع).الإطارات[ن_إ - 1].الموضع := ف; أرجع م; };
                    العمق := العمق - 1;
                } وإلا إذا ((م == ك.ك_else || م == ك.ك_elif || م == ك.ك_elifdef || م == ك.ك_elifndef) && العمق == 0) {
                    (*ع).الإطارات[ن_إ - 1].الموضع := ف;
                    أرجع م;
                };
            };
            ف := نهاية_سطر_جسر(ع, الملف, ف);
            تابع_حلقة;
        };
        ف := ف + 1;
    }
    (*ع).الإطارات[ن_إ - 1].الموضع := ن;
    أرجع 0;
}

// ---- driving ----

// Preprocesses everything entered (the predefined text, then the main
// file): the expanded tokens go to الناتج.
عام عرف عالج_جسر(ع: &متغير معالج_جسر): فراغ {
    طالما (صواب) {
        دع الرمز: رمز_جسر = رمز_موسع_جسر(ع);
        إذا (الرمز.الصنف == 0) { اخرج_من_حلقة; };
        إذا ((الرمز.الأعلام & 56) != 0) { أبلغ_رمزا_معيبا_جسر(ع, &الرمز); };
        ألحق((*ع).الناتج, الرمز);
    }
}

// The bytes of النص from الموضع that are not UTF-8, as hexadecimal pairs
// (the bytes up to the next ASCII one, four at most).
عرف بايتات_معيبة_جسر(النص: &نص, الموضع: طبيعي): نص {
    دع الأجزاء: متغير متجه نص = [];
    دع ف: متغير طبيعي = الموضع;
    طالما (ف < (الطول(*النص) مثل طبيعي) && ف < الموضع + 4 && (ف == الموضع || !محرف_أسكي((*النص)[ف]))) {
        // Two hexadecimal digits (std.encoding.hex).
        دع البايت: متجه ط8 = [(*النص)[ف]];
        ألحق(الأجزاء, رمز_سداسي_كبير(&البايت));
        ف := ف + 1;
    }
    دع الفاصل: نص = « »;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

// A token the lexer flagged, now used in the program's text: a character
// no identifier allows, bytes that are not UTF-8, or a literal with an
// invalid escape or universal character name (lexer.sn, literals.sn).
عرف أبلغ_رمزا_معيبا_جسر(ع: &متغير معالج_جسر, الرمز: &رمز_جسر): فراغ {
    دع التهجئة: نص = اسم_جسر(ع, (*الرمز).المعرف);
    إذا (((*الرمز).الأعلام & 16) != 0) {
        // The first byte that is not UTF-8.
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التهجئة) مثل طبيعي)) {
            إذا (!محرف_أسكي(التهجئة[ف])) {
                دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&التهجئة, ف);
                إذا (!المفكوك.صالح) { اخرج_من_حلقة; };
                ف := ف + المفكوك.العرض;
            } وإلا { ف := ف + 1; };
        }
        دع البايتات: نص = بايتات_معيبة_جسر(&التهجئة, ف);
        شخص_قيمة_جسر(ع, سبب_تشخيص.سبب_سي_يوتيف8_غير_صالح(), الرمز, البايتات);
        أرجع;
    };
    إذا (((*الرمز).الأعلام & 32) != 0) {
        دع المفكوك: حرفي_مفكوك_جسر = فك_حرفي_جسر(&التهجئة);
        إذا (المفكوك.السبب == 2) {
            دع النقطة: نص = نص_نقطة_يونيكود(المفكوك.القيمة مثل ط32);
            دع ت: متغير تشخيص_جسر = تشخيص_ع_جسر(ع, سبب_تشخيص.سبب_سي_محرف_عالمي_ممنوع(), الرمز);
            أضف_قيمة_سي(&متغير ت.السجل, النقطة);
            أضف_رمز_سي(&متغير ت.السجل, انسخ_نص(&التهجئة));
            شخص_ت_جسر(ع, ت);
            أرجع;
        };
        دع ت: متغير تشخيص_جسر = تشخيص_ع_جسر(ع, سبب_تشخيص.سبب_سي_هروب_غير_صالح(), الرمز);
        // The escape: its backslash and the character after it (std's
        // optional slice: none past the end of the spelling).
        طابق مقطع_نص(&التهجئة, المفكوك.الموضع, 2) مع
        | اختياري.موجود(الهروب) -> { أضف_قيمة_سي(&متغير ت.السجل, الهروب); }
        | اختياري.لا_شيء -> { };
        أضف_رمز_سي(&متغير ت.السجل, انسخ_نص(&التهجئة));
        شخص_ت_جسر(ع, ت);
        أرجع;
    };
    // A character no C identifier allows (flag 8): its code point.
    دع القيمة: متغير طبيعي = 0;
    إذا ((الطول(التهجئة) مثل طبيعي) > 0 && التهجئة[0] == 0x5C) {
        دع ف: متغير طبيعي = 2;
        طالما (ف < (الطول(التهجئة) مثل طبيعي)) {
            دع الرقم: عدد = قيمة_سداسية(التهجئة[ف]);
            إذا (الرقم >= 0) { القيمة := القيمة * 16 + (الرقم مثل طبيعي); };
            ف := ف + 1;
        }
    } وإلا {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&التهجئة, 0);
        القيمة := المفكوك.القيمة مثل طبيعي;
    };
    دع النقطة: نص = نص_نقطة_يونيكود(القيمة مثل ط32);
    دع ت: متغير تشخيص_جسر = تشخيص_ع_جسر(ع, سبب_تشخيص.سبب_سي_محرف_معرف_غير_صالح(), الرمز);
    أضف_قيمة_سي(&متغير ت.السجل, النقطة);
    أضف_رمز_سي(&متغير ت.السجل, التهجئة);
    شخص_ت_جسر(ع, ت);
}

// Enters a file of the driver's text (the predefined macros) and runs it.
عام عرف عالج_نصا_جسر(ع: &متغير معالج_جسر, الفهرس: طبيعي): فراغ {
    ادخل_ملفا_جسر(ع, الفهرس);
    عالج_جسر(ع);
}

// Opens and enters the main file; false when it cannot be read.
عام عرف ادخل_الرئيسي_جسر(ع: &متغير معالج_جسر, المسار: &نص): منطقي {
    // The search entry of the directory holding the file, so that its
    // #include_next continues after it.
    دع الدليل: متغير نص = دليل_مسار_جسر(المسار);
    إذا (يبدأ_بـ(المسار, &«<jisr>/»)) { الدليل := «<jisr>»; };
    دع المدخل: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*ع).البحث) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*ع).البحث[ف], &الدليل)) { المدخل := ف + 1; };
        ف := ف + 1;
    }
    طابق افتح_ملف_جسر(ع, المسار, المدخل) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الفهرس) -> {
        ادخل_ملفا_جسر(ع, الفهرس);
        أرجع صواب;
    };
}

// The full expansion of macro الماكرو's body (an object-like macro), for
// the constants the import writes.
عام عرف وسع_ماكرو_جسر(ع: &متغير معالج_جسر, الماكرو: طبيعي): متجه رمز_جسر {
    دع الجسم: متغير متجه رمز_جسر = جسم_ماكرو_جسر(ع, الماكرو);
    دع المخفية: طبيعي = أضف_مخفية_جسر(&متغير (*ع).المخفيات, 0, الماكرو);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الجسم) مثل طبيعي)) {
        الجسم[ف].المخفية := المخفية;
        ف := ف + 1;
    }
    دع مسبق: منطقي = (*ع).مسبق;
    (*ع).مسبق := خطأ;
    دع الناتج: متجه رمز_جسر = وسع_معزولا_جسر(ع, &الجسم);
    (*ع).مسبق := مسبق;
    أرجع الناتج;
}

// Whether الاسم is one of the space-separated names of القائمة.
عرف اسم_في_قائمة_جسر(القائمة: &نص, الاسم: &نص): منطقي {
    دع ن: طبيعي = الطول(*القائمة) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= ن) {
        إذا (ف == ن || (*القائمة)[ف] == 0x20) {
            إذا (ف > البداية) {
                دع الكلمة: متغير نص = «»;
                إذا ((ف) > (البداية)) {
                    طابق مقطع_نص(القائمة, البداية, (ف) - (البداية)) مع
                    | اختياري.موجود(المقطع_ن) -> { الكلمة := المقطع_ن; }
                    | اختياري.لا_شيء -> { الكلمة := «»; };
                };
                إذا (نصان_متساويان(&الكلمة, الاسم)) { أرجع صواب; };
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The names Clang's __is_target_* tests accept for the target.
عام عرف اضبط_أسماء_الهدف_جسر(ع: &متغير معالج_جسر, المعمارية: نص, المنصة: نص, المورد: نص, البيئة: نص): فراغ {
    (*ع).أسماء_المعمارية := المعمارية;
    (*ع).أسماء_المنصة := المنصة;
    (*ع).أسماء_المورد := المورد;
    (*ع).أسماء_البيئة := البيئة;
}
