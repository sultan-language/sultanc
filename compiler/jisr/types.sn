// C types of Jisr and their layout on the target (C17 6.2.5, 6.7.2.1 and
// the target ABIs' aggregate rules: System V / Itanium-style records with
// GCC's bit-field placement, and Microsoft's for MSVC targets; packing by
// attribute and by #pragma pack; _Alignas / aligned).
//
// Types live in one table and are named by index. Scalar types sit at fixed
// indices (below); derived types (pointers, arrays, functions, qualified
// copies) are appended as they are built. Struct, union and enum types point
// at a tag record, which holds the members and the computed layout.
استورد std.text.from_bytes;
استورد compiler.backend.layout.alignment;
استورد compiler.jisr.core;
استورد compiler.jisr.target;

// الصنف: 0 an error (unknown) type, 1 void, 2 _Bool, 3 integer, 4 real
// floating, 5 pointer, 6 array, 7 function, 8 struct, 9 union, 10 enum,
// 11 __builtin_va_list, 12 a type with no SultanC form (__int128,
// _Complex, _Float128, vectors, ...; its spelling in الاسم, its size and
// alignment in العدد and المحاذاة_الصريحة).
عام نوع نوع_سي_جسر = {
    الصنف: ط8,
    // Bits of an integer or floating type.
    العرض: طبيعي,
    موقع: منطقي,
    // char, signed char or unsigned char.
    حرفي: منطقي,
    // Integer conversion rank: 1 _Bool, 2 char, 3 short, 4 int, 5 long,
    // 6 long long.
    الرتبة: ط8,
    ثابت: منطقي,
    // Pointee, element or return type.
    الأساس: طبيعي,
    // Array length (or the size of a type of 12).
    العدد: طبيعي,
    مجهول_العدد: منطقي,
    بداية_المعطيات: طبيعي,
    عدد_المعطيات: طبيعي,
    متغير_المعاملات: منطقي,
    بلا_نموذج: منطقي,
    // An old-style definition's identifier list (parameters unknown here).
    قائمة_معرفات: منطقي,
    الوسم: طبيعي,
    الاسم: طبيعي,
    // _Alignas / __attribute__((aligned)) carried by a typedef.
    المحاذاة_الصريحة: طبيعي,
    // C23 _BitInt(N): N (the value bits; العرض is the width of the
    // standard integer that holds it), 0 for any other type.
    البتات_الدقيقة: طبيعي
};

// Tags: struct, union or enum.
عام نوع وسم_سي_جسر = {
    الصنف: ط8,
    الاسم: طبيعي,
    مكتمل: منطقي,
    بداية_الحقول: طبيعي,
    عدد_الحقول: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    له_حقول_بتية: منطقي,
    له_مرن: منطقي,
    // Layout departs from natural alignment (packed, aligned, #pragma pack).
    معبأ: منطقي,
    محاذاة_صريحة: طبيعي,
    // The enum's compatible integer type.
    الأساس: طبيعي,
    // The number of declarations made before the tag was completed.
    تسلسل_الاكتمال: طبيعي,
    // Declared inside a function body, at this block depth.
    محلي: منطقي,
    العمق: طبيعي,
    الملف: طبيعي,
    السطر: طبيعي,
    العمود: طبيعي,
    // The file (index + 1) of the declaration that named the tag before
    // its definition (`struct X;`, `typedef struct X X;`, `struct X *`);
    // 0 when it was defined first.
    ملف_ناقص: طبيعي
};

عام نوع حقل_سي_جسر = {
    الاسم: طبيعي,
    النوع: طبيعي,
    بتي: منطقي,
    عرض_البت: طبيعي,
    // Bytes (bits for a bit-field, in إزاحة_البت).
    الإزاحة: طبيعي,
    إزاحة_البت: طبيعي,
    محاذاة_صريحة: طبيعي,
    معبأ: منطقي
};

عام نوع جدول_أنواع_جسر = {
    الأنواع: متجه نوع_سي_جسر,
    المعطيات: متجه طبيعي,
    الوسوم: متجه وسم_سي_جسر,
    الحقول: متجه حقل_سي_جسر
};

// Fixed indices of the scalar types.
عام عرف ن_خطأ_جسر(): طبيعي { أرجع 0; }
عام عرف ن_فراغ_جسر(): طبيعي { أرجع 1; }
عام عرف ن_منطقي_جسر(): طبيعي { أرجع 2; }
عام عرف ن_حرف_جسر(): طبيعي { أرجع 3; }
عام عرف ن_حرف_موقع_جسر(): طبيعي { أرجع 4; }
عام عرف ن_حرف_طبيعي_جسر(): طبيعي { أرجع 5; }
عام عرف ن_قصير_جسر(): طبيعي { أرجع 6; }
عام عرف ن_قصير_طبيعي_جسر(): طبيعي { أرجع 7; }
عام عرف ن_صحيح_جسر(): طبيعي { أرجع 8; }
عام عرف ن_صحيح_طبيعي_جسر(): طبيعي { أرجع 9; }
عام عرف ن_طويل_جسر(): طبيعي { أرجع 10; }
عام عرف ن_طويل_طبيعي_جسر(): طبيعي { أرجع 11; }
عام عرف ن_طويل2_جسر(): طبيعي { أرجع 12; }
عام عرف ن_طويل2_طبيعي_جسر(): طبيعي { أرجع 13; }
عام عرف ن_عائم_جسر(): طبيعي { أرجع 14; }
عام عرف ن_مزدوج_جسر(): طبيعي { أرجع 15; }
عام عرف ن_مزدوج_طويل_جسر(): طبيعي { أرجع 16; }
عام عرف ن_قائمة_معاملات_جسر(): طبيعي { أرجع 17; }

عرف نوع_فارغ_جسر(الصنف: ط8): نوع_سي_جسر {
    دع الناتج: نوع_سي_جسر = {
        الصنف: الصنف, العرض: 0, موقع: خطأ, حرفي: خطأ, الرتبة: 0, ثابت: خطأ, الأساس: 0, العدد: 0,
        مجهول_العدد: خطأ, بداية_المعطيات: 0, عدد_المعطيات: 0, متغير_المعاملات: خطأ, بلا_نموذج: خطأ, قائمة_معرفات: خطأ,
        الوسم: 0, الاسم: 0, المحاذاة_الصريحة: 0, البتات_الدقيقة: 0
    };
    أرجع الناتج;
}

// _BitInt(N) or unsigned _BitInt(N), N <= 128: held in the smallest
// standard integer width that fits it (its size, alignment and calling
// convention on every target; __int128's above 64 bits, so compiled code
// computes with it through the 128-bit helpers, and a declaration of it has
// no SultanC form), its value always within N bits. It is not
// promoted to int, and its rank falls between the standard types by N
// (C23 6.3.1.1).
عام عرف بتي_جسر(ج: &متغير جدول_أنواع_جسر, البتات: طبيعي, موقع: منطقي): طبيعي {
    دع الناتج: متغير نوع_سي_جسر = نوع_فارغ_جسر(3);
    دع العرض: متغير طبيعي = 8;
    طالما (العرض < البتات) { العرض := العرض * 2; }
    الناتج.العرض := العرض;
    الناتج.موقع := موقع;
    الناتج.الرتبة := 8;
    الناتج.البتات_الدقيقة := البتات;
    أرجع أضف_نوعا_جسر(ج, الناتج);
}

// __int128 / unsigned __int128: an integer of rank above long long (16
// bytes, aligned to 16). Declarations of it have no SultanC form; compiled
// C code computes with it through helpers (lower.sn).
عام عرف صحيح128_جسر(ج: &متغير جدول_أنواع_جسر, موقع: منطقي): طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*ج).الأنواع) مثل طبيعي)) {
        دع ن: نوع_سي_جسر = (*ج).الأنواع[ف];
        إذا (ن.الصنف == 3 && ن.العرض == 128 && ن.موقع == موقع && !ن.ثابت) { أرجع ف; };
        ف := ف + 1;
    }
    دع الناتج: متغير نوع_سي_جسر = نوع_فارغ_جسر(3);
    الناتج.العرض := 128;
    الناتج.موقع := موقع;
    الناتج.الرتبة := 7;
    أرجع أضف_نوعا_جسر(ج, الناتج);
}

// The value bits of an integer type (N for _BitInt(N)).
عام عرف عرض_دقيق_جسر(ج: &جدول_أنواع_جسر, ن: طبيعي): طبيعي {
    دع النوع: نوع_سي_جسر = (*ج).الأنواع[ن];
    إذا (النوع.البتات_الدقيقة != 0) { أرجع النوع.البتات_الدقيقة; };
    أرجع النوع.العرض;
}

عرف صحيح_جسر(العرض: طبيعي, موقع: منطقي, الرتبة: ط8, حرفي: منطقي): نوع_سي_جسر {
    دع الناتج: متغير نوع_سي_جسر = نوع_فارغ_جسر(3);
    الناتج.العرض := العرض;
    الناتج.موقع := موقع;
    الناتج.الرتبة := الرتبة;
    الناتج.حرفي := حرفي;
    أرجع الناتج;
}

عام عرف جدول_أنواع_جسر_جديد(النموذج: &نموذج_سي_جسر): جدول_أنواع_جسر {
    دع الأنواع: متغير متجه نوع_سي_جسر = [];
    ألحق(الأنواع, نوع_فارغ_جسر(0));
    ألحق(الأنواع, نوع_فارغ_جسر(1));
    دع منطقي_ن: متغير نوع_سي_جسر = صحيح_جسر(8, خطأ, 1, خطأ);
    منطقي_ن.الصنف := 2;
    ألحق(الأنواع, منطقي_ن);
    ألحق(الأنواع, صحيح_جسر(8, (*النموذج).حرف_موقع, 2, صواب));
    ألحق(الأنواع, صحيح_جسر(8, صواب, 2, صواب));
    ألحق(الأنواع, صحيح_جسر(8, خطأ, 2, صواب));
    ألحق(الأنواع, صحيح_جسر(16, صواب, 3, خطأ));
    ألحق(الأنواع, صحيح_جسر(16, خطأ, 3, خطأ));
    ألحق(الأنواع, صحيح_جسر((*النموذج).عرض_الصحيح, صواب, 4, خطأ));
    ألحق(الأنواع, صحيح_جسر((*النموذج).عرض_الصحيح, خطأ, 4, خطأ));
    ألحق(الأنواع, صحيح_جسر((*النموذج).عرض_الطويل, صواب, 5, خطأ));
    ألحق(الأنواع, صحيح_جسر((*النموذج).عرض_الطويل, خطأ, 5, خطأ));
    ألحق(الأنواع, صحيح_جسر(64, صواب, 6, خطأ));
    ألحق(الأنواع, صحيح_جسر(64, خطأ, 6, خطأ));
    دع عائم: متغير نوع_سي_جسر = نوع_فارغ_جسر(4);
    عائم.العرض := 32;
    ألحق(الأنواع, عائم);
    دع مزدوج: متغير نوع_سي_جسر = نوع_فارغ_جسر(4);
    مزدوج.العرض := 64;
    ألحق(الأنواع, مزدوج);
    دع طويل_مزدوج: متغير نوع_سي_جسر = نوع_فارغ_جسر(4);
    طويل_مزدوج.العرض := (*النموذج).حجم_الطويل_المزدوج * 8;
    طويل_مزدوج.الرتبة := 7;
    ألحق(الأنواع, طويل_مزدوج);
    ألحق(الأنواع, نوع_فارغ_جسر(11));
    دع المعطيات: متجه طبيعي = [];
    دع الوسوم: متغير متجه وسم_سي_جسر = [];
    دع الحقول: متجه حقل_سي_جسر = [];
    // Tag 0 is no tag.
    ألحق(الوسوم, وسم_جديد_جسر(0, 0, 0, 0, 0));
    دع الناتج: جدول_أنواع_جسر = { الأنواع: الأنواع, المعطيات: المعطيات, الوسوم: الوسوم, الحقول: الحقول };
    أرجع الناتج;
}

عام عرف وسم_جديد_جسر(الصنف: ط8, الاسم: طبيعي, الملف: طبيعي, السطر: طبيعي, العمود: طبيعي): وسم_سي_جسر {
    دع الناتج: وسم_سي_جسر = {
        الصنف: الصنف, الاسم: الاسم, مكتمل: خطأ, بداية_الحقول: 0, عدد_الحقول: 0, الحجم: 0, المحاذاة: 1,
        له_حقول_بتية: خطأ, له_مرن: خطأ, معبأ: خطأ, محاذاة_صريحة: 0, الأساس: 8, تسلسل_الاكتمال: 0, محلي: خطأ, العمق: 0,
        الملف: الملف, السطر: السطر, العمود: العمود, ملف_ناقص: 0
    };
    أرجع الناتج;
}

عام عرف نوع_عند_جسر(ج: &جدول_أنواع_جسر, ن: طبيعي): نوع_سي_جسر { أرجع (*ج).الأنواع[ن]; }

عام عرف أضف_نوعا_جسر(ج: &متغير جدول_أنواع_جسر, النوع: نوع_سي_جسر): طبيعي {
    ألحق((*ج).الأنواع, النوع);
    أرجع (الطول((*ج).الأنواع) مثل طبيعي) - 1;
}

عام عرف مؤشر_إلى_جسر(ج: &متغير جدول_أنواع_جسر, الأساس: طبيعي): طبيعي {
    دع الناتج: متغير نوع_سي_جسر = نوع_فارغ_جسر(5);
    الناتج.الأساس := الأساس;
    أرجع أضف_نوعا_جسر(ج, الناتج);
}

عام عرف مصفوفة_من_جسر(ج: &متغير جدول_أنواع_جسر, العنصر: طبيعي, العدد: طبيعي, مجهول: منطقي): طبيعي {
    دع الناتج: متغير نوع_سي_جسر = نوع_فارغ_جسر(6);
    الناتج.الأساس := العنصر;
    الناتج.العدد := العدد;
    الناتج.مجهول_العدد := مجهول;
    أرجع أضف_نوعا_جسر(ج, الناتج);
}

عام عرف دالة_جسر(ج: &متغير جدول_أنواع_جسر, الناتج_ن: طبيعي, المعطيات: &متجه طبيعي, متغير_م: منطقي, بلا_نموذج: منطقي): طبيعي {
    دع الناتج: متغير نوع_سي_جسر = نوع_فارغ_جسر(7);
    الناتج.الأساس := الناتج_ن;
    الناتج.بداية_المعطيات := الطول((*ج).المعطيات) مثل طبيعي;
    الناتج.عدد_المعطيات := الطول(*المعطيات) مثل طبيعي;
    الناتج.متغير_المعاملات := متغير_م;
    الناتج.بلا_نموذج := بلا_نموذج;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعطيات) مثل طبيعي)) { ألحق((*ج).المعطيات, (*المعطيات)[ف]); ف := ف + 1; }
    أرجع أضف_نوعا_جسر(ج, الناتج);
}

عام عرف نوع_وسم_جسر(ج: &متغير جدول_أنواع_جسر, الوسم: طبيعي): طبيعي {
    دع الناتج: متغير نوع_سي_جسر = نوع_فارغ_جسر((*ج).الوسوم[الوسم].الصنف);
    الناتج.الوسم := الوسم;
    أرجع أضف_نوعا_جسر(ج, الناتج);
}

// A type with no SultanC form, of known size and alignment.
عام عرف نوع_بلا_صيغة_جسر(ج: &متغير جدول_أنواع_جسر, الاسم: طبيعي, الحجم: طبيعي, المحاذاة: طبيعي): طبيعي {
    دع الناتج: متغير نوع_سي_جسر = نوع_فارغ_جسر(12);
    الناتج.الاسم := الاسم;
    الناتج.العدد := الحجم;
    الناتج.المحاذاة_الصريحة := المحاذاة;
    أرجع أضف_نوعا_جسر(ج, الناتج);
}

// النوع with const added (or removed).
عام عرف بثابت_جسر(ج: &متغير جدول_أنواع_جسر, النوع: طبيعي, ثابت: منطقي): طبيعي {
    إذا ((*ج).الأنواع[النوع].ثابت == ثابت) { أرجع النوع; };
    دع الناتج: متغير نوع_سي_جسر = (*ج).الأنواع[النوع];
    الناتج.ثابت := ثابت;
    أرجع أضف_نوعا_جسر(ج, الناتج);
}

عام عرف بمحاذاة_جسر(ج: &متغير جدول_أنواع_جسر, النوع: طبيعي, المحاذاة: طبيعي): طبيعي {
    دع الناتج: متغير نوع_سي_جسر = (*ج).الأنواع[النوع];
    الناتج.المحاذاة_الصريحة := المحاذاة;
    أرجع أضف_نوعا_جسر(ج, الناتج);
}

عام عرف صنف_جسر(ج: &جدول_أنواع_جسر, ن: طبيعي): ط8 { أرجع (*ج).الأنواع[ن].الصنف; }

عام عرف صحيح_أو_تعداد_جسر(ج: &جدول_أنواع_جسر, ن: طبيعي): منطقي {
    دع ص: ط8 = (*ج).الأنواع[ن].الصنف;
    أرجع ص == 2 || ص == 3 || ص == 10;
}

// The integer type an enum is compatible with, or the type itself.
عام عرف بلا_تعداد_جسر(ج: &جدول_أنواع_جسر, ن: طبيعي): طبيعي {
    إذا ((*ج).الأنواع[ن].الصنف == 10) { أرجع (*ج).الوسوم[(*ج).الأنواع[ن].الوسم].الأساس; };
    أرجع ن;
}

// ---- size and alignment ----

عام نوع حجم_جسر = { الحجم: طبيعي, المحاذاة: طبيعي, صالح: منطقي };

عرف حجم_من_جسر(الحجم: طبيعي, المحاذاة: طبيعي, صالح: منطقي): حجم_جسر {
    دع الناتج: حجم_جسر = { الحجم: الحجم, المحاذاة: المحاذاة, صالح: صالح };
    أرجع الناتج;
}

// Size and alignment of a type (alignment as a struct member when
// في_بنية: 8-byte scalars are 4-aligned in i386 System V records).
عام عرف حجم_نوع_جسر(ج: &جدول_أنواع_جسر, النموذج: &نموذج_سي_جسر, ن: طبيعي, في_بنية: منطقي): حجم_جسر {
    دع النوع: نوع_سي_جسر = (*ج).الأنواع[ن];
    دع الناتج: متغير حجم_جسر = حجم_من_جسر(0, 1, خطأ);
    دع ص: ط8 = النوع.الصنف;
    إذا (ص == 1 || ص == 7) {
        الناتج := حجم_من_جسر(1, 1, خطأ);
    } وإلا إذا (ص == 2 || ص == 3 || ص == 4) {
        دع البايتات: طبيعي = النوع.العرض / 8;
        دع المحاذاة: متغير طبيعي = البايتات;
        إذا (ص == 4 && النوع.الرتبة == 7) { المحاذاة := (*النموذج).محاذاة_الطويل_المزدوج; }
        وإلا إذا (البايتات == 8) {
            إذا (في_بنية) { المحاذاة := (*النموذج).محاذاة_الثمانية_في_البنى; } وإلا { المحاذاة := (*النموذج).محاذاة_الثمانية; };
        };
        إذا (المحاذاة > 1 && (*النموذج).عرض_المؤشر == 16) { المحاذاة := 1; };
        الناتج := حجم_من_جسر(البايتات, المحاذاة, البايتات > 0);
    } وإلا إذا (ص == 5) {
        دع البايتات: طبيعي = (*النموذج).عرض_المؤشر / 8;
        الناتج := حجم_من_جسر(البايتات, البايتات, صواب);
    } وإلا إذا (ص == 6) {
        دع العنصر: حجم_جسر = حجم_نوع_جسر(ج, النموذج, النوع.الأساس, في_بنية);
        الناتج := حجم_من_جسر(العنصر.الحجم * النوع.العدد, العنصر.المحاذاة, العنصر.صالح && !النوع.مجهول_العدد);
    } وإلا إذا (ص == 8 || ص == 9) {
        دع الوسم: &وسم_سي_جسر = &(*ج).الوسوم[النوع.الوسم];
        الناتج := حجم_من_جسر((*الوسم).الحجم, (*الوسم).المحاذاة, (*الوسم).مكتمل);
    } وإلا إذا (ص == 10) {
        دع الوسم: &وسم_سي_جسر = &(*ج).الوسوم[النوع.الوسم];
        دع الأساس: حجم_جسر = حجم_نوع_جسر(ج, النموذج, (*الوسم).الأساس, في_بنية);
        الناتج := حجم_من_جسر(الأساس.الحجم, الأساس.المحاذاة, (*الوسم).مكتمل);
    } وإلا إذا (ص == 11) {
        دع المؤشر: طبيعي = (*النموذج).عرض_المؤشر / 8;
        الناتج := حجم_من_جسر((*النموذج).حجم_قائمة_المعاملات, المؤشر, صواب);
    } وإلا إذا (ص == 12) {
        الناتج := حجم_من_جسر(النوع.العدد, النوع.المحاذاة_الصريحة, النوع.العدد > 0);
    };
    إذا (ص != 12 && النوع.المحاذاة_الصريحة > الناتج.المحاذاة) { الناتج.المحاذاة := النوع.المحاذاة_الصريحة; };
    أرجع الناتج;
}

// ---- record layout ----

// Lays out a struct or union whose fields are الحقول[بداية, بداية + عدد).
// الحزمة: the #pragma pack in force (0 none).
عام عرف خطط_وسما_جسر(ج: &متغير جدول_أنواع_جسر, النموذج: &نموذج_سي_جسر, الوسم: طبيعي, الحزمة: طبيعي): فراغ {
    دع اتحاد: منطقي = (*ج).الوسوم[الوسم].الصنف == 9;
    دع معبأ_الكل: منطقي = (*ج).الوسوم[الوسم].معبأ;
    دع إم_إس: منطقي = (*النموذج).إم_إس_في_سي;
    دع البداية: طبيعي = (*ج).الوسوم[الوسم].بداية_الحقول;
    دع العدد: طبيعي = (*ج).الوسوم[الوسم].عدد_الحقول;
    دع البت: متغير طبيعي = 0;
    دع الحجم_بتات: متغير طبيعي = 0;
    دع المحاذاة_الكلية: متغير طبيعي = 1;
    دع له_بتية: متغير منطقي = خطأ;
    دع غير_طبيعي: متغير منطقي = معبأ_الكل || الحزمة > 0 || (*ج).الوسوم[الوسم].محاذاة_صريحة > 0;
    // Microsoft: the storage unit the current bit-field run occupies.
    دع وحدة_البداية: متغير طبيعي = 0;
    دع وحدة_الحجم: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الحقل: حقل_سي_جسر = (*ج).الحقول[البداية + ف];
        دع ح: حجم_جسر = حجم_نوع_جسر(ج, النموذج, الحقل.النوع, صواب);
        دع الطبيعية: طبيعي = ح.المحاذاة;
        دع المحاذاة: متغير طبيعي = ح.المحاذاة;
        إذا (معبأ_الكل || الحقل.معبأ) { المحاذاة := 1; };
        إذا (الحقل.محاذاة_صريحة > المحاذاة) { المحاذاة := الحقل.محاذاة_صريحة; };
        إذا (الحزمة > 0 && المحاذاة > الحزمة) { المحاذاة := الحزمة; };
        إذا (المحاذاة != الطبيعية) { غير_طبيعي := صواب; };
        إذا (الحقل.بتي) {
            له_بتية := صواب;
            دع العرض: طبيعي = الحقل.عرض_البت;
            دع وحدة_ترجمة: طبيعي = ح.الحجم * 8;
            إذا (اتحاد) {
                (*ج).الحقول[البداية + ف].إزاحة_البت := 0;
                إذا (العرض > الحجم_بتات) { الحجم_بتات := العرض; };
            } وإلا إذا (إم_إس) {
                إذا (العرض == 0) {
                    وحدة_الحجم := 0;
                } وإلا {
                    إذا (وحدة_الحجم != ح.الحجم || البت + العرض > وحدة_البداية + وحدة_ترجمة) {
                        إذا (وحدة_الحجم != 0) { البت := وحدة_البداية + وحدة_الحجم * 8; };
                        البت := محاذاة_لأعلى(البت, المحاذاة * 8);
                        وحدة_البداية := البت;
                        وحدة_الحجم := ح.الحجم;
                    };
                    (*ج).الحقول[البداية + ف].إزاحة_البت := البت;
                    البت := البت + العرض;
                };
            } وإلا {
                إذا (العرض == 0) {
                    // A zero-width bit-field ends the unit (at the type's
                    // natural alignment, packing aside).
                    البت := محاذاة_لأعلى(البت, ح.المحاذاة * 8);
                } وإلا {
                    // GCC: a bit-field does not straddle an aligned unit of
                    // its type unless the record is packed.
                    إذا (!(معبأ_الكل || الحقل.معبأ) && وحدة_ترجمة > 0 && (البت % (المحاذاة * 8)) + العرض > وحدة_ترجمة) {
                        البت := محاذاة_لأعلى(البت, المحاذاة * 8);
                    };
                    (*ج).الحقول[البداية + ف].إزاحة_البت := البت;
                    البت := البت + العرض;
                };
            };
            (*ج).الحقول[البداية + ف].الإزاحة := (*ج).الحقول[البداية + ف].إزاحة_البت / 8;
            // Named bit-fields give the record their type's alignment.
            إذا ((الحقل.الاسم != 0 || إم_إس) && العرض > 0 && المحاذاة > المحاذاة_الكلية) { المحاذاة_الكلية := المحاذاة; };
        } وإلا {
            وحدة_الحجم := 0;
            إذا (اتحاد) {
                (*ج).الحقول[البداية + ف].الإزاحة := 0;
                إذا (ح.الحجم * 8 > الحجم_بتات) { الحجم_بتات := ح.الحجم * 8; };
            } وإلا {
                البت := محاذاة_لأعلى(البت, المحاذاة * 8);
                (*ج).الحقول[البداية + ف].الإزاحة := البت / 8;
                إذا (!((*ج).الأنواع[الحقل.النوع].الصنف == 6 && (*ج).الأنواع[الحقل.النوع].مجهول_العدد)) {
                    البت := البت + ح.الحجم * 8;
                };
            };
            إذا (المحاذاة > المحاذاة_الكلية) { المحاذاة_الكلية := المحاذاة; };
        };
        ف := ف + 1;
    }
    إذا (!اتحاد) { الحجم_بتات := البت; };
    إذا ((*ج).الوسوم[الوسم].محاذاة_صريحة > المحاذاة_الكلية) { المحاذاة_الكلية := (*ج).الوسوم[الوسم].محاذاة_صريحة; };
    دع البايتات: طبيعي = (الحجم_بتات + 7) / 8;
    (*ج).الوسوم[الوسم].الحجم := محاذاة_لأعلى(البايتات, المحاذاة_الكلية);
    (*ج).الوسوم[الوسم].المحاذاة := المحاذاة_الكلية;
    (*ج).الوسوم[الوسم].له_حقول_بتية := له_بتية;
    (*ج).الوسوم[الوسم].مكتمل := صواب;
    إذا (غير_طبيعي) { (*ج).الوسوم[الوسم].معبأ := صواب; };
}

// ---- comparison ----

// Whether two types are the same type (C17 6.2.7 compatibility, as far as
// declarations need it: qualifiers of parameters ignored, an unprototyped
// function matching a prototyped one).
عام عرف نوعان_متوافقان_جسر(ج: &جدول_أنواع_جسر, أ: طبيعي, ب: طبيعي): منطقي {
    إذا (أ == ب) { أرجع صواب; };
    دع س: نوع_سي_جسر = (*ج).الأنواع[أ];
    دع ص: نوع_سي_جسر = (*ج).الأنواع[ب];
    إذا (س.الصنف == 10 && ص.الصنف == 3) { أرجع نوعان_متوافقان_جسر(ج, (*ج).الوسوم[س.الوسم].الأساس, ب); };
    إذا (ص.الصنف == 10 && س.الصنف == 3) { أرجع نوعان_متوافقان_جسر(ج, أ, (*ج).الوسوم[ص.الوسم].الأساس); };
    إذا (س.الصنف != ص.الصنف || س.ثابت != ص.ثابت) { أرجع خطأ; };
    دع ك: ط8 = س.الصنف;
    إذا (ك == 0 || ك == 1 || ك == 11) { أرجع صواب; };
    إذا (ك == 2 || ك == 3 || ك == 4) {
        أرجع س.العرض == ص.العرض && س.موقع == ص.موقع && س.الرتبة == ص.الرتبة && س.حرفي == ص.حرفي;
    };
    إذا (ك == 5) { أرجع نوعان_متوافقان_جسر(ج, س.الأساس, ص.الأساس); };
    إذا (ك == 6) {
        إذا (!س.مجهول_العدد && !ص.مجهول_العدد && س.العدد != ص.العدد) { أرجع خطأ; };
        أرجع نوعان_متوافقان_جسر(ج, س.الأساس, ص.الأساس);
    };
    إذا (ك == 8 || ك == 9 || ك == 10) { أرجع س.الوسم == ص.الوسم; };
    إذا (ك == 12) { أرجع س.الاسم == ص.الاسم; };
    إذا (ك == 7) {
        إذا (!نوعان_متوافقان_جسر(ج, س.الأساس, ص.الأساس)) { أرجع خطأ; };
        إذا (س.بلا_نموذج || ص.بلا_نموذج) { أرجع صواب; };
        إذا (س.عدد_المعطيات != ص.عدد_المعطيات || س.متغير_المعاملات != ص.متغير_المعاملات) { أرجع خطأ; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < س.عدد_المعطيات) {
            دع م1: طبيعي = (*ج).المعطيات[س.بداية_المعطيات + ف];
            دع م2: طبيعي = (*ج).المعطيات[ص.بداية_المعطيات + ف];
            إذا (!نوعان_متوافقان_بلا_مؤهل_جسر(ج, م1, م2)) { أرجع خطأ; };
            ف := ف + 1;
        }
        أرجع صواب;
    };
    أرجع خطأ;
}

عرف نوعان_متوافقان_بلا_مؤهل_جسر(ج: &جدول_أنواع_جسر, أ: طبيعي, ب: طبيعي): منطقي {
    إذا ((*ج).الأنواع[أ].ثابت != (*ج).الأنواع[ب].ثابت) {
        دع س: متغير نوع_سي_جسر = (*ج).الأنواع[أ];
        دع ص: نوع_سي_جسر = (*ج).الأنواع[ب];
        إذا (س.الصنف != ص.الصنف) { أرجع خطأ; };
        إذا (س.الصنف == 5) { أرجع نوعان_متوافقان_جسر(ج, س.الأساس, ص.الأساس); };
        أرجع س.الصنف == ص.الصنف && س.العرض == ص.العرض && س.موقع == ص.موقع && س.الوسم == ص.الوسم;
    };
    أرجع نوعان_متوافقان_جسر(ج, أ, ب);
}
