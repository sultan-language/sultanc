// Jisr core: the spelling interner, the token record, hide sets and
// diagnostics shared by the lexer, the preprocessor, the parser and the
// writer of compiler/jisr/jisr.
//
// Every spelling (identifier, number, literal, punctuator) is interned once
// and named by a dense id, as Clang's IdentifierTable does; a token is then a
// record of scalars, cheap to copy, and identifiers compare by id. Tables
// keyed by a name (macros, typedefs, tags) are vectors indexed by that id.
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.text.search;
استورد std.text.substring;
استورد std.text.transform;
استورد std.fs.path;
استورد std.text.number;
استورد std.math.wrapping;
استورد std.fs.read_file;
استورد compiler.diagnostics.foreign_c;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.record;

// ---- spelling interner ----

عام نوع مخزن_جسر = {
    البايتات: متجه ط8,
    البدايات: متجه طبيعي,
    الأطوال: متجه طبيعي,
    الهاشات: متجه طبيعي,
    // Open addressing: 0 is an empty slot, else the id stored there.
    الخانات: متجه طبيعي
};

عام عرف مخزن_جسر_جديد(): مخزن_جسر {
    دع البايتات: متجه ط8 = [];
    دع البدايات: متغير متجه طبيعي = [];
    دع الأطوال: متغير متجه طبيعي = [];
    دع الهاشات: متغير متجه طبيعي = [];
    دع الخانات: متغير متجه طبيعي = [];
    // Id 0 is the empty spelling.
    ألحق(البدايات, 0);
    ألحق(الأطوال, 0);
    ألحق(الهاشات, 0);
    دع ف: متغير طبيعي = 0;
    طالما (ف < 16384) { ألحق(الخانات, 0); ف := ف + 1; }
    دع الناتج: مخزن_جسر = {
        البايتات: البايتات, البدايات: البدايات, الأطوال: الأطوال,
        الهاشات: الهاشات, الخانات: الخانات
    };
    أرجع الناتج;
}

عام عرف هاش_مقطع_جسر(النص: &نص, البداية: طبيعي, الكم: طبيعي): طبيعي {
    دع ه: متغير طبيعي = 14695981039346656037;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الكم) {
        ه := ه ^ ((*النص)[البداية + ف] مثل طبيعي);
        ه := ضرب_طبيعي_ملتف(ه, 1099511628211);
        ف := ف + 1;
    }
    أرجع ه;
}

عرف مقطع_يساوي_معرفا_جسر(م: &مخزن_جسر, المعرف: طبيعي, النص: &نص, البداية: طبيعي, الكم: طبيعي): منطقي {
    إذا ((*م).الأطوال[المعرف] != الكم) { أرجع خطأ; };
    دع الأصل: طبيعي = (*م).البدايات[المعرف];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الكم) {
        إذا ((*م).البايتات[الأصل + ف] != (*النص)[البداية + ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف كبر_مخزن_جسر(م: &متغير مخزن_جسر): فراغ {
    دع السعة: طبيعي = (الطول((*م).الخانات) مثل طبيعي) * 2;
    دع الجديدة: متغير متجه طبيعي = [];
    احجز_سعة(الجديدة, السعة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الجديدة, 0); ف := ف + 1; }
    دع القناع: طبيعي = السعة - 1;
    دع م_ع: متغير طبيعي = 1;
    طالما (م_ع < (الطول((*م).البدايات) مثل طبيعي)) {
        دع خ: متغير طبيعي = (*م).الهاشات[م_ع] & القناع;
        طالما (الجديدة[خ] != 0) { خ := (خ + 1) & القناع; }
        الجديدة[خ] := م_ع;
        م_ع := م_ع + 1;
    }
    بدّل((*م).الخانات, الجديدة);
}

// The id of the spelling النص[البداية, البداية + الطول), interned.
عام عرف اعزل_مقطع_جسر(م: &متغير مخزن_جسر, النص: &نص, البداية: طبيعي, الكم: طبيعي): طبيعي {
    إذا (الكم == 0) { أرجع 0; };
    إذا ((الطول((*م).البدايات) مثل طبيعي) * 2 >= (الطول((*م).الخانات) مثل طبيعي)) { كبر_مخزن_جسر(م); };
    دع الهاش: طبيعي = هاش_مقطع_جسر(النص, البداية, الكم);
    دع القناع: طبيعي = (الطول((*م).الخانات) مثل طبيعي) - 1;
    دع خ: متغير طبيعي = الهاش & القناع;
    طالما (صواب) {
        دع ق: طبيعي = (*م).الخانات[خ];
        إذا (ق == 0) { اخرج_من_حلقة; };
        إذا ((*م).الهاشات[ق] == الهاش && مقطع_يساوي_معرفا_جسر(م, ق, النص, البداية, الكم)) { أرجع ق; };
        خ := (خ + 1) & القناع;
    }
    دع المعرف: طبيعي = الطول((*م).البدايات) مثل طبيعي;
    ألحق((*م).البدايات, الطول((*م).البايتات) مثل طبيعي);
    ألحق((*م).الأطوال, الكم);
    ألحق((*م).الهاشات, الهاش);
    دع ف: متغير طبيعي = 0;
    طالما (ف < الكم) { ألحق((*م).البايتات, (*النص)[البداية + ف]); ف := ف + 1; }
    (*م).الخانات[خ] := المعرف;
    أرجع المعرف;
}

عام عرف اعزل_نص_جسر(م: &متغير مخزن_جسر, النص: &نص): طبيعي {
    أرجع اعزل_مقطع_جسر(م, النص, 0, الطول(*النص) مثل طبيعي);
}

عام عرف اعزل_بايتات_جسر(م: &متغير مخزن_جسر, البايتات: &متجه ط8): طبيعي {
    دع النص: نص = انسخ_بايتات(البايتات) مثل نص;
    أرجع اعزل_نص_جسر(م, &النص);
}

عام عرف طول_معرف_جسر(م: &مخزن_جسر, المعرف: طبيعي): طبيعي { أرجع (*م).الأطوال[المعرف]; }

عام عرف بايت_معرف_جسر(م: &مخزن_جسر, المعرف: طبيعي, ف: طبيعي): ط8 {
    أرجع (*م).البايتات[(*م).البدايات[المعرف] + ف];
}

عام عرف نص_معرف_جسر(م: &مخزن_جسر, المعرف: طبيعي): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع الأصل: طبيعي = (*م).البدايات[المعرف];
    دع ن: طبيعي = (*م).الأطوال[المعرف];
    احجز_سعة(الناتج, ن);
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) { ألحق(الناتج, (*م).البايتات[الأصل + ف]); ف := ف + 1; }
    أرجع الناتج مثل نص;
}

عام عرف ألحق_معرف_جسر(م: &مخزن_جسر, المعرف: طبيعي, الهدف: &متغير متجه ط8): فراغ {
    دع الأصل: طبيعي = (*م).البدايات[المعرف];
    دع ن: طبيعي = (*م).الأطوال[المعرف];
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) { ألحق(*الهدف, (*م).البايتات[الأصل + ف]); ف := ف + 1; }
}

عام عرف معرف_يساوي_جسر(م: &مخزن_جسر, المعرف: طبيعي, النص: نص): منطقي {
    أرجع مقطع_يساوي_معرفا_جسر(م, المعرف, &النص, 0, الطول(النص) مثل طبيعي);
}

// The id of an already-interned spelling, or 0 (no insertion).
عام عرف ابحث_نص_جسر(م: &مخزن_جسر, النص: &نص): طبيعي {
    دع الطول_ن: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (الطول_ن == 0) { أرجع 0; };
    دع الهاش: طبيعي = هاش_مقطع_جسر(النص, 0, الطول_ن);
    دع القناع: طبيعي = (الطول((*م).الخانات) مثل طبيعي) - 1;
    دع خ: متغير طبيعي = الهاش & القناع;
    طالما (صواب) {
        دع ق: طبيعي = (*م).الخانات[خ];
        إذا (ق == 0) { أرجع 0; };
        إذا ((*م).الهاشات[ق] == الهاش && مقطع_يساوي_معرفا_جسر(م, ق, النص, 0, الطول_ن)) { أرجع ق; };
        خ := (خ + 1) & القناع;
    }
    أرجع 0;
}

// ---- tokens ----
// الصنف: 0 end, 1 identifier, 2 pp-number, 3 string literal, 4 character
// constant, 5 punctuator, 6 placemarker (an empty macro argument next to
// ##), 7 any other character, 8 `#pragma pack` marker for the parser (its
// value in المعرف: 0 pop/reset, else the packing; المخفية: 1 push).
// الأعلام: 1 first token of a line, 2 preceded by white space, 4 never
// expanded (an identifier painted by the hide-set rule), 8 a character no
// C identifier allows (lexer.sn; reported where the token is used), 16
// bytes that are not UTF-8, 32 a literal with an invalid escape sequence
// or universal character name. الطول: the source bytes the token spans
// (0 for a token no file spells, as a pasted or builtin one).

عام نوع رمز_جسر = {
    الصنف: ط8,
    المعرف: طبيعي,
    الملف: طبيعي,
    السطر: طبيعي,
    العمود: طبيعي,
    الأعلام: ط8,
    المخفية: طبيعي,
    الطول: طبيعي
};

عام عرف رمز_جسر_من(الصنف: ط8, المعرف: طبيعي, الملف: طبيعي, السطر: طبيعي, العمود: طبيعي, الأعلام: ط8): رمز_جسر {
    دع الناتج: رمز_جسر = {
        الصنف: الصنف, المعرف: المعرف, الملف: الملف, السطر: السطر, العمود: العمود,
        الأعلام: الأعلام, المخفية: 0, الطول: 0
    };
    أرجع الناتج;
}

عام عرف رمز_نهاية_جسر(): رمز_جسر { أرجع رمز_جسر_من(0, 0, 0, 0, 0, 1); }

عام عرف أول_سطر_جسر(الرمز: &رمز_جسر): منطقي { أرجع ((*الرمز).الأعلام & 1) != 0; }
عام عرف بعد_مسافة_جسر(الرمز: &رمز_جسر): منطقي { أرجع ((*الرمز).الأعلام & 2) != 0; }

// ---- hide sets (Prosser's algorithm) ----
// A hide set is a list in a shared pool; 0 is the empty set.

عام نوع عقدة_مخفية_جسر = { الماكرو: طبيعي, التالي: طبيعي };

عام عرف مخفيات_جسر_جديدة(): متجه عقدة_مخفية_جسر {
    دع الناتج: متغير متجه عقدة_مخفية_جسر = [];
    دع الأولى: عقدة_مخفية_جسر = { الماكرو: 0, التالي: 0 };
    ألحق(الناتج, الأولى);
    أرجع الناتج;
}

عام عرف تحوي_مخفية_جسر(العقد: &متجه عقدة_مخفية_جسر, المجموعة: طبيعي, الماكرو: طبيعي): منطقي {
    دع ف: متغير طبيعي = المجموعة;
    طالما (ف != 0) {
        إذا ((*العقد)[ف].الماكرو == الماكرو) { أرجع صواب; };
        ف := (*العقد)[ف].التالي;
    }
    أرجع خطأ;
}

عام عرف أضف_مخفية_جسر(العقد: &متغير متجه عقدة_مخفية_جسر, المجموعة: طبيعي, الماكرو: طبيعي): طبيعي {
    إذا (تحوي_مخفية_جسر(العقد, المجموعة, الماكرو)) { أرجع المجموعة; };
    دع العقدة: عقدة_مخفية_جسر = { الماكرو: الماكرو, التالي: المجموعة };
    ألحق(*العقد, العقدة);
    أرجع (الطول(*العقد) مثل طبيعي) - 1;
}

عام عرف اتحاد_مخفية_جسر(العقد: &متغير متجه عقدة_مخفية_جسر, أ: طبيعي, ب: طبيعي): طبيعي {
    إذا (أ == 0) { أرجع ب; };
    إذا (ب == 0) { أرجع أ; };
    دع الناتج: متغير طبيعي = ب;
    دع ف: متغير طبيعي = أ;
    طالما (ف != 0) {
        الناتج := أضف_مخفية_جسر(العقد, الناتج, (*العقد)[ف].الماكرو);
        ف := (*العقد)[ف].التالي;
    }
    أرجع الناتج;
}

عام عرف تقاطع_مخفية_جسر(العقد: &متغير متجه عقدة_مخفية_جسر, أ: طبيعي, ب: طبيعي): طبيعي {
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = أ;
    طالما (ف != 0) {
        دع الماكرو: طبيعي = (*العقد)[ف].الماكرو;
        إذا (تحوي_مخفية_جسر(العقد, ب, الماكرو)) { الناتج := أضف_مخفية_جسر(العقد, الناتج, الماكرو); };
        ف := (*العقد)[ف].التالي;
    }
    أرجع الناتج;
}

// ---- diagnostics ----
// A C diagnostic Jisr finds: a typed reason (compiler/diagnostics/
// reason.sn; each names one SULTANC-C-* identity, whose severity the
// registry holds), the C location and facts (الرمز, النوع, القيمة, ... :
// compiler/diagnostics/foreign_c.sn). Jisr never words a message: iSpeak
// does. الملف_ف is the file's index + 1 in the preprocessor's table (0:
// none), from which the #include chain is found when it is reported; خطأ_
// whether it fails the import; في_مقروءة whether it is an error in a header
// the import only reads (reported as SULTANC-C-READ-HEADER-UNTRANSLATED
// wrapping it, and not failing the import).

عام نوع تشخيص_جسر = {
    السجل: تشخيص_سي_منظم,
    الملف_ف: طبيعي,
    خطأ_: منطقي,
    في_مقروءة: منطقي
};

// A diagnostic of reason السبب at the C file الملف, line السطر, byte
// column العمود, spanning الطول bytes (0: a point; no file: no location).
عام عرف تشخيص_جسر_في(السبب: سبب_تشخيص, الملف: &نص, السطر: طبيعي, العمود: طبيعي, الطول: طبيعي): تشخيص_جسر {
    دع المعرف: متغير معرف_تشخيص = معرف_تشخيص.سي_خطأ_نحوي();
    طابق تشخيص_عام_لسبب(السبب) مع
    | اختياري.موجود(القيمة) -> { المعرف := القيمة; }
    | اختياري.لا_شيء -> { };
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(المعرف);
    دع خطأ_: متغير منطقي = خطأ;
    طابق التعريف.الشدة مع
    | شدة_تشخيص.خطأ -> { خطأ_ := صواب; }
    | _ -> { };
    دع الموقع: موقع_سي = موقع_سي_جديد(انسخ_نص(الملف), السطر, العمود, الطول, «»);
    دع الناتج: تشخيص_جسر = { السجل: تشخيص_سي_منظم_جديد(المعرف, السبب, الموقع), الملف_ف: 0, خطأ_: خطأ_, في_مقروءة: خطأ };
    أرجع الناتج;
}

// An error in a header the import only reads (none of its declarations is
// written): it does not fail the import.
عام عرف اجعله_في_مقروءة_جسر(التشخيص: &متغير تشخيص_جسر): فراغ {
    إذا (!(*التشخيص).خطأ_) { أرجع; };
    (*التشخيص).في_مقروءة := صواب;
    (*التشخيص).خطأ_ := خطأ;
}

// A diagnostic with no C location (the environment: no C headers, the
// preprocessor setting).
عام عرف تشخيص_جسر_بلا_موقع(السبب: سبب_تشخيص): تشخيص_جسر {
    دع لا_ملف: نص = «»;
    أرجع تشخيص_جسر_في(السبب, &لا_ملف, 0, 0, 0);
}

عام عرف أضف_تشخيص_جسر(التشخيصات: &متغير متجه تشخيص_جسر, التشخيص: تشخيص_جسر): فراغ {
    ألحق(*التشخيصات, التشخيص);
}

عام عرف فيها_خطأ_جسر(التشخيصات: &متجه تشخيص_جسر): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التشخيصات) مثل طبيعي)) {
        إذا ((*التشخيصات)[ف].خطأ_) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The C source line of a location, read when it is reported.
عرف مقتطف_موقع_جسر(الموقع: &موقع_سي): نص {
    إذا ((*الموقع).السطر == 0 || (الطول((*الموقع).الملف) مثل طبيعي) == 0) { أرجع «»; };
    طابق اقرأ_الملف(&(*الموقع).الملف) مع
    | نتيجة.نجح(المحتوى) -> { أرجع سطر_من_نص_جسر(&المحتوى, (*الموقع).السطر); }
    | نتيجة.خطأ(_) -> { أرجع «»; };
}

// Hands a diagnostic to the compiler's diagnostics (diagnostics/
// foreign_c.sn), with the C source lines its locations point at and the
// #include chain سلسلة (innermost first).
عام عرف أبلغ_تشخيص_جسر(التشخيص: &تشخيص_جسر, السلسلة: &متجه موقع_سي): فراغ {
    دع السجل: متغير تشخيص_سي_منظم = انسخ_تشخيص_سي_منظم_جسر(&(*التشخيص).السجل);
    السجل.الموقع.المقتطف := مقتطف_موقع_جسر(&السجل.الموقع);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(السجل.المرتبطة) مثل طبيعي)) {
        السجل.المرتبطة[ف].الموقع.المقتطف := مقتطف_موقع_جسر(&السجل.المرتبطة[ف].الموقع);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*السلسلة) مثل طبيعي)) {
        دع الموقع: متغير موقع_سي = انسخ_موقع_سي_جسر(&(*السلسلة)[ف]);
        الموقع.المقتطف := مقتطف_موقع_جسر(&الموقع);
        أضف_موقع_تضمين_سي(&متغير السجل, الموقع);
        ف := ف + 1;
    }
    إذا ((*التشخيص).في_مقروءة) { أبلغ_تشخيص_سي_منظم_في_ترويسة_مقروءة(السجل); أرجع; };
    أبلغ_تشخيص_سي_منظم(السجل);
}

عام عرف انسخ_موقع_سي_جسر(الموقع: &موقع_سي): موقع_سي {
    أرجع موقع_سي_جديد(انسخ_نص(&(*الموقع).الملف), (*الموقع).السطر, (*الموقع).العمود, (*الموقع).الطول,
        انسخ_نص(&(*الموقع).المقتطف));
}

عرف انسخ_تشخيص_سي_منظم_جسر(السجل: &تشخيص_سي_منظم): تشخيص_سي_منظم {
    دع الناتج: متغير تشخيص_سي_منظم = تشخيص_سي_منظم_جديد((*السجل).المعرف, (*السجل).السبب, انسخ_موقع_سي_جسر(&(*السجل).الموقع));
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السجل).الحجج) مثل طبيعي)) {
        ألحق(الناتج.الحجج, انسخ_مملوكا_حجة_تشخيص(&(*السجل).الحجج[ف]));
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*السجل).المرتبطة) مثل طبيعي)) {
        أضف_موقعا_مرتبطا_سي(&متغير الناتج, انسخ_موقع_سي_جسر(&(*السجل).المرتبطة[ف].الموقع), (*السجل).المرتبطة[ف].الدور);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Line السطر (1-based) of النص, without its line end.
عرف سطر_من_نص_جسر(النص: &نص, السطر: طبيعي): نص {
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    دع الحالي: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن && الحالي < السطر) {
        إذا ((*النص)[ف] == 10) { الحالي := الحالي + 1; };
        ف := ف + 1;
    }
    دع الناتج: متغير متجه ط8 = [];
    طالما (ف < ن && (*النص)[ف] != 10 && (*النص)[ف] != 13) { ألحق(الناتج, (*النص)[ف]); ف := ف + 1; }
    أرجع الناتج مثل نص;
}

// `CODE file:line:column`: where a diagnostic is, for the generated
// module's comments and its compile-time failure (a code, never wording).
عام عرف نص_تشخيص_جسر(التشخيص: &تشخيص_جسر): نص {
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص((*التشخيص).السجل.المعرف);
    دع الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, انسخ_نص(&التعريف.الكود));
    دع الموقع: &موقع_سي = &(*التشخيص).السجل.الموقع;
    إذا ((الطول((*الموقع).الملف) مثل طبيعي) > 0) {
        ألحق_بايتات_نص(&متغير الناتج, « »);
        ألحق_بايتات_نص(&متغير الناتج, انسخ_نص(&(*الموقع).الملف));
        إذا ((*الموقع).السطر > 0) {
            ألحق_بايتات_نص(&متغير الناتج, «:»);
            ألحق_بايتات_نص(&متغير الناتج, طبيعي_إلى_نص((*الموقع).السطر));
            ألحق_بايتات_نص(&متغير الناتج, «:»);
            ألحق_بايتات_نص(&متغير الناتج, طبيعي_إلى_نص((*الموقع).العمود));
        };
    };
    أرجع الناتج مثل نص;
}

// The directory a quoted `#include` in المسار searches first (C17 6.10.2:
// the including file's directory; `.`, the working directory, for a file
// named without one). The parent is std's أب_المسار.
عام عرف دليل_مسار_جسر(المسار: &نص): نص {
    طابق أب_المسار(المسار) مع
    | اختياري.موجود(الدليل) -> { أرجع الدليل; }
    | اختياري.لا_شيء -> { أرجع «.»; };
}

// A signed 64-bit word as decimal text.
عام عرف بتات_موقعة_نص_جسر(البتات: ط64): نص {
    إذا ((البتات & 0x8000000000000000) != 0) {
        إذا (البتات == 0x8000000000000000) { أرجع «-9223372036854775808»; };
        أرجع صل_نصين(&«-», &طبيعي_إلى_نص(طرح_ط64_ملتف(0, البتات) مثل طبيعي));
    };
    أرجع طبيعي_إلى_نص(البتات مثل طبيعي);
}
