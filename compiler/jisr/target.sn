// The C data model of a SultanC target, derived from its registered
// descriptor (backend/target): the widths, alignments and signedness of C's
// scalar types and the predefined macros of a C compiler for that target.
// Nothing here assumes the host: LLP64 on Windows, LP64 on other 64-bit
// targets, ILP32 on 32-bit ones, 16-bit int on AVR and MSP430.
استورد std.text.transform;
استورد std.text.from_bytes;
استورد std.text.number;
استورد compiler.backend.target.target_model;
استورد compiler.jisr.core;

عام نوع نموذج_سي_جسر = {
    التهجئة: نص,
    الثلاثي: نص,
    // Widths in bits.
    عرض_المؤشر: طبيعي,
    عرض_القصير: طبيعي,
    عرض_الصحيح: طبيعي,
    عرض_الطويل: طبيعي,
    عرض_الطويل_الطويل: طبيعي,
    عرض_الحرف_العريض: طبيعي,
    حرف_عريض_موقع: منطقي,
    عرض_wint: طبيعي,
    // Plain char is signed.
    حرف_موقع: منطقي,
    // long double: bytes and alignment; طويل_مزدوج_كمزدوج when it is the
    // IEEE double (it then has a SultanC form, f64).
    حجم_الطويل_المزدوج: طبيعي,
    محاذاة_الطويل_المزدوج: طبيعي,
    طويل_مزدوج_كمزدوج: منطقي,
    // Alignment of 8-byte scalars as struct members (4 on i386 System V).
    محاذاة_الثمانية_في_البنى: طبيعي,
    // Alignment of 8-byte scalars alone (_Alignof).
    محاذاة_الثمانية: طبيعي,
    أكبر_محاذاة: طبيعي,
    كبير_النهاية: منطقي,
    ويندوز: منطقي,
    إم_إس_في_سي: منطقي,
    داروين: منطقي,
    لينكس: منطقي,
    أندرويد: منطقي,
    فري_بي_إس_دي: منطقي,
    واسي: منطقي,
    // Mach-O (and 32-bit Windows) symbols carry a leading underscore that
    // the SultanC backends add themselves.
    بادئة_الرموز: نص,
    // The va_list kind: 0 a pointer (char *), 1 an array of one structure
    // (decays to a pointer as a parameter), 2 a structure passed by value.
    صنف_قائمة_المعاملات: ط8,
    حجم_قائمة_المعاملات: طبيعي,
    // Calling a variadic C function with only its fixed arguments through a
    // fixed-arity prototype is the same call on this target's C ABI
    // (AAPCS64, Apple arm64, Win64, i386, RISC-V); 2 when it is the same
    // only without floating fixed parameters (ARM hard-float); 0 when it is
    // not (System V x86-64 needs AL, PowerPC64 needs a save area, wasm).
    متغير_بالثابتة: ط8,
    // Multiarch directory name of Debian-style systems, "" when none.
    المتعدد: نص,
    هوية_المعمارية: هوية_معمارية,
    هوية_المنصة: هوية_منصة
};

عرف معمارية_ذراع_جسر(م: هوية_معمارية): منطقي {
    أرجع م == هوية_معمارية.ذراع_أربعة_وستون() || م == هوية_معمارية.ذراع_سبعة();
}

عام عرف نموذج_سي_من_هدف_جسر(الهدف: &واصف_هدف): نموذج_سي_جسر {
    دع المعمارية: هوية_معمارية = (*الهدف).المعمارية.الهوية;
    دع المنصة: هوية_منصة = (*الهدف).المنصة.المنصة;
    دع البيئة: هوية_بيئة = (*الهدف).المنصة.البيئة;
    دع المؤشر: طبيعي = (*الهدف).نموذج_البيانات.عرض_المؤشر;
    دع ويندوز: منطقي = المنصة == هوية_منصة.ويندوز();
    دع داروين: منطقي = المنصة == هوية_منصة.ماك_أو_إس() || المنصة == هوية_منصة.آي_أو_إس();
    دع لينكس: منطقي = المنصة == هوية_منصة.لينكس();
    دع أندرويد: منطقي = المنصة == هوية_منصة.أندرويد();
    دع فري: منطقي = المنصة == هوية_منصة.فري_بي_إس_دي();
    دع واسي: منطقي = المنصة == هوية_منصة.واسي();
    دع إكس64: منطقي = المعمارية == هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون();
    دع إكس32: منطقي = المعمارية == هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون();
    دع ذراع64: منطقي = المعمارية == هوية_معمارية.ذراع_أربعة_وستون();
    دع ذراع7: منطقي = المعمارية == هوية_معمارية.ذراع_سبعة();
    دع رايسك: منطقي = المعمارية == هوية_معمارية.رايسك_في_أربعة_وستون()
        || المعمارية == هوية_معمارية.رايسك_في_اثنان_وثلاثون();
    دع ويب: منطقي = المعمارية == هوية_معمارية.ويب_أسمبلي_اثنان_وثلاثون()
        || المعمارية == هوية_معمارية.ويب_أسمبلي_أربعة_وستون();

    دع الصحيح: متغير طبيعي = 32;
    دع الطويل: متغير طبيعي = المؤشر;
    إذا (المؤشر == 16) { الصحيح := 16; الطويل := 32; };
    إذا (ويندوز) { الطويل := 32; };
    إذا (المؤشر == 32) { الطويل := 32; };

    دع الحرف_موقع: متغير منطقي = صواب;
    إذا (!داروين && !ويندوز && (ذراع64 || ذراع7 || رايسك
        || المعمارية == هوية_معمارية.باور_بي_سي_أربعة_وستون()
        || المعمارية == هوية_معمارية.سيستم_زد())) {
        الحرف_موقع := خطأ;
    };

    دع العريض: متغير طبيعي = 32;
    دع العريض_موقع: متغير منطقي = صواب;
    دع عرض_wint: متغير طبيعي = 32;
    إذا (ويندوز) { العريض := 16; العريض_موقع := خطأ; عرض_wint := 16; }
    وإلا إذا (!داروين && (ذراع64 || ذراع7)) { العريض_موقع := خطأ; };

    // long double.
    دع حجم_ط_م: متغير طبيعي = 16;
    دع محاذاة_ط_م: متغير طبيعي = 16;
    دع كمزدوج: متغير منطقي = خطأ;
    إذا (ويندوز || (داروين && ذراع64) || ذراع7 || المؤشر == 16) {
        حجم_ط_م := 8; محاذاة_ط_م := 8; كمزدوج := صواب;
    } وإلا إذا (إكس32) {
        حجم_ط_م := 12; محاذاة_ط_م := 4;
    };

    دع ثمانية_في_البنى: متغير طبيعي = 8;
    إذا (إكس32 && !ويندوز) { ثمانية_في_البنى := 4; };
    إذا (المؤشر == 16) { ثمانية_في_البنى := 1; };
    دع ثمانية: متغير طبيعي = 8;
    إذا (المؤشر == 16) { ثمانية := 1; };

    دع أكبر_محاذاة: متغير طبيعي = 16;
    إذا (ويندوز || المؤشر == 32) { أكبر_محاذاة := 8; };
    إذا (المؤشر == 16) { أكبر_محاذاة := 1; };

    دع البادئة: متغير نص = «»;
    إذا (داروين) { البادئة := «_»; };

    دع صنف_ق: متغير ط8 = 0;
    دع حجم_ق: متغير طبيعي = المؤشر / 8;
    إذا (!ويندوز && !داروين) {
        إذا (إكس64) { صنف_ق := 1; حجم_ق := 24; }
        وإلا إذا (ذراع64) { صنف_ق := 2; حجم_ق := 32; }
        وإلا إذا (المعمارية == هوية_معمارية.باور_بي_سي_أربعة_وستون()
            || المعمارية == هوية_معمارية.سيستم_زد()) { صنف_ق := 1; حجم_ق := 32; };
    };

    دع متغير_ث: متغير ط8 = 0;
    إذا (ذراع64 || رايسك || إكس32 || (إكس64 && ويندوز)) { متغير_ث := 1; }
    وإلا إذا (ذراع7) { متغير_ث := 2; };

    دع المتعدد: متغير نص = «»;
    إذا (لينكس) {
        إذا (إكس64) { المتعدد := «x86_64-linux-gnu»; }
        وإلا إذا (ذراع64) { المتعدد := «aarch64-linux-gnu»; }
        وإلا إذا (إكس32) { المتعدد := «i386-linux-gnu»; }
        وإلا إذا (ذراع7) { المتعدد := «arm-linux-gnueabihf»; }
        وإلا إذا (المعمارية == هوية_معمارية.رايسك_في_أربعة_وستون()) { المتعدد := «riscv64-linux-gnu»; }
        وإلا إذا (المعمارية == هوية_معمارية.باور_بي_سي_أربعة_وستون()) { المتعدد := «powerpc64le-linux-gnu»; }
        وإلا إذا (المعمارية == هوية_معمارية.سيستم_زد()) { المتعدد := «s390x-linux-gnu»; }
        وإلا إذا (المعمارية == هوية_معمارية.لونغ_آرتش_أربعة_وستون()) { المتعدد := «loongarch64-linux-gnu»; }
        وإلا إذا (المعمارية == هوية_معمارية.ميبس_أربعة_وستون()) { المتعدد := «mips64el-linux-gnuabi64»; };
    };

    دع الناتج: نموذج_سي_جسر = {
        التهجئة: انسخ_نص(&(*الهدف).التهجئة),
        الثلاثي: انسخ_نص(&(*الهدف).الثلاثي_المقنن),
        عرض_المؤشر: المؤشر,
        عرض_القصير: 16,
        عرض_الصحيح: الصحيح,
        عرض_الطويل: الطويل,
        عرض_الطويل_الطويل: 64,
        عرض_الحرف_العريض: العريض,
        حرف_عريض_موقع: العريض_موقع,
        عرض_wint: عرض_wint,
        حرف_موقع: الحرف_موقع,
        حجم_الطويل_المزدوج: حجم_ط_م,
        محاذاة_الطويل_المزدوج: محاذاة_ط_م,
        طويل_مزدوج_كمزدوج: كمزدوج,
        محاذاة_الثمانية_في_البنى: ثمانية_في_البنى,
        محاذاة_الثمانية: ثمانية,
        أكبر_محاذاة: أكبر_محاذاة,
        كبير_النهاية: (*الهدف).نموذج_البيانات.ترتيب_البايت == ترتيب_بايت.كبير(),
        ويندوز: ويندوز,
        إم_إس_في_سي: البيئة == هوية_بيئة.إم_إس_في_سي(),
        داروين: داروين,
        لينكس: لينكس,
        أندرويد: أندرويد,
        فري_بي_إس_دي: فري,
        واسي: واسي,
        بادئة_الرموز: البادئة,
        صنف_قائمة_المعاملات: صنف_ق,
        حجم_قائمة_المعاملات: حجم_ق,
        متغير_بالثابتة: متغير_ث,
        المتعدد: المتعدد,
        هوية_المعمارية: المعمارية,
        هوية_المنصة: المنصة
    };
    أرجع الناتج;
}

// ---- predefined macros ----

عرف ماكرو_مسبق_جسر(الأسطر: &متغير متجه ط8, الاسم: نص, القيمة: نص): فراغ {
    ألحق_بايتات_نص(الأسطر, «#define »);
    ألحق_بايتات_نص(الأسطر, الاسم);
    ألحق_بايتات_نص(الأسطر, « »);
    ألحق_بايتات_نص(الأسطر, القيمة);
    ألحق(*الأسطر, 10);
}

// The C spelling of the integer type of a width and signedness, as GCC
// spells __INT64_TYPE__ and its relatives for the data model.
عرف اسم_نوع_صحيح_جسر(النموذج: &نموذج_سي_جسر, العرض: طبيعي, موقع: منطقي, يفضل_الطويل: منطقي): نص {
    دع الأساس: متغير نص = «int»;
    إذا (العرض == 8) { الأساس := «char»; }
    وإلا إذا (العرض == 16) { الأساس := «short»; }
    وإلا إذا (العرض == (*النموذج).عرض_الصحيح) { الأساس := «int»; }
    وإلا إذا (العرض == (*النموذج).عرض_الطويل && (يفضل_الطويل || العرض != 64)) { الأساس := «long int»; }
    وإلا { الأساس := «long long int»; };
    إذا (العرض == 8) {
        إذا (موقع) { أرجع «signed char»; };
        أرجع «unsigned char»;
    };
    إذا (موقع) { أرجع الأساس; };
    إذا (العرض == 16) { أرجع «unsigned short»; };
    أرجع صل_نصين(&«unsigned », &الأساس);
}

عرف أقصى_موقع_جسر(العرض: طبيعي): نص {
    إذا (العرض == 8) { أرجع «127»; };
    إذا (العرض == 16) { أرجع «32767»; };
    إذا (العرض == 32) { أرجع «2147483647»; };
    أرجع «9223372036854775807»;
}

عرف أقصى_طبيعي_جسر(العرض: طبيعي): نص {
    إذا (العرض == 8) { أرجع «255»; };
    إذا (العرض == 16) { أرجع «65535»; };
    إذا (العرض == 32) { أرجع «4294967295»; };
    أرجع «18446744073709551615»;
}

// The literal suffix that gives a constant the type of that width.
عرف لاحقة_جسر(النموذج: &نموذج_سي_جسر, العرض: طبيعي, موقع: منطقي): نص {
    إذا (العرض <= (*النموذج).عرض_الصحيح) {
        إذا (موقع) { أرجع «»; };
        أرجع «U»;
    };
    إذا (العرض == (*النموذج).عرض_الطويل) {
        إذا (موقع) { أرجع «L»; };
        أرجع «UL»;
    };
    إذا (موقع) { أرجع «LL»; };
    أرجع «ULL»;
}

// `c ## SUFFIX`, or `c` alone when there is no suffix.
عرف لصق_لاحقة_جسر(اللاحقة: نص): نص {
    إذا ((الطول(اللاحقة) مثل طبيعي) == 0) { أرجع «c»; };
    أرجع صل_نصين(&«c ## », &اللاحقة);
}

عرف ماكرو_نوع_جسر(الأسطر: &متغير متجه ط8, النموذج: &نموذج_سي_جسر, الاسم: نص, العرض: طبيعي, موقع: منطقي, يفضل_الطويل: منطقي): فراغ {
    ماكرو_مسبق_جسر(الأسطر, الاسم, اسم_نوع_صحيح_جسر(النموذج, العرض, موقع, يفضل_الطويل));
}

عرف ماكرو_أقصى_جسر(الأسطر: &متغير متجه ط8, النموذج: &نموذج_سي_جسر, الاسم: نص, العرض: طبيعي, موقع: منطقي): فراغ {
    إذا (موقع) {
        ماكرو_مسبق_جسر(الأسطر, الاسم, صل_نصين(&أقصى_موقع_جسر(العرض), &لاحقة_جسر(النموذج, العرض, صواب)));
    } وإلا {
        ماكرو_مسبق_جسر(الأسطر, الاسم, صل_نصين(&أقصى_طبيعي_جسر(العرض), &لاحقة_جسر(النموذج, العرض, خطأ)));
    };
}

// The predefined macros as C source (#define lines).
عام عرف ماكروهات_معرفة_مسبقا_جسر(النموذج: &نموذج_سي_جسر): نص {
    دع س: متغير متجه ط8 = [];
    دع م: &نموذج_سي_جسر = النموذج;
    دع المؤشر: طبيعي = (*م).عرض_المؤشر;
    دع ع64_طويل: منطقي = (*م).عرض_الطويل == 64;
    ماكرو_مسبق_جسر(&متغير س, «__STDC__», «1»);
    ماكرو_مسبق_جسر(&متغير س, «__STDC_VERSION__», «201710L»);
    ماكرو_مسبق_جسر(&متغير س, «__STDC_HOSTED__», «1»);
    ماكرو_مسبق_جسر(&متغير س, «__STDC_UTF_16__», «1»);
    ماكرو_مسبق_جسر(&متغير س, «__STDC_UTF_32__», «1»);
    ماكرو_مسبق_جسر(&متغير س, «__STDC_NO_COMPLEX__», «1»);
    ماكرو_مسبق_جسر(&متغير س, «__STDC_NO_VLA__», «1»);
    ماكرو_مسبق_جسر(&متغير س, «__jisr__», «1»);
    ماكرو_مسبق_جسر(&متغير س, «__VERSION__», «"Jisr (SultanC)"»);
    إذا ((*م).إم_إس_في_سي) {
        ماكرو_مسبق_جسر(&متغير س, «_MSC_VER», «1930»);
        ماكرو_مسبق_جسر(&متغير س, «_MSC_FULL_VER», «193000000»);
        ماكرو_مسبق_جسر(&متغير س, «_MSC_EXTENSIONS», «1»);
        ماكرو_مسبق_جسر(&متغير س, «_INTEGRAL_MAX_BITS», «64»);
    } وإلا {
        // GNU C as Clang presents it: version 4.2.1, the GNU extensions
        // system headers expect (attributes, __extension__, asm labels).
        ماكرو_مسبق_جسر(&متغير س, «__GNUC__», «4»);
        ماكرو_مسبق_جسر(&متغير س, «__GNUC_MINOR__», «2»);
        ماكرو_مسبق_جسر(&متغير س, «__GNUC_PATCHLEVEL__», «1»);
        ماكرو_مسبق_جسر(&متغير س, «__GNUC_STDC_INLINE__», «1»);
    };
    ماكرو_مسبق_جسر(&متغير س, «__NO_INLINE__», «1»);
    ماكرو_مسبق_جسر(&متغير س, «__FINITE_MATH_ONLY__», «0»);
    ماكرو_مسبق_جسر(&متغير س, «__CHAR_BIT__», «8»);
    ماكرو_مسبق_جسر(&متغير س, «__ORDER_LITTLE_ENDIAN__», «1234»);
    ماكرو_مسبق_جسر(&متغير س, «__ORDER_BIG_ENDIAN__», «4321»);
    ماكرو_مسبق_جسر(&متغير س, «__ORDER_PDP_ENDIAN__», «3412»);
    إذا ((*م).كبير_النهاية) {
        ماكرو_مسبق_جسر(&متغير س, «__BYTE_ORDER__», «__ORDER_BIG_ENDIAN__»);
        ماكرو_مسبق_جسر(&متغير س, «__BIG_ENDIAN__», «1»);
    } وإلا {
        ماكرو_مسبق_جسر(&متغير س, «__BYTE_ORDER__», «__ORDER_LITTLE_ENDIAN__»);
        ماكرو_مسبق_جسر(&متغير س, «__LITTLE_ENDIAN__», «1»);
    };
    ماكرو_مسبق_جسر(&متغير س, «__USER_LABEL_PREFIX__», انسخ_نص(&(*م).بادئة_الرموز));
    ماكرو_مسبق_جسر(&متغير س, «__REGISTER_PREFIX__», «»);
    ماكرو_مسبق_جسر(&متغير س, «__BIGGEST_ALIGNMENT__», طبيعي_إلى_نص((*م).أكبر_محاذاة));
    إذا (المؤشر == 64 && ع64_طويل) {
        ماكرو_مسبق_جسر(&متغير س, «__LP64__», «1»);
        ماكرو_مسبق_جسر(&متغير س, «_LP64», «1»);
    };
    إذا (المؤشر == 32) {
        ماكرو_مسبق_جسر(&متغير س, «__ILP32__», «1»);
