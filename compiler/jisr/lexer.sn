// The C lexer of Jisr: translation phases 1-3 for one file. Comments
// become white space, backslash-newline splices join lines (between and
// inside tokens' surroundings; a splice inside an identifier or number
// splits it, which no header relies on), and the text becomes preprocessing
// tokens: identifiers, pp-numbers, string and character literals (with
// their L/u/U/u8 prefixes), punctuators (digraphs spelled canonically) and
// any other character. Each token records its file, line and column and
// whether it starts a line or follows white space, which the preprocessor
// needs for directives, stringizing and function-like macro calls.
استورد std.text.from_bytes;
استورد std.chars.ascii;
استورد std.encoding.utf8;
استورد std.unicode.properties;
استورد compiler.diagnostics.reason;
استورد std.text.substring;
استورد compiler.jisr.core;
استورد compiler.jisr.literals;

// ---- identifiers (C17 6.4.2, with C23's Unicode rule) ----
// An identifier is a letter, `_` or `$` (a common extension), then those
// and digits; beyond ASCII, a character written in UTF-8 or as a
// universal character name (\u hhhh, \U hhhhhhhh) may start one when it
// is XID_Start and continue one when it is XID_Continue (C23 6.4.2.1,
// Unicode's Default Identifier Syntax; std.unicode). A universal name
// must also name an allowed character (literals.sn). Any other character
// beyond ASCII is a token of its own, flagged so that its use is an error.

// C adds `_` and `$` (an extension every C compiler has) to the ASCII
// letters and digits of an identifier.
عرف علامة_معرف_سي_جسر(ب: ط8): منطقي { أرجع ب == 0x5F || ب == 0x24; }

// One character of an identifier's form at ف: its code point and the
// bytes it spans (0: none here: not a byte an identifier has, invalid
// UTF-8, or a backslash that starts no universal name); اسم_عام: written as a
// universal character name.
نوع محرف_معرف_جسر = { القيمة: ط32, العرض: طبيعي, اسم_عام: منطقي };

عرف محرف_معرف_جسر_من(القيمة: ط32, العرض: طبيعي, اسم_عام: منطقي): محرف_معرف_جسر {
    دع الناتج: محرف_معرف_جسر = { القيمة: القيمة, العرض: العرض, اسم_عام: اسم_عام };
    أرجع الناتج;
}

عرف محرف_معرف_عند_جسر(النص: &نص, ف: طبيعي, ن: طبيعي): محرف_معرف_جسر {
    دع ب: ط8 = (*النص)[ف];
    إذا (محرف_أسكي(ب) && ب != 0x5C) { أرجع محرف_معرف_جسر_من(ب مثل ط32, 1, خطأ); };
    إذا (ب == 0x5C) {
        إذا (ف + 1 >= ن || ((*النص)[ف + 1] != 0x75 && (*النص)[ف + 1] != 0x55)) { أرجع محرف_معرف_جسر_من(0, 0, خطأ); };
        دع الحد: متغير طبيعي = 4;
        إذا ((*النص)[ف + 1] == 0x55) { الحد := 8; };
        إذا (ف + 2 + الحد > ن) { أرجع محرف_معرف_جسر_من(0, 0, خطأ); };
        دع القيمة: متغير ط32 = 0;
        دع ك: متغير طبيعي = 0;
        طالما (ك < الحد) {
            دع الرقم: عدد = قيمة_سداسية((*النص)[ف + 2 + ك]);
            إذا (الرقم < 0) { أرجع محرف_معرف_جسر_من(0, 0, خطأ); };
            إذا (القيمة > 0x0FFFFFFF) { القيمة := 0xFFFFFFFF; } وإلا { القيمة := القيمة * 16 + (الرقم مثل ط32); };
            ك := ك + 1;
        }
        أرجع محرف_معرف_جسر_من(القيمة, 2 + الحد, صواب);
    };
    دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, ف);
    إذا (!المفكوك.صالح) { أرجع محرف_معرف_جسر_من(0, 0, خطأ); };
    أرجع محرف_معرف_جسر_من(المفكوك.القيمة, المفكوك.العرض, خطأ);
}

// A character written as itself in one byte is ASCII (UTF-8); a universal
// name may not name an ASCII character other than `$`, `@` and `` ` ``
// (اسم_محرف_عام_مسموح_جسر), none of which std's XID properties allow.
عرف يبدأ_معرفا_جسر(المحرف: &محرف_معرف_جسر): منطقي {
    إذا ((*المحرف).العرض == 0) { أرجع خطأ; };
    دع ق: ط32 = (*المحرف).القيمة;
    إذا ((*المحرف).اسم_عام && !اسم_محرف_عام_مسموح_جسر(ق مثل ط64)) { أرجع خطأ; };
    إذا (!(*المحرف).اسم_عام && (*المحرف).العرض == 1) { أرجع حرف_لاتيني(ق مثل ط8) || علامة_معرف_سي_جسر(ق مثل ط8); };
    أرجع بداية_معرف_يونيكود(ق);
}

عرف يتابع_معرفا_جسر(المحرف: &محرف_معرف_جسر): منطقي {
    إذا ((*المحرف).العرض == 0) { أرجع خطأ; };
    دع ق: ط32 = (*المحرف).القيمة;
    إذا ((*المحرف).اسم_عام && !اسم_محرف_عام_مسموح_جسر(ق مثل ط64)) { أرجع خطأ; };
    إذا (!(*المحرف).اسم_عام && (*المحرف).العرض == 1) { أرجع حرف_أو_رقم_أسكي(ق مثل ط8) || علامة_معرف_سي_جسر(ق مثل ط8); };
    أرجع استمرار_معرف_يونيكود(ق);
}

// The spelling of the identifier [البداية, النهاية) with each universal
// character name written as its UTF-8 bytes, so that `\u00E9` and `é`
// are one identifier (C17 6.4.2.1p3).
عرف تهجئة_معرف_جسر(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع المحرف: محرف_معرف_جسر = محرف_معرف_عند_جسر(النص, ف, النهاية);
        إذا (المحرف.اسم_عام) {
            دع الفارغ: متجه ط8 = [];
            طابق ألحق_محرف_يوتيف8(الفارغ, المحرف.القيمة) مع
            | نتيجة_ترميز_يوتيف8.مشفر(المشفر) -> { ألحق_من(البايتات, &المشفر, 0, الطول(المشفر) مثل طبيعي); }
            | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> { };
            ف := ف + المحرف.العرض;
        } وإلا {
            ألحق(البايتات, (*النص)[ف]);
            ف := ف + 1;
        };
    }
    أرجع البايتات مثل نص;
}

// The length of the punctuator at ف, and its canonical spelling when it is
// a digraph (else "").
نوع علامة_مقطوعة_جسر = { الطول: طبيعي, البديل: نص };

عرف علامة_جسر(الطول_ع: طبيعي, البديل: نص): علامة_مقطوعة_جسر {
    دع الناتج: علامة_مقطوعة_جسر = { الطول: الطول_ع, البديل: البديل };
    أرجع الناتج;
}

عرف اقطع_علامة_جسر(النص: &نص, ف: طبيعي, ن: طبيعي): علامة_مقطوعة_جسر {
    دع أ: ط8 = (*النص)[ف];
    دع ب: متغير ط8 = 0;
    دع ج: متغير ط8 = 0;
    دع د: متغير ط8 = 0;
    إذا (ف + 1 < ن) { ب := (*النص)[ف + 1]; };
    إذا (ف + 2 < ن) { ج := (*النص)[ف + 2]; };
    إذا (ف + 3 < ن) { د := (*النص)[ف + 3]; };
    // Four and three characters.
    إذا (أ == 0x25 && ب == 0x3A && ج == 0x25 && د == 0x3A) { أرجع علامة_جسر(4, «##»); };
    إذا (أ == 0x2E && ب == 0x2E && ج == 0x2E) { أرجع علامة_جسر(3, «»); };
    إذا ((أ == 0x3C || أ == 0x3E) && ب == أ && ج == 0x3D) { أرجع علامة_جسر(3, «»); };
    // Digraphs.
    إذا (أ == 0x3C && ب == 0x3A) { أرجع علامة_جسر(2, «[»); };
    إذا (أ == 0x3A && ب == 0x3E) { أرجع علامة_جسر(2, «]»); };
    إذا (أ == 0x3C && ب == 0x25) { أرجع علامة_جسر(2, «{»); };
    إذا (أ == 0x25 && ب == 0x3E) { أرجع علامة_جسر(2, «}»); };
    إذا (أ == 0x25 && ب == 0x3A) { أرجع علامة_جسر(2, «#»); };
    // Two characters.
    إذا (أ == 0x2D && (ب == 0x3E || ب == 0x2D || ب == 0x3D)) { أرجع علامة_جسر(2, «»); };
    إذا (أ == 0x2B && (ب == 0x2B || ب == 0x3D)) { أرجع علامة_جسر(2, «»); };
    إذا ((أ == 0x3C || أ == 0x3E) && (ب == أ || ب == 0x3D)) { أرجع علامة_جسر(2, «»); };
    إذا ((أ == 0x3D || أ == 0x21 || أ == 0x2A || أ == 0x2F || أ == 0x25 || أ == 0x5E) && ب == 0x3D) { أرجع علامة_جسر(2, «»); };
    إذا ((أ == 0x26 || أ == 0x7C) && (ب == أ || ب == 0x3D)) { أرجع علامة_جسر(2, «»); };
    إذا (أ == 0x23 && ب == 0x23) { أرجع علامة_جسر(2, «»); };
    إذا (أ == 0x3A && ب == 0x3A) { أرجع علامة_جسر(2, «»); };
    أرجع علامة_جسر(1, «»);
}

عرف علامة_مفردة_جسر(ب: ط8): منطقي {
    // [ ] ( ) { } . & * + - ~ ! / % < > ^ | ? : ; = , #
    أرجع ب == 0x5B || ب == 0x5D || ب == 0x28 || ب == 0x29 || ب == 0x7B || ب == 0x7D || ب == 0x2E
        || ب == 0x26 || ب == 0x2A || ب == 0x2B || ب == 0x2D || ب == 0x7E || ب == 0x21 || ب == 0x2F
        || ب == 0x25 || ب == 0x3C || ب == 0x3E || ب == 0x5E || ب == 0x7C || ب == 0x3F || ب == 0x3A
        || ب == 0x3B || ب == 0x3D || ب == 0x2C || ب == 0x23;
}

// Whether the identifier [البداية, ف) is a string or character literal
// prefix (L, u, U, u8).
عرف بادئة_حرفية_جسر(النص: &نص, البداية: طبيعي, ف: طبيعي): منطقي {
    دع ن: طبيعي = ف - البداية;
    إذا (ن == 1) {
        دع ب: ط8 = (*النص)[البداية];
        أرجع ب == 0x4C || ب == 0x75 || ب == 0x55;
    };
    أرجع ن == 2 && (*النص)[البداية] == 0x75 && (*النص)[البداية + 1] == 0x38;
}

// Lexes النص, the contents of file الملف (at path المسار), appending its
// tokens to الرموز.
عام عرف اقطع_جسر(
    المخزن: &متغير مخزن_جسر,
    النص: &نص,
    الملف: طبيعي,
    المسار: &نص,
    الرموز: &متغير متجه رمز_جسر,
    التشخيصات: &متغير متجه تشخيص_جسر
): فراغ {
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    دع السطر: متغير طبيعي = 1;
    دع بداية_السطر: متغير طبيعي = 0;
    دع أول: متغير منطقي = صواب;
    دع مسافة: متغير منطقي = خطأ;
    // A UTF-8 byte order mark is not text.
    إذا (ن >= 3 && (*النص)[0] == 0xEF && (*النص)[1] == 0xBB && (*النص)[2] == 0xBF) { ف := 3; };
    طالما (ف < ن) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب == 0x0A) {
            ف := ف + 1;
            السطر := السطر + 1;
            بداية_السطر := ف;
            أول := صواب;
            مسافة := خطأ;
            تابع_حلقة;
        };
        إذا (ب == 0x20 || ب == 0x09 || ب == 0x0D || ب == 0x0C || ب == 0x0B) {
            ف := ف + 1;
            مسافة := صواب;
            تابع_حلقة;
        };
        // Backslash-newline (also before CR LF): the line continues.
        إذا (ب == 0x5C && ف + 1 < ن && ((*النص)[ف + 1] == 0x0A
            || ((*النص)[ف + 1] == 0x0D && ف + 2 < ن && (*النص)[ف + 2] == 0x0A))) {
            إذا ((*النص)[ف + 1] == 0x0D) { ف := ف + 3; } وإلا { ف := ف + 2; };
            السطر := السطر + 1;
            بداية_السطر := ف;
            مسافة := صواب;
            تابع_حلقة;
        };
        إذا (ب == 0x2F && ف + 1 < ن && (*النص)[ف + 1] == 0x2A) {
            دع سطر_البداية: طبيعي = السطر;
            دع عمود_البداية: طبيعي = ف - بداية_السطر + 1;
            ف := ف + 2;
            دع مغلق: متغير منطقي = خطأ;
            طالما (ف < ن) {
                إذا ((*النص)[ف] == 0x2A && ف + 1 < ن && (*النص)[ف + 1] == 0x2F) {
                    ف := ف + 2;
                    مغلق := صواب;
                    اخرج_من_حلقة;
                };
                إذا ((*النص)[ف] == 0x0A) { السطر := السطر + 1; بداية_السطر := ف + 1; };
                ف := ف + 1;
            }
            إذا (!مغلق) {
                دع ت: متغير تشخيص_جسر = تشخيص_جسر_في(سبب_تشخيص.سبب_سي_تعليق_غير_منته(), المسار, سطر_البداية, عمود_البداية, 2);
                ت.الملف_ف := الملف + 1;
                أضف_تشخيص_جسر(التشخيصات, ت);
            };
            مسافة := صواب;
            تابع_حلقة;
        };
        إذا (ب == 0x2F && ف + 1 < ن && (*النص)[ف + 1] == 0x2F) {
            طالما (ف < ن && (*النص)[ف] != 0x0A) {
                إذا ((*النص)[ف] == 0x5C && ف + 1 < ن && (*النص)[ف + 1] == 0x0A) {
                    ف := ف + 2;
                    السطر := السطر + 1;
                    بداية_السطر := ف;
                    تابع_حلقة;
                };
                ف := ف + 1;
            }
            مسافة := صواب;
            تابع_حلقة;
        };
        دع الأعلام: متغير ط8 = 0;
        إذا (أول) { الأعلام := الأعلام | 1; };
        إذا (مسافة) { الأعلام := الأعلام | 2; };
        أول := خطأ;
        مسافة := خطأ;
        دع البدء: طبيعي = ف;
        دع العمود: طبيعي = ف - بداية_السطر + 1;
        دع الصنف: متغير ط8 = 7;
        دع البديل: متغير نص = «»;
        دع حرفي: متغير منطقي = خطأ;
        دع الأول: محرف_معرف_جسر = محرف_معرف_عند_جسر(النص, ف, ن);
        إذا (يبدأ_معرفا_جسر(&الأول)) {
            ف := ف + الأول.العرض;
            دع فيه_عام: متغير منطقي = الأول.اسم_عام;
            طالما (ف < ن) {
                دع التالي: محرف_معرف_جسر = محرف_معرف_عند_جسر(النص, ف, ن);
                إذا (!يتابع_معرفا_جسر(&التالي)) { اخرج_من_حلقة; };
                إذا (التالي.اسم_عام) { فيه_عام := صواب; };
                ف := ف + التالي.العرض;
            }
            الصنف := 1;
            إذا (فيه_عام) { البديل := تهجئة_معرف_جسر(النص, البدء, ف); };
            إذا (ف < ن && ((*النص)[ف] == 0x22 || (*النص)[ف] == 0x27) && بادئة_حرفية_جسر(النص, البدء, ف)) {
                حرفي := صواب;
            };
        } وإلا إذا (!محرف_أسكي(ب)) {
            // A character beyond ASCII that starts no identifier, or bytes
            // that are not UTF-8: a token of its own (one character, or one
            // byte of an invalid sequence), an error where it is used.
            إذا (الأول.العرض == 0) {
                ف := ف + 1;
                الأعلام := الأعلام | 16;
            } وإلا {
                ف := ف + الأول.العرض;
                الأعلام := الأعلام | 8;
            };
        } وإلا إذا (الأول.اسم_عام) {
            // A universal character name no identifier may start with.
            ف := ف + الأول.العرض;
            الأعلام := الأعلام | 8;
        } وإلا إذا (رقم_عشري(ب) || (ب == 0x2E && ف + 1 < ن && رقم_عشري((*النص)[ف + 1]))) {
            ف := ف + 1;
            طالما (ف < ن) {
                دع ت: ط8 = (*النص)[ف];
                إذا ((ت == 0x2B || ت == 0x2D) && ((*النص)[ف - 1] == 0x65 || (*النص)[ف - 1] == 0x45
                    || (*النص)[ف - 1] == 0x70 || (*النص)[ف - 1] == 0x50)) {
                    ف := ف + 1;
                } وإلا إذا (حرف_أو_رقم_أسكي(ت) || علامة_معرف_سي_جسر(ت) || ت == 0x2E) {
                    ف := ف + 1;
                } وإلا إذا (ت == 0x27 && ف + 1 < ن && (حرف_أو_رقم_أسكي((*النص)[ف + 1]) || علامة_معرف_سي_جسر((*النص)[ف + 1]))) {
                    // C23 digit separator.
                    ف := ف + 1;
                } وإلا {
                    اخرج_من_حلقة;
                };
            }
            الصنف := 2;
        } وإلا إذا (ب == 0x22 || ب == 0x27) {
            حرفي := صواب;
        } وإلا إذا (علامة_مفردة_جسر(ب)) {
            دع العلامة: علامة_مقطوعة_جسر = اقطع_علامة_جسر(النص, ف, ن);
            ف := ف + العلامة.الطول;
            البديل := انسخ_نص(&العلامة.البديل);
            الصنف := 5;
        } وإلا {
            ف := ف + 1;
        };
        إذا (حرفي) {
            // A literal from its prefix (if any) to the closing quote.
            دع الاقتباس: ط8 = (*النص)[ف];
            دع ك: متغير طبيعي = ف + 1;
            دع مغلق: متغير منطقي = خطأ;
            طالما (ك < ن) {
                دع ت: ط8 = (*النص)[ك];
                إذا (ت == الاقتباس) { مغلق := صواب; ك := ك + 1; اخرج_من_حلقة; };
                إذا (ت == 0x0A) { اخرج_من_حلقة; };
                إذا (ت == 0x5C && ك + 1 < ن) { ك := ك + 2; تابع_حلقة; };
                ك := ك + 1;
            }
            إذا (مغلق) {
                ف := ك;
                إذا (الاقتباس == 0x22) { الصنف := 3; } وإلا { الصنف := 4; };
                // Its bytes must be UTF-8 and its escapes valid (reported
                // where the literal is used).
                إذا (!مدى_يوتيف8_صالح(النص, البدء, ف)) { الأعلام := الأعلام | 16; }
                وإلا {
                    دع الحرفي: متغير نص = «»;
                    إذا ((ف) > (البدء)) {
                        طابق مقطع_نص(النص, البدء, (ف) - (البدء)) مع
                        | اختياري.موجود(المقطع_ن) -> { الحرفي := المقطع_ن; }
                        | اختياري.لا_شيء -> { الحرفي := «»; };
                    };
                    دع المفكوك: حرفي_مفكوك_جسر = فك_حرفي_جسر(&الحرفي);
                    إذا (!المفكوك.صالح) { الأعلام := الأعلام | 32; };
                };
            } وإلا إذا (ف == البدء) {
                // A lone quote (an apostrophe in skipped text): one
                // character; the parser reports it if it is ever used.
                ف := ف + 1;
                الصنف := 7;
            };
        };
        دع المعرف: متغير طبيعي = 0;
        إذا ((الطول(البديل) مثل طبيعي) > 0) {
            المعرف := اعزل_نص_جسر(المخزن, &البديل);
        } وإلا {
            المعرف := اعزل_مقطع_جسر(المخزن, النص, البدء, ف - البدء);
        };
        دع الرمز: متغير رمز_جسر = رمز_جسر_من(الصنف, المعرف, الملف, السطر, العمود, الأعلام);
        الرمز.الطول := ف - البدء;
        ألحق(*الرموز, الرمز);
    }
}
