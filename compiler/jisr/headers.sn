// The text of the builtin header الاسم ("stddef.h", ...), if Jisr has one.
عام عرف رأس_مدمج_جسر(الاسم: &نص): اختياري نص {
    إذا (نصان_متساويان(الاسم, &«stddef.h»)) { أرجع اختياري.موجود(رأس_stddef_جسر()); };
    إذا (نصان_متساويان(الاسم, &«stdarg.h»)) { أرجع اختياري.موجود(رأس_stdarg_جسر()); };
    إذا (نصان_متساويان(الاسم, &«stdbool.h»)) { أرجع اختياري.موجود(رأس_stdbool_جسر()); };
    إذا (نصان_متساويان(الاسم, &«stdint.h»)) { أرجع اختياري.موجود(رأس_stdint_جسر()); };
    إذا (نصان_متساويان(الاسم, &«limits.h»)) { أرجع اختياري.موجود(رأس_limits_جسر()); };
    إذا (نصان_متساويان(الاسم, &«float.h»)) { أرجع اختياري.موجود(رأس_float_جسر()); };
    إذا (نصان_متساويان(الاسم, &«stdalign.h»)) { أرجع اختياري.موجود(رأس_stdalign_جسر()); };
    إذا (نصان_متساويان(الاسم, &«stdnoreturn.h»)) { أرجع اختياري.موجود(رأس_stdnoreturn_جسر()); };
    إذا (نصان_متساويان(الاسم, &«iso646.h»)) { أرجع اختياري.موجود(رأس_iso646_جسر()); };
    أرجع اختياري.لا_شيء();
}

