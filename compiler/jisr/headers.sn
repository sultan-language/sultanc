    دع الأسطر: متجه نص = [
        «#ifndef __JISR_FLOAT_H»,
        «#define __JISR_FLOAT_H»,
        «#define FLT_RADIX 2»,
        «#define FLT_EVAL_METHOD 0»,
        «#define DECIMAL_DIG 17»,
        «#define FLT_DECIMAL_DIG 9»,
        «#define DBL_DECIMAL_DIG 17»,
        «#define FLT_MANT_DIG 24»,
        «#define DBL_MANT_DIG 53»,
        «#define FLT_DIG 6»,
