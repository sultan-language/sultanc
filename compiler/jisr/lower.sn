        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(ش.النصوص[ي]) مثل طبيعي)) { ألحق(ل.البيانات, ش.النصوص[ي][ك]); ك := ك + 1; }
        الحجم := الحجم + (الطول(ش.النصوص[ي]) مثل طبيعي);
