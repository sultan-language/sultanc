// The initialization routine (ج_هيئ): every initializer element that is
// not constant bytes of the data block.
عرف اكتب_تهيئة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر): فراغ {
    دع فارغ: متجه ط8 = [];
    (*ل).السطور := فارغ;
    (*ل).المسافة := 2;
    (*ل).الإطار := 0;
    (*ل).الدالة := 0;
    (*ل).بداية_المحليات := 0;
    (*ل).يستعمل_البيانات := خطأ;
    (*ل).يستعمل_الخيط := خطأ;
    (*ل).يستعمل_الإطار := خطأ;
    دع بلا_أسماء: متجه نص = [];
    (*ل).أسماء := بلا_أسماء;
    سطر_ل_جسر(ل, «ج_مهيأ := true;»);
    إذا ((*ل).نهاية_الخيط > 0) { سطر_ل_جسر(ل, «append(ج_خيوط_ق, أنشئ_ذرة_ط32(0));»); };
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول((*ش).العوام) مثل طبيعي)) {
        دع ع: عام_جسم_جسر = (*ش).العوام[ي];
        دع الاسم: نص = انسخ_نص(&(*ل).أسماء_العوام[ي]);
        دع ك: متغير طبيعي = 0;
        طالما (ك < ع.عدد_المهيئ) {
            دع العنصر: عنصر_مهيئ_جسر = (*ش).المهيئات[ع.بداية_المهيئ + ك];
            ك := ك + 1;
            إذا (العنصر.التعبير == 0) { تابع_حلقة; };
            دع ت: تعبير_جسر = (*ش).التعابير[العنصر.التعبير - 1];
            إذا ((الطول(الاسم) مثل طبيعي) > 0) {
                // A scalar variable: constants are its initial value.
                إذا (ت.الصنف == 1 || ت.الصنف == 2) { تابع_حلقة; };
                دع ق: نص = قيمة_ل_جسر(ل, م, ش, العنصر.التعبير - 1);
                دع أجزاء_ج274: متجه نص = [انسخ_نص(&الاسم), « := », ق, «;»];
                سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج274, &«»));
                تابع_حلقة;
            };
            إذا (العنصر.الحقل == 0 && ت.الصنف == 1 && !تجميعي_ن_جسر(م, العنصر.النوع)) { تابع_حلقة; };
            دع الأساس: نص = عنوان_بيانات_جسر(ل, (*ل).إزاحات_العوام[ي]);
            اكتب_عناصر_جسر(ل, م, ش, الأساس, ع.بداية_المهيئ + ك - 1, 1);
        }
        ي := ي + 1;
    }
    ألحق_بايتات_نص(&متغير (*ل).الوحدة, «let ج_مهيأ: mutable bool = false;»);
    ألحق((*ل).الوحدة, 10);
    دع الرأس: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الرأس, «def ج_هيئ(): void {»);
    ألحق(الرأس, 10);
    ألحق_بايتات_نص(&متغير الرأس, «    unsafe {»);
    ألحق(الرأس, 10);
    اكتب_مقدمة_جسر(ل, م, &متغير الرأس);
    ألحق_من((*ل).الوحدة, &الرأس, 0, الطول(الرأس) مثل طبيعي);
    ألحق_من((*ل).الوحدة, &(*ل).السطور, 0, الطول((*ل).السطور) مثل طبيعي);
    ألحق_بايتات_نص(&متغير (*ل).الوحدة, «    }»);
    ألحق((*ل).الوحدة, 10);
    ألحق_بايتات_نص(&متغير (*ل).الوحدة, «}»);
    ألحق((*ل).الوحدة, 10);
}

// The public functions: each compiled C function with external linkage,
// under its C name with the signature emit.sn gives an extern (typed
// pointers, records by value).
// The file of the body of function الكيان (its definition).
عرف ملف_تعريف_جسر(م: &محلل_جسر, الكيان: طبيعي): طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*م).التعريفات) مثل طبيعي)) {
        دع التعريف: &تعريف_جسر = &(*م).التعريفات[ف];
        إذا ((*التعريف).الصنف == 1 && (*التعريف).الكيان == الكيان && (*التعريف).البداية < (الطول((*م).الرموز) مثل طبيعي)) {
            أرجع (*م).الرموز[(*التعريف).البداية].الملف;
        };
        ف := ف + 1;
    }
    أرجع (*م).الكيانات[الكيان].الملف;
}

عرف اكتب_أغلفة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر): فراغ {
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول((*ش).الدوال) مثل طبيعي)) {
        دع الدالة: دالة_جسم_جسر = (*ش).الدوال[ي];
        ي := ي + 1;
        دع الكيان: كيان_سي_جسر = (*م).الكيانات[الدالة.الكيان];
        دع الاسم_ج: نص = اسم_م_جسر(م, الكيان.الاسم);
        إذا (الكيان.ساكن || نصان_متساويان(&الاسم_ج, &«main») || اسم_مخفي_جسر(م, &الاسم_ج)) { تابع_حلقة; };
        إذا ((الطول((*ل).أسماء_الدوال[الدالة.الكيان]) مثل طبيعي) == 0) { تابع_حلقة; };
        // Declared in a header of another directory, defined here: the
        // definition's file decides.
        إذا (!عائلي_م_جسر(م, الكيان.الملف) && !عائلي_م_جسر(م, ملف_تعريف_جسر(م, الدالة.الكيان))) { تابع_حلقة; };
        دع ن: نوع_سي_جسر = (*م).ج.الأنواع[الكيان.النوع];
        دع الناتج_ن: طبيعي = ن.الأساس;
        دع المعاملات: متغير متجه ط8 = [];
        دع الحجج: متغير متجه ط8 = [];
        دع المقدمة: متغير متجه ط8 = [];
        دع صالح: متغير منطقي = صواب;
        دع تجميعي_ن: منطقي = تجميعي_ن_جسر(م, الناتج_ن);
        دع ناتج_س: نص = تهجئة_ل_جسر(ل, م, الناتج_ن, 1);
        إذا ((الطول(ناتج_س) مثل طبيعي) == 0) { صالح := خطأ; };
        إذا (تجميعي_ن) {
            دع الكلمات: طبيعي = (حجم_ن_جسر(م, الناتج_ن) + 7) / 8;
            دع التخزين: زوج_نص_جسر = تخزين_كلمات_جسر(اختر_ط_ل_جسر(الكلمات == 0, 1, الكلمات));
            دع أجزاء_ج275: متجه نص = [«        let ج_ن_إ: mutable », انسخ_نص(&التخزين.الأول), « = », انسخ_نص(&التخزين.الثاني), «;»];
            سطر_ب_جسر(&متغير المقدمة, صل_النصوص(&أجزاء_ج275, &«»));
            سطر_ب_جسر(&متغير المقدمة, صل_ثلاثة_نصوص(&«        let ج_ن_ق: *mutable », &التخزين.الأول, &« = &mutable ج_ن_إ;»));
            ألحق_بايتات_نص(&متغير الحجج, صل_نصين(&«ج_ن_ق as », &كلمة_ل_جسر(م)));
        };
        دع ك: متغير طبيعي = 0;
        طالما (ك < ن.عدد_المعطيات) {
            دع النوع_م: طبيعي = (*م).ج.المعطيات[ن.بداية_المعطيات + ك];
            دع التهجئة: نص = تهجئة_ل_جسر(ل, م, النوع_م, 0);
            إذا ((الطول(التهجئة) مثل طبيعي) == 0) { صالح := خطأ; اخرج_من_حلقة; };
            إذا (ك > 0) { ألحق_بايتات_نص(&متغير المعاملات, «, »); };
            ألحق_بايتات_نص(&متغير المعاملات, صل_ثلاثة_نصوص(&صل_نصين(&«p», &طبيعي_إلى_نص(ك)), &«: », &التهجئة));
            إذا ((الطول(الحجج) مثل طبيعي) > 0) { ألحق_بايتات_نص(&متغير الحجج, «, »); };
            دع المعامل: نص = صل_نصين(&«p», &طبيعي_إلى_نص(ك));
            إذا (تجميعي_ن_جسر(م, النوع_م)) {
                دع النسخة: نص = صل_نصين(&«ج_س», &طبيعي_إلى_نص(ك));
                دع أجزاء_ج282: متجه نص = [«        let », انسخ_نص(&النسخة), «: mutable », انسخ_نص(&التهجئة), « = », انسخ_نص(&المعامل), «;»];
                سطر_ب_جسر(&متغير المقدمة, صل_النصوص(&أجزاء_ج282, &«»));
                دع أجزاء_ج283: متجه نص = [«        let », انسخ_نص(&النسخة), «_ق: *mutable », انسخ_نص(&التهجئة), « = &mutable », انسخ_نص(&النسخة), «;»];
                سطر_ب_جسر(&متغير المقدمة, صل_النصوص(&أجزاء_ج283, &«»));
                ألحق_بايتات_نص(&متغير الحجج, صل_ثلاثة_نصوص(&النسخة, &«_ق as », &كلمة_ل_جسر(م)));
            } وإلا {
                دع التمثيل: نص = تمثيل_جسر(م, النوع_م);
                إذا (نصان_متساويان(&التهجئة, &التمثيل)) { ألحق_بايتات_نص(&متغير الحجج, المعامل); }
                وإلا { دع أجزاء_ج285: متجه نص = [«(», المعامل, « as », التمثيل, «)»]; ألحق_بايتات_نص(&متغير الحجج, صل_النصوص(&أجزاء_ج285, &«»)); };
            };
            ك := ك + 1;
        }
        // A variadic function: the public function takes the fixed arguments
        // only (a SultanC call); ج_متغيرة_NAME takes the variadic ones too,
        // as an array of 8-byte slots, for the calls of other units of the
        // import (units.sn).
        دع حجج_الخانات: متغير متجه ط8 = [];
        إذا (ن.متغير_المعاملات) {
            ألحق_من(حجج_الخانات, &الحجج, 0, الطول(الحجج) مثل طبيعي);
            إذا ((الطول(الحجج) مثل طبيعي) > 0) {
                ألحق_بايتات_نص(&متغير الحجج, «, »);
                ألحق_بايتات_نص(&متغير حجج_الخانات, «, »);
            };
            ألحق_بايتات_نص(&متغير الحجج, صل_ثلاثة_نصوص(&«(0 as », &كلمة_ل_جسر(م), &«)»));
            ألحق_بايتات_نص(&متغير حجج_الخانات, «ج_خانات_د»);
        };
        دع المرشح: نص = اسم_سلطان_جسر(&الاسم_ج);
        إذا (!صالح) {
            علق_تخطيا_جسر(م, &متغير (*ل).الكاتب, الكيان.الاسم, الكيان.الملف, الكيان.السطر, الكيان.العمود, سبب_تشخيص.سبب_سي_مترجمة_غير_قابلة_للنداء(), «»);
            تابع_حلقة;
        };
        إذا (احجز_اسما_جسر(م, &متغير (*ل).الكاتب, &المرشح) == 0) {
            علق_تخطيا_جسر(م, &متغير (*ل).الكاتب, الكيان.الاسم, الكيان.الملف, الكيان.السطر, الكيان.العمود, سبب_تشخيص.سبب_سي_مخطى_اسم_مستعمل(), «»);
            تابع_حلقة;
        };
        دع الداخلي: نص = انسخ_نص(&(*ل).أسماء_الدوال[الدالة.الكيان]);
        دع المعاملات_ن: نص = المعاملات مثل نص;
        دع أجزاء_ج287: متجه نص = [«public def », انسخ_نص(&المرشح), «(», انسخ_نص(&المعاملات_ن), «): », انسخ_نص(&ناتج_س), « {»];
        دع الرأس: نص = صل_النصوص(&أجزاء_ج287, &«»);
        دع أجزاء_ج288: متجه نص = [انسخ_نص(&الداخلي), «(», من_بايتات(&الحجج), «)»];
        اكتب_غلافا_جسر(ل, م, &الرأس, &المقدمة, صل_النصوص(&أجزاء_ج288, &«»), &ناتج_س, الناتج_ن, تجميعي_ن);
        إذا (ن.متغير_المعاملات) {
