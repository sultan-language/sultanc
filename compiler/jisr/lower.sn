    }
    ي := 0;
    طالما (ي < (الطول(ش.العوام) مثل طبيعي)) {
        إذا (ش.العوام[ي].الكيان != 0) { المتخطاة[ش.العوام[ي].الكيان - 1] := صواب; };
        ي := ي + 1;
    }
    دع الكاتب: متغير كاتب_جسر = كاتب_جديد_جسر(م, صواب);
    اكتب_تصريحات_جسر(م, &متغير الكاتب, الملف, &المتخطاة);
    دع ل: متغير خافض_جسر = خافض_جديد_جسر(الكاتب);
    مدد_كيانات_جسر(&متغير ل, م);
    ي := 0;
    طالما (ي < (الطول(ش.الدوال) مثل طبيعي)) {
        دع الكيان: طبيعي = ش.الدوال[ي].الكيان;
        إذا (المترجمة[ي]) { ل.أسماء_الدوال[الكيان] := صل_نصين(&«ج_», &اسم_داخلي_جسر(اسم_م_جسر(م, (*م).الكيانات[الكيان].الاسم))); };
        ل.دوال_الكيانات[الكيان] := ي + 1;
        ي := ي + 1;
    }
    دع كبير: منطقي = (*م).النموذج.كبير_النهاية;
    // The string literals, then the file-scope objects, in the data block.
    دع الحجم: متغير طبيعي = 0;
    ي := 0;
    طالما (ي < (الطول(ش.النصوص) مثل طبيعي)) {
        الحجم := محاذاة_ل_جسر(الحجم, 4);
