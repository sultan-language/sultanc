            دع أجزاء_ج291: متجه نص = [«def ج_متغيرة_», اسم_داخلي_جسر(انسخ_نص(&الاسم_ج)), «(», انسخ_نص(&المعاملات_ن),
                صل_ثلاثة_نصوص(&الفاصلة, &«ج_خانات_د: », &كلمة_ل_جسر(م)), «): », صل_نصين(&ناتج_س, &« {»)];
            دع رأس_الخانات: نص = صل_النصوص(&أجزاء_ج291, &«»);
            دع أجزاء_ج292: متجه نص = [الداخلي, «(», من_بايتات(&حجج_الخانات), «)»];
