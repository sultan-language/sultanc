// A wrapper: الرأس, then a call of the compiled function (النداء) with the
// lines المقدمة before it, returning its result as ناتج_س.
عرف اكتب_غلافا_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, الرأس: &نص, المقدمة: &متجه ط8, النداء: نص, ناتج_س: &نص,
    الناتج_ن: طبيعي, تجميعي_ن: منطقي): فراغ {
    دع النص_أ: متغير متجه ط8 = [];
    سطر_ب_جسر(&متغير النص_أ, انسخ_نص(الرأس));
    سطر_ب_جسر(&متغير النص_أ, «    if (!ج_مهيأ) { ج_هيئ(); };»);
    سطر_ب_جسر(&متغير النص_أ, «    unsafe {»);
    ألحق_من(النص_أ, المقدمة, 0, الطول(*المقدمة) مثل طبيعي);
    إذا (تجميعي_ن) {
        سطر_ب_جسر(&متغير النص_أ, صل_ثلاثة_نصوص(&«        », &النداء, &«;»));
        دع أجزاء_ج294: متجه نص = [«        return *((ج_ن_ق as », كلمة_ل_جسر(م), «) as *», انسخ_نص(ناتج_س), «);»];
        سطر_ب_جسر(&متغير النص_أ, صل_النصوص(&أجزاء_ج294, &«»));
    } وإلا إذا ((*م).ج.الأنواع[الناتج_ن].الصنف == 1) {
        سطر_ب_جسر(&متغير النص_أ, صل_ثلاثة_نصوص(&«        », &النداء, &«;»));
    } وإلا {
        دع التمثيل: نص = تمثيل_جسر(م, الناتج_ن);
        إذا (نصان_متساويان(ناتج_س, &التمثيل)) { سطر_ب_جسر(&متغير النص_أ, صل_ثلاثة_نصوص(&«        return », &النداء, &«;»)); }
        وإلا { دع أجزاء_ج297: متجه نص = [«        return (», النداء, « as », انسخ_نص(ناتج_س), «);»]; سطر_ب_جسر(&متغير النص_أ, صل_النصوص(&أجزاء_ج297, &«»)); };
    };
    سطر_ب_جسر(&متغير النص_أ, «    }»);
    سطر_ب_جسر(&متغير النص_أ, «}»);
    ألحق_من((*ل).الوحدة, &النص_أ, 0, الطول(النص_أ) مثل طبيعي);
}

عرف سطر_ب_جسر(الهدف: &متغير متجه ط8, النص: نص): فراغ {
    ألحق_بايتات_نص(الهدف, النص);
    ألحق(*الهدف, 10);
}

// The helpers the compiled code calls, and the frame block types.
عرف اكتب_مساعدات_جسر(الناتج: &متغير متجه ط8, م: &محلل_جسر): فراغ {
    دع ك: نص = كلمة_ل_جسر(م);
    سطر_جسر(الناتج, «def ج_ص(الشرط: bool): i32 { if (الشرط) { return 1; }; return 0; }»);
    سطر_جسر(الناتج, «def ج_ب(الشرط: bool): u8 { if (الشرط) { return 1; }; return 0; }»);
    سطر_جسر(الناتج, «let ج_صفر_مقسوم: mutable i32 = 0;»);
    // A trap: a division by zero (SultanC traps on it everywhere).
    سطر_جسر(الناتج, «def ج_فخ(): void { let القسمة: i32 = 1 / ج_صفر_مقسوم; }»);
    دع أجزاء_ج299: متجه نص = [«def ج_انسخ(الوجهة: », انسخ_نص(&ك), «, المصدر: », انسخ_نص(&ك), صل_ثلاثة_نصوص(&«, العدد: », &ك, &«): void {»)];
    سطر_جسر(الناتج, صل_النصوص(&أجزاء_ج299, &«»));
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«    unsafe { let ف: mutable », &ك, &« = 0; while (ف < العدد) {»));
    سطر_جسر(الناتج, «        let الموضع: *mutable u8 = (الوجهة + ف) as *mutable u8; *الموضع := *((المصدر + ف) as *u8); ف := ف + 1; } }»);
    سطر_جسر(الناتج, «}»);
    دع أجزاء_ج301: متجه نص = [«def ج_صفر_ذاكرة(الوجهة: », انسخ_نص(&ك), «, العدد: », انسخ_نص(&ك), «): void {»];
    سطر_جسر(الناتج, صل_النصوص(&أجزاء_ج301, &«»));
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«    unsafe { let ف: mutable », &ك, &« = 0; while (ف < العدد) {»));
    سطر_جسر(الناتج, «        let الموضع: *mutable u8 = (الوجهة + ف) as *mutable u8; *الموضع := 0; ف := ف + 1; } }»);
    سطر_جسر(الناتج, «}»);
    // Bit-fields (little-endian bit order), read and written bytewise.
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«def ج_اقرأ_بتات(العنوان: », &ك, &«, البت: u64, العرض: u64): u64 {»));
    سطر_جسر(الناتج, «    let البداية: u64 = البت / 8; let الإزاحة: u64 = البت % 8; let العدد: u64 = (الإزاحة + العرض + 7) / 8;»);
    سطر_جسر(الناتج, «    let القيمة: mutable u64 = 0; let ف: mutable u64 = 0;»);
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«    unsafe { while (ف < العدد && ف < 8) { let البايت: u64 = (*((العنوان + ((البداية + ف) as », &ك, &«)) as *u8)) as u64;»));
    سطر_جسر(الناتج, «        القيمة := القيمة | (البايت << (ف * 8)); ف := ف + 1; } }»);
    سطر_جسر(الناتج, «    let الناتج: mutable u64 = القيمة >> الإزاحة;»);
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«    if (العدد > 8) { unsafe { let البايت: u64 = (*((العنوان + ((البداية + 8) as », &ك, &«)) as *u8)) as u64;»));
    سطر_جسر(الناتج, «        الناتج := الناتج | إزاحة_يسرى_ط64_ملتفة(البايت, (64 - الإزاحة) as u32); } };»);
    سطر_جسر(الناتج, «    if (العرض < 64) { الناتج := الناتج & ((1 << العرض) - 1); };»);
    سطر_جسر(الناتج, «    return الناتج;»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«def ج_اكتب_بتات(العنوان: », &ك, &«, البت: u64, العرض: u64, القيمة: u64): void {»));
    سطر_جسر(الناتج, «    let ف: mutable u64 = 0;»);
    سطر_جسر(الناتج, «    while (ف < العرض) {»);
    سطر_جسر(الناتج, «        let الموضع: u64 = البت + ف; let البايت_ف: u64 = الموضع / 8; let بت_البايت: u64 = الموضع % 8;»);
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«        unsafe { let الخلية: *mutable u8 = (العنوان + (البايت_ف as », &ك, &«)) as *mutable u8;»));
    سطر_جسر(الناتج, «            let القناع: u8 = (1 << بت_البايت) as u8;»);
    سطر_جسر(الناتج, «            if (((القيمة >> ف) & 1) == 1) { *الخلية := *الخلية | القناع; } else { *الخلية := *الخلية & (القناع ^ 255); }; }»);
    سطر_جسر(الناتج, «        ف := ف + 1;»);
    سطر_جسر(الناتج, «    }»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_امدد(القيمة: u64, الإزاحة: u64): i64 { return إزاحة_يمنى_ص64_ملتفة(إزاحة_يسرى_ط64_ملتفة(القيمة, الإزاحة as u32) as i64, الإزاحة as u32); }»);
    دع ف128: متغير طبيعي = 0;
    طالما (ف128 < (الطول((*م).ج.الأنواع) مثل طبيعي)) {
        إذا ((*م).ج.الأنواع[ف128].الصنف == 3 && (*م).ج.الأنواع[ف128].العرض == 128) {
            اكتب_مساعدات128_جسر(الناتج);
            اخرج_من_حلقة;
        };
        ف128 := ف128 + 1;
    }
    // Frame blocks.
    دع ك32: متغير متجه ط8 = [];
    دع ز32: متغير متجه ط8 = [];
    دع ي: متغير طبيعي = 0;
    طالما (ي < 32) {
        إذا (ي > 0) { ألحق_بايتات_نص(&متغير ك32, «, »); ألحق_بايتات_نص(&متغير ز32, «, »); };
        ألحق_بايتات_نص(&متغير ك32, «u64»);
        ألحق_بايتات_نص(&متغير ز32, «0»);
        ي := ي + 1;
    }
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«type ج_ك32 = (», &من_بايتات(&ك32), &«);»));
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«def ج_صفر32(): ج_ك32 { let الكتلة: ج_ك32 = (», &من_بايتات(&ز32), &«); return الكتلة; }»));
    دع ك1024: متغير متجه ط8 = [];
    دع ز1024: متغير متجه ط8 = [];
    دع ك32ك: متغير متجه ط8 = [];
    دع ز32ك: متغير متجه ط8 = [];
    ي := 0;
    طالما (ي < 32) {
        إذا (ي > 0) {
            ألحق_بايتات_نص(&متغير ك1024, «, »); ألحق_بايتات_نص(&متغير ز1024, «, »);
            ألحق_بايتات_نص(&متغير ك32ك, «, »); ألحق_بايتات_نص(&متغير ز32ك, «, »);
        };
        ألحق_بايتات_نص(&متغير ك1024, «ج_ك32»);
        ألحق_بايتات_نص(&متغير ز1024, «ج_صفر32()»);
        ألحق_بايتات_نص(&متغير ك32ك, «ج_ك1024»);
        ألحق_بايتات_نص(&متغير ز32ك, «ج_صفر1024()»);
        ي := ي + 1;
    }
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«type ج_ك1024 = (», &من_بايتات(&ك1024), &«);»));
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«def ج_صفر1024(): ج_ك1024 { let الكتلة: ج_ك1024 = (», &من_بايتات(&ز1024), &«); return الكتلة; }»));
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«type ج_ك32ك = (», &من_بايتات(&ك32ك), &«);»));
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«def ج_صفر32ك(): ج_ك32ك { let الكتلة: ج_ك32ك = (», &من_بايتات(&ز32ك), &«); return الكتلة; }»));
}

// The 128-bit integers (__int128, unsigned __int128) of compiled code:
// two words, low first, each operation a helper (wrapping as C's unsigned
// arithmetic; division and remainder truncate, by zero they trap).
عرف اكتب_مساعدات128_جسر(الناتج: &متغير متجه ط8): فراغ {
    سطر_جسر(الناتج, «type ج_ص128 = { lo: u64, hi: u64 };»);
    سطر_جسر(الناتج, «type ج_ط128 = { lo: u64, hi: u64 };»);
    سطر_جسر(الناتج, «def ج_ط128_بني(lo: u64, hi: u64): ج_ط128 { let ن: ج_ط128 = { lo: lo, hi: hi }; return ن; }»);
    سطر_جسر(الناتج, «def ج_ص128_بني(lo: u64, hi: u64): ج_ص128 { let ن: ج_ص128 = { lo: lo, hi: hi }; return ن; }»);
    سطر_جسر(الناتج, «def ج_ط128_من_ص128(a: ج_ص128): ج_ط128 { return ج_ط128_بني(a.lo, a.hi); }»);
    سطر_جسر(الناتج, «def ج_ط128_منخفض(a: ج_ط128): u64 { return a.lo; }»);
    سطر_جسر(الناتج, «def ج_ص128_منخفض(a: ج_ص128): u64 { return a.lo; }»);
    سطر_جسر(الناتج, «def ج_ص128_من_ط128(a: ج_ط128): ج_ص128 { return ج_ص128_بني(a.lo, a.hi); }»);
    سطر_جسر(الناتج, «def ج_ط128_من_ط64(v: u64): ج_ط128 { return ج_ط128_بني(v, 0); }»);
    سطر_جسر(الناتج, «def ج_ط128_من_ص64(v: i64): ج_ط128 { if (v < 0) { return ج_ط128_بني(v as u64, 18446744073709551615); }; return ج_ط128_بني(v as u64, 0); }»);
    سطر_جسر(الناتج, «def ج_ص128_من_ط64(v: u64): ج_ص128 { return ج_ص128_بني(v, 0); }»);
    سطر_جسر(الناتج, «def ج_ص128_من_ص64(v: i64): ج_ص128 { return ج_ص128_من_ط128(ج_ط128_من_ص64(v)); }»);
    سطر_جسر(الناتج, «def ج_ط128_جمع(a: ج_ط128, b: ج_ط128): ج_ط128 {»);
    سطر_جسر(الناتج, «    let lo: u64 = جمع_ط64_ملتف(a.lo, b.lo);»);
    سطر_جسر(الناتج, «    let c: mutable u64 = 0;»);
    سطر_جسر(الناتج, «    if (lo < a.lo) { c := 1; };»);
    سطر_جسر(الناتج, «    return ج_ط128_بني(lo, جمع_ط64_ملتف(جمع_ط64_ملتف(a.hi, b.hi), c));»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ط128_طرح(a: ج_ط128, b: ج_ط128): ج_ط128 {»);
    سطر_جسر(الناتج, «    let c: mutable u64 = 0;»);
    سطر_جسر(الناتج, «    if (a.lo < b.lo) { c := 1; };»);
    سطر_جسر(الناتج, «    return ج_ط128_بني(طرح_ط64_ملتف(a.lo, b.lo), طرح_ط64_ملتف(طرح_ط64_ملتف(a.hi, b.hi), c));»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ط64_ضرب_كامل(a: u64, b: u64): ج_ط128 {»);
    سطر_جسر(الناتج, «    let a0: u64 = a & 4294967295; let a1: u64 = a >> 32;»);
    سطر_جسر(الناتج, «    let b0: u64 = b & 4294967295; let b1: u64 = b >> 32;»);
    سطر_جسر(الناتج, «    let p00: u64 = a0 * b0; let p01: u64 = a0 * b1; let p10: u64 = a1 * b0; let p11: u64 = a1 * b1;»);
    سطر_جسر(الناتج, «    let mid: u64 = (p00 >> 32) + (p01 & 4294967295) + (p10 & 4294967295);»);
    سطر_جسر(الناتج, «    let lo: u64 = (p00 & 4294967295) | إزاحة_يسرى_ط64_ملتفة(mid, 32);»);
    سطر_جسر(الناتج, «    let hi: u64 = جمع_ط64_ملتف(جمع_ط64_ملتف(جمع_ط64_ملتف(p11, p01 >> 32), p10 >> 32), mid >> 32);»);
    سطر_جسر(الناتج, «    return ج_ط128_بني(lo, hi);»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ط128_ضرب(a: ج_ط128, b: ج_ط128): ج_ط128 {»);
    سطر_جسر(الناتج, «    let r: ج_ط128 = ج_ط64_ضرب_كامل(a.lo, b.lo);»);
    سطر_جسر(الناتج, «    let hi: u64 = جمع_ط64_ملتف(جمع_ط64_ملتف(r.hi, ضرب_ط64_ملتف(a.lo, b.hi)), ضرب_ط64_ملتف(a.hi, b.lo));»);
    سطر_جسر(الناتج, «    return ج_ط128_بني(r.lo, hi);»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ط128_و(a: ج_ط128, b: ج_ط128): ج_ط128 { return ج_ط128_بني(a.lo & b.lo, a.hi & b.hi); }»);
    سطر_جسر(الناتج, «def ج_ط128_أو(a: ج_ط128, b: ج_ط128): ج_ط128 { return ج_ط128_بني(a.lo | b.lo, a.hi | b.hi); }»);
    سطر_جسر(الناتج, «def ج_ط128_عدا(a: ج_ط128, b: ج_ط128): ج_ط128 { return ج_ط128_بني(a.lo ^ b.lo, a.hi ^ b.hi); }»);
    سطر_جسر(الناتج, «def ج_ط128_متمم(a: ج_ط128): ج_ط128 { return ج_ط128_بني(a.lo ^ 18446744073709551615, a.hi ^ 18446744073709551615); }»);
    سطر_جسر(الناتج, «def ج_ط128_يسار(a: ج_ط128, ع: u64): ج_ط128 {»);
    سطر_جسر(الناتج, «    let n: u64 = ع & 127;»);
    سطر_جسر(الناتج, «    if (n == 0) { return a; };»);
    سطر_جسر(الناتج, «    if (n >= 64) { return ج_ط128_بني(0, إزاحة_يسرى_ط64_ملتفة(a.lo, (n - 64) as u32)); };»);
    سطر_جسر(الناتج, «    return ج_ط128_بني(إزاحة_يسرى_ط64_ملتفة(a.lo, n as u32), إزاحة_يسرى_ط64_ملتفة(a.hi, n as u32) | (a.lo >> (64 - n)));»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ط128_يمين(a: ج_ط128, ع: u64): ج_ط128 {»);
    سطر_جسر(الناتج, «    let n: u64 = ع & 127;»);
    سطر_جسر(الناتج, «    if (n == 0) { return a; };»);
    سطر_جسر(الناتج, «    if (n >= 64) { return ج_ط128_بني(a.hi >> (n - 64), 0); };»);
    سطر_جسر(الناتج, «    return ج_ط128_بني((a.lo >> n) | إزاحة_يسرى_ط64_ملتفة(a.hi, (64 - n) as u32), a.hi >> n);»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ط128_قارن(a: ج_ط128, b: ج_ط128): i32 {»);
    سطر_جسر(الناتج, «    if (a.hi < b.hi) { return -1; }; if (a.hi > b.hi) { return 1; };»);
    سطر_جسر(الناتج, «    if (a.lo < b.lo) { return -1; }; if (a.lo > b.lo) { return 1; };»);
    سطر_جسر(الناتج, «    return 0;»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ص128_قارن(a: ج_ص128, b: ج_ص128): i32 {»);
    سطر_جسر(الناتج, «    let ah: i64 = a.hi as i64; let bh: i64 = b.hi as i64;»);
    سطر_جسر(الناتج, «    if (ah < bh) { return -1; }; if (ah > bh) { return 1; };»);
    سطر_جسر(الناتج, «    if (a.lo < b.lo) { return -1; }; if (a.lo > b.lo) { return 1; };»);
    سطر_جسر(الناتج, «    return 0;»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ط128_ليس_صفرا(a: ج_ط128): bool { return a.lo != 0 || a.hi != 0; }»);
    سطر_جسر(الناتج, «def ج_ص128_ليس_صفرا(a: ج_ص128): bool { return a.lo != 0 || a.hi != 0; }»);
    سطر_جسر(الناتج, «def ج_ص128_سالب(a: ج_ص128): bool { return (a.hi >> 63) == 1; }»);
    سطر_جسر(الناتج, «// Unsigned division (الباقي: the remainder instead of the quotient).»);
    سطر_جسر(الناتج, «def ج_ط128_قسم(a: ج_ط128, b: ج_ط128, الباقي: bool): ج_ط128 {»);
    سطر_جسر(الناتج, «    if (!ج_ط128_ليس_صفرا(b)) { ج_فخ(); };»);
    سطر_جسر(الناتج, «    let q: mutable ج_ط128 = ج_ط128_بني(0, 0);»);
    سطر_جسر(الناتج, «    let r: mutable ج_ط128 = ج_ط128_بني(0, 0);»);
    سطر_جسر(الناتج, «    let i: mutable u64 = 128;»);
    سطر_جسر(الناتج, «    while (i > 0) {»);
    سطر_جسر(الناتج, «        i := i - 1;»);
    سطر_جسر(الناتج, «        let bit: u64 = ج_ط128_يمين(a, i).lo & 1;»);
    سطر_جسر(الناتج, «        r := ج_ط128_أو(ج_ط128_يسار(r, 1), ج_ط128_بني(bit, 0));»);
    سطر_جسر(الناتج, «        if (ج_ط128_قارن(r, b) >= 0) {»);
    سطر_جسر(الناتج, «            r := ج_ط128_طرح(r, b);»);
    سطر_جسر(الناتج, «            q := ج_ط128_أو(q, ج_ط128_يسار(ج_ط128_بني(1, 0), i));»);
    سطر_جسر(الناتج, «        };»);
    سطر_جسر(الناتج, «    }»);
    سطر_جسر(الناتج, «    if (الباقي) { return r; };»);
    سطر_جسر(الناتج, «    return q;»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ص128_قسم(a: ج_ص128, b: ج_ص128, الباقي: bool): ج_ص128 {»);
    سطر_جسر(الناتج, «    let na: bool = ج_ص128_سالب(a); let nb: bool = ج_ص128_سالب(b);»);
    سطر_جسر(الناتج, «    let ua: mutable ج_ط128 = ج_ط128_من_ص128(a); let ub: mutable ج_ط128 = ج_ط128_من_ص128(b);»);
    سطر_جسر(الناتج, «    if (na) { ua := ج_ط128_طرح(ج_ط128_بني(0, 0), ua); };»);
    سطر_جسر(الناتج, «    if (nb) { ub := ج_ط128_طرح(ج_ط128_بني(0, 0), ub); };»);
    سطر_جسر(الناتج, «    let r: ج_ط128 = ج_ط128_قسم(ua, ub, الباقي);»);
    سطر_جسر(الناتج, «    let سالب: bool = (الباقي && na) || (!الباقي && na != nb);»);
    سطر_جسر(الناتج, «    if (سالب) { return ج_ص128_من_ط128(ج_ط128_طرح(ج_ط128_بني(0, 0), r)); };»);
    سطر_جسر(الناتج, «    return ج_ص128_من_ط128(r);»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ص128_يمين(a: ج_ص128, ع: u64): ج_ص128 {»);
    سطر_جسر(الناتج, «    let u: ج_ط128 = ج_ط128_يمين(ج_ط128_من_ص128(a), ع);»);
    سطر_جسر(الناتج, «    if (!ج_ص128_سالب(a) || (ع & 127) == 0) { return ج_ص128_من_ط128(u); };»);
    سطر_جسر(الناتج, «    let الملء: ج_ط128 = ج_ط128_متمم(ج_ط128_يمين(ج_ط128_بني(18446744073709551615, 18446744073709551615), ع));»);
    سطر_جسر(الناتج, «    return ج_ص128_من_ط128(ج_ط128_أو(u, الملء));»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ط128_إلى_ع64(a: ج_ط128): f64 { return (a.hi as f64) * 18446744073709551616.0 + (a.lo as f64); }»);
    سطر_جسر(الناتج, «def ج_ص128_إلى_ع64(a: ج_ص128): f64 {»);
    سطر_جسر(الناتج, «    if (ج_ص128_سالب(a)) { return 0.0 - ج_ط128_إلى_ع64(ج_ط128_طرح(ج_ط128_بني(0, 0), ج_ط128_من_ص128(a))); };»);
    سطر_جسر(الناتج, «    return ج_ط128_إلى_ع64(ج_ط128_من_ص128(a));»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ط128_من_ع64(f: f64): ج_ط128 {»);
    سطر_جسر(الناتج, «    if (f < 1.0) { return ج_ط128_بني(0, 0); };»);
    سطر_جسر(الناتج, «    let hi: u64 = (f / 18446744073709551616.0) as u64;»);
    سطر_جسر(الناتج, «    let lo: u64 = (f - (hi as f64) * 18446744073709551616.0) as u64;»);
    سطر_جسر(الناتج, «    return ج_ط128_بني(lo, hi);»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «def ج_ص128_من_ع64(f: f64): ج_ص128 {»);
    سطر_جسر(الناتج, «    if (f < 0.0) { return ج_ص128_من_ط128(ج_ط128_طرح(ج_ط128_بني(0, 0), ج_ط128_من_ع64(0.0 - f))); };»);
    سطر_جسر(الناتج, «    return ج_ص128_من_ط128(ج_ط128_من_ع64(f));»);
    سطر_جسر(الناتج, «}»);
    سطر_جسر(الناتج, «// The signed forms of the operations whose bits do not depend on the sign.»);
    سطر_جسر(الناتج, «def ج_ص128_جمع(a: ج_ص128, b: ج_ص128): ج_ص128 { return ج_ص128_من_ط128(ج_ط128_جمع(ج_ط128_من_ص128(a), ج_ط128_من_ص128(b))); }»);
    سطر_جسر(الناتج, «def ج_ص128_طرح(a: ج_ص128, b: ج_ص128): ج_ص128 { return ج_ص128_من_ط128(ج_ط128_طرح(ج_ط128_من_ص128(a), ج_ط128_من_ص128(b))); }»);
    سطر_جسر(الناتج, «def ج_ص128_ضرب(a: ج_ص128, b: ج_ص128): ج_ص128 { return ج_ص128_من_ط128(ج_ط128_ضرب(ج_ط128_من_ص128(a), ج_ط128_من_ص128(b))); }»);
    سطر_جسر(الناتج, «def ج_ص128_و(a: ج_ص128, b: ج_ص128): ج_ص128 { return ج_ص128_من_ط128(ج_ط128_و(ج_ط128_من_ص128(a), ج_ط128_من_ص128(b))); }»);
    سطر_جسر(الناتج, «def ج_ص128_أو(a: ج_ص128, b: ج_ص128): ج_ص128 { return ج_ص128_من_ط128(ج_ط128_أو(ج_ط128_من_ص128(a), ج_ط128_من_ص128(b))); }»);
    سطر_جسر(الناتج, «def ج_ص128_عدا(a: ج_ص128, b: ج_ص128): ج_ص128 { return ج_ص128_من_ط128(ج_ط128_عدا(ج_ط128_من_ص128(a), ج_ط128_من_ص128(b))); }»);
    سطر_جسر(الناتج, «def ج_ص128_متمم(a: ج_ص128): ج_ص128 { return ج_ص128_من_ط128(ج_ط128_متمم(ج_ط128_من_ص128(a))); }»);
    سطر_جسر(الناتج, «def ج_ص128_يسار(a: ج_ص128, ع: u64): ج_ص128 { return ج_ص128_من_ط128(ج_ط128_يسار(ج_ط128_من_ص128(a), ع)); }»);
}

// Whether every parameter and the result of function type النوع_ن has a
// form here: a scalar, a complete struct or union, or a void result.
عرف توقيع_صالح_جسر(م: &محلل_جسر, النوع_ن: طبيعي): منطقي {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع_ن];
    دع الناتج: طبيعي = ن.الأساس;
    إذا ((*م).ج.الأنواع[الناتج].الصنف != 1 && !نوع_له_صيغة_جسر(م, الناتج)) { أرجع خطأ; };
    دع ي: متغير طبيعي = 0;
    طالما (ي < ن.عدد_المعطيات) {
        إذا (!نوع_له_صيغة_جسر(م, (*م).ج.المعطيات[ن.بداية_المعطيات + ي])) { أرجع خطأ; };
        ي := ي + 1;
    }
    أرجع صواب;
}

عرف نوع_له_صيغة_جسر(م: &محلل_جسر, النوع_ن: طبيعي): منطقي {
    إذا ((الطول(تمثيل_جسر(م, النوع_ن)) مثل طبيعي) > 0) { أرجع صواب; };
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع_ن];
    إذا (ن.الصنف == 8 || ن.الصنف == 9) { أرجع (*م).ج.الوسوم[ن.الوسم].مكتمل; };
    أرجع خطأ;
}

// ---- the block dispatcher (functions with goto) ----

// A jump to block الهدف.
عرف اقفز_جسر(ل: &متغير خافض_جسر, الهدف: طبيعي): فراغ {
    سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«ج_ك := », &طبيعي_إلى_نص(الهدف), &«;»));
    سطر_ل_جسر(ل, «continue;»);
}

عرف كتلة_جديدة_جسر(ل: &متغير خافض_جسر): طبيعي {
    (*ل).عدد_الكتل := (*ل).عدد_الكتل + 1;
    أرجع (*ل).عدد_الكتل;
}

// Ends the current block (falling into الكتلة) and starts block الكتلة.
عرف ابدأ_كتلة_جسر(ل: &متغير خافض_جسر, الكتلة: طبيعي): فراغ {
    إذا ((*ل).مفتوحة) { اقفز_جسر(ل, الكتلة); };
    (*ل).المسافة := (*ل).المسافة - 1;
    سطر_ل_جسر(ل, «};»);
    سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«if (ج_ك == », &طبيعي_إلى_نص(الكتلة), &«) {»));
    (*ل).المسافة := (*ل).المسافة + 1;
    (*ل).مفتوحة := صواب;
}

// A jump that ends the current block (code after it starts a new one).
عرف اقفز_وأغلق_جسر(ل: &متغير خافض_جسر, الهدف: طبيعي): فراغ {
    إذا ((*ل).مفتوحة) { اقفز_جسر(ل, الهدف); };
    (*ل).مفتوحة := خطأ;
}

// Code after a jump or return is unreachable; it still needs a block.
عرف تأكد_مفتوحة_جسر(ل: &متغير خافض_جسر): فراغ {
    إذا (!(*ل).مفتوحة) { دع ك: طبيعي = كتلة_جديدة_جسر(ل); ابدأ_كتلة_جسر(ل, ك); };
}

// A conditional jump to النعم or اللا on الشرط.
عرف اقفز_بشرط_جسر(ل: &متغير خافض_جسر, الشرط: نص, النعم: طبيعي, اللا: طبيعي): فراغ {
    دع أجزاء_ج316: متجه نص = [«if (», الشرط, «) { ج_ك := », طبيعي_إلى_نص(النعم), «; } else { ج_ك := », طبيعي_إلى_نص(اللا), «; };»];
    سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج316, &«»));
    سطر_ل_جسر(ل, «continue;»);
    (*ل).مفتوحة := خطأ;
}

// The innermost dispatcher loop (for continue) or loop/switch (for break).
عرف هدف_قفز_جسر(ل: &خافض_جسر, اخرج: منطقي): طبيعي {
    دع ن: متغير طبيعي = الطول((*ل).السياقات) مثل طبيعي;
    طالما (ن > 0) {
        دع س: سياق_ح_جسر = (*ل).السياقات[ن - 1];
        إذا (اخرج) { أرجع س.هدف_خ; };
        إذا (س.الصنف == 4) { أرجع س.هدف_ت; };
        ن := ن - 1;
    }
    أرجع 0;
}

عرف سياق_م_جسر(الصنف: ط8, الخروج: طبيعي, المتابعة: طبيعي): سياق_ح_جسر {
    دع الناتج: سياق_ح_جسر = { الصنف: الصنف, العلم_خ: «», العلم_ت: «», هدف_خ: الخروج, هدف_ت: المتابعة };
    أرجع الناتج;
}

// A statement as dispatcher blocks.
عرف اخفض_عبارة_موزعة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, ف: طبيعي): فراغ {
    دع ع: عبارة_جسر = (*ش).العبارات[ف];
    دع ص: ط8 = ع.الصنف;
    إذا (ص == 16) { أرجع; };
    إذا (ص == 7) {
        دع ي: متغير طبيعي = 0;
        طالما (ي < ع.ب) { اخفض_عبارة_موزعة_جسر(ل, م, ش, (*ش).القوائم[ع.أ + ي]); ي := ي + 1; }
        أرجع;
    };
    إذا (ص == 11) {
        ابدأ_كتلة_جسر(ل, (ع.القيمة مثل طبيعي) + 1);
        إذا (ع.أ > 0) { اخفض_عبارة_موزعة_جسر(ل, م, ش, ع.أ - 1); };
        أرجع;
    };
    تأكد_مفتوحة_جسر(ل);
    إذا (ص == 1) { أثر_ل_جسر(ل, م, ش, ع.أ - 1); أرجع; };
    إذا (ص == 15) { هيئ_محليا_جسر(ل, م, ش, ع.القيمة مثل طبيعي, ع.أ, ع.ب, ع.ج == 1); أرجع; };
    إذا (ص == 17) { اصنع_مصفوفة_متغيرة_جسر(ل, م, ش, ع.القيمة مثل طبيعي, ع.أ - 1); أرجع; };
    إذا (ص == 2) { أرجع_ل_جسر(ل, م, ش, ع.أ); (*ل).مفتوحة := خطأ; أرجع; };
    إذا (ص == 10 && ع.أ > 0) {
        // goto *p: p is a label's block number (`&&label`, body.sn).
        دع الهدف: نص = قيمة_ل_جسر(ل, م, ش, ع.أ - 1);
        سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«ج_ك := ((», &الهدف, &«) as u64);»));
        سطر_ل_جسر(ل, «continue;»);
        (*ل).مفتوحة := خطأ;
        أرجع;
    };
    إذا (ص == 10) { اقفز_وأغلق_جسر(ل, (ع.القيمة مثل طبيعي) + 1); أرجع; };
    إذا (ص == 8) { اقفز_وأغلق_جسر(ل, هدف_قفز_جسر(ل, صواب)); أرجع; };
    إذا (ص == 9) { اقفز_وأغلق_جسر(ل, هدف_قفز_جسر(ل, خطأ)); أرجع; };
    إذا (ص == 3) {
        دع ثم: طبيعي = كتلة_جديدة_جسر(ل);
        دع وإلا_ك: طبيعي = كتلة_جديدة_جسر(ل);
        دع النهاية: طبيعي = كتلة_جديدة_جسر(ل);
        دع الشرط: نص = شرط_ل_جسر(ل, م, ش, ع.أ - 1);
        اقفز_بشرط_جسر(ل, الشرط, ثم, اختر_ط_ل_جسر(ع.ج > 0, وإلا_ك, النهاية));
        ابدأ_كتلة_جسر(ل, ثم);
        اخفض_عبارة_موزعة_جسر(ل, م, ش, ع.ب - 1);
        اقفز_وأغلق_جسر(ل, النهاية);
        إذا (ع.ج > 0) {
            ابدأ_كتلة_جسر(ل, وإلا_ك);
            اخفض_عبارة_موزعة_جسر(ل, م, ش, ع.ج - 1);
        };
        ابدأ_كتلة_جسر(ل, النهاية);
        أرجع;
    };
    إذا (ص == 4 || ص == 5 || ص == 6) {
        إذا (ص == 6 && ع.د > 0) { اخفض_عبارة_موزعة_جسر(ل, م, ش, ع.د - 1); };
        دع الشرط_ك: طبيعي = كتلة_جديدة_جسر(ل);
        دع الجسم: طبيعي = كتلة_جديدة_جسر(ل);
        دع الخطوة: طبيعي = كتلة_جديدة_جسر(ل);
        دع النهاية: طبيعي = كتلة_جديدة_جسر(ل);
        إذا (ص == 5) { ابدأ_كتلة_جسر(ل, الجسم); } وإلا { ابدأ_كتلة_جسر(ل, الشرط_ك); };
        إذا (ص != 5) {
            إذا (ع.أ > 0) {
                دع الشرط: نص = شرط_ل_جسر(ل, م, ش, ع.أ - 1);
                اقفز_بشرط_جسر(ل, الشرط, الجسم, النهاية);
            };
            ابدأ_كتلة_جسر(ل, الجسم);
        };
        // continue goes to the step (for), the condition (while, do).
        دع المتابعة: طبيعي = اختر_ط_ل_جسر(ص == 6, الخطوة, الشرط_ك);
        ادفع_سياقا_جسر(ل, سياق_م_جسر(4, النهاية, المتابعة));
        اخفض_عبارة_موزعة_جسر(ل, م, ش, ع.ب - 1);
        اسحب_سياقا_جسر(ل);
        إذا (ص == 6) {
            ابدأ_كتلة_جسر(ل, الخطوة);
            إذا (ع.ج > 0) { أثر_ل_جسر(ل, م, ش, ع.ج - 1); };
            اقفز_وأغلق_جسر(ل, الشرط_ك);
        } وإلا إذا (ص == 5) {
            ابدأ_كتلة_جسر(ل, الشرط_ك);
            دع الشرط: نص = شرط_ل_جسر(ل, م, ش, ع.أ - 1);
            اقفز_بشرط_جسر(ل, الشرط, الجسم, النهاية);
        } وإلا {
            اقفز_وأغلق_جسر(ل, الشرط_ك);
        };
        ابدأ_كتلة_جسر(ل, النهاية);
        أرجع;
    };
    إذا (ص == 12) {
        // A case label anywhere in the body is a block (Duff's device too).
        دع النوع_ق: طبيعي = (*ش).التعابير[ع.أ - 1].النوع;
        دع التمثيل: نص = تمثيل_جسر(م, النوع_ق);
        دع القيمة: نص = ثبت_جسر(ل, انسخ_نص(&التمثيل), قيمة_ل_جسر(ل, م, ش, ع.أ - 1));
        دع النهاية: طبيعي = كتلة_جديدة_جسر(ل);
        دع الحالات: متغير متجه طبيعي = [];
        اجمع_حالات_جسر(ش, ع.ب - 1, &متغير الحالات);
        دع الافتراضي: متغير طبيعي = النهاية;
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول(الحالات) مثل طبيعي)) {
            دع الوسم: عبارة_جسر = (*ش).العبارات[الحالات[ي]];
            دع الكتلة: طبيعي = كتلة_جديدة_جسر(ل);
            // The case statement's own القيمة2 slot is not reused: blocks are
            // numbered in the order الحالات lists them.
            إذا (الوسم.الصنف == 14) { الافتراضي := الكتلة; } وإلا {
                دع أدنى: نص = ثابت_ص_جسر(انسخ_نص(&التمثيل), طبع_جسر(م, الوسم.القيمة, النوع_ق));
                دع أعلى: نص = ثابت_ص_جسر(انسخ_نص(&التمثيل), طبع_جسر(م, الوسم.القيمة2, النوع_ق));
                دع أجزاء_ج318: متجه نص = [« <= », أعلى, «) { ج_ك := », طبيعي_إلى_نص(الكتلة), «; continue; };»];
                دع أجزاء_ج319: متجه نص = [«if (», انسخ_نص(&القيمة), « >= », أدنى, « && », انسخ_نص(&القيمة),
                    صل_النصوص(&أجزاء_ج318, &«»)];
                سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج319, &«»));
            };
            ي := ي + 1;
        }
        اقفز_وأغلق_جسر(ل, الافتراضي);
        // The body: each label of the list starts its block, in order.
        دع أول_كتلة: طبيعي = (*ل).عدد_الكتل - (الطول(الحالات) مثل طبيعي) + 1;
        ادفع_سياقا_جسر(ل, سياق_م_جسر(5, النهاية, 0));
        دع عداد: متغير طبيعي = 0;
        اخفض_جسم_تبديل_جسر(ل, م, ش, ع.ب - 1, أول_كتلة, &متغير عداد);
        اسحب_سياقا_جسر(ل);
        ابدأ_كتلة_جسر(ل, النهاية);
        أرجع;
    };
    إذا (ص == 13 || ص == 14) {
        // Outside a dispatched switch body walk (handled there).
        إذا (ع.أ > 0) { اخفض_عبارة_موزعة_جسر(ل, م, ش, ع.أ - 1); };
        أرجع;
    };
}

// The case and default labels of a switch body (not of nested switches),
// in order.
عرف اجمع_حالات_جسر(ش: &شجرة_جسر, ف: طبيعي, الناتج: &متغير متجه طبيعي): فراغ {
    دع ع: عبارة_جسر = (*ش).العبارات[ف];
    دع ص: ط8 = ع.الصنف;
    إذا (ص == 13 || ص == 14) { ألحق(*الناتج, ف); };
    إذا (ص == 12) { أرجع; };
    إذا (ص == 7) {
        دع ي: متغير طبيعي = 0;
        طالما (ي < ع.ب) { اجمع_حالات_جسر(ش, (*ش).القوائم[ع.أ + ي], الناتج); ي := ي + 1; }
        أرجع;
    };
    إذا (ص == 3) {
        إذا (ع.ب > 0) { اجمع_حالات_جسر(ش, ع.ب - 1, الناتج); };
        إذا (ع.ج > 0) { اجمع_حالات_جسر(ش, ع.ج - 1, الناتج); };
        أرجع;
    };
    إذا (ص == 4 || ص == 5 || ص == 6) { إذا (ع.ب > 0) { اجمع_حالات_جسر(ش, ع.ب - 1, الناتج); }; أرجع; };
    إذا ((ص == 11 || ص == 13 || ص == 14) && ع.أ > 0) { اجمع_حالات_جسر(ش, ع.أ - 1, الناتج); };
}

// The body of a dispatched switch: like any statement, with each case or
// default label (in the order اجمع_حالات_جسر found them) starting its block.
عرف اخفض_جسم_تبديل_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, ف: طبيعي, الأولى: طبيعي, العداد: &متغير طبيعي): فراغ {
    دع ع: عبارة_جسر = (*ش).العبارات[ف];
    دع ص: ط8 = ع.الصنف;
    إذا (ص == 13 || ص == 14) {
        ابدأ_كتلة_جسر(ل, الأولى + *العداد);
        *العداد := *العداد + 1;
        إذا (ع.أ > 0) { اخفض_جسم_تبديل_جسر(ل, م, ش, ع.أ - 1, الأولى, العداد); };
        أرجع;
    };
    إذا (ص == 7) {
        دع ي: متغير طبيعي = 0;
        طالما (ي < ع.ب) { اخفض_جسم_تبديل_جسر(ل, م, ش, (*ش).القوائم[ع.أ + ي], الأولى, العداد); ي := ي + 1; }
        أرجع;
    };
    إذا (ص == 11) {
        ابدأ_كتلة_جسر(ل, (ع.القيمة مثل طبيعي) + 1);
        إذا (ع.أ > 0) { اخفض_جسم_تبديل_جسر(ل, م, ش, ع.أ - 1, الأولى, العداد); };
        أرجع;
    };
    دع فيه_وسم: متغير متجه طبيعي = [];
    اجمع_حالات_جسر(ش, ف, &متغير فيه_وسم);
    إذا ((الطول(فيه_وسم) مثل طبيعي) == 0) { اخفض_عبارة_موزعة_جسر(ل, م, ش, ف); أرجع; };
    // A loop or if with case labels inside (Duff's device).
    إذا (ص == 3) {
        تأكد_مفتوحة_جسر(ل);
        دع ثم: طبيعي = كتلة_جديدة_جسر(ل);
        دع وإلا_ك: طبيعي = كتلة_جديدة_جسر(ل);
        دع النهاية: طبيعي = كتلة_جديدة_جسر(ل);
        دع الشرط: نص = شرط_ل_جسر(ل, م, ش, ع.أ - 1);
        اقفز_بشرط_جسر(ل, الشرط, ثم, اختر_ط_ل_جسر(ع.ج > 0, وإلا_ك, النهاية));
        ابدأ_كتلة_جسر(ل, ثم);
        اخفض_جسم_تبديل_جسر(ل, م, ش, ع.ب - 1, الأولى, العداد);
        اقفز_وأغلق_جسر(ل, النهاية);
        إذا (ع.ج > 0) { ابدأ_كتلة_جسر(ل, وإلا_ك); اخفض_جسم_تبديل_جسر(ل, م, ش, ع.ج - 1, الأولى, العداد); };
        ابدأ_كتلة_جسر(ل, النهاية);
        أرجع;
    };
    إذا (ص == 4 || ص == 5 || ص == 6) {
        تأكد_مفتوحة_جسر(ل);
        إذا (ص == 6 && ع.د > 0) { اخفض_عبارة_موزعة_جسر(ل, م, ش, ع.د - 1); };
        دع الشرط_ك: طبيعي = كتلة_جديدة_جسر(ل);
        دع الجسم: طبيعي = كتلة_جديدة_جسر(ل);
        دع الخطوة: طبيعي = كتلة_جديدة_جسر(ل);
        دع النهاية: طبيعي = كتلة_جديدة_جسر(ل);
        إذا (ص == 5) { ابدأ_كتلة_جسر(ل, الجسم); } وإلا {
            ابدأ_كتلة_جسر(ل, الشرط_ك);
            إذا (ع.أ > 0) {
                دع الشرط: نص = شرط_ل_جسر(ل, م, ش, ع.أ - 1);
                اقفز_بشرط_جسر(ل, الشرط, الجسم, النهاية);
            };
            ابدأ_كتلة_جسر(ل, الجسم);
        };
        ادفع_سياقا_جسر(ل, سياق_م_جسر(4, النهاية, اختر_ط_ل_جسر(ص == 6, الخطوة, الشرط_ك)));
        اخفض_جسم_تبديل_جسر(ل, م, ش, ع.ب - 1, الأولى, العداد);
        اسحب_سياقا_جسر(ل);
        إذا (ص == 6) {
            ابدأ_كتلة_جسر(ل, الخطوة);
            إذا (ع.ج > 0) { أثر_ل_جسر(ل, م, ش, ع.ج - 1); };
            اقفز_وأغلق_جسر(ل, الشرط_ك);
        } وإلا إذا (ص == 5) {
            ابدأ_كتلة_جسر(ل, الشرط_ك);
            دع الشرط: نص = شرط_ل_جسر(ل, م, ش, ع.أ - 1);
            اقفز_بشرط_جسر(ل, الشرط, الجسم, النهاية);
        } وإلا { اقفز_وأغلق_جسر(ل, الشرط_ك); };
        ابدأ_كتلة_جسر(ل, النهاية);
        أرجع;
    };
    اخفض_عبارة_موزعة_جسر(ل, م, ش, ف);
}

// Whether a switch in statement ف has a case label that is not one of the
// labels heading the items of its body (it then runs as a dispatcher).
عرف تبديل_غير_منتظم_جسر(ش: &شجرة_جسر, ف: طبيعي): منطقي {
    دع ع: عبارة_جسر = (*ش).العبارات[ف];
    دع ص: ط8 = ع.الصنف;
    إذا (ص == 12) {
        دع الكل: متغير متجه طبيعي = [];
        اجمع_حالات_جسر(ش, ع.ب - 1, &متغير الكل);
        // The labels heading the body's items (labels in a row included).
        دع الرؤوس: متغير طبيعي = 0;
        دع الجسم: عبارة_جسر = (*ش).العبارات[ع.ب - 1];
        دع العناصر: متغير متجه طبيعي = [];
        إذا (الجسم.الصنف == 7) {
            دع ي: متغير طبيعي = 0;
            طالما (ي < الجسم.ب) { ألحق(العناصر, (*ش).القوائم[الجسم.أ + ي]); ي := ي + 1; }
        } وإلا { ألحق(العناصر, ع.ب - 1); };
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول(العناصر) مثل طبيعي)) {
            دع البند: متغير طبيعي = العناصر[ي];
            طالما ((*ش).العبارات[البند].الصنف == 13 || (*ش).العبارات[البند].الصنف == 14) {
                الرؤوس := الرؤوس + 1;
                إذا ((*ش).العبارات[البند].أ == 0) { اخرج_من_حلقة; };
                البند := (*ش).العبارات[البند].أ - 1;
            }
            إذا ((*ش).العبارات[البند].الصنف != 13 && (*ش).العبارات[البند].الصنف != 14 && تبديل_غير_منتظم_جسر(ش, البند)) { أرجع صواب; };
            ي := ي + 1;
        }
        أرجع الرؤوس != (الطول(الكل) مثل طبيعي);
    };
    إذا (ص == 7) {
        دع ي: متغير طبيعي = 0;
        طالما (ي < ع.ب) {
            إذا (تبديل_غير_منتظم_جسر(ش, (*ش).القوائم[ع.أ + ي])) { أرجع صواب; };
            ي := ي + 1;
        }
        أرجع خطأ;
    };
    إذا (ص == 3) {
        إذا (ع.ب > 0 && تبديل_غير_منتظم_جسر(ش, ع.ب - 1)) { أرجع صواب; };
        أرجع ع.ج > 0 && تبديل_غير_منتظم_جسر(ش, ع.ج - 1);
    };
    إذا (ص == 4 || ص == 5 || ص == 6) { أرجع ع.ب > 0 && تبديل_غير_منتظم_جسر(ش, ع.ب - 1); };
    إذا (ص == 11 || ص == 13 || ص == 14) { أرجع ع.أ > 0 && تبديل_غير_منتظم_جسر(ش, ع.أ - 1); };
    أرجع خطأ;
}
