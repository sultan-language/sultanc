        دع خيطي_ع: منطقي = ع.خيطي;
        ألحق(ل.خيطية, خيطي_ع);
        إذا ((الطول(التمثيل) مثل طبيعي) > 0 && !تمثيل128_جسر(&التمثيل) && !خيطي_ع) {
            // A scalar: a module variable.
