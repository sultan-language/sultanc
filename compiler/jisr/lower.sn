                إذا (احجز_اسما_جسر(م, &متغير ل.الكاتب, &المرشح) != 0) { الاسم := المرشح; }
                وإلا { عام_ر_تعليق_جسر(م, &متغير ل.الكاتب, &ع); };
            };
