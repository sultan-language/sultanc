        إذا (ك % 64 == 0 && ك > 0) { ألحق(الناتج, 10); };
        ألحق_بايتات_نص(&متغير الناتج, طبيعي_إلى_نص(الكلمة مثل طبيعي));
        ك := ك + 8;
    }
    ألحق_بايتات_نص(&متغير الناتج, «];»);
    ألحق(الناتج, 10);
    إذا (ل.نهاية_الخيط > 0) { اكتب_كتلة_خيط_جسر(&متغير الناتج, &ل, م); };
    ألحق_من(الناتج, &الثوابت, 0, الطول(الثوابت) مثل طبيعي);
    ألحق_من(الناتج, &ل.الخارجيات, 0, الطول(ل.الخارجيات) مثل طبيعي);
    ألحق_من(الناتج, &ل.الوحدة, 0, الطول(ل.الوحدة) مثل طبيعي);
    اكتب_الوسوم_المطلوبة_جسر(م, &متغير ل.الكاتب);
    أرجع اجمع_وحدة_جسر(م, &ل.الكاتب, الملف, &الناتج);
}

عرف عام_ر_تعليق_جسر(م: &محلل_جسر, ك: &متغير كاتب_جسر, ع: &عام_جسم_جسر): فراغ {
