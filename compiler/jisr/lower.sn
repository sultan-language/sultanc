                // A negative constant stays a constant expression.
            };
            دع العلني: نص = اختر_نص_ل_جسر(عام_ر && !يبدأ_بـ(&الاسم, &«ج_»), «public let », «let »);
            دع أجزاء_ج272: متجه نص = [العلني, انسخ_نص(&الاسم), «: mutable », التمثيل, « = », البداية, «;»];
            ألحق_بايتات_نص(&متغير الثوابت, صل_النصوص(&أجزاء_ج272, &«»));
            ألحق(الثوابت, 10);
            ألحق(ل.أسماء_العوام, الاسم);
            ألحق(ل.إزاحات_العوام, 0);
        } وإلا {
            دع ح: حجم_جسر = حجم_نوع_جسر(&(*م).ج, &(*م).النموذج, ع.النوع, خطأ);
            إذا (!ح.صالح) {
                لا_يدعم_رمز_جسر(م, 0, سبب_تشخيص.سبب_سي_كائن_نوع_ناقص(), انسخ_نص(&الاسم_ج));
            };
            الحجم := محاذاة_ل_جسر(الحجم, اختر_ط_ل_جسر(ح.المحاذاة > 16, 16, ح.المحاذاة));
            إذا (خيطي_ع) {
                // The thread-local objects' span (copied per thread) starts
                // at a 16-byte boundary so each copy keeps the alignment.
                إذا (ل.نهاية_الخيط == 0) { الحجم := محاذاة_ل_جسر(الحجم, 16); ل.بداية_الخيط := الحجم; };
                ل.نهاية_الخيط := الحجم + ح.الحجم;
            };
            ألحق(ل.إزاحات_العوام, الحجم);
            ألحق(ل.أسماء_العوام, «»);
            مد_بيانات_جسر(&متغير ل.البيانات, الحجم + ح.الحجم);
            // Integer constants and strings are the block's initial bytes.
            دع ك: متغير طبيعي = 0;
            طالما (ك < ع.عدد_المهيئ) {
                دع العنصر: عنصر_مهيئ_جسر = ش.المهيئات[ع.بداية_المهيئ + ك];
                إذا (العنصر.النص_ن != 0) {
                    دع النص_ب: متجه ط8 = انسخ_بايتات(&ش.النصوص[العنصر.النص_ن - 1]);
                    دع ب: متغير طبيعي = 0;
                    طالما (ب < العنصر.الطول && ب < (الطول(النص_ب) مثل طبيعي)) {
                        ل.البيانات[الحجم + العنصر.الإزاحة + ب] := النص_ب[ب];
                        ب := ب + 1;
                    }
                } وإلا إذا (العنصر.التعبير != 0 && العنصر.الحقل == 0 && ثابت_صحيح_ل_جسر(&ش, العنصر.التعبير - 1) && !تجميعي_ن_جسر(م, العنصر.النوع)) {
                    بايتات_ثابت_جسر(&متغير ل.البيانات, الحجم + العنصر.الإزاحة, ش.التعابير[العنصر.التعبير - 1].القيمة,
                        حجم_ن_جسر(م, العنصر.النوع), كبير);
                };
                ك := ك + 1;
            }
