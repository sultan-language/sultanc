        دع صالحة: منطقي = توقيع_صالح_جسر(م, (*م).الكيانات[ش.الدوال[ي].الكيان].النوع);
        ألحق(المترجمة, صالحة);
        إذا (صالحة) { المتخطاة[ش.الدوال[ي].الكيان] := صواب; };
