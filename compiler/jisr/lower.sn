    // The public C functions with their C signatures.
    اكتب_أغلفة_جسر(&متغير ل, م, &ش);
    // The text.
    دع الناتج: متغير متجه ط8 = [];
    سطر_جسر(&متغير الناتج, صل_ثلاثة_نصوص(&«// The C code of », الملف, &«, compiled by Jisr (compiler/jisr/lower.sn).»));
