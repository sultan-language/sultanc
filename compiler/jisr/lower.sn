    ألحق_بايتات_نص(&متغير الناتج, «let ج_بيانات: mutable vector u64 = [»);
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(ل.البيانات) مثل طبيعي)) {
        دع الكلمة: متغير ط64 = 0;
        دع ب: متغير طبيعي = 0;
        طالما (ب < 8) {
            دع البايت: طبيعي = اختر_ط_ل_جسر(كبير, 7 - ب, ب);
