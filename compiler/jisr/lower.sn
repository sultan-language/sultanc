            إذا (ع.عدد_المهيئ == 1) {
                دع العنصر: عنصر_مهيئ_جسر = ش.المهيئات[ع.بداية_المهيئ];
                إذا (العنصر.التعبير != 0 && العنصر.الحقل == 0) {
                    دع ت: تعبير_جسر = ش.التعابير[العنصر.التعبير - 1];
                    إذا (ت.الصنف == 1) { البداية := ثابت_ص_جسر(انسخ_نص(&التمثيل), ت.القيمة); }
                    وإلا إذا (ت.الصنف == 2 && عائم_تمثيل_جسر(&التمثيل)) { دع أجزاء_ج271: متجه نص = [«(», اسم_م_جسر(م, ت.أ), « as », انسخ_نص(&التمثيل), «)»]; البداية := صل_النصوص(&أجزاء_ج271, &«»); };
                };
