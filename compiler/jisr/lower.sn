        };
        ي := ي + 1;
    }
    // The functions.
    ي := 0;
    طالما (ي < (الطول(ش.الدوال) مثل طبيعي)) {
        دع الدالة: دالة_جسم_جسر = ش.الدوال[ي];
        إذا (المترجمة[ي]) { اخفض_دالة_جسر(&متغير ل, م, &ش, ي); };
        ي := ي + 1;
    }
    // The module's initialization: the initializers that are not constant
