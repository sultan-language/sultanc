        دع الوجهة_ن: متغير نص = الوجهة;
        إذا ((الطول(الوجهة_ن) مثل طبيعي) == 0) {
            دع الإزاحة: طبيعي = احجز_إطارا_جسر(ل, حجم_ن_جسر(م, النوع_ن), محاذاة_ن_جسر(م, النوع_ن));
            الوجهة_ن := عنوان_إطار_جسر(ل, الإزاحة);
        };
        ألحق_بايتات_نص(&متغير الأجزاء, الوجهة_ن);
        أول := خطأ;
    };
    // The definition's own parameters (one with an empty list has none).
    دع الثابتة: طبيعي = (*ش).الدوال[(*ل).دوال_الكيانات[الكيان] - 1].عدد_المعاملات;
    دع ي: متغير طبيعي = 0;
    طالما (ي < الثابتة && ي < (الطول(*الحجج) مثل طبيعي)) {
        إذا (!أول) { ألحق_بايتات_نص(&متغير الأجزاء, «, »); };
        أول := خطأ;
        ألحق_بايتات_نص(&متغير الأجزاء, انسخ_نص(&(*الحجج)[ي]));
        ي := ي + 1;
    }
    إذا (ن.متغير_المعاملات) {
        // The variadic arguments in 8-byte slots of the frame.
        دع العدد: طبيعي = (الطول(*الحجج) مثل طبيعي) - الثابتة;
        دع الإزاحة: طبيعي = احجز_إطارا_جسر(ل, (العدد + 1) * 8, 8);
        دع الخانات: نص = ثبت_جسر(ل, كلمة_ل_جسر(م), عنوان_إطار_جسر(ل, الإزاحة));
        دع ك: متغير طبيعي = 0;
        طالما (ك < العدد) {
            دع النوع_ح: طبيعي = (*أنواع)[الثابتة + ك];
            دع العنوان: نص = أزح_جسر(انسخ_نص(&الخانات), ك * 8);
            دع القيمة: نص = انسخ_نص(&(*الحجج)[الثابتة + ك]);
            إذا (عائم_ن_جسر(م, النوع_ح)) {
                خزن_جسر(ل, م, ن_مزدوج_جسر(), العنوان, صل_ثلاثة_نصوص(&«(», &القيمة, &« as f64)»));
            } وإلا إذا (تجميعي_ن_جسر(م, النوع_ح)) {
                لا_يدعم_جسر(م, الرمز, سبب_تشخيص.سبب_سي_سجل_حجة_متغيرة());
            } وإلا {
                // Integers and pointers widened to the whole slot.
                دع النوع_و: طبيعي = اختر_ط_ل_جسر(موقع_تمثيل_جسر(م, النوع_ح), ن_طويل2_جسر(), ن_طويل2_طبيعي_جسر());
                دع أجزاء_ج188: متجه نص = [«(», القيمة, « as », تمثيل_جسر(م, النوع_و), «)»];
                خزن_جسر(ل, م, النوع_و, العنوان, صل_النصوص(&أجزاء_ج188, &«»));
            };
            ك := ك + 1;
        }
        إذا (!أول) { ألحق_بايتات_نص(&متغير الأجزاء, «, »); };
        ألحق_بايتات_نص(&متغير الأجزاء, الخانات);
    };
    ألحق(الأجزاء, 0x29);
    دع النداء: نص = الأجزاء مثل نص;
    إذا (تجميعي_ن || (*م).ج.الأنواع[النوع_ن].الصنف == 1) {
        سطر_ل_جسر(ل, صل_نصين(&النداء, &«;»));
        أرجع «»;
    };
    أرجع النداء;
}

// A call of a C function of another file through a private extern of the
// module (one per call shape for a variadic one).
عرف نادِ_خارجيا_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, الكيان: طبيعي, الحجج: &متجه نص, أنواع: &متجه طبيعي,
    النوع_ن: طبيعي, الوجهة: نص, الرمز: طبيعي): نص {
    دع الكيان_ر: كيان_سي_جسر = (*م).الكيانات[الكيان];
    دع نوع_الدالة: طبيعي = الكيان_ر.النوع;
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[نوع_الدالة];
    // The parameter types: the prototype's, then the promoted variadic ones.
    دع المعاملات: متغير متجه طبيعي = [];
    دع الثابتة: طبيعي = اختر_ط_ل_جسر(ن.بلا_نموذج, الطول(*الحجج) مثل طبيعي, ن.عدد_المعطيات);
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(*الحجج) مثل طبيعي)) {
        إذا (ي < الثابتة && !ن.بلا_نموذج) { ألحق(المعاملات, (*م).ج.المعطيات[ن.بداية_المعطيات + ي]); }
        وإلا { ألحق(المعاملات, (*أنواع)[ي]); };
        ي := ي + 1;
    }
    دع الاسم: نص = خارجية_ل_جسر(ل, م, الكيان, &المعاملات, الثابتة, ن.متغير_المعاملات || ن.بلا_نموذج, ن.الأساس, الرمز);
    إذا ((الطول(الاسم) مثل طبيعي) == 0) { أرجع «0»; };
    دع الأجزاء: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الأجزاء, الاسم);
    ألحق(الأجزاء, 0x28);
    ي := 0;
    طالما (ي < (الطول(*الحجج) مثل طبيعي)) {
        إذا (ي > 0) { ألحق_بايتات_نص(&متغير الأجزاء, «, »); };
        ألحق_بايتات_نص(&متغير الأجزاء, حجة_تهجئة_جسر(ل, م, المعاملات[ي], انسخ_نص(&(*الحجج)[ي])));
        ي := ي + 1;
    }
    ألحق(الأجزاء, 0x29);
    دع النداء: نص = الأجزاء مثل نص;
    دع النوع_ن2: نوع_سي_جسر = (*م).ج.الأنواع[ن.الأساس];
    إذا (النوع_ن2.الصنف == 1) { سطر_ل_جسر(ل, صل_نصين(&النداء, &«;»)); أرجع «»; };
    إذا (تجميعي_ن_جسر(م, ن.الأساس)) {
        // A record result: stored at its destination.
        دع التهجئة: نص = تهجئة_ل_جسر(ل, م, ن.الأساس, 1);
        دع الوجهة_ن: متغير نص = الوجهة;
        إذا ((الطول(الوجهة_ن) مثل طبيعي) == 0) {
            دع الإزاحة: طبيعي = احجز_إطارا_جسر(ل, حجم_ن_جسر(م, ن.الأساس), محاذاة_ن_جسر(م, ن.الأساس));
            الوجهة_ن := عنوان_إطار_جسر(ل, الإزاحة);
        };
        دع ق: نص = مؤقت_ل_جسر(ل);
        دع أجزاء_ج192: متجه نص = [«let », انسخ_نص(&ق), «: *mutable », انسخ_نص(&التهجئة), « = (», الوجهة_ن, صل_ثلاثة_نصوص(&«) as *mutable », &التهجئة, &«;»)];
        سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج192, &«»));
        دع أجزاء_ج193: متجه نص = [«*», ق, « := », النداء, «;»];
        سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج193, &«»));
        أرجع «»;
    };
    دع التهجئة: نص = تهجئة_ل_جسر(ل, م, ن.الأساس, 1);
    دع التمثيل: نص = تمثيل_جسر(م, ن.الأساس);
    إذا (نصان_متساويان(&التهجئة, &التمثيل)) { أرجع النداء; };
    دع أجزاء_ج194: متجه نص = [«(», النداء, « as », التمثيل, «)»];
    أرجع صل_النصوص(&أجزاء_ج194, &«»);
}

// A spelling of a type at a call boundary (emit.sn's), without needing
// the writer here: kept in the lowering's module writer.
عرف تهجئة_ل_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, النوع_ن: طبيعي, الموضع: ط8): نص {
    أرجع تهجئة_قيمة_جسر(م, &متغير (*ل).الكاتب, النوع_ن, الموضع);
}

// An internal value passed as a parameter spelled by emit.sn.
عرف حجة_تهجئة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, النوع_ن: طبيعي, القيمة: نص): نص {
    دع التهجئة: نص = تهجئة_ل_جسر(ل, م, النوع_ن, 0);
    إذا (تجميعي_ن_جسر(م, النوع_ن)) {
        دع أجزاء_ج195: متجه نص = [«(*((», القيمة, «) as *», التهجئة, «))»];
        // A record by value: loaded from the copy's address.
        أرجع صل_النصوص(&أجزاء_ج195, &«»);
    };
    دع التمثيل: نص = تمثيل_جسر(م, النوع_ن);
    إذا (نصان_متساويان(&التهجئة, &التمثيل)) { أرجع القيمة; };
    دع أجزاء_ج196: متجه نص = [«(», القيمة, « as », التهجئة, «)»];
    أرجع صل_النصوص(&أجزاء_ج196, &«»);
}

// ---- va_list ----

// The address of the va_list object an expression designates (a local
// array, or a parameter that is a pointer to it).
عرف عنوان_قائمة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, ف: طبيعي): نص {
    دع ت: تعبير_جسر = (*ش).التعابير[ف];
    إذا ((*م).ج.الأنواع[ت.النوع].الصنف == 5) { أرجع قيمة_ل_جسر(ل, م, ش, ف); };
    إذا (ت.الصنف == 8) { أرجع عنوان_ل_جسر(ل, م, ش, ت.أ - 1); };
    أرجع عنوان_ل_جسر(ل, م, ش, ف);
}

// va_start: the va_list over this function's slot array.
عرف ابدأ_قائمة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, ف: طبيعي): فراغ {
    دع ت: تعبير_جسر = (*ش).التعابير[ف];
    دع الصنف: ط8 = (*م).النموذج.صنف_قائمة_المعاملات;
    دع الكلمة: طبيعي = ن_عرض_مؤشر_جسر(م, خطأ);
    إذا (الصنف == 0) {
        خزن_يسارا_جسر(ل, م, ش, ت.أ - 1, «ج_خانات»);
        أرجع;
    };
    دع العنوان: نص = ثبت_جسر(ل, كلمة_ل_جسر(م), عنوان_قائمة_جسر(ل, م, ش, ت.أ - 1));
    إذا (الصنف == 1 && (*م).النموذج.حجم_قائمة_المعاملات == 24) {
        // System V: gp_offset 48 and fp_offset 304 (no register argument
        // left), overflow_arg_area the slots.
        خزن_جسر(ل, م, ن_صحيح_طبيعي_جسر(), انسخ_نص(&العنوان), «(48 as u32)»);
        خزن_جسر(ل, م, ن_صحيح_طبيعي_جسر(), أزح_جسر(انسخ_نص(&العنوان), 4), «(304 as u32)»);
        خزن_جسر(ل, م, الكلمة, أزح_جسر(انسخ_نص(&العنوان), 8), «ج_خانات»);
        خزن_جسر(ل, م, الكلمة, أزح_جسر(انسخ_نص(&العنوان), 16), «(0 as u64)»);
        أرجع;
    };
    إذا (الصنف == 2) {
        // AAPCS64: __stack the slots, __gr_offs and __vr_offs 0 (no register
        // argument left).
        خزن_جسر(ل, م, الكلمة, انسخ_نص(&العنوان), «ج_خانات»);
        خزن_جسر(ل, م, الكلمة, أزح_جسر(انسخ_نص(&العنوان), 8), «(0 as u64)»);
        خزن_جسر(ل, م, الكلمة, أزح_جسر(انسخ_نص(&العنوان), 16), «(0 as u64)»);
        خزن_جسر(ل, م, ن_صحيح_جسر(), أزح_جسر(انسخ_نص(&العنوان), 24), «(0 as i32)»);
        خزن_جسر(ل, م, ن_صحيح_جسر(), أزح_جسر(انسخ_نص(&العنوان), 28), «(0 as i32)»);
        أرجع;
    };
    لا_يدعم_جسر(م, ت.الرمز, سبب_تشخيص.سبب_سي_بدء_حجج_متغيرة());
}

// va_arg: the next slot, then the cursor past it.
عرف قائمة_تالي_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, ف: طبيعي): نص {
    دع ت: تعبير_جسر = (*ش).التعابير[ف];
    دع الصنف: ط8 = (*م).النموذج.صنف_قائمة_المعاملات;
    دع الكلمة: طبيعي = ن_عرض_مؤشر_جسر(م, خطأ);
    دع التمثيل: نص = تمثيل_جسر(م, ت.النوع);
    دع المؤشر: متغير نص = «»;
    دع موضع_المؤشر: متغير نص = «»;
    إذا (الصنف == 0) {
        دع ي: يسار_ثابت_جسر = ثبت_يسارا_جسر(ل, م, ش, ت.أ - 1);
        المؤشر := ثبت_جسر(ل, كلمة_ل_جسر(م), اقرأ_ثابتا_جسر(ل, م, &ي, الكلمة));
        اكتب_ثابتا_جسر(ل, م, &ي, الكلمة, صل_ثلاثة_نصوص(&«(», &المؤشر, &« + 8)»));
    } وإلا {
        دع العنوان: نص = ثبت_جسر(ل, كلمة_ل_جسر(م), عنوان_قائمة_جسر(ل, م, ش, ت.أ - 1));
        موضع_المؤشر := اختر_نص_ل_جسر(الصنف == 1, أزح_جسر(انسخ_نص(&العنوان), 8), انسخ_نص(&العنوان));
        المؤشر := ثبت_جسر(ل, كلمة_ل_جسر(م), حمل_جسر(م, الكلمة, انسخ_نص(&موضع_المؤشر)));
        خزن_جسر(ل, م, الكلمة, انسخ_نص(&موضع_المؤشر), صل_ثلاثة_نصوص(&«(», &المؤشر, &« + 8)»));
    };
    إذا (عائم_ن_جسر(م, ت.النوع)) {
        دع ق: نص = حمل_جسر(م, ن_مزدوج_جسر(), انسخ_نص(&المؤشر));
        إذا (نصان_متساويان(&التمثيل, &«f64»)) { أرجع ق; };
        دع أجزاء_ج199: متجه نص = [«(», ق, « as », التمثيل, «)»];
        أرجع صل_النصوص(&أجزاء_ج199, &«»);
    };
    // The whole slot, then narrowed (endianness-free).
    دع ق: نص = حمل_جسر(م, ن_طويل2_طبيعي_جسر(), المؤشر);
    دع أجزاء_ج200: متجه نص = [«(», ق, « as », التمثيل, «)»];
    أرجع صل_النصوص(&أجزاء_ج200, &«»);
}

// ---- statements ----

// Whether statement ف holds a `continue` of its own loop (not of a loop
// inside it).
عرف فيه_تابع_جسر(ش: &شجرة_جسر, ف: طبيعي): منطقي {
    دع ع: عبارة_جسر = (*ش).العبارات[ف];
    دع ص: ط8 = ع.الصنف;
    إذا (ص == 9) { أرجع صواب; };
    إذا (ص == 4 || ص == 5 || ص == 6) { أرجع خطأ; };
    إذا (ص == 7) {
        دع ي: متغير طبيعي = 0;
        طالما (ي < ع.ب) {
            إذا (فيه_تابع_جسر(ش, (*ش).القوائم[ع.أ + ي])) { أرجع صواب; };
            ي := ي + 1;
        }
        أرجع خطأ;
    };
    إذا (ص == 3) {
        إذا (ع.ب > 0 && فيه_تابع_جسر(ش, ع.ب - 1)) { أرجع صواب; };
        أرجع ع.ج > 0 && فيه_تابع_جسر(ش, ع.ج - 1);
    };
    إذا (ص == 11 || ص == 13 || ص == 14) { أرجع ع.أ > 0 && فيه_تابع_جسر(ش, ع.أ - 1); };
    إذا (ص == 12) { أرجع ع.ب > 0 && فيه_تابع_جسر(ش, ع.ب - 1); };
    أرجع خطأ;
}

عرف سياق_ل_جسر(الصنف: ط8, العلم_خ: نص, العلم_ت: نص): سياق_ح_جسر {
    دع الناتج: سياق_ح_جسر = { الصنف: الصنف, العلم_خ: العلم_خ, العلم_ت: العلم_ت, هدف_خ: 0, هدف_ت: 0 };
    أرجع الناتج;
}

عرف ادفع_سياقا_جسر(ل: &متغير خافض_جسر, السياق: سياق_ح_جسر): فراغ { ألحق((*ل).السياقات, السياق); }

عرف اسحب_سياقا_جسر(ل: &متغير خافض_جسر): فراغ {
    دع ن: طبيعي = الطول((*ل).السياقات) مثل طبيعي;
    إذا (ن > 0) { اقتطع((*ل).السياقات, ن - 1); };
}

// C break at context depth العمق (1 = innermost).
عرف اخرج_ل_جسر(ل: &متغير خافض_جسر): فراغ {
    دع ن: طبيعي = الطول((*ل).السياقات) مثل طبيعي;
    إذا (ن == 0) { أرجع; };
    دع ص: ط8 = (*ل).السياقات[ن - 1].الصنف;
    إذا (ص == 2) {
        سطر_ل_جسر(ل, صل_نصين(&(*ل).السياقات[ن - 1].العلم_خ, &« := true;»));
    };
    سطر_ل_جسر(ل, «break;»);
}

// C continue: at the innermost loop.
عرف تابع_ل_جسر(ل: &متغير خافض_جسر, العمق: طبيعي): فراغ {
    إذا (العمق == 0) { أرجع; };
    دع ص: ط8 = (*ل).السياقات[العمق - 1].الصنف;
    إذا (ص == 1) { سطر_ل_جسر(ل, «continue;»); أرجع; };
    إذا (ص == 2) { سطر_ل_جسر(ل, «break;»); أرجع; };
    // In a switch: leave it, then continue the enclosing loop.
    سطر_ل_جسر(ل, صل_نصين(&(*ل).السياقات[العمق - 1].العلم_ت, &« := true;»));
    سطر_ل_جسر(ل, «break;»);
}

// The storage of variable-length array المحلي, made where it is declared
// (each time): العدد elements, zeroed, in a word vector of its own whose
// buffer address is the array's (the vector lives until the declaration
// runs again or the function returns); its size in bytes is kept for sizeof.
عرف اصنع_مصفوفة_متغيرة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, المحلي: طبيعي, العدد: طبيعي): فراغ {
    دع الاسم: نص = انسخ_نص(&(*ل).أسماء[المحلي - (*ل).بداية_المحليات]);
    دع العنصر: طبيعي = (*م).ج.الأنواع[(*ش).المحليات[المحلي].النوع].الأساس;
    دع العدد_ق: نص = حول_تمثيل_جسر(قيمة_ل_جسر(ل, م, ش, العدد), تمثيل_جسر(م, (*ش).التعابير[العدد].النوع), «u64»);
    دع أجزاء_ج203: متجه نص = [انسخ_نص(&الاسم), «_حج := », العدد_ق, « * », طبيعي_إلى_نص(حجم_ن_جسر(م, العنصر)), «;»];
    سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج203, &«»));
    سطر_ل_جسر(ل, صل_نصين(&الاسم, &«_مص := [];»));
    دع ع: نص = مؤقت_ل_جسر(ل);
    سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«let », &ع, &«: mutable u64 = 0;»));
    دع أجزاء_ج206: متجه نص = [«_مص, 0); », انسخ_نص(&ع), « := », انسخ_نص(&ع), « + 1; }»];
    دع أجزاء_ج207: متجه نص = [«while (», انسخ_نص(&ع), « <= (», انسخ_نص(&الاسم), «_حج + 7) / 8) { append(», انسخ_نص(&الاسم), صل_النصوص(&أجزاء_ج206, &«»)];
    سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج207, &«»));
    دع ق: نص = مؤقت_ل_جسر(ل);
    دع أجزاء_ج208: متجه نص = [«let », انسخ_نص(&ق), «: *mutable u64 = &mutable », انسخ_نص(&الاسم), «_مص[0];»];
    سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج208, &«»));
    دع أجزاء_ج209: متجه نص = [انسخ_نص(&الاسم), «_عن := (», ق, « as », كلمة_ل_جسر(م), «);»];
    سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج209, &«»));
}

// A C statement.
عام عرف اخفض_عبارة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, ف: طبيعي): فراغ {
    إذا ((*ل).موزع) { اخفض_عبارة_موزعة_جسر(ل, م, ش, ف); أرجع; };
    دع ع: عبارة_جسر = (*ش).العبارات[ف];
    دع ص: ط8 = ع.الصنف;
    إذا (ص == 16) { أرجع; };
    إذا (ص == 1) { أثر_ل_جسر(ل, م, ش, ع.أ - 1); أرجع; };
    إذا (ص == 7) {
        دع ي: متغير طبيعي = 0;
        طالما (ي < ع.ب) { اخفض_عبارة_جسر(ل, م, ش, (*ش).القوائم[ع.أ + ي]); ي := ي + 1; }
        أرجع;
    };
    إذا (ص == 2) { أرجع_ل_جسر(ل, م, ش, ع.أ); أرجع; };
    إذا (ص == 15) { هيئ_محليا_جسر(ل, م, ش, ع.القيمة مثل طبيعي, ع.أ, ع.ب, ع.ج == 1); أرجع; };
    إذا (ص == 17) { اصنع_مصفوفة_متغيرة_جسر(ل, م, ش, ع.القيمة مثل طبيعي, ع.أ - 1); أرجع; };
    إذا (ص == 3) {
        دع الشرط: نص = شرط_ل_جسر(ل, م, ش, ع.أ - 1);
        سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«if (», &الشرط, &«) {»));
        (*ل).المسافة := (*ل).المسافة + 1;
        اخفض_عبارة_جسر(ل, م, ش, ع.ب - 1);
        (*ل).المسافة := (*ل).المسافة - 1;
        إذا (ع.ج > 0) {
            سطر_ل_جسر(ل, «} else {»);
            (*ل).المسافة := (*ل).المسافة + 1;
            اخفض_عبارة_جسر(ل, م, ش, ع.ج - 1);
            (*ل).المسافة := (*ل).المسافة - 1;
        };
        سطر_ل_جسر(ل, «};»);
        أرجع;
    };
    إذا (ص == 4 || ص == 5 || ص == 6) { اخفض_حلقة_جسر(ل, م, ش, ف); أرجع; };
    إذا (ص == 8) { اخرج_ل_جسر(ل); أرجع; };
    إذا (ص == 9) {
        // The innermost loop's continue, through the switches inside it.
        دع ن: طبيعي = الطول((*ل).السياقات) مثل طبيعي;
        تابع_ل_جسر(ل, ن);
        أرجع;
    };
    إذا (ص == 12) { اخفض_تبديلا_جسر(ل, م, ش, ف); أرجع; };
    إذا (ص == 11) {
        إذا (ع.أ > 0) { اخفض_عبارة_جسر(ل, م, ش, ع.أ - 1); };
        أرجع;
    };
    إذا (ص == 13 || ص == 14) {
        لا_يدعم_جسر(م, ع.الرمز, سبب_تشخيص.سبب_سي_حالة_داخل_عبارة());
        أرجع;
    };
    إذا (ص == 10) {
        لا_يدعم_جسر(م, ع.الرمز, سبب_تشخيص.سبب_سي_قفز_غير_منظم());
        أرجع;
    };
}

عرف أرجع_ل_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, التعبير: طبيعي): فراغ {
    دع الدالة: دالة_جسم_جسر = (*ش).الدوال[(*ل).الدالة - 1];
    دع الناتج: طبيعي = (*م).ج.الأنواع[(*م).الكيانات[الدالة.الكيان].النوع].الأساس;
    إذا (التعبير == 0) {
        إذا ((*م).ج.الأنواع[الناتج].الصنف == 1 || (*ل).ناتج_غير_مباشر) { سطر_ل_جسر(ل, «return;»); أرجع; };
        دع التمثيل: نص = تمثيل_جسر(م, الناتج);
        سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«return », &صفر_جسر(انسخ_نص(&التمثيل)), &«;»));
        أرجع;
    };
    إذا ((*م).ج.الأنواع[الناتج].الصنف == 1) {
        أثر_ل_جسر(ل, م, ش, التعبير - 1);
        سطر_ل_جسر(ل, «return;»);
        أرجع;
    };
    إذا ((*ل).ناتج_غير_مباشر) {
        دع المصدر: نص = عنوان_ل_جسر(ل, م, ش, التعبير - 1);
        دع أجزاء_ج212: متجه نص = [«ج_انسخ(ج_ن, », المصدر, «, », طبيعي_إلى_نص(حجم_ن_جسر(م, الناتج)), «);»];
        سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج212, &«»));
        سطر_ل_جسر(ل, «return;»);
        أرجع;
    };
    دع ق: نص = قيمة_ل_جسر(ل, م, ش, التعبير - 1);
    سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«return », &ق, &«;»));
}

// while, do, for.
عرف اخفض_حلقة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, ف: طبيعي): فراغ {
    دع ع: عبارة_جسر = (*ش).العبارات[ف];
    دع ص: ط8 = ع.الصنف;
    إذا (ص == 6 && ع.د > 0) { اخفض_عبارة_جسر(ل, م, ش, ع.د - 1); };
    // The body runs in a single-pass loop when a continue must still run
    // the step (for) or the condition (do).
    دع مرة: منطقي = (ص == 5 || (ص == 6 && ع.ج > 0)) && فيه_تابع_جسر(ش, ع.ب - 1);
    دع العلم: متغير نص = «»;
    إذا (مرة) { العلم := متغير_مؤقت_جسر(ل, «bool», «false»); };
    سطر_ل_جسر(ل, «while (true) {»);
    (*ل).المسافة := (*ل).المسافة + 1;
    إذا ((ص == 4 || ص == 6) && ع.أ > 0) {
        دع الشرط: نص = شرط_ل_جسر(ل, م, ش, ع.أ - 1);
        سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«if (!», &الشرط, &«) { break; };»));
    };
    إذا (مرة) {
        سطر_ل_جسر(ل, «while (true) {»);
        (*ل).المسافة := (*ل).المسافة + 1;
        ادفع_سياقا_جسر(ل, سياق_ل_جسر(2, انسخ_نص(&العلم), «»));
        اخفض_عبارة_جسر(ل, م, ش, ع.ب - 1);
        اسحب_سياقا_جسر(ل);
        سطر_ل_جسر(ل, «break;»);
        (*ل).المسافة := (*ل).المسافة - 1;
        سطر_ل_جسر(ل, «}»);
        سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«if (», &العلم, &«) { break; };»));
    } وإلا {
        ادفع_سياقا_جسر(ل, سياق_ل_جسر(1, «», «»));
        اخفض_عبارة_جسر(ل, م, ش, ع.ب - 1);
        اسحب_سياقا_جسر(ل);
    };
    إذا (ص == 6 && ع.ج > 0) { أثر_ل_جسر(ل, م, ش, ع.ج - 1); };
    إذا (ص == 5) {
        دع الشرط: نص = شرط_ل_جسر(ل, م, ش, ع.أ - 1);
        سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«if (!», &الشرط, &«) { break; };»));
    };
    (*ل).المسافة := (*ل).المسافة - 1;
    سطر_ل_جسر(ل, «}»);
}

// A switch: the selected segment's index, then the segments in order in a
// single-pass loop, each entered when the index is at most its own (so a
// segment falls through into the next).
عرف اخفض_تبديلا_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, ف: طبيعي): فراغ {
    دع ع: عبارة_جسر = (*ش).العبارات[ف];
    دع النوع_ق: طبيعي = (*ش).التعابير[ع.أ - 1].النوع;
    دع التمثيل: نص = تمثيل_جسر(م, النوع_ق);
    دع القيمة: نص = ثبت_جسر(ل, انسخ_نص(&التمثيل), قيمة_ل_جسر(ل, م, ش, ع.أ - 1));
    // The body's items.
    دع العناصر: متغير متجه طبيعي = [];
    دع الجسم: عبارة_جسر = (*ش).العبارات[ع.ب - 1];
    إذا (الجسم.الصنف == 7) {
        دع ي: متغير طبيعي = 0;
        طالما (ي < الجسم.ب) { ألحق(العناصر, (*ش).القوائم[الجسم.أ + ي]); ي := ي + 1; }
    } وإلا { ألحق(العناصر, ع.ب - 1); };
    // Segments: a case or default label heads one; labels in a row share it.
    دع بدايات: متغير متجه طبيعي = [];
    دع المقاطع: متغير متجه طبيعي = [];
    دع الاختبارات: متغير متجه نص = [];
    دع أرقام: متغير متجه طبيعي = [];
    دع الافتراضي: متغير طبيعي = 0;
    دع له_افتراضي: متغير منطقي = خطأ;
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(العناصر) مثل طبيعي)) {
        دع البند: متغير طبيعي = العناصر[ي];
        دع له_وسم: متغير منطقي = خطأ;
        دع فارغ: متغير منطقي = خطأ;
        طالما ((*ش).العبارات[البند].الصنف == 13 || (*ش).العبارات[البند].الصنف == 14) {
            إذا (!له_وسم) { ألحق(بدايات, الطول(المقاطع) مثل طبيعي); له_وسم := صواب; };
            دع الرقم: طبيعي = (الطول(بدايات) مثل طبيعي) - 1;
            دع الوسم: عبارة_جسر = (*ش).العبارات[البند];
            إذا (الوسم.الصنف == 14) {
                له_افتراضي := صواب;
                الافتراضي := الرقم;
            } وإلا {
                دع أدنى: نص = ثابت_ص_جسر(انسخ_نص(&التمثيل), طبع_جسر(م, الوسم.القيمة, النوع_ق));
                إذا (الوسم.القيمة == الوسم.القيمة2) {
                    دع أجزاء_ج217: متجه نص = [«(», انسخ_نص(&القيمة), « == », أدنى, «)»];
                    ألحق(الاختبارات, صل_النصوص(&أجزاء_ج217, &«»));
                } وإلا {
                    دع أعلى: نص = ثابت_ص_جسر(انسخ_نص(&التمثيل), طبع_جسر(م, الوسم.القيمة2, النوع_ق));
                    دع أجزاء_ج219: متجه نص = [«(», انسخ_نص(&القيمة), « >= », أدنى, « && », انسخ_نص(&القيمة), صل_ثلاثة_نصوص(&« <= », &أعلى, &«)»)];
                    ألحق(الاختبارات, صل_النصوص(&أجزاء_ج219, &«»));
                };
                ألحق(أرقام, الرقم);
            };
            إذا (الوسم.أ == 0) { فارغ := صواب; اخرج_من_حلقة; };
            البند := الوسم.أ - 1;
        }
        إذا (!فارغ) { ألحق(المقاطع, البند); };
        ي := ي + 1;
    }
    دع عدد_المقاطع: طبيعي = الطول(بدايات) مثل طبيعي;
    // The segment index: the first matching label's, else default's, else
    // past the last.
    دع لا_مقطع: طبيعي = اختر_ط_ل_جسر(له_افتراضي, الافتراضي, عدد_المقاطع);
    دع نوع_الحالة: نص = «u64»;
    دع الحالة: نص = متغير_مؤقت_جسر(ل, انسخ_نص(&نوع_الحالة), صل_ثلاثة_نصوص(&«(», &طبيعي_إلى_نص(لا_مقطع), &« as u64)»));
    ي := 0;
    دع أول: متغير منطقي = صواب;
    طالما (ي < (الطول(الاختبارات) مثل طبيعي)) {
        دع أجزاء_ج221: متجه نص = [اختر_نص_ل_جسر(أول, «if », «} else if »), انسخ_نص(&الاختبارات[ي]), « { », انسخ_نص(&الحالة),
            « := (», طبيعي_إلى_نص(أرقام[ي]), « as u64);»];
        سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج221, &«»));
        أول := خطأ;
        ي := ي + 1;
    }
    إذا (!أول) { سطر_ل_جسر(ل, «};»); };
    دع نوع_العلم: نص = «bool»;
    دع علم_ت: نص = متغير_مؤقت_جسر(ل, انسخ_نص(&نوع_العلم), «false»);
    سطر_ل_جسر(ل, «while (true) {»);
    (*ل).المسافة := (*ل).المسافة + 1;
    ادفع_سياقا_جسر(ل, سياق_ل_جسر(3, «», انسخ_نص(&علم_ت)));
    // Items before the first label are unreachable (not written).
    دع المقطع: متغير طبيعي = 0;
    طالما (المقطع < عدد_المقاطع) {
        دع البداية: طبيعي = بدايات[المقطع];
        دع النهاية: متغير طبيعي = الطول(المقاطع) مثل طبيعي;
        إذا (المقطع + 1 < عدد_المقاطع) { النهاية := بدايات[المقطع + 1]; };
        دع أجزاء_ج222: متجه نص = [«if (», انسخ_نص(&الحالة), « <= (», طبيعي_إلى_نص(المقطع), « as u64)) {»];
        سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج222, &«»));
        (*ل).المسافة := (*ل).المسافة + 1;
        دع ك: متغير طبيعي = البداية;
        طالما (ك < النهاية) { اخفض_عبارة_جسر(ل, م, ش, المقاطع[ك]); ك := ك + 1; }
        (*ل).المسافة := (*ل).المسافة - 1;
        سطر_ل_جسر(ل, «};»);
        المقطع := المقطع + 1;
    }
    اسحب_سياقا_جسر(ل);
    سطر_ل_جسر(ل, «break;»);
    (*ل).المسافة := (*ل).المسافة - 1;
    سطر_ل_جسر(ل, «}»);
    // A C continue inside the switch continues the enclosing loop now.
    دع ن: طبيعي = الطول((*ل).السياقات) مثل طبيعي;
    إذا (ن > 0) {
        سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«if (», &علم_ت, &«) {»));
        (*ل).المسافة := (*ل).المسافة + 1;
        تابع_ل_جسر(ل, ن);
        (*ل).المسافة := (*ل).المسافة - 1;
        سطر_ل_جسر(ل, «};»);
    };
}

// ---- initialization ----

// Initializes local المحلي from initializer elements [البداية, + العدد):
// the whole object zeroed first (صفر), then each element stored.
عرف هيئ_محليا_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, المحلي: طبيعي, البداية: طبيعي, العدد: طبيعي, صفر: منطقي): فراغ {
    دع المحلي_ر: محلي_جسر = (*ش).المحليات[المحلي];
    دع النوع_ن: طبيعي = المحلي_ر.النوع;
    إذا (!في_الذاكرة_ل_جسر(ل, المحلي)) {
        // A scalar variable: one element.
        دع التمثيل: نص = تمثيل_جسر(م, النوع_ن);
        إذا (العدد == 0) {
            دع أجزاء_ج224: متجه نص = [انسخ_نص(&(*ل).أسماء[المحلي - (*ل).بداية_المحليات]), « := », صفر_جسر(انسخ_نص(&التمثيل)), «;»];
            سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج224, &«»));
            أرجع;
        };
        دع العنصر: عنصر_مهيئ_جسر = (*ش).المهيئات[البداية + العدد - 1];
        دع ق: نص = قيمة_ل_جسر(ل, م, ش, العنصر.التعبير - 1);
        دع أجزاء_ج225: متجه نص = [انسخ_نص(&(*ل).أسماء[المحلي - (*ل).بداية_المحليات]), « := », ق, «;»];
        سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج225, &«»));
        أرجع;
    };
    دع العنوان: نص = ثبت_جسر(ل, كلمة_ل_جسر(م), عنوان_إطار_جسر(ل, (*ل).إزاحات[المحلي - (*ل).بداية_المحليات]));
    دع الحجم: طبيعي = حجم_ن_جسر(م, النوع_ن);
    دع بسيط: منطقي = العدد == 1 && (*ش).المهيئات[البداية].الإزاحة == 0 && (*ش).المهيئات[البداية].الحقل == 0
        && (*ش).المهيئات[البداية].النص_ن == 0 && !تجميعي_ن_جسر(م, (*ش).المهيئات[البداية].النوع);
    إذا (صفر && !(بسيط && حجم_ن_جسر(م, (*ش).المهيئات[البداية].النوع) == الحجم)) {
        دع أجزاء_ج226: متجه نص = [«ج_صفر_ذاكرة(», انسخ_نص(&العنوان), «, », طبيعي_إلى_نص(الحجم), «);»];
        سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج226, &«»));
    };
    اكتب_عناصر_جسر(ل, م, ش, انسخ_نص(&العنوان), البداية, العدد);
}

// Stores initializer elements at العنوان + their offsets.
عرف اكتب_عناصر_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, العنوان: نص, البداية: طبيعي, العدد: طبيعي): فراغ {
    دع ي: متغير طبيعي = 0;
    طالما (ي < العدد) {
        دع ع: عنصر_مهيئ_جسر = (*ش).المهيئات[البداية + ي];
        ي := ي + 1;
        إذا (ع.النص_ن != 0) {
            دع المصدر: نص = عنوان_بيانات_جسر(ل, (*ل).إزاحات_النصوص[ع.النص_ن - 1]);
            دع أجزاء_ج227: متجه نص = [«ج_انسخ(», أزح_جسر(انسخ_نص(&العنوان), ع.الإزاحة), «, », المصدر, «, », طبيعي_إلى_نص(ع.الطول), «);»];
            سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج227, &«»));
            تابع_حلقة;
        };
        إذا (ع.التعبير == 0) { تابع_حلقة; };
        إذا (ع.الحقل != 0) {
            دع ق: نص = قيمة_ل_جسر(ل, م, ش, ع.التعبير - 1);
            دع ح: حقل_سي_جسر = (*م).ج.الحقول[ع.الحقل - 1];
            اكتب_بتيا_جسر(ل, م, ع.الحقل - 1, أزح_جسر(انسخ_نص(&العنوان), ع.الإزاحة - ح.الإزاحة), ق);
            تابع_حلقة;
        };
        إذا (تجميعي_ن_جسر(م, ع.النوع)) {
            دع المصدر: نص = عنوان_ل_جسر(ل, م, ش, ع.التعبير - 1);
            دع أجزاء_ج228: متجه نص = [«ج_انسخ(», أزح_جسر(انسخ_نص(&العنوان), ع.الإزاحة), «, », المصدر, «, », طبيعي_إلى_نص(حجم_ن_جسر(م, ع.النوع)), «);»];
            سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج228, &«»));
            تابع_حلقة;
        };
        دع ق: نص = قيمة_ل_جسر(ل, م, ش, ع.التعبير - 1);
        خزن_جسر(ل, م, ع.النوع, أزح_جسر(انسخ_نص(&العنوان), ع.الإزاحة), ق);
    }
}

// ---- externs ----

// The private extern through which compiled code calls C function الكيان
// of another file with parameter types المعاملات (the first الثابتة fixed;
// the rest a variadic call's promoted arguments); "" when a type has no
// SultanC form.
عرف خارجية_ل_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, الكيان: طبيعي, المعاملات: &متجه طبيعي, الثابتة: طبيعي,
    متغيرة: منطقي, الناتج_ن: طبيعي, الرمز: طبيعي): نص {
    مدد_كيانات_جسر(ل, م);
    إذا (!متغيرة && (الطول((*ل).خارجيات[الكيان]) مثل طبيعي) > 0) { أرجع انسخ_نص(&(*ل).خارجيات[الكيان]); };
    دع الكيان_ر: كيان_سي_جسر = (*م).الكيانات[الكيان];
    دع الاسم_ج: نص = اسم_م_جسر(م, الكيان_ر.الاسم);
    دع الأجزاء: متغير متجه ط8 = [];
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(*المعاملات) مثل طبيعي)) {
        دع التهجئة: نص = تهجئة_ل_جسر(ل, م, (*المعاملات)[ي], 0);
        إذا ((الطول(التهجئة) مثل طبيعي) == 0) {
            لا_يدعم_رمز_جسر(م, الرمز, سبب_تشخيص.سبب_سي_نداء_بحجة_بلا_صيغة(), انسخ_نص(&الاسم_ج));
            أرجع «»;
        };
        إذا (ي > 0) { ألحق_بايتات_نص(&متغير الأجزاء, «, »); };
        ألحق_بايتات_نص(&متغير الأجزاء, صل_ثلاثة_نصوص(&صل_نصين(&«p», &طبيعي_إلى_نص(ي)), &«: », &التهجئة));
        ي := ي + 1;
    }
    دع الناتج: نص = تهجئة_ل_جسر(ل, م, الناتج_ن, 1);
    إذا ((الطول(الناتج) مثل طبيعي) == 0) {
        لا_يدعم_رمز_جسر(م, الرمز, سبب_تشخيص.سبب_سي_نداء_بناتج_بلا_صيغة(), انسخ_نص(&الاسم_ج));
        أرجع «»;
    };
    // The link name: the asm label without the platform's prefix, else the
    // C name; SYMBOL...N for a variadic call shape.
    دع الرابط: متغير نص = انسخ_نص(&الاسم_ج);
    إذا (الكيان_ر.التسمية != 0) {
        دع التسمية: نص = اسم_م_جسر(م, الكيان_ر.التسمية);
        دع البادئة: نص = انسخ_نص(&(*م).النموذج.بادئة_الرموز);
        إذا ((الطول(البادئة) مثل طبيعي) > 0 && يبدأ_بـ(&التسمية, &البادئة)) {
            إذا ((الطول(التسمية) مثل طبيعي) > (الطول(البادئة) مثل طبيعي)) {
                طابق مقطع_نص(&التسمية, الطول(البادئة) مثل طبيعي, (الطول(التسمية) مثل طبيعي) - (الطول(البادئة) مثل طبيعي)) مع
                | اختياري.موجود(المقطع_ن) -> { الرابط := المقطع_ن; }
                | اختياري.لا_شيء -> { الرابط := «»; };
            } وإلا { الرابط := «»; };
        } وإلا { الرابط := التسمية; };
    };
    إذا (متغيرة) { الرابط := صل_ثلاثة_نصوص(&الرابط, &«...», &طبيعي_إلى_نص(الثابتة)); };
    دع التوقيع: نص = الأجزاء مثل نص;
    دع أجزاء_ج232: متجه نص = [انسخ_نص(&الرابط), «|», انسخ_نص(&التوقيع), «|», انسخ_نص(&الناتج)];
    // A shape already declared is reused.
    دع المفتاح: نص = صل_النصوص(&أجزاء_ج232, &«»);
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*ل).أشكال) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*ل).أشكال[ك], &المفتاح)) { أرجع صل_ثلاثة_نصوص(&«خ_», &طبيعي_إلى_نص(ك), &صل_نصين(&«_», &اسم_داخلي_جسر(انسخ_نص(&الاسم_ج)))); };
        ك := ك + 1;
    }
    دع الاسم: نص = صل_ثلاثة_نصوص(&«خ_», &طبيعي_إلى_نص(الطول((*ل).أشكال) مثل طبيعي), &صل_نصين(&«_», &اسم_داخلي_جسر(انسخ_نص(&الاسم_ج))));
    ألحق((*ل).أشكال, المفتاح);
    دع أجزاء_ج238: متجه نص = [«extern def », انسخ_نص(&الاسم), «(», التوقيع, «): », الناتج, صل_ثلاثة_نصوص(&« = "», &الرابط, &«";»)];
    دع السطر: نص = صل_النصوص(&أجزاء_ج238, &«»);
    ألحق_بايتات_نص(&متغير (*ل).الخارجيات, السطر);
    ألحق((*ل).الخارجيات, 10);
    إذا (!متغيرة) { (*ل).خارجيات[الكيان] := انسخ_نص(&الاسم); };
    أرجع الاسم;
}

// ---- frames ----

// The type and zero value of storage of العدد words: a tuple of words, or of
// blocks of 32 words (ج_ك32) or 1024 (ج_ك1024) or 32768 (ج_ك32ك).
نوع زوج_نص_جسر = { الأول: نص, الثاني: نص };

عرف زوج_جسر(أ: نص, ب: نص): زوج_نص_جسر {
    دع الناتج: زوج_نص_جسر = { الأول: أ, الثاني: ب };
    أرجع الناتج;
}

عرف تخزين_كلمات_جسر(العدد: طبيعي): زوج_نص_جسر {
    دع النوع_ع: متغير نص = «u64»;
    دع الصفر: متغير نص = «0»;
    دع الوحدة: متغير طبيعي = 1;
    إذا (العدد > 32 * 1024) { النوع_ع := «ج_ك32ك»; الصفر := «ج_صفر32ك()»; الوحدة := 32768; }
    وإلا إذا (العدد > 1024) { النوع_ع := «ج_ك1024»; الصفر := «ج_صفر1024()»; الوحدة := 1024; }
    وإلا إذا (العدد > 32) { النوع_ع := «ج_ك32»; الصفر := «ج_صفر32()»; الوحدة := 32; };
    دع الكتل: طبيعي = (العدد + الوحدة - 1) / الوحدة;
    إذا (الكتل <= 1) { أرجع زوج_جسر(النوع_ع, الصفر); };
    دع ن: متغير متجه ط8 = [0x28];
    دع ص: متغير متجه ط8 = [0x28];
    دع ي: متغير طبيعي = 0;
    طالما (ي < الكتل) {
        إذا (ي > 0) { ألحق_بايتات_نص(&متغير ن, «, »); ألحق_بايتات_نص(&متغير ص, «, »); };
        ألحق_بايتات_نص(&متغير ن, انسخ_نص(&النوع_ع));
        ألحق_بايتات_نص(&متغير ص, انسخ_نص(&الصفر));
        ي := ي + 1;
    }
    ألحق(ن, 0x29);
    ألحق(ص, 0x29);
    أرجع زوج_جسر(ن مثل نص, ص مثل نص);
}

// ---- functions ----

عرف اسم_محلي_جسر(م: &محلل_جسر, المحلي: &محلي_جسر, الفهرس: طبيعي): نص {
    إذا ((*المحلي).الاسم == 0) { أرجع صل_نصين(&«م», &طبيعي_إلى_نص(الفهرس)); };
    أرجع صل_ثلاثة_نصوص(&«م», &طبيعي_إلى_نص(الفهرس), &صل_نصين(&«_», &اسم_داخلي_جسر(اسم_م_جسر(م, (*المحلي).الاسم))));
}

// Writes compiled function د (an index into الدوال).
عرف اخفض_دالة_جسر(ل: &متغير خافض_جسر, م: &متغير محلل_جسر, ش: &شجرة_جسر, د: طبيعي): فراغ {
    دع الدالة: دالة_جسم_جسر = (*ش).الدوال[د];
    دع الكيان: كيان_سي_جسر = (*م).الكيانات[الدالة.الكيان];
    دع نوع_الدالة: نوع_سي_جسر = (*م).ج.الأنواع[الكيان.النوع];
    دع الناتج_ن: طبيعي = نوع_الدالة.الأساس;
    دع فارغ: متجه ط8 = [];
    (*ل).السطور := فارغ;
    (*ل).المسافة := 2;
    (*ل).الإطار := 0;
    (*ل).الدالة := د + 1;
    (*ل).بداية_المحليات := الدالة.بداية_المحليات;
    (*ل).يستعمل_البيانات := خطأ;
    (*ل).يستعمل_الخيط := خطأ;
    (*ل).يستعمل_الإطار := خطأ;
    دع بلا_سياقات: متجه سياق_ح_جسر = [];
    (*ل).السياقات := بلا_سياقات;
    (*ل).ناتج_غير_مباشر := تجميعي_ن_جسر(م, الناتج_ن);
    // The locals: a variable, or a frame object.
    دع أسماء: متغير متجه نص = [];
    دع ذاكرة: متغير متجه منطقي = [];
    دع إزاحات: متغير متجه طبيعي = [];
    دع ي: متغير طبيعي = 0;
    طالما (ي < الدالة.عدد_المحليات) {
        دع المحلي: محلي_جسر = (*ش).المحليات[الدالة.بداية_المحليات + ي];
        ألحق(أسماء, اسم_محلي_جسر(م, &المحلي, ي));
        دع التمثيل: نص = تمثيل_جسر(م, المحلي.النوع);
        دع في_ذاكرة: منطقي = المحلي.العام == 0 && !المحلي.متغير_الطول && (المحلي.عنوانه_مأخوذ || (الطول(التمثيل) مثل طبيعي) == 0);
        ألحق(ذاكرة, في_ذاكرة);
        ألحق(إزاحات, 0);
        ي := ي + 1;
    }
    (*ل).أسماء := أسماء;
    (*ل).ذاكرة := ذاكرة;
    (*ل).إزاحات := إزاحات;
    ي := 0;
    طالما (ي < الدالة.عدد_المحليات) {
        إذا ((*ل).ذاكرة[ي]) {
            دع النوع_م: طبيعي = (*ش).المحليات[الدالة.بداية_المحليات + ي].النوع;
            دع ح: حجم_جسر = حجم_نوع_جسر(&(*م).ج, &(*م).النموذج, النوع_م, خطأ);
            إذا (!ح.صالح) {
                لا_يدعم_رمز_جسر(م, 0, سبب_تشخيص.سبب_سي_محلي_نوع_ناقص(), اسم_م_جسر(م, الكيان.الاسم));
            };
            (*ل).إزاحات[ي] := احجز_إطارا_جسر(ل, ح.الحجم, ح.المحاذاة);
        };
        ي := ي + 1;
    }
    // The parameters: copied into their variables or frame objects.
    ي := 0;
    طالما (ي < الدالة.عدد_المحليات) {
        دع المحلي: محلي_جسر = (*ش).المحليات[الدالة.بداية_المحليات + ي];
        دع التمثيل: نص = تمثيل_جسر(م, المحلي.النوع);
        إذا (ي < الدالة.عدد_المعاملات) {
            دع المعامل: نص = صل_نصين(&«ج_م», &طبيعي_إلى_نص(ي));
            إذا (!(*ل).ذاكرة[ي]) {
                دع أجزاء_ج243: متجه نص = [«let », انسخ_نص(&(*ل).أسماء[ي]), «: mutable », التمثيل, « = », المعامل, «;»];
                سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج243, &«»));
            } وإلا إذا ((الطول(التمثيل) مثل طبيعي) > 0) {
                خزن_جسر(ل, م, المحلي.النوع, عنوان_إطار_جسر(ل, (*ل).إزاحات[ي]), المعامل);
            } وإلا {
                دع أجزاء_ج244: متجه نص = [«ج_انسخ(», عنوان_إطار_جسر(ل, (*ل).إزاحات[ي]), «, », المعامل, «, », طبيعي_إلى_نص(حجم_ن_جسر(م, المحلي.النوع)), «);»];
                سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج244, &«»));
            };
        } وإلا إذا (المحلي.متغير_الطول) {
            // A variable-length array: its storage, address and size.
            سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«let », &(*ل).أسماء[ي], &«_مص: mutable vector u64 = [];»));
            دع أجزاء_ج246: متجه نص = [«let », انسخ_نص(&(*ل).أسماء[ي]), «_عن: mutable », كلمة_ل_جسر(م), « = 0;»];
            سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج246, &«»));
            سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«let », &(*ل).أسماء[ي], &«_حج: mutable u64 = 0;»));
        } وإلا إذا (!(*ل).ذاكرة[ي] && المحلي.العام == 0 && (الطول(التمثيل) مثل طبيعي) > 0) {
            دع أجزاء_ج248: متجه نص = [«let », انسخ_نص(&(*ل).أسماء[ي]), «: mutable », انسخ_نص(&التمثيل), « = », صفر_جسر(انسخ_نص(&التمثيل)), «;»];
            سطر_ل_جسر(ل, صل_النصوص(&أجزاء_ج248, &«»));
        };
        ي := ي + 1;
    }
    دع تمثيل_ن: نص = تمثيل_جسر(م, الناتج_ن);
    // A function with goto: its labels are blocks 1..n of a dispatcher.
    (*ل).موزع := الدالة.فيها_قفز || تبديل_غير_منتظم_جسر(ش, الدالة.الجسم - 1);
    إذا ((*ل).موزع) {
        (*ل).عدد_الكتل := الدالة.عدد_اللافتات + 1;
        سطر_ل_جسر(ل, «let ج_ك: mutable u64 = 0;»);
        سطر_ل_جسر(ل, «while (true) {»);
        (*ل).المسافة := (*ل).المسافة + 1;
        سطر_ل_جسر(ل, «if (ج_ك == 0) {»);
        (*ل).المسافة := (*ل).المسافة + 1;
        (*ل).مفتوحة := صواب;
    };
    اخفض_عبارة_جسر(ل, م, ش, الدالة.الجسم - 1);
    إذا ((*ل).موزع) {
        إذا ((*ل).مفتوحة) {
            إذا ((*م).ج.الأنواع[الناتج_ن].الصنف == 1 || (*ل).ناتج_غير_مباشر) { سطر_ل_جسر(ل, «return;»); }
            وإلا { سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«return », &صفر_جسر(انسخ_نص(&تمثيل_ن)), &«;»)); };
        };
        (*ل).المسافة := (*ل).المسافة - 1;
        سطر_ل_جسر(ل, «};»);
        (*ل).المسافة := (*ل).المسافة - 1;
        سطر_ل_جسر(ل, «}»);
        (*ل).موزع := خطأ;
    };
    // Falling off the end returns zero (main returns 0, C17 5.1.2.2.3).
    إذا ((*م).ج.الأنواع[الناتج_ن].الصنف == 1 || (*ل).ناتج_غير_مباشر) { سطر_ل_جسر(ل, «return;»); }
    وإلا { سطر_ل_جسر(ل, صل_ثلاثة_نصوص(&«return », &صفر_جسر(انسخ_نص(&تمثيل_ن)), &«;»)); };
    // The signature.
    دع الرأس: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الرأس, صل_ثلاثة_نصوص(&«def », &(*ل).أسماء_الدوال[الدالة.الكيان], &«(»));
    دع أول: متغير منطقي = صواب;
    إذا ((*ل).ناتج_غير_مباشر) { ألحق_بايتات_نص(&متغير الرأس, «ج_ن: »); ألحق_بايتات_نص(&متغير الرأس, كلمة_ل_جسر(م)); أول := خطأ; };
    ي := 0;
    طالما (ي < الدالة.عدد_المعاملات) {
        دع المحلي: محلي_جسر = (*ش).المحليات[الدالة.بداية_المحليات + ي];
        دع التمثيل: متغير نص = تمثيل_جسر(م, المحلي.النوع);
        إذا ((الطول(التمثيل) مثل طبيعي) == 0) { التمثيل := كلمة_ل_جسر(م); };
        إذا (!أول) { ألحق_بايتات_نص(&متغير الرأس, «, »); };
        أول := خطأ;
        ألحق_بايتات_نص(&متغير الرأس, صل_ثلاثة_نصوص(&صل_نصين(&«ج_م», &طبيعي_إلى_نص(ي)), &«: », &التمثيل));
        ي := ي + 1;
    }
    إذا (الدالة.متغيرة) {
        إذا (!أول) { ألحق_بايتات_نص(&متغير الرأس, «, »); };
        ألحق_بايتات_نص(&متغير الرأس, صل_نصين(&«ج_خانات: », &كلمة_ل_جسر(م)));
    };
    دع ناتج_س: نص = اختر_نص_ل_جسر((*م).ج.الأنواع[الناتج_ن].الصنف == 1 || (*ل).ناتج_غير_مباشر, «void», انسخ_نص(&تمثيل_ن));
    ألحق_بايتات_نص(&متغير الرأس, صل_ثلاثة_نصوص(&«): », &ناتج_س, &« {»));
    ألحق(الرأس, 10);
    ألحق_بايتات_نص(&متغير الرأس, «    unsafe {»);
    ألحق(الرأس, 10);
    اكتب_مقدمة_جسر(ل, م, &متغير الرأس);
    ألحق_من((*ل).الوحدة, &الرأس, 0, الطول(الرأس) مثل طبيعي);
    ألحق_من((*ل).الوحدة, &(*ل).السطور, 0, الطول((*ل).السطور) مثل طبيعي);
    ألحق_بايتات_نص(&متغير (*ل).الوحدة, «    }»);
    ألحق((*ل).الوحدة, 10);
    ألحق_بايتات_نص(&متغير (*ل).الوحدة, «}»);
    ألحق((*ل).الوحدة, 10);
    // Its marker (the value of a pointer to it).
    ألحق_بايتات_نص(&متغير (*ل).الوحدة, صل_ثلاثة_نصوص(&«let ج_و_», &(*ل).أسماء_الدوال[الدالة.الكيان], &«: mutable u8 = 0;»));
    ألحق((*ل).الوحدة, 10);
}

// The frame and data-block bases a function body uses.
عرف اكتب_مقدمة_جسر(ل: &متغير خافض_جسر, م: &محلل_جسر, الرأس: &متغير متجه ط8): فراغ {
    دع الكلمة: نص = كلمة_ل_جسر(م);
    إذا ((*ل).يستعمل_الإطار) {
        // 16 bytes more, to align the base.
        دع الكلمات: طبيعي = ((*ل).الإطار + 16 + 7) / 8;
        دع التخزين: زوج_نص_جسر = تخزين_كلمات_جسر(الكلمات);
        دع أجزاء_ج257: متجه نص = [«        let ج_إطار: mutable », انسخ_نص(&التخزين.الأول), « = », انسخ_نص(&التخزين.الثاني), «;»];
        ألحق_بايتات_نص(الرأس, صل_النصوص(&أجزاء_ج257, &«»));
        ألحق(*الرأس, 10);
        ألحق_بايتات_نص(الرأس, صل_ثلاثة_نصوص(&«        let ج_إطار_ق: *mutable », &التخزين.الأول, &« = &mutable ج_إطار;»));
        ألحق(*الرأس, 10);
        دع أجزاء_ج259: متجه نص = [«        let ج_أساس: », انسخ_نص(&الكلمة), « = (((ج_إطار_ق as », انسخ_نص(&الكلمة), «) + 15) / 16) * 16;»];
        ألحق_بايتات_نص(الرأس, صل_النصوص(&أجزاء_ج259, &«»));
        ألحق(*الرأس, 10);
    };
    إذا ((*ل).يستعمل_البيانات) {
        ألحق_بايتات_نص(الرأس, «        let ج_بق: *mutable u64 = &mutable ج_بيانات[0];»);
        ألحق(*الرأس, 10);
        ألحق_بايتات_نص(الرأس, صل_ثلاثة_نصوص(&«        let ج_ب: », &الكلمة, &صل_ثلاثة_نصوص(&« = ج_بق as », &الكلمة, &«;»)));
        ألحق(*الرأس, 10);
    };
    إذا ((*ل).يستعمل_الخيط) {
        ألحق_بايتات_نص(الرأس, صل_ثلاثة_نصوص(&«        let ج_كخ: », &الكلمة, &« = ج_كتلة_خيط();»));
        ألحق(*الرأس, 10);
    };
}

// This thread's copy of the thread-local objects' image (عنوان_عام_جسر):
// found in a table of threads under a lock, made from the image (the data
// block, initialized by then) on the thread's first use. A copy lives until
// the program ends; a thread id the system reuses finds the copy of the
// thread it had before.
عرف اكتب_كتلة_خيط_جسر(الناتج: &متغير متجه ط8, ل: &خافض_جسر, م: &محلل_جسر): فراغ {
    دع ك: نص = كلمة_ل_جسر(م);
    دع الطول_خ: طبيعي = (*ل).نهاية_الخيط - (*ل).بداية_الخيط;
    سطر_جسر(الناتج, «let ج_خيوط_م: mutable vector u64 = [];»);
    سطر_جسر(الناتج, «let ج_خيوط_ك: mutable vector vector u64 = [];»);
    // The lock: one cell, made by the module's initialization.
    سطر_جسر(الناتج, «let ج_خيوط_ق: mutable vector ذرة_ط32 = [];»);
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«def ج_كتلة_خيط(): », &ك, &« {»));
    سطر_جسر(الناتج, «    let المعرف: u64 = معرف_الخيط_الحالي();»);
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«    let الناتج: mutable », &ك, &« = 0;»));
    سطر_جسر(الناتج, «    unsafe {»);
    سطر_جسر(الناتج, «        اقفل_ذريا(&ج_خيوط_ق[0]);»);
    سطر_جسر(الناتج, «        let ف: mutable u64 = 0;»);
    سطر_جسر(الناتج, «        while (ف < (length(ج_خيوط_م) as u64)) { if (ج_خيوط_م[ف] == المعرف) { break; }; ف := ف + 1; }»);
    سطر_جسر(الناتج, «        if (ف == (length(ج_خيوط_م) as u64)) {»);
    سطر_جسر(الناتج, «            let الكتلة: mutable vector u64 = [];»);
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«            let ع: mutable u64 = 0; while (ع <= », &طبيعي_إلى_نص(الطول_خ / 8), &«) { append(الكتلة, 0); ع := ع + 1; }»));
    سطر_جسر(الناتج, «            append(ج_خيوط_م, المعرف);»);
    سطر_جسر(الناتج, «            append(ج_خيوط_ك, الكتلة);»);
    سطر_جسر(الناتج, «            let ق: *mutable u64 = &mutable ج_خيوط_ك[ف][0];»);
    سطر_جسر(الناتج, «            let ب: *mutable u64 = &mutable ج_بيانات[0];»);
    دع أجزاء_ج267: متجه نص = [«            ج_انسخ(ق as », انسخ_نص(&ك), «, (ب as », انسخ_نص(&ك), صل_ثلاثة_نصوص(&«) + », &طبيعي_إلى_نص((*ل).بداية_الخيط), &«, »),
        طبيعي_إلى_نص(الطول_خ), «);»];
    سطر_جسر(الناتج, صل_النصوص(&أجزاء_ج267, &«»));
    سطر_جسر(الناتج, «        };»);
    سطر_جسر(الناتج, «        let ق: *mutable u64 = &mutable ج_خيوط_ك[ف][0];»);
    سطر_جسر(الناتج, صل_ثلاثة_نصوص(&«        الناتج := ق as », &ك, &«;»));
    سطر_جسر(الناتج, «        افتح_قفل_ذري(&ج_خيوط_ق[0]);»);
    سطر_جسر(الناتج, «    }»);
    سطر_جسر(الناتج, «    return الناتج;»);
    سطر_جسر(الناتج, «}»);
}

// ---- the module ----

عرف بايتات_ثابت_جسر(البيانات: &متغير متجه ط8, الإزاحة: طبيعي, القيمة: ط64, الحجم: طبيعي, كبير: منطقي): فراغ {
    دع ي: متغير طبيعي = 0;
    طالما (ي < الحجم && الإزاحة + ي < (الطول(*البيانات) مثل طبيعي)) {
        دع البايت: طبيعي = اختر_ط_ل_جسر(كبير, الحجم - 1 - ي, ي);
        إذا (البايت >= 8) {
            (*البيانات)[الإزاحة + ي] := اختر_ب_ل_جسر((القيمة & 0x8000000000000000) != 0, 0xFF, 0) مثل ط8;
        } وإلا {
            (*البيانات)[الإزاحة + ي] := ((القيمة >> ((البايت * 8) مثل ط64)) & 0xFF) مثل ط8;
        };
        ي := ي + 1;
    }
}

عرف مد_بيانات_جسر(البيانات: &متغير متجه ط8, الحجم: طبيعي): فراغ {
    طالما ((الطول(*البيانات) مثل طبيعي) < الحجم) { ألحق(*البيانات, 0); }
}

// Whether expression ف is an integer constant (its bits are data).
عرف ثابت_صحيح_ل_جسر(ش: &شجرة_جسر, ف: طبيعي): منطقي { أرجع (*ش).التعابير[ف].الصنف == 1; }

// The SultanC module of a .c translation unit whose definitions Jisr
// compiles: the declarations (emit.sn) without the compiled ones, then
// the compiled code.
عام عرف اكتب_وحدة_مترجمة_جسر(م: &متغير محلل_جسر, الملف: &نص): نص {
    دع ش: متغير شجرة_جسر = شجرة_جسر_جديدة();
    دع التعريفات: متجه تعريف_جسر = انسخ_تعريفات_جسر(&(*م).التعريفات);
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(التعريفات) مثل طبيعي)) {
        حلل_تعريفا_ب_جسر(م, &متغير ش, &التعريفات[ي]);
        ي := ي + 1;
    }
    // The compiled entities are not written as externs.
    دع المتخطاة: متغير متجه منطقي = [];
