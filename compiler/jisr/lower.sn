            دع أجزاء_ج270: متجه نص = [«ج_ع», طبيعي_إلى_نص(ي), «_», اسم_داخلي_جسر(انسخ_نص(&الاسم_ج))];
            دع الاسم: متغير نص = صل_النصوص(&أجزاء_ج270, &«»);
            إذا (عام_ر) {
