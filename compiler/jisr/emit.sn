// Writes the declarations Jisr parsed as a SultanC module:
//   * structs and unions as records (`public type S = { ... }`) when the C
//     layout is SultanC's natural layout (field offsets, size and
//     alignment checked against the target's); otherwise as opaque storage
//     of the right size and alignment (unions, bit-fields, packed or
//     over-aligned records), or not at all;
//   * typedefs as type aliases, functions as `public extern def` (with the
//     asm label as link name), enumerators and object-like macros whose
//     value is an integer constant expression, a floating literal or a
//     string literal as `public let`;
//   * pointers typed (`*T`, `*mutable T`, `*void`, `*S`), with an address
//     word of the target's pointer width for a pointer to a function or to a
//     type with no SultanC form;
//   * every declaration that has no SultanC form left out with a comment
//     naming the reason and a SULTANC-C-* code, never written with a wrong
//     type.
// Errors (in the imported file's family) become a compile-time failure of
// the module, SULTANC-COMPTIME-FAILED carrying the C diagnostics.
استورد std.text.transform;
استورد std.text.search;
استورد std.text.radix;
استورد std.encoding.utf8;
استورد std.encoding.hex;
استورد std.unicode.code_point_text;
استورد std.chars.ascii;
استورد compiler.frontend.lexer.identifiers;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد std.text.number;
استورد std.math.wrapping;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.foreign_c;
استورد std.text.substring;
استورد compiler.jisr.core;
استورد compiler.jisr.target;
استورد compiler.jisr.literals;
استورد compiler.jisr.types;
استورد compiler.jisr.preprocessor;
استورد compiler.jisr.parser;
استورد compiler.jisr.shared;

// How a tag is written: 0 not at all, 1 a record of its fields, 2 opaque
// storage (`{ opaque: (u64, ...) }`), 4 an opaque type (`type X = opaque;`:
// only pointers to it exist); 3 while being decided.
عام نوع كاتب_جسر = {
    التمثيل: متجه ط8,
    // Tags the module needs, and whether each is written.
    مطلوب: متجه منطقي,
    مكتوب: متجه منطقي,
    // The SultanC name of each tag (spelling id, 0 not yet named).
    الأسماء: متجه طبيعي,
    // SultanC names written so far, by spelling id.
    المستعملة: متجه منطقي,
    الأنواع_ن: متجه ط8,
    الدوال_ن: متجه ط8,
    الثوابت_ن: متجه ط8,
    التعليقات: متجه ط8,
    // A warning for each declaration left out (علق_تخطيا_جسر), reported
    // with the module's other diagnostics.
    التخطيات: متجه تشخيص_جسر,
    مجهول: طبيعي,
    وحدة_ترجمة: منطقي
};

// ---- names ----

عام عرف كلمة_سلطان_محجوزة_جسر(الاسم: &نص): منطقي {
    دع الكلمات: متجه نص = [«_», «comptime», «fn», «of», «from», «extern», «import», «use», «as», «undefined», «def»,
        «alias», «let», «return», «else», «if», «any», «bool», «string», «char», «int», «uint», «float», «void»,
        «i8», «i16», «i32», «i64», «u8», «u16», «u32», «u64», «f32», «f64», «asm», «unsafe», «while», «for»,
        «break», «continue», «type», «match», «with», «mutable», «public», «slice», «box», «true», «false», «main»,
        «vector», «option», «result», «opaque», «معتم»,
        // The compiler's builtin functions (frontend/names/primitive_registry.sn).
        «append», «capacity», «clone», «extend_from», «length», «pop», «raw_c_call», «raw_kernel_call»,
        «release», «reserve_exact», «swap», «truncate»];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكلمات) مثل طبيعي)) {
        إذا (نصان_متساويان(الاسم, &الكلمات[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}


// A name C reserves to the implementation (`__x`, `_X`).
// Whether a name is left out of the module: reserved for the
// implementation, and not a project file's own.
عام عرف اسم_مخفي_جسر(م: &محلل_جسر, الاسم: &نص): منطقي {
    أرجع !(*م).محجوزة_مكتوبة && اسم_تنفيذ_جسر(الاسم);
}

عام عرف اسم_تنفيذ_جسر(الاسم: &نص): منطقي {
    دع ن: طبيعي = الطول(*الاسم) مثل طبيعي;
    إذا (ن < 2 || (*الاسم)[0] != 0x5F) { أرجع خطأ; };
    أرجع (*الاسم)[1] == 0x5F || حرف_لاتيني_كبير((*الاسم)[1]);
}

// Whether SultanC can spell C name الاسم as an identifier: C allows any
// XID character (lexer.sn), SultanC's identifiers are ASCII and Arabic
// (compiler/frontend/lexer/identifiers.sn). A public declaration whose
// name it cannot spell is left out (احجز_اسما_جسر); compiled code's own
// names spell such a character as _uXXXX (اسم_داخلي_جسر).
عام عرف اسم_قابل_للتهجئة_جسر(الاسم: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(الاسم, ف);
        إذا (!المفكوك.صالح) { أرجع خطأ; };
        إذا (ف == 0 && !بداية_معرف(المفكوك.القيمة)) { أرجع خطأ; };
        إذا (ف > 0 && !تتمة_معرف(المفكوك.القيمة)) { أرجع خطأ; };
        ف := ف + المفكوك.العرض;
    }
    أرجع صواب;
}

// A C name inside a name compiled code makes for itself (`ج_NAME`,
// `م3_NAME`): each character SultanC identifiers do not have written
// _uXXXX (its code point), so the name is a SultanC identifier.
عام عرف اسم_داخلي_جسر(الاسم: نص): نص {
    إذا (اسم_قابل_للتهجئة_جسر(&الاسم)) { أرجع الاسم; };
    دع الأجزاء: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الاسم) مثل طبيعي)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(&الاسم, ف);
        إذا (!المفكوك.صالح || !تتمة_معرف(المفكوك.القيمة)) {
            دع القيمة: طبيعي = اختر_طبيعيا_ك_جسر(المفكوك.صالح, المفكوك.القيمة مثل طبيعي, الاسم[ف] مثل طبيعي);
            دع السداسي: متغير نص = «»;
            طابق طبيعي_إلى_نص_بقاعدة(القيمة, 16, صواب) مع
            | نتيجة.نجح(النص) -> { السداسي := النص; }
            | نتيجة.خطأ(_) -> { };
            ألحق(الأجزاء, صل_نصين(&«_u», &السداسي));
            ف := ف + اختر_طبيعيا_ك_جسر(المفكوك.صالح, المفكوك.العرض, 1);
        } وإلا {
            طابق مقطع_نص(&الاسم, ف, المفكوك.العرض) مع
            | اختياري.موجود(المحرف) -> { ألحق(الأجزاء, المحرف); }
            | اختياري.لا_شيء -> { };
            ف := ف + المفكوك.العرض;
        };
    }
    أرجع صل_النصوص(&الأجزاء, &«»);
}

عرف اختر_طبيعيا_ك_جسر(الشرط: منطقي, أ: طبيعي, ب: طبيعي): طبيعي {
    إذا (الشرط) { أرجع أ; };
    أرجع ب;
}

// The SultanC spelling of a C name: a keyword or builtin gets a trailing _.
عام عرف اسم_سلطان_جسر(الاسم: &نص): نص {
    إذا (!كلمة_سلطان_محجوزة_جسر(الاسم)) { أرجع انسخ_نص(الاسم); };
    أرجع صل_نصين(الاسم, &«_»);
}

عرف مستعمل_جسر(ك: &كاتب_جسر, المعرف: طبيعي): منطقي {
    إذا (المعرف >= (الطول((*ك).المستعملة) مثل طبيعي)) { أرجع خطأ; };
    أرجع (*ك).المستعملة[المعرف];
}

عرف استعمل_جسر(ك: &متغير كاتب_جسر, المعرف: طبيعي): فراغ {
    طالما ((الطول((*ك).المستعملة) مثل طبيعي) <= المعرف) { ألحق((*ك).المستعملة, خطأ); }
    (*ك).المستعملة[المعرف] := صواب;
}

// The id of a SultanC name, reserving it; 0 when it is taken or SultanC
// cannot spell it.
عام عرف احجز_اسما_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الاسم: &نص): طبيعي {
    إذا (!اسم_قابل_للتهجئة_جسر(الاسم)) { أرجع 0; };
    دع المعرف: طبيعي = اعزل_نص_جسر(&متغير (*م).ع.المخزن, الاسم);
    إذا (مستعمل_جسر(ك, المعرف)) { أرجع 0; };
    استعمل_جسر(ك, المعرف);
    أرجع المعرف;
}

// The SultanC name of a tag, chosen on first use: its tag name unless an
// ordinary identifier has it (struct stat and stat()), else the typedef
// that names it, else struct_NAME / anon_struct_N.
عام عرف اسم_وسم_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الوسم: طبيعي): طبيعي {
    مدد_كاتب_جسر(م, ك);
    إذا ((*ك).الأسماء[الوسم] != 0) { أرجع (*ك).الأسماء[الوسم]; };
    دع الوسم_ر: وسم_سي_جسر = (*م).ج.الوسوم[الوسم];
    دع البادئة: متغير نص = «struct_»;
    إذا (الوسم_ر.الصنف == 9) { البادئة := «union_»; };
    دع المرشح: متغير نص = «»;
    إذا (الوسم_ر.الاسم != 0) {
        دع الاسم: نص = اسم_م_ك_جسر(م, الوسم_ر.الاسم);
        دع ربط: طبيعي = ربط_عادي_ك_جسر(م, الوسم_ر.الاسم);
        دع حر: متغير منطقي = ربط == 0;
        إذا (ربط != 0) {
            // `typedef struct vec vec;` names the same type.
            دع الكيان: كيان_سي_جسر = (*م).الكيانات[ربط - 1];
            إذا (الكيان.الصنف == 1 && نوع_يسمي_وسما_جسر(م, الكيان.النوع, الوسم)) { حر := صواب; };
        };
        إذا (حر && !كلمة_سلطان_محجوزة_جسر(&الاسم)) { المرشح := الاسم; }
        وإلا { المرشح := صل_نصين(&البادئة, &الاسم); };
    } وإلا {
        // An anonymous tag named by a typedef.
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*م).الكيانات) مثل طبيعي)) {
            دع الكيان: كيان_سي_جسر = (*م).الكيانات[ف];
            إذا (الكيان.الصنف == 1 && !الكيان.محلي && نوع_يسمي_وسما_جسر(م, الكيان.النوع, الوسم)) {
                دع الاسم: نص = اسم_م_ك_جسر(م, الكيان.الاسم);
                إذا (!كلمة_سلطان_محجوزة_جسر(&الاسم)) { المرشح := الاسم; اخرج_من_حلقة; };
            };
            ف := ف + 1;
        }
        إذا ((الطول(المرشح) مثل طبيعي) == 0) {
            (*ك).مجهول := (*ك).مجهول + 1;
            المرشح := صل_ثلاثة_نصوص(&«anon_», &البادئة, &طبيعي_إلى_نص((*ك).مجهول));
        };
    };
    دع المعرف: متغير طبيعي = احجز_اسما_جسر(م, ك, &المرشح);
    دع ف: متغير طبيعي = 2;
    طالما (المعرف == 0) {
        دع البديل: نص = صل_ثلاثة_نصوص(&المرشح, &«_», &طبيعي_إلى_نص(ف));
        المعرف := احجز_اسما_جسر(م, ك, &البديل);
        ف := ف + 1;
    }
    (*ك).الأسماء[الوسم] := المعرف;
    أرجع المعرف;
}

عام عرف اسم_م_ك_جسر(م: &محلل_جسر, المعرف: طبيعي): نص { أرجع نص_معرف_جسر(&(*م).ع.المخزن, المعرف); }

عرف ربط_عادي_ك_جسر(م: &محلل_جسر, المعرف: طبيعي): طبيعي {
    إذا (المعرف >= (الطول((*م).ربط_عادي) مثل طبيعي)) { أرجع 0; };
    أرجع (*م).ربط_عادي[المعرف];
}

// Whether النوع is (an unqualified) struct/union type of tag الوسم.
عرف نوع_يسمي_وسما_جسر(م: &محلل_جسر, النوع: طبيعي, الوسم: طبيعي): منطقي {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    أرجع (ن.الصنف == 8 || ن.الصنف == 9) && ن.الوسم == الوسم;
}

// ---- representation of tags ----

عام عرف صحيح_سلطان_جسر(العرض: طبيعي, موقع: منطقي): نص {
    إذا (العرض == 8) { إذا (موقع) { أرجع «i8»; }; أرجع «u8»; };
    إذا (العرض == 16) { إذا (موقع) { أرجع «i16»; }; أرجع «u16»; };
    إذا (العرض == 32) { إذا (موقع) { أرجع «i32»; }; أرجع «u32»; };
    إذا (العرض == 64) { إذا (موقع) { أرجع «i64»; }; أرجع «u64»; };
    أرجع «»;
}

// The unsigned integer of the target's pointer width.
عام عرف كلمة_عنوان_جسر(م: &محلل_جسر): نص { أرجع صحيح_سلطان_جسر((*م).النموذج.عرض_المؤشر, خطأ); }

// SultanC's natural layout of a type written in a record: (size, align),
// or invalid when it has no SultanC form there.
عرف تخطيط_سلطان_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, النوع: طبيعي): حجم_جسر {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    دع ص: ط8 = ن.الصنف;
    دع الفشل: حجم_جسر = { الحجم: 0, المحاذاة: 1, صالح: خطأ };
    إذا (ص == 2 || ص == 3 || ص == 10) {
        دع أساس: نوع_سي_جسر = (*م).ج.الأنواع[بلا_تعداد_جسر(&(*م).ج, النوع)];
        دع البايتات: طبيعي = أساس.العرض / 8;
        إذا ((الطول(صحيح_سلطان_جسر(أساس.العرض, أساس.موقع)) مثل طبيعي) == 0) { أرجع الفشل; };
        إذا (ص == 10 && !(*م).ج.الوسوم[ن.الوسم].مكتمل) { أرجع الفشل; };
        دع الناتج: حجم_جسر = { الحجم: البايتات, المحاذاة: البايتات, صالح: صواب };
        أرجع الناتج;
    };
    إذا (ص == 4) {
        إذا (ن.العرض == 32 || ن.العرض == 64 || (ن.الرتبة == 7 && (*م).النموذج.طويل_مزدوج_كمزدوج)) {
            دع البايتات: طبيعي = اختر_ط_جسر(ن.العرض == 32, 4, 8);
            دع الناتج: حجم_جسر = { الحجم: البايتات, المحاذاة: البايتات, صالح: صواب };
            أرجع الناتج;
        };
        أرجع الفشل;
    };
    إذا (ص == 5) {
        دع البايتات: طبيعي = (*م).النموذج.عرض_المؤشر / 8;
        دع الناتج: حجم_جسر = { الحجم: البايتات, المحاذاة: البايتات, صالح: صواب };
        أرجع الناتج;
    };
    إذا (ص == 6) {
        إذا (ن.مجهول_العدد || ن.العدد == 0 || ن.العدد > 512) { أرجع الفشل; };
        دع العنصر: حجم_جسر = تخطيط_سلطان_جسر(م, ك, ن.الأساس);
        إذا (!العنصر.صالح) { أرجع الفشل; };
        دع الناتج: حجم_جسر = { الحجم: العنصر.الحجم * ن.العدد, المحاذاة: العنصر.المحاذاة, صالح: صواب };
        أرجع الناتج;
    };
    إذا (ص == 8 || ص == 9) {
        دع التمثيل: ط8 = تمثيل_وسم_جسر(م, ك, ن.الوسم);
        إذا (التمثيل != 1 && التمثيل != 2) { أرجع الفشل; };
        دع الوسم: وسم_سي_جسر = (*م).ج.الوسوم[ن.الوسم];
        دع الناتج: حجم_جسر = { الحجم: الوسم.الحجم, المحاذاة: الوسم.المحاذاة, صالح: صواب };
        أرجع الناتج;
    };
    أرجع الفشل;
}

عرف اختر_ط_جسر(الشرط: منطقي, أ: طبيعي, ب: طبيعي): طبيعي {
    إذا (الشرط) { أرجع أ; };
    أرجع ب;
}

// Tags declared after the writer was made (a macro's `sizeof(struct x)`
// evaluated while writing) get their entries.
عرف مدد_كاتب_جسر(م: &محلل_جسر, ك: &متغير كاتب_جسر): فراغ {
    طالما ((الطول((*ك).التمثيل) مثل طبيعي) < (الطول((*م).ج.الوسوم) مثل طبيعي)) {
        ألحق((*ك).التمثيل, 255);
        ألحق((*ك).مطلوب, خطأ);
        ألحق((*ك).مكتوب, خطأ);
        ألحق((*ك).الأسماء, 0);
    }
}

// Decides (once) how tag الوسم is written.
عام عرف تمثيل_وسم_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الوسم: طبيعي): ط8 {
    مدد_كاتب_جسر(م, ك);
    دع الحالي: ط8 = (*ك).التمثيل[الوسم];
    إذا (الحالي != 255) {
        إذا (الحالي == 3) { أرجع 0; };
        أرجع الحالي;
    };
    (*ك).التمثيل[الوسم] := 3;
    دع الناتج: ط8 = قرر_تمثيل_جسر(م, ك, الوسم);
    (*ك).التمثيل[الوسم] := الناتج;
    أرجع الناتج;
}

// A struct or union only declared (`struct X;`, `typedef struct X X;`, a
// `struct X *` before or without a definition) is an opaque type: C code
// uses it through pointers only. So is one a header of the import declares
// incomplete and only a .c unit defines (the header is its interface: vec.h
// and vec.c then write the same `type vec = opaque;`, shared.sn makes it one
// type), and one whose layout has no SultanC form (over-aligned, empty).
عرف قرر_تمثيل_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الوسم: طبيعي): ط8 {
    دع الوسم_ر: وسم_سي_جسر = (*م).ج.الوسوم[الوسم];
    إذا (الوسم_ر.الصنف == 10 || (الوسم_ر.الاسم == 0 && !الوسم_ر.مكتمل)) { أرجع 0; };
    إذا (!الوسم_ر.مكتمل || الوسم_ر.الحجم == 0 || واجهته_ناقصة_جسر(م, &الوسم_ر)) { أرجع 4; };
    دع تخزين: ط8 = معتم_بلا_تخزين_جسر(تمثيل_تخزين_جسر(&الوسم_ر));
    إذا (الوسم_ر.الصنف == 9 || الوسم_ر.له_حقول_بتية) { أرجع تخزين; };
    // A record when every field has a SultanC form at the same offset.
    دع البت: متغير طبيعي = 0;
    دع المحاذاة: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الوسم_ر.عدد_الحقول) {
        دع الحقل: حقل_سي_جسر = (*م).ج.الحقول[الوسم_ر.بداية_الحقول + ف];
        ف := ف + 1;
        دع ن: نوع_سي_جسر = (*م).ج.الأنواع[الحقل.النوع];
        إذا (ن.الصنف == 6 && ن.مجهول_العدد) { تابع_حلقة; };
        دع س: حجم_جسر = تخطيط_سلطان_جسر(م, ك, الحقل.النوع);
        إذا (!س.صالح) { أرجع تخزين; };
        البت := محاذاة_لأعلى_ج(البت, س.المحاذاة);
        إذا (البت != الحقل.الإزاحة) { أرجع تخزين; };
        البت := البت + س.الحجم;
        إذا (س.المحاذاة > المحاذاة) { المحاذاة := س.المحاذاة; };
    }
    دع الحجم: طبيعي = محاذاة_لأعلى_ج(البت, المحاذاة);
    إذا (الحجم != الوسم_ر.الحجم || المحاذاة != الوسم_ر.المحاذاة || الوسم_ر.عدد_الحقول == 0) { أرجع تخزين; };
    أرجع 1;
}

عرف محاذاة_لأعلى_ج(القيمة: طبيعي, المحاذاة: طبيعي): طبيعي {
    إذا (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي_ن: طبيعي = القيمة % المحاذاة;
    إذا (الباقي_ن == 0) { أرجع القيمة; };
    أرجع القيمة + المحاذاة - الباقي_ن;
}

// A tag a header declared incomplete and a .c unit of the import defines.
عرف واجهته_ناقصة_جسر(م: &محلل_جسر, الوسم: &وسم_سي_جسر): منطقي {
    إذا ((*الوسم).ملف_ناقص == 0) { أرجع خطأ; };
    دع الناقص: &نص = &(*م).ع.الملفات[(*الوسم).ملف_ناقص - 1].المسار;
    دع المعرف: &نص = &(*م).ع.الملفات[(*الوسم).الملف].المسار;
    أرجع !ينتهي_بـ(الناقص, &«.c») && ينتهي_بـ(المعرف, &«.c»);
}

// Storage that has no SultanC form (0) leaves an opaque type (4).
عرف معتم_بلا_تخزين_جسر(التخزين: ط8): ط8 {
    إذا (التخزين == 0) { أرجع 4; };
    أرجع التخزين;
}

// Opaque storage: whole words of the record's alignment (at most 8) that
// fill its size, at most 512 of them.
عرف تمثيل_تخزين_جسر(الوسم: &وسم_سي_جسر): ط8 {
    دع المحاذاة: طبيعي = (*الوسم).المحاذاة;
    إذا (المحاذاة != 1 && المحاذاة != 2 && المحاذاة != 4 && المحاذاة != 8) { أرجع 0; };
    إذا ((*الوسم).الحجم % المحاذاة != 0 || (*الوسم).الحجم / المحاذاة > 512) { أرجع 0; };
    أرجع 2;
}

// Whether a C type has a floating member anywhere (opaque integer storage
// would pass it in the wrong registers by value).
عرف فيه_عائم_جسر(م: &محلل_جسر, النوع: طبيعي): منطقي {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    إذا (ن.الصنف == 4) { أرجع صواب; };
    إذا (ن.الصنف == 6) { أرجع فيه_عائم_جسر(م, ن.الأساس); };
    إذا (ن.الصنف == 8 || ن.الصنف == 9) {
        دع الوسم: وسم_سي_جسر = (*م).ج.الوسوم[ن.الوسم];
        دع ف: متغير طبيعي = 0;
        طالما (ف < الوسم.عدد_الحقول) {
            إذا (فيه_عائم_جسر(م, (*م).ج.الحقول[الوسم.بداية_الحقول + ف].النوع)) { أرجع صواب; };
            ف := ف + 1;
        }
    };
    أرجع خطأ;
}

// Whether opaque integer storage carries a record by value as C does: no
// floating member, or a union with a non-floating member of its full size
// (every eightbyte then has an integer part: System V's INTEGER class, and
// no homogeneous floating aggregate for AAPCS64).
عرف تخزين_بالقيمة_جسر(م: &محلل_جسر, النوع: طبيعي): منطقي {
    إذا (!فيه_عائم_جسر(م, النوع)) { أرجع صواب; };
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    إذا (ن.الصنف != 9) { أرجع خطأ; };
    دع الوسم: وسم_سي_جسر = (*م).ج.الوسوم[ن.الوسم];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الوسم.عدد_الحقول) {
        دع الحقل: حقل_سي_جسر = (*م).ج.الحقول[الوسم.بداية_الحقول + ف];
        دع ح: حجم_جسر = حجم_نوع_جسر(&(*م).ج, &(*م).النموذج, الحقل.النوع, صواب);
        إذا (!الحقل.بتي && ح.الحجم == الوسم.الحجم && !فيه_عائم_جسر(م, الحقل.النوع)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// ---- type spellings ----

// The spelling of a type as a value: الموضع 0 a parameter, 1 a result, 2
// a record field, 3 a type alias. Empty when it has none.
عام عرف تهجئة_قيمة_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, النوع: طبيعي, الموضع: ط8): نص {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    دع ص: ط8 = ن.الصنف;
    إذا (ص == 1) { إذا (الموضع == 1) { أرجع «void»; }; أرجع «»; };
    إذا (ص == 2) { أرجع «u8»; };
    إذا (ص == 3 || ص == 10) {
        إذا (ص == 10 && !(*م).ج.الوسوم[ن.الوسم].مكتمل) { أرجع «»; };
        دع أساس: نوع_سي_جسر = (*م).ج.الأنواع[بلا_تعداد_جسر(&(*م).ج, النوع)];
        أرجع صحيح_سلطان_جسر(أساس.العرض, أساس.موقع);
    };
    إذا (ص == 4) {
        إذا (ن.العرض == 32) { أرجع «f32»; };
        إذا (ن.العرض == 64 && ن.الرتبة != 7) { أرجع «f64»; };
        إذا (ن.الرتبة == 7 && (*م).النموذج.طويل_مزدوج_كمزدوج) { أرجع «f64»; };
        أرجع «»;
    };
    إذا (ص == 5) { أرجع تهجئة_مؤشر_جسر(م, ك, ن.الأساس); };
    إذا (ص == 11) {
        إذا ((*م).النموذج.صنف_قائمة_المعاملات == 0) { أرجع كلمة_عنوان_جسر(م); };
        أرجع «»;
    };
    إذا (ص == 6) {
        إذا (الموضع != 2 || ن.مجهول_العدد || ن.العدد == 0 || ن.العدد > 512) { أرجع «»; };
        دع العنصر: نص = تهجئة_قيمة_جسر(م, ك, ن.الأساس, 2);
        إذا ((الطول(العنصر) مثل طبيعي) == 0) { أرجع «»; };
        إذا (ن.العدد == 1) { أرجع العنصر; };
        دع البايتات: متغير متجه ط8 = [0x28];
        دع ف: متغير طبيعي = 0;
        طالما (ف < ن.العدد) {
            إذا (ف > 0) { ألحق(البايتات, 0x2C); ألحق(البايتات, 0x20); };
            ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&العنصر));
            ف := ف + 1;
        }
        ألحق(البايتات, 0x29);
        أرجع البايتات مثل نص;
    };
    إذا (ص == 8 || ص == 9) {
        دع التمثيل: ط8 = تمثيل_وسم_جسر(م, ك, ن.الوسم);
        إذا (التمثيل == 0) { أرجع «»; };
        // An opaque type has no value; a typedef names it (an alias).
        إذا (التمثيل == 4 && الموضع != 3) { أرجع «»; };
        // By value, opaque storage is integer words: no floating member.
        إذا (التمثيل == 2 && الموضع <= 1 && !تخزين_بالقيمة_جسر(م, النوع)) { أرجع «»; };
        أرجع اسم_وسم_مطلوب_جسر(م, ك, ن.الوسم);
    };
    أرجع «»;
}

عرف اسم_وسم_مطلوب_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الوسم: طبيعي): نص {
    مدد_كاتب_جسر(م, ك);
    (*ك).مطلوب[الوسم] := صواب;
    دع المعرف: طبيعي = اسم_وسم_جسر(م, ك, الوسم);
    أرجع اسم_م_ك_جسر(م, المعرف);
}

// The spelling of a pointer to المشار.
عرف تهجئة_مؤشر_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, المشار: طبيعي): نص {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[المشار];
    دع البادئة: متغير نص = «*mutable »;
    إذا (ن.ثابت) { البادئة := «*»; };
    دع ص: ط8 = ن.الصنف;
    إذا (ص == 1) { أرجع صل_نصين(&البادئة, &«void»); };
    إذا ((ص == 3 && ن.حرفي) || ص == 2) { أرجع صل_نصين(&البادئة, &«u8»); };
    إذا (ص == 3 || ص == 4 || ص == 10) {
        دع العنصر: نص = تهجئة_قيمة_جسر(م, ك, المشار, 2);
        إذا ((الطول(العنصر) مثل طبيعي) == 0) { أرجع كلمة_عنوان_جسر(م); };
        أرجع صل_نصين(&البادئة, &العنصر);
    };
    إذا (ص == 5) {
        دع الداخلي: نص = تهجئة_مؤشر_جسر(م, ك, ن.الأساس);
        أرجع صل_نصين(&البادئة, &الداخلي);
    };
    إذا (ص == 8 || ص == 9) {
        دع التمثيل: ط8 = تمثيل_وسم_جسر(م, ك, ن.الوسم);
        إذا (التمثيل == 0) { أرجع كلمة_عنوان_جسر(م); };
        أرجع صل_نصين(&البادئة, &اسم_وسم_مطلوب_جسر(م, ك, ن.الوسم));
    };
    إذا (ص == 6) {
        دع العنصر: نص = تهجئة_قيمة_جسر(م, ك, المشار, 2);
        إذا ((الطول(العنصر) مثل طبيعي) == 0) { أرجع كلمة_عنوان_جسر(م); };
        أرجع صل_نصين(&البادئة, &العنصر);
    };
    // A function, va_list or a type with no SultanC form: an address.
    أرجع كلمة_عنوان_جسر(م);
}

// ---- output helpers ----

عام عرف سطر_جسر(الهدف: &متغير متجه ط8, النص: نص): فراغ {
    ألحق_بايتات_نص(الهدف, النص);
    ألحق(*الهدف, 10);
}

عام عرف موقع_كيان_جسر(م: &محلل_جسر, الملف: طبيعي, السطر: طبيعي): نص {
    دع المسار: نص = انسخ_نص(&(*م).ع.الملفات[الملف].المسار);
    أرجع صل_ثلاثة_نصوص(&المسار, &«:», &طبيعي_إلى_نص(السطر));
}

// A declaration left out of the module: a warning of reason السبب_ت at its
// C location (the import still succeeds: the name is only missing), with
// the C name and, when given, the C type (النوع_) as facts. The generated
// module records it as `// skipped NAME (file:line): REASON-KEY [CODE]`,
// the reason's machine key (compiler/diagnostics/reason.sn), never prose.
عام عرف علق_تخطيا_جسر(م: &محلل_جسر, ك: &متغير كاتب_جسر, الاسم: طبيعي, الملف: طبيعي, السطر: طبيعي, العمود: طبيعي,
    السبب_ت: سبب_تشخيص, النوع_: نص): فراغ {
    علق_تخطيا_بتحذير_جسر(م, ك, الاسم, الملف, السطر, العمود, السبب_ت, النوع_, صواب);
}

// As علق_تخطيا_جسر; without the warning when يحذر is false (a typedef of
// va_list: ordinary C, reported where a function's parameter uses it).
عرف علق_تخطيا_بتحذير_جسر(م: &محلل_جسر, ك: &متغير كاتب_جسر, الاسم: طبيعي, الملف: طبيعي, السطر: طبيعي, العمود: طبيعي,
    السبب_ت: سبب_تشخيص, النوع_: نص, يحذر: منطقي): فراغ {
    دع الاسم_ن: نص = اسم_م_ك_جسر(م, الاسم);
    // No location (السطر 0): a declaration no file spells.
    دع المسار: متغير نص = «»;
    إذا (السطر > 0) { المسار := انسخ_نص(&(*م).ع.الملفات[الملف].المسار); };
    دع ت: متغير تشخيص_جسر = تشخيص_جسر_في(السبب_ت, &المسار, السطر, العمود, 0);
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(ت.السجل.المعرف);
    دع الكود: نص = انسخ_نص(&التعريف.الكود);
    إذا (!اسم_قابل_للتهجئة_جسر(&الاسم_ن) && نصان_متساويان(&الكود, &«SULTANC-C-NAME-CONFLICT-SKIPPED»)) {
        ت := تشخيص_جسر_في(سبب_تشخيص.سبب_سي_مخطى_اسم_بلا_تهجئة(), &المسار, السطر, العمود, 0);
        أضف_قيمة_سي(&متغير ت.السجل, محرف_بلا_تهجئة_جسر(&الاسم_ن));
    };
    إذا (السطر > 0) { ت.الملف_ف := الملف + 1; };
    أضف_رمز_سي(&متغير ت.السجل, انسخ_نص(&الاسم_ن));
    إذا ((الطول(النوع_) مثل طبيعي) > 0) { أضف_نوع_سي(&متغير ت.السجل, النوع_); };
    دع الأجزاء: متجه نص = [«// skipped », انسخ_نص(&الاسم_ن), « (», موقع_كيان_جسر(م, الملف, السطر), «): »,
        مفتاح_آلي_لسبب_تشخيص(ت.السجل.السبب), « [», الكود, «]»];
    سطر_جسر(&متغير (*ك).التعليقات, صل_النصوص(&الأجزاء, &«»));
    إذا (يحذر) { أضف_تشخيص_جسر(&متغير (*ك).التخطيات, ت); };
}

// The first character of الاسم a SultanC identifier cannot have, as U+XXXX.
عرف محرف_بلا_تهجئة_جسر(الاسم: &نص): نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(الاسم, ف);
        إذا (!المفكوك.صالح) { أرجع «»; };
        إذا ((ف == 0 && !بداية_معرف(المفكوك.القيمة)) || (ف > 0 && !تتمة_معرف(المفكوك.القيمة))) {
            أرجع نص_نقطة_يونيكود(المفكوك.القيمة);
        };
        ف := ف + المفكوك.العرض;
    }
    أرجع «»;
}

// A C type as C spells it (a diagnostic fact): `unsigned long`, `struct s *`,
// `int [4]`, `long double`, `__int128`.
عام عرف نص_نوع_سي_جسر(م: &محلل_جسر, النوع: طبيعي): نص {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    دع ص: ط8 = ن.الصنف;
    دع الثابت: نص = اختر_نص_ك_جسر(ن.ثابت, «const », «»);
    إذا (ص == 1) { أرجع صل_نصين(&الثابت, &«void»); };
    إذا (ص == 2) { أرجع صل_نصين(&الثابت, &«_Bool»); };
    إذا (ص == 3) {
        إذا (ن.البتات_الدقيقة > 0) {
            أرجع صل_ثلاثة_نصوص(&اختر_نص_ك_جسر(ن.موقع, «_BitInt(», «unsigned _BitInt(»), &طبيعي_إلى_نص(ن.البتات_الدقيقة), &«)»);
        };
        دع الاسم: متغير نص = «int»;
        إذا (ن.الرتبة == 2) { الاسم := «char»; }
        وإلا إذا (ن.الرتبة == 3) { الاسم := «short»; }
        وإلا إذا (ن.الرتبة == 5) { الاسم := «long»; }
        وإلا إذا (ن.الرتبة == 6) { الاسم := «long long»; }
        وإلا إذا (ن.العرض == 128) { الاسم := «__int128»; };
        إذا (!ن.موقع) { الاسم := صل_نصين(&«unsigned », &الاسم); }
        وإلا إذا (ن.حرفي && ن.الرتبة == 2) { الاسم := صل_نصين(&«signed », &الاسم); };
        أرجع صل_نصين(&الثابت, &الاسم);
    };
    إذا (ص == 4) {
        إذا (ن.الرتبة == 7) { أرجع صل_نصين(&الثابت, &«long double»); };
        أرجع صل_نصين(&الثابت, &اختر_نص_ك_جسر(ن.العرض == 32, «float», «double»));
    };
    إذا (ص == 5) { أرجع صل_ثلاثة_نصوص(&نص_نوع_سي_جسر(م, ن.الأساس), &« *», &اختر_نص_ك_جسر(ن.ثابت, « const», «»)); };
    إذا (ص == 6) {
        إذا (ن.مجهول_العدد) { أرجع صل_نصين(&نص_نوع_سي_جسر(م, ن.الأساس), &« []»); };
        أرجع صل_ثلاثة_نصوص(&نص_نوع_سي_جسر(م, ن.الأساس), &« [», &صل_نصين(&طبيعي_إلى_نص(ن.العدد), &«]»));
    };
    إذا (ص == 7) { أرجع صل_نصين(&نص_نوع_سي_جسر(م, ن.الأساس), &« ()»); };
    إذا (ص == 8 || ص == 9 || ص == 10) {
        دع الكلمة: نص = اختر_نص_ك_جسر(ص == 8, «struct», اختر_نص_ك_جسر(ص == 9, «union», «enum»));
        دع الوسم: وسم_سي_جسر = (*م).ج.الوسوم[ن.الوسم];
        إذا (الوسم.الاسم == 0) { أرجع صل_ثلاثة_نصوص(&الثابت, &الكلمة, &« (anonymous)»); };
        أرجع صل_ثلاثة_نصوص(&الثابت, &الكلمة, &صل_نصين(&« », &اسم_م_ك_جسر(م, الوسم.الاسم)));
    };
    إذا (ص == 11) { أرجع «va_list»; };
    إذا (ص == 12) { أرجع اسم_م_ك_جسر(م, ن.الاسم); };
    أرجع «»;
}

عرف اختر_نص_ك_جسر(الشرط: منطقي, أ: نص, ب: نص): نص {
    إذا (الشرط) { أرجع أ; };
    أرجع ب;
}

// A C string's bytes as a SultanC literal body, or none when they are not
// UTF-8 text without NUL.
عام عرف نص_سلطان_جسر(البايتات: &متجه ط8): اختياري نص {
    دع الناتج: متغير متجه ط8 = [];
    دع ن: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع ب: ط8 = (*البايتات)[ف];
        إذا (ب == 0) { أرجع اختياري.لا_شيء(); };
        إذا (ب == 0x22 || ب == 0x5C) { ألحق(الناتج, 0x5C); ألحق(الناتج, ب); ف := ف + 1; تابع_حلقة; };
        إذا (ب == 10) { ألحق(الناتج, 0x5C); ألحق(الناتج, 0x6E); ف := ف + 1; تابع_حلقة; };
        إذا (ب == 9) { ألحق(الناتج, 0x5C); ألحق(الناتج, 0x74); ف := ف + 1; تابع_حلقة; };
        إذا (ب == 13) { ألحق(الناتج, 0x5C); ألحق(الناتج, 0x72); ف := ف + 1; تابع_حلقة; };
        إذا (تحكم_أسكي(ب)) {
            // `\xHH` (std.encoding.hex).
            دع البايت: متجه ط8 = [ب];
            ألحق(الناتج, 0x5C);
            ألحق(الناتج, 0x78);
            ألحق_بايتات_نص(&متغير الناتج, رمز_سداسي(&البايت));
            ف := ف + 1;
            تابع_حلقة;
        };
        إذا (محرف_أسكي(ب)) { ألحق(الناتج, ب); ف := ف + 1; تابع_حلقة; };
        // A UTF-8 sequence, kept as is when valid (std.encoding.utf8).
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8_من_بايتات(البايتات, ف);
        إذا (!المفكوك.صالح) { أرجع اختياري.لا_شيء(); };
        دع ي: متغير طبيعي = 0;
        طالما (ي < المفكوك.العرض) { ألحق(الناتج, (*البايتات)[ف + ي]); ي := ي + 1; }
        ف := ف + المفكوك.العرض;
    }
    أرجع اختياري.موجود(الناتج مثل نص);
}

// An integer constant of C type النوع as `TYPE = LITERAL`.
عرف ثابت_صحيح_جسر(م: &محلل_جسر, البتات: ط64, النوع: طبيعي): نص {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[بلا_تعداد_جسر(&(*م).ج, النوع)];
    دع العرض: متغير طبيعي = ن.العرض;
    إذا (العرض < 32) { العرض := 32; };
    دع النوع_ن: نص = صحيح_سلطان_جسر(العرض, ن.موقع);
    دع الحرفي: متغير نص = طبيعي_إلى_نص(البتات مثل طبيعي);
    إذا (ن.موقع && (البتات & 0x8000000000000000) != 0) {
        إذا (العرض == 32 && البتات == 0xFFFFFFFF80000000) { الحرفي := «-2147483647 - 1»; }
        وإلا إذا (البتات == 0x8000000000000000) { الحرفي := «-9223372036854775807 - 1»; }
        وإلا { الحرفي := صل_نصين(&«-», &طبيعي_إلى_نص(طرح_ط64_ملتف(0, البتات) مثل طبيعي)); };
    } وإلا إذا (!ن.موقع && العرض == 32) {
        الحرفي := طبيعي_إلى_نص((البتات & 0xFFFFFFFF) مثل طبيعي);
    };
    أرجع صل_ثلاثة_نصوص(&النوع_ن, &« = », &الحرفي);
}

// ---- declarations ----

عرف اكتب_ثابتا_جسر(ك: &متغير كاتب_جسر, الاسم: &نص, القيمة: نص): فراغ {
    دع الأجزاء: متجه نص = [«public let », انسخ_نص(الاسم), «: », القيمة, «;»];
    سطر_جسر(&متغير (*ك).الثوابت_ن, صل_النصوص(&الأجزاء, &«»));
}

عرف اكتب_دالة_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الكيان: &كيان_سي_جسر): فراغ {
    دع الاسم_ج: نص = اسم_م_ك_جسر(م, (*الكيان).الاسم);
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[(*الكيان).النوع];
    إذا ((*الكيان).غير_متاح) {
        علق_تخطيا_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود, سبب_تشخيص.سبب_سي_مخطى_غير_متاح(), «»);
        أرجع;
    };
    // `f()` declares unknown parameters; only a definition `f() { }` says
    // there are none.
    إذا (ن.بلا_نموذج && (ن.قائمة_معرفات || !(*الكيان).معرف)) {
        علق_تخطيا_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود, سبب_تشخيص.سبب_سي_مخطى_بلا_نموذج(), «»);
        أرجع;
    };
    دع المعطيات: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن.عدد_المعطيات) {
        دع المعطى: طبيعي = (*م).ج.المعطيات[ن.بداية_المعطيات + ف];
        دع التهجئة: نص = تهجئة_قيمة_جسر(م, ك, المعطى, 0);
        إذا ((الطول(التهجئة) مثل طبيعي) == 0) {
            علق_تخطيا_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود, سبب_تشخيص.سبب_سي_مخطى_نوع_بلا_صيغة(), نص_نوع_سي_جسر(م, المعطى));
            أرجع;
        };
        ألحق(المعطيات, التهجئة);
        ف := ف + 1;
    }
    دع الناتج: نص = تهجئة_قيمة_جسر(م, ك, ن.الأساس, 1);
    إذا ((الطول(الناتج) مثل طبيعي) == 0) {
        علق_تخطيا_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود, سبب_تشخيص.سبب_سي_مخطى_ناتج_بلا_صيغة(), نص_نوع_سي_جسر(م, ن.الأساس));
        أرجع;
    };
    دع ملاحظة: متغير نص = «»;
    إذا (ن.متغير_المعاملات) {
        // Declared as the call shape with no variadic argument: the link
        // name `SYMBOL...N` (N fixed parameters) makes every backend call it
        // with the C variadic convention (msir/lowering/variadic_link_name.sn).
        ملاحظة := «  // variadic: SYMBOL...N call shapes»;
    };
    دع الاسم_س: نص = اسم_سلطان_جسر(&الاسم_ج);
    دع المعرف: طبيعي = احجز_اسما_جسر(م, ك, &الاسم_س);
    إذا (المعرف == 0) {
        علق_تخطيا_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود, سبب_تشخيص.سبب_سي_مخطى_اسم_مستعمل(), «»);
        أرجع;
    };
    دع البايتات: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير البايتات, «public extern def »);
    ألحق_بايتات_نص(&متغير البايتات, اسم_م_ك_جسر(م, المعرف));
    ألحق(البايتات, 0x28);
    ف := 0;
    طالما (ف < (الطول(المعطيات) مثل طبيعي)) {
        إذا (ف > 0) { ألحق_بايتات_نص(&متغير البايتات, «, »); };
        ألحق_بايتات_نص(&متغير البايتات, «p»);
        ألحق_بايتات_نص(&متغير البايتات, طبيعي_إلى_نص(ف));
        ألحق_بايتات_نص(&متغير البايتات, «: »);
        ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&المعطيات[ف]));
        ف := ف + 1;
    }
    ألحق_بايتات_نص(&متغير البايتات, «): »);
    ألحق_بايتات_نص(&متغير البايتات, الناتج);
    // The link name: the asm label (without the platform's symbol prefix,
    // which the backends add), else the C name when SultanC renamed it.
    دع الرابط: متغير نص = «»;
    إذا ((*الكيان).التسمية != 0) {
        دع التسمية: نص = اسم_م_ك_جسر(م, (*الكيان).التسمية);
        دع البادئة: نص = انسخ_نص(&(*م).النموذج.بادئة_الرموز);
        إذا ((الطول(البادئة) مثل طبيعي) > 0 && يبدأ_بـ(&التسمية, &البادئة)) {
            إذا ((الطول(التسمية) مثل طبيعي) > (الطول(البادئة) مثل طبيعي)) {
                طابق مقطع_نص(&التسمية, الطول(البادئة) مثل طبيعي, (الطول(التسمية) مثل طبيعي) - (الطول(البادئة) مثل طبيعي)) مع
                | اختياري.موجود(المقطع_ن) -> { الرابط := المقطع_ن; }
                | اختياري.لا_شيء -> { الرابط := «»; };
            } وإلا { الرابط := «»; };
        } وإلا إذا ((الطول(البادئة) مثل طبيعي) > 0) {
            علق_تخطيا_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود, سبب_تشخيص.سبب_سي_مخطى_لافتة_ربط(), «»);
            أرجع;
        } وإلا {
            الرابط := التسمية;
        };
        إذا (نصان_متساويان(&الرابط, &الاسم_ج) && !كلمة_سلطان_محجوزة_جسر(&الاسم_ج)) { الرابط := «»; };
    } وإلا إذا (كلمة_سلطان_محجوزة_جسر(&الاسم_ج)) {
        الرابط := انسخ_نص(&الاسم_ج);
    };
    إذا (ن.متغير_المعاملات) {
        إذا ((الطول(الرابط) مثل طبيعي) == 0) { الرابط := انسخ_نص(&الاسم_ج); };
        الرابط := صل_ثلاثة_نصوص(&الرابط, &«...», &طبيعي_إلى_نص(الطول(المعطيات) مثل طبيعي));
    };
    إذا ((الطول(الرابط) مثل طبيعي) > 0) {
        ألحق_بايتات_نص(&متغير البايتات, « = "»);
        ألحق_بايتات_نص(&متغير البايتات, الرابط);
        ألحق(البايتات, 0x22);
    };
    ألحق(البايتات, 0x3B);
    ألحق_بايتات_نص(&متغير البايتات, ملاحظة);
    ألحق(البايتات, 10);
    ألحق_من((*ك).الدوال_ن, &البايتات, 0, الطول(البايتات) مثل طبيعي);
}

// A C object as SultanC external data (`public extern let x: T = "x";`),
// read where it is used. Thread-local objects and arrays have no such form.
عرف اكتب_كائنا_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الكيان: &كيان_سي_جسر): فراغ {
    إذا ((*الكيان).خيطي) {
        علق_تخطيا_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود, سبب_تشخيص.سبب_سي_مخطى_كائن_خيطي(), «»);
        أرجع;
    };
    دع التهجئة: نص = تهجئة_قيمة_جسر(م, ك, (*الكيان).النوع, 0);
    إذا ((الطول(التهجئة) مثل طبيعي) == 0) {
        علق_تخطيا_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود, سبب_تشخيص.سبب_سي_مخطى_كائن_بلا_صيغة(), نص_نوع_سي_جسر(م, (*الكيان).النوع));
        أرجع;
    };
    دع الاسم_ج: نص = اسم_م_ك_جسر(م, (*الكيان).الاسم);
    دع الاسم_س: نص = اسم_سلطان_جسر(&الاسم_ج);
    دع المعرف: طبيعي = احجز_اسما_جسر(م, ك, &الاسم_س);
    إذا (المعرف == 0) { أرجع; };
    دع الرابط: متغير نص = انسخ_نص(&الاسم_ج);
    إذا ((*الكيان).التسمية != 0) {
        دع التسمية: نص = اسم_م_ك_جسر(م, (*الكيان).التسمية);
        دع البادئة: نص = انسخ_نص(&(*م).النموذج.بادئة_الرموز);
        إذا ((الطول(البادئة) مثل طبيعي) > 0 && يبدأ_بـ(&التسمية, &البادئة)) {
            إذا ((الطول(التسمية) مثل طبيعي) > (الطول(البادئة) مثل طبيعي)) {
                طابق مقطع_نص(&التسمية, الطول(البادئة) مثل طبيعي, (الطول(التسمية) مثل طبيعي) - (الطول(البادئة) مثل طبيعي)) مع
                | اختياري.موجود(المقطع_ن) -> { الرابط := المقطع_ن; }
                | اختياري.لا_شيء -> { الرابط := «»; };
            } وإلا { الرابط := «»; };
        } وإلا { الرابط := التسمية; };
    };
    دع الأجزاء: متجه نص = [«public extern let », الاسم_س, «: », التهجئة, « = "», الرابط, «";»];
    سطر_جسر(&متغير (*ك).الدوال_ن, صل_النصوص(&الأجزاء, &«»));
}


عرف اكتب_مرادفا_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الكيان: &كيان_سي_جسر): فراغ {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[(*الكيان).النوع];
    // A typedef that names its own anonymous (or same-named) tag is that
    // record's name already.
    دع الاسم_ج: نص = اسم_م_ك_جسر(م, (*الكيان).الاسم);
    دع الاسم_س: نص = اسم_سلطان_جسر(&الاسم_ج);
    إذا ((ن.الصنف == 8 || ن.الصنف == 9)) {
        دع التمثيل: ط8 = تمثيل_وسم_جسر(م, ك, ن.الوسم);
        دع معرف_الاسم: طبيعي = اعزل_نص_جسر(&متغير (*م).ع.المخزن, &الاسم_س);
        إذا (التمثيل != 0 && اسم_وسم_جسر(م, ك, ن.الوسم) == معرف_الاسم) {
            (*ك).مطلوب[ن.الوسم] := صواب;
            أرجع;
        };
    };
    دع التهجئة: متغير نص = تهجئة_قيمة_جسر(م, ك, (*الكيان).النوع, 3);
    إذا ((الطول(التهجئة) مثل طبيعي) == 0 && ن.الصنف == 7) {
        علق_تخطيا_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود, سبب_تشخيص.سبب_سي_مخطى_نوع_دالة(), نص_نوع_سي_جسر(م, (*الكيان).النوع));
        أرجع;
    };
    إذا ((الطول(التهجئة) مثل طبيعي) == 0) {
        علق_تخطيا_بتحذير_جسر(م, ك, (*الكيان).الاسم, (*الكيان).الملف, (*الكيان).السطر, (*الكيان).العمود,
            سبب_تشخيص.سبب_سي_مخطى_نوع_بلا_صيغة(), نص_نوع_سي_جسر(م, (*الكيان).النوع), ن.الصنف != 11);
        أرجع;
    };
    دع المعرف: طبيعي = احجز_اسما_جسر(م, ك, &الاسم_س);
    إذا (المعرف == 0) { أرجع; };
    دع الأجزاء: متجه نص = [«public type », اسم_م_ك_جسر(م, المعرف), « = », التهجئة, «;»];
    سطر_جسر(&متغير (*ك).الأنواع_ن, صل_النصوص(&الأجزاء, &«»));
}

// The record (or storage) of a tag.
عام عرف اكتب_وسما_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الوسم: طبيعي): فراغ {
    دع التمثيل: ط8 = تمثيل_وسم_جسر(م, ك, الوسم);
    دع الاسم: نص = اسم_م_ك_جسر(م, اسم_وسم_جسر(م, ك, الوسم));
    دع الوسم_ر: وسم_سي_جسر = (*م).ج.الوسوم[الوسم];
    دع البايتات: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير البايتات, «public type »);
    ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&الاسم));
    إذا (التمثيل == 4) {
        ألحق_بايتات_نص(&متغير البايتات, « = opaque;»);
        ألحق(البايتات, 10);
        ألحق_من((*ك).الأنواع_ن, &البايتات, 0, الطول(البايتات) مثل طبيعي);
        أرجع;
    };
    ألحق_بايتات_نص(&متغير البايتات, « = { »);
    إذا (التمثيل == 2) {
        دع الكلمة: نص = صحيح_سلطان_جسر(الوسم_ر.المحاذاة * 8, خطأ);
        دع العدد: طبيعي = الوسم_ر.الحجم / الوسم_ر.المحاذاة;
        ألحق_بايتات_نص(&متغير البايتات, «opaque: »);
        إذا (العدد == 1) {
            ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&الكلمة));
        } وإلا {
            ألحق(البايتات, 0x28);
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                إذا (ف > 0) { ألحق_بايتات_نص(&متغير البايتات, «, »); };
                ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&الكلمة));
                ف := ف + 1;
            }
            ألحق(البايتات, 0x29);
        };
        ألحق_بايتات_نص(&متغير البايتات, « };»);
        // The storage's cause as a key: union, bit-fields or layout.
        دع السبب: متغير نص = «union»;
        إذا (الوسم_ر.الصنف == 8) {
            السبب := «layout»;
            إذا (الوسم_ر.له_حقول_بتية) { السبب := «bit-fields»; };
        };
        ألحق_بايتات_نص(&متغير البايتات, صل_ثلاثة_نصوص(&«  // opaque storage: », &السبب, &صل_ثلاثة_نصوص(&« (», &موقع_كيان_جسر(م, الوسم_ر.الملف, الوسم_ر.السطر), &«)»)));
        ألحق(البايتات, 10);
        ألحق_من((*ك).الأنواع_ن, &البايتات, 0, الطول(البايتات) مثل طبيعي);
        أرجع;
    };
    دع مجهول: متغير طبيعي = 0;
    دع أول: متغير منطقي = صواب;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الوسم_ر.عدد_الحقول) {
        دع الحقل: حقل_سي_جسر = (*م).ج.الحقول[الوسم_ر.بداية_الحقول + ف];
        ف := ف + 1;
        دع ن: نوع_سي_جسر = (*م).ج.الأنواع[الحقل.النوع];
        إذا (ن.الصنف == 6 && ن.مجهول_العدد) { تابع_حلقة; };
        إذا (!أول) { ألحق_بايتات_نص(&متغير البايتات, «, »); };
        أول := خطأ;
        إذا (الحقل.الاسم == 0) {
            مجهول := مجهول + 1;
            ألحق_بايتات_نص(&متغير البايتات, صل_نصين(&«anon», &طبيعي_إلى_نص(مجهول)));
        } وإلا {
            دع اسم_الحقل: نص = اسم_م_ك_جسر(م, الحقل.الاسم);
            ألحق_بايتات_نص(&متغير البايتات, اسم_سلطان_جسر(&اسم_الحقل));
        };
        ألحق_بايتات_نص(&متغير البايتات, «: »);
        ألحق_بايتات_نص(&متغير البايتات, تهجئة_قيمة_جسر(م, ك, الحقل.النوع, 2));
    }
    ألحق_بايتات_نص(&متغير البايتات, « };»);
    إذا (الوسم_ر.له_مرن) { ألحق_بايتات_نص(&متغير البايتات, «  // flexible array member: not a field»); };
    ألحق(البايتات, 10);
    ألحق_من((*ك).الأنواع_ن, &البايتات, 0, الطول(البايتات) مثل طبيعي);
}

// ---- constants ----

عرف اكتب_تعدادا_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الكيان: &كيان_سي_جسر): فراغ {
    دع الاسم_ج: نص = اسم_م_ك_جسر(م, (*الكيان).الاسم);
    دع الاسم: نص = اسم_سلطان_جسر(&الاسم_ج);
    دع المعرف: طبيعي = احجز_اسما_جسر(م, ك, &الاسم);
    إذا (المعرف == 0) { أرجع; };
    // An enumerator is an int; a value beyond int keeps 64 bits. A C23
    // constexpr constant keeps its declared type.
    دع ق: ط64 = (*الكيان).القيمة;
    دع النوع: متغير طبيعي = ن_صحيح_جسر();
    دع المصرح: طبيعي = بلا_تعداد_جسر(&(*م).ج, (*الكيان).النوع);
    إذا ((*م).ج.الأنواع[المصرح].الصنف == 3 || (*م).ج.الأنواع[المصرح].الصنف == 2) {
        إذا ((*م).ج.الأنواع[المصرح].العرض != (*م).النموذج.عرض_الصحيح || !(*م).ج.الأنواع[المصرح].موقع) {
            اكتب_ثابتا_جسر(ك, &الاسم, ثابت_صحيح_جسر(م, ق, المصرح));
            أرجع;
        };
    };
    إذا (!يناسب_صحيحا_جسر(ق, (*م).النموذج.عرض_الصحيح)) {
        إذا ((ق & 0x8000000000000000) != 0) { النوع := ن_طويل2_جسر(); }
        وإلا إذا (ق <= 0xFFFFFFFF) { النوع := ن_صحيح_طبيعي_جسر(); }
        وإلا { النوع := ن_طويل2_طبيعي_جسر(); };
    };
    اكتب_ثابتا_جسر(ك, &الاسم, ثابت_صحيح_جسر(م, ق, النوع));
}

عرف يناسب_صحيحا_جسر(ق: ط64, العرض: طبيعي): منطقي {
    إذا (العرض >= 64) { أرجع صواب; };
    دع الحد: ط64 = 1 << ((العرض - 1) مثل ط64);
    أرجع جمع_ط64_ملتف(ق, الحد) < 2 * الحد;
}

// An object-like macro whose expansion is a constant.
عرف اكتب_ماكرو_جسر(م: &متغير محلل_جسر, ك: &متغير كاتب_جسر, الماكرو: طبيعي, رئيسي: منطقي): فراغ {
    دع الاسم_ج: نص = اسم_م_ك_جسر(م, (*م).ع.الماكروهات[الماكرو].الاسم);
    دع الاسم: نص = اسم_سلطان_جسر(&الاسم_ج);
    دع المعرف_ن: طبيعي = اعزل_نص_جسر(&متغير (*م).ع.المخزن, &الاسم);
    إذا (مستعمل_جسر(ك, المعرف_ن)) { أرجع; };
    إذا ((*م).ع.الماكروهات[الماكرو].دالي) {
        إذا (رئيسي) {
            علق_تخطيا_جسر(م, ك, (*م).ع.الماكروهات[الماكرو].الاسم, (*م).ع.الماكروهات[الماكرو].الملف, (*م).ع.الماكروهات[الماكرو].السطر, (*م).ع.الماكروهات[الماكرو].العمود, سبب_تشخيص.سبب_سي_مخطى_ماكرو_دالي(), «»);
        };
        أرجع;
    };
    دع الرموز: متجه رمز_جسر = وسع_ماكرو_جسر(&متغير (*م).ع, الماكرو);
    دع ن: طبيعي = الطول(الرموز) مثل طبيعي;
    إذا (ن == 0) { أرجع; };
    // String literals (adjacent ones joined), plain or u8 only.
    إذا (الرموز[0].الصنف == 3) {
        دع البايتات: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        دع صالح: متغير منطقي = صواب;
        طالما (ف < ن) {
            إذا (الرموز[ف].الصنف != 3) { صالح := خطأ; اخرج_من_حلقة; };
            دع النص: نص = اسم_م_ك_جسر(م, الرموز[ف].المعرف);
            دع المفكوك: حرفي_مفكوك_جسر = فك_حرفي_جسر(&النص);
            إذا (!المفكوك.صالح || المفكوك.البادئة != 0) { صالح := خطأ; اخرج_من_حلقة; };
            دع ي: متغير طبيعي = 0;
            طالما (ي < (الطول(المفكوك.الوحدات) مثل طبيعي)) { ألحق(البايتات, (المفكوك.الوحدات[ي] & 0xFF) مثل ط8); ي := ي + 1; }
            ف := ف + 1;
        }
        إذا (!صالح) { أرجع; };
        طابق نص_سلطان_جسر(&البايتات) مع
        | اختياري.موجود(المحتوى) -> {
            استعمل_جسر(ك, المعرف_ن);
            اكتب_ثابتا_جسر(ك, &الاسم, صل_ثلاثة_نصوص(&«string = "», &المحتوى, &«"»));
        }
        | اختياري.لا_شيء -> {
            إذا (رئيسي) {
                علق_تخطيا_جسر(م, ك, (*م).ع.الماكروهات[الماكرو].الاسم, (*م).ع.الماكروهات[الماكرو].الملف, (*م).ع.الماكروهات[الماكرو].السطر, (*م).ع.الماكروهات[الماكرو].العمود, سبب_تشخيص.سبب_سي_مخطى_ماكرو_نص_غير_صالح(), «»);
            };
        };
        أرجع;
    };
    // A floating literal, possibly negated or parenthesized.
    دع عائم: نص = عائم_رموز_جسر(م, &الرموز);
    إذا ((الطول(عائم) مثل طبيعي) > 0) {
        استعمل_جسر(ك, المعرف_ن);
        اكتب_ثابتا_جسر(ك, &الاسم, عائم);
        أرجع;
    };
    طابق قيم_رموزا_جسر(م, &الرموز) مع
    | اختياري.موجود(ق) -> {
        استعمل_جسر(ك, المعرف_ن);
        اكتب_ثابتا_جسر(ك, &الاسم, ثابت_صحيح_جسر(م, ق.البتات, ق.النوع));
    }
    | اختياري.لا_شيء -> { };
}

// `f64 = 1.5` for a macro that is one floating literal (with optional
// minus sign and parentheses), else "".
عرف عائم_رموز_جسر(م: &محلل_جسر, الرموز: &متجه رمز_جسر): نص {
    دع ن: طبيعي = الطول(*الرموز) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = ن;
    دع ك: كلمات_محلل_جسر = (*م).ك;
    طالما (ف + 1 < النهاية && (*الرموز)[ف].المعرف == ك.ك_lparen && (*الرموز)[النهاية - 1].المعرف == ك.ك_rparen) {
        ف := ف + 1;
        النهاية := النهاية - 1;
    }
    دع سالب: متغير منطقي = خطأ;
    إذا (ف < النهاية && (*الرموز)[ف].الصنف == 5 && (*الرموز)[ف].المعرف == ك.ك_minus) { سالب := صواب; ف := ف + 1; };
    إذا (ف + 1 != النهاية || (*الرموز)[ف].الصنف != 2) { أرجع «»; };
    دع النص: نص = اسم_م_ك_جسر(م, (*الرموز)[ف].المعرف);
    دع العدد: عدد_حرفي_جسر = حلل_عدد_صحيح_جسر(&النص);
    إذا (العدد.صالح) { أرجع «»; };
    دع العائم: عائم_حرفي_جسر = حلل_عائم_جسر(&النص);
    إذا (!العائم.صالح) { أرجع «»; };
    دع النوع: متغير نص = «f64 = »;
    إذا (العائم.العرض == 32) { النوع := «f32 = »; };
    // A long double constant is an f64 where long double is double.
    إذا (العائم.العرض == 128 && !(*م).النموذج.طويل_مزدوج_كمزدوج) { أرجع «»; };
    إذا (سالب) { أرجع صل_ثلاثة_نصوص(&النوع, &«-», &العائم.النص); };
    أرجع صل_نصين(&النوع, &العائم.النص);
}

// ---- the module ----

عام عرف عائلي_م_جسر(م: &محلل_جسر, الملف: طبيعي): منطقي { أرجع (*م).ع.الملفات[الملف].عائلي; }

// The SultanC module for the parsed translation unit. وحدة: the imported
// file is a .c whose function definitions are compiled and linked.
عام عرف اكتب_وحدة_جسر(م: &متغير محلل_جسر, الملف: &نص, وحدة_ترجمة: منطقي): نص {
    دع ك: متغير كاتب_جسر = كاتب_جديد_جسر(م, وحدة_ترجمة);
    دع لا_تخطي: متجه منطقي = [];
    اكتب_تصريحات_جسر(م, &متغير ك, الملف, &لا_تخطي);
    اكتب_الوسوم_المطلوبة_جسر(م, &متغير ك);
    دع لا_إضافة: متجه ط8 = [];
    أرجع اجمع_وحدة_جسر(م, &ك, الملف, &لا_إضافة);
}

// A writer for the module of the parsed translation unit.
عام عرف كاتب_جديد_جسر(م: &متغير محلل_جسر, وحدة_ترجمة: منطقي): كاتب_جسر {
    دع عدد_الوسوم: طبيعي = الطول((*م).ج.الوسوم) مثل طبيعي;
    دع التمثيل: متغير متجه ط8 = [];
    دع مطلوب: متغير متجه منطقي = [];
    دع مكتوب: متغير متجه منطقي = [];
    دع الأسماء: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الوسوم) { ألحق(التمثيل, 255); ألحق(مطلوب, خطأ); ألحق(مكتوب, خطأ); ألحق(الأسماء, 0); ف := ف + 1; }
    دع المستعملة: متجه منطقي = [];
    دع ف1: متجه ط8 = [];
    دع ف2: متجه ط8 = [];
    دع ف3: متجه ط8 = [];
    دع ف4: متجه ط8 = [];
    دع بلا_تخطيات: متجه تشخيص_جسر = [];
    دع ك: كاتب_جسر = {
        التمثيل: التمثيل, مطلوب: مطلوب, مكتوب: مكتوب, الأسماء: الأسماء, المستعملة: المستعملة,
        الأنواع_ن: ف1, الدوال_ن: ف2, الثوابت_ن: ف3, التعليقات: ف4, التخطيات: بلا_تخطيات, مجهول: 0,
        وحدة_ترجمة: وحدة_ترجمة
    };
    أرجع ك;
}

// The declarations of the family: its tags, typedefs, functions, objects,
// enumerators and constant macros. Entities marked in المتخطاة (the
// definitions Jisr compiles) are left to lower.sn.
عام عرف اكتب_تصريحات_جسر(م: &متغير محلل_جسر, ك_: &متغير كاتب_جسر, الملف: &نص, المتخطاة: &متجه منطقي): فراغ {
    دع عدد_الوسوم: طبيعي = الطول((*م).ج.الوسوم) مثل طبيعي;
    دع وحدة_ترجمة: منطقي = (*ك_).وحدة_ترجمة;
    // Tags the family defines, or names without a definition (an opaque
    // type: ordinary C, no diagnostic).
    دع ف: متغير طبيعي = 1;
    طالما (ف < عدد_الوسوم) {
        دع الوسم: وسم_سي_جسر = (*م).ج.الوسوم[ف];
        إذا ((الوسم.مكتمل || الوسم.الاسم != 0) && الوسم.الصنف != 10 && !الوسم.محلي && عائلي_م_جسر(م, الوسم.الملف)) {
            دع اسم_الوسم: نص = اسم_م_ك_جسر(م, الوسم.الاسم);
            دع التمثيل: ط8 = تمثيل_وسم_جسر(م, ك_, ف);
            إذا (التمثيل != 0 && (التمثيل != 4 || الوسم.الاسم != 0)) {
                إذا (الوسم.الاسم == 0 || !اسم_مخفي_جسر(م, &اسم_الوسم)) { (*ك_).مطلوب[ف] := صواب; };
            };
        };
        ف := ف + 1;
    }
    // Typedefs, functions, enumerators of the family, in order.
    ف := 0;
    طالما (ف < (الطول((*م).الكيانات) مثل طبيعي)) {
        دع الكيان: كيان_سي_جسر = (*م).الكيانات[ف];
        دع المتخطى: منطقي = ف < (الطول(*المتخطاة) مثل طبيعي) && (*المتخطاة)[ف];
        ف := ف + 1;
        إذا (!عائلي_م_جسر(م, الكيان.الملف) || الكيان.محلي) { تابع_حلقة; };
        دع الاسم: نص = اسم_م_ك_جسر(م, الكيان.الاسم);
        إذا (اسم_مخفي_جسر(م, &الاسم)) { تابع_حلقة; };
        إذا (المتخطى) { تابع_حلقة; };
        إذا (الكيان.الصنف == 1) { اكتب_مرادفا_جسر(م, ك_, &الكيان); }
        وإلا إذا (الكيان.الصنف == 4) { اكتب_تعدادا_جسر(م, ك_, &الكيان); }
        وإلا إذا (الكيان.الصنف == 2) {
            إذا (الكيان.ساكن) { تابع_حلقة; };
            إذا (الكيان.معرف && (الكيان.مضمن || !وحدة_ترجمة)) { تابع_حلقة; };
            // A .c import provides the functions it defines: a prototype of
            // one defined elsewhere (another .c import, a library) is that
            // one's, and would make its name ambiguous.
            إذا (وحدة_ترجمة && !الكيان.معرف) { تابع_حلقة; };
            دع الرئيسية: نص = «main»;
            إذا (نصان_متساويان(&الاسم, &الرئيسية)) { تابع_حلقة; };
            اكتب_دالة_جسر(م, ك_, &الكيان);
        } وإلا {
            إذا (!الكيان.ساكن) { اكتب_كائنا_جسر(م, ك_, &الكيان); };
        };
    }
    // Object-like macros of the family, in definition order.
    دع رئيسي_ملف: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول((*م).ع.الملفات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*م).ع.الملفات[ف].المسار, الملف)) { رئيسي_ملف := ف; };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*م).ع.الماكروهات) مثل طبيعي)) {
        دع الماكرو_ر: طبيعي = ف;
        ف := ف + 1;
        دع الاسم_م: طبيعي = (*م).ع.الماكروهات[الماكرو_ر].الاسم;
        // Only the definition in force at the end.
        إذا (الاسم_م >= (الطول((*م).ع.ماكرو_المعرف) مثل طبيعي) || (*م).ع.ماكرو_المعرف[الاسم_م] != الماكرو_ر + 1) { تابع_حلقة; };
        إذا ((*م).ع.الماكروهات[الماكرو_ر].المدمج != 0) { تابع_حلقة; };
        دع ملف_م: طبيعي = (*م).ع.الماكروهات[الماكرو_ر].الملف;
        إذا (!عائلي_م_جسر(م, ملف_م)) { تابع_حلقة; };
        دع الاسم: نص = اسم_م_ك_جسر(م, الاسم_م);
        إذا (اسم_مخفي_جسر(م, &الاسم)) { تابع_حلقة; };
        اكتب_ماكرو_جسر(م, ك_, الماكرو_ر, ملف_م == رئيسي_ملف);
    }
}

// The records of every tag the module needs, until no new one is.
عام عرف اكتب_الوسوم_المطلوبة_جسر(م: &متغير محلل_جسر, ك_: &متغير كاتب_جسر): فراغ {
    مدد_كاتب_جسر(م, ك_);
    دع عدد_الوسوم: طبيعي = الطول((*م).ج.الوسوم) مثل طبيعي;
    دع ف: متغير طبيعي = 1;
    دع تقدم: متغير منطقي = صواب;
    طالما (تقدم) {
        تقدم := خطأ;
        ف := 1;
        طالما (ف < عدد_الوسوم) {
            إذا ((*ك_).مطلوب[ف] && !(*ك_).مكتوب[ف]) {
                (*ك_).مكتوب[ف] := صواب;
                اكتب_وسما_جسر(م, ك_, ف);
                تقدم := صواب;
            };
            ف := ف + 1;
        }
    }
}

// The module text: the C diagnostics, then the declarations written and
// الإضافة (lower.sn's compiled code).
عام عرف اجمع_وحدة_جسر(م: &متغير محلل_جسر, ك_: &كاتب_جسر, الملف: &نص, الإضافة: &متجه ط8): نص {
    دع ف: متغير طبيعي = 0;
    // The module text.
    دع الناتج: متغير متجه ط8 = [];
    سطر_جسر(&متغير الناتج, صل_ثلاثة_نصوص(&«// Generated by sultanc (Jisr) from the C file », الملف, &صل_ثلاثة_نصوص(&« for », &(*م).النموذج.التهجئة, &«.»)));
    دع أخطاء: متغير متجه نص = [];
    ف := 0;
    طالما (ف < (الطول((*م).ع.التشخيصات) مثل طبيعي)) {
        دع النص: نص = نص_تشخيص_جسر(&(*م).ع.التشخيصات[ف]);
        دع السلسلة: متجه موقع_سي = سلسلة_تضمين_جسر(&(*م).ع, (*م).ع.التشخيصات[ف].الملف_ف);
        إذا ((*م).ع.التشخيصات[ف].خطأ_) {
            سطر_جسر(&متغير الناتج, صل_نصين(&«// error: », &النص));
            أبلغ_تشخيص_جسر(&(*م).ع.التشخيصات[ف], &السلسلة);
            إذا ((الطول(أخطاء) مثل طبيعي) < 8) { ألحق(أخطاء, النص); };
        } وإلا {
            // A warning is reported too; the comment documents it.
            سطر_جسر(&متغير الناتج, صل_نصين(&«// warning: », &النص));
            أبلغ_تشخيص_جسر(&(*م).ع.التشخيصات[ف], &السلسلة);
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*ك_).التخطيات) مثل طبيعي)) {
        دع السلسلة: متجه موقع_سي = سلسلة_تضمين_جسر(&(*م).ع, (*ك_).التخطيات[ف].الملف_ف);
        أبلغ_تشخيص_جسر(&(*ك_).التخطيات[ف], &السلسلة);
        ف := ف + 1;
    }
    إذا ((الطول(أخطاء) مثل طبيعي) > 0) {
        // The import fails at compile time with the C diagnostics.
        سطر_جسر(&متغير الناتج, «import std.meta.reflect;»);
        دع البايتات: متغير متجه ط8 = [];
        ف := 0;
        طالما (ف < (الطول(أخطاء) مثل طبيعي)) {
            إذا (ف > 0) { ألحق_بايتات_نص(&متغير البايتات, « | »); };
            ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&أخطاء[ف]));
            ف := ف + 1;
        }
        دع المحتوى: نص = البايتات مثل نص;
        دع المحتوى_ن: متغير متجه ط8 = بايتات_من_نص(انسخ_نص(&المحتوى));
        دع الحرفي: نص = نص_سلطان_مرن_جسر(&المحتوى_ن);
        سطر_جسر(&متغير الناتج, صل_ثلاثة_نصوص(&«def jisr_c_errors(): void { comptime { compile_error("», &الحرفي, &«"); }; }»));
    };
    // Declarations an earlier C import of this compilation wrote are left
    // to it (shared.sn).
    دع التصريحات: متغير متجه ط8 = [];
    ألحق_من(التصريحات, &(*ك_).الأنواع_ن, 0, الطول((*ك_).الأنواع_ن) مثل طبيعي);
    ألحق_من(التصريحات, &(*ك_).الدوال_ن, 0, الطول((*ك_).الدوال_ن) مثل طبيعي);
    ألحق_من(التصريحات, &(*ك_).الثوابت_ن, 0, الطول((*ك_).الثوابت_ن) مثل طبيعي);
    دع المشتركة: متجه ط8 = شارك_تصريحات_جسر(&التصريحات);
    ألحق_من(الناتج, &(*ك_).التعليقات, 0, الطول((*ك_).التعليقات) مثل طبيعي);
    ألحق_من(الناتج, &المشتركة, 0, الطول(المشتركة) مثل طبيعي);
    ألحق_من(الناتج, الإضافة, 0, الطول(*الإضافة) مثل طبيعي);
    أرجع الناتج مثل نص;
}

// A text as a SultanC literal body, any byte that is not text escaped.
عرف نص_سلطان_مرن_جسر(البايتات: &متجه ط8): نص {
    طابق نص_سلطان_جسر(البايتات) مع
    | اختياري.موجود(النص) -> { أرجع النص; }
    | اختياري.لا_شيء -> { };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) {
        دع ب: ط8 = (*البايتات)[ف];
        إذا (قابل_للطباعة_أسكي(ب) && ب != 0x22 && ب != 0x5C) { ألحق(الناتج, ب); } وإلا { ألحق(الناتج, 0x3F); };
        ف := ف + 1;
    }
    أرجع الناتج مثل نص;
}
