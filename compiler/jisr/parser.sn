// A definition of the translation unit that Jisr compiles (a .c import):
// الصنف 1 a function body (tokens [البداية, النهاية), its '{' first), 2 an
// object with an initializer (the tokens after '='), 3 an object defined
// without one (zero). موضع_الاسم: the declarator's name token.
عام نوع تعريف_جسر = {
    الصنف: ط8,
    الكيان: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي,
    موضع_الاسم: طبيعي
};

عام نوع محلل_جسر = {
    ع: معالج_جسر,
    الرموز: متجه رمز_جسر,
    الموضع: طبيعي,
    النموذج: نموذج_سي_جسر,
    ج: جدول_أنواع_جسر,
    ك: كلمات_محلل_جسر,
    الكيانات: متجه كيان_سي_جسر,
    // Spelling id -> 1 + entity (the ordinary namespace) / tag (0: none).
    ربط_عادي: متجه طبيعي,
    ربط_وسوم: متجه طبيعي,
    // The type of each tag.
    نوع_الوسم: متجه طبيعي,
    الحزم: متجه طبيعي,
    الحزمة: طبيعي,
    فشل_التقييم: منطقي,
    // Evaluating a macro for a constant: failures are silent.
    صامت: منطقي,
    // Inside a function body: identifiers C declares there (parameters,
    // locals) are not in Jisr's tables, so an unknown one is not reported.
    في_جسم: منطقي,
    // Block scopes: (id, previous binding) pairs to restore, for the
    // ordinary and the tag namespace, and where each open scope begins.
    الظلال: متجه طبيعي,
    ظلال_الوسوم: متجه طبيعي,
    بدايات_النطاقات: متجه طبيعي,
    // Function bodies and object definitions are recorded for compilation
    // (body.sn, lower.sn) when ترجمة_الأجسام is set.
    ترجمة_الأجسام: منطقي,
    التعريفات: متجه تعريف_جسر,
    // A project file's own names are written even when C reserves their
    // spelling for the implementation (`__Text_Slice__`); a system
    // header's never are.
    محجوزة_مكتوبة: منطقي
};

// A parser over the preprocessor's output (moved in).
عام عرف محلل_جسر_جديد(المعالج: معالج_جسر, النموذج: نموذج_سي_جسر): محلل_جسر {
    دع ع: متغير معالج_جسر = المعالج;
    دع الرموز: متغير متجه رمز_جسر = [];
    بدّل(الرموز, ع.الناتج);
    دع ك: كلمات_محلل_جسر = كلمات_محلل_جديدة_جسر(&متغير ع.المخزن);
    دع ج: جدول_أنواع_جسر = جدول_أنواع_جسر_جديد(&النموذج);
    دع الكيانات: متجه كيان_سي_جسر = [];
    دع ربط_عادي: متجه طبيعي = [];
    دع ربط_وسوم: متجه طبيعي = [];
    دع نوع_الوسم: متغير متجه طبيعي = [];
    ألحق(نوع_الوسم, 0);
    دع الحزم: متجه طبيعي = [];
    دع الظلال: متجه طبيعي = [];
    دع ظلال_الوسوم: متجه طبيعي = [];
    دع بدايات_النطاقات: متجه طبيعي = [];
    دع التعريفات: متجه تعريف_جسر = [];
    دع الناتج: محلل_جسر = {
        ع: ع, الرموز: الرموز, الموضع: 0, النموذج: النموذج, ج: ج, ك: ك, الكيانات: الكيانات,
        ربط_عادي: ربط_عادي, ربط_وسوم: ربط_وسوم, نوع_الوسم: نوع_الوسم, الحزم: الحزم, الحزمة: 0,
        فشل_التقييم: خطأ, صامت: خطأ, في_جسم: خطأ, الظلال: الظلال, ظلال_الوسوم: ظلال_الوسوم,
        بدايات_النطاقات: بدايات_النطاقات, ترجمة_الأجسام: خطأ, التعريفات: التعريفات, محجوزة_مكتوبة: خطأ
    };
    أرجع الناتج;
}

// ---- tokens ----

عام عرف رمز_م_جسر(م: &محلل_جسر): رمز_جسر {
    إذا ((*م).الموضع >= (الطول((*م).الرموز) مثل طبيعي)) { أرجع رمز_نهاية_جسر(); };
    أرجع (*م).الرموز[(*م).الموضع];
}

عام عرف رمز_بعد_جسر(م: &محلل_جسر, الإزاحة: طبيعي): رمز_جسر {
    إذا ((*م).الموضع + الإزاحة >= (الطول((*م).الرموز) مثل طبيعي)) { أرجع رمز_نهاية_جسر(); };
    أرجع (*م).الرموز[(*م).الموضع + الإزاحة];
}

عام عرف تقدم_جسر(م: &متغير محلل_جسر): فراغ { (*م).الموضع := (*م).الموضع + 1; }

عام عرف عند_جسر(م: &محلل_جسر, المعرف: طبيعي): منطقي {
    دع ر: رمز_جسر = رمز_م_جسر(م);
    أرجع ر.الصنف != 0 && ر.الصنف != 3 && ر.الصنف != 4 && ر.الصنف != 2 && ر.المعرف == المعرف;
}

عام عرف عند_بعد_جسر(م: &محلل_جسر, الإزاحة: طبيعي, المعرف: طبيعي): منطقي {
    دع ر: رمز_جسر = رمز_بعد_جسر(م, الإزاحة);
    أرجع ر.الصنف != 0 && ر.الصنف != 3 && ر.الصنف != 4 && ر.الصنف != 2 && ر.المعرف == المعرف;
}

عام عرف اقبل_جسر(م: &متغير محلل_جسر, المعرف: طبيعي): منطقي {
    إذا (عند_جسر(م, المعرف)) { تقدم_جسر(م); أرجع صواب; };
    أرجع خطأ;
}

عام عرف نهاية_جسر(م: &محلل_جسر): منطقي { أرجع (*م).الموضع >= (الطول((*م).الرموز) مثل طبيعي); }

عام عرف اسم_م_جسر(م: &محلل_جسر, المعرف: طبيعي): نص { أرجع نص_معرف_جسر(&(*م).ع.المخزن, المعرف); }

// ---- diagnostics ----

// Errors in a written (family) file fail the import; in other headers they
// are warnings (their declarations are only read).
عرف نصان_متساويان_م_جسر(أ: &نص, ب: نص): منطقي { أرجع نصان_متساويان(أ, &ب); }

// A diagnostic of reason السبب at token الرمز. In a header the import only
// reads (outside its family), an error does not fail the import: it is
// reported as such (core.sn, في_مقروءة).
عام عرف تشخيص_م_جسر(م: &محلل_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر): تشخيص_جسر {
    دع الملف: نص = انسخ_نص(&(*م).ع.الملفات[(*الرمز).الملف].المسار);
    دع الناتج: متغير تشخيص_جسر = تشخيص_جسر_في(السبب, &الملف, (*الرمز).السطر, (*الرمز).العمود, (*الرمز).الطول);
    الناتج.الملف_ف := (*الرمز).الملف + 1;
    إذا (!(*م).ع.الملفات[(*الرمز).الملف].عائلي) { اجعله_في_مقروءة_جسر(&متغير الناتج); };
    أرجع الناتج;
}

// Records التشخيص (while a constant is only tried, none is reported).
عام عرف شخص_ت_م_جسر(م: &متغير محلل_جسر, التشخيص: تشخيص_جسر): فراغ {
    إذا ((*م).صامت) { (*م).فشل_التقييم := صواب; أرجع; };
    أضف_تشخيص_جسر(&متغير (*م).ع.التشخيصات, التشخيص);
}

عام عرف شخص_م_جسر(م: &متغير محلل_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر): فراغ {
    شخص_ت_م_جسر(م, تشخيص_م_جسر(م, السبب, الرمز));
}

// With the identifier as written (الرمز).
عام عرف شخص_م_رمز_جسر(م: &متغير محلل_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر, الاسم: نص): فراغ {
    دع ت: متغير تشخيص_جسر = تشخيص_م_جسر(م, السبب, الرمز);
    أضف_رمز_سي(&متغير ت.السجل, الاسم);
    شخص_ت_م_جسر(م, ت);
}

// With a literal text (القيمة).
عام عرف شخص_م_قيمة_جسر(م: &متغير محلل_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر, القيمة: نص): فراغ {
    دع ت: متغير تشخيص_جسر = تشخيص_م_جسر(م, السبب, الرمز);
    أضف_قيمة_سي(&متغير ت.السجل, القيمة);
    شخص_ت_م_جسر(م, ت);
}

// With the name الاسم and its earlier declaration at file الملف (index),
// line and column.
عام عرف شخص_م_سابق_جسر(م: &متغير محلل_جسر, السبب: سبب_تشخيص, الرمز: &رمز_جسر, الاسم: نص,
    الملف: طبيعي, السطر: طبيعي, العمود: طبيعي): فراغ {
    دع ت: متغير تشخيص_جسر = تشخيص_م_جسر(م, السبب, الرمز);
    أضف_رمز_سي(&متغير ت.السجل, الاسم);
    إذا (السطر > 0 && الملف < (الطول((*م).ع.الملفات) مثل طبيعي)) {
        دع المسار: نص = انسخ_نص(&(*م).ع.الملفات[الملف].المسار);
        أضف_موقعا_مرتبطا_سي(&متغير ت.السجل, موقع_سي_جديد(المسار, السطر, العمود, 0, «»), دور_نطاق_تشخيص.تصريح_سابق());
    };
    شخص_ت_م_جسر(م, ت);
}

// The token a diagnostic about the current position points at (the last
// one at the end of input).
عام عرف رمز_هنا_جسر(م: &محلل_جسر): رمز_جسر {
    دع ر: رمز_جسر = رمز_م_جسر(م);
    إذا (ر.الصنف == 0 && (*م).الموضع > 0) { أرجع (*م).الرموز[(*م).الموضع - 1]; };
    أرجع ر;
}

عام عرف شخص_هنا_جسر(م: &متغير محلل_جسر, السبب: سبب_تشخيص): فراغ {
    دع ر: رمز_جسر = رمز_هنا_جسر(م);
    شخص_م_جسر(م, السبب, &ر);
}

عام عرف شخص_هنا_رمز_جسر(م: &متغير محلل_جسر, السبب: سبب_تشخيص, الاسم: نص): فراغ {
    دع ر: رمز_جسر = رمز_هنا_جسر(م);
    شخص_م_رمز_جسر(م, السبب, &ر, الاسم);
}

عام عرف توقع_جسر(م: &متغير محلل_جسر, المعرف: طبيعي, النص: نص): منطقي {
    إذا (اقبل_جسر(م, المعرف)) { أرجع صواب; };
    دع ر: رمز_جسر = رمز_م_جسر(م);
    // The token found; none at the end of input.
    دع ر_ه: رمز_جسر = رمز_هنا_جسر(م);
    دع ت: متغير تشخيص_جسر = تشخيص_م_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_رمز(), &ر_ه);
    أضف_متوقع_سي(&متغير ت.السجل, النص);
    إذا (ر.الصنف != 0) { أضف_موجود_سي(&متغير ت.السجل, اسم_م_جسر(م, ر.المعرف)); };
    شخص_ت_م_جسر(م, ت);
    أرجع خطأ;
}

// Skips to the end of the current declaration (after `;` at depth 0, or
// before an unmatched `}`).
عام عرف زامن_جسر(م: &متغير محلل_جسر): فراغ {
    دع العمق: متغير طبيعي = 0;
    طالما (!نهاية_جسر(م)) {
        دع ك: كلمات_محلل_جسر = (*م).ك;
        إذا (عند_جسر(م, ك.ك_lparen) || عند_جسر(م, ك.ك_lbracket) || عند_جسر(م, ك.ك_lbrace)) { العمق := العمق + 1; }
        وإلا إذا (عند_جسر(م, ك.ك_rparen) || عند_جسر(م, ك.ك_rbracket) || عند_جسر(م, ك.ك_rbrace)) {
            إذا (العمق == 0) { أرجع; };
            العمق := العمق - 1;
            إذا (العمق == 0 && عند_جسر(م, ك.ك_rbrace)) {
                تقدم_جسر(م);
                إذا (عند_جسر(م, ك.ك_semi)) { تقدم_جسر(م); };
                أرجع;
            };
        } وإلا إذا (عند_جسر(م, ك.ك_semi) && العمق == 0) {
            تقدم_جسر(م);
            أرجع;
        };
        تقدم_جسر(م);
    }
}

// Skips a balanced group opening at the current token.
عام عرف تخط_متوازن_م_جسر(م: &متغير محلل_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع العمق: متغير طبيعي = 0;
    طالما (!نهاية_جسر(م)) {
        إذا (عند_جسر(م, ك.ك_lparen) || عند_جسر(م, ك.ك_lbracket) || عند_جسر(م, ك.ك_lbrace)) { العمق := العمق + 1; }
        وإلا إذا (عند_جسر(م, ك.ك_rparen) || عند_جسر(م, ك.ك_rbracket) || عند_جسر(م, ك.ك_rbrace)) {
            إذا (العمق <= 1) { تقدم_جسر(م); أرجع; };
            العمق := العمق - 1;
        };
        تقدم_جسر(م);
    }
}

// ---- bindings ----

عام عرف ربط_عادي_جسر(م: &محلل_جسر, المعرف: طبيعي): طبيعي {
    إذا (المعرف >= (الطول((*م).ربط_عادي) مثل طبيعي)) { أرجع 0; };
    أرجع (*م).ربط_عادي[المعرف];
}

عام عرف اربط_عاديا_جسر(م: &متغير محلل_جسر, المعرف: طبيعي, الكيان: طبيعي): فراغ {
    طالما ((الطول((*م).ربط_عادي) مثل طبيعي) <= المعرف) { ألحق((*م).ربط_عادي, 0); }
    (*م).ربط_عادي[المعرف] := الكيان + 1;
}

عام عرف ربط_وسم_جسر(م: &محلل_جسر, المعرف: طبيعي): طبيعي {
    إذا (المعرف >= (الطول((*م).ربط_وسوم) مثل طبيعي)) { أرجع 0; };
    أرجع (*م).ربط_وسوم[المعرف];
}

عرف اربط_وسما_جسر(م: &متغير محلل_جسر, المعرف: طبيعي, الوسم: طبيعي): فراغ {
    طالما ((الطول((*م).ربط_وسوم) مثل طبيعي) <= المعرف) { ألحق((*م).ربط_وسوم, 0); }
    (*م).ربط_وسوم[المعرف] := الوسم;
}

// The typedef bound to المعرف, or none.
عام عرف نوع_مسمى_جسر(م: &محلل_جسر, المعرف: طبيعي): اختياري طبيعي {
    دع ر: طبيعي = ربط_عادي_جسر(م, المعرف);
    إذا (ر == 0) { أرجع اختياري.لا_شيء(); };
    إذا ((*م).الكيانات[ر - 1].الصنف != 1) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*م).الكيانات[ر - 1].النوع);
}

عام عرف هو_نوع_مسمى_جسر(م: &محلل_جسر, المعرف: طبيعي): منطقي {
    دع ر: طبيعي = ربط_عادي_جسر(م, المعرف);
    أرجع ر != 0 && (*م).الكيانات[ر - 1].الصنف == 1;
}

عرف وسم_جديد_م_جسر(م: &متغير محلل_جسر, الصنف: ط8, الاسم: طبيعي, الرمز: &رمز_جسر): طبيعي {
    ألحق((*م).ج.الوسوم, وسم_جديد_جسر(الصنف, الاسم, (*الرمز).الملف, (*الرمز).السطر, (*الرمز).العمود));
    دع الوسم: طبيعي = (الطول((*م).ج.الوسوم) مثل طبيعي) - 1;
    (*م).ج.الوسوم[الوسم].محلي := (*م).في_جسم;
    (*م).ج.الوسوم[الوسم].العمق := عمق_النطاق_جسر(م);
    دع النوع: طبيعي = نوع_وسم_جسر(&متغير (*م).ج, الوسم);
    ألحق((*م).نوع_الوسم, النوع);
    إذا (الاسم != 0) {
        إذا ((*م).في_جسم) {
            ألحق((*م).ظلال_الوسوم, الاسم);
            ألحق((*م).ظلال_الوسوم, ربط_وسم_جسر(م, الاسم));
        };
        اربط_وسما_جسر(م, الاسم, الوسم);
    };
    أرجع الوسم;
}

// ---- #pragma pack ----

عرف طبق_حزمة_جسر(م: &متغير محلل_جسر, الرمز: &رمز_جسر): فراغ {
    دع العملية: طبيعي = (*الرمز).المخفية;
    دع القيمة: طبيعي = (*الرمز).المعرف;
    إذا (العملية == 1) {
        ألحق((*م).الحزم, (*م).الحزمة);
        إذا (القيمة != 0xFFFF) { (*م).الحزمة := القيمة; };
    } وإلا إذا (العملية == 2) {
        دع ن: طبيعي = الطول((*م).الحزم) مثل طبيعي;
        إذا (ن > 0) {
            (*م).الحزمة := (*م).الحزم[ن - 1];
            دع المحذوف: اختياري طبيعي = أزل_الأخير((*م).الحزم);
        } وإلا { (*م).الحزمة := 0; };
    } وإلا {
        (*م).الحزمة := القيمة;
    };
}

عام عرف استهلك_حزما_جسر(م: &متغير محلل_جسر): فراغ {
    طالما (رمز_م_جسر(م).الصنف == 8) {
        دع الرمز: رمز_جسر = رمز_م_جسر(م);
        طبق_حزمة_جسر(م, &الرمز);
        تقدم_جسر(م);
    }
}

// ---- attributes ----

عام نوع سمات_جسر = {
    المحاذاة: طبيعي,
    معبأ: منطقي,
    // Bits of __attribute__((mode)); 1000 for a mode with no C type here.
    الوضع: طبيعي,
    غير_متاح: منطقي,
    حجم_المتجه: طبيعي,
    التسمية: طبيعي
};

عام عرف سمات_فارغة_جسر(): سمات_جسر {
    دع الناتج: سمات_جسر = { المحاذاة: 0, معبأ: خطأ, الوضع: 0, غير_متاح: خطأ, حجم_المتجه: 0, التسمية: 0 };
    أرجع الناتج;
}

عام عرف ادمج_سمات_جسر(أ: &متغير سمات_جسر, ب: &سمات_جسر): فراغ {
    إذا ((*ب).المحاذاة > (*أ).المحاذاة) { (*أ).المحاذاة := (*ب).المحاذاة; };
    إذا ((*ب).معبأ) { (*أ).معبأ := صواب; };
    إذا ((*ب).الوضع != 0) { (*أ).الوضع := (*ب).الوضع; };
    إذا ((*ب).غير_متاح) { (*أ).غير_متاح := صواب; };
    إذا ((*ب).حجم_المتجه != 0) { (*أ).حجم_المتجه := (*ب).حجم_المتجه; };
    إذا ((*ب).التسمية != 0) { (*أ).التسمية := (*ب).التسمية; };
}

عام عرف بداية_سمة_جسر(م: &محلل_جسر): منطقي {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع ر: رمز_جسر = رمز_م_جسر(م);
    إذا (ر.الصنف != 1 && !(ر.الصنف == 5 && ر.المعرف == ك.ك_lbracket)) { أرجع خطأ; };
    دع ي: طبيعي = ر.المعرف;
    إذا (ي == ك.ك___attribute__ || ي == ك.ك___attribute || ي == ك.ك___declspec || ي == ك.ك___asm__
        || ي == ك.ك___asm || ي == ك.ك_asm) { أرجع صواب; };
    أرجع ي == ك.ك_lbracket && عند_بعد_جسر(م, 1, ك.ك_lbracket);
}

// Parses attribute sequences (GNU, C23 [[...]], __declspec, asm labels)
// at the current position.
عام عرف حلل_سمات_جسر(م: &متغير محلل_جسر, السمات: &متغير سمات_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    طالما (بداية_سمة_جسر(م)) {
        دع ي: طبيعي = رمز_م_جسر(م).المعرف;
        إذا (ي == ك.ك_lbracket) {
            // [[ ... ]]: C23 attributes, none of which changes layout.
            تخط_متوازن_م_جسر(م);
            تابع_حلقة;
        };
        إذا (ي == ك.ك___asm__ || ي == ك.ك___asm || ي == ك.ك_asm) {
            تقدم_جسر(م);
            إذا (!عند_جسر(م, ك.ك_lparen)) { أرجع; };
            تقدم_جسر(م);
            دع البايتات: متغير متجه ط8 = [];
            طالما (رمز_م_جسر(م).الصنف == 3) {
                دع النص: نص = اسم_م_جسر(م, رمز_م_جسر(م).المعرف);
                دع المفكوك: حرفي_مفكوك_جسر = فك_حرفي_جسر(&النص);
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(المفكوك.الوحدات) مثل طبيعي)) { ألحق(البايتات, (المفكوك.الوحدات[ف] & 0xFF) مثل ط8); ف := ف + 1; }
                تقدم_جسر(م);
            }
            دع ن: طبيعي = الطول(البايتات) مثل طبيعي;
