عام عرف صحيح_بعرض_جسر(م: &محلل_جسر, العرض: طبيعي, موقع: منطقي): طبيعي {
    إذا (العرض == 8) { إذا (موقع) { أرجع ن_حرف_موقع_جسر(); }; أرجع ن_حرف_طبيعي_جسر(); };
