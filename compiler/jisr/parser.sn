    دع ف: متغير طبيعي = 0;
    دع ن_ح: طبيعي = الطول(الحقول) مثل طبيعي;
    طالما (ف < ن_ح) {
        دع ن: نوع_سي_جسر = (*م).ج.الأنواع[الحقول[ف].النوع];
        إذا (ن.الصنف == 6 && ن.مجهول_العدد) {
            إذا (ف + 1 == ن_ح && !اتحاد) { (*م).ج.الوسوم[الوسم].له_مرن := صواب; }
            وإلا {
                شخص_م_جسر(م, سبب_تشخيص.سبب_سي_مصفوفة_مرنة_ليست_أخيرة(), &موقع_الاسم);
            };
        } وإلا إذا (!حجم_نوع_جسر(&(*م).ج, &(*م).النموذج, الحقول[ف].النوع, صواب).صالح && ن.الصنف != 0) {
            شخص_م_رمز_جسر(م, سبب_تشخيص.سبب_سي_عضو_نوع_ناقص(), &موقع_الاسم, اسم_م_جسر(م, الاسم));
        };
        ف := ف + 1;
    }
    (*م).ج.الوسوم[الوسم].بداية_الحقول := الطول((*م).ج.الحقول) مثل طبيعي;
    (*م).ج.الوسوم[الوسم].عدد_الحقول := ن_ح;
    (*م).ج.الوسوم[الوسم].معبأ := السمات.معبأ;
    (*م).ج.الوسوم[الوسم].محاذاة_صريحة := السمات.المحاذاة;
    ف := 0;
    طالما (ف < ن_ح) { ألحق((*م).ج.الحقول, الحقول[ف]); ف := ف + 1; }
    خطط_وسما_جسر(&متغير (*م).ج, &(*م).النموذج, الوسم, (*م).الحزمة);
    (*م).ج.الوسوم[الوسم].تسلسل_الاكتمال := الطول((*م).الكيانات) مثل طبيعي;
    أرجع (*م).نوع_الوسم[الوسم];
}

عرف حقل_جسر(الاسم: طبيعي, النوع: طبيعي, بتي: منطقي, العرض: طبيعي, السمات: &سمات_جسر): حقل_سي_جسر {
    دع الناتج: حقل_سي_جسر = {
        الاسم: الاسم, النوع: النوع, بتي: بتي, عرض_البت: العرض, الإزاحة: 0, إزاحة_البت: 0,
        محاذاة_صريحة: (*السمات).المحاذاة, معبأ: (*السمات).معبأ
    };
    أرجع الناتج;
}

عرف حلل_تعداد_جسر(م: &متغير محلل_جسر): طبيعي {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع الكلمة: رمز_جسر = رمز_م_جسر(م);
    تقدم_جسر(م);
    دع السمات: متغير سمات_جسر = سمات_فارغة_جسر();
    حلل_سمات_جسر(م, &متغير السمات);
    دع الاسم: متغير طبيعي = 0;
    دع موقع_الاسم: متغير رمز_جسر = الكلمة;
    إذا (رمز_م_جسر(م).الصنف == 1) {
        الاسم := رمز_م_جسر(م).المعرف;
        موقع_الاسم := رمز_م_جسر(م);
        تقدم_جسر(م);
    };
    حلل_سمات_جسر(م, &متغير السمات);
    دع الثابت: متغير طبيعي = 0;
    إذا (اقبل_جسر(م, ك.ك_colon)) { الثابت := حلل_اسم_نوع_جسر(م); };
    إذا (!عند_جسر(م, ك.ك_lbrace)) {
        إذا (الاسم == 0) {
            شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_اسم_تعداد());
            أرجع ن_صحيح_جسر();
        };
        دع الموجود: طبيعي = ربط_وسم_جسر(م, الاسم);
        إذا (الموجود != 0 && (*م).ج.الوسوم[الموجود].الصنف == 10) { أرجع (*م).نوع_الوسم[الموجود]; };
        دع الوسم: طبيعي = وسم_جديد_م_جسر(م, 10, الاسم, &موقع_الاسم);
        إذا (الثابت != 0) {
            (*م).ج.الوسوم[الوسم].الأساس := الثابت;
            (*م).ج.الوسوم[الوسم].مكتمل := صواب;
        };
        أرجع (*م).نوع_الوسم[الوسم];
    };
    دع الوسم: متغير طبيعي = 0;
    دع الموجود: طبيعي = ربط_وسم_جسر(م, الاسم);
    دع في_النطاق_ت: منطقي = الموجود != 0 && (*م).ج.الوسوم[الموجود].العمق == عمق_النطاق_جسر(م);
    إذا (الاسم != 0 && في_النطاق_ت && (*م).ج.الوسوم[الموجود].الصنف == 10 && !(*م).ج.الوسوم[الموجود].مكتمل) {
        الوسم := الموجود;
    } وإلا {
        إذا (الاسم != 0 && في_النطاق_ت) {
            شخص_م_سابق_جسر(م, سبب_تشخيص.سبب_سي_إعادة_تعريف(), &موقع_الاسم, اسم_م_جسر(م, الاسم),
                (*م).ج.الوسوم[الموجود].الملف, (*م).ج.الوسوم[الموجود].السطر, (*م).ج.الوسوم[الموجود].العمود);
        };
        الوسم := وسم_جديد_م_جسر(م, 10, الاسم, &موقع_الاسم);
    };
    تقدم_جسر(م);
    دع التالي: متغير ط64 = 0;
    دع الأدنى: متغير ط64 = 0;
    دع الأعلى: متغير ط64 = 0;
    دع له_سالب: متغير منطقي = خطأ;
    دع الأول: متغير منطقي = صواب;
    طالما (!نهاية_جسر(م) && !عند_جسر(م, ك.ك_rbrace)) {
        دع ر: رمز_جسر = رمز_م_جسر(م);
        إذا (ر.الصنف != 1) {
            شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_اسم_عنصر_تعداد());
            زامن_جسر(م);
            أرجع (*م).نوع_الوسم[الوسم];
        };
        تقدم_جسر(م);
        دع سمات_ع: متغير سمات_جسر = سمات_فارغة_جسر();
        حلل_سمات_جسر(م, &متغير سمات_ع);
        إذا (اقبل_جسر(م, ك.ك_assign)) {
            دع ق: قيمة_جسر = قيم_ثابتا_جسر(م);
            إذا (ق.ثابت) {
                التالي := ق.البتات;
            } وإلا {
                شخص_م_رمز_جسر(م, سبب_تشخيص.سبب_سي_قيمة_عنصر_تعداد_غير_ثابتة(), &ر, اسم_م_جسر(م, ر.المعرف));
            };
        };
        دع سالب: منطقي = (التالي & 0x8000000000000000) != 0;
        إذا (سالب) { له_سالب := صواب; };
        إذا (الأول) { الأدنى := التالي; الأعلى := التالي; الأول := خطأ; }
        وإلا {
            إذا (أصغر_موقع_جسر(التالي, الأدنى)) { الأدنى := التالي; };
            إذا (أصغر_موقع_جسر(الأعلى, التالي)) { الأعلى := التالي; };
        };
        دع الكيان: كيان_سي_جسر = {
            الصنف: 4, الاسم: ر.المعرف, النوع: ن_صحيح_جسر(), القيمة: التالي, الملف: ر.الملف, السطر: ر.السطر,
            العمود: ر.العمود, التسمية: 0, ساكن: خطأ, مضمن: خطأ, معرف: صواب, غير_متاح: خطأ, خيطي: خطأ,
            محلي: (*م).في_جسم
        };
        إذا ((*م).في_جسم) { سجل_محليا_جسر(م, الكيان); } وإلا { سجل_كيانا_جسر(م, الكيان, &ر); };
        التالي := جمع_ط64_ملتف(التالي, 1);
        إذا (!اقبل_جسر(م, ك.ك_comma)) { اخرج_من_حلقة; };
    }
    دع ت: منطقي = توقع_جسر(م, ك.ك_rbrace, «}»);
    حلل_سمات_جسر(م, &متغير السمات);
    // The compatible type: a fixed one, int for MSVC, else GCC's choice.
    دع الأساس: متغير طبيعي = ن_صحيح_طبيعي_جسر();
    دع ع_ص: طبيعي = (*م).النموذج.عرض_الصحيح;
    إذا (الثابت != 0) { الأساس := الثابت; }
    وإلا إذا ((*م).النموذج.إم_إس_في_سي) { الأساس := ن_صحيح_جسر(); }
    وإلا إذا (السمات.معبأ) {
        إذا (له_سالب) {
            إذا (يناسب_موقعا_جسر(الأدنى, 8) && يناسب_موقعا_جسر(الأعلى, 8)) { الأساس := ن_حرف_موقع_جسر(); }
            وإلا إذا (يناسب_موقعا_جسر(الأدنى, 16) && يناسب_موقعا_جسر(الأعلى, 16)) { الأساس := ن_قصير_جسر(); }
            وإلا { الأساس := ن_صحيح_جسر(); };
        } وإلا {
            إذا (الأعلى <= 0xFF) { الأساس := ن_حرف_طبيعي_جسر(); }
            وإلا إذا (الأعلى <= 0xFFFF) { الأساس := ن_قصير_طبيعي_جسر(); }
            وإلا { الأساس := ن_صحيح_طبيعي_جسر(); };
        };
    } وإلا إذا (له_سالب) {
        إذا (يناسب_موقعا_جسر(الأدنى, ع_ص) && يناسب_موقعا_جسر(الأعلى, ع_ص)) { الأساس := ن_صحيح_جسر(); }
        وإلا { الأساس := ن_طويل2_جسر(); };
    } وإلا {
        إذا (الأعلى <= 0xFFFFFFFF) { الأساس := ن_صحيح_طبيعي_جسر(); }
        وإلا { الأساس := ن_طويل2_طبيعي_جسر(); };
    };
    (*م).ج.الوسوم[الوسم].الأساس := الأساس;
    (*م).ج.الوسوم[الوسم].مكتمل := صواب;
    أرجع (*م).نوع_الوسم[الوسم];
}

عرف أصغر_موقع_جسر(أ: ط64, ب: ط64): منطقي {
    أرجع (أ ^ 0x8000000000000000) < (ب ^ 0x8000000000000000);
}

// Whether a signed 64-bit value fits a signed integer of العرض bits.
عرف يناسب_موقعا_جسر(ق: ط64, العرض: طبيعي): منطقي {
    إذا (العرض >= 64) { أرجع صواب; };
    دع الحد: ط64 = 1 << ((العرض - 1) مثل ط64);
    // -الحد <= ق < الحد, in two's complement.
    أرجع جمع_ط64_ملتف(ق, الحد) < 2 * الحد;
}

