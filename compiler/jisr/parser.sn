// The C parser and semantic analysis of Jisr: external declarations of a
// preprocessed translation unit (C17 6.7, 6.9) with the GNU, Clang and
// Microsoft extensions system headers use (__attribute__, __extension__,
// asm labels, __declspec, typeof, _Nullable, calling-convention keywords),
// and C's integer constant expressions with their types (6.6): enumerators,
// array bounds, bit-field widths, _Static_assert, alignments, and the
// object-like macros the import writes as constants. sizeof, _Alignof and
// offsetof use the target's layout (types.sn).
//
// Declarators are parsed as Clang and chibicc do: pointers, then a name or
// a parenthesized declarator, then suffixes, with a parenthesized
// declarator parsed after the suffixes of the type it wraps. Function
// bodies and initializers are skipped (Jisr imports declarations; it does
// not compile C code).
استورد std.text.transform;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.foreign_c;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.math.wrapping;
استورد compiler.jisr.core;
استورد compiler.jisr.target;
استورد compiler.jisr.literals;
استورد compiler.jisr.types;
استورد compiler.jisr.preprocessor;

// الصنف: 1 typedef, 2 function, 3 object, 4 enumerator.
عام نوع كيان_سي_جسر = {
    الصنف: ط8,
    الاسم: طبيعي,
    النوع: طبيعي,
    القيمة: ط64,
    الملف: طبيعي,
    السطر: طبيعي,
    العمود: طبيعي,
    // The asm label (link name) spelling id, 0 for none.
    التسمية: طبيعي,
    ساكن: منطقي,
    مضمن: منطقي,
    معرف: منطقي,
    غير_متاح: منطقي,
    // _Thread_local / __thread.
    خيطي: منطقي,
    // Declared inside a function body (never written).
    محلي: منطقي
};

