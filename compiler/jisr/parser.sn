// Records a declaration, checking it against an earlier one of the name.
عام عرف سجل_كيانا_جسر(م: &متغير محلل_جسر, الكيان: كيان_سي_جسر, الموقع: &رمز_جسر): فراغ {
    دع ر: طبيعي = ربط_عادي_جسر(م, الكيان.الاسم);
    إذا (ر != 0) {
        دع السابق: كيان_سي_جسر = (*م).الكيانات[ر - 1];
        دع الاسم: نص = اسم_م_جسر(م, الكيان.الاسم);
        إذا (السابق.الصنف != الكيان.الصنف) {
            شخص_م_سابق_جسر(م, سبب_تشخيص.سبب_سي_إعادة_تعريف_بصنف_آخر(), الموقع, الاسم, السابق.الملف, السابق.السطر, السابق.العمود);
            أرجع;
        };
        إذا (الكيان.الصنف == 4) {
            شخص_م_سابق_جسر(م, سبب_تشخيص.سبب_سي_إعادة_تعريف_عنصر_تعداد(), الموقع, الاسم, السابق.الملف, السابق.السطر, السابق.العمود);
            أرجع;
        };
        إذا (!نوعان_متوافقان_جسر(&(*م).ج, السابق.النوع, الكيان.النوع)) {
            إذا (الكيان.الصنف == 1) {
                شخص_م_سابق_جسر(م, سبب_تشخيص.سبب_سي_نوع_مستعار_متعارض(), الموقع, انسخ_نص(&الاسم), السابق.الملف, السابق.السطر, السابق.العمود);
            } وإلا {
                شخص_م_سابق_جسر(م, سبب_تشخيص.سبب_سي_أنواع_متعارضة(), الموقع, انسخ_نص(&الاسم), السابق.الملف, السابق.السطر, السابق.العمود);
            };
            أرجع;
        };
        // A compatible redeclaration: a later prototype, label or body.
        دع الفهرس: طبيعي = ر - 1;
        إذا ((*م).ج.الأنواع[السابق.النوع].بلا_نموذج && !(*م).ج.الأنواع[الكيان.النوع].بلا_نموذج) {
            (*م).الكيانات[الفهرس].النوع := الكيان.النوع;
        };
        إذا (الكيان.التسمية != 0) { (*م).الكيانات[الفهرس].التسمية := الكيان.التسمية; };
        إذا (الكيان.معرف) { (*م).الكيانات[الفهرس].معرف := صواب; };
        إذا (الكيان.غير_متاح) { (*م).الكيانات[الفهرس].غير_متاح := صواب; };
        أرجع;
    };
    ألحق((*م).الكيانات, الكيان);
    اربط_عاديا_جسر(م, الكيان.الاسم, (الطول((*م).الكيانات) مثل طبيعي) - 1);
}

// ---- declarations ----

عام عرف حلل_تأكيدا_جسر(م: &متغير محلل_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع الموقع: رمز_جسر = رمز_م_جسر(م);
    تقدم_جسر(م);
    إذا (!توقع_جسر(م, ك.ك_lparen, «(»)) { زامن_جسر(م); أرجع; };
    دع ق: قيمة_جسر = قيم_ثابتا_جسر(م);
    دع الرسالة: متغير نص = «»;
    إذا (اقبل_جسر(م, ك.ك_comma)) {
        طالما (رمز_م_جسر(م).الصنف == 3) {
            دع النص: نص = اسم_م_جسر(م, رمز_م_جسر(م).المعرف);
            الرسالة := صل_نصين(&الرسالة, &النص);
            تقدم_جسر(م);
        }
    };
    إذا (!توقع_جسر(م, ك.ك_rparen, «)»)) { زامن_جسر(م); أرجع; };
    دع ت: منطقي = اقبل_جسر(م, ك.ك_semi);
    إذا (!ق.ثابت) {
        شخص_م_جسر(م, سبب_تشخيص.سبب_سي_تأكيد_ساكن_غير_ثابت(), &الموقع);
        أرجع;
    };
    إذا (ق.البتات == 0) {
        شخص_م_قيمة_جسر(م, سبب_تشخيص.سبب_سي_تأكيد_ساكن_خاطئ(), &الموقع, الرسالة);
    };
}

// One external declaration (or function definition).
عرف حلل_تصريحا_خارجيا_جسر(م: &متغير محلل_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    استهلك_حزما_جسر(م);
    إذا (نهاية_جسر(م)) { أرجع; };
    إذا (اقبل_جسر(م, ك.ك_semi)) { أرجع; };
    إذا (عند_جسر(م, ك.ك__Static_assert) || عند_جسر(م, ك.ك_static_assert)) { حلل_تأكيدا_جسر(م); أرجع; };
    // C++ (`namespace x {`, `template <`, `class X {`): reported once,
    // and the rest of the file is not read as C.
    دع ر_أ: رمز_جسر = رمز_م_جسر(م);
    إذا (ر_أ.الصنف == 1) {
        دع الكلمة: نص = اسم_م_جسر(م, ر_أ.المعرف);
        دع التالي: رمز_جسر = رمز_بعد_جسر(م, 1);
        دع نيمسبيس: منطقي = نصان_متساويان_م_جسر(&الكلمة, «namespace») && (التالي.الصنف == 1 || عند_بعد_جسر(م, 1, ك.ك_lbrace));
        دع قالب: منطقي = نصان_متساويان_م_جسر(&الكلمة, «template») && عند_بعد_جسر(م, 1, ك.ك_lt);
        دع صنف: منطقي = نصان_متساويان_م_جسر(&الكلمة, «class») && التالي.الصنف == 1
            && (عند_بعد_جسر(م, 2, ك.ك_lbrace) || عند_بعد_جسر(م, 2, ك.ك_colon));
        إذا (نيمسبيس || قالب || صنف) {
            شخص_م_رمز_جسر(م, سبب_تشخيص.سبب_سي_شفرة_سي_بلس(), &ر_أ, الكلمة);
            (*م).الموضع := الطول((*م).الرموز) مثل طبيعي;
            أرجع;
        };
    };
    إذا ((عند_جسر(م, ك.ك___asm__) || عند_جسر(م, ك.ك___asm) || عند_جسر(م, ك.ك_asm)) && عند_بعد_جسر(م, 1, ك.ك_lparen)) {
        // A top-level asm block.
        تقدم_جسر(م);
        تخط_متوازن_م_جسر(م);
        دع ت: منطقي = اقبل_جسر(م, ك.ك_semi);
        أرجع;
    };
    دع البداية: رمز_جسر = رمز_م_جسر(م);
    دع المواصفات: مواصفات_جسر = حلل_مواصفات_جسر(م);
    إذا (!المواصفات.وجد_نوع) {
        دع ر: رمز_جسر = رمز_م_جسر(م);
        إذا (ر.الصنف == 1 && (رمز_بعد_جسر(م, 1).الصنف == 1 || عند_بعد_جسر(م, 1, ك.ك_star))) {
            دع الاسم: نص = اسم_م_جسر(م, ر.المعرف);
            شخص_م_رمز_جسر(م, سبب_تشخيص.سبب_سي_اسم_نوع_مجهول(), &ر, الاسم);
        } وإلا إذا (ر.الصنف == 1 && عند_بعد_جسر(م, 1, ك.ك_lparen)) {
            شخص_م_جسر(م, سبب_تشخيص.سبب_سي_نوع_مفقود(), &ر);
        } وإلا {
            دع ت_ت: متغير تشخيص_جسر = تشخيص_م_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_تصريح(), &ر);
            // The token found; none at the end of input.
            إذا (ر.الصنف != 0) { أضف_موجود_سي(&متغير ت_ت.السجل, اسم_م_جسر(م, ر.المعرف)); };
            شخص_ت_م_جسر(م, ت_ت);
            إذا (عند_جسر(م, ك.ك_rbrace)) { تقدم_جسر(م); أرجع; };
        };
        زامن_جسر(م);
        أرجع;
    };
    إذا (اقبل_جسر(م, ك.ك_semi)) { أرجع; };
    طالما (!نهاية_جسر(م)) {
        دع المصرح: مصرح_جسر = حلل_مصرحا_جسر(م, المواصفات.النوع);
        دع السمات: متغير سمات_جسر = سمات_فارغة_جسر();
        ادمج_سمات_جسر(&متغير السمات, &المواصفات.السمات);
        ادمج_سمات_جسر(&متغير السمات, &المصرح.السمات);
        حلل_سمات_جسر(م, &متغير السمات);
        إذا (المصرح.الاسم == 0) {
            شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_معرف_تصريح());
            زامن_جسر(م);
            أرجع;
        };
        دع الموقع: رمز_جسر = رمز_جسر_من(1, المصرح.الاسم, المصرح.الملف, المصرح.السطر, المصرح.العمود, 0);
        دع النوع: متغير طبيعي = المصرح.النوع;
        إذا (السمات.المحاذاة > 0 && المواصفات.تعريف_نوع) { النوع := بمحاذاة_جسر(&متغير (*م).ج, النوع, السمات.المحاذاة); };
        دع هي_دالة: منطقي = (*م).ج.الأنواع[النوع].الصنف == 7;
        دع الصنف: متغير ط8 = 3;
        إذا (المواصفات.تعريف_نوع) { الصنف := 1; } وإلا إذا (هي_دالة) { الصنف := 2; };
        دع جسم: منطقي = هي_دالة && !المواصفات.تعريف_نوع && (عند_جسر(م, ك.ك_lbrace) || بداية_نوع_جسر(م));
        دع الكيان: كيان_سي_جسر = {
            الصنف: الصنف, الاسم: المصرح.الاسم, النوع: النوع, القيمة: 0, الملف: المصرح.الملف, السطر: المصرح.السطر,
            العمود: المصرح.العمود, التسمية: السمات.التسمية, ساكن: المواصفات.ساكن, مضمن: المواصفات.مضمن,
            معرف: جسم, غير_متاح: السمات.غير_متاح, خيطي: المواصفات.خيطي, محلي: خطأ
        };
        سجل_كيانا_جسر(م, الكيان, &الموقع);
        دع الفهرس_ك: طبيعي = ربط_عادي_جسر(م, المصرح.الاسم);
        إذا (جسم) {
            // An old-style definition declares its parameters before '{'.
            طالما (!نهاية_جسر(م) && !عند_جسر(م, ك.ك_lbrace)) { تقدم_جسر(م); }
            دع بداية_الجسم: طبيعي = (*م).الموضع;
            حلل_جسم_دالة_جسر(م);
            إذا ((*م).ترجمة_الأجسام && الفهرس_ك != 0) {
                دع التعريف: تعريف_جسر = {
                    الصنف: 1, الكيان: الفهرس_ك - 1, البداية: بداية_الجسم, النهاية: (*م).الموضع,
                    موضع_الاسم: المصرح.موضع_الاسم
                };
                ألحق((*م).التعريفات, التعريف);
            };
            أرجع;
        };
        إذا (اقبل_جسر(م, ك.ك_assign)) {
            // C23: a file-scope constexpr object has internal linkage; an
            // integer one is a named constant, usable in constant
            // expressions like an enumerator.
            إذا (المواصفات.ثابت_ت && الفهرس_ك != 0 && الصنف == 3) {
                (*م).الكيانات[الفهرس_ك - 1].ساكن := صواب;
                إذا (صحيح_أو_تعداد_جسر(&(*م).ج, النوع)) {
                    دع محفوظ: طبيعي = (*م).الموضع;
                    دع ق: قيمة_جسر = حمل_قيمة_جسر(م, قيم_ثابتا_جسر(م));
                    إذا (ق.ثابت && !ق.عنوان && (عند_جسر(م, ك.ك_comma) || عند_جسر(م, ك.ك_semi))) {
                        دع المحول: قيمة_جسر = حول_جسر(م, ق, النوع);
                        (*م).الكيانات[الفهرس_ك - 1].الصنف := 4;
                        (*م).الكيانات[الفهرس_ك - 1].القيمة := المحول.البتات;
                        (*م).الكيانات[الفهرس_ك - 1].ساكن := خطأ;
                        إذا (اقبل_جسر(م, ك.ك_comma)) { تابع_حلقة; };
                        إذا (!توقع_جسر(م, ك.ك_semi, «;»)) { زامن_جسر(م); };
                        أرجع;
                    };
                    (*م).الموضع := محفوظ;
                };
            };
            // An initializer: to the next ',' or ';' at depth 0.
            دع بداية_المهيئ: طبيعي = (*م).الموضع;
            طالما (!نهاية_جسر(م) && !عند_جسر(م, ك.ك_comma) && !عند_جسر(م, ك.ك_semi)) {
                إذا (عند_جسر(م, ك.ك_lparen) || عند_جسر(م, ك.ك_lbrace) || عند_جسر(م, ك.ك_lbracket)) { تخط_متوازن_م_جسر(م); }
                وإلا { تقدم_جسر(م); };
            }
            إذا ((*م).ترجمة_الأجسام && الفهرس_ك != 0 && الصنف == 3) {
                دع التعريف: تعريف_جسر = {
                    الصنف: 2, الكيان: الفهرس_ك - 1, البداية: بداية_المهيئ, النهاية: (*م).الموضع,
                    موضع_الاسم: المصرح.موضع_الاسم
                };
                ألحق((*م).التعريفات, التعريف);
            };
        } وإلا إذا ((*م).ترجمة_الأجسام && الفهرس_ك != 0 && الصنف == 3 && !المواصفات.خارجي_ص) {
            // A definition without an initializer (or a tentative one).
            دع التعريف: تعريف_جسر = {
                الصنف: 3, الكيان: الفهرس_ك - 1, البداية: 0, النهاية: 0, موضع_الاسم: المصرح.موضع_الاسم
            };
            ألحق((*م).التعريفات, التعريف);
        };
        إذا (اقبل_جسر(م, ك.ك_comma)) { تابع_حلقة; };
        إذا (!توقع_جسر(م, ك.ك_semi, «;»)) { زامن_جسر(م); };
        أرجع;
    }
}

// Parses the whole translation unit.
عام عرف حلل_الوحدة_جسر(م: &متغير محلل_جسر): فراغ {
    طالما (!نهاية_جسر(م)) {
        دع قبل: طبيعي = (*م).الموضع;
        حلل_تصريحا_خارجيا_جسر(م);
        إذا ((*م).الموضع == قبل) { تقدم_جسر(م); };
    }
}

// ---- constant expressions ----

// The value of an expression: an integer constant (ثابت) of type النوع, or
// an address constant (عنوان: the designated object's address in البتات,
// with النوع the object's type), or only a type.
عام نوع قيمة_جسر = {
    البتات: ط64,
    النوع: طبيعي,
    ثابت: منطقي,
    عنوان: منطقي
};

عرف قيمة_من_جسر(البتات: ط64, النوع: طبيعي, ثابت: منطقي): قيمة_جسر {
    دع الناتج: قيمة_جسر = { البتات: البتات, النوع: النوع, ثابت: ثابت, عنوان: خطأ };
    أرجع الناتج;
}

عرف غير_ثابت_جسر(النوع: طبيعي): قيمة_جسر { أرجع قيمة_من_جسر(0, النوع, خطأ); }

// A constant expression (conditional-expression); reports nothing itself.
عام عرف قيم_ثابتا_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    دع ق: قيمة_جسر = شرطي_ت_جسر(م);
    أرجع حمل_قيمة_جسر(م, ق);
}

// A full expression (with the comma operator).
عام عرف قيم_تعبيرا_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    دع ق: متغير قيمة_جسر = شرطي_ت_جسر(م);
    طالما (اقبل_جسر(م, (*م).ك.ك_comma)) {
        دع ب: قيمة_جسر = شرطي_ت_جسر(م);
        ق := غير_ثابت_جسر(حمل_قيمة_جسر(م, ب).النوع);
    }
    أرجع حمل_قيمة_جسر(م, ق);
}

// Normalizes بتات to the width and signedness of النوع.
عام عرف طبع_جسر(م: &محلل_جسر, البتات: ط64, النوع: طبيعي): ط64 {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[بلا_تعداد_جسر(&(*م).ج, النوع)];
    دع العرض: متغير طبيعي = ن.العرض;
    إذا (ن.البتات_الدقيقة != 0) { العرض := ن.البتات_الدقيقة; };
    إذا (ن.الصنف == 5) { العرض := (*م).النموذج.عرض_المؤشر; };
    إذا (ن.الصنف == 2) { إذا (البتات != 0) { أرجع 1; }; أرجع 0; };
    إذا (العرض == 0 || العرض >= 64) { أرجع البتات; };
    دع القناع: ط64 = (1 << (العرض مثل ط64)) - 1;
    دع ق: ط64 = البتات & القناع;
    إذا (ن.موقع && (ق & (1 << ((العرض - 1) مثل ط64))) != 0) { أرجع ق | ~القناع; };
    أرجع ق;
}

// Array-to-pointer and function-to-pointer conversion, and reading an
// lvalue (whose value is then unknown).
عام عرف حمل_قيمة_جسر(م: &متغير محلل_جسر, ق: قيمة_جسر): قيمة_جسر {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[ق.النوع];
    إذا (ق.عنوان) {
        إذا (ن.الصنف == 6) { أرجع قيمة_من_جسر(ق.البتات, مؤشر_إلى_جسر(&متغير (*م).ج, ن.الأساس), ق.ثابت); };
        إذا (ن.الصنف == 7) { أرجع قيمة_من_جسر(ق.البتات, مؤشر_إلى_جسر(&متغير (*م).ج, ق.النوع), ق.ثابت); };
        أرجع غير_ثابت_جسر(ق.النوع);
    };
    أرجع ق;
}

// Integer promotion (C17 6.3.1.1).
عام عرف رق_جسر(م: &محلل_جسر, النوع: طبيعي): طبيعي {
    دع أساس: طبيعي = بلا_تعداد_جسر(&(*م).ج, النوع);
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[أساس];
    إذا ((ن.الصنف == 2 || ن.الصنف == 3) && ن.الرتبة < 4) {
        إذا (ن.العرض < (*م).النموذج.عرض_الصحيح || ن.موقع) { أرجع ن_صحيح_جسر(); };
        أرجع ن_صحيح_طبيعي_جسر();
    };
    إذا (ن.الصنف == 3) { أرجع أساس; };
    أرجع أساس;
}

// The usual arithmetic conversions of two integer types (C17 6.3.1.8).
عام عرف مشترك_جسر(م: &محلل_جسر, أ: طبيعي, ب: طبيعي): طبيعي {
    دع س: طبيعي = رق_جسر(م, أ);
    دع ص: طبيعي = رق_جسر(م, ب);
    دع ن_س: نوع_سي_جسر = (*م).ج.الأنواع[س];
    دع ن_ص: نوع_سي_جسر = (*م).ج.الأنواع[ص];
    إذا (س == ص) { أرجع س; };
    إذا (ن_س.موقع == ن_ص.موقع) {
        إذا (مفتاح_رتبة_جسر(م, س) >= مفتاح_رتبة_جسر(م, ص)) { أرجع س; };
        أرجع ص;
    };
    دع الطبيعي: طبيعي = اختر_جسر(ن_س.موقع, ص, س);
    دع الموقع: طبيعي = اختر_جسر(ن_س.موقع, س, ص);
    دع ن_ط: نوع_سي_جسر = (*م).ج.الأنواع[الطبيعي];
    دع ن_م: نوع_سي_جسر = (*م).ج.الأنواع[الموقع];
    إذا (مفتاح_رتبة_جسر(م, الطبيعي) >= مفتاح_رتبة_جسر(م, الموقع)) { أرجع الطبيعي; };
    إذا (عرض_دقيق_جسر(&(*م).ج, الموقع) > عرض_دقيق_جسر(&(*م).ج, الطبيعي)) { أرجع الموقع; };
    إذا (ن_م.البتات_الدقيقة != 0) { أرجع بتي_م_جسر(م, ن_م.البتات_الدقيقة); };
    // The unsigned type of the signed operand's rank.
    إذا (ن_م.الرتبة == 5) { أرجع ن_طويل_طبيعي_جسر(); };
    إذا (ن_م.الرتبة == 6) { أرجع ن_طويل2_طبيعي_جسر(); };
    أرجع ن_صحيح_طبيعي_جسر();
}

// An integer type's rank as a number: the standard types by their rank,
// _BitInt(N) just below the narrowest standard type at least N bits wide
// (a standard type outranks a bit-precise one of its width), and ordered
// by N among themselves.
عرف مفتاح_رتبة_جسر(م: &محلل_جسر, النوع: طبيعي): طبيعي {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    إذا (ن.البتات_الدقيقة == 0) { أرجع (ن.الرتبة مثل طبيعي) * 1000; };
    دع العرض: طبيعي = ن.البتات_الدقيقة;
    دع الرتبة: متغير طبيعي = 6;
    إذا (العرض <= 8) { الرتبة := 2; }
    وإلا إذا (العرض <= 16) { الرتبة := 3; }
    وإلا إذا (العرض <= (*م).النموذج.عرض_الصحيح) { الرتبة := 4; }
    وإلا إذا (العرض <= (*م).النموذج.عرض_الطويل) { الرتبة := 5; };
    أرجع الرتبة * 1000 - 64 + العرض;
}

// unsigned _BitInt(N) (the parser's table is behind a shared reference).
عرف بتي_م_جسر(م: &محلل_جسر, البتات: طبيعي): طبيعي {
    // The table is extended through the parser that owns it.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*م).ج.الأنواع) مثل طبيعي)) {
        دع ن: نوع_سي_جسر = (*م).ج.الأنواع[ف];
        إذا (ن.البتات_الدقيقة == البتات && !ن.موقع && !ن.ثابت) { أرجع ف; };
        ف := ف + 1;
    }
    أرجع ن_طويل2_طبيعي_جسر();
}

عرف اختر_جسر(الشرط: منطقي, أ: طبيعي, ب: طبيعي): طبيعي {
    إذا (الشرط) { أرجع أ; };
    أرجع ب;
}

عرف موقع_نوع_جسر(م: &محلل_جسر, النوع: طبيعي): منطقي {
    أرجع (*م).ج.الأنواع[بلا_تعداد_جسر(&(*م).ج, النوع)].موقع;
}

عرف مؤشر_نوع_جسر(م: &محلل_جسر, النوع: طبيعي): منطقي { أرجع (*م).ج.الأنواع[النوع].الصنف == 5; }

عرف حجم_مشار_جسر(م: &محلل_جسر, النوع: طبيعي): طبيعي {
    دع ح: حجم_جسر = حجم_نوع_جسر(&(*م).ج, &(*م).النموذج, (*م).ج.الأنواع[النوع].الأساس, خطأ);
    أرجع ح.الحجم;
}

عرف شرطي_ت_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    دع الشرط: قيمة_جسر = ثنائي_ت_جسر(م, 1);
    إذا (!اقبل_جسر(م, (*م).ك.ك_question)) { أرجع الشرط; };
    دع ش: قيمة_جسر = حمل_قيمة_جسر(م, الشرط);
    // GNU's `a ?: b`.
    دع أ: متغير قيمة_جسر = ش;
    إذا (!عند_جسر(م, (*م).ك.ك_colon)) { أ := حمل_قيمة_جسر(م, قيم_تعبيرا_ق_جسر(م)); };
    دع ت: منطقي = توقع_جسر(م, (*م).ك.ك_colon, «:»);
    دع ب: قيمة_جسر = حمل_قيمة_جسر(م, شرطي_ت_جسر(م));
    دع النوع: متغير طبيعي = أ.النوع;
    إذا (صحيح_أو_تعداد_جسر(&(*م).ج, أ.النوع) && صحيح_أو_تعداد_جسر(&(*م).ج, ب.النوع)) { النوع := مشترك_جسر(م, أ.النوع, ب.النوع); };
    إذا (!ش.ثابت) { أرجع غير_ثابت_جسر(النوع); };
    إذا (ش.البتات != 0) { أرجع قيمة_من_جسر(طبع_جسر(م, أ.البتات, النوع), النوع, أ.ثابت); };
    أرجع قيمة_من_جسر(طبع_جسر(م, ب.البتات, النوع), النوع, ب.ثابت);
}

عرف أسبقية_ت_جسر(م: &محلل_جسر): طبيعي {
    دع ر: رمز_جسر = رمز_م_جسر(م);
    إذا (ر.الصنف != 5) { أرجع 0; };
    دع ي: طبيعي = ر.المعرف;
    دع ك: &كلمات_محلل_جسر = &(*م).ك;
    إذا (ي == (*ك).ك_star || ي == (*ك).ك_slash || ي == (*ك).ك_percent) { أرجع 10; };
    إذا (ي == (*ك).ك_plus || ي == (*ك).ك_minus) { أرجع 9; };
    إذا (ي == (*ك).ك_shl || ي == (*ك).ك_shr) { أرجع 8; };
    إذا (ي == (*ك).ك_lt || ي == (*ك).ك_gt || ي == (*ك).ك_le || ي == (*ك).ك_ge) { أرجع 7; };
    إذا (ي == (*ك).ك_eq || ي == (*ك).ك_ne) { أرجع 6; };
    إذا (ي == (*ك).ك_amp) { أرجع 5; };
    إذا (ي == (*ك).ك_caret) { أرجع 4; };
    إذا (ي == (*ك).ك_pipe) { أرجع 3; };
    إذا (ي == (*ك).ك_andand) { أرجع 2; };
    إذا (ي == (*ك).ك_oror) { أرجع 1; };
    أرجع 0;
}

عرف ثنائي_ت_جسر(م: &متغير محلل_جسر, الحد: طبيعي): قيمة_جسر {
    دع اليسار: متغير قيمة_جسر = تحويل_ت_جسر(م);
    طالما (صواب) {
        دع الأسبقية: طبيعي = أسبقية_ت_جسر(م);
        إذا (الأسبقية == 0 || الأسبقية < الحد) { اخرج_من_حلقة; };
        دع المعامل: طبيعي = رمز_م_جسر(م).المعرف;
        تقدم_جسر(م);
        دع اليمين: قيمة_جسر = ثنائي_ت_جسر(م, الأسبقية + 1);
        اليسار := طبق_ثنائيا_جسر(م, المعامل, حمل_قيمة_جسر(م, اليسار), حمل_قيمة_جسر(م, اليمين));
    }
    أرجع اليسار;
}

عرف منطق_ت_جسر(ق: منطقي, ثابت: منطقي): قيمة_جسر {
    إذا (ق) { أرجع قيمة_من_جسر(1, ن_صحيح_جسر(), ثابت); };
    أرجع قيمة_من_جسر(0, ن_صحيح_جسر(), ثابت);
}

عرف طبق_ثنائيا_جسر(م: &متغير محلل_جسر, المعامل: طبيعي, أ: قيمة_جسر, ب: قيمة_جسر): قيمة_جسر {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع ثابت: منطقي = أ.ثابت && ب.ثابت;
    // && and || are constant when the left operand decides.
    إذا (المعامل == ك.ك_andand) {
        إذا (أ.ثابت && أ.البتات == 0) { أرجع منطق_ت_جسر(خطأ, صواب); };
        أرجع منطق_ت_جسر(أ.البتات != 0 && ب.البتات != 0, ثابت);
    };
    إذا (المعامل == ك.ك_oror) {
        إذا (أ.ثابت && أ.البتات != 0) { أرجع منطق_ت_جسر(صواب, صواب); };
        أرجع منطق_ت_جسر(أ.البتات != 0 || ب.البتات != 0, ثابت);
    };
    دع مؤشر_أ: منطقي = مؤشر_نوع_جسر(م, أ.النوع);
    دع مؤشر_ب: منطقي = مؤشر_نوع_جسر(م, ب.النوع);
    إذا (مؤشر_أ || مؤشر_ب) {
        // Pointer arithmetic and comparison (offsetof-style constants).
        إذا (المعامل == ك.ك_plus || المعامل == ك.ك_minus) {
            إذا (مؤشر_أ && مؤشر_ب && المعامل == ك.ك_minus) {
                دع الحجم: طبيعي = حجم_مشار_جسر(م, أ.النوع);
                دع الفرق: ط64 = طرح_ط64_ملتف(أ.البتات, ب.البتات);
                دع ن_ف: طبيعي = صحيح_بعرض_جسر(م, (*م).النموذج.عرض_المؤشر, صواب);
                إذا (الحجم == 0) { أرجع غير_ثابت_جسر(ن_ف); };
                أرجع قيمة_من_جسر(اقسم_جسر(الفرق, الحجم مثل ط64, خطأ, خطأ), ن_ف, ثابت);
            };
            دع المؤشر: قيمة_جسر = اختر_قيمة_جسر(مؤشر_أ, أ, ب);
            دع العدد: قيمة_جسر = اختر_قيمة_جسر(مؤشر_أ, ب, أ);
            دع الحجم: ط64 = حجم_مشار_جسر(م, المؤشر.النوع) مثل ط64;
            دع الإزاحة: ط64 = ضرب_ط64_ملتف(العدد.البتات, الحجم);
            إذا (المعامل == ك.ك_plus) { أرجع قيمة_من_جسر(جمع_ط64_ملتف(المؤشر.البتات, الإزاحة), المؤشر.النوع, ثابت); };
            أرجع قيمة_من_جسر(طرح_ط64_ملتف(المؤشر.البتات, الإزاحة), المؤشر.النوع, ثابت);
        };
        إذا (المعامل == ك.ك_eq) { أرجع منطق_ت_جسر(أ.البتات == ب.البتات, ثابت); };
        إذا (المعامل == ك.ك_ne) { أرجع منطق_ت_جسر(أ.البتات != ب.البتات, ثابت); };
        إذا (المعامل == ك.ك_lt) { أرجع منطق_ت_جسر(أ.البتات < ب.البتات, ثابت); };
        إذا (المعامل == ك.ك_gt) { أرجع منطق_ت_جسر(أ.البتات > ب.البتات, ثابت); };
        إذا (المعامل == ك.ك_le) { أرجع منطق_ت_جسر(أ.البتات <= ب.البتات, ثابت); };
        إذا (المعامل == ك.ك_ge) { أرجع منطق_ت_جسر(أ.البتات >= ب.البتات, ثابت); };
        أرجع غير_ثابت_جسر(ن_صحيح_جسر());
    };
    إذا (!صحيح_أو_تعداد_جسر(&(*م).ج, أ.النوع) || !صحيح_أو_تعداد_جسر(&(*م).ج, ب.النوع)) {
        // Floating operands: not an integer constant expression.
        دع النوع: متغير طبيعي = ن_مزدوج_جسر();
        إذا (المعامل == ك.ك_eq || المعامل == ك.ك_ne || المعامل == ك.ك_lt || المعامل == ك.ك_gt || المعامل == ك.ك_le
            || المعامل == ك.ك_ge) { النوع := ن_صحيح_جسر(); };
        أرجع غير_ثابت_جسر(النوع);
    };
    إذا (المعامل == ك.ك_shl || المعامل == ك.ك_shr) {
        دع النوع: طبيعي = رق_جسر(م, أ.النوع);
        دع العرض: طبيعي = (*م).ج.الأنواع[النوع].العرض;
        دع ق_أ: ط64 = طبع_جسر(م, أ.البتات, النوع);
        إذا (!ثابت) { أرجع غير_ثابت_جسر(النوع); };
        إذا (ب.البتات >= (العرض مثل ط64)) { أرجع قيمة_من_جسر(0, النوع, صواب); };
        إذا (المعامل == ك.ك_shl) { أرجع قيمة_من_جسر(طبع_جسر(م, إزاحة_يسرى_ط64_ملتفة(ق_أ, ب.البتات مثل ط32), النوع), النوع, صواب); };
        إذا (موقع_نوع_جسر(م, النوع) && (ق_أ & 0x8000000000000000) != 0) {
            أرجع قيمة_من_جسر(~((~ق_أ) >> ب.البتات), النوع, صواب);
        };
        أرجع قيمة_من_جسر(ق_أ >> ب.البتات, النوع, صواب);
    };
    دع النوع: طبيعي = مشترك_جسر(م, أ.النوع, ب.النوع);
    دع س: ط64 = طبع_جسر(م, أ.البتات, النوع);
    دع ص: ط64 = طبع_جسر(م, ب.البتات, النوع);
    دع موقع: منطقي = موقع_نوع_جسر(م, النوع);
    إذا (!ثابت) {
        إذا (المعامل == ك.ك_eq || المعامل == ك.ك_ne || المعامل == ك.ك_lt || المعامل == ك.ك_gt || المعامل == ك.ك_le
            || المعامل == ك.ك_ge) { أرجع غير_ثابت_جسر(ن_صحيح_جسر()); };
        أرجع غير_ثابت_جسر(النوع);
    };
    إذا (المعامل == ك.ك_plus) { أرجع قيمة_من_جسر(طبع_جسر(م, جمع_ط64_ملتف(س, ص), النوع), النوع, صواب); };
    إذا (المعامل == ك.ك_minus) { أرجع قيمة_من_جسر(طبع_جسر(م, طرح_ط64_ملتف(س, ص), النوع), النوع, صواب); };
    إذا (المعامل == ك.ك_star) { أرجع قيمة_من_جسر(طبع_جسر(م, ضرب_ط64_ملتف(س, ص), النوع), النوع, صواب); };
    إذا (المعامل == ك.ك_slash || المعامل == ك.ك_percent) {
        إذا (ص == 0) { أرجع غير_ثابت_جسر(النوع); };
        أرجع قيمة_من_جسر(طبع_جسر(م, اقسم_جسر(س, ص, !موقع, المعامل == ك.ك_percent), النوع), النوع, صواب);
    };
    إذا (المعامل == ك.ك_amp) { أرجع قيمة_من_جسر(س & ص, النوع, صواب); };
    إذا (المعامل == ك.ك_pipe) { أرجع قيمة_من_جسر(س | ص, النوع, صواب); };
    إذا (المعامل == ك.ك_caret) { أرجع قيمة_من_جسر(طبع_جسر(م, س ^ ص, النوع), النوع, صواب); };
    دع أقل_ق: منطقي = اختر_منطقيا_جسر(موقع, أصغر_موقع_جسر(س, ص), س < ص);
    دع أعظم_ق: منطقي = اختر_منطقيا_جسر(موقع, أصغر_موقع_جسر(ص, س), ص < س);
    إذا (المعامل == ك.ك_lt) { أرجع منطق_ت_جسر(أقل_ق, صواب); };
    إذا (المعامل == ك.ك_gt) { أرجع منطق_ت_جسر(أعظم_ق, صواب); };
    إذا (المعامل == ك.ك_le) { أرجع منطق_ت_جسر(!أعظم_ق, صواب); };
    إذا (المعامل == ك.ك_ge) { أرجع منطق_ت_جسر(!أقل_ق, صواب); };
    إذا (المعامل == ك.ك_eq) { أرجع منطق_ت_جسر(س == ص, صواب); };
    أرجع منطق_ت_جسر(س != ص, صواب);
}

عرف اختر_قيمة_جسر(الشرط: منطقي, أ: قيمة_جسر, ب: قيمة_جسر): قيمة_جسر {
    إذا (الشرط) { أرجع أ; };
    أرجع ب;
}

عرف اختر_منطقيا_جسر(الشرط: منطقي, أ: منطقي, ب: منطقي): منطقي {
    إذا (الشرط) { أرجع أ; };
    أرجع ب;
}

// A cast to النوع.
عام عرف حول_جسر(م: &متغير محلل_جسر, ق: قيمة_جسر, النوع: طبيعي): قيمة_جسر {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    إذا (ن.الصنف == 1) { أرجع غير_ثابت_جسر(النوع); };
    دع المصدر_ن: نوع_سي_جسر = (*م).ج.الأنواع[ق.النوع];
    دع من_صحيح: منطقي = صحيح_أو_تعداد_جسر(&(*م).ج, ق.النوع) || المصدر_ن.الصنف == 5;
    إذا ((صحيح_أو_تعداد_جسر(&(*م).ج, النوع) || ن.الصنف == 5) && من_صحيح) {
        أرجع قيمة_من_جسر(طبع_جسر(م, ق.البتات, النوع), النوع, ق.ثابت);
    };
    أرجع غير_ثابت_جسر(النوع);
}

عرف تحويل_ت_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    إذا (عند_جسر(م, ك.ك_lparen)) {
        دع محفوظ: طبيعي = (*م).الموضع;
        تقدم_جسر(م);
        إذا (بداية_نوع_جسر(م)) {
            دع النوع: طبيعي = حلل_اسم_نوع_جسر(م);
            دع ت: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
            إذا (عند_جسر(م, ك.ك_lbrace)) {
                // A compound literal: an object, not a constant.
                تخط_متوازن_م_جسر(م);
                أرجع غير_ثابت_جسر(النوع);
            };
            دع ق: قيمة_جسر = حمل_قيمة_جسر(م, تحويل_ت_جسر(م));
            أرجع حول_جسر(م, ق, النوع);
        };
        (*م).الموضع := محفوظ;
    };
    أرجع أحادي_ت_جسر(م);
}

عرف أحادي_ت_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع ر: رمز_جسر = رمز_م_جسر(م);
    إذا (ر.الصنف == 1 && (ر.المعرف == ك.ك_sizeof || ر.المعرف == ك.ك__Alignof || ر.المعرف == ك.ك___alignof__
        || ر.المعرف == ك.ك___alignof || ر.المعرف == ك.ك_alignof)) {
        دع حجم: منطقي = ر.المعرف == ك.ك_sizeof;
        تقدم_جسر(م);
        دع النوع: متغير طبيعي = 0;
        دع وجد: متغير منطقي = خطأ;
        إذا (عند_جسر(م, ك.ك_lparen)) {
            دع محفوظ: طبيعي = (*م).الموضع;
            تقدم_جسر(م);
            إذا (بداية_نوع_جسر(م)) {
                النوع := حلل_اسم_نوع_جسر(م);
                دع ت: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
                وجد := صواب;
                إذا (عند_جسر(م, ك.ك_lbrace)) { تخط_متوازن_م_جسر(م); };
            } وإلا {
                (*م).الموضع := محفوظ;
            };
        };
        إذا (!وجد) {
            دع ق: قيمة_جسر = أحادي_ت_جسر(م);
            النوع := ق.النوع;
        };
        دع ح: حجم_جسر = حجم_نوع_جسر(&(*م).ج, &(*م).النموذج, النوع, خطأ);
        دع ن_ح: طبيعي = صحيح_بعرض_جسر(م, (*م).النموذج.عرض_المؤشر, خطأ);
        إذا (!ح.صالح) { أرجع غير_ثابت_جسر(ن_ح); };
        إذا (حجم) { أرجع قيمة_من_جسر(ح.الحجم مثل ط64, ن_ح, صواب); };
        أرجع قيمة_من_جسر(ح.المحاذاة مثل ط64, ن_ح, صواب);
    };
    إذا (ر.الصنف == 1 && ر.المعرف == ك.ك___extension__) { تقدم_جسر(م); أرجع تحويل_ت_جسر(م); };
    إذا (ر.الصنف == 5) {
        دع ي: طبيعي = ر.المعرف;
        إذا (ي == ك.ك_plus || ي == ك.ك_minus || ي == ك.ك_tilde || ي == ك.ك_bang) {
            تقدم_جسر(م);
            دع ق: قيمة_جسر = حمل_قيمة_جسر(م, تحويل_ت_جسر(م));
            إذا (ي == ك.ك_bang) { أرجع منطق_ت_جسر(ق.البتات == 0, ق.ثابت); };
            إذا (!صحيح_أو_تعداد_جسر(&(*م).ج, ق.النوع)) { أرجع غير_ثابت_جسر(ق.النوع); };
            دع النوع: طبيعي = رق_جسر(م, ق.النوع);
            دع س: ط64 = طبع_جسر(م, ق.البتات, النوع);
            إذا (ي == ك.ك_plus) { أرجع قيمة_من_جسر(س, النوع, ق.ثابت); };
            إذا (ي == ك.ك_minus) { أرجع قيمة_من_جسر(طبع_جسر(م, طرح_ط64_ملتف(0, س), النوع), النوع, ق.ثابت); };
            أرجع قيمة_من_جسر(طبع_جسر(م, ~س, النوع), النوع, ق.ثابت);
        };
        إذا (ي == ك.ك_andand && رمز_بعد_جسر(م, 1).الصنف == 1) {
            // GNU: the address of a label.
            تقدم_جسر(م);
            تقدم_جسر(م);
            أرجع غير_ثابت_جسر(مؤشر_إلى_جسر(&متغير (*م).ج, ن_فراغ_جسر()));
        };
        إذا (ي == ك.ك_amp) {
            تقدم_جسر(م);
            دع ق: قيمة_جسر = تحويل_ت_جسر(م);
            دع المؤشر: طبيعي = مؤشر_إلى_جسر(&متغير (*م).ج, ق.النوع);
            إذا (ق.عنوان) { أرجع قيمة_من_جسر(ق.البتات, المؤشر, ق.ثابت); };
            أرجع غير_ثابت_جسر(المؤشر);
        };
        إذا (ي == ك.ك_star) {
            تقدم_جسر(م);
            دع ق: قيمة_جسر = حمل_قيمة_جسر(م, تحويل_ت_جسر(م));
            دع ن: نوع_سي_جسر = (*م).ج.الأنواع[ق.النوع];
            إذا (ن.الصنف != 5) { أرجع غير_ثابت_جسر(ن_خطأ_جسر()); };
            دع الناتج: قيمة_جسر = { البتات: ق.البتات, النوع: ن.الأساس, ثابت: ق.ثابت, عنوان: صواب };
            أرجع الناتج;
        };
        إذا (ي == ك.ك_plusplus || ي == ك.ك_minusminus) {
            تقدم_جسر(م);
            دع ق: قيمة_جسر = تحويل_ت_جسر(م);
            أرجع غير_ثابت_جسر(ق.النوع);
        };
    };
    أرجع لاحق_ت_جسر(م);
}

// The member المعرف of a struct or union: its offset and type (searching
// anonymous members).
عام نوع عضو_جسر = { وجد: منطقي, الإزاحة: طبيعي, النوع: طبيعي };

عام عرف ابحث_عضوا_جسر(م: &محلل_جسر, النوع: طبيعي, المعرف: طبيعي): عضو_جسر {
    دع الفشل: عضو_جسر = { وجد: خطأ, الإزاحة: 0, النوع: 0 };
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    إذا (ن.الصنف != 8 && ن.الصنف != 9) { أرجع الفشل; };
    دع الوسم: وسم_سي_جسر = (*م).ج.الوسوم[ن.الوسم];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الوسم.عدد_الحقول) {
        دع الحقل: حقل_سي_جسر = (*م).ج.الحقول[الوسم.بداية_الحقول + ف];
        إذا (الحقل.الاسم == المعرف && المعرف != 0) {
            دع الناتج: عضو_جسر = { وجد: صواب, الإزاحة: الحقل.الإزاحة, النوع: الحقل.النوع };
            أرجع الناتج;
        };
        إذا (الحقل.الاسم == 0) {
            دع الداخلي: عضو_جسر = ابحث_عضوا_جسر(م, الحقل.النوع, المعرف);
            إذا (الداخلي.وجد) {
                دع الناتج: عضو_جسر = { وجد: صواب, الإزاحة: الحقل.الإزاحة + الداخلي.الإزاحة, النوع: الداخلي.النوع };
                أرجع الناتج;
            };
        };
        ف := ف + 1;
    }
    أرجع الفشل;
}

عرف لاحق_ت_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع ق: متغير قيمة_جسر = أولي_ت_جسر(م);
    طالما (صواب) {
        إذا (عند_جسر(م, ك.ك_lbracket)) {
            تقدم_جسر(م);
            دع الأساس: قيمة_جسر = حمل_قيمة_جسر(م, ق);
            دع الفهرس: قيمة_جسر = حمل_قيمة_جسر(م, قيم_تعبيرا_جسر(م));
            دع ت: منطقي = توقع_جسر(م, ك.ك_rbracket, «]»);
            إذا ((*م).ج.الأنواع[الأساس.النوع].الصنف != 5) { ق := غير_ثابت_جسر(ن_خطأ_جسر()); تابع_حلقة; };
            دع العنصر: طبيعي = (*م).ج.الأنواع[الأساس.النوع].الأساس;
            دع الحجم: ط64 = حجم_مشار_جسر(م, الأساس.النوع) مثل ط64;
            دع الناتج: قيمة_جسر = {
                البتات: جمع_ط64_ملتف(الأساس.البتات, ضرب_ط64_ملتف(الفهرس.البتات, الحجم)), النوع: العنصر,
                ثابت: الأساس.ثابت && الفهرس.ثابت, عنوان: صواب
            };
            ق := الناتج;
            تابع_حلقة;
        };
        إذا (عند_جسر(م, ك.ك_dot) || عند_جسر(م, ك.ك_arrow)) {
            دع سهم: منطقي = عند_جسر(م, ك.ك_arrow);
            تقدم_جسر(م);
            دع الاسم: طبيعي = رمز_م_جسر(م).المعرف;
            تقدم_جسر(م);
            دع الأساس: متغير قيمة_جسر = ق;
            إذا (سهم) {
                دع المؤشر: قيمة_جسر = حمل_قيمة_جسر(م, ق);
                إذا ((*م).ج.الأنواع[المؤشر.النوع].الصنف != 5) { ق := غير_ثابت_جسر(ن_خطأ_جسر()); تابع_حلقة; };
                دع الهدف: قيمة_جسر = { البتات: المؤشر.البتات, النوع: (*م).ج.الأنواع[المؤشر.النوع].الأساس, ثابت: المؤشر.ثابت, عنوان: صواب };
                الأساس := الهدف;
            };
            دع العضو: عضو_جسر = ابحث_عضوا_جسر(م, الأساس.النوع, الاسم);
            إذا (!العضو.وجد) { ق := غير_ثابت_جسر(ن_خطأ_جسر()); تابع_حلقة; };
            دع الناتج: قيمة_جسر = {
                البتات: جمع_ط64_ملتف(الأساس.البتات, العضو.الإزاحة مثل ط64), النوع: العضو.النوع,
                ثابت: الأساس.ثابت && الأساس.عنوان, عنوان: صواب
            };
            ق := الناتج;
            تابع_حلقة;
        };
        إذا (عند_جسر(م, ك.ك_lparen)) {
            // A call: its result type, never a constant.
            دع الدالة: قيمة_جسر = حمل_قيمة_جسر(م, ق);
            تخط_متوازن_م_جسر(م);
            دع ن: نوع_سي_جسر = (*م).ج.الأنواع[الدالة.النوع];
            دع الناتج: متغير طبيعي = ن_صحيح_جسر();
            إذا (ن.الصنف == 5 && (*م).ج.الأنواع[ن.الأساس].الصنف == 7) { الناتج := (*م).ج.الأنواع[ن.الأساس].الأساس; };
            ق := غير_ثابت_جسر(الناتج);
            تابع_حلقة;
        };
        إذا (عند_جسر(م, ك.ك_plusplus) || عند_جسر(م, ك.ك_minusminus)) {
            تقدم_جسر(م);
            ق := غير_ثابت_جسر(ق.النوع);
            تابع_حلقة;
        };
        اخرج_من_حلقة;
    }
    أرجع ق;
}

// The type of an integer constant (C17 6.4.4.1p5).
عام عرف نوع_عدد_حرفي_جسر(م: &محلل_جسر, العدد: &عدد_حرفي_جسر): طبيعي {
    دع ق: ط64 = (*العدد).القيمة;
    دع ع_ص: طبيعي = (*م).النموذج.عرض_الصحيح;
    دع ع_ط: طبيعي = (*م).النموذج.عرض_الطويل;
    دع المرشحات: متغير متجه طبيعي = [];
    دع بلا: منطقي = (*العدد).بلا_إشارة;
    دع عشري: منطقي = (*العدد).عشري;
    إذا ((*العدد).الطول_المحدد == 0) {
        إذا (!بلا) { ألحق(المرشحات, ن_صحيح_جسر()); };
        إذا (بلا || !عشري) { ألحق(المرشحات, ن_صحيح_طبيعي_جسر()); };
    };
    إذا ((*العدد).الطول_المحدد <= 1) {
        إذا (!بلا) { ألحق(المرشحات, ن_طويل_جسر()); };
        إذا (بلا || !عشري) { ألحق(المرشحات, ن_طويل_طبيعي_جسر()); };
    };
    إذا (!بلا) { ألحق(المرشحات, ن_طويل2_جسر()); };
    ألحق(المرشحات, ن_طويل2_طبيعي_جسر());
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المرشحات) مثل طبيعي)) {
        دع ن: نوع_سي_جسر = (*م).ج.الأنواع[المرشحات[ف]];
        دع العرض: طبيعي = ن.العرض;
        دع يسع: متغير منطقي = صواب;
        إذا (ن.موقع) {
            إذا (العرض >= 64) { يسع := (ق & 0x8000000000000000) == 0; }
            وإلا { يسع := ق < (1 << ((العرض - 1) مثل ط64)); };
        } وإلا إذا (العرض < 64) {
            يسع := ق < (1 << (العرض مثل ط64));
        };
        إذا (يسع) { أرجع المرشحات[ف]; };
        ف := ف + 1;
    }
    أرجع ن_طويل2_طبيعي_جسر();
}

عرف أولي_ت_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع ر: رمز_جسر = رمز_م_جسر(م);
    إذا (ر.الصنف == 2) {
        تقدم_جسر(م);
        دع النص: نص = اسم_م_جسر(م, ر.المعرف);
        دع العدد: عدد_حرفي_جسر = حلل_عدد_صحيح_جسر(&النص);
        إذا (العدد.صالح) {
            دع النوع: طبيعي = نوع_عدد_حرفي_جسر(م, &العدد);
            أرجع قيمة_من_جسر(العدد.القيمة, النوع, صواب);
        };
        دع العائم: عائم_حرفي_جسر = حلل_عائم_جسر(&النص);
        إذا (العائم.صالح) {
            إذا (العائم.العرض == 32) { أرجع غير_ثابت_جسر(ن_عائم_جسر()); };
            إذا (العائم.العرض == 128) { أرجع غير_ثابت_جسر(ن_مزدوج_طويل_جسر()); };
            أرجع غير_ثابت_جسر(ن_مزدوج_جسر());
        };
        شخص_م_قيمة_جسر(م, سبب_تشخيص.سبب_سي_عدد_غير_صالح(), &ر, النص);
        أرجع غير_ثابت_جسر(ن_صحيح_جسر());
    };
    إذا (ر.الصنف == 4) {
        تقدم_جسر(م);
        دع النص: نص = اسم_م_جسر(م, ر.المعرف);
        دع الحرف: حرف_حرفي_جسر = حلل_حرف_جسر(&النص, (*م).النموذج.حرف_موقع);
        إذا (!الحرف.صالح) { أرجع غير_ثابت_جسر(ن_صحيح_جسر()); };
        دع النوع: متغير طبيعي = ن_صحيح_جسر();
        إذا (الحرف.البادئة == 1) { النوع := صحيح_بعرض_جسر(م, (*م).النموذج.عرض_الحرف_العريض, (*م).النموذج.حرف_عريض_موقع); };
        إذا (الحرف.البادئة == 2) { النوع := ن_قصير_طبيعي_جسر(); };
        إذا (الحرف.البادئة == 3) { النوع := ن_صحيح_طبيعي_جسر(); };
        أرجع قيمة_من_جسر(طبع_جسر(م, الحرف.القيمة, النوع), النوع, صواب);
    };
    إذا (ر.الصنف == 3) {
        // String literals (adjacent ones concatenated): a char array.
        دع الطول_ن: متغير طبيعي = 0;
        طالما (رمز_م_جسر(م).الصنف == 3) {
            دع النص: نص = اسم_م_جسر(م, رمز_م_جسر(م).المعرف);
            دع المفكوك: حرفي_مفكوك_جسر = فك_حرفي_جسر(&النص);
            الطول_ن := الطول_ن + (الطول(المفكوك.الوحدات) مثل طبيعي);
            تقدم_جسر(م);
        }
        دع المصفوفة: طبيعي = مصفوفة_من_جسر(&متغير (*م).ج, ن_حرف_جسر(), الطول_ن + 1, خطأ);
        دع الناتج: قيمة_جسر = { البتات: 0, النوع: المصفوفة, ثابت: خطأ, عنوان: صواب };
        أرجع الناتج;
    };
    إذا (ر.الصنف == 5 && ر.المعرف == ك.ك_lparen) {
        تقدم_جسر(م);
        إذا (عند_جسر(م, ك.ك_lbrace)) {
            // A GNU statement expression.
            تخط_متوازن_م_جسر(م);
            دع ت: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
            أرجع غير_ثابت_جسر(ن_صحيح_جسر());
        };
        دع ق: قيمة_جسر = قيم_تعبيرا_ق_جسر(م);
        دع ت: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
        أرجع ق;
    };
    إذا (ر.الصنف == 1) {
        تقدم_جسر(م);
        إذا (ر.المعرف == ك.ك___builtin_offsetof) { أرجع أزاحة_مدمجة_جسر(م); };
        إذا (ر.المعرف == ك.ك__Generic) {
            تخط_متوازن_م_جسر(م);
            أرجع غير_ثابت_جسر(ن_صحيح_جسر());
        };
        دع ب: طبيعي = ربط_عادي_جسر(م, ر.المعرف);
        إذا (ب != 0) {
            دع الكيان: كيان_سي_جسر = (*م).الكيانات[ب - 1];
            إذا (الكيان.الصنف == 4) { أرجع قيمة_من_جسر(الكيان.القيمة, الكيان.النوع, صواب); };
            إذا (الكيان.الصنف == 2 || الكيان.الصنف == 3 || الكيان.الصنف == 5) {
                دع الناتج: قيمة_جسر = { البتات: 0, النوع: الكيان.النوع, ثابت: خطأ, عنوان: صواب };
                أرجع الناتج;
            };
        };
        إذا ((*م).في_جسم) { أرجع غير_ثابت_جسر(ن_صحيح_جسر()); };
        شخص_م_رمز_جسر(م, سبب_تشخيص.سبب_سي_غير_مصرح(), &ر, اسم_م_جسر(م, ر.المعرف));
        أرجع غير_ثابت_جسر(ن_صحيح_جسر());
    };
    إذا (ر.الصنف == 0) {
        شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_تعبير());
    } وإلا {
        دع ت_ع: متغير تشخيص_جسر = تشخيص_م_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_تعبير(), &ر);
        أضف_موجود_سي(&متغير ت_ع.السجل, اسم_م_جسر(م, ر.المعرف));
        شخص_ت_م_جسر(م, ت_ع);
        // A closing token ends the construct around the missing operand.
        دع ك: كلمات_محلل_جسر = (*م).ك;
        إذا (!(عند_جسر(م, ك.ك_semi) || عند_جسر(م, ك.ك_rbrace) || عند_جسر(م, ك.ك_rparen)
            || عند_جسر(م, ك.ك_rbracket) || عند_جسر(م, ك.ك_comma))) { تقدم_جسر(م); };
    };
    أرجع غير_ثابت_جسر(ن_صحيح_جسر());
}

// An expression inside parentheses, keeping an lvalue (for `(*p).m`).
عام عرف قيم_تعبيرا_ق_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    // Inside a body a parenthesized expression may assign: `(x = f()) == 0`.
    دع ق: متغير قيمة_جسر = عنصر_ق_جسر(م);
    طالما (اقبل_جسر(م, (*م).ك.ك_comma)) {
        دع ب: قيمة_جسر = عنصر_ق_جسر(م);
        ق := غير_ثابت_جسر(حمل_قيمة_جسر(م, ب).النوع);
    }
    أرجع ق;
}

عرف عنصر_ق_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    إذا ((*م).في_جسم) { أرجع إسناد_ت_جسر(م); };
    أرجع شرطي_ت_جسر(م);
}

// __builtin_offsetof(type, member-designator).
عام عرف أزاحة_مدمجة_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع ن_ح: طبيعي = صحيح_بعرض_جسر(م, (*م).النموذج.عرض_المؤشر, خطأ);
    إذا (!توقع_جسر(م, ك.ك_lparen, «(»)) { أرجع غير_ثابت_جسر(ن_ح); };
    دع النوع: متغير طبيعي = حلل_اسم_نوع_جسر(م);
    دع ت: منطقي = توقع_جسر(م, ك.ك_comma, «,»);
    دع الإزاحة: متغير طبيعي = 0;
    دع صالح: متغير منطقي = صواب;
    طالما (!نهاية_جسر(م) && !عند_جسر(م, ك.ك_rparen)) {
        إذا (اقبل_جسر(م, ك.ك_dot)) { تابع_حلقة; };
        إذا (اقبل_جسر(م, ك.ك_lbracket)) {
            دع ق: قيمة_جسر = قيم_تعبيرا_جسر(م);
            دع ت2: منطقي = توقع_جسر(م, ك.ك_rbracket, «]»);
            دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
            إذا (ن.الصنف != 6 || !ق.ثابت) { صالح := خطأ; تابع_حلقة; };
            دع ح: حجم_جسر = حجم_نوع_جسر(&(*م).ج, &(*م).النموذج, ن.الأساس, خطأ);
            الإزاحة := الإزاحة + ح.الحجم * (ق.البتات مثل طبيعي);
            النوع := ن.الأساس;
            تابع_حلقة;
        };
        دع ر: رمز_جسر = رمز_م_جسر(م);
        تقدم_جسر(م);
        دع العضو: عضو_جسر = ابحث_عضوا_جسر(م, النوع, ر.المعرف);
        إذا (!العضو.وجد) {
            شخص_م_رمز_جسر(م, سبب_تشخيص.سبب_سي_عضو_غير_موجود(), &ر, اسم_م_جسر(م, ر.المعرف));
            صالح := خطأ;
            اخرج_من_حلقة;
        };
        الإزاحة := الإزاحة + العضو.الإزاحة;
        النوع := العضو.النوع;
    }
    دع ت3: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
    أرجع قيمة_من_جسر(الإزاحة مثل ط64, ن_ح, صالح);
}

// ---- constants of macros ----

// The integer value of a token list (a macro's expansion), or none.
عام عرف قيم_رموزا_جسر(م: &متغير محلل_جسر, الرموز: &متجه رمز_جسر): اختياري قيمة_جسر {
    إذا ((الطول(*الرموز) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع المحفوظة: متغير متجه رمز_جسر = [];
    بدّل(المحفوظة, (*م).الرموز);
    ألحق_رموزا_محلل_جسر(&متغير (*م).الرموز, الرموز);
    دع الموضع: طبيعي = (*م).الموضع;
    (*م).الموضع := 0;
    (*م).صامت := صواب;
    (*م).فشل_التقييم := خطأ;
    دع ق: قيمة_جسر = قيم_تعبيرا_جسر(م);
    دع تام: منطقي = (*م).الموضع == (الطول((*م).الرموز) مثل طبيعي) && !(*م).فشل_التقييم;
    (*م).صامت := خطأ;
    بدّل(المحفوظة, (*م).الرموز);
    (*م).الموضع := الموضع;
    إذا (!تام || !ق.ثابت || !صحيح_أو_تعداد_جسر(&(*م).ج, ق.النوع)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(ق);
}

عرف ألحق_رموزا_محلل_جسر(الهدف: &متغير متجه رمز_جسر, المصدر: &متجه رمز_جسر): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) { ألحق(*الهدف, (*المصدر)[ف]); ف := ف + 1; }
}

// ---- function bodies (C17 6.8) ----
// A body is parsed for its syntax and its block-scope declarations (which
// may shadow typedef names); Jisr does not translate C code, so the
// statements build nothing.

عام عرف افتح_نطاقا_جسر(م: &متغير محلل_جسر): فراغ {
    ألحق((*م).بدايات_النطاقات, الطول((*م).الظلال) مثل طبيعي);
    ألحق((*م).بدايات_النطاقات, الطول((*م).ظلال_الوسوم) مثل طبيعي);
}

عام عرف أغلق_نطاقا_جسر(م: &متغير محلل_جسر): فراغ {
    دع ن: طبيعي = الطول((*م).بدايات_النطاقات) مثل طبيعي;
    إذا (ن < 2) { أرجع; };
    دع بداية_ع: طبيعي = (*م).بدايات_النطاقات[ن - 2];
    دع بداية_و: طبيعي = (*م).بدايات_النطاقات[ن - 1];
    اقتطع((*م).بدايات_النطاقات, ن - 2);
    طالما ((الطول((*م).الظلال) مثل طبيعي) > بداية_ع) {
        دع ك: طبيعي = الطول((*م).الظلال) مثل طبيعي;
        دع المعرف: طبيعي = (*م).الظلال[ك - 2];
        دع السابق: طبيعي = (*م).الظلال[ك - 1];
        طالما ((الطول((*م).ربط_عادي) مثل طبيعي) <= المعرف) { ألحق((*م).ربط_عادي, 0); }
        (*م).ربط_عادي[المعرف] := السابق;
        اقتطع((*م).الظلال, ك - 2);
    }
    طالما ((الطول((*م).ظلال_الوسوم) مثل طبيعي) > بداية_و) {
        دع ك: طبيعي = الطول((*م).ظلال_الوسوم) مثل طبيعي;
        اربط_وسما_جسر(م, (*م).ظلال_الوسوم[ك - 2], (*م).ظلال_الوسوم[ك - 1]);
        اقتطع((*م).ظلال_الوسوم, ك - 2);
    }
}

// A block-scope declaration: bound until its scope closes, never written.
عام عرف سجل_محليا_جسر(م: &متغير محلل_جسر, الكيان: كيان_سي_جسر): فراغ {
    دع المعرف: طبيعي = الكيان.الاسم;
    ألحق((*م).الظلال, المعرف);
    ألحق((*م).الظلال, ربط_عادي_جسر(م, المعرف));
    ألحق((*م).الكيانات, الكيان);
    اربط_عاديا_جسر(م, المعرف, (الطول((*م).الكيانات) مثل طبيعي) - 1);
}

// The body of a function definition, at its '{'.
عرف حلل_جسم_دالة_جسر(م: &متغير محلل_جسر): فراغ {
    إذا (!عند_جسر(م, (*م).ك.ك_lbrace)) { أرجع; };
    دع كان: منطقي = (*م).في_جسم;
    (*م).في_جسم := صواب;
    حلل_كتلة_جسر(م);
    (*م).في_جسم := كان;
}

عرف حلل_كتلة_جسر(م: &متغير محلل_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    تقدم_جسر(م);
    افتح_نطاقا_جسر(م);
    طالما (!نهاية_جسر(م) && !عند_جسر(م, ك.ك_rbrace)) {
        دع قبل: طبيعي = (*م).الموضع;
        حلل_عنصر_كتلة_جسر(م);
        إذا ((*م).الموضع == قبل) { تقدم_جسر(م); };
    }
    أغلق_نطاقا_جسر(م);
    دع ت: منطقي = توقع_جسر(م, ك.ك_rbrace, «}»);
}

// Whether a block item starting here is a declaration.
عام عرف بداية_تصريح_محلي_جسر(م: &محلل_جسر): منطقي {
    دع ك: &كلمات_محلل_جسر = &(*م).ك;
    دع ر: رمز_جسر = رمز_م_جسر(م);
    إذا (ر.الصنف != 1) { أرجع خطأ; };
    دع ي: طبيعي = ر.المعرف;
    إذا (ي == (*ك).ك_typedef || ي == (*ك).ك_extern || ي == (*ك).ك_static || ي == (*ك).ك_auto || ي == (*ك).ك_register
        || ي == (*ك).ك_thread_local || ي == (*ك).ك__Thread_local || ي == (*ك).ك___thread || ي == (*ك).ك_constexpr
        || ي == (*ك).ك_inline || ي == (*ك).ك___inline || ي == (*ك).ك___inline__ || ي == (*ك).ك__Noreturn
        || ي == (*ك).ك___auto_type) { أرجع صواب; };
    إذا (هو_نوع_مسمى_جسر(م, ي)) {
        // `T:` is a label; `T` is otherwise a type here.
        أرجع !عند_بعد_جسر(م, 1, (*ك).ك_colon);
    };
    إذا (ي == (*ك).ك___extension__ || ي == (*ك).ك___attribute__ || ي == (*ك).ك___attribute) { أرجع خطأ; };
    أرجع بداية_نوع_جسر(م);
}

عرف حلل_عنصر_كتلة_جسر(م: &متغير محلل_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    استهلك_حزما_جسر(م);
    طالما (عند_جسر(م, ك.ك___extension__)) { تقدم_جسر(م); }
    إذا (عند_جسر(م, ك.ك__Static_assert) || عند_جسر(م, ك.ك_static_assert)) { حلل_تأكيدا_جسر(م); أرجع; };
    إذا (بداية_تصريح_محلي_جسر(م)) { حلل_تصريحا_محليا_جسر(م); أرجع; };
    حلل_عبارة_جسر(م);
}

// A block-scope declaration (C17 6.7): its names shadow outer ones until
// the block ends; initializers are parsed as expressions or skipped
// (braced lists).
عرف حلل_تصريحا_محليا_جسر(م: &متغير محلل_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع المواصفات: مواصفات_جسر = حلل_مواصفات_جسر(م);
    إذا (!المواصفات.وجد_نوع) {
        إذا (عند_جسر(م, ك.ك___auto_type)) { تقدم_جسر(م); } وإلا {
            شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_تصريح());
            زامن_جسر(م);
            أرجع;
        };
    };
    إذا (اقبل_جسر(م, ك.ك_semi)) { أرجع; };
    طالما (!نهاية_جسر(م)) {
        دع المصرح: مصرح_جسر = حلل_مصرحا_جسر(م, المواصفات.النوع);
        دع السمات: متغير سمات_جسر = سمات_فارغة_جسر();
        حلل_سمات_جسر(م, &متغير السمات);
        إذا (المصرح.الاسم == 0) {
            شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_معرف_تصريح());
            زامن_جسر(م);
            أرجع;
        };
        دع الصنف: متغير ط8 = 5;
        إذا (المواصفات.تعريف_نوع) { الصنف := 1; };
        دع الكيان: كيان_سي_جسر = {
            الصنف: الصنف, الاسم: المصرح.الاسم, النوع: المصرح.النوع, القيمة: 0, الملف: المصرح.الملف,
            السطر: المصرح.السطر, العمود: المصرح.العمود, التسمية: 0, ساكن: المواصفات.ساكن, مضمن: خطأ,
            معرف: خطأ, غير_متاح: خطأ, خيطي: المواصفات.خيطي, محلي: صواب
        };
        سجل_محليا_جسر(م, الكيان);
        إذا (اقبل_جسر(م, ك.ك_assign)) { حلل_مهيئا_جسر(م); };
        إذا (اقبل_جسر(م, ك.ك_comma)) { تابع_حلقة; };
        إذا (!توقع_جسر(م, ك.ك_semi, «;»)) { زامن_جسر(م); };
        أرجع;
    }
}

// An initializer: a braced list (skipped) or an assignment-expression.
عرف حلل_مهيئا_جسر(م: &متغير محلل_جسر): فراغ {
    إذا (عند_جسر(م, (*م).ك.ك_lbrace)) { تخط_متوازن_م_جسر(م); أرجع; };
    دع ق: قيمة_جسر = إسناد_ت_جسر(م);
}

عرف إسناد_معامل_جسر(م: &محلل_جسر): منطقي {
    دع ر: رمز_جسر = رمز_م_جسر(م);
    إذا (ر.الصنف != 5) { أرجع خطأ; };
    دع ي: طبيعي = ر.المعرف;
    دع ك: &كلمات_محلل_جسر = &(*م).ك;
    أرجع ي == (*ك).ك_assign || ي == (*ك).ك_mul_assign || ي == (*ك).ك_div_assign || ي == (*ك).ك_mod_assign
        || ي == (*ك).ك_add_assign || ي == (*ك).ك_sub_assign || ي == (*ك).ك_shl_assign || ي == (*ك).ك_shr_assign
        || ي == (*ك).ك_and_assign || ي == (*ك).ك_xor_assign || ي == (*ك).ك_or_assign;
}

// An assignment-expression (C17 6.5.16): never a constant.
عرف إسناد_ت_جسر(م: &متغير محلل_جسر): قيمة_جسر {
    دع اليسار: قيمة_جسر = شرطي_ت_جسر(م);
    إذا (!إسناد_معامل_جسر(م)) { أرجع اليسار; };
    تقدم_جسر(م);
    دع اليمين: قيمة_جسر = إسناد_ت_جسر(م);
    أرجع غير_ثابت_جسر(اليسار.النوع);
}

// An expression with assignments and the comma operator.
عرف تعبير_جسم_جسر(م: &متغير محلل_جسر): فراغ {
    دع ق: متغير قيمة_جسر = إسناد_ت_جسر(م);
    طالما (اقبل_جسر(م, (*م).ك.ك_comma)) { ق := إسناد_ت_جسر(م); }
}

عرف شرط_بين_قوسين_جسر(م: &متغير محلل_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    إذا (!توقع_جسر(م, ك.ك_lparen, «(»)) { أرجع; };
    تعبير_جسم_جسر(م);
    دع ت: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
}

// A statement (C17 6.8, with GNU's case ranges, computed goto, asm
// statements and statement attributes).
عرف حلل_عبارة_جسر(م: &متغير محلل_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    حلل_سمات_بلا_تسمية_جسر(م);
    دع ر: رمز_جسر = رمز_م_جسر(م);
    إذا (ر.الصنف == 0) { أرجع; };
    إذا (عند_جسر(م, ك.ك_lbrace)) { حلل_كتلة_جسر(م); أرجع; };
    إذا (اقبل_جسر(م, ك.ك_semi)) { أرجع; };
    إذا (ر.الصنف == 1) {
        دع ي: طبيعي = ر.المعرف;
        إذا (ي == ك.ك_if) {
            تقدم_جسر(م);
            شرط_بين_قوسين_جسر(م);
            حلل_عبارة_جسر(م);
            إذا (اقبل_جسر(م, ك.ك_else)) { حلل_عبارة_جسر(م); };
            أرجع;
        };
        إذا (ي == ك.ك_switch || ي == ك.ك_while) {
            تقدم_جسر(م);
            شرط_بين_قوسين_جسر(م);
            حلل_عبارة_جسر(م);
            أرجع;
        };
        إذا (ي == ك.ك_do) {
            تقدم_جسر(م);
            حلل_عبارة_جسر(م);
            دع ت: منطقي = توقع_جسر(م, ك.ك_while, «while»);
            شرط_بين_قوسين_جسر(م);
            دع ت2: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            أرجع;
        };
        إذا (ي == ك.ك_for) {
            تقدم_جسر(م);
            إذا (!توقع_جسر(م, ك.ك_lparen, «(»)) { زامن_جسر(م); أرجع; };
            افتح_نطاقا_جسر(م);
            إذا (بداية_تصريح_محلي_جسر(م)) {
                حلل_تصريحا_محليا_جسر(م);
            } وإلا {
                إذا (!عند_جسر(م, ك.ك_semi)) { تعبير_جسم_جسر(م); };
                دع ت: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            };
            إذا (!عند_جسر(م, ك.ك_semi)) { تعبير_جسم_جسر(م); };
            دع ت2: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            إذا (!عند_جسر(م, ك.ك_rparen)) { تعبير_جسم_جسر(م); };
            دع ت3: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
            حلل_عبارة_جسر(م);
            أغلق_نطاقا_جسر(م);
            أرجع;
        };
        إذا (ي == ك.ك_goto) {
            تقدم_جسر(م);
            إذا (اقبل_جسر(م, ك.ك_star)) { تعبير_جسم_جسر(م); }
            وإلا إذا (رمز_م_جسر(م).الصنف == 1) { تقدم_جسر(م); }
            وإلا { شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_لافتة_بعد_قفز()); };
            دع ت: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            أرجع;
        };
        إذا (ي == ك.ك_continue || ي == ك.ك_break) {
            تقدم_جسر(م);
            دع ت: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            أرجع;
        };
        إذا (ي == ك.ك_return) {
            تقدم_جسر(م);
            إذا (!عند_جسر(م, ك.ك_semi)) { تعبير_جسم_جسر(م); };
            دع ت: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            أرجع;
        };
        إذا (ي == ك.ك_case) {
            تقدم_جسر(م);
            دع ق: قيمة_جسر = شرطي_ت_جسر(م);
            إذا (اقبل_جسر(م, ك.ك_ellipsis)) { دع ق2: قيمة_جسر = شرطي_ت_جسر(م); };
            دع ت: منطقي = توقع_جسر(م, ك.ك_colon, «:»);
            إذا (!عند_جسر(م, ك.ك_rbrace)) { حلل_عبارة_جسر(م); };
            أرجع;
        };
        إذا (ي == ك.ك_default && عند_بعد_جسر(م, 1, ك.ك_colon)) {
            تقدم_جسر(م);
            تقدم_جسر(م);
            إذا (!عند_جسر(م, ك.ك_rbrace)) { حلل_عبارة_جسر(م); };
            أرجع;
        };
        إذا ((ي == ك.ك___asm__ || ي == ك.ك___asm || ي == ك.ك_asm)) {
            // An asm statement: qualifiers, then its operands.
            تقدم_جسر(م);
            طالما (رمز_م_جسر(م).الصنف == 1 && !عند_جسر(م, ك.ك_lparen)) { تقدم_جسر(م); }
            إذا (عند_جسر(م, ك.ك_lparen)) { تخط_متوازن_م_جسر(م); };
            دع ت: منطقي = توقع_جسر(م, ك.ك_semi, «;»);
            أرجع;
        };
        إذا (عند_بعد_جسر(م, 1, ك.ك_colon)) {
            // A label.
            تقدم_جسر(م);
            تقدم_جسر(م);
            حلل_سمات_بلا_تسمية_جسر(م);
            إذا (!عند_جسر(م, ك.ك_rbrace)) { حلل_عنصر_كتلة_جسر(م); };
            أرجع;
        };
    };
    تعبير_جسم_جسر(م);
    إذا (!توقع_جسر(م, ك.ك_semi, «;»)) { زامن_جسر(م); };
}

// Statement attributes (GNU `__attribute__((fallthrough))`, C23 [[...]]).
عام عرف حلل_سمات_بلا_تسمية_جسر(م: &متغير محلل_جسر): فراغ {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    طالما (بداية_سمة_جسر(م) && !عند_جسر(م, ك.ك___asm__) && !عند_جسر(م, ك.ك___asm) && !عند_جسر(م, ك.ك_asm)) {
        دع السمات: متغير سمات_جسر = سمات_فارغة_جسر();
        دع قبل: طبيعي = (*م).الموضع;
        حلل_سمات_جسر(م, &متغير السمات);
        إذا ((*م).الموضع == قبل) { أرجع; };
        دع ت: منطقي = اقبل_جسر(م, ك.ك_semi);
    }
}

// The depth of the innermost open block (0 at file scope).
عرف عمق_النطاق_جسر(م: &محلل_جسر): طبيعي {
    إذا (!(*م).في_جسم) { أرجع 0; };
    أرجع ((الطول((*م).بدايات_النطاقات) مثل طبيعي) / 2) + 1;
}
