        || ي == (*ك).ك__Float128 || ي == (*ك).ك__Float32x || ي == (*ك).ك__Float64x || ي == (*ك).ك___float128
        || ي == (*ك).ك___float80 || ي == (*ك).ك___fp16 || ي == (*ك).ك___bf16 || ي == (*ك).ك__Decimal32
        || ي == (*ك).ك__Decimal64 || ي == (*ك).ك__Decimal128 || ي == (*ك).ك__BitInt || ي == (*ك).ك___int8
