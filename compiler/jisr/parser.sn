            تابع_حلقة;
        } وإلا إذا (!له_نوع && هو_نوع_مسمى_جسر(م, ي)) {
            طابق نوع_مسمى_جسر(م, ي) مع
            | اختياري.موجود(ن) -> { جاهز := ن; }
            | اختياري.لا_شيء -> { };
            له_جاهز := صواب;
        } وإلا {
            اخرج_من_حلقة;
        };
        تقدم_جسر(م);
    }
    دع النوع: متغير طبيعي = ن_صحيح_جسر();
    دع وجد: متغير منطقي = صواب;
    إذا (بتي_ != 0) { النوع := بتي_جسر(&متغير (*م).ج, بتي_, !بلا_إشارة_); }
    وإلا إذا (ص128_) { النوع := صحيح128_جسر(&متغير (*م).ج, !بلا_إشارة_); }
    وإلا إذا (له_جاهز) { النوع := جاهز; }
    وإلا إذا (مركب_) {
        دع الاسم: طبيعي = ك.ك__Complex;
        إذا (عائم_) { النوع := نوع_بلا_صيغة_م_جسر(م, الاسم, 8, 4); }
        وإلا { النوع := نوع_بلا_صيغة_م_جسر(م, الاسم, 16, 8); };
    }
    وإلا إذا (فراغ_) { النوع := ن_فراغ_جسر(); }
    وإلا إذا (منطقي_) { النوع := ن_منطقي_جسر(); }
    وإلا إذا (عائم_) { النوع := ن_عائم_جسر(); }
    وإلا إذا (مزدوج_) { إذا (طويل_ > 0) { النوع := ن_مزدوج_طويل_جسر(); } وإلا { النوع := ن_مزدوج_جسر(); }; }
    وإلا إذا (حرف_) {
        إذا (موقع_) { النوع := ن_حرف_موقع_جسر(); } وإلا إذا (بلا_إشارة_) { النوع := ن_حرف_طبيعي_جسر(); } وإلا { النوع := ن_حرف_جسر(); };
    }
    وإلا إذا (قصير_) { إذا (بلا_إشارة_) { النوع := ن_قصير_طبيعي_جسر(); } وإلا { النوع := ن_قصير_جسر(); }; }
    وإلا إذا (طويل_ >= 2) { إذا (بلا_إشارة_) { النوع := ن_طويل2_طبيعي_جسر(); } وإلا { النوع := ن_طويل2_جسر(); }; }
    وإلا إذا (طويل_ == 1) { إذا (بلا_إشارة_) { النوع := ن_طويل_طبيعي_جسر(); } وإلا { النوع := ن_طويل_جسر(); }; }
    وإلا إذا (صحيح_ || موقع_ || بلا_إشارة_) { إذا (بلا_إشارة_) { النوع := ن_صحيح_طبيعي_جسر(); } وإلا { النوع := ن_صحيح_جسر(); }; }
    وإلا { وجد := خطأ; };
    // __attribute__((mode(...))) picks the integer width.
    إذا (وجد && السمات.الوضع != 0 && صحيح_أو_تعداد_جسر(&(*م).ج, النوع)) {
        دع موقع: منطقي = (*م).ج.الأنواع[بلا_تعداد_جسر(&(*م).ج, النوع)].موقع;
        إذا (السمات.الوضع == 1000) {
            النوع := صحيح128_جسر(&متغير (*م).ج, موقع);
        } وإلا {
            النوع := صحيح_بعرض_جسر(م, السمات.الوضع, موقع);
        };
    };
    إذا (وجد && السمات.حجم_المتجه != 0) {
        النوع := نوع_بلا_صيغة_م_جسر(م, ك.ك_vector_size, السمات.حجم_المتجه, السمات.حجم_المتجه);
    };
    إذا (ثابت) { النوع := بثابت_جسر(&متغير (*م).ج, النوع, صواب); };
    دع الناتج: مواصفات_جسر = {
        النوع: النوع, وجد_نوع: وجد, تعريف_نوع: تعريف_نوع, ساكن: ساكن, خارجي_ص: خارجي_ص, مضمن: مضمن, خيطي: خيطي,
        ثابت_ت: ثابت_ت, السمات: السمات
    };
    أرجع الناتج;
}

// A type name (specifiers and an abstract declarator).
عام عرف حلل_اسم_نوع_جسر(م: &متغير محلل_جسر): طبيعي {
    دع المواصفات: مواصفات_جسر = حلل_مواصفات_جسر(م);
    إذا (!المواصفات.وجد_نوع) {
        شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_اسم_نوع());
        أرجع ن_خطأ_جسر();
    };
    دع المصرح: مصرح_جسر = حلل_مصرحا_جسر(م, المواصفات.النوع);
    أرجع المصرح.النوع;
}

// ---- declarators ----

عام نوع مصرح_جسر = {
    الاسم: طبيعي,
    النوع: طبيعي,
    الملف: طبيعي,
    السطر: طبيعي,
    العمود: طبيعي,
    السمات: سمات_جسر,
    // The token index of the name (a function definition's parameter
    // list follows it).
    موضع_الاسم: طبيعي
};

// Whether a '(' at offset الإزاحة opens a parenthesized declarator rather
// than a parameter list.
عرف بداية_مصرح_متداخل_جسر(م: &محلل_جسر, الإزاحة: طبيعي): منطقي {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع ر: رمز_جسر = رمز_بعد_جسر(م, الإزاحة);
    إذا (ر.الصنف == 5) {
        أرجع ر.المعرف == ك.ك_star || ر.المعرف == ك.ك_caret_block || ر.المعرف == ك.ك_lparen
            || (ر.المعرف == ك.ك_lbracket && عند_بعد_جسر(م, الإزاحة + 1, ك.ك_lbracket));
    };
    إذا (ر.الصنف != 1) { أرجع خطأ; };
    دع ي: طبيعي = ر.المعرف;
    إذا (ي == ك.ك___attribute__ || ي == ك.ك___attribute || ي == ك.ك___declspec || ي == ك.ك___cdecl
        || ي == ك.ك__cdecl || ي == ك.ك___stdcall || ي == ك.ك___fastcall || ي == ك.ك___vectorcall) { أرجع صواب; };
    إذا (هو_نوع_مسمى_جسر(م, ي)) { أرجع خطأ; };
    // A keyword that starts a type: a parameter list.
    أرجع !كلمة_نوع_جسر(م, ي);
}

عرف كلمة_نوع_جسر(م: &محلل_جسر, ي: طبيعي): منطقي {
    دع ك: &كلمات_محلل_جسر = &(*م).ك;
    أرجع ثابت_كلمة_جسر(ك, ي) || مؤهل_مهمل_جسر(ك, ي) || ي == (*ك).ك_void || ي == (*ك).ك_char || ي == (*ك).ك_short
        || ي == (*ك).ك_int || ي == (*ك).ك_long || ي == (*ك).ك_float || ي == (*ك).ك_double || ي == (*ك).ك_signed
        || ي == (*ك).ك_unsigned || ي == (*ك).ك__Bool || ي == (*ك).ك_struct || ي == (*ك).ك_union || ي == (*ك).ك_enum
        || ي == (*ك).ك_register || ي == (*ك).ك___builtin_va_list || ي == (*ك).ك_typeof || ي == (*ك).ك___typeof__
        || ي == (*ك).ك___signed__ || ي == (*ك).ك___int128 || ي == (*ك).ك__Atomic;
}

عام عرف حلل_مصرحا_جسر(م: &متغير محلل_جسر, الأساس: طبيعي): مصرح_جسر {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع النوع: متغير طبيعي = الأساس;
    دع السمات: متغير سمات_جسر = سمات_فارغة_جسر();
    طالما (صواب) {
        حلل_سمات_جسر(م, &متغير السمات);
        إذا (عند_جسر(م, ك.ك_star)) {
            تقدم_جسر(م);
            النوع := مؤشر_إلى_جسر(&متغير (*م).ج, النوع);
            طالما (رمز_م_جسر(م).الصنف == 1) {
                دع ي: طبيعي = رمز_م_جسر(م).المعرف;
                إذا (ثابت_كلمة_جسر(&ك, ي)) { النوع := بثابت_جسر(&متغير (*م).ج, النوع, صواب); تقدم_جسر(م); }
                وإلا إذا (مؤهل_مهمل_جسر(&ك, ي) || ي == ك.ك__Atomic) { تقدم_جسر(م); }
                وإلا إذا (بداية_سمة_جسر(م) && ي != ك.ك___asm__ && ي != ك.ك___asm && ي != ك.ك_asm) { حلل_سمات_جسر(م, &متغير السمات); }
                وإلا { اخرج_من_حلقة; };
            }
            تابع_حلقة;
        };
        إذا (عند_جسر(م, ك.ك_caret_block) && رمز_م_جسر(م).الصنف == 5) {
            // A block pointer (Apple's ^): an address with no SultanC form.
            تقدم_جسر(م);
            النوع := نوع_بلا_صيغة_م_جسر(م, ك.ك_caret_block, (*م).النموذج.عرض_المؤشر / 8, (*م).النموذج.عرض_المؤشر / 8);
            تابع_حلقة;
        };
        اخرج_من_حلقة;
    }
    إذا (عند_جسر(م, ك.ك_lparen) && بداية_مصرح_متداخل_جسر(م, 1)) {
        دع البداية: طبيعي = (*م).الموضع + 1;
        تخط_متوازن_م_جسر(م);
        دع الخارج: طبيعي = لواحق_جسر(م, النوع);
        دع النهاية: طبيعي = (*م).الموضع;
        (*م).الموضع := البداية;
        دع الداخلي: متغير مصرح_جسر = حلل_مصرحا_جسر(م, الخارج);
        دع ت: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
        (*م).الموضع := النهاية;
        حلل_سمات_جسر(م, &متغير الداخلي.السمات);
        ادمج_سمات_جسر(&متغير الداخلي.السمات, &السمات);
        أرجع الداخلي;
    };
    دع الاسم: متغير طبيعي = 0;
    دع الموقع: رمز_جسر = رمز_م_جسر(م);
    دع موضع_الاسم: طبيعي = (*م).الموضع;
    إذا (رمز_م_جسر(م).الصنف == 1 && !بداية_سمة_جسر(م)) {
        الاسم := رمز_م_جسر(م).المعرف;
        تقدم_جسر(م);
    };
    حلل_سمات_جسر(م, &متغير السمات);
    النوع := لواحق_جسر(م, النوع);
    حلل_سمات_جسر(م, &متغير السمات);
    // `int v4 __attribute__((vector_size(16)))`: the attribute after the
    // declarator makes a vector of the arithmetic type too.
    دع ص_ن: ط8 = (*م).ج.الأنواع[النوع].الصنف;
    إذا (السمات.حجم_المتجه != 0 && (ص_ن == 2 || ص_ن == 3 || ص_ن == 4)) {
        النوع := نوع_بلا_صيغة_م_جسر(م, ك.ك_vector_size, السمات.حجم_المتجه, السمات.حجم_المتجه);
    };
    دع الناتج: مصرح_جسر = {
        الاسم: الاسم, النوع: النوع, الملف: الموقع.الملف, السطر: الموقع.السطر, العمود: الموقع.العمود, السمات: السمات,
        موضع_الاسم: موضع_الاسم
    };
    أرجع الناتج;
}

// Array and function suffixes applied to النوع.
عرف لواحق_جسر(م: &متغير محلل_جسر, النوع: طبيعي): طبيعي {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    إذا (عند_جسر(م, ك.ك_lbracket) && !عند_بعد_جسر(م, 1, ك.ك_lbracket)) {
        تقدم_جسر(م);
        طالما (رمز_م_جسر(م).الصنف == 1 && (رمز_م_جسر(م).المعرف == ك.ك_static || ثابت_كلمة_جسر(&ك, رمز_م_جسر(م).المعرف)
            || مؤهل_مهمل_جسر(&ك, رمز_م_جسر(م).المعرف))) { تقدم_جسر(م); }
        دع العدد: متغير طبيعي = 0;
        دع مجهول: متغير منطقي = صواب;
        إذا (!عند_جسر(م, ك.ك_rbracket)) {
            إذا (عند_جسر(م, ك.ك_star) && عند_بعد_جسر(م, 1, ك.ك_rbracket)) {
                تقدم_جسر(م);
            } وإلا {
                دع ق: قيمة_جسر = قيم_ثابتا_جسر(م);
                إذا (ق.ثابت) {
                    إذا ((ق.البتات & 0x8000000000000000) != 0 && (*م).ج.الأنواع[ق.النوع].موقع) {
                        شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_حجم_مصفوفة_سالب());
                    } وإلا {
                        العدد := ق.البتات مثل طبيعي;
                        مجهول := خطأ;
                    };
                };
            };
        };
        دع ت: منطقي = توقع_جسر(م, ك.ك_rbracket, «]»);
        دع الداخلي: طبيعي = لواحق_جسر(م, النوع);
        أرجع مصفوفة_من_جسر(&متغير (*م).ج, الداخلي, العدد, مجهول);
    };
    إذا (عند_جسر(م, ك.ك_lparen)) {
        تقدم_جسر(م);
        دع المعطيات: متغير متجه طبيعي = [];
        دع متغير_م: متغير منطقي = خطأ;
        دع بلا_نموذج: متغير منطقي = خطأ;
        إذا (عند_جسر(م, ك.ك_rparen)) {
            بلا_نموذج := صواب;
            تقدم_جسر(م);
        } وإلا إذا (عند_جسر(م, ك.ك_void) && عند_بعد_جسر(م, 1, ك.ك_rparen)) {
            تقدم_جسر(م);
            تقدم_جسر(م);
        } وإلا إذا (رمز_م_جسر(م).الصنف == 1 && !بداية_نوع_جسر(م) && !بداية_سمة_جسر(م)
            && (عند_بعد_جسر(م, 1, ك.ك_comma) || عند_بعد_جسر(م, 1, ك.ك_rparen))) {
            // An identifier list (an old-style definition): no prototype.
            بلا_نموذج := صواب;
            (*م).الموضع := (*م).الموضع - 1;
            تخط_متوازن_م_جسر(م);
            دع لا_معطيات: متجه طبيعي = [];
            دع الدالة: طبيعي = دالة_جسر(&متغير (*م).ج, النوع, &لا_معطيات, خطأ, صواب);
            (*م).ج.الأنواع[الدالة].قائمة_معرفات := صواب;
            أرجع الدالة;
        } وإلا {
            طالما (!نهاية_جسر(م)) {
                إذا (اقبل_جسر(م, ك.ك_ellipsis)) { متغير_م := صواب; اخرج_من_حلقة; };
                دع المواصفات: مواصفات_جسر = حلل_مواصفات_جسر(م);
                إذا (!المواصفات.وجد_نوع) {
                    إذا (رمز_م_جسر(م).الصنف == 1) {
                        دع الاسم: نص = اسم_م_جسر(م, رمز_م_جسر(م).المعرف);
                        شخص_هنا_رمز_جسر(م, سبب_تشخيص.سبب_سي_اسم_نوع_مجهول(), الاسم);
                    } وإلا {
                        شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_تصريح_معامل());
                    };
                    // To the end of this parameter list.
                    طالما (!نهاية_جسر(م) && !عند_جسر(م, ك.ك_rparen)) {
                        إذا (عند_جسر(م, ك.ك_lparen)) { تخط_متوازن_م_جسر(م); } وإلا { تقدم_جسر(م); };
                    }
                    ألحق(المعطيات, ن_خطأ_جسر());
                    اخرج_من_حلقة;
                };
                دع المصرح: مصرح_جسر = حلل_مصرحا_جسر(م, المواصفات.النوع);
                ألحق(المعطيات, عدل_معطى_جسر(م, المصرح.النوع));
                إذا (!اقبل_جسر(م, ك.ك_comma)) { اخرج_من_حلقة; };
            }
            دع ت: منطقي = توقع_جسر(م, ك.ك_rparen, «)»);
        };
        أرجع دالة_جسر(&متغير (*م).ج, النوع, &المعطيات, متغير_م, بلا_نموذج);
    };
    أرجع النوع;
}

// A parameter's type: an array is a pointer to its element, a function a
// pointer to the function (C17 6.7.6.3p7-8).
عام عرف عدل_معطى_جسر(م: &متغير محلل_جسر, النوع: طبيعي): طبيعي {
    دع ن: نوع_سي_جسر = (*م).ج.الأنواع[النوع];
    إذا (ن.الصنف == 6) { أرجع مؤشر_إلى_جسر(&متغير (*م).ج, ن.الأساس); };
    إذا (ن.الصنف == 7) { أرجع مؤشر_إلى_جسر(&متغير (*م).ج, النوع); };
    إذا (ن.الصنف == 11 && (*م).النموذج.صنف_قائمة_المعاملات == 1) {
        // An array va_list decays to a pointer to its structure.
        أرجع مؤشر_إلى_جسر(&متغير (*م).ج, نوع_بلا_صيغة_م_جسر(م, (*م).ك.ك___builtin_va_list,
            (*م).النموذج.حجم_قائمة_المعاملات, (*م).النموذج.عرض_المؤشر / 8));
    };
    أرجع النوع;
}

// ---- struct, union, enum ----

عرف حلل_بنية_جسر(م: &متغير محلل_جسر, اتحاد: منطقي): طبيعي {
    دع ك: كلمات_محلل_جسر = (*م).ك;
    دع الكلمة: رمز_جسر = رمز_م_جسر(م);
    تقدم_جسر(م);
    دع السمات: متغير سمات_جسر = سمات_فارغة_جسر();
    حلل_سمات_جسر(م, &متغير السمات);
    دع الاسم: متغير طبيعي = 0;
    دع موقع_الاسم: متغير رمز_جسر = الكلمة;
    إذا (رمز_م_جسر(م).الصنف == 1) {
        الاسم := رمز_م_جسر(م).المعرف;
        موقع_الاسم := رمز_م_جسر(م);
        تقدم_جسر(م);
    };
    حلل_سمات_جسر(م, &متغير السمات);
    دع الصنف: متغير ط8 = 8;
    إذا (اتحاد) { الصنف := 9; };
    إذا (!عند_جسر(م, ك.ك_lbrace)) {
        إذا (الاسم == 0) {
            شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_اسم_وسم());
            أرجع ن_خطأ_جسر();
        };
        دع الموجود: طبيعي = ربط_وسم_جسر(م, الاسم);
        إذا (الموجود != 0 && (*م).ج.الوسوم[الموجود].الصنف == الصنف) { أرجع (*م).نوع_الوسم[الموجود]; };
        إذا (الموجود != 0) {
            شخص_م_سابق_جسر(م, سبب_تشخيص.سبب_سي_صنف_وسم_مختلف(), &موقع_الاسم, اسم_م_جسر(م, الاسم),
                (*م).ج.الوسوم[الموجود].الملف, (*م).ج.الوسوم[الموجود].السطر, (*م).ج.الوسوم[الموجود].العمود);
        };
        دع الوسم: طبيعي = وسم_جديد_م_جسر(م, الصنف, الاسم, &موقع_الاسم);
        أرجع (*م).نوع_الوسم[الوسم];
    };
    // A definition.
    دع الوسم: متغير طبيعي = 0;
    دع الموجود: طبيعي = ربط_وسم_جسر(م, الاسم);
    // A tag of an enclosing block is shadowed by a definition, not completed.
    دع في_النطاق: منطقي = الموجود != 0 && (*م).ج.الوسوم[الموجود].العمق == عمق_النطاق_جسر(م);
    إذا (الاسم != 0 && في_النطاق && (*م).ج.الوسوم[الموجود].الصنف == الصنف && !(*م).ج.الوسوم[الموجود].مكتمل) {
        الوسم := الموجود;
        (*م).ج.الوسوم[الوسم].ملف_ناقص := (*م).ج.الوسوم[الوسم].الملف + 1;
        (*م).ج.الوسوم[الوسم].الملف := موقع_الاسم.الملف;
        (*م).ج.الوسوم[الوسم].السطر := موقع_الاسم.السطر;
        (*م).ج.الوسوم[الوسم].العمود := موقع_الاسم.العمود;
    } وإلا {
        إذا (الاسم != 0 && في_النطاق && (*م).ج.الوسوم[الموجود].مكتمل) {
            شخص_م_سابق_جسر(م, سبب_تشخيص.سبب_سي_إعادة_تعريف(), &موقع_الاسم, اسم_م_جسر(م, الاسم),
                (*م).ج.الوسوم[الموجود].الملف, (*م).ج.الوسوم[الموجود].السطر, (*م).ج.الوسوم[الموجود].العمود);
        };
        الوسم := وسم_جديد_م_جسر(م, الصنف, الاسم, &موقع_الاسم);
    };
    تقدم_جسر(م);
    دع الحقول: متغير متجه حقل_سي_جسر = [];
    دع السابق: متغير طبيعي = 0xFFFFFFFFFFFFFFFF;
    طالما (!نهاية_جسر(م) && !عند_جسر(م, ك.ك_rbrace)) {
        // Recovery that stopped at a stray `)` or `]` makes no progress:
        // that token is passed over.
        إذا ((*م).الموضع == السابق) { تقدم_جسر(م); تابع_حلقة; };
        السابق := (*م).الموضع;
        استهلك_حزما_جسر(م);
        إذا (اقبل_جسر(م, ك.ك_semi)) { تابع_حلقة; };
        إذا (عند_جسر(م, ك.ك__Static_assert) || عند_جسر(م, ك.ك_static_assert)) { حلل_تأكيدا_جسر(م); تابع_حلقة; };
        دع المواصفات: مواصفات_جسر = حلل_مواصفات_جسر(م);
        إذا (!المواصفات.وجد_نوع) {
            إذا (رمز_م_جسر(م).الصنف == 1) {
                دع الاسم_ن: نص = اسم_م_جسر(م, رمز_م_جسر(م).المعرف);
                شخص_هنا_رمز_جسر(م, سبب_تشخيص.سبب_سي_اسم_نوع_مجهول(), الاسم_ن);
            } وإلا {
                شخص_هنا_جسر(م, سبب_تشخيص.سبب_سي_نحوي_متوقع_تصريح_عضو());
            };
            زامن_جسر(م);
            تابع_حلقة;
        };
        إذا (اقبل_جسر(م, ك.ك_semi)) {
            // An anonymous struct or union member (C11).
            دع ن: نوع_سي_جسر = (*م).ج.الأنواع[المواصفات.النوع];
            إذا ((ن.الصنف == 8 || ن.الصنف == 9) && (*م).ج.الوسوم[ن.الوسم].الاسم == 0) {
                ألحق(الحقول, حقل_جسر(0, المواصفات.النوع, خطأ, 0, &المواصفات.السمات));
            };
            تابع_حلقة;
        };
        طالما (!نهاية_جسر(م)) {
            دع الاسم_ح: متغير طبيعي = 0;
            دع النوع_ح: متغير طبيعي = المواصفات.النوع;
            دع السمات_ح: متغير سمات_جسر = سمات_فارغة_جسر();
            ادمج_سمات_جسر(&متغير السمات_ح, &المواصفات.السمات);
            دع موقع_ح: رمز_جسر = رمز_م_جسر(م);
            إذا (!عند_جسر(م, ك.ك_colon)) {
                دع المصرح: مصرح_جسر = حلل_مصرحا_جسر(م, المواصفات.النوع);
                الاسم_ح := المصرح.الاسم;
                النوع_ح := المصرح.النوع;
                ادمج_سمات_جسر(&متغير السمات_ح, &المصرح.السمات);
            };
            دع بتي: متغير منطقي = خطأ;
            دع العرض: متغير طبيعي = 0;
            إذا (اقبل_جسر(م, ك.ك_colon)) {
                بتي := صواب;
                دع ق: قيمة_جسر = قيم_ثابتا_جسر(م);
                إذا (ق.ثابت) { العرض := ق.البتات مثل طبيعي; };
                دع الأساس: طبيعي = بلا_تعداد_جسر(&(*م).ج, النوع_ح);
                دع ن: نوع_سي_جسر = (*م).ج.الأنواع[الأساس];
                إذا (ن.الصنف != 2 && ن.الصنف != 3) {
                    شخص_م_جسر(م, سبب_تشخيص.سبب_سي_حقل_بتي_غير_صحيح(), &موقع_ح);
                } وإلا إذا (ق.ثابت && ((ق.البتات & 0x8000000000000000) != 0 || العرض > ن.العرض)) {
                    دع ت_ع: متغير تشخيص_جسر = تشخيص_م_جسر(م, سبب_تشخيص.سبب_سي_حقل_بتي_عريض(), &موقع_ح);
                    أضف_طول_سي(&متغير ت_ع.السجل, العرض);
                    شخص_ت_م_جسر(م, ت_ع);
                    العرض := ن.العرض;
                };
                حلل_سمات_جسر(م, &متغير السمات_ح);
            };
            ألحق(الحقول, حقل_جسر(الاسم_ح, النوع_ح, بتي, العرض, &السمات_ح));
            إذا (!اقبل_جسر(م, ك.ك_comma)) { اخرج_من_حلقة; };
        }
        إذا (!توقع_جسر(م, ك.ك_semi, «;»)) { زامن_جسر(م); };
    }
    دع ت: منطقي = توقع_جسر(م, ك.ك_rbrace, «}»);
    حلل_سمات_جسر(م, &متغير السمات);
