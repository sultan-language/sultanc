// Declarations several C imports of one compilation share.
//
// Every C import is its own SultanC module, and a name that two imported
// modules declare is ambiguous where it is used. C imports overlap often:
// stdio.h and stdlib.h both declare size_t, two project headers both
// include <stdint.h>, two .c files take the same record from one header.
// A declaration that an earlier C import under the same source root (and
// for the same target) already exports is therefore left to that module:
// this module imports it (a plain relative quoted import) instead of
// declaring the name again, so the program has one declaration and one
// type. The frontend makes a C module's public names include those of the
// C modules it imports plainly (compiler/frontend/names/modules.sn), so an
// importer of only this C import still sees the shared names, and an
// importer of both sees one symbol, not two.
//
// Two declarations are the same when their SultanC text is the same; for
// records that is C's own rule for types of separate translation units
// (same tag, same members: C11 6.2.7).
استورد std.text.search;
استورد std.text.transform;
استورد std.fs.path;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.fs.canonical;
استورد std.text.substring;
استورد compiler.jisr.core;

نوع تصريح_مشترك_جسر = {
    الهاش: طبيعي,
    النص: نص,
    // The declared SultanC name.
    الاسم: نص,
    // 1 + the index of the exporting module in وحدات_مشتركة_جسر.
    المصدر: طبيعي
};

نوع وحدة_مشتركة_جسر = { المسار: نص, الجذر: نص, الهدف: نص };

دع تصريحات_مشتركة_جسر: متغير متجه تصريح_مشترك_جسر = [];
دع وحدات_مشتركة_جسر: متغير متجه وحدة_مشتركة_جسر = [];
// The module being written: 1 + its index, 0 when it shares nothing.
دع الوحدة_الجارية_جسر: متغير طبيعي = 0;

// The C import at المسار (its module's path: the source root joined with
// the import's logical path) under الجذر, for الهدف, is being written. An
// empty root (a path read outside module loading) shares nothing.
عام عرف ابدأ_وحدة_مشتركة_جسر(المسار: &نص, الجذر: &نص, الهدف: &نص): فراغ {
    دع المسار_ن: نص = مسار_مطلق_جسر(المسار);
    دع الجذر_ن: نص = مسار_مطلق_جسر(الجذر);
    غير_آمن {
        الوحدة_الجارية_جسر := 0;
        إذا ((الطول(الجذر_ن) مثل طبيعي) == 0 || !مسار_قابل_للاستيراد_جسر(&المسار_ن)
            || فيه_صعود_جسر(&المسار_ن) || فيه_صعود_جسر(&الجذر_ن)
            || !تحت_الجذر_جسر(&المسار_ن, &الجذر_ن)) { أرجع; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(وحدات_مشتركة_جسر) مثل طبيعي)) {
            دع الوحدة: &وحدة_مشتركة_جسر = &وحدات_مشتركة_جسر[ف];
            إذا (نصان_متساويان(&(*الوحدة).المسار, &المسار_ن) && نصان_متساويان(&(*الوحدة).الهدف, الهدف)) {
                الوحدة_الجارية_جسر := ف + 1;
                أرجع;
            };
            ف := ف + 1;
        }
        دع الجديدة: وحدة_مشتركة_جسر = { المسار: المسار_ن, الجذر: الجذر_ن, الهدف: انسخ_نص(الهدف) };
        ألحق(وحدات_مشتركة_جسر, الجديدة);
        الوحدة_الجارية_جسر := الطول(وحدات_مشتركة_جسر) مثل طبيعي;
    }
}

عام عرف أنه_وحدة_مشتركة_جسر(): فراغ {
    غير_آمن { الوحدة_الجارية_جسر := 0; }
}

// A path written inside a quoted import as it is.
عرف مسار_قابل_للاستيراد_جسر(المسار: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المسار) مثل طبيعي)) {
        دع ب: ط8 = (*المسار)[ف];
        إذا (ب == 0x22 || ب == 0x5C || ب < 0x20) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// ---- paths ----

// Whether the normalized المسار is below the normalized root الجذر.
عرف تحت_الجذر_جسر(المسار: &نص, الجذر: &نص): منطقي {
    دع نقطة: نص = «.»;
    إذا (نصان_متساويان(الجذر, &نقطة)) {
        أرجع (الطول(*المسار) مثل طبيعي) > 0 && (*المسار)[0] != 0x2F && !يبدأ_بـ(المسار, &«..»)
            && !نصان_متساويان(المسار, &نقطة);
    };
    أرجع يبدأ_بـ(المسار, &صل_نصين(الجذر, &«/»));
}

// المسار made absolute (against the working directory) and normalized
// lexically by std.fs (std keeps `..`: a link's `..` need not be its
// parent); empty when it is empty.
عرف مسار_مطلق_جسر(المسار: &نص): نص {
    إذا ((الطول(*المسار) مثل طبيعي) == 0) { أرجع «»; };
    طابق حول_إلى_مسار_مطلق(المسار) مع
    | نتيجة.نجح(المطلق) -> { أرجع المطلق; }
    | نتيجة.خطأ(_) -> { أرجع طبع_المسار(المسار); };
}

// Whether a normalized path has a `..` component (its place under a root
// is then not known lexically, and nothing is shared through it).
عرف فيه_صعود_جسر(المسار: &نص): منطقي {
    دع المكونات: متجه نص = مكونات_المسار(المسار);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المكونات) مثل طبيعي)) {
        إذا (نصان_متساويان(&المكونات[ف], &«..»)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The quoted import path of الهدف from the module at المصدر: std's
// lexical relative path from المصدر's directory, written with `/` as import
// paths are. Both are normalized paths under one source root with no `..`
// (ابدأ_وحدة_مشتركة_جسر), so it always exists; otherwise الهدف as is.
عام عرف مسار_نسبي_جسر(المصدر: &نص, الهدف: &نص): نص {
    دع الدليل: متغير نص = «.»;
    طابق أب_المسار_بصيغة(المصدر, صيغة_مسار.يونكس()) مع
    | اختياري.موجود(الأب) -> { الدليل := الأب; }
    | اختياري.لا_شيء -> { };
    طابق مسار_نسبي_من_بصيغة(&الدليل, الهدف, صيغة_مسار.يونكس()) مع
    | اختياري.موجود(النسبي) -> { أرجع النسبي; }
    | اختياري.لا_شيء -> { أرجع انسخ_نص(الهدف); };
}

// ---- declarations ----

// The name a `public …` declaration line declares.
عرف اسم_تصريح_جسر(السطر: &نص): نص {
    دع ف: متغير طبيعي = 7;
    إذا (يبدأ_بـ(السطر, &«public extern »)) { ف := 14; };
    دع ن: طبيعي = الطول(*السطر) مثل طبيعي;
    // The keyword (type, def, let), then the name.
    طالما (ف < ن && (*السطر)[ف] != 0x20) { ف := ف + 1; }
    ف := ف + 1;
    دع البداية: طبيعي = ف;
    طالما (ف < ن) {
        دع ب: ط8 = (*السطر)[ف];
        إذا (ب == 0x20 || ب == 0x3D || ب == 0x28 || ب == 0x3A || ب == 0x3B) { اخرج_من_حلقة; };
        ف := ف + 1;
    }
    إذا (البداية >= ن) { أرجع «»; };
    إذا ((ف) > (البداية)) {
        طابق مقطع_نص(السطر, البداية, (ف) - (البداية)) مع
        | اختياري.موجود(المقطع_ن) -> { أرجع المقطع_ن; }
        | اختياري.لا_شيء -> { };
    };
    أرجع «»;
}

// A module (other than the current one, under its root and for its target)
// that exports السطر; 0 when none.
عرف مصدر_مشترك_جسر(الهاش: طبيعي, السطر: &نص, الجارية_ف: طبيعي): طبيعي {
    دع الجارية: وحدة_مشتركة_جسر = وحدة_مشتركة_رقم_جسر(الجارية_ف);
    دع المرشحون: متغير متجه طبيعي = [];
    غير_آمن {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(تصريحات_مشتركة_جسر) مثل طبيعي)) {
            دع التصريح: &تصريح_مشترك_جسر = &تصريحات_مشتركة_جسر[ف];
            ف := ف + 1;
            إذا ((*التصريح).المصدر == الجارية_ف || (*التصريح).الهاش != الهاش || !نصان_متساويان(&(*التصريح).النص, السطر)) { تابع_حلقة; };
            دع المصدرة: &وحدة_مشتركة_جسر = &وحدات_مشتركة_جسر[(*التصريح).المصدر - 1];
            إذا (نصان_متساويان(&(*المصدرة).الجذر, &الجارية.الجذر) && نصان_متساويان(&(*المصدرة).الهدف, &الجارية.الهدف)) {
                ألحق(المرشحون, (*التصريح).المصدر);
            };
        }
    }
    إذا ((الطول(المرشحون) مثل طبيعي) > 0) { أرجع المرشحون[0]; };
    أرجع 0;
}

// Whether a module in المصادر other than المصدر exports الاسم with another
// text: importing both would make الاسم ambiguous inside the module.
عرف اسم_متعارض_جسر(الاسم: &نص, السطر: &نص, المصدر: طبيعي, المصادر: &متجه طبيعي): منطقي {
    غير_آمن {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(تصريحات_مشتركة_جسر) مثل طبيعي)) {
            دع التصريح: &تصريح_مشترك_جسر = &تصريحات_مشتركة_جسر[ف];
            ف := ف + 1;
            إذا ((*التصريح).المصدر == المصدر || !نصان_متساويان(&(*التصريح).الاسم, الاسم)) { تابع_حلقة; };
            إذا (نصان_متساويان(&(*التصريح).النص, السطر)) { تابع_حلقة; };
            إذا (يحوي_رقما_جسر(المصادر, (*التصريح).المصدر)) { أرجع صواب; };
        }
    }
    أرجع خطأ;
}

عرف يحوي_رقما_جسر(القائمة: &متجه طبيعي, الرقم: طبيعي): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا ((*القائمة)[ف] == الرقم) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}


// The declarations of the module being written (whole lines), with those
// another C import exports left to it: the
// imports of those modules first, then the declarations this module
// writes. Its public declarations are recorded as exported by it.
عام عرف شارك_تصريحات_جسر(التصريحات: &متجه ط8): متجه ط8 {
    دع الجارية_ف: متغير طبيعي = 0;
    غير_آمن { الجارية_ف := الوحدة_الجارية_جسر; }
    إذا (الجارية_ف == 0) {
        دع النسخة: متغير متجه ط8 = [];
        ألحق_من(النسخة, التصريحات, 0, الطول(*التصريحات) مثل طبيعي);
        أرجع النسخة;
    };
    دع الجارية: وحدة_مشتركة_جسر = وحدة_مشتركة_رقم_جسر(الجارية_ف);
    دع التصريحات_ن: نص = من_بايتات(التصريحات);
    دع الأسطر: متجه نص = أسطر_النص(&التصريحات_ن);
    دع العدد: طبيعي = الطول(الأسطر) مثل طبيعي;
    // Each line's source: 0 written here, else 1 + the module left to.
    دع المصادر_س: متغير متجه طبيعي = [];
    دع الهاشات: متغير متجه طبيعي = [];
    دع المصادر: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع السطر: &نص = &الأسطر[ف];
        دع الهاش: طبيعي = هاش_مقطع_جسر(السطر, 0, الطول(*السطر) مثل طبيعي);
        ألحق(الهاشات, الهاش);
        دع المصدر: متغير طبيعي = 0;
        إذا (يبدأ_بـ(السطر, &«public »)) {
            المصدر := مصدر_مشترك_جسر(الهاش, السطر, الجارية_ف);
        };
        ألحق(المصادر_س, المصدر);
        إذا (المصدر != 0 && !يحوي_رقما_جسر(&المصادر, المصدر)) { ألحق(المصادر, المصدر); };
        ف := ف + 1;
    }
    // Left to its module, kept privately (a name two of those modules
    // export differently stays this module's), or written and recorded.
    دع المستوردة: متغير متجه طبيعي = [];
    دع الناتج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < العدد) {
        دع السطر: &نص = &الأسطر[ف];
        دع المصدر: طبيعي = المصادر_س[ف];
        ف := ف + 1;
        إذا (المصدر != 0) {
            دع الاسم: نص = اسم_تصريح_جسر(السطر);
            إذا (!اسم_متعارض_جسر(&الاسم, السطر, المصدر, &المصادر)) {
                إذا (!يحوي_رقما_جسر(&المستوردة, المصدر)) { ألحق(المستوردة, المصدر); };
                تابع_حلقة;
            };
            طابق مقطع_نص(السطر, 7, (الطول(*السطر) مثل طبيعي) - 7) مع
            | اختياري.موجود(الباقي) -> { ألحق_بايتات_نص(&متغير الناتج, الباقي); }
            | اختياري.لا_شيء -> { };
            ألحق(الناتج, 10);
            تابع_حلقة;
        };
        إذا (يبدأ_بـ(السطر, &«public »)) {
            سجل_تصريحا_جسر(الهاشات[ف - 1], السطر, اسم_تصريح_جسر(السطر), الجارية_ف);
        };
        ألحق_بايتات_نص(&متغير الناتج, انسخ_نص(السطر));
        ألحق(الناتج, 10);
    }
    دع الاستيرادات: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < (الطول(المستوردة) مثل طبيعي)) {
        دع المصدرة: وحدة_مشتركة_جسر = وحدة_مشتركة_رقم_جسر(المستوردة[ف]);
        ألحق_بايتات_نص(&متغير الاستيرادات, «import "»);
        ألحق_بايتات_نص(&متغير الاستيرادات, مسار_نسبي_جسر(&الجارية.المسار, &المصدرة.المسار));
        ألحق_بايتات_نص(&متغير الاستيرادات, «";  // declarations this C import shares with it»);
        ألحق(الاستيرادات, 10);
        ف := ف + 1;
    }
    ألحق_من(الاستيرادات, &الناتج, 0, الطول(الناتج) مثل طبيعي);
    أرجع الاستيرادات;
}

// A copy of module الرقم (1 + its index).
عرف وحدة_مشتركة_رقم_جسر(الرقم: طبيعي): وحدة_مشتركة_جسر {
    دع الناتج: متغير وحدة_مشتركة_جسر = { المسار: «», الجذر: «», الهدف: «» };
    غير_آمن {
        دع الوحدة: &وحدة_مشتركة_جسر = &وحدات_مشتركة_جسر[الرقم - 1];
        دع النسخة: وحدة_مشتركة_جسر = { المسار: انسخ_نص(&(*الوحدة).المسار), الجذر: انسخ_نص(&(*الوحدة).الجذر), الهدف: انسخ_نص(&(*الوحدة).الهدف) };
        الناتج := النسخة;
    }
    أرجع الناتج;
}

عرف سجل_تصريحا_جسر(الهاش: طبيعي, السطر: &نص, الاسم: نص, المصدر: طبيعي): فراغ {
    غير_آمن {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(تصريحات_مشتركة_جسر) مثل طبيعي)) {
            دع التصريح: &تصريح_مشترك_جسر = &تصريحات_مشتركة_جسر[ف];
            إذا ((*التصريح).المصدر == المصدر && (*التصريح).الهاش == الهاش && نصان_متساويان(&(*التصريح).النص, السطر)) { أرجع; };
            ف := ف + 1;
        }
        دع الجديد: تصريح_مشترك_جسر = { الهاش: الهاش, النص: انسخ_نص(السطر), الاسم: الاسم, المصدر: المصدر };
        ألحق(تصريحات_مشتركة_جسر, الجديد);
    }
}

