// Several C translation units as one SultanC module: `import "a.c+b.c"`.
//
// Each .c file is read, parsed and compiled on its own (its own
// preprocessor state and statics, as a C compiler does), and the modules
// are joined:
// - the names a compiled unit keeps to itself (`ج_…` for its functions,
//   data block and helpers, `خ_…` for the C functions it calls) get the
//   unit's number (`ج1_…`), so two units never share one;
// - a declaration that several units write (the records, typedefs,
//   constants and prototypes of a header they include, a tentative
//   definition `int x;`) is written once;
// - a C function a unit calls and another unit defines is called directly:
//   the unit's external declaration of it becomes a SultanC function that
//   calls the defining unit's (C signature) function. A call of a variadic
//   one puts its variadic arguments in 8-byte slots and calls the defining
//   unit's slot entry (ج_متغيرة_NAME, lower.sn), as a call inside one unit
//   does.
استورد std.text.transform;
استورد std.text.search;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.text.number;
استورد std.text.radix;
استورد std.chars.ascii;
استورد std.text.substring;
استورد compiler.jisr.core;

// النص with each identifier that starts with `ج_` or `خ_` (outside string
// literals and comments) given the unit number الرقم after its letter, and
// `jisr_c_errors` numbered too.
عرف رقم_أسماء_الوحدة_جسر(النص: &نص, الرقم: طبيعي): متجه ط8 {
    دع الرقم_ن: نص = طبيعي_إلى_نص(الرقم);
    دع الناتج: متغير متجه ط8 = [];
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    دع في_نص: متغير منطقي = خطأ;
    دع في_تعليق: متغير منطقي = خطأ;
    طالما (ف < ن) {
        دع ب: ط8 = (*النص)[ف];
        إذا (في_تعليق) {
            إذا (ب == 10) { في_تعليق := خطأ; };
            ألحق(الناتج, ب);
            ف := ف + 1;
            تابع_حلقة;
        };
        إذا (في_نص) {
            ألحق(الناتج, ب);
            إذا (ب == 0x5C && ف + 1 < ن) { ألحق(الناتج, (*النص)[ف + 1]); ف := ف + 2; تابع_حلقة; };
            إذا (ب == 0x22) { في_نص := خطأ; };
            ف := ف + 1;
            تابع_حلقة;
        };
        إذا (ب == 0x22) { في_نص := صواب; ألحق(الناتج, ب); ف := ف + 1; تابع_حلقة; };
        إذا (ب == 0x2F && ف + 1 < ن && (*النص)[ف + 1] == 0x2F) { في_تعليق := صواب; ألحق(الناتج, ب); ف := ف + 1; تابع_حلقة; };
        // An identifier starts here unless the byte before continues one: an
        // ASCII letter, digit or `_`, or a byte of a character beyond ASCII.
        دع بداية: متغير منطقي = صواب;
        إذا (ف > 0) {
            دع السابق: ط8 = (*النص)[ف - 1];
            بداية := !(حرف_أو_رقم_أسكي(السابق) || السابق == 0x5F || !محرف_أسكي(السابق));
        };
        // ج is D8 AC and خ is D8 AE in UTF-8.
        إذا (بداية && ب == 0xD8 && ف + 2 < ن && ((*النص)[ف + 1] == 0xAC || (*النص)[ف + 1] == 0xAE) && (*النص)[ف + 2] == 0x5F) {
            ألحق(الناتج, ب);
            ألحق(الناتج, (*النص)[ف + 1]);
            ألحق_بايتات_نص(&متغير الناتج, انسخ_نص(&الرقم_ن));
            ف := ف + 2;
            تابع_حلقة;
        };
        إذا (بداية && يطابق_عند(النص, ف, «jisr_c_errors»)) {
            ألحق_بايتات_نص(&متغير الناتج, «jisr_c_errors_»);
            ألحق_بايتات_نص(&متغير الناتج, انسخ_نص(&الرقم_ن));
            ف := ف + 13;
            تابع_حلقة;
        };
        ألحق(الناتج, ب);
        ف := ف + 1;
    }
    أرجع الناتج;
}



// The name after `public def ` / `extern def ` up to `(`.
عرف اسم_بعد_جسر(السطر: &نص, البداية: طبيعي): نص {
    دع ف: متغير طبيعي = البداية;
    دع ن: طبيعي = الطول(*السطر) مثل طبيعي;
    طالما (ف < ن && (*السطر)[ف] != 0x28 && (*السطر)[ف] != 0x3A && (*السطر)[ف] != 0x20) { ف := ف + 1; }
    إذا ((ف) > (البداية)) {
        طابق مقطع_نص(السطر, البداية, (ف) - (البداية)) مع
        | اختياري.موجود(المقطع_ن) -> { أرجع المقطع_ن; }
        | اختياري.لا_شيء -> { };
    };
    أرجع «»;
}

// A one-line public declaration (type, extern, constant): written once.
عرف تصريح_سطر_جسر(السطر: &نص): منطقي {
    أرجع (يبدأ_بـ(السطر, &«public type ») || يبدأ_بـ(السطر, &«public extern ») || يبدأ_بـ(السطر, &«public let »)
        || يبدأ_بـ(السطر, &«import »));
}

// An external declaration `extern def خN_K_NAME(PARAMS): RESULT = "LINK";`
// of a function الأسماء defines, as a SultanC function calling it; empty
// when it is not one.
عرف نداء_بين_الوحدات_جسر(السطر: &نص, الأسماء: &متجه نص): نص {
    إذا (!يبدأ_بـ(السطر, &«extern def »)) { أرجع «»; };
    دع ن: طبيعي = الطول(*السطر) مثل طبيعي;
    // The link name: the last quoted text.
    إذا (ن < 3 || (*السطر)[ن - 1] != 0x3B || (*السطر)[ن - 2] != 0x22) { أرجع «»; };
    دع نهاية_الرابط: طبيعي = ن - 2;
    دع بداية_الرابط: متغير طبيعي = نهاية_الرابط;
    طالما (بداية_الرابط > 0 && (*السطر)[بداية_الرابط - 1] != 0x22) { بداية_الرابط := بداية_الرابط - 1; }
    دع الرابط: متغير نص = «»;
    إذا ((نهاية_الرابط) > (بداية_الرابط)) {
        طابق مقطع_نص(السطر, بداية_الرابط, (نهاية_الرابط) - (بداية_الرابط)) مع
        | اختياري.موجود(المقطع_ن) -> { الرابط := المقطع_ن; }
        | اختياري.لا_شيء -> { الرابط := «»; };
    };
    // A variadic call shape stays external.
    دع ف: متغير طبيعي = 0;
    طالما (ف + 2 < (الطول(الرابط) مثل طبيعي)) {
        إذا (الرابط[ف] == 0x2E && الرابط[ف + 1] == 0x2E && الرابط[ف + 2] == 0x2E) { أرجع «»; };
        ف := ف + 1;
    }
    دع المعرف: متغير نص = «»;
    دع الشرطة: نص = صل_نصين(&الرابط, &«_»);
    ف := 0;
    طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الأسماء)[ف], &الرابط)) { المعرف := انسخ_نص(&الرابط); };
        ف := ف + 1;
    }
    إذا ((الطول(المعرف) مثل طبيعي) == 0) {
        ف := 0;
        طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
            إذا (نصان_متساويان(&(*الأسماء)[ف], &الشرطة)) { المعرف := انسخ_نص(&الشرطة); };
            ف := ف + 1;
        }
    };
    إذا ((الطول(المعرف) مثل طبيعي) == 0) { أرجع «»; };
    // `extern def NAME(PARAMS): RESULT = "LINK";`
    دع الاسم: نص = اسم_بعد_جسر(السطر, 11);
    دع فتح: طبيعي = 11 + (الطول(الاسم) مثل طبيعي);
    إذا (فتح >= ن || (*السطر)[فتح] != 0x28) { أرجع «»; };
    // The matching `)`.
    دع العمق: متغير طبيعي = 0;
    دع إغلاق: متغير طبيعي = فتح;
    طالما (إغلاق < ن) {
        دع ب: ط8 = (*السطر)[إغلاق];
        إذا (ب == 0x28) { العمق := العمق + 1; }
        وإلا إذا (ب == 0x29) { العمق := العمق - 1; إذا (العمق == 0) { اخرج_من_حلقة; }; };
        إذا (ب == 0x22) { أرجع «»; };
        إغلاق := إغلاق + 1;
    }
    إذا (إغلاق >= ن) { أرجع «»; };
    دع المعاملات: متغير نص = «»;
    إذا ((إغلاق) > (فتح + 1)) {
        طابق مقطع_نص(السطر, فتح + 1, (إغلاق) - (فتح + 1)) مع
        | اختياري.موجود(المقطع_ن) -> { المعاملات := المقطع_ن; }
        | اختياري.لا_شيء -> { المعاملات := «»; };
    };
    // `): RESULT = "`
    إذا (إغلاق + 3 >= ن || (*السطر)[إغلاق + 1] != 0x3A) { أرجع «»; };
    دع الناتج: متغير نص = «»;
    إذا ((بداية_الرابط - 4) > (إغلاق + 3)) {
        طابق مقطع_نص(السطر, إغلاق + 3, (بداية_الرابط - 4) - (إغلاق + 3)) مع
        | اختياري.موجود(المقطع_ن) -> { الناتج := المقطع_ن; }
        | اختياري.لا_شيء -> { الناتج := «»; };
    };
    // The arguments: each parameter's name (before `:` at depth 0).
    دع الحجج: متغير متجه ط8 = [];
    دع م_: &نص = &المعاملات;
    دع ل: طبيعي = الطول(*م_) مثل طبيعي;
    دع عمق: متغير طبيعي = 0;
    دع في_اسم: متغير منطقي = صواب;
    ف := 0;
    طالما (ف < ل) {
        دع ب: ط8 = (*م_)[ف];
        إذا (ب == 0x28) { عمق := عمق + 1; } وإلا إذا (ب == 0x29) { عمق := عمق - 1; };
        إذا (عمق == 0 && ب == 0x3A) { في_اسم := خطأ; }
        وإلا إذا (عمق == 0 && ب == 0x2C) { في_اسم := صواب; ألحق_بايتات_نص(&متغير الحجج, «, »); }
        وإلا إذا (في_اسم && ب != 0x20) { ألحق(الحجج, ب); };
        ف := ف + 1;
    }
    دع النداء: نص = صل_ثلاثة_نصوص(&المعرف, &«(», &صل_نصين(&من_بايتات(&الحجج), &«)»));
    دع الجسم: متغير نص = صل_ثلاثة_نصوص(&« { return », &النداء, &«; }»);
    دع فراغ_ن: نص = «void»;
    إذا (نصان_متساويان(&الناتج, &فراغ_ن)) { الجسم := صل_ثلاثة_نصوص(&« { », &النداء, &«; }»); };
    دع الأجزاء: متجه نص = [«def », الاسم, «(», انسخ_نص(&المعاملات), «): », الناتج, الجسم,
        «  // defined by another file of this import»];
    أرجع صل_النصوص(&الأجزاء, &«»);
}


// A parameter `NAME: TYPE` of a declaration's text.
نوع معامل_نصي_جسر = { الاسم: نص, النوع: نص };

// The parameters of the text between a declaration's `(` and its `)`.
عرف معاملات_نصية_جسر(المعاملات: &نص): متجه معامل_نصي_جسر {
    دع الناتج: متغير متجه معامل_نصي_جسر = [];
    دع ل: طبيعي = الطول(*المعاملات) مثل طبيعي;
    دع عمق: متغير طبيعي = 0;
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= ل) {
        إذا (ف == ل || ((*المعاملات)[ف] == 0x2C && عمق == 0)) {
            دع الجزء: متغير نص = «»;
            إذا ((ف) > (البداية)) {
                طابق مقطع_نص(المعاملات, البداية, (ف) - (البداية)) مع
                | اختياري.موجود(المقطع_ن) -> { الجزء := المقطع_ن; }
                | اختياري.لا_شيء -> { الجزء := «»; };
            };
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول(الجزء) مثل طبيعي) && الجزء[ك] != 0x3A) { ك := ك + 1; }
            إذا (ك + 1 < (الطول(الجزء) مثل طبيعي)) {
                دع الاسم_ن: متغير متجه ط8 = [];
                دع ي: متغير طبيعي = 0;
                طالما (ي < ك) { إذا (الجزء[ي] != 0x20) { ألحق(الاسم_ن, الجزء[ي]); }; ي := ي + 1; }
                طابق مقطع_نص(&الجزء, ك + 2, (الطول(الجزء) مثل طبيعي) - (ك + 2)) مع
                | اختياري.موجود(النوع_ن) -> {
                    دع المعامل: معامل_نصي_جسر = { الاسم: الاسم_ن مثل نص, النوع: النوع_ن };
                    ألحق(الناتج, المعامل);
                }
                | اختياري.لا_شيء -> { };
            };
            البداية := ف + 1;
        } وإلا إذا (ف < ل && (*المعاملات)[ف] == 0x28) { عمق := عمق + 1; }
        وإلا إذا (ف < ل && (*المعاملات)[ف] == 0x29) { عمق := عمق - 1; };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The value of parameter الاسم of SultanC type النوع as a variadic slot's
// word (integers widened, pointers as addresses); "" for a float (stored as
// f64) and for a type no slot holds.
عرف قيمة_خانة_جسر(الاسم: &نص, النوع: &نص): نص {
    إذا (يبدأ_بـ(النوع, &«*»)) { أرجع صل_ثلاثة_نصوص(&«(», الاسم, &« as u64)»); };
    إذا (يبدأ_بـ(النوع, &«i8») || يبدأ_بـ(النوع, &«i16») || يبدأ_بـ(النوع, &«i32») || يبدأ_بـ(النوع, &«i64»)) {
        أرجع صل_ثلاثة_نصوص(&«((», الاسم, &« as i64) as u64)»);
    };
    إذا (يبدأ_بـ(النوع, &«u8») || يبدأ_بـ(النوع, &«u16») || يبدأ_بـ(النوع, &«u32») || يبدأ_بـ(النوع, &«u64»)) {
        أرجع صل_ثلاثة_نصوص(&«(», الاسم, &« as u64)»);
    };
    أرجع «»;
}

// A variadic call shape `extern def خN_K_NAME(PARAMS): RESULT = "NAME...F";`
// of a function another unit defines, whose slot entry is among المداخل
// (header lines `def جM_متغيرة_NAME(…, جM_خانات_د: WORD): RESULT {`), as a
// SultanC function: the arguments after the first F in 8-byte slots, then a
// call of the slot entry. Empty when it is not one.
عرف نداء_متغير_بين_الوحدات_جسر(السطر: &نص, المداخل: &متجه نص): نص {
    إذا (!يبدأ_بـ(السطر, &«extern def »)) { أرجع «»; };
    دع ن: طبيعي = الطول(*السطر) مثل طبيعي;
    إذا (ن < 3 || (*السطر)[ن - 1] != 0x3B || (*السطر)[ن - 2] != 0x22) { أرجع «»; };
    دع نهاية_الرابط: طبيعي = ن - 2;
    دع بداية_الرابط: متغير طبيعي = نهاية_الرابط;
    طالما (بداية_الرابط > 0 && (*السطر)[بداية_الرابط - 1] != 0x22) { بداية_الرابط := بداية_الرابط - 1; }
    دع الرابط: متغير نص = «»;
    إذا ((نهاية_الرابط) > (بداية_الرابط)) {
        طابق مقطع_نص(السطر, بداية_الرابط, (نهاية_الرابط) - (بداية_الرابط)) مع
        | اختياري.موجود(المقطع_ن) -> { الرابط := المقطع_ن; }
        | اختياري.لا_شيء -> { الرابط := «»; };
    };
    // NAME...F
    دع النقاط: متغير طبيعي = 0;
    دع وجدت: متغير منطقي = خطأ;
    طالما (النقاط + 2 < (الطول(الرابط) مثل طبيعي)) {
        إذا (الرابط[النقاط] == 0x2E && الرابط[النقاط + 1] == 0x2E && الرابط[النقاط + 2] == 0x2E) { وجدت := صواب; اخرج_من_حلقة; };
        النقاط := النقاط + 1;
    }
    إذا (!وجدت) { أرجع «»; };
    دع الاسم_س: متغير نص = «»;
    إذا ((النقاط) > 0) {
        طابق مقطع_نص(&الرابط, 0, النقاط) مع
        | اختياري.موجود(المقطع_ن) -> { الاسم_س := المقطع_ن; }
        | اختياري.لا_شيء -> { الاسم_س := «»; };
    };
    دع الثابتة: متغير طبيعي = 0;
    دع العدد_ن: متغير نص = «»;
    إذا ((الطول(الرابط) مثل طبيعي) > (النقاط + 3)) {
        طابق مقطع_نص(&الرابط, النقاط + 3, (الطول(الرابط) مثل طبيعي) - (النقاط + 3)) مع
        | اختياري.موجود(المقطع_ن) -> { العدد_ن := المقطع_ن; }
        | اختياري.لا_شيء -> { العدد_ن := «»; };
    };
    طابق حلل_طبيعي_بقاعدة(&العدد_ن, 10) مع
    | نتيجة.نجح(القيمة) -> { الثابتة := القيمة; }
    | نتيجة.خطأ(_) -> { أرجع «»; };
    دع ف: متغير طبيعي = 0;
    // The slot entry `def جM_متغيرة_NAME(`.
    دع اللاحقة: نص = صل_ثلاثة_نصوص(&«_متغيرة_», &الاسم_س, &«(»);
    دع المدخل: متغير نص = «»;
    دع الرأس_م: متغير نص = «»;
    ف := 0;
    طالما (ف < (الطول(*المداخل) مثل طبيعي)) {
        دع الرأس: &نص = &(*المداخل)[ف];
        دع ق: متغير طبيعي = 4;
        طالما (ق < (الطول(*الرأس) مثل طبيعي) && (*الرأس)[ق] != 0x28) { ق := ق + 1; }
        دع الاسم_م: متغير نص = «»;
        إذا ((ق) > (4)) {
            طابق مقطع_نص(الرأس, 4, (ق) - (4)) مع
            | اختياري.موجود(المقطع_ن) -> { الاسم_م := المقطع_ن; }
            | اختياري.لا_شيء -> { الاسم_م := «»; };
        };
        دع مع_القوس: نص = صل_نصين(&الاسم_م, &«(»);
        إذا (ينتهي_بـ(&مع_القوس, &اللاحقة)) {
            المدخل := الاسم_م;
            الرأس_م := انسخ_نص(الرأس);
            اخرج_من_حلقة;
        };
        ف := ف + 1;
    }
    إذا ((الطول(المدخل) مثل طبيعي) == 0) { أرجع «»; };
    // The word type: the slot entry's last parameter's.
    دع إغلاق_م: متغير طبيعي = الطول(الرأس_م) مثل طبيعي;
    طالما (إغلاق_م > 0 && الرأس_م[إغلاق_م - 1] != 0x29) { إغلاق_م := إغلاق_م - 1; }
    دع نقطتان: متغير طبيعي = إغلاق_م;
    طالما (نقطتان > 0 && الرأس_م[نقطتان - 1] != 0x3A) { نقطتان := نقطتان - 1; }
    إذا (إغلاق_م == 0 || نقطتان == 0 || نقطتان + 1 >= إغلاق_م) { أرجع «»; };
    دع الكلمة: متغير نص = «»;
    إذا ((إغلاق_م - 1) > (نقطتان + 1)) {
        طابق مقطع_نص(&الرأس_م, نقطتان + 1, (إغلاق_م - 1) - (نقطتان + 1)) مع
        | اختياري.موجود(المقطع_ن) -> { الكلمة := المقطع_ن; }
        | اختياري.لا_شيء -> { الكلمة := «»; };
    };
    // `extern def NAME(PARAMS): RESULT = "LINK";`
    دع الاسم: نص = اسم_بعد_جسر(السطر, 11);
    دع فتح: طبيعي = 11 + (الطول(الاسم) مثل طبيعي);
    إذا (فتح >= ن || (*السطر)[فتح] != 0x28) { أرجع «»; };
    دع العمق: متغير طبيعي = 0;
    دع إغلاق: متغير طبيعي = فتح;
    طالما (إغلاق < ن) {
        دع ب: ط8 = (*السطر)[إغلاق];
        إذا (ب == 0x28) { العمق := العمق + 1; }
        وإلا إذا (ب == 0x29) { العمق := العمق - 1; إذا (العمق == 0) { اخرج_من_حلقة; }; };
        إغلاق := إغلاق + 1;
    }
    إذا (إغلاق + 3 >= ن || (*السطر)[إغلاق + 1] != 0x3A) { أرجع «»; };
    دع المعاملات_ن: متغير نص = «»;
    إذا ((إغلاق) > (فتح + 1)) {
        طابق مقطع_نص(السطر, فتح + 1, (إغلاق) - (فتح + 1)) مع
        | اختياري.موجود(المقطع_ن) -> { المعاملات_ن := المقطع_ن; }
        | اختياري.لا_شيء -> { المعاملات_ن := «»; };
    };
    دع الناتج: متغير نص = «»;
    إذا ((بداية_الرابط - 4) > (إغلاق + 3)) {
        طابق مقطع_نص(السطر, إغلاق + 3, (بداية_الرابط - 4) - (إغلاق + 3)) مع
        | اختياري.موجود(المقطع_ن) -> { الناتج := المقطع_ن; }
        | اختياري.لا_شيء -> { الناتج := «»; };
    };
    دع المعاملات: متجه معامل_نصي_جسر = معاملات_نصية_جسر(&المعاملات_ن);
    إذا ((الطول(المعاملات) مثل طبيعي) < الثابتة) { أرجع «»; };
    دع العدد: طبيعي = (الطول(المعاملات) مثل طبيعي) - الثابتة;
    // The slots: one per variadic argument and one more (two at least).
    دع الكلمات: متغير طبيعي = العدد + 1;
    إذا (الكلمات < 2) { الكلمات := 2; };
    دع النوع_خ: متغير متجه ط8 = [0x28];
    دع الصفر_خ: متغير متجه ط8 = [0x28];
    ف := 0;
    طالما (ف < الكلمات) {
        إذا (ف > 0) { ألحق_بايتات_نص(&متغير النوع_خ, «, »); ألحق_بايتات_نص(&متغير الصفر_خ, «, »); };
        ألحق_بايتات_نص(&متغير النوع_خ, «u64»);
        ألحق_بايتات_نص(&متغير الصفر_خ, «0»);
        ف := ف + 1;
    }
    ألحق(النوع_خ, 0x29);
    ألحق(الصفر_خ, 0x29);
    دع النوع_خ_ن: نص = النوع_خ مثل نص;
    دع الجسم: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الجسم, صل_ثلاثة_نصوص(&«def », &الاسم, &صل_ثلاثة_نصوص(&«(», &المعاملات_ن, &صل_ثلاثة_نصوص(&«): », &الناتج, &« {  // variadic, defined by another file of this import»))));
    ألحق(الجسم, 10);
    ألحق_بايتات_نص(&متغير الجسم, صل_ثلاثة_نصوص(&«    let الخانات_و: mutable », &النوع_خ_ن, &صل_ثلاثة_نصوص(&« = », &من_بايتات(&الصفر_خ), &«;»)));
    ألحق(الجسم, 10);
    ألحق_بايتات_نص(&متغير الجسم, «    unsafe {»);
    ألحق(الجسم, 10);
    ألحق_بايتات_نص(&متغير الجسم, صل_ثلاثة_نصوص(&«        let الخانات_ق: *mutable », &النوع_خ_ن, &« = &mutable الخانات_و;»));
    ألحق(الجسم, 10);
    ألحق_بايتات_نص(&متغير الجسم, صل_ثلاثة_نصوص(&«        let العنوان_و: », &الكلمة, &صل_ثلاثة_نصوص(&« = الخانات_ق as », &الكلمة, &«;»)));
    ألحق(الجسم, 10);
    دع الحجج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
        دع المعامل: &معامل_نصي_جسر = &المعاملات[ف];
        إذا (ف < الثابتة) {
            إذا (ف > 0) { ألحق_بايتات_نص(&متغير الحجج, «, »); };
            ألحق_بايتات_نص(&متغير الحجج, انسخ_نص(&(*المعامل).الاسم));
        } وإلا {
            دع الموضع: نص = صل_ثلاثة_نصوص(&«(العنوان_و + », &طبيعي_إلى_نص((ف - الثابتة) * 8), &«)»);
            دع القيمة: نص = قيمة_خانة_جسر(&(*المعامل).الاسم, &(*المعامل).النوع);
            دع الخانة: نص = صل_نصين(&«الخانة_», &طبيعي_إلى_نص(ف));
            إذا ((الطول(القيمة) مثل طبيعي) > 0) {
                ألحق_بايتات_نص(&متغير الجسم, صل_ثلاثة_نصوص(&صل_ثلاثة_نصوص(&«        let », &الخانة, &«: *mutable u64 = »), &الموضع, &صل_ثلاثة_نصوص(&« as *mutable u64; *», &الخانة, &صل_ثلاثة_نصوص(&« := », &القيمة, &«;»))));
            } وإلا إذا (يبدأ_بـ(&(*المعامل).النوع, &«f»)) {
                ألحق_بايتات_نص(&متغير الجسم, صل_ثلاثة_نصوص(&صل_ثلاثة_نصوص(&«        let », &الخانة, &«: *mutable f64 = »), &الموضع, &صل_ثلاثة_نصوص(&« as *mutable f64; *», &الخانة, &صل_ثلاثة_نصوص(&« := (», &(*المعامل).الاسم, &« as f64);»))));
            } وإلا { أرجع «»; };
            ألحق(الجسم, 10);
        };
        ف := ف + 1;
    }
    إذا (الثابتة > 0) { ألحق_بايتات_نص(&متغير الحجج, «, »); };
    ألحق_بايتات_نص(&متغير الحجج, «العنوان_و»);
    دع النداء: نص = صل_ثلاثة_نصوص(&المدخل, &«(», &صل_نصين(&من_بايتات(&الحجج), &«)»));
    دع فراغ_ن: نص = «void»;
    إذا (نصان_متساويان(&الناتج, &فراغ_ن)) {
        ألحق_بايتات_نص(&متغير الجسم, صل_ثلاثة_نصوص(&«        », &النداء, &«;»));
    } وإلا {
        ألحق_بايتات_نص(&متغير الجسم, صل_ثلاثة_نصوص(&«        return », &النداء, &«;»));
    };
    ألحق(الجسم, 10);
    ألحق_بايتات_نص(&متغير الجسم, «    }»);
    ألحق(الجسم, 10);
    ألحق_بايتات_نص(&متغير الجسم, «}»);
    أرجع الجسم مثل نص;
}

// The modules of the units النصوص (in order) as one module.
عام عرف ادمج_وحدات_سي_جسر(النصوص: &متجه نص): نص {
    دع المرقمة: متغير متجه متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النصوص) مثل طبيعي)) {
        ألحق(المرقمة, رقم_أسماء_الوحدة_جسر(&(*النصوص)[ف], ف));
        ف := ف + 1;
    }
    // The functions the units define for SultanC (their C names).
    دع المعرفة: متغير متجه نص = [];
    // The objects a unit defines: another unit's external declaration of
    // one is left out.
    دع الكائنات: متغير متجه نص = [];
    // The slot entries of the variadic functions the units define.
    دع المداخل: متغير متجه نص = [];
    دع الأسطر_ك: متغير متجه متجه نص = [];
    ف := 0;
    طالما (ف < (الطول(المرقمة) مثل طبيعي)) {
        دع المرقمة_ن: نص = من_بايتات(&المرقمة[ف]);
        دع الأسطر: متجه نص = أسطر_النص(&المرقمة_ن);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(الأسطر) مثل طبيعي)) {
            إذا (يبدأ_بـ(&الأسطر[ك], &«public def »)) { ألحق(المعرفة, اسم_بعد_جسر(&الأسطر[ك], 11)); };
            إذا (يبدأ_بـ(&الأسطر[ك], &«public let »)) { ألحق(الكائنات, اسم_بعد_جسر(&الأسطر[ك], 11)); };
            إذا (يبدأ_بـ(&الأسطر[ك], &«def ج») && يحتوي_نصا(&الأسطر[ك], &«_متغيرة_»)) { ألحق(المداخل, انسخ_نص(&الأسطر[ك])); };
            ك := ك + 1;
        }
        ألحق(الأسطر_ك, الأسطر);
        ف := ف + 1;
    }
    دع المكتوبة: متغير متجه نص = [];
    دع الأسماء_المكتوبة: متغير متجه نص = [];
    دع الناتج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < (الطول(الأسطر_ك) مثل طبيعي)) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(الأسطر_ك[ف]) مثل طبيعي)) {
            دع السطر: &نص = &الأسطر_ك[ف][ك];
            ك := ك + 1;
            إذا (يبدأ_بـ(السطر, &«public extern let »)) {
                دع الاسم_ك: نص = اسم_بعد_جسر(السطر, 18);
                دع معرف_هنا: متغير منطقي = خطأ;
                دع ي: متغير طبيعي = 0;
                طالما (ي < (الطول(الكائنات) مثل طبيعي)) {
                    إذا (نصان_متساويان(&الكائنات[ي], &الاسم_ك)) { معرف_هنا := صواب; };
                    ي := ي + 1;
                }
                إذا (معرف_هنا) { تابع_حلقة; };
            };
            إذا (تصريح_سطر_جسر(السطر)) {
                دع مكرر: متغير منطقي = خطأ;
                دع ي: متغير طبيعي = 0;
                طالما (ي < (الطول(المكتوبة) مثل طبيعي)) {
                    إذا (نصان_متساويان(&المكتوبة[ي], السطر)) { مكرر := صواب; اخرج_من_حلقة; };
                    ي := ي + 1;
                }
                إذا (مكرر) { تابع_حلقة; };
                ألحق(المكتوبة, انسخ_نص(السطر));
            };
            دع البديل: متغير نص = نداء_بين_الوحدات_جسر(السطر, &المعرفة);
            إذا ((الطول(البديل) مثل طبيعي) == 0) { البديل := نداء_متغير_بين_الوحدات_جسر(السطر, &المداخل); };
            إذا ((الطول(البديل) مثل طبيعي) > 0) {
                ألحق_بايتات_نص(&متغير الناتج, البديل);
            } وإلا {
                ألحق_بايتات_نص(&متغير الناتج, انسخ_نص(السطر));
            };
            ألحق(الناتج, 10);
        }
        ف := ف + 1;
    }
    أرجع الناتج مثل نص;
}

