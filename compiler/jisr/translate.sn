// C import: `import "x.h"` and `import "x.c"` read the C declarations of a
// file as a SultanC module. Jisr (compiler/jisr/jisr), SultanC's own C
// frontend, does the work for the selected target: it preprocesses the
// file (#include, macros, conditionals, the target's predefined macros),
// parses its declarations with the target's data model and layouts, and
// writes them as SultanC.
//
//   * The C file is found next to the importer, else (a header) under
//     $SULTANC_C_INCLUDE (':'-separated) and the target's system include
//     directories (jisr/jisr.sn).
//   * SULTANC_C_PREPROCESSOR selects the preprocessor: unset or `jisr` is
//     Jisr's; `cc` runs the system C compiler (`cc -E -dD`, $CC when set)
//     and Jisr parses its output. The C compiler is never used unless it is
//     selected so.
//   * SULTANC_C_DUMP=<file> writes the generated module to <file>.
//
// An imported .c file's function bodies and objects are compiled by Jisr
// into the module (jisr/lower.sn), for any target. SULTANC_C_COMPILER=cc
// selects the system C compiler instead (host target only): its object is
// linked (driver/c_sources.sn via كائنات_مصادر_سي) and the file's
// non-static functions become externs.
استورد std.env.system;
استورد std.fs.metadata;
استورد std.fs.read_file;
استورد std.fs.write_file;
استورد std.fs.mutation;
استورد std.fs.path;
استورد std.text.transform;
استورد std.text.search;
استورد std.process.child;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.text.number;
استورد std.os.entropy;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.foreign_c;
استورد std.text.substring;
استورد compiler.jisr.core;
استورد compiler.jisr.target;
استورد compiler.jisr.headers;
استورد compiler.jisr.jisr;
استورد compiler.jisr.shared;
استورد compiler.jisr.units;

// ---- text helpers ----





// Whether المسار names a C source the import reads (.h or .c).
عام عرف هل_مصدر_سي(المسار: &نص): منطقي {
    أرجع ينتهي_بـ(المسار, &«.h») || ينتهي_بـ(المسار, &«.c»);
}

// Whether المسار is a C translation unit to compile and link.
عام عرف هل_وحدة_سي(المسار: &نص): منطقي { أرجع ينتهي_بـ(المسار, &«.c»); }

// ---- finding files and programs ----

عرف ملف_سي_موجود(المسار: &نص): منطقي {
    طابق حاول_نوع_المسار(المسار) مع
    | نتيجة.نجح(نوع_مسار.ملف) -> { أرجع صواب; }
    | نتيجة.نجح(نوع_مسار.وصلة_رمزية) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}


// The directories a header import is looked up in: $SULTANC_C_INCLUDE,
// then the target's system include directories.
عرف أدلة_ترويسات_سي(الهدف: &واصف_هدف): متجه نص {
    دع الناتج: متغير متجه نص = أدلة_المستخدم_جسر();
    دع النموذج: نموذج_سي_جسر = نموذج_سي_من_هدف_جسر(الهدف);
    دع النظام: أدلة_نظام_جسر = أدلة_النظام_جسر(الهدف, &النموذج);
    // The builtin headers last: an import names the C library's own header
    // when there is one (`import "stdint.h"` writes glibc's typedefs).
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النظام.الأدلة) مثل طبيعي)) {
        إذا (!يبدأ_بـ(&النظام.الأدلة[ف], &«<jisr>»)) { ألحق(الناتج, انسخ_نص(&النظام.الأدلة[ف])); };
        ف := ف + 1;
    }
    ألحق(الناتج, «<jisr>»);
    أرجع الناتج;
}

// The file an import of المسار reads: المسار itself when it exists, else
// the longest tail of المسار (`openssl/ssl.h`, then `ssl.h`) found under an
// include directory.
نوع ملف_سي_محدد = { الملف: نص, الجذر: نص };

عام عرف حدد_ملف_سي(المسار: &نص): اختياري نص {
    دع الهدف: اختياري واصف_هدف = اختياري.لا_شيء();
    طابق حدد_ملف_وجذر_سي(المسار, &الهدف) مع
    | اختياري.موجود(المحدد) -> { أرجع اختياري.موجود(انسخ_نص(&المحدد.الملف)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// The file and the root of its family: its directory when المسار names it,
// else the include directory it was found under.
عرف حدد_ملف_وجذر_سي(المسار: &نص, الهدف_ا: &اختياري واصف_هدف): اختياري ملف_سي_محدد {
    إذا (ملف_سي_موجود(المسار)) {
        دع المحدد: ملف_سي_محدد = { الملف: انسخ_نص(المسار), الجذر: دليل_مسار_جسر(المسار) };
        أرجع اختياري.موجود(المحدد);
    };
    دع المقاطع: متجه نص = مكونات_المسار(المسار);
    دع الهدف: واصف_هدف = هدف_أو_المضيف_سي(الهدف_ا);
    دع الأدلة: متجه نص = أدلة_ترويسات_سي(&الهدف);
    دع البداية: متغير طبيعي = 0;
    طالما (البداية < (الطول(المقاطع) مثل طبيعي)) {
        دع الأجزاء: متغير متجه نص = [];
        دع ف: متغير طبيعي = البداية;
        طالما (ف < (الطول(المقاطع) مثل طبيعي)) {
            إذا (ف > البداية) { ألحق(الأجزاء, «/»); };
            ألحق(الأجزاء, انسخ_نص(&المقاطع[ف]));
            ف := ف + 1;
        }
        دع الذيل: نص = صل_النصوص(&الأجزاء, &«»);
        دع د: متغير طبيعي = 0;
        طالما (د < (الطول(الأدلة) مثل طبيعي)) {
            دع المرشح: متغير نص = صل_المسار(&الأدلة[د], &الذيل);
            دع مدمج: منطقي = يبدأ_بـ(&الأدلة[د], &«<jisr>»);
            إذا (مدمج) { المرشح := صل_نصين(&«<jisr>/», &الذيل); };
            إذا ((!مدمج && ملف_سي_موجود(&المرشح)) || (مدمج && رأس_مدمج_موجود_سي(&الذيل))) {
                دع المحدد: ملف_سي_محدد = { الملف: المرشح, الجذر: انسخ_نص(&الأدلة[د]) };
                أرجع اختياري.موجود(المحدد);
            };
            د := د + 1;
        }
        البداية := البداية + 1;
    }
    أرجع اختياري.لا_شيء();
}

// الهدف, or the host's registered target when none is given.
عام عرف هدف_أو_المضيف_سي(الهدف: &اختياري واصف_هدف): واصف_هدف {
    طابق *الهدف مع
    | اختياري.موجود(القيمة) -> { أرجع انسخ_مملوكا_واصف_هدف(&القيمة); }
    | اختياري.لا_شيء -> { };
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.محلول(المضيف) -> { أرجع المضيف; }
    | نتيجة_حل_هدف.غير_مسجل -> { };
    // No registered host: the first registered target stands in.
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    أرجع انسخ_مملوكا_واصف_هدف(&الأهداف[0]);
}

عرف رأس_مدمج_موجود_سي(الاسم: &نص): منطقي {
    طابق رأس_مدمج_جسر(الاسم) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Whether الهدف is the host's registered target (the system C compiler
// builds only for it).
عام عرف هدف_المضيف_سي(الهدف: &واصف_هدف): منطقي {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.محلول(المضيف) -> { أرجع نصان_متساويان(&المضيف.الثلاثي_المقنن, &(*الهدف).الثلاثي_المقنن); }
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع خطأ; };
}

// The C compiler: $CC, else `cc`, found on PATH when not a path itself.
عام عرف برنامج_مترجم_سي(): اختياري نص {
    دع الاسم: متغير نص = «cc»;
    دع اسم_المتغير: نص = «CC»;
    طابق متغير_بيئة_النظام(&اسم_المتغير) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { إذا (الطول(القيمة) > 0) { الاسم := القيمة; }; }
    | _ -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الاسم) مثل طبيعي)) {
        إذا (الاسم[ف] == 0x2F) { أرجع اختياري.موجود(الاسم); };
        ف := ف + 1;
    }
    دع اسم_المسار: نص = «PATH»;
    طابق متغير_بيئة_النظام(&اسم_المسار) مع
    | نتيجة.نجح(اختياري.موجود(المسارات)) -> {
        دع الفاصل: نص = «:»;
        دع الأدلة: متجه نص = قسم_النص(&المسارات, &الفاصل);
        دع د: متغير طبيعي = 0;
        طالما (د < (الطول(الأدلة) مثل طبيعي)) {
            // An empty entry of PATH names no directory.
            إذا (نص_فارغ(&الأدلة[د])) { د := د + 1; تابع_حلقة; };
            دع المرشح: نص = صل_المسار(&الأدلة[د], &الاسم);
            إذا (ملف_سي_موجود(&المرشح)) { أرجع اختياري.موجود(المرشح); };
            د := د + 1;
        }
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// A fresh path in the temporary directory ending with اللاحقة.
عام عرف مسار_مؤقت_سي(اللاحقة: نص): نص {
    دع الدليل: متغير نص = «/tmp»;
    طابق الدليل_المؤقت_للنظام() مع
    | نتيجة.نجح(القيمة) -> { إذا (الطول(القيمة) > 0) { الدليل := القيمة; }; }
    | نتيجة.خطأ(_) -> { };
    دع العشوائية: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
    دع القيمة: متغير طبيعي = 0;
    طابق املأ_بايتات_عشوائية_النظام(&متغير العشوائية) مع
    | نتيجة.نجح(_) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < 7) { القيمة := القيمة * 256 + (العشوائية[ف] مثل طبيعي); ف := ف + 1; }
    }
    | نتيجة.خطأ(_) -> { };
    دع الأجزاء: متغير متجه نص = [];
    ألحق(الأجزاء, الدليل);
    ألحق(الأجزاء, «/sultanc-c-»);
    ألحق(الأجزاء, طبيعي_إلى_نص(القيمة));
    ألحق(الأجزاء, اللاحقة);
    أرجع صل_النصوص(&الأجزاء, &«»);
}

// Runs the C compiler with الوسائط; true on exit status 0.
عام عرف شغل_مترجم_سي(الوسائط: &متجه نص): منطقي {
    طابق شغل_مترجم_سي_بحالة(الوسائط) مع
    | نتيجة.نجح(_) -> { أرجع صواب; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// Why the system C compiler did not build an object: the C file is not
// found, no C compiler is found, it could not be started (the error code
// std.process.child gives), it exited with a nonzero status, or a signal
// ended it. The driver reports it (SULTANC-C-COMPILER-FAILED) with the
// status or signal as a fact.
عام نوع فشل_كائن_سي =
    | ملف_مفقود
    | مترجم_مفقود
    | تشغيل_فاشل بنوع عدد
    | خرج بنوع عدد
    | إشارة بنوع عدد
;

// Runs the system C compiler with الوسائط; نجح when it exits with 0.
عام عرف شغل_مترجم_سي_بحالة(الوسائط: &متجه نص): نتيجة منطقي, فشل_كائن_سي {
    طابق برنامج_مترجم_سي() مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_كائن_سي.مترجم_مفقود()); }
    | اختياري.موجود(البرنامج) -> {
        طابق شغل_وانتظر(&البرنامج, الوسائط) مع
        | نتيجة.نجح(حالة_إنهاء.خرج(الرمز)) -> {
            إذا (الرمز == 0) { أرجع نتيجة.نجح(صواب); };
            أرجع نتيجة.خطأ(فشل_كائن_سي.خرج(الرمز));
        }
        | نتيجة.نجح(حالة_إنهاء.إشارة(الإشارة)) -> { أرجع نتيجة.خطأ(فشل_كائن_سي.إشارة(الإشارة)); }
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(فشل_كائن_سي.تشغيل_فاشل(الخطأ)); };
    };
}


// ---- the module ----

// The SultanC module for `import "x.h"` / `import "x.c"` on the host.
عام عرف ترجم_مصدر_سي(المسار: &نص): نتيجة نص, عدد {
    دع الهدف: اختياري واصف_هدف = اختياري.لا_شيء();
    أرجع ترجم_مصدر_سي_لهدف(المسار, &الهدف);
}

// The SultanC module for `import "x.h"` / `import "x.c"` on الهدف (the
// host's target when none).
عام عرف ترجم_مصدر_سي_لهدف(المسار: &نص, الهدف_ا: &اختياري واصف_هدف): نتيجة نص, عدد {
    دع لا_جذر: نص = «»;
    أرجع ترجم_مصدر_سي_في_جذر(المسار, الهدف_ا, &لا_جذر);
}

// As ترجم_مصدر_سي_لهدف, for the module at المسار under the source root
// الجذر: declarations an earlier C import under the same root wrote are
// imported from it instead of written again (shared.sn).
عام عرف ترجم_مصدر_سي_في_جذر(المسار: &نص, الهدف_ا: &اختياري واصف_هدف, الجذر: &نص): نتيجة نص, عدد {
    دع الهدف: واصف_هدف = هدف_أو_المضيف_سي(الهدف_ا);
    دع التهجئة: نص = انسخ_نص(&الهدف.التهجئة);
    ابدأ_وحدة_مشتركة_جسر(المسار, الجذر, &التهجئة);
    دع الناتج: نتيجة نص, عدد = ترجم_مصدر_سي_بهدف(المسار, الهدف_ا, &الهدف);
    أنه_وحدة_مشتركة_جسر();
    أرجع الناتج;
}

// The files of an import: `a.c+b.c` names a.c and b.c of one directory
// (several translation units compiled as one module, units.sn); any other
// path is itself.
عام عرف أجزاء_مصدر_سي(المسار: &نص): متجه نص {
    دع ن: طبيعي = الطول(*المسار) مثل طبيعي;
    دع البداية: متغير طبيعي = ن;
    طالما (البداية > 0 && (*المسار)[البداية - 1] != 0x2F) { البداية := البداية - 1; }
    دع الدليل: متغير نص = «»;
    إذا ((البداية) > 0) {
        طابق مقطع_نص(المسار, 0, البداية) مع
        | اختياري.موجود(المقطع_ن) -> { الدليل := المقطع_ن; }
        | اختياري.لا_شيء -> { الدليل := «»; };
    };
    دع الاسم: متغير نص = «»;
    إذا ((ن) > (البداية)) {
        طابق مقطع_نص(المسار, البداية, (ن) - (البداية)) مع
        | اختياري.موجود(المقطع_ن) -> { الاسم := المقطع_ن; }
        | اختياري.لا_شيء -> { الاسم := «»; };
    };
    دع الزائد: نص = «+»;
    دع الأجزاء: متجه نص = قسم_النص(&الاسم, &الزائد);
    دع الناتج: متغير متجه نص = [];
    // Only .c files are joined: `c++config.h` is one header.
    دع كلها_وحدات: متغير منطقي = (الطول(الأجزاء) مثل طبيعي) >= 2;
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(الأجزاء) مثل طبيعي)) {
        إذا (!هل_وحدة_سي(&الأجزاء[ي]) || (الطول(الأجزاء[ي]) مثل طبيعي) < 3) { كلها_وحدات := خطأ; };
        ي := ي + 1;
    }
    إذا (!كلها_وحدات) { ألحق(الناتج, انسخ_نص(المسار)); أرجع الناتج; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
        ألحق(الناتج, صل_نصين(&الدليل, &الأجزاء[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ترجم_مصدر_سي_بهدف(المسار: &نص, الهدف_ا: &اختياري واصف_هدف, الهدف_م: &واصف_هدف): نتيجة نص, عدد {
    دع الأجزاء: متجه نص = أجزاء_مصدر_سي(المسار);
    إذا ((الطول(الأجزاء) مثل طبيعي) > 1) {
        // Translation units only: their modules joined (units.sn).
        دع النصوص: متغير متجه نص = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
            إذا (!هل_وحدة_سي(&الأجزاء[ف])) { أرجع نتيجة.خطأ(2); };
            طابق ترجم_ملف_سي_بهدف(&الأجزاء[ف], الهدف_ا, الهدف_م) مع
            | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(الرمز); }
            | نتيجة.نجح(النص) -> { ألحق(النصوص, النص); };
            ف := ف + 1;
        }
        دع المدمج: نص = ادمج_وحدات_سي_جسر(&النصوص);
        دع المكب: نص = متغير_بيئة_سي(«SULTANC_C_DUMP»);
        إذا ((الطول(المكب) مثل طبيعي) > 0) { دع الكتابة: نتيجة عدد, عدد = اكتب_الملف(&المكب, &المدمج); };
        أرجع نتيجة.نجح(المدمج);
    };
    أرجع ترجم_ملف_سي_بهدف(المسار, الهدف_ا, الهدف_م);
}

عرف ترجم_ملف_سي_بهدف(المسار: &نص, الهدف_ا: &اختياري واصف_هدف, الهدف_م: &واصف_هدف): نتيجة نص, عدد {
    دع الهدف: واصف_هدف = انسخ_مملوكا_واصف_هدف(الهدف_م);
    طابق حدد_ملف_وجذر_سي(المسار, الهدف_ا) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(2); }
    | اختياري.موجود(المحدد) -> {
        دع الملف: نص = انسخ_نص(&المحدد.الملف);
        دع وحدة_ترجمة: منطقي = هل_وحدة_سي(&الملف);
        دع المعالج: نص = متغير_بيئة_سي(«SULTANC_C_PREPROCESSOR»);
        دع الناتج: متغير نتيجة نص, عدد = نتيجة.خطأ(5);
        إذا ((الطول(المعالج) مثل طبيعي) == 0 || نصان_متساويان(&المعالج, &«jisr»)) {
            دع لا_نص: اختياري نص = اختياري.لا_شيء();
            الناتج := ترجم_جسر(&الملف, &المحدد.الجذر, وحدة_ترجمة, &الهدف, لا_نص);
        } وإلا إذا (نصان_متساويان(&المعالج, &«cc»)) {
            طابق عالج_بمترجم_سي(&الملف) مع
            | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(الرمز); }
            | نتيجة.نجح(النص) -> {
                الناتج := ترجم_جسر(&الملف, &المحدد.الجذر, وحدة_ترجمة, &الهدف, اختياري.موجود(النص));
            };
        } وإلا {
            دع لا_ملف: نص = «»;
            دع التشخيص: متغير تشخيص_جسر = تشخيص_جسر_بلا_موقع(سبب_تشخيص.سبب_سي_معالج_غير_صالح());
            أضف_قيمة_سي(&متغير التشخيص.السجل, انسخ_نص(&المعالج));
            دع بلا_سلسلة: متجه موقع_سي = [];
            أبلغ_تشخيص_جسر(&التشخيص, &بلا_سلسلة);
            دع الأجزاء: متجه نص = [«// SULTANC_C_PREPROCESSOR is neither jisr nor cc.», سطر_جديد_سي(),
                «import std.meta.reflect;», سطر_جديد_سي(),
                «def jisr_c_errors(): void { comptime { compile_error("SULTANC-C-INVALID-PREPROCESSOR"); }; }»,
                سطر_جديد_سي()];
            الناتج := نتيجة.نجح(صل_النصوص(&الأجزاء, &«»));
        };
        طابق الناتج مع
        | نتيجة.نجح(النص) -> {
            دع المكب: نص = متغير_بيئة_سي(«SULTANC_C_DUMP»);
            إذا ((الطول(المكب) مثل طبيعي) > 0) { دع الكتابة: نتيجة عدد, عدد = اكتب_الملف(&المكب, &النص); };
            أرجع نتيجة.نجح(النص);
        }
        | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(الرمز); };
    };
}

عرف سطر_جديد_سي(): نص { دع البايتات: متجه ط8 = [10]; أرجع البايتات مثل نص; }

عرف متغير_بيئة_سي(الاسم: نص): نص {
    طابق متغير_بيئة_النظام(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { أرجع القيمة; }
    | _ -> { أرجع «»; };
}

// `cc -E -dD` of الملف (the explicitly selected external preprocessor).
عرف عالج_بمترجم_سي(الملف: &نص): نتيجة نص, عدد {
    دع المؤقت: نص = مسار_مؤقت_سي(«.i»);
    دع الوسائط: متغير متجه نص = [];
    ألحق(الوسائط, «-E»);
    ألحق(الوسائط, «-dD»);
    ألحق(الوسائط, «-I»);
    ألحق(الوسائط, دليل_مسار_جسر(الملف));
    ألحق(الوسائط, «-o»);
    ألحق(الوسائط, انسخ_نص(&المؤقت));
    ألحق(الوسائط, انسخ_نص(الملف));
    إذا (!شغل_مترجم_سي(&الوسائط)) {
        دع الحذف: نتيجة عدد, عدد = أزل_ملفا(&المؤقت);
        أرجع نتيجة.خطأ(5);
    };
    دع القراءة: نتيجة نص, عدد = اقرأ_الملف(&المؤقت);
    دع الحذف: نتيجة عدد, عدد = أزل_ملفا(&المؤقت);
    أرجع القراءة;
}

// Compiles the C file an import of المسار names to an object file in the
// temporary directory; none when it is not found or does not compile
// (كائن_مصدر_سي_بحالة says why).
عام عرف كائن_مصدر_سي(المسار: &نص): اختياري نص {
    طابق كائن_مصدر_سي_بحالة(المسار) مع
    | نتيجة.نجح(الكائن) -> { أرجع اختياري.موجود(الكائن); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// As كائن_مصدر_سي, with the reason it failed: the C compiler's exit
// status or signal among them.
عام عرف كائن_مصدر_سي_بحالة(المسار: &نص): نتيجة نص, فشل_كائن_سي {
    طابق حدد_ملف_سي(المسار) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(فشل_كائن_سي.ملف_مفقود()); }
    | اختياري.موجود(الملف) -> {
        دع الكائن: نص = مسار_مؤقت_سي(«.o»);
        دع الوسائط: متغير متجه نص = [];
        ألحق(الوسائط, «-c»);
        ألحق(الوسائط, «-O2»);
        ألحق(الوسائط, «-fPIC»);
        ألحق(الوسائط, «-I»);
        ألحق(الوسائط, دليل_مسار_جسر(&الملف));
        ألحق(الوسائط, «-o»);
        ألحق(الوسائط, انسخ_نص(&الكائن));
        ألحق(الوسائط, انسخ_نص(&الملف));
        طابق شغل_مترجم_سي_بحالة(&الوسائط) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الكائن); }
        | نتيجة.خطأ(السبب) -> {
            دع الحذف: نتيجة عدد, عدد = أزل_ملفا(&الكائن);
            أرجع نتيجة.خطأ(السبب);
        };
    };
}
