// std.async under `sultanc run`: the context switch as a switch of frame
// stacks. The interpreter owns its frames, so a task is one more stack of
// frames and switching to it needs no machine code.
//
// std's switch routine (بدل_سياق_المهام_التشغيل, the program's
// دالة_تبديل_سياق_المهام) is called with the word to save the current
// context in and the context to resume. Native code saves a stack pointer;
// here the current stack of frames is set aside in a table and the word
// receives its token (a tagged index, never a mappable address). The
// context to resume is a token from an earlier switch, or the stack of a
// new task that std laid out (ابن_إطار_بداية_مهمة): its entry closure's
// address is in the saved-register slot the trampoline reads. Called with
// no context, the routine answers a nonzero trampoline, so std sees that
// tasks switch.
//
// Closure addresses (بدائي_عنوان_دالة / بدائي_دالة_من_عنوان) are tagged
// handles of the interpreter's closures.

عرف وسم_سياق_مهمة_مفسر(): طبيعي { أرجع 0xC5A5000000000000; }
عرف وسم_إغلاق_عنوان_مفسر(): طبيعي { أرجع 0xC1A5000000000000; }
عرف وسم_دالة_عنوان_مفسر(): طبيعي { أرجع 0xC0A5000000000000; }
عرف قناع_وسم_مفسر(): طبيعي { أرجع 0xFFFF000000000000; }

عام عرف دالة_تبديل_مهام_مفسر(المسير: &سياق_مستهلك_مسير, الدالة: معرف_دالة_مسير): منطقي {
    طابق (*المسير).المسير.دالة_تبديل_سياق_المهام مع
    | اختياري.موجود(المعرف) -> { أرجع المعرف.القيمة == الدالة.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The address word of a function value (a closure keeps one more reference
// for the address, as the native environment does).
عام عرف عنوان_قيمة_دالة_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر, القيمة: &قيمة_تشغيل): اختياري طبيعي {
    طابق *القيمة مع
    | قيمة_تشغيل.إغلاق(المعرف) -> {
        إذا (المعرف.القيمة >= 0x100000000 || المعرف.الجيل >= 0x10000) { أرجع اختياري.لا_شيء(); };
        إذا (!زد_مراجع_إغلاق_مفسر(&متغير (*الحالة).الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(وسم_إغلاق_عنوان_مفسر() | (المعرف.الجيل << 32) | المعرف.القيمة);
    }
    | قيمة_تشغيل.دالة(الدالة) -> {
        أرجع اختياري.موجود(وسم_دالة_عنوان_مفسر() | (الدالة.القيمة مثل طبيعي));
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The function value at an address word (it takes over the address's
// reference).
عام عرف قيمة_دالة_من_عنوان_مفسر(العنوان: طبيعي): اختياري قيمة_تشغيل {
    إذا ((العنوان & قناع_وسم_مفسر()) == وسم_إغلاق_عنوان_مفسر()) {
        دع المعرف: معرف_إغلاق_مفسر = {
            القيمة: العنوان & 0xFFFFFFFF,
            الجيل: (العنوان >> 32) & 0xFFFF
        };
        أرجع اختياري.موجود(قيمة_تشغيل.إغلاق(المعرف));
    };
    إذا ((العنوان & قناع_وسم_مفسر()) == وسم_دالة_عنوان_مفسر()) {
        أرجع اختياري.موجود(قيمة_تشغيل.دالة(معرف_دالة_مسير_من(العنوان & 0xFFFFFFFFFFFF)));
    };
    أرجع اختياري.لا_شيء();
}

عرف إذا_متاحة_مهام_مفسر(): طبيعي {
    إذا (ذاكرة_آلة_مضيف_متاحة()) { أرجع 1; };
    أرجع 0;
}

عرف فشل_تبديل_مهام_مفسر(): فشل_تفسير_مسير {
    أرجع فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف());
}

// The saved-register word std's first task frame keeps the entry closure in
// (r12 at +24 on x86_64, x19 at +0 on arm64).
عرف إزاحة_إغلاق_إطار_مهمة_مفسر(الحالة: &حالة_تنفيذ_مفسر): ط64 {
    طابق (*الحالة).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع 0; }
    | _ -> { أرجع 24; };
}

// One call of the switch routine, from the frame at موضع_المتصل.
عام عرف بدل_سياق_مهام_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الوجهة: اختياري معرف_قيمة_مسير,
    موضع_المتصل: طبيعي
): اختياري فشل_تفسير_مسير {
    إذا ((الطول(*معرفات_الحجج) مثل طبيعي) != 2) { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
    دع الحفظ: قيمة_تشغيل;
    طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_المتصل], (*معرفات_الحجج)[0]) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> { الحفظ := القيمة; };
    دع الجديد: طبيعي;
    طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_المتصل], (*معرفات_الحجج)[1]) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة_قراءة_قيمة_خانة.موجودة(قيمة_تشغيل.بتات_عدد(البتات)) -> { الجديد := البتات; }
    | نتيجة_قراءة_قيمة_خانة.موجودة(_) -> { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
    زد_مؤشر_تعليمة_مفسر(الحالة, موضع_المتصل);
    // The probe: a nonzero trampoline (std writes it into new task frames;
    // this switch does not need it). std reserves a task's stack and lays
    // out its first frame in machine memory, which the interpreter reaches
    // only where the host lets it (Linux, through /proc/self/mem): elsewhere
    // (macOS, Windows) the probe answers 0 and each task runs to completion
    // when it is started, as on targets without a switch.
    إذا (الجديد == 0) {
        دع المنصة: طبيعي = إذا_متاحة_مهام_مفسر();
        طابق الوجهة مع
        | اختياري.موجود(المعرف) -> {
            طابق اكتب_قيمة_خانة_مسير(&متغير (*الحالة).المكدس[موضع_المتصل], المعرف, قيمة_تشغيل.بتات_عدد(المنصة)) مع
            | نتيجة_كتابة_خانة.نجحت -> { }
            | نتيجة_كتابة_خانة.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        }
        | اختياري.لا_شيء -> { };
        أرجع اختياري.لا_شيء();
    };
    // What runs next: a suspended context, or a new task's entry closure.
    دع المستأنف: متغير طبيعي = 0;
    دع المستأنف_موجود: متغير منطقي = خطأ;
    دع الإغلاق: متغير اختياري معرف_إغلاق_مفسر = اختياري.لا_شيء();
    دع دالة_المدخل: متغير اختياري معرف_دالة_مسير = اختياري.لا_شيء();
    إذا ((الجديد & قناع_وسم_مفسر()) == وسم_سياق_مهمة_مفسر()) {
        المستأنف := الجديد & 0xFFFFFFFFFFFF;
        إذا (المستأنف >= (الطول((*الحالة).الذاكرة.سياقات_المهام) مثل طبيعي) || !(*الحالة).الذاكرة.سياقات_المهام[المستأنف].مشغول) {
            أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر());
        };
        المستأنف_موجود := صواب;
    } وإلا {
        إذا (!ذاكرة_آلة_مضيف_متاحة()) { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
        إذا (الجديد < 4096 || (الجديد >> 47) != 0) { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
        دع العنوان: ط64 = اقرأ_ذاكرة_آلة_مضيف((الجديد مثل ط64) + إزاحة_إغلاق_إطار_مهمة_مفسر(الحالة));
        طابق قيمة_دالة_من_عنوان_مفسر(العنوان مثل طبيعي) مع
        | اختياري.موجود(قيمة_تشغيل.إغلاق(المعرف)) -> {
            طابق دالة_إغلاق_مفسر_عند(&(*الحالة).الذاكرة, المعرف) مع
            | اختياري.موجود(الدالة) -> { دالة_المدخل := اختياري.موجود(الدالة); الإغلاق := اختياري.موجود(المعرف); }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
        }
        | اختياري.موجود(قيمة_تشغيل.دالة(الدالة)) -> { دالة_المدخل := اختياري.موجود(الدالة); }
        | _ -> { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
    };
    // A task stack's save word holds one live context: one saved there
    // before and never resumed belonged to a task that finished.
    دع عنوان_الحفظ: متغير طبيعي = 0;
    طابق الحفظ مع
    | قيمة_تشغيل.بتات_عدد(العنوان) -> { عنوان_الحفظ := العنوان; }
    | _ -> { };
    إذا (عنوان_الحفظ != 0) {
        دع ق: متغير طبيعي = 0;
        طالما (ق < (الطول((*الحالة).الذاكرة.سياقات_المهام) مثل طبيعي)) {
            إذا ((*الحالة).الذاكرة.سياقات_المهام[ق].مشغول && (*الحالة).الذاكرة.سياقات_المهام[ق].العنوان == عنوان_الحفظ
                && (!المستأنف_موجود || ق != المستأنف)) {
                دع الفارغ: متغير متجه إطار_تفسير_مسير = [];
                بدّل((*الحالة).الذاكرة.سياقات_المهام[ق].المكدس, الفارغ);
                (*الحالة).الذاكرة.سياقات_المهام[ق].مشغول := خطأ;
            };
            ق := ق + 1;
        }
    };
    // Set the current stack aside and leave its token in the save word.
    دع الخانة: متغير طبيعي = 0;
    طالما (الخانة < (الطول((*الحالة).الذاكرة.سياقات_المهام) مثل طبيعي) && (*الحالة).الذاكرة.سياقات_المهام[الخانة].مشغول) {
        الخانة := الخانة + 1;
    }
    دع الرمز: طبيعي = وسم_سياق_مهمة_مفسر() | الخانة;
    طابق الحفظ مع
    | قيمة_تشغيل.مرجع(المكان) -> {
        طابق اكتب_مكان_مفسر(
            &متغير (*الحالة).المكدس, عمق_مكدس_مفسر(الحالة), &متغير (*الحالة).الذاكرة,
            &المكان, قيمة_تشغيل.بتات_عدد(الرمز)
        ) مع
        | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { }
        | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    }
    | قيمة_تشغيل.بتات_عدد(العنوان) -> {
        إذا (!ذاكرة_آلة_مضيف_متاحة() || العنوان < 4096 || (العنوان >> 47) != 0) { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
        اكتب_ذاكرة_آلة_مضيف(العنوان مثل ط64, الرمز مثل ط64);
    }
    | _ -> { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
    دع المأخوذ: متغير متجه إطار_تفسير_مسير = [];
    بدّل((*الحالة).المكدس, المأخوذ);
    دع المحفوظ: سياق_مهمة_مفسر = {
        المكدس: المأخوذ, العمق: (*الحالة).عمق_المكدس, الوجهة: الوجهة, مشغول: صواب,
        العنوان: عنوان_الحفظ
    };
    إذا (الخانة < (الطول((*الحالة).الذاكرة.سياقات_المهام) مثل طبيعي)) {
        (*الحالة).الذاكرة.سياقات_المهام[الخانة] := المحفوظ;
    } وإلا {
        ألحق((*الحالة).الذاكرة.سياقات_المهام, المحفوظ);
    };
    (*الحالة).عمق_المكدس := 0;
    إذا (المستأنف_موجود) {
        دع المستعاد: متغير متجه إطار_تفسير_مسير = [];
        بدّل((*الحالة).الذاكرة.سياقات_المهام[المستأنف].المكدس, المستعاد);
        بدّل((*الحالة).المكدس, المستعاد);
        (*الحالة).عمق_المكدس := (*الحالة).الذاكرة.سياقات_المهام[المستأنف].العمق;
        (*الحالة).الذاكرة.سياقات_المهام[المستأنف].مشغول := خطأ;
        دع العمق: طبيعي = (*الحالة).عمق_المكدس;
        إذا (العمق == 0) { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
        // The suspended switch call returns 0.
        طابق (*الحالة).الذاكرة.سياقات_المهام[المستأنف].الوجهة مع
        | اختياري.موجود(المعرف) -> {
            طابق اكتب_قيمة_خانة_مسير(&متغير (*الحالة).المكدس[العمق - 1], المعرف, قيمة_تشغيل.بتات_عدد(0)) مع
            | نتيجة_كتابة_خانة.نجحت -> { }
            | نتيجة_كتابة_خانة.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        }
        | اختياري.لا_شيء -> { };
        أرجع اختياري.لا_شيء();
    };
    طابق دالة_المدخل مع
    | اختياري.موجود(الدالة) -> {
        إذا (!هيئ_واصف_دالة_مفسر(الحالة, المسير, الأنواع, الدالة)) { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
        دع الموضع: طبيعي = ادخل_إطار_دالة_مفسر(الحالة, الدالة, الإغلاق, اختياري.لا_شيء());
    }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(فشل_تبديل_مهام_مفسر()); };
    أرجع اختياري.لا_شيء();
}
