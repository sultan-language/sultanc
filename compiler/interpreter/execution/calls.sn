استورد compiler.interpreter.execution.execution_state;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.execution.foreign_calls;
استورد compiler.interpreter.execution.primitives;
استورد compiler.interpreter.execution.task_switch;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.runtime_failures;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.interpreter.memory.memory;
استورد compiler.runtime.primitive_semantic_contract;
استورد compiler.runtime.primitive_identity;

// Frames an interpreted program may have live at once. A native SultanC
// program has an 8 MiB main stack by default, a few hundred thousand frames
// of ordinary functions; this allows the same order of recursion depth.
عام عرف حد_أطر_تشغيل_مفسر(): طبيعي {
    أرجع 250000;
}

عام نوع نتيجة_نداء_مفسر =
    | استمر
    | أنهى_العملية بنوع طبيعي
    | أخفق بنوع فشل_تفسير_مسير
;

عام نوع نتيجة_إرجاع_مفسر =
    | استمر
    | اكتمل بنوع اختياري قيمة_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;


نوع نتيجة_إنشاء_إطار_مفسر =
    | موجود بنوع إطار_تفسير_مسير
    | أخفق بنوع فشل_تفسير_مسير
;

عرف أنشئ_إطار_دالة_مفسر(
    المسير: &سياق_مستهلك_مسير,
    التفعيل: معرف_تفعيل_مفسر,
    الدالة: معرف_دالة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    الإغلاق: اختياري معرف_إغلاق_مفسر,
    الاستمرار: اختياري استمرار_إرجاع_مفسر,
    الخانات_المعادة: متجه خانة_تنفيذ_مسير
): نتيجة_إنشاء_إطار_مفسر {
    طابق ابحث_دالة_مسير(المسير, الدالة) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(_) -> {
        أرجع نتيجة_إنشاء_إطار_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.دالة_مفقودة(الدالة))
        );
    }
    | نتيجة_بحث_دالة_مسير.موجودة(عرض_الدالة) -> {
        دع عدد_الحجج: طبيعي = الطول(*الحجج) مثل طبيعي;
        إذا (عدد_الحجج != عرض_الدالة.عدد_المعاملات) {
            أرجع نتيجة_إنشاء_إطار_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.عدد_حجج_غير_متسق(
                        عرض_الدالة.عدد_المعاملات,
                        عدد_الحجج
                    )
                )
            );
        };

        دع المدخل: معرف_كتلة_مسير;
        طابق عرض_الدالة.المدخل مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_إنشاء_إطار_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.مدخل_دالة_مفقود(الدالة)
                )
            );
        }
        | اختياري.موجود(القيمة) -> {
            المدخل := القيمة;
        };

        // Verified MSIR owns one dense canonical Value-ID table per function.
        // Consume its size directly instead of rescanning every block on each activation.
        دع عدد_الخانات: طبيعي;
        طابق عدد_قيم_دالة_مسير(المسير, الدالة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_إنشاء_إطار_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.دالة_مفقودة(الدالة))
            );
        }
        | اختياري.موجود(القيمة) -> {
            عدد_الخانات := القيمة;
        };

        // The slot table of a frame that returned is reused (its slots are
        // reset), so a call allocates no new table once the stack is warm.
        دع الخانات: متغير متجه خانة_تنفيذ_مسير = الخانات_المعادة;
        دع ف: متغير طبيعي = 0;
        دع الموجودة: طبيعي = الطول(الخانات) مثل طبيعي;
        طالما (ف < عدد_الخانات && ف < الموجودة) {
            الخانات[ف] := خانة_تنفيذ_مسير.غير_مهيأة();
            ف := ف + 1;
        }
        طالما (ف < عدد_الخانات) {
            ألحق(الخانات, خانة_تنفيذ_مسير.غير_مهيأة());
            ف := ف + 1;
        }
        دع المحليات: متجه خلية_محلية_مفسر = [];
        دع الإطار: متغير إطار_تفسير_مسير = {
            التفعيل: التفعيل,
            الدالة: الدالة,
            الكتلة: المدخل,
            مؤشر_التعليمة: 0,
            الخانات: الخانات,
            المحليات: المحليات,
            عدد_المحليات: 0,
            الإغلاق: الإغلاق,
            الاستمرار: الاستمرار
        };

        دع ح: متغير طبيعي = 0;
        طالما (ح < عدد_الحجج) {
            طابق معامل_دالة_مسير_عند(المسير, الدالة, ح) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_إنشاء_إطار_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.معامل_دالة_مفقود(الدالة, ح)
                    )
                );
            }
            | اختياري.موجود(المعامل) -> {
                دع قيمة_الحجة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&(*الحجج)[ح]);
                طابق اكتب_قيمة_خانة_مسير(&متغير الإطار, المعامل.المعرف, قيمة_الحجة) مع
                | نتيجة_كتابة_خانة.نجحت -> { }
                | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
                    أرجع نتيجة_إنشاء_إطار_مفسر.أخفق(الخطأ);
                };
            };
            ح := ح + 1;
        }
        أرجع نتيجة_إنشاء_إطار_مفسر.موجود(الإطار);
    };
}

عام عرف ابدأ_دالة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل
): اختياري فشل_تفسير_مسير {
    دع صالح: منطقي = هيئ_واصف_دالة_مفسر(الحالة, المسير, الأنواع, الدالة);
    دع التفعيل: معرف_تفعيل_مفسر = خذ_معرف_تفعيل_مفسر(الحالة);
    دع بلا_خانات: متجه خانة_تنفيذ_مسير = [];
    طابق أنشئ_إطار_دالة_مفسر(
        المسير,
        التفعيل,
        الدالة,
        &الحجج,
        اختياري.لا_شيء(),
        اختياري.لا_شيء(),
        بلا_خانات
    ) مع
    | نتيجة_إنشاء_إطار_مفسر.أخفق(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_إنشاء_إطار_مفسر.موجود(الإطار) -> {
        ادفع_إطار_مفسر(الحالة, الإطار);
        أرجع اختياري.لا_شيء();
    };
}

عرف نفذ_نداء_دالة_سلطان_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الدالة: معرف_دالة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    الإغلاق: اختياري معرف_إغلاق_مفسر,
    الوجهة: اختياري معرف_قيمة_مسير
): نتيجة_نداء_مفسر {
    دع التفعيل: معرف_تفعيل_مفسر = خذ_معرف_تفعيل_مفسر(الحالة);
    دع الاستمرار: استمرار_إرجاع_مفسر = { الوجهة: الوجهة };
    // Bound recursive compile-time function calls before allocating a new frame.
    دع تقييم_مسبق: منطقي = نمط_تقييم_مسبق_مفسر(الحالة);
    إذا (تقييم_مسبق &&
        عدد_أطر_مفسر(الحالة) >= (*الحالة).حد_أطر_وقت_الترجمة) {
        أرجع نتيجة_نداء_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_عمق_النداء()
            )
        );
    };
    // Unbounded recursion ends with a runtime failure at a fixed frame
    // limit, as CPython's recursion limit and Lua's LUAI_MAXCCALLS do, rather
    // than growing the heap-allocated frame stack until host memory runs out.
    إذا (!تقييم_مسبق &&
        عدد_أطر_مفسر(الحالة) >= حد_أطر_تشغيل_مفسر()) {
        أرجع نتيجة_نداء_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.تجاوز_عمق_النداء(حد_أطر_تشغيل_مفسر())
            )
        );
    };
    دع الإطار_الجديد: إطار_تفسير_مسير;
    دع المعادة: متغير متجه خانة_تنفيذ_مسير = [];
    دع الموضع_الجديد: طبيعي = عدد_أطر_مفسر(الحالة);
    دع المكدس_المرجع: &متجه إطار_تفسير_مسير = &(*الحالة).المكدس;
    دع سعة_المكدس: طبيعي = الطول(*المكدس_المرجع) مثل طبيعي;
    إذا (الموضع_الجديد < سعة_المكدس) {
        بدّل((*الحالة).المكدس[الموضع_الجديد].الخانات, المعادة);
    };
    طابق أنشئ_إطار_دالة_مفسر(
        المسير,
        التفعيل,
        الدالة,
        الحجج,
        الإغلاق,
        اختياري.موجود(الاستمرار),
        المعادة
    ) مع
    | نتيجة_إنشاء_إطار_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_نداء_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إنشاء_إطار_مفسر.موجود(الإطار) -> {
        الإطار_الجديد := الإطار;
    };

    دع موضع_المتصل: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_نداء_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(الموضع) -> {
        موضع_المتصل := الموضع;
    };
    زد_مؤشر_تعليمة_مفسر(الحالة, موضع_المتصل);

    ادفع_إطار_مفسر(الحالة, الإطار_الجديد);
    أرجع نتيجة_نداء_مفسر.استمر();
}

عرف أكمل_تنفيذ_نداء_داخلي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: طبيعي,
    الوجهة: اختياري معرف_قيمة_مسير,
    النتيجة: نتيجة_تنفيذ_بدائي_مفسر
): نتيجة_نداء_مفسر {
    طابق النتيجة مع
    | نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_نداء_مفسر.أخفق(الخطأ);
    }
    | نتيجة_تنفيذ_بدائي_مفسر.أنهى_العملية(الحالة_الخامة) -> {
        أرجع نتيجة_نداء_مفسر.أنهى_العملية(الحالة_الخامة);
    }
    | نتيجة_تنفيذ_بدائي_مفسر.عاد(الناتج) -> {
        طابق الوجهة مع
        | اختياري.لا_شيء -> {
            طابق الناتج مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(_) -> {
                أرجع نتيجة_نداء_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
                    )
                );
            };
        }
        | اختياري.موجود(معرف_الوجهة) -> {
            طابق الناتج مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_نداء_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة()
                    )
                );
            }
            | اختياري.موجود(القيمة) -> {
                طابق اكتب_قيمة_خانة_مسير(
                    &متغير (*الحالة).المكدس[موضع_الإطار],
                    معرف_الوجهة,
                    القيمة
                ) مع
                | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
                    أرجع نتيجة_نداء_مفسر.أخفق(الخطأ);
                }
                | نتيجة_كتابة_خانة.نجحت -> { };
            };
        };
        زد_مؤشر_تعليمة_مفسر(الحالة, موضع_الإطار);
        أرجع نتيجة_نداء_مفسر.استمر();
    };
}

// The value of an argument slot: a reference is copied into المعادة, any
// other value as the checked read copies it.
عرف قيمة_حجة_مفسر(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير,
    المعادة: متجه إسقاط_مكان_تشغيل
): نتيجة_قراءة_قيمة_خانة {
    إذا ((*الإطار).الدالة.القيمة == المعرف.الدالة.القيمة
        && (المعرف.القيمة مثل طبيعي) < (الطول((*الإطار).الخانات) مثل طبيعي)) {
        طابق (*الإطار).الخانات[المعرف.القيمة] مع
        | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.مرجع(المكان)) -> {
            أرجع نتيجة_قراءة_قيمة_خانة.موجودة(قيمة_تشغيل.مرجع(مكان_منسوخ_في(&المكان, المعادة, صواب)));
        }
        | _ -> { };
    };
    أرجع اقرأ_قيمة_خانة_مسير(الإطار, المعرف);
}

// The direct call of a SultanC function: each operand is read from the
// caller's slot straight into the callee's parameter slot, in a frame that
// reuses its stack position's tables (no argument vector, no new table), as
// a register VM copies arguments into the callee's registers. Answers
// لا_شيء when the callee's descriptor is not valid or the arity differs;
// the checked path then reports the inconsistency.
عرف نفذ_نداء_سلطان_مباشر_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الإغلاق: اختياري معرف_إغلاق_مفسر,
    الوجهة: اختياري معرف_قيمة_مسير,
    موضع_المتصل: طبيعي
): اختياري نتيجة_نداء_مفسر {
    إذا (!هيئ_واصف_دالة_مفسر(الحالة, المسير, الأنواع, الدالة)) { أرجع اختياري.لا_شيء(); };
    دع عدد_الحجج: طبيعي = الطول(*معرفات_الحجج) مثل طبيعي;
    إذا (عدد_الحجج != (الطول((*الحالة).واصفات_الدوال[الدالة.القيمة].المعاملات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع تقييم_مسبق: منطقي = نمط_تقييم_مسبق_مفسر(الحالة);
    إذا (تقييم_مسبق &&
        عدد_أطر_مفسر(الحالة) >= (*الحالة).حد_أطر_وقت_الترجمة) {
        أرجع اختياري.موجود(نتيجة_نداء_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_عمق_النداء()
            )
        ));
    };
    إذا (!تقييم_مسبق &&
        عدد_أطر_مفسر(الحالة) >= حد_أطر_تشغيل_مفسر()) {
        أرجع اختياري.موجود(نتيجة_نداء_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.تجاوز_عمق_النداء(حد_أطر_تشغيل_مفسر())
            )
        ));
    };
    دع الاستمرار: استمرار_إرجاع_مفسر = { الوجهة: الوجهة };
    زد_مؤشر_تعليمة_مفسر(الحالة, موضع_المتصل);
    دع الموضع: طبيعي = ادخل_إطار_دالة_مفسر(
        الحالة, الدالة, الإغلاق, اختياري.موجود(الاستمرار)
    );
    دع ح: متغير طبيعي = 0;
    طالما (ح < عدد_الحجج) {
        دع المعامل: طبيعي = (*الحالة).واصفات_الدوال[الدالة.القيمة].المعاملات[ح];
        // A reference argument is copied into the projection vector the
        // parameter slot kept from an earlier activation.
        دع القديمة: متغير خانة_تنفيذ_مسير = خانة_تنفيذ_مسير.غير_مهيأة();
        بدّل((*الحالة).المكدس[الموضع].الخانات[المعامل], القديمة);
        دع المعادة: متجه إسقاط_مكان_تشغيل = إسقاطات_خانة_للإعادة(القديمة);
        دع القيمة: قيمة_تشغيل;
        طابق قيمة_حجة_مفسر(&(*الحالة).المكدس[موضع_المتصل], (*معرفات_الحجج)[ح], المعادة) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع اختياري.موجود(نتيجة_نداء_مفسر.أخفق(الخطأ));
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(المقروءة) -> { القيمة := المقروءة; };
        (*الحالة).المكدس[الموضع].الخانات[المعامل] := خانة_تنفيذ_مسير.قيمة(القيمة);
        ح := ح + 1;
    }
    أرجع اختياري.موجود(نتيجة_نداء_مفسر.استمر());
}

عام عرف نفذ_نداء_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    النداء: &نداء_مسير,
    الوجهة: اختياري معرف_قيمة_مسير
): نتيجة_نداء_مفسر {
    دع وصف_النداء: نداء_مسير = *النداء;
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_نداء_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(الإطار) -> {
        موضع_الإطار := الإطار;
    };

    // SultanC callees take the direct path.
    طابق وصف_النداء.الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(الدالة) -> {
        // One of std's allocation counters (the program's
        // دوال_عدادات_التخصيص): the interpreter's own counts of the
        // program's storage (memory.sn عدادات_التخزين), as the machine
        // interpreter answers it (op 57). std's own counts never move here:
        // the interpreter serves the program's storage itself.
        إذا (!نمط_تقييم_مسبق_مفسر(الحالة)) {
            طابق فهرس_عداد_تخصيص_مفسر(المسير, الدالة) مع
            | اختياري.موجود(النوع) -> {
                طابق الوجهة مع
                | اختياري.موجود(المعرف) -> {
                    دع العدد: طبيعي = عداد_تخزين_مفسر(&(*الحالة).الذاكرة, النوع);
                    طابق اكتب_قيمة_خانة_مسير(&متغير (*الحالة).المكدس[موضع_الإطار], المعرف, قيمة_تشغيل.بتات_عدد(العدد)) مع
                    | نتيجة_كتابة_خانة.نجحت -> { }
                    | نتيجة_كتابة_خانة.أخفق(الخطأ) -> { أرجع نتيجة_نداء_مفسر.أخفق(الخطأ); };
                }
                | اختياري.لا_شيء -> { };
                أرجع نتيجة_نداء_مفسر.استمر();
            }
            | اختياري.لا_شيء -> { };
        };
        // std.async's context switch switches frame stacks (task_switch.sn).
        إذا (!نمط_تقييم_مسبق_مفسر(الحالة) && دالة_تبديل_مهام_مفسر(المسير, الدالة)) {
            طابق بدل_سياق_مهام_مفسر(الحالة, المسير, الأنواع, &وصف_النداء.الحجج, الوجهة, موضع_الإطار) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_نداء_مفسر.أخفق(الخطأ); }
            | اختياري.لا_شيء -> { أرجع نتيجة_نداء_مفسر.استمر(); };
        };
        طابق نفذ_نداء_سلطان_مباشر_مفسر(
            الحالة, المسير, الأنواع, الدالة, &وصف_النداء.الحجج,
            اختياري.لا_شيء(), الوجهة, موضع_الإطار
        ) مع
        | اختياري.موجود(النتيجة) -> { أرجع النتيجة; }
        | اختياري.لا_شيء -> { };
    }
    | هدف_نداء_مسير.قيمة_دالة(معرف_القيمة) -> {
        دع الهدف_المحلول: متغير اختياري معرف_دالة_مسير = اختياري.لا_شيء();
        دع الإغلاق_المحلول: متغير اختياري معرف_إغلاق_مفسر = اختياري.لا_شيء();
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], معرف_القيمة) مع
        | نتيجة_قراءة_قيمة_خانة.موجودة(قيمة_تشغيل.دالة(الدالة)) -> {
            الهدف_المحلول := اختياري.موجود(الدالة);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(قيمة_تشغيل.إغلاق(معرف_الإغلاق)) -> {
            طابق دالة_إغلاق_مفسر_عند(&(*الحالة).الذاكرة, معرف_الإغلاق) مع
            | اختياري.موجود(الدالة) -> {
                الهدف_المحلول := اختياري.موجود(الدالة);
                الإغلاق_المحلول := اختياري.موجود(معرف_الإغلاق);
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        طابق الهدف_المحلول مع
        | اختياري.موجود(الدالة) -> {
            طابق نفذ_نداء_سلطان_مباشر_مفسر(
                الحالة, المسير, الأنواع, الدالة, &وصف_النداء.الحجج,
                الإغلاق_المحلول, الوجهة, موضع_الإطار
            ) مع
            | اختياري.موجود(النتيجة) -> { أرجع النتيجة; }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };

    دع الحجج: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(وصف_النداء.الحجج) مثل طبيعي)) {
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], وصف_النداء.الحجج[ف]) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_نداء_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            ألحق(الحجج, القيمة);
        };
        ف := ف + 1;
    }

    طابق وصف_النداء.الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(الدالة) -> {
        أرجع نفذ_نداء_دالة_سلطان_مفسر(
            الحالة, المسير, الدالة, &الحجج, اختياري.لا_شيء(), الوجهة
        );
    }
    | هدف_نداء_مسير.دالة_خارجية(المعرف) -> {
        // Even if runtime adapters someday support a host foreign call, CTFE
        // never executes it: compiler-time execution must be deterministic.
        إذا (نمط_تقييم_مسبق_مفسر(الحالة)) {
            أرجع نتيجة_نداء_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع()
                )
            );
        };
        // External calls retain their canonical MSIR symbol identity. No
        // deleted OS export is interpreted as a host-service invocation.
        طابق ابحث_دالة_خارجية_مسير(المسير, المعرف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_نداء_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
                )
            );
        }
        | اختياري.موجود(الدالة_الخارجية) -> {
            // A C function std (or the program) declares runs on the host
            // through the foreign-call bridge where the host has one.
            طابق نفذ_نداء_خارجي_مفسر(الحالة, الأنواع, &الدالة_الخارجية, &الحجج) مع
            | اختياري.موجود(النتيجة) -> {
                أرجع أكمل_تنفيذ_نداء_داخلي_مفسر(الحالة, موضع_الإطار, الوجهة, النتيجة);
            }
            | اختياري.لا_شيء -> { };
            دع مرجع_الاسم: &متجه ط8 = &الدالة_الخارجية.الاسم;
            دع الاسم: متغير متجه ط8 = [];
            دع فهرس_الاسم: متغير طبيعي = 0;
            طالما (فهرس_الاسم < (الطول(*مرجع_الاسم) مثل طبيعي)) {
                ألحق(الاسم, (*مرجع_الاسم)[فهرس_الاسم]);
                فهرس_الاسم := فهرس_الاسم + 1;
            }
            أرجع نتيجة_نداء_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.نداء_خارجي_غير_مدعوم(المعرف, الاسم)
                )
            );
        };
    }
    | هدف_نداء_مسير.قيمة_دالة(معرف_القيمة) -> {
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], معرف_القيمة) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_نداء_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            طابق القيمة مع
            | قيمة_تشغيل.دالة(الدالة) -> {
                أرجع نفذ_نداء_دالة_سلطان_مفسر(
                    الحالة, المسير, الدالة, &الحجج, اختياري.لا_شيء(), الوجهة
                );
            }
            | قيمة_تشغيل.إغلاق(معرف_الإغلاق) -> {
                طابق دالة_إغلاق_مفسر_عند(&(*الحالة).الذاكرة, معرف_الإغلاق) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_نداء_مفسر.أخفق(
                        فشل_تفسير_مسير.خلل_داخلي(
                            خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
                        )
                    );
                }
                | اختياري.موجود(الدالة) -> {
                    أرجع نفذ_نداء_دالة_سلطان_مفسر(
                        الحالة, المسير, الدالة, &الحجج,
                        اختياري.موجود(معرف_الإغلاق), الوجهة
                    );
                };
            }
            | _ -> {
                أرجع نتيجة_نداء_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
                    )
                );
            };
        };
    }
    | هدف_نداء_مسير.بدائي_مترجم(الهوية) -> {
        // Shared primitive semantics are authoritative: do not invent a
        // separate purity registry for compile-time evaluation.
        إذا (نمط_تقييم_مسبق_مفسر(الحالة)) {
            دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(الهوية);
            // Changing a value the evaluation owns (append, swap, a vector's
            // length after pop or truncate) and releasing the interpreter's
            // own storage (drop glue) observe nothing outside the evaluation.
            // Function values live in the evaluation's own closure table:
            // counting their references, turning one to its destructor and
            // copying a value that holds them observe nothing outside it.
            دع مسموح: منطقي = العقد.الأثر == تصنيف_أثر_بدائي.نقي()
                || العقد.الأثر == تصنيف_أثر_بدائي.تعديل_قيمة()
                || هويتا_بدائي_مترجم_متساويتان(الهوية, هوية_بدائي_مترجم.تحرير())
                || هويتا_بدائي_مترجم_متساويتان(الهوية, هوية_بدائي_مترجم.زيادة_مراجع_إغلاق())
                || هويتا_بدائي_مترجم_متساويتان(الهوية, هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق())
                || هويتا_بدائي_مترجم_متساويتان(الهوية, هوية_بدائي_مترجم.مدمر_بيئة_إغلاق())
                || هويتا_بدائي_مترجم_متساويتان(الهوية, هوية_بدائي_مترجم.احتفاظ_بقيمة());
            إذا (!مسموح) {
                أرجع نتيجة_نداء_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع()
                    )
                );
            };
            // Compiler/toolchain and link-address primitives can be classified
            // pure while still observing host state or build configuration.
            طابق الهوية مع
            | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
                أرجع نتيجة_نداء_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع()
                    )
                );
            }
            | _ -> { };
        };
        دع النتيجة: نتيجة_تنفيذ_بدائي_مفسر = نفذ_بدائي_مفسر(
            الحالة,
            موضع_الإطار,
            الأنواع,
            المسير,
            الهوية,
            &وصف_النداء.الحجج,
            &الحجج,
            الوجهة,
            وصف_النداء.مكان_التعديل,
            &وصف_النداء.نطاقات_الذاكرة,
            &وصف_النداء.عقد_النواة
        );
        أرجع أكمل_تنفيذ_نداء_داخلي_مفسر(
            الحالة, موضع_الإطار, الوجهة, النتيجة
        );
    };
}

عام عرف أكمل_إرجاع_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    القيمة: اختياري قيمة_تشغيل
): نتيجة_إرجاع_مفسر {
    دع الدالة_المنتهية: معرف_دالة_مسير;
    دع استمرار_المنتهي: اختياري استمرار_إرجاع_مفسر;
    طابق اسحب_إطار_مفسر(الحالة) مع
    | نتيجة_سحب_إطار.أخفق(الخطأ) -> {
        أرجع نتيجة_إرجاع_مفسر.أخفق(الخطأ);
    }
    | نتيجة_سحب_إطار.مسحوب(الدالة, الاستمرار) -> {
        الدالة_المنتهية := الدالة;
        استمرار_المنتهي := الاستمرار;
    };

    طابق استمرار_المنتهي مع
    | اختياري.لا_شيء -> {
        إذا (عدد_أطر_مفسر(الحالة) != 0) {
            أرجع نتيجة_إرجاع_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.شكل_إرجاع_غير_متسق(الدالة_المنتهية)
                )
            );
        };
        أرجع نتيجة_إرجاع_مفسر.اكتمل(القيمة);
    }
    | اختياري.موجود(الاستمرار) -> {
        دع موضع_المتصل: طبيعي;
        طابق اقرأ_الإطار_النشط(الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
            أرجع نتيجة_إرجاع_مفسر.أخفق(الخطأ);
        }
        | نتيجة_إطار_نشط.موجود(الإطار) -> {
            موضع_المتصل := الإطار;
        };

        طابق الاستمرار.الوجهة مع
        | اختياري.لا_شيء -> {
            طابق القيمة مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(_) -> {
                أرجع نتيجة_إرجاع_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.شكل_إرجاع_غير_متسق(الدالة_المنتهية)
                    )
                );
            };
        }
        | اختياري.موجود(الوجهة) -> {
            طابق القيمة مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_إرجاع_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.شكل_إرجاع_غير_متسق(الدالة_المنتهية)
                    )
                );
            }
            | اختياري.موجود(الناتج) -> {
                طابق اكتب_قيمة_خانة_مسير(&متغير (*الحالة).المكدس[موضع_المتصل], الوجهة, الناتج) مع
                | نتيجة_كتابة_خانة.نجحت -> { }
                | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
                    أرجع نتيجة_إرجاع_مفسر.أخفق(الخطأ);
                };
            };
        };
        أرجع نتيجة_إرجاع_مفسر.استمر();
    };
}

// The kind of std's allocation counter الدالة is (its place in the program's
// دوال_عدادات_التخصيص: 0..3 the process's, 4..7 the thread's), if it is one.
عرف فهرس_عداد_تخصيص_مفسر(المسير: &سياق_مستهلك_مسير, الدالة: معرف_دالة_مسير): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المسير).المسير.دوال_عدادات_التخصيص) مثل طبيعي)) {
        طابق (*المسير).المسير.دوال_عدادات_التخصيص[ف] مع
        | اختياري.موجود(د) -> { إذا (د.القيمة == الدالة.القيمة) { أرجع اختياري.موجود(ف); }; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}
