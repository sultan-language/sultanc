استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.diagnostics.runtime_failures;
استورد compiler.msir.identifiers;

عام نوع استمرار_إرجاع_مفسر = {
    الوجهة: اختيار معرف_قيمة_مسير
};

// Every activation owns one canonical Value-ID indexed slot table plus frame-local storage cells.
عام نوع إطار_تفسير_مسير = {
    التفعيل: معرف_تفعيل_مفسر,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    مؤشر_التعليمة: غير_موقع,
    الخانات: متجه خانة_تنفيذ_مسير,
    المحليات: متجه اختيار قيمة_تشغيل,
    الاستمرار: اختيار استمرار_إرجاع_مفسر
};

عام نوع نتيجة_قراءة_قيمة_خانة =
    | موجودة بنوع قيمة_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;

عام نوع نتيجة_قراءة_مكان_خانة =
    | موجود بنوع مكان_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;

عام نوع نتيجة_كتابة_خانة =
    | نجحت
    | أخفق بنوع فشل_تفسير_مسير
;

عرف تحقق_موضع_خانة(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار فشل_تفسير_مسير {
    دع الحالة: إطار_تفسير_مسير = *الإطار;
    لو (!دالتا_مسير_متساويتان(المعرف.الدالة, الحالة.الدالة)) {
        أرجع اختيار.بعض(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.معرف_خانة_من_دالة_أخرى(الحالة.الدالة, المعرف)
            )
        );
    };
    لو (المعرف.القيمة >= (الطول(الحالة.الخانات) مثل غير_موقع)) {
        أرجع اختيار.بعض(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.معرف_خانة_خارج_المدى(المعرف)
            )
        );
    };
    أرجع اختيار.لا_شيء();
}

عام عرف اقرأ_قيمة_خانة_مسير(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_قراءة_قيمة_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ);
    }
    | اختيار.لا_شيء -> { };
    دع الحالة: إطار_تفسير_مسير = *الإطار;
    طابق الحالة.الخانات[المعرف.القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(القيمة) -> {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
        أرجع نتيجة_قراءة_قيمة_خانة.موجودة(النسخة);
    }
    | خانة_تنفيذ_مسير.غير_مهيأة -> {
        أرجع نتيجة_قراءة_قيمة_خانة.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_غير_مهيأة(المعرف))
        );
    }
    | خانة_تنفيذ_مسير.مكان(_) -> {
        أرجع نتيجة_قراءة_قيمة_خانة.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_ليست_قيمة(المعرف))
        );
    };
}

عام عرف اقرأ_مكان_خانة_مسير(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_قراءة_مكان_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_قراءة_مكان_خانة.أخفق(الخطأ);
    }
    | اختيار.لا_شيء -> { };
    دع الحالة: إطار_تفسير_مسير = *الإطار;
    طابق الحالة.الخانات[المعرف.القيمة] مع
    | خانة_تنفيذ_مسير.مكان(المكان) -> {
        دع النسخة: مكان_تشغيل = انسخ_مكان_تشغيل(&المكان);
        أرجع نتيجة_قراءة_مكان_خانة.موجود(النسخة);
    }
    | خانة_تنفيذ_مسير.غير_مهيأة -> {
        أرجع نتيجة_قراءة_مكان_خانة.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_غير_مهيأة(المعرف))
        );
    }
    | خانة_تنفيذ_مسير.قيمة(_) -> {
        أرجع نتيجة_قراءة_مكان_خانة.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_ليست_مكانا(المعرف))
        );
    };
}

عام عرف اكتب_قيمة_خانة_مسير(
    الإطار: &متغير إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير,
    القيمة: قيمة_تشغيل
): نتيجة_كتابة_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_كتابة_خانة.أخفق(الخطأ);
    }
    | اختيار.لا_شيء -> { };
    دع الحالة: متغير إطار_تفسير_مسير = *الإطار;
    دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
    الحالة.الخانات[المعرف.القيمة] := خانة_تنفيذ_مسير.قيمة(النسخة);
    *الإطار := الحالة;
    أرجع نتيجة_كتابة_خانة.نجحت();
}

عام عرف أبطل_قيمة_خانة_مسير(
    الإطار: &متغير إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_كتابة_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_كتابة_خانة.أخفق(الخطأ);
    }
    | اختيار.لا_شيء -> { };
    دع الحالة: متغير إطار_تفسير_مسير = *الإطار;
    الحالة.الخانات[المعرف.القيمة] := خانة_تنفيذ_مسير.غير_مهيأة();
    *الإطار := الحالة;
    أرجع نتيجة_كتابة_خانة.نجحت();
}

عام عرف اكتب_مكان_خانة_مسير(
    الإطار: &متغير إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير,
    المكان: مكان_تشغيل
): نتيجة_كتابة_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_كتابة_خانة.أخفق(الخطأ);
    }
    | اختيار.لا_شيء -> { };
    دع الحالة: متغير إطار_تفسير_مسير = *الإطار;
    دع النسخة: مكان_تشغيل = انسخ_مكان_تشغيل(&المكان);
    الحالة.الخانات[المعرف.القيمة] := خانة_تنفيذ_مسير.مكان(النسخة);
    *الإطار := الحالة;
    أرجع نتيجة_كتابة_خانة.نجحت();
}

عام عرف انسخ_إطار_تفسير_مسير(الإطار: &إطار_تفسير_مسير): إطار_تفسير_مسير {
    دع القيمة: إطار_تفسير_مسير = *الإطار;
    دع الخانات: متغير متجه خانة_تنفيذ_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.الخانات) مثل غير_موقع)) {
        دع الخانة: خانة_تنفيذ_مسير = انسخ_خانة_تنفيذ_مسير(&القيمة.الخانات[ف]);
        ألحق(الخانات, الخانة);
        ف := ف + 1;
    }
    دع المحليات: متغير متجه اختيار قيمة_تشغيل = [];
    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول(القيمة.المحليات) مثل غير_موقع)) {
        طابق القيمة.المحليات[م] مع
        | اختيار.لا_شيء -> {
            ألحق(المحليات, اختيار.لا_شيء());
        }
        | اختيار.بعض(المحلية) -> {
            دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&المحلية);
            ألحق(المحليات, اختيار.بعض(النسخة));
        };
        م := م + 1;
    }
    دع الاستمرار: اختيار استمرار_إرجاع_مفسر;
    طابق القيمة.الاستمرار مع
    | اختيار.لا_شيء -> {
        الاستمرار := اختيار.لا_شيء();
    }
    | اختيار.بعض(القيمة_الاستمرار) -> {
        دع الوجهة: اختيار معرف_قيمة_مسير = القيمة_الاستمرار.الوجهة;
        دع نسخة_الاستمرار: استمرار_إرجاع_مفسر = { الوجهة: الوجهة };
        الاستمرار := اختيار.بعض(نسخة_الاستمرار);
    };
    دع التفعيل: معرف_تفعيل_مفسر = القيمة.التفعيل;
    دع الدالة: معرف_دالة_مسير = القيمة.الدالة;
    دع الكتلة: معرف_كتلة_مسير = القيمة.الكتلة;
    دع المؤشر: غير_موقع = القيمة.مؤشر_التعليمة;
    دع الناتج: إطار_تفسير_مسير = {
        التفعيل: التفعيل,
        الدالة: الدالة,
        الكتلة: الكتلة,
        مؤشر_التعليمة: المؤشر,
        الخانات: الخانات,
        المحليات: المحليات,
        الاستمرار: الاستمرار
    };
    أرجع الناتج;
}
