استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.runtime_failures;
استورد compiler.msir.identifiers;

عام نوع استمرار_إرجاع_مفسر = {
    الوجهة: اختياري معرف_قيمة_مسير
};

// One frame-local storage cell (a `مكان_محلي`). A cell exists before its
// first store; only the empty projection of an uninitialized cell is valid.
عام نوع خلية_محلية_مفسر = {
    مهيأة: منطقي,
    القيمة: قيمة_تشغيل
};

// Every activation owns one canonical Value-ID indexed slot table plus frame-local storage cells.
// A frame's position in the stack keeps both tables when the frame returns,
// and the next activation at that position reuses them (CPython and Lua
// likewise reuse their frame and register storage): only the first
// عدد_المحليات cells belong to the live activation.
عام نوع إطار_تفسير_مسير = {
    التفعيل: معرف_تفعيل_مفسر,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    مؤشر_التعليمة: طبيعي,
    الخانات: متجه خانة_تنفيذ_مسير,
    المحليات: متجه خلية_محلية_مفسر,
    عدد_المحليات: طبيعي,
    الإغلاق: اختياري معرف_إغلاق_مفسر,
    الاستمرار: اختياري استمرار_إرجاع_مفسر
};

عام نوع نتيجة_قراءة_قيمة_خانة =
    | موجودة بنوع قيمة_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;

عام نوع نتيجة_قراءة_مكان_خانة =
    | موجود بنوع مكان_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;

عام نوع نتيجة_كتابة_خانة =
    | نجحت
    | أخفق بنوع فشل_تفسير_مسير
;

// Slots are read and written through references to the frame's fields: a
// field read through a reference to the whole frame would copy the frame.
عرف تحقق_موضع_خانة(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري فشل_تفسير_مسير {
    دع الدالة: &معرف_دالة_مسير = &(*الإطار).الدالة;
    لو ((*الدالة).القيمة != المعرف.الدالة.القيمة) {
        أرجع اختياري.موجود(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.معرف_خانة_من_دالة_أخرى(*الدالة, المعرف)
            )
        );
    };
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الإطار).الخانات;
    لو (المعرف.القيمة >= (الطول(*الخانات) مثل طبيعي)) {
        أرجع اختياري.موجود(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.معرف_خانة_خارج_المدى(المعرف)
            )
        );
    };
    أرجع اختياري.لا_شيء();
}

عام عرف اقرأ_قيمة_خانة_مسير(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_قراءة_قيمة_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ);
    }
    | اختياري.لا_شيء -> { };
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الإطار).الخانات;
    طابق (*الخانات)[المعرف.القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(القيمة) -> {
        أرجع نتيجة_قراءة_قيمة_خانة.موجودة(انسخ_قيمة_تشغيل(&القيمة));
    }
    | خانة_تنفيذ_مسير.غير_مهيأة -> {
        أرجع نتيجة_قراءة_قيمة_خانة.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_غير_مهيأة(المعرف))
        );
    }
    | خانة_تنفيذ_مسير.مكان(_) -> {
        أرجع نتيجة_قراءة_قيمة_خانة.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_ليست_قيمة(المعرف))
        );
    };
}

عام عرف اقرأ_مكان_خانة_مسير(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_قراءة_مكان_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_قراءة_مكان_خانة.أخفق(الخطأ);
    }
    | اختياري.لا_شيء -> { };
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الإطار).الخانات;
    طابق (*الخانات)[المعرف.القيمة] مع
    | خانة_تنفيذ_مسير.مكان(المكان) -> {
        أرجع نتيجة_قراءة_مكان_خانة.موجود(انسخ_مكان_تشغيل(&المكان));
    }
    | خانة_تنفيذ_مسير.غير_مهيأة -> {
        أرجع نتيجة_قراءة_مكان_خانة.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_غير_مهيأة(المعرف))
        );
    }
    | خانة_تنفيذ_مسير.قيمة(_) -> {
        أرجع نتيجة_قراءة_مكان_خانة.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_ليست_مكانا(المعرف))
        );
    };
}

عام عرف اكتب_قيمة_خانة_مسير(
    الإطار: &متغير إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير,
    القيمة: قيمة_تشغيل
): نتيجة_كتابة_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_كتابة_خانة.أخفق(الخطأ);
    }
    | اختياري.لا_شيء -> { };
    (*الإطار).الخانات[المعرف.القيمة] := خانة_تنفيذ_مسير.قيمة(القيمة);
    أرجع نتيجة_كتابة_خانة.نجحت();
}

عام عرف أبطل_قيمة_خانة_مسير(
    الإطار: &متغير إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_كتابة_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_كتابة_خانة.أخفق(الخطأ);
    }
    | اختياري.لا_شيء -> { };
    (*الإطار).الخانات[المعرف.القيمة] := خانة_تنفيذ_مسير.غير_مهيأة();
    أرجع نتيجة_كتابة_خانة.نجحت();
}

عام عرف اكتب_مكان_خانة_مسير(
    الإطار: &متغير إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير,
    المكان: مكان_تشغيل
): نتيجة_كتابة_خانة {
    طابق تحقق_موضع_خانة(الإطار, المعرف) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_كتابة_خانة.أخفق(الخطأ);
    }
    | اختياري.لا_شيء -> { };
    (*الإطار).الخانات[المعرف.القيمة] := خانة_تنفيذ_مسير.مكان(المكان);
    أرجع نتيجة_كتابة_خانة.نجحت();
}
