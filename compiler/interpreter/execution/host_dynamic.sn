استورد std.text.from_bytes;
استورد std.fs.read_file;
استورد compiler.interpreter.execution.host_memory;

// ---- Dynamic symbols of the foreign-call bridge ------------------------------
// A C function a program declares (`خارجي «library» عرف f(...)`) that is not
// in the generated table of std's externs (host_externs_generated.sn) is
// found at run time and called at its address, as Python's ctypes opens a
// library with dlopen and finds a function with dlsym (Lib/ctypes, Modules/
// _ctypes/callproc.c), Miri's native-lib mode loads the shared object the
// user names, and libffi's ffi_call loads the registers from a prepared
// call interface:
//
// - the library is opened once with the host's loader: dlopen on Linux and
//   macOS (libSystem; glibc 2.34 moved dlopen into libc), LoadLibraryW on
//   Windows; a declaration without a library is looked up in the process's
//   global scope (dlsym(RTLD_DEFAULT)) and then the platform C library
//   (libc.so.6 and libm.so.6, libSystem, msvcrt.dll / ucrtbase.dll /
//   kernel32.dll);
// - the function is called through بدائي_نداء_عنوان_سي, the compiler's one
//   C-call-at-an-address primitive, with a fixed register image: up to eight
//   integer words (integers, booleans, pointers) and eight floating-point
//   words (f32 in the low half of its register), and an integer or a
//   floating-point result. Windows x64 passes the words by position (at most
//   eight arguments in all). A record passed by value has no such image and
//   is reported, as is a signature with more words.
//
// Linux. The native Linux compiler is a static executable without the C
// library, and a process that the kernel started without a dynamic loader
// cannot load a shared object soundly: glibc's libc.so.6 needs ld.so's state
// (its TLS, IFUNC resolution from ld.so's CPU features, its link map), so a
// small ELF loader in SultanC (as Go's linker reads shared objects for
// cgo-free dynamic imports) would work
// only for self-contained objects, not for libc or libm. The interpreter
// therefore calls dynamic C functions only where the host provides a loader,
// as Go programs do (a static Go binary cannot dlopen either): a compiler
// that the system's dynamic loader started (an LLVM-enabled build is linked
// against libLLVM, so the C library is in the process) finds dlopen, dlsym,
// dlerror and __errno_location in the C library already mapped into it
// (/proc/self/maps, then the library's ELF dynamic symbol table), and a
// static compiler reports SULTANC-INTERPRETER-UNSUPPORTED-EXTERNAL-CALL with
// the reason that it has no dynamic loader.

مرادف نادي_عنوان_سي_مضيف = بدائي_نداء_عنوان_سي;
مرادف ع64_من_بتات_مضيف = بدائي_ع64_من_بتات;
مرادف بتات_ع64_مضيف = بدائي_بتات_ع64;

// The C class of an argument or result word.
عام نوع صنف_سي_مضيف =
    // An integer, a boolean or a pointer: one integer word.
    | صحيح
    | عائم32
    | عائم64
;

// The host's dynamic loader, found once (Linux) or always present (macOS,
// Windows). The addresses are those of the C library's own functions.
عام نوع محمل_ديناميكي_مضيف = {
    مهيأ: منطقي,
    متاح: منطقي,
    عنوان_الفتح: ط64,
    عنوان_البحث: ط64,
    عنوان_الخطأ: ط64,
    عنوان_رقم_الخطأ: ط64
};

عام عرف محمل_ديناميكي_مضيف_جديد(): محمل_ديناميكي_مضيف {
    دع المحمل: محمل_ديناميكي_مضيف = {
        مهيأ: خطأ, متاح: خطأ, عنوان_الفتح: 0, عنوان_البحث: 0, عنوان_الخطأ: 0, عنوان_رقم_الخطأ: 0
    };
    أرجع المحمل;
}

// Whether a signature fits the register image: at most eight integer and
// eight floating-point words (Windows x64: eight arguments in all).
عام عرف توقيع_سي_يتسع_مضيف(الأصناف: &متجه صنف_سي_مضيف, موضعي: منطقي): منطقي {
    دع الصحاح: متغير طبيعي = 0;
    دع العشريات: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأصناف) مثل طبيعي)) {
        طابق (*الأصناف)[ف] مع
        | صنف_سي_مضيف.صحيح -> { الصحاح := الصحاح + 1; }
        | _ -> { العشريات := العشريات + 1; };
        ف := ف + 1;
    }
    لو (موضعي) { أرجع الصحاح + العشريات <= 8; };
    أرجع الصحاح <= 8 && العشريات <= 8;
}

// The register image of one call: eight integer words and eight float
// words (bit patterns). System V and AAPCS64 fill each file in argument
// order; Windows x64 (موضعي) puts argument k in integer word k, and the
// primitive's Windows lowering gives the first four to xmm k as well.
عام نوع صورة_سجلات_سي_مضيف = {
    الصحاح: متجه ط64,
    العشريات: متجه ط64
};

عام عرف رتب_صورة_سجلات_سي_مضيف(
    الكلمات: &متجه ط64,
    الأصناف: &متجه صنف_سي_مضيف,
    موضعي: منطقي
): صورة_سجلات_سي_مضيف {
    دع الصحاح: متغير متجه ط64 = [];
    دع العشريات: متغير متجه ط64 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الكلمات) مثل طبيعي)) {
        دع الكلمة: متغير ط64 = (*الكلمات)[ف];
        دع عائم: متغير منطقي = خطأ;
        لو (ف < (الطول(*الأصناف) مثل طبيعي)) {
            طابق (*الأصناف)[ف] مع
            | صنف_سي_مضيف.صحيح -> { }
            | صنف_سي_مضيف.عائم32 -> { الكلمة := الكلمة & 0xFFFFFFFF; عائم := صواب; }
            | صنف_سي_مضيف.عائم64 -> { عائم := صواب; };
        };
        لو (موضعي || !عائم) {
            ألحق(الصحاح, الكلمة);
        } وإلا {
            ألحق(العشريات, الكلمة);
        };
        ف := ف + 1;
    }
    طالما ((الطول(الصحاح) مثل طبيعي) < 8) { ألحق(الصحاح, 0 مثل ط64); }
    طالما ((الطول(العشريات) مثل طبيعي) < 8) { ألحق(العشريات, 0 مثل ط64); }
    دع الصورة: صورة_سجلات_سي_مضيف = { الصحاح: الصحاح, العشريات: العشريات };
    أرجع الصورة;
}

// The hosts whose interpreter calls C at run-time addresses.
لو ((الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))
    || الهدف.المنصة == «macos»
    || (الهدف.المنصة == «windows» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))) {

    // One call of the C function at العنوان. The result is the integer
    // return register, or the bits of the floating-point one (an f32 result
    // in the low half).
    عرف نادي_صورة_سي_مضيف(العنوان: ط64, الصورة: &صورة_سجلات_سي_مضيف, الناتج: صنف_سي_مضيف): ط64 {
        دع ص: &متجه ط64 = &(*الصورة).الصحاح;
        دع ع: &متجه ط64 = &(*الصورة).العشريات;
        طابق الناتج مع
        | صنف_سي_مضيف.صحيح -> {
            دع الكلمة: متغير ط64 = 0;
            غير_آمن {
                الكلمة := نادي_عنوان_سي_مضيف(
                    0 مثل ط64, العنوان,
                    (*ص)[0], (*ص)[1], (*ص)[2], (*ص)[3], (*ص)[4], (*ص)[5], (*ص)[6], (*ص)[7],
                    ع64_من_بتات_مضيف((*ع)[0]), ع64_من_بتات_مضيف((*ع)[1]),
                    ع64_من_بتات_مضيف((*ع)[2]), ع64_من_بتات_مضيف((*ع)[3]),
                    ع64_من_بتات_مضيف((*ع)[4]), ع64_من_بتات_مضيف((*ع)[5]),
                    ع64_من_بتات_مضيف((*ع)[6]), ع64_من_بتات_مضيف((*ع)[7])
                );
            }
            أرجع الكلمة;
        }
        | _ -> {
            دع العشري: متغير ع64 = 0.0;
            غير_آمن {
                العشري := نادي_عنوان_سي_مضيف(
                    0.0, العنوان,
                    (*ص)[0], (*ص)[1], (*ص)[2], (*ص)[3], (*ص)[4], (*ص)[5], (*ص)[6], (*ص)[7],
                    ع64_من_بتات_مضيف((*ع)[0]), ع64_من_بتات_مضيف((*ع)[1]),
                    ع64_من_بتات_مضيف((*ع)[2]), ع64_من_بتات_مضيف((*ع)[3]),
                    ع64_من_بتات_مضيف((*ع)[4]), ع64_من_بتات_مضيف((*ع)[5]),
                    ع64_من_بتات_مضيف((*ع)[6]), ع64_من_بتات_مضيف((*ع)[7])
                );
            }
            دع البتات: ط64 = بتات_ع64_مضيف(العشري);
            طابق الناتج مع
            | صنف_سي_مضيف.عائم32 -> { أرجع البتات & 0xFFFFFFFF; }
            | _ -> { أرجع البتات; };
        };
    }

    // A call with integer words only (the loader's own functions).
    عرف نادي_صحاح_مضيف(العنوان: ط64, الكلمات: &متجه ط64): ط64 {
        دع الأصناف: متغير متجه صنف_سي_مضيف = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الكلمات) مثل طبيعي)) { ألحق(الأصناف, صنف_سي_مضيف.صحيح()); ف := ف + 1; }
        دع الصورة: صورة_سجلات_سي_مضيف = رتب_صورة_سجلات_سي_مضيف(الكلمات, &الأصناف, خطأ);
        أرجع نادي_صورة_سي_مضيف(العنوان, &الصورة, صنف_سي_مضيف.صحيح());
    }
}

لو ((الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))
    || الهدف.المنصة == «macos») {
    عام عرف نادي_عنوان_مضيف(
        العنوان: ط64,
        الكلمات: &متجه ط64,
        الأصناف: &متجه صنف_سي_مضيف,
        الناتج: صنف_سي_مضيف
    ): ط64 {
        دع الصورة: صورة_سجلات_سي_مضيف = رتب_صورة_سجلات_سي_مضيف(الكلمات, الأصناف, خطأ);
        أرجع نادي_صورة_سي_مضيف(العنوان, &الصورة, الناتج);
    }

    عام عرف توقيع_سي_مقبول_مضيف(الأصناف: &متجه صنف_سي_مضيف): منطقي {
        أرجع توقيع_سي_يتسع_مضيف(الأصناف, خطأ);
    }
}

// Windows on Arm is AAPCS64 for a prototyped call (separate register files);
// Windows x64 is positional.
لو (الهدف.المنصة == «windows» && الهدف.المعمارية == «x86_64») {
    عرف موضعي_مضيف(): منطقي { أرجع صواب; }
}
لو (الهدف.المنصة == «windows» && الهدف.المعمارية == «aarch64») {
    عرف موضعي_مضيف(): منطقي { أرجع خطأ; }
}

لو (الهدف.المنصة == «windows» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    عام عرف نادي_عنوان_مضيف(
        العنوان: ط64,
        الكلمات: &متجه ط64,
        الأصناف: &متجه صنف_سي_مضيف,
        الناتج: صنف_سي_مضيف
    ): ط64 {
        دع الصورة: صورة_سجلات_سي_مضيف = رتب_صورة_سجلات_سي_مضيف(الكلمات, الأصناف, موضعي_مضيف());
        أرجع نادي_صورة_سي_مضيف(العنوان, &الصورة, الناتج);
    }

    عام عرف توقيع_سي_مقبول_مضيف(الأصناف: &متجه صنف_سي_مضيف): منطقي {
        أرجع توقيع_سي_يتسع_مضيف(الأصناف, موضعي_مضيف());
    }
}

// A NUL-terminated copy of النص's bytes.
عرف نص_سي_مضيف(البايتات: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) { ألحق(الناتج, (*البايتات)[ف]); ف := ف + 1; }
    ألحق(الناتج, 0 مثل ط8);
    أرجع الناتج;
}

// The bytes of the C string at العنوان (at most 1024), read one at a time so
// that no read crosses past its end.
عرف اقرأ_نص_سي_مضيف(العنوان: ط64): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    لو (العنوان == 0) { أرجع الناتج; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < 1024) {
        دع البايت: متجه ط8 = اقرأ_بايتات_مضيف(العنوان + (ف مثل ط64), 1);
        لو ((الطول(البايت) مثل طبيعي) == 0 || البايت[0] == 0) { أرجع الناتج; };
        ألحق(الناتج, البايت[0]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف بايتات_تبدأ_بـ_مضيف(البايتات: &متجه ط8, البداية: طبيعي, البادئة: &نص): منطقي {
    لو ((الطول(*البايتات) مثل طبيعي) < البداية + (الطول(*البادئة) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البادئة) مثل طبيعي)) {
        لو ((*البايتات)[البداية + ف] != (*البادئة)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

لو (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    // A little-endian word of العرض bytes at الموضع (0 past the end).
    عرف كلمة_إلف_مضيف(البايتات: &متجه ط8, الموضع: طبيعي, العرض: طبيعي): طبيعي {
        لو (الموضع + العرض > (الطول(*البايتات) مثل طبيعي)) { أرجع 0; };
        دع الناتج: متغير طبيعي = 0;
        دع ب: متغير طبيعي = 0;
        طالما (ب < العرض) {
            الناتج := الناتج | (((*البايتات)[الموضع + ب] مثل طبيعي) << (8 * ب));
            ب := ب + 1;
        }
        أرجع الناتج;
    }

    // The value of the defined dynamic symbol الاسم of a 64-bit
    // little-endian ELF shared object, relative to its load address, or 0:
    // the section headers' SHT_DYNSYM table and its string table.
    عرف رمز_إلف_مضيف(الملف: &متجه ط8, الاسم: نص): طبيعي {
        لو (كلمة_إلف_مضيف(الملف, 0, 4) != 0x464C457F || كلمة_إلف_مضيف(الملف, 4, 1) != 2
            || كلمة_إلف_مضيف(الملف, 5, 1) != 1) {
            أرجع 0;
        };
        دع بداية_الأقسام: طبيعي = كلمة_إلف_مضيف(الملف, 0x28, 8);
        دع حجم_القسم: طبيعي = كلمة_إلف_مضيف(الملف, 0x3A, 2);
        دع عدد_الأقسام: طبيعي = كلمة_إلف_مضيف(الملف, 0x3C, 2);
        لو (حجم_القسم < 64) { أرجع 0; };
        دع ق: متغير طبيعي = 0;
        طالما (ق < عدد_الأقسام) {
            دع رأس: طبيعي = بداية_الأقسام + ق * حجم_القسم;
            لو (كلمة_إلف_مضيف(الملف, رأس + 4, 4) == 11) {
                دع بداية_الرموز: طبيعي = كلمة_إلف_مضيف(الملف, رأس + 0x18, 8);
                دع حجم_الرموز: طبيعي = كلمة_إلف_مضيف(الملف, رأس + 0x20, 8);
                دع الرابط: طبيعي = كلمة_إلف_مضيف(الملف, رأس + 0x28, 4);
                دع رأس_النصوص: طبيعي = بداية_الأقسام + الرابط * حجم_القسم;
                دع بداية_النصوص: طبيعي = كلمة_إلف_مضيف(الملف, رأس_النصوص + 0x18, 8);
                دع ر: متغير طبيعي = 1;
                طالما ((ر + 1) * 24 <= حجم_الرموز) {
                    دع الرمز: طبيعي = بداية_الرموز + ر * 24;
                    دع موضع_الاسم: طبيعي = بداية_النصوص + كلمة_إلف_مضيف(الملف, الرمز, 4);
                    دع القيمة: طبيعي = كلمة_إلف_مضيف(الملف, الرمز + 8, 8);
                    لو (القيمة != 0 && كلمة_إلف_مضيف(الملف, الرمز + 6, 2) != 0
                        && بايتات_تبدأ_بـ_مضيف(الملف, موضع_الاسم, &الاسم)
                        && موضع_الاسم + (الطول(الاسم) مثل طبيعي) < (الطول(*الملف) مثل طبيعي)
                        && (*الملف)[موضع_الاسم + (الطول(الاسم) مثل طبيعي)] == 0) {
                        أرجع القيمة;
                    };
                    ر := ر + 1;
                }
            };
            ق := ق + 1;
        }
        أرجع 0;
    }

    // The virtual address of the loadable segment that starts at file offset
    // 0 (the image's load bias is its mapping address minus this).
    عرف عنوان_أول_مقطع_إلف_مضيف(الملف: &متجه ط8): طبيعي {
        دع بداية_البرامج: طبيعي = كلمة_إلف_مضيف(الملف, 0x20, 8);
        دع حجم_البرنامج: طبيعي = كلمة_إلف_مضيف(الملف, 0x36, 2);
        دع عدد_البرامج: طبيعي = كلمة_إلف_مضيف(الملف, 0x38, 2);
        دع ف: متغير طبيعي = 0;
        طالما (ف < عدد_البرامج) {
            دع رأس: طبيعي = بداية_البرامج + ف * حجم_البرنامج;
            لو (كلمة_إلف_مضيف(الملف, رأس, 4) == 1 && كلمة_إلف_مضيف(الملف, رأس + 8, 8) == 0) {
                دع العنوان: طبيعي = كلمة_إلف_مضيف(الملف, رأس + 16, 8);
                أرجع العنوان - (العنوان % 4096);
            };
            ف := ف + 1;
        }
        أرجع 0;
    }

    عرف رقم_ست_عشري_مضيف(البايت: ط8): اختياري طبيعي {
        لو (البايت >= 0x30 && البايت <= 0x39) { أرجع اختياري.موجود((البايت - 0x30) مثل طبيعي); };
        لو (البايت >= 0x61 && البايت <= 0x66) { أرجع اختياري.موجود((البايت - 0x61 + 10) مثل طبيعي); };
        أرجع اختياري.لا_شيء();
    }

    // A file the process has mapped from offset 0: its start and path.
    نوع صورة_ملف_مضيف = {
        البداية: طبيعي,
        المسار: متجه ط8
    };

    // The mappings of /proc/self/maps whose file offset is 0 and whose path
    // is absolute ("start-end perms offset dev inode path").
    عرف صور_ملفات_مضيف(): متجه صورة_ملف_مضيف {
        دع الناتج: متغير متجه صورة_ملف_مضيف = [];
        دع المسار: نص = «/proc/self/maps»;
        دع الخرائط: متجه ط8;
        طابق اقرأ_بايتات_ملف(&المسار) مع
        | نتيجة.نجح(البايتات) -> { الخرائط := البايتات; }
        | نتيجة.خطأ(_) -> { أرجع الناتج; };
        دع الطول_الكلي: طبيعي = الطول(الخرائط) مثل طبيعي;
        دع ف: متغير طبيعي = 0;
        طالما (ف < الطول_الكلي) {
            دع نهاية_السطر: متغير طبيعي = ف;
            طالما (نهاية_السطر < الطول_الكلي && الخرائط[نهاية_السطر] != 0x0A) { نهاية_السطر := نهاية_السطر + 1; }
            دع البداية: متغير طبيعي = 0;
            دع م: متغير طبيعي = ف;
            دع صالح: متغير منطقي = صواب;
            طالما (م < نهاية_السطر && الخرائط[م] != 0x2D) {
                طابق رقم_ست_عشري_مضيف(الخرائط[م]) مع
                | اختياري.موجود(ر) -> { البداية := البداية * 16 + ر; }
                | اختياري.لا_شيء -> { صالح := خطأ; };
                م := م + 1;
            }
            // Skip the end and the permissions to the offset field.
            دع الحقل: متغير طبيعي = 0;
            طالما (م < نهاية_السطر && الحقل < 2) {
                لو (الخرائط[م] == 0x20) {
                    الحقل := الحقل + 1;
                    طالما (م < نهاية_السطر && الخرائط[م] == 0x20) { م := م + 1; }
                } وإلا {
                    م := م + 1;
                };
            }
            دع الإزاحة: متغير طبيعي = 0;
            طالما (م < نهاية_السطر && الخرائط[م] != 0x20) {
                طابق رقم_ست_عشري_مضيف(الخرائط[م]) مع
                | اختياري.موجود(ر) -> { الإزاحة := الإزاحة * 16 + ر; }
                | اختياري.لا_شيء -> { صالح := خطأ; };
                م := م + 1;
            }
            دع بداية_المسار: متغير طبيعي = م;
            طالما (بداية_المسار < نهاية_السطر && الخرائط[بداية_المسار] != 0x2F) { بداية_المسار := بداية_المسار + 1; }
            لو (صالح && الإزاحة == 0 && بداية_المسار < نهاية_السطر) {
                دع مسار_الصورة: متغير متجه ط8 = [];
                دع ب: متغير طبيعي = بداية_المسار;
                طالما (ب < نهاية_السطر) { ألحق(مسار_الصورة, الخرائط[ب]); ب := ب + 1; }
                دع الصورة: صورة_ملف_مضيف = { البداية: البداية, المسار: مسار_الصورة };
                ألحق(الناتج, الصورة);
            };
            ف := نهاية_السطر + 1;
        }
        أرجع الناتج;
    }

    // Whether the path's last component starts with البادئة.
    عرف اسم_صورة_يبدأ_بـ_مضيف(المسار: &متجه ط8, البادئة: نص): منطقي {
        دع البادئة_المرجعية: نص = البادئة;
        دع البداية: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*المسار) مثل طبيعي)) {
            لو ((*المسار)[ف] == 0x2F) { البداية := ف + 1; };
            ف := ف + 1;
        }
        أرجع بايتات_تبدأ_بـ_مضيف(المسار, البداية, &البادئة_المرجعية);
    }

    عرف صورة_مكتبة_سي_مضيف(المسار: &متجه ط8): منطقي {
        أرجع اسم_صورة_يبدأ_بـ_مضيف(المسار, «libc.so») || اسم_صورة_يبدأ_بـ_مضيف(المسار, «libc-»)
            || اسم_صورة_يبدأ_بـ_مضيف(المسار, «ld-musl-»)
            || اسم_صورة_يبدأ_بـ_مضيف(المسار, «libdl.so»);
    }

    // Finds dlopen, dlsym, dlerror and __errno_location in the C library
    // mapped into the process (glibc 2.34+ and musl define them in libc;
    // older glibc in libdl). A static compiler has none mapped.
    عام عرف هيئ_محمل_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): منطقي {
        لو ((*المحمل).مهيأ) { أرجع (*المحمل).متاح; };
        (*المحمل).مهيأ := صواب;
        دع الصور: متجه صورة_ملف_مضيف = صور_ملفات_مضيف();
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الصور) مثل طبيعي)) {
            لو (صورة_مكتبة_سي_مضيف(&الصور[ف].المسار)) {
                دع المسار: نص = من_بايتات(&الصور[ف].المسار);
                طابق اقرأ_بايتات_ملف(&المسار) مع
                | نتيجة.نجح(الملف) -> {
                    دع الأول: طبيعي = عنوان_أول_مقطع_إلف_مضيف(&الملف);
                    دع الإزاحة: طبيعي = الصور[ف].البداية - الأول;
                    دع الفتح: طبيعي = رمز_إلف_مضيف(&الملف, «dlopen»);
                    دع البحث: طبيعي = رمز_إلف_مضيف(&الملف, «dlsym»);
                    دع الخطأ: طبيعي = رمز_إلف_مضيف(&الملف, «dlerror»);
                    دع رقم_الخطأ: طبيعي = رمز_إلف_مضيف(&الملف, «__errno_location»);
                    لو (الفتح != 0 && البحث != 0 && (*المحمل).عنوان_الفتح == 0) {
                        (*المحمل).عنوان_الفتح := (الإزاحة + الفتح) مثل ط64;
                        (*المحمل).عنوان_البحث := (الإزاحة + البحث) مثل ط64;
                        لو (الخطأ != 0) { (*المحمل).عنوان_الخطأ := (الإزاحة + الخطأ) مثل ط64; };
                    };
                    لو (رقم_الخطأ != 0 && (*المحمل).عنوان_رقم_الخطأ == 0) {
                        (*المحمل).عنوان_رقم_الخطأ := (الإزاحة + رقم_الخطأ) مثل ط64;
                    };
                }
                | نتيجة.خطأ(_) -> { };
            };
            ف := ف + 1;
        }
        (*المحمل).متاح := (*المحمل).عنوان_الفتح != 0 && (*المحمل).عنوان_البحث != 0;
        أرجع (*المحمل).متاح;
    }

    // A call of the loader function at العنوان with a host copy of the C
    // string الاسم as its argument after الأول (when يسبق).
    عرف نادي_بنص_مضيف(العنوان: ط64, الأول: ط64, يسبق: منطقي, الاسم: &متجه ط8, الأخير: ط64, يلحق: منطقي): ط64 {
        دع النص: متجه ط8 = نص_سي_مضيف(الاسم);
        دع النسخة: ط64 = خصص_ذاكرة_مضيف(الطول(النص) مثل طبيعي);
        لو (النسخة == 0) { أرجع 0 مثل ط64; };
        اكتب_بايتات_مضيف(النسخة, &النص);
        دع الكلمات: متغير متجه ط64 = [];
        لو (يسبق) { ألحق(الكلمات, الأول); };
        ألحق(الكلمات, النسخة);
        لو (يلحق) { ألحق(الكلمات, الأخير); };
        دع الناتج: ط64 = نادي_صحاح_مضيف(العنوان, &الكلمات);
        حرر_ذاكرة_مضيف(النسخة);
        أرجع الناتج;
    }

    // dlopen(name, RTLD_NOW), as ctypes opens a library (RTLD_LOCAL).
    عام عرف افتح_مكتبة_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, الاسم: &متجه ط8): ط64 {
        لو (!هيئ_محمل_ديناميكي_مضيف(المحمل)) { أرجع 0 مثل ط64; };
        أرجع نادي_بنص_مضيف((*المحمل).عنوان_الفتح, 0, خطأ, الاسم, 2, صواب);
    }

    عام عرف رمز_مكتبة_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, المقبض: ط64, الاسم: &متجه ط8): ط64 {
        لو (!هيئ_محمل_ديناميكي_مضيف(المحمل)) { أرجع 0 مثل ط64; };
        أرجع نادي_بنص_مضيف((*المحمل).عنوان_البحث, المقبض, صواب, الاسم, 0, خطأ);
    }

    // RTLD_DEFAULT is 0 on glibc and musl.
    عام عرف رمز_عام_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, الاسم: &متجه ط8): ط64 {
        أرجع رمز_مكتبة_مضيف(المحمل, 0, الاسم);
    }

    عام عرف مكتبات_سي_افتراضية_مضيف(): متجه نص {
        دع الناتج: متجه نص = [«libc.so.6», «libm.so.6»];
        أرجع الناتج;
    }

    عام عرف خطأ_محمل_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): متجه ط8 {
        لو (!هيئ_محمل_ديناميكي_مضيف(المحمل) || (*المحمل).عنوان_الخطأ == 0) {
            دع لا_شيء_منه: متجه ط8 = [];
            أرجع لا_شيء_منه;
        };
        دع بلا_حجج: متغير متجه ط64 = [];
        أرجع اقرأ_نص_سي_مضيف(نادي_صحاح_مضيف((*المحمل).عنوان_الخطأ, &بلا_حجج));
    }

    // The C library's errno: the word __errno_location() points to.
    عرف عنوان_رقم_الخطأ_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): ط64 {
        لو (!هيئ_محمل_ديناميكي_مضيف(المحمل) || (*المحمل).عنوان_رقم_الخطأ == 0) { أرجع 0 مثل ط64; };
        دع بلا_حجج: متغير متجه ط64 = [];
        أرجع نادي_صحاح_مضيف((*المحمل).عنوان_رقم_الخطأ, &بلا_حجج);
    }

    عام عرف اقرأ_رقم_خطأ_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): ط64 {
        دع العنوان: ط64 = عنوان_رقم_الخطأ_مضيف(المحمل);
        لو (العنوان == 0) { أرجع 0 مثل ط64; };
        دع البايتات: متجه ط8 = اقرأ_بايتات_مضيف(العنوان, 4);
        لو ((الطول(البايتات) مثل طبيعي) != 4) { أرجع 0 مثل ط64; };
        أرجع (البايتات[0] مثل ط64) | ((البايتات[1] مثل ط64) << 8)
            | ((البايتات[2] مثل ط64) << 16) | ((البايتات[3] مثل ط64) << 24);
    }

    عام عرف اضبط_رقم_خطأ_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, القيمة: ط64): فراغ {
        دع العنوان: ط64 = عنوان_رقم_الخطأ_مضيف(المحمل);
        لو (العنوان == 0) { أرجع; };
        دع البايتات: متجه ط8 = [
            (القيمة & 255) مثل ط8, ((القيمة >> 8) & 255) مثل ط8,
            ((القيمة >> 16) & 255) مثل ط8, ((القيمة >> 24) & 255) مثل ط8
        ];
        اكتب_بايتات_مضيف(العنوان, &البايتات);
    }
}

لو (الهدف.المنصة == «macos») {
    خارجي «/usr/lib/libSystem.B.dylib» عرف مضيف_ديناميكي_dlopen(المسار: *ط8, النمط: ص32): ط64 = «dlopen»;
    خارجي «/usr/lib/libSystem.B.dylib» عرف مضيف_ديناميكي_dlsym(المقبض: ط64, الاسم: *ط8): ط64 = «dlsym»;
    خارجي «/usr/lib/libSystem.B.dylib» عرف مضيف_ديناميكي_dlerror(): ط64 = «dlerror»;

    عام عرف هيئ_محمل_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): منطقي {
        (*المحمل).مهيأ := صواب;
        (*المحمل).متاح := صواب;
        أرجع صواب;
    }

    عام عرف افتح_مكتبة_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, الاسم: &متجه ط8): ط64 {
        دع النص: متغير متجه ط8 = نص_سي_مضيف(الاسم);
        أرجع مضيف_ديناميكي_dlopen(&متغير النص[0], 2);
    }

    عام عرف رمز_مكتبة_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, المقبض: ط64, الاسم: &متجه ط8): ط64 {
        دع النص: متغير متجه ط8 = نص_سي_مضيف(الاسم);
        أرجع مضيف_ديناميكي_dlsym(المقبض, &متغير النص[0]);
    }

    // RTLD_DEFAULT is (void *)-2 on Darwin.
    عام عرف رمز_عام_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, الاسم: &متجه ط8): ط64 {
        أرجع رمز_مكتبة_مضيف(المحمل, ~(0 مثل ط64) - 1, الاسم);
    }

    عام عرف مكتبات_سي_افتراضية_مضيف(): متجه نص {
        دع الناتج: متجه نص = [«/usr/lib/libSystem.B.dylib»];
        أرجع الناتج;
    }

    عام عرف خطأ_محمل_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): متجه ط8 {
        أرجع اقرأ_نص_سي_مضيف(مضيف_ديناميكي_dlerror());
    }

    // errno goes through __error (host_memory.sn).
    عام عرف اقرأ_رقم_خطأ_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): ط64 { أرجع اقرأ_خطأ_مضيف(); }
    عام عرف اضبط_رقم_خطأ_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, القيمة: ط64): فراغ { اضبط_خطأ_مضيف(القيمة); }
}

لو (الهدف.المنصة == «windows» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    خارجي «kernel32.dll» عرف مضيف_ديناميكي_LoadLibraryW(الاسم: *ط8): ط64 = «LoadLibraryW»;
    خارجي «kernel32.dll» عرف مضيف_ديناميكي_GetProcAddress(المقبض: ط64, الاسم: *ط8): ط64 = «GetProcAddress»;

    عام عرف هيئ_محمل_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): منطقي {
        (*المحمل).مهيأ := صواب;
        (*المحمل).متاح := صواب;
        أرجع صواب;
    }

    // LoadLibraryW takes the name in UTF-16 (each byte of an ASCII name is
    // one unit; other bytes pass through as Latin-1 units, which a DLL name
    // in practice never needs).
    عام عرف افتح_مكتبة_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, الاسم: &متجه ط8): ط64 {
        دع الوحدات: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
            ألحق(الوحدات, (*الاسم)[ف]);
            ألحق(الوحدات, 0 مثل ط8);
            ف := ف + 1;
        }
        ألحق(الوحدات, 0 مثل ط8);
        ألحق(الوحدات, 0 مثل ط8);
        أرجع مضيف_ديناميكي_LoadLibraryW(&متغير الوحدات[0]);
    }

    عام عرف رمز_مكتبة_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, المقبض: ط64, الاسم: &متجه ط8): ط64 {
        لو (المقبض == 0) { أرجع 0 مثل ط64; };
        دع النص: متغير متجه ط8 = نص_سي_مضيف(الاسم);
        أرجع مضيف_ديناميكي_GetProcAddress(المقبض, &متغير النص[0]);
    }

    // Windows has no global scope: the C runtime and kernel32 are searched.
    عام عرف رمز_عام_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, الاسم: &متجه ط8): ط64 {
        أرجع 0 مثل ط64;
    }

    عام عرف مكتبات_سي_افتراضية_مضيف(): متجه نص {
        دع الناتج: متجه نص = [«msvcrt.dll», «ucrtbase.dll», «kernel32.dll»];
        أرجع الناتج;
    }

    // The Win32 error code of the failed load, as text.
    عام عرف خطأ_محمل_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): متجه ط8 {
        دع الرمز: متغير ط64 = اقرأ_خطأ_مضيف();
        دع الأرقام: متغير متجه ط8 = [];
        لو (الرمز == 0) { ألحق(الأرقام, 0x30 مثل ط8); };
        طالما (الرمز > 0) {
            ألحق(الأرقام, (0x30 + (الرمز % 10)) مثل ط8);
            الرمز := الرمز / 10;
        }
        دع الناتج: متغير متجه ط8 = بايتات_من_نص(«Win32 error »);
        دع ف: متغير طبيعي = الطول(الأرقام) مثل طبيعي;
        طالما (ف > 0) { ف := ف - 1; ألحق(الناتج, الأرقام[ف]); }
        أرجع الناتج;
    }

    عام عرف اقرأ_رقم_خطأ_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): ط64 { أرجع اقرأ_خطأ_مضيف(); }
    عام عرف اضبط_رقم_خطأ_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, القيمة: ط64): فراغ { اضبط_خطأ_مضيف(القيمة); }
}

// Hosts with no dynamic C calls (static FreeBSD and Android compilers, WASI,
// 32-bit hosts): every lookup fails, and the call is reported.
لو (!((الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))
    || الهدف.المنصة == «macos»
    || (الهدف.المنصة == «windows» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)))) {
    عام عرف هيئ_محمل_ديناميكي_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): منطقي {
        (*المحمل).مهيأ := صواب;
        أرجع خطأ;
    }
    عام عرف افتح_مكتبة_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, الاسم: &متجه ط8): ط64 { أرجع 0 مثل ط64; }
    عام عرف رمز_مكتبة_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, المقبض: ط64, الاسم: &متجه ط8): ط64 { أرجع 0 مثل ط64; }
    عام عرف رمز_عام_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف, الاسم: &متجه ط8): ط64 { أرجع 0 مثل ط64; }
    عام عرف مكتبات_سي_افتراضية_مضيف(): متجه نص {
        دع الناتج: متجه نص = [];
        أرجع الناتج;
    }
    عام عرف خطأ_محمل_مضيف(المحمل: &متغير محمل_ديناميكي_مضيف): متجه ط8 {
        دع الناتج: متجه ط8 = [];
        أرجع الناتج;
    }
