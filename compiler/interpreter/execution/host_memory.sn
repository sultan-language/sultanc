// Host memory for the foreign-call bridge (foreign_calls.sn): blocks the
// bridge stages arguments in, byte transfers to and from host addresses
// (a host region's mirror, a C string, a list the host returned), and the
// host's own errno / last-error word, which the bridge exchanges with the
// interpreter's errno cell around every foreign call. Each host gets these
// from the interface its executables already import (kernel32 on Windows,
// libSystem on macOS, raw system calls on Linux); pointers are spelled as
// 64-bit words in these declarations, as the generated table does.
//
// Linux (x86-64, AArch64), where the bridge calls only a program's own C
// functions (host_dynamic.sn): blocks are anonymous mappings (zeroed, as
// calloc's) with their length in a 16-byte header, freed with munmap, and
// bytes move through /proc/self/mem (pread64/pwrite64 at the address), so
// none of this needs the C library the compiler may not be linked with. The
// C library's errno is exchanged by host_dynamic.sn through
// __errno_location.

// One symbol has one C type in a SultanC executable (the LLVM backend
// declares each import once), so every declaration here repeats std's own
// where std declares the function, and a pointer that is a host address is
// made from its word, and the reverse, by memmove/memcpy with a zero count,
// which return their first argument: the C library's identity on pointers.
إذا (الهدف.المنصة == «windows») {
    خارجي «kernel32.dll» عرف مضيف_ذاكرة_GetProcessHeap(): ط64 = «GetProcessHeap»;
    خارجي «kernel32.dll» عرف مضيف_ذاكرة_HeapAlloc(الكومة: ط64, الأعلام: ط32, الحجم: ط64): ط64 = «HeapAlloc»;
    خارجي «kernel32.dll» عرف مضيف_ذاكرة_HeapFree(الكومة: ط64, الأعلام: ط32, العنوان: ط64): ص32 = «HeapFree»;
    خارجي «kernel32.dll» عرف مضيف_ذاكرة_GetLastError(): ط32 = «GetLastError»;
    خارجي «kernel32.dll» عرف مضيف_ذاكرة_SetLastError(الرمز: ط32): فراغ = «SetLastError»;
    خارجي «ntdll.dll» عرف مضيف_ذاكرة_memmove(الوجهة: ط64, المصدر: ط64, العدد: ط64): *ط8 = «memmove»;
    خارجي «ntdll.dll» عرف مضيف_ذاكرة_memcpy(الوجهة: *ط8, المصدر: *ط8, العدد: ط64): ط64 = «memcpy»;

    عام عرف ذاكرة_مضيف_متاحة(): منطقي { أرجع صواب; }

    // HEAP_ZERO_MEMORY (8): staged blocks start zeroed.
    عام عرف خصص_ذاكرة_مضيف(الحجم: طبيعي): ط64 {
        دع المطلوب: متغير طبيعي = الحجم;
        إذا (المطلوب == 0) { المطلوب := 8; };
        أرجع مضيف_ذاكرة_HeapAlloc(مضيف_ذاكرة_GetProcessHeap(), 8, المطلوب مثل ط64);
    }

    عام عرف حرر_ذاكرة_مضيف(العنوان: ط64): فراغ {
        إذا (العنوان == 0) { أرجع; };
        دع تم: ص32 = مضيف_ذاكرة_HeapFree(مضيف_ذاكرة_GetProcessHeap(), 0, العنوان);
    }

    عام عرف مؤشر_من_عنوان_مضيف(العنوان: ط64): *ط8 { أرجع مضيف_ذاكرة_memmove(العنوان, العنوان, 0); }
    عام عرف عنوان_من_مؤشر_مضيف(المؤشر: *ط8): ط64 { أرجع مضيف_ذاكرة_memcpy(المؤشر, المؤشر, 0); }
    عرف انسخ_ذاكرة_مضيف(الوجهة: ط64, المصدر: ط64, العدد: طبيعي): فراغ {
        دع تم: *ط8 = مضيف_ذاكرة_memmove(الوجهة, المصدر, العدد مثل ط64);
    }

    عام عرف اقرأ_خطأ_مضيف(): ط64 { أرجع مضيف_ذاكرة_GetLastError() مثل ط64; }
    عام عرف اضبط_خطأ_مضيف(القيمة: ط64): فراغ { مضيف_ذاكرة_SetLastError(القيمة مثل ط32); }
}

إذا (الهدف.المنصة == «macos») {
    خارجي «/usr/lib/libSystem.B.dylib» عرف مضيف_ذاكرة_calloc(العدد: ط64, الحجم: ط64): ط64 = «calloc»;
    خارجي «/usr/lib/libSystem.B.dylib» عرف مضيف_ذاكرة_free(العنوان: ط64): فراغ = «free»;
    خارجي «/usr/lib/libSystem.B.dylib» عرف مضيف_ذاكرة_memmove(الوجهة: ط64, المصدر: ط64, العدد: ط64): *ط8 = «memmove»;
    خارجي «/usr/lib/libSystem.B.dylib» عرف مضيف_ذاكرة_memcpy(الوجهة: *ط8, المصدر: *ط8, العدد: ط64): ط64 = «memcpy»;
    خارجي «/usr/lib/libSystem.B.dylib» عرف مضيف_ذاكرة___error(): *متغير ص32 = «__error»;

    عام عرف ذاكرة_مضيف_متاحة(): منطقي { أرجع صواب; }

    عام عرف خصص_ذاكرة_مضيف(الحجم: طبيعي): ط64 {
        دع المطلوب: متغير طبيعي = الحجم;
        إذا (المطلوب == 0) { المطلوب := 8; };
        أرجع مضيف_ذاكرة_calloc(1, المطلوب مثل ط64);
    }

    عام عرف حرر_ذاكرة_مضيف(العنوان: ط64): فراغ {
        إذا (العنوان == 0) { أرجع; };
        مضيف_ذاكرة_free(العنوان);
    }

    عام عرف مؤشر_من_عنوان_مضيف(العنوان: ط64): *ط8 { أرجع مضيف_ذاكرة_memmove(العنوان, العنوان, 0); }
    عام عرف عنوان_من_مؤشر_مضيف(المؤشر: *ط8): ط64 { أرجع مضيف_ذاكرة_memcpy(المؤشر, المؤشر, 0); }
    عرف انسخ_ذاكرة_مضيف(الوجهة: ط64, المصدر: ط64, العدد: طبيعي): فراغ {
        دع تم: *ط8 = مضيف_ذاكرة_memmove(الوجهة, المصدر, العدد مثل ط64);
    }

    // errno is the thread's word behind __error().
    عام عرف اقرأ_خطأ_مضيف(): ط64 {
        دع المؤشر: *متغير ص32 = مضيف_ذاكرة___error();
        دع الرمز: متغير ص32 = 0;
        إذا (المؤشر != الفارغ) { غير_آمن { الرمز := المؤشر[0]; } };
        أرجع (الرمز مثل ط64) & 0xFFFFFFFF;
    }

    عام عرف اضبط_خطأ_مضيف(القيمة: ط64): فراغ {
        دع المؤشر: *متغير ص32 = مضيف_ذاكرة___error();
        إذا (المؤشر != الفارغ) { غير_آمن { المؤشر[0] := القيمة مثل ص32; } };
    }
}

إذا (الهدف.المنصة == «windows» || الهدف.المنصة == «macos») {
    عام عرف اقرأ_بايتات_مضيف(العنوان: ط64, العدد: طبيعي): متجه ط8 {
        دع الناتج: متغير متجه ط8 = [];
        إذا (العدد == 0 || العنوان == 0) { أرجع الناتج; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) { ألحق(الناتج, 0); ف := ف + 1; }
        انسخ_ذاكرة_مضيف(عنوان_من_مؤشر_مضيف(&الناتج[0]), العنوان, العدد);
        أرجع الناتج;
    }

    عام عرف اكتب_بايتات_مضيف(العنوان: ط64, البايتات: &متجه ط8): فراغ {
        إذا ((الطول(*البايتات) مثل طبيعي) == 0 || العنوان == 0) { أرجع; };
        انسخ_ذاكرة_مضيف(العنوان, عنوان_من_مؤشر_مضيف(&(*البايتات)[0]), الطول(*البايتات) مثل طبيعي);
    }
}

إذا (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد compiler.interpreter.execution.host_kernel_generated;

    // mmap, munmap, openat, pread64, pwrite64, close.
    عرف رقم_نداء_ذاكرة_مضيف(الفهرس: طبيعي): ط64 {
        إذا (معمارية_نواة_المضيف() == 1) {
            إذا (الفهرس == 0) { أرجع 9; };
            إذا (الفهرس == 1) { أرجع 11; };
            إذا (الفهرس == 2) { أرجع 257; };
            إذا (الفهرس == 3) { أرجع 17; };
            إذا (الفهرس == 4) { أرجع 18; };
            أرجع 3;
        };
        إذا (الفهرس == 0) { أرجع 222; };
        إذا (الفهرس == 1) { أرجع 215; };
        إذا (الفهرس == 2) { أرجع 56; };
        إذا (الفهرس == 3) { أرجع 67; };
        إذا (الفهرس == 4) { أرجع 68; };
        أرجع 57;
    }

    عرف فشل_نواة_مضيف(القيمة: ط64): منطقي { أرجع القيمة >= (~(0 مثل ط64)) - 4094; }

    // Moves العدد bytes between البايتات and host memory at العنوان through
    // /proc/self/mem; false when a transfer falls short.
    عرف انقل_بايتات_ذاكرة_ذاتية_مضيف(العنوان: ط64, البايتات: &متغير متجه ط8, العدد: طبيعي, كتابة: منطقي): منطقي {
        إذا (العدد == 0) { أرجع صواب; };
        دع المسار: متغير متجه ط8 = [];
        دع الاسم: نص = «/proc/self/mem»;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الاسم) مثل طبيعي)) { ألحق(المسار, الاسم[ف]); ف := ف + 1; }
        ألحق(المسار, 0 مثل ط8);
        دع الواصف: متغير ط64 = 0;
        غير_آمن {
            الواصف := بدائي_نداء_نواة_خام(
                رقم_نداء_ذاكرة_مضيف(2), ~(0 مثل ط64) - 99, &متغير المسار[0], 2 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
            );
        }
        إذا (فشل_نواة_مضيف(الواصف)) { أرجع خطأ; };
        دع الرقم: متغير ط64 = رقم_نداء_ذاكرة_مضيف(3);
        إذا (كتابة) { الرقم := رقم_نداء_ذاكرة_مضيف(4); };
        دع المنقول: متغير ط64 = 0;
        غير_آمن {
            المنقول := بدائي_نداء_نواة_خام(
                الرقم, الواصف, &متغير (*البايتات)[0], العدد مثل ط64, العنوان, 0 مثل ط64, 0 مثل ط64
            );
        }
        دع الإغلاق: متغير ط64 = 0;
        غير_آمن {
            الإغلاق := بدائي_نداء_نواة_خام(
                رقم_نداء_ذاكرة_مضيف(5), الواصف, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
            );
        }
        أرجع !فشل_نواة_مضيف(المنقول) && (المنقول مثل طبيعي) == العدد;
    }

    عام عرف ذاكرة_مضيف_متاحة(): منطقي { أرجع صواب; }

    عام عرف خصص_ذاكرة_مضيف(الحجم: طبيعي): ط64 {
        دع الكلي: طبيعي = ((الحجم + 16 + 4095) / 4096) * 4096;
        دع العنوان: متغير ط64 = 0;
        // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS.
        غير_آمن {
            العنوان := بدائي_نداء_نواة_خام(
                رقم_نداء_ذاكرة_مضيف(0), 0 مثل ط64, الكلي مثل ط64, 3 مثل ط64, 0x22 مثل ط64, ~(0 مثل ط64), 0 مثل ط64
            );
        }
        إذا (فشل_نواة_مضيف(العنوان)) { أرجع 0 مثل ط64; };
        دع الرأس: متغير متجه ط8 = [];
        دع ب: متغير طبيعي = 0;
        طالما (ب < 8) {
            ألحق(الرأس, (((الكلي مثل ط64) >> ((8 * ب) مثل ط64)) & 255) مثل ط8);
            ب := ب + 1;
        }
        إذا (!انقل_بايتات_ذاكرة_ذاتية_مضيف(العنوان, &متغير الرأس, 8, صواب)) { أرجع 0 مثل ط64; };
        أرجع العنوان + 16;
    }

    عام عرف حرر_ذاكرة_مضيف(العنوان: ط64): فراغ {
        إذا (العنوان < 16) { أرجع; };
        دع الرأس: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
        إذا (!انقل_بايتات_ذاكرة_ذاتية_مضيف(العنوان - 16, &متغير الرأس, 8, خطأ)) { أرجع; };
        دع الكلي: متغير ط64 = 0;
        دع ب: متغير طبيعي = 0;
        طالما (ب < 8) {
            الكلي := الكلي | ((الرأس[ب] مثل ط64) << ((8 * ب) مثل ط64));
            ب := ب + 1;
        }
        دع تم: متغير ط64 = 0;
        غير_آمن {
            تم := بدائي_نداء_نواة_خام(
                رقم_نداء_ذاكرة_مضيف(1), العنوان - 16, الكلي, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
            );
        }
    }

    عام عرف اقرأ_بايتات_مضيف(العنوان: ط64, العدد: طبيعي): متجه ط8 {
        دع الناتج: متغير متجه ط8 = [];
        إذا (العدد == 0 || العنوان == 0) { أرجع الناتج; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) { ألحق(الناتج, 0); ف := ف + 1; }
        دع تم: منطقي = انقل_بايتات_ذاكرة_ذاتية_مضيف(العنوان, &متغير الناتج, العدد, خطأ);
        أرجع الناتج;
    }

    عام عرف اكتب_بايتات_مضيف(العنوان: ط64, البايتات: &متجه ط8): فراغ {
        دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
        إذا (العدد == 0 || العنوان == 0) { أرجع; };
        دع النسخة: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) { ألحق(النسخة, (*البايتات)[ف]); ف := ف + 1; }
        دع تم: منطقي = انقل_بايتات_ذاكرة_ذاتية_مضيف(العنوان, &متغير النسخة, العدد, صواب);
    }

    // The C library's errno is exchanged in host_dynamic.sn.
    عام عرف اقرأ_خطأ_مضيف(): ط64 { أرجع 0 مثل ط64; }
    عام عرف اضبط_خطأ_مضيف(القيمة: ط64): فراغ { }
    عام عرف مؤشر_من_عنوان_مضيف(العنوان: ط64): *ط8 { أرجع الفارغ; }
    عام عرف عنوان_من_مؤشر_مضيف(المؤشر: *ط8): ط64 { أرجع 0 مثل ط64; }
}

إذا (الهدف.المنصة != «windows» && الهدف.المنصة != «macos»
    && !(الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))) {
    عام عرف ذاكرة_مضيف_متاحة(): منطقي { أرجع خطأ; }
    عام عرف خصص_ذاكرة_مضيف(الحجم: طبيعي): ط64 { أرجع 0 مثل ط64; }
    عام عرف حرر_ذاكرة_مضيف(العنوان: ط64): فراغ { }
    عام عرف اقرأ_بايتات_مضيف(العنوان: ط64, العدد: طبيعي): متجه ط8 {
        دع الناتج: متجه ط8 = [];
        أرجع الناتج;
    }
    عام عرف اكتب_بايتات_مضيف(العنوان: ط64, البايتات: &متجه ط8): فراغ { }
    عام عرف اقرأ_خطأ_مضيف(): ط64 { أرجع 0 مثل ط64; }
    عام عرف اضبط_خطأ_مضيف(القيمة: ط64): فراغ { }
    عام عرف مؤشر_من_عنوان_مضيف(العنوان: ط64): *ط8 { أرجع الفارغ; }
    عام عرف عنوان_من_مؤشر_مضيف(المؤشر: *ط8): ط64 { أرجع 0 مثل ط64; }
}
