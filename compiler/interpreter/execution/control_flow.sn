استورد compiler.interpreter.execution.execution_state;
استورد compiler.interpreter.execution.calls;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.runtime_failures;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.identifiers;
استورد compiler.interpreter.memory.memory;

عام نوع نتيجة_منهي_مفسر =
    | استمر
    | اكتمل بنوع اختياري قيمة_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;

عرف انتقل_عبر_حافة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير
): نتيجة_منهي_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(الإطار) -> {
        موضع_الإطار := الإطار;
    };
    دع الهدف: معرف_كتلة_مسير = (*الحافة).الهدف;
    دع حجج_الحافة: &متجه معرف_قيمة_مسير = &(*الحافة).الحجج;

    // An edge with no operand, or with one, needs no staging vector.
    دع عدد_حجج_الحافة: طبيعي = الطول(*حجج_الحافة) مثل طبيعي;
    لو (عدد_حجج_الحافة <= 1) {
        دع المنقول: متغير قيمة_تشغيل = قيمة_تشغيل.مؤشر_فارغ();
        لو (عدد_حجج_الحافة == 1) {
            طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], (*حجج_الحافة)[0]) مع
            | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> { أرجع نتيجة_منهي_مفسر.أخفق(الخطأ); }
            | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> { المنقول := القيمة; };
        };
        دع دوال_الهدف: &متجه دالة_مسير = &(*المسير).المسير.الدوال;
        لو (الهدف.الدالة.القيمة >= (الطول(*دوال_الهدف) مثل طبيعي)) {
            أرجع نتيجة_منهي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.كتلة_مفقودة(الهدف))
            );
        };
        دع كتل_الهدف: &متجه كتلة_مسير = &(*دوال_الهدف)[الهدف.الدالة.القيمة].الكتل;
        لو (الهدف.القيمة >= (الطول(*كتل_الهدف) مثل طبيعي)) {
            أرجع نتيجة_منهي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.كتلة_مفقودة(الهدف))
            );
        };
        دع معاملات_الهدف: &متجه قيمة_مسير = &(*كتل_الهدف)[الهدف.القيمة].المعاملات;
        لو ((الطول(*معاملات_الهدف) مثل طبيعي) != عدد_حجج_الحافة) {
            أرجع نتيجة_منهي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.عدد_حجج_غير_متسق(الطول(*معاملات_الهدف) مثل طبيعي, عدد_حجج_الحافة)
                )
            );
        };
        دع الإطار_الوحيد: &متغير إطار_تفسير_مسير = &متغير (*الحالة).المكدس[موضع_الإطار];
        (*الإطار_الوحيد).الكتلة := الهدف;
        (*الإطار_الوحيد).مؤشر_التعليمة := 0;
        لو (عدد_حجج_الحافة == 1) {
            طابق اكتب_قيمة_خانة_مسير(الإطار_الوحيد, (*معاملات_الهدف)[0].المعرف, المنقول) مع
            | نتيجة_كتابة_خانة.نجحت -> { }
            | نتيجة_كتابة_خانة.أخفق(الخطأ) -> { أرجع نتيجة_منهي_مفسر.أخفق(الخطأ); };
        };
        أرجع نتيجة_منهي_مفسر.استمر();
    };

    // Edge operands are copied before any destination block parameter is
    // written (a parallel copy), into the state's staging vector, which every
    // edge reuses instead of allocating its own.
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_حجج_الحافة) {
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], (*حجج_الحافة)[ف]) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            لو (ف < (الطول((*الحالة).حجج_الحواف) مثل طبيعي)) {
                (*الحالة).حجج_الحواف[ف] := القيمة;
            } وإلا {
                ألحق((*الحالة).حجج_الحواف, القيمة);
            };
        };
        ف := ف + 1;
    }

    دع الدوال: &متجه دالة_مسير = &(*المسير).المسير.الدوال;
    لو (الهدف.الدالة.القيمة >= (الطول(*الدوال) مثل طبيعي)) {
        أرجع نتيجة_منهي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.كتلة_مفقودة(الهدف))
        );
    };
    دع الكتل: &متجه كتلة_مسير = &(*الدوال)[الهدف.الدالة.القيمة].الكتل;
    لو (الهدف.القيمة >= (الطول(*الكتل) مثل طبيعي)) {
        أرجع نتيجة_منهي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.كتلة_مفقودة(الهدف))
        );
    };
    دع المعاملات: &متجه قيمة_مسير = &(*الكتل)[الهدف.القيمة].المعاملات;
    دع عدد_الحجج: طبيعي = عدد_حجج_الحافة;
    لو (عدد_الحجج != (الطول(*المعاملات) مثل طبيعي)) {
        أرجع نتيجة_منهي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.عدد_حجج_غير_متسق(الطول(*المعاملات) مثل طبيعي, عدد_الحجج)
            )
        );
    };

    (*الحالة).المكدس[موضع_الإطار].الكتلة := الهدف;
    (*الحالة).المكدس[موضع_الإطار].مؤشر_التعليمة := 0;
    لو (عدد_الحجج == 0) { أرجع نتيجة_منهي_مفسر.استمر(); };
    // Move each operand into its parameter slot (the operands were copied).
    دع م: متغير طبيعي = 0;
    دع المأخوذة: متغير قيمة_تشغيل = قيمة_تشغيل.مؤشر_فارغ();
    طالما (م < عدد_الحجج) {
        بدّل((*الحالة).حجج_الحواف[م], المأخوذة);
        طابق اكتب_قيمة_خانة_مسير(&متغير (*الحالة).المكدس[موضع_الإطار], (*المعاملات)[م].المعرف, المأخوذة) مع
        | نتيجة_كتابة_خانة.نجحت -> { }
        | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        };
        المأخوذة := قيمة_تشغيل.مؤشر_فارغ();
        م := م + 1;
    }
    أرجع نتيجة_منهي_مفسر.استمر();
}

عام عرف نفذ_منهي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    المنهي: &منهي_مسير
): نتيجة_منهي_مفسر {
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        أرجع انتقل_عبر_حافة_مفسر(الحالة, المسير, &الحافة);
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        دع موضع_الإطار: طبيعي;
        طابق اقرأ_الإطار_النشط(الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_إطار_نشط.موجود(القيمة) -> {
            موضع_الإطار := القيمة;
        };
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], الشرط) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            طابق القيمة مع
            | قيمة_تشغيل.منطق(صواب_الشرط) -> {
                لو (صواب_الشرط) {
                    أرجع انتقل_عبر_حافة_مفسر(الحالة, المسير, &عند_الصواب);
                };
                أرجع انتقل_عبر_حافة_مفسر(الحالة, المسير, &عند_الخطأ);
            }
            | _ -> {
                أرجع نتيجة_منهي_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.قيمة_منطقية_متوقعة(الشرط)
                    )
                );
            };
        };
    }
    | منهي_مسير.فرع_متعدد(الفرع) -> {
        دع موضع_الإطار: طبيعي;
        طابق اقرأ_الإطار_النشط(الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> { أرجع نتيجة_منهي_مفسر.أخفق(الخطأ); }
        | نتيجة_إطار_نشط.موجود(المعرف) -> { موضع_الإطار := المعرف; };
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], الفرع.المميز) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> { أرجع نتيجة_منهي_مفسر.أخفق(الخطأ); }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            طابق القيمة مع
            | قيمة_تشغيل.بتات_عدد(الوسم) -> {
                // Index derived once from verified MSIR (execution_state.sn):
                // O(1) for dense tags, O(log n) otherwise, independent of
                // the source arm order.
                دع الكتلة: معرف_كتلة_مسير = (*الحالة).المكدس[موضع_الإطار].الكتلة;
                طابق ابحث_فهرس_فرع_متعدد_مفسر(الحالة, الكتلة, &الفرع, الوسم) مع
                | نتيجة_فهرس_فرع_مفسر.حالة(الموضع) -> {
                    أرجع انتقل_عبر_حافة_مفسر(الحالة, المسير, &الفرع.الحالات[الموضع].الحافة);
                }
                | نتيجة_فهرس_فرع_مفسر.افتراضي -> {
                    أرجع انتقل_عبر_حافة_مفسر(الحالة, المسير, &الفرع.الافتراضي);
                };
            }
            | _ -> {
                أرجع نتيجة_منهي_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.قيمة_منطقية_متوقعة(الفرع.المميز))
                );
            };
        };
    }
    | منهي_مسير.إرجاع(معرف_القيمة) -> {
        دع موضع_الإطار: طبيعي;
        طابق اقرأ_الإطار_النشط(الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_إطار_نشط.موجود(القيمة) -> {
            موضع_الإطار := القيمة;
        };

        دع القيمة: اختياري قيمة_تشغيل;
        طابق معرف_القيمة مع
        | اختياري.لا_شيء -> {
            القيمة := اختياري.لا_شيء();
        }
        | اختياري.موجود(المعرف) -> {
            طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], المعرف) مع
            | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
                أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
            }
            | نتيجة_قراءة_قيمة_خانة.موجودة(الراجعة) -> {
                القيمة := اختياري.موجود(الراجعة);
            };
        };

        طابق أكمل_إرجاع_مفسر(الحالة, القيمة) مع
        | نتيجة_إرجاع_مفسر.استمر -> {
            أرجع نتيجة_منهي_مفسر.استمر();
        }
        | نتيجة_إرجاع_مفسر.اكتمل(الناتج) -> {
            أرجع نتيجة_منهي_مفسر.اكتمل(الناتج);
        }
        | نتيجة_إرجاع_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        };
    }
    | منهي_مسير.فخ -> {
        طابق اقرأ_الإطار_النشط(الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_إطار_نشط.موجود(الإطار) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(
                فشل_تفسير_مسير.فخ_مسير((*الحالة).المكدس[الإطار].الدالة, (*الحالة).المكدس[الإطار].الكتلة)
            );
        };
    };
}
