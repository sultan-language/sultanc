استورد compiler.interpreter.execution.execution_state;
استورد compiler.interpreter.execution.calls;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.diagnostics.runtime_failures;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.identifiers;
استورد compiler.interpreter.memory.memory;

عام نوع نتيجة_منهي_مفسر =
    | استمر
    | اكتمل بنوع اختيار قيمة_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;

عرف انتقل_عبر_حافة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير
): نتيجة_منهي_مفسر {
    دع وصف_الحافة: حافة_مسير = *الحافة;
    دع الإطار_الحالي: متغير إطار_تفسير_مسير;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(الإطار) -> {
        الإطار_الحالي := الإطار;
    };

    // Edge operands are copied before any destination block parameter is written.
    دع المنقولة: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(وصف_الحافة.الحجج) مثل غير_موقع)) {
        طابق اقرأ_قيمة_خانة_مسير(&الإطار_الحالي, وصف_الحافة.الحجج[ف]) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            ألحق(المنقولة, القيمة);
        };
        ف := ف + 1;
    }

    طابق ابحث_كتلة_مسير(المسير, وصف_الحافة.الهدف) مع
    | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> {
        أرجع نتيجة_منهي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.كتلة_مفقودة(وصف_الحافة.الهدف)
            )
        );
    }
    | نتيجة_بحث_كتلة_مسير.موجودة(عرض_الكتلة) -> {
        دع عدد_الحجج: غير_موقع = الطول(المنقولة) مثل غير_موقع;
        لو (عدد_الحجج != عرض_الكتلة.عدد_المعاملات) {
            أرجع نتيجة_منهي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.عدد_حجج_غير_متسق(
                        عرض_الكتلة.عدد_المعاملات,
                        عدد_الحجج
                    )
                )
            );
        };

        الإطار_الحالي.الكتلة := وصف_الحافة.الهدف;
        الإطار_الحالي.مؤشر_التعليمة := 0;
        دع م: متغير غير_موقع = 0;
        بينما (م < عدد_الحجج) {
            طابق معامل_كتلة_مسير_عند(
                المسير,
                وصف_الحافة.الهدف,
                م
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_منهي_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.معامل_كتلة_مفقود(وصف_الحافة.الهدف, م)
                    )
                );
            }
            | اختيار.بعض(المعامل) -> {
                دع القيمة_المنقولة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&المنقولة[م]);
                طابق اكتب_قيمة_خانة_مسير(&متغير الإطار_الحالي, المعامل.المعرف, القيمة_المنقولة) مع
                | نتيجة_كتابة_خانة.نجحت -> { }
                | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
                    أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
                };
            };
            م := م + 1;
        }

        طابق اكتب_الإطار_النشط(الحالة, الإطار_الحالي) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | اختيار.لا_شيء -> { };
        أرجع نتيجة_منهي_مفسر.استمر();
    };
}

عام عرف نفذ_منهي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    المنهي: &منهي_مسير
): نتيجة_منهي_مفسر {
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        أرجع انتقل_عبر_حافة_مفسر(الحالة, المسير, &الحافة);
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        دع الإطار: إطار_تفسير_مسير;
        طابق اقرأ_الإطار_النشط(الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_إطار_نشط.موجود(القيمة) -> {
            الإطار := القيمة;
        };
        طابق اقرأ_قيمة_خانة_مسير(&الإطار, الشرط) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            طابق القيمة مع
            | قيمة_تشغيل.منطق(صواب_الشرط) -> {
                لو (صواب_الشرط) {
                    أرجع انتقل_عبر_حافة_مفسر(الحالة, المسير, &عند_الصواب);
                };
                أرجع انتقل_عبر_حافة_مفسر(الحالة, المسير, &عند_الخطأ);
            }
            | _ -> {
                أرجع نتيجة_منهي_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.قيمة_منطقية_متوقعة(الشرط)
                    )
                );
            };
        };
    }
    | منهي_مسير.إرجاع(معرف_القيمة) -> {
        دع الإطار: إطار_تفسير_مسير;
        طابق اقرأ_الإطار_النشط(الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_إطار_نشط.موجود(القيمة) -> {
            الإطار := القيمة;
        };

        دع القيمة: اختيار قيمة_تشغيل;
        طابق معرف_القيمة مع
        | اختيار.لا_شيء -> {
            القيمة := اختيار.لا_شيء();
        }
        | اختيار.بعض(المعرف) -> {
            طابق اقرأ_قيمة_خانة_مسير(&الإطار, المعرف) مع
            | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
                أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
            }
            | نتيجة_قراءة_قيمة_خانة.موجودة(الراجعة) -> {
                القيمة := اختيار.بعض(الراجعة);
            };
        };

        طابق أكمل_إرجاع_مفسر(الحالة, القيمة) مع
        | نتيجة_إرجاع_مفسر.استمر -> {
            أرجع نتيجة_منهي_مفسر.استمر();
        }
        | نتيجة_إرجاع_مفسر.اكتمل(الناتج) -> {
            أرجع نتيجة_منهي_مفسر.اكتمل(الناتج);
        }
        | نتيجة_إرجاع_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        };
    }
    | منهي_مسير.فخ -> {
        طابق اقرأ_الإطار_النشط(الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(الخطأ);
        }
        | نتيجة_إطار_نشط.موجود(الإطار) -> {
            أرجع نتيجة_منهي_مفسر.أخفق(
                فشل_تفسير_مسير.فخ_مسير(الإطار.الدالة, الإطار.الكتلة)
            );
        };
    };
}
