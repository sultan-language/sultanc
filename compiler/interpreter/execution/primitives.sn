// This is the single Interpreter-owned boundary from canonical primitive identity
// to semantic runtime behavior. It owns no source spellings and no platform ABI facts.
عام نوع نتيجة_تنفيذ_بدائي_مفسر =
    | عاد بنوع اختياري قيمة_تشغيل
    | أنهى_العملية بنوع طبيعي
    | أخفق بنوع فشل_تفسير_مسير
;

عرف فشل_حجة_بدائي(
    الهوية: هوية_بدائي_مترجم,
    الفهرس: طبيعي
): نتيجة_تنفيذ_بدائي_مفسر {
    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
        فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(الهوية, الفهرس)
        )
    );
}

عرف حدّث_مكان_من_إطار_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: طبيعي,
    المكان: &مكان_تشغيل,
    القيمة: قيمة_تشغيل
): اختياري فشل_تفسير_مسير {
    لو (موضع_الإطار >= عمق_مكدس_مفسر(الحالة)) {
        أرجع اختياري.موجود(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    دع عمق_المكدس_الحالي: طبيعي = عمق_مكدس_مفسر(الحالة);
    طابق اكتب_مكان_مفسر(
        &متغير (*الحالة).المكدس,
        عمق_المكدس_الحالي,
        &متغير (*الحالة).الذاكرة,
        المكان,
        القيمة
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف نفذ_طول_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الحجة: &قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    طابق *الحجة مع
    | قيمة_تشغيل.مخزن(المخزن) -> {
        طابق طول_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن) مع
        | اختياري.موجود(العدد) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.بتات_عدد(العدد)));
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المخزن.القيمة)
            ));
        };
    }
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختياري.موجود(قيمة_تشغيل.بتات_عدد(الطول(الأعضاء) مثل طبيعي))
        );
    }
    | قيمة_تشغيل.نص(البايتات) -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختياري.موجود(قيمة_تشغيل.بتات_عدد(الطول(البايتات) مثل طبيعي))
        );
    }
    | _ -> { أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0); };
}

// ---- Thread support (docs/CONCURRENCY.md) ----
// The interpreter runs one thread, so an atomic operation is the plain read,
// modify and write of the integer its reference names; every memory ordering
// is trivially satisfied. Starting a thread is reported as an unsupported
// machine primitive: interpreted programs stay single-threaded.

عرف بتات_قيمة_ذرية_مفسر(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): طبيعي {
    طابق نوع_قيمة_مفسر(المسير, المعرف) مع
    | اختياري.موجود(النوع) -> {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختياري.موجود(الوصف) -> {
            طابق الوصف.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                لو (البتات > 0 && البتات <= 64) { أرجع البتات; };
            }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع 64;
}

عرف قناع_ذري_مفسر(البتات: طبيعي): طبيعي {
    لو (البتات >= 64) { أرجع ~((0 مثل طبيعي)); };
    أرجع ((1 مثل طبيعي) << البتات) - 1;
}

عرف عدد_ذري_مفسر(القيمة: &قيمة_تشغيل): اختياري طبيعي {
    طابق *القيمة مع
    | قيمة_تشغيل.بتات_عدد(العدد) -> { أرجع اختياري.موجود(العدد); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف نفذ_بدائي_ذري_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: طبيعي,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    الهوية: هوية_بدائي_مترجم,
    المعرفات: &متجه معرف_قيمة_مسير,
    قيم_الحجج: &متجه قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    طابق الهوية مع
    | هوية_بدائي_مترجم.سياج_ذاكرة -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()); }
    | _ -> { };
    دع المرجع_الأصلي: مكان_تشغيل;
    طابق (*قيم_الحجج)[0] مع
    | قيمة_تشغيل.مرجع(م) -> { المرجع_الأصلي := انسخ_مكان_تشغيل(&م); }
    | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    // An atomic writes through a shared reference (interior mutability, as
    // Rust's atomics take &self): the place is written even when the
    // reference that names it is shared.
    دع المكان: متغير مكان_تشغيل = المرجع_الأصلي;
    المكان.قابل_للكتابة := صواب;
    دع القديم: متغير طبيعي = 0;
    طابق اقرأ_مكان_مفسر(&(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة), &(*الحالة).الذاكرة, &المكان) مع
    | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ); }
    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> {
        طابق عدد_ذري_مفسر(&القيمة) مع
        | اختياري.موجود(العدد) -> { القديم := العدد; }
        | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    };
    طابق الهوية مع
    | هوية_بدائي_مترجم.ذري_حمل -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.بتات_عدد(القديم)));
    }
    | _ -> { };
    دع القيمة: متغير طبيعي = 0;
    طابق عدد_ذري_مفسر(&(*قيم_الحجج)[1]) مع
    | اختياري.موجود(العدد) -> { القيمة := العدد; }
    | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 1); };
    دع البتات: طبيعي = بتات_قيمة_ذرية_مفسر(الأنواع, المسير, (*المعرفات)[1]);
    دع القناع: طبيعي = قناع_ذري_مفسر(البتات);
    دع الجديد: متغير طبيعي = القيمة;
    دع يكتب: متغير منطقي = صواب;
    طابق الهوية مع
    | هوية_بدائي_مترجم.ذري_خزن -> { }
    | هوية_بدائي_مترجم.ذري_تبديل -> { }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> {
        // (old + value) mod 2^N without exceeding the host word.
        دع س: طبيعي = القديم & القناع;
        دع ص: طبيعي = القيمة & القناع;
        دع المتبقي: طبيعي = القناع - س;
        لو (ص <= المتبقي) { الجديد := س + ص; } وإلا { الجديد := ص - (المتبقي + 1); };
    }
    | هوية_بدائي_مترجم.ذري_جلب_و -> { الجديد := القديم & القيمة; }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> { الجديد := القديم | القيمة; }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { الجديد := (القديم ^ القيمة) & القناع; }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> {
        طابق عدد_ذري_مفسر(&(*قيم_الحجج)[2]) مع
        | اختياري.موجود(العدد) -> { الجديد := العدد; }
        | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 2); };
        يكتب := (القديم & القناع) == (القيمة & القناع);
    }
    | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    لو (يكتب) {
        طابق حدّث_مكان_من_إطار_بدائي(الحالة, موضع_الإطار, &المكان, قيمة_تشغيل.بتات_عدد(الجديد)) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ); }
        | اختياري.لا_شيء -> { };
    };
    طابق الهوية مع
    | هوية_بدائي_مترجم.ذري_خزن -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()); }
    | _ -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.بتات_عدد(القديم))); };
}

// This is a runtime check of the verified Frontend-origin witness, not a
// second syscall registry. The MSIR verifier already proves the selector's
// constructor/SSA origin; the Interpreter additionally refuses a missing,
// duplicate, or inconsistent attestation and classifies EVERY machine slot.
عرف وثق_توقيع_نداء_نواة_مفسر(
    الإطار: &إطار_تفسير_مسير,
    المسير: &سياق_مستهلك_مسير,
    العقد: &اختياري عقد_نواة_مسير,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    النطاقات: &متجه نطاق_ذاكرة_نداء_مسير
): اختياري توقيع_نداء_بدائي {
    دع الشاهد: عقد_نواة_مسير;
    طابق *العقد مع
    | اختياري.موجود(القيمة) -> { الشاهد := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    لو (الطول(*معرفات_الحجج) != 7 || الطول(*الحجج) != 7
        || !قيمتا_مسير_متساويتان(الشاهد.الرقم, (*معرفات_الحجج)[0])) {
        أرجع اختياري.لا_شيء();
    };
    طابق (*الحجج)[0] مع
    | قيمة_تشغيل.بتات_عدد(_) -> { }
    | _ -> { أرجع اختياري.لا_شيء(); };

    دع التوقيع: متغير اختياري توقيع_نداء_بدائي = اختياري.لا_شيء();
    دع المطابقات: متغير طبيعي = 0;
    دع فهرس_المصدر: متغير طبيعي = 0;
    طالما (فهرس_المصدر < (الطول((*المسير).المسير.أصول_النواة) مثل طبيعي)) {
        دع الأصل: &مصدر_عقد_نواة_مسير = &(*المسير).المسير.أصول_النواة[فهرس_المصدر];
        لو (معرفا_رمز_متساويان((*الأصل).المنشئ, الشاهد.المنشئ)
            && (*الأصل).الترتيب == الشاهد.الترتيب
            && (*الأصل).المنتقي.القيمة == الشاهد.المنتقي.القيمة) {
            المطابقات := المطابقات + 1;
            // Copy the authenticated signature; the canonical MSIR owner keeps
            // its own record (no owned field is moved out of a borrow).
            دع الأدوار_المنسوخة: متغير متجه دور_وسيطة_بدائي = [];
            دع فهرس_الدور: متغير طبيعي = 0;
            طالما (فهرس_الدور < (الطول((*الأصل).التوقيع.الأدوار) مثل طبيعي)) {
                ألحق(الأدوار_المنسوخة, (*الأصل).التوقيع.الأدوار[فهرس_الدور]);
                فهرس_الدور := فهرس_الدور + 1;
            }
            دع التوقيع_المنسوخ: توقيع_نداء_بدائي = {
                الأدوار: الأدوار_المنسوخة, النسخ: (*الأصل).التوقيع.النسخ
            };
            التوقيع := اختياري.موجود(التوقيع_المنسوخ);
        };
        فهرس_المصدر := فهرس_المصدر + 1;
    }
    لو (المطابقات != 1) { أرجع اختياري.لا_شيء(); };
    دع الموثق: توقيع_نداء_بدائي;
    طابق التوقيع مع
    | اختياري.موجود(القيمة) -> { الموثق := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    لو (الطول(الموثق.الأدوار) != 6) { أرجع اختياري.لا_شيء(); };

    دع الموضع: متغير طبيعي = 1;
    طالما (الموضع <= 6) {
        دع عدد_النطاقات: متغير طبيعي = 0;
        دع موضع_النطاق: متغير طبيعي = 0;
        دع الوصف: متغير اختياري نطاق_ذاكرة_نداء_مسير = اختياري.لا_شيء();
        طالما (موضع_النطاق < (الطول(*النطاقات) مثل طبيعي)) {
            لو ((*النطاقات)[موضع_النطاق].فهرس_الحجة == الموضع) {
                عدد_النطاقات := عدد_النطاقات + 1;
                الوصف := اختياري.موجود((*النطاقات)[موضع_النطاق]);
            };
            موضع_النطاق := موضع_النطاق + 1;
        }
        طابق الموثق.الأدوار[الموضع - 1] مع
        | دور_وسيطة_بدائي.عدد -> {
            لو (عدد_النطاقات != 0) { أرجع اختياري.لا_شيء(); };
            طابق (*الحجج)[الموضع] مع
            | قيمة_تشغيل.بتات_عدد(_) -> { }
            | _ -> { أرجع اختياري.لا_شيء(); };
        }
        | دور_وسيطة_بدائي.غير_مستخدم -> {
            لو (عدد_النطاقات != 0) { أرجع اختياري.لا_شيء(); };
            طابق (*الحجج)[الموضع] مع
            | قيمة_تشغيل.بتات_عدد(القيمة) -> {
                لو (القيمة != 0) { أرجع اختياري.لا_شيء(); };
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
        }
        | دور_وسيطة_بدائي.مخزن(الاتجاه, الحد) -> {
            لو (عدد_النطاقات != 1) { أرجع اختياري.لا_شيء(); };
            دع النطاق: نطاق_ذاكرة_نداء_مسير;
            طابق الوصف مع
            | اختياري.موجود(القيمة) -> { النطاق := القيمة; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            طابق (*الحجج)[الموضع] مع
            | قيمة_تشغيل.مرجع(_) -> { }
            | _ -> { أرجع اختياري.لا_شيء(); };
            لو (!قيمتا_مسير_متساويتان(
                النطاق.المؤشر, (*معرفات_الحجج)[الموضع]
            )) { أرجع اختياري.لا_شيء(); };
            دع الإذن: إذن_ذاكرة_نداء_مسير;
            طابق الاتجاه مع
            | اتجاه_وصول_بدائي.قراءة -> { الإذن := إذن_ذاكرة_نداء_مسير.قراءة(); }
            | اتجاه_وصول_بدائي.كتابة -> { الإذن := إذن_ذاكرة_نداء_مسير.كتابة(); }
            | اتجاه_وصول_بدائي.قراءة_وكتابة -> { الإذن := إذن_ذاكرة_نداء_مسير.قراءة_وكتابة(); };
            لو (النطاق.الإذن != الإذن) { أرجع اختياري.لا_شيء(); };
            طابق النطاق.المطلوب مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المعرف) -> {
                طابق الحد مع
                | حد_وصول_بدائي.وسيطة(الفهرس) -> {
                    لو (الفهرس == 0 || الفهرس > 6
                        || !قيمتا_مسير_متساويتان(
                            المعرف, (*معرفات_الحجج)[الفهرس]
                        )) { أرجع اختياري.لا_شيء(); };
                    طابق (*الحجج)[الفهرس] مع
                    | قيمة_تشغيل.بتات_عدد(_) -> { }
                    | _ -> { أرجع اختياري.لا_شيء(); };
                }
                | حد_وصول_بدائي.سلسلة_صفرية -> {
                    لو (!قيمتا_مسير_متساويتان(المعرف, النطاق.الطول)) {
                        أرجع اختياري.لا_شيء();
                    };
                }
                | حد_وصول_بدائي.ثابت(الثابت) -> {
                    طابق اقرأ_طول_نطاق_نداء_نواة_مفسر(الإطار, المعرف) مع
                    | اختياري.موجود(العدد) -> {
                        لو (العدد != الثابت) { أرجع اختياري.لا_شيء(); };
                    }
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
                };
            };
        };
        الموضع := الموضع + 1;
    }
    // No descriptor may refer to the operation number or an eighth operand.
    دع فهرس_النطاق: متغير طبيعي = 0;
    طالما (فهرس_النطاق < (الطول(*النطاقات) مثل طبيعي)) {
        لو ((*النطاقات)[فهرس_النطاق].فهرس_الحجة == 0
            || (*النطاقات)[فهرس_النطاق].فهرس_الحجة > 6) {
            أرجع اختياري.لا_شيء();
        };
        فهرس_النطاق := فهرس_النطاق + 1;
    }
    أرجع اختياري.موجود(الموثق);
}

// These are scoped, owned byte vectors, not host allocations, pinned addresses
// or a second Interpreter memory registry. They are discarded on every return
// path, including overlap/validation failures and the fail-closed rejection.
// The requested extent is relative to the reference's indexed position.
نوع نطاق_مهيأ_لنداء_نواة_مفسر = {
    فهرس_الحجة: طبيعي,
    معرف_المؤشر: معرف_قيمة_مسير,
    المؤشر: قيمة_تشغيل,
    المطلوب: طبيعي,
    الإذن: إذن_ذاكرة_نداء_مسير,
    هوية_التخزين: نطاق_تخزين_بايتات_مفسر,
    البايتات: متجه ط8
};

نوع نتيجة_تحضير_نداء_نواة_مفسر =
    | مهيأ بنوع متجه نطاق_مهيأ_لنداء_نواة_مفسر
    | أخفق بنوع فشل_تفسير_مسير
;

عرف فشل_ذاكرة_نداء_نواة_مفسر(الفهرس: طبيعي): فشل_تفسير_مسير {
    أرجع فشل_تفسير_مسير.وقت_تشغيل(
        خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(
            هوية_بدائي_مترجم.نداء_نواة_خام(), الفهرس
        )
    );
}

// Runtime lengths are read from the same verified MSIR SSA values as the
// descriptor. No kernel argument is interpreted as a length by syscall number.
عرف اقرأ_طول_نطاق_نداء_نواة_مفسر(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري طبيعي {
    طابق اقرأ_قيمة_خانة_مسير(الإطار, المعرف) مع
    | نتيجة_قراءة_قيمة_خانة.موجودة(قيمة_تشغيل.بتات_عدد(القيمة)) -> {
        أرجع اختياري.موجود(القيمة);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Validate all declared buffers before host-side effects, after the
// authenticated six-slot signature has classified every machine operand.
// A numeric word not classified by that signature is never a safe pointer.
عرف حضر_نطاقات_نداء_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: طبيعي,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    النطاقات: &متجه نطاق_ذاكرة_نداء_مسير
): نتيجة_تحضير_نداء_نواة_مفسر {
    دع العدد: طبيعي = الطول(*الحجج) مثل طبيعي;
    دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(
        هوية_بدائي_مترجم.نداء_نواة_خام()
    );
    دع المتوقع: طبيعي = العقد.عدد_الحجج;
    لو (موضع_الإطار >= عمق_مكدس_مفسر(الحالة) || العدد != المتوقع
        || (الطول(*معرفات_الحجج) مثل طبيعي) != العدد) {
        أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(فشل_ذاكرة_نداء_نواة_مفسر(0));
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع فهرس_نطاق: متغير طبيعي = 0;
    طالما (فهرس_نطاق < (الطول(*النطاقات) مثل طبيعي)) {
        لو ((*النطاقات)[فهرس_نطاق].فهرس_الحجة >= العدد) {
            أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                فشل_ذاكرة_نداء_نواة_مفسر((*النطاقات)[فهرس_نطاق].فهرس_الحجة)
            );
        };
        فهرس_نطاق := فهرس_نطاق + 1;
    }
    دع المهيأة: متغير متجه نطاق_مهيأ_لنداء_نواة_مفسر = [];
    دع فهرس_الحجة: متغير طبيعي = 0;
    طالما (فهرس_الحجة < العدد) {
        دع عدد_المطابقات: متغير طبيعي = 0;
        دع فهرس_النطاق: متغير طبيعي = 0;
        دع مؤشر_النطاق: متغير طبيعي = 0;
        طالما (فهرس_النطاق < (الطول(*النطاقات) مثل طبيعي)) {
            لو ((*النطاقات)[فهرس_النطاق].فهرس_الحجة == فهرس_الحجة) {
                عدد_المطابقات := عدد_المطابقات + 1;
                مؤشر_النطاق := فهرس_النطاق;
            };
            فهرس_النطاق := فهرس_النطاق + 1;
        }
        لو (عدد_المطابقات > 1 || (فهرس_الحجة == 0 && عدد_المطابقات != 0)) {
            أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
            );
        };
        طابق (*الحجج)[فهرس_الحجة] مع
        | قيمة_تشغيل.بتات_عدد(_) -> {
            // A scalar needs no memory translation. Unknown numeric pointer
            // roles remain an external contract blocker, not an implicit grant.
            لو (عدد_المطابقات != 0) {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
        }
        | قيمة_تشغيل.مرجع(المكان) -> {
            لو (عدد_المطابقات != 1 || فهرس_الحجة == 0) {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
            دع النطاق: نطاق_ذاكرة_نداء_مسير = (*النطاقات)[مؤشر_النطاق];
            لو (!قيمتا_مسير_متساويتان(
                النطاق.المؤشر, (*معرفات_الحجج)[فهرس_الحجة]
            )) {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
            طابق اقرأ_قيمة_خانة_مسير(الإطار, النطاق.الأصل) مع
            | نتيجة_قراءة_قيمة_خانة.موجودة(قيمة_تشغيل.مرجع(الأصل)) -> {
                لو (!مكانا_تشغيل_متطابقان(&المكان, &الأصل)) {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                };
            }
            | _ -> {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
            دع السعة: طبيعي;
            طابق اقرأ_طول_نطاق_نداء_نواة_مفسر(الإطار, النطاق.الطول) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            }
            | اختياري.موجود(القيمة) -> { السعة := القيمة; };
            دع المطلوب: طبيعي;
            طابق النطاق.المطلوب مع
            | اختياري.لا_شيء -> {
                // A capacity witness is not an OS-requested byte count.
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            }
            | اختياري.موجود(المعرف) -> {
                طابق اقرأ_طول_نطاق_نداء_نواة_مفسر(الإطار, المعرف) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                }
                | اختياري.موجود(القيمة) -> { المطلوب := القيمة; };
            };
            لو (المطلوب > السعة) {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
            طابق النطاق.الإذن مع
            | إذن_ذاكرة_نداء_مسير.قراءة -> { }
            | إذن_ذاكرة_نداء_مسير.كتابة -> {
                لو (!مؤشر_بايتات_مفسر_قابل_للكتابة(
                    &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
                    &(*الحالة).الذاكرة, الأنواع, المسير,
                    النطاق.المؤشر, &(*الحجج)[فهرس_الحجة]
                )) {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                };
            }
            | إذن_ذاكرة_نداء_مسير.قراءة_وكتابة -> {
                لو (!مؤشر_بايتات_مفسر_قابل_للكتابة(
                    &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
                    &(*الحالة).الذاكرة, الأنواع, المسير,
                    النطاق.المؤشر, &(*الحجج)[فهرس_الحجة]
                )) {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                };
            };
            // Resolve the live allocation and ALL bounds before staging any bytes.
            // Canonical identity detects aliases before host buffers are
            // allocated; independently staged overlapping spans are rejected.
            دع هوية_التخزين: نطاق_تخزين_بايتات_مفسر;
            طابق حل_هوية_نطاق_بايتات_مفسر(
                &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
                &(*الحالة).الذاكرة, الأنواع, المسير,
                النطاق.المؤشر, &(*الحجج)[فهرس_الحجة], المطلوب
            ) مع
            | نتيجة_هوية_نطاق_بايتات_مفسر.غير_صالح -> {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            }
            | نتيجة_هوية_نطاق_بايتات_مفسر.موجود(الهوية) -> {
                هوية_التخزين := الهوية;
            };
            دع فهرس_مهيأ: متغير طبيعي = 0;
            طالما (فهرس_مهيأ < (الطول(المهيأة) مثل طبيعي)) {
                لو (نطاقا_تخزين_بايتات_متداخلان(
                    &هوية_التخزين, &المهيأة[فهرس_مهيأ].هوية_التخزين
                )) {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                };
                فهرس_مهيأ := فهرس_مهيأ + 1;
            }
            // Copy-in proves the ACTUAL live extent in the canonical memory
            // owner before host storage is made available. Even output spans
            // require this check: the declared SSA capacity is not enough.
            دع البايتات: متجه ط8;
            طابق انسخ_نطاق_بايتات_من_مؤشر_مسير_مفسر(
                &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
                &(*الحالة).الذاكرة, الأنواع, المسير,
                النطاق.المؤشر, &(*الحجج)[فهرس_الحجة], 0, المطلوب
            ) مع
            | نتيجة_نسخ_بايتات_مفسر.أخفق(الخطأ) -> {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(الخطأ);
            }
            | نتيجة_نسخ_بايتات_مفسر.بايتات(المنسوخة) -> {
                البايتات := المنسوخة;
            };
            دع المهيأ: نطاق_مهيأ_لنداء_نواة_مفسر = {
                فهرس_الحجة: فهرس_الحجة,
                معرف_المؤشر: النطاق.المؤشر,
                المؤشر: انسخ_قيمة_تشغيل(&(*الحجج)[فهرس_الحجة]),
                المطلوب: المطلوب,
                الإذن: النطاق.الإذن,
                هوية_التخزين: هوية_التخزين,
                البايتات: البايتات
            };
            ألحق(المهيأة, المهيأ);
        }
        | _ -> {
            أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
            );
        };
        فهرس_الحجة := فهرس_الحجة + 1;
    }
    أرجع نتيجة_تحضير_نداء_نواة_مفسر.مهيأ(المهيأة);
}

// A verified transfer policy supplies the count for EACH writable buffer.
// Never infer it directly from the raw return word in this memory helper.
// This function never copies beyond the authenticated requested extent.
عرف انسخ_ناتج_نطاق_نداء_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    النطاق: &نطاق_مهيأ_لنداء_نواة_مفسر,
    المكتوب: طبيعي
): اختياري فشل_تفسير_مسير {
    لو (المكتوب > (*النطاق).المطلوب
        || المكتوب > (الطول((*النطاق).البايتات) مثل طبيعي)) {
        أرجع اختياري.موجود(فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة));
    };
    طابق (*النطاق).الإذن مع
    | إذن_ذاكرة_نداء_مسير.قراءة -> {
        لو (المكتوب != 0) {
            أرجع اختياري.موجود(فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة));
        };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { };
    لو (المكتوب == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < المكتوب) {
        ألحق(الناتج, (*النطاق).البايتات[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    دع عمق_المكدس_الحالي: طبيعي = عمق_مكدس_مفسر(الحالة);
    طابق انسخ_نطاق_بايتات_إلى_مؤشر_مسير_مفسر(
        &متغير (*الحالة).المكدس, عمق_المكدس_الحالي,
        &متغير (*الحالة).الذاكرة, الأنواع, المسير,
        (*النطاق).معرف_المؤشر, &(*النطاق).المؤشر, 0, &الناتج
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
}

// A verified result policy supplies an explicit byte count per staged buffer.
// Validate the ENTIRE result before changing Interpreter memory: no copy-back
// without authorization, no oversized/ambiguous transfers or read-only writes.
عرف انسخ_نتائج_نداء_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    النطاقات: &متجه نطاق_مهيأ_لنداء_نواة_مفسر,
    المكتوبة: &متجه طبيعي,
    يسمح_النسخ: منطقي
): اختياري فشل_تفسير_مسير {
    دع العدد: طبيعي = الطول(*النطاقات) مثل طبيعي;
    لو (العدد != (الطول(*المكتوبة) مثل طبيعي)) {
        أرجع اختياري.موجود(فشل_ذاكرة_نداء_نواة_مفسر(0));
    };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        دع النطاق: &نطاق_مهيأ_لنداء_نواة_مفسر = &(*النطاقات)[الفهرس];
        دع المكتوب: طبيعي = (*المكتوبة)[الفهرس];
        لو (المكتوب > (*النطاق).المطلوب
            || المكتوب > (الطول((*النطاق).البايتات) مثل طبيعي)
            || (!يسمح_النسخ && المكتوب != 0)) {
            أرجع اختياري.موجود(فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة));
        };
        طابق (*النطاق).الإذن مع
        | إذن_ذاكرة_نداء_مسير.قراءة -> {
            لو (المكتوب != 0) {
                أرجع اختياري.موجود(فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة));
            };
        }
        | _ -> { };
        الفهرس := الفهرس + 1;
    }
    لو (!يسمح_النسخ) { أرجع اختياري.لا_شيء(); };
    الفهرس := 0;
    طالما (الفهرس < العدد) {
        طابق انسخ_ناتج_نطاق_نداء_نواة_مفسر(
            الحالة, الأنواع, المسير, &(*النطاقات)[الفهرس], (*المكتوبة)[الفهرس]
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Per-call transfer policy comes from the authenticated STD signature, not
// a syscall number or a guessed meaning of its numeric return word. The
// caller must supply the RAW Linux return word (negative errno on this ABI).
// This is deliberately separate from host dispatch: no libc errno conversion.
نوع نتيجة_أطوال_نواة_مفسر =
    | موثقة بنوع (متجه طبيعي, منطقي)
    | مرفوضة
;

عرف احسب_أطوال_نسخ_نواة_مفسر(
    التوقيع: &توقيع_نداء_بدائي,
    النطاقات: &متجه نطاق_مهيأ_لنداء_نواة_مفسر,
    نتيجة_النواة: طبيعي
): نتيجة_أطوال_نواة_مفسر {
    دع الحد_الأعلى: طبيعي = ~((0 مثل طبيعي));
    دع أخفقت: منطقي = نتيجة_النواة >= (الحد_الأعلى - 4094);
    دع مقاطعة: منطقي = نتيجة_النواة == (الحد_الأعلى - 3);
    دع عدد_الكتابة: متغير طبيعي = 0;
    دع فهرس_الكاتب: متغير طبيعي = 0;
    دع فهرس_النطاق: متغير طبيعي = 0;
    طالما (فهرس_النطاق < (الطول(*النطاقات) مثل طبيعي)) {
        طابق (*النطاقات)[فهرس_النطاق].الإذن مع
        | إذن_ذاكرة_نداء_مسير.قراءة -> { }
        | _ -> {
            عدد_الكتابة := عدد_الكتابة + 1;
            فهرس_الكاتب := فهرس_النطاق;
        };
        فهرس_النطاق := فهرس_النطاق + 1;
    }
    دع أطوال: متغير متجه طبيعي = [];
    فهرس_النطاق := 0;
    طالما (فهرس_النطاق < (الطول(*النطاقات) مثل طبيعي)) {
        دع المكتوب: متغير طبيعي = 0;
        دع نطاق: &نطاق_مهيأ_لنداء_نواة_مفسر = &(*النطاقات)[فهرس_النطاق];
        طابق (*نطاق).الإذن مع
        | إذن_ذاكرة_نداء_مسير.قراءة -> { }
        | _ -> {
            طابق (*التوقيع).النسخ مع
            | نسخ_نتيجة_بدائي.بلا_نسخ -> { }
            | نسخ_نتيجة_بدائي.عدد_بايتات_النتيجة -> {
                // A return count cannot be unambiguously divided among two
                // writable buffers. Reject, including successful zero writes.
                لو (عدد_الكتابة != 1 || فهرس_الكاتب != فهرس_النطاق) {
                    أرجع نتيجة_أطوال_نواة_مفسر.مرفوضة();
                };
                لو (!أخفقت) { المكتوب := نتيجة_النواة; };
            }
            | نسخ_نتيجة_بدائي.كامل_عند_النجاح -> {
                لو (!أخفقت) { المكتوب := (*نطاق).المطلوب; };
            }
            | نسخ_نتيجة_بدائي.كامل_عند_المقاطعة -> {
                لو (مقاطعة) { المكتوب := (*نطاق).المطلوب; };
            };
        };
        لو (المكتوب > (*نطاق).المطلوب
            || المكتوب > (الطول((*نطاق).البايتات) مثل طبيعي)) {
            أرجع نتيجة_أطوال_نواة_مفسر.مرفوضة();
        };
        ألحق(أطوال, المكتوب);
        فهرس_النطاق := فهرس_النطاق + 1;
    }
    // An interrupted Linux operation may report a writable remainder even
    // though its return word is -EINTR. The policy is explicit for that case.
    دع يسمح_النسخ: منطقي = !أخفقت || (
        مقاطعة && (*التوقيع).النسخ == نسخ_نتيجة_بدائي.كامل_عند_المقاطعة()
    );
    أرجع نتيجة_أطوال_نواة_مفسر.موثقة(أطوال, يسمح_النسخ);
}

// This is the single result-sensitive entry into the pre-existing canonical
// memory copy-back helper. No host-result interpretation is duplicated in
// the memory layer, and an invalid policy cannot partially modify storage.
عرف طبق_نسخ_نتيجة_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التوقيع: &توقيع_نداء_بدائي,
    النطاقات: &متجه نطاق_مهيأ_لنداء_نواة_مفسر,
    نتيجة_النواة: طبيعي
): اختياري فشل_تفسير_مسير {
    طابق احسب_أطوال_نسخ_نواة_مفسر(التوقيع, النطاقات, نتيجة_النواة) مع
    | نتيجة_أطوال_نواة_مفسر.مرفوضة -> {
        أرجع اختياري.موجود(فشل_ذاكرة_نداء_نواة_مفسر(0));
    }
    | نتيجة_أطوال_نواة_مفسر.موثقة(الأطوال, يسمح_النسخ) -> {
        أرجع انسخ_نتائج_نداء_نواة_مفسر(
            الحالة, الأنواع, المسير, النطاقات, &الأطوال, يسمح_النسخ
        );
    };
}

// The validated call runs on the host kernel. The staged buffers are copied
// into separate host vectors (at least one byte each), the kernel writes into
// them, and only the authenticated transfer policy copies bytes back into
// interpreter memory. The interpreted target must share the host's numbering.
عرف نفذ_نداء_نواة_على_المضيف_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التوقيع: &توقيع_نداء_بدائي,
    الحجج: &متجه قيمة_تشغيل,
    المهيأة: متجه نطاق_مهيأ_لنداء_نواة_مفسر
): نتيجة_تنفيذ_بدائي_مفسر {
    دع رمز_المعمارية: متغير طبيعي = 0;
    طابق (*الحالة).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { رمز_المعمارية := 1; }
    | هوية_معمارية.ذراع_أربعة_وستون -> { رمز_المعمارية := 2; }
    | _ -> { };
    لو (رمز_المعمارية == 0 || رمز_المعمارية != معمارية_نواة_المضيف()) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نداء_نواة_خام())
            )
        );
    };
    دع الكلمات: متغير متجه ط64 = [0, 0, 0, 0, 0, 0, 0];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < 7) {
        طابق (*الحجج)[الموضع] مع
        | قيمة_تشغيل.بتات_عدد(القيمة) -> { الكلمات[الموضع] := القيمة مثل ط64; }
        | _ -> { };
        الموضع := الموضع + 1;
    }
    دع القوى: متجه طبيعي = [0, 1, 2, 4, 8, 16, 32];
    دع القناع: متغير طبيعي = 0;
    دع د1: متغير متجه ط8 = [0];
    دع د2: متغير متجه ط8 = [0];
    دع د3: متغير متجه ط8 = [0];
    دع د4: متغير متجه ط8 = [0];
    دع د5: متغير متجه ط8 = [0];
    دع د6: متغير متجه ط8 = [0];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المهيأة) مثل طبيعي)) {
        دع الخانة: طبيعي = المهيأة[ف].فهرس_الحجة;
        لو (الخانة == 0 || الخانة > 6) {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_ذاكرة_نداء_نواة_مفسر(الخانة));
        };
        القناع := القناع + القوى[الخانة];
        دع النسخة: متغير متجه ط8 = [];
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(المهيأة[ف].البايتات) مثل طبيعي)) {
            ألحق(النسخة, المهيأة[ف].البايتات[ك]);
            ك := ك + 1;
        }
        لو (الطول(النسخة) == 0) { ألحق(النسخة, 0 مثل ط8); };
        لو (الخانة == 1) { د1 := النسخة; }
        وإلا لو (الخانة == 2) { د2 := النسخة; }
        وإلا لو (الخانة == 3) { د3 := النسخة; }
        وإلا لو (الخانة == 4) { د4 := النسخة; }
        وإلا لو (الخانة == 5) { د5 := النسخة; }
        وإلا { د6 := النسخة; };
        ف := ف + 1;
    }
    دع الخام: ط64 = نفذ_نداء_نواة_مضيف(
        القناع, الكلمات[0],
        الكلمات[1], الكلمات[2], الكلمات[3], الكلمات[4], الكلمات[5], الكلمات[6],
        &متغير د1, &متغير د2, &متغير د3, &متغير د4, &متغير د5, &متغير د6
    );
    // Rebuild the staged records with the bytes the kernel left behind.
    دع المحدثة: متغير متجه نطاق_مهيأ_لنداء_نواة_مفسر = المهيأة;
    ف := 0;
    طالما (ف < (الطول(المحدثة) مثل طبيعي)) {
        دع الخانة: طبيعي = المحدثة[ف].فهرس_الحجة;
        دع العدد: طبيعي = الطول(المحدثة[ف].البايتات) مثل طبيعي;
        دع الجديدة: متغير متجه ط8 = [];
        دع ك: متغير طبيعي = 0;
        طالما (ك < العدد) {
            لو (الخانة == 1) { ألحق(الجديدة, د1[ك]); }
            وإلا لو (الخانة == 2) { ألحق(الجديدة, د2[ك]); }
            وإلا لو (الخانة == 3) { ألحق(الجديدة, د3[ك]); }
            وإلا لو (الخانة == 4) { ألحق(الجديدة, د4[ك]); }
            وإلا لو (الخانة == 5) { ألحق(الجديدة, د5[ك]); }
            وإلا { ألحق(الجديدة, د6[ك]); };
            ك := ك + 1;
        }
        المحدثة[ف].البايتات := الجديدة;
        ف := ف + 1;
    }
    طابق طبق_نسخ_نتيجة_نواة_مفسر(
        الحالة, الأنواع, المسير, التوقيع, &المحدثة, الخام مثل طبيعي
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
        اختياري.موجود(قيمة_تشغيل.بتات_عدد(الخام مثل طبيعي))
    );
}

// The authenticated MSIR witness is now available. The kernel entry still
// requires an actual host-machine syscall provider which returns the raw
// Linux ABI word and accepts temporary byte-buffer addresses. None exists
// in the current interpreter/runtime interface; never guess or substitute a
// libc syscall/errno wrapper, or forward unauthenticated numeric addresses.
// The exit status when a raw kernel call is Linux exit_group (x86_64 231,
// aarch64 94); لا_شيء for any other call.
عرف حالة_خروج_نداء_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الحجج: &متجه قيمة_تشغيل
): اختياري طبيعي {
    لو ((الطول(*الحجج) مثل طبيعي) < 2) { أرجع اختياري.لا_شيء(); };
    دع رقم_الخروج: متغير طبيعي = 0;
    طابق (*الحالة).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { رقم_الخروج := 231; }
    | هوية_معمارية.ذراع_أربعة_وستون -> { رقم_الخروج := 94; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق (*الحجج)[0] مع
    | قيمة_تشغيل.بتات_عدد(الرقم) -> {
        لو (الرقم != رقم_الخروج) { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق (*الحجج)[1] مع
    | قيمة_تشغيل.بتات_عدد(القيمة) -> { أرجع اختياري.موجود(القيمة % 256); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// ---- The foreign-call bridge ------------------------------------------------
// On hosts where std calls C functions (Windows, macOS) an extern call runs
// the host function itself through the generated table
// (host_externs_generated.sn), as ctypes or libffi call a resolved symbol:
// integer arguments pass as words, a null pointer as null, and a pointer to
// integer storage as the address of a host copy of the elements it
// designates; copies the callee changed are written back. A few functions
// whose results point into host memory are shims, as in Miri: the command
// line std reads at startup is the interpreted program's own.

// Masks a raw result word to an integer result Type's width.
عام عرف ناتج_خارجي_بعرض_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع, الخام: ط64): قيمة_تشغيل {
    دع العرض: طبيعي = عرض_صحيح_نوع_مفسر(الأنواع, النوع);
    دع القيمة: متغير طبيعي = الخام مثل طبيعي;
    لو (العرض > 0 && العرض < 8) {
        القيمة := القيمة & (((1 مثل طبيعي) << (العرض * 8)) - 1);
    };
    أرجع قيمة_تشغيل.بتات_عدد(القيمة);
}

عام عرف بايتات_متساوية_مفسر(الأولى: &متجه ط8, الثانية: &متجه ط8): منطقي {
    لو ((الطول(*الأولى) مثل طبيعي) != (الطول(*الثانية) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأولى) مثل طبيعي)) {
        لو ((*الأولى)[ف] != (*الثانية)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// ---- The dynamic host bridge ------------------------------------------------
// A raw kernel call that std's contract table does not describe (a user
// program's own call, clone, execve, wait, mmap, socket options, ...) runs on
// the host with its operands marshalled from their runtime values, the way
// Miri's shims and libffi marshal a foreign call: an integer passes as is, a
// null pointer as 0, a pointer to integer storage (a u8 or integer vector
// from the referenced element, or one integer variable) as the address of a
// host copy of those bytes, and a pointer to a table of string pointers (the
// argv/envp shape of execve) as a host pointer table. After the call each
// copy that changed is written back to interpreter memory. A fork-like clone
// forks the interpreter itself: the child interprets the child's path, which
// only closes descriptors, calls execve and reports failure through a pipe.
// The interpreted target must use the host's syscall numbering.

// Staging slack after each copy: a kernel that writes a few bytes past an
// undersized buffer overflows the copy's slack, not the interpreter.
عرف هامش_نسخة_نواة_مفسر(): طبيعي { أرجع 64; }

نوع نسخة_نواة_مفسر = {
    الامتداد: امتداد_بايتات_مفسر,
    الطول: طبيعي,
    الأصلية: متجه ط8
};

عرف فشل_نداء_ديناميكي_مفسر(الفهرس: طبيعي): نتيجة_تنفيذ_بدائي_مفسر {
    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_ذاكرة_نداء_نواة_مفسر(الفهرس));
}

// The NUL-terminated strings of a NULL-terminated pointer table whose
// first element المكان names.
عرف اجمع_جدول_سلاسل_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المكان: &مكان_تشغيل,
    نوع_العنصر: معرف_نوع
): اختياري متجه متجه ط8 {
    دع السلاسل: متغير متجه متجه ط8 = [];
    دع نوع_الحرف: معرف_نوع;
    طابق نوع_داخل_مؤشر_بنوع_مفسر(الأنواع, نوع_العنصر) مع
    | اختياري.موجود(النوع) -> { نوع_الحرف := النوع; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع الموضع: متغير مكان_تشغيل = انسخ_مكان_تشغيل(المكان);
    دع العدد: متغير طبيعي = 0;
    طالما (العدد < 65536) {
        دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
        دع العنصر: قيمة_تشغيل;
        طابق اقرأ_مكان_مفسر(&(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, &الموضع) مع
        | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> { العنصر := القيمة; }
        | نتيجة_قراءة_ذاكرة_مفسر.أخفق(_) -> { أرجع اختياري.لا_شيء(); };
        طابق العنصر مع
        | قيمة_تشغيل.مؤشر_فارغ -> { أرجع اختياري.موجود(السلاسل); }
        | قيمة_تشغيل.مرجع(مكان_السلسلة) -> {
            دع الامتداد: امتداد_بايتات_مفسر = امتداد_بايتات_مكان_مفسر(
                &(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, الأنواع, &مكان_السلسلة, نوع_الحرف
            );
            دع الطول_الكلي: طبيعي = طول_امتداد_بايتات_مفسر(&(*الحالة).الذاكرة, &الامتداد);
            طابق اقرأ_بايتات_امتداد_مفسر(
                &(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, &الامتداد, 0, الطول_الكلي
            ) مع
            | نتيجة_نسخ_بايتات_مفسر.بايتات(البايتات) -> {
                // Up to and including the NUL.
                دع السلسلة: متغير متجه ط8 = [];
                دع وجد_صفر: متغير منطقي = خطأ;
                دع ب: متغير طبيعي = 0;
                طالما (ب < (الطول(البايتات) مثل طبيعي) && !وجد_صفر) {
                    ألحق(السلسلة, البايتات[ب]);
                    لو (البايتات[ب] == (0 مثل ط8)) { وجد_صفر := صواب; };
                    ب := ب + 1;
                }
                لو (!وجد_صفر) { أرجع اختياري.لا_شيء(); };
                ألحق(السلاسل, السلسلة);
            }
            | نتيجة_نسخ_بايتات_مفسر.أخفق(_) -> { أرجع اختياري.لا_شيء(); };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
        // The next element of the table.
        دع آخر: طبيعي = الطول(الموضع.الإسقاطات) مثل طبيعي;
        لو (آخر == 0) { أرجع اختياري.لا_شيء(); };
        طابق الموضع.الإسقاطات[آخر - 1] مع
        | إسقاط_مكان_تشغيل.فهرس(الفهرس) -> {
            الموضع.الإسقاطات[آخر - 1] := إسقاط_مكان_تشغيل.فهرس(الفهرس + 1);
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
        العدد := العدد + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف نفذ_نداء_نواة_ديناميكي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: طبيعي,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    لو ((الطول(*الحجج) مثل طبيعي) != 7 || (الطول(*معرفات_الحجج) مثل طبيعي) != 7) {
        أرجع فشل_نداء_ديناميكي_مفسر(0);
    };
    دع رمز_المعمارية: متغير طبيعي = 0;
    طابق (*الحالة).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { رمز_المعمارية := 1; }
    | هوية_معمارية.ذراع_أربعة_وستون -> { رمز_المعمارية := 2; }
    | _ -> { };
    لو (رمز_المعمارية == 0 || رمز_المعمارية != معمارية_نواة_المضيف()) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نداء_نواة_خام())
            )
        );
    };
    دع الكلمات: متغير متجه ط64 = [0, 0, 0, 0, 0, 0, 0];
    طابق (*الحجج)[0] مع
    | قيمة_تشغيل.بتات_عدد(الرقم) -> { الكلمات[0] := الرقم مثل ط64; }
    | _ -> { أرجع فشل_نداء_ديناميكي_مفسر(0); };
    دع القوى: متجه طبيعي = [0, 1, 2, 4, 8, 16, 32];
    دع القناع: متغير طبيعي = 0;
    دع النسخ: متغير متجه نسخة_نواة_مفسر = [];
    دع مواضع_النسخ: متغير متجه طبيعي = [];
    دع د1: متغير متجه ط8 = [0];
    دع د2: متغير متجه ط8 = [0];
    دع د3: متغير متجه ط8 = [0];
    دع د4: متغير متجه ط8 = [0];
    دع د5: متغير متجه ط8 = [0];
    دع د6: متغير متجه ط8 = [0];
    دع جدول_2: متغير متجه متجه ط8 = [];
    دع جدول_3: متغير متجه متجه ط8 = [];
    دع جداول: متغير طبيعي = 0;
    دع الخانة: متغير طبيعي = 1;
    طالما (الخانة <= 6) {
        طابق (*الحجج)[الخانة] مع
        | قيمة_تشغيل.بتات_عدد(القيمة) -> { الكلمات[الخانة] := القيمة مثل ط64; }
        | قيمة_تشغيل.مؤشر_فارغ -> { الكلمات[الخانة] := 0; }
        | قيمة_تشغيل.مرجع(المكان) -> {
            دع نوع_الحجة: معرف_نوع;
            طابق نوع_قيمة_مفسر(المسير, (*معرفات_الحجج)[الخانة]) مع
            | اختياري.موجود(النوع) -> { نوع_الحجة := النوع; }
            | اختياري.لا_شيء -> { أرجع فشل_نداء_ديناميكي_مفسر(الخانة); };
            دع الداخل: معرف_نوع;
            طابق نوع_داخل_مؤشر_بنوع_مفسر(الأنواع, نوع_الحجة) مع
            | اختياري.موجود(النوع) -> { الداخل := النوع; }
            | اختياري.لا_شيء -> { أرجع فشل_نداء_ديناميكي_مفسر(الخانة); };
            // A pointer to pointers: a NULL-terminated string table.
            طابق نوع_داخل_مؤشر_بنوع_مفسر(الأنواع, الداخل) مع
            | اختياري.موجود(_) -> {
                لو (الخانة != 2 && الخانة != 3) { أرجع فشل_نداء_ديناميكي_مفسر(الخانة); };
                طابق اجمع_جدول_سلاسل_نواة_مفسر(الحالة, الأنواع, &المكان, الداخل) مع
                | اختياري.موجود(السلاسل) -> {
                    لو (الخانة == 2) { جدول_2 := السلاسل; } وإلا { جدول_3 := السلاسل; };
                    جداول := جداول + 1;
                }
                | اختياري.لا_شيء -> { أرجع فشل_نداء_ديناميكي_مفسر(الخانة); };
            }
            | اختياري.لا_شيء -> {
                دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
                دع الامتداد: امتداد_بايتات_مفسر = امتداد_بايتات_مكان_مفسر(
                    &(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, الأنواع, &المكان, الداخل
                );
                دع الطول_الكلي: طبيعي = طول_امتداد_بايتات_مفسر(&(*الحالة).الذاكرة, &الامتداد);
                دع البايتات: متغير متجه ط8 = [];
                طابق اقرأ_بايتات_امتداد_مفسر(
                    &(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, &الامتداد, 0, الطول_الكلي
                ) مع
                | نتيجة_نسخ_بايتات_مفسر.بايتات(المقروءة) -> { البايتات := المقروءة; }
                | نتيجة_نسخ_بايتات_مفسر.أخفق(_) -> { أرجع فشل_نداء_ديناميكي_مفسر(الخانة); };
                دع الأصلية: متجه ط8 = انسخ_بايتات(&البايتات);
                دع الهامش: متغير طبيعي = 0;
                طالما (الهامش < هامش_نسخة_نواة_مفسر()) {
                    ألحق(البايتات, 0 مثل ط8);
                    الهامش := الهامش + 1;
                }
                لو (الخانة == 1) { د1 := البايتات; }
                وإلا لو (الخانة == 2) { د2 := البايتات; }
                وإلا لو (الخانة == 3) { د3 := البايتات; }
                وإلا لو (الخانة == 4) { د4 := البايتات; }
                وإلا لو (الخانة == 5) { د5 := البايتات; }
                وإلا { د6 := البايتات; };
                القناع := القناع + القوى[الخانة];
                دع النسخة: نسخة_نواة_مفسر = {
                    الامتداد: الامتداد, الطول: الطول_الكلي, الأصلية: الأصلية
                };
                ألحق(النسخ, النسخة);
                ألحق(مواضع_النسخ, الخانة);
            };
        }
        | _ -> { أرجع فشل_نداء_ديناميكي_مفسر(الخانة); };
        الخانة := الخانة + 1;
    }
    دع الخام: متغير ط64 = 0;
    لو (جداول != 0) {
        // execve(path, argv, envp): the one pointer-table shape.
        لو (جداول != 2 || القناع != 1) { أرجع فشل_نداء_ديناميكي_مفسر(2); };
        الخام := نفذ_تشغيل_برنامج_مضيف(الكلمات[0], &متغير د1, &متغير جدول_2, &متغير جدول_3);
    } وإلا {
        الخام := نفذ_نداء_نواة_مضيف(
            القناع, الكلمات[0],
            الكلمات[1], الكلمات[2], الكلمات[3], الكلمات[4], الكلمات[5], الكلمات[6],
            &متغير د1, &متغير د2, &متغير د3, &متغير د4, &متغير د5, &متغير د6
        );
    };
    // Write back each copy the kernel changed.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النسخ) مثل طبيعي)) {
        دع الخانة_المنسوخة: طبيعي = مواضع_النسخ[ف];
        دع الجديدة: متغير متجه ط8 = [];
        دع ب: متغير طبيعي = 0;
        دع تغيرت: متغير منطقي = خطأ;
        طالما (ب < النسخ[ف].الطول) {
            دع البايت: متغير ط8 = 0;
            لو (الخانة_المنسوخة == 1) { البايت := د1[ب]; }
            وإلا لو (الخانة_المنسوخة == 2) { البايت := د2[ب]; }
            وإلا لو (الخانة_المنسوخة == 3) { البايت := د3[ب]; }
            وإلا لو (الخانة_المنسوخة == 4) { البايت := د4[ب]; }
            وإلا لو (الخانة_المنسوخة == 5) { البايت := د5[ب]; }
            وإلا { البايت := د6[ب]; };
            لو (البايت != النسخ[ف].الأصلية[ب]) { تغيرت := صواب; };
            ألحق(الجديدة, البايت);
            ب := ب + 1;
        }
        لو (تغيرت) {
            دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
            طابق اكتب_بايتات_امتداد_مفسر(
                &متغير (*الحالة).المكدس, العمق, &متغير (*الحالة).الذاكرة,
                &النسخ[ف].الامتداد, 0, &الجديدة
            ) مع
            | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ); }
            | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { };
        };
        ف := ف + 1;
    }
    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
        اختياري.موجود(قيمة_تشغيل.بتات_عدد(الخام مثل طبيعي))
    );
}

عرف نفذ_نداء_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: طبيعي,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    النطاقات: &متجه نطاق_ذاكرة_نداء_مسير,
    العقد: &اختياري عقد_نواة_مسير
): نتيجة_تنفيذ_بدائي_مفسر {
    // A registered host-compatible target is necessary but cannot authorize
    // cross-platform numeric syscall execution by itself.
    لو ((*الحالة).الهدف.المنصة.المنصة != هوية_منصة.لينكس()) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(
                    هوية_بدائي_مترجم.نداء_نواة_خام()
                )
            )
        );
    };
    لو (موضع_الإطار >= عمق_مكدس_مفسر(الحالة)) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_ذاكرة_نداء_نواة_مفسر(0));
    };
    // Process exit (std.process.exit, the stop primitive and a failed
    // assertion end here): Linux exit_group ends the interpretation with the
    // status's low byte, as the kernel reports it. It takes no buffer.
    طابق حالة_خروج_نداء_نواة_مفسر(الحالة, الحجج) مع
    | اختياري.موجود(الحالة_الخامة) -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أنهى_العملية(الحالة_الخامة);
    }
    | اختياري.لا_شيء -> { };
    دع التوقيع: توقيع_نداء_بدائي;
    طابق وثق_توقيع_نداء_نواة_مفسر(
        &(*الحالة).المكدس[موضع_الإطار],
        المسير, العقد, معرفات_الحجج, الحجج, النطاقات
    ) مع
    | اختياري.لا_شيء -> {
        // No contract describes this call: marshal it from its values.
        أرجع نفذ_نداء_نواة_ديناميكي_مفسر(
            الحالة, موضع_الإطار, الأنواع, المسير, معرفات_الحجج, الحجج
        );
    }
    | اختياري.موجود(الموثق) -> { التوقيع := الموثق; };
    طابق حضر_نطاقات_نداء_نواة_مفسر(
        الحالة, موضع_الإطار, الأنواع, المسير, معرفات_الحجج, الحجج, النطاقات
    ) مع
    | نتيجة_تحضير_نداء_نواة_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
    }
    | نتيجة_تحضير_نداء_نواة_مفسر.مهيأ(المهيأة) -> {
        // For a C-string operand the source extent must contain the NUL.
        // Passing all-capacity data without a terminator would let the kernel
        // read past the verified allocation, despite otherwise valid bounds.
        دع فهرس_النطاق: متغير طبيعي = 0;
        طالما (فهرس_النطاق < (الطول(المهيأة) مثل طبيعي)) {
            دع النطاق: &نطاق_مهيأ_لنداء_نواة_مفسر = &المهيأة[فهرس_النطاق];
            طابق التوقيع.الأدوار[(*النطاق).فهرس_الحجة - 1] مع
            | دور_وسيطة_بدائي.مخزن(_, الحد) -> {
                طابق الحد مع
                | حد_وصول_بدائي.سلسلة_صفرية -> {
                    دع وجد_صفر: متغير منطقي = خطأ;
                    دع فهرس_البايت: متغير طبيعي = 0;
                    طالما (فهرس_البايت < (الطول((*النطاق).البايتات) مثل طبيعي)) {
                        لو ((*النطاق).البايتات[فهرس_البايت] == (0 مثل ط8)) {
                            وجد_صفر := صواب;
                        };
                        فهرس_البايت := فهرس_البايت + 1;
                    }
                    لو (!وجد_صفر) {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                            فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة)
                        );
                    };
                }
                | _ -> { };
            }
            | _ -> { };
            فهرس_النطاق := فهرس_النطاق + 1;
        }
        أرجع نفذ_نداء_نواة_على_المضيف_مفسر(
            الحالة, الأنواع, المسير, &التوقيع, الحجج, المهيأة
        );
    };
    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
        فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نداء_نواة_خام())
        )
    );
}

// The float layout of a float primitive's operand (f32 or f64).
عرف وصف_عائم_لحجة_بدائية_مفسر(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري وصف_عائم_برمجي {
    طابق نوع_قيمة_مفسر(المسير, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                لو (صنف_النوع_البدائي(البدائي) != صنف_نوع_بدائي.عشري()) { أرجع اختياري.لا_شيء(); };
                دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                لو (البتات != 32 && البتات != 64) { أرجع اختياري.لا_شيء(); };
                أرجع اختياري.موجود(وصف_عائم_برمجي_من(البتات));
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
        };
    };
}

// IEEE float primitives on raw bits (float_software.sn).
عرف نفذ_عملية_عائمة_مفسر(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    العملية: عملية_عائمة_بدائية,
    المعرفات: &متجه معرف_قيمة_مسير,
    القيم: &متجه قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    دع الوصف: وصف_عائم_برمجي;
    طابق وصف_عائم_لحجة_بدائية_مفسر(الأنواع, المسير, (*المعرفات)[0]) مع
    | اختياري.موجود(و) -> { الوصف := و; }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود((*المعرفات)[0]))
        );
    };
    دع الخامات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        طابق (*القيم)[ف] مع
        | قيمة_تشغيل.بتات_عدد(العدد) -> { ألحق(الخامات, العدد); }
        | _ -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود((*المعرفات)[ف]))
            );
        };
        ف := ف + 1;
    }
    دع الناتج: متغير طبيعي = 0;
    طابق العملية مع
    | عملية_عائمة_بدائية.جذر_تربيعي -> { الناتج := جذر_عائم_برمجي(الخامات[0], الوصف); }
    | عملية_عائمة_بدائية.قيمة_مطلقة -> { الناتج := قيمة_مطلقة_عائمة_برمجية(الخامات[0], الوصف); }
    | عملية_عائمة_بدائية.بتر -> { الناتج := قرب_إلى_صحيح_عائم_برمجي(الخامات[0], 0, الوصف); }
    | عملية_عائمة_بدائية.أرضية -> { الناتج := قرب_إلى_صحيح_عائم_برمجي(الخامات[0], 1, الوصف); }
    | عملية_عائمة_بدائية.سقف -> { الناتج := قرب_إلى_صحيح_عائم_برمجي(الخامات[0], 2, الوصف); }
    | عملية_عائمة_بدائية.تقريب_زوجي -> { الناتج := قرب_إلى_صحيح_عائم_برمجي(الخامات[0], 3, الوصف); }
    | عملية_عائمة_بدائية.أدنى -> { الناتج := أدنى_أقصى_عائم_برمجي(الخامات[0], الخامات[1], خطأ, الوصف); }
    | عملية_عائمة_بدائية.أقصى -> { الناتج := أدنى_أقصى_عائم_برمجي(الخامات[0], الخامات[1], صواب, الوصف); }
    | عملية_عائمة_بدائية.نسخ_إشارة -> { الناتج := نسخ_إشارة_عائمة_برمجي(الخامات[0], الخامات[1], الوصف); }
    | عملية_عائمة_بدائية.ضرب_جمع_مدمج -> {
        الناتج := ضرب_جمع_مدمج_عائم_برمجي(الخامات[0], الخامات[1], الخامات[2], الوصف);
    };
    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.بتات_عدد(الناتج)));
}

عام عرف نفذ_بدائي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: طبيعي,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    الهوية: هوية_بدائي_مترجم,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    الوجهة: اختياري معرف_قيمة_مسير,
    مكان_التعديل: اختياري معرف_قيمة_مسير,
    نطاقات_الذاكرة: &متجه نطاق_ذاكرة_نداء_مسير,
    عقد_النواة: &اختياري عقد_نواة_مسير
): نتيجة_تنفيذ_بدائي_مفسر {
    دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(الهوية);
    دع قيم_الحجج: متجه قيمة_تشغيل = *الحجج;
    دع المعرفات: متجه معرف_قيمة_مسير = *معرفات_الحجج;
    دع العدد: طبيعي = الطول(قيم_الحجج) مثل طبيعي;
    لو (العدد != العقد.عدد_الحجج) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.عدد_حجج_بدائي_غير_متسق(
                    الهوية,
                    العقد.عدد_الحجج,
                    العدد
                )
            )
        );
    };

    طابق العقد.فئة_الناتج مع
    | فئة_ناتج_بدائي.بلا_قيمة -> {
        طابق الوجهة مع
        | اختياري.موجود(_) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
                )
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> {
        طابق الوجهة مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
            );
        }
        | اختياري.موجود(_) -> { };
    };

    طابق الهوية مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> {
        أرجع نفذ_نداء_نواة_مفسر(
            الحالة, موضع_الإطار, الأنواع, المسير,
            &المعرفات, &قيم_الحجج, نطاقات_الذاكرة, عقد_النواة
        );
    }
    | هوية_بدائي_مترجم.طول -> {
        أرجع نفذ_طول_بدائي(الحالة, &قيم_الحجج[0]);
    }
    | هوية_بدائي_مترجم.بتات_ع64 -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.بتات_ع32 -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.عملية_عائمة(العملية) -> {
        أرجع نفذ_عملية_عائمة_مفسر(الأنواع, المسير, العملية, &المعرفات, &قيم_الحجج);
    }
    | هوية_بدائي_مترجم.تبديل_موضعين -> {
        // This intrinsic must be eliminated by MSIR lowering before interpretation.
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة())
        );
    }
    | هوية_بدائي_مترجم.استنساخ -> {
        // Replaced by Type clone glue during MSIR lowering (ownership_glue.sn).
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة())
        );
    }
    | هوية_بدائي_مترجم.احتفاظ_بقيمة -> {
        // Replaced by Type copy glue during MSIR lowering (ownership_glue.sn).
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة())
        );
    }
    // Closure environments are counted as the native header counts them. A
    // named function used as a value (قيمة_تشغيل.دالة) has no environment:
    // it is never counted and never destroyed.
    | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.إغلاق(المعرف) -> {
            لو (!زد_مراجع_إغلاق_مفسر(&متغير (*الحالة).الذاكرة, المعرف)) {
                أرجع فشل_حجة_بدائي(الهوية, 0);
            };
        }
        | _ -> { };
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء());
    }
    | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.إغلاق(المعرف) -> {
            طابق أنقص_مراجع_إغلاق_مفسر(&متغير (*الحالة).الذاكرة, المعرف) مع
            | اختياري.موجود(لا_مراجع) -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.منطق(لا_مراجع)));
            }
            | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
        }
        | _ -> { };
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.منطق(خطأ)));
    }
    | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.إغلاق(المعرف) -> {
            لو (!وجه_إغلاق_إلى_مدمره_مفسر(&متغير (*الحالة).الذاكرة, المعرف)) {
                أرجع فشل_حجة_بدائي(الهوية, 0);
            };
            أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.إغلاق(المعرف)));
        }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.مخزن(المخزن) -> {
            طابق ألحق_بمخزن_مفسر(
                &متغير (*الحالة).الذاكرة, المخزن, انسخ_قيمة_تشغيل(&قيم_الحجج[1])
            ) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المخزن.القيمة)
                ));
            }
            | اختياري.موجود(الجديد) -> {
                لو (الجديد.القيمة == المخزن.القيمة && الجديد.الجيل == المخزن.الجيل) {
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء());
                };
                // A literal's buffer was copied to grow: the vector's place
                // takes the new handle, as a reallocated pointer is stored.
                طابق مكان_التعديل مع
                | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 0); }
                | اختياري.موجود(معرف_المكان) -> {
                    طابق اقرأ_مكان_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], معرف_المكان) مع
                    | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
                    }
                    | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
                        طابق حدّث_مكان_من_إطار_بدائي(
                            الحالة, موضع_الإطار, &المكان, قيمة_تشغيل.مخزن(الجديد)
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ); }
                        | اختياري.لا_شيء -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()); };
                    };
                };
            };
        }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    }
    | هوية_بدائي_مترجم.سعة_متجه -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.مخزن(المخزن) -> {
            طابق سعة_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن) مع
            | اختياري.موجود(السعة) -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.بتات_عدد(السعة)));
            }
            | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
        }
        // Values without a buffer (inline text, aggregates) hold exactly
        // their elements.
        | _ -> { أرجع نفذ_طول_بدائي(الحالة, &قيم_الحجج[0]); };
    }
    | هوية_بدائي_مترجم.حجز_سعة_متجه -> {
        دع الإضافي: طبيعي;
        طابق قيم_الحجج[1] مع
        | قيمة_تشغيل.بتات_عدد(البتات) -> { الإضافي := البتات; }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 1); };
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.مخزن(المخزن) -> {
            طابق احجز_سعة_مخزن_مفسر(&متغير (*الحالة).الذاكرة, المخزن, الإضافي) مع
            | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 0); }
            | اختياري.موجود(الجديد) -> {
                لو (الجديد.القيمة == المخزن.القيمة && الجديد.الجيل == المخزن.الجيل) {
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء());
                };
                // A literal's static buffer was copied: the place takes the copy.
                طابق مكان_التعديل مع
                | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 0); }
                | اختياري.موجود(معرف_المكان) -> {
                    طابق اقرأ_مكان_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], معرف_المكان) مع
                    | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
                    }
                    | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
                        طابق حدّث_مكان_من_إطار_بدائي(
                            الحالة, موضع_الإطار, &المكان, قيمة_تشغيل.مخزن(الجديد)
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ); }
                        | اختياري.لا_شيء -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()); };
                    };
                };
            };
        }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    }
    | هوية_بدائي_مترجم.ضبط_طول_متجه -> {
        دع الطول_الجديد: طبيعي;
        طابق قيم_الحجج[1] مع
        | قيمة_تشغيل.بتات_عدد(البتات) -> { الطول_الجديد := البتات; }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 1); };
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.مخزن(المخزن) -> {
            طابق اقتطع_مخزن_مفسر(&متغير (*الحالة).الذاكرة, المخزن, الطول_الجديد) مع
            | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 0); }
            | اختياري.موجود(الجديد) -> {
                لو (الجديد.القيمة == المخزن.القيمة && الجديد.الجيل == المخزن.الجيل) {
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء());
                };
                // A literal's static buffer was copied: the place takes the copy.
                طابق مكان_التعديل مع
                | اختياري.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 0); }
                | اختياري.موجود(معرف_المكان) -> {
                    طابق اقرأ_مكان_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], معرف_المكان) مع
                    | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
                    }
                    | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
                        طابق حدّث_مكان_من_إطار_بدائي(
                            الحالة, موضع_الإطار, &المكان, قيمة_تشغيل.مخزن(الجديد)
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ); }
                        | اختياري.لا_شيء -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()); };
                    };
                };
            };
        }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    }
    // Pop and truncate are lowered to MSIR before interpretation.
    | هوية_بدائي_مترجم.إزالة_الأخير -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة())
        );
    }
    | هوية_بدائي_مترجم.اقتطاع_متجه -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة())
        );
    }
    | هوية_بدائي_مترجم.تحرير -> {
        طابق حرر_تخزين_قيمة_مفسر(&متغير (*الحالة).الذاكرة, &قيم_الحجج[0]) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ); }
        | اختياري.لا_شيء -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()); };
    }
    | هوية_بدائي_مترجم.معمارية_المضيف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختياري.موجود(قيمة_تشغيل.بتات_عدد(رمز_معمارية_المضيف_الحالية() مثل طبيعي))
        );
    }
    | هوية_بدائي_مترجم.منصة_المضيف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختياري.موجود(قيمة_تشغيل.بتات_عدد(رمز_منصة_المضيف_الحالية() مثل طبيعي))
        );
    }
    | هوية_بدائي_مترجم.بيئة_المضيف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختياري.موجود(قيمة_تشغيل.بتات_عدد(رمز_بيئة_المضيف_الحالية() مثل طبيعي))
        );
    }
    // WebAssembly linear-memory operations exist only in wasm32 machine code;
    // the interpreter has no linear memory and reports them as unsupported.
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نمو_ذاكرة_خطية())
            )
        );
    }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.قراءة_ذاكرة_خطية())
            )
        );
    }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.كتابة_ذاكرة_خطية())
            )
        );
    }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نسخ_ذاكرة_خطية())
            )
        );
    }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.قاعدة_كومة_خطية())
            )
        );
    }
    // Raw machine memory belongs to compiled native code; the interpreter's
    // values have no machine addresses.
    // Raw machine memory: the host pages the program mapped through the
    // raw kernel call (std's allocation provider), read and written on the
    // host as the native program would (host_calls.sn).
    | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> {
        لو (ذاكرة_آلة_مضيف_متاحة()) {
            طابق قيم_الحجج[0] مع
            | قيمة_تشغيل.بتات_عدد(العنوان) -> {
                دع الكلمة: ط64 = اقرأ_ذاكرة_آلة_مضيف(العنوان مثل ط64);
                أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                    اختياري.موجود(قيمة_تشغيل.بتات_عدد(الكلمة مثل طبيعي))
                );
            }
            | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
        };
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.قراءة_ذاكرة_آلة())
            )
        );
    }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> {
        لو (ذاكرة_آلة_مضيف_متاحة()) {
            طابق قيم_الحجج[0] مع
            | قيمة_تشغيل.بتات_عدد(العنوان) -> {
                طابق قيم_الحجج[1] مع
                | قيمة_تشغيل.بتات_عدد(الكلمة) -> {
                    اكتب_ذاكرة_آلة_مضيف(العنوان مثل ط64, الكلمة مثل ط64);
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء());
                }
                | _ -> { أرجع فشل_حجة_بدائي(الهوية, 1); };
            }
            | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
        };
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.كتابة_ذاكرة_آلة())
            )
        );
    }
    // Reflection facts are folded by the driver before any execution
    // (driver/compile_time.sn); reaching one here is not a valid program.
    | هوية_بدائي_مترجم.حجم_النوع -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.حجم_النوع())
        ));
    }
    | هوية_بدائي_مترجم.محاذاة_النوع -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.محاذاة_النوع())
        ));
    }
    // Lowered to MSIR arithmetic; never called.
    | هوية_بدائي_مترجم.جمع_ملتف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.جمع_ملتف())
        ));
    }
    // Lowered to MSIR arithmetic; never called.
    | هوية_بدائي_مترجم.طرح_ملتف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.طرح_ملتف())
        ));
    }
    // Lowered to MSIR arithmetic; never called.
    | هوية_بدائي_مترجم.ضرب_ملتف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.ضرب_ملتف())
        ));
    }
    // Lowered to MSIR arithmetic; never called.
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة())
        ));
    }
    // Lowered to MSIR arithmetic; never called.
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة())
        ));
    }
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.عدد_حقول_النوع())
        ));
    }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.عدد_منشئات_النوع())
        ));
    }
    | هوية_بدائي_مترجم.ذري_حمل -> { أرجع نفذ_بدائي_ذري_مفسر(الحالة, موضع_الإطار, الأنواع, المسير, الهوية, &المعرفات, &قيم_الحجج); }
    | هوية_بدائي_مترجم.ذري_خزن -> { أرجع نفذ_بدائي_ذري_مفسر(الحالة, موضع_الإطار, الأنواع, المسير, الهوية, &المعرفات, &قيم_الحجج); }
    | هوية_بدائي_مترجم.ذري_تبديل -> { أرجع نفذ_بدائي_ذري_مفسر(الحالة, موضع_الإطار, الأنواع, المسير, الهوية, &المعرفات, &قيم_الحجج); }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { أرجع نفذ_بدائي_ذري_مفسر(الحالة, موضع_الإطار, الأنواع, المسير, الهوية, &المعرفات, &قيم_الحجج); }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> { أرجع نفذ_بدائي_ذري_مفسر(الحالة, موضع_الإطار, الأنواع, المسير, الهوية, &المعرفات, &قيم_الحجج); }
    | هوية_بدائي_مترجم.ذري_جلب_و -> { أرجع نفذ_بدائي_ذري_مفسر(الحالة, موضع_الإطار, الأنواع, المسير, الهوية, &المعرفات, &قيم_الحجج); }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> { أرجع نفذ_بدائي_ذري_مفسر(الحالة, موضع_الإطار, الأنواع, المسير, الهوية, &المعرفات, &قيم_الحجج); }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { أرجع نفذ_بدائي_ذري_مفسر(الحالة, موضع_الإطار, الأنواع, المسير, الهوية, &المعرفات, &قيم_الحجج); }
    | هوية_بدائي_مترجم.سياج_ذاكرة -> { أرجع نفذ_بدائي_ذري_مفسر(الحالة, موضع_الإطار, الأنواع, المسير, الهوية, &المعرفات, &قيم_الحجج); }
    // A leaked box: a writable place rooted at its cell (raw pointers are places).
    | هوية_بدائي_مترجم.سرب_قيمة -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.صندوق(المعرف) -> {
            دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [];
            دع المكان: مكان_تشغيل = {
                الجذر: جذر_مكان_تشغيل.صندوق(المعرف), الإسقاطات: الإسقاطات, قابل_للكتابة: صواب
            };
            أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.مرجع(المكان)));
        }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    }
    // Closure values are interpreter handles, not addresses, and threads
    // cannot start here: these belong to compiled programs only.
    | هوية_بدائي_مترجم.عنوان_دالة -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.عنوان_دالة())
        ));
    }
    | هوية_بدائي_مترجم.دالة_من_عنوان -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.دالة_من_عنوان())
        ));
    }
    | هوية_بدائي_مترجم.مدخل_سي_لدالة -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.مدخل_سي_لدالة())
        ));
    }
    | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.استنساخ_خيط_نواة())
        ));
    }
    // An interpreted program has no machine addresses of C functions; the
    // interpreter itself calls C through its foreign-call bridge.
    | هوية_بدائي_مترجم.نداء_عنوان_سي -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نداء_عنوان_سي())
        ));
    }
    | هوية_بدائي_مترجم.فشل_وقت_الترجمة -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.نص(الرسالة) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_فشل_مطلوب(انسخ_بايتات(&الرسالة))
            ));
        }
        | قيمة_تشغيل.مخزن(المخزن) -> {
            طابق بايتات_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن) مع
            | اختياري.موجود(الرسالة) -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_فشل_مطلوب(الرسالة)
                ));
            }
            | اختياري.لا_شيء -> { };
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(هوية_بدائي_مترجم.فشل_وقت_الترجمة(), 0)
            ));
        }
        | _ -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(هوية_بدائي_مترجم.فشل_وقت_الترجمة(), 0)
            ));
        };
    }
    ;
}
