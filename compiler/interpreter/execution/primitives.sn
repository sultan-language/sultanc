خارجي عرف تشغيل_فتح_ملف_للقراءة(الحجة_0: نص): عدد;
خارجي عرف تشغيل_قراءة_بايت_ملف(الحجة_0: عدد): عدد;
خارجي عرف تشغيل_قراءة_مقطع_ملف(
    الحجة_0: عدد,
    الحجة_1: متجه غ8,
    الحجة_2: عدد,
    الحجة_3: عدد
): عدد;
خارجي عرف تشغيل_إنشاء_ملف_للكتابة(الحجة_0: نص): عدد;
خارجي عرف تشغيل_كتابة_مقطع_ملف(
    الحجة_0: عدد,
    الحجة_1: متجه غ8,
    الحجة_2: عدد,
    الحجة_3: عدد
): عدد;
خارجي عرف تشغيل_إغلاق_ملف(الحجة_0: عدد): عدد;
خارجي عرف تشغيل_فتح_دليل(الحجة_0: نص): عدد;
خارجي عرف تشغيل_قراءة_مدخل_دليل(
    الحجة_0: عدد,
    الحجة_1: متجه غ8,
    الحجة_2: عدد,
    الحجة_3: عدد
): عدد;
خارجي عرف تشغيل_إغلاق_دليل(الحجة_0: عدد): عدد;
خارجي عرف تشغيل_قراءة_بايت_الدخل_القياسي(): عدد;
خارجي عرف تشغيل_قراءة_مقطع_الدخل_القياسي(
    الحجة_0: متجه غ8,
    الحجة_1: عدد,
    الحجة_2: عدد
): عدد;
خارجي عرف تشغيل_كتابة_الخرج_القياسي(الحجة_0: نص): عدد;
خارجي عرف تشغيل_كتابة_الخطأ_القياسي(الحجة_0: نص): عدد;
خارجي عرف تشغيل_كتابة_بايتات_تنفيذية(
    الحجة_0: نص,
    الحجة_1: متجه غ8
