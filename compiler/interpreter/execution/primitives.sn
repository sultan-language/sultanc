خارجي عرف تشغيل_نوع_مسار(الحجة_0: نص): عدد;
خارجي عرف تشغيل_حجم_مسار(الحجة_0: نص): عدد;
خارجي عرف تشغيل_وقت_تعديل_مسار(الحجة_0: نص): عدد;

عرف اقرأ_مقطع_ملف_للمفسر(
    الواصف: عدد,
    البايتات: &متغير متجه غ8,
    الإزاحة: عدد,
    المطلوب: عدد
): عدد {
    أرجع تشغيل_قراءة_مقطع_ملف(الواصف, *البايتات, الإزاحة, المطلوب);
}

عرف اقرأ_مدخل_دليل_للمفسر(
    المقبض: عدد,
    البايتات: &متغير متجه غ8,
    الإزاحة: عدد,
    المطلوب: عدد
): عدد {
    أرجع تشغيل_قراءة_مدخل_دليل(المقبض, *البايتات, الإزاحة, المطلوب);
}

عرف اقرأ_مقطع_الدخل_القياسي_للمفسر(
    البايتات: &متغير متجه غ8,
    الإزاحة: عدد,
    المطلوب: عدد
): عدد {
    أرجع تشغيل_قراءة_مقطع_الدخل_القياسي(*البايتات, الإزاحة, المطلوب);
}

// This is the single Interpreter-owned boundary from canonical primitive identity
// to semantic runtime behavior. It owns no source spellings and no platform ABI facts.
عام نوع نتيجة_تنفيذ_بدائي_مفسر =
    | عاد بنوع اختيار قيمة_تشغيل
    | أنهى_العملية بنوع غير_موقع
    | أخفق بنوع فشل_تفسير_مسير
;

عرف فشل_حجة_بدائي(
    الهوية: هوية_بدائي_مترجم,
    الفهرس: غير_موقع
): نتيجة_تنفيذ_بدائي_مفسر {
    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
        فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(الهوية, الفهرس)
        )
    );
}

عرف فشل_حجة_تصدير_تشغيل(): نتيجة_تنفيذ_بدائي_مفسر {
    // External call arity and types were verified by MSIR. A mismatched runtime
    // value here is therefore an interpreter invariant failure, not FFI typing.
    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
        فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة())
    );
}

عرف فشل_تصدير_تشغيل_غير_مدعوم(
    المعرف: معرف_دالة_خارجية_مسير,
    الهوية: هوية_تصدير_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    دع الاسم: متجه غ8 = اسم_تصدير_تشغيل_أساسي(الهوية);
    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
        فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.نداء_خارجي_غير_مدعوم(المعرف, الاسم)
        )
    );
}

// Error classification is target-neutral after normalizing the execution host's
// errno values into the std runtime class codes. Keep it inside the interpreter
// rather than introducing another host-service wrapper or external dependency.
عرف صنف_خطأ_نظام_للمفسر(الخام: غير_موقع): غير_موقع {
    دع الخطأ: عدد = الخام مثل عدد;
    دع الرمز: عدد;
    لو (الخطأ < 0) {
        الرمز := 0 - الخطأ;
    } وإلا {
        الرمز := الخطأ;
    };

    لو (الرمز == 0) { أرجع 0; };
    لو (الرمز == 2) { أرجع 1; };
    لو ((الرمز == 13) || (الرمز == 1)) { أرجع 2; };
    لو (الرمز == 17) { أرجع 3; };
    لو (الرمز == 22) { أرجع 4; };
    لو (الرمز == 21) { أرجع 6; };
    لو (الرمز == 20) { أرجع 7; };
    لو ((الرمز == 12) || (الرمز == 23) || (الرمز == 24) || (الرمز == 28)) {
        أرجع 8;
    };
    لو (الرمز == 4) { أرجع 9; };

    دع المنصة: عدد = رمز_منصة_المضيف_الحالية();
    لو (المنصة == رمز_منصة_مضيف(هوية_منصة_مضيف.داروين())) {
        لو (الرمز == 63) { أرجع 4; };
        لو ((الرمز == 45) || (الرمز == 78)) { أرجع 5; };
    } وإلا {
        لو (المنصة == رمز_منصة_مضيف(هوية_منصة_مضيف.لينكس())) {
            لو (الرمز == 36) { أرجع 4; };
            لو ((الرمز == 95) || (الرمز == 38)) { أرجع 5; };
        };
    };

    أرجع 10;
}

عرف حدّث_مكان_من_إطار_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: غير_موقع,
    المكان: &مكان_تشغيل,
    القيمة: قيمة_تشغيل
): اختيار فشل_تفسير_مسير {
    لو (موضع_الإطار >= (*الحالة).عمق_المكدس) {
        أرجع اختيار.بعض(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    طابق اكتب_مكان_مفسر(
        &متغير (*الحالة).المكدس,
        (*الحالة).عمق_المكدس,
        &متغير (*الحالة).الذاكرة,
        المكان,
        القيمة
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف حرر_صندوق_بقيمة_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المعرف: معرف_صندوق_مفسر
): اختيار فشل_تفسير_مسير {
    دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [];
    دع الجذر: جذر_مكان_تشغيل = جذر_مكان_تشغيل.صندوق(المعرف);
    دع المكان: مكان_تشغيل = {
        الجذر: الجذر,
        الإسقاطات: الإسقاطات,
        قابل_للكتابة: صواب
    };
    طابق حرر_مكان_مفسر(
        &متغير (*الحالة).المكدس,
        (*الحالة).عمق_المكدس,
        &متغير (*الحالة).الذاكرة,
        &المكان
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف حرر_تخزين_قيمة_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    القيمة: &قيمة_تشغيل
): اختيار فشل_تفسير_مسير {
    طابق *القيمة مع
    | قيمة_تشغيل.صندوق(الصندوق) -> {
        أرجع حرر_صندوق_بقيمة_بدائي(الحالة, الصندوق);
    }
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأعضاء) مثل غير_موقع)) {
            طابق حرر_تخزين_قيمة_بدائي(الحالة, &الأعضاء[ف]) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختيار.لا_شيء();
    }
    | قيمة_تشغيل.موسوم(الموسوم) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الموسوم.الحمولات) مثل غير_موقع)) {
            طابق حرر_تخزين_قيمة_بدائي(الحالة, &الموسوم.الحمولات[ف]) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختيار.لا_شيء();
    }
    | _ -> {
        // Text/vector aggregate storage is carried by the semantic value itself.
        // Invalidating its owning root/slot below is the Interpreter release action.
        أرجع اختيار.لا_شيء();
    };
}

عرف حرر_حجة_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: غير_موقع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    القيمة: &قيمة_تشغيل
): اختيار فشل_تفسير_مسير {
    لو (موضع_الإطار >= (*الحالة).عمق_المكدس) {
        أرجع اختيار.بعض(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    طابق حرر_تخزين_قيمة_بدائي(الحالة, القيمة) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | اختيار.لا_شيء -> { };

    // Resolve load provenance through the Interpreter's lazy per-function index.
    // This preserves the existing release semantics without rescanning the function body.
    طابق مصدر_تحميل_قيمة_مفسر(الحالة, المسير, المعرف) مع
    | اختيار.بعض(معرف_المكان) -> {
        طابق اقرأ_مكان_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], معرف_المكان) مع
        | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
            طابق حرر_مكان_مفسر(
                &متغير (*الحالة).المكدس,
                (*الحالة).عمق_المكدس,
                &متغير (*الحالة).الذاكرة,
                &المكان
            ) مع
            | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { };
        };
    }
    | اختيار.لا_شيء -> { };

    طابق أبطل_قيمة_خانة_مسير(&متغير (*الحالة).المكدس[موضع_الإطار], المعرف) مع
    | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_كتابة_خانة.نجحت -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف ابن_قيمة_نتيجة_تصدير_تشغيل(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    الوجهة: اختيار معرف_قيمة_مسير,
    هل_نجح: منطقي,
    الحمولة: قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    دع معرف_الوجهة: معرف_قيمة_مسير;
    طابق الوجهة مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
        );
    }
    | اختيار.بعض(المعرف) -> {
        معرف_الوجهة := المعرف;
    };

    دع نوع_النتيجة: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, معرف_الوجهة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.قيمة_مسير_مفقودة(معرف_الوجهة)
            )
        );
    }
    | اختيار.بعض(المعرف) -> {
        نوع_النتيجة := المعرف;
    };

    دع هوية_المنشئ: هوية_منشئ_نوع;
    لو (هل_نجح) {
        هوية_المنشئ := هوية_منشئ_نوع.نتيجة_نجاح();
    } وإلا {
        هوية_المنشئ := هوية_منشئ_نوع.نتيجة_خطأ();
    };
    دع الترتيب: غير_موقع;
    طابق ترتيب_منشئ_نوع_دلالي_بالهوية(الأنواع, نوع_النتيجة, هوية_المنشئ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.نوع_فهرسة_غير_متسق(معرف_الوجهة)
            )
        );
    }
    | اختيار.بعض(القيمة) -> {
        الترتيب := القيمة;
    };
    دع الحمولات: متجه قيمة_تشغيل = [الحمولة];
    دع الموسوم: قيمة_موسومة_تشغيل = {
        المنشئ: الترتيب,
        الحمولات: الحمولات
    };
    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(قيمة_تشغيل.موسوم(الموسوم)));
}

عرف نفذ_نص_من_بايتات_تصدير_تشغيل(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرف_الحجة: معرف_قيمة_مسير,
    الحجة: &قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    دع نوع_الحجة: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, معرف_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.قيمة_مسير_مفقودة(معرف_الحجة)
            )
        );
    }
    | اختيار.بعض(المعرف) -> {
        نوع_الحجة := المعرف;
    };

    دع نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع فشل_حجة_تصدير_تشغيل();
    }
    | اختيار.بعض(المعرف) -> {
        نوع_العنصر := المعرف;
    };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_العنصر) مع
    | اختيار.لا_شيء -> {
        أرجع فشل_حجة_تصدير_تشغيل();
    }
    | اختيار.بعض(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.غ8 -> { }
            | _ -> {
                أرجع فشل_حجة_تصدير_تشغيل();
            };
        }
        | _ -> {
            أرجع فشل_حجة_تصدير_تشغيل();
        };
    };

    طابق *الحجة مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        دع البايتات: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأعضاء) مثل غير_موقع)) {
            طابق الأعضاء[ف] مع
            | قيمة_تشغيل.بتات_عدد(الخام) -> {
                // Canonical u8 values occupy exactly eight semantic bits. Reject an
                // inconsistent runtime payload rather than truncating it silently.
                لو (الخام > 255) {
                    أرجع فشل_حجة_تصدير_تشغيل();
                };
                ألحق(البايتات, الخام مثل غ8);
            }
            | _ -> {
                أرجع فشل_حجة_تصدير_تشغيل();
            };
            ف := ف + 1;
        }
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختيار.بعض(قيمة_تشغيل.نص(البايتات))
        );
    }
    | _ -> {
        أرجع فشل_حجة_تصدير_تشغيل();
    };
}

عرف نفذ_طول_بدائي(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرف_الحجة: معرف_قيمة_مسير,
    الحجة: &قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    دع نوع_الحجة: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, معرف_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.قيمة_مسير_مفقودة(معرف_الحجة)
            )
        );
    }
    | اختيار.بعض(المعرف) -> {
        نوع_الحجة := المعرف;
    };
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
    }
    | اختيار.بعض(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.نص -> {
                طابق *الحجة مع
                | قيمة_تشغيل.نص(البايتات) -> {
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                        اختيار.بعض(
                            قيمة_تشغيل.بتات_عدد(الطول(البايتات) مثل غير_موقع)
                        )
                    );
                }
                | _ -> {
                    أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
                };
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
            };
        }
        | صنف_شكل_نوع_دلالي.متجه -> {
            طابق *الحجة مع
            | قيمة_تشغيل.تجميع(الأعضاء) -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                    اختيار.بعض(قيمة_تشغيل.بتات_عدد(الطول(الأعضاء) مثل غير_موقع))
                );
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
            };
        }
        | صنف_شكل_نوع_دلالي.شريحة -> {
            طابق *الحجة مع
            | قيمة_تشغيل.تجميع(الأعضاء) -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                    اختيار.بعض(قيمة_تشغيل.بتات_عدد(الطول(الأعضاء) مثل غير_موقع))
                );
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
            };
        }
        | _ -> {
            أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
        };
    };
}

عرف استخرج_بايتات_قيمة_مفسر(
    القيمة: &قيمة_تشغيل
): اختيار متجه غ8 {
    طابق *القيمة مع
    | قيمة_تشغيل.تجميع(العناصر) -> {
        دع البايتات: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
            طابق العناصر[ف] مع
            | قيمة_تشغيل.بتات_عدد(الخام) -> {
                لو (الخام > 255) { أرجع اختيار.لا_شيء(); };
                ألحق(البايتات, الخام مثل غ8);
            }
            | _ -> { أرجع اختيار.لا_شيء(); };
            ف := ف + 1;
        }
        أرجع اختيار.بعض(البايتات);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف استخرج_عدد_قيمة_مفسر(القيمة: &قيمة_تشغيل): اختيار عدد {
    طابق *القيمة مع
    | قيمة_تشغيل.بتات_عدد(الخام) -> { أرجع اختيار.بعض(الخام مثل عدد); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}


عرف نفذ_كتابة_بايتات_تصدير_تشغيل_مفسر(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    الوجهة: اختيار معرف_قيمة_مسير
): نتيجة_تنفيذ_بدائي_مفسر {
    دع المعرفات: متجه معرف_قيمة_مسير = *معرفات_الحجج;
    دع قيم_الحجج: متجه قيمة_تشغيل = *الحجج;
        دع نوع_المحتوى: معرف_نوع;
        طابق نوع_قيمة_مسير(المسير, المعرفات[1]) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.قيمة_مسير_مفقودة(المعرفات[1])
                )
            );
        }
        | اختيار.بعض(المعرف) -> {
            نوع_المحتوى := المعرف;
        };

        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_المحتوى) مع
        | اختيار.لا_شيء -> {
            أرجع فشل_حجة_تصدير_تشغيل();
        }
        | اختيار.بعض(المعرف) -> {
            نوع_العنصر := المعرف;
        };
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_العنصر) مع
        | اختيار.لا_شيء -> {
            أرجع فشل_حجة_تصدير_تشغيل();
        }
        | اختيار.بعض(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                طابق البدائي مع
                | نوع_بدائي_مقنن.غ8 -> { }
                | _ -> {
                    أرجع فشل_حجة_تصدير_تشغيل();
                };
            }
            | _ -> {
                أرجع فشل_حجة_تصدير_تشغيل();
            };
        };

        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.نص(بايتات_المسار) -> {
            طابق قيم_الحجج[1] مع
            | قيمة_تشغيل.تجميع(العناصر) -> {
                دع البايتات: متغير متجه غ8 = [];
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
                    طابق العناصر[ف] مع
                    | قيمة_تشغيل.بتات_عدد(الخام) -> {
                        لو (الخام > 255) {
                            أرجع فشل_حجة_تصدير_تشغيل();
                        };
                        ألحق(البايتات, الخام مثل غ8);
                    }
                    | _ -> {
                        أرجع فشل_حجة_تصدير_تشغيل();
                    };
                    ف := ف + 1;
                }
                دع مسار_المضيف: نص = من_بايتات(&بايتات_المسار);
                دع نتيجة_الكتابة: نتيجة عدد, عدد =
                    تشغيل_كتابة_بايتات_تنفيذية(مسار_المضيف, البايتات);
                طابق نتيجة_الكتابة مع
                | نتيجة.نجح(العدد) -> {
                    أرجع ابن_قيمة_نتيجة_تصدير_تشغيل(
                        الأنواع,
                        المسير,
                        الوجهة,
                        صواب,
                        قيمة_تشغيل.بتات_عدد(العدد مثل غير_موقع)
                    );
                }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع ابن_قيمة_نتيجة_تصدير_تشغيل(
                        الأنواع,
                        المسير,
                        الوجهة,
                        خطأ,
                        قيمة_تشغيل.بتات_عدد(الخطأ مثل غير_موقع)
                    );
                };
            }
            | _ -> {
                أرجع فشل_حجة_تصدير_تشغيل();
            };
        }
        | _ -> {
            أرجع فشل_حجة_تصدير_تشغيل();
        };
 }


عرف حدّث_متجه_بايتات_تصدير_تشغيل_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: غير_موقع,
    المسير: &سياق_مستهلك_مسير,
    معرف_الحجة: معرف_قيمة_مسير,
    البايتات: &متجه غ8
): اختيار فشل_تفسير_مسير {
    // Native runtime exports receive the vector descriptor by value while its
    // backing bytes remain aliased. Interpreter aggregates are semantic values,
    // so reproduce only that backing-store write-through via load provenance.
    طابق مصدر_تحميل_قيمة_مفسر(الحالة, المسير, معرف_الحجة) مع
    | اختيار.لا_شيء -> {
        // A temporary value has no observable place to update.
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(معرف_المكان) -> {
        دع العناصر: متغير متجه قيمة_تشغيل = [];
        دع نسخة_البايتات: متجه غ8 = *البايتات;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(نسخة_البايتات) مثل غير_موقع)) {
            ألحق(العناصر, قيمة_تشغيل.بتات_عدد(نسخة_البايتات[ف] مثل غير_موقع));
            ف := ف + 1;
        }
        دع الجديدة: قيمة_تشغيل = قيمة_تشغيل.تجميع(العناصر);
        طابق اقرأ_مكان_خانة_مسير(
            &(*الحالة).المكدس[موضع_الإطار], معرف_المكان
        ) مع
        | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
            أرجع حدّث_مكان_من_إطار_بدائي(
                الحالة, موضع_الإطار, &المكان, الجديدة
            );
        };
    };
}

عام عرف نفذ_بدائي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: غير_موقع,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    الهوية: هوية_بدائي_مترجم,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    الوجهة: اختيار معرف_قيمة_مسير,
    مكان_التعديل: اختيار معرف_قيمة_مسير
): نتيجة_تنفيذ_بدائي_مفسر {
    دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(الهوية);
    دع قيم_الحجج: متجه قيمة_تشغيل = *الحجج;
    دع المعرفات: متجه معرف_قيمة_مسير = *معرفات_الحجج;
    دع العدد: غير_موقع = الطول(قيم_الحجج) مثل غير_موقع;
    لو (العدد != العقد.عدد_الحجج) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.عدد_حجج_بدائي_غير_متسق(
                    الهوية,
                    العقد.عدد_الحجج,
                    العدد
                )
            )
        );
    };

    طابق العقد.فئة_الناتج مع
    | فئة_ناتج_بدائي.بلا_قيمة -> {
        طابق الوجهة مع
        | اختيار.بعض(_) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
                )
            );
        }
        | اختيار.لا_شيء -> { };
    }
    | _ -> {
        طابق الوجهة مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
            );
        }
        | اختيار.بعض(_) -> { };
    };

    طابق الهوية مع
    | هوية_بدائي_مترجم.طول -> {
        أرجع نفذ_طول_بدائي(الأنواع, المسير, المعرفات[0], &قيم_الحجج[0]);
    }
    | هوية_بدائي_مترجم.بتات_ع64 -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.بتات_ع32 -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.تبديل_موضعين -> {
        // This intrinsic must be eliminated by MSIR lowering before interpretation.
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة())
        );
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        دع نوع_المتجه: معرف_نوع;
        طابق نوع_قيمة_مسير(المسير, المعرفات[0]) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.قيمة_مسير_مفقودة(المعرفات[0])
                )
            );
        }
        | اختيار.بعض(المعرف) -> {
            نوع_المتجه := المعرف;
        };
        طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_المتجه) مع
        | اختيار.لا_شيء -> {
            أرجع فشل_حجة_بدائي(الهوية, 0);
        }
        | اختيار.بعض(_) -> { };
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.تجميع(الأعضاء) -> {
            دع المحدثة: متغير متجه قيمة_تشغيل = الأعضاء;
            دع المنقول: قيمة_تشغيل = انسخ_قيمة_تشغيل(&قيم_الحجج[1]);
            ألحق(المحدثة, المنقول);
            دع الجديدة: قيمة_تشغيل = قيمة_تشغيل.تجميع(المحدثة);
            طابق مكان_التعديل مع
            | اختيار.لا_شيء -> {
                أرجع فشل_حجة_بدائي(الهوية, 0);
            }
            | اختيار.بعض(معرف_المكان) -> {
                طابق اقرأ_مكان_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], معرف_المكان) مع
                | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
                }
                | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
                    طابق حدّث_مكان_من_إطار_بدائي(الحالة, موضع_الإطار, &المكان, الجديدة) مع
                    | اختيار.بعض(الخطأ) -> {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
                    }
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.لا_شيء());
                    };
                };
            };
        }
        | _ -> {
            أرجع فشل_حجة_بدائي(الهوية, 0);
        };
    }
    | هوية_بدائي_مترجم.تحرير -> {
        طابق حرر_حجة_بدائي(
            الحالة,
            موضع_الإطار,
            المسير,
            المعرفات[0],
            &قيم_الحجج[0]
        ) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.لا_شيء());
        };
    }
    | هوية_بدائي_مترجم.معمارية_المضيف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختيار.بعض(قيمة_تشغيل.بتات_عدد(رمز_معمارية_المضيف_الحالية() مثل غير_موقع))
        );
    }
    | هوية_بدائي_مترجم.منصة_المضيف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختيار.بعض(قيمة_تشغيل.بتات_عدد(رمز_منصة_المضيف_الحالية() مثل غير_موقع))
        );
    }
    | هوية_بدائي_مترجم.بيئة_المضيف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
