            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.عدد_منشئات_النوع())
        ));
    }
    | هوية_بدائي_مترجم.فشل_وقت_الترجمة -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.نص(الرسالة) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_فشل_مطلوب(الرسالة)
