        );
    }
    // Reflection facts are folded by the driver before any execution
    // (driver/compile_time.sn); reaching one here is not a valid program.
    | هوية_بدائي_مترجم.حجم_النوع -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.حجم_النوع())
        ));
    }
    | هوية_بدائي_مترجم.محاذاة_النوع -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.محاذاة_النوع())
