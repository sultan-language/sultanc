// This is the single Interpreter-owned boundary from canonical primitive identity
// to semantic runtime behavior. It owns no source spellings and no platform ABI facts.
عام نوع نتيجة_تنفيذ_بدائي_مفسر =
    | عاد بنوع اختيار قيمة_تشغيل
    | أنهى_العملية بنوع غير_موقع
    | أخفق بنوع فشل_تفسير_مسير
;

عرف فشل_حجة_بدائي(
    الهوية: هوية_بدائي_مترجم,
    الفهرس: غير_موقع
): نتيجة_تنفيذ_بدائي_مفسر {
    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
        فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(الهوية, الفهرس)
        )
    );
}

عرف حدّث_مكان_من_إطار_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: غير_موقع,
    المكان: &مكان_تشغيل,
    القيمة: قيمة_تشغيل
): اختيار فشل_تفسير_مسير {
    لو (موضع_الإطار >= (*الحالة).عمق_المكدس) {
        أرجع اختيار.بعض(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    طابق اكتب_مكان_مفسر(
        &متغير (*الحالة).المكدس,
        (*الحالة).عمق_المكدس,
        &متغير (*الحالة).الذاكرة,
        المكان,
        القيمة
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف حرر_صندوق_بقيمة_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المعرف: معرف_صندوق_مفسر
): اختيار فشل_تفسير_مسير {
    دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [];
    دع الجذر: جذر_مكان_تشغيل = جذر_مكان_تشغيل.صندوق(المعرف);
    دع المكان: مكان_تشغيل = {
        الجذر: الجذر,
        الإسقاطات: الإسقاطات,
        قابل_للكتابة: صواب
    };
    طابق حرر_مكان_مفسر(
        &متغير (*الحالة).المكدس,
        (*الحالة).عمق_المكدس,
        &متغير (*الحالة).الذاكرة,
        &المكان
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف حرر_تخزين_قيمة_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    القيمة: &قيمة_تشغيل
): اختيار فشل_تفسير_مسير {
    طابق *القيمة مع
    | قيمة_تشغيل.صندوق(الصندوق) -> {
        أرجع حرر_صندوق_بقيمة_بدائي(الحالة, الصندوق);
    }
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأعضاء) مثل غير_موقع)) {
            طابق حرر_تخزين_قيمة_بدائي(الحالة, &الأعضاء[ف]) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختيار.لا_شيء();
    }
    | قيمة_تشغيل.موسوم(الموسوم) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الموسوم.الحمولات) مثل غير_موقع)) {
            طابق حرر_تخزين_قيمة_بدائي(الحالة, &الموسوم.الحمولات[ف]) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختيار.لا_شيء();
    }
    | _ -> {
        // Text/vector aggregate storage is carried by the semantic value itself.
        // Invalidating its owning root/slot below is the Interpreter release action.
        أرجع اختيار.لا_شيء();
    };
}

عرف حرر_حجة_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: غير_موقع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    القيمة: &قيمة_تشغيل
): اختيار فشل_تفسير_مسير {
    لو (موضع_الإطار >= (*الحالة).عمق_المكدس) {
        أرجع اختيار.بعض(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    طابق حرر_تخزين_قيمة_بدائي(الحالة, القيمة) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | اختيار.لا_شيء -> { };

    // Resolve load provenance through the Interpreter's lazy per-function index.
    // This preserves the existing release semantics without rescanning the function body.
    طابق مصدر_تحميل_قيمة_مفسر(الحالة, المسير, المعرف) مع
    | اختيار.بعض(معرف_المكان) -> {
        طابق اقرأ_مكان_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], معرف_المكان) مع
        | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
            طابق حرر_مكان_مفسر(
                &متغير (*الحالة).المكدس,
                (*الحالة).عمق_المكدس,
                &متغير (*الحالة).الذاكرة,
                &المكان
            ) مع
            | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { };
        };
    }
    | اختيار.لا_شيء -> { };

    طابق أبطل_قيمة_خانة_مسير(&متغير (*الحالة).المكدس[موضع_الإطار], المعرف) مع
    | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_كتابة_خانة.نجحت -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف نفذ_طول_بدائي(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرف_الحجة: معرف_قيمة_مسير,
    الحجة: &قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    دع نوع_الحجة: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, معرف_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.قيمة_مسير_مفقودة(معرف_الحجة)
            )
        );
    }
    | اختيار.بعض(المعرف) -> {
        نوع_الحجة := المعرف;
    };
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
    }
    | اختيار.بعض(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.نص -> {
                طابق *الحجة مع
                | قيمة_تشغيل.نص(البايتات) -> {
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                        اختيار.بعض(
                            قيمة_تشغيل.بتات_عدد(الطول(البايتات) مثل غير_موقع)
                        )
                    );
                }
                | _ -> {
                    أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
                };
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
            };
        }
        | صنف_شكل_نوع_دلالي.متجه -> {
            طابق *الحجة مع
            | قيمة_تشغيل.تجميع(الأعضاء) -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                    اختيار.بعض(قيمة_تشغيل.بتات_عدد(الطول(الأعضاء) مثل غير_موقع))
                );
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
            };
        }
        | صنف_شكل_نوع_دلالي.شريحة -> {
            طابق *الحجة مع
            | قيمة_تشغيل.تجميع(الأعضاء) -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                    اختيار.بعض(قيمة_تشغيل.بتات_عدد(الطول(الأعضاء) مثل غير_موقع))
                );
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
            };
        }
        | _ -> {
            أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
        };
    };
}

// This is a runtime check of the verified Frontend-origin witness, not a
// second syscall registry. The MSIR verifier already proves the selector's
// constructor/SSA origin; the Interpreter additionally refuses a missing,
// duplicate, or inconsistent attestation and classifies EVERY machine slot.
عرف وثق_توقيع_نداء_نواة_مفسر(
    الإطار: &إطار_تفسير_مسير,
    المسير: &سياق_مستهلك_مسير,
    العقد: &اختيار عقد_نواة_مسير,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    النطاقات: &متجه نطاق_ذاكرة_نداء_مسير
): اختيار توقيع_نداء_بدائي {
    دع الشاهد: عقد_نواة_مسير;
    طابق *العقد مع
    | اختيار.بعض(القيمة) -> { الشاهد := القيمة; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    لو (الطول(*معرفات_الحجج) != 7 || الطول(*الحجج) != 7
        || !قيمتا_مسير_متساويتان(الشاهد.الرقم, (*معرفات_الحجج)[0])) {
        أرجع اختيار.لا_شيء();
    };
    طابق (*الحجج)[0] مع
    | قيمة_تشغيل.بتات_عدد(_) -> { }
    | _ -> { أرجع اختيار.لا_شيء(); };

    دع التوقيع: متغير اختيار توقيع_نداء_بدائي = اختيار.لا_شيء();
    دع المطابقات: متغير غير_موقع = 0;
    دع فهرس_المصدر: متغير غير_موقع = 0;
    بينما (فهرس_المصدر < (الطول((*المسير).المسير.أصول_النواة) مثل غير_موقع)) {
        دع الأصل: &مصدر_عقد_نواة_مسير = &(*المسير).المسير.أصول_النواة[فهرس_المصدر];
        لو (معرفا_رمز_متساويان((*الأصل).المنشئ, الشاهد.المنشئ)
            && (*الأصل).الترتيب == الشاهد.الترتيب
            && (*الأصل).المنتقي.القيمة == الشاهد.المنتقي.القيمة) {
            المطابقات := المطابقات + 1;
            // Copy the authenticated signature; the canonical MSIR owner keeps
            // its own record (no owned field is moved out of a borrow).
            دع الأدوار_المنسوخة: متغير متجه دور_وسيطة_بدائي = [];
            دع فهرس_الدور: متغير غير_موقع = 0;
            بينما (فهرس_الدور < (الطول((*الأصل).التوقيع.الأدوار) مثل غير_موقع)) {
                ألحق(الأدوار_المنسوخة, (*الأصل).التوقيع.الأدوار[فهرس_الدور]);
                فهرس_الدور := فهرس_الدور + 1;
            }
            دع التوقيع_المنسوخ: توقيع_نداء_بدائي = {
                الأدوار: الأدوار_المنسوخة, النسخ: (*الأصل).التوقيع.النسخ
            };
            التوقيع := اختيار.بعض(التوقيع_المنسوخ);
        };
        فهرس_المصدر := فهرس_المصدر + 1;
    }
    لو (المطابقات != 1) { أرجع اختيار.لا_شيء(); };
    دع الموثق: توقيع_نداء_بدائي;
    طابق التوقيع مع
    | اختيار.بعض(القيمة) -> { الموثق := القيمة; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    لو (الطول(الموثق.الأدوار) != 6) { أرجع اختيار.لا_شيء(); };

    دع الموضع: متغير غير_موقع = 1;
    بينما (الموضع <= 6) {
        دع عدد_النطاقات: متغير غير_موقع = 0;
        دع موضع_النطاق: متغير غير_موقع = 0;
        دع الوصف: متغير اختيار نطاق_ذاكرة_نداء_مسير = اختيار.لا_شيء();
        بينما (موضع_النطاق < (الطول(*النطاقات) مثل غير_موقع)) {
            لو ((*النطاقات)[موضع_النطاق].فهرس_الحجة == الموضع) {
                عدد_النطاقات := عدد_النطاقات + 1;
                الوصف := اختيار.بعض((*النطاقات)[موضع_النطاق]);
            };
            موضع_النطاق := موضع_النطاق + 1;
        }
        طابق الموثق.الأدوار[الموضع - 1] مع
        | دور_وسيطة_بدائي.عدد -> {
            لو (عدد_النطاقات != 0) { أرجع اختيار.لا_شيء(); };
            طابق (*الحجج)[الموضع] مع
            | قيمة_تشغيل.بتات_عدد(_) -> { }
            | _ -> { أرجع اختيار.لا_شيء(); };
        }
        | دور_وسيطة_بدائي.غير_مستخدم -> {
            لو (عدد_النطاقات != 0) { أرجع اختيار.لا_شيء(); };
            طابق (*الحجج)[الموضع] مع
            | قيمة_تشغيل.بتات_عدد(القيمة) -> {
                لو (القيمة != 0) { أرجع اختيار.لا_شيء(); };
            }
            | _ -> { أرجع اختيار.لا_شيء(); };
        }
        | دور_وسيطة_بدائي.مخزن(الاتجاه, الحد) -> {
            لو (عدد_النطاقات != 1) { أرجع اختيار.لا_شيء(); };
            دع النطاق: نطاق_ذاكرة_نداء_مسير;
            طابق الوصف مع
            | اختيار.بعض(القيمة) -> { النطاق := القيمة; }
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
            طابق (*الحجج)[الموضع] مع
            | قيمة_تشغيل.مرجع(_) -> { }
            | _ -> { أرجع اختيار.لا_شيء(); };
            لو (!قيمتا_مسير_متساويتان(
                النطاق.المؤشر, (*معرفات_الحجج)[الموضع]
            )) { أرجع اختيار.لا_شيء(); };
            دع الإذن: إذن_ذاكرة_نداء_مسير;
            طابق الاتجاه مع
            | اتجاه_وصول_بدائي.قراءة -> { الإذن := إذن_ذاكرة_نداء_مسير.قراءة(); }
            | اتجاه_وصول_بدائي.كتابة -> { الإذن := إذن_ذاكرة_نداء_مسير.كتابة(); }
            | اتجاه_وصول_بدائي.قراءة_وكتابة -> { الإذن := إذن_ذاكرة_نداء_مسير.قراءة_وكتابة(); };
            لو (النطاق.الإذن != الإذن) { أرجع اختيار.لا_شيء(); };
            طابق النطاق.المطلوب مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(المعرف) -> {
                طابق الحد مع
                | حد_وصول_بدائي.وسيطة(الفهرس) -> {
                    لو (الفهرس == 0 || الفهرس > 6
                        || !قيمتا_مسير_متساويتان(
                            المعرف, (*معرفات_الحجج)[الفهرس]
                        )) { أرجع اختيار.لا_شيء(); };
                    طابق (*الحجج)[الفهرس] مع
                    | قيمة_تشغيل.بتات_عدد(_) -> { }
                    | _ -> { أرجع اختيار.لا_شيء(); };
                }
                | حد_وصول_بدائي.سلسلة_صفرية -> {
                    لو (!قيمتا_مسير_متساويتان(المعرف, النطاق.الطول)) {
                        أرجع اختيار.لا_شيء();
                    };
                }
                | حد_وصول_بدائي.ثابت(الثابت) -> {
                    طابق اقرأ_طول_نطاق_نداء_نواة_مفسر(الإطار, المعرف) مع
                    | اختيار.بعض(العدد) -> {
                        لو (العدد != الثابت) { أرجع اختيار.لا_شيء(); };
                    }
                    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
                };
            };
        };
        الموضع := الموضع + 1;
    }
    // No descriptor may refer to the operation number or an eighth operand.
    دع فهرس_النطاق: متغير غير_موقع = 0;
    بينما (فهرس_النطاق < (الطول(*النطاقات) مثل غير_موقع)) {
        لو ((*النطاقات)[فهرس_النطاق].فهرس_الحجة == 0
            || (*النطاقات)[فهرس_النطاق].فهرس_الحجة > 6) {
            أرجع اختيار.لا_شيء();
        };
        فهرس_النطاق := فهرس_النطاق + 1;
    }
    أرجع اختيار.بعض(الموثق);
}

// These are scoped, owned byte vectors, not host allocations, pinned addresses
// or a second Interpreter memory registry. They are discarded on every return
// path, including overlap/validation failures and the fail-closed rejection.
// The requested extent is relative to the reference's indexed position.
نوع نطاق_مهيأ_لنداء_نواة_مفسر = {
    فهرس_الحجة: غير_موقع,
    معرف_المؤشر: معرف_قيمة_مسير,
    المؤشر: قيمة_تشغيل,
    المطلوب: غير_موقع,
    الإذن: إذن_ذاكرة_نداء_مسير,
    هوية_التخزين: نطاق_تخزين_بايتات_مفسر,
    البايتات: متجه غ8
};

نوع نتيجة_تحضير_نداء_نواة_مفسر =
    | مهيأ بنوع متجه نطاق_مهيأ_لنداء_نواة_مفسر
    | أخفق بنوع فشل_تفسير_مسير
;

عرف فشل_ذاكرة_نداء_نواة_مفسر(الفهرس: غير_موقع): فشل_تفسير_مسير {
    أرجع فشل_تفسير_مسير.وقت_تشغيل(
        خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(
            هوية_بدائي_مترجم.نداء_نواة_خام(), الفهرس
        )
    );
}

// Runtime lengths are read from the same verified MSIR SSA values as the
// descriptor. No kernel argument is interpreted as a length by syscall number.
عرف اقرأ_طول_نطاق_نداء_نواة_مفسر(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار غير_موقع {
    طابق اقرأ_قيمة_خانة_مسير(الإطار, المعرف) مع
    | نتيجة_قراءة_قيمة_خانة.موجودة(قيمة_تشغيل.بتات_عدد(القيمة)) -> {
        أرجع اختيار.بعض(القيمة);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

// Validate all declared buffers before host-side effects, after the
// authenticated six-slot signature has classified every machine operand.
// A numeric word not classified by that signature is never a safe pointer.
عرف حضر_نطاقات_نداء_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: غير_موقع,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    النطاقات: &متجه نطاق_ذاكرة_نداء_مسير
): نتيجة_تحضير_نداء_نواة_مفسر {
    دع العدد: غير_موقع = الطول(*الحجج) مثل غير_موقع;
    دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(
        هوية_بدائي_مترجم.نداء_نواة_خام()
    );
    دع المتوقع: غير_موقع = العقد.عدد_الحجج;
    لو (موضع_الإطار >= (*الحالة).عمق_المكدس || العدد != المتوقع
        || (الطول(*معرفات_الحجج) مثل غير_موقع) != العدد) {
        أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(فشل_ذاكرة_نداء_نواة_مفسر(0));
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع فهرس_نطاق: متغير غير_موقع = 0;
    بينما (فهرس_نطاق < (الطول(*النطاقات) مثل غير_موقع)) {
        لو ((*النطاقات)[فهرس_نطاق].فهرس_الحجة >= العدد) {
            أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                فشل_ذاكرة_نداء_نواة_مفسر((*النطاقات)[فهرس_نطاق].فهرس_الحجة)
            );
        };
        فهرس_نطاق := فهرس_نطاق + 1;
    }
    دع المهيأة: متغير متجه نطاق_مهيأ_لنداء_نواة_مفسر = [];
    دع فهرس_الحجة: متغير غير_موقع = 0;
    بينما (فهرس_الحجة < العدد) {
        دع عدد_المطابقات: متغير غير_موقع = 0;
        دع فهرس_النطاق: متغير غير_موقع = 0;
        دع مؤشر_النطاق: متغير غير_موقع = 0;
        بينما (فهرس_النطاق < (الطول(*النطاقات) مثل غير_موقع)) {
            لو ((*النطاقات)[فهرس_النطاق].فهرس_الحجة == فهرس_الحجة) {
                عدد_المطابقات := عدد_المطابقات + 1;
                مؤشر_النطاق := فهرس_النطاق;
            };
            فهرس_النطاق := فهرس_النطاق + 1;
        }
        لو (عدد_المطابقات > 1 || (فهرس_الحجة == 0 && عدد_المطابقات != 0)) {
            أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
            );
        };
        طابق (*الحجج)[فهرس_الحجة] مع
        | قيمة_تشغيل.بتات_عدد(_) -> {
            // A scalar needs no memory translation. Unknown numeric pointer
            // roles remain an external contract blocker, not an implicit grant.
            لو (عدد_المطابقات != 0) {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
        }
        | قيمة_تشغيل.مرجع(المكان) -> {
            لو (عدد_المطابقات != 1 || فهرس_الحجة == 0) {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
            دع النطاق: نطاق_ذاكرة_نداء_مسير = (*النطاقات)[مؤشر_النطاق];
            لو (!قيمتا_مسير_متساويتان(
                النطاق.المؤشر, (*معرفات_الحجج)[فهرس_الحجة]
            )) {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
            طابق اقرأ_قيمة_خانة_مسير(الإطار, النطاق.الأصل) مع
            | نتيجة_قراءة_قيمة_خانة.موجودة(قيمة_تشغيل.مرجع(الأصل)) -> {
                لو (!مكانا_تشغيل_متطابقان(&المكان, &الأصل)) {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                };
            }
            | _ -> {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
            دع السعة: غير_موقع;
            طابق اقرأ_طول_نطاق_نداء_نواة_مفسر(الإطار, النطاق.الطول) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            }
            | اختيار.بعض(القيمة) -> { السعة := القيمة; };
            دع المطلوب: غير_موقع;
            طابق النطاق.المطلوب مع
            | اختيار.لا_شيء -> {
                // A capacity witness is not an OS-requested byte count.
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            }
            | اختيار.بعض(المعرف) -> {
                طابق اقرأ_طول_نطاق_نداء_نواة_مفسر(الإطار, المعرف) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                }
                | اختيار.بعض(القيمة) -> { المطلوب := القيمة; };
            };
            لو (المطلوب > السعة) {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            };
            طابق النطاق.الإذن مع
            | إذن_ذاكرة_نداء_مسير.قراءة -> { }
            | إذن_ذاكرة_نداء_مسير.كتابة -> {
                لو (!مؤشر_بايتات_مفسر_قابل_للكتابة(
                    &(*الحالة).المكدس, (*الحالة).عمق_المكدس,
                    &(*الحالة).الذاكرة, الأنواع, المسير,
                    النطاق.المؤشر, &(*الحجج)[فهرس_الحجة]
                )) {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                };
            }
            | إذن_ذاكرة_نداء_مسير.قراءة_وكتابة -> {
                لو (!مؤشر_بايتات_مفسر_قابل_للكتابة(
                    &(*الحالة).المكدس, (*الحالة).عمق_المكدس,
                    &(*الحالة).الذاكرة, الأنواع, المسير,
                    النطاق.المؤشر, &(*الحجج)[فهرس_الحجة]
                )) {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                };
            };
            // Resolve the live allocation and ALL bounds before staging any bytes.
            // Canonical identity detects aliases before host buffers are
            // allocated; independently staged overlapping spans are rejected.
            دع هوية_التخزين: نطاق_تخزين_بايتات_مفسر;
            طابق حل_هوية_نطاق_بايتات_مفسر(
                &(*الحالة).المكدس, (*الحالة).عمق_المكدس,
                &(*الحالة).الذاكرة, الأنواع, المسير,
                النطاق.المؤشر, &(*الحجج)[فهرس_الحجة], المطلوب
            ) مع
            | نتيجة_هوية_نطاق_بايتات_مفسر.غير_صالح -> {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                    فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                );
            }
            | نتيجة_هوية_نطاق_بايتات_مفسر.موجود(الهوية) -> {
                هوية_التخزين := الهوية;
            };
            دع فهرس_مهيأ: متغير غير_موقع = 0;
            بينما (فهرس_مهيأ < (الطول(المهيأة) مثل غير_موقع)) {
                لو (نطاقا_تخزين_بايتات_متداخلان(
                    &هوية_التخزين, &المهيأة[فهرس_مهيأ].هوية_التخزين
                )) {
                    أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                        فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
                    );
                };
                فهرس_مهيأ := فهرس_مهيأ + 1;
            }
            // Copy-in proves the ACTUAL live extent in the canonical memory
            // owner before host storage is made available. Even output spans
            // require this check: the declared SSA capacity is not enough.
            دع البايتات: متجه غ8;
            طابق انسخ_نطاق_بايتات_من_مؤشر_مسير_مفسر(
                &(*الحالة).المكدس, (*الحالة).عمق_المكدس,
                &(*الحالة).الذاكرة, الأنواع, المسير,
                النطاق.المؤشر, &(*الحجج)[فهرس_الحجة], 0, المطلوب
            ) مع
            | نتيجة_نسخ_بايتات_مفسر.أخفق(الخطأ) -> {
                أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(الخطأ);
            }
            | نتيجة_نسخ_بايتات_مفسر.بايتات(المنسوخة) -> {
                البايتات := المنسوخة;
            };
            دع المهيأ: نطاق_مهيأ_لنداء_نواة_مفسر = {
                فهرس_الحجة: فهرس_الحجة,
                معرف_المؤشر: النطاق.المؤشر,
                المؤشر: انسخ_قيمة_تشغيل(&(*الحجج)[فهرس_الحجة]),
                المطلوب: المطلوب,
                الإذن: النطاق.الإذن,
                هوية_التخزين: هوية_التخزين,
                البايتات: البايتات
            };
            ألحق(المهيأة, المهيأ);
        }
        | _ -> {
            أرجع نتيجة_تحضير_نداء_نواة_مفسر.أخفق(
                فشل_ذاكرة_نداء_نواة_مفسر(فهرس_الحجة)
            );
        };
        فهرس_الحجة := فهرس_الحجة + 1;
    }
    أرجع نتيجة_تحضير_نداء_نواة_مفسر.مهيأ(المهيأة);
}

// A verified transfer policy supplies the count for EACH writable buffer.
// Never infer it directly from the raw return word in this memory helper.
// This function never copies beyond the authenticated requested extent.
عرف انسخ_ناتج_نطاق_نداء_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    النطاق: &نطاق_مهيأ_لنداء_نواة_مفسر,
    المكتوب: غير_موقع
): اختيار فشل_تفسير_مسير {
    لو (المكتوب > (*النطاق).المطلوب
        || المكتوب > (الطول((*النطاق).البايتات) مثل غير_موقع)) {
        أرجع اختيار.بعض(فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة));
    };
    طابق (*النطاق).الإذن مع
    | إذن_ذاكرة_نداء_مسير.قراءة -> {
        لو (المكتوب != 0) {
            أرجع اختيار.بعض(فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة));
        };
        أرجع اختيار.لا_شيء();
    }
    | _ -> { };
    لو (المكتوب == 0) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < المكتوب) {
        ألحق(الناتج, (*النطاق).البايتات[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    طابق انسخ_نطاق_بايتات_إلى_مؤشر_مسير_مفسر(
        &متغير (*الحالة).المكدس, (*الحالة).عمق_المكدس,
        &متغير (*الحالة).الذاكرة, الأنواع, المسير,
        (*النطاق).معرف_المؤشر, &(*النطاق).المؤشر, 0, &الناتج
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { أرجع اختيار.لا_شيء(); }
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع اختيار.بعض(الخطأ); };
}

// A verified result policy supplies an explicit byte count per staged buffer.
// Validate the ENTIRE result before changing Interpreter memory: no copy-back
// without authorization, no oversized/ambiguous transfers or read-only writes.
عرف انسخ_نتائج_نداء_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    النطاقات: &متجه نطاق_مهيأ_لنداء_نواة_مفسر,
    المكتوبة: &متجه غير_موقع,
    يسمح_النسخ: منطقي
): اختيار فشل_تفسير_مسير {
    دع العدد: غير_موقع = الطول(*النطاقات) مثل غير_موقع;
    لو (العدد != (الطول(*المكتوبة) مثل غير_موقع)) {
        أرجع اختيار.بعض(فشل_ذاكرة_نداء_نواة_مفسر(0));
    };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < العدد) {
        دع النطاق: &نطاق_مهيأ_لنداء_نواة_مفسر = &(*النطاقات)[الفهرس];
        دع المكتوب: غير_موقع = (*المكتوبة)[الفهرس];
        لو (المكتوب > (*النطاق).المطلوب
            || المكتوب > (الطول((*النطاق).البايتات) مثل غير_موقع)
            || (!يسمح_النسخ && المكتوب != 0)) {
            أرجع اختيار.بعض(فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة));
        };
        طابق (*النطاق).الإذن مع
        | إذن_ذاكرة_نداء_مسير.قراءة -> {
            لو (المكتوب != 0) {
                أرجع اختيار.بعض(فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة));
            };
        }
        | _ -> { };
        الفهرس := الفهرس + 1;
    }
    لو (!يسمح_النسخ) { أرجع اختيار.لا_شيء(); };
    الفهرس := 0;
    بينما (الفهرس < العدد) {
        طابق انسخ_ناتج_نطاق_نداء_نواة_مفسر(
            الحالة, الأنواع, المسير, &(*النطاقات)[الفهرس], (*المكتوبة)[الفهرس]
        ) مع
        | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | اختيار.لا_شيء -> { };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

// Per-call transfer policy comes from the authenticated STD signature, not
// a syscall number or a guessed meaning of its numeric return word. The
// caller must supply the RAW Linux return word (negative errno on this ABI).
// This is deliberately separate from host dispatch: no libc errno conversion.
نوع نتيجة_أطوال_نواة_مفسر =
    | موثقة بنوع (متجه غير_موقع, منطقي)
    | مرفوضة
;

عرف احسب_أطوال_نسخ_نواة_مفسر(
    التوقيع: &توقيع_نداء_بدائي,
    النطاقات: &متجه نطاق_مهيأ_لنداء_نواة_مفسر,
    نتيجة_النواة: غير_موقع
): نتيجة_أطوال_نواة_مفسر {
    دع الحد_الأعلى: غير_موقع = ~((0 مثل غير_موقع));
    دع أخفقت: منطقي = نتيجة_النواة >= (الحد_الأعلى - 4094);
    دع مقاطعة: منطقي = نتيجة_النواة == (الحد_الأعلى - 3);
    دع عدد_الكتابة: متغير غير_موقع = 0;
    دع فهرس_الكاتب: متغير غير_موقع = 0;
    دع فهرس_النطاق: متغير غير_موقع = 0;
    بينما (فهرس_النطاق < (الطول(*النطاقات) مثل غير_موقع)) {
        طابق (*النطاقات)[فهرس_النطاق].الإذن مع
        | إذن_ذاكرة_نداء_مسير.قراءة -> { }
        | _ -> {
            عدد_الكتابة := عدد_الكتابة + 1;
            فهرس_الكاتب := فهرس_النطاق;
        };
        فهرس_النطاق := فهرس_النطاق + 1;
    }
    دع أطوال: متغير متجه غير_موقع = [];
    فهرس_النطاق := 0;
    بينما (فهرس_النطاق < (الطول(*النطاقات) مثل غير_موقع)) {
        دع المكتوب: متغير غير_موقع = 0;
        دع نطاق: &نطاق_مهيأ_لنداء_نواة_مفسر = &(*النطاقات)[فهرس_النطاق];
        طابق (*نطاق).الإذن مع
        | إذن_ذاكرة_نداء_مسير.قراءة -> { }
        | _ -> {
            طابق (*التوقيع).النسخ مع
            | نسخ_نتيجة_بدائي.بلا_نسخ -> { }
            | نسخ_نتيجة_بدائي.عدد_بايتات_النتيجة -> {
                // A return count cannot be unambiguously divided among two
                // writable buffers. Reject, including successful zero writes.
                لو (عدد_الكتابة != 1 || فهرس_الكاتب != فهرس_النطاق) {
                    أرجع نتيجة_أطوال_نواة_مفسر.مرفوضة();
                };
                لو (!أخفقت) { المكتوب := نتيجة_النواة; };
            }
            | نسخ_نتيجة_بدائي.كامل_عند_النجاح -> {
                لو (!أخفقت) { المكتوب := (*نطاق).المطلوب; };
            }
            | نسخ_نتيجة_بدائي.كامل_عند_المقاطعة -> {
                لو (مقاطعة) { المكتوب := (*نطاق).المطلوب; };
            };
        };
        لو (المكتوب > (*نطاق).المطلوب
            || المكتوب > (الطول((*نطاق).البايتات) مثل غير_موقع)) {
            أرجع نتيجة_أطوال_نواة_مفسر.مرفوضة();
        };
        ألحق(أطوال, المكتوب);
        فهرس_النطاق := فهرس_النطاق + 1;
    }
    // An interrupted Linux operation may report a writable remainder even
    // though its return word is -EINTR. The policy is explicit for that case.
    دع يسمح_النسخ: منطقي = !أخفقت || (
        مقاطعة && (*التوقيع).النسخ == نسخ_نتيجة_بدائي.كامل_عند_المقاطعة()
    );
    أرجع نتيجة_أطوال_نواة_مفسر.موثقة(أطوال, يسمح_النسخ);
}

// This is the single result-sensitive entry into the pre-existing canonical
// memory copy-back helper. No host-result interpretation is duplicated in
// the memory layer, and an invalid policy cannot partially modify storage.
عرف طبق_نسخ_نتيجة_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التوقيع: &توقيع_نداء_بدائي,
    النطاقات: &متجه نطاق_مهيأ_لنداء_نواة_مفسر,
    نتيجة_النواة: غير_موقع
): اختيار فشل_تفسير_مسير {
    طابق احسب_أطوال_نسخ_نواة_مفسر(التوقيع, النطاقات, نتيجة_النواة) مع
    | نتيجة_أطوال_نواة_مفسر.مرفوضة -> {
        أرجع اختيار.بعض(فشل_ذاكرة_نداء_نواة_مفسر(0));
    }
    | نتيجة_أطوال_نواة_مفسر.موثقة(الأطوال, يسمح_النسخ) -> {
        أرجع انسخ_نتائج_نداء_نواة_مفسر(
            الحالة, الأنواع, المسير, النطاقات, &الأطوال, يسمح_النسخ
        );
    };
}

// The authenticated MSIR witness is now available. The kernel entry still
// requires an actual host-machine syscall provider which returns the raw
// Linux ABI word and accepts temporary byte-buffer addresses. None exists
// in the current interpreter/runtime interface; never guess or substitute a
// libc syscall/errno wrapper, or forward unauthenticated numeric addresses.
عرف نفذ_نداء_نواة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: غير_موقع,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    النطاقات: &متجه نطاق_ذاكرة_نداء_مسير,
    العقد: &اختيار عقد_نواة_مسير
): نتيجة_تنفيذ_بدائي_مفسر {
    // A registered host-compatible target is necessary but cannot authorize
    // cross-platform numeric syscall execution by itself.
    لو ((*الحالة).الهدف.المنصة.المنصة != هوية_منصة.لينكس()) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(
                    هوية_بدائي_مترجم.نداء_نواة_خام()
                )
            )
        );
    };
    لو (موضع_الإطار >= (*الحالة).عمق_المكدس) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_ذاكرة_نداء_نواة_مفسر(0));
    };
    دع التوقيع: توقيع_نداء_بدائي;
    طابق وثق_توقيع_نداء_نواة_مفسر(
        &(*الحالة).المكدس[موضع_الإطار],
        المسير, العقد, معرفات_الحجج, الحجج, النطاقات
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_ذاكرة_نداء_نواة_مفسر(0)
        );
    }
    | اختيار.بعض(الموثق) -> { التوقيع := الموثق; };
    طابق حضر_نطاقات_نداء_نواة_مفسر(
        الحالة, موضع_الإطار, الأنواع, المسير, معرفات_الحجج, الحجج, النطاقات
    ) مع
    | نتيجة_تحضير_نداء_نواة_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
    }
    | نتيجة_تحضير_نداء_نواة_مفسر.مهيأ(المهيأة) -> {
        // For a C-string operand the source extent must contain the NUL.
        // Passing all-capacity data without a terminator would let the kernel
        // read past the verified allocation, despite otherwise valid bounds.
        دع فهرس_النطاق: متغير غير_موقع = 0;
        بينما (فهرس_النطاق < (الطول(المهيأة) مثل غير_موقع)) {
            دع النطاق: &نطاق_مهيأ_لنداء_نواة_مفسر = &المهيأة[فهرس_النطاق];
            طابق التوقيع.الأدوار[(*النطاق).فهرس_الحجة - 1] مع
            | دور_وسيطة_بدائي.مخزن(_, الحد) -> {
                طابق الحد مع
                | حد_وصول_بدائي.سلسلة_صفرية -> {
                    دع وجد_صفر: متغير منطقي = خطأ;
                    دع فهرس_البايت: متغير غير_موقع = 0;
                    بينما (فهرس_البايت < (الطول((*النطاق).البايتات) مثل غير_موقع)) {
                        لو ((*النطاق).البايتات[فهرس_البايت] == (0 مثل غ8)) {
                            وجد_صفر := صواب;
                        };
                        فهرس_البايت := فهرس_البايت + 1;
                    }
                    لو (!وجد_صفر) {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                            فشل_ذاكرة_نداء_نواة_مفسر((*النطاق).فهرس_الحجة)
                        );
                    };
                }
                | _ -> { };
            }
            | _ -> { };
            فهرس_النطاق := فهرس_النطاق + 1;
        }
    };
    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
        فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نداء_نواة_خام())
        )
    );
}

عام عرف نفذ_بدائي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    موضع_الإطار: غير_موقع,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    الهوية: هوية_بدائي_مترجم,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    الوجهة: اختيار معرف_قيمة_مسير,
    مكان_التعديل: اختيار معرف_قيمة_مسير,
    نطاقات_الذاكرة: &متجه نطاق_ذاكرة_نداء_مسير,
    عقد_النواة: &اختيار عقد_نواة_مسير
): نتيجة_تنفيذ_بدائي_مفسر {
    دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(الهوية);
    دع قيم_الحجج: متجه قيمة_تشغيل = *الحجج;
    دع المعرفات: متجه معرف_قيمة_مسير = *معرفات_الحجج;
    دع العدد: غير_موقع = الطول(قيم_الحجج) مثل غير_موقع;
    لو (العدد != العقد.عدد_الحجج) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.عدد_حجج_بدائي_غير_متسق(
                    الهوية,
                    العقد.عدد_الحجج,
                    العدد
                )
            )
        );
    };

    طابق العقد.فئة_الناتج مع
    | فئة_ناتج_بدائي.بلا_قيمة -> {
        طابق الوجهة مع
        | اختيار.بعض(_) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
                )
            );
        }
        | اختيار.لا_شيء -> { };
    }
    | _ -> {
        طابق الوجهة مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
            );
        }
        | اختيار.بعض(_) -> { };
    };

    طابق الهوية مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> {
        أرجع نفذ_نداء_نواة_مفسر(
            الحالة, موضع_الإطار, الأنواع, المسير,
            &المعرفات, &قيم_الحجج, نطاقات_الذاكرة, عقد_النواة
        );
    }
    | هوية_بدائي_مترجم.طول -> {
        أرجع نفذ_طول_بدائي(الأنواع, المسير, المعرفات[0], &قيم_الحجج[0]);
    }
    | هوية_بدائي_مترجم.بتات_ع64 -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.بتات_ع32 -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(انسخ_قيمة_تشغيل(&قيم_الحجج[0]))); }
    | هوية_بدائي_مترجم.تبديل_موضعين -> {
        // This intrinsic must be eliminated by MSIR lowering before interpretation.
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة())
        );
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        دع نوع_المتجه: معرف_نوع;
        طابق نوع_قيمة_مسير(المسير, المعرفات[0]) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.قيمة_مسير_مفقودة(المعرفات[0])
                )
            );
        }
        | اختيار.بعض(المعرف) -> {
            نوع_المتجه := المعرف;
        };
        طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_المتجه) مع
        | اختيار.لا_شيء -> {
            أرجع فشل_حجة_بدائي(الهوية, 0);
        }
        | اختيار.بعض(_) -> { };
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.تجميع(الأعضاء) -> {
            دع المحدثة: متغير متجه قيمة_تشغيل = الأعضاء;
            دع المنقول: قيمة_تشغيل = انسخ_قيمة_تشغيل(&قيم_الحجج[1]);
            ألحق(المحدثة, المنقول);
            دع الجديدة: قيمة_تشغيل = قيمة_تشغيل.تجميع(المحدثة);
            طابق مكان_التعديل مع
            | اختيار.لا_شيء -> {
                أرجع فشل_حجة_بدائي(الهوية, 0);
            }
            | اختيار.بعض(معرف_المكان) -> {
                طابق اقرأ_مكان_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], معرف_المكان) مع
                | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
                }
                | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
                    طابق حدّث_مكان_من_إطار_بدائي(الحالة, موضع_الإطار, &المكان, الجديدة) مع
                    | اختيار.بعض(الخطأ) -> {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
                    }
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.لا_شيء());
                    };
                };
            };
        }
        | _ -> {
            أرجع فشل_حجة_بدائي(الهوية, 0);
        };
    }
    | هوية_بدائي_مترجم.تحرير -> {
        طابق حرر_حجة_بدائي(
            الحالة,
            موضع_الإطار,
            المسير,
            المعرفات[0],
            &قيم_الحجج[0]
        ) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.لا_شيء());
        };
    }
    | هوية_بدائي_مترجم.معمارية_المضيف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختيار.بعض(قيمة_تشغيل.بتات_عدد(رمز_معمارية_المضيف_الحالية() مثل غير_موقع))
        );
    }
    | هوية_بدائي_مترجم.منصة_المضيف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختيار.بعض(قيمة_تشغيل.بتات_عدد(رمز_منصة_المضيف_الحالية() مثل غير_موقع))
        );
    }
    | هوية_بدائي_مترجم.بيئة_المضيف -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختيار.بعض(قيمة_تشغيل.بتات_عدد(رمز_بيئة_المضيف_الحالية() مثل غير_موقع))
        );
    }
    // WebAssembly linear-memory operations exist only in wasm32 machine code;
    // the interpreter has no linear memory and reports them as unsupported.
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نمو_ذاكرة_خطية())
            )
        );
    }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.قراءة_ذاكرة_خطية())
            )
        );
    }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.كتابة_ذاكرة_خطية())
            )
        );
    }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نسخ_ذاكرة_خطية())
            )
        );
    }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> {
