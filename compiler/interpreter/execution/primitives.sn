استورد compiler.interpreter.execution.execution_state;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.memory.memory;
استورد compiler.interpreter.diagnostics.runtime_failures;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.identifiers;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_semantic_contract;
استورد compiler.runtime.host_service_adapter;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;

// This is the single Interpreter-owned boundary from canonical primitive identity
// to semantic runtime behavior. It owns no source spellings and no platform ABI facts.
عام نوع نتيجة_تنفيذ_بدائي_مفسر =
    | عاد بنوع اختيار قيمة_تشغيل
    | أنهى_العملية بنوع غير_موقع
    | أخفق بنوع فشل_تفسير_مسير
;

عرف فشل_حجة_بدائي(
    الهوية: هوية_بدائي_مترجم,
    الفهرس: غير_موقع
): نتيجة_تنفيذ_بدائي_مفسر {
    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
        فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(الهوية, الفهرس)
        )
    );
}

عرف ابحث_تعليمة_تعريف_قيمة_مفسر(
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار عرض_تعليمة_مسير {
    دع ك: متغير غير_موقع = 0;
    دع انتهت: متغير منطقي = خطأ;
    بينما (!انتهت) {
        طابق معرف_كتلة_مسير_عند(المسير, المعرف.الدالة, ك) مع
        | اختيار.لا_شيء -> {
            انتهت := صواب;
        }
        | اختيار.بعض(الكتلة) -> {
            طابق ابحث_كتلة_مسير(المسير, الكتلة) مع
            | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> {
                أرجع اختيار.لا_شيء();
            }
            | نتيجة_بحث_كتلة_مسير.موجودة(عرض_الكتلة) -> {
                دع ت: متغير غير_موقع = 0;
                بينما (ت < عرض_الكتلة.عدد_التعليمات) {
                    طابق تعليمة_مسير_عند(المسير, الكتلة, ت) مع
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.لا_شيء();
                    }
                    | اختيار.بعض(التعليمة) -> {
                        طابق التعليمة.الناتج مع
                        | اختيار.لا_شيء -> { }
                        | اختيار.بعض(الناتج) -> {
                            لو (قيمتا_مسير_متساويتان(الناتج, المعرف)) {
                                أرجع اختيار.بعض(التعليمة);
                            };
                        };
                    };
                    ت := ت + 1;
                }
            };
            ك := ك + 1;
        };
    }
    أرجع اختيار.لا_شيء();
}

عرف حدّث_مكان_من_إطار_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الإطار: &متغير إطار_تفسير_مسير,
    المكان: &مكان_تشغيل,
    القيمة: قيمة_تشغيل
): اختيار فشل_تفسير_مسير {
    طابق اكتب_الإطار_النشط(الحالة, *الإطار) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | اختيار.لا_شيء -> { };

    دع قيمة_الحالة: متغير حالة_تنفيذ_مفسر = *الحالة;
    طابق اكتب_مكان_مفسر(
        &متغير قيمة_الحالة.المكدس,
        &متغير قيمة_الحالة.الذاكرة,
        المكان,
        القيمة
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> {
        *الحالة := قيمة_الحالة;
    };

    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(المحدث) -> {
        *الإطار := المحدث;
    };
    أرجع اختيار.لا_شيء();
}

عرف حرر_صندوق_بقيمة_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المعرف: معرف_صندوق_مفسر
): اختيار فشل_تفسير_مسير {
    دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [];
    دع الجذر: جذر_مكان_تشغيل = جذر_مكان_تشغيل.صندوق(المعرف);
    دع المكان: مكان_تشغيل = {
        الجذر: الجذر,
        الإسقاطات: الإسقاطات,
        قابل_للكتابة: صواب
    };
    دع قيمة_الحالة: متغير حالة_تنفيذ_مفسر = *الحالة;
    طابق حرر_مكان_مفسر(
        &متغير قيمة_الحالة.المكدس,
        &متغير قيمة_الحالة.الذاكرة,
        &المكان
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> {
        *الحالة := قيمة_الحالة;
        أرجع اختيار.لا_شيء();
    };
}

عرف حرر_تخزين_قيمة_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    القيمة: &قيمة_تشغيل
): اختيار فشل_تفسير_مسير {
    طابق *القيمة مع
    | قيمة_تشغيل.صندوق(الصندوق) -> {
        أرجع حرر_صندوق_بقيمة_بدائي(الحالة, الصندوق);
    }
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأعضاء) مثل غير_موقع)) {
            طابق حرر_تخزين_قيمة_بدائي(الحالة, &الأعضاء[ف]) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختيار.لا_شيء();
    }
    | قيمة_تشغيل.موسوم(الموسوم) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الموسوم.الحمولات) مثل غير_موقع)) {
            طابق حرر_تخزين_قيمة_بدائي(الحالة, &الموسوم.الحمولات[ف]) مع
            | اختيار.بعض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | اختيار.لا_شيء -> { };
            ف := ف + 1;
        }
        أرجع اختيار.لا_شيء();
    }
    | _ -> {
        // Text/vector aggregate storage is carried by the semantic value itself.
        // Invalidating its owning root/slot below is the Interpreter release action.
        أرجع اختيار.لا_شيء();
    };
}

عرف حرر_حجة_بدائي(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الإطار: &متغير إطار_تفسير_مسير,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    القيمة: &قيمة_تشغيل
): اختيار فشل_تفسير_مسير {
    طابق حرر_تخزين_قيمة_بدائي(الحالة, القيمة) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | اختيار.لا_شيء -> { };

    طابق ابحث_تعليمة_تعريف_قيمة_مفسر(المسير, المعرف) مع
    | اختيار.بعض(التعليمة) -> {
        طابق التعليمة.العملية مع
        | عملية_مسير.تحميل(التحميل) -> {
            طابق اقرأ_مكان_خانة_مسير(الإطار, التحميل.المكان) مع
            | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
                طابق اكتب_الإطار_النشط(الحالة, *الإطار) مع
                | اختيار.بعض(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | اختيار.لا_شيء -> { };
                دع قيمة_الحالة: متغير حالة_تنفيذ_مفسر = *الحالة;
                طابق حرر_مكان_مفسر(
                    &متغير قيمة_الحالة.المكدس,
                    &متغير قيمة_الحالة.الذاكرة,
                    &المكان
                ) مع
                | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> {
                    *الحالة := قيمة_الحالة;
                };
                طابق اقرأ_الإطار_النشط(الحالة) مع
                | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
                    أرجع اختيار.بعض(الخطأ);
                }
                | نتيجة_إطار_نشط.موجود(المحدث) -> {
                    *الإطار := المحدث;
                };
            };
        }
        | _ -> { };
    }
    | اختيار.لا_شيء -> { };

    طابق أبطل_قيمة_خانة_مسير(الإطار, المعرف) مع
    | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_كتابة_خانة.نجحت -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف ابن_قيمة_نتيجة_بدائي(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    الوجهة: اختيار معرف_قيمة_مسير,
    هل_نجح: منطقي,
    الحمولة: قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    دع معرف_الوجهة: معرف_قيمة_مسير;
    طابق الوجهة مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
        );
    }
    | اختيار.بعض(المعرف) -> {
        معرف_الوجهة := المعرف;
    };

    دع نوع_النتيجة: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, معرف_الوجهة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.قيمة_مسير_مفقودة(معرف_الوجهة)
            )
        );
    }
    | اختيار.بعض(المعرف) -> {
        نوع_النتيجة := المعرف;
    };

    دع هوية_المنشئ: هوية_منشئ_نوع;
    لو (هل_نجح) {
        هوية_المنشئ := هوية_منشئ_نوع.نتيجة_نجاح();
    } وإلا {
        هوية_المنشئ := هوية_منشئ_نوع.نتيجة_خطأ();
    };
    دع الترتيب: غير_موقع;
    طابق ترتيب_منشئ_نوع_دلالي_بالهوية(الأنواع, نوع_النتيجة, هوية_المنشئ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.نوع_فهرسة_غير_متسق(معرف_الوجهة)
            )
        );
    }
    | اختيار.بعض(القيمة) -> {
        الترتيب := القيمة;
    };
    دع الحمولات: متجه قيمة_تشغيل = [الحمولة];
    دع الموسوم: قيمة_موسومة_تشغيل = {
        المنشئ: الترتيب,
        الحمولات: الحمولات
    };
    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.بعض(قيمة_تشغيل.موسوم(الموسوم)));
}

عرف نفذ_نص_من_بايتات_بدائي(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرف_الحجة: معرف_قيمة_مسير,
    الحجة: &قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    دع نوع_الحجة: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, معرف_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.قيمة_مسير_مفقودة(معرف_الحجة)
            )
        );
    }
    | اختيار.بعض(المعرف) -> {
        نوع_الحجة := المعرف;
    };

    دع نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.نص_من_بايتات(), 0);
    }
    | اختيار.بعض(المعرف) -> {
        نوع_العنصر := المعرف;
    };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_العنصر) مع
    | اختيار.لا_شيء -> {
        أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.نص_من_بايتات(), 0);
    }
    | اختيار.بعض(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.غ8 -> { }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.نص_من_بايتات(), 0);
            };
        }
        | _ -> {
            أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.نص_من_بايتات(), 0);
        };
    };

    طابق *الحجة مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        دع البايتات: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأعضاء) مثل غير_موقع)) {
            طابق الأعضاء[ف] مع
            | قيمة_تشغيل.بتات_عدد(الخام) -> {
                // Canonical u8 values occupy exactly eight semantic bits. Reject an
                // inconsistent runtime payload rather than truncating it silently.
                لو (الخام > 255) {
                    أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.نص_من_بايتات(), 0);
                };
                ألحق(البايتات, الخام مثل غ8);
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.نص_من_بايتات(), 0);
            };
            ف := ف + 1;
        }
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختيار.بعض(قيمة_تشغيل.نص(البايتات))
        );
    }
    | _ -> {
        أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.نص_من_بايتات(), 0);
    };
}

عرف نفذ_طول_بدائي(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    معرف_الحجة: معرف_قيمة_مسير,
    الحجة: &قيمة_تشغيل
): نتيجة_تنفيذ_بدائي_مفسر {
    دع نوع_الحجة: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, معرف_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.قيمة_مسير_مفقودة(معرف_الحجة)
            )
        );
    }
    | اختيار.بعض(المعرف) -> {
        نوع_الحجة := المعرف;
    };
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_الحجة) مع
    | اختيار.لا_شيء -> {
        أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
    }
    | اختيار.بعض(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.نص -> {
                طابق *الحجة مع
                | قيمة_تشغيل.نص(البايتات) -> {
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                        اختيار.بعض(
                            قيمة_تشغيل.بتات_عدد(الطول(البايتات) مثل غير_موقع)
                        )
                    );
                }
                | _ -> {
                    أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
                };
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
            };
        }
        | صنف_شكل_نوع_دلالي.متجه -> {
            طابق *الحجة مع
            | قيمة_تشغيل.تجميع(الأعضاء) -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                    اختيار.بعض(قيمة_تشغيل.بتات_عدد(الطول(الأعضاء) مثل غير_موقع))
                );
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
            };
        }
        | صنف_شكل_نوع_دلالي.شريحة -> {
            طابق *الحجة مع
            | قيمة_تشغيل.تجميع(الأعضاء) -> {
                أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                    اختيار.بعض(قيمة_تشغيل.بتات_عدد(الطول(الأعضاء) مثل غير_موقع))
                );
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
            };
        }
        | _ -> {
            أرجع فشل_حجة_بدائي(هوية_بدائي_مترجم.طول(), 0);
        };
    };
}

عرف استخرج_بايتات_قيمة_مفسر(
    القيمة: &قيمة_تشغيل
): اختيار متجه غ8 {
    طابق *القيمة مع
    | قيمة_تشغيل.تجميع(العناصر) -> {
        دع البايتات: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
            طابق العناصر[ف] مع
            | قيمة_تشغيل.بتات_عدد(الخام) -> {
                لو (الخام > 255) { أرجع اختيار.لا_شيء(); };
                ألحق(البايتات, الخام مثل غ8);
            }
            | _ -> { أرجع اختيار.لا_شيء(); };
            ف := ف + 1;
        }
        أرجع اختيار.بعض(البايتات);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف نفذ_كتابة_بايتات_بدائي_مفسر(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    الهوية: هوية_بدائي_مترجم,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    الوجهة: اختيار معرف_قيمة_مسير
): نتيجة_تنفيذ_بدائي_مفسر {
    دع المعرفات: متجه معرف_قيمة_مسير = *معرفات_الحجج;
    دع قيم_الحجج: متجه قيمة_تشغيل = *الحجج;
        دع نوع_المحتوى: معرف_نوع;
        طابق نوع_قيمة_مسير(المسير, المعرفات[1]) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.قيمة_مسير_مفقودة(المعرفات[1])
                )
            );
        }
        | اختيار.بعض(المعرف) -> {
            نوع_المحتوى := المعرف;
        };

        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_المحتوى) مع
        | اختيار.لا_شيء -> {
            أرجع فشل_حجة_بدائي(الهوية, 1);
        }
        | اختيار.بعض(المعرف) -> {
            نوع_العنصر := المعرف;
        };
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_العنصر) مع
        | اختيار.لا_شيء -> {
            أرجع فشل_حجة_بدائي(الهوية, 1);
        }
        | اختيار.بعض(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                طابق البدائي مع
                | نوع_بدائي_مقنن.غ8 -> { }
                | _ -> {
                    أرجع فشل_حجة_بدائي(الهوية, 1);
                };
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(الهوية, 1);
            };
        };

        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.نص(بايتات_المسار) -> {
            طابق قيم_الحجج[1] مع
            | قيمة_تشغيل.تجميع(العناصر) -> {
                دع البايتات: متغير متجه غ8 = [];
                دع ف: متغير غير_موقع = 0;
                بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
                    طابق العناصر[ف] مع
                    | قيمة_تشغيل.بتات_عدد(الخام) -> {
                        لو (الخام > 255) {
                            أرجع فشل_حجة_بدائي(الهوية, 1);
                        };
                        ألحق(البايتات, الخام مثل غ8);
                    }
                    | _ -> {
                        أرجع فشل_حجة_بدائي(الهوية, 1);
                    };
                    ف := ف + 1;
                }
                دع نتيجة_الكتابة: نتيجة عدد, عدد =
                    اكتب_بايتات_تنفيذية_مضيف_من_بايتات(
                        &بايتات_المسار,
                        &البايتات
                    );
                طابق نتيجة_الكتابة مع
                | نتيجة.نجح(العدد) -> {
                    أرجع ابن_قيمة_نتيجة_بدائي(
                        الأنواع,
                        المسير,
                        الوجهة,
                        صواب,
                        قيمة_تشغيل.بتات_عدد(العدد مثل غير_موقع)
                    );
                }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع ابن_قيمة_نتيجة_بدائي(
                        الأنواع,
                        المسير,
                        الوجهة,
                        خطأ,
                        قيمة_تشغيل.بتات_عدد(الخطأ مثل غير_موقع)
                    );
                };
            }
            | _ -> {
                أرجع فشل_حجة_بدائي(الهوية, 1);
            };
        }
        | _ -> {
            أرجع فشل_حجة_بدائي(الهوية, 0);
        };
 }


عرف حدّث_متجه_بايتات_بدائي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الإطار: &متغير إطار_تفسير_مسير,
    الهوية: هوية_بدائي_مترجم,
    البايتات: &متجه غ8,
    مكان_التعديل: اختيار معرف_قيمة_مسير
): اختيار فشل_تفسير_مسير {
    دع العناصر: متغير متجه قيمة_تشغيل = [];
    دع نسخة_البايتات: متجه غ8 = *البايتات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(نسخة_البايتات) مثل غير_موقع)) {
        ألحق(العناصر, قيمة_تشغيل.بتات_عدد(نسخة_البايتات[ف] مثل غير_موقع));
        ف := ف + 1;
    }
    دع الجديدة: قيمة_تشغيل = قيمة_تشغيل.تجميع(العناصر);
    طابق مكان_التعديل مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
        );
    }
    | اختيار.بعض(معرف_المكان) -> {
        طابق اقرأ_مكان_خانة_مسير(الإطار, معرف_المكان) مع
        | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
            أرجع حدّث_مكان_من_إطار_بدائي(الحالة, الإطار, &المكان, الجديدة);
        };
    };
}

عام عرف نفذ_بدائي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الإطار: &متغير إطار_تفسير_مسير,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    الهوية: هوية_بدائي_مترجم,
    معرفات_الحجج: &متجه معرف_قيمة_مسير,
    الحجج: &متجه قيمة_تشغيل,
    الوجهة: اختيار معرف_قيمة_مسير,
    مكان_التعديل: اختيار معرف_قيمة_مسير
): نتيجة_تنفيذ_بدائي_مفسر {
    دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(الهوية);
    دع قيم_الحجج: متجه قيمة_تشغيل = *الحجج;
    دع المعرفات: متجه معرف_قيمة_مسير = *معرفات_الحجج;
    دع العدد: غير_موقع = الطول(قيم_الحجج) مثل غير_موقع;
    لو (العدد != العقد.عدد_الحجج) {
        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.عدد_حجج_بدائي_غير_متسق(
                    الهوية,
                    العقد.عدد_الحجج,
                    العدد
                )
            )
        );
    };

    طابق العقد.فئة_الناتج مع
    | فئة_ناتج_بدائي.بلا_قيمة -> {
        طابق الوجهة مع
        | اختيار.بعض(_) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
                )
            );
        }
        | اختيار.لا_شيء -> { };
    }
    | _ -> {
        طابق الوجهة مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
            );
        }
        | اختيار.بعض(_) -> { };
    };

    طابق الهوية مع
    | هوية_بدائي_مترجم.طول -> {
        أرجع نفذ_طول_بدائي(الأنواع, المسير, المعرفات[0], &قيم_الحجج[0]);
    }
    | هوية_بدائي_مترجم.نص_من_بايتات -> {
        أرجع نفذ_نص_من_بايتات_بدائي(
            الأنواع,
            المسير,
            المعرفات[0],
            &قيم_الحجج[0]
        );
    }
    | هوية_بدائي_مترجم.إلحاق -> {
        دع نوع_المتجه: معرف_نوع;
        طابق نوع_قيمة_مسير(المسير, المعرفات[0]) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.قيمة_مسير_مفقودة(المعرفات[0])
                )
            );
        }
        | اختيار.بعض(المعرف) -> {
            نوع_المتجه := المعرف;
        };
        طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_المتجه) مع
        | اختيار.لا_شيء -> {
            أرجع فشل_حجة_بدائي(الهوية, 0);
        }
        | اختيار.بعض(_) -> { };
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.تجميع(الأعضاء) -> {
            دع المحدثة: متغير متجه قيمة_تشغيل = الأعضاء;
            دع المنقول: قيمة_تشغيل = انسخ_قيمة_تشغيل(&قيم_الحجج[1]);
            ألحق(المحدثة, المنقول);
            دع الجديدة: قيمة_تشغيل = قيمة_تشغيل.تجميع(المحدثة);
            طابق مكان_التعديل مع
            | اختيار.لا_شيء -> {
                أرجع فشل_حجة_بدائي(الهوية, 0);
            }
            | اختيار.بعض(معرف_المكان) -> {
                طابق اقرأ_مكان_خانة_مسير(الإطار, معرف_المكان) مع
                | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
                    أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
                }
                | نتيجة_قراءة_مكان_خانة.موجود(المكان) -> {
                    طابق حدّث_مكان_من_إطار_بدائي(الحالة, الإطار, &المكان, الجديدة) مع
                    | اختيار.بعض(الخطأ) -> {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
                    }
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.لا_شيء());
                    };
                };
            };
        }
        | _ -> {
            أرجع فشل_حجة_بدائي(الهوية, 0);
        };
    }
    | هوية_بدائي_مترجم.تحرير -> {
        طابق حرر_حجة_بدائي(
            الحالة,
            الإطار,
            المسير,
            المعرفات[0],
            &قيم_الحجج[0]
        ) مع
        | اختيار.بعض(الخطأ) -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ);
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(اختيار.لا_شيء());
        };
    }
    | هوية_بدائي_مترجم.فتح_ملف_للقراءة -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.نص(بايتات_المسار) -> {
            دع الواصف: عدد = افتح_ملف_مضيف_للقراءة_من_بايتات(&بايتات_المسار);
            أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                اختيار.بعض(قيمة_تشغيل.بتات_عدد(الواصف مثل غير_موقع))
            );
        }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    }
    | هوية_بدائي_مترجم.قراءة_بايت_ملف -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> {
            دع المقروء: عدد = اقرأ_بايت_ملف_مضيف(الخام مثل عدد);
            أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                اختيار.بعض(قيمة_تشغيل.بتات_عدد(المقروء مثل غير_موقع))
            );
        }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    }
    | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> {
        دع الواصف: عدد;
        دع الإزاحة: عدد;
        دع المطلوب: عدد;
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> { الواصف := الخام مثل عدد; }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
        دع البايتات: متغير متجه غ8 = [];
        طابق استخرج_بايتات_قيمة_مفسر(&قيم_الحجج[1]) مع
        | اختيار.بعض(القيمة) -> { البايتات := القيمة; }
        | اختيار.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 1); };
        طابق قيم_الحجج[2] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> { الإزاحة := الخام مثل عدد; }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 2); };
        طابق قيم_الحجج[3] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> { المطلوب := الخام مثل عدد; }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 3); };
        دع المقروء: عدد = اقرأ_مقطع_ملف_مضيف(الواصف, &متغير البايتات, الإزاحة, المطلوب);
        طابق حدّث_متجه_بايتات_بدائي_مفسر(
            الحالة, الإطار, الهوية, &البايتات, مكان_التعديل
        ) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ); }
        | اختيار.لا_شيء -> { };
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختيار.بعض(قيمة_تشغيل.بتات_عدد(المقروء مثل غير_موقع))
        );
    }
    | هوية_بدائي_مترجم.إنشاء_ملف_للكتابة -> {
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.نص(بايتات_المسار) -> {
            دع الواصف: عدد = أنشئ_ملف_مضيف_للكتابة_من_بايتات(&بايتات_المسار);
            أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
                اختيار.بعض(قيمة_تشغيل.بتات_عدد(الواصف مثل غير_موقع))
            );
        }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
    }
    | هوية_بدائي_مترجم.كتابة_مقطع_ملف -> {
        دع الواصف: عدد;
        دع الإزاحة: عدد;
        دع المطلوب: عدد;
        طابق قيم_الحجج[0] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> { الواصف := الخام مثل عدد; }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 0); };
        دع البايتات: متجه غ8;
        طابق استخرج_بايتات_قيمة_مفسر(&قيم_الحجج[1]) مع
        | اختيار.بعض(القيمة) -> { البايتات := القيمة; }
        | اختيار.لا_شيء -> { أرجع فشل_حجة_بدائي(الهوية, 1); };
        طابق قيم_الحجج[2] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> { الإزاحة := الخام مثل عدد; }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 2); };
        طابق قيم_الحجج[3] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> { المطلوب := الخام مثل عدد; }
        | _ -> { أرجع فشل_حجة_بدائي(الهوية, 3); };
        دع المكتوب: عدد = اكتب_مقطع_ملف_مضيف(الواصف, &البايتات, الإزاحة, المطلوب);
        أرجع نتيجة_تنفيذ_بدائي_مفسر.عاد(
            اختيار.بعض(قيمة_تشغيل.بتات_عدد(المكتوب مثل غير_موقع))
        );
    }
