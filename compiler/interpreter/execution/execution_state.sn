استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_consumer;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.memory.memory;
استورد compiler.interpreter.runtime_failures;
استورد compiler.backend.target.target_model;
استورد compiler.runtime.primitive_runtime_abi;

عام نوع حالة_تنفيذ_مفسر = {
    الهدف: واصف_هدف,
    المكدس: متجه إطار_تفسير_مسير,
    عمق_المكدس: غير_موقع,
    الذاكرة: ذاكرة_مفسر,
    التفعيل_التالي: غير_موقع,
    // One interpreter, with optional bounded and effect-restricted CTFE.
    نمط_تقييم_مسبق: منطقي,
    تعليمات_متبقية: غير_موقع,
    حد_أطر_وقت_الترجمة: غير_موقع,
    // Lazy per-function index: Value ID -> source place ID when the value is defined by load.
    // It is derived once from canonical MSIR and reused by release; it owns no new semantics.
    مصادر_تحميل_القيم: متجه متجه اختيار معرف_قيمة_مسير,
    مصادر_تحميل_مهيأة: متجه منطقي,
    // فهرس مشتق ومؤجل لفروع switch، بمفاتيح (دالة، كتلة).
    // الحالات وحوافها باقية في MSIR؛ لا ننسخها أو نغير دلالات البرنامج.
    فهارس_الفروع_المتعددة: متجه متجه فهرس_فرع_متعدد_مفسر
};

// Derived once per (function, block) from the verified switch: a table
// indexed by tag - الأدنى when the tags are dense (at least 10% of their
// range, LLVM's jump-table density), otherwise the tags sorted for binary
// search. Previously only switches dense from tag zero were indexed and every
// other switch scanned its cases linearly.
عام نوع فهرس_فرع_متعدد_مفسر = {
    مهيأ: منطقي,
    كثيف: منطقي,
    الأدنى: غير_موقع,
    // Dense: case index of tag الأدنى + i.
    الجدول: متجه اختيار غير_موقع,
    // Sparse: ascending tags and the case index of each.
    الوسوم_المرتبة: متجه غير_موقع,
    مواضع_الوسوم: متجه غير_موقع
};

عرف فهرس_فرع_متعدد_مفسر_فارغ(): فهرس_فرع_متعدد_مفسر {
    دع الجدول: متجه اختيار غير_موقع = [];
    دع الوسوم: متجه غير_موقع = [];
    دع المواضع: متجه غير_موقع = [];
    دع الفهرس: فهرس_فرع_متعدد_مفسر = {
        مهيأ: خطأ,
        كثيف: خطأ,
        الأدنى: 0,
        الجدول: الجدول,
        الوسوم_المرتبة: الوسوم,
        مواضع_الوسوم: المواضع
    };
    أرجع الفهرس;
}

عرف ابن_فهرس_فرع_متعدد_مفسر(الفرع: &فرع_متعدد_مسير): فهرس_فرع_متعدد_مفسر {
    دع الفهرس: متغير فهرس_فرع_متعدد_مفسر = فهرس_فرع_متعدد_مفسر_فارغ();
    الفهرس.مهيأ := صواب;
    دع العدد: غير_موقع = الطول((*الفرع).الحالات) مثل غير_موقع;
    لو (العدد == 0) { أرجع الفهرس; };
    دع الأدنى: متغير غير_موقع = (*الفرع).الحالات[0].الوسم;
    دع الأعلى: متغير غير_موقع = (*الفرع).الحالات[0].الوسم;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع الوسم: غير_موقع = (*الفرع).الحالات[ف].الوسم;
        لو (الوسم < الأدنى) { الأدنى := الوسم; };
        لو (الوسم > الأعلى) { الأعلى := الوسم; };
        ف := ف + 1;
    }
    دع المدى: غير_موقع = الأعلى - الأدنى + 1;
    لو (العدد * 100 >= المدى * 10) {
        دع موضع: متغير غير_موقع = 0;
        بينما (موضع < المدى) {
            ألحق(الفهرس.الجدول, اختيار.لا_شيء());
            موضع := موضع + 1;
        }
        ف := 0;
        بينما (ف < العدد) {
            الفهرس.الجدول[(*الفرع).الحالات[ف].الوسم - الأدنى] := اختيار.بعض(ف);
            ف := ف + 1;
        }
        الفهرس.كثيف := صواب;
        الفهرس.الأدنى := الأدنى;
        أرجع الفهرس;
    };
    // Insertion into ascending order; built once per switch block.
    ف := 0;
    بينما (ف < العدد) {
        دع الوسم: غير_موقع = (*الفرع).الحالات[ف].الوسم;
        ألحق(الفهرس.الوسوم_المرتبة, الوسم);
        ألحق(الفهرس.مواضع_الوسوم, ف);
        دع ي: متغير غير_موقع = الطول(الفهرس.الوسوم_المرتبة) مثل غير_موقع;
        ي := ي - 1;
        بينما (ي > 0 && الفهرس.الوسوم_المرتبة[ي - 1] > الوسم) {
            الفهرس.الوسوم_المرتبة[ي] := الفهرس.الوسوم_المرتبة[ي - 1];
            الفهرس.مواضع_الوسوم[ي] := الفهرس.مواضع_الوسوم[ي - 1];
            ي := ي - 1;
        }
        الفهرس.الوسوم_المرتبة[ي] := الوسم;
        الفهرس.مواضع_الوسوم[ي] := ف;
        ف := ف + 1;
    }
    أرجع الفهرس;
}

// The active-frame query returns the live stack position, not a copied frame.
عام نوع نتيجة_فهرس_فرع_مفسر =
    | افتراضي
    | حالة بنوع غير_موقع
;

// Dense switches select in O(1); sparse ones in O(log n) by binary search.
عام عرف ابحث_فهرس_فرع_متعدد_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الكتلة: معرف_كتلة_مسير,
    الفرع: &فرع_متعدد_مسير,
    الوسم: غير_موقع
): نتيجة_فهرس_فرع_مفسر {
    دع الدالة: غير_موقع = الكتلة.الدالة.القيمة;
    دع الموضع: غير_موقع = الكتلة.القيمة;
    بينما ((الطول((*الحالة).فهارس_الفروع_المتعددة) مثل غير_موقع) <= الدالة) {
        دع فهارس: متجه فهرس_فرع_متعدد_مفسر = [];
        ألحق((*الحالة).فهارس_الفروع_المتعددة, فهارس);
    }
    بينما ((الطول((*الحالة).فهارس_الفروع_المتعددة[الدالة]) مثل غير_موقع) <= الموضع) {
        ألحق((*الحالة).فهارس_الفروع_المتعددة[الدالة], فهرس_فرع_متعدد_مفسر_فارغ());
    }
    لو (!(*الحالة).فهارس_الفروع_المتعددة[الدالة][الموضع].مهيأ) {
        (*الحالة).فهارس_الفروع_المتعددة[الدالة][الموضع] := ابن_فهرس_فرع_متعدد_مفسر(الفرع);
    };
    دع الفهرس: &فهرس_فرع_متعدد_مفسر = &(*الحالة).فهارس_الفروع_المتعددة[الدالة][الموضع];
    لو ((*الفهرس).كثيف) {
        لو (الوسم < (*الفهرس).الأدنى) { أرجع نتيجة_فهرس_فرع_مفسر.افتراضي(); };
        دع الخانة: غير_موقع = الوسم - (*الفهرس).الأدنى;
        لو (الخانة >= (الطول((*الفهرس).الجدول) مثل غير_موقع)) {
            أرجع نتيجة_فهرس_فرع_مفسر.افتراضي();
        };
        طابق (*الفهرس).الجدول[الخانة] مع
        | اختيار.بعض(الحالة_المختارة) -> { أرجع نتيجة_فهرس_فرع_مفسر.حالة(الحالة_المختارة); }
        | اختيار.لا_شيء -> { أرجع نتيجة_فهرس_فرع_مفسر.افتراضي(); };
    };
    دع الأسفل: متغير غير_موقع = 0;
    دع الأعلى: متغير غير_موقع = الطول((*الفهرس).الوسوم_المرتبة) مثل غير_موقع;
    بينما (الأسفل < الأعلى) {
        دع الوسط: غير_موقع = الأسفل + (الأعلى - الأسفل) / 2;
        دع وسم_الوسط: غير_موقع = (*الفهرس).الوسوم_المرتبة[الوسط];
        لو (وسم_الوسط == الوسم) {
            أرجع نتيجة_فهرس_فرع_مفسر.حالة((*الفهرس).مواضع_الوسوم[الوسط]);
        };
        لو (وسم_الوسط < الوسم) {
            الأسفل := الوسط + 1;
        } وإلا {
            الأعلى := الوسط;
        };
    }
    أرجع نتيجة_فهرس_فرع_مفسر.افتراضي();
}

عام نوع نتيجة_إطار_نشط =
    | موجود بنوع غير_موقع
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف حالة_تنفيذ_مفسر_جديدة(الهدف: واصف_هدف): حالة_تنفيذ_مفسر {
    دع المكدس: متجه إطار_تفسير_مسير = [];
    دع الذاكرة: ذاكرة_مفسر = ذاكرة_مفسر_جديدة();
    دع مصادر_تحميل_القيم: متجه متجه اختيار معرف_قيمة_مسير = [];
    دع مصادر_تحميل_مهيأة: متجه منطقي = [];
    دع فهارس_الفروع_المتعددة: متجه متجه فهرس_فرع_متعدد_مفسر = [];
    دع الحالة: حالة_تنفيذ_مفسر = {
        الهدف: الهدف,
        المكدس: المكدس,
        عمق_المكدس: 0,
        الذاكرة: الذاكرة,
        التفعيل_التالي: 0,
        نمط_تقييم_مسبق: خطأ,
        تعليمات_متبقية: 0,
        حد_أطر_وقت_الترجمة: 0,
        مصادر_تحميل_القيم: مصادر_تحميل_القيم,
        مصادر_تحميل_مهيأة: مصادر_تحميل_مهيأة,
        فهارس_الفروع_المتعددة: فهارس_الفروع_المتعددة
    };
    أرجع الحالة;
}

عرف هيئ_مصادر_تحميل_دالة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الدالة: معرف_دالة_مسير
): منطقي {
    بينما ((الطول((*الحالة).مصادر_تحميل_القيم) مثل غير_موقع) <= الدالة.القيمة) {
        دع فارغ: متجه اختيار معرف_قيمة_مسير = [];
        ألحق((*الحالة).مصادر_تحميل_القيم, فارغ);
        ألحق((*الحالة).مصادر_تحميل_مهيأة, خطأ);
    }
    لو ((*الحالة).مصادر_تحميل_مهيأة[الدالة.القيمة]) {
        أرجع صواب;
    };

    دع عدد_القيم: غير_موقع;
    طابق عدد_قيم_دالة_مسير(المسير, الدالة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(العدد) -> { عدد_القيم := العدد; };

    دع المصادر: متغير متجه اختيار معرف_قيمة_مسير = [];
    دع ق: متغير غير_موقع = 0;
    بينما (ق < عدد_القيم) {
        ألحق(المصادر, اختيار.لا_شيء());
        ق := ق + 1;
    }

    دع عدد_الكتل: غير_موقع;
    طابق ابحث_دالة_مسير(المسير, الدالة) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع خطأ; }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> { عدد_الكتل := العرض.عدد_الكتل; };

    دع ك: متغير غير_موقع = 0;
    بينما (ك < عدد_الكتل) {
        دع الكتلة: معرف_كتلة_مسير;
        طابق معرف_كتلة_مسير_عند(المسير, الدالة, ك) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(المعرف) -> { الكتلة := المعرف; };

        دع عدد_التعليمات: غير_موقع;
        طابق ابحث_كتلة_مسير(المسير, الكتلة) مع
        | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع خطأ; }
        | نتيجة_بحث_كتلة_مسير.موجودة(العرض) -> {
            عدد_التعليمات := العرض.عدد_التعليمات;
        };

        دع ت: متغير غير_موقع = 0;
        بينما (ت < عدد_التعليمات) {
            طابق تعليمة_مسير_عند(المسير, الكتلة, ت) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(التعليمة) -> {
                طابق التعليمة.الناتج مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(الناتج) -> {
                    لو (الناتج.القيمة < عدد_القيم) {
                        طابق التعليمة.العملية مع
                        | عملية_مسير.تحميل(التحميل) -> {
                            المصادر[الناتج.القيمة] := اختيار.بعض(التحميل.المكان);
                        }
                        | _ -> { };
                    };
                };
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }

    (*الحالة).مصادر_تحميل_القيم[الدالة.القيمة] := المصادر;
    (*الحالة).مصادر_تحميل_مهيأة[الدالة.القيمة] := صواب;
    أرجع صواب;
}

عام عرف مصدر_تحميل_قيمة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار معرف_قيمة_مسير {
    لو (!هيئ_مصادر_تحميل_دالة_مفسر(الحالة, المسير, المعرف.الدالة)) {
        أرجع اختيار.لا_شيء();
    };
    لو (المعرف.القيمة >= (الطول((*الحالة).مصادر_تحميل_القيم[المعرف.الدالة.القيمة]) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع (*الحالة).مصادر_تحميل_القيم[المعرف.الدالة.القيمة][المعرف.القيمة];
}

// Executable startup data belongs to the canonical MSIR external globals.
// The driver supplies guest argument bytes; the interpreter materializes the
// same argc/argv storage shape the native entry wrapper provides, using its
// existing owned memory and place provenance. Never read the compiler's argv.
// No independent program-argument store survives this initialization.
عام عرف هيئ_وسائط_إقلاع_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الوسائط: &متجه متجه غ8
): منطقي {
    دع العدد: غير_موقع = الطول(*الوسائط) مثل غير_موقع;
    لو (العدد > 65536) { أرجع خطأ; };

    دع اسم_العدد: متجه غ8 = اسم_عدد_وسائط_إقلاع_أساسي();
    دع اسم_المؤشر: متجه غ8 = اسم_مؤشر_وسائط_إقلاع_أساسي();
    دع وجد_العدد: متغير اختيار معرف_عام_مسير = اختيار.لا_شيء();
    دع وجد_المؤشر: متغير اختيار معرف_عام_مسير = اختيار.لا_شيء();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*المسير).المسير.العوام) مثل غير_موقع)) {
        دع العام: &عام_مسير = &(*المسير).المسير.العوام[ف];
        طابق (*العام).الاسم_الخارجي مع
        | اختيار.بعض(الاسم) -> {
            لو (اسما_عام_خارجي_متساويان_لمسير(&الاسم, &اسم_العدد)) {
                // Each linker-owned startup identity must resolve to exactly
                // one canonical MSIR global. Never choose the last duplicate.
                طابق وجد_العدد مع
                | اختيار.بعض(_) -> { أرجع خطأ; }
                | اختيار.لا_شيء -> { وجد_العدد := اختيار.بعض((*العام).المعرف); };
            };
            لو (اسما_عام_خارجي_متساويان_لمسير(&الاسم, &اسم_المؤشر)) {
                طابق وجد_المؤشر مع
                | اختيار.بعض(_) -> { أرجع خطأ; }
                | اختيار.لا_شيء -> { وجد_المؤشر := اختيار.بعض((*العام).المعرف); };
            };
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    // Materialize argv only when the verified program imports that storage.
    // Defer publishing argc until all argv bytes and the terminating pointer
    // have been validated and placed in interpreter-owned storage.
    طابق وجد_المؤشر مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المعرف) -> {
        دع المؤشرات: متغير متجه قيمة_تشغيل = [];
        ف := 0;
        بينما (ف < العدد) {
            دع البايتات: &متجه غ8 = &(*الوسائط)[ف];
            لو ((الطول(*البايتات) مثل غير_موقع) >= 1048576) { أرجع خطأ; };
            دع الحروف: متغير متجه قيمة_تشغيل = [];
            دع ب: متغير غير_موقع = 0;
            بينما (ب < (الطول(*البايتات) مثل غير_موقع)) {
                لو ((*البايتات)[ب] == (0 مثل غ8)) { أرجع خطأ; };
                ألحق(الحروف, قيمة_تشغيل.بتات_عدد((*البايتات)[ب] مثل غير_موقع));
                ب := ب + 1;
            }
            ألحق(الحروف, قيمة_تشغيل.بتات_عدد(0));
            دع صندوق_حروف: معرف_صندوق_مفسر = خصص_صندوق_مفسر(
                &متغير (*الحالة).الذاكرة, قيمة_تشغيل.تجميع(الحروف)
            );
            دع إسقاط_الحرف_الأول: إسقاط_مكان_تشغيل = إسقاط_مكان_تشغيل.فهرس(0);
            دع إسقاط_الحروف: متجه إسقاط_مكان_تشغيل = [إسقاط_الحرف_الأول];
            دع جذر_الحروف: جذر_مكان_تشغيل = جذر_مكان_تشغيل.صندوق(صندوق_حروف);
            دع مكان_الحروف: مكان_تشغيل = {
                الجذر: جذر_الحروف, الإسقاطات: إسقاط_الحروف, قابل_للكتابة: صواب
            };
            ألحق(المؤشرات, قيمة_تشغيل.مرجع(مكان_الحروف));
            ف := ف + 1;
        }
        // The ABI requires argv[argc] == NULL, including when argc is zero.
        ألحق(المؤشرات, قيمة_تشغيل.مؤشر_فارغ());
        دع صندوق_المؤشرات: معرف_صندوق_مفسر = خصص_صندوق_مفسر(
            &متغير (*الحالة).الذاكرة, قيمة_تشغيل.تجميع(المؤشرات)
        );
        دع إسقاط_المؤشر_الأول: إسقاط_مكان_تشغيل = إسقاط_مكان_تشغيل.فهرس(0);
        دع إسقاط_المؤشر: متجه إسقاط_مكان_تشغيل = [إسقاط_المؤشر_الأول];
        دع جذر_المؤشر: جذر_مكان_تشغيل = جذر_مكان_تشغيل.صندوق(صندوق_المؤشرات);
        دع مكان_المؤشر: مكان_تشغيل = {
            الجذر: جذر_المؤشر, الإسقاطات: إسقاط_المؤشر, قابل_للكتابة: صواب
        };
        لو (!هيئ_عام_مفسر(
            &متغير (*الحالة).الذاكرة, المعرف, قيمة_تشغيل.مرجع(مكان_المؤشر)
        )) { أرجع خطأ; };
    };
    طابق وجد_العدد مع
    | اختيار.بعض(المعرف) -> {
        لو (!هيئ_عام_مفسر(
            &متغير (*الحالة).الذاكرة, المعرف, قيمة_تشغيل.بتات_عدد(العدد)
        )) { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عام عرف عدد_أطر_مفسر(الحالة: &حالة_تنفيذ_مفسر): غير_موقع {
    أرجع (*الحالة).عمق_المكدس;
}

عام عرف اقرأ_الإطار_النشط(الحالة: &حالة_تنفيذ_مفسر): نتيجة_إطار_نشط {
    دع العدد: غير_موقع = (*الحالة).عمق_المكدس;
    لو (العدد == 0) {
        أرجع نتيجة_إطار_نشط.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    أرجع نتيجة_إطار_نشط.موجود(العدد - 1);
}

عام عرف ادفع_إطار_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الإطار: إطار_تفسير_مسير
): منطقي {
    دع الموضع: غير_موقع = (*الحالة).عمق_المكدس;
    دع المنقول: متغير إطار_تفسير_مسير = الإطار;
    لو (الموضع < (الطول((*الحالة).المكدس) مثل غير_موقع)) {
        بدّل((*الحالة).المكدس[الموضع], المنقول);
    } وإلا {
        ألحق((*الحالة).المكدس, المنقول);
    };
    (*الحالة).عمق_المكدس := الموضع + 1;
    أرجع صواب;
}

عام نوع نتيجة_سحب_إطار =
    | مسحوب بنوع إطار_تفسير_مسير
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف اسحب_إطار_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): نتيجة_سحب_إطار {
    دع العدد: غير_موقع = (*الحالة).عمق_المكدس;
    لو (العدد == 0) {
        أرجع نتيجة_سحب_إطار.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    دع الأخير: غير_موقع = العدد - 1;
    دع الدالة_الحارسة: معرف_دالة_مسير = (*الحالة).المكدس[الأخير].الدالة;
    دع الكتلة_الحارسة: معرف_كتلة_مسير = (*الحالة).المكدس[الأخير].الكتلة;
    دع التفعيل_الحارس: معرف_تفعيل_مفسر = (*الحالة).المكدس[الأخير].التفعيل;
    دع الخانات_الفارغة: متجه خانة_تنفيذ_مسير = [];
    دع المحليات_الفارغة: متجه اختيار قيمة_تشغيل = [];
    دع المسحوب: متغير إطار_تفسير_مسير = {
        التفعيل: التفعيل_الحارس,
        الدالة: الدالة_الحارسة,
        الكتلة: الكتلة_الحارسة,
        مؤشر_التعليمة: 0,
        الخانات: الخانات_الفارغة,
        المحليات: المحليات_الفارغة,
        الإغلاق: اختيار.لا_شيء(),
        الاستمرار: اختيار.لا_شيء()
    };
    بدّل((*الحالة).المكدس[الأخير], المسحوب);
    (*الحالة).عمق_المكدس := الأخير;
    أرجع نتيجة_سحب_إطار.مسحوب(المسحوب);
}

عام عرف خذ_معرف_تفعيل_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): معرف_تفعيل_مفسر {
    دع المعرف: معرف_تفعيل_مفسر = معرف_تفعيل_مفسر_من((*الحالة).التفعيل_التالي);
    (*الحالة).التفعيل_التالي := (*الحالة).التفعيل_التالي + 1;
    أرجع المعرف;
}
