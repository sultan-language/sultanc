استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_consumer;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.memory.memory;
استورد compiler.interpreter.runtime_failures;

عام نوع حالة_تنفيذ_مفسر = {
    المكدس: متجه إطار_تفسير_مسير,
    عمق_المكدس: غير_موقع,
    الذاكرة: ذاكرة_مفسر,
    التفعيل_التالي: غير_موقع,
    وسائط_البرنامج: متجه متجه غ8,
    // Lazy per-function index: Value ID -> source place ID when the value is defined by load.
    // It is derived once from canonical MSIR and reused by release; it owns no new semantics.
    مصادر_تحميل_القيم: متجه متجه اختيار معرف_قيمة_مسير,
    مصادر_تحميل_مهيأة: متجه منطقي
};

// The active-frame query returns the live stack position, not a copied frame.
عام نوع نتيجة_إطار_نشط =
    | موجود بنوع غير_موقع
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف حالة_تنفيذ_مفسر_جديدة(وسائط_البرنامج: متجه متجه غ8): حالة_تنفيذ_مفسر {
    دع المكدس: متجه إطار_تفسير_مسير = [];
    دع الذاكرة: ذاكرة_مفسر = ذاكرة_مفسر_جديدة();
    دع مصادر_تحميل_القيم: متجه متجه اختيار معرف_قيمة_مسير = [];
    دع مصادر_تحميل_مهيأة: متجه منطقي = [];
    دع الحالة: حالة_تنفيذ_مفسر = {
        المكدس: المكدس,
        عمق_المكدس: 0,
        الذاكرة: الذاكرة,
        التفعيل_التالي: 0,
        وسائط_البرنامج: وسائط_البرنامج,
        مصادر_تحميل_القيم: مصادر_تحميل_القيم,
        مصادر_تحميل_مهيأة: مصادر_تحميل_مهيأة
    };
    أرجع الحالة;
}

عرف هيئ_مصادر_تحميل_دالة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الدالة: معرف_دالة_مسير
): منطقي {
    بينما ((الطول((*الحالة).مصادر_تحميل_القيم) مثل غير_موقع) <= الدالة.القيمة) {
        دع فارغ: متجه اختيار معرف_قيمة_مسير = [];
        ألحق((*الحالة).مصادر_تحميل_القيم, فارغ);
        ألحق((*الحالة).مصادر_تحميل_مهيأة, خطأ);
    }
    لو ((*الحالة).مصادر_تحميل_مهيأة[الدالة.القيمة]) {
        أرجع صواب;
    };

    دع عدد_القيم: غير_موقع;
    طابق عدد_قيم_دالة_مسير(المسير, الدالة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(العدد) -> { عدد_القيم := العدد; };

    دع المصادر: متغير متجه اختيار معرف_قيمة_مسير = [];
    دع ق: متغير غير_موقع = 0;
    بينما (ق < عدد_القيم) {
        ألحق(المصادر, اختيار.لا_شيء());
        ق := ق + 1;
    }

    دع عدد_الكتل: غير_موقع;
    طابق ابحث_دالة_مسير(المسير, الدالة) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع خطأ; }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> { عدد_الكتل := العرض.عدد_الكتل; };

    دع ك: متغير غير_موقع = 0;
    بينما (ك < عدد_الكتل) {
        دع الكتلة: معرف_كتلة_مسير;
        طابق معرف_كتلة_مسير_عند(المسير, الدالة, ك) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(المعرف) -> { الكتلة := المعرف; };

        دع عدد_التعليمات: غير_موقع;
        طابق ابحث_كتلة_مسير(المسير, الكتلة) مع
        | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع خطأ; }
        | نتيجة_بحث_كتلة_مسير.موجودة(العرض) -> {
            عدد_التعليمات := العرض.عدد_التعليمات;
        };

        دع ت: متغير غير_موقع = 0;
        بينما (ت < عدد_التعليمات) {
            طابق تعليمة_مسير_عند(المسير, الكتلة, ت) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(التعليمة) -> {
                طابق التعليمة.الناتج مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(الناتج) -> {
                    لو (الناتج.القيمة < عدد_القيم) {
                        طابق التعليمة.العملية مع
                        | عملية_مسير.تحميل(التحميل) -> {
                            المصادر[الناتج.القيمة] := اختيار.بعض(التحميل.المكان);
                        }
                        | _ -> { };
                    };
                };
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }

    (*الحالة).مصادر_تحميل_القيم[الدالة.القيمة] := المصادر;
    (*الحالة).مصادر_تحميل_مهيأة[الدالة.القيمة] := صواب;
    أرجع صواب;
}

عام عرف مصدر_تحميل_قيمة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار معرف_قيمة_مسير {
    لو (!هيئ_مصادر_تحميل_دالة_مفسر(الحالة, المسير, المعرف.الدالة)) {
        أرجع اختيار.لا_شيء();
    };
    لو (المعرف.القيمة >= (الطول((*الحالة).مصادر_تحميل_القيم[المعرف.الدالة.القيمة]) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع (*الحالة).مصادر_تحميل_القيم[المعرف.الدالة.القيمة][المعرف.القيمة];
}

عام عرف عدد_وسائط_برنامج_مفسر(الحالة: &حالة_تنفيذ_مفسر): غير_موقع {
    أرجع الطول((*الحالة).وسائط_البرنامج) مثل غير_موقع;
}

عام عرف اقرأ_وسيط_برنامج_مفسر(
    الحالة: &حالة_تنفيذ_مفسر,
    الفهرس: غير_موقع
): اختيار متجه غ8 {
    لو (الفهرس >= (الطول((*الحالة).وسائط_البرنامج) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع النسخة: متغير متجه غ8 = [];
    دع العدد: غير_موقع = الطول((*الحالة).وسائط_البرنامج[الفهرس]) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(النسخة, (*الحالة).وسائط_البرنامج[الفهرس][ف]);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(النسخة);
}

عام عرف عدد_أطر_مفسر(الحالة: &حالة_تنفيذ_مفسر): غير_موقع {
    أرجع (*الحالة).عمق_المكدس;
}

عام عرف اقرأ_الإطار_النشط(الحالة: &حالة_تنفيذ_مفسر): نتيجة_إطار_نشط {
    دع العدد: غير_موقع = (*الحالة).عمق_المكدس;
    لو (العدد == 0) {
        أرجع نتيجة_إطار_نشط.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    أرجع نتيجة_إطار_نشط.موجود(العدد - 1);
}

عام عرف ادفع_إطار_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الإطار: إطار_تفسير_مسير
): منطقي {
    دع الموضع: غير_موقع = (*الحالة).عمق_المكدس;
    دع المنقول: متغير إطار_تفسير_مسير = الإطار;
    لو (الموضع < (الطول((*الحالة).المكدس) مثل غير_موقع)) {
        بدّل((*الحالة).المكدس[الموضع], المنقول);
    } وإلا {
        ألحق((*الحالة).المكدس, المنقول);
    };
    (*الحالة).عمق_المكدس := الموضع + 1;
    أرجع صواب;
}

عام نوع نتيجة_سحب_إطار =
    | مسحوب بنوع إطار_تفسير_مسير
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف اسحب_إطار_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): نتيجة_سحب_إطار {
    دع العدد: غير_موقع = (*الحالة).عمق_المكدس;
    لو (العدد == 0) {
        أرجع نتيجة_سحب_إطار.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    دع الأخير: غير_موقع = العدد - 1;
    دع الدالة_الحارسة: معرف_دالة_مسير = (*الحالة).المكدس[الأخير].الدالة;
    دع الكتلة_الحارسة: معرف_كتلة_مسير = (*الحالة).المكدس[الأخير].الكتلة;
    دع التفعيل_الحارس: معرف_تفعيل_مفسر = (*الحالة).المكدس[الأخير].التفعيل;
    دع الخانات_الفارغة: متجه خانة_تنفيذ_مسير = [];
    دع المحليات_الفارغة: متجه اختيار قيمة_تشغيل = [];
    دع المسحوب: متغير إطار_تفسير_مسير = {
        التفعيل: التفعيل_الحارس,
        الدالة: الدالة_الحارسة,
        الكتلة: الكتلة_الحارسة,
        مؤشر_التعليمة: 0,
        الخانات: الخانات_الفارغة,
        المحليات: المحليات_الفارغة,
        الإغلاق: اختيار.لا_شيء(),
        الاستمرار: اختيار.لا_شيء()
    };
    بدّل((*الحالة).المكدس[الأخير], المسحوب);
    (*الحالة).عمق_المكدس := الأخير;
    أرجع نتيجة_سحب_إطار.مسحوب(المسحوب);
}

عام عرف خذ_معرف_تفعيل_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): معرف_تفعيل_مفسر {
    دع المعرف: معرف_تفعيل_مفسر = معرف_تفعيل_مفسر_من((*الحالة).التفعيل_التالي);
    (*الحالة).التفعيل_التالي := (*الحالة).التفعيل_التالي + 1;
    أرجع المعرف;
}
