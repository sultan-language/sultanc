عام نوع حالة_تنفيذ_مفسر = {
    الهدف: واصف_هدف,
    المكدس: متجه إطار_تفسير_مسير,
    عمق_المكدس: طبيعي,
    الذاكرة: ذاكرة_مفسر,
    التفعيل_التالي: طبيعي,
    // One interpreter, with optional bounded and effect-restricted CTFE.
    نمط_تقييم_مسبق: منطقي,
    تعليمات_متبقية: طبيعي,
    // The whole budget: the evaluation's, as a comptime_budget call reset it.
    حد_التعليمات_الكلي: طبيعي,
    حد_أطر_وقت_الترجمة: طبيعي,
    // Lazy per-function index: Value ID -> source place ID when the value is defined by load.
    // It is derived once from canonical MSIR and reused by release; it owns no new semantics.
    مصادر_تحميل_القيم: متجه متجه اختياري معرف_قيمة_مسير,
    مصادر_تحميل_مهيأة: متجه منطقي,
    // فهرس مشتق ومؤجل لفروع switch، بمفاتيح (دالة، كتلة).
    // الحالات وحوافها باقية في MSIR؛ لا ننسخها أو نغير دلالات البرنامج.
    فهارس_الفروع_المتعددة: متجه متجه فهرس_فرع_متعدد_مفسر,
    // Interned literal text: one static buffer per (function, value) of a
    // text constant, made on its first evaluation, as a native executable
    // keeps one copy of each literal's bytes.
    ثوابت_النصوص: متجه متجه اختياري معرف_مخزن_مفسر,
    // The program's argv (path first), for hosts where std reads the
    // command line through a foreign call (Windows GetCommandLineW).
    وسائط_البرنامج: متجه متجه ط8,
    // Per-function facts derived once (واصف_دالة_مفسر), by function ID.
    واصفات_الدوال: متجه واصف_دالة_مفسر,
    // Staging for the operands of an edge with several arguments, reused by
    // every edge (only the first العدد entries of an edge are live).
    حجج_الحواف: متجه قيمة_تشغيل,
    // The foreign-call bridge's dynamic symbols (host_dynamic.sn): the
    // host's loader, the libraries opened by name, and the address found for
    // each extern by its ID (0 until it is first called). Each library is
    // opened and each function found once, as ctypes keeps a CDLL handle
    // and caches its function pointers.
    المحمل_الديناميكي: محمل_ديناميكي_مضيف,
    المكتبات_المفتوحة: متجه مكتبة_مفتوحة_مفسر,
    عناوين_الخارجيات: متجه ط64,
    // The places a program read as integer addresses (`p as u64`), in the
    // order first read: place k is address قاعدة_عناوين_الأماكن_مفسر() + 16 k.
    // The checked interpreter's storage has no addresses; these stand for
    // them, distinct and stable, and an address read back as a pointer
    // (`a as *T`) names its place again.
    عناوين_الأماكن: متجه مكان_تشغيل,
    // Handles of the libraries `run` loaded (-l), in command-line order
    // (load_libraries.sn): searched for an extern before the global scope.
    مقابض_المكتبات: متجه ط64
};

// The first address of a place read as an integer: nonzero, 16-byte aligned,
// above every address std's allocator reserves on a 64-bit host.
عام عرف قاعدة_عناوين_الأماكن_مفسر(): طبيعي { أرجع 0x00007E0000000000; }

// The integer address of المكان, given on its first read.
عام عرف عنوان_مكان_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر, المكان: &مكان_تشغيل): طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).عناوين_الأماكن) مثل طبيعي)) {
        إذا (مكانا_تخزين_متطابقان(&(*الحالة).عناوين_الأماكن[ف], المكان)) {
            أرجع قاعدة_عناوين_الأماكن_مفسر() + ف * 16;
        };
        ف := ف + 1;
    }
    ألحق((*الحالة).عناوين_الأماكن, انسخ_مكان_تشغيل(المكان));
    أرجع قاعدة_عناوين_الأماكن_مفسر() + ف * 16;
}

// The place an integer address names, if عنوان_مكان_مفسر gave it.
عام عرف مكان_عنوان_مفسر(الحالة: &حالة_تنفيذ_مفسر, العنوان: طبيعي): اختياري مكان_تشغيل {
    إذا (العنوان < قاعدة_عناوين_الأماكن_مفسر() || ((العنوان - قاعدة_عناوين_الأماكن_مفسر()) % 16) != 0) {
        أرجع اختياري.لا_شيء();
    };
    دع ف: طبيعي = (العنوان - قاعدة_عناوين_الأماكن_مفسر()) / 16;
    إذا (ف >= (الطول((*الحالة).عناوين_الأماكن) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_مكان_تشغيل(&(*الحالة).عناوين_الأماكن[ف]));
}

// A library the bridge opened: its name as declared and the loader's handle.
عام نوع مكتبة_مفتوحة_مفسر = {
    الاسم: متجه ط8,
    المقبض: ط64
};

// What the interpreter needs of a function on every call and every operand
// read, derived once from the verified program, as CPython keeps it in a
// code object and Lua in a Proto: the slot count, the entry block, the
// parameter Value IDs, and one numeric descriptor per Value resolved from
// its Type through the registry (وصف_رقمي_لنوع_مفسر) instead of on every
// read. صالح is false when the program lacks something a call needs; the
// call then takes the checked path, which reports what is missing.
عام نوع واصف_دالة_مفسر = {
    مهيأ: منطقي,
    صالح: منطقي,
    عدد_الخانات: طبيعي,
    المدخل: معرف_كتلة_مسير,
    المعاملات: متجه طبيعي,
    الأوصاف: متجه طبيعي
};

// The numeric descriptor of a Type: width * 8 + signed * 4 + kind for a
// number, kind 1 for an integer of 1 to 64 bits, 2 for a character, 3 for a
// 32- or 64-bit float; 4 for a shared reference and 12 for a mutable one
// (kind 0); 0 for any other Type.
عام عرف وصف_رقمي_لنوع_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): طبيعي {
    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(_) -> { أرجع 12; }
    | اختياري.لا_شيء -> { };
    طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(_) -> { أرجع 4; }
    | اختياري.لا_شيء -> { };
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع 0; }
    | اختياري.موجود(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
            إذا (الصنف == صنف_نوع_بدائي.عدد_موقع() || الصنف == صنف_نوع_بدائي.عدد_صحيح_طبيعي()) {
                إذا (البتات == 0 || البتات > 64) { أرجع 0; };
                دع الإشارة: متغير طبيعي = 0;
                إذا (هل_نوع_بدائي_موقع(البدائي)) { الإشارة := 4; };
                أرجع البتات * 8 + الإشارة + 1;
            };
            إذا (البدائي == نوع_بدائي_مقنن.حرف()) {
                إذا (البتات == 0 || البتات > 64) { أرجع 0; };
                أرجع البتات * 8 + 2;
            };
            إذا (الصنف == صنف_نوع_بدائي.عشري()) {
                إذا (البتات != 32 && البتات != 64) { أرجع 0; };
                أرجع البتات * 8 + 3;
            };
            أرجع 0;
        }
        | _ -> { أرجع 0; };
    };
}

// Builds the descriptor of الدالة on its first call.
عام عرف هيئ_واصف_دالة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    الدالة: معرف_دالة_مسير
): منطقي {
    دع الموضع: طبيعي = الدالة.القيمة;
    إذا (الموضع < (الطول((*الحالة).واصفات_الدوال) مثل طبيعي)) {
        إذا ((*الحالة).واصفات_الدوال[الموضع].مهيأ) {
            أرجع (*الحالة).واصفات_الدوال[الموضع].صالح;
        };
    };
    طالما ((الطول((*الحالة).واصفات_الدوال) مثل طبيعي) <= الموضع) {
        دع بلا_معاملات: متجه طبيعي = [];
        دع بلا_أوصاف: متجه طبيعي = [];
        دع الفارغ: واصف_دالة_مفسر = {
            مهيأ: خطأ,
            صالح: خطأ,
            عدد_الخانات: 0,
            المدخل: معرف_كتلة_مسير_من(الدالة, 0),
            المعاملات: بلا_معاملات,
            الأوصاف: بلا_أوصاف
        };
        ألحق((*الحالة).واصفات_الدوال, الفارغ);
    }
    دع المعاملات: متغير متجه طبيعي = [];
    دع الأوصاف: متغير متجه طبيعي = [];
    دع صالح: متغير منطقي = خطأ;
    دع المدخل: متغير معرف_كتلة_مسير = معرف_كتلة_مسير_من(الدالة, 0);
    دع الدوال: &متجه دالة_مسير = &(*المسير).المسير.الدوال;
    إذا (الموضع < (الطول(*الدوال) مثل طبيعي)) {
        دع مرجع_الدالة: &دالة_مسير = &(*الدوال)[الموضع];
        دع معرف_محفوظ: طبيعي = (*مرجع_الدالة).المعرف.القيمة;
        طابق (*مرجع_الدالة).المدخل مع
        | اختياري.موجود(الكتلة) -> {
            المدخل := الكتلة;
            صالح := معرف_محفوظ == الموضع;
        }
        | اختياري.لا_شيء -> { };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_الدالة).المعاملات) مثل طبيعي)) {
            دع معرف_المعامل: معرف_قيمة_مسير = (*مرجع_الدالة).المعاملات[ف].المعرف;
            إذا ((معرف_المعامل.الدالة.القيمة مثل طبيعي) != الموضع) { صالح := خطأ; };
            ألحق(المعاملات, معرف_المعامل.القيمة);
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول((*مرجع_الدالة).القيم) مثل طبيعي)) {
            دع النوع: معرف_نوع = (*مرجع_الدالة).القيم[ف].النوع;
            ألحق(الأوصاف, وصف_رقمي_لنوع_مفسر(الأنواع, النوع));
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
            إذا (المعاملات[ف] >= (الطول(الأوصاف) مثل طبيعي)) { صالح := خطأ; };
            ف := ف + 1;
        }
    };
    دع عدد_الخانات: طبيعي = الطول(الأوصاف) مثل طبيعي;
    دع الواصف: واصف_دالة_مفسر = {
        مهيأ: صواب,
        صالح: صالح,
        عدد_الخانات: عدد_الخانات,
        المدخل: المدخل,
        المعاملات: المعاملات,
        الأوصاف: الأوصاف
    };
    (*الحالة).واصفات_الدوال[الموضع] := الواصف;
    أرجع صالح;
}

// The numeric descriptor of المعرف's Type (0 when its function has no
// descriptor yet or the Value is not a number).
عام عرف وصف_رقمي_لقيمة_مفسر(
    الحالة: &حالة_تنفيذ_مفسر,
    المعرف: معرف_قيمة_مسير
): طبيعي {
    دع الواصفات: &متجه واصف_دالة_مفسر = &(*الحالة).واصفات_الدوال;
    إذا ((المعرف.الدالة.القيمة مثل طبيعي) >= (الطول(*الواصفات) مثل طبيعي)) { أرجع 0; };
    دع الأوصاف: &متجه طبيعي = &(*الواصفات)[المعرف.الدالة.القيمة].الأوصاف;
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(*الأوصاف) مثل طبيعي)) { أرجع 0; };
    أرجع (*الأوصاف)[المعرف.القيمة];
}

// Derived once per (function, block) from the verified switch: a table
// indexed by tag - الأدنى when the tags are dense (at least 10% of their
// range, LLVM's jump-table density), otherwise the tags sorted for binary
// search. Previously only switches dense from tag zero were indexed and every
// other switch scanned its cases linearly.
عام نوع فهرس_فرع_متعدد_مفسر = {
    مهيأ: منطقي,
    كثيف: منطقي,
    الأدنى: طبيعي,
    // Dense: case index of tag الأدنى + i.
    الجدول: متجه اختياري طبيعي,
    // Sparse: ascending tags and the case index of each.
    الوسوم_المرتبة: متجه طبيعي,
    مواضع_الوسوم: متجه طبيعي
};

عرف فهرس_فرع_متعدد_مفسر_فارغ(): فهرس_فرع_متعدد_مفسر {
    دع الجدول: متجه اختياري طبيعي = [];
    دع الوسوم: متجه طبيعي = [];
    دع المواضع: متجه طبيعي = [];
    دع الفهرس: فهرس_فرع_متعدد_مفسر = {
        مهيأ: خطأ,
        كثيف: خطأ,
        الأدنى: 0,
        الجدول: الجدول,
        الوسوم_المرتبة: الوسوم,
        مواضع_الوسوم: المواضع
    };
    أرجع الفهرس;
}

عرف ابن_فهرس_فرع_متعدد_مفسر(الفرع: &فرع_متعدد_مسير): فهرس_فرع_متعدد_مفسر {
    دع الفهرس: متغير فهرس_فرع_متعدد_مفسر = فهرس_فرع_متعدد_مفسر_فارغ();
    الفهرس.مهيأ := صواب;
    دع العدد: طبيعي = الطول((*الفرع).الحالات) مثل طبيعي;
    إذا (العدد == 0) { أرجع الفهرس; };
    دع الأدنى: متغير طبيعي = (*الفرع).الحالات[0].الوسم;
    دع الأعلى: متغير طبيعي = (*الفرع).الحالات[0].الوسم;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الوسم: طبيعي = (*الفرع).الحالات[ف].الوسم;
        إذا (الوسم < الأدنى) { الأدنى := الوسم; };
        إذا (الوسم > الأعلى) { الأعلى := الوسم; };
        ف := ف + 1;
    }
    دع المدى: طبيعي = الأعلى - الأدنى + 1;
    إذا (العدد * 100 >= المدى * 10) {
        دع موضع: متغير طبيعي = 0;
        طالما (موضع < المدى) {
            ألحق(الفهرس.الجدول, اختياري.لا_شيء());
            موضع := موضع + 1;
        }
        ف := 0;
        طالما (ف < العدد) {
            الفهرس.الجدول[(*الفرع).الحالات[ف].الوسم - الأدنى] := اختياري.موجود(ف);
            ف := ف + 1;
        }
        الفهرس.كثيف := صواب;
        الفهرس.الأدنى := الأدنى;
        أرجع الفهرس;
    };
    // Insertion into ascending order; built once per switch block.
    ف := 0;
    طالما (ف < العدد) {
        دع الوسم: طبيعي = (*الفرع).الحالات[ف].الوسم;
        ألحق(الفهرس.الوسوم_المرتبة, الوسم);
        ألحق(الفهرس.مواضع_الوسوم, ف);
        دع ي: متغير طبيعي = الطول(الفهرس.الوسوم_المرتبة) مثل طبيعي;
        ي := ي - 1;
        طالما (ي > 0 && الفهرس.الوسوم_المرتبة[ي - 1] > الوسم) {
            الفهرس.الوسوم_المرتبة[ي] := الفهرس.الوسوم_المرتبة[ي - 1];
            الفهرس.مواضع_الوسوم[ي] := الفهرس.مواضع_الوسوم[ي - 1];
            ي := ي - 1;
        }
        الفهرس.الوسوم_المرتبة[ي] := الوسم;
        الفهرس.مواضع_الوسوم[ي] := ف;
        ف := ف + 1;
    }
    أرجع الفهرس;
}

// The active-frame query returns the live stack position, not a copied frame.
عام نوع نتيجة_فهرس_فرع_مفسر =
    | افتراضي
    | حالة بنوع طبيعي
;

// Dense switches select in O(1); sparse ones in O(log n) by binary search.
عام عرف ابحث_فهرس_فرع_متعدد_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الكتلة: معرف_كتلة_مسير,
    الفرع: &فرع_متعدد_مسير,
    الوسم: طبيعي
): نتيجة_فهرس_فرع_مفسر {
    دع الدالة: طبيعي = الكتلة.الدالة.القيمة;
    دع الموضع: طبيعي = الكتلة.القيمة;
    طالما ((الطول((*الحالة).فهارس_الفروع_المتعددة) مثل طبيعي) <= الدالة) {
        دع فهارس: متجه فهرس_فرع_متعدد_مفسر = [];
        ألحق((*الحالة).فهارس_الفروع_المتعددة, فهارس);
    }
    طالما ((الطول((*الحالة).فهارس_الفروع_المتعددة[الدالة]) مثل طبيعي) <= الموضع) {
        ألحق((*الحالة).فهارس_الفروع_المتعددة[الدالة], فهرس_فرع_متعدد_مفسر_فارغ());
    }
    إذا (!(*الحالة).فهارس_الفروع_المتعددة[الدالة][الموضع].مهيأ) {
        (*الحالة).فهارس_الفروع_المتعددة[الدالة][الموضع] := ابن_فهرس_فرع_متعدد_مفسر(الفرع);
    };
    دع الفهرس: &فهرس_فرع_متعدد_مفسر = &(*الحالة).فهارس_الفروع_المتعددة[الدالة][الموضع];
    إذا ((*الفهرس).كثيف) {
        إذا (الوسم < (*الفهرس).الأدنى) { أرجع نتيجة_فهرس_فرع_مفسر.افتراضي(); };
        دع الخانة: طبيعي = الوسم - (*الفهرس).الأدنى;
        إذا (الخانة >= (الطول((*الفهرس).الجدول) مثل طبيعي)) {
            أرجع نتيجة_فهرس_فرع_مفسر.افتراضي();
        };
        طابق (*الفهرس).الجدول[الخانة] مع
        | اختياري.موجود(الحالة_المختارة) -> { أرجع نتيجة_فهرس_فرع_مفسر.حالة(الحالة_المختارة); }
        | اختياري.لا_شيء -> { أرجع نتيجة_فهرس_فرع_مفسر.افتراضي(); };
    };
    دع الأسفل: متغير طبيعي = 0;
    دع الأعلى: متغير طبيعي = الطول((*الفهرس).الوسوم_المرتبة) مثل طبيعي;
    طالما (الأسفل < الأعلى) {
        دع الوسط: طبيعي = الأسفل + (الأعلى - الأسفل) / 2;
        دع وسم_الوسط: طبيعي = (*الفهرس).الوسوم_المرتبة[الوسط];
        إذا (وسم_الوسط == الوسم) {
            أرجع نتيجة_فهرس_فرع_مفسر.حالة((*الفهرس).مواضع_الوسوم[الوسط]);
        };
        إذا (وسم_الوسط < الوسم) {
            الأسفل := الوسط + 1;
        } وإلا {
            الأعلى := الوسط;
        };
    }
    أرجع نتيجة_فهرس_فرع_مفسر.افتراضي();
}

عام نوع نتيجة_إطار_نشط =
    | موجود بنوع طبيعي
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف حالة_تنفيذ_مفسر_جديدة(الهدف: واصف_هدف): حالة_تنفيذ_مفسر {
    دع المكدس: متجه إطار_تفسير_مسير = [];
    دع الذاكرة: ذاكرة_مفسر = ذاكرة_مفسر_جديدة();
    دع مصادر_تحميل_القيم: متجه متجه اختياري معرف_قيمة_مسير = [];
    دع مصادر_تحميل_مهيأة: متجه منطقي = [];
    دع فهارس_الفروع_المتعددة: متجه متجه فهرس_فرع_متعدد_مفسر = [];
    دع ثوابت_النصوص: متجه متجه اختياري معرف_مخزن_مفسر = [];
    دع وسائط_البرنامج: متجه متجه ط8 = [];
    دع واصفات_الدوال: متجه واصف_دالة_مفسر = [];
    دع حجج_الحواف: متجه قيمة_تشغيل = [];
    دع المكتبات_المفتوحة: متجه مكتبة_مفتوحة_مفسر = [];
    دع عناوين_الخارجيات: متجه ط64 = [];
    دع الحالة: حالة_تنفيذ_مفسر = {
        الهدف: الهدف,
        المكدس: المكدس,
        عمق_المكدس: 0,
        الذاكرة: الذاكرة,
        التفعيل_التالي: 0,
        نمط_تقييم_مسبق: خطأ,
        تعليمات_متبقية: 0,
        حد_التعليمات_الكلي: 0,
        حد_أطر_وقت_الترجمة: 0,
        مصادر_تحميل_القيم: مصادر_تحميل_القيم,
        مصادر_تحميل_مهيأة: مصادر_تحميل_مهيأة,
        فهارس_الفروع_المتعددة: فهارس_الفروع_المتعددة,
        ثوابت_النصوص: ثوابت_النصوص,
        وسائط_البرنامج: وسائط_البرنامج,
        واصفات_الدوال: واصفات_الدوال,
        حجج_الحواف: حجج_الحواف,
        المحمل_الديناميكي: محمل_ديناميكي_مضيف_جديد(),
        المكتبات_المفتوحة: المكتبات_المفتوحة,
        عناوين_الخارجيات: عناوين_الخارجيات,
        عناوين_الأماكن: [],
        مقابض_المكتبات: []
    };
    أرجع الحالة;
}

عرف هيئ_مصادر_تحميل_دالة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الدالة: معرف_دالة_مسير
): منطقي {
    طالما ((الطول((*الحالة).مصادر_تحميل_القيم) مثل طبيعي) <= (الدالة.القيمة مثل طبيعي)) {
        دع فارغ: متجه اختياري معرف_قيمة_مسير = [];
        ألحق((*الحالة).مصادر_تحميل_القيم, فارغ);
        ألحق((*الحالة).مصادر_تحميل_مهيأة, خطأ);
    }
    إذا ((*الحالة).مصادر_تحميل_مهيأة[الدالة.القيمة]) {
        أرجع صواب;
    };

    دع عدد_القيم: طبيعي;
    طابق عدد_قيم_دالة_مسير(المسير, الدالة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(العدد) -> { عدد_القيم := العدد; };

    دع المصادر: متغير متجه اختياري معرف_قيمة_مسير = [];
    دع ق: متغير طبيعي = 0;
    طالما (ق < عدد_القيم) {
        ألحق(المصادر, اختياري.لا_شيء());
        ق := ق + 1;
    }

    دع عدد_الكتل: طبيعي;
    طابق ابحث_دالة_مسير(المسير, الدالة) مع
    | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { أرجع خطأ; }
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> { عدد_الكتل := العرض.عدد_الكتل; };

    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع الكتلة: معرف_كتلة_مسير;
        طابق معرف_كتلة_مسير_عند(المسير, الدالة, ك) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(المعرف) -> { الكتلة := المعرف; };

        دع عدد_التعليمات: طبيعي;
        طابق ابحث_كتلة_مسير(المسير, الكتلة) مع
        | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> { أرجع خطأ; }
        | نتيجة_بحث_كتلة_مسير.موجودة(العرض) -> {
            عدد_التعليمات := العرض.عدد_التعليمات;
        };

        دع ت: متغير طبيعي = 0;
        طالما (ت < عدد_التعليمات) {
            طابق تعليمة_مسير_عند(المسير, الكتلة, ت) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(التعليمة) -> {
                طابق التعليمة.الناتج مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الناتج) -> {
                    إذا ((الناتج.القيمة مثل طبيعي) < عدد_القيم) {
                        طابق التعليمة.العملية مع
                        | عملية_مسير.تحميل(التحميل) -> {
                            المصادر[الناتج.القيمة] := اختياري.موجود(التحميل.المكان);
                        }
                        | _ -> { };
                    };
                };
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }

    (*الحالة).مصادر_تحميل_القيم[الدالة.القيمة] := المصادر;
    (*الحالة).مصادر_تحميل_مهيأة[الدالة.القيمة] := صواب;
    أرجع صواب;
}

عام عرف مصدر_تحميل_قيمة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري معرف_قيمة_مسير {
    إذا (!هيئ_مصادر_تحميل_دالة_مفسر(الحالة, المسير, المعرف.الدالة)) {
        أرجع اختياري.لا_شيء();
    };
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*الحالة).مصادر_تحميل_القيم[المعرف.الدالة.القيمة]) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع (*الحالة).مصادر_تحميل_القيم[المعرف.الدالة.القيمة][المعرف.القيمة];
}

// The startup environment an interpreted program sees. On a Unix host it is
// the interpreter's own envp, entry for entry, as the program would inherit
// it from an exec (host_environment.sn). Where the host has no startup envp
// the program still sees the language variables of the interpreter's
// environment (SULTANC_LANG, LC_ALL, LC_MESSAGES, LANG) as `NAME=value`
// entries, so it chooses the language of its runtime failures as a compiled
// one does (std.process.failure).
عام عرف مدخلات_بيئة_مفسر(): متجه متجه ط8 {
    طابق بيئة_المضيف_لمفسر() مع
    | اختياري.موجود(البيئة) -> { أرجع البيئة; }
    | اختياري.لا_شيء -> { };
    دع الأسماء: متغير متجه نص = [];
    ألحق(الأسماء, «SULTANC_LANG»);
    ألحق(الأسماء, «LC_ALL»);
    ألحق(الأسماء, «LC_MESSAGES»);
    ألحق(الأسماء, «LANG»);
    دع الناتج: متغير متجه متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
        طابق متغير_بيئة_النظام(&الأسماء[ف]) مع
        | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
            دع المدخل: متغير متجه ط8 = [];
            ألحق_بايتات_نص(&متغير المدخل, انسخ_نص(&الأسماء[ف]));
            ألحق_بايتات_نص(&متغير المدخل, «=»);
            ألحق_بايتات_نص(&متغير المدخل, القيمة);
            ألحق(الناتج, المدخل);
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// A NUL-terminated pointer table of NUL-terminated byte strings in
// interpreter-owned buffers (the argv and envp shape), or لا_شيء for an
// invalid entry.
عرف جدول_سلاسل_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    السلاسل: &متجه متجه ط8
): اختياري قيمة_تشغيل {
    إذا ((الطول(*السلاسل) مثل طبيعي) > 65536) { أرجع اختياري.لا_شيء(); };
    دع المؤشرات: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السلاسل) مثل طبيعي)) {
        دع البايتات: &متجه ط8 = &(*السلاسل)[ف];
        إذا ((الطول(*البايتات) مثل طبيعي) >= 1048576) { أرجع اختياري.لا_شيء(); };
        دع الحروف: متغير متجه ط8 = [];
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(*البايتات) مثل طبيعي)) {
            إذا ((*البايتات)[ب] == (0 مثل ط8)) { أرجع اختياري.لا_شيء(); };
            ألحق(الحروف, (*البايتات)[ب]);
            ب := ب + 1;
        }
        ألحق(الحروف, 0 مثل ط8);
        دع مخزن_الحروف: معرف_مخزن_مفسر = خصص_مخزن_بايتات_مفسر(
            &متغير (*الحالة).الذاكرة, الحروف, خطأ
        );
        ألحق(المؤشرات, قيمة_تشغيل.مرجع(مكان_أول_عنصر_مفسر(مخزن_الحروف)));
        ف := ف + 1;
    }
    // The ABI requires a NULL entry after the last string (argv[argc] too).
    ألحق(المؤشرات, قيمة_تشغيل.مؤشر_فارغ());
    دع مخزن_المؤشرات: معرف_مخزن_مفسر = خصص_مخزن_قيم_مفسر(
        &متغير (*الحالة).الذاكرة, المؤشرات
    );
    أرجع اختياري.موجود(قيمة_تشغيل.مرجع(مكان_أول_عنصر_مفسر(مخزن_المؤشرات)));
}

// A writable place naming element 0 of a buffer (a C pointer to its data).
عام عرف مكان_أول_عنصر_مفسر(المخزن: معرف_مخزن_مفسر): مكان_تشغيل {
    دع الإسقاط: إسقاط_مكان_تشغيل = إسقاط_مكان_تشغيل.فهرس(0);
    دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [الإسقاط];
    دع المكان: مكان_تشغيل = {
        الجذر: جذر_مكان_تشغيل.مخزن(المخزن), الإسقاطات: الإسقاطات, قابل_للكتابة: صواب
    };
    أرجع المكان;
}

// Executable startup data belongs to the canonical MSIR external globals.
// The driver supplies guest argument bytes; the interpreter materializes the
// same argc/argv storage shape the native entry wrapper provides, using its
// existing owned memory and place provenance. Never read the compiler's argv.
// No independent program-argument store survives this initialization.
عام عرف هيئ_وسائط_إقلاع_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الوسائط: &متجه متجه ط8
): منطقي {
    دع العدد: طبيعي = الطول(*الوسائط) مثل طبيعي;
    إذا (العدد > 65536) { أرجع خطأ; };
    دع النسخة: متغير متجه متجه ط8 = [];
    دع م: متغير طبيعي = 0;
    طالما (م < العدد) {
        ألحق(النسخة, انسخ_بايتات(&(*الوسائط)[م]));
        م := م + 1;
    }
    (*الحالة).وسائط_البرنامج := النسخة;

    دع اسم_العدد: متجه ط8 = اسم_عدد_وسائط_إقلاع_أساسي();
    دع اسم_المؤشر: متجه ط8 = اسم_مؤشر_وسائط_إقلاع_أساسي();
    دع اسم_البيئة: متجه ط8 = اسم_مؤشر_بيئة_إقلاع_أساسي();
    دع وجد_العدد: متغير اختياري معرف_عام_مسير = اختياري.لا_شيء();
    دع وجد_المؤشر: متغير اختياري معرف_عام_مسير = اختياري.لا_شيء();
    دع وجدت_البيئة: متغير اختياري معرف_عام_مسير = اختياري.لا_شيء();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المسير).المسير.العوام) مثل طبيعي)) {
        دع العام: &عام_مسير = &(*المسير).المسير.العوام[ف];
        طابق (*العام).الاسم_الخارجي مع
        | اختياري.موجود(الاسم) -> {
            إذا (اسما_عام_خارجي_متساويان_لمسير(&الاسم, &اسم_العدد)) {
                // Each linker-owned startup identity must resolve to exactly
                // one canonical MSIR global. Never choose the last duplicate.
                طابق وجد_العدد مع
                | اختياري.موجود(_) -> { أرجع خطأ; }
                | اختياري.لا_شيء -> { وجد_العدد := اختياري.موجود((*العام).المعرف); };
            };
            إذا (اسما_عام_خارجي_متساويان_لمسير(&الاسم, &اسم_المؤشر)) {
                طابق وجد_المؤشر مع
                | اختياري.موجود(_) -> { أرجع خطأ; }
                | اختياري.لا_شيء -> { وجد_المؤشر := اختياري.موجود((*العام).المعرف); };
            };
            إذا (اسما_عام_خارجي_متساويان_لمسير(&الاسم, &اسم_البيئة)) {
                طابق وجدت_البيئة مع
                | اختياري.موجود(_) -> { أرجع خطأ; }
                | اختياري.لا_شيء -> { وجدت_البيئة := اختياري.موجود((*العام).المعرف); };
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // Materialize argv only when the verified program imports that storage.
    // Publish argc only after every argv string and the terminating pointer
    // are in interpreter-owned storage.
    طابق وجد_المؤشر مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المعرف) -> {
        طابق جدول_سلاسل_مفسر(الحالة, الوسائط) مع
        | اختياري.موجود(الجدول) -> {
            إذا (!هيئ_عام_مفسر(&متغير (*الحالة).الذاكرة, المعرف, الجدول)) { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    };
    طابق وجد_العدد مع
    | اختياري.موجود(المعرف) -> {
        إذا (!هيئ_عام_مفسر(
            &متغير (*الحالة).الذاكرة, المعرف, قيمة_تشغيل.بتات_عدد(العدد)
        )) { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { };
    // envp, likewise only when the program imports it.
    طابق وجدت_البيئة مع
    | اختياري.موجود(المعرف) -> {
        دع المدخلات: متجه متجه ط8 = مدخلات_بيئة_مفسر();
        طابق جدول_سلاسل_مفسر(الحالة, &المدخلات) مع
        | اختياري.موجود(الجدول) -> {
            إذا (!هيئ_عام_مفسر(&متغير (*الحالة).الذاكرة, المعرف, الجدول)) { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

// Fields of the state are read through references to them: reading a field
// through a reference to the whole state would copy the state.
عام عرف عمق_مكدس_مفسر(الحالة: &حالة_تنفيذ_مفسر): طبيعي {
    دع العمق: &طبيعي = &(*الحالة).عمق_المكدس;
    أرجع *العمق;
}

عام عرف نمط_تقييم_مسبق_مفسر(الحالة: &حالة_تنفيذ_مفسر): منطقي {
    دع النمط: &منطقي = &(*الحالة).نمط_تقييم_مسبق;
    أرجع *النمط;
}

عام عرف عدد_أطر_مفسر(الحالة: &حالة_تنفيذ_مفسر): طبيعي {
    أرجع عمق_مكدس_مفسر(الحالة);
}

عام عرف اقرأ_الإطار_النشط(الحالة: &حالة_تنفيذ_مفسر): نتيجة_إطار_نشط {
    دع العدد: طبيعي = عمق_مكدس_مفسر(الحالة);
    إذا (العدد == 0) {
        أرجع نتيجة_إطار_نشط.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    أرجع نتيجة_إطار_نشط.موجود(العدد - 1);
}

عام عرف كتلة_إطار_مفسر(الحالة: &حالة_تنفيذ_مفسر, الموضع: طبيعي): معرف_كتلة_مسير {
    دع الكتلة: &معرف_كتلة_مسير = &(*الحالة).المكدس[الموضع].الكتلة;
    أرجع *الكتلة;
}

عام عرف مؤشر_إطار_مفسر(الحالة: &حالة_تنفيذ_مفسر, الموضع: طبيعي): طبيعي {
    دع المؤشر: &طبيعي = &(*الحالة).المكدس[الموضع].مؤشر_التعليمة;
    أرجع *المؤشر;
}

// Advances the instruction pointer of the frame at الموضع.
عام عرف زد_مؤشر_تعليمة_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر, الموضع: طبيعي): فراغ {
    دع المؤشر: &متغير طبيعي = &متغير (*الحالة).المكدس[الموضع].مؤشر_التعليمة;
    (*المؤشر) := (*المؤشر) + 1;
}

عام عرف ادفع_إطار_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الإطار: إطار_تفسير_مسير
): منطقي {
    دع الموضع: طبيعي = عمق_مكدس_مفسر(الحالة);
    دع المنقول: متغير إطار_تفسير_مسير = الإطار;
    إذا (الموضع < (الطول((*الحالة).المكدس) مثل طبيعي)) {
        بدّل((*الحالة).المكدس[الموضع], المنقول);
    } وإلا {
        ألحق((*الحالة).المكدس, المنقول);
    };
    (*الحالة).عمق_المكدس := الموضع + 1;
    أرجع صواب;
}

عام نوع نتيجة_سحب_إطار =
    | مسحوب بنوع (معرف_دالة_مسير, اختياري استمرار_إرجاع_مفسر)
    | أخفق بنوع فشل_تفسير_مسير
;

// Pops the active frame. Its stack position keeps the frame's slot table
// and local cells for the next activation there (ادخل_إطار_دالة_مفسر), so a
// call allocates nothing once the stack is warm; only the function and the
// return continuation leave with the pop.
عام عرف اسحب_إطار_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): نتيجة_سحب_إطار {
    دع العدد: طبيعي = عمق_مكدس_مفسر(الحالة);
    إذا (العدد == 0) {
        أرجع نتيجة_سحب_إطار.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    دع الأخير: طبيعي = العدد - 1;
    دع الدالة: معرف_دالة_مسير = (*الحالة).المكدس[الأخير].الدالة;
    دع الاستمرار: اختياري استمرار_إرجاع_مفسر = (*الحالة).المكدس[الأخير].الاستمرار;
    (*الحالة).عمق_المكدس := الأخير;
    أرجع نتيجة_سحب_إطار.مسحوب(الدالة, الاستمرار);
}

// Pushes an activation of الدالة, whose descriptor is valid, at the next
// stack position, reusing that position's slot table and local cells. The
// slots keep stale values until written: verified MSIR defines every Value
// before its uses, as a register VM's registers need no clearing. Answers
// the new frame's position.
عام عرف ادخل_إطار_دالة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الدالة: معرف_دالة_مسير,
    الإغلاق: اختياري معرف_إغلاق_مفسر,
    الاستمرار: اختياري استمرار_إرجاع_مفسر
): طبيعي {
    دع التفعيل: معرف_تفعيل_مفسر = خذ_معرف_تفعيل_مفسر(الحالة);
    دع الموضع: طبيعي = عمق_مكدس_مفسر(الحالة);
    دع عدد_الخانات: طبيعي = (*الحالة).واصفات_الدوال[الدالة.القيمة].عدد_الخانات;
    دع المدخل: معرف_كتلة_مسير = (*الحالة).واصفات_الدوال[الدالة.القيمة].المدخل;
    إذا (الموضع >= (الطول((*الحالة).المكدس) مثل طبيعي)) {
        دع الخانات: متجه خانة_تنفيذ_مسير = [];
        دع المحليات: متجه خلية_محلية_مفسر = [];
        دع الجديد: إطار_تفسير_مسير = {
            التفعيل: التفعيل,
            الدالة: الدالة,
            الكتلة: المدخل,
            مؤشر_التعليمة: 0,
            الخانات: الخانات,
            المحليات: المحليات,
            عدد_المحليات: 0,
            الإغلاق: اختياري.لا_شيء(),
            الاستمرار: اختياري.لا_شيء()
        };
        ألحق((*الحالة).المكدس, الجديد);
    };
    (*الحالة).عمق_المكدس := الموضع + 1;
    دع الإطار: &متغير إطار_تفسير_مسير = &متغير (*الحالة).المكدس[الموضع];
    (*الإطار).التفعيل := التفعيل;
    (*الإطار).الدالة := الدالة;
    (*الإطار).الكتلة := المدخل;
    (*الإطار).مؤشر_التعليمة := 0;
    (*الإطار).عدد_المحليات := 0;
    (*الإطار).الإغلاق := الإغلاق;
    (*الإطار).الاستمرار := الاستمرار;
    طالما ((الطول((*الإطار).الخانات) مثل طبيعي) < عدد_الخانات) {
        ألحق((*الإطار).الخانات, خانة_تنفيذ_مسير.غير_مهيأة());
    }
    أرجع الموضع;
}

عام عرف خذ_معرف_تفعيل_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): معرف_تفعيل_مفسر {
    دع التالي: &متغير طبيعي = &متغير (*الحالة).التفعيل_التالي;
    دع المعرف: معرف_تفعيل_مفسر = معرف_تفعيل_مفسر_من(*التالي);
    (*التالي) := (*التالي) + 1;
    أرجع المعرف;
}
