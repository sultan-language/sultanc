استورد compiler.msir.identifiers;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.memory.memory;
استورد compiler.interpreter.diagnostics.runtime_failures;

عام نوع حالة_تنفيذ_مفسر = {
    المكدس: متجه إطار_تفسير_مسير,
    الذاكرة: ذاكرة_مفسر,
    التفعيل_التالي: غير_موقع,
    وسائط_البرنامج: متجه متجه غ8
};

عام نوع نتيجة_إطار_نشط =
    | موجود بنوع إطار_تفسير_مسير
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف حالة_تنفيذ_مفسر_جديدة(وسائط_البرنامج: متجه متجه غ8): حالة_تنفيذ_مفسر {
    دع المكدس: متجه إطار_تفسير_مسير = [];
    دع الذاكرة: ذاكرة_مفسر = ذاكرة_مفسر_جديدة();
    دع الحالة: حالة_تنفيذ_مفسر = {
        المكدس: المكدس,
        الذاكرة: الذاكرة,
        التفعيل_التالي: 0,
        وسائط_البرنامج: وسائط_البرنامج
    };
    أرجع الحالة;
}

عام عرف عدد_وسائط_برنامج_مفسر(الحالة: &حالة_تنفيذ_مفسر): غير_موقع {
    دع القيمة: حالة_تنفيذ_مفسر = *الحالة;
    أرجع الطول(القيمة.وسائط_البرنامج) مثل غير_موقع;
}

عام عرف اقرأ_وسيط_برنامج_مفسر(
    الحالة: &حالة_تنفيذ_مفسر,
    الفهرس: غير_موقع
): اختيار متجه غ8 {
    دع القيمة: حالة_تنفيذ_مفسر = *الحالة;
    لو (الفهرس >= (الطول(القيمة.وسائط_البرنامج) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع النسخة: متغير متجه غ8 = [];
    دع العدد: غير_موقع = الطول(القيمة.وسائط_البرنامج[الفهرس]) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(النسخة, القيمة.وسائط_البرنامج[الفهرس][ف]);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(النسخة);
}

عام عرف عدد_أطر_مفسر(الحالة: &حالة_تنفيذ_مفسر): غير_موقع {
    دع القيمة: حالة_تنفيذ_مفسر = *الحالة;
    أرجع الطول(القيمة.المكدس) مثل غير_موقع;
}

عام عرف اقرأ_الإطار_النشط(الحالة: &حالة_تنفيذ_مفسر): نتيجة_إطار_نشط {
    دع القيمة: حالة_تنفيذ_مفسر = *الحالة;
    دع العدد: غير_موقع = الطول(القيمة.المكدس) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع نتيجة_إطار_نشط.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    دع الأخير: غير_موقع = العدد - 1;
    دع الإطار: إطار_تفسير_مسير = انسخ_إطار_تفسير_مسير(&القيمة.المكدس[الأخير]);
    أرجع نتيجة_إطار_نشط.موجود(الإطار);
}

عام عرف اكتب_الإطار_النشط(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الإطار: إطار_تفسير_مسير
): اختيار فشل_تفسير_مسير {
    دع القيمة: متغير حالة_تنفيذ_مفسر = *الحالة;
    دع العدد: غير_موقع = الطول(القيمة.المكدس) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع اختيار.بعض(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    دع الأخير: غير_موقع = العدد - 1;
    دع النسخة: إطار_تفسير_مسير = انسخ_إطار_تفسير_مسير(&الإطار);
    القيمة.المكدس[الأخير] := النسخة;
    *الحالة := القيمة;
    أرجع اختيار.لا_شيء();
}

عام عرف ادفع_إطار_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الإطار: &إطار_تفسير_مسير
): منطقي {
    دع القيمة: متغير حالة_تنفيذ_مفسر = *الحالة;
    دع النسخة: إطار_تفسير_مسير = انسخ_إطار_تفسير_مسير(الإطار);
    ألحق(القيمة.المكدس, النسخة);
    *الحالة := القيمة;
    أرجع صواب;
}

عام نوع نتيجة_سحب_إطار =
    | مسحوب بنوع إطار_تفسير_مسير
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف اسحب_إطار_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): نتيجة_سحب_إطار {
    دع القيمة: متغير حالة_تنفيذ_مفسر = *الحالة;
    دع العدد: غير_موقع = الطول(القيمة.المكدس) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع نتيجة_سحب_إطار.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    دع الأخير: غير_موقع = العدد - 1;
    دع الإطار: إطار_تفسير_مسير = انسخ_إطار_تفسير_مسير(&القيمة.المكدس[الأخير]);
    دع المكدس_الجديد: متغير متجه إطار_تفسير_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف + 1 < العدد) {
        دع النسخة: إطار_تفسير_مسير = انسخ_إطار_تفسير_مسير(&القيمة.المكدس[ف]);
        ألحق(المكدس_الجديد, النسخة);
        ف := ف + 1;
    }
    القيمة.المكدس := المكدس_الجديد;
    *الحالة := القيمة;
    أرجع نتيجة_سحب_إطار.مسحوب(الإطار);
}

عام عرف خذ_معرف_تفعيل_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): معرف_تفعيل_مفسر {
    دع القيمة: متغير حالة_تنفيذ_مفسر = *الحالة;
    دع المعرف: معرف_تفعيل_مفسر = معرف_تفعيل_مفسر_من(القيمة.التفعيل_التالي);
    القيمة.التفعيل_التالي := القيمة.التفعيل_التالي + 1;
    *الحالة := القيمة;
    أرجع المعرف;
}
