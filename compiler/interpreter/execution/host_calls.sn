// Host operations the interpreter performs for an interpreted program where
// the program's own operation has no interpreter-memory meaning: the shims
// of the host bridge (Miri's term), kept apart from the interpreter's
// semantic memory. Each runs on the host process the interpreter is.

// Flat machine memory (std's allocation provider reads and writes the words
// of the pages it maps). The interpreted program's raw addresses are host
// addresses it obtained from the host kernel (mmap through the raw kernel
// call), so the word is read or written on the host, as the native program
// would; like native code, nothing checks such an address. The interpreter
// reaches the word through /proc/self/mem (pread64/pwrite64 at the address),
// which needs no machine-memory intrinsic in the compiler's own sources (the
// C Stage0 compiles them and has none).
إذا (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد compiler.interpreter.execution.host_kernel_generated;

    عرف أرقام_ذاكرة_ذاتية_مضيف(الفهرس: طبيعي): ط64 {
        // openat, pread64, pwrite64, close
        إذا (معمارية_نواة_المضيف() == 1) {
            إذا (الفهرس == 0) { أرجع 257; };
            إذا (الفهرس == 1) { أرجع 17; };
            إذا (الفهرس == 2) { أرجع 18; };
            أرجع 3;
        };
        إذا (الفهرس == 0) { أرجع 56; };
        إذا (الفهرس == 1) { أرجع 67; };
        إذا (الفهرس == 2) { أرجع 68; };
        أرجع 57;
    }

    // Transfers the 8 bytes of الكلمة at العنوان (write) or into it (read).
    عرف انقل_كلمة_ذاكرة_ذاتية_مضيف(العنوان: ط64, الكلمة: &متغير متجه ط8, كتابة: منطقي): منطقي {
        دع المسار: متغير متجه ط8 = [];
        دع الاسم: نص = «/proc/self/mem»;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الاسم) مثل طبيعي)) { ألحق(المسار, الاسم[ف]); ف := ف + 1; }
        ألحق(المسار, 0 مثل ط8);
        دع ف1: متغير متجه ط8 = [0];
        دع ف3: متغير متجه ط8 = [0];
        دع ف4: متغير متجه ط8 = [0];
        دع ف5: متغير متجه ط8 = [0];
        دع ف6: متغير متجه ط8 = [0];
        دع الواصف: ط64 = نفذ_نداء_نواة_مضيف(
            2, أرقام_ذاكرة_ذاتية_مضيف(0), ~(0 مثل ط64) - 99, 0, 2, 0, 0, 0,
            &متغير ف1, &متغير المسار, &متغير ف3, &متغير ف4, &متغير ف5, &متغير ف6
        );
        إذا (الواصف >= (~(0 مثل ط64)) - 4094) { أرجع خطأ; };
        دع الرقم: متغير ط64 = أرقام_ذاكرة_ذاتية_مضيف(1);
        إذا (كتابة) { الرقم := أرقام_ذاكرة_ذاتية_مضيف(2); };
        دع المنقول: ط64 = نفذ_نداء_نواة_مضيف(
            2, الرقم, الواصف, 0, 8, العنوان, 0, 0,
            &متغير ف1, الكلمة, &متغير ف3, &متغير ف4, &متغير ف5, &متغير ف6
        );
        دع الإغلاق: ط64 = نفذ_نداء_نواة_مضيف(
            0, أرقام_ذاكرة_ذاتية_مضيف(3), الواصف, 0, 0, 0, 0, 0,
            &متغير ف1, &متغير المسار, &متغير ف3, &متغير ف4, &متغير ف5, &متغير ف6
        );
        أرجع المنقول == 8;
    }

    عام عرف اقرأ_ذاكرة_آلة_مضيف(العنوان: ط64): ط64 {
        دع الكلمة: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
        إذا (!انقل_كلمة_ذاكرة_ذاتية_مضيف(العنوان, &متغير الكلمة, خطأ)) { أرجع 0 مثل ط64; };
        دع الناتج: متغير ط64 = 0;
        دع ب: متغير طبيعي = 0;
        طالما (ب < 8) {
            الناتج := الناتج | ((الكلمة[ب] مثل ط64) << ((8 * ب) مثل ط64));
            ب := ب + 1;
        }
        أرجع الناتج;
    }

    عام عرف اكتب_ذاكرة_آلة_مضيف(العنوان: ط64, القيمة: ط64): فراغ {
        دع الكلمة: متغير متجه ط8 = [];
        دع ب: متغير طبيعي = 0;
        طالما (ب < 8) {
            ألحق(الكلمة, ((القيمة >> ((8 * ب) مثل ط64)) & 255) مثل ط8);
            ب := ب + 1;
        }
        دع تم: منطقي = انقل_كلمة_ذاكرة_ذاتية_مضيف(العنوان, &متغير الكلمة, صواب);
    }

    عام عرف ذاكرة_آلة_مضيف_متاحة(): منطقي { أرجع صواب; }
}

إذا (!(الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))) {
    عام عرف اقرأ_ذاكرة_آلة_مضيف(العنوان: ط64): ط64 { أرجع 0 مثل ط64; }
    عام عرف اكتب_ذاكرة_آلة_مضيف(العنوان: ط64, القيمة: ط64): فراغ { }
    عام عرف ذاكرة_آلة_مضيف_متاحة(): منطقي { أرجع خطأ; }
}

// execve(path, argv, envp) with argv and envp as NULL-terminated pointer
// tables of the staged strings: the pointer-graph argument shape no flat
// buffer staging covers. Each string already ends with its NUL byte. The
// call returns only on failure (the raw negative errno).
إذا (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    عام عرف نفذ_تشغيل_برنامج_مضيف(
        الرقم: ط64,
        المسار: &متغير متجه ط8,
        الوسائط: &متغير متجه متجه ط8,
        البيئة: &متغير متجه متجه ط8
    ): ط64 {
        إذا ((الطول(*المسار) مثل طبيعي) == 0) { أرجع ~(0 مثل ط64) - 13; };
        // No string may be added once an address to its data is taken.
        دع مؤشرات_الوسائط: متغير متجه *ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الوسائط) مثل طبيعي)) {
            إذا ((الطول((*الوسائط)[ف]) مثل طبيعي) == 0) { أرجع ~(0 مثل ط64) - 13; };
            ألحق(مؤشرات_الوسائط, &(*الوسائط)[ف][0]);
            ف := ف + 1;
        }
        ألحق(مؤشرات_الوسائط, الفارغ);
        دع مؤشرات_البيئة: متغير متجه *ط8 = [];
        ف := 0;
        طالما (ف < (الطول(*البيئة) مثل طبيعي)) {
            إذا ((الطول((*البيئة)[ف]) مثل طبيعي) == 0) { أرجع ~(0 مثل ط64) - 13; };
            ألحق(مؤشرات_البيئة, &(*البيئة)[ف][0]);
            ف := ف + 1;
        }
        ألحق(مؤشرات_البيئة, الفارغ);
        دع مصفوفة_الوسائط: **ط8 = &مؤشرات_الوسائط[0];
        دع مصفوفة_البيئة: **ط8 = &مؤشرات_البيئة[0];
        دع الناتج: متغير ط64 = 0;
        غير_آمن { الناتج := بدائي_نداء_نواة_خام(
            الرقم, &(*المسار)[0], مصفوفة_الوسائط, مصفوفة_البيئة,
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع الناتج;
    }
}

إذا (!(الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))) {
    عام عرف نفذ_تشغيل_برنامج_مضيف(
        الرقم: ط64,
        المسار: &متغير متجه ط8,
        الوسائط: &متغير متجه متجه ط8,
        البيئة: &متغير متجه متجه ط8
    ): ط64 {
        أرجع ~(0 مثل ط64) - 37;
    }
}
