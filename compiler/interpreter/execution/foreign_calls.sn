استورد std.text.from_bytes;
استورد std.encoding.utf16;
استورد compiler.interpreter.execution.execution_state;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.execution.primitives;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.memory.memory;
استورد compiler.interpreter.runtime_failures;
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.interpreter.execution.host_memory;
استورد compiler.interpreter.execution.host_externs_generated;
استورد compiler.interpreter.execution.host_dynamic;
استورد compiler.interpreter.execution.load_libraries;

// ---- The foreign-call bridge ------------------------------------------------
// An extern call of the interpreted program runs on the host, as Miri runs
// the foreign functions it supports and as libffi/ctypes call a resolved
// symbol. Every argument becomes one word (host_externs_generated.sn spells
// pointer parameters as words):
//   - an integer passes as is (a boolean as 0 or 1), a null pointer as 0;
//   - a pointer into a host region (memory the host returned, memory.sn
//     منطقة_مضيف_مفسر) passes the region's host address, after the mirror's
//     changed bytes are written to the host; the mirror is read back after
//     the call;
//   - a pointer to interpreter storage passes the address of a host block
//     holding a copy of the bytes it designates (integer elements, or a
//     record in its C layout), copied back when the callee changed it;
//   - a pointer to a table of pointers (argv/envp of posix_spawnp) passes a
//     host table of such addresses.
// A pointer result is the argument it aliases (getcwd returns its buffer),
// a known host region, or a new opaque host region. The interpreter keeps
// errno (macOS) / the last-error code (Windows) in a cell of its own that
// it hands to the host before each call and takes back after, so the
// interpreter's own host work between a call and the program's errno read
// cannot change it, as Miri keeps its own errno place.
//
// Functions whose results point into host memory with an extent only their
// contract gives are shims (Miri's term), below: errno, DIR streams,
// getaddrinfo's list, dladdr's strings, a CERT context, the environment
// block, the command line.

// Staging slack after each host copy: a callee that writes a few bytes past
// an undersized buffer overflows the slack, not the interpreter.
عرف هامش_نسخة_مضيف_مفسر(): طبيعي { أرجع 64; }

// A host copy of interpreter storage for one call.
نوع نسخة_مضيف_مفسر = {
    العنوان: ط64,
    الطول: طبيعي,
    الأصلية: متجه ط8,
    // Integer storage: the byte view it was copied from.
    الامتداد: امتداد_بايتات_مفسر,
    // A record: its Type and place.
    نوع_السجل: اختياري معرف_نوع,
    المكان: اختياري مكان_تشغيل,
    // Whether the callee's changes are copied back (not for tables).
    يعاد: منطقي,
    // The argument the copy is for, when it is the argument itself.
    الحجة: اختياري طبيعي
};

نوع تخطيط_سي_مفسر = {
    الحجم: طبيعي,
    المحاذاة: طبيعي
};

// The bridge exists where std calls C functions (Windows, macOS), and on
// 64-bit Linux for a program's own C functions (host_dynamic.sn).
إذا (الهدف.المنصة == «windows» || الهدف.المنصة == «macos» || (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))) {
    // ---- Types ------------------------------------------------------------------

    // Whether النوع is a raw pointer `*T` (or a reference).
    عرف نوع_مؤشر_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختياري.موجود(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.مؤشر -> { أرجع صواب; }
            | صنف_شكل_نوع_دلالي.مرجع -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }

    // Whether النوع is `*متغير T` (or a mutable reference).
    عرف مؤشر_قابل_للكتابة_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
        دع الأساس: معرف_نوع;
        طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
        | اختياري.موجود(المعرف) -> { الأساس := المعرف; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        دع المقنن: &نوع_مقنن = &(*الأنواع).الأنواع[الأساس.القيمة];
        طابق *المقنن مع
        | نوع_مقنن.مؤشر(الداخل) -> {
            طابق معرف_نوع_موجود_عند(الأنواع, الداخل) مع
            | اختياري.موجود(الموجود) -> {
                دع الداخلي: &نوع_مقنن = &(*الأنواع).الأنواع[الموجود.القيمة];
                طابق *الداخلي مع
                | نوع_مقنن.متغير(_) -> { أرجع صواب; }
                | _ -> { أرجع خطأ; };
            }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
        | نوع_مقنن.مرجع(_, المتغير) -> { أرجع المتغير; }
        | _ -> { أرجع خطأ; };
    }

    عرف نوع_سجل_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختياري.موجود(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.سجل -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }

    عرف نوع_منطقي_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختياري.موجود(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.منطقي(); }
            | _ -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }

    عرف حاذ_مفسر(القيمة: طبيعي, المحاذاة: طبيعي): طبيعي {
        إذا (المحاذاة <= 1) { أرجع القيمة; };
        أرجع ((القيمة + المحاذاة - 1) / المحاذاة) * المحاذاة;
    }

    // The C layout of an integer, boolean, pointer or record of those, as the
    // 64-bit host C ABIs lay it out (natural alignment). لا_شيء for any other
    // Type, which has no C counterpart here.
    عرف تخطيط_سي_لنوع_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري تخطيط_سي_مفسر {
        دع العرض: طبيعي = عرض_صحيح_نوع_مفسر(الأنواع, النوع);
        إذا (العرض > 0) {
            دع التخطيط: تخطيط_سي_مفسر = { الحجم: العرض, المحاذاة: العرض };
            أرجع اختياري.موجود(التخطيط);
        };
        إذا (نوع_منطقي_مفسر(الأنواع, النوع)) {
            دع التخطيط: تخطيط_سي_مفسر = { الحجم: 1, المحاذاة: 1 };
            أرجع اختياري.موجود(التخطيط);
        };
        إذا (نوع_مؤشر_مفسر(الأنواع, النوع)) {
            دع التخطيط: تخطيط_سي_مفسر = { الحجم: 8, المحاذاة: 8 };
            أرجع اختياري.موجود(التخطيط);
        };
        إذا (!نوع_سجل_مفسر(الأنواع, النوع)) { أرجع اختياري.لا_شيء(); };
        دع العدد: طبيعي;
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع الحجم: متغير طبيعي = 0;
        دع المحاذاة: متغير طبيعي = 1;
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الحقل) -> {
                طابق تخطيط_سي_لنوع_مفسر(الأنواع, الحقل) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(تخطيط_الحقل) -> {
                    الحجم := حاذ_مفسر(الحجم, تخطيط_الحقل.المحاذاة) + تخطيط_الحقل.الحجم;
                    إذا (تخطيط_الحقل.المحاذاة > المحاذاة) { المحاذاة := تخطيط_الحقل.المحاذاة; };
                };
            };
            ف := ف + 1;
        }
        دع التخطيط: تخطيط_سي_مفسر = { الحجم: حاذ_مفسر(الحجم, المحاذاة), المحاذاة: المحاذاة };
        أرجع اختياري.موجود(التخطيط);
    }

    عرف كلمة_من_بايتات_مفسر(البايتات: &متجه ط8, الإزاحة: طبيعي, العرض: طبيعي): ط64 {
        دع الناتج: متغير ط64 = 0;
        دع ب: متغير طبيعي = 0;
        طالما (ب < العرض && الإزاحة + ب < (الطول(*البايتات) مثل طبيعي)) {
            الناتج := الناتج | (((*البايتات)[الإزاحة + ب] مثل ط64) << ((8 * ب) مثل ط64));
            ب := ب + 1;
        }
        أرجع الناتج;
    }

    عرف ضع_كلمة_في_بايتات_مفسر(البايتات: &متغير متجه ط8, الإزاحة: طبيعي, العرض: طبيعي, القيمة: ط64): فراغ {
        دع ب: متغير طبيعي = 0;
        طالما (ب < العرض) {
            طالما ((الطول(*البايتات) مثل طبيعي) <= الإزاحة + ب) { ألحق(*البايتات, 0); }
            (*البايتات)[الإزاحة + ب] := ((القيمة >> ((8 * ب) مثل ط64)) & 255) مثل ط8;
            ب := ب + 1;
        }
    }

    // A value of النوع read from C-layout bytes at الإزاحة. A pointer member
    // comes back as its raw host address (بتات_عدد); حول_عناوين_مضيف_مفسر maps
    // it to a pointer value.
    عرف فك_سي_مفسر(
        الأنواع: &سجل_أنواع,
        النوع: معرف_نوع,
        البايتات: &متجه ط8,
        الإزاحة: طبيعي
    ): اختياري قيمة_تشغيل {
        دع العرض: طبيعي = عرض_صحيح_نوع_مفسر(الأنواع, النوع);
        إذا (العرض > 0) {
            أرجع اختياري.موجود(قيمة_تشغيل.بتات_عدد(كلمة_من_بايتات_مفسر(البايتات, الإزاحة, العرض) مثل طبيعي));
        };
        إذا (نوع_منطقي_مفسر(الأنواع, النوع)) {
            أرجع اختياري.موجود(قيمة_تشغيل.منطق(كلمة_من_بايتات_مفسر(البايتات, الإزاحة, 1) != 0));
        };
        إذا (نوع_مؤشر_مفسر(الأنواع, النوع)) {
            أرجع اختياري.موجود(قيمة_تشغيل.بتات_عدد(كلمة_من_بايتات_مفسر(البايتات, الإزاحة, 8) مثل طبيعي));
        };
        إذا (!نوع_سجل_مفسر(الأنواع, النوع)) { أرجع اختياري.لا_شيء(); };
        دع العدد: طبيعي;
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع الأعضاء: متغير متجه قيمة_تشغيل = [];
        دع الموضع: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الحقل) -> {
                طابق تخطيط_سي_لنوع_مفسر(الأنواع, الحقل) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(تخطيط_الحقل) -> {
                    الموضع := حاذ_مفسر(الموضع, تخطيط_الحقل.المحاذاة);
                    طابق فك_سي_مفسر(الأنواع, الحقل, البايتات, الإزاحة + الموضع) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(العضو) -> { ألحق(الأعضاء, العضو); };
                    الموضع := الموضع + تخطيط_الحقل.الحجم;
                };
            };
            ف := ف + 1;
        }
        أرجع اختياري.موجود(قيمة_تشغيل.تجميع(الأعضاء));
    }

    // The host word of a pointer value inside a record or table: 0 for null,
    // the host address for a pointer into a host region. A pointer to other
    // interpreter storage has no host address here (لا_شيء).
    عرف عنوان_مؤشر_مضيف_مفسر(الذاكرة: &ذاكرة_مفسر, القيمة: &قيمة_تشغيل): اختياري ط64 {
        طابق *القيمة مع
        | قيمة_تشغيل.مؤشر_فارغ -> { أرجع اختياري.موجود(0 مثل ط64); }
        | قيمة_تشغيل.بتات_عدد(الخام) -> { أرجع اختياري.موجود(الخام مثل ط64); }
        | قيمة_تشغيل.مرجع(المكان) -> { أرجع عنوان_مكان_منطقة_مضيف_مفسر(الذاكرة, &المكان); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }

    // The C-layout bytes of a value of النوع appended at الإزاحة.
    عرف رمز_سي_مفسر(
        الذاكرة: &ذاكرة_مفسر,
        الأنواع: &سجل_أنواع,
        النوع: معرف_نوع,
        القيمة: &قيمة_تشغيل,
        البايتات: &متغير متجه ط8,
        الإزاحة: طبيعي
    ): منطقي {
        دع العرض: طبيعي = عرض_صحيح_نوع_مفسر(الأنواع, النوع);
        إذا (العرض > 0) {
            طابق *القيمة مع
            | قيمة_تشغيل.بتات_عدد(البتات) -> {
                ضع_كلمة_في_بايتات_مفسر(البايتات, الإزاحة, العرض, البتات مثل ط64);
                أرجع صواب;
            }
            | _ -> { أرجع خطأ; };
        };
        إذا (نوع_منطقي_مفسر(الأنواع, النوع)) {
            طابق *القيمة مع
            | قيمة_تشغيل.منطق(الحقيقة) -> {
                دع الكلمة: متغير ط64 = 0;
                إذا (الحقيقة) { الكلمة := 1; };
                ضع_كلمة_في_بايتات_مفسر(البايتات, الإزاحة, 1, الكلمة);
                أرجع صواب;
            }
            | _ -> { أرجع خطأ; };
        };
        إذا (نوع_مؤشر_مفسر(الأنواع, النوع)) {
            طابق عنوان_مؤشر_مضيف_مفسر(الذاكرة, القيمة) مع
            | اختياري.موجود(العنوان) -> {
                ضع_كلمة_في_بايتات_مفسر(البايتات, الإزاحة, 8, العنوان);
                أرجع صواب;
            }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        };
        إذا (!نوع_سجل_مفسر(الأنواع, النوع)) { أرجع خطأ; };
        دع العدد: طبيعي;
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        طابق تخطيط_سي_لنوع_مفسر(الأنواع, النوع) مع
        | اختياري.موجود(الكلي) -> {
            طالما ((الطول(*البايتات) مثل طبيعي) < الإزاحة + الكلي.الحجم) { ألحق(*البايتات, 0); }
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        طابق *القيمة مع
        | قيمة_تشغيل.تجميع(الأعضاء) -> {
            إذا ((الطول(الأعضاء) مثل طبيعي) != العدد) { أرجع خطأ; };
            دع الموضع: متغير طبيعي = 0;
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(الحقل) -> {
                    طابق تخطيط_سي_لنوع_مفسر(الأنواع, الحقل) مع
                    | اختياري.لا_شيء -> { أرجع خطأ; }
                    | اختياري.موجود(تخطيط_الحقل) -> {
                        الموضع := حاذ_مفسر(الموضع, تخطيط_الحقل.المحاذاة);
                        إذا (!رمز_سي_مفسر(الذاكرة, الأنواع, الحقل, &الأعضاء[ف], البايتات, الإزاحة + الموضع)) {
                            أرجع خطأ;
                        };
                        الموضع := الموضع + تخطيط_الحقل.الحجم;
                    };
                };
                ف := ف + 1;
            }
            أرجع صواب;
        }
        | _ -> { أرجع خطأ; };
    }

    // ---- Host regions -----------------------------------------------------------

    // The host address a place into a host region names (its element offset
    // from the region's start), or لا_شيء for any other place.
    عرف عنوان_مكان_منطقة_مضيف_مفسر(الذاكرة: &ذاكرة_مفسر, المكان: &مكان_تشغيل): اختياري ط64 {
        طابق (*المكان).الجذر مع
        | جذر_مكان_تشغيل.مخزن(المعرف) -> {
            طابق منطقة_مضيف_لمخزن_مفسر(الذاكرة, المعرف) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الفهرس) -> {
                دع العدد: طبيعي = الطول((*المكان).الإسقاطات) مثل طبيعي;
                دع العنصر: متغير طبيعي = 0;
                إذا (العدد == 1) {
                    طابق (*المكان).الإسقاطات[0] مع
                    | إسقاط_مكان_تشغيل.فهرس(ف) -> { العنصر := ف; }
                    | _ -> { أرجع اختياري.لا_شيء(); };
                } وإلا إذا (العدد != 0) {
                    أرجع اختياري.لا_شيء();
                };
                دع المنطقة: &منطقة_مضيف_مفسر = &(*الذاكرة).مناطق_المضيف[الفهرس];
                أرجع اختياري.موجود((*المنطقة).العنوان + ((العنصر * (*المنطقة).عرض_العنصر) مثل ط64));
            };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }

    عرف منطقة_مكان_مضيف_مفسر(الذاكرة: &ذاكرة_مفسر, المكان: &مكان_تشغيل): اختياري طبيعي {
        طابق (*المكان).الجذر مع
        | جذر_مكان_تشغيل.مخزن(المعرف) -> { أرجع منطقة_مضيف_لمخزن_مفسر(الذاكرة, المعرف); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }

    // The mirror's bytes in the host layout.
    عرف بايتات_مرآة_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الفهرس: طبيعي
    ): اختياري متجه ط8 {
        دع المخزن: معرف_مخزن_مفسر = (*الحالة).الذاكرة.مناطق_المضيف[الفهرس].المخزن;
        دع العرض: طبيعي = (*الحالة).الذاكرة.مناطق_المضيف[الفهرس].عرض_العنصر;
        طابق (*الحالة).الذاكرة.مناطق_المضيف[الفهرس].نوع_السجل مع
        | اختياري.موجود(السجل) -> {
            دع البايتات: متغير متجه ط8 = [];
            طابق قيم_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيم) -> {
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(القيم) مثل طبيعي)) {
                    إذا (!رمز_سي_مفسر(&(*الحالة).الذاكرة, الأنواع, السجل, &القيم[ف], &متغير البايتات, ف * العرض)) {
                        أرجع اختياري.لا_شيء();
                    };
                    ف := ف + 1;
                }
            };
            أرجع اختياري.موجود(البايتات);
        }
        | اختياري.لا_شيء -> { };
        دع الامتداد: امتداد_بايتات_مفسر = امتداد_بايتات_مفسر.مخزن(المخزن, 0, العرض);
        دع الطول_الكلي: طبيعي = طول_امتداد_بايتات_مفسر(&(*الحالة).الذاكرة, &الامتداد);
        دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
        طابق اقرأ_بايتات_امتداد_مفسر(&(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, &الامتداد, 0, الطول_الكلي) مع
        | نتيجة_نسخ_بايتات_مفسر.بايتات(البايتات) -> { أرجع اختياري.موجود(البايتات); }
        | نتيجة_نسخ_بايتات_مفسر.أخفق(_) -> { أرجع اختياري.لا_شيء(); };
    }

    // Writes a region's changed mirror bytes to the host before a call.
    عرف ادفع_منطقة_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الفهرس: طبيعي
    ): فراغ {
        إذا (!(*الحالة).الذاكرة.مناطق_المضيف[الفهرس].قابلة_للكتابة) { أرجع; };
        طابق بايتات_مرآة_مضيف_مفسر(الحالة, الأنواع, الفهرس) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(البايتات) -> {
            إذا (!بايتات_متساوية_مفسر(&البايتات, &(*الحالة).الذاكرة.مناطق_المضيف[الفهرس].اللقطة)) {
                اكتب_بايتات_مضيف((*الحالة).الذاكرة.مناطق_المضيف[الفهرس].العنوان, &البايتات);
                (*الحالة).الذاكرة.مناطق_المضيف[الفهرس].اللقطة := البايتات;
            };
        };
    }

    // Re-reads a region the callee may have written.
    عرف حدث_منطقة_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الفهرس: طبيعي
    ): فراغ {
        إذا (!(*الحالة).الذاكرة.مناطق_المضيف[الفهرس].حية
            || !(*الحالة).الذاكرة.مناطق_المضيف[الفهرس].قابلة_للكتابة) {
            أرجع;
        };
        دع عدد_البايتات: طبيعي = الطول((*الحالة).الذاكرة.مناطق_المضيف[الفهرس].اللقطة) مثل طبيعي;
        دع البايتات: متجه ط8 = اقرأ_بايتات_مضيف((*الحالة).الذاكرة.مناطق_المضيف[الفهرس].العنوان, عدد_البايتات);
        إذا (بايتات_متساوية_مفسر(&البايتات, &(*الحالة).الذاكرة.مناطق_المضيف[الفهرس].اللقطة)) { أرجع; };
        دع المخزن: معرف_مخزن_مفسر = (*الحالة).الذاكرة.مناطق_المضيف[الفهرس].المخزن;
        دع العرض: طبيعي = (*الحالة).الذاكرة.مناطق_المضيف[الفهرس].عرض_العنصر;
        دع القيم: متغير متجه قيمة_تشغيل = [];
        دع بلا_بايتات: متجه ط8 = [];
        طابق (*الحالة).الذاكرة.مناطق_المضيف[الفهرس].نوع_السجل مع
        | اختياري.موجود(السجل) -> {
            // Record mirrors keep their pointer members (the host does not
            // repoint them through a pointer it was lent); integers refresh.
            طابق قيم_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن) مع
            | اختياري.لا_شيء -> { أرجع; }
            | اختياري.موجود(القديمة) -> {
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(القديمة) مثل طبيعي)) {
                    طابق فك_سي_مفسر(الأنواع, السجل, &البايتات, ف * العرض) مع
                    | اختياري.لا_شيء -> { أرجع; }
                    | اختياري.موجود(الجديدة) -> {
                        ألحق(القيم, ادمج_أعداد_سجل_مفسر(الأنواع, السجل, &القديمة[ف], الجديدة));
                    };
                    ف := ف + 1;
                }
            };
            دع تم: منطقي = استبدل_عناصر_مخزن_مفسر(&متغير (*الحالة).الذاكرة, المخزن, القيم, بلا_بايتات, خطأ);
        }
        | اختياري.لا_شيء -> {
            إذا (العرض == 1) {
                دع بلا_قيم: متجه قيمة_تشغيل = [];
                دع النسخة: متجه ط8 = انسخ_بايتات(&البايتات);
                دع تم: منطقي = استبدل_عناصر_مخزن_مفسر(&متغير (*الحالة).الذاكرة, المخزن, بلا_قيم, النسخة, صواب);
            } وإلا {
                دع ف: متغير طبيعي = 0;
                طالما (ف + العرض <= عدد_البايتات) {
                    ألحق(القيم, قيمة_تشغيل.بتات_عدد(كلمة_من_بايتات_مفسر(&البايتات, ف, العرض) مثل طبيعي));
                    ف := ف + العرض;
                }
                دع تم: منطقي = استبدل_عناصر_مخزن_مفسر(&متغير (*الحالة).الذاكرة, المخزن, القيم, بلا_بايتات, خطأ);
            };
        };
        (*الحالة).الذاكرة.مناطق_المضيف[الفهرس].اللقطة := البايتات;
    }

    // The integer members of الجديدة in the shape of القديمة: pointer members
    // keep their old values.
    عرف ادمج_أعداد_سجل_مفسر(
        الأنواع: &سجل_أنواع,
        النوع: معرف_نوع,
        القديمة: &قيمة_تشغيل,
        الجديدة: قيمة_تشغيل
    ): قيمة_تشغيل {
        إذا (نوع_مؤشر_مفسر(الأنواع, النوع)) { أرجع انسخ_قيمة_تشغيل(القديمة); };
        إذا (!نوع_سجل_مفسر(الأنواع, النوع)) { أرجع الجديدة; };
        طابق *القديمة مع
        | قيمة_تشغيل.تجميع(القديمة_أعضاء) -> {
            طابق الجديدة مع
            | قيمة_تشغيل.تجميع(الجديدة_أعضاء) -> {
                إذا ((الطول(القديمة_أعضاء) مثل طبيعي) != (الطول(الجديدة_أعضاء) مثل طبيعي)) {
                    أرجع انسخ_قيمة_تشغيل(القديمة);
                };
                دع الناتج: متغير متجه قيمة_تشغيل = [];
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(القديمة_أعضاء) مثل طبيعي)) {
                    طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف) مع
                    | اختياري.موجود(الحقل) -> {
                        دع العضو: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الجديدة_أعضاء[ف]);
                        ألحق(الناتج, ادمج_أعداد_سجل_مفسر(الأنواع, الحقل, &القديمة_أعضاء[ف], العضو));
                    }
                    | اختياري.لا_شيء -> { ألحق(الناتج, انسخ_قيمة_تشغيل(&القديمة_أعضاء[ف])); };
                    ف := ف + 1;
                }
                أرجع قيمة_تشغيل.تجميع(الناتج);
            }
            | _ -> { أرجع انسخ_قيمة_تشغيل(القديمة); };
        }
        | _ -> { أرجع الجديدة; };
    }

    عرف مكان_عنصر_مفسر(المخزن: معرف_مخزن_مفسر, الفهرس: طبيعي, قابل_للكتابة: منطقي): مكان_تشغيل {
        دع الإسقاط: إسقاط_مكان_تشغيل = إسقاط_مكان_تشغيل.فهرس(الفهرس);
        دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [الإسقاط];
        دع المكان: مكان_تشغيل = {
            الجذر: جذر_مكان_تشغيل.مخزن(المخزن), الإسقاطات: الإسقاطات, قابل_للكتابة: قابل_للكتابة
        };
        أرجع المكان;
    }

    // A new host region over العدد_البايتات bytes at العنوان, elements of
    // العرض bytes (integers) or of the record النوع_السجل; returns its index.
    // The mirror holds the host's bytes as they are now.
    عرف أنشئ_منطقة_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        العنوان: ط64,
        العرض: طبيعي,
        العدد_البايتات: طبيعي,
        النوع_السجل: اختياري معرف_نوع,
        قابلة_للكتابة: منطقي
    ): طبيعي {
        دع البايتات: متجه ط8 = اقرأ_بايتات_مضيف(العنوان, العدد_البايتات);
        دع المخزن: متغير معرف_مخزن_مفسر = معرف_مخزن_مفسر_من(0, 0);
        طابق النوع_السجل مع
        | اختياري.موجود(السجل) -> {
            دع القيم: متغير متجه قيمة_تشغيل = [];
            دع ف: متغير طبيعي = 0;
            طالما (العرض > 0 && ف + العرض <= العدد_البايتات) {
                طابق فك_سي_مفسر(الأنواع, السجل, &البايتات, ف) مع
                | اختياري.موجود(القيمة) -> { ألحق(القيم, القيمة); }
                | اختياري.لا_شيء -> { };
                ف := ف + العرض;
            }
            المخزن := خصص_مخزن_قيم_مفسر(&متغير (*الحالة).الذاكرة, القيم);
        }
        | اختياري.لا_شيء -> {
            إذا (العرض == 1) {
                المخزن := خصص_مخزن_بايتات_مفسر(&متغير (*الحالة).الذاكرة, انسخ_بايتات(&البايتات), خطأ);
            } وإلا {
                دع القيم: متغير متجه قيمة_تشغيل = [];
                دع ف: متغير طبيعي = 0;
                طالما (العرض > 0 && ف + العرض <= العدد_البايتات) {
                    ألحق(القيم, قيمة_تشغيل.بتات_عدد(كلمة_من_بايتات_مفسر(&البايتات, ف, العرض) مثل طبيعي));
                    ف := ف + العرض;
                }
                المخزن := خصص_مخزن_قيم_مفسر(&متغير (*الحالة).الذاكرة, القيم);
            };
        };
        // A read-only region's mirror is static: a write through it fails as a
        // write to a literal does.
        إذا (!قابلة_للكتابة) {
            (*الحالة).الذاكرة.المخازن[المخزن.القيمة].ثابت := صواب;
        };
        دع العرض_الفعلي: متغير طبيعي = العرض;
        إذا (العرض_الفعلي == 0) { العرض_الفعلي := 1; };
        أرجع سجل_منطقة_مضيف_مفسر(
            &متغير (*الحالة).الذاكرة, المخزن, العنوان, العرض_الفعلي, النوع_السجل, قابلة_للكتابة, البايتات
        );
    }

    // A pointer to element 0 of a region.
    عرف مؤشر_منطقة_مضيف_مفسر(الحالة: &حالة_تنفيذ_مفسر, الفهرس: طبيعي): قيمة_تشغيل {
        دع المنطقة: &منطقة_مضيف_مفسر = &(*الحالة).الذاكرة.مناطق_المضيف[الفهرس];
        أرجع قيمة_تشغيل.مرجع(مكان_عنصر_مفسر((*المنطقة).المخزن, 0, (*المنطقة).قابلة_للكتابة));
    }

    // The pointer value for a host address with no known extent: null, a
    // pointer into a known region, or a new opaque region.
    عرف مؤشر_لعنوان_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        العنوان: ط64,
        قابل_للكتابة: منطقي
    ): قيمة_تشغيل {
        إذا (العنوان == 0) { أرجع قيمة_تشغيل.مؤشر_فارغ(); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الحالة).الذاكرة.مناطق_المضيف) مثل طبيعي)) {
            دع المنطقة: &منطقة_مضيف_مفسر = &(*الحالة).الذاكرة.مناطق_المضيف[ف];
            إذا ((*المنطقة).حية && العنوان >= (*المنطقة).العنوان) {
                دع الإزاحة: طبيعي = (العنوان - (*المنطقة).العنوان) مثل طبيعي;
                دع عدد_البايتات: طبيعي = الطول((*المنطقة).اللقطة) مثل طبيعي;
                إذا ((الإزاحة < عدد_البايتات || الإزاحة == 0) && الإزاحة % (*المنطقة).عرض_العنصر == 0) {
                    أرجع قيمة_تشغيل.مرجع(مكان_عنصر_مفسر(
                        (*المنطقة).المخزن, الإزاحة / (*المنطقة).عرض_العنصر, (*المنطقة).قابلة_للكتابة
                    ));
                };
            };
            ف := ف + 1;
        }
        دع لا_نوع: اختياري معرف_نوع = اختياري.لا_شيء();
        دع الفهرس: طبيعي = أنشئ_منطقة_مضيف_مفسر(الحالة, الأنواع, العنوان, 1, 0, لا_نوع, قابل_للكتابة);
        أرجع مؤشر_منطقة_مضيف_مفسر(الحالة, الفهرس);
    }

    // A NUL-terminated string of العرض-byte units at a host address, copied
    // (with its terminator), read a page at a time so no read crosses into a
    // page past the terminator.
    عرف اقرأ_سلسلة_مضيف_مفسر(العنوان: ط64, العرض: طبيعي, الحد: طبيعي): متجه ط8 {
        دع الناتج: متغير متجه ط8 = [];
        إذا (العنوان == 0 || العرض == 0) { أرجع الناتج; };
        دع الموضع: متغير ط64 = العنوان;
        طالما ((الطول(الناتج) مثل طبيعي) < الحد) {
            دع في_الصفحة: متغير طبيعي = (4096 - (الموضع % 4096)) مثل طبيعي;
            إذا (في_الصفحة > 256) { في_الصفحة := 256; };
            دع القطعة: متجه ط8 = اقرأ_بايتات_مضيف(الموضع, في_الصفحة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(القطعة) مثل طبيعي)) {
                ألحق(الناتج, القطعة[ف]);
                دع عدد_الناتج: طبيعي = الطول(الناتج) مثل طبيعي;
                إذا (عدد_الناتج % العرض == 0) {
                    دع صفر: متغير منطقي = صواب;
                    دع ب: متغير طبيعي = 0;
                    طالما (ب < العرض) {
                        إذا (الناتج[عدد_الناتج - 1 - ب] != 0) { صفر := خطأ; };
                        ب := ب + 1;
                    }
                    إذا (صفر) { أرجع الناتج; };
                };
                ف := ف + 1;
            }
            الموضع := الموضع + (في_الصفحة مثل ط64);
        }
        أرجع الناتج;
    }

    // A new interpreter buffer of a host string's units (with the terminator),
    // and a pointer to its first unit.
    عرف مخزن_نسخة_سلسلة_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        العنوان: ط64,
        العرض: طبيعي
    ): معرف_مخزن_مفسر {
        دع البايتات: متجه ط8 = اقرأ_سلسلة_مضيف_مفسر(العنوان, العرض, 65536);
        إذا (العرض == 1) {
            أرجع خصص_مخزن_بايتات_مفسر(&متغير (*الحالة).الذاكرة, البايتات, خطأ);
        };
        دع القيم: متغير متجه قيمة_تشغيل = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف + العرض <= (الطول(البايتات) مثل طبيعي)) {
            ألحق(القيم, قيمة_تشغيل.بتات_عدد(كلمة_من_بايتات_مفسر(&البايتات, ف, العرض) مثل طبيعي));
            ف := ف + العرض;
        }
        أرجع خصص_مخزن_قيم_مفسر(&متغير (*الحالة).الذاكرة, القيم);
    }

    عرف مؤشر_نسخة_سلسلة_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        العنوان: ط64,
        العرض: طبيعي
    ): قيمة_تشغيل {
        إذا (العنوان == 0) { أرجع قيمة_تشغيل.مؤشر_فارغ(); };
        دع المخزن: معرف_مخزن_مفسر = مخزن_نسخة_سلسلة_مفسر(الحالة, العنوان, العرض);
        أرجع قيمة_تشغيل.مرجع(مكان_عنصر_مفسر(المخزن, 0, صواب));
    }

    // ---- errno / last error ------------------------------------------------------

    // The interpreter's errno cell (one 32-bit integer), made on first use.
    عرف خلية_رقم_الخطأ_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): معرف_مخزن_مفسر {
        طابق (*الحالة).الذاكرة.خلية_رقم_الخطأ مع
        | اختياري.موجود(المعرف) -> {
            إذا (هوية_مخزن_مفسر_صالحة(&(*الحالة).الذاكرة, المعرف)) { أرجع المعرف; };
        }
        | اختياري.لا_شيء -> { };
        دع القيم: متغير متجه قيمة_تشغيل = [];
        ألحق(القيم, قيمة_تشغيل.بتات_عدد(0));
        دع المعرف: معرف_مخزن_مفسر = خصص_مخزن_قيم_مفسر(&متغير (*الحالة).الذاكرة, القيم);
        (*الحالة).الذاكرة.خلية_رقم_الخطأ := اختياري.موجود(المعرف);
        أرجع المعرف;
    }

    عرف قيمة_رقم_الخطأ_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر): ط64 {
        دع الخلية: معرف_مخزن_مفسر = خلية_رقم_الخطأ_مفسر(الحالة);
        طابق اقرأ_عنصر_مخزن_مفسر(&(*الحالة).الذاكرة, الخلية, 0) مع
        | اختياري.موجود(قيمة_تشغيل.بتات_عدد(القيمة)) -> { أرجع (القيمة مثل ط64) & 0xFFFFFFFF; }
        | _ -> { أرجع 0 مثل ط64; };
    }

    عرف اضبط_رقم_الخطأ_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر, القيمة: ط64): فراغ {
        دع الخلية: معرف_مخزن_مفسر = خلية_رقم_الخطأ_مفسر(الحالة);
        دع المكان: مكان_تشغيل = مكان_عنصر_مفسر(الخلية, 0, صواب);
        دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
        دع تم: نتيجة_كتابة_ذاكرة_مفسر = اكتب_مكان_مفسر(
            &متغير (*الحالة).المكدس, العمق, &متغير (*الحالة).الذاكرة, &المكان,
            قيمة_تشغيل.بتات_عدد(((القيمة & 0xFFFFFFFF) مثل طبيعي))
        );
    }

    // One host call through the table, with errno exchanged around it.
    عرف نادي_دالة_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الاسم: &متجه ط8,
        الكلمات: &متجه ط64
    ): اختياري ط64 {
        اضبط_خطأ_مضيف(قيمة_رقم_الخطأ_مفسر(الحالة));
        دع الناتج: اختياري ط64 = نفذ_دالة_خارجية_مضيف(الاسم, الكلمات);
        اضبط_رقم_الخطأ_مفسر(الحالة, اقرأ_خطأ_مضيف());
        أرجع الناتج;
    }

    عرف نادي_باسم_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الاسم: نص,
        الكلمات: &متجه ط64
    ): اختياري ط64 {
        دع البايتات: متجه ط8 = بايتات_من_نص(الاسم);
        أرجع نادي_دالة_مضيف_مفسر(الحالة, &البايتات, الكلمات);
    }

    // ---- Argument marshalling ----------------------------------------------------

    عرف حرر_نسخ_مضيف_مفسر(النسخ: &متجه نسخة_مضيف_مفسر): فراغ {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*النسخ) مثل طبيعي)) {
            حرر_ذاكرة_مضيف((*النسخ)[ف].العنوان);
            ف := ف + 1;
        }
    }

    // A host block holding البايتات (plus slack); 0 when the host has none.
    عرف ضع_في_المضيف_مفسر(البايتات: &متجه ط8): ط64 {
        دع العنوان: ط64 = خصص_ذاكرة_مضيف((الطول(*البايتات) مثل طبيعي) + هامش_نسخة_مضيف_مفسر());
        إذا (العنوان != 0) { اكتب_بايتات_مضيف(العنوان, البايتات); };
        أرجع العنوان;
    }

    // The host word for a pointer to interpreter storage of the pointee Type
    // الداخل: a staged copy of its bytes (recorded in النسخ). لا_شيء when the
    // storage has no byte layout here.
    عرف رتب_مؤشر_بيانات_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        المكان: &مكان_تشغيل,
        الداخل: معرف_نوع,
        يعاد: منطقي,
        الحجة: اختياري طبيعي,
        النسخ: &متغير متجه نسخة_مضيف_مفسر
    ): اختياري ط64 {
        طابق عنوان_مكان_منطقة_مضيف_مفسر(&(*الحالة).الذاكرة, المكان) مع
        | اختياري.موجود(العنوان) -> { أرجع اختياري.موجود(العنوان); }
        | اختياري.لا_شيء -> { };
        دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
        إذا (نوع_سجل_مفسر(الأنواع, الداخل)) {
            دع القيمة: قيمة_تشغيل;
            طابق اقرأ_مكان_مفسر(&(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, المكان) مع
            | نتيجة_قراءة_ذاكرة_مفسر.قيمة(المقروءة) -> { القيمة := المقروءة; }
            | نتيجة_قراءة_ذاكرة_مفسر.أخفق(_) -> { أرجع اختياري.لا_شيء(); };
            دع البايتات: متغير متجه ط8 = [];
            إذا (!رمز_سي_مفسر(&(*الحالة).الذاكرة, الأنواع, الداخل, &القيمة, &متغير البايتات, 0)) {
                أرجع اختياري.لا_شيء();
            };
            دع العنوان: ط64 = ضع_في_المضيف_مفسر(&البايتات);
            إذا (العنوان == 0) { أرجع اختياري.لا_شيء(); };
            دع النسخة: نسخة_مضيف_مفسر = {
                العنوان: العنوان, الطول: الطول(البايتات) مثل طبيعي, الأصلية: البايتات,
                الامتداد: امتداد_بايتات_مفسر.غير_صالح(), نوع_السجل: اختياري.موجود(الداخل),
                المكان: اختياري.موجود(انسخ_مكان_تشغيل(المكان)), يعاد: يعاد, الحجة: الحجة
            };
            ألحق(*النسخ, النسخة);
            أرجع اختياري.موجود(العنوان);
        };
        دع الامتداد: امتداد_بايتات_مفسر = امتداد_بايتات_مكان_مفسر(
            &(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, الأنواع, المكان, الداخل
        );
        دع الطول_الكلي: طبيعي = طول_امتداد_بايتات_مفسر(&(*الحالة).الذاكرة, &الامتداد);
        دع البايتات: متجه ط8;
        طابق اقرأ_بايتات_امتداد_مفسر(&(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, &الامتداد, 0, الطول_الكلي) مع
        | نتيجة_نسخ_بايتات_مفسر.بايتات(المقروءة) -> { البايتات := المقروءة; }
        | نتيجة_نسخ_بايتات_مفسر.أخفق(_) -> {
            // Element 0 of an empty buffer names its start (an empty output
            // buffer): a host block with only the slack.
            إذا (الطول_الكلي != 0) { أرجع اختياري.لا_شيء(); };
            دع بلا_بايتات: متجه ط8 = [];
            البايتات := بلا_بايتات;
        };
        دع العنوان: ط64 = ضع_في_المضيف_مفسر(&البايتات);
        إذا (العنوان == 0) { أرجع اختياري.لا_شيء(); };
        دع النسخة: نسخة_مضيف_مفسر = {
            العنوان: العنوان, الطول: الطول(البايتات) مثل طبيعي, الأصلية: البايتات,
            الامتداد: الامتداد, نوع_السجل: اختياري.لا_شيء(), المكان: اختياري.لا_شيء(),
            يعاد: يعاد, الحجة: الحجة
        };
        ألحق(*النسخ, النسخة);
        أرجع اختياري.موجود(العنوان);
    }

    // The host word for a pointer to a NULL-terminated table of pointers
    // (argv, envp): a host table of the addresses of each pointee's copy.
    عرف رتب_جدول_مؤشرات_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        المكان: &مكان_تشغيل,
        نوع_العنصر: معرف_نوع,
        النسخ: &متغير متجه نسخة_مضيف_مفسر
    ): اختياري ط64 {
        دع الداخل: معرف_نوع;
        طابق نوع_داخل_مؤشر_بنوع_مفسر(الأنواع, نوع_العنصر) مع
        | اختياري.موجود(النوع) -> { الداخل := النوع; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع الموضع: متغير مكان_تشغيل = انسخ_مكان_تشغيل(المكان);
        دع الجدول: متغير متجه ط8 = [];
        دع العدد: متغير طبيعي = 0;
        طالما (العدد < 65536) {
            دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
            دع العنصر: قيمة_تشغيل;
            طابق اقرأ_مكان_مفسر(&(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, &الموضع) مع
            | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> { العنصر := القيمة; }
            | نتيجة_قراءة_ذاكرة_مفسر.أخفق(_) -> { أرجع اختياري.لا_شيء(); };
            دع الكلمة: متغير ط64 = 0;
            دع النهاية: متغير منطقي = خطأ;
            طابق العنصر مع
            | قيمة_تشغيل.مؤشر_فارغ -> { النهاية := صواب; }
            | قيمة_تشغيل.مرجع(مكان_العنصر) -> {
                طابق رتب_مؤشر_بيانات_مفسر(
                    الحالة, الأنواع, &مكان_العنصر, الداخل, خطأ, اختياري.لا_شيء(), النسخ
                ) مع
                | اختياري.موجود(العنوان) -> { الكلمة := العنوان; }
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
            ضع_كلمة_في_بايتات_مفسر(&متغير الجدول, العدد * 8, 8, الكلمة);
            إذا (النهاية) {
                دع العنوان: ط64 = ضع_في_المضيف_مفسر(&الجدول);
                إذا (العنوان == 0) { أرجع اختياري.لا_شيء(); };
                دع النسخة: نسخة_مضيف_مفسر = {
                    العنوان: العنوان, الطول: الطول(الجدول) مثل طبيعي, الأصلية: الجدول,
                    الامتداد: امتداد_بايتات_مفسر.غير_صالح(), نوع_السجل: اختياري.لا_شيء(),
                    المكان: اختياري.لا_شيء(), يعاد: خطأ, الحجة: اختياري.لا_شيء()
                };
                ألحق(*النسخ, النسخة);
                أرجع اختياري.موجود(العنوان);
            };
            دع آخر: طبيعي = الطول(الموضع.الإسقاطات) مثل طبيعي;
            إذا (آخر == 0) { أرجع اختياري.لا_شيء(); };
            طابق الموضع.الإسقاطات[آخر - 1] مع
            | إسقاط_مكان_تشغيل.فهرس(الفهرس) -> {
                الموضع.الإسقاطات[آخر - 1] := إسقاط_مكان_تشغيل.فهرس(الفهرس + 1);
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
            العدد := العدد + 1;
        }
        أرجع اختياري.لا_شيء();
    }

    // The host word of one argument of Type النوع.
    عرف رتب_حجة_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الحجة: &قيمة_تشغيل,
        النوع: معرف_نوع,
        الفهرس: طبيعي,
        النسخ: &متغير متجه نسخة_مضيف_مفسر,
        المناطق: &متغير متجه طبيعي
    ): اختياري ط64 {
        طابق *الحجة مع
        | قيمة_تشغيل.بتات_عدد(القيمة) -> { أرجع اختياري.موجود(القيمة مثل ط64); }
        | قيمة_تشغيل.منطق(الحقيقة) -> {
            إذا (الحقيقة) { أرجع اختياري.موجود(1 مثل ط64); };
            أرجع اختياري.موجود(0 مثل ط64);
        }
        | قيمة_تشغيل.مؤشر_فارغ -> { أرجع اختياري.موجود(0 مثل ط64); }
        | قيمة_تشغيل.مرجع(المكان) -> {
            طابق منطقة_مكان_مضيف_مفسر(&(*الحالة).الذاكرة, &المكان) مع
            | اختياري.موجود(المنطقة) -> {
                ادفع_منطقة_مضيف_مفسر(الحالة, الأنواع, المنطقة);
                ألحق(*المناطق, المنطقة);
                أرجع عنوان_مكان_منطقة_مضيف_مفسر(&(*الحالة).الذاكرة, &المكان);
            }
            | اختياري.لا_شيء -> { };
            دع الداخل: معرف_نوع;
            طابق نوع_داخل_مؤشر_بنوع_مفسر(الأنواع, النوع) مع
            | اختياري.موجود(النوع_الداخل) -> { الداخل := النوع_الداخل; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            إذا (نوع_مؤشر_مفسر(الأنواع, الداخل)) {
                أرجع رتب_جدول_مؤشرات_مفسر(الحالة, الأنواع, &المكان, الداخل, النسخ);
            };
            أرجع رتب_مؤشر_بيانات_مفسر(
                الحالة, الأنواع, &المكان, الداخل, صواب, اختياري.موجود(الفهرس), النسخ
            );
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }

    // Copies back what the callee changed in each staged argument, then frees
    // the host blocks.
    عرف أعد_نسخ_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        النسخ: &متجه نسخة_مضيف_مفسر
    ): اختياري فشل_تفسير_مسير {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*النسخ) مثل طبيعي)) {
            دع النسخة: &نسخة_مضيف_مفسر = &(*النسخ)[ف];
            إذا ((*النسخة).يعاد && (*النسخة).الطول > 0) {
                دع الحالية: متجه ط8 = اقرأ_بايتات_مضيف((*النسخة).العنوان, (*النسخة).الطول);
                إذا (!بايتات_متساوية_مفسر(&الحالية, &(*النسخة).الأصلية)) {
                    دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
                    طابق (*النسخة).نوع_السجل مع
                    | اختياري.موجود(السجل) -> {
                        طابق (*النسخة).المكان مع
                        | اختياري.موجود(المكان) -> {
                            طابق اقرأ_مكان_مفسر(&(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, &المكان) مع
                            | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القديمة) -> {
                                طابق فك_سي_مفسر(الأنواع, السجل, &الحالية, 0) مع
                                | اختياري.موجود(الجديدة) -> {
                                    دع المدموجة: قيمة_تشغيل = ادمج_أعداد_سجل_مفسر(الأنواع, السجل, &القديمة, الجديدة);
                                    طابق اكتب_مكان_مفسر(
                                        &متغير (*الحالة).المكدس, العمق, &متغير (*الحالة).الذاكرة, &المكان, المدموجة
                                    ) مع
                                    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                                    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { };
                                }
                                | اختياري.لا_شيء -> { };
                            }
                            | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> {
                        طابق اكتب_بايتات_امتداد_مفسر(
                            &متغير (*الحالة).المكدس, العمق, &متغير (*الحالة).الذاكرة,
                            &(*النسخة).الامتداد, 0, &الحالية
                        ) مع
                        | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { };
                    };
                };
            };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }

    // The argument of a host-region-freeing extern whose region the host
    // frees: FreeEnvironmentStringsW releases the block it is given.
    عرف حجة_يحررها_المضيف_مفسر(الاسم: &متجه ط8): اختياري طبيعي {
        دع تحرير_البيئة: متجه ط8 = بايتات_من_نص(«FreeEnvironmentStringsW»);
        إذا (بايتات_متساوية_مفسر(الاسم, &تحرير_البيئة)) { أرجع اختياري.موجود(0); };
        أرجع اختياري.لا_شيء();
    }

    // Marshals the arguments, calls the host function, copies back, and maps
    // the result. لا_شيء when an argument has no host form.
    عرف نفذ_نداء_مضيف_عام_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الحجج: &متجه قيمة_تشغيل,
        // The address of a dynamic extern (host_dynamic.sn); لا_شيء for one
        // of the generated table.
        العنوان_الديناميكي: اختياري ط64
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        دع الاسم: &متجه ط8 = &(*الدالة).الاسم;
        دع المعاملات: &متجه معرف_نوع = &(*الدالة).المعاملات;
        دع العدد: طبيعي = الطول(*الحجج) مثل طبيعي;
        إذا (العدد != (الطول(*المعاملات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        دع الكلمات: متغير متجه ط64 = [];
        دع النسخ: متغير متجه نسخة_مضيف_مفسر = [];
        دع المناطق: متغير متجه طبيعي = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق رتب_حجة_مضيف_مفسر(
                الحالة, الأنواع, &(*الحجج)[ف], (*المعاملات)[ف], ف, &متغير النسخ, &متغير المناطق
            ) مع
            | اختياري.موجود(الكلمة) -> { ألحق(الكلمات, الكلمة); }
            | اختياري.لا_شيء -> {
                حرر_نسخ_مضيف_مفسر(&النسخ);
                أرجع اختياري.لا_شيء();
            };
            ف := ف + 1;
        }
        دع الخام: ط64;
        دع ناتج_النداء: متغير اختياري ط64 = اختياري.لا_شيء();
        طابق العنوان_الديناميكي مع
        | اختياري.موجود(العنوان) -> {
            ناتج_النداء := اختياري.موجود(نادي_عنوان_خارجي_مفسر(الحالة, الأنواع, الدالة, العنوان, &الكلمات));
        }
        | اختياري.لا_شيء -> { ناتج_النداء := نادي_دالة_مضيف_مفسر(الحالة, الاسم, &الكلمات); };
        طابق ناتج_النداء مع
        | اختياري.موجود(القيمة) -> { الخام := القيمة; }
        | اختياري.لا_شيء -> {
            حرر_نسخ_مضيف_مفسر(&النسخ);
            أرجع اختياري.لا_شيء();
        };
        طابق أعد_نسخ_مضيف_مفسر(الحالة, الأنواع, &النسخ) مع
        | اختياري.موجود(الخطأ) -> {
            حرر_نسخ_مضيف_مفسر(&النسخ);
            أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ));
        }
        | اختياري.لا_شيء -> { };
        // A pointer result aliasing a staged argument is that argument.
        دع الناتج_المؤشر: متغير اختياري قيمة_تشغيل = اختياري.لا_شيء();
        دع نوع_الناتج: اختياري معرف_نوع = (*الدالة).الناتج;
        طابق نوع_الناتج مع
        | اختياري.موجود(النوع) -> {
            إذا (نوع_مؤشر_مفسر(الأنواع, النوع) && الخام != 0) {
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(النسخ) مثل طبيعي)) {
                    طابق النسخ[م].الحجة مع
                    | اختياري.موجود(فهرس_الحجة) -> {
                        إذا (النسخ[م].العنوان == الخام) {
                            الناتج_المؤشر := اختياري.موجود(انسخ_قيمة_تشغيل(&(*الحجج)[فهرس_الحجة]));
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    م := م + 1;
                }
            };
        }
        | اختياري.لا_شيء -> { };
        حرر_نسخ_مضيف_مفسر(&النسخ);
        ف := 0;
        طالما (ف < (الطول(المناطق) مثل طبيعي)) {
            حدث_منطقة_مضيف_مفسر(الحالة, الأنواع, المناطق[ف]);
            ف := ف + 1;
        }
        طابق حجة_يحررها_المضيف_مفسر(الاسم) مع
        | اختياري.موجود(المحررة) -> {
            إذا (المحررة < العدد) {
                طابق (*الحجج)[المحررة] مع
                | قيمة_تشغيل.مرجع(المكان) -> {
                    طابق منطقة_مكان_مضيف_مفسر(&(*الحالة).الذاكرة, &المكان) مع
                    | اختياري.موجود(المنطقة) -> { حرر_منطقة_مضيف_مفسر(&متغير (*الحالة).الذاكرة, المنطقة); }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        طابق نوع_الناتج مع
        | اختياري.موجود(النوع) -> {
            إذا (نوع_مؤشر_مفسر(الأنواع, النوع)) {
                طابق الناتج_المؤشر مع
                | اختياري.موجود(القيمة) -> {
                    أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(القيمة)));
                }
                | اختياري.لا_شيء -> { };
                دع القيمة: قيمة_تشغيل = مؤشر_لعنوان_مضيف_مفسر(
                    الحالة, الأنواع, الخام, مؤشر_قابل_للكتابة_مفسر(الأنواع, النوع)
                );
                أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(القيمة)));
            };
            // A floating-point result is the bits of the float return
            // register (f32 in its low half).
            طابق صنف_سي_لنوع_مفسر(الأنواع, النوع) مع
            | اختياري.موجود(صنف_سي_مضيف.عائم32) -> {
                أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(
                    اختياري.موجود(قيمة_تشغيل.بتات_عدد((الخام & 0xFFFFFFFF) مثل طبيعي))
                ));
            }
            | اختياري.موجود(صنف_سي_مضيف.عائم64) -> {
                أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(
                    اختياري.موجود(قيمة_تشغيل.بتات_عدد(الخام مثل طبيعي))
                ));
            }
            | _ -> { };
            إذا (عرض_صحيح_نوع_مفسر(الأنواع, النوع) == 0) {
                إذا (نوع_منطقي_مفسر(الأنواع, النوع)) {
                    أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(
                        اختياري.موجود(قيمة_تشغيل.منطق((الخام & 255) != 0))
                    ));
                };
                أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()));
            };
            أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(
                اختياري.موجود(ناتج_خارجي_بعرض_مفسر(الأنواع, النوع, الخام))
            ));
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()));
        };
    }

    // ---- Shims ------------------------------------------------------------------

    عرف عاد_بقيمة_مفسر(القيمة: قيمة_تشغيل): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(القيمة)));
    }

    عرف عاد_بعدد_مفسر(
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الخام: ط64
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        طابق (*الدالة).الناتج مع
        | اختياري.موجود(النوع) -> { أرجع عاد_بقيمة_مفسر(ناتج_خارجي_بعرض_مفسر(الأنواع, النوع, الخام)); }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء())); };
    }

    عرف اسم_يساوي_مفسر(الاسم: &متجه ط8, النص: نص): منطقي {
        دع البايتات: متجه ط8 = بايتات_من_نص(النص);
        أرجع بايتات_متساوية_مفسر(الاسم, &البايتات);
    }

    // Writes القيمة at the place a pointer argument designates.
    عرف اكتب_عبر_حجة_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الحجة: &قيمة_تشغيل,
        القيمة: قيمة_تشغيل
    ): اختياري فشل_تفسير_مسير {
        طابق *الحجة مع
        | قيمة_تشغيل.مرجع(المكان) -> {
            دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
            طابق اكتب_مكان_مفسر(&متغير (*الحالة).المكدس, العمق, &متغير (*الحالة).الذاكرة, &المكان, القيمة) مع
            | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { أرجع اختياري.لا_شيء(); };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }

    // errno (macOS __error) and the last-error code (Windows): the cell.
    عرف بديل_رقم_الخطأ_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الحجج: &متجه قيمة_تشغيل
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        دع الاسم: &متجه ط8 = &(*الدالة).الاسم;
        إذا (اسم_يساوي_مفسر(الاسم, «__error») || اسم_يساوي_مفسر(الاسم, «__errno_location»)) {
            دع الخلية: معرف_مخزن_مفسر = خلية_رقم_الخطأ_مفسر(الحالة);
            أرجع عاد_بقيمة_مفسر(قيمة_تشغيل.مرجع(مكان_عنصر_مفسر(الخلية, 0, صواب)));
        };
        إذا (اسم_يساوي_مفسر(الاسم, «GetLastError») || اسم_يساوي_مفسر(الاسم, «WSAGetLastError»)) {
            أرجع عاد_بعدد_مفسر(الأنواع, الدالة, قيمة_رقم_الخطأ_مفسر(الحالة));
        };
        إذا (اسم_يساوي_مفسر(الاسم, «SetLastError»)) {
            إذا ((الطول(*الحجج) مثل طبيعي) == 1) {
                طابق (*الحجج)[0] مع
                | قيمة_تشغيل.بتات_عدد(القيمة) -> { اضبط_رقم_الخطأ_مفسر(الحالة, القيمة مثل ط64); }
                | _ -> { };
            };
            أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()));
        };
        أرجع اختياري.لا_شيء();
    }

    // GetEnvironmentStringsW: a read-only host region over the block, up to
    // and including the empty string that ends it (at most 1 Mi units).
    عرف بديل_كتلة_البيئة_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        دع بلا_كلمات: متجه ط64 = [];
        دع العنوان: ط64;
        طابق نادي_دالة_مضيف_مفسر(الحالة, &(*الدالة).الاسم, &بلا_كلمات) مع
        | اختياري.موجود(الخام) -> { العنوان := الخام; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        إذا (العنوان == 0) { أرجع عاد_بقيمة_مفسر(قيمة_تشغيل.مؤشر_فارغ()); };
        دع الوحدات: متغير طبيعي = 0;
        دع السابقة_صفر: متغير منطقي = صواب;
        دع منته: متغير منطقي = خطأ;
        دع الموضع: متغير ط64 = العنوان;
        طالما (!منته && الوحدات < 1048576) {
            دع في_الصفحة: طبيعي = (4096 - (الموضع % 4096)) مثل طبيعي;
            دع القطعة: متجه ط8 = اقرأ_بايتات_مضيف(الموضع, في_الصفحة);
            دع ف: متغير طبيعي = 0;
            طالما (!منته && ف + 2 <= (الطول(القطعة) مثل طبيعي)) {
                دع الوحدة: ط64 = كلمة_من_بايتات_مفسر(&القطعة, ف, 2);
                الوحدات := الوحدات + 1;
                إذا (الوحدة == 0) {
                    إذا (السابقة_صفر) { منته := صواب; };
                    السابقة_صفر := صواب;
                } وإلا {
                    السابقة_صفر := خطأ;
                };
                ف := ف + 2;
            }
            الموضع := الموضع + (في_الصفحة مثل ط64);
        }
        دع لا_نوع: اختياري معرف_نوع = اختياري.لا_شيء();
        دع الفهرس: طبيعي = أنشئ_منطقة_مضيف_مفسر(الحالة, الأنواع, العنوان, 2, الوحدات * 2, لا_نوع, خطأ);
        أرجع عاد_بقيمة_مفسر(مؤشر_منطقة_مضيف_مفسر(الحالة, الفهرس));
    }

    // CertEnumCertificatesInStore: frees the previous context's region (the
    // host frees the context), and gives the next context as a read-only
    // record region whose encoded-bytes member points to a region of
    // cbCertEncoded bytes.
    عرف بديل_شهادات_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الحجج: &متجه قيمة_تشغيل
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        إذا ((الطول(*الحجج) مثل طبيعي) != 2) { أرجع اختياري.لا_شيء(); };
        دع الكلمات: متغير متجه ط64 = [];
        طابق (*الحجج)[0] مع
        | قيمة_تشغيل.بتات_عدد(القيمة) -> { ألحق(الكلمات, القيمة مثل ط64); }
        | _ -> { أرجع اختياري.لا_شيء(); };
        دع السابقة: متغير اختياري طبيعي = اختياري.لا_شيء();
        طابق (*الحجج)[1] مع
        | قيمة_تشغيل.مؤشر_فارغ -> { ألحق(الكلمات, 0 مثل ط64); }
        | قيمة_تشغيل.مرجع(المكان) -> {
            طابق عنوان_مكان_منطقة_مضيف_مفسر(&(*الحالة).الذاكرة, &المكان) مع
            | اختياري.موجود(العنوان) -> { ألحق(الكلمات, العنوان); }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            السابقة := منطقة_مكان_مضيف_مفسر(&(*الحالة).الذاكرة, &المكان);
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
        دع السجل: معرف_نوع;
        طابق (*الدالة).الناتج مع
        | اختياري.موجود(النوع) -> {
            طابق نوع_داخل_مؤشر_بنوع_مفسر(الأنواع, النوع) مع
            | اختياري.موجود(الداخل) -> { السجل := الداخل; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع التخطيط: تخطيط_سي_مفسر;
        طابق تخطيط_سي_لنوع_مفسر(الأنواع, السجل) مع
        | اختياري.موجود(ت) -> { التخطيط := ت; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع العنوان: ط64;
        طابق نادي_دالة_مضيف_مفسر(الحالة, &(*الدالة).الاسم, &الكلمات) مع
        | اختياري.موجود(الخام) -> { العنوان := الخام; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        طابق السابقة مع
        | اختياري.موجود(المنطقة) -> { حرر_منطقة_مضيف_مفسر(&متغير (*الحالة).الذاكرة, المنطقة); }
        | اختياري.لا_شيء -> { };
        إذا (العنوان == 0) { أرجع عاد_بقيمة_مفسر(قيمة_تشغيل.مؤشر_فارغ()); };
        // CERT_CONTEXT: dwCertEncodingType, pbCertEncoded, cbCertEncoded,
        // pCertInfo, hCertStore (certificates.sn).
        دع البايتات: متجه ط8 = اقرأ_بايتات_مضيف(العنوان, التخطيط.الحجم);
        دع الأعضاء: متغير متجه قيمة_تشغيل = [];
        طابق فك_سي_مفسر(الأنواع, السجل, &البايتات, 0) مع
        | اختياري.موجود(قيمة_تشغيل.تجميع(المفكوكة)) -> { الأعضاء := المفكوكة; }
        | _ -> { أرجع اختياري.لا_شيء(); };
        إذا ((الطول(الأعضاء) مثل طبيعي) != 5) { أرجع اختياري.لا_شيء(); };
        دع التابعة: متغير متجه طبيعي = [];
        دع عنوان_البيانات: متغير ط64 = 0;
        دع طول_البيانات: متغير طبيعي = 0;
        طابق الأعضاء[1] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> { عنوان_البيانات := الخام مثل ط64; }
        | _ -> { };
        طابق الأعضاء[2] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> { طول_البيانات := الخام; }
        | _ -> { };
        إذا (عنوان_البيانات != 0 && طول_البيانات > 0 && طول_البيانات < 16777216) {
            دع لا_نوع: اختياري معرف_نوع = اختياري.لا_شيء();
            دع منطقة_البيانات: طبيعي = أنشئ_منطقة_مضيف_مفسر(
                الحالة, الأنواع, عنوان_البيانات, 1, طول_البيانات, لا_نوع, خطأ
            );
            ألحق(التابعة, منطقة_البيانات);
            الأعضاء[1] := مؤشر_منطقة_مضيف_مفسر(الحالة, منطقة_البيانات);
        } وإلا {
            الأعضاء[1] := مؤشر_لعنوان_مضيف_مفسر(الحالة, الأنواع, عنوان_البيانات, خطأ);
        };
        طابق الأعضاء[3] مع
        | قيمة_تشغيل.بتات_عدد(الخام) -> {
            دع المعلومات: قيمة_تشغيل = مؤشر_لعنوان_مضيف_مفسر(الحالة, الأنواع, الخام مثل ط64, خطأ);
            الأعضاء[3] := المعلومات;
        }
        | _ -> { };
        // The context region: one record element, read-only.
        دع القيم: متغير متجه قيمة_تشغيل = [];
        ألحق(القيم, قيمة_تشغيل.تجميع(الأعضاء));
        دع المخزن: معرف_مخزن_مفسر = خصص_مخزن_قيم_مفسر(&متغير (*الحالة).الذاكرة, القيم);
        (*الحالة).الذاكرة.المخازن[المخزن.القيمة].ثابت := صواب;
        دع الفهرس: طبيعي = سجل_منطقة_مضيف_مفسر(
            &متغير (*الحالة).الذاكرة, المخزن, العنوان, التخطيط.الحجم, اختياري.موجود(السجل), خطأ, البايتات
        );
        (*الحالة).الذاكرة.مناطق_المضيف[الفهرس].التابعة := التابعة;
        أرجع عاد_بقيمة_مفسر(مؤشر_منطقة_مضيف_مفسر(الحالة, الفهرس));
    }

    // The host address list of getaddrinfo / GetAddrInfoW rebuilt in
    // interpreter memory: one record buffer per node, the canonical name and
    // the socket address copied, ai_next pointing at the next node's buffer.
    // The host list is freed at once; freeaddrinfo / FreeAddrInfoW release the
    // interpreter buffers. Both layouts (Apple <netdb.h>, Winsock ADDRINFOW)
    // order the members flags, family, socktype, protocol, addrlen,
    // canonname, addr, next, and the record Type std declares gives each
    // member's width and offset.
    عرف بديل_حل_عناوين_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الحجج: &متجه قيمة_تشغيل,
        اسم_التحرير: نص
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        إذا ((الطول(*الحجج) مثل طبيعي) != 4 || (الطول((*الدالة).المعاملات) مثل طبيعي) != 4) {
            أرجع اختياري.لا_شيء();
        };
        دع السجل: معرف_نوع;
        طابق نوع_داخل_مؤشر_بنوع_مفسر(الأنواع, (*الدالة).المعاملات[2]) مع
        | اختياري.موجود(الداخل) -> { السجل := الداخل; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع التخطيط: تخطيط_سي_مفسر;
        طابق تخطيط_سي_لنوع_مفسر(الأنواع, السجل) مع
        | اختياري.موجود(ت) -> { التخطيط := ت; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع عرض_الاسم: متغير طبيعي = 1;
        طابق نوع_حقل_سجل_دلالي_عند(الأنواع, السجل, 5) مع
        | اختياري.موجود(الحقل) -> {
            طابق نوع_داخل_مؤشر_بنوع_مفسر(الأنواع, الحقل) مع
            | اختياري.موجود(الوحدة) -> { عرض_الاسم := عرض_صحيح_نوع_مفسر(الأنواع, الوحدة); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        إذا (عرض_الاسم == 0) { عرض_الاسم := 1; };
        دع الكلمات: متغير متجه ط64 = [];
        دع النسخ: متغير متجه نسخة_مضيف_مفسر = [];
        دع المناطق: متغير متجه طبيعي = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < 3) {
            طابق رتب_حجة_مضيف_مفسر(
                الحالة, الأنواع, &(*الحجج)[ف], (*الدالة).المعاملات[ف], ف, &متغير النسخ, &متغير المناطق
            ) مع
            | اختياري.موجود(الكلمة) -> { ألحق(الكلمات, الكلمة); }
            | اختياري.لا_شيء -> { حرر_نسخ_مضيف_مفسر(&النسخ); أرجع اختياري.لا_شيء(); };
            ف := ف + 1;
        }
        دع المخرج: ط64 = خصص_ذاكرة_مضيف(8);
        إذا (المخرج == 0) { حرر_نسخ_مضيف_مفسر(&النسخ); أرجع اختياري.لا_شيء(); };
        ألحق(الكلمات, المخرج);
        دع الحالة_الناتجة: ط64;
        طابق نادي_دالة_مضيف_مفسر(الحالة, &(*الدالة).الاسم, &الكلمات) مع
        | اختياري.موجود(الخام) -> { الحالة_الناتجة := الخام; }
        | اختياري.لا_شيء -> {
            حرر_نسخ_مضيف_مفسر(&النسخ);
            حرر_ذاكرة_مضيف(المخرج);
            أرجع اختياري.لا_شيء();
        };
        حرر_نسخ_مضيف_مفسر(&النسخ);
        دع خلية_الرأس: متجه ط8 = اقرأ_بايتات_مضيف(المخرج, 8);
        حرر_ذاكرة_مضيف(المخرج);
        دع الرأس: ط64 = كلمة_من_بايتات_مفسر(&خلية_الرأس, 0, 8);
        إذا ((الحالة_الناتجة & 0xFFFFFFFF) != 0 || الرأس == 0) {
            أرجع عاد_بعدد_مفسر(الأنواع, الدالة, الحالة_الناتجة);
        };
        // The host nodes, in order.
        دع العقد: متغير متجه متجه قيمة_تشغيل = [];
        دع الحالي: متغير ط64 = الرأس;
        طالما (الحالي != 0 && (الطول(العقد) مثل طبيعي) < 4096) {
            دع البايتات: متجه ط8 = اقرأ_بايتات_مضيف(الحالي, التخطيط.الحجم);
            طابق فك_سي_مفسر(الأنواع, السجل, &البايتات, 0) مع
            | اختياري.موجود(قيمة_تشغيل.تجميع(الأعضاء)) -> {
                إذا ((الطول(الأعضاء) مثل طبيعي) != 8) { الحالي := 0; }
                وإلا {
                    دع التالي: متغير ط64 = 0;
                    طابق الأعضاء[7] مع
                    | قيمة_تشغيل.بتات_عدد(الخام) -> { التالي := الخام مثل ط64; }
                    | _ -> { };
                    ألحق(العقد, الأعضاء);
                    الحالي := التالي;
                };
            }
            | _ -> { الحالي := 0; };
        }
        // Rebuilt from the last node, so each ai_next has its target.
        دع المخازن: متغير متجه معرف_مخزن_مفسر = [];
        دع التالي_المبني: متغير قيمة_تشغيل = قيمة_تشغيل.مؤشر_فارغ();
        دع ع: متغير طبيعي = الطول(العقد) مثل طبيعي;
        طالما (ع > 0) {
            ع := ع - 1;
            دع الأعضاء: متغير متجه قيمة_تشغيل = انسخ_مملوكا_متجه_قيمة_تشغيل(&العقد[ع]);
            دع طول_العنوان: متغير طبيعي = 0;
            طابق الأعضاء[4] مع
            | قيمة_تشغيل.بتات_عدد(الخام) -> { طول_العنوان := الخام; }
            | _ -> { };
            طابق الأعضاء[5] مع
            | قيمة_تشغيل.بتات_عدد(الخام) -> {
                إذا (الخام == 0) {
                    الأعضاء[5] := قيمة_تشغيل.مؤشر_فارغ();
                } وإلا {
                    دع مخزن_الاسم: معرف_مخزن_مفسر = مخزن_نسخة_سلسلة_مفسر(الحالة, الخام مثل ط64, عرض_الاسم);
                    ألحق(المخازن, مخزن_الاسم);
                    الأعضاء[5] := قيمة_تشغيل.مرجع(مكان_عنصر_مفسر(مخزن_الاسم, 0, صواب));
                };
            }
            | _ -> { };
            طابق الأعضاء[6] مع
            | قيمة_تشغيل.بتات_عدد(الخام) -> {
                إذا (الخام == 0 || طول_العنوان == 0 || طول_العنوان > 4096) {
                    الأعضاء[6] := قيمة_تشغيل.مؤشر_فارغ();
                } وإلا {
                    دع العنوان: متجه ط8 = اقرأ_بايتات_مضيف(الخام مثل ط64, طول_العنوان);
                    دع مخزن_العنوان: معرف_مخزن_مفسر = خصص_مخزن_بايتات_مفسر(&متغير (*الحالة).الذاكرة, العنوان, خطأ);
                    ألحق(المخازن, مخزن_العنوان);
                    الأعضاء[6] := قيمة_تشغيل.مرجع(مكان_عنصر_مفسر(مخزن_العنوان, 0, صواب));
                };
            }
            | _ -> { };
            الأعضاء[7] := انسخ_قيمة_تشغيل(&التالي_المبني);
            دع القيم: متغير متجه قيمة_تشغيل = [];
            ألحق(القيم, قيمة_تشغيل.تجميع(الأعضاء));
            دع مخزن_العقدة: معرف_مخزن_مفسر = خصص_مخزن_قيم_مفسر(&متغير (*الحالة).الذاكرة, القيم);
            ألحق(المخازن, مخزن_العقدة);
            التالي_المبني := قيمة_تشغيل.مرجع(مكان_عنصر_مفسر(مخزن_العقدة, 0, صواب));
        }
        // The host list is no longer needed.
        دع كلمات_التحرير: متغير متجه ط64 = [];
        ألحق(كلمات_التحرير, الرأس);
        دع تحرير: اختياري ط64 = نادي_باسم_مضيف_مفسر(الحالة, اسم_التحرير, &كلمات_التحرير);
        // The head's buffer is the last made; the list is recorded head first.
        دع القائمة: متغير متجه معرف_مخزن_مفسر = [];
        دع م: متغير طبيعي = الطول(المخازن) مثل طبيعي;
        طالما (م > 0) { م := م - 1; ألحق(القائمة, المخازن[م]); }
        ألحق((*الحالة).الذاكرة.قوائم_عناوين_المضيف, القائمة);
        طابق اكتب_عبر_حجة_مفسر(الحالة, &(*الحجج)[3], التالي_المبني) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ)); }
        | اختياري.لا_شيء -> { };
        أرجع عاد_بعدد_مفسر(الأنواع, الدالة, الحالة_الناتجة);
    }

    // The address list whose head node is المعرف.
    عرف فهرس_قائمة_عناوين_مفسر(الذاكرة: &ذاكرة_مفسر, المعرف: معرف_مخزن_مفسر): اختياري طبيعي {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الذاكرة).قوائم_عناوين_المضيف) مثل طبيعي)) {
            دع القائمة: &متجه معرف_مخزن_مفسر = &(*الذاكرة).قوائم_عناوين_المضيف[ف];
            إذا ((الطول(*القائمة) مثل طبيعي) > 0
                && (*القائمة)[0].القيمة == المعرف.القيمة && (*القائمة)[0].الجيل == المعرف.الجيل) {
                أرجع اختياري.موجود(ف);
            };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }

    // freeaddrinfo / FreeAddrInfoW of a list the shim built.
    عرف بديل_تحرير_عناوين_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الحجج: &متجه قيمة_تشغيل
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        إذا ((الطول(*الحجج) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
        دع الرأس: معرف_مخزن_مفسر;
        طابق (*الحجج)[0] مع
        | قيمة_تشغيل.مؤشر_فارغ -> { أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء())); }
        | قيمة_تشغيل.مرجع(المكان) -> {
            طابق المكان.الجذر مع
            | جذر_مكان_تشغيل.مخزن(المعرف) -> { الرأس := المعرف; }
            | _ -> { أرجع اختياري.لا_شيء(); };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
        دع الفهرس: طبيعي;
        طابق فهرس_قائمة_عناوين_مفسر(&(*الحالة).الذاكرة, الرأس) مع
        | اختياري.موجود(ف) -> { الفهرس := ف; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع فارغة: متغير متجه معرف_مخزن_مفسر = [];
        بدّل((*الحالة).الذاكرة.قوائم_عناوين_المضيف[الفهرس], فارغة);
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(فارغة) مثل طبيعي)) {
            دع تم: منطقي = حرر_مخزن_مفسر(&متغير (*الحالة).الذاكرة, فارغة[م]);
            م := م + 1;
        }
        أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.لا_شيء()));
    }

    // opendir / readdir / closedir: interpreter DIR streams. readdir copies the
    // host's 64-bit-inode struct dirent (d_ino @0, d_seekoff @8, d_reclen @16,
    // d_namlen @18, d_type @20, d_name @21, the layout directories.sn reads;
    // readdir$INODE64 on x86_64 and readdir on arm64 return it) into a buffer
    // valid until the next readdir or closedir on the stream.
    عرف دليل_للحجة_مفسر(الحالة: &حالة_تنفيذ_مفسر, الحجة: &قيمة_تشغيل): اختياري طبيعي {
        طابق *الحجة مع
        | قيمة_تشغيل.مرجع(المكان) -> {
            طابق المكان.الجذر مع
            | جذر_مكان_تشغيل.مخزن(المعرف) -> {
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول((*الحالة).الذاكرة.أدلة_المضيف) مثل طبيعي)) {
                    دع الدليل: &دليل_مضيف_مفسر = &(*الحالة).الذاكرة.أدلة_المضيف[ف];
                    إذا ((*الدليل).حي && (*الدليل).الرمز.القيمة == المعرف.القيمة
                        && (*الدليل).الرمز.الجيل == المعرف.الجيل) {
                        أرجع اختياري.موجود(ف);
                    };
                    ف := ف + 1;
                }
            }
            | _ -> { };
        }
        | _ -> { };
        أرجع اختياري.لا_شيء();
    }

    عرف حرر_مدخل_دليل_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر, الفهرس: طبيعي): فراغ {
        طابق (*الحالة).الذاكرة.أدلة_المضيف[الفهرس].المدخل مع
        | اختياري.موجود(المدخل) -> { دع تم: منطقي = حرر_مخزن_مفسر(&متغير (*الحالة).الذاكرة, المدخل); }
        | اختياري.لا_شيء -> { };
        (*الحالة).الذاكرة.أدلة_المضيف[الفهرس].المدخل := اختياري.لا_شيء();
    }

    عرف بديل_أدلة_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الحجج: &متجه قيمة_تشغيل
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        دع الاسم: &متجه ط8 = &(*الدالة).الاسم;
        إذا (اسم_يساوي_مفسر(الاسم, «opendir») || اسم_يساوي_مفسر(الاسم, «opendir$INODE64»)) {
            إذا ((الطول(*الحجج) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
            دع النسخ: متغير متجه نسخة_مضيف_مفسر = [];
            دع المناطق: متغير متجه طبيعي = [];
            دع الكلمات: متغير متجه ط64 = [];
            طابق رتب_حجة_مضيف_مفسر(
                الحالة, الأنواع, &(*الحجج)[0], (*الدالة).المعاملات[0], 0, &متغير النسخ, &متغير المناطق
            ) مع
            | اختياري.موجود(الكلمة) -> { ألحق(الكلمات, الكلمة); }
            | اختياري.لا_شيء -> { حرر_نسخ_مضيف_مفسر(&النسخ); أرجع اختياري.لا_شيء(); };
            دع العنوان: ط64;
            طابق نادي_دالة_مضيف_مفسر(الحالة, الاسم, &الكلمات) مع
            | اختياري.موجود(الخام) -> { العنوان := الخام; }
            | اختياري.لا_شيء -> { حرر_نسخ_مضيف_مفسر(&النسخ); أرجع اختياري.لا_شيء(); };
            حرر_نسخ_مضيف_مفسر(&النسخ);
            إذا (العنوان == 0) { أرجع عاد_بقيمة_مفسر(قيمة_تشغيل.مؤشر_فارغ()); };
            دع الرمز_البايتات: متغير متجه ط8 = [];
            ألحق(الرمز_البايتات, 0);
            دع الرمز: معرف_مخزن_مفسر = خصص_مخزن_بايتات_مفسر(&متغير (*الحالة).الذاكرة, الرمز_البايتات, خطأ);
            دع الدليل: دليل_مضيف_مفسر = {
                حي: صواب, الرمز: الرمز, العنوان: العنوان, المدخل: اختياري.لا_شيء()
            };
            ألحق((*الحالة).الذاكرة.أدلة_المضيف, الدليل);
            أرجع عاد_بقيمة_مفسر(قيمة_تشغيل.مرجع(مكان_عنصر_مفسر(الرمز, 0, صواب)));
        };
        إذا (اسم_يساوي_مفسر(الاسم, «readdir») || اسم_يساوي_مفسر(الاسم, «readdir$INODE64»)) {
            إذا ((الطول(*الحجج) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
            دع الفهرس: طبيعي;
            طابق دليل_للحجة_مفسر(الحالة, &(*الحجج)[0]) مع
            | اختياري.موجود(ف) -> { الفهرس := ف; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            دع الكلمات: متغير متجه ط64 = [];
            ألحق(الكلمات, (*الحالة).الذاكرة.أدلة_المضيف[الفهرس].العنوان);
            دع المدخل: ط64;
            طابق نادي_دالة_مضيف_مفسر(الحالة, الاسم, &الكلمات) مع
            | اختياري.موجود(الخام) -> { المدخل := الخام; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            حرر_مدخل_دليل_مفسر(الحالة, الفهرس);
            إذا (المدخل == 0) { أرجع عاد_بقيمة_مفسر(قيمة_تشغيل.مؤشر_فارغ()); };
            دع الرأس: متجه ط8 = اقرأ_بايتات_مضيف(المدخل, 21);
            دع طول_الاسم: متغير طبيعي = كلمة_من_بايتات_مفسر(&الرأس, 18, 2) مثل طبيعي;
            إذا (طول_الاسم > 1024) { طول_الاسم := 1024; };
            دع البايتات: متجه ط8 = اقرأ_بايتات_مضيف(المدخل, 21 + طول_الاسم + 1);
            دع المخزن: معرف_مخزن_مفسر = خصص_مخزن_بايتات_مفسر(&متغير (*الحالة).الذاكرة, البايتات, خطأ);
            (*الحالة).الذاكرة.المخازن[المخزن.القيمة].ثابت := صواب;
            (*الحالة).الذاكرة.أدلة_المضيف[الفهرس].المدخل := اختياري.موجود(المخزن);
            أرجع عاد_بقيمة_مفسر(قيمة_تشغيل.مرجع(مكان_عنصر_مفسر(المخزن, 0, خطأ)));
        };
        إذا (اسم_يساوي_مفسر(الاسم, «closedir»)) {
            إذا ((الطول(*الحجج) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
            دع الفهرس: طبيعي;
            طابق دليل_للحجة_مفسر(الحالة, &(*الحجج)[0]) مع
            | اختياري.موجود(ف) -> { الفهرس := ف; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            دع الكلمات: متغير متجه ط64 = [];
            ألحق(الكلمات, (*الحالة).الذاكرة.أدلة_المضيف[الفهرس].العنوان);
            دع الناتج: ط64;
            طابق نادي_دالة_مضيف_مفسر(الحالة, الاسم, &الكلمات) مع
            | اختياري.موجود(الخام) -> { الناتج := الخام; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            حرر_مدخل_دليل_مفسر(الحالة, الفهرس);
            دع الرمز: معرف_مخزن_مفسر = (*الحالة).الذاكرة.أدلة_المضيف[الفهرس].الرمز;
            دع تم: منطقي = حرر_مخزن_مفسر(&متغير (*الحالة).الذاكرة, الرمز);
            (*الحالة).الذاكرة.أدلة_المضيف[الفهرس].حي := خطأ;
            أرجع عاد_بعدد_مفسر(الأنواع, الدالة, الناتج);
        };
        أرجع اختياري.لا_شيء();
    }

    // dladdr: for an address in a host region, the host's answer with the
    // image and symbol names copied into interpreter buffers; an address of
    // interpreter storage is in no image (0), as for memory dladdr does not
    // know.
    عرف بديل_معلومات_عنوان_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الحجج: &متجه قيمة_تشغيل
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        إذا ((الطول(*الحجج) مثل طبيعي) != 2) { أرجع اختياري.لا_شيء(); };
        دع العنوان: ط64;
        طابق عنوان_مؤشر_مضيف_مفسر(&(*الحالة).الذاكرة, &(*الحجج)[0]) مع
        | اختياري.موجود(ع) -> { العنوان := ع; }
        | اختياري.لا_شيء -> { أرجع عاد_بعدد_مفسر(الأنواع, الدالة, 0 مثل ط64); };
        دع المعلومات: ط64 = خصص_ذاكرة_مضيف(32);
        إذا (المعلومات == 0) { أرجع اختياري.لا_شيء(); };
        دع الكلمات: متغير متجه ط64 = [];
        ألحق(الكلمات, العنوان);
        ألحق(الكلمات, المعلومات);
        دع الناتج: ط64;
        طابق نادي_دالة_مضيف_مفسر(الحالة, &(*الدالة).الاسم, &الكلمات) مع
        | اختياري.موجود(الخام) -> { الناتج := الخام; }
        | اختياري.لا_شيء -> { حرر_ذاكرة_مضيف(المعلومات); أرجع اختياري.لا_شيء(); };
        دع البايتات: متجه ط8 = اقرأ_بايتات_مضيف(المعلومات, 32);
        حرر_ذاكرة_مضيف(المعلومات);
        إذا ((الناتج & 0xFFFFFFFF) != 0) {
            // Dl_info: dli_fname, dli_fbase, dli_sname, dli_saddr.
            دع الأعضاء: متغير متجه قيمة_تشغيل = [];
            ألحق(الأعضاء, مؤشر_نسخة_سلسلة_مفسر(الحالة, كلمة_من_بايتات_مفسر(&البايتات, 0, 8), 1));
            ألحق(الأعضاء, مؤشر_لعنوان_مضيف_مفسر(الحالة, الأنواع, كلمة_من_بايتات_مفسر(&البايتات, 8, 8), خطأ));
            ألحق(الأعضاء, مؤشر_نسخة_سلسلة_مفسر(الحالة, كلمة_من_بايتات_مفسر(&البايتات, 16, 8), 1));
            ألحق(الأعضاء, مؤشر_لعنوان_مضيف_مفسر(الحالة, الأنواع, كلمة_من_بايتات_مفسر(&البايتات, 24, 8), خطأ));
            طابق اكتب_عبر_حجة_مفسر(الحالة, &(*الحجج)[1], قيمة_تشغيل.تجميع(الأعضاء)) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ)); }
            | اختياري.لا_شيء -> { };
        };
        أرجع عاد_بعدد_مفسر(الأنواع, الدالة, الناتج);
    }

    // A new buffer of UTF-16 units ending in a zero unit, and a pointer to it.
    عرف مؤشر_نص_عريض_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        البايتات: &متجه ط8
    ): قيمة_تشغيل {
        دع الوحدات: متغير متجه قيمة_تشغيل = [];
        دع النص: نص = من_بايتات(البايتات);
        طابق نص_إلى_يوتيف16(&النص) مع
        | نتيجة.نجح(الترميز) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الترميز) مثل طبيعي)) {
                ألحق(الوحدات, قيمة_تشغيل.بتات_عدد(الترميز[ف] مثل طبيعي));
                ف := ف + 1;
            }
        }
        | نتيجة.خطأ(_) -> { };
        ألحق(الوحدات, قيمة_تشغيل.بتات_عدد(0));
        دع المخزن: معرف_مخزن_مفسر = خصص_مخزن_قيم_مفسر(&متغير (*الحالة).الذاكرة, الوحدات);
        أرجع قيمة_تشغيل.مرجع(مكان_أول_عنصر_مفسر(المخزن));
    }

    // Windows argv quoting (the rule std's spawn uses) of one argument.
    عرف ألحق_وسيطة_مقتبسة_مفسر(السطر: &متغير متجه ط8, الوسيطة: &متجه ط8): فراغ {
        ألحق(*السطر, 0x22 مثل ط8);
        دع الشرطات: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الوسيطة) مثل طبيعي)) {
            دع البايت: ط8 = (*الوسيطة)[ف];
            إذا (البايت == (0x5C مثل ط8)) {
                الشرطات := الشرطات + 1;
            } وإلا إذا (البايت == (0x22 مثل ط8)) {
                دع م: متغير طبيعي = 0;
                طالما (م < الشرطات + 1) { ألحق(*السطر, 0x5C مثل ط8); م := م + 1; }
                الشرطات := 0;
            } وإلا {
                الشرطات := 0;
            };
            ألحق(*السطر, البايت);
            ف := ف + 1;
        }
        دع م: متغير طبيعي = 0;
        طالما (م < الشرطات) { ألحق(*السطر, 0x5C مثل ط8); م := م + 1; }
        ألحق(*السطر, 0x22 مثل ط8);
    }

    // The command line std reads at startup (Windows): the interpreted
    // program's own arguments, as the native process would see them.
    عرف نفذ_بديل_خارجي_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الاسم: &متجه ط8,
        الحجج: &متجه قيمة_تشغيل
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        دع اسم_سطر_الأوامر: متجه ط8 = بايتات_من_نص(«GetCommandLineW»);
        دع اسم_تقسيم_السطر: متجه ط8 = بايتات_من_نص(«CommandLineToArgvW»);
        دع اسم_تحرير_محلي: متجه ط8 = بايتات_من_نص(«LocalFree»);
        إذا (بايتات_متساوية_مفسر(الاسم, &اسم_سطر_الأوامر)) {
            دع السطر: متغير متجه ط8 = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الحالة).وسائط_البرنامج) مثل طبيعي)) {
                إذا (ف > 0) { ألحق(السطر, 0x20 مثل ط8); };
                دع الوسيطة: متجه ط8 = انسخ_بايتات(&(*الحالة).وسائط_البرنامج[ف]);
                ألحق_وسيطة_مقتبسة_مفسر(&متغير السطر, &الوسيطة);
                ف := ف + 1;
            }
            أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(
                اختياري.موجود(مؤشر_نص_عريض_مفسر(الحالة, &السطر))
            ));
        };
        إذا (بايتات_متساوية_مفسر(الاسم, &اسم_تقسيم_السطر)) {
            دع المؤشرات: متغير متجه قيمة_تشغيل = [];
            دع العدد: طبيعي = الطول((*الحالة).وسائط_البرنامج) مثل طبيعي;
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                دع الوسيطة: متجه ط8 = انسخ_بايتات(&(*الحالة).وسائط_البرنامج[ف]);
                ألحق(المؤشرات, مؤشر_نص_عريض_مفسر(الحالة, &الوسيطة));
                ف := ف + 1;
            }
            ألحق(المؤشرات, قيمة_تشغيل.مؤشر_فارغ());
            دع الجدول: معرف_مخزن_مفسر = خصص_مخزن_قيم_مفسر(&متغير (*الحالة).الذاكرة, المؤشرات);
            // The count goes through the second argument.
            إذا ((الطول(*الحجج) مثل طبيعي) == 2) {
                طابق (*الحجج)[1] مع
                | قيمة_تشغيل.مرجع(مكان_العدد) -> {
                    دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
                    طابق اكتب_مكان_مفسر(
                        &متغير (*الحالة).المكدس, العمق, &متغير (*الحالة).الذاكرة,
                        &مكان_العدد, قيمة_تشغيل.بتات_عدد(العدد)
                    ) مع
                    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
                        أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.أخفق(الخطأ));
                    }
                    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> { };
                }
                | _ -> { };
            };
            أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(
                اختياري.موجود(قيمة_تشغيل.مرجع(مكان_أول_عنصر_مفسر(الجدول)))
            ));
        };
        إذا (بايتات_متساوية_مفسر(الاسم, &اسم_تحرير_محلي)) {
            // The table is interpreter storage; LocalFree succeeds with NULL.
            أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.عاد(اختياري.موجود(قيمة_تشغيل.مؤشر_فارغ())));
        };
        أرجع اختياري.لا_شيء();
    }

    // The shims, by extern link name: لا_شيء when الاسم is not shimmed.
    عرف نفذ_بديل_مضيف_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الحجج: &متجه قيمة_تشغيل
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        دع الاسم: &متجه ط8 = &(*الدالة).الاسم;
        // On Linux the bridge calls only a program's own functions: errno is
        // the one shim (glibc's and musl's __errno_location).
        إذا (!بدائل_المكتبة_القياسية_مفسر()) {
            أرجع بديل_رقم_الخطأ_مفسر(الحالة, الأنواع, الدالة, الحجج);
        };
        // The command line std reads at startup.
        طابق نفذ_بديل_خارجي_مفسر(الحالة, الاسم, الحجج) مع
        | اختياري.موجود(الناتج) -> { أرجع اختياري.موجود(الناتج); }
        | اختياري.لا_شيء -> { };
        إذا (!ذاكرة_مضيف_متاحة()) { أرجع اختياري.لا_شيء(); };
        طابق بديل_رقم_الخطأ_مفسر(الحالة, الأنواع, الدالة, الحجج) مع
        | اختياري.موجود(الناتج) -> { أرجع اختياري.موجود(الناتج); }
        | اختياري.لا_شيء -> { };
        طابق بديل_أدلة_مفسر(الحالة, الأنواع, الدالة, الحجج) مع
        | اختياري.موجود(الناتج) -> { أرجع اختياري.موجود(الناتج); }
        | اختياري.لا_شيء -> { };
        إذا (اسم_يساوي_مفسر(الاسم, «GetEnvironmentStringsW»)) {
            أرجع بديل_كتلة_البيئة_مفسر(الحالة, الأنواع, الدالة);
        };
        إذا (اسم_يساوي_مفسر(الاسم, «CertEnumCertificatesInStore»)) {
            أرجع بديل_شهادات_مفسر(الحالة, الأنواع, الدالة, الحجج);
        };
        إذا (اسم_يساوي_مفسر(الاسم, «getaddrinfo»)) {
            أرجع بديل_حل_عناوين_مفسر(الحالة, الأنواع, الدالة, الحجج, «freeaddrinfo»);
        };
        إذا (اسم_يساوي_مفسر(الاسم, «GetAddrInfoW»)) {
            أرجع بديل_حل_عناوين_مفسر(الحالة, الأنواع, الدالة, الحجج, «FreeAddrInfoW»);
        };
        إذا (اسم_يساوي_مفسر(الاسم, «freeaddrinfo») || اسم_يساوي_مفسر(الاسم, «FreeAddrInfoW»)) {
            أرجع بديل_تحرير_عناوين_مفسر(الحالة, الحجج);
        };
        إذا (اسم_يساوي_مفسر(الاسم, «dladdr»)) {
            أرجع بديل_معلومات_عنوان_مفسر(الحالة, الأنواع, الدالة, الحجج);
        };
        أرجع اختياري.لا_شيء();
    }

    // One extern call. لا_شيء when the host has no foreign-call bridge for it
    // (the caller then reports an unsupported foreign call).
    عام عرف نفذ_نداء_خارجي_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الحجج: &متجه قيمة_تشغيل
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        طابق نفذ_بديل_مضيف_مفسر(الحالة, الأنواع, الدالة, الحجج) مع
        | اختياري.موجود(الناتج) -> { أرجع اختياري.موجود(الناتج); }
        | اختياري.لا_شيء -> { };
        إذا (!ذاكرة_مضيف_متاحة()) { أرجع اختياري.لا_شيء(); };
        إذا (دالة_خارجية_مضيف_معروفة(&(*الدالة).الاسم)) {
            أرجع نفذ_نداء_مضيف_عام_مفسر(الحالة, الأنواع, الدالة, الحجج, اختياري.لا_شيء());
        };
        // Any other extern is found at run time and called at its address.
        طابق حل_عنوان_خارجي_مفسر(الحالة, الأنواع, الدالة) مع
        | نتيجة.نجح(العنوان) -> {
            أرجع نفذ_نداء_مضيف_عام_مفسر(الحالة, الأنواع, الدالة, الحجج, اختياري.موجود(العنوان));
        }
        | نتيجة.خطأ(التعذر) -> {
            أرجع اختياري.موجود(نتيجة_تنفيذ_بدائي_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.نداء_خارجي_ديناميكي_متعذر(
                    (*الدالة).المعرف, انسخ_بايتات(&(*الدالة).الاسم),
                    انسخ_سبب_تعذر_مفسر(&التعذر.السبب), انسخ_بايتات(&التعذر.المكتبة),
                    انسخ_تفصيل_محمل_مفسر(&التعذر.الرسالة)
                )
            )));
        };
    }

    // ---- Dynamic externs -------------------------------------------------------

    // The C class of a parameter or result Type (host_dynamic.sn): an
    // integer, a boolean or a pointer is one integer word, f32 and f64 are
    // floating-point words; لا_شيء for any other Type (a record by value).
    عرف صنف_سي_لنوع_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري صنف_سي_مضيف {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختياري.موجود(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                إذا (البدائي == نوع_بدائي_مقنن.ع32()) { أرجع اختياري.موجود(صنف_سي_مضيف.عائم32()); };
                إذا (البدائي == نوع_بدائي_مقنن.ع64()) { أرجع اختياري.موجود(صنف_سي_مضيف.عائم64()); };
            }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
        إذا (عرض_صحيح_نوع_مفسر(الأنواع, النوع) > 0 || نوع_منطقي_مفسر(الأنواع, النوع)
            || نوع_مؤشر_مفسر(الأنواع, النوع)) {
            أرجع اختياري.موجود(صنف_سي_مضيف.صحيح());
        };
        أرجع اختياري.لا_شيء();
    }

    عرف نوع_فراغ_سي_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختياري.موجود(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.فراغ(); }
            | _ -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }

    // Whether النوع is a signed integer narrower than 64 bits.
    عرف صحيح_موقع_ضيق_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختياري.موجود(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                أرجع البدائي == نوع_بدائي_مقنن.ص8() || البدائي == نوع_بدائي_مقنن.ص16()
                    || البدائي == نوع_بدائي_مقنن.ص32();
            }
            | _ -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }

    // An integer argument's word as C passes it: a narrower signed integer
    // sign-extended, a narrower unsigned one zero-extended (Apple's arm64 ABI
    // and the de facto x86-64 rule extend to 32 bits; 64 covers both).
    عرف وسع_كلمة_سي_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع, الكلمة: ط64): ط64 {
        دع العرض: طبيعي = عرض_صحيح_نوع_مفسر(الأنواع, النوع);
        إذا (العرض == 0 || العرض >= 8) { أرجع الكلمة; };
        دع البتات: ط64 = (العرض * 8) مثل ط64;
        دع القناع: ط64 = ((1 مثل ط64) << البتات) - 1;
        دع القيمة: ط64 = الكلمة & القناع;
        إذا (صحيح_موقع_ضيق_مفسر(الأنواع, النوع) && ((القيمة >> (البتات - 1)) & 1) == 1) {
            أرجع القيمة | ~القناع;
        };
        أرجع القيمة;
    }

    عرف أصناف_معاملات_سي_مفسر(
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير
    ): اختياري متجه صنف_سي_مضيف {
        دع الأصناف: متغير متجه صنف_سي_مضيف = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
            طابق صنف_سي_لنوع_مفسر(الأنواع, (*الدالة).المعاملات[ف]) مع
            | اختياري.موجود(الصنف) -> { ألحق(الأصناف, الصنف); }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            ف := ف + 1;
        }
        أرجع اختياري.موجود(الأصناف);
    }

    // One call of a dynamic extern at العنوان, with errno exchanged around it.
    عرف نادي_عنوان_خارجي_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        العنوان: ط64,
        الكلمات: &متجه ط64
    ): ط64 {
        دع الأصناف: متغير متجه صنف_سي_مضيف = [];
        دع الموسعة: متغير متجه ط64 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الكلمات) مثل طبيعي) && ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
            دع النوع: معرف_نوع = (*الدالة).المعاملات[ف];
            طابق صنف_سي_لنوع_مفسر(الأنواع, النوع) مع
            | اختياري.موجود(الصنف) -> { ألحق(الأصناف, الصنف); }
            | اختياري.لا_شيء -> { ألحق(الأصناف, صنف_سي_مضيف.صحيح()); };
            ألحق(الموسعة, وسع_كلمة_سي_مفسر(الأنواع, النوع, (*الكلمات)[ف]));
            ف := ف + 1;
        }
        دع صنف_الناتج: متغير صنف_سي_مضيف = صنف_سي_مضيف.صحيح();
        طابق (*الدالة).الناتج مع
        | اختياري.موجود(النوع) -> {
            طابق صنف_سي_لنوع_مفسر(الأنواع, النوع) مع
            | اختياري.موجود(الصنف) -> { صنف_الناتج := الصنف; }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        اضبط_رقم_خطأ_ديناميكي_مضيف(&متغير (*الحالة).المحمل_الديناميكي, قيمة_رقم_الخطأ_مفسر(الحالة));
        دع الناتج: ط64 = نادي_عنوان_مضيف(العنوان, &الموسعة, &الأصناف, صنف_الناتج);
        دع رقم_الخطأ: ط64 = اقرأ_رقم_خطأ_ديناميكي_مضيف(&متغير (*الحالة).المحمل_الديناميكي);
        اضبط_رقم_الخطأ_مفسر(الحالة, رقم_الخطأ);
        أرجع الناتج;
    }

    // Why a dynamic extern cannot be called, with the library it names and
    // what the loader reported (the library empty when there is none).
    نوع تعذر_خارجي_مفسر = {
        السبب: سبب_تعذر_نداء_خارجي_مفسر,
        المكتبة: متجه ط8,
        الرسالة: تفصيل_محمل_مفسر
    };

    عرف انسخ_سبب_تعذر_مفسر(السبب: &سبب_تعذر_نداء_خارجي_مفسر): سبب_تعذر_نداء_خارجي_مفسر {
        طابق *السبب مع
        | سبب_تعذر_نداء_خارجي_مفسر.لا_محمل_ديناميكي -> { أرجع سبب_تعذر_نداء_خارجي_مفسر.لا_محمل_ديناميكي(); }
        | سبب_تعذر_نداء_خارجي_مفسر.مكتبة_غير_محملة -> { أرجع سبب_تعذر_نداء_خارجي_مفسر.مكتبة_غير_محملة(); }
        | سبب_تعذر_نداء_خارجي_مفسر.رمز_غير_موجود -> { أرجع سبب_تعذر_نداء_خارجي_مفسر.رمز_غير_موجود(); }
        | سبب_تعذر_نداء_خارجي_مفسر.توقيع_غير_مدعوم -> { أرجع سبب_تعذر_نداء_خارجي_مفسر.توقيع_غير_مدعوم(); };
    }

    عرف تعذر_مفسر(السبب: سبب_تعذر_نداء_خارجي_مفسر, المكتبة: متجه ط8, الرسالة: تفصيل_محمل_مفسر): نتيجة ط64, تعذر_خارجي_مفسر {
        دع التعذر: تعذر_خارجي_مفسر = { السبب: السبب, المكتبة: المكتبة, الرسالة: الرسالة };
        أرجع نتيجة.خطأ(التعذر);
    }

    // The loader's handle of the library named الاسم, opened on first use;
    // 0 when it cannot be loaded.
    عرف مقبض_مكتبة_مفسر(الحالة: &متغير حالة_تنفيذ_مفسر, الاسم: &متجه ط8): ط64 {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الحالة).المكتبات_المفتوحة) مثل طبيعي)) {
            إذا (بايتات_متساوية_مفسر(&(*الحالة).المكتبات_المفتوحة[ف].الاسم, الاسم)) {
                أرجع (*الحالة).المكتبات_المفتوحة[ف].المقبض;
            };
            ف := ف + 1;
        }
        دع المقبض: ط64 = افتح_مكتبة_مضيف(&متغير (*الحالة).المحمل_الديناميكي, الاسم);
        إذا (المقبض != 0) {
            دع المكتبة: مكتبة_مفتوحة_مفسر = { الاسم: انسخ_بايتات(الاسم), المقبض: المقبض };
            ألحق((*الحالة).المكتبات_المفتوحة, المكتبة);
        };
        أرجع المقبض;
    }

    // The address of a dynamic extern: its declared library, or else the
    // process's global scope and then the platform C libraries. Found once.
    عرف حل_عنوان_خارجي_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير
    ): نتيجة ط64, تعذر_خارجي_مفسر {
        دع لا_تفصيل: متجه ط8 = [];
        // The signature first: it decides whether any address can be called.
        طابق أصناف_معاملات_سي_مفسر(الأنواع, الدالة) مع
        | اختياري.موجود(الأصناف) -> {
            إذا (!توقيع_سي_مقبول_مضيف(&الأصناف)) {
                أرجع تعذر_مفسر(سبب_تعذر_نداء_خارجي_مفسر.توقيع_غير_مدعوم(), انسخ_بايتات(&لا_تفصيل), تفصيل_محمل_مفسر.بلا_تفصيل());
            };
        }
        | اختياري.لا_شيء -> {
            أرجع تعذر_مفسر(سبب_تعذر_نداء_خارجي_مفسر.توقيع_غير_مدعوم(), انسخ_بايتات(&لا_تفصيل), تفصيل_محمل_مفسر.بلا_تفصيل());
        };
        طابق (*الدالة).الناتج مع
        | اختياري.موجود(النوع) -> {
            إذا (!نوع_فراغ_سي_مفسر(الأنواع, النوع)) {
                طابق صنف_سي_لنوع_مفسر(الأنواع, النوع) مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> {
                    أرجع تعذر_مفسر(سبب_تعذر_نداء_خارجي_مفسر.توقيع_غير_مدعوم(), انسخ_بايتات(&لا_تفصيل), تفصيل_محمل_مفسر.بلا_تفصيل());
                };
            };
        }
        | اختياري.لا_شيء -> { };
        دع المعرف: طبيعي = (*الدالة).المعرف.القيمة;
        طالما ((الطول((*الحالة).عناوين_الخارجيات) مثل طبيعي) <= المعرف) {
            ألحق((*الحالة).عناوين_الخارجيات, 0 مثل ط64);
        }
        إذا ((*الحالة).عناوين_الخارجيات[المعرف] != 0) {
            أرجع نتيجة.نجح((*الحالة).عناوين_الخارجيات[المعرف]);
        };
        إذا (!هيئ_محمل_ديناميكي_مضيف(&متغير (*الحالة).المحمل_الديناميكي)) {
            أرجع تعذر_مفسر(سبب_تعذر_نداء_خارجي_مفسر.لا_محمل_ديناميكي(), انسخ_بايتات(&لا_تفصيل), تفصيل_محمل_مفسر.بلا_تفصيل());
        };
        دع الاسم: &متجه ط8 = &(*الدالة).الاسم;
        دع العنوان: متغير ط64 = 0;
        طابق (*الدالة).المكتبة مع
        | اختياري.موجود(المكتبة) -> {
            دع المقبض: ط64 = مقبض_مكتبة_مفسر(الحالة, &المكتبة);
            إذا (المقبض == 0) {
                دع الرسالة: تفصيل_محمل_مفسر = خطأ_محمل_مضيف(&متغير (*الحالة).المحمل_الديناميكي);
                أرجع تعذر_مفسر(سبب_تعذر_نداء_خارجي_مفسر.مكتبة_غير_محملة(), انسخ_بايتات(&المكتبة), الرسالة);
            };
            العنوان := رمز_مكتبة_مضيف(&متغير (*الحالة).المحمل_الديناميكي, المقبض, الاسم);
            إذا (العنوان == 0) {
                أرجع تعذر_مفسر(سبب_تعذر_نداء_خارجي_مفسر.رمز_غير_موجود(), انسخ_بايتات(&المكتبة), تفصيل_محمل_مفسر.بلا_تفصيل());
            };
        }
        | اختياري.لا_شيء -> {
            // The -l libraries in order, then the global scope
            // (load_libraries.sn).
            العنوان := رمز_في_مكتبات_التحميل_مفسر(
                &متغير (*الحالة).المحمل_الديناميكي, &(*الحالة).مقابض_المكتبات, الاسم
            );
            إذا (العنوان == 0) {
                العنوان := رمز_عام_مضيف(&متغير (*الحالة).المحمل_الديناميكي, الاسم);
            };
            دع المكتبات: متجه نص = مكتبات_سي_افتراضية_مضيف();
            دع ف: متغير طبيعي = 0;
            طالما (العنوان == 0 && ف < (الطول(المكتبات) مثل طبيعي)) {
                دع اسم_المكتبة: متجه ط8 = بايتات_من_نص(انسخ_نص(&المكتبات[ف]));
                دع المقبض: ط64 = مقبض_مكتبة_مفسر(الحالة, &اسم_المكتبة);
                إذا (المقبض != 0) {
                    العنوان := رمز_مكتبة_مضيف(&متغير (*الحالة).المحمل_الديناميكي, المقبض, الاسم);
                };
                ف := ف + 1;
            }
            إذا (العنوان == 0) {
                أرجع تعذر_مفسر(سبب_تعذر_نداء_خارجي_مفسر.رمز_غير_موجود(), انسخ_بايتات(&لا_تفصيل), تفصيل_محمل_مفسر.بلا_تفصيل());
            };
        };
        (*الحالة).عناوين_الخارجيات[المعرف] := العنوان;
        أرجع نتيجة.نجح(العنوان);
    }
}

// Whether std's own externs and their shims are in the bridge (Windows,
// macOS); on Linux it calls only a program's own functions.
إذا (الهدف.المنصة == «windows» || الهدف.المنصة == «macos») {
    عرف بدائل_المكتبة_القياسية_مفسر(): منطقي { أرجع صواب; }
}
إذا (الهدف.المنصة != «windows» && الهدف.المنصة != «macos») {
    عرف بدائل_المكتبة_القياسية_مفسر(): منطقي { أرجع خطأ; }
}

// Hosts with no bridge (Android, FreeBSD, WASI, 32-bit Linux): a foreign
// call is reported as unsupported.
إذا (الهدف.المنصة != «windows» && الهدف.المنصة != «macos» && !(الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))) {
    عام عرف نفذ_نداء_خارجي_مفسر(
        الحالة: &متغير حالة_تنفيذ_مفسر,
        الأنواع: &سجل_أنواع,
        الدالة: &دالة_خارجية_مسير,
        الحجج: &متجه قيمة_تشغيل
    ): اختياري نتيجة_تنفيذ_بدائي_مفسر {
        أرجع اختياري.لا_شيء();
    }
}
