// IEEE-754 software helpers for the MSIR interpreter.
// The compiler source itself remains integer-only so Stage0 can build it.

عام نوع وصف_عائم_برمجي = {
    البتات: طبيعي,
    بتات_الكسر: طبيعي,
    بتات_الأس: طبيعي,
    الانحياز: عدد
};

عام نوع مكونات_عائم_برمجي = {
    سالب: منطقي,
    دلالة: طبيعي,
    الأس: عدد
};

نوع عدد_128_برمجي = {
    عالي: طبيعي,
    منخفض: طبيعي
};

عام عرف وصف_عائم_برمجي_من(البتات: طبيعي): وصف_عائم_برمجي {
    إذا (البتات == 32) {
        دع الناتج: وصف_عائم_برمجي = {
            البتات: 32,
            بتات_الكسر: 23,
            بتات_الأس: 8,
            الانحياز: 127
        };
        أرجع الناتج;
    };
    دع الناتج: وصف_عائم_برمجي = {
        البتات: 64,
        بتات_الكسر: 52,
        بتات_الأس: 11,
        الانحياز: 1023
    };
    أرجع الناتج;
}

عرف قوة_اثنين_برمجية(الموضع: طبيعي): طبيعي {
    دع واحد: طبيعي = 1;
    أرجع واحد << الموضع;
}

عرف قناع_برمجي(البتات: طبيعي): طبيعي {
    إذا (البتات >= 64) {
        دع صفر: طبيعي = 0;
        أرجع ~صفر;
    };
    دع الحد: طبيعي = قوة_اثنين_برمجية(البتات);
    أرجع الحد - 1;
}

عرف قناع_الكسر_برمجي(الوصف: وصف_عائم_برمجي): طبيعي {
    أرجع قناع_برمجي(الوصف.بتات_الكسر);
}

عرف قناع_الأس_برمجي(الوصف: وصف_عائم_برمجي): طبيعي {
    أرجع قناع_برمجي(الوصف.بتات_الأس);
}

عرف بت_الإشارة_برمجي(الوصف: وصف_عائم_برمجي): طبيعي {
    أرجع قوة_اثنين_برمجية(الوصف.البتات - 1);
}

عرف قدر_عائم_برمجي(الخام: طبيعي, الوصف: وصف_عائم_برمجي): طبيعي {
    دع الإشارة: طبيعي = بت_الإشارة_برمجي(الوصف);
    أرجع الخام & (~الإشارة);
}

عرف هل_سالب_برمجي(الخام: طبيعي, الوصف: وصف_عائم_برمجي): منطقي {
    دع الاختبار: طبيعي = الخام & بت_الإشارة_برمجي(الوصف);
    أرجع الاختبار != 0;
}

عرف حقل_الأس_برمجي(الخام: طبيعي, الوصف: وصف_عائم_برمجي): طبيعي {
    دع المزاح: طبيعي = الخام >> الوصف.بتات_الكسر;
    أرجع المزاح & قناع_الأس_برمجي(الوصف);
}

عرف حقل_الكسر_برمجي(الخام: طبيعي, الوصف: وصف_عائم_برمجي): طبيعي {
    أرجع الخام & قناع_الكسر_برمجي(الوصف);
}

عام عرف هل_نان_برمجي(الخام: طبيعي, الوصف: وصف_عائم_برمجي): منطقي {
    دع الأس: طبيعي = حقل_الأس_برمجي(الخام, الوصف);
    دع الكسر: طبيعي = حقل_الكسر_برمجي(الخام, الوصف);
    دع أقصى: طبيعي = قناع_الأس_برمجي(الوصف);
    إذا (الأس != أقصى) { أرجع خطأ; };
    أرجع الكسر != 0;
}

عام عرف هل_لانهاية_برمجية(الخام: طبيعي, الوصف: وصف_عائم_برمجي): منطقي {
    دع الأس: طبيعي = حقل_الأس_برمجي(الخام, الوصف);
    دع الكسر: طبيعي = حقل_الكسر_برمجي(الخام, الوصف);
    دع أقصى: طبيعي = قناع_الأس_برمجي(الوصف);
    إذا (الأس != أقصى) { أرجع خطأ; };
    أرجع الكسر == 0;
}

عرف نان_هادئ_برمجي(الوصف: وصف_عائم_برمجي): طبيعي {
    دع الأس: طبيعي = قناع_الأس_برمجي(الوصف);
    دع جزء_الأس: طبيعي = الأس << الوصف.بتات_الكسر;
    دع الهادئ: طبيعي = قوة_اثنين_برمجية(الوصف.بتات_الكسر - 1);
    أرجع جزء_الأس | الهادئ;
}

عرف لانهاية_برمجية(سالب: منطقي, الوصف: وصف_عائم_برمجي): طبيعي {
    دع الأس: طبيعي = قناع_الأس_برمجي(الوصف);
    دع الخام_الموجب: طبيعي = الأس << الوصف.بتات_الكسر;
    إذا (!سالب) { أرجع الخام_الموجب; };
    أرجع الخام_الموجب | بت_الإشارة_برمجي(الوصف);
}

عرف ازح_يمينا_بلزج_برمجي(القيمة: طبيعي, الإزاحة: طبيعي): طبيعي {
    إذا (الإزاحة == 0) { أرجع القيمة; };
    إذا (الإزاحة >= 64) {
        إذا (القيمة == 0) { أرجع 0; };
        أرجع 1;
    };
    دع القناع: طبيعي = قناع_برمجي(الإزاحة);
    دع الضائع: طبيعي = القيمة & القناع;
    دع الناتج: متغير طبيعي = القيمة >> الإزاحة;
    إذا (الضائع != 0) { الناتج := الناتج | 1; };
    أرجع الناتج;
}

عرف فك_عائم_برمجي(الخام: طبيعي, الوصف: وصف_عائم_برمجي): مكونات_عائم_برمجي {
    دع سالب: منطقي = هل_سالب_برمجي(الخام, الوصف);
    دع حقل_الأس: طبيعي = حقل_الأس_برمجي(الخام, الوصف);
    دع الكسر: طبيعي = حقل_الكسر_برمجي(الخام, الوصف);
    دع الأس: متغير عدد = 1 - الوصف.الانحياز;
    دع الدلالة: متغير طبيعي = الكسر;
    إذا (حقل_الأس != 0) {
        دع حقل_موقع: عدد = حقل_الأس مثل عدد;
        الأس := حقل_موقع - الوصف.الانحياز;
        دع الضمني: طبيعي = قوة_اثنين_برمجية(الوصف.بتات_الكسر);
        الدلالة := الدلالة | الضمني;
    };
    دع الضمني: طبيعي = قوة_اثنين_برمجية(الوصف.بتات_الكسر);
    طالما (الدلالة != 0 && الدلالة < الضمني) {
        الدلالة := الدلالة << 1;
        الأس := الأس - 1;
    }
    دع الناتج: مكونات_عائم_برمجي = {
        سالب: سالب,
        دلالة: الدلالة,
        الأس: الأس
    };
    أرجع الناتج;
}

عرف احزم_عائم_برمجي(
    سالب: منطقي,
    الدلالة_الموسعة: طبيعي,
    الأس_الأصلي: عدد,
    الوصف: وصف_عائم_برمجي
): طبيعي {
    دع الدلالة: متغير طبيعي = الدلالة_الموسعة;
    دع الأس: متغير عدد = الأس_الأصلي;
    إذا (الدلالة == 0) {
        إذا (سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
        أرجع 0;
    };

    دع موضع_الهدف: طبيعي = الوصف.بتات_الكسر + 3;
    دع الهدف: طبيعي = قوة_اثنين_برمجية(موضع_الهدف);
    دع الأعلى: طبيعي = الهدف << 1;
    طالما (الدلالة >= الأعلى) {
        الدلالة := ازح_يمينا_بلزج_برمجي(الدلالة, 1);
        الأس := الأس + 1;
    }

    دع أدنى_أس: عدد = 1 - الوصف.الانحياز;
    طالما (الدلالة < الهدف && الأس > أدنى_أس) {
        الدلالة := الدلالة << 1;
        الأس := الأس - 1;
    }
    إذا (الأس < أدنى_أس) {
        دع الفرق_الموقع: عدد = أدنى_أس - الأس;
        دع الفرق: طبيعي = الفرق_الموقع مثل طبيعي;
        الدلالة := ازح_يمينا_بلزج_برمجي(الدلالة, الفرق);
        الأس := أدنى_أس;
    };

    دع الرئيسي: متغير طبيعي = الدلالة >> 3;
    دع الباقي: طبيعي = الدلالة & 7;
    دع الزوجية: طبيعي = الرئيسي % 2;
    دع فردي: منطقي = الزوجية != 0;
    إذا (الباقي > 4) {
        الرئيسي := الرئيسي + 1;
    } وإلا إذا (الباقي == 4 && فردي) {
        الرئيسي := الرئيسي + 1;
    };

    دع موضع_الفيض: طبيعي = الوصف.بتات_الكسر + 1;
    دع حد_الفيض: طبيعي = قوة_اثنين_برمجية(موضع_الفيض);
    إذا (الرئيسي >= حد_الفيض) {
        الرئيسي := الرئيسي >> 1;
        الأس := الأس + 1;
    };

    دع أقصى_حقل: طبيعي = قناع_الأس_برمجي(الوصف) - 1;
    دع أقصى_حقل_موقع: عدد = أقصى_حقل مثل عدد;
    دع أعلى_أس: عدد = أقصى_حقل_موقع - الوصف.الانحياز;
    إذا (الأس > أعلى_أس) {
        أرجع لانهاية_برمجية(سالب, الوصف);
    };

    دع الضمني: طبيعي = قوة_اثنين_برمجية(الوصف.بتات_الكسر);
    دع حقل_الأس: متغير طبيعي = 0;
    دع حقل_الكسر: متغير طبيعي = الرئيسي;
    إذا (الأس != أدنى_أس || الرئيسي >= الضمني) {
        دع الأس_المحاز: عدد = الأس + الوصف.الانحياز;
        حقل_الأس := الأس_المحاز مثل طبيعي;
        حقل_الكسر := الرئيسي - الضمني;
    };
    دع جزء_الأس: طبيعي = حقل_الأس << الوصف.بتات_الكسر;
    دع جزء_الكسر: طبيعي = حقل_الكسر & قناع_الكسر_برمجي(الوصف);
    دع الخام_الموجب: طبيعي = جزء_الأس | جزء_الكسر;
    إذا (!سالب) { أرجع الخام_الموجب; };
    أرجع الخام_الموجب | بت_الإشارة_برمجي(الوصف);
}

عام عرف اجمع_عائم_برمجي(
    أ: طبيعي,
    ب_الأصلي: طبيعي,
    اطرح: منطقي,
    الوصف: وصف_عائم_برمجي
): طبيعي {
    دع ب: متغير طبيعي = ب_الأصلي;
    إذا (اطرح) { ب := ب ^ بت_الإشارة_برمجي(الوصف); };
    إذا (هل_نان_برمجي(أ, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    إذا (هل_نان_برمجي(ب, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };

    دع أ_لانهاية: منطقي = هل_لانهاية_برمجية(أ, الوصف);
    دع ب_لانهاية: منطقي = هل_لانهاية_برمجية(ب, الوصف);
    إذا (أ_لانهاية && ب_لانهاية) {
        دع اختلاف_علامات: طبيعي = أ ^ ب;
        دع اختلاف: طبيعي = اختلاف_علامات & بت_الإشارة_برمجي(الوصف);
        إذا (اختلاف != 0) { أرجع نان_هادئ_برمجي(الوصف); };
        أرجع أ;
    };
    إذا (أ_لانهاية) { أرجع أ; };
    إذا (ب_لانهاية) { أرجع ب; };

    دع أ_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(أ, الوصف);
    دع ب_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(ب, الوصف);
    إذا (أ_مكونات.دلالة == 0) {
        إذا (ب_مكونات.دلالة == 0) {
            إذا (أ_مكونات.سالب && ب_مكونات.سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
            أرجع 0;
        };
        أرجع ب;
    };
    إذا (ب_مكونات.دلالة == 0) { أرجع أ; };

    دع أ_موسع: متغير طبيعي = أ_مكونات.دلالة << 3;
    دع ب_موسع: متغير طبيعي = ب_مكونات.دلالة << 3;
    دع الأس: متغير عدد = أ_مكونات.الأس;
    إذا (أ_مكونات.الأس > ب_مكونات.الأس) {
        دع الفرق_الموقع: عدد = أ_مكونات.الأس - ب_مكونات.الأس;
        دع الفرق: طبيعي = الفرق_الموقع مثل طبيعي;
        ب_موسع := ازح_يمينا_بلزج_برمجي(ب_موسع, الفرق);
        الأس := أ_مكونات.الأس;
    } وإلا إذا (ب_مكونات.الأس > أ_مكونات.الأس) {
        دع الفرق_الموقع: عدد = ب_مكونات.الأس - أ_مكونات.الأس;
        دع الفرق: طبيعي = الفرق_الموقع مثل طبيعي;
        أ_موسع := ازح_يمينا_بلزج_برمجي(أ_موسع, الفرق);
        الأس := ب_مكونات.الأس;
    };

    دع سالب: متغير منطقي = أ_مكونات.سالب;
    دع الناتج: متغير طبيعي = 0;
    إذا (أ_مكونات.سالب == ب_مكونات.سالب) {
        الناتج := أ_موسع + ب_موسع;
        سالب := أ_مكونات.سالب;
    } وإلا إذا (أ_موسع > ب_موسع) {
        الناتج := أ_موسع - ب_موسع;
        سالب := أ_مكونات.سالب;
    } وإلا إذا (ب_موسع > أ_موسع) {
        الناتج := ب_موسع - أ_موسع;
        سالب := ب_مكونات.سالب;
    } وإلا {
        أرجع 0;
    };
    أرجع احزم_عائم_برمجي(سالب, الناتج, الأس, الوصف);
}

عرف اجمع_64_ملتف_برمجيا(أ: طبيعي, ب: طبيعي): طبيعي {
    دع القناع: طبيعي = ~((0 مثل طبيعي));
    دع المتبقي: طبيعي = القناع - أ;
    إذا (ب <= المتبقي) { أرجع أ + ب; };
    أرجع ب - (المتبقي + 1);
}

عرف اجمع_128_برمجيا(أ: عدد_128_برمجي, ب: عدد_128_برمجي): عدد_128_برمجي {
    دع المنخفض: طبيعي = اجمع_64_ملتف_برمجيا(أ.منخفض, ب.منخفض);
    دع حمل: متغير طبيعي = 0;
    إذا (المنخفض < أ.منخفض) { حمل := 1; };
    دع مجموع_العالي: طبيعي = اجمع_64_ملتف_برمجيا(أ.عالي, ب.عالي);
    دع العالي: طبيعي = اجمع_64_ملتف_برمجيا(مجموع_العالي, حمل);
    دع الناتج: عدد_128_برمجي = { عالي: العالي, منخفض: المنخفض };
    أرجع الناتج;
}

عرف ازح_128_يسارا_برمجيا(القيمة: عدد_128_برمجي): عدد_128_برمجي {
    دع العالي_مزاح: طبيعي = اجمع_64_ملتف_برمجيا(القيمة.عالي, القيمة.عالي);
    دع الحمل: طبيعي = القيمة.منخفض >> 63;
    دع العالي: طبيعي = العالي_مزاح | الحمل;
    دع المنخفض: طبيعي = اجمع_64_ملتف_برمجيا(القيمة.منخفض, القيمة.منخفض);
    دع الناتج: عدد_128_برمجي = { عالي: العالي, منخفض: المنخفض };
    أرجع الناتج;
}

عرف اضرب_إلى_128_برمجيا(أ: طبيعي, ب: طبيعي): عدد_128_برمجي {
    دع الناتج: متغير عدد_128_برمجي = { عالي: 0, منخفض: 0 };
    دع الجاري: متغير عدد_128_برمجي = { عالي: 0, منخفض: أ };
    دع المضاعف: متغير طبيعي = ب;
    طالما (المضاعف != 0) {
        دع البت: طبيعي = المضاعف & 1;
        إذا (البت != 0) { الناتج := اجمع_128_برمجيا(الناتج, الجاري); };
        الجاري := ازح_128_يسارا_برمجيا(الجاري);
        المضاعف := المضاعف >> 1;
    }
    أرجع الناتج;
}

عرف اختصر_128_برمجيا(القيمة: عدد_128_برمجي, الإزاحة: طبيعي): طبيعي {
    إذا (الإزاحة == 0) { أرجع القيمة.منخفض; };
    إذا (الإزاحة >= 64) { أرجع 0; };
    دع منخفض_مزاح: طبيعي = القيمة.منخفض >> الإزاحة;
    دع إزاحة_العالي: طبيعي = 64 - الإزاحة;
    دع عالي_مزاح: طبيعي = القيمة.عالي << إزاحة_العالي;
    دع الناتج_الأساسي: طبيعي = منخفض_مزاح | عالي_مزاح;
    دع القناع: طبيعي = قناع_برمجي(الإزاحة);
    دع الضائع: طبيعي = القيمة.منخفض & القناع;
    إذا (الضائع == 0) { أرجع الناتج_الأساسي; };
    أرجع الناتج_الأساسي | 1;
}

عام عرف اضرب_عائم_برمجي(
    أ: طبيعي,
    ب: طبيعي,
    الوصف: وصف_عائم_برمجي
): طبيعي {
    إذا (هل_نان_برمجي(أ, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    إذا (هل_نان_برمجي(ب, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    دع أ_لانهاية: منطقي = هل_لانهاية_برمجية(أ, الوصف);
    دع ب_لانهاية: منطقي = هل_لانهاية_برمجية(ب, الوصف);
    دع أ_صفر: منطقي = قدر_عائم_برمجي(أ, الوصف) == 0;
    دع ب_صفر: منطقي = قدر_عائم_برمجي(ب, الوصف) == 0;
    إذا (أ_لانهاية && ب_صفر) { أرجع نان_هادئ_برمجي(الوصف); };
    إذا (ب_لانهاية && أ_صفر) { أرجع نان_هادئ_برمجي(الوصف); };
    دع العلامات: طبيعي = أ ^ ب;
    دع سالب: منطقي = هل_سالب_برمجي(العلامات, الوصف);
    إذا (أ_لانهاية || ب_لانهاية) { أرجع لانهاية_برمجية(سالب, الوصف); };
    إذا (أ_صفر || ب_صفر) {
        إذا (سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
        أرجع 0;
    };
    دع أ_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(أ, الوصف);
    دع ب_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(ب, الوصف);
    دع الضرب: عدد_128_برمجي = اضرب_إلى_128_برمجيا(أ_مكونات.دلالة, ب_مكونات.دلالة);
    دع الإزاحة: طبيعي = الوصف.بتات_الكسر - 3;
    دع الموسع: طبيعي = اختصر_128_برمجيا(الضرب, الإزاحة);
    دع الأس: عدد = أ_مكونات.الأس + ب_مكونات.الأس;
    أرجع احزم_عائم_برمجي(سالب, الموسع, الأس, الوصف);
}

عام عرف اقسم_عائم_برمجي(
    أ: طبيعي,
    ب: طبيعي,
    الوصف: وصف_عائم_برمجي
): طبيعي {
    إذا (هل_نان_برمجي(أ, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    إذا (هل_نان_برمجي(ب, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    دع أ_لانهاية: منطقي = هل_لانهاية_برمجية(أ, الوصف);
    دع ب_لانهاية: منطقي = هل_لانهاية_برمجية(ب, الوصف);
    دع أ_صفر: منطقي = قدر_عائم_برمجي(أ, الوصف) == 0;
    دع ب_صفر: منطقي = قدر_عائم_برمجي(ب, الوصف) == 0;
    إذا (أ_لانهاية && ب_لانهاية) { أرجع نان_هادئ_برمجي(الوصف); };
    إذا (أ_صفر && ب_صفر) { أرجع نان_هادئ_برمجي(الوصف); };
    دع العلامات: طبيعي = أ ^ ب;
    دع سالب: منطقي = هل_سالب_برمجي(العلامات, الوصف);
    إذا (أ_لانهاية) { أرجع لانهاية_برمجية(سالب, الوصف); };
    إذا (ب_لانهاية) {
        إذا (سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
        أرجع 0;
    };
    إذا (ب_صفر) { أرجع لانهاية_برمجية(سالب, الوصف); };
    إذا (أ_صفر) {
        إذا (سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
        أرجع 0;
    };
    دع أ_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(أ, الوصف);
    دع ب_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(ب, الوصف);
    دع الخارج: متغير طبيعي = أ_مكونات.دلالة / ب_مكونات.دلالة;
    دع الباقي: متغير طبيعي = أ_مكونات.دلالة % ب_مكونات.دلالة;
    دع عدد_البتات: طبيعي = الوصف.بتات_الكسر + 3;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_البتات) {
        الخارج := الخارج << 1;
        الباقي := الباقي << 1;
        إذا (الباقي >= ب_مكونات.دلالة) {
            الباقي := الباقي - ب_مكونات.دلالة;
            الخارج := الخارج | 1;
        };
        ف := ف + 1;
    }
    إذا (الباقي != 0) { الخارج := الخارج | 1; };
    دع الأس: عدد = أ_مكونات.الأس - ب_مكونات.الأس;
    أرجع احزم_عائم_برمجي(سالب, الخارج, الأس, الوصف);
}

عام عرف قارن_عائم_برمجي(
    أ: طبيعي,
    ب: طبيعي,
    العملية: طبيعي,
    الوصف: وصف_عائم_برمجي
): منطقي {
    دع أ_نان: منطقي = هل_نان_برمجي(أ, الوصف);
    دع ب_نان: منطقي = هل_نان_برمجي(ب, الوصف);
    إذا (أ_نان || ب_نان) {
        أرجع العملية == 1;
    };
    دع أ_قدر: طبيعي = قدر_عائم_برمجي(أ, الوصف);
    دع ب_قدر: طبيعي = قدر_عائم_برمجي(ب, الوصف);
    دع كلاهما_صفر: منطقي = أ_قدر == 0 && ب_قدر == 0;
    دع قناع_العرض: طبيعي = قناع_برمجي(الوصف.البتات);
    دع أ_مقنع: طبيعي = أ & قناع_العرض;
    دع ب_مقنع: طبيعي = ب & قناع_العرض;
    دع متساويان: منطقي = كلاهما_صفر || أ_مقنع == ب_مقنع;
    دع أ_أصغر: متغير منطقي = خطأ;
    إذا (!متساويان) {
        دع أ_سالب: منطقي = هل_سالب_برمجي(أ, الوصف);
        دع ب_سالب: منطقي = هل_سالب_برمجي(ب, الوصف);
        إذا (أ_سالب != ب_سالب) {
            أ_أصغر := أ_سالب;
        } وإلا إذا (!أ_سالب) {
            أ_أصغر := أ_قدر < ب_قدر;
        } وإلا {
            أ_أصغر := أ_قدر > ب_قدر;
        };
    };
    إذا (العملية == 0) { أرجع متساويان; };
    إذا (العملية == 1) { أرجع !متساويان; };
    إذا (العملية == 2) { أرجع أ_أصغر; };
    إذا (العملية == 3) { أرجع أ_أصغر || متساويان; };
    إذا (العملية == 4) { أرجع !أ_أصغر && !متساويان; };
    أرجع !أ_أصغر || متساويان;
}

// Float <-> integer and float <-> float conversions (`x as T`), with Rust's
// semantics since 1.45 (docs/en/reference/type-system.md, "Numeric casts").

// The integer `x as iN`/`uN` of a float, as width-masked two's-complement
// bits: truncated toward zero, saturated to the type's range, NaN -> 0.
عام عرف عائم_إلى_صحيح_برمجي(
    الخام: طبيعي,
    الوصف: وصف_عائم_برمجي,
    البتات: طبيعي,
    موقع: منطقي
): طبيعي {
    إذا (هل_نان_برمجي(الخام, الوصف)) { أرجع 0; };
    دع سالب: منطقي = هل_سالب_برمجي(الخام, الوصف);
    دع قناع_العرض: طبيعي = قناع_برمجي(البتات);
    دع الأقصى: متغير طبيعي = قناع_العرض;
    دع الأدنى: متغير طبيعي = 0;
    // Magnitude of the most negative value of a signed type.
    دع قدر_الأدنى: متغير طبيعي = 0;
    إذا (موقع) {
        قدر_الأدنى := قوة_اثنين_برمجية(البتات - 1);
        الأقصى := قدر_الأدنى - 1;
        الأدنى := قدر_الأدنى;
    };
    إذا (هل_لانهاية_برمجية(الخام, الوصف)) {
        إذا (سالب) { أرجع الأدنى; };
        أرجع الأقصى;
    };
    إذا (قدر_عائم_برمجي(الخام, الوصف) == 0) { أرجع 0; };
    دع المكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(الخام, الوصف);
    // |x| < 1 truncates to zero.
    إذا (المكونات.الأس < 0) { أرجع 0; };
    دع القدر: متغير طبيعي = 0;
    دع مشبع: متغير منطقي = خطأ;
    إذا (المكونات.الأس >= 64) {
        مشبع := صواب;
    } وإلا {
        دع الأس: طبيعي = المكونات.الأس مثل طبيعي;
        إذا (الأس >= الوصف.بتات_الكسر) {
            القدر := المكونات.دلالة << (الأس - الوصف.بتات_الكسر);
        } وإلا {
            القدر := المكونات.دلالة >> (الوصف.بتات_الكسر - الأس);
        };
    };
    إذا (!سالب) {
        إذا (مشبع || القدر > الأقصى) { أرجع الأقصى; };
        أرجع القدر;
    };
    إذا (!موقع) { أرجع 0; };
    إذا (مشبع || القدر >= قدر_الأدنى) { أرجع الأدنى; };
    إذا (القدر == 0) { أرجع 0; };
    أرجع ((~القدر) + 1) & قناع_العرض;
}

// The float nearest an integer (width-masked bits), ties to even.
عام عرف صحيح_إلى_عائم_برمجي(
    الخام: طبيعي,
    البتات: طبيعي,
    موقع: منطقي,
    الوصف: وصف_عائم_برمجي
): طبيعي {
    دع قناع_العرض: طبيعي = قناع_برمجي(البتات);
    دع القيمة: طبيعي = الخام & قناع_العرض;
    دع سالب: متغير منطقي = خطأ;
    دع القدر: متغير طبيعي = القيمة;
    إذا (موقع && (القيمة & قوة_اثنين_برمجية(البتات - 1)) != 0) {
        سالب := صواب;
        القدر := ((~القيمة) & قناع_العرض) + 1;
    };
    إذا (القدر == 0) { أرجع 0; };
    دع الأس: عدد = (الوصف.بتات_الكسر + 3) مثل عدد;
    أرجع احزم_عائم_برمجي(سالب, القدر, الأس, الوصف);
}

// f32 -> f64 (exact) or f64 -> f32 (nearest, ties to even). A NaN keeps its
// sign and the top bits of its payload, quieted, as x86 and ARM do.
عام عرف عائم_إلى_عائم_برمجي(
    الخام: طبيعي,
    المصدر: وصف_عائم_برمجي,
    الهدف: وصف_عائم_برمجي
): طبيعي {
    دع سالب: منطقي = هل_سالب_برمجي(الخام, المصدر);
    دع الإشارة: متغير طبيعي = 0;
    إذا (سالب) { الإشارة := بت_الإشارة_برمجي(الهدف); };
    إذا (هل_نان_برمجي(الخام, المصدر)) {
        دع الكسر: طبيعي = حقل_الكسر_برمجي(الخام, المصدر);
        دع الحمولة: متغير طبيعي = 0;
        إذا (المصدر.بتات_الكسر > الهدف.بتات_الكسر) {
            الحمولة := الكسر >> (المصدر.بتات_الكسر - الهدف.بتات_الكسر);
        } وإلا {
            الحمولة := الكسر << (الهدف.بتات_الكسر - المصدر.بتات_الكسر);
        };
        أرجع الإشارة | نان_هادئ_برمجي(الهدف) | الحمولة;
    };
    إذا (هل_لانهاية_برمجية(الخام, المصدر)) { أرجع لانهاية_برمجية(سالب, الهدف); };
    إذا (قدر_عائم_برمجي(الخام, المصدر) == 0) { أرجع الإشارة; };
    دع المكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(الخام, المصدر);
    دع فرق_الكسر: عدد = (الهدف.بتات_الكسر + 3) مثل عدد - (المصدر.بتات_الكسر مثل عدد);
    أرجع احزم_عائم_برمجي(سالب, المكونات.دلالة, المكونات.الأس + فرق_الكسر, الهدف);
}

// IEEE 754 operations of the compiler's float primitives
// (compiler/runtime/primitive_identity.sn, عملية_عائمة_بدائية), on raw bits.
// Each gives the exactly rounded result the hardware instructions give.
// abs and copysign only move the sign bit (IEEE non-arithmetic operations: a
// NaN keeps its payload); the others return a NaN operand quieted.

عرف أسكت_نان_برمجي(الخام: طبيعي, الوصف: وصف_عائم_برمجي): طبيعي {
    أرجع الخام | قوة_اثنين_برمجية(الوصف.بتات_الكسر - 1);
}

عام عرف قيمة_مطلقة_عائمة_برمجية(الخام: طبيعي, الوصف: وصف_عائم_برمجي): طبيعي {
    أرجع الخام & ~بت_الإشارة_برمجي(الوصف);
}

عام عرف نسخ_إشارة_عائمة_برمجي(القيمة: طبيعي, الإشارة: طبيعي, الوصف: وصف_عائم_برمجي): طبيعي {
    دع البت: طبيعي = بت_الإشارة_برمجي(الوصف);
    أرجع (القيمة & ~البت) | (الإشارة & البت);
}

// Correctly rounded square root (IEEE 754 squareRoot), computed one result
// bit at a time as fdlibm's e_sqrt.c does: the significand, made to an even
// exponent, gives F + 2 root bits; the last is the rounding bit. A root is
// never exactly halfway between two floats, so round-to-nearest-even adds
// that bit back. The result of a positive finite value is always normal.
عام عرف جذر_عائم_برمجي(الخام: طبيعي, الوصف: وصف_عائم_برمجي): طبيعي {
    إذا (هل_نان_برمجي(الخام, الوصف)) { أرجع أسكت_نان_برمجي(الخام, الوصف); };
    إذا (قدر_عائم_برمجي(الخام, الوصف) == 0) { أرجع الخام; };
    إذا (هل_سالب_برمجي(الخام, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    إذا (هل_لانهاية_برمجية(الخام, الوصف)) { أرجع الخام; };
    دع المكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(الخام, الوصف);
    دع الأس: متغير عدد = المكونات.الأس;
    دع البقية: متغير طبيعي = المكونات.دلالة;
    إذا ((الأس % 2) != 0) {
        البقية := البقية << 1;
        الأس := الأس - 1;
    };
    البقية := البقية << 1;
    دع الجزئي: متغير طبيعي = 0;
    دع الجذر: متغير طبيعي = 0;
    دع البت: متغير طبيعي = قوة_اثنين_برمجية(الوصف.بتات_الكسر + 1);
    طالما (البت != 0) {
        دع التجربة: طبيعي = الجزئي + البت;
        إذا (التجربة <= البقية) {
            الجزئي := التجربة + البت;
            البقية := البقية - التجربة;
            الجذر := الجذر + البت;
        };
        البقية := البقية << 1;
        البت := البت >> 1;
    }
    دع الدلالة: طبيعي = (الجذر + (الجذر & 1)) >> 1;
    دع أس_الحقل: عدد = (الأس / 2) + الوصف.الانحياز - 1;
    أرجع ((أس_الحقل مثل طبيعي) << الوصف.بتات_الكسر) + الدلالة;
}

// Rounding to an integral value, by the bits: the fraction bits below the
// binary point are cleared (trunc), and the value moves one unit away from
// zero when the mode asks for it. Values at or above 2^F are integral.
// الوضع: 0 trunc, 1 floor, 2 ceil, 3 nearest with ties to even.
عام عرف قرب_إلى_صحيح_عائم_برمجي(الخام: طبيعي, الوضع: طبيعي, الوصف: وصف_عائم_برمجي): طبيعي {
    إذا (هل_نان_برمجي(الخام, الوصف)) { أرجع أسكت_نان_برمجي(الخام, الوصف); };
    دع الحقل: طبيعي = حقل_الأس_برمجي(الخام, الوصف);
    دع الانحياز: طبيعي = الوصف.الانحياز مثل طبيعي;
    إذا (الحقل >= الانحياز + الوصف.بتات_الكسر) { أرجع الخام; };
    دع الإشارة: طبيعي = الخام & بت_الإشارة_برمجي(الوصف);
    دع سالب: منطقي = الإشارة != 0;
    دع الواحد: طبيعي = الإشارة | (الانحياز << الوصف.بتات_الكسر);
    إذا (الحقل < الانحياز) {
        // |x| < 1: zero of the same sign, or one of the same sign.
        إذا (قدر_عائم_برمجي(الخام, الوصف) == 0) { أرجع الخام; };
        إذا (الوضع == 1 && سالب) { أرجع الواحد; };
        إذا (الوضع == 2 && !سالب) { أرجع الواحد; };
        إذا (الوضع == 3 && الحقل == الانحياز - 1 && حقل_الكسر_برمجي(الخام, الوصف) != 0) { أرجع الواحد; };
        أرجع الإشارة;
    };
    دع الإزاحة: طبيعي = الوصف.بتات_الكسر - (الحقل - الانحياز);
    دع القناع: طبيعي = قناع_برمجي(الإزاحة);
    دع الكسر: طبيعي = الخام & القناع;
    دع المبتور: طبيعي = الخام & ~القناع;
    إذا (الكسر == 0) { أرجع الخام; };
    دع وحدة_البت: طبيعي = قوة_اثنين_برمجية(الإزاحة);
    دع ابتعد: متغير منطقي = خطأ;
    إذا (الوضع == 1) { ابتعد := سالب; };
    إذا (الوضع == 2) { ابتعد := !سالب; };
    إذا (الوضع == 3) {
        دع النصف: طبيعي = قوة_اثنين_برمجية(الإزاحة - 1);
        دع فردي: منطقي = (المبتور & وحدة_البت) != 0;
        ابتعد := الكسر > النصف || (الكسر == النصف && فردي);
    };
    // Same-sign float bits are ordered like their magnitudes, so one unit of
    // the integral part is an integer add that carries into the exponent.
    إذا (ابتعد) { أرجع المبتور + وحدة_البت; };
    أرجع المبتور;
}

// IEEE 754-2019 minimum / maximum: a NaN operand gives that NaN quieted, and
// -0 is below +0.
عام عرف أدنى_أقصى_عائم_برمجي(أ: طبيعي, ب: طبيعي, أقصى: منطقي, الوصف: وصف_عائم_برمجي): طبيعي {
    إذا (هل_نان_برمجي(أ, الوصف)) { أرجع أسكت_نان_برمجي(أ, الوصف); };
    إذا (هل_نان_برمجي(ب, الوصف)) { أرجع أسكت_نان_برمجي(ب, الوصف); };
    إذا (قارن_عائم_برمجي(أ, ب, 0, الوصف)) {
        // Equal values differ at most in the sign of a zero.
        إذا (أقصى) { أرجع أ & ب; };
        أرجع أ | ب;
    };
    دع أ_أصغر: منطقي = قارن_عائم_برمجي(أ, ب, 2, الوصف);
    إذا (أ_أصغر != أقصى) { أرجع أ; };
    أرجع ب;
}

// Fused multiply-add a * b + c with one rounding (IEEE 754 fusedMultiplyAdd),
// as Berkeley SoftFloat's mulAdd: the exact product (up to 2F + 2 bits) and
// the addend are placed with their top bit at bit 125 of a 128-bit integer,
// the smaller-exponent one is shifted right keeping a sticky bit, the two are
// added or subtracted exactly, and the sum is rounded once by the packer.
عرف ازح_64_يسارا_مقنعا_برمجيا(القيمة: طبيعي, الإزاحة: طبيعي): طبيعي {
    إذا (الإزاحة == 0) { أرجع القيمة; };
    إذا (الإزاحة >= 64) { أرجع 0; };
    أرجع (القيمة & قناع_برمجي(64 - الإزاحة)) << الإزاحة;
}

عرف طول_بتات_64_برمجي(القيمة: طبيعي): طبيعي {
    دع الطول_: متغير طبيعي = 0;
    دع الباقي: متغير طبيعي = القيمة;
    طالما (الباقي != 0) { الطول_ := الطول_ + 1; الباقي := الباقي >> 1; }
    أرجع الطول_;
}

عرف طول_بتات_128_برمجي(القيمة: عدد_128_برمجي): طبيعي {
    إذا (القيمة.عالي != 0) { أرجع 64 + طول_بتات_64_برمجي(القيمة.عالي); };
    أرجع طول_بتات_64_برمجي(القيمة.منخفض);
}

عرف ازح_128_يسارا_بعدد_برمجيا(القيمة: عدد_128_برمجي, الإزاحة: طبيعي): عدد_128_برمجي {
    إذا (الإزاحة == 0) { أرجع القيمة; };
    إذا (الإزاحة >= 64) {
        دع الناتج: عدد_128_برمجي = { عالي: ازح_64_يسارا_مقنعا_برمجيا(القيمة.منخفض, الإزاحة - 64), منخفض: 0 };
        أرجع الناتج;
    };
    دع العالي: طبيعي = ازح_64_يسارا_مقنعا_برمجيا(القيمة.عالي, الإزاحة) | (القيمة.منخفض >> (64 - الإزاحة));
    دع الناتج: عدد_128_برمجي = { عالي: العالي, منخفض: ازح_64_يسارا_مقنعا_برمجيا(القيمة.منخفض, الإزاحة) };
    أرجع الناتج;
}

// Right shift; any 1 bit shifted out sets bit 0 (sticky).
عرف ازح_128_يمينا_بلزج_برمجيا(القيمة: عدد_128_برمجي, الإزاحة: طبيعي): عدد_128_برمجي {
    إذا (الإزاحة == 0) { أرجع القيمة; };
    دع غير_صفر: منطقي = القيمة.عالي != 0 || القيمة.منخفض != 0;
    إذا (الإزاحة >= 128) {
        دع اللزج: متغير طبيعي = 0;
        إذا (غير_صفر) { اللزج := 1; };
        دع الناتج: عدد_128_برمجي = { عالي: 0, منخفض: اللزج };
        أرجع الناتج;
    };
    دع العالي: متغير طبيعي = 0;
    دع المنخفض: متغير طبيعي = 0;
    دع الضائع: متغير منطقي = خطأ;
    إذا (الإزاحة >= 64) {
        دع الباقي: طبيعي = الإزاحة - 64;
        المنخفض := القيمة.عالي >> الباقي;
        الضائع := القيمة.منخفض != 0 || (القيمة.عالي & قناع_برمجي(الباقي)) != 0;
    } وإلا {
        العالي := القيمة.عالي >> الإزاحة;
        المنخفض := (القيمة.منخفض >> الإزاحة) | ازح_64_يسارا_مقنعا_برمجيا(القيمة.عالي, 64 - الإزاحة);
        الضائع := (القيمة.منخفض & قناع_برمجي(الإزاحة)) != 0;
    };
    إذا (الضائع) { المنخفض := المنخفض | 1; };
    دع الناتج: عدد_128_برمجي = { عالي: العالي, منخفض: المنخفض };
    أرجع الناتج;
}

عرف أصغر_128_برمجي(أ: عدد_128_برمجي, ب: عدد_128_برمجي): منطقي {
    إذا (أ.عالي != ب.عالي) { أرجع أ.عالي < ب.عالي; };
    أرجع أ.منخفض < ب.منخفض;
}

// أ - ب for أ >= ب.
عرف اطرح_128_برمجيا(أ: عدد_128_برمجي, ب: عدد_128_برمجي): عدد_128_برمجي {
    دع استلاف: متغير طبيعي = 0;
    دع المنخفض: متغير طبيعي = 0;
    إذا (أ.منخفض >= ب.منخفض) {
        المنخفض := أ.منخفض - ب.منخفض;
    } وإلا {
        المنخفض := (قناع_برمجي(64) - ب.منخفض) + أ.منخفض + 1;
        استلاف := 1;
    };
    دع الناتج: عدد_128_برمجي = { عالي: أ.عالي - ب.عالي - استلاف, منخفض: المنخفض };
    أرجع الناتج;
}

عام عرف ضرب_جمع_مدمج_عائم_برمجي(
    أ: طبيعي,
    ب: طبيعي,
    ج: طبيعي,
    الوصف: وصف_عائم_برمجي
): طبيعي {
    إذا (هل_نان_برمجي(أ, الوصف)) { أرجع أسكت_نان_برمجي(أ, الوصف); };
    إذا (هل_نان_برمجي(ب, الوصف)) { أرجع أسكت_نان_برمجي(ب, الوصف); };
    دع أ_صفر: منطقي = قدر_عائم_برمجي(أ, الوصف) == 0;
    دع ب_صفر: منطقي = قدر_عائم_برمجي(ب, الوصف) == 0;
    دع أ_لانهاية: منطقي = هل_لانهاية_برمجية(أ, الوصف);
    دع ب_لانهاية: منطقي = هل_لانهاية_برمجية(ب, الوصف);
    إذا ((أ_لانهاية && ب_صفر) || (ب_لانهاية && أ_صفر)) { أرجع نان_هادئ_برمجي(الوصف); };
    إذا (هل_نان_برمجي(ج, الوصف)) { أرجع أسكت_نان_برمجي(ج, الوصف); };
    دع سالب_الضرب: منطقي = هل_سالب_برمجي(أ ^ ب, الوصف);
    إذا (أ_لانهاية || ب_لانهاية) {
        إذا (هل_لانهاية_برمجية(ج, الوصف) && هل_سالب_برمجي(ج, الوصف) != سالب_الضرب) {
            أرجع نان_هادئ_برمجي(الوصف);
        };
        أرجع لانهاية_برمجية(سالب_الضرب, الوصف);
    };
    إذا (هل_لانهاية_برمجية(ج, الوصف)) { أرجع ج; };
    إذا (أ_صفر || ب_صفر) {
        // The exact product is a zero; the sum follows IEEE zero rules.
        دع صفر_الضرب: متغير طبيعي = 0;
        إذا (سالب_الضرب) { صفر_الضرب := بت_الإشارة_برمجي(الوصف); };
        أرجع اجمع_عائم_برمجي(صفر_الضرب, ج, خطأ, الوصف);
    };
    إذا (قدر_عائم_برمجي(ج, الوصف) == 0) { أرجع اضرب_عائم_برمجي(أ, ب, الوصف); };
    دع أ_م: مكونات_عائم_برمجي = فك_عائم_برمجي(أ, الوصف);
    دع ب_م: مكونات_عائم_برمجي = فك_عائم_برمجي(ب, الوصف);
    دع ج_م: مكونات_عائم_برمجي = فك_عائم_برمجي(ج, الوصف);
    دع الكسر_عدد: عدد = الوصف.بتات_الكسر مثل عدد;
    // value = significand * 2^exponent for both terms.
    دع الضرب: عدد_128_برمجي = اضرب_إلى_128_برمجيا(أ_م.دلالة, ب_م.دلالة);
    دع أس_الضرب_الخام: عدد = أ_م.الأس + ب_م.الأس - (2 * الكسر_عدد);
    دع إزاحة_الضرب: طبيعي = 126 - طول_بتات_128_برمجي(الضرب);
    دع الضرب_المطبع: عدد_128_برمجي = ازح_128_يسارا_بعدد_برمجيا(الضرب, إزاحة_الضرب);
    دع أس_الضرب: عدد = أس_الضرب_الخام - (إزاحة_الضرب مثل عدد);
    دع الجمع_الخام: عدد_128_برمجي = { عالي: 0, منخفض: ج_م.دلالة };
    دع إزاحة_الجمع: طبيعي = 126 - طول_بتات_128_برمجي(الجمع_الخام);
    دع الجمع_المطبع: عدد_128_برمجي = ازح_128_يسارا_بعدد_برمجيا(الجمع_الخام, إزاحة_الجمع);
    دع أس_الجمع: عدد = ج_م.الأس - الكسر_عدد - (إزاحة_الجمع مثل عدد);
    دع الأول: متغير عدد_128_برمجي = الضرب_المطبع;
    دع الثاني: متغير عدد_128_برمجي = الجمع_المطبع;
    دع الأس: متغير عدد = أس_الضرب;
    إذا (أس_الضرب >= أس_الجمع) {
        دع الفرق: عدد = أس_الضرب - أس_الجمع;
        الثاني := ازح_128_يمينا_بلزج_برمجيا(الجمع_المطبع, الفرق مثل طبيعي);
    } وإلا {
        دع الفرق: عدد = أس_الجمع - أس_الضرب;
        الأول := ازح_128_يمينا_بلزج_برمجيا(الضرب_المطبع, الفرق مثل طبيعي);
        الأس := أس_الجمع;
    };
    دع سالب_الجمع: منطقي = هل_سالب_برمجي(ج, الوصف);
    دع المجموع: متغير عدد_128_برمجي = { عالي: 0, منخفض: 0 };
    دع سالب: متغير منطقي = سالب_الضرب;
    إذا (سالب_الضرب == سالب_الجمع) {
        المجموع := اجمع_128_برمجيا(الأول, الثاني);
    } وإلا إذا (أصغر_128_برمجي(الأول, الثاني)) {
        المجموع := اطرح_128_برمجيا(الثاني, الأول);
        سالب := سالب_الجمع;
    } وإلا {
        المجموع := اطرح_128_برمجيا(الأول, الثاني);
    };
    إذا (المجموع.عالي == 0 && المجموع.منخفض == 0) {
        // An exact zero sum of opposite signs is +0 when rounding to nearest.
        أرجع 0;
    };
    دع الطول_: طبيعي = طول_بتات_128_برمجي(المجموع);
    إذا (الطول_ > 62) {
        دع الزائد: طبيعي = الطول_ - 62;
        المجموع := ازح_128_يمينا_بلزج_برمجيا(المجموع, الزائد);
        الأس := الأس + (الزائد مثل عدد);
    };
    أرجع احزم_عائم_برمجي(سالب, المجموع.منخفض, الأس + الكسر_عدد + 3, الوصف);
}
