// IEEE-754 software helpers for the MSIR interpreter.
// The compiler source itself remains integer-only so Stage0 can build it.

عام نوع وصف_عائم_برمجي = {
    البتات: غير_موقع,
    بتات_الكسر: غير_موقع,
    بتات_الأس: غير_موقع,
    الانحياز: عدد
};

عام نوع مكونات_عائم_برمجي = {
    سالب: منطقي,
    دلالة: غير_موقع,
    الأس: عدد
};

نوع عدد_128_برمجي = {
    عالي: غير_موقع,
    منخفض: غير_موقع
};

عام عرف وصف_عائم_برمجي_من(البتات: غير_موقع): وصف_عائم_برمجي {
    لو (البتات == 32) {
        دع الناتج: وصف_عائم_برمجي = {
            البتات: 32,
            بتات_الكسر: 23,
            بتات_الأس: 8,
            الانحياز: 127
        };
        أرجع الناتج;
    };
    دع الناتج: وصف_عائم_برمجي = {
        البتات: 64,
        بتات_الكسر: 52,
        بتات_الأس: 11,
        الانحياز: 1023
    };
    أرجع الناتج;
}

عرف قوة_اثنين_برمجية(الموضع: غير_موقع): غير_موقع {
    دع واحد: غير_موقع = 1;
    أرجع واحد << الموضع;
}

عرف قناع_برمجي(البتات: غير_موقع): غير_موقع {
    لو (البتات >= 64) {
        دع صفر: غير_موقع = 0;
        أرجع ~صفر;
    };
    دع الحد: غير_موقع = قوة_اثنين_برمجية(البتات);
    أرجع الحد - 1;
}

عرف قناع_الكسر_برمجي(الوصف: وصف_عائم_برمجي): غير_موقع {
    أرجع قناع_برمجي(الوصف.بتات_الكسر);
}

عرف قناع_الأس_برمجي(الوصف: وصف_عائم_برمجي): غير_موقع {
    أرجع قناع_برمجي(الوصف.بتات_الأس);
}

عرف بت_الإشارة_برمجي(الوصف: وصف_عائم_برمجي): غير_موقع {
    أرجع قوة_اثنين_برمجية(الوصف.البتات - 1);
}

عرف قدر_عائم_برمجي(الخام: غير_موقع, الوصف: وصف_عائم_برمجي): غير_موقع {
    دع الإشارة: غير_موقع = بت_الإشارة_برمجي(الوصف);
    أرجع الخام & (~الإشارة);
}

عرف هل_سالب_برمجي(الخام: غير_موقع, الوصف: وصف_عائم_برمجي): منطقي {
    دع الاختبار: غير_موقع = الخام & بت_الإشارة_برمجي(الوصف);
    أرجع الاختبار != 0;
}

عرف حقل_الأس_برمجي(الخام: غير_موقع, الوصف: وصف_عائم_برمجي): غير_موقع {
    دع المزاح: غير_موقع = الخام >> الوصف.بتات_الكسر;
    أرجع المزاح & قناع_الأس_برمجي(الوصف);
}

عرف حقل_الكسر_برمجي(الخام: غير_موقع, الوصف: وصف_عائم_برمجي): غير_موقع {
    أرجع الخام & قناع_الكسر_برمجي(الوصف);
}

عام عرف هل_نان_برمجي(الخام: غير_موقع, الوصف: وصف_عائم_برمجي): منطقي {
    دع الأس: غير_موقع = حقل_الأس_برمجي(الخام, الوصف);
    دع الكسر: غير_موقع = حقل_الكسر_برمجي(الخام, الوصف);
    دع أقصى: غير_موقع = قناع_الأس_برمجي(الوصف);
    لو (الأس != أقصى) { أرجع خطأ; };
    أرجع الكسر != 0;
}

عام عرف هل_لانهاية_برمجية(الخام: غير_موقع, الوصف: وصف_عائم_برمجي): منطقي {
    دع الأس: غير_موقع = حقل_الأس_برمجي(الخام, الوصف);
    دع الكسر: غير_موقع = حقل_الكسر_برمجي(الخام, الوصف);
    دع أقصى: غير_موقع = قناع_الأس_برمجي(الوصف);
    لو (الأس != أقصى) { أرجع خطأ; };
    أرجع الكسر == 0;
}

عرف نان_هادئ_برمجي(الوصف: وصف_عائم_برمجي): غير_موقع {
    دع الأس: غير_موقع = قناع_الأس_برمجي(الوصف);
    دع جزء_الأس: غير_موقع = الأس << الوصف.بتات_الكسر;
    دع الهادئ: غير_موقع = قوة_اثنين_برمجية(الوصف.بتات_الكسر - 1);
    أرجع جزء_الأس | الهادئ;
}

عرف لانهاية_برمجية(سالب: منطقي, الوصف: وصف_عائم_برمجي): غير_موقع {
    دع الأس: غير_موقع = قناع_الأس_برمجي(الوصف);
    دع الخام_الموجب: غير_موقع = الأس << الوصف.بتات_الكسر;
    لو (!سالب) { أرجع الخام_الموجب; };
    أرجع الخام_الموجب | بت_الإشارة_برمجي(الوصف);
}

عرف ازح_يمينا_بلزج_برمجي(القيمة: غير_موقع, الإزاحة: غير_موقع): غير_موقع {
    لو (الإزاحة == 0) { أرجع القيمة; };
    لو (الإزاحة >= 64) {
        لو (القيمة == 0) { أرجع 0; };
        أرجع 1;
    };
    دع القناع: غير_موقع = قناع_برمجي(الإزاحة);
    دع الضائع: غير_موقع = القيمة & القناع;
    دع الناتج: متغير غير_موقع = القيمة >> الإزاحة;
    لو (الضائع != 0) { الناتج := الناتج | 1; };
    أرجع الناتج;
}

عرف فك_عائم_برمجي(الخام: غير_موقع, الوصف: وصف_عائم_برمجي): مكونات_عائم_برمجي {
    دع سالب: منطقي = هل_سالب_برمجي(الخام, الوصف);
    دع حقل_الأس: غير_موقع = حقل_الأس_برمجي(الخام, الوصف);
    دع الكسر: غير_موقع = حقل_الكسر_برمجي(الخام, الوصف);
    دع الأس: متغير عدد = 1 - الوصف.الانحياز;
    دع الدلالة: متغير غير_موقع = الكسر;
    لو (حقل_الأس != 0) {
        دع حقل_موقع: عدد = حقل_الأس مثل عدد;
        الأس := حقل_موقع - الوصف.الانحياز;
        دع الضمني: غير_موقع = قوة_اثنين_برمجية(الوصف.بتات_الكسر);
        الدلالة := الدلالة | الضمني;
    };
    دع الضمني: غير_موقع = قوة_اثنين_برمجية(الوصف.بتات_الكسر);
    بينما (الدلالة != 0 && الدلالة < الضمني) {
        الدلالة := الدلالة << 1;
        الأس := الأس - 1;
    }
    دع الناتج: مكونات_عائم_برمجي = {
        سالب: سالب,
        دلالة: الدلالة,
        الأس: الأس
    };
    أرجع الناتج;
}

عرف احزم_عائم_برمجي(
    سالب: منطقي,
    الدلالة_الموسعة: غير_موقع,
    الأس_الأصلي: عدد,
    الوصف: وصف_عائم_برمجي
): غير_موقع {
    دع الدلالة: متغير غير_موقع = الدلالة_الموسعة;
    دع الأس: متغير عدد = الأس_الأصلي;
    لو (الدلالة == 0) {
        لو (سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
        أرجع 0;
    };

    دع موضع_الهدف: غير_موقع = الوصف.بتات_الكسر + 3;
    دع الهدف: غير_موقع = قوة_اثنين_برمجية(موضع_الهدف);
    دع الأعلى: غير_موقع = الهدف << 1;
    بينما (الدلالة >= الأعلى) {
        الدلالة := ازح_يمينا_بلزج_برمجي(الدلالة, 1);
        الأس := الأس + 1;
    }

    دع أدنى_أس: عدد = 1 - الوصف.الانحياز;
    بينما (الدلالة < الهدف && الأس > أدنى_أس) {
        الدلالة := الدلالة << 1;
        الأس := الأس - 1;
    }
    لو (الأس < أدنى_أس) {
        دع الفرق_الموقع: عدد = أدنى_أس - الأس;
        دع الفرق: غير_موقع = الفرق_الموقع مثل غير_موقع;
        الدلالة := ازح_يمينا_بلزج_برمجي(الدلالة, الفرق);
        الأس := أدنى_أس;
    };

    دع الرئيسي: متغير غير_موقع = الدلالة >> 3;
    دع الباقي: غير_موقع = الدلالة & 7;
    دع الزوجية: غير_موقع = الرئيسي % 2;
    دع فردي: منطقي = الزوجية != 0;
    لو (الباقي > 4) {
        الرئيسي := الرئيسي + 1;
    } وإلا لو (الباقي == 4 && فردي) {
        الرئيسي := الرئيسي + 1;
    };

    دع موضع_الفيض: غير_موقع = الوصف.بتات_الكسر + 1;
    دع حد_الفيض: غير_موقع = قوة_اثنين_برمجية(موضع_الفيض);
    لو (الرئيسي >= حد_الفيض) {
        الرئيسي := الرئيسي >> 1;
        الأس := الأس + 1;
    };

    دع أقصى_حقل: غير_موقع = قناع_الأس_برمجي(الوصف) - 1;
    دع أقصى_حقل_موقع: عدد = أقصى_حقل مثل عدد;
    دع أعلى_أس: عدد = أقصى_حقل_موقع - الوصف.الانحياز;
    لو (الأس > أعلى_أس) {
        أرجع لانهاية_برمجية(سالب, الوصف);
    };

    دع الضمني: غير_موقع = قوة_اثنين_برمجية(الوصف.بتات_الكسر);
    دع حقل_الأس: متغير غير_موقع = 0;
    دع حقل_الكسر: متغير غير_موقع = الرئيسي;
    لو (الأس != أدنى_أس || الرئيسي >= الضمني) {
        دع الأس_المحاز: عدد = الأس + الوصف.الانحياز;
        حقل_الأس := الأس_المحاز مثل غير_موقع;
        حقل_الكسر := الرئيسي - الضمني;
    };
    دع جزء_الأس: غير_موقع = حقل_الأس << الوصف.بتات_الكسر;
    دع جزء_الكسر: غير_موقع = حقل_الكسر & قناع_الكسر_برمجي(الوصف);
    دع الخام_الموجب: غير_موقع = جزء_الأس | جزء_الكسر;
    لو (!سالب) { أرجع الخام_الموجب; };
    أرجع الخام_الموجب | بت_الإشارة_برمجي(الوصف);
}

عام عرف اجمع_عائم_برمجي(
    أ: غير_موقع,
    ب_الأصلي: غير_موقع,
    اطرح: منطقي,
    الوصف: وصف_عائم_برمجي
): غير_موقع {
    دع ب: متغير غير_موقع = ب_الأصلي;
    لو (اطرح) { ب := ب ^ بت_الإشارة_برمجي(الوصف); };
    لو (هل_نان_برمجي(أ, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    لو (هل_نان_برمجي(ب, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };

    دع أ_لانهاية: منطقي = هل_لانهاية_برمجية(أ, الوصف);
    دع ب_لانهاية: منطقي = هل_لانهاية_برمجية(ب, الوصف);
    لو (أ_لانهاية && ب_لانهاية) {
        دع اختلاف_علامات: غير_موقع = أ ^ ب;
        دع اختلاف: غير_موقع = اختلاف_علامات & بت_الإشارة_برمجي(الوصف);
        لو (اختلاف != 0) { أرجع نان_هادئ_برمجي(الوصف); };
        أرجع أ;
    };
    لو (أ_لانهاية) { أرجع أ; };
    لو (ب_لانهاية) { أرجع ب; };

    دع أ_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(أ, الوصف);
    دع ب_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(ب, الوصف);
    لو (أ_مكونات.دلالة == 0) {
        لو (ب_مكونات.دلالة == 0) {
            لو (أ_مكونات.سالب && ب_مكونات.سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
            أرجع 0;
        };
        أرجع ب;
    };
    لو (ب_مكونات.دلالة == 0) { أرجع أ; };

    دع أ_موسع: متغير غير_موقع = أ_مكونات.دلالة << 3;
    دع ب_موسع: متغير غير_موقع = ب_مكونات.دلالة << 3;
    دع الأس: متغير عدد = أ_مكونات.الأس;
    لو (أ_مكونات.الأس > ب_مكونات.الأس) {
        دع الفرق_الموقع: عدد = أ_مكونات.الأس - ب_مكونات.الأس;
        دع الفرق: غير_موقع = الفرق_الموقع مثل غير_موقع;
        ب_موسع := ازح_يمينا_بلزج_برمجي(ب_موسع, الفرق);
        الأس := أ_مكونات.الأس;
    } وإلا لو (ب_مكونات.الأس > أ_مكونات.الأس) {
        دع الفرق_الموقع: عدد = ب_مكونات.الأس - أ_مكونات.الأس;
        دع الفرق: غير_موقع = الفرق_الموقع مثل غير_موقع;
        أ_موسع := ازح_يمينا_بلزج_برمجي(أ_موسع, الفرق);
        الأس := ب_مكونات.الأس;
    };

    دع سالب: متغير منطقي = أ_مكونات.سالب;
    دع الناتج: متغير غير_موقع = 0;
    لو (أ_مكونات.سالب == ب_مكونات.سالب) {
        الناتج := أ_موسع + ب_موسع;
        سالب := أ_مكونات.سالب;
    } وإلا لو (أ_موسع > ب_موسع) {
        الناتج := أ_موسع - ب_موسع;
        سالب := أ_مكونات.سالب;
    } وإلا لو (ب_موسع > أ_موسع) {
        الناتج := ب_موسع - أ_موسع;
        سالب := ب_مكونات.سالب;
    } وإلا {
        أرجع 0;
    };
    أرجع احزم_عائم_برمجي(سالب, الناتج, الأس, الوصف);
}

عرف اجمع_64_ملتف_برمجيا(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    دع القناع: غير_موقع = ~((0 مثل غير_موقع));
    دع المتبقي: غير_موقع = القناع - أ;
    لو (ب <= المتبقي) { أرجع أ + ب; };
    أرجع ب - (المتبقي + 1);
}

عرف اجمع_128_برمجيا(أ: عدد_128_برمجي, ب: عدد_128_برمجي): عدد_128_برمجي {
    دع المنخفض: غير_موقع = اجمع_64_ملتف_برمجيا(أ.منخفض, ب.منخفض);
    دع حمل: متغير غير_موقع = 0;
    لو (المنخفض < أ.منخفض) { حمل := 1; };
    دع مجموع_العالي: غير_موقع = اجمع_64_ملتف_برمجيا(أ.عالي, ب.عالي);
    دع العالي: غير_موقع = اجمع_64_ملتف_برمجيا(مجموع_العالي, حمل);
    دع الناتج: عدد_128_برمجي = { عالي: العالي, منخفض: المنخفض };
    أرجع الناتج;
}

عرف ازح_128_يسارا_برمجيا(القيمة: عدد_128_برمجي): عدد_128_برمجي {
    دع العالي_مزاح: غير_موقع = اجمع_64_ملتف_برمجيا(القيمة.عالي, القيمة.عالي);
    دع الحمل: غير_موقع = القيمة.منخفض >> 63;
    دع العالي: غير_موقع = العالي_مزاح | الحمل;
    دع المنخفض: غير_موقع = اجمع_64_ملتف_برمجيا(القيمة.منخفض, القيمة.منخفض);
    دع الناتج: عدد_128_برمجي = { عالي: العالي, منخفض: المنخفض };
    أرجع الناتج;
}

عرف اضرب_إلى_128_برمجيا(أ: غير_موقع, ب: غير_موقع): عدد_128_برمجي {
    دع الناتج: متغير عدد_128_برمجي = { عالي: 0, منخفض: 0 };
    دع الجاري: متغير عدد_128_برمجي = { عالي: 0, منخفض: أ };
    دع المضاعف: متغير غير_موقع = ب;
    بينما (المضاعف != 0) {
        دع البت: غير_موقع = المضاعف & 1;
        لو (البت != 0) { الناتج := اجمع_128_برمجيا(الناتج, الجاري); };
        الجاري := ازح_128_يسارا_برمجيا(الجاري);
        المضاعف := المضاعف >> 1;
    }
    أرجع الناتج;
}

عرف اختصر_128_برمجيا(القيمة: عدد_128_برمجي, الإزاحة: غير_موقع): غير_موقع {
    لو (الإزاحة == 0) { أرجع القيمة.منخفض; };
    لو (الإزاحة >= 64) { أرجع 0; };
    دع منخفض_مزاح: غير_موقع = القيمة.منخفض >> الإزاحة;
    دع إزاحة_العالي: غير_موقع = 64 - الإزاحة;
    دع عالي_مزاح: غير_موقع = القيمة.عالي << إزاحة_العالي;
    دع الناتج_الأساسي: غير_موقع = منخفض_مزاح | عالي_مزاح;
    دع القناع: غير_موقع = قناع_برمجي(الإزاحة);
    دع الضائع: غير_موقع = القيمة.منخفض & القناع;
    لو (الضائع == 0) { أرجع الناتج_الأساسي; };
    أرجع الناتج_الأساسي | 1;
}

عام عرف اضرب_عائم_برمجي(
    أ: غير_موقع,
    ب: غير_موقع,
    الوصف: وصف_عائم_برمجي
): غير_موقع {
    لو (هل_نان_برمجي(أ, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    لو (هل_نان_برمجي(ب, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    دع أ_لانهاية: منطقي = هل_لانهاية_برمجية(أ, الوصف);
    دع ب_لانهاية: منطقي = هل_لانهاية_برمجية(ب, الوصف);
    دع أ_صفر: منطقي = قدر_عائم_برمجي(أ, الوصف) == 0;
    دع ب_صفر: منطقي = قدر_عائم_برمجي(ب, الوصف) == 0;
    لو (أ_لانهاية && ب_صفر) { أرجع نان_هادئ_برمجي(الوصف); };
    لو (ب_لانهاية && أ_صفر) { أرجع نان_هادئ_برمجي(الوصف); };
    دع العلامات: غير_موقع = أ ^ ب;
    دع سالب: منطقي = هل_سالب_برمجي(العلامات, الوصف);
    لو (أ_لانهاية || ب_لانهاية) { أرجع لانهاية_برمجية(سالب, الوصف); };
    لو (أ_صفر || ب_صفر) {
        لو (سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
        أرجع 0;
    };
    دع أ_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(أ, الوصف);
    دع ب_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(ب, الوصف);
    دع الضرب: عدد_128_برمجي = اضرب_إلى_128_برمجيا(أ_مكونات.دلالة, ب_مكونات.دلالة);
    دع الإزاحة: غير_موقع = الوصف.بتات_الكسر - 3;
    دع الموسع: غير_موقع = اختصر_128_برمجيا(الضرب, الإزاحة);
    دع الأس: عدد = أ_مكونات.الأس + ب_مكونات.الأس;
    أرجع احزم_عائم_برمجي(سالب, الموسع, الأس, الوصف);
}

عام عرف اقسم_عائم_برمجي(
    أ: غير_موقع,
    ب: غير_موقع,
    الوصف: وصف_عائم_برمجي
): غير_موقع {
    لو (هل_نان_برمجي(أ, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    لو (هل_نان_برمجي(ب, الوصف)) { أرجع نان_هادئ_برمجي(الوصف); };
    دع أ_لانهاية: منطقي = هل_لانهاية_برمجية(أ, الوصف);
    دع ب_لانهاية: منطقي = هل_لانهاية_برمجية(ب, الوصف);
    دع أ_صفر: منطقي = قدر_عائم_برمجي(أ, الوصف) == 0;
    دع ب_صفر: منطقي = قدر_عائم_برمجي(ب, الوصف) == 0;
    لو (أ_لانهاية && ب_لانهاية) { أرجع نان_هادئ_برمجي(الوصف); };
    لو (أ_صفر && ب_صفر) { أرجع نان_هادئ_برمجي(الوصف); };
    دع العلامات: غير_موقع = أ ^ ب;
    دع سالب: منطقي = هل_سالب_برمجي(العلامات, الوصف);
    لو (أ_لانهاية) { أرجع لانهاية_برمجية(سالب, الوصف); };
    لو (ب_لانهاية) {
        لو (سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
        أرجع 0;
    };
    لو (ب_صفر) { أرجع لانهاية_برمجية(سالب, الوصف); };
    لو (أ_صفر) {
        لو (سالب) { أرجع بت_الإشارة_برمجي(الوصف); };
        أرجع 0;
    };
    دع أ_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(أ, الوصف);
    دع ب_مكونات: مكونات_عائم_برمجي = فك_عائم_برمجي(ب, الوصف);
    دع الخارج: متغير غير_موقع = أ_مكونات.دلالة / ب_مكونات.دلالة;
    دع الباقي: متغير غير_موقع = أ_مكونات.دلالة % ب_مكونات.دلالة;
    دع عدد_البتات: غير_موقع = الوصف.بتات_الكسر + 3;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_البتات) {
        الخارج := الخارج << 1;
        الباقي := الباقي << 1;
        لو (الباقي >= ب_مكونات.دلالة) {
            الباقي := الباقي - ب_مكونات.دلالة;
            الخارج := الخارج | 1;
        };
        ف := ف + 1;
    }
    لو (الباقي != 0) { الخارج := الخارج | 1; };
    دع الأس: عدد = أ_مكونات.الأس - ب_مكونات.الأس;
    أرجع احزم_عائم_برمجي(سالب, الخارج, الأس, الوصف);
}

عام عرف قارن_عائم_برمجي(
    أ: غير_موقع,
    ب: غير_موقع,
    العملية: غير_موقع,
    الوصف: وصف_عائم_برمجي
): منطقي {
    دع أ_نان: منطقي = هل_نان_برمجي(أ, الوصف);
    دع ب_نان: منطقي = هل_نان_برمجي(ب, الوصف);
    لو (أ_نان || ب_نان) {
        أرجع العملية == 1;
    };
    دع أ_قدر: غير_موقع = قدر_عائم_برمجي(أ, الوصف);
    دع ب_قدر: غير_موقع = قدر_عائم_برمجي(ب, الوصف);
    دع كلاهما_صفر: منطقي = أ_قدر == 0 && ب_قدر == 0;
    دع قناع_العرض: غير_موقع = قناع_برمجي(الوصف.البتات);
    دع أ_مقنع: غير_موقع = أ & قناع_العرض;
    دع ب_مقنع: غير_موقع = ب & قناع_العرض;
    دع متساويان: منطقي = كلاهما_صفر || أ_مقنع == ب_مقنع;
    دع أ_أصغر: متغير منطقي = خطأ;
    لو (!متساويان) {
        دع أ_سالب: منطقي = هل_سالب_برمجي(أ, الوصف);
        دع ب_سالب: منطقي = هل_سالب_برمجي(ب, الوصف);
        لو (أ_سالب != ب_سالب) {
            أ_أصغر := أ_سالب;
        } وإلا لو (!أ_سالب) {
            أ_أصغر := أ_قدر < ب_قدر;
        } وإلا {
            أ_أصغر := أ_قدر > ب_قدر;
        };
    };
    لو (العملية == 0) { أرجع متساويان; };
    لو (العملية == 1) { أرجع !متساويان; };
    لو (العملية == 2) { أرجع أ_أصغر; };
    لو (العملية == 3) { أرجع أ_أصغر || متساويان; };
    لو (العملية == 4) { أرجع !أ_أصغر && !متساويان; };
    أرجع !أ_أصغر || متساويان;
}
