// What a handler needs of its instruction besides the operation: the Value
// ID it defines. The operation itself is borrowed from the program in place.
عام نوع ناتج_تعليمة_مفسر = {
    الناتج: اختياري معرف_قيمة_مسير
};

عام عرف ناتج_تعليمة_مسير_مفسر(الدالة: معرف_دالة_مسير, التعليمة: &تعليمة_مسير): ناتج_تعليمة_مفسر {
    دع الناتج: ناتج_تعليمة_مفسر = { الناتج: معرف_ناتج_تعليمة_في_مسير(الدالة, التعليمة) };
    أرجع الناتج;
}

عام نوع نتيجة_تعليمة_مفسر =
    | استمر
    | أنهى_العملية بنوع طبيعي
    | أخفق بنوع فشل_تفسير_مسير
;

// Interpreter translates the canonical MSIR integer-failure policy into its structured trap result.
// It does not own or redefine which arithmetic conditions trap.
عرف طبق_فشل_حساب_صحيح_مقنن_مفسر(
    الإطار: &إطار_تفسير_مسير,
    السلوك: سلوك_فشل_حساب_صحيح_مسير
): نتيجة_تعليمة_مفسر {
    دع القيمة: إطار_تفسير_مسير = *الإطار;
    طابق السلوك مع
    | سلوك_فشل_حساب_صحيح_مسير.فخ -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.فخ_مسير(القيمة.الدالة, القيمة.الكتلة)
        );
    };
}

عام نوع وصف_صحيح_مفسر = {
    البتات: طبيعي,
    موقع: منطقي
};

نوع نتيجة_وصف_صحيح_مفسر =
    | موجود بنوع وصف_صحيح_مفسر
    | أخفق بنوع فشل_تفسير_مسير
;

نوع نتيجة_صحيح_مفسر =
    | موجود بنوع (طبيعي, وصف_صحيح_مفسر)
    | أخفق بنوع فشل_تفسير_مسير
;

نوع نتيجة_وصف_عائم_مفسر =
    | موجود بنوع وصف_عائم_برمجي
    | أخفق بنوع فشل_تفسير_مسير
;

نوع نتيجة_عائم_مفسر =
    | موجود بنوع (طبيعي, وصف_عائم_برمجي)
    | أخفق بنوع فشل_تفسير_مسير
;

نوع نتيجة_فهرس_مفسر =
    | موجود بنوع طبيعي
    | أخفق بنوع فشل_تفسير_مسير
;

نوع صنف_مصدر_فهرسة_مفسر =
    | تجميع
    | نص
;

نوع نتيجة_صنف_مصدر_فهرسة_مفسر =
    | موجود بنوع صنف_مصدر_فهرسة_مفسر
    | أخفق بنوع فشل_تفسير_مسير
;

عام نوع نتيجة_قسمة_خام =
    | حاصل بنوع (طبيعي, طبيعي)
    | صفر
;

عام عرف قناع_صحيح_مفسر(البتات: طبيعي): طبيعي {
    إذا (البتات >= 64) {
        أرجع ~((0 مثل طبيعي));
    };
    أرجع (((1 مثل طبيعي) << البتات) - 1);
}

عام عرف طبع_صحيح_مفسر(القيمة: طبيعي, البتات: طبيعي): طبيعي {
    أرجع القيمة & قناع_صحيح_مفسر(البتات);
}

عام عرف بت_إشارة_مفسر(البتات: طبيعي): طبيعي {
    أرجع (1 مثل طبيعي) << (البتات - 1);
}

عرف عرض_نوع_ثابت_عام_صحيح_مفسر(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    مطلوب_موقع: منطقي
): اختياري طبيعي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
            إذا (مطلوب_موقع) {
                إذا (الصنف != صنف_نوع_بدائي.عدد_موقع()) {
                    أرجع اختياري.لا_شيء();
                };
            } وإلا {
                إذا ((الصنف != صنف_نوع_بدائي.عدد_صحيح_طبيعي())
                    && (الصنف != صنف_نوع_بدائي.حرف())) {
                    أرجع اختياري.لا_شيء();
                };
            };
            دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
            إذا (البتات == 0 || البتات > 64) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(البتات);
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عام عرف جمع_خام_مفسر(
    أ: طبيعي,
    ب: طبيعي,
    البتات: طبيعي
): طبيعي {
    دع القناع: طبيعي = قناع_صحيح_مفسر(البتات);
    دع س: طبيعي = أ & القناع;
    دع ص: طبيعي = ب & القناع;
    // احسب الجمع modulo 2^N دون تنفيذ جمع أو إزاحة قد تتجاوز عرض عدد المضيف.
    دع المتبقي: طبيعي = القناع - س;
    إذا (ص <= المتبقي) {
        أرجع س + ص;
    };
    // في هذا الفرع س != 0، ولذلك المتبقي + 1 لا يتجاوز القناع.
    أرجع ص - (المتبقي + 1);
}

عام عرف سالب_خام_مفسر(القيمة: طبيعي, البتات: طبيعي): طبيعي {
    دع القناع: طبيعي = قناع_صحيح_مفسر(البتات);
    أرجع جمع_خام_مفسر((~القيمة) & القناع, 1, البتات);
}

عام عرف طرح_خام_مفسر(
    أ: طبيعي,
    ب: طبيعي,
    البتات: طبيعي
): طبيعي {
    أرجع جمع_خام_مفسر(أ, سالب_خام_مفسر(ب, البتات), البتات);
}

// The product modulo 2^N in a few host operations, as a native multiply
// gives it: the halves of 32 bits multiply without overflowing the host's
// 64-bit integer, and the cross terms only contribute their low halves.
// (Previously one shift-and-add step per bit of the width.)
عام عرف ضرب_خام_مفسر(
    أ: طبيعي,
    ب: طبيعي,
    البتات: طبيعي
): طبيعي {
    دع القناع: طبيعي = قناع_صحيح_مفسر(البتات);
    دع س: طبيعي = أ & القناع;
    دع ص: طبيعي = ب & القناع;
    دع نصف: طبيعي = 4294967295;
    دع س_منخفض: طبيعي = س & نصف;
    دع س_مرتفع: طبيعي = س >> 32;
    دع ص_منخفض: طبيعي = ص & نصف;
    دع ص_مرتفع: طبيعي = ص >> 32;
    دع المنخفض: طبيعي = س_منخفض * ص_منخفض;
    دع الأول: طبيعي = (س_مرتفع * ص_منخفض) & نصف;
    دع الثاني: طبيعي = (س_منخفض * ص_مرتفع) & نصف;
    دع الوسط: طبيعي = (الأول + الثاني) & نصف;
    دع الوسط_المزاح: طبيعي = الوسط << 32;
    أرجع جمع_خام_مفسر(المنخفض, الوسط_المزاح, 64) & القناع;
}

// Unsigned division of N-bit patterns: the host's own 64-bit division
// (previously one restoring-division step per bit).
عام عرف اقسم_خام_طبيعي(
    البسط: طبيعي,
    المقسوم_عليه: طبيعي,
    البتات: طبيعي
): نتيجة_قسمة_خام {
    دع القناع: طبيعي = قناع_صحيح_مفسر(البتات);
    دع ب: طبيعي = البسط & القناع;
    دع م: طبيعي = المقسوم_عليه & القناع;
    إذا (م == 0) {
        أرجع نتيجة_قسمة_خام.صفر();
    };
    أرجع نتيجة_قسمة_خام.حاصل(ب / م, ب % م);
}

عام عرف هل_تجاوز_جمع_صحيح_مفسر(
    أ: طبيعي,
    ب: طبيعي,
    الناتج: طبيعي,
    الوصف: وصف_صحيح_مفسر
): منطقي {
    إذا (!الوصف.موقع) {
        أرجع الناتج < أ;
    };
    دع الإشارة: طبيعي = بت_إشارة_مفسر(الوصف.البتات);
    دع اختبار_أ: طبيعي = أ & الإشارة;
    دع اختبار_ب: طبيعي = ب & الإشارة;
    دع اختبار_ن: طبيعي = الناتج & الإشارة;
    دع أ_سالب: منطقي = اختبار_أ != 0;
    دع ب_سالب: منطقي = اختبار_ب != 0;
    دع ن_سالب: منطقي = اختبار_ن != 0;
    أرجع (أ_سالب == ب_سالب) && (ن_سالب != أ_سالب);
}

عام عرف هل_تجاوز_طرح_صحيح_مفسر(
    أ: طبيعي,
    ب: طبيعي,
    الناتج: طبيعي,
    الوصف: وصف_صحيح_مفسر
): منطقي {
    إذا (!الوصف.موقع) {
        أرجع أ < ب;
    };
    دع الإشارة: طبيعي = بت_إشارة_مفسر(الوصف.البتات);
    دع اختبار_أ: طبيعي = أ & الإشارة;
    دع اختبار_ب: طبيعي = ب & الإشارة;
    دع اختبار_ن: طبيعي = الناتج & الإشارة;
    دع أ_سالب: منطقي = اختبار_أ != 0;
    دع ب_سالب: منطقي = اختبار_ب != 0;
    دع ن_سالب: منطقي = اختبار_ن != 0;
    أرجع (أ_سالب != ب_سالب) && (ن_سالب != أ_سالب);
}

عام عرف هل_تجاوز_ضرب_صحيح_مفسر(
    أ: طبيعي,
    ب: طبيعي,
    الوصف: وصف_صحيح_مفسر
): منطقي {
    إذا (أ == 0 || ب == 0) {
        أرجع خطأ;
    };
    دع الحد: متغير طبيعي = قناع_صحيح_مفسر(الوصف.البتات);
    دع أ_قدر: متغير طبيعي = أ;
    دع ب_قدر: متغير طبيعي = ب;
    إذا (الوصف.موقع) {
        دع الإشارة: طبيعي = بت_إشارة_مفسر(الوصف.البتات);
        دع اختبار_أ: طبيعي = أ & الإشارة;
        دع اختبار_ب: طبيعي = ب & الإشارة;
        دع أ_سالب: منطقي = اختبار_أ != 0;
        دع ب_سالب: منطقي = اختبار_ب != 0;
        إذا (أ_سالب) {
            أ_قدر := سالب_خام_مفسر(أ, الوصف.البتات);
        };
        إذا (ب_سالب) {
            ب_قدر := سالب_خام_مفسر(ب, الوصف.البتات);
        };
        إذا (أ_سالب != ب_سالب) {
            الحد := الإشارة;
        } وإلا {
            الحد := الإشارة - 1;
        };
    };
    طابق اقسم_خام_طبيعي(الحد, ب_قدر, الوصف.البتات) مع
    | نتيجة_قسمة_خام.صفر -> {
        أرجع خطأ;
    }
    | نتيجة_قسمة_خام.حاصل(الحاصل, _) -> {
        أرجع أ_قدر > الحاصل;
    };
}

عرف وصف_صحيح_لمعرف(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_وصف_صحيح_مفسر {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مفسر(المسير, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_وصف_صحيح_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.قيمة_مسير_مفقودة(المعرف))
        );
    }
    | اختياري.موجود(القيمة) -> {
        النوع := القيمة;
    };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_وصف_صحيح_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_صحيح_مفقود(المعرف))
        );
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            دع صنف_البدائي: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
            طابق صنف_البدائي مع
            | صنف_نوع_بدائي.عدد_موقع -> { }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> { }
            | _ -> {
                أرجع نتيجة_وصف_صحيح_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.نوع_صحيح_مفقود(المعرف)
                    )
                );
            };
            دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
            إذا (البتات == 0 || البتات > 64) {
                أرجع نتيجة_وصف_صحيح_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.نوع_صحيح_مفقود(المعرف)
                    )
                );
            };
            دع الموقع: منطقي = هل_نوع_بدائي_موقع(البدائي);
            دع النتيجة: وصف_صحيح_مفسر = {
                البتات: البتات,
                موقع: الموقع
            };
            أرجع نتيجة_وصف_صحيح_مفسر.موجود(النتيجة);
        }
        | _ -> {
            أرجع نتيجة_وصف_صحيح_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_صحيح_مفقود(المعرف))
            );
        };
    };
}

عرف وصف_مصدر_تحويل_صحيح_لمعرف(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_وصف_صحيح_مفسر {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مفسر(المسير, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_وصف_صحيح_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.قيمة_مسير_مفقودة(المعرف))
        );
    }
    | اختياري.موجود(القيمة) -> { النوع := القيمة; };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_وصف_صحيح_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_صحيح_مفقود(المعرف))
        );
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
            إذا ((الصنف == صنف_نوع_بدائي.عدد_موقع())
                || (الصنف == صنف_نوع_بدائي.عدد_صحيح_طبيعي())) {
                دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                دع الموقع: منطقي = الصنف == صنف_نوع_بدائي.عدد_موقع();
                دع وصف_العدد: وصف_صحيح_مفسر = {
                    البتات: البتات,
                    موقع: الموقع
                };
                أرجع نتيجة_وصف_صحيح_مفسر.موجود(وصف_العدد);
            };
            إذا (البدائي == نوع_بدائي_مقنن.حرف()) {
                دع بتات_الحرف: طبيعي = بتات_نوع_بدائي(البدائي);
                دع وصف_الحرف: وصف_صحيح_مفسر = {
                    البتات: بتات_الحرف,
                    موقع: خطأ
                };
                أرجع نتيجة_وصف_صحيح_مفسر.موجود(وصف_الحرف);
            };
        }
        | _ -> { };
    };
    أرجع نتيجة_وصف_صحيح_مفسر.أخفق(
        فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_صحيح_مفقود(المعرف))
    );
}

// The raw bits of the number in المعرف's slot, read in place, or لا_شيء
// when the slot holds anything else (the checked path then reports it).
عرف بتات_خانة_مفسر(
    الإطار: &إطار_تفسير_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري طبيعي {
    إذا ((*الإطار).الدالة.القيمة != المعرف.الدالة.القيمة) { أرجع اختياري.لا_شيء(); };
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الإطار).الخانات;
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(*الخانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الخانات)[المعرف.القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.بتات_عدد(العدد)) -> { أرجع اختياري.موجود(العدد); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف اقرأ_مصدر_تحويل_صحيح_مفسر(
    الحالة: &حالة_تنفيذ_مفسر,
    الإطار: &إطار_تفسير_مسير,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_صحيح_مفسر {
    // Fast path: an integer or character operand (descriptor table).
    دع الرمز: طبيعي = وصف_رقمي_لقيمة_مفسر(الحالة, المعرف);
    إذا ((الرمز & 3) == 1 || (الرمز & 3) == 2) {
        طابق بتات_خانة_مفسر(الإطار, المعرف) مع
        | اختياري.موجود(العدد) -> {
            دع وصف_سريع: وصف_صحيح_مفسر = { البتات: الرمز >> 3, موقع: (الرمز & 4) != 0 };
            أرجع نتيجة_صحيح_مفسر.موجود(طبع_صحيح_مفسر(العدد, الرمز >> 3), وصف_سريع);
        }
        | اختياري.لا_شيء -> { };
    };
    دع الخام: طبيعي;
    طابق اقرأ_قيمة_خانة_مسير(الإطار, المعرف) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_صحيح_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.بتات_عدد(العدد) -> { الخام := العدد; }
        | _ -> {
            أرجع نتيجة_صحيح_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.قيمة_صحيح_متوقعة(المعرف)
                )
            );
        };
    };
    طابق وصف_مصدر_تحويل_صحيح_لمعرف(الأنواع, المسير, المعرف) مع
    | نتيجة_وصف_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_صحيح_مفسر.أخفق(الخطأ);
    }
    | نتيجة_وصف_صحيح_مفسر.موجود(الوصف) -> {
        أرجع نتيجة_صحيح_مفسر.موجود(
            طبع_صحيح_مفسر(الخام, الوصف.البتات),
            الوصف
        );
    };
}

عرف اقرأ_صحيح_مفسر(
    الحالة: &حالة_تنفيذ_مفسر,
    الإطار: &إطار_تفسير_مسير,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_صحيح_مفسر {
    // Fast path: the width and sign come from the function's descriptor
    // table, the bits from the slot in place.
    دع الرمز: طبيعي = وصف_رقمي_لقيمة_مفسر(الحالة, المعرف);
    إذا ((الرمز & 3) == 1) {
        طابق بتات_خانة_مفسر(الإطار, المعرف) مع
        | اختياري.موجود(العدد) -> {
            دع وصف_سريع: وصف_صحيح_مفسر = { البتات: الرمز >> 3, موقع: (الرمز & 4) != 0 };
            أرجع نتيجة_صحيح_مفسر.موجود(طبع_صحيح_مفسر(العدد, الرمز >> 3), وصف_سريع);
        }
        | اختياري.لا_شيء -> { };
    };
    دع الخام: طبيعي;
    طابق اقرأ_قيمة_خانة_مسير(الإطار, المعرف) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_صحيح_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.بتات_عدد(العدد) -> {
            الخام := العدد;
        }
        | _ -> {
            أرجع نتيجة_صحيح_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.قيمة_صحيح_متوقعة(المعرف)
                )
            );
        };
    };
    طابق وصف_صحيح_لمعرف(الأنواع, المسير, المعرف) مع
    | نتيجة_وصف_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_صحيح_مفسر.أخفق(الخطأ);
    }
    | نتيجة_وصف_صحيح_مفسر.موجود(الوصف) -> {
        أرجع نتيجة_صحيح_مفسر.موجود(
            طبع_صحيح_مفسر(الخام, الوصف.البتات),
            الوصف
        );
    };
}

عرف وصف_عائم_لمعرف(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_وصف_عائم_مفسر {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مفسر(المسير, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_وصف_عائم_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.قيمة_مسير_مفقودة(المعرف))
        );
    }
    | اختياري.موجود(القيمة) -> { النوع := القيمة; };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_وصف_عائم_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود(المعرف))
        );
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (صنف_النوع_البدائي(البدائي) != صنف_نوع_بدائي.عشري()) {
                أرجع نتيجة_وصف_عائم_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود(المعرف))
                );
            };
            دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
            إذا (البتات != 32 && البتات != 64) {
                أرجع نتيجة_وصف_عائم_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود(المعرف))
                );
            };
            أرجع نتيجة_وصف_عائم_مفسر.موجود(وصف_عائم_برمجي_من(البتات));
        }
        | _ -> {
            أرجع نتيجة_وصف_عائم_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود(المعرف))
            );
        };
    };
}

عرف اقرأ_عائم_مفسر(
    الحالة: &حالة_تنفيذ_مفسر,
    الإطار: &إطار_تفسير_مسير,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_عائم_مفسر {
    // Fast path: a float operand (descriptor table).
    دع الرمز: طبيعي = وصف_رقمي_لقيمة_مفسر(الحالة, المعرف);
    إذا ((الرمز & 3) == 3) {
        طابق بتات_خانة_مفسر(الإطار, المعرف) مع
        | اختياري.موجود(العدد) -> {
            أرجع نتيجة_عائم_مفسر.موجود(العدد, وصف_عائم_برمجي_من(الرمز >> 3));
        }
        | اختياري.لا_شيء -> { };
    };
    دع الخام: طبيعي;
    طابق اقرأ_قيمة_خانة_مسير(الإطار, المعرف) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> { أرجع نتيجة_عائم_مفسر.أخفق(الخطأ); }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.بتات_عدد(العدد) -> { الخام := العدد; }
        | _ -> {
            أرجع نتيجة_عائم_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود(المعرف))
            );
        };
    };
    طابق وصف_عائم_لمعرف(الأنواع, المسير, المعرف) مع
    | نتيجة_وصف_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_عائم_مفسر.أخفق(الخطأ); }
    | نتيجة_وصف_عائم_مفسر.موجود(الوصف) -> {
        أرجع نتيجة_عائم_مفسر.موجود(الخام, الوصف);
    };
}

عرف اقرأ_فهرس_مفسر(
    الحالة: &حالة_تنفيذ_مفسر,
    الإطار: &إطار_تفسير_مسير,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_فهرس_مفسر {
    طابق اقرأ_صحيح_مفسر(الحالة, الإطار, الأنواع, المسير, المعرف) مع
    | نتيجة_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_فهرس_مفسر.أخفق(الخطأ);
    }
    | نتيجة_صحيح_مفسر.موجود(الخام, الوصف) -> {
        دع بت_الإشارة: طبيعي = بت_إشارة_مفسر(الوصف.البتات);
        دع اختبار_الإشارة: طبيعي = الخام & بت_الإشارة;
        إذا (الوصف.موقع && اختبار_الإشارة != 0) {
            أرجع نتيجة_فهرس_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.فهرس_سالب(المعرف))
            );
        };
        أرجع نتيجة_فهرس_مفسر.موجود(الخام);
    };
}

// A shift amount: a negative one is a shift past the width, which traps
// as native code does (MSIR's integer-failure policy), not a bad index.
عرف اقرأ_مقدار_إزاحة_مفسر(
    الحالة: &حالة_تنفيذ_مفسر,
    الإطار: &إطار_تفسير_مسير,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_فهرس_مفسر {
    طابق اقرأ_صحيح_مفسر(الحالة, الإطار, الأنواع, المسير, المعرف) مع
    | نتيجة_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_فهرس_مفسر.أخفق(الخطأ);
    }
    | نتيجة_صحيح_مفسر.موجود(الخام, الوصف) -> {
        دع بت_الإشارة: طبيعي = بت_إشارة_مفسر(الوصف.البتات);
        إذا (الوصف.موقع && (الخام & بت_الإشارة) != 0) {
            دع القيمة: إطار_تفسير_مسير = *الإطار;
            أرجع نتيجة_فهرس_مفسر.أخفق(فشل_تفسير_مسير.فخ_مسير(القيمة.الدالة, القيمة.الكتلة));
        };
        أرجع نتيجة_فهرس_مفسر.موجود(الخام);
    };
}

عرف صنف_مصدر_فهرسة_لمعرف(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_صنف_مصدر_فهرسة_مفسر {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مفسر(المسير, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صنف_مصدر_فهرسة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.قيمة_مسير_مفقودة(المعرف)
            )
        );
    }
    | اختياري.موجود(الموجود) -> {
        النوع := الموجود;
    };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صنف_مصدر_فهرسة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.نوع_فهرسة_غير_متسق(المعرف)
            )
        );
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.متجه -> {
            أرجع نتيجة_صنف_مصدر_فهرسة_مفسر.موجود(
                صنف_مصدر_فهرسة_مفسر.تجميع()
            );
        }
        | صنف_شكل_نوع_دلالي.شريحة -> {
            أرجع نتيجة_صنف_مصدر_فهرسة_مفسر.موجود(
                صنف_مصدر_فهرسة_مفسر.تجميع()
            );
        }
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (البدائي == نوع_بدائي_مقنن.نص()) {
                أرجع نتيجة_صنف_مصدر_فهرسة_مفسر.موجود(
                    صنف_مصدر_فهرسة_مفسر.نص()
                );
            };
        }
        | _ -> { };
    };
    أرجع نتيجة_صنف_مصدر_فهرسة_مفسر.أخفق(
        فشل_تفسير_مسير.خلل_داخلي(
            خلل_داخلي_مفسر.نوع_فهرسة_غير_متسق(المعرف)
        )
    );
}

عام عرف مقارنة_موقعة_أصغر(
    أ: طبيعي,
    ب: طبيعي,
    البتات: طبيعي
): منطقي {
    دع الإشارة: طبيعي = بت_إشارة_مفسر(البتات);
    دع اختبار_أ: طبيعي = أ & الإشارة;
    دع اختبار_ب: طبيعي = ب & الإشارة;
    دع أ_سالب: منطقي = اختبار_أ != 0;
    دع ب_سالب: منطقي = اختبار_ب != 0;
    إذا (أ_سالب != ب_سالب) {
        أرجع أ_سالب;
    };
    أرجع أ < ب;
}

عام عرف إزاحة_يمنى_حسابية_خام_مفسر(
    القيمة: طبيعي,
    البتات: طبيعي,
    الإزاحة: طبيعي
): طبيعي {
    دع القناع: طبيعي = قناع_صحيح_مفسر(البتات);
    دع المطبع: طبيعي = القيمة & القناع;
    دع الناتج: متغير طبيعي = المطبع >> الإزاحة;
    دع اختبار_الإشارة: طبيعي = المطبع & بت_إشارة_مفسر(البتات);
    إذا (الإزاحة > 0 && اختبار_الإشارة != 0) {
        دع المنخفضة: طبيعي = قناع_صحيح_مفسر(البتات - الإزاحة);
        الناتج := الناتج | (القناع ^ المنخفضة);
    };
    أرجع الناتج & القناع;
}

// MSIR integer arithmetic traps when a left shift loses significant bits.
// افحص النطاق قبل الإزاحة حتى لا يعتمد المفسر على إزاحة مضيف قد تفخ قبل
// أن يقرر عقد MSIR ما إذا كانت العملية نفسها صالحة.
عام عرف هل_تجاوز_إزاحة_يسرى_صحيح_مفسر(
    القيمة: طبيعي,
    الإزاحة: طبيعي,
    الوصف: وصف_صحيح_مفسر
): منطقي {
    إذا (الإزاحة == 0) {
        أرجع خطأ;
    };
    دع القناع: طبيعي = قناع_صحيح_مفسر(الوصف.البتات);
    دع الأصل: طبيعي = القيمة & القناع;
    إذا (!الوصف.موقع) {
        دع الحد: طبيعي = القناع >> الإزاحة;
        أرجع الأصل > الحد;
    };

    دع الإشارة: طبيعي = بت_إشارة_مفسر(الوصف.البتات);
    دع اختبار_الإشارة: طبيعي = الأصل & الإشارة;
    إذا (اختبار_الإشارة == 0) {
        دع موجب_أقصى: طبيعي = الإشارة - 1;
        دع الحد_الموجب: طبيعي = موجب_أقصى >> الإزاحة;
        أرجع الأصل > الحد_الموجب;
    };

    دع القدر: طبيعي = سالب_خام_مفسر(الأصل, الوصف.البتات);
    دع الحد_السالب: طبيعي = الإشارة >> الإزاحة;
    أرجع القدر > الحد_السالب;
}

عام عرف ازح_يسارا_خام_مفسر(
    القيمة: طبيعي,
    الإزاحة: طبيعي,
    البتات: طبيعي
): طبيعي {
    // The bits shifted past the width are dropped first, so the host shift
    // cannot overflow (previously one doubling per position).
    إذا (الإزاحة >= البتات) { أرجع 0; };
    دع الباقية: طبيعي = طبع_صحيح_مفسر(القيمة, البتات - الإزاحة);
    أرجع الباقية << الإزاحة;
}

عرف زد_مؤشر_التعليمة_واحفظ(
    الإطار: &متغير إطار_تفسير_مسير
): اختياري فشل_تفسير_مسير {
    دع المؤشر: &متغير طبيعي = &متغير (*الإطار).مؤشر_التعليمة;
    (*المؤشر) := (*المؤشر) + 1;
    أرجع اختياري.لا_شيء();
}

عرف اكتب_ناتج_قيمة(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    القيمة: قيمة_تشغيل
): نتيجة_تعليمة_مفسر {
    دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
    إذا (العمق == 0) {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    دع الناتج_المرجع: &اختياري معرف_قيمة_مسير = &(*التعليمة).الناتج;
    طابق *الناتج_المرجع مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
        );
    }
    | اختياري.موجود(المعرف) -> {
        // Verified MSIR defines this Value in the active function.
        دع الخانات: &متغير متجه خانة_تنفيذ_مسير = &متغير (*الحالة).المكدس[العمق - 1].الخانات;
        إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(*الخانات) مثل طبيعي)) {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.معرف_خانة_خارج_المدى(المعرف))
            );
        };
        (*الخانات)[المعرف.القيمة] := خانة_تنفيذ_مسير.قيمة(القيمة);
    };
    زد_مؤشر_تعليمة_مفسر(الحالة, العمق - 1);
    أرجع نتيجة_تعليمة_مفسر.استمر();
}

عرف اكتب_ناتج_مكان(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    المكان: مكان_تشغيل
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة_الإطار) -> {
        موضع_الإطار := القيمة_الإطار;
    };
    دع الإطار: &متغير إطار_تفسير_مسير = &متغير (*الحالة).المكدس[موضع_الإطار];
    دع الوصف: ناتج_تعليمة_مفسر = *التعليمة;
    طابق الوصف.الناتج مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
        );
    }
    | اختياري.موجود(المعرف) -> {
        طابق اكتب_مكان_خانة_مسير(الإطار, المعرف, المكان) مع
        | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
        }
        | نتيجة_كتابة_خانة.نجحت -> { };
    };
    طابق زد_مؤشر_التعليمة_واحفظ(الإطار) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.استمر();
    };
}

// Module-level and instruction-level vector constants use the same verified
// MSIR constant tree; each evaluation makes a new heap buffer that its owner
// drops, as a native vector literal allocates its storage.
عرف قيمة_متجه_ثابت_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    الثابت: &ثابت_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري قيمة_تشغيل {
    طابق *الثابت مع
    | ثابت_مسير.منطق(الحقيقة) -> { أرجع اختياري.موجود(قيمة_تشغيل.منطق(الحقيقة)); }
    | ثابت_مسير.صحيح_موقع(القيمة) -> {
        طابق عرض_نوع_ثابت_عام_صحيح_مفسر(الأنواع, النوع, صواب) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(البتات) -> {
            أرجع اختياري.موجود(قيمة_تشغيل.بتات_عدد(طبع_صحيح_مفسر(القيمة مثل طبيعي, البتات)));
        };
    }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
        طابق عرض_نوع_ثابت_عام_صحيح_مفسر(الأنواع, النوع, خطأ) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(البتات) -> {
            أرجع اختياري.موجود(قيمة_تشغيل.بتات_عدد(طبع_صحيح_مفسر(القيمة, البتات)));
        };
    }
    | ثابت_مسير.مؤشر_فارغ -> { أرجع اختياري.موجود(قيمة_تشغيل.مؤشر_فارغ()); }
    | ثابت_مسير.دالة(الدالة) -> { أرجع اختياري.موجود(قيمة_تشغيل.دالة(الدالة)); }
    | ثابت_مسير.نص(البايتات) -> {
        دع المخزن: معرف_مخزن_مفسر = خصص_مخزن_بايتات_مفسر(الذاكرة, انسخ_بايتات(&البايتات), خطأ);
        أرجع اختياري.موجود(قيمة_تشغيل.مخزن(المخزن));
    }
    | ثابت_مسير.متجه(العناصر) -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_تسلسل_دلالي(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> { نوع_العنصر := المعرف; };
        دع القيم: متغير متجه قيمة_تشغيل = [];
        دع فهرس_العنصر: متغير طبيعي = 0;
        طالما (فهرس_العنصر < (الطول(العناصر) مثل طبيعي)) {
            طابق قيمة_متجه_ثابت_مفسر(الذاكرة, &العناصر[فهرس_العنصر], نوع_العنصر, الأنواع) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { ألحق(القيم, القيمة); };
            فهرس_العنصر := فهرس_العنصر + 1;
        }
        أرجع اختياري.موجود(قيمة_تشغيل.مخزن(مخزن_عناصر_مفسر(الذاكرة, القيم, الأنواع, نوع_العنصر)));
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// A new buffer holding العناصر: a byte buffer for u8 elements. Its growth
// follows the element's size where it is known without a target layout.
عام عرف مخزن_عناصر_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    العناصر: متجه قيمة_تشغيل,
    الأنواع: &سجل_أنواع,
    نوع_العنصر: معرف_نوع
): معرف_مخزن_مفسر {
    دع الحجم: طبيعي = حجم_عنصر_مفسر(الأنواع, نوع_العنصر);
    أرجع مخزن_عناصر_بحجم_مفسر(الذاكرة, العناصر, الأنواع, نوع_العنصر, الحجم);
}

// The same, for an element of حجم_العنصر bytes in compiled code.
عام عرف مخزن_عناصر_بحجم_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    العناصر: متجه قيمة_تشغيل,
    الأنواع: &سجل_أنواع,
    نوع_العنصر: معرف_نوع,
    حجم_العنصر: طبيعي
): معرف_مخزن_مفسر {
    إذا (نوع_بايت_مفسر(الأنواع, نوع_العنصر)) {
        دع البايتات: متغير متجه ط8 = [];
        دع كلها_بايتات: متغير منطقي = صواب;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي) && كلها_بايتات) {
            طابق العناصر[ف] مع
            | قيمة_تشغيل.بتات_عدد(البتات) -> {
                إذا (البتات <= 255) { ألحق(البايتات, البتات مثل ط8); } وإلا { كلها_بايتات := خطأ; };
            }
            | _ -> { كلها_بايتات := خطأ; };
            ف := ف + 1;
        }
        إذا (كلها_بايتات) {
            أرجع خصص_مخزن_بايتات_مفسر(الذاكرة, البايتات, خطأ);
        };
    };
    أرجع خصص_مخزن_قيم_بحجم_مفسر(الذاكرة, العناصر, حجم_العنصر);
}

// An element's size in bytes as the growth policy reads it, where it does not
// depend on the target: fixed-width numbers and bool. Anything else counts as
// 8 bytes (a pointer-sized value; policy minimum 4 like every element of 2 to
// 1024 bytes); حجم_عنصر_لهدف_مفسر resolves the exact size.
عام عرف حجم_عنصر_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): طبيعي {
    طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, النوع) مع
    | اختياري.موجود(الحجم) -> { أرجع الحجم; }
    | اختياري.لا_شيء -> { };
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (البدائي == نوع_بدائي_مقنن.منطقي()) { أرجع 1; };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع 8;
}

// The exact element size through the target's layout (records over 1 KiB
// start at capacity 1 in compiled code); حجم_عنصر_مفسر when it cannot.
عام عرف حجم_عنصر_لهدف_مفسر(الأنواع: &سجل_أنواع, الهدف: &واصف_هدف, النوع: معرف_نوع): طبيعي {
    دع الثابت: طبيعي = حجم_عنصر_مفسر(الأنواع, النوع);
    طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, النوع) مع
    | اختياري.موجود(_) -> { أرجع الثابت; }
    | اختياري.لا_شيء -> { };
    إذا (الثابت == 1) { أرجع 1; };
    دع السجل: متغير سجل_تخطيط = سجل_تخطيط_جديد();
    طابق حل_تخطيط_نوع(الأنواع, الهدف, &متغير السجل, النوع) مع
    | نتيجة_تخطيط.مكتمل(الواصف) -> { أرجع الواصف.الحجم مثل طبيعي; }
    | _ -> { أرجع الثابت; };
}

// Whether a Type is u8, the element Type of byte buffers.
عام عرف نوع_بايت_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.ط8(); }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The interned static buffer of the text constant defining المعرف.
عرف مخزن_ثابت_نص_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المعرف: معرف_قيمة_مسير,
    البايتات: &متجه ط8
): معرف_مخزن_مفسر {
    دع الدالة: طبيعي = المعرف.الدالة.القيمة;
    طالما ((الطول((*الحالة).ثوابت_النصوص) مثل طبيعي) <= الدالة) {
        دع فارغة: متجه اختياري معرف_مخزن_مفسر = [];
        ألحق((*الحالة).ثوابت_النصوص, فارغة);
    }
    طالما ((الطول((*الحالة).ثوابت_النصوص[الدالة]) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) {
        ألحق((*الحالة).ثوابت_النصوص[الدالة], اختياري.لا_شيء());
    }
    طابق (*الحالة).ثوابت_النصوص[الدالة][المعرف.القيمة] مع
    | اختياري.موجود(المخزن) -> {
        إذا (هوية_مخزن_مفسر_صالحة(&(*الحالة).الذاكرة, المخزن)) { أرجع المخزن; };
    }
    | اختياري.لا_شيء -> { };
    دع الجديد: معرف_مخزن_مفسر = خصص_مخزن_بايتات_مفسر(
        &متغير (*الحالة).الذاكرة, انسخ_بايتات(البايتات), صواب
    );
    (*الحالة).ثوابت_النصوص[الدالة][المعرف.القيمة] := اختياري.موجود(الجديد);
    أرجع الجديد;
}

عرف نفذ_ثابت_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    الثابت: &ثابت_مسير
): نتيجة_تعليمة_مفسر {
    دع الوصف: ناتج_تعليمة_مفسر = *التعليمة;
    طابق *الثابت مع
    | ثابت_مسير.متجه(_) -> {
        دع النوع: معرف_نوع;
        طابق الوصف.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة()));
        }
        | اختياري.موجود(المعرف) -> {
            طابق نوع_قيمة_مفسر(المسير, المعرف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تعليمة_مفسر.أخفق(فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة()));
            }
            | اختياري.موجود(ن) -> { النوع := ن; };
        };
        طابق قيمة_متجه_ثابت_مفسر(&متغير (*الحالة).الذاكرة, الثابت, النوع, الأنواع) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف()));
        }
        | اختياري.موجود(القيمة) -> { أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, القيمة); };
    }
    | ثابت_مسير.منطق(القيمة) -> {
        أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.منطق(القيمة));
    }
    | ثابت_مسير.مؤشر_فارغ -> {
        أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.مؤشر_فارغ());
    }
    | ثابت_مسير.عشري(البايتات) -> {
        طابق الوصف.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
            );
        }
        | اختياري.موجود(المعرف) -> {
            دع وصف_العائم: وصف_عائم_برمجي;
            طابق وصف_عائم_لمعرف(الأنواع, المسير, المعرف) مع
            | نتيجة_وصف_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
            | نتيجة_وصف_عائم_مفسر.موجود(القيمة) -> { وصف_العائم := القيمة; };
            طابق بتات_عائم_من_عشري(&البايتات, وصف_العائم.البتات) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود(المعرف))
                );
            }
            | اختياري.موجود(الخام) -> {
                أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.بتات_عدد(الخام));
            };
        };
    }
    | ثابت_مسير.نص(البايتات) -> {
        طابق الوصف.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة()));
        }
        | اختياري.موجود(المعرف) -> {
            دع المخزن: معرف_مخزن_مفسر = مخزن_ثابت_نص_مفسر(الحالة, المعرف, &البايتات);
            أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.مخزن(المخزن));
        };
    }
    | ثابت_مسير.دالة(الدالة) -> {
        أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.دالة(الدالة));
    }
    | ثابت_مسير.صحيح_موقع(القيمة) -> {
        طابق الوصف.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
            );
        }
        | اختياري.موجود(المعرف) -> {
            دع رمز_الناتج: طبيعي = وصف_رقمي_لقيمة_مفسر(الحالة, المعرف);
            إذا ((رمز_الناتج & 3) == 1) {
                أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.بتات_عدد(
                    طبع_صحيح_مفسر(القيمة مثل طبيعي, رمز_الناتج >> 3)
                ));
            };
            طابق وصف_صحيح_لمعرف(الأنواع, المسير, المعرف) مع
            | نتيجة_وصف_صحيح_مفسر.أخفق(الخطأ) -> {
                أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
            }
            | نتيجة_وصف_صحيح_مفسر.موجود(نوع_الصحيح) -> {
                دع الخام: طبيعي = طبع_صحيح_مفسر(
                    القيمة مثل طبيعي,
                    نوع_الصحيح.البتات
                );
                أرجع اكتب_ناتج_قيمة(
                    الحالة,
                    التعليمة,
                    قيمة_تشغيل.بتات_عدد(الخام)
                );
            };
        };
    }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
        طابق الوصف.الناتج مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
            );
        }
        | اختياري.موجود(المعرف) -> {
            دع رمز_الناتج: طبيعي = وصف_رقمي_لقيمة_مفسر(الحالة, المعرف);
            إذا ((رمز_الناتج & 3) == 1 || (رمز_الناتج & 3) == 2) {
                أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.بتات_عدد(
                    طبع_صحيح_مفسر(القيمة, رمز_الناتج >> 3)
                ));
            };
            طابق وصف_مصدر_تحويل_صحيح_لمعرف(الأنواع, المسير, المعرف) مع
            | نتيجة_وصف_صحيح_مفسر.أخفق(الخطأ) -> {
                أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
            }
            | نتيجة_وصف_صحيح_مفسر.موجود(نوع_الصحيح) -> {
                أرجع اكتب_ناتج_قيمة(
                    الحالة,
                    التعليمة,
                    قيمة_تشغيل.بتات_عدد(
                        طبع_صحيح_مفسر(القيمة, نوع_الصحيح.البتات)
                    )
                );
            };
        };
    };
}

عرف نفذ_حساب_صحيح_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    الحساب: &حساب_صحيح_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع وصف_الحساب: حساب_صحيح_مسير = *الحساب;
    دع أ: طبيعي;
    دع نوع_أ: وصف_صحيح_مفسر;
    طابق اقرأ_صحيح_مفسر(
        الحالة, الإطار,
        الأنواع,
        المسير,
        وصف_الحساب.اليسار
    ) مع
    | نتيجة_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_صحيح_مفسر.موجود(الخام, الوصف) -> {
        أ := الخام;
        نوع_أ := الوصف;
    };
    دع ب: طبيعي;
    طابق اقرأ_صحيح_مفسر(
        الحالة, الإطار,
        الأنواع,
        المسير,
        وصف_الحساب.اليمين
    ) مع
    | نتيجة_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_صحيح_مفسر.موجود(الخام, _) -> {
        ب := الخام;
    };

    دع البتات: طبيعي = نوع_أ.البتات;
    دع القناع: طبيعي = قناع_صحيح_مفسر(البتات);
    دع عقد_الدلالة: عقد_دلالة_حساب_صحيح_مسير = عقد_دلالة_حساب_صحيح_مسير_المقنن();
    دع الناتج: متغير طبيعي = 0;
    طابق وصف_الحساب.العملية مع
    | عملية_حساب_صحيح.جمع -> {
        الناتج := جمع_خام_مفسر(أ, ب, البتات);
        إذا (هل_تجاوز_جمع_صحيح_مفسر(أ, ب, الناتج, نوع_أ)) {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.تجاوز_العرض_الافتراضي
            );
        };
    }
    | عملية_حساب_صحيح.طرح -> {
        الناتج := طرح_خام_مفسر(أ, ب, البتات);
        إذا (هل_تجاوز_طرح_صحيح_مفسر(أ, ب, الناتج, نوع_أ)) {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.تجاوز_العرض_الافتراضي
            );
        };
    }
    | عملية_حساب_صحيح.جمع_ملتف -> { الناتج := جمع_خام_مفسر(أ, ب, البتات); }
    | عملية_حساب_صحيح.طرح_ملتف -> { الناتج := طرح_خام_مفسر(أ, ب, البتات); }
    | عملية_حساب_صحيح.ضرب_ملتف -> { الناتج := ضرب_خام_مفسر(أ, ب, البتات); }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> {
        // Lowering masked the amount below the width.
        الناتج := ازح_يسارا_خام_مفسر(أ, ب & (البتات - 1), البتات);
    }
    | عملية_حساب_صحيح.ضرب -> {
        إذا (هل_تجاوز_ضرب_صحيح_مفسر(أ, ب, نوع_أ)) {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.تجاوز_العرض_الافتراضي
            );
        };
        الناتج := ضرب_خام_مفسر(أ, ب, البتات);
    }
    | عملية_حساب_صحيح.قسمة_طبيعية -> {
        طابق اقسم_خام_طبيعي(أ, ب, البتات) مع
        | نتيجة_قسمة_خام.صفر -> {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.قسمة_على_صفر
            );
        }
        | نتيجة_قسمة_خام.حاصل(الحاصل, _) -> {
            الناتج := الحاصل;
        };
    }
    | عملية_حساب_صحيح.باقي_طبيعي -> {
        طابق اقسم_خام_طبيعي(أ, ب, البتات) مع
        | نتيجة_قسمة_خام.صفر -> {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.باقي_على_صفر
            );
        }
        | نتيجة_قسمة_خام.حاصل(_, الباقي) -> {
            الناتج := الباقي;
        };
    }
    | عملية_حساب_صحيح.قسمة_موقعة -> {
        إذا (ب == 0) {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.قسمة_على_صفر
            );
        };
        دع الإشارة: طبيعي = بت_إشارة_مفسر(البتات);
        إذا (أ == الإشارة && ب == القناع) {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.قسمة_أدنى_موقع_على_سالب_واحد
            );
        };
        دع اختبار_أ: طبيعي = أ & الإشارة;
        دع اختبار_ب: طبيعي = ب & الإشارة;
        دع أ_سالب: منطقي = اختبار_أ != 0;
        دع ب_سالب: منطقي = اختبار_ب != 0;
        دع أ_قدر: متغير طبيعي = أ;
        إذا (أ_سالب) {
            أ_قدر := سالب_خام_مفسر(أ, البتات);
        };
        دع ب_قدر: متغير طبيعي = ب;
        إذا (ب_سالب) {
            ب_قدر := سالب_خام_مفسر(ب, البتات);
        };
        طابق اقسم_خام_طبيعي(أ_قدر, ب_قدر, البتات) مع
        | نتيجة_قسمة_خام.صفر -> {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.قسمة_على_صفر
            );
        }
        | نتيجة_قسمة_خام.حاصل(الحاصل, _) -> {
            إذا (أ_سالب != ب_سالب) {
                الناتج := سالب_خام_مفسر(الحاصل, البتات);
            } وإلا {
                الناتج := الحاصل;
            };
        };
    }
    | عملية_حساب_صحيح.باقي_موقع -> {
        إذا (ب == 0) {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.باقي_على_صفر
            );
        };
        دع الإشارة: طبيعي = بت_إشارة_مفسر(البتات);
        إذا (أ == الإشارة && ب == القناع) {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.باقي_أدنى_موقع_على_سالب_واحد
            );
        };
        دع اختبار_أ: طبيعي = أ & الإشارة;
        دع اختبار_ب: طبيعي = ب & الإشارة;
        دع أ_سالب: منطقي = اختبار_أ != 0;
        دع ب_سالب: منطقي = اختبار_ب != 0;
        دع أ_قدر: متغير طبيعي = أ;
        إذا (أ_سالب) {
            أ_قدر := سالب_خام_مفسر(أ, البتات);
        };
        دع ب_قدر: متغير طبيعي = ب;
        إذا (ب_سالب) {
            ب_قدر := سالب_خام_مفسر(ب, البتات);
        };
        طابق اقسم_خام_طبيعي(أ_قدر, ب_قدر, البتات) مع
        | نتيجة_قسمة_خام.صفر -> {
            أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                الإطار,
                عقد_الدلالة.باقي_على_صفر
            );
        }
        | نتيجة_قسمة_خام.حاصل(_, الباقي) -> {
            إذا (أ_سالب) {
                الناتج := سالب_خام_مفسر(الباقي, البتات);
            } وإلا {
                الناتج := الباقي;
            };
        };
    }
    | عملية_حساب_صحيح.أو_بتي -> {
        دع المؤقت: طبيعي = أ | ب;
        الناتج := المؤقت & القناع;
    }
    | عملية_حساب_صحيح.أو_حصري -> {
        دع المؤقت: طبيعي = أ ^ ب;
        الناتج := المؤقت & القناع;
    }
    | عملية_حساب_صحيح.و_بتي -> {
        دع المؤقت: طبيعي = أ & ب;
        الناتج := المؤقت & القناع;
    }
    | عملية_حساب_صحيح.إزاحة_يسرى -> {
        طابق اقرأ_مقدار_إزاحة_مفسر(
            الحالة, الإطار,
            الأنواع,
            المسير,
            وصف_الحساب.اليمين
        ) مع
        | نتيجة_فهرس_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
        }
        | نتيجة_فهرس_مفسر.موجود(الإزاحة) -> {
            // A shift by the width or more traps, as in native code.
            إذا (الإزاحة >= البتات) {
                أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                    الإطار,
                    عقد_الدلالة.تجاوز_العرض_الافتراضي
                );
            };
            إذا (هل_تجاوز_إزاحة_يسرى_صحيح_مفسر(أ, الإزاحة, نوع_أ)) {
                أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                    الإطار,
                    عقد_الدلالة.تجاوز_العرض_الافتراضي
                );
            };
            الناتج := ازح_يسارا_خام_مفسر(أ, الإزاحة, البتات);
        };
    }
    | عملية_حساب_صحيح.إزاحة_يمنى -> {
        طابق اقرأ_مقدار_إزاحة_مفسر(
            الحالة, الإطار,
            الأنواع,
            المسير,
            وصف_الحساب.اليمين
        ) مع
        | نتيجة_فهرس_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
        }
        | نتيجة_فهرس_مفسر.موجود(الإزاحة) -> {
            // A shift by the width or more traps, as in native code.
            إذا (الإزاحة >= البتات) {
                أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                    الإطار,
                    عقد_الدلالة.تجاوز_العرض_الافتراضي
                );
            };
            دع المزاح: طبيعي = أ >> الإزاحة;
            الناتج := المزاح & القناع;
        };
    }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
        طابق اقرأ_مقدار_إزاحة_مفسر(
            الحالة, الإطار,
            الأنواع,
            المسير,
            وصف_الحساب.اليمين
        ) مع
        | نتيجة_فهرس_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
        }
        | نتيجة_فهرس_مفسر.موجود(الإزاحة) -> {
            // A shift by the width or more traps, as in native code.
            إذا (الإزاحة >= البتات) {
                أرجع طبق_فشل_حساب_صحيح_مقنن_مفسر(
                    الإطار,
                    عقد_الدلالة.تجاوز_العرض_الافتراضي
                );
            };
            الناتج := إزاحة_يمنى_حسابية_خام_مفسر(أ, البتات, الإزاحة);
        };
    };
    أرجع اكتب_ناتج_قيمة(
        الحالة,
        التعليمة,
        قيمة_تشغيل.بتات_عدد(الناتج & القناع)
    );
}

عرف نفذ_حساب_عشري_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    الحساب: &حساب_عشري_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_إطار_نشط.موجود(القيمة) -> { موضع_الإطار := القيمة; };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: حساب_عشري_مسير = *الحساب;
    دع أ: طبيعي;
    دع ب: طبيعي;
    دع نوع_أ: وصف_عائم_برمجي;
    طابق اقرأ_عائم_مفسر(الحالة, الإطار, الأنواع, المسير, الوصف.اليسار) مع
    | نتيجة_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_عائم_مفسر.موجود(الخام, النوع) -> { أ := الخام; نوع_أ := النوع; };
    طابق اقرأ_عائم_مفسر(الحالة, الإطار, الأنواع, المسير, الوصف.اليمين) مع
    | نتيجة_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_عائم_مفسر.موجود(الخام, النوع) -> {
        إذا (النوع.البتات != نوع_أ.البتات) {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود(الوصف.اليمين))
            );
        };
        ب := الخام;
    };
    دع الناتج: متغير طبيعي = 0;
    طابق الوصف.العملية مع
    | عملية_حساب_عشري.جمع -> { الناتج := اجمع_عائم_برمجي(أ, ب, خطأ, نوع_أ); }
    | عملية_حساب_عشري.طرح -> { الناتج := اجمع_عائم_برمجي(أ, ب, صواب, نوع_أ); }
    | عملية_حساب_عشري.ضرب -> { الناتج := اضرب_عائم_برمجي(أ, ب, نوع_أ); }
    | عملية_حساب_عشري.قسمة -> { الناتج := اقسم_عائم_برمجي(أ, ب, نوع_أ); };
    أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.بتات_عدد(الناتج));
}

عرف نفذ_مقارنة_عشري_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    المقارنة: &مقارنة_عشري_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_إطار_نشط.موجود(القيمة) -> { موضع_الإطار := القيمة; };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: مقارنة_عشري_مسير = *المقارنة;
    دع أ: طبيعي;
    دع ب: طبيعي;
    دع نوع_أ: وصف_عائم_برمجي;
    طابق اقرأ_عائم_مفسر(الحالة, الإطار, الأنواع, المسير, الوصف.اليسار) مع
    | نتيجة_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_عائم_مفسر.موجود(الخام, النوع) -> { أ := الخام; نوع_أ := النوع; };
    طابق اقرأ_عائم_مفسر(الحالة, الإطار, الأنواع, المسير, الوصف.اليمين) مع
    | نتيجة_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_عائم_مفسر.موجود(الخام, النوع) -> {
        إذا (النوع.البتات != نوع_أ.البتات) {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نوع_عشري_مفقود(الوصف.اليمين))
            );
        };
        ب := الخام;
    };
    دع العملية: متغير طبيعي = 0;
    طابق الوصف.العملية مع
    | عملية_مقارنة_عشري.يساوي -> { العملية := 0; }
    | عملية_مقارنة_عشري.لا_يساوي -> { العملية := 1; }
    | عملية_مقارنة_عشري.أصغر -> { العملية := 2; }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { العملية := 3; }
    | عملية_مقارنة_عشري.أكبر -> { العملية := 4; }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { العملية := 5; };
    دع الناتج: منطقي = قارن_عائم_برمجي(أ, ب, العملية, نوع_أ);
    أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.منطق(الناتج));
}

عرف نفذ_مقارنة_صحيح_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    المقارنة: &مقارنة_صحيح_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع وصف_المقارنة: مقارنة_صحيح_مسير = *المقارنة;
    // Pointer operands use place identity; a null is never a valid place.
    // An operand the descriptor table knows as an integer is no pointer.
    دع رمز_الأيسر: طبيعي = وصف_رقمي_لقيمة_مفسر(الحالة, وصف_المقارنة.اليسار);
    دع النوع_الأيسر: معرف_نوع;
    طابق نوع_قيمة_مفسر(المسير, وصف_المقارنة.اليسار) مع
    | اختياري.موجود(ن) -> { النوع_الأيسر := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_مفسر.أخفق(
        فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.قيمة_مسير_مفقودة(وصف_المقارنة.اليسار))); };
    دع معرف_الأساس_الأيسر: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    إذا ((رمز_الأيسر & 3) == 0) {
        معرف_الأساس_الأيسر := معرف_نوع_أساس_عند(الأنواع, النوع_الأيسر);
    };
    طابق معرف_الأساس_الأيسر مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مرجع_النوع_43) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_43.القيمة] مع
        | نوع_مقنن.مؤشر(_) -> {
        دع الأول: قيمة_تشغيل;
        دع الثاني: قيمة_تشغيل;
        طابق اقرأ_قيمة_خانة_مسير(الإطار, وصف_المقارنة.اليسار) مع
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> { الأول := القيمة; }
        | نتيجة_قراءة_قيمة_خانة.أخفق(الفشل) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الفشل); };
        طابق اقرأ_قيمة_خانة_مسير(الإطار, وصف_المقارنة.اليمين) مع
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> { الثاني := القيمة; }
        | نتيجة_قراءة_قيمة_خانة.أخفق(الفشل) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الفشل); };
        دع متساويان: منطقي;
        طابق الأول مع
        | قيمة_تشغيل.مؤشر_فارغ -> {
            طابق الثاني مع
            | قيمة_تشغيل.مؤشر_فارغ -> { متساويان := صواب; }
            | قيمة_تشغيل.مرجع(_) -> { متساويان := خطأ; }
            | _ -> { أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())); };
        }
        | قيمة_تشغيل.مرجع(المكان) -> {
            طابق الثاني مع
            | قيمة_تشغيل.مؤشر_فارغ -> { متساويان := خطأ; }
            | قيمة_تشغيل.مرجع(المكان_الآخر) -> {
                متساويان := مكانا_تخزين_متطابقان(&المكان, &المكان_الآخر);
            }
            | _ -> { أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())); };
        }
        | _ -> { أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())); };
        دع الناتج: منطقي;
        طابق وصف_المقارنة.العملية مع
        | عملية_مقارنة_صحيح.يساوي -> { الناتج := متساويان; }
        | عملية_مقارنة_صحيح.لا_يساوي -> { الناتج := !متساويان; }
        | _ -> { أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())); };
        أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.منطق(الناتج));
    }
        | _ -> { };
    };
    دع أ: طبيعي;
    دع نوع_أ: وصف_صحيح_مفسر;
    طابق اقرأ_صحيح_مفسر(الحالة, الإطار, الأنواع, المسير, وصف_المقارنة.اليسار) مع
    | نتيجة_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_صحيح_مفسر.موجود(الخام, الوصف) -> {
        أ := الخام;
        نوع_أ := الوصف;
    };
    دع ب: طبيعي;
    طابق اقرأ_صحيح_مفسر(الحالة, الإطار, الأنواع, المسير, وصف_المقارنة.اليمين) مع
    | نتيجة_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_صحيح_مفسر.موجود(الخام, _) -> {
        ب := الخام;
    };

    دع أصغر: متغير منطقي = أ < ب;
    دع أكبر: متغير منطقي = أ > ب;
    إذا (نوع_أ.موقع) {
        أصغر := مقارنة_موقعة_أصغر(أ, ب, نوع_أ.البتات);
        أكبر := مقارنة_موقعة_أصغر(ب, أ, نوع_أ.البتات);
    };
    دع الناتج: متغير منطقي = خطأ;
    طابق وصف_المقارنة.العملية مع
    | عملية_مقارنة_صحيح.يساوي -> {
        الناتج := أ == ب;
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> {
        الناتج := أ != ب;
    }
    | عملية_مقارنة_صحيح.أصغر -> {
        الناتج := أصغر;
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        الناتج := أصغر || أ == ب;
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        الناتج := أكبر;
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        الناتج := أكبر || أ == ب;
    };
    أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.منطق(الناتج));
}

عرف نفذ_تحويل_صحيح_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    التحويل: &تحويل_صحيح_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع وصف_التحويل: تحويل_صحيح_مسير = *التحويل;
    دع المصدر: طبيعي;
    دع نوع_المصدر: وصف_صحيح_مفسر;
    طابق اقرأ_مصدر_تحويل_صحيح_مفسر(الحالة, الإطار, الأنواع, المسير, وصف_التحويل.المصدر) مع
    | نتيجة_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_صحيح_مفسر.موجود(الخام, الوصف) -> {
        المصدر := الخام;
        نوع_المصدر := الوصف;
    };
    دع وصف_التعليمة: ناتج_تعليمة_مفسر = *التعليمة;
    دع الوجهة: معرف_قيمة_مسير;
    طابق وصف_التعليمة.الناتج مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
        );
    }
    | اختياري.موجود(القيمة) -> {
        الوجهة := القيمة;
    };
    // The destination may be a char (`u8 as char` is a zero extension): chars
    // are integer bits in the interpreter, described like the conversion source.
    دع نوع_الوجهة: وصف_صحيح_مفسر;
    طابق وصف_مصدر_تحويل_صحيح_لمعرف(الأنواع, المسير, الوجهة) مع
    | نتيجة_وصف_صحيح_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_وصف_صحيح_مفسر.موجود(الوصف) -> {
        نوع_الوجهة := الوصف;
    };

    دع الناتج: متغير طبيعي = المصدر;
    طابق وصف_التحويل.العملية مع
    | عملية_تحويل_صحيح.توسيع_صفري -> {
        الناتج := المصدر;
    }
    | عملية_تحويل_صحيح.توسيع_بإشارة -> {
        الناتج := المصدر;
        دع بت_المصدر: طبيعي = بت_إشارة_مفسر(نوع_المصدر.البتات);
        دع اختبار_المصدر: طبيعي = المصدر & بت_المصدر;
        إذا (اختبار_المصدر != 0) {
            دع قناع_المصدر: طبيعي = قناع_صحيح_مفسر(نوع_المصدر.البتات);
            دع قناع_الوجهة: طبيعي = قناع_صحيح_مفسر(نوع_الوجهة.البتات);
            الناتج := المصدر | (قناع_الوجهة ^ قناع_المصدر);
        };
    }
    | عملية_تحويل_صحيح.اقتطاع -> {
        الناتج := طبع_صحيح_مفسر(المصدر, نوع_الوجهة.البتات);
    }
    | عملية_تحويل_صحيح.إعادة_تفسير -> {
        الناتج := طبع_صحيح_مفسر(المصدر, نوع_الوجهة.البتات);
    };
    أرجع اكتب_ناتج_قيمة(
        الحالة,
        التعليمة,
        قيمة_تشغيل.بتات_عدد(طبع_صحيح_مفسر(الناتج, نوع_الوجهة.البتات))
    );
}

عرف نفذ_تحويل_عائم_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    التحويل: &تحويل_عائم_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_إطار_نشط.موجود(القيمة) -> { موضع_الإطار := القيمة; };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع وصف_التحويل: تحويل_عائم_مسير = *التحويل;
    دع وصف_التعليمة: ناتج_تعليمة_مفسر = *التعليمة;
    دع الوجهة: معرف_قيمة_مسير;
    طابق وصف_التعليمة.الناتج مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
        );
    }
    | اختياري.موجود(القيمة) -> { الوجهة := القيمة; };
    دع الناتج: متغير طبيعي = 0;
    طابق وصف_التحويل.العملية مع
    | عملية_تحويل_عائم.موقع_إلى_عائم -> {
        دع المصدر: طبيعي; دع نوع_المصدر: وصف_صحيح_مفسر;
        طابق اقرأ_صحيح_مفسر(الحالة, الإطار, الأنواع, المسير, وصف_التحويل.المصدر) مع
        | نتيجة_صحيح_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_صحيح_مفسر.موجود(الخام, الوصف) -> { المصدر := الخام; نوع_المصدر := الوصف; };
        طابق وصف_عائم_لمعرف(الأنواع, المسير, الوجهة) مع
        | نتيجة_وصف_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_وصف_عائم_مفسر.موجود(الوصف) -> {
            الناتج := صحيح_إلى_عائم_برمجي(المصدر, نوع_المصدر.البتات, صواب, الوصف);
        };
    }
    | عملية_تحويل_عائم.طبيعي_إلى_عائم -> {
        دع المصدر: طبيعي; دع نوع_المصدر: وصف_صحيح_مفسر;
        طابق اقرأ_صحيح_مفسر(الحالة, الإطار, الأنواع, المسير, وصف_التحويل.المصدر) مع
        | نتيجة_صحيح_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_صحيح_مفسر.موجود(الخام, الوصف) -> { المصدر := الخام; نوع_المصدر := الوصف; };
        طابق وصف_عائم_لمعرف(الأنواع, المسير, الوجهة) مع
        | نتيجة_وصف_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_وصف_عائم_مفسر.موجود(الوصف) -> {
            الناتج := صحيح_إلى_عائم_برمجي(المصدر, نوع_المصدر.البتات, خطأ, الوصف);
        };
    }
    | عملية_تحويل_عائم.عائم_إلى_موقع -> {
        دع المصدر: طبيعي; دع نوع_المصدر: وصف_عائم_برمجي;
        طابق اقرأ_عائم_مفسر(الحالة, الإطار, الأنواع, المسير, وصف_التحويل.المصدر) مع
        | نتيجة_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_عائم_مفسر.موجود(الخام, النوع) -> { المصدر := الخام; نوع_المصدر := النوع; };
        طابق وصف_صحيح_لمعرف(الأنواع, المسير, الوجهة) مع
        | نتيجة_وصف_صحيح_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_وصف_صحيح_مفسر.موجود(الوصف) -> {
            الناتج := عائم_إلى_صحيح_برمجي(المصدر, نوع_المصدر, الوصف.البتات, صواب);
        };
    }
    | عملية_تحويل_عائم.عائم_إلى_طبيعي -> {
        دع المصدر: طبيعي; دع نوع_المصدر: وصف_عائم_برمجي;
        طابق اقرأ_عائم_مفسر(الحالة, الإطار, الأنواع, المسير, وصف_التحويل.المصدر) مع
        | نتيجة_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_عائم_مفسر.موجود(الخام, النوع) -> { المصدر := الخام; نوع_المصدر := النوع; };
        طابق وصف_صحيح_لمعرف(الأنواع, المسير, الوجهة) مع
        | نتيجة_وصف_صحيح_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_وصف_صحيح_مفسر.موجود(الوصف) -> {
            الناتج := عائم_إلى_صحيح_برمجي(المصدر, نوع_المصدر, الوصف.البتات, خطأ);
        };
    }
    | عملية_تحويل_عائم.عائم_إلى_عائم -> {
        دع المصدر: طبيعي; دع نوع_المصدر: وصف_عائم_برمجي;
        طابق اقرأ_عائم_مفسر(الحالة, الإطار, الأنواع, المسير, وصف_التحويل.المصدر) مع
        | نتيجة_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_عائم_مفسر.موجود(الخام, النوع) -> { المصدر := الخام; نوع_المصدر := النوع; };
        طابق وصف_عائم_لمعرف(الأنواع, المسير, الوجهة) مع
        | نتيجة_وصف_عائم_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_وصف_عائم_مفسر.موجود(الوصف) -> {
            الناتج := عائم_إلى_عائم_برمجي(المصدر, نوع_المصدر, الوصف);
        };
    };
    أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.بتات_عدد(الناتج));
}

عرف اجمع_قيم_معرفات(
    الإطار: &إطار_تفسير_مسير,
    المعرفات: &متجه معرف_قيمة_مسير
): نتيجة_قراءة_ذاكرة_مفسر {
    دع القيم: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعرفات) مثل طبيعي)) {
        طابق اقرأ_قيمة_خانة_مسير(الإطار, (*المعرفات)[ف]) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            ألحق(القيم, القيمة);
        };
        ف := ف + 1;
    }
    أرجع نتيجة_قراءة_ذاكرة_مفسر.قيمة(قيمة_تشغيل.تجميع(القيم));
}

عرف نفذ_تجميع_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    التجميع: &تجميع_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    طابق اجمع_قيم_معرفات(الإطار, &(*التجميع).الأعضاء) مع
    | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> {
        أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, القيمة);
    };
}


عرف نفذ_تهيئة_متجه_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    التهيئة: &تهيئة_متجه_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    // The element Type decides the buffer form (bytes for u8).
    دع نوع_العنصر: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق (*التعليمة).الناتج مع
    | اختياري.موجود(المعرف) -> {
        طابق نوع_قيمة_مفسر(المسير, المعرف) مع
        | اختياري.موجود(النوع) -> { نوع_العنصر := نوع_عنصر_تسلسل_دلالي(الأنواع, النوع); }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    دع العناصر: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التهيئة).العناصر) مثل طبيعي)) {
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], (*التهيئة).العناصر[ف]) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> { ألحق(العناصر, القيمة); };
        ف := ف + 1;
    }
    دع المخزن: متغير معرف_مخزن_مفسر = معرف_مخزن_مفسر_من(0, 0);
    طابق نوع_العنصر مع
    | اختياري.موجود(النوع) -> {
        دع الحجم: طبيعي = حجم_عنصر_لهدف_مفسر(الأنواع, &(*الحالة).الهدف, النوع);
        المخزن := مخزن_عناصر_بحجم_مفسر(&متغير (*الحالة).الذاكرة, العناصر, الأنواع, النوع, الحجم);
    }
    | اختياري.لا_شيء -> {
        المخزن := خصص_مخزن_قيم_مفسر(&متغير (*الحالة).الذاكرة, العناصر);
    };
    أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.مخزن(المخزن));
}

عرف نفذ_استخراج_حقل_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    الاستخراج: &استخراج_حقل_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع وصف_الاستخراج: استخراج_حقل_مسير = *الاستخراج;
    طابق اقرأ_قيمة_خانة_مسير(الإطار, وصف_الاستخراج.المصدر) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.تجميع(الأعضاء) -> {
            دع العدد: طبيعي = الطول(الأعضاء) مثل طبيعي;
            إذا (وصف_الاستخراج.الفهرس >= العدد) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.فهرس_خارج_المدى(
                            وصف_الاستخراج.المصدر,
                            وصف_الاستخراج.الفهرس,
                            العدد
                        )
                    )
                );
            };
            دع العضو: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الأعضاء[وصف_الاستخراج.الفهرس]);
            أرجع اكتب_ناتج_قيمة(
                الحالة,
                التعليمة,
                العضو
            );
        }
        | _ -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.قيمة_تجميع_متوقعة(وصف_الاستخراج.المصدر)
                )
            );
        };
    };
}

عرف نفذ_استخراج_فهرس_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    الاستخراج: &استخراج_فهرس_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع وصف_الاستخراج: استخراج_فهرس_مسير = *الاستخراج;
    دع الفهرس: طبيعي;
    طابق اقرأ_فهرس_مفسر(الحالة, الإطار, الأنواع, المسير, وصف_الاستخراج.الفهرس) مع
    | نتيجة_فهرس_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_فهرس_مفسر.موجود(القيمة) -> {
        الفهرس := القيمة;
    };
    طابق اقرأ_قيمة_خانة_مسير(الإطار, وصف_الاستخراج.المصدر) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.مخزن(المخزن) -> {
            // A vector, slice or text element (text indexing is bytes).
            طابق اقرأ_عنصر_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن, الفهرس) مع
            | اختياري.موجود(العضو) -> { أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, العضو); }
            | اختياري.لا_شيء -> {
                دع العدد: متغير طبيعي = 0;
                طابق طول_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن) مع
                | اختياري.موجود(الطول_الكلي) -> { العدد := الطول_الكلي; }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تعليمة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المخزن.القيمة)
                    ));
                };
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.فهرس_خارج_المدى(
                            وصف_الاستخراج.الفهرس, الفهرس, العدد
                        )
                    )
                );
            };
        }
        | قيمة_تشغيل.تجميع(الأعضاء) -> {
            دع العدد: طبيعي = الطول(الأعضاء) مثل طبيعي;
            إذا (الفهرس >= العدد) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.فهرس_خارج_المدى(
                            وصف_الاستخراج.الفهرس, الفهرس, العدد
                        )
                    )
                );
            };
            أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, انسخ_قيمة_تشغيل(&الأعضاء[الفهرس]));
        }
        | _ -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.قيمة_تجميع_متوقعة(وصف_الاستخراج.المصدر)
                )
            );
        };
    };
}

عرف نفذ_مكان_محلي_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    المكان: &مكان_محلي_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &متغير إطار_تفسير_مسير = &متغير (*الحالة).المكدس[موضع_الإطار];
    // The cells of a returned activation at this stack position are reused.
    دع موضع_الخلية: طبيعي = (*الإطار).عدد_المحليات;
    دع الخلية: معرف_خلية_محلية_مفسر = معرف_خلية_محلية_مفسر_من(موضع_الخلية);
    دع الخلية_الجديدة: خلية_محلية_مفسر = { مهيأة: خطأ, القيمة: قيمة_تشغيل.مؤشر_فارغ() };
    إذا (موضع_الخلية < (الطول((*الإطار).المحليات) مثل طبيعي)) {
        (*الإطار).المحليات[موضع_الخلية] := الخلية_الجديدة;
    } وإلا {
        ألحق((*الإطار).المحليات, الخلية_الجديدة);
    };
    (*الإطار).عدد_المحليات := موضع_الخلية + 1;
    دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [];
    دع وصف_المكان: مكان_محلي_مسير = *المكان;
    دع الجذر: جذر_مكان_تشغيل = جذر_مكان_تشغيل.محلي((*الإطار).التفعيل, الخلية);
    دع قابل_للكتابة: منطقي = وصف_المكان.قابل_للكتابة;
    دع الموضع: مكان_تشغيل = {
        الجذر: الجذر,
        الإسقاطات: الإسقاطات,
        قابل_للكتابة: قابل_للكتابة
    };
    دع وصف_التعليمة: ناتج_تعليمة_مفسر = *التعليمة;
    طابق وصف_التعليمة.الناتج مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
        );
    }
    | اختياري.موجود(المعرف) -> {
        طابق اكتب_مكان_خانة_مسير(الإطار, المعرف, الموضع) مع
        | نتيجة_كتابة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
        }
        | نتيجة_كتابة_خانة.نجحت -> { };
    };
    طابق زد_مؤشر_التعليمة_واحفظ(الإطار) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.استمر();
    };
}

// MSIR owns the type-checked move between a byte vector, a slice and a text:
// the value keeps its buffer, as the native transfer keeps the pointer. A
// text buffer is a byte buffer, so a vector becoming text is stored as bytes.
عرف نفذ_نقل_تسلسل_مملوك_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    النقل: &نقل_تسلسل_مملوك_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_إطار_نشط.موجود(القيمة) -> { موضع_الإطار := القيمة; };
    طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], (*النقل).المصدر) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.مخزن(المخزن) -> {
            دع إلى_نص: متغير منطقي = خطأ;
            طابق (*التعليمة).الناتج مع
            | اختياري.موجود(معرف_الناتج) -> {
                طابق نوع_قيمة_مفسر(المسير, معرف_الناتج) مع
                | اختياري.موجود(نوع_الناتج) -> { إلى_نص := نوع_نص_مفسر(الأنواع, نوع_الناتج); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            إذا (إلى_نص && !اجعل_مخزن_بايتات_مفسر(&متغير (*الحالة).الذاكرة, المخزن)) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                );
            };
            أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.مخزن(المخزن));
        }
        | _ -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
            );
        };
    };
}

// A reference or raw pointer as a raw pointer, and (`p as u64`, `a as *T`)
// a raw pointer read as its address or an address taken as a pointer. The
// checked interpreter's storage has no addresses: a place read as an integer
// gets a stable one of its own (execution_state.sn عنوان_مكان_مفسر), which
// names that place again when taken back as a pointer; the null pointer is 0.
عرف نفذ_مرجع_إلى_مؤشر_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    التحويل: &مرجع_إلى_مؤشر_مسير
): نتيجة_تعليمة_مفسر {
    // Whether the result is the integer address (`p as u64`).
    دع ناتج_صحيح: متغير منطقي = خطأ;
    طابق (*التعليمة).الناتج مع
    | اختياري.موجود(الوجهة) -> {
        طابق وصف_مصدر_تحويل_صحيح_لمعرف(الأنواع, المسير, الوجهة) مع
        | نتيجة_وصف_صحيح_مفسر.موجود(_) -> { ناتج_صحيح := صواب; }
        | نتيجة_وصف_صحيح_مفسر.أخفق(_) -> { };
    }
    | اختياري.لا_شيء -> { };
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: مرجع_إلى_مؤشر_مسير = *التحويل;
    طابق اقرأ_قيمة_خانة_مسير(الإطار, الوصف.المرجع) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.مرجع(المكان) -> {
            إذا (!هوية_مكان_مفسر_صالحة(
                &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
                &(*الحالة).الذاكرة, &المكان
            )) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.مرجع_تالف(الوصف.المرجع)
                    )
                );
            };
            إذا (ناتج_صحيح) {
                دع العنوان: طبيعي = عنوان_مكان_مفسر(الحالة, &المكان);
                أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.بتات_عدد(العنوان));
            };
            أرجع اكتب_ناتج_قيمة(
                الحالة, التعليمة, قيمة_تشغيل.مرجع(المكان)
            );
        }
        | قيمة_تشغيل.مؤشر_فارغ -> {
            إذا (ناتج_صحيح) { أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.بتات_عدد(0)); };
            أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.مؤشر_فارغ());
        }
        | قيمة_تشغيل.بتات_عدد(العنوان) -> {
            إذا (ناتج_صحيح) { أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.بتات_عدد(العنوان)); };
            إذا (العنوان == 0) { أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.مؤشر_فارغ()); };
            طابق مكان_عنوان_مفسر(الحالة, العنوان) مع
            | اختياري.موجود(المكان) -> {
                إذا (هوية_مكان_مفسر_صالحة(
                    &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
                    &(*الحالة).الذاكرة, &المكان
                )) {
                    أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.مرجع(المكان));
                };
            }
            | اختياري.لا_شيء -> { };
            // An address the program made up, or of storage that is gone:
            // nothing the checked interpreter holds is there.
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.مرجع_تالف(الوصف.المرجع)
                )
            );
        }
        | _ -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.نوع_مرجع_غير_متسق(الوصف.المرجع)
                )
            );
        };
    };
}

عرف نفذ_مكان_عام_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    المكان: &مكان_عام_مسير
): نتيجة_تعليمة_مفسر {
    دع الوصف: مكان_عام_مسير = *المكان;
    طابق عام_مسير_عند(&(*المسير).المسير, الوصف.العام) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف()));
    }
    | اختياري.موجود(العام) -> {
        طابق العام.الاسم_الخارجي مع
        | اختياري.موجود(_) -> {
            // An imported global has no MSIR initializer. It must already
            // have been bound to interpreter-owned startup storage; never
            // synthesize a value from the placeholder constant (or host argv).
            دع إسقاطات: متجه إسقاط_مكان_تشغيل = [];
            دع جذر: جذر_مكان_تشغيل = جذر_مكان_تشغيل.عام(الوصف.العام);
            دع موضع: مكان_تشغيل = {
                الجذر: جذر, الإسقاطات: إسقاطات, قابل_للكتابة: خطأ
            };
            إذا (!هوية_مكان_مفسر_صالحة(
                &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
                &(*الحالة).الذاكرة, &موضع
            )) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                );
            };
        }
        | اختياري.لا_شيء -> {
            // The initializer runs once, on the first use of the global.
            إذا (!عام_مفسر_مهيأ(&(*الحالة).الذاكرة, الوصف.العام)) {
                دع القيمة: قيمة_تشغيل;
                طابق قيمة_متجه_ثابت_مفسر(&متغير (*الحالة).الذاكرة, &العام.التهيئة, العام.النوع, الأنواع) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تعليمة_مفسر.أخفق(
                        فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                    );
                }
                | اختياري.موجود(المهيأة) -> { القيمة := المهيأة; };
                هيئ_عام_مفسر(&متغير (*الحالة).الذاكرة, الوصف.العام, القيمة);
            };
        };
    };
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_إطار_نشط.موجود(القيمة) -> { موضع_الإطار := القيمة; };
    دع الإطار: &متغير إطار_تفسير_مسير = &متغير (*الحالة).المكدس[موضع_الإطار];
    دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [];
    دع الجذر: جذر_مكان_تشغيل = جذر_مكان_تشغيل.عام(الوصف.العام);
    دع موضع: مكان_تشغيل = { الجذر: الجذر, الإسقاطات: الإسقاطات, قابل_للكتابة: الوصف.قابل_للكتابة };
    دع وصف_التعليمة: ناتج_تعليمة_مفسر = *التعليمة;
    طابق وصف_التعليمة.الناتج مع
    | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_مفسر.أخفق(فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())); }
    | اختياري.موجود(المعرف) -> {
        طابق اكتب_مكان_خانة_مسير(الإطار, المعرف, موضع) مع
        | نتيجة_كتابة_خانة.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
        | نتيجة_كتابة_خانة.نجحت -> { };
    };
    طابق زد_مؤشر_التعليمة_واحفظ(الإطار) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | اختياري.لا_شيء -> { أرجع نتيجة_تعليمة_مفسر.استمر(); };
}

عرف نفذ_مرجع_إلى_مكان_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    التحويل: &مرجع_إلى_مكان_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: مرجع_إلى_مكان_مسير = *التحويل;
    طابق اقرأ_قيمة_خانة_مسير(الإطار, الوصف.المرجع) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.مرجع(قيمة_المكان) -> {
            دع المكان: متغير مكان_تشغيل = قيمة_المكان;
            دع نوع_المرجع: معرف_نوع;
            طابق نوع_قيمة_مفسر(المسير, الوصف.المرجع) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.قيمة_مسير_مفقودة(الوصف.المرجع)
                    )
                );
            }
            | اختياري.موجود(القيمة) -> {
                نوع_المرجع := القيمة;
            };
            طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, نوع_المرجع) مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> {
                طابق نوع_داخل_مرجع_دلالي(الأنواع, نوع_المرجع) مع
                | اختياري.موجود(_) -> {
                    المكان.قابل_للكتابة := خطأ;
                }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تعليمة_مفسر.أخفق(
                        فشل_تفسير_مسير.خلل_داخلي(
                            خلل_داخلي_مفسر.نوع_مرجع_غير_متسق(الوصف.المرجع)
                        )
                    );
                };
            };
            إذا (!هوية_مكان_مفسر_صالحة(
                &(*الحالة).المكدس,
                عمق_مكدس_مفسر(الحالة),
                &(*الحالة).الذاكرة,
                &المكان
            )) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.مرجع_تالف(الوصف.المرجع)
                    )
                );
            };
            أرجع اكتب_ناتج_مكان(الحالة, التعليمة, المكان);
        }
        | _ -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.مرجع_تالف(الوصف.المرجع)
                )
            );
        };
    };
}

عرف نفذ_صندوق_إلى_مكان_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    التحويل: &صندوق_إلى_مكان_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: صندوق_إلى_مكان_مسير = *التحويل;
    طابق اقرأ_قيمة_خانة_مسير(الإطار, الوصف.الصندوق) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.صندوق(المعرف) -> {
            إذا (!هوية_صندوق_مفسر_صالحة(&(*الحالة).الذاكرة, المعرف)) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                    )
                );
            };
            دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [];
            دع الجذر: جذر_مكان_تشغيل = جذر_مكان_تشغيل.صندوق(المعرف);
            دع المكان: مكان_تشغيل = {
                الجذر: الجذر,
                الإسقاطات: الإسقاطات,
                قابل_للكتابة: صواب
            };
            أرجع اكتب_ناتج_مكان(الحالة, التعليمة, المكان);
        }
        | _ -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.قيمة_صندوق_متوقعة(الوصف.الصندوق)
                )
            );
        };
    };
}

عرف نفذ_مكان_حقل_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    الوصف_المكان: &مكان_حقل_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: مكان_حقل_مسير = *الوصف_المكان;
    طابق اقرأ_مكان_خانة_مسير(الإطار, الوصف.الأصل) مع
    | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_مكان_خانة.موجود(الأصل) -> {
        دع المكان: متغير مكان_تشغيل = انسخ_مكان_تشغيل(&الأصل);
        ألحق(المكان.الإسقاطات, إسقاط_مكان_تشغيل.حقل(الوصف.الفهرس));
        إذا (!هوية_مكان_مفسر_صالحة(
            &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
            &(*الحالة).الذاكرة, &المكان
        )) {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الوصف.الفهرس)
                )
            );
        };
        أرجع اكتب_ناتج_مكان(الحالة, التعليمة, المكان);
    };
}

عرف نفذ_مكان_فهرس_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    الوصف_المكان: &مكان_فهرس_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: مكان_فهرس_مسير = *الوصف_المكان;
    دع الفهرس: طبيعي;
    طابق اقرأ_فهرس_مفسر(الحالة, الإطار, الأنواع, المسير, الوصف.الفهرس) مع
    | نتيجة_فهرس_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_فهرس_مفسر.موجود(القيمة) -> {
        الفهرس := القيمة;
    };
    طابق اقرأ_مكان_خانة_مسير(الإطار, الوصف.الأصل) مع
    | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_مكان_خانة.موجود(الأصل) -> {
        // An element of a vector, slice or text is a place in its buffer:
        // the handle is read now, as native code reads the data pointer.
        طابق مخزن_عند_مكان_مفسر(
            &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة), &(*الحالة).الذاكرة, &الأصل
        ) مع
        | اختياري.موجود(المخزن) -> {
            دع الإسقاط: إسقاط_مكان_تشغيل = إسقاط_مكان_تشغيل.فهرس(الفهرس);
            دع إسقاطات_المخزن: متجه إسقاط_مكان_تشغيل = [الإسقاط];
            دع مكان_العنصر: مكان_تشغيل = {
                الجذر: جذر_مكان_تشغيل.مخزن(المخزن),
                الإسقاطات: إسقاطات_المخزن,
                قابل_للكتابة: الأصل.قابل_للكتابة
            };
            دع العدد: متغير طبيعي = 0;
            طابق طول_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن) مع
            | اختياري.موجود(الطول_الكلي) -> { العدد := الطول_الكلي; }
            | اختياري.لا_شيء -> { };
            // Element 0 of an empty buffer is its start, which drop glue
            // releases when an emptied vector keeps its buffer; reading or
            // writing through it still fails (MSIR checks every user index).
            إذا (الفهرس >= العدد && !(الفهرس == 0 && العدد == 0)) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.فهرس_خارج_المدى(الوصف.الفهرس, الفهرس, العدد)
                    )
                );
            };
            أرجع اكتب_ناتج_مكان(الحالة, التعليمة, مكان_العنصر);
        }
        | اختياري.لا_شيء -> { };
        دع المكان: متغير مكان_تشغيل = انسخ_مكان_تشغيل(&الأصل);
        ألحق(المكان.الإسقاطات, إسقاط_مكان_تشغيل.فهرس(الفهرس));
        إذا (!هوية_مكان_مفسر_صالحة(
            &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
            &(*الحالة).الذاكرة, &المكان
        )) {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
                )
            );
        };
        أرجع اكتب_ناتج_مكان(الحالة, التعليمة, المكان);
    };
}

عرف نفذ_موضع_تخزين_عنصر_مؤشر_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    الوصف_الموضع: &موضع_تخزين_عنصر_مؤشر_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: موضع_تخزين_عنصر_مؤشر_مسير = *الوصف_الموضع;
    دع الفهرس: طبيعي;
    طابق اقرأ_فهرس_مفسر(الحالة, الإطار, الأنواع, المسير, الوصف.الفهرس) مع
    | نتيجة_فهرس_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_فهرس_مفسر.موجود(القيمة) -> {
        الفهرس := القيمة;
    };
    طابق اقرأ_قيمة_خانة_مسير(الإطار, الوصف.المؤشر) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.مرجع(الأصل) -> {
            إذا (!هوية_مكان_مفسر_صالحة(
                &(*الحالة).المكدس,
                عمق_مكدس_مفسر(الحالة),
                &(*الحالة).الذاكرة,
                &الأصل
            )) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.مرجع_تالف(الوصف.المؤشر)
                    )
                );
            };

            دع المكان: متغير مكان_تشغيل = انسخ_مكان_تشغيل(&الأصل);
            إذا (الفهرس != 0) {
                دع عدد_الإسقاطات: طبيعي = الطول(المكان.الإسقاطات) مثل طبيعي;
                إذا (عدد_الإسقاطات == 0) {
                    أرجع نتيجة_تعليمة_مفسر.أخفق(
                        فشل_تفسير_مسير.وقت_تشغيل(
                            خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
                        )
                    );
                }
                وإلا {
                    دع آخر: طبيعي = عدد_الإسقاطات - 1;
                    طابق المكان.الإسقاطات[آخر] مع
                    | إسقاط_مكان_تشغيل.فهرس(الأساس) -> {
                        إذا (الفهرس > (~((0 مثل طبيعي)) - الأساس)) {
                            أرجع نتيجة_تعليمة_مفسر.أخفق(
                                فشل_تفسير_مسير.وقت_تشغيل(
                                    خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
                                )
                            );
                        };
                        المكان.الإسقاطات[آخر] :=
                            إسقاط_مكان_تشغيل.فهرس(الأساس + الفهرس);
                    }
                    | إسقاط_مكان_تشغيل.حقل(_) -> {
                        أرجع نتيجة_تعليمة_مفسر.أخفق(
                            فشل_تفسير_مسير.وقت_تشغيل(
                                خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
                            )
                        );
                    };
                };
            };
            // Never turn an out-of-bounds semantic projection into a live pointer.
            إذا (!هوية_مكان_مفسر_صالحة(
                &(*الحالة).المكدس,
                عمق_مكدس_مفسر(الحالة),
                &(*الحالة).الذاكرة,
                &المكان
            )) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
                    )
                );
            };
            أرجع اكتب_ناتج_مكان(الحالة, التعليمة, المكان);
        }
        | _ -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.مرجع_تالف(الوصف.المؤشر)
                )
            );
        };
    };
}

// Reads the place a slot of the active frame holds where it is: no copy of
// the place's projection path.
عرف اقرأ_مكان_خانة_نشطة_مفسر(
    الحالة: &حالة_تنفيذ_مفسر,
    العمق: طبيعي,
    معرف_المكان: معرف_قيمة_مسير
): نتيجة_قراءة_ذاكرة_مفسر {
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الحالة).المكدس[العمق - 1].الخانات;
    إذا ((معرف_المكان.القيمة مثل طبيعي) >= (الطول(*الخانات) مثل طبيعي)) {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.معرف_خانة_خارج_المدى(معرف_المكان))
        );
    };
    طابق (*الخانات)[معرف_المكان.القيمة] مع
    | خانة_تنفيذ_مسير.مكان(المكان) -> {
        أرجع اقرأ_مكان_مفسر(&(*الحالة).المكدس, العمق, &(*الحالة).الذاكرة, &المكان);
    }
    | خانة_تنفيذ_مسير.غير_مهيأة -> {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_غير_مهيأة(معرف_المكان))
        );
    }
    | خانة_تنفيذ_مسير.قيمة(_) -> {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.خانة_ليست_مكانا(معرف_المكان))
        );
    };
}

عرف نفذ_تحميل_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    التحميل: &تحميل_مسير
): نتيجة_تعليمة_مفسر {
    دع العمق: طبيعي = عمق_مكدس_مفسر(الحالة);
    إذا (العمق == 0) {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        );
    };
    طابق اقرأ_مكان_خانة_نشطة_مفسر(الحالة, العمق, (*التحميل).المكان) مع
    | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ); }
    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> { أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, القيمة); };
}

عرف نفذ_تخزين_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    التخزين: &تخزين_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع وصف_التخزين: تخزين_مسير = *التخزين;
    دع المكان: مكان_تشغيل;
    طابق اقرأ_مكان_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], وصف_التخزين.المكان) مع
    | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_مكان_خانة.موجود(القيمة) -> {
        المكان := القيمة;
    };
    إذا (!المكان.قابل_للكتابة) {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.مكان_للقراءة_فقط(وصف_التخزين.المكان)
            )
        );
    };
    دع القيمة: قيمة_تشغيل;
    طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], وصف_التخزين.القيمة) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(الموجودة) -> {
        القيمة := الموجودة;
    };
    دع وصف_التعليمة: ناتج_تعليمة_مفسر = *التعليمة;
    طابق وصف_التعليمة.الناتج مع
    | اختياري.موجود(_) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة())
        );
    }
    | اختياري.لا_شيء -> { };

    زد_مؤشر_تعليمة_مفسر(الحالة, موضع_الإطار);
    دع عمق_المكدس_الحالي: طبيعي = عمق_مكدس_مفسر(الحالة);
    طابق اكتب_مكان_مفسر(
        &متغير (*الحالة).المكدس,
        عمق_المكدس_الحالي,
        &متغير (*الحالة).الذاكرة,
        &المكان,
        القيمة
    ) مع
    | نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_كتابة_ذاكرة_مفسر.نجحت -> {
        أرجع نتيجة_تعليمة_مفسر.استمر();
    };
}

عرف نفذ_مكان_إلى_مرجع_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    التحويل: &مكان_إلى_مرجع_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: مكان_إلى_مرجع_مسير = *التحويل;
    دع المكان: متغير مكان_تشغيل;
    طابق اقرأ_مكان_خانة_مسير(الإطار, الوصف.المكان) مع
    | نتيجة_قراءة_مكان_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_مكان_خانة.موجود(القيمة) -> {
        المكان := القيمة;
    };

    دع وصف_التعليمة: ناتج_تعليمة_مفسر = *التعليمة;
    دع الوجهة: معرف_قيمة_مسير;
    طابق وصف_التعليمة.الناتج مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة())
        );
    }
    | اختياري.موجود(القيمة) -> {
        الوجهة := القيمة;
    };
    دع نوع_الوجهة: معرف_نوع;
    طابق نوع_قيمة_مفسر(المسير, الوجهة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.قيمة_مسير_مفقودة(الوجهة))
        );
    }
    | اختياري.موجود(القيمة) -> {
        نوع_الوجهة := القيمة;
    };
    دع مرجع_متغير: متغير منطقي = خطأ;
    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, نوع_الوجهة) مع
    | اختياري.موجود(_) -> {
        مرجع_متغير := صواب;
    }
    | اختياري.لا_شيء -> {
        طابق نوع_داخل_مرجع_دلالي(الأنواع, نوع_الوجهة) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.نوع_مرجع_غير_متسق(الوجهة)
                )
            );
        };
    };
    إذا (!مرجع_متغير) {
        المكان.قابل_للكتابة := خطأ;
    };
    إذا (!هوية_مكان_مفسر_صالحة(
        &(*الحالة).المكدس, عمق_مكدس_مفسر(الحالة),
        &(*الحالة).الذاكرة, &المكان
    )) {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.مرجع_تالف(الوصف.المكان))
        );
    };
    أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.مرجع(المكان));
}

عرف نفذ_بناء_موسوم_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    البناء: &بناء_موسوم_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: بناء_موسوم_مسير = *البناء;
    دع الحمولات: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الوصف.الحمولات) مثل طبيعي)) {
        طابق اقرأ_قيمة_خانة_مسير(الإطار, الوصف.الحمولات[ف]) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            ألحق(الحمولات, القيمة);
        };
        ف := ف + 1;
    }
    دع الموسوم: قيمة_موسومة_تشغيل = {
        المنشئ: الوصف.المنشئ,
        الحمولات: الحمولات
    };
    أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, قيمة_تشغيل.موسوم(الموسوم));
}

عرف نفذ_استعلام_وسم_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    التعليمة: &ناتج_تعليمة_مفسر,
    الاستعلام: &استعلام_وسم_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: استعلام_وسم_مسير = *الاستعلام;
    طابق اقرأ_قيمة_خانة_مسير(الإطار, الوصف.المصدر) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.موسوم(الموسوم) -> {
            دع وصف_التعليمة: ناتج_تعليمة_مفسر = *التعليمة;
            طابق وصف_التعليمة.الناتج مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة()
                    )
                );
            }
            | اختياري.موجود(المعرف) -> {
                            طابق وصف_صحيح_لمعرف(الأنواع, المسير, المعرف) مع
                | نتيجة_وصف_صحيح_مفسر.أخفق(الخطأ) -> {
                    أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
                }
                | نتيجة_وصف_صحيح_مفسر.موجود(نوع_الوسم) -> {
                    أرجع اكتب_ناتج_قيمة(
                        الحالة,
                        التعليمة,
                        قيمة_تشغيل.بتات_عدد(
                            طبع_صحيح_مفسر(الموسوم.المنشئ, نوع_الوسم.البتات)
                        )
                    );
                };
            };
        }
        | _ -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.قيمة_موسومة_متوقعة(الوصف.المصدر)
                )
            );
        };
    };
}

عرف نفذ_استخراج_حمولة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    الاستخراج: &استخراج_حمولة_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع الوصف: استخراج_حمولة_مسير = *الاستخراج;
    طابق اقرأ_قيمة_خانة_مسير(الإطار, الوصف.المصدر) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        طابق القيمة مع
        | قيمة_تشغيل.موسوم(الموسوم) -> {
            إذا (الموسوم.المنشئ != الوصف.المنشئ) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.منشئ_موسوم_غير_مطابق(
                            الوصف.المنشئ,
                            الموسوم.المنشئ
                        )
                    )
                );
            };
            دع العدد: طبيعي = الطول(الموسوم.الحمولات) مثل طبيعي;
            إذا (الوصف.الحمولة >= العدد) {
                أرجع نتيجة_تعليمة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.حمولة_موسومة_خارج_المدى(
                            الوصف.الحمولة,
                            العدد
                        )
                    )
                );
            };
            دع الحمولة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الموسوم.الحمولات[الوصف.الحمولة]);
            أرجع اكتب_ناتج_قيمة(
                الحالة,
                التعليمة,
                الحمولة
            );
        }
        | _ -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.قيمة_موسومة_متوقعة(الوصف.المصدر)
                )
            );
        };
    };
}

عرف نفذ_بناء_صندوق_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    البناء: &بناء_صندوق_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الوصف: بناء_صندوق_مسير = *البناء;
    طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], الوصف.القيمة) مع
    | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
        دع الصندوق: معرف_صندوق_مفسر = خصص_صندوق_مفسر(&متغير (*الحالة).الذاكرة, القيمة);
        أرجع اكتب_ناتج_قيمة(
            الحالة,
            التعليمة,
            قيمة_تشغيل.صندوق(الصندوق)
        );
    };
}

عرف نفذ_بناء_إغلاق_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    البناء: &بناء_إغلاق_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الوصف: بناء_إغلاق_مسير = *البناء;
    دع الالتقاطات: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الوصف.الالتقاطات) مثل طبيعي)) {
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[موضع_الإطار], الوصف.الالتقاطات[ف]) مع
        | نتيجة_قراءة_قيمة_خانة.أخفق(الخطأ) -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_قيمة_خانة.موجودة(القيمة) -> {
            ألحق(الالتقاطات, القيمة);
        };
        ف := ف + 1;
    }
    دع معرف_الإغلاق: معرف_إغلاق_مفسر = خصص_إغلاق_مفسر(
        &متغير (*الحالة).الذاكرة,
        الوصف.الدالة,
        الالتقاطات,
        الوصف.المدمر
    );
    أرجع اكتب_ناتج_قيمة(
        الحالة,
        التعليمة,
        قيمة_تشغيل.إغلاق(معرف_الإغلاق)
    );
}

عرف نفذ_استخراج_التقاط_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    التعليمة: &ناتج_تعليمة_مفسر,
    الاستخراج: &استخراج_التقاط_مسير
): نتيجة_تعليمة_مفسر {
    دع موضع_الإطار: طبيعي;
    طابق اقرأ_الإطار_النشط(الحالة) مع
    | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_إطار_نشط.موجود(القيمة) -> {
        موضع_الإطار := القيمة;
    };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[موضع_الإطار];
    دع معرف_الإغلاق: معرف_إغلاق_مفسر;
    طابق (*الإطار).الإغلاق مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
            )
        );
    }
    | اختياري.موجود(المعرف) -> {
        معرف_الإغلاق := المعرف;
    };
    دع الوصف: استخراج_التقاط_مسير = *الاستخراج;
    طابق التقاط_إغلاق_مفسر_عند(
        &(*الحالة).الذاكرة,
        معرف_الإغلاق,
        الوصف.الفهرس
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تعليمة_مفسر.أخفق(
            فشل_تفسير_مسير.خلل_داخلي(
                خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة()
            )
        );
    }
    | اختياري.موجود(القيمة) -> {
        أرجع اكتب_ناتج_قيمة(الحالة, التعليمة, القيمة);
    };
}

عام عرف نفذ_تعليمة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    العملية: &عملية_مسير,
    التعليمة: &ناتج_تعليمة_مفسر
): نتيجة_تعليمة_مفسر {
    دع الوصف: ناتج_تعليمة_مفسر = *التعليمة;
    طابق *العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        أرجع نفذ_ثابت_مفسر(الحالة, الأنواع, المسير, التعليمة, &الثابت);
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        أرجع نفذ_حساب_صحيح_مفسر(الحالة, الأنواع, المسير, التعليمة, &الحساب);
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        أرجع نفذ_مقارنة_صحيح_مفسر(الحالة, الأنواع, المسير, التعليمة, &المقارنة);
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        أرجع نفذ_حساب_عشري_مفسر(الحالة, الأنواع, المسير, التعليمة, &الحساب);
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        أرجع نفذ_مقارنة_عشري_مفسر(الحالة, الأنواع, المسير, التعليمة, &المقارنة);
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        أرجع نفذ_تحويل_صحيح_مفسر(الحالة, الأنواع, المسير, التعليمة, &التحويل);
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        أرجع نفذ_تحويل_عائم_مفسر(الحالة, الأنواع, المسير, التعليمة, &التحويل);
    }
    | عملية_مسير.تجميع(التجميع) -> {
        أرجع نفذ_تجميع_مفسر(الحالة, التعليمة, &التجميع);
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        أرجع نفذ_تهيئة_متجه_مفسر(الحالة, الأنواع, المسير, التعليمة, &التهيئة);
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
        أرجع نفذ_استخراج_حقل_مفسر(الحالة, التعليمة, &الاستخراج);
    }
    | عملية_مسير.استخراج_فهرس(الاستخراج) -> {
        أرجع نفذ_استخراج_فهرس_مفسر(الحالة, الأنواع, المسير, التعليمة, &الاستخراج);
    }
    | عملية_مسير.مكان_محلي(المكان) -> {
        أرجع نفذ_مكان_محلي_مفسر(الحالة, التعليمة, &المكان);
    }
    | عملية_مسير.مكان_عام(المكان) -> {
        أرجع نفذ_مكان_عام_مفسر(الحالة, الأنواع, المسير, التعليمة, &المكان);
    }
    | عملية_مسير.نقل_تسلسل_مملوك(النقل) -> {
        أرجع نفذ_نقل_تسلسل_مملوك_مفسر(الحالة, الأنواع, المسير, التعليمة, &النقل);
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        أرجع نفذ_مرجع_إلى_مؤشر_مفسر(الحالة, الأنواع, المسير, التعليمة, &التحويل);
    }
    | عملية_مسير.مرجع_إلى_مكان(التحويل) -> {
        أرجع نفذ_مرجع_إلى_مكان_مفسر(
            الحالة,
            الأنواع,
            المسير,
            التعليمة,
            &التحويل
        );
    }
    | عملية_مسير.صندوق_إلى_مكان(التحويل) -> {
        أرجع نفذ_صندوق_إلى_مكان_مفسر(الحالة, التعليمة, &التحويل);
    }
    | عملية_مسير.مكان_حقل(المكان) -> {
        أرجع نفذ_مكان_حقل_مفسر(الحالة, التعليمة, &المكان);
    }
    | عملية_مسير.مكان_فهرس(المكان) -> {
        أرجع نفذ_مكان_فهرس_مفسر(الحالة, الأنواع, المسير, التعليمة, &المكان);
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(الموضع) -> {
        أرجع نفذ_موضع_تخزين_عنصر_مؤشر_مفسر(
            الحالة, الأنواع, المسير, التعليمة, &الموضع
        );
    }
    | عملية_مسير.تحميل(التحميل) -> {
        أرجع نفذ_تحميل_مفسر(الحالة, التعليمة, &التحميل);
    }
    | عملية_مسير.تخزين(التخزين) -> {
        أرجع نفذ_تخزين_مفسر(الحالة, التعليمة, &التخزين);
    }
    | عملية_مسير.مكان_إلى_مرجع(التحويل) -> {
        أرجع نفذ_مكان_إلى_مرجع_مفسر(الحالة, الأنواع, المسير, التعليمة, &التحويل);
    }
    | عملية_مسير.بناء_موسوم(البناء) -> {
        أرجع نفذ_بناء_موسوم_مفسر(الحالة, التعليمة, &البناء);
    }
    | عملية_مسير.استعلام_وسم(الاستعلام) -> {
        أرجع نفذ_استعلام_وسم_مفسر(الحالة, الأنواع, المسير, التعليمة, &الاستعلام);
    }
    | عملية_مسير.استخراج_حمولة(الاستخراج) -> {
        أرجع نفذ_استخراج_حمولة_مفسر(الحالة, التعليمة, &الاستخراج);
    }
    | عملية_مسير.بناء_صندوق(البناء) -> {
        أرجع نفذ_بناء_صندوق_مفسر(الحالة, التعليمة, &البناء);
    }
    | عملية_مسير.بناء_إغلاق(البناء) -> {
        أرجع نفذ_بناء_إغلاق_مفسر(الحالة, التعليمة, &البناء);
    }
    | عملية_مسير.استخراج_التقاط(الاستخراج) -> {
        أرجع نفذ_استخراج_التقاط_مفسر(الحالة, التعليمة, &الاستخراج);
    }
    | عملية_مسير.نداء(النداء) -> {
        طابق نفذ_نداء_مفسر(الحالة, الأنواع, المسير, &النداء, الوصف.الناتج) مع
        | نتيجة_نداء_مفسر.استمر -> {
            أرجع نتيجة_تعليمة_مفسر.استمر();
        }
        | نتيجة_نداء_مفسر.أنهى_العملية(الحالة_الخامة) -> {
            أرجع نتيجة_تعليمة_مفسر.أنهى_العملية(الحالة_الخامة);
        }
        | نتيجة_نداء_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_تعليمة_مفسر.أخفق(الخطأ);
        };
    };
}
