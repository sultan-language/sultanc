استورد compiler.interpreter.execution.execution_state;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.memory.memory;
استورد compiler.interpreter.operations.operations;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.identifiers;
استورد compiler.runtime.primitive_identity;

// Fast paths of the dispatch loop, after the specialized handlers of CPython
// 3.11's adaptive interpreter and Lua's integer opcodes: the instructions a
// program executes most (integer constants, arithmetic, comparisons and
// conversions, loads and stores through the common places, element places,
// and branches with at most one edge argument) run here in one step each:
// operands are read in place from the frame's slots, widths and signs come
// from the function's descriptor table (واصف_دالة_مفسر), the result is
// written straight into its slot and the instruction pointer advances. An
// instruction that does not fit (another operand shape, a value that is not
// where the fast path expects it, an operation that would trap or fail)
// changes nothing here and answers خطأ: the checked handler then executes it
// and reports any failure exactly as before.

// The numeric descriptor of slot القيمة of the active frame's function.
عرف رمز_قيمة_سريع(
    الحالة: &حالة_تنفيذ_مفسر,
    الدالة: طبيعي,
    القيمة: طبيعي
): طبيعي {
    دع الواصفات: &متجه واصف_دالة_مفسر = &(*الحالة).واصفات_الدوال;
    إذا (الدالة >= (الطول(*الواصفات) مثل طبيعي)) { أرجع 0; };
    دع الأوصاف: &متجه طبيعي = &(*الواصفات)[الدالة].الأوصاف;
    إذا (القيمة >= (الطول(*الأوصاف) مثل طبيعي)) { أرجع 0; };
    أرجع (*الأوصاف)[القيمة];
}

// The raw bits held by slot القيمة of the frame at الموضع.
عرف بتات_خانة_سريعة(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    القيمة: طبيعي
): اختياري طبيعي {
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الحالة).المكدس[الموضع].الخانات;
    إذا (القيمة >= (الطول(*الخانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الخانات)[القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.بتات_عدد(العدد)) -> { أرجع اختياري.موجود(العدد); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The truth value held by slot القيمة of the frame at الموضع.
عرف منطق_خانة_سريعة(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    القيمة: طبيعي
): اختياري منطقي {
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الحالة).المكدس[الموضع].الخانات;
    إذا (القيمة >= (الطول(*الخانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الخانات)[القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.منطق(الحقيقة)) -> { أرجع اختياري.موجود(الحقيقة); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Writes القيمة into slot الوجهة of the frame at الموضع and advances its
// instruction pointer.
عرف اكتب_وتقدم_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الوجهة: طبيعي,
    القيمة: قيمة_تشغيل
): منطقي {
    (*الحالة).المكدس[الموضع].الخانات[الوجهة] := خانة_تنفيذ_مسير.قيمة(القيمة);
    (*الحالة).المكدس[الموضع].مؤشر_التعليمة := (*الحالة).المكدس[الموضع].مؤشر_التعليمة + 1;
    أرجع صواب;
}

// Whether الوجهة is a slot of the active function (the result of an
// instruction of the frame at الموضع).
عرف وجهة_سريعة_صالحة(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[الموضع];
    إذا ((*الإطار).الدالة.القيمة != الوجهة.الدالة.القيمة) { أرجع خطأ; };
    أرجع (الوجهة.القيمة مثل طبيعي) < (الطول((*الإطار).الخانات) مثل طبيعي);
}

// Two integer operands and a result slot of the frame at الموضع, read in
// one step: their descriptors (the function's table) and their bits (the
// slots, in place). صالح is false when any of them is not where a fast path
// expects it.
نوع معاملان_سريعان = {
    صالح: منطقي,
    رمز_أ: طبيعي,
    رمز_ب: طبيعي,
    أ: طبيعي,
    ب: طبيعي
};

عرف اقرأ_معاملين_سريعين(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الأول: معرف_قيمة_مسير,
    الثاني: معرف_قيمة_مسير,
    الوجهة: معرف_قيمة_مسير
): معاملان_سريعان {
    دع الفاشل: معاملان_سريعان = { صالح: خطأ, رمز_أ: 0, رمز_ب: 0, أ: 0, ب: 0 };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[الموضع];
    دع الدالة: طبيعي = (*الإطار).الدالة.القيمة;
    إذا ((الأول.الدالة.القيمة مثل طبيعي) != الدالة || (الثاني.الدالة.القيمة مثل طبيعي) != الدالة
        || (الوجهة.الدالة.القيمة مثل طبيعي) != الدالة) { أرجع الفاشل; };
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الإطار).الخانات;
    دع عدد_الخانات: طبيعي = الطول(*الخانات) مثل طبيعي;
    إذا ((الأول.القيمة مثل طبيعي) >= عدد_الخانات || (الثاني.القيمة مثل طبيعي) >= عدد_الخانات
        || (الوجهة.القيمة مثل طبيعي) >= عدد_الخانات) { أرجع الفاشل; };
    دع الواصفات: &متجه واصف_دالة_مفسر = &(*الحالة).واصفات_الدوال;
    إذا (الدالة >= (الطول(*الواصفات) مثل طبيعي)) { أرجع الفاشل; };
    دع الأوصاف: &متجه طبيعي = &(*الواصفات)[الدالة].الأوصاف;
    دع عدد_الأوصاف: طبيعي = الطول(*الأوصاف) مثل طبيعي;
    إذا ((الأول.القيمة مثل طبيعي) >= عدد_الأوصاف || (الثاني.القيمة مثل طبيعي) >= عدد_الأوصاف) { أرجع الفاشل; };
    دع رمز_أ: طبيعي = (*الأوصاف)[الأول.القيمة];
    دع رمز_ب: طبيعي = (*الأوصاف)[الثاني.القيمة];
    دع أ: طبيعي;
    طابق (*الخانات)[الأول.القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.بتات_عدد(العدد)) -> { أ := العدد; }
    | _ -> { أرجع الفاشل; };
    دع ب: طبيعي;
    طابق (*الخانات)[الثاني.القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.بتات_عدد(العدد)) -> { ب := العدد; }
    | _ -> { أرجع الفاشل; };
    دع الناتج: معاملان_سريعان = { صالح: صواب, رمز_أ: رمز_أ, رمز_ب: رمز_ب, أ: أ, ب: ب };
    أرجع الناتج;
}

// ---- Integer constants, arithmetic, comparisons, conversions ----------------

عرف ثابت_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الثابت: &ثابت_مسير,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    دع الرمز: طبيعي = رمز_قيمة_سريع(الحالة, الوجهة.الدالة.القيمة, الوجهة.القيمة);
    طابق *الثابت مع
    | ثابت_مسير.صحيح_موقع(القيمة) -> {
        إذا ((الرمز & 3) != 1) { أرجع خطأ; };
        أرجع اكتب_وتقدم_سريع(الحالة, الموضع, الوجهة.القيمة,
            قيمة_تشغيل.بتات_عدد(طبع_صحيح_مفسر(القيمة مثل طبيعي, الرمز >> 3)));
    }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
        إذا ((الرمز & 3) != 1 && (الرمز & 3) != 2) { أرجع خطأ; };
        أرجع اكتب_وتقدم_سريع(الحالة, الموضع, الوجهة.القيمة,
            قيمة_تشغيل.بتات_عدد(طبع_صحيح_مفسر(القيمة, الرمز >> 3)));
    }
    | ثابت_مسير.منطق(الحقيقة) -> {
        أرجع اكتب_وتقدم_سريع(الحالة, الموضع, الوجهة.القيمة, قيمة_تشغيل.منطق(الحقيقة));
    }
    | _ -> { أرجع خطأ; };
}

عرف حساب_صحيح_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الحساب: &حساب_صحيح_مسير,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    دع المعاملان: معاملان_سريعان = اقرأ_معاملين_سريعين(
        الحالة, الموضع, (*الحساب).اليسار, (*الحساب).اليمين, الوجهة
    );
    إذا (!المعاملان.صالح) { أرجع خطأ; };
    دع الرمز: طبيعي = المعاملان.رمز_أ;
    دع رمز_اليمين: طبيعي = المعاملان.رمز_ب;
    إذا ((الرمز & 3) != 1 || (رمز_اليمين & 3) != 1) { أرجع خطأ; };
    دع البتات: طبيعي = الرمز >> 3;
    دع موقع: منطقي = (الرمز & 4) != 0;
    دع أ_خام: طبيعي = المعاملان.أ;
    دع ب_خام: طبيعي = المعاملان.ب;
    دع القناع: طبيعي = قناع_صحيح_مفسر(البتات);
    دع أ: طبيعي = أ_خام & القناع;
    دع ب: طبيعي = ب_خام & قناع_صحيح_مفسر(رمز_اليمين >> 3);
    دع الوصف: وصف_صحيح_مفسر = { البتات: البتات, موقع: موقع };
    دع الناتج: متغير طبيعي = 0;
    طابق (*الحساب).العملية مع
    | عملية_حساب_صحيح.جمع -> {
        الناتج := جمع_خام_مفسر(أ, ب, البتات);
        إذا (هل_تجاوز_جمع_صحيح_مفسر(أ, ب, الناتج, الوصف)) { أرجع خطأ; };
    }
    | عملية_حساب_صحيح.طرح -> {
        الناتج := طرح_خام_مفسر(أ, ب, البتات);
        إذا (هل_تجاوز_طرح_صحيح_مفسر(أ, ب, الناتج, الوصف)) { أرجع خطأ; };
    }
    | عملية_حساب_صحيح.ضرب -> {
        إذا (هل_تجاوز_ضرب_صحيح_مفسر(أ, ب, الوصف)) { أرجع خطأ; };
        الناتج := ضرب_خام_مفسر(أ, ب, البتات);
    }
    | عملية_حساب_صحيح.جمع_ملتف -> { الناتج := جمع_خام_مفسر(أ, ب, البتات); }
    | عملية_حساب_صحيح.طرح_ملتف -> { الناتج := طرح_خام_مفسر(أ, ب, البتات); }
    | عملية_حساب_صحيح.ضرب_ملتف -> { الناتج := ضرب_خام_مفسر(أ, ب, البتات); }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> {
        الناتج := ازح_يسارا_خام_مفسر(أ, ب & (البتات - 1), البتات);
    }
    | عملية_حساب_صحيح.قسمة_طبيعية -> {
        إذا (ب == 0) { أرجع خطأ; };
        الناتج := أ / ب;
    }
    | عملية_حساب_صحيح.باقي_طبيعي -> {
        إذا (ب == 0) { أرجع خطأ; };
        الناتج := أ % ب;
    }
    | عملية_حساب_صحيح.أو_بتي -> { الناتج := أ | ب; }
    | عملية_حساب_صحيح.أو_حصري -> { الناتج := أ ^ ب; }
    | عملية_حساب_صحيح.و_بتي -> { الناتج := أ & ب; }
    | عملية_حساب_صحيح.إزاحة_يسرى -> {
        إذا ((رمز_اليمين & 4) != 0 && (ب & بت_إشارة_مفسر(رمز_اليمين >> 3)) != 0) { أرجع خطأ; };
        إذا (ب >= البتات) { أرجع خطأ; };
        إذا (هل_تجاوز_إزاحة_يسرى_صحيح_مفسر(أ, ب, الوصف)) { أرجع خطأ; };
        الناتج := ازح_يسارا_خام_مفسر(أ, ب, البتات);
    }
    | عملية_حساب_صحيح.إزاحة_يمنى -> {
        إذا ((رمز_اليمين & 4) != 0 && (ب & بت_إشارة_مفسر(رمز_اليمين >> 3)) != 0) { أرجع خطأ; };
        إذا (ب >= البتات) { أرجع خطأ; };
        الناتج := أ >> ب;
    }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
        إذا ((رمز_اليمين & 4) != 0 && (ب & بت_إشارة_مفسر(رمز_اليمين >> 3)) != 0) { أرجع خطأ; };
        إذا (ب >= البتات) { أرجع خطأ; };
        الناتج := إزاحة_يمنى_حسابية_خام_مفسر(أ, البتات, ب);
    }
    | _ -> { أرجع خطأ; };
    (*الحالة).المكدس[الموضع].الخانات[الوجهة.القيمة] := خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.بتات_عدد(الناتج & القناع));
    (*الحالة).المكدس[الموضع].مؤشر_التعليمة := (*الحالة).المكدس[الموضع].مؤشر_التعليمة + 1;
    أرجع صواب;
}

عرف مقارنة_صحيح_سريعة(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    المقارنة: &مقارنة_صحيح_مسير,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    دع المعاملان: معاملان_سريعان = اقرأ_معاملين_سريعين(
        الحالة, الموضع, (*المقارنة).اليسار, (*المقارنة).اليمين, الوجهة
    );
    إذا (!المعاملان.صالح) { أرجع خطأ; };
    دع الرمز: طبيعي = المعاملان.رمز_أ;
    دع رمز_اليمين: طبيعي = المعاملان.رمز_ب;
    إذا ((الرمز & 3) != 1 || (رمز_اليمين & 3) != 1) { أرجع خطأ; };
    دع البتات: طبيعي = الرمز >> 3;
    دع أ_خام: طبيعي = المعاملان.أ;
    دع ب_خام: طبيعي = المعاملان.ب;
    دع أ: طبيعي = طبع_صحيح_مفسر(أ_خام, البتات);
    دع ب: طبيعي = طبع_صحيح_مفسر(ب_خام, رمز_اليمين >> 3);
    دع أصغر: متغير منطقي = أ < ب;
    دع أكبر: متغير منطقي = أ > ب;
    إذا ((الرمز & 4) != 0) {
        أصغر := مقارنة_موقعة_أصغر(أ, ب, البتات);
        أكبر := مقارنة_موقعة_أصغر(ب, أ, البتات);
    };
    دع الناتج: متغير منطقي = خطأ;
    طابق (*المقارنة).العملية مع
    | عملية_مقارنة_صحيح.يساوي -> { الناتج := أ == ب; }
    | عملية_مقارنة_صحيح.لا_يساوي -> { الناتج := أ != ب; }
    | عملية_مقارنة_صحيح.أصغر -> { الناتج := أصغر; }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> { الناتج := أصغر || أ == ب; }
    | عملية_مقارنة_صحيح.أكبر -> { الناتج := أكبر; }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> { الناتج := أكبر || أ == ب; };
    (*الحالة).المكدس[الموضع].الخانات[الوجهة.القيمة] := خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.منطق(الناتج));
    (*الحالة).المكدس[الموضع].مؤشر_التعليمة := (*الحالة).المكدس[الموضع].مؤشر_التعليمة + 1;
    أرجع صواب;
}

عرف تحويل_صحيح_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    التحويل: &تحويل_صحيح_مسير,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    دع المعاملان: معاملان_سريعان = اقرأ_معاملين_سريعين(
        الحالة, الموضع, (*التحويل).المصدر, (*التحويل).المصدر, الوجهة
    );
    إذا (!المعاملان.صالح) { أرجع خطأ; };
    دع رمز_المصدر: طبيعي = المعاملان.رمز_أ;
    دع رمز_الوجهة: طبيعي = رمز_قيمة_سريع(الحالة, الوجهة.الدالة.القيمة, الوجهة.القيمة);
    دع صنف_المصدر: طبيعي = رمز_المصدر & 3;
    دع صنف_الوجهة: طبيعي = رمز_الوجهة & 3;
    إذا ((صنف_المصدر != 1 && صنف_المصدر != 2) || (صنف_الوجهة != 1 && صنف_الوجهة != 2)) {
        أرجع خطأ;
    };
    دع بتات_المصدر: طبيعي = رمز_المصدر >> 3;
    دع بتات_الوجهة: طبيعي = رمز_الوجهة >> 3;
    دع الخام: طبيعي = المعاملان.أ;
    دع المصدر: طبيعي = طبع_صحيح_مفسر(الخام, بتات_المصدر);
    دع الناتج: متغير طبيعي = المصدر;
    طابق (*التحويل).العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> {
        إذا ((المصدر & بت_إشارة_مفسر(بتات_المصدر)) != 0) {
            الناتج := المصدر | (قناع_صحيح_مفسر(بتات_الوجهة) ^ قناع_صحيح_مفسر(بتات_المصدر));
        };
    }
    | _ -> { };
    أرجع اكتب_وتقدم_سريع(الحالة, الموضع, الوجهة.القيمة,
        قيمة_تشغيل.بتات_عدد(طبع_صحيح_مفسر(الناتج, بتات_الوجهة)));
}

// ---- Places -------------------------------------------------------------------

// The value a load from the place in slot المكان reads, when the place is a
// local cell of the active frame or an element of a heap buffer (copied as
// the checked load copies it), or لا_شيء for any other place.
عرف قيمة_تحميل_سريعة(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    المكان: طبيعي
): اختياري قيمة_تشغيل {
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[الموضع];
    إذا (المكان >= (الطول((*الإطار).الخانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الإطار).الخانات[المكان] مع
    | خانة_تنفيذ_مسير.مكان(الموضع_المقروء) -> {
        دع عدد_الإسقاطات: طبيعي = الطول(الموضع_المقروء.الإسقاطات) مثل طبيعي;
        طابق الموضع_المقروء.الجذر مع
        | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
            إذا (عدد_الإسقاطات != 0 || التفعيل.القيمة != (*الإطار).التفعيل.القيمة) {
                أرجع قيمة_مكان_عامة_سريعة(الحالة, &الموضع_المقروء);
            };
            إذا (الخلية.القيمة >= (*الإطار).عدد_المحليات) { أرجع اختياري.لا_شيء(); };
            دع الخلية_المرجع: &خلية_محلية_مفسر = &(*الإطار).المحليات[الخلية.القيمة];
            إذا (!(*الخلية_المرجع).مهيأة) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(انسخ_قيمة_تشغيل(&(*الخلية_المرجع).القيمة));
        }
        | جذر_مكان_تشغيل.مخزن(المعرف) -> {
            إذا (عدد_الإسقاطات != 1) { أرجع اختياري.لا_شيء(); };
            دع الفهرس: طبيعي;
            طابق الموضع_المقروء.الإسقاطات[0] مع
            | إسقاط_مكان_تشغيل.فهرس(ف) -> { الفهرس := ف; }
            | إسقاط_مكان_تشغيل.حقل(ف) -> { الفهرس := ف; };
            دع المخازن: &متجه مخزن_مفسر = &(*الحالة).الذاكرة.المخازن;
            إذا (المعرف.القيمة >= (الطول(*المخازن) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
            دع المخزن: &مخزن_مفسر = &(*المخازن)[المعرف.القيمة];
            إذا (!(*المخزن).حي || (*المخزن).الجيل != المعرف.الجيل) { أرجع اختياري.لا_شيء(); };
            إذا ((*المخزن).بايتات) {
                إذا (الفهرس >= (الطول((*المخزن).البايتات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
                أرجع اختياري.موجود(قيمة_تشغيل.بتات_عدد((*المخزن).البايتات[الفهرس] مثل طبيعي));
            };
            إذا (الفهرس >= (الطول((*المخزن).القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(انسخ_قيمة_تشغيل(&(*المخزن).القيم[الفهرس]));
        }
        | _ -> { أرجع قيمة_مكان_عامة_سريعة(الحالة, &الموضع_المقروء); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Any other place (a local of another frame through a reference, a
// projection path, a global, a box): the general place read.
عرف قيمة_مكان_عامة_سريعة(
    الحالة: &حالة_تنفيذ_مفسر,
    المكان: &مكان_تشغيل
): اختياري قيمة_تشغيل {
    طابق اقرأ_مكان_مفسر(&(*الحالة).المكدس, (*الحالة).عمق_المكدس, &(*الحالة).الذاكرة, المكان) مع
    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | نتيجة_قراءة_ذاكرة_مفسر.أخفق(_) -> { أرجع اختياري.لا_شيء(); };
}

// The element an index extraction reads from a vector, slice or text value.
عرف عنصر_مستخرج_سريع(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الاستخراج: &استخراج_فهرس_مسير
): اختياري قيمة_تشغيل {
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[الموضع];
    دع الدالة: طبيعي = (*الإطار).الدالة.القيمة;
    إذا (((*الاستخراج).المصدر.الدالة.القيمة مثل طبيعي) != الدالة || ((*الاستخراج).الفهرس.الدالة.القيمة مثل طبيعي) != الدالة) {
        أرجع اختياري.لا_شيء();
    };
    دع الرمز: طبيعي = رمز_قيمة_سريع(الحالة, الدالة, (*الاستخراج).الفهرس.القيمة);
    إذا ((الرمز & 3) != 1) { أرجع اختياري.لا_شيء(); };
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الإطار).الخانات;
    إذا (((*الاستخراج).المصدر.القيمة مثل طبيعي) >= (الطول(*الخانات) مثل طبيعي)
        || ((*الاستخراج).الفهرس.القيمة مثل طبيعي) >= (الطول(*الخانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع الفهرس: طبيعي;
    طابق (*الخانات)[(*الاستخراج).الفهرس.القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.بتات_عدد(العدد)) -> { الفهرس := طبع_صحيح_مفسر(العدد, الرمز >> 3); }
    | _ -> { أرجع اختياري.لا_شيء(); };
    إذا ((الرمز & 4) != 0 && (الفهرس & بت_إشارة_مفسر(الرمز >> 3)) != 0) { أرجع اختياري.لا_شيء(); };
    طابق (*الخانات)[(*الاستخراج).المصدر.القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.مخزن(المخزن)) -> {
        أرجع اقرأ_عنصر_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن, الفهرس);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف استخراج_فهرس_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الاستخراج: &استخراج_فهرس_مسير,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    طابق عنصر_مستخرج_سريع(الحالة, الموضع, الاستخراج) مع
    | اختياري.موجود(القيمة) -> { أرجع اكتب_وتقدم_سريع(الحالة, الموضع, الوجهة.القيمة, القيمة); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The length and append primitives (the vector operations loops run most).
// Append takes the fast path only for a buffer that grows in place (not an
// interned literal, which the checked path copies first and re-stores).
عرف طول_بدائي_سريع(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الحجة: معرف_قيمة_مسير
): اختياري طبيعي {
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[الموضع];
    إذا (الحجة.الدالة.القيمة != (*الإطار).الدالة.القيمة) { أرجع اختياري.لا_شيء(); };
    إذا ((الحجة.القيمة مثل طبيعي) >= (الطول((*الإطار).الخانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الإطار).الخانات[الحجة.القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.مخزن(المخزن)) -> {
        أرجع طول_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف مخزن_إلحاق_سريع(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الحجة: معرف_قيمة_مسير
): اختياري معرف_مخزن_مفسر {
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[الموضع];
    إذا (الحجة.الدالة.القيمة != (*الإطار).الدالة.القيمة) { أرجع اختياري.لا_شيء(); };
    إذا ((الحجة.القيمة مثل طبيعي) >= (الطول((*الإطار).الخانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الإطار).الخانات[الحجة.القيمة] مع
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.مخزن(المخزن)) -> {
        إذا (!هوية_مخزن_مفسر_صالحة(&(*الحالة).الذاكرة, المخزن)) { أرجع اختياري.لا_شيء(); };
        إذا ((*الحالة).الذاكرة.المخازن[المخزن.القيمة].ثابت) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(المخزن);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف نداء_بدائي_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    النداء: &نداء_مسير,
    الناتج: &اختياري قيمة_مسير
): منطقي {
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.طول) -> {
        إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 1) { أرجع خطأ; };
        طابق *الناتج مع
        | اختياري.موجود(الوجهة) -> {
            إذا (!وجهة_سريعة_صالحة(الحالة, الموضع, الوجهة.المعرف)) { أرجع خطأ; };
            طابق طول_بدائي_سريع(الحالة, الموضع, (*النداء).الحجج[0]) مع
            | اختياري.موجود(العدد) -> {
                أرجع اكتب_وتقدم_سريع(الحالة, الموضع, الوجهة.المعرف.القيمة, قيمة_تشغيل.بتات_عدد(العدد));
            }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.إلحاق) -> {
        إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 2) { أرجع خطأ; };
        طابق *الناتج مع
        | اختياري.موجود(_) -> { أرجع خطأ; }
        | اختياري.لا_شيء -> { };
        دع المخزن: معرف_مخزن_مفسر;
        طابق مخزن_إلحاق_سريع(الحالة, الموضع, (*النداء).الحجج[0]) مع
        | اختياري.موجود(المعرف) -> { المخزن := المعرف; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        دع العنصر: قيمة_تشغيل;
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[الموضع], (*النداء).الحجج[1]) مع
        | نتيجة_قراءة_قيمة_خانة.موجودة(المقروءة) -> { العنصر := المقروءة; }
        | نتيجة_قراءة_قيمة_خانة.أخفق(_) -> { أرجع خطأ; };
        طابق ألحق_بمخزن_مفسر(&متغير (*الحالة).الذاكرة, المخزن, العنصر) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        (*الحالة).المكدس[الموضع].مؤشر_التعليمة := (*الحالة).المكدس[الموضع].مؤشر_التعليمة + 1;
        أرجع صواب;
    }
    | _ -> { أرجع خطأ; };
}

عرف تحميل_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    التحميل: &تحميل_مسير,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    إذا ((*التحميل).المكان.الدالة.القيمة != الوجهة.الدالة.القيمة) { أرجع خطأ; };
    طابق قيمة_تحميل_سريعة(الحالة, الموضع, (*التحميل).المكان.القيمة) مع
    | اختياري.موجود(القيمة) -> {
        أرجع اكتب_وتقدم_سريع(الحالة, الموضع, الوجهة.القيمة, القيمة);
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Where a fast store writes: 1 a byte of a byte buffer, 2 an element of a
// value buffer, 3 a local cell of the active frame; 0 for any other place.
نوع هدف_تخزين_سريع = {
    الصنف: طبيعي,
    المعرف: طبيعي,
    الفهرس: طبيعي
};

عرف هدف_تخزين_سريع_لمكان(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    المكان: طبيعي,
    القيمة: &قيمة_تشغيل
): هدف_تخزين_سريع {
    دع لا_هدف: هدف_تخزين_سريع = { الصنف: 0, المعرف: 0, الفهرس: 0 };
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[الموضع];
    إذا (المكان >= (الطول((*الإطار).الخانات) مثل طبيعي)) { أرجع لا_هدف; };
    طابق (*الإطار).الخانات[المكان] مع
    | خانة_تنفيذ_مسير.مكان(الموضع_المكتوب) -> {
        إذا (!الموضع_المكتوب.قابل_للكتابة) { أرجع لا_هدف; };
        دع عدد_الإسقاطات: طبيعي = الطول(الموضع_المكتوب.الإسقاطات) مثل طبيعي;
        طابق الموضع_المكتوب.الجذر مع
        | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
            إذا (عدد_الإسقاطات != 0 || التفعيل.القيمة != (*الإطار).التفعيل.القيمة) {
                أرجع لا_هدف;
            };
            إذا (الخلية.القيمة >= (*الإطار).عدد_المحليات) { أرجع لا_هدف; };
            دع الهدف: هدف_تخزين_سريع = { الصنف: 3, المعرف: 0, الفهرس: الخلية.القيمة };
            أرجع الهدف;
        }
        | جذر_مكان_تشغيل.مخزن(المعرف) -> {
            إذا (عدد_الإسقاطات != 1) { أرجع لا_هدف; };
            دع الفهرس: طبيعي;
            طابق الموضع_المكتوب.الإسقاطات[0] مع
            | إسقاط_مكان_تشغيل.فهرس(ف) -> { الفهرس := ف; }
            | إسقاط_مكان_تشغيل.حقل(ف) -> { الفهرس := ف; };
            دع المخازن: &متجه مخزن_مفسر = &(*الحالة).الذاكرة.المخازن;
            إذا (المعرف.القيمة >= (الطول(*المخازن) مثل طبيعي)) { أرجع لا_هدف; };
            دع المخزن: &مخزن_مفسر = &(*المخازن)[المعرف.القيمة];
            إذا (!(*المخزن).حي || (*المخزن).الجيل != المعرف.الجيل || (*المخزن).ثابت) {
                أرجع لا_هدف;
            };
            إذا ((*المخزن).بايتات) {
                إذا (الفهرس >= (الطول((*المخزن).البايتات) مثل طبيعي)) { أرجع لا_هدف; };
                طابق *القيمة مع
                | قيمة_تشغيل.بتات_عدد(البتات) -> {
                    إذا (البتات > 255) { أرجع لا_هدف; };
                }
                | _ -> { أرجع لا_هدف; };
                دع هدف_البايت: هدف_تخزين_سريع = {
                    الصنف: 1, المعرف: المعرف.القيمة, الفهرس: الفهرس
                };
                أرجع هدف_البايت;
            };
            إذا (الفهرس >= (الطول((*المخزن).القيم) مثل طبيعي)) { أرجع لا_هدف; };
            دع هدف_القيمة: هدف_تخزين_سريع = {
                الصنف: 2, المعرف: المعرف.القيمة, الفهرس: الفهرس
            };
            أرجع هدف_القيمة;
        }
        | _ -> { أرجع لا_هدف; };
    }
    | _ -> { أرجع لا_هدف; };
}

عرف تخزين_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    التخزين: &تخزين_مسير
): منطقي {
    دع الدالة: طبيعي = (*الحالة).المكدس[الموضع].الدالة.القيمة;
    إذا (((*التخزين).المكان.الدالة.القيمة مثل طبيعي) != الدالة || ((*التخزين).القيمة.الدالة.القيمة مثل طبيعي) != الدالة) {
        أرجع خطأ;
    };
    دع القيمة: قيمة_تشغيل;
    طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[الموضع], (*التخزين).القيمة) مع
    | نتيجة_قراءة_قيمة_خانة.موجودة(المقروءة) -> { القيمة := المقروءة; }
    | نتيجة_قراءة_قيمة_خانة.أخفق(_) -> { أرجع خطأ; };
    دع الهدف: هدف_تخزين_سريع = هدف_تخزين_سريع_لمكان(
        الحالة, الموضع, (*التخزين).المكان.القيمة, &القيمة
    );
    إذا (الهدف.الصنف == 0) { أرجع خطأ; };
    إذا (الهدف.الصنف == 1) {
        طابق القيمة مع
        | قيمة_تشغيل.بتات_عدد(البتات) -> {
            (*الحالة).الذاكرة.المخازن[الهدف.المعرف].البايتات[الهدف.الفهرس] := البتات مثل ط8;
        }
        | _ -> { أرجع خطأ; };
    } وإلا { إذا (الهدف.الصنف == 2) {
        (*الحالة).الذاكرة.المخازن[الهدف.المعرف].القيم[الهدف.الفهرس] := القيمة;
    } وإلا {
        (*الحالة).المكدس[الموضع].المحليات[الهدف.الفهرس].القيمة := القيمة;
        (*الحالة).المكدس[الموضع].المحليات[الهدف.الفهرس].مهيأة := صواب;
    }; };
    (*الحالة).المكدس[الموضع].مؤشر_التعليمة := (*الحالة).المكدس[الموضع].مؤشر_التعليمة + 1;
    أرجع صواب;
}

نوع أصل_فهرسة_سريع = {
    المخزن: معرف_مخزن_مفسر,
    قابل_للكتابة: منطقي
};

// The buffer an element place indexes, when the origin place is a local cell
// of the active frame holding a vector, slice or text handle.
عرف مخزن_أصل_سريع(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الأصل: طبيعي
): اختياري أصل_فهرسة_سريع {
    دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[الموضع];
    إذا (الأصل >= (الطول((*الإطار).الخانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الإطار).الخانات[الأصل] مع
    | خانة_تنفيذ_مسير.مكان(مكان_الأصل) -> {
        إذا ((الطول(مكان_الأصل.الإسقاطات) مثل طبيعي) != 0) {
            // Any other live place holding a handle (a field, an element,
            // a global, a dereferenced reference).
            طابق مخزن_عند_مكان_مفسر(&(*الحالة).المكدس, (*الحالة).عمق_المكدس, &(*الحالة).الذاكرة, &مكان_الأصل) مع
            | اختياري.موجود(معرف_المخزن) -> {
                دع أصل_عام: أصل_فهرسة_سريع = {
                    المخزن: معرف_المخزن, قابل_للكتابة: مكان_الأصل.قابل_للكتابة
                };
                أرجع اختياري.موجود(أصل_عام);
            }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        };
        طابق مكان_الأصل.الجذر مع
        | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
            إذا (التفعيل.القيمة != (*الإطار).التفعيل.القيمة) { أرجع اختياري.لا_شيء(); };
            إذا (الخلية.القيمة >= (*الإطار).عدد_المحليات) { أرجع اختياري.لا_شيء(); };
            دع الخلية_المرجع: &خلية_محلية_مفسر = &(*الإطار).المحليات[الخلية.القيمة];
            إذا (!(*الخلية_المرجع).مهيأة) { أرجع اختياري.لا_شيء(); };
            طابق (*الخلية_المرجع).القيمة مع
            | قيمة_تشغيل.مخزن(المعرف) -> {
                دع الأصل_المحلول: أصل_فهرسة_سريع = {
                    المخزن: المعرف, قابل_للكتابة: مكان_الأصل.قابل_للكتابة
                };
                أرجع اختياري.موجود(الأصل_المحلول);
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
        }
        | _ -> {
            طابق مخزن_عند_مكان_مفسر(&(*الحالة).المكدس, (*الحالة).عمق_المكدس, &(*الحالة).الذاكرة, &مكان_الأصل) مع
            | اختياري.موجود(معرف_المخزن) -> {
                دع أصل_جذر: أصل_فهرسة_سريع = {
                    المخزن: معرف_المخزن, قابل_للكتابة: مكان_الأصل.قابل_للكتابة
                };
                أرجع اختياري.موجود(أصل_جذر);
            }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف مكان_فهرس_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    المكان: &مكان_فهرس_مسير,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    دع الدالة: طبيعي = الوجهة.الدالة.القيمة;
    إذا (((*المكان).الأصل.الدالة.القيمة مثل طبيعي) != الدالة || ((*المكان).الفهرس.الدالة.القيمة مثل طبيعي) != الدالة) {
        أرجع خطأ;
    };
    دع رمز_الفهرس: طبيعي = رمز_قيمة_سريع(الحالة, الدالة, (*المكان).الفهرس.القيمة);
    إذا ((رمز_الفهرس & 3) != 1) { أرجع خطأ; };
    دع الخام: طبيعي;
    طابق بتات_خانة_سريعة(الحالة, الموضع, (*المكان).الفهرس.القيمة) مع
    | اختياري.موجود(العدد) -> { الخام := العدد; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع الفهرس: طبيعي = طبع_صحيح_مفسر(الخام, رمز_الفهرس >> 3);
    إذا ((رمز_الفهرس & 4) != 0 && (الفهرس & بت_إشارة_مفسر(رمز_الفهرس >> 3)) != 0) { أرجع خطأ; };
    دع المخزن: معرف_مخزن_مفسر;
    دع قابل_للكتابة: منطقي;
    طابق مخزن_أصل_سريع(الحالة, الموضع, (*المكان).الأصل.القيمة) مع
    | اختياري.موجود(المحلول) -> { المخزن := المحلول.المخزن; قابل_للكتابة := المحلول.قابل_للكتابة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    طابق طول_مخزن_مفسر(&(*الحالة).الذاكرة, المخزن) مع
    | اختياري.موجود(العدد) -> {
        إذا (الفهرس >= العدد) { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    // The slot keeps the place an earlier execution left in it (frames reuse
    // their slot tables): its one-projection vector is updated in place
    // instead of allocating a new one.
    دع القديمة: متغير خانة_تنفيذ_مسير = خانة_تنفيذ_مسير.غير_مهيأة();
    بدّل((*الحالة).المكدس[الموضع].الخانات[الوجهة.القيمة], القديمة);
    دع الجديد: متغير مكان_تشغيل;
    طابق القديمة مع
    | خانة_تنفيذ_مسير.مكان(السابق) -> {
        دع المعاد: متغير مكان_تشغيل = السابق;
        إذا ((الطول(المعاد.الإسقاطات) مثل طبيعي) == 1) {
            المعاد.الإسقاطات[0] := إسقاط_مكان_تشغيل.فهرس(الفهرس);
            المعاد.الجذر := جذر_مكان_تشغيل.مخزن(المخزن);
            المعاد.قابل_للكتابة := قابل_للكتابة;
            الجديد := المعاد;
        } وإلا {
            الجديد := مكان_عنصر_جديد_سريع(المخزن, الفهرس, قابل_للكتابة);
        };
    }
    | _ -> {
        الجديد := مكان_عنصر_جديد_سريع(المخزن, الفهرس, قابل_للكتابة);
    };
    (*الحالة).المكدس[الموضع].الخانات[الوجهة.القيمة] := خانة_تنفيذ_مسير.مكان(الجديد);
    (*الحالة).المكدس[الموضع].مؤشر_التعليمة := (*الحالة).المكدس[الموضع].مؤشر_التعليمة + 1;
    أرجع صواب;
}

عرف مكان_عنصر_جديد_سريع(
    المخزن: معرف_مخزن_مفسر,
    الفهرس: طبيعي,
    قابل_للكتابة: منطقي
): مكان_تشغيل {
    دع الإسقاط: إسقاط_مكان_تشغيل = إسقاط_مكان_تشغيل.فهرس(الفهرس);
    دع الإسقاطات: متجه إسقاط_مكان_تشغيل = [الإسقاط];
    دع المكان: مكان_تشغيل = {
        الجذر: جذر_مكان_تشغيل.مخزن(المخزن),
        الإسقاطات: الإسقاطات,
        قابل_للكتابة: قابل_للكتابة
    };
    أرجع المكان;
}

// ---- Places copied between slots ------------------------------------------

// The place slot المصدر of the frame at الموضع holds (من_مرجع: the place
// of the reference value it holds), copied into المعادة, when the place is
// live; لا_شيء otherwise.
عرف مكان_خانة_منسوخ(
    الحالة: &حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    المصدر: طبيعي,
    من_مرجع: منطقي,
    المعادة: متجه إسقاط_مكان_تشغيل,
    كتابة: منطقي
): اختياري مكان_تشغيل {
    دع الخانات: &متجه خانة_تنفيذ_مسير = &(*الحالة).المكدس[الموضع].الخانات;
    إذا (المصدر >= (الطول(*الخانات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    طابق (*الخانات)[المصدر] مع
    | خانة_تنفيذ_مسير.مكان(المكان) -> {
        إذا (من_مرجع) { أرجع اختياري.لا_شيء(); };
        إذا (!هوية_مكان_مفسر_صالحة(&(*الحالة).المكدس, (*الحالة).عمق_المكدس, &(*الحالة).الذاكرة, &المكان)) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(مكان_منسوخ_في(&المكان, المعادة, كتابة));
    }
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.مرجع(المكان)) -> {
        إذا (!من_مرجع) { أرجع اختياري.لا_شيء(); };
        إذا (!هوية_مكان_مفسر_صالحة(&(*الحالة).المكدس, (*الحالة).عمق_المكدس, &(*الحالة).الذاكرة, &المكان)) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(مكان_منسوخ_في(&المكان, المعادة, كتابة));
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Writes the place of slot المصدر into slot الوجهة (the frame at الموضع)
// as a place or as a reference value, reusing the destination's projection
// vector instead of allocating one, as the checked conversions do after
// validating the place.
عرف انقل_مكانا_سريعا(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    المصدر: طبيعي,
    الوجهة: طبيعي,
    من_مرجع: منطقي,
    إلى_مرجع: منطقي,
    كتابة: منطقي
): منطقي {
    دع القديمة: متغير خانة_تنفيذ_مسير = خانة_تنفيذ_مسير.غير_مهيأة();
    بدّل((*الحالة).المكدس[الموضع].الخانات[الوجهة], القديمة);
    دع المعادة: متجه إسقاط_مكان_تشغيل = إسقاطات_خانة_للإعادة(القديمة);
    طابق مكان_خانة_منسوخ(الحالة, الموضع, المصدر, من_مرجع, المعادة, كتابة) مع
    | اختياري.موجود(المكان) -> {
        إذا (إلى_مرجع) {
            (*الحالة).المكدس[الموضع].الخانات[الوجهة] := خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.مرجع(المكان));
        } وإلا {
            (*الحالة).المكدس[الموضع].الخانات[الوجهة] := خانة_تنفيذ_مسير.مكان(المكان);
        };
        (*الحالة).المكدس[الموضع].مؤشر_التعليمة := (*الحالة).المكدس[الموضع].مؤشر_التعليمة + 1;
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف مرجع_إلى_مكان_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    التحويل: &مرجع_إلى_مكان_مسير,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    دع الدالة: طبيعي = الوجهة.الدالة.القيمة;
    إذا (((*التحويل).المرجع.الدالة.القيمة مثل طبيعي) != الدالة) { أرجع خطأ; };
    دع الرمز: طبيعي = رمز_قيمة_سريع(الحالة, الدالة, (*التحويل).المرجع.القيمة);
    إذا (الرمز != 4 && الرمز != 12) { أرجع خطأ; };
    أرجع انقل_مكانا_سريعا(الحالة, الموضع, (*التحويل).المرجع.القيمة, الوجهة.القيمة, صواب, خطأ, الرمز == 12);
}

عرف مكان_إلى_مرجع_سريع(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    التحويل: &مكان_إلى_مرجع_مسير,
    الوجهة: معرف_قيمة_مسير
): منطقي {
    دع الدالة: طبيعي = الوجهة.الدالة.القيمة;
    إذا (((*التحويل).المكان.الدالة.القيمة مثل طبيعي) != الدالة) { أرجع خطأ; };
    دع الرمز: طبيعي = رمز_قيمة_سريع(الحالة, الدالة, الوجهة.القيمة);
    إذا (الرمز != 4 && الرمز != 12) { أرجع خطأ; };
    أرجع انقل_مكانا_سريعا(الحالة, الموضع, (*التحويل).المكان.القيمة, الوجهة.القيمة, خطأ, صواب, الرمز == 12);
}

// ---- Dispatch -----------------------------------------------------------------

// Executes the instruction at the frame at الموضع when a fast path covers it.
عام عرف نفذ_تعليمة_سريعة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    الدالة: &دالة_مسير,
    التعليمة: &تعليمة_مسير
): منطقي {
    دع ناتج_التعليمة: اختياري قيمة_مسير = قيمة_ناتج_تعليمة_مسير(الدالة, التعليمة);
    طابق ناتج_التعليمة مع
    | اختياري.موجود(الناتج) -> {
        دع الوجهة: معرف_قيمة_مسير = الناتج.المعرف;
        طابق (*التعليمة).العملية مع
        | عملية_مسير.حساب_صحيح(الحساب) -> { أرجع حساب_صحيح_سريع(الحالة, الموضع, &الحساب, الوجهة); }
        | عملية_مسير.مقارنة_صحيح(المقارنة) -> { أرجع مقارنة_صحيح_سريعة(الحالة, الموضع, &المقارنة, الوجهة); }
        | عملية_مسير.تحويل_صحيح(التحويل) -> { أرجع تحويل_صحيح_سريع(الحالة, الموضع, &التحويل, الوجهة); }
        | _ -> { };
        إذا (!وجهة_سريعة_صالحة(الحالة, الموضع, الوجهة)) { أرجع خطأ; };
        طابق (*التعليمة).العملية مع
        | عملية_مسير.تحميل(التحميل) -> { أرجع تحميل_سريع(الحالة, الموضع, &التحميل, الوجهة); }
        | عملية_مسير.ثابت(الثابت) -> { أرجع ثابت_سريع(الحالة, الموضع, &الثابت, الوجهة); }
        | عملية_مسير.مكان_فهرس(المكان) -> { أرجع مكان_فهرس_سريع(الحالة, الموضع, &المكان, الوجهة); }
        | عملية_مسير.استخراج_فهرس(الاستخراج) -> { أرجع استخراج_فهرس_سريع(الحالة, الموضع, &الاستخراج, الوجهة); }
        | عملية_مسير.نداء(النداء) -> { أرجع نداء_بدائي_سريع(الحالة, الموضع, &النداء, &ناتج_التعليمة); }
        | عملية_مسير.مرجع_إلى_مكان(التحويل) -> { أرجع مرجع_إلى_مكان_سريع(الحالة, الموضع, &التحويل, الوجهة); }
        | عملية_مسير.مكان_إلى_مرجع(التحويل) -> { أرجع مكان_إلى_مرجع_سريع(الحالة, الموضع, &التحويل, الوجهة); }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> {
        طابق (*التعليمة).العملية مع
        | عملية_مسير.تخزين(التخزين) -> { أرجع تخزين_سريع(الحالة, الموضع, &التخزين); }
        | عملية_مسير.نداء(النداء) -> { أرجع نداء_بدائي_سريع(الحالة, الموضع, &النداء, &ناتج_التعليمة); }
        | _ -> { أرجع خطأ; };
    };
}

// ---- Branches -----------------------------------------------------------------

// Takes an edge with no argument, or with one whose target block has one
// parameter.
عرف حافة_سريعة(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    المسير: &سياق_مستهلك_مسير,
    الحافة: &حافة_مسير
): منطقي {
    دع الهدف: معرف_كتلة_مسير = (*الحافة).الهدف;
    دع عدد_الحجج: طبيعي = الطول((*الحافة).الحجج) مثل طبيعي;
    دع الدوال: &متجه دالة_مسير = &(*المسير).المسير.الدوال;
    إذا ((الهدف.الدالة.القيمة مثل طبيعي) >= (الطول(*الدوال) مثل طبيعي)) { أرجع خطأ; };
    إذا (الهدف.الدالة.القيمة != (*الحالة).المكدس[الموضع].الدالة.القيمة) { أرجع خطأ; };
    دع الكتل: &متجه كتلة_مسير = &(*الدوال)[الهدف.الدالة.القيمة].الكتل;
    إذا ((الهدف.القيمة مثل طبيعي) >= (الطول(*الكتل) مثل طبيعي)) { أرجع خطأ; };
    دع المعاملات: &متجه قيمة_مسير = &(*الكتل)[الهدف.القيمة].المعاملات;
    إذا ((الطول(*المعاملات) مثل طبيعي) != عدد_الحجج) { أرجع خطأ; };
    إذا (عدد_الحجج == 1) {
        دع المعامل: معرف_قيمة_مسير = (*المعاملات)[0].المعرف;
        إذا (!وجهة_سريعة_صالحة(الحالة, الموضع, المعامل)) { أرجع خطأ; };
        دع القيمة: قيمة_تشغيل;
        طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[الموضع], (*الحافة).الحجج[0]) مع
        | نتيجة_قراءة_قيمة_خانة.موجودة(المقروءة) -> { القيمة := المقروءة; }
        | نتيجة_قراءة_قيمة_خانة.أخفق(_) -> { أرجع خطأ; };
        (*الحالة).المكدس[الموضع].الخانات[المعامل.القيمة] := خانة_تنفيذ_مسير.قيمة(القيمة);
    };
    إذا (عدد_الحجج > 1) {
        // Usually no operand is another of the target's parameters (a loop's
        // back edge passes the values computed in its body, and a value the
        // body leaves alone as the same parameter): then each parameter is
        // written straight from its operand, and one passed to itself is
        // left as it is.
        دع متداخل: متغير منطقي = خطأ;
        دع س: متغير طبيعي = 0;
        طالما (س < عدد_الحجج && !متداخل) {
            دع الوسيط: معرف_قيمة_مسير = (*الحافة).الحجج[س];
            دع م: متغير طبيعي = 0;
            طالما (م < عدد_الحجج) {
                إذا (م != س && (*المعاملات)[م].المعرف.القيمة == الوسيط.القيمة) { متداخل := صواب; };
                م := م + 1;
            }
            س := س + 1;
        }
        إذا (!متداخل) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < عدد_الحجج) {
                إذا (!وجهة_سريعة_صالحة(الحالة, الموضع, (*المعاملات)[ف].المعرف)) { أرجع خطأ; };
                ف := ف + 1;
            }
            ف := 0;
            طالما (ف < عدد_الحجج) {
                دع الوجهة: طبيعي = (*المعاملات)[ف].المعرف.القيمة;
                إذا (((*الحافة).الحجج[ف].القيمة مثل طبيعي) != الوجهة) {
                    طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[الموضع], (*الحافة).الحجج[ف]) مع
                    | نتيجة_قراءة_قيمة_خانة.موجودة(المقروءة) -> {
                        (*الحالة).المكدس[الموضع].الخانات[الوجهة] := خانة_تنفيذ_مسير.قيمة(المقروءة);
                    }
                    | نتيجة_قراءة_قيمة_خانة.أخفق(_) -> { أرجع خطأ; };
                };
                ف := ف + 1;
            }
            (*الحالة).المكدس[الموضع].الكتلة := الهدف;
            (*الحالة).المكدس[الموضع].مؤشر_التعليمة := 0;
            أرجع صواب;
        };
        // A parallel copy: every operand is read into the state's staging
        // vector before any parameter is written.
        دع ف: متغير طبيعي = 0;
        طالما (ف < عدد_الحجج) {
            إذا (!وجهة_سريعة_صالحة(الحالة, الموضع, (*المعاملات)[ف].المعرف)) { أرجع خطأ; };
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < عدد_الحجج) {
            طابق اقرأ_قيمة_خانة_مسير(&(*الحالة).المكدس[الموضع], (*الحافة).الحجج[ف]) مع
            | نتيجة_قراءة_قيمة_خانة.موجودة(المقروءة) -> {
                إذا (ف < (الطول((*الحالة).حجج_الحواف) مثل طبيعي)) {
                    (*الحالة).حجج_الحواف[ف] := المقروءة;
                } وإلا {
                    ألحق((*الحالة).حجج_الحواف, المقروءة);
                };
            }
            | نتيجة_قراءة_قيمة_خانة.أخفق(_) -> { أرجع خطأ; };
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < عدد_الحجج) {
            دع المأخوذة: متغير قيمة_تشغيل = قيمة_تشغيل.مؤشر_فارغ();
            بدّل((*الحالة).حجج_الحواف[ف], المأخوذة);
            (*الحالة).المكدس[الموضع].الخانات[(*المعاملات)[ف].المعرف.القيمة] := خانة_تنفيذ_مسير.قيمة(المأخوذة);
            ف := ف + 1;
        }
    };
    (*الحالة).المكدس[الموضع].الكتلة := الهدف;
    (*الحالة).المكدس[الموضع].مؤشر_التعليمة := 0;
    أرجع صواب;
}

// Executes the terminator of the frame at الموضع when a fast path covers it:
// a branch, or a conditional branch on a truth value, over a simple edge.
عام عرف نفذ_منهي_سريع_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    الموضع: طبيعي,
    المسير: &سياق_مستهلك_مسير,
    المنهي: &منهي_مسير
): منطقي {
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> { أرجع حافة_سريعة(الحالة, الموضع, المسير, &الحافة); }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        إذا (الشرط.الدالة.القيمة != (*الحالة).المكدس[الموضع].الدالة.القيمة) { أرجع خطأ; };
        طابق منطق_خانة_سريعة(الحالة, الموضع, الشرط.القيمة) مع
        | اختياري.موجود(الحقيقة) -> {
            إذا (الحقيقة) { أرجع حافة_سريعة(الحالة, الموضع, المسير, &عند_الصواب); };
            أرجع حافة_سريعة(الحالة, الموضع, المسير, &عند_الخطأ);
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}
