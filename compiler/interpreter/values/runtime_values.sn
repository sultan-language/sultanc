استورد compiler.msir.identifiers;

// Runtime payloads are semantic interpreter values. They do not own Type identity or target layout.
عام نوع معرف_تفعيل_مفسر = {
    القيمة: غير_موقع
};

عام نوع معرف_صندوق_مفسر = {
    القيمة: غير_موقع
};

عام نوع معرف_خلية_محلية_مفسر = {
    القيمة: غير_موقع
};

عام نوع جذر_مكان_تشغيل =
    | محلي بنوع (معرف_تفعيل_مفسر, معرف_خلية_محلية_مفسر)
    | صندوق بنوع معرف_صندوق_مفسر
;

// Projections are semantic member ordinals/runtime indices, never byte offsets.
عام نوع إسقاط_مكان_تشغيل =
    | حقل بنوع غير_موقع
    | فهرس بنوع غير_موقع
;

عام نوع مكان_تشغيل = {
    الجذر: جذر_مكان_تشغيل,
    الإسقاطات: متجه إسقاط_مكان_تشغيل,
    قابل_للكتابة: منطقي
};

عام نوع قيمة_موسومة_تشغيل = {
    المنشئ: غير_موقع,
    الحمولات: متجه قيمة_تشغيل
};

// Integer payloads are normalized raw bit patterns. Width/signedness remain canonical Type facts.
عام نوع قيمة_تشغيل =
    | منطق بنوع منطقي
    | بتات_عدد بنوع غير_موقع
    | محرف بنوع غ32
    | نص بنوع متجه غ8
    | تجميع بنوع متجه قيمة_تشغيل
    | موسوم بنوع قيمة_موسومة_تشغيل
    | مرجع بنوع مكان_تشغيل
    | صندوق بنوع معرف_صندوق_مفسر
    | دالة بنوع معرف_دالة_مسير
;

// Value IDs and place-producing instructions share exactly one execution-slot namespace.
عام نوع خانة_تنفيذ_مسير =
    | غير_مهيأة
    | قيمة بنوع قيمة_تشغيل
    | مكان بنوع مكان_تشغيل
;

عام عرف معرف_تفعيل_مفسر_من(القيمة: غير_موقع): معرف_تفعيل_مفسر {
    دع المعرف: معرف_تفعيل_مفسر = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرفا_تفعيل_مفسر_متساويان(أ: معرف_تفعيل_مفسر, ب: معرف_تفعيل_مفسر): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف معرف_صندوق_مفسر_من(القيمة: غير_موقع): معرف_صندوق_مفسر {
    دع المعرف: معرف_صندوق_مفسر = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرف_خلية_محلية_مفسر_من(القيمة: غير_موقع): معرف_خلية_محلية_مفسر {
    دع المعرف: معرف_خلية_محلية_مفسر = { القيمة: القيمة };
    أرجع المعرف;
}

عرف انسخ_جذر_مكان_تشغيل(الجذر: &جذر_مكان_تشغيل): جذر_مكان_تشغيل {
    طابق *الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        أرجع جذر_مكان_تشغيل.محلي(التفعيل, الخلية);
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        أرجع جذر_مكان_تشغيل.صندوق(المعرف);
    };
}

عرف انسخ_إسقاط_مكان_تشغيل(الإسقاط: &إسقاط_مكان_تشغيل): إسقاط_مكان_تشغيل {
    طابق *الإسقاط مع
    | إسقاط_مكان_تشغيل.حقل(الفهرس) -> {
        أرجع إسقاط_مكان_تشغيل.حقل(الفهرس);
    }
    | إسقاط_مكان_تشغيل.فهرس(الفهرس) -> {
        أرجع إسقاط_مكان_تشغيل.فهرس(الفهرس);
    };
}

عام عرف انسخ_مكان_تشغيل(المكان: &مكان_تشغيل): مكان_تشغيل {
    دع القيمة: مكان_تشغيل = *المكان;
    دع الجذر: جذر_مكان_تشغيل = انسخ_جذر_مكان_تشغيل(&القيمة.الجذر);
    دع الإسقاطات: متغير متجه إسقاط_مكان_تشغيل = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.الإسقاطات) مثل غير_موقع)) {
        دع الإسقاط: إسقاط_مكان_تشغيل = انسخ_إسقاط_مكان_تشغيل(&القيمة.الإسقاطات[ف]);
        ألحق(الإسقاطات, الإسقاط);
        ف := ف + 1;
    }
    دع قابل_للكتابة: منطقي = القيمة.قابل_للكتابة;
    دع الناتج: مكان_تشغيل = {
        الجذر: الجذر,
        الإسقاطات: الإسقاطات,
        قابل_للكتابة: قابل_للكتابة
    };
    أرجع الناتج;
}

عام عرف انسخ_قيمة_تشغيل(القيمة: &قيمة_تشغيل): قيمة_تشغيل {
    طابق *القيمة مع
    | قيمة_تشغيل.منطق(المنطق) -> {
        أرجع قيمة_تشغيل.منطق(المنطق);
    }
    | قيمة_تشغيل.بتات_عدد(الخام) -> {
        أرجع قيمة_تشغيل.بتات_عدد(الخام);
    }
    | قيمة_تشغيل.محرف(المحرف) -> {
        أرجع قيمة_تشغيل.محرف(المحرف);
    }
    | قيمة_تشغيل.نص(البايتات) -> {
        دع النسخة: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(البايتات) مثل غير_موقع)) {
            ألحق(النسخة, البايتات[ف]);
            ف := ف + 1;
        }
        أرجع قيمة_تشغيل.نص(النسخة);
    }
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        دع النسخة: متغير متجه قيمة_تشغيل = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأعضاء) مثل غير_موقع)) {
            دع العضو: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الأعضاء[ف]);
            ألحق(النسخة, العضو);
            ف := ف + 1;
        }
        أرجع قيمة_تشغيل.تجميع(النسخة);
    }
    | قيمة_تشغيل.موسوم(الموسوم) -> {
        دع الحمولات: متغير متجه قيمة_تشغيل = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الموسوم.الحمولات) مثل غير_موقع)) {
            دع الحمولة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الموسوم.الحمولات[ف]);
            ألحق(الحمولات, الحمولة);
            ف := ف + 1;
        }
        دع المنشئ: غير_موقع = الموسوم.المنشئ;
        دع نسخة_الموسوم: قيمة_موسومة_تشغيل = {
            المنشئ: المنشئ,
            الحمولات: الحمولات
        };
        أرجع قيمة_تشغيل.موسوم(نسخة_الموسوم);
    }
    | قيمة_تشغيل.مرجع(المكان) -> {
        دع النسخة: مكان_تشغيل = انسخ_مكان_تشغيل(&المكان);
        أرجع قيمة_تشغيل.مرجع(النسخة);
    }
    | قيمة_تشغيل.صندوق(المعرف) -> {
        أرجع قيمة_تشغيل.صندوق(المعرف);
    }
    | قيمة_تشغيل.دالة(الدالة) -> {
        أرجع قيمة_تشغيل.دالة(الدالة);
    };
}

عام عرف انسخ_خانة_تنفيذ_مسير(الخانة: &خانة_تنفيذ_مسير): خانة_تنفيذ_مسير {
    طابق *الخانة مع
    | خانة_تنفيذ_مسير.غير_مهيأة -> {
        أرجع خانة_تنفيذ_مسير.غير_مهيأة();
    }
    | خانة_تنفيذ_مسير.قيمة(القيمة) -> {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
        أرجع خانة_تنفيذ_مسير.قيمة(النسخة);
    }
    | خانة_تنفيذ_مسير.مكان(المكان) -> {
        دع النسخة: مكان_تشغيل = انسخ_مكان_تشغيل(&المكان);
        أرجع خانة_تنفيذ_مسير.مكان(النسخة);
    };
}
