استورد std.text.from_bytes;
استورد compiler.msir.identifiers;

// Runtime payloads are semantic interpreter values. They do not own Type identity or target layout.
عام نوع معرف_تفعيل_مفسر = {
    القيمة: طبيعي
};

عام نوع معرف_صندوق_مفسر = {
    القيمة: طبيعي,
    الجيل: طبيعي
};

عام نوع معرف_إغلاق_مفسر = {
    القيمة: طبيعي,
    الجيل: طبيعي
};

// A vector, slice or text value is a handle to one interpreter heap buffer
// (memory.sn), as a native value is a pointer to its heap storage: copying
// the value copies the handle, MSIR ownership decides who drops it, and the
// release primitive frees the buffer. The generation detects stale handles.
عام نوع معرف_مخزن_مفسر = {
    القيمة: طبيعي,
    الجيل: طبيعي
};

عام نوع معرف_خلية_محلية_مفسر = {
    القيمة: طبيعي
};

عام نوع جذر_مكان_تشغيل =
    | محلي بنوع (معرف_تفعيل_مفسر, معرف_خلية_محلية_مفسر)
    | عام بنوع معرف_عام_مسير
    | صندوق بنوع معرف_صندوق_مفسر
    // An element of a heap buffer: the first projection is the element index.
    | مخزن بنوع معرف_مخزن_مفسر
;

// Projections are semantic member ordinals/runtime indices, never byte offsets.
عام نوع إسقاط_مكان_تشغيل =
    | حقل بنوع طبيعي
    | فهرس بنوع طبيعي
;

عام نوع مكان_تشغيل = {
    الجذر: جذر_مكان_تشغيل,
    الإسقاطات: متجه إسقاط_مكان_تشغيل,
    قابل_للكتابة: منطقي
};

عام نوع قيمة_موسومة_تشغيل = {
    المنشئ: طبيعي,
    الحمولات: متجه قيمة_تشغيل
};

// Integer payloads are normalized raw bit patterns. Width/signedness remain canonical Type facts.
عام نوع قيمة_تشغيل =
    | منطق بنوع منطقي
    | بتات_عدد بنوع طبيعي
    | محرف بنوع ط32
    | نص بنوع متجه ط8
    | تجميع بنوع متجه قيمة_تشغيل
    | موسوم بنوع قيمة_موسومة_تشغيل
    | مرجع بنوع مكان_تشغيل
    | مؤشر_فارغ
    | صندوق بنوع معرف_صندوق_مفسر
    | دالة بنوع معرف_دالة_مسير
    | إغلاق بنوع معرف_إغلاق_مفسر
    // A vector, slice or text: a handle to its heap buffer. The inline forms
    // `نص` and `تجميع` of a sequence only cross the compile-time boundary.
    | مخزن بنوع معرف_مخزن_مفسر
;

// Value IDs and place-producing instructions share exactly one execution-slot namespace.
عام نوع خانة_تنفيذ_مسير =
    | غير_مهيأة
    | قيمة بنوع قيمة_تشغيل
    | مكان بنوع مكان_تشغيل
;

عام عرف معرف_تفعيل_مفسر_من(القيمة: طبيعي): معرف_تفعيل_مفسر {
    دع المعرف: معرف_تفعيل_مفسر = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرفا_تفعيل_مفسر_متساويان(أ: معرف_تفعيل_مفسر, ب: معرف_تفعيل_مفسر): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف معرف_صندوق_مفسر_من(القيمة: طبيعي, الجيل: طبيعي): معرف_صندوق_مفسر {
    دع المعرف: معرف_صندوق_مفسر = { القيمة: القيمة, الجيل: الجيل };
    أرجع المعرف;
}

عام عرف معرف_إغلاق_مفسر_من(القيمة: طبيعي, الجيل: طبيعي): معرف_إغلاق_مفسر {
    دع المعرف: معرف_إغلاق_مفسر = { القيمة: القيمة, الجيل: الجيل };
    أرجع المعرف;
}

عام عرف معرف_مخزن_مفسر_من(القيمة: طبيعي, الجيل: طبيعي): معرف_مخزن_مفسر {
    دع المعرف: معرف_مخزن_مفسر = { القيمة: القيمة, الجيل: الجيل };
    أرجع المعرف;
}

عام عرف معرف_خلية_محلية_مفسر_من(القيمة: طبيعي): معرف_خلية_محلية_مفسر {
    دع المعرف: معرف_خلية_محلية_مفسر = { القيمة: القيمة };
    أرجع المعرف;
}

عرف انسخ_جذر_مكان_تشغيل(الجذر: &جذر_مكان_تشغيل): جذر_مكان_تشغيل {
    طابق *الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        أرجع جذر_مكان_تشغيل.محلي(التفعيل, الخلية);
    }
    | جذر_مكان_تشغيل.عام(المعرف) -> {
        أرجع جذر_مكان_تشغيل.عام(المعرف);
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        أرجع جذر_مكان_تشغيل.صندوق(المعرف);
    }
    | جذر_مكان_تشغيل.مخزن(المعرف) -> {
        أرجع جذر_مكان_تشغيل.مخزن(المعرف);
    };
}

عرف انسخ_إسقاط_مكان_تشغيل(الإسقاط: &إسقاط_مكان_تشغيل): إسقاط_مكان_تشغيل {
    طابق *الإسقاط مع
    | إسقاط_مكان_تشغيل.حقل(الفهرس) -> {
        أرجع إسقاط_مكان_تشغيل.حقل(الفهرس);
    }
    | إسقاط_مكان_تشغيل.فهرس(الفهرس) -> {
        أرجع إسقاط_مكان_تشغيل.فهرس(الفهرس);
    };
}

عام عرف انسخ_مكان_تشغيل(المكان: &مكان_تشغيل): مكان_تشغيل {
    دع القيمة: مكان_تشغيل = *المكان;
    دع الجذر: جذر_مكان_تشغيل = انسخ_جذر_مكان_تشغيل(&القيمة.الجذر);
    دع الإسقاطات: متغير متجه إسقاط_مكان_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة.الإسقاطات) مثل طبيعي)) {
        دع الإسقاط: إسقاط_مكان_تشغيل = انسخ_إسقاط_مكان_تشغيل(&القيمة.الإسقاطات[ف]);
        ألحق(الإسقاطات, الإسقاط);
        ف := ف + 1;
    }
    دع قابل_للكتابة: منطقي = القيمة.قابل_للكتابة;
    دع الناتج: مكان_تشغيل = {
        الجذر: الجذر,
        الإسقاطات: الإسقاطات,
        قابل_للكتابة: قابل_للكتابة
    };
    أرجع الناتج;
}

// Aliasing depends on canonical allocation and projection identity, not on
// whether one borrow permits mutation. Machine pointer bits prove nothing.
عام عرف مكانا_تخزين_متطابقان(الأول: &مكان_تشغيل, الثاني: &مكان_تشغيل): منطقي {
    طابق (*الأول).الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        طابق (*الثاني).الجذر مع
        | جذر_مكان_تشغيل.محلي(الآخر, الخلية_الأخرى) -> {
            إذا (التفعيل.القيمة != الآخر.القيمة || الخلية.القيمة != الخلية_الأخرى.القيمة) {
                أرجع خطأ;
            };
        }
        | _ -> { أرجع خطأ; };
    }
    | جذر_مكان_تشغيل.عام(المعرف) -> {
        طابق (*الثاني).الجذر مع
        | جذر_مكان_تشغيل.عام(الآخر) -> {
            إذا (المعرف.القيمة != الآخر.القيمة) { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        طابق (*الثاني).الجذر مع
        | جذر_مكان_تشغيل.صندوق(الآخر) -> {
            إذا (المعرف.القيمة != الآخر.القيمة || المعرف.الجيل != الآخر.الجيل) {
                أرجع خطأ;
            };
        }
        | _ -> { أرجع خطأ; };
    }
    | جذر_مكان_تشغيل.مخزن(المعرف) -> {
        طابق (*الثاني).الجذر مع
        | جذر_مكان_تشغيل.مخزن(الآخر) -> {
            إذا (المعرف.القيمة != الآخر.القيمة || المعرف.الجيل != الآخر.الجيل) {
                أرجع خطأ;
            };
        }
        | _ -> { أرجع خطأ; };
    };
    دع العدد: طبيعي = الطول((*الأول).الإسقاطات) مثل طبيعي;
    إذا (العدد != (الطول((*الثاني).الإسقاطات) مثل طبيعي)) { أرجع خطأ; };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        طابق (*الأول).الإسقاطات[الفهرس] مع
        | إسقاط_مكان_تشغيل.حقل(العضو) -> {
            طابق (*الثاني).الإسقاطات[الفهرس] مع
            | إسقاط_مكان_تشغيل.حقل(الآخر) -> {
                إذا (العضو != الآخر) { أرجع خطأ; };
            }
            | _ -> { أرجع خطأ; };
        }
        | إسقاط_مكان_تشغيل.فهرس(العضو) -> {
            طابق (*الثاني).الإسقاطات[الفهرس] مع
            | إسقاط_مكان_تشغيل.فهرس(الآخر) -> {
                إذا (العضو != الآخر) { أرجع خطأ; };
            }
            | _ -> { أرجع خطأ; };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

// Equality of runtime references also includes their granted write permission.
// Keep this stricter check for MSIR pointer/origin provenance validation.
عام عرف مكانا_تشغيل_متطابقان(الأول: &مكان_تشغيل, الثاني: &مكان_تشغيل): منطقي {
    أرجع (*الأول).قابل_للكتابة == (*الثاني).قابل_للكتابة
        && مكانا_تخزين_متطابقان(الأول, الثاني);
}

عام عرف انسخ_قيمة_تشغيل(القيمة: &قيمة_تشغيل): قيمة_تشغيل {
    طابق *القيمة مع
    | قيمة_تشغيل.منطق(المنطق) -> {
        أرجع قيمة_تشغيل.منطق(المنطق);
    }
    | قيمة_تشغيل.بتات_عدد(الخام) -> {
        أرجع قيمة_تشغيل.بتات_عدد(الخام);
    }
    | قيمة_تشغيل.محرف(المحرف) -> {
        أرجع قيمة_تشغيل.محرف(المحرف);
    }
    | قيمة_تشغيل.نص(البايتات) -> {
        دع النسخة: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(البايتات) مثل طبيعي)) {
            ألحق(النسخة, البايتات[ف]);
            ف := ف + 1;
        }
        أرجع قيمة_تشغيل.نص(النسخة);
    }
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        دع النسخة: متغير متجه قيمة_تشغيل = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأعضاء) مثل طبيعي)) {
            دع العضو: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الأعضاء[ف]);
            ألحق(النسخة, العضو);
            ف := ف + 1;
        }
        أرجع قيمة_تشغيل.تجميع(النسخة);
    }
    | قيمة_تشغيل.موسوم(الموسوم) -> {
        دع الحمولات: متغير متجه قيمة_تشغيل = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الموسوم.الحمولات) مثل طبيعي)) {
            دع الحمولة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الموسوم.الحمولات[ف]);
            ألحق(الحمولات, الحمولة);
            ف := ف + 1;
        }
        دع المنشئ: طبيعي = الموسوم.المنشئ;
        دع نسخة_الموسوم: قيمة_موسومة_تشغيل = {
            المنشئ: المنشئ,
            الحمولات: الحمولات
        };
        أرجع قيمة_تشغيل.موسوم(نسخة_الموسوم);
    }
    | قيمة_تشغيل.مرجع(المكان) -> {
        دع النسخة: مكان_تشغيل = انسخ_مكان_تشغيل(&المكان);
        أرجع قيمة_تشغيل.مرجع(النسخة);
    }
    | قيمة_تشغيل.مؤشر_فارغ -> {
        أرجع قيمة_تشغيل.مؤشر_فارغ();
    }
    | قيمة_تشغيل.صندوق(المعرف) -> {
        أرجع قيمة_تشغيل.صندوق(المعرف);
    }
    | قيمة_تشغيل.دالة(الدالة) -> {
        أرجع قيمة_تشغيل.دالة(الدالة);
    }
    | قيمة_تشغيل.إغلاق(الإغلاق) -> {
        أرجع قيمة_تشغيل.إغلاق(الإغلاق);
    }
    | قيمة_تشغيل.مخزن(المعرف) -> {
        أرجع قيمة_تشغيل.مخزن(المعرف);
    };
}

عام عرف انسخ_خانة_تنفيذ_مسير(الخانة: &خانة_تنفيذ_مسير): خانة_تنفيذ_مسير {
    طابق *الخانة مع
    | خانة_تنفيذ_مسير.غير_مهيأة -> {
        أرجع خانة_تنفيذ_مسير.غير_مهيأة();
    }
    | خانة_تنفيذ_مسير.قيمة(القيمة) -> {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
        أرجع خانة_تنفيذ_مسير.قيمة(النسخة);
    }
    | خانة_تنفيذ_مسير.مكان(المكان) -> {
        دع النسخة: مكان_تشغيل = انسخ_مكان_تشغيل(&المكان);
        أرجع خانة_تنفيذ_مسير.مكان(النسخة);
    };
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_قيمة_تشغيل(القيمة: &متجه قيمة_تشغيل): متجه قيمة_تشغيل {
    دع الناتج: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_قيمة_تشغيل(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_قيمة_تشغيل(القيمة: &قيمة_تشغيل): قيمة_تشغيل {
    طابق *القيمة مع
    | قيمة_تشغيل.منطق(ح0) -> { أرجع قيمة_تشغيل.منطق(ح0); }
    | قيمة_تشغيل.بتات_عدد(ح0) -> { أرجع قيمة_تشغيل.بتات_عدد(ح0); }
    | قيمة_تشغيل.محرف(ح0) -> { أرجع قيمة_تشغيل.محرف(ح0); }
    | قيمة_تشغيل.نص(ح0) -> { أرجع قيمة_تشغيل.نص(انسخ_بايتات(&ح0)); }
    | قيمة_تشغيل.تجميع(ح0) -> { أرجع قيمة_تشغيل.تجميع(انسخ_مملوكا_متجه_قيمة_تشغيل(&ح0)); }
    | قيمة_تشغيل.موسوم(ح0) -> { أرجع قيمة_تشغيل.موسوم(انسخ_مملوكا_قيمة_موسومة_تشغيل(&ح0)); }
    | قيمة_تشغيل.مرجع(ح0) -> { أرجع قيمة_تشغيل.مرجع(انسخ_مملوكا_مكان_تشغيل(&ح0)); }
    | قيمة_تشغيل.مؤشر_فارغ -> { أرجع قيمة_تشغيل.مؤشر_فارغ(); }
    | قيمة_تشغيل.صندوق(ح0) -> { أرجع قيمة_تشغيل.صندوق(ح0); }
    | قيمة_تشغيل.دالة(ح0) -> { أرجع قيمة_تشغيل.دالة(ح0); }
    | قيمة_تشغيل.إغلاق(ح0) -> { أرجع قيمة_تشغيل.إغلاق(ح0); }
    | قيمة_تشغيل.مخزن(ح0) -> { أرجع قيمة_تشغيل.مخزن(ح0); };
}

عام عرف انسخ_مملوكا_قيمة_موسومة_تشغيل(القيمة: &قيمة_موسومة_تشغيل): قيمة_موسومة_تشغيل {
    دع الناتج: قيمة_موسومة_تشغيل = {
        المنشئ: (*القيمة).المنشئ,
        الحمولات: انسخ_مملوكا_متجه_قيمة_تشغيل(&(*القيمة).الحمولات)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_مكان_تشغيل(القيمة: &مكان_تشغيل): مكان_تشغيل {
    دع الناتج: مكان_تشغيل = {
        الجذر: (*القيمة).الجذر,
        الإسقاطات: انسخ_مملوكا_متجه_إسقاط_مكان_تشغيل(&(*القيمة).الإسقاطات),
        قابل_للكتابة: (*القيمة).قابل_للكتابة
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_إسقاط_مكان_تشغيل(القيمة: &متجه إسقاط_مكان_تشغيل): متجه إسقاط_مكان_تشغيل {
    دع الناتج: متغير متجه إسقاط_مكان_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
