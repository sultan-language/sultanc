استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.runtime_failures;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.msir_model;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_registry;
استورد compiler.runtime.vector_memory_policy;

// The interpreter heap. Like the native runtime, a vector, slice or text
// value is a handle to one heap buffer, a box value a handle to one cell and
// a closure value a handle to its counted environment. Copying a value copies
// the handle; MSIR ownership (drop elaboration and the per-Type glue every
// backend runs) decides when the release primitive frees the storage. Freed
// slots are reused through free lists, and a generation per slot rejects a
// stale handle (a use after free) instead of reading reused storage, as
// Miri's allocation IDs do.

// One heap buffer. Byte elements (u8 vectors and text) are stored as bytes,
// other elements as runtime values. An interned literal is static: never
// released, copied before it grows, and never written in place.
// السعة is the vector's capacity as native code keeps it in the header: the
// element count when the buffer is made, grown by append as the native
// growth policy grows it (vector_memory_policy.sn), raised by reserve, and
// kept by pop and truncate, so `capacity` answers as in an executable.
عام نوع مخزن_مفسر = {
    حي: منطقي,
    الجيل: طبيعي,
    بايتات: منطقي,
    ثابت: منطقي,
    السعة: طبيعي,
    // The element's size in bytes, the one the compiled backends' growth
    // policy reads (1 for a byte buffer; 8 when the element Type is unknown).
    حجم_العنصر: طبيعي,
    القيم: متجه قيمة_تشغيل,
    البايتات: متجه ط8,
    التالي_الحر: اختياري طبيعي
};

عام نوع خلية_صندوق_مفسر = {
    حي: منطقي,
    الجيل: طبيعي,
    القيمة: قيمة_تشغيل,
    التالي_الحر: اختياري طبيعي
};

// A closure environment, reference counted as the native environment header
// is (docs/en/reference/ownership.md, "Closure environments").
عام نوع سجل_إغلاق_مفسر = {
    حي: منطقي,
    الجيل: طبيعي,
    الدالة: معرف_دالة_مسير,
    الالتقاطات: متجه قيمة_تشغيل,
    المراجع: طبيعي,
    المدمر: اختياري معرف_دالة_مسير,
    التالي_الحر: اختياري طبيعي
};

عام نوع خلية_عام_مفسر = {
    مهيأة: منطقي,
    القيمة: قيمة_تشغيل
};

// A host region: memory the host returned to the interpreted program (an
// environment block, a CERT_CONTEXT, an opaque handle), as Miri gives every
// foreign allocation a provenance-tracked place. The bytes are mirrored in
// one interpreter buffer of fixed length (u8 elements as bytes, wider
// integers as values, a record per element for a record pointee), so every
// read and write through a pointer into the region is bounds-checked like
// any buffer access, and a freed region's buffer generation turns a later
// use into a stale-handle report. The bridge passes the region's host
// address back to the host (العنوان + element offset), writes changed
// mirror bytes to the host before a call that receives the region and
// reads them back afterwards. An opaque region (a pointer whose extent no
// contract gives) has no elements: it can be compared and passed back, and
// any dereference is out of bounds.
عام نوع منطقة_مضيف_مفسر = {
    حية: منطقي,
    المخزن: معرف_مخزن_مفسر,
    العنوان: ط64,
    // Bytes per element and the element's record Type for a record pointee.
    عرض_العنصر: طبيعي,
    نوع_السجل: اختياري معرف_نوع,
    قابلة_للكتابة: منطقي,
    // The mirror's bytes as last exchanged with the host.
    اللقطة: متجه ط8,
    // Regions reached through this one's pointer fields, freed with it.
    التابعة: متجه طبيعي
};

// An interpreter-side DIR stream (opendir/readdir/closedir shims): the
// token buffer the program holds, the host DIR*, and the buffer of the last
// entry readdir returned (valid until the next readdir, as POSIX says).
عام نوع دليل_مضيف_مفسر = {
    حي: منطقي,
    الرمز: معرف_مخزن_مفسر,
    العنوان: ط64,
    المدخل: اختياري معرف_مخزن_مفسر
};

عام نوع ذاكرة_مفسر = {
    الصناديق: متجه خلية_صندوق_مفسر,
    رأس_الصناديق_الحرة: اختياري طبيعي,
    المخازن: متجه مخزن_مفسر,
    رأس_المخازن_الحرة: اختياري طبيعي,
    الإغلاقات: متجه سجل_إغلاق_مفسر,
    رأس_الإغلاقات_الحرة: اختياري طبيعي,
    العوام: متجه خلية_عام_مفسر,
    // Live storage, for tests and measurements of bounded memory.
    المخازن_الحية: طبيعي,
    الصناديق_الحية: طبيعي,
    الإغلاقات_الحية: طبيعي,
    // The host bridge (execution/foreign_calls.sn): host regions, the
    // interpreter's errno / last-error cell, DIR streams, the address lists
    // built by the getaddrinfo shims (each a vector of its buffers, the head
    // first), and the libraries opened for a program's own externs.
    مناطق_المضيف: متجه منطقة_مضيف_مفسر,
    خلية_رقم_الخطأ: اختياري معرف_مخزن_مفسر,
    أدلة_المضيف: متجه دليل_مضيف_مفسر,
    قوائم_عناوين_المضيف: متجه متجه معرف_مخزن_مفسر,
    مكتبات_المضيف: متجه ط64,
    مكتبات_المضيف_مفتوحة: منطقي,
    // std.async's suspended tasks (execution/task_switch.sn): each a whole
    // frame stack set aside by the context switch, found by its token. A
    // place in one of them (a task's local another task borrows) resolves
    // there.
    سياقات_المهام: متجه سياق_مهمة_مفسر,
    // The program's storage calls as std's allocator counts them
    // (allocations, frees, reallocations, requested bytes): a buffer's first
    // storage, its growth and its release, a box, a closure environment with
    // captures. A call to one of std's counter functions answers these
    // (execution/calls.sn), as the machine interpreter answers its own (op
    // 57). Bytes are counted at 8 per value element and per box or capture
    // (1 per byte element): the checked interpreter keeps values, not their
    // layout.
    عدادات_التخزين: متجه طبيعي
};

// A frame stack set aside by the task switch: its frames and depth, and the
// slot of the pending switch call that receives 0 when it resumes.
عام نوع سياق_مهمة_مفسر = {
    المكدس: متجه إطار_تفسير_مسير,
    العمق: طبيعي,
    الوجهة: اختياري معرف_قيمة_مسير,
    مشغول: منطقي,
    // The machine word its token was saved in (a task's stack slot), 0 for
    // a variable.
    العنوان: طبيعي
};

نوع إطار_معلق_مفسر = { السياق: طبيعي, الإطار: طبيعي };

// The frame of التفعيل in a suspended task's stack.
عرف إطار_معلق_للتفعيل(الذاكرة: &ذاكرة_مفسر, التفعيل: معرف_تفعيل_مفسر): اختياري إطار_معلق_مفسر {
    دع ق: متغير طبيعي = 0;
    طالما (ق < (الطول((*الذاكرة).سياقات_المهام) مثل طبيعي)) {
        إذا ((*الذاكرة).سياقات_المهام[ق].مشغول) {
            طابق مؤشر_تفعيل_في_المكدس(
                &(*الذاكرة).سياقات_المهام[ق].المكدس, (*الذاكرة).سياقات_المهام[ق].العمق, التفعيل
            ) مع
            | اختياري.موجود(ف) -> {
                دع الموضع: إطار_معلق_مفسر = { السياق: ق, الإطار: ف };
                أرجع اختياري.موجود(الموضع);
            }
            | اختياري.لا_شيء -> { };
        };
        ق := ق + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف خلية_إطار_صالحة_مفسر(الإطار: &إطار_تفسير_مسير, الخلية: طبيعي, الإسقاطات: &متجه إسقاط_مكان_تشغيل): منطقي {
    إذا (الخلية >= (*الإطار).عدد_المحليات) { أرجع خطأ; };
    دع الخلية_المرجع: &خلية_محلية_مفسر = &(*الإطار).المحليات[الخلية];
    إذا (!(*الخلية_المرجع).مهيأة) { أرجع (الطول(*الإسقاطات) مثل طبيعي) == 0; };
    أرجع إسقاطات_مكان_مفسر_صالحة(&(*الخلية_المرجع).القيمة, الإسقاطات, 0);
}

عرف اقرأ_خلية_إطار_مفسر(الإطار: &إطار_تفسير_مسير, الخلية: طبيعي, الإسقاطات: &متجه إسقاط_مكان_تشغيل): نتيجة_قراءة_ذاكرة_مفسر {
    إذا (الخلية >= (*الإطار).عدد_المحليات) { أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(فشل_ذاكرة_تالفة_مفسر()); };
    دع الخلية_المرجع: &خلية_محلية_مفسر = &(*الإطار).المحليات[الخلية];
    إذا (!(*الخلية_المرجع).مهيأة) { أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(فشل_ذاكرة_تالفة_مفسر()); };
    أرجع اقرأ_إسقاطا(&(*الخلية_المرجع).القيمة, الإسقاطات, 0);
}

عرف اكتب_خلية_إطار_مفسر(
    الإطار: &متغير إطار_تفسير_مسير, الخلية: طبيعي, الإسقاطات: &متجه إسقاط_مكان_تشغيل, القيمة: قيمة_تشغيل
): نتيجة_كتابة_ذاكرة_مفسر {
    إذا (الخلية >= (*الإطار).عدد_المحليات) { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_ذاكرة_تالفة_مفسر()); };
    إذا ((الطول(*الإسقاطات) مثل طبيعي) == 0) {
        (*الإطار).المحليات[الخلية].القيمة := القيمة;
        (*الإطار).المحليات[الخلية].مهيأة := صواب;
        أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
    };
    إذا (!(*الإطار).المحليات[الخلية].مهيأة) { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_ذاكرة_تالفة_مفسر()); };
    أرجع نتيجة_كتابة_من_فشل(اكتب_إسقاطا(&متغير (*الإطار).المحليات[الخلية].القيمة, الإسقاطات, 0, القيمة));
}

عام نوع نتيجة_قراءة_ذاكرة_مفسر =
    | قيمة بنوع قيمة_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;

عام نوع نتيجة_كتابة_ذاكرة_مفسر =
    | نجحت
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف ذاكرة_مفسر_جديدة(): ذاكرة_مفسر {
    دع الصناديق: متجه خلية_صندوق_مفسر = [];
    دع المخازن: متجه مخزن_مفسر = [];
    دع الإغلاقات: متجه سجل_إغلاق_مفسر = [];
    دع العوام: متجه خلية_عام_مفسر = [];
    دع مناطق_المضيف: متجه منطقة_مضيف_مفسر = [];
    دع أدلة_المضيف: متجه دليل_مضيف_مفسر = [];
    دع قوائم_عناوين_المضيف: متجه متجه معرف_مخزن_مفسر = [];
    دع مكتبات_المضيف: متجه ط64 = [];
    دع سياقات_المهام: متجه سياق_مهمة_مفسر = [];
    دع الذاكرة: ذاكرة_مفسر = {
        الصناديق: الصناديق,
        رأس_الصناديق_الحرة: اختياري.لا_شيء(),
        المخازن: المخازن,
        رأس_المخازن_الحرة: اختياري.لا_شيء(),
        الإغلاقات: الإغلاقات,
        رأس_الإغلاقات_الحرة: اختياري.لا_شيء(),
        العوام: العوام,
        المخازن_الحية: 0,
        الصناديق_الحية: 0,
        الإغلاقات_الحية: 0,
        مناطق_المضيف: مناطق_المضيف,
        خلية_رقم_الخطأ: اختياري.لا_شيء(),
        أدلة_المضيف: أدلة_المضيف,
        قوائم_عناوين_المضيف: قوائم_عناوين_المضيف,
        مكتبات_المضيف: مكتبات_المضيف,
        مكتبات_المضيف_مفتوحة: خطأ,
        سياقات_المهام: سياقات_المهام,
        عدادات_التخزين: [0, 0, 0, 0]
    };
    أرجع الذاكرة;
}

عرف فشل_ذاكرة_تالفة_مفسر(): فشل_تفسير_مسير {
    أرجع فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف());
}

// ---- Buffers ----------------------------------------------------------------

// One storage call: النوع 0 allocation, 1 free, 2 reallocation.
عرف عد_تخزين_مفسر(الذاكرة: &متغير ذاكرة_مفسر, النوع: طبيعي, البايتات: طبيعي): فراغ {
    (*الذاكرة).عدادات_التخزين[النوع] := (*الذاكرة).عدادات_التخزين[النوع] + 1;
    إذا (النوع != 1) { (*الذاكرة).عدادات_التخزين[3] := (*الذاكرة).عدادات_التخزين[3] + البايتات; };
}

// A buffer's capacity moved from القديمة to الجديدة elements: its first
// storage, or its growth.
عرف عد_سعة_مخزن_مفسر(الذاكرة: &متغير ذاكرة_مفسر, القديمة: طبيعي, الجديدة: طبيعي, العرض: طبيعي): فراغ {
    إذا (الجديدة <= القديمة) { أرجع; };
    إذا (القديمة == 0) { عد_تخزين_مفسر(الذاكرة, 0, الجديدة * العرض); }
    وإلا { عد_تخزين_مفسر(الذاكرة, 2, الجديدة * العرض); };
}

// Counter النوع of std's (0..3 the process's, 4..7 the calling thread's,
// the same in an interpreter without threads; as دوال_عدادات_التخصيص).
عام عرف عداد_تخزين_مفسر(الذاكرة: &ذاكرة_مفسر, النوع: طبيعي): طبيعي {
    أرجع (*الذاكرة).عدادات_التخزين[النوع % 4];
}

// The capacity native code gives a vector built from العدد elements: a
// vector literal is built by appends, so its capacity follows the growth
// policy (vector_memory_policy.sn), as in the native and LLVM backends.
عرف سعة_نمو_لعدد_مفسر(العدد: طبيعي, حجم_العنصر: طبيعي): طبيعي {
    إذا (العدد == 0) { أرجع 0; };
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(حجم_العنصر);
    دع السعة: متغير طبيعي = السياسة.السعة_الدنيا;
    إذا (السعة == 0) { السعة := 1; };
    طالما (السعة < العدد) { السعة := السعة * السياسة.عامل_النمو; }
    أرجع السعة;
}

// The capacity an append that needs room for المطلوب elements grows a buffer
// of capacity القديمة to, as compiled code does (Rust's RawVec rule): at least
// double, at least what is needed, and never below the policy's minimum.
عرف سعة_بعد_نمو_مفسر(القديمة: طبيعي, المطلوب: طبيعي, حجم_العنصر: طبيعي): طبيعي {
    دع السياسة: سياسة_نمو_متجه = سياسة_نمو_المتجه_لعنصر(حجم_العنصر);
    دع الجديدة: متغير طبيعي = القديمة * السياسة.عامل_النمو;
    إذا (الجديدة < المطلوب) { الجديدة := المطلوب; };
    إذا (الجديدة < السياسة.السعة_الدنيا) { الجديدة := السياسة.السعة_الدنيا; };
    أرجع الجديدة;
}

عرف أدخل_مخزن_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    القيم: متجه قيمة_تشغيل,
    البايتات: متجه ط8,
    بايتات: منطقي,
    ثابت: منطقي,
    حجم_العنصر: طبيعي
): معرف_مخزن_مفسر {
    (*الذاكرة).المخازن_الحية := (*الذاكرة).المخازن_الحية + 1;
    دع العدد: متغير طبيعي = الطول(القيم) مثل طبيعي;
    إذا (بايتات) { العدد := الطول(البايتات) مثل طبيعي; };
    دع السعة: طبيعي = سعة_نمو_لعدد_مفسر(العدد, حجم_العنصر);
    إذا (!ثابت) { عد_سعة_مخزن_مفسر(الذاكرة, 0, السعة, حجم_العنصر); };
    طابق (*الذاكرة).رأس_المخازن_الحرة مع
    | اختياري.لا_شيء -> {
        دع الموضع: طبيعي = الطول((*الذاكرة).المخازن) مثل طبيعي;
        دع المخزن: مخزن_مفسر = {
            حي: صواب, الجيل: 0, بايتات: بايتات, ثابت: ثابت, السعة: السعة, حجم_العنصر: حجم_العنصر,
            القيم: القيم, البايتات: البايتات, التالي_الحر: اختياري.لا_شيء()
        };
        ألحق((*الذاكرة).المخازن, المخزن);
        أرجع معرف_مخزن_مفسر_من(الموضع, 0);
    }
    | اختياري.موجود(الموضع) -> {
        دع الجيل: طبيعي = (*الذاكرة).المخازن[الموضع].الجيل + 1;
        (*الذاكرة).رأس_المخازن_الحرة := (*الذاكرة).المخازن[الموضع].التالي_الحر;
        دع المخزن: مخزن_مفسر = {
            حي: صواب, الجيل: الجيل, بايتات: بايتات, ثابت: ثابت, السعة: السعة, حجم_العنصر: حجم_العنصر,
            القيم: القيم, البايتات: البايتات, التالي_الحر: اختياري.لا_شيء()
        };
        (*الذاكرة).المخازن[الموضع] := المخزن;
        أرجع معرف_مخزن_مفسر_من(الموضع, الجيل);
    };
}

عام عرف خصص_مخزن_قيم_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    القيم: متجه قيمة_تشغيل
): معرف_مخزن_مفسر {
    أرجع خصص_مخزن_قيم_بحجم_مفسر(الذاكرة, القيم, 8);
}

// A value buffer whose elements are حجم_العنصر bytes each in compiled code.
عام عرف خصص_مخزن_قيم_بحجم_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    القيم: متجه قيمة_تشغيل,
    حجم_العنصر: طبيعي
): معرف_مخزن_مفسر {
    دع بلا_بايتات: متجه ط8 = [];
    أرجع أدخل_مخزن_مفسر(الذاكرة, القيم, بلا_بايتات, خطأ, خطأ, حجم_العنصر);
}

عام عرف خصص_مخزن_بايتات_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    البايتات: متجه ط8,
    ثابت: منطقي
): معرف_مخزن_مفسر {
    دع بلا_قيم: متجه قيمة_تشغيل = [];
    أرجع أدخل_مخزن_مفسر(الذاكرة, بلا_قيم, البايتات, صواب, ثابت, 1);
}

عام عرف هوية_مخزن_مفسر_صالحة(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): منطقي {
    إذا (المعرف.القيمة >= (الطول((*الذاكرة).المخازن) مثل طبيعي)) { أرجع خطأ; };
    دع المخزن: &مخزن_مفسر = &(*الذاكرة).المخازن[المعرف.القيمة];
    أرجع (*المخزن).حي && (*المخزن).الجيل == المعرف.الجيل;
}

عام عرف طول_مخزن_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): اختياري طبيعي {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    دع المخزن: &مخزن_مفسر = &(*الذاكرة).المخازن[المعرف.القيمة];
    إذا ((*المخزن).بايتات) {
        أرجع اختياري.موجود(الطول((*المخزن).البايتات) مثل طبيعي);
    };
    أرجع اختياري.موجود(الطول((*المخزن).القيم) مثل طبيعي);
}

// The capacity of a live buffer (see مخزن_مفسر).
عام عرف سعة_مخزن_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): اختياري طبيعي {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الذاكرة).المخازن[المعرف.القيمة].السعة);
}

// Reserve: the buffer holds at least its length plus الإضافي elements,
// exactly that many when it grows (Rust's Vec::reserve_exact). Returns the
// handle the vector has afterwards (a static buffer is copied first, as
// append copies it), or لا_شيء for a stale handle.
عام عرف احجز_سعة_مخزن_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر,
    الإضافي: طبيعي
): اختياري معرف_مخزن_مفسر {
    دع العدد: طبيعي;
    طابق طول_مخزن_مفسر(الذاكرة, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ط) -> { العدد := ط; };
    دع المطلوب: طبيعي = العدد + الإضافي;
    إذا (المطلوب <= (*الذاكرة).المخازن[المعرف.القيمة].السعة) { أرجع اختياري.موجود(المعرف); };
    دع الهدف: متغير معرف_مخزن_مفسر = المعرف;
    إذا ((*الذاكرة).المخازن[المعرف.القيمة].ثابت) {
        طابق انسخ_مخزن_مفسر(الذاكرة, المعرف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الجديد) -> { الهدف := الجديد; };
    };
    عد_سعة_مخزن_مفسر(
        الذاكرة, (*الذاكرة).المخازن[الهدف.القيمة].السعة, المطلوب, (*الذاكرة).المخازن[الهدف.القيمة].حجم_العنصر
    );
    (*الذاكرة).المخازن[الهدف.القيمة].السعة := المطلوب;
    أرجع اختياري.موجود(الهدف);
}

عام عرف مخزن_مفسر_ثابت(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): منطقي {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    أرجع (*الذاكرة).المخازن[المعرف.القيمة].ثابت;
}

// Element الفهرس of a live buffer, or لا_شيء when the handle is stale or
// the index is past the end.
عام عرف اقرأ_عنصر_مخزن_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر,
    الفهرس: طبيعي
): اختياري قيمة_تشغيل {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    دع المخزن: &مخزن_مفسر = &(*الذاكرة).المخازن[المعرف.القيمة];
    إذا ((*المخزن).بايتات) {
        إذا (الفهرس >= (الطول((*المخزن).البايتات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(قيمة_تشغيل.بتات_عدد((*المخزن).البايتات[الفهرس] مثل طبيعي));
    };
    إذا (الفهرس >= (الطول((*المخزن).القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_قيمة_تشغيل(&(*المخزن).القيم[الفهرس]));
}

// A byte buffer that must hold a value that is not a byte switches to the
// general element form once; its elements keep their values.
عرف حول_مخزن_إلى_قيم_مفسر(المخزن: &متغير مخزن_مفسر): فراغ {
    إذا (!(*المخزن).بايتات) { أرجع; };
    دع القيم: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخزن).البايتات) مثل طبيعي)) {
        ألحق(القيم, قيمة_تشغيل.بتات_عدد((*المخزن).البايتات[ف] مثل طبيعي));
        ف := ف + 1;
    }
    دع فارغة: متجه ط8 = [];
    (*المخزن).البايتات := فارغة;
    (*المخزن).القيم := القيم;
    (*المخزن).بايتات := خطأ;
}

عرف قيمة_بايت_مفسر(القيمة: &قيمة_تشغيل): اختياري ط8 {
    طابق *القيمة مع
    | قيمة_تشغيل.بتات_عدد(البتات) -> {
        إذا (البتات <= 255) { أرجع اختياري.موجود(البتات مثل ط8); };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Appends in place: amortized O(1), as the native vector grows its buffer
// geometrically. The caller handles a static buffer (copy, then append).
عرف ألحق_بمخزن_حي_مفسر(
    المخزن: &متغير مخزن_مفسر,
    العنصر: قيمة_تشغيل
): فراغ {
    دع العدد: متغير طبيعي = الطول((*المخزن).القيم) مثل طبيعي;
    إذا ((*المخزن).بايتات) { العدد := الطول((*المخزن).البايتات) مثل طبيعي; };
    إذا (العدد >= (*المخزن).السعة) {
        (*المخزن).السعة := سعة_بعد_نمو_مفسر((*المخزن).السعة, العدد + 1, (*المخزن).حجم_العنصر);
    };
    إذا ((*المخزن).بايتات) {
        طابق قيمة_بايت_مفسر(&العنصر) مع
        | اختياري.موجود(البايت) -> {
            ألحق((*المخزن).البايتات, البايت);
            أرجع;
        }
        | اختياري.لا_شيء -> { حول_مخزن_إلى_قيم_مفسر(المخزن); };
    };
    ألحق((*المخزن).القيم, العنصر);
}

// An independent, non-static copy of a buffer's elements.
عرف انسخ_مخزن_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): اختياري معرف_مخزن_مفسر {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    إذا ((*الذاكرة).المخازن[المعرف.القيمة].بايتات) {
        دع البايتات: متجه ط8 = انسخ_بايتات_مخزن_مفسر(&(*الذاكرة).المخازن[المعرف.القيمة].البايتات);
        أرجع اختياري.موجود(خصص_مخزن_بايتات_مفسر(الذاكرة, البايتات, خطأ));
    };
    دع القيم: متجه قيمة_تشغيل = انسخ_مملوكا_متجه_قيمة_تشغيل(&(*الذاكرة).المخازن[المعرف.القيمة].القيم);
    دع الحجم: طبيعي = (*الذاكرة).المخازن[المعرف.القيمة].حجم_العنصر;
    أرجع اختياري.موجود(خصص_مخزن_قيم_بحجم_مفسر(الذاكرة, القيم, الحجم));
}

عرف انسخ_بايتات_مخزن_مفسر(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Appends one element to the vector whose handle is المعرف. Returns the
// handle the vector has afterwards: the same one, or for a static buffer a
// new copy (the caller stores it back, as native code stores a reallocated
// buffer pointer), or لا_شيء for a stale handle.
عام عرف ألحق_بمخزن_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر,
    العنصر: قيمة_تشغيل
): اختياري معرف_مخزن_مفسر {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    دع الهدف: متغير معرف_مخزن_مفسر = المعرف;
    إذا ((*الذاكرة).المخازن[المعرف.القيمة].ثابت) {
        طابق انسخ_مخزن_مفسر(الذاكرة, المعرف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الجديد) -> { الهدف := الجديد; };
    };
    دع القديمة: طبيعي = (*الذاكرة).المخازن[الهدف.القيمة].السعة;
    ألحق_بمخزن_حي_مفسر(&متغير (*الذاكرة).المخازن[الهدف.القيمة], العنصر);
    عد_سعة_مخزن_مفسر(
        الذاكرة, القديمة, (*الذاكرة).المخازن[الهدف.القيمة].السعة, (*الذاكرة).المخازن[الهدف.القيمة].حجم_العنصر
    );
    أرجع اختياري.موجود(الهدف);
}

// Shortens the vector whose handle is المعرف to its first الطول elements
// (pop and truncate glue; الطول is below the current length). Returns the
// handle the vector has afterwards: the same one, or for a static buffer a
// shortened copy the caller stores back (as append does), or لا_شيء for a
// stale handle or a length that is not shorter. The interpreter's buffers
// keep their elements in a SultanC vector, which only grows, so the kept
// elements move into a new one.
عام عرف اقتطع_مخزن_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر,
    الطول: طبيعي
): اختياري معرف_مخزن_مفسر {
    طابق طول_مخزن_مفسر(الذاكرة, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الحالي) -> { إذا (الطول >= الحالي) { أرجع اختياري.لا_شيء(); }; };
    إذا ((*الذاكرة).المخازن[المعرف.القيمة].بايتات) {
        دع البايتات: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < الطول) {
            ألحق(البايتات, (*الذاكرة).المخازن[المعرف.القيمة].البايتات[ف]);
            ف := ف + 1;
        }
        إذا ((*الذاكرة).المخازن[المعرف.القيمة].ثابت) {
            أرجع اختياري.موجود(خصص_مخزن_بايتات_مفسر(الذاكرة, البايتات, خطأ));
        };
        (*الذاكرة).المخازن[المعرف.القيمة].البايتات := البايتات;
        أرجع اختياري.موجود(المعرف);
    };
    دع القيم: متغير متجه قيمة_تشغيل = [];
    دع م: متغير طبيعي = 0;
    طالما (م < الطول) {
        ألحق(القيم, انسخ_قيمة_تشغيل(&(*الذاكرة).المخازن[المعرف.القيمة].القيم[م]));
        م := م + 1;
    }
    إذا ((*الذاكرة).المخازن[المعرف.القيمة].ثابت) {
        دع الحجم: طبيعي = (*الذاكرة).المخازن[المعرف.القيمة].حجم_العنصر;
        أرجع اختياري.موجود(خصص_مخزن_قيم_بحجم_مفسر(الذاكرة, القيم, الحجم));
    };
    (*الذاكرة).المخازن[المعرف.القيمة].القيم := القيم;
    أرجع اختياري.موجود(المعرف);
}

// Frees a live, non-static buffer. A static buffer is never released (the
// native allocator likewise ignores the static bytes of a literal).
عام عرف حرر_مخزن_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): منطقي {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    إذا ((*الذاكرة).المخازن[المعرف.القيمة].ثابت) { أرجع صواب; };
    إذا ((*الذاكرة).المخازن[المعرف.القيمة].السعة > 0) { عد_تخزين_مفسر(الذاكرة, 1, 0); };
    دع بلا_قيم: متجه قيمة_تشغيل = [];
    دع بلا_بايتات: متجه ط8 = [];
    (*الذاكرة).المخازن[المعرف.القيمة].حي := خطأ;
    (*الذاكرة).المخازن[المعرف.القيمة].القيم := بلا_قيم;
    (*الذاكرة).المخازن[المعرف.القيمة].البايتات := بلا_بايتات;
    (*الذاكرة).المخازن[المعرف.القيمة].التالي_الحر := (*الذاكرة).رأس_المخازن_الحرة;
    (*الذاكرة).رأس_المخازن_الحرة := اختياري.موجود(المعرف.القيمة);
    (*الذاكرة).المخازن_الحية := (*الذاكرة).المخازن_الحية - 1;
    أرجع صواب;
}

// Frees a buffer even when it is static: a host region's mirror, when the
// host frees the region.
عام عرف حرر_مخزن_مضيف_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): منطقي {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    (*الذاكرة).المخازن[المعرف.القيمة].ثابت := خطأ;
    // Host memory is not the program's storage: not a free std counts.
    دع التحريرات: طبيعي = (*الذاكرة).عدادات_التخزين[1];
    دع المحرر: منطقي = حرر_مخزن_مفسر(الذاكرة, المعرف);
    (*الذاكرة).عدادات_التخزين[1] := التحريرات;
    أرجع المحرر;
}

// Replaces the elements of a live buffer in place (a host region's mirror
// refreshed from the host): the handle stays valid, the length is kept.
عام عرف استبدل_عناصر_مخزن_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر,
    القيم: متجه قيمة_تشغيل,
    البايتات: متجه ط8,
    بايتات: منطقي
): منطقي {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    (*الذاكرة).المخازن[المعرف.القيمة].القيم := القيم;
    (*الذاكرة).المخازن[المعرف.القيمة].البايتات := البايتات;
    (*الذاكرة).المخازن[المعرف.القيمة].بايتات := بايتات;
    أرجع صواب;
}

// A new host region over a mirror buffer; returns its index.
عام عرف سجل_منطقة_مضيف_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المخزن: معرف_مخزن_مفسر,
    العنوان: ط64,
    عرض_العنصر: طبيعي,
    نوع_السجل: اختياري معرف_نوع,
    قابلة_للكتابة: منطقي,
    اللقطة: متجه ط8
): طبيعي {
    // The mirror stands for host memory, not for storage the program asked
    // std for: its buffer's allocation is not one std counts.
    إذا (هوية_مخزن_مفسر_صالحة(الذاكرة, المخزن) && !(*الذاكرة).المخازن[المخزن.القيمة].ثابت
        && (*الذاكرة).المخازن[المخزن.القيمة].السعة > 0 && (*الذاكرة).عدادات_التخزين[0] > 0) {
        دع البايتات: طبيعي = (*الذاكرة).المخازن[المخزن.القيمة].السعة
            * (*الذاكرة).المخازن[المخزن.القيمة].حجم_العنصر;
        (*الذاكرة).عدادات_التخزين[0] := (*الذاكرة).عدادات_التخزين[0] - 1;
        إذا ((*الذاكرة).عدادات_التخزين[3] >= البايتات) {
            (*الذاكرة).عدادات_التخزين[3] := (*الذاكرة).عدادات_التخزين[3] - البايتات;
        };
    };
    دع التابعة: متجه طبيعي = [];
    دع المنطقة: منطقة_مضيف_مفسر = {
        حية: صواب, المخزن: المخزن, العنوان: العنوان, عرض_العنصر: عرض_العنصر,
        نوع_السجل: نوع_السجل, قابلة_للكتابة: قابلة_للكتابة, اللقطة: اللقطة,
        التابعة: التابعة
    };
    // A dead entry is reused, so a long-running program keeps a bounded table.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).مناطق_المضيف) مثل طبيعي)) {
        إذا (!(*الذاكرة).مناطق_المضيف[ف].حية) {
            (*الذاكرة).مناطق_المضيف[ف] := المنطقة;
            أرجع ف;
        };
        ف := ف + 1;
    }
    ألحق((*الذاكرة).مناطق_المضيف, المنطقة);
    أرجع (الطول((*الذاكرة).مناطق_المضيف) مثل طبيعي) - 1;
}

// The live host region whose mirror is المخزن.
عام عرف منطقة_مضيف_لمخزن_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    المخزن: معرف_مخزن_مفسر
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).مناطق_المضيف) مثل طبيعي)) {
        دع المنطقة: &منطقة_مضيف_مفسر = &(*الذاكرة).مناطق_المضيف[ف];
        إذا ((*المنطقة).حية && (*المنطقة).المخزن.القيمة == المخزن.القيمة
            && (*المنطقة).المخزن.الجيل == المخزن.الجيل) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The live host region that starts at the host address العنوان.
عام عرف منطقة_مضيف_عند_عنوان_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    العنوان: ط64
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).مناطق_المضيف) مثل طبيعي)) {
        إذا ((*الذاكرة).مناطق_المضيف[ف].حية && (*الذاكرة).مناطق_المضيف[ف].العنوان == العنوان) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Frees a host region (the host freed its memory) and the regions reached
// through it: their mirrors are released, so a later use is reported.
عام عرف حرر_منطقة_مضيف_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    الفهرس: طبيعي
): فراغ {
    إذا (الفهرس >= (الطول((*الذاكرة).مناطق_المضيف) مثل طبيعي)) { أرجع; };
    إذا (!(*الذاكرة).مناطق_المضيف[الفهرس].حية) { أرجع; };
    (*الذاكرة).مناطق_المضيف[الفهرس].حية := خطأ;
    دع المخزن: معرف_مخزن_مفسر = (*الذاكرة).مناطق_المضيف[الفهرس].المخزن;
    دع تم: منطقي = حرر_مخزن_مضيف_مفسر(الذاكرة, المخزن);
    دع التابعة: متجه طبيعي = انسخ_متجه_طبيعي_مفسر(&(*الذاكرة).مناطق_المضيف[الفهرس].التابعة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(التابعة) مثل طبيعي)) {
        حرر_منطقة_مضيف_مفسر(الذاكرة, التابعة[ف]);
        ف := ف + 1;
    }
}

عرف انسخ_متجه_طبيعي_مفسر(المصدر: &متجه طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The byte contents of a live byte buffer (a text or u8 vector), copied.
عام عرف بايتات_مخزن_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): اختياري متجه ط8 {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    دع المخزن: &مخزن_مفسر = &(*الذاكرة).المخازن[المعرف.القيمة];
    إذا ((*المخزن).بايتات) {
        أرجع اختياري.موجود(انسخ_بايتات_مخزن_مفسر(&(*المخزن).البايتات));
    };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخزن).القيم) مثل طبيعي)) {
        طابق قيمة_بايت_مفسر(&(*المخزن).القيم[ف]) مع
        | اختياري.موجود(البايت) -> { ألحق(الناتج, البايت); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// The elements of a live buffer as runtime values, copied.
عام عرف قيم_مخزن_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): اختياري متجه قيمة_تشغيل {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    دع المخزن: &مخزن_مفسر = &(*الذاكرة).المخازن[المعرف.القيمة];
    إذا (!(*المخزن).بايتات) {
        أرجع اختياري.موجود(انسخ_مملوكا_متجه_قيمة_تشغيل(&(*المخزن).القيم));
    };
    دع الناتج: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخزن).البايتات) مثل طبيعي)) {
        ألحق(الناتج, قيمة_تشغيل.بتات_عدد((*المخزن).البايتات[ف] مثل طبيعي));
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// A text value transferred to its byte vector, or the reverse, keeps its
// buffer (as the native transfer keeps the pointer). A general-form buffer
// of byte values becomes a byte buffer here.
عام عرف اجعل_مخزن_بايتات_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر
): منطقي {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    إذا ((*الذاكرة).المخازن[المعرف.القيمة].بايتات) { أرجع صواب; };
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الذاكرة).المخازن[المعرف.القيمة].القيم) مثل طبيعي)) {
        طابق قيمة_بايت_مفسر(&(*الذاكرة).المخازن[المعرف.القيمة].القيم[ف]) مع
        | اختياري.موجود(البايت) -> { ألحق(البايتات, البايت); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ف := ف + 1;
    }
    دع بلا_قيم: متجه قيمة_تشغيل = [];
    (*الذاكرة).المخازن[المعرف.القيمة].القيم := بلا_قيم;
    (*الذاكرة).المخازن[المعرف.القيمة].البايتات := البايتات;
    (*الذاكرة).المخازن[المعرف.القيمة].بايتات := صواب;
    أرجع صواب;
}

// ---- Boxes ------------------------------------------------------------------

عام عرف خصص_صندوق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    القيمة: قيمة_تشغيل
): معرف_صندوق_مفسر {
    (*الذاكرة).الصناديق_الحية := (*الذاكرة).الصناديق_الحية + 1;
    عد_تخزين_مفسر(الذاكرة, 0, 8);
    طابق (*الذاكرة).رأس_الصناديق_الحرة مع
    | اختياري.لا_شيء -> {
        دع الموضع: طبيعي = الطول((*الذاكرة).الصناديق) مثل طبيعي;
        دع الخلية: خلية_صندوق_مفسر = {
            حي: صواب, الجيل: 0, القيمة: القيمة, التالي_الحر: اختياري.لا_شيء()
        };
        ألحق((*الذاكرة).الصناديق, الخلية);
        أرجع معرف_صندوق_مفسر_من(الموضع, 0);
    }
    | اختياري.موجود(الموضع) -> {
        دع الجيل: طبيعي = (*الذاكرة).الصناديق[الموضع].الجيل + 1;
        (*الذاكرة).رأس_الصناديق_الحرة := (*الذاكرة).الصناديق[الموضع].التالي_الحر;
        دع الخلية: خلية_صندوق_مفسر = {
            حي: صواب, الجيل: الجيل, القيمة: القيمة, التالي_الحر: اختياري.لا_شيء()
        };
        (*الذاكرة).الصناديق[الموضع] := الخلية;
        أرجع معرف_صندوق_مفسر_من(الموضع, الجيل);
    };
}

عام عرف هوية_صندوق_مفسر_صالحة(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_صندوق_مفسر
): منطقي {
    إذا (المعرف.القيمة >= (الطول((*الذاكرة).الصناديق) مثل طبيعي)) { أرجع خطأ; };
    دع الخلية: &خلية_صندوق_مفسر = &(*الذاكرة).الصناديق[المعرف.القيمة];
    أرجع (*الخلية).حي && (*الخلية).الجيل == المعرف.الجيل;
}

عام عرف حرر_صندوق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_صندوق_مفسر
): منطقي {
    إذا (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    عد_تخزين_مفسر(الذاكرة, 1, 0);
    (*الذاكرة).الصناديق[المعرف.القيمة].حي := خطأ;
    (*الذاكرة).الصناديق[المعرف.القيمة].القيمة := قيمة_تشغيل.مؤشر_فارغ();
    (*الذاكرة).الصناديق[المعرف.القيمة].التالي_الحر := (*الذاكرة).رأس_الصناديق_الحرة;
    (*الذاكرة).رأس_الصناديق_الحرة := اختياري.موجود(المعرف.القيمة);
    (*الذاكرة).الصناديق_الحية := (*الذاكرة).الصناديق_الحية - 1;
    أرجع صواب;
}

// ---- Closure environments ---------------------------------------------------

عام عرف خصص_إغلاق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    الدالة: معرف_دالة_مسير,
    الالتقاطات: متجه قيمة_تشغيل,
    المدمر: اختياري معرف_دالة_مسير
): معرف_إغلاق_مفسر {
    (*الذاكرة).الإغلاقات_الحية := (*الذاكرة).الإغلاقات_الحية + 1;
    // A closure without captures has no environment to allocate.
    إذا ((الطول(الالتقاطات) مثل طبيعي) > 0) { عد_تخزين_مفسر(الذاكرة, 0, 8 * (الطول(الالتقاطات) مثل طبيعي)); };
    طابق (*الذاكرة).رأس_الإغلاقات_الحرة مع
    | اختياري.لا_شيء -> {
        دع الموضع: طبيعي = الطول((*الذاكرة).الإغلاقات) مثل طبيعي;
        دع السجل: سجل_إغلاق_مفسر = {
            حي: صواب, الجيل: 0, الدالة: الدالة, الالتقاطات: الالتقاطات,
            المراجع: 1, المدمر: المدمر, التالي_الحر: اختياري.لا_شيء()
        };
        ألحق((*الذاكرة).الإغلاقات, السجل);
        أرجع معرف_إغلاق_مفسر_من(الموضع, 0);
    }
    | اختياري.موجود(الموضع) -> {
        دع الجيل: طبيعي = (*الذاكرة).الإغلاقات[الموضع].الجيل + 1;
        (*الذاكرة).رأس_الإغلاقات_الحرة := (*الذاكرة).الإغلاقات[الموضع].التالي_الحر;
        دع السجل: سجل_إغلاق_مفسر = {
            حي: صواب, الجيل: الجيل, الدالة: الدالة, الالتقاطات: الالتقاطات,
            المراجع: 1, المدمر: المدمر, التالي_الحر: اختياري.لا_شيء()
        };
        (*الذاكرة).الإغلاقات[الموضع] := السجل;
        أرجع معرف_إغلاق_مفسر_من(الموضع, الجيل);
    };
}

عام عرف هوية_إغلاق_مفسر_صالحة(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر
): منطقي {
    إذا (المعرف.القيمة >= (الطول((*الذاكرة).الإغلاقات) مثل طبيعي)) { أرجع خطأ; };
    دع السجل: &سجل_إغلاق_مفسر = &(*الذاكرة).الإغلاقات[المعرف.القيمة];
    أرجع (*السجل).حي && (*السجل).الجيل == المعرف.الجيل;
}

عام عرف دالة_إغلاق_مفسر_عند(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر
): اختياري معرف_دالة_مسير {
    إذا (!هوية_إغلاق_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الذاكرة).الإغلاقات[المعرف.القيمة].الدالة);
}

عام عرف التقاط_إغلاق_مفسر_عند(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر,
    الفهرس: طبيعي
): اختياري قيمة_تشغيل {
    إذا (!هوية_إغلاق_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    دع السجل: &سجل_إغلاق_مفسر = &(*الذاكرة).الإغلاقات[المعرف.القيمة];
    إذا (الفهرس >= (الطول((*السجل).الالتقاطات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_قيمة_تشغيل(&(*السجل).الالتقاطات[الفهرس]));
}

// One more reference to a live environment.
عام عرف زد_مراجع_إغلاق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر
): منطقي {
    إذا (!هوية_إغلاق_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    (*الذاكرة).الإغلاقات[المعرف.القيمة].المراجع := (*الذاكرة).الإغلاقات[المعرف.القيمة].المراجع + 1;
    أرجع صواب;
}

// One fewer reference: whether none is left (اختياري.لا_شيء for a stale
// handle or a count already at zero).
عام عرف أنقص_مراجع_إغلاق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر
): اختياري منطقي {
    إذا (!هوية_إغلاق_مفسر_صالحة(الذاكرة, المعرف)) { أرجع اختياري.لا_شيء(); };
    دع العدد: طبيعي = (*الذاكرة).الإغلاقات[المعرف.القيمة].المراجع;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    (*الذاكرة).الإغلاقات[المعرف.القيمة].المراجع := العدد - 1;
    أرجع اختياري.موجود(العدد == 1);
}

// The environment with its code pointed at its destructor (the
// closure-destructor primitive): the same handle, now calling the
// destructor, which drops the owned captures it reads.
عام عرف وجه_إغلاق_إلى_مدمره_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر
): منطقي {
    إذا (!هوية_إغلاق_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    طابق (*الذاكرة).الإغلاقات[المعرف.القيمة].المدمر مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المدمر) -> {
        (*الذاكرة).الإغلاقات[المعرف.القيمة].الدالة := المدمر;
        أرجع صواب;
    };
}

عام عرف حرر_إغلاق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر
): منطقي {
    إذا (!هوية_إغلاق_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    إذا ((الطول((*الذاكرة).الإغلاقات[المعرف.القيمة].الالتقاطات) مثل طبيعي) > 0) { عد_تخزين_مفسر(الذاكرة, 1, 0); };
    دع بلا_التقاطات: متجه قيمة_تشغيل = [];
    (*الذاكرة).الإغلاقات[المعرف.القيمة].حي := خطأ;
    (*الذاكرة).الإغلاقات[المعرف.القيمة].الالتقاطات := بلا_التقاطات;
    (*الذاكرة).الإغلاقات[المعرف.القيمة].التالي_الحر := (*الذاكرة).رأس_الإغلاقات_الحرة;
    (*الذاكرة).رأس_الإغلاقات_الحرة := اختياري.موجود(المعرف.القيمة);
    (*الذاكرة).الإغلاقات_الحية := (*الذاكرة).الإغلاقات_الحية - 1;
    أرجع صواب;
}

// ---- Globals ----------------------------------------------------------------

عام عرف هيئ_عام_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_عام_مسير,
    القيمة: قيمة_تشغيل
): منطقي {
    طالما ((الطول((*الذاكرة).العوام) مثل طبيعي) <= (المعرف.القيمة مثل طبيعي)) {
        دع الخلية: خلية_عام_مفسر = { مهيأة: خطأ, القيمة: قيمة_تشغيل.مؤشر_فارغ() };
        ألحق((*الذاكرة).العوام, الخلية);
    }
    إذا ((*الذاكرة).العوام[المعرف.القيمة].مهيأة) { أرجع صواب; };
    (*الذاكرة).العوام[المعرف.القيمة].القيمة := القيمة;
    (*الذاكرة).العوام[المعرف.القيمة].مهيأة := صواب;
    أرجع صواب;
}

عام عرف عام_مفسر_مهيأ(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_عام_مسير
): منطقي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*الذاكرة).العوام) مثل طبيعي)) { أرجع خطأ; };
    أرجع (*الذاكرة).العوام[المعرف.القيمة].مهيأة;
}

// ---- Places -----------------------------------------------------------------

عرف مؤشر_تفعيل_في_المكدس(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    التفعيل: معرف_تفعيل_مفسر
): اختياري طبيعي {
    إذا (عدد_الأطر > (الطول(*الأطر) مثل طبيعي) || عدد_الأطر == 0) { أرجع اختياري.لا_شيء(); };
    // Most accesses are to the active frame.
    إذا ((*الأطر)[عدد_الأطر - 1].التفعيل.القيمة == التفعيل.القيمة) {
        أرجع اختياري.موجود(عدد_الأطر - 1);
    };
    // Activation IDs are issued monotonically and frames are pushed in issue order.
    // Popped frames are outside `عدد_الأطر`, so the live prefix stays strictly ordered.
    دع الأدنى: متغير طبيعي = 0;
    دع الأعلى: متغير طبيعي = عدد_الأطر;
    طالما (الأدنى < الأعلى) {
        دع الوسط: طبيعي = الأدنى + ((الأعلى - الأدنى) / 2);
        دع الحالي: طبيعي = (*الأطر)[الوسط].التفعيل.القيمة;
        إذا (الحالي < التفعيل.القيمة) {
            الأدنى := الوسط + 1;
        } وإلا {
            الأعلى := الوسط;
        };
    }
    إذا (الأدنى < عدد_الأطر) {
        إذا ((*الأطر)[الأدنى].التفعيل.القيمة == التفعيل.القيمة) {
            أرجع اختياري.موجود(الأدنى);
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف فهرس_إسقاط_مفسر(الإسقاط: &إسقاط_مكان_تشغيل): طبيعي {
    طابق *الإسقاط مع
    | إسقاط_مكان_تشغيل.حقل(ف) -> { أرجع ف; }
    | إسقاط_مكان_تشغيل.فهرس(ف) -> { أرجع ف; };
}

// Reads the member a projection path names inside an inline value, copying
// only the leaf.
عرف اقرأ_إسقاطا(
    القيمة: &قيمة_تشغيل,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل,
    الموضع: طبيعي
): نتيجة_قراءة_ذاكرة_مفسر {
    إذا (الموضع >= (الطول(*الإسقاطات) مثل طبيعي)) {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.قيمة(انسخ_قيمة_تشغيل(القيمة));
    };
    دع الفهرس: طبيعي = فهرس_إسقاط_مفسر(&(*الإسقاطات)[الموضع]);
    طابق *القيمة مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        إذا (الفهرس >= (الطول(الأعضاء) مثل طبيعي)) {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس))
            );
        };
        أرجع اقرأ_إسقاطا(&الأعضاء[الفهرس], الإسقاطات, الموضع + 1);
    }
    | _ -> {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس))
        );
    };
}

// Writes الجديدة at a projection path inside an owned value, in place: each
// aggregate on the path is moved out, updated and moved back (no copies).
عرف اكتب_إسقاطا(
    الهدف: &متغير قيمة_تشغيل,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل,
    الموضع: طبيعي,
    الجديدة: قيمة_تشغيل
): اختياري فشل_تفسير_مسير {
    إذا (الموضع >= (الطول(*الإسقاطات) مثل طبيعي)) {
        (*الهدف) := الجديدة;
        أرجع اختياري.لا_شيء();
    };
    دع الفهرس: طبيعي = فهرس_إسقاط_مفسر(&(*الإسقاطات)[الموضع]);
    دع صالح: متغير منطقي = خطأ;
    طابق *الهدف مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        صالح := الفهرس < (الطول(الأعضاء) مثل طبيعي);
    }
    | _ -> { };
    إذا (!صالح) {
        أرجع اختياري.موجود(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس))
        );
    };
    دع المأخوذة: متغير قيمة_تشغيل = قيمة_تشغيل.مؤشر_فارغ();
    بدّل((*الهدف), المأخوذة);
    طابق المأخوذة مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        دع المملوكة: متغير متجه قيمة_تشغيل = الأعضاء;
        دع الناتج: اختياري فشل_تفسير_مسير = اكتب_إسقاطا(
            &متغير المملوكة[الفهرس], الإسقاطات, الموضع + 1, الجديدة
        );
        (*الهدف) := قيمة_تشغيل.تجميع(المملوكة);
        أرجع الناتج;
    }
    | _ -> { };
    أرجع اختياري.موجود(فشل_ذاكرة_تالفة_مفسر());
}

// A root can exist while its local cell is still uninitialized (and may be
// initialized by a later store). Only the empty projection of such a root is
// valid. All other references must name an existing member at every level.
عرف إسقاطات_مكان_مفسر_صالحة(
    القيمة: &قيمة_تشغيل,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل,
    الموضع: طبيعي
): منطقي {
    إذا (الموضع >= (الطول(*الإسقاطات) مثل طبيعي)) { أرجع صواب; };
    دع الفهرس: طبيعي = فهرس_إسقاط_مفسر(&(*الإسقاطات)[الموضع]);
    طابق *القيمة مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        إذا (الفهرس >= (الطول(الأعضاء) مثل طبيعي)) { أرجع خطأ; };
        أرجع إسقاطات_مكان_مفسر_صالحة(&الأعضاء[الفهرس], الإسقاطات, الموضع + 1);
    }
    | _ -> { أرجع خطأ; };
}

// A buffer place is element الفهرس of the buffer followed by an inline path.
عرف مكان_مخزن_مفسر_صالح(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل
): منطقي {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
    إذا ((الطول(*الإسقاطات) مثل طبيعي) == 0) { أرجع صواب; };
    دع الفهرس: طبيعي = فهرس_إسقاط_مفسر(&(*الإسقاطات)[0]);
    دع المخزن: &مخزن_مفسر = &(*الذاكرة).المخازن[المعرف.القيمة];
    // Element 0 of an empty buffer names its start: drop glue releases an
    // emptied vector's buffer through it. Reading or writing it still fails.
    إذا (الفهرس == 0 && (الطول(*الإسقاطات) مثل طبيعي) == 1) {
        دع العدد: متغير طبيعي = الطول((*المخزن).القيم) مثل طبيعي;
        إذا ((*المخزن).بايتات) { العدد := الطول((*المخزن).البايتات) مثل طبيعي; };
        إذا (العدد == 0) { أرجع صواب; };
    };
    إذا ((*المخزن).بايتات) {
        أرجع الفهرس < (الطول((*المخزن).البايتات) مثل طبيعي)
            && (الطول(*الإسقاطات) مثل طبيعي) == 1;
    };
    إذا (الفهرس >= (الطول((*المخزن).القيم) مثل طبيعي)) { أرجع خطأ; };
    أرجع إسقاطات_مكان_مفسر_صالحة(&(*المخزن).القيم[الفهرس], الإسقاطات, 1);
}

عام عرف هوية_مكان_مفسر_صالحة(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &ذاكرة_مفسر,
    المكان: &مكان_تشغيل
): منطقي {
    طابق (*المكان).الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
        | اختياري.لا_شيء -> {
            طابق إطار_معلق_للتفعيل(الذاكرة, التفعيل) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(م) -> {
                أرجع خلية_إطار_صالحة_مفسر(
                    &(*الذاكرة).سياقات_المهام[م.السياق].المكدس[م.الإطار], الخلية.القيمة, &(*المكان).الإسقاطات
                );
            };
        }
        | اختياري.موجود(فهرس_الإطار) -> {
            أرجع خلية_إطار_صالحة_مفسر(&(*الأطر)[فهرس_الإطار], الخلية.القيمة, &(*المكان).الإسقاطات);
        };
    }
    | جذر_مكان_تشغيل.عام(المعرف) -> {
        إذا (!عام_مفسر_مهيأ(الذاكرة, المعرف)) { أرجع خطأ; };
        أرجع إسقاطات_مكان_مفسر_صالحة(
            &(*الذاكرة).العوام[المعرف.القيمة].القيمة, &(*المكان).الإسقاطات, 0
        );
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        إذا (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
        أرجع إسقاطات_مكان_مفسر_صالحة(
            &(*الذاكرة).الصناديق[المعرف.القيمة].القيمة, &(*المكان).الإسقاطات, 0
        );
    }
    | جذر_مكان_تشغيل.مخزن(المعرف) -> {
        أرجع مكان_مخزن_مفسر_صالح(الذاكرة, المعرف, &(*المكان).الإسقاطات);
    };
}

عرف اقرأ_مكان_مخزن_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_مخزن_مفسر,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل
): نتيجة_قراءة_ذاكرة_مفسر {
    إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)
        || (الطول(*الإسقاطات) مثل طبيعي) == 0) {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة))
        );
    };
    دع الفهرس: طبيعي = فهرس_إسقاط_مفسر(&(*الإسقاطات)[0]);
    دع المخزن: &مخزن_مفسر = &(*الذاكرة).المخازن[المعرف.القيمة];
    إذا ((*المخزن).بايتات) {
        إذا (الفهرس >= (الطول((*المخزن).البايتات) مثل طبيعي)
            || (الطول(*الإسقاطات) مثل طبيعي) != 1) {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس))
            );
        };
        أرجع نتيجة_قراءة_ذاكرة_مفسر.قيمة(
            قيمة_تشغيل.بتات_عدد((*المخزن).البايتات[الفهرس] مثل طبيعي)
        );
    };
    إذا (الفهرس >= (الطول((*المخزن).القيم) مثل طبيعي)) {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس))
        );
    };
    أرجع اقرأ_إسقاطا(&(*المخزن).القيم[الفهرس], الإسقاطات, 1);
}

عام عرف اقرأ_مكان_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &ذاكرة_مفسر,
    المكان: &مكان_تشغيل
): نتيجة_قراءة_ذاكرة_مفسر {
    طابق (*المكان).الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
        | اختياري.لا_شيء -> {
            طابق إطار_معلق_للتفعيل(الذاكرة, التفعيل) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(فشل_ذاكرة_تالفة_مفسر()); }
            | اختياري.موجود(م) -> {
                أرجع اقرأ_خلية_إطار_مفسر(
                    &(*الذاكرة).سياقات_المهام[م.السياق].المكدس[م.الإطار], الخلية.القيمة, &(*المكان).الإسقاطات
                );
            };
        }
        | اختياري.موجود(فهرس_الإطار) -> {
            أرجع اقرأ_خلية_إطار_مفسر(&(*الأطر)[فهرس_الإطار], الخلية.القيمة, &(*المكان).الإسقاطات);
        };
    }
    | جذر_مكان_تشغيل.عام(المعرف) -> {
        إذا (!عام_مفسر_مهيأ(الذاكرة, المعرف)) {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(فشل_ذاكرة_تالفة_مفسر());
        };
        أرجع اقرأ_إسقاطا(&(*الذاكرة).العوام[المعرف.القيمة].القيمة, &(*المكان).الإسقاطات, 0);
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        إذا (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة))
            );
        };
        أرجع اقرأ_إسقاطا(&(*الذاكرة).الصناديق[المعرف.القيمة].القيمة, &(*المكان).الإسقاطات, 0);
    }
    | جذر_مكان_تشغيل.مخزن(المعرف) -> {
        أرجع اقرأ_مكان_مخزن_مفسر(الذاكرة, المعرف, &(*المكان).الإسقاطات);
    };
}

عرف نتيجة_كتابة_من_فشل(الفشل: اختياري فشل_تفسير_مسير): نتيجة_كتابة_ذاكرة_مفسر {
    طابق الفشل مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ); }
    | اختياري.لا_شيء -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت(); };
}

عام عرف اكتب_مكان_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &متغير ذاكرة_مفسر,
    المكان: &مكان_تشغيل,
    القيمة: قيمة_تشغيل
): نتيجة_كتابة_ذاكرة_مفسر {
    إذا (!(*المكان).قابل_للكتابة) {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط())
        );
    };
    طابق (*المكان).الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
        | اختياري.لا_شيء -> {
            طابق إطار_معلق_للتفعيل(الذاكرة, التفعيل) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_ذاكرة_تالفة_مفسر()); }
            | اختياري.موجود(م) -> {
                أرجع اكتب_خلية_إطار_مفسر(
                    &متغير (*الذاكرة).سياقات_المهام[م.السياق].المكدس[م.الإطار], الخلية.القيمة,
                    &(*المكان).الإسقاطات, القيمة
                );
            };
        }
        | اختياري.موجود(فهرس_الإطار) -> {
            أرجع اكتب_خلية_إطار_مفسر(&متغير (*الأطر)[فهرس_الإطار], الخلية.القيمة, &(*المكان).الإسقاطات, القيمة);
        };
    }
    | جذر_مكان_تشغيل.عام(المعرف) -> {
        إذا (!عام_مفسر_مهيأ(الذاكرة, المعرف)) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_ذاكرة_تالفة_مفسر());
        };
        أرجع نتيجة_كتابة_من_فشل(اكتب_إسقاطا(
            &متغير (*الذاكرة).العوام[المعرف.القيمة].القيمة,
            &(*المكان).الإسقاطات, 0, القيمة
        ));
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        إذا (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة))
            );
        };
        أرجع نتيجة_كتابة_من_فشل(اكتب_إسقاطا(
            &متغير (*الذاكرة).الصناديق[المعرف.القيمة].القيمة,
            &(*المكان).الإسقاطات, 0, القيمة
        ));
    }
    | جذر_مكان_تشغيل.مخزن(المعرف) -> {
        إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)
            || (الطول((*المكان).الإسقاطات) مثل طبيعي) == 0) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة))
            );
        };
        // The bytes of a literal are read-only, as in a native executable.
        إذا ((*الذاكرة).المخازن[المعرف.القيمة].ثابت) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط())
            );
        };
        دع الفهرس: طبيعي = فهرس_إسقاط_مفسر(&(*المكان).الإسقاطات[0]);
        إذا ((*الذاكرة).المخازن[المعرف.القيمة].بايتات) {
            إذا ((الطول((*المكان).الإسقاطات) مثل طبيعي) == 1
                && الفهرس < (الطول((*الذاكرة).المخازن[المعرف.القيمة].البايتات) مثل طبيعي)) {
                طابق قيمة_بايت_مفسر(&القيمة) مع
                | اختياري.موجود(البايت) -> {
                    (*الذاكرة).المخازن[المعرف.القيمة].البايتات[الفهرس] := البايت;
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
                }
                | اختياري.لا_شيء -> {
                    حول_مخزن_إلى_قيم_مفسر(&متغير (*الذاكرة).المخازن[المعرف.القيمة]);
                };
            } وإلا {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس))
                );
            };
        };
        إذا (الفهرس >= (الطول((*الذاكرة).المخازن[المعرف.القيمة].القيم) مثل طبيعي)) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس))
            );
        };
        أرجع نتيجة_كتابة_من_فشل(اكتب_إسقاطا(
            &متغير (*الذاكرة).المخازن[المعرف.القيمة].القيم[الفهرس],
            &(*المكان).الإسقاطات, 1, القيمة
        ));
    };
}

// The projection vector a stale slot holds (a place, or a reference value),
// given up for reuse; an empty vector otherwise.
عام عرف إسقاطات_خانة_للإعادة(القديمة: خانة_تنفيذ_مسير): متجه إسقاط_مكان_تشغيل {
    طابق القديمة مع
    | خانة_تنفيذ_مسير.مكان({ الجذر: _, الإسقاطات: الإسقاطات, قابل_للكتابة: _ }) -> {
        أرجع الإسقاطات;
    }
    | خانة_تنفيذ_مسير.قيمة(قيمة_تشغيل.مرجع({ الجذر: _, الإسقاطات: الإسقاطات, قابل_للكتابة: _ })) -> {
        أرجع الإسقاطات;
    }
    | _ -> {
        دع الفارغة: متجه إسقاط_مكان_تشغيل = [];
        أرجع الفارغة;
    };
}

// A copy of المصدر whose projections are written into المعادة (reused when
// it has the same length), writable only when المصدر is and كتابة allows it.
عام عرف مكان_منسوخ_في(
    المصدر: &مكان_تشغيل,
    المعادة: متجه إسقاط_مكان_تشغيل,
    كتابة: منطقي
): مكان_تشغيل {
    دع العدد: طبيعي = الطول((*المصدر).الإسقاطات) مثل طبيعي;
    دع الإسقاطات: متغير متجه إسقاط_مكان_تشغيل = المعادة;
    إذا ((الطول(الإسقاطات) مثل طبيعي) == العدد) {
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            الإسقاطات[ف] := (*المصدر).الإسقاطات[ف];
            ف := ف + 1;
        }
    } وإلا {
        دع الجديدة: متغير متجه إسقاط_مكان_تشغيل = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            ألحق(الجديدة, (*المصدر).الإسقاطات[ف]);
            ف := ف + 1;
        }
        الإسقاطات := الجديدة;
    };
    دع الناتج: مكان_تشغيل = {
        الجذر: (*المصدر).الجذر,
        الإسقاطات: الإسقاطات,
        قابل_للكتابة: (*المصدر).قابل_للكتابة && كتابة
    };
    أرجع الناتج;
}

// The handle a place holds when it holds a vector, slice or text value.
عام عرف مخزن_عند_مكان_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &ذاكرة_مفسر,
    المكان: &مكان_تشغيل
): اختياري معرف_مخزن_مفسر {
    طابق اقرأ_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, المكان) مع
    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(قيمة_تشغيل.مخزن(المعرف)) -> { أرجع اختياري.موجود(المعرف); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The storage a release primitive's argument names: a box, a closure
// environment, or (through a reference to its first element) a buffer.
// Anything else names no heap block and is ignored, as the native allocator
// ignores addresses outside its heap. A stale handle is a double release.
عام عرف حرر_تخزين_قيمة_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    القيمة: &قيمة_تشغيل
): اختياري فشل_تفسير_مسير {
    طابق *القيمة مع
    | قيمة_تشغيل.صندوق(المعرف) -> {
        إذا (!حرر_صندوق_مفسر(الذاكرة, المعرف)) {
            أرجع اختياري.موجود(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة))
            );
        };
    }
    | قيمة_تشغيل.إغلاق(المعرف) -> {
        إذا (!حرر_إغلاق_مفسر(الذاكرة, المعرف)) {
            أرجع اختياري.موجود(فشل_ذاكرة_تالفة_مفسر());
        };
    }
    | قيمة_تشغيل.مخزن(المعرف) -> {
        إذا (!حرر_مخزن_مفسر(الذاكرة, المعرف)) {
            أرجع اختياري.موجود(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة))
            );
        };
    }
    | قيمة_تشغيل.مرجع(المكان) -> {
        طابق المكان.الجذر مع
        | جذر_مكان_تشغيل.مخزن(المعرف) -> {
            دع عند_البداية: متغير منطقي = (الطول(المكان.الإسقاطات) مثل طبيعي) == 0;
            إذا ((الطول(المكان.الإسقاطات) مثل طبيعي) == 1) {
                عند_البداية := فهرس_إسقاط_مفسر(&المكان.الإسقاطات[0]) == 0;
            };
            إذا (عند_البداية && !حرر_مخزن_مفسر(الذاكرة, المعرف)) {
                أرجع اختياري.موجود(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة))
                );
            };
        }
        | جذر_مكان_تشغيل.صندوق(المعرف) -> {
            إذا ((الطول(المكان.الإسقاطات) مثل طبيعي) == 0 && !حرر_صندوق_مفسر(الذاكرة, المعرف)) {
                أرجع اختياري.موجود(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة))
                );
            };
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// The Type of an MSIR value, read in place (the verified program's dense
// per-function value table).
عام عرف نوع_قيمة_مفسر(
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري معرف_نوع {
    دع الدوال: &متجه دالة_مسير = &(*المسير).المسير.الدوال;
    إذا ((المعرف.الدالة.القيمة مثل طبيعي) >= (الطول(*الدوال) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع القيم: &متجه قيمة_مسير = &(*الدوال)[المعرف.الدالة.القيمة].القيم;
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(*القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع النوع: &معرف_نوع = &(*القيم)[المعرف.القيمة].النوع;
    أرجع اختياري.موجود(*النوع);
}

// ---- Byte views for the host bridges ----------------------------------------

// The flat bytes behind a pointer, for the raw kernel and foreign-call
// bridges: elements of a buffer from an index on, each of a fixed width (u8
// vectors and text are bytes; wider integer vectors are little-endian
// elements), or one integer scalar. Other storage has no byte layout here.
عام نوع امتداد_بايتات_مفسر =
    | مخزن بنوع (معرف_مخزن_مفسر, طبيعي, طبيعي)
    | عدد بنوع (مكان_تشغيل, طبيعي)
    | غير_صالح
;

// The width in bytes of an integer Type, or 0.
عام عرف عرض_صحيح_نوع_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): طبيعي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (البدائي == نوع_بدائي_مقنن.ط8() || البدائي == نوع_بدائي_مقنن.ص8()) { أرجع 1; };
            إذا (البدائي == نوع_بدائي_مقنن.ط16() || البدائي == نوع_بدائي_مقنن.ص16()) { أرجع 2; };
            إذا (البدائي == نوع_بدائي_مقنن.ط32() || البدائي == نوع_بدائي_مقنن.ص32()) { أرجع 4; };
            إذا (البدائي == نوع_بدائي_مقنن.ط64() || البدائي == نوع_بدائي_مقنن.ص64()
                || البدائي == نوع_بدائي_مقنن.عدد() || البدائي == نوع_بدائي_مقنن.طبيعي()) {
                أرجع 8;
            };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع 0;
}

عام عرف نوع_نص_مفسر(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.نص(); }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The byte view of the storage المكان designates, where النوع is the Type
// the pointer points to.
عام عرف امتداد_بايتات_مكان_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المكان: &مكان_تشغيل,
    النوع: معرف_نوع
): امتداد_بايتات_مفسر {
    إذا (!هوية_مكان_مفسر_صالحة(الأطر, عدد_الأطر, الذاكرة, المكان)) {
        أرجع امتداد_بايتات_مفسر.غير_صالح();
    };
    دع العرض: طبيعي = عرض_صحيح_نوع_مفسر(الأنواع, النوع);
    // A pointer to a whole vector or text: its elements from the first.
    إذا (العرض == 0) {
        دع عرض_العنصر: متغير طبيعي = 0;
        إذا (نوع_نص_مفسر(الأنواع, النوع)) {
            عرض_العنصر := 1;
        } وإلا {
            طابق نوع_عنصر_تسلسل_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(العنصر) -> { عرض_العنصر := عرض_صحيح_نوع_مفسر(الأنواع, العنصر); }
            | اختياري.لا_شيء -> { };
        };
        إذا (عرض_العنصر == 0) { أرجع امتداد_بايتات_مفسر.غير_صالح(); };
        طابق مخزن_عند_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, المكان) مع
        | اختياري.موجود(المعرف) -> { أرجع امتداد_بايتات_مفسر.مخزن(المعرف, 0, عرض_العنصر); }
        | اختياري.لا_شيء -> { أرجع امتداد_بايتات_مفسر.غير_صالح(); };
    };
    // An element of a buffer: the buffer from that element on.
    طابق (*المكان).الجذر مع
    | جذر_مكان_تشغيل.مخزن(المعرف) -> {
        إذا ((الطول((*المكان).الإسقاطات) مثل طبيعي) == 1) {
            دع الفهرس: طبيعي = فهرس_إسقاط_مفسر(&(*المكان).الإسقاطات[0]);
            أرجع امتداد_بايتات_مفسر.مخزن(المعرف, الفهرس, العرض);
        };
    }
    | _ -> { };
    طابق اقرأ_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, المكان) مع
    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(قيمة_تشغيل.بتات_عدد(_)) -> {
        أرجع امتداد_بايتات_مفسر.عدد(انسخ_مكان_تشغيل(المكان), العرض);
    }
    | _ -> { أرجع امتداد_بايتات_مفسر.غير_صالح(); };
}

// The number of bytes a view makes available.
عام عرف طول_امتداد_بايتات_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    الامتداد: &امتداد_بايتات_مفسر
): طبيعي {
    طابق *الامتداد مع
    | امتداد_بايتات_مفسر.مخزن(المعرف, البداية, العرض) -> {
        طابق طول_مخزن_مفسر(الذاكرة, المعرف) مع
        | اختياري.موجود(الطول_الكلي) -> {
            إذا (البداية >= الطول_الكلي) { أرجع 0; };
            أرجع (الطول_الكلي - البداية) * العرض;
        }
        | اختياري.لا_شيء -> { أرجع 0; };
    }
    | امتداد_بايتات_مفسر.عدد(_, العرض) -> { أرجع العرض; }
    | امتداد_بايتات_مفسر.غير_صالح -> { أرجع 0; };
}

عام نوع نتيجة_نسخ_بايتات_مفسر =
    | بايتات بنوع متجه ط8
    | أخفق بنوع فشل_تفسير_مسير
;

عرف فشل_نطاق_بايتات_مفسر(): فشل_تفسير_مسير {
    أرجع فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف());
}

// Subtraction-based check: neither start + length nor the endpoint can wrap.
عرف نطاق_بايتات_مفسر_صالح(
    الطول_الكلي: طبيعي,
    البداية: طبيعي,
    المطلوب: طبيعي
): منطقي {
    أرجع البداية <= الطول_الكلي && المطلوب <= الطول_الكلي - البداية;
}

// Bytes [البداية, البداية + المطلوب) of a view.
عام عرف اقرأ_بايتات_امتداد_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &ذاكرة_مفسر,
    الامتداد: &امتداد_بايتات_مفسر,
    البداية: طبيعي,
    المطلوب: طبيعي
): نتيجة_نسخ_بايتات_مفسر {
    إذا (!نطاق_بايتات_مفسر_صالح(طول_امتداد_بايتات_مفسر(الذاكرة, الامتداد), البداية, المطلوب)) {
        أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    };
    دع الناتج: متغير متجه ط8 = [];
    طابق *الامتداد مع
    | امتداد_بايتات_مفسر.مخزن(المعرف, الأول, العرض) -> {
        إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) {
            أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
        };
        دع المخزن: &مخزن_مفسر = &(*الذاكرة).المخازن[المعرف.القيمة];
        دع ف: متغير طبيعي = 0;
        إذا ((*المخزن).بايتات && العرض == 1) {
            طالما (ف < المطلوب) {
                ألحق(الناتج, (*المخزن).البايتات[الأول + البداية + ف]);
                ف := ف + 1;
            }
            أرجع نتيجة_نسخ_بايتات_مفسر.بايتات(الناتج);
        };
        طالما (ف < المطلوب) {
            دع موضع_البايت: طبيعي = البداية + ف;
            دع العنصر: طبيعي = الأول + موضع_البايت / العرض;
            دع البتات: متغير طبيعي = 0;
            إذا ((*المخزن).بايتات) {
                البتات := (*المخزن).البايتات[العنصر] مثل طبيعي;
            } وإلا {
                طابق (*المخزن).القيم[العنصر] مع
                | قيمة_تشغيل.بتات_عدد(القيمة) -> { البتات := القيمة; }
                | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
            };
            ألحق(الناتج, ((البتات >> ((موضع_البايت % العرض) * 8)) & 255) مثل ط8);
            ف := ف + 1;
        }
        أرجع نتيجة_نسخ_بايتات_مفسر.بايتات(الناتج);
    }
    | امتداد_بايتات_مفسر.عدد(المكان, العرض) -> {
        طابق اقرأ_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, &المكان) مع
        | نتيجة_قراءة_ذاكرة_مفسر.قيمة(قيمة_تشغيل.بتات_عدد(البتات)) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < المطلوب) {
                ألحق(الناتج, ((البتات >> ((البداية + ف) * 8)) & 255) مثل ط8);
                ف := ف + 1;
            }
            أرجع نتيجة_نسخ_بايتات_مفسر.بايتات(الناتج);
        }
        | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
    }
    | امتداد_بايتات_مفسر.غير_صالح -> {
        أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    };
}

// Whether a view may be written: not a literal's bytes.
عام عرف امتداد_بايتات_قابل_للكتابة_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    الامتداد: &امتداد_بايتات_مفسر
): منطقي {
    طابق *الامتداد مع
    | امتداد_بايتات_مفسر.مخزن(المعرف, _, _) -> { أرجع !مخزن_مفسر_ثابت(الذاكرة, المعرف); }
    | امتداد_بايتات_مفسر.عدد(المكان, _) -> { أرجع المكان.قابل_للكتابة; }
    | امتداد_بايتات_مفسر.غير_صالح -> { أرجع خطأ; };
}

// Writes البايتات at byte البداية of a view, in place.
عام عرف اكتب_بايتات_امتداد_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &متغير ذاكرة_مفسر,
    الامتداد: &امتداد_بايتات_مفسر,
    البداية: طبيعي,
    البايتات: &متجه ط8
): نتيجة_كتابة_ذاكرة_مفسر {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (!نطاق_بايتات_مفسر_صالح(طول_امتداد_بايتات_مفسر(الذاكرة, الامتداد), البداية, العدد)
        || !امتداد_بايتات_قابل_للكتابة_مفسر(الذاكرة, الامتداد)) {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    };
    إذا (العدد == 0) { أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت(); };
    طابق *الامتداد مع
    | امتداد_بايتات_مفسر.مخزن(المعرف, الأول, العرض) -> {
        إذا (!هوية_مخزن_مفسر_صالحة(الذاكرة, المعرف)) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
        };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            دع موضع_البايت: طبيعي = البداية + ف;
            دع العنصر: طبيعي = الأول + موضع_البايت / العرض;
            دع البايت: ط8 = (*البايتات)[ف];
            إذا ((*الذاكرة).المخازن[المعرف.القيمة].بايتات) {
                (*الذاكرة).المخازن[المعرف.القيمة].البايتات[العنصر] := البايت;
            } وإلا {
                دع القديم: متغير طبيعي = 0;
                طابق (*الذاكرة).المخازن[المعرف.القيمة].القيم[العنصر] مع
                | قيمة_تشغيل.بتات_عدد(القيمة) -> { القديم := القيمة; }
                | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                دع الإزاحة: طبيعي = (موضع_البايت % العرض) * 8;
                دع القناع: طبيعي = (255 مثل طبيعي) << الإزاحة;
                دع الجديد: طبيعي = (القديم & (~القناع)) | ((البايت مثل طبيعي) << الإزاحة);
                (*الذاكرة).المخازن[المعرف.القيمة].القيم[العنصر] := قيمة_تشغيل.بتات_عدد(الجديد);
            };
            ف := ف + 1;
        }
        أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
    }
    | امتداد_بايتات_مفسر.عدد(المكان, العرض) -> {
        طابق اقرأ_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, &المكان) مع
        | نتيجة_قراءة_ذاكرة_مفسر.قيمة(قيمة_تشغيل.بتات_عدد(البتات)) -> {
            دع الجديد: متغير طبيعي = البتات;
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                دع الإزاحة: طبيعي = (البداية + ف) * 8;
                دع القناع: طبيعي = (255 مثل طبيعي) << الإزاحة;
                الجديد := (الجديد & (~القناع)) | (((*البايتات)[ف] مثل طبيعي) << الإزاحة);
                ف := ف + 1;
            }
            أرجع اكتب_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, &المكان, قيمة_تشغيل.بتات_عدد(الجديد));
        }
        | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
    }
    | امتداد_بايتات_مفسر.غير_صالح -> {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    };
}

// ---- Pointer views by MSIR value (the authenticated kernel-call path) -------

// The pointee Type of a pointer-typed MSIR value.
عرف نوع_داخل_مؤشر_مفسر(
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري معرف_نوع {
    طابق نوع_قيمة_مفسر(المسير, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النوع) -> { أرجع نوع_داخل_مؤشر_بنوع_مفسر(الأنواع, النوع); };
}

// The pointee Type of a pointer or reference Type.
عام عرف نوع_داخل_مؤشر_بنوع_مفسر(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(الداخل) -> { أرجع اختياري.موجود(الداخل); }
        | _ -> { };
    };
    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(الداخل); }
    | اختياري.لا_شيء -> { };
    أرجع نوع_داخل_مرجع_دلالي(الأنواع, النوع);
}

عرف امتداد_مؤشر_مسير_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل
): امتداد_بايتات_مفسر {
    دع الداخل: معرف_نوع;
    طابق نوع_داخل_مؤشر_مفسر(الأنواع, المسير, المعرف) مع
    | اختياري.لا_شيء -> { أرجع امتداد_بايتات_مفسر.غير_صالح(); }
    | اختياري.موجود(النوع) -> { الداخل := النوع; };
    طابق *المؤشر مع
    | قيمة_تشغيل.مرجع(المكان) -> {
        أرجع امتداد_بايتات_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, الأنواع, &المكان, الداخل);
    }
    | _ -> { أرجع امتداد_بايتات_مفسر.غير_صالح(); };
}

// Output permission is checked before any host operation.
عام عرف مؤشر_بايتات_مفسر_قابل_للكتابة(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل
): منطقي {
    طابق *المؤشر مع
    | قيمة_تشغيل.مرجع(المكان) -> { إذا (!المكان.قابل_للكتابة) { أرجع خطأ; }; }
    | _ -> { أرجع خطأ; };
    دع الامتداد: امتداد_بايتات_مفسر = امتداد_مؤشر_مسير_مفسر(
        الأطر, عدد_الأطر, الذاكرة, الأنواع, المسير, المعرف, المؤشر
    );
    أرجع امتداد_بايتات_قابل_للكتابة_مفسر(الذاكرة, &الامتداد);
}

// A normalized span identifies the live storage containing its bytes, so
// pointers to different elements of one buffer can be compared.
عام نوع نطاق_تخزين_بايتات_مفسر = {
    الأصل: مكان_تشغيل,
    البداية: طبيعي,
    المطلوب: طبيعي
};

عام نوع نتيجة_هوية_نطاق_بايتات_مفسر =
    | موجود بنوع نطاق_تخزين_بايتات_مفسر
    | غير_صالح
;

عام عرف هوية_امتداد_بايتات_مفسر(
    الامتداد: &امتداد_بايتات_مفسر,
    المطلوب: طبيعي
): نتيجة_هوية_نطاق_بايتات_مفسر {
    طابق *الامتداد مع
    | امتداد_بايتات_مفسر.مخزن(المعرف, الأول, العرض) -> {
        دع بلا_إسقاطات: متجه إسقاط_مكان_تشغيل = [];
        دع الأصل: مكان_تشغيل = {
            الجذر: جذر_مكان_تشغيل.مخزن(المعرف), الإسقاطات: بلا_إسقاطات, قابل_للكتابة: صواب
        };
        إذا (العرض == 0 || الأول > (~(0 مثل طبيعي)) / العرض) {
            أرجع نتيجة_هوية_نطاق_بايتات_مفسر.غير_صالح();
        };
        دع النطاق: نطاق_تخزين_بايتات_مفسر = { الأصل: الأصل, البداية: الأول * العرض, المطلوب: المطلوب };
        أرجع نتيجة_هوية_نطاق_بايتات_مفسر.موجود(النطاق);
    }
    | امتداد_بايتات_مفسر.عدد(المكان, _) -> {
        دع النطاق: نطاق_تخزين_بايتات_مفسر = {
            الأصل: انسخ_مكان_تشغيل(&المكان), البداية: 0, المطلوب: المطلوب
        };
        أرجع نتيجة_هوية_نطاق_بايتات_مفسر.موجود(النطاق);
    }
    | امتداد_بايتات_مفسر.غير_صالح -> { أرجع نتيجة_هوية_نطاق_بايتات_مفسر.غير_صالح(); };
}

عام عرف حل_هوية_نطاق_بايتات_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل,
    المطلوب: طبيعي
): نتيجة_هوية_نطاق_بايتات_مفسر {
    دع الامتداد: امتداد_بايتات_مفسر = امتداد_مؤشر_مسير_مفسر(
        الأطر, عدد_الأطر, الذاكرة, الأنواع, المسير, المعرف, المؤشر
    );
    أرجع هوية_امتداد_بايتات_مفسر(&الامتداد, المطلوب);
}

// Half-open ranges permit adjacent buffers. Reject ANY nonempty overlap.
عام عرف نطاقا_تخزين_بايتات_متداخلان(
    الأول: &نطاق_تخزين_بايتات_مفسر,
    الثاني: &نطاق_تخزين_بايتات_مفسر
): منطقي {
    إذا ((*الأول).المطلوب == 0 || (*الثاني).المطلوب == 0
        || !مكانا_تخزين_متطابقان(&(*الأول).الأصل, &(*الثاني).الأصل)) {
        أرجع خطأ;
    };
    أرجع (*الأول).البداية < (*الثاني).البداية + (*الثاني).المطلوب
        && (*الثاني).البداية < (*الأول).البداية + (*الأول).المطلوب;
}

عام عرف انسخ_نطاق_بايتات_من_مؤشر_مسير_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل,
    البداية: طبيعي,
    المطلوب: طبيعي
): نتيجة_نسخ_بايتات_مفسر {
    دع الامتداد: امتداد_بايتات_مفسر = امتداد_مؤشر_مسير_مفسر(
        الأطر, عدد_الأطر, الذاكرة, الأنواع, المسير, المعرف, المؤشر
    );
    أرجع اقرأ_بايتات_امتداد_مفسر(الأطر, عدد_الأطر, الذاكرة, &الامتداد, البداية, المطلوب);
}

عام عرف انسخ_نطاق_بايتات_إلى_مؤشر_مسير_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: طبيعي,
    الذاكرة: &متغير ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل,
    البداية: طبيعي,
    البايتات: &متجه ط8
): نتيجة_كتابة_ذاكرة_مفسر {
    طابق *المؤشر مع
    | قيمة_تشغيل.مرجع(المكان) -> {
        إذا (!المكان.قابل_للكتابة) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
        };
    }
    | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
    دع الامتداد: امتداد_بايتات_مفسر = امتداد_مؤشر_مسير_مفسر(
        الأطر, عدد_الأطر, الذاكرة, الأنواع, المسير, المعرف, المؤشر
    );
    أرجع اكتب_بايتات_امتداد_مفسر(الأطر, عدد_الأطر, الذاكرة, &الامتداد, البداية, البايتات);
}
