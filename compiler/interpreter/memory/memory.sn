استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.runtime_failures;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_consumer;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_registry;

عام نوع سجل_إغلاق_مفسر = {
    الدالة: معرف_دالة_مسير,
    بداية_الالتقاطات: غير_موقع,
    عدد_الالتقاطات: غير_موقع
};

عام نوع ذاكرة_مفسر = {
    الصناديق: متجه اختيار قيمة_تشغيل,
    أجيال_الصناديق: متجه غير_موقع,
    تالي_الصندوق_الحر: متجه اختيار غير_موقع,
    رأس_الصناديق_الحرة: اختيار غير_موقع,
    العوام: متجه اختيار قيمة_تشغيل,
    الإغلاقات: متجه سجل_إغلاق_مفسر,
    التقاطات_الإغلاقات: متجه قيمة_تشغيل
};

عام نوع نتيجة_قراءة_ذاكرة_مفسر =
    | قيمة بنوع قيمة_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;

عام نوع نتيجة_كتابة_ذاكرة_مفسر =
    | نجحت
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف ذاكرة_مفسر_جديدة(): ذاكرة_مفسر {
    دع الصناديق: متجه اختيار قيمة_تشغيل = [];
    دع أجيال_الصناديق: متجه غير_موقع = [];
    دع تالي_الصندوق_الحر: متجه اختيار غير_موقع = [];
    دع العوام: متجه اختيار قيمة_تشغيل = [];
    دع الإغلاقات: متجه سجل_إغلاق_مفسر = [];
    دع التقاطات_الإغلاقات: متجه قيمة_تشغيل = [];
    دع الذاكرة: ذاكرة_مفسر = {
        الصناديق: الصناديق,
        أجيال_الصناديق: أجيال_الصناديق,
        تالي_الصندوق_الحر: تالي_الصندوق_الحر,
        رأس_الصناديق_الحرة: اختيار.لا_شيء(),
        العوام: العوام,
        الإغلاقات: الإغلاقات,
        التقاطات_الإغلاقات: التقاطات_الإغلاقات
    };
    أرجع الذاكرة;
}

عرف مؤشر_تفعيل_في_المكدس(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    التفعيل: معرف_تفعيل_مفسر
): اختيار غير_موقع {
    لو (عدد_الأطر > (الطول(*الأطر) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };

    // Activation IDs are issued monotonically and frames are pushed in issue order.
    // Popped frames are outside `عدد_الأطر`, so the live prefix stays strictly ordered.
    دع الأدنى: متغير غير_موقع = 0;
    دع الأعلى: متغير غير_موقع = عدد_الأطر;
    بينما (الأدنى < الأعلى) {
        دع الوسط: غير_موقع = الأدنى + ((الأعلى - الأدنى) / 2);
        دع الحالي: غير_موقع = (*الأطر)[الوسط].التفعيل.القيمة;
        لو (الحالي < التفعيل.القيمة) {
            الأدنى := الوسط + 1;
        } وإلا {
            الأعلى := الوسط;
        };
    }
    لو (الأدنى < عدد_الأطر) {
        لو (معرفا_تفعيل_مفسر_متساويان((*الأطر)[الأدنى].التفعيل, التفعيل)) {
            أرجع اختيار.بعض(الأدنى);
        };
    };
    أرجع اختيار.لا_شيء();
}

عرف اقرأ_إسقاطا(
    القيمة: &قيمة_تشغيل,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل,
    الموضع: غير_موقع
): نتيجة_قراءة_ذاكرة_مفسر {
    لو (الموضع >= (الطول(*الإسقاطات) مثل غير_موقع)) {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(القيمة);
        أرجع نتيجة_قراءة_ذاكرة_مفسر.قيمة(النسخة);
    };
    دع الفهرس: متغير غير_موقع = 0;
    طابق (*الإسقاطات)[الموضع] مع
    | إسقاط_مكان_تشغيل.حقل(ف) -> {
        الفهرس := ف;
    }
    | إسقاط_مكان_تشغيل.فهرس(ف) -> {
        الفهرس := ف;
    };
    طابق *القيمة مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        لو (الفهرس >= (الطول(الأعضاء) مثل غير_موقع)) {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
                )
            );
        };
        // Traverse the stored aggregate without deep-copying every intermediate member.
        // The leaf is copied exactly once by the base case to preserve value semantics.
        أرجع اقرأ_إسقاطا(&الأعضاء[الفهرس], الإسقاطات, الموضع + 1);
    }
    | _ -> {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
            )
        );
    };
}

عرف اكتب_إسقاطا(
    الأصل: &قيمة_تشغيل,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل,
    الموضع: غير_موقع,
    الجديدة: قيمة_تشغيل
): نتيجة_قراءة_ذاكرة_مفسر {
    لو (الموضع >= (الطول(*الإسقاطات) مثل غير_موقع)) {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الجديدة);
        أرجع نتيجة_قراءة_ذاكرة_مفسر.قيمة(النسخة);
    };
    دع الفهرس: متغير غير_موقع = 0;
    طابق (*الإسقاطات)[الموضع] مع
    | إسقاط_مكان_تشغيل.حقل(ف) -> {
        الفهرس := ف;
    }
    | إسقاط_مكان_تشغيل.فهرس(ف) -> {
        الفهرس := ف;
    };
    طابق *الأصل مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        لو (الفهرس >= (الطول(الأعضاء) مثل غير_موقع)) {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
                )
            );
        };
        دع القيم: متغير متجه قيمة_تشغيل = [];
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول(الأعضاء) مثل غير_موقع)) {
            دع نسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الأعضاء[ن]);
            ألحق(القيم, نسخة);
            ن := ن + 1;
        }
        // `القيم` already owns an independent copy of every sibling/member.
        // Recurse through that owned member directly instead of cloning the selected subtree twice.
        طابق اكتب_إسقاطا(&القيم[الفهرس], الإسقاطات, الموضع + 1, الجديدة) مع
        | نتيجة_قراءة_ذاكرة_مفسر.قيمة(المحدثة) -> {
            القيم[الفهرس] := المحدثة;
            أرجع نتيجة_قراءة_ذاكرة_مفسر.قيمة(قيمة_تشغيل.تجميع(القيم));
        }
        | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ);
        };
    }
    | _ -> {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
            )
        );
    };
}

عام عرف هيئ_عام_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_عام_مسير,
    القيمة: قيمة_تشغيل
): منطقي {
    بينما ((الطول((*الذاكرة).العوام) مثل غير_موقع) <= المعرف.القيمة) {
        ألحق((*الذاكرة).العوام, اختيار.لا_شيء());
    }
    طابق (*الذاكرة).العوام[المعرف.القيمة] مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
        (*الذاكرة).العوام[المعرف.القيمة] := اختيار.بعض(النسخة);
        أرجع صواب;
    };
}

عام عرف خصص_صندوق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    القيمة: قيمة_تشغيل
): معرف_صندوق_مفسر {
    دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
    طابق (*الذاكرة).رأس_الصناديق_الحرة مع
    | اختيار.لا_شيء -> {
        دع الموضع: غير_موقع = الطول((*الذاكرة).الصناديق) مثل غير_موقع;
        ألحق((*الذاكرة).الصناديق, اختيار.بعض(النسخة));
        ألحق((*الذاكرة).أجيال_الصناديق, 0);
        ألحق((*الذاكرة).تالي_الصندوق_الحر, اختيار.لا_شيء());
        أرجع معرف_صندوق_مفسر_من(الموضع, 0);
    }
    | اختيار.بعض(الموضع) -> {
        دع التالي: اختيار غير_موقع = (*الذاكرة).تالي_الصندوق_الحر[الموضع];
        دع الجيل: غير_موقع = (*الذاكرة).أجيال_الصناديق[الموضع] + 1;
        (*الذاكرة).رأس_الصناديق_الحرة := التالي;
        (*الذاكرة).أجيال_الصناديق[الموضع] := الجيل;
        (*الذاكرة).تالي_الصندوق_الحر[الموضع] := اختيار.لا_شيء();
        (*الذاكرة).الصناديق[الموضع] := اختيار.بعض(النسخة);
        أرجع معرف_صندوق_مفسر_من(الموضع, الجيل);
    };
}


عام عرف خصص_إغلاق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    الدالة: معرف_دالة_مسير,
    الالتقاطات: &متجه قيمة_تشغيل
): معرف_إغلاق_مفسر {
    دع المعرف: معرف_إغلاق_مفسر = معرف_إغلاق_مفسر_من(
        الطول((*الذاكرة).الإغلاقات) مثل غير_موقع
    );
    دع البداية: غير_موقع = الطول((*الذاكرة).التقاطات_الإغلاقات) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الالتقاطات) مثل غير_موقع)) {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&(*الالتقاطات)[ف]);
        ألحق((*الذاكرة).التقاطات_الإغلاقات, النسخة);
        ف := ف + 1;
    }
    دع عدد_الالتقاطات: غير_موقع = الطول(*الالتقاطات) مثل غير_موقع;
    دع السجل: سجل_إغلاق_مفسر = {
        الدالة: الدالة,
        بداية_الالتقاطات: البداية,
        عدد_الالتقاطات: عدد_الالتقاطات
    };
    ألحق((*الذاكرة).الإغلاقات, السجل);
    أرجع المعرف;
}

عام عرف دالة_إغلاق_مفسر_عند(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر
): اختيار معرف_دالة_مسير {
    لو (المعرف.القيمة >= (الطول((*الذاكرة).الإغلاقات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض((*الذاكرة).الإغلاقات[المعرف.القيمة].الدالة);
}

عام عرف التقاط_إغلاق_مفسر_عند(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر,
    الفهرس: غير_موقع
): اختيار قيمة_تشغيل {
    لو (المعرف.القيمة >= (الطول((*الذاكرة).الإغلاقات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع السجل: سجل_إغلاق_مفسر = (*الذاكرة).الإغلاقات[المعرف.القيمة];
    لو (الفهرس >= السجل.عدد_الالتقاطات) {
        أرجع اختيار.لا_شيء();
    };
    دع الموضع: غير_موقع = السجل.بداية_الالتقاطات + الفهرس;
    لو (الموضع >= (الطول((*الذاكرة).التقاطات_الإغلاقات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع القيمة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&(*الذاكرة).التقاطات_الإغلاقات[الموضع]);
    أرجع اختيار.بعض(القيمة);
}

عام عرف هوية_صندوق_مفسر_صالحة(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_صندوق_مفسر
): منطقي {
    لو (المعرف.القيمة >= (الطول((*الذاكرة).الصناديق) مثل غير_موقع)) {
        أرجع خطأ;
    };
    لو (المعرف.القيمة >= (الطول((*الذاكرة).أجيال_الصناديق) مثل غير_موقع)) {
        أرجع خطأ;
    };
    لو ((*الذاكرة).أجيال_الصناديق[المعرف.القيمة] != المعرف.الجيل) {
        أرجع خطأ;
    };
    طابق (*الذاكرة).الصناديق[المعرف.القيمة] مع
    | اختيار.بعض(_) -> {
        أرجع صواب;
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

// A root can exist while its local cell is still uninitialized (and may be
// initialized by a later store). Only the empty projection of such a root is
// valid. All other references must name an existing member at every level.
عرف إسقاطات_مكان_مفسر_صالحة(
    القيمة: &قيمة_تشغيل,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل,
    الموضع: غير_موقع
): منطقي {
    لو (الموضع >= (الطول(*الإسقاطات) مثل غير_موقع)) { أرجع صواب; };
    دع الفهرس: غير_موقع;
    طابق (*الإسقاطات)[الموضع] مع
    | إسقاط_مكان_تشغيل.حقل(العضو) -> { الفهرس := العضو; }
    | إسقاط_مكان_تشغيل.فهرس(العضو) -> { الفهرس := العضو; };
    طابق *القيمة مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        لو (الفهرس >= (الطول(الأعضاء) مثل غير_موقع)) { أرجع خطأ; };
        أرجع إسقاطات_مكان_مفسر_صالحة(&الأعضاء[الفهرس], الإسقاطات, الموضع + 1);
    }
    | _ -> { أرجع خطأ; };
}

عام عرف هوية_مكان_مفسر_صالحة(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    المكان: &مكان_تشغيل
): منطقي {
    دع الموضع: مكان_تشغيل = *المكان;
    طابق الموضع.الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
        | اختيار.لا_شيء -> {
            أرجع خطأ;
        }
        | اختيار.بعض(فهرس_الإطار) -> {
            دع الإطار: &إطار_تفسير_مسير = &(*الأطر)[فهرس_الإطار];
            لو (الخلية.القيمة >= (الطول((*الإطار).المحليات) مثل غير_موقع)) {
                أرجع خطأ;
            };
            طابق (*الإطار).المحليات[الخلية.القيمة] مع
            | اختيار.لا_شيء -> {
                أرجع (الطول(الموضع.الإسقاطات) مثل غير_موقع) == 0;
            }
            | اختيار.بعض(القيمة) -> {
                أرجع إسقاطات_مكان_مفسر_صالحة(&القيمة, &الموضع.الإسقاطات, 0);
            };
        };
    }
    | جذر_مكان_تشغيل.عام(المعرف) -> {
        لو (المعرف.القيمة >= (الطول((*الذاكرة).العوام) مثل غير_موقع)) { أرجع خطأ; };
        طابق (*الذاكرة).العوام[المعرف.القيمة] مع
        | اختيار.بعض(القيمة) -> {
            أرجع إسقاطات_مكان_مفسر_صالحة(&القيمة, &الموضع.الإسقاطات, 0);
        }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        لو (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) { أرجع خطأ; };
        طابق (*الذاكرة).الصناديق[المعرف.القيمة] مع
        | اختيار.بعض(القيمة) -> {
            أرجع إسقاطات_مكان_مفسر_صالحة(&القيمة, &الموضع.الإسقاطات, 0);
        }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    };
}

عام عرف اقرأ_مكان_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    المكان: &مكان_تشغيل
): نتيجة_قراءة_ذاكرة_مفسر {
    دع الموضع: مكان_تشغيل = *المكان;
    طابق الموضع مع
    | { الجذر: الجذر, الإسقاطات: الإسقاطات, قابل_للكتابة: _ } -> {
        طابق الجذر مع
        | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
            طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                );
            }
            | اختيار.بعض(فهرس_الإطار) -> {
                دع الإطار: &إطار_تفسير_مسير = &(*الأطر)[فهرس_الإطار];
                لو (الخلية.القيمة >= (الطول((*الإطار).المحليات) مثل غير_موقع)) {
                    أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                        فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                    );
                };
                طابق (*الإطار).المحليات[الخلية.القيمة] مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                        فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                    );
                }
                | اختيار.بعض(القيمة) -> {
                    أرجع اقرأ_إسقاطا(&القيمة, &الإسقاطات, 0);
                };
            };
        }
        | جذر_مكان_تشغيل.عام(المعرف) -> {
            لو (المعرف.القيمة >= (الطول((*الذاكرة).العوام) مثل غير_موقع)) {
                أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف()));
            };
            طابق (*الذاكرة).العوام[المعرف.القيمة] مع
            | اختيار.لا_شيء -> { أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())); }
            | اختيار.بعض(القيمة) -> { أرجع اقرأ_إسقاطا(&القيمة, &الإسقاطات, 0); };
        }
        | جذر_مكان_تشغيل.صندوق(المعرف) -> {
            لو (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) {
                أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                    )
                );
            };
            طابق (*الذاكرة).الصناديق[المعرف.القيمة] مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                    )
                );
            }
            | اختيار.بعض(القيمة) -> {
                أرجع اقرأ_إسقاطا(&القيمة, &الإسقاطات, 0);
            };
        };
    };
}

عام عرف اكتب_مكان_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &متغير ذاكرة_مفسر,
    المكان: &مكان_تشغيل,
    القيمة: قيمة_تشغيل
): نتيجة_كتابة_ذاكرة_مفسر {
    دع الموضع: مكان_تشغيل = *المكان;
    طابق الموضع مع
    | { الجذر: الجذر, الإسقاطات: الإسقاطات, قابل_للكتابة: قابل_للكتابة } -> {
        لو (!قابل_للكتابة) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط()
                )
            );
        };
        طابق الجذر مع
        | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
            طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                );
            }
            | اختيار.بعض(فهرس_الإطار) -> {
                دع الإطار: &متغير إطار_تفسير_مسير = &متغير (*الأطر)[فهرس_الإطار];
                لو (الخلية.القيمة >= (الطول((*الإطار).المحليات) مثل غير_موقع)) {
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                        فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                    );
                };
                طابق (*الإطار).المحليات[الخلية.القيمة] مع
                | اختيار.لا_شيء -> {
                    لو ((الطول(الإسقاطات) مثل غير_موقع) != 0) {
                        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                        );
                    };
                    دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
                    (*الإطار).المحليات[الخلية.القيمة] := اختيار.بعض(النسخة);
                }
                | اختيار.بعض(الأصل) -> {
                    طابق اكتب_إسقاطا(&الأصل, &الإسقاطات, 0, القيمة) مع
                    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(المحدثة) -> {
                        (*الإطار).المحليات[الخلية.القيمة] := اختيار.بعض(المحدثة);
                    }
                    | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
                        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ);
                    };
                };
                أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
            };
        }
        | جذر_مكان_تشغيل.عام(المعرف) -> {
            لو (المعرف.القيمة >= (الطول((*الذاكرة).العوام) مثل غير_موقع)) {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف()));
            };
            طابق (*الذاكرة).العوام[المعرف.القيمة] مع
            | اختيار.لا_شيء -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())); }
            | اختيار.بعض(الأصل) -> {
                طابق اكتب_إسقاطا(&الأصل, &الإسقاطات, 0, القيمة) مع
                | نتيجة_قراءة_ذاكرة_مفسر.قيمة(المحدثة) -> {
                    (*الذاكرة).العوام[المعرف.القيمة] := اختيار.بعض(المحدثة);
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
                }
                | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ); };
            };
        }
        | جذر_مكان_تشغيل.صندوق(المعرف) -> {
            لو (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                    )
                );
            };
            طابق (*الذاكرة).الصناديق[المعرف.القيمة] مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                    )
                );
            }
            | اختيار.بعض(الأصل) -> {
                طابق اكتب_إسقاطا(&الأصل, &الإسقاطات, 0, القيمة) مع
                | نتيجة_قراءة_ذاكرة_مفسر.قيمة(المحدثة) -> {
                    (*الذاكرة).الصناديق[المعرف.القيمة] := اختيار.بعض(المحدثة);
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
                }
                | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ);
                };
            };
        };
    };
}

// Release an Interpreter-owned storage root. Release is semantic here: no target layout or host pointer is exposed.
عام عرف حرر_مكان_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &متغير ذاكرة_مفسر,
    المكان: &مكان_تشغيل
): نتيجة_كتابة_ذاكرة_مفسر {
    دع الموضع: مكان_تشغيل = *المكان;
    لو ((الطول(الموضع.الإسقاطات) مثل غير_موقع) != 0) {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
        );
    };
    لو (!الموضع.قابل_للكتابة) {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط()
            )
        );
    };
    طابق الموضع.الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
            );
        }
        | اختيار.بعض(فهرس_الإطار) -> {
            دع الإطار: &متغير إطار_تفسير_مسير = &متغير (*الأطر)[فهرس_الإطار];
            لو (الخلية.القيمة >= (الطول((*الإطار).المحليات) مثل غير_موقع)) {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                );
            };
            (*الإطار).المحليات[الخلية.القيمة] := اختيار.لا_شيء();
            أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
        };
    }
    | جذر_مكان_تشغيل.عام(_) -> {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف()));
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        لو (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                )
            );
        };
        طابق (*الذاكرة).الصناديق[المعرف.القيمة] مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                )
            );
        }
        | اختيار.بعض(_) -> {
            // Keep the slot generation, link the released slot into the O(1) free list,
            // and require the next allocation to advance the generation before reuse.
            (*الذاكرة).الصناديق[المعرف.القيمة] := اختيار.لا_شيء();
            (*الذاكرة).تالي_الصندوق_الحر[المعرف.القيمة] := (*الذاكرة).رأس_الصناديق_الحرة;
            (*الذاكرة).رأس_الصناديق_الحرة := اختيار.بعض(المعرف.القيمة);
            أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
        };
    };
}

// Byte spans are copies of Interpreter-owned semantic storage, never host
// addresses. The caller must supply the canonical referent Type; raw machine
// words alone cannot establish it. Other scalars, structs and pointers have
// no byte-layout contract here and are deliberately rejected.
نوع صنف_تخزين_بايتات_مفسر =
    | نص
    | متجه_غ8
    | متجه_عدد_صحيح بنوع غير_موقع
    | عدد_صحيح بنوع غير_موقع
    | غير_مدعوم
;

عام نوع نتيجة_نسخ_بايتات_مفسر =
    | بايتات بنوع متجه غ8
    | أخفق بنوع فشل_تفسير_مسير
;

عرف صنف_تخزين_بايتات_مفسر_لنوع(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): صنف_تخزين_بايتات_مفسر {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.لا_شيء -> { أرجع صنف_تخزين_بايتات_مفسر.غير_مدعوم(); }
    | اختيار.بعض(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            لو (البدائي == نوع_بدائي_مقنن.نص()) {
                أرجع صنف_تخزين_بايتات_مفسر.نص();
            };
            // Linux x86-64 and AArch64 both use little-endian scalar ABI
            // slots. The pointee type, not the interpreter word, fixes width.
            لو (البدائي == نوع_بدائي_مقنن.غ8() || البدائي == نوع_بدائي_مقنن.ص8()) {
                أرجع صنف_تخزين_بايتات_مفسر.عدد_صحيح(1);
            };
            لو (البدائي == نوع_بدائي_مقنن.غ16() || البدائي == نوع_بدائي_مقنن.ص16()) {
                أرجع صنف_تخزين_بايتات_مفسر.عدد_صحيح(2);
            };
            لو (البدائي == نوع_بدائي_مقنن.غ32() || البدائي == نوع_بدائي_مقنن.ص32()) {
                أرجع صنف_تخزين_بايتات_مفسر.عدد_صحيح(4);
            };
            لو (البدائي == نوع_بدائي_مقنن.غ64() || البدائي == نوع_بدائي_مقنن.ص64()
                || البدائي == نوع_بدائي_مقنن.عدد() || البدائي == نوع_بدائي_مقنن.غير_موقع()) {
                أرجع صنف_تخزين_بايتات_مفسر.عدد_صحيح(8);
            };
        }
        | صنف_شكل_نوع_دلالي.متجه -> {
            طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(العنصر) -> {
                طابق وصف_شكل_نوع_دلالي_عند(الأنواع, العنصر) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(شكل_العنصر) -> {
                    طابق شكل_العنصر.الصنف مع
                    | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                        لو (البدائي == نوع_بدائي_مقنن.غ8()) {
                            أرجع صنف_تخزين_بايتات_مفسر.متجه_غ8();
                        };
                        طابق صنف_تخزين_بايتات_مفسر_لنوع(الأنواع, العنصر) مع
                        | صنف_تخزين_بايتات_مفسر.عدد_صحيح(العرض) -> {
                            أرجع صنف_تخزين_بايتات_مفسر.متجه_عدد_صحيح(العرض);
                        }
                        | _ -> { };
                    }
                    | _ -> { };
                };
            };
        }
        | _ -> { };
    };
    أرجع صنف_تخزين_بايتات_مفسر.غير_مدعوم();
}

عرف فشل_نطاق_بايتات_مفسر(): فشل_تفسير_مسير {
    أرجع فشل_تفسير_مسير.وقت_تشغيل(
        خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف()
    );
}

// Subtraction-based check: neither start + length nor the endpoint can wrap.
عرف نطاق_بايتات_مفسر_صالح(
    الطول_الكلي: غير_موقع,
    البداية: غير_موقع,
    المطلوب: غير_موقع
): منطقي {
    أرجع البداية <= الطول_الكلي && المطلوب <= الطول_الكلي - البداية;
}

// Copy in from a live reference, with Type-proven u8 elements. Endianness
// and alignment are unambiguous for bytes. No pinning or host buffer address
// escapes this boundary. The result is an independent owned vector.
عرف انسخ_نطاق_بايتات_من_مكان_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المكان: &مكان_تشغيل,
    البداية: غير_موقع,
    المطلوب: غير_موقع
): نتيجة_نسخ_بايتات_مفسر {
    دع الصنف: صنف_تخزين_بايتات_مفسر = صنف_تخزين_بايتات_مفسر_لنوع(الأنواع, النوع);
    طابق الصنف مع
    | صنف_تخزين_بايتات_مفسر.غير_مدعوم -> {
        أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    }
    | _ -> { };
    طابق اقرأ_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, المكان) مع
    | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> {
        دع الناتج: متغير متجه غ8 = [];
        طابق الصنف مع
        | صنف_تخزين_بايتات_مفسر.نص -> {
            طابق القيمة مع
            | قيمة_تشغيل.نص(البايتات) -> {
                لو (!نطاق_بايتات_مفسر_صالح(الطول(البايتات) مثل غير_موقع, البداية, المطلوب)) {
                    أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                };
                دع فهرس: متغير غير_موقع = 0;
                بينما (فهرس < المطلوب) {
                    ألحق(الناتج, البايتات[البداية + فهرس]);
                    فهرس := فهرس + 1;
                }
            }
            | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
        }
        | صنف_تخزين_بايتات_مفسر.عدد_صحيح(العرض) -> {
            لو (!نطاق_بايتات_مفسر_صالح(العرض, البداية, المطلوب)) {
                أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
            };
            طابق القيمة مع
            | قيمة_تشغيل.بتات_عدد(البتات) -> {
                دع فهرس: متغير غير_موقع = 0;
                بينما (فهرس < المطلوب) {
                    دع الإزاحة: غير_موقع = (البداية + فهرس) * 8;
                    ألحق(الناتج, ((البتات >> الإزاحة) & 255) مثل غ8);
                    فهرس := فهرس + 1;
                }
            }
            | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
        }
        | صنف_تخزين_بايتات_مفسر.متجه_عدد_صحيح(العرض) -> {
            طابق القيمة مع
            | قيمة_تشغيل.تجميع(العناصر) -> {
                دع عدد_العناصر: غير_موقع = الطول(العناصر) مثل غير_موقع;
                لو (عدد_العناصر > (~(0 مثل غير_موقع)) / العرض
                    || !نطاق_بايتات_مفسر_صالح(عدد_العناصر * العرض, البداية, المطلوب)) {
                    أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                };
                دع فهرس: متغير غير_موقع = 0;
                بينما (فهرس < المطلوب) {
                    دع موضع_البايت: غير_موقع = البداية + فهرس;
                    طابق العناصر[موضع_البايت / العرض] مع
                    | قيمة_تشغيل.بتات_عدد(البتات) -> {
                        ألحق(الناتج, ((البتات >> ((موضع_البايت % العرض) * 8)) & 255) مثل غ8);
                    }
                    | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                    فهرس := فهرس + 1;
                }
            }
            | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
        }
        | صنف_تخزين_بايتات_مفسر.متجه_غ8 -> {
            طابق القيمة مع
            | قيمة_تشغيل.تجميع(العناصر) -> {
                لو (!نطاق_بايتات_مفسر_صالح(الطول(العناصر) مثل غير_موقع, البداية, المطلوب)) {
                    أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                };
                دع فهرس: متغير غير_موقع = 0;
                بينما (فهرس < المطلوب) {
                    طابق العناصر[البداية + فهرس] مع
                    | قيمة_تشغيل.بتات_عدد(البتات) -> {
                        لو (البتات > 255) {
                            أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                        };
                        ألحق(الناتج, البتات مثل غ8);
                    }
                    | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                    فهرس := فهرس + 1;
                }
            }
            | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
        }
        | صنف_تخزين_بايتات_مفسر.غير_مدعوم -> {
            أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
        };
        أرجع نتيجة_نسخ_بايتات_مفسر.بايتات(الناتج);
    };
}

// Copy back only the bytes actually supplied by the caller (for a partial
// read, this must be the kernel-reported count). Validate the complete span
// and its writability before committing an independently constructed value.
// A failed validation cannot partially mutate Interpreter storage.
عرف انسخ_نطاق_بايتات_إلى_مكان_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &متغير ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المكان: &مكان_تشغيل,
    البداية: غير_موقع,
    البايتات: &متجه غ8
): نتيجة_كتابة_ذاكرة_مفسر {
    لو (!(*المكان).قابل_للكتابة) {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط()
            )
        );
    };
    دع الصنف: صنف_تخزين_بايتات_مفسر = صنف_تخزين_بايتات_مفسر_لنوع(الأنواع, النوع);
    طابق الصنف مع
    | صنف_تخزين_بايتات_مفسر.غير_مدعوم -> {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    }
    | _ -> { };
    طابق اقرأ_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, المكان) مع
    | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ);
    }
    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> {
        دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
        دع الجديدة: قيمة_تشغيل;
        طابق الصنف مع
        | صنف_تخزين_بايتات_مفسر.نص -> {
            // Arbitrary kernel output cannot preserve text's UTF-8 invariant.
            // Text may be copied in, but mutable output requires a u8 vector.
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
        }
        | صنف_تخزين_بايتات_مفسر.عدد_صحيح(العرض) -> {
            لو (!نطاق_بايتات_مفسر_صالح(العرض, البداية, العدد)) {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
            };
            طابق القيمة مع
            | قيمة_تشغيل.بتات_عدد(البتات) -> {
                دع مجموع: متغير غير_موقع = 0;
                دع فهرس: متغير غير_موقع = 0;
                بينما (فهرس < العرض) {
                    دع العنصر: متغير غير_موقع = (البتات >> (فهرس * 8)) & 255;
                    لو (فهرس >= البداية && (فهرس - البداية) < العدد) {
                        العنصر := (*البايتات)[فهرس - البداية] مثل غير_موقع;
                    };
                    مجموع := مجموع | (العنصر << (فهرس * 8));
                    فهرس := فهرس + 1;
                }
                الجديدة := قيمة_تشغيل.بتات_عدد(مجموع);
            }
            | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
        }
        | صنف_تخزين_بايتات_مفسر.متجه_عدد_صحيح(العرض) -> {
            طابق القيمة مع
            | قيمة_تشغيل.تجميع(الأصل) -> {
                دع عدد_العناصر: غير_موقع = الطول(الأصل) مثل غير_موقع;
                لو (عدد_العناصر > (~(0 مثل غير_موقع)) / العرض
                    || !نطاق_بايتات_مفسر_صالح(عدد_العناصر * العرض, البداية, العدد)) {
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                };
                دع النسخة: متغير متجه قيمة_تشغيل = [];
                دع فهرس: متغير غير_موقع = 0;
                بينما (فهرس < عدد_العناصر) {
                    طابق الأصل[فهرس] مع
                    | قيمة_تشغيل.بتات_عدد(البتات) -> {
                        دع المعدلة: متغير غير_موقع = البتات;
                        دع فهرس_بايت: متغير غير_موقع = 0;
                        بينما (فهرس_بايت < العرض) {
                            دع موضع_بايت: غير_موقع = فهرس * العرض + فهرس_بايت;
                            لو (موضع_بايت >= البداية && (موضع_بايت - البداية) < العدد) {
                                دع إزاحة_بت: غير_موقع = فهرس_بايت * 8;
                                دع القناع: غير_موقع = (255 مثل غير_موقع) << إزاحة_بت;
                                دع الجديد: غير_موقع = (*البايتات)[موضع_بايت - البداية] مثل غير_موقع;
                                المعدلة := (المعدلة & (~القناع)) | (الجديد << إزاحة_بت);
                            };
                            فهرس_بايت := فهرس_بايت + 1;
                        }
                        ألحق(النسخة, قيمة_تشغيل.بتات_عدد(المعدلة));
                    }
                    | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                    فهرس := فهرس + 1;
                }
                الجديدة := قيمة_تشغيل.تجميع(النسخة);
            }
            | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
        }
        | صنف_تخزين_بايتات_مفسر.متجه_غ8 -> {
            طابق القيمة مع
            | قيمة_تشغيل.تجميع(الأصل) -> {
                دع الطول_الكلي: غير_موقع = الطول(الأصل) مثل غير_موقع;
                لو (!نطاق_بايتات_مفسر_صالح(الطول_الكلي, البداية, العدد)) {
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                };
                دع النسخة: متغير متجه قيمة_تشغيل = [];
                دع فهرس: متغير غير_موقع = 0;
                بينما (فهرس < الطول_الكلي) {
                    طابق الأصل[فهرس] مع
                    | قيمة_تشغيل.بتات_عدد(البتات) -> {
                        لو (البتات > 255) {
                            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                        };
                        دع قيمة_العنصر: متغير غير_موقع = البتات;
                        لو (فهرس >= البداية && (فهرس - البداية) < العدد) {
                            قيمة_العنصر := (*البايتات)[فهرس - البداية] مثل غير_موقع;
                        };
                        ألحق(النسخة, قيمة_تشغيل.بتات_عدد(قيمة_العنصر));
                    }
                    | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                    فهرس := فهرس + 1;
                }
                الجديدة := قيمة_تشغيل.تجميع(النسخة);
            }
            | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
        }
        | صنف_تخزين_بايتات_مفسر.غير_مدعوم -> {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
        };
        أرجع اكتب_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, المكان, الجديدة);
    };
}

// Resolve pointer provenance and pointee Type from verified MSIR, never from
// the pointer's numeric bits or a caller-invented Type. No registry of host
// addresses is introduced. A raw scalar word cannot masquerade as a place.
نوع نتيجة_حل_مؤشر_بايتات_مفسر =
    | موجود بنوع (مكان_تشغيل, معرف_نوع)
    | غير_صالح
;

عرف حل_مؤشر_بايتات_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل
): نتيجة_حل_مؤشر_بايتات_مفسر {
    دع النوع: معرف_نوع;
    طابق نوع_قيمة_مسير(المسير, المعرف) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_حل_مؤشر_بايتات_مفسر.غير_صالح(); }
    | اختيار.بعض(القيمة) -> { النوع := القيمة; };
    دع الداخل: معرف_نوع;
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.بعض(نوع_مقنن.مؤشر(النوع_الداخلي)) -> {
        الداخل := النوع_الداخلي;
    }
    | _ -> { أرجع نتيجة_حل_مؤشر_بايتات_مفسر.غير_صالح(); };
    طابق *المؤشر مع
    | قيمة_تشغيل.مرجع(المكان) -> {
        لو (!هوية_مكان_مفسر_صالحة(الأطر, عدد_الأطر, الذاكرة, &المكان)) {
            أرجع نتيجة_حل_مؤشر_بايتات_مفسر.غير_صالح();
        };
        دع النسخة: مكان_تشغيل = انسخ_مكان_تشغيل(&المكان);
        أرجع نتيجة_حل_مؤشر_بايتات_مفسر.موجود(النسخة, الداخل);
    }
    | _ -> { أرجع نتيجة_حل_مؤشر_بايتات_مفسر.غير_صالح(); };
}

// Output permission is checked before any host operation. A valid pointer to
// text is readable but cannot be a kernel output: arbitrary bytes can break
// the text invariant. Validate through the existing live memory owner.
عام عرف مؤشر_بايتات_مفسر_قابل_للكتابة(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل
): منطقي {
    طابق حل_مؤشر_بايتات_مفسر(
        الأطر, عدد_الأطر, الذاكرة, الأنواع, المسير, المعرف, المؤشر
    ) مع
    | نتيجة_حل_مؤشر_بايتات_مفسر.غير_صالح -> { أرجع خطأ; }
    | نتيجة_حل_مؤشر_بايتات_مفسر.موجود(المكان, النوع) -> {
        لو (!المكان.قابل_للكتابة) { أرجع خطأ; };
        طابق صنف_تخزين_بايتات_مفسر_لنوع(الأنواع, النوع) مع
        | صنف_تخزين_بايتات_مفسر.نص -> { أرجع خطأ; }
        | صنف_تخزين_بايتات_مفسر.غير_مدعوم -> { أرجع خطأ; }
        | _ -> { أرجع صواب; };
    };
}

// An indexed u8 reference denotes a position inside the owning vector, not
// an isolated scalar byte. Recover the parent place while preserving its
// activation/generation identity. Only verified MSIR descriptors may use this.
نوع نتيجة_موضع_متجه_بايتات_مفسر =
    | موجود بنوع (مكان_تشغيل, غير_موقع)
    | غير_صالح
;

عرف موضع_متجه_بايتات_مفسر(المكان: &مكان_تشغيل): نتيجة_موضع_متجه_بايتات_مفسر {
    دع عدد_الإسقاطات: غير_موقع = الطول((*المكان).الإسقاطات) مثل غير_موقع;
    لو (عدد_الإسقاطات == 0) { أرجع نتيجة_موضع_متجه_بايتات_مفسر.غير_صالح(); };
    دع الفهرس: غير_موقع;
    طابق (*المكان).الإسقاطات[عدد_الإسقاطات - 1] مع
    | إسقاط_مكان_تشغيل.فهرس(الموضع) -> { الفهرس := الموضع; }
    | _ -> { أرجع نتيجة_موضع_متجه_بايتات_مفسر.غير_صالح(); };
    دع الأصل: متغير مكان_تشغيل = انسخ_مكان_تشغيل(المكان);
    دع البقية: متغير متجه إسقاط_مكان_تشغيل = [];
    دع فهرس_الإسقاط: متغير غير_موقع = 0;
    بينما (فهرس_الإسقاط < عدد_الإسقاطات - 1) {
        ألحق(البقية, (*المكان).الإسقاطات[فهرس_الإسقاط]);
        فهرس_الإسقاط := فهرس_الإسقاط + 1;
    }
    الأصل.الإسقاطات := البقية;
    أرجع نتيجة_موضع_متجه_بايتات_مفسر.موجود(الأصل, الفهرس);
}

// A normalized span identifies the live semantic storage containing its bytes.
// Indexed scalar pointers use the parent vector and a byte offset, so pointers
// to different indices of one allocation can be compared without host addresses.
// This is only ephemeral metadata for syscall preflight, never another registry.
عام نوع نطاق_تخزين_بايتات_مفسر = {
    الأصل: مكان_تشغيل,
    البداية: غير_موقع,
    المطلوب: غير_موقع
};

عام نوع نتيجة_هوية_نطاق_بايتات_مفسر =
    | موجود بنوع نطاق_تخزين_بايتات_مفسر
    | غير_صالح
;

// Derive overlap identity through the canonical memory owner and the pointee
// Type carried by verified MSIR. The copy-in operation separately verifies the
// complete actual live extent; no address arithmetic ever accesses host memory.
عام عرف حل_هوية_نطاق_بايتات_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل,
    المطلوب: غير_موقع
): نتيجة_هوية_نطاق_بايتات_مفسر {
    طابق حل_مؤشر_بايتات_مفسر(
        الأطر, عدد_الأطر, الذاكرة, الأنواع, المسير, المعرف, المؤشر
    ) مع
    | نتيجة_حل_مؤشر_بايتات_مفسر.غير_صالح -> {
        أرجع نتيجة_هوية_نطاق_بايتات_مفسر.غير_صالح();
    }
    | نتيجة_حل_مؤشر_بايتات_مفسر.موجود(المكان, النوع) -> {
        دع الأصل: متغير مكان_تشغيل = المكان;
        دع البداية: متغير غير_موقع = 0;
        طابق صنف_تخزين_بايتات_مفسر_لنوع(الأنواع, النوع) مع
        | صنف_تخزين_بايتات_مفسر.عدد_صحيح(العرض) -> {
            // For an indexed scalar, the referenced vector is the allocation.
            // An ordinary scalar retains its own storage identity.
            // المكان was moved into الأصل above; inspect the owned copy.
            طابق موضع_متجه_بايتات_مفسر(&الأصل) مع
            | نتيجة_موضع_متجه_بايتات_مفسر.موجود(الحاوي, الإزاحة) -> {
                لو (العرض == 0 || الإزاحة > (~(0 مثل غير_موقع)) / العرض) {
                    أرجع نتيجة_هوية_نطاق_بايتات_مفسر.غير_صالح();
                };
                الأصل := الحاوي;
                البداية := الإزاحة * العرض;
            }
            | نتيجة_موضع_متجه_بايتات_مفسر.غير_صالح -> { };
        }
        | صنف_تخزين_بايتات_مفسر.نص -> { }
        | صنف_تخزين_بايتات_مفسر.متجه_غ8 -> { }
        | صنف_تخزين_بايتات_مفسر.متجه_عدد_صحيح(_) -> { }
        | صنف_تخزين_بايتات_مفسر.غير_مدعوم -> {
            أرجع نتيجة_هوية_نطاق_بايتات_مفسر.غير_صالح();
        };
        لو (المطلوب > (~(0 مثل غير_موقع)) - البداية) {
            أرجع نتيجة_هوية_نطاق_بايتات_مفسر.غير_صالح();
        };
        دع النطاق: نطاق_تخزين_بايتات_مفسر = {
            الأصل: الأصل, البداية: البداية, المطلوب: المطلوب
        };
        أرجع نتيجة_هوية_نطاق_بايتات_مفسر.موجود(النطاق);
    };
}

// Half-open ranges permit adjacent buffers. Reject ANY nonempty overlap,
// including read/read, until verified MSIR specifies stronger alias semantics.
عام عرف نطاقا_تخزين_بايتات_متداخلان(
    الأول: &نطاق_تخزين_بايتات_مفسر,
    الثاني: &نطاق_تخزين_بايتات_مفسر
): منطقي {
    لو ((*الأول).المطلوب == 0 || (*الثاني).المطلوب == 0
        || !مكانا_تخزين_متطابقان(&(*الأول).الأصل, &(*الثاني).الأصل)) {
        أرجع خطأ;
    };
    // Both additions were checked when producing the normalized spans.
    أرجع (*الأول).البداية < (*الثاني).البداية + (*الثاني).المطلوب
        && (*الثاني).البداية < (*الأول).البداية + (*الأول).المطلوب;
}


عرف انسخ_من_عنصر_متجه_بايتات_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    المكان: &مكان_تشغيل,
    البداية: غير_موقع,
    المطلوب: غير_موقع,
    العرض: غير_موقع
): نتيجة_نسخ_بايتات_مفسر {
    طابق موضع_متجه_بايتات_مفسر(المكان) مع
    | نتيجة_موضع_متجه_بايتات_مفسر.غير_صالح -> {
        أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    }
    | نتيجة_موضع_متجه_بايتات_مفسر.موجود(الأصل, الإزاحة) -> {
        طابق اقرأ_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, &الأصل) مع
        | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> {
            طابق القيمة مع
            | قيمة_تشغيل.تجميع(العناصر) -> {
                دع الطول_الكلي: غير_موقع = الطول(العناصر) مثل غير_موقع;
                لو (الإزاحة > الطول_الكلي || العرض == 0
                    || (الطول_الكلي - الإزاحة) > (~(0 مثل غير_موقع)) / العرض
                    || !نطاق_بايتات_مفسر_صالح((الطول_الكلي - الإزاحة) * العرض, البداية, المطلوب)) {
                    أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                };
                دع البايتات: متغير متجه غ8 = [];
                دع الموضع: متغير غير_موقع = 0;
                بينما (الموضع < المطلوب) {
                    دع موضع_البايت: غير_موقع = البداية + الموضع;
                    طابق العناصر[الإزاحة + (موضع_البايت / العرض)] مع
                    | قيمة_تشغيل.بتات_عدد(العدد) -> {
                        لو (العرض == 1 && العدد > 255) {
                            أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                        };
                        ألحق(البايتات, ((العدد >> ((موضع_البايت % العرض) * 8)) & 255) مثل غ8);
                    }
                    | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                    الموضع := الموضع + 1;
                }
                أرجع نتيجة_نسخ_بايتات_مفسر.بايتات(البايتات);
            }
            | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
        };
    };
}

عرف انسخ_إلى_عنصر_متجه_بايتات_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &متغير ذاكرة_مفسر,
    المكان: &مكان_تشغيل,
    البداية: غير_موقع,
    البايتات: &متجه غ8,
    العرض: غير_موقع
): نتيجة_كتابة_ذاكرة_مفسر {
    لو (!(*المكان).قابل_للكتابة) {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    };
    طابق موضع_متجه_بايتات_مفسر(المكان) مع
    | نتيجة_موضع_متجه_بايتات_مفسر.غير_صالح -> {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    }
    | نتيجة_موضع_متجه_بايتات_مفسر.موجود(الأصل, الإزاحة) -> {
        طابق اقرأ_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, &الأصل) مع
        | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ);
        }
        | نتيجة_قراءة_ذاكرة_مفسر.قيمة(القيمة) -> {
            طابق القيمة مع
            | قيمة_تشغيل.تجميع(العناصر) -> {
                دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
                دع الطول_الكلي: غير_موقع = الطول(العناصر) مثل غير_موقع;
                لو (الإزاحة > الطول_الكلي || العرض == 0
                    || (الطول_الكلي - الإزاحة) > (~(0 مثل غير_موقع)) / العرض
                    || !نطاق_بايتات_مفسر_صالح((الطول_الكلي - الإزاحة) * العرض, البداية, العدد)) {
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                };
                دع الجديدة: متغير متجه قيمة_تشغيل = [];
                دع موضع: متغير غير_موقع = 0;
                بينما (موضع < الطول_الكلي) {
                    طابق العناصر[موضع] مع
                    | قيمة_تشغيل.بتات_عدد(القيمة_الخام) -> {
                        لو (العرض == 1 && القيمة_الخام > 255) {
                            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                        };
                        دع العنصر: متغير غير_موقع = القيمة_الخام;
                        لو (موضع >= الإزاحة) {
                            دع فهرس_بايت: متغير غير_موقع = 0;
                            بينما (فهرس_بايت < العرض) {
                                دع موضع_بايت: غير_موقع = (موضع - الإزاحة) * العرض + فهرس_بايت;
                                لو (موضع_بايت >= البداية && (موضع_بايت - البداية) < العدد) {
                                    دع إزاحة_بت: غير_موقع = فهرس_بايت * 8;
                                    دع القناع: غير_موقع = (255 مثل غير_موقع) << إزاحة_بت;
                                    دع الجديد: غير_موقع = (*البايتات)[موضع_بايت - البداية] مثل غير_موقع;
                                    العنصر := (العنصر & (~القناع)) | (الجديد << إزاحة_بت);
                                };
                                فهرس_بايت := فهرس_بايت + 1;
                            }
                        };
                        ألحق(الجديدة, قيمة_تشغيل.بتات_عدد(العنصر));
                    }
                    | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                    موضع := موضع + 1;
                }
                أرجع اكتب_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, &الأصل, قيمة_تشغيل.تجميع(الجديدة));
            }
            | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
        };
    };
}

// Copy-in entry for a proven raw pointer Value ID. A pointer to a single u8
// has no proven multi-element allocation extent today, and is rejected until
// the canonical MSIR contract carries an allocation/buffer span.
عام عرف انسخ_نطاق_بايتات_من_مؤشر_مسير_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل,
    البداية: غير_موقع,
    المطلوب: غير_موقع
): نتيجة_نسخ_بايتات_مفسر {
    طابق حل_مؤشر_بايتات_مفسر(
        الأطر, عدد_الأطر, الذاكرة, الأنواع, المسير, المعرف, المؤشر
    ) مع
    | نتيجة_حل_مؤشر_بايتات_مفسر.غير_صالح -> {
        أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    }
    | نتيجة_حل_مؤشر_بايتات_مفسر.موجود(المكان, النوع) -> {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختيار.بعض(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(_) -> {
                دع عرض_العنصر: غير_موقع;
                طابق صنف_تخزين_بايتات_مفسر_لنوع(الأنواع, النوع) مع
                | صنف_تخزين_بايتات_مفسر.عدد_صحيح(العرض) -> { عرض_العنصر := العرض; }
                | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                طابق موضع_متجه_بايتات_مفسر(&المكان) مع
                | نتيجة_موضع_متجه_بايتات_مفسر.موجود(_, _) -> {
                    أرجع انسخ_من_عنصر_متجه_بايتات_مفسر(
                        الأطر, عدد_الأطر, الذاكرة, &المكان, البداية, المطلوب,
                        عرض_العنصر
                    );
                }
                | نتيجة_موضع_متجه_بايتات_مفسر.غير_صالح -> {
                    لو (عرض_العنصر != 1) {
                        أرجع انسخ_نطاق_بايتات_من_مكان_مفسر(
                            الأطر, عدد_الأطر, الذاكرة, الأنواع, النوع,
                            &المكان, البداية, المطلوب
                        );
                    };
                    لو (البداية != 0 || المطلوب > 1) {
                        أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                    };
                    طابق اقرأ_مكان_مفسر(الأطر, عدد_الأطر, الذاكرة, &المكان) مع
                    | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
                        أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(الخطأ);
                    }
                    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(قيمة_تشغيل.بتات_عدد(القيمة)) -> {
                        لو (القيمة > 255) {
                            أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                        };
                        دع البايتات: متغير متجه غ8 = [];
                        لو (المطلوب == 1) { ألحق(البايتات, القيمة مثل غ8); };
                        أرجع نتيجة_نسخ_بايتات_مفسر.بايتات(البايتات);
                    }
                    | _ -> { أرجع نتيجة_نسخ_بايتات_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                };
            }
            | _ -> { };
        }
        | اختيار.لا_شيء -> { };
        أرجع انسخ_نطاق_بايتات_من_مكان_مفسر(
            الأطر, عدد_الأطر, الذاكرة, الأنواع, النوع, &المكان, البداية, المطلوب
        );
    };
}

// Output synchronization remains a single checked copy-back. The future
// syscall caller must pass only the count the kernel actually wrote.
عام عرف انسخ_نطاق_بايتات_إلى_مؤشر_مسير_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &متغير ذاكرة_مفسر,
    الأنواع: &سجل_أنواع,
    المسير: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير,
    المؤشر: &قيمة_تشغيل,
    البداية: غير_موقع,
    البايتات: &متجه غ8
): نتيجة_كتابة_ذاكرة_مفسر {
    طابق حل_مؤشر_بايتات_مفسر(
        الأطر, عدد_الأطر, الذاكرة, الأنواع, المسير, المعرف, المؤشر
    ) مع
    | نتيجة_حل_مؤشر_بايتات_مفسر.غير_صالح -> {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
    }
    | نتيجة_حل_مؤشر_بايتات_مفسر.موجود(المكان, النوع) -> {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختيار.بعض(الشكل) -> {
            طابق الشكل.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(_) -> {
                دع عرض_العنصر: غير_موقع;
                طابق صنف_تخزين_بايتات_مفسر_لنوع(الأنواع, النوع) مع
                | صنف_تخزين_بايتات_مفسر.عدد_صحيح(العرض) -> { عرض_العنصر := العرض; }
                | _ -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر()); };
                طابق موضع_متجه_بايتات_مفسر(&المكان) مع
                | نتيجة_موضع_متجه_بايتات_مفسر.موجود(_, _) -> {
                    أرجع انسخ_إلى_عنصر_متجه_بايتات_مفسر(
                        الأطر, عدد_الأطر, الذاكرة, &المكان, البداية, البايتات,
                        عرض_العنصر
                    );
                }
                | نتيجة_موضع_متجه_بايتات_مفسر.غير_صالح -> {
                    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
                    لو (عرض_العنصر != 1) {
                        أرجع انسخ_نطاق_بايتات_إلى_مكان_مفسر(
                            الأطر, عدد_الأطر, الذاكرة, الأنواع, النوع,
                            &المكان, البداية, البايتات
                        );
                    };
                    لو (!المكان.قابل_للكتابة || البداية != 0 || العدد > 1) {
                        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_نطاق_بايتات_مفسر());
                    };
                    لو (العدد == 0) { أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت(); };
                    أرجع اكتب_مكان_مفسر(
                        الأطر, عدد_الأطر, الذاكرة, &المكان,
                        قيمة_تشغيل.بتات_عدد((*البايتات)[0] مثل غير_موقع)
                    );
                };
            }
            | _ -> { };
        }
        | اختيار.لا_شيء -> { };
        أرجع انسخ_نطاق_بايتات_إلى_مكان_مفسر(
            الأطر, عدد_الأطر, الذاكرة, الأنواع, النوع, &المكان, البداية, البايتات
        );
    };
}
