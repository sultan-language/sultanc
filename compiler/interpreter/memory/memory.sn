استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.runtime_failures;
استورد compiler.msir.identifiers;

عام نوع سجل_إغلاق_مفسر = {
    الدالة: معرف_دالة_مسير,
    بداية_الالتقاطات: غير_موقع,
    عدد_الالتقاطات: غير_موقع
};

عام نوع ذاكرة_مفسر = {
    الصناديق: متجه اختيار قيمة_تشغيل,
    أجيال_الصناديق: متجه غير_موقع,
    تالي_الصندوق_الحر: متجه اختيار غير_موقع,
    رأس_الصناديق_الحرة: اختيار غير_موقع,
    العوام: متجه اختيار قيمة_تشغيل,
    الإغلاقات: متجه سجل_إغلاق_مفسر,
    التقاطات_الإغلاقات: متجه قيمة_تشغيل
};

عام نوع نتيجة_قراءة_ذاكرة_مفسر =
    | قيمة بنوع قيمة_تشغيل
    | أخفق بنوع فشل_تفسير_مسير
;

عام نوع نتيجة_كتابة_ذاكرة_مفسر =
    | نجحت
    | أخفق بنوع فشل_تفسير_مسير
;

عام عرف ذاكرة_مفسر_جديدة(): ذاكرة_مفسر {
    دع الصناديق: متجه اختيار قيمة_تشغيل = [];
    دع أجيال_الصناديق: متجه غير_موقع = [];
    دع تالي_الصندوق_الحر: متجه اختيار غير_موقع = [];
    دع العوام: متجه اختيار قيمة_تشغيل = [];
    دع الإغلاقات: متجه سجل_إغلاق_مفسر = [];
    دع التقاطات_الإغلاقات: متجه قيمة_تشغيل = [];
    دع الذاكرة: ذاكرة_مفسر = {
        الصناديق: الصناديق,
        أجيال_الصناديق: أجيال_الصناديق,
        تالي_الصندوق_الحر: تالي_الصندوق_الحر,
        رأس_الصناديق_الحرة: اختيار.لا_شيء(),
        العوام: العوام,
        الإغلاقات: الإغلاقات,
        التقاطات_الإغلاقات: التقاطات_الإغلاقات
    };
    أرجع الذاكرة;
}

عرف مؤشر_تفعيل_في_المكدس(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    التفعيل: معرف_تفعيل_مفسر
): اختيار غير_موقع {
    لو (عدد_الأطر > (الطول(*الأطر) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };

    // Activation IDs are issued monotonically and frames are pushed in issue order.
    // Popped frames are outside `عدد_الأطر`, so the live prefix stays strictly ordered.
    دع الأدنى: متغير غير_موقع = 0;
    دع الأعلى: متغير غير_موقع = عدد_الأطر;
    بينما (الأدنى < الأعلى) {
        دع الوسط: غير_موقع = الأدنى + ((الأعلى - الأدنى) / 2);
        دع الحالي: غير_موقع = (*الأطر)[الوسط].التفعيل.القيمة;
        لو (الحالي < التفعيل.القيمة) {
            الأدنى := الوسط + 1;
        } وإلا {
            الأعلى := الوسط;
        };
    }
    لو (الأدنى < عدد_الأطر) {
        لو (معرفا_تفعيل_مفسر_متساويان((*الأطر)[الأدنى].التفعيل, التفعيل)) {
            أرجع اختيار.بعض(الأدنى);
        };
    };
    أرجع اختيار.لا_شيء();
}

عرف اقرأ_إسقاطا(
    القيمة: &قيمة_تشغيل,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل,
    الموضع: غير_موقع
): نتيجة_قراءة_ذاكرة_مفسر {
    لو (الموضع >= (الطول(*الإسقاطات) مثل غير_موقع)) {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(القيمة);
        أرجع نتيجة_قراءة_ذاكرة_مفسر.قيمة(النسخة);
    };
    دع الفهرس: متغير غير_موقع = 0;
    طابق (*الإسقاطات)[الموضع] مع
    | إسقاط_مكان_تشغيل.حقل(ف) -> {
        الفهرس := ف;
    }
    | إسقاط_مكان_تشغيل.فهرس(ف) -> {
        الفهرس := ف;
    };
    طابق *القيمة مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        لو (الفهرس >= (الطول(الأعضاء) مثل غير_موقع)) {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
                )
            );
        };
        // Traverse the stored aggregate without deep-copying every intermediate member.
        // The leaf is copied exactly once by the base case to preserve value semantics.
        أرجع اقرأ_إسقاطا(&الأعضاء[الفهرس], الإسقاطات, الموضع + 1);
    }
    | _ -> {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
            )
        );
    };
}

عرف اكتب_إسقاطا(
    الأصل: &قيمة_تشغيل,
    الإسقاطات: &متجه إسقاط_مكان_تشغيل,
    الموضع: غير_موقع,
    الجديدة: قيمة_تشغيل
): نتيجة_قراءة_ذاكرة_مفسر {
    لو (الموضع >= (الطول(*الإسقاطات) مثل غير_موقع)) {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الجديدة);
        أرجع نتيجة_قراءة_ذاكرة_مفسر.قيمة(النسخة);
    };
    دع الفهرس: متغير غير_موقع = 0;
    طابق (*الإسقاطات)[الموضع] مع
    | إسقاط_مكان_تشغيل.حقل(ف) -> {
        الفهرس := ف;
    }
    | إسقاط_مكان_تشغيل.فهرس(ف) -> {
        الفهرس := ف;
    };
    طابق *الأصل مع
    | قيمة_تشغيل.تجميع(الأعضاء) -> {
        لو (الفهرس >= (الطول(الأعضاء) مثل غير_موقع)) {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
                )
            );
        };
        دع القيم: متغير متجه قيمة_تشغيل = [];
        دع ن: متغير غير_موقع = 0;
        بينما (ن < (الطول(الأعضاء) مثل غير_موقع)) {
            دع نسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&الأعضاء[ن]);
            ألحق(القيم, نسخة);
            ن := ن + 1;
        }
        // `القيم` already owns an independent copy of every sibling/member.
        // Recurse through that owned member directly instead of cloning the selected subtree twice.
        طابق اكتب_إسقاطا(&القيم[الفهرس], الإسقاطات, الموضع + 1, الجديدة) مع
        | نتيجة_قراءة_ذاكرة_مفسر.قيمة(المحدثة) -> {
            القيم[الفهرس] := المحدثة;
            أرجع نتيجة_قراءة_ذاكرة_مفسر.قيمة(قيمة_تشغيل.تجميع(القيم));
        }
        | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
            أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ);
        };
    }
    | _ -> {
        أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس)
            )
        );
    };
}

عام عرف هيئ_عام_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    المعرف: معرف_عام_مسير,
    القيمة: قيمة_تشغيل
): منطقي {
    بينما ((الطول((*الذاكرة).العوام) مثل غير_موقع) <= المعرف.القيمة) {
        ألحق((*الذاكرة).العوام, اختيار.لا_شيء());
    }
    طابق (*الذاكرة).العوام[المعرف.القيمة] مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
        (*الذاكرة).العوام[المعرف.القيمة] := اختيار.بعض(النسخة);
        أرجع صواب;
    };
}

عام عرف خصص_صندوق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    القيمة: قيمة_تشغيل
): معرف_صندوق_مفسر {
    دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
    طابق (*الذاكرة).رأس_الصناديق_الحرة مع
    | اختيار.لا_شيء -> {
        دع الموضع: غير_موقع = الطول((*الذاكرة).الصناديق) مثل غير_موقع;
        ألحق((*الذاكرة).الصناديق, اختيار.بعض(النسخة));
        ألحق((*الذاكرة).أجيال_الصناديق, 0);
        ألحق((*الذاكرة).تالي_الصندوق_الحر, اختيار.لا_شيء());
        أرجع معرف_صندوق_مفسر_من(الموضع, 0);
    }
    | اختيار.بعض(الموضع) -> {
        دع التالي: اختيار غير_موقع = (*الذاكرة).تالي_الصندوق_الحر[الموضع];
        دع الجيل: غير_موقع = (*الذاكرة).أجيال_الصناديق[الموضع] + 1;
        (*الذاكرة).رأس_الصناديق_الحرة := التالي;
        (*الذاكرة).أجيال_الصناديق[الموضع] := الجيل;
        (*الذاكرة).تالي_الصندوق_الحر[الموضع] := اختيار.لا_شيء();
        (*الذاكرة).الصناديق[الموضع] := اختيار.بعض(النسخة);
        أرجع معرف_صندوق_مفسر_من(الموضع, الجيل);
    };
}


عام عرف خصص_إغلاق_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    الدالة: معرف_دالة_مسير,
    الالتقاطات: &متجه قيمة_تشغيل
): معرف_إغلاق_مفسر {
    دع المعرف: معرف_إغلاق_مفسر = معرف_إغلاق_مفسر_من(
        الطول((*الذاكرة).الإغلاقات) مثل غير_موقع
    );
    دع البداية: غير_موقع = الطول((*الذاكرة).التقاطات_الإغلاقات) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الالتقاطات) مثل غير_موقع)) {
        دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&(*الالتقاطات)[ف]);
        ألحق((*الذاكرة).التقاطات_الإغلاقات, النسخة);
        ف := ف + 1;
    }
    دع عدد_الالتقاطات: غير_موقع = الطول(*الالتقاطات) مثل غير_موقع;
    دع السجل: سجل_إغلاق_مفسر = {
        الدالة: الدالة,
        بداية_الالتقاطات: البداية,
        عدد_الالتقاطات: عدد_الالتقاطات
    };
    ألحق((*الذاكرة).الإغلاقات, السجل);
    أرجع المعرف;
}

عام عرف دالة_إغلاق_مفسر_عند(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر
): اختيار معرف_دالة_مسير {
    لو (المعرف.القيمة >= (الطول((*الذاكرة).الإغلاقات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض((*الذاكرة).الإغلاقات[المعرف.القيمة].الدالة);
}

عام عرف التقاط_إغلاق_مفسر_عند(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_إغلاق_مفسر,
    الفهرس: غير_موقع
): اختيار قيمة_تشغيل {
    لو (المعرف.القيمة >= (الطول((*الذاكرة).الإغلاقات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع السجل: سجل_إغلاق_مفسر = (*الذاكرة).الإغلاقات[المعرف.القيمة];
    لو (الفهرس >= السجل.عدد_الالتقاطات) {
        أرجع اختيار.لا_شيء();
    };
    دع الموضع: غير_موقع = السجل.بداية_الالتقاطات + الفهرس;
    لو (الموضع >= (الطول((*الذاكرة).التقاطات_الإغلاقات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع القيمة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&(*الذاكرة).التقاطات_الإغلاقات[الموضع]);
    أرجع اختيار.بعض(القيمة);
}

عام عرف هوية_صندوق_مفسر_صالحة(
    الذاكرة: &ذاكرة_مفسر,
    المعرف: معرف_صندوق_مفسر
): منطقي {
    لو (المعرف.القيمة >= (الطول((*الذاكرة).الصناديق) مثل غير_موقع)) {
        أرجع خطأ;
    };
    لو (المعرف.القيمة >= (الطول((*الذاكرة).أجيال_الصناديق) مثل غير_موقع)) {
        أرجع خطأ;
    };
    لو ((*الذاكرة).أجيال_الصناديق[المعرف.القيمة] != المعرف.الجيل) {
        أرجع خطأ;
    };
    طابق (*الذاكرة).الصناديق[المعرف.القيمة] مع
    | اختيار.بعض(_) -> {
        أرجع صواب;
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

عام عرف هوية_مكان_مفسر_صالحة(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    المكان: &مكان_تشغيل
): منطقي {
    دع الموضع: مكان_تشغيل = *المكان;
    طابق الموضع.الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
        | اختيار.لا_شيء -> {
            أرجع خطأ;
        }
        | اختيار.بعض(فهرس_الإطار) -> {
            دع الإطار: &إطار_تفسير_مسير = &(*الأطر)[فهرس_الإطار];
            أرجع الخلية.القيمة < (الطول((*الإطار).المحليات) مثل غير_موقع);
        };
    }
    | جذر_مكان_تشغيل.عام(المعرف) -> {
        لو (المعرف.القيمة >= (الطول((*الذاكرة).العوام) مثل غير_موقع)) { أرجع خطأ; };
        طابق (*الذاكرة).العوام[المعرف.القيمة] مع
        | اختيار.بعض(_) -> { أرجع صواب; }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        أرجع هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف);
    };
}

عام عرف اقرأ_مكان_مفسر(
    الأطر: &متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &ذاكرة_مفسر,
    المكان: &مكان_تشغيل
): نتيجة_قراءة_ذاكرة_مفسر {
    دع الموضع: مكان_تشغيل = *المكان;
    طابق الموضع مع
    | { الجذر: الجذر, الإسقاطات: الإسقاطات, قابل_للكتابة: _ } -> {
        طابق الجذر مع
        | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
            طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                );
            }
            | اختيار.بعض(فهرس_الإطار) -> {
                دع الإطار: &إطار_تفسير_مسير = &(*الأطر)[فهرس_الإطار];
                لو (الخلية.القيمة >= (الطول((*الإطار).المحليات) مثل غير_موقع)) {
                    أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                        فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                    );
                };
                طابق (*الإطار).المحليات[الخلية.القيمة] مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                        فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                    );
                }
                | اختيار.بعض(القيمة) -> {
                    أرجع اقرأ_إسقاطا(&القيمة, &الإسقاطات, 0);
                };
            };
        }
        | جذر_مكان_تشغيل.عام(المعرف) -> {
            لو (المعرف.القيمة >= (الطول((*الذاكرة).العوام) مثل غير_موقع)) {
                أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف()));
            };
            طابق (*الذاكرة).العوام[المعرف.القيمة] مع
            | اختيار.لا_شيء -> { أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())); }
            | اختيار.بعض(القيمة) -> { أرجع اقرأ_إسقاطا(&القيمة, &الإسقاطات, 0); };
        }
        | جذر_مكان_تشغيل.صندوق(المعرف) -> {
            لو (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) {
                أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                    )
                );
            };
            طابق (*الذاكرة).الصناديق[المعرف.القيمة] مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_قراءة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                    )
                );
            }
            | اختيار.بعض(القيمة) -> {
                أرجع اقرأ_إسقاطا(&القيمة, &الإسقاطات, 0);
            };
        };
    };
}

عام عرف اكتب_مكان_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &متغير ذاكرة_مفسر,
    المكان: &مكان_تشغيل,
    القيمة: قيمة_تشغيل
): نتيجة_كتابة_ذاكرة_مفسر {
    دع الموضع: مكان_تشغيل = *المكان;
    طابق الموضع مع
    | { الجذر: الجذر, الإسقاطات: الإسقاطات, قابل_للكتابة: قابل_للكتابة } -> {
        لو (!قابل_للكتابة) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط()
                )
            );
        };
        طابق الجذر مع
        | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
            طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                );
            }
            | اختيار.بعض(فهرس_الإطار) -> {
                دع الإطار: &متغير إطار_تفسير_مسير = &متغير (*الأطر)[فهرس_الإطار];
                لو (الخلية.القيمة >= (الطول((*الإطار).المحليات) مثل غير_موقع)) {
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                        فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                    );
                };
                طابق (*الإطار).المحليات[الخلية.القيمة] مع
                | اختيار.لا_شيء -> {
                    لو ((الطول(الإسقاطات) مثل غير_موقع) != 0) {
                        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                        );
                    };
                    دع النسخة: قيمة_تشغيل = انسخ_قيمة_تشغيل(&القيمة);
                    (*الإطار).المحليات[الخلية.القيمة] := اختيار.بعض(النسخة);
                }
                | اختيار.بعض(الأصل) -> {
                    طابق اكتب_إسقاطا(&الأصل, &الإسقاطات, 0, القيمة) مع
                    | نتيجة_قراءة_ذاكرة_مفسر.قيمة(المحدثة) -> {
                        (*الإطار).المحليات[الخلية.القيمة] := اختيار.بعض(المحدثة);
                    }
                    | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
                        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ);
                    };
                };
                أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
            };
        }
        | جذر_مكان_تشغيل.عام(المعرف) -> {
            لو (المعرف.القيمة >= (الطول((*الذاكرة).العوام) مثل غير_موقع)) {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف()));
            };
            طابق (*الذاكرة).العوام[المعرف.القيمة] مع
            | اختيار.لا_شيء -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())); }
            | اختيار.بعض(الأصل) -> {
                طابق اكتب_إسقاطا(&الأصل, &الإسقاطات, 0, القيمة) مع
                | نتيجة_قراءة_ذاكرة_مفسر.قيمة(المحدثة) -> {
                    (*الذاكرة).العوام[المعرف.القيمة] := اختيار.بعض(المحدثة);
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
                }
                | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> { أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ); };
            };
        }
        | جذر_مكان_تشغيل.صندوق(المعرف) -> {
            لو (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                    )
                );
            };
            طابق (*الذاكرة).الصناديق[المعرف.القيمة] مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                    )
                );
            }
            | اختيار.بعض(الأصل) -> {
                طابق اكتب_إسقاطا(&الأصل, &الإسقاطات, 0, القيمة) مع
                | نتيجة_قراءة_ذاكرة_مفسر.قيمة(المحدثة) -> {
                    (*الذاكرة).الصناديق[المعرف.القيمة] := اختيار.بعض(المحدثة);
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
                }
                | نتيجة_قراءة_ذاكرة_مفسر.أخفق(الخطأ) -> {
                    أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(الخطأ);
                };
            };
        };
    };
}

// Release an Interpreter-owned storage root. Release is semantic here: no target layout or host pointer is exposed.
عام عرف حرر_مكان_مفسر(
    الأطر: &متغير متجه إطار_تفسير_مسير,
    عدد_الأطر: غير_موقع,
    الذاكرة: &متغير ذاكرة_مفسر,
    المكان: &مكان_تشغيل
): نتيجة_كتابة_ذاكرة_مفسر {
    دع الموضع: مكان_تشغيل = *المكان;
    لو ((الطول(الموضع.الإسقاطات) مثل غير_موقع) != 0) {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
        );
    };
    لو (!الموضع.قابل_للكتابة) {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
            فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط()
            )
        );
    };
    طابق الموضع.الجذر مع
    | جذر_مكان_تشغيل.محلي(التفعيل, الخلية) -> {
        طابق مؤشر_تفعيل_في_المكدس(الأطر, عدد_الأطر, التفعيل) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
            );
        }
        | اختيار.بعض(فهرس_الإطار) -> {
            دع الإطار: &متغير إطار_تفسير_مسير = &متغير (*الأطر)[فهرس_الإطار];
            لو (الخلية.القيمة >= (الطول((*الإطار).المحليات) مثل غير_موقع)) {
                أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                    فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
                );
            };
            (*الإطار).المحليات[الخلية.القيمة] := اختيار.لا_شيء();
            أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
        };
    }
    | جذر_مكان_تشغيل.عام(_) -> {
        أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف()));
    }
    | جذر_مكان_تشغيل.صندوق(المعرف) -> {
        لو (!هوية_صندوق_مفسر_صالحة(الذاكرة, المعرف)) {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                )
            );
        };
        طابق (*الذاكرة).الصناديق[المعرف.القيمة] مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_كتابة_ذاكرة_مفسر.أخفق(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.صندوق_تالف(المعرف.القيمة)
                )
            );
        }
        | اختيار.بعض(_) -> {
            // Keep the slot generation, link the released slot into the O(1) free list,
            // and require the next allocation to advance the generation before reuse.
            (*الذاكرة).الصناديق[المعرف.القيمة] := اختيار.لا_شيء();
            (*الذاكرة).تالي_الصندوق_الحر[المعرف.القيمة] := (*الذاكرة).رأس_الصناديق_الحرة;
            (*الذاكرة).رأس_الصناديق_الحرة := اختيار.بعض(المعرف.القيمة);
            أرجع نتيجة_كتابة_ذاكرة_مفسر.نجحت();
        };
    };
}
