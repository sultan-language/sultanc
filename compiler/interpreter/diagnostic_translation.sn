عرف أضف_سبب_مفسر(التشخيص: &متغير تشخيص, السبب: سبب_تشخيص): فراغ {
    دع أضيف: منطقي = أضف_سبب_تشخيص(التشخيص, السبب
    );
}

عرف أضف_قيمة_مفسر(التشخيص: &متغير تشخيص, القيمة: معرف_قيمة_مسير): فراغ {
    دع أضيف: منطقي = أضف_حجة_طبيعية(
        التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة
    );
}

عرف أضف_بدائي_مفسر(التشخيص: &متغير تشخيص, البدائي: هوية_بدائي_مترجم): فراغ {
    دع النص: نص = نص_هوية_بدائي_تشخيصية(البدائي);
    دع أضيف: منطقي = أضف_حجة_تشخيص(
        التشخيص, مفتاح_حجة_تشخيص.البدائي(), النص
    );
}


عرف أصل_مصدر_لموقع_فشل_تفسير(
    الموقع: &موقع_فشل_تفسير_مسير,
    التصحيح: &بيانات_تصحيح_مسير
): اختياري معرف_أصل_مصدر {
    طابق (*الموقع).الأصل مع
    | اختياري.موجود(الأصل) -> { أرجع اختياري.موجود(الأصل); }
    | اختياري.لا_شيء -> { };

    طابق (*الموقع).موقع_التصحيح مع
    | اختياري.موجود(معرف_الموقع) -> {
        لو (معرف_الموقع.القيمة < (الطول((*التصحيح).الدلالي.المواقع) مثل طبيعي)) {
            أرجع اختياري.موجود((*التصحيح).الدلالي.المواقع[معرف_الموقع.القيمة].الأصل);
        };
    }
    | اختياري.لا_شيء -> { };

    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, (*الموقع).الدالة) مع
    | اختياري.موجود(معرف_الدالة) -> {
        لو (معرف_الدالة.القيمة < (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) {
            أرجع اختياري.موجود((*التصحيح).الدلالي.الدوال[معرف_الدالة.القيمة].الأصل);
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عرف مصدر_تشخيص_لفشل_تفسير(
    الفشل: &فشل_تفسير_موضعي,
    المصادر: &خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير
): اختياري نطاق_مصدر_تشخيص {
    دع معرف_الأصل: معرف_أصل_مصدر;
    طابق (*الفشل).الموقع مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموقع) -> {
        طابق أصل_مصدر_لموقع_فشل_تفسير(&الموقع, التصحيح) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الأصل) -> { معرف_الأصل := الأصل; };
    };

    دع نطاق_الفشل: نطاق;
    طابق أصل_مصدر_بالمعرف(الأصول, معرف_الأصل) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأصل) -> { نطاق_الفشل := الأصل.النطاق; };

    دع معرف_المصدر: طبيعي = نطاق_الفشل.البداية.المصدر;
    لو (معرف_المصدر >= (الطول((*المصادر).المصادر) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    لو ((*المصادر).المصادر[معرف_المصدر].المعرف != معرف_المصدر) {
        أرجع اختياري.لا_شيء();
    };
    دع المقتطف: اختياري نص = مقتطف_من_الخريطة(المصادر, &نطاق_الفشل);
    دع المصدر: نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_من_مصدر(
        نطاق_الفشل,
        &(*المصادر).المصادر[معرف_المصدر],
        المقتطف
    );
    أرجع اختياري.موجود(المصدر);
}


عرف معرف_تشخيص_خطأ_وقت_تشغيل_مفسر(
    الخطأ: &خطأ_وقت_تشغيل_مفسر
): معرف_تشخيص {
    طابق *الخطأ مع
    | خطأ_وقت_تشغيل_مفسر.إزاحة_غير_صالحة(_, _, _) -> { أرجع معرف_تشخيص.فهرس_تفسير_خارج_الحدود(); }
    | خطأ_وقت_تشغيل_مفسر.فهرس_سالب(_) -> { أرجع معرف_تشخيص.فهرس_تفسير_خارج_الحدود(); }
    | خطأ_وقت_تشغيل_مفسر.فهرس_خارج_المدى(_, _, _) -> { أرجع معرف_تشخيص.فهرس_تفسير_خارج_الحدود(); }
    | خطأ_وقت_تشغيل_مفسر.حمولة_موسومة_خارج_المدى(_, _) -> { أرجع معرف_تشخيص.فهرس_تفسير_خارج_الحدود(); }
    | خطأ_وقت_تشغيل_مفسر.خانة_غير_مهيأة(_) -> { أرجع معرف_تشخيص.حالة_تفسير_غير_صالحة(); }
    | خطأ_وقت_تشغيل_مفسر.خانة_ليست_قيمة(_) -> { أرجع معرف_تشخيص.حالة_تفسير_غير_صالحة(); }
    | خطأ_وقت_تشغيل_مفسر.خانة_ليست_مكانا(_) -> { أرجع معرف_تشخيص.حالة_تفسير_غير_صالحة(); }
    | خطأ_وقت_تشغيل_مفسر.مكان_للقراءة_فقط(_) -> { أرجع معرف_تشخيص.حالة_تفسير_غير_صالحة(); }
    | خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط -> { أرجع معرف_تشخيص.حالة_تفسير_غير_صالحة(); }
    | خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف -> { أرجع معرف_تشخيص.ذاكرة_تفسير_تالفة(); }
    | خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(_) -> { أرجع معرف_تشخيص.ذاكرة_تفسير_تالفة(); }
    | خطأ_وقت_تشغيل_مفسر.مرجع_تالف(_) -> { أرجع معرف_تشخيص.ذاكرة_تفسير_تالفة(); }
    | خطأ_وقت_تشغيل_مفسر.صندوق_تالف(_) -> { أرجع معرف_تشخيص.ذاكرة_تفسير_تالفة(); }
    | خطأ_وقت_تشغيل_مفسر.قيمة_صندوق_متوقعة(_) -> { أرجع معرف_تشخيص.نوع_قيمة_تفسير_غير_متوقع(); }
    | خطأ_وقت_تشغيل_مفسر.قيمة_صحيح_متوقعة(_) -> { أرجع معرف_تشخيص.نوع_قيمة_تفسير_غير_متوقع(); }
    | خطأ_وقت_تشغيل_مفسر.قيمة_تجميع_متوقعة(_) -> { أرجع معرف_تشخيص.نوع_قيمة_تفسير_غير_متوقع(); }
    | خطأ_وقت_تشغيل_مفسر.قيمة_نص_متوقعة(_) -> { أرجع معرف_تشخيص.نوع_قيمة_تفسير_غير_متوقع(); }
    | خطأ_وقت_تشغيل_مفسر.قيمة_موسومة_متوقعة(_) -> { أرجع معرف_تشخيص.نوع_قيمة_تفسير_غير_متوقع(); }
    | خطأ_وقت_تشغيل_مفسر.منشئ_موسوم_غير_مطابق(_, _) -> { أرجع معرف_تشخيص.نوع_قيمة_تفسير_غير_متوقع(); }
    | خطأ_وقت_تشغيل_مفسر.قيمة_منطقية_متوقعة(_) -> { أرجع معرف_تشخيص.نوع_قيمة_تفسير_غير_متوقع(); }
    | خطأ_وقت_تشغيل_مفسر.نص_يوتيف8_غير_صالح(_, _) -> { أرجع معرف_تشخيص.نص_تفسير_غير_صالح(); }
    | خطأ_وقت_تشغيل_مفسر.عدد_حجج_بدائي_غير_متسق(_, _, _) -> { أرجع معرف_تشخيص.عدد_حجج_بدائي_تفسير_غير_مطابق(); }
    | خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(_, _) -> { أرجع معرف_تشخيص.حجة_بدائي_تفسير_غير_صالحة(); }
    | خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(_) -> { أرجع معرف_تشخيص.فشل_تفسير_وقت_تشغيل(); }
    | خطأ_وقت_تشغيل_مفسر.نداء_خارجي_غير_مدعوم(_, _) -> { أرجع معرف_تشخيص.فشل_تفسير_وقت_تشغيل(); }
    | خطأ_وقت_تشغيل_مفسر.نداء_خارجي_ديناميكي_متعذر(_, _, _, _, _) -> { أرجع معرف_تشخيص.نداء_خارجي_تفسير_غير_مدعوم(); }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_الحد -> { أرجع معرف_تشخيص.فشل_تفسير_وقت_تشغيل(); }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع -> { أرجع معرف_تشخيص.فشل_تفسير_وقت_تشغيل(); }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_حجة_غير_ثابتة -> { أرجع معرف_تشخيص.فشل_تفسير_وقت_تشغيل(); }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_نتيجة_غير_ثابتة -> { أرجع معرف_تشخيص.فشل_تفسير_وقت_تشغيل(); }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_عمق_النداء -> { أرجع معرف_تشخيص.فشل_تفسير_وقت_تشغيل(); }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_فشل_مطلوب(_) -> { أرجع معرف_تشخيص.فشل_تفسير_وقت_تشغيل(); }
    | خطأ_وقت_تشغيل_مفسر.تجاوز_عمق_النداء(_) -> { أرجع معرف_تشخيص.فشل_تفسير_وقت_تشغيل(); }
    ;
}

عرف أضف_خطأ_وقت_تشغيل_مفسر(
    التشخيص: &متغير تشخيص,
    الخطأ: &خطأ_وقت_تشغيل_مفسر
): فراغ {
    طابق *الخطأ مع
    | خطأ_وقت_تشغيل_مفسر.إزاحة_غير_صالحة(القيمة, الإزاحة, الطول) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_غير_صحيح_إزاحة());
        أضف_قيمة_مفسر(التشخيص, القيمة);
        دع أضف_إزاحة: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الإزاحة);
        دع أضف_طول: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول);
    }
    | خطأ_وقت_تشغيل_مفسر.فهرس_سالب(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_سالب_فهرس());
        أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.فهرس_خارج_المدى(القيمة, الفهرس, الطول) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_فهرس_خارج_من_نطاق());
        أضف_قيمة_مفسر(التشخيص, القيمة);
        دع أضف_فهرس: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
        دع أضف_طول: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول);
    }
    | خطأ_وقت_تشغيل_مفسر.خانة_غير_مهيأة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_غير_مهيأ_خانة()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.خانة_ليست_قيمة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_خانة_ليس_قيمة()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.خانة_ليست_مكانا(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_خانة_ليس_موضع()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.مكان_للقراءة_فقط(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_قراءة_فقط_موضع()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_كتابة_قراءة_فقط_موضع());
    }
    | خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_تالف_موضع_جذر());
    }
    | خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_تالف_موضع_إسقاط());
        دع أضف_فهرس: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_وقت_تشغيل_مفسر.مرجع_تالف(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_تالف_مرجع()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.صندوق_تالف(الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_تالف_صندوق());
        دع أضف_فهرس: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_صندوق_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_متوقع_صندوق_قيمة()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_صحيح_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_متوقع_صحيح_قيمة()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_تجميع_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_متوقع_مركب_قيمة()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_نص_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_متوقع_نص_قيمة()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_موسومة_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_متوقع_موسوم_قيمة()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.منشئ_موسوم_غير_مطابق(المتوقع, الموجود) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_موسوم_منشئ_عدم_تطابق());
        دع أ1: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع);
        دع أ2: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
    }
    | خطأ_وقت_تشغيل_مفسر.حمولة_موسومة_خارج_المدى(الفهرس, الطول) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_موسوم_حمولة_خارج_من_نطاق());
        دع أ1: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
        دع أ2: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_منطقية_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_متوقع_منطقي_قيمة()); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.نص_يوتيف8_غير_صالح(القيمة, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_غير_صحيح_يوتيف8()); أضف_قيمة_مفسر(التشخيص, القيمة);
        دع أضف_فهرس: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_وقت_تشغيل_مفسر.عدد_حجج_بدائي_غير_متسق(البدائي, المتوقع, الموجود) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_بدائي_حجة_عدد_عدم_تطابق()); أضف_بدائي_مفسر(التشخيص, البدائي);
        دع أ1: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع);
        دع أ2: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
    }
    | خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(البدائي, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_غير_صحيح_بدائي_حجة()); أضف_بدائي_مفسر(التشخيص, البدائي);
        دع أضف_فهرس: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(البدائي) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_غير_مدعوم_آلة_بدائي());
        أضف_بدائي_مفسر(التشخيص, البدائي);
    }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_الحد -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_وقت_الترجمة_نفاد_ميزانية_التعليمات());
    }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_وقت_الترجمة_أثر_ممنوع());
    }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_حجة_غير_ثابتة -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_وقت_الترجمة_حجة_غير_ثابتة());
    }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_نتيجة_غير_ثابتة -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_وقت_الترجمة_نتيجة_تهرب_من_المقيم());
    }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_عمق_النداء -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_وقت_الترجمة_تجاوز_عمق_الاستدعاء());
    }
    | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_فشل_مطلوب(الرسالة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_وقت_الترجمة_فشل_مطلوب());
        دع نص_الرسالة: نص = من_بايتات(&الرسالة);
        دع أضيفت_الرسالة: منطقي = أضف_حجة_تشخيص(
            التشخيص, مفتاح_حجة_تشخيص.القيمة(), نص_الرسالة
        );
    }
    | خطأ_وقت_تشغيل_مفسر.تجاوز_عمق_النداء(_) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_تجاوز_عمق_النداء());
    }
    | خطأ_وقت_تشغيل_مفسر.نداء_خارجي_غير_مدعوم(الدالة, الاسم) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_غير_مدعوم_خارجي_استدعاء());
        دع أضف_دالة: منطقي = أضف_حجة_طبيعية(
            التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة
        );
        دع اسم_الدالة: نص = من_بايتات(&الاسم);
        دع أضف_هدف: منطقي = أضف_حجة_تشخيص(
            التشخيص, مفتاح_حجة_تشخيص.الهدف(), اسم_الدالة
        );
    }
    | خطأ_وقت_تشغيل_مفسر.نداء_خارجي_ديناميكي_متعذر(_, الاسم, السبب, المكتبة, الرسالة) -> {
        طابق السبب مع
        | سبب_تعذر_نداء_خارجي_مفسر.لا_محمل_ديناميكي -> {
            أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_لا_محمل_ديناميكي());
        }
        | سبب_تعذر_نداء_خارجي_مفسر.مكتبة_غير_محملة -> {
            أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_مكتبة_خارجية_غير_محملة());
        }
        | سبب_تعذر_نداء_خارجي_مفسر.رمز_غير_موجود -> {
            أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_رمز_خارجي_غير_موجود());
        }
        | سبب_تعذر_نداء_خارجي_مفسر.توقيع_غير_مدعوم -> {
            أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_وقت_تشغيل_توقيع_خارجي_غير_مدعوم());
        };
        دع اسم_الدالة: نص = من_بايتات(&الاسم);
        دع أضف_رمز: منطقي = أضف_حجة_تشخيص(
            التشخيص, مفتاح_حجة_تشخيص.الرمز(), اسم_الدالة
        );
        لو ((الطول(المكتبة) مثل طبيعي) > 0) {
            دع نص_المكتبة: نص = من_بايتات(&المكتبة);
            دع أضف_مكتبة: منطقي = أضف_حجة_تشخيص(
                التشخيص, مفتاح_حجة_تشخيص.المسار(), نص_المكتبة
            );
        };
        لو ((الطول(الرسالة) مثل طبيعي) > 0) {
            دع نص_الرسالة: نص = من_بايتات(&الرسالة);
            دع أضف_رسالة: منطقي = أضف_حجة_تشخيص(
                التشخيص, مفتاح_حجة_تشخيص.القيمة(), نص_الرسالة
            );
        };
    };
}

عرف أضف_خلل_داخلي_مفسر(
    التشخيص: &متغير تشخيص,
    الخطأ: &خلل_داخلي_مفسر
): فراغ {
    طابق *الخطأ مع
    | خلل_داخلي_مفسر.دالة_مفقودة(الدالة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_دالة());
        دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خلل_داخلي_مفسر.كتلة_مفقودة(الكتلة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_كتلة());
        دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خلل_داخلي_مفسر.تعليمة_مفقودة(الكتلة, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_تعليمة());
        دع أ1: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        دع أ2: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.التعليمة(), الفهرس);
    }
    | خلل_داخلي_مفسر.منهي_مفقود(الكتلة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_منه());
        دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خلل_داخلي_مفسر.قيمة_مسير_مفقودة(القيمة) -> { أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_مسير_قيمة()); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.معرف_خانة_من_دالة_أخرى(الدالة, القيمة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_خانة_من_آخر_دالة()); أضف_قيمة_مفسر(التشخيص, القيمة);
        دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خلل_داخلي_مفسر.معرف_خانة_خارج_المدى(القيمة) -> { أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_خانة_معرف_خارج_من_نطاق()); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.معامل_دالة_مفقود(الدالة, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_دالة_معامل());
        دع أ1: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
        دع أ2: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خلل_داخلي_مفسر.معامل_كتلة_مفقود(الكتلة, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_كتلة_معامل());
        دع أ1: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        دع أ2: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خلل_داخلي_مفسر.عدد_حجج_غير_متسق(المتوقع, الموجود) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_حجة_عدد_عدم_تطابق());
        دع أ1: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع);
        دع أ2: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
    }
    | خلل_داخلي_مفسر.مدخل_دالة_مفقود(الدالة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_دالة_دخول());
        دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خلل_داخلي_مفسر.مكدس_نداءات_فارغ -> { أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_فارغ_استدعاء_مكدس()); }
    | خلل_داخلي_مفسر.تفعيل_مفقود(التفعيل) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_تفعيل());
        دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.القيمة(), التفعيل);
    }
    | خلل_داخلي_مفسر.شكل_إرجاع_غير_متسق(الدالة) -> {
        أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_إرجاع_بنية_عدم_تطابق());
        دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خلل_داخلي_مفسر.نوع_صحيح_مفقود(القيمة) -> { أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_صحيح_نوع()); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.نوع_عشري_مفقود(القيمة) -> { أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_عائم_نوع()); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.نوع_فهرسة_غير_متسق(القيمة) -> { أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_فهرس_نوع_عدم_تطابق()); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.نوع_مرجع_غير_متسق(القيمة) -> { أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مرجع_نوع_عدم_تطابق()); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة -> { أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_مفقود_تعليمة_نتيجة()); }
    | خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة -> { أضف_سبب_مفسر(التشخيص, سبب_تشخيص.سبب_مفسر_داخلي_غير_متوقع_تعليمة_نتيجة()); };
}

// Interpreter owns failure facts. Diagnostics alone owns their user/machine presentation.
عام عرف حول_فشل_تفسير_مسير_إلى_تشخيصات(
    الفشل: &فشل_تفسير_موضعي,
    المصادر: &خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص;
    دع المصدر: اختياري نطاق_مصدر_تشخيص = مصدر_تشخيص_لفشل_تفسير(
        الفشل, المصادر, الأصول, التصحيح
    );
    طابق (*الفشل).الفشل مع
    | فشل_تفسير_مسير.وقت_تشغيل(الخطأ) -> {
        دع معرف_التشخيص: معرف_تشخيص = معرف_تشخيص_خطأ_وقت_تشغيل_مفسر(&الخطأ);
        التشخيص := ابدأ_تشخيصا(
            معرف_التشخيص, المصدر
        );
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «interpreter»
        );
        أضف_خطأ_وقت_تشغيل_مفسر(&متغير التشخيص, &الخطأ);
    }
    | فشل_تفسير_مسير.فخ_مسير(الدالة, الكتلة) -> {
        التشخيص := ابدأ_تشخيصا(
            معرف_تشخيص.فخ_تفسير(), المصدر
        );
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «interpreter»
        );
        أضف_سبب_مفسر(&متغير التشخيص, سبب_تشخيص.سبب_مفسر_فخ());
        دع أضف_دالة: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة
        );
        دع أضف_كتلة: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة
        );
    }
    | فشل_تفسير_مسير.خلل_داخلي(الخطأ) -> {
        التشخيص := ابدأ_تشخيصا(
            معرف_تشخيص.فشل_مترجم_داخلي(), المصدر
        );
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «interpreter»
        );
        أضف_خلل_داخلي_مفسر(&متغير التشخيص, &الخطأ);
        دع بلا_حجج: متجه حجة_تشخيص = [];
        دع أضف_مساعدة_خلل: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_أبلغ_عن_خلل_المترجم(),
            بلا_حجج
        );
    };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}
