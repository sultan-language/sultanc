استورد std.text.from_bytes;
استورد compiler.msir.identifiers;
استورد compiler.runtime.primitive_identity;
استورد compiler.source.provenance;
استورد compiler.debuginfo.model;

// Interpreter failures are structured facts only. Generic bilingual wording remains owned by diagnostics/.
عام نوع خطأ_وقت_تشغيل_مفسر =
    | إزاحة_غير_صالحة بنوع (معرف_قيمة_مسير, طبيعي, طبيعي)
    | فهرس_سالب بنوع معرف_قيمة_مسير
    | فهرس_خارج_المدى بنوع (معرف_قيمة_مسير, طبيعي, طبيعي)
    | خانة_غير_مهيأة بنوع معرف_قيمة_مسير
    | خانة_ليست_قيمة بنوع معرف_قيمة_مسير
    | خانة_ليست_مكانا بنوع معرف_قيمة_مسير
    | مكان_للقراءة_فقط بنوع معرف_قيمة_مسير
    | محاولة_كتابة_مكان_للقراءة_فقط
    | جذر_مكان_تالف
    | إسقاط_مكان_تالف بنوع طبيعي
    | مرجع_تالف بنوع معرف_قيمة_مسير
    | صندوق_تالف بنوع طبيعي
    | قيمة_صندوق_متوقعة بنوع معرف_قيمة_مسير
    | قيمة_صحيح_متوقعة بنوع معرف_قيمة_مسير
    | قيمة_تجميع_متوقعة بنوع معرف_قيمة_مسير
    | قيمة_نص_متوقعة بنوع معرف_قيمة_مسير
    | قيمة_موسومة_متوقعة بنوع معرف_قيمة_مسير
    | منشئ_موسوم_غير_مطابق بنوع (طبيعي, طبيعي)
    | حمولة_موسومة_خارج_المدى بنوع (طبيعي, طبيعي)
    | قيمة_منطقية_متوقعة بنوع معرف_قيمة_مسير
    | عدد_حجج_بدائي_غير_متسق بنوع (هوية_بدائي_مترجم, طبيعي, طبيعي)
    | حجة_بدائي_غير_صالحة بنوع (هوية_بدائي_مترجم, طبيعي)
    | بدائي_آلة_غير_مدعوم بنوع هوية_بدائي_مترجم
    | نداء_خارجي_غير_مدعوم بنوع (معرف_دالة_خارجية_مسير, متجه ط8)
    // An extern found at run time (the foreign-call bridge's dynamic
    // symbols) could not be called: the extern, its name, why, the library
    // it names (empty for none) and what the host loader reported.
    | نداء_خارجي_ديناميكي_متعذر بنوع (معرف_دالة_خارجية_مسير, متجه ط8, سبب_تعذر_نداء_خارجي_مفسر, متجه ط8, تفصيل_محمل_مفسر)
    | وقت_الترجمة_تجاوز_الحد
    | وقت_الترجمة_أثر_ممنوع
    | وقت_الترجمة_حجة_غير_ثابتة
    | وقت_الترجمة_نتيجة_غير_ثابتة
    | وقت_الترجمة_تجاوز_عمق_النداء
    // A compile-time failure requested by the program, with its message.
    | وقت_الترجمة_فشل_مطلوب بنوع متجه ط8
    // Run time: the call stack reached the interpreter's frame limit (the
    // limit is the payload). A native program overflows its machine stack
    // here; the interpreter reports it instead of exhausting host memory.
    | تجاوز_عمق_النداء بنوع طبيعي
;

عام نوع سبب_تعذر_نداء_خارجي_مفسر =
    // The compiler has no dynamic loader (a static Linux executable).
    | لا_محمل_ديناميكي
    // The library the declaration names could not be loaded.
    | مكتبة_غير_محملة
    // The library (or the global scope) has no such function.
    | رمز_غير_موجود
    // A record passed or returned by value, another Type with no C word, or
    // more words than the register image holds.
    | توقيع_غير_مدعوم
;

// What the host's dynamic loader reported about a library it could not load.
عام نوع تفصيل_محمل_مفسر =
    | بلا_تفصيل
    // The loader's own message (dlerror on Unix hosts).
    | رسالة_المحمل بنوع متجه ط8
    // The system's error code (GetLastError on Windows).
    | رمز_خطأ_النظام بنوع طبيعي
;

عام عرف انسخ_تفصيل_محمل_مفسر(التفصيل: &تفصيل_محمل_مفسر): تفصيل_محمل_مفسر {
    طابق *التفصيل مع
    | تفصيل_محمل_مفسر.بلا_تفصيل -> { أرجع تفصيل_محمل_مفسر.بلا_تفصيل(); }
    | تفصيل_محمل_مفسر.رسالة_المحمل(الرسالة) -> { أرجع تفصيل_محمل_مفسر.رسالة_المحمل(انسخ_بايتات(&الرسالة)); }
    | تفصيل_محمل_مفسر.رمز_خطأ_النظام(الرمز) -> { أرجع تفصيل_محمل_مفسر.رمز_خطأ_النظام(الرمز); };
}

عام نوع خلل_داخلي_مفسر =
    | دالة_مفقودة بنوع معرف_دالة_مسير
    | كتلة_مفقودة بنوع معرف_كتلة_مسير
    | تعليمة_مفقودة بنوع (معرف_كتلة_مسير, طبيعي)
    | منهي_مفقود بنوع معرف_كتلة_مسير
    | قيمة_مسير_مفقودة بنوع معرف_قيمة_مسير
    | معرف_خانة_من_دالة_أخرى بنوع (معرف_دالة_مسير, معرف_قيمة_مسير)
    | معرف_خانة_خارج_المدى بنوع معرف_قيمة_مسير
    | معامل_دالة_مفقود بنوع (معرف_دالة_مسير, طبيعي)
    | معامل_كتلة_مفقود بنوع (معرف_كتلة_مسير, طبيعي)
    | عدد_حجج_غير_متسق بنوع (طبيعي, طبيعي)
    | مدخل_دالة_مفقود بنوع معرف_دالة_مسير
    | مكدس_نداءات_فارغ
    | تفعيل_مفقود بنوع طبيعي
    | شكل_إرجاع_غير_متسق بنوع معرف_دالة_مسير
    | نوع_صحيح_مفقود بنوع معرف_قيمة_مسير
    | نوع_عشري_مفقود بنوع معرف_قيمة_مسير
    | نوع_فهرسة_غير_متسق بنوع معرف_قيمة_مسير
    | نوع_مرجع_غير_متسق بنوع معرف_قيمة_مسير
    | نتيجة_تعليمة_مفقودة
    | نتيجة_تعليمة_غير_متوقعة
;

عام نوع فشل_تفسير_مسير =
    | وقت_تشغيل بنوع خطأ_وقت_تشغيل_مفسر
    | فخ_مسير بنوع (معرف_دالة_مسير, معرف_كتلة_مسير)
    | خلل_داخلي بنوع خلل_داخلي_مفسر
;

// A failure site is a compact MSIR execution location. Source/debug owners stay
// outside the interpreter and resolve these canonical identities for diagnostics.
عام نوع موقع_فشل_تفسير_مسير = {
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    التعليمة: اختياري طبيعي,
    الأصل: اختياري معرف_أصل_مصدر,
    موقع_التصحيح: اختياري معرف_موقع_تصحيح
};

عام نوع فشل_تفسير_موضعي = {
    الفشل: فشل_تفسير_مسير,
    الموقع: اختياري موقع_فشل_تفسير_مسير,
    // Compile-time evaluation only: the call sites of the frames around the
    // failing one, innermost first, and the instructions it executed.
    النداءات: متجه موقع_فشل_تفسير_مسير,
    المنفذ: طبيعي
};
