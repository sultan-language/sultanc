استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.diagnostics.runtime_failures;
استورد compiler.interpreter.execution.execution_state;
استورد compiler.interpreter.execution.calls;
استورد compiler.interpreter.operations.operations;
استورد compiler.interpreter.execution.control_flow;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_consumer;
استورد compiler.frontend.types.type_context;
استورد compiler.msir.identifiers;
استورد compiler.interpreter.execution.frame;
استورد compiler.interpreter.memory.memory;

عام نوع نتيجة_تفسير_مسير =
    | نجح بنوع اختيار قيمة_تشغيل
    | خرج بنوع غير_موقع
    | أخفق بنوع فشل_تفسير_مسير
;

// Direct execution boundary for canonical MSIR produced by lowering.
عام عرف فسر_سياق_مسير(
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    وسائط_البرنامج: متجه متجه غ8
): نتيجة_تفسير_مسير {
    دع الحالة: متغير حالة_تنفيذ_مفسر = حالة_تنفيذ_مفسر_جديدة(وسائط_البرنامج);
    طابق ابدأ_دالة_مفسر(&متغير الحالة, المسير, دالة_الدخول, الحجج) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_تفسير_مسير.أخفق(الخطأ);
    }
    | اختيار.لا_شيء -> { };

    بينما (صواب) {
        دع الإطار: إطار_تفسير_مسير;
        طابق اقرأ_الإطار_النشط(&الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
            أرجع نتيجة_تفسير_مسير.أخفق(الخطأ);
        }
        | نتيجة_إطار_نشط.موجود(القيمة) -> {
            الإطار := القيمة;
        };

        طابق ابحث_كتلة_مسير(المسير, الإطار.الكتلة) مع
        | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> {
            أرجع نتيجة_تفسير_مسير.أخفق(
                فشل_تفسير_مسير.خلل_داخلي(
                    خلل_داخلي_مفسر.كتلة_مفقودة(الإطار.الكتلة)
                )
            );
        }
        | نتيجة_بحث_كتلة_مسير.موجودة(الكتلة) -> {
            لو (الإطار.مؤشر_التعليمة < الكتلة.عدد_التعليمات) {
                طابق تعليمة_مسير_عند(
                    المسير,
                    الإطار.الكتلة,
                    الإطار.مؤشر_التعليمة
                ) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_مسير.خلل_داخلي(
                            خلل_داخلي_مفسر.تعليمة_مفقودة(
                                الإطار.الكتلة,
                                الإطار.مؤشر_التعليمة
                            )
                        )
                    );
                }
                | اختيار.بعض(التعليمة) -> {
                    طابق نفذ_تعليمة_مفسر(
                        &متغير الحالة,
                        الأنواع,
                        المسير,
                        &التعليمة
                    ) مع
                    | نتيجة_تعليمة_مفسر.استمر -> { }
                    | نتيجة_تعليمة_مفسر.أنهى_العملية(الحالة_الخامة) -> {
                        أرجع نتيجة_تفسير_مسير.خرج(الحالة_الخامة);
                    }
                    | نتيجة_تعليمة_مفسر.أخفق(الخطأ) -> {
                        أرجع نتيجة_تفسير_مسير.أخفق(الخطأ);
                    };
                };
            } وإلا {
                طابق منهي_كتلة_مسير(المسير, الإطار.الكتلة) مع
                | نتيجة_بحث_منهي_مسير.كتلة_مفقودة(_) -> {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_مسير.خلل_داخلي(
                            خلل_داخلي_مفسر.كتلة_مفقودة(الإطار.الكتلة)
                        )
                    );
                }
                | نتيجة_بحث_منهي_مسير.منهي_مفقود(_) -> {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_مسير.خلل_داخلي(
                            خلل_داخلي_مفسر.منهي_مفقود(الإطار.الكتلة)
                        )
                    );
                }
                | نتيجة_بحث_منهي_مسير.موجود(المنهي) -> {
                    طابق نفذ_منهي_مفسر(&متغير الحالة, المسير, &المنهي) مع
                    | نتيجة_منهي_مفسر.استمر -> { }
                    | نتيجة_منهي_مفسر.اكتمل(الناتج) -> {
                        أرجع نتيجة_تفسير_مسير.نجح(الناتج);
                    }
                    | نتيجة_منهي_مفسر.أخفق(الخطأ) -> {
                        أرجع نتيجة_تفسير_مسير.أخفق(الخطأ);
                    };
                };
            };
        };
    }
    أرجع نتيجة_تفسير_مسير.أخفق(
        فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
    );
}

// Convenience boundary for raw canonical MSIR.
عام عرف فسر_برنامج_مسير(
    البرنامج: برنامج_مسير,
    الأنواع: &سجل_أنواع,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    وسائط_البرنامج: متجه متجه غ8
): نتيجة_تفسير_مسير {
    دع المسير: سياق_مستهلك_مسير = أنشئ_سياق_مستهلك_مسير(البرنامج);
    أرجع فسر_سياق_مسير(&المسير, الأنواع, دالة_الدخول, الحجج, وسائط_البرنامج);
}
