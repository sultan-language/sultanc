عرف فشل_تفسير_موضعي_بلا_موقع(الفشل: فشل_تفسير_مسير): فشل_تفسير_موضعي {
    دع بلا_موقع: اختياري موقع_فشل_تفسير_مسير = اختياري.لا_شيء();
    دع بلا_نداءات: متجه موقع_فشل_تفسير_مسير = [];
    دع الناتج: فشل_تفسير_موضعي = { الفشل: الفشل, الموقع: بلا_موقع, النداءات: بلا_نداءات, المنفذ: 0 };
    أرجع الناتج;
}

عرف فشل_تفسير_موضعي_عند_كتلة(
    الفشل: فشل_تفسير_مسير,
    الكتلة: معرف_كتلة_مسير
): فشل_تفسير_موضعي {
    دع بلا_تعليمة: اختياري طبيعي = اختياري.لا_شيء();
    دع بلا_أصل: اختياري معرف_أصل_مصدر = اختياري.لا_شيء();
    دع بلا_تصحيح: اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
    دع الموقع: موقع_فشل_تفسير_مسير = {
        الدالة: الكتلة.الدالة,
        الكتلة: الكتلة,
        التعليمة: بلا_تعليمة,
        الأصل: بلا_أصل,
        موقع_التصحيح: بلا_تصحيح
    };
    دع بلا_نداءات: متجه موقع_فشل_تفسير_مسير = [];
    دع الناتج: فشل_تفسير_موضعي = {
        الفشل: الفشل, الموقع: اختياري.موجود(الموقع), النداءات: بلا_نداءات, المنفذ: 0
    };
    أرجع الناتج;
}

عرف فشل_تفسير_موضعي_عند_تعليمة(
    الفشل: فشل_تفسير_مسير,
    الكتلة: معرف_كتلة_مسير,
    الفهرس: طبيعي,
    التعليمة: &تعليمة_مسير
): فشل_تفسير_موضعي {
    دع الموقع: موقع_فشل_تفسير_مسير = {
        الدالة: الكتلة.الدالة,
        الكتلة: الكتلة,
        التعليمة: اختياري.موجود(الفهرس),
        // The origin is that of the debug location (أصل_مصدر_لموقع_فشل_تفسير).
        الأصل: اختياري.لا_شيء(),
        موقع_التصحيح: موقع_تصحيح_من_مرجع_مسير((*التعليمة).موقع_التصحيح)
    };
    دع بلا_نداءات: متجه موقع_فشل_تفسير_مسير = [];
    دع الناتج: فشل_تفسير_موضعي = {
        الفشل: الفشل, الموقع: اختياري.موجود(الموقع), النداءات: بلا_نداءات, المنفذ: 0
    };
    أرجع الناتج;
}

عام نوع نتيجة_تفسير_مسير =
    | نجح بنوع اختياري قيمة_تشغيل
    | خرج بنوع طبيعي
    | أخفق بنوع فشل_تفسير_موضعي
    | هدف_غير_متوافق
;

// The registered target registry is the sole owner of target identities and
// host resolution. Interpreter entry points accept the selected identity,
// never independently infer or reinterpret the compilation target.
عام عرف حل_هدف_تفسير_متوافق(المعرف: معرف_هدف): اختياري واصف_هدف {
    دع الهدف: واصف_هدف;
    طابق حل_بمعرف_هدف(المعرف) مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف := الوصف; };

    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(المضيف) -> {
        // Equality of canonical registered identities entails the same
        // platform, architecture, environment, ABI and data model.
        إذا (!معرفا_هدف_متساويان(الهدف.المعرف, المضيف.المعرف)) {
            أرجع اختياري.لا_شيء();
        };
    };
    أرجع اختياري.موجود(الهدف);
}

// Direct execution boundary for canonical MSIR produced by lowering.
// Only the interpreter enforces this CTFE boundary; MSIR retains its normal
// target-neutral operation set for runtime, Native, and LLVM consumers.
عرف عملية_وقت_ترجمة_محظورة(العملية: &عملية_مسير, المسير: &سياق_مستهلك_مسير): منطقي {
    طابق *العملية مع
    // Reading an immutable module constant (a lookup table, a literal
    // aggregate) observes nothing outside the evaluation; its initializer is
    // the MSIR constant. Mutable module state and imported storage are the
    // running program's.
    | عملية_مسير.مكان_عام(المكان) -> {
        إذا (المكان.قابل_للكتابة) { أرجع صواب; };
        دع العوام: &متجه عام_مسير = &(*المسير).المسير.العوام;
        إذا ((المكان.العام.القيمة مثل طبيعي) >= (الطول(*العوام) مثل طبيعي)) { أرجع صواب; };
        إذا ((*العوام)[المكان.العام.القيمة].قابل_للكتابة) { أرجع صواب; };
        طابق (*العوام)[المكان.العام.القيمة].الاسم_الخارجي مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | عملية_مسير.مرجع_إلى_مؤشر(_) -> { أرجع صواب; }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// CTFE results outlive the interpreter's activation/heap storage. Never
// expose a borrowed place, heap box, or closure whose backing storage is
// destroyed when evaluation finishes. Owned, recursively stable values may
// cross the compile-time -> MSIR-constant boundary.
عرف هل_قيمة_وقت_ترجمة_ثابتة(
    القيمة: &قيمة_تشغيل,
    العمق: طبيعي
): منطقي {
    إذا (العمق >= 128) { أرجع خطأ; };
    طابق *القيمة مع
    | قيمة_تشغيل.مرجع(_) -> { أرجع خطأ; }
    | قيمة_تشغيل.صندوق(_) -> { أرجع خطأ; }
    | قيمة_تشغيل.إغلاق(_) -> { أرجع خطأ; }
    | قيمة_تشغيل.مخزن(_) -> { أرجع خطأ; }
    | قيمة_تشغيل.تجميع(العناصر) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            إذا (!هل_قيمة_وقت_ترجمة_ثابتة(&العناصر[ف], العمق + 1)) {
                أرجع خطأ;
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | قيمة_تشغيل.موسوم(الموسوم) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الموسوم.الحمولات) مثل طبيعي)) {
            إذا (!هل_قيمة_وقت_ترجمة_ثابتة(&الموسوم.الحمولات[ف], العمق + 1)) {
                أرجع خطأ;
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | _ -> { أرجع صواب; };
}

// The compile-time boundary carries sequences inline (text bytes, vector
// elements), the form MSIR constants have. Inside, a sequence is a handle to
// a heap buffer; these convert at the boundary, by the parameter and result
// Types of the evaluated function.
عرف أدخل_قيمة_وقت_ترجمة_مفسر(
    الذاكرة: &متغير ذاكرة_مفسر,
    القيمة: &قيمة_تشغيل,
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): قيمة_تشغيل {
    طابق *القيمة مع
    | قيمة_تشغيل.نص(البايتات) -> {
        أرجع قيمة_تشغيل.مخزن(خصص_مخزن_بايتات_مفسر(الذاكرة, انسخ_بايتات(&البايتات), خطأ));
    }
    | قيمة_تشغيل.تجميع(العناصر) -> {
        طابق نوع_عنصر_تسلسل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(نوع_العنصر) -> {
            دع الداخلة: متغير متجه قيمة_تشغيل = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(العناصر) مثل طبيعي)) {
                ألحق(الداخلة, أدخل_قيمة_وقت_ترجمة_مفسر(الذاكرة, &العناصر[ف], الأنواع, نوع_العنصر));
                ف := ف + 1;
            }
            أرجع قيمة_تشغيل.مخزن(مخزن_عناصر_مفسر(الذاكرة, الداخلة, الأنواع, نوع_العنصر));
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    أرجع انسخ_قيمة_تشغيل(القيمة);
}

عرف أخرج_قيمة_وقت_ترجمة_مفسر(
    الذاكرة: &ذاكرة_مفسر,
    القيمة: &قيمة_تشغيل,
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): قيمة_تشغيل {
    طابق *القيمة مع
    | قيمة_تشغيل.مخزن(المخزن) -> {
        إذا (نوع_نص_مفسر(الأنواع, النوع)) {
            طابق بايتات_مخزن_مفسر(الذاكرة, المخزن) مع
            | اختياري.موجود(البايتات) -> { أرجع قيمة_تشغيل.نص(البايتات); }
            | اختياري.لا_شيء -> { };
        };
        طابق نوع_عنصر_تسلسل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(نوع_العنصر) -> {
            طابق قيم_مخزن_مفسر(الذاكرة, المخزن) مع
            | اختياري.موجود(العناصر) -> {
                دع الخارجة: متغير متجه قيمة_تشغيل = [];
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(العناصر) مثل طبيعي)) {
                    ألحق(الخارجة, أخرج_قيمة_وقت_ترجمة_مفسر(الذاكرة, &العناصر[ف], الأنواع, نوع_العنصر));
                    ف := ف + 1;
                }
                أرجع قيمة_تشغيل.تجميع(الخارجة);
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    أرجع انسخ_قيمة_تشغيل(القيمة);
}

// One canonical MSIR interpreter loop for runtime and bounded CTFE.
عرف فسر_سياق_مسير_بنمط(
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    وسائط_البرنامج: متجه متجه ط8,
    نمط_تقييم_مسبق: منطقي,
    حد_التعليمات: طبيعي,
    حد_النداءات: طبيعي,
    مقابض_المكتبات: &متجه ط64
): نتيجة_تفسير_مسير {
    دع الهدف_المقنن: واصف_هدف;
    // Runtime execution requires the canonical host identity. Bounded CTFE
    // instead interprets target-neutral MSIR using the requested registered
    // target's data model; host services and raw host pointers are forbidden
    // below. Cross-compilation must not execute a foreign native binary.
    إذا (نمط_تقييم_مسبق) {
        طابق حل_بمعرف_هدف(الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> { أرجع نتيجة_تفسير_مسير.هدف_غير_متوافق(); }
        | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف_المقنن := الوصف; };
    } وإلا {
        طابق حل_هدف_تفسير_متوافق(الهدف) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تفسير_مسير.هدف_غير_متوافق(); }
        | اختياري.موجود(الوصف) -> { الهدف_المقنن := الوصف; };
    };
    دع الحالة: متغير حالة_تنفيذ_مفسر = حالة_تنفيذ_مفسر_جديدة(الهدف_المقنن);
    إذا (!نمط_تقييم_مسبق && !هيئ_وسائط_إقلاع_مفسر(
        &متغير الحالة, المسير, &وسائط_البرنامج
    )) {
        أرجع نتيجة_تفسير_مسير.أخفق(
            فشل_تفسير_موضعي_بلا_موقع(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
            )
        );
    };
    الحالة.نمط_تقييم_مسبق := نمط_تقييم_مسبق;
    دع م_: متغير طبيعي = 0;
    طالما (م_ < (الطول(*مقابض_المكتبات) مثل طبيعي)) {
        ألحق(الحالة.مقابض_المكتبات, (*مقابض_المكتبات)[م_]);
        م_ := م_ + 1;
    }
    الحالة.تعليمات_متبقية := حد_التعليمات;
    الحالة.حد_التعليمات_الكلي := حد_التعليمات;
    الحالة.حد_أطر_وقت_الترجمة := حد_النداءات;
    إذا (نمط_تقييم_مسبق && حد_النداءات == 0) {
        أرجع نتيجة_تفسير_مسير.أخفق(
            فشل_تفسير_موضعي_بلا_موقع(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_عمق_النداء()
                )
            )
        );
    };
    دع الحجج_الداخلة: متغير متجه قيمة_تشغيل = [];
    دع فهرس_الحجة: متغير طبيعي = 0;
    طالما (فهرس_الحجة < (الطول(الحجج) مثل طبيعي)) {
        طابق معامل_دالة_مسير_عند(المسير, دالة_الدخول, فهرس_الحجة) مع
        | اختياري.موجود(المعامل) -> {
            ألحق(الحجج_الداخلة, أدخل_قيمة_وقت_ترجمة_مفسر(
                &متغير الحالة.الذاكرة, &الحجج[فهرس_الحجة], الأنواع, المعامل.النوع
            ));
        }
        | اختياري.لا_شيء -> { ألحق(الحجج_الداخلة, انسخ_قيمة_تشغيل(&الحجج[فهرس_الحجة])); };
        فهرس_الحجة := فهرس_الحجة + 1;
    }
    دع نوع_ناتج_الدخول: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق ابحث_دالة_مسير(المسير, دالة_الدخول) مع
    | نتيجة_بحث_دالة_مسير.موجودة(العرض) -> { نوع_ناتج_الدخول := العرض.الناتج; }
    | نتيجة_بحث_دالة_مسير.مفقودة(_) -> { };
    طابق ابدأ_دالة_مفسر(&متغير الحالة, المسير, الأنواع, دالة_الدخول, الحجج_الداخلة) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع نتيجة_تفسير_مسير.أخفق(فشل_تفسير_موضعي_بلا_موقع(الخطأ));
    }
    | اختياري.لا_شيء -> { };

    دع النتيجة: نتيجة_تفسير_مسير = شغل_حلقة_مفسر(
        &متغير الحالة, المسير, الأنواع, نوع_ناتج_الدخول, نمط_تقييم_مسبق
    );
    إذا (نمط_تقييم_مسبق) {
        أرجع أضف_سياق_فشل_وقت_الترجمة(النتيجة, &الحالة, المسير, حد_التعليمات);
    };
    أرجع النتيجة;
}

// The instruction loop of فسر_سياق_مسير_بنمط, over a state the caller set
// up (and reads afterwards: a compile-time failure takes its call chain and
// instruction count from it).
عرف شغل_حلقة_مفسر(
    الحالة: &متغير حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    نوع_ناتج_الدخول: اختياري معرف_نوع,
    نمط_تقييم_مسبق: منطقي
): نتيجة_تفسير_مسير {
    // The instruction stream is read in place: the verified program is
    // borrowed for the whole run, and each step borrows the current
    // instruction instead of copying it (wasm3 and Pulley likewise dispatch
    // on the code in place).
    دع الدوال: &متجه دالة_مسير = &(*المسير).المسير.الدوال;
    دع تقييم_مسبق: منطقي = نمط_تقييم_مسبق;
    طالما (صواب) {
        دع العمق_الحالي: طبيعي = (*الحالة).عمق_المكدس;
        إذا (العمق_الحالي == 0) {
            أرجع نتيجة_تفسير_مسير.أخفق(
                فشل_تفسير_موضعي_بلا_موقع(
                    فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
                )
            );
        };
        دع موضع_الإطار: طبيعي = العمق_الحالي - 1;
        دع الكتلة_النشطة: معرف_كتلة_مسير = (*الحالة).المكدس[موضع_الإطار].الكتلة;
        دع مؤشر_البداية: طبيعي = (*الحالة).المكدس[موضع_الإطار].مؤشر_التعليمة;
        إذا ((الكتلة_النشطة.الدالة.القيمة مثل طبيعي) >= (الطول(*الدوال) مثل طبيعي)) {
            أرجع نتيجة_تفسير_مسير.أخفق(
                فشل_تفسير_موضعي_عند_كتلة(
                    فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.كتلة_مفقودة(الكتلة_النشطة)),
                    الكتلة_النشطة
                )
            );
        };
        دع الكتل: &متجه كتلة_مسير = &(*الدوال)[الكتلة_النشطة.الدالة.القيمة].الكتل;
        إذا ((الكتلة_النشطة.القيمة مثل طبيعي) >= (الطول(*الكتل) مثل طبيعي)) {
            أرجع نتيجة_تفسير_مسير.أخفق(
                فشل_تفسير_موضعي_عند_كتلة(
                    فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.كتلة_مفقودة(الكتلة_النشطة)),
                    الكتلة_النشطة
                )
            );
        };
        دع الكتلة: &كتلة_مسير = &(*الكتل)[الكتلة_النشطة.القيمة];
        دع التعليمات: &متجه تعليمة_مسير = &(*الكتلة).التعليمات;
        دع عدد_التعليمات: طبيعي = الطول(*التعليمات) مثل طبيعي;
        // The instructions of the block that the fast paths cover
        // (fast_paths.sn) run in this inner loop without re-deriving the
        // frame and the block for each one; the first one they do not cover
        // goes to the checked handler below.
        دع مؤشر_سريع: متغير طبيعي = مؤشر_البداية;
        دع منتقل: متغير منطقي = خطأ;
        // Compile-time evaluation takes them too: they cover only pure
        // operations (none the effect policy refuses), and each one is
        // charged to the budget; with none left, the checked handler below
        // reports the instruction that would have run.
        دع سريع: متغير منطقي = صواب;
        طالما (سريع && مؤشر_سريع < عدد_التعليمات) {
            إذا (تقييم_مسبق && (*الحالة).تعليمات_متبقية == 0) {
                سريع := خطأ;
            } وإلا إذا (نفذ_تعليمة_سريعة_مفسر(الحالة, موضع_الإطار, &(*الدوال)[الكتلة_النشطة.الدالة.القيمة], &(*التعليمات)[مؤشر_سريع])) {
                مؤشر_سريع := مؤشر_سريع + 1;
                إذا (تقييم_مسبق) { (*الحالة).تعليمات_متبقية := (*الحالة).تعليمات_متبقية - 1; };
            } وإلا {
                سريع := خطأ;
            };
        }
        إذا (مؤشر_سريع >= عدد_التعليمات && (!تقييم_مسبق || (*الحالة).تعليمات_متبقية > 0)) {
            طابق (*الكتلة).المنهي مع
            | اختياري.موجود(المنهي_السريع) -> {
                منتقل := نفذ_منهي_سريع_مفسر(الحالة, موضع_الإطار, المسير, &المنهي_السريع);
                إذا (منتقل && تقييم_مسبق) { (*الحالة).تعليمات_متبقية := (*الحالة).تعليمات_متبقية - 1; };
            }
            | اختياري.لا_شيء -> { };
        };
        دع مؤشر_التعليمة_النشط: طبيعي = مؤشر_سريع;
        إذا (منتقل) {
            // A fast branch moved the frame to its next block.
        } وإلا { إذا (مؤشر_التعليمة_النشط < عدد_التعليمات) {
            دع التعليمة: &تعليمة_مسير = &(*التعليمات)[مؤشر_التعليمة_النشط];
            دع العملية: &عملية_مسير = &(*التعليمة).العملية;
            // Bound both ordinary instructions and calls; the same
            // budget is shared across all nested SultanC functions.
            إذا (تقييم_مسبق) {
                إذا ((*الحالة).تعليمات_متبقية == 0) {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_موضعي_عند_تعليمة(
                            فشل_تفسير_مسير.وقت_تشغيل(
                                خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_الحد()
                            ), الكتلة_النشطة, مؤشر_التعليمة_النشط, التعليمة
                        )
                    );
                };
                (*الحالة).تعليمات_متبقية := (*الحالة).تعليمات_متبقية - 1;
                // No raw pointers, address-taking of runtime globals,
                // or host/foreign memory observations during CTFE.
                إذا (عملية_وقت_ترجمة_محظورة(العملية, المسير)) {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_موضعي_عند_تعليمة(
                            فشل_تفسير_مسير.وقت_تشغيل(
                                خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع()
                            ), الكتلة_النشطة, مؤشر_التعليمة_النشط, التعليمة
                        )
                    );
                };
            };
            دع الناتج: ناتج_تعليمة_مفسر = ناتج_تعليمة_مسير_مفسر(الكتلة_النشطة.الدالة, التعليمة);
            طابق نفذ_تعليمة_مفسر(الحالة, الأنواع, المسير, العملية, &الناتج) مع
            | نتيجة_تعليمة_مفسر.استمر -> { }
            | نتيجة_تعليمة_مفسر.أنهى_العملية(الحالة_الخامة) -> {
                // A compile-time function never terminates the host
                // compiler, even if an effectful primitive slips past
                // its semantic effect classification.
                إذا (تقييم_مسبق) {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_موضعي_عند_تعليمة(
                            فشل_تفسير_مسير.وقت_تشغيل(
                                خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع()
                            ), الكتلة_النشطة, مؤشر_التعليمة_النشط, التعليمة
                        )
                    );
                };
                أرجع نتيجة_تفسير_مسير.خرج(الحالة_الخامة);
            }
            | نتيجة_تعليمة_مفسر.أخفق(الخطأ) -> {
                أرجع نتيجة_تفسير_مسير.أخفق(
                    فشل_تفسير_موضعي_عند_تعليمة(
                        الخطأ, الكتلة_النشطة, مؤشر_التعليمة_النشط, التعليمة
                    )
                );
            };
        } وإلا {
            دع المنهي_الاختياري: &اختياري منهي_مسير = &(*الكتلة).المنهي;
            طابق *المنهي_الاختياري مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تفسير_مسير.أخفق(
                    فشل_تفسير_موضعي_عند_كتلة(
                        فشل_تفسير_مسير.خلل_داخلي(
                            خلل_داخلي_مفسر.منهي_مفقود(الكتلة_النشطة)
                        ),
                        الكتلة_النشطة
                    )
                );
            }
            | اختياري.موجود(المنهي) -> {
                // Count terminators too: even an empty-block branch cycle
                // must exhaust its finite compile-time fuel.
                إذا (تقييم_مسبق) {
                    إذا ((*الحالة).تعليمات_متبقية == 0) {
                        أرجع نتيجة_تفسير_مسير.أخفق(
                            فشل_تفسير_موضعي_عند_كتلة(
                                فشل_تفسير_مسير.وقت_تشغيل(
                                    خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_الحد()
                                ), الكتلة_النشطة
                            )
                        );
                    };
                    (*الحالة).تعليمات_متبقية := (*الحالة).تعليمات_متبقية - 1;
                };
                طابق نفذ_منهي_مفسر(الحالة, المسير, &المنهي) مع
                | نتيجة_منهي_مفسر.استمر -> { }
                | نتيجة_منهي_مفسر.اكتمل(الناتج) -> {
                    طابق الناتج مع
                    | اختياري.موجود(القيمة) -> {
                        طابق نوع_ناتج_الدخول مع
                        | اختياري.موجود(النوع) -> {
                            أرجع نتيجة_تفسير_مسير.نجح(اختياري.موجود(
                                أخرج_قيمة_وقت_ترجمة_مفسر(&(*الحالة).الذاكرة, &القيمة, الأنواع, النوع)
                            ));
                        }
                        | اختياري.لا_شيء -> { أرجع نتيجة_تفسير_مسير.نجح(اختياري.موجود(القيمة)); };
                    }
                    | اختياري.لا_شيء -> { أرجع نتيجة_تفسير_مسير.نجح(اختياري.لا_شيء()); };
                }
                | نتيجة_منهي_مفسر.أخفق(الخطأ) -> {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_موضعي_عند_كتلة(الخطأ, الكتلة_النشطة)
                    );
                };
            };
        }; };
    }
    أرجع نتيجة_تفسير_مسير.أخفق(
        فشل_تفسير_موضعي_بلا_موقع(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        )
    );
}

// The call sites of the frames under the failing one (a caller's pointer
// is already past its call instruction), innermost first, and the
// instructions spent, added to a compile-time failure.
عرف أضف_سياق_فشل_وقت_الترجمة(
    النتيجة: نتيجة_تفسير_مسير,
    الحالة: &حالة_تنفيذ_مفسر,
    المسير: &سياق_مستهلك_مسير,
    حد_التعليمات: طبيعي
): نتيجة_تفسير_مسير {
    طابق النتيجة مع
    | نتيجة_تفسير_مسير.أخفق(الفشل) -> {
        دع النداءات: متغير متجه موقع_فشل_تفسير_مسير = [];
        دع الدوال: &متجه دالة_مسير = &(*المسير).المسير.الدوال;
        دع العمق: طبيعي = (*الحالة).عمق_المكدس;
        دع ف: متغير طبيعي = العمق;
        طالما (ف > 1 && (الطول(النداءات) مثل طبيعي) < 64) {
            ف := ف - 1;
            دع الإطار: &إطار_تفسير_مسير = &(*الحالة).المكدس[ف - 1];
            دع الكتلة: معرف_كتلة_مسير = (*الإطار).الكتلة;
            دع المؤشر: طبيعي = (*الإطار).مؤشر_التعليمة;
            دع الأصل: متغير اختياري معرف_أصل_مصدر = اختياري.لا_شيء();
            دع التصحيح: متغير اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
            دع الفهرس: متغير اختياري طبيعي = اختياري.لا_شيء();
            إذا (المؤشر > 0 && (الكتلة.الدالة.القيمة مثل طبيعي) < (الطول(*الدوال) مثل طبيعي)) {
                دع الكتل: &متجه كتلة_مسير = &(*الدوال)[الكتلة.الدالة.القيمة].الكتل;
                إذا ((الكتلة.القيمة مثل طبيعي) < (الطول(*الكتل) مثل طبيعي)
                    && المؤشر - 1 < (الطول((*الكتل)[الكتلة.القيمة].التعليمات) مثل طبيعي)) {
                    دع التعليمة: &تعليمة_مسير = &(*الكتل)[الكتلة.القيمة].التعليمات[المؤشر - 1];
                    الأصل := أصل_تعليمة_مسير(&(*المسير).المسير, التعليمة);
                    التصحيح := موقع_تصحيح_من_مرجع_مسير((*التعليمة).موقع_التصحيح);
                    الفهرس := اختياري.موجود(المؤشر - 1);
                };
            };
            دع الموقع: موقع_فشل_تفسير_مسير = {
                الدالة: الكتلة.الدالة, الكتلة: الكتلة, التعليمة: الفهرس,
                الأصل: الأصل, موقع_التصحيح: التصحيح
            };
            ألحق(النداءات, الموقع);
        }
        دع الكلي: طبيعي = (*الحالة).حد_التعليمات_الكلي;
        دع المنفذ: متغير طبيعي = الكلي;
        إذا ((*الحالة).تعليمات_متبقية <= الكلي) { المنفذ := الكلي - (*الحالة).تعليمات_متبقية; };
        طابق الفشل مع
        | { الفشل: السبب, الموقع: الموقع_الأصلي, النداءات: _, المنفذ: _ } -> {
            دع الناتج: فشل_تفسير_موضعي = {
                الفشل: السبب, الموقع: الموقع_الأصلي, النداءات: النداءات, المنفذ: المنفذ
            };
            أرجع نتيجة_تفسير_مسير.أخفق(الناتج);
        };
    }
    | _ -> { أرجع النتيجة; };
}

// Existing runtime entry retains unrestricted interpreter semantics.
عام عرف فسر_سياق_مسير(
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    وسائط_البرنامج: متجه متجه ط8
): نتيجة_تفسير_مسير {
    دع بلا_مكتبات: متجه ط64 = [];
    أرجع فسر_سياق_مسير_بمكتبات(
        المسير, الأنواع, الهدف, دالة_الدخول, الحجج, وسائط_البرنامج, &بلا_مكتبات
    );
}

// The same with the handles of the libraries the driver loaded for the run
// (load_libraries.sn حمل_مكتبات_مفسر), searched for its externs.
عام عرف فسر_سياق_مسير_بمكتبات(
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    وسائط_البرنامج: متجه متجه ط8,
    مقابض_المكتبات: &متجه ط64
): نتيجة_تفسير_مسير {
    أرجع فسر_سياق_مسير_بنمط(
        المسير, الأنواع, الهدف, دالة_الدخول, الحجج, وسائط_البرنامج,
        خطأ, 0, 0, مقابض_المكتبات
    );
}

عام نوع نتيجة_تقييم_وقت_الترجمة_مسير =
    | مسير_غير_صالح بنوع متجه خطأ_تحقق_مسير
    | منفذ بنوع نتيجة_تفسير_مسير
;

// Verified MSIR is the sole compile-time execution representation. CTFE
// resolves the selected registered target's data model without requiring a
// host ABI match; external/OS effects and raw host pointers remain prohibited.
// Execution is bounded by shared instruction and call-stack limits.
عام عرف فسر_وقت_الترجمة_مسير(
    البرنامج: برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    حد_التعليمات: طبيعي,
    حد_النداءات: طبيعي
): نتيجة_تقييم_وقت_الترجمة_مسير {
    طابق تحقق_برنامج_مسير(&البرنامج, الأنواع) مع
    | نتيجة_تحقق_مسير.مرفوض(الأخطاء) -> {
        أرجع نتيجة_تقييم_وقت_الترجمة_مسير.مسير_غير_صالح(الأخطاء);
    }
    | نتيجة_تحقق_مسير.صالح -> { };
    // Compile-time arguments must be closed values: no caller-owned
    // activation references, heap identities, or closures may cross into
    // this evaluation. The same recursively stable rule protects results.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحجج) مثل طبيعي)) {
        إذا (!هل_قيمة_وقت_ترجمة_ثابتة(&الحجج[ف], 0)) {
            أرجع نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(
                نتيجة_تفسير_مسير.أخفق(
                    فشل_تفسير_موضعي_بلا_موقع(
                        فشل_تفسير_مسير.وقت_تشغيل(
                            خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_حجة_غير_ثابتة()
                        )
                    )
                )
            );
        };
        ف := ف + 1;
    }
    دع المسير: سياق_مستهلك_مسير = أنشئ_سياق_مستهلك_مسير(البرنامج);
    دع وسائط: متجه متجه ط8 = [];
    دع بلا_مكتبات: متجه ط64 = [];
    دع النتيجة: نتيجة_تفسير_مسير = فسر_سياق_مسير_بنمط(
        &المسير, الأنواع, الهدف, دالة_الدخول, الحجج, وسائط,
        صواب, حد_التعليمات, حد_النداءات, &بلا_مكتبات
    );
    // Reject results tied to evaluator-owned storage before the interpreter
    // lifetime ends. This is independent of the instruction-effect sandbox:
    // a pure local borrow can otherwise escape through a result aggregate.
    إذا (ناتج_تفسير_غير_ثابت(&النتيجة)) {
        أرجع نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(
            نتيجة_تفسير_مسير.أخفق(
                فشل_تفسير_موضعي_بلا_موقع(
                    فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_نتيجة_غير_ثابتة()
                    )
                )
            )
        );
    };
    أرجع نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة);
}

// A consumer context for repeated compile-time calls into a part of the
// program that does not change between them (the driver's format checks,
// driver/compile_time.sn): indexed once instead of once per call. The caller
// passes MSIR it has verified: the driver verifies the lowered program before
// it discharges compile-time work (compiler_driver.sn), and its own rewrites
// (constants, specialized copies) keep the checked functions unchanged.
عام عرف أنشئ_سياق_وقت_الترجمة_مسير(البرنامج: برنامج_مسير): سياق_مستهلك_مسير {
    أرجع أنشئ_سياق_مستهلك_مسير(البرنامج);
}

// فسر_وقت_الترجمة_مسير through a context from أنشئ_سياق_وقت_الترجمة_مسير,
// with the same closed-argument and closed-result rules and budgets.
عام عرف فسر_وقت_الترجمة_بسياق_مسير(
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    حد_التعليمات: طبيعي,
    حد_النداءات: طبيعي
): اختياري نتيجة_تفسير_مسير {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحجج) مثل طبيعي)) {
        إذا (!هل_قيمة_وقت_ترجمة_ثابتة(&الحجج[ف], 0)) { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    دع وسائط: متجه متجه ط8 = [];
    دع بلا_مكتبات: متجه ط64 = [];
    دع النتيجة: نتيجة_تفسير_مسير = فسر_سياق_مسير_بنمط(
        المسير, الأنواع, الهدف, دالة_الدخول, الحجج, وسائط,
        صواب, حد_التعليمات, حد_النداءات, &بلا_مكتبات
    );
    إذا (ناتج_تفسير_غير_ثابت(&النتيجة)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(النتيجة);
}

// Whether a successful result carries a value that is not a compile-time
// constant. Reads the result in place; the caller keeps ownership of it.
عرف ناتج_تفسير_غير_ثابت(النتيجة: &نتيجة_تفسير_مسير): منطقي {
    طابق *النتيجة مع
    | نتيجة_تفسير_مسير.نجح(الناتج) -> {
        طابق الناتج مع
        | اختياري.موجود(القيمة) -> { أرجع !هل_قيمة_وقت_ترجمة_ثابتة(&القيمة, 0); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// Raw canonical MSIR convenience boundary. The caller must provide verified MSIR;
// the Driver verifies before interpretation and lower layers do not import Driver.
عام عرف فسر_برنامج_مسير(
    البرنامج: برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    وسائط_البرنامج: متجه متجه ط8
): نتيجة_تفسير_مسير {
    دع المسير: سياق_مستهلك_مسير = أنشئ_سياق_مستهلك_مسير(البرنامج);
    أرجع فسر_سياق_مسير(
        &المسير, الأنواع, الهدف, دالة_الدخول, الحجج, وسائط_البرنامج
    );
}
