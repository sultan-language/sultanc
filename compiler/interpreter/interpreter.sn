عرف فشل_تفسير_موضعي_بلا_موقع(الفشل: فشل_تفسير_مسير): فشل_تفسير_موضعي {
    دع بلا_موقع: اختيار موقع_فشل_تفسير_مسير = اختيار.لا_شيء();
    دع الناتج: فشل_تفسير_موضعي = { الفشل: الفشل, الموقع: بلا_موقع };
    أرجع الناتج;
}

عرف فشل_تفسير_موضعي_عند_كتلة(
    الفشل: فشل_تفسير_مسير,
    الكتلة: معرف_كتلة_مسير
): فشل_تفسير_موضعي {
    دع بلا_تعليمة: اختيار غير_موقع = اختيار.لا_شيء();
    دع بلا_أصل: اختيار معرف_أصل_مصدر = اختيار.لا_شيء();
    دع بلا_تصحيح: اختيار معرف_موقع_تصحيح = اختيار.لا_شيء();
    دع الموقع: موقع_فشل_تفسير_مسير = {
        الدالة: الكتلة.الدالة,
        الكتلة: الكتلة,
        التعليمة: بلا_تعليمة,
        الأصل: بلا_أصل,
        موقع_التصحيح: بلا_تصحيح
    };
    دع الناتج: فشل_تفسير_موضعي = { الفشل: الفشل, الموقع: اختيار.بعض(الموقع) };
    أرجع الناتج;
}

عرف فشل_تفسير_موضعي_عند_تعليمة(
    الفشل: فشل_تفسير_مسير,
    الكتلة: معرف_كتلة_مسير,
    الفهرس: غير_موقع,
    التعليمة: &عرض_تعليمة_مسير
): فشل_تفسير_موضعي {
    دع الموقع: موقع_فشل_تفسير_مسير = {
        الدالة: الكتلة.الدالة,
        الكتلة: الكتلة,
        التعليمة: اختيار.بعض(الفهرس),
        الأصل: (*التعليمة).الأصل,
        موقع_التصحيح: (*التعليمة).موقع_التصحيح
    };
    دع الناتج: فشل_تفسير_موضعي = { الفشل: الفشل, الموقع: اختيار.بعض(الموقع) };
    أرجع الناتج;
}

عام نوع نتيجة_تفسير_مسير =
    | نجح بنوع اختيار قيمة_تشغيل
    | خرج بنوع غير_موقع
    | أخفق بنوع فشل_تفسير_موضعي
    | هدف_غير_متوافق
;

// The registered target registry is the sole owner of target identities and
// host resolution. Interpreter entry points accept the selected identity,
// never independently infer or reinterpret the compilation target.
عام عرف حل_هدف_تفسير_متوافق(المعرف: معرف_هدف): اختيار واصف_هدف {
    دع الهدف: واصف_هدف;
    طابق حل_بمعرف_هدف(المعرف) مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختيار.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف := الوصف; };

    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختيار.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(المضيف) -> {
        // Equality of canonical registered identities entails the same
        // platform, architecture, environment, ABI and data model.
        لو (!معرفا_هدف_متساويان(الهدف.المعرف, المضيف.المعرف)) {
            أرجع اختيار.لا_شيء();
        };
    };
    أرجع اختيار.بعض(الهدف);
}

// Direct execution boundary for canonical MSIR produced by lowering.
// Only the interpreter enforces this CTFE boundary; MSIR retains its normal
// target-neutral operation set for runtime, Native, and LLVM consumers.
عرف عملية_وقت_ترجمة_محظورة(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.مكان_عام(_) -> { أرجع صواب; }
    | عملية_مسير.مرجع_إلى_مؤشر(_) -> { أرجع صواب; }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// CTFE results outlive the interpreter's activation/heap storage. Never
// expose a borrowed place, heap box, or closure whose backing storage is
// destroyed when evaluation finishes. Owned, recursively stable values may
// cross the compile-time -> MSIR-constant boundary.
عرف هل_قيمة_وقت_ترجمة_ثابتة(
    القيمة: &قيمة_تشغيل,
    العمق: غير_موقع
): منطقي {
    لو (العمق >= 128) { أرجع خطأ; };
    طابق *القيمة مع
    | قيمة_تشغيل.مرجع(_) -> { أرجع خطأ; }
    | قيمة_تشغيل.صندوق(_) -> { أرجع خطأ; }
    | قيمة_تشغيل.إغلاق(_) -> { أرجع خطأ; }
    | قيمة_تشغيل.تجميع(العناصر) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(العناصر) مثل غير_موقع)) {
            لو (!هل_قيمة_وقت_ترجمة_ثابتة(&العناصر[ف], العمق + 1)) {
                أرجع خطأ;
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | قيمة_تشغيل.موسوم(الموسوم) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الموسوم.الحمولات) مثل غير_موقع)) {
            لو (!هل_قيمة_وقت_ترجمة_ثابتة(&الموسوم.الحمولات[ف], العمق + 1)) {
                أرجع خطأ;
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | _ -> { أرجع صواب; };
}

// One canonical MSIR interpreter loop for runtime and bounded CTFE.
عرف فسر_سياق_مسير_بنمط(
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    وسائط_البرنامج: متجه متجه غ8,
    نمط_تقييم_مسبق: منطقي,
    حد_التعليمات: غير_موقع,
    حد_النداءات: غير_موقع
): نتيجة_تفسير_مسير {
    دع الهدف_المقنن: واصف_هدف;
    // Runtime execution requires the canonical host identity. Bounded CTFE
    // instead interprets target-neutral MSIR using the requested registered
    // target's data model; host services and raw host pointers are forbidden
    // below. Cross-compilation must not execute a foreign native binary.
    لو (نمط_تقييم_مسبق) {
        طابق حل_بمعرف_هدف(الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> { أرجع نتيجة_تفسير_مسير.هدف_غير_متوافق(); }
        | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف_المقنن := الوصف; };
    } وإلا {
        طابق حل_هدف_تفسير_متوافق(الهدف) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تفسير_مسير.هدف_غير_متوافق(); }
        | اختيار.بعض(الوصف) -> { الهدف_المقنن := الوصف; };
    };
    دع الحالة: متغير حالة_تنفيذ_مفسر = حالة_تنفيذ_مفسر_جديدة(الهدف_المقنن);
    لو (!نمط_تقييم_مسبق && !هيئ_وسائط_إقلاع_مفسر(
        &متغير الحالة, المسير, &وسائط_البرنامج
    )) {
        أرجع نتيجة_تفسير_مسير.أخفق(
            فشل_تفسير_موضعي_بلا_موقع(
                فشل_تفسير_مسير.وقت_تشغيل(خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف())
            )
        );
    };
    الحالة.نمط_تقييم_مسبق := نمط_تقييم_مسبق;
    الحالة.تعليمات_متبقية := حد_التعليمات;
    الحالة.حد_أطر_وقت_الترجمة := حد_النداءات;
    لو (نمط_تقييم_مسبق && حد_النداءات == 0) {
        أرجع نتيجة_تفسير_مسير.أخفق(
            فشل_تفسير_موضعي_بلا_موقع(
                فشل_تفسير_مسير.وقت_تشغيل(
                    خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_عمق_النداء()
                )
            )
        );
    };
    طابق ابدأ_دالة_مفسر(&متغير الحالة, المسير, دالة_الدخول, الحجج) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_تفسير_مسير.أخفق(فشل_تفسير_موضعي_بلا_موقع(الخطأ));
    }
    | اختيار.لا_شيء -> { };

    بينما (صواب) {
        دع الكتلة_النشطة: معرف_كتلة_مسير;
        دع مؤشر_التعليمة_النشط: غير_موقع;
        طابق اقرأ_الإطار_النشط(&الحالة) مع
        | نتيجة_إطار_نشط.أخفق(الخطأ) -> {
            أرجع نتيجة_تفسير_مسير.أخفق(فشل_تفسير_موضعي_بلا_موقع(الخطأ));
        }
        | نتيجة_إطار_نشط.موجود(الموضع) -> {
            الكتلة_النشطة := الحالة.المكدس[الموضع].الكتلة;
            مؤشر_التعليمة_النشط := الحالة.المكدس[الموضع].مؤشر_التعليمة;
        };

        طابق ابحث_كتلة_مسير(المسير, الكتلة_النشطة) مع
        | نتيجة_بحث_كتلة_مسير.مفقودة(_) -> {
            أرجع نتيجة_تفسير_مسير.أخفق(
                فشل_تفسير_موضعي_عند_كتلة(
                    فشل_تفسير_مسير.خلل_داخلي(
                        خلل_داخلي_مفسر.كتلة_مفقودة(الكتلة_النشطة)
                    ),
                    الكتلة_النشطة
                )
            );
        }
        | نتيجة_بحث_كتلة_مسير.موجودة(الكتلة) -> {
            لو (مؤشر_التعليمة_النشط < الكتلة.عدد_التعليمات) {
                طابق تعليمة_مسير_عند(
                    المسير,
                    الكتلة_النشطة,
                    مؤشر_التعليمة_النشط
                ) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_موضعي_عند_كتلة(
                            فشل_تفسير_مسير.خلل_داخلي(
                                خلل_داخلي_مفسر.تعليمة_مفقودة(
                                    الكتلة_النشطة,
                                    مؤشر_التعليمة_النشط
                                )
                            ),
                            الكتلة_النشطة
                        )
                    );
                }
                | اختيار.بعض(التعليمة) -> {
                    // Bound both ordinary instructions and calls; the same
                    // budget is shared across all nested SultanC functions.
                    لو (الحالة.نمط_تقييم_مسبق) {
                        لو (الحالة.تعليمات_متبقية == 0) {
                            أرجع نتيجة_تفسير_مسير.أخفق(
                                فشل_تفسير_موضعي_عند_تعليمة(
                                    فشل_تفسير_مسير.وقت_تشغيل(
                                        خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_الحد()
                                    ), الكتلة_النشطة, مؤشر_التعليمة_النشط, &التعليمة
                                )
                            );
                        };
                        الحالة.تعليمات_متبقية := الحالة.تعليمات_متبقية - 1;
                        // No raw pointers, address-taking of runtime globals,
                        // or host/foreign memory observations during CTFE.
                        لو (عملية_وقت_ترجمة_محظورة(&التعليمة.العملية)) {
                            أرجع نتيجة_تفسير_مسير.أخفق(
                                فشل_تفسير_موضعي_عند_تعليمة(
                                    فشل_تفسير_مسير.وقت_تشغيل(
                                        خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع()
                                    ), الكتلة_النشطة, مؤشر_التعليمة_النشط, &التعليمة
                                )
                            );
                        };
                    };
                    طابق نفذ_تعليمة_مفسر(
                        &متغير الحالة,
                        الأنواع,
                        المسير,
                        &التعليمة
                    ) مع
                    | نتيجة_تعليمة_مفسر.استمر -> { }
                    | نتيجة_تعليمة_مفسر.أنهى_العملية(الحالة_الخامة) -> {
                        // A compile-time function never terminates the host
                        // compiler, even if an effectful primitive slips past
                        // its semantic effect classification.
                        لو (الحالة.نمط_تقييم_مسبق) {
                            أرجع نتيجة_تفسير_مسير.أخفق(
                                فشل_تفسير_موضعي_عند_تعليمة(
                                    فشل_تفسير_مسير.وقت_تشغيل(
                                        خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع()
                                    ), الكتلة_النشطة, مؤشر_التعليمة_النشط, &التعليمة
                                )
                            );
                        };
                        أرجع نتيجة_تفسير_مسير.خرج(الحالة_الخامة);
                    }
                    | نتيجة_تعليمة_مفسر.أخفق(الخطأ) -> {
                        أرجع نتيجة_تفسير_مسير.أخفق(
                            فشل_تفسير_موضعي_عند_تعليمة(
                                الخطأ, الكتلة_النشطة, مؤشر_التعليمة_النشط, &التعليمة
                            )
                        );
                    };
                };
            } وإلا {
                طابق منهي_كتلة_مسير(المسير, الكتلة_النشطة) مع
                | نتيجة_بحث_منهي_مسير.كتلة_مفقودة(_) -> {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_موضعي_عند_كتلة(
                            فشل_تفسير_مسير.خلل_داخلي(
                                خلل_داخلي_مفسر.كتلة_مفقودة(الكتلة_النشطة)
                            ),
                            الكتلة_النشطة
                        )
                    );
                }
                | نتيجة_بحث_منهي_مسير.منهي_مفقود(_) -> {
                    أرجع نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_موضعي_عند_كتلة(
                            فشل_تفسير_مسير.خلل_داخلي(
                                خلل_داخلي_مفسر.منهي_مفقود(الكتلة_النشطة)
                            ),
                            الكتلة_النشطة
                        )
                    );
                }
                | نتيجة_بحث_منهي_مسير.موجود(المنهي) -> {
                    // Count terminators too: even an empty-block branch cycle
                    // must exhaust its finite compile-time fuel.
                    لو (الحالة.نمط_تقييم_مسبق) {
                        لو (الحالة.تعليمات_متبقية == 0) {
                            أرجع نتيجة_تفسير_مسير.أخفق(
                                فشل_تفسير_موضعي_عند_كتلة(
                                    فشل_تفسير_مسير.وقت_تشغيل(
                                        خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_الحد()
                                    ), الكتلة_النشطة
                                )
                            );
                        };
                        الحالة.تعليمات_متبقية := الحالة.تعليمات_متبقية - 1;
                    };
                    طابق نفذ_منهي_مفسر(&متغير الحالة, المسير, &المنهي) مع
                    | نتيجة_منهي_مفسر.استمر -> { }
                    | نتيجة_منهي_مفسر.اكتمل(الناتج) -> {
                        أرجع نتيجة_تفسير_مسير.نجح(الناتج);
                    }
                    | نتيجة_منهي_مفسر.أخفق(الخطأ) -> {
                        أرجع نتيجة_تفسير_مسير.أخفق(
                            فشل_تفسير_موضعي_عند_كتلة(الخطأ, الكتلة_النشطة)
                        );
                    };
                };
            };
        };
    }
    أرجع نتيجة_تفسير_مسير.أخفق(
        فشل_تفسير_موضعي_بلا_موقع(
            فشل_تفسير_مسير.خلل_داخلي(خلل_داخلي_مفسر.مكدس_نداءات_فارغ())
        )
    );
}

// Existing runtime entry retains unrestricted interpreter semantics.
عام عرف فسر_سياق_مسير(
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    وسائط_البرنامج: متجه متجه غ8
): نتيجة_تفسير_مسير {
    أرجع فسر_سياق_مسير_بنمط(
        المسير, الأنواع, الهدف, دالة_الدخول, الحجج, وسائط_البرنامج,
        خطأ, 0, 0
    );
}

عام نوع نتيجة_تقييم_وقت_الترجمة_مسير =
    | مسير_غير_صالح بنوع متجه خطأ_تحقق_مسير
    | منفذ بنوع نتيجة_تفسير_مسير
;

// Verified MSIR is the sole compile-time execution representation. CTFE
// resolves the selected registered target's data model without requiring a
// host ABI match; external/OS effects and raw host pointers remain prohibited.
// Execution is bounded by shared instruction and call-stack limits.
عام عرف فسر_وقت_الترجمة_مسير(
    البرنامج: برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    حد_التعليمات: غير_موقع,
    حد_النداءات: غير_موقع
): نتيجة_تقييم_وقت_الترجمة_مسير {
    طابق تحقق_برنامج_مسير(&البرنامج, الأنواع) مع
    | نتيجة_تحقق_مسير.مرفوض(الأخطاء) -> {
        أرجع نتيجة_تقييم_وقت_الترجمة_مسير.مسير_غير_صالح(الأخطاء);
    }
    | نتيجة_تحقق_مسير.صالح -> { };
    // Compile-time arguments must be closed values: no caller-owned
    // activation references, heap identities, or closures may cross into
    // this evaluation. The same recursively stable rule protects results.
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحجج) مثل غير_موقع)) {
        لو (!هل_قيمة_وقت_ترجمة_ثابتة(&الحجج[ف], 0)) {
            أرجع نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(
                نتيجة_تفسير_مسير.أخفق(
                    فشل_تفسير_موضعي_بلا_موقع(
                        فشل_تفسير_مسير.وقت_تشغيل(
                            خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_حجة_غير_ثابتة()
                        )
                    )
                )
            );
        };
        ف := ف + 1;
    }
    دع المسير: سياق_مستهلك_مسير = أنشئ_سياق_مستهلك_مسير(البرنامج);
    دع وسائط: متجه متجه غ8 = [];
    دع النتيجة: نتيجة_تفسير_مسير = فسر_سياق_مسير_بنمط(
        &المسير, الأنواع, الهدف, دالة_الدخول, الحجج, وسائط,
        صواب, حد_التعليمات, حد_النداءات
    );
    // Reject results tied to evaluator-owned storage before the interpreter
    // lifetime ends. This is independent of the instruction-effect sandbox:
    // a pure local borrow can otherwise escape through a result aggregate.
    طابق النتيجة مع
    | نتيجة_تفسير_مسير.نجح(الناتج) -> {
        طابق الناتج مع
        | اختيار.بعض(القيمة) -> {
            لو (!هل_قيمة_وقت_ترجمة_ثابتة(&القيمة, 0)) {
                أرجع نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(
                    نتيجة_تفسير_مسير.أخفق(
                        فشل_تفسير_موضعي_بلا_موقع(
                            فشل_تفسير_مسير.وقت_تشغيل(
                                خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_نتيجة_غير_ثابتة()
                            )
                        )
                    )
                );
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | _ -> { };
    أرجع نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة);
}

// Raw canonical MSIR convenience boundary. The caller must provide verified MSIR;
// the Driver verifies before interpretation and lower layers do not import Driver.
عام عرف فسر_برنامج_مسير(
    البرنامج: برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    دالة_الدخول: معرف_دالة_مسير,
    الحجج: متجه قيمة_تشغيل,
    وسائط_البرنامج: متجه متجه غ8
): نتيجة_تفسير_مسير {
    دع المسير: سياق_مستهلك_مسير = أنشئ_سياق_مستهلك_مسير(البرنامج);
    أرجع فسر_سياق_مسير(
        &المسير, الأنواع, الهدف, دالة_الدخول, الحجج, وسائط_البرنامج
    );
}
