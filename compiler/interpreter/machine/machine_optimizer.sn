// The machine interpreter's word-code optimizer: machine_program.sn runs it
// on each translated function, after its jumps are fixed up, so the engine
// (machine_engine.sn) executes fewer instructions. Selection's code is SSA
// form with block parameters, and an edge's parameters are single moves
// (machine_program.sn أصدر_نقلات_متتابعة_آلة), so most of what a loop runs is
// moves; the passes below remove them without changing what any register
// read sees:
//
// - copy webs: a register whose every definition is a move from the same
//   value (one register defined once, by a definition that runs at most once
//   per call, or a register of the web) is that value: its reads read the
//   value and its moves go (the redundant block parameters of loop-invariant
//   values);
// - coalescing: a definition whose only reads are up to a following move of
//   it in the same block defines the move's destination instead, when that
//   destination is neither read nor written in between (a loop's new value
//   computed into its parameter);
// - forward copies: a read after a move in the same block reads the move's
//   source while neither changes;
// - dead definitions: an operation without effects (no trap, no memory)
//   whose results are never read goes.
//
// The function is decoded first; an operation the decoder does not know, or
// a register outside the frame's registers, leaves the function unchanged.
// Then the kept instructions are packed and every code position (jump
// targets, the block starts trap reports use) moves with its instruction.

مرادف طرح_ملتف_محسن = بدائي_طرح_ملتف;

عرف لا_سجل_محسن(): ط64 { أرجع 0xFFFFFFFF; }

// Operand kinds: a register read, a register written, a register read and
// written (two-address forms), a code position, a register pair read or
// written (the comparison words: kept as they are).
عرف قراءة_محسن(): ط64 { أرجع 1; }
عرف كتابة_محسن(): ط64 { أرجع 2; }
عرف قراءة_وكتابة_محسن(): ط64 { أرجع 3; }
عرف موضع_محسن(): ط64 { أرجع 4; }
عرف زوج_محسن(): ط64 { أرجع 5; }

// The analysis of one function; machine_program.sn keeps one for the whole
// translation, so its buffers are reused from function to function.
عام نوع شفرة_محللة_آلة = {
    // Instruction starts (word indices), then the code length.
    البدايات: متجه طبيعي,
    // Per instruction: its first operand record (one more at the end).
    أول_المعاملات: متجه طبيعي,
    // Operand records: the word index and the kind.
    المواضع: متجه طبيعي,
    الأنواع: متجه ط64,
    // Per instruction: control may go on to the next one; it may go
    // elsewhere (a branch, a jump, a return); it has no effect but its
    // register writes; it is gone; it starts a block; its block.
    يكمل: متجه منطقي,
    يتفرع: متجه منطقي,
    نقية: متجه منطقي,
    محذوفة: متجه منطقي,
    رأس: متجه منطقي,
    الكتلة: متجه طبيعي,
    // Per block: its first instruction (one more at the end), whether it
    // can reach itself (0 unknown, 1 no, 2 yes).
    بدايات_الكتل: متجه طبيعي,
    دوري: متجه ط64,
    // Per block: the search that last reached it (كتلة_دورية_محسن).
    زيارة: متجه ط64,
    بحث: ط64,
    // Per register: definitions and reads, whether every definition is a
    // move, the instruction of its single definition, whether it is kept as
    // it is (a comparison word).
    التعريفات: متجه ط64,
    القراءات: متجه ط64,
    نقلات_فقط: متجه منطقي,
    المعرفة_في: متجه طبيعي,
    // The block of every definition (لا_سجل_محسن() when several).
    كتلة_التعريف: متجه ط64,
    // Per instruction: a code position names it.
    مقصودة: متجه منطقي,
    مثبت: متجه منطقي,
    // Per instruction: replaced by the words [من, إلى) of البدائل (their
    // code positions marked in أهداف_البدائل, still the old ones).
    مستبدلة: متجه منطقي,
    بديل_من: متجه طبيعي,
    بديل_إلى: متجه طبيعي,
    البدائل: متجه ط64,
    أهداف_البدائل: متجه منطقي,
    // Scratch of the passes.
    مؤقت_أ: متجه ط64,
    مؤقت_ب: متجه منطقي,
    مؤقت_ج: متجه طبيعي,
    مؤقت_د: متجه طبيعي
};

عام عرف مساحة_محسن_جديدة(): شفرة_محللة_آلة {
    دع ح: شفرة_محللة_آلة = {
        البدايات: [], أول_المعاملات: [], المواضع: [], الأنواع: [], يكمل: [], يتفرع: [], نقية: [], محذوفة: [],
        رأس: [], الكتلة: [], بدايات_الكتل: [], دوري: [], زيارة: [], بحث: 0, التعريفات: [], القراءات: [], نقلات_فقط: [],
        المعرفة_في: [], كتلة_التعريف: [], مقصودة: [], مثبت: [], مستبدلة: [], بديل_من: [], بديل_إلى: [], البدائل: [],
        أهداف_البدائل: [], مؤقت_أ: [], مؤقت_ب: [], مؤقت_ج: [], مؤقت_د: []
    };
    أرجع ح;
}

// Empties every buffer, keeping its storage.
عرف امسح_مساحة_محسن(ح: &متغير شفرة_محللة_آلة): فراغ {
    اقتطع((*ح).البدايات, 0); اقتطع((*ح).أول_المعاملات, 0); اقتطع((*ح).المواضع, 0); اقتطع((*ح).الأنواع, 0);
    اقتطع((*ح).يكمل, 0); اقتطع((*ح).يتفرع, 0); اقتطع((*ح).نقية, 0); اقتطع((*ح).محذوفة, 0);
    اقتطع((*ح).رأس, 0); اقتطع((*ح).الكتلة, 0); اقتطع((*ح).بدايات_الكتل, 0); اقتطع((*ح).دوري, 0);
    اقتطع((*ح).زيارة, 0); (*ح).بحث := 0; اقتطع((*ح).التعريفات, 0); اقتطع((*ح).القراءات, 0);
    اقتطع((*ح).نقلات_فقط, 0); اقتطع((*ح).المعرفة_في, 0); اقتطع((*ح).كتلة_التعريف, 0); اقتطع((*ح).مقصودة, 0);
    اقتطع((*ح).مثبت, 0); اقتطع((*ح).مستبدلة, 0); اقتطع((*ح).بديل_من, 0); اقتطع((*ح).بديل_إلى, 0);
    اقتطع((*ح).البدائل, 0); اقتطع((*ح).أهداف_البدائل, 0);
}

عرف أضف_معامل_محسن(ح: &متغير شفرة_محللة_آلة, الموضع: طبيعي, النوع: ط64): فراغ {
    ألحق((*ح).المواضع, الموضع);
    ألحق((*ح).الأنواع, النوع);
}

// A register operand, unless it is absent.
عرف أضف_سجل_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64, الموضع: طبيعي, النوع: ط64): فراغ {
    إذا ((*ش)[الموضع] != لا_سجل_محسن()) { أضف_معامل_محسن(ح, الموضع, النوع); };
}

// A call's arguments and result description from الموضع (machine_program.sn
// أصدر_حجج_وناتج_آلة); the position after them, 0 past the code.
عرف حلل_حجج_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64, الموضع: طبيعي): طبيعي {
    دع ن_ش: طبيعي = الطول(*ش) مثل طبيعي;
    إذا (الموضع >= ن_ش) { أرجع 0; };
    دع ن: طبيعي = (*ش)[الموضع] مثل طبيعي;
    دع م: متغير طبيعي = الموضع + 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        إذا (م + 4 > ن_ش) { أرجع 0; };
        أضف_سجل_محسن(ح, ش, م + 1, قراءة_محسن());
        م := م + 4 + ((*ش)[م + 3] مثل طبيعي);
        ف := ف + 1;
    }
    إذا (م + 4 > ن_ش) { أرجع 0; };
    دع النوع: ط64 = (*ش)[م];
    إذا (النوع == 1) {
        أضف_سجل_محسن(ح, ش, م + 1, كتابة_محسن());
    } وإلا إذا (النوع == 2 || النوع == 3) {
        أضف_سجل_محسن(ح, ش, م + 1, قراءة_محسن());
    };
    أرجع م + 4;
}

// A call's length from the position after it (0: past the code).
عرف طول_نداء_محسن(بعد: طبيعي, ب: طبيعي): طبيعي {
    إذا (بعد <= ب) { أرجع 0; };
    أرجع بعد - ب;
}

// Decodes the instruction at ب: its length, 0 for an unknown one.
عرف حلل_تعليمة_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64, ب: طبيعي): طبيعي {
    دع ن_ش: طبيعي = الطول(*ش) مثل طبيعي;
    دع ق_: ط64 = قراءة_محسن();
    دع ك_: ط64 = كتابة_محسن();
    دع الطول_: متغير طبيعي = 0;
    دع يكمل_: متغير منطقي = صواب;
    دع يتفرع_: متغير منطقي = خطأ;
    دع نقية_: متغير منطقي = خطأ;
    دع op: ط64 = (*ش)[ب];
    // Fixed lengths first, so operands are only read inside the code.
    دع ثابت: متغير طبيعي = 0;
    طابق op مثل ط32 مع
    | 1 -> { ثابت := 3; } | 2 -> { ثابت := 3; } | 3 -> { ثابت := 2; } | 4 -> { ثابت := 7; }
    | 5 -> { ثابت := 4; } | 50 -> { ثابت := 4; } | 75 -> { ثابت := 4; } | 76 -> { ثابت := 4; }
    | 73 -> { ثابت := 4; } | 74 -> { ثابت := 4; } | 67 -> { ثابت := 4; } | 68 -> { ثابت := 4; } | 69 -> { ثابت := 4; }
    | 6 -> { ثابت := 7; } | 7 -> { ثابت := 6; } | 8 -> { ثابت := 6; } | 9 -> { ثابت := 6; } | 10 -> { ثابت := 7; }
    | 11 -> { ثابت := 6; } | 51 -> { ثابت := 7; } | 52 -> { ثابت := 7; } | 49 -> { ثابت := 3; } | 34 -> { ثابت := 3; }
    | 12 -> { ثابت := 3; } | 13 -> { ثابت := 4; } | 14 -> { ثابت := 3; } | 15 -> { ثابت := 4; }
    | 16 -> { ثابت := 6; } | 17 -> { ثابت := 6; } | 18 -> { ثابت := 3; } | 19 -> { ثابت := 6; } | 20 -> { ثابت := 5; }
    | 21 -> { ثابت := 11; } | 22 -> { ثابت := 11; } | 23 -> { ثابت := 7; } | 24 -> { ثابت := 3; } | 25 -> { ثابت := 8; }
    | 26 -> { ثابت := 7; } | 27 -> { ثابت := 4; } | 28 -> { ثابت := 5; } | 29 -> { ثابت := 2; } | 31 -> { ثابت := 4; }
    | 35 -> { ثابت := 1; } | 36 -> { ثابت := 6; } | 37 -> { ثابت := 6; } | 38 -> { ثابت := 4; } | 39 -> { ثابت := 2; }
    | 40 -> { ثابت := 2; } | 41 -> { ثابت := 1; } | 42 -> { ثابت := 2; } | 43 -> { ثابت := 2; } | 44 -> { ثابت := 1; }
    | 45 -> { ثابت := 4; } | 46 -> { ثابت := 3; } | 47 -> { ثابت := 2; } | 48 -> { ثابت := 5; } | 53 -> { ثابت := 4; }
    | 54 -> { ثابت := 9; } | 55 -> { ثابت := 2; } | 56 -> { ثابت := 6; } | 57 -> { ثابت := 3; } | 58 -> { ثابت := 4; }
    | 59 -> { ثابت := 4; }
    | 102 -> { ثابت := 4; } | 103 -> { ثابت := 4; } | 104 -> { ثابت := 4; } | 105 -> { ثابت := 4; }
    | 106 -> { ثابت := 4; } | 107 -> { ثابت := 4; } | 108 -> { ثابت := 4; } | 113 -> { ثابت := 4; }
    | 109 -> { ثابت := 4; } | 110 -> { ثابت := 6; } | 111 -> { ثابت := 8; } | 112 -> { ثابت := 10; }
    | _ -> { أرجع 0; };
    إذا (ب + ثابت > ن_ش) { أرجع 0; };
    الطول_ := ثابت;
    طابق op مثل ط32 مع
    | 1 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); نقية_ := صواب; }
    | 2 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); نقية_ := صواب; }
    | 3 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); نقية_ := صواب; }
    | 4 -> { أضف_سجل_محسن(ح, ش, ب + 2, ك_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); أضف_سجل_محسن(ح, ش, ب + 4, ق_); }
    | 5 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 50 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 75 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 76 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 73 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); نقية_ := صواب; }
    | 74 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); نقية_ := صواب; }
    | 67 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); نقية_ := صواب; }
    | 68 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); نقية_ := صواب; }
    | 69 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); نقية_ := صواب; }
    | 6 -> { أضف_سجل_محسن(ح, ش, ب + 2, ك_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); نقية_ := صواب; }
    | 7 -> { أضف_سجل_محسن(ح, ش, ب + 2, ك_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); أضف_سجل_محسن(ح, ش, ب + 4, ق_); }
    | 8 -> { أضف_سجل_محسن(ح, ش, ب + 2, ك_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 9 -> { أضف_سجل_محسن(ح, ش, ب + 2, ك_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); أضف_سجل_محسن(ح, ش, ب + 4, ق_); }
    | 10 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); }
    | 11 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); نقية_ := صواب; }
    | 51 -> {
        أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_);
        أضف_معامل_محسن(ح, ب + 6, موضع_محسن()); يتفرع_ := صواب;
    }
    | 52 -> {
        أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_);
        أضف_معامل_محسن(ح, ب + 6, موضع_محسن()); يتفرع_ := صواب;
    }
    | 49 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_معامل_محسن(ح, ب + 2, موضع_محسن()); يتفرع_ := صواب; }
    | 34 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_معامل_محسن(ح, ب + 2, موضع_محسن()); يتفرع_ := صواب; }
    | 12 -> { أضف_سجل_محسن(ح, ش, ب + 1, قراءة_وكتابة_محسن()); أضف_سجل_محسن(ح, ش, ب + 2, ق_); نقية_ := صواب; }
    | 13 -> { أضف_سجل_محسن(ح, ش, ب + 1, قراءة_وكتابة_محسن()); أضف_سجل_محسن(ح, ش, ب + 2, ق_); }
    | 14 -> { أضف_سجل_محسن(ح, ش, ب + 1, قراءة_وكتابة_محسن()); أضف_سجل_محسن(ح, ش, ب + 2, ق_); نقية_ := صواب; }
    | 15 -> { أضف_سجل_محسن(ح, ش, ب + 1, قراءة_وكتابة_محسن()); أضف_سجل_محسن(ح, ش, ب + 2, ق_); }
    | 16 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); نقية_ := صواب; }
    | 17 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); نقية_ := صواب; }
    | 18 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); نقية_ := صواب; }
    | 19 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); }
    | 20 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); }
    | 21 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); }
    | 22 -> {
        أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_سجل_محسن(ح, ش, ب + 2, ق_);
        أضف_سجل_محسن(ح, ش, ب + 3, ق_); أضف_سجل_محسن(ح, ش, ب + 4, ق_);
    }
    | 23 -> { }
    | 24 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); }
    | 25 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 26 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 27 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_معامل_محسن(ح, ب + 3, زوج_محسن()); }
    | 28 -> {
        أضف_سجل_محسن(ح, ش, ب + 1, ق_);
        دع ن: طبيعي = (*ش)[ب + 2] مثل طبيعي;
        إذا (ب + 5 + ن > ن_ش) { أرجع 0; };
        أضف_معامل_محسن(ح, ب + 4, موضع_محسن());
        دع ف: متغير طبيعي = 0;
        طالما (ف < ن) { أضف_معامل_محسن(ح, ب + 5 + ف, موضع_محسن()); ف := ف + 1; }
        الطول_ := 5 + ن;
        يكمل_ := خطأ; يتفرع_ := صواب;
    }
    | 29 -> { أضف_معامل_محسن(ح, ب + 1, موضع_محسن()); يكمل_ := خطأ; يتفرع_ := صواب; }
    | 31 -> { أضف_معامل_محسن(ح, ب + 2, زوج_محسن()); أضف_معامل_محسن(ح, ب + 3, موضع_محسن()); يتفرع_ := صواب; }
    | 35 -> { يكمل_ := خطأ; يتفرع_ := صواب; }
    | 36 -> { أضف_سجل_محسن(ح, ش, ب + 2, ك_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); أضف_سجل_محسن(ح, ش, ب + 4, ق_); }
    | 37 -> {
        أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_);
        أضف_سجل_محسن(ح, ش, ب + 3, ق_); أضف_سجل_محسن(ح, ش, ب + 4, ق_);
    }
    | 38 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); }
    | 39 -> { الطول_ := طول_نداء_محسن(حلل_حجج_محسن(ح, ش, ب + 2), ب); }
    | 40 -> { الطول_ := طول_نداء_محسن(حلل_حجج_محسن(ح, ش, ب + 2), ب); }
    | 41 -> { الطول_ := طول_نداء_محسن(حلل_حجج_محسن(ح, ش, ب + 1), ب); }
    | 42 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); الطول_ := طول_نداء_محسن(حلل_حجج_محسن(ح, ش, ب + 2), ب); }
    | 43 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); الطول_ := طول_نداء_محسن(حلل_حجج_محسن(ح, ش, ب + 2), ب); }
    | 44 -> { يكمل_ := خطأ; يتفرع_ := صواب; }
    | 45 -> { أضف_سجل_محسن(ح, ش, ب + 2, ق_); يكمل_ := خطأ; يتفرع_ := صواب; }
    | 46 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); نقية_ := صواب; }
    | 47 -> { يكمل_ := خطأ; يتفرع_ := صواب; }
    | 48 -> { أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); أضف_سجل_محسن(ح, ش, ب + 4, ك_); }
    | 53 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ك_); }
    | 54 -> {
        دع ف: متغير طبيعي = 1;
        طالما (ف <= 7) { أضف_سجل_محسن(ح, ش, ب + ف, ق_); ف := ف + 1; }
        أضف_سجل_محسن(ح, ش, ب + 8, ك_);
    }
    | 55 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); }
    | 56 -> {
        أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_);
        أضف_سجل_محسن(ح, ش, ب + 3, ق_); أضف_سجل_محسن(ح, ش, ب + 4, ق_);
    }
    | 57 -> { أضف_سجل_محسن(ح, ش, ب + 2, ك_); }
    | 58 -> { أضف_سجل_محسن(ح, ش, ب + 1, ق_); أضف_معامل_محسن(ح, ب + 3, زوج_محسن()); }
    | 59 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_معامل_محسن(ح, ب + 3, زوج_محسن()); }
    | 102 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 103 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 104 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 113 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); أضف_سجل_محسن(ح, ش, ب + 3, ق_); }
    | 105 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); نقية_ := صواب; }
    | 106 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); نقية_ := صواب; }
    | 107 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); نقية_ := صواب; }
    | 108 -> { أضف_سجل_محسن(ح, ش, ب + 1, ك_); أضف_سجل_محسن(ح, ش, ب + 2, ق_); نقية_ := صواب; }
    | _ -> {
        // 109..112: calls with 0..3 one-word arguments, then the result.
        دع ن: طبيعي = (op - 109) مثل طبيعي;
        دع ف: متغير طبيعي = 0;
        طالما (ف < ن) { أضف_سجل_محسن(ح, ش, ب + 2 + 2 * ف, ق_); ف := ف + 1; }
        أضف_سجل_محسن(ح, ش, ب + 2 + 2 * ن, ك_);
    };
    إذا (الطول_ == 0 || ب + الطول_ > ن_ش) { أرجع 0; };
    ألحق((*ح).يكمل, يكمل_);
    ألحق((*ح).يتفرع, يتفرع_);
    ألحق((*ح).نقية, نقية_);
    أرجع الطول_;
}

// Decodes the function; false when it cannot be optimized.
عرف حلل_شفرة_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64, البداية: ط64, السجلات: ط64): منطقي {
    دع ن_ش: طبيعي = الطول(*ش) مثل طبيعي;
    دع ب: متغير طبيعي = 0;
    طالما (ب < ن_ش) {
        ألحق((*ح).البدايات, ب);
        ألحق((*ح).أول_المعاملات, الطول((*ح).المواضع) مثل طبيعي);
        دع ط: طبيعي = حلل_تعليمة_محسن(ح, ش, ب);
        إذا (ط == 0) { أرجع خطأ; };
        ب := ب + ط;
    }
    ألحق((*ح).البدايات, ن_ش);
    ألحق((*ح).أول_المعاملات, الطول((*ح).المواضع) مثل طبيعي);
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    // Every operand in range; positions made relative to the function.
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        ألحق((*ح).محذوفة, خطأ); ألحق((*ح).رأس, خطأ); ألحق((*ح).الكتلة, 0); ألحق((*ح).مقصودة, خطأ);
        ألحق((*ح).مستبدلة, خطأ); ألحق((*ح).بديل_من, 0); ألحق((*ح).بديل_إلى, 0);
        ف := ف + 1;
    }
    ألحق((*ح).رأس, خطأ);
    ألحق((*ح).مقصودة, خطأ);
    (*ح).رأس[0] := صواب;
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*ح).المواضع) مثل طبيعي)) {
        دع ق_: ط64 = (*ش)[(*ح).المواضع[ع]];
        إذا ((*ح).الأنواع[ع] == موضع_محسن()) {
            إذا (ق_ < البداية || ق_ - البداية >= (ن_ش مثل ط64)) { أرجع خطأ; };
            دع ك: متغير طبيعي = 0;
            إذا (!فهرس_تعليمة_محسن(ح, (ق_ - البداية) مثل طبيعي, &متغير ك)) { أرجع خطأ; };
            (*ح).رأس[ك] := صواب;
            (*ح).مقصودة[ك] := صواب;
        } وإلا إذا ((*ح).الأنواع[ع] == زوج_محسن()) {
            إذا (ق_ + 1 >= السجلات) { أرجع خطأ; };
        } وإلا {
            إذا (ق_ >= السجلات) { أرجع خطأ; };
        };
        ع := ع + 1;
    }
    // The instruction after one that may leave starts a block too.
    ف := 0;
    طالما (ف < ن) {
        إذا ((*ح).يتفرع[ف]) { (*ح).رأس[ف + 1] := صواب; };
        ف := ف + 1;
    }
    ف := 0;
    دع الكتلة: متغير طبيعي = 0;
    طالما (ف < ن) {
        إذا ((*ح).رأس[ف]) {
            إذا (ف != 0) { الكتلة := الكتلة + 1; };
            ألحق((*ح).بدايات_الكتل, ف);
            ألحق((*ح).دوري, 0);
            ألحق((*ح).زيارة, 0);
        };
        (*ح).الكتلة[ف] := الكتلة;
        ف := ف + 1;
    }
    ألحق((*ح).بدايات_الكتل, ن);
    // Registers.
    ف := 0;
    طالما (ف < (السجلات مثل طبيعي)) {
        ألحق((*ح).التعريفات, 0); ألحق((*ح).القراءات, 0); ألحق((*ح).نقلات_فقط, صواب);
        ألحق((*ح).المعرفة_في, 0); ألحق((*ح).مثبت, خطأ); ألحق((*ح).كتلة_التعريف, 0);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < ن) {
        دع ع_: متغير طبيعي = (*ح).أول_المعاملات[ف];
        طالما (ع_ < (*ح).أول_المعاملات[ف + 1]) {
            دع النوع: ط64 = (*ح).الأنواع[ع_];
            دع ر: طبيعي = (*ش)[(*ح).المواضع[ع_]] مثل طبيعي;
            إذا (النوع == زوج_محسن()) {
                (*ح).مثبت[ر] := صواب; (*ح).مثبت[ر + 1] := صواب;
            } وإلا إذا (النوع != موضع_محسن()) {
                إذا (النوع != كتابة_محسن()) { (*ح).القراءات[ر] := (*ح).القراءات[ر] + 1; };
                إذا (النوع != قراءة_محسن()) {
                    (*ح).التعريفات[ر] := (*ح).التعريفات[ر] + 1;
                    دع كتلة: ط64 = (*ح).الكتلة[ف] مثل ط64;
                    إذا ((*ح).التعريفات[ر] == 1) { (*ح).كتلة_التعريف[ر] := كتلة; }
                    وإلا إذا ((*ح).كتلة_التعريف[ر] != كتلة) { (*ح).كتلة_التعريف[ر] := لا_سجل_محسن(); };
                    (*ح).المعرفة_في[ر] := ف;
                    إذا ((*ش)[(*ح).البدايات[ف]] != 1) { (*ح).نقلات_فقط[ر] := خطأ; };
                };
            };
            ع_ := ع_ + 1;
        }
        ف := ف + 1;
    }
    أرجع صواب;
}

// The instruction starting at word الموضع.
عرف فهرس_تعليمة_محسن(ح: &شفرة_محللة_آلة, الموضع: طبيعي, الناتج: &متغير طبيعي): منطقي {
    دع أدنى: متغير طبيعي = 0;
    دع أعلى: متغير طبيعي = الطول((*ح).البدايات) مثل طبيعي;
    طالما (أدنى + 1 < أعلى) {
        دع وسط: طبيعي = (أدنى + أعلى) / 2;
        إذا ((*ح).البدايات[وسط] <= الموضع) { أدنى := وسط; } وإلا { أعلى := وسط; };
    }
    إذا ((*ح).البدايات[أدنى] != الموضع) { أرجع خطأ; };
    *الناتج := أدنى;
    أرجع صواب;
}

// The blocks control may go to from block ك.
عرف تالية_كتلة_محسن(ح: &شفرة_محللة_آلة, ش: &متجه ط64, البداية: ط64, ك: طبيعي, الناتج: &متغير متجه طبيعي): فراغ {
    دع آخر: طبيعي = (*ح).بدايات_الكتل[ك + 1] - 1;
    دع ع: متغير طبيعي = (*ح).أول_المعاملات[آخر];
    طالما (ع < (*ح).أول_المعاملات[آخر + 1]) {
        إذا ((*ح).الأنواع[ع] == موضع_محسن()) {
            دع ت: متغير طبيعي = 0;
            إذا (فهرس_تعليمة_محسن(ح, ((*ش)[(*ح).المواضع[ع]] - البداية) مثل طبيعي, &متغير ت)) {
                ألحق(*الناتج, (*ح).الكتلة[ت]);
            };
        };
        ع := ع + 1;
    }
    إذا ((*ح).يكمل[آخر] && آخر + 1 < (الطول((*ح).البدايات) مثل طبيعي) - 1) {
        ألحق(*الناتج, (*ح).الكتلة[آخر + 1]);
    };
}

// Whether block ك can reach itself (so its instructions may run more than
// once per call).
عرف كتلة_دورية_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64, البداية: ط64, ك: طبيعي): منطقي {
    إذا ((*ح).دوري[ك] != 0) { أرجع (*ح).دوري[ك] == 2; };
    (*ح).بحث := (*ح).بحث + 1;
    دع البحث: ط64 = (*ح).بحث;
    دع القائمة: متغير متجه طبيعي = [];
    بدّل(القائمة, (*ح).مؤقت_د);
    اقتطع(القائمة, 0);
    تالية_كتلة_محسن(ح, ش, البداية, ك, &متغير القائمة);
    دع وجد: متغير منطقي = خطأ;
    طالما (!وجد && (الطول(القائمة) مثل طبيعي) > 0) {
        دع ت: متغير طبيعي = 0;
        طابق أزل_الأخير(القائمة) مع
        | اختياري.موجود(ق_) -> { ت := ق_; }
        | اختياري.لا_شيء -> { };
        إذا (ت == ك) { وجد := صواب; } وإلا إذا ((*ح).زيارة[ت] != البحث) {
            (*ح).زيارة[ت] := البحث;
            تالية_كتلة_محسن(ح, ش, البداية, ت, &متغير القائمة);
        };
    }
    إذا (وجد) { (*ح).دوري[ك] := 2; } وإلا { (*ح).دوري[ك] := 1; };
    بدّل(القائمة, (*ح).مؤقت_د);
    أرجع وجد;
}

// The register in operand ع.
عرف سجل_معامل_محسن(ح: &شفرة_محللة_آلة, ش: &متجه ط64, ع: طبيعي): طبيعي {
    أرجع (*ش)[(*ح).المواضع[ع]] مثل طبيعي;
}

عرف احذف_تعليمة_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64, ف: طبيعي): فراغ {
    (*ح).محذوفة[ف] := صواب;
    دع ع: متغير طبيعي = (*ح).أول_المعاملات[ف];
    طالما (ع < (*ح).أول_المعاملات[ف + 1]) {
        دع النوع: ط64 = (*ح).الأنواع[ع];
        إذا (النوع == قراءة_محسن() || النوع == كتابة_محسن() || النوع == قراءة_وكتابة_محسن()) {
            دع ر: طبيعي = سجل_معامل_محسن(ح, ش, ع);
            إذا (النوع != كتابة_محسن()) { (*ح).القراءات[ر] := (*ح).القراءات[ر] - 1; };
            إذا (النوع != قراءة_محسن()) { (*ح).التعريفات[ر] := (*ح).التعريفات[ر] - 1; };
        };
        ع := ع + 1;
    }
}

// Whether register س, every definition of it in one block, keeps its last
// value once defined: the block runs at most once per call, and no move
// there copies an earlier value of it.
عرف مصدر_ثابت_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64, البداية: ط64, س: طبيعي): منطقي {
    دع الأخير: طبيعي = (*ح).المعرفة_في[س];
    دع الكتلة: طبيعي = (*ح).الكتلة[الأخير];
    إذا (كتلة_دورية_محسن(ح, ش, البداية, الكتلة)) { أرجع خطأ; };
    دع ف: متغير طبيعي = (*ح).بدايات_الكتل[الكتلة];
    طالما (ف < الأخير) {
        دع ب: طبيعي = (*ح).البدايات[ف];
        إذا ((*ش)[ب] == 1 && (*ش)[ب + 2] == (س مثل ط64)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Copy webs: القيم[r] is the value r always holds (a register), or
// لا_سجل_محسن() when r is not a copy (or not yet known: علم_مجهول).
عرف اجمع_شبكات_النسخ_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متغير متجه ط64, البداية: ط64): فراغ {
    دع ن_س: طبيعي = الطول((*ح).التعريفات) مثل طبيعي;
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع مجهول: ط64 = لا_سجل_محسن() - 1;
    دع لا_: ط64 = لا_سجل_محسن();
    دع القيم: متغير متجه ط64 = [];
    بدّل(القيم, (*ح).مؤقت_أ);
    اقتطع(القيم, 0);
    دع ر: متغير طبيعي = 0;
    طالما (ر < ن_س) {
        دع ق_: متغير ط64 = لا_;
        إذا (!(*ح).مثبت[ر] && (*ح).التعريفات[ر] > 0) {
            إذا ((*ح).نقلات_فقط[ر]) { ق_ := مجهول; }
            وإلا إذا ((*ح).كتلة_التعريف[ر] != لا_) { ق_ := ر مثل ط64; };
        };
        ألحق(القيم, ق_);
        ر := ر + 1;
    }
    // Optimistic values, then a check of each value found: a register
    // defined once by an instruction that may run again (in a loop) is no
    // web's value; without it the webs are found again.
    دع تحقق: متغير متجه منطقي = [];
    بدّل(تحقق, (*ح).مؤقت_ب);
    اقتطع(تحقق, 0);
    ر := 0;
    طالما (ر < ن_س) { ألحق(تحقق, خطأ); ر := ر + 1; }
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        مستمر := خطأ;
        دع تغير: متغير منطقي = صواب;
        طالما (تغير) {
            تغير := خطأ;
            دع ف: متغير طبيعي = 0;
            طالما (ف < ن) {
                دع ب: طبيعي = (*ح).البدايات[ف];
                إذا ((*ش)[ب] == 1) {
                    دع و: طبيعي = (*ش)[ب + 1] مثل طبيعي;
                    دع م: طبيعي = (*ش)[ب + 2] مثل طبيعي;
                    دع قيمة: ط64 = القيم[و];
                    إذا (قيمة != لا_ && (*ح).نقلات_فقط[و] && م != و) {
                        دع قيمة_م: ط64 = القيم[م];
                        دع جديدة: متغير ط64 = قيمة;
                        إذا (قيمة_م == لا_) { جديدة := لا_; }
                        وإلا إذا (قيمة_م != مجهول) {
                            إذا (قيمة == مجهول) { جديدة := قيمة_م; }
                            وإلا إذا (قيمة != قيمة_م) { جديدة := لا_; };
                        };
                        إذا (جديدة != قيمة) { القيم[و] := جديدة; تغير := صواب; };
                    };
                };
                ف := ف + 1;
            }
        }
        ر := 0;
        طالما (ر < ن_س) {
            دع قيمة: ط64 = القيم[ر];
            إذا ((*ح).نقلات_فقط[ر] && قيمة != لا_ && قيمة != مجهول && !تحقق[قيمة مثل طبيعي]) {
                دع س: طبيعي = قيمة مثل طبيعي;
                تحقق[س] := صواب;
                إذا (!مصدر_ثابت_محسن(ح, ش, البداية, س)) {
                    القيم[س] := لا_;
                    مستمر := صواب;
                };
            };
            ر := ر + 1;
        }
        إذا (مستمر) {
            ر := 0;
            طالما (ر < ن_س) {
                إذا (!(*ح).مثبت[ر] && (*ح).التعريفات[ر] > 0 && (*ح).نقلات_فقط[ر]) { القيم[ر] := مجهول; };
                ر := ر + 1;
            }
        };
    }
    // Reads of a web's registers read its value; its moves go.
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع ع: متغير طبيعي = (*ح).أول_المعاملات[ف];
        طالما (ع < (*ح).أول_المعاملات[ف + 1]) {
            إذا ((*ح).الأنواع[ع] == قراءة_محسن()) {
                دع س: طبيعي = سجل_معامل_محسن(ح, ش, ع);
                دع قيمة: ط64 = القيم[س];
                إذا ((*ح).نقلات_فقط[س] && قيمة != لا_ && قيمة != مجهول && قيمة != (س مثل ط64)) {
                    (*ش)[(*ح).المواضع[ع]] := قيمة;
                    (*ح).القراءات[س] := (*ح).القراءات[س] - 1;
                    (*ح).القراءات[قيمة مثل طبيعي] := (*ح).القراءات[قيمة مثل طبيعي] + 1;
                };
            };
            ع := ع + 1;
        }
        ف := ف + 1;
    }
    بدّل(القيم, (*ح).مؤقت_أ);
    بدّل(تحقق, (*ح).مؤقت_ب);
}

// Removes the moves of a register to itself and every instruction without
// effects whose written registers are never read.
عرف احذف_الميتة_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64): فراغ {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        دع ف: متغير طبيعي = ن;
        طالما (ف > 0) {
            ف := ف - 1;
            إذا (!(*ح).محذوفة[ف] && (*ح).نقية[ف] && !(*ح).مستبدلة[ف]) {
                دع ب: طبيعي = (*ح).البدايات[ف];
                دع ميتة: متغير منطقي = صواب;
                إذا ((*ش)[ب] == 1 && (*ش)[ب + 1] == (*ش)[ب + 2]) { ميتة := صواب; } وإلا {
                    دع ع: متغير طبيعي = (*ح).أول_المعاملات[ف];
                    طالما (ع < (*ح).أول_المعاملات[ف + 1]) {
                        دع النوع: ط64 = (*ح).الأنواع[ع];
                        إذا (النوع == كتابة_محسن()) {
                            دع ر: طبيعي = سجل_معامل_محسن(ح, ش, ع);
                            إذا ((*ح).القراءات[ر] != 0 || (*ح).مثبت[ر]) { ميتة := خطأ; };
                        } وإلا إذا (النوع == قراءة_وكتابة_محسن() || النوع == زوج_محسن()) {
                            ميتة := خطأ;
                        };
                        ع := ع + 1;
                    }
                };
                إذا (ميتة) { احذف_تعليمة_محسن(ح, ش, ف); تغير := صواب; };
            };
        }
    }
}

// Whether instruction ف reads or writes register ر (any operand).
عرف تلمس_سجلا_محسن(ح: &شفرة_محللة_آلة, ش: &متجه ط64, ف: طبيعي, ر: طبيعي, كتابة_فقط: منطقي): منطقي {
    دع ع: متغير طبيعي = (*ح).أول_المعاملات[ف];
    طالما (ع < (*ح).أول_المعاملات[ف + 1]) {
        دع النوع: ط64 = (*ح).الأنواع[ع];
        إذا (النوع == زوج_محسن()) {
            دع ق_: طبيعي = سجل_معامل_محسن(ح, ش, ع);
            إذا (ق_ == ر || ق_ + 1 == ر) { أرجع صواب; };
        } وإلا إذا (النوع != موضع_محسن() && !(كتابة_فقط && النوع == قراءة_محسن())) {
            إذا (سجل_معامل_محسن(ح, ش, ع) == ر) { أرجع صواب; };
        };
        ع := ع + 1;
    }
    أرجع خطأ;
}

// Whether instruction ف computes its one written register from operands it
// reads first (so it may write a register it reads).
عرف تعريف_بسيط_محسن(op: ط64): منطقي {
    طابق op مثل ط32 مع
    | 1 -> { أرجع صواب; } | 2 -> { أرجع صواب; } | 3 -> { أرجع صواب; } | 4 -> { أرجع صواب; }
    | 5 -> { أرجع صواب; } | 50 -> { أرجع صواب; } | 75 -> { أرجع صواب; } | 76 -> { أرجع صواب; }
    | 73 -> { أرجع صواب; } | 74 -> { أرجع صواب; } | 67 -> { أرجع صواب; } | 68 -> { أرجع صواب; } | 69 -> { أرجع صواب; }
    | 6 -> { أرجع صواب; } | 7 -> { أرجع صواب; } | 8 -> { أرجع صواب; } | 9 -> { أرجع صواب; } | 10 -> { أرجع صواب; }
    | 11 -> { أرجع صواب; } | 16 -> { أرجع صواب; } | 17 -> { أرجع صواب; } | 18 -> { أرجع صواب; }
    | 25 -> { أرجع صواب; } | 46 -> { أرجع صواب; }
    | 102 -> { أرجع صواب; } | 103 -> { أرجع صواب; } | 104 -> { أرجع صواب; } | 105 -> { أرجع صواب; }
    | 106 -> { أرجع صواب; } | 107 -> { أرجع صواب; } | 108 -> { أرجع صواب; } | 113 -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Coalescing: `d := op ...; ...; p := d` in one block, d read only up to the
// move, p neither read nor written in between: op writes p, the move goes.
عرف ادمج_النقلات_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متغير متجه ط64): فراغ {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع ي: متغير طبيعي = 0;
    طالما (ي < ن) {
        دع ب: طبيعي = (*ح).البدايات[ي];
        إذا (!(*ح).محذوفة[ي] && (*ش)[ب] == 1 && (*ش)[ب + 1] != (*ش)[ب + 2]) {
            دع ص: طبيعي = (*ش)[ب + 1] مثل طبيعي;
            دع د: طبيعي = (*ش)[ب + 2] مثل طبيعي;
            إذا ((*ح).التعريفات[د] == 1 && !(*ح).مثبت[د] && !(*ح).مثبت[ص]) {
                دع ف: طبيعي = (*ح).المعرفة_في[د];
                دع ب_ف: طبيعي = (*ح).البدايات[ف];
                إذا (ف < ي && !(*ح).محذوفة[ف] && (*ح).الكتلة[ف] == (*ح).الكتلة[ي] && تعريف_بسيط_محسن((*ش)[ب_ف])) {
                    // d's reads between, p untouched between.
                    دع قراءات: متغير ط64 = 0;
                    دع ممكن: متغير منطقي = صواب;
                    دع ك: متغير طبيعي = ف + 1;
                    طالما (ممكن && ك < ي) {
                        إذا (!(*ح).محذوفة[ك]) {
                            إذا (تلمس_سجلا_محسن(ح, ش, ك, ص, خطأ)) { ممكن := خطأ; };
                            دع ع: متغير طبيعي = (*ح).أول_المعاملات[ك];
                            طالما (ع < (*ح).أول_المعاملات[ك + 1]) {
                                إذا ((*ح).الأنواع[ع] == قراءة_محسن() && سجل_معامل_محسن(ح, ش, ع) == د) { قراءات := قراءات + 1; };
                                ع := ع + 1;
                            }
                        };
                        ك := ك + 1;
                    }
                    // The move's own read of d.
                    إذا (ممكن && قراءات + 1 == (*ح).القراءات[د]) {
                        // The definition's operand: the one write of d.
                        دع ع: متغير طبيعي = (*ح).أول_المعاملات[ف];
                        طالما (ع < (*ح).أول_المعاملات[ف + 1]) {
                            إذا ((*ح).الأنواع[ع] == كتابة_محسن() && سجل_معامل_محسن(ح, ش, ع) == د) {
                                (*ش)[(*ح).المواضع[ع]] := ص مثل ط64;
                            };
                            ع := ع + 1;
                        }
                        ك := ف + 1;
                        طالما (ك < ي) {
                            إذا (!(*ح).محذوفة[ك]) {
                                دع ع_: متغير طبيعي = (*ح).أول_المعاملات[ك];
                                طالما (ع_ < (*ح).أول_المعاملات[ك + 1]) {
                                    إذا ((*ح).الأنواع[ع_] == قراءة_محسن() && سجل_معامل_محسن(ح, ش, ع_) == د) {
                                        (*ش)[(*ح).المواضع[ع_]] := ص مثل ط64;
                                    };
                                    ع_ := ع_ + 1;
                                }
                            };
                            ك := ك + 1;
                        }
                        (*ح).القراءات[ص] := (*ح).القراءات[ص] + قراءات;
                        (*ح).القراءات[د] := 0;
                        (*ح).التعريفات[د] := 0;
                        // The move is now p := p.
                        (*ح).محذوفة[ي] := صواب;
                        (*ح).نقلات_فقط[ص] := خطأ;
                        (*ح).المعرفة_في[ص] := ف;
                    };
                };
            };
        };
        ي := ي + 1;
    }
}

// Forward copies: after `p := s`, a read of p in the same block reads s
// while neither is written.
عرف مرر_النسخ_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متغير متجه ط64): فراغ {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع ي: متغير طبيعي = 0;
    طالما (ي < ن) {
        دع ب: طبيعي = (*ح).البدايات[ي];
        إذا (!(*ح).محذوفة[ي] && (*ش)[ب] == 1 && (*ش)[ب + 1] != (*ش)[ب + 2]) {
            دع ص: طبيعي = (*ش)[ب + 1] مثل طبيعي;
            دع س: طبيعي = (*ش)[ب + 2] مثل طبيعي;
            إذا (!(*ح).مثبت[ص] && !(*ح).مثبت[س]) {
                دع ك: متغير طبيعي = ي + 1;
                دع مستمر: متغير منطقي = صواب;
                طالما (مستمر && ك < ن && !(*ح).رأس[ك]) {
                    إذا (!(*ح).محذوفة[ك]) {
                        دع ع: متغير طبيعي = (*ح).أول_المعاملات[ك];
                        طالما (ع < (*ح).أول_المعاملات[ك + 1]) {
                            إذا ((*ح).الأنواع[ع] == قراءة_محسن() && سجل_معامل_محسن(ح, ش, ع) == ص) {
                                (*ش)[(*ح).المواضع[ع]] := س مثل ط64;
                                (*ح).القراءات[ص] := (*ح).القراءات[ص] - 1;
                                (*ح).القراءات[س] := (*ح).القراءات[س] + 1;
                            };
                            ع := ع + 1;
                        }
                        إذا (تلمس_سجلا_محسن(ح, ش, ك, ص, صواب) || تلمس_سجلا_محسن(ح, ش, ك, س, صواب)) { مستمر := خطأ; };
                    };
                    ك := ك + 1;
                }
            };
        };
        ي := ي + 1;
    }
}

// ---- Replacements ---------------------------------------------------------------

// Starts the replacement of instruction ف; its words follow by أضف_بديل_محسن.
عرف ابدأ_بديل_محسن(ح: &متغير شفرة_محللة_آلة, ف: طبيعي): فراغ {
    (*ح).مستبدلة[ف] := صواب;
    (*ح).بديل_من[ف] := الطول((*ح).البدائل) مثل طبيعي;
    (*ح).بديل_إلى[ف] := الطول((*ح).البدائل) مثل طبيعي;
}

عرف أضف_بديل_محسن(ح: &متغير شفرة_محللة_آلة, ف: طبيعي, الكلمة: ط64, هدف: منطقي): فراغ {
    ألحق((*ح).البدائل, الكلمة);
    ألحق((*ح).أهداف_البدائل, هدف);
    (*ح).بديل_إلى[ف] := الطول((*ح).البدائل) مثل طبيعي;
}

// The instruction's words now: its replacement, else its own.
عرف كلمات_تعليمة_محسن(ح: &شفرة_محللة_آلة, ش: &متجه ط64, ف: طبيعي, الكلمات: &متغير متجه ط64, الأهداف: &متغير متجه منطقي): فراغ {
    إذا ((*ح).مستبدلة[ف]) {
        دع ك: متغير طبيعي = (*ح).بديل_من[ف];
        طالما (ك < (*ح).بديل_إلى[ف]) {
            ألحق(*الكلمات, (*ح).البدائل[ك]); ألحق(*الأهداف, (*ح).أهداف_البدائل[ك]);
            ك := ك + 1;
        }
        أرجع;
    };
    دع ب: طبيعي = (*ح).البدايات[ف];
    دع أساس: طبيعي = الطول(*الكلمات) مثل طبيعي;
    دع ك: متغير طبيعي = ب;
    طالما (ك < (*ح).البدايات[ف + 1]) { ألحق(*الكلمات, (*ش)[ك]); ألحق(*الأهداف, خطأ); ك := ك + 1; }
    دع ع: متغير طبيعي = (*ح).أول_المعاملات[ف];
    طالما (ع < (*ح).أول_المعاملات[ف + 1]) {
        إذا ((*ح).الأنواع[ع] == موضع_محسن()) { (*الأهداف)[أساس + ((*ح).المواضع[ع] - ب)] := صواب; };
        ع := ع + 1;
    }
}

// ---- Immediates and 64-bit compare-and-branch ------------------------------------
//
// New forms (machine_engine.sn): 77..80 checked add/subtract with an
// immediate (unsigned add, unsigned subtract, signed add, signed subtract:
// d, a, k), 81 wrapping add of an immediate (d, a, k), 82..87 branch when a
// 64-bit comparison of two registers holds (=, !=, <u, <=u, <s, <=s: a, b,
// target), 88..97 the same against an immediate (=, !=, <u, <=u, >u, >=u,
// <s, <=s, >s, >=s: a, k, target), 98..101 a narrow = or != under a mask
// (98 a, b, mask, target when equal; 99 when not; 100 a, k, mask, target
// when a's masked bits are k; 101 when not). A compare-and-branch takes such
// a form only when its truth value is never read.

// The value of register ر when it is defined once, by an immediate.
عرف ثابت_سجل_محسن(ح: &شفرة_محللة_آلة, ش: &متجه ط64, ر: طبيعي, الناتج: &متغير ط64): منطقي {
    إذا ((*ح).التعريفات[ر] != 1 || (*ح).مثبت[ر]) { أرجع خطأ; };
    دع ف: طبيعي = (*ح).المعرفة_في[ر];
    إذا ((*ح).محذوفة[ف] || (*ح).مستبدلة[ف]) { أرجع خطأ; };
    دع ب: طبيعي = (*ح).البدايات[ف];
    إذا ((*ش)[ب] != 2 || (*ش)[ب + 1] != (ر مثل ط64)) { أرجع خطأ; };
    *الناتج := (*ش)[ب + 2];
    أرجع صواب;
}

// The condition with its operands swapped (a c b == b c' a).
عرف بدل_شرط_محسن(الشرط: ط64): ط64 {
    طابق الشرط مثل ط32 مع
    | 2 -> { أرجع 4; } | 3 -> { أرجع 5; } | 4 -> { أرجع 2; } | 5 -> { أرجع 3; }
    | 6 -> { أرجع 8; } | 7 -> { أرجع 9; } | 8 -> { أرجع 6; } | 9 -> { أرجع 7; }
    | _ -> { أرجع الشرط; };
}

// The negated condition.
عرف انف_شرط_محسن(الشرط: ط64): ط64 {
    طابق الشرط مثل ط32 مع
    | 0 -> { أرجع 1; } | 1 -> { أرجع 0; } | 2 -> { أرجع 5; } | 3 -> { أرجع 4; } | 4 -> { أرجع 3; }
    | 5 -> { أرجع 2; } | 6 -> { أرجع 9; } | 7 -> { أرجع 8; } | 8 -> { أرجع 7; } | _ -> { أرجع 6; };
}

// The immediate branch op for a condition (0 =, 1 !=, 2 <s, 3 <=s, 4 >s,
// 5 >=s, 6 <u, 7 <=u, 8 >u, 9 >=u).
عرف فرع_فوري_محسن(الشرط: ط64): ط64 {
    طابق الشرط مثل ط32 مع
    | 0 -> { أرجع 88; } | 1 -> { أرجع 89; } | 2 -> { أرجع 94; } | 3 -> { أرجع 95; } | 4 -> { أرجع 96; }
    | 5 -> { أرجع 97; } | 6 -> { أرجع 90; } | 7 -> { أرجع 91; } | 8 -> { أرجع 92; } | _ -> { أرجع 93; };
}

عرف اطو_الثوابت_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متغير متجه ط64): فراغ {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع ب: طبيعي = (*ح).البدايات[ف];
        دع op: ط64 = (*ش)[ب];
        إذا (!(*ح).محذوفة[ف] && !(*ح).مستبدلة[ف]) {
            دع ك: متغير ط64 = 0;
            إذا (op == 5 || op == 50 || op == 75 || op == 76 || op == 73 || op == 74) {
                دع أ: طبيعي = (*ش)[ب + 2] مثل طبيعي;
                دع ب_: طبيعي = (*ش)[ب + 3] مثل طبيعي;
                دع جديد: متغير ط64 = 77;
                إذا (op == 50) { جديد := 78; } وإلا إذا (op == 75) { جديد := 79; } وإلا إذا (op == 76) { جديد := 80; }
                وإلا إذا (op == 73 || op == 74) { جديد := 81; };
                دع تبادلي: منطقي = op == 5 || op == 75 || op == 73;
                إذا (ثابت_سجل_محسن(ح, ش, ب_, &متغير ك)) {
                    إذا (op == 74) { ك := طرح_ملتف_محسن(0 مثل ط64, ك); };
                    ابدأ_بديل_محسن(ح, ف);
                    أضف_بديل_محسن(ح, ف, جديد, خطأ); أضف_بديل_محسن(ح, ف, (*ش)[ب + 1], خطأ);
                    أضف_بديل_محسن(ح, ف, أ مثل ط64, خطأ); أضف_بديل_محسن(ح, ف, ك, خطأ);
                    (*ح).القراءات[ب_] := (*ح).القراءات[ب_] - 1;
                } وإلا إذا (تبادلي && ثابت_سجل_محسن(ح, ش, أ, &متغير ك)) {
                    ابدأ_بديل_محسن(ح, ف);
                    أضف_بديل_محسن(ح, ف, جديد, خطأ); أضف_بديل_محسن(ح, ف, (*ش)[ب + 1], خطأ);
                    أضف_بديل_محسن(ح, ف, ب_ مثل ط64, خطأ); أضف_بديل_محسن(ح, ف, ك, خطأ);
                    (*ح).القراءات[أ] := (*ح).القراءات[أ] - 1;
                };
            } وإلا إذا (op == 16 && (*ش)[ب + 2] != لا_سجل_محسن() && (*ش)[ب + 3] == لا_سجل_محسن()) {
                ابدأ_بديل_محسن(ح, ف);
                أضف_بديل_محسن(ح, ف, 81, خطأ); أضف_بديل_محسن(ح, ف, (*ش)[ب + 1], خطأ);
                أضف_بديل_محسن(ح, ف, (*ش)[ب + 2], خطأ); أضف_بديل_محسن(ح, ف, (*ش)[ب + 5], خطأ);
            } وإلا إذا (op == 49 || op == 34) {
                // A branch on a constant: a jump, or nothing.
                دع ر: طبيعي = (*ش)[ب + 1] مثل طبيعي;
                إذا (ثابت_سجل_محسن(ح, ش, ر, &متغير ك)) {
                    دع يقفز: منطقي = ((ك & 0xFF) == 0) == (op == 49);
                    إذا (يقفز) {
                        ابدأ_بديل_محسن(ح, ف);
                        أضف_بديل_محسن(ح, ف, 29, خطأ); أضف_بديل_محسن(ح, ف, (*ش)[ب + 2], صواب);
                        (*ح).القراءات[ر] := (*ح).القراءات[ر] - 1;
                    } وإلا { احذف_تعليمة_محسن(ح, ش, ف); };
                };
            } وإلا إذا ((op == 51 || op == 52) && (*ش)[ب + 5] < 64 && (*ش)[ب + 5] > 0
                && ((*ش)[ب + 4] == 0 || (*ش)[ب + 4] == 1)) {
                // Narrow = and != under the width's mask.
                دع د: طبيعي = (*ش)[ب + 1] مثل طبيعي;
                إذا ((*ح).القراءات[د] == 0 && !(*ح).مثبت[د]) {
                    دع أ: طبيعي = (*ش)[ب + 2] مثل طبيعي;
                    دع ب_: طبيعي = (*ش)[ب + 3] مثل طبيعي;
                    دع القناع: ط64 = ((1 مثل ط64) << (*ش)[ب + 5]) - 1;
                    // Branch when equal: 51 on =, 52 on !=.
                    دع عند_التساوي: منطقي = ((*ش)[ب + 4] == 0) == (op == 51);
                    ابدأ_بديل_محسن(ح, ف);
                    إذا (ثابت_سجل_محسن(ح, ش, ب_, &متغير ك) || ثابت_سجل_محسن(ح, ش, أ, &متغير ك)) {
                        دع ر: متغير طبيعي = أ;
                        دع ث: متغير طبيعي = ب_;
                        إذا (!ثابت_سجل_محسن(ح, ش, ب_, &متغير ك)) { ر := ب_; ث := أ; };
                        إذا (عند_التساوي) { أضف_بديل_محسن(ح, ف, 100, خطأ); } وإلا { أضف_بديل_محسن(ح, ف, 101, خطأ); };
                        أضف_بديل_محسن(ح, ف, ر مثل ط64, خطأ); أضف_بديل_محسن(ح, ف, ك & القناع, خطأ);
                        (*ح).القراءات[ث] := (*ح).القراءات[ث] - 1;
                    } وإلا {
                        إذا (عند_التساوي) { أضف_بديل_محسن(ح, ف, 98, خطأ); } وإلا { أضف_بديل_محسن(ح, ف, 99, خطأ); };
                        أضف_بديل_محسن(ح, ف, أ مثل ط64, خطأ); أضف_بديل_محسن(ح, ف, ب_ مثل ط64, خطأ);
                    };
                    أضف_بديل_محسن(ح, ف, القناع, خطأ);
                    أضف_بديل_محسن(ح, ف, (*ش)[ب + 6], صواب);
                    (*ح).التعريفات[د] := (*ح).التعريفات[د] - 1;
                };
            } وإلا إذا ((op == 51 || op == 52) && (*ش)[ب + 5] == 64) {
                دع د: طبيعي = (*ش)[ب + 1] مثل طبيعي;
                إذا ((*ح).القراءات[د] == 0 && !(*ح).مثبت[د]) {
                    دع أ: طبيعي = (*ش)[ب + 2] مثل طبيعي;
                    دع ب_: طبيعي = (*ش)[ب + 3] مثل طبيعي;
                    دع الشرط: متغير ط64 = (*ش)[ب + 4];
                    إذا (op == 52) { الشرط := انف_شرط_محسن(الشرط); };
                    ابدأ_بديل_محسن(ح, ف);
                    إذا (ثابت_سجل_محسن(ح, ش, ب_, &متغير ك)) {
                        أضف_بديل_محسن(ح, ف, فرع_فوري_محسن(الشرط), خطأ);
                        أضف_بديل_محسن(ح, ف, أ مثل ط64, خطأ); أضف_بديل_محسن(ح, ف, ك, خطأ);
                        (*ح).القراءات[ب_] := (*ح).القراءات[ب_] - 1;
                    } وإلا إذا (ثابت_سجل_محسن(ح, ش, أ, &متغير ك)) {
                        أضف_بديل_محسن(ح, ف, فرع_فوري_محسن(بدل_شرط_محسن(الشرط)), خطأ);
                        أضف_بديل_محسن(ح, ف, ب_ مثل ط64, خطأ); أضف_بديل_محسن(ح, ف, ك, خطأ);
                        (*ح).القراءات[أ] := (*ح).القراءات[أ] - 1;
                    } وإلا {
                        // Registers: >, >= by swapping the operands.
                        دع س: متغير ط64 = أ مثل ط64;
                        دع ص: متغير ط64 = ب_ مثل ط64;
                        إذا (الشرط == 4 || الشرط == 5 || الشرط == 8 || الشرط == 9) {
                            الشرط := بدل_شرط_محسن(الشرط); س := ب_ مثل ط64; ص := أ مثل ط64;
                        };
                        دع جديد: متغير ط64 = 82;
                        إذا (الشرط == 1) { جديد := 83; } وإلا إذا (الشرط == 6) { جديد := 84; }
                        وإلا إذا (الشرط == 7) { جديد := 85; } وإلا إذا (الشرط == 2) { جديد := 86; }
                        وإلا إذا (الشرط == 3) { جديد := 87; };
                        أضف_بديل_محسن(ح, ف, جديد, خطأ);
                        أضف_بديل_محسن(ح, ف, س, خطأ); أضف_بديل_محسن(ح, ف, ص, خطأ);
                    };
                    أضف_بديل_محسن(ح, ف, (*ش)[ب + 6], صواب);
                    (*ح).التعريفات[د] := (*ح).التعريفات[د] - 1;
                };
            };
        };
        ف := ف + 1;
    }
}

// The kept instruction before ف, ن when there is none.
عرف سابقة_محسن(ح: &شفرة_محللة_آلة, ف: طبيعي): طبيعي {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع ق_: متغير طبيعي = ف;
    طالما (ق_ > 0) {
        ق_ := ق_ - 1;
        إذا (!(*ح).محذوفة[ق_]) { أرجع ق_; };
    }
    أرجع ن;
}

// Whether a code position lands on instruction ف: it names ف, or a removed
// instruction right before it (control at a removed one goes on to the next
// kept one). Such an instruction does something for the code that goes to
// it, so it is kept even when the instruction before it would not need it.
عرف مبلوغة_بموضع_محسن(ح: &شفرة_محللة_آلة, ف: طبيعي): منطقي {
    إذا ((*ح).مقصودة[ف]) { أرجع صواب; };
    دع ق_: متغير طبيعي = ف;
    طالما (ق_ > 0 && (*ح).محذوفة[ق_ - 1]) {
        ق_ := ق_ - 1;
        إذا ((*ح).مقصودة[ق_]) { أرجع صواب; };
    }
    أرجع خطأ;
}

// A replacement's new code position (absolute) names its instruction.
عرف علم_مقصودة_محسن(ح: &متغير شفرة_محللة_آلة, البداية: ط64, الموضع: ط64): فراغ {
    دع ت: متغير طبيعي = 0;
    إذا (الموضع >= البداية && فهرس_تعليمة_محسن(ح, (الموضع - البداية) مثل طبيعي, &متغير ت)) {
        (*ح).مقصودة[ت] := صواب;
    };
}

// Instructions control cannot reach from the function's start go (a
// replaced instruction goes to its replacement's code positions, and may
// go on).
عرف احذف_غير_المبلوغة_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64, البداية: ط64): فراغ {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع مبلوغة: متغير متجه منطقي = [];
    بدّل(مبلوغة, (*ح).مؤقت_ب);
    اقتطع(مبلوغة, 0);
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) { ألحق(مبلوغة, خطأ); ف := ف + 1; }
    دع القائمة: متغير متجه طبيعي = [];
    بدّل(القائمة, (*ح).مؤقت_ج);
    اقتطع(القائمة, 0);
    دع التالية: متغير متجه طبيعي = [];
    بدّل(التالية, (*ح).مؤقت_د);
    ف := 0;
    طالما (ف < ن && (*ح).محذوفة[ف]) { ف := ف + 1; }
    إذا (ف < ن) { مبلوغة[ف] := صواب; ألحق(القائمة, ف); };
    طالما ((الطول(القائمة) مثل طبيعي) > 0) {
        دع ي: متغير طبيعي = 0;
        طابق أزل_الأخير(القائمة) مع
        | اختياري.موجود(ق_) -> { ي := ق_; }
        | اختياري.لا_شيء -> { };
        اقتطع(التالية, 0);
        // A replacement may go on where its instruction did not (a loop's jump
        // back made a branch whose exit follows).
        إذا ((*ح).يكمل[ي] || (*ح).مستبدلة[ي]) {
            دع ت: متغير طبيعي = ي + 1;
            طالما (ت < ن && (*ح).محذوفة[ت]) { ت := ت + 1; }
            ألحق(التالية, ت);
        };
        دع ع: متغير طبيعي = (*ح).أول_المعاملات[ي];
        طالما (!(*ح).مستبدلة[ي] && ع < (*ح).أول_المعاملات[ي + 1]) {
            إذا ((*ح).الأنواع[ع] == موضع_محسن()) { ألحق(التالية, وجهة_محسن(ح, البداية, (*ش)[(*ح).المواضع[ع]])); };
            ع := ع + 1;
        }
        إذا ((*ح).مستبدلة[ي]) {
            دع ك: متغير طبيعي = (*ح).بديل_من[ي];
            طالما (ك < (*ح).بديل_إلى[ي]) {
                إذا ((*ح).أهداف_البدائل[ك]) { ألحق(التالية, وجهة_محسن(ح, البداية, (*ح).البدائل[ك])); };
                ك := ك + 1;
            }
        };
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(التالية) مثل طبيعي)) {
            دع ت: طبيعي = التالية[م];
            إذا (ت < ن && !مبلوغة[ت]) { مبلوغة[ت] := صواب; ألحق(القائمة, ت); };
            م := م + 1;
        }
    }
    ف := 0;
    طالما (ف < ن) {
        إذا (!مبلوغة[ف]) { (*ح).محذوفة[ف] := صواب; };
        ف := ف + 1;
    }
    بدّل(مبلوغة, (*ح).مؤقت_ب);
    بدّل(القائمة, (*ح).مؤقت_ج);
    بدّل(التالية, (*ح).مؤقت_د);
}

// A trap guard no code position names, after an instruction that does not
// go on, is never reached.
عرف احذف_الحراس_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متجه ط64): فراغ {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع ف: متغير طبيعي = 1;
    طالما (ف < ن) {
        إذا (!(*ح).محذوفة[ف] && !(*ح).مستبدلة[ف] && !مبلوغة_بموضع_محسن(ح, ف) && (*ش)[(*ح).البدايات[ف]] == 35) {
            دع ق_: طبيعي = سابقة_محسن(ح, ف);
            إذا (ق_ < ن && !(*ح).يكمل[ق_] && !(*ح).مستبدلة[ق_]) { (*ح).محذوفة[ف] := صواب; };
        };
        ف := ف + 1;
    }
}

// A constant used in one block only, which runs at most once per call and is
// not the one defining it, is set there, before its first use, rather than
// on every call.
عرف أنزل_الثوابت_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متغير متجه ط64, البداية: ط64): فراغ {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع ن_س: طبيعي = الطول((*ح).التعريفات) مثل طبيعي;
    // Per register: the block of its reads (لا: several), its first reader.
    دع لا_: ط64 = لا_سجل_محسن();
    دع كتل: متغير متجه ط64 = [];
    بدّل(كتل, (*ح).مؤقت_أ);
    اقتطع(كتل, 0);
    دع أول: متغير متجه طبيعي = [];
    بدّل(أول, (*ح).مؤقت_ج);
    اقتطع(أول, 0);
    دع ر: متغير طبيعي = 0;
    طالما (ر < ن_س) { ألحق(كتل, لا_ - 1); ألحق(أول, 0); ر := ر + 1; }
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        إذا (!(*ح).محذوفة[ف]) {
            دع ع: متغير طبيعي = (*ح).أول_المعاملات[ف];
            طالما (ع < (*ح).أول_المعاملات[ف + 1]) {
                دع النوع: ط64 = (*ح).الأنواع[ع];
                إذا (النوع == قراءة_محسن() || النوع == قراءة_وكتابة_محسن()) {
                    دع س: طبيعي = سجل_معامل_محسن(ح, ش, ع);
                    دع كتلة: ط64 = (*ح).الكتلة[ف] مثل ط64;
                    إذا (كتل[س] == لا_ - 1) { كتل[س] := كتلة; أول[س] := ف; }
                    وإلا إذا (كتل[س] != كتلة) { كتل[س] := لا_; };
                };
                ع := ع + 1;
            }
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < ن) {
        دع ب: طبيعي = (*ح).البدايات[ف];
        إذا (!(*ح).محذوفة[ف] && !(*ح).مستبدلة[ف] && (*ش)[ب] == 2) {
            دع س: طبيعي = (*ش)[ب + 1] مثل طبيعي;
            دع كتلة: ط64 = كتل[س];
            إذا ((*ح).التعريفات[س] == 1 && !(*ح).مثبت[س] && كتلة != لا_ && كتلة != لا_ - 1
                && كتلة != ((*ح).الكتلة[ف] مثل ط64) && !كتلة_دورية_محسن(ح, ش, البداية, كتلة مثل طبيعي)) {
                دع ي: طبيعي = أول[س];
                دع الكلمات: متغير متجه ط64 = [];
                دع الأهداف: متغير متجه منطقي = [];
                كلمات_تعليمة_محسن(ح, ش, ي, &متغير الكلمات, &متغير الأهداف);
                ابدأ_بديل_محسن(ح, ي);
                أضف_بديل_محسن(ح, ي, 2, خطأ); أضف_بديل_محسن(ح, ي, س مثل ط64, خطأ);
                أضف_بديل_محسن(ح, ي, (*ش)[ب + 2], خطأ);
                دع ك: متغير طبيعي = 0;
                طالما (ك < (الطول(الكلمات) مثل طبيعي)) { أضف_بديل_محسن(ح, ي, الكلمات[ك], الأهداف[ك]); ك := ك + 1; }
                (*ح).محذوفة[ف] := صواب;
            };
        };
        ف := ف + 1;
    }
    بدّل(كتل, (*ح).مؤقت_أ);
    بدّل(أول, (*ح).مؤقت_ج);
}

// ---- Jumps ----------------------------------------------------------------------

// The first kept instruction at or after old position الموضع (absolute), ن
// when there is none.
عرف وجهة_محسن(ح: &شفرة_محللة_آلة, البداية: ط64, الموضع: ط64): طبيعي {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع ف: متغير طبيعي = ن;
    إذا (!فهرس_تعليمة_محسن(ح, (الموضع - البداية) مثل طبيعي, &متغير ف)) { أرجع ن; };
    طالما (ف < ن && (*ح).محذوفة[ف]) { ف := ف + 1; }
    أرجع ف;
}

// The conditional branch of instruction ف negated (its words in الكلمات,
// the target word last), or false for none.
عرف انف_فرعا_محسن(الكلمات: &متغير متجه ط64): منطقي {
    دع op: ط64 = (*الكلمات)[0];
    دع ن: طبيعي = الطول(*الكلمات) مثل طبيعي;
    إذا (op == 51) { (*الكلمات)[0] := 52; أرجع ن == 7; };
    إذا (op == 52) { (*الكلمات)[0] := 51; أرجع ن == 7; };
    إذا (op == 49) { (*الكلمات)[0] := 34; أرجع ن == 3; };
    إذا (op == 34) { (*الكلمات)[0] := 49; أرجع ن == 3; };
    إذا (ن == 5 && op >= 98 && op <= 101) {
        إذا (op == 98 || op == 100) { (*الكلمات)[0] := op + 1; } وإلا { (*الكلمات)[0] := op - 1; };
        أرجع صواب;
    };
    إذا (ن != 4) { أرجع خطأ; };
    إذا (op == 82) { (*الكلمات)[0] := 83; أرجع صواب; };
    إذا (op == 83) { (*الكلمات)[0] := 82; أرجع صواب; };
    إذا (op >= 84 && op <= 87) {
        // !(a < b) == b <= a, !(a <= b) == b < a.
        دع س: ط64 = (*الكلمات)[1];
        (*الكلمات)[1] := (*الكلمات)[2]; (*الكلمات)[2] := س;
        إذا (op == 84) { (*الكلمات)[0] := 85; } وإلا إذا (op == 85) { (*الكلمات)[0] := 84; }
        وإلا إذا (op == 86) { (*الكلمات)[0] := 87; } وإلا { (*الكلمات)[0] := 86; };
        أرجع صواب;
    };
    إذا (op >= 88 && op <= 97) {
        دع الشرط: متغير ط64 = 0;
        دع ف: متغير ط64 = 0;
        طالما (ف <= 9) { إذا (فرع_فوري_محسن(ف) == op) { الشرط := ف; }; ف := ف + 1; }
        (*الكلمات)[0] := فرع_فوري_محسن(انف_شرط_محسن(الشرط));
        أرجع صواب;
    };
    أرجع خطأ;
}

// A jump to a return becomes the return; a jump or branch to a jump goes to
// that jump's target; a jump back to a conditional branch becomes that branch
// negated, to the instruction after it, then a jump to its target (a loop
// tests its condition at its end); a jump to the next kept instruction goes.
عرف رتب_القفزات_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متغير متجه ط64, البداية: ط64): فراغ {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع ب: طبيعي = (*ح).البدايات[ف];
        إذا (!(*ح).محذوفة[ف] && !(*ح).مستبدلة[ف]) {
            دع op: ط64 = (*ش)[ب];
            // A branch's target past jumps.
            إذا (op == 29 || op == 51 || op == 52 || op == 49 || op == 34) {
                دع م: طبيعي = ب + ((*ح).البدايات[ف + 1] - ب) - 1;
                دع خطوات: متغير ط64 = 0;
                طالما (خطوات < 8) {
                    دع ت: طبيعي = وجهة_محسن(ح, البداية, (*ش)[م]);
                    إذا (ت < ن && !(*ح).مستبدلة[ت] && (*ش)[(*ح).البدايات[ت]] == 29 && ت != ف) {
                        (*ش)[م] := (*ش)[(*ح).البدايات[ت] + 1];
                        خطوات := خطوات + 1;
                    } وإلا { خطوات := 8; };
                }
            };
            إذا (op == 29) {
                دع ت: طبيعي = وجهة_محسن(ح, البداية, (*ش)[ب + 1]);
                دع التالية: متغير طبيعي = ف + 1;
                طالما (التالية < ن && (*ح).محذوفة[التالية]) { التالية := التالية + 1; }
                // `branch X; jump Y; X:` is `branch-not Y; X:`, unless other
                // code goes to the jump (named, or through removed
                // instructions before it: a branch on a constant that never
                // jumps): it would go on to X instead.
                دع ق_: طبيعي = سابقة_محسن(ح, ف);
                دع قلب: متغير منطقي = خطأ;
                إذا (ت != التالية && ق_ < ن && !مبلوغة_بموضع_محسن(ح, ف) && (*ح).يتفرع[ق_] && (*ح).يكمل[ق_]) {
                    دع الكلمات: متغير متجه ط64 = [];
                    دع الأهداف: متغير متجه منطقي = [];
                    كلمات_تعليمة_محسن(ح, ش, ق_, &متغير الكلمات, &متغير الأهداف);
                    دع ط: طبيعي = الطول(الكلمات) مثل طبيعي;
                    إذا (ط > 1 && الأهداف[ط - 1] && وجهة_محسن(ح, البداية, الكلمات[ط - 1]) == التالية
                        && انف_فرعا_محسن(&متغير الكلمات)) {
                        ابدأ_بديل_محسن(ح, ق_);
                        دع ك: متغير طبيعي = 0;
                        طالما (ك + 1 < ط) { أضف_بديل_محسن(ح, ق_, الكلمات[ك], الأهداف[ك]); ك := ك + 1; }
                        أضف_بديل_محسن(ح, ق_, (*ش)[ب + 1], صواب);
                        (*ح).محذوفة[ف] := صواب;
                        قلب := صواب;
                    };
                };
                إذا (قلب) {
                } وإلا إذا (ت == التالية) {
                    (*ح).محذوفة[ف] := صواب;
                } وإلا إذا (ت < ن && !(*ح).مستبدلة[ت] && ((*ش)[(*ح).البدايات[ت]] == 44 || (*ش)[(*ح).البدايات[ت]] == 45)) {
                    دع بت: طبيعي = (*ح).البدايات[ت];
                    ابدأ_بديل_محسن(ح, ف);
                    إذا ((*ش)[بت] == 44) { أضف_بديل_محسن(ح, ف, 44, خطأ); } وإلا {
                        دع السجل: متغير ط64 = (*ش)[بت + 2];
                        // `r := s` just before: return s.
                        دع ق_: متغير طبيعي = ف;
                        طالما (ق_ > 0 && (*ح).محذوفة[ق_ - 1] && !(*ح).رأس[ق_]) { ق_ := ق_ - 1; }
                        إذا (ق_ > 0 && !(*ح).رأس[ق_] && !(*ح).محذوفة[ق_ - 1] && !(*ح).مستبدلة[ق_ - 1]) {
                            دع بق: طبيعي = (*ح).البدايات[ق_ - 1];
                            إذا ((*ش)[بق] == 1 && (*ش)[بق + 1] == السجل && !(*ح).مثبت[السجل مثل طبيعي]) {
                                السجل := (*ش)[بق + 2];
                                احذف_تعليمة_محسن(ح, ش, ق_ - 1);
                            };
                        };
                        أضف_بديل_محسن(ح, ف, 45, خطأ); أضف_بديل_محسن(ح, ف, (*ش)[بت + 1], خطأ);
                        أضف_بديل_محسن(ح, ف, السجل, خطأ); أضف_بديل_محسن(ح, ف, (*ش)[بت + 3], خطأ);
                    };
                } وإلا إذا (ت < ف && (*ش)[ب + 1] <= البداية + (ب مثل ط64)) {
                    // Back to a conditional branch with a next instruction.
                    دع الكلمات: متغير متجه ط64 = [];
                    دع الأهداف: متغير متجه منطقي = [];
                    كلمات_تعليمة_محسن(ح, ش, ت, &متغير الكلمات, &متغير الأهداف);
                    دع ط: طبيعي = الطول(الكلمات) مثل طبيعي;
                    دع الهدف: ط64 = الكلمات[ط - 1];
                    إذا (ط > 1 && الأهداف[ط - 1] && ت + 1 < ن && انف_فرعا_محسن(&متغير الكلمات)) {
                        ابدأ_بديل_محسن(ح, ف);
                        دع ك: متغير طبيعي = 0;
                        طالما (ك + 1 < ط) { أضف_بديل_محسن(ح, ف, الكلمات[ك], خطأ); ك := ك + 1; }
                        أضف_بديل_محسن(ح, ف, البداية + ((*ح).البدايات[ت + 1] مثل ط64), صواب);
                        // A new code position: the instruction after the branch
                        // is now named (a later branch inversion keeps it).
                        علم_مقصودة_محسن(ح, البداية, البداية + ((*ح).البدايات[ت + 1] مثل ط64));
                        إذا (وجهة_محسن(ح, البداية, الهدف) != التالية) {
                            أضف_بديل_محسن(ح, ف, 29, خطأ);
                            أضف_بديل_محسن(ح, ف, الهدف, صواب);
                        };
                    };
                };
            };
        };
        ف := ف + 1;
    }
}

// Packs the kept instructions (or their replacements); moves every code
// position of the function (operands, and the block starts in مواضع from
// الأول on) with them.
عرف اضغط_شفرة_محسن(ح: &متغير شفرة_محللة_آلة, ش: &متغير متجه ط64, البداية: ط64, مواضع: &متغير متجه ط64, الأول: طبيعي): فراغ {
    دع ن: طبيعي = (الطول((*ح).البدايات) مثل طبيعي) - 1;
    // New word index of each old instruction (a removed one: the next kept).
    دع الجديد: متغير متجه ط64 = [];
    بدّل(الجديد, (*ح).مؤقت_أ);
    اقتطع(الجديد, 0);
    دع ف: متغير طبيعي = 0;
    دع م: متغير ط64 = 0;
    طالما (ف < ن) {
        ألحق(الجديد, م);
        إذا ((*ح).مستبدلة[ف] && !(*ح).محذوفة[ف]) {
            م := م + (((*ح).بديل_إلى[ف] - (*ح).بديل_من[ف]) مثل ط64);
        } وإلا إذا (!(*ح).محذوفة[ف]) {
            م := م + (((*ح).البدايات[ف + 1] - (*ح).البدايات[ف]) مثل ط64);
        };
        ف := ف + 1;
    }
    ألحق(الجديد, م);
    دع الناتج: متغير متجه ط64 = [];
    احجز_سعة(الناتج, م مثل طبيعي);
    ف := 0;
    طالما (ف < ن) {
        إذا ((*ح).محذوفة[ف]) {
        } وإلا إذا ((*ح).مستبدلة[ف]) {
            دع ك: متغير طبيعي = (*ح).بديل_من[ف];
            طالما (ك < (*ح).بديل_إلى[ف]) {
                دع الكلمة: متغير ط64 = (*ح).البدائل[ك];
                إذا ((*ح).أهداف_البدائل[ك]) {
                    دع ت: متغير طبيعي = 0;
                    إذا (فهرس_تعليمة_محسن(ح, (الكلمة - البداية) مثل طبيعي, &متغير ت)) {
                        الكلمة := البداية + الجديد[ت];
                    };
                };
                ألحق(الناتج, الكلمة);
                ك := ك + 1;
            }
        } وإلا {
            دع ب: طبيعي = (*ح).البدايات[ف];
            دع أساس: طبيعي = الطول(الناتج) مثل طبيعي;
            دع ك: متغير طبيعي = ب;
            طالما (ك < (*ح).البدايات[ف + 1]) { ألحق(الناتج, (*ش)[ك]); ك := ك + 1; }
            دع ع: متغير طبيعي = (*ح).أول_المعاملات[ف];
            طالما (ع < (*ح).أول_المعاملات[ف + 1]) {
                إذا ((*ح).الأنواع[ع] == موضع_محسن()) {
                    دع ت: متغير طبيعي = 0;
                    إذا (فهرس_تعليمة_محسن(ح, ((*ش)[(*ح).المواضع[ع]] - البداية) مثل طبيعي, &متغير ت)) {
                        الناتج[أساس + ((*ح).المواضع[ع] - ب)] := البداية + الجديد[ت];
                    };
                };
                ع := ع + 1;
            }
        };
        ف := ف + 1;
    }
    ف := الأول;
    طالما (ف < (الطول(*مواضع) مثل طبيعي)) {
        دع ق_: ط64 = (*مواضع)[ف];
        إذا (ق_ >= البداية) {
            دع ت: متغير طبيعي = 0;
            إذا (فهرس_تعليمة_محسن(ح, (ق_ - البداية) مثل طبيعي, &متغير ت)) {
                (*مواضع)[ف] := البداية + الجديد[ت];
            };
        };
        ف := ف + 1;
    }
    *ش := الناتج;
    بدّل(الجديد, (*ح).مؤقت_أ);
}

// Optimizes one function's code (its words from البداية, السجلات frame
// registers); مواضع from الأول on are its block starts.
عام عرف حسن_شفرة_آلة(
    ح: &متغير شفرة_محللة_آلة, ش: &متغير متجه ط64, البداية: ط64, السجلات: ط64, مواضع: &متغير متجه ط64, الأول: طبيعي
): فراغ {
    امسح_مساحة_محسن(ح);
    إذا (!حلل_شفرة_محسن(ح, ش, البداية, السجلات)) { أرجع; };
    اجمع_شبكات_النسخ_محسن(ح, ش, البداية);
    احذف_الميتة_محسن(ح, ش);
    ادمج_النقلات_محسن(ح, ش);
    مرر_النسخ_محسن(ح, ش);
    احذف_الميتة_محسن(ح, ش);
    اطو_الثوابت_محسن(ح, ش);
    احذف_الميتة_محسن(ح, ش);
    أنزل_الثوابت_محسن(ح, ش, البداية);
    احذف_غير_المبلوغة_محسن(ح, ش, البداية);
    احذف_الحراس_محسن(ح, ش);
    رتب_القفزات_محسن(ح, ش, البداية);
    // Returns copied into the jumps to them may leave the return block
    // unreached, and a branch then right before its target's jump.
    احذف_غير_المبلوغة_محسن(ح, ش, البداية);
    رتب_القفزات_محسن(ح, ش, البداية);
    اضغط_شفرة_محسن(ح, ش, البداية, مواضع, الأول);
}
