    | تعليمة_ذراع_أربعة_وستون.تحويل_عائم_ذراع(العملية, و, المصدر, من_بتات, إلى_بتات) -> {
        أصدر(م, 8); أصدر(م, تحويل_عائم_ذراع_آلة(العملية)); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(المصدر));
        أصدر(م, من_بتات مثل ط64); أصدر(م, إلى_بتات مثل ط64);
        // A narrow signed result normalized to its type (sign-extended).
        طابق العملية مع
        | تحويل_عائم_ذراع_أربعة_وستون.عائم_إلى_موقع -> {
            إذا (إلى_بتات < 64) { أصدر_تحويلا_صحيحا_آلة(م, 0, و, و, إلى_بتات, 64, صواب); };
        }
        | _ -> { };
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز) -> {
        طابق إزاحة_موضع_آلة(م, الحجز.الهوية) مع
        | اختياري.موجود(الإزاحة) -> { أصدر(م, 18); أصدر(م, سجل_آلة(الحجز.الوجهة)); أصدر(م, الإزاحة); }
        | اختياري.لا_شيء -> { (*م).السبب := رفض_آلة(«frame slot»); أرجع خطأ; };
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_إزاحة_ذراع(و, الأساس, الإزاحة) -> {
        إذا (الإزاحة == 0) { أصدر(م, 1); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(الأساس)); } وإلا {
            أصدر(م, 16); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(الأساس)); أصدر(م, لا_سجل_آلة()); أصدر(م, 1);
            أصدر(م, الإزاحة مثل ط64);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_عنصر_ذراع(و, الأساس, الفهرس, الحجم) -> {
        أصدر(م, 17); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(الأساس)); أصدر(م, سجل_آلة(الفهرس));
        أصدر(م, الحجم مثل ط64); أصدر(م, 0);
    }
    | تعليمة_ذراع_أربعة_وستون.نسخ_ذاكرة_ذراع(الوجهة, المصدر, الحجم, إزاحة_الوجهة, إزاحة_المصدر) -> {
        أصدر(م, 19); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, سجل_آلة(المصدر)); أصدر(م, الحجم مثل ط64);
        أصدر(م, إزاحة_الوجهة مثل ط64); أصدر(م, إزاحة_المصدر مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.تخزين_فوري_ذراع(ت_) -> {
        أصدر(م, 20); أصدر(م, سجل_آلة(ت_.الأساس)); أصدر(م, ت_.الإزاحة مثل ط64); أصدر(م, ت_.القيمة مثل ط64);
        أصدر(م, ت_.الحجم مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.إلحاق_متجه_ذراع(ل) -> {
        إذا (ل.حجم_الطول != 8 || ل.حجم_السعة != 8) { (*م).السبب := رفض_آلة(«vector header word size»); أرجع خطأ; };
        أصدر(م, 21); أصدر(م, سجل_آلة(ل.المتجه)); أصدر(م, سجل_آلة(ل.العنصر));
        أصدر(م, ل.إزاحة_البيانات مثل ط64); أصدر(م, ل.إزاحة_الطول مثل ط64); أصدر(م, ل.إزاحة_السعة مثل ط64);
        أصدر(م, ل.حجم_العنصر مثل ط64);
        إذا (ل.العنصر_تجميعي) { أصدر(م, 1); } وإلا { أصدر(م, 0); };
        أصدر(م, ل.السعة_الدنيا مثل ط64); أصدر(م, ل.عامل_النمو مثل ط64);
        إذا (ل.الحجز) { أصدر(م, 1); } وإلا { أصدر(م, 0); };
    }
    | تعليمة_ذراع_أربعة_وستون.امتداد_متجه_ذراع(ل) -> {
        أصدر(م, 22); أصدر(م, سجل_آلة(ل.المتجه)); أصدر(م, سجل_آلة(ل.المصدر));
        أصدر(م, سجل_آلة(ل.البداية)); أصدر(م, سجل_آلة(ل.العدد));
        أصدر(م, ل.إزاحة_البيانات مثل ط64); أصدر(م, ل.إزاحة_الطول مثل ط64); أصدر(م, ل.إزاحة_السعة مثل ط64);
        أصدر(م, ل.حجم_العنصر مثل ط64);
        أصدر(م, ل.السعة_الدنيا مثل ط64); أصدر(م, ل.عامل_النمو مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.ثابت_نص_ذراع(ث) -> {
        دع الطول_الدلالي: ط64 = الطول(ث.البايتات) مثل ط64;
        دع المخزن: متغير ط64 = الطول_الدلالي;
        إذا (المخزن == 0) { المخزن := 1; };
        دع البيانات: ط64 = خصص_ثابتا_آلة(الذاكرة, الكومة, المخزن);
        إذا (البيانات == 0) { (*م).السبب := رفض_آلة(«no memory for a literal»); أرجع خطأ; };
        اكتب_بايتات_خام(الذاكرة, البيانات, &ث.البايتات);
        طابق إزاحة_موضع_آلة(م, ث.الهوية) مع
        | اختياري.موجود(الإزاحة) -> {
            أصدر(م, 23); أصدر(م, الإزاحة); أصدر(م, البيانات); أصدر(م, الطول_الدلالي);
            أصدر(م, ث.إزاحة_البيانات مثل ط64); أصدر(م, ث.إزاحة_الطول مثل ط64); أصدر(م, ث.إزاحة_السعة مثل ط64);
            أصدر(م, 18); أصدر(م, سجل_آلة(ث.الوجهة)); أصدر(م, الإزاحة);
        }
        | اختياري.لا_شيء -> { (*م).السبب := رفض_آلة(«literal slot»); أرجع خطأ; };
    }
    | تعليمة_ذراع_أربعة_وستون.تخصيص_صندوق_ذراع(و, الحجم, المحاذاة) -> {
        إذا (المحاذاة > 16) { (*م).السبب := رفض_آلة(«box alignment above 16»); أرجع خطأ; };
        أصدر(م, 24); أصدر(م, سجل_آلة(و)); أصدر(م, الحجم مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.جمع_سجل_ذراع(و, أ, ب_) -> { أصدر(م, 73); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_)); }
    | تعليمة_ذراع_أربعة_وستون.جمع_سجل_مزاح_ذراع(و, أ, ب_, الإزاحة) -> {
        // d = a + b * 2^shift: a scaled address.
        أصدر(م, 17); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_));
        أصدر(م, (1 مثل ط64) << (الإزاحة مثل ط64)); أصدر(م, 0);
    }
    | تعليمة_ذراع_أربعة_وستون.جمع_فوري_ذراع(و, أ, ق) -> {
        إذا (ق == 0) { أصدر(م, 1); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(أ)); } وإلا {
            أصدر(م, 16); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(أ)); أصدر(م, لا_سجل_آلة()); أصدر(م, 1); أصدر(م, ق مثل ط64);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.طرح_سجل_ذراع(و, أ, ب_) -> { أصدر(م, 74); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_)); }
    | تعليمة_ذراع_أربعة_وستون.طرح_فوري_ذراع(و, أ, ق) -> {
        أصدر(م, 16); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(أ)); أصدر(م, لا_سجل_آلة()); أصدر(م, 1);
        أصدر(م, طرح_ملتف_ترجمة(0 مثل ط64, ق مثل ط64));
    }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_سجل_ذراع(أ, ب_) -> {
        أصدر(م, 27); أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_)); أصدر(م, سجل_العلم);
    }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_فوري_ذراع(أ, ق) -> {
        أصدر(م, 58); أصدر(م, سجل_آلة(أ)); أصدر(م, ق مثل ط64); أصدر(م, سجل_العلم);
    }
    | تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(و, الشرط) -> {
        أصدر(م, 59); أصدر(م, سجل_آلة(و)); أصدر(م, شرط_ذراع_آلة(الشرط)); أصدر(م, سجل_العلم);
    }
    | تعليمة_ذراع_أربعة_وستون.فخ_ذراع -> { أصدر(م, 35); }
    | تعليمة_ذراع_أربعة_وستون.ذري_ذراع(العملية, و, ع, ق, البتات) -> {
        أصدر(م, 36); أصدر(م, ذري_ذراع_آلة(العملية)); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(ع));
        أصدر(م, سجل_آلة(ق)); أصدر(م, (البتات / 8) مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.ذري_قارن_وبدل_ذراع(و, ع, المتوقع, الجديد, البتات) -> {
        أصدر(م, 37); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(ع)); أصدر(م, سجل_آلة(المتوقع));
        أصدر(م, سجل_آلة(الجديد)); أصدر(م, (البتات / 8) مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.ذري_حمل_ذراع(و, ع, البتات) -> {
        أصدر(م, 25); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(ع)); أصدر(م, لا_سجل_آلة()); أصدر(م, 1); أصدر(م, 0);
        أصدر(م, (البتات / 8) مثل ط64); أصدر(م, 0);
    }
    | تعليمة_ذراع_أربعة_وستون.ذري_خزن_ذراع(ع, ق, البتات) -> {
        أصدر(م, 38); أصدر(م, سجل_آلة(ع)); أصدر(م, سجل_آلة(ق)); أصدر(م, (البتات / 8) مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.سياج_ذراع -> { }
    | تعليمة_ذراع_أربعة_وستون.مدخل_سي_ذراع(و) -> {
        // A C-callable entry for a closure: no host code exists for it here.
        أصدر(م, 55); أصدر(م, سجل_آلة(و));
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_جدولي_ذراع(السجل, الأهداف, الافتراضي, الأدنى) -> {
        أصدر(م, 28); أصدر(م, سجل_آلة(السجل));
        دع ن: طبيعي = الطول(الأهداف) مثل طبيعي;
        أصدر(م, ن مثل ط64); أصدر(م, الأدنى مثل ط64); أصدر_كتلة_آلة(م, الافتراضي);
        دع ف: متغير طبيعي = 0;
        طالما (ف < ن) { أصدر_كتلة_آلة(م, الأهداف[ف]); ف := ف + 1; }
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع(الهدف) -> { أصدر_قفزا_آلة(م, الهدف); }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(الحزمة) -> {
        أصدر_نقلات_متتابعة_آلة(م, &الحزمة);
        أصدر_قفزا_آلة(م, الحزمة.الهدف);
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي(الشرط, الهدف) -> {
        أصدر(م, 31); أصدر(م, شرط_ذراع_آلة(الشرط)); أصدر(م, سجل_العلم); أصدر_كتلة_آلة(م, الهدف);
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(الشرط, الحزمة) -> {
        إذا (!نقلات_فعلية_آلة(&الحزمة)) {
            أصدر(م, 31); أصدر(م, شرط_ذراع_آلة(الشرط)); أصدر(م, سجل_العلم); أصدر_كتلة_آلة(م, الحزمة.الهدف);
        } وإلا {
            أصدر(م, 31); أصدر(م, عكس_شرط_آلة(شرط_ذراع_آلة(الشرط))); أصدر(م, سجل_العلم); أصدر(م, 0);
            أصدر_فرعا_بنقلات_آلة(م, &الحزمة);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.فرع_برابط_ذراع_مباشر(النداء) -> {
        دع المحول: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = نداء_من_ذراع_آلة(&النداء);
        إذا (!ترجم_نداء_آلة(ب, م, &المحول, المسير, الأنواع, معرفات_الخارجيات)) { أرجع خطأ; };
        // A C function's narrow result normalized to its type, as the AArch64
        // encoder does after the call (C leaves the high bits unspecified; the
        // engine's extern call only masks them). The program's own functions
        // return it normalized.
        طابق النداء.الهدف مع
        | هدف_نداء_ذراع_أربعة_وستون.دالة_خارجية(_) -> {
            طابق النداء.الناتج مع
            | اختياري.موجود(الناتج) -> { أصدر_تطبيع_واجهة_ذراع_آلة(م, &الناتج); }
            | اختياري.لا_شيء -> { };
        }
        | هدف_نداء_ذراع_أربعة_وستون.عنوان_سي(_) -> {
            طابق النداء.الناتج مع
            | اختياري.موجود(الناتج) -> { أصدر_تطبيع_واجهة_ذراع_آلة(م, &الناتج); }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        أرجع صواب;
    }
    | تعليمة_ذراع_أربعة_وستون.عودة_ذراع -> { أصدر(م, 44); }
    | تعليمة_ذراع_أربعة_وستون.عودة_ذراع_بقيمة(الناتج) -> {
        دع ق: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_ذراع_آلة(&الناتج.القيمة);
        إذا (ق.تجميعي) {
            أصدر(م, 45); أصدر(م, 1); أصدر(م, سجل_آلة(ق.السجل)); أصدر(م, ق.الحجم مثل ط64);
        } وإلا {
            دع الموضع: متغير ط64 = 0;
            إذا ((الطول(ق.المواضع) مثل طبيعي) > 0) {
                طابق موضع_واجهة_آلة(&ق.المواضع[0]) مع
                | اختياري.موجود(الكلمة) -> { الموضع := الكلمة; }
                | اختياري.لا_شيء -> { (*م).السبب := رفض_آلة(«result position»); أرجع خطأ; };
            };
            أصدر(م, 45); أصدر(م, 0); أصدر(م, سجل_آلة(ق.السجل)); أصدر(م, الموضع);
        };
    }
    | تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(و, العنوان, الحجم, بإشارة) -> {
        أصدر(م, 25); أصدر(م, سجل_آلة(و)); أصدر_عنوان_ذراع_آلة(م, &العنوان); أصدر(م, الحجم مثل ط64);
        إذا (بإشارة) { أصدر(م, 1); } وإلا { أصدر(م, 0); };
    }
    | تعليمة_ذراع_أربعة_وستون.تخزين_ذراع_أساس_إزاحة(المصدر, العنوان, الحجم) -> {
        أصدر(م, 26); أصدر(م, سجل_آلة(المصدر)); أصدر_عنوان_ذراع_آلة(م, &العنوان); أصدر(م, الحجم مثل ط64);
    };
    أرجع صواب;
}

عرف ترجم_دالة_ذراع_آلة(
    ب: &متغير برنامج_آلة,
    الدالة: &دالة_ذراع_أربعة_وستون_منتقاة,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    معرفات_الخارجيات: &متغير متجه طبيعي,
    الكومة: &متغير كومة_آلة,
    الذاكرة: &ذاكرة_خام
): اختياري متجه ط8 {
    دع العدد: ط64 = (*الدالة).الرأس.عدد_السجلات_الافتراضية مثل ط64;
    دع السجلات: ط64 = حاذ_آلة(العدد + 3, 2);
    دع م: متغير مترجم_دالة_آلة = {
        الشفرة: [], معرفات_المواضع: [], إزاحات_المواضع: [], معرفات_الكتل: [], مواضع_الكتل: [],
        مواضع_التثبيت: [], بداية_المواضع: السجلات * 8, السبب: [],
        البداية: الطول((*ب).الشفرة) مثل ط64, آخر_مقارنة: لا_سجل_آلة(), المؤقت: العدد + 2,
        مرفوعة: [], أجزاء_عائمة: صواب, حجم_المواضع_ذراع: 0,
        الكتلة_التالية: لا_سجل_آلة(), آخر_فرع: لا_سجل_آلة(), يسقط: خطأ
    };
    طابق اجمع_مواضع_ذراع_آلة(&متغير م, الدالة) مع
    | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
    | اختياري.لا_شيء -> { };
    دع كلمات_المواضع: ط64 = حاذ_آلة((م.حجم_المواضع_ذراع + 7) / 8, 2);
    دع البداية: ط64 = الطول((*ب).الشفرة) مثل ط64;
    دع سجل_العلم: ط64 = العدد;
    ارفع_ثوابت_ذراع_آلة(&متغير م, الدالة, العدد);
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        م.آخر_فرع := لا_سجل_آلة();
        م.يسقط := خطأ;
        م.الكتلة_التالية := لا_سجل_آلة();
        إذا (ك + 1 < (الطول((*الدالة).الكتل) مثل طبيعي)) {
            م.الكتلة_التالية := (*الدالة).الكتل[ك + 1].الرأس.المعرف.القيمة مثل ط64;
        };
        دع الكتلة: &كتلة_ذراع_أربعة_وستون_منتقاة = &(*الدالة).الكتل[ك];
        ألحق(م.معرفات_الكتل, (*الكتلة).الرأس.المعرف.القيمة);
        ألحق(م.مواضع_الكتل, البداية + (الطول(م.الشفرة) مثل ط64));
        دع معرف_الكتلة: معرف_كتلة_مسير = معرف_كتلة_مسير_من(
            معرف_دالة_مسير_من((*الدالة).الرأس.المعرف.القيمة), (*الكتلة).الرأس.المعرف.القيمة
        );
        ألحق((*ب).مواضع_الكتل, البداية + (الطول(م.الشفرة) مثل ط64));
        ألحق((*ب).كتل_المواضع, معرف_الكتلة);
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
            إذا (!ترجم_تعليمة_ذراع_آلة(
                ب, &متغير م, &(*الكتلة).التعليمات[ت], المسير, الأنواع, معرفات_الخارجيات,
                الكومة, الذاكرة, سجل_العلم
            )) {
                أرجع اختياري.موجود(انسخ_بايتات(&م.السبب));
            };
            ت := ت + 1;
        }
        إذا (!م.يسقط) { أصدر(&متغير م, 35); };
        ك := ك + 1;
    }
    أرجع أنه_دالة_آلة(ب, &متغير م, (*الدالة).الرأس.المعرف.القيمة, البداية, السجلات, كلمات_المواضع);
}
