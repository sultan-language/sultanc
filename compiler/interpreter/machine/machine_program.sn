    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عودة_إكس_بقيمة(الناتج) -> {
        إذا (الناتج.القيمة.تجميعي) {
            أصدر(م, 45); أصدر(م, 1); أصدر(م, سجل_آلة(الناتج.القيمة.السجل)); أصدر(م, الناتج.القيمة.الحجم مثل ط64);
        } وإلا {
            دع الموضع: متغير ط64 = 0;
            إذا ((الطول(الناتج.القيمة.المواضع) مثل طبيعي) > 0) {
                طابق موضع_واجهة_آلة(&الناتج.القيمة.المواضع[0]) مع
                | اختياري.موجود(الكلمة) -> { الموضع := الكلمة; }
                | اختياري.لا_شيء -> { (*م).السبب := رفض_آلة(«result position»); أرجع خطأ; };
            };
            أصدر(م, 45); أصدر(م, 0); أصدر(م, سجل_آلة(الناتج.القيمة.السجل)); أصدر(م, الموضع);
        };
    };
    أرجع صواب;
}

عرف ترجم_نداء_آلة(
    ب: &متغير برنامج_آلة,
    م: &متغير مترجم_دالة_آلة,
    النداء: &نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    معرفات_الخارجيات: &متغير متجه طبيعي
): منطقي {
    طابق (*النداء).الهدف مع
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة(الدالة) -> {
        دع ر: ط64 = الدالة.القيمة مثل ط64;
        // The bound allocation providers are the engine's storage services.
        إذا (ر == (*ب).مزود_التخصيص || ر == (*ب).مزود_إعادة_التخصيص || ر == (*ب).مزود_التحرير) {
            دع ن: طبيعي = الطول((*النداء).الحجج) مثل طبيعي;
            دع أ: متغير ط64 = لا_سجل_آلة();
            دع ث: متغير ط64 = لا_سجل_آلة();
            إذا (ن > 0) { أ := سجل_آلة((*النداء).الحجج[0].السجل); };
            إذا (ن > 1) { ث := سجل_آلة((*النداء).الحجج[1].السجل); };
            دع و: متغير ط64 = لا_سجل_آلة();
            طابق (*النداء).الناتج مع
            | اختياري.موجود(الناتج) -> { و := سجل_آلة(الناتج.السجل); }
            | اختياري.لا_شيء -> { };
            دع النوع: متغير ط64 = 0;
            إذا (ر == (*ب).مزود_إعادة_التخصيص) { النوع := 1; };
            إذا (ر == (*ب).مزود_التحرير) { النوع := 2; };
            أصدر(م, 48); أصدر(م, النوع); أصدر(م, أ); أصدر(م, ث); أصدر(م, و);
            أرجع صواب;
        };
        دع ع_: متغير طبيعي = 0;
        طالما (ع_ < (الطول((*ب).دوال_العدادات) مثل طبيعي)) {
            إذا ((*ب).دوال_العدادات[ع_] == ر) {
                // One of std's allocation counters: the engine's counts.
                أصدر(م, 57); أصدر(م, ع_ مثل ط64);
                طابق (*النداء).الناتج مع
                | اختياري.موجود(الناتج) -> { أصدر(م, سجل_آلة(الناتج.السجل)); }
                | اختياري.لا_شيء -> { أصدر(م, لا_سجل_آلة()); };
                أرجع صواب;
            };
            ع_ := ع_ + 1;
        }
        إذا (ر == (*ب).مبدل_المهام) {
            // The task switch (الحفظ, المكدس_الجديد): the engine's own.
            إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 2) { (*م).السبب := رفض_آلة(«task switch arguments»); أرجع خطأ; };
            أصدر(م, 53);
            أصدر(م, سجل_آلة((*النداء).الحجج[0].السجل));
            أصدر(م, سجل_آلة((*النداء).الحجج[1].السجل));
            طابق (*النداء).الناتج مع
            | اختياري.موجود(الناتج) -> { أصدر(م, سجل_آلة(الناتج.السجل)); }
            | اختياري.لا_شيء -> { أصدر(م, لا_سجل_آلة()); };
            أرجع صواب;
        };
        إذا (أصدر_نداء_بسيطا_آلة(م, ر, النداء)) { أرجع صواب; };
        أصدر(م, 39); أصدر(م, ر);
        إذا (!أصدر_حجج_وناتج_آلة(م, النداء)) { (*م).السبب := رفض_آلة(«call interface»); أرجع خطأ; };
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.قيمة_دالة(السجل) -> {
        أصدر(م, 42); أصدر(م, سجل_آلة(السجل));
        إذا (!أصدر_حجج_وناتج_آلة(م, النداء)) { (*م).السبب := رفض_آلة(«call interface»); أرجع خطأ; };
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة_خارجية(المعرف) -> {
        دع حجم_الناتج: متغير ط64 = 0;
        طابق (*النداء).الناتج مع
        | اختياري.موجود(الناتج) -> {
            إذا (الناتج.تجميعي) { (*م).السبب := رفض_آلة(«record returned by a C function»); أرجع خطأ; };
            حجم_الناتج := الناتج.الحجم مثل ط64;
        }
        | اختياري.لا_شيء -> { };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
            إذا ((*النداء).الحجج[ف].تجميعي) { (*م).السبب := رفض_آلة(«record passed to a C function»); أرجع خطأ; };
            ف := ف + 1;
        }
        طابق خارجية_آلة_لمعرف(ب, المسير, الأنواع, معرفات_الخارجيات, المعرف, حجم_الناتج) مع
        | اختياري.لا_شيء -> { (*م).السبب := رفض_آلة(«unknown extern»); أرجع خطأ; }
        | اختياري.موجود(الفهرس) -> {
            أصدر(م, 40); أصدر(م, الفهرس);
            إذا (!أصدر_حجج_وناتج_آلة(م, النداء)) { (*م).السبب := رفض_آلة(«extern interface»); أرجع خطأ; };
        };
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.نداء_نواة -> {
        أصدر(م, 41);
        إذا (!أصدر_حجج_وناتج_آلة(م, النداء)) { (*م).السبب := رفض_آلة(«kernel call interface»); أرجع خطأ; };
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.عنوان_سي(السجل) -> {
        أصدر(م, 43); أصدر(م, سجل_آلة(السجل));
        إذا (!أصدر_حجج_وناتج_آلة(م, النداء)) { (*م).السبب := رفض_آلة(«C address call interface»); أرجع خطأ; };
    }
    | هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.بدائي_تشغيل(البدائي) -> {
        طابق البدائي مع
        | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> {
            // Thread start (number, flags, stack, parent tid, child tid,
            // TLS, closure): the engine starts a host thread that runs the
            // closure on an engine of its own (machine_engine.sn).
            إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 7) {
                (*م).السبب := رفض_آلة(«thread start interface»); أرجع خطأ;
            };
            أصدر(م, 54);
            دع ح_: متغير طبيعي = 0;
            طالما (ح_ < 7) {
                إذا ((*النداء).الحجج[ح_].تجميعي) {
                    (*م).السبب := رفض_آلة(«thread start interface»); أرجع خطأ;
                };
                أصدر(م, سجل_آلة((*النداء).الحجج[ح_].السجل));
                ح_ := ح_ + 1;
            }
            طابق (*النداء).الناتج مع
            | اختياري.موجود(الناتج) -> { أصدر(م, سجل_آلة(الناتج.السجل)); }
            | اختياري.لا_شيء -> { أصدر(م, لا_سجل_آلة()); };
        }
        | _ -> {
            أصدر(م, 47); أصدر(م, الطول((*ب).بدائيات_غير_مدعومة) مثل ط64);
            ألحق((*ب).بدائيات_غير_مدعومة, البدائي);
        };
    };
    أرجع صواب;
}

// ---- Functions ----------------------------------------------------------------

عرف حاذ_آلة(القيمة: ط64, المحاذاة: ط64): ط64 {
    إذا (المحاذاة <= 1) { أرجع القيمة; };
    أرجع ((القيمة + المحاذاة - 1) / المحاذاة) * المحاذاة;
}

عرف ترجم_دالة_منتقاة_آلة(
    ب: &متغير برنامج_آلة,
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    معرفات_الخارجيات: &متغير متجه طبيعي,
    الكومة: &متغير كومة_آلة,
    الذاكرة: &ذاكرة_خام
): اختياري متجه ط8 {
    دع العدد: ط64 = (*الدالة).الرأس.عدد_السجلات_الافتراضية مثل ط64;
    // Two comparison words after the registers; an even count keeps every
    // frame 16-byte aligned.
    دع السجلات: ط64 = حاذ_آلة(العدد + 3, 2);
    دع م: متغير مترجم_دالة_آلة = {
        الشفرة: [], معرفات_المواضع: [], إزاحات_المواضع: [], معرفات_الكتل: [], مواضع_الكتل: [],
        مواضع_التثبيت: [], بداية_المواضع: السجلات * 8, السبب: [],
        البداية: الطول((*ب).الشفرة) مثل ط64, آخر_مقارنة: لا_سجل_آلة(), المؤقت: العدد + 2,
        مرفوعة: [], أجزاء_عائمة: خطأ, حجم_المواضع_ذراع: 0,
        الكتلة_التالية: لا_سجل_آلة(), آخر_فرع: لا_سجل_آلة(), يسقط: خطأ
    };
    // Local slots.
    دع الحجم: متغير ط64 = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المواضع_المحلية) مثل طبيعي)) {
        دع الطلب: &طلب_موضع_محلي_إكس = &(*الدالة).المواضع_المحلية[ف];
        طابق إزاحة_موضع_آلة(&م, (*الطلب).المعرف) مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            دع المحاذاة: متغير ط64 = (*الطلب).المحاذاة مثل ط64;
            إذا (المحاذاة > 16) { أرجع اختياري.موجود(رفض_آلة(«local slot alignment above 16»)); };
            إذا (المحاذاة == 0) { المحاذاة := 1; };
            الحجم := حاذ_آلة(الحجم, المحاذاة);
            ألحق(م.معرفات_المواضع, (*الطلب).المعرف);
            ألحق(م.إزاحات_المواضع, الحجم);
            دع حجم_الموضع: متغير ط64 = (*الطلب).الحجم مثل ط64;
            إذا (حجم_الموضع == 0) { حجم_الموضع := 1; };
            الحجم := الحجم + حجم_الموضع;
        };
        ف := ف + 1;
    }
    دع كلمات_المواضع: ط64 = حاذ_آلة((الحجم + 7) / 8, 2);
    دع البداية: ط64 = الطول((*ب).الشفرة) مثل ط64;
    دع سجل_العلم: ط64 = العدد;
    // The prologue: the hoisted constants.
    ارفع_ثوابت_آلة(&متغير م, الدالة, العدد);
    // Blocks.
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع الكتلة: &كتلة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = &(*الدالة).الكتل[ك];
        م.آخر_فرع := لا_سجل_آلة();
        م.يسقط := خطأ;
        م.الكتلة_التالية := لا_سجل_آلة();
        إذا (ك + 1 < (الطول((*الدالة).الكتل) مثل طبيعي)) {
            م.الكتلة_التالية := (*الدالة).الكتل[ك + 1].الرأس.المعرف.القيمة مثل ط64;
        };
        ألحق(م.معرفات_الكتل, (*الكتلة).الرأس.المعرف.القيمة);
        ألحق(م.مواضع_الكتل, البداية + (الطول(م.الشفرة) مثل ط64));
        دع معرف_الكتلة: معرف_كتلة_مسير = معرف_كتلة_مسير_من(
            معرف_دالة_مسير_من((*الدالة).الرأس.المعرف.القيمة), (*الكتلة).الرأس.المعرف.القيمة
        );
        ألحق((*ب).مواضع_الكتل, البداية + (الطول(م.الشفرة) مثل ط64));
        ألحق((*ب).كتل_المواضع, معرف_الكتلة);
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
            إذا (!ترجم_تعليمة_آلة(
                ب, &متغير م, &(*الكتلة).التعليمات[ت], المسير, الأنواع, معرفات_الخارجيات,
                الكومة, الذاكرة, سجل_العلم
            )) {
                أرجع اختياري.موجود(انسخ_بايتات(&م.السبب));
            };
            ت := ت + 1;
        }
        // A block that falls through ends with an explicit trap guard.
        إذا (!م.يسقط) { أصدر(&متغير م, 35); };
        ك := ك + 1;
    }
    أرجع أنه_دالة_آلة(ب, &متغير م, (*الدالة).الرأس.المعرف.القيمة, البداية, السجلات, كلمات_المواضع);
}

// Fixes up block operands, appends the function's code to the program and
// records its descriptor.
عرف أنه_دالة_آلة(
    ب: &متغير برنامج_آلة,
    م: &متغير مترجم_دالة_آلة,
    المعرف: طبيعي,
    البداية: ط64,
    السجلات: ط64,
    كلمات_المواضع: ط64
): اختياري متجه ط8 {
    دع ث: متغير طبيعي = 0;
    طالما (ث < (الطول((*م).مواضع_التثبيت) مثل طبيعي)) {
        دع الموضع: طبيعي = (*م).مواضع_التثبيت[ث];
        دع معرف_الكتلة: طبيعي = (*م).الشفرة[الموضع] مثل طبيعي;
        دع وجد: متغير منطقي = خطأ;
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول((*م).معرفات_الكتل) مثل طبيعي) && !وجد) {
            إذا ((*م).معرفات_الكتل[ج] == معرف_الكتلة) {
                (*م).الشفرة[الموضع] := (*م).مواضع_الكتل[ج];
                وجد := صواب;
            };
            ج := ج + 1;
        }
        إذا (!وجد) { أرجع اختياري.موجود(رفض_آلة(«jump to a missing block»)); };
        ث := ث + 1;
    }
    إذا ((*ب).محسن) {
        // This function's block starts are the last ones recorded.
        دع الأول: متغير طبيعي = الطول((*ب).مواضع_الكتل) مثل طبيعي;
        طالما (الأول > 0 && (*ب).مواضع_الكتل[الأول - 1] >= البداية) { الأول := الأول - 1; }
        حسن_شفرة_آلة(&متغير (*ب).مساحة_المحسن, &متغير (*م).الشفرة, البداية, السجلات, &متغير (*ب).مواضع_الكتل, الأول);
    };
    دع ش: متغير طبيعي = 0;
    طالما (ش < (الطول((*م).الشفرة) مثل طبيعي)) { ألحق((*ب).الشفرة, (*م).الشفرة[ش]); ش := ش + 1; }
    دع الوصف: دالة_آلة = {
        البداية: البداية, السجلات: السجلات, الكلمات: السجلات + كلمات_المواضع, مترجمة: صواب
    };
    (*ب).الدوال[المعرف] := الوصف;
    أرجع اختياري.لا_شيء();
}

// ---- Globals ------------------------------------------------------------------

// Places every MSIR global the program defines in a block of its own and
// applies its relocations; the startup data the executable entry provides
// (argc, argv, envp) is written by the engine. False with the reason when a
// global has no storage the interpreter can give it.
عرف ضع_العوام_آلة(
    ب: &متغير برنامج_آلة,
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    الكومة: &متغير كومة_آلة,
    الذاكرة: &ذاكرة_خام
): اختياري متجه ط8 {
    دع العدد: طبيعي = الطول((*المسير).المسير.العوام) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق((*ب).العوام, 0); ف := ف + 1; }
    دع المرفقات: متغير مرفقات_كائن_مشفرة = مرفقات_كائن_مشفرة_فارغة();
    طابق مادة_عوام_مسير_للكائن(المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, &متغير المرفقات) مع
    | نتيجة_مادة_عوام_أصلية.نجحت -> { }
    | نتيجة_مادة_عوام_أصلية.أخفقت(_) -> { أرجع اختياري.موجود(رفض_آلة(«global initializer»)); };
    // Storage first, so relocations can name any global.
    دع غ: متغير طبيعي = 0;
    طالما (غ < (الطول(المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع البيان: &بيانات_عام_كائن = &المرفقات.البيانات_العامة[غ];
        دع الحجم: ط64 = الطول((*البيان).البيانات) مثل ط64;
        دع العنوان: ط64 = خصص_ثابتا_آلة(الذاكرة, الكومة, الحجم);
        إذا (العنوان == 0) { أرجع اختياري.موجود(رفض_آلة(«no memory for globals»)); };
        اكتب_بايتات_خام(الذاكرة, العنوان, &(*البيان).البيانات);
        دع المعرف: طبيعي = (*البيان).المعرف.القيمة;
        إذا (المعرف < العدد) { (*ب).العوام[المعرف] := العنوان; };
        غ := غ + 1;
    }
    غ := 0;
    طالما (غ < (الطول(المرفقات.البيانات_العامة) مثل طبيعي)) {
        دع البيان: &بيانات_عام_كائن = &المرفقات.البيانات_العامة[غ];
        دع الأساس: ط64 = (*ب).العوام[(*البيان).المعرف.القيمة];
        دع ز: متغير طبيعي = 0;
        طالما (ز < (الطول((*البيان).الإزاحات) مثل طبيعي)) {
            دع الطلب: &طلب_إزاحة_بيانات_كائن = &(*البيان).الإزاحات[ز];
            دع القيمة: متغير ط64 = 0;
            طابق (*الطلب).الرمز مع
            | مرجع_رمز_كائن.دالة(الدالة) -> { القيمة := قاعدة_مقابض_آلة() + (الدالة.القيمة مثل ط64); }
            | مرجع_رمز_كائن.عام(العام) -> {
                إذا ((العام.القيمة مثل طبيعي) >= العدد || (*ب).العوام[العام.القيمة] == 0) {
                    أرجع اختياري.موجود(رفض_آلة(«relocation to a global without storage»));
                };
                القيمة := (*ب).العوام[العام.القيمة];
            }
            | _ -> { أرجع اختياري.موجود(رفض_آلة(«global relocation kind»)); };
            القيمة := القيمة + ((*الطلب).الإضافة مثل ط64);
            اكتب_خام(الذاكرة, الأساس + ((*الطلب).الموضع مثل ط64), 8, القيمة);
            ز := ز + 1;
        }
        غ := غ + 1;
    }
    // Imported storage: a word each (the startup data); the engine fills them.
    دع خ: متغير طبيعي = 0;
    طالما (خ < (الطول(المرفقات.البيانات_الخارجية) مثل طبيعي)) {
        دع المعرف: طبيعي = المرفقات.البيانات_الخارجية[خ].المعرف.القيمة;
        دع العنوان: ط64 = خصص_ثابتا_آلة(الذاكرة, الكومة, 16);
        إذا (العنوان == 0) { أرجع اختياري.موجود(رفض_آلة(«no memory for globals»)); };
        إذا (المعرف < العدد) { (*ب).العوام[المعرف] := العنوان; };
        خ := خ + 1;
    }
    أرجع اختياري.لا_شيء();
}

// ---- Program --------------------------------------------------------------------

عام عرف ترجم_برنامج_آلة(
    المسير: &سياق_مستهلك_مسير,
    حقائق_الخلفية: &سياق_استعلام_اختيار_خلفية,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    دالة_البدء: معرف_دالة_مسير,
    الكومة: &متغير كومة_آلة,
    الذاكرة: &ذاكرة_خام,
    محسن: منطقي
): نتيجة_ترجمة_آلة {
    دع العدد: طبيعي = عدد_دوال_مسير(المسير);
    دع الدوال: متغير متجه دالة_آلة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع فارغة: دالة_آلة = { البداية: 0, السجلات: 0, الكلمات: 0, مترجمة: خطأ };
        ألحق(الدوال, فارغة);
        ف := ف + 1;
    }
    // Code position 0 is a trap, so a function never translated traps.
    دع الشفرة: متجه ط64 = [35];
    دع ب: متغير برنامج_آلة = {
        الشفرة: الشفرة, الدوال: الدوال, الخارجيات: [], مواضع_الكتل: [], كتل_المواضع: [],
        العوام: [], مزود_التخصيص: لا_سجل_آلة(), مزود_إعادة_التخصيص: لا_سجل_آلة(),
        مزود_التحرير: لا_سجل_آلة(), مبدل_المهام: لا_سجل_آلة(), إزاحة_إغلاق_مهمة: 24, مقابض_المكتبات: [], دوال_العدادات: [], بدائيات_غير_مدعومة: [], أساس_الشفرة: 0, جدول_الدوال: 0,
        محسن: محسن, مساحة_المحسن: مساحة_محسن_جديدة()
    };
    طابق (*المسير).المسير.مزودات_تخصيص_الذاكرة مع
    | اختياري.موجود(المزودات) -> {
        ب.مزود_التخصيص := المزودات.التخصيص.القيمة مثل ط64;
        ب.مزود_إعادة_التخصيص := المزودات.إعادة_التخصيص.القيمة مثل ط64;
        ب.مزود_التحرير := المزودات.التحرير.القيمة مثل ط64;
    }
    | اختياري.لا_شيء -> { };
    دع ع_: متغير طبيعي = 0;
    طالما (ع_ < (الطول((*المسير).المسير.دوال_عدادات_التخصيص) مثل طبيعي)) {
        طابق (*المسير).المسير.دوال_عدادات_التخصيص[ع_] مع
        | اختياري.موجود(الدالة) -> { ألحق(ب.دوال_العدادات, الدالة.القيمة مثل ط64); }
        | اختياري.لا_شيء -> { ألحق(ب.دوال_العدادات, لا_سجل_آلة()); };
        ع_ := ع_ + 1;
    }
    طابق (*المسير).المسير.دالة_تبديل_سياق_المهام مع
    | اختياري.موجود(المبدل) -> { ب.مبدل_المهام := المبدل.القيمة مثل ط64; }
    | اختياري.لا_شيء -> { };
    طابق ضع_العوام_آلة(&متغير ب, المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, الكومة, الذاكرة) مع
    | اختياري.موجود(السبب) -> { أرجع نتيجة_ترجمة_آلة.غير_مدعومة(السبب); }
    | اختياري.لا_شيء -> { };
    دع البدء: اختياري معرف_دالة_مسير = اختياري.موجود(دالة_البدء);
    دع المطلوبة: متجه منطقي = دوال_مسير_تنفيذية_مطلوبة(المسير, البدء);
    دع معرفات_الخارجيات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) {
        إذا (ف < (الطول(المطلوبة) مثل طبيعي) && المطلوبة[ف]) {
            دع ر: ط64 = ف مثل ط64;
            دع مزود: منطقي = ر == ب.مزود_التخصيص || ر == ب.مزود_إعادة_التخصيص || ر == ب.مزود_التحرير;
            إذا (!مزود && ر != ب.مبدل_المهام) {
                طابق هيئ_دالة_منتقاة_بالمزود_الأصلي(
                    المسير, حقائق_الخلفية, الهدف, سجل_التخطيط, معرف_دالة_مسير_من(ف)
                ) مع
                | نتيجة_دالة_منتقاة_أصلية.إكس_ستة_وثمانون_أربعة_وستون(المنتقاة) -> {
                    طابق ترجم_دالة_منتقاة_آلة(
                        &متغير ب, &المنتقاة, المسير, &(*حقائق_الخلفية).الأنواع,
                        &متغير معرفات_الخارجيات, الكومة, الذاكرة
                    ) مع
                    | اختياري.موجود(السبب) -> { أرجع نتيجة_ترجمة_آلة.غير_مدعومة(السبب); }
                    | اختياري.لا_شيء -> { };
                }
                | نتيجة_دالة_منتقاة_أصلية.ذراع_أربعة_وستون(المنتقاة) -> {
                    طابق ترجم_دالة_ذراع_آلة(
                        &متغير ب, &المنتقاة, المسير, &(*حقائق_الخلفية).الأنواع,
                        &متغير معرفات_الخارجيات, الكومة, الذاكرة
                    ) مع
                    | اختياري.موجود(السبب) -> { أرجع نتيجة_ترجمة_آلة.غير_مدعومة(السبب); }
                    | اختياري.لا_شيء -> { };
                }
                | نتيجة_دالة_منتقاة_أصلية.بدائي_مسير_غير_مخفض(البدائي) -> {
                    دع السبب: متغير متجه ط8 = بايتات_من_نص(«primitive without a lowering: »);
                    دع الاسم: متجه ط8 = بايتات_من_نص(نص_هوية_بدائي_تشخيصية(البدائي));
                    دع ي: متغير طبيعي = 0;
                    طالما (ي < (الطول(الاسم) مثل طبيعي)) { ألحق(السبب, الاسم[ي]); ي := ي + 1; }
                    أرجع نتيجة_ترجمة_آلة.غير_مدعومة(السبب);
                }
                | _ -> {
                    أرجع نتيجة_ترجمة_آلة.غير_مدعومة(رفض_آلة(«selection failed»));
                };
            };
        };
        ف := ف + 1;
    }
    ب.مساحة_المحسن := مساحة_محسن_جديدة();
    // The engine reads the code and the function table from raw memory.
    دع عدد_الكلمات: ط64 = الطول(ب.الشفرة) مثل ط64;
    دع الشفرة_الخام: ط64 = خصص_آلة(الذاكرة, الكومة, عدد_الكلمات * 8);
    دع الجدول: ط64 = خصص_مصفرا_آلة(الذاكرة, الكومة, (العدد مثل ط64) * 32 + 32);
    إذا (الشفرة_الخام == 0 || الجدول == 0) {
        أرجع نتيجة_ترجمة_آلة.غير_مدعومة(رفض_آلة(«no memory for the code»));
    };
    دع ك: متغير ط64 = 0;
    طالما (ك < عدد_الكلمات) {
        اكتب_كلمة_محاذاة_خام(الذاكرة, الشفرة_الخام + ك * 8, ب.الشفرة[ك مثل طبيعي]);
        ك := ك + 1;
    }
    ف := 0;
    طالما (ف < العدد) {
        دع المدخل: ط64 = الجدول + (ف مثل ط64) * 32;
        اكتب_كلمة_محاذاة_خام(الذاكرة, المدخل, ب.الدوال[ف].البداية);
        اكتب_كلمة_محاذاة_خام(الذاكرة, المدخل + 8, ب.الدوال[ف].الكلمات);
        إذا (ب.الدوال[ف].مترجمة) { اكتب_كلمة_محاذاة_خام(الذاكرة, المدخل + 16, 1); };
        ف := ف + 1;
    }
    ب.أساس_الشفرة := فهرس_كلمة_خام(الذاكرة, الشفرة_الخام);
    ب.جدول_الدوال := فهرس_كلمة_خام(الذاكرة, الجدول);
    أرجع نتيجة_ترجمة_آلة.نجحت(ب);
}

عرف هل_نوع_منطقي_آلة(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الشكل) -> {
        طابق الشكل.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.منطقي(); }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// ---- AArch64 ------------------------------------------------------------------
// The AArch64 selector's code (backend/architectures/arm64/selector.sn) is
// rewritten into the same word code. Its calls are first expressed in the
// x86-64 selected shapes (the same interface values by ABI position), so one
// call translator serves both.

عرف علم_ذراع_آلة(القيمة: طبيعي): منطقي { أرجع القيمة != 0; }

عرف قيمة_واجهة_من_ذراع_آلة(
    القيمة: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة
): قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة {
    دع المواضع: متغير متجه موضع_جزء_واجهة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة).المواضع) مثل طبيعي)) {
        ألحق(المواضع, انسخ_موضع_جزء_واجهة(&(*القيمة).المواضع[ف]));
        ف := ف + 1;
    }
    دع الناتج: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = {
        السجل: (*القيمة).السجل, المواضع: المواضع, الحجم: (*القيمة).الحجم,
        تجميعي: علم_ذراع_آلة((*القيمة).تجميعي), غير_مباشر: علم_ذراع_آلة((*القيمة).غير_مباشر)
    };
    أرجع الناتج;
}

عرف نداء_من_ذراع_آلة(النداء: &نداء_ذراع_أربعة_وستون_منتقى): نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى {
    دع الهدف: متغير هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون = هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.نداء_نواة();
    طابق (*النداء).الهدف مع
    | هدف_نداء_ذراع_أربعة_وستون.دالة(الدالة) -> { الهدف := هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة(الدالة); }
    // A Linux kernel call; the thread clone becomes the x86-64 selector's
    // clone primitive, which the interpreter answers as x86-64's.
    | هدف_نداء_ذراع_أربعة_وستون.نداء_نواة(استنساخ) -> {
        إذا (استنساخ) {
            الهدف := هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.بدائي_تشغيل(هوية_بدائي_مترجم.استنساخ_خيط_نواة());
        };
    }
    | هدف_نداء_ذراع_أربعة_وستون.دالة_خارجية(المعرف) -> { الهدف := هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.دالة_خارجية(المعرف); }
    | هدف_نداء_ذراع_أربعة_وستون.بدائي_تشغيل(البدائي) -> { الهدف := هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.بدائي_تشغيل(البدائي); }
    | هدف_نداء_ذراع_أربعة_وستون.قيمة_دالة(السجل) -> { الهدف := هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.قيمة_دالة(السجل); }
    | هدف_نداء_ذراع_أربعة_وستون.عنوان_سي(السجل) -> { الهدف := هدف_نداء_إكس_ستة_وثمانون_أربعة_وستون.عنوان_سي(السجل); };
    دع الحجج: متغير متجه قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
        ألحق(الحجج, قيمة_واجهة_من_ذراع_آلة(&(*النداء).الحجج[ف]));
        ف := ف + 1;
    }
    دع الناتج: متغير اختياري قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = اختياري.لا_شيء();
    طابق (*النداء).الناتج مع
    | اختياري.موجود(ق) -> { الناتج := اختياري.موجود(قيمة_واجهة_من_ذراع_آلة(&ق)); }
    | اختياري.لا_شيء -> { };
    دع النداء_الناتج: نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى = { الهدف: الهدف, الحجج: الحجج, الناتج: الناتج, متغيرة: خطأ };
    أرجع النداء_الناتج;
}

عرف شرط_ذراع_آلة(الشرط: شرط_ذراع_أربعة_وستون): ط64 {
    طابق الشرط مع
    | شرط_ذراع_أربعة_وستون.تكافؤ -> { أرجع 0; }
    | شرط_ذراع_أربعة_وستون.لاتكافؤ -> { أرجع 1; }
    | شرط_ذراع_أربعة_وستون.أقل_بإشارة -> { أرجع 2; }
    | شرط_ذراع_أربعة_وستون.أقل_أو_يساوي_بإشارة -> { أرجع 3; }
    | شرط_ذراع_أربعة_وستون.أكبر_بإشارة -> { أرجع 4; }
    | شرط_ذراع_أربعة_وستون.أكبر_أو_يساوي_بإشارة -> { أرجع 5; }
    | شرط_ذراع_أربعة_وستون.أدنى_طبيعي -> { أرجع 6; }
    | شرط_ذراع_أربعة_وستون.أدنى_أو_يساوي_طبيعي -> { أرجع 7; }
    | شرط_ذراع_أربعة_وستون.أعلى_طبيعي -> { أرجع 8; }
    | شرط_ذراع_أربعة_وستون.أعلى_أو_يساوي_طبيعي -> { أرجع 9; };
}

// The codes of حساب_آلة; division and remainder take their sign from the
// operation's description.
عرف حساب_ذراع_آلة(العملية: عملية_حساب_ذراع_أربعة_وستون, موقع: منطقي): ط64 {
    طابق العملية مع
    | عملية_حساب_ذراع_أربعة_وستون.جمع -> { أرجع 0; }
    | عملية_حساب_ذراع_أربعة_وستون.طرح -> { أرجع 1; }
    | عملية_حساب_ذراع_أربعة_وستون.ضرب -> { أرجع 2; }
    | عملية_حساب_ذراع_أربعة_وستون.قسمة -> { إذا (موقع) { أرجع 3; }; أرجع 4; }
    | عملية_حساب_ذراع_أربعة_وستون.باقي -> { إذا (موقع) { أرجع 5; }; أرجع 6; }
    | عملية_حساب_ذراع_أربعة_وستون.و_بتي -> { أرجع 9; }
    | عملية_حساب_ذراع_أربعة_وستون.أو_بتي -> { أرجع 7; }
    | عملية_حساب_ذراع_أربعة_وستون.أو_حصري -> { أرجع 8; }
    | عملية_حساب_ذراع_أربعة_وستون.إزاحة_يسرى -> { أرجع 10; }
    | عملية_حساب_ذراع_أربعة_وستون.إزاحة_يمنى_منطقية -> { أرجع 11; }
    | عملية_حساب_ذراع_أربعة_وستون.إزاحة_يمنى_حسابية -> { أرجع 12; }
    | عملية_حساب_ذراع_أربعة_وستون.جمع_ملتف -> { أرجع 13; }
    | عملية_حساب_ذراع_أربعة_وستون.طرح_ملتف -> { أرجع 14; }
    | عملية_حساب_ذراع_أربعة_وستون.ضرب_ملتف -> { أرجع 15; }
    | عملية_حساب_ذراع_أربعة_وستون.إزاحة_يسرى_ملتفة -> { أرجع 16; };
}

// Float operation codes of the engine (احسب_عشري_آلة): the x86-64 ones and
// the AArch64 roundings 9..12.
عرف حساب_عشري_ذراع_آلة(العملية: حساب_عشري_ذراع_أربعة_وستون): ط64 {
    طابق العملية مع
    | حساب_عشري_ذراع_أربعة_وستون.جمع -> { أرجع 0; }
    | حساب_عشري_ذراع_أربعة_وستون.طرح -> { أرجع 1; }
    | حساب_عشري_ذراع_أربعة_وستون.ضرب -> { أرجع 2; }
    | حساب_عشري_ذراع_أربعة_وستون.قسمة -> { أرجع 3; }
    | حساب_عشري_ذراع_أربعة_وستون.جذر_تربيعي -> { أرجع 4; }
    | حساب_عشري_ذراع_أربعة_وستون.قيمة_مطلقة -> { أرجع 5; }
    | حساب_عشري_ذراع_أربعة_وستون.نسخ_إشارة -> { أرجع 6; }
    | حساب_عشري_ذراع_أربعة_وستون.أدنى -> { أرجع 7; }
    | حساب_عشري_ذراع_أربعة_وستون.أقصى -> { أرجع 8; }
    | حساب_عشري_ذراع_أربعة_وستون.بتر -> { أرجع 9; }
    | حساب_عشري_ذراع_أربعة_وستون.أرضية -> { أرجع 10; }
    | حساب_عشري_ذراع_أربعة_وستون.سقف -> { أرجع 11; }
    | حساب_عشري_ذراع_أربعة_وستون.تقريب_زوجي -> { أرجع 12; };
}

عرف مقارنة_عشرية_ذراع_آلة(العملية: مقارنة_عشرية_ذراع_أربعة_وستون): ط64 {
    طابق العملية مع
    | مقارنة_عشرية_ذراع_أربعة_وستون.يساوي -> { أرجع 0; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.لا_يساوي -> { أرجع 1; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.أصغر -> { أرجع 2; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.أصغر_أو_يساوي -> { أرجع 3; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.أكبر -> { أرجع 4; }
    | مقارنة_عشرية_ذراع_أربعة_وستون.أكبر_أو_يساوي -> { أرجع 5; };
}

عرف تحويل_عائم_ذراع_آلة(العملية: تحويل_عائم_ذراع_أربعة_وستون): ط64 {
    طابق العملية مع
    | تحويل_عائم_ذراع_أربعة_وستون.عائم_إلى_موقع -> { أرجع 0; }
    | تحويل_عائم_ذراع_أربعة_وستون.عائم_إلى_طبيعي -> { أرجع 1; }
    | تحويل_عائم_ذراع_أربعة_وستون.موقع_إلى_عائم -> { أرجع 2; }
    | تحويل_عائم_ذراع_أربعة_وستون.طبيعي_إلى_عائم -> { أرجع 3; }
    | تحويل_عائم_ذراع_أربعة_وستون.عائم_إلى_عائم -> { أرجع 4; };
}

عرف ذري_ذراع_آلة(العملية: عملية_ذرية_ذراع): ط64 {
    طابق العملية مع
    | عملية_ذرية_ذراع.تبديل -> { أرجع 0; }
    | عملية_ذرية_ذراع.جلب_جمع -> { أرجع 1; }
    | عملية_ذرية_ذراع.جلب_و -> { أرجع 2; }
    | عملية_ذرية_ذراع.جلب_أو -> { أرجع 3; }
    | عملية_ذرية_ذراع.جلب_أو_حصري -> { أرجع 4; };
}

عرف أصدر_عنوان_ذراع_آلة(م: &متغير مترجم_دالة_آلة, العنوان: &عنوان_ذاكرة_ذراع_أربعة_وستون): فراغ {
    أصدر(م, سجل_آلة((*العنوان).الأساس));
    أصدر(م, لا_سجل_آلة());
    أصدر(م, 1);
    أصدر(م, عدد_كلمة_آلة((*العنوان).إزاحة_بايت));
}

// Frame slots: every frame-address request and literal header, by identity.
عرف اجمع_مواضع_ذراع_آلة(م: &متغير مترجم_دالة_آلة, الدالة: &دالة_ذراع_أربعة_وستون_منتقاة): اختياري متجه ط8 {
    دع الحجم: متغير ط64 = 0;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع الهوية: متغير طبيعي = 0;
            دع حجم_الموضع: متغير ط64 = 0;
            دع المحاذاة: متغير ط64 = 0;
            دع موضع: متغير منطقي = خطأ;
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز) -> {
                الهوية := الحجز.الهوية; حجم_الموضع := الحجز.الحجم مثل ط64;
                المحاذاة := الحجز.المحاذاة مثل ط64; موضع := صواب;
            }
            | تعليمة_ذراع_أربعة_وستون.ثابت_نص_ذراع(ث) -> {
                الهوية := ث.الهوية; حجم_الموضع := 24; المحاذاة := 8; موضع := صواب;
            }
            | _ -> { };
            إذا (موضع) {
                طابق إزاحة_موضع_آلة(م, الهوية) مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> {
                    إذا (المحاذاة > 16) { أرجع اختياري.موجود(رفض_آلة(«frame slot alignment above 16»)); };
                    إذا (المحاذاة == 0) { المحاذاة := 1; };
                    الحجم := حاذ_آلة(الحجم, المحاذاة);
                    ألحق((*م).معرفات_المواضع, الهوية);
                    ألحق((*م).إزاحات_المواضع, الحجم);
                    إذا (حجم_الموضع == 0) { حجم_الموضع := 1; };
                    الحجم := الحجم + حجم_الموضع;
                };
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    (*م).حجم_المواضع_ذراع := الحجم;
    أرجع اختياري.لا_شيء();
}

عرف عد_تعريفات_ذراع_آلة(العدادات: &متغير متجه ط64, التعليمة: &تعليمة_ذراع_أربعة_وستون): فراغ {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.عنوان_عام_ذراع(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.بيئة_إغلاق_ذراع(و) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(الاستلام) -> { عد_تعريف_آلة(العدادات, الاستلام.القيمة.السجل); }
    | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(ح) -> { عد_تعريف_آلة(العدادات, ح.الوجهة); }
    | تعليمة_ذراع_أربعة_وستون.حساب_عشري_ذراع(_, و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.قسمة_على_ثابت_ذراع(و, _, _, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.ضرب_جمع_مدمج_ذراع(و, _, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_عشرية_إلى_منطق_ذراع(_, و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.تحويل_صحيح_ذراع(ت_) -> { عد_تعريف_آلة(العدادات, ت_.الوجهة); }
    | تعليمة_ذراع_أربعة_وستون.تحويل_عائم_ذراع(_, و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.عنوان_إطار_ذراع(الحجز) -> { عد_تعريف_آلة(العدادات, الحجز.الوجهة); }
    | تعليمة_ذراع_أربعة_وستون.عنوان_إزاحة_ذراع(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.عنوان_عنصر_ذراع(و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.ثابت_نص_ذراع(ث) -> { عد_تعريف_آلة(العدادات, ث.الوجهة); }
    | تعليمة_ذراع_أربعة_وستون.تخصيص_صندوق_ذراع(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.جمع_سجل_ذراع(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.جمع_سجل_مزاح_ذراع(و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.جمع_فوري_ذراع(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.طرح_سجل_ذراع(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.طرح_فوري_ذراع(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.ثبت_شرط_ذراع(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.ذري_ذراع(_, و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.ذري_قارن_وبدل_ذراع(و, _, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.ذري_حمل_ذراع(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.مدخل_سي_ذراع(و) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_مع_نقلات(الحزمة) -> { عد_نقلات_آلة(العدادات, &الحزمة); }
    | تعليمة_ذراع_أربعة_وستون.فرع_ذراع_شرطي_مع_نقلات(_, الحزمة) -> { عد_نقلات_آلة(العدادات, &الحزمة); }
    | تعليمة_ذراع_أربعة_وستون.فرع_برابط_ذراع_مباشر(النداء) -> {
        طابق النداء.الناتج مع
        | اختياري.موجود(الناتج) -> { عد_تعريف_آلة(العدادات, الناتج.السجل); }
        | اختياري.لا_شيء -> { };
    }
    | تعليمة_ذراع_أربعة_وستون.تحميل_ذراع_أساس_إزاحة(و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | _ -> { };
}

عرف ارفع_ثوابت_ذراع_آلة(
    م: &متغير مترجم_دالة_آلة,
    الدالة: &دالة_ذراع_أربعة_وستون_منتقاة,
    العدد: ط64
): فراغ {
    دع العدادات: متغير متجه ط64 = [];
    دع ف: متغير ط64 = 0;
    طالما (ف < العدد) { ألحق(العدادات, 0); ألحق((*م).مرفوعة, خطأ); ف := ف + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            عد_تعريفات_ذراع_آلة(&متغير العدادات, &(*الدالة).الكتل[ك].التعليمات[ت]);
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع سجل: متغير ط64 = لا_سجل_آلة();
            دع قيمة: متغير ط64 = 0;
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(و, ق) -> { سجل := سجل_آلة(و); قيمة := عدد_كلمة_آلة(ق); }
            | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(و, ق) -> { سجل := سجل_آلة(و); قيمة := ق مثل ط64; }
            | تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(و, د) -> {
                سجل := سجل_آلة(و); قيمة := قاعدة_مقابض_آلة() + (د.القيمة مثل ط64);
            }
            | _ -> { };
            إذا (سجل != لا_سجل_آلة() && سجل < العدد && العدادات[سجل مثل طبيعي] == 1) {
                (*م).مرفوعة[سجل مثل طبيعي] := صواب;
                أصدر(م, 2); أصدر(م, سجل); أصدر(م, قيمة);
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
}

عرف ترجم_تعليمة_ذراع_آلة(
    ب: &متغير برنامج_آلة,
    م: &متغير مترجم_دالة_آلة,
    التعليمة: &تعليمة_ذراع_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    معرفات_الخارجيات: &متغير متجه طبيعي,
    الكومة: &متغير كومة_آلة,
    الذاكرة: &ذاكرة_خام,
    سجل_العلم: ط64
): منطقي {
    طابق *التعليمة مع
    | تعليمة_ذراع_أربعة_وستون.نقل_سجل_ذراع(و, م_) -> { أصدر(م, 1); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(م_)); }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع(و, ق) -> {
        إذا (!سجل_مرفوع_آلة(م, و)) { أصدر(م, 2); أصدر(م, سجل_آلة(و)); أصدر(م, عدد_كلمة_آلة(ق)); };
    }
    | تعليمة_ذراع_أربعة_وستون.مادي_فوري_ذراع_طبيعي(و, ق) -> {
        إذا (!سجل_مرفوع_آلة(م, و)) { أصدر(م, 2); أصدر(م, سجل_آلة(و)); أصدر(م, ق مثل ط64); };
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_دالة_ذراع(و, د) -> {
        إذا (!سجل_مرفوع_آلة(م, و)) { أصدر(م, 2); أصدر(م, سجل_آلة(و)); أصدر(م, قاعدة_مقابض_آلة() + (د.القيمة مثل ط64)); };
    }
    | تعليمة_ذراع_أربعة_وستون.عنوان_عام_ذراع(و, ع, _) -> {
        إذا ((ع.القيمة مثل طبيعي) >= (الطول((*ب).العوام) مثل طبيعي) || (*ب).العوام[ع.القيمة] == 0) {
            (*م).السبب := رفض_آلة(«global without storage»);
            أرجع خطأ;
        };
        أصدر(م, 2); أصدر(م, سجل_آلة(و)); أصدر(م, (*ب).العوام[ع.القيمة]);
    }
    | تعليمة_ذراع_أربعة_وستون.بيئة_إغلاق_ذراع(و) -> { أصدر(م, 3); أصدر(م, سجل_آلة(و)); }
    | تعليمة_ذراع_أربعة_وستون.استلام_معامل_ذراع(الاستلام) -> {
        دع ق: قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = قيمة_واجهة_من_ذراع_آلة(&الاستلام.القيمة);
        إذا ((الطول(ق.المواضع) مثل طبيعي) != 1) { (*م).السبب := رفض_آلة(«parameter in several ABI positions»); أرجع خطأ; };
        طابق موضع_واجهة_آلة(&ق.المواضع[0]) مع
        | اختياري.موجود(الكلمة) -> { أصدر(م, 46); أصدر(م, سجل_آلة(ق.السجل)); أصدر(م, الكلمة); }
        | اختياري.لا_شيء -> { (*م).السبب := رفض_آلة(«parameter position»); أرجع خطأ; };
        // A narrow parameter normalized to its type, as the AArch64 encoder
        // does on entry (a C caller, Apple's included, need not extend it to
        // 64 bits).
        أصدر_تطبيع_واجهة_ذراع_آلة(م, &الاستلام.القيمة);
    }
    | تعليمة_ذراع_أربعة_وستون.حساب_صحيح_ذراع(ح) -> {
        أصدر_حسابا_آلة(
            م, حساب_ذراع_آلة(ح.العملية, ح.الوصف.موقع), ح.الوجهة, ح.اليسار, ح.اليمين,
            ح.الوصف.البتات, ح.الوصف.موقع, صواب
        );
    }
    | تعليمة_ذراع_أربعة_وستون.حساب_عشري_ذراع(العملية, و, أ, ب_, البتات) -> {
        أصدر(م, 7); أصدر(م, حساب_عشري_ذراع_آلة(العملية)); أصدر(م, سجل_آلة(و));
        أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_)); أصدر(م, البتات مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.قسمة_على_ثابت_ذراع(و, المصدر, القاسم, البتات, موقع, باقي) -> {
        أصدر_قسمة_على_ثابت_آلة(م, و, المصدر, القاسم مثل ط64, البتات, موقع, باقي, صواب);
    }
    | تعليمة_ذراع_أربعة_وستون.ضرب_جمع_مدمج_ذراع(و, أ, ب_, ج, البتات) -> {
        أصدر(م, 56); أصدر(م, سجل_آلة(و)); أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_)); أصدر(م, سجل_آلة(ج));
        أصدر(م, البتات مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.مقارنة_عشرية_إلى_منطق_ذراع(العملية, و, أ, ب_, البتات) -> {
        أصدر(م, 9); أصدر(م, مقارنة_عشرية_ذراع_آلة(العملية)); أصدر(م, سجل_آلة(و));
        أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_)); أصدر(م, البتات مثل ط64);
    }
    | تعليمة_ذراع_أربعة_وستون.تحويل_صحيح_ذراع(ت_) -> {
        أصدر_تحويلا_ذراع_آلة(
            م, ت_.العملية, ت_.الوجهة, ت_.المصدر, ت_.بتات_المصدر, ت_.بتات_الوجهة, ت_.الوجهة_موقع
