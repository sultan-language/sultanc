// The machine interpreter's program: the native backend's selected machine
// code (backend/architectures/x86_64/selector.sn), before register
// allocation, rewritten as a compact word code the engine
// (machine_engine.sn) runs. Selection already lowered every MSIR operation,
// primitive and place to a few dozen instructions over virtual registers and
// memory, with the layouts the compiled program has; the interpreter keeps
// those semantics exactly and only replaces the machine with its own:
//
// - a virtual register is a 64-bit word of the frame (a narrow integer is held
//   zero-extended, as selection's registers are canonical);
// - memory is the host's (raw_memory.sn): local slots live in the frame,
//   globals in blocks the interpreter allocates, the heap in machine_heap.sn;
// - a call passes its words by ABI position (the selector's interface plans),
//   so a callee receives exactly what selection asked for;
// - a function value is a handle (قاعدة_مقابض_آلة + its MSIR id), never a
//   host code address; a C function receiving one is not supported.
//
// A program whose selection fails, or that needs an operation this engine
// does not run (threads, the task switch, a record passed to C by value), is
// not translated: the driver runs it with the checked interpreter instead.
//
// Code layout: one word vector; an instruction is its opcode word followed by
// its operands. Register operands are frame word indices; لا_سجل_آلة marks an
// absent register.
استورد compiler.interpreter.machine.raw_memory;
استورد compiler.interpreter.machine.machine_heap;
استورد compiler.interpreter.machine.machine_optimizer;
استورد compiler.interpreter.execution.host_dynamic;
استورد compiler.backend.codegen.selected_code_core;
استورد compiler.backend.codegen.virtual_registers;
استورد compiler.backend.codegen.codegen_boundary;
استورد compiler.backend.abi.abi_model;
استورد compiler.backend.architectures.x86_64.instruction_model;
استورد compiler.backend.architectures.x86_64.selected_code;
استورد compiler.backend.architectures.arm64.instruction_model;
استورد compiler.backend.architectures.arm64.selected_code;
استورد compiler.backend.provider.native.native_codegen;
استورد compiler.backend.native_output;
استورد compiler.backend.object.object_reference_model;
استورد compiler.backend.target.selection_query_context;
استورد compiler.backend.target.target_abi_resolution;
استورد compiler.backend.target.target_model;
استورد compiler.backend.layout.layout_model;
استورد compiler.msir.msir_consumer;
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.runtime.primitive_identity;
استورد compiler.diagnostics.primitive_names;
استورد compiler.frontend.types.type_context;
استورد std.text.from_bytes;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;

مرادف طرح_ملتف_ترجمة = بدائي_طرح_ملتف;

عام عرف لا_سجل_آلة(): ط64 { أرجع 0xFFFFFFFF; }
// Function values: the handle of MSIR function f is this base + f.
عام عرف قاعدة_مقابض_آلة(): ط64 { أرجع 0x5A5A000000000000; }
// The ABI transfer area: integer register i is word i, floating register i
// is word 16 + i, the indirect-result register is word 40, stack argument
// at byte offset o is word 48 + o: one word per byte, since Apple's AArch64
// ABI packs narrow stack arguments (an i8 at 0, a u16 at 2, an i32 at 4), so
// o / 8 would give them one word.
عام عرف حجم_منطقة_الواجهة_آلة(): ط64 { أرجع 4096; }
// Frame header words before a frame's registers: saved pc, saved frame,
// aggregate result address, closure environment, function, unused.
عام عرف رأس_إطار_آلة(): ط64 { أرجع 6; }

عام نوع دالة_آلة = {
    البداية: ط64,
    // Registers (with the two comparison words, rounded to an even count).
    السجلات: ط64,
    // All frame words: registers and local slots (even).
    الكلمات: ط64,
    مترجمة: منطقي
};

عام نوع خارجية_آلة = {
    الاسم: متجه ط8,
    المكتبة: اختياري متجه ط8,
    الأصناف: متجه صنف_سي_مضيف,
    الناتج: صنف_سي_مضيف,
    // Bytes of an integer result (0 for none), to drop the high bits C leaves.
    حجم_الناتج: ط64,
    منطقي_الناتج: منطقي,
    // Resolved on first call (0 = not yet; 1 = the generated table).
    العنوان: ط64,
    المعرف: معرف_دالة_خارجية_مسير
};

عام نوع برنامج_آلة = {
    الشفرة: متجه ط64,
    الدوال: متجه دالة_آلة,
    الخارجيات: متجه خارجية_آلة,
    // For a trap: the code position each MSIR block starts at, with its
    // block and function, in code order.
    مواضع_الكتل: متجه ط64,
    كتل_المواضع: متجه معرف_كتلة_مسير,
    // Addresses of the MSIR globals, by id (0 for none).
    العوام: متجه ط64,
    // The allocation providers whose calls are the engine's own storage
    // services (لا_سجل_آلة when absent).
    مزود_التخصيص: ط64,
    مزود_إعادة_التخصيص: ط64,
    مزود_التحرير: ط64,
    // std.async's task switch (اسم_تبديل_سياق_المهام_أساسي): a call to it is
    // the engine's own context switch (لا_سجل_آلة when absent).
    مبدل_المهام: ط64,
    // Byte offset of the entry closure in a fresh task's first frame, as
    // std.async's ابن_إطار_بداية_مهمة lays it out for the architecture the
    // program was compiled for (not the selector's): r12's slot (24) on
    // x86_64, x19's (0) on arm64. machine_entry.sn sets it.
    إزاحة_إغلاق_مهمة: ط64,
    // Handles of the libraries `run` loaded (-l), in command-line order
    // (load_libraries.sn): searched for an extern before the global scope.
    مقابض_المكتبات: متجه ط64,
    // std's allocation counter functions by kind (لا_سجل_آلة when absent):
    // a call to one is op 57 (machine_engine.sn عداد_آلة).
    دوال_العدادات: متجه ط64,
    // Machine primitives without a meaning here (threads), by operand of
    // op 47: running one fails as the checked interpreter fails.
    بدائيات_غير_مدعومة: متجه هوية_بدائي_مترجم,
    // The code and the function table (start, frame words, translated, -)
    // copied to raw memory for the engine: word indices (raw_memory.sn).
    أساس_الشفرة: ط64,
    جدول_الدوال: ط64,
    // Whether each function's code goes through machine_optimizer.sn, and
    // its buffers while the program is translated.
    محسن: منطقي,
    مساحة_المحسن: شفرة_محللة_آلة
};

عام نوع نتيجة_ترجمة_آلة =
    | نجحت بنوع برنامج_آلة
    // Why the program cannot run on the machine interpreter.
    | غير_مدعومة بنوع متجه ط8
;

// ---- Code emission --------------------------------------------------------

نوع مترجم_دالة_آلة = {
    الشفرة: متجه ط64,
    // Local slots: MSIR value id and byte offset in the slot area.
    معرفات_المواضع: متجه طبيعي,
    إزاحات_المواضع: متجه ط64,
    // Block id → code position.
    معرفات_الكتل: متجه طبيعي,
    مواضع_الكتل: متجه ط64,
    // Positions holding a block id to replace by its code position.
    مواضع_التثبيت: متجه طبيعي,
    // Byte offset of the slot area from the frame's first register word.
    بداية_المواضع: ط64,
    السبب: متجه ط8,
    // The function's first code position in the program.
    البداية: ط64,
    // Position (in الشفرة) of a compare-to-bool that is the last instruction
    // emitted, for fusing it with the branch on its result; لا_سجل_آلة else.
    آخر_مقارنة: ط64,
    // A frame word the sequential edge moves may use for a cycle.
    المؤقت: ط64,
    // Registers set once, by an immediate: set in the function's prologue,
    // so a loop does not set them again on every iteration.
    مرفوعة: متجه منطقي,
    // AArch64: an aggregate passed in floating registers (an HFA) travels in
    // parts of its element size, not in 8-byte parts.
    أجزاء_عائمة: منطقي,
    // AArch64: bytes of the frame slots its requests name.
    حجم_المواضع_ذراع: ط64,
    // The id of the block laid out after the one being translated
    // (لا_سجل_آلة for the last): a jump to it is a fall-through.
    الكتلة_التالية: ط64,
    // Position of the last conditional branch on a value (op 51 or 34)
    // without edge moves, for inverting it over a following jump.
    آخر_فرع: ط64,
    // The block being translated ends by falling through to the next one
    // (its jump was elided), so it gets no trap guard.
    يسقط: منطقي
};

عرف رفض_آلة(النص: نص): متجه ط8 { أرجع بايتات_من_نص(النص); }

عرف أصدر(م: &متغير مترجم_دالة_آلة, الكلمة: ط64): فراغ { ألحق((*م).الشفرة, الكلمة); }

عرف سجل_آلة(السجل: معرف_سجل_افتراضي): ط64 { أرجع السجل.القيمة مثل ط64; }

عرف سجل_اختياري_آلة(السجل: &اختياري معرف_سجل_افتراضي): ط64 {
    طابق *السجل مع
    | اختياري.موجود(س) -> { أرجع س.القيمة مثل ط64; }
    | اختياري.لا_شيء -> { أرجع لا_سجل_آلة(); };
}

عرف عدد_كلمة_آلة(القيمة: عدد): ط64 { أرجع القيمة مثل ط64; }

عرف أصدر_عنوان_آلة(م: &متغير مترجم_دالة_آلة, العنوان: &عنوان_ذاكرة_إكس_ستة_وثمانون_أربعة_وستون): فراغ {
    أصدر(م, سجل_اختياري_آلة(&(*العنوان).الأساس));
    أصدر(م, سجل_اختياري_آلة(&(*العنوان).الفهرس));
    أصدر(م, (*العنوان).المقياس مثل ط64);
    أصدر(م, عدد_كلمة_آلة((*العنوان).الإزاحة));
}

// A block id operand, fixed up once every block's position is known.
// An unconditional jump to الكتلة: nothing when it is the next block; a
// branch just before it whose target is the next block is inverted to
// target الكتلة instead (the branch then falls through to the next block).
عرف أصدر_قفزا_آلة(م: &متغير مترجم_دالة_آلة, الكتلة: معرف_كتلة_منتقاة): فراغ {
    دع الهدف: ط64 = الكتلة.القيمة مثل ط64;
    إذا (الهدف == (*م).الكتلة_التالية) { (*م).يسقط := صواب; أرجع; };
    دع الطول_: ط64 = الطول((*م).الشفرة) مثل ط64;
    دع ف: ط64 = (*م).آخر_فرع;
    إذا (ف != لا_سجل_آلة() && (*م).الكتلة_التالية != لا_سجل_آلة()) {
        دع op: ط64 = (*م).الشفرة[ف مثل طبيعي];
        إذا (op == 51 && ف + 7 == الطول_ && (*م).الشفرة[(ف + 6) مثل طبيعي] == (*م).الكتلة_التالية) {
            (*م).الشفرة[ف مثل طبيعي] := 52;
            (*م).الشفرة[(ف + 6) مثل طبيعي] := الهدف;
            (*م).آخر_فرع := لا_سجل_آلة();
            (*م).يسقط := صواب;
            أرجع;
        };
        إذا (op == 34 && ف + 3 == الطول_ && (*م).الشفرة[(ف + 2) مثل طبيعي] == (*م).الكتلة_التالية) {
            (*م).الشفرة[ف مثل طبيعي] := 49;
            (*م).الشفرة[(ف + 2) مثل طبيعي] := الهدف;
            (*م).آخر_فرع := لا_سجل_آلة();
            (*م).يسقط := صواب;
            أرجع;
        };
    };
    أصدر(م, 29); أصدر_كتلة_آلة(م, الكتلة);
}

عرف أصدر_كتلة_آلة(م: &متغير مترجم_دالة_آلة, الكتلة: معرف_كتلة_منتقاة): فراغ {
    ألحق((*م).مواضع_التثبيت, الطول((*م).الشفرة) مثل طبيعي);
    أصدر(م, الكتلة.القيمة مثل ط64);
}

// An edge's parallel moves as single moves: a move goes once no other
// pending move reads its destination; a cycle goes through المؤقت.
عرف أصدر_نقلات_متتابعة_آلة(م: &متغير مترجم_دالة_آلة, الحزمة: &متطلبات_نقل_حافة_منتقاة): فراغ {
    دع المصادر: متغير متجه ط64 = [];
    دع الوجهات: متغير متجه ط64 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحزمة).النقلات) مثل طبيعي)) {
        دع م_: ط64 = سجل_آلة((*الحزمة).النقلات[ف].المصدر);
        دع و_: ط64 = سجل_آلة((*الحزمة).النقلات[ف].الوجهة);
        إذا (م_ != و_) { ألحق(المصادر, م_); ألحق(الوجهات, و_); };
        ف := ف + 1;
    }
    دع منجزة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < (الطول(المصادر) مثل طبيعي)) { ألحق(منجزة, خطأ); ف := ف + 1; }
    دع الباقي: متغير طبيعي = الطول(المصادر) مثل طبيعي;
    طالما (الباقي > 0) {
        دع تقدم: متغير منطقي = خطأ;
        ف := 0;
        طالما (ف < (الطول(المصادر) مثل طبيعي)) {
            إذا (!منجزة[ف]) {
                دع مقروءة: متغير منطقي = خطأ;
                دع ج: متغير طبيعي = 0;
                طالما (ج < (الطول(المصادر) مثل طبيعي)) {
                    إذا (!منجزة[ج] && ج != ف && المصادر[ج] == الوجهات[ف]) { مقروءة := صواب; };
                    ج := ج + 1;
                }
                إذا (!مقروءة) {
                    أصدر(م, 1); أصدر(م, الوجهات[ف]); أصدر(م, المصادر[ف]);
                    منجزة[ف] := صواب;
                    الباقي := الباقي - 1;
                    تقدم := صواب;
                };
            };
            ف := ف + 1;
        }
        إذا (!تقدم) {
            // A cycle: park one source in المؤقت and read it from there.
            ف := 0;
            دع تم: متغير منطقي = خطأ;
            طالما (ف < (الطول(المصادر) مثل طبيعي) && !تم) {
                إذا (!منجزة[ف]) {
                    أصدر(م, 1); أصدر(م, (*م).المؤقت); أصدر(م, المصادر[ف]);
                    المصادر[ف] := (*م).المؤقت;
                    تم := صواب;
                };
                ف := ف + 1;
            }
        };
    }
}

// Code position for a local label: the function's start plus its length.
عرف موضع_حالي_آلة(م: &مترجم_دالة_آلة): ط64 {
    أرجع (*م).البداية + (الطول((*م).الشفرة) مثل ط64);
}

عرف عكس_شرط_آلة(الشرط: ط64): ط64 {
    طابق الشرط مثل ط32 مع
    | 0 -> { أرجع 1; }
    | 1 -> { أرجع 0; }
    | 2 -> { أرجع 5; }
    | 3 -> { أرجع 4; }
    | 4 -> { أرجع 3; }
    | 5 -> { أرجع 2; }
    | 6 -> { أرجع 9; }
    | 7 -> { أرجع 8; }
    | 8 -> { أرجع 7; }
    | _ -> { أرجع 6; };
}

// A conditional edge: when the branch below (at موضع_الفرع) is taken the
// edge's moves run, then the jump. The branch was emitted with its target
// word last; it jumps over the moves when they apply to the other path.
عرف أصدر_فرعا_بنقلات_آلة(م: &متغير مترجم_دالة_آلة, الحزمة: &متطلبات_نقل_حافة_منتقاة): فراغ {
    // The branch's target word is the last word emitted: patch it after.
    دع موضع_الهدف: طبيعي = (الطول((*م).الشفرة) مثل طبيعي) - 1;
    أصدر_نقلات_متتابعة_آلة(م, الحزمة);
    أصدر(م, 29); أصدر_كتلة_آلة(م, (*الحزمة).الهدف);
    (*م).الشفرة[موضع_الهدف] := موضع_حالي_آلة(م);
}

عرف نقلات_فعلية_آلة(الحزمة: &متطلبات_نقل_حافة_منتقاة): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحزمة).النقلات) مثل طبيعي)) {
        إذا ((*الحزمة).النقلات[ف].المصدر.القيمة != (*الحزمة).النقلات[ف].الوجهة.القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف شرط_آلة(الشرط: شرط_إكس_ستة_وثمانون_أربعة_وستون): ط64 {
    طابق الشرط مع
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.تكافؤ -> { أرجع 0; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.لاتكافؤ -> { أرجع 1; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة -> { أرجع 2; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أقل_بإشارة_أو_مساو -> { أرجع 3; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة -> { أرجع 4; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أكبر_بإشارة_أو_مساو -> { أرجع 5; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي -> { أرجع 6; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أدنى_طبيعي_أو_مساو -> { أرجع 7; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي -> { أرجع 8; }
    | شرط_إكس_ستة_وثمانون_أربعة_وستون.أعلى_طبيعي_أو_مساو -> { أرجع 9; };
}

عرف حساب_آلة(العملية: حساب_صحيح_إكس_كامل): ط64 {
    طابق العملية مع
    | حساب_صحيح_إكس_كامل.جمع -> { أرجع 0; }
    | حساب_صحيح_إكس_كامل.طرح -> { أرجع 1; }
    | حساب_صحيح_إكس_كامل.ضرب -> { أرجع 2; }
    | حساب_صحيح_إكس_كامل.قسمة_موقعة -> { أرجع 3; }
    | حساب_صحيح_إكس_كامل.قسمة_طبيعية -> { أرجع 4; }
    | حساب_صحيح_إكس_كامل.باقي_موقع -> { أرجع 5; }
    | حساب_صحيح_إكس_كامل.باقي_طبيعي -> { أرجع 6; }
    | حساب_صحيح_إكس_كامل.أو_بتي -> { أرجع 7; }
    | حساب_صحيح_إكس_كامل.أو_حصري -> { أرجع 8; }
    | حساب_صحيح_إكس_كامل.و_بتي -> { أرجع 9; }
    | حساب_صحيح_إكس_كامل.إزاحة_يسرى -> { أرجع 10; }
    | حساب_صحيح_إكس_كامل.إزاحة_يمنى -> { أرجع 11; }
    | حساب_صحيح_إكس_كامل.إزاحة_حسابية_يمنى -> { أرجع 12; }
    | حساب_صحيح_إكس_كامل.جمع_ملتف -> { أرجع 13; }
    | حساب_صحيح_إكس_كامل.طرح_ملتف -> { أرجع 14; }
    | حساب_صحيح_إكس_كامل.ضرب_ملتف -> { أرجع 15; }
    | حساب_صحيح_إكس_كامل.إزاحة_يسرى_ملتفة -> { أرجع 16; };
}

عرف تحويل_آلة(العملية: تحويل_صحيح_إكس_كامل): ط64 {
    طابق العملية مع
    | تحويل_صحيح_إكس_كامل.توسيع_بإشارة -> { أرجع 0; }
    | تحويل_صحيح_إكس_كامل.توسيع_صفري -> { أرجع 1; }
    | تحويل_صحيح_إكس_كامل.اقتطاع -> { أرجع 2; }
    | تحويل_صحيح_إكس_كامل.إعادة_تفسير -> { أرجع 3; };
}

عرف حساب_عشري_آلة(العملية: حساب_عشري_إكس_كامل): ط64 {
    طابق العملية مع
    | حساب_عشري_إكس_كامل.جمع -> { أرجع 0; }
    | حساب_عشري_إكس_كامل.طرح -> { أرجع 1; }
    | حساب_عشري_إكس_كامل.ضرب -> { أرجع 2; }
    | حساب_عشري_إكس_كامل.قسمة -> { أرجع 3; }
    | حساب_عشري_إكس_كامل.جذر_تربيعي -> { أرجع 4; }
    | حساب_عشري_إكس_كامل.قيمة_مطلقة -> { أرجع 5; }
    | حساب_عشري_إكس_كامل.نسخ_إشارة -> { أرجع 6; }
    | حساب_عشري_إكس_كامل.أدنى -> { أرجع 7; }
    | حساب_عشري_إكس_كامل.أقصى -> { أرجع 8; };
}

عرف مقارنة_عشرية_آلة(العملية: مقارنة_عشرية_إكس_كاملة): ط64 {
    طابق العملية مع
    | مقارنة_عشرية_إكس_كاملة.يساوي -> { أرجع 0; }
    | مقارنة_عشرية_إكس_كاملة.لا_يساوي -> { أرجع 1; }
    | مقارنة_عشرية_إكس_كاملة.أصغر -> { أرجع 2; }
    | مقارنة_عشرية_إكس_كاملة.أصغر_أو_يساوي -> { أرجع 3; }
    | مقارنة_عشرية_إكس_كاملة.أكبر -> { أرجع 4; }
    | مقارنة_عشرية_إكس_كاملة.أكبر_أو_يساوي -> { أرجع 5; };
}

عرف تحويل_عائم_آلة(العملية: تحويل_عائم_إكس_كامل): ط64 {
    طابق العملية مع
    | تحويل_عائم_إكس_كامل.عائم_إلى_موقع -> { أرجع 0; }
    | تحويل_عائم_إكس_كامل.عائم_إلى_طبيعي -> { أرجع 1; }
    | تحويل_عائم_إكس_كامل.موقع_إلى_عائم -> { أرجع 2; }
    | تحويل_عائم_إكس_كامل.طبيعي_إلى_عائم -> { أرجع 3; }
    | تحويل_عائم_إكس_كامل.عائم_إلى_عائم -> { أرجع 4; };
}

عرف ذري_آلة(العملية: عملية_ذرية_إكس): ط64 {
    طابق العملية مع
    | عملية_ذرية_إكس.تبديل -> { أرجع 0; }
    | عملية_ذرية_إكس.جلب_جمع -> { أرجع 1; }
    | عملية_ذرية_إكس.جلب_و -> { أرجع 2; }
    | عملية_ذرية_إكس.جلب_أو -> { أرجع 3; }
    | عملية_ذرية_إكس.جلب_أو_حصري -> { أرجع 4; };
}

// The transfer-area word of an ABI position.
عرف موضع_واجهة_آلة(الموضع: &موضع_جزء_واجهة): اختياري ط64 {
    طابق *الموضع مع
    | موضع_جزء_واجهة.سجل(المرجع) -> {
        طابق المرجع.الفئة مع
        | فئة_سجل_واجهة.عدد_صحيح -> {
            إذا (المرجع.الفهرس >= 16) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(المرجع.الفهرس مثل ط64);
        }
        | فئة_سجل_واجهة.عائم_متجه -> {
            إذا (المرجع.الفهرس >= 16) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(16 + (المرجع.الفهرس مثل ط64));
        }
        | فئة_سجل_واجهة.نتيجة_غير_مباشرة -> { أرجع اختياري.موجود(40); };
    }
    | موضع_جزء_واجهة.مكدس(المكدس) -> {
        دع الكلمة: ط64 = 48 + (المكدس.الإزاحة مثل ط64);
        إذا (الكلمة >= حجم_منطقة_الواجهة_آلة()) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الكلمة);
    };
}

عرف كلها_عائمة_آلة(المواضع: &متجه موضع_جزء_واجهة): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        طابق موضع_واجهة_آلة(&(*المواضع)[ف]) مع
        | اختياري.موجود(الكلمة) -> { إذا (الكلمة < 16 || الكلمة >= 32) { أرجع خطأ; }; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// One interface value: kind (0 scalar, 1 aggregate in 8-byte parts, 2
// aggregate by address, 4 aggregate in parts of size / count: an AArch64
// HFA), register, size, count of positions, positions.
عرف أصدر_قيمة_واجهة_آلة(
    م: &متغير مترجم_دالة_آلة,
    القيمة: &قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة
): منطقي {
    دع النوع: متغير ط64 = 0;
    إذا ((*القيمة).تجميعي) {
        إذا ((*القيمة).غير_مباشر) { النوع := 2; } وإلا { النوع := 1; };
    };
    إذا (النوع == 1 && (*م).أجزاء_عائمة && كلها_عائمة_آلة(&(*القيمة).المواضع)) { النوع := 4; };
    أصدر(م, النوع);
    أصدر(م, سجل_آلة((*القيمة).السجل));
    أصدر(م, (*القيمة).الحجم مثل ط64);
    دع ن: طبيعي = الطول((*القيمة).المواضع) مثل طبيعي;
    إذا (ن == 0) { أرجع خطأ; };
    أصدر(م, ن مثل ط64);
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        طابق موضع_واجهة_آلة(&(*القيمة).المواضع[ف]) مع
        | اختياري.موجود(الكلمة) -> { أصدر(م, الكلمة); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Arguments, then the result: kind (0 none, 1 scalar, 2 aggregate,
// 3 aggregate through the indirect-result register), register, size,
// position.
عرف أصدر_حجج_وناتج_آلة(
    م: &متغير مترجم_دالة_آلة,
    النداء: &نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى
): منطقي {
    دع ن: طبيعي = الطول((*النداء).الحجج) مثل طبيعي;
    أصدر(م, ن مثل ط64);
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        إذا (!أصدر_قيمة_واجهة_آلة(م, &(*النداء).الحجج[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    طابق (*النداء).الناتج مع
    | اختياري.لا_شيء -> { أصدر(م, 0); أصدر(م, لا_سجل_آلة()); أصدر(م, 0); أصدر(م, 0); }
    | اختياري.موجود(الناتج) -> {
        دع الموضع: متغير ط64 = 0;
        إذا ((الطول(الناتج.المواضع) مثل طبيعي) > 0) {
            طابق موضع_واجهة_آلة(&الناتج.المواضع[0]) مع
            | اختياري.موجود(الكلمة) -> { الموضع := الكلمة; }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        };
        إذا (الناتج.تجميعي) {
            إذا (الناتج.غير_مباشر) { أصدر(م, 3); } وإلا { أصدر(م, 2); };
        } وإلا {
            أصدر(م, 1);
        };
        أصدر(م, سجل_آلة(الناتج.السجل));
        أصدر(م, الناتج.الحجم مثل ط64);
        أصدر(م, الموضع);
    };
    أرجع صواب;
}

// A call of a program function with up to three arguments, each one word
// in one ABI position, and no result or one in a register: ops 109..112
// (by argument count): the function, each argument's register and
// transfer-area word, then the result's register (لا_سجل_آلة for none) and
// word. False, emitting nothing, for any other call.
عرف أصدر_نداء_بسيطا_آلة(
    م: &متغير مترجم_دالة_آلة, الدالة: ط64, النداء: &نداء_إكس_ستة_وثمانون_أربعة_وستون_منتقى
): منطقي {
    دع ن: طبيعي = الطول((*النداء).الحجج) مثل طبيعي;
    إذا (ن > 3) { أرجع خطأ; };
    دع المواضع: متغير متجه ط64 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        دع الحجة: &قيمة_واجهة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة = &(*النداء).الحجج[ف];
        إذا ((*الحجة).تجميعي || (الطول((*الحجة).المواضع) مثل طبيعي) != 1) { أرجع خطأ; };
        طابق موضع_واجهة_آلة(&(*الحجة).المواضع[0]) مع
        | اختياري.موجود(الكلمة) -> { ألحق(المواضع, الكلمة); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ف := ف + 1;
    }
    دع سجل_الناتج: متغير ط64 = لا_سجل_آلة();
    دع موضع_الناتج: متغير ط64 = 0;
    طابق (*النداء).الناتج مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الناتج) -> {
        إذا (الناتج.تجميعي || (الطول(الناتج.المواضع) مثل طبيعي) == 0) { أرجع خطأ; };
        طابق موضع_واجهة_آلة(&الناتج.المواضع[0]) مع
        | اختياري.موجود(الكلمة) -> { موضع_الناتج := الكلمة; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        سجل_الناتج := سجل_آلة(الناتج.السجل);
    };
    أصدر(م, 109 + (ن مثل ط64)); أصدر(م, الدالة);
    ف := 0;
    طالما (ف < ن) {
        أصدر(م, سجل_آلة((*النداء).الحجج[ف].السجل)); أصدر(م, المواضع[ف]);
        ف := ف + 1;
    }
    أصدر(م, سجل_الناتج); أصدر(م, موضع_الناتج);
    أرجع صواب;
}

عرف إزاحة_موضع_آلة(م: &مترجم_دالة_آلة, المعرف: طبيعي): اختياري ط64 {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*م).معرفات_المواضع) مثل طبيعي)) {
        إذا ((*م).معرفات_المواضع[ف] == المعرف) {
            أرجع اختياري.موجود((*م).بداية_المواضع + (*م).إزاحات_المواضع[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// ---- Externs ----------------------------------------------------------------

عرف صنف_سي_لنوع_آلة(الأنواع: &سجل_أنواع, النوع: معرف_نوع): صنف_سي_مضيف {
    طابق بتات_عائم_للاختيار(الأنواع, النوع) مع
    | اختياري.موجود(32) -> { أرجع صنف_سي_مضيف.عائم32(); }
    | اختياري.موجود(64) -> { أرجع صنف_سي_مضيف.عائم64(); }
    | _ -> { أرجع صنف_سي_مضيف.صحيح(); };
}

// The extern table index of an MSIR extern, adding it on first use.
عرف خارجية_آلة_لمعرف(
    ب: &متغير برنامج_آلة,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    المعرفات: &متغير متجه طبيعي,
    المعرف: معرف_دالة_خارجية_منتقاة,
    حجم_الناتج: ط64
): اختياري ط64 {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعرفات) مثل طبيعي)) {
        إذا ((*المعرفات)[ف] == المعرف.القيمة) { أرجع اختياري.موجود(ف مثل ط64); };
        ف := ف + 1;
    }
    دع معرف_مسير: معرف_دالة_خارجية_مسير = معرف_دالة_خارجية_مسير_من(المعرف.القيمة);
    طابق ابحث_دالة_خارجية_مسير(المسير, معرف_مسير) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الدالة) -> {
        دع الأصناف: متغير متجه صنف_سي_مضيف = [];
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(الدالة.المعاملات) مثل طبيعي)) {
            ألحق(الأصناف, صنف_سي_لنوع_آلة(الأنواع, الدالة.المعاملات[م]));
            م := م + 1;
        }
        دع الناتج: متغير صنف_سي_مضيف = صنف_سي_مضيف.صحيح();
        دع منطقي_الناتج: متغير منطقي = خطأ;
        طابق الدالة.الناتج مع
        | اختياري.موجود(النوع) -> {
            الناتج := صنف_سي_لنوع_آلة(الأنواع, النوع);
            منطقي_الناتج := هل_نوع_منطقي_آلة(الأنواع, النوع);
        }
        | اختياري.لا_شيء -> { };
        دع الخارجية: خارجية_آلة = {
            الاسم: انسخ_بايتات(&الدالة.الاسم), المكتبة: انسخ_اختيار_بايتات(&الدالة.المكتبة), الأصناف: الأصناف,
            الناتج: الناتج, حجم_الناتج: حجم_الناتج, منطقي_الناتج: منطقي_الناتج, العنوان: 0,
            المعرف: معرف_مسير
        };
        ألحق((*ب).الخارجيات, الخارجية);
        ألحق(*المعرفات, المعرف.القيمة);
        أرجع اختياري.موجود(((الطول((*ب).الخارجيات) مثل طبيعي) - 1) مثل ط64);
    };
}

// ---- Constants ------------------------------------------------------------------

عرف سجل_مرفوع_آلة(م: &مترجم_دالة_آلة, السجل: معرف_سجل_افتراضي): منطقي {
    أرجع السجل.القيمة < (الطول((*م).مرفوعة) مثل طبيعي) && (*م).مرفوعة[السجل.القيمة];
}

عرف عد_تعريف_آلة(العدادات: &متغير متجه ط64, السجل: معرف_سجل_افتراضي): فراغ {
    إذا (السجل.القيمة < (الطول(*العدادات) مثل طبيعي)) {
        (*العدادات)[السجل.القيمة] := (*العدادات)[السجل.القيمة] + 1;
    };
}

عرف عد_نقلات_آلة(العدادات: &متغير متجه ط64, الحزمة: &متطلبات_نقل_حافة_منتقاة): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحزمة).النقلات) مثل طبيعي)) {
        عد_تعريف_آلة(العدادات, (*الحزمة).النقلات[ف].الوجهة);
        ف := ف + 1;
    }
}

// Counts every definition of each register (an edge's moves define their
// destinations; a two-address add or subtract redefines its destination).
عرف عد_تعريفات_تعليمة_آلة(العدادات: &متغير متجه ط64, التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون): فراغ {
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(القيمة) -> { عد_تعريف_آلة(العدادات, القيمة.السجل); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_عام_إكس(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.بيئة_إغلاق_إكس(و) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(_, و, _, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_صحيح_كامل_إكس(_, و, _, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_عشري_إكس(_, و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قسمة_على_ثابت_إكس(و, _, _, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_عائم_إكس(_, و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_عشرية_إلى_منطق_إكس(_, و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_إلى_منطق_إكس(و, _, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.جمع_ثنائي_العنوان_إكس(و, _) -> { عد_تعريف_آلة(العدادات, و); عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.جمع_ثنائي_العنوان_إكس_مع_فخ_تجاوز(و, _, _) -> { عد_تعريف_آلة(العدادات, و); عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.طرح_ثنائي_العنوان_إكس(و, _) -> { عد_تعريف_آلة(العدادات, و); عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.طرح_ثنائي_العنوان_إكس_مع_فخ_تجاوز(و, _, _) -> { عد_تعريف_آلة(العدادات, و); عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_إكس(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تكوين_عنوان_مقاس_إكس(و, _, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_موضع_محلي_إكس(و, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_صندوق_إكس(و, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحميل_إكس(و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_إكس(_, و, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.ذري_قارن_وبدل_إكس(و, _, _, _, _) -> { عد_تعريف_آلة(العدادات, و); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_إكس_مع_نقلات(الحزمة) -> { عد_نقلات_آلة(العدادات, &الحزمة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_إكس_مع_نقلات(_, الحزمة) -> { عد_نقلات_آلة(العدادات, &الحزمة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.قفز_شرطي_بقيمة_إكس(_, الحزمة) -> { عد_نقلات_آلة(العدادات, &الحزمة); }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نداء_إكس_مباشر(النداء) -> {
        طابق النداء.الناتج مع
        | اختياري.موجود(الناتج) -> { عد_تعريف_آلة(العدادات, الناتج.السجل); }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
}

// The registers of الدالة set exactly once, by an immediate, and their words.
عرف ارفع_ثوابت_آلة(
    م: &متغير مترجم_دالة_آلة,
    الدالة: &دالة_إكس_ستة_وثمانون_أربعة_وستون_منتقاة,
    العدد: ط64
): فراغ {
    دع العدادات: متغير متجه ط64 = [];
    دع ف: متغير ط64 = 0;
    طالما (ف < العدد) { ألحق(العدادات, 0); ألحق((*م).مرفوعة, خطأ); ف := ف + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            عد_تعريفات_تعليمة_آلة(&متغير العدادات, &(*الدالة).الكتل[ك].التعليمات[ت]);
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع سجل: متغير ط64 = لا_سجل_آلة();
            دع قيمة: متغير ط64 = 0;
            طابق (*الدالة).الكتل[ك].التعليمات[ت] مع
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(و, ق) -> { سجل := سجل_آلة(و); قيمة := عدد_كلمة_آلة(ق); }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(و, ق) -> { سجل := سجل_آلة(و); قيمة := ق مثل ط64; }
            | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(و, د) -> {
                سجل := سجل_آلة(و); قيمة := قاعدة_مقابض_آلة() + (د.القيمة مثل ط64);
            }
            | _ -> { };
            إذا (سجل != لا_سجل_آلة() && سجل < العدد && العدادات[سجل مثل طبيعي] == 1) {
                (*م).مرفوعة[سجل مثل طبيعي] := صواب;
                أصدر(م, 2); أصدر(م, سجل); أصدر(م, قيمة);
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
}

// An integer conversion (codes of تحويل_آلة); between 64-bit values every
// one is the value itself: a move.
عرف أصدر_تحويلا_صحيحا_آلة(
    م: &متغير مترجم_دالة_آلة, العملية: ط64, الوجهة: معرف_سجل_افتراضي, المصدر: معرف_سجل_افتراضي,
    من_بتات: طبيعي, إلى_بتات: طبيعي, موقع: منطقي
): فراغ {
    إذا (من_بتات >= 64 && إلى_بتات >= 64) {
        أصدر(م, 1); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, سجل_آلة(المصدر));
        أرجع;
    };
    أصدر(م, 6); أصدر(م, العملية); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, سجل_آلة(المصدر));
    أصدر(م, من_بتات مثل ط64); أصدر(م, إلى_بتات مثل ط64);
    إذا (موقع) { أصدر(م, 1); } وإلا { أصدر(م, 0); };
}

// A division or remainder by a constant: at 64 bits by a divisor that
// cannot trap, ops 105..108 (unsigned quotient, unsigned remainder, signed
// quotient, signed remainder).
عرف أصدر_قسمة_على_ثابت_آلة(
    م: &متغير مترجم_دالة_آلة, الوجهة: معرف_سجل_افتراضي, المصدر: معرف_سجل_افتراضي,
    القاسم: ط64, البتات: طبيعي, موقع: منطقي, باقي: منطقي, موسع: منطقي
): فراغ {
    إذا (البتات == 64 && القاسم != 0 && !(موقع && القاسم == ~(0 مثل ط64))) {
        دع op: متغير ط64 = 105;
        إذا (موقع) { op := 107; };
        إذا (باقي) { op := op + 1; };
        أصدر(م, op); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, سجل_آلة(المصدر)); أصدر(م, القاسم);
        أرجع;
    };
    أصدر(م, 10); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, سجل_آلة(المصدر)); أصدر(م, القاسم);
    أصدر(م, البتات مثل ط64);
    أصدر(م, علم_إشارة_آلة(موقع, موسع, البتات));
    إذا (باقي) { أصدر(م, 1); } وإلا { أصدر(م, 0); };
}

// One integer operation (codes of حساب_آلة); 64-bit wrapping, bitwise and
// unsigned checked add/subtract have their own opcodes.
عرف أصدر_حسابا_آلة(
    م: &متغير مترجم_دالة_آلة, رمز: ط64,
    الوجهة: معرف_سجل_افتراضي, أ: معرف_سجل_افتراضي, ب_: معرف_سجل_افتراضي,
    البتات: طبيعي, بإشارة: منطقي, موسع: منطقي
): فراغ {
    دع خاصة: منطقي = البتات == 64 && (رمز == 13 || رمز == 7 || رمز == 8 || رمز == 9 || رمز == 14);
    دع غير_موقعة: منطقي = البتات == 64 && (رمز == 0 || رمز == 1) && !بإشارة;
    // Signed 64-bit checked add and subtract (the language's عدد): ops 75, 76.
    دع موقعة: منطقي = البتات == 64 && (رمز == 0 || رمز == 1) && بإشارة;
    إذا (موقعة) {
        أصدر(م, 75 + رمز);
        أصدر(م, سجل_آلة(الوجهة)); أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_));
        أرجع;
    };
    // 64-bit checked multiply (102 unsigned, 113 signed), unsigned divide
    // and remainder (103, 104).
    دع خاص64: متغير ط64 = 0;
    إذا (البتات == 64 && رمز == 2) { إذا (بإشارة) { خاص64 := 113; } وإلا { خاص64 := 102; }; };
    إذا (البتات == 64 && رمز == 4) { خاص64 := 103; };
    إذا (البتات == 64 && رمز == 6) { خاص64 := 104; };
    إذا (خاص64 != 0) {
        أصدر(م, خاص64);
        أصدر(م, سجل_آلة(الوجهة)); أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_));
        أرجع;
    };
    إذا (خاصة) {
        أصدر(م, 60 + رمز);
    } وإلا إذا (غير_موقعة && رمز == 0) {
        أصدر(م, 5);
    } وإلا إذا (غير_موقعة) {
        أصدر(م, 50);
    } وإلا {
        أصدر(م, 4); أصدر(م, رمز);
    };
    أصدر(م, سجل_آلة(الوجهة)); أصدر(م, سجل_آلة(أ)); أصدر(م, سجل_آلة(ب_));
    إذا (!خاصة && !غير_موقعة) {
        أصدر(م, البتات مثل ط64);
        أصدر(م, علم_إشارة_آلة(بإشارة, موسع, البتات));
    };
}

// The signedness word of ops 4 and 10: 0 unsigned, 1 signed, 3 signed with
// the narrow result sign-extended to 64 bits (موسع: AArch64, whose registers
// hold an integer normalized to its type and whose comparisons read whole
// registers; x86-64's narrow comparisons mask their operands).
عرف علم_إشارة_آلة(بإشارة: منطقي, موسع: منطقي, البتات: طبيعي): ط64 {
    إذا (!بإشارة) { أرجع 0; };
    إذا (موسع && البتات < 64) { أرجع 3; };
    أرجع 1;
}

// A narrow interface value (a parameter, a C call's result) normalized to
// its type in its register: sign-extended when signed, zero-extended else.
عرف أصدر_تطبيع_واجهة_ذراع_آلة(م: &متغير مترجم_دالة_آلة, ق: &قيمة_واجهة_ذراع_أربعة_وستون_منتقاة): فراغ {
    إذا ((*ق).تجميعي != 0 || (*ق).غير_مباشر != 0 || (*ق).الحجم == 0 || (*ق).الحجم >= 8) { أرجع; };
    دع النوع: متغير ط64 = 1;
    إذا ((*ق).بإشارة != 0) { النوع := 0; };
    أصدر_تحويلا_صحيحا_آلة(م, النوع, (*ق).السجل, (*ق).السجل, (*ق).الحجم * 8, 64, (*ق).بإشارة != 0);
}

// An AArch64 integer conversion: its result normalized to the destination
// type (sign-extended when it is signed, zero-extended otherwise), as the
// AArch64 encoder's ألحق_تحويل_صحيح_ذراع leaves it, in one op 6
// (حول_صحيح_آلة: kind 0 sign-extends from من_بتات, kind 1 zero-extends from
// it, both then masked to إلى_بتات).
عرف أصدر_تحويلا_ذراع_آلة(
    م: &متغير مترجم_دالة_آلة, العملية: عملية_تحويل_ذراع_أربعة_وستون, الوجهة: معرف_سجل_افتراضي,
    المصدر: معرف_سجل_افتراضي, بتات_المصدر: طبيعي, بتات_الوجهة: طبيعي, الوجهة_موقع: منطقي
): فراغ {
    دع النوع: متغير ط64 = 0;
    دع بتات_من: متغير طبيعي = بتات_الوجهة;
    دع بتات_إلى: متغير طبيعي = 64;
    طابق العملية مع
    | عملية_تحويل_ذراع_أربعة_وستون.توسيع_بإشارة -> {
        // sext(x, source), normalized to the destination.
        إذا (!الوجهة_موقع) { بتات_من := بتات_المصدر; بتات_إلى := بتات_الوجهة; }
        وإلا إذا (بتات_الوجهة >= بتات_المصدر) { بتات_من := بتات_المصدر; };
    }
    | عملية_تحويل_ذراع_أربعة_وستون.توسيع_صفري -> {
        // zext(x, source), normalized to the destination.
        إذا (!الوجهة_موقع) { النوع := 1; بتات_من := بتات_المصدر; بتات_إلى := بتات_الوجهة; }
        وإلا إذا (بتات_الوجهة > بتات_المصدر) { النوع := 1; بتات_من := بتات_المصدر; };
    }
    | _ -> {
        // Truncation and reinterpretation: x normalized to the destination.
        إذا (!الوجهة_موقع) { النوع := 1; };
    };
    أصدر_تحويلا_صحيحا_آلة(م, النوع, الوجهة, المصدر, بتات_من, بتات_إلى, الوجهة_موقع);
}

// ---- Instructions -----------------------------------------------------------

// Translates one selected instruction; false (with السبب set) when the
// engine has no meaning for it.
عرف ترجم_تعليمة_آلة(
    ب: &متغير برنامج_آلة,
    م: &متغير مترجم_دالة_آلة,
    التعليمة: &تعليمة_إكس_ستة_وثمانون_أربعة_وستون,
    المسير: &سياق_مستهلك_مسير,
    الأنواع: &سجل_أنواع,
    معرفات_الخارجيات: &متغير متجه طبيعي,
    الكومة: &متغير كومة_آلة,
    الذاكرة: &ذاكرة_خام,
    سجل_العلم: ط64
): منطقي {
    دع موضع_المقارنة: ط64 = (*م).آخر_مقارنة;
    (*م).آخر_مقارنة := لا_سجل_آلة();
    طابق *التعليمة مع
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.استلام_معامل_إكس(القيمة) -> {
        إذا ((الطول(القيمة.المواضع) مثل طبيعي) != 1) {
            (*م).السبب := رفض_آلة(«parameter in several ABI positions»);
            أرجع خطأ;
        };
        طابق موضع_واجهة_آلة(&القيمة.المواضع[0]) مع
        | اختياري.موجود(الكلمة) -> { أصدر(م, 46); أصدر(م, سجل_آلة(القيمة.السجل)); أصدر(م, الكلمة); }
        | اختياري.لا_شيء -> { (*م).السبب := رفض_آلة(«parameter position»); أرجع خطأ; };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_سجل_إكس(الوجهة, المصدر) -> {
        أصدر(م, 1); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, سجل_آلة(المصدر));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_إكس(الوجهة, القيمة) -> {
        إذا (!سجل_مرفوع_آلة(م, الوجهة)) {
            أصدر(م, 2); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, عدد_كلمة_آلة(القيمة));
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.نقل_فوري_بتات_إكس(الوجهة, القيمة) -> {
        إذا (!سجل_مرفوع_آلة(م, الوجهة)) {
            أصدر(م, 2); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, القيمة مثل ط64);
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_دالة_إكس(الوجهة, الدالة) -> {
        إذا (!سجل_مرفوع_آلة(م, الوجهة)) {
            أصدر(م, 2); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, قاعدة_مقابض_آلة() + (الدالة.القيمة مثل ط64));
        };
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.عنوان_عام_إكس(الوجهة, العام, _) -> {
        إذا ((العام.القيمة مثل طبيعي) >= (الطول((*ب).العوام) مثل طبيعي) || (*ب).العوام[العام.القيمة] == 0) {
            (*م).السبب := رفض_آلة(«global without storage»);
            أرجع خطأ;
        };
        أصدر(م, 2); أصدر(م, سجل_آلة(الوجهة)); أصدر(م, (*ب).العوام[العام.القيمة]);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.بيئة_إغلاق_إكس(الوجهة) -> {
        أصدر(م, 3); أصدر(م, سجل_آلة(الوجهة));
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.حساب_صحيح_كامل_إكس(العملية, الوجهة, أ, ب_, البتات, بإشارة) -> {
        أصدر_حسابا_آلة(م, حساب_آلة(العملية), الوجهة, أ, ب_, البتات, بإشارة, خطأ);
    }
    | تعليمة_إكس_ستة_وثمانون_أربعة_وستون.تحويل_صحيح_كامل_إكس(العملية, الوجهة, المصدر, من_بتات, إلى_بتات, موقع) -> {
        أصدر_تحويلا_صحيحا_آلة(م, تحويل_آلة(العملية), الوجهة, المصدر, من_بتات, إلى_بتات, موقع);
    }
