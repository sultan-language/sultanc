// raw_memory_access.sn for the C Stage0 (bootstrap/), which has no casts
// between integers and pointers (cmake/modules/Stage1.cmake binds this file in
// that module's place). The Stage1 it builds reads and writes raw memory
// through its aligned words (raw_memory.sn); the accesses below are never
// called.
عام عرف وصول_عنوان_خام_متاح(): منطقي { أرجع خطأ; }
عام عرف اقرأ_عنوان_خام(العنوان: ط64, العدد: ط64): ط64 { أرجع 0; }
عام عرف اكتب_عنوان_خام(العنوان: ط64, العدد: ط64, القيمة: ط64): فراغ { }
