// The machine interpreter's engine: runs the word code of machine_program.sn
// on host memory.
//
// State: the program counter pc (a code word index), the frame fp (the
// raw-memory word index of the current frame's first register), and the
// current function. A frame is its header (رأس_إطار_آلة words before fp:
// return pc, caller frame, aggregate result address, closure environment,
// caller function, result register and position), its registers, then its
// local slots; frames are stacked in one region, so a call allocates
// nothing. Arguments and results pass through the ABI transfer area by
// position (machine_program.sn).
//
// Integer semantics are selection's: a narrow value is held zero-extended,
// checked arithmetic traps on overflow at its width, a shift by the width or
// more traps, division by zero and MIN / -1 trap. Floats use the compiler's
// software floats (operations/float_software.sn), as the checked
// interpreter does, since the compiler's sources stay integer-only.
استورد compiler.interpreter.machine.raw_memory;
استورد compiler.interpreter.machine.machine_heap;
استورد compiler.interpreter.machine.machine_program;
استورد compiler.interpreter.operations.float_software;
استورد compiler.interpreter.execution.host_dynamic;
استورد compiler.interpreter.execution.load_libraries;
استورد compiler.interpreter.execution.host_externs_generated;
استورد compiler.interpreter.runtime_failures;
استورد compiler.msir.identifiers;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.vector_memory_policy;
استورد std.text.from_bytes;
استورد std.io.print;
استورد std.os.allocation;
استورد std.process.exit;
استورد compiler.interpreter.machine.host_threads;
استورد compiler.interpreter.machine.thread_failure;

مرادف جمع_م = بدائي_جمع_ملتف;
مرادف طرح_م = بدائي_طرح_ملتف;
مرادف ضرب_م = بدائي_ضرب_ملتف;
مرادف إزاحة_يسرى_م = بدائي_إزاحة_يسرى_ملتفة;
مرادف نادي_سي_آلة = بدائي_نداء_عنوان_سي;
مرادف ع64_من_بتات_آلة = بدائي_ع64_من_بتات;
مرادف بتات_ع64_آلة = بدائي_بتات_ع64;

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    // Linux and Android: the program's kernel calls are the host's.
    عرف نواة_آلة_متاحة(): منطقي { أرجع صواب; }
    // A thread's exit (not exit_group): 60 on x86-64, 93 on AArch64.
    عرف رقم_خروج_خيط_آلة(): ط64 {
        إذا (الهدف_معمارية_إكس_خام()) { أرجع 60; };
        أرجع 93;
    }
    عرف نادي_نواة_آلة(ح: &متغير حالة_آلة, الرقم: ط64, و1: ط64, و2: ط64, و3: ط64, و4: ط64, و5: ط64, و6: ط64): ط64 {
        دع الناتج: متغير ط64 = 0;
        غير_آمن { الناتج := بدائي_نداء_نواة_خام(الرقم, و1, و2, و3, و4, و5, و6); }
        أرجع الناتج;
    }
}
إذا (!((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))) {
    عرف نواة_آلة_متاحة(): منطقي { أرجع خطأ; }
    عرف رقم_خروج_خيط_آلة(): ط64 { أرجع ~(0 مثل ط64); }
    عرف نادي_نواة_آلة(ح: &متغير حالة_آلة, الرقم: ط64, و1: ط64, و2: ط64, و3: ط64, و4: ط64, و5: ط64, و6: ط64): ط64 {
        أرجع 0;
    }
}

عام نوع حالة_آلة = {
    الذاكرة: ذاكرة_خام,
    الكومة: كومة_آلة,
    // Raw-memory word indices: the frame region and the ABI area.
    بداية_المكدس: ط64,
    نهاية_المكدس: ط64,
    الواجهة: ط64,
    المحمل: محمل_ديناميكي_مضيف,
    // Byte buffers the host's raw kernel call takes for its unused slots.
    ب1: متجه ط8, ب2: متجه ط8, ب3: متجه ط8, ب4: متجه ط8, ب5: متجه ط8, ب6: متجه ط8,
    // Frame regions of std.async tasks, by the first stack pointer std gave
    // the task (the same stack base gives the same pointer, so a pooled
    // stack reuses its region).
    مفاتيح_مناطق_المهام: متجه ط64,
    مناطق_المهام: متجه ط64,
    // This thread's allocation counters (allocations, frees, reallocations,
    // requested bytes), as std's per-thread ones.
    العدادات: متجه ط64,
    // An engine of a program thread (not the main one): its thread-exit
    // kernel call ends the engine (شغل_خيط_بفهرس_آلة then releases it).
    خيط: منطقي,
    // Where a run stopped: the code position and the failure.
    موضع_الفشل: ط64,
    الفشل: اختياري فشل_تفسير_مسير
};

عام نوع نتيجة_آلة =
    | عادت بنوع ط64
    | فشلت بنوع فشل_تفسير_مسير
;

عام عرف حالة_آلة_جديدة(الذاكرة: ذاكرة_خام, الكومة: كومة_آلة): حالة_آلة {
    دع الحالة: حالة_آلة = {
        الذاكرة: الذاكرة, الكومة: الكومة, بداية_المكدس: 0, نهاية_المكدس: 0, الواجهة: 0,
        المحمل: محمل_ديناميكي_مضيف_جديد(),
        ب1: [0], ب2: [0], ب3: [0], ب4: [0], ب5: [0], ب6: [0],
        مفاتيح_مناطق_المهام: [], مناطق_المهام: [], العدادات: [0, 0, 0, 0], خيط: خطأ,
        موضع_الفشل: 0, الفشل: اختياري.لا_شيء()
    };
    أرجع الحالة;
}

// ---- Allocation counters ------------------------------------------------------
//
// The program's storage calls (std's providers, vector growth, boxes) are
// counted per thread and for the process, as std's allocator counts them;
// a call to one of std's counter functions answers these (op 57).
// النوع: 0 allocation, 1 free, 2 reallocation.
عرف عد_تخزين_آلة(ح: &متغير حالة_آلة, النوع: ط64, البايتات: ط64): فراغ {
    دع ف: طبيعي = النوع مثل طبيعي;
    (*ح).العدادات[ف] := (*ح).العدادات[ف] + 1;
    أضف_لعداد_كومة_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, 5 + النوع, 1);
    إذا (النوع != 1) {
        (*ح).العدادات[3] := (*ح).العدادات[3] + البايتات;
        أضف_لعداد_كومة_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, 8, البايتات);
    };
}

// The growth of a vector's storage: an allocation when it had none.
عرف عد_نمو_آلة(ح: &متغير حالة_آلة, البيانات: ط64, البايتات: ط64): فراغ {
    إذا (البيانات == 0) { عد_تخزين_آلة(ح, 0, البايتات); } وإلا { عد_تخزين_آلة(ح, 2, البايتات); };
}

// Counter النوع of std's (0..3 the process's, 4..7 the calling thread's).
عرف عداد_آلة(ح: &متغير حالة_آلة, النوع: ط64): ط64 {
    إذا (النوع < 4) { أرجع عداد_كومة_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, 5 + النوع); };
    أرجع (*ح).العدادات[(النوع - 4) مثل طبيعي];
}

// ---- std.async tasks ----------------------------------------------------------

عرف علامة_سياق_آلة(): ط64 { أرجع 0x5458544353414D53; }
عرف كلمات_منطقة_مهمة_آلة(): ط64 { أرجع 262144; }

// The frame region (its first word, 16-byte aligned past a frame header) of
// the task whose first stack pointer is المفتاح; 0 without memory.
عرف منطقة_مهمة_آلة(ح: &متغير حالة_آلة, المفتاح: ط64): ط64 {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*ح).مفاتيح_مناطق_المهام) مثل طبيعي)) {
        إذا ((*ح).مفاتيح_مناطق_المهام[ف] == المفتاح) { أرجع (*ح).مناطق_المهام[ف]; };
        ف := ف + 1;
    }
    دع العنوان: ط64 = منطقة_مضيف_آلة(كلمات_منطقة_مهمة_آلة() * 8 + 64);
    إذا (العنوان == 0) { أرجع 0; };
    دع بداية: متغير ط64 = العنوان + 16 - (العنوان & 15);
    إذا (((بداية + رأس_إطار_آلة() * 8) & 15) != 0) { بداية := بداية + 8; };
    دع الكلمة: ط64 = فهرس_كلمة_خام(&(*ح).الذاكرة, بداية);
    ألحق((*ح).مفاتيح_مناطق_المهام, المفتاح);
    ألحق((*ح).مناطق_المهام, الكلمة);
    أرجع الكلمة;
}

// ---- Integer helpers ----------------------------------------------------------

عرف قناع_آلة(البتات: ط64): ط64 {
    إذا (البتات >= 64) { أرجع ~(0 مثل ط64); };
    أرجع ((1 مثل ط64) << البتات) - 1;
}

// The two's-complement value of the low البتات bits, as 64 bits.
عرف وسع_بإشارة_آلة(القيمة: ط64, البتات: ط64): ط64 {
    إذا (البتات >= 64) { أرجع القيمة; };
    دع م: ط64 = (1 مثل ط64) << (البتات - 1);
    دع س: ط64 = القيمة & قناع_آلة(البتات);
    أرجع طرح_م(س ^ م, م);
}

عرف إزاحة_حسابية_آلة(القيمة: ط64, العدد: ط64): ط64 {
    إذا ((القيمة >> 63) != 0) { أرجع ~((~القيمة) >> العدد); };
    أرجع القيمة >> العدد;
}

عرف أصغر_بإشارة_آلة(أ: ط64, ب: ط64): منطقي {
    دع ب63: ط64 = (1 مثل ط64) << 63;
    أرجع (أ ^ ب63) < (ب ^ ب63);
}

عرف شرط_محقق_آلة(الشرط: ط64, أ: ط64, ب: ط64): منطقي {
    طابق الشرط مثل ط32 مع
    | 0 -> { أرجع أ == ب; }
    | 1 -> { أرجع أ != ب; }
    | 2 -> { أرجع أصغر_بإشارة_آلة(أ, ب); }
    | 3 -> { أرجع !أصغر_بإشارة_آلة(ب, أ); }
    | 4 -> { أرجع أصغر_بإشارة_آلة(ب, أ); }
    | 5 -> { أرجع !أصغر_بإشارة_آلة(أ, ب); }
    | 6 -> { أرجع أ < ب; }
    | 7 -> { أرجع أ <= ب; }
    | 8 -> { أرجع أ > ب; }
    | _ -> { أرجع أ >= ب; };
}

// An integer comparison at البتات bits (selection's مقارنة_إلى_منطق).
عرف قارن_آلة(الشرط: ط64, أ: ط64, ب: ط64, البتات: ط64): منطقي {
    إذا (البتات >= 64) { أرجع شرط_محقق_آلة(الشرط, أ, ب); };
    إذا (الشرط >= 2 && الشرط <= 5) {
        أرجع شرط_محقق_آلة(الشرط, وسع_بإشارة_آلة(أ, البتات), وسع_بإشارة_آلة(ب, البتات));
    };
    دع م: ط64 = قناع_آلة(البتات);
    أرجع شرط_محقق_آلة(الشرط, أ & م, ب & م);
}

// Signed division of 64-bit patterns (neither MIN / -1 nor / 0).
عرف قسمة_بإشارة_آلة(أ: ط64, ب: ط64, باقي: منطقي): ط64 {
    دع سالب_أ: منطقي = (أ >> 63) != 0;
    دع سالب_ب: منطقي = (ب >> 63) != 0;
    دع مطلق_أ: متغير ط64 = أ;
    إذا (سالب_أ) { مطلق_أ := طرح_م(0 مثل ط64, أ); };
    دع مطلق_ب: متغير ط64 = ب;
    إذا (سالب_ب) { مطلق_ب := طرح_م(0 مثل ط64, ب); };
    إذا (باقي) {
        دع ب_: ط64 = مطلق_أ % مطلق_ب;
        إذا (سالب_أ) { أرجع طرح_م(0 مثل ط64, ب_); };
        أرجع ب_;
    };
    دع ق: ط64 = مطلق_أ / مطلق_ب;
    إذا (سالب_أ != سالب_ب) { أرجع طرح_م(0 مثل ط64, ق); };
    أرجع ق;
}

// One integer operation at البتات bits; لا_شيء when it traps.
عرف احسب_صحيح_آلة(العملية: ط64, أ: ط64, ب: ط64, البتات: ط64, بإشارة: منطقي): اختياري ط64 {
    دع م: ط64 = قناع_آلة(البتات);
    دع ط_أ: ط64 = أ & م;
    دع ط_ب: ط64 = ب & م;
    دع س_أ: ط64 = وسع_بإشارة_آلة(ط_أ, البتات);
    دع س_ب: ط64 = وسع_بإشارة_آلة(ط_ب, البتات);
    طابق العملية مثل ط32 مع
    | 0 -> {
        إذا (بإشارة) {
            دع ن: ط64 = جمع_م(س_أ, س_ب);
            إذا (البتات < 64) {
                إذا (وسع_بإشارة_آلة(ن, البتات) != ن) { أرجع اختياري.لا_شيء(); };
            } وإلا إذا ((((س_أ ^ ن) & (س_ب ^ ن)) >> 63) != 0) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(ن & م);
        };
        دع ن: ط64 = جمع_م(ط_أ, ط_ب);
        إذا (البتات < 64) {
            إذا (ن > م) { أرجع اختياري.لا_شيء(); };
        } وإلا إذا (ن < ط_أ) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(ن);
    }
    | 1 -> {
        إذا (بإشارة) {
            دع ن: ط64 = طرح_م(س_أ, س_ب);
            إذا (البتات < 64) {
                إذا (وسع_بإشارة_آلة(ن, البتات) != ن) { أرجع اختياري.لا_شيء(); };
            } وإلا إذا ((((س_أ ^ س_ب) & (س_أ ^ ن)) >> 63) != 0) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(ن & م);
        };
        إذا (ط_أ < ط_ب) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(ط_أ - ط_ب);
    }
    | 2 -> {
        إذا (بإشارة) {
            إذا (البتات <= 32) {
                دع ن: ط64 = ضرب_م(س_أ, س_ب);
                إذا (وسع_بإشارة_آلة(ن, البتات) != ن) { أرجع اختياري.لا_شيء(); };
                أرجع اختياري.موجود(ن & م);
            };
            إذا (س_أ == 0 || س_ب == 0) { أرجع اختياري.موجود(0); };
            دع الأدنى: ط64 = (1 مثل ط64) << 63;
            دع سالب_واحد: ط64 = ~(0 مثل ط64);
            إذا ((س_أ == سالب_واحد && س_ب == الأدنى) || (س_ب == سالب_واحد && س_أ == الأدنى)) {
                أرجع اختياري.لا_شيء();
            };
            دع ن: ط64 = ضرب_م(س_أ, س_ب);
            إذا (س_أ == سالب_واحد) { أرجع اختياري.موجود(ن); };
            إذا (قسمة_بإشارة_آلة(ن, س_أ, خطأ) != س_ب) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(ن);
        };
        إذا (البتات <= 32) {
            دع ن: ط64 = ط_أ * ط_ب;
            إذا (ن > م) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(ن);
        };
        دع ن: ط64 = ضرب_م(ط_أ, ط_ب);
        إذا (ط_أ != 0 && ن / ط_أ != ط_ب) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(ن);
    }
    | 3 -> {
        إذا (ط_ب == 0) { أرجع اختياري.لا_شيء(); };
        إذا (س_ب == ~(0 مثل ط64) && س_أ == وسع_بإشارة_آلة((1 مثل ط64) << (البتات - 1), البتات)) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(قسمة_بإشارة_آلة(س_أ, س_ب, خطأ) & م);
    }
    | 4 -> {
        إذا (ط_ب == 0) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(ط_أ / ط_ب);
    }
    | 5 -> {
        إذا (ط_ب == 0) { أرجع اختياري.لا_شيء(); };
        إذا (س_ب == ~(0 مثل ط64) && س_أ == وسع_بإشارة_آلة((1 مثل ط64) << (البتات - 1), البتات)) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(قسمة_بإشارة_آلة(س_أ, س_ب, صواب) & م);
    }
    | 6 -> {
        إذا (ط_ب == 0) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(ط_أ % ط_ب);
    }
    | 7 -> { أرجع اختياري.موجود(ط_أ | ط_ب); }
    | 8 -> { أرجع اختياري.موجود(ط_أ ^ ط_ب); }
    | 9 -> { أرجع اختياري.موجود(ط_أ & ط_ب); }
    | 10 -> {
        إذا (ط_ب >= البتات) { أرجع اختياري.لا_شيء(); };
        دع ن: ط64 = إزاحة_يسرى_م(ط_أ, ط_ب) & م;
        إذا (بإشارة) {
            إذا (إزاحة_حسابية_آلة(وسع_بإشارة_آلة(ن, البتات), ط_ب) != س_أ) { أرجع اختياري.لا_شيء(); };
        } وإلا إذا ((ن >> ط_ب) != ط_أ) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(ن);
    }
    | 11 -> {
        إذا (ط_ب >= البتات) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(ط_أ >> ط_ب);
    }
    | 12 -> {
        إذا (ط_ب >= البتات) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(إزاحة_حسابية_آلة(س_أ, ط_ب) & م);
    }
    | 13 -> { أرجع اختياري.موجود(جمع_م(ط_أ, ط_ب) & م); }
    | 14 -> { أرجع اختياري.موجود(طرح_م(ط_أ, ط_ب) & م); }
    | 15 -> { أرجع اختياري.موجود(ضرب_م(ط_أ, ط_ب) & م); }
    | _ -> {
        إذا (ط_ب >= البتات) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(إزاحة_يسرى_م(ط_أ, ط_ب) & م);
    };
}

عرف حول_صحيح_آلة(العملية: ط64, القيمة: ط64, من_بتات: ط64, إلى_بتات: ط64): ط64 {
    إذا (العملية == 0) { أرجع وسع_بإشارة_آلة(القيمة, من_بتات) & قناع_آلة(إلى_بتات); };
    إذا (العملية == 1) { أرجع (القيمة & قناع_آلة(من_بتات)) & قناع_آلة(إلى_بتات); };
    أرجع القيمة & قناع_آلة(إلى_بتات);
}

// ---- Floats -------------------------------------------------------------------

عرف احسب_عشري_آلة(العملية: ط64, أ: ط64, ب: ط64, البتات: ط64): ط64 {
    دع الوصف: وصف_عائم_برمجي = وصف_عائم_برمجي_من(البتات مثل طبيعي);
    دع ط_أ: طبيعي = (أ & قناع_آلة(البتات)) مثل طبيعي;
    دع ط_ب: طبيعي = (ب & قناع_آلة(البتات)) مثل طبيعي;
    دع ن: متغير طبيعي = 0;
    طابق العملية مثل ط32 مع
    | 0 -> { ن := اجمع_عائم_برمجي(ط_أ, ط_ب, خطأ, الوصف); }
    | 1 -> { ن := اجمع_عائم_برمجي(ط_أ, ط_ب, صواب, الوصف); }
    | 2 -> { ن := اضرب_عائم_برمجي(ط_أ, ط_ب, الوصف); }
    | 3 -> { ن := اقسم_عائم_برمجي(ط_أ, ط_ب, الوصف); }
    | 4 -> { ن := جذر_عائم_برمجي(ط_أ, الوصف); }
    | 5 -> { ن := قيمة_مطلقة_عائمة_برمجية(ط_أ, الوصف); }
    | 6 -> { ن := نسخ_إشارة_عائمة_برمجي(ط_أ, ط_ب, الوصف); }
    | 7 -> { ن := أدنى_أقصى_عائم_برمجي(ط_أ, ط_ب, خطأ, الوصف); }
    | 8 -> { ن := أدنى_أقصى_عائم_برمجي(ط_أ, ط_ب, صواب, الوصف); }
    // Roundings to an integral value: trunc, floor, ceil, to even.
    | 9 -> { ن := قرب_إلى_صحيح_عائم_برمجي(ط_أ, 0, الوصف); }
    | 10 -> { ن := قرب_إلى_صحيح_عائم_برمجي(ط_أ, 1, الوصف); }
    | 11 -> { ن := قرب_إلى_صحيح_عائم_برمجي(ط_أ, 2, الوصف); }
    | _ -> { ن := قرب_إلى_صحيح_عائم_برمجي(ط_أ, 3, الوصف); };
    أرجع (ن مثل ط64) & قناع_آلة(البتات);
}

عرف حول_عشري_آلة(العملية: ط64, القيمة: ط64, من_بتات: ط64, إلى_بتات: ط64): ط64 {
    طابق العملية مثل ط32 مع
    | 0 -> {
        دع ن: طبيعي = عائم_إلى_صحيح_برمجي((القيمة & قناع_آلة(من_بتات)) مثل طبيعي, وصف_عائم_برمجي_من(من_بتات مثل طبيعي), إلى_بتات مثل طبيعي, صواب);
        أرجع (ن مثل ط64) & قناع_آلة(إلى_بتات);
    }
    | 1 -> {
        دع ن: طبيعي = عائم_إلى_صحيح_برمجي((القيمة & قناع_آلة(من_بتات)) مثل طبيعي, وصف_عائم_برمجي_من(من_بتات مثل طبيعي), إلى_بتات مثل طبيعي, خطأ);
        أرجع (ن مثل ط64) & قناع_آلة(إلى_بتات);
    }
    | 2 -> {
        دع ن: طبيعي = صحيح_إلى_عائم_برمجي((القيمة & قناع_آلة(من_بتات)) مثل طبيعي, من_بتات مثل طبيعي, صواب, وصف_عائم_برمجي_من(إلى_بتات مثل طبيعي));
        أرجع ن مثل ط64;
    }
    | 3 -> {
        دع ن: طبيعي = صحيح_إلى_عائم_برمجي((القيمة & قناع_آلة(من_بتات)) مثل طبيعي, من_بتات مثل طبيعي, خطأ, وصف_عائم_برمجي_من(إلى_بتات مثل طبيعي));
        أرجع ن مثل ط64;
    }
    | _ -> {
        دع ن: طبيعي = عائم_إلى_عائم_برمجي(
            (القيمة & قناع_آلة(من_بتات)) مثل طبيعي, وصف_عائم_برمجي_من(من_بتات مثل طبيعي), وصف_عائم_برمجي_من(إلى_بتات مثل طبيعي)
        );
        أرجع ن مثل ط64;
    };
}

// ---- Memory helpers -------------------------------------------------------------

عرف اقرأ_آلة(ح: &حالة_آلة, العنوان: ط64, الحجم: ط64): ط64 {
    إذا (الحجم == 8 && (العنوان & 7) == 0) { أرجع اقرأ_كلمة_محاذاة_خام(&(*ح).الذاكرة, العنوان); };
    أرجع اقرأ_خام(&(*ح).الذاكرة, العنوان, الحجم);
}

عرف اكتب_آلة(ح: &حالة_آلة, العنوان: ط64, الحجم: ط64, القيمة: ط64): فراغ {
    إذا (الحجم == 8 && (العنوان & 7) == 0) { اكتب_كلمة_محاذاة_خام(&(*ح).الذاكرة, العنوان, القيمة); أرجع; };
    اكتب_خام(&(*ح).الذاكرة, العنوان, الحجم, القيمة);
}

// Vector append and reserve (selection's إلحاق_متجه_إكس); false on a trap.
عرف ألحق_متجه_آلة(
    ح: &متغير حالة_آلة, المتجه: ط64, العنصر: ط64,
    إ_البيانات: ط64, إ_الطول: ط64, إ_السعة: ط64, حجم_العنصر: ط64,
    تجميعي: منطقي, السعة_الدنيا: ط64, عامل_النمو: ط64, حجز: منطقي
): منطقي {
    دع البيانات: ط64 = اقرأ_آلة(ح, جمع_م(المتجه, إ_البيانات), 8);
    دع الطول: ط64 = اقرأ_آلة(ح, جمع_م(المتجه, إ_الطول), 8);
    دع السعة: ط64 = اقرأ_آلة(ح, جمع_م(المتجه, إ_السعة), 8);
    إذا (حجز) {
        دع الكل: ط64 = جمع_م(الطول, العنصر);
        إذا (الكل < الطول) { أرجع خطأ; };
        إذا (الكل <= السعة) { أرجع صواب; };
        إذا (حجم_العنصر != 0) {
            إذا (الكل > (~(0 مثل ط64)) / حجم_العنصر) { أرجع خطأ; };
            دع الجديد: ط64 = أعد_تخصيص_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, البيانات, الكل * حجم_العنصر);
            إذا (الجديد == 0) { أرجع خطأ; };
            عد_نمو_آلة(ح, البيانات, الكل * حجم_العنصر);
            اكتب_آلة(ح, جمع_م(المتجه, إ_البيانات), 8, الجديد);
        };
        اكتب_آلة(ح, جمع_م(المتجه, إ_السعة), 8, الكل);
        أرجع صواب;
    };
    دع بيانات: متغير ط64 = البيانات;
    إذا (الطول >= السعة && حجم_العنصر != 0) {
        دع النمو: متغير ط64 = عامل_النمو;
        إذا (النمو < 2) { النمو := 2; };
        دع الدنيا: متغير ط64 = السعة_الدنيا;
        إذا (الدنيا < 1) { الدنيا := 1; };
        إذا (السعة > (~(0 مثل ط64)) / النمو) { أرجع خطأ; };
        دع الجديدة: متغير ط64 = السعة * النمو;
        إذا (الجديدة < الدنيا) { الجديدة := الدنيا; };
        إذا (الجديدة > (~(0 مثل ط64)) / حجم_العنصر) { أرجع خطأ; };
        دع الجديد: ط64 = أعد_تخصيص_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, البيانات, الجديدة * حجم_العنصر);
        إذا (الجديد == 0) { أرجع خطأ; };
        عد_نمو_آلة(ح, البيانات, الجديدة * حجم_العنصر);
        بيانات := الجديد;
        اكتب_آلة(ح, جمع_م(المتجه, إ_البيانات), 8, الجديد);
        اكتب_آلة(ح, جمع_م(المتجه, إ_السعة), 8, الجديدة);
    };
    اكتب_آلة(ح, جمع_م(المتجه, إ_الطول), 8, جمع_م(الطول, 1));
    إذا (حجم_العنصر != 0) {
        دع الوجهة: ط64 = جمع_م(بيانات, ضرب_م(الطول, حجم_العنصر));
        إذا (تجميعي) {
            انسخ_خام(&(*ح).الذاكرة, الوجهة, العنصر, حجم_العنصر);
        } وإلا {
            اكتب_آلة(ح, الوجهة, حجم_العنصر, العنصر);
        };
    };
    أرجع صواب;
}

// Vector extend from [البداية, البداية + العدد) of another (or the same)
// vector; a buffer too small for length + count grows to the growth policy's
// amortized capacity (سعة_نمو_المتجه), as the compiled instruction does.
عرف مد_متجه_آلة(
    ح: &متغير حالة_آلة, المتجه: ط64, المصدر: ط64, البداية: ط64, العدد: ط64,
    إ_البيانات: ط64, إ_الطول: ط64, إ_السعة: ط64, حجم_العنصر: ط64,
    السعة_الدنيا: ط64, عامل_النمو: ط64
): منطقي {
    دع طول_المصدر: ط64 = اقرأ_آلة(ح, جمع_م(المصدر, إ_الطول), 8);
    دع النهاية: ط64 = جمع_م(البداية, العدد);
    إذا (النهاية < البداية || النهاية > طول_المصدر) { أرجع خطأ; };
    دع الطول: ط64 = اقرأ_آلة(ح, جمع_م(المتجه, إ_الطول), 8);
    دع السعة: ط64 = اقرأ_آلة(ح, جمع_م(المتجه, إ_السعة), 8);
    دع الكل: ط64 = جمع_م(الطول, العدد);
    إذا (الكل < الطول) { أرجع خطأ; };
    إذا (الكل > السعة && حجم_العنصر != 0) {
        إذا (عامل_النمو != 0 && السعة > (~(0 مثل ط64)) / عامل_النمو) { أرجع خطأ; };
        دع السياسة: سياسة_نمو_متجه = { السعة_الدنيا: السعة_الدنيا مثل طبيعي, عامل_النمو: عامل_النمو مثل طبيعي };
        دع الجديدة: ط64 = سعة_نمو_المتجه(&السياسة, السعة مثل طبيعي, الكل مثل طبيعي) مثل ط64;
        إذا (الجديدة > (~(0 مثل ط64)) / حجم_العنصر) { أرجع خطأ; };
        دع البيانات: ط64 = اقرأ_آلة(ح, جمع_م(المتجه, إ_البيانات), 8);
        دع الجديد: ط64 = أعد_تخصيص_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, البيانات, الجديدة * حجم_العنصر);
        إذا (الجديد == 0) { أرجع خطأ; };
        عد_نمو_آلة(ح, البيانات, الجديدة * حجم_العنصر);
        اكتب_آلة(ح, جمع_م(المتجه, إ_البيانات), 8, الجديد);
        اكتب_آلة(ح, جمع_م(المتجه, إ_السعة), 8, الجديدة);
    };
    إذا (حجم_العنصر != 0 && العدد != 0) {
        دع البيانات: ط64 = اقرأ_آلة(ح, جمع_م(المتجه, إ_البيانات), 8);
        دع بيانات_المصدر: ط64 = اقرأ_آلة(ح, جمع_م(المصدر, إ_البيانات), 8);
        انسخ_خام(
            &(*ح).الذاكرة, جمع_م(البيانات, ضرب_م(الطول, حجم_العنصر)),
            جمع_م(بيانات_المصدر, ضرب_م(البداية, حجم_العنصر)), ضرب_م(العدد, حجم_العنصر)
        );
    };
    اكتب_آلة(ح, جمع_م(المتجه, إ_الطول), 8, الكل);
    أرجع صواب;
}

// ---- Calls out of the program -------------------------------------------------

// Resolves an extern: 1 for the compiler's own table, else its address; 0
// when it cannot be found.
// The address of an extern: the generated table (1), the library its
// declaration names, the -l libraries in order (load_libraries.sn), the
// process's global scope, then the platform C libraries; 0 for none.
عرف حل_خارجية_آلة(ح: &متغير حالة_آلة, الخارجية: &خارجية_آلة, مقابض_المكتبات: &متجه ط64): ط64 {
    إذا (دالة_خارجية_مضيف_معروفة(&(*الخارجية).الاسم)) { أرجع 1; };
    إذا (!هيئ_محمل_ديناميكي_مضيف(&متغير (*ح).المحمل)) { أرجع 0; };
    طابق (*الخارجية).المكتبة مع
    | اختياري.موجود(المكتبة) -> {
        دع المقبض: ط64 = افتح_مكتبة_مضيف(&متغير (*ح).المحمل, &المكتبة);
        إذا (المقبض != 0) {
            دع العنوان: ط64 = رمز_مكتبة_مضيف(&متغير (*ح).المحمل, المقبض, &(*الخارجية).الاسم);
            إذا (العنوان != 0) { أرجع العنوان; };
        };
    }
    | اختياري.لا_شيء -> { };
    دع من_المكتبات: ط64 = رمز_في_مكتبات_التحميل_مفسر(&متغير (*ح).المحمل, مقابض_المكتبات, &(*الخارجية).الاسم);
    إذا (من_المكتبات != 0) { أرجع من_المكتبات; };
    دع العام: ط64 = رمز_عام_مضيف(&متغير (*ح).المحمل, &(*الخارجية).الاسم);
    إذا (العام != 0) { أرجع العام; };
    دع المكتبات: متجه نص = مكتبات_سي_افتراضية_مضيف();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المكتبات) مثل طبيعي)) {
        دع الاسم: متجه ط8 = بايتات_من_نص(انسخ_نص(&المكتبات[ف]));
        دع المقبض: ط64 = افتح_مكتبة_مضيف(&متغير (*ح).المحمل, &الاسم);
        إذا (المقبض != 0) {
            دع العنوان: ط64 = رمز_مكتبة_مضيف(&متغير (*ح).المحمل, المقبض, &(*الخارجية).الاسم);
            إذا (العنوان != 0) { أرجع العنوان; };
        };
        ف := ف + 1;
    }
    أرجع 0;
}

// ---- Atomic operations ----------------------------------------------------------

// An atomic update of the الحجم-byte value at العنوان, which lies within one
// aligned word: a compare-and-swap loop on that word. الرمز: 0 exchange,
// 1 add, 2 and, 3 or, 4 xor, 5 store, 6 compare-and-swap (with المتوقع).
// Answers the previous value.
عرف حدث_ذريا_آلة(ح: &حالة_آلة, العنوان: ط64, الحجم: ط64, الرمز: ط64, القيمة: ط64, المتوقع: ط64): ط64 {
    دع الإزاحة_بايت: ط64 = العنوان & 7;
    دع القناع: ط64 = قناع_آلة(الحجم * 8);
    إذا (الإزاحة_بايت + الحجم > 8) {
        // Straddles two words: not atomic on any target; done plainly.
        دع القديم_: ط64 = اقرأ_آلة(ح, العنوان, الحجم);
        دع ن_: ط64 = ناتج_ذري_آلة(الرمز, القديم_, القيمة, المتوقع & القناع) & القناع;
        اكتب_آلة(ح, العنوان, الحجم, ن_);
        أرجع القديم_;
    };
    دع الإزاحة: ط64 = الإزاحة_بايت * 8;
    دع م: &ذاكرة_خام = &(*ح).الذاكرة;
    دع ف: ط64 = فهرس_كلمة_خام(م, العنوان - الإزاحة_بايت);
    دع المكان: ط64 = القناع << الإزاحة;
    طالما (صواب) {
        دع الكلمة: ط64 = احمل_كلمة_ذريا_خام(م, ف);
        دع القديم: ط64 = (الكلمة >> الإزاحة) & القناع;
        دع ن: ط64 = ناتج_ذري_آلة(الرمز, القديم, القيمة, المتوقع & القناع) & القناع;
        إذا (ن == القديم && الرمز == 6) { أرجع القديم; };
        دع الجديدة: ط64 = (الكلمة & ~المكان) | (ن << الإزاحة);
        إذا (قارن_وبدل_كلمة_خام(م, ف, الكلمة, الجديدة) == الكلمة) { أرجع القديم; };
    }
    أرجع 0;
}

عرف ناتج_ذري_آلة(الرمز: ط64, القديم: ط64, القيمة: ط64, المتوقع: ط64): ط64 {
    طابق الرمز مثل ط32 مع
    | 1 -> { أرجع جمع_م(القديم, القيمة); }
    | 2 -> { أرجع القديم & القيمة; }
    | 3 -> { أرجع القديم | القيمة; }
    | 4 -> { أرجع القديم ^ القيمة; }
    | 6 -> {
        إذا (القديم == المتوقع) { أرجع القيمة; };
        أرجع القديم;
    }
    | _ -> { أرجع القيمة; };
}

// ---- The run loop ---------------------------------------------------------------

عرف فشل_فخ_آلة(ب: &برنامج_آلة, الموضع: ط64): فشل_تفسير_مسير {
    // The last block starting at or before الموضع.
    دع المواضع: &متجه ط64 = &(*ب).مواضع_الكتل;
    دع ن: طبيعي = الطول(*المواضع) مثل طبيعي;
    دع أدنى: متغير طبيعي = 0;
    دع أعلى: متغير طبيعي = ن;
    طالما (أدنى + 1 < أعلى) {
        دع وسط: طبيعي = (أدنى + أعلى) / 2;
        إذا ((*المواضع)[وسط] <= الموضع) { أدنى := وسط; } وإلا { أعلى := وسط; };
    }
    إذا (ن == 0) {
        دع بلا: معرف_كتلة_مسير = { الدالة: معرف_دالة_مسير_من(0), القيمة: 0 };
        أرجع فشل_تفسير_مسير.فخ_مسير(معرف_دالة_مسير_من(0), بلا);
    };
    دع الكتلة: معرف_كتلة_مسير = (*ب).كتل_المواضع[أدنى];
    أرجع فشل_تفسير_مسير.فخ_مسير(الكتلة.الدالة, الكتلة);
}

// Whether ن, the wrapped 64-bit product of س and ص, is their signed
// product (selection's checked signed multiply).
عرف ضرب_موقع_سليم_آلة(س: ط64, ص: ط64, ن: ط64): منطقي {
    إذا (س == 0 || ص == 0) { أرجع صواب; };
    دع الأدنى: ط64 = (1 مثل ط64) << 63;
    دع سالب_واحد: ط64 = ~(0 مثل ط64);
    إذا ((س == سالب_واحد && ص == الأدنى) || (ص == سالب_واحد && س == الأدنى)) { أرجع خطأ; };
    إذا (س == سالب_واحد) { أرجع صواب; };
    أرجع قسمة_بإشارة_آلة(ن, س, خطأ) == ص;
}

// The failure of a call whose frame at جديد would pass the frame region.
عرف فشل_عمق_آلة(ح: &حالة_آلة, جديد: ط64): فشل_تفسير_مسير {
    أرجع فشل_تفسير_مسير.وقت_تشغيل(
        خطأ_وقت_تشغيل_مفسر.تجاوز_عمق_النداء((جديد - (*ح).بداية_المكدس) مثل طبيعي)
    );
}

// Runs function الدالة (no arguments) to its return; its integer result is
// the first integer result word.
عام عرف شغل_دالة_آلة(ب: &متغير برنامج_آلة, ح: &متغير حالة_آلة, الدالة: ط64): نتيجة_آلة {
    أرجع شغل_دالة_ببيئة_آلة(ب, ح, الدالة, 0);
}

// The same with a closure environment (a thread's closure).
عرف شغل_دالة_ببيئة_آلة(ب: &متغير برنامج_آلة, ح: &متغير حالة_آلة, الدالة: ط64, البيئة: ط64): نتيجة_آلة {
    دع ق: *متغير ط64 = (*ح).الذاكرة.ق;
    // The code and the function table (start, frame words, translated) are
    // in raw memory (machine_program.sn).
    دع ش: ط64 = (*ب).أساس_الشفرة;
    دع جد: ط64 = (*ب).جدول_الدوال;
    دع عدد_الدوال: ط64 = الطول((*ب).الدوال) مثل ط64;
    دع مترجمة: متغير منطقي = خطأ;
    غير_آمن { مترجمة := الدالة < عدد_الدوال && ق[جد + 4 * الدالة + 2] != 0; }
    إذا (!مترجمة) {
        أرجع نتيجة_آلة.فشلت(فشل_فخ_آلة(ب, 0));
    };
    دع أ: ط64 = (*ح).الذاكرة.أ;
    دع وا: ط64 = (*ح).الواجهة;
    دع لا: ط64 = لا_سجل_آلة();
    دع توقف: ط64 = ~(0 مثل ط64);
    دع الرأس: ط64 = رأس_إطار_آلة();
    دع fp: متغير ط64 = (*ح).بداية_المكدس + الرأس;
    دع الحالية: متغير ط64 = الدالة;
    دع الكلمات: متغير ط64 = 0;
    دع pc: متغير ط64 = 0;
    غير_آمن {
        الكلمات := ق[جد + 4 * الدالة + 1];
        pc := جمع_م(ش, ق[جد + 4 * الدالة]);
    }
    دع نهاية: متغير ط64 = (*ح).نهاية_المكدس;
    دع نهاية_مهمة: ط64 = ~(1 مثل ط64);
    دع فشل_آخر: متغير اختياري فشل_تفسير_مسير = اختياري.لا_شيء();
    غير_آمن {
        ق[fp - 6] := توقف;
        ق[fp - 5] := 0;
        ق[fp - 4] := 0;
        ق[fp - 3] := البيئة;
        ق[fp - 2] := الدالة;
        ق[fp - 1] := لا;
        // pc is the raw-memory word index of the current instruction; code
        // operands hold positions relative to ش. A trap leaves the loop.
        // No arm is a bare break: a case edge carrying the loop's values
        // would cost the switch its jump table.
        طالما (صواب) {
            دع op: ط64 = ق[pc];
            طابق op مثل ط32 مع
            | 1 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])]; pc := جمع_م(pc, 3); }
            | 2 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[جمع_م(pc, 2)]; pc := جمع_م(pc, 3); }
            | 3 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[fp - 3]; pc := جمع_م(pc, 2); }
            | 4 -> {
                // The last word: 0 unsigned, 1 signed, 3 signed with the result
                // sign-extended to 64 bits (machine_program.sn علم_إشارة_آلة).
                دع العلم: ط64 = ق[جمع_م(pc, 6)];
                طابق احسب_صحيح_آلة(ق[جمع_م(pc, 1)], ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(fp, ق[جمع_م(pc, 4)])], ق[جمع_م(pc, 5)], العلم != 0) مع
                | اختياري.موجود(ن) -> {
                    إذا (العلم > 1) { ق[جمع_م(fp, ق[جمع_م(pc, 2)])] := وسع_بإشارة_آلة(ن, ق[جمع_م(pc, 5)]); }
                    وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 2)])] := ن; };
                    pc := جمع_م(pc, 7);
                }
                | اختياري.لا_شيء -> { اخرج_من_حلقة; };
            }
            | 5 -> {
                // 64-bit unsigned checked add.
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ن: ط64 = جمع_م(س, ق[جمع_م(fp, ق[جمع_م(pc, 3)])]);
                إذا (ن < س) { اخرج_من_حلقة; } وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4); };
            }
            | 50 -> {
                // 64-bit unsigned checked subtract.
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ص: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 3)])];
                إذا (س < ص) { اخرج_من_حلقة; } وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := س - ص; pc := جمع_م(pc, 4); };
            }
            | 75 -> {
                // 64-bit signed checked add.
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ص: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 3)])];
                دع ن: ط64 = جمع_م(س, ص);
                إذا ((((س ^ ن) & (ص ^ ن)) >> 63) != 0) { اخرج_من_حلقة; } وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4); };
            }
            | 76 -> {
                // 64-bit signed checked subtract.
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ص: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 3)])];
                دع ن: ط64 = طرح_م(س, ص);
                إذا ((((س ^ ص) & (س ^ ن)) >> 63) != 0) { اخرج_من_حلقة; } وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4); };
            }
            | 73 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := جمع_م(ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(fp, ق[جمع_م(pc, 3)])]); pc := جمع_م(pc, 4); }
            | 74 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := طرح_م(ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(fp, ق[جمع_م(pc, 3)])]); pc := جمع_م(pc, 4); }
            | 67 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])] | ق[جمع_م(fp, ق[جمع_م(pc, 3)])]; pc := جمع_م(pc, 4); }
            | 68 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])] ^ ق[جمع_م(fp, ق[جمع_م(pc, 3)])]; pc := جمع_م(pc, 4); }
            | 69 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])] & ق[جمع_م(fp, ق[جمع_م(pc, 3)])]; pc := جمع_م(pc, 4); }
            | 6 -> {
                ق[جمع_م(fp, ق[جمع_م(pc, 2)])] := حول_صحيح_آلة(ق[جمع_م(pc, 1)], ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 4)], ق[جمع_م(pc, 5)]);
                pc := جمع_م(pc, 7);
            }
            | 7 -> {
                ق[جمع_م(fp, ق[جمع_م(pc, 2)])] := احسب_عشري_آلة(ق[جمع_م(pc, 1)], ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(fp, ق[جمع_م(pc, 4)])], ق[جمع_م(pc, 5)]);
                pc := جمع_م(pc, 6);
            }
            | 8 -> {
                ق[جمع_م(fp, ق[جمع_م(pc, 2)])] := حول_عشري_آلة(ق[جمع_م(pc, 1)], ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 4)], ق[جمع_م(pc, 5)]);
                pc := جمع_م(pc, 6);
            }
            | 9 -> {
                دع البتات: ط64 = ق[جمع_م(pc, 5)];
                دع الوصف: وصف_عائم_برمجي = وصف_عائم_برمجي_من(البتات مثل طبيعي);
                دع ن: منطقي = قارن_عائم_برمجي(
                    (ق[جمع_م(fp, ق[جمع_م(pc, 3)])] & قناع_آلة(البتات)) مثل طبيعي,
                    (ق[جمع_م(fp, ق[جمع_م(pc, 4)])] & قناع_آلة(البتات)) مثل طبيعي,
                    ق[جمع_م(pc, 1)] مثل طبيعي, الوصف
                );
                إذا (ن) { ق[جمع_م(fp, ق[جمع_م(pc, 2)])] := 1; } وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 2)])] := 0; };
                pc := جمع_م(pc, 6);
            }
            | 10 -> {
                دع بإشارة: منطقي = ق[جمع_م(pc, 5)] != 0;
                دع العملية: متغير ط64 = 4;
                إذا (بإشارة) { العملية := 3; };
                إذا (ق[جمع_م(pc, 6)] != 0) { العملية := العملية + 2; };
                طابق احسب_صحيح_آلة(العملية, ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(pc, 3)], ق[جمع_م(pc, 4)], بإشارة) مع
                | اختياري.موجود(ن) -> {
                    // 3: the narrow result sign-extended (as op 4).
                    إذا (ق[جمع_م(pc, 5)] > 1) { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := وسع_بإشارة_آلة(ن, ق[جمع_م(pc, 4)]); }
                    وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; };
                    pc := جمع_م(pc, 7);
                }
                | اختياري.لا_شيء -> { اخرج_من_حلقة; };
            }
            | 11 -> {
                إذا (قارن_آلة(ق[جمع_م(pc, 4)], ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 5)])) {
                    ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := 1;
                } وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := 0; };
                pc := جمع_م(pc, 6);
            }
            | 51 -> {
                // Compare and branch when true.
                إذا (قارن_آلة(ق[جمع_م(pc, 4)], ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 5)])) {
                    ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := 1;
                    pc := جمع_م(ش, ق[جمع_م(pc, 6)]);
                } وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := 0; pc := جمع_م(pc, 7); };
            }
            | 52 -> {
                // Compare and branch when false.
                إذا (قارن_آلة(ق[جمع_م(pc, 4)], ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 5)])) {
                    ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := 1;
                    pc := جمع_م(pc, 7);
                } وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := 0; pc := جمع_م(ش, ق[جمع_م(pc, 6)]); };
            }
            | 49 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] & 0xFF) == 0) { pc := جمع_م(ش, ق[جمع_م(pc, 2)]); } وإلا { pc := جمع_م(pc, 3); };
            }
            | 12 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := جمع_م(ق[جمع_م(fp, ق[جمع_م(pc, 1)])], ق[جمع_م(fp, ق[جمع_م(pc, 2)])]); pc := جمع_م(pc, 3); }
            | 13 -> {
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 1)])];
                دع ص: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ن: ط64 = جمع_م(س, ص);
                إذا (ق[جمع_م(pc, 3)] != 0) {
                    إذا ((((س ^ ن) & (ص ^ ن)) >> 63) != 0) { اخرج_من_حلقة; };
                } وإلا إذا (ن < س) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4);
            }
            | 14 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := طرح_م(ق[جمع_م(fp, ق[جمع_م(pc, 1)])], ق[جمع_م(fp, ق[جمع_م(pc, 2)])]); pc := جمع_م(pc, 3); }
            | 15 -> {
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 1)])];
                دع ص: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ن: ط64 = طرح_م(س, ص);
                إذا (ق[جمع_م(pc, 3)] != 0) {
                    إذا ((((س ^ ص) & (س ^ ن)) >> 63) != 0) { اخرج_من_حلقة; };
                } وإلا إذا (س < ص) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4);
            }
            | 16 -> {
                دع ن: متغير ط64 = ق[جمع_م(pc, 5)];
                إذا (ق[جمع_م(pc, 2)] != لا) { ن := جمع_م(ن, ق[جمع_م(fp, ق[جمع_م(pc, 2)])]); };
                إذا (ق[جمع_م(pc, 3)] != لا) { ن := جمع_م(ن, ضرب_م(ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 4)])); };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن;
                pc := جمع_م(pc, 6);
            }
            | 17 -> {
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := جمع_م(جمع_م(ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ضرب_م(ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 4)])), ق[جمع_م(pc, 5)]);
                pc := جمع_م(pc, 6);
            }
            | 18 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := جمع_م(جمع_م(أ, fp * 8), ق[جمع_م(pc, 2)]); pc := جمع_م(pc, 3); }
            | 19 -> {
                انسخ_خام(&(*ح).الذاكرة, جمع_م(ق[جمع_م(fp, ق[جمع_م(pc, 1)])], ق[جمع_م(pc, 4)]), جمع_م(ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(pc, 5)]), ق[جمع_م(pc, 3)]);
                pc := جمع_م(pc, 6);
            }
            | 20 -> {
                اكتب_آلة(ح, جمع_م(ق[جمع_م(fp, ق[جمع_م(pc, 1)])], ق[جمع_م(pc, 2)]), ق[جمع_م(pc, 4)], ق[جمع_م(pc, 3)]);
                pc := جمع_م(pc, 5);
            }
            | 21 -> {
                إذا (!ألحق_متجه_آلة(
                    ح, ق[جمع_م(fp, ق[جمع_م(pc, 1)])], ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(pc, 3)], ق[جمع_م(pc, 4)], ق[جمع_م(pc, 5)], ق[جمع_م(pc, 6)],
                    ق[جمع_م(pc, 7)] != 0, ق[جمع_م(pc, 8)], ق[جمع_م(pc, 9)], ق[جمع_م(pc, 10)] != 0
                )) { اخرج_من_حلقة; } وإلا { pc := جمع_م(pc, 11); };
            }
            | 22 -> {
                إذا (!مد_متجه_آلة(
                    ح, ق[جمع_م(fp, ق[جمع_م(pc, 1)])], ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(fp, ق[جمع_م(pc, 4)])],
                    ق[جمع_م(pc, 5)], ق[جمع_م(pc, 6)], ق[جمع_م(pc, 7)], ق[جمع_م(pc, 8)],
                    ق[جمع_م(pc, 9)], ق[جمع_م(pc, 10)]
                )) { اخرج_من_حلقة; } وإلا { pc := جمع_م(pc, 11); };
            }
            | 23 -> {
                دع الأساس: ط64 = جمع_م(جمع_م(أ, fp * 8), ق[جمع_م(pc, 1)]);
                اكتب_آلة(ح, جمع_م(الأساس, ق[جمع_م(pc, 4)]), 8, ق[جمع_م(pc, 2)]);
                اكتب_آلة(ح, جمع_م(الأساس, ق[جمع_م(pc, 5)]), 8, ق[جمع_م(pc, 3)]);
                اكتب_آلة(ح, جمع_م(الأساس, ق[جمع_م(pc, 6)]), 8, ق[جمع_م(pc, 3)]);
                pc := جمع_م(pc, 7);
            }
            | 24 -> {
                دع العنوان: ط64 = خصص_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, ق[جمع_م(pc, 2)]);
                إذا (العنوان == 0) { اخرج_من_حلقة; } وإلا {
                    عد_تخزين_آلة(ح, 0, ق[جمع_م(pc, 2)]);
                    ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := العنوان; pc := جمع_م(pc, 3);
                };
            }
            | 25 -> {
                دع ع: متغير ط64 = ق[جمع_م(pc, 5)];
                إذا (ق[جمع_م(pc, 2)] != لا) { ع := جمع_م(ع, ق[جمع_م(fp, ق[جمع_م(pc, 2)])]); };
                إذا (ق[جمع_م(pc, 3)] != لا) { ع := جمع_م(ع, ضرب_م(ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 4)])); };
                دع الحجم: ط64 = ق[جمع_م(pc, 6)];
                دع ن: متغير ط64 = 0;
                إذا (الحجم == 8 && (ع & 7) == 0) {
                    ن := ق[طرح_م(ع, أ) >> 3];
                } وإلا {
                    ن := اقرأ_خام(&(*ح).الذاكرة, ع, الحجم);
                    إذا (ق[جمع_م(pc, 7)] != 0) { ن := وسع_بإشارة_آلة(ن, الحجم * 8); };
                };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن;
                pc := جمع_م(pc, 8);
            }
            | 26 -> {
                دع ع: متغير ط64 = ق[جمع_م(pc, 5)];
                إذا (ق[جمع_م(pc, 2)] != لا) { ع := جمع_م(ع, ق[جمع_م(fp, ق[جمع_م(pc, 2)])]); };
                إذا (ق[جمع_م(pc, 3)] != لا) { ع := جمع_م(ع, ضرب_م(ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 4)])); };
                دع الحجم: ط64 = ق[جمع_م(pc, 6)];
                إذا (الحجم == 8 && (ع & 7) == 0) {
                    ق[طرح_م(ع, أ) >> 3] := ق[جمع_م(fp, ق[جمع_م(pc, 1)])];
                } وإلا {
                    اكتب_خام(&(*ح).الذاكرة, ع, الحجم, ق[جمع_م(fp, ق[جمع_م(pc, 1)])]);
                };
                pc := جمع_م(pc, 7);
            }
            | 27 -> {
                ق[جمع_م(fp, ق[جمع_م(pc, 3)])] := ق[جمع_م(fp, ق[جمع_م(pc, 1)])];
                ق[جمع_م(fp, ق[جمع_م(pc, 3)]) + 1] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                pc := جمع_م(pc, 4);
            }
            | 28 -> {
                دع ق_: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 1)])];
                دع ن: ط64 = ق[جمع_م(pc, 2)];
                دع الأدنى: ط64 = ق[جمع_م(pc, 3)];
                إذا (ق_ >= الأدنى && ق_ - الأدنى < ن) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 5 + (ق_ - الأدنى))]);
                } وإلا {
                    pc := جمع_م(ش, ق[جمع_م(pc, 4)]);
                };
            }
            | 29 -> { pc := جمع_م(ش, ق[جمع_م(pc, 1)]); }
            | 31 -> {
                دع ع: ط64 = ق[جمع_م(pc, 2)];
                إذا (شرط_محقق_آلة(ق[جمع_م(pc, 1)], ق[fp + ع], ق[fp + ع + 1])) { pc := جمع_م(ش, ق[جمع_م(pc, 3)]); } وإلا { pc := جمع_م(pc, 4); };
            }
            | 34 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] & 0xFF) != 0) { pc := جمع_م(ش, ق[جمع_م(pc, 2)]); } وإلا { pc := جمع_م(pc, 3); };
            }
            | 35 -> { فشل_آخر := اختياري.لا_شيء(); اخرج_من_حلقة; }
            | 36 -> {
                // Atomic read-modify-write: (result, address, operand, size).
                دع الرمز_: ط64 = ق[جمع_م(pc, 1)];
                دع رمز_ذري: متغير ط64 = 0;
                إذا (الرمز_ >= 1 && الرمز_ <= 4) { رمز_ذري := الرمز_; };
                ق[جمع_م(fp, ق[جمع_م(pc, 2)])] := حدث_ذريا_آلة(
                    ح, ق[جمع_م(fp, ق[جمع_م(pc, 3)])], ق[جمع_م(pc, 5)], رمز_ذري, ق[جمع_م(fp, ق[جمع_م(pc, 4)])], 0
                );
                pc := جمع_م(pc, 6);
            }
            | 37 -> {
                // Compare-and-swap: (result, address, expected, new, size).
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := حدث_ذريا_آلة(
                    ح, ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(pc, 5)], 6, ق[جمع_م(fp, ق[جمع_م(pc, 4)])], ق[جمع_م(fp, ق[جمع_م(pc, 3)])]
                );
                pc := جمع_م(pc, 6);
            }
            | 38 -> {
                دع تجاهل_ذري: ط64 = حدث_ذريا_آلة(ح, ق[جمع_م(fp, ق[جمع_م(pc, 1)])], ق[جمع_م(pc, 3)], 5, ق[جمع_م(fp, ق[جمع_م(pc, 2)])], 0);
                pc := جمع_م(pc, 4);
            }
            | 39 -> {
                // A call to a function of the program.
                دع المدعوة: ط64 = ق[جمع_م(pc, 1)];
                دع الوصف: ط64 = جد + 4 * المدعوة;
                إذا (ق[الوصف + 2] == 0) { اخرج_من_حلقة; } وإلا {
                    دع جديد: ط64 = fp + الكلمات + الرأس;
                    إذا (جديد + ق[الوصف + 1] >= نهاية) {
                        فشل_آخر := اختياري.موجود(فشل_تفسير_مسير.وقت_تشغيل(
                            خطأ_وقت_تشغيل_مفسر.تجاوز_عمق_النداء((جديد - (*ح).بداية_المكدس) مثل طبيعي)
                        ));
                        اخرج_من_حلقة;
                    } وإلا {
                        دع بعد: ط64 = مرر_حجج_آلة(ح, ق, fp, وا, جمع_م(pc, 2));
                        ق[جديد - 6] := بعد + 4;
                        ق[جديد - 5] := fp;
                        ق[جديد - 3] := 0;
                        ق[جديد - 2] := الحالية;
                        هيئ_ناتج_نداء_آلة(ق, fp, وا, جديد, بعد);
                        fp := جديد;
                        الحالية := المدعوة;
                        الكلمات := ق[الوصف + 1];
                        pc := جمع_م(ش, ق[الوصف]);
                    };
                };
            }
            | 42 -> {
                // A call through a function value: the closure environment's
                // first word is the function's handle.
                دع البيئة: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 1)])];
                دع المقبض: ط64 = اقرأ_آلة(ح, البيئة, 8);
                دع المدعوة: ط64 = طرح_م(المقبض, قاعدة_مقابض_آلة());
                دع الوصف: ط64 = جد + 4 * المدعوة;
                إذا (المدعوة >= عدد_الدوال || ق[الوصف + 2] == 0) { اخرج_من_حلقة; } وإلا {
                    دع جديد: ط64 = fp + الكلمات + الرأس;
                    إذا (جديد + ق[الوصف + 1] >= نهاية) {
                        فشل_آخر := اختياري.موجود(فشل_تفسير_مسير.وقت_تشغيل(
                            خطأ_وقت_تشغيل_مفسر.تجاوز_عمق_النداء((جديد - (*ح).بداية_المكدس) مثل طبيعي)
                        ));
                        اخرج_من_حلقة;
                    } وإلا {
                        دع بعد: ط64 = مرر_حجج_آلة(ح, ق, fp, وا, جمع_م(pc, 2));
                        ق[جديد - 6] := بعد + 4;
                        ق[جديد - 5] := fp;
                        ق[جديد - 3] := البيئة;
                        ق[جديد - 2] := الحالية;
                        هيئ_ناتج_نداء_آلة(ق, fp, وا, جديد, بعد);
                        fp := جديد;
                        الحالية := المدعوة;
                        الكلمات := ق[الوصف + 1];
                        pc := جمع_م(ش, ق[الوصف]);
                    };
                };
            }
            | 40 -> {
                طابق نادي_خارجية_آلة(ب, ح, ق, fp, pc) مع
                | نتيجة.نجح(التالي) -> { pc := التالي; }
                | نتيجة.خطأ(الفشل) -> { فشل_آخر := اختياري.موجود(الفشل); اخرج_من_حلقة; };
            }
            | 41 -> {
                طابق نادي_نواة_من_شفرة_آلة(ح, ق, fp, pc) مع
                | اختياري.موجود(التالي) -> {
                    إذا (التالي == علامة_انتهاء_خيط_آلة()) { أرجع نتيجة_آلة.عادت(0); };
                    pc := التالي;
                }
                | اختياري.لا_شيء -> { اخرج_من_حلقة; };
            }
            | 43 -> {
                طابق نادي_عنوان_سي_من_شفرة_آلة(ح, ق, fp, pc) مع
                | اختياري.موجود(التالي) -> { pc := التالي; }
                | اختياري.لا_شيء -> {
                    فشل_آخر := اختياري.موجود(فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.نداء_عنوان_سي())
                    ));
                    اخرج_من_حلقة;
                };
            }
            | 44 -> {
                دع المعلومات: ط64 = ق[fp - 1];
                دع العائد: ط64 = ق[fp - 6];
                دع السابق: ط64 = ق[fp - 5];
                دع المستدعية: ط64 = ق[fp - 2];
                إذا ((المعلومات & 0xFFFFFFFF) != لا) {
                    ق[السابق + (المعلومات & 0xFFFFFFFF)] := ق[وا + (المعلومات >> 32)];
                };
                إذا (العائد == توقف) {
                    (*ح).موضع_الفشل := طرح_م(pc, ش);
                    أرجع نتيجة_آلة.عادت(ق[وا]);
                };
                إذا (العائد == نهاية_مهمة) { اخرج_من_حلقة; } وإلا {
                fp := السابق;
                الحالية := المستدعية;
                الكلمات := ق[جد + 4 * المستدعية + 1];
                pc := العائد;
                };
            }
            | 45 -> {
                إذا (ق[جمع_م(pc, 1)] == 0) {
                    ق[وا + ق[جمع_م(pc, 3)]] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                } وإلا {
                    دع الوجهة: ط64 = ق[fp - 4];
                    دع المصدر: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                    إذا (الوجهة != 0 && الوجهة != المصدر) {
                        انسخ_خام(&(*ح).الذاكرة, الوجهة, المصدر, ق[جمع_م(pc, 3)]);
                    };
                };
                // Then return as op 44 does.
                دع المعلومات: ط64 = ق[fp - 1];
                دع العائد: ط64 = ق[fp - 6];
                دع السابق: ط64 = ق[fp - 5];
                دع المستدعية: ط64 = ق[fp - 2];
                إذا ((المعلومات & 0xFFFFFFFF) != لا) {
                    ق[السابق + (المعلومات & 0xFFFFFFFF)] := ق[وا + (المعلومات >> 32)];
                };
                إذا (العائد == توقف) {
                    أرجع نتيجة_آلة.عادت(ق[وا]);
                };
                إذا (العائد == نهاية_مهمة) { اخرج_من_حلقة; } وإلا {
                fp := السابق;
                الحالية := المستدعية;
                الكلمات := ق[جد + 4 * المستدعية + 1];
                pc := العائد;
                };
            }
            | 53 -> {
                // std.async's task switch: (الحفظ, المكدس_الجديد). The saved
                // "stack pointer" is the address of a context record of this
                // engine (pc, frame, function, frame words, region end, the
                // register for the result); a fresh task's pointer is the
                // first frame std built (its entry closure in x86_64's r12
                // slot or arm64's x19 slot: إزاحة_إغلاق_مهمة), which starts
                // on a frame region of its own.
                دع الحفظ: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 1)])];
                دع الجديد: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع سجل_الناتج: ط64 = ق[جمع_م(pc, 3)];
                إذا (الجديد == 0) {
                    // Tasks switch here: a nonzero "trampoline".
                    إذا (سجل_الناتج != لا) { ق[fp + سجل_الناتج] := 1; };
                    pc := جمع_م(pc, 4);
                } وإلا {
                    دع السجل: ط64 = خصص_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, 64);
                    إذا (السجل == 0) { اخرج_من_حلقة; } وإلا {
                        دع س: ط64 = طرح_م(السجل, أ) >> 3;
                        ق[س] := علامة_سياق_آلة();
                        ق[س + 1] := جمع_م(pc, 4);
                        ق[س + 2] := fp;
                        ق[س + 3] := الحالية;
                        ق[س + 4] := الكلمات;
                        ق[س + 5] := نهاية;
                        ق[س + 6] := سجل_الناتج;
                        اكتب_آلة(ح, الحفظ, 8, السجل);
                        إذا ((الجديد & 7) == 0 && اقرأ_آلة(ح, الجديد, 8) == علامة_سياق_آلة()) {
                            دع ر: ط64 = طرح_م(الجديد, أ) >> 3;
                            pc := ق[ر + 1];
                            fp := ق[ر + 2];
                            الحالية := ق[ر + 3];
                            الكلمات := ق[ر + 4];
                            نهاية := ق[ر + 5];
                            إذا (ق[ر + 6] != لا) { ق[fp + ق[ر + 6]] := 0; };
                            ق[ر] := 0;
                            حرر_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, الجديد);
                        } وإلا {
                            دع الإغلاق: ط64 = اقرأ_آلة(ح, جمع_م(الجديد, (*ب).إزاحة_إغلاق_مهمة), 8);
                            دع المدعوة: ط64 = طرح_م(اقرأ_آلة(ح, الإغلاق, 8), قاعدة_مقابض_آلة());
                            دع المنطقة: ط64 = منطقة_مهمة_آلة(ح, الجديد);
                            إذا (المنطقة == 0 || المدعوة >= عدد_الدوال || ق[جد + 4 * المدعوة + 2] == 0) { اخرج_من_حلقة; } وإلا {
                                دع جديد: ط64 = المنطقة + الرأس;
                                ق[جديد - 6] := نهاية_مهمة;
                                ق[جديد - 5] := 0;
                                ق[جديد - 4] := 0;
                                ق[جديد - 3] := الإغلاق;
                                ق[جديد - 2] := المدعوة;
                                ق[جديد - 1] := لا;
                                fp := جديد;
                                الحالية := المدعوة;
                                الكلمات := ق[جد + 4 * المدعوة + 1];
                                نهاية := المنطقة + كلمات_منطقة_مهمة_آلة() - 16;
                                pc := جمع_م(ش, ق[جد + 4 * المدعوة]);
                            };
                        };
                    };
                };
            }
            | 47 -> {
                دع الفهرس: طبيعي = ق[جمع_م(pc, 1)] مثل طبيعي;
                طابق (*ب).بدائيات_غير_مدعومة[الفهرس] مع
                | البدائي -> {
                    فشل_آخر := اختياري.موجود(فشل_تفسير_مسير.وقت_تشغيل(
                        خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(البدائي)
                    ));
                };
                اخرج_من_حلقة;
            }
            | 54 -> {
                // Thread start: (number, flags, stack, parent tid, child tid,
                // TLS, closure, result).
                دع ن: ط64 = ابدأ_خيط_آلة(
                    ب, ح, ق[جمع_م(fp, ق[جمع_م(pc, 1)])], ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(fp, ق[جمع_م(pc, 3)])],
                    ق[جمع_م(fp, ق[جمع_م(pc, 4)])], ق[جمع_م(fp, ق[جمع_م(pc, 5)])], ق[جمع_م(fp, ق[جمع_م(pc, 6)])],
                    ق[جمع_م(fp, ق[جمع_م(pc, 7)])]
                );
                إذا (ق[جمع_م(pc, 8)] != لا) { ق[جمع_م(fp, ق[جمع_م(pc, 8)])] := ن; };
                pc := جمع_م(pc, 9);
            }
            | 57 -> {
                // One of std's allocation counters: (kind, result).
                دع ن: ط64 = عداد_آلة(ح, ق[جمع_م(pc, 1)]);
                إذا (ق[جمع_م(pc, 2)] != لا) { ق[جمع_م(fp, ق[جمع_م(pc, 2)])] := ن; };
                pc := جمع_م(pc, 3);
            }
            | 55 -> {
                // A C entry for a closure: a marker the C call it is passed
                // to replaces with a host entry (بدل_مداخل_سي_آلة).
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := علامة_مدخل_سي_آلة();
                pc := جمع_م(pc, 2);
            }
            | 56 -> {
                دع البتات: ط64 = ق[جمع_م(pc, 5)];
                دع م_: ط64 = قناع_آلة(البتات);
                دع ن: طبيعي = ضرب_جمع_مدمج_عائم_برمجي(
                    (ق[جمع_م(fp, ق[جمع_م(pc, 2)])] & م_) مثل طبيعي, (ق[جمع_م(fp, ق[جمع_م(pc, 3)])] & م_) مثل طبيعي,
                    (ق[جمع_م(fp, ق[جمع_م(pc, 4)])] & م_) مثل طبيعي, وصف_عائم_برمجي_من(البتات مثل طبيعي)
                );
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := (ن مثل ط64) & م_;
                pc := جمع_م(pc, 6);
            }
            | 58 -> {
                // Compare a register with an immediate (flags).
                ق[جمع_م(fp, ق[جمع_م(pc, 3)])] := ق[جمع_م(fp, ق[جمع_م(pc, 1)])];
                ق[جمع_م(fp, ق[جمع_م(pc, 3)]) + 1] := ق[جمع_م(pc, 2)];
                pc := جمع_م(pc, 4);
            }
            | 59 -> {
                دع ع: ط64 = ق[جمع_م(pc, 3)];
                إذا (شرط_محقق_آلة(ق[جمع_م(pc, 2)], ق[fp + ع], ق[fp + ع + 1])) {
                    ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := 1;
                } وإلا { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := 0; };
                pc := جمع_م(pc, 4);
            }
            | 46 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[وا + ق[جمع_م(pc, 2)]]; pc := جمع_م(pc, 3); }
            | 48 -> {
                دع النوع: ط64 = ق[جمع_م(pc, 1)];
                دع س: متغير ط64 = 0;
                إذا (ق[جمع_م(pc, 2)] != لا) { س := ق[جمع_م(fp, ق[جمع_م(pc, 2)])]; };
                دع ص: متغير ط64 = 0;
                إذا (ق[جمع_م(pc, 3)] != لا) { ص := ق[جمع_م(fp, ق[جمع_م(pc, 3)])]; };
                دع ن: متغير ط64 = 0;
                إذا (النوع == 0) {
                    ن := خصص_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, س);
                    إذا (ن != 0) { عد_تخزين_آلة(ح, 0, س); };
                } وإلا إذا (النوع == 1) {
                    ن := أعد_تخصيص_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, س, ص);
                    إذا (ن != 0) { عد_نمو_آلة(ح, س, ص); };
                } وإلا {
                    إذا (س != 0) { عد_تخزين_آلة(ح, 1, 0); };
                    حرر_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة, س);
                };
                إذا (ق[جمع_م(pc, 4)] != لا) { ق[جمع_م(fp, ق[جمع_م(pc, 4)])] := ن; };
                pc := جمع_م(pc, 5);
            }
            // The optimizer's forms (machine_optimizer.sn): checked add and
            // subtract of an immediate, wrapping add of one.
            | 77 -> {
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ن: ط64 = جمع_م(س, ق[جمع_م(pc, 3)]);
                إذا (ن < س) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4);
            }
            | 78 -> {
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ص: ط64 = ق[جمع_م(pc, 3)];
                إذا (س < ص) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := طرح_م(س, ص); pc := جمع_م(pc, 4);
            }
            | 79 -> {
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ص: ط64 = ق[جمع_م(pc, 3)];
                دع ن: ط64 = جمع_م(س, ص);
                إذا ((((س ^ ن) & (ص ^ ن)) >> 63) != 0) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4);
            }
            | 80 -> {
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ص: ط64 = ق[جمع_م(pc, 3)];
                دع ن: ط64 = طرح_م(س, ص);
                إذا ((((س ^ ص) & (س ^ ن)) >> 63) != 0) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4);
            }
            | 81 -> {
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := جمع_م(ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(pc, 3)]);
                pc := جمع_م(pc, 4);
            }
            // Branch when a 64-bit comparison of two registers holds: =, !=,
            // <u, <=u, <s, <=s (signed by flipping the sign bits).
            | 82 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] == ق[جمع_م(fp, ق[جمع_م(pc, 2)])]) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            | 83 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] != ق[جمع_م(fp, ق[جمع_م(pc, 2)])]) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            | 84 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] < ق[جمع_م(fp, ق[جمع_م(pc, 2)])]) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            | 85 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] <= ق[جمع_م(fp, ق[جمع_م(pc, 2)])]) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            | 86 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] ^ 0x8000000000000000) < (ق[جمع_م(fp, ق[جمع_م(pc, 2)])] ^ 0x8000000000000000)) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            | 87 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] ^ 0x8000000000000000) <= (ق[جمع_م(fp, ق[جمع_م(pc, 2)])] ^ 0x8000000000000000)) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            // The same against an immediate: =, !=, <u, <=u, >u, >=u, <s,
            // <=s, >s, >=s.
            | 88 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] == ق[جمع_م(pc, 2)]) { pc := جمع_م(ش, ق[جمع_م(pc, 3)]); } وإلا { pc := جمع_م(pc, 4); };
            }
            | 89 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] != ق[جمع_م(pc, 2)]) { pc := جمع_م(ش, ق[جمع_م(pc, 3)]); } وإلا { pc := جمع_م(pc, 4); };
            }
            | 90 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] < ق[جمع_م(pc, 2)]) { pc := جمع_م(ش, ق[جمع_م(pc, 3)]); } وإلا { pc := جمع_م(pc, 4); };
            }
            | 91 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] <= ق[جمع_م(pc, 2)]) { pc := جمع_م(ش, ق[جمع_م(pc, 3)]); } وإلا { pc := جمع_م(pc, 4); };
            }
            | 92 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] > ق[جمع_م(pc, 2)]) { pc := جمع_م(ش, ق[جمع_م(pc, 3)]); } وإلا { pc := جمع_م(pc, 4); };
            }
            | 93 -> {
                إذا (ق[جمع_م(fp, ق[جمع_م(pc, 1)])] >= ق[جمع_م(pc, 2)]) { pc := جمع_م(ش, ق[جمع_م(pc, 3)]); } وإلا { pc := جمع_م(pc, 4); };
            }
            | 94 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] ^ 0x8000000000000000) < (ق[جمع_م(pc, 2)] ^ 0x8000000000000000)) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            | 95 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] ^ 0x8000000000000000) <= (ق[جمع_م(pc, 2)] ^ 0x8000000000000000)) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            | 96 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] ^ 0x8000000000000000) > (ق[جمع_م(pc, 2)] ^ 0x8000000000000000)) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            | 97 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] ^ 0x8000000000000000) >= (ق[جمع_م(pc, 2)] ^ 0x8000000000000000)) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 3)]);
                } وإلا { pc := جمع_م(pc, 4); };
            }
            // Narrow = and != under a mask (registers, then an immediate).
            | 98 -> {
                إذا (((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] ^ ق[جمع_م(fp, ق[جمع_م(pc, 2)])]) & ق[جمع_م(pc, 3)]) == 0) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 4)]);
                } وإلا { pc := جمع_م(pc, 5); };
            }
            | 99 -> {
                إذا (((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] ^ ق[جمع_م(fp, ق[جمع_م(pc, 2)])]) & ق[جمع_م(pc, 3)]) != 0) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 4)]);
                } وإلا { pc := جمع_م(pc, 5); };
            }
            | 100 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] & ق[جمع_م(pc, 3)]) == ق[جمع_م(pc, 2)]) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 4)]);
                } وإلا { pc := جمع_م(pc, 5); };
            }
            | 101 -> {
                إذا ((ق[جمع_م(fp, ق[جمع_م(pc, 1)])] & ق[جمع_م(pc, 3)]) != ق[جمع_م(pc, 2)]) {
                    pc := جمع_م(ش, ق[جمع_م(pc, 4)]);
                } وإلا { pc := جمع_م(pc, 5); };
            }
            // 64-bit checked multiply, unsigned divide and remainder, and
            // division by a constant that cannot trap.
            | 102 -> {
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ص: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 3)])];
                دع ن: ط64 = ضرب_م(س, ص);
                إذا (س != 0 && ن / س != ص) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4);
            }
            | 113 -> {
                دع س: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                دع ص: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 3)])];
                دع ن: ط64 = ضرب_م(س, ص);
                إذا (!ضرب_موقع_سليم_آلة(س, ص, ن)) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ن; pc := جمع_م(pc, 4);
            }
            | 103 -> {
                دع ص: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 3)])];
                إذا (ص == 0) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])] / ص; pc := جمع_م(pc, 4);
            }
            | 104 -> {
                دع ص: ط64 = ق[جمع_م(fp, ق[جمع_م(pc, 3)])];
                إذا (ص == 0) { اخرج_من_حلقة; };
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])] % ص; pc := جمع_م(pc, 4);
            }
            | 105 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])] / ق[جمع_م(pc, 3)]; pc := جمع_م(pc, 4); }
            | 106 -> { ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])] % ق[جمع_م(pc, 3)]; pc := جمع_م(pc, 4); }
            | 107 -> {
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := قسمة_بإشارة_آلة(ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(pc, 3)], خطأ);
                pc := جمع_م(pc, 4);
            }
            | 108 -> {
                ق[جمع_م(fp, ق[جمع_م(pc, 1)])] := قسمة_بإشارة_آلة(ق[جمع_م(fp, ق[جمع_م(pc, 2)])], ق[جمع_م(pc, 3)], صواب);
                pc := جمع_م(pc, 4);
            }
            // Calls of program functions with up to three one-word
            // arguments (machine_program.sn أصدر_نداء_بسيطا_آلة).
            | 109 -> {
                دع المدعوة: ط64 = ق[جمع_م(pc, 1)];
                دع الوصف: ط64 = جد + 4 * المدعوة;
                دع جديد: ط64 = fp + الكلمات + الرأس;
                إذا (ق[الوصف + 2] == 0) { اخرج_من_حلقة; };
                إذا (جديد + ق[الوصف + 1] >= نهاية) {
                    فشل_آخر := اختياري.موجود(فشل_عمق_آلة(ح, جديد));
                    اخرج_من_حلقة;
                };
                ق[جديد - 6] := جمع_م(pc, 4);
                ق[جديد - 5] := fp;
                ق[جديد - 4] := 0;
                ق[جديد - 3] := 0;
                ق[جديد - 2] := الحالية;
                ق[جديد - 1] := (ق[جمع_م(pc, 3)] << 32) | ق[جمع_م(pc, 2)];
                fp := جديد;
                الحالية := المدعوة;
                الكلمات := ق[الوصف + 1];
                pc := جمع_م(ش, ق[الوصف]);
            }
            | 110 -> {
                دع المدعوة: ط64 = ق[جمع_م(pc, 1)];
                دع الوصف: ط64 = جد + 4 * المدعوة;
                دع جديد: ط64 = fp + الكلمات + الرأس;
                إذا (ق[الوصف + 2] == 0) { اخرج_من_حلقة; };
                إذا (جديد + ق[الوصف + 1] >= نهاية) {
                    فشل_آخر := اختياري.موجود(فشل_عمق_آلة(ح, جديد));
                    اخرج_من_حلقة;
                };
                ق[وا + ق[جمع_م(pc, 3)]] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                ق[جديد - 6] := جمع_م(pc, 6);
                ق[جديد - 5] := fp;
                ق[جديد - 4] := 0;
                ق[جديد - 3] := 0;
                ق[جديد - 2] := الحالية;
                ق[جديد - 1] := (ق[جمع_م(pc, 5)] << 32) | ق[جمع_م(pc, 4)];
                fp := جديد;
                الحالية := المدعوة;
                الكلمات := ق[الوصف + 1];
                pc := جمع_م(ش, ق[الوصف]);
            }
            | 111 -> {
                دع المدعوة: ط64 = ق[جمع_م(pc, 1)];
                دع الوصف: ط64 = جد + 4 * المدعوة;
                دع جديد: ط64 = fp + الكلمات + الرأس;
                إذا (ق[الوصف + 2] == 0) { اخرج_من_حلقة; };
                إذا (جديد + ق[الوصف + 1] >= نهاية) {
                    فشل_آخر := اختياري.موجود(فشل_عمق_آلة(ح, جديد));
                    اخرج_من_حلقة;
                };
                ق[وا + ق[جمع_م(pc, 3)]] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                ق[وا + ق[جمع_م(pc, 5)]] := ق[جمع_م(fp, ق[جمع_م(pc, 4)])];
                ق[جديد - 6] := جمع_م(pc, 8);
                ق[جديد - 5] := fp;
                ق[جديد - 4] := 0;
                ق[جديد - 3] := 0;
                ق[جديد - 2] := الحالية;
                ق[جديد - 1] := (ق[جمع_م(pc, 7)] << 32) | ق[جمع_م(pc, 6)];
                fp := جديد;
                الحالية := المدعوة;
                الكلمات := ق[الوصف + 1];
                pc := جمع_م(ش, ق[الوصف]);
            }
            | 112 -> {
                دع المدعوة: ط64 = ق[جمع_م(pc, 1)];
                دع الوصف: ط64 = جد + 4 * المدعوة;
                دع جديد: ط64 = fp + الكلمات + الرأس;
                إذا (ق[الوصف + 2] == 0) { اخرج_من_حلقة; };
                إذا (جديد + ق[الوصف + 1] >= نهاية) {
                    فشل_آخر := اختياري.موجود(فشل_عمق_آلة(ح, جديد));
                    اخرج_من_حلقة;
                };
                ق[وا + ق[جمع_م(pc, 3)]] := ق[جمع_م(fp, ق[جمع_م(pc, 2)])];
                ق[وا + ق[جمع_م(pc, 5)]] := ق[جمع_م(fp, ق[جمع_م(pc, 4)])];
                ق[وا + ق[جمع_م(pc, 7)]] := ق[جمع_م(fp, ق[جمع_م(pc, 6)])];
                ق[جديد - 6] := جمع_م(pc, 10);
                ق[جديد - 5] := fp;
                ق[جديد - 4] := 0;
                ق[جديد - 3] := 0;
                ق[جديد - 2] := الحالية;
                ق[جديد - 1] := (ق[جمع_م(pc, 9)] << 32) | ق[جمع_م(pc, 8)];
                fp := جديد;
                الحالية := المدعوة;
                الكلمات := ق[الوصف + 1];
                pc := جمع_م(ش, ق[الوصف]);
            }
            | _ -> { فشل_آخر := اختياري.لا_شيء(); اخرج_من_حلقة; };
        }
    }
    (*ح).موضع_الفشل := طرح_م(pc, ش);
    طابق فشل_آخر مع
    | اختياري.موجود(الفشل) -> { أرجع نتيجة_آلة.فشلت(الفشل); }
    | اختياري.لا_شيء -> { أرجع نتيجة_آلة.فشلت(فشل_فخ_آلة(ب, طرح_م(pc, ش))); };
}

// Writes a call's arguments (at الموضع: count, then each interface value) to
// the transfer area; the position of the result description after them.
عرف مرر_حجج_آلة(ح: &حالة_آلة, ق: *متغير ط64, fp: ط64, وا: ط64, الموضع: ط64): ط64 {
    دع م: متغير ط64 = الموضع;
    غير_آمن {
        دع ن: ط64 = ق[م];
        م := م + 1;
        دع ف: متغير ط64 = 0;
        طالما (ف < ن) {
            دع النوع: ط64 = ق[م];
            دع القيمة: ط64 = ق[fp + ق[م + 1]];
            دع الحجم: ط64 = ق[م + 2];
            دع المواضع: ط64 = ق[م + 3];
            إذا (النوع == 1 || النوع == 4) {
                // An aggregate in parts: part k is its bytes [uk, uk + u), u
                // 8 or, for an AArch64 HFA, its element size.
                دع الوحدة: متغير ط64 = 8;
                إذا (النوع == 4 && المواضع > 0) { الوحدة := الحجم / المواضع; };
                دع ك: متغير ط64 = 0;
                طالما (ك < المواضع) {
                    دع الجزء: متغير ط64 = الحجم - الوحدة * ك;
                    إذا (الجزء > الوحدة) { الجزء := الوحدة; };
                    ق[وا + ق[م + 4 + ك]] := اقرأ_خام(&(*ح).الذاكرة, جمع_م(القيمة, الوحدة * ك), الجزء);
                    ك := ك + 1;
                }
            } وإلا {
                ق[وا + ق[م + 4]] := القيمة;
            };
            م := م + 4 + المواضع;
            ف := ف + 1;
        }
    }
    أرجع م;
}

// Records where the callee's result goes (in its header at جديد) from the
// result description at الموضع: kind, register, size, position.
عرف هيئ_ناتج_نداء_آلة(ق: *متغير ط64, fp: ط64, وا: ط64, جديد: ط64, الموضع: ط64): فراغ {
    غير_آمن {
        دع النوع: ط64 = ق[الموضع];
        دع السجل: ط64 = ق[الموضع + 1];
        ق[جديد - 4] := 0;
        ق[جديد - 1] := لا_سجل_آلة();
        إذا (النوع == 1) {
            ق[جديد - 1] := (ق[الموضع + 3] << 32) | السجل;
        } وإلا إذا (النوع == 2 || النوع == 3) {
            ق[جديد - 4] := ق[fp + السجل];
            إذا (النوع == 3) { ق[وا + 40] := ق[fp + السجل]; };
        };
    }
}

// The argument words of a call out of the program, in order.
عرف كلمات_حجج_آلة(ق: *متغير ط64, fp: ط64, الموضع: ط64, الكلمات: &متغير متجه ط64): ط64 {
    دع م: متغير ط64 = الموضع;
    غير_آمن {
        دع ن: ط64 = ق[م];
        م := م + 1;
        دع ف: متغير ط64 = 0;
        طالما (ف < ن) {
            ألحق(*الكلمات, ق[fp + ق[م + 1]]);
            م := م + 4 + ق[م + 3];
            ف := ف + 1;
        }
    }
    أرجع م;
}

// Stores a call-out's result word (description at الموضع); the next pc.
عرف ضع_ناتج_خارجي_آلة(ق: *متغير ط64, fp: ط64, الموضع: ط64, القيمة: ط64): ط64 {
    غير_آمن {
        إذا (ق[الموضع] == 1) { ق[fp + ق[الموضع + 1]] := القيمة; };
    }
    أرجع الموضع + 4;
}

عرف نادي_خارجية_آلة(ب: &متغير برنامج_آلة, ح: &متغير حالة_آلة, ق: *متغير ط64, fp: ط64, pc: ط64): نتيجة ط64, فشل_تفسير_مسير {
    دع الفهرس: متغير ط64 = 0;
    غير_آمن { الفهرس := ق[pc + 1]; }
    دع الكلمات: متغير متجه ط64 = [];
    دع بعد: ط64 = كلمات_حجج_آلة(ق, fp, pc + 2, &متغير الكلمات);
    إذا (!بدل_مداخل_سي_آلة(ب, ح, &متغير الكلمات)) {
        أرجع نتيجة.خطأ(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.بدائي_آلة_غير_مدعوم(هوية_بدائي_مترجم.مدخل_سي_لدالة())
        ));
    };
    إذا ((*ب).الخارجيات[الفهرس مثل طبيعي].العنوان == 0) {
        دع العنوان_المحلول: ط64 = حل_خارجية_آلة(ح, &(*ب).الخارجيات[الفهرس مثل طبيعي], &(*ب).مقابض_المكتبات);
        (*ب).الخارجيات[الفهرس مثل طبيعي].العنوان := العنوان_المحلول;
    };
    دع الخارجية: &متغير خارجية_آلة = &متغير (*ب).الخارجيات[الفهرس مثل طبيعي];
    إذا ((*الخارجية).العنوان == 0) {
        أرجع نتيجة.خطأ(فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.نداء_خارجي_غير_مدعوم((*الخارجية).المعرف, انسخ_بايتات(&(*الخارجية).الاسم))
        ));
    };
    دع الخام: متغير ط64 = 0;
    إذا ((*الخارجية).العنوان == 1) {
        طابق نفذ_دالة_خارجية_مضيف(&(*الخارجية).الاسم, &الكلمات) مع
        | اختياري.موجود(ن) -> { الخام := ن; }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.نداء_خارجي_غير_مدعوم((*الخارجية).المعرف, انسخ_بايتات(&(*الخارجية).الاسم))
            ));
        };
    } وإلا {
        إذا (!توقيع_سي_مقبول_مضيف(&(*الخارجية).الأصناف)) {
            أرجع نتيجة.خطأ(فشل_تفسير_مسير.وقت_تشغيل(
                خطأ_وقت_تشغيل_مفسر.نداء_خارجي_غير_مدعوم((*الخارجية).المعرف, انسخ_بايتات(&(*الخارجية).الاسم))
            ));
        };
        الخام := نادي_عنوان_مضيف((*الخارجية).العنوان, &الكلمات, &(*الخارجية).الأصناف, (*الخارجية).الناتج);
    };
    طابق (*الخارجية).الناتج مع
    | صنف_سي_مضيف.عائم32 -> { الخام := الخام & 0xFFFFFFFF; }
    | صنف_سي_مضيف.عائم64 -> { }
    | صنف_سي_مضيف.صحيح -> {
        إذا ((*الخارجية).منطقي_الناتج) {
            إذا ((الخام & 0xFF) != 0) { الخام := 1; } وإلا { الخام := 0; };
        } وإلا إذا ((*الخارجية).حجم_الناتج > 0 && (*الخارجية).حجم_الناتج < 8) {
            الخام := الخام & قناع_آلة((*الخارجية).حجم_الناتج * 8);
        };
    };
    أرجع نتيجة.نجح(ضع_ناتج_خارجي_آلة(ق, fp, بعد, الخام));
}

// The code position op 41 answers for a thread's exit: the engine returns.
عرف علامة_انتهاء_خيط_آلة(): ط64 { أرجع ~(1 مثل ط64); }

عرف نادي_نواة_من_شفرة_آلة(ح: &متغير حالة_آلة, ق: *متغير ط64, fp: ط64, pc: ط64): اختياري ط64 {
    إذا (!نواة_آلة_متاحة()) { أرجع اختياري.لا_شيء(); };
    دع الكلمات: متغير متجه ط64 = [];
    دع بعد: ط64 = كلمات_حجج_آلة(ق, fp, pc + 1, &متغير الكلمات);
    طالما ((الطول(الكلمات) مثل طبيعي) < 7) { ألحق(الكلمات, 0); }
    إذا ((*ح).خيط && الكلمات[0] == رقم_خروج_خيط_آلة()) {
        أرجع اختياري.موجود(علامة_انتهاء_خيط_آلة());
    };
    دع ن: ط64 = نادي_نواة_آلة(ح, الكلمات[0], الكلمات[1], الكلمات[2], الكلمات[3], الكلمات[4], الكلمات[5], الكلمات[6]);
    أرجع اختياري.موجود(ضع_ناتج_خارجي_آلة(ق, fp, بعد, ن));
}

// A C call at a run-time address (op 43) where the target's code calls C:
// every native selector but wasm32's lowers بدائي_نداء_عنوان_سي, and LLVM
// does. WebAssembly has no callable machine addresses (WASI has no C calls),
// so there the call is the "machine primitive unsupported" failure.
إذا (الهدف.المعمارية != «wasm32») {
    // بدائي_نداء_عنوان_سي: eight integer words and eight float words; the result
    // is a float when the result is in a floating register.
    عرف نادي_عنوان_سي_من_شفرة_آلة(ح: &متغير حالة_آلة, ق: *متغير ط64, fp: ط64, pc: ط64): اختياري ط64 {
        دع العنوان: متغير ط64 = 0;
        غير_آمن { العنوان := ق[fp + ق[pc + 1]]; }
        دع ك: متغير متجه ط64 = [];
        دع بعد: ط64 = كلمات_حجج_آلة(ق, fp, pc + 2, &متغير ك);
        طالما ((الطول(ك) مثل طبيعي) < 16) { ألحق(ك, 0); }
        دع موضع_الناتج: متغير ط64 = 0;
        غير_آمن { موضع_الناتج := ق[بعد + 3]; }
        دع الخام: متغير ط64 = 0;
        غير_آمن {
            إذا (موضع_الناتج >= 16 && موضع_الناتج < 32) {
                دع ع: ع64 = نادي_سي_آلة(
                    0.0, العنوان, ك[0], ك[1], ك[2], ك[3], ك[4], ك[5], ك[6], ك[7],
                    ع64_من_بتات_آلة(ك[8]), ع64_من_بتات_آلة(ك[9]), ع64_من_بتات_آلة(ك[10]), ع64_من_بتات_آلة(ك[11]),
                    ع64_من_بتات_آلة(ك[12]), ع64_من_بتات_آلة(ك[13]), ع64_من_بتات_آلة(ك[14]), ع64_من_بتات_آلة(ك[15])
                );
                الخام := بتات_ع64_آلة(ع);
            } وإلا {
                الخام := نادي_سي_آلة(
                    0 مثل ط64, العنوان, ك[0], ك[1], ك[2], ك[3], ك[4], ك[5], ك[6], ك[7],
                    ع64_من_بتات_آلة(ك[8]), ع64_من_بتات_آلة(ك[9]), ع64_من_بتات_آلة(ك[10]), ع64_من_بتات_آلة(ك[11]),
                    ع64_من_بتات_آلة(ك[12]), ع64_من_بتات_آلة(ك[13]), ع64_من_بتات_آلة(ك[14]), ع64_من_بتات_آلة(ك[15])
                );
            };
        }
        أرجع اختياري.موجود(ضع_ناتج_خارجي_آلة(ق, fp, بعد, الخام));
    }
}
إذا (الهدف.المعمارية == «wasm32») {
    عرف نادي_عنوان_سي_من_شفرة_آلة(ح: &متغير حالة_آلة, ق: *متغير ط64, fp: ط64, pc: ط64): اختياري ط64 {
        أرجع اختياري.لا_شيء();
    }
}

// ---- Threads ----------------------------------------------------------------------
//
// A thread of the program runs on a host thread, on an engine of its own:
// its own frame region and ABI area, the shared program and memory, and the
// shared heap (locked from the first start on). The host's allocator is
// locked too, as std's is after a spawn. On Linux the host thread is made
// by the clone the program asked for (its flags, stack and tid cells, so
// the kernel writes and clears the program's tid cell and join works
// unchanged); on macOS (arm64) libpthread starts it from the C entry the
// program made (بدائي_مدخل_سي_لدالة), which the engine answers with a host
// entry of its own (op 55 and the C call that passes it). The host side is
// host_threads.sn: a host closure calls شغل_خيط_بفهرس_آلة with the index
// of the thread's context in خيوط_معلقة_آلة.

عرف عنوان_خطأ_خيط_آلة(): ط64 { أرجع طرح_م(0 مثل ط64, 22); }

// The value op 55 answers for a C entry: no code; the C call it is passed
// to gets a host entry in its place (بدل_مداخل_سي_آلة).
عرف علامة_مدخل_سي_آلة(): ط64 { أرجع 0x5A5B000000000000; }

نوع خيط_آلة = {
    البرنامج: *متغير برنامج_آلة,
    الحالة: حالة_آلة,
    الدالة: ط64,
    البيئة: ط64,
    // The thread's frame region and ABI area, released when it ends.
    المنطقة: ط64,
    حجم_المنطقة: ط64,
    الواجهة: ط64
};

// std's allocator lock (library/std/os/allocation.sn فعّل_قفل_المخصص), set
// before a thread of the program starts. std declares it where its
// allocator serves threads (the same two target conditions); elsewhere
// (wasm32-wasi) there are no threads, and so nothing to lock.
إذا (((((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») || الهدف.المنصة == «macos» || الهدف.المنصة == «windows») && الهدف.عرض_المؤشر == «64») || ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve» && الهدف.عرض_المؤشر == «32»)) {
    عرف فعّل_قفل_المخصص_آلة(): فراغ { فعّل_قفل_المخصص(); }
}
إذا (!(((((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») || الهدف.المنصة == «macos» || الهدف.المنصة == «windows») && الهدف.عرض_المؤشر == «64») || ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve» && الهدف.عرض_المؤشر == «32»))) {
    عرف فعّل_قفل_المخصص_آلة(): فراغ { }
}

// Contexts of threads not yet started (by index), the free indices, and the
// spin lock over both.
دع خيوط_معلقة_آلة: متغير متجه اختياري خيط_آلة = [];
دع خانات_خيوط_حرة_آلة: متغير متجه ط64 = [];
دع قفل_خيوط_آلة: متغير ط64 = 0;
مرادف قارن_وبدل_قفل_خيوط_آلة = بدائي_ذري_قارن_وبدل;
مرادف خزن_قفل_خيوط_آلة = بدائي_ذري_خزن;

عرف اقفل_خيوط_آلة(): فراغ {
    دع القديم: متغير ط64 = 1;
    طالما (القديم != 0) {
        غير_آمن { القديم := قارن_وبدل_قفل_خيوط_آلة(&قفل_خيوط_آلة, 0 مثل ط64, 1 مثل ط64, 4 مثل ط32, 4 مثل ط32); }
    }
}

عرف افتح_خيوط_آلة(): فراغ {
    غير_آمن { خزن_قفل_خيوط_آلة(&قفل_خيوط_آلة, 0 مثل ط64, 4 مثل ط32); }
}

// Stores a context; its index.
عرف أودع_خيط_آلة(الخيط: خيط_آلة): ط64 {
    اقفل_خيوط_آلة();
    دع الفهرس: متغير ط64 = 0;
    دع القيمة: متغير اختياري خيط_آلة = اختياري.موجود(الخيط);
    غير_آمن {
        طابق أزل_الأخير(خانات_خيوط_حرة_آلة) مع
        | اختياري.موجود(الخانة) -> {
            الفهرس := الخانة;
            بدّل(خيوط_معلقة_آلة[الفهرس مثل طبيعي], القيمة);
        }
        | اختياري.لا_شيء -> {
            الفهرس := الطول(خيوط_معلقة_آلة) مثل ط64;
            ألحق(خيوط_معلقة_آلة, القيمة);
        };
    }
    افتح_خيوط_آلة();
    أرجع الفهرس;
}

// Takes the context at الفهرس out (its index becomes free).
عرف خذ_خيط_آلة(الفهرس: ط64): اختياري خيط_آلة {
    اقفل_خيوط_آلة();
    دع القيمة: متغير اختياري خيط_آلة = اختياري.لا_شيء();
    غير_آمن {
        إذا (الفهرس < (الطول(خيوط_معلقة_آلة) مثل ط64)) {
            بدّل(خيوط_معلقة_آلة[الفهرس مثل طبيعي], القيمة);
            ألحق(خانات_خيوط_حرة_آلة, الفهرس);
        };
    }
    افتح_خيوط_آلة();
    أرجع القيمة;
}

// A trap or failure on a thread ends the process, as a native trap does
// (thread_failure.sn أنه_بفشل_خيط_آلة reports it).

// The program's main function returned while its threads may still run:
// the process ends here with its status, as a native program's does,
// before the program they share is released.
عام عرف أنه_العملية_بخيوط_آلة(الحالة: &متغير حالة_آلة, الرمز: ط64): فراغ {
    إذا (!كومة_مشتركة_آلة(&(*الحالة).الذاكرة, &متغير (*الحالة).الكومة)) { أرجع; };
    اخرج((الرمز & 0xFF) مثل عدد);
}

// The host thread's (or C callback's) entry: runs the program's closure
// whose context has index الفهرس, on that context's engine.
عرف شغل_خيط_بفهرس_آلة(الفهرس: ط64): فراغ {
    طابق خذ_خيط_آلة(الفهرس) مع
    | اختياري.لا_شيء -> { أنه_بفشل_خيط_آلة(اختياري.لا_شيء()); }
    | اختياري.موجود(الخيط) -> {
        دع السياق: متغير خيط_آلة = الخيط;
        دع ب: متغير *متغير برنامج_آلة = السياق.البرنامج;
        غير_آمن {
            طابق شغل_دالة_ببيئة_آلة(&متغير (*ب), &متغير السياق.الحالة, السياق.الدالة, السياق.البيئة) مع
            | نتيجة_آلة.عادت(_) -> { }
            | نتيجة_آلة.فشلت(الفشل) -> { أنه_بفشل_خيط_آلة(اختياري.موجود(الفشل)); };
        }
        حرر_منطقة_مضيف_آلة(السياق.المنطقة, السياق.حجم_المنطقة);
        حرر_منطقة_مضيف_آلة(السياق.الواجهة, حجم_منطقة_الواجهة_آلة() * 8);
    };
}

// The host closure (its environment address) that runs the program's
// closure at الإغلاق (its first word a function handle) on an engine of its
// own; 0 when the closure names no translated function, there is no memory,
// or this build starts no host threads.
عرف خيط_لإغلاق_آلة(ب: &متغير برنامج_آلة, ح: &متغير حالة_آلة, الإغلاق: ط64): ط64 {
    إذا (!خيوط_المضيف_متاحة()) { أرجع 0; };
    إذا (الإغلاق == 0 || (الإغلاق & 7) != 0) { أرجع 0; };
    دع المدعوة: ط64 = طرح_م(اقرأ_آلة(ح, الإغلاق, 8), قاعدة_مقابض_آلة());
    دع عدد_الدوال: ط64 = الطول((*ب).الدوال) مثل ط64;
    إذا (المدعوة >= عدد_الدوال || !(*ب).الدوال[المدعوة مثل طبيعي].مترجمة) { أرجع 0; };
    // The thread's frame region and ABI area (reserved, not committed).
    دع كلمات: ط64 = 1048576;
    دع المنطقة: ط64 = منطقة_مضيف_آلة(كلمات * 8 + 64);
    دع الواجهة: ط64 = منطقة_مضيف_آلة(حجم_منطقة_الواجهة_آلة() * 8);
    إذا (المنطقة == 0 || الواجهة == 0) { أرجع 0; };
    دع الذاكرة: ذاكرة_خام = { ق: (*ح).الذاكرة.ق, أ: (*ح).الذاكرة.أ, الحامل: [], متاحة: صواب };
    شارك_كومة_آلة(&(*ح).الذاكرة, &متغير (*ح).الكومة);
    دع الكومة: كومة_آلة = { التحكم: (*ح).الكومة.التحكم };
    دع الحالة: متغير حالة_آلة = حالة_آلة_جديدة(الذاكرة, الكومة);
    الحالة.خيط := صواب;
    دع بداية: متغير ط64 = المنطقة + 16 - (المنطقة & 15);
    إذا (((بداية + رأس_إطار_آلة() * 8) & 15) != 0) { بداية := بداية + 8; };
    الحالة.بداية_المكدس := فهرس_كلمة_خام(&الحالة.الذاكرة, بداية);
    الحالة.نهاية_المكدس := الحالة.بداية_المكدس + كلمات - 16;
    الحالة.الواجهة := فهرس_كلمة_خام(&الحالة.الذاكرة, الواجهة);
    فعّل_قفل_المخصص_آلة();
    دع البرنامج: *متغير برنامج_آلة = &متغير (*ب);
    دع الخيط: خيط_آلة = {
        البرنامج: البرنامج, الحالة: الحالة, الدالة: المدعوة, البيئة: الإغلاق,
        المنطقة: المنطقة, حجم_المنطقة: كلمات * 8 + 64, الواجهة: الواجهة
    };
    دع الفهرس: ط64 = أودع_خيط_آلة(الخيط);
    دع العنوان: ط64 = إغلاق_مضيف_بوسيط(شغل_خيط_بفهرس_آلة, الفهرس);
    إذا (العنوان == 0) { دع _خ: اختياري خيط_آلة = خذ_خيط_آلة(الفهرس); };
    أرجع العنوان;
}

عرف ابدأ_خيط_آلة(
    ب: &متغير برنامج_آلة, ح: &متغير حالة_آلة,
    الرقم: ط64, الأعلام: ط64, المكدس: ط64, الأب: ط64, الابن: ط64, المحلي: ط64, الإغلاق: ط64
): ط64 {
    إذا (!خيوط_المضيف_متاحة()) { أرجع طرح_م(0 مثل ط64, 38); };
    دع العنوان: ط64 = خيط_لإغلاق_آلة(ب, ح, الإغلاق);
    إذا (العنوان == 0) { أرجع عنوان_خطأ_خيط_آلة(); };
    أرجع استنسخ_خيط_مضيف(الرقم, الأعلام, المكدس, الأب, الابن, المحلي, العنوان);
}

// A C call passes op 55's marker with the program closure it stands for
// (the callback's data argument, as pthread_create's): the marker becomes
// the host entry of a host closure that runs that closure, and the
// closure's address that host closure's environment. False when a marker
// comes without a program closure or the host has no C entries.
عرف بدل_مداخل_سي_آلة(ب: &متغير برنامج_آلة, ح: &متغير حالة_آلة, الكلمات: &متغير متجه ط64): منطقي {
    دع ن: طبيعي = الطول(*الكلمات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        إذا ((*الكلمات)[ف] == علامة_مدخل_سي_آلة()) {
            دع وجد: متغير منطقي = خطأ;
            دع ي: متغير طبيعي = 0;
            طالما (ي < ن && !وجد) {
                دع الإغلاق: ط64 = (*الكلمات)[ي];
                إذا (ي != ف && الإغلاق != 0 && (الإغلاق & 7) == 0
                    && (اقرأ_آلة(ح, الإغلاق, 8) >> 48) == (قاعدة_مقابض_آلة() >> 48)) {
                    دع العنوان: ط64 = خيط_لإغلاق_آلة(ب, ح, الإغلاق);
                    إذا (العنوان == 0) { أرجع خطأ; };
                    دع الرمز: ط64 = مدخل_سي_مضيف(العنوان);
                    إذا (الرمز == 0) { أرجع خطأ; };
                    (*الكلمات)[ف] := الرمز;
                    (*الكلمات)[ي] := العنوان;
                    وجد := صواب;
                };
                ي := ي + 1;
            }
            إذا (!وجد) { أرجع خطأ; };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}
