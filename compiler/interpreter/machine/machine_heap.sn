// Storage of a program the machine interpreter runs: its heap (the storage
// services, box allocation and vector growth) and the region its frames and
// globals live in. Blocks come from size classes carved from large regions
// the host maps; every block is 16-byte aligned and has a 16-byte header
// whose first word is its class. A freed block goes back to its class's list
// and is reused; nothing returns to the host before the program ends, as a
// size-class allocator's arenas (Go's mcache, jemalloc's bins) keep theirs.
//
// Classes 1..64 hold 16 * class bytes (up to 1 KiB); class 64 + k holds
// 1024 << k bytes. The header's second word is a mark: release and
// reallocation act only on marked blocks, so static storage (literals,
// globals: class 0) and storage the program got elsewhere are left alone,
// as std's allocator leaves storage outside its heap (os/allocation.sn).
استورد compiler.interpreter.machine.raw_memory;
استورد compiler.interpreter.execution.host_memory;

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    // A fresh anonymous private mapping (zeroed), or 0 (mmap: 9 on
    // x86-64, 222 on AArch64; Android has Linux's numbers).
    عام عرف منطقة_مضيف_آلة(الحجم: ط64): ط64 {
        دع الرقم: متغير ط64 = 222;
        إذا (الهدف_معمارية_إكس_خام()) { الرقم := 9; };
        // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS (| MAP_NORESERVE).
        دع العنوان: متغير ط64 = 0;
        غير_آمن {
            العنوان := بدائي_نداء_نواة_خام(الرقم, 0 مثل ط64, الحجم, 3 مثل ط64, 0x4022 مثل ط64, ~(0 مثل ط64), 0 مثل ط64);
        }
        إذا (العنوان >= (~(0 مثل ط64)) - 4094) { أرجع 0; };
        أرجع العنوان;
    }

    // Releases a region منطقة_مضيف_آلة gave (munmap).
    عام عرف حرر_منطقة_مضيف_آلة(العنوان: ط64, الحجم: ط64): فراغ {
        إذا (العنوان == 0) { أرجع; };
        // munmap: 11 on x86-64, 215 on AArch64.
        دع الرقم: متغير ط64 = 215;
        إذا (الهدف_معمارية_إكس_خام()) { الرقم := 11; };
        غير_آمن {
            دع تجاهل: ط64 = بدائي_نداء_نواة_خام(الرقم, العنوان, الحجم, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64);
        }
    }
}
إذا (!((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))) {
    عام عرف منطقة_مضيف_آلة(الحجم: ط64): ط64 {
        أرجع خصص_ذاكرة_مضيف(الحجم مثل طبيعي);
    }

    عام عرف حرر_منطقة_مضيف_آلة(العنوان: ط64, الحجم: ط64): فراغ {
        حرر_ذاكرة_مضيف(العنوان);
    }
}

// The heap's state is a control block in host memory, so the engines of
// the program's threads (machine_engine.sn) share one heap through copies
// of this handle. Words: 0 the lock, 1 nonzero once a thread started (the
// lock is taken only then), 2..3 the unused tail of the current region,
// 4 bytes held (diagnostics), 5..8 the program's allocation counters
// (allocations, frees, reallocations, requested bytes), 16.. the free-list
// heads by class.
عام نوع كومة_آلة = {
    التحكم: ط64
};

عرف كلمات_تحكم_كومة_آلة(): ط64 { أرجع 16 + 128; }

عام عرف كومة_آلة_جديدة(): كومة_آلة {
    // Zeroed (an anonymous mapping, or the host's zeroing allocator).
    دع الناتج: كومة_آلة = { التحكم: منطقة_مضيف_آلة(كلمات_تحكم_كومة_آلة() * 8) };
    أرجع الناتج;
}

عرف كلمة_كومة_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة, الفهرس: ط64): ط64 {
    أرجع اقرأ_كلمة_محاذاة_خام(م, (*ك).التحكم + الفهرس * 8);
}

عرف ضع_كلمة_كومة_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة, الفهرس: ط64, القيمة: ط64): فراغ {
    اكتب_كلمة_محاذاة_خام(م, (*ك).التحكم + الفهرس * 8, القيمة);
}

// From the first thread start on, every heap operation holds the lock (a
// spin lock: the critical sections are a few loads and stores).
عام عرف شارك_كومة_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة): فراغ {
    ضع_كلمة_كومة_آلة(م, ك, 1, 1);
}

// Adds القيمة to counter word الفهرس (atomically once threads exist).
عام عرف أضف_لعداد_كومة_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة, الفهرس: ط64, القيمة: ط64): فراغ {
    إذا (كلمة_كومة_آلة(م, ك, 1) == 0) {
        ضع_كلمة_كومة_آلة(م, ك, الفهرس, كلمة_كومة_آلة(م, ك, الفهرس) + القيمة);
        أرجع;
    };
    دع ف: ط64 = فهرس_كلمة_خام(م, (*ك).التحكم + الفهرس * 8);
    طالما (صواب) {
        دع القديم: ط64 = احمل_كلمة_ذريا_خام(م, ف);
        إذا (قارن_وبدل_كلمة_خام(م, ف, القديم, القديم + القيمة) == القديم) { أرجع; };
    }
}

عام عرف عداد_كومة_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة, الفهرس: ط64): ط64 {
    أرجع احمل_كلمة_ذريا_خام(م, فهرس_كلمة_خام(م, (*ك).التحكم + الفهرس * 8));
}

// Whether a thread of the program was started.
عام عرف كومة_مشتركة_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة): منطقي {
    أرجع كلمة_كومة_آلة(م, ك, 1) != 0;
}

عرف اقفل_كومة_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة): فراغ {
    إذا (كلمة_كومة_آلة(م, ك, 1) == 0) { أرجع; };
    دع الفهرس: ط64 = فهرس_كلمة_خام(م, (*ك).التحكم);
    طالما (!احجز_كلمة_خام(م, الفهرس)) { }
}

عرف افتح_كومة_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة): فراغ {
    إذا (كلمة_كومة_آلة(م, ك, 1) == 0) { أرجع; };
    حرر_كلمة_خام(م, فهرس_كلمة_خام(م, (*ك).التحكم));
}

عرف صنف_حجم_آلة(الحجم: ط64): ط64 {
    إذا (الحجم <= 1024) {
        إذا (الحجم == 0) { أرجع 1; };
        أرجع (الحجم + 15) / 16;
    };
    دع الصنف: متغير ط64 = 64;
    دع السعة: متغير ط64 = 1024;
    طالما (السعة < الحجم) { السعة := السعة * 2; الصنف := الصنف + 1; }
    أرجع الصنف;
}

عرف سعة_صنف_آلة(الصنف: ط64): ط64 {
    إذا (الصنف <= 64) { أرجع الصنف * 16; };
    أرجع (1024 مثل ط64) << (الصنف - 64);
}

// A block of at least الحجم bytes, or 0 when the host has no more memory.
عام عرف خصص_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة, الحجم: ط64): ط64 {
    إذا (الحجم > ((1 مثل ط64) << 40)) { أرجع 0; };
    دع الصنف: ط64 = صنف_حجم_آلة(الحجم);
    اقفل_كومة_آلة(م, ك);
    دع الرأس: ط64 = كلمة_كومة_آلة(م, ك, 16 + الصنف);
    إذا (الرأس != 0) {
        ضع_كلمة_كومة_آلة(م, ك, 16 + الصنف, اقرأ_كلمة_محاذاة_خام(م, الرأس));
        اكتب_كلمة_محاذاة_خام(م, الرأس - 8, علامة_كتلة_آلة());
        افتح_كومة_آلة(م, ك);
        أرجع الرأس;
    };
    دع الكتلة: ط64 = 16 + سعة_صنف_آلة(الصنف);
    إذا (كلمة_كومة_آلة(م, ك, 3) - كلمة_كومة_آلة(م, ك, 2) < الكتلة) {
        دع حجم_المنطقة: متغير ط64 = 4194304;
        إذا (الكتلة > حجم_المنطقة) { حجم_المنطقة := الكتلة; };
        دع المنطقة: ط64 = منطقة_مضيف_آلة(حجم_المنطقة);
        إذا (المنطقة == 0) { افتح_كومة_آلة(م, ك); أرجع 0; };
        ضع_كلمة_كومة_آلة(م, ك, 2, المنطقة);
        ضع_كلمة_كومة_آلة(م, ك, 3, المنطقة + حجم_المنطقة);
    };
    دع البداية: ط64 = كلمة_كومة_آلة(م, ك, 2);
    ضع_كلمة_كومة_آلة(م, ك, 2, البداية + الكتلة);
    ضع_كلمة_كومة_آلة(م, ك, 4, كلمة_كومة_آلة(م, ك, 4) + الكتلة);
    افتح_كومة_آلة(م, ك);
    اكتب_كلمة_محاذاة_خام(م, البداية, الصنف);
    اكتب_كلمة_محاذاة_خام(م, البداية + 8, علامة_كتلة_آلة());
    أرجع البداية + 16;
}

عرف علامة_كتلة_آلة(): ط64 { أرجع 0x4B4C544B414C4141; }

// A block of this heap, live: aligned, marked, of a class.
عرف كتلة_حية_آلة(م: &ذاكرة_خام, العنوان: ط64): منطقي {
    إذا (العنوان < 16 || (العنوان & 15) != 0) { أرجع خطأ; };
    إذا (اقرأ_كلمة_محاذاة_خام(م, العنوان - 8) != علامة_كتلة_آلة()) { أرجع خطأ; };
    دع الصنف: ط64 = اقرأ_كلمة_محاذاة_خام(م, العنوان - 16);
    أرجع الصنف != 0 && الصنف < 128;
}

عام عرف حرر_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة, العنوان: ط64): فراغ {
    إذا (العنوان == 0 || !كتلة_حية_آلة(م, العنوان)) { أرجع; };
    دع الصنف: ط64 = اقرأ_كلمة_محاذاة_خام(م, العنوان - 16);
    // Unmarked while free, so a second release does nothing.
    اكتب_كلمة_محاذاة_خام(م, العنوان - 8, 0);
    اقفل_كومة_آلة(م, ك);
    اكتب_كلمة_محاذاة_خام(م, العنوان, كلمة_كومة_آلة(م, ك, 16 + الصنف));
    ضع_كلمة_كومة_آلة(م, ك, 16 + الصنف, العنوان);
    افتح_كومة_آلة(م, ك);
}

// realloc: the block keeps its address while الحجم fits its class.
عام عرف أعد_تخصيص_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة, العنوان: ط64, الحجم: ط64): ط64 {
    إذا (العنوان == 0) { أرجع خصص_آلة(م, ك, الحجم); };
    // Static storage cannot grow: 0, which the code traps on (as std's).
    إذا (!كتلة_حية_آلة(م, العنوان)) { أرجع 0; };
    دع الصنف: ط64 = اقرأ_كلمة_محاذاة_خام(م, العنوان - 16);
    دع السعة: ط64 = سعة_صنف_آلة(الصنف);
    إذا (الحجم <= السعة) { أرجع العنوان; };
    دع الجديد: ط64 = خصص_آلة(م, ك, الحجم);
    إذا (الجديد == 0) { أرجع 0; };
    انسخ_خام(م, الجديد, العنوان, السعة);
    حرر_آلة(م, ك, العنوان);
    أرجع الجديد;
}

// A zeroed block (the region's storage is reused, so it is cleared).
عام عرف خصص_مصفرا_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة, الحجم: ط64): ط64 {
    دع العنوان: ط64 = خصص_آلة(م, ك, الحجم);
    إذا (العنوان != 0) { املأ_صفرا_خام(م, العنوان, الحجم); };
    أرجع العنوان;
}

// Static storage (literals, globals): zeroed, never released or grown.
عام عرف خصص_ثابتا_آلة(م: &ذاكرة_خام, ك: &متغير كومة_آلة, الحجم: ط64): ط64 {
    دع العنوان: ط64 = خصص_مصفرا_آلة(م, ك, الحجم);
    إذا (العنوان != 0) {
        اكتب_كلمة_محاذاة_خام(م, العنوان - 16, 0);
        اكتب_كلمة_محاذاة_خام(م, العنوان - 8, 0);
    };
    أرجع العنوان;
}
