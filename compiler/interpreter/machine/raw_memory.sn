// Raw host memory for the machine interpreter (machine_engine.sn).
//
// The machine interpreter runs a program on the host's own memory, with the
// layouts the compiled program has, so every load and store is a host load or
// store. The compiler's sources may use only what the C Stage0 (bootstrap/)
// compiles: no machine-memory intrinsic and no integer-to-pointer cast. A
// raw pointer to 64-bit words made from a reference or returned by a C
// function is allowed, and so is indexing it. So all of memory is reached
// through one pointer ق to a 64-bit word whose address أ is known: the word at
// address X (X a multiple of 8) is ق[(X - أ) / 8], with wrapping arithmetic.
// Narrower and unaligned accesses are composed from the aligned words that
// hold them, as a 64-bit-only memory port would (a narrow store rewrites the
// whole word it falls in). The program's threads each run an engine on a
// host thread of their own; the program's atomic operations are host atomic
// operations on the aligned word that holds the operand (a compare-and-swap
// loop for a narrower one), so a narrow store racing an atomic update of a
// neighbouring field of the same word is the one access not made exact.
//
// The known address comes from the host:
//   Linux, Android
//            ق points into a vector the interpreter owns; its address is
//            learned once by writing the pointer through a pipe and reading
//            it back as a word (raw system calls, as the rest of the
//            compiler's Linux host code uses).
//   macOS, Windows
//            ق is returned by the C library's memset with a zero count,
//            which returns its first argument (the identity host_memory.sn
//            uses with memmove and memcpy).
// Elsewhere there is no raw memory port and the machine interpreter is not
// used.

مرادف طرح_ملتف_آلة = بدائي_طرح_ملتف;
مرادف جمع_ملتف_آلة = بدائي_جمع_ملتف;
مرادف إزاحة_يسرى_آلة = بدائي_إزاحة_يسرى_ملتفة;
مرادف قارن_وبدل_ذري_خام = بدائي_ذري_قارن_وبدل;
مرادف احمل_ذري_خام = بدائي_ذري_حمل;
مرادف خزن_ذري_خام = بدائي_ذري_خزن;
مرادف سياج_ذري_خام = بدائي_سياج_ذاكرة;

عام نوع ذاكرة_خام = {
    // A word pointer at the known address أ.
    ق: *متغير ط64,
    أ: ط64,
    // Keeps the vector ق points into alive (Linux).
    الحامل: متجه ط64,
    متاحة: منطقي
};

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    // pipe2, write, read, close.
    عرف رقم_نداء_ذاكرة_خام(الفهرس: طبيعي): ط64 {
        إذا (الهدف_معمارية_إكس_خام()) {
            إذا (الفهرس == 0) { أرجع 293; };
            إذا (الفهرس == 1) { أرجع 1; };
            إذا (الفهرس == 2) { أرجع 0; };
            أرجع 3;
        };
        إذا (الفهرس == 0) { أرجع 59; };
        إذا (الفهرس == 1) { أرجع 64; };
        إذا (الفهرس == 2) { أرجع 63; };
        أرجع 57;
    }

    عام عرف هيئ_ذاكرة_خام(): ذاكرة_خام {
        دع الحامل: متغير متجه ط64 = [0, 0, 0, 0];
        دع المؤشر: *متغير ط64 = &متغير الحامل[0];
        دع الحاوية: متغير متجه *متغير ط64 = [المؤشر];
        // A raw pointer to the vector's word holding المؤشر: the kernel
        // copies those 8 bytes, the pointer's address, into the pipe.
        دع موضع_الحاوية: *متغير *متغير ط64 = &متغير الحاوية[0];
        دع الأنبوب: متغير متجه ص32 = [0, 0];
        دع المقروء: متغير متجه ط64 = [0];
        دع ن: متغير ط64 = 0;
        غير_آمن {
            ن := بدائي_نداء_نواة_خام(رقم_نداء_ذاكرة_خام(0), &متغير الأنبوب[0], 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64);
        }
        دع متاحة: متغير منطقي = ن == 0;
        إذا (متاحة) {
            دع القارئ: ط64 = (الأنبوب[0] مثل ص64) مثل ط64;
            دع الكاتب: ط64 = (الأنبوب[1] مثل ص64) مثل ط64;
            دع ك: متغير ط64 = 0;
            دع ق: متغير ط64 = 0;
            غير_آمن {
                ك := بدائي_نداء_نواة_خام(رقم_نداء_ذاكرة_خام(1), الكاتب, موضع_الحاوية, 8 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64);
                ق := بدائي_نداء_نواة_خام(رقم_نداء_ذاكرة_خام(2), القارئ, &متغير المقروء[0], 8 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64);
                دع م1: ط64 = بدائي_نداء_نواة_خام(رقم_نداء_ذاكرة_خام(3), القارئ, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64);
                دع م2: ط64 = بدائي_نداء_نواة_خام(رقم_نداء_ذاكرة_خام(3), الكاتب, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64);
            }
            متاحة := ك == 8 && ق == 8 && المقروء[0] != 0;
        };
        دع الناتج: ذاكرة_خام = {
            ق: المؤشر, أ: المقروء[0], الحامل: الحامل, متاحة: متاحة
        };
        أرجع الناتج;
    }
}
// Linux and Android hosts: whether the kernel numbering is x86-64's (else
// AArch64's).
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية == «x86_64») {
    عام عرف الهدف_معمارية_إكس_خام(): منطقي { أرجع صواب; }
}
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية == «aarch64») {
    عام عرف الهدف_معمارية_إكس_خام(): منطقي { أرجع خطأ; }
}

إذا (الهدف.المنصة == «macos») {
    خارجي «/usr/lib/libSystem.B.dylib» عرف آلة_memset(الوجهة: ط64, القيمة: ص32, العدد: ط64): *متغير ط64 = «memset»;
}
إذا (الهدف.المنصة == «windows») {
    خارجي «ntdll.dll» عرف آلة_memset(الوجهة: ط64, القيمة: ص32, العدد: ط64): *متغير ط64 = «memset»;
}
إذا (الهدف.المنصة == «macos» || الهدف.المنصة == «windows») {
    عام عرف هيئ_ذاكرة_خام(): ذاكرة_خام {
        // Any nonzero multiple of 8; memset touches nothing with a zero count.
        دع الأساس: ط64 = 4096;
        دع الحامل: متجه ط64 = [];
        دع الناتج: ذاكرة_خام = {
            ق: آلة_memset(الأساس, 0, 0), أ: الأساس, الحامل: الحامل, متاحة: صواب
        };
        أرجع الناتج;
    }
}
إذا (!(((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»))
    || الهدف.المنصة == «macos» || الهدف.المنصة == «windows»)) {
    عام عرف هيئ_ذاكرة_خام(): ذاكرة_خام {
        دع الحامل: متغير متجه ط64 = [0];
        دع المؤشر: *متغير ط64 = &متغير الحامل[0];
        دع الناتج: ذاكرة_خام = { ق: المؤشر, أ: 0, الحامل: الحامل, متاحة: خطأ };
        أرجع الناتج;
    }
}

// The index of the aligned word at العنوان (a multiple of 8).
عام عرف فهرس_كلمة_خام(م: &ذاكرة_خام, العنوان: ط64): ط64 {
    أرجع طرح_ملتف_آلة(العنوان, (*م).أ) >> 3;
}

// Atomic operations on the word at index الفهرس (sequentially consistent).
// Compare-and-swap answers the word's previous value.
عام عرف قارن_وبدل_كلمة_خام(م: &ذاكرة_خام, الفهرس: ط64, المتوقع: ط64, الجديد: ط64): ط64 {
    دع ق: *متغير ط64 = (*م).ق;
    دع الناتج: متغير ط64 = 0;
    غير_آمن { الناتج := قارن_وبدل_ذري_خام(&ق[الفهرس], المتوقع, الجديد, 4 مثل ط32, 4 مثل ط32); }
    أرجع الناتج;
}

عام عرف احمل_كلمة_ذريا_خام(م: &ذاكرة_خام, الفهرس: ط64): ط64 {
    دع ق: *متغير ط64 = (*م).ق;
    دع الناتج: متغير ط64 = 0;
    غير_آمن { الناتج := احمل_ذري_خام(&ق[الفهرس], 4 مثل ط32); }
    أرجع الناتج;
}

عام عرف خزن_كلمة_ذريا_خام(م: &ذاكرة_خام, الفهرس: ط64, القيمة: ط64): فراغ {
    دع ق: *متغير ط64 = (*م).ق;
    غير_آمن { خزن_ذري_خام(&ق[الفهرس], القيمة, 4 مثل ط32); }
}

عام عرف سياج_خام(): فراغ { سياج_ذري_خام(4 مثل ط32); }

// A spin lock word: taken when it goes from 0 to 1.
عام عرف احجز_كلمة_خام(م: &ذاكرة_خام, الفهرس: ط64): منطقي {
    أرجع قارن_وبدل_كلمة_خام(م, الفهرس, 0, 1) == 0;
}

عام عرف حرر_كلمة_خام(م: &ذاكرة_خام, الفهرس: ط64): فراغ {
    خزن_كلمة_ذريا_خام(م, الفهرس, 0);
}

عام عرف اقرأ_كلمة_محاذاة_خام(م: &ذاكرة_خام, العنوان: ط64): ط64 {
    دع ف: ط64 = طرح_ملتف_آلة(العنوان, (*م).أ) >> 3;
    دع ق: *متغير ط64 = (*م).ق;
    دع الناتج: متغير ط64 = 0;
    غير_آمن { الناتج := ق[ف]; }
    أرجع الناتج;
}

عام عرف اكتب_كلمة_محاذاة_خام(م: &ذاكرة_خام, العنوان: ط64, القيمة: ط64): فراغ {
    دع ف: ط64 = طرح_ملتف_آلة(العنوان, (*م).أ) >> 3;
    دع ق: *متغير ط64 = (*م).ق;
    غير_آمن { ق[ف] := القيمة; }
}

عام عرف قناع_بايتات_خام(العدد: ط64): ط64 {
    إذا (العدد >= 8) { أرجع ~(0 مثل ط64); };
    أرجع (((1 مثل ط64) << (العدد * 8)) - 1);
}

// The العدد (1 to 8) bytes at العنوان, little-endian, zero-extended.
عام عرف اقرأ_خام(م: &ذاكرة_خام, العنوان: ط64, العدد: ط64): ط64 {
    دع ز: ط64 = العنوان & 7;
    دع البداية: ط64 = العنوان - ز;
    دع الأول: ط64 = اقرأ_كلمة_محاذاة_خام(م, البداية);
    إذا (ز == 0) {
        إذا (العدد >= 8) { أرجع الأول; };
        أرجع الأول & قناع_بايتات_خام(العدد);
    };
    دع المنخفض: ط64 = الأول >> (ز * 8);
    إذا (ز + العدد <= 8) { أرجع المنخفض & قناع_بايتات_خام(العدد); };
    دع الثاني: ط64 = اقرأ_كلمة_محاذاة_خام(م, جمع_ملتف_آلة(البداية, 8));
    دع الكل: ط64 = المنخفض | إزاحة_يسرى_آلة(الثاني, (8 - ز) * 8);
    أرجع الكل & قناع_بايتات_خام(العدد);
}

// Stores the low العدد (1 to 8) bytes of القيمة at العنوان.
عام عرف اكتب_خام(م: &ذاكرة_خام, العنوان: ط64, العدد: ط64, القيمة: ط64): فراغ {
    دع ز: ط64 = العنوان & 7;
    دع البداية: ط64 = العنوان - ز;
    إذا (ز == 0 && العدد >= 8) { اكتب_كلمة_محاذاة_خام(م, البداية, القيمة); أرجع; };
    دع القناع: ط64 = قناع_بايتات_خام(العدد);
    دع ق: ط64 = القيمة & القناع;
    دع الأول: ط64 = اقرأ_كلمة_محاذاة_خام(م, البداية);
    إذا (ز + العدد <= 8) {
        دع مزاح: ط64 = القناع << (ز * 8);
        اكتب_كلمة_محاذاة_خام(م, البداية, (الأول & ~مزاح) | (ق << (ز * 8)));
        أرجع;
    };
    // The bytes span two words.
    دع في_الأول: ط64 = 8 - ز;
    دع قناع_الأول: ط64 = قناع_بايتات_خام(في_الأول) << (ز * 8);
    اكتب_كلمة_محاذاة_خام(م, البداية, (الأول & ~قناع_الأول) | إزاحة_يسرى_آلة(ق, ز * 8));
    دع التالي: ط64 = جمع_ملتف_آلة(البداية, 8);
    دع الثاني: ط64 = اقرأ_كلمة_محاذاة_خام(م, التالي);
    دع الباقي: ط64 = العدد - في_الأول;
    دع قناع_الثاني: ط64 = قناع_بايتات_خام(الباقي);
    اكتب_كلمة_محاذاة_خام(م, التالي, (الثاني & ~قناع_الثاني) | (ق >> (في_الأول * 8)));
}

// memmove: العدد bytes from المصدر to الوجهة; the ranges may overlap.
عام عرف انسخ_خام(م: &ذاكرة_خام, الوجهة: ط64, المصدر: ط64, العدد: ط64): فراغ {
    إذا (العدد == 0 || الوجهة == المصدر) { أرجع; };
    دع للخلف: منطقي = الوجهة > المصدر && الوجهة < جمع_ملتف_آلة(المصدر, العدد);
    إذا (((الوجهة | المصدر | العدد) & 7) == 0) {
        دع ق: *متغير ط64 = (*م).ق;
        دع فو: ط64 = طرح_ملتف_آلة(الوجهة, (*م).أ) >> 3;
        دع فم: ط64 = طرح_ملتف_آلة(المصدر, (*م).أ) >> 3;
        دع ن: ط64 = العدد >> 3;
        إذا (للخلف) {
            دع ف: متغير ط64 = ن;
            طالما (ف > 0) {
                ف := ف - 1;
                غير_آمن { ق[جمع_ملتف_آلة(فو, ف)] := ق[جمع_ملتف_آلة(فم, ف)]; }
            }
        } وإلا {
            دع ف: متغير ط64 = 0;
            طالما (ف < ن) {
                غير_آمن { ق[جمع_ملتف_آلة(فو, ف)] := ق[جمع_ملتف_آلة(فم, ف)]; }
                ف := ف + 1;
            }
        };
        أرجع;
    };
    إذا (للخلف) {
        دع ف: متغير ط64 = العدد;
        طالما (ف > 0) {
            دع الجزء: متغير ط64 = 8;
            إذا (ف < 8) { الجزء := ف; };
            ف := ف - الجزء;
            اكتب_خام(م, جمع_ملتف_آلة(الوجهة, ف), الجزء, اقرأ_خام(م, جمع_ملتف_آلة(المصدر, ف), الجزء));
        }
    } وإلا {
        دع ف: متغير ط64 = 0;
        طالما (ف < العدد) {
            دع الجزء: متغير ط64 = العدد - ف;
            إذا (الجزء > 8) { الجزء := 8; };
            اكتب_خام(م, جمع_ملتف_آلة(الوجهة, ف), الجزء, اقرأ_خام(م, جمع_ملتف_آلة(المصدر, ف), الجزء));
            ف := ف + الجزء;
        }
    };
}

عام عرف املأ_صفرا_خام(م: &ذاكرة_خام, العنوان: ط64, العدد: ط64): فراغ {
    دع ف: متغير ط64 = 0;
    طالما (ف < العدد) {
        دع الجزء: متغير ط64 = العدد - ف;
        إذا (الجزء > 8) { الجزء := 8; };
        اكتب_خام(م, جمع_ملتف_آلة(العنوان, ف), الجزء, 0);
        ف := ف + الجزء;
    }
}

// The bytes [العنوان, العنوان + العدد) as a vector.
عام عرف بايتات_من_خام(م: &ذاكرة_خام, العنوان: ط64, العدد: ط64): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    احجز_سعة(الناتج, العدد مثل طبيعي);
    دع ف: متغير ط64 = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, (اقرأ_خام(م, جمع_ملتف_آلة(العنوان, ف), 1) & 255) مثل ط8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف اكتب_بايتات_خام(م: &ذاكرة_خام, العنوان: ط64, البايتات: &متجه ط8): فراغ {
    دع ن: ط64 = الطول(*البايتات) مثل ط64;
    دع ف: متغير ط64 = 0;
    طالما (ف < ن) {
        دع الجزء: متغير ط64 = ن - ف;
        إذا (الجزء > 8) { الجزء := 8; };
        دع الكلمة: متغير ط64 = 0;
        دع ب: متغير ط64 = 0;
        طالما (ب < الجزء) {
            الكلمة := الكلمة | (((*البايتات)[(ف + ب) مثل طبيعي] مثل ط64) << (ب * 8));
            ب := ب + 1;
        }
        اكتب_خام(م, جمع_ملتف_آلة(العنوان, ف), الجزء, الكلمة);
        ف := ف + الجزء;
    }
}
