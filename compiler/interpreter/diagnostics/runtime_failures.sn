    | مكان_للقراءة_فقط بنوع معرف_قيمة_مسير
    | محاولة_كتابة_مكان_للقراءة_فقط
    | جذر_مكان_تالف
    | إسقاط_مكان_تالف بنوع غير_موقع
    | مرجع_تالف بنوع معرف_قيمة_مسير
    | صندوق_تالف بنوع غير_موقع
    | قيمة_صندوق_متوقعة بنوع معرف_قيمة_مسير
    | قيمة_صحيح_متوقعة بنوع معرف_قيمة_مسير
    | قيمة_تجميع_متوقعة بنوع معرف_قيمة_مسير
    | قيمة_نص_متوقعة بنوع معرف_قيمة_مسير
    | قيمة_موسومة_متوقعة بنوع معرف_قيمة_مسير
    | منشئ_موسوم_غير_مطابق بنوع (غير_موقع, غير_موقع)
    | حمولة_موسومة_خارج_المدى بنوع (غير_موقع, غير_موقع)
    | قيمة_منطقية_متوقعة بنوع معرف_قيمة_مسير
    | نص_يوتيف8_غير_صالح بنوع (معرف_قيمة_مسير, غير_موقع)
    | عدد_حجج_بدائي_غير_متسق بنوع (هوية_بدائي_مترجم, غير_موقع, غير_موقع)
    | حجة_بدائي_غير_صالحة بنوع (هوية_بدائي_مترجم, غير_موقع)
    | جسر_نص_مضيف_غير_متاح بنوع هوية_بدائي_مترجم
    | بدائي_مضيف_غير_مدعوم بنوع هوية_بدائي_مترجم
    | فهرس_وسيط_عملية_خارج_المدى بنوع غير_موقع
;

عام نوع خلل_داخلي_مفسر =
    | دالة_مفقودة بنوع معرف_دالة_مسير
    | كتلة_مفقودة بنوع معرف_كتلة_مسير
    | تعليمة_مفقودة بنوع (معرف_كتلة_مسير, غير_موقع)
    | منهي_مفقود بنوع معرف_كتلة_مسير
    | قيمة_مسير_مفقودة بنوع معرف_قيمة_مسير
    | معرف_خانة_من_دالة_أخرى بنوع (معرف_دالة_مسير, معرف_قيمة_مسير)
    | معرف_خانة_خارج_المدى بنوع معرف_قيمة_مسير
    | معامل_دالة_مفقود بنوع (معرف_دالة_مسير, غير_موقع)
    | معامل_كتلة_مفقود بنوع (معرف_كتلة_مسير, غير_موقع)
    | عدد_حجج_غير_متسق بنوع (غير_موقع, غير_موقع)
    | مدخل_دالة_مفقود بنوع معرف_دالة_مسير
    | مكدس_نداءات_فارغ
    | تفعيل_مفقود بنوع غير_موقع
    | شكل_إرجاع_غير_متسق بنوع معرف_دالة_مسير
