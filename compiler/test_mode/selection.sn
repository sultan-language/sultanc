استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.schema;
استورد compiler.test_mode.discovery;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.بيئة.بيئة_العمل;

// Which discovered tests `sultanc test` runs (docs/en/reference/testing.md):
// every one of --filter (a text one spelling of the name contains), --test
// (names one spelling equals one of) and --tests-in (the files a test is
// declared in) must match. A --test name no test has, and a --tests-in file
// that is not a source of the program, are errors
// (SULTANC-TEST-NOT-FOUND, SULTANC-TEST-FILE-NOT-IN-PROGRAM).

عام نوع نتيجة_اختيار_اختبارات =
    | مختارة بنوع متجه منطقي
    | مرفوضة بنوع مجموعة_تشخيصات
;

عرف تهجئة_تحوي(المكتشف: &اختبار_مكتشف, النص: &نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المكتشف).التهجئات) مثل طبيعي)) {
        إذا (يحتوي_نصا(&(*المكتشف).التهجئات[ف], النص)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف تهجئة_تساوي_أحدها(المكتشف: &اختبار_مكتشف, الأسماء: &متجه نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المكتشف).التهجئات) مثل طبيعي)) {
        ليكن س: متغير طبيعي = 0;
        طالما (س < (الطول(*الأسماء) مثل طبيعي)) {
            إذا (نصان_متساويان(&(*المكتشف).التهجئات[ف], &(*الأسماء)[س])) { أرجع صواب; };
            س := س + 1;
        }
        ف := ف + 1;
    }
    أرجع خطأ;
}

// A path cleaned lexically as the loader cleans source paths, and the same
// path made absolute against the current directory.
عرف مسار_مطلق_منظف(المسار: &نص, الدليل: &نص): نص {
    إذا (مسار_مطلق(المسار) || (الطول(*الدليل) مثل طبيعي) == 0) { أرجع نظف_المسار(المسار); };
    ليكن الموصول: نص = صل_المسار(الدليل, المسار);
    أرجع نظف_المسار(&الموصول);
}

عرف مساران_متساويان(أ: &نص, ب: &نص, الدليل: &نص): منطقي {
    ليكن نظيف_أ: نص = نظف_المسار(أ);
    ليكن نظيف_ب: نص = نظف_المسار(ب);
    إذا (نصان_متساويان(&نظيف_أ, &نظيف_ب)) { أرجع صواب; };
    ليكن مطلق_أ: نص = مسار_مطلق_منظف(أ, الدليل);
    ليكن مطلق_ب: نص = مسار_مطلق_منظف(ب, الدليل);
    أرجع نصان_متساويان(&مطلق_أ, &مطلق_ب);
}

عرف تشخيص_اختيار(المعرف: معرف_تشخيص, المفتاح: مفتاح_حجة_تشخيص, القيمة: &نص, المجموعة: &متغير مجموعة_تشخيصات): فراغ {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختياري.لا_شيء());
    ليكن أضيفت: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, المفتاح, انسخ_نص(القيمة));
    أصدر_تشخيصا(المجموعة, &التشخيص);
}

عام عرف اختر_اختبارات(
    المكتشفة: &متجه اختبار_مكتشف,
    الخريطة: &خريطة_مصادر,
    المرشح: &نص,
    الأسماء: &متجه نص,
    الملفات: &متجه نص
): نتيجة_اختيار_اختبارات {
    ليكن الدليل: متغير نص = «»;
    طابق دليل_العمل() مع
    | نتيجة.نجح(المسار) -> { الدليل := المسار; }
    | نتيجة.خطأ(_) -> { };
    ليكن الأخطاء: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن أخطاء: متغير منطقي = خطأ;
    ليكن س: متغير طبيعي = 0;
    طالما (س < (الطول(*الأسماء) مثل طبيعي)) {
        ليكن موجود_الاسم: متغير منطقي = خطأ;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*المكتشفة) مثل طبيعي) && !موجود_الاسم) {
            ليكن وحيد: متغير متجه نص = [];
            ألحق(وحيد, انسخ_نص(&(*الأسماء)[س]));
            موجود_الاسم := تهجئة_تساوي_أحدها(&(*المكتشفة)[ف], &وحيد);
            ف := ف + 1;
        }
        إذا (!موجود_الاسم) {
            تشخيص_اختيار(معرف_تشخيص.اختبار_غير_موجود(), مفتاح_حجة_تشخيص.القيمة(), &(*الأسماء)[س], &متغير الأخطاء);
            أخطاء := صواب;
        };
        س := س + 1;
    }
    // Each --tests-in file, as a source of the program.
    ليكن أدلة_الملفات: متغير متجه اختياري طبيعي = [];
    س := 0;
    طالما (س < (الطول(*الملفات) مثل طبيعي)) {
        ليكن المعرف: متغير اختياري طبيعي = اختياري.لا_شيء();
        ليكن م: متغير طبيعي = 0;
        طالما (م < (الطول((*الخريطة).المصادر) مثل طبيعي)) {
            إذا (مساران_متساويان(&(*الخريطة).المصادر[م].الاسم, &(*الملفات)[س], &الدليل)) {
                المعرف := اختياري.موجود(م);
            };
            م := م + 1;
        }
        طابق المعرف مع
        | اختياري.لا_شيء -> {
            تشخيص_اختيار(معرف_تشخيص.ملف_اختبارات_خارج_البرنامج(), مفتاح_حجة_تشخيص.المسار(), &(*الملفات)[س], &متغير الأخطاء);
            أخطاء := صواب;
        }
        | اختياري.موجود(_) -> { };
        ألحق(أدلة_الملفات, المعرف);
        س := س + 1;
    }
    إذا (أخطاء) { أرجع نتيجة_اختيار_اختبارات.مرفوضة(الأخطاء); };
    ليكن المختارة: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المكتشفة) مثل طبيعي)) {
        ليكن المكتشف: &اختبار_مكتشف = &(*المكتشفة)[ف];
        ليكن مختار: متغير منطقي = صواب;
        إذا ((الطول(*المرشح) مثل طبيعي) > 0 && !تهجئة_تحوي(المكتشف, المرشح)) { مختار := خطأ; };
        إذا ((الطول(*الأسماء) مثل طبيعي) > 0 && !تهجئة_تساوي_أحدها(المكتشف, الأسماء)) { مختار := خطأ; };
        إذا ((الطول(أدلة_الملفات) مثل طبيعي) > 0) {
            ليكن في_ملف: متغير منطقي = خطأ;
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(أدلة_الملفات) مثل طبيعي)) {
                طابق أدلة_الملفات[م] مع
                | اختياري.موجود(المصدر) -> {
                    إذا ((*المكتشف).نطاق_الاسم.البداية.المصدر مثل طبيعي == المصدر) { في_ملف := صواب; };
                }
                | اختياري.لا_شيء -> { };
                م := م + 1;
            }
            إذا (!في_ملف) { مختار := خطأ; };
        };
        ألحق(المختارة, مختار);
        ف := ف + 1;
    }
    أرجع نتيجة_اختيار_اختبارات.مختارة(المختارة);
}
