استورد compiler.source.span;
استورد compiler.source.provenance;
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_builder;
استورد compiler.msir.debug_contract;
استورد compiler.frontend.types.type_identity;
استورد compiler.test_mode.discovery;
استورد compiler.test_mode.validation;
استورد compiler.frontend.annotations.definition_decorators;
استورد المكتبة.نصوص.من_بايتات;

// The test harness of `sultanc test` (docs/en/reference/testing.md), built in
// MSIR: no SultanC text is generated. After lowering, the driver hands the
// program, its debug data, the discovered tests, their verdicts
// (test_mode/validation.sn, applied before lowering) and which are selected.
// Each selected test is matched to the MSIR function lowered from its
// declaration (the debug name and an origin covering the declared name). The
// program's entry becomes a synthesized function:
//
//   the module's owned-global initializer, when lowering left it to the entry;
//   the registration functions of definition-time decorators, in the order a
//     build's entry calls them before main's body;
//   for each selected test i, in discovery order:
//       if اختبار_مطلوب_تشغيله(i) { [r :=] test_i(); return 0 or أنه_نتيجة_اختبار(r) }
//   return 2
//
// The driver runs the executable once per test with the index as its
// argument. The user's own entry, if any, is not called: an ordinary build is
// unchanged, and only this entry reaches the tests.

عام نوع اختبار_مجهز = {
    الاسم: نص,
    الدالة: معرف_دالة_مسير
};

عام نوع نتيجة_تجهيز_اختبارات =
    | جاهزة بنوع متجه اختبار_مجهز
    // std.testing.harness is not in the program (a compiler fault).
    | بلا_مكتبة
    | فشل_بناء
;

عرف اسم_دالة_مسير_يساوي(التصحيح: &بيانات_تصحيح_مسير, الدالة: معرف_دالة_مسير, الاسم: &متجه ط8): منطقي {
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, الدالة) مع
    | اختياري.موجود(المعرف) -> {
        إذا (المعرف.القيمة >= (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) { أرجع خطأ; };
        دع المسجل: &متجه ط8 = &(*التصحيح).الدلالي.الدوال[المعرف.القيمة].الاسم;
        إذا ((الطول(*المسجل) مثل طبيعي) != (الطول(*الاسم) مثل طبيعي)) { أرجع خطأ; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
            إذا ((*المسجل)[ف] != (*الاسم)[ف]) { أرجع خطأ; };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Whether the function's declaration (its debug origin) covers نطاق_الاسم.
عرف أصل_يغطي(التصحيح: &بيانات_تصحيح_مسير, الأصول: &سجل_أصول_مصدر, الدالة: معرف_دالة_مسير, النطاق: نطاق): منطقي {
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, الدالة) مع
    | اختياري.موجود(المعرف) -> {
        إذا (المعرف.القيمة >= (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) { أرجع خطأ; };
        طابق أصل_مصدر_بالمعرف(الأصول, (*التصحيح).الدلالي.الدوال[المعرف.القيمة].الأصل) مع
        | اختياري.موجود(الأصل) -> {
            أرجع الأصل.النطاق.البداية.المصدر == النطاق.البداية.المصدر
                && الأصل.النطاق.البداية.البايت <= النطاق.البداية.البايت
                && النطاق.النهاية.البايت <= الأصل.النطاق.النهاية.البايت;
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Whether the function's debug name starts with البادئة.
عرف اسم_دالة_مسير_يبدأ_بـ(التصحيح: &بيانات_تصحيح_مسير, الدالة: معرف_دالة_مسير, البادئة: &متجه ط8): منطقي {
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, الدالة) مع
    | اختياري.موجود(المعرف) -> {
        إذا (المعرف.القيمة >= (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) { أرجع خطأ; };
        دع المسجل: &متجه ط8 = &(*التصحيح).الدلالي.الدوال[المعرف.القيمة].الاسم;
        إذا ((الطول(*المسجل) مثل طبيعي) <= (الطول(*البادئة) مثل طبيعي)) { أرجع خطأ; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*البادئة) مثل طبيعي)) {
            إذا ((*المسجل)[ف] != (*البادئة)[ف]) { أرجع خطأ; };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The registration functions of definition-time decorators
// (frontend/annotations/definition_decorators.sn بادئة_مسجل_تعريف), in the
// order lowering emitted them: the order a build's entry calls them in
// (msir/semantic_lowering.sn مسجلات_التعريف_مسير, module then declaration
// order).
عرف مسجلات_تعريف_البرنامج(البرنامج: &برنامج_مسير, التصحيح: &بيانات_تصحيح_مسير): متجه معرف_دالة_مسير {
    دع الناتج: متغير متجه معرف_دالة_مسير = [];
    دع البادئة: متجه ط8 = بايتات_من_نص(بادئة_مسجل_تعريف());
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع المعرف: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
        طابق (*البرنامج).الدوال[د].المدخل مع
        | اختياري.موجود(_) -> {
            إذا ((الطول((*البرنامج).الدوال[د].المعاملات) مثل طبيعي) == 0
                && اسم_دالة_مسير_يبدأ_بـ(التصحيح, المعرف, &البادئة)) {
                ألحق(الناتج, المعرف);
            };
        }
        | اختياري.لا_شيء -> { };
        د := د + 1;
    }
    أرجع الناتج;
}

// The first MSIR function with a body named الاسم (and, with a span, whose
// declaration covers it).
عرف دالة_بالاسم(
    البرنامج: &برنامج_مسير, التصحيح: &بيانات_تصحيح_مسير, الأصول: &سجل_أصول_مصدر,
    الاسم: نص, النطاق: اختياري نطاق
): اختياري معرف_دالة_مسير {
    دع البايتات: متجه ط8 = بايتات_من_نص(الاسم);
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع المعرف: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
        طابق (*البرنامج).الدوال[د].المدخل مع
        | اختياري.موجود(_) -> {
            إذا (اسم_دالة_مسير_يساوي(التصحيح, المعرف, &البايتات)) {
                طابق النطاق مع
                | اختياري.لا_شيء -> { أرجع اختياري.موجود(المعرف); }
                | اختياري.موجود(ن) -> {
                    إذا (أصل_يغطي(التصحيح, الأصول, المعرف, ن)) { أرجع اختياري.موجود(المعرف); };
                };
            };
        }
        | اختياري.لا_شيء -> { };
        د := د + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ناتجان_متساويان(أ: اختياري معرف_نوع, ب: اختياري معرف_نوع): منطقي {
    طابق أ مع
    | اختياري.لا_شيء -> {
        طابق ب مع
        | اختياري.لا_شيء -> { أرجع صواب; }
        | اختياري.موجود(_) -> { أرجع خطأ; };
    }
    | اختياري.موجود(س) -> {
        طابق ب مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(ص) -> { أرجع معرفا_نوع_متساويان(س, ص); };
    };
}

// Matches the selected tests to their MSIR functions, then gives the
// program the synthesized entry.
عام عرف جهز_برنامج_اختبار(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &بيانات_تصحيح_مسير,
    الأصول: &سجل_أصول_مصدر,
    المكتشفة: &متجه اختبار_مكتشف,
    // Each discovered test's verdict (test_mode/validation.sn), and whether
    // it is selected.
    الأحكام: &متجه حكم_اختبار,
    المختارة: &متجه منطقي
): نتيجة_تجهيز_اختبارات {
    دع بلا_نطاق: اختياري نطاق = اختياري.لا_شيء();
    دع دالة_المطلوب: معرف_دالة_مسير;
    دع دالة_النهاية: معرف_دالة_مسير;
    دع دالة_الفراغ: معرف_دالة_مسير;
    طابق دالة_بالاسم(البرنامج, التصحيح, الأصول, «اختبار_مطلوب_تشغيله», بلا_نطاق) مع
    | اختياري.موجود(م) -> { دالة_المطلوب := م; }
    | اختياري.لا_شيء -> { أرجع نتيجة_تجهيز_اختبارات.بلا_مكتبة(); };
    طابق دالة_بالاسم(البرنامج, التصحيح, الأصول, «أنه_نتيجة_اختبار», بلا_نطاق) مع
    | اختياري.موجود(م) -> { دالة_النهاية := م; }
    | اختياري.لا_شيء -> { أرجع نتيجة_تجهيز_اختبارات.بلا_مكتبة(); };
    طابق دالة_بالاسم(البرنامج, التصحيح, الأصول, «اختبار_بلا_ناتج», بلا_نطاق) مع
    | اختياري.موجود(م) -> { دالة_الفراغ := م; }
    | اختياري.لا_شيء -> { أرجع نتيجة_تجهيز_اختبارات.بلا_مكتبة(); };
    إذا ((الطول((*البرنامج).الدوال[دالة_المطلوب.القيمة].المعاملات) مثل طبيعي) != 1
        || (الطول((*البرنامج).الدوال[دالة_النهاية.القيمة].المعاملات) مثل طبيعي) != 1) {
        أرجع نتيجة_تجهيز_اختبارات.بلا_مكتبة();
    };
    دع نوع_الفهرس: معرف_نوع = (*البرنامج).الدوال[دالة_المطلوب.القيمة].المعاملات[0].النوع;
    دع نوع_النتيجة: معرف_نوع = (*البرنامج).الدوال[دالة_النهاية.القيمة].المعاملات[0].النوع;
    دع ناتج_المطلوب: اختياري معرف_نوع = (*البرنامج).الدوال[دالة_المطلوب.القيمة].الناتج;
    دع ناتج_النهاية: اختياري معرف_نوع = (*البرنامج).الدوال[دالة_النهاية.القيمة].الناتج;
    دع ناتج_الفراغ: اختياري معرف_نوع = (*البرنامج).الدوال[دالة_الفراغ.القيمة].الناتج;
    دع نوع_الحالة: معرف_نوع;
    طابق ناتج_النهاية مع
    | اختياري.موجود(ن) -> { نوع_الحالة := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_تجهيز_اختبارات.بلا_مكتبة(); };
    طابق ناتج_المطلوب مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> { أرجع نتيجة_تجهيز_اختبارات.بلا_مكتبة(); };

    // Only the selected tests (--filter, --test, --tests-in) get a case. The
    // rules were applied before lowering (test_mode/validation.sn); here a
    // test's MSIR function must agree with its verdict, or the build fails as
    // an internal error.
    دع المجهزة: متغير متجه اختبار_مجهز = [];
    دع بنتيجة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المكتشفة) مثل طبيعي)) {
        إذا (ف < (الطول(*المختارة) مثل طبيعي) && (*المختارة)[ف]) {
            دع المكتشف: &اختبار_مكتشف = &(*المكتشفة)[ف];
            طابق دالة_بالاسم(البرنامج, التصحيح, الأصول, انسخ_نص(&(*المكتشف).الاسم), اختياري.موجود((*المكتشف).نطاق_الاسم)) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); }
            | اختياري.موجود(الدالة) -> {
                دع الناتج: اختياري معرف_نوع = (*البرنامج).الدوال[الدالة.القيمة].الناتج;
                دع المجهز: اختبار_مجهز = { الاسم: انسخ_نص(&(*المكتشف).الاسم), الدالة: الدالة };
                طابق (*الأحكام)[ف] مع
                | حكم_اختبار.بلا_ناتج -> {
                    إذا (!ناتجان_متساويان(الناتج, ناتج_الفراغ)) { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
                    ألحق(المجهزة, المجهز);
                    ألحق(بنتيجة, خطأ);
                }
                | حكم_اختبار.بنتيجة -> {
                    إذا (!ناتجان_متساويان(الناتج, اختياري.موجود(نوع_النتيجة))) { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
                    ألحق(المجهزة, المجهز);
                    ألحق(بنتيجة, صواب);
                }
                | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
            };
        };
        ف := ف + 1;
    }

    دع بلا_معاملات: متجه معرف_نوع = [];
    دع المدخل: معرف_دالة_مسير = أضف_دالة_مسير(البرنامج, &بلا_معاملات, اختياري.موجود(نوع_الحالة));
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع بلا_حجج: متجه معرف_قيمة_مسير = [];
    دع الحالية: متغير معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(البرنامج, المدخل) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(ك) -> { الحالية := ك; }
    | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
    // The owned-global initializer lowering left to the entry (a program
    // without its own entry): run here, once, and no longer as a constructor.
    طابق (*البرنامج).دالة_تهيئة_الوحدة مع
    | اختياري.موجود(التهيئة) -> {
        طابق (*البرنامج).دالة_بدء_البرنامج مع
        | اختياري.لا_شيء -> {
            طابق أصدر_نداء_مسير(البرنامج, &البناء, المدخل, الحالية, التهيئة, &بلا_حجج) مع
            | نتيجة_بناء_قيمة_مسير.مرفوضة(_) -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); }
            | _ -> { };
            (*البرنامج).دالة_تهيئة_الوحدة := اختياري.لا_شيء();
        }
        | اختياري.موجود(_) -> { };
    }
    | اختياري.لا_شيء -> { };
    // The registration prelude a build's entry runs before main's body
    // (definition-time decorators), in the same order: each process runs one
    // test, so this runs before every test.
    دع المسجلات: متجه معرف_دالة_مسير = مسجلات_تعريف_البرنامج(البرنامج, التصحيح);
    ف := 0;
    طالما (ف < (الطول(المسجلات) مثل طبيعي)) {
        طابق أصدر_نداء_مسير(البرنامج, &البناء, المدخل, الحالية, المسجلات[ف], &بلا_حجج) مع
        | نتيجة_بناء_قيمة_مسير.مرفوضة(_) -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); }
        | _ -> { };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(المجهزة) مثل طبيعي)) {
        دع الثابت: معرف_قيمة_مسير;
        طابق أصدر_ثابتا_مسير(البرنامج, &البناء, المدخل, الحالية, ثابت_مسير.صحيح_موقع(ف مثل عدد), نوع_الفهرس) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الثابت := ق; }
        | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
        دع الحجج: متجه معرف_قيمة_مسير = [الثابت];
        دع الشرط: معرف_قيمة_مسير;
        طابق أصدر_نداء_مسير(البرنامج, &البناء, المدخل, الحالية, دالة_المطلوب, &الحجج) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الشرط := ق; }
        | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
        دع كتلة_التشغيل: معرف_كتلة_مسير;
        طابق أضف_كتلة_مسير(البرنامج, المدخل) مع
        | نتيجة_بناء_كتلة_مسير.مبنية(ك) -> { كتلة_التشغيل := ك; }
        | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
        دع التالية: معرف_كتلة_مسير;
        طابق أضف_كتلة_مسير(البرنامج, المدخل) مع
        | نتيجة_بناء_كتلة_مسير.مبنية(ك) -> { التالية := ك; }
        | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
        دع حجج_التشغيل: متجه معرف_قيمة_مسير = [];
        دع حجج_التالية: متجه معرف_قيمة_مسير = [];
        دع إلى_التشغيل: حافة_مسير = { الهدف: كتلة_التشغيل, الحجج: حجج_التشغيل };
        دع إلى_التالية: حافة_مسير = { الهدف: التالية, الحجج: حجج_التالية };
        طابق اختم_بفرع_شرطي_مسير(البرنامج, &البناء, المدخل, الحالية, الشرط, إلى_التشغيل, إلى_التالية) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(_) -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); }
        | _ -> { };
        // Run test ف and end with its status.
        دع الحالة: معرف_قيمة_مسير;
        إذا (بنتيجة[ف]) {
            دع النتيجة: معرف_قيمة_مسير;
            طابق أصدر_نداء_مسير(البرنامج, &البناء, المدخل, كتلة_التشغيل, المجهزة[ف].الدالة, &بلا_حجج) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { النتيجة := ق; }
            | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
            دع حجج_النهاية: متجه معرف_قيمة_مسير = [النتيجة];
            طابق أصدر_نداء_مسير(البرنامج, &البناء, المدخل, كتلة_التشغيل, دالة_النهاية, &حجج_النهاية) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الحالة := ق; }
            | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
        } وإلا {
            طابق أصدر_نداء_مسير(البرنامج, &البناء, المدخل, كتلة_التشغيل, المجهزة[ف].الدالة, &بلا_حجج) مع
            | نتيجة_بناء_قيمة_مسير.مرفوضة(_) -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); }
            | _ -> { };
            طابق أصدر_ثابتا_مسير(البرنامج, &البناء, المدخل, كتلة_التشغيل, ثابت_مسير.صحيح_موقع(0), نوع_الحالة) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الحالة := ق; }
            | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
        };
        طابق اختم_بإرجاع_مسير(البرنامج, &البناء, المدخل, كتلة_التشغيل, اختياري.موجود(الحالة)) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(_) -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); }
        | _ -> { };
        الحالية := التالية;
        ف := ف + 1;
    }
    // No test selected: status 2.
    دع لا_اختبار: معرف_قيمة_مسير;
    طابق أصدر_ثابتا_مسير(البرنامج, &البناء, المدخل, الحالية, ثابت_مسير.صحيح_موقع(2), نوع_الحالة) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { لا_اختبار := ق; }
    | _ -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); };
    طابق اختم_بإرجاع_مسير(البرنامج, &البناء, المدخل, الحالية, اختياري.موجود(لا_اختبار)) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(_) -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); }
    | _ -> { };
    طابق عين_دالة_بدء_برنامج_مسير(البرنامج, المدخل) مع
    | اختياري.موجود(_) -> { أرجع نتيجة_تجهيز_اختبارات.فشل_بناء(); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة_تجهيز_اختبارات.جاهزة(المجهزة);
}
