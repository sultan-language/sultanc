// The one validation of `@@test` (docs/en/reference/testing.md), over the
// frontend's Name and Type facts: `sultanc test` rejects with it before
// lowering (driver/compiler_driver.sn), and a tooling request reports the
// same diagnostics in its تشخيصات_الأدوات (frontend/semantic_pipeline.sn
// أنه_واجهة_مرحلية) so an editor marks an invalid test while it is written.
// A test is an ordinary function with a body, no parameters, and a result
// of nothing or `نتيجة عدد, فشل` (std.error.failure's فشل).

// What a discovered test is, by the rules.
عام نوع حكم_اختبار =
    // A valid test returning nothing.
    | بلا_ناتج
    // A valid test returning `نتيجة عدد, فشل`.
    | بنتيجة
    // SULTANC-TEST-PARAMETERS.
    | بمعاملات
    // SULTANC-TEST-RESULT-TYPE.
    | ناتج_غير_صالح
    // SULTANC-TEST-NOT-A-FUNCTION.
    | ليس_دالة_عادية
    // No Type facts for the declaration (a tooling request set it aside for
    // another error): nothing to say about its result.
    | بلا_حقائق
;

عرف نوع_مقنن_أساس(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): اختياري معرف_نوع {
    أرجع معرف_نوع_أساس_عند(الأنواع, المعرف);
}

عرف نوع_بدائي_هو(الأنواع: &سجل_أنواع, المعرف: معرف_نوع, البدائي: نوع_بدائي_مقنن): منطقي {
    طابق نوع_مقنن_أساس(الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.بدائي(الموجود) -> { أرجع الموجود == البدائي; }
        | _ -> { أرجع خطأ; };
    };
}

// Whether the declaration of الرمز is std.error.failure's فشل: its name,
// written `فشل`, in alloc's error/failure.sn, which std re-exports.
عرف رمز_هو_فشل_المكتبة(
    الرمز: معرف_رمز,
    الاستعلامات: &اختياري سياق_استعلامات_أسماء,
    الخريطة: &خريطة_مصادر
): منطقي {
    دع المحفوظة: اختياري سياق_استعلامات_أسماء = *الاستعلامات;
    طابق المحفوظة مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأسماء) -> {
        طابق رمز_دلالي_عند_استعلام(&الأسماء, الرمز) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الرمز_الدلالي) -> {
            دع النطاق: نطاق = الرمز_الدلالي.نطاق_الاسم;
            دع المصدر: طبيعي = النطاق.البداية.المصدر مثل طبيعي;
            إذا (المصدر >= (الطول((*الخريطة).المصادر) مثل طبيعي)) { أرجع خطأ; };
            دع الملف: نص = انسخ_نص(&(*الخريطة).المصادر[المصدر].الاسم);
            // alloc declares it (library/alloc/error/failure.sn); std
            // re-exports it as std.error.failure.
            دع اللاحقة: نص = «alloc/error/failure.sn»;
            دع اللاحقة_القديمة: نص = «std/error/failure.sn»;
            إذا (!ينتهي_بـ(&الملف, &اللاحقة) && !ينتهي_بـ(&الملف, &اللاحقة_القديمة)) { أرجع خطأ; };
            دع البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(&(*الخريطة).المصادر[المصدر].المحتوى));
            دع الاسم: متغير متجه ط8 = [];
            دع ف: متغير طبيعي = النطاق.البداية.البايت مثل طبيعي;
            طالما (ف < (النطاق.النهاية.البايت مثل طبيعي) && ف < (الطول(البايتات) مثل طبيعي)) {
                ألحق(الاسم, البايتات[ف]);
                ف := ف + 1;
            }
            دع المكتوب: نص = من_بايتات(&الاسم);
            دع المطلوب: نص = «فشل»;
            أرجع نصان_متساويان(&المكتوب, &المطلوب);
        };
    };
}

// Whether النوع is `نتيجة عدد, فشل`.
عرف نوع_نتيجة_اختبار(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    الاستعلامات: &اختياري سياق_استعلامات_أسماء,
    الخريطة: &خريطة_مصادر
): منطقي {
    طابق نوع_مقنن_أساس(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.نتيجة(النجاح, الخطأ) -> {
            إذا (!نوع_بدائي_هو(الأنواع, النجاح, نوع_بدائي_مقنن.عدد())) { أرجع خطأ; };
            طابق نوع_مقنن_أساس(الأنواع, الخطأ) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(أساس_الخطأ) -> {
                طابق (*الأنواع).الأنواع[أساس_الخطأ.القيمة] مع
                | نوع_مقنن.مسمى(الرمز, _, الحجج) -> {
                    إذا ((الطول(الحجج) مثل طبيعي) != 0) { أرجع خطأ; };
                    أرجع رمز_هو_فشل_المكتبة(الرمز, الاستعلامات, الخريطة);
                }
                | _ -> { أرجع خطأ; };
            };
        }
        | _ -> { أرجع خطأ; };
    };
}

// The verdict on one discovered test. الوحدات and الروابط are the
// frontend's trees and Name facts (one per module, in order), الأنواع its
// Type facts.
عام عرف احكم_على_اختبار(
    المكتشف: &اختبار_مكتشف,
    الوحدات: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    الأنواع: &سياقات_أنواع_وحدة,
    الاستعلامات: &اختياري سياق_استعلامات_أسماء,
    الخريطة: &خريطة_مصادر
): حكم_اختبار {
    طابق (*المكتشف).الصنف مع
    | صنف_مكتشف_اختبار.دالة -> { }
    | _ -> { أرجع حكم_اختبار.ليس_دالة_عادية(); };
    إذا ((*المكتشف).عدد_المعاملات > 0) { أرجع حكم_اختبار.بمعاملات(); };
    دع المصدر: طبيعي = (*المكتشف).نطاق_الاسم.البداية.المصدر مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي) && ف < (الطول(*الروابط) مثل طبيعي)) {
        إذا ((*الوحدات)[ف].معرف_المصدر == المصدر) {
            طابق رمز_اسم_محلول_عند(&(*الروابط)[ف], (*المكتشف).نطاق_الاسم) مع
            | اختياري.لا_شيء -> { أرجع حكم_اختبار.بلا_حقائق(); }
            | اختياري.موجود(الرمز) -> {
                طابق نوع_رمز_دلالي_عند(&(*الأنواع).أنواع_الرموز, الرمز) مع
                | اختياري.لا_شيء -> { أرجع حكم_اختبار.بلا_حقائق(); }
                | اختياري.موجود(نوع_الدالة) -> {
                    طابق نوع_ناتج_دالة_دلالي(&(*الأنواع).الأنواع, نوع_الدالة) مع
                    | اختياري.لا_شيء -> { أرجع حكم_اختبار.بلا_حقائق(); }
                    | اختياري.موجود(الناتج) -> {
                        إذا (نوع_بدائي_هو(&(*الأنواع).الأنواع, الناتج, نوع_بدائي_مقنن.فراغ())) {
                            أرجع حكم_اختبار.بلا_ناتج();
                        };
                        إذا (نوع_نتيجة_اختبار(&(*الأنواع).الأنواع, الناتج, الاستعلامات, الخريطة)) {
                            أرجع حكم_اختبار.بنتيجة();
                        };
                        أرجع حكم_اختبار.ناتج_غير_صالح();
                    };
                };
            };
        };
        ف := ف + 1;
    }
    أرجع حكم_اختبار.بلا_حقائق();
}

// The diagnostic of a test that cannot run, at its name.
عام عرف تشخيص_حكم_اختبار(الحكم: حكم_اختبار): اختياري معرف_تشخيص {
    طابق الحكم مع
    | حكم_اختبار.بمعاملات -> { أرجع اختياري.موجود(معرف_تشخيص.اختبار_بمعاملات()); }
    | حكم_اختبار.ناتج_غير_صالح -> { أرجع اختياري.موجود(معرف_تشخيص.ناتج_اختبار_غير_صالح()); }
    | حكم_اختبار.ليس_دالة_عادية -> { أرجع اختياري.موجود(معرف_تشخيص.اختبار_ليس_دالة_عادية()); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف مصدر_تشخيص_اختبار(الخريطة: &خريطة_مصادر, النطاق_المعطى: نطاق): اختياري نطاق_مصدر_تشخيص {
    دع النطاق: نطاق = نطاق_الإبلاغ(الخريطة, النطاق_المعطى);
    دع المقتطف: اختياري نص = مقتطف_مصدر_محمل_لنطاق(الخريطة, &النطاق);
    دع مقتطف_ثان: اختياري نص = مقتطف_مصدر_محمل_لنطاق(الخريطة, &النطاق);
    طابق نطاق_مصدر_تشخيص_من_خريطة(النطاق, الخريطة, النطاق.البداية.المصدر مثل طبيعي, المقتطف) مع
    | اختياري.موجود(الوصف) -> { أرجع اختياري.موجود(الوصف); }
    | اختياري.لا_شيء -> {
        دع الاسم: اختياري نص = اسم_مصدر_محمل_بالمعرف(الخريطة, النطاق.البداية.المصدر مثل طبيعي);
        أرجع اختياري.موجود(نطاق_مصدر_تشخيص_بأصل(النطاق, الاسم, مقتطف_ثان));
    };
}

// Every discovered test's verdict, in discovery order, and the diagnostics
// of those that cannot run (each at its name) added to التشخيصات.
عام عرف احكم_على_اختبارات(
    المكتشفة: &متجه اختبار_مكتشف,
    الوحدات: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    الأنواع: &سياقات_أنواع_وحدة,
    الاستعلامات: &اختياري سياق_استعلامات_أسماء,
    الخريطة: &خريطة_مصادر,
    التشخيصات: &متغير مجموعة_تشخيصات
): متجه حكم_اختبار {
    دع الأحكام: متغير متجه حكم_اختبار = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المكتشفة) مثل طبيعي)) {
        دع الحكم: حكم_اختبار = احكم_على_اختبار(
            &(*المكتشفة)[ف], الوحدات, الروابط, الأنواع, الاستعلامات, الخريطة
        );
        طابق تشخيص_حكم_اختبار(الحكم) مع
        | اختياري.موجود(المعرف) -> {
            دع التشخيص: تشخيص = ابدأ_تشخيصا(
                المعرف, مصدر_تشخيص_اختبار(الخريطة, (*المكتشفة)[ف].نطاق_الاسم)
            );
            أصدر_تشخيصا(التشخيصات, &التشخيص);
        }
        | اختياري.لا_شيء -> { };
        ألحق(الأحكام, الحكم);
        ف := ف + 1;
    }
    أرجع الأحكام;
}

// For a tooling request: the diagnostics of the invalid tests of every
// module (the modules whose text holds `@@`, parsed again for الهدف as
// discovery does). Empty when there is no test.
عام عرف تشخيصات_اختبارات_للأدوات(
    الخريطة: &خريطة_مصادر,
    الوحدات: &متجه وحدة_مصدر,
    الروابط: &متجه سياق_روابط_أسماء,
    الأنواع: &سياقات_أنواع_وحدة,
    الاستعلامات: &اختياري سياق_استعلامات_أسماء,
    الهدف: &اختياري واصف_هدف
): مجموعة_تشخيصات {
    دع المعرفات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ألحق(المعرفات, (*الوحدات)[ف].معرف_المصدر);
        ف := ف + 1;
    }
    دع المكتشفة: متجه اختبار_مكتشف = اكتشف_اختبارات(الخريطة, &المعرفات, الهدف);
    دع التشخيصات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع الأحكام: متجه حكم_اختبار = احكم_على_اختبارات(
        &المكتشفة, الوحدات, الروابط, الأنواع, الاستعلامات, الخريطة, &متغير التشخيصات
    );
    أرجع التشخيصات;
}
