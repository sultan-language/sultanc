استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد compiler.backend.target.target_model;
استورد compiler.frontend.ast.name;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.lexer.lexer;
استورد compiler.frontend.lexer.values;
استورد compiler.frontend.parser.parser;
استورد compiler.frontend.parser.result;
استورد compiler.frontend.annotations.definition_decorators;
استورد المكتبة.نصوص.من_بايتات;

// Test discovery for `sultanc test` (docs/en/reference/testing.md). A test is
// a declaration marked `@@test` (`@@اختبار`: frontend/annotations/
// definition_decorators.sn سمة_اختبار). The annotation leaves the tree before
// the type phase, so discovery reads it the way the frontend did: each
// module's text, as the source map holds it, parsed by the same lexer and
// parser for the same target. Only modules whose text contains `@@` are
// parsed again. A test is found by its declaration: its name, its span and
// what it is; the driver matches it to the MSIR function lowered from the same
// declaration (test_mode/harness.sn) and validates it there.

// What a `@@test` annotation marks.
عام نوع صنف_مكتشف_اختبار =
    // An ordinary function: the candidate test.
    | دالة
    // A generic function, a function with compile-time parameters, or an
    // external one: no single function to run.
    | دالة_غير_قابلة
    // A type or a module value.
    | ليس_دالة
;

عام نوع اختبار_مكتشف = {
    // The name as written (its first spelling).
    الاسم: نص,
    // Every spelling of the name: the name, then the function's other names
    // (`def name / اسم`), as written.
    التهجئات: متجه نص,
    // The declared name's span (diagnostics).
    نطاق_الاسم: نطاق,
    الصنف: صنف_مكتشف_اختبار,
    عدد_المعاملات: طبيعي
};

عرف نص_من_نطاق_اكتشاف(الأصل: &متجه ط8, النطاق: نطاق): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = النطاق.البداية.البايت مثل طبيعي;
    دع النهاية: طبيعي = النطاق.النهاية.البايت مثل طبيعي;
    طالما (ف < النهاية && ف < (الطول(*الأصل) مثل طبيعي)) {
        ألحق(البايتات, (*الأصل)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف سمات_فيها_اختبار(الأصل: &متجه ط8, السمات: &متجه سمة_تصريح): منطقي {
    دع س: متغير طبيعي = 0;
    طالما (س < (الطول(*السمات) مثل طبيعي)) {
        إذا (سمة_اختبار(الأصل, &(*السمات)[س])) { أرجع صواب; };
        س := س + 1;
    }
    أرجع خطأ;
}

عرف نص_فيه_سمة(الأصل: &متجه ط8): منطقي {
    دع ف: متغير طبيعي = 1;
    طالما (ف < (الطول(*الأصل) مثل طبيعي)) {
        إذا ((*الأصل)[ف] == 0x40 && (*الأصل)[ف - 1] == 0x40) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف دالة_قابلة_للاختبار(الدالة: &تصريح_دالة): منطقي {
    إذا ((الطول((*الدالة).معاملات_النوع) مثل طبيعي) > 0) { أرجع خطأ; };
    طابق (*الدالة).الجسم مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        إذا ((*الدالة).المعاملات[ف].مطلوب_مسبقا) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The tests of the sources المعرفات (source ids of the program's modules,
// in module order), as the source map holds them, parsed for الهدف.
عام عرف اكتشف_اختبارات(
    الخريطة: &خريطة_مصادر,
    المعرفات: &متجه طبيعي,
    الهدف: &اختياري واصف_هدف
): متجه اختبار_مكتشف {
    دع الناتج: متغير متجه اختبار_مكتشف = [];
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(*المعرفات) مثل طبيعي)) {
        دع المعرف: طبيعي = (*المعرفات)[م];
        إذا (المعرف < (الطول((*الخريطة).المصادر) مثل طبيعي)) {
            دع المصدر: &مصدر = &(*الخريطة).المصادر[المعرف];
            دع الأصل: متجه ط8 = بايتات_من_نص(انسخ_نص(&(*المصدر).المحتوى));
            إذا (نص_فيه_سمة(&الأصل)) {
                طابق حلل_معجميا(المصدر) مع
                | نتيجة_تحليل_معجمي.مرفوض(_) -> { }
                | نتيجة_تحليل_معجمي.سلسلة(السلسلة) -> {
                    طابق حلل_الرموز_لهدف(المصدر, &السلسلة.الرموز, الهدف) مع
                    | نتيجة_تحليل.شجرة(الوحدة) -> {
                        اجمع_اختبارات_وحدة(&الوحدة, &الأصل, &متغير الناتج);
                    }
                    | _ -> { };
                };
            };
        };
        م := م + 1;
    }
    أرجع الناتج;
}

عرف اجمع_اختبارات_وحدة(الوحدة: &وحدة_مصدر, الأصل: &متجه ط8, الناتج: &متغير متجه اختبار_مكتشف): فراغ {
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الوحدة).العناصر) مثل طبيعي)) {
        طابق (*الوحدة).العناصر[ع] مع
        | عنصر_وحدة.دالة(الدالة) -> {
            إذا (سمات_فيها_اختبار(الأصل, &الدالة.السمات)) {
                دع الصنف: متغير صنف_مكتشف_اختبار = صنف_مكتشف_اختبار.دالة();
                إذا (!دالة_قابلة_للاختبار(&الدالة)) { الصنف := صنف_مكتشف_اختبار.دالة_غير_قابلة(); };
                دع التهجئات: متغير متجه نص = [];
                ألحق(التهجئات, نص_من_نطاق_اكتشاف(الأصل, الدالة.الاسم.النطاق));
                دع ب: متغير طبيعي = 0;
                طالما (ب < (الطول(الدالة.الأسماء_البديلة) مثل طبيعي)) {
                    ألحق(التهجئات, نص_من_نطاق_اكتشاف(الأصل, الدالة.الأسماء_البديلة[ب].النطاق));
                    ب := ب + 1;
                }
                دع المكتشف: اختبار_مكتشف = {
                    الاسم: نص_من_نطاق_اكتشاف(الأصل, الدالة.الاسم.النطاق),
                    التهجئات: التهجئات,
                    نطاق_الاسم: الدالة.الاسم.النطاق,
                    الصنف: الصنف,
                    عدد_المعاملات: الطول(الدالة.المعاملات) مثل طبيعي
                };
                ألحق(*الناتج, المكتشف);
            };
        }
        | عنصر_وحدة.نوع(التصريح) -> {
            إذا (سمات_فيها_اختبار(الأصل, &التصريح.السمات)) {
                دع التهجئات: متغير متجه نص = [];
                ألحق(التهجئات, نص_من_نطاق_اكتشاف(الأصل, التصريح.الاسم.النطاق));
                دع المكتشف: اختبار_مكتشف = {
                    الاسم: نص_من_نطاق_اكتشاف(الأصل, التصريح.الاسم.النطاق),
                    التهجئات: التهجئات,
                    نطاق_الاسم: التصريح.الاسم.النطاق,
                    الصنف: صنف_مكتشف_اختبار.ليس_دالة(),
                    عدد_المعاملات: 0
                };
                ألحق(*الناتج, المكتشف);
            };
        }
        | عنصر_وحدة.قيمة_عليا(التصريح) -> {
            إذا (سمات_فيها_اختبار(الأصل, &التصريح.السمات)) {
                دع التهجئات: متغير متجه نص = [];
                ألحق(التهجئات, نص_من_نطاق_اكتشاف(الأصل, التصريح.الاسم.النطاق));
                دع المكتشف: اختبار_مكتشف = {
                    الاسم: نص_من_نطاق_اكتشاف(الأصل, التصريح.الاسم.النطاق),
                    التهجئات: التهجئات,
                    نطاق_الاسم: التصريح.الاسم.النطاق,
                    الصنف: صنف_مكتشف_اختبار.ليس_دالة(),
                    عدد_المعاملات: 0
                };
                ألحق(*الناتج, المكتشف);
            };
        }
        | _ -> { };
        ع := ع + 1;
    }
}
