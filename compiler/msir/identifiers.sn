استورد compiler.source.span;
// هويات MSIR ثابتة داخل البرنامج. الكتلة والقيمة تحملان هوية الدالة لمنع خلط السياقات.
// 32-bit: every identity is a vector position (a function, block or value
// of one function, a global, an external) and is made only through its
// constructor below, which checks it (ط32_متحقق, compiler/source/span.sn).
// A Value ID is 8 bytes instead of 16; every operand holds one.
عام نوع معرف_دالة_مسير = {
    القيمة: ط32
};

// External functions have their own identity space; they are declarations, not SultanC bodies.
عام نوع معرف_دالة_خارجية_مسير = {
    القيمة: ط32
};

// Top-level writable storage has a program-wide identity independent of functions.
عام نوع معرف_عام_مسير = {
    القيمة: ط32
};

عام نوع معرف_كتلة_مسير = {
    الدالة: معرف_دالة_مسير,
    القيمة: ط32
};

عام نوع معرف_قيمة_مسير = {
    الدالة: معرف_دالة_مسير,
    القيمة: ط32
};

عام عرف معرف_عام_مسير_من(القيمة: طبيعي): معرف_عام_مسير {
    دع المعرف: معرف_عام_مسير = { القيمة: ط32_متحقق(القيمة) };
    أرجع المعرف;
}

عام عرف معرف_دالة_خارجية_مسير_من(القيمة: طبيعي): معرف_دالة_خارجية_مسير {
    دع المعرف: معرف_دالة_خارجية_مسير = { القيمة: ط32_متحقق(القيمة) };
    أرجع المعرف;
}

عام عرف معرف_دالة_مسير_من(القيمة: طبيعي): معرف_دالة_مسير {
    دع المعرف: معرف_دالة_مسير = { القيمة: ط32_متحقق(القيمة) };
    أرجع المعرف;
}

عام عرف معرف_كتلة_مسير_من(
    الدالة: معرف_دالة_مسير,
    القيمة: طبيعي
): معرف_كتلة_مسير {
    دع المعرف: معرف_كتلة_مسير = {
        الدالة: الدالة,
        القيمة: ط32_متحقق(القيمة)
    };
    أرجع المعرف;
}

عام عرف معرف_قيمة_مسير_من(
    الدالة: معرف_دالة_مسير,
    القيمة: طبيعي
): معرف_قيمة_مسير {
    دع المعرف: معرف_قيمة_مسير = {
        الدالة: الدالة,
        القيمة: ط32_متحقق(القيمة)
    };
    أرجع المعرف;
}

عام عرف عاما_مسير_متساويان(أ: معرف_عام_مسير, ب: معرف_عام_مسير): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف دالتا_مسير_خارجيتان_متساويتان(أ: معرف_دالة_خارجية_مسير, ب: معرف_دالة_خارجية_مسير): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف دالتا_مسير_متساويتان(أ: معرف_دالة_مسير, ب: معرف_دالة_مسير): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

عام عرف كتلتان_مسير_متساويتان(أ: معرف_كتلة_مسير, ب: معرف_كتلة_مسير): منطقي {
    أرجع دالتا_مسير_متساويتان(أ.الدالة, ب.الدالة) && (أ.القيمة == ب.القيمة);
}

عام عرف قيمتا_مسير_متساويتان(أ: معرف_قيمة_مسير, ب: معرف_قيمة_مسير): منطقي {
    أرجع دالتا_مسير_متساويتان(أ.الدالة, ب.الدالة) && (أ.القيمة == ب.القيمة);
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_معرف_قيمة_مسير(القيمة: &متجه معرف_قيمة_مسير): متجه معرف_قيمة_مسير {
    دع الناتج: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
