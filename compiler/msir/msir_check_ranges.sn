استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_analysis;
استورد compiler.msir.checked_arithmetic;
استورد compiler.msir.lowering.model;
استورد compiler.msir.lowering.msir_context;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_identity;

// Range-based overflow-check removal (msir_optimization_pipeline.sn runs it
// at every level but بلا, then flow simplification drops the dead tests and
// report blocks). A checked add or subtract that runtime_checks.sn made
// report its overflow (checked_arithmetic.sn) is proven not to overflow from
// the ranges of its operands, and then:
//
// - K's test branch becomes a branch to C (the test and the report block are
//   then dead);
// - C's checked operation becomes the wrapping one, which then needs no
//   check on any consumer, unless its value is read by a call (a memory
//   range's length the verifier proves from the checked operation) or by a
//   multiply (one that may be such a length).
//
// An operand's range is its Type's, narrowed by:
//   - a constant: itself;
//   - x & m (m a non-negative constant): [0, m]; x %u c: [0, c - 1];
//     x >>u c: [0, MAX >> c]; a widening of an unsigned or narrower value:
//     its Type's range;
//   - every comparison that holds where the check runs: a compare of the
//     operand with a value r whose own range is known, that is the branch
//     condition of a block D dominating K along an edge D -> T where T is
//     entered only from D and dominates K (T the true edge: the comparison
//     holds; the false edge: its negation). So `while (i < n) { ... i + 1 }`
//     proves `i + 1` (i <= MAX - 1), and `if (n < 2) { ... } else { n - 1 }`
//     proves `n - 1` (n >= 2).
// The sum or difference of the ranges must fit the Type. Anything else
// keeps the check; multiplies keep theirs.

// A range of one value: [الأدنى, الأعلى] read as signed (موقع) or unsigned
// 64-bit patterns of the value's Type.
نوع مدى_فحص = {
    الأدنى: طبيعي,
    الأعلى: طبيعي
};

// The bounds of an integer Type: patterns, read by موقع.
نوع حدود_نوع_فحص = {
    موقع: منطقي,
    البتات: طبيعي,
    الأدنى: طبيعي,
    الأعلى: طبيعي
};

// A pattern minus 1 and plus 1, modulo 2^64.
عرف أنقص_واحدا_فحص(س: طبيعي): طبيعي {
    إذا (س == 0) { ليكن الصفر: طبيعي = 0; أرجع ~الصفر; };
    أرجع س - 1;
}

عرف زد_واحدا_فحص(س: طبيعي): طبيعي {
    ليكن الصفر: طبيعي = 0;
    إذا (س == ~الصفر) { أرجع 0; };
    أرجع س + 1;
}

// Signed order on 64-bit patterns.
عرف أصغر_موقع_فحص(أ: طبيعي, ب: طبيعي): منطقي {
    أرجع (أ ^ 0x8000000000000000) < (ب ^ 0x8000000000000000);
}

عرف أصغر_فحص(موقع: منطقي, أ: طبيعي, ب: طبيعي): منطقي {
    إذا (موقع) { أرجع أصغر_موقع_فحص(أ, ب); };
    أرجع أ < ب;
}

عرف أكبر_فحص(موقع: منطقي, أ: طبيعي, ب: طبيعي): طبيعي {
    إذا (أصغر_فحص(موقع, أ, ب)) { أرجع ب; };
    أرجع أ;
}

عرف أصغرهما_فحص(موقع: منطقي, أ: طبيعي, ب: طبيعي): طبيعي {
    إذا (أصغر_فحص(موقع, أ, ب)) { أرجع أ; };
    أرجع ب;
}

عرف حدود_نوع_مسير_فحص(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري حدود_نوع_فحص {
    طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
    | اختياري.موجود(و) -> {
        إذا (و.البتات == 0 || و.البتات > 64) { أرجع اختياري.لا_شيء(); };
        ليكن الصفر: طبيعي = 0;
        ليكن الواحد: طبيعي = 1;
        ليكن الأعلى: متغير طبيعي = ~الصفر;
        ليكن الأدنى: متغير طبيعي = 0;
        إذا (و.موقع) {
            إذا (و.البتات == 64) { الأعلى := 0x7FFFFFFFFFFFFFFF; }
            وإلا { الأعلى := (الواحد << (و.البتات - 1)) - 1; };
            // The least value, sign-extended: -(MAX) - 1 as a pattern.
            الأدنى := ~الأعلى;
        } وإلا إذا (و.البتات < 64) {
            الأعلى := (الواحد << و.البتات) - 1;
        };
        ليكن الحدود: حدود_نوع_فحص = { موقع: و.موقع, البتات: و.البتات, الأدنى: الأدنى, الأعلى: الأعلى };
        أرجع اختياري.موجود(الحدود);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// What the pass reads of a function, once.
نوع سياق_فحص_مدى = {
    التعريفات_الكتلة: متجه طبيعي,
    التعريفات_التعليمة: متجه طبيعي,
    السوابق: متجه طبيعي,
    الهيمنة: تحليل_هيمنة_مسير
};

// The value's own range from its definition (no compare), within الحدود.
عرف مدى_تعريف_فحص(
    الدالة: &دالة_مسير,
    السياق: &سياق_فحص_مدى,
    الأنواع: &سجل_أنواع,
    القيمة: معرف_قيمة_مسير,
    الحدود: &حدود_نوع_فحص
): مدى_فحص {
    ليكن الكامل: مدى_فحص = { الأدنى: (*الحدود).الأدنى, الأعلى: (*الحدود).الأعلى };
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*السياق).التعريفات_الكتلة) مثل طبيعي) || (*السياق).التعريفات_الكتلة[ق] == 0) { أرجع الكامل; };
    ليكن ك: طبيعي = (*السياق).التعريفات_الكتلة[ق] - 1;
    ليكن ت: طبيعي = (*السياق).التعريفات_التعليمة[ق];
    طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        طابق الثابت مع
        | ثابت_مسير.صحيح_موقع(س) -> { ليكن م: مدى_فحص = { الأدنى: س مثل طبيعي, الأعلى: س مثل طبيعي }; أرجع م; }
        | ثابت_مسير.صحيح_طبيعي(س) -> { ليكن م: مدى_فحص = { الأدنى: س, الأعلى: س }; أرجع م; }
        | _ -> { أرجع الكامل; };
    }
    | عملية_مسير.حساب_صحيح(ح) -> {
        طابق ح.العملية مع
        | عملية_حساب_صحيح.و_بتي -> {
            // x & m, m a non-negative constant: [0, m].
            ليكن م1: مدى_فحص = مدى_ثابت_فحص(الدالة, السياق, ح.اليمين);
            ليكن م2: مدى_فحص = مدى_ثابت_فحص(الدالة, السياق, ح.اليسار);
            ليكن القناع: متغير اختياري طبيعي = اختياري.لا_شيء();
            إذا (م1.الأدنى == م1.الأعلى && م1.الأعلى < 0x8000000000000000) { القناع := اختياري.موجود(م1.الأعلى); }
            وإلا إذا (م2.الأدنى == م2.الأعلى && م2.الأعلى < 0x8000000000000000) { القناع := اختياري.موجود(م2.الأعلى); };
            طابق القناع مع
            | اختياري.موجود(م) -> { ليكن المدى: مدى_فحص = { الأدنى: 0, الأعلى: م }; أرجع المدى; }
            | اختياري.لا_شيء -> { أرجع الكامل; };
        }
        | عملية_حساب_صحيح.باقي_طبيعي -> {
            ليكن م: مدى_فحص = مدى_ثابت_فحص(الدالة, السياق, ح.اليمين);
            إذا (م.الأدنى == م.الأعلى && م.الأعلى > 0) {
                ليكن المدى: مدى_فحص = { الأدنى: 0, الأعلى: م.الأعلى - 1 };
                أرجع المدى;
            };
            أرجع الكامل;
        }
        | عملية_حساب_صحيح.إزاحة_يمنى -> {
            إذا ((*الحدود).موقع) { أرجع الكامل; };
            ليكن م: مدى_فحص = مدى_ثابت_فحص(الدالة, السياق, ح.اليمين);
            إذا (م.الأدنى == م.الأعلى && م.الأعلى < 64) {
                ليكن المدى: مدى_فحص = { الأدنى: 0, الأعلى: (*الحدود).الأعلى >> م.الأعلى };
                أرجع المدى;
            };
            أرجع الكامل;
        }
        | _ -> { أرجع الكامل; };
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        طابق التحويل.العملية مع
        | عملية_تحويل_صحيح.توسيع_صفري -> {
            // The source's unsigned range.
            طابق نوع_مصدر_فحص(الدالة, التحويل.المصدر) مع
            | اختياري.موجود(النوع) -> {
                طابق حدود_نوع_مسير_فحص(الأنواع, النوع) مع
                | اختياري.موجود(ح_) -> {
                    إذا (!ح_.موقع) { ليكن المدى: مدى_فحص = { الأدنى: 0, الأعلى: ح_.الأعلى }; أرجع المدى; };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            أرجع الكامل;
        }
        | _ -> { أرجع الكامل; };
    }
    | _ -> { أرجع الكامل; };
}

عرف نوع_مصدر_فحص(الدالة: &دالة_مسير, القيمة: معرف_قيمة_مسير): اختياري معرف_نوع {
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*الدالة).القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الدالة).القيم[ق].النوع);
}

// A constant's value as a one-point range, else [1, 0] (empty: no constant).
عرف مدى_ثابت_فحص(الدالة: &دالة_مسير, السياق: &سياق_فحص_مدى, القيمة: معرف_قيمة_مسير): مدى_فحص {
    ليكن لا_شيء: مدى_فحص = { الأدنى: 1, الأعلى: 0 };
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*السياق).التعريفات_الكتلة) مثل طبيعي) || (*السياق).التعريفات_الكتلة[ق] == 0) { أرجع لا_شيء; };
    ليكن ك: طبيعي = (*السياق).التعريفات_الكتلة[ق] - 1;
    ليكن ت: طبيعي = (*السياق).التعريفات_التعليمة[ق];
    طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        طابق الثابت مع
        | ثابت_مسير.صحيح_موقع(س) -> { ليكن م: مدى_فحص = { الأدنى: س مثل طبيعي, الأعلى: س مثل طبيعي }; أرجع م; }
        | ثابت_مسير.صحيح_طبيعي(س) -> { ليكن م: مدى_فحص = { الأدنى: س, الأعلى: س }; أرجع م; }
        | _ -> { أرجع لا_شيء; };
    }
    | _ -> { أرجع لا_شيء; };
}

// Narrows المدى of القيمة by one comparison that holds: القيمة العملية الآخر
// (the operands already ordered so القيمة is on the left).
عرف ضيق_بمقارنة_فحص(
    المدى: &متغير مدى_فحص,
    العملية: عملية_مقارنة_صحيح,
    الآخر: &مدى_فحص,
    الحدود: &حدود_نوع_فحص
): فراغ {
    ليكن م: منطقي = (*الحدود).موقع;
    طابق العملية مع
    | عملية_مقارنة_صحيح.أصغر -> {
        // v < r: v <= hi(r) - 1 (r's hi above the least value).
        إذا (أصغر_فحص(م, (*الحدود).الأدنى, (*الآخر).الأعلى)) {
            (*المدى).الأعلى := أصغرهما_فحص(م, (*المدى).الأعلى, أنقص_واحدا_فحص((*الآخر).الأعلى));
        };
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        (*المدى).الأعلى := أصغرهما_فحص(م, (*المدى).الأعلى, (*الآخر).الأعلى);
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        // v > r: v >= lo(r) + 1 (r's lo below the greatest value).
        إذا (أصغر_فحص(م, (*الآخر).الأدنى, (*الحدود).الأعلى)) {
            (*المدى).الأدنى := أكبر_فحص(م, (*المدى).الأدنى, زد_واحدا_فحص((*الآخر).الأدنى));
        };
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        (*المدى).الأدنى := أكبر_فحص(م, (*المدى).الأدنى, (*الآخر).الأدنى);
    }
    | عملية_مقارنة_صحيح.يساوي -> {
        (*المدى).الأدنى := أكبر_فحص(م, (*المدى).الأدنى, (*الآخر).الأدنى);
        (*المدى).الأعلى := أصغرهما_فحص(م, (*المدى).الأعلى, (*الآخر).الأعلى);
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> { };
}

// The negation of a comparison, and the comparison with its operands
// swapped.
عرف نفي_مقارنة_فحص(العملية: عملية_مقارنة_صحيح): عملية_مقارنة_صحيح {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> { أرجع عملية_مقارنة_صحيح.لا_يساوي(); }
    | عملية_مقارنة_صحيح.لا_يساوي -> { أرجع عملية_مقارنة_صحيح.يساوي(); }
    | عملية_مقارنة_صحيح.أصغر -> { أرجع عملية_مقارنة_صحيح.أكبر_أو_يساوي(); }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> { أرجع عملية_مقارنة_صحيح.أكبر(); }
    | عملية_مقارنة_صحيح.أكبر -> { أرجع عملية_مقارنة_صحيح.أصغر_أو_يساوي(); }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> { أرجع عملية_مقارنة_صحيح.أصغر(); };
}

عرف بدل_مقارنة_فحص(العملية: عملية_مقارنة_صحيح): عملية_مقارنة_صحيح {
    طابق العملية مع
    | عملية_مقارنة_صحيح.أصغر -> { أرجع عملية_مقارنة_صحيح.أكبر(); }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> { أرجع عملية_مقارنة_صحيح.أكبر_أو_يساوي(); }
    | عملية_مقارنة_صحيح.أكبر -> { أرجع عملية_مقارنة_صحيح.أصغر(); }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> { أرجع عملية_مقارنة_صحيح.أصغر_أو_يساوي(); }
    | _ -> { أرجع العملية; };
}

// The range of القيمة where block ك runs: its definition's, narrowed by the
// comparisons on the dominating edges into ك.
عرف مدى_في_كتلة_فحص(
    الدالة: &دالة_مسير,
    السياق: &سياق_فحص_مدى,
    الأنواع: &سجل_أنواع,
    القيمة: معرف_قيمة_مسير,
    ك: طبيعي,
    الحدود: &حدود_نوع_فحص
): مدى_فحص {
    ليكن المدى: متغير مدى_فحص = مدى_تعريف_فحص(الدالة, السياق, الأنواع, القيمة, الحدود);
    ليكن الحالية: متغير طبيعي = ك;
    ليكن الخطوات: متغير طبيعي = 0;
    طالما (الخطوات < 64) {
        الخطوات := الخطوات + 1;
        إذا (الحالية >= (الطول((*السياق).الهيمنة.المهيمن_المباشر) مثل طبيعي)) { أرجع المدى; };
        ليكن المهيمن: طبيعي;
        طابق (*السياق).الهيمنة.المهيمن_المباشر[الحالية] مع
        | اختياري.موجود(د) -> { المهيمن := د.القيمة مثل طبيعي; }
        | اختياري.لا_شيء -> { أرجع المدى; };
        // The edge D -> الحالية holds a comparison when الحالية is entered
        // only from D, by one edge of D's two-way branch.
        إذا ((*السياق).السوابق[الحالية] == 1) {
            طابق (*الدالة).الكتل[المهيمن].المنهي مع
            | اختياري.موجود(المنهي) -> {
                طابق المنهي مع
                | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
                    ليكن صواب_: طبيعي = عند_الصواب.الهدف.القيمة مثل طبيعي;
                    ليكن خطأ_: طبيعي = عند_الخطأ.الهدف.القيمة مثل طبيعي;
                    إذا (صواب_ != خطأ_ && (صواب_ == الحالية || خطأ_ == الحالية)) {
                        ضيق_بشرط_فحص(الدالة, السياق, الأنواع, &متغير المدى, القيمة, الشرط, صواب_ == الحالية, الحدود);
                    };
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
        };
        الحالية := المهيمن;
    }
    أرجع المدى;
}

// Narrows by the comparison الشرط (or its negation when !صادق) when it
// compares القيمة.
عرف ضيق_بشرط_فحص(
    الدالة: &دالة_مسير,
    السياق: &سياق_فحص_مدى,
    الأنواع: &سجل_أنواع,
    المدى: &متغير مدى_فحص,
    القيمة: معرف_قيمة_مسير,
    الشرط: معرف_قيمة_مسير,
    صادق: منطقي,
    الحدود: &حدود_نوع_فحص
): فراغ {
    ليكن ق: طبيعي = الشرط.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*السياق).التعريفات_الكتلة) مثل طبيعي) || (*السياق).التعريفات_الكتلة[ق] == 0) { أرجع; };
    ليكن ك: طبيعي = (*السياق).التعريفات_الكتلة[ق] - 1;
    ليكن ت: طبيعي = (*السياق).التعريفات_التعليمة[ق];
    طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
    | عملية_مسير.مقارنة_صحيح(م) -> {
        ليكن العملية: متغير عملية_مقارنة_صحيح = م.العملية;
        إذا (!صادق) { العملية := نفي_مقارنة_فحص(العملية); };
        ليكن الآخر: معرف_قيمة_مسير;
        إذا (م.اليسار.القيمة == القيمة.القيمة && م.اليمين.القيمة != القيمة.القيمة) {
            الآخر := م.اليمين;
        } وإلا إذا (م.اليمين.القيمة == القيمة.القيمة && م.اليسار.القيمة != القيمة.القيمة) {
            الآخر := م.اليسار;
            العملية := بدل_مقارنة_فحص(العملية);
        } وإلا { أرجع; };
        // The other operand's own range (no compares: no recursion).
        ليكن مدى_الآخر: مدى_فحص = مدى_تعريف_فحص(الدالة, السياق, الأنواع, الآخر, الحدود);
        ضيق_بمقارنة_فحص(المدى, العملية, &مدى_الآخر, الحدود);
    }
    | _ -> { };
}

// Whether a + b (جمع) or a - b cannot leave the Type, from the ranges.
عرف آمن_فحص(أ: &مدى_فحص, ب: &مدى_فحص, جمع: منطقي, الحدود: &حدود_نوع_فحص): منطقي {
    ليكن م: منطقي = (*الحدود).موقع;
    // An empty range (contradictory facts: dead code) proves nothing here.
    إذا (أصغر_فحص(م, (*أ).الأعلى, (*أ).الأدنى) || أصغر_فحص(م, (*ب).الأعلى, (*ب).الأدنى)) { أرجع خطأ; };
    إذا (!م) {
        إذا (جمع) {
            // hi(a) + hi(b) <= MAX.
            أرجع (*ب).الأعلى <= (*الحدود).الأعلى && (*أ).الأعلى <= (*الحدود).الأعلى - (*ب).الأعلى;
        };
        // lo(a) >= hi(b).
        أرجع (*أ).الأدنى >= (*ب).الأعلى;
    };
    // Signed, as 128-bit-free comparisons: each bound pair sums in range.
    إذا (جمع) {
        أرجع مجموع_في_المدى_فحص((*أ).الأعلى, (*ب).الأعلى, الحدود) && مجموع_في_المدى_فحص((*أ).الأدنى, (*ب).الأدنى, الحدود);
    };
    أرجع فرق_في_المدى_فحص((*أ).الأعلى, (*ب).الأدنى, الحدود) && فرق_في_المدى_فحص((*أ).الأدنى, (*ب).الأعلى, الحدود);
}

// Whether x + y (signed patterns) lies in [MIN, MAX] of the Type.
عرف مجموع_في_المدى_فحص(س: طبيعي, ص: طبيعي, الحدود: &حدود_نوع_فحص): منطقي {
    ليكن س_: عدد = س مثل عدد;
    ليكن ص_: عدد = ص مثل عدد;
    ليكن الأعلى: عدد = (*الحدود).الأعلى مثل عدد;
    ليكن الأدنى: عدد = (*الحدود).الأدنى مثل عدد;
    // x + y <= MAX  <=>  x <= MAX - y (y >= 0), and x + y >= MIN <=> x >= MIN - y (y < 0).
    إذا (ص_ >= 0) { أرجع ص_ <= الأعلى && س_ <= الأعلى - ص_ && س_ >= الأدنى; };
    أرجع ص_ >= الأدنى && س_ >= الأدنى - ص_ && س_ <= الأعلى;
}

// Whether x - y (signed patterns) lies in [MIN, MAX] of the Type.
عرف فرق_في_المدى_فحص(س: طبيعي, ص: طبيعي, الحدود: &حدود_نوع_فحص): منطقي {
    ليكن س_: عدد = س مثل عدد;
    ليكن ص_: عدد = ص مثل عدد;
    ليكن الأعلى: عدد = (*الحدود).الأعلى مثل عدد;
    ليكن الأدنى: عدد = (*الحدود).الأدنى مثل عدد;
    // x - y >= MIN <=> x >= MIN + y (y >= 0); x - y <= MAX <=> x <= MAX + y (y < 0).
    إذا (ص_ >= 0) { أرجع ص_ <= الأعلى && س_ >= الأدنى + ص_ && س_ <= الأعلى; };
    أرجع ص_ >= الأدنى && س_ <= الأعلى + ص_ && س_ >= الأدنى;
}

// Whether a call or a multiply reads القيمة (a length the verifier proves
// from the checked operation that defines it).
عرف قيمة_طول_محتمل_فحص(الدالة: &دالة_مسير, القيمة: معرف_قيمة_مسير): منطقي {
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ليكن يهم: متغير منطقي = خطأ;
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.نداء(_) -> { يهم := صواب; }
            | عملية_مسير.حساب_صحيح(ح) -> {
                طابق ح.العملية مع
                | عملية_حساب_صحيح.ضرب -> { يهم := صواب; }
                | _ -> { };
            }
            | _ -> { };
            إذا (يهم) {
                ليكن المعاملات: متغير متجه طبيعي = [];
                ألحق_معاملات_عملية_مسير(&(*الدالة).الكتل[ك].التعليمات[ت].العملية, &متغير المعاملات);
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
                    إذا (المعاملات[ف] == (القيمة.القيمة مثل طبيعي)) { أرجع صواب; };
                    ف := ف + 1;
                }
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع خطأ;
}

// Removes the proven checks of one function; true when one went.
عرف احذف_فحوصا_مثبتة_دالة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: &متغير دالة_مسير,
    الأنواع: &سجل_أنواع
): منطقي {
    ليكن الحسابات: حسابات_بمخرج_تجاوز_مسير = حسابات_بمخرج_تجاوز_مسير_في(البرنامج, الدالة);
    إذا ((الطول(الحسابات.الحسابات) مثل طبيعي) == 0) { أرجع خطأ; };
    ليكن عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    ليكن الكتل_: متغير متجه طبيعي = [];
    ليكن التعليمات_: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    احجز_سعة(الكتل_, (الطول((*الدالة).القيم) مثل طبيعي));
    احجز_سعة(التعليمات_, (الطول((*الدالة).القيم) مثل طبيعي));
    طالما (ف < (الطول((*الدالة).القيم) مثل طبيعي)) { ألحق(الكتل_, 0); ألحق(التعليمات_, 0); ف := ف + 1; }
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق موضع_ناتج_تعليمة_مسير(&(*الدالة).الكتل[ك].التعليمات[ت]) مع
            | اختياري.موجود(ق) -> { إذا (ق < (الطول(الكتل_) مثل طبيعي)) { الكتل_[ق] := ك + 1; التعليمات_[ق] := ت; }; }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    // Predecessor counts (an edge's target counted once per block).
    ليكن السوابق: متغير متجه طبيعي = [];
    ف := 0;
    احجز_سعة(السوابق, عدد_الكتل);
    طالما (ف < عدد_الكتل) { ألحق(السوابق, 0); ف := ف + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ليكن الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
        ليكن خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            ليكن ه: طبيعي = الخلفاء[خ].القيمة مثل طبيعي;
            إذا (ه < عدد_الكتل) { السوابق[ه] := السوابق[ه] + 1; };
            خ := خ + 1;
        }
        ك := ك + 1;
    }
    ليكن السياق: سياق_فحص_مدى = {
        التعريفات_الكتلة: الكتل_,
        التعريفات_التعليمة: التعليمات_,
        السوابق: السوابق,
        الهيمنة: حلل_هيمنة_مسير(الدالة)
    };
    // Decide first, rewrite after: the facts read the program as it is.
    ليكن المثبتة: متغير متجه طبيعي = [];
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الحسابات.الحسابات) مثل طبيعي)) {
        ليكن السجل: &حساب_بمخرج_تجاوز_مسير = &الحسابات.الحسابات[ر];
        ليكن جمع: متغير منطقي = خطأ;
        ليكن مقبول: متغير منطقي = (*السجل).إشارة_معروفة;
        طابق (*السجل).العملية مع
        | عملية_حساب_صحيح.جمع -> { جمع := صواب; }
        | عملية_حساب_صحيح.طرح -> { }
        | _ -> { مقبول := خطأ; };
        إذا (مقبول && !قيمة_طول_محتمل_فحص(الدالة, (*السجل).الناتج)) {
            طابق نوع_مصدر_فحص(الدالة, (*السجل).الناتج) مع
            | اختياري.موجود(النوع) -> {
                طابق حدود_نوع_مسير_فحص(الأنواع, النوع) مع
                | اختياري.موجود(الحدود) -> {
                    إذا (الحدود.موقع == (*السجل).موقع) {
                        ليكن أ: مدى_فحص = مدى_في_كتلة_فحص(الدالة, &السياق, الأنواع, (*السجل).اليسار, (*السجل).الكتلة, &الحدود);
                        ليكن ب: مدى_فحص = مدى_في_كتلة_فحص(الدالة, &السياق, الأنواع, (*السجل).اليمين, (*السجل).الكتلة, &الحدود);
                        إذا (آمن_فحص(&أ, &ب, جمع, &الحدود)) { ألحق(المثبتة, ر); };
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        };
        ر := ر + 1;
    }
    ر := 0;
    طالما (ر < (الطول(المثبتة) مثل طبيعي)) {
        ليكن السجل: &حساب_بمخرج_تجاوز_مسير = &الحسابات.الحسابات[المثبتة[ر]];
        ليكن ك_: طبيعي = (*السجل).الكتلة;
        ليكن م_: طبيعي = (*السجل).المتابعة;
        ليكن بلا_حجج: متجه معرف_قيمة_مسير = [];
        ليكن الحافة: حافة_مسير = { الهدف: (*الدالة).الكتل[م_].المعرف, الحجج: بلا_حجج };
        (*الدالة).الكتل[ك_].المنهي := اختياري.موجود(منهي_مسير.فرع(الحافة));
        ليكن الملتفة: متغير عملية_حساب_صحيح = عملية_حساب_صحيح.طرح_ملتف();
        طابق (*السجل).العملية مع
        | عملية_حساب_صحيح.جمع -> { الملتفة := عملية_حساب_صحيح.جمع_ملتف(); }
        | _ -> { };
        ليكن ح: حساب_صحيح_مسير = { العملية: الملتفة, اليسار: (*السجل).اليسار, اليمين: (*السجل).اليمين };
        (*الدالة).الكتل[م_].التعليمات[0].العملية := عملية_مسير.حساب_صحيح(ح);
        ر := ر + 1;
    }
    أرجع (الطول(المثبتة) مثل طبيعي) > 0;
}

// Removes the proven checks of every function المحسنة marks but the module
// initializer; the functions it changed, by position.
عام عرف احذف_فحوصا_مثبتة_برنامج_مسير(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    المحسنة: &متجه منطقي
): متجه منطقي {
    ليكن المتغيرة: متغير متجه منطقي = [];
    ليكن د: متغير طبيعي = 0;
    احجز_سعة(المتغيرة, (الطول((*البرنامج).الدوال) مثل طبيعي));
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) { ألحق(المتغيرة, خطأ); د := د + 1; }
    د := 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي) && د < (الطول(*المحسنة) مثل طبيعي)) {
        ليكن مستثناة: متغير منطقي = !(*المحسنة)[د];
        طابق (*البرنامج).دالة_تهيئة_الوحدة مع
        | اختياري.موجود(م) -> { إذا ((م.القيمة مثل طبيعي) == د) { مستثناة := صواب; }; }
        | اختياري.لا_شيء -> { };
        إذا (!مستثناة && دالة_بعمل_وقت_ترجمة_فحص(&(*البرنامج).الدوال[د])) { مستثناة := صواب; };
        إذا (!مستثناة) {
            // The recognizer reads the program; the rewrite takes the function
            // out of it while it changes it.
            ليكن الدالة: متغير دالة_مسير = دالة_فارغة_فحص((*البرنامج).الدوال[د].المعرف);
            بدّل((*البرنامج).الدوال[د], الدالة);
            ليكن تغيرت: منطقي = احذف_فحوصا_مثبتة_دالة_مسير(البرنامج, &متغير الدالة, الأنواع);
            بدّل((*البرنامج).الدوال[د], الدالة);
            إذا (تغيرت) { المتغيرة[د] := صواب; };
        };
        د := د + 1;
    }
    أرجع المتغيرة;
}

// Whether a function holds compile-time work (left as lowered).
عرف دالة_بعمل_وقت_ترجمة_فحص(الدالة: &دالة_مسير): منطقي {
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            إذا ((*الدالة).الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة) { أرجع صواب; };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع خطأ;
}

// An empty function holding a place while one is taken out.
عرف دالة_فارغة_فحص(المعرف: معرف_دالة_مسير): دالة_مسير {
    ليكن بلا_قيم: متجه قيمة_مسير = [];
    ليكن بلا_منطق: متجه منطقي = [];
    ليكن بلا_أنواع: متجه معرف_نوع = [];
    ليكن بلا_كتل: متجه كتلة_مسير = [];
    ليكن بلا_معاملات: متجه قيمة_مسير = [];
    ليكن الدالة: دالة_مسير = {
        المعرف: المعرف,
        المعاملات: بلا_معاملات,
        معاملات_وقت_الترجمة: بلا_منطق,
        الالتقاطات: بلا_أنواع,
        الناتج: اختياري.لا_شيء(),
        المدخل: اختياري.لا_شيء(),
        الكتل: بلا_كتل,
        القيم: بلا_قيم,
        القيمة_التالية: 0
    };
    أرجع الدالة;
}
