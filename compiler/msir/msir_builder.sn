استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.names.identifiers;
استورد compiler.runtime.primitive_identity;
استورد compiler.source.provenance;
استورد compiler.source.span;
استورد compiler.debuginfo.model;
استورد compiler.msir.debug_contract;

عام نوع خطأ_بناء_مسير =
    | دالة_غير_موجودة بنوع معرف_دالة_مسير
    | دالة_خارجية_غير_موجودة بنوع معرف_دالة_خارجية_مسير
    | كتلة_غير_موجودة بنوع معرف_كتلة_مسير
    | كتلة_من_دالة_أخرى بنوع (معرف_كتلة_مسير, معرف_دالة_مسير)
    | قيمة_غير_موجودة بنوع معرف_قيمة_مسير
    | قيمة_من_دالة_أخرى بنوع (معرف_قيمة_مسير, معرف_دالة_مسير)
    | كتلة_منتهية بنوع معرف_كتلة_مسير
;

عام نوع نتيجة_بناء_كتلة_مسير =
    | مبنية بنوع معرف_كتلة_مسير
    | مرفوضة بنوع خطأ_بناء_مسير
;

عام نوع نتيجة_بناء_قيمة_مسير =
    | مبنية بنوع معرف_قيمة_مسير
    | بلا_قيمة
    | مرفوضة بنوع خطأ_بناء_مسير
;

عام نوع نتيجة_بناء_منهي_مسير =
    | مبني
    | مرفوض بنوع خطأ_بناء_مسير
;

// Instruction construction state is intentionally separate from Program_MSIR.
// It carries only the compact source provenance cursor used by newly emitted instructions.
عام نوع حالة_بناء_مسير = {
    الأصل_الحالي: اختيار معرف_أصل_مصدر,
    موقع_التصحيح_الحالي: اختيار معرف_موقع_تصحيح,
    نطاق_التصحيح_الحالي: اختيار معرف_نطاق_تصحيح
};

عام عرف حالة_بناء_مسير_جديدة(): حالة_بناء_مسير {
    دع لا_أصل: اختيار معرف_أصل_مصدر = اختيار.لا_شيء();
    دع لا_موقع: اختيار معرف_موقع_تصحيح = اختيار.لا_شيء();
    دع لا_نطاق: اختيار معرف_نطاق_تصحيح = اختيار.لا_شيء();
    دع الحالة: حالة_بناء_مسير = {
        الأصل_الحالي: لا_أصل,
        موقع_التصحيح_الحالي: لا_موقع,
        نطاق_التصحيح_الحالي: لا_نطاق
    };
    أرجع الحالة;
}

عام عرف عين_مرجع_تصحيح_مسير(
    البناء: &متغير حالة_بناء_مسير,
    الأصل: معرف_أصل_مصدر,
    الموقع: معرف_موقع_تصحيح,
    النطاق: اختيار معرف_نطاق_تصحيح
): فراغ {
    (*البناء).الأصل_الحالي := اختيار.بعض(الأصل);
    (*البناء).موقع_التصحيح_الحالي := اختيار.بعض(الموقع);
    (*البناء).نطاق_التصحيح_الحالي := النطاق;
}

عام عرف امسح_مرجع_تصحيح_مسير(البناء: &متغير حالة_بناء_مسير): فراغ {
    (*البناء).الأصل_الحالي := اختيار.لا_شيء();
    (*البناء).موقع_التصحيح_الحالي := اختيار.لا_شيء();
    (*البناء).نطاق_التصحيح_الحالي := اختيار.لا_شيء();
}

عام عرف برنامج_مسير_جديد(): برنامج_مسير {
    دع الدوال: متجه دالة_مسير = [];
    دع الدوال_الخارجية: متجه دالة_خارجية_مسير = [];
    دع العوام: متجه عام_مسير = [];
    دع دالة_البدء: اختيار معرف_دالة_مسير = اختيار.لا_شيء();
    دع البرنامج: برنامج_مسير = {
        الدوال: الدوال,
        الدوال_الخارجية: الدوال_الخارجية,
        العوام: العوام,
        دالة_بدء_البرنامج: دالة_البدء
    };
    أرجع البرنامج;
}

عام عرف عين_دالة_بدء_برنامج_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير
): اختيار خطأ_بناء_مسير {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة)) {
        أرجع اختيار.بعض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة));
    };
    (*البرنامج).دالة_بدء_البرنامج := اختيار.بعض(الدالة);
    أرجع اختيار.لا_شيء();
}

عرف كتلة_منتهية_للبناء(
    الدالة: &دالة_مسير,
    المعرف: معرف_كتلة_مسير
): منطقي {
    طابق (*الدالة).الكتل[المعرف.القيمة].المنهي مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف أضف_تعليمة_مسير(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة_معرف: معرف_كتلة_مسير,
    العملية: عملية_مسير,
    نوع_الناتج: اختيار معرف_نوع
): نتيجة_بناء_قيمة_مسير {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة_معرف)) {
        أرجع نتيجة_بناء_قيمة_مسير.مرفوضة(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    لو (!دالتا_مسير_متساويتان(الكتلة_معرف.الدالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_قيمة_مسير.مرفوضة(
            خطأ_بناء_مسير.كتلة_من_دالة_أخرى(الكتلة_معرف, الدالة_معرف)
        );
    };
    لو (!كتلة_مسير_موجودة(&(*البرنامج).الدوال[الدالة_معرف.القيمة], الكتلة_معرف)) {
        أرجع نتيجة_بناء_قيمة_مسير.مرفوضة(خطأ_بناء_مسير.كتلة_غير_موجودة(الكتلة_معرف));
    };
    لو (كتلة_منتهية_للبناء(&(*البرنامج).الدوال[الدالة_معرف.القيمة], الكتلة_معرف)) {
        أرجع نتيجة_بناء_قيمة_مسير.مرفوضة(خطأ_بناء_مسير.كتلة_منتهية(الكتلة_معرف));
    };

    دع الناتج: اختيار قيمة_مسير = اختيار.لا_شيء();
    دع الناتج_المحلي: متغير اختيار قيمة_مسير = الناتج;
    طابق نوع_الناتج مع
    | اختيار.بعض(النوع) -> {
        دع المعرف: معرف_قيمة_مسير = معرف_قيمة_مسير_من(
            الدالة_معرف,
            (*البرنامج).الدوال[الدالة_معرف.القيمة].القيمة_التالية
        );
        (*البرنامج).الدوال[الدالة_معرف.القيمة].القيمة_التالية :=
            (*البرنامج).الدوال[الدالة_معرف.القيمة].القيمة_التالية + 1;
        دع القيمة: قيمة_مسير = {
            المعرف: المعرف,
            النوع: النوع
        };
        ألحق((*البرنامج).الدوال[الدالة_معرف.القيمة].القيم, القيمة);
        الناتج_المحلي := اختيار.بعض(القيمة);
    }
    | اختيار.لا_شيء -> { };

    دع حالة_البناء: حالة_بناء_مسير = *البناء;
    دع التعليمة: تعليمة_مسير = {
        الناتج: الناتج_المحلي,
        العملية: العملية,
        الأصل: حالة_البناء.الأصل_الحالي,
        موقع_التصحيح: حالة_البناء.موقع_التصحيح_الحالي,
        نطاق_التصحيح: حالة_البناء.نطاق_التصحيح_الحالي
    };
    ألحق((*البرنامج).الدوال[الدالة_معرف.القيمة].الكتل[الكتلة_معرف.القيمة].التعليمات, التعليمة);

    طابق الناتج_المحلي مع
    | اختيار.بعض(القيمة) -> { أرجع نتيجة_بناء_قيمة_مسير.مبنية(القيمة.المعرف); }
    | اختيار.لا_شيء -> { أرجع نتيجة_بناء_قيمة_مسير.بلا_قيمة(); };
}

عام عرف أضف_عاما_مسير(
    البرنامج: &متغير برنامج_مسير,
    النوع: معرف_نوع,
    التهيئة: ثابت_مسير,
    قابل_للكتابة: منطقي
): معرف_عام_مسير {
    دع المعرف: معرف_عام_مسير = معرف_عام_مسير_من(الطول((*البرنامج).العوام) مثل غير_موقع);
    دع العام: عام_مسير = { المعرف: المعرف, النوع: النوع, التهيئة: التهيئة, قابل_للكتابة: قابل_للكتابة };
    ألحق((*البرنامج).العوام, العام);
    أرجع المعرف;
}

عام عرف أضف_دالة_خارجية_مسير(
    البرنامج: &متغير برنامج_مسير,
    الاسم: متجه غ8,
    أنواع_المعاملات: &متجه معرف_نوع,
    الناتج: اختيار معرف_نوع
): معرف_دالة_خارجية_مسير {
    دع المعرف: معرف_دالة_خارجية_مسير = معرف_دالة_خارجية_مسير_من(
        الطول((*البرنامج).الدوال_الخارجية) مثل غير_موقع
    );
    دع المعاملات: متجه معرف_نوع = *أنواع_المعاملات;
    دع الدالة: دالة_خارجية_مسير = {
        المعرف: المعرف, الاسم: الاسم, المعاملات: المعاملات, الناتج: الناتج
    };
    ألحق((*البرنامج).الدوال_الخارجية, الدالة);
    أرجع المعرف;
}

عام عرف أضف_دالة_مسير(
    البرنامج: &متغير برنامج_مسير,
    أنواع_المعاملات: &متجه معرف_نوع,
    الناتج: اختيار معرف_نوع
): معرف_دالة_مسير {
    دع المعرف: معرف_دالة_مسير = معرف_دالة_مسير_من(الطول((*البرنامج).الدوال) مثل غير_موقع);
    دع المعاملات: متغير متجه قيمة_مسير = [];
    دع القيم: متغير متجه قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*أنواع_المعاملات) مثل غير_موقع)) {
        دع معرف_المعامل: معرف_قيمة_مسير = معرف_قيمة_مسير_من(المعرف, ف);
        دع نوع_المعامل: معرف_نوع = (*أنواع_المعاملات)[ف];
        دع قيمة_المعامل: قيمة_مسير = { المعرف: معرف_المعامل, النوع: نوع_المعامل };
        ألحق(المعاملات, قيمة_المعامل);
        ألحق(القيم, قيمة_المعامل);
        ف := ف + 1;
    }
    دع الالتقاطات: متجه معرف_نوع = [];
    دع الكتل: متجه كتلة_مسير = [];
    دع بلا_مدخل: اختيار معرف_كتلة_مسير = اختيار.لا_شيء();
    دع القيمة_التالية: غير_موقع = الطول(المعاملات) مثل غير_موقع;
    دع الدالة: دالة_مسير = {
        المعرف: المعرف,
        المعاملات: المعاملات,
        الالتقاطات: الالتقاطات,
        الناتج: الناتج,
        المدخل: بلا_مدخل,
        الكتل: الكتل,
        القيم: القيم,
        القيمة_التالية: القيمة_التالية
    };
    ألحق((*البرنامج).الدوال, الدالة);
    أرجع المعرف;
}

عام عرف عين_التقاطات_دالة_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الالتقاطات: &متجه معرف_نوع
): اختيار خطأ_بناء_مسير {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة)) {
        أرجع اختيار.بعض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة));
    };
    (*البرنامج).الدوال[الدالة.القيمة].الالتقاطات := *الالتقاطات;
    أرجع اختيار.لا_شيء();
}

عام عرف أضف_كتلة_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة_معرف: معرف_دالة_مسير
): نتيجة_بناء_كتلة_مسير {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة_معرف)) {
        أرجع نتيجة_بناء_كتلة_مسير.مرفوضة(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    دع المعرف: معرف_كتلة_مسير = معرف_كتلة_مسير_من(
        الدالة_معرف,
        الطول((*البرنامج).الدوال[الدالة_معرف.القيمة].الكتل) مثل غير_موقع
    );
    دع المعاملات: متجه قيمة_مسير = [];
    دع التعليمات: متجه تعليمة_مسير = [];
    دع بلا_منهي: اختيار منهي_مسير = اختيار.لا_شيء();
    دع الكتلة: كتلة_مسير = {
        المعرف: المعرف,
        المعاملات: المعاملات,
        التعليمات: التعليمات,
        المنهي: بلا_منهي
    };
    ألحق((*البرنامج).الدوال[الدالة_معرف.القيمة].الكتل, الكتلة);
    طابق (*البرنامج).الدوال[الدالة_معرف.القيمة].المدخل مع
    | اختيار.لا_شيء -> { (*البرنامج).الدوال[الدالة_معرف.القيمة].المدخل := اختيار.بعض(المعرف); }
    | اختيار.بعض(_) -> { };
    أرجع نتيجة_بناء_كتلة_مسير.مبنية(المعرف);
}

عام عرف أضف_معامل_كتلة_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة_معرف: معرف_كتلة_مسير,
    النوع: معرف_نوع
): نتيجة_بناء_قيمة_مسير {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة_معرف)) {
        أرجع نتيجة_بناء_قيمة_مسير.مرفوضة(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    لو (!دالتا_مسير_متساويتان(الكتلة_معرف.الدالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_قيمة_مسير.مرفوضة(
            خطأ_بناء_مسير.كتلة_من_دالة_أخرى(الكتلة_معرف, الدالة_معرف)
        );
    };
    لو (!كتلة_مسير_موجودة(&(*البرنامج).الدوال[الدالة_معرف.القيمة], الكتلة_معرف)) {
        أرجع نتيجة_بناء_قيمة_مسير.مرفوضة(خطأ_بناء_مسير.كتلة_غير_موجودة(الكتلة_معرف));
    };
    لو (كتلة_منتهية_للبناء(&(*البرنامج).الدوال[الدالة_معرف.القيمة], الكتلة_معرف)) {
        أرجع نتيجة_بناء_قيمة_مسير.مرفوضة(خطأ_بناء_مسير.كتلة_منتهية(الكتلة_معرف));
    };
    دع المعرف: معرف_قيمة_مسير = معرف_قيمة_مسير_من(
        الدالة_معرف,
        (*البرنامج).الدوال[الدالة_معرف.القيمة].القيمة_التالية
    );
    (*البرنامج).الدوال[الدالة_معرف.القيمة].القيمة_التالية :=
        (*البرنامج).الدوال[الدالة_معرف.القيمة].القيمة_التالية + 1;
    دع القيمة: قيمة_مسير = { المعرف: المعرف, النوع: النوع };
    ألحق((*البرنامج).الدوال[الدالة_معرف.القيمة].القيم, القيمة);
    ألحق((*البرنامج).الدوال[الدالة_معرف.القيمة].الكتل[الكتلة_معرف.القيمة].المعاملات, القيمة);
    أرجع نتيجة_بناء_قيمة_مسير.مبنية(المعرف);
}

عام عرف أصدر_ثابتا_مسير(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الثابت: ثابت_مسير,
    النوع: معرف_نوع
): نتيجة_بناء_قيمة_مسير {
    أرجع أضف_تعليمة_مسير(
        البرنامج,
        البناء,
        الدالة,
        الكتلة,
        عملية_مسير.ثابت(الثابت),
        اختيار.بعض(النوع)
    );
}

// يستلم تسلسل البايتات المفكوك المقنن وينقله إلى MSIR كما هو؛ لا توجد طبقة فك ثانية هنا.
عام عرف أصدر_ثابت_نص_مسير(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    البايتات: متجه غ8,
    النوع: معرف_نوع
): نتيجة_بناء_قيمة_مسير {
    أرجع أصدر_ثابتا_مسير(
        البرنامج,
        البناء,
        الدالة,
        الكتلة,
        ثابت_مسير.نص(البايتات),
        النوع
    );
}

عام عرف أصدر_عنوان_دالة_مسير(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الهدف: معرف_دالة_مسير,
