عرف ضع_منهي_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة_معرف: معرف_كتلة_مسير,
    المنهي: منهي_مسير
): نتيجة_بناء_منهي_مسير {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    لو (!دالتا_مسير_متساويتان(الكتلة_معرف.الدالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(
            خطأ_بناء_مسير.كتلة_من_دالة_أخرى(الكتلة_معرف, الدالة_معرف)
        );
    };
    لو (!كتلة_مسير_موجودة(&(*البرنامج).الدوال[الدالة_معرف.القيمة], الكتلة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.كتلة_غير_موجودة(الكتلة_معرف));
    };
    لو (كتلة_منتهية_للبناء(&(*البرنامج).الدوال[الدالة_معرف.القيمة], الكتلة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.كتلة_منتهية(الكتلة_معرف));
    };
    (*البرنامج).الدوال[الدالة_معرف.القيمة].الكتل[الكتلة_معرف.القيمة].المنهي := اختيار.بعض(المنهي);
    أرجع نتيجة_بناء_منهي_مسير.مبني();
}

