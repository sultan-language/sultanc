    };
    دع القيم: متجه معرف_قيمة_مسير = [المؤشر, الفهرس];
    دع العملية: موضع_تخزين_عنصر_مؤشر_مسير = { المؤشر: المؤشر, الفهرس: الفهرس };
    أرجع أضف_تعليمة_مسير(
        البرنامج,
        الدالة_معرف,
