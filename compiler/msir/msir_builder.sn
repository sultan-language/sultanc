    الحجج: &متجه معرف_قيمة_مسير
): نتيجة_بناء_منهي_مسير {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    لو (!دالتا_مسير_متساويتان(الهدف.الدالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(
            خطأ_بناء_مسير.كتلة_من_دالة_أخرى(الهدف, الدالة_معرف)
        );
    };
    لو (!كتلة_مسير_موجودة(&(*البرنامج).الدوال[الدالة_معرف.القيمة], الهدف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.كتلة_غير_موجودة(الهدف));
    };
    دع حجج_الحافة: متجه معرف_قيمة_مسير = *الحجج;
    دع الحافة: حافة_مسير = {
        الهدف: الهدف,
        الحجج: حجج_الحافة
    };
    أرجع ضع_منهي_مسير(البرنامج, الدالة_معرف, الكتلة, منهي_مسير.فرع(الحافة));
}

عام عرف اختم_بفرع_شرطي_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الشرط: معرف_قيمة_مسير,
    عند_الصواب: حافة_مسير,
    عند_الخطأ: حافة_مسير
): نتيجة_بناء_منهي_مسير {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    لو (!كتلة_مسير_موجودة(&(*البرنامج).الدوال[الدالة_معرف.القيمة], عند_الصواب.الهدف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(
            خطأ_بناء_مسير.كتلة_غير_موجودة(عند_الصواب.الهدف)
        );
    };
    لو (!كتلة_مسير_موجودة(&(*البرنامج).الدوال[الدالة_معرف.القيمة], عند_الخطأ.الهدف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(
            خطأ_بناء_مسير.كتلة_غير_موجودة(عند_الخطأ.الهدف)
        );
    };
    أرجع ضع_منهي_مسير(
        البرنامج,
        الدالة_معرف,
        الكتلة,
        منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ)
    );
}

عام عرف اختم_بإرجاع_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    القيمة: اختيار معرف_قيمة_مسير
): نتيجة_بناء_منهي_مسير {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    طابق القيمة مع
    | اختيار.بعض(المعرف) -> {
    }
    | اختيار.لا_شيء -> {
    };
    أرجع ضع_منهي_مسير(
        البرنامج,
        الدالة_معرف,
        الكتلة,
        منهي_مسير.إرجاع(القيمة)
    );
}

عام عرف اختم_بفخ_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير
): نتيجة_بناء_منهي_مسير {
    أرجع ضع_منهي_مسير(البرنامج, الدالة, الكتلة, منهي_مسير.فخ());
}
