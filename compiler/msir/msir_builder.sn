        البرنامج, الدالة_معرف, الكتلة, عملية_مسير.بناء_صندوق(العملية), اختيار.بعض(النوع)
    );
}

عرف ضع_منهي_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة_معرف: معرف_كتلة_مسير,
    المنهي: منهي_مسير
): نتيجة_بناء_منهي_مسير {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    لو (!دالة_مسير_موجودة(&الحالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    لو (!دالتا_مسير_متساويتان(الكتلة_معرف.الدالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(
            خطأ_بناء_مسير.كتلة_من_دالة_أخرى(الكتلة_معرف, الدالة_معرف)
        );
    };
    لو (!كتلة_مسير_موجودة(&الحالة.الدوال[الدالة_معرف.القيمة], الكتلة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.كتلة_غير_موجودة(الكتلة_معرف));
    };
    لو (كتلة_منتهية_للبناء(&الحالة.الدوال[الدالة_معرف.القيمة], الكتلة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.كتلة_منتهية(الكتلة_معرف));
    };
    الحالة.الدوال[الدالة_معرف.القيمة].الكتل[الكتلة_معرف.القيمة].المنهي := اختيار.بعض(المنهي);
    *البرنامج := الحالة;
    أرجع نتيجة_بناء_منهي_مسير.مبني();
}

عام عرف اختم_بفرع_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الهدف: معرف_كتلة_مسير,
    الحجج: &متجه معرف_قيمة_مسير
): نتيجة_بناء_منهي_مسير {
    دع الحالة: برنامج_مسير = *البرنامج;
    لو (!دالة_مسير_موجودة(&الحالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    دع الدالة: &دالة_مسير = &الحالة.الدوال[الدالة_معرف.القيمة];
    لو (!دالتا_مسير_متساويتان(الهدف.الدالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(
            خطأ_بناء_مسير.كتلة_من_دالة_أخرى(الهدف, الدالة_معرف)
        );
    };
    لو (!كتلة_مسير_موجودة(الدالة, الهدف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.كتلة_غير_موجودة(الهدف));
    };
    دع حجج_الحافة: متجه معرف_قيمة_مسير = *الحجج;
    دع الحافة: حافة_مسير = {
        الهدف: الهدف,
        الحجج: حجج_الحافة
    };
    أرجع ضع_منهي_مسير(البرنامج, الدالة_معرف, الكتلة, منهي_مسير.فرع(الحافة));
}

عام عرف اختم_بفرع_شرطي_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الشرط: معرف_قيمة_مسير,
    عند_الصواب: حافة_مسير,
    عند_الخطأ: حافة_مسير
): نتيجة_بناء_منهي_مسير {
    دع الحالة: برنامج_مسير = *البرنامج;
    لو (!دالة_مسير_موجودة(&الحالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    دع الدالة: &دالة_مسير = &الحالة.الدوال[الدالة_معرف.القيمة];
    لو (!كتلة_مسير_موجودة(الدالة, عند_الصواب.الهدف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(
            خطأ_بناء_مسير.كتلة_غير_موجودة(عند_الصواب.الهدف)
        );
    };
    لو (!كتلة_مسير_موجودة(الدالة, عند_الخطأ.الهدف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(
            خطأ_بناء_مسير.كتلة_غير_موجودة(عند_الخطأ.الهدف)
        );
    };
    أرجع ضع_منهي_مسير(
        البرنامج,
        الدالة_معرف,
        الكتلة,
        منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ)
    );
}

عام عرف اختم_بإرجاع_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    القيمة: اختيار معرف_قيمة_مسير
): نتيجة_بناء_منهي_مسير {
    دع الحالة: برنامج_مسير = *البرنامج;
    لو (!دالة_مسير_موجودة(&الحالة, الدالة_معرف)) {
        أرجع نتيجة_بناء_منهي_مسير.مرفوض(خطأ_بناء_مسير.دالة_غير_موجودة(الدالة_معرف));
    };
    دع الدالة: &دالة_مسير = &الحالة.الدوال[الدالة_معرف.القيمة];
    طابق القيمة مع
    | اختيار.بعض(المعرف) -> {
    }
    | اختيار.لا_شيء -> {
    };
    أرجع ضع_منهي_مسير(
        البرنامج,
        الدالة_معرف,
        الكتلة,
        منهي_مسير.إرجاع(القيمة)
    );
}

عام عرف اختم_بفخ_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير
): نتيجة_بناء_منهي_مسير {
    أرجع ضع_منهي_مسير(البرنامج, الدالة, الكتلة, منهي_مسير.فخ());
}
