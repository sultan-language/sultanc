استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_renumbering;
استورد compiler.msir.msir_promotion;
استورد compiler.msir.msir_inlining;
استورد compiler.msir.debug_contract;
استورد compiler.msir.msir_analysis;
استورد compiler.frontend.types.type_identity;

// Control-flow simplification, after inlining in the optimization pipeline
// (msir_optimization_pipeline.sn):
// - jump threading: an edge into a block that only branches (it may also
//   define constants) goes straight to where that block would go when the
//   block jumps unconditionally, or branches on a parameter the edge passes
//   a constant for. `&&`, `||` and `!` lower to such blocks with a bool
//   parameter, so a known operand no longer travels through a parameter and
//   a test;
// - a compare of two integer constants becomes its bool, and a conditional
//   branch on a constant becomes a jump;
// - a jump to a block that only returns returns itself;
// - a block entered from only one other block's jump is merged into it (an
//   inlined callee's entry and return, the join of a `&&` whose other side
//   was threaded away), so a compare that ends it feeds its branch directly;
// - unreachable blocks are dropped;
// - block parameters that are copies of one value, duplicates of another
//   parameter or read by nothing are removed (below);
// - repeated pure expressions are computed once (below).
// A merged block's parameters become the values passed to it; the function
// is renumbered densely at the end. The verifier checks the result.

عرف حد_جولات_التدفق(): طبيعي { أرجع 8; }
عرف حد_قفزات_التمرير(): طبيعي { أرجع 4; }

// The bool constant each value is (by value index): 0 unknown, 1 false,
// 2 true.
عرف ثوابت_منطقية_دالة(الدالة: &دالة_مسير): متجه طبيعي {
    دع الثوابت: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الدالة).القيمة_التالية) { ألحق(الثوابت, 0); ف := ف + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع القيمة_المنطقية: متغير طبيعي = 0;
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.ثابت(الثابت) -> {
                طابق الثابت مع
                | ثابت_مسير.منطق(ق) -> { إذا (ق) { القيمة_المنطقية := 2; } وإلا { القيمة_المنطقية := 1; }; }
                | _ -> { };
            }
            | _ -> { };
            إذا (القيمة_المنطقية != 0) {
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
                | اختياري.موجود(ن) -> {
                    إذا ((ن.المعرف.القيمة مثل طبيعي) < (الطول(الثوابت) مثل طبيعي)) {
                        الثوابت[ن.المعرف.القيمة] := القيمة_المنطقية;
                    };
                }
                | اختياري.لا_شيء -> { };
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الثوابت;
}

// The kind of an integer constant (1 signed, 2 unsigned; 0 for any other
// constant) and its bit pattern.
عرف صنف_ثابت_صحيح_تدفق(الثابت: &ثابت_مسير): طبيعي {
    طابق *الثابت مع
    | ثابت_مسير.صحيح_موقع(_) -> { أرجع 1; }
    | ثابت_مسير.صحيح_طبيعي(_) -> { أرجع 2; }
    | _ -> { أرجع 0; };
}

عرف بتات_ثابت_صحيح_تدفق(الثابت: &ثابت_مسير): طبيعي {
    طابق *الثابت مع
    | ثابت_مسير.صحيح_موقع(ع) -> { أرجع ع مثل طبيعي; }
    | ثابت_مسير.صحيح_طبيعي(ط) -> { أرجع ط; }
    | _ -> { أرجع 0; };
}

// The value of a compare of two integer constants of one kind.
عرف قارن_ثابتين_تدفق(العملية: عملية_مقارنة_صحيح, الصنف: طبيعي, أ: طبيعي, ب: طبيعي): منطقي {
    دع أصغر: متغير منطقي = أ < ب;
    إذا (الصنف == 1) { أصغر := (أ مثل عدد) < (ب مثل عدد); };
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> { أرجع أ == ب; }
    | عملية_مقارنة_صحيح.لا_يساوي -> { أرجع أ != ب; }
    | عملية_مقارنة_صحيح.أصغر -> { أرجع أصغر; }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> { أرجع أصغر || أ == ب; }
    | عملية_مقارنة_صحيح.أكبر -> { أرجع !أصغر && أ != ب; }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> { أرجع !أصغر; };
}

// Replaces each compare of two integer constants by its bool constant (an
// inlined callee's test of a parameter its caller passes a constant for), so
// jump threading takes the branch it feeds. True when one changed.
عرف اطو_مقارنات_ثابتة_مسير(الدالة: &متغير دالة_مسير): منطقي {
    دع العدد: طبيعي = (*الدالة).القيمة_التالية;
    دع الأصناف: متغير متجه طبيعي = [];
    دع البتات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الأصناف, 0); ألحق(البتات, 0); ف := ف + 1; }
    دع تغير: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع الناتج: متغير طبيعي = العدد;
            طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
            | اختياري.موجود(ن) -> { الناتج := ن.المعرف.القيمة; }
            | اختياري.لا_شيء -> { };
            دع المطوية: متغير اختياري منطقي = اختياري.لا_شيء();
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.ثابت(الثابت) -> {
                إذا (الناتج < العدد) {
                    الأصناف[الناتج] := صنف_ثابت_صحيح_تدفق(&الثابت);
                    البتات[الناتج] := بتات_ثابت_صحيح_تدفق(&الثابت);
                };
            }
            | عملية_مسير.مقارنة_صحيح(م) -> {
                دع ي: طبيعي = م.اليسار.القيمة;
                دع ر: طبيعي = م.اليمين.القيمة;
                إذا (ي < العدد && ر < العدد && الأصناف[ي] != 0 && الأصناف[ي] == الأصناف[ر]) {
                    المطوية := اختياري.موجود(قارن_ثابتين_تدفق(م.العملية, الأصناف[ي], البتات[ي], البتات[ر]));
                };
            }
            | _ -> { };
            طابق المطوية مع
            | اختياري.موجود(ق) -> {
                (*الدالة).الكتل[ك].التعليمات[ت].العملية := عملية_مسير.ثابت(ثابت_مسير.منطق(ق));
                تغير := صواب;
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع تغير;
}

// Whether every instruction of the block defines a constant.
عرف كتلة_ثوابت_فقط(الكتلة: &كتلة_مسير): منطقي {
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
        طابق (*الكتلة).التعليمات[ت].العملية مع
        | عملية_مسير.ثابت(_) -> { }
        | _ -> { أرجع خطأ; };
        ت := ت + 1;
    }
    أرجع صواب;
}

// The edge that leaves الهدف (a block with only constants and a branch)
// for an entry by الحافة, or none when it is not known. Arguments that are
// الهدف's parameters become the entry's arguments; constants defined in
// الهدف are copied to the end of the entering block (المضافة).
عرف تمرير_حافة_مسير(
    الدالة: &متغير دالة_مسير,
    المصدر: طبيعي,
    الحافة: &حافة_مسير,
    الثوابت: &متغير متجه طبيعي,
    الاستخدامات: &متجه طبيعي,
    المضافة: &متغير متجه تعليمة_مسير
): اختياري حافة_مسير {
    دع الهدف: طبيعي = (*الحافة).الهدف.القيمة;
    إذا (الهدف == المصدر || الهدف >= (الطول((*الدالة).الكتل) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا (!كتلة_ثوابت_فقط(&(*الدالة).الكتل[الهدف])) { أرجع اختياري.لا_شيء(); };
    // An entry that skips the block must not skip a definition a later
    // block reads: every parameter and constant of the block is read only by
    // its own branch.
    إذا (!قيم_كتلة_محلية(&(*الدالة).الكتل[الهدف], الاستخدامات)) { أرجع اختياري.لا_شيء(); };
    // Decide on the target's branch while only reading the function.
    دع المختارة: متغير اختياري حافة_مسير = اختياري.لا_شيء();
    طابق (*الدالة).الكتل[الهدف].المنهي مع
    | اختياري.موجود(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع(التالية) -> {
            إذا ((الطول((*الدالة).الكتل[الهدف].التعليمات) مثل طبيعي) == 0) {
                المختارة := اختياري.موجود(انسخ_مملوكا_حافة_مسير(&التالية));
            };
        }
        | منهي_مسير.فرع_شرطي(الشرط, الصواب, الخطأ) -> {
            دع القيمة: متغير معرف_قيمة_مسير = الشرط;
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الدالة).الكتل[الهدف].المعاملات) مثل طبيعي)) {
                إذا ((*الدالة).الكتل[الهدف].المعاملات[ف].المعرف.القيمة == الشرط.القيمة
                    && ف < (الطول((*الحافة).الحجج) مثل طبيعي)) {
                    القيمة := (*الحافة).الحجج[ف];
                };
                ف := ف + 1;
            }
            إذا ((القيمة.القيمة مثل طبيعي) < (الطول(*الثوابت) مثل طبيعي)) {
                دع المعروف: طبيعي = (*الثوابت)[القيمة.القيمة];
                إذا (المعروف == 2) { المختارة := اختياري.موجود(انسخ_مملوكا_حافة_مسير(&الصواب)); };
                إذا (المعروف == 1) { المختارة := اختياري.موجود(انسخ_مملوكا_حافة_مسير(&الخطأ)); };
            };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    طابق المختارة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(التالية) -> {
        إذا ((التالية.الهدف.القيمة مثل طبيعي) == الهدف) { أرجع اختياري.لا_شيء(); };
        دع الحجج: متغير متجه معرف_قيمة_مسير = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(التالية.الحجج) مثل طبيعي)) {
            دع الحجة: معرف_قيمة_مسير = التالية.الحجج[ح];
            دع البديل: متغير معرف_قيمة_مسير = الحجة;
            دع وجد: متغير منطقي = خطأ;
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*الدالة).الكتل[الهدف].المعاملات) مثل طبيعي)) {
                إذا ((*الدالة).الكتل[الهدف].المعاملات[ف].المعرف.القيمة == الحجة.القيمة) {
                    إذا (ف >= (الطول((*الحافة).الحجج) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
                    البديل := (*الحافة).الحجج[ف];
                    وجد := صواب;
                };
                ف := ف + 1;
            }
            // A constant of the target: copied into the entering block.
            ف := 0;
            طالما (!وجد && ف < (الطول((*الدالة).الكتل[الهدف].التعليمات) مثل طبيعي)) {
                دع المطابقة: متغير اختياري تعليمة_مسير = اختياري.لا_شيء();
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[الهدف].التعليمات[ف]) مع
                | اختياري.موجود(ن) -> {
                    إذا (ن.المعرف.القيمة == الحجة.القيمة) {
                        المطابقة := اختياري.موجود(انسخ_مملوكا_تعليمة_مسير(&(*الدالة).الكتل[الهدف].التعليمات[ف]));
                    };
                }
                | اختياري.لا_شيء -> { };
                طابق المطابقة مع
                | اختياري.موجود(المنسوخة_الأصل) -> {
                    دع المنسوخة: متغير تعليمة_مسير = المنسوخة_الأصل;
                    دع الجديد: معرف_قيمة_مسير = معرف_قيمة_مسير_من((*الدالة).المعرف, (*الدالة).القيمة_التالية);
                    (*الدالة).القيمة_التالية := (*الدالة).القيمة_التالية + 1;
                    دع النوع: معرف_نوع = (*الدالة).القيم[الحجة.القيمة].النوع;
                    دع القيمة: قيمة_مسير = { المعرف: الجديد, النوع: النوع };
                    ألحق((*الدالة).القيم, القيمة);
                    المنسوخة.الناتج := ناتج_تعليمة_مسير_من(اختياري.موجود(القيمة));
                    ألحق(*المضافة, المنسوخة);
                    إذا ((الحجة.القيمة مثل طبيعي) < (الطول(*الثوابت) مثل طبيعي)) {
                        ألحق(*الثوابت, (*الثوابت)[الحجة.القيمة]);
                    } وإلا {
                        ألحق(*الثوابت, 0);
                    };
                    البديل := الجديد;
                    وجد := صواب;
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            ألحق(الحجج, البديل);
            ح := ح + 1;
        }
        دع الناتج: حافة_مسير = { الهدف: التالية.الهدف, الحجج: الحجج };
        أرجع اختياري.موجود(الناتج);
    };
}

// The uses of a value in a terminator's condition and edge arguments.
عرف عد_في_حافة(الحافة: &حافة_مسير, القيمة: طبيعي): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحافة).الحجج) مثل طبيعي)) {
        إذا (((*الحافة).الحجج[ف].القيمة مثل طبيعي) == القيمة) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف عد_في_منهي(المنهي: &اختياري منهي_مسير, القيمة: طبيعي): طبيعي {
    طابق *المنهي مع
    | اختياري.موجود(م) -> {
        طابق م مع
        | منهي_مسير.فرع(الحافة) -> { أرجع عد_في_حافة(&الحافة, القيمة); }
        | منهي_مسير.فرع_شرطي(الشرط, الصواب, الخطأ) -> {
            دع العدد: متغير طبيعي = عد_في_حافة(&الصواب, القيمة) + عد_في_حافة(&الخطأ, القيمة);
            إذا ((الشرط.القيمة مثل طبيعي) == القيمة) { العدد := العدد + 1; };
            أرجع العدد;
        }
        | _ -> { أرجع 0; };
    }
    | اختياري.لا_شيء -> { أرجع 0; };
}

// Whether every value the block defines (a branch-only block: parameters
// and constants) is used only by its own terminator.
عرف قيم_كتلة_محلية(الكتلة: &كتلة_مسير, الاستخدامات: &متجه طبيعي): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكتلة).المعاملات) مثل طبيعي)) {
        دع ق: طبيعي = (*الكتلة).المعاملات[ف].المعرف.القيمة;
        إذا (ق >= (الطول(*الاستخدامات) مثل طبيعي) || (*الاستخدامات)[ق] != عد_في_منهي(&(*الكتلة).المنهي, ق)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
        طابق موضع_ناتج_تعليمة_مسير(&(*الكتلة).التعليمات[ف]) مع
        | اختياري.موجود(ق) -> {
            إذا (ق >= (الطول(*الاستخدامات) مثل طبيعي) || (*الاستخدامات)[ق] != عد_في_منهي(&(*الكتلة).المنهي, ق)) {
                أرجع خطأ;
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Threads one edge as far as it goes.
عرف مرر_حافة_مسير(
    الدالة: &متغير دالة_مسير,
    المصدر: طبيعي,
    الحافة: حافة_مسير,
    الثوابت: &متغير متجه طبيعي,
    الاستخدامات: &متجه طبيعي,
    المضافة: &متغير متجه تعليمة_مسير,
    تغير: &متغير منطقي
): حافة_مسير {
    دع الحالية: متغير حافة_مسير = الحافة;
    دع القفزات: متغير طبيعي = 0;
    طالما (القفزات < حد_قفزات_التمرير()) {
        طابق تمرير_حافة_مسير(الدالة, المصدر, &الحالية, الثوابت, الاستخدامات, المضافة) مع
        | اختياري.موجود(التالية) -> {
            الحالية := التالية;
            *تغير := صواب;
            القفزات := القفزات + 1;
        }
        | اختياري.لا_شيء -> { القفزات := حد_قفزات_التمرير(); };
    }
    أرجع الحالية;
}

عرف حافتان_متطابقتان_مسير(أ: &حافة_مسير, ب: &حافة_مسير): منطقي {
    إذا ((*أ).الهدف.القيمة != (*ب).الهدف.القيمة) { أرجع خطأ; };
    إذا ((الطول((*أ).الحجج) مثل طبيعي) != (الطول((*ب).الحجج) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*أ).الحجج) مثل طبيعي)) {
        إذا ((*أ).الحجج[ف].القيمة != (*ب).الحجج[ف].القيمة) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// A jump to a block that only returns (no instructions) returns itself, with
// the value the jump passes for the returned parameter: native code then
// returns from each arm (its epilogue copied there) instead of moving the
// result into the shared block's parameter and jumping to it. True when one
// changed.
عرف أرجع_من_القافزات_مسير(الدالة: &متغير دالة_مسير): منطقي {
    دع تغير: متغير منطقي = خطأ;
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع الجديد: متغير اختياري منهي_مسير = اختياري.لا_شيء();
        طابق (*الدالة).الكتل[ك].المنهي مع
        | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> {
            دع الهدف: طبيعي = الحافة.الهدف.القيمة;
            إذا (الهدف < عدد_الكتل && الهدف != ك
                && (الطول((*الدالة).الكتل[الهدف].التعليمات) مثل طبيعي) == 0
                && (الطول(الحافة.الحجج) مثل طبيعي) == (الطول((*الدالة).الكتل[الهدف].المعاملات) مثل طبيعي)) {
                طابق (*الدالة).الكتل[الهدف].المنهي مع
                | اختياري.موجود(منهي_مسير.إرجاع(القيمة)) -> {
                    طابق القيمة مع
                    | اختياري.لا_شيء -> { الجديد := اختياري.موجود(منهي_مسير.إرجاع(اختياري.لا_شيء())); }
                    | اختياري.موجود(ق) -> {
                        دع البديل: متغير معرف_قيمة_مسير = ق;
                        دع ف: متغير طبيعي = 0;
                        طالما (ف < (الطول((*الدالة).الكتل[الهدف].المعاملات) مثل طبيعي)) {
                            إذا ((*الدالة).الكتل[الهدف].المعاملات[ف].المعرف.القيمة == ق.القيمة) {
                                البديل := الحافة.الحجج[ف];
                            };
                            ف := ف + 1;
                        }
                        الجديد := اختياري.موجود(منهي_مسير.إرجاع(اختياري.موجود(البديل)));
                    };
                }
                | _ -> { };
            };
        }
        | _ -> { };
        طابق الجديد مع
        | اختياري.موجود(م) -> { (*الدالة).الكتل[ك].المنهي := اختياري.موجود(م); تغير := صواب; }
        | اختياري.لا_شيء -> { };
        ك := ك + 1;
    }
    أرجع تغير;
}

// Adds (or removes) one use of value ق to الاستخدامات.
عرف عدل_استخدام_تدفق(الاستخدامات: &متغير متجه طبيعي, ق: طبيعي, زيادة: منطقي): فراغ {
    إذا (ق >= (الطول(*الاستخدامات) مثل طبيعي)) { أرجع; };
    إذا (زيادة) { (*الاستخدامات)[ق] := (*الاستخدامات)[ق] + 1; }
    وإلا إذا ((*الاستخدامات)[ق] > 0) { (*الاستخدامات)[ق] := (*الاستخدامات)[ق] - 1; };
}

عرف عدل_استخدامات_حافة_تدفق(الاستخدامات: &متغير متجه طبيعي, الحافة: &حافة_مسير, زيادة: منطقي): فراغ {
    دع ج: متغير طبيعي = 0;
    طالما (ج < (الطول((*الحافة).الحجج) مثل طبيعي)) {
        عدل_استخدام_تدفق(الاستخدامات, (*الحافة).الحجج[ج].القيمة, زيادة);
        ج := ج + 1;
    }
}

// Adds (or removes) a terminator's uses to الاستخدامات (its condition and
// edge arguments, read in place).
عرف عدل_استخدامات_منهي_تدفق(الاستخدامات: &متغير متجه طبيعي, المنهي: &اختياري منهي_مسير, زيادة: منطقي): فراغ {
    طابق *المنهي مع
    | اختياري.موجود(م) -> {
        طابق م مع
        | منهي_مسير.فرع(الحافة) -> { عدل_استخدامات_حافة_تدفق(الاستخدامات, &الحافة, زيادة); }
        | منهي_مسير.فرع_شرطي(الشرط, الصواب, الخطأ) -> {
            عدل_استخدام_تدفق(الاستخدامات, الشرط.القيمة, زيادة);
            عدل_استخدامات_حافة_تدفق(الاستخدامات, &الصواب, زيادة);
            عدل_استخدامات_حافة_تدفق(الاستخدامات, &الخطأ, زيادة);
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            عدل_استخدام_تدفق(الاستخدامات, الفرع.المميز.القيمة, زيادة);
            عدل_استخدامات_حافة_تدفق(الاستخدامات, &الفرع.الافتراضي, زيادة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                عدل_استخدامات_حافة_تدفق(الاستخدامات, &الفرع.الحالات[ف].الحافة, زيادة);
                ف := ف + 1;
            }
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
}

// Threads the edges of every block's terminator; true when one changed. The
// use counts follow each rewritten terminator: an edge threaded into a
// block's successor may read that block's parameters, which then are no
// longer local to it, and a later edge must not skip it.
عرف مرر_حواف_دالة_مسير(الدالة: &متغير دالة_مسير): منطقي {
    دع الثوابت: متغير متجه طبيعي = ثوابت_منطقية_دالة(الدالة);
    دع الاستخدامات: متغير متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, (*الدالة).القيمة_التالية);
    دع تغير: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع المأخوذ: متغير اختياري منهي_مسير = اختياري.لا_شيء();
        بدّل((*الدالة).الكتل[ك].المنهي, المأخوذ);
        عدل_استخدامات_منهي_تدفق(&متغير الاستخدامات, &المأخوذ, خطأ);
        دع المضافة: متغير متجه تعليمة_مسير = [];
        دع الجديد: متغير اختياري منهي_مسير = اختياري.لا_شيء();
        طابق المأخوذ مع
        | اختياري.موجود(المنهي) -> {
            طابق المنهي مع
            | منهي_مسير.فرع(الحافة) -> {
                الجديد := اختياري.موجود(منهي_مسير.فرع(
                    مرر_حافة_مسير(الدالة, ك, الحافة, &متغير الثوابت, &الاستخدامات, &متغير المضافة, &متغير تغير)
                ));
            }
            | منهي_مسير.فرع_شرطي(الشرط, الصواب, الخطأ) -> {
                دع المعروف: متغير طبيعي = 0;
                إذا ((الشرط.القيمة مثل طبيعي) < (الطول(الثوابت) مثل طبيعي)) { المعروف := الثوابت[الشرط.القيمة]; };
                إذا (المعروف == 2) {
                    تغير := صواب;
                    الجديد := اختياري.موجود(منهي_مسير.فرع(
                        مرر_حافة_مسير(الدالة, ك, الصواب, &متغير الثوابت, &الاستخدامات, &متغير المضافة, &متغير تغير)
                    ));
                } وإلا إذا (المعروف == 1) {
                    تغير := صواب;
                    الجديد := اختياري.موجود(منهي_مسير.فرع(
                        مرر_حافة_مسير(الدالة, ك, الخطأ, &متغير الثوابت, &الاستخدامات, &متغير المضافة, &متغير تغير)
                    ));
                } وإلا {
                    دع ص: حافة_مسير = مرر_حافة_مسير(الدالة, ك, الصواب, &متغير الثوابت, &الاستخدامات, &متغير المضافة, &متغير تغير);
                    دع خ: حافة_مسير = مرر_حافة_مسير(الدالة, ك, الخطأ, &متغير الثوابت, &الاستخدامات, &متغير المضافة, &متغير تغير);
                    إذا (حافتان_متطابقتان_مسير(&ص, &خ)) {
                        تغير := صواب;
                        الجديد := اختياري.موجود(منهي_مسير.فرع(ص));
                    } وإلا {
                        الجديد := اختياري.موجود(منهي_مسير.فرع_شرطي(الشرط, ص, خ));
                    };
                };
            }
            | منهي_مسير.فرع_متعدد(الفرع) -> {
                دع الفرع_الجديد: متغير فرع_متعدد_مسير = الفرع;
                دع الافتراضي: حافة_مسير = انسخ_مملوكا_حافة_مسير(&الفرع_الجديد.الافتراضي);
                الفرع_الجديد.الافتراضي := مرر_حافة_مسير(الدالة, ك, الافتراضي, &متغير الثوابت, &الاستخدامات, &متغير المضافة, &متغير تغير);
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الفرع_الجديد.الحالات) مثل طبيعي)) {
                    دع الحالة: حافة_مسير = انسخ_مملوكا_حافة_مسير(&الفرع_الجديد.الحالات[ف].الحافة);
                    الفرع_الجديد.الحالات[ف].الحافة := مرر_حافة_مسير(الدالة, ك, الحالة, &متغير الثوابت, &الاستخدامات, &متغير المضافة, &متغير تغير);
                    ف := ف + 1;
                }
                الجديد := اختياري.موجود(منهي_مسير.فرع_متعدد(الفرع_الجديد));
            }
            | الآخر -> { الجديد := اختياري.موجود(الآخر); };
        }
        | اختياري.لا_شيء -> { };
        عدل_استخدامات_منهي_تدفق(&متغير الاستخدامات, &الجديد, صواب);
        (*الدالة).الكتل[ك].المنهي := الجديد;
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(المضافة) مثل طبيعي)) {
            دع المنقولة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
            بدّل(المضافة[م], المنقولة);
            ألحق((*الدالة).الكتل[ك].التعليمات, المنقولة);
            م := م + 1;
        }
        ك := ك + 1;
    }
    أرجع تغير;
}

عرف عد_حافة_سلف(الأسلاف: &متغير متجه طبيعي, الحافة: &حافة_مسير): فراغ {
    إذا (((*الحافة).الهدف.القيمة مثل طبيعي) < (الطول(*الأسلاف) مثل طبيعي)) {
        (*الأسلاف)[(*الحافة).الهدف.القيمة] := (*الأسلاف)[(*الحافة).الهدف.القيمة] + 1;
    };
}

// The number of edges into each block from blocks reachable from the entry
// (the entry counts one more): a block jump threading left unreachable still
// branches to its old target until it is dropped, and must not keep that
// target from merging.
عرف أسلاف_كتل_مسير(الدالة: &دالة_مسير, الوصول: &متجه منطقي): متجه طبيعي {
    دع الأسلاف: متغير متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) { ألحق(الأسلاف, 0); ك := ك + 1; }
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(م) -> { إذا ((م.القيمة مثل طبيعي) < (الطول(الأسلاف) مثل طبيعي)) { الأسلاف[م.القيمة] := 1; }; }
    | اختياري.لا_شيء -> { };
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        طابق (*الدالة).الكتل[ك].المنهي مع
        | اختياري.موجود(المنهي) -> {
            إذا (ك < (الطول(*الوصول) مثل طبيعي) && (*الوصول)[ك]) { طابق المنهي مع
            | منهي_مسير.فرع(الحافة) -> { عد_حافة_سلف(&متغير الأسلاف, &الحافة); }
            | منهي_مسير.فرع_شرطي(_, الصواب, الخطأ) -> {
                عد_حافة_سلف(&متغير الأسلاف, &الصواب);
                عد_حافة_سلف(&متغير الأسلاف, &الخطأ);
            }
            | منهي_مسير.فرع_متعدد(الفرع) -> {
                عد_حافة_سلف(&متغير الأسلاف, &الفرع.الافتراضي);
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                    عد_حافة_سلف(&متغير الأسلاف, &الفرع.الحالات[ف].الحافة);
                    ف := ف + 1;
                }
            }
            | _ -> { }; };
        }
        | اختياري.لا_شيء -> { };
        ك := ك + 1;
    }
    أرجع الأسلاف;
}

// Merges each block entered only by another block's jump into that block;
// الاستبدال (empty on entry) receives the merged parameters' values: it stays
// empty when no merged block had parameters. True when one merged.
عرف ادمج_كتل_مسير(الدالة: &متغير دالة_مسير, الاستبدال: &متغير متجه إعادة_ترقيم_قيمة_مسير): منطقي {
    دع الوصول: متجه منطقي = الكتل_القابلة_للوصول_مسير(الدالة);
    دع الأسلاف: متجه طبيعي = أسلاف_كتل_مسير(الدالة, &الوصول);
    دع تغير: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع استمر: متغير منطقي = ك < (الطول(الوصول) مثل طبيعي) && الوصول[ك];
        طالما (استمر) {
            استمر := خطأ;
            دع الهدف: متغير طبيعي = 0;
            دع مؤهل: متغير منطقي = خطأ;
            طابق (*الدالة).الكتل[ك].المنهي مع
            | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> {
                الهدف := الحافة.الهدف.القيمة;
                مؤهل := الهدف != ك && الهدف < (الطول(الأسلاف) مثل طبيعي) && الأسلاف[الهدف] == 1
                    && (الطول(الحافة.الحجج) مثل طبيعي) == (الطول((*الدالة).الكتل[الهدف].المعاملات) مثل طبيعي);
            }
            | _ -> { };
            إذا (مؤهل) {
                دع المأخوذ: متغير اختياري منهي_مسير = اختياري.لا_شيء();
                بدّل((*الدالة).الكتل[ك].المنهي, المأخوذ);
                طابق المأخوذ مع
                | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> {
                    // The identity map, made on the first merged parameter.
                    إذا ((الطول(الحافة.الحجج) مثل طبيعي) > 0 && (الطول(*الاستبدال) مثل طبيعي) == 0) {
                        دع ق: متغير طبيعي = 0;
                        طالما (ق < (*الدالة).القيمة_التالية) {
                            دع الربط: إعادة_ترقيم_قيمة_مسير = {
                                القديم: معرف_قيمة_مسير_من((*الدالة).المعرف, ق),
                                الجديد: معرف_قيمة_مسير_من((*الدالة).المعرف, ق)
                            };
                            ألحق(*الاستبدال, الربط);
                            ق := ق + 1;
                        }
                    };
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < (الطول(الحافة.الحجج) مثل طبيعي)) {
                        دع المعامل: طبيعي = (*الدالة).الكتل[الهدف].المعاملات[ف].المعرف.القيمة;
                        إذا (المعامل < (الطول(*الاستبدال) مثل طبيعي)) {
                            (*الاستبدال)[المعامل].الجديد := الحافة.الحجج[ف];
                        };
                        ف := ف + 1;
                    }
                }
                | _ -> { };
                دع بلا_معاملات: متغير متجه قيمة_مسير = [];
                بدّل((*الدالة).الكتل[الهدف].المعاملات, بلا_معاملات);
                دع التعليمات: متغير متجه تعليمة_مسير = [];
                بدّل((*الدالة).الكتل[الهدف].التعليمات, التعليمات);
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(التعليمات) مثل طبيعي)) {
                    دع المنقولة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
                    بدّل(التعليمات[م], المنقولة);
                    ألحق((*الدالة).الكتل[ك].التعليمات, المنقولة);
                    م := م + 1;
                }
                دع منهي_الهدف: متغير اختياري منهي_مسير = اختياري.موجود(منهي_مسير.فخ());
                بدّل((*الدالة).الكتل[الهدف].المنهي, منهي_الهدف);
                (*الدالة).الكتل[ك].المنهي := منهي_الهدف;
                تغير := صواب;
                استمر := صواب;
            };
        }
        ك := ك + 1;
    }
    أرجع تغير;
}

// Drops the blocks not reachable from the entry, renumbering the others by
// position.
عرف احذف_كتلا_ميتة_مسير(الدالة: &متغير دالة_مسير): منطقي {
    دع العدد: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع المدخل: متغير طبيعي = 0;
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(م) -> { المدخل := م.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع مرئية: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(مرئية, خطأ); ف := ف + 1; }
    دع العمل: متغير متجه طبيعي = [المدخل];
    مرئية[المدخل] := صواب;
    طالما ((الطول(العمل) مثل طبيعي) > 0) {
        دع الأخير: طبيعي = (الطول(العمل) مثل طبيعي) - 1;
        دع ك: طبيعي = العمل[الأخير];
        اقتطع(العمل, الأخير);
        دع الخلفاء: متغير متجه طبيعي = [];
        طابق (*الدالة).الكتل[ك].المنهي مع
        | اختياري.موجود(المنهي) -> {
            طابق المنهي مع
            | منهي_مسير.فرع(الحافة) -> { ألحق(الخلفاء, الحافة.الهدف.القيمة); }
            | منهي_مسير.فرع_شرطي(_, الصواب, الخطأ) -> {
                ألحق(الخلفاء, الصواب.الهدف.القيمة); ألحق(الخلفاء, الخطأ.الهدف.القيمة);
            }
            | منهي_مسير.فرع_متعدد(الفرع) -> {
                ألحق(الخلفاء, الفرع.الافتراضي.الهدف.القيمة);
                دع ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الفرع.الحالات) مثل طبيعي)) {
                    ألحق(الخلفاء, الفرع.الحالات[ح].الحافة.الهدف.القيمة);
                    ح := ح + 1;
                }
            }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
        ف := 0;
        طالما (ف < (الطول(الخلفاء) مثل طبيعي)) {
            إذا (الخلفاء[ف] < العدد && !مرئية[الخلفاء[ف]]) {
                مرئية[الخلفاء[ف]] := صواب;
                ألحق(العمل, الخلفاء[ف]);
            };
            ف := ف + 1;
        }
    }
    دع أي_ميتة: متغير منطقي = خطأ;
    دع المواقع: متغير متجه طبيعي = [];
    دع التالي: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < العدد) {
        ألحق(المواقع, التالي);
        إذا (مرئية[ف]) { التالي := التالي + 1; } وإلا { أي_ميتة := صواب; };
        ف := ف + 1;
    }
    إذا (!أي_ميتة) { أرجع خطأ; };
    دع معرف_الدالة: معرف_دالة_مسير = (*الدالة).المعرف;
    دع الجديدة: متغير متجه كتلة_مسير = [];
    ف := 0;
    طالما (ف < العدد) {
        إذا (مرئية[ف]) {
            دع بلا_تعليمات: متجه تعليمة_مسير = [];
            دع بلا_معاملات: متجه قيمة_مسير = [];
            دع المنقولة: متغير كتلة_مسير = {
                المعرف: معرف_كتلة_مسير_من(معرف_الدالة, 0), المعاملات: بلا_معاملات,
                التعليمات: بلا_تعليمات, المنهي: اختياري.لا_شيء()
            };
            بدّل((*الدالة).الكتل[ف], المنقولة);
            المنقولة.المعرف := معرف_كتلة_مسير_من(معرف_الدالة, المواقع[ف]);
            دع المأخوذ: متغير اختياري منهي_مسير = اختياري.لا_شيء();
            بدّل(المنقولة.المنهي, المأخوذ);
            طابق المأخوذ مع
            | اختياري.موجود(م) -> { المنقولة.المنهي := اختياري.موجود(منهي_منقول_بكتل_جديدة(م, &المواقع, معرف_الدالة)); }
            | اختياري.لا_شيء -> { };
            ألحق(الجديدة, المنقولة);
        };
        ف := ف + 1;
    }
    (*الدالة).الكتل := الجديدة;
    (*الدالة).المدخل := اختياري.موجود(معرف_كتلة_مسير_من(معرف_الدالة, المواقع[المدخل]));
    أرجع صواب;
}

// Common subexpressions: an integer operation or conversion, or a field
// read, equal to one already computed in a dominating position (same
// operation, operands and result Type) is dropped and its value replaced by
// the earlier one. These are pure: a trap in the second would have trapped
// the first. Compares are left to be recomputed, so each still feeds its own
// branch's flags. A walk of the dominator tree with a scoped table keyed by the
// first operand (Briggs, Cooper and Simpson's dominator-based value
// numbering, without the hashing).
نوع مفتاح_تعبير_مسير = {
    الرمز: طبيعي,
    الأول: طبيعي,
    الثاني: طبيعي
};

نوع مدخل_تعبير_مسير = {
    المفتاح: مفتاح_تعبير_مسير,
    القيمة: معرف_قيمة_مسير,
    النوع: معرف_نوع
};

عرف رمز_حساب_صحيح_مسير(العملية: عملية_حساب_صحيح): طبيعي {
    طابق العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع 1; }
    | عملية_حساب_صحيح.طرح -> { أرجع 2; }
    | عملية_حساب_صحيح.ضرب -> { أرجع 3; }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع 4; }
    | عملية_حساب_صحيح.قسمة_طبيعية -> { أرجع 5; }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع 6; }
    | عملية_حساب_صحيح.باقي_طبيعي -> { أرجع 7; }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع 8; }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع 9; }
    | عملية_حساب_صحيح.و_بتي -> { أرجع 10; }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع 11; }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع 12; }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع 13; }
    | عملية_حساب_صحيح.جمع_ملتف -> { أرجع 14; }
    | عملية_حساب_صحيح.طرح_ملتف -> { أرجع 15; }
    | عملية_حساب_صحيح.ضرب_ملتف -> { أرجع 16; }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { أرجع 17; };
}

عرف رمز_تحويل_صحيح_مسير(العملية: عملية_تحويل_صحيح): طبيعي {
    طابق العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع 1; }
    | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع 2; }
    | عملية_تحويل_صحيح.اقتطاع -> { أرجع 3; }
    | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع 4; };
}

// The key of a reusable instruction, its operands already replaced through
// الاستبدال.
عرف مفتاح_تعبير_لعملية_مسير(
    العملية: &عملية_مسير,
    الاستبدال: &متجه إعادة_ترقيم_قيمة_مسير
): اختياري مفتاح_تعبير_مسير {
    طابق *العملية مع
    | عملية_مسير.حساب_صحيح(ح) -> {
        دع م: مفتاح_تعبير_مسير = {
            الرمز: 100 + رمز_حساب_صحيح_مسير(ح.العملية),
            الأول: ابحث_إعادة_ترقيم_قيمة(الاستبدال, ح.اليسار).القيمة,
            الثاني: ابحث_إعادة_ترقيم_قيمة(الاستبدال, ح.اليمين).القيمة
        };
        أرجع اختياري.موجود(م);
    }
    | عملية_مسير.تحويل_صحيح(ت_) -> {
        دع م: مفتاح_تعبير_مسير = {
            الرمز: 300 + رمز_تحويل_صحيح_مسير(ت_.العملية),
            الأول: ابحث_إعادة_ترقيم_قيمة(الاستبدال, ت_.المصدر).القيمة,
            الثاني: 0
        };
        أرجع اختياري.موجود(م);
    }
    | عملية_مسير.استخراج_حقل(ا) -> {
        دع م: مفتاح_تعبير_مسير = {
            الرمز: 400,
            الأول: ابحث_إعادة_ترقيم_قيمة(الاستبدال, ا.المصدر).القيمة,
            الثاني: ا.الفهرس
        };
        أرجع اختياري.موجود(م);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Drops the repeated expressions of a function whose block identities are
// positions; true when one went.
عرف احذف_تعبيرات_مكررة_مسير(الدالة: &متغير دالة_مسير): منطقي {
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع عدد_القيم: طبيعي = (*الدالة).القيمة_التالية;
    دع المدخل: متغير طبيعي = 0;
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(م) -> { المدخل := م.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع الهيمنة: تحليل_هيمنة_مسير = حلل_هيمنة_مسير(الدالة);
    دع الأبناء: متغير متجه متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) { دع صف: متجه طبيعي = []; ألحق(الأبناء, صف); ك := ك + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        إذا (الهيمنة.قابل_للوصول[ك]) {
            طابق الهيمنة.المهيمن_المباشر[ك] مع
            | اختياري.موجود(م) -> { إذا ((م.القيمة مثل طبيعي) < عدد_الكتل && (م.القيمة مثل طبيعي) != ك) { ألحق(الأبناء[م.القيمة], ك); }; }
            | اختياري.لا_شيء -> { };
        };
        ك := ك + 1;
    }
    دع الاستبدال: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) {
        دع الربط: إعادة_ترقيم_قيمة_مسير = {
            القديم: معرف_قيمة_مسير_من((*الدالة).المعرف, ف),
            الجديد: معرف_قيمة_مسير_من((*الدالة).المعرف, ف)
        };
        ألحق(الاستبدال, الربط);
        ف := ف + 1;
    }
    // Entries by first operand; the entries in walk order, popped on exit.
    دع القوائم: متغير متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_القيم) { دع صف: متجه طبيعي = []; ألحق(القوائم, صف); ف := ف + 1; }
    دع المداخل: متغير متجه مدخل_تعبير_مسير = [];
    دع المحذوفة: متغير متجه متجه منطقي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع صف: متغير متجه منطقي = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) { ألحق(صف, خطأ); ت := ت + 1; }
        ألحق(المحذوفة, صف);
        ك := ك + 1;
    }
    دع أي_حذف: متغير منطقي = خطأ;
    دع المحفوظ: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ألحق(المحفوظ, 0); ك := ك + 1; }
    دع المكدس: متغير متجه طبيعي = [المدخل * 2];
    طالما ((الطول(المكدس) مثل طبيعي) > 0) {
        دع الأخير: طبيعي = (الطول(المكدس) مثل طبيعي) - 1;
        دع البند: طبيعي = المكدس[الأخير];
        اقتطع(المكدس, الأخير);
        دع الكتلة: طبيعي = البند / 2;
        إذا ((البند % 2) == 1) {
            // Leave the scope: forget this subtree's entries.
            طالما ((الطول(المداخل) مثل طبيعي) > المحفوظ[الكتلة]) {
                دع آخر_مدخل: طبيعي = (الطول(المداخل) مثل طبيعي) - 1;
                دع الأول: طبيعي = المداخل[آخر_مدخل].المفتاح.الأول;
                اقتطع(القوائم[الأول], (الطول(القوائم[الأول]) مثل طبيعي) - 1);
                اقتطع(المداخل, آخر_مدخل);
            }
        } وإلا {
            المحفوظ[الكتلة] := الطول(المداخل) مثل طبيعي;
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*الدالة).الكتل[الكتلة].التعليمات) مثل طبيعي)) {
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[الكتلة].التعليمات[ت]) مع
                | اختياري.موجود(الناتج) -> {
                    طابق مفتاح_تعبير_لعملية_مسير(&(*الدالة).الكتل[الكتلة].التعليمات[ت].العملية, &الاستبدال) مع
                    | اختياري.موجود(المفتاح) -> {
                        إذا (المفتاح.الأول < عدد_القيم && (الناتج.المعرف.القيمة مثل طبيعي) < عدد_القيم) {
                            دع وجد: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
                            دع م: متغير طبيعي = 0;
                            طالما (م < (الطول(القوائم[المفتاح.الأول]) مثل طبيعي)) {
                                دع المدخل_: &مدخل_تعبير_مسير = &المداخل[القوائم[المفتاح.الأول][م]];
                                إذا ((*المدخل_).المفتاح.الرمز == المفتاح.الرمز
                                    && (*المدخل_).المفتاح.الثاني == المفتاح.الثاني
                                    && معرفا_نوع_متساويان((*المدخل_).النوع, الناتج.النوع)) {
                                    وجد := اختياري.موجود((*المدخل_).القيمة);
                                };
                                م := م + 1;
                            }
                            طابق وجد مع
                            | اختياري.موجود(السابقة) -> {
                                الاستبدال[الناتج.المعرف.القيمة].الجديد := السابقة;
                                المحذوفة[الكتلة][ت] := صواب;
                                أي_حذف := صواب;
                            }
                            | اختياري.لا_شيء -> {
                                دع المدخل_الجديد: مدخل_تعبير_مسير = {
                                    المفتاح: المفتاح, القيمة: الناتج.المعرف, النوع: الناتج.النوع
                                };
                                ألحق(القوائم[المفتاح.الأول], الطول(المداخل) مثل طبيعي);
                                ألحق(المداخل, المدخل_الجديد);
                            };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                ت := ت + 1;
            }
            ألحق(المكدس, (الكتلة * 2) + 1);
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(الأبناء[الكتلة]) مثل طبيعي)) {
                ألحق(المكدس, الأبناء[الكتلة][ب] * 2);
                ب := ب + 1;
            }
        };
    }
    إذا (!أي_حذف) { أرجع خطأ; };
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع الباقية: متغير متجه تعليمة_مسير = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            إذا (!المحذوفة[ك][ت]) {
                ألحق(الباقية, أعد_كتابة_تعليمة_قيم(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت], &الاستبدال));
            };
            ت := ت + 1;
        }
        (*الدالة).الكتل[ك].التعليمات := الباقية;
        (*الدالة).الكتل[ك].المنهي := أعد_كتابة_منهي_اختياري_قيم(&(*الدالة).الكتل[ك].المنهي, &الاستبدال);
        ك := ك + 1;
    }
    أرجع صواب;
}

// Block parameters for native code: a parameter that receives one other
// value on every edge (or itself, around a loop) is that value (Braun et
// al.'s trivial phi removal); of two parameters of a block that receive the
// same values on every edge, the second is the first; a parameter that
// nothing reads but edges into other dead parameters is dropped (the pruning
// promotion does, without its debug exception). Promotion keeps a local's
// parameters while a debug variable is bound to them, and lowering passes
// every local through a loop's header, so a loop otherwise carries copies of
// values it never changes and of values nothing reads, each holding a
// register and a move on every edge. Their debug bindings go with them, as
// at LLVM's -O2. Block identities are positions here.
عرف حواف_واردة_تدفق(
    الدالة: &دالة_مسير,
    الحواف_كلها: &متغير متجه حافة_مسير,
    بداية_الحواف: &متغير متجه طبيعي,
    الواردة: &متغير متجه متجه طبيعي
): فراغ {
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) { دع صف: متجه طبيعي = []; ألحق(*الواردة, صف); ك := ك + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ألحق(*بداية_الحواف, الطول(*الحواف_كلها) مثل طبيعي);
        دع حواف_الكتلة: متجه حافة_مسير = حواف_منهي_للترقية(&(*الدالة).الكتل[ك].المنهي);
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(حواف_الكتلة) مثل طبيعي)) {
            إذا ((حواف_الكتلة[ح].الهدف.القيمة مثل طبيعي) < عدد_الكتل) {
                ألحق((*الواردة)[حواف_الكتلة[ح].الهدف.القيمة], الطول(*الحواف_كلها) مثل طبيعي);
            };
            ألحق(*الحواف_كلها, انسخ_مملوكا_حافة_مسير(&حواف_الكتلة[ح]));
            ح := ح + 1;
        }
        ك := ك + 1;
    }
    ألحق(*بداية_الحواف, الطول(*الحواف_كلها) مثل طبيعي);
}

// Removes the parameters أبق marks false and their arguments on every edge,
// and renames the function's values through الاستبدال.
عرف احذف_معاملات_كتل_تدفق(
    الدالة: &متغير دالة_مسير,
    الحواف_كلها: &متجه حافة_مسير,
    بداية_الحواف: &متجه طبيعي,
    أبق: &متجه متجه منطقي,
    الاستبدال: &متجه إعادة_ترقيم_قيمة_مسير
): فراغ {
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع الحواف: متغير متجه حافة_مسير = [];
        دع ح: متغير طبيعي = (*بداية_الحواف)[ك];
        طالما (ح < (*بداية_الحواف)[ك + 1]) {
            دع الهدف: طبيعي = (*الحواف_كلها)[ح].الهدف.القيمة;
            دع حجج_فارغة: متجه معرف_قيمة_مسير = [];
            دع الجديدة: متغير حافة_مسير = { الهدف: (*الحواف_كلها)[ح].الهدف, الحجج: حجج_فارغة };
            دع ج: متغير طبيعي = 0;
            طالما (ج < (الطول((*الحواف_كلها)[ح].الحجج) مثل طبيعي)) {
                إذا (الهدف >= عدد_الكتل || ج >= (الطول((*أبق)[الهدف]) مثل طبيعي) || (*أبق)[الهدف][ج]) {
                    ألحق(الجديدة.الحجج, (*الحواف_كلها)[ح].الحجج[ج]);
                };
                ج := ج + 1;
            }
            ألحق(الحواف, الجديدة);
            ح := ح + 1;
        }
        دع المنهي: اختياري منهي_مسير = منهي_بحواف_للترقية(&(*الدالة).الكتل[ك].المنهي, &الحواف);
        (*الدالة).الكتل[ك].المنهي := أعد_كتابة_منهي_اختياري_قيم(&المنهي, الاستبدال);
        دع المعاملات: متغير متجه قيمة_مسير = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي)) {
            إذا ((*أبق)[ك][ف]) { ألحق(المعاملات, (*الدالة).الكتل[ك].المعاملات[ف]); };
            ف := ف + 1;
        }
        (*الدالة).الكتل[ك].المعاملات := المعاملات;
        ف := 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            (*الدالة).الكتل[ك].التعليمات[ف] := أعد_كتابة_تعليمة_قيم(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ف], الاستبدال);
            ف := ف + 1;
        }
        ك := ك + 1;
    }
}

عرف استبدال_هوية_تدفق(الدالة: &دالة_مسير): متجه إعادة_ترقيم_قيمة_مسير {
    دع الاستبدال: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الدالة).القيمة_التالية) {
        دع الربط: إعادة_ترقيم_قيمة_مسير = {
            القديم: معرف_قيمة_مسير_من((*الدالة).المعرف, ف), الجديد: معرف_قيمة_مسير_من((*الدالة).المعرف, ف)
        };
        ألحق(الاستبدال, الربط);
        ف := ف + 1;
    }
    أرجع الاستبدال;
}

// The constant instruction (block + 1, position) that defines each value,
// 0 for other values.
عرف مواضع_ثوابت_تدفق(الدالة: &دالة_مسير, الكتل_: &متغير متجه طبيعي, المواضع: &متغير متجه طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الدالة).القيمة_التالية) { ألحق(*الكتل_, 0); ألحق(*المواضع, 0); ف := ف + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.ثابت(_) -> {
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
                | اختياري.موجود(ن) -> {
                    إذا ((ن.المعرف.القيمة مثل طبيعي) < (الطول(*الكتل_) مثل طبيعي)) {
                        (*الكتل_)[ن.المعرف.القيمة] := ك + 1;
                        (*المواضع)[ن.المعرف.القيمة] := ت;
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
}

// Trivial, constant and duplicate parameters (see above); true when one
// went. A parameter every edge passes an equal constant for (each edge its
// own constant instruction: the drop flags lowering passes `false` for on
// every path that moved the local) becomes that constant, defined at the
// start of its block: its tests then fold. ثوابت_جديدة is set when one did.
عرف وحد_معاملات_كتل_تدفق(الدالة: &متغير دالة_مسير, المدخل: طبيعي, ثوابت_جديدة: &متغير منطقي): منطقي {
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع عدد_القيم: طبيعي = (*الدالة).القيمة_التالية;
    دع الحواف_كلها: متغير متجه حافة_مسير = [];
    دع بداية_الحواف: متغير متجه طبيعي = [];
    دع الواردة: متغير متجه متجه طبيعي = [];
    حواف_واردة_تدفق(الدالة, &متغير الحواف_كلها, &متغير بداية_الحواف, &متغير الواردة);
    // The block (+ 1) whose parameter each value is, 0 for other values.
    دع كتلة_المعامل: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) { ألحق(كتلة_المعامل, 0); ف := ف + 1; }
    دع الاستبدال: متغير متجه إعادة_ترقيم_قيمة_مسير = استبدال_هوية_تدفق(الدالة);
    دع أبق: متغير متجه متجه منطقي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع صف: متغير متجه منطقي = [];
        ف := 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي)) {
            دع ق: طبيعي = (*الدالة).الكتل[ك].المعاملات[ف].المعرف.القيمة;
            إذا (ق < عدد_القيم) { كتلة_المعامل[ق] := ك + 1; };
            ألحق(صف, صواب);
            ف := ف + 1;
        }
        ألحق(أبق, صف);
        ك := ك + 1;
    }
    دع تغير: متغير منطقي = خطأ;
    // Made on the first parameter that is not trivial.
    دع كتل_الثوابت: متغير متجه طبيعي = [];
    دع مواضع_الثوابت: متغير متجه طبيعي = [];
    // The constants to define at the start of blocks (by block).
    دع كتل_المضافة: متغير متجه طبيعي = [];
    دع المضافة: متغير متجه تعليمة_مسير = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع عدد_المعاملات: طبيعي = الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي;
        دع صالحة: متغير منطقي = ك != المدخل && عدد_المعاملات > 0 && (الطول(الواردة[ك]) مثل طبيعي) > 0;
        دع س: متغير طبيعي = 0;
        طالما (صالحة && س < (الطول(الواردة[ك]) مثل طبيعي)) {
            إذا ((الطول(الحواف_كلها[الواردة[ك][س]].الحجج) مثل طبيعي) != عدد_المعاملات) { صالحة := خطأ; };
            س := س + 1;
        }
        ف := 0;
        طالما (صالحة && ف < عدد_المعاملات) {
            دع المعامل: معرف_قيمة_مسير = (*الدالة).الكتل[ك].المعاملات[ف].المعرف;
            // Trivial: one other value on every edge.
            دع الوحيدة: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
            دع تافه: متغير منطقي = صواب;
            س := 0;
            طالما (تافه && س < (الطول(الواردة[ك]) مثل طبيعي)) {
                دع الحجة: معرف_قيمة_مسير = حل_استبدال_ترقية(&الاستبدال, الحواف_كلها[الواردة[ك][س]].الحجج[ف]);
                إذا (الحجة.القيمة != المعامل.القيمة) {
                    طابق الوحيدة مع
                    | اختياري.لا_شيء -> { الوحيدة := اختياري.موجود(الحجة); }
                    | اختياري.موجود(و) -> { إذا (و.القيمة != الحجة.القيمة) { تافه := خطأ; }; };
                };
                س := س + 1;
            }
            طابق الوحيدة مع
            | اختياري.موجود(و) -> {
                إذا (تافه && (و.القيمة مثل طبيعي) < عدد_القيم && كتلة_المعامل[و.القيمة] != ك + 1) {
                    الاستبدال[المعامل.القيمة].الجديد := و;
                    أبق[ك][ف] := خطأ;
                    تغير := صواب;
                };
            }
            | اختياري.لا_شيء -> { };
            // Equal constants on every edge.
            إذا (أبق[ك][ف] && !تافه) {
                إذا ((الطول(كتل_الثوابت) مثل طبيعي) == 0) {
                    مواضع_ثوابت_تدفق(الدالة, &متغير كتل_الثوابت, &متغير مواضع_الثوابت);
                };
                دع الأول_ك: متغير طبيعي = 0;
                دع الأول_ت: متغير طبيعي = 0;
                دع ثابتة: متغير منطقي = صواب;
                س := 0;
                طالما (ثابتة && س < (الطول(الواردة[ك]) مثل طبيعي)) {
                    دع الحجة: معرف_قيمة_مسير = حل_استبدال_ترقية(&الاستبدال, الحواف_كلها[الواردة[ك][س]].الحجج[ف]);
                    إذا (الحجة.القيمة != المعامل.القيمة) {
                        إذا ((الحجة.القيمة مثل طبيعي) >= عدد_القيم || كتل_الثوابت[الحجة.القيمة] == 0) {
                            ثابتة := خطأ;
                        } وإلا إذا (الأول_ك == 0) {
                            الأول_ك := كتل_الثوابت[الحجة.القيمة];
                            الأول_ت := مواضع_الثوابت[الحجة.القيمة];
                        } وإلا {
                            دع هذه: &تعليمة_مسير = &(*الدالة).الكتل[كتل_الثوابت[الحجة.القيمة] - 1].التعليمات[مواضع_الثوابت[الحجة.القيمة]];
                            دع تلك: &تعليمة_مسير = &(*الدالة).الكتل[الأول_ك - 1].التعليمات[الأول_ت];
                            طابق (*هذه).العملية مع
                            | عملية_مسير.ثابت(أ) -> {
                                طابق (*تلك).العملية مع
                                | عملية_مسير.ثابت(ب) -> {
                                    إذا (!ثابتا_مسير_متساويان(&أ, &ب)) { ثابتة := خطأ; };
                                }
                                | _ -> { ثابتة := خطأ; };
                            }
                            | _ -> { ثابتة := خطأ; };
                        };
                    };
                    س := س + 1;
                }
                إذا (ثابتة && الأول_ك != 0) {
                    دع الأصل: &تعليمة_مسير = &(*الدالة).الكتل[الأول_ك - 1].التعليمات[الأول_ت];
                    دع النوع_متفق: متغير منطقي = خطأ;
                    طابق قيمة_ناتج_تعليمة_مسير(الدالة, الأصل) مع
                    | اختياري.موجود(ن) -> { النوع_متفق := معرفا_نوع_متساويان(ن.النوع, (*الدالة).الكتل[ك].المعاملات[ف].النوع); }
                    | اختياري.لا_شيء -> { };
                    إذا (النوع_متفق) {
                        دع الجديدة: متغير تعليمة_مسير = انسخ_مملوكا_تعليمة_مسير(الأصل);
                        الجديدة.الناتج := ناتج_تعليمة_مسير_من(اختياري.موجود((*الدالة).الكتل[ك].المعاملات[ف]));
                        ألحق(كتل_المضافة, ك);
                        ألحق(المضافة, الجديدة);
                        أبق[ك][ف] := خطأ;
                        تغير := صواب;
                        *ثوابت_جديدة := صواب;
                    };
                };
            };
            // A duplicate of an earlier kept parameter.
            دع س2: متغير طبيعي = 0;
            طالما (أبق[ك][ف] && س2 < ف) {
                إذا (أبق[ك][س2]) {
                    دع الأول: معرف_قيمة_مسير = (*الدالة).الكتل[ك].المعاملات[س2].المعرف;
                    دع مثله: متغير منطقي = صواب;
                    س := 0;
                    طالما (مثله && س < (الطول(الواردة[ك]) مثل طبيعي)) {
                        دع أ: معرف_قيمة_مسير = حل_استبدال_ترقية(&الاستبدال, الحواف_كلها[الواردة[ك][س]].الحجج[س2]);
                        دع ب: معرف_قيمة_مسير = حل_استبدال_ترقية(&الاستبدال, الحواف_كلها[الواردة[ك][س]].الحجج[ف]);
                        إذا (!(أ.القيمة == ب.القيمة || (أ.القيمة == الأول.القيمة && ب.القيمة == المعامل.القيمة))) {
                            مثله := خطأ;
                        };
                        س := س + 1;
                    }
                    إذا (مثله) {
                        الاستبدال[المعامل.القيمة].الجديد := الأول;
                        أبق[ك][ف] := خطأ;
                        تغير := صواب;
                    };
                };
                س2 := س2 + 1;
            }
            ف := ف + 1;
        }
        ك := ك + 1;
    }
    إذا (!تغير) { أرجع خطأ; };
    ف := 0;
    طالما (ف < عدد_القيم) {
        الاستبدال[ف].الجديد := حل_استبدال_ترقية(&الاستبدال, الاستبدال[ف].القديم);
        ف := ف + 1;
    }
    احذف_معاملات_كتل_تدفق(الدالة, &الحواف_كلها, &بداية_الحواف, &أبق, &الاستبدال);
    // The parameters that became constants are defined first in their blocks.
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(المضافة) مثل طبيعي)) {
        دع الكتلة: طبيعي = كتل_المضافة[م];
        دع التعليمات: متغير متجه تعليمة_مسير = [];
        دع ن: متغير طبيعي = م;
        طالما (ن < (الطول(المضافة) مثل طبيعي) && كتل_المضافة[ن] == الكتلة) {
            دع المنقولة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
            بدّل(المضافة[ن], المنقولة);
            ألحق(التعليمات, المنقولة);
            ن := ن + 1;
        }
        دع القديمة: متغير متجه تعليمة_مسير = [];
        بدّل((*الدالة).الكتل[الكتلة].التعليمات, القديمة);
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(القديمة) مثل طبيعي)) {
            دع المنقولة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
            بدّل(القديمة[ت], المنقولة);
            ألحق(التعليمات, المنقولة);
            ت := ت + 1;
        }
        (*الدالة).الكتل[الكتلة].التعليمات := التعليمات;
        م := ن;
    }
    أرجع صواب;
}

// Parameters nothing reads but edges into dead parameters; true when one went.
عرف احذف_معاملات_ميتة_تدفق(الدالة: &متغير دالة_مسير): منطقي {
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع عدد_القيم: طبيعي = (*الدالة).القيمة_التالية;
    دع الحواف_كلها: متغير متجه حافة_مسير = [];
    دع بداية_الحواف: متغير متجه طبيعي = [];
    دع الواردة: متغير متجه متجه طبيعي = [];
    حواف_واردة_تدفق(الدالة, &متغير الحواف_كلها, &متغير بداية_الحواف, &متغير الواردة);
    دع الكل: متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, عدد_القيم);
    دع على_الحواف: متغير متجه طبيعي = [];
    دع كتلة_المعامل: متغير متجه طبيعي = [];
    دع موضع_المعامل: متغير متجه طبيعي = [];
    دع حي: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) {
        ألحق(على_الحواف, 0); ألحق(كتلة_المعامل, 0); ألحق(موضع_المعامل, 0); ألحق(حي, صواب);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(الحواف_كلها) مثل طبيعي)) {
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(الحواف_كلها[ف].الحجج) مثل طبيعي)) {
            دع ق: طبيعي = الحواف_كلها[ف].الحجج[ج].القيمة;
            إذا (ق < عدد_القيم) { على_الحواف[ق] := على_الحواف[ق] + 1; };
            ج := ج + 1;
        }
        ف := ف + 1;
    }
    دع العمل: متغير متجه طبيعي = [];
    دع أي_ميت: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        ف := 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي)) {
            دع ق: طبيعي = (*الدالة).الكتل[ك].المعاملات[ف].المعرف.القيمة;
            إذا (ق < عدد_القيم) {
                كتلة_المعامل[ق] := ك + 1;
                موضع_المعامل[ق] := ف;
                إذا (الكل[ق] > على_الحواف[ق]) { ألحق(العمل, ق); } وإلا { حي[ق] := خطأ; أي_ميت := صواب; };
            };
            ف := ف + 1;
        }
        ك := ك + 1;
    }
    إذا (!أي_ميت) { أرجع خطأ; };
    طالما ((الطول(العمل) مثل طبيعي) > 0) {
        دع الأخير: طبيعي = (الطول(العمل) مثل طبيعي) - 1;
        دع المعامل: طبيعي = العمل[الأخير];
        اقتطع(العمل, الأخير);
        دع الكتلة: طبيعي = كتلة_المعامل[المعامل] - 1;
        دع الموضع: طبيعي = موضع_المعامل[المعامل];
        دع س: متغير طبيعي = 0;
        طالما (س < (الطول(الواردة[الكتلة]) مثل طبيعي)) {
            دع الفهرس: طبيعي = الواردة[الكتلة][س];
            إذا (الموضع < (الطول(الحواف_كلها[الفهرس].الحجج) مثل طبيعي)) {
                دع الحجة: طبيعي = الحواف_كلها[الفهرس].الحجج[الموضع].القيمة;
                إذا (الحجة < عدد_القيم && !حي[الحجة]) {
                    حي[الحجة] := صواب;
                    ألحق(العمل, الحجة);
                };
            };
            س := س + 1;
        }
    }
    دع أبق: متغير متجه متجه منطقي = [];
    أي_ميت := خطأ;
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع صف: متغير متجه منطقي = [];
        ف := 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي)) {
            دع ق: طبيعي = (*الدالة).الكتل[ك].المعاملات[ف].المعرف.القيمة;
            دع ابق_هذا: منطقي = ق >= عدد_القيم || حي[ق];
            إذا (!ابق_هذا) { أي_ميت := صواب; };
            ألحق(صف, ابق_هذا);
            ف := ف + 1;
        }
        ألحق(أبق, صف);
        ك := ك + 1;
    }
    إذا (!أي_ميت) { أرجع خطأ; };
    دع الاستبدال: متجه إعادة_ترقيم_قيمة_مسير = استبدال_هوية_تدفق(الدالة);
    احذف_معاملات_كتل_تدفق(الدالة, &الحواف_كلها, &بداية_الحواف, &أبق, &الاستبدال);
    أرجع صواب;
}

// Whether an unused result of العملية may go: it neither traps nor has an
// effect. Checked arithmetic, division and shifts trap on bad operands,
// truncation is kept with them, and loads, stores, calls and constructions
// stay.
عرف عملية_بلا_أثر_تدفق(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> { أرجع صواب; }
    | عملية_مسير.مقارنة_صحيح(_) -> { أرجع صواب; }
    | عملية_مسير.مقارنة_عشري(_) -> { أرجع صواب; }
    | عملية_مسير.حساب_صحيح(ح) -> {
        طابق ح.العملية مع
        | عملية_حساب_صحيح.جمع_ملتف -> { أرجع صواب; }
        | عملية_حساب_صحيح.طرح_ملتف -> { أرجع صواب; }
        | عملية_حساب_صحيح.ضرب_ملتف -> { أرجع صواب; }
        | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { أرجع صواب; }
        | عملية_حساب_صحيح.أو_بتي -> { أرجع صواب; }
        | عملية_حساب_صحيح.أو_حصري -> { أرجع صواب; }
        | عملية_حساب_صحيح.و_بتي -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | عملية_مسير.تحويل_صحيح(ت_) -> {
        طابق ت_.العملية مع
        | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع صواب; }
        | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع صواب; }
        | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | عملية_مسير.مكان_عام(_) -> { أرجع صواب; }
    | عملية_مسير.مكان_حقل(_) -> { أرجع صواب; }
    | عملية_مسير.استعلام_وسم(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Gives back the uses of an operation عملية_بلا_أثر_تدفق accepts.
عرف أنقص_استخدامات_بلا_أثر_تدفق(العملية: &عملية_مسير, الاستخدامات: &متغير متجه طبيعي): فراغ {
    طابق *العملية مع
    | عملية_مسير.مقارنة_صحيح(م) -> {
        عدل_استخدام_تدفق(الاستخدامات, م.اليسار.القيمة, خطأ);
        عدل_استخدام_تدفق(الاستخدامات, م.اليمين.القيمة, خطأ);
    }
    | عملية_مسير.مقارنة_عشري(م) -> {
        عدل_استخدام_تدفق(الاستخدامات, م.اليسار.القيمة, خطأ);
        عدل_استخدام_تدفق(الاستخدامات, م.اليمين.القيمة, خطأ);
    }
    | عملية_مسير.حساب_صحيح(ح) -> {
        عدل_استخدام_تدفق(الاستخدامات, ح.اليسار.القيمة, خطأ);
        عدل_استخدام_تدفق(الاستخدامات, ح.اليمين.القيمة, خطأ);
    }
    | عملية_مسير.تحويل_صحيح(ت_) -> { عدل_استخدام_تدفق(الاستخدامات, ت_.المصدر.القيمة, خطأ); }
    | عملية_مسير.مكان_حقل(م) -> { عدل_استخدام_تدفق(الاستخدامات, م.الأصل.القيمة, خطأ); }
    | عملية_مسير.استعلام_وسم(م) -> { عدل_استخدام_تدفق(الاستخدامات, م.المصدر.القيمة, خطأ); }
    | _ -> { };
}

// Drops the instructions without effect whose results nothing reads (and
// those only they read: the walk goes backwards, until nothing changes).
// Their debug bindings go with them, as at LLVM's -O2. True when one went.
عرف احذف_تعليمات_ميتة_مسير(الدالة: &متغير دالة_مسير): منطقي {
    دع الاستخدامات: متغير متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, (*الدالة).القيمة_التالية);
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع المحذوفة: متغير متجه متجه منطقي = [];
    دع أي_حذف: متغير منطقي = خطأ;
    دع استمر: متغير منطقي = صواب;
    دع الجولة: متغير طبيعي = 0;
    طالما (استمر && الجولة < 4) {
        استمر := خطأ;
        دع ك: متغير طبيعي = عدد_الكتل;
        طالما (ك > 0) {
            ك := ك - 1;
            دع ت: متغير طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
            طالما (ت > 0) {
                ت := ت - 1;
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
                | اختياري.موجود(ن) -> {
                    دع ق: طبيعي = ن.المعرف.القيمة;
                    إذا (ق < (الطول(الاستخدامات) مثل طبيعي) && الاستخدامات[ق] == 0
                        && عملية_بلا_أثر_تدفق(&(*الدالة).الكتل[ك].التعليمات[ت].العملية)) {
                        إذا (!أي_حذف) {
                            دع م: متغير طبيعي = 0;
                            طالما (م < عدد_الكتل) {
                                دع صف: متغير متجه منطقي = [];
                                دع ي: متغير طبيعي = 0;
                                طالما (ي < (الطول((*الدالة).الكتل[م].التعليمات) مثل طبيعي)) { ألحق(صف, خطأ); ي := ي + 1; }
                                ألحق(المحذوفة, صف);
                                م := م + 1;
                            }
                            أي_حذف := صواب;
                        };
                        إذا (!المحذوفة[ك][ت]) {
                            المحذوفة[ك][ت] := صواب;
                            أنقص_استخدامات_بلا_أثر_تدفق(&(*الدالة).الكتل[ك].التعليمات[ت].العملية, &متغير الاستخدامات);
                            استمر := صواب;
                        };
                    };
                }
                | اختياري.لا_شيء -> { };
            }
        }
        الجولة := الجولة + 1;
    }
    إذا (!أي_حذف) { أرجع خطأ; };
    دع كت: متغير طبيعي = 0;
    طالما (كت < عدد_الكتل) {
        دع القديمة: متغير متجه تعليمة_مسير = [];
        بدّل((*الدالة).الكتل[كت].التعليمات, القديمة);
        دع الباقية: متغير متجه تعليمة_مسير = [];
        دع تت: متغير طبيعي = 0;
        طالما (تت < (الطول(القديمة) مثل طبيعي)) {
            إذا (!المحذوفة[كت][تت]) {
                دع المنقولة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
                بدّل(القديمة[تت], المنقولة);
                ألحق(الباقية, المنقولة);
            };
            تت := تت + 1;
        }
        (*الدالة).الكتل[كت].التعليمات := الباقية;
        كت := كت + 1;
    }
    أرجع صواب;
}

عرف بسط_معاملات_كتل_مسير(الدالة: &متغير دالة_مسير, ثوابت_جديدة: &متغير منطقي): منطقي {
    دع المدخل: متغير طبيعي = 0;
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(م) -> { المدخل := م.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع تغير: متغير منطقي = خطأ;
    دع الجولة: متغير طبيعي = 0;
    طالما (الجولة < 4) {
        إذا (وحد_معاملات_كتل_تدفق(الدالة, المدخل, ثوابت_جديدة)) { تغير := صواب; الجولة := الجولة + 1; } وإلا { الجولة := 4; };
    }
    إذا (احذف_معاملات_ميتة_تدفق(الدالة)) { تغير := صواب; };
    أرجع تغير;
}

// Simplifies one function; معدلة: inlining changed it, so its values are
// renumbered densely even when nothing here changes. True when something
// here changed it.
عرف بسط_تدفق_دالة_مسير(الدالة: &متغير دالة_مسير, التصحيح: &متغير بيانات_تصحيح_مسير, معدلة: منطقي): منطقي {
    طابق (*الدالة).المدخل مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { };
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        إذا (((*الدالة).الكتل[ك].المعرف.القيمة مثل طبيعي) != ك) {
            إذا (معدلة) { أعد_تقنين_دالة_مرقاة(الدالة, التصحيح); };
            أرجع خطأ;
        };
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            إذا ((*الدالة).الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة) {
                إذا (معدلة) { أعد_تقنين_دالة_مرقاة(الدالة, التصحيح); };
                أرجع خطأ;
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    // One block: no edge to thread or block to merge or drop.
    إذا ((الطول((*الدالة).الكتل) مثل طبيعي) == 1) {
        دع مطوية_وحيدة: منطقي = اطو_مقارنات_ثابتة_مسير(الدالة);
        دع مكررة_وحيدة: منطقي = احذف_تعبيرات_مكررة_مسير(الدالة);
        دع ميتة_وحيدة: منطقي = احذف_تعليمات_ميتة_مسير(الدالة);
        دع تغيرت: منطقي = مطوية_وحيدة || مكررة_وحيدة || ميتة_وحيدة;
        إذا (تغيرت || معدلة) { أعد_تقنين_دالة_مرقاة(الدالة, التصحيح); };
        أرجع تغيرت;
    };
    دع أي_تغيير: متغير منطقي = خطأ;
    // A block parameter that becomes a constant (بسط_معاملات_كتل_مسير) lets
    // the tests of it fold: the rounds run once more then.
    دع المرحلة: متغير طبيعي = 0;
    طالما (المرحلة < 2) {
        دع الجولة: متغير طبيعي = 0;
        طالما (الجولة < حد_جولات_التدفق()) {
            دع مطوية: منطقي = اطو_مقارنات_ثابتة_مسير(الدالة);
            دع تغير: متغير منطقي = مرر_حواف_دالة_مسير(الدالة) || مطوية;
            إذا (أرجع_من_القافزات_مسير(الدالة)) { تغير := صواب; };
            دع الاستبدال: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
            دع ف: متغير طبيعي = 0;
            إذا (ادمج_كتل_مسير(الدالة, &متغير الاستبدال)) {
                تغير := صواب;
            };
            إذا ((الطول(الاستبدال) مثل طبيعي) > 0) {
                ف := 0;
                طالما (ف < (الطول(الاستبدال) مثل طبيعي)) {
                    دع النهائي: معرف_قيمة_مسير = حل_استبدال_ترقية(&الاستبدال, الاستبدال[ف].القديم);
                    الاستبدال[ف].الجديد := النهائي;
                    ف := ف + 1;
                }
                ك := 0;
                طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
                    دع ت: متغير طبيعي = 0;
                    طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
                        (*الدالة).الكتل[ك].التعليمات[ت] := أعد_كتابة_تعليمة_قيم(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت], &الاستبدال);
                        ت := ت + 1;
                    }
                    (*الدالة).الكتل[ك].المنهي := أعد_كتابة_منهي_اختياري_قيم(&(*الدالة).الكتل[ك].المنهي, &الاستبدال);
                    ك := ك + 1;
                }
            };
            إذا (!تغير) { الجولة := حد_جولات_التدفق(); } وإلا {
                أي_تغيير := صواب;
                الجولة := الجولة + 1;
            };
        }
        إذا (احذف_كتلا_ميتة_مسير(الدالة)) { أي_تغيير := صواب; };
        دع ثوابت_جديدة: متغير منطقي = خطأ;
        إذا (بسط_معاملات_كتل_مسير(الدالة, &متغير ثوابت_جديدة)) { أي_تغيير := صواب; };
        إذا (ثوابت_جديدة) { المرحلة := المرحلة + 1; } وإلا { المرحلة := 2; };
    }
    إذا (احذف_تعبيرات_مكررة_مسير(الدالة)) { أي_تغيير := صواب; };
    إذا (احذف_تعليمات_ميتة_مسير(الدالة)) { أي_تغيير := صواب; };
    إذا (!أي_تغيير && !معدلة) { أرجع خطأ; };
    أعد_تقنين_دالة_مرقاة(الدالة, التصحيح);
    أرجع أي_تغيير;
}

// Simplifies every function المحسنة marks (by position) but the module
// initializer; المعدلة marks the functions inlining changed (see
// بسط_تدفق_دالة_مسير). Returns the functions it changed.
عام عرف بسط_تدفق_برنامج_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    المحسنة: &متجه منطقي,
    المعدلة: &متجه منطقي
): متجه منطقي {
    دع المبسطة: متغير متجه منطقي = [];
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) { ألحق(المبسطة, خطأ); د := د + 1; }
    د := 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي) && د < (الطول(*المحسنة) مثل طبيعي)) {
        دع مستثناة: متغير منطقي = !(*المحسنة)[د];
        طابق (*البرنامج).دالة_تهيئة_الوحدة مع
        | اختياري.موجود(م) -> { إذا ((م.القيمة مثل طبيعي) == د) { مستثناة := صواب; }; }
        | اختياري.لا_شيء -> { };
        دع معدلة: منطقي = د < (الطول(*المعدلة) مثل طبيعي) && (*المعدلة)[د];
        إذا (!مستثناة) {
            إذا (بسط_تدفق_دالة_مسير(&متغير (*البرنامج).الدوال[د], التصحيح, معدلة)) { المبسطة[د] := صواب; };
        } وإلا إذا (معدلة) {
            أعد_تقنين_دالة_مرقاة(&متغير (*البرنامج).الدوال[د], التصحيح);
        };
        د := د + 1;
    }
    أرجع المبسطة;
}
