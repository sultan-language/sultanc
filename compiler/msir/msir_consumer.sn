استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.runtime.primitive_identity;
استورد compiler.source.provenance;
استورد compiler.debuginfo.model;

// Lowering owns construction of canonical MSIR. Consumers receive that program
// directly; the production path does not re-walk the whole program to re-prove it.
عام نوع سياق_مستهلك_مسير = {
    المسير: برنامج_مسير
};

عام نوع عرض_دالة_مسير = {
    المعرف: معرف_دالة_مسير,
    عدد_المعاملات: غير_موقع,
    عدد_الالتقاطات: غير_موقع,
    الناتج: اختيار معرف_نوع,
    المدخل: اختيار معرف_كتلة_مسير,
    عدد_الكتل: غير_موقع
};

عام نوع عرض_كتلة_مسير = {
    المعرف: معرف_كتلة_مسير,
    عدد_المعاملات: غير_موقع,
    عدد_التعليمات: غير_موقع
};

عام نوع عرض_قيمة_مسير = {
    المعرف: معرف_قيمة_مسير,
    النوع: معرف_نوع
};

عام نوع عرض_تعليمة_مسير = {
    الناتج: اختيار معرف_قيمة_مسير,
    العملية: عملية_مسير,
    الأصل: اختيار معرف_أصل_مصدر,
    موقع_التصحيح: اختيار معرف_موقع_تصحيح,
    نطاق_التصحيح: اختيار معرف_نطاق_تصحيح
};

// واجهة مستهلك محايدة الهدف لحمولة ثابت النص المقننة.
// المستهلك يرى البايتات المفكوكة نفسها ولا يطلب إعادة فك أو تمثيلا ABI.
عام عرف عدد_بايتات_ثابت_نص_مسير(الثابت: &ثابت_مسير): اختيار غير_موقع {
    طابق *الثابت مع
    | ثابت_مسير.نص(البايتات) -> {
        أرجع اختيار.بعض(الطول(البايتات) مثل غير_موقع);
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف بايت_ثابت_نص_مسير_عند(
    الثابت: &ثابت_مسير,
    الفهرس: غير_موقع
): اختيار غ8 {
    طابق *الثابت مع
    | ثابت_مسير.نص(البايتات) -> {
        لو (الفهرس >= (الطول(البايتات) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(البايتات[الفهرس]);
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف ابحث_دالة_خارجية_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_دالة_خارجية_مسير
): اختيار دالة_خارجية_مسير {
    أرجع دالة_خارجية_مسير_عند(&(*السياق).المسير, المعرف);
}

عام عرف أسماء_الدوال_الخارجية_مسير(
    السياق: &سياق_مستهلك_مسير
): متجه متجه غ8 {
    دع الأسماء: متغير متجه متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*السياق).المسير.الدوال_الخارجية) مثل غير_موقع)) {
        دع مرجع_المصدر: &متجه غ8 = &(*السياق).المسير.الدوال_الخارجية[ف].الاسم;
        دع الاسم: متغير متجه غ8 = [];
        دع ب: متغير غير_موقع = 0;
        بينما (ب < (الطول(*مرجع_المصدر) مثل غير_موقع)) {
            ألحق(الاسم, (*مرجع_المصدر)[ب]);
            ب := ب + 1;
        }
        ألحق(الأسماء, الاسم);
        ف := ف + 1;
    }
    أرجع الأسماء;
}

عام نوع نتيجة_بحث_دالة_مسير =
    | موجودة بنوع عرض_دالة_مسير
    | مفقودة بنوع معرف_دالة_مسير
;

عام نوع نتيجة_بحث_كتلة_مسير =
    | موجودة بنوع عرض_كتلة_مسير
    | مفقودة بنوع معرف_كتلة_مسير
;

عام نوع نتيجة_بحث_قيمة_مسير =
    | موجودة بنوع عرض_قيمة_مسير
    | مفقودة بنوع معرف_قيمة_مسير
;

عام نوع نتيجة_بحث_منهي_مسير =
    | موجود بنوع منهي_مسير
    | كتلة_مفقودة بنوع معرف_كتلة_مسير
    | منهي_مفقود بنوع معرف_كتلة_مسير
;

// Consumer queries stay indexed by stable IDs. Validation reads the canonical
// program directly and never materializes Program -> Function -> Block copies.
عرف دالة_مسير_صالحة_للاستهلاك(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_دالة_مسير
): منطقي {
    لو (المعرف.القيمة >= (الطول((*السياق).المسير.الدوال) مثل غير_موقع)) {
        أرجع خطأ;
    };
    أرجع دالتا_مسير_متساويتان(
        (*السياق).المسير.الدوال[المعرف.القيمة].المعرف,
        المعرف
    );
}

عرف كتلة_مسير_صالحة_للاستهلاك(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_كتلة_مسير
): منطقي {
    لو (!دالة_مسير_صالحة_للاستهلاك(السياق, المعرف.الدالة)) {
        أرجع خطأ;
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[المعرف.الدالة.القيمة];
    لو (المعرف.القيمة >= (الطول((*مرجع_الدالة).الكتل) مثل غير_موقع)) {
        أرجع خطأ;
    };
    أرجع كتلتان_مسير_متساويتان((*مرجع_الدالة).الكتل[المعرف.القيمة].المعرف, المعرف);
}

عرف عرض_قيمة_مسير_من(القيمة: &قيمة_مسير): عرض_قيمة_مسير {
    دع المعرف: معرف_قيمة_مسير = (*القيمة).المعرف;
    دع النوع: معرف_نوع = (*القيمة).النوع;
    دع العرض: عرض_قيمة_مسير = {
        المعرف: المعرف,
        النوع: النوع
    };
    أرجع العرض;
}

عرف معرف_ناتج_تعليمة_مسير(
    الناتج: &اختيار قيمة_مسير
): اختيار معرف_قيمة_مسير {
    طابق *الناتج مع
    | اختيار.بعض(القيمة) -> {
        أرجع اختيار.بعض(القيمة.المعرف);
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف أنشئ_سياق_مستهلك_مسير(
    البرنامج: برنامج_مسير
): سياق_مستهلك_مسير {
    // Ownership is transferred once at the consumer boundary; all later reads borrow it.
    دع السياق: سياق_مستهلك_مسير = { المسير: البرنامج };
    أرجع السياق;
}

عام عرف عدد_دوال_مسير(
    السياق: &سياق_مستهلك_مسير
): غير_موقع {
    أرجع الطول((*السياق).المسير.الدوال) مثل غير_موقع;
}

عام عرف معرف_دالة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الفهرس: غير_موقع
): اختيار معرف_دالة_مسير {
    لو (الفهرس >= (الطول((*السياق).المسير.الدوال) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض((*السياق).المسير.الدوال[الفهرس].المعرف);
}

عام عرف عدد_قيم_دالة_مسير(
    السياق: &سياق_مستهلك_مسير,
    الدالة_معرف: معرف_دالة_مسير
): اختيار غير_موقع {
    لو (!دالة_مسير_صالحة_للاستهلاك(السياق, الدالة_معرف)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[الدالة_معرف.القيمة];
    أرجع اختيار.بعض(الطول((*مرجع_الدالة).القيم) مثل غير_موقع);
}

عام عرف ابحث_دالة_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_دالة_مسير
): نتيجة_بحث_دالة_مسير {
    لو (!دالة_مسير_صالحة_للاستهلاك(السياق, المعرف)) {
        أرجع نتيجة_بحث_دالة_مسير.مفقودة(المعرف);
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[المعرف.القيمة];
    دع عدد_المعاملات: غير_موقع = الطول((*مرجع_الدالة).المعاملات) مثل غير_موقع;
    دع عدد_الالتقاطات: غير_موقع = الطول((*مرجع_الدالة).الالتقاطات) مثل غير_موقع;
    دع عدد_الكتل: غير_موقع = الطول((*مرجع_الدالة).الكتل) مثل غير_موقع;
    دع معرف_الدالة: معرف_دالة_مسير = (*مرجع_الدالة).المعرف;
    دع الناتج: اختيار معرف_نوع = (*مرجع_الدالة).الناتج;
    دع المدخل: اختيار معرف_كتلة_مسير = (*مرجع_الدالة).المدخل;
    دع العرض: عرض_دالة_مسير = {
        المعرف: معرف_الدالة,
        عدد_المعاملات: عدد_المعاملات,
        عدد_الالتقاطات: عدد_الالتقاطات,
        الناتج: الناتج,
        المدخل: المدخل,
        عدد_الكتل: عدد_الكتل
    };
    أرجع نتيجة_بحث_دالة_مسير.موجودة(العرض);
}


عام عرف نوع_التقاط_دالة_مسير_للاستهلاك(
    السياق: &سياق_مستهلك_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    لو (!دالة_مسير_صالحة_للاستهلاك(السياق, الدالة_معرف)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[الدالة_معرف.القيمة];
    أرجع نوع_التقاط_دالة_مسير_عند(مرجع_الدالة, الفهرس);
}

عام عرف معامل_دالة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الفهرس: غير_موقع
): اختيار عرض_قيمة_مسير {
    لو (!دالة_مسير_صالحة_للاستهلاك(السياق, الدالة_معرف)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[الدالة_معرف.القيمة];
    لو (الفهرس >= (الطول((*مرجع_الدالة).المعاملات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(عرض_قيمة_مسير_من(&(*مرجع_الدالة).المعاملات[الفهرس]));
}

عام عرف معرف_كتلة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الفهرس: غير_موقع
): اختيار معرف_كتلة_مسير {
    لو (!دالة_مسير_صالحة_للاستهلاك(السياق, الدالة_معرف)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[الدالة_معرف.القيمة];
    لو (الفهرس >= (الطول((*مرجع_الدالة).الكتل) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض((*مرجع_الدالة).الكتل[الفهرس].المعرف);
}

عام عرف ابحث_كتلة_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_كتلة_مسير
): نتيجة_بحث_كتلة_مسير {
    لو (!كتلة_مسير_صالحة_للاستهلاك(السياق, المعرف)) {
        أرجع نتيجة_بحث_كتلة_مسير.مفقودة(المعرف);
    };
    دع مرجع_الكتلة: &كتلة_مسير = &(*السياق).المسير.الدوال[المعرف.الدالة.القيمة].الكتل[المعرف.القيمة];
    دع عدد_المعاملات: غير_موقع = الطول((*مرجع_الكتلة).المعاملات) مثل غير_موقع;
    دع عدد_التعليمات: غير_موقع = الطول((*مرجع_الكتلة).التعليمات) مثل غير_موقع;
    دع معرف_الكتلة: معرف_كتلة_مسير = (*مرجع_الكتلة).المعرف;
    دع العرض: عرض_كتلة_مسير = {
        المعرف: معرف_الكتلة,
        عدد_المعاملات: عدد_المعاملات,
        عدد_التعليمات: عدد_التعليمات
    };
    أرجع نتيجة_بحث_كتلة_مسير.موجودة(العرض);
}

عام عرف معامل_كتلة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الكتلة_معرف: معرف_كتلة_مسير,
    الفهرس: غير_موقع
): اختيار عرض_قيمة_مسير {
    لو (!كتلة_مسير_صالحة_للاستهلاك(السياق, الكتلة_معرف)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الكتلة: &كتلة_مسير = &(*السياق).المسير.الدوال[الكتلة_معرف.الدالة.القيمة].الكتل[الكتلة_معرف.القيمة];
    لو (الفهرس >= (الطول((*مرجع_الكتلة).المعاملات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(عرض_قيمة_مسير_من(&(*مرجع_الكتلة).المعاملات[الفهرس]));
}

عام عرف تعليمة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الكتلة_معرف: معرف_كتلة_مسير,
    الفهرس: غير_موقع
): اختيار عرض_تعليمة_مسير {
    لو (!كتلة_مسير_صالحة_للاستهلاك(السياق, الكتلة_معرف)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الكتلة: &كتلة_مسير = &(*السياق).المسير.الدوال[الكتلة_معرف.الدالة.القيمة].الكتل[الكتلة_معرف.القيمة];
    لو (الفهرس >= (الطول((*مرجع_الكتلة).التعليمات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_التعليمة_المقروء: &تعليمة_مسير = &(*مرجع_الكتلة).التعليمات[الفهرس];
    دع معرف_الناتج: اختيار معرف_قيمة_مسير = معرف_ناتج_تعليمة_مسير(&(*مرجع_التعليمة_المقروء).الناتج);
    طابق *مرجع_التعليمة_المقروء مع
    | { الناتج: _, العملية: العملية, الأصل: الأصل, موقع_التصحيح: موقع_التصحيح, نطاق_التصحيح: نطاق_التصحيح } -> {
        دع العرض: عرض_تعليمة_مسير = {
            الناتج: معرف_الناتج,
            العملية: العملية,
            الأصل: الأصل,
            موقع_التصحيح: موقع_التصحيح,
            نطاق_التصحيح: نطاق_التصحيح
        };
        أرجع اختيار.بعض(العرض);
    };
}

عام عرف منهي_كتلة_مسير(
    السياق: &سياق_مستهلك_مسير,
    الكتلة_معرف: معرف_كتلة_مسير
): نتيجة_بحث_منهي_مسير {
    لو (!كتلة_مسير_صالحة_للاستهلاك(السياق, الكتلة_معرف)) {
        أرجع نتيجة_بحث_منهي_مسير.كتلة_مفقودة(الكتلة_معرف);
    };
    دع مرجع_الكتلة: &كتلة_مسير = &(*السياق).المسير.الدوال[الكتلة_معرف.الدالة.القيمة].الكتل[الكتلة_معرف.القيمة];
    طابق (*مرجع_الكتلة).المنهي مع
    | اختيار.بعض(المنهي) -> {
        أرجع نتيجة_بحث_منهي_مسير.موجود(المنهي);
    }
    | اختيار.لا_شيء -> {
        // هذه الحالة غير قابلة للوصول من سياق أُنشئ عبر verifier، لكنها تبقى نتيجة بنيوية صريحة.
        أرجع نتيجة_بحث_منهي_مسير.منهي_مفقود(الكتلة_معرف);
    };
}

عام عرف ابحث_قيمة_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_بحث_قيمة_مسير {
    لو (!دالة_مسير_صالحة_للاستهلاك(السياق, المعرف.الدالة)) {
        أرجع نتيجة_بحث_قيمة_مسير.مفقودة(المعرف);
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[المعرف.الدالة.القيمة];
    لو (المعرف.القيمة >= (الطول((*مرجع_الدالة).القيم) مثل غير_موقع)) {
        أرجع نتيجة_بحث_قيمة_مسير.مفقودة(المعرف);
    };
    دع مرجع_القيمة: &قيمة_مسير = &(*مرجع_الدالة).القيم[المعرف.القيمة];
    لو (!قيمتا_مسير_متساويتان((*مرجع_القيمة).المعرف, المعرف)) {
        أرجع نتيجة_بحث_قيمة_مسير.مفقودة(المعرف);
    };
    أرجع نتيجة_بحث_قيمة_مسير.موجودة(عرض_قيمة_مسير_من(مرجع_القيمة));
}

عام عرف نوع_قيمة_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار معرف_نوع {
    لو (!دالة_مسير_صالحة_للاستهلاك(السياق, المعرف.الدالة)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[المعرف.الدالة.القيمة];
    لو (المعرف.القيمة >= (الطول((*مرجع_الدالة).القيم) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_القيمة: &قيمة_مسير = &(*مرجع_الدالة).القيم[المعرف.القيمة];
    لو (!قيمتا_مسير_متساويتان((*مرجع_القيمة).المعرف, المعرف)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض((*مرجع_القيمة).النوع);
}

// Exhaustive target-neutral instruction classification for verified consumers.
// Adding an MSIR operation requires extending this match, so consumers cannot silently ignore it.
عام نوع صنف_عملية_مسير_للاستهلاك =
    | ثابت
    | حساب_صحيح
    | حساب_عشري
    | مقارنة_عشري
    | مقارنة_صحيح
    | تحويل_صحيح
    | مرجع_إلى_مؤشر
    | تجميع
    | تهيئة_متجه
    | استخراج_حقل
    | استخراج_فهرس
    | مكان_محلي
    | مكان_عام
    | مرجع_إلى_مكان
    | صندوق_إلى_مكان
    | مكان_حقل
    | مكان_فهرس
    | موضع_تخزين_عنصر_مؤشر
    | تحميل
    | تخزين
    | مكان_إلى_مرجع
    | بناء_موسوم
    | استعلام_وسم
    | استخراج_حمولة
    | بناء_صندوق
    | بناء_إغلاق
    | استخراج_التقاط
    | نداء
;

عام عرف صنف_عملية_مسير(
    العملية: &عملية_مسير
): صنف_عملية_مسير_للاستهلاك {
    طابق *العملية مع
    | عملية_مسير.ثابت(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.ثابت();
    }
    | عملية_مسير.حساب_صحيح(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.حساب_صحيح();
    }
    | عملية_مسير.حساب_عشري(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.حساب_عشري();
    }
    | عملية_مسير.مقارنة_عشري(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مقارنة_عشري();
    }
    | عملية_مسير.مقارنة_صحيح(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مقارنة_صحيح();
    }
    | عملية_مسير.تحويل_صحيح(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تحويل_صحيح();
    }
    | عملية_مسير.مرجع_إلى_مؤشر(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مرجع_إلى_مؤشر();
    }
    | عملية_مسير.تجميع(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تجميع();
    }
    | عملية_مسير.تهيئة_متجه(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تهيئة_متجه();
    }
    | عملية_مسير.استخراج_حقل(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استخراج_حقل();
    }
    | عملية_مسير.استخراج_فهرس(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استخراج_فهرس();
    }
    | عملية_مسير.مكان_محلي(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_محلي();
    }
    | عملية_مسير.مكان_عام(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_عام();
    }
    | عملية_مسير.مرجع_إلى_مكان(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مرجع_إلى_مكان();
    }
    | عملية_مسير.صندوق_إلى_مكان(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.صندوق_إلى_مكان();
    }
    | عملية_مسير.مكان_حقل(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_حقل();
    }
    | عملية_مسير.مكان_فهرس(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_فهرس();
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.موضع_تخزين_عنصر_مؤشر();
    }
    | عملية_مسير.تحميل(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تحميل();
    }
    | عملية_مسير.تخزين(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تخزين();
    }
    | عملية_مسير.مكان_إلى_مرجع(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_إلى_مرجع();
    }
    | عملية_مسير.بناء_موسوم(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.بناء_موسوم();
    }
    | عملية_مسير.استعلام_وسم(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استعلام_وسم();
    }
    | عملية_مسير.استخراج_حمولة(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استخراج_حمولة();
    }
    | عملية_مسير.بناء_صندوق(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.بناء_صندوق();
    }
    | عملية_مسير.بناء_إغلاق(_) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.بناء_إغلاق();
    }
    | عملية_مسير.استخراج_التقاط(_) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استخراج_التقاط();
    }
    | عملية_مسير.نداء(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.نداء();
    };
}
