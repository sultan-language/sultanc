استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.runtime.primitive_identity;
استورد compiler.source.provenance;
استورد compiler.debuginfo.model;

// Lowering owns construction of canonical MSIR. Consumers receive that program
// directly; the production path does not re-walk the whole program to re-prove it.
عام نوع سياق_مستهلك_مسير = {
    المسير: برنامج_مسير
};

عام نوع عرض_دالة_مسير = {
    المعرف: معرف_دالة_مسير,
    عدد_المعاملات: طبيعي,
    عدد_الالتقاطات: طبيعي,
    الناتج: اختياري معرف_نوع,
    المدخل: اختياري معرف_كتلة_مسير,
    عدد_الكتل: طبيعي
};

عام نوع عرض_كتلة_مسير = {
    المعرف: معرف_كتلة_مسير,
    عدد_المعاملات: طبيعي,
    عدد_التعليمات: طبيعي
};

عام نوع عرض_قيمة_مسير = {
    المعرف: معرف_قيمة_مسير,
    النوع: معرف_نوع
};

عام نوع عرض_تعليمة_مسير = {
    الناتج: اختياري معرف_قيمة_مسير,
    العملية: عملية_مسير,
    الأصل: اختياري معرف_أصل_مصدر,
    موقع_التصحيح: اختياري معرف_موقع_تصحيح,
    نطاق_التصحيح: اختياري معرف_نطاق_تصحيح
};

// واجهة مستهلك محايدة الهدف لحمولة ثابت النص المقننة.
// المستهلك يرى البايتات المفكوكة نفسها ولا يطلب إعادة فك أو تمثيلا ABI.
عام عرف عدد_بايتات_ثابت_نص_مسير(الثابت: &ثابت_مسير): اختياري طبيعي {
    طابق *الثابت مع
    | ثابت_مسير.نص(البايتات) -> {
        أرجع اختياري.موجود(الطول(البايتات) مثل طبيعي);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف بايت_ثابت_نص_مسير_عند(
    الثابت: &ثابت_مسير,
    الفهرس: طبيعي
): اختياري ط8 {
    طابق *الثابت مع
    | ثابت_مسير.نص(البايتات) -> {
        إذا (الفهرس >= (الطول(البايتات) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(البايتات[الفهرس]);
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف ابحث_دالة_خارجية_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_دالة_خارجية_مسير
): اختياري دالة_خارجية_مسير {
    أرجع دالة_خارجية_مسير_عند(&(*السياق).المسير, المعرف);
}

عام عرف أسماء_الدوال_الخارجية_مسير(
    السياق: &سياق_مستهلك_مسير
): متجه متجه ط8 {
    دع الأسماء: متغير متجه متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).المسير.الدوال_الخارجية) مثل طبيعي)) {
        دع مرجع_المصدر: &متجه ط8 = &(*السياق).المسير.الدوال_الخارجية[ف].الاسم;
        دع الاسم: متغير متجه ط8 = [];
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(*مرجع_المصدر) مثل طبيعي)) {
            ألحق(الاسم, (*مرجع_المصدر)[ب]);
            ب := ب + 1;
        }
        ألحق(الأسماء, الاسم);
        ف := ف + 1;
    }
    أرجع الأسماء;
}

عام نوع نتيجة_بحث_دالة_مسير =
    | موجودة بنوع عرض_دالة_مسير
    | مفقودة بنوع معرف_دالة_مسير
;

عام نوع نتيجة_بحث_كتلة_مسير =
    | موجودة بنوع عرض_كتلة_مسير
    | مفقودة بنوع معرف_كتلة_مسير
;

عام نوع نتيجة_بحث_قيمة_مسير =
    | موجودة بنوع عرض_قيمة_مسير
    | مفقودة بنوع معرف_قيمة_مسير
;

عام نوع نتيجة_بحث_منهي_مسير =
    | موجود بنوع منهي_مسير
    | كتلة_مفقودة بنوع معرف_كتلة_مسير
    | منهي_مفقود بنوع معرف_كتلة_مسير
;

// Consumer queries stay indexed by stable IDs. Validation reads the canonical
// program directly and never materializes Program -> Function -> Block copies.
عرف دالة_مسير_صالحة_للاستهلاك(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_دالة_مسير
): منطقي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*السياق).المسير.الدوال) مثل طبيعي)) {
        أرجع خطأ;
    };
    أرجع دالتا_مسير_متساويتان(
        (*السياق).المسير.الدوال[المعرف.القيمة].المعرف,
        المعرف
    );
}

عرف كتلة_مسير_صالحة_للاستهلاك(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_كتلة_مسير
): منطقي {
    إذا (!دالة_مسير_صالحة_للاستهلاك(السياق, المعرف.الدالة)) {
        أرجع خطأ;
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[المعرف.الدالة.القيمة];
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*مرجع_الدالة).الكتل) مثل طبيعي)) {
        أرجع خطأ;
    };
    أرجع كتلتان_مسير_متساويتان((*مرجع_الدالة).الكتل[المعرف.القيمة].المعرف, المعرف);
}

عرف عرض_قيمة_مسير_من(القيمة: &قيمة_مسير): عرض_قيمة_مسير {
    دع المعرف: معرف_قيمة_مسير = (*القيمة).المعرف;
    دع النوع: معرف_نوع = (*القيمة).النوع;
    دع العرض: عرض_قيمة_مسير = {
        المعرف: المعرف,
        النوع: النوع
    };
    أرجع العرض;
}

عام عرف أنشئ_سياق_مستهلك_مسير(
    البرنامج: برنامج_مسير
): سياق_مستهلك_مسير {
    // Ownership is transferred once at the consumer boundary; all later reads borrow it.
    دع السياق: سياق_مستهلك_مسير = { المسير: البرنامج };
    أرجع السياق;
}

عام عرف عدد_دوال_مسير(
    السياق: &سياق_مستهلك_مسير
): طبيعي {
    أرجع الطول((*السياق).المسير.الدوال) مثل طبيعي;
}

عام عرف معرف_دالة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الفهرس: طبيعي
): اختياري معرف_دالة_مسير {
    إذا (الفهرس >= (الطول((*السياق).المسير.الدوال) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*السياق).المسير.الدوال[الفهرس].المعرف);
}

عام عرف عدد_قيم_دالة_مسير(
    السياق: &سياق_مستهلك_مسير,
    الدالة_معرف: معرف_دالة_مسير
): اختياري طبيعي {
    إذا (!دالة_مسير_صالحة_للاستهلاك(السياق, الدالة_معرف)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[الدالة_معرف.القيمة];
    أرجع اختياري.موجود(الطول((*مرجع_الدالة).القيم) مثل طبيعي);
}

عام عرف ابحث_دالة_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_دالة_مسير
): نتيجة_بحث_دالة_مسير {
    إذا (!دالة_مسير_صالحة_للاستهلاك(السياق, المعرف)) {
        أرجع نتيجة_بحث_دالة_مسير.مفقودة(المعرف);
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[المعرف.القيمة];
    دع عدد_المعاملات: طبيعي = الطول((*مرجع_الدالة).المعاملات) مثل طبيعي;
    دع عدد_الالتقاطات: طبيعي = الطول((*مرجع_الدالة).الالتقاطات) مثل طبيعي;
    دع عدد_الكتل: طبيعي = الطول((*مرجع_الدالة).الكتل) مثل طبيعي;
    دع معرف_الدالة: معرف_دالة_مسير = (*مرجع_الدالة).المعرف;
    دع الناتج: اختياري معرف_نوع = (*مرجع_الدالة).الناتج;
    دع المدخل: اختياري معرف_كتلة_مسير = (*مرجع_الدالة).المدخل;
    دع العرض: عرض_دالة_مسير = {
        المعرف: معرف_الدالة,
        عدد_المعاملات: عدد_المعاملات,
        عدد_الالتقاطات: عدد_الالتقاطات,
        الناتج: الناتج,
        المدخل: المدخل,
        عدد_الكتل: عدد_الكتل
    };
    أرجع نتيجة_بحث_دالة_مسير.موجودة(العرض);
}


عام عرف نوع_التقاط_دالة_مسير_للاستهلاك(
    السياق: &سياق_مستهلك_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    إذا (!دالة_مسير_صالحة_للاستهلاك(السياق, الدالة_معرف)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[الدالة_معرف.القيمة];
    أرجع نوع_التقاط_دالة_مسير_عند(مرجع_الدالة, الفهرس);
}

عام عرف معامل_دالة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الفهرس: طبيعي
): اختياري عرض_قيمة_مسير {
    إذا (!دالة_مسير_صالحة_للاستهلاك(السياق, الدالة_معرف)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[الدالة_معرف.القيمة];
    إذا (الفهرس >= (الطول((*مرجع_الدالة).المعاملات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(عرض_قيمة_مسير_من(&(*مرجع_الدالة).المعاملات[الفهرس]));
}

عام عرف معرف_كتلة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الدالة_معرف: معرف_دالة_مسير,
    الفهرس: طبيعي
): اختياري معرف_كتلة_مسير {
    إذا (!دالة_مسير_صالحة_للاستهلاك(السياق, الدالة_معرف)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[الدالة_معرف.القيمة];
    إذا (الفهرس >= (الطول((*مرجع_الدالة).الكتل) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*مرجع_الدالة).الكتل[الفهرس].المعرف);
}

عام عرف ابحث_كتلة_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_كتلة_مسير
): نتيجة_بحث_كتلة_مسير {
    إذا (!كتلة_مسير_صالحة_للاستهلاك(السياق, المعرف)) {
        أرجع نتيجة_بحث_كتلة_مسير.مفقودة(المعرف);
    };
    دع مرجع_الكتلة: &كتلة_مسير = &(*السياق).المسير.الدوال[المعرف.الدالة.القيمة].الكتل[المعرف.القيمة];
    دع عدد_المعاملات: طبيعي = الطول((*مرجع_الكتلة).المعاملات) مثل طبيعي;
    دع عدد_التعليمات: طبيعي = الطول((*مرجع_الكتلة).التعليمات) مثل طبيعي;
    دع معرف_الكتلة: معرف_كتلة_مسير = (*مرجع_الكتلة).المعرف;
    دع العرض: عرض_كتلة_مسير = {
        المعرف: معرف_الكتلة,
        عدد_المعاملات: عدد_المعاملات,
        عدد_التعليمات: عدد_التعليمات
    };
    أرجع نتيجة_بحث_كتلة_مسير.موجودة(العرض);
}

عام عرف معامل_كتلة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الكتلة_معرف: معرف_كتلة_مسير,
    الفهرس: طبيعي
): اختياري عرض_قيمة_مسير {
    إذا (!كتلة_مسير_صالحة_للاستهلاك(السياق, الكتلة_معرف)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الكتلة: &كتلة_مسير = &(*السياق).المسير.الدوال[الكتلة_معرف.الدالة.القيمة].الكتل[الكتلة_معرف.القيمة];
    إذا (الفهرس >= (الطول((*مرجع_الكتلة).المعاملات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(عرض_قيمة_مسير_من(&(*مرجع_الكتلة).المعاملات[الفهرس]));
}

عام عرف تعليمة_مسير_عند(
    السياق: &سياق_مستهلك_مسير,
    الكتلة_معرف: معرف_كتلة_مسير,
    الفهرس: طبيعي
): اختياري عرض_تعليمة_مسير {
    إذا (!كتلة_مسير_صالحة_للاستهلاك(السياق, الكتلة_معرف)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الكتلة: &كتلة_مسير = &(*السياق).المسير.الدوال[الكتلة_معرف.الدالة.القيمة].الكتل[الكتلة_معرف.القيمة];
    إذا (الفهرس >= (الطول((*مرجع_الكتلة).التعليمات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_التعليمة_المقروء: &تعليمة_مسير = &(*مرجع_الكتلة).التعليمات[الفهرس];
    دع معرف_الناتج: اختياري معرف_قيمة_مسير = معرف_ناتج_تعليمة_في_مسير(الكتلة_معرف.الدالة, مرجع_التعليمة_المقروء);
    طابق *مرجع_التعليمة_المقروء مع
    | { الناتج: _, موقع_التصحيح: موقع_التصحيح, العملية: العملية, نطاق_التصحيح: نطاق_التصحيح } -> {
        دع العرض: عرض_تعليمة_مسير = {
            الناتج: معرف_الناتج,
            العملية: انسخ_مملوكا_عملية_مسير(&العملية),
            الأصل: أصل_تعليمة_مسير(&(*السياق).المسير, مرجع_التعليمة_المقروء),
            موقع_التصحيح: موقع_تصحيح_من_مرجع_مسير(موقع_التصحيح),
            نطاق_التصحيح: نطاق_تصحيح_من_مرجع_مسير(نطاق_التصحيح)
        };
        أرجع اختياري.موجود(العرض);
    };
}

عام عرف منهي_كتلة_مسير(
    السياق: &سياق_مستهلك_مسير,
    الكتلة_معرف: معرف_كتلة_مسير
): نتيجة_بحث_منهي_مسير {
    إذا (!كتلة_مسير_صالحة_للاستهلاك(السياق, الكتلة_معرف)) {
        أرجع نتيجة_بحث_منهي_مسير.كتلة_مفقودة(الكتلة_معرف);
    };
    دع مرجع_الكتلة: &كتلة_مسير = &(*السياق).المسير.الدوال[الكتلة_معرف.الدالة.القيمة].الكتل[الكتلة_معرف.القيمة];
    طابق (*مرجع_الكتلة).المنهي مع
    | اختياري.موجود(المنهي) -> {
        أرجع نتيجة_بحث_منهي_مسير.موجود(انسخ_مملوكا_منهي_مسير(&المنهي));
    }
    | اختياري.لا_شيء -> {
        // هذه الحالة غير قابلة للوصول من سياق أُنشئ عبر verifier، لكنها تبقى نتيجة بنيوية صريحة.
        أرجع نتيجة_بحث_منهي_مسير.منهي_مفقود(الكتلة_معرف);
    };
}

عام عرف ابحث_قيمة_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): نتيجة_بحث_قيمة_مسير {
    إذا (!دالة_مسير_صالحة_للاستهلاك(السياق, المعرف.الدالة)) {
        أرجع نتيجة_بحث_قيمة_مسير.مفقودة(المعرف);
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[المعرف.الدالة.القيمة];
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*مرجع_الدالة).القيم) مثل طبيعي)) {
        أرجع نتيجة_بحث_قيمة_مسير.مفقودة(المعرف);
    };
    دع مرجع_القيمة: &قيمة_مسير = &(*مرجع_الدالة).القيم[المعرف.القيمة];
    إذا (!قيمتا_مسير_متساويتان((*مرجع_القيمة).المعرف, المعرف)) {
        أرجع نتيجة_بحث_قيمة_مسير.مفقودة(المعرف);
    };
    أرجع نتيجة_بحث_قيمة_مسير.موجودة(عرض_قيمة_مسير_من(مرجع_القيمة));
}

عام عرف نوع_قيمة_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري معرف_نوع {
    إذا (!دالة_مسير_صالحة_للاستهلاك(السياق, المعرف.الدالة)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[المعرف.الدالة.القيمة];
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*مرجع_الدالة).القيم) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_القيمة: &قيمة_مسير = &(*مرجع_الدالة).القيم[المعرف.القيمة];
    إذا (!قيمتا_مسير_متساويتان((*مرجع_القيمة).المعرف, المعرف)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*مرجع_القيمة).النوع);
}

// The 64-bit pattern of the integer constant that defines a value, when an
// instruction of its function is that constant (a signed constant in two's
// complement). Native selectors use it to divide by a constant with a
// multiply (backend/codegen/division_by_constant.sn). It scans the function.
عام عرف ثابت_صحيح_لقيمة_مسير(
    السياق: &سياق_مستهلك_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري طبيعي {
    إذا (!دالة_مسير_صالحة_للاستهلاك(السياق, المعرف.الدالة)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الدالة: &دالة_مسير = &(*السياق).المسير.الدوال[المعرف.الدالة.القيمة];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*مرجع_الدالة).الكتل) مثل طبيعي)) {
        دع مرجع_الكتلة: &كتلة_مسير = &(*مرجع_الدالة).الكتل[ك];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*مرجع_الكتلة).التعليمات) مثل طبيعي)) {
            دع مرجع_التعليمة: &تعليمة_مسير = &(*مرجع_الكتلة).التعليمات[ت];
            طابق معرف_ناتج_تعليمة_في_مسير(المعرف.الدالة, مرجع_التعليمة) مع
            | اختياري.موجود(الناتج) -> {
                إذا (الناتج.القيمة == المعرف.القيمة) {
                    طابق (*مرجع_التعليمة).العملية مع
                    | عملية_مسير.ثابت(الثابت) -> {
                        طابق الثابت مع
                        | ثابت_مسير.صحيح_طبيعي(القيمة) -> { أرجع اختياري.موجود(القيمة); }
                        | ثابت_مسير.صحيح_موقع(القيمة) -> { أرجع اختياري.موجود(القيمة مثل طبيعي); }
                        | _ -> { أرجع اختياري.لا_شيء(); };
                    }
                    | _ -> { أرجع اختياري.لا_شيء(); };
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Exhaustive target-neutral instruction classification for verified consumers.
// Adding an MSIR operation requires extending this match, so consumers cannot silently ignore it.
عام نوع صنف_عملية_مسير_للاستهلاك =
    | ثابت
    | حساب_صحيح
    | حساب_عشري
    | مقارنة_عشري
    | مقارنة_صحيح
    | تحويل_صحيح
    | تحويل_عائم
    | مرجع_إلى_مؤشر
    | نقل_تسلسل_مملوك
    | تجميع
    | تهيئة_متجه
    | استخراج_حقل
    | استخراج_فهرس
    | مكان_محلي
    | مكان_عام
    | مرجع_إلى_مكان
    | صندوق_إلى_مكان
    | مكان_حقل
    | مكان_فهرس
    | موضع_تخزين_عنصر_مؤشر
    | تحميل
    | تخزين
    | مكان_إلى_مرجع
    | بناء_موسوم
    | استعلام_وسم
    | استخراج_حمولة
    | بناء_صندوق
    | بناء_إغلاق
    | استخراج_التقاط
    | نداء
;

عام عرف صنف_عملية_مسير(
    العملية: &عملية_مسير
): صنف_عملية_مسير_للاستهلاك {
    طابق *العملية مع
    | عملية_مسير.ثابت(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.ثابت();
    }
    | عملية_مسير.حساب_صحيح(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.حساب_صحيح();
    }
    | عملية_مسير.حساب_عشري(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.حساب_عشري();
    }
    | عملية_مسير.مقارنة_عشري(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مقارنة_عشري();
    }
    | عملية_مسير.مقارنة_صحيح(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مقارنة_صحيح();
    }
    | عملية_مسير.تحويل_صحيح(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تحويل_صحيح();
    }
    | عملية_مسير.تحويل_عائم(_) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تحويل_عائم();
    }
    | عملية_مسير.نقل_تسلسل_مملوك(_) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.نقل_تسلسل_مملوك();
    }
    | عملية_مسير.مرجع_إلى_مؤشر(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مرجع_إلى_مؤشر();
    }
    | عملية_مسير.تجميع(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تجميع();
    }
    | عملية_مسير.تهيئة_متجه(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تهيئة_متجه();
    }
    | عملية_مسير.استخراج_حقل(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استخراج_حقل();
    }
    | عملية_مسير.استخراج_فهرس(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استخراج_فهرس();
    }
    | عملية_مسير.مكان_محلي(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_محلي();
    }
    | عملية_مسير.مكان_عام(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_عام();
    }
    | عملية_مسير.مرجع_إلى_مكان(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مرجع_إلى_مكان();
    }
    | عملية_مسير.صندوق_إلى_مكان(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.صندوق_إلى_مكان();
    }
    | عملية_مسير.مكان_حقل(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_حقل();
    }
    | عملية_مسير.مكان_فهرس(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_فهرس();
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.موضع_تخزين_عنصر_مؤشر();
    }
    | عملية_مسير.تحميل(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تحميل();
    }
    | عملية_مسير.تخزين(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.تخزين();
    }
    | عملية_مسير.مكان_إلى_مرجع(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.مكان_إلى_مرجع();
    }
    | عملية_مسير.بناء_موسوم(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.بناء_موسوم();
    }
    | عملية_مسير.استعلام_وسم(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استعلام_وسم();
    }
    | عملية_مسير.استخراج_حمولة(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استخراج_حمولة();
    }
    | عملية_مسير.بناء_صندوق(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.بناء_صندوق();
    }
    | عملية_مسير.بناء_إغلاق(_) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.بناء_إغلاق();
    }
    | عملية_مسير.استخراج_التقاط(_) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.استخراج_التقاط();
    }
    | عملية_مسير.نداء(القيمة) -> {
        أرجع صنف_عملية_مسير_للاستهلاك.نداء();
    };
}

// Target-neutral executable reachability over verified MSIR, shared by every
// backend (native and LLVM). Executable output only needs functions reachable
// from the canonical program entry and the process-exit provider; object output
// keeps every function because object files are reusable link inputs.
عرف علّم_دالة_تنفيذية_مطلوبة(
    المطلوبة: &متغير متجه منطقي,
    العمل: &متغير متجه معرف_دالة_مسير,
    المعرف: معرف_دالة_مسير
): فراغ {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(*المطلوبة) مثل طبيعي)) { أرجع; };
    إذا ((*المطلوبة)[المعرف.القيمة]) { أرجع; };
    (*المطلوبة)[المعرف.القيمة] := صواب;
    ألحق(*العمل, المعرف);
}

// References through nested constant vectors must remain reachable even
// though the function is not named by a direct call instruction.
عرف علّم_دوال_ثابت_عام_مطلوبة(
    المطلوبة: &متغير متجه منطقي,
    العمل: &متغير متجه معرف_دالة_مسير,
    الثابت: &ثابت_مسير
): فراغ {
    طابق *الثابت مع
    | ثابت_مسير.دالة(المعرف) -> {
        علّم_دالة_تنفيذية_مطلوبة(المطلوبة, العمل, المعرف);
    }
    | ثابت_مسير.متجه(العناصر) -> {
        دع فهرس_العنصر: متغير طبيعي = 0;
        طالما (فهرس_العنصر < (الطول(العناصر) مثل طبيعي)) {
            علّم_دوال_ثابت_عام_مطلوبة(المطلوبة, العمل, &العناصر[فهرس_العنصر]);
            فهرس_العنصر := فهرس_العنصر + 1;
        }
    }
    | _ -> { };
}

// The canonical retention policy for code generation, shared by Native and
// LLVM: an executable keeps only what its entry and startup roots reach;
// every reusable output (objects, shared libraries, relocatable objects,
// target modules) keeps every function, since its consumers may reference any
// exported definition, constructor or function address. (Previously both
// backends applied the executable closure to every linked output, dropping
// library definitions that the entry did not reach.)
عام عرف دوال_مسير_مطلوبة_لمخرج(
    المسير: &سياق_مستهلك_مسير,
    مخرج_تنفيذي: منطقي,
    دالة_بدء_البرنامج: اختياري معرف_دالة_مسير
): متجه منطقي {
    إذا (مخرج_تنفيذي) { أرجع دوال_مسير_تنفيذية_مطلوبة(المسير, دالة_بدء_البرنامج); };
    أرجع كل_دوال_مسير_مطلوبة(المسير);
}

عام عرف كل_دوال_مسير_مطلوبة(المسير: &سياق_مستهلك_مسير): متجه منطقي {
    دع المطلوبة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    دع العدد: طبيعي = عدد_دوال_مسير(المسير);
    طالما (ف < العدد) { ألحق(المطلوبة, صواب); ف := ف + 1; }
    أرجع المطلوبة;
}

عام عرف دوال_مسير_تنفيذية_مطلوبة(
    المسير: &سياق_مستهلك_مسير,
    دالة_بدء_البرنامج: اختياري معرف_دالة_مسير
): متجه منطقي {
    أرجع دوال_برنامج_مسير_تنفيذية_مطلوبة(&(*المسير).المسير, دالة_بدء_البرنامج);
}

// The same closure over a program the caller still owns (the MSIR
// optimization pipeline, msir_optimization_pipeline.sn, before the program
// becomes a consumer's).
عام عرف دوال_برنامج_مسير_تنفيذية_مطلوبة(
    البرنامج: &برنامج_مسير,
    دالة_بدء_البرنامج: اختياري معرف_دالة_مسير
): متجه منطقي {
    دع المطلوبة: متغير متجه منطقي = [];
    دع العمل: متغير متجه معرف_دالة_مسير = [];
    دع العدد: طبيعي = الطول((*البرنامج).الدوال) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(المطلوبة, خطأ); ف := ف + 1; }

    طابق دالة_بدء_البرنامج مع
    | اختياري.موجود(المعرف) -> { علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, المعرف); }
    | اختياري.لا_شيء -> {
        ف := 0;
        طالما (ف < العدد) { المطلوبة[ف] := صواب; ف := ف + 1; }
        أرجع المطلوبة;
    };
    // The executable startup calls the STD process-exit provider directly.
    طابق (*البرنامج).دالة_خروج_العملية مع
    | اختياري.موجود(المعرف) -> { علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, المعرف); }
    | اختياري.لا_شيء -> { };
    // Backends call the bound allocation providers for storage services.
    طابق (*البرنامج).مزودات_تخصيص_الذاكرة مع
    | اختياري.موجود(المزودات) -> {
        علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, المزودات.التخصيص);
        علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, المزودات.إعادة_التخصيص);
        علّم_دالة_تنفيذية_مطلوبة(&متغير المطلوبة, &متغير العمل, المزودات.التحرير);
    }
    | اختياري.لا_شيء -> { };

    // Function-valued globals are roots even when reached through an indirect call later.
    ف := 0;
    طالما (ف < (الطول((*البرنامج).العوام) مثل طبيعي)) {
        علّم_دوال_ثابت_عام_مطلوبة(
            &متغير المطلوبة, &متغير العمل,
            &(*البرنامج).العوام[ف].التهيئة
        );
        ف := ف + 1;
    }
    أكمل_دوال_مسير_مطلوبة(البرنامج, &متغير المطلوبة, &متغير العمل);
    أرجع المطلوبة;
}

// Extends المطلوبة (by position) with every function the marked ones reach:
// direct calls, function constants and closures, with their destructors.
// The MSIR optimization pipeline closes compile-time evaluation's roots
// with it.
عام عرف أغلق_دوال_مسير_مطلوبة(البرنامج: &برنامج_مسير, المطلوبة: &متغير متجه منطقي): فراغ {
    دع العمل: متغير متجه معرف_دالة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المطلوبة) مثل طبيعي) && ف < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        إذا ((*المطلوبة)[ف]) { ألحق(العمل, (*البرنامج).الدوال[ف].المعرف); };
        ف := ف + 1;
    }
    أكمل_دوال_مسير_مطلوبة(البرنامج, المطلوبة, &متغير العمل);
}

// Marks what the functions in العمل (already marked) reach.
عرف أكمل_دوال_مسير_مطلوبة(
    البرنامج: &برنامج_مسير,
    المطلوبة: &متغير متجه منطقي,
    العمل: &متغير متجه معرف_دالة_مسير
): فراغ {
    دع موضع_العمل: متغير طبيعي = 0;
    طالما (موضع_العمل < (الطول(*العمل) مثل طبيعي)) {
        دع المعرف: معرف_دالة_مسير = (*العمل)[موضع_العمل];
        إذا ((المعرف.القيمة مثل طبيعي) < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
            دع الدالة: &دالة_مسير = &(*البرنامج).الدوال[المعرف.القيمة];
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
                دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[ك];
                دع ت: متغير طبيعي = 0;
                طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
                    طابق (*الكتلة).التعليمات[ت].العملية مع
                    | عملية_مسير.ثابت(الثابت) -> {
                        طابق الثابت مع
                        | ثابت_مسير.دالة(الهدف) -> {
                            علّم_دالة_تنفيذية_مطلوبة(المطلوبة, العمل, الهدف);
                        }
                        | _ -> { };
                    }
                    | عملية_مسير.بناء_إغلاق(الإغلاق) -> {
                        علّم_دالة_تنفيذية_مطلوبة(المطلوبة, العمل, الإغلاق.الدالة);
                        طابق الإغلاق.المدمر مع
                        | اختياري.موجود(المدمر) -> {
                            علّم_دالة_تنفيذية_مطلوبة(المطلوبة, العمل, المدمر);
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | عملية_مسير.نداء(النداء) -> {
                        طابق النداء.الهدف مع
                        | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
                            علّم_دالة_تنفيذية_مطلوبة(المطلوبة, العمل, الهدف);
                        }
                        | _ -> { };
                    }
                    | _ -> { };
                    ت := ت + 1;
                }
                ك := ك + 1;
            }
        };
        موضع_العمل := موضع_العمل + 1;
    }
}
