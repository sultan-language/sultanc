        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_صحيح_آلة_استدعاء_ذاكرة_عقد());
        أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع);
        دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_تحقق_مسير.عقد_نوع_بدائي_غير_متاح(الموضع, البدائي) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_بدائي_نوع_عقد_غير_متاح()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_بدائي_تحقق_مسير(&متغير التشخيص, البدائي); }
    | خطأ_تحقق_مسير.نوع_ناتج_بدائي_غير_مطابق(الموضع, البدائي, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_بدائي_نتيجة_نوع_عدم_تطابق()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_بدائي_تحقق_مسير(&متغير التشخيص, البدائي); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع); }
    | خطأ_تحقق_مسير.مكان_تعديل_نداء_مفقود(الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_مفقود_استدعاء_تعديل_موضع()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_متوقع_استدعاء_تعديل_موضع()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_قابل_للكتابة(الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_استدعاء_تعديل_موضع_ليس_قابل_للكتابة()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.نوع_مكان_تعديل_نداء_غير_مطابق(الموضع, المتوقع, الموجود) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_استدعاء_تعديل_موضع_نوع_عدم_تطابق()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود); }
    | خطأ_تحقق_مسير.هدف_فرع_غير_صالح(المصدر, الوجهة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_صحيح_تفرع_هدف()); أضف_دالة_تحقق_مسير(&متغير التشخيص, المصدر.الدالة);
        دع أ1: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المصدر(), المصدر.القيمة); دع أ2: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الوجهة(), الوجهة.القيمة);
    }
    | خطأ_تحقق_مسير.عدد_حجج_فرع_غير_مطابق(المصدر, الوجهة, المتوقع, الموجود) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_تفرع_حجة_عدد_عدم_تطابق()); أضف_دالة_تحقق_مسير(&متغير التشخيص, المصدر.الدالة);
        دع أ1: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المصدر(), المصدر.القيمة); دع أ2: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الوجهة(), الوجهة.القيمة);
        دع أ3: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); دع أ4: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
    }
    | خطأ_تحقق_مسير.نوع_حجة_فرع_غير_مطابق(المصدر, الوجهة, الفهرس, المتوقع, الموجود) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_تفرع_حجة_نوع_عدم_تطابق()); أضف_دالة_تحقق_مسير(&متغير التشخيص, المصدر.الدالة);
        دع أ1: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المصدر(), المصدر.القيمة); دع أ2: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الوجهة(), الوجهة.القيمة); دع أ3: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
        أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
    }
    | خطأ_تحقق_مسير.شرط_فرع_غير_منطقي(الكتلة, القيمة, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_تفرع_شرط_ليس_منطقي()); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع); }
    | خطأ_تحقق_مسير.مميز_فرع_غير_صحيح(الكتلة, القيمة, النوع) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_مميز_فرع_متعدد_غير_صحيح());
        أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة);
        أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة);
        أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع);
    }
    | خطأ_تحقق_مسير.وسم_فرع_خارج_عرض_المميز(الكتلة, الوسم) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_مميز_فرع_متعدد_غير_صحيح());
        أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة);
        دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), الوسم);
    }
    | خطأ_تحقق_مسير.وسم_فرع_مكرر(الكتلة, الوسم) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_وسم_حالة_مكرر());
        أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة);
        دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), الوسم);
    }
    | خطأ_تحقق_مسير.شكل_إرجاع_غير_مطابق(الكتلة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_إرجاع_بنية_عدم_تطابق()); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); }
    | خطأ_تحقق_مسير.نوع_إرجاع_غير_مطابق(الكتلة, المتوقع, الموجود) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_إرجاع_نوع_عدم_تطابق()); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود); };

    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_مساعدة_خلل: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_أبلغ_عن_خلل_المترجم(),
        بلا_حجج
    );
    أرجع التشخيص;
}

عام عرف حول_أخطاء_تحقق_مسير_إلى_تشخيصات(
    الأخطاء: &متجه خطأ_تحقق_مسير
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع الحالة: متجه خطأ_تحقق_مسير = *الأخطاء;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        دع مرجع_الخطأ: &خطأ_تحقق_مسير = &الحالة[ف];
        دع الخطأ: خطأ_تحقق_مسير = *مرجع_الخطأ;
        دع التشخيص: متغير تشخيص = حول_خطأ_تحقق_مسير_إلى_تشخيص(الخطأ);
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        ف := ف + 1;
    }
    أرجع المجموعة;
}
