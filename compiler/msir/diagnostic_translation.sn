استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.primitive_names;
استورد compiler.diagnostics.schema;
استورد compiler.msir.msir_verifier;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.frontend.types.type_identity;
استورد compiler.runtime.primitive_identity;

عرف أضف_سبب_تحقق_مسير(التشخيص: &متغير تشخيص, السبب: سبب_تشخيص): فراغ {
    دع أ: منطقي = أضف_سبب_تشخيص(التشخيص, السبب);
}

عرف أضف_دالة_تحقق_مسير(التشخيص: &متغير تشخيص, الدالة: معرف_دالة_مسير): فراغ {
    دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
}

عرف أضف_كتلة_تحقق_مسير(التشخيص: &متغير تشخيص, الكتلة: معرف_كتلة_مسير): فراغ {
    أضف_دالة_تحقق_مسير(التشخيص, الكتلة.الدالة);
    دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
}

عرف أضف_قيمة_تحقق_مسير(التشخيص: &متغير تشخيص, القيمة: معرف_قيمة_مسير): فراغ {
    أضف_دالة_تحقق_مسير(التشخيص, القيمة.الدالة);
    دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
}

عرف أضف_نوع_تحقق_مسير(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    النوع: معرف_نوع
): فراغ {
    دع أ: منطقي = أضف_حجة_طبيعية(التشخيص, المفتاح, النوع.القيمة);
}

عرف أضف_موضع_تحقق_مسير(التشخيص: &متغير تشخيص, الموضع: موضع_تعليمة_مسير): فراغ {
    أضف_دالة_تحقق_مسير(التشخيص, الموضع.الدالة);
    دع أ1: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الموضع.الكتلة.القيمة);
    دع أ2: منطقي = أضف_حجة_طبيعية(التشخيص, مفتاح_حجة_تشخيص.التعليمة(), الموضع.الفهرس);
}

عرف أضف_بدائي_تحقق_مسير(التشخيص: &متغير تشخيص, البدائي: هوية_بدائي_مترجم): فراغ {
    دع النص: نص = نص_هوية_بدائي_تشخيصية(البدائي);
    دع أ: منطقي = أضف_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.البدائي(), النص);
}

عرف نص_عملية_حساب_مسير(العملية: عملية_حساب_صحيح): نص {
    طابق العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع «add»; }
    | عملية_حساب_صحيح.طرح -> { أرجع «subtract»; }
    | عملية_حساب_صحيح.ضرب -> { أرجع «multiply»; }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع «signed-divide»; }
    | عملية_حساب_صحيح.قسمة_طبيعية -> { أرجع «unsigned-divide»; }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع «signed-remainder»; }
    | عملية_حساب_صحيح.باقي_طبيعي -> { أرجع «unsigned-remainder»; }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع «bitwise-or»; }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع «bitwise-xor»; }
    | عملية_حساب_صحيح.و_بتي -> { أرجع «bitwise-and»; }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع «shift-left»; }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع «shift-right»; }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع «arithmetic-shift-right»; }
    | عملية_حساب_صحيح.جمع_ملتف -> { أرجع «wrapping-add»; }
    | عملية_حساب_صحيح.طرح_ملتف -> { أرجع «wrapping-subtract»; }
    | عملية_حساب_صحيح.ضرب_ملتف -> { أرجع «wrapping-multiply»; }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { أرجع «wrapping-shift-left»; };
}

عرف ابدأ_تشخيص_تحقق_مسير(): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.مسير_غير_صالح(), اختياري.لا_شيء()
    );
    دع أ: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «msir-verifier»
    );
    أرجع التشخيص;
}

عرف حول_خطأ_تحقق_مسير_إلى_تشخيص(الخطأ: خطأ_تحقق_مسير): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيص_تحقق_مسير();
    طابق الخطأ مع
    | خطأ_تحقق_مسير.دالة_بدء_برنامج_غير_موجودة(الدالة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_مفقود_برنامج_دخول_دالة()); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
    }
    | خطأ_تحقق_مسير.تهيئة_وحدة_قبل_الإقلاع_غير_آمنة(الدالة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_آمن_قبل_رئيسي_وحدة_مهيئ());
        أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
    }
    | خطأ_تحقق_مسير.معرف_دالة_غير_مقنن(الدالة, الفهرس) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_معتمد_دالة_معرف()); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
        دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_تحقق_مسير.دالة_بلا_مدخل(الدالة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_دالة_بلا_دخول()); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); }
    | خطأ_تحقق_مسير.مدخل_غير_صالح(الدالة, الكتلة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_صحيح_دالة_دخول()); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
        دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خطأ_تحقق_مسير.كتلة_مدخل_بمعاملات(الكتلة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_دخول_كتلة_يملك_معاملات()); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); }
    | خطأ_تحقق_مسير.نوع_ناتج_دالة_غير_صالح(الدالة, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_صحيح_دالة_نتيجة_نوع()); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع); }
    | خطأ_تحقق_مسير.معرف_كتلة_غير_مقنن(الكتلة, الفهرس) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_معتمد_كتلة_معرف()); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس); }
    | خطأ_تحقق_مسير.كتلة_من_دالة_أخرى(الكتلة, الدالة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_كتلة_من_آخر_دالة());
        دع أ1: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المصدر(), الكتلة.الدالة.القيمة);
        دع أ2: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
    }
    | خطأ_تحقق_مسير.كتلة_بلا_منهي(الكتلة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_كتلة_بلا_منه()); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); }
    | خطأ_تحقق_مسير.معرف_قيمة_مكرر(القيمة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_مكرر_قيمة_معرف()); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); }
    | خطأ_تحقق_مسير.معرف_قيمة_غير_مقنن(الدالة, الفهرس) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_معتمد_قيمة_معرف()); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس); }
    | خطأ_تحقق_مسير.عدد_قيم_دالة_غير_متطابق(الدالة, المتوقع, الموجود) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_دالة_قيمة_عدد_عدم_تطابق()); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); دع أ1: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); دع أ2: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود); }
    | خطأ_تحقق_مسير.قيمة_مقننة_غير_متطابقة(الدالة, الفهرس) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_معتمد_قيمة_جدول_عدم_تطابق()); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس); }
    | خطأ_تحقق_مسير.عداد_قيم_دالة_غير_متطابق(الدالة, المتوقع, الموجود) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_دالة_تال_قيمة_عدم_تطابق()); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); دع أ1: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); دع أ2: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود); }
    | خطأ_تحقق_مسير.قيمة_من_دالة_أخرى(القيمة, الدالة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_قيمة_من_آخر_دالة());
        دع أ1: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.المصدر(), القيمة.الدالة.القيمة);
        دع أ2: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
    }
    | خطأ_تحقق_مسير.قيمة_غير_موجودة(القيمة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_مفقود_قيمة()); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); }
    | خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(القيمة, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_صحيح_قيمة_نوع()); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع); }
    | خطأ_تحقق_مسير.استخدام_قبل_التعريف(القيمة, الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_استخدام_قبل_تعريف()); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.تعريف_لا_يهيمن(القيمة, الكتلة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_تعريف_لا_ليس_يهيمن()); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_تحقق_مسير.تعليمة_بلا_ناتج(الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_تعليمة_مفقود_نتيجة()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_ثابت_نوع_عدم_تطابق()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع); }
    | خطأ_تحقق_مسير.تهيئة_عام_غير_مطابقة(العام, النوع) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_عام_مهيئ_نوع_عدم_تطابق());
        دع أ: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), العام.القيمة);
        أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع);
    }
    | خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_غير_صحيح_حسابي_معامل()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع); }
    | خطأ_تحقق_مسير.نوعا_معاملين_غير_متطابقين(الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_حسابي_معامل_نوع_عدم_تطابق()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.إشارة_عملية_حساب_غير_مطابقة(الموضع, العملية, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_حسابي_إشارة_عدد_عدم_تطابق()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); دع نص_العملية: نص = نص_عملية_حساب_مسير(العملية); دع أ: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.العملية(), نص_العملية); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع); }
    | خطأ_تحقق_مسير.نوع_ناتج_حساب_غير_مطابق(الموضع, المتوقع, الموجود) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_حسابي_نتيجة_نوع_عدم_تطابق()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود); }
    | خطأ_تحقق_مسير.نوع_ناتج_مقارنة_غير_منطقي(الموضع, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_مقارنة_نتيجة_ليس_منطقي()); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع); }
